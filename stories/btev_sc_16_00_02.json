{
    "dir": "chap00/battle/btev_sc_16_00_02.js",
    "type": "",
    "info": {
        "story_id": "165",
        "cid": "",
        "title": "【EXストーリー】薔薇の魔術師",
        "sub_title": "シンクロストーリー"
    },
    "entry":
    [
        { "location": "905/SCENARIO", "narrator": "", "text": "【結果】ラピスラズリ（ラピスちゃん）"},
        { "location": "921/TALK"    , "narrator": "神楽", "text": "お帰りなさいませ。\nよい旅でしたか？"},
        { "location": "922/TALK"    , "narrator": "神楽", "text": "$handle$さまが\n頑張ってくれたお陰で\n『コネクト』は完了です。"},
        { "location": "923/TALK"    , "narrator": "神楽", "text": "ラピスちゃんの\nココロの中の\n抵抗は消えました。"},
        { "location": "924/TALK"    , "narrator": "神楽", "text": "$handle$さまと\n繋がる準備が\nできたのです。"},
        { "location": "925/SEL"     , "narrator": "（選択肢）", "text": "次が『シンクロ』だよね"},
        { "location": "926/ACT"     , "narrator": "", "text": "次が『シンクロ』だよね"},
        { "location": "928/TALK"    , "narrator": "神楽", "text": "そうです！\nご名答！"},
        { "location": "929/TALK"    , "narrator": "神楽", "text": "シンクロをすると、\nラピスちゃんの想いが\n流れ込みます。"},
        { "location": "930/TALK"    , "narrator": "神楽", "text": "$handle$さまは、\nどうかそれを受け入れて\nあげてくださいませ。"},
        { "location": "931/TALK"    , "narrator": "神楽", "text": "準備はいかがですか？"},
        { "location": "932/SEL"     , "narrator": "（選択肢）", "text": "できた"},
        { "location": "933/SEL"     , "narrator": "（選択肢）", "text": "まだ"},
        { "location": "934/ACT"     , "narrator": "", "text": "できた"},
        { "location": "935/TALK"    , "narrator": "神楽", "text": "承知しました。\nそれではココロを\n繋げます。"},
        { "location": "936/ACT"     , "narrator": "", "text": "まだ"},
        { "location": "938/TALK"    , "narrator": "神楽", "text": "まだ、ですか…。"},
        { "location": "939/TALK"    , "narrator": "神楽", "text": "それでは一旦ここで\nお別れですね。"},
        { "location": "940/TALK"    , "narrator": "神楽", "text": "準備ができたら\nお戻りください。"},
        { "location": "948/TALK"    , "narrator": "神楽", "text": "EXEC_SYNC_SPHERE/."},
        { "location": "961/DIALOG"  , "narrator": "", "text": "ソレが嫌いな女子なんていませんっ！"},
        { "location": "976/DIALOG"  , "narrator": "", "text": "亜城クラウスナー聡美。18歳の帰国子女。発症時は横浜港南区在住。小学生の頃にドイツから日本へ移住。母親ドイツ人のハーフであり、容姿端麗で気立ても良い、非の打ち所の無い美少女。近所でも礼儀正しい子として評判で、ハーフと言うこともあって、学校でも良い意味で目立っていた。"},
        { "location": "977/DIALOG"  , "narrator": "", "text": "プライドが高く、趣味は西洋占星術や星座。日本人であれば変わり者と思われたかもしれないが、欧州帰りの彼女だからこそ、お嬢様らしく、かつ乙女チックな趣味だと賞賛された。だが実は、彼女には人に言えない趣味が１つだけあった。"},
        { "location": "978/DIALOG"  , "narrator": "", "text": "それはBLである。彼女はスイッチが入ると、人が変わったように腐女子となる。親友達に隠れてBL系の同人誌を書き、コミケではそれを売りつつも、自分の信奉するサークルのBL本を山ほど買う。そんな二面性を持った少女であった。"},
        { "location": "983/DIALOG"  , "narrator": "", "text": "彼女の発症は、非常に残酷かつ些細な事によるものである。それはある日、コミケの帰りのことだった。帰りの電車の中で、大量のBL系同人誌を忘れてしまい、慌てて取りに帰ったが、既に警察に持って行かれてしまっていた。"},
        { "location": "984/DIALOG"  , "narrator": "", "text": "聡美は迷ったが、非常にレアリティの高い同人誌ばかりだったため、意を決して取りに行くことを決意する。そのまま中身を見ずにサッと取り返せることを願って。警察署は遠いので、親に車で送ってもらい、車の中で待っていてもらうことに。"},
        { "location": "985/DIALOG"  , "narrator": "", "text": "しかし現実は無慈悲だった。警察の落とし物担当に「この中に入ってる持ち物の名前を全部挙げて」と公開処刑されたのである。"},
        { "location": "990/DIALOG"  , "narrator": "", "text": "しかもその時、周囲には沢山の一般人やら警察やらがいて、更には遅くなったのを心配した親が見に来てしまったのだ。彼女はヤケクソになって全ての本の名前を言った。"},
        { "location": "991/DIALOG"  , "narrator": "", "text": "もはや恥ずかしさと、これ１回を乗り越えればレア本は自分の元に戻ってくるという希望とのせめぎ合いの中にいたが、この後どうやって家族と接すれば良いのか、そしてこの地獄のような状況についに事切れてその場でへたり込んで泣き出してしまい、そのまま発症。"},
        { "location": "992/DIALOG"  , "narrator": "", "text": "かくして世界はバラに包まれた、全てに受け攻めがある世界で、BLが日常的になっているセカイ。すなわち警察署の署員もそこに居た人も、すべての人が受け攻めを決められたカップリングとなってしまうという、滑稽かつおぞましい世界を展開したのである。"},
        { "location": "1009/TALK"   , "narrator": "神楽", "text": "これがラピスちゃんの\n発症のあらましです。"},
        { "location": "1010/SEL"    , "narrator": "（選択肢）", "text": "すごい世界だね"},
        { "location": "1011/SEL"    , "narrator": "（選択肢）", "text": "警察BL萌える！"},
        { "location": "1012/SEL"    , "narrator": "（選択肢）", "text": "無理解って怖いね"},
        { "location": "1013/ACT"    , "narrator": "", "text": "すごい世界だね"},
        { "location": "1014/TALK"   , "narrator": "神楽", "text": "……お気持ち\nお察しします。"},
        { "location": "1015/ACT"    , "narrator": "", "text": "警察BL萌える！"},
        { "location": "1016/TALK"   , "narrator": "神楽", "text": "$handle$さまは\nディープな世界を\nご存じなんですね。"},
        { "location": "1017/ACT"    , "narrator": "", "text": "無理解って怖いね"},
        { "location": "1018/TALK"   , "narrator": "神楽", "text": "結局はそういう\nことなんでしょうか。"},
        { "location": "1020/TALK"   , "narrator": "神楽", "text": "ラピスちゃんの技は\n強力な魔方陣を使った\nシールド展開です。"},
        { "location": "1021/TALK"   , "narrator": "神楽", "text": "その力は生死を分かつ\n防御で遺憾なく\n発揮されるはずです。"},
        { "location": "1022/TALK"   , "narrator": "神楽", "text": "$handle$さまを\n助けることが\nできるでしょう。"},
        { "location": "1023/SEL"    , "narrator": "（選択肢）", "text": "頼もしいね"},
        { "location": "1024/SEL"    , "narrator": "（選択肢）", "text": "うーん…"},
        { "location": "1025/ACT"    , "narrator": "", "text": "頼もしいね"},
        { "location": "1026/TALK"   , "narrator": "神楽", "text": "その通りです。"},
        { "location": "1027/ACT"    , "narrator": "", "text": "うーん…"},
        { "location": "1028/TALK"   , "narrator": "神楽", "text": "試してみるのも\n一興かと。"},
        { "location": "1030/TALK"   , "narrator": "神楽", "text": "創作活動とは\n極論すれば\n妄想の具現化。"},
        { "location": "1031/TALK"   , "narrator": "神楽", "text": "それが一般人に\n理解されないのなら。"},
        { "location": "1032/TALK"   , "narrator": "神楽", "text": "一種の\nアウトサイダーアートと\nいうことなのでしょう。"},
        { "location": "1033/SEL"    , "narrator": "（選択肢）", "text": "持ち上げすぎ"},
        { "location": "1034/SEL"    , "narrator": "（選択肢）", "text": "わかる気はする"},
        { "location": "1035/ACT"    , "narrator": "", "text": "持ち上げすぎ"},
        { "location": "1036/TALK"   , "narrator": "神楽", "text": "その評価は\n少しだけ寂しいですね。"},
        { "location": "1037/TALK"   , "narrator": "神楽", "text": "初期衝動を\n持ち続けるのは\n難しいんですよ。"},
        { "location": "1038/TALK"   , "narrator": "神楽", "text": "彼女はある意味常に\n初期衝動ありきで\n創作していた。"},
        { "location": "1039/TALK"   , "narrator": "神楽", "text": "…少し羨ましい\nくらいです。"},
        { "location": "1040/ACT"    , "narrator": "", "text": "わかる気はする"},
        { "location": "1041/TALK"   , "narrator": "神楽", "text": "そうでしょう？\nわかってくださって\nうれしいです。"},
        { "location": "1043/TALK"   , "narrator": "神楽", "text": "ラピスちゃんは\n表裏が激しいという\n見方もできますが。"},
        { "location": "1044/TALK"   , "narrator": "神楽", "text": "自己分析に長けていたと\n言い換えることも\nできると思うのです。"},
        { "location": "1045/SEL"    , "narrator": "（選択肢）", "text": "ちょっと違うような"},
        { "location": "1046/SEL"    , "narrator": "（選択肢）", "text": "本音と建前ってことか"},
        { "location": "1047/ACT"    , "narrator": "", "text": "ちょっと違うような"},
        { "location": "1048/TALK"   , "narrator": "神楽", "text": "…言いたいことが\n伝わってないみたいです。"},
        { "location": "1049/ACT"    , "narrator": "", "text": "本音と建前ってことか"},
        { "location": "1050/TALK"   , "narrator": "神楽", "text": "…そうですね。\n子供なのに大人のふりを\nしすぎたんですよ。"},
        { "location": "1052/TALK"   , "narrator": "神楽", "text": "さて。"},
        { "location": "1053/TALK"   , "narrator": "神楽", "text": "今日からラピスちゃんと\n$handle$さまは\nつながりました。"},
        { "location": "1054/TALK"   , "narrator": "神楽", "text": "ラピスちゃんには\n優しくしてあげて\n欲しいと思います。"},
        { "location": "1055/TALK"   , "narrator": "神楽", "text": "気が向いたら\n腐った話にも\n付き合ってあげて。"},
        { "location": "1056/TALK"   , "narrator": "神楽", "text": "またの機会が\nありましたら\nお会いしましょう。"},
        { "location": "1057/TALK"   , "narrator": "神楽", "text": "では今回は\nこれで失礼いたします。"}
    ]
}
