    "type": "",
    "info": {
        "story_id": "21000",
        "cid": "",
        "title": "000 ココロスフィア解説",
        "sub_title": "ココロの深淵へようこそ"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ココロスフィア導入つばめ"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>DOOR-No. 000</size>\nCHIHARU\n\n<size=40>Kokoro.Initialize();</size>\n<size=25>～深層ココロスフィアの概念について～</size>"},
        { "location": "22/TALK"   , "narrator": "千羽鶴", "text": "ようこそ、\n逢瀬つばめの\n深層世界へ。"},
        { "location": "24/TALK"   , "narrator": "千羽鶴", "text": "前にもしてるけど、\n深層世界についての説明、\nもう一度聞く？"},
        { "location": "25/SEL"    , "narrator": "（選択肢）", "text": "はい"},
        { "location": "26/SEL"    , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "27/ACT"    , "narrator": "", "text": "はい"},
        { "location": "28/TALK"   , "narrator": "千羽鶴", "text": "わかった。\nそれじゃもう一度、\n深層世界の話をする。"},
        { "location": "30/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "31/TALK"   , "narrator": "千羽鶴", "text": "そう、助かる。"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "さて。"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "改めて、\nここは逢瀬つばめの\n深層世界。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "彼女は普段から\n見ていても分かる通り、\n非常に楽天的。"},
        { "location": "50/TALK"   , "narrator": "千羽鶴", "text": "深い悩みなんて\n無さそうに見えるけど……"},
        { "location": "51/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "52/TALK"   , "narrator": "千羽鶴", "text": "実際、あまり\n無いかもしれない。"},
        { "location": "53/SEL"    , "narrator": "（選択肢）", "text": "あー、やっぱり。そんな気がした"},
        { "location": "54/SEL"    , "narrator": "（選択肢）", "text": "嘘ばっか"},
        { "location": "55/ACT"    , "narrator": "", "text": "あー、やっぱり。そんな気がした"},
        { "location": "56/TALK"   , "narrator": "千羽鶴", "text": "嘘です。"},
        { "location": "57/TALK"   , "narrator": "千羽鶴", "text": "当然、ある。"},
        { "location": "58/TALK"   , "narrator": "千羽鶴", "text": "彼女は生きてる。"},
        { "location": "59/TALK"   , "narrator": "千羽鶴", "text": "生きてる以上、当然\n悩みのひとつやふたつ――"},
        { "location": "62/TALK"   , "narrator": "千羽鶴", "text": "<color=red><size=40>必ずある！</size></color>"},
        { "location": "63/TALK"   , "narrator": "千羽鶴", "text": "逢瀬つばめがいつも\n考え無しのように見える\nからって見くびらないで。"},
        { "location": "64/SEL"    , "narrator": "（選択肢）", "text": "擁護してるように見えるけど実はディスってない？"},
        { "location": "65/ACT"    , "narrator": "", "text": "擁護してるように見えるけど実はディスってない？"},
        { "location": "67/TALK"   , "narrator": "千羽鶴", "text": "……いいえ。"},
        { "location": "68/SEL"    , "narrator": "（選択肢）", "text": "今一瞬間があった！"},
        { "location": "69/ACT"    , "narrator": "", "text": "今一瞬間があった！"},
        { "location": "71/TALK"   , "narrator": "千羽鶴", "text": "いいえ。"},
        { "location": "72/SEL"    , "narrator": "（選択肢）", "text": "本心を言え！"},
        { "location": "73/ACT"    , "narrator": "", "text": "本心を言え！"},
        { "location": "75/TALK"   , "narrator": "千羽鶴", "text": "いいからもう先に進む！"},
        { "location": "76/ACT"    , "narrator": "", "text": "嘘ばっか"},
        { "location": "77/TALK"   , "narrator": "千羽鶴", "text": "あらまあ。\n簡単に見破られた。\n優秀なダイバーね。"},
        { "location": "78/TALK"   , "narrator": "千羽鶴", "text": "それとも、実は\n過去に誰かの心の中に\nダイブしたことがある？"},
        { "location": "79/SEL"    , "narrator": "（選択肢）", "text": "そんなわけない"},
        { "location": "80/SEL"    , "narrator": "（選択肢）", "text": "はい、実は"},
        { "location": "81/ACT"    , "narrator": "", "text": "そんなわけない"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "分かってて聞いた。\n普通、日常的に心の中に\nダイブする事なんてない。"},
        { "location": "83/ACT"    , "narrator": "", "text": "はい、実は"},
        { "location": "84/TALK"   , "narrator": "千羽鶴", "text": "更にまあ。\nもしかして、\nその手のプロ？"},
        { "location": "85/TALK"   , "narrator": "千羽鶴", "text": "だとしたら\n彼女も私も心強い。"},
        { "location": "88/TALK"   , "narrator": "千羽鶴", "text": "とにかく。"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "逢瀬つばめにだって、\n人並みに悩みがある。"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "あんな悩みなさそうな\n彼女にもある悩みなんて、\nちょっと興味ない？"},
        { "location": "91/SEL"    , "narrator": "（選択肢）", "text": "はい"},
        { "location": "92/SEL"    , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "93/SEL"    , "narrator": "（選択肢）", "text": "千羽鶴の方が興味ある"},
        { "location": "94/ACT"    , "narrator": "", "text": "はい"},
        { "location": "95/TALK"   , "narrator": "千羽鶴", "text": "まあでも。"},
        { "location": "96/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "97/TALK"   , "narrator": "千羽鶴", "text": "そう。まあ確かに、\n実際に見てみたら\nくだらないことかも。"},
        { "location": "98/ACT"    , "narrator": "", "text": "千羽鶴の方が興味ある"},
        { "location": "101/TALK"  , "narrator": "千羽鶴", "text": "もうここでは\n何も出ませんよ。"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "そんなことより、\n逢瀬つばめのココロを\n癒してあげて。"},
        { "location": "107/TALK"  , "narrator": "千羽鶴", "text": "……ほんとに。"},
        { "location": "108/TALK"  , "narrator": "千羽鶴", "text": "ホントにしつこい人。"},
        { "location": "109/TALK"  , "narrator": "千羽鶴", "text": "そんなに私の\n心の中を見たい？"},
        { "location": "110/SEL"   , "narrator": "（選択肢）", "text": "はい"},
        { "location": "111/SEL"   , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "112/ACT"   , "narrator": "", "text": "はい"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "おぞましすぎて、\n現実に帰って来れなく\nなるかもしれないけど。"},
        { "location": "114/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "115/TALK"  , "narrator": "千羽鶴", "text": "まあ、それでもと言うなら\nいずれ何か見せられる日が\n来るかもしれない。"},
        { "location": "116/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "117/TALK"  , "narrator": "千羽鶴", "text": "それが正しい判断。\n私の中を覗いても、\nろくなことがないから。"},
        { "location": "119/TALK"  , "narrator": "千羽鶴", "text": "とにかく。\n貴方の実直すぎるアホに\n免じて、ご褒美あげる。"},
        { "location": "129/TALK"  , "narrator": "千羽鶴", "text": "何にしても今は、\n逢瀬つばめのココロを\n癒してあげて。"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "しつこいです。\nさっさと逢瀬つばめの\nココロを癒してあげて。"},
        { "location": "137/TALK"  , "narrator": "千羽鶴", "text": "だから、私は\nチュートリアルキャラ。\nココロなんて存在しない。"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "さっさと逢瀬つばめの\nココロを癒してあげて。"},
        { "location": "142/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、私は単なる\nチュートリアルキャラ。\nココロなんて存在しない。"},
        { "location": "143/TALK"  , "narrator": "千羽鶴", "text": "今は逢瀬つばめの\nココロを癒すことに\n集中して。"},
        { "location": "148/TALK"  , "narrator": "千羽鶴", "text": "話を戻すけど。"},
        { "location": "150/TALK"  , "narrator": "千羽鶴", "text": "彼女の悩みは、\n貴方にとっては大したこと\nではないかもしれない。"},
        { "location": "151/TALK"  , "narrator": "千羽鶴", "text": "けど、彼女にとっては、\n人生を左右する重大な\nことなの。"},
        { "location": "152/TALK"  , "narrator": "千羽鶴", "text": "だから是非、\n真摯に向かい合って\n支えてあげてほしい。"},
        { "location": "153/TALK"  , "narrator": "千羽鶴", "text": "貴方と逢瀬つばめに、\n素晴らしきココロの旅を。"}
    ]
}
