{
    "dir": "chap05/daydra/dd_ch05_05_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "5505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "しろいこ＜後編＞"
    },
    "entry":
    [
        { "location": "1935/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1937/TALK"  , "narrator": "千羽鶴", "text": "迷ってるようなら、\nこの場で答えを出す\n必要はない。"},
        { "location": "1939/TALK"  , "narrator": "千羽鶴", "text": "また明日来るから、\nその時までに\n考えておいて。"},
        { "location": "1940/TALK"  , "narrator": "神楽", "text": "…いえ、\nその必要はありません。"},
        { "location": "1942/TALK"  , "narrator": "神楽", "text": "こちらからも一つ、\n条件があります。"},
        { "location": "1943/TALK"  , "narrator": "千羽鶴", "text": "どうぞ。"},
        { "location": "1944/TALK"  , "narrator": "神楽", "text": "あなたに協力した場合、\nその契約期間中…。"},
        { "location": "1945/TALK"  , "narrator": "神楽", "text": "私がする質問には、\n全て正直に\n答えてください。"},
        { "location": "1946/TALK"  , "narrator": "千羽鶴", "text": "…嘘を言ったら？"},
        { "location": "1947/TALK"  , "narrator": "神楽", "text": "即時契約破棄です。"},
        { "location": "1948/TALK"  , "narrator": "千羽鶴", "text": "…随分と強気なのね。\n私はあなたの大切なモノ、\n全て握ってるというのに。"},
        { "location": "1949/TALK"  , "narrator": "神楽", "text": "お互い様でしょう？"},
        { "location": "1950/TALK"  , "narrator": "神楽", "text": "私も、あなたにとっての\n重要な鍵を\n握ってるはずです。"},
        { "location": "1951/TALK"  , "narrator": "神楽", "text": "仮に、私が今ここで\n自殺したとしたら？"},
        { "location": "1952/TALK"  , "narrator": "神楽", "text": "そうなったら、\nあなたは困るんじゃ\nないですか？"},
        { "location": "1953/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "1954/TALK"  , "narrator": "神楽", "text": "私の言う契約破棄には、\nそういった行動の可能性も\n含まれています。"},
        { "location": "1955/TALK"  , "narrator": "神楽", "text": "それでもよければ――"},
        { "location": "1956/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1957/TALK"  , "narrator": "千羽鶴", "text": "発する言葉は\n全て真実だけを伝えると\n約束する。"},
        { "location": "1958/TALK"  , "narrator": "神楽", "text": "本当ですか？"},
        { "location": "1959/TALK"  , "narrator": "千羽鶴", "text": "けど、\n答えられないことは正直に\n答えられないと言う。"},
        { "location": "1960/TALK"  , "narrator": "千羽鶴", "text": "それでもいい？"},
        { "location": "1961/TALK"  , "narrator": "神楽", "text": "そうですね…。"},
        { "location": "1962/TALK"  , "narrator": "神楽", "text": "答えられない理由を\n教えてくれたら、\nその都度検討します。"},
        { "location": "1963/TALK"  , "narrator": "千羽鶴", "text": "…それでいい。\n契約成立ね。"},
        { "location": "1964/TALK"  , "narrator": "神楽", "text": "はい。\nでは早速ですが、\n一つ目の質問です。"},
        { "location": "1965/TALK"  , "narrator": "神楽", "text": "ライブの時に発生した\nフェノメノンに関する\n情報を教えてください。"},
        { "location": "1966/TALK"  , "narrator": "千羽鶴", "text": "わかった。\nまずはあのフェノメノンの\n発症者について。"},
        { "location": "1968/TALK"  , "narrator": "千羽鶴", "text": "発症者は、如月音羽。"},
        { "location": "1970/TALK"  , "narrator": "神楽", "text": "……っ！！\n音羽！？"},
        { "location": "1971/TALK"  , "narrator": "神楽", "text": "それ、本当ですか？\n本当に、如月音羽が\n発症者なんですか？"},
        { "location": "1972/TALK"  , "narrator": "千羽鶴", "text": "質問には正直に答える。\nそういう契約のはず。"},
        { "location": "1974/TALK"  , "narrator": "神楽", "text": "どうして…！？\n何故発症したの！？"},
        { "location": "1975/TALK"  , "narrator": "千羽鶴", "text": "発症に至った\n直接的理由は、\n私にはわからない。"},
        { "location": "1976/TALK"  , "narrator": "千羽鶴", "text": "けど、それに関しては\n貴方の方が推測しやすい\nのではないかと思う。"},
        { "location": "1977/TALK"  , "narrator": "神楽", "text": "それで！！\n音羽は無事なんですか！？"},
        { "location": "1978/TALK"  , "narrator": "千羽鶴", "text": "いいえ。\n残念だけど――"},
        { "location": "1979/TALK"  , "narrator": "千羽鶴", "text": "彼女は破壊された。"},
        { "location": "1980/TALK"  , "narrator": "神楽", "text": "…っ―――！！"},
        { "location": "1981/TALK"  , "narrator": "千羽鶴", "text": "わかりやすく言えば、\n魂として復元不可能と\n思われる状況。"},
        { "location": "1982/TALK"  , "narrator": "神楽", "text": "…どうして。"},
        { "location": "1983/TALK"  , "narrator": "神楽", "text": "いったい、誰が音羽を\n壊したんですか！？"},
        { "location": "1984/TALK"  , "narrator": "千羽鶴", "text": "貴方が破壊対象とする\n存在であるところの\n“逢瀬つばめ”。"},
        { "location": "1986/TALK"  , "narrator": "神楽", "text": "逢瀬つばめ！？"},
        { "location": "1987/TALK"  , "narrator": "神楽", "text": "ということは\nあれが――"},
        { "location": "2001/TALK"  , "narrator": "神楽", "text": "なんで…どうして？\nどうして逢瀬つばめが、\n音羽のことを…。"},
        { "location": "2002/TALK"  , "narrator": "神楽", "text": "…許さない。"},
        { "location": "2003/TALK"  , "narrator": "神楽", "text": "逢瀬つばめ…、\n私の手で、絶対、壊す！！"},
        { "location": "2004/TALK"  , "narrator": "千羽鶴", "text": "ちなみに。"},
        { "location": "2005/TALK"  , "narrator": "千羽鶴", "text": "この世界に実在する\n“逢瀬つばめ”は、\n私にとっても都合が悪い。"},
        { "location": "2006/TALK"  , "narrator": "千羽鶴", "text": "だから速やかに\n破壊すべきは、２人に\nとっての共通事項。"},
        { "location": "2007/TALK"  , "narrator": "千羽鶴", "text": "けれども幸い、今現在\n破壊されていないのは\n幸運なことでもある。"},
        { "location": "2008/TALK"  , "narrator": "神楽", "text": "どういうこと……？"},
        { "location": "2009/TALK"  , "narrator": "千羽鶴", "text": "貴方は“彼ら”に言われた\nとおり、“逢瀬つばめ”を\n破壊する予定だった。"},
        { "location": "2010/TALK"  , "narrator": "千羽鶴", "text": "けれども、それをあの時に\n達成されていたら、非常に\n面倒な事になっていた。"},
        { "location": "2011/TALK"  , "narrator": "千羽鶴", "text": "そもそもあなたは、\nこの世界のことを\nなにも知らない。"},
        { "location": "2012/TALK"  , "narrator": "千羽鶴", "text": "同様に、あなたは\n“彼ら”のことも、\nなにも知らない…。"},
        { "location": "2013/TALK"  , "narrator": "神楽", "text": "…意味が\nわからないんですけど。"},
        { "location": "2014/TALK"  , "narrator": "千羽鶴", "text": "彼らがあなたに、\n何を託したのか。"},
        { "location": "2015/TALK"  , "narrator": "千羽鶴", "text": "その真意を、\nあなたは\n知らないでしょう？"},
        { "location": "2016/TALK"  , "narrator": "神楽", "text": "じゃあ、それがなにか\n教えてください。"},
        { "location": "2018/TALK"  , "narrator": "千羽鶴", "text": "申し訳ないけど、\n詳細に関しては\n私もよくは知らない。"},
        { "location": "2019/TALK"  , "narrator": "千羽鶴", "text": "けど、\n一つだけわかってること。"},
        { "location": "2020/TALK"  , "narrator": "千羽鶴", "text": "それは、決してあなたや、\n世界の利益にならない\nということ。"},
        { "location": "2021/TALK"  , "narrator": "千羽鶴", "text": "私は違う。"},
        { "location": "2022/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめを、\nずっと間近で見てきた。"},
        { "location": "2023/TALK"  , "narrator": "千羽鶴", "text": "だから、世界にとって、\n私達にとって――"},
        { "location": "2024/TALK"  , "narrator": "千羽鶴", "text": "そしてあなたにとって\n最もよい、彼女の壊し方を\nしっかりわかっている。"},
        { "location": "2025/TALK"  , "narrator": "千羽鶴", "text": "そのために必要な\n十分なお膳立てを立てる\n準備もできている。"},
        { "location": "2026/TALK"  , "narrator": "神楽", "text": "…遠回しに話すのは\n嫌いじゃなかったん\nですか？"},
        { "location": "2027/TALK"  , "narrator": "千羽鶴", "text": "一之宮神楽。\nあなたには\n５月７日付で…。"},
        { "location": "2028/TALK"  , "narrator": "千羽鶴", "text": "情報管理庁管轄\n拡張現実特殊戦略隊群\n特別攻撃隊――"},
        { "location": "2029/TALK"  , "narrator": "千羽鶴", "text": "通称トライナリーに\n入隊してもらう。"},
        { "location": "2030/TALK"  , "narrator": "神楽", "text": "…は？\n何ですかそれは。"},
        { "location": "2032/TALK"  , "narrator": "神楽", "text": "それのどこか、\nお膳立てになるんですか？"},
        { "location": "2033/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめは、\nトライナリーの隊員。"},
        { "location": "2034/TALK"  , "narrator": "千羽鶴", "text": "そしてメンバーは、\nあなたを含めて５人。"},
        { "location": "2035/TALK"  , "narrator": "千羽鶴", "text": "やろうと思えば、\n２４時間いつでも\n彼女の傍にいるのも可能。"},
        { "location": "2036/TALK"  , "narrator": "千羽鶴", "text": "これで、いつでも\nあの子を簡単に壊せる。"},
        { "location": "2037/TALK"  , "narrator": "千羽鶴", "text": "あと。"},
        { "location": "2038/TALK"  , "narrator": "千羽鶴", "text": "トライナリーに入隊して\nくれれば、私はあなたの\n特別な任務のことも――"},
        { "location": "2039/TALK"  , "narrator": "千羽鶴", "text": "外からの来訪者である\nことも、そしてあなたの\nミッションについても。"},
        { "location": "2040/TALK"  , "narrator": "千羽鶴", "text": "全て隠蔽し、\n保護することができる。"},
        { "location": "2041/TALK"  , "narrator": "千羽鶴", "text": "私からの提示は以上。\n他にも何かあれば。"},
        { "location": "2042/TALK"  , "narrator": "神楽", "text": "…十分です。"},
        { "location": "2043/TALK"  , "narrator": "千羽鶴", "text": "よかった。"},
        { "location": "2044/TALK"  , "narrator": "神楽", "text": "…話は以上ですか？"},
        { "location": "2045/TALK"  , "narrator": "千羽鶴", "text": "ええ、そう。"},
        { "location": "2046/TALK"  , "narrator": "神楽", "text": "じゃあ、今日はもう\nひとりになっても\nいいですか？"},
        { "location": "2047/TALK"  , "narrator": "神楽", "text": "私これでも一応、\n被害者なんですけど。"},
        { "location": "2048/TALK"  , "narrator": "千羽鶴", "text": "ええ、もちろん。\n今日はゆっくり休んで。"},
        { "location": "2055/TALK"  , "narrator": "千羽鶴", "text": "……そうだ。\nもう一つ。"},
        { "location": "2056/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめとは、\n表面上、なるべく仲良く\nなった方がいい。"},
        { "location": "2057/TALK"  , "narrator": "神楽", "text": "破壊対象の子と\n仲良くする意味なんて\nないと思いますけど？"},
        { "location": "2065/TALK"  , "narrator": "千羽鶴", "text": "仲良くすることで、\n逢瀬つばめに\n隙を作らせる。"},
        { "location": "2066/TALK"  , "narrator": "千羽鶴", "text": "あなたに対して自らの魂を\n捧げるくらいになれば…。"},
        { "location": "2067/TALK"  , "narrator": "千羽鶴", "text": "より簡単にミッションを\n達成出来るはず。"},
        { "location": "2069/TALK"  , "narrator": "神楽", "text": "…ありえませんよ。\n自ら魂を捧げるだなんて。"},
        { "location": "2070/TALK"  , "narrator": "千羽鶴", "text": "そう？"},
        { "location": "2071/TALK"  , "narrator": "神楽", "text": "あるわけないですよ。"},
        { "location": "2072/TALK"  , "narrator": "神楽", "text": "まあ、隙を作らせる\nというのには\n賛成ですから…。"},
        { "location": "2073/TALK"  , "narrator": "神楽", "text": "少なくとも、\n警戒をされないよう\n努力します。"},
        { "location": "2074/TALK"  , "narrator": "千羽鶴", "text": "それでいい。"},
        { "location": "2075/TALK"  , "narrator": "千羽鶴", "text": "期待している。\n私の協力者、\n一之宮神楽…。"},
        { "location": "2076/TALK"  , "narrator": "神楽", "text": "私からも最後に１つ。"},
        { "location": "2077/TALK"  , "narrator": "千羽鶴", "text": "何？"},
        { "location": "2078/TALK"  , "narrator": "神楽", "text": "私の事を\n一之宮と呼ぶのは\nやめてください。"},
        { "location": "2079/TALK"  , "narrator": "千羽鶴", "text": "では、何と？"},
        { "location": "2080/TALK"  , "narrator": "神楽", "text": "私は……"},
        { "location": "2081/TALK"  , "narrator": "神楽", "text": "私は、今でも\n卯月神楽ですから。"},
        { "location": "2082/TALK"  , "narrator": "千羽鶴", "text": "……そう。\nわかった。"},
        { "location": "2083/TALK"  , "narrator": "千羽鶴", "text": "それじゃ卯月神楽。\nなにかあればまた。"},
        { "location": "2088/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2089/TALK"  , "narrator": "神楽", "text": "う～ん…。"},
        { "location": "2090/TALK"  , "narrator": "神楽", "text": "はぁ…仕方ない…。"},
        { "location": "2104/TALK"  , "narrator": "システム", "text": "神楽さんが、あなたの\nブロックを解除しました。"},
        { "location": "2107/TALK"  , "narrator": "神楽", "text": "$handle$さん"},
        { "location": "2108/TALK"  , "narrator": "神楽", "text": "切断されている外部との接続は"},
        { "location": "2109/TALK"  , "narrator": "神楽", "text": "直せないんですか？"},
        { "location": "2111/SEL"   , "narrator": "", "text": "それはできない"},
        { "location": "2112/SEL"   , "narrator": "", "text": "外部となんて接続しない方がいい"},
        { "location": "2113/ACT"   , "narrator": "", "text": "それはできない"},
        { "location": "2114/ACT"   , "narrator": "", "text": "外部となんて接続しない方がいい"},
        { "location": "2116/TALK"  , "narrator": "神楽", "text": "そうですか"},
        { "location": "2119/TALK"  , "narrator": "神楽", "text": "わかりました"},
        { "location": "2120/TALK"  , "narrator": "神楽", "text": "本当のことは教えていただけないようなので"},
        { "location": "2121/TALK"  , "narrator": "神楽", "text": "独り言です"},
        { "location": "2122/TALK"  , "narrator": "神楽", "text": "私はあなたのことを"},
        { "location": "2123/TALK"  , "narrator": "神楽", "text": "まったく信用していません"},
        { "location": "2126/TALK"  , "narrator": "神楽", "text": "でも、さっきのちはるという子も"},
        { "location": "2127/TALK"  , "narrator": "神楽", "text": "まったく信用していません"},
        { "location": "2128/TALK"  , "narrator": "神楽", "text": "そして外の世界の連中は"},
        { "location": "2129/TALK"  , "narrator": "神楽", "text": "もっと冷酷な奴らです"},
        { "location": "2130/TALK"  , "narrator": "神楽", "text": "だから、いち意見として"},
        { "location": "2131/TALK"  , "narrator": "神楽", "text": "あなたの意見も聞いていくことにします"},
        { "location": "2132/TALK"  , "narrator": "神楽", "text": "勘違いはしないでくださいね"},
        { "location": "2133/TALK"  , "narrator": "神楽", "text": "あなたを信用するためではありませんから"},
        { "location": "2134/TALK"  , "narrator": "神楽", "text": "あくまでも"},
        { "location": "2135/TALK"  , "narrator": "神楽", "text": "ちはるや、それ以外の意見と照らし合わせ"},
        { "location": "2136/TALK"  , "narrator": "神楽", "text": "自分で答えを見つけるためです"},
        { "location": "2138/SEL"   , "narrator": "", "text": "おー、かっこいいー"},
        { "location": "2139/SEL"   , "narrator": "", "text": "ご意見番は任せとけ！"},
        { "location": "2140/SEL"   , "narrator": "", "text": "信用してもらうために仲良くしよう"},
        { "location": "2141/ACT"   , "narrator": "", "text": "おー、かっこいいー"},
        { "location": "2142/TALK"  , "narrator": "神楽", "text": "いや、ちょっと"},
        { "location": "2144/TALK"  , "narrator": "神楽", "text": "もう少し空気考えて返事してくれます？"},
        { "location": "2145/TALK"  , "narrator": "神楽", "text": "なんか気が抜けるんですけど"},
        { "location": "2146/ACT"   , "narrator": "", "text": "ご意見番は任せとけ！"},
        { "location": "2147/TALK"  , "narrator": "神楽", "text": "そこまで求めてませんから"},
        { "location": "2148/TALK"  , "narrator": "神楽", "text": "普通に意見してくれるだけで十分です"},
        { "location": "2150/SEL"   , "narrator": "", "text": "遠慮するな！"},
        { "location": "2151/SEL"   , "narrator": "", "text": "やはり信用出来ないというのか？"},
        { "location": "2152/ACT"   , "narrator": "", "text": "遠慮するな！"},
        { "location": "2153/TALK"  , "narrator": "神楽", "text": "遠慮とかじゃないんですけど"},
        { "location": "2156/TALK"  , "narrator": "神楽", "text": "いえもういいです。"},
        { "location": "2157/ACT"   , "narrator": "", "text": "やはり信用出来ないというのか？"},
        { "location": "2158/TALK"  , "narrator": "神楽", "text": "だからそう言ってるじゃないですか"},
        { "location": "2159/TALK"  , "narrator": "神楽", "text": "もぉ"},
        { "location": "2160/TALK"  , "narrator": "神楽", "text": "私の話聞いてくれてるのか不安です"},
        { "location": "2162/ACT"   , "narrator": "", "text": "信用してもらうために仲良くしよう"},
        { "location": "2163/TALK"  , "narrator": "神楽", "text": "なんというか"},
        { "location": "2164/TALK"  , "narrator": "神楽", "text": "超ポジティブ？"},
        { "location": "2165/TALK"  , "narrator": "神楽", "text": "信用してないと言ったばかりなのに"},
        { "location": "2166/TALK"  , "narrator": "神楽", "text": "まさかそんなこと言ってくるとは思いませんでした"},
        { "location": "2168/TALK"  , "narrator": "神楽", "text": "まあなんでもいいですよ"},
        { "location": "2170/TALK"  , "narrator": "神楽", "text": "とにかく言いたいことは言ったので"},
        { "location": "2171/TALK"  , "narrator": "神楽", "text": "落ちますね"},
        { "location": "2182/TALK"  , "narrator": "神楽", "text": "…ヘンなの。"},
        { "location": "2183/TALK"  , "narrator": "神楽", "text": "他の世界の人って、\nみんなこんな感じ\nなのかしら？"},
        { "location": "2184/TALK"  , "narrator": "神楽", "text": "まあ、そのおかげか\nちょっと気持ちが\n落ち着いたけど…。"},
        { "location": "2185/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2186/TALK"  , "narrator": "神楽", "text": "っていうか、\n本当に人？"},
        { "location": "2187/TALK"  , "narrator": "神楽", "text": "実際に顔を見た\nわけじゃないんだから…。"},
        { "location": "2188/TALK"  , "narrator": "神楽", "text": "人って決めつけるのも\n危険かしら？"},
        { "location": "2189/TALK"  , "narrator": "神楽", "text": "それに、アカウントを\nもらった時に受けた\nレクチャとは違うような？"},
        { "location": "2190/TALK"  , "narrator": "神楽", "text": "…もしかして、\n奴らの差し金じゃない\nのかしら？"},
        { "location": "2191/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2192/TALK"  , "narrator": "神楽", "text": "ふぅ…まあ、いいや。\nそれはいずれ\n聞き出すとして…。"},
        { "location": "2194/TALK"  , "narrator": "神楽", "text": "今は、ゆっくり休もう…。"},
        { "location": "2197/DIALOG", "narrator": "dialog_black", "text": "――逢瀬つばめ。\n必ずや、壊して差し上げます。\n\nあなたが、音羽のことを\n壊したように。"},
        { "location": "2206/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【03 赤い髪の転校生】"},
        { "location": "2217/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【03 赤い髪の転校生】"}
    ]
}
