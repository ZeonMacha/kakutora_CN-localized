{
    "dir": "chap02/daydra/dd_ch02_02_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "2202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "國政綾水という存在＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アーヤ導入"},
        { "location": "25/TALK"   , "narrator": "小夜", "text": "アーヤ、発達心理学の\nレポートって進んでる？"},
        { "location": "28/TALK"   , "narrator": "アーヤ", "text": "うーん…５０％って\nところかしら？\n小夜はどうなの？"},
        { "location": "29/TALK"   , "narrator": "小夜", "text": "全然…児童福祉論のは\nもう終わったんだけどね。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "間に合うの！？\n提出は両方とも来週よ？"},
        { "location": "31/TALK"   , "narrator": "小夜", "text": "ギリギリどうにか、って\n感じかしら？"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "それならいいんだけど…。\n留年とかしないでよ？"},
        { "location": "33/TALK"   , "narrator": "小夜", "text": "わかってるって。\nみんなで一緒に卒業する、\nって約束だもんね。"},
        { "location": "34/TALK"   , "narrator": "小夜", "text": "…あ、話は変わるけど、\nサークルの次の劇で\n使ううさぎの人形――"},
        { "location": "35/TALK"   , "narrator": "小夜", "text": "もう完成したの？"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "ごめん！\n急いではいるんだけど、\nギリギリになるかも。"},
        { "location": "38/TALK"   , "narrator": "小夜", "text": "そっかぁ…。やっぱり、\n<color=red>任務</color>の方が忙しいの？"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "うん…昼夜問わずだから、\n中々時間が取れなくて…。"},
        { "location": "41/TALK"   , "narrator": "小夜", "text": "大変そうだね…。"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "でも、絶対に本番前には\n完璧に仕上げるから！"},
        { "location": "44/TALK"   , "narrator": "小夜", "text": "あはは、わかってるって。\nアーヤ、そういうとこ\nしっかりしてるもんね。"},
        { "location": "45/TALK"   , "narrator": "小夜", "text": "…でもさ、前々から\n気になってたんだけど。"},
        { "location": "46/TALK"   , "narrator": "小夜", "text": "どうしてアーヤは、\n幼児児童教育学科を\n選んだの？"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "え？"},
        { "location": "49/TALK"   , "narrator": "小夜", "text": "だって、アーヤは\nうちの大学に特待生と\nして入学したじゃない？"},
        { "location": "50/TALK"   , "narrator": "小夜", "text": "花形の国際政経学部とか\n社会管理学部でも、\n自由に選べたでしょ？"},
        { "location": "51/TALK"   , "narrator": "小夜", "text": "なのに、どうして\n弱小の教育学部なんか\n選んだのかな、って…。"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "えっと、それは…。"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "本当は、幼稚園教諭に\nなりたくて、教育学部を\n選んだんだけど――"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "似合わないって思われ\nそうだし、言うのは少し\n恥ずかしいかも…。"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "まあ、色々あったのよ。"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "それより、来週行く\n幼稚園って、初めての\nところよね？"},
        { "location": "63/TALK"   , "narrator": "小夜", "text": "そうそう。\n西荻窪の幼稚園よ。"},
        { "location": "64/TALK"   , "narrator": "小夜", "text": "まさか、サークルに\n直接依頼が来るとは\n思わなかったよね？"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "ええ…あさがおの\n人形劇をうちでも\n演じてほしい、って――"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "あのメール見た時は、\n本当嬉しくて――"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "っ！？"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "アラート！？"},
        { "location": "84/TALK"   , "narrator": "小夜", "text": "…出動？"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "ええ…。"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "場所は…後楽園？\nなら、このまま水道橋まで\n行って――"},
        { "location": "91/TALK"   , "narrator": "乗客", "text": "きゃあっ！？"},
        { "location": "93/TALK"   , "narrator": "小夜", "text": "ちょ！？\n何なのよ、もう！"},
        { "location": "99/TALK"   , "narrator": "車内アナウンス", "text": "大変お急ぎのところ、\n申し訳ありません。"},
        { "location": "100/TALK"  , "narrator": "車内アナウンス", "text": "只今、情報管理庁より\n発令されました警報に\nより――"},
        { "location": "101/TALK"  , "narrator": "車内アナウンス", "text": "この電車、緊急停止を\nしております。"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "…最悪。"},
        { "location": "105/TALK"  , "narrator": "乗客", "text": "管理庁？\nそれって、フェノメノンが\n出たってことか？"},
        { "location": "106/TALK"  , "narrator": "乗客", "text": "ウソっ…どこかしら？\nまだネットには\n出てないけど…。"},
        { "location": "107/TALK"  , "narrator": "乗客", "text": "なあ、ここも\n包まれちまうのか！？"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "…まだ、一般には情報が\n出てないみたい。"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "ごめん、小夜。\nちょっと館長に\n連絡するわ。"},
        { "location": "127/TALK"  , "narrator": "小夜", "text": "…………。"},
        { "location": "129/TALK"  , "narrator": "小夜", "text": "ね、ねえ、アーヤ。\nどこで出たの？"},
        { "location": "130/TALK"  , "narrator": "小夜", "text": "ここも巻き込まれる？\n私、死んじゃったり\nするの？"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "えっと…ごめん。\nどこで発生してるかは\nちょっと言えないわ。"},
        { "location": "134/TALK"  , "narrator": "小夜", "text": "誰にも言わないから。\nお願い、こっそり！"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "そう言われても、\n世間に出てない以上、\n機密扱いだから…。"},
        { "location": "137/TALK"  , "narrator": "小夜", "text": "そっか…。"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "でも……\nここは絶対大丈夫。\nそれだけは保証するわ。"},
        { "location": "142/TALK"  , "narrator": "小夜", "text": "…うん。"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "…え！？"},
        { "location": "153/TALK"  , "narrator": "小夜", "text": "何、どうしたの？"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "館長から…近くの整備\n踏切に車を送ったから――"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "不自然に思われないように\n電車を抜け出して、\nそこまで来い、って…。"},
        { "location": "156/TALK"  , "narrator": "小夜", "text": "何そのミッションイン\nポッシブル！？\nここまで来てくれないの？"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "管理庁の車がここまで\n来たら、それこそ大騒ぎに\nなるわ。"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "でも、どうしよう…。\n不自然に思われないように\nって言われても…。"},
        { "location": "160/TALK"  , "narrator": "小夜", "text": "…お腹が痛い！\nもう我慢できない！！"},
        { "location": "161/TALK"  , "narrator": "小夜", "text": "って、騒ぎながら\n非常ドアコック開けるのは\nどうかしら？"},
        { "location": "163/TALK"  , "narrator": "アーヤ", "text": "きゃ、却下！\nいくらなんでも\n恥ずかし過ぎる。"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "運転手か車掌に言って、\n下ろしてもらうわ。"},
        { "location": "165/TALK"  , "narrator": "小夜", "text": "この満員電車の中！？\nここ丁度真ん中ぐらいよ？\n超時間かかるってば。"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "…そうね……。"},
        { "location": "173/TALK"  , "narrator": "アーヤ", "text": "あっ、また館長から…。"},
        { "location": "174/TALK"  , "narrator": "アーヤ", "text": "…っ！？\nそんな！"},
        { "location": "175/TALK"  , "narrator": "小夜", "text": "ど、どうしたの！？"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "一応、鉄道会社の方にも\n手を回したから、そのうち\n迎えは来るけど――"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "無理そうなら、\n他のメンバーだけで\n処理に当たるって…。"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "何とかしなくちゃ。"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "私はリーダー\nなんだから――"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "こんなことで行けない\nなんて、絶対に許されない。"},
        { "location": "182/TALK"  , "narrator": "アーヤ", "text": "こんな時こそ、どうするか\n落ち着いて考えないと…。"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "でも、こうしてる間にも\n時間が…っ……"},
        { "location": "185/TALK"  , "narrator": "アーヤ", "text": "どうしよう……"},
        { "location": "230/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "239/TALK"  , "narrator": "千羽鶴", "text": "[ココロスフィア]の説明は\n前に私がしてると思うけど\nもう一度聞く？"},
        { "location": "240/SEL"   , "narrator": "", "text": "はい"},
        { "location": "241/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "242/ACT"   , "narrator": "", "text": "はい"},
        { "location": "243/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "245/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "253/TALK"  , "narrator": "千羽鶴", "text": "ようこそ。"},
        { "location": "254/SEL"   , "narrator": "", "text": "ここは…精神世界？"},
        { "location": "255/ACT"   , "narrator": "", "text": "ここは…精神世界？"},
        { "location": "257/TALK"  , "narrator": "千羽鶴", "text": "そう。\nバトル説明で入ったのと\n同じ、精神世界。"},
        { "location": "258/TALK"  , "narrator": "千羽鶴", "text": "ここは、後ろにいる\n彼女、國政綾水の\n精神世界の入口――"},
        { "location": "259/TALK"  , "narrator": "千羽鶴", "text": "通称<color=red>【[ココロゲート]】</color>\nと呼ばれている場所。"},
        { "location": "260/TALK"  , "narrator": "千羽鶴", "text": "ここでは彼女は\nあなたと普通に\n対話できる。"},
        { "location": "261/TALK"  , "narrator": "千羽鶴", "text": "彼女の心に直接\n語りかけることで、\n心を動かすの。"},
        { "location": "262/TALK"  , "narrator": "千羽鶴", "text": "早速、\n彼女に話しかけてみて。"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "あら。"},
        { "location": "271/TALK"  , "narrator": "アーヤ", "text": "こんなところに\nお客様なんて\n珍しいわね。"},
        { "location": "272/SEL"   , "narrator": "", "text": "はじめまして。$handle$です"},
        { "location": "273/ACT"   , "narrator": "", "text": "はじめまして。$handle$です"},
        { "location": "276/TALK"  , "narrator": "アーヤ", "text": "ようこそ、國政綾水の\n[ココロゲート]へ。"},
        { "location": "277/TALK"  , "narrator": "アーヤ", "text": "私は[ココロの司書]を\nやっている人格。\nこれからよろしくね。"},
        { "location": "279/SEL"   , "narrator": "", "text": "よろしく"},
        { "location": "280/SEL"   , "narrator": "", "text": "司書のことはよく知ってる"},
        { "location": "281/ACT"   , "narrator": "", "text": "よろしく"},
        { "location": "283/ACT"   , "narrator": "", "text": "司書のことはよく知ってる"},
        { "location": "287/SEL"   , "narrator": "", "text": "よろしく"},
        { "location": "288/ACT"   , "narrator": "", "text": "よろしく"},
        { "location": "293/TALK"  , "narrator": "アーヤ", "text": "あら、\n知ってたのね。"},
        { "location": "294/TALK"  , "narrator": "アーヤ", "text": "それなら話は早いわ。"},
        { "location": "298/TALK"  , "narrator": "アーヤ", "text": "この[ココロゲート]って\n場所は、綾水の心の中の\n入口に当たるところね。"},
        { "location": "299/TALK"  , "narrator": "アーヤ", "text": "綾水の喜怒哀楽、\n悩み、記憶等は全て\nここに繋がってるの。"},
        { "location": "300/TALK"  , "narrator": "アーヤ", "text": "それらは全て、１つずつ\n番号付きの部屋に収め\nられて、管理されてる。"},
        { "location": "301/TALK"  , "narrator": "アーヤ", "text": "通常、わたしが平常心で\nいる時は、それらの扉は\n正常に機能してる。"},
        { "location": "302/TALK"  , "narrator": "アーヤ", "text": "けど、今みたいに悩ん\nじゃうと、扉がちゃんと\n機能しなくなるのよね。"},
        { "location": "303/TALK"  , "narrator": "アーヤ", "text": "そして場合によっては、\n間違った扉が\n開いてしまうの。"},
        { "location": "304/SEL"   , "narrator": "", "text": "それは、選択をミスってしまうってこと？"},
        { "location": "305/ACT"   , "narrator": "", "text": "それは、選択をミスってしまうってこと？"},
        { "location": "307/TALK"  , "narrator": "アーヤ", "text": "そう！\nそうなると大変でしょ？\n人生踏み外しちゃう。"},
        { "location": "308/TALK"  , "narrator": "アーヤ", "text": "司書である私は、どの\n扉を開ければ正しい選択\nかは分かるんだけど…。"},
        { "location": "309/TALK"  , "narrator": "アーヤ", "text": "物理的に扉を開ける事は\n許されていなくて。"},
        { "location": "310/TALK"  , "narrator": "アーヤ", "text": "だから、\n$handle$さんに\n手伝って欲しいのよね。"},
        { "location": "311/SEL"   , "narrator": "", "text": "どうやって？"},
        { "location": "312/ACT"   , "narrator": "", "text": "どうやって？"},
        { "location": "314/TALK"  , "narrator": "アーヤ", "text": "正しい扉の選択を阻止する\n<color=red>【[クラン]】</color>という存在を\n倒して欲しいの。"},
        { "location": "315/TALK"  , "narrator": "アーヤ", "text": "<color=red>【[クラン]】</color>ってのは、私の\n不安や恐れが、あまりに\n大きくなってしまった物。"},
        { "location": "316/TALK"  , "narrator": "アーヤ", "text": "その<color=red>【[クラン]】</color>が\n正しい扉を開くのを\n妨害してしまうのよ。"},
        { "location": "317/TALK"  , "narrator": "アーヤ", "text": "扉の前では、何とか\nしたいと思ってる私が\n<color=red>【[クラン]】</color>と戦ってる。"},
        { "location": "318/TALK"  , "narrator": "アーヤ", "text": "その彼女に、是非\n貴方の力を貸してあげて\n欲しいの。"},
        { "location": "319/TALK"  , "narrator": "アーヤ", "text": "お願い、出来るかしら。"},
        { "location": "321/SEL"   , "narrator": "", "text": "オッケー"},
        { "location": "322/SEL"   , "narrator": "", "text": "やだ"},
        { "location": "323/ACT"   , "narrator": "", "text": "オッケー"},
        { "location": "325/TALK"  , "narrator": "アーヤ", "text": "ありがとう！\n助かるわ。"},
        { "location": "326/ACT"   , "narrator": "", "text": "やだ"},
        { "location": "327/TALK"  , "narrator": "アーヤ", "text": "えーっ！\nそんな、酷い。"},
        { "location": "328/TALK"  , "narrator": "アーヤ", "text": "お願い！\n協力して！\nこの通り！"},
        { "location": "332/SEL"   , "narrator": "", "text": "それで、どうすればいいの？"},
        { "location": "333/ACT"   , "narrator": "", "text": "それで、どうすればいいの？"},
        { "location": "335/TALK"  , "narrator": "アーヤ", "text": "え？　ああ、\nちょっと待ってね。"},
        { "location": "336/TALK"  , "narrator": "アーヤ", "text": "まずは現状をちゃんと\n把握しなくちゃ。"},
        { "location": "338/TALK"  , "narrator": "アーヤ", "text": "ええと……"},
        { "location": "342/SEL"   , "narrator": "", "text": "ココロの中でもスマホで検索なんだ……"},
        { "location": "343/ACT"   , "narrator": "", "text": "ココロの中でもスマホで検索なんだ……"},
        { "location": "346/TALK"  , "narrator": "アーヤ", "text": "ふふ、そうね。\n楽なのよ――"},
        { "location": "348/TALK"  , "narrator": "アーヤ", "text": "あ、これね。"},
        { "location": "352/TALK"  , "narrator": "アーヤ", "text": "$handle$さんへ依頼を\n希望したい問題案件が\nありました。"},
        { "location": "354/TALK"  , "narrator": "アーヤ", "text": "早速今から、\nその<color=red>【問題の扉】</color>を\nコールするわね。"},
        { "location": "362/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0x215番地から\n0x8FE番地へ。"},
        { "location": "377/TALK"  , "narrator": "アーヤ", "text": "シーク完了しました。"},
        { "location": "378/TALK"  , "narrator": "アーヤ", "text": "この扉に、今回の悩みの\n根源になっている\n<color=red>【[クラン]】</color>がいるわ。"},
        { "location": "380/TALK"  , "narrator": "アーヤ", "text": "今回の私の悩みは、\n恥ずかしい思いをして\nまで出動すべきか否か。"},
        { "location": "381/TALK"  , "narrator": "アーヤ", "text": "本人は悩んでるようだ\nけど、実は内心は既に\n決まってるの。"},
        { "location": "382/TALK"  , "narrator": "アーヤ", "text": "それはココロファイル\nNo.02-591-44に、\nしっかり記録されてる。"},
        { "location": "386/TALK"  , "narrator": "アーヤ", "text": "ココロファイル\nNo.02-591-44に\nよれば――"},
        { "location": "387/TALK"  , "narrator": "アーヤ", "text": "『恥は一時のもの\n後悔は一生のもの』"},
        { "location": "388/TALK"  , "narrator": "アーヤ", "text": "ですって。"},
        { "location": "389/TALK"  , "narrator": "アーヤ", "text": "まあ確かに、行かな\nかった結果、最悪の\n事態になったら――"},
        { "location": "390/TALK"  , "narrator": "アーヤ", "text": "一生悔やんでも\n悔やみきれないものね。"},
        { "location": "391/SEL"   , "narrator": "", "text": "その通り"},
        { "location": "392/SEL"   , "narrator": "", "text": "大丈夫なんじゃない？"},
        { "location": "393/ACT"   , "narrator": "", "text": "その通り"},
        { "location": "395/TALK"  , "narrator": "アーヤ", "text": "よかった。\n貴方も同じ考えで。"},
        { "location": "396/TALK"  , "narrator": "アーヤ", "text": "それじゃ早速、\n協力してくださいな。"},
        { "location": "397/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！"},
        { "location": "404/ACT"   , "narrator": "", "text": "大丈夫なんじゃない？"},
        { "location": "405/TALK"  , "narrator": "アーヤ", "text": "まあ確かに、他の\nメンバーを信頼は\nしてるけど。"},
        { "location": "406/TALK"  , "narrator": "アーヤ", "text": "今回の問題って、\n他のメンバーの能力は\nあまり関係無いのよ。"},
        { "location": "407/TALK"  , "narrator": "アーヤ", "text": "わかるかしら。"},
        { "location": "408/TALK"  , "narrator": "アーヤ", "text": "自分が後で後悔するか\nしないか。\nそこがポイントなの。"},
        { "location": "409/TALK"  , "narrator": "アーヤ", "text": "例え滞りなく任務完了\nしたとしても、行かな\nかったら絶対後悔する。"},
        { "location": "410/TALK"  , "narrator": "アーヤ", "text": "そういうことなの。"},
        { "location": "411/TALK"  , "narrator": "アーヤ", "text": "でも、それでも協力\nできないというなら、\nそれで構わないわ。"},
        { "location": "412/TALK"  , "narrator": "アーヤ", "text": "私に強制する権限なんて\n一切ないんだから。"},
        { "location": "413/SEL"   , "narrator": "", "text": "協力する"},
        { "location": "414/SEL"   , "narrator": "", "text": "協力しない"},
        { "location": "415/ACT"   , "narrator": "", "text": "協力する"},
        { "location": "417/ACT"   , "narrator": "", "text": "協力しない"},
        { "location": "418/TALK"  , "narrator": "アーヤ", "text": "そう。\n残念だけど、\n仕方ないわよね。"},
        { "location": "419/TALK"  , "narrator": "アーヤ", "text": "一応、扉には\nアクセスできるように\nしておくわね。"},
        { "location": "421/TALK"  , "narrator": "アーヤ", "text": "気が向いたらいつでも\n手伝いに来てくださいね。"},
        { "location": "23/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月3日　5:08 PM</color>\nドームライブ戦直前、\n中央線6号車車内にて。"},
        { "location": "115/DIALOG", "narrator": "Dialog_EventData", "text": "<color=green>5月3日　5:14 PM</color>\nBUNKYOドーム上空。"},
        { "location": "197/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
