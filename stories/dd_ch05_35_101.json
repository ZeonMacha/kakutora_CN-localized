{
    "dir": "chap35/daydra/dd_ch05_35_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "35502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "Developer＜前編＞"
    },
    "entry":
    [
        { "location": "1037/TALK"  , "narrator": "みやび", "text": "…ちゅうわけやき。"},
        { "location": "1038/TALK"  , "narrator": "みやび", "text": "うちらがなにを\n目指しちゅうかは、\n全部語ったわけや。"},
        { "location": "1039/TALK"  , "narrator": "アーヤ", "text": "その上で、\n$handle$さんが\n貴方に質問してるのは――"},
        { "location": "1040/SEL"   , "narrator": "", "text": "$me$が$me$に？？"},
        { "location": "1041/ACT"   , "narrator": "", "text": "$me$が$me$に？？"},
        { "location": "1043/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい。こちらの\n$handle$さんが\n貴方に質問してるのは――"},
        { "location": "1044/TALK"  , "narrator": "アーヤ", "text": "この計画に\n協力してくれるかどうか。"},
        { "location": "1045/SEL"   , "narrator": "", "text": "する"},
        { "location": "1046/SEL"   , "narrator": "", "text": "しない"},
        { "location": "1047/SEL"   , "narrator": "", "text": "3人とも絶対に洗脳を解いて助けてあげるから！"},
        { "location": "1048/ACT"   , "narrator": "", "text": "する"},
        { "location": "1049/TALK"  , "narrator": "アーヤ", "text": "ありがとう。"},
        { "location": "1051/ACT"   , "narrator": "", "text": "しない"},
        { "location": "1054/TALK"  , "narrator": "ガブリエラ", "text": "…だそうよ？"},
        { "location": "1055/TALK"  , "narrator": "みやび", "text": "うちらの役目は、\nこれで終了かね？"},
        { "location": "1058/TALK"  , "narrator": "アーヤ", "text": "あちらの人に、\nミレニアム計画を\n説明する――"},
        { "location": "1059/TALK"  , "narrator": "アーヤ", "text": "それしか聞いてないから\nこれでお終いじゃない？"},
        { "location": "1061/TALK"  , "narrator": "プレイヤー", "text": "というわけで、彼女らの過去の記憶に説明してもらいました"},
        { "location": "1062/SEL"   , "narrator": "", "text": "もしかしてヤラセ？"},
        { "location": "1063/SEL"   , "narrator": "", "text": "思い入れが無いからって、彼女達を道具のように使わないで！"},
        { "location": "1064/ACT"   , "narrator": "", "text": "もしかしてヤラセ？"},
        { "location": "1065/TALK"  , "narrator": "プレイヤー", "text": "記憶だから、もちろん彼女達の本心です。日本に入る前の、だけど"},
        { "location": "1066/ACT"   , "narrator": "", "text": "思い入れが無いからって、彼女達を道具のように使わないで！"},
        { "location": "1067/TALK"  , "narrator": "プレイヤー", "text": "思い入れあるよ、$me$は彼女らが日本に入る前までのナビだったんだから"},
        { "location": "1068/TALK"  , "narrator": "プレイヤー", "text": "もちろん、名前だって$handle$じゃないよ、ちゃんと自分のアカがある"},
        { "location": "1070/TALK"  , "narrator": "プレイヤー", "text": "それで早速本題に戻すんだけど、ミレニアム計画には協力できない感じ？"},
        { "location": "1071/SEL"   , "narrator": "", "text": "さっき言ったとおり。出来るわけがない"},
        { "location": "1072/ACT"   , "narrator": "", "text": "さっき言ったとおり。出来るわけがない"},
        { "location": "1074/TALK"  , "narrator": "プレイヤー", "text": "じゃあ申し訳ないけど、前にした取引、今こそ使わせてもらう"},
        { "location": "1075/SEL"   , "narrator": "", "text": "本気か？"},
        { "location": "1076/SEL"   , "narrator": "", "text": "なんのことやら？"},
        { "location": "1077/ACT"   , "narrator": "", "text": "本気か？"},
        { "location": "1078/ACT"   , "narrator": "", "text": "なんのことやら？"},
        { "location": "1079/TALK"  , "narrator": "プレイヤー", "text": "とぼけても無駄だって"},
        { "location": "1080/SEL"   , "narrator": "", "text": "何が望みだ？"},
        { "location": "1081/ACT"   , "narrator": "", "text": "何が望みだ？"},
        { "location": "1084/TALK"  , "narrator": "プレイヤー", "text": "今回は、君の方が譲歩して欲しい"},
        { "location": "1085/SEL"   , "narrator": "", "text": "譲歩する"},
        { "location": "1086/SEL"   , "narrator": "", "text": "譲歩しない"},
        { "location": "1087/ACT"   , "narrator": "", "text": "譲歩する"},
        { "location": "1089/ACT"   , "narrator": "", "text": "譲歩しない"},
        { "location": "1090/TALK"  , "narrator": "プレイヤー", "text": "約束が違うし！！"},
        { "location": "1091/SEL"   , "narrator": "", "text": "無理なモノは無理だ"},
        { "location": "1092/ACT"   , "narrator": "", "text": "無理なモノは無理だ"},
        { "location": "1095/TALK"  , "narrator": "プレイヤー", "text": "確かに、$me$達の利害は相反する"},
        { "location": "1097/TALK"  , "narrator": "プレイヤー", "text": "けれども、約束したことを破るというのは正直倫理に反すると思うよ"},
        { "location": "1099/TALK"  , "narrator": "プレイヤー", "text": "$me$達はお互い大事な人がいて、その人のために頑張っている"},
        { "location": "1101/TALK"  , "narrator": "プレイヤー", "text": "そこがお互いの類似点だということは共有できた"},
        { "location": "1102/SEL"   , "narrator": "", "text": "同感だ"},
        { "location": "1103/SEL"   , "narrator": "", "text": "いや、してないけど？"},
        { "location": "1104/ACT"   , "narrator": "", "text": "同感だ"},
        { "location": "1105/ACT"   , "narrator": "", "text": "いや、してないけど？"},
        { "location": "1106/TALK"  , "narrator": "プレイヤー", "text": "冗談を言うような状況じゃないから"},
        { "location": "1109/TALK"  , "narrator": "プレイヤー", "text": "なりふり構わないというなら、それは$me$だって同じだよ"},
        { "location": "1111/TALK"  , "narrator": "プレイヤー", "text": "その中でもフェアにやるのが紳士的な交渉だと思うんだけど"},
        { "location": "1112/SEL"   , "narrator": "", "text": "同感だ"},
        { "location": "1113/ACT"   , "narrator": "", "text": "同感だ"},
        { "location": "1115/TALK"  , "narrator": "プレイヤー", "text": "じゃあどうして君は、一方的に約束を破るの？"},
        { "location": "1117/TALK"  , "narrator": "プレイヤー", "text": "攻撃ボタン問題でいうなら、$me$はボタンを押さなかったわけで"},
        { "location": "1119/TALK"  , "narrator": "プレイヤー", "text": "それを見届けた後に、君がボタンを押した状態だと言えば、わかるかな"},
        { "location": "1120/SEL"   , "narrator": "", "text": "戦争なんてのは奪ったもの勝ちなんだよ"},
        { "location": "1121/SEL"   , "narrator": "", "text": "それくらい本気なんだよ"},
        { "location": "1122/ACT"   , "narrator": "", "text": "戦争なんてのは奪ったもの勝ちなんだよ"},
        { "location": "1123/TALK"  , "narrator": "プレイヤー", "text": "本気か！？"},
        { "location": "1125/ACT"   , "narrator": "", "text": "それくらい本気なんだよ"},
        { "location": "1127/TALK"  , "narrator": "プレイヤー", "text": "確かに彼女たちが大事なのはわかる"},
        { "location": "1129/TALK"  , "narrator": "プレイヤー", "text": "なりふり構ってられないのもわかる"},
        { "location": "1130/SEL"   , "narrator": "", "text": "わかってもらえて嬉しい"},
        { "location": "1131/SEL"   , "narrator": "", "text": "問題ある行為だというのは理解はしている"},
        { "location": "1132/ACT"   , "narrator": "", "text": "わかってもらえて嬉しい"},
        { "location": "1133/TALK"  , "narrator": "プレイヤー", "text": "受け入れたわけじゃないからお礼はいらない"},
        { "location": "1135/ACT"   , "narrator": "", "text": "問題ある行為だというのは理解している"},
        { "location": "1136/TALK"  , "narrator": "プレイヤー", "text": "理解しているとは思えない"},
        { "location": "1139/TALK"  , "narrator": "プレイヤー", "text": "無理を通せば道理が引っ込むんだけどなぁ"},
        { "location": "1141/TALK"  , "narrator": "プレイヤー", "text": "まあ、君が邪魔するって言っても$me$は推し進めるだけなんだけど"},
        { "location": "1142/SEL"   , "narrator": "", "text": "どうするつもりなの？"},
        { "location": "1143/SEL"   , "narrator": "", "text": "和解は無理なんだね？"},
        { "location": "1144/ACT"   , "narrator": "", "text": "そっちはどうするつもりなの？"},
        { "location": "1145/TALK"  , "narrator": "プレイヤー", "text": "君と同じことをするだけ"},
        { "location": "1147/ACT"   , "narrator": "", "text": "和解は無理なんだね？"},
        { "location": "1148/TALK"  , "narrator": "プレイヤー", "text": "その機会を逃したのはそっちだってば"},
        { "location": "1151/TALK"  , "narrator": "プレイヤー", "text": "$me$は$me$のできる限りの最善を尽くすことにする"},
        { "location": "1153/ACT"   , "narrator": "", "text": "3人とも絶対に洗脳を解いて助けてあげるから！"},
        { "location": "1155/TALK"  , "narrator": "ガブリエラ", "text": "洗脳なんて\nされてないわよ！"},
        { "location": "1156/TALK"  , "narrator": "みやび", "text": "あーなるほどね。\nもしかするとお前さん、\n少々勘違いしちゅうやも。"},
        { "location": "1159/TALK"  , "narrator": "ガブリエラ", "text": "どういうこと？"},
        { "location": "1160/TALK"  , "narrator": "アーヤ", "text": "ちゃんと説明して\nちょうだい？"},
        { "location": "1162/TALK"  , "narrator": "みやび", "text": "簡単に言うと、\n「助けてあげる」ちゅう\n言葉の部分やよ。"},
        { "location": "1163/TALK"  , "narrator": "みやび", "text": "助けるゆうんは、\n現状が進行形で、かつ\n未来を変えられる場合。"},
        { "location": "1164/TALK"  , "narrator": "みやび", "text": "すなわち、時間軸の\n最先端にいる場合にのみ\n有効なことや。"},
        { "location": "1165/TALK"  , "narrator": "アーヤ", "text": "なるほど。\nけど、私達は過去の記憶\nそのものだから――"},
        { "location": "1166/TALK"  , "narrator": "アーヤ", "text": "助けるっていうのは\nなんていうか、\nお門違いってこと？"},
        { "location": "1167/TALK"  , "narrator": "みやび", "text": "まあ、そうゆうことやね。"},
        { "location": "1168/TALK"  , "narrator": "みやび", "text": "お前さんは今、テープ\nレコーダーに向かって\n助ける言うてる感じやよ？"},
        { "location": "1169/TALK"  , "narrator": "アーヤ", "text": "だから、貴方がここで\n出来ることは――"},
        { "location": "1170/TALK"  , "narrator": "ガブリエラ", "text": "説明を聞いて、それに\n回答することだけ。\nどうする？"},
        { "location": "1171/SEL"   , "narrator": "", "text": "協力する"},
        { "location": "1172/SEL"   , "narrator": "", "text": "協力しない"},
        { "location": "1173/ACT"   , "narrator": "", "text": "協力する"},
        { "location": "1175/ACT"   , "narrator": "", "text": "協力しない"},
        { "location": "1182/TALK"  , "narrator": "アーヤ", "text": "外はもう、\n準備が整ってるのね。"},
        { "location": "1183/SEL"   , "narrator": "", "text": "準備って？"},
        { "location": "1184/ACT"   , "narrator": "", "text": "準備って？"},
        { "location": "1186/TALK"  , "narrator": "みやび", "text": "うちら３人が死に、\nつばめちゃんは\n歌で浄化される。"},
        { "location": "1187/TALK"  , "narrator": "みやび", "text": "特につばめちゃんは\n卯月神楽の歌で、完全に\n統一された意識を得る。"},
        { "location": "1188/TALK"  , "narrator": "みやび", "text": "純粋なる無私の\n“世界”になるんよ。"},
        { "location": "1189/TALK"  , "narrator": "みやび", "text": "その準備が整った、\nっちゅうことや。"},
        { "location": "1190/TALK"  , "narrator": "アーヤ", "text": "私達は、逢瀬さんが\nフェノメノンを発症する\n前に約束した。"},
        { "location": "1191/TALK"  , "narrator": "アーヤ", "text": "皆でそれぞれ“世界”に\nなり、この世に安寧を\nもたらそう…って。"},
        { "location": "1192/TALK"  , "narrator": "ガブリエラ", "text": "まずはつばめだったから\nあたし達は応援と調査で\n中に入ったってわけ。"},
        { "location": "1193/TALK"  , "narrator": "ガブリエラ", "text": "中で何があったかは\n良くわからないけど、\nそれでもここまで来れた。"},
        { "location": "1194/TALK"  , "narrator": "ガブリエラ", "text": "あとは、つばめ自身が\n蒸着をするだけって\nいうところまで来たのよ。"},
        { "location": "1195/TALK"  , "narrator": "ガブリエラ", "text": "蒸着が完了すれば、\nミレニアム計画の\n第一段階は終了。"},
        { "location": "1196/SEL"   , "narrator": "", "text": "そんなことしてなんになる？"},
        { "location": "1197/ACT"   , "narrator": "", "text": "そんなことしてなんになる？"},
        { "location": "1199/TALK"  , "narrator": "ガブリエラ", "text": "わからない？\n世界全体が\n安寧が訪れるのよ。"},
        { "location": "1200/TALK"  , "narrator": "ガブリエラ", "text": "そもそも、\n現代社会が上手く\nいかないのって…。"},
        { "location": "1201/TALK"  , "narrator": "ガブリエラ", "text": "誰もが現実に\n絶望しているからなのよ？"},
        { "location": "1203/TALK"  , "narrator": "アーヤ", "text": "努力しても報われない\nことを、みんなは\nわかっている。"},
        { "location": "1204/TALK"  , "narrator": "アーヤ", "text": "だから、世界は\n負のスパイラルに\n陥る。"},
        { "location": "1205/TALK"  , "narrator": "アーヤ", "text": "けど、望むべく\n輝かしい世界が\nこの日本に登場し…。"},
        { "location": "1206/TALK"  , "narrator": "アーヤ", "text": "後に世界中が\nこの恩恵を被れると\nわかったとしたら？"},
        { "location": "1208/TALK"  , "narrator": "ガブリエラ", "text": "みんな、それを無心に\n求めて、最終的には\n争いは減るわ。"},
        { "location": "1209/TALK"  , "narrator": "ガブリエラ", "text": "ゼロになる、とまでは\n言わないけど。"},
        { "location": "1210/TALK"  , "narrator": "みやび", "text": "神の国のような\n幻想を語っちゅう\nわけやない。"},
        { "location": "1211/TALK"  , "narrator": "みやび", "text": "けんど、生まれ\n変わって世界に姿を\n現す日本のような…。"},
        { "location": "1212/TALK"  , "narrator": "みやび", "text": "それに限りなく近い\n奇跡が起これば…。"},
        { "location": "1214/TALK"  , "narrator": "みやび", "text": "世界は、間違いなく\n大きく変わるぞね。"},
        { "location": "1215/TALK"  , "narrator": "アーヤ", "text": "本当は私達が\n自分の意識を持って\nフェノメノンで活動し――"},
        { "location": "1216/TALK"  , "narrator": "ガブリエラ", "text": "今の状況を作り出す\n筈だったのよね。"},
        { "location": "1217/TALK"  , "narrator": "みやび", "text": "それが出来んかったのが\n心残りっちゃあ\n心残りやけんど――"},
        { "location": "1218/TALK"  , "narrator": "みやび", "text": "うちらが機能して\nいなくても、今それが\n実現するちゅうことは。"},
        { "location": "1219/TALK"  , "narrator": "アーヤ", "text": "ちょっと複雑では\nあるけど、本当に\n良かったと思う。"},
        { "location": "1220/SEL"   , "narrator": "", "text": "具体的には、これからどうなるの…？"},
        { "location": "1221/ACT"   , "narrator": "", "text": "具体的には、これからどうなるの…？"},
        { "location": "1223/TALK"  , "narrator": "ガブリエラ", "text": "今、繭の中で唄われている\n神楽の歌が\n終わる迄の間に――"},
        { "location": "1224/TALK"  , "narrator": "ガブリエラ", "text": "つばめを蒸着させて、\nあたし達も昇華する。"},
        { "location": "1225/SEL"   , "narrator": "", "text": "そんなの無理でしょ、記録映像通り進むなら、このまま神楽の歌は終わるよ"},
        { "location": "1226/ACT"   , "narrator": "", "text": "そんなの無理でしょ、記録映像通り進むなら、このまま神楽の歌は終わるよ"},
        { "location": "1228/TALK"  , "narrator": "ガブリエラ", "text": "だから、あのナビが\nリプレイスしに\n来てるんでしょ？"},
        { "location": "1229/TALK"  , "narrator": "みやび", "text": "あやつは、\nコンソール使って\n発症制御が出来るきね。"},
        { "location": "1230/TALK"  , "narrator": "みやび", "text": "つばめちゃんと\nうちらを\n導いてくれるちや。"},
        { "location": "1232/TALK"  , "narrator": "プレイヤー", "text": "そういうことです"},
        { "location": "1233/SEL"   , "narrator": "", "text": "なるほど、わかった"},
        { "location": "1234/SEL"   , "narrator": "", "text": "いや、わからないし"},
        { "location": "1235/ACT"   , "narrator": "", "text": "なるほど、わかった"},
        { "location": "1236/ACT"   , "narrator": "", "text": "いや、わからないし"},
        { "location": "1237/TALK"  , "narrator": "プレイヤー", "text": "わかろうとしてないだけじゃ…"},
        { "location": "1240/TALK"  , "narrator": "プレイヤー", "text": "だから、今回は$me$達にとって重大な局面なんだ"},
        { "location": "1242/TALK"  , "narrator": "プレイヤー", "text": "本当に、頼むから邪魔しないでほしい"},
        { "location": "1244/TALK"  , "narrator": "プレイヤー", "text": "発症ボタンキャンセルとか、ホント勘弁だからね？"},
        { "location": "1246/SEL"   , "narrator": "", "text": "いや、発症ボタンとかどこにもないし"},
        { "location": "1247/ACT"   , "narrator": "", "text": "いや、発症ボタンとかどこにもないし"},
        { "location": "1249/TALK"  , "narrator": "プレイヤー", "text": "「戻る」と「情報」の間にあるじゃん"},
        { "location": "1250/SEL"   , "narrator": "", "text": "ないってば！！"},
        { "location": "1251/ACT"   , "narrator": "", "text": "ないってば！！"},
        { "location": "1254/TALK"  , "narrator": "プレイヤー", "text": "え、マジで？"},
        { "location": "1256/TALK"  , "narrator": "プレイヤー", "text": "ＯＳの設定の違いかな？"},
        { "location": "1257/SEL"   , "narrator": "", "text": "そっちにはあるの？"},
        { "location": "1258/ACT"   , "narrator": "", "text": "そっちにはあるの？"},
        { "location": "1260/TALK"  , "narrator": "プレイヤー", "text": "いや、ごめん、今の話忘れてくれていいから"},
        { "location": "1261/SEL"   , "narrator": "", "text": "そんなの無理だから！"},
        { "location": "1262/ACT"   , "narrator": "", "text": "そんなの無理だから！"},
        { "location": "1264/TALK"  , "narrator": "プレイヤー", "text": "黙認してくれるだけでいいから"},
        { "location": "1265/SEL"   , "narrator": "", "text": "発症ボタン押さないでよ！？"},
        { "location": "1266/SEL"   , "narrator": "", "text": "$me$も押したかった！"},
        { "location": "1267/ACT"   , "narrator": "", "text": "発症ボタン押さないでよ！？"},
        { "location": "1268/TALK"  , "narrator": "プレイヤー", "text": "君は同情するけど、こればかりはごめんね"},
        { "location": "1269/ACT"   , "narrator": "", "text": "$me$も押したかった！"},
        { "location": "1270/TALK"  , "narrator": "プレイヤー", "text": "なら、押せる$me$を応援してて！"},
        { "location": "1273/TALK"  , "narrator": "プレイヤー", "text": "君の世界に、素敵な心の旅を！"},
        { "location": "1318/SEL"   , "narrator": "", "text": "月神楽！！"},
        { "location": "1319/ACT"   , "narrator": "", "text": "月神楽！！"},
        { "location": "1322/TALK"  , "narrator": "月神楽", "text": "えっ！？"},
        { "location": "1323/TALK"  , "narrator": "月神楽", "text": "ちょっと、\n早すぎですっ！！"},
        { "location": "1324/SEL"   , "narrator": "", "text": "思い止まって！"},
        { "location": "1325/SEL"   , "narrator": "", "text": "倒すよ！"},
        { "location": "1326/ACT"   , "narrator": "", "text": "思い止まって！"},
        { "location": "1327/TALK"  , "narrator": "月神楽", "text": "無理ですよ！\nもう時間も無いんです！"},
        { "location": "1328/SEL"   , "narrator": "", "text": "$me$がライフギャザーをちゃんと護るから、$me$に任せて！"},
        { "location": "1329/SEL"   , "narrator": "", "text": "$me$が神楽をちゃんと護るから、$me$に任せて！"},
        { "location": "1330/ACT"   , "narrator": "", "text": "$me$がライフギャザーをちゃんと護るから、$me$に任せて！"},
        { "location": "1331/ACT"   , "narrator": "", "text": "$me$が神楽をちゃんと護るから、$me$に任せて！"},
        { "location": "1333/TALK"  , "narrator": "月神楽", "text": "どうしてそんなに\n楽観的に\nなれるんですか？"},
        { "location": "1334/TALK"  , "narrator": "月神楽", "text": "ライフギャザーがある以上\n“彼ら”は私を\n付け狙うんですよ？"},
        { "location": "1335/TALK"  , "narrator": "月神楽", "text": "もし彼らがいなくなっても\nそれに代わる何かが\n私のところにやってくる。"},
        { "location": "1336/TALK"  , "narrator": "月神楽", "text": "そうじゃありませんか？"},
        { "location": "1337/TALK"  , "narrator": "月神楽", "text": "網膜認証の金庫を持てば\n目玉をくり抜かれ、"},
        { "location": "1338/TALK"  , "narrator": "月神楽", "text": "指紋認証の金庫を持てば\n指を切られるんです。"},
        { "location": "1339/TALK"  , "narrator": "月神楽", "text": "自分とは切っても\n切り離せないものに、\n世界中が注目してる。"},
        { "location": "1340/TALK"  , "narrator": "月神楽", "text": "果たして1年後…いえ、\n数ヶ月後に私は\n生きているでしょうか？"},
        { "location": "1341/TALK"  , "narrator": "月神楽", "text": "いえ、生きてますよね。\n脳の記憶野だけは絶対に\n死なせないでしょうから。"},
        { "location": "1342/TALK"  , "narrator": "月神楽", "text": "じゃあ、\nどうすればいい？"},
        { "location": "1343/TALK"  , "narrator": "月神楽", "text": "答えは簡単です。\n金庫の方を\n破壊すればいいんです。"},
        { "location": "1344/TALK"  , "narrator": "月神楽", "text": "価値がゼロになるまで\n破壊すれば、私の価値も\nゼロになりますから。"},
        { "location": "1345/SEL"   , "narrator": "", "text": "$me$が護ってやるから！"},
        { "location": "1346/SEL"   , "narrator": "", "text": "返す言葉もない。同情するよ"},
        { "location": "1347/ACT"   , "narrator": "", "text": "$me$が護ってやるから！"},
        { "location": "1348/TALK"  , "narrator": "月神楽", "text": "は？"},
        { "location": "1349/TALK"  , "narrator": "月神楽", "text": "どうやって？\n具体的に言ってみてよ。"},
        { "location": "1350/TALK"  , "narrator": "月神楽", "text": "硝子の向こうから？\nノックでもしてくれるの？"},
        { "location": "1351/TALK"  , "narrator": "月神楽", "text": "自分の立場\n弁えて言えよな。"},
        { "location": "1352/SEL"   , "narrator": "", "text": "ごめんなさい"},
        { "location": "1353/SEL"   , "narrator": "", "text": "キレそう"},
        { "location": "1354/ACT"   , "narrator": "", "text": "ごめんなさい"},
        { "location": "1355/TALK"  , "narrator": "月神楽", "text": "私は本気で今、\n命の危機を\n感じているんです。"},
        { "location": "1356/TALK"  , "narrator": "月神楽", "text": "だから、軽く\n言わないでください。"},
        { "location": "1357/TALK"  , "narrator": "月神楽", "text": "……でも、ごめんなさい。"},
        { "location": "1358/TALK"  , "narrator": "月神楽", "text": "ちょっと言い過ぎました。"},
        { "location": "1359/TALK"  , "narrator": "月神楽", "text": "貴方だって、私の力に\nなりたいって思って\nくれているんですよね。"},
        { "location": "1360/TALK"  , "narrator": "月神楽", "text": "私も出来ることなら\n貴方に守って欲しい。"},
        { "location": "1361/TALK"  , "narrator": "月神楽", "text": "それは、\nいつも思ってました。"},
        { "location": "1362/TALK"  , "narrator": "月神楽", "text": "いえ、むしろそれは\n思いよりも、願いに\n近いものでした。"},
        { "location": "1363/TALK"  , "narrator": "月神楽", "text": "けど、それは\n色んな意味で\n無理なんです。"},
        { "location": "1364/SEL"   , "narrator": "", "text": "異世界の住人だから？"},
        { "location": "1365/ACT"   , "narrator": "", "text": "異世界の住人だから？"},
        { "location": "1367/TALK"  , "narrator": "月神楽", "text": "もちろんそれも\nありますけど、仮にそれが\n解決出来たとしても――"},
        { "location": "1368/TALK"  , "narrator": "月神楽", "text": "貴方に護ってもらうことは\nできないんです。"},
        { "location": "1369/TALK"  , "narrator": "月神楽", "text": "本当に、どんな目に遭うか\nわからないんですよ？"},
        { "location": "1370/TALK"  , "narrator": "月神楽", "text": "そんな事に、\n貴方を巻き込めるわけが\nないじゃないですか。"},
        { "location": "1371/SEL"   , "narrator": "", "text": "月神楽は優しいね"},
        { "location": "1372/SEL"   , "narrator": "", "text": "失望した"},
        { "location": "1373/ACT"   , "narrator": "", "text": "月神楽は優しいね"},
        { "location": "1374/TALK"  , "narrator": "月神楽", "text": "だって、\n$handle$さんは\n私にとって大切な人です。"},
        { "location": "1375/TALK"  , "narrator": "月神楽", "text": "だから、私なんかに\n関わらずに、幸せに\n生きていて欲しい。"},
        { "location": "1376/TALK"  , "narrator": "月神楽", "text": "そう思うんです。"},
        { "location": "1377/ACT"   , "narrator": "", "text": "失望した"},
        { "location": "1378/TALK"  , "narrator": "月神楽", "text": "え？"},
        { "location": "1379/SEL"   , "narrator": "", "text": "あんたの$me$への気持ちなんて所詮そんなモノか"},
        { "location": "1380/ACT"   , "narrator": "", "text": "あんたの$me$への気持ちなんて所詮そんなモノか"},
        { "location": "1382/TALK"  , "narrator": "月神楽", "text": "な、何言ってるんですか！"},
        { "location": "1383/TALK"  , "narrator": "月神楽", "text": "大事だからこそ\nこんなに悩んでるのに！"},
        { "location": "1384/SEL"   , "narrator": "", "text": "お前、$me$が護ってやるって言ったときクソ呼ばわりしたよな"},
        { "location": "1385/ACT"   , "narrator": "", "text": "お前、$me$が護ってやるって言ったときクソ呼ばわりしたよな"},
        { "location": "1387/TALK"  , "narrator": "月神楽", "text": "…それが何ですか。"},
        { "location": "1388/SEL"   , "narrator": "", "text": "$me$は神楽が$me$よりも大事だから、本気で言ってるんだよ"},
        { "location": "1389/ACT"   , "narrator": "", "text": "$me$は神楽が$me$よりも大事だから、本気で言ってるんだよ"},
        { "location": "1391/SEL"   , "narrator": "", "text": "確かにどうやって助けるか解らないけど、それより護りたい想いが強いんだよ"},
        { "location": "1392/ACT"   , "narrator": "", "text": "確かにどうやって助けるか解らないけど、それより護りたい想いが強いんだよ"},
        { "location": "1394/SEL"   , "narrator": "", "text": "それじゃダメなの！？"},
        { "location": "1395/SEL"   , "narrator": "", "text": "それをクソ呼ばわりするなら、お前だってクソだよ！軽くなんてないんだよ！"},
        { "location": "1396/ACT"   , "narrator": "", "text": "それじゃダメなの！？"},
        { "location": "1398/TALK"  , "narrator": "月神楽", "text": "ダメなの！！"},
        { "location": "1399/TALK"  , "narrator": "月神楽", "text": "それじゃダメなの！！"},
        { "location": "1400/TALK"  , "narrator": "月神楽", "text": "貴方が私を想って\n言ってくれてるのなんて\n解ってるから！"},
        { "location": "1401/ACT"   , "narrator": "", "text": "それをクソ呼ばわりするなら、お前だってクソだよ！軽くなんてないんだよ！"},
        { "location": "1403/TALK"  , "narrator": "月神楽", "text": "……。"},
        { "location": "1404/TALK"  , "narrator": "月神楽", "text": "わかってるって……"},
        { "location": "1405/TALK"  , "narrator": "月神楽", "text": "そんなこと、\n解ってるんだよ！"},
        { "location": "1407/TALK"  , "narrator": "月神楽", "text": "だから、こんなに\n辛いんじゃない…っ！"},
        { "location": "1408/TALK"  , "narrator": "月神楽", "text": "……。"},
        { "location": "1409/TALK"  , "narrator": "月神楽", "text": "わかってるけど、\nもうこれは\n避けられない事なんです。"},
        { "location": "1410/TALK"  , "narrator": "月神楽", "text": "これ以外に、\n貴方と私が2人とも\n幸せになれる道は、"},
        { "location": "1411/TALK"  , "narrator": "月神楽", "text": "私には\n見つけられないから。"},
        { "location": "1413/ACT"   , "narrator": "", "text": "キレそう"},
        { "location": "1415/TALK"  , "narrator": "月神楽", "text": "いいですよ、\nキレてください。"},
        { "location": "1416/TALK"  , "narrator": "月神楽", "text": "私を\n“助けてやりたかった”\nんですよね。"},
        { "location": "1417/TALK"  , "narrator": "月神楽", "text": "でも、それを\n拒否られたから、\n自尊心傷つきました？"},
        { "location": "1418/SEL"   , "narrator": "", "text": "そういう事じゃないんだよ、なんで人の善意を仇で返すわけ！？"},
        { "location": "1419/SEL"   , "narrator": "", "text": "傷ついた！！"},
        { "location": "1420/ACT"   , "narrator": "", "text": "そういう事じゃないんだよ、なんで人の善意を仇で返すわけ！？"},
        { "location": "1422/TALK"  , "narrator": "月神楽", "text": "だから偽善なんですよ。"},
        { "location": "1423/ACT"   , "narrator": "", "text": "傷ついた！！"},
        { "location": "1425/TALK"  , "narrator": "月神楽", "text": "正直すぎ！！"},
        { "location": "1426/TALK"  , "narrator": "月神楽", "text": "そういう素直なところ、\n好きですよ？"},
        { "location": "1428/TALK"  , "narrator": "月神楽", "text": "でも、私と\n$handle$さんは…"},
        { "location": "1429/TALK"  , "narrator": "月神楽", "text": "あまり相性が良くないかも\nしれませんね。"},
        { "location": "1430/TALK"  , "narrator": "月神楽", "text": "お付き合いの初期には\nお互い気づかないかも\nしれませんが。"},
        { "location": "1431/TALK"  , "narrator": "月神楽", "text": "結婚して、ずっと\n一緒にいると、いずれ\nとても歪むと思います。"},
        { "location": "1432/TALK"  , "narrator": "月神楽", "text": "ですからきっと、\n他の方とお付き合いした\n方がいいと思います。"},
        { "location": "1433/SEL"   , "narrator": "", "text": "当然そのつもり"},
        { "location": "1434/SEL"   , "narrator": "", "text": "つき合ってみなくちゃわからないでしょ？"},
        { "location": "1435/ACT"   , "narrator": "", "text": "当然そのつもり"},
        { "location": "1436/TALK"  , "narrator": "月神楽", "text": "良かったです♪"},
        { "location": "1437/ACT"   , "narrator": "", "text": "つき合ってみなくちゃわからないでしょ？"},
        { "location": "1438/TALK"  , "narrator": "月神楽", "text": "まあ、もちろん\nそうなんですけど……。"},
        { "location": "1439/TALK"  , "narrator": "月神楽", "text": "私は、\n$me$の背中についてこい\n系の人って苦手なんで。"},
        { "location": "1440/TALK"  , "narrator": "月神楽", "text": "もしかすると、\nいつの間にか後ろから\n消えてるかもしれません。"},
        { "location": "1443/ACT"   , "narrator": "", "text": "返す言葉もない。同情するよ"},
        { "location": "1444/TALK"  , "narrator": "月神楽", "text": "…ありがとうございます。"},
        { "location": "1445/TALK"  , "narrator": "月神楽", "text": "それだけでも、\n幾分か救われます。"},
        { "location": "1447/TALK"  , "narrator": "月神楽", "text": "というわけで、\nライフギャザーを\n破壊しに行きます。"},
        { "location": "1448/SEL"   , "narrator": "", "text": "月神楽…"},
        { "location": "1449/ACT"   , "narrator": "", "text": "月神楽…"},
        { "location": "1452/TALK"  , "narrator": "ぴょんこ　", "text": "ちょっと\n待ったあああっ！"},
        { "location": "1454/TALK"  , "narrator": "月神楽", "text": "えっ！？"},
        { "location": "1455/SEL"   , "narrator": "", "text": "ぴょんこ！？"},
        { "location": "1456/ACT"   , "narrator": "", "text": "ぴょんこ！？"},
        { "location": "1467/TALK"  , "narrator": "ぴょんこ　", "text": "空気を読まず\n颯爽とぴょんこ参上\nですっ！！"},
        { "location": "1468/TALK"  , "narrator": "ぴょんこ　", "text": "月ちゃん！\nライフギャザーを\n壊すんですかっ！？"},
        { "location": "1469/TALK"  , "narrator": "月神楽", "text": "そ、それがなにか…？"},
        { "location": "1470/TALK"  , "narrator": "ぴょんこ　", "text": "例えオテント様から\n逃げられても！"},
        { "location": "1471/TALK"  , "narrator": "ぴょんこ　", "text": "ぴょんこの目が\n黒い限りはっ！"},
        { "location": "1472/TALK"  , "narrator": "ぴょんこ　", "text": "そんなこと\n許しませんよっ！！"},
        { "location": "1474/TALK"  , "narrator": "月神楽", "text": "チョキ。"},
        { "location": "1481/TALK"  , "narrator": "ぴょんこ　", "text": "ギャあああっ！\n目がああああ！\n目がああああああっ！"},
        { "location": "1482/SEL"   , "narrator": "", "text": "…つ、月？"},
        { "location": "1483/SEL"   , "narrator": "", "text": "…ぴょんこ……？"},
        { "location": "1484/ACT"   , "narrator": "", "text": "…つ、月？"},
        { "location": "1485/ACT"   , "narrator": "", "text": "…ぴょんこ……？"},
        { "location": "1487/TALK"  , "narrator": "ぴょんこ　", "text": "月ちゃんあんた、\n私の眼を潰す気ですかっ！"},
        { "location": "1488/TALK"  , "narrator": "月神楽", "text": "目が黒いうちはダメだと\n言うので。"},
        { "location": "1490/TALK"  , "narrator": "ぴょんこ　", "text": "だからって！\n今潰さなくてもっ！！"},
        { "location": "1492/TALK"  , "narrator": "月神楽", "text": "それくらい\n本気だって事です。"},
        { "location": "1494/TALK"  , "narrator": "ぴょんこ　", "text": "……。"},
        { "location": "1495/TALK"  , "narrator": "ぴょんこ　", "text": "わかりました。\n月ちゃんが本気なら、私も\n本気モードになります。"},
        { "location": "1498/TALK"  , "narrator": "ぴょんこ　", "text": "$handle$さんっ！"},
        { "location": "1499/SEL"   , "narrator": "", "text": "はい！？"},
        { "location": "1500/ACT"   , "narrator": "", "text": "はい！？"},
        { "location": "1502/TALK"  , "narrator": "ぴょんこ　", "text": "ぴょんこが\n月ちゃんを食い止めます。"},
        { "location": "1503/TALK"  , "narrator": "ぴょんこ　", "text": "そのうちに、\n鍵をゲットしてください！"},
        { "location": "1504/SEL"   , "narrator": "", "text": "わかった！"},
        { "location": "1505/SEL"   , "narrator": "", "text": "大丈夫！？"},
        { "location": "1506/ACT"   , "narrator": "", "text": "わかった！"},
        { "location": "1507/TALK"  , "narrator": "ぴょんこ　", "text": "ありがとうございますっ！"},
        { "location": "1508/ACT"   , "narrator": "", "text": "大丈夫！？"},
        { "location": "1509/TALK"  , "narrator": "ぴょんこ　", "text": "ぴょんこの心配は\n無用です！"},
        { "location": "1511/TALK"  , "narrator": "ぴょんこ　", "text": "それと、\n最後に１つ、お話を\n聞いていってください！"},
        { "location": "1512/SEL"   , "narrator": "", "text": "うん"},
        { "location": "1513/ACT"   , "narrator": "", "text": "うん"},
        { "location": "1515/TALK"  , "narrator": "ぴょんこ　", "text": "ぴょんこは、\n$handle$さんが\n大好きですっ！"},
        { "location": "1516/TALK"  , "narrator": "ぴょんこ　", "text": "月ちゃんも、\nこんなですけどっ！"},
        { "location": "1517/TALK"  , "narrator": "ぴょんこ　", "text": "内心別れたくなくて\n壊したくなくて、\n泣いてるの知ってるです！"},
        { "location": "1518/TALK"  , "narrator": "月神楽", "text": "いらんこと言うなっ！"},
        { "location": "1519/TALK"  , "narrator": "ぴょんこ　", "text": "すぐにガブちゃんが\n応援に来てくれるから\nここは大丈夫――"},
        { "location": "1520/TALK"  , "narrator": "ぴょんこ　", "text": "だと思いますっ！！"},
        { "location": "1521/SEL"   , "narrator": "", "text": "そういえば、ぴょんこ弱かったんだっけ…？"},
        { "location": "1522/SEL"   , "narrator": "", "text": "ぴょんこ、信じてるから！"},
        { "location": "1523/ACT"   , "narrator": "", "text": "そういえば、ぴょんこ弱かったんだっけ…？"},
        { "location": "1525/TALK"  , "narrator": "ぴょんこ　", "text": "前よりはっ！\n少しだけ強く\nなりましたっ！！"},
        { "location": "1527/TALK"  , "narrator": "ぴょんこ　", "text": "更に$handle$さんの\n為なら加算ボーナス\n100万っ！"},
        { "location": "1528/TALK"  , "narrator": "ぴょんこ　", "text": "だから平気ですっ！"},
        { "location": "1529/ACT"   , "narrator": "", "text": "ぴょんこ、信じてるから！"},
        { "location": "1530/TALK"  , "narrator": "ぴょんこ　", "text": "ありがとうございますっ！"},
        { "location": "1531/TALK"  , "narrator": "ぴょんこ　", "text": "$handle$さんに\n応援されれば、加算\nボーナス1000万ですっ！"},
        { "location": "1533/TALK"  , "narrator": "ぴょんこ　", "text": "最後に、ぴょんこから\n$handle$さんに\nプレゼントがありますっ！"},
        { "location": "1534/TALK"  , "narrator": "ぴょんこ　", "text": "ぴょんこ、さっき、\nミサミサの鍵を\nゲットしてきましたっ！"},
        { "location": "1535/TALK"  , "narrator": "ぴょんこ　", "text": "絶対に後で\n必要になりますから\n渡しておきますねっ！"},
