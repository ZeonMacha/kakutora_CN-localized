        "title": "らぶとーく 第28話",
        "sub_title": "もう無理だから"
    },
    "entry":
    [
        { "location": "2724/SCENARIO", "narrator": "", "text": "もう無理だから"},
        { "location": "2734/TALK"    , "narrator": "つばめ", "text": "神楽ちゃん……。"},
        { "location": "2735/TALK"    , "narrator": "つばめ", "text": "あれは本当に\n神楽ちゃんの\nお母さんなの…？"},
        { "location": "2736/TALK"    , "narrator": "つばめ", "text": "本当のお母さんが\nあんなことをするの？"},
        { "location": "2737/TALK"    , "narrator": "つばめ", "text": "…怖い………。\nなんで\nあんなこと……。"},
        { "location": "2738/TALK"    , "narrator": "つばめ", "text": "…わたしに\nできることは\nないのかな……。"},
        { "location": "2740/TALK"    , "narrator": "つばめ", "text": "神楽ちゃん……。"},
        { "location": "2752/TALK"    , "narrator": "神楽", "text": "……痛い……。"},
        { "location": "2753/TALK"    , "narrator": "神楽", "text": "切れたところ\n冷やさないと\n腫れちゃう…。"},
        { "location": "2754/TALK"    , "narrator": "神楽", "text": "……でも\nもうちょっと\nだけ……。"},
        { "location": "2755/SEL"     , "narrator": "", "text": "大丈夫？"},
        { "location": "2756/ACT"     , "narrator": "", "text": "大丈夫？"},
        { "location": "2765/TALK"    , "narrator": "神楽", "text": "そう見える？"},
        { "location": "2767/SEL"     , "narrator": "", "text": "ごめん"},
        { "location": "2768/SEL"     , "narrator": "", "text": "他になんて言っていいかわからなくて"},
        { "location": "2769/SEL"     , "narrator": "", "text": "できれば$me$が代わってあげたい"},
        { "location": "2770/ACT"     , "narrator": "", "text": "ごめん"},
        { "location": "2771/TALK"    , "narrator": "神楽", "text": "謝るくらいなら"},
        { "location": "2772/TALK"    , "narrator": "神楽", "text": "最初から言わないで"},
        { "location": "2773/ACT"     , "narrator": "", "text": "他になんて言っていいかわからなくて"},
        { "location": "2774/TALK"    , "narrator": "神楽", "text": "そうでしょうね"},
        { "location": "2775/TALK"    , "narrator": "神楽", "text": "自分じゃないですから"},
        { "location": "2776/ACT"     , "narrator": "", "text": "できれば$me$が代わってあげたい"},
        { "location": "2777/TALK"    , "narrator": "神楽", "text": "そんなのできるわけないのに"},
        { "location": "2778/TALK"    , "narrator": "神楽", "text": "なんでそんなこと言うの"},
        { "location": "2784/TALK"    , "narrator": "神楽", "text": "…つばめさんは\nもう帰って\nくれたかな…。"},
        { "location": "2785/TALK"    , "narrator": "神楽", "text": "帰り道\n迷ってないと\nいいけど…。"},
        { "location": "2786/TALK"    , "narrator": "神楽", "text": "…どうでもいいか…。"},
        { "location": "2787/SEL"     , "narrator": "", "text": "少し話せる？"},
        { "location": "2788/ACT"     , "narrator": "", "text": "少し話せる？"},
        { "location": "2797/TALK"    , "narrator": "神楽", "text": "ええ"},
        { "location": "2798/TALK"    , "narrator": "神楽", "text": "どうぞ"},
        { "location": "2800/SEL"     , "narrator": "", "text": "まず手当てをしよう"},
        { "location": "2801/SEL"     , "narrator": "", "text": "まだ痛いよね？"},
        { "location": "2802/SEL"     , "narrator": "", "text": "$me$にできることはないかな"},
        { "location": "2803/ACT"     , "narrator": "", "text": "まず手当てをしよう"},
        { "location": "2804/TALK"    , "narrator": "神楽", "text": "体が動いたらね"},
        { "location": "2805/ACT"     , "narrator": "", "text": "まだ痛いよね？"},
        { "location": "2806/TALK"    , "narrator": "神楽", "text": "笑えるくらい痛い"},
        { "location": "2807/ACT"     , "narrator": "", "text": "$me$にできることはないかな"},
        { "location": "2808/TALK"    , "narrator": "神楽", "text": "ないでしょ"},
        { "location": "2812/SEL"     , "narrator": "", "text": "泣いてもいいんだよ"},
        { "location": "2813/SEL"     , "narrator": "", "text": "お大事に"},
        { "location": "2814/SEL"     , "narrator": "", "text": "$me$がいるからね"},
        { "location": "2815/ACT"     , "narrator": "", "text": "泣いてもいいんだよ"},
        { "location": "2816/TALK"    , "narrator": "神楽", "text": "そんな気力もないです"},
        { "location": "2821/ACT"     , "narrator": "", "text": "お大事に"},
        { "location": "2822/TALK"    , "narrator": "神楽", "text": "そうしますね"},
        { "location": "2827/ACT"     , "narrator": "", "text": "$me$がいるからね"},
        { "location": "2830/TALK"    , "narrator": "神楽", "text": "ああ"},
        { "location": "2831/TALK"    , "narrator": "神楽", "text": "いますね"},
        { "location": "2832/TALK"    , "narrator": "神楽", "text": "いつもあなたは"},
        { "location": "2833/TALK"    , "narrator": "神楽", "text": "私のことを監視してるんですか？"},
        { "location": "2836/SEL"     , "narrator": "", "text": "そんなつもりは…"},
        { "location": "2837/SEL"     , "narrator": "", "text": "神楽が心配だからだよ"},
        { "location": "2838/SEL"     , "narrator": "", "text": "いちゃダメかな？"},
        { "location": "2839/ACT"     , "narrator": "", "text": "そんなつもりは…"},
        { "location": "2840/TALK"    , "narrator": "神楽", "text": "じゃあなんでいるんですか？"},
        { "location": "2841/ACT"     , "narrator": "", "text": "神楽が心配だからだよ"},
        { "location": "2842/TALK"    , "narrator": "神楽", "text": "心配とかよく言えたものですね"},
        { "location": "2843/ACT"     , "narrator": "", "text": "いちゃダメかな？"},
        { "location": "2846/TALK"    , "narrator": "神楽", "text": "いいとかダメとかそういうんじゃないです"},
        { "location": "2848/TALK"    , "narrator": "神楽", "text": "いる理由がわからないって言ってるんです"},
        { "location": "2849/TALK"    , "narrator": "神楽", "text": "いる必要なんてないじゃないですか"},
        { "location": "2851/SEL"     , "narrator": "", "text": "そんなことないって思いたい"},
        { "location": "2852/SEL"     , "narrator": "", "text": "神楽を好きだからじゃダメかな"},
        { "location": "2853/SEL"     , "narrator": "", "text": "心配するのはおかしいこと？"},
        { "location": "2854/ACT"     , "narrator": "", "text": "そんなことないって思いたい"},
        { "location": "2855/TALK"    , "narrator": "神楽", "text": "じゃあそう思っててください"},
        { "location": "2856/ACT"     , "narrator": "", "text": "神楽を好きだからじゃダメかな"},
        { "location": "2857/TALK"    , "narrator": "神楽", "text": "そんなの理由にならないですよ"},
        { "location": "2858/ACT"     , "narrator": "", "text": "心配するのはおかしいこと？"},
        { "location": "2859/TALK"    , "narrator": "神楽", "text": "おかしいです"},
        { "location": "2860/TALK"    , "narrator": "神楽", "text": "絶対におかしいです"},
        { "location": "2863/SEL"     , "narrator": "", "text": "自分をもっと大事にして"},
        { "location": "2864/SEL"     , "narrator": "", "text": "神楽がいい子なのは知ってるから"},
        { "location": "2865/SEL"     , "narrator": "", "text": "今日はもう休んで"},
        { "location": "2866/ACT"     , "narrator": "", "text": "自分をもっと大事にして"},
        { "location": "2867/ACT"     , "narrator": "", "text": "神楽がいい子なのは知ってるから"},
        { "location": "2868/ACT"     , "narrator": "", "text": "今日はもう休んで"},
        { "location": "2876/TALK"    , "narrator": "神楽", "text": "…何これ…。"},
        { "location": "2877/TALK"    , "narrator": "神楽", "text": "何なんだろうこれ…。"},
        { "location": "2733/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　7:23 PM</color>\nとある平日の夜、神楽の家付近でのこと"}
    ]
}
