{
    "dir": "chap36/daydra/dd_ch05_36_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "36505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "ソラノキヲク＜後編＞"
    },
    "entry":
    [
        { "location": "2837/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2838/TALK"  , "narrator": "神楽", "text": "結局、私にできる\nことは――"},
        { "location": "2839/TALK"  , "narrator": "神楽", "text": "歌うことしか\nなかった。"},
        { "location": "2840/TALK"  , "narrator": "神楽", "text": "だから、私はずっと\n歌い続けてきた…。"},
        { "location": "2841/TALK"  , "narrator": "神楽", "text": "イヤな現実を忘れて、\n綺麗なファンタジーを\n旅するために…。"},
        { "location": "2842/TALK"  , "narrator": "神楽", "text": "そうすることで、\n現実を忘れることが\nできたから。"},
        { "location": "2844/TALK"  , "narrator": "神楽", "text": "私が歌い続けてきた\nのは、現実逃避を\nするため…。"},
        { "location": "2845/TALK"  , "narrator": "神楽", "text": "だから、これは私の\n現実逃避のツケなの\nかもしれない。"},
        { "location": "2847/TALK"  , "narrator": "神楽", "text": "けれども、\nつばめさんは…。"},
        { "location": "2848/TALK"  , "narrator": "神楽", "text": "そんな私の歌を、\n好きになってくれた。"},
        { "location": "2849/TALK"  , "narrator": "神楽", "text": "そして、あの\nフェノメノンが…。"},
        { "location": "2850/TALK"  , "narrator": "神楽", "text": "平和で暖かくて、\n優しい世界が\n生まれた。"},
        { "location": "2851/TALK"  , "narrator": "神楽", "text": "こんな現実も\n存在するんだって、\n驚きと…。"},
        { "location": "2852/TALK"  , "narrator": "神楽", "text": "それを実際に\n作ってしまうん\nだから…。"},
        { "location": "2853/TALK"  , "narrator": "神楽", "text": "つばめさんって、\n本当にスゴい子\nなんだなぁ…。"},
        { "location": "2855/TALK"  , "narrator": "神楽", "text": "…つばめさん。"},
        { "location": "2856/TALK"  , "narrator": "神楽", "text": "私が思い描いた\n世界は、つばめさんが\n作ったような…。"},
        { "location": "2857/TALK"  , "narrator": "神楽", "text": "素敵な世界に、\nなるでしょうか？"},
        { "location": "2859/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "2860/TALK"  , "narrator": "神楽", "text": "ううん、\nきっと大丈夫。"},
        { "location": "2867/TALK"  , "narrator": "つばめ", "text": "なるよ。"},
        { "location": "2870/TALK"  , "narrator": "神楽", "text": "…えっ？"},
        { "location": "2876/TALK"  , "narrator": "つばめ", "text": "絶対、素敵な\n世界になるよ。"},
        { "location": "2878/TALK"  , "narrator": "神楽", "text": "…つばめさん？"},
        { "location": "2879/TALK"  , "narrator": "神楽", "text": "つばめさんッ！！\nどうしてここに！？"},
        { "location": "2881/TALK"  , "narrator": "つばめ", "text": "えへへ、わたしも\nよくわからないん\nだけど…。"},
        { "location": "2882/TALK"  , "narrator": "つばめ", "text": "なんか、ここに\n呼ばれた気が\nしたんだ。"},
        { "location": "2883/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2884/TALK"  , "narrator": "つばめ", "text": "ねえ、神楽ちゃん。"},
        { "location": "2885/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんの歌は、\nとっても素敵なもの\nなんだよ？"},
        { "location": "2888/TALK"  , "narrator": "神楽", "text": "そんな…私の歌は、\n自分が現実逃避を\nするためのもので…。"},
        { "location": "2889/TALK"  , "narrator": "つばめ", "text": "それは神楽ちゃんが\n気付いてないだけだよ。"},
        { "location": "2890/TALK"  , "narrator": "つばめ", "text": "だって、\n神楽ちゃんの歌は…。"},
        { "location": "2891/TALK"  , "narrator": "つばめ", "text": "私の命を、繋ぎ止める\n力があったんだから。"},
        { "location": "2892/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2893/TALK"  , "narrator": "つばめ", "text": "だから、この世界の\n命だって、絶対に\n繋げられるよ。"},
        { "location": "2895/TALK"  , "narrator": "神楽", "text": "つばめさん…。"},
        { "location": "2896/TALK"  , "narrator": "つばめ", "text": "わたしも、想うよ。\n世界の一員として。"},
        { "location": "2897/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんと、\n一緒にね。"},
        { "location": "2899/TALK"  , "narrator": "神楽", "text": "…ありがとう、\nつばめさん。"},
        { "location": "2901/TALK"  , "narrator": "神楽", "text": "私も、\n私の大好きな世界…。"},
        { "location": "2902/TALK"  , "narrator": "神楽", "text": "私の大好きな、\nつばめさんの\n世界を…。"},
        { "location": "2909/TALK"  , "narrator": "神楽", "text": "つばめさんを連れてきてくれたのは、$handlek$ですか？"},
        { "location": "2911/SEL"   , "narrator": "", "text": "違うよ。千羽鶴が、神楽の為にって"},
        { "location": "2912/ACT"   , "narrator": "", "text": "違うよ。千羽鶴が、神楽の為にって"},
        { "location": "2914/TALK"  , "narrator": "神楽", "text": "えっ"},
        { "location": "2915/TALK"  , "narrator": "神楽", "text": "どんな作戦ですか？"},
        { "location": "2917/SEL"   , "narrator": "", "text": "疑わないで。その千羽鶴は、神楽の知ってる千羽鶴とは少し違うから"},
        { "location": "2918/ACT"   , "narrator": "", "text": "疑わないで。その千羽鶴は、神楽の知ってる千羽鶴とは少し違うから"},
        { "location": "2920/SEL"   , "narrator": "", "text": "一度結末を経た、神楽に協力してくれる千羽鶴だから安心して"},
        { "location": "2921/ACT"   , "narrator": "", "text": "一度結末を経た、神楽に協力してくれる千羽鶴だから安心して"},
        { "location": "2923/TALK"  , "narrator": "神楽", "text": "わかりました。それじゃ、千羽鶴さんにも感謝ですね"},
        { "location": "2926/TALK"  , "narrator": "神楽", "text": "私、これから唄います"},
        { "location": "2927/TALK"  , "narrator": "神楽", "text": "発症しちゃうんですよね"},
        { "location": "2928/TALK"  , "narrator": "神楽", "text": "こんな冷静に発症について考えたのって、そういえば初めてかも"},
        { "location": "2929/TALK"  , "narrator": "神楽", "text": "けど、こんなに落ち着いて発症を受け入れられるのも、今回が初めてかも"},
        { "location": "2931/SEL"   , "narrator": "", "text": "そうなの？"},
        { "location": "2932/ACT"   , "narrator": "", "text": "そうなの？"},
        { "location": "2934/TALK"  , "narrator": "神楽", "text": "はい"},
        { "location": "2935/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "2936/TALK"  , "narrator": "神楽", "text": "理由はわかってるんです"},
        { "location": "2937/TALK"  , "narrator": "神楽", "text": "それは"},
        { "location": "2939/TALK"  , "narrator": "神楽", "text": "$handlek$が傍にいてくれるから"},
        { "location": "2941/SEL"   , "narrator": "", "text": "傍にいるから安心して"},
        { "location": "2942/SEL"   , "narrator": "", "text": "一時的とはいえ、身体が無くなって世界になっちゃうんだよ？大丈夫？"},
        { "location": "2943/ACT"   , "narrator": "", "text": "傍にいるから安心して"},
        { "location": "2944/TALK"  , "narrator": "神楽", "text": "はい♪"},
        { "location": "2945/TALK"  , "narrator": "神楽", "text": "なんだかちょっと不謹慎かもしれませんけど、実は私、少しワクワクしてたりします"},
        { "location": "2946/ACT"   , "narrator": "", "text": "一時的とはいえ、身体が無くなって世界になっちゃうんだよ？大丈夫？"},
        { "location": "2947/TALK"  , "narrator": "神楽", "text": "もちろん、怖くないと言えば嘘になっちゃいますけど"},
        { "location": "2948/TALK"  , "narrator": "神楽", "text": "でも実は、不思議なんですけど、怖さよりもワクワクの方が強いんです"},
        { "location": "2951/TALK"  , "narrator": "神楽", "text": "頭の中の妄想だけじゃない、本当に世界を生み出すってことがどういうことなのか"},
        { "location": "2952/TALK"  , "narrator": "神楽", "text": "変な話ですけど、すごくトキメキを感じちゃって"},
        { "location": "2953/TALK"  , "narrator": "神楽", "text": "変なのはわかってます"},
        { "location": "2954/TALK"  , "narrator": "神楽", "text": "けどやっぱり、私は世界を創るのが大好きみたい"},
        { "location": "2956/SEL"   , "narrator": "", "text": "頑張って！"},
        { "location": "2957/SEL"   , "narrator": "", "text": "気をつけて！"},
        { "location": "2958/ACT"   , "narrator": "", "text": "頑張って！"},
        { "location": "2959/TALK"  , "narrator": "神楽", "text": "もちろん頑張りますよっ！"},
        { "location": "2960/ACT"   , "narrator": "", "text": "気をつけて！"},
        { "location": "2961/TALK"  , "narrator": "神楽", "text": "大丈夫ですよっ！"},
        { "location": "2963/TALK"  , "narrator": "神楽", "text": "つばめさんの世界を、必ず復元してみせます"},
        { "location": "2964/TALK"  , "narrator": "神楽", "text": "だってその世界は"},
        { "location": "2965/TALK"  , "narrator": "神楽", "text": "つばめさんが大事に育んできた世界で"},
        { "location": "2966/TALK"  , "narrator": "神楽", "text": "同時に"},
        { "location": "2967/TALK"  , "narrator": "神楽", "text": "$handlek$との思い出が詰まった世界なんですから"},
        { "location": "2968/TALK"  , "narrator": "神楽", "text": "貴方と一緒に紡いできた世界を、貴方と一緒に残したい"},
        { "location": "2971/TALK"  , "narrator": "神楽", "text": "ありがとう"},
        { "location": "2973/TALK"  , "narrator": "神楽", "text": "だいすきです"},
        { "location": "2986/TALK"  , "narrator": "神楽", "text": "ありがとう、\nつばめさん。"},
        { "location": "2987/TALK"  , "narrator": "神楽", "text": "ありがとう、\n素敵な思い出をくれた\nフェノメノンの日本。"},
        { "location": "2988/TALK"  , "narrator": "神楽", "text": "そして、ありがとう。\n$handlek$……。"},
        { "location": "2989/TALK"  , "narrator": "神楽", "text": "みんなの想いで創られた\nこの素敵な世界を\n取り戻す為に。"},
        { "location": "2990/TALK"  , "narrator": "神楽", "text": "ずっと支えてくれた\n$handlek$への\n恩に報いるためにも。"},
        { "location": "2994/TALK"  , "narrator": "神楽", "text": "私はこれから、\n歌になります――"},
        { "location": "3002/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "3005/TALK"  , "narrator": "神楽", "text": "……ダメだ。\n全然気分が\n高揚してこない。"},
        { "location": "3006/TALK"  , "narrator": "神楽", "text": "想いが\n足りないのかしら。"},
        { "location": "3007/TALK"  , "narrator": "神楽", "text": "それとも、\nやっぱり発症を\n恐れている？"},
        { "location": "3008/TALK"  , "narrator": "神楽", "text": "だから、\n無意識に力をセーブ\nしているのかも。"},
        { "location": "3011/TALK"  , "narrator": "神楽", "text": "はぁ…っ。"},
        { "location": "3015/TALK"  , "narrator": "つばめ", "text": "神楽ちゃん、\nどうしたの！？"},
        { "location": "3016/TALK"  , "narrator": "つばめ", "text": "具合、\n悪くなっちゃったの？"},
        { "location": "3018/TALK"  , "narrator": "神楽", "text": "つばめさん……。\nごめんなさい。"},
        { "location": "3019/TALK"  , "narrator": "神楽", "text": "私ではやはり、\nつばめさんの代わりには\nなれません。"},
        { "location": "3020/TALK"  , "narrator": "つばめ", "text": "そんなことないよ！\n神楽ちゃんの力は\n本当に凄いんだよ？"},
        { "location": "3021/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんがいたから、\nメノウちゃんがいたから\n今のわたしがある。"},
        { "location": "3022/TALK"  , "narrator": "つばめ", "text": "だから――"},
        { "location": "3030/TALK"  , "narrator": "千羽鶴", "text": "どうして発症ボタンを\n押さないの？"},
        { "location": "3031/SEL"   , "narrator": "", "text": "千羽鶴！？なんで！？"},
        { "location": "3032/ACT"   , "narrator": "", "text": "千羽鶴！？なんで！？"},
        { "location": "3034/TALK"  , "narrator": "千羽鶴", "text": "エリカを通じて\n言ったとおり、\n私は――"},
        { "location": "3035/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめと共に、\n卯月神楽を応援しに来た。"},
        { "location": "3036/TALK"  , "narrator": "千羽鶴", "text": "それが私の\n願いでもあるから。"},
        { "location": "3037/TALK"  , "narrator": "千羽鶴", "text": "ただ、貴方がそれとは\n違う選択をするのなら\n私はそれを受け入れる。"},
        { "location": "3038/TALK"  , "narrator": "千羽鶴", "text": "貴方にとっての\n理由を教えてくれれば。"},
        { "location": "3039/SEL"   , "narrator": "", "text": "神楽を発症させたくない"},
        { "location": "3040/SEL"   , "narrator": "", "text": "日本はもう一度、この荒廃した世界から自力で這い上がるべきなんだよ"},
        { "location": "3041/SEL"   , "narrator": "", "text": "ライフギャザー自体、もう捨てるべきだ"},
        { "location": "3042/ACT"   , "narrator": "", "text": "神楽を発症させたくない"},
        { "location": "3044/TALK"  , "narrator": "千羽鶴", "text": "エリカからも\n話は伝わってるはず。"},
        { "location": "3045/TALK"  , "narrator": "千羽鶴", "text": "彼女が世界になるのは\nほぼ一瞬。"},
        { "location": "3046/TALK"  , "narrator": "千羽鶴", "text": "その後、エリカが\n2E113へのコピーを行い\n世界は収束する。"},
        { "location": "3047/TALK"  , "narrator": "千羽鶴", "text": "もちろん、その収束権限を\n持っているのは、\n貴方だけであって。"},
        { "location": "3048/TALK"  , "narrator": "千羽鶴", "text": "もし卯月神楽が戻らない\n場合、それは貴方が解除\n命令を出さない場合のみ。"},
        { "location": "3049/TALK"  , "narrator": "千羽鶴", "text": "貴方のココロの内に\n自身ですら制御不能な\n悪魔がいない限りは――"},
        { "location": "3050/TALK"  , "narrator": "千羽鶴", "text": "今現在において、\n彼女の収束を阻む者は\n存在しない。"},
        { "location": "3051/TALK"  , "narrator": "千羽鶴", "text": "それでもなお、\nいやなの？"},
        { "location": "3052/SEL"   , "narrator": "", "text": "例え一秒たりとも、神楽を発症させたくはない"},
        { "location": "3053/SEL"   , "narrator": "", "text": "そこまで言うなら、信じてもいい"},
        { "location": "3054/ACT"   , "narrator": "", "text": "例え一秒たりとも、神楽を発症させたくはない"},
        { "location": "3055/TALK"  , "narrator": "千羽鶴", "text": "わかった。\nならば貴方に従う。"},
        { "location": "3056/TALK"  , "narrator": "千羽鶴", "text": "けれども――"},
        { "location": "3057/TALK"  , "narrator": "千羽鶴", "text": "それはもしかすると、\n卯月神楽の願望とは\n乖離しているかもしれない"},
        { "location": "3058/TALK"  , "narrator": "千羽鶴", "text": "その事だけは、\n頭の片隅に\nおいておくといい。"},
        { "location": "3059/ACT"   , "narrator": "", "text": "そこまで言うなら、信じてもいい"},
        { "location": "3060/TALK"  , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "3061/TALK"  , "narrator": "千羽鶴", "text": "ならば、一度コンソールに\n戻り、発症処理を\n実行してきてほしい。"},
        { "location": "3062/TALK"  , "narrator": "千羽鶴", "text": "どうかよろしく。"},
        { "location": "3064/ACT"   , "narrator": "", "text": "日本はもう一度、この荒廃した世界から自力で這い上がるべきなんだよ"},
        { "location": "3066/TALK"  , "narrator": "千羽鶴", "text": "なるほど。\n確かにそういう\n意見もある。"},
        { "location": "3067/TALK"  , "narrator": "千羽鶴", "text": "ならば、ここで貴方は\n何もする必要はない。"},
        { "location": "3068/TALK"  , "narrator": "千羽鶴", "text": "貴方はあと、ライフ\nギャザーをどうするか、\nそれだけを考えて欲しい。"},
        { "location": "3069/TALK"  , "narrator": "千羽鶴", "text": "私の希望とは違うけど、\n貴方なら決して悪いよう\nにはしないと思うから。"},
        { "location": "3070/TALK"  , "narrator": "千羽鶴", "text": "どうかよろしく。"},
        { "location": "3071/ACT"   , "narrator": "", "text": "ライフギャザー自体、もう捨てるべきだ"},
        { "location": "3073/TALK"  , "narrator": "千羽鶴", "text": "なるほど。\n確かにそういう\n意見もある。"},
        { "location": "3074/TALK"  , "narrator": "千羽鶴", "text": "ならば、ここで貴方は\n何もする必要はない。"},
        { "location": "3075/TALK"  , "narrator": "千羽鶴", "text": "貴方はソイルトンに頼み、"},
        { "location": "3076/TALK"  , "narrator": "千羽鶴", "text": "ライフギャザーを\n完全に潰す術を\n教えてもらうといい。"},
        { "location": "3077/TALK"  , "narrator": "千羽鶴", "text": "私の希望とは違うけど、\n貴方なら決して悪いよう\nにはしないと思うから。"},
        { "location": "3078/TALK"  , "narrator": "千羽鶴", "text": "ただその場合、いずれ\n貴方とは永遠の別れに\nなってしまうから――"},
        { "location": "3079/TALK"  , "narrator": "千羽鶴", "text": "今までのお礼と、\nお別れの挨拶だけは\n今しておこうと思う。"},
        { "location": "3080/TALK"  , "narrator": "千羽鶴", "text": "今まで本当にありがとう。\n心の底から感謝してる。"},
        { "location": "3081/TALK"  , "narrator": "千羽鶴", "text": "貴方と近い将来、\n会えなくなるのは\n本当に寂しいけど――"},
        { "location": "3082/TALK"  , "narrator": "千羽鶴", "text": "貴方がずっと貴方の世界で\n元気に生きていけることを\n願っている。"},
        { "location": "3083/TALK"  , "narrator": "千羽鶴", "text": "もし、貴方の世界で、\n貴方の世界がおかしくなる\n予兆を見つけた時は、"},
        { "location": "3084/TALK"  , "narrator": "千羽鶴", "text": "どうか、この世界のことを\n思い出して。"},
        { "location": "3085/TALK"  , "narrator": "千羽鶴", "text": "そして、貴方に出来る事を\nちゃんと考えてみて。"},
        { "location": "3086/TALK"  , "narrator": "千羽鶴", "text": "どんな事でもいい。\n世界に影響を及ぼす\nことでも――"},
        { "location": "3087/TALK"  , "narrator": "千羽鶴", "text": "大事な人を護る、\nただそれだけの事でも。"},
        { "location": "3088/TALK"  , "narrator": "千羽鶴", "text": "ただ１つだけ。\n貴方が後悔しないように。"},
        { "location": "3089/TALK"  , "narrator": "千羽鶴", "text": "それだけを大切に、\n良く考えて、貴方の方法で\n行動して欲しい。"},
        { "location": "3090/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\n今回はこれで。"},
        { "location": "3091/TALK"  , "narrator": "千羽鶴", "text": "貴方と貴方の世界に\n素敵なココロの旅を。"},
        { "location": "3123/TALK"  , "narrator": "アースタシア", "text": "発症ご協力\nありがとうございます！"},
        { "location": "3124/TALK"  , "narrator": "アースタシア", "text": "お陰で私は\n世界を創造することが\n出来るようになりました。"},
        { "location": "3125/TALK"  , "narrator": "アースタシア", "text": "ただ、やはり\n恐れていた問題が\n発生してしまいました。"},
        { "location": "3126/SEL"   , "narrator": "", "text": "なに！？"},
        { "location": "3127/ACT"   , "narrator": "", "text": "なに！？"},
        { "location": "3129/TALK"  , "narrator": "アースタシア", "text": "いくら創造の力が\n強くても、所詮私は\n凡人だということ。"},
        { "location": "3130/TALK"  , "narrator": "アースタシア", "text": "つばめさんのように、\n並外れた出力を持つ事は\nできないのです。"},
        { "location": "3131/TALK"  , "narrator": "アースタシア", "text": "その為、つばめさんと\n同じフェノメノンを、\n一人では為し得ません。"},
        { "location": "3132/TALK"  , "narrator": "アースタシア", "text": "それと――"},
        { "location": "3133/TALK"  , "narrator": "アースタシア", "text": "やはり、もとの世界を\n創るには、皆さんの\n思い出は重要です。"},
        { "location": "3134/SEL"   , "narrator": "", "text": "どうすれば？"},
        { "location": "3135/SEL"   , "narrator": "", "text": "じゃあ、やっぱりやめようよ"},
        { "location": "3136/ACT"   , "narrator": "", "text": "どうすれば？"},
        { "location": "3137/TALK"  , "narrator": "アースタシア", "text": "2x接続による\n力と想いの補填です。"},
        { "location": "3138/TALK"  , "narrator": "アースタシア", "text": "以前、千羽鶴がその力を\n失ってしまったときに、"},
        { "location": "3139/TALK"  , "narrator": "アースタシア", "text": "同じような事をしたと、\n聞いています。"},
        { "location": "3140/TALK"  , "narrator": "アースタシア", "text": "他のトライガジェット\n所持者とココロを繋ぎ、\n１つの力にすること。"},
        { "location": "3141/SEL"   , "narrator": "", "text": "確かにリプレイス前にやってる"},
        { "location": "3142/ACT"   , "narrator": "", "text": "確かにリプレイス前にやってる"},
        { "location": "3144/TALK"  , "narrator": "アースタシア", "text": "やはりそうなんですね。"},
        { "location": "3145/TALK"  , "narrator": "アースタシア", "text": "ただし、その時とは少し\n状況が違います。"},
        { "location": "3146/TALK"  , "narrator": "アースタシア", "text": "千羽鶴の時は、既に発症\n済みの千羽鶴に、2x接続を\n新たに施す形だったと。"},
        { "location": "3147/TALK"  , "narrator": "アースタシア", "text": "ですが今回は、彼女たち\nとの既に2x接続自体は\n既に完了していて――"},
        { "location": "3148/TALK"  , "narrator": "アースタシア", "text": "逆に、私自身がまだ\n発症出来ていないという\n状況です。"},
        { "location": "3149/TALK"  , "narrator": "アースタシア", "text": "すなわち、今回必要な\n処理は、発症する為の力の\n供給という事になります。"},
        { "location": "3150/TALK"  , "narrator": "アースタシア", "text": "具体的に言えば――"},
        { "location": "3151/SEL"   , "narrator": "", "text": "つばめたちを発症させなければならない、ということ？"},
        { "location": "3152/ACT"   , "narrator": "", "text": "つばめたちを発症させなければならない、ということ？"},
        { "location": "3154/TALK"  , "narrator": "アースタシア", "text": "その通りです。"},
        { "location": "3155/TALK"  , "narrator": "アースタシア", "text": "恐らくは、卯月神楽以外に\n最低3名の協力が\n必要になってきます。"},
        { "location": "3156/TALK"  , "narrator": "アースタシア", "text": "そして今回、貴方は初めて\n発症のアシストと決定を\nするという事になります。"},
        { "location": "3157/SEL"   , "narrator": "", "text": "前回の千羽鶴の時にも、$me$がみんなに発症の是非を問うたりしてたよ？"},
        { "location": "3158/ACT"   , "narrator": "", "text": "前回の千羽鶴の時にも、$me$がみんなに発症の是非を問うたりしてたよ？"},
        { "location": "3160/TALK"  , "narrator": "アースタシア", "text": "そうですね。\nですがそれは、実際の\nアシストとは違います。"},
        { "location": "3161/TALK"  , "narrator": "アースタシア", "text": "前回は恐らく、千羽鶴が\nアシスト、すなわち\n具体的な処理をしており―"},
        { "location": "3162/TALK"  , "narrator": "アースタシア", "text": "発症の是非についても、\n彼女たちのセルフが\n決めていたと思います。"},
        { "location": "3163/TALK"  , "narrator": "アースタシア", "text": "ですが、今回はそれらを、\n全部貴方が\nやることになります。"},
        { "location": "3164/TALK"  , "narrator": "アースタシア", "text": "彼女たちの希望を聞き、\nそして発症ボタンを押す。"},
        { "location": "3165/TALK"  , "narrator": "アースタシア", "text": "前回、千羽鶴が彼女たちに\nしてきたことです。"},
        { "location": "3166/TALK"  , "narrator": "アースタシア", "text": "もちろん、発症ボタンを\n押すのは貴方ですから――"},
        { "location": "3167/TALK"  , "narrator": "アースタシア", "text": "彼女たちの意志は\n必ずしも聞く必要は\nありませんが。"},
        { "location": "3168/TALK"  , "narrator": "アースタシア", "text": "それも含めて、貴方は\nそれを単身で決めるだけの\n力を持っているのです。"},
        { "location": "3169/SEL"   , "narrator": "", "text": "すごい！"},
        { "location": "3170/SEL"   , "narrator": "", "text": "怖い！"},
        { "location": "3171/ACT"   , "narrator": "", "text": "すごい！"},
        { "location": "3172/TALK"  , "narrator": "アースタシア", "text": "はい。\nとてつもなく\n凄いことです。"},
        { "location": "3173/TALK"  , "narrator": "アースタシア", "text": "そして、とてつもなく\n幸せなことでもあります。"},
        { "location": "3174/TALK"  , "narrator": "アースタシア", "text": "それはすなわち、\n世界になるということ。"},
        { "location": "3175/TALK"  , "narrator": "アースタシア", "text": "貴方は今、彼女たちの\n世界になっているのです。"},
        { "location": "3176/TALK"  , "narrator": "アースタシア", "text": "彼女たちの一番近くにいて\n彼女たちの幸せを一番\n実現できる存在なのです。"},
        { "location": "3177/TALK"  , "narrator": "アースタシア", "text": "卯月神楽や、\n貴方の大切な彼女を\nよろしくお願いします。"},
        { "location": "3178/ACT"   , "narrator": "", "text": "怖い！"},
        { "location": "3179/TALK"  , "narrator": "アースタシア", "text": "科学や文明とは、\n往々にして不公平です。"},
        { "location": "3180/TALK"  , "narrator": "アースタシア", "text": "それは意図せずして、\n特定の誰かに余りある力を\n授けてしまいます。"},
        { "location": "3181/TALK"  , "narrator": "アースタシア", "text": "ですが、私は\nそれも含めて世界という\n意志の選択だと思います。"},
        { "location": "3182/TALK"  , "narrator": "アースタシア", "text": "運命の歯車は\n逆回転を始めました。"},
        { "location": "3183/TALK"  , "narrator": "アースタシア", "text": "TRI-OSとして君臨して\nいた管理者千羽鶴は今、\n停止により手を出せず。"},
        { "location": "3184/TALK"  , "narrator": "アースタシア", "text": "今、この世界を\n具体的に動かす権限を\n持つのは貴方だけです。"},
        { "location": "3185/TALK"  , "narrator": "アースタシア", "text": "今、貴方が望む望まざるに\n関係無く、世界は貴方に\n世界を委ねたのです。"},
        { "location": "3186/TALK"  , "narrator": "アースタシア", "text": "私の希望は全て\nお伝えしました。"},
        { "location": "3187/TALK"  , "narrator": "アースタシア", "text": "後は、\n貴方がどうしたいか。"},
        { "location": "3188/TALK"  , "narrator": "アースタシア", "text": "それだけなのです。"},
        { "location": "3189/TALK"  , "narrator": "アースタシア", "text": "どうかこの世界を\nよろしくお願いします。"},
        { "location": "3205/ACT"   , "narrator": "", "text": "じゃあ、やっぱりやめようよ"},
        { "location": "3206/TALK"  , "narrator": "アースタシア", "text": "…そうですか。"},
        { "location": "3207/TALK"  , "narrator": "アースタシア", "text": "それも一つの\n方法かもしれませんね。"},
        { "location": "3208/TALK"  , "narrator": "アースタシア", "text": "ライフギャザー自体を\n破棄するというのも、"},
        { "location": "3209/TALK"  , "narrator": "アースタシア", "text": "生かしつつも、\n日本を包むフェノメノンの\n再生は行わないのも。"},
        { "location": "3210/TALK"  , "narrator": "アースタシア", "text": "その延長線上には\nそれぞれの道が\n延びています。"},
        { "location": "3211/TALK"  , "narrator": "アースタシア", "text": "ただそれだけの事です。"},
        { "location": "3212/TALK"  , "narrator": "アースタシア", "text": "貴方がそれを、\n俯瞰的に見つめ、選択して\nいるのなら――"},
        { "location": "3213/TALK"  , "narrator": "アースタシア", "text": "私はそれを\n受け入れるのみです。"},
        { "location": "3214/TALK"  , "narrator": "アースタシア", "text": "今のこの世界にとっては、\n貴方こそがその未来を\n創る神なのですから。"},
        { "location": "3216/TALK"  , "narrator": "アースタシア", "text": "どうか、この世界を\nよろしくお願いします。"},
        { "location": "3099/DIALOG", "narrator": "Event/Dialog_Develop4", "text": "<color=red><size=32>KAGURA ICHINOMIYA (F)\nフェノメノンの展開が\n開始されました。\n<size=26>(DEVELOPING STARTED!)</size>\n</size></color><color=blue>\nOWNER：$handle$\nDEVELOPER：EARTHTASIA\nCRITICAL_ENERGY：<size=50>$ce100$%</size>\n</color>\nフェノメノンの展開が行われています。以降、フェノメノンの処理に於いてはKAGURA_ICHINOMIYAのピネアルに委託される為、安全のため外部より中断することはできません。\n\n一定時間内に発症強度（CRITICAL_ENERGY）が100％に達しない場合、システムは展開を強制終了します。その際には一定の精神保護を施した上で、精神の原状回復に努めます。"},
        { "location": "3193/DIALOG", "narrator": "Event/Dialog_Develop5", "text": "<color=red><size=32>DEVELOPER DAEMON\nをアクティブにします。</size>\n</color><color=blue>\nTARGET:\nCH01,CH02,CH03,CH04\n\nSUMMARY:\n発症用コンソールの表示と\n実行処理スクリプトを稼働させます。\n</color>\n当処理は【処理権限SX】において行われます。よって【処理権限SX】による明示的な解除があるまでは、より低レベルな運用者による変更はできなくなります。\n\n<color=green>e88bbae381aee3839fe383abe38395e382a3e383bce383a6\n</color>\n\n<color=red>コンソールを表示する場合は\n「実行する」ボタンを押して下さい。\n</color>"},
        { "location": "3200/DIALOG", "narrator": "Event/Dialog_Develop4", "text": "<color=blue><size=32>DEVELOPER DAEMON\nが正常稼働開始。</size>\n</color><color=blue>\nTARGET:\nCH01,CH02,CH03,CH04\n</color>\n当処理は【処理権限SX】において行われています。よって【処理権限SX】による明示的な解除があるまでは、より低レベルな運用者による変更はできません。\n\n<color=green>e88bbae381aee3839fe383abe38395e382a3e383bce383a6\n</color>\n"},
        { "location": "3227/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【30 綾水たちの沈黙】"},
        { "location": "3239/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【30 綾水たちの沈黙】"}
    ]
}
