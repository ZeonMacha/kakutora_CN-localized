{
    "dir": "chap08/battle/btev_ch04_08_00.js",
    "type": "",
    "info": {
        "story_id": "24013",
        "cid": "",
        "title": "013 ココロスフィアストーリー【Lv05】",
        "sub_title": "巧妙な罠＜提起＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "巧妙な罠"},
        { "location": "14/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 05</size>\nMIYABI - KOIGASAKI\n\n<size=45>巧妙な罠</size>\n<size=35>～濡れ衣をかけた少女～</size>"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "ち、違います！\nわたしじゃないです！"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "ウソつかないでよ。\nあんた以外に\nいないでしょ？"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "あたし達がいた時は、\n確かに売店に置いて\nあったのに――"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "あんたが店番した\n後でなくなったのよ？"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "で、でも…本当に\nわたしじゃないし…。"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "つばめ、私たちは\n怒ってるわけじゃ\nないのよ？"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "正直に出してくれれば\nそれで話はおしまい。"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "今日のことは\nなかったことに\nするから…。"},
        { "location": "39/TALK"   , "narrator": "神楽", "text": "そうですよ。"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "それに、誰にだって\nつい魔が差しちゃう\nことはあります。"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "そ、そんな…。"},
        { "location": "56/TALK"   , "narrator": "潜在みやび", "text": "…みやびさん、\n事件です。"},
        { "location": "59/TALK"   , "narrator": "表層みやび", "text": "うむ、事件なうやな。"},
        { "location": "62/TALK"   , "narrator": "潜在みやび", "text": "容疑者逢瀬つばめは、\n容疑を否認している\n模様。"},
        { "location": "64/TALK"   , "narrator": "表層みやび", "text": "素直に罪を認める\n犯人ばかりやない\nがよ。"},
        { "location": "65/SEL"    , "narrator": "（選択肢）", "text": "一体、何があったの？"},
        { "location": "66/ACT"    , "narrator": "", "text": "一体、何があったの？"},
        { "location": "72/TALK"   , "narrator": "表層みやび", "text": "中での話聞けば、\n大体わかるやろ？"},
        { "location": "73/TALK"   , "narrator": "表層みやび", "text": "劇場の売店で\n盗難があったがよ。"},
        { "location": "74/TALK"   , "narrator": "潜在みやび", "text": "売店に、忘れ物の\n財布が置いてあったん\nやけんど――"},
        { "location": "75/TALK"   , "narrator": "潜在みやび", "text": "それがいつの間にか、\n綺麗さっぱり消えて\nしもうたがよ。"},
        { "location": "76/TALK"   , "narrator": "表層みやび", "text": "いつの間にっちゅうか\nつばめちゃんが店番\nしちゅう間にな。"},
        { "location": "78/TALK"   , "narrator": "表層みやび", "text": "その間に来たお客の\n人数は…、\nさあ、何人！？"},
        { "location": "79/SEL"    , "narrator": "（選択肢）", "text": "ゼロじゃない？"},
        { "location": "80/ACT"    , "narrator": "", "text": "ゼロじゃない？"},
        { "location": "83/TALK"   , "narrator": "潜在みやび", "text": "正解や。\n…$handle$は\n頭がえいな。"},
        { "location": "85/TALK"   , "narrator": "表層みやび", "text": "当然やろ、うち。\n$handle$を舐めたら\nいかんぞ、うち。"},
        { "location": "88/TALK"   , "narrator": "潜在みやび", "text": "しっかし…、\nつばめちゃんが\n盗難なぁ…。"},
        { "location": "91/TALK"   , "narrator": "潜在みやび", "text": "はい、みやび先生。\n質問ちや。"},
        { "location": "92/TALK"   , "narrator": "表層みやび", "text": "ほい、なんやうち？"},
        { "location": "93/TALK"   , "narrator": "潜在みやび", "text": "つばめちゃん、\n盗みなんぞする子に\n思えんのやけんど…。"},
        { "location": "96/TALK"   , "narrator": "表層みやび", "text": "あ～、いかんいかん。\nそれはいかんぞね。"},
        { "location": "99/TALK"   , "narrator": "表層みやび", "text": "うちはつばめちゃんの\nこと、どれくらい\n知っちょるが？"},
        { "location": "100/TALK"  , "narrator": "潜在みやび", "text": "ほぼ知らんに等しい。\n謎の存在や。"},
        { "location": "101/TALK"  , "narrator": "表層みやび", "text": "なら、わかるやろ？\nやらんと決めつける\n根拠はどこにもない。"},
        { "location": "102/TALK"  , "narrator": "表層みやび", "text": "疑わしければ、\n責められるのは\n仕方ないがよ。"},
        { "location": "105/TALK"  , "narrator": "潜在みやび", "text": "…責められる、\nちゅうてもなぁ…。"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "ほ、本当なんです。\nお財布なんて\n盗んでないです…。"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "じゃあどうして\nなくなったのよ？"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "財布に足が生えて\n一人で逃げ出した\nとでも言うの？"},
        { "location": "131/TALK"  , "narrator": "つばめ", "text": "ち、違うよ！\nでも、他の人が\n持ってったのかも…。"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "…何それ？\nあたし達を泥棒扱い\nするわけ？"},
        { "location": "135/TALK"  , "narrator": "神楽", "text": "そんな…つばめさん、\n酷いです…。"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "そ、そういうこと\nじゃなくて…。"},
        { "location": "137/TALK"  , "narrator": "つばめ", "text": "アーヤさん、\n信じてください。\nわたし、本当に…。"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "154/TALK"  , "narrator": "潜在みやび", "text": "…………。"},
        { "location": "155/TALK"  , "narrator": "表層みやび", "text": "…………。"},
        { "location": "158/TALK"  , "narrator": "潜在みやび", "text": "先生、うち、何だか\n気分悪いちや。"},
        { "location": "160/TALK"  , "narrator": "表層みやび", "text": "…まあ、確かに\nそうやな。"},
        { "location": "163/TALK"  , "narrator": "表層みやび", "text": "けんど、どう考えても\n一番疑わしいのは\nつばめちゃんや。"},
        { "location": "165/TALK"  , "narrator": "潜在みやび", "text": "異議あり！\n証拠が無いちや！"},
        { "location": "166/TALK"  , "narrator": "表層みやび", "text": "状況証拠的には、\nつばめちゃんが\n犯人としか思えん。"},
        { "location": "167/TALK"  , "narrator": "表層みやび", "text": "それだけでも、\nとりあえず疑う\n理由としては十分や。"},
        { "location": "168/SEL"   , "narrator": "（選択肢）", "text": "疑わしきは罰せよ、ってこと？"},
        { "location": "169/ACT"   , "narrator": "", "text": "疑わしきは罰せよ、ってこと？"},
        { "location": "172/TALK"  , "narrator": "表層みやび", "text": "そこまでは言うて\nないけんど…。"},
        { "location": "175/TALK"  , "narrator": "潜在みやび", "text": "…………。"},
        { "location": "178/TALK"  , "narrator": "潜在みやび", "text": "まあ、みんなも\nちくっと熱が上がっ\nちょるき――"},
        { "location": "180/TALK"  , "narrator": "潜在みやび", "text": "頭冷やすよう\n言うた方がえいかも\nしれんな。"},
        { "location": "181/TALK"  , "narrator": "表層みやび", "text": "…………。"},
        { "location": "182/TALK"  , "narrator": "表層みやび", "text": "けんど、あの子には\nスパイ容疑もある\nちや。"},
        { "location": "183/TALK"  , "narrator": "表層みやび", "text": "色んなところで\n疑わしい点がある\nあの子を――"},
        { "location": "185/TALK"  , "narrator": "表層みやび", "text": "証拠もなしに庇う\nっちゅうのは、\nどうもな…。"},
        { "location": "186/TALK"  , "narrator": "潜在みやび", "text": "気が乗らんか？"},
        { "location": "188/TALK"  , "narrator": "表層みやび", "text": "…………。"},
        { "location": "189/TALK"  , "narrator": "潜在みやび", "text": "そうか…。\nよし、わかった。"},
        { "location": "192/TALK"  , "narrator": "潜在みやび", "text": "おい、$handle$。\n$handle$はどっちの\n意見に賛成や？"},
        { "location": "193/SEL"   , "narrator": "（選択肢）", "text": "つばめを助けよう"},
        { "location": "194/SEL"   , "narrator": "（選択肢）", "text": "やっぱりつばめは疑わしい"},
        { "location": "195/ACT"   , "narrator": "", "text": "つばめを助けよう"},
        { "location": "198/TALK"  , "narrator": "潜在みやび", "text": "ちゅうわけやき――"},
        { "location": "199/TALK"  , "narrator": "潜在みやび", "text": "準備はえいか？\n強情なうち。"},
        { "location": "202/TALK"  , "narrator": "表層みやび", "text": "そう来ると思うた\nぞね、強硬なうち。"},
        { "location": "203/TALK"  , "narrator": "潜在みやび", "text": "本人同士で意見が\n合わんかったら――"},
        { "location": "204/TALK"  , "narrator": "潜在みやび", "text": "もうこうするしか、\n方法はないやろ。"},
        { "location": "205/TALK"  , "narrator": "潜在みやび", "text": "じゃ、行くぞね！"},
        { "location": "217/DIALOG", "narrator": "", "text": "<color=black><size=50><b>つばめを無理矢理罪人に\nしたがるみやびを倒せ！</b></size></color>\n\n\n\nなんの根拠も見つからないまま\n逢瀬つばめを黒であると判断するみやび。\n彼女はもはや、疲れてしまったのだ。\nあまりにつばめが尻尾を出さないことに。\n\nしかし、警戒を怠りたくないみやびは\nあの手この手でつばめを黒に仕立て上げる。\n\nそんなことはさせてはならない！\nつばめとみやびのココロを守れるのは、貴方だけだ。"},
        { "location": "219/ACT"   , "narrator": "", "text": "やっぱりつばめは疑わしい"},
        { "location": "221/TALK"  , "narrator": "潜在みやび", "text": "うわ、マジか。"},
        { "location": "224/TALK"  , "narrator": "表層みやび", "text": "意外と冷たい奴\nなんやね？"},
        { "location": "225/SEL"   , "narrator": "（選択肢）", "text": "えっ！？　疑ってたんでしょ？"},
        { "location": "226/ACT"   , "narrator": "", "text": "えっ！？　疑ってたんでしょ？"},
        { "location": "228/TALK"  , "narrator": "表層みやび", "text": "…………。"},
        { "location": "229/TALK"  , "narrator": "潜在みやび", "text": "まあ、そう思うてる\n時点でここにおる\n資格はないな。"},
        { "location": "230/TALK"  , "narrator": "潜在みやび", "text": "一度帰って、\n頭冷やしてきぃ。"}
    ]
}
