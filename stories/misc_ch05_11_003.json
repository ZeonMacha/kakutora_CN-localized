        { "location": "3036/SCENARIO", "narrator": "", "text": "迷子のうさぎは月にいる"},
        { "location": "3061/TALK"    , "narrator": "神楽", "text": "さみしい夜には月を見上げて"},
        { "location": "3062/TALK"    , "narrator": "神楽", "text": "そうすればぴょんこがそこから微笑んでいるから"},
        { "location": "3064/SEL"     , "narrator": "", "text": "$me$を見守ってくれてるんだね"},
        { "location": "3065/SEL"     , "narrator": "", "text": "昼間の月には神楽はいないの？"},
        { "location": "3066/SEL"     , "narrator": "", "text": "曇りで月が見えないよ"},
        { "location": "3067/ACT"     , "narrator": "", "text": "$me$を見守ってくれてるんだね"},
        { "location": "3069/TALK"    , "narrator": "神楽", "text": "そうそう"},
        { "location": "3070/TALK"    , "narrator": "神楽", "text": "ぴょんこは月の女神だから♪"},
        { "location": "3071/TALK"    , "narrator": "神楽", "text": "$handlek$を空から監視してるの"},
        { "location": "3072/TALK"    , "narrator": "神楽", "text": "暇]ﾟДﾟ)"},
        { "location": "3073/ACT"     , "narrator": "", "text": "昼間の月には神楽はいないの？"},
        { "location": "3074/TALK"    , "narrator": "神楽", "text": "無理"},
        { "location": "3076/TALK"    , "narrator": "神楽", "text": "日中はＪＫとして高校に通ってるから"},
        { "location": "3077/ACT"     , "narrator": "", "text": "曇りで月が見えないよ"},
        { "location": "3078/TALK"    , "narrator": "神楽", "text": "大事なのは気持ち☆彡"},
        { "location": "3080/TALK"    , "narrator": "神楽", "text": "ぴょんこがぴょんこなのは実は$handlek$のラッキーアイテムになりたいからなんだよ？"},
        { "location": "3081/TALK"    , "narrator": "神楽", "text": "この気持ちわかってくれる？"},
        { "location": "3083/SEL"     , "narrator": "", "text": "えっ何ドッキリ！？"},
        { "location": "3084/SEL"     , "narrator": "", "text": "ブヒー！！！！！"},
        { "location": "3085/SEL"     , "narrator": "", "text": "神楽は物じゃなくて人間だよ"},
        { "location": "3086/ACT"     , "narrator": "", "text": "えっ何ドッキリ！？"},
        { "location": "3087/TALK"    , "narrator": "神楽", "text": "ばれてた？"},
        { "location": "3088/TALK"    , "narrator": "神楽", "text": "残念！"},
        { "location": "3089/TALK"    , "narrator": "神楽", "text": "じゃーねー"},
        { "location": "3090/ACT"     , "narrator": "", "text": "ブヒー！！！！！"},
        { "location": "3091/TALK"    , "narrator": "神楽", "text": "うわっキモ！！！！"},
        { "location": "3092/TALK"    , "narrator": "神楽", "text": "ヤバスｗ"},
        { "location": "3093/TALK"    , "narrator": "神楽", "text": "さよーならー"},
        { "location": "3094/ACT"     , "narrator": "", "text": "神楽は物じゃなくて人間だよ"},
        { "location": "3096/TALK"    , "narrator": "神楽", "text": "$handlek$ったら紳士な対応♪"},
        { "location": "3098/TALK"    , "narrator": "神楽", "text": "それとも淑女？"},
        { "location": "3099/TALK"    , "narrator": "神楽", "text": "ぴょんこはキュンってなっちゃうぴょん♪"},
        { "location": "3100/TALK"    , "narrator": "神楽", "text": "これって恋の始まりかも、、、？"},
