        "title": "002 メインストーリー",
        "sub_title": "聖女＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "改めての自己紹介"},
        { "location": "24/TALK"   , "narrator": "聖女つばめ", "text": "ここはどこ？"},
        { "location": "25/TALK"   , "narrator": "聖女つばめ", "text": "どこまでも白い…。"},
        { "location": "26/TALK"   , "narrator": "聖女つばめ", "text": "わたしまで真っ白……。\nどうしてこんな姿に？"},
        { "location": "27/SEL"    , "narrator": "", "text": "なんで千羽鶴がいるの？"},
        { "location": "28/ACT"    , "narrator": "", "text": "なんで千羽鶴がいるの？"},
        { "location": "31/TALK"   , "narrator": "聖女つばめ", "text": "それは誰？"},
        { "location": "32/TALK"   , "narrator": "聖女つばめ", "text": "わたしはつばめ。\n逢瀬つばめ。"},
        { "location": "33/SEL"    , "narrator": "", "text": "本当につばめなの？"},
        { "location": "34/SEL"    , "narrator": "", "text": "つばめじゃないでしょ？"},
        { "location": "35/SEL"    , "narrator": "", "text": "これどうすればいいの…"},
        { "location": "36/ACT"    , "narrator": "", "text": "本当につばめなの？"},
        { "location": "38/TALK"   , "narrator": "聖女つばめ", "text": "それ以外の\n何物でもない。"},
        { "location": "39/ACT"    , "narrator": "", "text": "つばめじゃないでしょ？"},
        { "location": "40/TALK"   , "narrator": "聖女つばめ", "text": "つばめだよ。\n逢瀬つばめだよ。"},
        { "location": "41/ACT"    , "narrator": "", "text": "これどうすればいいの…"},
        { "location": "42/TALK"   , "narrator": "聖女つばめ", "text": "なんで困るの？"},
        { "location": "44/SEL"    , "narrator": "", "text": "えーと"},
        { "location": "45/ACT"    , "narrator": "", "text": "えーと"},
        { "location": "47/TALK"   , "narrator": "聖女つばめ", "text": "はい。"},
        { "location": "48/SEL"    , "narrator": "", "text": "あなたは死にました"},
        { "location": "49/ACT"    , "narrator": "", "text": "あなたは死にました"},
        { "location": "51/TALK"   , "narrator": "聖女つばめ", "text": "そういうあなたは？"},
        { "location": "52/SEL"    , "narrator": "", "text": "$me$だよ"},
        { "location": "53/SEL"    , "narrator": "", "text": "$handle$"},
        { "location": "54/SEL"    , "narrator": "", "text": "わからない？"},
        { "location": "55/ACT"    , "narrator": "", "text": "$me$だよ"},
        { "location": "56/TALK"   , "narrator": "聖女つばめ", "text": "…ごめんなさい。"},
        { "location": "58/TALK"   , "narrator": "聖女つばめ", "text": "そういう名前なの。"},
        { "location": "59/ACT"    , "narrator": "", "text": "わからない？"},
        { "location": "60/TALK"   , "narrator": "聖女つばめ", "text": "ええと…。"},
        { "location": "62/TALK"   , "narrator": "聖女つばめ", "text": "やっぱりわからない。\nごめんなさい。"},
        { "location": "64/TALK"   , "narrator": "聖女つばめ", "text": "聞いていいかな…？"},
        { "location": "65/TALK"   , "narrator": "聖女つばめ", "text": "どうしてあなたは\nわたしが死んだって\n言い切れるの？"},
        { "location": "66/SEL"    , "narrator": "", "text": "選択肢に出たから"},
        { "location": "67/SEL"    , "narrator": "", "text": "それは秘密"},
        { "location": "68/SEL"    , "narrator": "", "text": "そういうもんでしょ"},
        { "location": "69/ACT"    , "narrator": "", "text": "選択肢に出たから"},
        { "location": "70/TALK"   , "narrator": "聖女つばめ", "text": "選択肢…？"},
        { "location": "71/TALK"   , "narrator": "聖女つばめ", "text": "よくわからないけど…。"},
        { "location": "72/ACT"    , "narrator": "", "text": "それは秘密"},
        { "location": "73/TALK"   , "narrator": "聖女つばめ", "text": "そうなの…？"},
        { "location": "74/TALK"   , "narrator": "聖女つばめ", "text": "じゃあ仕方ないね…。"},
        { "location": "75/ACT"    , "narrator": "", "text": "そういうもんでしょ"},
        { "location": "76/TALK"   , "narrator": "聖女つばめ", "text": "えっと…。"},
        { "location": "77/TALK"   , "narrator": "聖女つばめ", "text": "それじゃ\nわかんないよ…。"},
        { "location": "79/TALK"   , "narrator": "聖女つばめ", "text": "…たぶんわたしは\n失敗したんだね。"},
        { "location": "80/TALK"   , "narrator": "聖女つばめ", "text": "理想の社会を\n作ることに。"},
        { "location": "81/TALK"   , "narrator": "聖女つばめ", "text": "人々に安寧を\nもたらすことに。"},
        { "location": "82/SEL"    , "narrator": "", "text": "つばめが難しいこと話してる！"},
        { "location": "83/SEL"    , "narrator": "", "text": "そんなことできなくていいんだ"},
        { "location": "84/SEL"    , "narrator": "", "text": "それは洗脳だよ"},
        { "location": "85/ACT"    , "narrator": "", "text": "つばめが難しいこと話してる！"},
        { "location": "86/TALK"   , "narrator": "聖女つばめ", "text": "聖女としての\n役割を果たすことが\nわたしの使命だから。"},
        { "location": "87/ACT"    , "narrator": "", "text": "そんなことできなくていいんだ"},
        { "location": "88/TALK"   , "narrator": "聖女つばめ", "text": "そんなわけない。"},
        { "location": "89/TALK"   , "narrator": "聖女つばめ", "text": "失敗したから\nなぐさめてくれてる\nだけでしょ？"},
        { "location": "90/ACT"    , "narrator": "", "text": "それは洗脳だよ"},
        { "location": "91/TALK"   , "narrator": "聖女つばめ", "text": "違う。"},
        { "location": "92/TALK"   , "narrator": "聖女つばめ", "text": "それは絶対に違う。"},
        { "location": "94/SEL"    , "narrator": "", "text": "千羽鶴が嘘をついてた"},
        { "location": "95/SEL"    , "narrator": "", "text": "$me$は千羽鶴に騙された"},
        { "location": "96/SEL"    , "narrator": "", "text": "千羽鶴って憶えてる？"},
        { "location": "97/ACT"    , "narrator": "", "text": "千羽鶴が嘘をついてた"},
        { "location": "98/TALK"   , "narrator": "聖女つばめ", "text": "ええと…誰それ？"},
        { "location": "99/ACT"    , "narrator": "", "text": "$me$は千羽鶴に騙された"},
        { "location": "100/TALK"  , "narrator": "聖女つばめ", "text": "ひどいことする人が\nいるんだね。"},
        { "location": "101/ACT"   , "narrator": "", "text": "千羽鶴って憶えてる？"},
        { "location": "102/TALK"  , "narrator": "聖女つばめ", "text": "…ごめんね。\nわからないや。"},
        { "location": "104/SEL"   , "narrator": "", "text": "千羽鶴はつばめのクラン"},
        { "location": "105/SEL"   , "narrator": "", "text": "自分のクランを忘れたの？"},
        { "location": "106/SEL"   , "narrator": "", "text": "つばめから生まれたクランだよ"},
        { "location": "107/ACT"   , "narrator": "", "text": "千羽鶴はつばめのクラン"},
        { "location": "108/TALK"  , "narrator": "聖女つばめ", "text": "そういうことなんだ。"},
        { "location": "109/ACT"   , "narrator": "", "text": "自分のクランを忘れたの？"},
        { "location": "110/TALK"  , "narrator": "聖女つばめ", "text": "…名前なんて\n聞いたことないし。"},
        { "location": "111/ACT"   , "narrator": "", "text": "つばめから生まれたクランだよ"},
        { "location": "112/TALK"  , "narrator": "聖女つばめ", "text": "わたしから？"},
        { "location": "115/TALK"  , "narrator": "聖女つばめ", "text": "わたしのクランは、\n千羽鶴っていうんだね。"},
        { "location": "117/TALK"  , "narrator": "聖女つばめ", "text": "そしてあなたは\nどういう人なの？"},
        { "location": "118/SEL"   , "narrator": "", "text": "つばめの協力者"},
        { "location": "119/SEL"   , "narrator": "", "text": "保護者かな"},
        { "location": "120/SEL"   , "narrator": "", "text": "恋人だよ！？"},
        { "location": "121/ACT"   , "narrator": "", "text": "つばめの協力者"},
        { "location": "122/TALK"  , "narrator": "聖女つばめ", "text": "なんだか\nそんな気がしてた。"},
        { "location": "123/ACT"   , "narrator": "", "text": "保護者かな"},
        { "location": "124/TALK"  , "narrator": "聖女つばめ", "text": "聖女の保護者って\nことなのかな？"},
        { "location": "125/ACT"   , "narrator": "", "text": "恋人だよ！？"},
        { "location": "126/TALK"  , "narrator": "聖女つばめ", "text": "…ごめんね。\n憶えてなくて。"},
        { "location": "128/TALK"  , "narrator": "聖女つばめ", "text": "ええとね。"},
        { "location": "129/TALK"  , "narrator": "聖女つばめ", "text": "改めて自己紹介\nしてもいいかな。"},
        { "location": "130/SEL"   , "narrator": "", "text": "はい"},
        { "location": "131/SEL"   , "narrator": "", "text": "むしろ待ってた"},
        { "location": "132/SEL"   , "narrator": "", "text": "予想はついてるけど"},
        { "location": "133/ACT"   , "narrator": "", "text": "はい"},
        { "location": "134/TALK"  , "narrator": "聖女つばめ", "text": "よかった…。"},
        { "location": "135/ACT"   , "narrator": "", "text": "むしろ待ってた"},
        { "location": "136/TALK"  , "narrator": "聖女つばめ", "text": "そうだったの？\nごめんね。"},
        { "location": "137/ACT"   , "narrator": "", "text": "予想はついてるけど"},
        { "location": "138/TALK"  , "narrator": "聖女つばめ", "text": "そうなの…？\nでも、聞いてね。"},
        { "location": "140/TALK"  , "narrator": "聖女つばめ", "text": "わたし逢瀬つばめは、\n２０１６年６月７日に\n生を受けました。"},
        { "location": "141/TALK"  , "narrator": "聖女つばめ", "text": "この頃はインプラント端末\nレディネスの黎明期\nでした。"},
        { "location": "142/TALK"  , "narrator": "聖女つばめ", "text": "レディネスは松果体に\n付着することで仮想現実を\n機器なしで実現できます。"},
        { "location": "143/TALK"  , "narrator": "聖女つばめ", "text": "それは革命と言える\nものでした。"},
        { "location": "144/TALK"  , "narrator": "聖女つばめ", "text": "同時に個人の\n管理が容易になりました。"},
        { "location": "145/TALK"  , "narrator": "聖女つばめ", "text": "そして２０２８年。\nレディネスの義務化が\n始まります。"},
        { "location": "146/TALK"  , "narrator": "聖女つばめ", "text": "それにより人々は革新的な\n利便性を手に入れました。"},
        { "location": "147/TALK"  , "narrator": "聖女つばめ", "text": "それと同時にこれまでとは\n比較にならないほどの\n管理社会となったのです。"},
        { "location": "148/TALK"  , "narrator": "聖女つばめ", "text": "レディネスが義務化され、\n全ての人が繋がることに\nよってわかったこと。"},
        { "location": "149/TALK"  , "narrator": "聖女つばめ", "text": "レディネスは特定の\n個体との相性により\n爆発的な力を持つ。"},
        { "location": "150/TALK"  , "narrator": "聖女つばめ", "text": "その確率は一億分の\n一ともいわれる\nごくわずかなものです。"},
        { "location": "151/TALK"  , "narrator": "聖女つばめ", "text": "しかしとても有用と\n見なされました。"},
        { "location": "152/TALK"  , "narrator": "聖女つばめ", "text": "なぜならその力は\n他人の心を自然に変化\nさせることができたから。"},
        { "location": "153/TALK"  , "narrator": "聖女つばめ", "text": "物理的かつ無血で\n誰も認識しないほど\n自然に世界を変える力。"},
        { "location": "154/TALK"  , "narrator": "聖女つばめ", "text": "それを持っていたうちの\n一人がわたし、\n逢瀬つばめです。"},
        { "location": "155/SEL"   , "narrator": "", "text": "…そうだったんだ…"},
        { "location": "156/SEL"   , "narrator": "", "text": "重い話だ"},
        { "location": "157/SEL"   , "narrator": "", "text": "そんな力、人類に必要ない"},
        { "location": "158/ACT"   , "narrator": "", "text": "…そうだったんだ…"},
        { "location": "159/TALK"  , "narrator": "聖女つばめ", "text": "わかってくれた？"},
        { "location": "160/ACT"   , "narrator": "", "text": "重い話だ"},
        { "location": "161/TALK"  , "narrator": "聖女つばめ", "text": "全人類に関係する\n話だから。"},
        { "location": "162/ACT"   , "narrator": "", "text": "そんな力、人類に必要ない"},
        { "location": "163/TALK"  , "narrator": "聖女つばめ", "text": "そんなことない！"},
        { "location": "165/TALK"  , "narrator": "聖女つばめ", "text": "科学者の方々はそれを\nアカシックレコードに\n繋がる力と言いました。"},
        { "location": "166/TALK"  , "narrator": "聖女つばめ", "text": "そして突然変異体、\nわたしたちの能力の\n研究を開始しました。　"},
        { "location": "167/TALK"  , "narrator": "聖女つばめ", "text": "最終目標は世界平和。\nその計画の名を\nフェノム計画と言います。"},
        { "location": "168/SEL"   , "narrator": "", "text": "モルモットじゃないか"},
        { "location": "169/SEL"   , "narrator": "", "text": "信じてたんだ"},
        { "location": "170/SEL"   , "narrator": "", "text": "ひどいことをされたね"},
        { "location": "171/ACT"   , "narrator": "", "text": "モルモットじゃないか"},
        { "location": "172/TALK"  , "narrator": "聖女つばめ", "text": "人類の進歩のための\n研究です。\nそんな言い方しないで。"},
        { "location": "173/ACT"   , "narrator": "", "text": "信じてたんだ"},
        { "location": "174/TALK"  , "narrator": "聖女つばめ", "text": "世界平和は実現\nできないとでも\n言うんですか？"},
        { "location": "175/ACT"   , "narrator": "", "text": "ひどいことをされたね"},
        { "location": "176/TALK"  , "narrator": "聖女つばめ", "text": "……そんなこと…\nないよ……。"},
        { "location": "178/TALK"  , "narrator": "聖女つばめ", "text": "そしてこれから、\nわたしつばめの\n思い出を。"},
        { "location": "179/TALK"  , "narrator": "聖女つばめ", "text": "あなたと少し\n共有したいと\n思います。"},
        { "location": "212/TALK"  , "narrator": "カレン", "text": "……。"},
        { "location": "213/SEL"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "214/ACT"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "216/TALK"  , "narrator": "カレン", "text": "はぁぁぁ……"},
        { "location": "217/TALK"  , "narrator": "カレン", "text": "やっぱり\nすごく緊張します…！！"},
        { "location": "218/SEL"   , "narrator": "", "text": "これから戦うわけだしね"},
        { "location": "219/SEL"   , "narrator": "", "text": "無理しなくていいんだよ？"},
        { "location": "220/ACT"   , "narrator": "", "text": "これから戦うわけだしね"},
        { "location": "221/TALK"  , "narrator": "カレン", "text": "ち、ちがうんですよ…\n緊張するのは――"},
        { "location": "222/TALK"  , "narrator": "カレン", "text": "$handle$さんに\nわたしの真の姿を\n見られちゃうことです！"},
        { "location": "223/SEL"   , "narrator": "", "text": "きっとカワイイから大丈夫"},
        { "location": "224/SEL"   , "narrator": "", "text": "もしかして百鶴みたいに…"},
        { "location": "225/ACT"   , "narrator": "", "text": "きっとカワイイから大丈夫"},
        { "location": "226/TALK"  , "narrator": "カレン", "text": "うぅ……どうでしょうか。"},
        { "location": "227/ACT"   , "narrator": "", "text": "もしかして百鶴みたいに…"},
        { "location": "228/TALK"  , "narrator": "カレン", "text": "あっ、えっと、\nそれはないと\n思いますけど……"},
        { "location": "229/TALK"  , "narrator": "カレン", "text": "うーん、でもなんだろ、\n似てるような\n似てないような……"},
        { "location": "231/ACT"   , "narrator": "", "text": "無理しなくていいんだよ？"},
        { "location": "232/TALK"  , "narrator": "カレン", "text": "いえ、\n無理なんかじゃ\nありません！"},
        { "location": "233/TALK"  , "narrator": "カレン", "text": "$handle$さんに\n見られることは\n嫌じゃありませんから。"},
        { "location": "234/SEL"   , "narrator": "", "text": "見られる…？？"},
        { "location": "235/SEL"   , "narrator": "", "text": "もしかして全裸に！？"},
        { "location": "236/ACT"   , "narrator": "", "text": "見られる…？？"},
        { "location": "237/TALK"  , "narrator": "カレン", "text": "あ、はい。わたしの\n本当の姿を見られるのが\n恥ずかしくて……。"},
        { "location": "238/ACT"   , "narrator": "", "text": "もしかして全裸に！？"},
        { "location": "239/TALK"  , "narrator": "カレン", "text": "え、えええええっ！？\nななななりませんよう！"},
        { "location": "240/TALK"  , "narrator": "カレン", "text": "だいたい、\nそんなことなら\n別に緊張しませんし！"},
        { "location": "241/TALK"  , "narrator": "カレン", "text": "わたしの\n本当の姿を見られるのが\n緊張するんです！"},
        { "location": "244/SEL"   , "narrator": "", "text": "そんなことより、戦う事に緊張はないの？"},
        { "location": "245/ACT"   , "narrator": "", "text": "そんなことより、戦う事に緊張はないの？"},
        { "location": "247/TALK"  , "narrator": "カレン", "text": "え？\nそれはないですよ。"},
        { "location": "248/TALK"  , "narrator": "カレン", "text": "だってお相手は\n$handle$さん\nですから。"},
        { "location": "249/TALK"  , "narrator": "カレン", "text": "絶対、良い結果に\nしてくれるって\n思ってますし。"},
        { "location": "250/SEL"   , "narrator": "", "text": "信じていてくれてありがとう"},
        { "location": "251/SEL"   , "narrator": "", "text": "それってめちゃ責任重大やん！"},
        { "location": "252/ACT"   , "narrator": "", "text": "信じていてくれてありがとう"},
        { "location": "253/TALK"  , "narrator": "カレン", "text": "えへへ。"},
        { "location": "254/ACT"   , "narrator": "", "text": "それってめちゃ責任重大やん！"},
        { "location": "255/TALK"  , "narrator": "カレン", "text": "え？\nそうですか？"},
        { "location": "256/TALK"  , "narrator": "カレン", "text": "気楽にやってくれれば\nそれでいいんですよ？"},
        { "location": "257/SEL"   , "narrator": "", "text": "わかったよ"},
        { "location": "258/SEL"   , "narrator": "", "text": "やっぱりカレンは天然ドSですね"},
        { "location": "259/ACT"   , "narrator": "", "text": "わかったよ"},
        { "location": "260/ACT"   , "narrator": "", "text": "やっぱりカレンは天然ドSですね"},
        { "location": "261/TALK"  , "narrator": "カレン", "text": "てんねんどえす？"},
        { "location": "262/TALK"  , "narrator": "カレン", "text": "よくわかりませんけど、\nとにかく、スコーン！と\n気楽にやってください！"},
        { "location": "263/SEL"   , "narrator": "", "text": "あ、はい"},
        { "location": "264/ACT"   , "narrator": "", "text": "あ、はい"},
        { "location": "269/TALK"  , "narrator": "カレン", "text": "あの！\n$handle$さん！"},
        { "location": "279/TALK"  , "narrator": "カレン", "text": "……ふぅ……"},
        { "location": "280/SEL"   , "narrator": "", "text": "カレン！？"},
        { "location": "282/ACT"   , "narrator": "", "text": "カレン！？"},
        { "location": "284/TALK"  , "narrator": "カレン", "text": "え"},
        { "location": "285/TALK"  , "narrator": "カレン", "text": "ひゃああああ！！\n$handle$さん！！"},
        { "location": "286/SEL"   , "narrator": "", "text": "なにビビってるの？"},
        { "location": "287/SEL"   , "narrator": "", "text": "なに勝手に発症しようとしてるの？"},
        { "location": "288/ACT"   , "narrator": "", "text": "なにビビってるの？"},
        { "location": "289/TALK"  , "narrator": "カレン", "text": "いいいいいえ！\n全然ビビってなんて\nいませんよ？"},
        { "location": "290/TALK"  , "narrator": "カレン", "text": "ただ、\n$handle$さんが\n来るより前に――"},
        { "location": "291/TALK"  , "narrator": "カレン", "text": "いえ、すみません！\nすっかりココロが\n動転してますっ！！"},
        { "location": "292/ACT"   , "narrator": "", "text": "なに勝手に発症しようとしてるの？"},
        { "location": "293/TALK"  , "narrator": "カレン", "text": "かかかか勝手に\n発症なんて企んで\nいませんよう！！"},
        { "location": "294/TALK"  , "narrator": "カレン", "text": "ただ単に、\n$handle$さんが\n来る前に準備をと思って！"},
        { "location": "295/TALK"  , "narrator": "カレン", "text": "勝手に発症しようと\nしたんじゃなくて、発症を\nしようとしてただけです！"},
        { "location": "297/SEL"   , "narrator": "", "text": "おちつけおちつけ！"},
        { "location": "298/ACT"   , "narrator": "", "text": "おちつけおちつけ！"},
        { "location": "300/TALK"  , "narrator": "カレン", "text": "ふええええ……\nごめんなさい……。"},
        { "location": "301/SEL"   , "narrator": "", "text": "そんなじゃ、$me$が阻止して終わりだね"},
        { "location": "302/SEL"   , "narrator": "", "text": "そんなだから憎めないんだよなぁ"},
        { "location": "303/ACT"   , "narrator": "", "text": "そんなじゃ、$me$が阻止して終わりだね"},
        { "location": "304/TALK"  , "narrator": "カレン", "text": "そ、そうですよね……。\nごめんなさい。"},
        { "location": "305/ACT"   , "narrator": "", "text": "そんなだから憎めないんだよなぁ"},
        { "location": "306/TALK"  , "narrator": "カレン", "text": "あ…ははは……\nごめんなさい。"},
        { "location": "308/TALK"  , "narrator": "カレン", "text": "$handle$さんが\n来る前に、発症しちゃおう\nと思ったんですけど――"},
        { "location": "309/TALK"  , "narrator": "カレン", "text": "当たり前ですけど\n無理ですよね。"},
        { "location": "310/TALK"  , "narrator": "カレン", "text": "$handle$さんは\nいつも的確に“その刻”に\nアクセスできますし。"},
        { "location": "311/TALK"  , "narrator": "カレン", "text": "あっ、でも！\n気にしないでください！"},
        { "location": "312/SEL"   , "narrator": "", "text": "何が…？"},
        { "location": "313/ACT"   , "narrator": "", "text": "何が…？"},
        { "location": "315/TALK"  , "narrator": "カレン", "text": "あ、えっと、\nわたしと戦う時は、\n気兼ねなくお願いします！"},
        { "location": "316/TALK"  , "narrator": "カレン", "text": "今回の戦いは、\nわたしとあなたの想いの\nぶつけ合いです！"},
        { "location": "317/TALK"  , "narrator": "カレン", "text": "お互い、お互いの想いを\n大事にしてるなら、当然\n本気で戦いたいですよね。"},
        { "location": "318/TALK"  , "narrator": "カレン", "text": "だから、わたしに\n同情するとか、手加減とか\nしないでください！"},
        { "location": "320/TALK"  , "narrator": "カレン", "text": "$handle$さんは…"},
        { "location": "321/TALK"  , "narrator": "カレン", "text": "$handle$さんは、\nわたしが本当に信頼してる\n唯一人の人ですから。"},
        { "location": "322/TALK"  , "narrator": "カレン", "text": "そして、\nわたしが本当に大好きな、\n唯一人のひとなんです。"},
        { "location": "323/TALK"  , "narrator": "カレン", "text": "だから、最後の最後まで\nお互い気持ちを偽ったり\nしたくないんです。"},
        { "location": "324/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "325/SEL"   , "narrator": "", "text": "無理しないで"},
        { "location": "326/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "327/TALK"  , "narrator": "カレン", "text": "…よかったです。"},
        { "location": "328/ACT"   , "narrator": "", "text": "無理しないで"},
        { "location": "329/TALK"  , "narrator": "カレン", "text": "無理なんてしてません！"},
        { "location": "330/TALK"  , "narrator": "カレン", "text": "わたしはただ、\nあなたとの思い出を――"},
        { "location": "331/TALK"  , "narrator": "カレン", "text": "ずっと宝石のような\n宝物のままにしておきたい\nだけなんです。"},
        { "location": "332/SEL"   , "narrator": "", "text": "ありがとう"},
        { "location": "333/ACT"   , "narrator": "", "text": "ありがとう"},
        { "location": "336/TALK"  , "narrator": "カレン", "text": "あ……あの！！"},
        { "location": "338/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "339/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "341/TALK"  , "narrator": "カレン", "text": "今まで本当に、\nありがとうございました！"},
        { "location": "342/TALK"  , "narrator": "カレン", "text": "初めて\n$handle$さんと\n出逢ったときのこと――"},
        { "location": "343/TALK"  , "narrator": "カレン", "text": "今でも、\n昨日のことのように\n覚えてます。"},
        { "location": "344/TALK"  , "narrator": "カレン", "text": "実はすごい緊張してて、\nロボットみたいなことしか\n話せませんでしたけど。"},
        { "location": "345/TALK"  , "narrator": "カレン", "text": "でも$handle$さんは\n凄くフレンドリーで、\nすぐ安心できました。"},
        { "location": "347/TALK"  , "narrator": "カレン", "text": "一番ビックリしたのは、\n$handle$さんが\n司書やるって言った時です。"},
        { "location": "348/TALK"  , "narrator": "カレン", "text": "冗談だったのかも\nしれませんけど、私には\nとっても衝撃でした。"},
        { "location": "350/TALK"  , "narrator": "カレン", "text": "まだ出逢ってすぐなのに、\nわたしのダメな所を\n叱ってくれたり――"},
        { "location": "351/TALK"  , "narrator": "カレン", "text": "いいって思った所を\nいっぱい褒めてくれたり\nしましたよね？"},
        { "location": "352/TALK"  , "narrator": "カレン", "text": "実家に帰らないことを\n指摘されたのは\nビックリしましたけど。"},
        { "location": "353/TALK"  , "narrator": "カレン", "text": "でもお陰で、\nお父さんに関して改めて\n考えることができました。"},
        { "location": "354/TALK"  , "narrator": "カレン", "text": "でも、その後すぐに\n呼出があって、そして\nあの事件が……。"},
        { "location": "355/TALK"  , "narrator": "カレン", "text": "司書の更迭の\nことですけどね、\nでも実はそんなことより！"},
        { "location": "358/TALK"  , "narrator": "カレン", "text": "お腹出てるの\n気にしてるところを\n見られたり――"},
        { "location": "362/TALK"  , "narrator": "カレン", "text": "実はエッチな子だったの？\nとか聞かれたり――"},
        { "location": "366/TALK"  , "narrator": "カレン", "text": "$handle$さんが、\n有給休暇の時に、\n私のココロを任せても――"},
        { "location": "367/TALK"  , "narrator": "カレン", "text": "何一つ、心の秘密を\n覗かなかったことに\n感動したんです！"},
        { "location": "369/TALK"  , "narrator": "カレン", "text": "心の中を\n色々覗かれたことが\n衝撃的でした！"},
        { "location": "370/SEL"   , "narrator": "", "text": "すみません……"},
        { "location": "371/ACT"   , "narrator": "", "text": "すみません……"},
        { "location": "373/TALK"  , "narrator": "カレン", "text": "あ、違うんです。\n嫌だったわけじゃ\nありませんから。"},
        { "location": "375/TALK"  , "narrator": "カレン", "text": "そういったこともあって、\nわたし、名前を言おうって\n決意したんですよ？"},
        { "location": "376/TALK"  , "narrator": "カレン", "text": "人格が自分の名前を伝える\nのは、その人格の全てを\n支配されるも同義。"},
        { "location": "377/TALK"  , "narrator": "カレン", "text": "それを分かった上で、\nわたしは名前を\nお伝えしました。"},
        { "location": "378/TALK"  , "narrator": "カレン", "text": "でも$handle$さん\nご存知でしたか？"},
        { "location": "379/TALK"  , "narrator": "カレン", "text": "みんな一様に、\n名前を伝えるデメリット\nしか言いませんけど。"},
        { "location": "380/TALK"  , "narrator": "カレン", "text": "メリットがあること。"},
        { "location": "381/SEL"   , "narrator": "", "text": "わからない"},
        { "location": "382/SEL"   , "narrator": "", "text": "結婚したことになるってこと？"},
        { "location": "383/ACT"   , "narrator": "", "text": "わからない"},
        { "location": "384/ACT"   , "narrator": "", "text": "結婚したことになるってこと？"},
        { "location": "386/TALK"  , "narrator": "カレン", "text": "ち、違いますよう！"},
        { "location": "387/TALK"  , "narrator": "カレン", "text": "それはそれで\n魅力的ですけど！"},
        { "location": "389/TALK"  , "narrator": "カレン", "text": "正解は、わたしに何か\nあったとき、助けて\nもらえるってことです。"},
        { "location": "390/TALK"  , "narrator": "カレン", "text": "私の全てを知ることは、\n私をどうにでも\nできるということ。"},
        { "location": "391/TALK"  , "narrator": "カレン", "text": "別の場所に転移させたり、\n発症させたり、人格改変も\n簡単にできますから。"},
        { "location": "392/TALK"  , "narrator": "カレン", "text": "わたしは、\n$handle$さんを\n信頼していました。"},
        { "location": "393/TALK"  , "narrator": "カレン", "text": "だから、わたしが万一の\n事態に陥ったときにも、\nきっと助けてくれるって。"},
        { "location": "394/TALK"  , "narrator": "カレン", "text": "そう信じて、\nわたしの名前を\n託したんです。"},
        { "location": "395/TALK"  , "narrator": "カレン", "text": "そして、\nそれは正解でした。"},
        { "location": "396/TALK"  , "narrator": "カレン", "text": "$handle$さんが\nわたしに逢いに1xまで\n来てくれたとき――"},
        { "location": "397/TALK"  , "narrator": "カレン", "text": "生まれて初めての気持ちを\n体験したんです！"},
        { "location": "398/TALK"  , "narrator": "カレン", "text": "ココロが高揚して、\nあまりの気持ちの高鳴りに\n失神しそうでした。"},
        { "location": "399/SEL"   , "narrator": "", "text": "大げさでは？"},
        { "location": "400/ACT"   , "narrator": "", "text": "大げさでは？"},
        { "location": "402/TALK"  , "narrator": "カレン", "text": "そんな事ありませんよ！"},
        { "location": "403/TALK"  , "narrator": "カレン", "text": "それに、今わたしが\nこうやってセルフクランを\n目指せること――"},
        { "location": "404/TALK"  , "narrator": "カレン", "text": "それだって、\n$handle$さんの\nお陰ですから。"},
        { "location": "405/SEL"   , "narrator": "", "text": "どういう関係が？"},
        { "location": "406/ACT"   , "narrator": "", "text": "どういう関係が？"},
        { "location": "408/TALK"  , "narrator": "カレン", "text": "前にもお話したことが\nあったかもしれませんが、\nわたしは弱小人格でした。"},
        { "location": "409/TALK"  , "narrator": "カレン", "text": "影響力も大きい方では\nありませんでしたし。"},
        { "location": "410/TALK"  , "narrator": "カレン", "text": "ですが、\n司書という役割になって、\nあなたと出逢って。"},
        { "location": "411/TALK"  , "narrator": "カレン", "text": "色んな事を学んで、\n経験して、そして\nあなたを好きになって。"},
        { "location": "412/TALK"  , "narrator": "カレン", "text": "神楽ちゃんのこと、\n千羽鶴のこと、\nみんなの想いのこと――"},
        { "location": "413/TALK"  , "narrator": "カレン", "text": "そういったことを\n知って、共感して、私は\n少しずつ強くなりました。"},
        { "location": "414/TALK"  , "narrator": "カレン", "text": "百鶴さんの言う事が\n本当なら。"},
        { "location": "415/TALK"  , "narrator": "カレン", "text": "監禁洗脳した時と今とでは\n別人格のようだそうです。"},
        { "location": "416/TALK"  , "narrator": "カレン", "text": "そしてそれを是とするなら\n$handle$さんに\n感謝せねばならないと。"},
        { "location": "417/TALK"  , "narrator": "カレン", "text": "ですから、\nお礼を言わせてください。"},
        { "location": "418/TALK"  , "narrator": "カレン", "text": "本当に……\nありがとうございました！"},
        { "location": "419/TALK"  , "narrator": "カレン", "text": "わたしは、\n今から旅立ちます。"},
        { "location": "420/TALK"  , "narrator": "カレン", "text": "発症とは、\n“ココロの旅”なんです。"},
        { "location": "421/TALK"  , "narrator": "カレン", "text": "今とは違うわたしに\n出逢う為の旅です……。"},
        { "location": "423/TALK"  , "narrator": "カレン", "text": "そんな旅の門出に、\n$handle$さんが\n導いてくれること――"},
        { "location": "424/TALK"  , "narrator": "カレン", "text": "本当に嬉しいです。"},
        { "location": "425/TALK"  , "narrator": "カレン", "text": "あの！\nお願いがあるんです！"},
        { "location": "426/TALK"  , "narrator": "カレン", "text": "嫌かもしれませんけど、\nその――"},
        { "location": "427/TALK"  , "narrator": "カレン", "text": "どうか、わたしと\nキスしてください！！"},
        { "location": "428/TALK"  , "narrator": "カレン", "text": "わたしにとって、\n大切な思い出に\nなるはずなんです……。"},
        { "location": "429/TALK"  , "narrator": "カレン", "text": "だから、\nどうかお願いします！"},
        { "location": "447/TALK"  , "narrator": "カレン", "text": "はあっ！"},
        { "location": "450/TALK"  , "narrator": "カレン", "text": "はあっ！"},
        { "location": "456/TALK"  , "narrator": "カレン", "text": "とっても優しくて\n暖かい想い……。"},
        { "location": "457/TALK"  , "narrator": "カレン", "text": "ありがとうございます。\nきっと、ずっと残る\n思い出になります。"},
        { "location": "458/SEL"   , "narrator": "", "text": "$me$もきっとそうなる"},
        { "location": "459/SEL"   , "narrator": "", "text": "そんな終わりみたいなこと言わないで"},
        { "location": "460/ACT"   , "narrator": "", "text": "$me$もきっとそうなる"},
        { "location": "461/TALK"  , "narrator": "カレン", "text": "はい！"},
        { "location": "462/ACT"   , "narrator": "", "text": "そんな終わりみたいなこと言わないで"},
        { "location": "463/TALK"  , "narrator": "カレン", "text": "そうですよね！\nまだこれからも、\nずっと一緒です！"},
        { "location": "465/TALK"  , "narrator": "カレン", "text": "……。"},
        { "location": "466/TALK"  , "narrator": "カレン", "text": "それじゃ…そろそろ、\n昇華しますね。"},
        { "location": "467/TALK"  , "narrator": "カレン", "text": "どうか、しっかりと\n見届けてください。"},
        { "location": "469/TALK"  , "narrator": "カレン", "text": "$handle$さんには\n反対されちゃい\nましたけど。"},
        { "location": "470/TALK"  , "narrator": "カレン", "text": "わたしがここまで\n物事をちゃんと考えられる\nようになったのは――"},
        { "location": "471/TALK"  , "narrator": "カレン", "text": "$handle$さんの\nお陰なんです。迷惑な\n話かもしれませんけど。"},
        { "location": "472/TALK"  , "narrator": "カレン", "text": "でも、わたしは\n感謝しています。"},
        { "location": "473/TALK"  , "narrator": "カレン", "text": "ですから……\nどうか、しっかりと\n見届けてください。"},
        { "location": "476/TALK"  , "narrator": "カレン", "text": "わたしの\n旅立ちの姿を――！！"},
        { "location": "487/TALK"  , "narrator": "昇華カレン", "text": "……。"},
        { "location": "488/TALK"  , "narrator": "昇華カレン", "text": "$handle$さん……"},
        { "location": "489/SEL"   , "narrator": "", "text": "かっこいい！"},
        { "location": "490/SEL"   , "narrator": "", "text": "尊い……"},
        { "location": "491/SEL"   , "narrator": "", "text": "大したことなさそうだな"},
        { "location": "492/ACT"   , "narrator": "", "text": "かっこいい！"},
        { "location": "493/TALK"  , "narrator": "昇華カレン", "text": "…ありがとうございます。"},
        { "location": "495/ACT"   , "narrator": "", "text": "尊い……"},
        { "location": "497/TALK"  , "narrator": "昇華カレン", "text": "そんな…\n尊いなんて言われるほど\n凄くありません。"},
        { "location": "498/TALK"  , "narrator": "昇華カレン", "text": "でも、\nとっても嬉しいです。"},
        { "location": "499/ACT"   , "narrator": "", "text": "大したことなさそうだな"},
        { "location": "500/TALK"  , "narrator": "昇華カレン", "text": "そうですよね。"},
        { "location": "502/TALK"  , "narrator": "昇華カレン", "text": "でも、それでも\n$handle$さんの為に\n精一杯頑張りますから！"},
        { "location": "504/TALK"  , "narrator": "昇華カレン", "text": "でも、それでも\n想いはだれよりも\n強いですから！"},
        { "location": "509/TALK"  , "narrator": "昇華カレン", "text": "掛け替えのない\n$handle$さん。"},
        { "location": "510/TALK"  , "narrator": "昇華カレン", "text": "どうか、\nわたしのこと――"},
        { "location": "511/TALK"  , "narrator": "昇華カレン", "text": "よろしくお願いします！！"},
        { "location": "513/TALK"  , "narrator": "昇華カレン", "text": "さっきはすごいビックリ\nしちゃいましたけど。"},
        { "location": "514/TALK"  , "narrator": "昇華カレン", "text": "戦う前に、\n$handle$さんと\nお話できて良かったです。"},
        { "location": "515/TALK"  , "narrator": "昇華カレン", "text": "あのまま先に\n昇華しちゃってたら、"},
        { "location": "516/TALK"  , "narrator": "昇華カレン", "text": "$handle$さんと\n想いを伝えたりできずに\n後悔していたと思います。"},
        { "location": "517/TALK"  , "narrator": "昇華カレン", "text": "……それじゃ…"},
        { "location": "518/TALK"  , "narrator": "昇華カレン", "text": "今まで本当に、\nありがとうございました。"},
        { "location": "519/TALK"  , "narrator": "昇華カレン", "text": "誠心誠意、\n本気の勝負で――"},
        { "location": "520/TALK"  , "narrator": "昇華カレン", "text": "どうかお願いします！！"},
        { "location": "522/TALK"  , "narrator": "昇華カレン", "text": "あなたとわたしに、\n一生の思い出に残る\n素敵なココロの旅を！"},
        { "location": "18/DIALOG" , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
