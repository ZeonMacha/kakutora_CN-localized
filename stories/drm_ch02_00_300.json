    "entry":
    [
        { "location": "269/SCENARIO", "narrator": "", "text": "かわいいあのこ"},
        { "location": "280/TALK"    , "narrator": "アーヤ", "text": "…あら？\nあそこにいるのって…。"},
        { "location": "281/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ。"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "…なんだ、アーヤか。\n何の用？"},
        { "location": "285/TALK"    , "narrator": "アーヤ", "text": "気分転換にちょっとね。"},
        { "location": "286/TALK"    , "narrator": "アーヤ", "text": "…お弁当食べてたの？"},
        { "location": "289/TALK"    , "narrator": "ガブリエラ", "text": "ええ…ここって日当たり\n良いし、静かに食べれる\nから好きなのよ。"},
        { "location": "290/TALK"    , "narrator": "アーヤ", "text": "そう…。"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "293/TALK"    , "narrator": "ガブリエラ", "text": "何よ？\nまだ何か用事あるの？"},
        { "location": "295/TALK"    , "narrator": "アーヤ", "text": "あ、ううん。\nそれじゃ、劇場でね。"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "307/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "308/TALK"    , "narrator": "アーヤ", "text": "やっぱり、気になるわ。"},
        { "location": "320/TALK"    , "narrator": "アーヤ", "text": "心配なことがあるの"},
        { "location": "321/TALK"    , "narrator": "アーヤ", "text": "相談に乗ってヽ(´o｀；"},
        { "location": "323/SEL"     , "narrator": "", "text": "ガブリエラのこと？"},
        { "location": "324/ACT"     , "narrator": "", "text": "ガブリエラのこと？"},
        { "location": "326/TALK"    , "narrator": "アーヤ", "text": "そう！(>_<)"},
        { "location": "327/TALK"    , "narrator": "アーヤ", "text": "ギャヴィってば"},
        { "location": "328/TALK"    , "narrator": "アーヤ", "text": "裏庭で一人でお弁当食べてたの"},
        { "location": "330/TALK"    , "narrator": "アーヤ", "text": "静かで良い、って言ってたけど"},
        { "location": "331/TALK"    , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "332/TALK"    , "narrator": "アーヤ", "text": "クラスの子達と上手くいってないのかしら？"},
        { "location": "333/TALK"    , "narrator": "アーヤ", "text": "心配で堪らないわ(; ;)"},
        { "location": "335/SEL"     , "narrator": "", "text": "心配し過ぎ"},
        { "location": "336/SEL"     , "narrator": "", "text": "おかん目線だね"},
        { "location": "337/SEL"     , "narrator": "", "text": "大丈夫、大丈夫"},
        { "location": "338/ACT"     , "narrator": "", "text": "心配し過ぎ"},
        { "location": "339/TALK"    , "narrator": "アーヤ", "text": "そうかしら？"},
        { "location": "340/TALK"    , "narrator": "アーヤ", "text": "私、心配し過ぎ？(´o｀；"},
        { "location": "341/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "342/TALK"    , "narrator": "アーヤ", "text": "ギャヴィはちょっとキツいとこあるけど"},
        { "location": "343/TALK"    , "narrator": "アーヤ", "text": "凄く良い子なのよ？(>_<)"},
        { "location": "346/SEL"     , "narrator": "", "text": "みんなも気付いてるよ"},
        { "location": "347/ACT"     , "narrator": "", "text": "みんなも気付いてるよ"},
        { "location": "349/TALK"    , "narrator": "アーヤ", "text": "だといいんだけど"},
        { "location": "350/TALK"    , "narrator": "アーヤ", "text": "じゃなきゃ"},
        { "location": "351/TALK"    , "narrator": "アーヤ", "text": "悲しいわ(ノД`)"},
        { "location": "352/ACT"     , "narrator": "", "text": "おかん目線だね"},
        { "location": "355/TALK"    , "narrator": "アーヤ", "text": "失礼な！(--#)"},
        { "location": "356/TALK"    , "narrator": "アーヤ", "text": "そんなに老けてないし！"},
        { "location": "359/SEL"     , "narrator": "", "text": "アーヤがあのくらいの年の頃、覚えてる？"},
        { "location": "360/ACT"     , "narrator": "", "text": "アーヤがあのくらいの年の頃、覚えてる？"},
        { "location": "363/TALK"    , "narrator": "アーヤ", "text": "覚えてはいるけど"},
        { "location": "365/TALK"    , "narrator": "アーヤ", "text": "それがどうかしたの？"},
        { "location": "368/SEL"     , "narrator": "", "text": "だったらあんまり心配しなくても大丈夫だってわかるでしょ"},
        { "location": "369/ACT"     , "narrator": "", "text": "だったらあんまり心配しなくても大丈夫だってわかるでしょ"},
        { "location": "371/TALK"    , "narrator": "アーヤ", "text": "どうかしら？"},
        { "location": "372/TALK"    , "narrator": "アーヤ", "text": "私は結構友達いた方だと思うし"},
        { "location": "373/TALK"    , "narrator": "アーヤ", "text": "お弁当はいつもみんなと食べてたから"},
        { "location": "374/TALK"    , "narrator": "アーヤ", "text": "なんか"},
        { "location": "376/ACT"     , "narrator": "", "text": "大丈夫、大丈夫"},
        { "location": "377/TALK"    , "narrator": "アーヤ", "text": "そうなのかしら？"},
        { "location": "378/TALK"    , "narrator": "アーヤ", "text": "そうだったらいいんだけど…(-.-;)"},
        { "location": "380/SEL"     , "narrator": "", "text": "今だってなんだかんだ言ってみんなとそこそこうまくいってるでしょ"},
        { "location": "381/ACT"     , "narrator": "", "text": "今だってなんだかんだ言ってみんなとそこそこうまくいってるでしょ"},
        { "location": "383/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "384/TALK"    , "narrator": "アーヤ", "text": "トライナリーの中ではそうかもね"},
        { "location": "385/TALK"    , "narrator": "アーヤ", "text": "私が知らないだけで"},
        { "location": "386/TALK"    , "narrator": "アーヤ", "text": "クラスでもそうだったら良いんだけど…(-ω-;)"},
        { "location": "389/SEL"     , "narrator": "", "text": "アーヤは優しいね"},
        { "location": "390/ACT"     , "narrator": "", "text": "アーヤは優しいね"},
        { "location": "392/TALK"    , "narrator": "アーヤ", "text": "心配性なだけよ"},
        { "location": "393/TALK"    , "narrator": "アーヤ", "text": "お節介なのかもしれないけど(・・。)ゞ"},
        { "location": "394/TALK"    , "narrator": "アーヤ", "text": "優しいなんて言ってくれるのは"},
        { "location": "395/TALK"    , "narrator": "アーヤ", "text": "$handle$さんくらいよ"},
        { "location": "408/TALK"    , "narrator": "アーヤ", "text": "…私も、大学戻らないと。"}
    ]
