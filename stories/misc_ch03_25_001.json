    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "037_ひとつ、ふたつ、みっつ"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "数の数え方って"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "色々あるのね"},
        { "location": "35/SEL"    , "narrator": "", "text": "そうだね"},
        { "location": "36/SEL"    , "narrator": "", "text": "ガブがいつでも一番だよ"},
        { "location": "37/ACT"    , "narrator": "", "text": "そうだね"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよね"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "難しいわ"},
        { "location": "40/ACT"    , "narrator": "", "text": "ガブがいつでも一番だよ"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "やだ/////"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "そんなこと知っていてよ？"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "それでね"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "一番最初に日本語を習った時は"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "いち、に、さんって数え方だったの"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "でもこっちに来てみたら"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "ひとつ、ふたつ、みっつって言い方があるでしょう"},
        { "location": "51/SEL"    , "narrator": "", "text": "砕けた言い方だからね"},
        { "location": "52/SEL"    , "narrator": "", "text": "教科書では習わないかも"},
        { "location": "53/SEL"    , "narrator": "", "text": "でもかわいいって思わなかった？"},
        { "location": "54/ACT"    , "narrator": "", "text": "砕けた言い方だからね"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "そうみたいね"},
        { "location": "56/ACT"    , "narrator": "", "text": "教科書では習わないかも"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "そうだったのよね"},
        { "location": "58/ACT"    , "narrator": "", "text": "でもかわいいって思わなかった？"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよｖｖｖｖ"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "ひとつ、ふたつ、みっつって言い方のほうが"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "絶対可愛いのよｖｖｖ"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "とお以上がないのは"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "子供の言葉だからって聞いたわ"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "どこの国にも子供の言葉ってあるのね"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "私はもう中学生だから子供じゃないけど"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "この数え方はとてもかわいいと思ったから"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "ひとつ、ふたつ、みっつって数えるつもりなの"}
    ]
}
