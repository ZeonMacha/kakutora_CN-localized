    "entry":
    [
        { "location": "70/SCENARIO", "narrator": "", "text": "ある晴れた日に"},
        { "location": "95/TALK"    , "narrator": "アーヤ", "text": "何の変哲もない晴れた日に"},
        { "location": "96/TALK"    , "narrator": "アーヤ", "text": "世界が突然"},
        { "location": "97/TALK"    , "narrator": "アーヤ", "text": "変わってしまった"},
        { "location": "99/SEL"     , "narrator": "", "text": "ゲームの話？"},
        { "location": "100/SEL"    , "narrator": "", "text": "幼稚園児にはハードすぎる内容じゃない？"},
        { "location": "101/SEL"    , "narrator": "", "text": "アーヤと$me$の出会いの日だ"},
        { "location": "102/ACT"    , "narrator": "", "text": "ゲームの話？"},
        { "location": "103/TALK"   , "narrator": "アーヤ", "text": "ゲームっていう蚊"},
        { "location": "104/TALK"   , "narrator": "アーヤ", "text": "いうか"},
        { "location": "105/TALK"   , "narrator": "アーヤ", "text": "現実世界の話ね"},
        { "location": "106/ACT"    , "narrator": "", "text": "幼稚園児にはハードすぎる内容じゃない？"},
        { "location": "107/TALK"   , "narrator": "アーヤ", "text": "人形劇の話じゃないわよ"},
        { "location": "109/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "110/TALK"   , "narrator": "アーヤ", "text": "先生には受けるかもだわ"},
        { "location": "111/ACT"    , "narrator": "", "text": "アーヤと$me$の出会いの日だ"},
        { "location": "113/TALK"   , "narrator": "アーヤ", "text": "そんなに衝撃的な出会いだったかしら"},
        { "location": "114/TALK"   , "narrator": "アーヤ", "text": "それじゃまるで"},
        { "location": "115/TALK"   , "narrator": "アーヤ", "text": "運命の相手と出会ったみたいじゃないの"},
        { "location": "117/TALK"   , "narrator": "アーヤ", "text": "今ってトライナリーで活動するのが"},
        { "location": "118/TALK"   , "narrator": "アーヤ", "text": "日常になってるけど"},
        { "location": "119/TALK"   , "narrator": "アーヤ", "text": "これって本来"},
        { "location": "120/TALK"   , "narrator": "アーヤ", "text": "非常事態なわけよね"},
        { "location": "122/SEL"    , "narrator": "", "text": "この国の礎となれ"},
        { "location": "123/SEL"    , "narrator": "", "text": "慣れだよ、慣れ"},
        { "location": "124/SEL"    , "narrator": "", "text": "だからこそアーヤと$me$は出会えたんだ"},
        { "location": "125/ACT"    , "narrator": "", "text": "この国の礎となれ"},
        { "location": "126/TALK"   , "narrator": "アーヤ", "text": "や"},
        { "location": "127/TALK"   , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "128/TALK"   , "narrator": "アーヤ", "text": "そういうのは"},
        { "location": "129/TALK"   , "narrator": "アーヤ", "text": "怖いから"},
        { "location": "130/TALK"   , "narrator": "アーヤ", "text": "やめてよね"},
        { "location": "131/ACT"    , "narrator": "", "text": "慣れだよ、慣れ"},
        { "location": "132/TALK"   , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "133/TALK"   , "narrator": "アーヤ", "text": "慣れちゃったのよね"},
        { "location": "134/TALK"   , "narrator": "アーヤ", "text": "非日常って日常に"},
        { "location": "135/ACT"    , "narrator": "", "text": "だからこそアーヤと$me$は出会えたんだ"},
        { "location": "137/TALK"   , "narrator": "アーヤ", "text": "またそういう"},
        { "location": "138/TALK"   , "narrator": "アーヤ", "text": "でも確かに"},
        { "location": "139/TALK"   , "narrator": "アーヤ", "text": "そうじゃなければ"},
        { "location": "140/TALK"   , "narrator": "アーヤ", "text": "出会えてないのよね"},
        { "location": "141/TALK"   , "narrator": "アーヤ", "text": "不思議だわ"},
        { "location": "145/TALK"   , "narrator": "アーヤ", "text": "ひょっとして運命？"},
        { "location": "148/TALK"   , "narrator": "アーヤ", "text": "なんてね"}
    ]
}
