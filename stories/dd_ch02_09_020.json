{
    "dir": "chap09/daydra/dd_ch02_09_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "9256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ここに桃がある"
    },
    "entry":
    [
        { "location": "204/SCENARIO", "narrator": "", "text": "ここに桃がある"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "ただいまぁ。\nふぅ、重かった…。"},
        { "location": "215/TALK"    , "narrator": "アーヤ", "text": "…でもこれ、\nどうしようかしら？"},
        { "location": "216/TALK"    , "narrator": "アーヤ", "text": "そのままじゃ食べきれる\nとは思えないし…。"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "う～ん…。"},
        { "location": "229/TALK"    , "narrator": "アーヤ", "text": "ヽ(∇⌒ヽ)(ﾉ⌒∇)ﾉ"},
        { "location": "231/SEL"     , "narrator": "", "text": "いいことあったの？"},
        { "location": "232/ACT"     , "narrator": "", "text": "いいことあったの？"},
        { "location": "236/TALK"    , "narrator": "アーヤ", "text": "スーパーでくじを引いたら"},
        { "location": "237/TALK"    , "narrator": "アーヤ", "text": "桃五キロを当てたの(≧∇≦)b"},
        { "location": "238/TALK"    , "narrator": "アーヤ", "text": "ちょっと高級なやつみたいで"},
        { "location": "239/TALK"    , "narrator": "アーヤ", "text": "凄く大きくて、甘い香りがするの"},
        { "location": "241/SEL"     , "narrator": "", "text": "スゴイ！やったね！"},
        { "location": "242/ACT"     , "narrator": "", "text": "スゴイ！やったね！"},
        { "location": "244/TALK"    , "narrator": "アーヤ", "text": "ヽ(*^^*)ノ"},
        { "location": "245/TALK"    , "narrator": "アーヤ", "text": "冷やして食べるのが楽しみ"},
        { "location": "246/TALK"    , "narrator": "アーヤ", "text": "でも、"},
        { "location": "247/TALK"    , "narrator": "アーヤ", "text": "多いから、これでデザートでも作ろうかしら？"},
        { "location": "249/TALK"    , "narrator": "アーヤ", "text": "桃を使ったデザート、何かしらない？"},
        { "location": "251/SEL"     , "narrator": "アーヤ", "text": "パイにしよう"},
        { "location": "252/SEL"     , "narrator": "アーヤ", "text": "シャーベットにしよう"},
        { "location": "253/SEL"     , "narrator": "アーヤ", "text": "おすそわけすれば？"},
        { "location": "254/ACT"     , "narrator": "", "text": "パイにしよう"},
        { "location": "257/TALK"    , "narrator": "アーヤ", "text": "お茶菓子に合いそうでいいかも"},
        { "location": "258/TALK"    , "narrator": "アーヤ", "text": "作るのも難しくないし"},
        { "location": "259/TALK"    , "narrator": "アーヤ", "text": "それにするわ(*^^*)"},
        { "location": "265/TALK"    , "narrator": "アーヤ", "text": "さてと、レシピは…。"},
        { "location": "266/TALK"    , "narrator": "アーヤ", "text": "…でも、パイって\n結構カロリー高いわね。"},
        { "location": "268/TALK"    , "narrator": "アーヤ", "text": "これだけの桃のほとんどを\nパイにしたとして、それを\n食べたとしたら…。"},
        { "location": "271/TALK"    , "narrator": "アーヤ", "text": "…しばらく、自主トレの\n量を増やした方が\nいいかも…。"},
        { "location": "272/ACT"     , "narrator": "", "text": "シャーベットにしよう"},
        { "location": "274/TALK"    , "narrator": "アーヤ", "text": "さっぱりして美味しそう"},
        { "location": "275/TALK"    , "narrator": "アーヤ", "text": "お風呂上りに食べたら最高かも(*^^*)"},
        { "location": "276/TALK"    , "narrator": "アーヤ", "text": "あ、だったら"},
        { "location": "277/TALK"    , "narrator": "アーヤ", "text": "普通に切った桃を冷凍庫で冷やすだけっていうのも"},
        { "location": "278/TALK"    , "narrator": "アーヤ", "text": "美味しく食べられそうでいいかも"},
        { "location": "289/TALK"    , "narrator": "アーヤ", "text": "冷たいデザートなら、\n簡単な物でも美味しく\nなりそうで良いわ。"},
        { "location": "290/TALK"    , "narrator": "アーヤ", "text": "レシピを調べて、\n色々作ってみよっと。"},
        { "location": "291/ACT"     , "narrator": "", "text": "おすそわけすれば？"},
        { "location": "293/TALK"    , "narrator": "アーヤ", "text": "あ、それいいかも"},
        { "location": "294/TALK"    , "narrator": "アーヤ", "text": "デザート作るにしても、一人でこの量は難しいし…"},
        { "location": "295/TALK"    , "narrator": "アーヤ", "text": "そうしてみるわ"},
        { "location": "319/TALK"    , "narrator": "アーヤ", "text": "…というわけで、\nもしよければみんなにも\n食べてもらいたいの。"},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "それは構いませんけど、\n本当にいいんですか？"},
        { "location": "322/TALK"    , "narrator": "つばめ", "text": "凄くいい桃みたい\nですけど…。"},
        { "location": "325/TALK"    , "narrator": "アーヤ", "text": "いい桃だから、\n無駄にしたくないの。"},
        { "location": "326/TALK"    , "narrator": "アーヤ", "text": "少しでも持っていって\nもらえると助かるわ。"},
        { "location": "329/TALK"    , "narrator": "みやび", "text": "そういうことなら、\n遠慮なく貰ってくぞね。"},
        { "location": "330/TALK"    , "narrator": "みやび", "text": "冷やした桃は美味いきね。\n夕飯のデザートにさせて\nもらうが。"},
        { "location": "332/TALK"    , "narrator": "ガブリエラ", "text": "あたしもそうするわ。\n桃なんて、最近食べて\nなかったし。"},
        { "location": "333/TALK"    , "narrator": "アーヤ", "text": "助かるわ。\n一個二個とかじゃなくて、\nもっと抱えて持ってって。"},
        { "location": "335/TALK"    , "narrator": "ガブリエラ", "text": "今度はあたし達が\n食べ切れなくなるわよ。"},
        { "location": "337/TALK"    , "narrator": "みやび", "text": "…なら、少し多めに\n貰ってもえいか？"},
        { "location": "338/TALK"    , "narrator": "みやび", "text": "そしたら桃のお菓子を\n作れるきね。"},
        { "location": "340/TALK"    , "narrator": "つばめ", "text": "わぁ、美味しそうです！"},
        { "location": "343/TALK"    , "narrator": "ガブリエラ", "text": "お菓子かぁ…。"},
        { "location": "344/TALK"    , "narrator": "ガブリエラ", "text": "タルトとかパイなら、\n作れるし、あたしも\nそうしようかしら？"},
        { "location": "345/TALK"    , "narrator": "みやび", "text": "出来上がったら、\nみんなにおすそわけ\nするちや。"},
        { "location": "346/TALK"    , "narrator": "アーヤ", "text": "なら、遠慮せずどんどん\n持ってっちゃって。"},
        { "location": "348/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ、遠慮なく…。"},
        { "location": "350/TALK"    , "narrator": "つばめ", "text": "わたしも、この機会に\n何か作ってみようかなぁ？"},
        { "location": "352/TALK"    , "narrator": "アーヤ", "text": "ふふっ…どんなお菓子が\n出来上がるのか、今から\n楽しみだわ。"},
        { "location": "353/TALK"    , "narrator": "アーヤ", "text": "おすそ分けして\n正解だったみたい。"},
        { "location": "212/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月20日　2:43 PM</color>\nとある平日の午後、アーヤの部屋にて。"}
    ]
}
