        { "location": "7/SCENARIO", "narrator": "", "text": "037_めざめ"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "目が覚めたら"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "全然違う世界になってたら"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "なんて"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "小さい頃はよく考えたわ"},
        { "location": "37/SEL"    , "narrator": "", "text": "小さい頃ってそういうことあるよね"},
        { "location": "38/SEL"    , "narrator": "", "text": "今はそんなことないの？"},
        { "location": "39/SEL"    , "narrator": "", "text": "妄想だね"},
        { "location": "40/ACT"    , "narrator": "", "text": "小さい頃ってそういうことあるよね"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "やっぱりみんな"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "そんなことを考えるわよね"},
        { "location": "46/ACT"    , "narrator": "", "text": "今はそんなことないの？"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "実は"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "最近ちょっと"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "そんなこと考えちゃうのよね"},
        { "location": "52/ACT"    , "narrator": "", "text": "妄想だね"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "違うわよ"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "空想よ"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "空想！！"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "こういうのって"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "大人になるにつれ"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "なくなってくるけど"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "それっていいことなのかなって"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "思ったりするのよね"},
        { "location": "64/SEL"    , "narrator": "", "text": "いいことだと思うけど"},
        { "location": "65/SEL"    , "narrator": "", "text": "子供目線を忘れたくないってこと？"},
        { "location": "66/SEL"    , "narrator": "", "text": "アーヤがアーヤなのが一番いい"},
        { "location": "67/ACT"    , "narrator": "", "text": "いいことだと思うけど"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "現実を把握できてるってことだから"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "いいことなのよね"},
        { "location": "72/ACT"    , "narrator": "", "text": "子供目線を忘れたくないってこと？"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "そうかも"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "しれないわ"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "それって結構大事よね"},
        { "location": "76/ACT"    , "narrator": "", "text": "アーヤがアーヤなのが一番いい"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "あら"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "無難な答えね"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "そう言ってもらえるのは"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "やっぱりうれしいわ"}
