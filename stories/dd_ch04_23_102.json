{
    "dir": "chap23/daydra/dd_ch04_23_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "23405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "らしくないらしい＜後編＞"
    },
    "entry":
    [
        { "location": "764/TALK"   , "narrator": "みやび", "text": "ワガママすぎやと"},
        { "location": "765/TALK"   , "narrator": "みやび", "text": "気に入らないなら見なければよい"},
        { "location": "766/TALK"   , "narrator": "みやび", "text": "ほい解決"},
        { "location": "767/TALK"   , "narrator": "みやび", "text": "さよなら"},
        { "location": "773/TALK"   , "narrator": "みやび", "text": "…さあ、カレー食いに\n行くぞね。"},
        { "location": "775/TALK"   , "narrator": "繭", "text": "では、この近くにある\n有名なお店へ――"},
        { "location": "776/TALK"   , "narrator": "みやび", "text": "つまらん。"},
        { "location": "778/TALK"   , "narrator": "みやび", "text": "検索して出てくるような\n有名店なんぞ行っても、\n面白味ないやろ？"},
        { "location": "779/TALK"   , "narrator": "みやび", "text": "どうせなら、\n穴場探しするぞね。"},
        { "location": "780/TALK"   , "narrator": "繭", "text": "…本気ですか？"},
        { "location": "781/TALK"   , "narrator": "みやび", "text": "嫌ならえいよ。\nうちだけで行くき。"},
        { "location": "782/TALK"   , "narrator": "繭", "text": "…いえ。\nお供させていただきます。"},
        { "location": "807/TALK"   , "narrator": "みやび", "text": "…もう夜かぁ。\nちっくと遊び過ぎた\nかもしれんなぁ…。"},
        { "location": "809/TALK"   , "narrator": "繭", "text": "気分転換も必要です。\n別に構わないと\n思いますよ？"},
        { "location": "810/TALK"   , "narrator": "みやび", "text": "…そうやね。"},
        { "location": "812/TALK"   , "narrator": "みやび", "text": "昼間に比べて、\n気持ちがスッキリ\nしたちや。"},
        { "location": "813/TALK"   , "narrator": "繭", "text": "スッキリしたと\nいうのであれば\n何よりです。"},
        { "location": "814/TALK"   , "narrator": "繭", "text": "しかし、まさか\n屋台のカレーを食べるとは\n思いませんでした。"},
        { "location": "816/TALK"   , "narrator": "みやび", "text": "海軍カレーは横須賀来れば\nいつでも食えるやろ？"},
        { "location": "817/TALK"   , "narrator": "みやび", "text": "やき、屋台カレーの方が\nレア度が上と判断した\n結果ぞね。"},
        { "location": "818/TALK"   , "narrator": "繭", "text": "ふふっ…、\nみやび先輩らしいですね。"},
        { "location": "819/TALK"   , "narrator": "繭", "text": "本当に、\n調子が戻ったようで\n安心しました。"},
        { "location": "820/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "832/TALK"   , "narrator": "みやび", "text": "うちはウサギに"},
        { "location": "833/TALK"   , "narrator": "みやび", "text": "心配されちょったがよ"},
        { "location": "835/SEL"    , "narrator": "", "text": "知ってたよ"},
        { "location": "836/SEL"    , "narrator": "", "text": "いい子だよね"},
        { "location": "837/SEL"    , "narrator": "", "text": "気付いてなかったんだ……"},
        { "location": "838/ACT"    , "narrator": "", "text": "知ってたよ"},
        { "location": "839/TALK"   , "narrator": "みやび", "text": "なんと"},
        { "location": "840/TALK"   , "narrator": "みやび", "text": "さすがは相棒"},
        { "location": "841/ACT"    , "narrator": "", "text": "いい子だよね"},
        { "location": "842/TALK"   , "narrator": "みやび", "text": "その通りだ"},
        { "location": "843/TALK"   , "narrator": "みやび", "text": "当たり前すぎて青天の霹靂"},
        { "location": "844/ACT"    , "narrator": "", "text": "気付いてなかったんだ……"},
        { "location": "845/TALK"   , "narrator": "みやび", "text": "これは"},
        { "location": "846/TALK"   , "narrator": "みやび", "text": "うちの目が節穴だと言いたいのか"},
        { "location": "848/TALK"   , "narrator": "みやび", "text": "改めて礼を言うべきか否か"},
        { "location": "850/SEL"    , "narrator": "", "text": "好きにすれば"},
        { "location": "851/SEL"    , "narrator": "", "text": "言うのは野暮かな"},
        { "location": "852/SEL"    , "narrator": "", "text": "$me$にも言って"},
        { "location": "853/ACT"    , "narrator": "", "text": "好きにすれば"},
        { "location": "854/TALK"   , "narrator": "みやび", "text": "是非もなし"},
        { "location": "855/TALK"   , "narrator": "みやび", "text": "ということか"},
        { "location": "856/TALK"   , "narrator": "みやび", "text": "答えになっとらん！"},
        { "location": "857/ACT"    , "narrator": "", "text": "言うのは野暮かな"},
        { "location": "858/TALK"   , "narrator": "みやび", "text": "なんともまあ"},
        { "location": "859/TALK"   , "narrator": "みやび", "text": "日本人の奥ゆかしさよ"},
        { "location": "860/ACT"    , "narrator": "", "text": "$me$にも言って"},
        { "location": "861/TALK"   , "narrator": "みやび", "text": "あざーっした"},
        { "location": "878/TALK"   , "narrator": "繭", "text": "あっ…、\n上がりましたね。"},
        { "location": "880/TALK"   , "narrator": "みやび", "text": "…ん。"},
        { "location": "881/TALK"   , "narrator": "繭", "text": "綺麗です…。\nこんなに大きな\n花火なんですね。"},
        { "location": "882/TALK"   , "narrator": "みやび", "text": "そうやね…。"},
        { "location": "907/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "910/TALK"   , "narrator": "みやび", "text": "すまんかった…。\n今日一日、\n振り回してしもうて…。"},
        { "location": "912/TALK"   , "narrator": "みやび", "text": "うちな、\n認めたくなかったんよ。"},
        { "location": "913/TALK"   , "narrator": "みやび", "text": "卯月がスパイや、\nっちゅうことを…。"},
        { "location": "916/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "918/TALK"   , "narrator": "みやび", "text": "けんど、\n現実はしっかり\n受け止めんといかん。"},
        { "location": "920/TALK"   , "narrator": "みやび", "text": "卯月がうちらを\n裏切ったゆうんは、\nまぎれもない事実や。"},
        { "location": "921/TALK"   , "narrator": "みやび", "text": "第一、卯月神楽は\n管理庁のスパイや。"},
        { "location": "922/TALK"   , "narrator": "みやび", "text": "最初からうちらを\n裏切ることを前提に、\n近づいたに違いない。"},
        { "location": "923/TALK"   , "narrator": "繭", "text": "…そういうことに\nなりますね。"},
        { "location": "924/TALK"   , "narrator": "みやび", "text": "裏切り者とわかれば\nどういう結末が待つかは、\n考えんでもわかるやろ。"},
        { "location": "925/TALK"   , "narrator": "みやび", "text": "卯月も、その辺は\n覚悟の上で\n行動しちょったろう。"},
        { "location": "926/TALK"   , "narrator": "みやび", "text": "意外とばれたことで\n気は楽になったん\n違うかねえ。"},
        { "location": "927/TALK"   , "narrator": "みやび", "text": "けんど、うちらは本気で\n相手せんと\nいかんろうね。"},
        { "location": "928/TALK"   , "narrator": "繭", "text": "…卯月神楽を、\n敵として見るという\nことですね？"},
        { "location": "929/TALK"   , "narrator": "みやび", "text": "そうやねえ…。"},
        { "location": "930/TALK"   , "narrator": "みやび", "text": "…そういうことに\nなるねえ。"},
        { "location": "931/TALK"   , "narrator": "みやび", "text": "それに、今回の件で\n管理庁が真っ黒ゆう証拠も\n手に入れたことになる。"},
        { "location": "932/TALK"   , "narrator": "繭", "text": "はい…これで向こうの\n活動も、ノンストップで\n行けますね。"},
        { "location": "933/TALK"   , "narrator": "みやび", "text": "…こんなうちやけんど、\n協力してもらえるか？"},
        { "location": "934/TALK"   , "narrator": "繭", "text": "…もちろんです。\n最後までお付き合い\nいたします。"},
        { "location": "935/TALK"   , "narrator": "みやび", "text": "これからは、\n今まで以上に\n忙しくなるな…。"},
        { "location": "936/TALK"   , "narrator": "繭", "text": "問題ありません。"},
        { "location": "937/TALK"   , "narrator": "みやび", "text": "…報酬もないけんど、\nマジでえいが？"},
        { "location": "938/TALK"   , "narrator": "繭", "text": "ふふっ…報酬は今日一日、\nたっぷりいただきました。"},
        { "location": "939/TALK"   , "narrator": "繭", "text": "みやび先輩の可愛らしい\nレアな姿を、\n沢山見れましたので。"},
        { "location": "941/TALK"   , "narrator": "みやび", "text": "…は！？"},
        { "location": "942/TALK"   , "narrator": "みやび", "text": "ワガママ言いまくって\nウサギを振り回した\nだけやんか。"},
        { "location": "943/TALK"   , "narrator": "繭", "text": "最高の報酬です！"},
        { "location": "945/TALK"   , "narrator": "みやび", "text": "…まあ、ウサギが\nそれでえい言うなら、\nそれで構わんけんど…。"},
        { "location": "946/TALK"   , "narrator": "繭", "text": "構いません。\n今後も報酬は\nこの形を希望します。"},
        { "location": "948/TALK"   , "narrator": "みやび", "text": "…考えとくがよ。"},
        { "location": "950/TALK"   , "narrator": "繭", "text": "約束ですよ？"},
        { "location": "954/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "958/TALK"   , "narrator": "みやび", "text": "相棒"},
        { "location": "959/TALK"   , "narrator": "みやび", "text": "うち"},
        { "location": "960/TALK"   , "narrator": "みやび", "text": "意外とメンタル弱いらしい"},
        { "location": "962/SEL"    , "narrator": "", "text": "そういうところもかわいい"},
        { "location": "963/SEL"    , "narrator": "", "text": "別に普通だよ"},
        { "location": "964/SEL"    , "narrator": "", "text": "リフレッシュできた？"},
        { "location": "965/SEL"    , "narrator": "", "text": "冷静になったみたいだね"},
        { "location": "966/ACT"    , "narrator": "", "text": "そういうところもかわいい"},
        { "location": "967/TALK"   , "narrator": "みやび", "text": "かわいいは"},
        { "location": "968/TALK"   , "narrator": "みやび", "text": "思考停止だ"},
        { "location": "969/TALK"   , "narrator": "みやび", "text": "ばかちんが"},
        { "location": "970/ACT"    , "narrator": "", "text": "別に普通だよ"},
        { "location": "971/TALK"   , "narrator": "みやび", "text": "意外と冷静"},
        { "location": "972/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "973/TALK"   , "narrator": "みやび", "text": "慣れておるのか"},
        { "location": "974/TALK"   , "narrator": "みやび", "text": "うちに"},
        { "location": "975/ACT"    , "narrator": "", "text": "リフレッシュできた？"},
        { "location": "976/TALK"   , "narrator": "みやび", "text": "気持ちはの"},
        { "location": "977/TALK"   , "narrator": "みやび", "text": "体重はリフレッシュどころか"},
        { "location": "978/TALK"   , "narrator": "みやび", "text": "過去最高を記録する勢い"},
        { "location": "979/ACT"    , "narrator": "", "text": "冷静になったみたいだね"},
        { "location": "980/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "981/TALK"   , "narrator": "みやび", "text": "うちとしたことが"},
        { "location": "982/TALK"   , "narrator": "みやび", "text": "勝手ばかりを言いすぎた"},
        { "location": "984/TALK"   , "narrator": "みやび", "text": "卯月のことは"},
        { "location": "985/TALK"   , "narrator": "みやび", "text": "事情があったのだろうと推測するため"},
        { "location": "986/TALK"   , "narrator": "みやび", "text": "裏切り自体はとやかく言わぬ"},
        { "location": "989/TALK"   , "narrator": "みやび", "text": "ただまあ"},
        { "location": "990/TALK"   , "narrator": "みやび", "text": "みやびさんのハートがブロークンしたのは仕方のないことと"},
        { "location": "991/TALK"   , "narrator": "みやび", "text": "笑っておくれよベイビー"},
        { "location": "993/SEL"    , "narrator": "", "text": "そんなことしない"},
        { "location": "994/SEL"    , "narrator": "", "text": "ゲラゲラゲラゲラ"},
        { "location": "995/SEL"    , "narrator": "", "text": "明日からがんばろう"},
        { "location": "996/ACT"    , "narrator": "", "text": "そんなことしない"},
        { "location": "997/TALK"   , "narrator": "みやび", "text": "クールなやつだの"},
        { "location": "998/ACT"    , "narrator": "", "text": "ゲラゲラゲラゲラ"},
        { "location": "999/TALK"   , "narrator": "みやび", "text": "素直すぎるぞね"},
        { "location": "1000/ACT"   , "narrator": "", "text": "明日からがんばろう"},
        { "location": "1001/TALK"  , "narrator": "みやび", "text": "その心意気だ"},
        { "location": "1003/TALK"  , "narrator": "みやび", "text": "あとひとつ"},
        { "location": "1004/TALK"  , "narrator": "みやび", "text": "伝えておくことがある"},
        { "location": "1008/TALK"  , "narrator": "みやび", "text": "相棒にはいつも感謝している"},
        { "location": "1009/TALK"  , "narrator": "みやび", "text": "ありがとう"},
        { "location": "1013/TALK"  , "narrator": "みやび", "text": "これからもよろしく頼むぞね"},
        { "location": "1014/TALK"  , "narrator": "みやび", "text": "相棒"},
        { "location": "1026/DIALOG", "narrator": "Dialog_chapter_ch04", "text": "【19 三戸浜からの手紙】"}
    ]
}
