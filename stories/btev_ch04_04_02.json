{
    "dir": "chap04/battle/btev_ch04_04_02.js",
    "type": "",
    "info": {
        "story_id": "24003",
        "cid": "",
        "title": "003 ココロスフィアストーリー【Lv01】",
        "sub_title": "敵Ⅰ＜帰結＞"
    },
    "entry":
    [
        { "location": "240/SCENARIO", "narrator": "", "text": "バトル終了"},
        { "location": "250/TALK"    , "narrator": "潜在みやび", "text": "うっ……\nさすがにしんどいね。"},
        { "location": "251/TALK"    , "narrator": "表層みやび", "text": "がんばりや。\nその演技もあと\n数ワードで終わりやき。"},
        { "location": "252/TALK"    , "narrator": "潜在みやび", "text": "うむ。"},
        { "location": "253/TALK"    , "narrator": "表層みやび", "text": "正直、うちが負けたの\nも全部$handle$が\n参戦したからやき。"},
        { "location": "254/TALK"    , "narrator": "表層みやび", "text": "あの時もっと真剣に\n追い出しておけばと\n後悔しちょるきね…。"},
        { "location": "255/TALK"    , "narrator": "潜在みやび", "text": "負けたのは\nうちや。けんど――"},
        { "location": "256/TALK"    , "narrator": "表層みやび", "text": "うちら二人で見れば、\n二人とも戦いには\n勝ったよやね。"},
        { "location": "257/TALK"    , "narrator": "潜在みやび", "text": "うむ。"},
        { "location": "258/TALK"    , "narrator": "表層みやび", "text": "もう思い残すことは\nないちや。"},
        { "location": "260/TALK"    , "narrator": "潜在みやび", "text": "うちもや。"},
        { "location": "261/TALK"    , "narrator": "表層みやび", "text": "$handle$よ。\n希望を持ったであろう\n我らがみやびを――"},
        { "location": "262/TALK"    , "narrator": "潜在みやび", "text": "よろしく頼んだきね。"},
        { "location": "272/TALK"    , "narrator": "表層みやび", "text": "……。"},
        { "location": "273/SEL"     , "narrator": "（選択肢）", "text": "あれ？　名前変えた！？"},
        { "location": "274/SEL"     , "narrator": "（選択肢）", "text": "あれ？　服着替えた！？"},
        { "location": "275/SEL"     , "narrator": "（選択肢）", "text": "あれ？　フュージョンした！？"},
        { "location": "276/ACT"     , "narrator": "", "text": "あれ？　名前変えた！？"},
        { "location": "277/TALK"    , "narrator": "表層みやび", "text": "さあね。"},
        { "location": "278/ACT"     , "narrator": "", "text": "あれ？　服着替えた！？"},
        { "location": "279/TALK"    , "narrator": "表層みやび", "text": "さあね。"},
        { "location": "280/ACT"     , "narrator": "", "text": "あれ？　フュージョンした！？"},
        { "location": "286/DIALOG"  , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "290/TALK"    , "narrator": "表層みやび", "text": "失礼な。こう見えても\n一応うちは地球人や。\n戦闘民族やないぞね。"},
        { "location": "292/TALK"    , "narrator": "表層みやび", "text": "うちは正真正銘、\nアンタと共に闘って\n勝った方のうちや。"},
        { "location": "293/TALK"    , "narrator": "表層みやび", "text": "まあ、一つだけ\n言えることは――"},
        { "location": "294/TALK"    , "narrator": "表層みやび", "text": "アンタには何一つ、\nうちの真実は見せん\nっちゅうことやね。"},
        { "location": "295/SEL"     , "narrator": "（選択肢）", "text": "それは酷い"},
        { "location": "296/SEL"     , "narrator": "（選択肢）", "text": "現実のみやびが無気力から脱してくれればそれでいい"},
        { "location": "297/ACT"     , "narrator": "", "text": "それは酷い"},
        { "location": "298/TALK"    , "narrator": "表層みやび", "text": "うむ。\nまっこと酷いよや。"},
        { "location": "299/ACT"     , "narrator": "", "text": "現実のみやびが無気力から脱してくれればそれでいい"},
        { "location": "305/DIALOG"  , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "309/TALK"    , "narrator": "表層みやび", "text": "ふむ。\nまっことオメデタイ\n頭をしちょるね。"},
        { "location": "311/TALK"    , "narrator": "表層みやび", "text": "$handle$、\n気づいちょるか？"},
        { "location": "312/TALK"    , "narrator": "表層みやび", "text": "あんたはうちが\nどっちのみやびか\n分かっちょらんき――"},
        { "location": "313/TALK"    , "narrator": "表層みやび", "text": "もしかしたらバトル前\nに入れ替わった頑固系\nうちかもしれんがよ？"},
        { "location": "314/TALK"    , "narrator": "表層みやび", "text": "もしそうやったら――"},
        { "location": "315/TALK"    , "narrator": "表層みやび", "text": "現実のうちには\n今後もアンタの期待する\n変化は起こらない。"},
        { "location": "316/TALK"    , "narrator": "表層みやび", "text": "まさに“一矢報いる”\nってヤツや。"},
        { "location": "317/SEL"     , "narrator": "（選択肢）", "text": "なんでそこまで$me$を嫌うの？"},
        { "location": "318/ACT"     , "narrator": "", "text": "なんでそこまで$me$を嫌うの？"},
        { "location": "320/TALK"    , "narrator": "表層みやび", "text": "別に嫌っちゅう\nわけやないき。"},
        { "location": "321/TALK"    , "narrator": "表層みやび", "text": "ただ単に、\n「敵」っちゅうだけや。"},
        { "location": "322/TALK"    , "narrator": "表層みやび", "text": "やき、安心しいや。"},
        { "location": "324/TALK"    , "narrator": "表層みやび", "text": "まあ、あんたが\nうちを詮索したり――"},
        { "location": "325/SEL"     , "narrator": "（選択肢）", "text": "みやび！うしろうしろ！！"},
        { "location": "326/TALK"    , "narrator": "表層みやび", "text": "ココロクラッキング\nして、うちのヒミツを\n盗んだりせんなら――"},
        { "location": "327/TALK"    , "narrator": "表層みやび", "text": "「敵」とはいえ、\n茶飲み友達くらいの\n感覚でつきあえるきね。"},
        { "location": "328/ACT"     , "narrator": "", "text": "みやび！うしろうしろ！！"},
        { "location": "331/TALK"    , "narrator": "表層みやび", "text": "なんや、うしろって…"},
        { "location": "335/TALK"    , "narrator": "表層みやび", "text": "なっ……！？"},
        { "location": "336/TALK"    , "narrator": "？？？", "text": "ねえ、みやー。\nその人、\nみやの敵なの？"},
        { "location": "337/TALK"    , "narrator": "表層みやび", "text": "ちょ！\nなごちゃ……"},
        { "location": "339/TALK"    , "narrator": "表層みやび", "text": "今出てきよったら\nいかんちや！"},
        { "location": "340/TALK"    , "narrator": "？？？", "text": "でも、みやの敵なら\nなごがあいつを\nやっつけるから"},
        { "location": "341/TALK"    , "narrator": "表層みやび", "text": "えいから…、\n敵いうてもまだ何も\nされちょらんき。"},
        { "location": "342/SEL"     , "narrator": "（選択肢）", "text": "どなたですか？"},
        { "location": "343/SEL"     , "narrator": "（選択肢）", "text": "初めまして！なごちゃん！"},
        { "location": "344/ACT"     , "narrator": "", "text": "どなたですか？"},
        { "location": "347/TALK"    , "narrator": "表層みやび", "text": "あんたには\n関係ないき！"},
        { "location": "348/TALK"    , "narrator": "表層みやび", "text": "もう用は済んじょるろ、\nはよ現実に戻りや！"},
        { "location": "350/TALK"    , "narrator": "？？？", "text": "……。"},
        { "location": "358/TALK"    , "narrator": "表層みやび", "text": "なごちゃん！\nいかんよ！！"},
        { "location": "359/ACT"     , "narrator": "", "text": "初めまして！なごちゃん！"},
        { "location": "362/TALK"    , "narrator": "表層みやび", "text": "！？"},
        { "location": "364/TALK"    , "narrator": "？？？", "text": "……。"},
        { "location": "372/TALK"    , "narrator": "表層みやび", "text": "なごちゃん！\nいかんよ！！"},
        { "location": "373/TALK"    , "narrator": "表層みやび", "text": "あんたももう\n用は済んじょるろ！\nはよ現実に戻りや！"},
        { "location": "376/TALK"    , "narrator": "？？？", "text": "こんどまた\nみやに手ぇ出したら――"},
        { "location": "395/TALK"    , "narrator": "千羽鶴", "text": "さて。"},
        { "location": "396/SEL"     , "narrator": "（選択肢）", "text": "！？"},
        { "location": "397/ACT"     , "narrator": "", "text": "！？"},
        { "location": "399/TALK"    , "narrator": "千羽鶴", "text": "？"},
        { "location": "400/TALK"    , "narrator": "千羽鶴", "text": "どうしたの？"},
        { "location": "401/SEL"     , "narrator": "（選択肢）", "text": "なんかすごいものを見た"},
        { "location": "402/SEL"     , "narrator": "（選択肢）", "text": "えーん、ちーちゃん助けて(;_;)"},
        { "location": "403/ACT"     , "narrator": "", "text": "なんかすごいものを見た"},
        { "location": "405/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "406/ACT"     , "narrator": "", "text": "えーん、ちーちゃん助けて(;_;)"},
        { "location": "412/DIALOG"  , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "416/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "417/TALK"    , "narrator": "千羽鶴", "text": "はーい、よしよし。\n怖かったでちゅね。"},
        { "location": "419/TALK"    , "narrator": "千羽鶴", "text": "…これでいい？"},
        { "location": "420/SEL"     , "narrator": "（選択肢）", "text": "えー"},
        { "location": "421/SEL"     , "narrator": "（選択肢）", "text": "ありがとうございます！"},
        { "location": "422/SEL"     , "narrator": "（選択肢）", "text": "もっとやって！！"},
        { "location": "423/ACT"     , "narrator": "", "text": "えー"},
        { "location": "425/TALK"    , "narrator": "千羽鶴", "text": "不満なのね。\n良く解らない人。"},
        { "location": "427/ACT"     , "narrator": "", "text": "ありがとうございます！"},
        { "location": "428/TALK"    , "narrator": "千羽鶴", "text": "どういたしまして。"},
        { "location": "430/ACT"     , "narrator": "", "text": "もっとやって！！"},
        { "location": "436/DIALOG"  , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "440/TALK"    , "narrator": "千羽鶴", "text": "なるほど。\nあなたのプレイ傾向は\n把握した。"},
        { "location": "444/TALK"    , "narrator": "千羽鶴", "text": "まあ。\n人の心の中に入れば\n普通にあること。"},
        { "location": "445/TALK"    , "narrator": "千羽鶴", "text": "あなたが何を見たかは\nわからないけど、多分\nまだ序の口だと思う。"},
        { "location": "446/TALK"    , "narrator": "千羽鶴", "text": "それくらいに、\n人の心は複雑で無情、\nそして残酷なもの。"},
        { "location": "447/TALK"    , "narrator": "千羽鶴", "text": "覚えておくといいわ。"},
        { "location": "472/TALK"    , "narrator": "千羽鶴", "text": "おめでとう。"},
        { "location": "473/TALK"    , "narrator": "千羽鶴", "text": "あなたは彼女の\nココロの迷いを解消し、\n一歩前進させた。"},
        { "location": "474/SEL"     , "narrator": "（選択肢）", "text": "えっへん"},
        { "location": "475/SEL"     , "narrator": "（選択肢）", "text": "あまり実感ない"},
        { "location": "476/SEL"     , "narrator": "（選択肢）", "text": "本当にこれで良かったのだろうか"},
        { "location": "477/ACT"     , "narrator": "", "text": "えっへん"},
        { "location": "478/TALK"    , "narrator": "千羽鶴", "text": "そうね。\n今回ばかりは\n誇っていいと思う。"},
        { "location": "479/ACT"     , "narrator": "", "text": "あまり実感ない"},
        { "location": "480/TALK"    , "narrator": "千羽鶴", "text": "そうね。\nそう思うかも知れない。\nでも――"},
        { "location": "481/ACT"     , "narrator": "", "text": "本当にこれで良かったのだろうか"},
        { "location": "483/TALK"    , "narrator": "千羽鶴", "text": "選択に絶対的な\n正解なんて最初から\n存在しない。"},
        { "location": "485/TALK"    , "narrator": "千羽鶴", "text": "汚い言い方をすれば、\n利己的な選択をし、\n結果が伴えば正解。"},
        { "location": "486/TALK"    , "narrator": "千羽鶴", "text": "それは申し訳無いけど\n今はあなたも知らない\n私の思惑も含めて。"},
        { "location": "487/TALK"    , "narrator": "千羽鶴", "text": "一般的にも、ダメな\n選択をしたと思ったら\n物事が好転したり――"},
        { "location": "488/TALK"    , "narrator": "千羽鶴", "text": "逆に順当な選択をした\nつもりが、後悔する\n結果になったりもする。"},
        { "location": "489/TALK"    , "narrator": "千羽鶴", "text": "大事なのは\n「自分はどうしたいか」"},
        { "location": "490/TALK"    , "narrator": "千羽鶴", "text": "周囲のノイズを遮断し\n自分で決めること。"},
        { "location": "491/TALK"    , "narrator": "千羽鶴", "text": "私があなたにお願い\nしたいのは、あくまで\nそのサポートなの。"},
        { "location": "493/TALK"    , "narrator": "千羽鶴", "text": "人のココロを動かす\nには、いつも大きな\n力が必要とは限らない。"},
        { "location": "494/TALK"    , "narrator": "千羽鶴", "text": "些細なきっかけを\n与えるだけで、整理が\nつくこともある。"},
        { "location": "495/TALK"    , "narrator": "千羽鶴", "text": "そうやって、逃げずに\n決めて、それを実行\nすることは――"},
        { "location": "496/TALK"    , "narrator": "千羽鶴", "text": "次第にココロを\n強くすることに繋がる。"},
        { "location": "497/SEL"     , "narrator": "（選択肢）", "text": "よくわからない"},
        { "location": "498/ACT"     , "narrator": "", "text": "よくわからない"},
        { "location": "500/TALK"    , "narrator": "千羽鶴", "text": "一気に理解は\n出来ないと思う。"},
        { "location": "501/TALK"    , "narrator": "千羽鶴", "text": "とにかくあなたには、\nこれからもずっと、\n今回の様に――"},
        { "location": "502/TALK"    , "narrator": "千羽鶴", "text": "彼女のココロの成長を\n支援してあげて欲しい。"}
    ]
}
