        "title": "スペシャルエピソード",
        "sub_title": "二人の花嫁"
    },
    "entry":
    [
        { "location": "22/TALK" , "narrator": "透明神楽", "text": "キャー！！\nつばめさん、素敵です！\n素敵過ぎます！"},
        { "location": "23/TALK" , "narrator": "透明つばめ", "text": "ちょ、神楽ちゃん。\n声が大きいよ…。"},
        { "location": "24/TALK" , "narrator": "透明神楽", "text": "だって、つばめさんが\n素敵過ぎるから\n仕方ないじゃないですか。"},
        { "location": "25/TALK" , "narrator": "透明つばめ", "text": "そ、そうかなぁ？\n神楽ちゃんの方が\n素敵だと思うけど…。"},
        { "location": "26/TALK" , "narrator": "透明神楽", "text": "いいえ。\nつばめさんの方が\nもっと可愛いですよ。"},
        { "location": "28/TALK" , "narrator": "透明つばめ", "text": "…ありがと。"},
        { "location": "30/TALK" , "narrator": "透明つばめ", "text": "こんなに素敵なドレス\n着たの初めてだから、\nちょっと心配だったんだ。"},
        { "location": "31/TALK" , "narrator": "透明つばめ", "text": "似合ってなかったら\nどうしよう、って…。"},
        { "location": "32/TALK" , "narrator": "透明神楽", "text": "心配無用です。\n本物のお嫁さんに\n見えますよ。"},
        { "location": "34/TALK" , "narrator": "透明つばめ", "text": "えへへ…恥ずかしいけど、\n嬉しいな…。"},
        { "location": "35/TALK" , "narrator": "透明つばめ", "text": "そうだ、あとで一緒に\n記念写真撮ろ？"},
        { "location": "36/TALK" , "narrator": "透明神楽", "text": "もちろんです。\nつばめさんの写真、\n待ち受けにしますね。"},
        { "location": "39/TALK" , "narrator": "透明つばめ", "text": "そ、それはちょっと\n恥ずかし過ぎるかも…。"},
        { "location": "40/TALK" , "narrator": "透明神楽", "text": "…っていうか、\n正直記念写真よりも、\nしたいことがあるんです。"},
        { "location": "41/TALK" , "narrator": "透明つばめ", "text": "したいこと？"},
        { "location": "43/TALK" , "narrator": "透明神楽", "text": "はい…つばめさんと、\nこのまま結婚式を\n挙げちゃおうかな、って。"},
        { "location": "46/TALK" , "narrator": "透明つばめ", "text": "え…えぇっ！？"},
        { "location": "47/TALK" , "narrator": "透明神楽", "text": "っていうか、これって\nいいタイミングだと\n思いませんか？"},
        { "location": "48/TALK" , "narrator": "透明神楽", "text": "お互いにウエディング\nドレス着て、準備完了の\n状態なんですし。"},
        { "location": "49/TALK" , "narrator": "透明神楽", "text": "このままチャペルで\n誓いの言葉を言っても\n変じゃないと思うんです。"},
        { "location": "50/TALK" , "narrator": "透明つばめ", "text": "ちょ、神楽ちゃん！？\nわたしたち女の子同士\nなんだけど…。"},
        { "location": "51/TALK" , "narrator": "透明神楽", "text": "式を挙げるだけなら、\n問題ありません。"},
        { "location": "52/TALK" , "narrator": "透明神楽", "text": "本当に婚姻届けを出す\nわけじゃないんですから、\n気にすることないですよ。"},
        { "location": "56/TALK" , "narrator": "透明つばめ", "text": "気にするよぉ！"},
        { "location": "57/TALK" , "narrator": "透明神楽", "text": "ふふっ…、\nそういうところも、\n可愛いところですよ。"},
        { "location": "58/TALK" , "narrator": "透明つばめ", "text": "え？"},
        { "location": "59/TALK" , "narrator": "透明神楽", "text": "すぐ冗談を本気にしちゃう\nところですよ。"},
        { "location": "60/TALK" , "narrator": "透明つばめ", "text": "も、もぉ！\nまたわたしのこと\nからかって…。"},
        { "location": "62/TALK" , "narrator": "透明神楽", "text": "ふふっ、ごめんなさい。"},
        { "location": "63/TALK" , "narrator": "透明つばめ", "text": "もぉ…。"},
        { "location": "65/TALK" , "narrator": "透明つばめ", "text": "…そうだ。\n$handle$さんにも\n見てもらおっと。"},
        { "location": "68/TALK" , "narrator": "つばめ", "text": "$handle$さーんヽ(*´∀｀)ノ"},
        { "location": "69/TALK" , "narrator": "つばめ", "text": "見てみて"},
        { "location": "70/TALK" , "narrator": "つばめ", "text": "どぅかな？(´ω｀*)"},
        { "location": "71/TALK" , "narrator": "つばめ", "text": "ゥェディングドレス"},
        { "location": "72/TALK" , "narrator": "つばめ", "text": "初めて着てみたのヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "73/SEL"  , "narrator": "（選択肢）", "text": "素敵だよ"},
        { "location": "74/SEL"  , "narrator": "（選択肢）", "text": "着たことあったらビックリだよ"},
        { "location": "75/SEL"  , "narrator": "（選択肢）", "text": "幸せにするよ"},
        { "location": "76/ACT"  , "narrator": "", "text": "素敵だよ"},
        { "location": "77/TALK" , "narrator": "つばめ", "text": "ぁりがと(*≧∀≦*) "},
        { "location": "79/TALK" , "narrator": "つばめ", "text": "$handle$さんにも"},
        { "location": "80/TALK" , "narrator": "つばめ", "text": "見せてよかった(≧艸≦*)"},
        { "location": "81/ACT"  , "narrator": "", "text": "着たことあったらビックリだよ"},
        { "location": "82/TALK" , "narrator": "つばめ", "text": "そぅだよね(･Д･｀)"},
        { "location": "83/TALK" , "narrator": "つばめ", "text": "試着だけど"},
        { "location": "84/TALK" , "narrator": "つばめ", "text": "今着てる自分に"},
        { "location": "85/TALK" , "narrator": "つばめ", "text": "わたしもビックリしてるし"},
        { "location": "86/ACT"  , "narrator": "", "text": "幸せにするよ"},
        { "location": "89/TALK" , "narrator": "つばめ", "text": "もぅ"},
        { "location": "90/TALK" , "narrator": "つばめ", "text": "冗談だよね？(･Д･｀)"},
        { "location": "91/TALK" , "narrator": "つばめ", "text": "もし本気だったら"},
        { "location": "93/TALK" , "narrator": "つばめ", "text": "そぅだったら"},
        { "location": "95/TALK" , "narrator": "つばめ", "text": "嬉しぃな"},
        { "location": "98/TALK" , "narrator": "つばめ", "text": "でも"},
        { "location": "99/TALK" , "narrator": "つばめ", "text": "不思議な気分(´・ω・`) "},
        { "location": "101/TALK", "narrator": "つばめ", "text": "結婚するわけじゃなぃのに"},
        { "location": "102/TALK", "narrator": "つばめ", "text": "ゥェディングドレス着てるなんて(*´﹃｀*)"},
        { "location": "103/SEL" , "narrator": "（選択肢）", "text": "着たいとは思ってたの？"},
        { "location": "104/SEL" , "narrator": "（選択肢）", "text": "毎日でも見たいくらいだ"},
        { "location": "105/ACT" , "narrator": "", "text": "着たいとは思ってたの？"},
        { "location": "106/TALK", "narrator": "つばめ", "text": "よくわからなぃ(´･ω･｀) "},
        { "location": "107/TALK", "narrator": "つばめ", "text": "結婚とか"},
        { "location": "108/TALK", "narrator": "つばめ", "text": "考えたことなかったから(･Д･｀)"},
        { "location": "109/TALK", "narrator": "つばめ", "text": "綺麗とは思ってたけど"},
        { "location": "110/TALK", "narrator": "つばめ", "text": "着たぃとは"},
        { "location": "111/TALK", "narrator": "つばめ", "text": "思わなかったかも_(┐「ε:)_"},
        { "location": "112/ACT" , "narrator": "", "text": "毎日でも見たいくらいだ"},
        { "location": "113/TALK", "narrator": "つばめ", "text": "それだと"},
        { "location": "114/TALK", "narrator": "つばめ", "text": "特別な感じしなくなっちゃって"},
        { "location": "115/TALK", "narrator": "つばめ", "text": "本番で"},
        { "location": "116/TALK", "narrator": "つばめ", "text": "ドキドキしなくなっちゃぅかも(o´Д`)=з"},
        { "location": "117/SEL" , "narrator": "（選択肢）", "text": "結婚に憧れはあるみたいだね"},
        { "location": "118/ACT" , "narrator": "", "text": "結婚に憧れはあるみたいだね"},
        { "location": "121/TALK", "narrator": "つばめ", "text": "本当だ(ﾟ△ﾟ;ﾉ)ﾉ"},
        { "location": "122/TALK", "narrator": "つばめ", "text": "ドキドキしたぃのは"},
        { "location": "123/TALK", "narrator": "つばめ", "text": "結婚式したぃって気持ち"},
        { "location": "125/TALK", "narrator": "つばめ", "text": "ぁるからだよね"},
        { "location": "127/TALK", "narrator": "つばめ", "text": "でも"},
        { "location": "128/TALK", "narrator": "つばめ", "text": "本当にわたしも"},
        { "location": "129/TALK", "narrator": "つばめ", "text": "結婚できるのかな？(o´Д`)=з"},
        { "location": "131/TALK", "narrator": "つばめ", "text": "想像できなぃかも(･Д･｀)"},
        { "location": "132/TALK", "narrator": "つばめ", "text": "式場で"},
        { "location": "133/TALK", "narrator": "つばめ", "text": "結婚式を挙げてる自分が(´つω・｀)ｼｭﾝ"},
        { "location": "134/SEL" , "narrator": "（選択肢）", "text": "$me$を思い浮かべればきっと想像できるよ！"},
        { "location": "135/SEL" , "narrator": "（選択肢）", "text": "何であれ、まだ早いよ"},
        { "location": "136/ACT" , "narrator": "", "text": "$me$を思い浮かべればきっと想像できるよ！"},
        { "location": "139/TALK", "narrator": "つばめ", "text": "ちょっとやってみるね(*´ω｀*)"},
        { "location": "142/TALK", "narrator": "つばめ", "text": "やってみたょ～～～ (*´∀`*)"},
        { "location": "143/TALK", "narrator": "つばめ", "text": "とってもしぁわせそうなわたしがいたょ(/ω＼)(/ω＼)ﾊｽﾞｶｼｰｨ"},
        { "location": "144/TALK", "narrator": "つばめ", "text": "$handle$さんはどぅかわかんないけど"},
        { "location": "145/TALK", "narrator": "つばめ", "text": "ゎたしは早く$handle$さんにココに来てほしぃなヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "146/TALK", "narrator": "つばめ", "text": "わたしちょっと"},
        { "location": "147/TALK", "narrator": "つばめ", "text": "楽しみに思ってるみたぃ(´ω｀*)"},
        { "location": "148/ACT" , "narrator": "", "text": "何であれ、まだ早いよ"},
        { "location": "150/TALK", "narrator": "つばめ", "text": "そぅだよね(´･ω･｀) "},
        { "location": "151/TALK", "narrator": "つばめ", "text": "まだ高校生だし(●´ω｀●)ゞ"},
        { "location": "152/TALK", "narrator": "つばめ", "text": "それに"},
        { "location": "153/TALK", "narrator": "つばめ", "text": "今結婚なんて話が出たら"},
        { "location": "154/TALK", "narrator": "つばめ", "text": "ぉ父さん"},
        { "location": "155/TALK", "narrator": "つばめ", "text": "絶対爆発しちゃぅ(o´Д`)=з"},
        { "location": "156/SEL" , "narrator": "（選択肢）", "text": "想像するのが怖い"},
        { "location": "157/ACT" , "narrator": "", "text": "想像するのが怖い"},
        { "location": "161/TALK", "narrator": "つばめ", "text": "ぅん(´･ω･｀) "},
        { "location": "162/TALK", "narrator": "つばめ", "text": "でも"},
        { "location": "163/TALK", "narrator": "つばめ", "text": "そぅならなぃくらぃ"},
        { "location": "164/TALK", "narrator": "つばめ", "text": "わたしが大人になったら"},
        { "location": "165/TALK", "narrator": "つばめ", "text": "その時は$handle$さんが (*´∀`*)"},
        { "location": "167/TALK", "narrator": "つばめ", "text": "ぅぅん"},
        { "location": "168/TALK", "narrator": "つばめ", "text": "なんでもなぃ(●´ω｀●)ゞｴﾍﾍ"},
        { "location": "170/TALK", "narrator": "つばめ", "text": "それじゃ"},
        { "location": "171/TALK", "narrator": "つばめ", "text": "また夜にね(*´︶`*)"},
        { "location": "175/TALK", "narrator": "透明つばめ", "text": "…よかった。"},
        { "location": "176/TALK", "narrator": "透明つばめ", "text": "$handle$さんに、\nウェディングドレス\n見てもらえて…。"},
        { "location": "178/TALK", "narrator": "透明神楽", "text": "？　どうかしましたか？\nなんだか、とっても\nご機嫌のようですが…。"},
        { "location": "179/TALK", "narrator": "透明つばめ", "text": "えへへ…内緒だよ。"}
    ]
