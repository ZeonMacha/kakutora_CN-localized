{
    "dir": "chap18/daydra/dd_ch03_18_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "18352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "夢のバイト"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "夢のバイト"},
        { "location": "21/TALK"   , "narrator": "雛", "text": "…いいなぁ。"},
        { "location": "23/TALK"   , "narrator": "つばめ", "text": "ん、どうしたの？"},
        { "location": "24/TALK"   , "narrator": "雛", "text": "ここのウェイトレスさんの\nことだよ。"},
        { "location": "25/TALK"   , "narrator": "雛", "text": "あんな可愛い制服着て\n働けたら、毎日楽しい\nだろうなぁ…。"},
        { "location": "26/TALK"   , "narrator": "繭", "text": "ここの制服は、\n都内の可愛い制服の\n喫茶店ランキングで――"},
        { "location": "27/TALK"   , "narrator": "繭", "text": "ベスト５に入る店よ。"},
        { "location": "29/TALK"   , "narrator": "ガブリエラ", "text": "何でそんなこと\n知ってるのよ？"},
        { "location": "32/TALK"   , "narrator": "繭", "text": "…ネットの記事で\n見ただけ。"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "ふ～ん…でもまあ、\nわからなくはないわね。"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "メイド服みたいに\n男受けを狙ったデザイン、\nってわけでもないし――"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "かといって、\n変に地味でもない\nオシャレな制服だし。"},
        { "location": "41/TALK"   , "narrator": "雛", "text": "…あ、バイトの\n募集してるじゃん！"},
        { "location": "43/TALK"   , "narrator": "雛", "text": "思い切って応募して\nみようかなー？"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "いいなぁ…。\nわたしも、ちょっと\n着てみたいかも。"},
        { "location": "46/TALK"   , "narrator": "雛", "text": "じゃあ、つばめちゃんも\n一緒にバイトの面接\n受けてみようよ。"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "うん！"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "うん、じゃないでしょ！"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "あんたは劇場の仕事が\nあるんだし――"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "それに…いつ出動要請が\nくるかわからないのよ？"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "わかってるけど…\nやっぱり、憧れるよぉ…。"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "憧れるだけで\n我慢しなさい。"},
        { "location": "58/TALK"   , "narrator": "雛", "text": "もぉ、ガブリエラちゃんは\nクールだなぁ…。"},
        { "location": "61/TALK"   , "narrator": "繭", "text": "ここの制服、\n似合いそうなのに。"},
        { "location": "62/TALK"   , "narrator": "繭", "text": "ていうか、ガブリエラは\nベタなメイド服よりも、\nこっちの方が断然萌え！"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "66/TALK"   , "narrator": "雛", "text": "でも、意外とまゆちんも\n似合いそうだよねー。"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "まゆちんは大人っぽい\n雰囲気あるから、\nかっこよくなりそうかも！"},
        { "location": "70/TALK"   , "narrator": "繭", "text": "そ、そう？"},
        { "location": "71/TALK"   , "narrator": "雛", "text": "そうだよー。\nあ、でもでも――"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "…制服かぁ。"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "口ではあんなこと言ったけど"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "私もね、本当は可愛い制服を着てみたいと思ってるの"},
        { "location": "89/SEL"    , "narrator": "", "text": "言えばよかったのに"},
        { "location": "90/ACT"    , "narrator": "", "text": "言えばよかったのに"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "言葉に出したら、着たい気持ちが大きくなっちゃうわ"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "だから言わないようにしてるの"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "あ～あ、トライナリーやってると、不便なこと多いなぁ…"},
        { "location": "96/SEL"    , "narrator": "", "text": "劇場の制服ってないの？"},
        { "location": "97/SEL"    , "narrator": "", "text": "非常勤とかないのかな？"},
        { "location": "98/ACT"    , "narrator": "", "text": "劇場の制服ってないの？"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "…懐かしいことを思い出したわ"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "…制服といえばだけど。"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "あたしが劇場で働き\n始めた頃のことだけど――"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "可愛い制服を作って\nほしいって、まほに\n言ったことがあるの。"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "そうだったの！？"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "まあ、予算がないから\n制服じゃなくて――"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "まほが自腹でジャージを\n買おうとしたから、\n慌てて止めたんだけど。"},
        { "location": "123/TALK"  , "narrator": "雛", "text": "…それ、止めて\n正解だったよ。"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "もしガブちゃんが止めて\nくれなかったら――"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "今頃、わたしもジャージで\n働いてたんだね？"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "そういうこと。"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "トライナリーの一員で\nある以上は、可愛い制服\nとは無縁なの。"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "だから、さっさと\n諦めた方が賢明よ。"},
        { "location": "133/TALK"  , "narrator": "つばめ", "text": "…しょんぼりだよぉ。"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "…あたしも、ジャージを\n買われそうになった時は\nしょんぼりしたなぁ…。"},
        { "location": "136/ACT"   , "narrator": "", "text": "非常勤とかないのかな？"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "あったとしても、私達はできないわ"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "仕事中に出撃要請が来ることも考えられるし…"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "そうなったら、お店に迷惑がかかっちゃうもの"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、あれね。"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "可愛い制服を着られる\n仕事をしたいなら――"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "さっさとフェノメノンを\nどうにかする以外に、\n方法はないわ。"},
        { "location": "155/TALK"  , "narrator": "雛", "text": "…あ、そっか。"},
        { "location": "156/TALK"  , "narrator": "雛", "text": "フェノメノン関係の\n事件が起こらなく\nなれば――"},
        { "location": "157/TALK"  , "narrator": "雛", "text": "トライナリーも解散に\nなるし、劇場で働く\n必要もなくなるんだ？"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "そういうことよ。"},
        { "location": "162/TALK"  , "narrator": "繭", "text": "自由が欲しければ\n勝利せよ、ってこと？"},
        { "location": "164/TALK"  , "narrator": "つばめ", "text": "あはは、その言い方だと\nかっこよくていいかも。"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "でも、実際のとこ\n自由が欲しければ\n勝つ以外ないのは本当よ。"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "じゃなきゃ、あたし達は\n東京からあまり離れる\nこともできないんだし。"},
        { "location": "169/TALK"  , "narrator": "雛", "text": "…大変なんだね、\nトライナリーって。"},
        { "location": "172/TALK"  , "narrator": "つばめ", "text": "…けど、決めたよ。"},
        { "location": "173/TALK"  , "narrator": "つばめ", "text": "わたしも、いつかは\n可愛い制服を着れる\nお仕事したいから――"},
        { "location": "174/TALK"  , "narrator": "つばめ", "text": "そのためにも、\n今まで以上に今の仕事を\n頑張るよ！"},
        { "location": "177/TALK"  , "narrator": "雛", "text": "さすがつばめちゃん。\n応援してるよー！"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "世界平和のために、くらい\n言いなさいよ。\n目標が小さいわね。"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "…でも、いつかは\n可愛い制服を着れる\nお仕事に就いてみたいな。"},
        { "location": "20/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月15日　3:38 PM</color>\nとある平日の午後、都内某所のカフェにて。"}
    ]
}
