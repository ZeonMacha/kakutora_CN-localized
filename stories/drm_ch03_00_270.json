    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "270_恋愛以前"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "すごく不思議なのよね"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "雛は恋愛が苦手なんですって"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "う～ん・・・"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと違うわね"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "周りの恋愛話は大好きだけど、自分自身のは苦手なんですって"},
        { "location": "38/SEL"    , "narrator": "", "text": "そういう人いるよね"},
        { "location": "39/SEL"    , "narrator": "", "text": "$handle$もそうかも"},
        { "location": "40/SEL"    , "narrator": "", "text": "ガブと$handle$の恋愛なら大歓迎"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "どう思う？"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "不思議じゃないこと？"},
        { "location": "46/ACT"    , "narrator": "", "text": "そういう人いるよね"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "そういうものなの？"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "ふ～ん"},
        { "location": "50/ACT"    , "narrator": "", "text": "$handle$もそうかも"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "それは少し困っちゃうわ"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "むしろその方が相談しやすくていいかしら"},
        { "location": "54/ACT"    , "narrator": "", "text": "ガブと$handle$の恋愛なら大歓迎"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "だから何度も言っているけど"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "貴方は！！！！"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "そういうんじゃないんだから！！"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "それでね"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "雛は"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "相談だったら聞きたいし、アドバイスはしたいみたいなの"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "でも自分自身はそういうのは嫌なんですって"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "そんな女の子もいるのね・・・・"},
        { "location": "75/SEL"    , "narrator": "", "text": "いろんな人がいるからね"},
        { "location": "76/SEL"    , "narrator": "", "text": "一番かわいいのはガブリエラだよ"},
        { "location": "77/ACT"    , "narrator": "", "text": "いろんな人がいるからね"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "そうみたいね"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "だから私には"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "$handle$が必要だって思ったのよ"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "あっ"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "使用人としてね？"},
        { "location": "83/ACT"    , "narrator": "", "text": "一番かわいいのはガブリエラだよ"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "貴方はいつもそうなんだから"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "もっと他の言い方はないのかしら"},
        { "location": "96/SEL"    , "narrator": "", "text": "世界で一番かわいいよ"},
        { "location": "97/SEL"    , "narrator": "", "text": "$me$の言うことが信じられないのかい？"},
        { "location": "98/SEL"    , "narrator": "", "text": "妄想の中では超絶かわいいことになってる"},
        { "location": "99/ACT"    , "narrator": "", "text": "世界で一番かわいいよ"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "さっきとあんまり変わっていなくてよ？"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "でも//////////////"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "少しはいいわ/////////////"},
        { "location": "103/ACT"   , "narrator": "", "text": "$me$の言うことが信じられないのかい？"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "えっ////////////////"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "やだちょっと"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "カッコいい/////////////////"},
        { "location": "107/ACT"   , "narrator": "", "text": "妄想の中では超絶かわいいことになってる"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "妄想？？？"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "いみがわからないわよ？？？"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "どういうことなのかしら？？？？？"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "まあいいわ"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "これからは雛にも相談できそうだし"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "貴方も使用人として頑張って頂戴ね"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "期待しているわよ？"},
        { "location": "121/TALK"  , "narrator": "ボイスメール", "text": "義務だから"},
        { "location": "60/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>700pt.</b></color></size>\nアップしました！"},
        { "location": "89/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>700pt.</b></color></size>\nアップしました！"},
        { "location": "133/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【ガブリエラ】</color>のボイスメール\n<color=red>【義務だから】</color>\nをゲットしました！"}
