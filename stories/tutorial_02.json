{
    "dir": "tutorial/tutorial_02.js",
    "type": "MainStory",
    "info": {
        "story_id": "3",
        "cid": "all",
        "title": "003 チュートリアル　STEP 3",
        "sub_title": "バトル解説"
    },
    "entry":
    [
        { "location": "1253/SCENARIO", "narrator": "", "text": "チュートリアル_バトル紹介"},
        { "location": "1268/TALK"    , "narrator": "千羽鶴", "text": "最後に心への干渉に\nついて実践してみよう\nと思う。"},
        { "location": "1269/TALK"    , "narrator": "千羽鶴", "text": "私が貴方にお願いしたい\n一番の理由がこれ。"},
        { "location": "1270/TALK"    , "narrator": "千羽鶴", "text": "貴方はこのアプリを\n介して、彼女たちの心に\n直接入ることができる。"},
        { "location": "1271/TALK"    , "narrator": "千羽鶴", "text": "それは、異世界の\n存在である貴方にしか\nできないこと。"},
        { "location": "1272/TALK"    , "narrator": "千羽鶴", "text": "貴方には、この機能を\n活用して、是非心の内側\nからも支えてほしい。"},
        { "location": "1273/SEL"     , "narrator": "", "text": "どうやって支えるの？"},
        { "location": "1274/SEL"     , "narrator": "", "text": "説明はいらない\n<color=blue>（※バトルの解説を\n　　スキップします）</color>"},
        { "location": "1275/ACT"     , "narrator": "", "text": "どうやって支えるの？"},
        { "location": "1276/TALK"    , "narrator": "千羽鶴", "text": "倣うより慣れろ。\n実戦で教える。"},
        { "location": "1277/TALK"    , "narrator": "千羽鶴", "text": "準備はいい？"},
        { "location": "1278/ACT"     , "narrator": "", "text": "説明はいらない\n<color=blue>（※バトルの解説を\n　　スキップします）</color>"},
        { "location": "1279/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1280/TALK"    , "narrator": "千羽鶴", "text": "じゃあ、今は\n説明はしない。\n自分で頑張ってみて。"},
        { "location": "1281/TALK"    , "narrator": "千羽鶴", "text": "わからなくなったら\n後でメニューから\nこの説明を見られる。"},
        { "location": "1282/TALK"    , "narrator": "千羽鶴", "text": "その方法は、\n後で教える。"},
        { "location": "1284/TALK"    , "narrator": "千羽鶴", "text": "それじゃ早速、\nココロの中へ向かう。"},
        { "location": "1285/TALK"    , "narrator": "千羽鶴", "text": "構えて！"},
        { "location": "1289/SEL"     , "narrator": "", "text": "もちろん！"},
        { "location": "1290/SEL"     , "narrator": "", "text": "やっぱりちょっと待って！"},
        { "location": "1291/ACT"     , "narrator": "", "text": "もちろん！"},
        { "location": "1292/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1293/ACT"     , "narrator": "", "text": "やっぱりちょっと待って！"},
        { "location": "1294/TALK"    , "narrator": "千羽鶴", "text": "やだ。\nもうとっくに５分\n過ぎてる気がするし。"},
        { "location": "1297/TALK"    , "narrator": "千羽鶴", "text": "それじゃ早速\n[ダイブ]してみる。"},
        { "location": "1298/TALK"    , "narrator": "千羽鶴", "text": "トライコネクト――"},
        { "location": "1317/TALK"    , "narrator": "千羽鶴", "text": "ようこそ、\n私とあなたの戦場へ。"},
        { "location": "1318/SEL"     , "narrator": "", "text": "ここは？"},
        { "location": "1319/ACT"     , "narrator": "", "text": "ここは？"},
        { "location": "1321/TALK"    , "narrator": "千羽鶴", "text": "ここは“とある人物”の\nココロの中。"},
        { "location": "1322/TALK"    , "narrator": "千羽鶴", "text": "攻略対象の彼女たちの\n心の中ではない。"},
        { "location": "1323/SEL"     , "narrator": "", "text": "どうして別の人なの？"},
        { "location": "1324/SEL"     , "narrator": "", "text": "じゃあ誰なの？"},
        { "location": "1325/ACT"     , "narrator": "", "text": "どうして別の人なの？"},
        { "location": "1326/TALK"    , "narrator": "千羽鶴", "text": "いきなり彼女たちの心に\n入って、もしあなたが\nヘマしたら傷を作る。"},
        { "location": "1327/TALK"    , "narrator": "千羽鶴", "text": "それは今後の関係に\nとって、かなり\n良くない事になる。"},
        { "location": "1328/TALK"    , "narrator": "千羽鶴", "text": "だからまずは\n練習用フィールドを\n用意した。"},
        { "location": "1329/ACT"     , "narrator": "", "text": "じゃあ誰なの？"},
        { "location": "1330/TALK"    , "narrator": "千羽鶴", "text": "あなたに言っても\nわからないでしょう？"},
        { "location": "1331/TALK"    , "narrator": "千羽鶴", "text": "私の知り合いだから\n心配しないで。"},
        { "location": "1333/TALK"    , "narrator": "千羽鶴", "text": "それでは早速、\n心への干渉を実戦で\n教えていく。"},
        { "location": "1336/TALK"    , "narrator": "千羽鶴", "text": "時にあなた、\n<color=purple>【天使と悪魔】</color>の\n例え話、知ってる？"},
        { "location": "1337/SEL"     , "narrator": "", "text": "知ってる"},
        { "location": "1338/SEL"     , "narrator": "", "text": "知らない"},
        { "location": "1339/ACT"     , "narrator": "", "text": "知ってる"},
        { "location": "1340/TALK"    , "narrator": "千羽鶴", "text": "それなら話が早い。"},
        { "location": "1341/ACT"     , "narrator": "", "text": "知らない"},
        { "location": "1342/TALK"    , "narrator": "千羽鶴", "text": "人の心の葛藤を\n天使と悪魔で表現する\n例えのこと。"},
        { "location": "1343/TALK"    , "narrator": "千羽鶴", "text": "例えば、ケーキが食べ\nたい、でも肥っちゃう！\nみたいなとき――"},
        { "location": "1344/TALK"    , "narrator": "千羽鶴", "text": "食べたい気持ち＝悪魔\n我慢したい気持ち＝天使\nという風に表現する。"},
        { "location": "1346/TALK"    , "narrator": "千羽鶴", "text": "その<color=purple>【天使と悪魔】</color>の\n戦いに、あなたが介入\nすることができる。"},
        { "location": "1347/TALK"    , "narrator": "千羽鶴", "text": "とは言っても、\n基本的には彼女が本当に\nしたいこと――"},
        { "location": "1348/TALK"    , "narrator": "千羽鶴", "text": "すなわち、<color=purple>【天使】</color>側に\n傾くように、支援して\nあげるという感じ。"},
        { "location": "1349/TALK"    , "narrator": "千羽鶴", "text": "それによって、\nあなたと彼女との関係は\n間違いなく進展する。"},
        { "location": "1350/TALK"    , "narrator": "千羽鶴", "text": "そういう風に\nできているから。"},
        { "location": "1352/TALK"    , "narrator": "千羽鶴", "text": "ここまで、大丈夫？"},
        { "location": "1353/SEL"     , "narrator": "", "text": "大丈夫！"},
        { "location": "1354/SEL"     , "narrator": "", "text": "もう一度"},
        { "location": "1355/ACT"     , "narrator": "", "text": "大丈夫！"},
        { "location": "1356/ACT"     , "narrator": "", "text": "もう一度"},
        { "location": "1357/TALK"    , "narrator": "千羽鶴", "text": "ええ、何度でも。"},
        { "location": "1358/TALK"    , "narrator": "千羽鶴", "text": "これから精神操作の\nやり方を、実戦で\nあなたに教える。"},
        { "location": "1365/SEL"     , "narrator": "", "text": "なんだ？"},
        { "location": "1366/ACT"     , "narrator": "", "text": "なんだ？"},
        { "location": "1368/TALK"    , "narrator": "千羽鶴", "text": "大丈夫。\n心配しないで。"},
        { "location": "1371/TALK"    , "narrator": "千羽鶴", "text": "ちょっと<color=red>[クラン]</color>が\n暴れてるだけだから。"},
        { "location": "1373/SEL"     , "narrator": "", "text": "クランってなに？"},
        { "location": "1374/ACT"     , "narrator": "", "text": "クランってなに？"},
        { "location": "1376/TALK"    , "narrator": "千羽鶴", "text": "[クラン]は、心の中に\n存在する人格の１つ。"},
        { "location": "1377/TALK"    , "narrator": "千羽鶴", "text": "例えばさっきの\nケーキの例で言えば――"},
        { "location": "1378/TALK"    , "narrator": "千羽鶴", "text": "「食べたい！」\nと思う[クラン]と、"},
        { "location": "1379/TALK"    , "narrator": "千羽鶴", "text": "「我慢しなくちゃ！」\nと思う[クラン]がいて、\n戦っているというわけ。"},
        { "location": "1380/TALK"    , "narrator": "千羽鶴", "text": "人間の葛藤は、心の中\nでの[クラン]同士の戦い、\nということになる。"},
        { "location": "1384/TALK"    , "narrator": "千羽鶴", "text": "気をつけて。\n[クラン]がここに来る。"},
        { "location": "1385/TALK"    , "narrator": "千羽鶴", "text": "自分が排除されようと\nしていることを、\n察知したみたい。"},
        { "location": "1397/TALK"    , "narrator": "千羽鶴", "text": "この子が\n今回の[クラン]ね。"},
        { "location": "1398/SEL"     , "narrator": "", "text": "なんかだいぶ強そうなんですけど！"},
        { "location": "1399/ACT"     , "narrator": "", "text": "なんかだいぶ強そうなんですけど！"},
        { "location": "1403/TALK"    , "narrator": "千羽鶴", "text": "大丈夫。今回は私の\n力があるから、絶対に\n負けることはない。"},
        { "location": "1404/TALK"    , "narrator": "千羽鶴", "text": "それじゃ今から\nこの子で実戦をしながら\n戦い方を教える。"},
        { "location": "1405/TALK"    , "narrator": "千羽鶴", "text": "心配しなくても大丈夫。"},
        { "location": "1406/TALK"    , "narrator": "千羽鶴", "text": "普通のロールプレイング\nゲームのターン制バトル\nの要領で――"},
        { "location": "1407/TALK"    , "narrator": "千羽鶴", "text": "目の前にいる[クラン]を\n倒せば解決するから。"},
        { "location": "1408/TALK"    , "narrator": "千羽鶴", "text": "準備はいい？"},
        { "location": "1409/SEL"     , "narrator": "", "text": "はい"},
        { "location": "1410/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "1411/ACT"     , "narrator": "", "text": "はい"},
        { "location": "1412/TALK"    , "narrator": "千羽鶴", "text": "おっけー。"},
        { "location": "1415/TALK"    , "narrator": "千羽鶴", "text": "それでは、\n攻撃開始。"},
        { "location": "1416/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "1417/TALK"    , "narrator": "千羽鶴", "text": "といわれても\nもう無理。"},
        { "location": "1419/TALK"    , "narrator": "千羽鶴", "text": "申し訳無いけど、\n無理矢理攻撃開始。"}
    ]
}
