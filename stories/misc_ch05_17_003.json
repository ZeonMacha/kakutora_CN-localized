        { "location": "5351/SCENARIO", "narrator": "", "text": "漆黒の初恋（とか"},
        { "location": "5376/TALK"    , "narrator": "神楽", "text": "漆黒の髪"},
        { "location": "5377/TALK"    , "narrator": "神楽", "text": "漆黒の駿馬"},
        { "location": "5378/TALK"    , "narrator": "神楽", "text": "漆黒の初恋"},
        { "location": "5380/SEL"     , "narrator": "", "text": "どんなんだ！"},
        { "location": "5381/SEL"     , "narrator": "", "text": "神楽の恋の色か…"},
        { "location": "5382/ACT"     , "narrator": "", "text": "どんなんだ！"},
        { "location": "5383/TALK"    , "narrator": "神楽", "text": "そういうツッコミを期待してた"},
        { "location": "5384/ACT"     , "narrator": "", "text": "神楽の恋の色か…"},
        { "location": "5386/TALK"    , "narrator": "神楽", "text": "そうこれはぴょんこの恋の色"},
        { "location": "5388/TALK"    , "narrator": "神楽", "text": "ってどんだけ？？？？"},
        { "location": "5389/TALK"    , "narrator": "神楽", "text": "でも$handlek$はそういうぴょんこのことを愛してるんでしょ？？？"},
        { "location": "5390/TALK"    , "narrator": "神楽", "text": "ぴょんこ、信じてるから、、、"},
        { "location": "5391/TALK"    , "narrator": "神楽", "text": "裏切ったら、、、ううん、、、そんなこと、、、しないよ、、、ね？"},
        { "location": "5393/TALK"    , "narrator": "神楽", "text": "ところで黒い髪は烏の濡れ羽色"},
        { "location": "5394/TALK"    , "narrator": "神楽", "text": "黒い馬は青毛っていうらしいぴょん"},
        { "location": "5396/SEL"     , "narrator": "", "text": "詳しいね"},
        { "location": "5397/SEL"     , "narrator": "", "text": "そんくらい知ってるし！"},
        { "location": "5398/ACT"     , "narrator": "", "text": "詳しいね"},
        { "location": "5400/TALK"    , "narrator": "神楽", "text": "気になったから調べただけ☆彡"},
        { "location": "5401/TALK"    , "narrator": "神楽", "text": "$handlek$は誉め上手ぴょん♪"},
        { "location": "5402/ACT"     , "narrator": "", "text": "そんくらい知ってるし！"},
        { "location": "5403/TALK"    , "narrator": "神楽", "text": "へーそー？"},
        { "location": "5405/TALK"    , "narrator": "神楽", "text": "さすがに漆黒の初恋に相当する表現はなかったぴょん"},
        { "location": "5406/TALK"    , "narrator": "神楽", "text": "ぴょんこが新しい表現を定着させるしかないかもー？"},
        { "location": "5407/TALK"    , "narrator": "神楽", "text": "なんてね。"}
    ]
