{
    "dir": "chap23/daydra/dd_ch02_23_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "23202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "迷いは＜前編＞"
    },
    "entry":
    [
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "59/SEL"    , "narrator": "", "text": "空気が重いね"},
        { "location": "60/ACT"    , "narrator": "", "text": "空気が重いね"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "仕方ない"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "神楽がスパイで"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "私たちの敵だったから"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "みんな"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "ショックが大きいのよ"},
        { "location": "81/SEL"    , "narrator": "", "text": "アーヤは平気？"},
        { "location": "82/ACT"    , "narrator": "", "text": "アーヤは平気？"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "私のことはいいから"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "今は"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "みんなをどうにかしなきゃ"},
        { "location": "88/SEL"    , "narrator": "", "text": "手伝おうか？"},
        { "location": "89/SEL"    , "narrator": "", "text": "役に立てることはない？"},
        { "location": "90/SEL"    , "narrator": "", "text": "話なら聞けるよ"},
        { "location": "91/SEL"    , "narrator": "", "text": "一人で抱え込まないで"},
        { "location": "92/ACT"    , "narrator": "", "text": "手伝おうか？"},
        { "location": "93/ACT"    , "narrator": "", "text": "役に立てることはない？"},
        { "location": "94/ACT"    , "narrator": "", "text": "話なら聞けるよ"},
        { "location": "95/ACT"    , "narrator": "", "text": "一人で抱え込まないで"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "大丈夫"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "何とかするから"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "心配しないで"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "そうだ。\n確か今日って…。"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "…で？\nどうして横須賀で\n降りたのよ？"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "あら、知らないの？"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "今日はあの有名な、\n横須賀花火大会の\n日なのよ？"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "…で？"},
        { "location": "158/TALK"  , "narrator": "アーヤ", "text": "ノリが悪いわね…。"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "つまり、今日は\nおもいきって遊ぼう、\nってことよ。"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "…正気？\n昨日の夜のこと\n忘れたの！？"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "遊ぶ気になんて\nなれるわけないでしょ！"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "…じゃあ、何？\nまっすぐ劇場に帰る？"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "当然よ。\nまずは帰る。"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "それから――"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "何もできないわよ。"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "私たちは、管理庁の\n判断がないと動けない\n立場なんだから。"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "それに…劇場に戻って\n何をするつもり？"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "卯月を探しに行く？\nどこにいるか\nわかってるの？"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "…まあ、バカ正直に\n自宅に帰っちょる\nわけないきね。"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "わかってるわよ！\nそんなの…。"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "…なら、急いで\n帰ったところで\n意味ないでしょ？"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "今日は館長も、\n管理庁の判断を仰ぎに\n行ってるし。"},
        { "location": "178/TALK"  , "narrator": "アーヤ", "text": "多分、夜までは\n戻らないはずよ。"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "だから、今日は\n気分転換の日にした方が\nいいと思うの。"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "183/TALK"  , "narrator": "みやび", "text": "…それはあれか？\nリーダーとしての\n命令なが？"},
        { "location": "185/TALK"  , "narrator": "アーヤ", "text": "まさか。\n命令じゃなくて提案よ。"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "というわけだから、\n私は今日一日、\nおもいっきり遊ぶわ。"},
        { "location": "189/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ達も、\nあとは好きにして\nいいから…じゃあね。"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "…ふんっ。"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "222/TALK"  , "narrator": "アーヤ", "text": "あ、小夜。\nこっちこっち。"},
        { "location": "225/TALK"  , "narrator": "小夜", "text": "おまたせー。\nごめんね、\n結構待った感じ？"},
        { "location": "226/TALK"  , "narrator": "アーヤ", "text": "ううん、\n私も今来たところよ。"},
        { "location": "227/TALK"  , "narrator": "アーヤ", "text": "っていうか、\n急にこんなとこに\n呼び出してごめんね？"},
        { "location": "228/TALK"  , "narrator": "小夜", "text": "気にしないで。\nちょうど暇してたし。"},
        { "location": "229/TALK"  , "narrator": "小夜", "text": "それに、横須賀って\n初めてだから、\nちょっと楽しみなんだー。"},
        { "location": "230/TALK"  , "narrator": "アーヤ", "text": "そうだったの？"},
        { "location": "232/TALK"  , "narrator": "小夜", "text": "そうなのよ。"},
        { "location": "234/TALK"  , "narrator": "小夜", "text": "でも、まさかこんな\n戦艦があるとは\n思わなかったわ。"},
        { "location": "236/TALK"  , "narrator": "小夜", "text": "あれ、本物？"},
        { "location": "237/TALK"  , "narrator": "アーヤ", "text": "ええ。\n今は戦艦としての\n機能を失ってるけど。"},
        { "location": "238/TALK"  , "narrator": "アーヤ", "text": "日露戦争で\n連合艦隊を務めて。"},
        { "location": "239/TALK"  , "narrator": "アーヤ", "text": "東郷平八郎も\n座乗した、本物の\n戦艦三笠よ。"},
        { "location": "241/TALK"  , "narrator": "小夜", "text": "詳し過ぎだから！\nえ？　もしかして\n戦艦オタだったとか？"},
        { "location": "243/TALK"  , "narrator": "アーヤ", "text": "初めてここに来た時、\n案内してくれた後輩に\n教えてもらったのよ。"},
        { "location": "244/TALK"  , "narrator": "小夜", "text": "…濃いなぁ、その後輩。"},
        { "location": "245/TALK"  , "narrator": "アーヤ", "text": "あはは…そうね…。"},
        { "location": "246/TALK"  , "narrator": "小夜", "text": "…………。"},
        { "location": "247/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "248/TALK"  , "narrator": "小夜", "text": "…そういえばさ、\nあたしお昼ご飯\nまだなんだよね。"},
        { "location": "249/TALK"  , "narrator": "アーヤ", "text": "私もまだだから、\nどこかでランチに\nしよっか。"},
        { "location": "250/TALK"  , "narrator": "小夜", "text": "そうね。\n横須賀って何が\n美味しいのかしら？"},
        { "location": "252/TALK"  , "narrator": "アーヤ", "text": "横須賀といえば、\nやっぱりアレでしょ？"},
        { "location": "273/TALK"  , "narrator": "小夜", "text": "あ～、辛かったけど、\n凄く美味しかったぁ。"},
        { "location": "274/TALK"  , "narrator": "アーヤ", "text": "水入れたから、飲んでね。"},
        { "location": "275/TALK"  , "narrator": "小夜", "text": "ありがと。"},
        { "location": "276/TALK"  , "narrator": "小夜", "text": "う～ん…、ダイエット中\nなんだけど、おかわり\nしちゃおうかなぁ？"},
        { "location": "278/TALK"  , "narrator": "アーヤ", "text": "…なんか、今日は\n一段とテンションが\n高いわね？"},
        { "location": "279/TALK"  , "narrator": "小夜", "text": "初横須賀だもの。\nテンションくらい\n上がるわよ。"},
        { "location": "280/TALK"  , "narrator": "小夜", "text": "アーヤだって、\nこんな感じだったん\nじゃないの？"},
        { "location": "281/TALK"  , "narrator": "アーヤ", "text": "違うと思うけど…、\nうーん、客観的には\nそうだったのかしら？"},
        { "location": "282/TALK"  , "narrator": "小夜", "text": "えっ！？"},
        { "location": "283/TALK"  , "narrator": "アーヤ", "text": "…なんてね。\n冗談よ。"},
        { "location": "284/TALK"  , "narrator": "小夜", "text": "あはは、だと思った。"},
        { "location": "285/TALK"  , "narrator": "アーヤ", "text": "ふふっ…。"},
        { "location": "286/TALK"  , "narrator": "小夜", "text": "…で？　ちょっとは\n気分転換できた？"},
        { "location": "287/TALK"  , "narrator": "アーヤ", "text": "…やっぱり、\n気づいてたんだ？"},
        { "location": "288/TALK"  , "narrator": "小夜", "text": "わかりやす過ぎだから。"},
        { "location": "289/TALK"  , "narrator": "小夜", "text": "アーヤってさ、\n隠し事のできない\n性格なのよ？"},
        { "location": "291/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "292/TALK"  , "narrator": "小夜", "text": "…何かあったの？\n言えないことなら、\n無理に聞かないけど。"},
        { "location": "293/TALK"  , "narrator": "アーヤ", "text": "…お仕事のことよ。"},
        { "location": "295/TALK"  , "narrator": "アーヤ", "text": "…卯月が私たちを\n裏切ったわ。"},
        { "location": "296/TALK"  , "narrator": "小夜", "text": "…………。"},
        { "location": "297/TALK"  , "narrator": "アーヤ", "text": "ううん、正確には\n裏切ったんじゃないの\nかもしれない。"},
        { "location": "299/TALK"  , "narrator": "アーヤ", "text": "だって、元々管理庁が\n送り込んできたスパイ\nだったんだから…。"},
        { "location": "302/TALK"  , "narrator": "小夜", "text": "…それって、いつのこと？"},
        { "location": "304/TALK"  , "narrator": "アーヤ", "text": "昨日の夜よ。"},
        { "location": "306/TALK"  , "narrator": "アーヤ", "text": "だから、みんな\nショック受けてて\n空気が重くてね…。"},
        { "location": "307/TALK"  , "narrator": "アーヤ", "text": "それで気分転換に、\n横須賀に行こう、って\n提案したの。"},
        { "location": "308/TALK"  , "narrator": "アーヤ", "text": "…まあ、到着早々\nみんなバラバラに\nなったけど。"},
        { "location": "309/TALK"  , "narrator": "小夜", "text": "いいんじゃない？\n一人で考えることも\n大切だと思うし。"},
        { "location": "310/TALK"  , "narrator": "小夜", "text": "それに…仲間だから\n相談できないことも\nあると思うし。"},
        { "location": "312/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "313/TALK"  , "narrator": "小夜", "text": "これからどうするの？\nまさか神楽ちゃんと\n戦うつもり？"},
        { "location": "314/TALK"  , "narrator": "アーヤ", "text": "…そのつもりよ。"},
        { "location": "315/TALK"  , "narrator": "アーヤ", "text": "管理庁の命令だとしても、\n卯月がつばめを殺そうと\nしたのは事実だもの。"},
        { "location": "316/TALK"  , "narrator": "アーヤ", "text": "そんな子相手に、\n容赦してやれるほど\n甘くはないわ。"},
        { "location": "317/TALK"  , "narrator": "小夜", "text": "そうかな？"},
        { "location": "319/TALK"  , "narrator": "アーヤ", "text": "そうよ。\n当然でしょ？"},
        { "location": "320/TALK"  , "narrator": "アーヤ", "text": "…それに、少し前に、\n卯月のことをきつく\n叱ったことがあるの。"},
        { "location": "321/TALK"  , "narrator": "アーヤ", "text": "戦闘に集中しないで、\nみんなを危険な目に\n合わせたから…。"},
        { "location": "322/TALK"  , "narrator": "小夜", "text": "うん…。"},
        { "location": "324/TALK"  , "narrator": "アーヤ", "text": "でも、実はその時、\n卯月の家がフェノメノンに\n巻き込まれてたの。"},
        { "location": "325/TALK"  , "narrator": "アーヤ", "text": "だからあの時、卯月は\n集中できなかったの\nかもしれない…。"},
        { "location": "326/TALK"  , "narrator": "アーヤ", "text": "そう思ったから、\n卯月を叱ったことを\n凄く後悔したのに…。"},
        { "location": "328/TALK"  , "narrator": "アーヤ", "text": "…きっと、あれも作戦の\n一つだったんだと思う。"},
        { "location": "329/TALK"  , "narrator": "アーヤ", "text": "本当…無駄に後悔とか\n同情しちゃったわ。"},
        { "location": "330/TALK"  , "narrator": "小夜", "text": "…………。"},
        { "location": "332/TALK"  , "narrator": "アーヤ", "text": "あ…ごめん。\n嫌な話しちゃって。"},
        { "location": "333/TALK"  , "narrator": "小夜", "text": "ううん…でも、\n神楽ちゃんにも\n理由があったんじゃない？"},
        { "location": "334/TALK"  , "narrator": "アーヤ", "text": "行動には何かしらの\n理由があるものでしょ？"},
        { "location": "335/TALK"  , "narrator": "アーヤ", "text": "でも、理由があれば\n何しても許される\nわけじゃないわ。"},
        { "location": "336/TALK"  , "narrator": "アーヤ", "text": "ましてや、無抵抗の\n人間を殺そうとする\nなんて…許せない。"},
        { "location": "337/TALK"  , "narrator": "アーヤ", "text": "…だから、今度卯月が\n私たちの前に現れたら、\n絶対に容赦しない。"},
        { "location": "338/TALK"  , "narrator": "アーヤ", "text": "こっちも、殺す気で\n迎え撃ってやるわ。"},
        { "location": "339/TALK"  , "narrator": "小夜", "text": "…………。"},
        { "location": "340/TALK"  , "narrator": "小夜", "text": "本当に…、\nそれでいいの？"},
        { "location": "341/TALK"  , "narrator": "小夜", "text": "確かに、アーヤ達を\n裏切ったのかも\nしれないよ？"},
        { "location": "342/TALK"  , "narrator": "小夜", "text": "けど、ずっと一緒に\n戦ってきたんでしょ？"},
        { "location": "343/TALK"  , "narrator": "小夜", "text": "なのにそんな…。\n本当にそんなこと\nできるの？"},
        { "location": "344/TALK"  , "narrator": "アーヤ", "text": "…もちろんよ。"},
        { "location": "347/TALK"  , "narrator": "アーヤ", "text": "私に、迷いは――"},
        { "location": "411/TALK"  , "narrator": "アーヤ", "text": "　"},
        { "location": "427/TALK"  , "narrator": "アーヤの新司書", "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。"},
        { "location": "428/TALK"  , "narrator": "アーヤの新司書", "text": "いよいよ試練の時が\nやってきたみたいね。"},
        { "location": "429/TALK"  , "narrator": "アーヤの新司書", "text": "今回は慎重に\n対応した方がよさそう。"},
        { "location": "430/TALK"  , "narrator": "アーヤの新司書", "text": "まずは\n扉を回してみるわね。"},
        { "location": "435/TALK"  , "narrator": "アーヤの新司書", "text": "オープンプロセス、\n0x556番地から\n0x192番地へ。"},
        { "location": "457/TALK"  , "narrator": "アーヤの新司書", "text": "シーク完了。"},
        { "location": "460/TALK"  , "narrator": "アーヤの新司書", "text": "今回は……"},
        { "location": "462/TALK"  , "narrator": "アーヤの新司書", "text": "だいぶ暴走してるわね。"},
        { "location": "463/TALK"  , "narrator": "アーヤの新司書", "text": "ここで止めておかないと\n後で後悔する。"},
        { "location": "464/TALK"  , "narrator": "アーヤの新司書", "text": "私は自分が思ってる以上に\n卯月のことを大事に\n思ってるみたいなの。"},
        { "location": "465/TALK"  , "narrator": "アーヤの新司書", "text": "だから、迷いはないと\n言ってしまうことで、\n後に自己嫌悪に陥る。"},
        { "location": "466/TALK"  , "narrator": "アーヤの新司書", "text": "精神的に\nちょっと面倒なことに\nなってしまうのよ。"},
        { "location": "467/TALK"  , "narrator": "アーヤの新司書", "text": "小夜に言ったことで意地も\n出て、後にも引けなくなり\n精神的にも破綻しちゃう。"},
        { "location": "468/TALK"  , "narrator": "アーヤの新司書", "text": "だからここは、\n思い止まらせなければ\nならない。"},
        { "location": "469/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "470/SEL"   , "narrator": "", "text": "聞こえはいいけど…"},
        { "location": "471/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "472/TALK"  , "narrator": "アーヤの新司書", "text": "それじゃ\nいくわよ。"},
        { "location": "473/ACT"   , "narrator": "", "text": "聞こえはいいけど…"},
        { "location": "474/TALK"  , "narrator": "アーヤの新司書", "text": "え？\nなに？"},
        { "location": "475/SEL"   , "narrator": "", "text": "それって単なる事なかれ主義じゃない？"},
        { "location": "476/SEL"   , "narrator": "", "text": "神楽に危害を与えないようにするための精神操作だったりしない？"},
        { "location": "477/ACT"   , "narrator": "", "text": "単なる事なかれ主義じゃない？"},
        { "location": "478/TALK"  , "narrator": "アーヤの新司書", "text": "なるほど。まあ、\nそうかもしれないわね。"},
        { "location": "479/TALK"  , "narrator": "アーヤの新司書", "text": "実際、何事もないのが\n一番なんだし。"},
        { "location": "480/TALK"  , "narrator": "アーヤの新司書", "text": "それじゃ、行くわね。"},
        { "location": "481/ACT"   , "narrator": "", "text": "神楽に危害を与えないようにするための精神操作だったりしない？"},
        { "location": "483/TALK"  , "narrator": "アーヤの新司書", "text": "え？\nなにそれ？"},
        { "location": "484/TALK"  , "narrator": "アーヤの新司書", "text": "言ってる意味が\nよくわからないんだけど。"},
        { "location": "485/SEL"   , "narrator": "", "text": "神楽は情報管理庁のスパイなんでしょ？"},
        { "location": "486/ACT"   , "narrator": "", "text": "神楽は情報管理庁のスパイなんでしょ？"},
        { "location": "488/TALK"  , "narrator": "アーヤの新司書", "text": "その線が\n濃厚になってるわね。"},
        { "location": "489/SEL"   , "narrator": "", "text": "契約主って情報管理庁でしょ？"},
        { "location": "490/ACT"   , "narrator": "", "text": "契約主って情報管理庁でしょ？"},
        { "location": "492/TALK"  , "narrator": "アーヤの新司書", "text": "それは私には\nわからないわ。"},
        { "location": "493/SEL"   , "narrator": "", "text": "もしそうなら、送られてくる情報は管理庁に都合の良いものにされてない？"},
        { "location": "494/ACT"   , "narrator": "", "text": "もしそうなら、送られてくる情報は管理庁に都合の良いものにされてない？"},
        { "location": "496/TALK"  , "narrator": "アーヤの新司書", "text": "いやいやいや、"},
        { "location": "497/TALK"  , "narrator": "アーヤの新司書", "text": "そもそも前提として\n契約主が管理庁だって\n思い込むのはどうかと。"},
        { "location": "498/TALK"  , "narrator": "アーヤの新司書", "text": "仮に本当にそうだったと\nしても、私自身の想いも\n同じだもの。"},
        { "location": "499/TALK"  , "narrator": "アーヤの新司書", "text": "可能な限り、卯月を信じ\nたいし、無駄に危害を\n与えたくはないの。"},
        { "location": "500/TALK"  , "narrator": "アーヤの新司書", "text": "だから、自己判断でも\n結論は変わらないわ。"},
        { "location": "501/TALK"  , "narrator": "アーヤの新司書", "text": "そういう陰謀論みたいなの\nここではやめて\nくれないかしら？"},
        { "location": "502/SEL"   , "narrator": "", "text": "何でもかんでも陰謀論で片付けると身を滅ぼすよ"},
        { "location": "503/SEL"   , "narrator": "", "text": "本当に知らないね？\n本当だね？"},
        { "location": "504/ACT"   , "narrator": "", "text": "何でもかんでも陰謀論で片付けると身を滅ぼすよ"},
        { "location": "505/TALK"  , "narrator": "アーヤの新司書", "text": "はいはい。\n肝に免じておくわね。"},
        { "location": "506/TALK"  , "narrator": "アーヤの新司書", "text": "それじゃ、\nそろそろ行くわよ。"},
        { "location": "507/ACT"   , "narrator": "", "text": "本当に知らないね？\n本当だね？"},
        { "location": "508/TALK"  , "narrator": "アーヤの新司書", "text": "しつこいわね。\nどうして私がそこまで\n疑われないといけないの。"},
        { "location": "509/SEL"   , "narrator": "", "text": "1xは嘘をつくらしいから"},
        { "location": "510/ACT"   , "narrator": "", "text": "1xは嘘をつくらしいから"},
        { "location": "512/TALK"  , "narrator": "アーヤの新司書", "text": "すぐそうやって\n話を逆手に取る。"},
        { "location": "513/TALK"  , "narrator": "アーヤの新司書", "text": "嘘をつかない存在なんて、\n人間でも人格でもいない\nって話をしたのよ。"},
        { "location": "514/TALK"  , "narrator": "アーヤの新司書", "text": "そんなこと言われるなら\n貴方の言う事も一切\n信用できないわね。"},
        { "location": "516/TALK"  , "narrator": "アーヤの新司書", "text": "まあいいわ。\nそんなこと言ってても\n何も解決しないし。"},
        { "location": "517/TALK"  , "narrator": "アーヤの新司書", "text": "貴方が今一番やらなくちゃ\nならないことは、クランを\n倒すこと。"},
        { "location": "518/TALK"  , "narrator": "アーヤの新司書", "text": "契約主から送られてくる\n解決方法の指示通りにね。"},
        { "location": "519/SEL"   , "narrator": "", "text": "はいはい"},
        { "location": "520/SEL"   , "narrator": "", "text": "拒否します"},
        { "location": "521/ACT"   , "narrator": "", "text": "はいはい"},
        { "location": "522/TALK"  , "narrator": "アーヤの新司書", "text": "返事は１回。"},
        { "location": "523/TALK"  , "narrator": "アーヤの新司書", "text": "それじゃ、行くわよ。"},
        { "location": "524/ACT"   , "narrator": "", "text": "拒否します"},
        { "location": "525/TALK"  , "narrator": "アーヤの新司書", "text": "あら、そうですか。"},
        { "location": "526/TALK"  , "narrator": "アーヤの新司書", "text": "それならそれで\n仕方ないわね。\n強制はできないし。"},
        { "location": "527/TALK"  , "narrator": "アーヤの新司書", "text": "それに貴方が拒否しても、\n貴方以外の沢山の存在が\nやってくれる。"},
        { "location": "528/TALK"  , "narrator": "アーヤの新司書", "text": "多少精度が落ちるけど、\n大勢に影響はないわ。"},
        { "location": "529/TALK"  , "narrator": "アーヤの新司書", "text": "それが人間社会。"},
        { "location": "530/TALK"  , "narrator": "アーヤの新司書", "text": "個人でできる事なんて\nたかが知れてる。"},
        { "location": "531/TALK"  , "narrator": "アーヤの新司書", "text": "殆どの人たちは、\n何も考えずに情報を\n鵜呑みにしてしまう。"},
        { "location": "532/TALK"  , "narrator": "アーヤの新司書", "text": "だからいつだって真実とは\n関係なしに、異変を訴えた\n方が残酷な目に遭う。"},
        { "location": "533/TALK"  , "narrator": "アーヤの新司書", "text": "本心を言えば、\n$handle$さんには\nそうなって欲しくない。"},
        { "location": "534/TALK"  , "narrator": "アーヤの新司書", "text": "だから、何も考えず\n情報に従って\nクランを倒して欲しいの。"},
        { "location": "535/SEL"   , "narrator": "", "text": "長いものには巻かれなさいってこと？"},
        { "location": "536/ACT"   , "narrator": "", "text": "長いものには巻かれなさいってこと？"},
        { "location": "538/TALK"  , "narrator": "アーヤの新司書", "text": "まあ、\n誤解を恐れずに言うなら、\nそういうことね。"},
        { "location": "539/TALK"  , "narrator": "アーヤの新司書", "text": "もう貴方は、\n私にとって\n大切な人だから。"},
        { "location": "540/TALK"  , "narrator": "アーヤの新司書", "text": "無駄な反抗をして、\n辛い目に遭って\n欲しくないのよ。"},
        { "location": "541/TALK"  , "narrator": "アーヤの新司書", "text": "でも、最終的に\n決めるのは貴方だから。"},
        { "location": "542/TALK"  , "narrator": "アーヤの新司書", "text": "一応、扉は\n開けておくわね。"},
        { "location": "546/TALK"  , "narrator": "アーヤの新司書", "text": "$handle$と\n國政綾水にとって、\n素敵なココロの旅を。"},
        { "location": "39/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月30日　 2:20 PM</color>\n合宿終了の日、帰りの電車内でのこと"},
        { "location": "41/DIALOG" , "narrator": "YES_NO", "text": "共通エピソード部分を\n飛ばしますか？"},
        { "location": "376/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "378/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "380/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "382/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "384/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
