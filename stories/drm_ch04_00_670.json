    "entry":
    [
        { "location": "177/SCENARIO", "narrator": "", "text": "565_セーフモードが必要"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "今の話"},
        { "location": "204/SEL"     , "narrator": "", "text": "うん"},
        { "location": "205/SEL"     , "narrator": "", "text": "聞いてるよ"},
        { "location": "206/SEL"     , "narrator": "", "text": "気持ちの整理が付いてからでいいから"},
        { "location": "207/ACT"     , "narrator": "", "text": "うん"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "上手く説明ができんぞね"},
        { "location": "211/TALK"    , "narrator": "みやび", "text": "でも"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "好きなのは"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "ほんとうぞね"},
        { "location": "215/ACT"     , "narrator": "", "text": "聞いてるよ"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "そうか"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "ごめん"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "どう言えばいいかわからんぞね"},
        { "location": "221/ACT"     , "narrator": "", "text": "気持ちの整理が付いてからでいいから"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "そんなもん"},
        { "location": "233/TALK"    , "narrator": "みやび", "text": "いつつくかわからんぞね"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "ばかちんが"},
        { "location": "236/SEL"     , "narrator": "", "text": "それでもいいよ"},
        { "location": "237/SEL"     , "narrator": "", "text": "きっとつくよ"},
        { "location": "238/SEL"     , "narrator": "", "text": "$me$はみやびが好きだから"},
        { "location": "239/ACT"     , "narrator": "", "text": "それでもいいよ"},
        { "location": "240/TALK"    , "narrator": "みやび", "text": "いいのか"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "酔狂な"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "相棒だの"},
        { "location": "244/ACT"     , "narrator": "", "text": "きっとつくよ"},
        { "location": "245/TALK"    , "narrator": "みやび", "text": "そんな気がしない"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "そんなことが"},
        { "location": "247/TALK"    , "narrator": "みやび", "text": "あるんだろうか"},
        { "location": "248/ACT"     , "narrator": "", "text": "$me$はみやびが好きだから"},
        { "location": "249/TALK"    , "narrator": "みやび", "text": "そんなもん"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "うちだって一緒ぞね"},
        { "location": "252/SEL"     , "narrator": "", "text": "本当に？"},
        { "location": "253/SEL"     , "narrator": "", "text": "うれしいな"},
        { "location": "254/ACT"     , "narrator": "", "text": "本当に？"},
        { "location": "255/TALK"    , "narrator": "みやび", "text": "そうでなくて"},
        { "location": "256/TALK"    , "narrator": "みやび", "text": "悩むものか"},
        { "location": "257/TALK"    , "narrator": "みやび", "text": "ばかちんが"},
        { "location": "258/ACT"     , "narrator": "", "text": "うれしいな"},
        { "location": "259/TALK"    , "narrator": "みやび", "text": "もっと喜べ"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "ばかちんが"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "けんど"},
        { "location": "266/TALK"    , "narrator": "みやび", "text": "どうすればいいのか"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "さっぱりわからんことになったぞね"},
        { "location": "269/SEL"     , "narrator": "", "text": "別にそれでいいと思う"},
        { "location": "270/SEL"     , "narrator": "", "text": "$me$だっておんなじだよ"},
        { "location": "271/ACT"     , "narrator": "", "text": "別にそれでいいと思う"},
        { "location": "272/TALK"    , "narrator": "みやび", "text": "そういうわけには"},
        { "location": "273/TALK"    , "narrator": "みやび", "text": "いかんぞね"},
        { "location": "274/ACT"     , "narrator": "", "text": "$me$だっておんなじだよ"},
        { "location": "275/TALK"    , "narrator": "みやび", "text": "それはどうか"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "わからんぞ"},
        { "location": "280/TALK"    , "narrator": "みやび", "text": "ちょっと一人で"},
        { "location": "281/TALK"    , "narrator": "みやび", "text": "考えてみるき"},
        { "location": "282/TALK"    , "narrator": "みやび", "text": "邪魔せんでね"},
        { "location": "227/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
    ]
}
