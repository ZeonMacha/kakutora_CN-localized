{
    "dir": "chap23/daydra/dd_ch02_23_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "23205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "迷いは＜後編＞"
    },
    "entry":
    [
        { "location": "577/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "578/TALK"  , "narrator": "小夜", "text": "…よかった。"},
        { "location": "579/TALK"  , "narrator": "小夜", "text": "やっぱり、迷いがない\nわけないよね。"},
        { "location": "581/TALK"  , "narrator": "アーヤ", "text": "…よくないわよ。"},
        { "location": "582/TALK"  , "narrator": "小夜", "text": "そうかしら？\nあたしはそれ聞いて\n安心したわ。"},
        { "location": "583/TALK"  , "narrator": "小夜", "text": "だって、アーヤは\n優しい子だもの。"},
        { "location": "584/TALK"  , "narrator": "小夜", "text": "仲間だった子を\n簡単に殺せたり\nするはずないわ。"},
        { "location": "586/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "587/TALK"  , "narrator": "小夜", "text": "…その顔からすると、\n不満そうだね？"},
        { "location": "588/TALK"  , "narrator": "アーヤ", "text": "…私はリーダーで、\nみんなを護らなきゃ\nいけない立場なの。"},
        { "location": "589/TALK"  , "narrator": "アーヤ", "text": "だから、敵に対して\n迷ったりしたら\nいけないの。"},
        { "location": "591/TALK"  , "narrator": "アーヤ", "text": "なのに…、\n私、迷ってる…。"},
        { "location": "592/TALK"  , "narrator": "アーヤ", "text": "裏切者なのに…。\n敵なのに…。"},
        { "location": "593/TALK"  , "narrator": "アーヤ", "text": "私…あの子たちの\nリーダー失格なのかも…。"},
        { "location": "594/TALK"  , "narrator": "小夜", "text": "バカなこと\n言わないでよ。"},
        { "location": "595/TALK"  , "narrator": "小夜", "text": "アーヤはみんなのことを、\n一生懸命護ってきたん\nでしょ？"},
        { "location": "596/TALK"  , "narrator": "小夜", "text": "そんな子の一人を、\n突然迷いもなく\n敵と思えるはずないわよ。"},
        { "location": "598/TALK"  , "narrator": "アーヤ", "text": "でも、トライナリーの\nリーダーとして――"},
        { "location": "599/TALK"  , "narrator": "小夜", "text": "トライナリーとか\nリーダーとかは\n関係ない。"},
        { "location": "600/TALK"  , "narrator": "小夜", "text": "アーヤが迷ってるのは、\n人として、何も間違って\nないから。"},
        { "location": "601/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "602/TALK"  , "narrator": "小夜", "text": "もしかしたら、\nみんなからは甘いって\n言われるかもしれない。"},
        { "location": "603/TALK"  , "narrator": "小夜", "text": "それでも、\nあたしは今のアーヤを\n肯定するわ。"},
        { "location": "604/TALK"  , "narrator": "小夜", "text": "みんなを護るために、\n必死に頑張ってるの\n見てるから。"},
        { "location": "605/TALK"  , "narrator": "小夜", "text": "何があっても、\nアーヤのこと応援するわ。"},
        { "location": "606/TALK"  , "narrator": "アーヤ", "text": "…小夜。"},
        { "location": "607/TALK"  , "narrator": "小夜", "text": "ま、だからさ。"},
        { "location": "608/TALK"  , "narrator": "小夜", "text": "アーヤ自身が\nどうしたいか、\n考えてみなよ。"},
        { "location": "610/TALK"  , "narrator": "アーヤ", "text": "…うん…うん。\nありがとう…。\nありがとう、小夜…。"},
        { "location": "629/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "632/TALK"  , "narrator": "アーヤ", "text": "ごめん…。"},
        { "location": "634/TALK"  , "narrator": "小夜", "text": "何がよ？"},
        { "location": "637/TALK"  , "narrator": "アーヤ", "text": "みっともないところ\n見せちゃったわ…。"},
        { "location": "638/TALK"  , "narrator": "小夜", "text": "気にしてないわよ、\nこのくらいのこと。"},
        { "location": "639/TALK"  , "narrator": "小夜", "text": "それより、ちょっとは\nスッキリできた？"},
        { "location": "640/TALK"  , "narrator": "アーヤ", "text": "…ええ。\nおかげさまでね。"},
        { "location": "641/TALK"  , "narrator": "小夜", "text": "そ、よかった。"},
        { "location": "642/TALK"  , "narrator": "アーヤ", "text": "…小夜のおかげで、\nやっと自分の気持ちに\n気づけたわ。"},
        { "location": "643/TALK"  , "narrator": "アーヤ", "text": "やっぱり私…、\n卯月のこと、\n信じてみたい…。"},
        { "location": "644/TALK"  , "narrator": "小夜", "text": "そっか…。"},
        { "location": "646/TALK"  , "narrator": "アーヤ", "text": "みんなからは、\n甘いって言われるかも\nしれないけど。"},
        { "location": "647/TALK"  , "narrator": "小夜", "text": "自分を誤魔化すより\nいいんじゃない？"},
        { "location": "648/TALK"  , "narrator": "小夜", "text": "それに、甘いところが\nアーヤの数少ない\nチャームポイントでしょ？"},
        { "location": "650/TALK"  , "narrator": "アーヤ", "text": "少ない、ってのが\n引っかかるんだけど？"},
        { "location": "651/TALK"  , "narrator": "小夜", "text": "いいじゃん、別に。"},
        { "location": "652/TALK"  , "narrator": "小夜", "text": "それにあたし、\nアーヤのそういうとこ\n好きよ。"},
        { "location": "653/TALK"  , "narrator": "アーヤ", "text": "誤解を生みそうな\nこと言わないの。"},
        { "location": "654/TALK"  , "narrator": "小夜", "text": "えへへ。"},
        { "location": "656/TALK"  , "narrator": "アーヤ", "text": "…でもまあ、\n私も友達として\n小夜のこと好きよ。"},
        { "location": "657/TALK"  , "narrator": "アーヤ", "text": "本当、\n心から信頼してるわ。"},
        { "location": "658/TALK"  , "narrator": "小夜", "text": "あはは、アーヤだって\n同じようなこと\n言ってるし。"},
        { "location": "659/TALK"  , "narrator": "アーヤ", "text": "友達としてだってば。"},
        { "location": "660/TALK"  , "narrator": "小夜", "text": "本当かしら？"},
        { "location": "661/TALK"  , "narrator": "アーヤ", "text": "何よ、期待してるの？"},
        { "location": "662/TALK"  , "narrator": "小夜", "text": "なわけないじゃん。"},
        { "location": "664/TALK"  , "narrator": "小夜", "text": "…まあさ、甘いのは\n別にいいんだけど、\nこれだけは間違えないで。"},
        { "location": "665/TALK"  , "narrator": "小夜", "text": "神楽ちゃんのこと、\n簡単に許すのはダメよ？"},
        { "location": "666/TALK"  , "narrator": "小夜", "text": "つばめちゃんに\n酷いことをしたのは\n間違いないんだし。"},
        { "location": "667/TALK"  , "narrator": "小夜", "text": "そこのところは、\nきっちりケジメを\nつけさせなきゃね。"},
        { "location": "668/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "673/TALK"  , "narrator": "小夜", "text": "あ、始まった！"},
        { "location": "675/TALK"  , "narrator": "アーヤ", "text": "…ええ。"},
        { "location": "680/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "693/TALK"  , "narrator": "アーヤ", "text": "聞いてもらえる？"},
        { "location": "695/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "696/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "698/TALK"  , "narrator": "アーヤ", "text": "私ね"},
        { "location": "699/TALK"  , "narrator": "アーヤ", "text": "決めたわ"},
        { "location": "700/TALK"  , "narrator": "アーヤ", "text": "卯月がしたこと"},
        { "location": "701/TALK"  , "narrator": "アーヤ", "text": "不問にはできない"},
        { "location": "704/TALK"  , "narrator": "アーヤ", "text": "けど"},
        { "location": "705/TALK"  , "narrator": "アーヤ", "text": "つばめが言ってたけど"},
        { "location": "706/TALK"  , "narrator": "アーヤ", "text": "卯月も被害者かもしれない"},
        { "location": "707/TALK"  , "narrator": "アーヤ", "text": "何か理由があって"},
        { "location": "708/TALK"  , "narrator": "アーヤ", "text": "仕方なくスパイしたかもしれない"},
        { "location": "709/TALK"  , "narrator": "アーヤ", "text": "だから卯月には"},
        { "location": "710/TALK"  , "narrator": "アーヤ", "text": "気を許さない"},
        { "location": "711/TALK"  , "narrator": "アーヤ", "text": "真相がわかるまで"},
        { "location": "712/TALK"  , "narrator": "アーヤ", "text": "気を許さないでいくから"},
        { "location": "713/TALK"  , "narrator": "アーヤ", "text": "それが"},
        { "location": "715/TALK"  , "narrator": "アーヤ", "text": "私の出した答え"},
        { "location": "718/TALK"  , "narrator": "アーヤ", "text": "甘いと思う？"},
        { "location": "720/SEL"   , "narrator": "", "text": "みんなの安全には気を付けてね"},
        { "location": "721/SEL"   , "narrator": "", "text": "厳しいと思う"},
        { "location": "722/SEL"   , "narrator": "", "text": "チャームポイントだよ"},
        { "location": "723/ACT"   , "narrator": "", "text": "みんなの安全には気を付けてね"},
        { "location": "724/TALK"  , "narrator": "アーヤ", "text": "もちろん"},
        { "location": "725/TALK"  , "narrator": "アーヤ", "text": "だから気は許さない"},
        { "location": "726/TALK"  , "narrator": "アーヤ", "text": "そう決めたの"},
        { "location": "727/TALK"  , "narrator": "アーヤ", "text": "みんなに"},
        { "location": "728/TALK"  , "narrator": "アーヤ", "text": "危害を加えたりさせない"},
        { "location": "729/TALK"  , "narrator": "アーヤ", "text": "今の卯月が敵だってことに"},
        { "location": "730/TALK"  , "narrator": "アーヤ", "text": "揺るぎはないんだしね"},
        { "location": "731/ACT"   , "narrator": "", "text": "厳しいと思う"},
        { "location": "732/TALK"  , "narrator": "アーヤ", "text": "そうかしら？"},
        { "location": "733/TALK"  , "narrator": "アーヤ", "text": "これくらいはしなきゃ"},
        { "location": "734/TALK"  , "narrator": "アーヤ", "text": "ダメだと思うけど？"},
        { "location": "735/TALK"  , "narrator": "アーヤ", "text": "あれだけのことして"},
        { "location": "736/TALK"  , "narrator": "アーヤ", "text": "軽く済ませるなんて"},
        { "location": "737/TALK"  , "narrator": "アーヤ", "text": "絶対ダメ"},
        { "location": "738/TALK"  , "narrator": "アーヤ", "text": "$handle2$は"},
        { "location": "739/TALK"  , "narrator": "アーヤ", "text": "私より甘いのかも"},
        { "location": "741/TALK"  , "narrator": "アーヤ", "text": "じゃなくて"},
        { "location": "742/TALK"  , "narrator": "アーヤ", "text": "優しいのかも"},
        { "location": "743/ACT"   , "narrator": "", "text": "チャームポイントだよ"},
        { "location": "744/TALK"  , "narrator": "アーヤ", "text": "それ"},
        { "location": "745/TALK"  , "narrator": "アーヤ", "text": "小夜の言ったことでしょ！"},
        { "location": "746/TALK"  , "narrator": "アーヤ", "text": "もう"},
        { "location": "747/TALK"  , "narrator": "アーヤ", "text": "からかわないの！"},
        { "location": "769/DIALOG", "narrator": "Dialog_chapter_ch02", "text": "【19 三戸浜からの手紙】"}
    ]
}
