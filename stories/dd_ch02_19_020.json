{
    "dir": "chap19/daydra/dd_ch02_19_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "19256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "メルティー"
    },
    "entry":
    [
        { "location": "350/SCENARIO", "narrator": "", "text": "メルティー"},
        { "location": "376/TALK"    , "narrator": "神楽", "text": "それにしても――"},
        { "location": "378/TALK"    , "narrator": "神楽", "text": "まさか、合宿中に\nフェノメノンが出るとは\n思いませんでした。"},
        { "location": "379/TALK"    , "narrator": "神楽", "text": "しかも、海もない\n都内のど真ん中で、\n水着で戦うとか――"},
        { "location": "380/TALK"    , "narrator": "神楽", "text": "人権侵害で訴えたい\n気分ですよ。"},
        { "location": "382/TALK"    , "narrator": "ガブリエラ", "text": "文句ばっか言ってんじゃ\nないわよ。"},
        { "location": "384/TALK"    , "narrator": "ガブリエラ", "text": "水着くらい、大して\n騒ぐことじゃないわ。"},
        { "location": "386/TALK"    , "narrator": "アーヤ", "text": "そんなことはないと\n思うけど…。"},
        { "location": "388/TALK"    , "narrator": "神楽", "text": "そうですよ。"},
        { "location": "389/TALK"    , "narrator": "神楽", "text": "私、ガブちゃんが\n一番嫌がってたのかと\n思ったのに…。"},
        { "location": "391/TALK"    , "narrator": "ガブリエラ", "text": "もちろん嫌では\nあるけど…。"},
        { "location": "394/TALK"    , "narrator": "真幌", "text": "ミルクティーメルティと\nアップルティーメルティに\n比べれば――"},
        { "location": "395/TALK"    , "narrator": "真幌", "text": "水着くらい、騒ぐような\nことではないのだろう。"},
        { "location": "399/TALK"    , "narrator": "アーヤ", "text": "ちょ、館長！？"},
        { "location": "401/TALK"    , "narrator": "雛", "text": "えっ、なんですかそれ？"},
        { "location": "403/TALK"    , "narrator": "真幌", "text": "そうか、おまえ達は\n知らないんだったな。"},
        { "location": "404/TALK"    , "narrator": "真幌", "text": "ちょっと前に出た\nフェノメノンの中で\nあったことなんだが――"},
        { "location": "405/TALK"    , "narrator": "真幌", "text": "あの時は、アーヤと\nギャヴィが色んな意味で\n大活躍してな。"},
        { "location": "406/TALK"    , "narrator": "真幌", "text": "歌も踊りも、\n中々上手かったし。"},
        { "location": "410/TALK"    , "narrator": "ガブリエラ", "text": "まほ！\nその話はしないで！"},
        { "location": "412/TALK"    , "narrator": "アーヤ", "text": "そうですよ！\nっていうか、ちょっと\n飲み過ぎですよ！？"},
        { "location": "413/TALK"    , "narrator": "真幌", "text": "いいじゃないか。\nこいつらだって、\nおまえ達のために――"},
        { "location": "414/TALK"    , "narrator": "真幌", "text": "日頃頑張ってくれている\n仲間じゃないか。"},
        { "location": "415/TALK"    , "narrator": "キリト", "text": "さすが東雲教官！\nそれで、何があったん\nすか？"},
        { "location": "416/TALK"    , "narrator": "真幌", "text": "順番に説明しよう。\nそもそもの発端は――"},
        { "location": "417/TALK"    , "narrator": "ガブリエラ", "text": "だ、ダメだって！\n話さないでってば！"},
        { "location": "419/TALK"    , "narrator": "真幌", "text": "ははは、恥ずかしがるな。\nあの時のギャヴィは\n最高に可愛かったぞ？"},
        { "location": "422/TALK"    , "narrator": "アーヤ", "text": "…完全に酔っぱらってる\nみたいね。"},
        { "location": "424/TALK"    , "narrator": "ガブリエラ", "text": "ああもう、言わないでって\n言ってるのにー！"},
        { "location": "439/TALK"    , "narrator": "アーヤ", "text": "どうしよう、館長凄い酔っぱらってるみたい"},
        { "location": "441/SEL"     , "narrator": "", "text": "いつものことじゃん"},
        { "location": "442/ACT"     , "narrator": "", "text": "いつものことじゃん"},
        { "location": "444/TALK"    , "narrator": "アーヤ", "text": "私とギャヴィがメルティになった時の話をしようとしてるの！"},
        { "location": "445/TALK"    , "narrator": "アーヤ", "text": "何言っても聞かなそうだし、何かいい方法ない？"},
        { "location": "447/SEL"     , "narrator": "", "text": "歌ってやりなよ"},
        { "location": "448/SEL"     , "narrator": "", "text": "あの時のアーヤ、可愛かった"},
        { "location": "449/ACT"     , "narrator": "", "text": "歌ってやりなよ"},
        { "location": "452/TALK"    , "narrator": "アーヤ", "text": "本気！？"},
        { "location": "453/TALK"    , "narrator": "アーヤ", "text": "っていうか、それで止まるの？"},
        { "location": "465/TALK"    , "narrator": "アーヤ", "text": "でも、説得しても今の\n館長は止められそうに\nないし…。"},
        { "location": "466/TALK"    , "narrator": "真幌", "text": "とまあ、フェノメノンの\n発生した理由はそういう\nことなんだが――"},
        { "location": "467/TALK"    , "narrator": "真幌", "text": "それを止めるために、\nアーヤとガブリエラが――"},
        { "location": "469/TALK"    , "narrator": "アーヤ", "text": "…甘酸っぱい。"},
        { "location": "471/TALK"    , "narrator": "真幌", "text": "んっ？"},
        { "location": "473/TALK"    , "narrator": "アーヤ", "text": "…甘酸っぱい\n恋の妖精あっぷる♪"},
        { "location": "475/TALK"    , "narrator": "雛", "text": "えっ！？"},
        { "location": "477/TALK"    , "narrator": "キリト", "text": "はぁ！？"},
        { "location": "479/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、アーヤ！？"},
        { "location": "480/TALK"    , "narrator": "アーヤ", "text": "はっぴぃな夢見る\n乙女みるく♪"},
        { "location": "481/TALK"    , "narrator": "キリト", "text": "えっ…は、はっぴぃ？\n夢見る乙女？"},
        { "location": "482/TALK"    , "narrator": "雛", "text": "…あ、綾水様？\nその…急にどうしたん\nですか？"},
        { "location": "484/TALK"    , "narrator": "アーヤ", "text": "みんなが、メルティに\n凄く興味がありそう\nだったから――"},
        { "location": "486/TALK"    , "narrator": "アーヤ", "text": "それなら、実際に\n聞かせた方がいいかな、\nって思ったのよ。"},
        { "location": "488/TALK"    , "narrator": "雛", "text": "…な、なんか綾水様、\n目が笑ってないような？"},
        { "location": "490/TALK"    , "narrator": "アーヤ", "text": "今歌ったのは出だしの\n部分だけど――"},
        { "location": "492/TALK"    , "narrator": "アーヤ", "text": "最後まで聞きたい、\nって人…いる？"},
        { "location": "493/TALK"    , "narrator": "キリト", "text": "…………。"},
        { "location": "494/TALK"    , "narrator": "雛", "text": "超聞いてみたい！！"},
        { "location": "495/TALK"    , "narrator": "雛", "text": "けど、なーんか後が\n怖そうだし、黙っといた\n方がいいかもー…。"},
        { "location": "497/TALK"    , "narrator": "アーヤ", "text": "…うん、よろしい。\n館長も、それでいい\nですか？"},
        { "location": "499/TALK"    , "narrator": "真幌", "text": "やれやれ…話せるような\n空気じゃなくなったしな。"},
        { "location": "501/TALK"    , "narrator": "キリト", "text": "…聞いちゃいけない話\nだったみてぇだな？"},
        { "location": "503/TALK"    , "narrator": "雛", "text": "出だしの部分だけでも\nあの破壊力だからねー。\nなんかわかるかも…。"},
        { "location": "504/TALK"    , "narrator": "神楽", "text": "あの時は凄く可愛いな、\nって思いましたけど――"},
        { "location": "505/TALK"    , "narrator": "神楽", "text": "さすがに、衣装も何も\nない状態で歌われる\nのは――"},
        { "location": "507/TALK"    , "narrator": "神楽", "text": "アーヤさんのイメージが\n崩壊しそうで、ちょっと\n怖いです…。"},
        { "location": "508/TALK"    , "narrator": "ガブリエラ", "text": "…助かったわ。\nあたし達の恥が広まるのを\n阻止できて…。"},
        { "location": "509/TALK"    , "narrator": "ガブリエラ", "text": "けど、どうして未だに\nあの歌詞覚えてるの？"},
        { "location": "511/TALK"    , "narrator": "アーヤ", "text": "さ、最初の部分だけ、\n偶々覚えてただけよ。"},
        { "location": "512/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "514/TALK"    , "narrator": "アーヤ", "text": "ほ、本当よ！\nほら、もうこの話は\nおしまいにしましょ！"},
        { "location": "531/ACT"     , "narrator": "", "text": "あの時のアーヤ、可愛かった"},
        { "location": "533/TALK"    , "narrator": "アーヤ", "text": "まあ、ここだけの話"},
        { "location": "534/TALK"    , "narrator": "アーヤ", "text": "嫌ではなかったわ、メルティ…(*´ω｀*)"},
        { "location": "535/TALK"    , "narrator": "アーヤ", "text": "でも、私は可愛くない"},
        { "location": "536/TALK"    , "narrator": "アーヤ", "text": "私の年齢であんな格好したら、イタいだけよ"},
        { "location": "548/TALK"    , "narrator": "キリト", "text": "えっ…な、なんですか、\nそれって？"},
        { "location": "550/TALK"    , "narrator": "真幌", "text": "だから、ミルクティー\nメルティとアップルティー\nメルティってのは――"},
        { "location": "551/TALK"    , "narrator": "真幌", "text": "フリフリの衣装着て、\n魔法のステッキ持った\n魔法少女なんだ。"},
        { "location": "552/TALK"    , "narrator": "真幌", "text": "それを、アーヤと\nガブリエラがやることに\nなってな…。"},
        { "location": "553/TALK"    , "narrator": "キリト", "text": "ま、魔法少女って…\nうわぁ、マジかよ？"},
        { "location": "555/TALK"    , "narrator": "アーヤ", "text": "いけない！\nいつの間にか話が\n進んでる！？"},
        { "location": "557/TALK"    , "narrator": "ガブリエラ", "text": "ちょっとまほ！\nそれ以上話したら\n本当許さないわよ！？"},
        { "location": "558/TALK"    , "narrator": "真幌", "text": "しかも、ただの魔法少女\nではなくてな。"},
        { "location": "559/TALK"    , "narrator": "真幌", "text": "歌って踊れる魔法少女、\nという設定だったから――"},
        { "location": "560/TALK"    , "narrator": "真幌", "text": "アーヤ達が身体を張って、\n頑張ってくれたんだ。"},
        { "location": "562/TALK"    , "narrator": "雛", "text": "え？　綾水様が？\nフリフリの衣装で、\n歌って踊る…？"},
        { "location": "563/TALK"    , "narrator": "雛", "text": "…ど、どういうこと？\nあたし、耳おかしく\nなっちゃったかなー？"},
        { "location": "564/TALK"    , "narrator": "キリト", "text": "俺も…なんか、\n変なことを聞いた\nようなするんだが…。"},
        { "location": "567/TALK"    , "narrator": "アーヤ", "text": "も、もうそれくらいで\n十分です！"},
        { "location": "568/TALK"    , "narrator": "アーヤ", "text": "それ以上話す必要は\nないですよ！"},
        { "location": "570/TALK"    , "narrator": "真幌", "text": "あのな…おまえ達に\nとっては恥ずかしいこと\nかもしれんが――"},
        { "location": "571/TALK"    , "narrator": "真幌", "text": "フェノメノンでの戦闘で\nある以上、あれだって\n立派な武勇伝だぞ？"},
        { "location": "572/TALK"    , "narrator": "真幌", "text": "恥ずかしがらないで、\n胸を張れ！"},
        { "location": "573/TALK"    , "narrator": "ガブリエラ", "text": "あれを恥ずかしいと\n思えなくなったら\nおしまいだから！"},
        { "location": "575/TALK"    , "narrator": "真幌", "text": "さっきも言ったが、\nギャヴィは本当に\n可愛かったぞ？"},
        { "location": "577/TALK"    , "narrator": "真幌", "text": "ただ、アーヤは年齢的に\n色々ヤバくて――"},
        { "location": "578/TALK"    , "narrator": "真幌", "text": "正直、見ていて\nイタイタしくて\n堪らなかったが…。"},
        { "location": "579/TALK"    , "narrator": "神楽", "text": "何言ってるんですか！？\nそれが良いんじゃない\nですか！！"},
        { "location": "580/TALK"    , "narrator": "神楽", "text": "年齢不相応の服を着て\n恥じらう可愛さが――"},
        { "location": "581/TALK"    , "narrator": "神楽", "text": "文句なしのパーフェクト\nでしたよ！"},
        { "location": "583/TALK"    , "narrator": "雛", "text": "…………。"},
        { "location": "585/TALK"    , "narrator": "雛", "text": "…わかるかも！"},
        { "location": "587/TALK"    , "narrator": "神楽", "text": "さすがひなこさんです！"},
        { "location": "590/TALK"    , "narrator": "アーヤ", "text": "…か、館長？\nそろそろ酔いを醒ました\n方が良いですよ？"},
        { "location": "592/TALK"    , "narrator": "ガブリエラ", "text": "うん…ちょっとハメを\n外し過ぎてるわ…。"},
        { "location": "594/TALK"    , "narrator": "真幌", "text": "わかったわかった…。"},
        { "location": "596/TALK"    , "narrator": "真幌", "text": "じゃあ、最後に二人が\nノリノリで歌った歌を\n聞かせて――"},
        { "location": "598/TALK"    , "narrator": "アーヤ", "text": "館長！"},
        { "location": "600/TALK"    , "narrator": "ガブリエラ", "text": "頭冷やせ！"},
        { "location": "604/TALK"    , "narrator": "真幌", "text": "んぁ？　わぷっ！！"},
        { "location": "607/TALK"    , "narrator": "雛", "text": "うわっ！？\nし、東雲教官！？"},
        { "location": "609/TALK"    , "narrator": "神楽", "text": "…コップの水、\n掛けられちゃいましたね。"},
        { "location": "611/TALK"    , "narrator": "神楽", "text": "まあ、調子に乗り過ぎた\n真幌さんの、自業自得\nですけど。"},
        { "location": "612/TALK"    , "narrator": "アーヤ", "text": "…さてと、他に話の\n続きを聞きたい、って\n人はいるかしら？"},
        { "location": "613/TALK"    , "narrator": "ガブリエラ", "text": "いたら挙手しなさい。\n頭から水ぶっかけて\nやるから。"},
        { "location": "616/TALK"    , "narrator": "キリト", "text": "い、いや、いいっす…。"},
        { "location": "618/TALK"    , "narrator": "雛", "text": "まあ、もう十分過ぎる\nくらい聞いちゃった\n気もするんだけど…。"},
        { "location": "375/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月23日　 0:08 PM</color>\n合宿中、みやびの実家にて"},
        { "location": "525/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch02", "text": "【みんなでうた】"}
    ]
}
