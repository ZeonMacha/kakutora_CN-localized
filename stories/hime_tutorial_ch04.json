    "entry":
    [
        { "location": "350/SCENARIO", "narrator": "", "text": "ハッカーＪＫ危機一髪"},
        { "location": "378/TALK"    , "narrator": "みやび", "text": "やっぱり"},
        { "location": "379/TALK"    , "narrator": "みやび", "text": "女子高生としては"},
        { "location": "380/TALK"    , "narrator": "みやび", "text": "危機に直面する局面が必要と思われる"},
        { "location": "390/SEL"     , "narrator": "", "text": "必要なくない？"},
        { "location": "391/SEL"     , "narrator": "", "text": "テストの点が悪かった？"},
        { "location": "392/SEL"     , "narrator": "", "text": "日々がサスペンスに満ちてるよね"},
        { "location": "398/ACT"     , "narrator": "", "text": "必要なくない？"},
        { "location": "399/TALK"    , "narrator": "みやび", "text": "なんと"},
        { "location": "400/TALK"    , "narrator": "みやび", "text": "ノリが悪いの"},
        { "location": "401/ACT"     , "narrator": "", "text": "テストの点が悪かった？"},
        { "location": "402/TALK"    , "narrator": "みやび", "text": "まさか"},
        { "location": "403/TALK"    , "narrator": "みやび", "text": "いつでも合格点ぞね"},
        { "location": "404/TALK"    , "narrator": "みやび", "text": "ぎりぎりだがの"},
        { "location": "405/ACT"     , "narrator": "", "text": "日々がサスペンスに満ちてるよね"},
        { "location": "417/TALK"    , "narrator": "みやび", "text": "左様"},
        { "location": "418/TALK"    , "narrator": "みやび", "text": "しかし"},
        { "location": "419/TALK"    , "narrator": "みやび", "text": "具体的には？"},
        { "location": "421/SEL"     , "narrator": "", "text": "昼ドラっぽい？"},
        { "location": "422/SEL"     , "narrator": "", "text": "ハリウッド映画でしょ！"},
        { "location": "423/SEL"     , "narrator": "", "text": "日常に忍び寄る狂気"},
        { "location": "424/ACT"     , "narrator": "", "text": "昼ドラっぽい？"},
        { "location": "425/TALK"    , "narrator": "みやび", "text": "聞かれても"},
        { "location": "426/TALK"    , "narrator": "みやび", "text": "それに昼ドラには"},
        { "location": "427/TALK"    , "narrator": "みやび", "text": "女子高生は滅多に出ん"},
        { "location": "428/ACT"     , "narrator": "", "text": "ハリウッド映画でしょ！"},
        { "location": "429/TALK"    , "narrator": "みやび", "text": "全米が色々するアレか"},
        { "location": "430/TALK"    , "narrator": "みやび", "text": "レッドカーペットを踏む日も近いの"},
        { "location": "431/TALK"    , "narrator": "みやび", "text": "セレブリティとして"},
        { "location": "432/ACT"     , "narrator": "", "text": "日常に忍び寄る狂気"},
        { "location": "433/TALK"    , "narrator": "みやび", "text": "確かにサスペンス"},
        { "location": "439/TALK"    , "narrator": "みやび", "text": "そしてうちの危機の際"},
        { "location": "440/TALK"    , "narrator": "みやび", "text": "$handle$と背中合わせて"},
        { "location": "442/TALK"    , "narrator": "みやび", "text": "共闘するという熱き展開"},
        { "location": "444/TALK"    , "narrator": "みやび", "text": "そうなる前に"},
        { "location": "445/TALK"    , "narrator": "みやび", "text": "うちの危機に気づけ"},
        { "location": "446/TALK"    , "narrator": "みやび", "text": "$handle$め"},
        { "location": "448/SEL"     , "narrator": "", "text": "がんばる"},
        { "location": "449/SEL"     , "narrator": "", "text": "気づかないわけがない"},
        { "location": "450/ACT"     , "narrator": "", "text": "がんばる"},
        { "location": "451/TALK"    , "narrator": "みやび", "text": "よしよし"},
        { "location": "452/ACT"     , "narrator": "", "text": "気づかないわけがない"},
        { "location": "453/TALK"    , "narrator": "みやび", "text": "当然だの"},
        { "location": "455/TALK"    , "narrator": "みやび", "text": "$handle$はうちのものだからな"},
        { "location": "395/DIALOG"  , "narrator": "Tutorial/Dialog_Tutorial_Candy", "text": "彼女たちとの会話では\n<color=red>【ココロキャンディ】</color>という\nものを消費して先へ進む。\n\n足りない場合、ジュエルで買うか、\nバトル等で貯めてからストーリーを\n再挑戦することになるから注意。\n\n<color=green>今回だけは使っても減らないから、\n好きな選択肢を選んでみて。</color>"},
        { "location": "415/DIALOG"  , "narrator": "Tutorial/Dialog_Tutorial_Love2", "text": "<color=red>【親密度】</color>を沢山貯めると\n彼女との関係性が変化していく。\n\n<color=green>【友達】</color>になり<color=orange>【恋人】</color>になり…\n更にその先まで発展するかも。\n頑張ってハートを集めて欲しい。\n\n集めたハートは<color=red>【PROFILE】</color>で\n確認できるわ。"},
        { "location": "437/DIALOG"  , "narrator": "Tutorial/Dialog_Tutorial_Camera", "text": "そうそう、ひとつお得情報。\n<color=red>カメラボタンを押すことで、\n彼女を見守る視点を変えられる。</color>\n\n今回はお試しでカメラを５つ\n用意しておいた。\n実際には<color=green>ゴキゲンポイント</color>で\n交換して増やしていくことに\nなるから、今のうちにいっぱい\n堪能しておくといいと思う。"}
    ]
}
