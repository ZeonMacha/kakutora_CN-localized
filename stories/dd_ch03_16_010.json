{
    "dir": "chap16/daydra/dd_ch03_16_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "16352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "お手の物"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "お手の物"},
        { "location": "29/TALK"   , "narrator": "雛", "text": "まったく…キリトにも\n困ったもんだよね。"},
        { "location": "30/TALK"   , "narrator": "雛", "text": "ガブリエラちゃんに、\nガスガンの修理を\n頼むなんて…。"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "う～ん…普通は\n女の子にする\nお願いじゃないよね？"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと。\nそれってあたしが普通じゃ\nないみたいじゃない？"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "普通じゃないのは\n確かだと思うわ。"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "っていうか、説明書も\nないのに、よくそんなに\nバラバラにできたわね？"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "そんなにしちゃって、\nちゃんと組み立て\nられるの？"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "平気よ。"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "実銃と構造が違うから、\n少し面倒だけど――"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "この程度の玩具なら、\n簡単に直せるわ。"},
        { "location": "47/TALK"   , "narrator": "雛", "text": "みたいだね…。\n話ながら、どんどん\n組み上がっていくし。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "…けど、ガスガンって\n実物触ったの初めてなん\nだけど――"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "意外とクオリティ\n高くて驚いたわ。"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "もっと玩具っぽいのを\n想像してたのに…。"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "ふ～ん…本物に慣れてる\nギャヴィが驚くほど\nなんだ？"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "ええ…これ、あたしも\n一丁欲しいかも…。"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "…でも、確かガスガンって\n対象年齢あったわよね？"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "あたしの年齢じゃ、\n多分買えないかな…。"},
        { "location": "65/SEL"    , "narrator": "", "text": "アーヤに買ってもらおう"},
        { "location": "66/SEL"    , "narrator": "", "text": "本物、持ってないの？"},
        { "location": "67/SEL"    , "narrator": "", "text": "自作、とか？"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "う～ん…でも、やっぱり\n一丁欲しいかも。"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "似たのでもいいから、\n手に入れる方法って\nないかしら？"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "…あ、そうだ！"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "アーヤ、今度通販で、\nあたしの代わりに\nガスガン買ってもらえる？"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "何で自分で買わないのよ？"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "年齢制限があるから、\nあたしじゃ買えないのよ。"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "でも、アーヤだったら\n問題なく買えるし…。"},
        { "location": "82/TALK"   , "narrator": "雛", "text": "代わりに買うのって、\n問題だと思うよ？"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "ダメかしら？"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "ダメに決まってるでしょ。"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "対象年齢がいくつかは\n知らないけど、それまで\n我慢しなさい。"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "…まあ、堅物のアーヤは\nそう言うと思ってたわ。"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "堅物とかいう問題じゃ\nないでしょ？"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "っていうか、話しながら\nやってて平気なの？"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "もう終わるわ…\nはい、出来上がり！"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "もう直ったの！？"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "中のバネが外れてたから、\n付け直しただけだもの。"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "結構楽しかったから、\n壊れたらまた持ってくる\nように伝えといて。"},
        { "location": "102/TALK"  , "narrator": "雛", "text": "…かっこいいけど、\n女の子のセリフには\n思えないなぁ…。"},
        { "location": "104/ACT"   , "narrator": "", "text": "アーヤに買ってもらおう"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "アーヤの年齢なら、間違いなく買えるわね"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "問題は、買ってくれるかどうかだけど…"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "アーヤ、今度通販で、\nあたしの代わりに\nガスガン買ってもらえる？"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "何で自分で買わないのよ？"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "年齢制限があるから、\nあたしじゃ買えないのよ。"},
        { "location": "144/TALK"  , "narrator": "ガブリエラ", "text": "でも、アーヤだったら\n成人してるから問題なく\n買えるし…。"},
        { "location": "145/TALK"  , "narrator": "雛", "text": "代わりに買うのって、\n問題だと思うよ？"},
        { "location": "148/TALK"  , "narrator": "ガブリエラ", "text": "ダメかしら？"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "ダメに決まってるでしょ。"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "対象年齢がいくつかは\n知らないけど、それまで\n我慢しなさい。"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、堅物のアーヤは\nそう言うと思ってたわ。"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "堅物とかいう問題じゃ\nないでしょ？"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "っていうか、話しながら\nやってて平気なの？"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "もう終わるわ…\nはい、出来上がり！"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "もう直ったの！？"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "中のバネが外れてたから、\n付け直しただけだもの。"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "結構楽しかったから、\n壊れたらまた持ってくる\nように伝えといて。"},
        { "location": "165/TALK"  , "narrator": "雛", "text": "…かっこいいけど、\n女の子のセリフには\n思えないなぁ…。"},
        { "location": "166/ACT"   , "narrator": "", "text": "本物、持ってないの？"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "持ってはいるけど、日本には持ってこれなかったの"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "トライナリーの特権でも、さすがに無理だったみたい"},
        { "location": "199/TALK"  , "narrator": "ガブリエラ", "text": "…心配だわ。"},
        { "location": "200/TALK"  , "narrator": "雛", "text": "やっぱり、説明書なしじゃ\n組み立てられない？"},
        { "location": "203/TALK"  , "narrator": "ガブリエラ", "text": "そうじゃなくて――"},
        { "location": "204/TALK"  , "narrator": "ガブリエラ", "text": "実家に置いてきた\n銃のことを思い出して\nたのよ。"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "あたしの代わりに、\nちゃんと手入れして\nもらってればいいけど…。"},
        { "location": "206/TALK"  , "narrator": "つばめ", "text": "銃って、やっぱり\nお手入れしないと\nダメなんですか？"},
        { "location": "207/TALK"  , "narrator": "ガブリエラ", "text": "あたしは定期的に\nしてたわ。"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "誤作動とか暴発とか、\n怖いもん。"},
        { "location": "210/TALK"  , "narrator": "雛", "text": "…ガブリエラちゃんから、\nハードボイルドなオーラを\n感じる気がするよ。"},
        { "location": "212/TALK"  , "narrator": "つばめ", "text": "お酒とか飲みながら\n銃を手入れするの、\n映画で見たことあります。"},
        { "location": "213/TALK"  , "narrator": "ガブリエラ", "text": "あたしは未成年よ！"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "でも、それだけしっかりと\n手入れしてたなら――"},
        { "location": "215/TALK"  , "narrator": "アーヤ", "text": "心配になる気持ちも、\n何となくわかるかも。"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "まあ、手入れされてても\nされてなくても――"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "一度、全部手入れ\nしないといけないのは\n確かね。"},
        { "location": "221/TALK"  , "narrator": "ガブリエラ", "text": "…錆びたりしてないと\nいいんだけど。"},
        { "location": "222/ACT"   , "narrator": "", "text": "自作、とか？"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "さすがにそれは無理よ"},
        { "location": "243/TALK"  , "narrator": "ガブリエラ", "text": "仮に造れても、素人の私が造った銃じゃ、まともに動作するかわからないし"},
        { "location": "244/TALK"  , "narrator": "ガブリエラ", "text": "暴発のことも考えると、怖くて使えないわ"},
        { "location": "255/TALK"  , "narrator": "ガブリエラ", "text": "…うん、これで完成！\n修理完了よ。"},
        { "location": "256/TALK"  , "narrator": "雛", "text": "ありがとー。\nキリトに返しておくよ。"},
        { "location": "259/TALK"  , "narrator": "ガブリエラ", "text": "ふぅ…玩具でも、\n銃の手入れが出来て\n楽しかったわ。"},
        { "location": "262/TALK"  , "narrator": "ガブリエラ", "text": "…やっぱり、一から造る\nよりも、こっちの方が\n性に合ってるわね。"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月21日　3:55 PM</color>\nとある平日の放課後、神楽坂トライナリー劇場でのバイト中のこと。"}
    ]
}
