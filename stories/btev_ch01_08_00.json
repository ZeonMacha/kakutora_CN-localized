        "title": "013 ココロスフィアストーリー【Lv05】",
        "sub_title": "どきがむねむねする＜提起＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "どきがむねむねする理由"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 05</size>\nTSUBAME - OHSE\n\n<size=40>どきがむねむねする</size>\n<size=35>～それは何かヘンですね～</size>"},
        { "location": "29/TALK"   , "narrator": "神楽", "text": "はあっ！\nもう、つばめさんったら\n本当に可愛いですね！"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "えーっ、\nそんなことないよぅ。"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "卯月さんの方が\n全然かわいいし。"},
        { "location": "35/TALK"   , "narrator": "神楽", "text": "そんな謙遜しちゃう\nところも、とっても\nキュートですっ！"},
        { "location": "37/TALK"   , "narrator": "神楽", "text": "でもそんなに\n可愛いことばかり\n言ってると――"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "また色んなトコ\n揉んじゃいますよっ？"},
        { "location": "41/SEL"    , "narrator": "（選択肢）", "text": "じーっ"},
        { "location": "42/SEL"    , "narrator": "（選択肢）", "text": "ガタッ！"},
        { "location": "43/ACT"    , "narrator": "", "text": "じーっ"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "ええええっ！！\nこ、今度は\nどこなのかなぁ～…っ"},
        { "location": "46/TALK"   , "narrator": "神楽", "text": "…？"},
        { "location": "49/TALK"   , "narrator": "神楽", "text": "つばめさん、\nあの人は誰ですか？"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "えっ？"},
        { "location": "52/ACT"    , "narrator": "", "text": "ガタッ！"},
        { "location": "56/TALK"   , "narrator": "神楽", "text": "キャッ！"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "つ、つばめさん！\nこの人誰ですかっ？"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "あっ、え、ええと…"},
        { "location": "63/SEL"    , "narrator": "（選択肢）", "text": "照れずに紹介してよ"},
        { "location": "64/SEL"    , "narrator": "（選択肢）", "text": "$handle$です(ｷﾘｯ"},
        { "location": "65/ACT"    , "narrator": "", "text": "照れずに紹介してよ"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "べ、別に照れてる\nわけじゃないよ！"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "この人は\n$handle$さんだよ。"},
        { "location": "71/TALK"   , "narrator": "神楽", "text": "なんだ、つばめさんの\n知り合いなんですね。"},
        { "location": "72/ACT"    , "narrator": "", "text": "$handle$です(ｷﾘｯ"},
        { "location": "73/TALK"   , "narrator": "神楽", "text": "………。"},
        { "location": "75/TALK"   , "narrator": "神楽", "text": "つばめさんの\n知り合いですか？"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "えっ？\nあ、うん。そうだよ？"},
        { "location": "78/TALK"   , "narrator": "神楽", "text": "ふーん……\nつばめさんって案外…"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "え？"},
        { "location": "81/TALK"   , "narrator": "神楽", "text": "いえ、\nなんでもありません。"},
        { "location": "83/TALK"   , "narrator": "神楽", "text": "それより、どうして急に\n$handle$さんを\n呼んだんですか？"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "いや、\n私が呼んだわけじゃ…"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "ああっ！\nわかりましたっ！\nつばめさん……"},
        { "location": "89/TALK"   , "narrator": "神楽", "text": "人に見られながら\n色々されちゃうのが\nいいんですねっ！"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "ち、ちがうよ～～！"},
        { "location": "93/TALK"   , "narrator": "神楽", "text": "照れなくても\nいいんですよっ！"},
        { "location": "94/SEL"    , "narrator": "（選択肢）", "text": "あ、あのー……"},
        { "location": "95/SEL"    , "narrator": "（選択肢）", "text": "$me$も混ぜて！"},
        { "location": "96/SEL"    , "narrator": "（選択肢）", "text": "$me$という者がありながらなんてことを！"},
        { "location": "97/ACT"    , "narrator": "", "text": "あ、あのー……"},
        { "location": "99/TALK"   , "narrator": "神楽", "text": "あっ！\nごめんなさい！"},
        { "location": "101/TALK"  , "narrator": "神楽", "text": "つばめさん、\n$handle$さんも\n混ざりたいみたいです！"},
        { "location": "103/TALK"  , "narrator": "神楽", "text": "せっかくですから、\n３人で\n楽しみましょうっ！"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "えっ？"},
        { "location": "107/SEL"   , "narrator": "（選択肢）", "text": "あ、いや…"},
        { "location": "108/ACT"   , "narrator": "", "text": "あ、いや…"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "う、うん。\n全然いいけど……"},
        { "location": "114/ACT"   , "narrator": "", "text": "$me$も混ぜて！"},
        { "location": "116/TALK"  , "narrator": "神楽", "text": "もちろんですっ！"},
        { "location": "118/TALK"  , "narrator": "神楽", "text": "ね、つばめさん？\n３人で楽しみましょう！"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "え？\nあ、うん……いいよ？"},
        { "location": "121/SEL"   , "narrator": "（選択肢）", "text": "えっ！？ほんと？"},
        { "location": "122/ACT"   , "narrator": "", "text": "えっ！？ほんと？"},
        { "location": "124/ACT"   , "narrator": "", "text": "$me$という者がありながらなんてことを！"},
        { "location": "126/TALK"  , "narrator": "神楽", "text": "きゃー！\nそういう関係だったん\nですねっ！"},
        { "location": "128/TALK"  , "narrator": "神楽", "text": "なら、３人で\n楽しみましょうっ！"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "え……えええっ！？"},
        { "location": "131/TALK"  , "narrator": "つばめ", "text": "ま、まあ、いいけど…"},
        { "location": "132/SEL"   , "narrator": "（選択肢）", "text": "えっ！？本気？"},
        { "location": "133/ACT"   , "narrator": "", "text": "えっ！？本気？"},
        { "location": "137/TALK"  , "narrator": "神楽", "text": "流石つばめさんですっ！"},
        { "location": "138/TALK"  , "narrator": "潜在つばめ", "text": "ちょっと待って！！"},
        { "location": "142/TALK"  , "narrator": "神楽", "text": "あらっ！"},
        { "location": "144/TALK"  , "narrator": "つばめ", "text": "わ、わたし！？"},
        { "location": "145/TALK"  , "narrator": "潜在つばめ", "text": "ちょっと、そこの\nわたしと卯月さん！\n二人ともどうかしてる！"},
        { "location": "146/SEL"   , "narrator": "（選択肢）", "text": "ですよねー"},
        { "location": "147/SEL"   , "narrator": "（選択肢）", "text": "そんなことないよ！"},
        { "location": "148/ACT"   , "narrator": "", "text": "ですよねー"},
        { "location": "149/ACT"   , "narrator": "", "text": "そんなことないよ！"},
        { "location": "152/TALK"  , "narrator": "潜在つばめ", "text": "$handle$さんは\n黙ってて！"},
        { "location": "154/TALK"  , "narrator": "神楽", "text": "あっ…と、私ちょっと\nお花を摘みに\n行ってきますね！"},
        { "location": "159/TALK"  , "narrator": "潜在つばめ", "text": "さて。そこのわたし！\n一体何を考えてるの？"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "ええっ？\nな、何かおかしなこと\n言ったかなぁ？"},
        { "location": "162/TALK"  , "narrator": "潜在つばめ", "text": "３人で楽しみましょう\nなんて、卯月さんが\n言うわけないじゃん！"},
        { "location": "163/TALK"  , "narrator": "潜在つばめ", "text": "あなたの勝手な妄想で\nわたしのイメージを\n汚すのはやめて！"},
        { "location": "164/TALK"  , "narrator": "つばめ", "text": "汚してないよ！"},
        { "location": "166/TALK"  , "narrator": "潜在つばめ", "text": "そんなことない。\n$handle$さんも\nそう思うよね？"},
        { "location": "167/SEL"   , "narrator": "（選択肢）", "text": "イエス！つばめがイチャイチャすべきは$me$！"},
        { "location": "168/SEL"   , "narrator": "（選択肢）", "text": "いえ、３人の方が楽しいですよ？"},
        { "location": "169/ACT"   , "narrator": "", "text": "イエス！つばめがイチャイチャすべきは$me$！"},
        { "location": "170/TALK"  , "narrator": "潜在つばめ", "text": "それも違うよ。"},
        { "location": "171/ACT"   , "narrator": "", "text": "３人の方が楽しいですよ？"},
        { "location": "172/TALK"  , "narrator": "潜在つばめ", "text": "いいえ！"},
        { "location": "176/TALK"  , "narrator": "潜在つばめ", "text": "わたしがイチャコラ\nすべきなのは、\n卯月さんだけだよ！"},
        { "location": "177/SEL"   , "narrator": "（選択肢）", "text": "そっちですか！！"},
        { "location": "178/ACT"   , "narrator": "", "text": "そっちですか！！"},
        { "location": "181/TALK"  , "narrator": "潜在つばめ", "text": "卯月さんはすごく\n一途な子だよ。"},
        { "location": "182/TALK"  , "narrator": "潜在つばめ", "text": "だから、わたし以外の\n人とイチャコラしたいと\n思ったりなんてしない！"},
        { "location": "183/TALK"  , "narrator": "つばめ", "text": "そんなことないよ！\nだって卯月さんは\n東京の子なんだよ？"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "もっとずっと\n開放的なはずだよ！"},
        { "location": "188/TALK"  , "narrator": "潜在つばめ", "text": "$handle$さんは\nどっちの味方なの？"},
        { "location": "189/SEL"   , "narrator": "（選択肢）", "text": "３人で楽しむのに賛成"},
        { "location": "190/SEL"   , "narrator": "（選択肢）", "text": "２人のイチャコラを見ていたい"},
        { "location": "191/SEL"   , "narrator": "（選択肢）", "text": "どうやら$me$は要らない子のようなので去る"},
        { "location": "192/ACT"   , "narrator": "", "text": "３人で楽しむのに賛成"},
        { "location": "195/TALK"  , "narrator": "つばめ", "text": "やっぱり\nそう思うよね！"},
        { "location": "197/TALK"  , "narrator": "潜在つばめ", "text": "$handle$さんに\n理解してもらえない\nなんて残念だよ。"},
        { "location": "199/TALK"  , "narrator": "潜在つばめ", "text": "なら、そこのダメな\nわたしと一緒に\n追い出すまで！"},
        { "location": "201/TALK"  , "narrator": "つばめ", "text": "させないよ！"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "$handle$さん！\n一緒にこのわたしを\n追い出そう！"},
        { "location": "207/TALK"  , "narrator": "つばめ", "text": "そしたらその後は\n３人でイチャイチャ\nタイムだよ！"},
        { "location": "226/DIALOG", "narrator": "", "text": "<color=black><size=50><b>神楽としかイチャイチャしない\nつばめを倒せ！</b></size></color>\n\n\n\n彼女の中での神楽像は\nとても一途で純粋のようだ。\n\nしかしそれだと、神楽も交えての\n3人のお楽しみタイムが\n無くなってしまう！\n\nそれどころか、貴方とつばめとの\n関係まで冷えこんでしまうかも！？\nそうなる前に、さっさと倒してしまおう！"},
        { "location": "228/ACT"   , "narrator": "", "text": "２人のイチャコラを見ていたい"},
        { "location": "231/TALK"  , "narrator": "潜在つばめ", "text": "共感してくれて\n嬉しいよ。"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "酷いっ！　もういいよ！\n$handle$さんは\nここから出ていって！"},
        { "location": "235/TALK"  , "narrator": "潜在つばめ", "text": "出ていくのは\nあなたの方だよ！"},
        { "location": "237/TALK"  , "narrator": "潜在つばめ", "text": "$handle$さん！\nお願い。この子を追い\n出す力を貸して！"},
        { "location": "239/TALK"  , "narrator": "つばめ", "text": "させないよ！"},
        { "location": "258/DIALOG", "narrator": "", "text": "<color=black><size=50><b>3人でイチャイチャしようとする\nつばめを倒せ！</b></size></color>\n\n\n彼女の中での神楽像は\nとても開放的なようだ。\nしかしそれは、\nつばめの想い描く虚像に過ぎない。\n\n何より、貴方が期待する\nつばめと神楽のシチュエーションが\n水の泡となってしまう！\n\n3人で楽しみたいというつばめを倒し、\nふたりきりの花園を存分に堪能せよ！"},
        { "location": "260/ACT"   , "narrator": "", "text": "どうやら$me$は要らない子のようなので去る"},
        { "location": "262/TALK"  , "narrator": "潜在つばめ", "text": "え？"},
        { "location": "265/TALK"  , "narrator": "つばめ", "text": "そ、そんなつもりは\nないんだけど…"},
        { "location": "267/TALK"  , "narrator": "潜在つばめ", "text": "でも仕方ないよ。\n$handle$さんが\nいたくないなら。"},
        { "location": "269/TALK"  , "narrator": "つばめ", "text": "わたしたちだけで\n決着をつけるしか\nないよね。"},
        { "location": "282/TALK"  , "narrator": "千羽鶴", "text": "お早いお帰りね。"},
        { "location": "283/SEL"   , "narrator": "（選択肢）", "text": "$me$はのけ者にされた"},
        { "location": "284/ACT"   , "narrator": "", "text": "$me$はのけ者にされた"},
        { "location": "286/TALK"  , "narrator": "千羽鶴", "text": "あらそう。\nよしよし。"},
        { "location": "287/TALK"  , "narrator": "千羽鶴", "text": "$handle$は\nプライドが高いのね。"},
        { "location": "288/SEL"   , "narrator": "（選択肢）", "text": "つばめは$me$より神楽がいいみたいだし"},
        { "location": "289/ACT"   , "narrator": "", "text": "つばめは$me$より神楽がいいみたいだし"},
        { "location": "291/TALK"  , "narrator": "千羽鶴", "text": "ふむふむ、なるほど。\n確かにそうとも\nとれるかもしれない。"},
        { "location": "292/TALK"  , "narrator": "千羽鶴", "text": "そんな$handle$に\n私から１つだけ\nアドバイス。"},
        { "location": "293/TALK"  , "narrator": "千羽鶴", "text": "精神世界で起こっている\n事象はその殆どが\n極端な比喩で現れる。"},
        { "location": "294/TALK"  , "narrator": "千羽鶴", "text": "それはココロの何かを\n表現してはいるけど、\nそれ自体の事ではない。"},
        { "location": "295/TALK"  , "narrator": "千羽鶴", "text": "その奥にある真意を\n見つけ出してこそ、\n本当の彼女に出逢える。"},
        { "location": "296/TALK"  , "narrator": "千羽鶴", "text": "まずは達観して、\n彼女の全てを受け入れて\nみるのもいいかも。"},
        { "location": "298/TALK"  , "narrator": "千羽鶴", "text": "そのあたりを気にして\nもう一度挑戦してみて。"},
        { "location": "300/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\nいってらっしゃい。"}
    ]
}
