    "entry":
    [
        { "location": "1886/SCENARIO", "narrator": "", "text": "CZジャンプ台（みやび）"},
        { "location": "1898/TALK"    , "narrator": "千羽鶴", "text": "ここは\nコイガサコ博士の\n研究所跡地。"},
        { "location": "1899/TALK"    , "narrator": "千羽鶴", "text": "そしてジャンプ台が\nあったところでもある。"},
        { "location": "1900/TALK"    , "narrator": "千羽鶴", "text": "そしてこの\nジャンプ台は\nチートの象徴。"},
        { "location": "1901/TALK"    , "narrator": "千羽鶴", "text": "実はこのRPGゲームは\n國政綾水を倒して\n進むのが正道であり――"},
        { "location": "1902/TALK"    , "narrator": "千羽鶴", "text": "ジャンプ台を使うのは\n裏道として設定していた。"},
        { "location": "1903/TALK"    , "narrator": "千羽鶴", "text": "現実でもそうだけど――"},
        { "location": "1904/TALK"    , "narrator": "千羽鶴", "text": "恋ヶ崎みやびは\nトライナリーの\nジョーカーともいえる。"},
        { "location": "1905/TALK"    , "narrator": "千羽鶴", "text": "彼女は絶大なる\n能力を秘めてはいるけど、\n誰にも心を許さない。"},
        { "location": "1906/TALK"    , "narrator": "千羽鶴", "text": "だからこそ、\n普段から頼るべきは\n國政綾水であり――"},
        { "location": "1907/TALK"    , "narrator": "千羽鶴", "text": "恋ヶ崎みやびに何かを\n頼る場合は、何らかの\n代償を覚悟すべきである。"},
        { "location": "1908/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1909/TALK"    , "narrator": "千羽鶴", "text": "もちろん、\n情報管理庁長官としての\n立場の話。"},
        { "location": "1910/TALK"    , "narrator": "千羽鶴", "text": "貴方は相棒として、\nのんべんだらりと\n過ごしていればいい。"}
    ]
}
