    "entry":
    [
        { "location": "143/SCENARIO", "narrator": "", "text": "570_桃色によく似た雲"},
        { "location": "168/TALK"    , "narrator": "ガブリエラ", "text": "$handle$は"},
        { "location": "169/TALK"    , "narrator": "ガブリエラ", "text": "お天気の話"},
        { "location": "170/TALK"    , "narrator": "ガブリエラ", "text": "嫌いだったかしら？"},
        { "location": "172/SEL"     , "narrator": "", "text": "好き"},
        { "location": "173/SEL"     , "narrator": "", "text": "きらい"},
        { "location": "174/SEL"     , "narrator": "", "text": "どうでもいい"},
        { "location": "175/ACT"     , "narrator": "", "text": "好き"},
        { "location": "176/TALK"    , "narrator": "ガブリエラ", "text": "よかったわ"},
        { "location": "177/ACT"     , "narrator": "", "text": "きらい"},
        { "location": "178/TALK"    , "narrator": "ガブリエラ", "text": "残念だわ"},
        { "location": "179/TALK"    , "narrator": "ガブリエラ", "text": "でもね"},
        { "location": "180/ACT"     , "narrator": "", "text": "どうでもいい"},
        { "location": "181/TALK"    , "narrator": "ガブリエラ", "text": "でもね"},
        { "location": "183/TALK"    , "narrator": "ガブリエラ", "text": "今日見た雲は気に入ってくれるんじゃないかと思うの"},
        { "location": "186/SEL"     , "narrator": "", "text": "そうかな"},
        { "location": "187/SEL"     , "narrator": "", "text": "詳しく聞かせて"},
        { "location": "188/SEL"     , "narrator": "", "text": "どうだろう"},
        { "location": "189/ACT"     , "narrator": "", "text": "そうかな"},
        { "location": "190/ACT"     , "narrator": "", "text": "詳しく聞かせて"},
        { "location": "191/ACT"     , "narrator": "", "text": "どうだろう"},
        { "location": "193/TALK"    , "narrator": "ガブリエラ", "text": "夕暮れの空にふわふわした雲が出ていたのよ"},
        { "location": "194/TALK"    , "narrator": "ガブリエラ", "text": "まだ青い空に薄いピンクになった雲がかかっていたの"},
        { "location": "195/TALK"    , "narrator": "ガブリエラ", "text": "私、思わず立ち止まって空を眺めたの"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "それからね"},
        { "location": "198/SEL"     , "narrator": "", "text": "どうしたの"},
        { "location": "199/SEL"     , "narrator": "", "text": "何かあったの"},
        { "location": "200/ACT"     , "narrator": "", "text": "どうしたの"},
        { "location": "201/ACT"     , "narrator": "", "text": "何かあったの"},
        { "location": "203/TALK"    , "narrator": "ガブリエラ", "text": "この空を"},
        { "location": "204/TALK"    , "narrator": "ガブリエラ", "text": "貴方と一緒に見られたらいいわねって"},
        { "location": "205/TALK"    , "narrator": "ガブリエラ", "text": "そう思ったの"},
        { "location": "207/SEL"     , "narrator": "", "text": "無理だね"},
        { "location": "208/SEL"     , "narrator": "", "text": "今見てるよ"},
        { "location": "209/SEL"     , "narrator": "", "text": "いつかきっと見よう"},
        { "location": "210/ACT"     , "narrator": "", "text": "無理だね"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "そんなこと"},
        { "location": "212/TALK"    , "narrator": "ガブリエラ", "text": "言わないでちょうだい"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "だいきらい"},
        { "location": "214/ACT"     , "narrator": "", "text": "今見てるよ"},
        { "location": "215/TALK"    , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "嘘ばっかりね"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "いつか"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "本当になるのを信じてるわ"},
        { "location": "220/ACT"     , "narrator": "", "text": "いつかきっと見よう"},
        { "location": "230/TALK"    , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "231/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "いつか絶対"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "そのときは"},
        { "location": "234/TALK"    , "narrator": "ガブリエラ", "text": "迎えに来てね"},
        { "location": "235/TALK"    , "narrator": "ガブリエラ", "text": "王子さま"},
        { "location": "226/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
    ]
}
