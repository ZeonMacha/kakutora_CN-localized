        { "location": "220/SCENARIO", "narrator": "", "text": "190_それがどうかして？"},
        { "location": "245/TALK"    , "narrator": "ガブリエラ", "text": "私の願いはひとつだけ"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "世界でひとつだけなのです"},
        { "location": "248/SEL"     , "narrator": "", "text": "願いを叶えてあげようか"},
        { "location": "249/SEL"     , "narrator": "", "text": "$handle$の願いを叶えて"},
        { "location": "250/TALK"    , "narrator": "ガブリエラ", "text": "どうすれば叶うのでしょうか"},
        { "location": "251/TALK"    , "narrator": "ガブリエラ", "text": "この願いは"},
        { "location": "252/TALK"    , "narrator": "ガブリエラ", "text": "誰かに言えばいいのでしょうか"},
        { "location": "253/TALK"    , "narrator": "ガブリエラ", "text": "この願いを"},
        { "location": "255/TALK"    , "narrator": "ガブリエラ", "text": "はあ・・・"},
        { "location": "268/ACT"     , "narrator": "", "text": "願いを叶えてあげようか"},
        { "location": "278/TALK"    , "narrator": "ガブリエラ", "text": "調子がいいのね"},
        { "location": "279/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "280/TALK"    , "narrator": "ガブリエラ", "text": "いい言葉だわね"},
        { "location": "281/TALK"    , "narrator": "ガブリエラ", "text": "叶えてちょうだい"},
        { "location": "282/ACT"     , "narrator": "", "text": "$handle$の願いを叶えて"},
        { "location": "283/TALK"    , "narrator": "ガブリエラ", "text": "私の願いを叶えてくれたら考えるわ"},
        { "location": "286/SEL"     , "narrator": "", "text": "それより"},
        { "location": "287/SEL"     , "narrator": "", "text": "最近思ってたんだけど"},
        { "location": "288/ACT"     , "narrator": "", "text": "それより"},
        { "location": "289/ACT"     , "narrator": "", "text": "最近思ってたんだけど"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "何？"},
        { "location": "294/SEL"     , "narrator": "", "text": "こういうの、友達っていうの？"},
        { "location": "295/SEL"     , "narrator": "", "text": "今ってどういう関係なのかな？"},
        { "location": "296/ACT"     , "narrator": "", "text": "こういうの、友達っていうの？"},
        { "location": "297/ACT"     , "narrator": "", "text": "今ってどういう関係なのかな？"},
        { "location": "299/TALK"    , "narrator": "ガブリエラ", "text": "貴方は私とヒカルくんの恋のキューピッドだから"},
        { "location": "300/TALK"    , "narrator": "ガブリエラ", "text": "友達じゃないんじゃないかしら"},
        { "location": "301/TALK"    , "narrator": "ガブリエラ", "text": "それに"},
        { "location": "302/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナでもないんだし"},
        { "location": "303/TALK"    , "narrator": "ガブリエラ", "text": "大体"},
        { "location": "305/TALK"    , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "306/TALK"    , "narrator": "ガブリエラ", "text": "何でもないわ"},
        { "location": "307/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんと役目を果たしてちょうだい"},
        { "location": "308/TALK"    , "narrator": "ガブリエラ", "text": "私が言いたいのはそれだけよ"},
