{
    "dir": "chap05/daydra/dd_ch04_05_030.js",
    "type": "MainStory",
    "info": {
        "story_id": "5459",
        "cid": "miyabi",
        "title": "Extra009 プレミアムストーリー",
        "sub_title": "落ち込みガブちゃん"
    },
    "entry":
    [
        { "location": "515/SCENARIO", "narrator": "", "text": "落ち込みガブちゃん"},
        { "location": "535/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "537/TALK"    , "narrator": "みやび", "text": "ガブちゃん？\nなんか元気なさそう\nやけんど…。"},
        { "location": "538/TALK"    , "narrator": "みやび", "text": "おーい、ガブちゃん。\nどうかしたが？"},
        { "location": "540/TALK"    , "narrator": "ガブリエラ", "text": "…別に。"},
        { "location": "541/TALK"    , "narrator": "みやび", "text": "…機嫌悪そうやね。\n何かあったん？"},
        { "location": "542/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "544/TALK"    , "narrator": "みやび", "text": "話くらいなら\n聞くけんど？"},
        { "location": "546/TALK"    , "narrator": "ガブリエラ", "text": "もう、うるさい！\n放っといて！"},
        { "location": "549/TALK"    , "narrator": "みやび", "text": "あっ…。"},
        { "location": "550/TALK"    , "narrator": "みやび", "text": "…行ってしもうた。\n何があったんやろう？"},
        { "location": "555/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ、\n荒れてるわね。"},
        { "location": "557/TALK"    , "narrator": "みやび", "text": "アーヤ…\n何か知ってるが？"},
        { "location": "558/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "560/TALK"    , "narrator": "アーヤ", "text": "学校でね、\nクラスメイトに\n声をかけたらしいの。"},
        { "location": "561/TALK"    , "narrator": "アーヤ", "text": "放課後、一緒に\nカフェでも\n行かないか、って。"},
        { "location": "563/TALK"    , "narrator": "みやび", "text": "…ガブちゃんから\n行動するとは、\nビックリやね。"},
        { "location": "565/TALK"    , "narrator": "アーヤ", "text": "そうね…けど、\n断られたみたいなの。"},
        { "location": "566/TALK"    , "narrator": "アーヤ", "text": "避けられてる、って\nわけじゃないみたい\nだけど――"},
        { "location": "567/TALK"    , "narrator": "アーヤ", "text": "やっぱり、少しだけ\n距離を開けられてる\nみたい。"},
        { "location": "568/TALK"    , "narrator": "みやび", "text": "…そうやったんか。\nガブちゃん、ショック\nやったろうね。"},
        { "location": "569/TALK"    , "narrator": "アーヤ", "text": "そういうわけだから、\n今はそっとしておいた\n方がいいわ。"},
        { "location": "570/TALK"    , "narrator": "アーヤ", "text": "下手に刺激しても、\n大爆発しちゃう\nだろうし。"},
        { "location": "573/TALK"    , "narrator": "みやび", "text": "…ん、わかった。"},
        { "location": "578/TALK"    , "narrator": "みやび", "text": "…さて、と。"},
        { "location": "590/TALK"    , "narrator": "みやび", "text": "なあ、相棒"},
        { "location": "591/TALK"    , "narrator": "みやび", "text": "もし、今からすることでうちが失敗したら"},
        { "location": "592/TALK"    , "narrator": "みやび", "text": "その時は、慰めてもらえるか？"},
        { "location": "594/SEL"     , "narrator": "", "text": "何をする気なの？"},
        { "location": "595/ACT"     , "narrator": "", "text": "何をする気なの？"},
        { "location": "597/TALK"    , "narrator": "みやび", "text": "ガブちゃんのとこに行くんよ"},
        { "location": "598/TALK"    , "narrator": "みやび", "text": "アーヤにはああ言われたけんど、\n放ってはおけんきね"},
        { "location": "599/TALK"    , "narrator": "みやび", "text": "ちゅうても、何をするわけでも\nないんやけんど"},
        { "location": "600/TALK"    , "narrator": "みやび", "text": "怒らせてしもうた時は、\nうちのこと、慰めてほしいんよ"},
        { "location": "602/SEL"     , "narrator": "", "text": "わかった、頑張って！"},
        { "location": "603/SEL"     , "narrator": "", "text": "放っておいた方が良い"},
        { "location": "604/ACT"     , "narrator": "", "text": "わかった、頑張って！"},
        { "location": "606/TALK"    , "narrator": "みやび", "text": "何を頑張ればえいのか、さっぱりやけんどね"},
        { "location": "607/TALK"    , "narrator": "みやび", "text": "すまんな、相棒にまで世話かけて"},
        { "location": "608/TALK"    , "narrator": "みやび", "text": "じゃ、準備するちや"},
        { "location": "621/TALK"    , "narrator": "みやび", "text": "…とりあえず、\nコンビニでえいか。"},
        { "location": "634/TALK"    , "narrator": "ガブリエラ", "text": "はぁ……。"},
        { "location": "635/TALK"    , "narrator": "ガブリエラ", "text": "何よ、最初の頃は\nあんなに向こうから\n声かけてきたくせに。"},
        { "location": "636/TALK"    , "narrator": "ガブリエラ", "text": "…あたし、別に何も\nしてないのに。"},
        { "location": "637/TALK"    , "narrator": "ガブリエラ", "text": "…結構、勇気出して\n声かけたのに。"},
        { "location": "639/TALK"    , "narrator": "ガブリエラ", "text": "ぐすっ…。"},
        { "location": "642/TALK"    , "narrator": "みやび", "text": "ガブちゃん、おつ～。"},
        { "location": "646/TALK"    , "narrator": "ガブリエラ", "text": "きゃぁっ！？"},
        { "location": "648/TALK"    , "narrator": "みやび", "text": "おっ、可愛い声やね。\nどうかしたが？"},
        { "location": "651/TALK"    , "narrator": "ガブリエラ", "text": "そ、そそ、それは\nこっちのセリフよ、\nバカ！！"},
        { "location": "652/TALK"    , "narrator": "ガブリエラ", "text": "ノックも挨拶もなしに\n人の部屋入って来る\nとか、何考えてるの！？"},
        { "location": "653/TALK"    , "narrator": "みやび", "text": "すまんすまん。"},
        { "location": "654/TALK"    , "narrator": "みやび", "text": "けんど、どうしても\nガブちゃんとチョコを\n食べたい思うたら――"},
        { "location": "656/TALK"    , "narrator": "みやび", "text": "自分を抑えられなく\nなってしもうたんよ。"},
        { "location": "657/TALK"    , "narrator": "ガブリエラ", "text": "はぁ！？　っていうか、\nその大きいコンビニの\n袋って…。"},
        { "location": "658/TALK"    , "narrator": "みやび", "text": "チョコレートちや。\nコンビニで美味そうなん、\n適当に買ってきたんよ。"},
        { "location": "659/TALK"    , "narrator": "みやび", "text": "さあ、食べよ食べよ。\nほれ、ストロベリー\n入りのもあるがよ。"},
        { "location": "660/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、待ってよ！\nあたし、食べるなんて\n一言も…。"},
        { "location": "661/TALK"    , "narrator": "みやび", "text": "えいから、ほら。\n一つ口に入れてみぃ。"},
        { "location": "663/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "664/TALK"    , "narrator": "みやび", "text": "頑固やねぇ…。\nまあ、それならうちが\n食べるき、えいよ。"},
        { "location": "665/TALK"    , "narrator": "みやび", "text": "あむっ…"},
        { "location": "666/TALK"    , "narrator": "みやび", "text": "んんっ！？"},
        { "location": "667/TALK"    , "narrator": "みやび", "text": "思うてたより濃厚で、\n口ん中が一瞬で\nチョコの味まみれや。"},
        { "location": "668/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "669/TALK"    , "narrator": "みやび", "text": "次は、こっちのにするか。"},
        { "location": "670/TALK"    , "narrator": "みやび", "text": "あむっ…んむんむ…。"},
        { "location": "671/TALK"    , "narrator": "みやび", "text": "…こっちは薄いけんど、\n優しい甘さやね。"},
        { "location": "673/TALK"    , "narrator": "ガブリエラ", "text": "…聞かないの？\n何かあったのか、って。"},
        { "location": "675/TALK"    , "narrator": "みやび", "text": "うち、ガブちゃんと\nチョコ食べよう思うて\n来ただけや。"},
        { "location": "676/TALK"    , "narrator": "みやび", "text": "ほれ、早く食べんと、\n全部うちが食べてしまう\nぞね？"},
        { "location": "678/TALK"    , "narrator": "ガブリエラ", "text": "…あたしからは、\n話さないからね？"},
        { "location": "679/TALK"    , "narrator": "みやび", "text": "話さんでえいから、\nほれ、\nチョコ食べるちや。"},
        { "location": "681/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "683/TALK"    , "narrator": "ガブリエラ", "text": "あむっ…。"},
        { "location": "685/TALK"    , "narrator": "みやび", "text": "どうや？"},
        { "location": "687/TALK"    , "narrator": "ガブリエラ", "text": "…美味しいわ。"},
        { "location": "688/TALK"    , "narrator": "みやび", "text": "そうか…もっとあるき、\nどんどん食べるんよ。"},
        { "location": "690/TALK"    , "narrator": "ガブリエラ", "text": "…本当、絶対に\n話さないからね？"},
        { "location": "692/TALK"    , "narrator": "みやび", "text": "食べながら話すんは\n行儀も悪いきね。"},
        { "location": "693/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "696/TALK"    , "narrator": "ガブリエラ", "text": "…ありがと。\n一緒にいてくれて。"},
        { "location": "697/TALK"    , "narrator": "みやび", "text": "…うん。"},
        { "location": "699/TALK"    , "narrator": "ガブリエラ", "text": "…そっちの、\nマシュマロチョコも\n開けていい？"},
        { "location": "700/TALK"    , "narrator": "みやび", "text": "もちろんや。\n全部開けて、テーブルに\n広げても構わないんよ。"},
        { "location": "701/TALK"    , "narrator": "みやび", "text": "好きなように、\n好きなだけ\n食べればえいちや。"},
        { "location": "727/ACT"     , "narrator": "", "text": "放っておいた方が良い"},
        { "location": "728/TALK"    , "narrator": "みやび", "text": "相棒はアーヤと同じような考えなが？"},
        { "location": "729/TALK"    , "narrator": "みやび", "text": "まあ、確かに今のガブちゃんに近づくと、大爆発起こしそうではあるけんど"},
        { "location": "730/TALK"    , "narrator": "みやび", "text": "そんなときに部屋に一人でいるんは、いつも以上に寂しいと思うんよ"},
        { "location": "731/TALK"    , "narrator": "みやび", "text": "それに、一人で爆発するより、誰かに爆発した方が気持ちもスッキリするやろうしね"},
        { "location": "732/TALK"    , "narrator": "みやび", "text": "まあ、爆発されたら、いくらうちでもグサッとは来るき――"},
        { "location": "733/TALK"    , "narrator": "みやび", "text": "その時の慰め役に、相棒にはなってもらいたいんよ"},
        { "location": "735/SEL"     , "narrator": "", "text": "わかった、頑張って！"},
        { "location": "736/SEL"     , "narrator": "", "text": "結果は見えてるよ"},
        { "location": "737/ACT"     , "narrator": "", "text": "わかった、頑張って！"},
        { "location": "738/TALK"    , "narrator": "みやび", "text": "何を頑張ればえいのか、さっぱりやけんどね"},
        { "location": "739/TALK"    , "narrator": "みやび", "text": "すまんな、相棒にまで世話かけて"},
        { "location": "740/TALK"    , "narrator": "みやび", "text": "じゃ、準備するちや"},
        { "location": "742/ACT"     , "narrator": "", "text": "結果は見えてるよ"},
        { "location": "743/TALK"    , "narrator": "みやび", "text": "…なら、うちが勝手にやるだけや"},
        { "location": "755/TALK"    , "narrator": "みやび", "text": "…薄情な奴や、\nまったく。"},
        { "location": "756/TALK"    , "narrator": "みやび", "text": "さてと、\n急いで準備せんと…。"},
        { "location": "524/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月16日　4:23 PM</color>\nとある平日の夕方、神楽坂トライナリー楽屋にて。"},
        { "location": "712/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch04", "text": "【笑わせるか笑われるか、それが問題だ】"},
        { "location": "723/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
