{
    "dir": "chap03/daydra/dd_ch03_03_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "3302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "ガブリエラという存在＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ガブリエラ導入"},
        { "location": "29/TALK"   , "narrator": "ガブリエラ", "text": "まったく、ちょこまか\nちょこまかと…。"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "ああもうっ！！\n今、チャンスだったのに！"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "ただでさえ標的との\n距離が近過ぎて、狙い辛い\nってのに…。"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "…足を撃って動けなく\nすれば…。"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "って、それじゃこっちの\n位置がバレるか。"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、発症者も\nウイルスによる被害者\nとして扱えなんて――"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "甘過ぎるのよ。\nこれじゃ、何のための\n戦いかわからないわ。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "ポーランドだったら、\n二人ともとっくに\n撃ち殺してるのに…。"},
        { "location": "44/TALK"   , "narrator": "真幌", "text": "ギャヴィ、状況は？"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "…ターゲット補足中。\nいつでも撃てるのに…。"},
        { "location": "56/TALK"   , "narrator": "真幌", "text": "そうか。"},
        { "location": "57/TALK"   , "narrator": "真幌", "text": "いいか、狙いはあくまでも\n発症者の持っている剣\nだからな。"},
        { "location": "58/TALK"   , "narrator": "真幌", "text": "絶対に人を撃つなよ。"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "…わかってるわよ。"},
        { "location": "60/TALK"   , "narrator": "真幌", "text": "我々は可能な限り、\n発症者を傷つけず――"},
        { "location": "61/TALK"   , "narrator": "真幌", "text": "五体満足の状態で\n事態を収束させることが\n任務なんだ。"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "だから、わかってるって。"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "じゃなきゃ、とっくに\n引き金を引いてるわ。"},
        { "location": "64/TALK"   , "narrator": "真幌", "text": "…そうだな。"},
        { "location": "65/TALK"   , "narrator": "真幌", "text": "とにかく、民間人には\nかすり傷一つ負わせることは\n許さん。"},
        { "location": "66/TALK"   , "narrator": "真幌", "text": "それと、もし撃てそうに\nないなら無理をせず、\n牽制だけに留めろ。"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "っ！！"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "無理じゃないわ！\nこれくらいの距離なら、\n絶対に外さないし。"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "それに、牽制程度で\n怯むような相手には\n思えないし――"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "あの剣を破壊しない限り、\n今の状況が良くなるとも\n思えないわ。"},
        { "location": "73/TALK"   , "narrator": "真幌", "text": "…………。"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "心配無用よ。\nあたしは狙った物以外は\n当てないから。"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "チャンスが来たら、\n一発で撃ち抜いてやるわ。"},
        { "location": "76/TALK"   , "narrator": "真幌", "text": "…相変わらず、負けん気の\n強い奴だ。"},
        { "location": "77/TALK"   , "narrator": "真幌", "text": "いや、若い証拠か…。"},
        { "location": "78/TALK"   , "narrator": "真幌", "text": "わかった。\n現場のおまえに任せる。"},
        { "location": "79/TALK"   , "narrator": "真幌", "text": "ただし、絶対に――"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "人を撃つな、でしょ？\nらじゃ！"},
        { "location": "81/TALK"   , "narrator": "真幌", "text": "期待している。"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "…やってやるわよ。"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "あたしの腕は、軍や警察\nからも引っ張りだこになる\nほどなんだから。"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "それを全部蹴ってここに\nいるあたしに、無理を\nするなですって？"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "この程度、朝飯前――"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "なっ！？"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "あいつ、何やって…。"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "マズい、捕まった！！"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "身体が重なってる。\nこれじゃ狙い辛くて\n撃てないじゃない！"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "アーヤは…えっ！？\nあの抜け殻、まだあんなに\n離れたところにいるの！？"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "みやびも…ダメだわ。\nあの位置からじゃ\n間に合わない…。"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "やってやる。"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "あたしがやるしか…。"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "大丈夫…大丈夫よ。"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "落ち着いて、狙いを…。"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "くっ！！"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "大丈夫…忘れろ…。\n忘れろ、忘れろ！"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "今は集中しなくちゃ\nダメなんだから。"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "お願いだから、\n集中して…あたし！"},
        { "location": "185/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "194/TALK"  , "narrator": "千羽鶴", "text": "[ココロスフィア]の説明は\n前に私がしてると思うけど\nもう一度聞く？"},
        { "location": "195/SEL"   , "narrator": "", "text": "はい"},
        { "location": "196/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "197/ACT"   , "narrator": "", "text": "はい"},
        { "location": "198/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "200/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "208/TALK"  , "narrator": "千羽鶴", "text": "ようこそ。"},
        { "location": "209/SEL"   , "narrator": "", "text": "ここは…精神世界？"},
        { "location": "210/ACT"   , "narrator": "", "text": "ここは…精神世界？"},
        { "location": "212/TALK"  , "narrator": "千羽鶴", "text": "そう。\nバトル説明で入ったのと\n同じ、精神世界。"},
        { "location": "213/TALK"  , "narrator": "千羽鶴", "text": "ここは、後ろにいる\n彼女、ガブリエラの\n精神世界の入口――"},
        { "location": "214/TALK"  , "narrator": "千羽鶴", "text": "通称<color=red>【[ココロゲート]】</color>\nと呼ばれている場所。"},
        { "location": "215/TALK"  , "narrator": "千羽鶴", "text": "ここでは彼女は\nあなたと普通に\n対話できる。"},
        { "location": "216/TALK"  , "narrator": "千羽鶴", "text": "彼女の心に直接\n語りかけることで、\n心を動かすの。"},
        { "location": "217/TALK"  , "narrator": "千羽鶴", "text": "早速、\n彼女に話しかけてみて。"},
        { "location": "225/TALK"  , "narrator": "ガブリエラ", "text": "わあ、お客様だ！\n珍しいなぁ！"},
        { "location": "226/SEL"   , "narrator": "", "text": "はじめまして。$handle$です"},
        { "location": "227/ACT"   , "narrator": "", "text": "はじめまして。$handle$です"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "はじめまして～！\nあたしはガブリエラの\n[ココロの司書]よ！"},
        { "location": "231/SEL"   , "narrator": "", "text": "よろしく"},
        { "location": "232/SEL"   , "narrator": "", "text": "司書のことは知ってるよ"},
        { "location": "233/ACT"   , "narrator": "", "text": "よろしく"},
        { "location": "235/ACT"   , "narrator": "", "text": "司書のことは知ってるよ"},
        { "location": "239/SEL"   , "narrator": "", "text": "よろしく"},
        { "location": "240/ACT"   , "narrator": "", "text": "よろしく"},
        { "location": "245/TALK"  , "narrator": "ガブリエラ", "text": "まあ！\nココロの司書を知ってる\nですって？"},
        { "location": "246/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとビックリ\nしちゃったわよ？"},
        { "location": "247/TALK"  , "narrator": "ガブリエラ", "text": "でも、それなら\n説明の必要は無いわよね。"},
        { "location": "250/TALK"  , "narrator": "ガブリエラ", "text": "ふふっ♪\nよろしくね～。"},
        { "location": "251/SEL"   , "narrator": "", "text": "楽しそうだね"},
        { "location": "252/ACT"   , "narrator": "", "text": "楽しそうだね"},
        { "location": "254/TALK"  , "narrator": "ガブリエラ", "text": "そりゃそうよ～！\n何年ぶりかの\nお客様だもん。"},
        { "location": "255/TALK"  , "narrator": "ガブリエラ", "text": "ね、$handle$は、\nあたしにとっての\n正義の味方なの？"},
        { "location": "256/SEL"   , "narrator": "", "text": "そうさ！"},
        { "location": "257/SEL"   , "narrator": "", "text": "違う。悪の帝王だ。"},
        { "location": "258/ACT"   , "narrator": "", "text": "そうさ！"},
        { "location": "259/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり～！\nそうなのよね！"},
        { "location": "260/ACT"   , "narrator": "", "text": "違う。悪の帝王だ。"},
        { "location": "262/TALK"  , "narrator": "ガブリエラ", "text": "ええええっ！"},
        { "location": "263/TALK"  , "narrator": "ガブリエラ", "text": "おねがい、\nあたしを食べないで…"},
        { "location": "264/SEL"   , "narrator": "", "text": "それ、悪の帝王やないで…"},
        { "location": "265/SEL"   , "narrator": "", "text": "食べないよ！"},
        { "location": "266/SEL"   , "narrator": "", "text": "美味しそう！　じゅる"},
        { "location": "267/ACT"   , "narrator": "", "text": "それ、悪の帝王やないで…"},
        { "location": "269/TALK"  , "narrator": "ガブリエラ", "text": "え？\nそうなの？"},
        { "location": "270/TALK"  , "narrator": "ガブリエラ", "text": "てことは、\n$handle$は\n悪の帝王じゃないのね！"},
        { "location": "271/SEL"   , "narrator": "", "text": "なんでそうなる？　まあいいや"},
        { "location": "272/ACT"   , "narrator": "", "text": "なんでそうなる？　まあいいや"},
        { "location": "274/TALK"  , "narrator": "ガブリエラ", "text": "よかった♪"},
        { "location": "284/ACT"   , "narrator": "", "text": "食べないよ！"},
        { "location": "285/TALK"  , "narrator": "ガブリエラ", "text": "はぁ～\nよかった♪"},
        { "location": "295/ACT"   , "narrator": "", "text": "美味しそう！　じゅる"},
        { "location": "296/TALK"  , "narrator": "ガブリエラ", "text": "きゃあああ！！\n食べられちゃう！"},
        { "location": "297/TALK"  , "narrator": "ガブリエラ", "text": "どうしても食べるなら\nせめて優しく食べて――"},
        { "location": "307/TALK"  , "narrator": "ガブリエラ", "text": "って、そうだ！\nあのね、\nそれよりもね！"},
        { "location": "308/TALK"  , "narrator": "ガブリエラ", "text": "あたしを食べるより\nもっとお願いしたい事が\nあるのよ！"},
        { "location": "311/TALK"  , "narrator": "ガブリエラ", "text": "あのね――"},
        { "location": "314/TALK"  , "narrator": "ガブリエラ", "text": "んっと、"},
        { "location": "315/TALK"  , "narrator": "ガブリエラ", "text": "今ね、$handle$に\n手伝ってもらいたい\nことがあるの。"},
        { "location": "318/TALK"  , "narrator": "ガブリエラ", "text": "お願い、\nできるかしら！"},
        { "location": "319/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "320/SEL"   , "narrator": "", "text": "気が向いたら"},
        { "location": "321/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "322/TALK"  , "narrator": "ガブリエラ", "text": "ほんと！？\nありがとー！"},
        { "location": "323/ACT"   , "narrator": "", "text": "気が向いたら"},
        { "location": "324/TALK"  , "narrator": "ガブリエラ", "text": "うん！\nそれでいいわよ。"},
        { "location": "326/TALK"  , "narrator": "ガブリエラ", "text": "あのね、今ね、あたしが\n悩んじゃってるせいで、\n扉が開かないの。"},
        { "location": "327/SEL"   , "narrator": "", "text": "扉？"},
        { "location": "328/ACT"   , "narrator": "", "text": "扉？"},
        { "location": "330/TALK"  , "narrator": "ガブリエラ", "text": "え？\nあ、そうなのよ。\n後ろにある、あの扉。"},
        { "location": "331/TALK"  , "narrator": "ガブリエラ", "text": "この[ココロゲート]はね、\nあたしのココロの全てに\nアクセスできる所なの。"},
        { "location": "332/TALK"  , "narrator": "ガブリエラ", "text": "普段はそれが正常に\n機能していて、必要な\n時に扉は開くのよね？"},
        { "location": "333/TALK"  , "narrator": "ガブリエラ", "text": "でも、心の中に葛藤や\n恐怖、悩みが生まれると\n大変！"},
        { "location": "334/TALK"  , "narrator": "ガブリエラ", "text": "<color=red>【[クラン]】</color>が出てきて\n扉を塞いじゃうの。\nまさに今のようにね。"},
        { "location": "335/TALK"  , "narrator": "ガブリエラ", "text": "正しい扉が開けられないと\n間違った選択をして\n大変なことになっちゃう。"},
        { "location": "336/TALK"  , "narrator": "ガブリエラ", "text": "そして扉を開けるには、\nその<color=red>【[クラン]】</color>を\n倒さなきゃなんだけど。"},
        { "location": "337/TALK"  , "narrator": "ガブリエラ", "text": "今回みたいに大きな問題は\nなかなかあたし一人じゃ\n解決出来ないのよね。"},
        { "location": "338/TALK"  , "narrator": "ガブリエラ", "text": "今も、問題の扉の前では\nこの状況を打破したい\nあたしが戦ってるの。"},
        { "location": "339/TALK"  , "narrator": "ガブリエラ", "text": "で、$handle$には\nそのあたしを\n手伝って欲しいの！"},
        { "location": "341/SEL"   , "narrator": "", "text": "オッケー"},
        { "location": "342/SEL"   , "narrator": "", "text": "やだ"},
        { "location": "343/ACT"   , "narrator": "", "text": "オッケー"},
        { "location": "345/TALK"  , "narrator": "ガブリエラ", "text": "ホント！？\nありがとう～♪"},
        { "location": "346/ACT"   , "narrator": "", "text": "やだ"},
        { "location": "348/TALK"  , "narrator": "ガブリエラ", "text": "えーっ！\nそんな、酷いわよ。"},
        { "location": "349/TALK"  , "narrator": "ガブリエラ", "text": "お願いだから\n助けて頂戴？"},
        { "location": "353/SEL"   , "narrator": "", "text": "それで、どうすればいいの？"},
        { "location": "354/ACT"   , "narrator": "", "text": "それで、どうすればいいの？"},
        { "location": "357/TALK"  , "narrator": "ガブリエラ", "text": "今からその、<color=red>【[クラン]】</color>が\n塞いじゃってる扉を\nここに呼ぶのよね。"},
        { "location": "358/TALK"  , "narrator": "ガブリエラ", "text": "そうしたら、その扉を\n汚染してる<color=red>【[クラン]】</color>を\n倒して欲しいのよ。"},
        { "location": "360/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、\nその<color=red>【問題の扉】</color>を\nコールするわよ？"},
        { "location": "368/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x3EE番地から\n0x9C4番地へ。"},
        { "location": "383/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了～～♪"},
        { "location": "384/TALK"  , "narrator": "ガブリエラ", "text": "この扉に、今回の障害の\n根源になっている\n<color=red>【[クラン]】</color>がいるわ。"},
        { "location": "385/SEL"   , "narrator": "", "text": "ところで、今回銃が撃てない問題って何が原因なの？"},
        { "location": "386/ACT"   , "narrator": "", "text": "ところで、今回銃が撃てない問題って何が原因なの？"},
        { "location": "388/TALK"  , "narrator": "ガブリエラ", "text": "え？　あ、ああそうね。\nちょっと検索してみるわ。"},
        { "location": "394/TALK"  , "narrator": "ガブリエラ", "text": "ココロファイル\nNo.03-110-96に、\n書いてあるみたい。"},
        { "location": "395/TALK"  , "narrator": "ガブリエラ", "text": "これによれば――"},
        { "location": "396/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "397/TALK"  , "narrator": "ガブリエラ", "text": "………。"},
        { "location": "398/TALK"  , "narrator": "ガブリエラ", "text": "理由は……"},
        { "location": "401/TALK"  , "narrator": "ガブリエラ", "text": "理由は、ちょっとビックリ\nしちゃうことかもしれない\nわね。"},
        { "location": "402/SEL"   , "narrator": "", "text": "大丈夫"},
        { "location": "403/SEL"   , "narrator": "", "text": "怖い"},
        { "location": "404/ACT"   , "narrator": "", "text": "大丈夫"},
        { "location": "405/TALK"  , "narrator": "ガブリエラ", "text": "ほんとに？"},
        { "location": "406/TALK"  , "narrator": "ガブリエラ", "text": "わかったわ。\nそれじゃ、言うわね。"},
        { "location": "407/ACT"   , "narrator": "", "text": "怖い"},
        { "location": "408/TALK"  , "narrator": "ガブリエラ", "text": "そうね、ちょっと怖い\nお話になるかも。"},
        { "location": "409/TALK"  , "narrator": "ガブリエラ", "text": "でも、なるべく\n優しく伝えるから、\n聞いて頂戴ね。"},
        { "location": "411/TALK"  , "narrator": "ガブリエラ", "text": "あたしの家…\nポーランドにある実家の\nことなんだけど。"},
        { "location": "412/TALK"  , "narrator": "ガブリエラ", "text": "実は、まだあたしが初等部\nだった頃に――"},
        { "location": "413/TALK"  , "narrator": "ガブリエラ", "text": "強盗に入られた\nことがあるの。"},
        { "location": "414/SEL"   , "narrator": "", "text": "大丈夫だった！？"},
        { "location": "415/ACT"   , "narrator": "", "text": "大丈夫だった！？"},
        { "location": "418/TALK"  , "narrator": "ガブリエラ", "text": "え？\nあ、そうね。"},
        { "location": "419/TALK"  , "narrator": "ガブリエラ", "text": "…っと、あたしの\n身体は大丈夫だったわ。"},
        { "location": "420/TALK"  , "narrator": "ガブリエラ", "text": "でも、やっぱりほら、\nココロにキズが\nできちゃったのよ。"},
        { "location": "421/TALK"  , "narrator": "ガブリエラ", "text": "だから、特定の条件を\n満たしちゃうと、手の\n震えが止まらなくなるわ。"},
        { "location": "422/TALK"  , "narrator": "ガブリエラ", "text": "それは、今でも。"},
        { "location": "423/SEL"   , "narrator": "", "text": "大変だったね"},
        { "location": "424/SEL"   , "narrator": "", "text": "特定の条件って？"},
        { "location": "425/ACT"   , "narrator": "", "text": "大変だったね"},
        { "location": "426/TALK"  , "narrator": "ガブリエラ", "text": "ありがと。\nでも大丈夫。"},
        { "location": "427/ACT"   , "narrator": "", "text": "特定の条件って？"},
        { "location": "428/TALK"  , "narrator": "ガブリエラ", "text": "それは……ちょっと、\nあたしの口からは\n言いたくないわね。"},
        { "location": "429/TALK"  , "narrator": "ガブリエラ", "text": "でも、知りたいのなら\n深層世界の入口へ行けば\nきっと見られるわ。"},
        { "location": "430/TALK"  , "narrator": "ガブリエラ", "text": "多分どこかにあるから\n探してみてね。"},
        { "location": "432/TALK"  , "narrator": "ガブリエラ", "text": "とにかくね、その条件を\n満たすと、必ず今回の\nようにクランが出ちゃう。"},
        { "location": "433/TALK"  , "narrator": "ガブリエラ", "text": "だから、やっつけて\nココロを落ち着かせないと\nいけないのよね。"},
        { "location": "434/SEL"   , "narrator": "", "text": "そういうことなら任せて！"},
        { "location": "435/ACT"   , "narrator": "", "text": "そういうことなら任せて！"},
        { "location": "437/TALK"  , "narrator": "ガブリエラ", "text": "ふふ、\n協力してくれてありがと。\nとっても心強いわ♪"},
        { "location": "438/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、行くわよ！"},
        { "location": "440/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！"},
        { "location": "27/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月3日　5:58 PM</color>\nFreyMENOWライブ中に発生した\nフェノメノンドーム戦にて。"},
        { "location": "152/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "280/DIALOG", "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>400pt.</b></color></size>\nアップしました！"},
        { "location": "291/DIALOG", "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>400pt.</b></color></size>\nアップしました！"},
        { "location": "303/DIALOG", "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>800pt.</b></color></size>\nアップしました！"}
    ]
}
