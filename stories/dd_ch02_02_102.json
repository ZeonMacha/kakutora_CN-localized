{
    "dir": "chap02/daydra/dd_ch02_02_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "2204",
        "cid": "ayami",
        "title": "004 メインストーリー",
        "sub_title": "國政綾水という存在＜後編＞"
    },
    "entry":
    [
        { "location": "435/SCENARIO", "narrator": "", "text": "意地悪な神様"},
        { "location": "459/TALK"    , "narrator": "千羽鶴", "text": "現実世界へ\nおかえりなさい。"},
        { "location": "460/TALK"    , "narrator": "千羽鶴", "text": "貴方が彼女のココロの中で\n奮闘してくれたお陰で、\n彼女の心は安定した。"},
        { "location": "461/TALK"    , "narrator": "千羽鶴", "text": "あとは貴方から直接、\n彼女にアドバイスをして、\n背中を一押しするだけ。"},
        { "location": "462/TALK"    , "narrator": "千羽鶴", "text": "さて、\nその方法だけど。"},
        { "location": "468/TALK"    , "narrator": "千羽鶴", "text": "WAVEというチャット\nツールのシステムを\n作ってみた。"},
        { "location": "469/TALK"    , "narrator": "千羽鶴", "text": "あなたの世界にも、\n似たものがあるかも\nしれないけど。"},
        { "location": "470/TALK"    , "narrator": "千羽鶴", "text": "そして、彼女のWAVEに\nあなたを登録して\nおいた。"},
        { "location": "471/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "472/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "474/TALK"    , "narrator": "千羽鶴", "text": "でも「bot」として\nだけど。"},
        { "location": "475/SEL"     , "narrator": "", "text": "なんでBot！？"},
        { "location": "476/ACT"     , "narrator": "", "text": "なんでBot！？"},
        { "location": "478/TALK"    , "narrator": "千羽鶴", "text": "いきなり知らない人が\nフレンド登録されて\nいたらまずいでしょう。"},
        { "location": "479/SEL"     , "narrator": "", "text": "そんなところにリアリティを持たせなくても"},
        { "location": "480/ACT"     , "narrator": "", "text": "そんなところにリアリティを持たせなくても"},
        { "location": "482/TALK"    , "narrator": "千羽鶴", "text": "「あなた」は「あなた」\nなんだから。"},
        { "location": "483/TALK"    , "narrator": "千羽鶴", "text": "幼馴染み設定とか、\nそんな都合のいい\nものはないから。"},
        { "location": "484/TALK"    , "narrator": "千羽鶴", "text": "そこはリアリティを\n持って欲しい。"},
        { "location": "485/TALK"    , "narrator": "千羽鶴", "text": "そういうわけだから、\n彼女からの抵抗は\nあまり無いはず。"},
        { "location": "486/SEL"     , "narrator": "", "text": "でもBotじゃねえ…"},
        { "location": "487/ACT"     , "narrator": "", "text": "でもBotじゃねえ…"},
        { "location": "489/TALK"    , "narrator": "千羽鶴", "text": "私はあくまで\n自然な出逢いと機会を\n与えただけ。"},
        { "location": "490/TALK"    , "narrator": "千羽鶴", "text": "どう運用するかは\nあなたが決めていい。"},
        { "location": "491/TALK"    , "narrator": "千羽鶴", "text": "すぐに「bot」では\nないと伝えてもいいし、\nそのままでもいい。"},
        { "location": "492/TALK"    , "narrator": "千羽鶴", "text": "そこはあなたの\nセンスに任せる。"},
        { "location": "496/TALK"    , "narrator": "千羽鶴", "text": "さあ、彼女の新しい物語が\n始まろうとしている。"},
        { "location": "497/TALK"    , "narrator": "千羽鶴", "text": "チャットツールWAVEを\n使って、彼女を支えて\nいってほしい。"},
        { "location": "510/TALK"    , "narrator": "アーヤ", "text": "ふぅ…。"},
        { "location": "511/TALK"    , "narrator": "アーヤ", "text": "…よし、決めたわ！"},
        { "location": "513/TALK"    , "narrator": "アーヤ", "text": "小夜、さっき言ってた\nお腹痛い作戦で行くから、\nサポート頼める？"},
        { "location": "515/TALK"    , "narrator": "小夜", "text": "ちょ、本当にいいの！？"},
        { "location": "516/TALK"    , "narrator": "アーヤ", "text": "良くはないけど、\nこうしてても状況が\nよくなるわけじゃないし。"},
        { "location": "519/TALK"    , "narrator": "アーヤ", "text": "…でも、もし目立つだけで\n上手くいかなかったら、\nどうしよう？"},
        { "location": "520/TALK"    , "narrator": "アーヤ", "text": "それに、もう少し考えれば\nもっといい案が浮かぶかも\nしれないし…。"},
        { "location": "521/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "522/SEL"     , "narrator": "", "text": "腹をくくれ！"},
        { "location": "523/SEL"     , "narrator": "", "text": "めっちゃ怖がって逃げ出せ！"},
        { "location": "524/SEL"     , "narrator": "", "text": "普通にやれば平気だよ"},
        { "location": "525/ACT"     , "narrator": "", "text": "腹をくくれ！"},
        { "location": "529/TALK"    , "narrator": "アーヤ", "text": "また館長からかしら…。"},
        { "location": "543/TALK"    , "narrator": "アーヤ", "text": "え"},
        { "location": "544/TALK"    , "narrator": "アーヤ", "text": "あなただれ"},
        { "location": "545/TALK"    , "narrator": "アーヤ", "text": "？"},
        { "location": "547/SEL"     , "narrator": "", "text": "Botだよ"},
        { "location": "548/ACT"     , "narrator": "", "text": "Botだよ"},
        { "location": "550/TALK"    , "narrator": "アーヤ", "text": "？"},
        { "location": "553/TALK"    , "narrator": "アーヤ", "text": "…何これ？"},
        { "location": "554/TALK"    , "narrator": "小夜", "text": "え…ああ、[Bot]じゃない。\n自分でそう言ってるし。"},
        { "location": "555/TALK"    , "narrator": "小夜", "text": "最近流行ってるよね。\n私も、この前登録した\n企業の[Bot]ちゃんが――"},
        { "location": "556/TALK"    , "narrator": "小夜", "text": "感情ＡＩとかいう\n新技術使っててさ、\n本当にリアルだったわ。"},
        { "location": "558/TALK"    , "narrator": "アーヤ", "text": "そうなんだ…。\nでも、登録なんてした\n覚えないんだけど…。"},
        { "location": "559/TALK"    , "narrator": "小夜", "text": "その[Bot]、\nなんて言ってきてるの？"},
        { "location": "561/TALK"    , "narrator": "アーヤ", "text": "…腹をくくれ、だって。\n簡単に言ってくれて…\n所詮はＡＩよね。"},
        { "location": "563/SEL"     , "narrator": "", "text": "頑張れ！！"},
        { "location": "564/SEL"     , "narrator": "", "text": "遠隔操作：電車のドアを開けてあげる"},
        { "location": "565/ACT"     , "narrator": "", "text": "頑張れ！！"},
        { "location": "574/TALK"    , "narrator": "アーヤ", "text": "……"},
        { "location": "585/TALK"    , "narrator": "アーヤ", "text": "…[Bot]に言われなくても\nわかってるわよ。"},
        { "location": "586/TALK"    , "narrator": "アーヤ", "text": "もう、この方法しか\nないんだから！"},
        { "location": "587/TALK"    , "narrator": "小夜", "text": "…っ！？\nちょ、アーヤ！？"},
        { "location": "591/TALK"    , "narrator": "アーヤ", "text": "よし、後は…。"},
        { "location": "593/TALK"    , "narrator": "アーヤ", "text": "あ、あー、いたいいたい。\nおなかいたすぎて\n限界かもー。"},
        { "location": "595/TALK"    , "narrator": "小夜", "text": "な、何その大根演技！？"},
        { "location": "596/TALK"    , "narrator": "乗客", "text": "うわっ、マジかよ。\n非常コック開けるほど\nヤバいのか…。"},
        { "location": "597/TALK"    , "narrator": "乗客", "text": "あの子、時々見る子だよ。\n美人だから覚えてたん\nだけど…。"},
        { "location": "598/TALK"    , "narrator": "乗客", "text": "かわいそうに…、\n色んな意味で…。"},
        { "location": "600/TALK"    , "narrator": "アーヤ", "text": "ああもう！\n早く逃げ出したい！"},
        { "location": "602/TALK"    , "narrator": "アーヤ", "text": "ああ、もうダメー。\nほんと限界ー。"},
        { "location": "604/TALK"    , "narrator": "小夜", "text": "あっ、だ、大丈夫！？\nほら、早く降りて！"},
        { "location": "607/TALK"    , "narrator": "アーヤ", "text": "ちょっ！？"},
        { "location": "616/TALK"    , "narrator": "小夜", "text": "あ…。"},
        { "location": "617/TALK"    , "narrator": "乗客", "text": "マジ限界じゃん。\n同情するわー。"},
        { "location": "618/TALK"    , "narrator": "乗客", "text": "次の駅まで遠いけど、\n間に合うのかしら？"},
        { "location": "619/TALK"    , "narrator": "アーヤ", "text": "さ、小夜ぉ！！"},
        { "location": "620/TALK"    , "narrator": "小夜", "text": "ご、ごめんアーヤ。\nとにかく、早く行って！"},
        { "location": "638/TALK"    , "narrator": "アーヤ", "text": "はぁ…最悪だわ。"},
        { "location": "639/TALK"    , "narrator": "アーヤ", "text": "メチャクチャ目立ったし、\n写真撮ってる人とかも\nいたし。"},
        { "location": "640/TALK"    , "narrator": "アーヤ", "text": "ＳＮＳとかでさらされたり\nしてるのかしら…。\nどうしよう…。"},
        { "location": "641/TALK"    , "narrator": "アーヤ", "text": "ぐすっ…。"},
        { "location": "642/TALK"    , "narrator": "アーヤ", "text": "で、でも、これでどうにか\n間に合いそうだし、それは\n後で考えよう…。"},
        { "location": "650/TALK"    , "narrator": "アーヤ", "text": "館長の言ってた場所は、\n確かもうすぐ…。"},
        { "location": "652/TALK"    , "narrator": "アーヤ", "text": "…えっ！？"},
        { "location": "659/TALK"    , "narrator": "アーヤ", "text": "な、何なの！？\nどうしてこんなに\nゴツいのが…。"},
        { "location": "667/TALK"    , "narrator": "アーヤ", "text": "もしもし、館長ですか！？\n今、指定された場所に\n到着して…。"},
        { "location": "668/TALK"    , "narrator": "真幌", "text": "おおっ、早かったな。\n迎えは来ているだろう？"},
        { "location": "669/TALK"    , "narrator": "アーヤ", "text": "迎えって…このゴツい\nトレーラーですか？"},
        { "location": "670/TALK"    , "narrator": "真幌", "text": "ああ。緊急調達要請を\n行使して、陸自から\nアーケロンを借りた。"},
        { "location": "671/TALK"    , "narrator": "真幌", "text": "さあ、早く乗って\n現場に向かってくれ。"},
        { "location": "672/TALK"    , "narrator": "アーヤ", "text": "りょ、了解しました！\n直ちに向かいます！"},
        { "location": "678/TALK"    , "narrator": "アーヤ", "text": "ふぅ…。"},
        { "location": "679/TALK"    , "narrator": "アーヤ", "text": "…よし、行こう！"},
        { "location": "682/ACT"     , "narrator": "", "text": "遠隔操作：電車のドアを開けてあげる"},
        { "location": "692/TALK"    , "narrator": "アーヤ", "text": "えっ、なに！？"},
        { "location": "693/TALK"    , "narrator": "乗客", "text": "うわっ、何だ！？\n急にドアが開いたぞ？"},
        { "location": "694/TALK"    , "narrator": "乗客", "text": "…これ、降りろってこと\nなのかしら？"},
        { "location": "695/TALK"    , "narrator": "乗客", "text": "いや、ダメだろ降りたら？"},
        { "location": "697/SEL"     , "narrator": "", "text": "さあ、飛び降りて！"},
        { "location": "698/ACT"     , "narrator": "", "text": "さあ、飛び降りて！"},
        { "location": "705/TALK"    , "narrator": "アーヤ", "text": "まさか"},
        { "location": "706/TALK"    , "narrator": "アーヤ", "text": "あなたがやったの！？"},
        { "location": "708/SEL"     , "narrator": "", "text": "凄いでしょ？"},
        { "location": "709/ACT"     , "narrator": "", "text": "凄いでしょ？"},
        { "location": "711/TALK"    , "narrator": "アーヤ", "text": "凄いけど"},
        { "location": "712/TALK"    , "narrator": "アーヤ", "text": "誰も飛び降りてないんだけど？"},
        { "location": "716/TALK"    , "narrator": "車内アナウンス", "text": "お客様にお知らせします。"},
        { "location": "717/TALK"    , "narrator": "車内アナウンス", "text": "故障によりドアが開いて\nおりますが――"},
        { "location": "718/TALK"    , "narrator": "車内アナウンス", "text": "決して、飛び降りないで\nください。"},
        { "location": "720/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "723/TALK"    , "narrator": "アーヤ", "text": "余計飛び降りにくくなったんだけど？"},
        { "location": "725/SEL"     , "narrator": "", "text": "ごめん、失敗した"},
        { "location": "726/ACT"     , "narrator": "", "text": "ごめん、失敗した"},
        { "location": "728/TALK"    , "narrator": "アーヤ", "text": "これ以上は何もしないで"},
        { "location": "739/TALK"    , "narrator": "アーヤ", "text": "もう、こんなに時間が\n過ぎちゃってる。"},
        { "location": "740/TALK"    , "narrator": "アーヤ", "text": "…覚悟を決めろ、って\nことね…。"},
        { "location": "741/TALK"    , "narrator": "アーヤ", "text": "小夜…もしも私が\n社会的に死んでも――"},
        { "location": "743/TALK"    , "narrator": "アーヤ", "text": "あなたの中で、\n私は生き続けてるからね。"},
        { "location": "744/TALK"    , "narrator": "小夜", "text": "は？　何言って…っ！？"},
        { "location": "754/TALK"    , "narrator": "小夜", "text": "あ、アーヤ！？"},
        { "location": "759/TALK"    , "narrator": "小夜", "text": "…行っちゃった。"},
        { "location": "760/TALK"    , "narrator": "乗客", "text": "マジかよあの子？\nアナウンス聞いてなかった\nのか？"},
        { "location": "761/TALK"    , "narrator": "乗客", "text": "信じられない…。\nなんて非常識な子なの？"},
        { "location": "762/TALK"    , "narrator": "乗客", "text": "あー、顔撮っとけば\nよかったなぁ…。"},
        { "location": "763/TALK"    , "narrator": "小夜", "text": "…顔が撮られてないことを\n祈るばかりね。"},
        { "location": "777/TALK"    , "narrator": "アーヤ", "text": "はぁ…最悪だわ。"},
        { "location": "778/TALK"    , "narrator": "アーヤ", "text": "メチャクチャ目立ったし、\n写真撮ってる人とかも\nいたし。"},
        { "location": "779/TALK"    , "narrator": "アーヤ", "text": "それよりもあの[Bot]、\n絶対に普通じゃないわ。"},
        { "location": "780/TALK"    , "narrator": "アーヤ", "text": "電車のドアを一斉に\n開けるとか、明らかに\n異常だもの。"},
        { "location": "781/TALK"    , "narrator": "アーヤ", "text": "もしかして、感情を持った\nウイルス…とか？"},
        { "location": "782/TALK"    , "narrator": "アーヤ", "text": "…でも、その割には\n凄い間が抜けてるし。"},
        { "location": "783/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "784/TALK"    , "narrator": "アーヤ", "text": "まあ、私が非常コックを\n引かずに済んだんだし、\nちょっと気がラクかも。"},
        { "location": "792/TALK"    , "narrator": "アーヤ", "text": "…っと、館長の言ってた\n場所はそろそろね。"},
        { "location": "794/TALK"    , "narrator": "アーヤ", "text": "…えっ！？"},
        { "location": "799/ACT"     , "narrator": "", "text": "めっちゃ怖がって逃げ出せ！"},
        { "location": "803/TALK"    , "narrator": "アーヤ", "text": "どうしよう。\nまた館長からかしら…。"},
        { "location": "817/TALK"    , "narrator": "アーヤ", "text": "え"},
        { "location": "818/TALK"    , "narrator": "アーヤ", "text": "あなただれ"},
        { "location": "819/TALK"    , "narrator": "アーヤ", "text": "？"},
        { "location": "821/SEL"     , "narrator": "", "text": "Botだよ"},
        { "location": "822/ACT"     , "narrator": "", "text": "Botだよ"},
        { "location": "824/TALK"    , "narrator": "アーヤ", "text": "？"},
        { "location": "827/TALK"    , "narrator": "アーヤ", "text": "…何これ？"},
        { "location": "828/TALK"    , "narrator": "小夜", "text": "え…ああ、[Bot]じゃない。\n自分でそう言ってるし。"},
        { "location": "829/TALK"    , "narrator": "小夜", "text": "最近流行ってるよね。\n私も、この前登録した\n企業の[Bot]ちゃんが――"},
        { "location": "830/TALK"    , "narrator": "小夜", "text": "感情ＡＩとかいう\n新技術使っててさ、\n本当にリアルだったわ。"},
        { "location": "832/TALK"    , "narrator": "アーヤ", "text": "そうなんだ…。\nでも、登録なんてした\n覚えないんだけど…。"},
        { "location": "833/TALK"    , "narrator": "小夜", "text": "その[Bot]、\nなんて言ってきてるの？"},
        { "location": "835/TALK"    , "narrator": "アーヤ", "text": "…怖がって逃げ出せ、\nって言ってきてるわ。"},
        { "location": "836/TALK"    , "narrator": "小夜", "text": "…まあ、自然といえば\n自然…かなぁ？"},
        { "location": "837/TALK"    , "narrator": "アーヤ", "text": "でも、凄い目立たない？"},
        { "location": "839/SEL"     , "narrator": "", "text": "頑張れ！！"},
        { "location": "840/SEL"     , "narrator": "", "text": "遠隔操作：電車のドアを開けてあげる"},
        { "location": "841/ACT"     , "narrator": "", "text": "頑張れ！！"},
        { "location": "850/TALK"    , "narrator": "アーヤ", "text": "……"},
        { "location": "861/TALK"    , "narrator": "アーヤ", "text": "…お腹痛いフリするより\nマシ…よね？"},
        { "location": "862/TALK"    , "narrator": "アーヤ", "text": "それなら…。"},
        { "location": "863/TALK"    , "narrator": "小夜", "text": "…っ！？\nちょ、アーヤ！？"},
        { "location": "867/TALK"    , "narrator": "アーヤ", "text": "よし、後は…。"},
        { "location": "868/TALK"    , "narrator": "アーヤ", "text": "い、いやぁぁぁぁぁっ！！"},
        { "location": "869/TALK"    , "narrator": "アーヤ", "text": "フェノメノンは嫌！\nまたフェノメノンに\n閉じ込められたくない！"},
        { "location": "870/TALK"    , "narrator": "小夜", "text": "こ、これって…\nフェノメノンに閉じ込め\nられた経験者のフリ！？"},
        { "location": "871/TALK"    , "narrator": "乗客", "text": "何だあの子？\nフェノメノンに閉じ込め\nられたことあるのか？"},
        { "location": "872/TALK"    , "narrator": "乗客", "text": "あんなに取り乱して、\nかわいそうに…。"},
        { "location": "873/TALK"    , "narrator": "アーヤ", "text": "は、早く！\n早く逃げないと！"},
        { "location": "874/TALK"    , "narrator": "小夜", "text": "あ、はいはい。\nアーヤ、ドア開いたから！\nもう大丈夫だから！"},
        { "location": "875/TALK"    , "narrator": "小夜", "text": "…取り乱したフリして、\nそのまま走って！"},
        { "location": "877/TALK"    , "narrator": "アーヤ", "text": "うん…ありがと。"},
        { "location": "879/TALK"    , "narrator": "アーヤ", "text": "…い、嫌よ！\nこんなところで死ぬの、\n絶対にイヤァァァァァ！！"},
        { "location": "886/ACT"     , "narrator": "", "text": "遠隔操作：電車のドアを開けてあげる"},
        { "location": "891/ACT"     , "narrator": "", "text": "普通にやれば平気だよ"},
        { "location": "895/TALK"    , "narrator": "アーヤ", "text": "どうしよう。\nまた館長からかしら…。"},
        { "location": "909/TALK"    , "narrator": "アーヤ", "text": "え"},
        { "location": "910/TALK"    , "narrator": "アーヤ", "text": "あなただれ"},
        { "location": "911/TALK"    , "narrator": "アーヤ", "text": "？"},
        { "location": "913/SEL"     , "narrator": "", "text": "Botだよ"},
        { "location": "914/ACT"     , "narrator": "", "text": "Botだよ"},
        { "location": "916/TALK"    , "narrator": "アーヤ", "text": "？"},
        { "location": "919/TALK"    , "narrator": "アーヤ", "text": "…何これ？"},
        { "location": "920/TALK"    , "narrator": "小夜", "text": "え…ああ、[Bot]じゃない。\n自分でそう言ってるし。"},
        { "location": "921/TALK"    , "narrator": "小夜", "text": "最近流行ってるよね。\n私も、この前登録した\n企業の[Bot]ちゃんが――"},
        { "location": "922/TALK"    , "narrator": "小夜", "text": "感情ＡＩとかいう\n新技術使っててさ、\n本当にリアルだったわ。"},
        { "location": "924/TALK"    , "narrator": "アーヤ", "text": "そうなんだ…。\nでも、登録なんてした\n覚えないんだけど…。"},
        { "location": "925/TALK"    , "narrator": "小夜", "text": "その[Bot]、\nなんて言ってきてるの？"},
        { "location": "927/TALK"    , "narrator": "アーヤ", "text": "えっと…普通にやれば\n平気だよ、って…。"},
        { "location": "928/TALK"    , "narrator": "アーヤ", "text": "それって、自然な感じで\n非常コックを引け、って\nことかしら？"},
        { "location": "929/TALK"    , "narrator": "小夜", "text": "いや、非常コック引く\n時点で不自然だから。"},
        { "location": "931/SEL"     , "narrator": "", "text": "頑張れ！！"},
        { "location": "932/SEL"     , "narrator": "", "text": "遠隔操作：電車のドアを開けてあげる"},
        { "location": "933/ACT"     , "narrator": "", "text": "頑張れ！！"},
        { "location": "941/TALK"    , "narrator": "アーヤ", "text": "何をよ？"},
        { "location": "952/TALK"    , "narrator": "アーヤ", "text": "…まあ、お腹痛いフリを\nするよりはマシよね？"},
        { "location": "953/TALK"    , "narrator": "アーヤ", "text": "よし、さっとやって、\n電車から離れよう…。"},
        { "location": "954/TALK"    , "narrator": "小夜", "text": "…っ！？\nちょ、アーヤ！？"},
        { "location": "959/TALK"    , "narrator": "アーヤ", "text": "…じゃあ、私は行くから。"},
        { "location": "960/TALK"    , "narrator": "小夜", "text": "えっ？　あ、えっと…。"},
        { "location": "961/TALK"    , "narrator": "小夜", "text": "…気を付けてね。"},
        { "location": "971/TALK"    , "narrator": "乗客", "text": "うわっ、マジかよ…。\nあの子、非常コック\n引いちゃったよ。"},
        { "location": "972/TALK"    , "narrator": "乗客", "text": "いくら急いでるからって、\n普通は引かないよな？"},
        { "location": "973/TALK"    , "narrator": "乗客", "text": "非常識な女ね。\n美人は何しても許されると\n思ってるのかしら？"},
        { "location": "975/TALK"    , "narrator": "小夜", "text": "…凄い目立ってるわね。"},
        { "location": "977/ACT"     , "narrator": "", "text": "遠隔操作：電車のドアを開けてあげる"},
        { "location": "508/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月3日　1:11 PM</color>\nドームライブ戦直前、\n中央線6号車車内にて。"}
    ]
}
