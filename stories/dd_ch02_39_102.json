{
    "dir": "chap39/daydra/dd_ch02_39_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "39205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "輝ける未来の空に＜後編＞"
    },
    "entry":
    [
        { "location": "658/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "659/TALK"  , "narrator": "小夜", "text": "急でびっくりしたと\n思うけど…。\n考えて欲しいな。"},
        { "location": "662/TALK"  , "narrator": "ガブリエラ", "text": "急っていうか…。"},
        { "location": "663/TALK"  , "narrator": "ガブリエラ", "text": "あたし、人形劇とか\nあんまり…。"},
        { "location": "664/TALK"  , "narrator": "小夜", "text": "そっか…。"},
        { "location": "665/TALK"  , "narrator": "小夜", "text": "この前の人形劇の\nガブちゃん、\nアドリブもできたし。"},
        { "location": "666/TALK"  , "narrator": "小夜", "text": "ちゃんと練習したら\nきっともっと上手に\nできそうだなって。"},
        { "location": "667/TALK"  , "narrator": "小夜", "text": "そう思ってたん\nだけど……。"},
        { "location": "669/TALK"  , "narrator": "ガブリエラ", "text": "あれは別に\nたまたまだし…。"},
        { "location": "671/TALK"  , "narrator": "アーヤ", "text": "たまたまなのが\nすごいんだと\n思うわ。"},
        { "location": "672/TALK"  , "narrator": "ガブリエラ", "text": "アーヤまで何！？"},
        { "location": "673/TALK"  , "narrator": "アーヤ", "text": "だって本当の\nことだもの。"},
        { "location": "674/TALK"  , "narrator": "アーヤ", "text": "それとね。今回は\n打ち上げ代わりに\n長野に行くつもりなの。"},
        { "location": "675/TALK"  , "narrator": "アーヤ", "text": "前はバタバタだったから\nちょっとゆっくり観光も\n兼ねて。"},
        { "location": "676/TALK"  , "narrator": "ガブリエラ", "text": "えっ！"},
        { "location": "677/TALK"  , "narrator": "小夜", "text": "アーヤに色々案内して\nもらうつもりなの。"},
        { "location": "678/TALK"  , "narrator": "小夜", "text": "絶対楽しいと\n思うんだけどな。"},
        { "location": "680/TALK"  , "narrator": "ガブリエラ", "text": "……わかったわよ。"},
        { "location": "681/TALK"  , "narrator": "小夜", "text": "本当！？\nありがとう！\nうれしい！"},
        { "location": "682/TALK"  , "narrator": "アーヤ", "text": "大変だと思うけど\nよろしくね。"},
        { "location": "683/TALK"  , "narrator": "ガブリエラ", "text": "…いいわよ別に。"},
        { "location": "684/TALK"  , "narrator": "ガブリエラ", "text": "あっでも！\n長野には絶対\n連れて行ってね！"},
        { "location": "686/TALK"  , "narrator": "アーヤ", "text": "当然よ。"},
        { "location": "687/SEL"   , "narrator": "", "text": "うまく説得できたね"},
        { "location": "688/ACT"   , "narrator": "", "text": "うまく説得できたね"},
        { "location": "705/TALK"  , "narrator": "アーヤ", "text": "この前のギャヴィ楽しそうだったし"},
        { "location": "706/TALK"  , "narrator": "アーヤ", "text": "引き受けてくれるって思ってた"},
        { "location": "708/SEL"   , "narrator": "", "text": "そうなんだ"},
        { "location": "709/SEL"   , "narrator": "", "text": "声出す練習にもなるしね"},
        { "location": "710/SEL"   , "narrator": "", "text": "日本語また上達するんじゃない"},
        { "location": "711/ACT"   , "narrator": "", "text": "そうなんだ"},
        { "location": "712/TALK"  , "narrator": "アーヤ", "text": "伊達に付き合い長くないのよ"},
        { "location": "713/ACT"   , "narrator": "", "text": "声出す練習にもなるしね"},
        { "location": "714/TALK"  , "narrator": "アーヤ", "text": "それもある"},
        { "location": "715/TALK"  , "narrator": "アーヤ", "text": "いきなりは難しいけどね"},
        { "location": "716/ACT"   , "narrator": "", "text": "日本語また上達するんじゃない"},
        { "location": "717/TALK"  , "narrator": "アーヤ", "text": "現時点でもネイティブ並みだけどね"},
        { "location": "718/TALK"  , "narrator": "アーヤ", "text": "あのこ努力家だし"},
        { "location": "730/TALK"  , "narrator": "アーヤ", "text": "じゃあ早速練習の\nスケジュールを\n立てましょう。"},
        { "location": "732/TALK"  , "narrator": "ガブリエラ", "text": "長野旅行のじゃ\nないの？"},
        { "location": "733/TALK"  , "narrator": "小夜", "text": "それは後でのお楽しみ。"},
        { "location": "734/TALK"  , "narrator": "アーヤ", "text": "そうそう。まずは\n人形劇を成功\nさせなくちゃ。"},
        { "location": "735/TALK"  , "narrator": "アーヤ", "text": "ビシビシやるから\n覚悟してね！"},
        { "location": "759/TALK"  , "narrator": "ガブリエラ", "text": "ねえアーヤ。\nここでの女の子の\n動作なんだけど…。"},
        { "location": "761/TALK"  , "narrator": "アーヤ", "text": "ふふ。"},
        { "location": "762/TALK"  , "narrator": "ガブリエラ", "text": "…何よ？"},
        { "location": "763/TALK"  , "narrator": "アーヤ", "text": "ううん。\n真面目にやってくれて\nうれしいなってだけ。"},
        { "location": "765/TALK"  , "narrator": "ガブリエラ", "text": "当たり前でしょ！\n引き受けたからには\n真面目にやるわ。"},
        { "location": "766/TALK"  , "narrator": "ガブリエラ", "text": "…それに一応\n主役なんだし…。"},
        { "location": "767/TALK"  , "narrator": "アーヤ", "text": "一応じゃないわ。\nギャヴィがいないと\n成り立たないもの。"},
        { "location": "768/TALK"  , "narrator": "ガブリエラ", "text": "おだてなくていいから！\nちゃんと長野に\n連れてってよね！"},
        { "location": "770/TALK"  , "narrator": "アーヤ", "text": "もちろん。"},
        { "location": "771/TALK"  , "narrator": "アーヤ", "text": "もう少し姉のことも\n調べたいし…。"},
        { "location": "772/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "773/TALK"  , "narrator": "アーヤ", "text": "あ、もちろん\n観光がメインよ。\n慰安旅行だもの。"},
        { "location": "774/TALK"  , "narrator": "アーヤ", "text": "小夜たちも一緒だし。"},
        { "location": "775/TALK"  , "narrator": "ガブリエラ", "text": "…それでいいの？"},
        { "location": "776/TALK"  , "narrator": "アーヤ", "text": "むしろそうしたいの。"},
        { "location": "777/TALK"  , "narrator": "アーヤ", "text": "バタフライエフェクトの話\n憶えてる？"},
        { "location": "778/TALK"  , "narrator": "アーヤ", "text": "お姉ちゃんは外の世界で\n死んだことになってる。\nでも実は死んでない。"},
        { "location": "779/TALK"  , "narrator": "アーヤ", "text": "だったらいつかきっと\n私の行動は姉に\nつながるはず。"},
        { "location": "780/TALK"  , "narrator": "アーヤ", "text": "この前は会い損ねたけど\nそのうちチャンスが来ると\n思ってる。"},
        { "location": "781/TALK"  , "narrator": "アーヤ", "text": "だからこれでいいの。"},
        { "location": "782/TALK"  , "narrator": "ガブリエラ", "text": "そういうもの？"},
        { "location": "783/TALK"  , "narrator": "アーヤ", "text": "勝手な人だけど\n嫌いじゃないしね\nお姉ちゃんのことは。"},
        { "location": "784/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "785/TALK"  , "narrator": "アーヤ", "text": "驚きすぎよ。"},
        { "location": "786/TALK"  , "narrator": "ガブリエラ", "text": "だって今まであんなに！"},
        { "location": "787/SEL"   , "narrator": "", "text": "ガブリエラに同意"},
        { "location": "788/ACT"   , "narrator": "", "text": "ガブリエラに同意"},
        { "location": "805/TALK"  , "narrator": "アーヤ", "text": "そう？"},
        { "location": "807/TALK"  , "narrator": "アーヤ", "text": "$handle$さんには結構本心見せてたと思うけど"},
        { "location": "809/SEL"   , "narrator": "", "text": "ツンデレの自覚はあるんだ"},
        { "location": "810/SEL"   , "narrator": "", "text": "もっともっと見たいな"},
        { "location": "811/ACT"   , "narrator": "", "text": "ツンデレの自覚はあるんだ"},
        { "location": "812/TALK"  , "narrator": "アーヤ", "text": "変な言い方しないで"},
        { "location": "813/TALK"  , "narrator": "アーヤ", "text": "もう！"},
        { "location": "814/ACT"   , "narrator": "", "text": "もっともっと見たいな"},
        { "location": "815/TALK"  , "narrator": "アーヤ", "text": "$handle$さんが望むなら"},
        { "location": "816/TALK"  , "narrator": "アーヤ", "text": "なんてね"},
        { "location": "829/TALK"  , "narrator": "アーヤ", "text": "そんなことより\n劇の演出の話を\nしましょ。"},
        { "location": "830/TALK"  , "narrator": "ガブリエラ", "text": "ちょ…！\nそんなのどうでも…！"},
        { "location": "834/TALK"  , "narrator": "真幌", "text": "どうした？"},
        { "location": "835/TALK"  , "narrator": "アーヤ", "text": "あ、館長。"},
        { "location": "836/TALK"  , "narrator": "アーヤ", "text": "館長もギャヴィの\n晴れ舞台、観に\n来ませんか？"},
        { "location": "837/TALK"  , "narrator": "ガブリエラ", "text": "えっ…！"},
        { "location": "838/TALK"  , "narrator": "真幌", "text": "舞台？\n面白そうだな。"},
        { "location": "839/TALK"  , "narrator": "ガブリエラ", "text": "来なくていいわよ！\n来なくていいから！"},
        { "location": "840/TALK"  , "narrator": "真幌", "text": "そう言われると\nますます気になるな。"},
        { "location": "841/TALK"  , "narrator": "ガブリエラ", "text": "えっちょっと！\nアーヤ！"},
        { "location": "842/TALK"  , "narrator": "真幌", "text": "それは台本か？\nどれどれ…。"},
        { "location": "843/SEL"   , "narrator": "", "text": "真幌は何か知ってるんじゃない？"},
        { "location": "844/ACT"   , "narrator": "", "text": "真幌は何か知ってるんじゃない？"},
        { "location": "861/TALK"  , "narrator": "アーヤ", "text": "何を？"},
        { "location": "863/SEL"   , "narrator": "", "text": "エリカさんのこと"},
        { "location": "864/SEL"   , "narrator": "", "text": "同僚だったんでしょ"},
        { "location": "865/ACT"   , "narrator": "", "text": "エリカさんのこと"},
        { "location": "866/TALK"  , "narrator": "アーヤ", "text": "そうかも"},
        { "location": "867/ACT"   , "narrator": "", "text": "同僚だったんでしょ"},
        { "location": "868/TALK"  , "narrator": "アーヤ", "text": "みたいね"},
        { "location": "870/TALK"  , "narrator": "アーヤ", "text": "だけど聞くのはやめとく"},
        { "location": "871/TALK"  , "narrator": "アーヤ", "text": "直接お姉ちゃんと話してみる"},
        { "location": "874/TALK"  , "narrator": "アーヤ", "text": "機会があったら"},
        { "location": "876/SEL"   , "narrator": "", "text": "きっと来るよ"},
        { "location": "877/SEL"   , "narrator": "", "text": "来るといいね"},
        { "location": "878/SEL"   , "narrator": "", "text": "それもまたバタフライエフェクト"},
        { "location": "879/ACT"   , "narrator": "", "text": "きっと来るよ"},
        { "location": "880/TALK"  , "narrator": "アーヤ", "text": "$handle$さんが言うなら"},
        { "location": "882/TALK"  , "narrator": "アーヤ", "text": "信じられる"},
        { "location": "883/ACT"   , "narrator": "", "text": "来るといいね"},
        { "location": "884/TALK"  , "narrator": "アーヤ", "text": "来るわよ"},
        { "location": "886/TALK"  , "narrator": "アーヤ", "text": "だって私の姉だもの"},
        { "location": "887/ACT"   , "narrator": "", "text": "それもまたバタフライエフェクト"},
        { "location": "888/TALK"  , "narrator": "アーヤ", "text": "そうね"},
        { "location": "890/TALK"  , "narrator": "アーヤ", "text": "因果はどこかできっとつながってる"},
        { "location": "902/TALK"  , "narrator": "真幌", "text": "どうせなら出会うのは\n魔女じゃなくて\n巨大怪獣にして。"},
        { "location": "903/TALK"  , "narrator": "真幌", "text": "それを少女と魔女が\n倒すって話はどうだ？"},
        { "location": "904/TALK"  , "narrator": "ガブリエラ", "text": "全然だめよ！\n子供が泣いちゃうわ！？"},
        { "location": "905/TALK"  , "narrator": "ガブリエラ", "text": "アーヤも何か言ってよ！"},
        { "location": "906/TALK"  , "narrator": "アーヤ", "text": "じゃあ巨大怪獣編は\n神楽坂で上演\nしましょうか？"},
        { "location": "907/TALK"  , "narrator": "真幌", "text": "おっいいな。\nどうせなら映画でも\n撮るか。"},
        { "location": "909/TALK"  , "narrator": "ガブリエラ", "text": "もう！\n二人して！！"},
        { "location": "910/TALK"  , "narrator": "アーヤ", "text": "あはは……。"},
        { "location": "654/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"}
    ]
}
