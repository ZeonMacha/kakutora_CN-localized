        "title": "001 アニメーション",
        "sub_title": "みやびの紹介"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第01～04話"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "ようこそ。\n恋ヶ崎みやびの\nステージへ。"},
        { "location": "50/TALK"   , "narrator": "千羽鶴", "text": "それじゃまずは、\n恋ヶ崎みやびの\nおさらいから。"},
        { "location": "52/TALK"   , "narrator": "千羽鶴", "text": "ここから先は、\nそれぞれの少女ごとに\nチャンネルが分かれる。"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "同じ空間で同じ事象を\n体験していても、感じ\n方や想いは様々。"},
        { "location": "54/TALK"   , "narrator": "千羽鶴", "text": "だから、貴方の彼女たち\nへのサポートもまた、\n様々なものになるはず。"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "貴方には１００％の力で\n彼女を深くサポートして\n欲しいから――"},
        { "location": "56/TALK"   , "narrator": "千羽鶴", "text": "この恋愛ゲームでは、\n各彼女ごとに別チャン\nネルになってる。"},
        { "location": "57/TALK"   , "narrator": "千羽鶴", "text": "ところで――"},
        { "location": "58/TALK"   , "narrator": "千羽鶴", "text": "$handle$は、\n恋ヶ崎みやびを一番に\n選んだ。それはなぜ？"},
        { "location": "59/SEL"    , "narrator": "", "text": "彼女を支えたいから"},
        { "location": "60/SEL"    , "narrator": "", "text": "何となく"},
        { "location": "61/ACT"    , "narrator": "", "text": "彼女を支えたいから"},
        { "location": "62/TALK"   , "narrator": "千羽鶴", "text": "そう。\nとてもいい返答。"},
        { "location": "63/ACT"    , "narrator": "", "text": "何となく"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "そう。まあ、\nそういう事もある。"},
        { "location": "65/TALK"   , "narrator": "千羽鶴", "text": "でも、彼女と接してみて\n自分向きじゃないと\n感じたら――"},
        { "location": "66/TALK"   , "narrator": "千羽鶴", "text": "無理につき合う\n必要は無いから。"},
        { "location": "67/TALK"   , "narrator": "千羽鶴", "text": "あまり気負わずに\nプレイしてみて。"},
        { "location": "68/TALK"   , "narrator": "千羽鶴", "text": "それじゃまずは、\n恋ヶ崎みやびについて\n今一度おさらいをする。"},
        { "location": "80/TALK"   , "narrator": "千羽鶴", "text": "<color=purple>恋ヶ崎みやび</color>。\n高等部３年の\n不思議ちゃん少女。"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "容姿端麗ナイスバディ\nにもかかわらず自分に\n全く自信が無い。"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "[トライナリー]４人の\n中で、最も扱いが面倒\nな子でもあるけど――"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "そういう子の方が\n好きな人もいるから\nマイナス点とはしない。"},
        { "location": "84/TALK"   , "narrator": "千羽鶴", "text": "特技はクラッキング。\n[トライナリー]としても\n後方支援型ね。"},
        { "location": "86/TALK"   , "narrator": "千羽鶴", "text": "あなた的には\n何かコメントある？"},
        { "location": "87/SEL"    , "narrator": "", "text": "バッチ好み！"},
        { "location": "88/SEL"    , "narrator": "", "text": "あまり好きじゃない"},
        { "location": "89/SEL"    , "narrator": "", "text": "巨乳最高！"},
        { "location": "90/SEL"    , "narrator": "", "text": "千羽鶴くらいがいい"},
        { "location": "91/ACT"    , "narrator": "", "text": "バッチ好み！"},
        { "location": "92/TALK"   , "narrator": "千羽鶴", "text": "良かった。"},
        { "location": "93/TALK"   , "narrator": "千羽鶴", "text": "あなたのような変わり\n者でなければ、彼女の\nお守りは務まらない。"},
        { "location": "94/ACT"    , "narrator": "", "text": "あまり好きじゃない"},
        { "location": "96/TALK"   , "narrator": "千羽鶴", "text": "そう。残念。"},
        { "location": "97/TALK"   , "narrator": "千羽鶴", "text": "でも、このEPISODE\nだけは頑張って。"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "次からは、対話するも\nしないもあなたの\n自由だから。"},
        { "location": "99/ACT"    , "narrator": "", "text": "巨乳最高！"},
        { "location": "100/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "101/TALK"  , "narrator": "千羽鶴", "text": "要するに私とはチュー\nトリアルキャラ以上の\n関係は求めないと。"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "メモしておく。"},
        { "location": "103/ACT"   , "narrator": "", "text": "千羽鶴くらいがいい"},
        { "location": "105/TALK"  , "narrator": "千羽鶴", "text": "おだてたって\n何も出ませんよ？"},
        { "location": "106/TALK"  , "narrator": "千羽鶴", "text": "はい、\nサービス終わり。"},
        { "location": "108/TALK"  , "narrator": "千羽鶴", "text": "以上、紹介もまだ半端\nではあるけど、この\nまま参戦してもらう。"},
        { "location": "109/TALK"  , "narrator": "千羽鶴", "text": "この子は非常に\n情報処理能力が高い。"},
        { "location": "110/TALK"  , "narrator": "千羽鶴", "text": "この予測不能な展開を\n整理できるとしたら、\n彼女しかいない。"},
        { "location": "111/TALK"  , "narrator": "千羽鶴", "text": "ただ今回の戦闘で、彼女の\n精神状態は著しく乱れた。"},
        { "location": "112/SEL"   , "narrator": "", "text": "え？そうなの？"},
        { "location": "113/ACT"   , "narrator": "", "text": "え？そうなの？"},
        { "location": "115/TALK"  , "narrator": "千羽鶴", "text": "ええ、そうなの。"},
        { "location": "116/TALK"  , "narrator": "千羽鶴", "text": "記録映像で、\n逢瀬つばめが死亡したのを\n確認できたと思う。"},
        { "location": "117/TALK"  , "narrator": "千羽鶴", "text": "あの時、恋ヶ崎みやびは\n大きな絶望に囚われて\nしまった。"},
        { "location": "121/TALK"  , "narrator": "千羽鶴", "text": "そして、\nもう分かってると思うけど\nここで貴方の出番。"},
        { "location": "122/TALK"  , "narrator": "千羽鶴", "text": "彼女に対してもまた、\nココロをサポートして\n解決に導いてあげて欲しい。"},
        { "location": "125/TALK"  , "narrator": "千羽鶴", "text": "そして、\nもう分かってると思うけど\nここで貴方の出番。"},
        { "location": "126/TALK"  , "narrator": "千羽鶴", "text": "彼女に対してもまた、\nココロをサポートして\n解決に導いてあげて欲しい。"},
        { "location": "127/SEL"   , "narrator": "", "text": "これで３人目なんだけど、みんな何か問題を抱えて戦っていたってこと？"},
        { "location": "128/ACT"   , "narrator": "", "text": "これで３人目なんだけど、みんな何か問題を抱えて戦っていたってこと？"},
        { "location": "130/TALK"  , "narrator": "千羽鶴", "text": "逆に聞きたい。"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "生死を賭けた戦闘において\n一度も問題が発生しない\nことなんてどれ程あるか。"},
        { "location": "132/TALK"  , "narrator": "千羽鶴", "text": "記録映像にはその全てを\n記録することはできない。"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "映像に記録されているだけ\nでも色々な問題は起きて\nいるけど――"},
        { "location": "134/TALK"  , "narrator": "千羽鶴", "text": "実際にはそれ以上に色々な\n問題や危機を、彼女達は\n沢山抱えている。"},
        { "location": "135/TALK"  , "narrator": "千羽鶴", "text": "それでも彼女達は、\n今までそれを自分で\n解決して乗り切ってきた。"},
        { "location": "136/TALK"  , "narrator": "千羽鶴", "text": "けど年端もいかない少女が\n毎回の死闘で、問題を解決\nし続けるには無理がある。"},
        { "location": "137/TALK"  , "narrator": "千羽鶴", "text": "だから私は、貴方に\n助けを求めているの。"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "わかった？"},
        { "location": "139/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "140/SEL"   , "narrator": "", "text": "まだよくわからない"},
        { "location": "141/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "142/TALK"  , "narrator": "千羽鶴", "text": "オッケー。"},
        { "location": "143/TALK"  , "narrator": "千羽鶴", "text": "今回もまた、\n素晴らしいココロの\nサポートを期待してる。"},
        { "location": "144/ACT"   , "narrator": "", "text": "まだよくわからない"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "焦らなくてもいい。\nそのうち何かのきっかけで\nわかるかもしれない。"},
        { "location": "146/TALK"  , "narrator": "千羽鶴", "text": "それでもわからなければ、\n途中でやめてもらっても\n構わない。"},
        { "location": "147/TALK"  , "narrator": "千羽鶴", "text": "私には貴方を強制する力も\n権限も無いから。"},
        { "location": "148/TALK"  , "narrator": "千羽鶴", "text": "とにかく、今回だけは\n是非とも頑張って欲しい。"},
        { "location": "149/TALK"  , "narrator": "千羽鶴", "text": "素晴らしいココロの\nサポートを期待してる。"},
        { "location": "153/SEL"   , "narrator": "", "text": "で、それを解決したのが$me$ってこと？"},
        { "location": "154/ACT"   , "narrator": "", "text": "で、それを解決したのが$me$ってこと？"},
        { "location": "157/TALK"  , "narrator": "千羽鶴", "text": "その通り。\nそして貴方にとっては\nこれから成すべきこと。"},
        { "location": "158/TALK"  , "narrator": "千羽鶴", "text": "彼女に対してもまた、\nココロをサポートして\n解決に導いてあげて欲しい。"},
        { "location": "161/SEL"   , "narrator": "", "text": "そうだったんだ！"},
        { "location": "162/ACT"   , "narrator": "", "text": "そうだったんだ！"},
        { "location": "164/TALK"  , "narrator": "千羽鶴", "text": "そうだったの。"},
        { "location": "165/TALK"  , "narrator": "千羽鶴", "text": "そして、\nそれを解決したのが貴方。"},
        { "location": "166/SEL"   , "narrator": "", "text": "いえ、何もやってませんが。"},
        { "location": "167/ACT"   , "narrator": "", "text": "いえ、何もやってませんが。"},
        { "location": "170/TALK"  , "narrator": "千羽鶴", "text": "そうね。\nだって、これから\nやってもらうのだから。"},
        { "location": "171/SEL"   , "narrator": "", "text": "意味がわかりません"},
        { "location": "172/ACT"   , "narrator": "", "text": "意味がわかりません"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "貴方には、私たちの世界の\n時間を、未来へ過去へと\n自在に移動する力がある。"},
        { "location": "175/TALK"  , "narrator": "千羽鶴", "text": "貴方には、\nこのエピソードで\n恋ヶ崎みやびをサポートし――"},
        { "location": "176/TALK"  , "narrator": "千羽鶴", "text": "記録動画の通りに\n歴史が進むように、\n頑張ってもらう。"},
        { "location": "177/TALK"  , "narrator": "千羽鶴", "text": "いい？"},
        { "location": "178/SEL"   , "narrator": "", "text": "オッケー！"},
        { "location": "179/SEL"   , "narrator": "", "text": "それって歴史改変では！？"},
        { "location": "180/SEL"   , "narrator": "", "text": "いやです！"},
        { "location": "181/ACT"   , "narrator": "", "text": "オッケー！"},
        { "location": "184/ACT"   , "narrator": "", "text": "それって歴史改変では！？"},
        { "location": "185/TALK"  , "narrator": "千羽鶴", "text": "んー。\nそれはちょっと違う。"},
        { "location": "186/TALK"  , "narrator": "千羽鶴", "text": "まあ今は難しい事は\n考えず、彼女とイチャラブ\nする事に専念して。"},
        { "location": "187/ACT"   , "narrator": "", "text": "いやです！"},
        { "location": "188/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "じゃあ今すぐに\n別の彼女のチャンネルに\n切り替えた方がいい。"},
        { "location": "194/TALK"  , "narrator": "千羽鶴", "text": "さて。恋ヶ崎みやびが\n絶望に囚われたのは、\n逢瀬つばめが死亡した時。"},
        { "location": "195/TALK"  , "narrator": "千羽鶴", "text": "非常にインパクトのある\n衝撃の映像だから、\n覚えてはいると思うけど――"},
        { "location": "197/TALK"  , "narrator": "千羽鶴", "text": "一応、その前後の\n映像は、編集して\n用意してある。見る？"},
        { "location": "198/SEL"   , "narrator": "", "text": "見る"},
        { "location": "199/SEL"   , "narrator": "", "text": "見なくて平気"},
        { "location": "200/ACT"   , "narrator": "", "text": "見る"},
        { "location": "201/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "202/TALK"  , "narrator": "千羽鶴", "text": "ストリーミングで\n配信するから、\n回線が細い人は要注意。"},
        { "location": "203/TALK"  , "narrator": "千羽鶴", "text": "そんな人の為に、\n<color=green>あらすじレポート</color>も\n用意してある。"},
        { "location": "204/TALK"  , "narrator": "千羽鶴", "text": "回線種別と相談しつつ、\n映像にするか、レポート\nにするか決めて欲しい。"},
        { "location": "205/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/14MB 0:57】</color>"},
        { "location": "206/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/4MB 0:57】</color>"},
        { "location": "207/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "208/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/14MB 0:57】</color>"},
        { "location": "209/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "215/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/4MB 0:57】</color>"},
        { "location": "216/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "222/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "223/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "225/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、いろいろ\n事情があってのことだと\n思うから。"},
        { "location": "226/TALK"  , "narrator": "千羽鶴", "text": "家に帰ったら、是非\n映像記録の方も\n見てみて欲しい。"},
        { "location": "227/TALK"  , "narrator": "千羽鶴", "text": "それではどうぞ。"},
        { "location": "243/TALK"  , "narrator": "千羽鶴", "text": "どう？\nどういう状況だったか\n思い出せた？"},
        { "location": "244/TALK"  , "narrator": "千羽鶴", "text": "是非、恋ヶ崎みやびの\nココロを落ち着かせて――"},
        { "location": "245/TALK"  , "narrator": "千羽鶴", "text": "この映像のように、\n的確な支援で状況を改善\nできるようにして欲しい。"},
        { "location": "247/ACT"   , "narrator": "", "text": "見なくて平気"},
        { "location": "249/TALK"  , "narrator": "千羽鶴", "text": "そう、わかった。"},
        { "location": "250/TALK"  , "narrator": "千羽鶴", "text": "是非恋ヶ崎みやびのココロを\n落ち着かせて、状況を改善\nできるようにして欲しい。"},
        { "location": "263/TALK"  , "narrator": "千羽鶴", "text": "どう？\nどういう状況だったか\n思い出せた？"},
        { "location": "264/TALK"  , "narrator": "千羽鶴", "text": "是非、恋ヶ崎みやびの\nココロを落ち着かせて――"},
        { "location": "265/TALK"  , "narrator": "千羽鶴", "text": "この映像のように、\n的確な支援で状況を改善\nできるようにして欲しい。"},
        { "location": "234/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "ガブリエラが女騎士を牽制したことで\nチャンスが生まれた。\nアーヤは女騎士とつばめとの間に\n入り込み、つばめを庇いつつ戦う。\n\nみやびはつばめを女騎士から\n引き離し、遠くへ連れて行こうと\nするが、つばめはそれを拒否。\n\n<b><color=red>「どうしてこんなことに！？　　　　\n　　　　メノウちゃんを助けたい！」</color></b>\n\nそれを聞いてみやびは驚く。\nフェノメノンの中では皆\n洗脳されてしまう筈なのに、\nつばめはライブだったことを覚えてる。\n\nつばめには何かあると思ったみやびは\nつばめを守りつつメノウを助けに行く。\n\nだがそれが仇となった。\nあと少しでメノウを助けられる、\nそんな時油断したのだ。\n\n<b><color=red>逢瀬つばめは、女騎士に背中から\n一突きされ、心臓を貫かれて死亡した。</color></b>\n"}
    ]
}
