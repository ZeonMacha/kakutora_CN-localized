        { "location": "2624/TALK"    , "narrator": "神楽", "text": "星のささやき、大地の響き"},
        { "location": "2625/TALK"    , "narrator": "神楽", "text": "マンモス狩りに出発だー！！！！"},
        { "location": "2627/SEL"     , "narrator": "", "text": "最後なんでそうなったｗ"},
        { "location": "2628/SEL"     , "narrator": "", "text": "考古学の話かな？"},
        { "location": "2629/SEL"     , "narrator": "", "text": "今夜は焼肉だー！！！！"},
        { "location": "2630/ACT"     , "narrator": "", "text": "最後なんでそうなったｗ"},
        { "location": "2631/TALK"    , "narrator": "神楽", "text": "なんでかな（真顔）"},
        { "location": "2632/ACT"     , "narrator": "", "text": "考古学の話かな？"},
        { "location": "2633/TALK"    , "narrator": "神楽", "text": "おかしいところしか散見されませんぴょん♪"},
        { "location": "2634/ACT"     , "narrator": "", "text": "今夜は焼肉だー！！！！"},
        { "location": "2636/TALK"    , "narrator": "神楽", "text": "イヤッフー！！１！！"},
        { "location": "2638/TALK"    , "narrator": "神楽", "text": "肉肉肉肉にくまつり！！！"},
        { "location": "2639/TALK"    , "narrator": "神楽", "text": "大いに喰らう！！！"},
        { "location": "2641/TALK"    , "narrator": "神楽", "text": "たまには和風のしっとりとしたぴょんこをお目に掛けようと思っていたのです"},
        { "location": "2642/TALK"    , "narrator": "神楽", "text": "そのつもりがこのていたらく（ため息）"},
        { "location": "2644/SEL"     , "narrator": "", "text": "新しい一面が見れてうれしいよ"},
        { "location": "2645/SEL"     , "narrator": "", "text": "なんでだろうね…？"},
        { "location": "2646/SEL"     , "narrator": "", "text": "無理しないで"},
        { "location": "2647/ACT"     , "narrator": "", "text": "新しい一面が見れてうれしいよ"},
        { "location": "2649/TALK"    , "narrator": "神楽", "text": "そう？"},
        { "location": "2650/TALK"    , "narrator": "神楽", "text": "ぴょんこ不安だったけど"},
        { "location": "2651/TALK"    , "narrator": "神楽", "text": "$handlek$がそう言ってくれてうれしいぴょん♪"},
        { "location": "2652/ACT"     , "narrator": "", "text": "なんでだろうね…？"},
        { "location": "2653/TALK"    , "narrator": "神楽", "text": "ぴょんこが聞きたいのですー！"},
        { "location": "2654/ACT"     , "narrator": "", "text": "無理しないで"},
        { "location": "2655/TALK"    , "narrator": "神楽", "text": "そうする"},
        { "location": "2657/TALK"    , "narrator": "神楽", "text": "それにしてもマンモス肉ってどんな味なんだろうねじゅるり"},
        { "location": "2659/TALK"    , "narrator": "神楽", "text": "草食のぴょんこには想像もつかないぴょん♪"}
