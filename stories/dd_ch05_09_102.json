{
    "dir": "chap09/daydra/dd_ch05_09_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "9505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "乙女と悪女＜後編＞"
    },
    "entry":
    [
        { "location": "2249/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2250/TALK"  , "narrator": "神楽", "text": "でも、せっかくこんなに\n楽しくお話ししたのに…。"},
        { "location": "2251/TALK"  , "narrator": "神楽", "text": "最後の最後で空気を\n悪くしちゃうのは、\nイヤかも…。"},
        { "location": "2252/TALK"  , "narrator": "繭", "text": "…無理しないで、\n断ってもいいのよ？"},
        { "location": "2254/TALK"  , "narrator": "神楽", "text": "え？"},
        { "location": "2255/TALK"  , "narrator": "繭", "text": "部屋は自分にとって、\n聖域と言ってもいい\nプライベートな空間。"},
        { "location": "2256/TALK"  , "narrator": "繭", "text": "他人に見られたくない\nモノがあったとしても、\nそれは普通だもの。"},
        { "location": "2258/TALK"  , "narrator": "雛", "text": "あー、そっかぁ…。\nそういう場合もあるの\n考えてなかったなー。"},
        { "location": "2260/TALK"  , "narrator": "神楽", "text": "いえ、その…。"},
        { "location": "2261/TALK"  , "narrator": "神楽", "text": "見られたくない、\nという点に関しては、\n間違いじゃないけど…。"},
        { "location": "2263/TALK"  , "narrator": "神楽", "text": "まあ、そういうことに\nしておこっと。"},
        { "location": "2264/TALK"  , "narrator": "神楽", "text": "ごめんなさい。\nひなこさんの期待に\n応えられなくて…。"},
        { "location": "2266/TALK"  , "narrator": "雛", "text": "あはは、いいのいいのー。"},
        { "location": "2267/TALK"  , "narrator": "雛", "text": "こっちこそ、\n無理言って困らせちゃった\nみたいで、ごめんねー。"},
        { "location": "2268/TALK"  , "narrator": "神楽", "text": "いえ、そんな…。\nまた一緒にお茶しに\n来ましょうね。"},
        { "location": "2270/TALK"  , "narrator": "繭", "text": "次はラノベ縛りで。"},
        { "location": "2271/TALK"  , "narrator": "神楽", "text": "絶対やりましょう！"},
        { "location": "2272/TALK"  , "narrator": "雛", "text": "あたしも予習して\nおくよー。"},
        { "location": "2294/TALK"  , "narrator": "神楽", "text": "はぁーっ…楽しかった♪"},
        { "location": "2295/TALK"  , "narrator": "神楽", "text": "こんなに楽しい時間を\n過ごしたのって、\nすごく久しぶりかも。"},
        { "location": "2296/SEL"   , "narrator": "", "text": "機嫌よさそうだね"},
        { "location": "2297/ACT"   , "narrator": "", "text": "機嫌よさそうだね"},
        { "location": "2313/TALK"  , "narrator": "神楽", "text": "そうなんですよ"},
        { "location": "2314/TALK"  , "narrator": "神楽", "text": "今日はとっても楽しい一日だったんです"},
        { "location": "2315/TALK"  , "narrator": "神楽", "text": "ひなこさん達と放課後に"},
        { "location": "2316/TALK"  , "narrator": "神楽", "text": "とっても楽しい時間を過ごせたから"},
        { "location": "2318/SEL"   , "narrator": "", "text": "そんなに楽しい話したっけ？"},
        { "location": "2319/SEL"   , "narrator": "", "text": "普通の女子高生みたいだった"},
        { "location": "2320/ACT"   , "narrator": "", "text": "そんなに楽しい話したっけ？"},
        { "location": "2321/TALK"  , "narrator": "神楽", "text": "しましたよ"},
        { "location": "2322/TALK"  , "narrator": "神楽", "text": "ちょっとだけだったけど"},
        { "location": "2323/TALK"  , "narrator": "神楽", "text": "ラノベの話とか"},
        { "location": "2324/ACT"   , "narrator": "神楽", "text": "普通の女子高生みたいだった"},
        { "location": "2325/TALK"  , "narrator": "神楽", "text": "あの時間は"},
        { "location": "2326/TALK"  , "narrator": "神楽", "text": "色んな考えなければならないこと"},
        { "location": "2327/TALK"  , "narrator": "神楽", "text": "全部頭の中から抜けてましたから"},
        { "location": "2328/TALK"  , "narrator": "神楽", "text": "それにちょっとだけど"},
        { "location": "2329/TALK"  , "narrator": "神楽", "text": "ラノベの話もできましたし"},
        { "location": "2331/TALK"  , "narrator": "神楽", "text": "繭さんがオンオフとダダマホを知ってたなんて"},
        { "location": "2332/TALK"  , "narrator": "神楽", "text": "今度じっくり語り合いたいです"},
        { "location": "2333/TALK"  , "narrator": "神楽", "text": "その時はひなこさんも一緒だったらいいんですけど"},
        { "location": "2335/SEL"   , "narrator": "", "text": "本当に二人のことが気に入ったんだね"},
        { "location": "2336/SEL"   , "narrator": "", "text": "$me$もラノベを読んだ方がいい？"},
        { "location": "2337/ACT"   , "narrator": "", "text": "本当に二人のことが気に入ったんだね"},
        { "location": "2338/TALK"  , "narrator": "神楽", "text": "はい！"},
        { "location": "2341/TALK"  , "narrator": "神楽", "text": "実は話してるときに"},
        { "location": "2342/TALK"  , "narrator": "神楽", "text": "ちょっとだけ冷たい態度を取りそうな気持ちになっちゃって"},
        { "location": "2343/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "2344/TALK"  , "narrator": "神楽", "text": "思いとどまってよかった"},
        { "location": "2345/TALK"  , "narrator": "神楽", "text": "言ってたら多分今頃"},
        { "location": "2346/TALK"  , "narrator": "神楽", "text": "ずっと後悔してたと思うし"},
        { "location": "2350/TALK"  , "narrator": "神楽", "text": "こんなに素敵なお友達ができるなんて"},
        { "location": "2351/TALK"  , "narrator": "神楽", "text": "思ってませんでした"},
        { "location": "2352/TALK"  , "narrator": "神楽", "text": "早くまた一緒にでかけたいです"},
        { "location": "2353/ACT"   , "narrator": "", "text": "$me$もラノベを読んだ方がいい？"},
        { "location": "2354/TALK"  , "narrator": "神楽", "text": "読むべきですよ"},
        { "location": "2355/TALK"  , "narrator": "神楽", "text": "面白いラノベは沢山あるんだから"},
        { "location": "2356/TALK"  , "narrator": "神楽", "text": "きっと気に入るのが見つかるはずです"},
        { "location": "2357/TALK"  , "narrator": "神楽", "text": "$handle$さんにあった一冊が見つかるといいですね"},
        { "location": "2359/TALK"  , "narrator": "神楽", "text": "ごめんなさい"},
        { "location": "2360/TALK"  , "narrator": "神楽", "text": "ひなこさん達にお礼のＷＡＶＥ送らないといけないので"},
        { "location": "2361/TALK"  , "narrator": "神楽", "text": "お話はまた後で"},
        { "location": "2365/TALK"  , "narrator": "神楽", "text": "えっと…先ほどはどうも\nありがとう――"},
        { "location": "2366/TALK"  , "narrator": "神楽", "text": "うーん…これだと\nちょっと堅い感じに\nなっちゃうから…。"},
        { "location": "2367/TALK"  , "narrator": "神楽", "text": "今日は楽しかったです。\nまた行きましょうね、と。"},
        { "location": "2368/TALK"  , "narrator": "神楽", "text": "…うん、これでよし。"},
        { "location": "2371/TALK"  , "narrator": "神楽", "text": "ふふっ…、\n次のお休みの日が\n楽しみだなぁ…。"},
        { "location": "2380/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【07 愛，ロボット】"},
        { "location": "2392/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【07 愛，ロボット】"}
    ]
}
