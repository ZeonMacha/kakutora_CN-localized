    "info": {
        "story_id": "23553",
        "cid": "kagura",
        "title": "Extra003 ヒメゴトチャット",
        "sub_title": "ほんとうに、それは"
    },
    "entry":
    [
        { "location": "7577/SCENARIO", "narrator": "", "text": "ほんとうに、それは"},
        { "location": "7604/TALK"    , "narrator": "神楽", "text": "あんまり生活感を出されると困るぴょん、、、"},
        { "location": "7605/TALK"    , "narrator": "神楽", "text": "でも全然出さないのも作りものめいてて感情移入できないぴょん"},
        { "location": "7606/TALK"    , "narrator": "神楽", "text": "さじ加減が難しいぴょん"},
        { "location": "7608/SEL"     , "narrator": "", "text": "神楽のすべてが知りたいな"},
        { "location": "7609/SEL"     , "narrator": "", "text": "生活感ってしみったれた感じにならない？"},
        { "location": "7610/SEL"     , "narrator": "", "text": "どうせなら格好いい方がいいでしょ"},
        { "location": "7611/ACT"     , "narrator": "", "text": "神楽のすべてが知りたいな"},
        { "location": "7613/TALK"    , "narrator": "神楽", "text": "またそういうことばっかり★"},
        { "location": "7615/TALK"    , "narrator": "神楽", "text": "いい加減聞きあきたぴょん"},
        { "location": "7616/TALK"    , "narrator": "神楽", "text": "もっと直球で愛を叫べ！"},
        { "location": "7617/TALK"    , "narrator": "神楽", "text": "そうしたら信じてあげる☆彡"},
        { "location": "7618/ACT"     , "narrator": "", "text": "生活感ってしみったれた感じにならない？"},
        { "location": "7619/TALK"    , "narrator": "神楽", "text": "だから難しいんだってば"},
        { "location": "7620/ACT"     , "narrator": "", "text": "どうせなら格好いい方がいいでしょ"},
        { "location": "7621/TALK"    , "narrator": "神楽", "text": "それはそうなんだけど限度ってもんがあるでしょー！？"},
        { "location": "7622/TALK"    , "narrator": "神楽", "text": "やみくもに格好いいだけだったらダメなんだぴょん！"},
        { "location": "7624/TALK"    , "narrator": "神楽", "text": "しかもこの匙加減ってターゲットによっても変わるぴょん"},
        { "location": "7625/TALK"    , "narrator": "神楽", "text": "アキバ系のリアリティと映画ファンのリアリティは全く違うし"},
        { "location": "7626/TALK"    , "narrator": "神楽", "text": "昼ドラと深夜ドラマでもまた違うし"},
        { "location": "7627/TALK"    , "narrator": "神楽", "text": "万人受けなんてこの世には存在しないんだぴょん！！！！"}
    ]
}
