    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "04-01_約束通りに"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "約束は果たしてもらうぞね"},
        { "location": "35/SEL"    , "narrator": "", "text": "はいはい"},
        { "location": "36/SEL"    , "narrator": "", "text": "別にいいけど"},
        { "location": "37/SEL"    , "narrator": "", "text": "約束とかした？"},
        { "location": "38/ACT"    , "narrator": "", "text": "はいはい"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "ハイは一度で！"},
        { "location": "40/ACT"    , "narrator": "", "text": "別にいいけど"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "余裕だな"},
        { "location": "42/ACT"    , "narrator": "", "text": "約束とかした？"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "しらばっくれか"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "まず聞こう"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "このコンタクトはうちに対する挑戦か？"},
        { "location": "49/SEL"    , "narrator": "", "text": "何の話？"},
        { "location": "50/SEL"    , "narrator": "", "text": "そうですよ"},
        { "location": "51/SEL"    , "narrator": "", "text": "みやびと話したいだけ"},
        { "location": "52/ACT"    , "narrator": "", "text": "何の話？"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "そういう話ぞね"},
        { "location": "54/ACT"    , "narrator": "", "text": "そうですよ"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "居直りか"},
        { "location": "56/ACT"    , "narrator": "", "text": "みやびと話したいだけ"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "なるほど奇遇だ"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "うちも同じ気持ち"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "ということは"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "両想い！"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "いやーてれるー"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "要は"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "貴殿の足取りが全くつかめず"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "なのに貴殿からの連絡はあり"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "それはどういうことなのか、というところなのだが"},
        { "location": "77/SEL"    , "narrator": "", "text": "$me$は仕組みは知らないので"},
        { "location": "78/SEL"    , "narrator": "", "text": "解析はみやびさんに任せる"},
        { "location": "79/SEL"    , "narrator": "", "text": "愛の電波で通信中"},
        { "location": "80/ACT"    , "narrator": "", "text": "$me$は仕組みは知らないので"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "なんとも理解に苦しむbot"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "いや、はぐらかしか"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "ぬうううう"},
        { "location": "84/ACT"    , "narrator": "", "text": "解析はみやびさんに任せる"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "よし任せられた"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "ということは"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "約束は反故か！"},
        { "location": "88/ACT"    , "narrator": "", "text": "愛の電波で通信中"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "それはうちには解析不能"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "愛ならば"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "うちのプライドを保ったままシステムをリークせよ"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "$handle$め"},
        { "location": "62/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "94/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "122/DIALOG", "narrator": "Dialog_chapter_ch04", "text": "【02 PrisMATRIX．】"}
    ]
}
