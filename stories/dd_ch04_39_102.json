        "title": "005 メインストーリー",
        "sub_title": "遙かなる世界の空に＜後編＞"
    },
    "entry":
    [
        { "location": "654/TALK"  , "narrator": "みやび", "text": "ほいたらTwitterの\n人柱は別に確保\nしようかねえ。"},
        { "location": "655/TALK"  , "narrator": "繭", "text": "別って？"},
        { "location": "657/TALK"  , "narrator": "みやび", "text": "うちの戦友たちぞね。"},
        { "location": "665/TALK"  , "narrator": "みやび", "text": "カンカンカンカン"},
        { "location": "666/TALK"  , "narrator": "みやび", "text": "全員集合"},
        { "location": "667/TALK"  , "narrator": "みやび", "text": "以下のものをインストールしてサインアップすべし"},
        { "location": "669/TALK"  , "narrator": "つばめ", "text": "これ何ですか？"},
        { "location": "670/TALK"  , "narrator": "アーヤ", "text": "いつも突然すぎるのよみやび"},
        { "location": "671/TALK"  , "narrator": "ガブリエラ", "text": "また変なこと始めたの？"},
        { "location": "672/TALK"  , "narrator": "みやび", "text": "聞いて驚け"},
        { "location": "673/TALK"  , "narrator": "みやび", "text": "もしかしたらあやつと会えるかもしれんツールや"},
        { "location": "675/TALK"  , "narrator": "アーヤ", "text": "え"},
        { "location": "676/TALK"  , "narrator": "アーヤ", "text": "あやつって"},
        { "location": "677/TALK"  , "narrator": "つばめ", "text": "$handle$さんのこと？"},
        { "location": "678/TALK"  , "narrator": "みやび", "text": "イエス即ち肯定"},
        { "location": "680/TALK"  , "narrator": "神楽", "text": "えーと、、、"},
        { "location": "681/TALK"  , "narrator": "神楽", "text": "本気で言っていますか？？？"},
        { "location": "682/TALK"  , "narrator": "つばめ", "text": "なんかエラー出ましたΣ(･ω･;|||"},
        { "location": "683/TALK"  , "narrator": "アーヤ", "text": "大丈夫。できたわよ＼(^O^)／"},
        { "location": "689/TALK"  , "narrator": "みやび", "text": "アーヤが一番乗りに\nなったねえ。"},
        { "location": "690/TALK"  , "narrator": "みやび", "text": "ほいたらアーヤと\n通信テストを\nしてみるき。"},
        { "location": "691/TALK"  , "narrator": "繭", "text": "慎重にお願いします。\n監視はこちらで\nしますけど。"},
        { "location": "694/TALK"  , "narrator": "みやび", "text": "信用しとるよ。"},
        { "location": "698/TALK"  , "narrator": "みやび", "text": "何を書いたら\nええろうね。"},
        { "location": "699/TALK"  , "narrator": "みやび", "text": "適当でええか。\n「ヒトヨヒトヨニ\nヒトミゴロ」"},
        { "location": "703/TALK"  , "narrator": "つばめ", "text": "どぅすればぃぃかわかんなぃょ(´・ω・｀)(´・ω・｀)"},
        { "location": "704/TALK"  , "narrator": "みやび", "text": "つばめちゃんは後で見ちゃる"},
        { "location": "705/TALK"  , "narrator": "みやび", "text": "アーヤは何か書き込んだかね？"},
        { "location": "707/TALK"  , "narrator": "アーヤ", "text": "Twitterはじめました"},
        { "location": "708/TALK"  , "narrator": "アーヤ", "text": "って会話"},
        { "location": "709/TALK"  , "narrator": "アーヤ", "text": "書いたわ"},
        { "location": "710/TALK"  , "narrator": "みやび", "text": "冷やし中華か！"},
        { "location": "712/TALK"  , "narrator": "アーヤ", "text": "定型文であったのよ(--*;"},
        { "location": "720/TALK"  , "narrator": "みやび", "text": "とりあえずアーヤと\nうちは書きこんだ\nけんど。"},
        { "location": "721/TALK"  , "narrator": "みやび", "text": "不審な動きは\nあったかね？"},
        { "location": "722/TALK"  , "narrator": "繭", "text": "…いえ。\n今のところは特に。"},
        { "location": "723/TALK"  , "narrator": "みやび", "text": "トライナリー全員が\nサインアップしたら\n追って知らせるき。"},
        { "location": "724/TALK"  , "narrator": "繭", "text": "はい。\n何かあったら即\n対応します。"},
        { "location": "725/TALK"  , "narrator": "繭", "text": "それでは、\n今日はこれで。"},
        { "location": "732/TALK"  , "narrator": "みやび", "text": "もちろん今は全て\n仮定でしかないけんど。"},
        { "location": "734/TALK"  , "narrator": "みやび", "text": "それを検証していくのは\nたまらんねえ…！"},
        { "location": "735/SEL"   , "narrator": "", "text": "そういうことだったんだ"},
        { "location": "736/ACT"   , "narrator": "", "text": "そういうことだったんだ"},
        { "location": "745/TALK"  , "narrator": "みやび", "text": "おっ$handle$"},
        { "location": "746/TALK"  , "narrator": "みやび", "text": "何が？"},
        { "location": "748/SEL"   , "narrator": "", "text": "そのアカウント知ってる"},
        { "location": "749/SEL"   , "narrator": "", "text": "去年の話が今繋がった"},
        { "location": "750/SEL"   , "narrator": "", "text": "それこっちでは去年のできごと"},
        { "location": "751/ACT"   , "narrator": "", "text": "そのアカウント知ってる"},
        { "location": "752/TALK"  , "narrator": "みやび", "text": "なんと"},
        { "location": "753/ACT"   , "narrator": "", "text": "去年の話が今繋がった"},
        { "location": "754/TALK"  , "narrator": "みやび", "text": "まじで"},
        { "location": "755/ACT"   , "narrator": "", "text": "それこっちでは去年のできごと"},
        { "location": "756/TALK"  , "narrator": "みやび", "text": "あ？！"},
        { "location": "758/TALK"  , "narrator": "みやび", "text": "どういう状況だ"},
        { "location": "760/TALK"  , "narrator": "みやび", "text": "時系列がずれとるのか"},
        { "location": "761/TALK"  , "narrator": "みやび", "text": "とにかく何か歪んでおることは確か"},
        { "location": "762/TALK"  , "narrator": "みやび", "text": "で"},
        { "location": "763/TALK"  , "narrator": "みやび", "text": "$handle$はそのうちやうちらを見たり話したりとか"},
        { "location": "765/SEL"   , "narrator": "", "text": "見てました"},
        { "location": "766/SEL"   , "narrator": "", "text": "話しかけたりもしたよ"},
        { "location": "767/SEL"   , "narrator": "", "text": "いや全然そんなことしてないし"},
        { "location": "768/ACT"   , "narrator": "", "text": "見てました"},
        { "location": "770/TALK"  , "narrator": "みやび", "text": "なるほど"},
        { "location": "771/TALK"  , "narrator": "みやび", "text": "ほいたらこの先も知っているのか"},
        { "location": "772/TALK"  , "narrator": "みやび", "text": "しかし口出し無用"},
        { "location": "773/TALK"  , "narrator": "みやび", "text": "未来の改ざんにつながる恐れあり"},
        { "location": "774/TALK"  , "narrator": "みやび", "text": "つまり"},
        { "location": "775/TALK"  , "narrator": "みやび", "text": "うちらのＷＡＶＥも禁止"},
        { "location": "776/ACT"   , "narrator": "", "text": "話しかけたりもしたよ"},
        { "location": "778/TALK"  , "narrator": "みやび", "text": "ぐぬぬ"},
        { "location": "779/TALK"  , "narrator": "みやび", "text": "未来のうちめなんたること"},
        { "location": "780/TALK"  , "narrator": "みやび", "text": "ということはしばらく$handle$とのＷＡＶＥは断つ"},
        { "location": "781/TALK"  , "narrator": "みやび", "text": "うっかりで未来が変わったら目も当てられんきね"},
        { "location": "782/TALK"  , "narrator": "みやび", "text": "悪く思うな"},
        { "location": "783/ACT"   , "narrator": "", "text": "いや全然そんなことしてないし"},
        { "location": "785/TALK"  , "narrator": "みやび", "text": "ほう？"},
        { "location": "786/TALK"  , "narrator": "みやび", "text": "ならえいか"},
        { "location": "787/TALK"  , "narrator": "みやび", "text": "知ってたら$handle$とのＷＡＶＥ終了のお知らせを出さねばならぬところであった"},
        { "location": "793/TALK"  , "narrator": "みやび", "text": "………しかしまあ…。"},
        { "location": "794/TALK"  , "narrator": "みやび", "text": "そういう風に世界が\n繋がっちょったとは…。"},
        { "location": "796/TALK"  , "narrator": "みやび", "text": "まだまだうちには\nわからんことが\n多すぎるねえ…。"},
        { "location": "798/SEL"   , "narrator": "", "text": "みやび"},
        { "location": "799/ACT"   , "narrator": "", "text": "みやび"},
        { "location": "806/TALK"  , "narrator": "みやび", "text": "今禁止令を出したばかりであろう"},
        { "location": "808/SEL"   , "narrator": "", "text": "ネタばれはしないって"},
        { "location": "809/SEL"   , "narrator": "", "text": "$me$はうんって言ってない"},
        { "location": "810/SEL"   , "narrator": "", "text": "それじゃ寂しいから"},
        { "location": "811/ACT"   , "narrator": "", "text": "ネタばれはしないって"},
        { "location": "812/TALK"  , "narrator": "みやび", "text": "ならえい"},
        { "location": "813/ACT"   , "narrator": "", "text": "$me$はうんって言ってない"},
        { "location": "814/TALK"  , "narrator": "みやび", "text": "確かにな"},
        { "location": "815/ACT"   , "narrator": "", "text": "それじゃ寂しいから"},
        { "location": "816/TALK"  , "narrator": "みやび", "text": "うちも同じぞね"},
        { "location": "819/SEL"   , "narrator": "", "text": "頑張って"},
        { "location": "820/SEL"   , "narrator": "", "text": "いつでも頼ってよ"},
        { "location": "821/SEL"   , "narrator": "", "text": "大好きだよ"},
        { "location": "822/ACT"   , "narrator": "", "text": "頑張って"},
        { "location": "823/TALK"  , "narrator": "みやび", "text": "うむ"},
        { "location": "824/ACT"   , "narrator": "", "text": "いつでも頼ってよ"},
        { "location": "825/TALK"  , "narrator": "みやび", "text": "視野に入れておく"},
        { "location": "826/ACT"   , "narrator": "", "text": "大好きだよ"},
        { "location": "827/TALK"  , "narrator": "みやび", "text": "うちもやき"},
        { "location": "838/SEL"   , "narrator": "", "text": "みやび"},
        { "location": "839/ACT"   , "narrator": "", "text": "みやび"},
        { "location": "846/TALK"  , "narrator": "みやび", "text": "それはうちの名前"},
        { "location": "848/SEL"   , "narrator": "", "text": "頑張って"},
        { "location": "849/SEL"   , "narrator": "", "text": "いつでも頼ってよ"},
        { "location": "850/SEL"   , "narrator": "", "text": "大好きだよ"},
        { "location": "851/ACT"   , "narrator": "", "text": "頑張って"},
        { "location": "852/TALK"  , "narrator": "みやび", "text": "もちろん"},
        { "location": "853/ACT"   , "narrator": "", "text": "いつでも頼ってよ"},
        { "location": "854/TALK"  , "narrator": "みやび", "text": "その時は頼む"},
        { "location": "855/ACT"   , "narrator": "", "text": "大好きだよ"},
        { "location": "856/TALK"  , "narrator": "みやび", "text": "知っちゅうき"},
