    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "016_刹那という永遠とかそういうやつ"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "電脳世界には感情はどのようにメモリーされておるかね"},
        { "location": "35/SEL"    , "narrator": "", "text": "まあ普通に"},
        { "location": "36/SEL"    , "narrator": "", "text": "そういうのはないです"},
        { "location": "37/SEL"    , "narrator": "", "text": "閾値を知りたいと"},
        { "location": "38/ACT"    , "narrator": "", "text": "まあ普通に"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "普通とは"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "これはまたあいまいな"},
        { "location": "41/ACT"    , "narrator": "", "text": "そういうのはないです"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "断定したぞね"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "残念無念"},
        { "location": "44/ACT"    , "narrator": "", "text": "閾値を知りたいと"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "左様"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "知らせたまえ"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "数式で"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "恋などという感情は一時のものだという"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "それを永遠に留めることができないものか"},
        { "location": "52/SEL"    , "narrator": "", "text": "一瞬だからいいんだよ"},
        { "location": "53/SEL"    , "narrator": "", "text": "できるよ"},
        { "location": "54/SEL"    , "narrator": "", "text": "みやびに永遠の愛を誓う"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "いやなに、他人の恋路を見た時の興味からそう思っただけぞね"},
        { "location": "57/ACT"    , "narrator": "", "text": "一瞬だからいいんだよ"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "そんなことはわかっとらあね"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "それをどうにかちう話ぞね"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "この一瞬も"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "そういう"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "輝きだと思えば"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "なんてな"},
        { "location": "67/ACT"    , "narrator": "", "text": "できるよ"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "ほう"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "わかってないな"},
        { "location": "70/ACT"    , "narrator": "", "text": "みやびに永遠の愛を誓う"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "そりゃ"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "どーも"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "ほんに"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "気持ちばかりは"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "見当つかぬ"}
    ]
}
