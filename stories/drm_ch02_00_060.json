{
    "dir": "dramatics/daydra/drm_ch02_00_060.js",
    "type": "Episode",
    "info": {
        "story_id": "2006",
        "cid": "ayami",
        "title": "らぶとーく 第06話",
        "sub_title": "マニュアルじゃなくて"
    },
    "entry":
    [
        { "location": "356/SCENARIO", "narrator": "", "text": "マニュアルじゃなくて"},
        { "location": "369/TALK"    , "narrator": "真幌", "text": "アーヤの部屋は\n片付いてるな。"},
        { "location": "371/TALK"    , "narrator": "アーヤ", "text": "……。\nそうでも\nないですよ。"},
        { "location": "372/TALK"    , "narrator": "真幌", "text": "私の部屋と\n交換して欲しいな。"},
        { "location": "374/TALK"    , "narrator": "アーヤ", "text": "え！？"},
        { "location": "377/TALK"    , "narrator": "真幌", "text": "あはは。\n冗談、冗談。"},
        { "location": "380/TALK"    , "narrator": "真幌", "text": "それより何だ？\nわざわざ\n聞きたいことって。"},
        { "location": "383/TALK"    , "narrator": "アーヤ", "text": "ええと…。"},
        { "location": "384/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔのことなん\nですけど…。"},
        { "location": "388/TALK"    , "narrator": "アーヤ", "text": "トライガジェットの\n機能の。"},
        { "location": "389/TALK"    , "narrator": "真幌", "text": "ああ。\n今さら使い方が\nわからないってことか。"},
        { "location": "390/TALK"    , "narrator": "真幌", "text": "それなら私より…。"},
        { "location": "391/TALK"    , "narrator": "アーヤ", "text": "あ、いえ。\nそうじゃなくて。"},
        { "location": "392/TALK"    , "narrator": "アーヤ", "text": "仕様とかが\nわかる資料って\nないでしょうか？"},
        { "location": "393/TALK"    , "narrator": "真幌", "text": "ん？\nマニュアルじゃ\nなくて？"},
        { "location": "394/TALK"    , "narrator": "アーヤ", "text": "はい。\n仕様です。"},
        { "location": "395/TALK"    , "narrator": "真幌", "text": "……んー……。"},
        { "location": "396/TALK"    , "narrator": "真幌", "text": "知らないし\nもし知っていたとしても\nアーヤには渡せない。"},
        { "location": "397/TALK"    , "narrator": "真幌", "text": "私の立場上な。"},
        { "location": "399/TALK"    , "narrator": "アーヤ", "text": "…そうですか…。"},
        { "location": "400/TALK"    , "narrator": "真幌", "text": "それより。\nなんでそんなものを\n見たがるんだ？"},
        { "location": "403/TALK"    , "narrator": "アーヤ", "text": "え。"},
        { "location": "404/TALK"    , "narrator": "真幌", "text": "何か困ったことが\nあったのか？"},
        { "location": "408/TALK"    , "narrator": "アーヤ", "text": "え、と。"},
        { "location": "409/SEL"     , "narrator": "", "text": "やあやあ"},
        { "location": "410/ACT"     , "narrator": "", "text": "やあやあ"},
        { "location": "415/TALK"    , "narrator": "真幌", "text": "スマホ、鳴ったぞ。"},
        { "location": "418/TALK"    , "narrator": "アーヤ", "text": "…。"},
        { "location": "419/TALK"    , "narrator": "真幌", "text": "遠慮せず出ればいい。"},
        { "location": "433/TALK"    , "narrator": "アーヤ", "text": "やあやあって"},
        { "location": "434/TALK"    , "narrator": "アーヤ", "text": "ずいぶんのんきね"},
        { "location": "436/SEL"     , "narrator": "", "text": "駄目？"},
        { "location": "437/SEL"     , "narrator": "", "text": "気楽にやろうよ"},
        { "location": "438/ACT"     , "narrator": "", "text": "駄目？"},
        { "location": "439/TALK"    , "narrator": "アーヤ", "text": "ダメっていうか"},
        { "location": "440/TALK"    , "narrator": "アーヤ", "text": "今、館長いるから"},
        { "location": "441/TALK"    , "narrator": "アーヤ", "text": "後でね"},
        { "location": "442/ACT"     , "narrator": "", "text": "気楽にやろうよ"},
        { "location": "443/TALK"    , "narrator": "アーヤ", "text": "気楽に"},
        { "location": "444/TALK"    , "narrator": "アーヤ", "text": "できないときもあるのよ"},
        { "location": "445/TALK"    , "narrator": "アーヤ", "text": "今日はできないの"},
        { "location": "446/TALK"    , "narrator": "アーヤ", "text": "だから後でね"},
        { "location": "458/TALK"    , "narrator": "真幌", "text": "急ぎの用とかじゃ\nないのか？"},
        { "location": "460/TALK"    , "narrator": "アーヤ", "text": "あ、違います。"},
        { "location": "461/TALK"    , "narrator": "真幌", "text": "で、さっきの\n続きだが。"},
        { "location": "462/TALK"    , "narrator": "真幌", "text": "困ったことが\nあるなら\n教えて欲しい。"},
        { "location": "463/TALK"    , "narrator": "真幌", "text": "これでも一応\n上司だし。"},
        { "location": "464/TALK"    , "narrator": "真幌", "text": "できる限り\n力になりたいと\n思っている。"},
        { "location": "466/TALK"    , "narrator": "アーヤ", "text": "…はい…。"},
        { "location": "467/TALK"    , "narrator": "真幌", "text": "そんな顔をするな。"},
        { "location": "468/TALK"    , "narrator": "真幌", "text": "と言っても\n無理か。"},
        { "location": "469/TALK"    , "narrator": "真幌", "text": "もしお姉さんに\n連絡がつくなら…。"},
        { "location": "471/TALK"    , "narrator": "アーヤ", "text": "それだけは\nいやです。"},
        { "location": "473/TALK"    , "narrator": "真幌", "text": "……。"},
        { "location": "475/TALK"    , "narrator": "真幌", "text": "そう言われる\n気はしてたが。"},
        { "location": "478/TALK"    , "narrator": "真幌", "text": "じゃあ次点は\nみやびだろう。"},
        { "location": "479/TALK"    , "narrator": "真幌", "text": "残念ながら本当に\n知る立場にないんだ\n私は。"},
        { "location": "481/TALK"    , "narrator": "アーヤ", "text": "……。"},
        { "location": "482/TALK"    , "narrator": "真幌", "text": "役に立てず\nすまないね。"},
        { "location": "484/TALK"    , "narrator": "アーヤ", "text": "いえ。\nこちらこそ\nすみませんでした。"},
        { "location": "485/TALK"    , "narrator": "真幌", "text": "…見つかるといいな。\n捜し物。"},
        { "location": "487/TALK"    , "narrator": "アーヤ", "text": "……。"},
        { "location": "367/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月某日　9:02 PM</color>\nとある平日の夜、アーヤの部屋にて。"}
    ]
}
