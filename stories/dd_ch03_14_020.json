{
    "dir": "chap14/daydra/dd_ch03_14_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "14356",
        "cid": "gabriella",
        "title": "Extra005 プレミアムストーリー",
        "sub_title": "國政綾水と大遅刻！"
    },
    "entry":
    [
        { "location": "285/SCENARIO", "narrator": "", "text": "アーヤＭＶ回２"},
        { "location": "296/TALK"    , "narrator": "つばめ", "text": "えーっと、\n鍵、鍵、っと…。"},
        { "location": "302/TALK"    , "narrator": "ガブリエラ", "text": "つばめ、\nもう学校行くの？"},
        { "location": "304/TALK"    , "narrator": "つばめ", "text": "今日は日直だから。\nガブちゃん、どこか\n行ってたの？"},
        { "location": "305/TALK"    , "narrator": "ガブリエラ", "text": "早起きしたから、\nジョギングにね。"},
        { "location": "306/TALK"    , "narrator": "つばめ", "text": "わぁ、朝から走る\nなんて凄いなぁ…。"},
        { "location": "307/TALK"    , "narrator": "ガブリエラ", "text": "つばめも走ったら？\nただでさえどんくさい\nんだし。"},
        { "location": "309/TALK"    , "narrator": "つばめ", "text": "あ、あはは…。\n早起きできた日は\nやるようにするよ。"},
        { "location": "310/TALK"    , "narrator": "つばめ", "text": "それじゃ、学校でね。"},
        { "location": "323/TALK"    , "narrator": "ガブリエラ", "text": "さて、と…。\n登校までまだ時間が\nあるし…。"},
        { "location": "324/SEL"     , "narrator": "", "text": "おはよう"},
        { "location": "325/ACT"     , "narrator": "", "text": "おはよう"},
        { "location": "342/TALK"    , "narrator": "ガブリエラ", "text": "おはよう"},
        { "location": "343/TALK"    , "narrator": "ガブリエラ", "text": "あなたも起きてたのね？"},
        { "location": "345/SEL"     , "narrator": "", "text": "朝から元気だね"},
        { "location": "346/ACT"     , "narrator": "", "text": "朝から元気だね"},
        { "location": "348/TALK"    , "narrator": "ガブリエラ", "text": "まあね"},
        { "location": "349/TALK"    , "narrator": "ガブリエラ", "text": "肉体の鍛錬は精神の鍛練にもなるのよ"},
        { "location": "350/TALK"    , "narrator": "ガブリエラ", "text": "戦士としても"},
        { "location": "351/TALK"    , "narrator": "ガブリエラ", "text": "レディとしても"},
        { "location": "352/TALK"    , "narrator": "ガブリエラ", "text": "必要な訓練なのよ"},
        { "location": "353/TALK"    , "narrator": "ガブリエラ", "text": "それじゃ学校行く準備するから"},
        { "location": "354/TALK"    , "narrator": "ガブリエラ", "text": "また後でね"},
        { "location": "366/TALK"    , "narrator": "ガブリエラ", "text": "さてと…、\nまずはシャワーを\n浴びないとね…。"},
        { "location": "378/TALK"    , "narrator": "アーヤ", "text": "まだ八時か…。"},
        { "location": "379/TALK"    , "narrator": "アーヤ", "text": "今日は朝一の講義も\nないし――"},
        { "location": "380/TALK"    , "narrator": "アーヤ", "text": "モーニングでも\n食べに行こうかしら？"},
        { "location": "382/TALK"    , "narrator": "ガブリエラ", "text": "えぇぇぇぇーっ！？"},
        { "location": "384/TALK"    , "narrator": "アーヤ", "text": "な、なに！？\n何事！？"},
        { "location": "392/TALK"    , "narrator": "ガブリエラ", "text": "ヤバい！\nヤバいヤバいヤバい！"},
        { "location": "393/TALK"    , "narrator": "ガブリエラ", "text": "あたしのバカバカ！\nせっかく早起きした\nっていうのに――"},
        { "location": "394/TALK"    , "narrator": "ガブリエラ", "text": "二度寝しちゃったら\n意味ないじゃない！"},
        { "location": "395/TALK"    , "narrator": "アーヤ", "text": "…ギャヴィ？"},
        { "location": "397/TALK"    , "narrator": "ガブリエラ", "text": "あ、アーヤっ！？"},
        { "location": "399/TALK"    , "narrator": "アーヤ", "text": "えっ？　まだいたの？\nだってあなた…。"},
        { "location": "401/TALK"    , "narrator": "ガブリエラ", "text": "…最悪。"},
        { "location": "402/TALK"    , "narrator": "ガブリエラ", "text": "遅刻確定な上に、\nお説教とか――"},
        { "location": "403/TALK"    , "narrator": "ガブリエラ", "text": "学校ある日に\nジョギングなんか\nしなきゃよかった…。"},
        { "location": "404/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "406/TALK"    , "narrator": "アーヤ", "text": "…仕方ないわね。\n送ってあげるわ。"},
        { "location": "408/TALK"    , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "410/TALK"    , "narrator": "アーヤ", "text": "バイク出すから、\n玄関で待ってて。"},
        { "location": "413/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "414/TALK"    , "narrator": "ガブリエラ", "text": "あれ？"},
        { "location": "428/TALK"    , "narrator": "アーヤ", "text": "ふぅ…どうにか\n間に合ったわね。"},
        { "location": "430/TALK"    , "narrator": "アーヤ", "text": "ほら、ギャヴィ。\n降りて。"},
        { "location": "434/TALK"    , "narrator": "ガブリエラ", "text": "う、うぅ…。\n本当、運転荒いん\nだから…。"},
        { "location": "435/TALK"    , "narrator": "アーヤ", "text": "大袈裟ね。\n間に合ったんだから\nいいじゃない。"},
        { "location": "437/TALK"    , "narrator": "ガブリエラ", "text": "そ、それはそう\nだけど…。"},
        { "location": "438/TALK"    , "narrator": "アーヤ", "text": "ならいいじゃない。"},
        { "location": "440/TALK"    , "narrator": "アーヤ", "text": "さて、と…、\n私はどうしよう\nかしら？"},
        { "location": "442/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "454/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナ"},
        { "location": "456/TALK"    , "narrator": "ガブリエラ", "text": "今日のアーヤ変じゃない？"},
        { "location": "457/TALK"    , "narrator": "ガブリエラ", "text": "こういう時"},
        { "location": "458/TALK"    , "narrator": "ガブリエラ", "text": "いつもなら小言の一つはあるはずなのに"},
        { "location": "459/TALK"    , "narrator": "ガブリエラ", "text": "今日はそれがないんだもの"},
        { "location": "460/TALK"    , "narrator": "ガブリエラ", "text": "しかも"},
        { "location": "461/TALK"    , "narrator": "ガブリエラ", "text": "わざわざバイクで送ってまでくれるなんて"},
        { "location": "462/TALK"    , "narrator": "ガブリエラ", "text": "わけがわからないんだけど？"},
        { "location": "463/TALK"    , "narrator": "ガブリエラ", "text": "っていうか"},
        { "location": "464/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと怖いわ"},
        { "location": "466/SEL"     , "narrator": "", "text": "後で怒るつもりかも"},
        { "location": "467/SEL"     , "narrator": "", "text": "それより、お礼言わないと"},
        { "location": "468/ACT"     , "narrator": "", "text": "後で怒るつもりかも"},
        { "location": "469/TALK"    , "narrator": "ガブリエラ", "text": "ありえるわね"},
        { "location": "470/TALK"    , "narrator": "ガブリエラ", "text": "だからあんなにバイクを飛ばしたのかも"},
        { "location": "471/TALK"    , "narrator": "ガブリエラ", "text": "それなら納得だわ"},
        { "location": "472/TALK"    , "narrator": "ガブリエラ", "text": "早く逃げた方がいいわね"},
        { "location": "484/TALK"    , "narrator": "アーヤ", "text": "じゃあギャヴィ。\n私はこのまま――"},
        { "location": "485/TALK"    , "narrator": "ガブリエラ", "text": "ありがとアーヤ！\nそれじゃあたし、\n急ぐから！"},
        { "location": "492/TALK"    , "narrator": "アーヤ", "text": "あ、ちょっと！"},
        { "location": "494/TALK"    , "narrator": "アーヤ", "text": "…まったく。\nそんなに慌てなくても\n間に合うのに…。"},
        { "location": "495/ACT"     , "narrator": "", "text": "それより、お礼言わないと"},
        { "location": "497/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "498/TALK"    , "narrator": "ガブリエラ", "text": "何であれ"},
        { "location": "499/TALK"    , "narrator": "ガブリエラ", "text": "遅刻しなかったのはアーヤのおかげだし"},
        { "location": "500/TALK"    , "narrator": "ガブリエラ", "text": "お礼はちゃんとしないと"},
        { "location": "502/TALK"    , "narrator": "ガブリエラ", "text": "礼儀のなってないレディは"},
        { "location": "503/TALK"    , "narrator": "ガブリエラ", "text": "レディ失格よね"},
        { "location": "516/TALK"    , "narrator": "ガブリエラ", "text": "…あの、アーヤ。"},
        { "location": "517/TALK"    , "narrator": "ガブリエラ", "text": "本当、助かったわ。\n送ってくれて\nありがと。"},
        { "location": "520/TALK"    , "narrator": "アーヤ", "text": "どういたしまして。\nでも――"},
        { "location": "521/TALK"    , "narrator": "アーヤ", "text": "登校前のジョギングは\nこれからは控えた方が\nいいかもね。"},
        { "location": "523/TALK"    , "narrator": "ガブリエラ", "text": "えっ！\n知ってたの！？"},
        { "location": "524/TALK"    , "narrator": "アーヤ", "text": "ええ。私も起きてて、\n部屋でストレッチ\nやってたから。"},
        { "location": "525/TALK"    , "narrator": "ガブリエラ", "text": "そっか…。"},
        { "location": "527/TALK"    , "narrator": "ガブリエラ", "text": "なぁんだ…。\nだから怒らなかった\nのね…。"},
        { "location": "528/TALK"    , "narrator": "アーヤ", "text": "何よそれ？\nそんなしょっちゅう\n怒らないでしょ？"},
        { "location": "530/TALK"    , "narrator": "ガブリエラ", "text": "いや、怒るでしょ？"},
        { "location": "531/TALK"    , "narrator": "ガブリエラ", "text": "だから、ずっと不安\nだったんじゃない…。"},
        { "location": "532/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "534/TALK"    , "narrator": "アーヤ", "text": "そ、そう…私って、\n結構怒りやすい性格\nだったのね…。"},
        { "location": "535/TALK"    , "narrator": "ガブリエラ", "text": "…あ、あれ？\nもしかして、ショック\n受けちゃってる？"},
        { "location": "537/TALK"    , "narrator": "アーヤ", "text": "そりゃ、ちょっと\n注意くらいはすると\n思うけど――"},
        { "location": "538/TALK"    , "narrator": "アーヤ", "text": "そんな怒ってはいない\nつもりだったのに…。"},
        { "location": "539/TALK"    , "narrator": "ガブリエラ", "text": "え、えっと…。"},
        { "location": "540/TALK"    , "narrator": "アーヤ", "text": "もしかして、\n気付かない間に――"},
        { "location": "541/TALK"    , "narrator": "アーヤ", "text": "結構キツい性格に\nなっちゃってたの\nかしら？"},
        { "location": "542/TALK"    , "narrator": "ガブリエラ", "text": "だ、大丈夫よ！\nそこまでじゃない\nから、本当！"},
        { "location": "543/TALK"    , "narrator": "ガブリエラ", "text": "それにアーヤは、\n相手に非がある\n時に――"},
        { "location": "544/TALK"    , "narrator": "ガブリエラ", "text": "軽く注意するだけ、\nだし…。"},
        { "location": "545/TALK"    , "narrator": "ガブリエラ", "text": "…そうよ。\nアーヤは頭ごなしに\n怒ったりしないわ。"},
        { "location": "546/TALK"    , "narrator": "ガブリエラ", "text": "でも、どうしていつも\n言い争いみたいに――"},
        { "location": "547/TALK"    , "narrator": "ガブリエラ", "text": "…言い争い？"},
        { "location": "549/TALK"    , "narrator": "アーヤ", "text": "本当にそう？\nちょっと、本気で\n心配なんだけど…。"},
        { "location": "550/TALK"    , "narrator": "ガブリエラ", "text": "だ、大丈夫だから！\n本当、心配しなくて\nいいから…。"},
        { "location": "551/TALK"    , "narrator": "ガブリエラ", "text": "アーヤがいつも\n怒ってるように\n思えるのって――"},
        { "location": "553/TALK"    , "narrator": "ガブリエラ", "text": "毎回、あたしが\n言い返しちゃうのが\n原因だわ…。"},
        { "location": "554/TALK"    , "narrator": "ガブリエラ", "text": "本当、気にする必要\nないから。"},
        { "location": "555/TALK"    , "narrator": "ガブリエラ", "text": "あたしも、ちょっと\n大げさに言っちゃった\nだけだし…。"},
        { "location": "556/TALK"    , "narrator": "ガブリエラ", "text": "そうよ。\nアーヤは面倒見も\nいいし――"},
        { "location": "557/TALK"    , "narrator": "ガブリエラ", "text": "困ってる時には\n助けてくれる、\n頼りになる人よ。"},
        { "location": "558/TALK"    , "narrator": "ガブリエラ", "text": "今日もあたしのために\nバイクで送ってくれ\nたし…。"},
        { "location": "560/TALK"    , "narrator": "アーヤ", "text": "そ、そう…。\nちょっと安心したわ。"},
        { "location": "562/TALK"    , "narrator": "ガブリエラ", "text": "と、とにかく、\nそういうことだから！\n元気出しなさいよね。"},
        { "location": "563/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ、教室行くわ。\n本当ありがと。"},
        { "location": "565/TALK"    , "narrator": "アーヤ", "text": "うん。\nいってらっしゃい。"},
        { "location": "566/TALK"    , "narrator": "ガブリエラ", "text": "今度注意された時は、\n言い返さないように\nするからね…。"},
        { "location": "294/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月14日　6:34 AM</color>\nとある平日の朝、寮「とらいあんぐる」つばめの部屋前。"}
    ]
}
