    [
        { "location": "175/SCENARIO", "narrator": "", "text": "060_恋に恋して"},
        { "location": "201/TALK"    , "narrator": "ガブリエラ", "text": "きみは持っているのかね？"},
        { "location": "202/TALK"    , "narrator": "ガブリエラ", "text": "王様が私に聞きました。"},
        { "location": "203/TALK"    , "narrator": "ガブリエラ", "text": "私は笑顔で答えます。"},
        { "location": "204/TALK"    , "narrator": "ガブリエラ", "text": "もちろんでございます、当然でしょう、と。"},
        { "location": "205/TALK"    , "narrator": "ガブリエラ", "text": "王様は私に言います。"},
        { "location": "206/TALK"    , "narrator": "ガブリエラ", "text": "ならばそれを我に捧げよ、と。"},
        { "location": "207/TALK"    , "narrator": "ガブリエラ", "text": "私は笑顔で答えます。"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "それは無理でございます、当然でしょう、と。"},
        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "王様はさらにさらに私に言います。"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "それは何故じゃ？　褒美ははずむと言っておるではないか。"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "私は笑顔で答えます。"},
        { "location": "212/TALK"    , "narrator": "ガブリエラ", "text": "無理なものは無理でございます。なぜなら"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "私が恋をしているのは、あなたではないのですから。"},
        { "location": "216/SEL"     , "narrator": "", "text": "ガブリエラの話？"},
        { "location": "217/SEL"     , "narrator": "", "text": "恋する乙女の話だね"},
        { "location": "218/SEL"     , "narrator": "", "text": "なんだかよくわからない…"},
        { "location": "219/ACT"     , "narrator": "", "text": "ガブリエラの話？"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "違うわよ！"},
        { "location": "221/TALK"    , "narrator": "ガブリエラ", "text": "・・・"},
        { "location": "222/TALK"    , "narrator": "ガブリエラ", "text": "そうだけど・・・"},
        { "location": "225/ACT"     , "narrator": "", "text": "恋する乙女の話だね"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "さすがねマルザンナ♪"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "よくわかってるじゃない♪"},
        { "location": "238/TALK"    , "narrator": "ガブリエラ", "text": "その乙女って私なんだけどねvv"},
        { "location": "241/ACT"     , "narrator": "", "text": "なんだかよくわからない…"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "そう・・・"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "がっかりだわ・・・"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "でもこのお話、ちょっと直したいのよね"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "王様の話し相手をお姫様にしたいのよ"},
        { "location": "248/TALK"    , "narrator": "ガブリエラ", "text": "どうすればいいかしら・・・"},
        { "location": "250/SEL"     , "narrator": "", "text": "お姫様にすればいいだけじゃない？"},
        { "location": "251/ACT"     , "narrator": "", "text": "お姫様にすればいいだけじゃない？"},
        { "location": "253/TALK"    , "narrator": "ガブリエラ", "text": "わかってないのね！"},
        { "location": "254/SEL"     , "narrator": "", "text": "うん、わからない"},
        { "location": "255/SEL"     , "narrator": "", "text": "わかる気はするけど"},
        { "location": "256/TALK"    , "narrator": "ガブリエラ", "text": "このままだと王様とお姫様の会話に見えないでしょう？"},
        { "location": "257/TALK"    , "narrator": "ガブリエラ", "text": "なんていうか"},
        { "location": "258/TALK"    , "narrator": "ガブリエラ", "text": "王様と村娘って感じでしょう？"},
        { "location": "259/TALK"    , "narrator": "ガブリエラ", "text": "そうじゃなくて恋をしているお姫様にしたいの！"},
        { "location": "260/TALK"    , "narrator": "ガブリエラ", "text": "きっと相手は王子様よね？"},
        { "location": "261/TALK"    , "narrator": "ガブリエラ", "text": "でも村娘が王子様のことを好きなのはありかもしれないわ・・・"},
        { "location": "263/TALK"    , "narrator": "ガブリエラ", "text": "悲恋の乙女って感じで"},
        { "location": "265/ACT"     , "narrator": "", "text": "うん、わからない"},
        { "location": "266/TALK"    , "narrator": "ガブリエラ", "text": "でもでも、ハッピーエンドにしたいのよ"},
        { "location": "267/ACT"     , "narrator": "", "text": "わかる気はするけど"},
        { "location": "268/TALK"    , "narrator": "ガブリエラ", "text": "でもでも、ハッピーエンドにしたいのよ"},
        { "location": "270/TALK"    , "narrator": "ガブリエラ", "text": "うーん・・・"},
        { "location": "271/TALK"    , "narrator": "ガブリエラ", "text": "なんだか、現実に戻っちゃうわ"},
        { "location": "272/TALK"    , "narrator": "ガブリエラ", "text": "お姫様のままで王子様に愛されることなんてありえるのかしら？"},
        { "location": "274/SEL"     , "narrator": "", "text": "あったんでしょう？"},
        { "location": "275/SEL"     , "narrator": "", "text": "なかったの？"},
        { "location": "276/ACT"     , "narrator": "", "text": "あったんでしょう？"},
        { "location": "277/ACT"     , "narrator": "", "text": "なかったの？"},
        { "location": "279/TALK"    , "narrator": "ガブリエラ", "text": "好きだなって思う人はね？会ったことあるわよ"},
        { "location": "280/TALK"    , "narrator": "ガブリエラ", "text": "それなりにいたわよ"},
        { "location": "281/TALK"    , "narrator": "ガブリエラ", "text": "いたけど・・・・"},
        { "location": "282/TALK"    , "narrator": "ガブリエラ", "text": "お付き合いは・・・したことがないのよ・・・"},
        { "location": "285/SEL"     , "narrator": "", "text": "いつか運命の人にめぐりあうよ"},
        { "location": "286/SEL"     , "narrator": "", "text": "$handle$がいるよ"},
        { "location": "287/ACT"     , "narrator": "", "text": "いつか運命の人にめぐりあうよ"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "そうよねvvvvvv"},
        { "location": "301/ACT"     , "narrator": "", "text": "$handle$がいるよ"},
        { "location": "304/TALK"    , "narrator": "ガブリエラ", "text": "でも今回はね？"},
        { "location": "305/TALK"    , "narrator": "ガブリエラ", "text": "うまくいきそうな気がするのよ"},
        { "location": "306/TALK"    , "narrator": "ガブリエラ", "text": "共通するところもいろいろあるしね♪"},
        { "location": "307/TALK"    , "narrator": "ガブリエラ", "text": "応援してねvvv"},
        { "location": "231/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>400pt.</b></color></size>\nアップしました！"},
