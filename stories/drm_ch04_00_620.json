    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "人生の主役というやつ"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "改めて主張することでもないが"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "あえて主張しておこう"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "と"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "思うのだがどうか"},
        { "location": "37/SEL"    , "narrator": "", "text": "どうかと言われても"},
        { "location": "38/SEL"    , "narrator": "", "text": "どうぞ遠慮なく"},
        { "location": "39/SEL"    , "narrator": "", "text": "$me$でよければ聞くよ"},
        { "location": "40/ACT"    , "narrator": "", "text": "どうかと言われても"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "確かに"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "そうかもしれぬ"},
        { "location": "43/ACT"    , "narrator": "", "text": "どうぞ遠慮なく"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "そう言われると"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "気がそがれるの"},
        { "location": "48/ACT"    , "narrator": "", "text": "$me$でよければ聞くよ"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "ありがたい"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "さすが$handle$"},
        { "location": "62/SEL"    , "narrator": "", "text": "当然だよ"},
        { "location": "63/SEL"    , "narrator": "", "text": "みやびにだけだよ"},
        { "location": "64/ACT"    , "narrator": "", "text": "当然だよ"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "ほほう"},
        { "location": "66/ACT"    , "narrator": "", "text": "みやびにだけだよ"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "またまた"},
        { "location": "70/SEL"    , "narrator": "", "text": "本当だから"},
        { "location": "71/SEL"    , "narrator": "", "text": "$me$とみやびの間だからだよ"},
        { "location": "72/ACT"    , "narrator": "", "text": "本当だから"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "ふむ"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "信じてやろう"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "特別に"},
        { "location": "77/ACT"    , "narrator": "", "text": "$me$とみやびの間だからだよ"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "大きく出たの"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "許可してやろう"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "特別に"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "本当に大したことではなく"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "うちの人生の主役はうちだという"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "事実確認？"},
        { "location": "89/SEL"    , "narrator": "", "text": "悩みがあるの？"},
        { "location": "90/SEL"    , "narrator": "", "text": "疲れてるんだね"},
        { "location": "91/SEL"    , "narrator": "", "text": "サブキャラクターは$me$"},
        { "location": "92/ACT"    , "narrator": "", "text": "悩みがあるの？"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "そういうことに"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "なるのか？"},
        { "location": "95/ACT"    , "narrator": "", "text": "疲れてるんだね"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "そうかもしれぬ"},
        { "location": "97/ACT"    , "narrator": "", "text": "サブキャラクターは$me$"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "そういう話ではない"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "悪くはないが"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "なんというか"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "改めて確認しておかねば"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "いろいろなものに振り回されてしまう"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "そんな心境なのだ"},
        { "location": "107/SEL"   , "narrator": "", "text": "よしよし"},
        { "location": "108/ACT"   , "narrator": "", "text": "よしよし"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "$handle$のくせに"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "うちを子供扱いするとは"},
        { "location": "113/SEL"   , "narrator": "", "text": "だって子供でしょ"},
        { "location": "114/SEL"   , "narrator": "", "text": "そういうわけじゃないんだけど"},
        { "location": "115/SEL"   , "narrator": "", "text": "彼女扱いだよ"},
        { "location": "116/ACT"   , "narrator": "", "text": "だって子供でしょ"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "未成年ではあるが"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "子供という年でもない"},
        { "location": "119/ACT"   , "narrator": "", "text": "そういうわけじゃないんだけど"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "どういうわけだ"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "どういう"},
        { "location": "123/ACT"   , "narrator": "", "text": "彼女扱いだよ"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "なんと"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "そういうことであったか"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "しかしなんだ"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "子供扱いされるのが"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "心地よい"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "そんなことも"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "あるのだなという"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "新たな発見"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "$handle$め"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "以外と侮れん"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "そういうことで"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "さらばだ"},
        { "location": "144/TALK"  , "narrator": "ボイスメール", "text": "この世界にただ一人"},
        { "location": "54/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "156/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【この世界にただ一人】</color>\nをゲットしました！"}
