{
    "dir": "chap34/daydra/dd_ch01_34_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "34105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "ウタノチカラ＜後編＞"
    },
    "entry":
    [
        { "location": "637/TALK"  , "narrator": "つばめ", "text": "……あれ…？\nわたし……"},
        { "location": "638/SEL"   , "narrator": "", "text": "つばめ、大丈夫だった？"},
        { "location": "639/ACT"   , "narrator": "", "text": "つばめ、大丈夫だった？"},
        { "location": "642/TALK"  , "narrator": "つばめ", "text": "うん。"},
        { "location": "643/TALK"  , "narrator": "音羽", "text": "ありがとう、\n$handle$。"},
        { "location": "644/TALK"  , "narrator": "音羽", "text": "お陰で逢瀬さんと\n神楽を助ける事ができる。"},
        { "location": "645/SEL"   , "narrator": "", "text": "頑張ってくれ、ほんとに……"},
        { "location": "646/ACT"   , "narrator": "", "text": "頑張ってくれ、ほんとに……"},
        { "location": "648/TALK"  , "narrator": "音羽", "text": "ええ。\nもちろんよ。"},
        { "location": "649/TALK"  , "narrator": "音羽", "text": "ふたりとも\n大切な友だちだもの。"},
        { "location": "650/TALK"  , "narrator": "音羽", "text": "逢瀬さん……\nいえ、これからは\nつばめちゃんって呼ぶ。"},
        { "location": "652/TALK"  , "narrator": "つばめ", "text": "は、はい！"},
        { "location": "653/TALK"  , "narrator": "音羽", "text": "つばめちゃん。\n歌って。"},
        { "location": "654/TALK"  , "narrator": "つばめ", "text": "わたしが？"},
        { "location": "655/TALK"  , "narrator": "音羽", "text": "そう。\n神楽の歌は\nイシュリールを否定する。"},
        { "location": "656/TALK"  , "narrator": "音羽", "text": "それに対抗できるのは\nつばめちゃんの\n歌しかない。"},
        { "location": "657/SEL"   , "narrator": "", "text": "そうだよ！"},
        { "location": "658/SEL"   , "narrator": "", "text": "そうなんだ…"},
        { "location": "659/SEL"   , "narrator": "", "text": "そういうことか"},
        { "location": "660/ACT"   , "narrator": "", "text": "そうだよ！"},
        { "location": "662/TALK"  , "narrator": "つばめ", "text": "そうなの！？"},
        { "location": "663/ACT"   , "narrator": "", "text": "そうなんだ…"},
        { "location": "664/TALK"  , "narrator": "つばめ", "text": "え……。"},
        { "location": "665/ACT"   , "narrator": "", "text": "そういうことか"},
        { "location": "667/TALK"  , "narrator": "つばめ", "text": "どういうことなの？"},
        { "location": "670/TALK"  , "narrator": "つばめ", "text": "わたしが神楽ちゃんに\n対抗する歌を歌う？"},
        { "location": "671/TALK"  , "narrator": "音羽", "text": "そう。つばめちゃんの\n気持ちを歌詞に乗せた\n旋律で。"},
        { "location": "674/TALK"  , "narrator": "つばめ", "text": "え、と？"},
        { "location": "675/TALK"  , "narrator": "音羽", "text": "つばめちゃんが作った\nイシュリールを、そして\n神楽を護る歌を歌うの。"},
        { "location": "676/TALK"  , "narrator": "音羽", "text": "イシュリールを\n否定する歌を\n打ち消すために。"},
        { "location": "677/TALK"  , "narrator": "つばめ", "text": "！！！！"},
        { "location": "680/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "682/TALK"  , "narrator": "つばめ", "text": "……そんなの……\n……無理だよ……。"},
        { "location": "683/TALK"  , "narrator": "音羽", "text": "できる。\n絶対にできる。\nつばめちゃんなら。"},
        { "location": "684/TALK"  , "narrator": "音羽", "text": "だってつばめちゃんは\nイシュリールのことを\n愛しているから。"},
        { "location": "685/TALK"  , "narrator": "音羽", "text": "そして神楽のことも。"},
        { "location": "687/TALK"  , "narrator": "つばめ", "text": "…でも…。"},
        { "location": "688/TALK"  , "narrator": "音羽", "text": "カレンはお母さんの\n病気を治すために\nどうしたっけ？"},
        { "location": "690/TALK"  , "narrator": "つばめ", "text": "………歌った。"},
        { "location": "691/TALK"  , "narrator": "音羽", "text": "でしょ？"},
        { "location": "692/TALK"  , "narrator": "つばめ", "text": "でもあれは、\nお話だから…。"},
        { "location": "693/TALK"  , "narrator": "音羽", "text": "お話だから？"},
        { "location": "695/TALK"  , "narrator": "つばめ", "text": "わたしはカレンちゃん\nみたいには……。"},
        { "location": "696/TALK"  , "narrator": "音羽", "text": "そうだね。\nつばめちゃんは\nカレンじゃない。"},
        { "location": "697/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "698/TALK"  , "narrator": "音羽", "text": "つばめちゃんは\nカレンよりずっとすごい\nことができる。"},
        { "location": "701/TALK"  , "narrator": "つばめ", "text": "！？"},
        { "location": "702/TALK"  , "narrator": "音羽", "text": "つばめちゃんは\nとても強くて純粋で\n優しいから。"},
        { "location": "703/TALK"  , "narrator": "音羽", "text": "つばめちゃんに\n足りてないのは\n自分を信じる心だけ。"},
        { "location": "704/TALK"  , "narrator": "音羽", "text": "そうでしょ？\n$handle$。"},
        { "location": "705/SEL"   , "narrator": "", "text": "$me$もそう思う"},
        { "location": "706/SEL"   , "narrator": "", "text": "自分を信じて、つばめ！"},
        { "location": "707/SEL"   , "narrator": "", "text": "そこもかわいいんだけどね"},
        { "location": "708/ACT"   , "narrator": "", "text": "$me$もそう思う"},
        { "location": "712/TALK"  , "narrator": "つばめ", "text": "本当に？"},
        { "location": "713/ACT"   , "narrator": "", "text": "自分を信じて、つばめ！"},
        { "location": "717/TALK"  , "narrator": "つばめ", "text": "わたし自身を？"},
        { "location": "718/ACT"   , "narrator": "", "text": "そこもかわいいんだけどね"},
        { "location": "722/TALK"  , "narrator": "つばめ", "text": "もう！\nこんな時に！"},
        { "location": "724/TALK"  , "narrator": "音羽", "text": "ここにはつばめちゃんを\n信じてる人が\n二人もいる。"},
        { "location": "725/TALK"  , "narrator": "音羽", "text": "当の本人が自分を\n信じられないなんて\nおかしくない？"},
        { "location": "726/SEL"   , "narrator": "", "text": "そうだそうだ"},
        { "location": "727/SEL"   , "narrator": "", "text": "$me$を信用して"},
        { "location": "728/SEL"   , "narrator": "", "text": "つばめならできるよ"},
        { "location": "729/ACT"   , "narrator": "", "text": "そうだそうだ"},
        { "location": "730/TALK"  , "narrator": "つばめ", "text": "そ、そうかな…。"},
        { "location": "731/ACT"   , "narrator": "", "text": "$me$を信用して"},
        { "location": "733/TALK"  , "narrator": "つばめ", "text": "$handle$さんの\n言うことなら\n信じられる気がする。"},
        { "location": "734/ACT"   , "narrator": "", "text": "つばめならできるよ"},
        { "location": "735/TALK"  , "narrator": "つばめ", "text": "……うん。\nがんばる。"},
        { "location": "739/TALK"  , "narrator": "つばめ", "text": "でもわたし、\n死んでる、よね…？"},
        { "location": "740/TALK"  , "narrator": "音羽", "text": "死んでなんかないから。"},
        { "location": "741/TALK"  , "narrator": "音羽", "text": "ここはつばめちゃんの\nフェノメノンの中でしょ。"},
        { "location": "742/TALK"  , "narrator": "音羽", "text": "本人が死んでないと\n思ったら死んでない。"},
        { "location": "744/TALK"  , "narrator": "つばめ", "text": "あ、あれ？"},
        { "location": "745/TALK"  , "narrator": "音羽", "text": "今つばめちゃんが\n考えなきゃいけないことは\nひとつだけ。"},
        { "location": "746/TALK"  , "narrator": "音羽", "text": "神楽を助ける。\nそのために歌う。\nただそれだけ。"},
        { "location": "747/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんを、\n助ける……。"},
        { "location": "748/SEL"   , "narrator": "", "text": "助けよう！"},
        { "location": "749/SEL"   , "narrator": "", "text": "つばめにしかできないことだよ"},
        { "location": "750/SEL"   , "narrator": "", "text": "$me$も応援するから"},
        { "location": "751/ACT"   , "narrator": "", "text": "助けよう！"},
        { "location": "756/TALK"  , "narrator": "つばめ", "text": "…うん。"},
        { "location": "757/ACT"   , "narrator": "", "text": "つばめにしかできないことだよ"},
        { "location": "762/TALK"  , "narrator": "つばめ", "text": "わたしにしか\nできないこと…。"},
        { "location": "763/ACT"   , "narrator": "", "text": "$me$も応援するから"},
        { "location": "769/TALK"  , "narrator": "つばめ", "text": "…ありがとう。"},
        { "location": "771/TALK"  , "narrator": "音羽", "text": "私は、千羽鶴が\n私や神楽にしたことを\n本気で怒ってる。"},
        { "location": "772/TALK"  , "narrator": "音羽", "text": "だから借りは全部返す。"},
        { "location": "774/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "775/TALK"  , "narrator": "音羽", "text": "因果応報。"},
        { "location": "776/TALK"  , "narrator": "音羽", "text": "今の状態は神の采配って\nものだと思うの。\nこの世に神がいるのなら。"},
        { "location": "778/TALK"  , "narrator": "つばめ", "text": "…わたし…。"},
        { "location": "779/SEL"   , "narrator": "", "text": "そろそろ急いで！"},
        { "location": "780/SEL"   , "narrator": "", "text": "歌の準備を始めないと"},
        { "location": "781/SEL"   , "narrator": "", "text": "このままだとタイムリミットになるよ"},
        { "location": "782/ACT"   , "narrator": "", "text": "そろそろ急いで！"},
        { "location": "784/TALK"  , "narrator": "つばめ", "text": "あ、うん！"},
        { "location": "785/ACT"   , "narrator": "", "text": "歌の準備を始めないと"},
        { "location": "787/TALK"  , "narrator": "つばめ", "text": "そ、そうだね。"},
        { "location": "788/ACT"   , "narrator": "", "text": "このままだとタイムリミットになるよ"},
        { "location": "790/TALK"  , "narrator": "つばめ", "text": "え、急がないと！"},
        { "location": "792/TALK"  , "narrator": "音羽", "text": "ごめんね。\n自分の話をしすぎた\nみたい。"},
        { "location": "793/TALK"  , "narrator": "音羽", "text": "神楽が歌い終わる前に\nつばめちゃんは\n歌わなきゃいけないのに。"},
        { "location": "795/TALK"  , "narrator": "つばめ", "text": "もしわたしが\n歌えなかったら…？"},
        { "location": "796/TALK"  , "narrator": "音羽", "text": "…言っていい？"},
        { "location": "797/TALK"  , "narrator": "音羽", "text": "そうなったら本当に\nつばめちゃんは死ぬの。"},
        { "location": "798/TALK"  , "narrator": "つばめ", "text": "！！！！"},
        { "location": "799/TALK"  , "narrator": "音羽", "text": "でもそんなことには\nならないって信じてる。"},
        { "location": "801/TALK"  , "narrator": "つばめ", "text": "…ありがとう。"},
        { "location": "802/TALK"  , "narrator": "つばめ", "text": "神楽ちゃん…！\nわたしの歌を聞いて…！"},
        { "location": "813/DIALOG", "narrator": "Dialog_chapter_ch01", "text": "【28 時計じかけのイチゴ】"}
    ]
}
