{
    "dir": "chap05/daydra/dd_ch03_05_030.js",
    "type": "MainStory",
    "info": {
        "story_id": "5357",
        "cid": "gabriella",
        "title": "Extra007 プレミアムストーリー",
        "sub_title": "新しい服"
    },
    "entry":
    [
        { "location": "494/SCENARIO", "narrator": "", "text": "新しい服"},
        { "location": "507/TALK"    , "narrator": "ガブリエラ", "text": "アーヤ、\n聞きたいことが\nあるんだけど――"},
        { "location": "508/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと前に、\n新しいジャケット、\n着てたでしょ？"},
        { "location": "510/TALK"    , "narrator": "アーヤ", "text": "ああ、\nあのベージュの？"},
        { "location": "511/TALK"    , "narrator": "ガブリエラ", "text": "そう、それよ。"},
        { "location": "512/TALK"    , "narrator": "ガブリエラ", "text": "あのジャケット、\nどこの店で買ったか\n教えてもらえる？"},
        { "location": "513/TALK"    , "narrator": "ガブリエラ", "text": "素敵なデザインだった\nから、他にどんな服が\nあるのか見てみたいの。"},
        { "location": "514/TALK"    , "narrator": "アーヤ", "text": "教えるのは\n構わないけど、\n大丈夫かしら？"},
        { "location": "515/TALK"    , "narrator": "アーヤ", "text": "あのお店、\n少し入り組んだ\nところにあるから…。"},
        { "location": "517/TALK"    , "narrator": "ガブリエラ", "text": "そんなに\nわかり難いの？"},
        { "location": "518/TALK"    , "narrator": "アーヤ", "text": "初めて行ったときは、\nなかなか見つから\nなくて――"},
        { "location": "520/TALK"    , "narrator": "アーヤ", "text": "店の前を三回も\n通り過ぎたくらいよ。"},
        { "location": "521/TALK"    , "narrator": "ガブリエラ", "text": "相当わかり難い場所に\nあるようね…。\n少し不安かも。"},
        { "location": "522/TALK"    , "narrator": "アーヤ", "text": "う～ん…よかったら、\n私が案内しましょうか？"},
        { "location": "523/SEL"     , "narrator": "", "text": "二人で行くの楽しそう"},
        { "location": "524/SEL"     , "narrator": "", "text": "一人で行こう"},
        { "location": "527/TALK"    , "narrator": "ガブリエラ", "text": "い、いいわよ。\nアーヤだって最近行った\nばかりなんでしょ？"},
        { "location": "530/TALK"    , "narrator": "アーヤ", "text": "先週にね。\nでも、服を見るのも\n趣味みたいなものだし。"},
        { "location": "531/TALK"    , "narrator": "アーヤ", "text": "ギャヴィがよければ、\n一緒にどう？"},
        { "location": "534/TALK"    , "narrator": "ガブリエラ", "text": "…そ、そうねぇ。"},
        { "location": "539/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、いいわ。"},
        { "location": "540/TALK"    , "narrator": "ガブリエラ", "text": "服以外にも\nちょっと見たいものも\nあるし――"},
        { "location": "541/TALK"    , "narrator": "ガブリエラ", "text": "のんびり行ってくるわ。"},
        { "location": "543/TALK"    , "narrator": "アーヤ", "text": "そっか。"},
        { "location": "544/TALK"    , "narrator": "アーヤ", "text": "じゃあ、ＷＡＶＥで\n地図を送っておくわ。"},
        { "location": "545/TALK"    , "narrator": "ガブリエラ", "text": "助かるわ。"},
        { "location": "547/TALK"    , "narrator": "アーヤ", "text": "いい服が見つかると\nいいわね。"},
        { "location": "549/ACT"     , "narrator": "", "text": "二人で行くの楽しそう"},
        { "location": "578/TALK"    , "narrator": "ガブリエラ", "text": "…そうかも"},
        { "location": "579/TALK"    , "narrator": "ガブリエラ", "text": "それじゃあ、思い切ってお願いしてみるわ"},
        { "location": "592/TALK"    , "narrator": "ガブリエラ", "text": "じゃ、じゃあ…\nお願いしようかしら。"},
        { "location": "593/TALK"    , "narrator": "アーヤ", "text": "うん、任せて。\n多分もう迷ったりは\nしないはずだから。"},
        { "location": "594/TALK"    , "narrator": "ガブリエラ", "text": "多分？"},
        { "location": "596/TALK"    , "narrator": "アーヤ", "text": "もう、本気にしないでよ。\n冗談だってば。"},
        { "location": "599/TALK"    , "narrator": "ガブリエラ", "text": "…冗談、ね。\nもしかして凄くご機嫌\nだったりしない？"},
        { "location": "602/TALK"    , "narrator": "アーヤ", "text": "ふふっ…ちょっとね。"},
        { "location": "603/TALK"    , "narrator": "アーヤ", "text": "ギャヴィと服を\n見に行くのって、\n初めてでしょ？"},
        { "location": "604/TALK"    , "narrator": "アーヤ", "text": "だから、\nちょっと楽しみなのよ。"},
        { "location": "607/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "608/TALK"    , "narrator": "アーヤ", "text": "行く日が決まったら\nまた声かけてね。"},
        { "location": "611/TALK"    , "narrator": "ガブリエラ", "text": "…アーヤも、\n楽しみにして\nくれてるんだ。"},
        { "location": "612/TALK"    , "narrator": "ガブリエラ", "text": "なんだか嬉しいな。\nマルザンナのとおり、\nお願いしてよかった。"},
        { "location": "613/ACT"     , "narrator": "", "text": "一人で行こう"},
        { "location": "633/TALK"    , "narrator": "ガブリエラ", "text": "初めて行くお店なんだし"},
        { "location": "634/TALK"    , "narrator": "ガブリエラ", "text": "一人でじっくり見た方が集中できるかしら？"},
        { "location": "647/TALK"    , "narrator": "ガブリエラ", "text": "…今回は一人で行くわ。\n時間掛けてゆっくり\n見たいし。"},
        { "location": "648/TALK"    , "narrator": "アーヤ", "text": "そっか…まあ、\nあの辺は面白い\nお店も沢山あるから――"},
        { "location": "649/TALK"    , "narrator": "アーヤ", "text": "探検気分で行くのも、\n悪くないと思うわ。"},
        { "location": "650/TALK"    , "narrator": "ガブリエラ", "text": "それ良いわね。\n探検気分の買い物って、\n結構好きかも。"},
        { "location": "652/TALK"    , "narrator": "アーヤ", "text": "後でお店の住所と地図を\n渡すから――"},
        { "location": "654/TALK"    , "narrator": "アーヤ", "text": "休みの日にでもゆっくり\n行ってらっしゃい。"},
        { "location": "655/TALK"    , "narrator": "ガブリエラ", "text": "ええ、そうするわ。"},
        { "location": "656/TALK"    , "narrator": "ガブリエラ", "text": "どんなお店があるのか\n今から楽しみだわ。"},
        { "location": "658/TALK"    , "narrator": "アーヤ", "text": "楽しみすぎて、\n服を買うのを忘れない\nようにね。"},
        { "location": "505/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月12日　5:18 PM</color>\nＧＷ後、神楽坂通りにて。"},
        { "location": "555/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
