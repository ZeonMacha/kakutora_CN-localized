{
    "dir": "chap10/daydra/dd_ch01_10_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "10152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "つばめに質問"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "つばめに質問"},
        { "location": "23/TALK"   , "narrator": "つばめ", "text": "そっかぁ…\nみんなも一人暮らしの\n計画を立ててるんだ？"},
        { "location": "25/TALK"   , "narrator": "雛", "text": "まあねー。\nやっぱり、大学に入ったら\n一人で生活してみたいし。"},
        { "location": "26/TALK"   , "narrator": "キリト", "text": "家族に干渉されない、\n自由な生活が手に入るん\nだぜ？"},
        { "location": "27/TALK"   , "narrator": "キリト", "text": "憧れて当然だろ。"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "そうかなぁ？"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "わたしは、今でも\n寂しくなる時があるよ。"},
        { "location": "33/TALK"   , "narrator": "繭", "text": "そういえば、逢瀬さんは\n一人暮らしよね。"},
        { "location": "35/TALK"   , "narrator": "キリト", "text": "けど、寮生活だから\n一人暮らしって感じは\nしねぇだろ？"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "そんなことないよ。\n生活空間はみんな\n別だし――。"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "誰かの部屋に遊びに行く、\nなんて滅多にないの。"},
        { "location": "39/TALK"   , "narrator": "キリト", "text": "へぇー…毎日女子会とか\nやってるわけじゃねぇん\nだな。"},
        { "location": "41/TALK"   , "narrator": "繭", "text": "女子が女子会好きと\n決めつけるのは浅はか\n過ぎるから。"},
        { "location": "45/TALK"   , "narrator": "雛", "text": "じゃあさ、一人暮らしの\nプロフェッショナルの\nつばめちゃんに質問！"},
        { "location": "46/TALK"   , "narrator": "雛", "text": "一人暮らしをする時に、\nこれは必要かも、って\n思うものってある？"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "べ、別にプロって\n言われるほど長くは\nないんだけど…。"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "でも、そうだなぁ…。\nやっぱり自炊能力だと\n思うけど――"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "他に何かあったかなぁ？"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "…ちょっと待ってて。\n他に何かあったか\n確認してみるから。"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "確認したいことがあるの"},
        { "location": "70/SEL"    , "narrator": "", "text": "自炊能力のこと？"},
        { "location": "71/ACT"    , "narrator": "", "text": "自炊能力のこと？"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "聞いててくれてたんだ？"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "わたしは、一人暮らしに大切なのはそれだと思うんだけど"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "他にどんなのがあるかな？"},
        { "location": "77/SEL"    , "narrator": "", "text": "とりあえずはそれでいい"},
        { "location": "78/SEL"    , "narrator": "", "text": "適度な掃除とか？"},
        { "location": "79/SEL"    , "narrator": "", "text": "孤独死の注意"},
        { "location": "80/ACT"    , "narrator": "", "text": "とりあえずはそれでいい"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "やっぱり、最初はそれだよね"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "簡単そうに思えるけど、結構大変だし"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "お待たせ。\nやっぱり自炊が一番\n大切だと思うよ？"},
        { "location": "96/TALK"   , "narrator": "キリト", "text": "それってよく聞くけど、\nそんなに大切か？"},
        { "location": "97/TALK"   , "narrator": "繭", "text": "毎食外食は、経済的に\n辛いと思う。"},
        { "location": "99/TALK"   , "narrator": "キリト", "text": "そうじゃなくて、\n普通に生活してりゃ\n当たり前にすることだろ？"},
        { "location": "100/TALK"  , "narrator": "キリト", "text": "実家にいる今だって、\n腹が減った時は自分で\n作ったりするしさ。"},
        { "location": "101/TALK"  , "narrator": "キリト", "text": "改めて大切だなんて、\n言われるほどのものじゃ\nねぇ気がするんだよ。"},
        { "location": "103/TALK"  , "narrator": "雛", "text": "う～ん…言われてみれば\nそんな気がするかも。"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "…そうだよね。\nわたしも、最初は\nそんな風に思ってた。"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "けど、学校とバイトが\n終わってから部屋に\n帰って――"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "それからお夕飯作るの\nって、結構大変だよ？"},
        { "location": "107/TALK"  , "narrator": "キリト", "text": "あ～…言われてみりゃ、\n確かに面倒くさそうだ。"},
        { "location": "108/TALK"  , "narrator": "キリト", "text": "ってか、俺だったら\nぜってぇカップ麺食って\n終わらせそうだわ。"},
        { "location": "111/TALK"  , "narrator": "雛", "text": "う、う～ん…\nあたしも、毎日ちゃんと\n料理する自信ないかも…。"},
        { "location": "113/TALK"  , "narrator": "雛", "text": "まゆちんはどう？"},
        { "location": "114/TALK"  , "narrator": "繭", "text": "バイトの無い日はする。\nある日は潔く諦める。"},
        { "location": "115/TALK"  , "narrator": "キリト", "text": "逢瀬はちゃんと\nできてるのか？"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "うーん…レパートリーは\nあまり無いけど、\n頑張ってはいるよ。"},
        { "location": "121/TALK"  , "narrator": "繭", "text": "…料理をするってことは、\n自分で何を作るのかも\n考えないといけない。"},
        { "location": "123/TALK"  , "narrator": "キリト", "text": "…逢瀬、\nおまえ頑張ってるんだな。"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "ありがと…。\nでも、慣れればどうにか\nなるよ。"},
        { "location": "127/TALK"  , "narrator": "キリト", "text": "いや、俺は多分無理だわ。"},
        { "location": "129/TALK"  , "narrator": "キリト", "text": "俺は一人暮らしするより、\n料理上手な嫁さん\nもらった方が良さそうだ。"},
        { "location": "132/TALK"  , "narrator": "雛", "text": "料理が嫌だからって\n結婚に逃げるなー！"},
        { "location": "134/TALK"  , "narrator": "繭", "text": "っていうか、今の時点で\n相手がいないんだから――"},
        { "location": "135/TALK"  , "narrator": "繭", "text": "高校卒業後に即結婚とか、\nまず無理だと思う。"},
        { "location": "138/TALK"  , "narrator": "キリト", "text": "夢くらい見たって\nいいじゃねぇか。"},
        { "location": "142/TALK"  , "narrator": "つばめ", "text": "わたしの一人暮らしは\n急に決まったから、\n夢も見れなかったよぉ…。"},
        { "location": "143/ACT"   , "narrator": "", "text": "適度な掃除とか？"},
        { "location": "144/TALK"  , "narrator": "つばめ", "text": "それも重要かも"},
        { "location": "145/TALK"  , "narrator": "つばめ", "text": "もしかしたら、自炊よりもそっちの方が大切かも"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "お待たせー。\nもう一つ大切なことが\nあったよ。"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "適度に部屋を掃除する\nことだよ。"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "自分だけだと、\nついサボりがちに\nなっちゃうの。"},
        { "location": "161/TALK"  , "narrator": "キリト", "text": "ふ～ん…なんか、そんなに\n大変そうでもねぇけどな。"},
        { "location": "162/TALK"  , "narrator": "キリト", "text": "俺、今でも週に一度は\n掃除機くらいかけるように\nしてるし。"},
        { "location": "163/TALK"  , "narrator": "雛", "text": "週一は少なくない？\nあたしは三日に一度は\nかけてるよー。"},
        { "location": "164/TALK"  , "narrator": "繭", "text": "掃除嫌いな人じゃない\nなら、心配する必要は\nなさそう。"},
        { "location": "166/TALK"  , "narrator": "つばめ", "text": "でも、一人だと家中の\n掃除を一人でやるんだよ？"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "部屋以外にも、廊下や\nお風呂、トイレとかの\n掃除もあるし――"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "食事をすれば洗い物、\n洗濯をすれば洗濯物の\n山ができるし――"},
        { "location": "170/TALK"  , "narrator": "つばめ", "text": "それを全部一人でやる\nから、やっぱり大変だよ。"},
        { "location": "172/TALK"  , "narrator": "キリト", "text": "…考え甘かったわ。"},
        { "location": "173/TALK"  , "narrator": "雛", "text": "だね…それを一人で\nやるのは、かなりキツい\nかも…。"},
        { "location": "175/TALK"  , "narrator": "つばめ", "text": "毎日全部やるわけじゃ\nないけどね。"},
        { "location": "178/TALK"  , "narrator": "キリト", "text": "…けどさ、それを逢瀬や、\nまだ中学生のガブリエラは\nやれてるんだろ？"},
        { "location": "180/TALK"  , "narrator": "キリト", "text": "そう考えると、\nちょっと尊敬するわ。"},
        { "location": "181/TALK"  , "narrator": "雛", "text": "だねー。\n女子力も高そうだし。"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "そ、そうかな？"},
        { "location": "185/TALK"  , "narrator": "雛", "text": "そうだよ。つばめちゃん、\n良いお嫁さんになれるよ！"},
        { "location": "186/ACT"   , "narrator": "", "text": "孤独死の注意"},
        { "location": "188/TALK"  , "narrator": "つばめ", "text": "いくらなんでも極端過ぎるよ！"},
        { "location": "189/TALK"  , "narrator": "つばめ", "text": "わたし、そんなこと一度も考えたことないし"},
        { "location": "190/TALK"  , "narrator": "つばめ", "text": "…でも、言われて考えてみると"},
        { "location": "191/TALK"  , "narrator": "つばめ", "text": "思い当たる節が、ないこともないけど…。"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "…ちょっと極端だけど、\n凄く重要なことがあるよ。"},
        { "location": "205/TALK"  , "narrator": "つばめ", "text": "孤独死しないこと、かな。"},
        { "location": "206/TALK"  , "narrator": "キリト", "text": "そりゃ確かに重要だ。"},
        { "location": "207/TALK"  , "narrator": "雛", "text": "だねー。\nさすがにそんな死に方は\nまだしたくないし――"},
        { "location": "208/TALK"  , "narrator": "雛", "text": "って、つばめちゃんが\n冗談言うなんてレアじゃ\nない！？"},
        { "location": "210/TALK"  , "narrator": "繭", "text": "初めて聞いたかも…。\nしかも、少しブラック\nだった。"},
        { "location": "212/TALK"  , "narrator": "つばめ", "text": "えっと…極端だけど、\n冗談じゃないよ？"},
        { "location": "213/TALK"  , "narrator": "つばめ", "text": "わたしね、お父さんから\n毎日メールがくるん\nだけど――"},
        { "location": "214/TALK"  , "narrator": "つばめ", "text": "わたしの方からは、\nほとんどお父さんに\nメールしないの。"},
        { "location": "216/TALK"  , "narrator": "雛", "text": "どうして？"},
        { "location": "217/TALK"  , "narrator": "つばめ", "text": "え、えっと…\nちょっと、面倒くさくて\nサボッちゃって…。"},
        { "location": "218/TALK"  , "narrator": "キリト", "text": "たかがメールだろ？\n面倒くさがるなよ。"},
        { "location": "221/TALK"  , "narrator": "つばめ", "text": "でも、毎日毎日報告する\nことなんてないんだもん。"},
        { "location": "222/TALK"  , "narrator": "つばめ", "text": "だから、今はそれなりに\n返信するようにはしてる\nけど――"},
        { "location": "223/TALK"  , "narrator": "つばめ", "text": "そのうち、本当に返信を\nしなくなるようなことに\nなったとしたら――"},
        { "location": "226/TALK"  , "narrator": "つばめ", "text": "その可能性も、無くは\nないんじゃないかな、\nって…。"},
        { "location": "228/TALK"  , "narrator": "繭", "text": "…凄い極論ではあるけど、\n無くはない話ね。"},
        { "location": "229/TALK"  , "narrator": "繭", "text": "若者の孤独死も、ちょっと\n話題になってるし。"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "わたし、寮暮らしで\n助かったよ…。"},
        { "location": "234/TALK"  , "narrator": "キリト", "text": "なるほどなぁ…\nまあ、９割方ねぇとは\n思うけど――"},
        { "location": "235/TALK"  , "narrator": "キリト", "text": "家族や友達とは\n頻繁に連絡取り合え、\nってことだな。"},
        { "location": "239/TALK"  , "narrator": "つばめ", "text": "うん…ごめんね、\nあんまり参考になること\n言えなくて。"},
        { "location": "240/TALK"  , "narrator": "雛", "text": "ううん、そんなこと\nないよー。"},
        { "location": "241/TALK"  , "narrator": "雛", "text": "あたしも、家族との\n連絡とか面倒くさくて\nサボッちゃいそうだし…。"},
        { "location": "242/TALK"  , "narrator": "雛", "text": "せめて、みんなとは\n毎日連絡取るように\nしたいね。"},
        { "location": "244/TALK"  , "narrator": "つばめ", "text": "そうだね。\nわたしも、それなら\n毎日できそうだよ。"},
        { "location": "246/TALK"  , "narrator": "繭", "text": "逢瀬さんは、とりあえず\nお父さんにメールした方が\nいいと思う。"},
        { "location": "247/TALK"  , "narrator": "つばめ", "text": "そ、そうだね。\n今のうちに書いて\n送っちゃうよ。"},
        { "location": "20/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月7日　13:08 PM</color>\n平日午後の休み時間、教室にて。"}
    ]
}
