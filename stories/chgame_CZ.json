    "entry":
    [
        { "location": "1027/SCENARIO", "narrator": "", "text": "CZジャンプ台（みやび）"},
        { "location": "1031/SEL"     , "narrator": "", "text": "入る"},
        { "location": "1032/SEL"     , "narrator": "", "text": "入らない"},
        { "location": "1033/ACT"     , "narrator": "", "text": "入る"},
        { "location": "1034/ACT"     , "narrator": "", "text": "入らない"},
        { "location": "1051/TALK"    , "narrator": "みやび", "text": "おお、お前さんらか。"},
        { "location": "1052/TALK"    , "narrator": "みやび", "text": "またジャンプ台を\n使っていくかね？"},
        { "location": "1053/SEL"     , "narrator": "", "text": "はい"},
        { "location": "1054/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "1055/ACT"     , "narrator": "", "text": "はい"},
        { "location": "1057/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "1058/TALK"    , "narrator": "みやび", "text": "必要なら\nいつでも来いや。"},
        { "location": "1062/TALK"    , "narrator": "みやび", "text": "うーん、\nまっこと\n困ったぞね。"},
        { "location": "1064/TALK"    , "narrator": "千羽鶴", "text": "あの人は、\n奇天烈発明家\nコイガサコ博士。"},
        { "location": "1066/TALK"    , "narrator": "千羽鶴", "text": "何か困ってるみたい。"},
        { "location": "1067/TALK"    , "narrator": "みやび", "text": "おっ。\nお前さんたち\n旅の人かね。"},
        { "location": "1068/SEL"     , "narrator": "", "text": "まあ、そんなとこです"},
        { "location": "1069/ACT"     , "narrator": "", "text": "まあ、そんなとこです"},
        { "location": "1071/TALK"    , "narrator": "みやび", "text": "それは丁度えい！"},
        { "location": "1072/TALK"    , "narrator": "みやび", "text": "お前さんたち、\nリモコンを\n持っちょらんが？"},
        { "location": "1073/TALK"    , "narrator": "みやび", "text": "448MHzで出力４Wの\nやつなんやけんど。"},
        { "location": "1074/TALK"    , "narrator": "みやび", "text": "実はなぁ、\nせっかくうちの\n世紀の大発明――"},
        { "location": "1075/TALK"    , "narrator": "みやび", "text": "『大陸間弾道ジャンプ台』\nが完成したんやけんど、\nリモコン無くしてなぁ。"},
        { "location": "1076/TALK"    , "narrator": "みやび", "text": "発射試験も出来ずに\n困っちょったが。"},
        { "location": "1077/TALK"    , "narrator": "みやび", "text": "まあでも、\nリモコンなんぞ、普通\n持って歩かんよなぁ。"},
        { "location": "1079/SEL"     , "narrator": "", "text": "なんか『ジャンプリモコン』ってのならもらったけど…"},
        { "location": "1080/ACT"     , "narrator": "", "text": "なんか『ジャンプリモコン』ってのならもらったけど…"},
        { "location": "1084/TALK"    , "narrator": "みやび", "text": "おお！\nそれやそれ！\nまさにそれぞね！"},
        { "location": "1085/TALK"    , "narrator": "みやび", "text": "これを使えば、\n『大陸間弾道ジャンプ台』\nが使えるちや！"},
        { "location": "1086/TALK"    , "narrator": "みやび", "text": "ありがとう！\nありがとう！"},
        { "location": "1087/TALK"    , "narrator": "みやび", "text": "せっかくやし、\n一発やってくか？"},
        { "location": "1089/SEL"     , "narrator": "", "text": "やってく！！"},
        { "location": "1090/SEL"     , "narrator": "", "text": "遠慮します"},
        { "location": "1091/ACT"     , "narrator": "", "text": "やってく！！"},
        { "location": "1092/TALK"    , "narrator": "みやび", "text": "うむ。\nほんだら、\nこっちへ来いや。"},
        { "location": "1093/TALK"    , "narrator": "みやび", "text": "飛ばしちゃるきね！"},
        { "location": "1120/ACT"     , "narrator": "", "text": "遠慮します"},
        { "location": "1121/TALK"    , "narrator": "みやび", "text": "うむ。\nわかったぞね。"},
        { "location": "1122/TALK"    , "narrator": "みやび", "text": "必要なら\nいつでも来いや。"},
        { "location": "1126/SEL"     , "narrator": "", "text": "持ってないですね…"},
        { "location": "1127/ACT"     , "narrator": "", "text": "持ってないですね…"},
        { "location": "1129/TALK"    , "narrator": "みやび", "text": "よなぁ……。"},
        { "location": "1130/TALK"    , "narrator": "みやび", "text": "仕方ない、\nジャンプ台は\nお蔵入りやね。"},
        { "location": "1131/TALK"    , "narrator": "みやび", "text": "とほほ……。"},
        { "location": "1030/DIALOG"  , "narrator": "INFO", "text": "ジャンプ台に\n到着した！"},
        { "location": "1083/DIALOG"  , "narrator": "INFO", "text": "コイガサコ博士に\n『ジャンプリモコン』を\n渡した！"}
    ]
}
