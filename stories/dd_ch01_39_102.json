{
    "dir": "chap39/daydra/dd_ch01_39_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "39105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "瑪瑙色の空に＜後編＞"
    },
    "entry":
    [
        { "location": "890/TALK"  , "narrator": "神楽", "text": "お待たせしました。\nこれ、どうぞ。"},
        { "location": "893/TALK"  , "narrator": "つばめ", "text": "え…髪飾り…\nこれって…。"},
        { "location": "894/TALK"  , "narrator": "神楽", "text": "ラスイチだったんです。\nもう少し遅くなったら\n買えないところでした。"},
        { "location": "895/TALK"  , "narrator": "つばめ", "text": "ありがとう！\nすごくすごく\n嬉しい…！"},
        { "location": "898/TALK"  , "narrator": "スタッフ", "text": "メノウさん。\nそろそろ\nブリーフィングです。"},
        { "location": "901/TALK"  , "narrator": "神楽", "text": "はーい。"},
        { "location": "902/TALK"  , "narrator": "つばめ", "text": "あっ！　ごめんね！\nすぐ出るね！"},
        { "location": "903/TALK"  , "narrator": "つばめ", "text": "ライブ、楽しみに\nしてるから。\nじゃあ！"},
        { "location": "906/TALK"  , "narrator": "神楽", "text": "つばめさん！"},
        { "location": "907/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "910/TALK"  , "narrator": "神楽", "text": "ありがとう。\n本当に。"},
        { "location": "912/TALK"  , "narrator": "つばめ", "text": "ううん！\nこっちこそありがとう。"},
        { "location": "913/TALK"  , "narrator": "つばめ", "text": "ライブに招待して\nくれたのすっごく\nうれしいよ！"},
        { "location": "921/TALK"  , "narrator": "神楽", "text": "私はずっと、つばめさんが\n私の全てを奪ったんだと\n思ってた。"},
        { "location": "922/TALK"  , "narrator": "神楽", "text": "でも、そうじゃなかった。"},
        { "location": "923/TALK"  , "narrator": "神楽", "text": "むしろ色々与えてくれた。\n私が欲しかったものも\n昔持っていたものも全部。"},
        { "location": "924/TALK"  , "narrator": "神楽", "text": "ありがとう。"},
        { "location": "925/TALK"  , "narrator": "神楽", "text": "いくら言っても\n足りないけど。\nありがとう――。"},
        { "location": "943/TALK"  , "narrator": "つばめ", "text": "えっと…ここから\nどう行けば\nいいんだっけ…？"},
        { "location": "944/SEL"   , "narrator": "", "text": "また迷ってるの？"},
        { "location": "945/ACT"   , "narrator": "", "text": "また迷ってるの？"},
        { "location": "962/TALK"  , "narrator": "つばめ", "text": "迷ってないょ"},
        { "location": "964/SEL"   , "narrator": "", "text": "嘘ばっかり"},
        { "location": "965/SEL"   , "narrator": "", "text": "見栄張らなくていいのに"},
        { "location": "966/SEL"   , "narrator": "", "text": "じゃあ頑張って"},
        { "location": "967/ACT"   , "narrator": "", "text": "嘘ばっかり"},
        { "location": "968/TALK"  , "narrator": "つばめ", "text": "ぅそじゃなぃもん。。。"},
        { "location": "969/ACT"   , "narrator": "", "text": "見栄張らなくていいのに"},
        { "location": "970/TALK"  , "narrator": "つばめ", "text": "そんなことなぃょ"},
        { "location": "971/ACT"   , "narrator": "", "text": "じゃあ頑張って"},
        { "location": "972/TALK"  , "narrator": "つばめ", "text": "がんばるし"},
        { "location": "985/TALK"  , "narrator": "つばめ", "text": "…えっと…。"},
        { "location": "1017/TALK" , "narrator": "キリト", "text": "やっぱ探しに\n行った方が\nいんじゃね？"},
        { "location": "1018/TALK" , "narrator": "ヒカル", "text": "…まあまあ。\nもうちょっと\n待とうよ。"},
        { "location": "1020/TALK" , "narrator": "雛", "text": "そうそう。"},
        { "location": "1021/TALK" , "narrator": "雛", "text": "女子同士の話で\n盛り上がってる\nだけかもしれないし。"},
        { "location": "1022/TALK" , "narrator": "繭", "text": "いくらなんでも\nここで迷うとは\n思いたくないし。"},
        { "location": "1023/TALK" , "narrator": "キリト", "text": "わかってねーな。\n逢瀬だぞ？"},
        { "location": "1024/TALK" , "narrator": "雛", "text": "そう言われたら\n心配になって\nくるでしょー？"},
        { "location": "1025/TALK" , "narrator": "繭", "text": "…キリトは逢瀬さんと\n親しいの？"},
        { "location": "1026/TALK" , "narrator": "キリト", "text": "えっ！？\nさり気なく傷つく\n質問だなそれ。"},
        { "location": "1029/TALK" , "narrator": "キリト", "text": "その…友達の\nつもりだけど。"},
        { "location": "1030/TALK" , "narrator": "雛", "text": "そんなのみんな\n一緒でしょ？"},
        { "location": "1031/TALK" , "narrator": "雛", "text": "ここにいるのはみんな\nつばめちゃんの友達。"},
        { "location": "1032/TALK" , "narrator": "雛", "text": "じゃなきゃ\n三崎まで\n行ったりしない。"},
        { "location": "1035/TALK" , "narrator": "キリト", "text": "あれ結構ハード\nだったよな…。"},
        { "location": "1036/TALK" , "narrator": "ヒカル", "text": "なかなかできない\n体験だったよね。"},
        { "location": "1037/TALK" , "narrator": "雛", "text": "それだったら\n謹慎の方が\nできなくない？"},
        { "location": "1038/TALK" , "narrator": "キリト", "text": "うるせーな。\nバレるとは思って\nなかったんだよ。"},
        { "location": "1039/TALK" , "narrator": "ヒカル", "text": "…準備不足だったよね。"},
        { "location": "1041/TALK" , "narrator": "雛", "text": "ヒカルくんってさりげに\nキリトより悪ガキ\nだよね…。"},
        { "location": "1042/TALK" , "narrator": "キリト", "text": "だよなー。なのに\n一見優等生っぽいの\nずっりーよな。"},
        { "location": "1043/TALK" , "narrator": "ヒカル", "text": "ズルなんて\nしてないって。"},
        { "location": "1045/TALK" , "narrator": "繭", "text": "カモフラージュも\n時には必要。"},
        { "location": "1046/TALK" , "narrator": "ヒカル", "text": "…手厳しいなあ。"},
        { "location": "1048/TALK" , "narrator": "キリト", "text": "いや、\n褒め言葉でしょ。"},
        { "location": "1049/TALK" , "narrator": "キリト", "text": "な？"},
        { "location": "1051/TALK" , "narrator": "繭", "text": "その通り。"},
        { "location": "1052/TALK" , "narrator": "キリト", "text": "あー。\n俺ももう少し無口に\nなった方がいいのかな。"},
        { "location": "1055/TALK" , "narrator": "雛", "text": "なんでできないこと\n言うのかなー？"},
        { "location": "1057/TALK" , "narrator": "キリト", "text": "いやいやいやいや。\nやってみないと\nわからないって！"},
        { "location": "1058/TALK" , "narrator": "キリト", "text": "わかった今から\nちょっと無口に\nなるわ。"},
        { "location": "1059/TALK" , "narrator": "キリト", "text": "もう俺喋らないから！\n絶対喋らないから！"},
        { "location": "1060/TALK" , "narrator": "キリト", "text": "ホントのホントに\n喋らないから！"},
        { "location": "1062/TALK" , "narrator": "雛", "text": "…さっそく嘘だって\nバレてるけど…。"},
        { "location": "1079/TALK" , "narrator": "つばめ", "text": "…ここ前に\n見たような…。"},
        { "location": "1080/SEL"  , "narrator": "", "text": "みんなに会えそう？"},
        { "location": "1081/ACT"  , "narrator": "", "text": "みんなに会えそう？"},
        { "location": "1098/TALK" , "narrator": "つばめ", "text": "会えるよ"},
        { "location": "1099/TALK" , "narrator": "つばめ", "text": "たぶん。。。"},
        { "location": "1101/SEL"  , "narrator": "", "text": "待たせてるんじゃないの？"},
        { "location": "1102/SEL"  , "narrator": "", "text": "早く行ってあげなよ"},
        { "location": "1103/SEL"  , "narrator": "", "text": "連絡してみれば？"},
        { "location": "1104/ACT"  , "narrator": "", "text": "待たせてるんじゃないの？"},
        { "location": "1105/TALK" , "narrator": "つばめ", "text": "そうかも"},
        { "location": "1106/ACT"  , "narrator": "", "text": "早く行ってあげなよ"},
        { "location": "1107/TALK" , "narrator": "つばめ", "text": "そうだね"},
        { "location": "1108/ACT"  , "narrator": "", "text": "連絡してみれば？"},
        { "location": "1109/TALK" , "narrator": "つばめ", "text": "そうした方がぃぃかな。。。"},
        { "location": "1111/TALK" , "narrator": "つばめ", "text": "心配してくれてぁりがとぅ"},
        { "location": "1112/TALK" , "narrator": "つばめ", "text": "大丈夫"},
        { "location": "1113/TALK" , "narrator": "つばめ", "text": "ぁたしちゃんとできるから"},
        { "location": "1115/SEL"  , "narrator": "", "text": "知ってる"},
        { "location": "1116/SEL"  , "narrator": "", "text": "頼ってくれていいのに"},
        { "location": "1117/SEL"  , "narrator": "", "text": "それでこそつばめ"},
        { "location": "1118/ACT"  , "narrator": "", "text": "知ってる"},
        { "location": "1120/TALK" , "narrator": "つばめ", "text": "ぁりがとぅ"},
        { "location": "1121/ACT"  , "narrator": "", "text": "頼ってくれていいのに"},
        { "location": "1123/TALK" , "narrator": "つばめ", "text": "本当に辛い時はそぅするね"},
        { "location": "1124/ACT"  , "narrator": "", "text": "それでこそつばめ"},
        { "location": "1126/TALK" , "narrator": "つばめ", "text": "そう言われるのすごくぅれしい"},
        { "location": "1171/TALK" , "narrator": "雛", "text": "…ちょっと連絡\nしてみようか？"},
        { "location": "1173/TALK" , "narrator": "キリト", "text": "さっきと意見\n違くない？"},
        { "location": "1174/TALK" , "narrator": "雛", "text": "そうなんだけど…。"},
        { "location": "1175/TALK" , "narrator": "雛", "text": "つばめちゃんって\n変な遠慮する\nところあるでしょ。"},
        { "location": "1176/TALK" , "narrator": "雛", "text": "迷ってても連絡\nできないのかもって\n思っちゃって。"},
        { "location": "1178/TALK" , "narrator": "ヒカル", "text": "まだ時間には\n余裕あるよ。"},
        { "location": "1179/TALK" , "narrator": "雛", "text": "んー…。"},
        { "location": "1180/TALK" , "narrator": "雛", "text": "やっぱり話し込んでる\nだけなのかもね。"},
        { "location": "1181/TALK" , "narrator": "雛", "text": "神楽ちゃんだって\n色々不安かも\nしれないし。"},
        { "location": "1182/TALK" , "narrator": "キリト", "text": "だよなあ。\nドームいっぱいの\nファンの前で。"},
        { "location": "1183/TALK" , "narrator": "キリト", "text": "これから歌うん\nだもんなあ。"},
        { "location": "1184/TALK" , "narrator": "キリト", "text": "…はー。\n俺考えただけで\nちびりそう…。"},
        { "location": "1186/TALK" , "narrator": "ヒカル", "text": "ははは。"},
        { "location": "1187/TALK" , "narrator": "キリト", "text": "んだよ。"},
        { "location": "1188/TALK" , "narrator": "雛", "text": "…あたしさ。"},
        { "location": "1189/TALK" , "narrator": "雛", "text": "神楽ちゃんが\nつばめちゃんに\nひどいことした時。"},
        { "location": "1190/TALK" , "narrator": "雛", "text": "それでも\n神楽ちゃんを庇ったって\n聞いた時。"},
        { "location": "1191/TALK" , "narrator": "雛", "text": "ものすごく\nつばめちゃんらしいな\nって思った。"},
        { "location": "1192/TALK" , "narrator": "雛", "text": "でもそれは、共感とは\nちょっと違ってて。"},
        { "location": "1193/TALK" , "narrator": "雛", "text": "そういう子だよね、\nみたいなさ。"},
        { "location": "1194/TALK" , "narrator": "雛", "text": "なんていうのかな。\nちょっと天使っぽいって\nいうか。"},
        { "location": "1195/TALK" , "narrator": "雛", "text": "神様？　聖母…？"},
        { "location": "1197/TALK" , "narrator": "繭", "text": "聖女。"},
        { "location": "1199/TALK" , "narrator": "雛", "text": "あー。\n近いかも。"},
        { "location": "1200/TALK" , "narrator": "キリト", "text": "そんな神々しい\n友達やだな俺。"},
        { "location": "1201/TALK" , "narrator": "ヒカル", "text": "ご利益があるかもよ。"},
        { "location": "1202/TALK" , "narrator": "キリト", "text": "んじゃテストのヤマでも\n張ってもらおうかな。"},
        { "location": "1204/TALK" , "narrator": "雛", "text": "もー。\nそういうんじゃ\nないんだって。"},
        { "location": "1205/TALK" , "narrator": "雛", "text": "つばめちゃんは\n損得なしにみんなのことが\n好きなんだなって。"},
        { "location": "1206/TALK" , "narrator": "雛", "text": "この世界を\n嫌ったりすることは\nしないんだなって。"},
        { "location": "1207/TALK" , "narrator": "雛", "text": "安心感？"},
        { "location": "1208/TALK" , "narrator": "繭", "text": "それは私も同感。"},
        { "location": "1209/TALK" , "narrator": "キリト", "text": "……わかる。"},
        { "location": "1211/TALK" , "narrator": "雛", "text": "あんなにドジな子\nなのにね。"},
        { "location": "1212/TALK" , "narrator": "キリト", "text": "そこがいいのかも。"},
        { "location": "1214/TALK" , "narrator": "雛", "text": "あっ！　ひょっとして\n守ってあげたいって\n思ってる？"},
        { "location": "1215/TALK" , "narrator": "キリト", "text": "…いや。むしろこっちが\n護られてるみたいな\nそんな気がする。"},
        { "location": "1216/TALK" , "narrator": "雛", "text": "あー……。"},
        { "location": "1217/TALK" , "narrator": "雛", "text": "なんでだろ。\nあたしもそんな気持ち。"},
        { "location": "1219/TALK" , "narrator": "繭", "text": "……。"},
        { "location": "1248/TALK" , "narrator": "キリト", "text": "お。\n聖女様ご光臨。"},
        { "location": "1249/TALK" , "narrator": "雛", "text": "つばめちゃーん！\nこっちこっち！"},
        { "location": "883/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"}
    ]
}
