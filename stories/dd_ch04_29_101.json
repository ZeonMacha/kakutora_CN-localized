{
    "dir": "chap29/daydra/dd_ch04_29_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "29402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "向かい合わせの鏡＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "平行世界サバイバル"},
        { "location": "27/TALK"   , "narrator": "みやび", "text": "…うちの方で\nわかったことは\n以上です。"},
        { "location": "28/TALK"   , "narrator": "真幌", "text": "そうか。\nご苦労さん。"},
        { "location": "29/TALK"   , "narrator": "真幌", "text": "音羽を連れて来いと\nいうのはそういう\n理由だったのか。"},
        { "location": "31/TALK"   , "narrator": "真幌", "text": "ううん……。"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "…まほさん。"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "エリカさんと\nまほさんってどういう\n関係ですか？"},
        { "location": "34/TALK"   , "narrator": "真幌", "text": "…んー。"},
        { "location": "36/TALK"   , "narrator": "真幌", "text": "知り合いだ、と\nいうだけでは\n納得できないか。"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "それと。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "今エリカさんは\nどこにおるんですか？"},
        { "location": "40/TALK"   , "narrator": "真幌", "text": "……。"},
        { "location": "42/TALK"   , "narrator": "真幌", "text": "外の空気を\n吸いに行こうか。"},
        { "location": "59/TALK"   , "narrator": "真幌", "text": "……。"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "……。"},
        { "location": "61/TALK"   , "narrator": "真幌", "text": "こういうところで\n余生を暮らすのも\n悪くないな。"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "……。"},
        { "location": "65/TALK"   , "narrator": "真幌", "text": "そうは思わないか？"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "…うちには\n無理そうです。\nそういう生活は。"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "こう言うたら悪いかも\nしれんけんど、\nサバイバルすぎます。"},
        { "location": "71/TALK"   , "narrator": "真幌", "text": "そうか？"},
        { "location": "72/TALK"   , "narrator": "真幌", "text": "ここには電気もある。\n水道もガスもある。\n住民に戦闘意思もない。"},
        { "location": "73/TALK"   , "narrator": "真幌", "text": "通貨の使用もできるし\n罠を仕掛けられる\nこともないぞ。"},
        { "location": "74/SEL"    , "narrator": "", "text": "真幌って何者？"},
        { "location": "75/SEL"    , "narrator": "", "text": "すごいこと言い出したよ！？"},
        { "location": "76/SEL"    , "narrator": "", "text": "冒険活劇開幕！"},
        { "location": "77/ACT"    , "narrator": "", "text": "真幌って何者？"},
        { "location": "78/ACT"    , "narrator": "", "text": "すごいこと言い出したよ！？"},
        { "location": "79/ACT"    , "narrator": "", "text": "冒険活劇開幕！"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "$handle$は"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "何も知らぬのか？"},
        { "location": "99/SEL"    , "narrator": "", "text": "知ってるわけない"},
        { "location": "100/SEL"   , "narrator": "", "text": "いろいろ聞き出してよ"},
        { "location": "101/SEL"   , "narrator": "", "text": "元傭兵か何かなのかな？"},
        { "location": "102/ACT"   , "narrator": "", "text": "知ってるわけない"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "そうか"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "残念だの"},
        { "location": "105/ACT"   , "narrator": "", "text": "いろいろ聞き出してよ"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "確かに"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "気になるの"},
        { "location": "108/ACT"   , "narrator": "", "text": "元傭兵か何かなのかな？"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "どうにも"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "そんな言い草"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "まほさんは\nそんな経験が\nあるんですか？"},
        { "location": "125/TALK"  , "narrator": "真幌", "text": "…ものの例えと\nいうことにして\nおいてくれ。"},
        { "location": "126/TALK"  , "narrator": "真幌", "text": "それより今は\nエリカのことだろ。"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "…そうですね。"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "正直何もかもが\n現実離れしすぎてて\n理解がおいつかないです。"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "いっそ全てが冗談やと\n言われた方がいいような\n気すらします。"},
        { "location": "133/TALK"  , "narrator": "真幌", "text": "確かにな。"},
        { "location": "134/TALK"  , "narrator": "真幌", "text": "だが最悪の事態は\n避けられている。\nつばめのおかげで。"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "136/TALK"  , "narrator": "真幌", "text": "違うか？"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "そうかもしれん。"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "けんど、それはあくまで\nこの世界の中にいて\n思っているだけの話。"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "「そう思わされてるだけ」\nじゃないと誰が言える？"},
        { "location": "188/TALK"  , "narrator": "みやび", "text": "　"},
        { "location": "208/TALK"  , "narrator": "みやびの新司書", "text": "ようこそ。"},
        { "location": "209/SEL"   , "narrator": "", "text": "新しい司書か"},
        { "location": "210/ACT"   , "narrator": "", "text": "新しい司書か"},
        { "location": "212/TALK"  , "narrator": "みやびの新司書", "text": "うむ。\nよう逃げずに来たね。"},
        { "location": "213/TALK"  , "narrator": "みやびの新司書", "text": "逃げちょったら\nシンギュラリティは既に\nお前さんを忘れちょった。"},
        { "location": "214/TALK"  , "narrator": "みやびの新司書", "text": "ほんだら早速やけんど、\n最終的な回答を\n聞きたいと思う。"},
        { "location": "215/TALK"  , "narrator": "みやびの新司書", "text": "現実のうちとの回線を\n切断するか。"},
        { "location": "216/TALK"  , "narrator": "みやびの新司書", "text": "シンギュラリティの\n記憶を操作するか。"},
        { "location": "217/SEL"   , "narrator": "", "text": "回線を切断する"},
        { "location": "218/SEL"   , "narrator": "", "text": "回線を切断しない"},
        { "location": "219/ACT"   , "narrator": "", "text": "回線を切断する"},
        { "location": "220/TALK"  , "narrator": "みやびの新司書", "text": "うむ、わかった。\nえい心がけやね。"},
        { "location": "221/TALK"  , "narrator": "みやびの新司書", "text": "今まで長い間\nうちをひっかき回して\nくれてありがとう。"},
        { "location": "222/TALK"  , "narrator": "みやびの新司書", "text": "ほんだら、さよなら。"},
        { "location": "232/ACT"   , "narrator": "", "text": "回線を切断しない"},
        { "location": "234/TALK"  , "narrator": "みやびの新司書", "text": "ふむ。"},
        { "location": "235/TALK"  , "narrator": "みやびの新司書", "text": "シンギュラリティは\n切って問題なしと\nゆうことやね。"},
        { "location": "236/TALK"  , "narrator": "みやびの新司書", "text": "１つヒントをやる。"},
        { "location": "237/TALK"  , "narrator": "みやびの新司書", "text": "以後のココロの司書は\nうちになる。"},
        { "location": "238/TALK"  , "narrator": "みやびの新司書", "text": "てことは、今ここで\nうちとの回線を切断\nしようがしまいが――"},
        { "location": "239/TALK"  , "narrator": "みやびの新司書", "text": "結局のところ、現実の\nうちとはこれ以上の仲には\nなれんちゅうことや。"},
        { "location": "240/SEL"   , "narrator": "", "text": "何故？"},
        { "location": "241/ACT"   , "narrator": "", "text": "何故？"},
        { "location": "243/TALK"  , "narrator": "みやびの新司書", "text": "まず第一に、\nシンギュラリティの記憶を\n消してしまうこと。"},
        { "location": "244/TALK"  , "narrator": "みやびの新司書", "text": "あやつはお前さんと\n現実のうちとの、潜在的な\nキューピット役やった。"},
        { "location": "245/TALK"  , "narrator": "みやびの新司書", "text": "その記憶を失えば、\n現実のうちもまた、\nお前さんに興味を失う。"},
        { "location": "246/TALK"  , "narrator": "みやびの新司書", "text": "もちろん完全にではないが\nそれでもダメージは\nそれなりにある筈や。"},
        { "location": "247/TALK"  , "narrator": "みやびの新司書", "text": "第二には、うちが\nココロの司書になることで\nお前さんに否定的になる。"},
        { "location": "248/TALK"  , "narrator": "みやびの新司書", "text": "そうすれば、ココロの中\n全体でお前さんの評判は\n下落し――"},
        { "location": "249/TALK"  , "narrator": "みやびの新司書", "text": "現実のうちもまた、\nお前さんに対して\n疑心暗鬼になるわけやね。"},
        { "location": "250/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "251/SEL"   , "narrator": "", "text": "$me$に心を開けばいいんだよね？"},
        { "location": "252/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "253/TALK"  , "narrator": "みやびの新司書", "text": "やき、今のうちに\n撤退しておいた方が、\nお前さんの傷も浅い。"},
        { "location": "254/TALK"  , "narrator": "みやびの新司書", "text": "これはむしろ、\n良心から助言しちゅう\nことやき。"},
        { "location": "255/TALK"  , "narrator": "みやびの新司書", "text": "考え直したか？"},
        { "location": "256/SEL"   , "narrator": "", "text": "はい"},
        { "location": "257/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "258/ACT"   , "narrator": "", "text": "はい"},
        { "location": "259/TALK"  , "narrator": "みやびの新司書", "text": "うむ、わかった。\nえい心がけやね。"},
        { "location": "260/TALK"  , "narrator": "みやびの新司書", "text": "今まで長い間\nうちをひっかき回して\nくれてありがとう。"},
        { "location": "261/TALK"  , "narrator": "みやびの新司書", "text": "ほんだら、さよなら。"},
        { "location": "271/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "275/ACT"   , "narrator": "", "text": "$me$に心を開けばいいんだよね？"},
        { "location": "278/TALK"  , "narrator": "みやびの新司書", "text": "……。"},
        { "location": "279/TALK"  , "narrator": "みやびの新司書", "text": "頭悪いね。"},
        { "location": "280/TALK"  , "narrator": "みやびの新司書", "text": "……。"},
        { "location": "281/TALK"  , "narrator": "みやびの新司書", "text": "そうやね、\nほんだら、これで\n手を打たんかね。"},
        { "location": "282/TALK"  , "narrator": "みやびの新司書", "text": "近々また、なごちゃんの\n慰霊祭をやるがやけんど、\nそれに参加してくれんか。"},
        { "location": "283/TALK"  , "narrator": "みやびの新司書", "text": "してくれるがやったら、\nお前さんもシンギュラリ\nティも、少し猶予をやる。"},
        { "location": "284/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "285/SEL"   , "narrator": "", "text": "どんな儀式？"},
        { "location": "286/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "287/TALK"  , "narrator": "みやびの新司書", "text": "うむ。\n契約成立やね。"},
        { "location": "288/ACT"   , "narrator": "", "text": "どんな儀式？"},
        { "location": "290/TALK"  , "narrator": "みやびの新司書", "text": "名前の通り、\nなごちゃんを\n慰霊する会やよ。"},
        { "location": "291/TALK"  , "narrator": "みやびの新司書", "text": "それ以上でも\nそれ以下でもない。"},
        { "location": "292/SEL"   , "narrator": "", "text": "いいよ　"},
        { "location": "293/SEL"   , "narrator": "", "text": "いやだ"},
        { "location": "294/ACT"   , "narrator": "", "text": "いいよ　"},
        { "location": "296/TALK"  , "narrator": "みやびの新司書", "text": "うむ。\n契約成立やね。"},
        { "location": "297/ACT"   , "narrator": "", "text": "いやだ"},
        { "location": "298/TALK"  , "narrator": "みやびの新司書", "text": "はぁ…。"},
        { "location": "299/TALK"  , "narrator": "みやびの新司書", "text": "アレもダメ、これもダメ。\nわがまま小僧か。"},
        { "location": "301/TALK"  , "narrator": "みやびの新司書", "text": "時間切れ。"},
        { "location": "314/TALK"  , "narrator": "みやびの新司書", "text": "次回はなごちゃんの所へ\n一緒に行くき。\n準備しとき。"},
        { "location": "315/TALK"  , "narrator": "みやびの新司書", "text": "おやつは300円までな。\nバナナは別や。"},
        { "location": "316/TALK"  , "narrator": "みやびの新司書", "text": "ほな、またな――"},
        { "location": "317/SEL"   , "narrator": "", "text": "心の葛藤は！？"},
        { "location": "318/ACT"   , "narrator": "", "text": "心の葛藤は！？"},
        { "location": "320/TALK"  , "narrator": "みやびの新司書", "text": "……。"},
        { "location": "321/TALK"  , "narrator": "みやびの新司書", "text": "別に心配せんでもえいよ？"},
        { "location": "322/TALK"  , "narrator": "みやびの新司書", "text": "葛藤を解消せんでも、\nうちはなんも困りはせん。"},
        { "location": "323/TALK"  , "narrator": "みやびの新司書", "text": "まあしかし、確かに今回\nまでは、普通の振る舞いを\nしておいた方がえいね。"},
        { "location": "324/TALK"  , "narrator": "みやびの新司書", "text": "次回からは、うちが\nココロの司書として\n徹底ブロックするけんど。"},
        { "location": "325/TALK"  , "narrator": "みやびの新司書", "text": "ほな、いくぞね。"},
        { "location": "355/TALK"  , "narrator": "みやびの新司書", "text": "……頭ごちゃごちゃやね。"},
        { "location": "356/TALK"  , "narrator": "みやびの新司書", "text": "少しクランの数を減らして\n頭整理せんと、アホな質問\n連発しゆうき。"},
        { "location": "357/TALK"  , "narrator": "みやびの新司書", "text": "いい感じに\nやったってや。"},
        { "location": "358/TALK"  , "narrator": "みやびの新司書", "text": "ほな、\nうちとなごちゃんに\n素敵なココロの旅を。"},
        { "location": "26/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月5日　 3:36 PM</color>\n合宿中、みやびの実家でのこと"},
        { "location": "153/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "155/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "157/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "159/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "161/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "227/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)"},
        { "location": "266/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)"},
        { "location": "306/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)"}
    ]
