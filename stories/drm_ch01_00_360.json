        { "location": "144/TALK"    , "narrator": "つばめ", "text": "ひとつ大人になれたねヽ(〃´∀`〃)ﾉ"},
        { "location": "145/ACT"     , "narrator": "", "text": "お酒飲んだの？"},
        { "location": "148/TALK"    , "narrator": "つばめ", "text": "違うょ"},
        { "location": "149/TALK"    , "narrator": "つばめ", "text": "飲んでないょヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "151/TALK"    , "narrator": "つばめ", "text": "今日は合宿でみんなで遊びに行ったの(*≧∀≦*) "},
        { "location": "152/TALK"    , "narrator": "つばめ", "text": "それで、トロピカルドリンクを出すお店があったの"},
        { "location": "153/TALK"    , "narrator": "つばめ", "text": "だからみんなで飲んだの(・ω<) ﾃﾍﾍﾟﾛ"},
        { "location": "155/TALK"    , "narrator": "つばめ", "text": "あっ"},
        { "location": "156/TALK"    , "narrator": "つばめ", "text": "お酒じゃなくてジュースのやつだよ(*´︶`*)"},
        { "location": "158/SEL"     , "narrator": "", "text": "よかったね"},
        { "location": "159/SEL"     , "narrator": "", "text": "おいしかった？"},
        { "location": "160/SEL"     , "narrator": "", "text": "つばめと一緒に飲みたいな"},
        { "location": "161/ACT"     , "narrator": "", "text": "よかったね"},
        { "location": "162/TALK"    , "narrator": "つばめ", "text": "ぅん(●´ω｀●)ゞｴﾍﾍ"},
        { "location": "163/ACT"     , "narrator": "", "text": "おいしかった？"},
        { "location": "164/TALK"    , "narrator": "つばめ", "text": "すごく甘くっておぃしかったょ"},
        { "location": "165/TALK"    , "narrator": "つばめ", "text": "甘いのだいすき(≧ω≦)"},
        { "location": "166/ACT"     , "narrator": "", "text": "つばめと一緒に飲みたいな"},
        { "location": "177/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "178/TALK"    , "narrator": "つばめ", "text": "ぁたしも(*´︶`*)"},
        { "location": "179/TALK"    , "narrator": "つばめ", "text": "ちょっとだけそう思ってたの"},
        { "location": "180/TALK"    , "narrator": "つばめ", "text": "ほんとだょｖ(*´∀｀*)ｖ"},
        { "location": "182/TALK"    , "narrator": "つばめ", "text": "$handle$さんは甘いの好き？"},
        { "location": "184/SEL"     , "narrator": "", "text": "好き"},
