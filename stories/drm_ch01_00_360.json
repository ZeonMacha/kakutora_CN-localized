        { "location": "194/TALK"    , "narrator": "つばめ", "text": "そんなことしなくてぃぃょ！？"},
        { "location": "195/TALK"    , "narrator": "つばめ", "text": "|д･)＜大丈夫だょ）"},
        { "location": "197/TALK"    , "narrator": "つばめ", "text": "男の人向けのトロピカルドリンクもあったし"},
        { "location": "198/TALK"    , "narrator": "つばめ", "text": "お酒入ってるのも入ってないのもあったよｖ(*´∀｀*)ｖ"},
        { "location": "199/TALK"    , "narrator": "つばめ", "text": "だから今度は一緒に飲みたぃな(ﾉ≧ڡ≦)"},
        { "location": "202/SEL"     , "narrator": "", "text": "そうだね"},
