        { "location": "103/SCENARIO", "narrator": "", "text": "トロピカルドリンク"},
        { "location": "130/TALK"    , "narrator": "つばめ", "text": "ねぇねぇ知ってたヾ(｡>﹏<｡)ﾉﾞ？"},
