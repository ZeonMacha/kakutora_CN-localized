        { "location": "135/SEL"     , "narrator": "", "text": "知らなかった"},
        { "location": "136/SEL"     , "narrator": "", "text": "お酒飲んだの？"},
        { "location": "137/ACT"     , "narrator": "", "text": "知ってた"},
        { "location": "140/TALK"    , "narrator": "つばめ", "text": "$handle$さんって結構大人なの！？"},
        { "location": "142/ACT"     , "narrator": "", "text": "知らなかった"},
