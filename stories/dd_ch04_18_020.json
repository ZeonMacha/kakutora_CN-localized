{
    "dir": "chap18/daydra/dd_ch04_18_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "18456",
        "cid": "miyabi",
        "title": "Extra005 プレミアムストーリー",
        "sub_title": "テストプレイ"
    },
    "entry":
    [
        { "location": "222/SCENARIO", "narrator": "", "text": "テストプレイ"},
        { "location": "248/TALK"    , "narrator": "キリト", "text": "うわっ、また死んだ！！"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "凡ミスやね。\nキリト君、シューティング\nゲームは苦手やったが？"},
        { "location": "252/TALK"    , "narrator": "キリト", "text": "いや、違いますって！\nみやび先輩のゲームが\n難し過ぎるんすよ！"},
        { "location": "254/TALK"    , "narrator": "つばめ", "text": "わたしなんか、始まって\n十秒でやられちゃい\nました…。"},
        { "location": "256/TALK"    , "narrator": "繭", "text": "あの、このゲームって\n本当にみやび先輩は\nクリアしたのですか？"},
        { "location": "257/TALK"    , "narrator": "みやび", "text": "製作者やき、当然ぞね。"},
        { "location": "259/TALK"    , "narrator": "みやび", "text": "ほれ、次はまた\nひなこちゃんの番や。"},
        { "location": "261/TALK"    , "narrator": "雛", "text": "クリアできる気が\nしないので、パスです！"},
        { "location": "262/TALK"    , "narrator": "雛", "text": "っていうか、もう少し\n難易度下げてください！"},
        { "location": "263/TALK"    , "narrator": "みやび", "text": "難易度が高くない\n弾幕シューティングなんぞ\n楽しめんがよ。"},
        { "location": "266/TALK"    , "narrator": "キリト", "text": "高過ぎるのも楽しめない\nと思うっすけど…。"},
        { "location": "268/TALK"    , "narrator": "みやび", "text": "そんな高いやろか？"},
        { "location": "270/TALK"    , "narrator": "つばめ", "text": "高過ぎます！"},
        { "location": "274/TALK"    , "narrator": "繭", "text": "私もそう思います。\n一般人が楽しめない\nゲームは、問題ありです。"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "288/TALK"    , "narrator": "みやび", "text": "相棒、うちにはいくつかの自分ルールがあるがよ"},
        { "location": "289/TALK"    , "narrator": "みやび", "text": "そのうちの一つが"},
        { "location": "290/TALK"    , "narrator": "みやび", "text": "一度完成したゲームには手を付けん、というものやが"},
        { "location": "292/SEL"     , "narrator": "", "text": "初耳だよ"},
        { "location": "293/ACT"     , "narrator": "", "text": "初耳だよ"},
        { "location": "295/TALK"    , "narrator": "みやび", "text": "当然や"},
        { "location": "296/TALK"    , "narrator": "みやび", "text": "今さっき決めたルールやき、知っちょったらホラーやぞ"},
        { "location": "297/TALK"    , "narrator": "みやび", "text": "けんど、どうにもうちのゲームは難しいらしくてなぁ…"},
        { "location": "298/TALK"    , "narrator": "みやび", "text": "…どうしたら\nえいと思う？"},
        { "location": "300/SEL"     , "narrator": "", "text": "直してあげようよ"},
        { "location": "301/SEL"     , "narrator": "", "text": "みんなが下手なだけだ"},
        { "location": "302/SEL"     , "narrator": "", "text": "ネットに公開だ！"},
        { "location": "303/ACT"     , "narrator": "", "text": "直してあげようよ"},
        { "location": "305/TALK"    , "narrator": "みやび", "text": "…マジで言うとる？"},
        { "location": "306/TALK"    , "narrator": "みやび", "text": "はぁ…自分ルール曲げなあかんかぁ…ショックやなぁ…"},
        { "location": "307/TALK"    , "narrator": "みやび", "text": "まあ、あいつらにはテストプレイしてもらった恩もあるき"},
        { "location": "308/TALK"    , "narrator": "みやび", "text": "ちっくとだけ難易度調整しちゃるか"},
        { "location": "320/TALK"    , "narrator": "みやび", "text": "今回だけやぞ？"},
        { "location": "322/TALK"    , "narrator": "つばめ", "text": "難易度、下げてくれるん\nですか？"},
        { "location": "323/TALK"    , "narrator": "みやび", "text": "ちっくとだけ下げちゃる\nけんど――"},
        { "location": "324/TALK"    , "narrator": "みやび", "text": "それでもクリアできん\nかった時は、うちはもう\n知らんちや。"},
        { "location": "326/TALK"    , "narrator": "キリト", "text": "ちょっとかよ…\nでもまあ、今より優しく\nなるだけマシか。"},
        { "location": "328/TALK"    , "narrator": "繭", "text": "今の鬼畜レベルのを\nプレイした後なら、\nきっと簡単に感じるはず。"},
        { "location": "329/TALK"    , "narrator": "繭", "text": "修正版で、絶対に\nリベンジしなくちゃ…。"},
        { "location": "331/TALK"    , "narrator": "雛", "text": "あたしも簡単になるん\nだったら、また遊んで\nみたいなー。"},
        { "location": "332/TALK"    , "narrator": "雛", "text": "ゲームシステムとか、\nストーリーは間違いなく\n面白いんだし。"},
        { "location": "333/TALK"    , "narrator": "キリト", "text": "ああ、同感だぜ！\n難易度のせいで\n台無しになってるけどな。"},
        { "location": "334/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "337/TALK"    , "narrator": "つばめ", "text": "修正版が完成するの、\n楽しみに待ってます。"},
        { "location": "338/TALK"    , "narrator": "みやび", "text": "…次からは、\nイージーモードも\n用意しちゃるか。"},
        { "location": "339/ACT"     , "narrator": "", "text": "みんなが下手なだけだ"},
        { "location": "340/TALK"    , "narrator": "みやび", "text": "うちもそう思うがよ"},
        { "location": "341/TALK"    , "narrator": "みやび", "text": "相棒もそう思うんなら、やはしうちの思うた通りやね"},
        { "location": "342/TALK"    , "narrator": "みやび", "text": "難易度下げる必要、なしや！"},
        { "location": "353/TALK"    , "narrator": "みやび", "text": "あんたら、\nゲーム下手過ぎやき。"},
        { "location": "355/TALK"    , "narrator": "繭", "text": "なっ！？"},
        { "location": "356/TALK"    , "narrator": "雛", "text": "あ、あたし達が下手！？"},
        { "location": "357/TALK"    , "narrator": "つばめ", "text": "わ、わたしはちょっと、\nこういうの苦手かも…。"},
        { "location": "360/TALK"    , "narrator": "キリト", "text": "聞き捨てならねぇな。\n俺はゲーセンでワンコイン\nクリアの常連なんすよ？"},
        { "location": "362/TALK"    , "narrator": "みやび", "text": "ゲーセンはゲーセン。\nうちのゲームはうちの\nゲームちや。"},
        { "location": "364/TALK"    , "narrator": "みやび", "text": "それに、ゲーセンのは\n難易度が低く設定されて\nるんもあるがよ。"},
        { "location": "365/TALK"    , "narrator": "キリト", "text": "ぐっ、うぐぐ…っ！"},
        { "location": "367/TALK"    , "narrator": "雛", "text": "…こうなったら、\n練習するしかないよ。"},
        { "location": "368/TALK"    , "narrator": "雛", "text": "いっぱい練習して、\nあたし達が下手じゃない\nことを証明しよう！"},
        { "location": "369/TALK"    , "narrator": "繭", "text": "賛成よ。\n私も下手と言われたままで\nいるのは性に合わないわ。"},
        { "location": "370/TALK"    , "narrator": "キリト", "text": "先輩、絶対にクリアして\nみせるから、練習させて\nくれないっすか？"},
        { "location": "371/TALK"    , "narrator": "みやび", "text": "うむ、えいよ。\n気が済むまで練習しい。"},
        { "location": "372/TALK"    , "narrator": "みやび", "text": "うちの出した評価が\n変わることを期待しとる\nがよ。"},
        { "location": "375/TALK"    , "narrator": "雛", "text": "よーし、今度はあたしが\nやってみる！"},
        { "location": "376/TALK"    , "narrator": "みやび", "text": "…自分の作ったゲームで\n遊ぶヤツの姿を見るんは、\n気持ちえいもんやなぁ。"},
        { "location": "378/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "379/TALK"    , "narrator": "真幌", "text": "おまえら…仕事中なのを\n忘れるなよ？"},
        { "location": "380/ACT"     , "narrator": "", "text": "ネットに公開だ"},
        { "location": "381/TALK"    , "narrator": "みやび", "text": "なるほど…それはえい考えかもしれんな"},
        { "location": "382/TALK"    , "narrator": "みやび", "text": "この難易度のゲームを、喉から手が出るほど求めちゅうヤツもおるやろうし"},
        { "location": "383/TALK"    , "narrator": "みやび", "text": "決まりや、それでいくがよ"},
        { "location": "395/TALK"    , "narrator": "みやび", "text": "なら、うちはこのゲームを\nネットに公開するちや。"},
        { "location": "396/TALK"    , "narrator": "みやび", "text": "あんたらはダメでも、\n世界にはこの難易度の\nゲームを――"},
        { "location": "398/TALK"    , "narrator": "みやび", "text": "喉から手が出るほど\n求めちゅうヤツも\nおるやろうきね。"},
        { "location": "400/TALK"    , "narrator": "キリト", "text": "そりゃまあ、間違いなく\nいるとは思いますけど…。"},
        { "location": "402/TALK"    , "narrator": "繭", "text": "凄腕の廃人プレイヤー以外\n考えられません。"},
        { "location": "404/TALK"    , "narrator": "みやび", "text": "作り手のうちとしては、\n廃人でも構わんがよ。"},
        { "location": "406/TALK"    , "narrator": "雛", "text": "…無料の、自作ゲーム\n配布サイトにでも\nアップするんですか？"},
        { "location": "408/TALK"    , "narrator": "みやび", "text": "そのつもりちや。"},
        { "location": "409/TALK"    , "narrator": "みやび", "text": "まあ、初めてやき、\nダウンロード数は期待\nできんやろうけんどな。"},
        { "location": "411/TALK"    , "narrator": "繭", "text": "…帰ったら、絶対に\nダウンロードしないと！"},
        { "location": "413/TALK"    , "narrator": "雛", "text": "今夜中にステージ１\nくらいはクリアしたいな。"},
        { "location": "414/TALK"    , "narrator": "キリト", "text": "シューティングは苦手じゃ\nねぇってこと、証明して\nやるぜ！"},
        { "location": "234/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月23日　11:41 AM</color>\nとある休日の昼頃、神楽坂トライナリー劇場でのバイト中のこと。"}
    ]
}
