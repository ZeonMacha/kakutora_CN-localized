        "title": "スペシャルエピソード",
        "sub_title": "至福の眺め"
    },
    "entry":
    [
        { "location": "18/TALK" , "narrator": "透明アーヤ", "text": "ふふっ、よく寝てる。"},
        { "location": "19/TALK" , "narrator": "透明アーヤ", "text": "やっぱり、\n疲れが溜まってたの\nかしら？"},
        { "location": "20/TALK" , "narrator": "透明アーヤ", "text": "…………。"},
        { "location": "21/TALK" , "narrator": "透明アーヤ", "text": "せっかくの\nデートなのに…。"},
        { "location": "22/TALK" , "narrator": "透明アーヤ", "text": "…………。"},
        { "location": "23/TALK" , "narrator": "透明アーヤ", "text": "でもまあ、\nこれも悪くないけど…。"},
        { "location": "24/TALK" , "narrator": "透明アーヤ", "text": "…あら？"},
        { "location": "30/TALK" , "narrator": "透明アーヤ", "text": "ごめんなさい、\n起こしちゃった？"},
        { "location": "33/SEL"  , "narrator": "（選択肢）", "text": "え？　どういう状況？"},
        { "location": "34/ACT"  , "narrator": "", "text": "え？　どういう状況？"},
        { "location": "36/TALK" , "narrator": "透明アーヤ", "text": "覚えてない？"},
        { "location": "37/TALK" , "narrator": "透明アーヤ", "text": "公園でデートしてたら、\n疲れたって言うから\nベンチに座ったの。"},
        { "location": "38/TALK" , "narrator": "透明アーヤ", "text": "そしたら$handle$、\nそのまま寝落ち\nしちゃったのよ？"},
        { "location": "39/TALK" , "narrator": "透明アーヤ", "text": "本当、ビックリした…。\nでも、とっても疲れてた\nみたいね。"},
        { "location": "40/SEL"  , "narrator": "（選択肢）", "text": "ごめん"},
        { "location": "41/ACT"  , "narrator": "", "text": "ごめん"},
        { "location": "43/TALK" , "narrator": "透明アーヤ", "text": "謝らなくていいから、\nもう少しそのままで\nいた方がいいわ。"},
        { "location": "44/TALK" , "narrator": "透明アーヤ", "text": "休める時は休む。\nじゃなきゃ、\n身体が持たないわ。"},
        { "location": "45/SEL"  , "narrator": "（選択肢）", "text": "ていうか、これ、膝枕？"},
        { "location": "46/ACT"  , "narrator": "", "text": "ていうか、これ、膝枕？"},
        { "location": "49/TALK" , "narrator": "透明アーヤ", "text": "あっ…わ、私がしようと\n思ったわけじゃないのよ！"},
        { "location": "50/TALK" , "narrator": "透明アーヤ", "text": "隣で寝てた$handle$が、\nだんだん横になって、\n倒れてきたから…。"},
        { "location": "51/SEL"  , "narrator": "（選択肢）", "text": "良い夢見れた理由がわかった"},
        { "location": "52/SEL"  , "narrator": "（選択肢）", "text": "重かったよね、ごめんね"},
        { "location": "53/ACT"  , "narrator": "", "text": "良い夢見れた理由がわかった"},
        { "location": "55/TALK" , "narrator": "透明アーヤ", "text": "あら、私の膝枕だと\nそんないい夢見れるの？"},
        { "location": "56/SEL"  , "narrator": "（選択肢）", "text": "毎日寝たいな"},
        { "location": "57/SEL"  , "narrator": "（選択肢）", "text": "好きな人の膝枕だからね"},
        { "location": "58/ACT"  , "narrator": "", "text": "毎日寝たいな"},
        { "location": "60/TALK" , "narrator": "透明アーヤ", "text": "あはは…それはちょっと、\n私が大変かも…。"},
        { "location": "61/TALK" , "narrator": "透明アーヤ", "text": "でも、時々だったら\nいいかな？"},
        { "location": "62/ACT"  , "narrator": "", "text": "好きな人の膝枕だからね"},
        { "location": "66/TALK" , "narrator": "透明アーヤ", "text": "えぇっ！？"},
        { "location": "67/TALK" , "narrator": "透明アーヤ", "text": "…………。"},
        { "location": "68/TALK" , "narrator": "透明アーヤ", "text": "そ、そうやって\n突然恥ずかしいこと\n言ったらダメよ。"},
        { "location": "69/TALK" , "narrator": "透明アーヤ", "text": "言われた方は驚いて、\nどう反応したらいいか\nわからないんだから…。"},
        { "location": "70/TALK" , "narrator": "透明アーヤ", "text": "あ、でも別に\n怒ってるわけじゃ\nないから！？"},
        { "location": "71/TALK" , "narrator": "透明アーヤ", "text": "ただ、ビックリし過ぎて\n変なこと言っちゃうかも\nしれないでしょ…？"},
        { "location": "72/SEL"  , "narrator": "（選択肢）", "text": "カワイイね、見てみたいな"},
        { "location": "73/ACT"  , "narrator": "", "text": "カワイイね、見てみたいな"},
        { "location": "76/TALK" , "narrator": "透明アーヤ", "text": "こ、こっちは\n恥ずかしいだけよ…。"},
        { "location": "77/TALK" , "narrator": "透明アーヤ", "text": "…それに、見てみたいも\n何も…今見てるじゃない。"},
        { "location": "78/TALK" , "narrator": "透明アーヤ", "text": "…ああ、ほら！\nやっぱり変なこと\n言っちゃってる…。"},
        { "location": "80/ACT"  , "narrator": "", "text": "重かったよね、ごめんね"},
        { "location": "83/TALK" , "narrator": "透明アーヤ", "text": "あ、ううん。\nそんなことないから。"},
        { "location": "84/TALK" , "narrator": "透明アーヤ", "text": "膝枕は地元にいた頃、\n時々やってたし。\n慣れてるのよ。"},
        { "location": "85/SEL"  , "narrator": "（選択肢）", "text": "どういうこと！？"},
        { "location": "86/SEL"  , "narrator": "（選択肢）", "text": "膝枕のプロだね"},
        { "location": "87/ACT"  , "narrator": "", "text": "どういうこと！？"},
        { "location": "88/TALK" , "narrator": "透明アーヤ", "text": "ふふっ…部活の後輩とか\n友達がふざけて、\n時々枕にしてたのよ。"},
        { "location": "89/TALK" , "narrator": "透明アーヤ", "text": "彼氏いないから\n気分だけでも恋人感覚\n味わいたい、って…。"},
        { "location": "90/TALK" , "narrator": "透明アーヤ", "text": "ふふっ、安心した？"},
        { "location": "91/SEL"  , "narrator": "（選択肢）", "text": "安心したけど、悔しい…"},
        { "location": "92/ACT"  , "narrator": "", "text": "安心したけど、悔しい…"},
        { "location": "95/TALK" , "narrator": "透明アーヤ", "text": "もぅ、そんな悔しがる\nことじゃないでしょ？"},
        { "location": "96/TALK" , "narrator": "透明アーヤ", "text": "それに…男の人は\n$handle$が初めて\nなんだし…。"},
        { "location": "97/TALK" , "narrator": "透明アーヤ", "text": "なんてね。"},
        { "location": "98/ACT"  , "narrator": "", "text": "膝枕のプロだね"},
        { "location": "101/TALK", "narrator": "透明アーヤ", "text": "あ、あはは…、\n反応に困るわね、それ…。"},
        { "location": "105/TALK", "narrator": "透明アーヤ", "text": "はぁ…それにしても、\nせっかくのデートなのに、\n公園だけで終わりそうね。"},
        { "location": "106/TALK", "narrator": "透明アーヤ", "text": "本当は、もっと色んなとこ\n行きたかったんだけど…。"},
        { "location": "107/TALK", "narrator": "透明アーヤ", "text": "…………。"},
        { "location": "109/TALK", "narrator": "透明アーヤ", "text": "まあ、こういう\nのんびりしたデートも、\n楽しくていいかな？"},
        { "location": "111/TALK", "narrator": "透明アーヤ", "text": "好きな人の寝顔も\n見れたわけだしね、\nふふっ…。"},
        { "location": "126/SEL" , "narrator": "（選択肢）", "text": "こんなデートをしたいんだ！"},
        { "location": "127/ACT" , "narrator": "", "text": "こんなデートをしたいんだ！"},
        { "location": "129/TALK", "narrator": "アーヤ", "text": "いや"},
        { "location": "130/TALK", "narrator": "アーヤ", "text": "あのね(-ω-;)"},
        { "location": "131/TALK", "narrator": "アーヤ", "text": "したい気持ちはわかった"},
        { "location": "132/TALK", "narrator": "アーヤ", "text": "けど"},
        { "location": "133/TALK", "narrator": "アーヤ", "text": "私こんなこと言わないし！(>_<)"},
        { "location": "135/SEL" , "narrator": "（選択肢）", "text": "デートなのに！？"},
        { "location": "136/ACT" , "narrator": "", "text": "デートなのに！？"},
        { "location": "138/TALK", "narrator": "アーヤ", "text": "デートだけど"},
        { "location": "139/TALK", "narrator": "アーヤ", "text": "好きな人の寝顔も見れたわけだし、ふふっ…"},
        { "location": "140/TALK", "narrator": "アーヤ", "text": "なんて絶対言わない！（｀皿´ )"},
        { "location": "141/TALK", "narrator": "アーヤ", "text": "まったく"},
        { "location": "143/TALK", "narrator": "アーヤ", "text": "妄想はほどほどにね？( ・_・)σﾞ"}
    ]
}
