{
    "dir": "tutorial/tutorial_04.js",
    "type": "MainStory",
    "info": {
        "story_id": "5",
        "cid": "all",
        "title": "004 チュートリアル　STEP 4",
        "sub_title": "接続開始"
    },
    "entry":
    [
        { "location": "1463/SCENARIO", "narrator": "", "text": "チュートリアル_冒頭終わり"},
        { "location": "1473/TALK"    , "narrator": "千羽鶴", "text": "驚いた。"},
        { "location": "1474/TALK"    , "narrator": "千羽鶴", "text": "ベタなセリフだけど、\nあなたには素質がある\nと思う。"},
        { "location": "1475/TALK"    , "narrator": "千羽鶴", "text": "もっと手間がかかると\n思っていたのに、\n一発で倒すなんて。"},
        { "location": "1476/TALK"    , "narrator": "千羽鶴", "text": "心を操作するプロ\nといったところかしら。"},
        { "location": "1477/SEL"     , "narrator": "", "text": "どういたしまして"},
        { "location": "1478/SEL"     , "narrator": "", "text": "お礼のチューは？"},
        { "location": "1479/ACT"     , "narrator": "", "text": "どういたしまして"},
        { "location": "1480/TALK"    , "narrator": "千羽鶴", "text": "そんなあなたに、\n協力してもらえるなら\n私も心強い。"},
        { "location": "1481/ACT"     , "narrator": "", "text": "お礼のチューは？"},
        { "location": "1483/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1484/TALK"    , "narrator": "千羽鶴", "text": "現実で同じシチュエー\nションに遭遇したとき、\n同じこと言える？"},
        { "location": "1487/TALK"    , "narrator": "千羽鶴", "text": "あなたが好きな子\n「すごいわ！　邪神を\n一発で倒すなんて！」"},
        { "location": "1490/TALK"    , "narrator": "千羽鶴", "text": "あなた\n「お礼にちゅーして」"},
        { "location": "1492/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1493/TALK"    , "narrator": "千羽鶴", "text": "……無理じゃない？"},
        { "location": "1494/TALK"    , "narrator": "千羽鶴", "text": "現実で無理なことは\n[この世界]でも\nやらない方がいい。"},
        { "location": "1495/TALK"    , "narrator": "千羽鶴", "text": "そんな話はさておき。"},
        { "location": "1497/TALK"    , "narrator": "千羽鶴", "text": "攻略対象の精神世界\nでは、戦い方によって\n様々な宝物が手に入る。"},
        { "location": "1498/TALK"    , "narrator": "千羽鶴", "text": "その宝物は、その子との\n仲を進展させるものなの\nだけど――"},
        { "location": "1499/TALK"    , "narrator": "千羽鶴", "text": "あなたなら簡単に\n沢山の宝物をゲット\nしてしまいそうね。"},
        { "location": "1505/TALK"    , "narrator": "千羽鶴", "text": "さて、これで私から\n貴方に伝えることは\n以上おしまい。"},
        { "location": "1506/TALK"    , "narrator": "千羽鶴", "text": "というわけで、いよいよ\nここからは、貴方が自分\nで彼女と接していく。"},
        { "location": "1507/TALK"    , "narrator": "千羽鶴", "text": "後はあなたの自由。"},
        { "location": "1508/TALK"    , "narrator": "千羽鶴", "text": "好きな子だけ\n愛でるもよし。"},
        { "location": "1509/TALK"    , "narrator": "千羽鶴", "text": "全員と\nラブラブするもよし。"},
        { "location": "1510/TALK"    , "narrator": "千羽鶴", "text": "最後に、\n何か質問があれば。"},
        { "location": "1512/SEL"     , "narrator": "", "text": "お気に入りの子だけやりたい！"},
        { "location": "1513/SEL"     , "narrator": "", "text": "攻略対象の中に千羽鶴ちゃんはいますか？"},
        { "location": "1514/SEL"     , "narrator": "", "text": "特にない\n<color=blue>（※先へ進みます）</color>"},
        { "location": "1515/ACT"     , "narrator": "", "text": "お気に入りの子だけやりたい！"},
        { "location": "1516/TALK"    , "narrator": "千羽鶴", "text": "どうぞどうぞ。"},
        { "location": "1517/TALK"    , "narrator": "千羽鶴", "text": "けど、できれば最初だけ\nでも、一度は全員を\nサポートしてみて欲しい。"},
        { "location": "1518/TALK"    , "narrator": "千羽鶴", "text": "もしかすると、新しい\n発見があって、意外と\n好きになっちゃったり！"},
        { "location": "1519/TALK"    , "narrator": "千羽鶴", "text": "…とまあ、\nそんなことも\nあるかもしれない。"},
        { "location": "1520/TALK"    , "narrator": "千羽鶴", "text": "彼女たちは\n一言では説明できない\n様々な面を持ってる。"},
        { "location": "1521/TALK"    , "narrator": "千羽鶴", "text": "最初は興味無くても\nだんだん彼女の魅力が\n見えてくるかもしれない。"},
        { "location": "1522/TALK"    , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "1524/ACT"     , "narrator": "", "text": "攻略対象の中に千羽鶴ちゃんはいますか？"},
        { "location": "1525/TALK"    , "narrator": "千羽鶴", "text": "いません。"},
        { "location": "1526/TALK"    , "narrator": "千羽鶴", "text": "いい加減覚えましょう。"},
        { "location": "1527/TALK"    , "narrator": "千羽鶴", "text": "私は非攻略対象。\n私は非攻略対象。\n私は非攻略対象。"},
        { "location": "1528/TALK"    , "narrator": "千羽鶴", "text": "私は非攻略対象！\n私は非攻略対象！\n私は非攻略対象！"},
        { "location": "1529/TALK"    , "narrator": "千羽鶴", "text": "覚えた？"},
        { "location": "1530/TALK"    , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "1532/ACT"     , "narrator": "", "text": "特にない\n<color=blue>（※先へ進みます）</color>"},
        { "location": "1533/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1535/TALK"    , "narrator": "千羽鶴", "text": "それじゃこれで\n私からの説明は\nだいたい終わり。"},
        { "location": "1536/TALK"    , "narrator": "千羽鶴", "text": "最後に私からの\nささやかなプレゼント\nとして――"},
        { "location": "1537/TALK"    , "narrator": "千羽鶴", "text": "１０連ガチャを１回\nフリーで回せるように\nしておいた。"},
        { "location": "1538/TALK"    , "narrator": "千羽鶴", "text": "ガチャではバトルで\n活躍するクランたちを\nゲットできる。"},
        { "location": "1539/TALK"    , "narrator": "千羽鶴", "text": "さっきのバトルでは\n私の所持する強力な\nクランがいたけど――"},
        { "location": "1540/TALK"    , "narrator": "千羽鶴", "text": "ここから先は、貴方が\n自分でクランを集めて\n育てていくことになる。"},
        { "location": "1541/TALK"    , "narrator": "千羽鶴", "text": "彼女たちのために、\nどうか強力なクランを\n沢山ゲットして欲しい。"}
    ]
}
