        "title": "001 アニメーション",
        "sub_title": "綾水たちの沈黙"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第37話"},
        { "location": "53/TALK"   , "narrator": "エリカ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "54/TALK"   , "narrator": "エリカ", "text": "今回は、\nどのチャンネルでも\n伝えたいことは同じ。"},
        { "location": "55/TALK"   , "narrator": "エリカ", "text": "それでも、\nもう一度お話を\n聞きたい？"},
        { "location": "57/TALK"   , "narrator": "エリカ", "text": "それとも、一刻も早く\nつばめちゃんに\nアクセスする？"},
        { "location": "59/TALK"   , "narrator": "エリカ", "text": "それとも、一刻も早く\n綾ちゃんにアクセスする？"},
        { "location": "61/TALK"   , "narrator": "エリカ", "text": "それとも、一刻も早く\nガブリエラちゃんに\nアクセスする？"},
        { "location": "63/TALK"   , "narrator": "エリカ", "text": "それとも、一刻も早く\nみやびちゃんに\nアクセスする？"},
        { "location": "66/SEL"    , "narrator": "", "text": "もう一度話を聞く"},
        { "location": "67/SEL"    , "narrator": "", "text": "省略する"},
        { "location": "68/ACT"    , "narrator": "", "text": "もう一度話を聞く"},
        { "location": "69/TALK"   , "narrator": "エリカ", "text": "わかった。\nそれじゃ、少しだけ\n巻き戻しするね？"},
        { "location": "71/ACT"    , "narrator": "", "text": "省略する"},
        { "location": "72/TALK"   , "narrator": "エリカ", "text": "わかった。\nそれじゃ、\nよろしくお願いします。"},
        { "location": "78/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "79/SEL"    , "narrator": "", "text": "お久し振りです"},
        { "location": "80/SEL"    , "narrator": "", "text": "ひゃー！　幽霊デター！！"},
        { "location": "81/SEL"    , "narrator": "", "text": "寂しかったよ！！"},
        { "location": "82/ACT"    , "narrator": "", "text": "お久し振りです"},
        { "location": "83/TALK"   , "narrator": "エリカ", "text": "ほんと、\n久し振りに\nなっちゃったね。"},
        { "location": "84/ACT"    , "narrator": "", "text": "ひゃー！　幽霊デター！！"},
        { "location": "85/TALK"   , "narrator": "エリカ", "text": "失礼だなぁ。\n幽霊じゃありませんよ？"},
        { "location": "86/SEL"    , "narrator": "", "text": "でもアーヤのチャンネルで…"},
        { "location": "87/ACT"    , "narrator": "", "text": "でもアーヤのチャンネルで…"},
        { "location": "89/TALK"   , "narrator": "エリカ", "text": "過去のお話を\n見ちゃったんだね。"},
        { "location": "90/TALK"   , "narrator": "エリカ", "text": "でも本当に、\nわたしは死んでないから\n心配しないで？"},
        { "location": "91/TALK"   , "narrator": "エリカ", "text": "フェノメノンの外の\n現実では、わたしは\nそうするしかなかったの。"},
        { "location": "92/ACT"    , "narrator": "", "text": "寂しかったよ！！"},
        { "location": "93/TALK"   , "narrator": "エリカ", "text": "えへへ、\nありがとう。"},
        { "location": "94/TALK"   , "narrator": "エリカ", "text": "実はわたしも\n寂しかったんだ。"},
        { "location": "95/TALK"   , "narrator": "エリカ", "text": "おあいこだね！"},
        { "location": "97/TALK"   , "narrator": "エリカ", "text": "って、そんなことより\n急がなくちゃいけない\nことがあるの。"},
        { "location": "98/TALK"   , "narrator": "エリカ", "text": "ソイルトンから\n色々聞いてるかも\nしれないけど――"},
        { "location": "99/TALK"   , "narrator": "エリカ", "text": "“彼ら”が\n今の日本をどうするか、\n結論を出したの。"},
        { "location": "100/TALK"  , "narrator": "エリカ", "text": "その答えは“CC”。\nすなわち“条件付閉鎖”。"},
        { "location": "101/SEL"   , "narrator": "", "text": "フェノメノン消されるの！？"},
        { "location": "102/SEL"   , "narrator": "", "text": "何その意味深な閉鎖"},
        { "location": "103/SEL"   , "narrator": "", "text": "サービス終了なの！？"},
        { "location": "104/ACT"   , "narrator": "", "text": "フェノメノン消されるの！？"},
        { "location": "105/TALK"  , "narrator": "エリカ", "text": "そういうことになるね。"},
        { "location": "106/TALK"  , "narrator": "エリカ", "text": "それでね、\nわたしが急いでる理由は、\n“条件付”というところ。"},
        { "location": "107/ACT"   , "narrator": "", "text": "フェノメノン消されるの！？"},
        { "location": "108/TALK"  , "narrator": "エリカ", "text": "うん。\nそこが大事なの。"},
        { "location": "109/TALK"  , "narrator": "エリカ", "text": "わたしが急いでる理由は、\nまさにその“条件付”と\nいうところ。"},
        { "location": "110/ACT"   , "narrator": "", "text": "サービス終了なの！？"},
        { "location": "111/TALK"  , "narrator": "エリカ", "text": "サービス？"},
        { "location": "112/TALK"  , "narrator": "エリカ", "text": "あなたとわたしたちを\n繋ぐ回線が終了するかって\nことかな。"},
        { "location": "113/TALK"  , "narrator": "エリカ", "text": "もしそうなら、\nそれも恐らくは\nYESだと思う。"},
        { "location": "114/TALK"  , "narrator": "エリカ", "text": "今のあなたとの回線は、\nつばめちゃんの松果体を\n媒介してるし――"},
        { "location": "115/TALK"  , "narrator": "エリカ", "text": "OSとしては残るかもだけど\n綾ちゃんたちのチャンネル\nは切れると思う。"},
        { "location": "116/TALK"  , "narrator": "エリカ", "text": "それでね、\nわたしが急いでる理由は、\n“条件付”というところ。"},
        { "location": "118/TALK"  , "narrator": "エリカ", "text": "“彼ら”は、あなたと\nゲームをしたいって。\nそれが条件だって。"},
        { "location": "119/SEL"   , "narrator": "", "text": "ゲーム……？"},
        { "location": "120/ACT"   , "narrator": "", "text": "ゲーム……？"},
        { "location": "122/TALK"  , "narrator": "エリカ", "text": "そう。"},
        { "location": "123/SEL"   , "narrator": "", "text": "どんなゲームなの？"},
        { "location": "124/ACT"   , "narrator": "", "text": "どんなゲームなの？"},
        { "location": "126/TALK"  , "narrator": "エリカ", "text": "それが、\nわからないの。"},
        { "location": "127/TALK"  , "narrator": "エリカ", "text": "“彼ら”から届いている\nメッセージはそれだけで。"},
        { "location": "128/TALK"  , "narrator": "エリカ", "text": "そのゲームにあなたが\n勝つことが、フェノメノン\n継続の条件になるって。"},
        { "location": "129/SEL"   , "narrator": "", "text": "前にエリカが、国連に何か言われていたけど、それとは違うの？"},
        { "location": "130/ACT"   , "narrator": "", "text": "前にエリカが、国連に何か言われていたけど、それとは違うの？"},
        { "location": "132/TALK"  , "narrator": "エリカ", "text": "あー、えっとそれは…、\n“状況を収束させなければ\n閉鎖する”ってのでしょ？"},
        { "location": "133/TALK"  , "narrator": "エリカ", "text": "わたしもそれだと\n思いたいんだけど、\n幾つか不安があって。"},
        { "location": "134/TALK"  , "narrator": "エリカ", "text": "まず、もしそれだったら\nあなたは何もしなくても\n解決できてしまうの。"},
        { "location": "135/TALK"  , "narrator": "エリカ", "text": "わたしがここに\n来れなかった期間は、\nまさにその準備をしてて。"},
        { "location": "136/TALK"  , "narrator": "エリカ", "text": "まほちゃんに、千羽鶴\nちゃんをHALTするものを\n用意していたんだ。"},
        { "location": "137/SEL"   , "narrator": "", "text": "HALTって？"},
        { "location": "138/ACT"   , "narrator": "", "text": "HALTって？"},
        { "location": "140/TALK"  , "narrator": "エリカ", "text": "えっと、一時機能停止。\n少しの間、眠っていて\nもらう感じかな。"},
        { "location": "141/TALK"  , "narrator": "エリカ", "text": "日本を包むフェノメノンは\n今、繭の外側でも\n大変なことになってる。"},
        { "location": "142/TALK"  , "narrator": "エリカ", "text": "それは、今\n千羽鶴ちゃんがやっている\n行動が原因。"},
        { "location": "143/TALK"  , "narrator": "エリカ", "text": "これについては、とにかく\n最優先で何とかしなくちゃ\nいけない。"},
        { "location": "144/TALK"  , "narrator": "エリカ", "text": "ただ、この問題は、\nわたしとまほちゃんたち\nだけで解決できるの。"},
        { "location": "145/TALK"  , "narrator": "エリカ", "text": "怖いのは、今回のゲームの\n話が、このUNの件とは\n全然違うルート――"},
        { "location": "146/TALK"  , "narrator": "エリカ", "text": "明確に言えば、“彼ら”の\n直属機関から直接私に\n届けられたこと。"},
        { "location": "147/TALK"  , "narrator": "エリカ", "text": "そして明確に、\nあなたとゲームを\nしたがってること。"},
        { "location": "148/TALK"  , "narrator": "エリカ", "text": "わたしの考えすぎ\nなのかもしれないけど、\nそれは――"},
        { "location": "149/TALK"  , "narrator": "エリカ", "text": "あなたにしかできない事を\nさせたがってるんじゃ\nないかって思うの。"},
        { "location": "150/SEL"   , "narrator": "", "text": "なんでまた、$me$なんかに……"},
        { "location": "151/SEL"   , "narrator": "", "text": "エリカ、ぱしりみたいになってるね"},
        { "location": "152/ACT"   , "narrator": "", "text": "なんでまた、$me$なんかに……"},
        { "location": "153/TALK"  , "narrator": "エリカ", "text": "それがね――"},
        { "location": "154/TALK"  , "narrator": "エリカ", "text": "“彼ら”は、あなたに\nとても興味を持ってる\nみたいで……。"},
        { "location": "155/TALK"  , "narrator": "エリカ", "text": "貴方が持つ可能性を\n見極めたいのかも\nしれない。"},
        { "location": "156/ACT"   , "narrator": "", "text": "エリカ、ぱしりみたいになってるね"},
        { "location": "157/TALK"  , "narrator": "エリカ", "text": "ほんとだよね。\nこれじゃ“彼ら”の\n伝令役みたい。"},
        { "location": "158/TALK"  , "narrator": "エリカ", "text": "こんな筈じゃ\nなかったんだけど……"},
        { "location": "159/TALK"  , "narrator": "エリカ", "text": "私がいろいろ力不足だった\nせいで、ごめんなさい。"},
        { "location": "160/TALK"  , "narrator": "エリカ", "text": "やっぱり研究者は\n研究にだけ没頭してる\nべきなのかもしれない。"},
        { "location": "161/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "162/TALK"  , "narrator": "エリカ", "text": "もう何も信じられないかも\nしれないけど、これだけは\n正直な気持ちです。"},
        { "location": "163/TALK"  , "narrator": "エリカ", "text": "いま、わたしは\nあなたにこの事を伝えて、\n信じるしかない状況です。"},
        { "location": "164/TALK"  , "narrator": "エリカ", "text": "つばめちゃんの世界を\n存続させるには、彼らとの\nゲームをせざるを得ない。"},
        { "location": "166/TALK"  , "narrator": "エリカ", "text": "とにかく、\n記録映像を見てみましょ。"},
        { "location": "167/TALK"  , "narrator": "エリカ", "text": "その中に何か\n“彼ら”のいうゲームの\nヒントがあるかも。"},
        { "location": "169/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/70MB 4:29】</color>"},
        { "location": "170/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/22MB 4:29】</color>"},
        { "location": "171/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "172/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/70MB 4:29】</color>"},
        { "location": "173/TALK"  , "narrator": "エリカ", "text": "わかった。"},
        { "location": "179/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/22MB 4:29】</color>"},
        { "location": "180/TALK"  , "narrator": "エリカ", "text": "わかった。"},
        { "location": "186/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "187/TALK"  , "narrator": "エリカ", "text": "あらら。"},
        { "location": "221/TALK"  , "narrator": "エリカ", "text": "そんな……\nなにこれ。"},
        { "location": "224/SEL"   , "narrator": "", "text": "千羽鶴ーーーーーーっ！！"},
        { "location": "225/SEL"   , "narrator": "", "text": "真幌が撃っちゃったの！？"},
        { "location": "226/SEL"   , "narrator": "", "text": "破壊はしないけど殺すものでした～ってこと？"},
        { "location": "227/SEL"   , "narrator": "", "text": "真幌とは違うところから飛んでこなかった？"},
        { "location": "228/ACT"   , "narrator": "", "text": "千羽鶴ーーーーーーっ！！"},
        { "location": "231/ACT"   , "narrator": "", "text": "真幌が撃っちゃったの！？"},
        { "location": "233/ACT"   , "narrator": "", "text": "破壊はしないけど殺すものでした～ってこと？"},
        { "location": "235/ACT"   , "narrator": "", "text": "真幌とは違うところから飛んでこなかった？"},
        { "location": "239/SEL"   , "narrator": "", "text": "真幌が撃っちゃったの！？"},
        { "location": "240/SEL"   , "narrator": "", "text": "破壊はしないけど殺すものでした～ってこと？"},
        { "location": "241/SEL"   , "narrator": "", "text": "真幌とは違うところから飛んでこなかった？"},
        { "location": "242/ACT"   , "narrator": "", "text": "真幌が撃っちゃったの！？"},
        { "location": "244/ACT"   , "narrator": "", "text": "破壊はしないけど殺すものでした～ってこと？"},
        { "location": "246/ACT"   , "narrator": "", "text": "真幌とは違うところから飛んでこなかった？"},
        { "location": "252/TALK"  , "narrator": "エリカ", "text": "お、落ち着いて！\n落ち着いてってば！"},
        { "location": "253/SEL"   , "narrator": "", "text": "千羽鶴は死んだの！？"},
        { "location": "254/SEL"   , "narrator": "", "text": "エリカが殺したんだ！！"},
        { "location": "255/ACT"   , "narrator": "", "text": "千羽鶴は死んだの！？"},
        { "location": "256/TALK"  , "narrator": "エリカ", "text": "大丈夫、だと思うから、\nまだ今ならまだ！！"},
        { "location": "257/SEL"   , "narrator": "", "text": "どうしてこんなことに…"},
        { "location": "258/ACT"   , "narrator": "", "text": "どうしてこんなことに…"},
        { "location": "260/TALK"  , "narrator": "エリカ", "text": "まほちゃんとは\n違うところから、\n弾が飛んできているの。"},
        { "location": "261/ACT"   , "narrator": "", "text": "エリカが殺したんだ！！"},
        { "location": "262/TALK"  , "narrator": "エリカ", "text": "わたしじゃないよ！\nまほちゃんはまだ\n撃ってもいないし――"},
        { "location": "263/TALK"  , "narrator": "エリカ", "text": "それに、わたしは\n千羽鶴ちゃんを壊す武器は\n渡してないから。"},
        { "location": "264/TALK"  , "narrator": "エリカ", "text": "よく見て？\n全然違うところから\n弾が飛んできてる。"},
        { "location": "268/TALK"  , "narrator": "エリカ", "text": "まほちゃんが\n撃ったんじゃないよ。"},
        { "location": "269/TALK"  , "narrator": "エリカ", "text": "よく見て？\n全然違うところから\n弾が飛んできてる。"},
        { "location": "272/TALK"  , "narrator": "エリカ", "text": "違うよ！！"},
        { "location": "273/TALK"  , "narrator": "エリカ", "text": "そもそも、\nそんな物騒なもの\n渡してないもの。"},
        { "location": "274/TALK"  , "narrator": "エリカ", "text": "それに、\nまほちゃんは\n撃ってないよ。"},
        { "location": "275/TALK"  , "narrator": "エリカ", "text": "よく見て？\n全然違うところから\n弾が飛んできてる。"},
        { "location": "278/TALK"  , "narrator": "エリカ", "text": "そうなの。\n全然違うところから\n弾が飛んできてる。"},
        { "location": "280/SEL"   , "narrator": "", "text": "刺客？"},
        { "location": "281/ACT"   , "narrator": "", "text": "刺客？"},
        { "location": "283/TALK"  , "narrator": "エリカ", "text": "たぶんそうだと思う。"},
        { "location": "284/TALK"  , "narrator": "エリカ", "text": "そして恐らく、これが\n“彼ら”のいうゲーム\nなんだと思うの。"},
        { "location": "285/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんは\n本当に壊されてる。"},
        { "location": "286/TALK"  , "narrator": "エリカ", "text": "現実とココロが切り\n離されて、フェノメノンが\n消滅し始めてるの。"},
        { "location": "287/SEL"   , "narrator": "", "text": "それってゲームじゃなくてゲームオーバーじゃん！"},
        { "location": "288/ACT"   , "narrator": "", "text": "それってゲームじゃなくてゲームオーバーじゃん！"},
        { "location": "290/TALK"  , "narrator": "エリカ", "text": "……ううん。\nまだゲームオーバーじゃ\nない。"},
        { "location": "291/TALK"  , "narrator": "エリカ", "text": "フェノメノンの収束には\nタイムラグがあるの。"},
        { "location": "292/TALK"  , "narrator": "エリカ", "text": "巻き込まれた人達が\n徐々に我を取り戻して\nいくまでの時間――"},
        { "location": "293/TALK"  , "narrator": "エリカ", "text": "あなたが今まで見て来た\nフェノメノンでは、それは\n数秒だったけど。"},
        { "location": "294/TALK"  , "narrator": "エリカ", "text": "日本全体を包む大きさに\nなれば、数時間はかかる。"},
        { "location": "295/TALK"  , "narrator": "エリカ", "text": "それと、つばめちゃんの\nフェノメノンが持つ、\nもう1つの特殊な事情。"},
        { "location": "296/TALK"  , "narrator": "エリカ", "text": "それは、発症クランである\n千羽鶴以外にも、影響力を\n持つ存在がいること。"},
        { "location": "297/SEL"   , "narrator": "", "text": "つばめ自身ってことか"},
        { "location": "298/SEL"   , "narrator": "", "text": "カレンとか？"},
        { "location": "299/ACT"   , "narrator": "", "text": "つばめ自身ってことか"},
        { "location": "300/TALK"  , "narrator": "エリカ", "text": "そう。"},
        { "location": "302/ACT"   , "narrator": "", "text": "カレンとか？"},
        { "location": "303/TALK"  , "narrator": "エリカ", "text": "結果的には\nそうともいえるかも\nしれない。"},
        { "location": "304/TALK"  , "narrator": "エリカ", "text": "厳密にいえば、\nフェノメノンの中にいる\nつばめちゃんそのもの。"},
        { "location": "306/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんを生み出して\n分離した後もなお、\nその理想を牽制した存在。"},
        { "location": "307/TALK"  , "narrator": "エリカ", "text": "千羽鶴は、セルフクラン\nとはいえ、つばめちゃんの\n一人格に過ぎない。"},
        { "location": "308/TALK"  , "narrator": "エリカ", "text": "だから、つばめちゃんの\n別の人格に役割を引き\n継げば、存続は可能なの。"},
        { "location": "309/TALK"  , "narrator": "エリカ", "text": "……論理的には、だけど。"},
        { "location": "310/SEL"   , "narrator": "", "text": "論理的には？"},
        { "location": "311/ACT"   , "narrator": "", "text": "論理的には？"},
        { "location": "313/TALK"  , "narrator": "エリカ", "text": "ただ、別の人格に\nセルフである千羽鶴と\n同じだけの力があるか……"},
        { "location": "314/TALK"  , "narrator": "エリカ", "text": "それ以前に、\nその想いを引き継ぐ\n意志を持てるか。"},
        { "location": "315/SEL"   , "narrator": "", "text": "エリカ？？"},
        { "location": "316/ACT"   , "narrator": "", "text": "エリカ？？"},
        { "location": "318/TALK"  , "narrator": "エリカ", "text": "もし無理だったら、\n他にはどんな回避の\n可能性が――"},
        { "location": "319/SEL"   , "narrator": "", "text": "おーーーーい！！"},
        { "location": "320/ACT"   , "narrator": "", "text": "おーーーーい！！"},
        { "location": "322/TALK"  , "narrator": "エリカ", "text": "ああっ！\nご、ごめんなさい！"},
        { "location": "323/TALK"  , "narrator": "エリカ", "text": "一人で勝手に\n考え込んじゃって。"},
        { "location": "324/TALK"  , "narrator": "エリカ", "text": "わたし、今からちょっと\n千羽鶴ちゃんと\nコンタクトをとってみる。"},
        { "location": "325/SEL"   , "narrator": "", "text": "千羽鶴はまだ生きてるの！？"},
        { "location": "326/SEL"   , "narrator": "", "text": "千羽鶴とは敵対していたんじゃないの？"},
        { "location": "327/ACT"   , "narrator": "", "text": "千羽鶴はまだ生きてるの！？"},
        { "location": "328/TALK"  , "narrator": "エリカ", "text": "フェノメノンと同じ\nように、瞬間的には\n消えたりしないの。"},
        { "location": "329/TALK"  , "narrator": "エリカ", "text": "つばめちゃんの心の中で、\nゆっくりと薄らいでいく。"},
        { "location": "330/TALK"  , "narrator": "エリカ", "text": "それでもフェノメノンの\n収束よりは早いけど。"},
        { "location": "331/ACT"   , "narrator": "", "text": "千羽鶴とは敵対していたんじゃないの？"},
        { "location": "332/TALK"  , "narrator": "エリカ", "text": "そんなこと言ってる\n場合じゃないよ！"},
        { "location": "333/TALK"  , "narrator": "エリカ", "text": "もちろん、わたしは\n千羽鶴ちゃんから\n隠れている身だよ。"},
        { "location": "334/TALK"  , "narrator": "エリカ", "text": "けどそれは、単に方針の\n相違によって、互いに\n牽制し合っていたからで。"},
        { "location": "335/TALK"  , "narrator": "エリカ", "text": "そもそも、ここで\nフェノメノンが収束したら\nそれこそ彼らの思うつぼ。"},
        { "location": "336/TALK"  , "narrator": "エリカ", "text": "私と千羽鶴ちゃんが\nもっとも恐れていた\n未来が訪れてしまう。"},
        { "location": "337/TALK"  , "narrator": "エリカ", "text": "もちろん、彼女に身バレ\nしたら、解決後にまた\n追われるかもしれない。"},
        { "location": "338/TALK"  , "narrator": "エリカ", "text": "けど、今はそれより\nこの世界を維持すること\nこそが最優先だよ"},
        { "location": "340/TALK"  , "narrator": "エリカ", "text": "彼女に今の状況を聞けば、\n最善の方法を選択できる\nかもしれない。"},
        { "location": "341/TALK"  , "narrator": "エリカ", "text": "あなたにはいつも通り、\nチャンネルから彼女たちの\n所に行ってもらうけど――"},
        { "location": "342/TALK"  , "narrator": "エリカ", "text": "アクセスする頃には\n何らかの解を出しておける\nように頑張るよ。"},
        { "location": "343/TALK"  , "narrator": "エリカ", "text": "それじゃ、わたしは\n千羽鶴ちゃんの所へ\n行くね。"},
        { "location": "344/SEL"   , "narrator": "", "text": "エリカ"},
        { "location": "345/ACT"   , "narrator": "", "text": "エリカ"},
        { "location": "347/TALK"  , "narrator": "エリカ", "text": "…ん？"},
        { "location": "349/SEL"   , "narrator": "", "text": "千羽鶴に「絶対死ぬな」って伝えて欲しい"},
        { "location": "350/SEL"   , "narrator": "", "text": "お互い頑張ろう！"},
        { "location": "351/SEL"   , "narrator": "", "text": "どうしてそこまで答えを知ってるの？"},
        { "location": "352/SEL"   , "narrator": "", "text": "実は、$me$はつばめのフェノメノンが収束した方がいいと思ってる"},
        { "location": "353/ACT"   , "narrator": "", "text": "千羽鶴に「絶対死ぬな」って伝えて欲しい"},
        { "location": "355/ACT"   , "narrator": "", "text": "お互い頑張ろう！"},
        { "location": "357/ACT"   , "narrator": "", "text": "どうしてそこまで答えを知ってるの？"},
        { "location": "359/ACT"   , "narrator": "", "text": "実は、$me$はつばめのフェノメノンが収束した方がいいと思ってる"},
        { "location": "363/SEL"   , "narrator": "", "text": "お互い頑張ろう！"},
        { "location": "364/SEL"   , "narrator": "", "text": "どうしてそこまで答えを知ってるの？"},
        { "location": "365/SEL"   , "narrator": "", "text": "実は、$me$はつばめのフェノメノンが収束した方がいいと思ってる"},
        { "location": "366/ACT"   , "narrator": "", "text": "お互い頑張ろう！"},
        { "location": "368/ACT"   , "narrator": "", "text": "どうしてそこまで答えを知ってるの？"},
        { "location": "370/ACT"   , "narrator": "", "text": "実は、$me$はつばめのフェノメノンが収束した方がいいと思ってる"},
        { "location": "378/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "379/TALK"  , "narrator": "エリカ", "text": "……うん。\nちゃんと伝えるよ。"},
        { "location": "380/TALK"  , "narrator": "エリカ", "text": "$handle$さん。"},
        { "location": "381/TALK"  , "narrator": "エリカ", "text": "どうか、この世界を――"},
        { "location": "382/TALK"  , "narrator": "エリカ", "text": "彼女たちを――"},
        { "location": "383/TALK"  , "narrator": "エリカ", "text": "よろしくお願いします。"},
        { "location": "387/TALK"  , "narrator": "エリカ", "text": "……うん。\nありがとう。"},
        { "location": "388/TALK"  , "narrator": "エリカ", "text": "$handle$さん。"},
        { "location": "389/TALK"  , "narrator": "エリカ", "text": "どうか、この世界を――"},
        { "location": "390/TALK"  , "narrator": "エリカ", "text": "彼女たちを――"},
        { "location": "391/TALK"  , "narrator": "エリカ", "text": "よろしくお願いします。"},
        { "location": "395/TALK"  , "narrator": "エリカ", "text": "わたしは\n科学者だから。"},
        { "location": "396/TALK"  , "narrator": "エリカ", "text": "政治や人の心を動かす事は\n全然ダメだけど、こういう\n事なら答えを出せる。"},
        { "location": "397/TALK"  , "narrator": "エリカ", "text": "ましてや、フェノメノンは\nわたしにとっては――"},
        { "location": "398/TALK"  , "narrator": "エリカ", "text": "……そっか。"},
        { "location": "399/TALK"  , "narrator": "エリカ", "text": "“彼ら”にとっては、\nきっとわたしもゲームの\nプレイヤーなんだ。"},
        { "location": "400/SEL"   , "narrator": "", "text": "どういうこと？"},
        { "location": "401/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "403/TALK"  , "narrator": "エリカ", "text": "わたしだけじゃ、\n理論立てはできても\n実際に実践はできない。"},
        { "location": "404/TALK"  , "narrator": "エリカ", "text": "あなたは、実践はできる\nけど、理論を立てる\nことはできない。"},
        { "location": "405/TALK"  , "narrator": "エリカ", "text": "それがきっと、“彼ら”が\n敢えてわたしを経由して\n“ゲーム”を伝えた理由。"},
        { "location": "406/SEL"   , "narrator": "", "text": "絶対に負けない"},
        { "location": "407/SEL"   , "narrator": "", "text": "実践って何をするの？"},
        { "location": "408/ACT"   , "narrator": "", "text": "絶対に負けない"},
        { "location": "409/TALK"  , "narrator": "エリカ", "text": "うん。\nわたしもそう思ってるよ。"},
        { "location": "410/ACT"   , "narrator": "", "text": "実践って何をするの？"},
        { "location": "411/TALK"  , "narrator": "エリカ", "text": "それは、これから\n千羽鶴ちゃんと話して\n決める。"},
        { "location": "412/TALK"  , "narrator": "エリカ", "text": "けど、どの作戦になっても\nつばめちゃんたちの\n心に作用する必要はある。"},
        { "location": "413/TALK"  , "narrator": "エリカ", "text": "そして、\nそれが可能なのは、\nあなただけなの。"},
        { "location": "414/TALK"  , "narrator": "エリカ", "text": "権限的にもそうだし、\n想いの面でも、\nきっとそう。"},
        { "location": "415/TALK"  , "narrator": "エリカ", "text": "“彼ら”は多分、あなたと\nつばめちゃんたちの想いの\n力を試したがってる。"},
        { "location": "417/TALK"  , "narrator": "エリカ", "text": "このゲームに乗ること\n自体が“彼ら”の思うつぼ\nなのかもしれない。"},
        { "location": "418/TALK"  , "narrator": "エリカ", "text": "けど、勝つことができれば\n“彼ら”にとって都合の\n悪い結果になるはず。"},
        { "location": "419/TALK"  , "narrator": "エリカ", "text": "あなたの世界には\nずっと迷惑かけっぱなし\nだけど――"},
        { "location": "420/TALK"  , "narrator": "エリカ", "text": "どうか、この世界を――"},
        { "location": "421/TALK"  , "narrator": "エリカ", "text": "彼女たちを――"},
        { "location": "422/TALK"  , "narrator": "エリカ", "text": "よろしくお願いします。"},
        { "location": "426/TALK"  , "narrator": "エリカ", "text": "あ"},
        { "location": "427/TALK"  , "narrator": "エリカ", "text": "そっか。\nそういう考え方も\nあるよね。"},
        { "location": "428/TALK"  , "narrator": "エリカ", "text": "ごめんね。あなたも\n温存したいと思ってるって\n先入観で話しちゃってた。"},
        { "location": "429/TALK"  , "narrator": "エリカ", "text": "今回の件は、\n無理に巻き込むつもりは\nないよ。"},
        { "location": "430/TALK"  , "narrator": "エリカ", "text": "ただ、わたしは絶対に\nこのフェノメノンを\n維持したい。"},
        { "location": "431/TALK"  , "narrator": "エリカ", "text": "だから、\nあなたが協力して\nくれなくても――"},
        { "location": "432/TALK"  , "narrator": "エリカ", "text": "パラメトリック理論に\n基づく世界進行法に賭けて\n祈りながら待ちます。"},
        { "location": "433/SEL"   , "narrator": "", "text": "科学者なのに神頼み？"},
        { "location": "434/ACT"   , "narrator": "", "text": "科学者なのに神頼み？"},
        { "location": "436/TALK"  , "narrator": "エリカ", "text": "確かにそうだね。\nちょっと滑稽に\n聞こえるかもしれない。"},
        { "location": "437/TALK"  , "narrator": "エリカ", "text": "でも、\n量子の世界は神の世界。"},
        { "location": "438/TALK"  , "narrator": "エリカ", "text": "量子科学が発達してくると\n科学と神様はまた、段々と\n近づいてくるんだよ？"},
        { "location": "439/TALK"  , "narrator": "エリカ", "text": "あなたも、もし気が\n変わったら、わたしの\n作戦に協力してね。"},
        { "location": "440/TALK"  , "narrator": "エリカ", "text": "いつまでも\n待ってるから。"},
        { "location": "441/TALK"  , "narrator": "エリカ", "text": "いつまでも、\nずっと――。"},
