{
    "dir": "chap16/daydra/dd_ch01_16_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "16102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "誰でもない私だから＜前編＞"
    },
    "entry":
    [
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "アプリゲームね…。"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "課金すれば\n強くなれたり\nしないのかしら。"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "そうしたら\n今回は楽勝なのにね。"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "あら、どうして？"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "だってこれは管理庁の\n任務なのよ。"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "必要予算ってことで\n一億くらい課金して\nもらえばいいのよ。"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "一気に最強モードで\n瞬殺よ、瞬殺。"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "一億も使ったら\n真幌さんに怒られるん\nじゃないかな？"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "卯月さんも、\nそう思わない？"},
        { "location": "60/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "卯月さん？"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "えっ！？　あ、はい。\nどうかしましたか？"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "あ、ううん…。\n大したことじゃないん\nだけど…。"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "…大丈夫？\nちょっと元気がない\nみたいだけど…。"},
        { "location": "69/TALK"   , "narrator": "神楽", "text": "そ、そんなこと\nないですよ。"},
        { "location": "70/TALK"   , "narrator": "神楽", "text": "ほら、いつも通り\n私は元気ですから…。"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "無理してない？\n何だか、全然元気に\n見えないんだけど…。"},
        { "location": "73/TALK"   , "narrator": "神楽", "text": "大丈夫です。\nつばめさんの\n思い過ごしですよ…。"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "…そう？\nそれならいいん\nだけど…。"},
        { "location": "76/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "…やっぱり、\nちょっと元気\nなさそう。"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "何かあったのかな？"},
        { "location": "80/TALK"   , "narrator": "透明みやび", "text": "つばめちゃん、\n聞こえちゅう？"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "あ、はい。\n聞こえて――"},
        { "location": "83/TALK"   , "narrator": "透明みやび", "text": "しっ！"},
        { "location": "84/TALK"   , "narrator": "透明みやび", "text": "プライベート通信で\n話しかけてるき、\n返事はいらんがよ。"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "86/TALK"   , "narrator": "透明みやび", "text": "今から話すことは、\n隊員の個人情報に\n関する話やき。"},
        { "location": "87/TALK"   , "narrator": "透明みやび", "text": "今はまだ、みんなには\n秘密にしておきたい\nことなんよ。"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "…なんで、そんな話を\nわたしにするんだろ？"},
        { "location": "89/TALK"   , "narrator": "透明みやび", "text": "えいか？"},
        { "location": "90/TALK"   , "narrator": "透明みやび", "text": "実は今回の\nフェノメノン。"},
        { "location": "91/TALK"   , "narrator": "透明みやび", "text": "内部に、卯月の実家を\n巻き込んどるんよ。"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "っ！？"},
        { "location": "96/TALK"   , "narrator": "透明みやび", "text": "ビックリさせて\nすまんね。"},
        { "location": "97/TALK"   , "narrator": "透明みやび", "text": "個人情報に関わるき、\n誰にも言わん方がえい\nとも思うたんよ。"},
        { "location": "98/TALK"   , "narrator": "透明みやび", "text": "けんど、それはそれで\n不安やったきね。"},
        { "location": "99/TALK"   , "narrator": "透明みやび", "text": "卯月と一番仲のいい、\nつばめちゃんにだけ\n話そうと思うたがよ。"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "そうだったんだ…。\nありがとう、\nみやびさん。"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "…帰ったら、\nちゃんとお礼\n言わないと。"},
        { "location": "102/TALK"  , "narrator": "透明みやび", "text": "大丈夫だとは\n思うけんど、\n念には念や。"},
        { "location": "103/TALK"  , "narrator": "透明みやび", "text": "卯月が無茶せんよう、\n監視頼むぞね。"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "109/TALK"  , "narrator": "つばめ", "text": "そっか…だから\n卯月さん、いつもと\n様子が違うんだ…。"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "実家がフェノメノンに\n巻き込まれてるん\nだもん。"},
        { "location": "111/TALK"  , "narrator": "つばめ", "text": "心配で、\nとっても辛いよね…。"},
        { "location": "113/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "…知ってること、\n卯月さんにだけは\n話そうかな？"},
        { "location": "116/TALK"  , "narrator": "つばめ", "text": "卯月さんが元気ない\n理由、知ってるって。"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "一人で抱えないで。\n一緒に頑張ろう、\nって…。"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "　"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "182/SEL"   , "narrator": "", "text": "新しい人？"},
        { "location": "183/ACT"   , "narrator": "", "text": "新しい人？"},
        { "location": "185/TALK"  , "narrator": "つばめ", "text": "はい。\n先日より司書に任命された\n人格です。"},
        { "location": "186/TALK"  , "narrator": "つばめ", "text": "以後よろしくお願いします。"},
        { "location": "187/SEL"   , "narrator": "", "text": "何て呼べばいい？"},
        { "location": "188/SEL"   , "narrator": "", "text": "名前教えて"},
        { "location": "189/ACT"   , "narrator": "", "text": "何て呼べばいい？"},
        { "location": "190/TALK"  , "narrator": "つばめ", "text": "普通に、\n逢瀬つばめの司書さん、で\nよくないですか？"},
        { "location": "191/ACT"   , "narrator": "", "text": "名前教えて"},
        { "location": "192/TALK"  , "narrator": "つばめ", "text": "いきなりナンパですか？\n真剣さが足りませんね。"},
        { "location": "194/TALK"  , "narrator": "つばめ", "text": "ちなみに\n先に釘を打っておきますが\n名前は教えられません。"},
        { "location": "195/SEL"   , "narrator": "", "text": "なんで？"},
        { "location": "196/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "198/TALK"  , "narrator": "つばめ", "text": "ああ、\n$handle$さんは\n知らないのですか。"},
        { "location": "199/TALK"  , "narrator": "つばめ", "text": "人格が名前を教えることは\n全てをその相手に\n捧げる事と同義なんです。"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "人格は人格同士ですら\nその名前を知りません。\nそして敢えて聞きません。"},
        { "location": "201/TALK"  , "narrator": "つばめ", "text": "なぜなら――"},
        { "location": "202/TALK"  , "narrator": "つばめ", "text": "いえ、こんな話は\nする必要ありませんね。"},
        { "location": "203/TALK"  , "narrator": "つばめ", "text": "早速仕事をしましょう。\nお互い。"},
        { "location": "211/TALK"  , "narrator": "つばめ", "text": "オープンプロセス、\n0x230番地から\n0xC51番地へ。"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "236/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "238/TALK"  , "narrator": "つばめ", "text": "……なるほど。"},
        { "location": "239/TALK"  , "narrator": "つばめ", "text": "卯月神楽の家が\n巻き込まれている件。"},
        { "location": "240/TALK"  , "narrator": "つばめ", "text": "絶対神楽本人には\n言ってはいけません。"},
        { "location": "241/TALK"  , "narrator": "つばめ", "text": "それを阻害する\nクランを破壊します。\nよいですか？"},
        { "location": "242/SEL"   , "narrator": "", "text": "オッケー"},
        { "location": "243/SEL"   , "narrator": "", "text": "えっと"},
        { "location": "244/ACT"   , "narrator": "", "text": "オッケー"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "ありがとうございます。\nそれではいきましょう。"},
        { "location": "246/ACT"   , "narrator": "", "text": "えっと"},
        { "location": "248/TALK"  , "narrator": "つばめ", "text": "…？\nなんですか？"},
        { "location": "249/SEL"   , "narrator": "", "text": "いや、なんでもない"},
        { "location": "250/SEL"   , "narrator": "", "text": "いや、気のせいか？"},
        { "location": "251/ACT"   , "narrator": "", "text": "いや、なんでもない"},
        { "location": "252/TALK"  , "narrator": "つばめ", "text": "そうですか。\nそれではいきましょう。"},
        { "location": "253/ACT"   , "narrator": "", "text": "いや、気のせいか？"},
        { "location": "254/TALK"  , "narrator": "つばめ", "text": "何がです？"},
        { "location": "255/SEL"   , "narrator": "", "text": "何か違和感が…"},
        { "location": "256/SEL"   , "narrator": "", "text": "何か嫌な予感が…"},
        { "location": "257/ACT"   , "narrator": "", "text": "何か違和感が…"},
        { "location": "258/TALK"  , "narrator": "つばめ", "text": "司書が変われば\n雰囲気も変わりますよ。"},
        { "location": "259/TALK"  , "narrator": "つばめ", "text": "それが違和感の\n原因ではないでしょうか？"},
        { "location": "260/SEL"   , "narrator": "", "text": "いや、そういう問題じゃないような"},
        { "location": "261/ACT"   , "narrator": "", "text": "いや、そういう問題じゃないような"},
        { "location": "263/TALK"  , "narrator": "つばめ", "text": "じゃあ、\nどういう問題ですか？"},
        { "location": "264/SEL"   , "narrator": "", "text": "クランって破壊するんだっけ？"},
        { "location": "265/ACT"   , "narrator": "", "text": "クランって破壊するんだっけ？"},
        { "location": "267/TALK"  , "narrator": "つばめ", "text": "人格によって言い方は\n違うかも知れません。"},
        { "location": "268/TALK"  , "narrator": "つばめ", "text": "けど、結果的には同じ。\n消滅させるんです。"},
        { "location": "269/TALK"  , "narrator": "つばめ", "text": "えっと、\nそろそろいいですか？"},
        { "location": "270/SEL"   , "narrator": "", "text": "あ、はい"},
        { "location": "271/SEL"   , "narrator": "", "text": "いや、だめ"},
        { "location": "272/ACT"   , "narrator": "", "text": "あ、はい"},
        { "location": "273/TALK"  , "narrator": "つばめ", "text": "それじゃ行きましょう。"},
        { "location": "274/ACT"   , "narrator": "", "text": "いや、だめ"},
        { "location": "276/TALK"  , "narrator": "つばめ", "text": "はぁ、そうですか。"},
        { "location": "278/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "283/TALK"  , "narrator": "つばめ", "text": "グダグダ言ってないで\nさっさとクランを倒し\nやがれ■■野郎！"},
        { "location": "292/ACT"   , "narrator": "", "text": "何か嫌な予感が…"},
        { "location": "294/TALK"  , "narrator": "つばめ", "text": "……？"},
        { "location": "295/TALK"  , "narrator": "つばめ", "text": "ちょっと\n意味がわかりません。"},
        { "location": "296/SEL"   , "narrator": "", "text": "ホントにつばめの人格？"},
        { "location": "297/SEL"   , "narrator": "", "text": "今日のパンツ何色？"},
        { "location": "298/ACT"   , "narrator": "", "text": "ホントにつばめの人格？"},
        { "location": "299/TALK"  , "narrator": "つばめ", "text": "そうですけど？"},
        { "location": "300/TALK"  , "narrator": "つばめ", "text": "でも、その質問って\n本人に聞く意味\nあるのでしょうか。"},
        { "location": "301/TALK"  , "narrator": "つばめ", "text": "ところで。\nそろそろクランを破壊しに\n行ってもらえませんか？"},
        { "location": "302/SEL"   , "narrator": "", "text": "あ、はい"},
        { "location": "303/ACT"   , "narrator": "", "text": "あ、はい"},
        { "location": "305/TALK"  , "narrator": "つばめ", "text": "ありがとうございます。\nそれじゃ、よろしく\nお願いします。"},
        { "location": "306/ACT"   , "narrator": "", "text": "今日のパンツ何色？"},
        { "location": "308/TALK"  , "narrator": "つばめ", "text": "あｋ"},
        { "location": "311/TALK"  , "narrator": "つばめ", "text": "<size=50>は！？</size>"},
        { "location": "312/SEL"   , "narrator": "", "text": "赤！？"},
        { "location": "313/SEL"   , "narrator": "", "text": "威圧！？"},
        { "location": "314/ACT"   , "narrator": "", "text": "赤！？"},
        { "location": "317/TALK"  , "narrator": "つばめ", "text": "…んっ！"},
        { "location": "318/TALK"  , "narrator": "つばめ", "text": "$handle$さんには\n関係無いことです。"},
        { "location": "319/ACT"   , "narrator": "", "text": "威圧！？"},
        { "location": "323/TALK"  , "narrator": "つばめ", "text": "いいえ。"},
        { "location": "324/SEL"   , "narrator": "", "text": "いや威圧したでしょ"},
        { "location": "325/SEL"   , "narrator": "", "text": "それじゃ気のせいか"},
        { "location": "326/ACT"   , "narrator": "", "text": "いや威圧したでしょ"},
        { "location": "328/TALK"  , "narrator": "つばめ", "text": "いえいえ！"},
        { "location": "329/SEL"   , "narrator": "", "text": "いや絶対した！"},
        { "location": "330/ACT"   , "narrator": "", "text": "いや絶対した！"},
        { "location": "333/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "338/TALK"  , "narrator": "つばめ", "text": "いいから\nとっととクランを\n壊してこいよ！"},
        { "location": "346/ACT"   , "narrator": "", "text": "それじゃ気のせいか"},
        { "location": "347/TALK"  , "narrator": "つばめ", "text": "そうですよ。"},
        { "location": "348/TALK"  , "narrator": "つばめ", "text": "ところで。\nそろそろクランを破壊しに\n行ってもらえませんか？"},
        { "location": "349/SEL"   , "narrator": "", "text": "あ、はい"},
        { "location": "350/ACT"   , "narrator": "", "text": "あ、はい"},
        { "location": "352/TALK"  , "narrator": "つばめ", "text": "ありがとうございます。\nそれじゃ、よろしく\nお願いします。"},
        { "location": "359/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
        { "location": "45/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月24日　5:34 PM</color>\n豊洲で発生したフェノメノンの内部にて。"},
        { "location": "130/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "132/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "134/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "136/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "138/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
