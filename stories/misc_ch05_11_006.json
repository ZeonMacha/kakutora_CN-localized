        { "location": "3289/SCENARIO", "narrator": "", "text": "鉱石の功績"},
        { "location": "3314/TALK"    , "narrator": "神楽", "text": "パワーストーンとかより"},
        { "location": "3315/TALK"    , "narrator": "神楽", "text": "本物の宝石の方がパワーあるよね"},
        { "location": "3316/TALK"    , "narrator": "神楽", "text": "主に財力的な面で"},
        { "location": "3318/SEL"     , "narrator": "", "text": "生々しい…"},
        { "location": "3319/SEL"     , "narrator": "", "text": "オカルトは苦手なんだ"},
        { "location": "3320/SEL"     , "narrator": "", "text": "$me$が神楽に宝石を贈るよ"},
        { "location": "3321/ACT"     , "narrator": "", "text": "生々しい…"},
        { "location": "3322/TALK"    , "narrator": "神楽", "text": "現実とは厳しいものなのです"},
        { "location": "3323/ACT"     , "narrator": "", "text": "オカルトは苦手なんだ"},
        { "location": "3324/TALK"    , "narrator": "神楽", "text": "オカルトじゃないですー"},
        { "location": "3325/TALK"    , "narrator": "神楽", "text": "スピリチュアリズムですー"},
        { "location": "3326/ACT"     , "narrator": "", "text": "$me$が神楽に宝石を贈るよ"},
        { "location": "3328/TALK"    , "narrator": "神楽", "text": "やったね！"},
        { "location": "3330/TALK"    , "narrator": "神楽", "text": "じゃあ青いダイヤでお願いしますね"},
        { "location": "3331/TALK"    , "narrator": "神楽", "text": "$handlek$の骨から作ったやつ☆彡"},
        { "location": "3333/TALK"    , "narrator": "神楽", "text": "ぴょんこはパワーストーン自体は眉唾だと看破してる勢だけど"},
        { "location": "3334/TALK"    , "narrator": "神楽", "text": "そういうものにすがりたい気持ちまでは否定しないぴょん"},
        { "location": "3335/TALK"    , "narrator": "神楽", "text": "お守り的な？"},
        { "location": "3337/TALK"    , "narrator": "神楽", "text": "だったら余計宝石じゃない？"},
        { "location": "3338/TALK"    , "narrator": "神楽", "text": "って結論になっちゃうんだけどね♪"}
