        { "location": "319/SCENARIO", "narrator": "", "text": "蓋をすればいいのに"},
        { "location": "344/TALK"    , "narrator": "神楽", "text": "何も見えない場所に行きたい"},
        { "location": "346/SEL"     , "narrator": "", "text": "じゃあ一緒に行こうか"},
        { "location": "347/SEL"     , "narrator": "", "text": "何があったの？"},
        { "location": "348/SEL"     , "narrator": "", "text": "今日はゆっくり休んで"},
        { "location": "349/ACT"     , "narrator": "", "text": "じゃあ一緒に行こうか"},
        { "location": "352/TALK"    , "narrator": "神楽", "text": "$handle$と一緒がいいな"},
        { "location": "353/ACT"     , "narrator": "", "text": "何があったの？"},
        { "location": "354/TALK"    , "narrator": "神楽", "text": "別に何もない"},
        { "location": "355/TALK"    , "narrator": "神楽", "text": "だから辛いの"},
        { "location": "356/ACT"     , "narrator": "", "text": "今日はゆっくり休んで"},
        { "location": "357/TALK"    , "narrator": "神楽", "text": "今日だけ休んでも"},
        { "location": "359/TALK"    , "narrator": "神楽", "text": "もう何も変わらない"},
        { "location": "361/TALK"    , "narrator": "神楽", "text": "わからないことが多すぎるのに"},
        { "location": "362/TALK"    , "narrator": "神楽", "text": "見えてしまうことも多すぎる"},
        { "location": "363/TALK"    , "narrator": "神楽", "text": "なんなのこれ"},
        { "location": "364/TALK"    , "narrator": "神楽", "text": "もーーーーーー！！！"},
        { "location": "366/SEL"     , "narrator": "", "text": "チラリズムの美学"},
        { "location": "367/SEL"     , "narrator": "", "text": "神楽は辛い立場だよね"},
        { "location": "368/SEL"     , "narrator": "", "text": "何の話？"},
        { "location": "369/ACT"     , "narrator": "", "text": "チラリズムの美学"},
        { "location": "370/TALK"    , "narrator": "神楽", "text": "そんな楽しい話じゃないし！"},
        { "location": "371/TALK"    , "narrator": "神楽", "text": "でもそれなら心躍るかも！"},
        { "location": "372/TALK"    , "narrator": "神楽", "text": "そんなわけないしー"},
        { "location": "374/TALK"    , "narrator": "神楽", "text": "あーヤダヤダ"},
        { "location": "375/ACT"     , "narrator": "", "text": "神楽は辛い立場だよね"},
        { "location": "376/TALK"    , "narrator": "神楽", "text": "そうなんだぴょん、、、"},
        { "location": "377/TALK"    , "narrator": "神楽", "text": "八方ふさがり？？？"},
        { "location": "378/TALK"    , "narrator": "神楽", "text": "打開策とかあるのかこれ"},
        { "location": "380/ACT"     , "narrator": "", "text": "何の話？"},
        { "location": "381/TALK"    , "narrator": "神楽", "text": "ああん？"},
        { "location": "382/TALK"    , "narrator": "神楽", "text": "特に何かってわけじゃなくてこの世の全ての話？"},
        { "location": "384/TALK"    , "narrator": "神楽", "text": "いまこの世界にいるぴょんこは計画を終結させないとどこにも行けないぴょん"},
        { "location": "385/TALK"    , "narrator": "神楽", "text": "でも"},
        { "location": "386/TALK"    , "narrator": "神楽", "text": "$handle$はＷＡＶＥのアカウント削除しちゃえば"},
        { "location": "387/TALK"    , "narrator": "神楽", "text": "もう関わらなくてよくなるでしょ"},
        { "location": "389/SEL"     , "narrator": "", "text": "そんなわけないし"},
        { "location": "390/SEL"     , "narrator": "", "text": "いやアカウントはそれじゃなくて…"},
        { "location": "391/SEL"     , "narrator": "", "text": "$me$は神楽に関わりたいんだよ"},
        { "location": "392/ACT"     , "narrator": "", "text": "そんなわけないし"},
        { "location": "393/TALK"    , "narrator": "神楽", "text": "論理上は正しいと思うけど？"},
        { "location": "394/ACT"     , "narrator": "", "text": "いやアカウントはそれじゃなくて…"},
        { "location": "395/TALK"    , "narrator": "神楽", "text": "機種に紐付けてあるとかそういうこと？"},
        { "location": "396/TALK"    , "narrator": "神楽", "text": "じゃあ機種変もすればいいでしょ"},
        { "location": "397/ACT"     , "narrator": "", "text": "$me$は神楽に関わりたいんだよ"},
        { "location": "399/TALK"    , "narrator": "神楽", "text": "それって本当？？"},
        { "location": "402/TALK"    , "narrator": "神楽", "text": "自分でもわかってる"},
        { "location": "403/TALK"    , "narrator": "神楽", "text": "$handle$に寄りかかりすぎだってこと"},
        { "location": "404/SEL"     , "narrator": "", "text": "もっと頼ってよ"},
        { "location": "405/SEL"     , "narrator": "", "text": "そんなことないし"},
        { "location": "406/SEL"     , "narrator": "", "text": "そのために$me$はいるから"},
        { "location": "407/TALK"    , "narrator": "神楽", "text": "わかってるけど"},
        { "location": "408/TALK"    , "narrator": "神楽", "text": "でも"},
        { "location": "410/ACT"     , "narrator": "", "text": "もっと頼ってよ"},
        { "location": "411/TALK"    , "narrator": "神楽", "text": "ええと"},
        { "location": "412/ACT"     , "narrator": "", "text": "そんなことないし"},
        { "location": "413/TALK"    , "narrator": "神楽", "text": "そうかな？"},
        { "location": "414/ACT"     , "narrator": "", "text": "そのために$me$はいるから"},
        { "location": "415/TALK"    , "narrator": "神楽", "text": "本当に？"},
        { "location": "417/TALK"    , "narrator": "神楽", "text": "辛いでしょ$handle$"},
        { "location": "419/SEL"     , "narrator": "", "text": "辛いっていうか"},
        { "location": "420/SEL"     , "narrator": "", "text": "神楽が大変だからこそここにいる"},
        { "location": "421/SEL"     , "narrator": "", "text": "何でも話してくれていいのに"},
        { "location": "422/ACT"     , "narrator": "", "text": "辛いっていうか"},
        { "location": "423/TALK"    , "narrator": "神楽", "text": "違う？"},
        { "location": "424/ACT"     , "narrator": "", "text": "神楽が大変だからこそここにいる"},
        { "location": "425/TALK"    , "narrator": "神楽", "text": "ぴょんこのため？"},
        { "location": "426/ACT"     , "narrator": "", "text": "何でも話してくれていいのに"},
        { "location": "427/TALK"    , "narrator": "神楽", "text": "簡単に言うなし！"},
        { "location": "428/TALK"    , "narrator": "神楽", "text": "簡単じゃないから！"},
        { "location": "430/TALK"    , "narrator": "神楽", "text": "なんだかなーって"},
        { "location": "431/TALK"    , "narrator": "神楽", "text": "でも"},
        { "location": "432/TALK"    , "narrator": "神楽", "text": "ママのこともあるから"},
        { "location": "433/TALK"    , "narrator": "神楽", "text": "投げ出せないし"},
        { "location": "434/TALK"    , "narrator": "神楽", "text": "ぴょんこだって死にたくないし"},
        { "location": "438/TALK"    , "narrator": "神楽", "text": "なんかもう"},
        { "location": "439/TALK"    , "narrator": "神楽", "text": "全部ｱﾘｴﾅｽ"},
        { "location": "440/TALK"    , "narrator": "神楽", "text": "はーあーあーあーあー"},
        { "location": "443/SEL"     , "narrator": "", "text": "お疲れさま"},
        { "location": "444/SEL"     , "narrator": "", "text": "大変だよね…"},
        { "location": "445/SEL"     , "narrator": "", "text": "ｱﾘｴﾅｽ！！！！ｱﾘｴﾅｽ！！！！"},
        { "location": "446/ACT"     , "narrator": "", "text": "お疲れさま"},
