{
    "dir": "dramatics/daydra/drm_ch04_00_610.js",
    "type": "Episode",
    "info": {
        "story_id": "4065",
        "cid": "miyabi",
        "title": "らぶとーく 第66話",
        "sub_title": "ヒロインのいるべき場所"
    },
    "entry":
    [
        { "location": "188/SCENARIO", "narrator": "", "text": "ヒロインのいるべき場所"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "…ふむ。"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "スマホは手軽で\n便利やけんど――"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "画面が小さいのが\n難点やねぇ。"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "タブレット忘れたのは\n痛手やな…。"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "…むっ！？\nこの記事は！！"},
        { "location": "217/TALK"    , "narrator": "女子高校生Ａ", "text": "恋ヶ崎さん。\nちょっとお願いがあるん\nだけど。"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "…ん？"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "何か用なが？"},
        { "location": "227/TALK"    , "narrator": "女子高校生Ａ", "text": "あのね、週末にバレー部の\n試合があるんだけど――"},
        { "location": "228/TALK"    , "narrator": "女子高校生Ａ", "text": "うちのクラスからも、\n種坂さんが出場するの。"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "…？\n誰やそれ？"},
        { "location": "231/TALK"    , "narrator": "女子高校生Ａ", "text": "それで、クラスのみんなで\n応援しに行こう、って\nことになったんだけど――"},
        { "location": "232/TALK"    , "narrator": "女子高校生Ａ", "text": "恋ヶ崎さんも、\n良かったら一緒にどう？"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "トス。"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "じゃなくて、パスや。"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "うちはバレーボールとか、\nあんまし興味ないき。"},
        { "location": "239/TALK"    , "narrator": "女子高校生Ａ", "text": "そ、そう…。"},
        { "location": "240/TALK"    , "narrator": "女子高校生Ａ", "text": "でも、終わったらみんなで\n食事に行こう、って話も\nしてて…。"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "騒がしいのは苦手やき、\nうちは遠慮しとくがよ。"},
        { "location": "242/TALK"    , "narrator": "女子高校生Ａ", "text": "そ、そっか…。\nちょっと残念…。"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "…すまんけんど、\nスマホタイムやき。"},
        { "location": "248/TALK"    , "narrator": "女子高校生Ａ", "text": "あ、ごめんね。\nそれじゃ…。"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "いや、これでえい。\nうちはこれでえいがよ。"},
        { "location": "254/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "259/TALK"    , "narrator": "みやび", "text": "人付き合いを良くするために"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "己を殺して話を合わせる"},
        { "location": "261/TALK"    , "narrator": "みやび", "text": "うちもそうするべきか？"},
        { "location": "264/SEL"     , "narrator": "", "text": "断ったの気にしてる？"},
        { "location": "265/ACT"     , "narrator": "", "text": "断ったの気にしてる？"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "ちっくとな"},
        { "location": "268/TALK"    , "narrator": "みやび", "text": "一応クラスメイトからの誘いやし"},
        { "location": "269/TALK"    , "narrator": "みやび", "text": "クラスのほとんどが行くらしいし"},
        { "location": "270/TALK"    , "narrator": "みやび", "text": "うちも会話に乗って付いていくべきか？"},
        { "location": "271/TALK"    , "narrator": "みやび", "text": "微塵も興味ないが"},
        { "location": "273/SEL"     , "narrator": "", "text": "別にいいんじゃない"},
        { "location": "274/SEL"     , "narrator": "", "text": "そういうところも好きだけど"},
        { "location": "275/SEL"     , "narrator": "", "text": "擬態してみるのもいいかもね"},
        { "location": "276/ACT"     , "narrator": "", "text": "別にいいんじゃない"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "そう思う？"},
        { "location": "278/TALK"    , "narrator": "みやび", "text": "ご機嫌取りで言うてるだけか？"},
        { "location": "280/SEL"     , "narrator": "", "text": "自分にウソついてもバレる"},
        { "location": "281/ACT"     , "narrator": "", "text": "自分にウソついてもバレる"},
        { "location": "283/TALK"    , "narrator": "みやび", "text": "そうかもしれん"},
        { "location": "284/TALK"    , "narrator": "みやび", "text": "無理しても仕方ない"},
        { "location": "285/TALK"    , "narrator": "みやび", "text": "うちにとっての普通と"},
        { "location": "286/TALK"    , "narrator": "みやび", "text": "世間一般の普通では尺度が違うき"},
        { "location": "287/TALK"    , "narrator": "みやび", "text": "規格が違うなら合うわけない"},
        { "location": "288/TALK"    , "narrator": "みやび", "text": "機械と一緒や"},
        { "location": "291/SEL"     , "narrator": "", "text": "それはそれで良いと思う"},
        { "location": "292/ACT"     , "narrator": "", "text": "それはそれで良いと思う"},
        { "location": "295/TALK"    , "narrator": "みやび", "text": "変わり者やね"},
        { "location": "296/TALK"    , "narrator": "みやび", "text": "ああ"},
        { "location": "297/TALK"    , "narrator": "みやび", "text": "これが類友"},
        { "location": "298/TALK"    , "narrator": "みやび", "text": "友！？"},
        { "location": "300/TALK"    , "narrator": "みやび", "text": "関係が後退した"},
        { "location": "302/SEL"     , "narrator": "", "text": "とにかく、今のままでいいと思う"},
        { "location": "303/ACT"     , "narrator": "", "text": "とにかく、今のままでいいと思う"},
        { "location": "305/TALK"    , "narrator": "みやび", "text": "そう思うが？"},
        { "location": "306/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "307/TALK"    , "narrator": "みやび", "text": "それならこのままでえいか"},
        { "location": "308/TALK"    , "narrator": "みやび", "text": "そもそも"},
        { "location": "309/TALK"    , "narrator": "みやび", "text": "変わるの絶対無理やろうし"},
        { "location": "310/TALK"    , "narrator": "みやび", "text": "今後も変化の無いうちをよろしく"},
        { "location": "311/ACT"     , "narrator": "", "text": "そういうところも好きだけど"},
        { "location": "312/TALK"    , "narrator": "みやび", "text": "うちが言うのもあれやが"},
        { "location": "313/TALK"    , "narrator": "みやび", "text": "変わり者め"},
        { "location": "314/TALK"    , "narrator": "みやび", "text": "趣味悪いとも言える"},
        { "location": "315/TALK"    , "narrator": "みやび", "text": "あ"},
        { "location": "316/TALK"    , "narrator": "みやび", "text": "だから気が合うのか"},
        { "location": "318/TALK"    , "narrator": "みやび", "text": "納得！"},
        { "location": "320/SEL"     , "narrator": "", "text": "似たもの同士、イエーッ！"},
        { "location": "321/ACT"     , "narrator": "", "text": "似たもの同士、イエーッ！"},
        { "location": "323/TALK"    , "narrator": "みやび", "text": "ハイテンションやね"},
        { "location": "324/TALK"    , "narrator": "みやび", "text": "と"},
        { "location": "325/TALK"    , "narrator": "みやび", "text": "乗らずに傍観"},
        { "location": "326/TALK"    , "narrator": "みやび", "text": "世間一般の普通と尺度が違うな"},
        { "location": "327/TALK"    , "narrator": "みやび", "text": "マイノリティーコンビ"},
        { "location": "329/SEL"     , "narrator": "", "text": "それはそれで良いと思う"},
        { "location": "330/ACT"     , "narrator": "", "text": "それはそれで良いと思う"},
        { "location": "332/TALK"    , "narrator": "みやび", "text": "そうやね"},
        { "location": "333/TALK"    , "narrator": "みやび", "text": "少なくとも"},
        { "location": "334/TALK"    , "narrator": "みやび", "text": "独りぼっちじゃないし"},
        { "location": "337/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "339/TALK"    , "narrator": "みやび", "text": "問題なし！！"},
        { "location": "340/ACT"     , "narrator": "", "text": "擬態してみるのもいいかもね"},
        { "location": "341/TALK"    , "narrator": "みやび", "text": "擬態し近づき"},
        { "location": "342/TALK"    , "narrator": "みやび", "text": "食いつくす！"},
        { "location": "343/TALK"    , "narrator": "みやび", "text": "内部からクラスを崩壊へ！"},
        { "location": "344/TALK"    , "narrator": "みやび", "text": "なんてことはせんが"},
        { "location": "345/TALK"    , "narrator": "みやび", "text": "面白くはなさそうやね"},
        { "location": "347/SEL"     , "narrator": "", "text": "ストレス溜まるだけ"},
        { "location": "348/ACT"     , "narrator": "", "text": "ストレス溜まるだけ"},
        { "location": "350/TALK"    , "narrator": "みやび", "text": "胃と精神"},
        { "location": "351/TALK"    , "narrator": "みやび", "text": "どっちを先に壊すかのチキンレース"},
        { "location": "352/TALK"    , "narrator": "みやび", "text": "世間一般の普通と尺度が違うと"},
        { "location": "354/TALK"    , "narrator": "みやび", "text": "まっこと疲れる"},
        { "location": "357/TALK"    , "narrator": "みやび", "text": "変わるべきか？"},
        { "location": "359/SEL"     , "narrator": "", "text": "やっぱり今のままが一番"},
        { "location": "360/ACT"     , "narrator": "", "text": "やっぱり今のままが一番"},
        { "location": "362/TALK"    , "narrator": "みやび", "text": "そうか"},
        { "location": "364/TALK"    , "narrator": "みやび", "text": "そう言うてくれる人間がいるゆうんは"},
        { "location": "365/TALK"    , "narrator": "みやび", "text": "嬉しいもんやね"},
        { "location": "368/TALK"    , "narrator": "みやび", "text": "何となくな！"},
        { "location": "197/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　 1:55 PM</color>\nとある平日、付属学園高等部みやびの教室にて"}
    ]
}
