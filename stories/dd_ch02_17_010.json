{
    "dir": "chap17/daydra/dd_ch02_17_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "17252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "アイス屋さん"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アイス屋さん"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…まだかしら？\nもう二十分くらい\n並んでるのに…。"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "文句言わないの。\nもうすぐだから\n我慢しなさい。"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "でも、凄いですね！"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "アイス屋さんに\nこんな行列ができてる\nなんて、ビックリです。"},
        { "location": "33/TALK"   , "narrator": "雛", "text": "ここのアイス、すっごく\n美味しいからねー。"},
        { "location": "34/TALK"   , "narrator": "雛", "text": "普通のだけじゃなくて、\nオリジナルフレーバーの\nアイスとか――"},
        { "location": "35/TALK"   , "narrator": "雛", "text": "色んなトッピングができる\nアイスまで、沢山あるん\nだよ。"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "そんなにあったら、\nどれにするか迷っちゃい\nそうだよ。"},
        { "location": "40/TALK"   , "narrator": "雛", "text": "あそこの看板にメニュー\n載ってるよー。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "へぇ…\n本当に沢山あるわね。"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "…あたし、あれにするわ。\nキャラメルチョコチップ、\nってやつ。"},
        { "location": "45/TALK"   , "narrator": "雛", "text": "おっ、新作だねー。\n甘くて美味しそうかも。"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "う～ん…どれかなぁ…？\nあんまり変わったものは\n避けたいんだけど…。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "…じゃあ、あの辺から\n選んだら？\n結構美味しそうだし。"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "ベリー系ですか…。"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "あっ！　決めました！\nわたし、あれにします！"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "あれじゃわかんないって。\nどれのこと？"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "ダブルベリー\nシャーベットです！"},
        { "location": "60/TALK"   , "narrator": "雛", "text": "あのすっごい紫色の？\n見るからにベリーって\n感じだね。"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "甘酸っぱくて\n美味しそう！"},
        { "location": "62/TALK"   , "narrator": "雛", "text": "あたしはハニーチーズ\nクリームにしよっかなー。"},
        { "location": "64/TALK"   , "narrator": "雛", "text": "綾水様は何にしますか？"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "う～ん…………。"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "そうだなぁ……、\nやっぱりオレンジ系が――"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "ううん、待って待って。\nやっぱりクリーム系の方が\n美味しそうだし…。"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "でも、ギャヴィのも\n気になるし…う～ん…。"},
        { "location": "70/TALK"   , "narrator": "つばめ", "text": "アーヤさん、\n凄く悩んじゃってます…。"},
        { "location": "71/TALK"   , "narrator": "雛", "text": "綾水様、アイスが\nお好きなんですね？"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "珍しいアイスが多くて、\n目移りしてるだけでしょ。"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "そろそろ決めないと、\n順番来ちゃいますよ？"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "…ちょっと集中するわ。\nギリギリまで考えて\nみるから。"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "どうしよー(＞＜)"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "どのアイスにするか決まらないの！"},
        { "location": "96/SEL"    , "narrator": "", "text": "全部頼めば？"},
        { "location": "97/ACT"    , "narrator": "", "text": "全部頼めば？"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "無理！"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "五つ以上あるし(-ω-;)"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "どうすればいいか、一緒に考えて(TωT)"},
        { "location": "103/SEL"   , "narrator": "", "text": "トリプルいっちゃう？"},
        { "location": "104/SEL"   , "narrator": "", "text": "ダブルで注文"},
        { "location": "105/SEL"   , "narrator": "", "text": "次の楽しみを残そう"},
        { "location": "106/ACT"   , "narrator": "", "text": "トリプルいっちゃう？"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "そんなに食べたら"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "食べ終わった時、体が冷えちゃうわ"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "…まあ"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "我慢できなくはないけど…"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "アーヤ、あたし達の番よ。"},
        { "location": "134/TALK"  , "narrator": "ウェイトレス", "text": "いらっしゃいませ。\n何にいたしますか？"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "136/TALK"  , "narrator": "ウェイトレス", "text": "……？"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "クリームチーズと\nアーモンドキャラメル、\nそれとハーブレモン――"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "トリプルでお願いします。"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "屋台のアイス屋で\nトリプル！？"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "し、仕方ないじゃない。\n選べなかったんだから…。"},
        { "location": "148/TALK"  , "narrator": "ガブリエラ", "text": "…身体冷えても\n知らないわよ？"},
        { "location": "161/TALK"  , "narrator": "雛", "text": "あ～、美味しかったー！"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "うん！　こんなに美味しい\nアイス、初めて食べたよ。"},
        { "location": "164/TALK"  , "narrator": "つばめ", "text": "また来ようね。"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "…アーヤ、大丈夫？"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "え、ええ…。"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "どのアイスも、\n凄く美味しかったわ。"},
        { "location": "172/TALK"  , "narrator": "雛", "text": "みたいですね。\n凄く美味しそうに\n食べてましたし。"},
        { "location": "174/TALK"  , "narrator": "ガブリエラ", "text": "二個目を食べ終わった時、\n少し身体震えてたけど？"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "あ、あはは…\nちょっと無理しちゃった\nかもしれないわね。"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "ちょっと冷えちゃった\nみたい。"},
        { "location": "183/TALK"  , "narrator": "雛", "text": "屋台のアイス屋で\nトリプルは、少し\n無謀でしたねー。"},
        { "location": "186/TALK"  , "narrator": "つばめ", "text": "見てるこっちまで\n寒くなっちゃいました。"},
        { "location": "189/TALK"  , "narrator": "ガブリエラ", "text": "とりあえず、場所移そ。\n喫茶店でお茶でも飲めば、\nすぐに温まるわよ。"},
        { "location": "191/TALK"  , "narrator": "アーヤ", "text": "そ、そうね…。\n今は熱い紅茶で、\nゆっくり温まりたいわ。"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "熱い紅茶の\nトリプルはやめてよ？"},
        { "location": "199/TALK"  , "narrator": "アーヤ", "text": "やらないわよ、もう…。"},
        { "location": "200/ACT"   , "narrator": "", "text": "ダブルで注文"},
        { "location": "201/TALK"  , "narrator": "アーヤ", "text": "ダブルかぁ…"},
        { "location": "202/TALK"  , "narrator": "アーヤ", "text": "二つなら、どうにか決められるかも"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "ありがと、ダブルにするわ"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "ヘーゼルナッツチョコと、\nピーチストロベリーの\nダブルにするわ。"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "トリプルじゃなくて\nいいの？"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "さすがに、トリプルは\n食べ過ぎだと思うし――"},
        { "location": "220/TALK"  , "narrator": "アーヤ", "text": "ダブルだったら二つは\n食べれるから、どうにか\n選べたわ。"},
        { "location": "223/TALK"  , "narrator": "つばめ", "text": "また来ましょうね、\nアーヤさん。"},
        { "location": "225/TALK"  , "narrator": "雛", "text": "食べる前にする話じゃ\nないって。"},
        { "location": "228/TALK"  , "narrator": "アーヤ", "text": "…でも、今のうちに、\n次来た時に何を食べるか\n選んでおこうかしら？"},
        { "location": "229/ACT"   , "narrator": "", "text": "次の楽しみを残そう"},
        { "location": "230/TALK"  , "narrator": "アーヤ", "text": "次の楽しみ以前に"},
        { "location": "231/TALK"  , "narrator": "アーヤ", "text": "今日どうしようかを聞いてるのに…"},
        { "location": "232/TALK"  , "narrator": "アーヤ", "text": "そろそろ順番来ちゃうから、いいわ(TεT)"},
        { "location": "244/TALK"  , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "247/TALK"  , "narrator": "ガブリエラ", "text": "まだ決まってないの？"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "もう、どれを食べたいのか\n一つずつ言ってみて。"},
        { "location": "250/TALK"  , "narrator": "アーヤ", "text": "えっと…キャラメル\nチョコレートと…。"},
        { "location": "251/TALK"  , "narrator": "ガブリエラ", "text": "はい、今日食べるのは\nそれで決定！"},
        { "location": "254/TALK"  , "narrator": "アーヤ", "text": "え、えぇっ！？\n勝手に決めないでよ！"},
        { "location": "257/TALK"  , "narrator": "ガブリエラ", "text": "自分で決められないから、\n代わりに決めてあげたん\nじゃない。"},
        { "location": "258/TALK"  , "narrator": "ガブリエラ", "text": "それとも、食べたくない\nアイスなの？"},
        { "location": "261/TALK"  , "narrator": "アーヤ", "text": "そうじゃないけど…。"},
        { "location": "263/TALK"  , "narrator": "ガブリエラ", "text": "じゃあ決まりね。"},
        { "location": "266/TALK"  , "narrator": "つばめ", "text": "ガ、ガブちゃん…\n凄いですね。"},
        { "location": "267/TALK"  , "narrator": "雛", "text": "うん…悩んだ時は\nそういう決め方を\nすれば良いんだね…。"},
        { "location": "268/TALK"  , "narrator": "雛", "text": "なんか、勉強になったよ。"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "271/TALK"  , "narrator": "ガブリエラ", "text": "何よ、まだ不満なの？"},
        { "location": "273/TALK"  , "narrator": "アーヤ", "text": "う、ううん。\n決まってよかった、って\n思ってるわ。"},
        { "location": "276/TALK"  , "narrator": "アーヤ", "text": "でも、決めたら他のが\n気になった、なんて…\nさすがに言えないわ。"},
        { "location": "278/TALK"  , "narrator": "アーヤ", "text": "私、優柔不断なのかしら？"},
        { "location": "21/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月11日　4:08 PM</color>\nとある平日の放課後、某アイス屋にて。"}
    ]
}
