{
    "dir": "dramatics/daydra/drm_ch03_00_780.js",
    "type": "Episode",
    "info": {
        "story_id": "3078",
        "cid": "gabriella",
        "title": "らぶとーく 第80話",
        "sub_title": "本物の女王様のおはなし"
    },
    "entry":
    [
        { "location": "265/TALK", "narrator": "ガブリエラ", "text": "実は日本に来てから\n教会には\n行ってないの。"},
        { "location": "266/TALK", "narrator": "ガブリエラ", "text": "だから教会を\n探すところから\n始めないと。"},
        { "location": "267/SEL" , "narrator": "", "text": "$me$は改宗しないと…"},
        { "location": "268/SEL" , "narrator": "", "text": "素敵なところが\nあるといいね"},
        { "location": "269/SEL" , "narrator": "", "text": "見当つかないな…"},
        { "location": "270/ACT" , "narrator": "", "text": "$me$は改宗しないと…"},
        { "location": "272/TALK", "narrator": "ガブリエラ", "text": "そんなことしなくて\n大丈夫よ。"},
        { "location": "273/ACT" , "narrator": "", "text": "素敵なところが\nあるといいね"},
        { "location": "274/TALK", "narrator": "ガブリエラ", "text": "素敵とか\n素敵じゃないって\n場所じゃないわ。"},
        { "location": "275/TALK", "narrator": "ガブリエラ", "text": "神聖で敬虔な\n場所だもの。"},
        { "location": "276/ACT" , "narrator": "", "text": "見当つかないな…"},
        { "location": "277/TALK", "narrator": "ガブリエラ", "text": "そうなのね。\nあたしが探してみるわ。"},
        { "location": "279/TALK", "narrator": "ガブリエラ", "text": "でも……。"},
        { "location": "280/TALK", "narrator": "ガブリエラ", "text": "神父様に理由を\n説明して理解して\nもらえるかしら。"},
        { "location": "282/TALK", "narrator": "ガブリエラ", "text": "そこが一番の\n問題よね。"},
        { "location": "283/TALK", "narrator": "ガブリエラ", "text": "それに参列してくれる\n人の見当もつかないわ。"},
        { "location": "284/SEL" , "narrator": "", "text": "そんな本格的にするの？"},
        { "location": "285/SEL" , "narrator": "", "text": "もっとひっそりでも\nよくない？"},
        { "location": "286/SEL" , "narrator": "", "text": "$me$たちが納得\nできれば\nそれでいいよ"},
        { "location": "287/ACT" , "narrator": "", "text": "そんな本格的にするの？"},
        { "location": "288/TALK", "narrator": "ガブリエラ", "text": "じゃあどうする\nつもりなの？"},
        { "location": "289/SEL" , "narrator": "", "text": "もう少し密やかに"},
        { "location": "290/SEL" , "narrator": "", "text": "今回は省略しても\nいいと思う"},
        { "location": "291/ACT" , "narrator": "", "text": "もう少し密やかに"},
        { "location": "293/TALK", "narrator": "ガブリエラ", "text": "秘めた恋って\n感じがして\n素敵かも。"},
        { "location": "294/ACT" , "narrator": "", "text": "今回は省略しても\nいいと思う"},
        { "location": "295/TALK", "narrator": "ガブリエラ", "text": "いいかしら…？"},
        { "location": "297/ACT" , "narrator": "", "text": "もっとひっそりでも\nよくない？"},
        { "location": "298/TALK", "narrator": "ガブリエラ", "text": "ひっそり？"},
        { "location": "299/SEL" , "narrator": "", "text": "秘めた恋って\n感じで"},
        { "location": "300/SEL" , "narrator": "", "text": "二人きりの秘密って\nことで"},
        { "location": "301/SEL" , "narrator": "", "text": "隠し事できるのが\n大人の条件だから"},
        { "location": "302/ACT" , "narrator": "", "text": "秘めた恋って\n感じで"},
        { "location": "303/ACT" , "narrator": "", "text": "二人きりの秘密って\nことで"},
        { "location": "304/TALK", "narrator": "ガブリエラ", "text": "なんだかとても\nロマンチックな\n感じがするわ。"},
        { "location": "305/ACT" , "narrator": "", "text": "隠し事できるのが\n大人の条件だから"},
        { "location": "306/TALK", "narrator": "ガブリエラ", "text": "ちょっとわかる\n気がするわ。"},
        { "location": "308/ACT" , "narrator": "", "text": "$me$たちが納得\nできれば\nそれでいいよ"},
        { "location": "309/TALK", "narrator": "ガブリエラ", "text": "そうだけど…。"},
        { "location": "310/SEL" , "narrator": "", "text": "不満？"},
        { "location": "311/SEL" , "narrator": "", "text": "それが一番\n大事なとこでしょ"},
        { "location": "312/SEL" , "narrator": "", "text": "ガブリエラは\n納得できない？"},
        { "location": "313/ACT" , "narrator": "", "text": "不満？"},
        { "location": "314/TALK", "narrator": "ガブリエラ", "text": "そういうわけじゃ\nないけど…。"},
        { "location": "315/ACT" , "narrator": "", "text": "それが一番\n大事なとこでしょ"},
        { "location": "316/TALK", "narrator": "ガブリエラ", "text": "そうね。\nそれは絶対だけど。"},
        { "location": "317/ACT" , "narrator": "", "text": "ガブリエラは\n納得できない？"},
        { "location": "318/TALK", "narrator": "ガブリエラ", "text": "納得っていうか…。"},
        { "location": "321/TALK", "narrator": "ガブリエラ", "text": "じゃあ\n$handle$は\nどうするつもりなの？"},
        { "location": "322/SEL" , "narrator": "", "text": "二人きりで誓う"},
        { "location": "323/SEL" , "narrator": "", "text": "誰もいない時を狙う"},
        { "location": "324/SEL" , "narrator": "", "text": "教会には入るだけ"},
        { "location": "325/ACT" , "narrator": "", "text": "二人きりで誓う"},
        { "location": "326/TALK", "narrator": "ガブリエラ", "text": "本当に本当の\n二人きりってことね。"},
        { "location": "327/ACT" , "narrator": "", "text": "誰もいない時を狙う"},
        { "location": "329/TALK", "narrator": "ガブリエラ", "text": "狙うって……。"},
        { "location": "330/TALK", "narrator": "ガブリエラ", "text": "悪いことをしてる\nつもりはないわよ。"},
        { "location": "331/ACT" , "narrator": "", "text": "教会には入るだけ"},
        { "location": "332/TALK", "narrator": "ガブリエラ", "text": "確かに自由に\n出入りできるとは\n思うけど…。"},
        { "location": "334/TALK", "narrator": "ガブリエラ", "text": "それで誓ったって\n言えるのかしら？"},
        { "location": "335/SEL" , "narrator": "", "text": "一応は"},
        { "location": "336/SEL" , "narrator": "", "text": "これが今の精いっぱい\nじゃない？"},
        { "location": "337/SEL" , "narrator": "", "text": "言えないのかな…"},
        { "location": "338/ACT" , "narrator": "", "text": "一応は"},
        { "location": "339/TALK", "narrator": "ガブリエラ", "text": "一応なのね。"},
        { "location": "340/ACT" , "narrator": "", "text": "これが今の精いっぱい\nじゃない？"},
        { "location": "341/TALK", "narrator": "ガブリエラ", "text": "精いっぱい…。"},
        { "location": "342/ACT" , "narrator": "", "text": "言えないのかな…"},
        { "location": "343/TALK", "narrator": "ガブリエラ", "text": "どうなのかしら…。"},
        { "location": "346/TALK", "narrator": "ガブリエラ", "text": "本当はね。"},
        { "location": "347/TALK", "narrator": "ガブリエラ", "text": "神父様に話すのとか\nどうしようって\n思ってた。"},
        { "location": "348/TALK", "narrator": "ガブリエラ", "text": "そもそも声も\n出せないんじゃ\nないかしらって。"},
        { "location": "349/TALK", "narrator": "ガブリエラ", "text": "だからちょっと\n安心したの。\nそう言ってくれて。"},
        { "location": "350/TALK", "narrator": "ガブリエラ", "text": "二人っきりでって\n言ってくれて。"},
        { "location": "351/SEL" , "narrator": "", "text": "そっか"},
        { "location": "352/SEL" , "narrator": "", "text": "よかった"},
        { "location": "353/SEL" , "narrator": "", "text": "無理しないでいいよ"},
        { "location": "354/ACT" , "narrator": "", "text": "そっか"},
        { "location": "355/TALK", "narrator": "ガブリエラ", "text": "そうだったのよ。"},
        { "location": "356/ACT" , "narrator": "", "text": "よかった"},
        { "location": "357/TALK", "narrator": "ガブリエラ", "text": "そう？"},
        { "location": "358/ACT" , "narrator": "", "text": "無理しないでいいよ"},
        { "location": "359/TALK", "narrator": "ガブリエラ", "text": "ええ。\nありがとう。"},
        { "location": "361/SEL" , "narrator": "", "text": "ところで"},
        { "location": "362/ACT" , "narrator": "", "text": "ところで"},
        { "location": "364/TALK", "narrator": "ガブリエラ", "text": "何かしら。"},
        { "location": "365/SEL" , "narrator": "", "text": "ハネムーンは\nどうする？"},
        { "location": "366/SEL" , "narrator": "", "text": "新婚旅行に\n行くんでしょ"},
        { "location": "367/SEL" , "narrator": "", "text": "愛の旅路は\nどこにしよう"},
        { "location": "368/ACT" , "narrator": "", "text": "ハネムーンは\nどうする？"},
        { "location": "369/TALK", "narrator": "ガブリエラ", "text": "そうだったわね。"},
        { "location": "370/ACT" , "narrator": "", "text": "新婚旅行に\n行くんでしょ"},
        { "location": "371/TALK", "narrator": "ガブリエラ", "text": "もちろんよ。"},
        { "location": "372/ACT" , "narrator": "", "text": "愛の旅路は\nどこにしよう"},
        { "location": "373/TALK", "narrator": "ガブリエラ", "text": "愛の旅路…。\nなんだか素敵。"},
        { "location": "375/TALK", "narrator": "ガブリエラ", "text": "ここがポーランド\nだったら行きたい\nところがあるの。"},
        { "location": "376/TALK", "narrator": "ガブリエラ", "text": "ヴィエリチカ岩塩坑って\n知ってるかしら。"},
        { "location": "377/SEL" , "narrator": "", "text": "名前は知ってる"},
        { "location": "378/SEL" , "narrator": "", "text": "あそこかー"},
        { "location": "379/SEL" , "narrator": "", "text": "知らないな…"},
        { "location": "380/ACT" , "narrator": "", "text": "名前は知ってる"},
        { "location": "381/TALK", "narrator": "ガブリエラ", "text": "名前だけなのね。"},
        { "location": "382/ACT" , "narrator": "", "text": "あそこかー"},
        { "location": "383/TALK", "narrator": "ガブリエラ", "text": "やっぱり有名なのね。"},
        { "location": "384/ACT" , "narrator": "", "text": "知らないな…"},
        { "location": "385/TALK", "narrator": "ガブリエラ", "text": "それは残念だわ。"},
        { "location": "387/SEL" , "narrator": "", "text": "でも岩塩坑でしょ？"},
        { "location": "388/SEL" , "narrator": "", "text": "社会科見学っぽくない？"},
        { "location": "389/SEL" , "narrator": "", "text": "なんでまた？"},
        { "location": "390/ACT" , "narrator": "", "text": "でも岩塩坑でしょ？"},
        { "location": "391/TALK", "narrator": "ガブリエラ", "text": "そうよ。"},
        { "location": "392/ACT" , "narrator": "", "text": "社会科見学っぽくない？"},
        { "location": "393/TALK", "narrator": "ガブリエラ", "text": "そんなことないわ。"},
        { "location": "394/ACT" , "narrator": "", "text": "なんでまた？"},
        { "location": "395/TALK", "narrator": "ガブリエラ", "text": "知らないのね\n$handle$は。"},
        { "location": "397/TALK", "narrator": "ガブリエラ", "text": "あそこには\nキンガ妃の指輪事件って\n話があるのよ。"},
        { "location": "398/SEL" , "narrator": "", "text": "愛憎渦巻く殺人事件？"},
        { "location": "399/SEL" , "narrator": "", "text": "何？　ドラマ？"},
        { "location": "400/SEL" , "narrator": "", "text": "お妃さまが\n岩塩掘ってたの？"},
        { "location": "401/ACT" , "narrator": "", "text": "愛憎渦巻く殺人事件？"},
        { "location": "403/TALK", "narrator": "ガブリエラ", "text": "殺人なんかじゃないわ。"},
        { "location": "404/ACT" , "narrator": "", "text": "何？　ドラマ？"},
        { "location": "406/TALK", "narrator": "ガブリエラ", "text": "違うわよ。\n史実よ。"},
        { "location": "407/ACT" , "narrator": "", "text": "お妃さまが\n岩塩掘ってたの？"},
        { "location": "408/TALK", "narrator": "ガブリエラ", "text": "そんなこと\nしてないわよ。"},
        { "location": "410/TALK", "narrator": "ガブリエラ", "text": "ポーランドの\nヴィエリチカで指輪が\n見つかったんだけど。"},
        { "location": "411/TALK", "narrator": "ガブリエラ", "text": "それはキンガ妃が\n故郷ハンガリーで\n捨てたものだったの。"},
        { "location": "412/SEL" , "narrator": "", "text": "どういうこと？"},
        { "location": "413/ACT" , "narrator": "", "text": "どういうこと？"},
        { "location": "415/TALK", "narrator": "ガブリエラ", "text": "当時のポーランドは\n塩をハンガリーの\n輸入に頼っていたの。"},
        { "location": "416/TALK", "narrator": "ガブリエラ", "text": "輸入した\n岩塩の貯蔵庫が\nヴィエリチカにあって。"},
        { "location": "417/TALK", "narrator": "ガブリエラ", "text": "ハンガリーから来た\n岩塩もそこに\n貯蔵されてた。"},
        { "location": "418/TALK", "narrator": "ガブリエラ", "text": "その中から\nキンガ妃の捨てた指輪が\n発掘されたのよ。"},
        { "location": "419/SEL" , "narrator": "", "text": "何で指輪捨てたの"},
        { "location": "420/SEL" , "narrator": "", "text": "わざわざ届けたんだ"},
        { "location": "421/SEL" , "narrator": "", "text": "$me$なら\n自分のものにするかも"},
        { "location": "422/ACT" , "narrator": "", "text": "何で指輪捨てたの"},
        { "location": "423/TALK", "narrator": "ガブリエラ", "text": "キンガ妃は一生を\n祈りと慈善活動に\n捧げるつもりだったの。"},
        { "location": "424/TALK", "narrator": "ガブリエラ", "text": "でもそれは許されず\nポーランド王室に\n嫁ぐことになったの。"},
        { "location": "425/TALK", "narrator": "ガブリエラ", "text": "気乗りのしなかった\nキンガ妃は岩塩坑に\n指輪を捨てたのよ。"},
        { "location": "426/SEL" , "narrator": "", "text": "それでも破棄\nできなかったんだ"},
        { "location": "427/SEL" , "narrator": "", "text": "よく国際問題に\nならなかったね"},
        { "location": "428/SEL" , "narrator": "", "text": "時代の違いって\nやつか…"},
        { "location": "429/ACT" , "narrator": "", "text": "それでも破棄\nできなかったんだ"},
        { "location": "430/TALK", "narrator": "ガブリエラ", "text": "…そうね。"},
        { "location": "431/ACT" , "narrator": "", "text": "よく国際問題に\nならなかったね"},
        { "location": "432/TALK", "narrator": "ガブリエラ", "text": "結局嫁いだものね。\nポーランドに。"},
        { "location": "433/ACT" , "narrator": "", "text": "時代の違いって\nやつか…"},
        { "location": "434/TALK", "narrator": "ガブリエラ", "text": "王室って大変よね。"},
        { "location": "436/ACT" , "narrator": "", "text": "わざわざ届けたんだ"},
        { "location": "437/TALK", "narrator": "ガブリエラ", "text": "ポーランドの国民性？"},
        { "location": "438/TALK", "narrator": "ガブリエラ", "text": "指輪がとても立派に\n見えたからっていうのも\nあったと思うし。"},
        { "location": "439/ACT" , "narrator": "", "text": "$me$なら\n自分のものにするかも"},
        { "location": "441/TALK", "narrator": "ガブリエラ", "text": "え！？"},
        { "location": "442/TALK", "narrator": "ガブリエラ", "text": "悪い人ね\n$handle$は。"},
        { "location": "444/TALK", "narrator": "ガブリエラ", "text": "それでね。"},
        { "location": "445/TALK", "narrator": "ガブリエラ", "text": "これは偶然じゃないって\nポーランド王室は\n考えたの。"},
        { "location": "446/TALK", "narrator": "ガブリエラ", "text": "そして国を挙げての\nプロジェクトを組み\nヴィエリチカを掘った。"},
        { "location": "447/TALK", "narrator": "ガブリエラ", "text": "そうしたら\nとても大きな\n岩塩床が見つかったの。"},
        { "location": "448/TALK", "narrator": "ガブリエラ", "text": "ポーランド王室は\n塩の採掘を\n王立事業として投資。"},
        { "location": "449/TALK", "narrator": "ガブリエラ", "text": "塩の輸出で利益を\n上げることが\nできるようになったの。"},
        { "location": "450/TALK", "narrator": "ガブリエラ", "text": "ヨーロッパ最大にして\n現存する最古の岩塩坑\nヴィエリチカ。"},
        { "location": "451/TALK", "narrator": "ガブリエラ", "text": "その逸話が\nキンガ妃の指輪事件よ。"},
        { "location": "452/SEL" , "narrator": "", "text": "歴史の授業かな？"},
        { "location": "453/SEL" , "narrator": "", "text": "ロマンチックは\nどこに行ったの"},
        { "location": "454/SEL" , "narrator": "", "text": "新婚旅行で行く\nところとは\n思えないけど"},
        { "location": "455/ACT" , "narrator": "", "text": "歴史の授業かな？"},
        { "location": "457/TALK", "narrator": "ガブリエラ", "text": "そうね。\n確かに歴史で\n習ったわ。"},
        { "location": "458/ACT" , "narrator": "", "text": "ロマンチックは\nどこに行ったの"},
        { "location": "459/TALK", "narrator": "ガブリエラ", "text": "え？\nとてもロマンチックな\n話でしょ？"},
        { "location": "460/ACT" , "narrator": "", "text": "新婚旅行で行く\nところとは\n思えないけど"},
        { "location": "461/TALK", "narrator": "ガブリエラ", "text": "そんなことないわ。\nとても素敵な\nところなんだから。"},
        { "location": "462/TALK", "narrator": "ガブリエラ", "text": "塩のシャンデリアや\n祭壇があるの。"},
        { "location": "463/TALK", "narrator": "ガブリエラ", "text": "とても幻想的よ。"},
        { "location": "465/TALK", "narrator": "ガブリエラ", "text": "キンガ妃は王の死後\n修道院に入って\n余生を過ごしたの。"},
        { "location": "466/TALK", "narrator": "ガブリエラ", "text": "自分の理想を\n貫いたのよ。"},
        { "location": "467/SEL" , "narrator": "", "text": "うーん…"},
        { "location": "468/SEL" , "narrator": "", "text": "すごい人生だね"},
        { "location": "469/SEL" , "narrator": "", "text": "王妃だったのに\nもったいない"},
        { "location": "470/ACT" , "narrator": "", "text": "うーん…"},
        { "location": "471/TALK", "narrator": "ガブリエラ", "text": "格好いいでしょう？"},
        { "location": "472/ACT" , "narrator": "", "text": "すごい人生だね"},
        { "location": "473/TALK", "narrator": "ガブリエラ", "text": "そうなのよ。\nすごいのよ。"},
        { "location": "474/ACT" , "narrator": "", "text": "王妃だったのに\nもったいない"},
        { "location": "475/TALK", "narrator": "ガブリエラ", "text": "そうかしら…？"},
        { "location": "476/TALK", "narrator": "ガブリエラ", "text": "その地位は必要\nないって王妃は\n思ったんだから。"},
        { "location": "477/TALK", "narrator": "ガブリエラ", "text": "王妃としては\n未練もなかったと\n思うわよ？"},
        { "location": "480/TALK", "narrator": "ガブリエラ", "text": "ねえ。\nあたしだって\n知ってるわ。"},
        { "location": "481/TALK", "narrator": "ガブリエラ", "text": "物語の王子と姫は\n結婚したら\n永遠に幸せになるけど。"},
        { "location": "482/TALK", "narrator": "ガブリエラ", "text": "現実はそうは\nいかないって。"},
        { "location": "483/TALK", "narrator": "ガブリエラ", "text": "結婚した後の方が\n大変だって。"},
        { "location": "484/SEL" , "narrator": "", "text": "キンガ妃みたいにね"},
        { "location": "485/SEL" , "narrator": "", "text": "意外だな"},
        { "location": "486/SEL" , "narrator": "", "text": "幸せでいる努力をするよ"},
        { "location": "487/ACT" , "narrator": "", "text": "キンガ妃みたいにね"},
        { "location": "488/TALK", "narrator": "ガブリエラ", "text": "そうね。"},
        { "location": "489/ACT" , "narrator": "", "text": "意外だな"},
        { "location": "490/TALK", "narrator": "ガブリエラ", "text": "そうかしら。"},
        { "location": "491/TALK", "narrator": "ガブリエラ", "text": "あたしだって色々\n考えてるんだから。"},
        { "location": "492/ACT" , "narrator": "", "text": "幸せでいる努力をするよ"},
        { "location": "493/TALK", "narrator": "ガブリエラ", "text": "それって大事よね。"},
        { "location": "495/TALK", "narrator": "ガブリエラ", "text": "ポーランドは今\n王政じゃないのよ。"},
        { "location": "496/SEL" , "narrator": "", "text": "…知ってるけど…？"},
        { "location": "497/SEL" , "narrator": "", "text": "また社会科の授業？"},
        { "location": "498/SEL" , "narrator": "", "text": "そうだよね"},
        { "location": "499/ACT" , "narrator": "", "text": "…知ってるけど…？"},
        { "location": "500/TALK", "narrator": "ガブリエラ", "text": "そうよね。"},
        { "location": "501/ACT" , "narrator": "", "text": "また社会科の授業？"},
        { "location": "502/TALK", "narrator": "ガブリエラ", "text": "そういうつもりじゃ\nないけど。"},
        { "location": "503/ACT" , "narrator": "", "text": "そうだよね"},
        { "location": "504/TALK", "narrator": "ガブリエラ", "text": "そうなのよね。"},
        { "location": "506/TALK", "narrator": "ガブリエラ", "text": "でも王政時代の\n事業がまだ\n現存してるの。"},
        { "location": "507/TALK", "narrator": "ガブリエラ", "text": "それってすごいこと\nだと思わない？"},
        { "location": "508/SEL" , "narrator": "", "text": "お、おう"},
        { "location": "509/SEL" , "narrator": "", "text": "やっぱり社会科の\n授業だった"},
        { "location": "510/SEL" , "narrator": "", "text": "$me$は平和ボケ\nしてるんだな…"},
        { "location": "511/ACT" , "narrator": "", "text": "お、おう"},
        { "location": "513/TALK", "narrator": "ガブリエラ", "text": "ずいぶん\n気のない返事ね。"},
        { "location": "514/ACT" , "narrator": "", "text": "やっぱり社会科の\n授業だった"},
        { "location": "515/TALK", "narrator": "ガブリエラ", "text": "違うわよ。\n永遠の愛の話よ。"},
        { "location": "516/ACT" , "narrator": "", "text": "$me$は平和ボケ\nしてるんだな…"},
        { "location": "517/TALK", "narrator": "ガブリエラ", "text": "そういうことに\nなるのかしら？\nわからないけど。"},
        { "location": "519/TALK", "narrator": "ガブリエラ", "text": "もし世界の仕組みが\n変わっても。"},
        { "location": "520/TALK", "narrator": "ガブリエラ", "text": "そんな風に\n続いていきたいの\nあたしたちも。"},
        { "location": "521/TALK", "narrator": "ガブリエラ", "text": "ずっと一緒に\nいるために。"},
        { "location": "522/TALK", "narrator": "ガブリエラ", "text": "ね。\nハネムーンに\nふさわしい場所でしょ。"},
        { "location": "523/SEL" , "narrator": "", "text": "そんな気がしてきた"},
        { "location": "524/SEL" , "narrator": "", "text": "でもちょっと\n遠いからね…"},
        { "location": "525/SEL" , "narrator": "", "text": "わかるような\nわからないような"},
        { "location": "526/ACT" , "narrator": "", "text": "そんな気がしてきた"},
        { "location": "527/TALK", "narrator": "ガブリエラ", "text": "そうでしょう？"},
        { "location": "528/ACT" , "narrator": "", "text": "でもちょっと\n遠いからね…"},
        { "location": "529/TALK", "narrator": "ガブリエラ", "text": "そうなのよ。\nそれが問題よ。"},
        { "location": "530/ACT" , "narrator": "", "text": "わかるような\nわからないような"},
        { "location": "531/TALK", "narrator": "ガブリエラ", "text": "そうかしら。\n残念だわ。"},
        { "location": "533/TALK", "narrator": "ガブリエラ", "text": "なかなか思ってる\n通りには\nならないわね。"},
        { "location": "534/SEL" , "narrator": "", "text": "それも楽しもうよ"},
        { "location": "535/SEL" , "narrator": "", "text": "ガブリエラが\nいるだけで十分だよ"},
        { "location": "536/SEL" , "narrator": "", "text": "妥協するのも\nありじゃない？"},
        { "location": "537/ACT" , "narrator": "", "text": "それも楽しもうよ"},
        { "location": "538/TALK", "narrator": "ガブリエラ", "text": "そうよね。"},
        { "location": "539/ACT" , "narrator": "", "text": "ガブリエラが\nいるだけで十分だよ"},
        { "location": "540/TALK", "narrator": "ガブリエラ", "text": "もう！"},
        { "location": "541/ACT" , "narrator": "", "text": "妥協するのも\nありじゃない？"},
        { "location": "542/TALK", "narrator": "ガブリエラ", "text": "そうするしか\nないわよね…。"},
        { "location": "544/TALK", "narrator": "ガブリエラ", "text": "できるだけ理想に\n近づくよう\nがんばるわ。"},
        { "location": "545/SEL" , "narrator": "", "text": "そうだね"},
        { "location": "546/SEL" , "narrator": "", "text": "手伝うよ"},
        { "location": "547/SEL" , "narrator": "", "text": "どんなでも\n好きなことは\n変わらないよ"},
        { "location": "548/ACT" , "narrator": "", "text": "そうだね"},
        { "location": "549/TALK", "narrator": "ガブリエラ", "text": "ずいぶん\nあっさりなのね。"},
        { "location": "550/ACT" , "narrator": "", "text": "手伝うよ"},
        { "location": "551/TALK", "narrator": "ガブリエラ", "text": "これは二人の\n話なのよ？"},
        { "location": "552/ACT" , "narrator": "", "text": "どんなでも\n好きなことは\n変わらないよ"},
        { "location": "553/TALK", "narrator": "ガブリエラ", "text": "…それはそうだけど…。"},
        { "location": "555/TALK", "narrator": "ガブリエラ", "text": "…もう少し特別感が\nあっても\nいいじゃない…。"},
        { "location": "556/SEL" , "narrator": "", "text": "それは当日までの\nお楽しみだよ"},
        { "location": "557/SEL" , "narrator": "", "text": "少しづつ醸されてくよ"},
        { "location": "558/SEL" , "narrator": "", "text": "ごめん、照れちゃって"},
        { "location": "559/ACT" , "narrator": "", "text": "それは当日までの\nお楽しみだよ"},
        { "location": "560/TALK", "narrator": "ガブリエラ", "text": "…確かにそうよね。"},
        { "location": "561/ACT" , "narrator": "", "text": "少しづつ醸されてくよ"},
        { "location": "562/TALK", "narrator": "ガブリエラ", "text": "…本当に？"},
        { "location": "563/ACT" , "narrator": "", "text": "ごめん、照れちゃって"},
        { "location": "564/TALK", "narrator": "ガブリエラ", "text": "…もう！！！"},
        { "location": "581/TALK", "narrator": "ガブリエラ", "text": "しーっ……。"},
        { "location": "583/TALK", "narrator": "ガブリエラ", "text": "今なら誰も\nいないみたい。\n大丈夫そう。"},
        { "location": "584/SEL" , "narrator": "", "text": "教会とか初めて来たよ"},
        { "location": "585/SEL" , "narrator": "", "text": "黙って入って\n大丈夫なの？"},
        { "location": "586/SEL" , "narrator": "", "text": "抜き足差し足…"},
        { "location": "587/ACT" , "narrator": "", "text": "教会とか初めて来たよ"},
        { "location": "588/TALK", "narrator": "ガブリエラ", "text": "そうなのね。"},
        { "location": "589/ACT" , "narrator": "", "text": "黙って入って\n大丈夫なの？"},
        { "location": "590/TALK", "narrator": "ガブリエラ", "text": "平気よ。"},
        { "location": "591/ACT" , "narrator": "", "text": "抜き足差し足…"},
        { "location": "592/TALK", "narrator": "ガブリエラ", "text": "そういうんじゃ\nないから！"},
        { "location": "594/TALK", "narrator": "ガブリエラ", "text": "教会は開かれた\n場所だから。\nいつ来てもいいのよ。"},
        { "location": "595/TALK", "narrator": "ガブリエラ", "text": "ただ祈りを\n捧げるだけなら\n予約は必要ないの。"},
        { "location": "597/TALK", "narrator": "ガブリエラ", "text": "神社なんかも\nそうでしょう？"},
        { "location": "598/TALK", "narrator": "ガブリエラ", "text": "お詣りなら特に\n予約しないわよね。"},
        { "location": "599/SEL" , "narrator": "", "text": "そう言われればそうだ"},
        { "location": "600/SEL" , "narrator": "", "text": "普段行かないからなー"},
        { "location": "601/SEL" , "narrator": "", "text": "理解した"},
        { "location": "602/ACT" , "narrator": "", "text": "そう言われればそうだ"},
        { "location": "603/TALK", "narrator": "ガブリエラ", "text": "わかってくれた？"},
        { "location": "604/ACT" , "narrator": "", "text": "普段行かないからなー"},
        { "location": "605/TALK", "narrator": "ガブリエラ", "text": "そうなのね。"},
        { "location": "606/ACT" , "narrator": "", "text": "理解した"},
        { "location": "607/TALK", "narrator": "ガブリエラ", "text": "本当かしら？"},
        { "location": "609/TALK", "narrator": "ガブリエラ", "text": "神父様にお願い\nすることがあるなら\n話は別だけど。"},
        { "location": "610/TALK", "narrator": "ガブリエラ", "text": "今回は神様の前で\n二人きりで誓う\nだけだから。"},
        { "location": "611/SEL" , "narrator": "", "text": "うん"},
        { "location": "612/SEL" , "narrator": "", "text": "本式のは会えた時にね"},
        { "location": "613/SEL" , "narrator": "", "text": "大事なのは\n気持ちだもんね"},
        { "location": "614/ACT" , "narrator": "", "text": "うん"},
        { "location": "615/TALK", "narrator": "ガブリエラ", "text": "そんなに軽く\n答えないで！"},
        { "location": "616/TALK", "narrator": "ガブリエラ", "text": "今日は特別な\n日なんだから…。"},
        { "location": "617/ACT" , "narrator": "", "text": "本式のは会えた時にね"},
        { "location": "618/TALK", "narrator": "ガブリエラ", "text": "えっ！？！？！？！"},
        { "location": "619/TALK", "narrator": "ガブリエラ", "text": "そうね……。\nその時にね…。"},
        { "location": "620/ACT" , "narrator": "", "text": "大事なのは\n気持ちだもんね"},
        { "location": "621/TALK", "narrator": "ガブリエラ", "text": "それだけはいっぱい\n持ってるわ。"},
        { "location": "622/TALK", "narrator": "ガブリエラ", "text": "愛してるって\n気持ちだけは…。"},
        { "location": "627/TALK", "narrator": "ガブリエラ", "text": "…じゃあ。"},
        { "location": "628/TALK", "narrator": "ガブリエラ", "text": "誓いの言葉を\n宣言しましょう。"},
        { "location": "629/SEL" , "narrator": "", "text": "憶えてないよ！？"},
        { "location": "630/SEL" , "narrator": "", "text": "何て言えばいい？"},
        { "location": "631/SEL" , "narrator": "", "text": "少しだけ待って"},
        { "location": "632/ACT" , "narrator": "", "text": "憶えてないよ！？"},
        { "location": "634/TALK", "narrator": "ガブリエラ", "text": "もう。\n仕方ないわね。"},
        { "location": "635/ACT" , "narrator": "", "text": "何て言えばいい？"},
        { "location": "636/TALK", "narrator": "ガブリエラ", "text": "あたしの後に\n続いてくれれば\nいいわ。"},
        { "location": "637/ACT" , "narrator": "", "text": "少しだけ待って"},
        { "location": "639/TALK", "narrator": "ガブリエラ", "text": "やっぱり緊張\nしちゃうわよね。"},
        { "location": "642/TALK", "narrator": "ガブリエラ", "text": "…いいかしら？"},
        { "location": "643/TALK", "narrator": "ガブリエラ", "text": "わたしたちは\n夫婦として。"},
        { "location": "644/TALK", "narrator": "ガブリエラ", "text": "順境においても\n逆境においても。"},
        { "location": "645/TALK", "narrator": "ガブリエラ", "text": "病気の時も、\n健康な時も。"},
        { "location": "646/TALK", "narrator": "ガブリエラ", "text": "生涯互いに愛と忠実を\n尽くすことを\n誓います。"},
        { "location": "647/SEL" , "narrator": "", "text": "誓います"},
        { "location": "648/SEL" , "narrator": "", "text": "絶対だよ"},
        { "location": "649/SEL" , "narrator": "", "text": "努力します"},
        { "location": "650/ACT" , "narrator": "", "text": "誓います"},
        { "location": "651/TALK", "narrator": "ガブリエラ", "text": "…ありがとう。"},
        { "location": "652/ACT" , "narrator": "", "text": "絶対だよ"},
        { "location": "653/TALK", "narrator": "ガブリエラ", "text": "絶対の絶対よ。"},
        { "location": "654/ACT" , "narrator": "", "text": "努力します"},
        { "location": "655/TALK", "narrator": "ガブリエラ", "text": "ちゃんとしてよね。"},
        { "location": "657/SEL" , "narrator": "", "text": "誓いのキスは？"},
        { "location": "658/SEL" , "narrator": "", "text": "口吻を交わそう"},
        { "location": "659/SEL" , "narrator": "", "text": "チューはないの！？"},
        { "location": "660/ACT" , "narrator": "", "text": "誓いのキスは？"},
        { "location": "661/TALK", "narrator": "ガブリエラ", "text": "！？！？！？"},
        { "location": "662/ACT" , "narrator": "", "text": "口吻を交わそう"},
        { "location": "663/TALK", "narrator": "ガブリエラ", "text": "ここで！？！？"},
        { "location": "664/ACT" , "narrator": "", "text": "チューはないの！？"},
        { "location": "665/TALK", "narrator": "ガブリエラ", "text": "えっ！？！？"},
        { "location": "667/TALK", "narrator": "ガブリエラ", "text": "今はダメよ。"},
        { "location": "668/TALK", "narrator": "ガブリエラ", "text": "普段着だし、いつ人が\n来るかもわからないし。"},
        { "location": "669/SEL" , "narrator": "", "text": "普段着だとダメなの？"},
        { "location": "670/SEL" , "narrator": "", "text": "誓いは完成してないよ"},
        { "location": "671/SEL" , "narrator": "", "text": "せっかくなのに…"},
        { "location": "672/ACT" , "narrator": "", "text": "普段着だとダメなの？"},
        { "location": "673/TALK", "narrator": "ガブリエラ", "text": "ダメよ。\n花嫁衣装のベールには\n意味があるの。"},
        { "location": "674/TALK", "narrator": "ガブリエラ", "text": "誓いの言葉を\nキスで閉じ込めるって\n意味がね。"},
        { "location": "675/ACT" , "narrator": "", "text": "誓いは完成してないよ"},
        { "location": "676/TALK", "narrator": "ガブリエラ", "text": "そんなことないわよ。"},
        { "location": "677/TALK", "narrator": "ガブリエラ", "text": "ないんだから。"},
        { "location": "678/ACT" , "narrator": "", "text": "せっかくなのに…"},
        { "location": "679/TALK", "narrator": "ガブリエラ", "text": "せっかくだから\nきちんとしたいのよ。"},
        { "location": "681/TALK", "narrator": "ガブリエラ", "text": "さ、ハネムーンに\n出発しましょう。"},
        { "location": "682/SEL" , "narrator": "", "text": "えー"},
        { "location": "683/SEL" , "narrator": "", "text": "ガブリエラのケチ！"},
        { "location": "684/SEL" , "narrator": "", "text": "仕方ないか…"},
        { "location": "685/ACT" , "narrator": "", "text": "えー"},
        { "location": "687/TALK", "narrator": "ガブリエラ", "text": "えーって…。"},
        { "location": "688/ACT" , "narrator": "", "text": "ガブリエラのケチ！"},
        { "location": "690/TALK", "narrator": "ガブリエラ", "text": "ケチじゃないわよ。"},
        { "location": "691/ACT" , "narrator": "", "text": "仕方ないか…"},
        { "location": "693/TALK", "narrator": "ガブリエラ", "text": "…仕方ないじゃない。"},
        { "location": "711/TALK", "narrator": "ガブリエラ", "text": "…何よ。\nずっと楽しみに\nしてたのに。"},
        { "location": "712/TALK", "narrator": "ガブリエラ", "text": "こんな気持ちに\nなるなんて。"},
        { "location": "713/TALK", "narrator": "ガブリエラ", "text": "$handle$の\nバカ。"},
        { "location": "714/TALK", "narrator": "ガブリエラ", "text": "神様の前での\n誓いの口づけは\n神聖なものなのよ。"},
        { "location": "715/TALK", "narrator": "ガブリエラ", "text": "簡単に遊びみたいに\nするものじゃないのよ。"},
        { "location": "716/TALK", "narrator": "ガブリエラ", "text": "それなのに\nまるであたしが\n悪いみたいに…。"},
        { "location": "717/TALK", "narrator": "ガブリエラ", "text": "…悪いみたいに…。"},
        { "location": "718/SEL" , "narrator": "", "text": "怒ってる？"},
        { "location": "719/SEL" , "narrator": "", "text": "機嫌直してよ"},
        { "location": "720/SEL" , "narrator": "", "text": "もう言わないから"},
        { "location": "721/ACT" , "narrator": "", "text": "怒ってる？"},
        { "location": "723/TALK", "narrator": "ガブリエラ", "text": "…怒ってないわ。"},
        { "location": "724/ACT" , "narrator": "", "text": "機嫌直してよ"},
        { "location": "726/TALK", "narrator": "ガブリエラ", "text": "…悪くなんてないわ。"},
        { "location": "727/ACT" , "narrator": "", "text": "もう言わないから"},
        { "location": "729/TALK", "narrator": "ガブリエラ", "text": "…何よ。"},
        { "location": "731/TALK", "narrator": "ガブリエラ", "text": "あたし別に\n$handle$と\nキスしたくないとか。"},
        { "location": "732/TALK", "narrator": "ガブリエラ", "text": "そういう理由で\nダメって言った\nわけじゃないの。"},
        { "location": "733/SEL" , "narrator": "", "text": "本当はしたい？"},
        { "location": "734/SEL" , "narrator": "", "text": "からかいすぎたね"},
        { "location": "735/SEL" , "narrator": "", "text": "ごめんね、わからなくて"},
        { "location": "736/ACT" , "narrator": "", "text": "本当はしたい？"},
        { "location": "737/TALK", "narrator": "ガブリエラ", "text": "！？！？！？！？"},
        { "location": "739/TALK", "narrator": "ガブリエラ", "text": "……それは……\nしたいわよ……。\n当然でしょ！？"},
        { "location": "740/ACT" , "narrator": "", "text": "からかいすぎたね"},
        { "location": "741/TALK", "narrator": "ガブリエラ", "text": "そうだったの！？"},
        { "location": "742/TALK", "narrator": "ガブリエラ", "text": "ひどいわ！\n$handle$ったら！"},
        { "location": "743/ACT" , "narrator": "", "text": "ごめんね、わからなくて"},
        { "location": "744/TALK", "narrator": "ガブリエラ", "text": "……………………。"},
        { "location": "745/TALK", "narrator": "ガブリエラ", "text": "わかってくれたら\nいいわよ……。"},
        { "location": "748/TALK", "narrator": "ガブリエラ", "text": "あたし。"},
        { "location": "749/TALK", "narrator": "ガブリエラ", "text": "今日はずっと\n笑っていようって\n思ってたの。"},
        { "location": "751/TALK", "narrator": "ガブリエラ", "text": "幸せな一日に\nしようって\n思ってたの。"},
        { "location": "753/TALK", "narrator": "ガブリエラ", "text": "それなのに…。"},
        { "location": "754/SEL" , "narrator": "", "text": "$me$はすごく幸せ"},
        { "location": "755/SEL" , "narrator": "", "text": "ガブリエラは\n幸せじゃないの？"},
        { "location": "756/SEL" , "narrator": "", "text": "幸せな一日だよ"},
        { "location": "757/ACT" , "narrator": "", "text": "$me$はすごく幸せ"},
        { "location": "759/TALK", "narrator": "ガブリエラ", "text": "…本当に？"},
        { "location": "760/ACT" , "narrator": "", "text": "ガブリエラは\n幸せじゃないの？"},
        { "location": "762/TALK", "narrator": "ガブリエラ", "text": "…幸せになりたいって\n思ってるわ。"},
