{
    "dir": "chap00/battle/btev_sc_05_00_02.js",
    "type": "",
    "info": {
        "story_id": "55",
        "cid": "",
        "title": "【EXストーリー】粛清の刃",
        "sub_title": "シンクロストーリー"
    },
    "entry":
    [
        { "location": "183/SCENARIO", "narrator": "", "text": "【結果】ヒストンシャペロン"},
        { "location": "199/TALK"    , "narrator": "アーヤ", "text": "お疲れさま。\n大変だったでしょう。\n疲れてない？"},
        { "location": "200/TALK"    , "narrator": "アーヤ", "text": "$handle$さんが\n頑張ってくれたお陰で\n『コネクト』は完了。"},
        { "location": "201/TALK"    , "narrator": "アーヤ", "text": "シャペロンの\nココロの中の\n抵抗は消えたわ。"},
        { "location": "202/TALK"    , "narrator": "アーヤ", "text": "$handle$さんと\n繋がる準備ができた、\nってことね。"},
        { "location": "203/SEL"     , "narrator": "（選択肢）", "text": "次は『シンクロ』だよね"},
        { "location": "204/ACT"     , "narrator": "", "text": "次は『シンクロ』だよね"},
        { "location": "206/TALK"    , "narrator": "アーヤ", "text": "はい。\nよくできました。"},
        { "location": "207/TALK"    , "narrator": "アーヤ", "text": "シンクロをすると、\nシャペロンの想いが\n流れ込むわ。"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "$handle$さんは、\nそれを受けとめて\nあげてほしい。"},
        { "location": "209/TALK"    , "narrator": "アーヤ", "text": "準備はいい？"},
        { "location": "210/SEL"     , "narrator": "（選択肢）", "text": "はい"},
        { "location": "211/SEL"     , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "212/ACT"     , "narrator": "", "text": "はい"},
        { "location": "213/TALK"    , "narrator": "アーヤ", "text": "じゃあココロを\n繋げるわね。"},
        { "location": "214/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "216/TALK"    , "narrator": "アーヤ", "text": "え！？\nここまで来て？"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "でも$handle$さんの\n心の準備も\nいるものね。"},
        { "location": "218/TALK"    , "narrator": "アーヤ", "text": "準備ができたら\nいつでも来て。\nじゃ、バイバイ。"},
        { "location": "226/TALK"    , "narrator": "アーヤ", "text": "EXEC_SYNC_SPHERE/."},
        { "location": "239/DIALOG"  , "narrator": "", "text": "国を創るのが政治家なら\n国を潰すのもまた政治家――"},
        { "location": "246/DIALOG"  , "narrator": "", "text": "クランイラスト先読み"},
        { "location": "257/DIALOG"  , "narrator": "", "text": "武島ちづる（発症当時３４歳）石川県金沢市で生を受ける。独身。\n\n正義感が強く、一流大の法学部を卒業後国政にかかわるため上京。その学歴を買われて当時非常に影響力の強かった一人の代議士に秘書として迎えられる。"},
        { "location": "258/DIALOG"  , "narrator": "", "text": "代議士はちづるの信念と正義に共感し、徐々に彼女を認めていく。そして最終的には、国際政治に関する極秘事項をも共有するほどの信頼関係になっていた。"},
        { "location": "259/DIALOG"  , "narrator": "", "text": "そんな彼女の華々しい人生も、非常に短い期間で終焉を迎えることとなる。彼女の代議士を良しとしないグローバリストたちによって、彼は亡き者にされたのである。急性心不全ということで片付けられた彼の死。そこに疑問を持ったちづるは、自らの全時間を捧げ、その真実に立ち向かった。"},
        { "location": "260/DIALOG"  , "narrator": "", "text": "長きにわたる追求の末に、ちづるは代議士の死の真実とその裏付けを得ることに成功。それらの情報を世間にリークし、現与党とグローバリストの陰謀を赤裸々にすべく、行動に出る。だが、彼女は一歩、彼らより出遅れた。そしてちづるもまた、謂われのない汚職疑惑の罠にはまってしまうのである。"},
        { "location": "265/DIALOG"  , "narrator": "", "text": "謂われもない献金疑惑で逮捕されるちづる。このままでは日本が終わってしまう。自らはどうなってもよい、何としてもこの事を国民に伝えなければ。その想いが彼女を発症させた。"},
        { "location": "270/DIALOG"  , "narrator": "", "text": "ちづるの描いたシナリオは、発症した地・永田町に巨大な隕石を降らせるというものである。この国の腐敗しきった政治をリセットし、またゼロから始めるために。"},
        { "location": "271/DIALOG"  , "narrator": "", "text": "同時にそれは、この誠実そうなこの国の、どこまでもどす黒い真の姿を垣間見た彼女の悲痛な心の叫びを体現したものなのかもしれない。"},
        { "location": "288/TALK"    , "narrator": "アーヤ", "text": "シャペロンの\n過去を知って\nどう思った？"},
        { "location": "289/SEL"     , "narrator": "（選択肢）", "text": "才女の末路？"},
        { "location": "290/SEL"     , "narrator": "（選択肢）", "text": "腐敗政治に鉄槌を！"},
        { "location": "291/SEL"     , "narrator": "（選択肢）", "text": "永田町には鬼が住むって本当なんだ"},
        { "location": "292/ACT"     , "narrator": "", "text": "才女の末路？"},
        { "location": "293/TALK"    , "narrator": "アーヤ", "text": "シャペロンが\n男性だったら\n違う道があった？"},
        { "location": "294/TALK"    , "narrator": "アーヤ", "text": "そんなことは\n本人にも\nわからないと思うわ。"},
        { "location": "295/TALK"    , "narrator": "アーヤ", "text": "私にわかるのは\nシャペロンの正義が\n叶わなかった悔しさだけ。"},
        { "location": "296/ACT"     , "narrator": "", "text": "腐敗政治に鉄槌を！"},
        { "location": "297/TALK"    , "narrator": "アーヤ", "text": "勇ましいわね。"},
        { "location": "298/TALK"    , "narrator": "アーヤ", "text": "政治に関わるかどうかに\n関係なく、みんなが\nそう考えていたなら。"},
        { "location": "299/TALK"    , "narrator": "アーヤ", "text": "こんな悲劇も\n起こらなかった\nでしょうね。"},
        { "location": "300/ACT"     , "narrator": "", "text": "永田町には鬼が住むって本当なんだ"},
        { "location": "301/TALK"    , "narrator": "アーヤ", "text": "そうね。\nその通り。"},
        { "location": "302/TALK"    , "narrator": "アーヤ", "text": "鬼が何を指すかは\nあえて\n聞かないでおくわ。"},
        { "location": "305/TALK"    , "narrator": "アーヤ", "text": "そして私は……。"},
        { "location": "306/TALK"    , "narrator": "アーヤ", "text": "シャペロンほどの\n勇気はないかも\nしれない。"},
        { "location": "307/TALK"    , "narrator": "アーヤ", "text": "シャペロンほど全力で\n人生を生きていない\nかもしれない。"},
        { "location": "308/TALK"    , "narrator": "アーヤ", "text": "それでも。"},
        { "location": "309/TALK"    , "narrator": "アーヤ", "text": "できるだけ全力で\n生きていきたい。"},
        { "location": "310/TALK"    , "narrator": "アーヤ", "text": "自分の正義を\n貫きたい。"},
        { "location": "311/TALK"    , "narrator": "アーヤ", "text": "そういう思いに\n共感したの。"},
        { "location": "312/SEL"     , "narrator": "（選択肢）", "text": "よくわからないな…"},
        { "location": "313/SEL"     , "narrator": "（選択肢）", "text": "正義とは、強者の利益にほかならず"},
        { "location": "314/SEL"     , "narrator": "（選択肢）", "text": "正しいことを正しいと言っていこう"},
        { "location": "315/ACT"     , "narrator": "", "text": "よくわからないな…"},
        { "location": "316/TALK"    , "narrator": "アーヤ", "text": "考えは\n人それぞれ\nだものね。"},
        { "location": "317/ACT"     , "narrator": "", "text": "正義とは、強者の利益にほかならず"},
        { "location": "318/TALK"    , "narrator": "アーヤ", "text": "力だけではダメよね。\n理想論だけでも、\n自分のことばかりでも。"},
        { "location": "319/ACT"     , "narrator": "", "text": "正しいことを正しいと言っていこう"},
        { "location": "320/TALK"    , "narrator": "アーヤ", "text": "事なかれ主義で\n生きていきたくは\nないわ。"},
        { "location": "323/TALK"    , "narrator": "アーヤ", "text": "シャペロンも\n私に好意を\n持ってくれてるはず。"},
        { "location": "324/TALK"    , "narrator": "アーヤ", "text": "私を見ていると\n若い頃のことを\n思い出すらしいし。"},
        { "location": "325/TALK"    , "narrator": "アーヤ", "text": "だから私、\n彼女の期待に\n応えたいと思ってる。"},
        { "location": "326/TALK"    , "narrator": "アーヤ", "text": "彼女が私を\nフォローして\nくれてるみたいに。"},
        { "location": "327/TALK"    , "narrator": "アーヤ", "text": "…ところでね。"},
        { "location": "328/TALK"    , "narrator": "アーヤ", "text": "彼女は普段\nとっても無口なの。"},
        { "location": "329/TALK"    , "narrator": "アーヤ", "text": "それから力も\nとても強いから\nちょっと怖がられてる。"},
        { "location": "330/TALK"    , "narrator": "アーヤ", "text": "でも$handle$さんも\n知ってるとおり\n本当は強くて優しいの。"},
        { "location": "331/TALK"    , "narrator": "アーヤ", "text": "そんなところも\nちょっと格好いいと\n思うのよ。"},
        { "location": "333/TALK"    , "narrator": "アーヤ", "text": "だから末永く\n仲良くしてあげてね。"},
        { "location": "334/SEL"     , "narrator": "（選択肢）", "text": "大丈夫、心配しないで"},
        { "location": "335/SEL"     , "narrator": "（選択肢）", "text": "他の子に目移りするかも"},
        { "location": "336/ACT"     , "narrator": "", "text": "大丈夫、心配しないで"},
        { "location": "338/TALK"    , "narrator": "アーヤ", "text": "$handle$さんなら\n大丈夫よね。"},
        { "location": "339/ACT"     , "narrator": "", "text": "他の子に目移りするかも"},
        { "location": "341/TALK"    , "narrator": "アーヤ", "text": "そんな言い方…。\n彼女じゃないん\nだから。"},
        { "location": "343/TALK"    , "narrator": "アーヤ", "text": "もちろん他の\nクランが気になったら。"},
        { "location": "344/TALK"    , "narrator": "アーヤ", "text": "私か他の誰かが\nナビをするはず。\nその時はよろしくね。"}
    ]
}
