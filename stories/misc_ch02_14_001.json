    [
        { "location": "7/SCENARIO", "narrator": "", "text": "00-00_妄想という怪物"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "お話にも肩があるのよ"},
        { "location": "34/SEL"    , "narrator": "", "text": "ええと？"},
        { "location": "35/SEL"    , "narrator": "", "text": "肩って何なの"},
        { "location": "36/SEL"    , "narrator": "", "text": "骨組みが必要ってことかな"},
        { "location": "37/ACT"    , "narrator": "", "text": "ええと？"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "枠組みとか"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "あ"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "型ね"},
        { "location": "41/ACT"    , "narrator": "", "text": "肩って何なの"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "あ"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "型"},
        { "location": "44/ACT"    , "narrator": "", "text": "骨組みが必要ってことかな"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "そうそう"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "そういうことよ"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "わかってくれてて嬉しいわ"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "でね"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "子供が物語の型に気づくのは"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "4歳児くらいだって言われてるのよ"},
        { "location": "55/SEL"    , "narrator": "", "text": "へー"},
        { "location": "56/SEL"    , "narrator": "", "text": "勉強熱心だね"},
        { "location": "57/SEL"    , "narrator": "", "text": "アーヤと$me$はハッピーエンド"},
        { "location": "58/ACT"    , "narrator": "", "text": "へー"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "知ってた？"},
        { "location": "60/ACT"    , "narrator": "", "text": "勉強熱心だね"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "まあ"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "習ったところなだけなんだけどもね"},
        { "location": "64/ACT"    , "narrator": "", "text": "アーヤと$me$はハッピーエンド"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "またすぐそういうことばっかり"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "どうせなら"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "ハッピーエンドがいいわよね"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "そんでもって、"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "型にはまったら物語だけど"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "はまりきれないままなのは妄想なのかもしれないって"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "思ったりするのよね"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "こういう考えって"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "極論かしらね"}
    ]
}
