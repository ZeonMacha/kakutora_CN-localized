        { "location": "95/SCENARIO", "narrator": "", "text": "020_甘い涙があればいいのに"},
        { "location": "120/TALK"   , "narrator": "ガブリエラ", "text": "子供って素直でかわいいわね"},
        { "location": "122/SEL"    , "narrator": "", "text": "ガブも子供だよね"},
        { "location": "123/SEL"    , "narrator": "", "text": "そうかなー？"},
        { "location": "124/SEL"    , "narrator": "", "text": "お姉さんの自覚がでてきた？"},
        { "location": "125/TALK"   , "narrator": "ガブリエラ", "text": "生意気なところもあるけど"},
        { "location": "127/ACT"    , "narrator": "", "text": "ガブも子供だよね"},
        { "location": "128/TALK"   , "narrator": "ガブリエラ", "text": "違うわよ！！！！！！"},
        { "location": "129/ACT"    , "narrator": "", "text": "そうかなー？"},
        { "location": "130/TALK"   , "narrator": "ガブリエラ", "text": "そうよ？"},
        { "location": "131/ACT"    , "narrator": "", "text": "お姉さんの自覚がでてきた？"},
        { "location": "133/TALK"   , "narrator": "ガブリエラ", "text": "お姉さんｖｖｖ"},
        { "location": "134/TALK"   , "narrator": "ガブリエラ", "text": "なんて言って"},
        { "location": "136/TALK"   , "narrator": "ガブリエラ", "text": "私"},
        { "location": "137/TALK"   , "narrator": "ガブリエラ", "text": "先輩なんだから！"},
        { "location": "139/TALK"   , "narrator": "ガブリエラ", "text": "なんか"},
        { "location": "140/TALK"   , "narrator": "ガブリエラ", "text": "小さい頃のこと"},
        { "location": "141/TALK"   , "narrator": "ガブリエラ", "text": "思い出しちゃったわ"},
        { "location": "143/SEL"    , "narrator": "", "text": "いや、今も小さいよね？"},
        { "location": "144/SEL"    , "narrator": "", "text": "大切な思い出があるんだね"},
        { "location": "145/SEL"    , "narrator": "", "text": "そっかー"},
        { "location": "146/ACT"    , "narrator": "", "text": "いや、今も小さいよね？"},
        { "location": "147/TALK"   , "narrator": "ガブリエラ", "text": "そんなこと"},
        { "location": "148/TALK"   , "narrator": "ガブリエラ", "text": "ないったら！！！！！！！"},
        { "location": "149/ACT"    , "narrator": "", "text": "大切な思い出があるんだね"},
        { "location": "151/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "152/TALK"   , "narrator": "ガブリエラ", "text": "とても大事な思い出"},
        { "location": "153/TALK"   , "narrator": "ガブリエラ", "text": "もう今は"},
        { "location": "155/TALK"   , "narrator": "ガブリエラ", "text": "叶うことのない思い出"},
        { "location": "156/ACT"    , "narrator": "", "text": "そっかー"},
        { "location": "157/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよ"},
        { "location": "160/TALK"   , "narrator": "ガブリエラ", "text": "不思議ね"},
        { "location": "162/TALK"   , "narrator": "ガブリエラ", "text": "楽しい思い出なのに"},
        { "location": "163/TALK"   , "narrator": "ガブリエラ", "text": "思い出したら涙が出るなんて"}
