    "entry":
    [
        { "location": "3501/SCENARIO", "narrator": "", "text": "真・おでん缶伝説"},
        { "location": "3526/TALK"    , "narrator": "神楽", "text": "アキバの名物と言えば"},
        { "location": "3527/TALK"    , "narrator": "神楽", "text": "おでん缶だと思うのだけれども"},
        { "location": "3529/SEL"     , "narrator": "", "text": "そうなんだ？"},
        { "location": "3530/SEL"     , "narrator": "", "text": "そうだよね！"},
        { "location": "3531/SEL"     , "narrator": "", "text": "そういうことにしとく"},
        { "location": "3532/ACT"     , "narrator": "", "text": "そうなんだ？"},
        { "location": "3533/TALK"    , "narrator": "神楽", "text": "そうだから"},
        { "location": "3534/ACT"     , "narrator": "", "text": "そうだよね！"},
        { "location": "3536/TALK"    , "narrator": "神楽", "text": "でしょでしょ！！！"},
        { "location": "3538/TALK"    , "narrator": "神楽", "text": "偉いぞ$handlek$"},
        { "location": "3539/TALK"    , "narrator": "神楽", "text": "わかってる！"},
        { "location": "3540/ACT"     , "narrator": "", "text": "そういうことにしとく"},
        { "location": "3541/TALK"    , "narrator": "神楽", "text": "感じ悪いなー"},
        { "location": "3543/TALK"    , "narrator": "神楽", "text": "おでん缶はやっぱり自販機で！"},
        { "location": "3544/TALK"    , "narrator": "神楽", "text": "ナウでヤングなアキバキッズはこれ一択ダヨネー"},
        { "location": "3546/SEL"     , "narrator": "", "text": "いやナウでもヤングでもないから…"},
        { "location": "3547/SEL"     , "narrator": "", "text": "お、おう"},
        { "location": "3548/SEL"     , "narrator": "", "text": "神楽のために買い占めるよ！"},
        { "location": "3549/ACT"     , "narrator": "", "text": "いやナウでもヤングでもないから…"},
        { "location": "3550/TALK"    , "narrator": "神楽", "text": "そっかー"},
        { "location": "3552/TALK"    , "narrator": "神楽", "text": "なら仕方ないねー"},
        { "location": "3553/ACT"     , "narrator": "", "text": "お、おう"},
        { "location": "3554/TALK"    , "narrator": "神楽", "text": "反応悪いね？"},
        { "location": "3555/ACT"     , "narrator": "", "text": "神楽のために買い占めるよ！"},
        { "location": "3557/TALK"    , "narrator": "神楽", "text": "やだ素敵"},
        { "location": "3558/TALK"    , "narrator": "神楽", "text": "よーしぴょんこおでん缶でマンション建てちゃうぞー！"},
        { "location": "3559/TALK"    , "narrator": "神楽", "text": "非常時には食べちゃうぞー！"},
        { "location": "3561/TALK"    , "narrator": "神楽", "text": "だからといってぴょんこがおでん好きかというと全くそうではないぴょん"},
        { "location": "3562/TALK"    , "narrator": "神楽", "text": "そこんとこよろしくね！"}
    ]
}
