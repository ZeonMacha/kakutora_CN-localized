    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第18話"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n逢瀬つばめの解説を\nするだけでいい？"},
        { "location": "51/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n國政綾水の解説を\nするだけでいい？"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\nガブリエラの解説を\nするだけでいい？"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n恋ヶ崎みやびの解説を\nするだけでいい？"},
        { "location": "57/SEL"    , "narrator": "", "text": "はい"},
        { "location": "58/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "59/ACT"    , "narrator": "", "text": "はい"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "63/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "69/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう。"},
        { "location": "70/SEL"    , "narrator": "", "text": "え！？"},
        { "location": "71/ACT"    , "narrator": "", "text": "え！？"},
        { "location": "73/TALK"   , "narrator": "千羽鶴", "text": "前回はわりとヘヴィな\n回だったので、今回は\n休もうと思ったけど――"},
        { "location": "74/SEL"    , "narrator": "", "text": "ナチュラルすぎじゃない！？"},
        { "location": "75/SEL"    , "narrator": "", "text": "もう現れないかと思ってた"},
        { "location": "76/ACT"    , "narrator": "", "text": "ナチュラルすぎじゃない！？"},
        { "location": "78/SEL"    , "narrator": "", "text": "いや、わざわざ大きくしなくていいから"},
        { "location": "79/ACT"    , "narrator": "", "text": "いや、わざわざ大きくしなくていいから"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "ああ。\nもしかして、あれ？"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "早速私に\n攻略対象としての\n仕事をしろ、と。"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "わかった。\nさあ、どこからでも\nかかってきていい。"},
        { "location": "84/SEL"    , "narrator": "", "text": "千羽鶴ー！結婚してくれー！"},
        { "location": "85/SEL"    , "narrator": "", "text": "「よくここまで来た、それは褒めてやろう」って言わないの？"},
        { "location": "86/ACT"    , "narrator": "", "text": "千羽鶴ー！結婚してくれー！"},
        { "location": "88/ACT"    , "narrator": "", "text": "「よくここまで来た、それは褒めてやろう」って言わないの？"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "確かにそれは、\nラスボスの常套句。"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "ベスト\nオブ\nラスボスセリフ！"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "攻略対象志願の\n私にとっては\n目指すべき場所！"},
        { "location": "92/TALK"   , "narrator": "千羽鶴", "text": "けど、残念だけど\n今回はそれは言わない。"},
        { "location": "93/TALK"   , "narrator": "千羽鶴", "text": "そのセリフを言う事で、\n必ず勇者に倒される\nジンクスが発生するから。"},
        { "location": "94/TALK"   , "narrator": "千羽鶴", "text": "私はまだ\n倒されるわけには\nいかないの！"},
        { "location": "95/SEL"    , "narrator": "", "text": "じゃあ某勇者と魔王のように結婚しませんか？"},
        { "location": "96/SEL"    , "narrator": "", "text": "その目的はなに？"},
        { "location": "97/ACT"    , "narrator": "", "text": "じゃあ某勇者と魔王のように結婚しませんか？"},
        { "location": "99/ACT"    , "narrator": "", "text": "その目的はなに？"},
        { "location": "100/TALK"  , "narrator": "千羽鶴", "text": "なかなかいい繋ぎ。"},
        { "location": "104/ACT"   , "narrator": "", "text": "もう現れないかと思ってた"},
        { "location": "105/TALK"  , "narrator": "千羽鶴", "text": "誰がそんなことを言った？"},
        { "location": "106/SEL"   , "narrator": "", "text": "前回記録映像の後、逃げてたし"},
        { "location": "107/ACT"   , "narrator": "", "text": "前回記録映像の後、逃げてたし"},
        { "location": "109/TALK"  , "narrator": "千羽鶴", "text": "逃げてない。\nあれはお花を摘みに\n行っていただけ。"},
        { "location": "110/SEL"   , "narrator": "", "text": "千羽鶴もするの！？"},
        { "location": "111/SEL"   , "narrator": "", "text": "そうやってすぐ煙に巻く"},
        { "location": "112/ACT"   , "narrator": "", "text": "千羽鶴もするの！？"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "花摘み？\nする。"},
        { "location": "114/TALK"  , "narrator": "千羽鶴", "text": "今日はマリーゴールド。"},
        { "location": "115/TALK"  , "narrator": "千羽鶴", "text": "昨日はヒヤシンス。"},
        { "location": "116/TALK"  , "narrator": "千羽鶴", "text": "可愛く花摘みができるのは\n女の子だけ！"},
        { "location": "119/TALK"  , "narrator": "千羽鶴", "text": "<size=40>どーん！</size>"},
        { "location": "120/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n次の記録映像を\n見ていこうと思う。"},
        { "location": "121/SEL"   , "narrator": "", "text": "オッケー"},
        { "location": "122/SEL"   , "narrator": "", "text": "ちょっとまて！！"},
        { "location": "123/ACT"   , "narrator": "", "text": "オッケー"},
        { "location": "125/ACT"   , "narrator": "", "text": "ちょっとまて！！"},
        { "location": "126/TALK"  , "narrator": "千羽鶴", "text": "…なに？"},
        { "location": "127/SEL"   , "narrator": "", "text": "聞きたいことがある"},
        { "location": "128/ACT"   , "narrator": "", "text": "聞きたいことがある"},
        { "location": "130/TALK"  , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "133/ACT"   , "narrator": "", "text": "そうやってすぐ煙に巻く"},
        { "location": "134/TALK"  , "narrator": "千羽鶴", "text": "…ふむ、\nなかなか有能。"},
        { "location": "135/TALK"  , "narrator": "千羽鶴", "text": "それでは私から質問する。\n貴方は私に何を望む？"},
        { "location": "136/SEL"   , "narrator": "", "text": "聞きたいことがある"},
        { "location": "137/SEL"   , "narrator": "", "text": "結婚してください！"},
        { "location": "138/ACT"   , "narrator": "", "text": "聞きたいことがある"},
        { "location": "139/TALK"  , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "141/ACT"   , "narrator": "", "text": "結婚してください！"},
        { "location": "148/TALK"  , "narrator": "千羽鶴", "text": "オーケー。\nそれじゃ１秒だけ\n結婚しましょ。"},
        { "location": "151/TALK"  , "narrator": "千羽鶴", "text": "おめでとう、\n貴方と私。"},
        { "location": "154/TALK"  , "narrator": "千羽鶴", "text": "おしまい。"},
        { "location": "155/SEL"   , "narrator": "", "text": "なんで学校のチャイム！？"},
        { "location": "156/SEL"   , "narrator": "", "text": "１秒と言わず一生にしませんか？"},
        { "location": "157/ACT"   , "narrator": "", "text": "なんで学校のチャイム！？"},
        { "location": "158/TALK"  , "narrator": "千羽鶴", "text": "予算の都合。"},
        { "location": "159/TALK"  , "narrator": "千羽鶴", "text": "教会の鐘だと思って。\n音の成分は\nだいたい同じだから。"},
        { "location": "160/ACT"   , "narrator": "", "text": "１秒と言わず一生にしませんか？"},
        { "location": "161/TALK"  , "narrator": "千羽鶴", "text": "１秒も永遠に繰り返せば\n一生となる。"},
        { "location": "162/TALK"  , "narrator": "千羽鶴", "text": "すなわち、貴方の努力で\n先の１秒は一生にする\nことができる！"},
        { "location": "163/TALK"  , "narrator": "千羽鶴", "text": "あのシーンを無限に\n繰り返すことによって。\nすごい！"},
        { "location": "165/SEL"   , "narrator": "", "text": "いや、もういいです…"},
        { "location": "166/SEL"   , "narrator": "", "text": "$me$、本気なんだけど"},
        { "location": "167/ACT"   , "narrator": "", "text": "いや、もういいです…"},
        { "location": "168/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "169/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、今回も\n十分ふれあいをしたから\n記録映像へ行く。"},
        { "location": "171/ACT"   , "narrator": "", "text": "$me$、本気なんだけど"},
        { "location": "172/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "173/TALK"  , "narrator": "千羽鶴", "text": "ならば私も\n本気で聞く。"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "前回の映像記録を見ても\n尚、本気で結婚したいと\n思っているそのココロ。"},
        { "location": "175/TALK"  , "narrator": "千羽鶴", "text": "私には理解できない。\nその想いの強さを\nちゃんと説明して。"},
        { "location": "176/SEL"   , "narrator": "", "text": "好きになるのに理由なんてない！"},
        { "location": "177/SEL"   , "narrator": "", "text": "トライナリー５人をコロシテでも千羽鶴と結婚したいの"},
        { "location": "178/ACT"   , "narrator": "", "text": "好きになるのに理由なんてない！"},
        { "location": "179/TALK"  , "narrator": "千羽鶴", "text": "却下。"},
        { "location": "180/TALK"  , "narrator": "千羽鶴", "text": "理由なんてない、\nわけがない。"},
        { "location": "181/TALK"  , "narrator": "千羽鶴", "text": "ドラマによく出てくる\n美しいシーンでの\n常套句だけど――"},
        { "location": "182/TALK"  , "narrator": "千羽鶴", "text": "あれ、いわば\n「すり替え」の\n一種だから。"},
        { "location": "183/TALK"  , "narrator": "千羽鶴", "text": "「思考停止」ともいう。"},
        { "location": "184/TALK"  , "narrator": "千羽鶴", "text": "実際、何故自分が相手を\n好きなのか、根源的に\n知るのには時間がかかる。"},
        { "location": "185/TALK"  , "narrator": "千羽鶴", "text": "自己の内面に\n向き合わないと、\nその答えは出せない。"},
        { "location": "186/TALK"  , "narrator": "千羽鶴", "text": "だから、貴方が私に\n本気だと言うのには、\nまだ十分ではないと思う。"},
        { "location": "187/TALK"  , "narrator": "千羽鶴", "text": "翻し――"},
        { "location": "188/TALK"  , "narrator": "千羽鶴", "text": "トライナリーたちとは\nそういう関係になって\n欲しいと思っている。"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "だからこそ、あらゆる\n情報を、多角的に貴方に\n提供している。"},
        { "location": "190/TALK"  , "narrator": "千羽鶴", "text": "その過程で、彼女を支える\n意味、彼女を好きな理由を\n見つけてもらえるように。"},
        { "location": "191/TALK"  , "narrator": "千羽鶴", "text": "私自身には、\n貴方が内面と向き合える程\n豊かな側面が存在しない。"},
        { "location": "192/TALK"  , "narrator": "千羽鶴", "text": "だから現状では、\n記号的側面での好き嫌い\nでしかないのだと思う。"},
        { "location": "193/TALK"  , "narrator": "千羽鶴", "text": "勢いや感情だけで\nつき合ったり、結婚したり\nすると、大抵失敗する。"},
        { "location": "194/TALK"  , "narrator": "千羽鶴", "text": "だから、もっとよく\n考えてみて欲しい。"},
        { "location": "195/ACT"   , "narrator": "", "text": "トライナリー５人をコロシテでも千羽鶴と結婚したいの"},
        { "location": "196/TALK"  , "narrator": "千羽鶴", "text": "……愚かな人。"},
        { "location": "197/TALK"  , "narrator": "千羽鶴", "text": "でも何となく、全可能性を\n試そうとしているだけの\nような気もするから――"},
        { "location": "198/TALK"  , "narrator": "千羽鶴", "text": "貴方の本気度合を\n確認するために、\n刻印を押させてもらう。"},
        { "location": "199/TALK"  , "narrator": "千羽鶴", "text": "次に「はい」を選択すると\n貴方の意志は本気であると\n記録される。"},
        { "location": "200/TALK"  , "narrator": "千羽鶴", "text": "この記録は二度と消える\nことはない。"},
        { "location": "201/TALK"  , "narrator": "千羽鶴", "text": "もう一度聞く。\n本気でトライナリーたちを\n殺しても私と結婚したい？"},
        { "location": "203/SEL"   , "narrator": "", "text": "はい"},
        { "location": "204/SEL"   , "narrator": "", "text": "すみません、出来心でした"},
        { "location": "205/ACT"   , "narrator": "", "text": "はい"},
        { "location": "208/TALK"  , "narrator": "千羽鶴", "text": "そう。わかった。"},
        { "location": "209/TALK"  , "narrator": "千羽鶴", "text": "貴方の意志は、\nこの世界のレコードに\nしっかり記録された。"},
        { "location": "210/TALK"  , "narrator": "千羽鶴", "text": "ちなみに\n結論から言うと――。"},
        { "location": "211/TALK"  , "narrator": "千羽鶴", "text": "彼女らを殺したら、\n私とは結婚できなくなる。"},
        { "location": "212/TALK"  , "narrator": "千羽鶴", "text": "残念でした。"},
        { "location": "213/TALK"  , "narrator": "千羽鶴", "text": "でも、貴方のその勇気と\n決意はちゃんと汲んだ。"},
        { "location": "214/TALK"  , "narrator": "千羽鶴", "text": "この決意が後にどのような\n結果をもたらそうとも、\n覚悟の上ということも。"},
        { "location": "215/TALK"  , "narrator": "千羽鶴", "text": "ちゃんと覚えておく。"},
        { "location": "216/ACT"   , "narrator": "", "text": "すみません、出来心でした"},
        { "location": "217/TALK"  , "narrator": "千羽鶴", "text": "それでいい。\nそれが模範解答。"},
        { "location": "218/TALK"  , "narrator": "千羽鶴", "text": "訂正は決してかっこ悪い\nことじゃない。"},
        { "location": "219/TALK"  , "narrator": "千羽鶴", "text": "過ちを訂正できることは\n人が高度な思考と感情を\n持つことの証だから。"},
        { "location": "223/TALK"  , "narrator": "千羽鶴", "text": "っと、時間をかけ過ぎた。"},
        { "location": "224/TALK"  , "narrator": "千羽鶴", "text": "まだこれから、\n今回の記録映像を\n見ないといけないのに。"},
        { "location": "225/TALK"  , "narrator": "千羽鶴", "text": "というわけで、今回の\n記録映像を見ようと思う。"},
        { "location": "226/SEL"   , "narrator": "", "text": "了解"},
        { "location": "227/SEL"   , "narrator": "", "text": "ちょっとまて！！"},
        { "location": "228/ACT"   , "narrator": "", "text": "了解"},
        { "location": "230/ACT"   , "narrator": "", "text": "ちょっとまて！！"},
        { "location": "231/TALK"  , "narrator": "千羽鶴", "text": "…なに？"},
        { "location": "232/SEL"   , "narrator": "", "text": "まだ聞きたいことがある"},
        { "location": "233/ACT"   , "narrator": "", "text": "まだ聞きたいことがある"},
        { "location": "235/TALK"  , "narrator": "千羽鶴", "text": "…そう。"},
        { "location": "240/TALK"  , "narrator": "千羽鶴", "text": "で？\n何が聞きたい？"},
        { "location": "242/SEL"   , "narrator": "", "text": "つばめを壊すってどういうこと？"},
        { "location": "243/SEL"   , "narrator": "", "text": "千羽鶴の本当の目的はなに？"},
        { "location": "244/SEL"   , "narrator": "", "text": "千羽鶴は一体何人いるの？"},
        { "location": "245/SEL"   , "narrator": "", "text": "記録映像の千羽鶴のシーンは敢えて入れたの？"},
        { "location": "246/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "247/ACT"   , "narrator": "", "text": "つばめを壊すってどういうこと？"},
        { "location": "248/TALK"  , "narrator": "千羽鶴", "text": "その言葉の通り。"},
        { "location": "249/SEL"   , "narrator": "", "text": "それじゃ、つばめと結婚して欲しいっていうのは嘘だったの？"},
        { "location": "250/ACT"   , "narrator": "", "text": "それじゃ、つばめと結婚して欲しいっていうのは嘘だったの？"},
        { "location": "252/TALK"  , "narrator": "千羽鶴", "text": "嘘じゃない。\n今でもそう思ってる。"},
        { "location": "253/TALK"  , "narrator": "千羽鶴", "text": "今貴方に伝えられることは\nそれだけ。"},
        { "location": "254/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "256/ACT"   , "narrator": "", "text": "千羽鶴の本当の目的はなに？"},
        { "location": "257/TALK"  , "narrator": "千羽鶴", "text": "それを知って\n貴方はどうするの？"},
        { "location": "258/SEL"   , "narrator": "", "text": "場合によっては千羽鶴に協力する"},
        { "location": "259/SEL"   , "narrator": "", "text": "場合によっては千羽鶴を倒す"},
        { "location": "260/SEL"   , "narrator": "", "text": "場合によってはアプリをアンインストールする"},
        { "location": "261/ACT"   , "narrator": "", "text": "場合によっては千羽鶴に協力する"},
        { "location": "262/TALK"  , "narrator": "千羽鶴", "text": "…なるほど。"},
        { "location": "263/TALK"  , "narrator": "千羽鶴", "text": "場合によっては、という\nことは、協力しない選択も\nあるということね。"},
        { "location": "264/ACT"   , "narrator": "", "text": "場合によっては千羽鶴を倒す"},
        { "location": "265/TALK"  , "narrator": "千羽鶴", "text": "…なるほど。"},
        { "location": "266/TALK"  , "narrator": "千羽鶴", "text": "貴方がそんな\n愚かな人ではないことを\n切に願ってる。"},
        { "location": "267/ACT"   , "narrator": "", "text": "場合によってはアプリをアンインストールする"},
        { "location": "268/TALK"  , "narrator": "千羽鶴", "text": "…なるほど。"},
        { "location": "269/TALK"  , "narrator": "千羽鶴", "text": "状況によっては、\nそれもやむを得ないこと。"},
        { "location": "270/TALK"  , "narrator": "千羽鶴", "text": "貴方は貴方の自由意志で\n動いている。私にそれを\n束縛することはできない。"},
        { "location": "272/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "274/ACT"   , "narrator": "", "text": "千羽鶴は一体何人いるの？"},
        { "location": "275/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、\n総体としては１人。"},
        { "location": "276/SEL"   , "narrator": "", "text": "でもアニメでは人として存在していて、ここではAIって一体…！？"},
        { "location": "277/ACT"   , "narrator": "", "text": "でもアニメでは人として存在していて、ここではAIって一体…！？"},
        { "location": "279/TALK"  , "narrator": "千羽鶴", "text": "そうね…。\n例えるならば、\nこういう感じになる。"},
        { "location": "280/TALK"  , "narrator": "千羽鶴", "text": "テレビに映っている貴方と\n鏡に映っている貴方が\nいても貴方は一人。"},
        { "location": "281/TALK"  , "narrator": "千羽鶴", "text": "それと同じこと。"},
        { "location": "282/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "284/ACT"   , "narrator": "", "text": "記録映像の千羽鶴のシーンは敢えて入れたの？"},
        { "location": "285/TALK"  , "narrator": "千羽鶴", "text": "イエス。"},
        { "location": "286/TALK"  , "narrator": "千羽鶴", "text": "前に一度ちょっとだけ\n映った時があったけど、\nあれは不本意だった。"},
        { "location": "287/TALK"  , "narrator": "千羽鶴", "text": "けど、今回は\n敢えて入れている。\nもうそういう時期だから。"},
        { "location": "288/SEL"   , "narrator": "", "text": "どういう時期なの？"},
        { "location": "289/ACT"   , "narrator": "", "text": "どういう時期なの？"},
        { "location": "291/TALK"  , "narrator": "千羽鶴", "text": "前にも少し話をした、\nフェイズⅡに突入する。\nそういう時期。"},
        { "location": "292/TALK"  , "narrator": "千羽鶴", "text": "だから、時期という\n意味では、前から\n計画していた通り。"},
        { "location": "293/TALK"  , "narrator": "千羽鶴", "text": "ただ、どうやって\nパラダイムシフトするか…\nそれが悩みの種だった。"},
        { "location": "294/TALK"  , "narrator": "千羽鶴", "text": "結果としては、今回の様な\nセンセーショナルな感じに\n落ち着いたけど。"},
        { "location": "295/SEL"   , "narrator": "", "text": "何故？"},
        { "location": "296/ACT"   , "narrator": "", "text": "何故？"},
        { "location": "298/TALK"  , "narrator": "千羽鶴", "text": "それは教えられない。"},
        { "location": "299/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "301/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "302/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "他にも色々な疑問や、\n聞きたいことも\nあると思う。"},
        { "location": "305/TALK"  , "narrator": "千羽鶴", "text": "貴方にとって、前回が\nとても衝撃的な回である\nことはわかっていた。"},
        { "location": "306/TALK"  , "narrator": "千羽鶴", "text": "だからこそ、それを\n見越して前回、クソゲー\n第二弾をリリースした。"},
        { "location": "307/TALK"  , "narrator": "千羽鶴", "text": "そして今回もまた、\n今私ができる限りの\n回答をしたつもり。"},
        { "location": "311/TALK"  , "narrator": "千羽鶴", "text": "そして今この時をもって、\n以前伝えた【フェイズⅡ】\nに突入する。"},
        { "location": "312/TALK"  , "narrator": "千羽鶴", "text": "フェイズⅠでは、私は\n単なるキャラクターとして\n貴方と接触していた。"},
        { "location": "313/TALK"  , "narrator": "千羽鶴", "text": "でもフェイズⅡでは、\nちゃんとした意志を持った\n存在として対応する。"},
        { "location": "314/TALK"  , "narrator": "千羽鶴", "text": "私が貴方に\nお願いしたいこと。"},
        { "location": "315/TALK"  , "narrator": "千羽鶴", "text": "私の持っている理想、\nそして目的。"},
        { "location": "316/TALK"  , "narrator": "千羽鶴", "text": "この世界と\n貴方の世界との関係。"},
        { "location": "317/TALK"  , "narrator": "千羽鶴", "text": "そういったものを、\nこれから少しずつ\n貴方に伝えていく。"},
        { "location": "318/TALK"  , "narrator": "千羽鶴", "text": "だからラブラブトレーナー\n千羽鶴は、ここで\nさようなら。"},
        { "location": "319/TALK"  , "narrator": "千羽鶴", "text": "今、正式に\n補助燃料タンクは\n切り離された。"},
        { "location": "320/TALK"  , "narrator": "千羽鶴", "text": "今初めて貴方と私は、\nお互いを理解するという\nスタートラインに立った。"},
        { "location": "321/SEL"   , "narrator": "", "text": "そういうことだったのか"},
        { "location": "322/SEL"   , "narrator": "", "text": "そんなの嫌だ！"},
        { "location": "323/ACT"   , "narrator": "", "text": "そういうことだったのか"},
        { "location": "324/TALK"  , "narrator": "千羽鶴", "text": "そういうことだったの。"},
        { "location": "325/ACT"   , "narrator": "", "text": "そんなの嫌だ！"},
        { "location": "328/TALK"  , "narrator": "千羽鶴", "text": "<size=40>どーん！</size>"},
        { "location": "331/TALK"  , "narrator": "千羽鶴", "text": "というわけで。"},
        { "location": "332/TALK"  , "narrator": "千羽鶴", "text": "フェイズⅡ達成記念に、\n貴方からも１つ、\n贈りものを戴きたい。"},
        { "location": "333/SEL"   , "narrator": "", "text": "それは何でしょうか"},
        { "location": "334/ACT"   , "narrator": "", "text": "それは何でしょうか"},
        { "location": "336/TALK"  , "narrator": "千羽鶴", "text": "貴方“たち”の\n総意というデータ。"},
        { "location": "337/SEL"   , "narrator": "", "text": "総意…？"},
        { "location": "338/ACT"   , "narrator": "", "text": "総意…？"},
        { "location": "340/TALK"  , "narrator": "千羽鶴", "text": "そう、総意。"},
        { "location": "341/TALK"  , "narrator": "千羽鶴", "text": "今やこの世界において、\n貴方“たち”の干渉は\n絶対不可欠なもの。"},
        { "location": "342/TALK"  , "narrator": "千羽鶴", "text": "でもその貴方“たち”は\nキマグレで、まるで量子の\nように予測不能な存在。"},
        { "location": "343/TALK"  , "narrator": "千羽鶴", "text": "そんな状態では、我々は\nいつか貴方“たち”の作り\n出す大きな渦に飲まれる。"},
        { "location": "344/TALK"  , "narrator": "千羽鶴", "text": "そうなる前に、ある程度\n予測を立て、世界のバラ\nンスを取る必要がある。"},
        { "location": "345/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "346/SEL"   , "narrator": "", "text": "意味がわかりません"},
        { "location": "347/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "348/TALK"  , "narrator": "千羽鶴", "text": "やってもらいたい事は\n至極単純。"},
        { "location": "349/ACT"   , "narrator": "", "text": "意味がわかりません"},
        { "location": "350/TALK"  , "narrator": "千羽鶴", "text": "大丈夫。意味は\nわからなくても、やって\nもらうことは単純だから。"},
        { "location": "352/TALK"  , "narrator": "千羽鶴", "text": "私の二択問題に\n答えてくれればいい。"},
        { "location": "353/TALK"  , "narrator": "千羽鶴", "text": "その問題には、\n正解は存在しない。\nだから気負わないで。"},
        { "location": "354/TALK"  , "narrator": "千羽鶴", "text": "私はその結果を合算し、\n一定期間における\n不確定意志を観測する。"},
        { "location": "355/TALK"  , "narrator": "千羽鶴", "text": "そして貴方と私の世界に\nおける、波動関数を\n確定する。"},
        { "location": "356/TALK"  , "narrator": "千羽鶴", "text": "それでは早速実行する。\n準備はいい？"},
        { "location": "357/SEL"   , "narrator": "", "text": "はい"},
        { "location": "358/SEL"   , "narrator": "", "text": "拒否します"},
        { "location": "359/ACT"   , "narrator": "", "text": "はい"},
        { "location": "360/TALK"  , "narrator": "千羽鶴", "text": "質問。"},
        { "location": "361/TALK"  , "narrator": "千羽鶴", "text": "今、貴方が支えてあげたい\nと思ってるトライナリーの\n子を想像して。"},
        { "location": "362/TALK"  , "narrator": "千羽鶴", "text": "そして、貴方が\nその彼女の幸せを\n純粋に願う場合において。"},
        { "location": "363/TALK"  , "narrator": "千羽鶴", "text": "もし、彼女自身の幸せと\n世界の総意としての\n幸せが一致しない場合。"},
        { "location": "364/TALK"  , "narrator": "千羽鶴", "text": "貴方はどう行動する？"},
        { "location": "366/SEL"   , "narrator": "", "text": "彼女を支持し、世界を犠牲にする"},
        { "location": "367/SEL"   , "narrator": "", "text": "世界の為、彼女に犠牲になってもらう"},
        { "location": "368/ACT"   , "narrator": "", "text": "彼女を支持し、世界を犠牲にする"},
        { "location": "370/ACT"   , "narrator": "", "text": "世界の為、彼女に犠牲になってもらう"},
        { "location": "373/TALK"  , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "374/TALK"  , "narrator": "千羽鶴", "text": "では、その\n【世界の総意】を【私】に\n置き換えた場合は？"},
        { "location": "375/SEL"   , "narrator": "", "text": "彼女を支持し、千羽鶴を犠牲にする"},
        { "location": "376/SEL"   , "narrator": "", "text": "千羽鶴の為、彼女に犠牲になってもらう"},
        { "location": "377/ACT"   , "narrator": "", "text": "彼女を支持し、千羽鶴を犠牲にする"},
        { "location": "379/ACT"   , "narrator": "", "text": "千羽鶴の為、彼女に犠牲になってもらう"},
        { "location": "382/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "383/TALK"  , "narrator": "千羽鶴", "text": "今ここで、\n貴方の選択に対する\nコメントはしない。"},
        { "location": "384/TALK"  , "narrator": "千羽鶴", "text": "次回、波動関数が確立\nしてからフィードバック\nすることにする。"},
        { "location": "385/TALK"  , "narrator": "千羽鶴", "text": "とにかく、\nご協力ありがと。"},
        { "location": "386/ACT"   , "narrator": "", "text": "拒否します"},
        { "location": "387/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "388/TALK"  , "narrator": "千羽鶴", "text": "まあ、それもまた\n１つの答え。\nそれで構わない。"},
        { "location": "389/TALK"  , "narrator": "千羽鶴", "text": "ご協力ありがと。"},
        { "location": "391/TALK"  , "narrator": "千羽鶴", "text": "…っと。\nだいぶ時間を\n使ってしまったかも。"},
        { "location": "392/TALK"  , "narrator": "千羽鶴", "text": "貴方にとっても、\n私にとっても、\n時間はとても貴重。"},
        { "location": "393/TALK"  , "narrator": "千羽鶴", "text": "速やかに\n今回の記録映像を\n見ましょ。"},
        { "location": "396/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/57MB 3:32】</color>"},
        { "location": "397/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/18MB 3:32】</color>"},
        { "location": "398/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "399/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/57MB 3:32】</color>"},
        { "location": "400/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "406/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/18MB 3:32】</color>"},
        { "location": "407/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "413/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "414/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "447/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n短いながらに、なかなか\nパンチの効いた回だった。"},
        { "location": "448/TALK"  , "narrator": "千羽鶴", "text": "感想あれば。"},
        { "location": "450/SEL"   , "narrator": "", "text": "神楽ちゃん大丈夫？"},
        { "location": "451/SEL"   , "narrator": "", "text": "神楽のお母さんはどうしちゃってるの！？"},
        { "location": "452/SEL"   , "narrator": "", "text": "この一連のことに、千羽鶴が絡んでるんじゃないの？"},
        { "location": "453/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "454/ACT"   , "narrator": "", "text": "神楽ちゃん大丈夫？"},
        { "location": "455/TALK"  , "narrator": "千羽鶴", "text": "心配いらない。"},
        { "location": "456/TALK"  , "narrator": "千羽鶴", "text": "あの子は、こんな事で\n潰れてしまうような\nタマではない。"},
        { "location": "457/SEL"   , "narrator": "", "text": "それにしたって、酷すぎる"},
        { "location": "458/SEL"   , "narrator": "", "text": "そういう問題じゃないだろ！"},
        { "location": "459/ACT"   , "narrator": "", "text": "それにしたって、酷すぎる"},
        { "location": "460/TALK"  , "narrator": "千羽鶴", "text": "世の中にはもっと\n過酷なことがある。"},
        { "location": "461/TALK"  , "narrator": "千羽鶴", "text": "絶対的な時間の中で言えば\n貴方だって、今の彼女より\n過酷な時があったはず。"},
        { "location": "462/TALK"  , "narrator": "千羽鶴", "text": "今、彼女はその時の中に\nいるというだけ。"},
        { "location": "463/TALK"  , "narrator": "千羽鶴", "text": "彼女にだって、\n幸せな時間もある。"},
        { "location": "464/TALK"  , "narrator": "千羽鶴", "text": "それは今までの記録映像を\n見ていてもわかると思う。"},
        { "location": "465/ACT"   , "narrator": "", "text": "そういう問題じゃないだろ！"},
        { "location": "466/TALK"  , "narrator": "千羽鶴", "text": "……驚いた。"},
        { "location": "467/TALK"  , "narrator": "千羽鶴", "text": "ものすごい\nエネルギーを感じる。"},
        { "location": "468/TALK"  , "narrator": "千羽鶴", "text": "そのエネルギーは、\n彼女を守りたいという\n気持ち？　それとも――"},
        { "location": "469/TALK"  , "narrator": "千羽鶴", "text": "私の非情で淡泊な\n回答に対する怒り？"},
        { "location": "470/SEL"   , "narrator": "", "text": "卯月神楽を守りたい気持ち"},
        { "location": "471/SEL"   , "narrator": "", "text": "千羽鶴の発言に対する気持ち"},
        { "location": "472/TALK"  , "narrator": "千羽鶴", "text": "もし答えが出せないなら、\nこう考えればいい。"},
        { "location": "473/TALK"  , "narrator": "千羽鶴", "text": "今回の対象が卯月神楽では\nなく、名も知らないモブ\nだったらどう感じたか。"},
        { "location": "474/ACT"   , "narrator": "", "text": "卯月神楽を守りたい気持ち"},
        { "location": "476/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "477/TALK"  , "narrator": "千羽鶴", "text": "貴方のその気持ちは\nとても純粋で美しい。"},
        { "location": "478/TALK"  , "narrator": "千羽鶴", "text": "だから、生涯その気持ちを\n宝物にして生きて欲しい。"},
        { "location": "479/TALK"  , "narrator": "千羽鶴", "text": "けど、こと卯月神楽に\n関して言えば、\n深く関わらない方がいい。"},
        { "location": "480/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽は他の\nトライナリーとは、\n持っている役割が違う。"},
        { "location": "481/TALK"  , "narrator": "千羽鶴", "text": "チャンネルを開設しない\nことからも、それを察して\nもらえるはず。"},
        { "location": "482/TALK"  , "narrator": "千羽鶴", "text": "これは\n私からの忠告。"},
        { "location": "483/ACT"   , "narrator": "", "text": "千羽鶴の発言に対する気持ち"},
        { "location": "485/TALK"  , "narrator": "千羽鶴", "text": "そう……。"},
        { "location": "486/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "487/TALK"  , "narrator": "千羽鶴", "text": "ならば素直に\n謝っておく。"},
        { "location": "488/TALK"  , "narrator": "千羽鶴", "text": "ごめんなさい。"},
        { "location": "491/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "493/ACT"   , "narrator": "", "text": "神楽のお母さんはどうしちゃってるの！？"},
        { "location": "494/TALK"  , "narrator": "千羽鶴", "text": "今の彼女は、\nココロの一部が\n喪失している状態。"},
        { "location": "495/TALK"  , "narrator": "千羽鶴", "text": "人のココロは、全ての\n機構がある程度の水準\nで回ることで機能する。"},
        { "location": "496/TALK"  , "narrator": "千羽鶴", "text": "その一部でも喪失すれば、\nバランスを欠いたココロは\n何処かへ飛んでいく。"},
        { "location": "497/TALK"  , "narrator": "千羽鶴", "text": "今の彼女は\nそんな状態になっている。"},
        { "location": "498/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "500/ACT"   , "narrator": "", "text": "この一連のことに、千羽鶴が絡んでるんじゃないの？"},
        { "location": "501/TALK"  , "narrator": "千羽鶴", "text": "そうね。\n全く絡んでいないと言えば\n嘘になる。"},
        { "location": "502/TALK"  , "narrator": "千羽鶴", "text": "けど、大勢を鑑みたとき\nこの状況になることは\nやむを得ないことだった。"},
        { "location": "503/TALK"  , "narrator": "千羽鶴", "text": "いずれ貴方にも、\nそれを分かって\nもらえると思う。"},
        { "location": "504/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "506/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "508/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "515/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n逢瀬つばめだけども。"},
        { "location": "516/TALK"  , "narrator": "千羽鶴", "text": "記録映像より前、\n卯月神楽の家に行くか否か\n迷っているところから。"},
        { "location": "517/TALK"  , "narrator": "千羽鶴", "text": "もちろん、見てわかる\nとおり、行けば彼女は\n衝撃的な現実を見る。"},
        { "location": "518/TALK"  , "narrator": "千羽鶴", "text": "それは短期的に見れば、\n逢瀬つばめにとっては\nネガティブな要因。"},
        { "location": "519/TALK"  , "narrator": "千羽鶴", "text": "けど、長期的に見た場合\n私たちや彼女の幸せを\n実現する為には不可欠。"},
        { "location": "520/TALK"  , "narrator": "千羽鶴", "text": "だから、心苦しいかも\nしれないけど、彼女を\n導いてあげて欲しい。"},
        { "location": "521/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "522/TALK"  , "narrator": "千羽鶴", "text": "そろそろ貴方も\n感じてきた頃かと\n思うけど。"},
        { "location": "526/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n國政綾水だけども。"},
        { "location": "527/TALK"  , "narrator": "千羽鶴", "text": "彼女は、先日の\nフェノメノン後から\nずっと後悔している。"},
        { "location": "528/TALK"  , "narrator": "千羽鶴", "text": "それは、卯月神楽への\n対応についてのこと。"},
        { "location": "529/TALK"  , "narrator": "千羽鶴", "text": "だから、彼女の\nココロの整理を\n手伝ってあげて欲しい。"},
        { "location": "530/TALK"  , "narrator": "千羽鶴", "text": "それと……、\nそろそろ貴方も感じてきた\n頃かと思うけど。"},
        { "location": "534/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\nガブリエラだけども。"},
        { "location": "535/TALK"  , "narrator": "千羽鶴", "text": "彼女はまだ、前回の\nフェノメノン戦以降も\nモヤモヤを拭えない。"},
        { "location": "536/TALK"  , "narrator": "千羽鶴", "text": "貴方にはそんな彼女の\n気持ちの整理をして\nあげて欲しい。"},
        { "location": "537/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラは普段\n強気でいることが多いけど\n実は一番デリケートかも。"},
        { "location": "538/TALK"  , "narrator": "千羽鶴", "text": "だから、貴方には\n彼女を支えていって\n欲しいと思っている。"},
        { "location": "539/TALK"  , "narrator": "千羽鶴", "text": "それと……、\nそろそろ貴方も感じてきた\n頃かと思うけど。"},
        { "location": "543/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n恋ヶ崎みやびだけども。"},
        { "location": "544/TALK"  , "narrator": "千羽鶴", "text": "前回のフェノメノン戦で\nラビットアニマに顔割れ\nしたことについて。"},
        { "location": "545/TALK"  , "narrator": "千羽鶴", "text": "彼女がこの事で心の整理と\n解決が出来ないと、今後の\n任務に支障を来す。"},
        { "location": "546/TALK"  , "narrator": "千羽鶴", "text": "貴方は裏側を見ているから\nわかると思うけど、全て\n曝け出した方が絶対いい。"},
        { "location": "547/TALK"  , "narrator": "千羽鶴", "text": "でも、警戒心が強い彼女は\n一人でそれを\n決断することができない。"},
        { "location": "548/TALK"  , "narrator": "千羽鶴", "text": "だから是非\n貴方に彼女を\n導いてあげて欲しい。"},
        { "location": "549/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "550/TALK"  , "narrator": "千羽鶴", "text": "そろそろ貴方も\n感じてきた頃かと\n思うけど。"},
        { "location": "552/TALK"  , "narrator": "千羽鶴", "text": "その場の彼女の状況や\n気持ちを優先すること――"},
        { "location": "553/TALK"  , "narrator": "千羽鶴", "text": "それが必ずしも\n彼女を幸せにするとは\n限らない。"},
        { "location": "554/TALK"  , "narrator": "千羽鶴", "text": "貴方は時折、彼女の\n未来を見た後に、過去の\n彼女を導いている。"},
        { "location": "555/TALK"  , "narrator": "千羽鶴", "text": "逆に、彼女の未来を見られ\nない状況でも、導かざるを\n得ない時もある。"},
        { "location": "556/TALK"  , "narrator": "千羽鶴", "text": "幸せな未来が見えている\n時は、彼女にとって辛い\n選択でも、促すと思う。"},
        { "location": "557/TALK"  , "narrator": "千羽鶴", "text": "でも、そうでないとき、\n貴方はどう判断している？"},
        { "location": "558/TALK"  , "narrator": "千羽鶴", "text": "その事をいつも頭の片隅に\n置いて、これからも彼女を\n支えてあげて欲しい。"},
        { "location": "559/TALK"  , "narrator": "千羽鶴", "text": "それでは、\n健闘を祈ってる。"},
        { "location": "202/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n脅しではなく、\n本当に記録されます。"},
        { "location": "365/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n何度でも回答を変更できます。\n最後の回答が、その時点での\n貴方の結論となります。"},
