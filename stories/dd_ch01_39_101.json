{
    "dir": "chap39/daydra/dd_ch01_39_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "39102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "瑪瑙色の空に＜前編＞"
    },
    "entry":
    [
        { "location": "38/TALK"   , "narrator": "神楽", "text": "……はぁ……"},
        { "location": "39/TALK"   , "narrator": "神楽", "text": "……つばめさん遅い！\n楽屋に来るって\n言ってたのに。"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "やっぱり、\n私のこと……"},
        { "location": "44/TALK"   , "narrator": "神楽", "text": "！"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "ごめんね！\n遅くなっちゃって！"},
        { "location": "71/TALK"   , "narrator": "神楽", "text": "…遅すぎです。"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "えへへ……\nちょっと迷っちゃって…。"},
        { "location": "73/TALK"   , "narrator": "神楽", "text": "……はぁ。\nそうですか。"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "…えっと…\n乗換と……。"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "あと駅に着いてから\nここに来るまでに\nちょっとだけ…。"},
        { "location": "80/TALK"   , "narrator": "神楽", "text": "途中で迷うなんて、\n私に対する愛はその程度の\nものだったんですね。"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "ええっ！？　あ、でも！\n今回はドームの中では\n迷ってないから！"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "だから！\n前より全然頑張ってると\n思うんだけど――"},
        { "location": "86/TALK"   , "narrator": "神楽", "text": "………もういいです。"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "あ……えっと……\n神楽ちゃん…？"},
        { "location": "90/TALK"   , "narrator": "神楽", "text": "つばめさん嫌い。"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "え…えええっ！！\nご、ごめんね？\n怒ってる？？"},
        { "location": "92/TALK"   , "narrator": "神楽", "text": "……まさか。"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "あ、ああの！\nわたし、何でもするから\nだから仲直りしてください"},
        { "location": "96/TALK"   , "narrator": "神楽", "text": "……本当ですか？"},
        { "location": "98/TALK"   , "narrator": "神楽", "text": "じゃあ、\nキスしてください。"},
        { "location": "99/TALK"   , "narrator": "つばめ", "text": "え、えええっ！？"},
        { "location": "100/TALK"  , "narrator": "神楽", "text": "何でもしてくれるん\nですよね？"},
        { "location": "103/TALK"  , "narrator": "神楽", "text": "それとも、やっぱり\n私の事なんて、\nその程度の――"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "する！\nするよ！！"},
        { "location": "107/TALK"  , "narrator": "神楽", "text": "なにをするんです？"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "えっと、あの、\n神楽ちゃんと…キス……"},
        { "location": "111/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "113/TALK"  , "narrator": "神楽", "text": "……ぷっ…"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "…へ？"},
        { "location": "116/TALK"  , "narrator": "神楽", "text": "ふふふふ！！\nあはははは！"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "神楽……ちゃん？"},
        { "location": "118/TALK"  , "narrator": "神楽", "text": "冗談ですよ、つばめさん。\nもう、すぐ本気に\nしちゃうんですから。"},
        { "location": "119/TALK"  , "narrator": "つばめ", "text": "え――"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "えええええっ！！\n冗談だったの！？"},
        { "location": "121/TALK"  , "narrator": "神楽", "text": "当たり前じゃないですか。"},
        { "location": "122/TALK"  , "narrator": "神楽", "text": "つばめさんが可愛いから\nちょっと\nからかっただけですよ。"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "なぁんだぁ……"},
        { "location": "124/TALK"  , "narrator": "神楽", "text": "…？"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "あっ！\nいや、何でもないよ！"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "でも、怒ってなくて\nホントによかったよ……。"},
        { "location": "127/TALK"  , "narrator": "神楽", "text": "怒ってなんていませんよ。\nむしろ私の方が、来て\nもらってる立場ですし。"},
        { "location": "128/TALK"  , "narrator": "神楽", "text": "ただ。"},
        { "location": "129/TALK"  , "narrator": "つばめ", "text": "ただ？"},
        { "location": "130/TALK"  , "narrator": "神楽", "text": "ちょっとだけ\n遅かったから――"},
        { "location": "131/TALK"  , "narrator": "神楽", "text": "ちょっとだけ……\n拗ねてみただけです。"},
        { "location": "132/TALK"  , "narrator": "つばめ", "text": "えへへ……、\nほんとにごめんね？"},
        { "location": "133/TALK"  , "narrator": "神楽", "text": "それにしてもつばめさん。\n今日もその格好ですか？"},
        { "location": "134/TALK"  , "narrator": "つばめ", "text": "えっ？\nあー、えっと――"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "その、色々考えたんだけど\n何を着ていけばいいか\nわからなくて……。"},
        { "location": "138/TALK"  , "narrator": "つばめ", "text": "ああっ！　そうか！\n今気づいたよ！！"},
        { "location": "139/TALK"  , "narrator": "神楽", "text": "つばめさん、\n気づくの遅すぎです…。"},
        { "location": "142/TALK"  , "narrator": "つばめ", "text": "今日はメノウちゃん\nTシャツで来なくちゃ\nいけなかったんだ！"},
        { "location": "143/TALK"  , "narrator": "神楽", "text": "いえ！！\nそれはやめてください！！"},
        { "location": "145/TALK"  , "narrator": "神楽", "text": "そうじゃなくて！\n今日くらい、少しは\nオシャレしてきても……"},
        { "location": "147/TALK"  , "narrator": "神楽", "text": "あ、そうだ！\nそういえば……！！"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "…？"},
        { "location": "150/TALK"  , "narrator": "神楽", "text": "つばめさん、\nちょっと待ってて\nくださいね。"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "卯月さん、やっぱりホントはガッカリしてるのかな？"},
        { "location": "166/TALK"  , "narrator": "つばめ", "text": "ぁたしが来るの遅くなったから"},
        { "location": "168/SEL"   , "narrator": "", "text": "かもね"},
        { "location": "169/SEL"   , "narrator": "", "text": "あれは照れ隠しだよ"},
        { "location": "170/SEL"   , "narrator": "", "text": "むしろ喜んでるって"},
        { "location": "171/ACT"   , "narrator": "", "text": "かもね"},
        { "location": "172/TALK"  , "narrator": "つばめ", "text": "そっかな。。。"},
        { "location": "173/TALK"  , "narrator": "つばめ", "text": "どぅしょ。。。"},
        { "location": "174/ACT"   , "narrator": "", "text": "あれは照れ隠しだよ"},
        { "location": "175/TALK"  , "narrator": "つばめ", "text": "だったらぃぃんだけど"},
        { "location": "176/ACT"   , "narrator": "", "text": "むしろ喜んでるって"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "ぇっぇっ"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "そぅなの。。。？"},
        { "location": "180/SEL"   , "narrator": "", "text": "やっぱりメノウのファンなんだ"},
        { "location": "181/SEL"   , "narrator": "", "text": "神楽の歌いいよね"},
        { "location": "182/SEL"   , "narrator": "", "text": "神楽と友達になれてよかったね"},
        { "location": "183/ACT"   , "narrator": "", "text": "やっぱりメノウのファンなんだ"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "そぅ！"},
        { "location": "186/TALK"  , "narrator": "つばめ", "text": "大ファンでもぁるの"},
        { "location": "187/TALK"  , "narrator": "つばめ", "text": "不思議だょね"},
        { "location": "188/TALK"  , "narrator": "つばめ", "text": "友達なのに"},
        { "location": "189/ACT"   , "narrator": "", "text": "神楽の歌いいよね"},
        { "location": "190/TALK"  , "narrator": "つばめ", "text": "すごくぃぃょね"},
        { "location": "192/TALK"  , "narrator": "つばめ", "text": "世界で一番だと思ってる"},
        { "location": "193/ACT"   , "narrator": "", "text": "神楽と友達になれてよかったね"},
        { "location": "194/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "195/TALK"  , "narrator": "つばめ", "text": "世界で一番大事なお友達"},
        { "location": "197/TALK"  , "narrator": "つばめ", "text": "それは絶対"},
        { "location": "248/TALK"  , "narrator": "カレン", "text": "　"},
        { "location": "264/TALK"  , "narrator": "カレン", "text": "あっ！\n$handle$さん！"},
        { "location": "265/SEL"   , "narrator": "", "text": "調子はどう？"},
        { "location": "266/ACT"   , "narrator": "", "text": "調子はどう？"},
        { "location": "268/TALK"  , "narrator": "カレン", "text": "はいっ！\nとってもいい調子です！"},
        { "location": "269/TALK"  , "narrator": "カレン", "text": "セルフクランにも\nなっちゃいましたし、\nいっぱい頑張らないと。"},
        { "location": "270/TALK"  , "narrator": "カレン", "text": "そういえば、今\n千羽鶴さんに色々教えて\nもらってるんですけど――"},
        { "location": "271/TALK"  , "narrator": "カレン", "text": "千羽鶴さんって、ちょっと\n堅すぎじゃないですか？"},
        { "location": "272/SEL"   , "narrator": "", "text": "まあ千羽鶴だしな"},
        { "location": "273/ACT"   , "narrator": "", "text": "まあ千羽鶴だしな"},
        { "location": "275/TALK"  , "narrator": "カレン", "text": "わたしが頑張って\nこの世界を幸せにしようと\nしてるのに――"},
        { "location": "276/TALK"  , "narrator": "カレン", "text": "すぐに水を差して\nくるんですよ。"},
        { "location": "277/SEL"   , "narrator": "", "text": "$me$が仲裁しようか？"},
        { "location": "278/SEL"   , "narrator": "", "text": "そりゃ大変だ"},
        { "location": "279/ACT"   , "narrator": "", "text": "$me$が仲裁しようか？"},
        { "location": "280/TALK"  , "narrator": "カレン", "text": "本当ですか！？"},
        { "location": "281/TALK"  , "narrator": "カレン", "text": "是非お願いします！"},
        { "location": "288/ACT"   , "narrator": "", "text": "そりゃ大変だ"},
        { "location": "289/TALK"  , "narrator": "カレン", "text": "えへへ。"},
        { "location": "290/TALK"  , "narrator": "カレン", "text": "でも大丈夫です！\n自分で選んだ道ですから。"},
        { "location": "291/TALK"  , "narrator": "カレン", "text": "それより\n$handle$さん！\n今日はどうしたんですか？"},
        { "location": "292/SEL"   , "narrator": "", "text": "心の葛藤を解消しに来た"},
        { "location": "293/ACT"   , "narrator": "", "text": "心の葛藤を解消しに来た"},
        { "location": "295/TALK"  , "narrator": "カレン", "text": "うわぁっ！\n久し振りです！"},
        { "location": "297/TALK"  , "narrator": "カレン", "text": "二人きりで楽しく\n扉を回していた日々を\n思い出しますね！"},
        { "location": "304/TALK"  , "narrator": "カレン", "text": "オープンプロセス、\n0x985番地から\n0x12F番地へ。"},
        { "location": "328/TALK"  , "narrator": "カレン", "text": "シーク完了しました。"},
        { "location": "331/TALK"  , "narrator": "カレン", "text": "えっとですねー…"},
        { "location": "333/TALK"  , "narrator": "カレン", "text": "今回は――"},
        { "location": "334/SEL"   , "narrator": "", "text": "神楽に対する不安を無くす？"},
        { "location": "335/ACT"   , "narrator": "", "text": "神楽に対する不安を無くす？"},
        { "location": "337/TALK"  , "narrator": "カレン", "text": "えへへ……\nまた先に\n言われちゃいましたね。"},
        { "location": "338/TALK"  , "narrator": "カレン", "text": "昔、それで落ち込んだのが\n懐かしいです。"},
        { "location": "339/TALK"  , "narrator": "カレン", "text": "$handle$さんが\n言う通り、神楽ちゃんに\n対する不安のことです。"},
        { "location": "340/TALK"  , "narrator": "カレン", "text": "もう何も不安に思う\n事なんてないのにって\n思うんですけどね。"},
        { "location": "341/TALK"  , "narrator": "カレン", "text": "というわけで、\n今回もズバッと\n解決しちゃってください！"},
        { "location": "342/TALK"  , "narrator": "カレン", "text": "$handle$さんと\nわたしに\n素敵なココロの旅を！"},
        { "location": "354/TALK"  , "narrator": "カレン", "text": "っと！！\nそういえば！"},
        { "location": "355/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "356/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "358/TALK"  , "narrator": "カレン", "text": "$handle$さんに\n伝えたいことが\nあったんでした。"},
        { "location": "374/TALK"  , "narrator": "カレン", "text": "すごく大事な\n事ですってば！"},
        { "location": "375/TALK"  , "narrator": "千羽鶴", "text": "はぁ……。"},
        { "location": "376/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "377/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "380/TALK"  , "narrator": "カレン", "text": "あっ！\n$handle$さん！？"},
        { "location": "382/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "383/TALK"  , "narrator": "千羽鶴", "text": "私は自分に\n自信を無くしてる。"},
        { "location": "384/SEL"   , "narrator": "", "text": "千羽鶴はすごいよ！"},
        { "location": "385/SEL"   , "narrator": "", "text": "嫌な予感しかしない"},
        { "location": "386/ACT"   , "narrator": "", "text": "千羽鶴はすごいよ！"},
        { "location": "387/TALK"  , "narrator": "千羽鶴", "text": "ありがと。\nでも貴方は私を\n買いかぶりすぎてる。"},
        { "location": "388/ACT"   , "narrator": "", "text": "嫌な予感しかしない"},
        { "location": "389/TALK"  , "narrator": "千羽鶴", "text": "その予感は\n多分当たってると思う。"},
        { "location": "393/TALK"  , "narrator": "カレン", "text": "$handle$さん、\n聞いて下さい！"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "聞く必要ない。\n時間とカロリーの無駄。"},
        { "location": "397/TALK"  , "narrator": "カレン", "text": "千羽鶴さんが\n堅すぎるんです！"},
        { "location": "398/TALK"  , "narrator": "カレン", "text": "わたしだって、ちゃんと\nこの世界の幸せを\n考えてるんですよ？"},
        { "location": "400/TALK"  , "narrator": "千羽鶴", "text": "はぁ……。"},
        { "location": "401/SEL"   , "narrator": "", "text": "カレンの意見を尊重してあげたら？"},
        { "location": "402/SEL"   , "narrator": "", "text": "千羽鶴は先輩なんだから言う事聞きなさい"},
        { "location": "403/ACT"   , "narrator": "", "text": "カレンの意見を尊重してあげたら？"},
        { "location": "406/TALK"  , "narrator": "カレン", "text": "あはっ！　やっぱり\n$handle$さんは\nわたしの味方なんですね！"},
        { "location": "408/TALK"  , "narrator": "千羽鶴", "text": "むか"},
        { "location": "409/TALK"  , "narrator": "千羽鶴", "text": "じゃあ聞くけど。"},
        { "location": "410/TALK"  , "narrator": "千羽鶴", "text": "この子は状況改変能力を\n使って――"},
        { "location": "411/TALK"  , "narrator": "千羽鶴", "text": "年中どこかのコンビニで\nフレイメノウコラボ\nイベントをし続けると！"},
        { "location": "412/TALK"  , "narrator": "千羽鶴", "text": "そう言ってるんだけど、\nどうなさいますか\n$handle$先生。"},
        { "location": "413/ACT"   , "narrator": "", "text": "千羽鶴は先輩なんだから言う事聞きなさい"},
        { "location": "415/TALK"  , "narrator": "カレン", "text": "ええー…そんなぁ。"},
        { "location": "416/TALK"  , "narrator": "千羽鶴", "text": "そういうこと。\n諦めなさい、カレンディ\nサイプロブイシュリール。"},
        { "location": "419/TALK"  , "narrator": "カレン", "text": "$handle$さんは\n千羽鶴さんの\n味方なんですね。"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "だって、\n連れ添った時間の長さが\n違うもの。"},
        { "location": "423/TALK"  , "narrator": "カレン", "text": "むか。"},
        { "location": "424/TALK"  , "narrator": "カレン", "text": "それって単なる\n役得じゃないですか。"},
        { "location": "425/TALK"  , "narrator": "千羽鶴", "text": "役得もスキルの１つ。"},
        { "location": "427/TALK"  , "narrator": "カレン", "text": "$handle$さん！\nわたしはこの世界の\n幸せをいつも考えてます！"},
        { "location": "428/SEL"   , "narrator": "", "text": "知ってる"},
        { "location": "429/SEL"   , "narrator": "", "text": "お、おう"},
        { "location": "430/ACT"   , "narrator": "", "text": "知ってる"},
        { "location": "431/ACT"   , "narrator": "", "text": "お、おう"},
        { "location": "433/TALK"  , "narrator": "カレン", "text": "いつコンビニに行っても\nフレイメノウ祭りを\nやってたら最高ですよね！"},
        { "location": "435/SEL"   , "narrator": "", "text": "え…？"},
        { "location": "436/SEL"   , "narrator": "", "text": "最高です！"},
        { "location": "437/ACT"   , "narrator": "", "text": "え…？"},
        { "location": "439/TALK"  , "narrator": "千羽鶴", "text": "まあそういうこと。"},
        { "location": "440/ACT"   , "narrator": "", "text": "最高です！"},
        { "location": "441/TALK"  , "narrator": "千羽鶴", "text": "そう。\nまあいい。"},
        { "location": "443/TALK"  , "narrator": "千羽鶴", "text": "でもダメ。"},
        { "location": "445/TALK"  , "narrator": "カレン", "text": "えー！！\n２対１で、わたしたちの\n勝ちじゃないですか。"},
        { "location": "446/TALK"  , "narrator": "カレン", "text": "パラパラ法による\n未来何とかが\n成立しますよね？"},
        { "location": "447/TALK"  , "narrator": "千羽鶴", "text": "パラメトリック理論に\n基づく世界進行法。"},
        { "location": "448/TALK"  , "narrator": "千羽鶴", "text": "ていうか、３人じゃ\n全然パラメトリックじゃ\nないし、全然ダメ。"},
        { "location": "451/TALK"  , "narrator": "千羽鶴", "text": "とにかく、それは\n却下だから。"},
        { "location": "453/TALK"  , "narrator": "カレン", "text": "千羽鶴さんは堅すぎます。\nそれくらい\nいいじゃないですか。"},
        { "location": "456/TALK"  , "narrator": "千羽鶴", "text": "<size=35>どーん！！</size>"},
        { "location": "457/TALK"  , "narrator": "カレン", "text": "わあっ！"},
        { "location": "458/TALK"  , "narrator": "千羽鶴", "text": "そう、貴方を野放しに\nできないのはそこ！！"},
        { "location": "459/TALK"  , "narrator": "千羽鶴", "text": "多少強いとはいえ、\n貴方は普通のクランと\n同じ。"},
        { "location": "460/TALK"  , "narrator": "千羽鶴", "text": "ちょっと油断すると、\nすぐにトンデモな世界を\n創りたがる。"},
        { "location": "461/TALK"  , "narrator": "カレン", "text": "千羽鶴さんは、\n違うんですか？"},
        { "location": "462/TALK"  , "narrator": "千羽鶴", "text": "私の場合、\nそういう事は起こらない。"},
        { "location": "463/TALK"  , "narrator": "千羽鶴", "text": "なぜなら、その為に\n理想社会の追求に特化した\n人格にされたわけで。"},
        { "location": "464/TALK"  , "narrator": "カレン", "text": "わたしはメノウ社会の\n追求に特化しています！"},
        { "location": "465/TALK"  , "narrator": "千羽鶴", "text": "自分で言うな！"},
        { "location": "466/SEL"   , "narrator": "", "text": "なんていうか、ごめん"},
        { "location": "467/SEL"   , "narrator": "", "text": "これ、ヤバイ奴だったんでは？"},
        { "location": "468/ACT"   , "narrator": "", "text": "なんていうか、ごめん"},
        { "location": "469/ACT"   , "narrator": "", "text": "これ、ヤバイ奴だったんでは？"},
        { "location": "473/TALK"  , "narrator": "千羽鶴", "text": "まあ大丈夫。\nこの子の教育は\nわたしがちゃんとやる。"},
        { "location": "474/TALK"  , "narrator": "千羽鶴", "text": "選択したのは私だし、\n貴方は何も悪くない。"},
        { "location": "475/SEL"   , "narrator": "", "text": "でも、何だかんだで楽しそうで良かった"},
        { "location": "476/SEL"   , "narrator": "", "text": "ていうか、こんな事やってる場合ではないのでは？"},
        { "location": "477/ACT"   , "narrator": "", "text": "でも、何だかんだで楽しそうで良かった"},
        { "location": "479/TALK"  , "narrator": "千羽鶴", "text": "楽しそう？\nうーん、そうね……"},
        { "location": "480/TALK"  , "narrator": "千羽鶴", "text": "それは、視点が変わると、\n見え方も変わってくる\nということじゃない？"},
        { "location": "481/TALK"  , "narrator": "千羽鶴", "text": "私自身は何も\n変わってない。"},
        { "location": "482/TALK"  , "narrator": "千羽鶴", "text": "そう、\nあなたと話していたときと\n何もね。"},
        { "location": "484/TALK"  , "narrator": "カレン", "text": "わたしは\nとっても楽しいです！"},
        { "location": "485/TALK"  , "narrator": "カレン", "text": "セルフクランの心構えとか\nやるべきこととか――"},
        { "location": "486/TALK"  , "narrator": "カレン", "text": "千羽鶴さんが、\n優しく教えて\nくれるんですよ？"},
        { "location": "488/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "489/TALK"  , "narrator": "カレン", "text": "正解だと、ご褒美に\n好きなスイーツ１つ\nご馳走してくれますし！"},
        { "location": "490/TALK"  , "narrator": "千羽鶴", "text": "あ"},
        { "location": "491/SEL"   , "narrator": "", "text": "え、餌付け…？"},
        { "location": "492/SEL"   , "narrator": "", "text": "$me$には何もくれなかった！！"},
        { "location": "493/ACT"   , "narrator": "", "text": "え、餌付け…？"},
        { "location": "494/TALK"  , "narrator": "千羽鶴", "text": "違うから。"},
        { "location": "495/ACT"   , "narrator": "", "text": "$me$には何もくれなかった！！"},
        { "location": "496/TALK"  , "narrator": "千羽鶴", "text": "色々あげてた。\n貴方が忘れてるだけ。"},
        { "location": "497/SEL"   , "narrator": "", "text": "例えば？"},
        { "location": "498/ACT"   , "narrator": "", "text": "例えば？"},
        { "location": "501/TALK"  , "narrator": "千羽鶴", "text": "ちーちゃんと\nラブラブゲームとか。"},
        { "location": "502/TALK"  , "narrator": "千羽鶴", "text": "ちーちゃんと\nラブラブRPGゲームとか。"},
        { "location": "503/TALK"  , "narrator": "千羽鶴", "text": "スイーツを買ってあげるの\nより、よっぽど大変！"},
        { "location": "504/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n文句言わないで。"},
        { "location": "506/ACT"   , "narrator": "", "text": "ていうか、こんな事やってる場合ではないのでは？"},
        { "location": "509/TALK"  , "narrator": "千羽鶴", "text": "そうね、わかってる。"},
        { "location": "510/TALK"  , "narrator": "千羽鶴", "text": "“彼ら”はいまだ健在、\nそして――"},
        { "location": "511/TALK"  , "narrator": "千羽鶴", "text": "今のこの世界は、\n“彼ら”にとっての\n猶予期間でしかない。"},
        { "location": "512/TALK"  , "narrator": "千羽鶴", "text": "もちろんこのまま、\n着々と準備をし、彼らに\n対抗する選択もある。"},
        { "location": "513/TALK"  , "narrator": "千羽鶴", "text": "けど、貴方も思ってる\nとおり、それでは結局\n彼らの手のひらの上。"},
        { "location": "514/TALK"  , "narrator": "千羽鶴", "text": "だから、私とエリカは\n一緒に考えて、１つの\n結論を出した。"},
        { "location": "515/TALK"  , "narrator": "千羽鶴", "text": "恐らくそれは、既に\n彼女から聞いてると\n思うけど――"},
        { "location": "516/TALK"  , "narrator": "千羽鶴", "text": "不確定性が残る部分を\n確実に生めていき、\nここからの未来を動かす。"},
        { "location": "517/TALK"  , "narrator": "千羽鶴", "text": "その為に卯月神楽にも\n協力してもらうことに\nなった。"},
        { "location": "518/TALK"  , "narrator": "千羽鶴", "text": "その作戦には、私は\n直接関われないけど――"},
        { "location": "519/TALK"  , "narrator": "千羽鶴", "text": "成功すれば、恐らくは\n彼らの手のひらから脱する\nことができるはず。"},
        { "location": "520/TALK"  , "narrator": "カレン", "text": "わたしたちは、それまでの\n僅かな期間、彼らの行動を\nつぶさに監視して――"},
        { "location": "521/TALK"  , "narrator": "カレン", "text": "この世界を現状維持\nし続けることを役割と\nしているんです。"},
        { "location": "522/SEL"   , "narrator": "", "text": "カレンが難しいことを言ってる！！"},
        { "location": "523/ACT"   , "narrator": "", "text": "カレンが難しいことを言ってる！！"},
        { "location": "525/TALK"  , "narrator": "カレン", "text": "えええええええっ！！"},
        { "location": "526/TALK"  , "narrator": "カレン", "text": "わたしだって\nちゃんとわかってますよ！"},
        { "location": "527/TALK"  , "narrator": "カレン", "text": "表参道や原宿のスイーツに\nかまけているだけの\n人格じゃありません！"},
        { "location": "529/TALK"  , "narrator": "千羽鶴", "text": "やはり心配。"},
        { "location": "532/TALK"  , "narrator": "千羽鶴", "text": "で？\n今回ここに来た用件は？"},
        { "location": "534/TALK"  , "narrator": "カレン", "text": "ああっ、そうですよね。\nここに来たからには、\n何かあるんですよね？"},
        { "location": "535/SEL"   , "narrator": "", "text": "心の葛藤を解消しに来た"},
        { "location": "536/ACT"   , "narrator": "", "text": "心の葛藤を解消しに来た"},
        { "location": "538/TALK"  , "narrator": "カレン", "text": "やっぱりそうでしたか。"},
        { "location": "539/TALK"  , "narrator": "カレン", "text": "なんだかすごく\n久し振りです。"},
        { "location": "540/TALK"  , "narrator": "カレン", "text": "二人きりで楽しく\n扉を回していた日々を\n思い出しますね！"},
        { "location": "543/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "545/TALK"  , "narrator": "千羽鶴", "text": "それじゃ早速\n扉を回しましょ。"},
        { "location": "551/TALK"  , "narrator": "カレン", "text": "ああっ！\nそれはわたしの役目です！"},
        { "location": "555/TALK"  , "narrator": "千羽鶴", "text": "オープンプロセ――"},
        { "location": "556/TALK"  , "narrator": "カレン", "text": "ちょっと！\n回し方がさかさま\nじゃないですか！"},
        { "location": "559/TALK"  , "narrator": "カレン", "text": "0x985番地から\n0x12F番地へ。"},
        { "location": "560/TALK"  , "narrator": "千羽鶴", "text": "……こっちの方が\n0.2秒早く\nアクセスできる。"},
        { "location": "563/TALK"  , "narrator": "カレン", "text": "効率ばっかりじゃ\nココロが枯れますよ！？\n大事なのは伝統です！"},
        { "location": "566/TALK"  , "narrator": "千羽鶴", "text": "足引っ張らないで。"},
        { "location": "569/TALK"  , "narrator": "カレン", "text": "それはこっちの\nセリフです！"},
        { "location": "577/TALK"  , "narrator": "カレン", "text": "あっ！\n到着しました！"},
        { "location": "578/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽に対して\n嫌われたんじゃないかって\n不安があるみたい。"},
        { "location": "579/TALK"  , "narrator": "千羽鶴", "text": "その不安を\n取り除いてあげて。"},
        { "location": "581/TALK"  , "narrator": "カレン", "text": "ああっ！　わたしまだ\n読んでもいないのに\nネタバレしましたね！"},
        { "location": "583/TALK"  , "narrator": "千羽鶴", "text": "したけど。"},
        { "location": "584/TALK"  , "narrator": "カレン", "text": "酷いです！"},
        { "location": "585/TALK"  , "narrator": "千羽鶴", "text": "なら次は\n対抗策を考えるといい。"},
        { "location": "586/TALK"  , "narrator": "千羽鶴", "text": "そんなことで文句言ってる\nようでは、この世の中の\n荒波は渡っていけない。"},
        { "location": "587/TALK"  , "narrator": "カレン", "text": "うー……。"},
        { "location": "588/SEL"   , "narrator": "", "text": "何だかんだでいいコンビじゃん"},
        { "location": "589/SEL"   , "narrator": "", "text": "千羽鶴が幸せそうでよかった"},
        { "location": "590/ACT"   , "narrator": "", "text": "何だかんだでいいコンビじゃん"},
        { "location": "592/TALK"  , "narrator": "千羽鶴", "text": "まあ、それは否定しない。\nちょっと疲れるけど。"},
        { "location": "594/TALK"  , "narrator": "カレン", "text": "わたしも否定しません。\nちょっと\nカタブツですけど。"},
        { "location": "595/ACT"   , "narrator": "", "text": "千羽鶴が幸せそうでよかった"},
        { "location": "597/TALK"  , "narrator": "千羽鶴", "text": "……そうね。"},
        { "location": "598/TALK"  , "narrator": "千羽鶴", "text": "こういう生活も\n悪くない。"},
        { "location": "599/TALK"  , "narrator": "千羽鶴", "text": "出来の悪い生徒も、\n慣れれば\nそう悪いものでもないし。"},
        { "location": "601/TALK"  , "narrator": "カレン", "text": "あはは……。"},
        { "location": "603/TALK"  , "narrator": "千羽鶴", "text": "そういうわけだから、\n貴方も私たちの心配はせず\nエリカに協力してあげて。"},
        { "location": "604/TALK"  , "narrator": "カレン", "text": "でもその前に、まずは\nわたしの心の葛藤を\n何とかしてくださいね！"},
        { "location": "605/TALK"  , "narrator": "千羽鶴", "text": "それじゃまた。\n気が向いたら遊びに来て。"},
        { "location": "606/TALK"  , "narrator": "カレン", "text": "わたしと\n$handle$さんに\n素敵なココロの旅を！"},
        { "location": "608/TALK"  , "narrator": "千羽鶴", "text": "あ。"},
        { "location": "609/TALK"  , "narrator": "カレン", "text": "千羽鶴さんも\n“わたし”です。"},
        { "location": "625/SEL"   , "narrator": "", "text": "千羽鶴？"},
        { "location": "626/ACT"   , "narrator": "", "text": "千羽鶴？"},
        { "location": "628/TALK"  , "narrator": "千羽鶴", "text": "改めて、\n色々ありがと。"},
        { "location": "629/TALK"  , "narrator": "千羽鶴", "text": "結局、世界の大きな\n流れを変えることは\n出来なかったけど。"},
        { "location": "630/TALK"  , "narrator": "千羽鶴", "text": "でも、私はそれほど\n落ち込んではいない。"},
        { "location": "631/TALK"  , "narrator": "千羽鶴", "text": "また次の作戦が始まる。\n今度は前よりも遙かに\n確度が高い作戦。"},
        { "location": "634/TALK"  , "narrator": "千羽鶴", "text": "それに――"},
        { "location": "635/TALK"  , "narrator": "千羽鶴", "text": "貴方がずっと、\n私の隣にいてくれるから。"},
        { "location": "637/TALK"  , "narrator": "千羽鶴", "text": "だから、この結果は\n私にとっては残念な\nものではない。"},
        { "location": "638/TALK"  , "narrator": "千羽鶴", "text": "貴方はきっと、\n私の事を心配してくれると\n思ったから。"},
        { "location": "639/TALK"  , "narrator": "千羽鶴", "text": "この事だけは\n伝えておきたかった。"},
        { "location": "641/TALK"  , "narrator": "千羽鶴", "text": "それともう１つ。"},
        { "location": "642/TALK"  , "narrator": "千羽鶴", "text": "貴方が私をセルフに\n選んでくれたことは、\n決して無駄ではない。"},
        { "location": "643/TALK"  , "narrator": "千羽鶴", "text": "貴方を含む５％が\n存在したことで、カレンの\n今後の思想に違いが出る。"},
        { "location": "644/TALK"  , "narrator": "千羽鶴", "text": "貴方の選択があったから、\n私の考えや想いは、\nこの世界に残ったの。"},
        { "location": "646/TALK"  , "narrator": "千羽鶴", "text": "だから、ありがとう。"},
        { "location": "649/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "650/TALK"  , "narrator": "千羽鶴", "text": "これからは、\n前のように、頻繁に\n逢えなくなると思う。"},
        { "location": "653/TALK"  , "narrator": "千羽鶴", "text": "そのことについて、\n貴方はどう思う？"},
        { "location": "654/SEL"   , "narrator": "", "text": "とても寂しく思う"},
        { "location": "655/SEL"   , "narrator": "", "text": "まあそんなものかと"},
        { "location": "656/ACT"   , "narrator": "", "text": "とても寂しく思う"},
        { "location": "660/TALK"  , "narrator": "千羽鶴", "text": "…そうね。"},
        { "location": "661/TALK"  , "narrator": "千羽鶴", "text": "私もそう思う。"},
        { "location": "662/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "663/TALK"  , "narrator": "千羽鶴", "text": "私は。"},
        { "location": "664/TALK"  , "narrator": "千羽鶴", "text": "私は、感情を完全に\n殺された状態で、\nクランになった。"},
        { "location": "665/TALK"  , "narrator": "千羽鶴", "text": "そのはずだった。"},
        { "location": "666/TALK"  , "narrator": "千羽鶴", "text": "なのに、どうして。"},
        { "location": "667/TALK"  , "narrator": "千羽鶴", "text": "どうしてこんなに\n胸が苦しいの？"},
        { "location": "668/TALK"  , "narrator": "千羽鶴", "text": "私……"},
        { "location": "669/TALK"  , "narrator": "千羽鶴", "text": "私……　…"},
        { "location": "670/TALK"  , "narrator": "千羽鶴", "text": "生まれて初めて\n本気で泣いてる。"},
        { "location": "671/TALK"  , "narrator": "千羽鶴", "text": "多分――"},
        { "location": "672/TALK"  , "narrator": "千羽鶴", "text": "貴方のことが好き。"},
        { "location": "673/TALK"  , "narrator": "千羽鶴", "text": "離れたくない。\nだから、とても悲しい。"},
        { "location": "674/SEL"   , "narrator": "", "text": "$me$も千羽鶴を愛してるよ"},
        { "location": "675/SEL"   , "narrator": "", "text": "ありがとう"},
        { "location": "676/ACT"   , "narrator": "", "text": "$me$も千羽鶴を愛してるよ"},
        { "location": "679/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "680/TALK"  , "narrator": "千羽鶴", "text": "私、もうタダの\n一人格でしかないし――"},
        { "location": "681/TALK"  , "narrator": "千羽鶴", "text": "自分の気持ちに\n正直になっても\n許されると思う。"},
        { "location": "682/TALK"  , "narrator": "千羽鶴", "text": "だから――"},
        { "location": "698/TALK"  , "narrator": "千羽鶴", "text": "…っ！！"},
        { "location": "699/TALK"  , "narrator": "千羽鶴", "text": "凄くうれしい。"},
        { "location": "702/TALK"  , "narrator": "千羽鶴", "text": "…っ！！"},
        { "location": "703/TALK"  , "narrator": "千羽鶴", "text": "凄くうれしい。"},
        { "location": "711/TALK"  , "narrator": "千羽鶴", "text": "幸せな気持ちって、\nこういう感覚なのね。"},
        { "location": "712/SEL"   , "narrator": "", "text": "千羽鶴！千羽鶴！！"},
        { "location": "713/SEL"   , "narrator": "", "text": "$me$も同じ気持ちだよ"},
        { "location": "714/ACT"   , "narrator": "", "text": "千羽鶴！千羽鶴！！"},
        { "location": "720/TALK"  , "narrator": "千羽鶴", "text": "……ん。"},
        { "location": "723/ACT"   , "narrator": "", "text": "$me$も同じ気持ちだよ"},
        { "location": "726/TALK"  , "narrator": "千羽鶴", "text": "通じ合ってるのね。"},
        { "location": "730/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "731/TALK"  , "narrator": "千羽鶴", "text": "しなくて良かったの？"},
        { "location": "732/TALK"  , "narrator": "千羽鶴", "text": "まあ、私は\n構わないけど。"},
        { "location": "734/ACT"   , "narrator": "", "text": "ありがとう"},
        { "location": "736/ACT"   , "narrator": "", "text": "まあそんなものかと"},
        { "location": "737/TALK"  , "narrator": "千羽鶴", "text": "そう……。"},
        { "location": "740/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、私は\nそろそろ私は\n行かなくちゃ。"},
        { "location": "741/SEL"   , "narrator": "", "text": "千羽鶴行かないで！"},
        { "location": "742/SEL"   , "narrator": "", "text": "それってまさか……"},
        { "location": "743/ACT"   , "narrator": "", "text": "千羽鶴行かないで！"},
        { "location": "744/TALK"  , "narrator": "千羽鶴", "text": "……無理。"},
        { "location": "745/ACT"   , "narrator": "", "text": "それってまさか……"},
        { "location": "746/TALK"  , "narrator": "千羽鶴", "text": "ええ。その通り。"},
        { "location": "747/TALK"  , "narrator": "千羽鶴", "text": "だってわたし――"},
        { "location": "752/TALK"  , "narrator": "千羽鶴", "text": "カレンの\nセルフクラン講習を\nしないといけないから！"},
        { "location": "753/SEL"   , "narrator": "", "text": "え"},
        { "location": "754/ACT"   , "narrator": "", "text": "え"},
        { "location": "756/TALK"  , "narrator": "千羽鶴", "text": "あの子、このままだと\nセルフ落第しそうだし。"},
        { "location": "757/TALK"  , "narrator": "千羽鶴", "text": "貴方も応援してあげて。"},
        { "location": "758/SEL"   , "narrator": "", "text": "あ、はい……"},
        { "location": "759/ACT"   , "narrator": "", "text": "あ、はい……"},
        { "location": "762/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、また。"},
        { "location": "764/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "765/TALK"  , "narrator": "千羽鶴", "text": "いつでも、\n遊びに来て……\nだーりん。"},
        { "location": "767/TALK"  , "narrator": "千羽鶴", "text": "いつでも\n遊びに来て。"},
        { "location": "783/TALK"  , "narrator": "カレン", "text": "今回の件は、\n色々ありがとう\nございました！"},
        { "location": "784/TALK"  , "narrator": "カレン", "text": "これからが大変ですけど、\n頑張りますから、\n宜しくお願いします！"},
        { "location": "785/TALK"  , "narrator": "カレン", "text": "百鶴さんも、\nきっと喜んでくれてると\n思います……。"},
        { "location": "786/SEL"   , "narrator": "", "text": "百鶴って、本当に……"},
        { "location": "787/ACT"   , "narrator": "", "text": "百鶴って、本当に……"},
        { "location": "789/TALK"  , "narrator": "カレン", "text": "百鶴さんは……"},
        { "location": "790/TALK"  , "narrator": "カレン", "text": "百鶴さんは……っ！"},
        { "location": "791/SEL"   , "narrator": "", "text": "カレン……"},
        { "location": "792/ACT"   , "narrator": "", "text": "カレン……"},
        { "location": "797/TALK"  , "narrator": "カレン", "text": "あの日以来、部屋に引きこ\nもってコタツでゴロゴロし\nて蜜柑ばかり食べてます！"},
        { "location": "798/SEL"   , "narrator": "", "text": "え"},
        { "location": "799/ACT"   , "narrator": "", "text": "え"},
        { "location": "801/TALK"  , "narrator": "カレン", "text": "仕事して下さいって\n言いに行っても、影響が\n出るからダメだとか！"},
        { "location": "802/TALK"  , "narrator": "カレン", "text": "挙げ句には『この目を\n見ればわかる通り、本来\n怠け者なんです』とか！"},
        { "location": "803/TALK"  , "narrator": "カレン", "text": "今遊ばずに\nいつ遊ぶのか、とか！！"},
        { "location": "804/TALK"  , "narrator": "カレン", "text": "そんな事ばっかり言って\n全然仕事して\nくれないんです！"},
        { "location": "805/TALK"  , "narrator": "カレン", "text": "$handle$さん\nからも、ビシッと\n言ってやって下さい！"},
        { "location": "806/SEL"   , "narrator": "", "text": "お、おう…"},
        { "location": "807/ACT"   , "narrator": "", "text": "お、おう…"},
        { "location": "809/TALK"  , "narrator": "カレン", "text": "あ……"},
        { "location": "810/TALK"  , "narrator": "カレン", "text": "やっぱりいいです！"},
        { "location": "811/TALK"  , "narrator": "カレン", "text": "$handle$さんが\n行ったら、嬉々として\n部屋から出てきそうだし。"},
        { "location": "812/TALK"  , "narrator": "カレン", "text": "わたし、\nがんばります！！"},
        { "location": "813/SEL"   , "narrator": "", "text": "た、大変だね…"},
        { "location": "814/ACT"   , "narrator": "", "text": "た、大変だね…"},
        { "location": "818/TALK"  , "narrator": "カレン", "text": "大変です！\n大変なので――"},
        { "location": "834/TALK"  , "narrator": "カレン", "text": "ふわぁっ……"},
        { "location": "835/TALK"  , "narrator": "カレン", "text": "えへへ。\n幸せです…。"},
        { "location": "838/TALK"  , "narrator": "カレン", "text": "ふわぁっ……"},
        { "location": "839/TALK"  , "narrator": "カレン", "text": "えへへ。\n幸せです…。"},
        { "location": "845/TALK"  , "narrator": "カレン", "text": "お陰で\n元気が出ました！"},
        { "location": "846/TALK"  , "narrator": "カレン", "text": "$handle$さん。\n本当にいろいろ\nありがとうございました！"},
        { "location": "847/TALK"  , "narrator": "カレン", "text": "いつも色々お願い\nしちゃって本当に\n頼ってばかりですけど――"},
        { "location": "848/TALK"  , "narrator": "カレン", "text": "よろしければ、\nこれからもよろしく\nお願いします！"},
        { "location": "849/SEL"   , "narrator": "", "text": "こちらこそ"},
        { "location": "850/ACT"   , "narrator": "", "text": "こちらこそ"},
        { "location": "852/TALK"  , "narrator": "カレン", "text": "はいっ！"},
        { "location": "853/TALK"  , "narrator": "カレン", "text": "それじゃ、\nまたです！"},
        { "location": "31/DIALOG" , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "35/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>11月6日　1:03 PM</color>\nとある休日、FreyMenowライブ会場にて"},
        { "location": "213/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "215/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "217/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "219/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "221/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "691/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "707/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "827/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "843/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
