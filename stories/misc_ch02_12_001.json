        { "location": "49/SEL"    , "narrator": "", "text": "ますますわからない……"},
        { "location": "50/SEL"    , "narrator": "", "text": "もうちょっと説明して"},
        { "location": "51/SEL"    , "narrator": "", "text": "熊が化粧するの？"},
        { "location": "52/ACT"    , "narrator": "", "text": "ますますわからない……"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "工ｴｴｪｪ(´д｀)ｪｪｴｴ工"},
        { "location": "54/ACT"    , "narrator": "", "text": "もうちょっと説明して"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "えーと"},
        { "location": "56/ACT"    , "narrator": "", "text": "熊が化粧するの？"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "違うわよヽ(￣(ｴ)￣)ﾉ"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "化粧品のパッケージに熊は何で使わないお頭"},
