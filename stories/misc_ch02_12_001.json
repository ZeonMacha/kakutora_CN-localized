        { "location": "65/SEL"    , "narrator": "", "text": "イメージ的なことじゃないかな……"},
        { "location": "66/SEL"    , "narrator": "", "text": "そういうもんなんだ"},
        { "location": "67/SEL"    , "narrator": "", "text": "熊イケてるよね"},
        { "location": "68/ACT"    , "narrator": "", "text": "イメージ的なことじゃないかな……"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "イメージいいわよ熊\n（ノ ﾟДﾟ）ノ\n　＝＝＝＝　┻━━┻ "},
