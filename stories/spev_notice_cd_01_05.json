{
    "dir": "chap00/daydra/spev_notice_cd_01_05.js",
    "type": "",
    "info": {
        "story_id": "91055",
        "cid": "",
        "title": "005 アフターストーリー",
        "sub_title": "ガブリエラの思い出"
    },
    "entry":
    [
        { "location": "1326/DIALOG", "narrator": "", "text": "<color=green>某月某日　5:16 PM</color>\nとある平日の放課後、神楽坂トライナリー楽屋にて。"},
        { "location": "1327/TALK"  , "narrator": "真幌", "text": "ギャヴィ。\nおまえが置こうとしている\nテーブルだが…。"},
        { "location": "1328/TALK"  , "narrator": "真幌", "text": "さすがに高過ぎる。\nもっと安いのに変えろ。"},
        { "location": "1330/TALK"  , "narrator": "ガブリエラ", "text": "モダン和風で\n統一するんだから、\nこれくらい仕方ないのよ。"},
        { "location": "1331/TALK"  , "narrator": "真幌", "text": "もっと安く手に入る\nレプリカじゃダメなのか？"},
        { "location": "1334/TALK"  , "narrator": "ガブリエラ", "text": "レプリカなんかじゃ\n安っぽくなっちゃう\nでしょ？"},
        { "location": "1335/TALK"  , "narrator": "神楽", "text": "うーん…。"},
        { "location": "1336/TALK"  , "narrator": "神楽", "text": "…そうだ。\n全く同じとはいかないかも\nしれませんけど…。"},
        { "location": "1337/TALK"  , "narrator": "神楽", "text": "似たようなのがありそうな\nお店を知っているんで、\n一度行ってみませんか？"},
        { "location": "1338/TALK"  , "narrator": "ガブリエラ", "text": "…いいけど。"},
        { "location": "1340/TALK"  , "narrator": "神楽", "text": "大丈夫ですよ。\nきっと、気に入るモノが\n見つかりますから…。"},
        { "location": "1352/TALK"  , "narrator": "ガブリエラ", "text": "へぇ…思ったより\n悪くない品揃えね。"},
        { "location": "1354/TALK"  , "narrator": "神楽", "text": "このショッピングセンター\nに、本を買いに来たときに\n見つけたんです。"},
        { "location": "1355/TALK"  , "narrator": "神楽", "text": "ここのお店、オシャレな\n家具が沢山揃ってるん\nですよ。"},
        { "location": "1357/TALK"  , "narrator": "神楽", "text": "あ、ガブちゃん。\nこのテーブル、さっきのに\nそっくりじゃないですか？"},
        { "location": "1359/TALK"  , "narrator": "ガブリエラ", "text": "うそっ！？\nあたしが見つけたのより\n全然安いわ！"},
        { "location": "1360/TALK"  , "narrator": "神楽", "text": "レプリカですからね。\nでも、そんな風には\n見えないでしょう？"},
        { "location": "1362/TALK"  , "narrator": "ガブリエラ", "text": "…侮ってたわ。\nこんなクオリティ高いのが\nあったなんて…。"},
        { "location": "1364/TALK"  , "narrator": "神楽", "text": "どうですか？\nこれなら十分代わりに\nなると思うんですけど…。"},
        { "location": "1368/TALK"  , "narrator": "ガブリエラ", "text": "ええ、問題ないわ。\nいいお店教えてくれて\n助かったわ。"},
        { "location": "1372/TALK"  , "narrator": "神楽", "text": "じゃあ、早速真幌さんに\n連絡しますね。"},
        { "location": "1386/TALK"  , "narrator": "ガブリエラ", "text": "ふぅ…まほからも\nＯＫの連絡もらえたし、\nこれで一安心だわ。"},
        { "location": "1387/TALK"  , "narrator": "神楽", "text": "椅子とテーブルがないと、\nお店が始まりません\nからね。"},
        { "location": "1388/TALK"  , "narrator": "ガブリエラ", "text": "そうね…本当助かったわ。\nありがと…。"},
        { "location": "1389/TALK"  , "narrator": "神楽", "text": "力になれたなら、\n何よりです。"},
        { "location": "1390/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "1391/TALK"  , "narrator": "神楽", "text": "ガブちゃん？"},
        { "location": "1392/TALK"  , "narrator": "ガブリエラ", "text": "あのさ、こういうの\nそろそろ終わりにしない？"},
        { "location": "1394/TALK"  , "narrator": "神楽", "text": "…ごめんなさい。\n余計なこと言って、\n連れ出すようなマネを――"},
        { "location": "1395/TALK"  , "narrator": "ガブリエラ", "text": "ち、違う違う！\nなにバカなこと\n言い出すのよ！？"},
        { "location": "1397/TALK"  , "narrator": "神楽", "text": "ち、違うんですか？\nそれじゃやっぱり、\n私と一緒にいるのが……"},
        { "location": "1398/TALK"  , "narrator": "ガブリエラ", "text": "…あんたさ、\nいい加減にしなさいよ？"},
        { "location": "1399/TALK"  , "narrator": "ガブリエラ", "text": "あたしもみんなも、\nそのことはもういいって\n言ったでしょ？"},
        { "location": "1400/TALK"  , "narrator": "ガブリエラ", "text": "いいって言ってんだから、\nいつまでもズルズル\n引きずらないでよね？"},
        { "location": "1402/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1403/TALK"  , "narrator": "ガブリエラ", "text": "…あたしが言おうとして\nたのは…神楽の態度よ。"},
        { "location": "1404/TALK"  , "narrator": "ガブリエラ", "text": "いつまでも、なんとなく\n他人行儀な感じで\n接してくるところ…。"},
        { "location": "1405/TALK"  , "narrator": "ガブリエラ", "text": "ぶっちゃけ、\nあまりいい気しないわ。"},
        { "location": "1406/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1407/TALK"  , "narrator": "ガブリエラ", "text": "まあ、今すぐ変えろとは\n言わないけど…。"},
        { "location": "1408/TALK"  , "narrator": "ガブリエラ", "text": "他人行儀な感じなのは、\nできるだけ早いとこ\n直してよね？"},
        { "location": "1409/TALK"  , "narrator": "ガブリエラ", "text": "神楽だって…その…。"},
        { "location": "1410/TALK"  , "narrator": "ガブリエラ", "text": "…友達なんだから。"},
        { "location": "1412/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1414/TALK"  , "narrator": "ガブリエラ", "text": "だ、黙ってないで、\n返事くらいしなさい！"},
        { "location": "1415/TALK"  , "narrator": "神楽", "text": "…わかりました。\nありがとう、ガブちゃん。"},
        { "location": "1416/TALK"  , "narrator": "ガブリエラ", "text": "そ、そう…。\nわかればいいのよ…。"},
        { "location": "1417/TALK"  , "narrator": "ガブリエラ", "text": "と、とにかく！\n今日の買い物で大きい物は\n揃ったことだし…。"},
        { "location": "1418/TALK"  , "narrator": "ガブリエラ", "text": "あとは細々したモノを\n揃えれば、\n開店に間に合うわ。"},
        { "location": "1419/TALK"  , "narrator": "神楽", "text": "あれ？　それじゃあ、\nガブちゃんはもう、\n食器を決めたんですか？"},
        { "location": "1420/TALK"  , "narrator": "ガブリエラ", "text": "え？　あっ！！"},
        { "location": "1421/TALK"  , "narrator": "ガブリエラ", "text": "インテリアのことで\n頭いっぱいだったから、\n忘れてたわ…。"},
        { "location": "1422/TALK"  , "narrator": "ガブリエラ", "text": "神楽はもう決めたの？"},
        { "location": "1424/TALK"  , "narrator": "神楽", "text": "二つの候補があって、\nどっちにするか\n悩み中です。"},
        { "location": "1425/TALK"  , "narrator": "ガブリエラ", "text": "そっか…。\nあたし、何にしよう\nかしら…？"},
        { "location": "1431/TALK"  , "narrator": "ガブリエラ", "text": "意外と難しいわ"},
        { "location": "1432/TALK"  , "narrator": "ガブリエラ", "text": "自分で作ったロゴを"},
        { "location": "1433/TALK"  , "narrator": "ガブリエラ", "text": "どの食器に付けたらいいかしら？"},
        { "location": "1435/SEL"   , "narrator": "（選択肢）", "text": "とにかく大きいお皿がいい"},
        { "location": "1436/SEL"   , "narrator": "（選択肢）", "text": "小さいお皿とかは？"},
        { "location": "1437/SEL"   , "narrator": "（選択肢）", "text": "ランチプレートは？"},
        { "location": "1438/ACT"   , "narrator": "", "text": "とにかく大きいお皿がいい"},
        { "location": "1439/TALK"  , "narrator": "ガブリエラ", "text": "言い方！"},
        { "location": "1440/TALK"  , "narrator": "ガブリエラ", "text": "パスタ用のお皿とかもいいかと思ったけど"},
        { "location": "1441/TALK"  , "narrator": "ガブリエラ", "text": "今ので気が変わったわ"},
        { "location": "1444/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "1445/TALK"  , "narrator": "ガブリエラ", "text": "お皿はいいチョイスだと思うわ"},
        { "location": "1446/ACT"   , "narrator": "", "text": "小さいお皿とかは？"},
        { "location": "1447/TALK"  , "narrator": "ガブリエラ", "text": "へえ"},
        { "location": "1448/TALK"  , "narrator": "ガブリエラ", "text": "中々素敵なチョイスね"},
        { "location": "1449/ACT"   , "narrator": "", "text": "ランチプレートは？"},
        { "location": "1450/TALK"  , "narrator": "ガブリエラ", "text": "ランチプレートはやらないと思うわ"},
        { "location": "1451/TALK"  , "narrator": "ガブリエラ", "text": "倉庫にあった食器の中に"},
        { "location": "1452/TALK"  , "narrator": "ガブリエラ", "text": "ランチプレートなんて入ってなかったし"},
        { "location": "1455/TALK"  , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "1456/TALK"  , "narrator": "ガブリエラ", "text": "ランチプレートではないけれど"},
        { "location": "1457/TALK"  , "narrator": "ガブリエラ", "text": "お皿とかいいかもしれないわね"},
        { "location": "1458/TALK"  , "narrator": "ガブリエラ", "text": "大きいのじゃなくて"},
        { "location": "1459/TALK"  , "narrator": "ガブリエラ", "text": "ケーキをのせられるくらいの大きさのとか"},
        { "location": "1461/TALK"  , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "1462/TALK"  , "narrator": "ガブリエラ", "text": "決めたわ"},
        { "location": "1463/TALK"  , "narrator": "ガブリエラ", "text": "私は小さいお皿にするってみんなに言うわ"},
        { "location": "1465/SEL"   , "narrator": "（選択肢）", "text": "決定？"},
        { "location": "1466/ACT"   , "narrator": "", "text": "決定？"},
        { "location": "1468/TALK"  , "narrator": "ガブリエラ", "text": "決定よ"},
        { "location": "1474/TALK"  , "narrator": "ガブリエラ", "text": "…決めた。\n小さいお皿にするわ。"},
        { "location": "1477/TALK"  , "narrator": "神楽", "text": "えっ、\nもう決めたんですか！？"},
        { "location": "1478/TALK"  , "narrator": "ガブリエラ", "text": "まあね…。カフェで\n出てくる、素敵な柄の\n小皿があるでしょ？"},
        { "location": "1479/TALK"  , "narrator": "神楽", "text": "ああ、クッキーとかが\n紅茶の添え物として\n出される時のような？"},
        { "location": "1480/TALK"  , "narrator": "ガブリエラ", "text": "そうそう。"},
        { "location": "1481/TALK"  , "narrator": "ガブリエラ", "text": "あれ、あたしがまだ\n小さい頃だったかしら？"},
        { "location": "1482/TALK"  , "narrator": "ガブリエラ", "text": "初めて和食を食べたときも\nそういうのが出てきたん\nだけど…。"},
        { "location": "1483/TALK"  , "narrator": "ガブリエラ", "text": "その時のお皿が、\nビックリするくらい\n素敵だったの。"},
        { "location": "1484/TALK"  , "narrator": "神楽", "text": "そんなに素敵な\nお皿だったんですか？"},
        { "location": "1485/TALK"  , "narrator": "ガブリエラ", "text": "ええ、あんまりにも\n素敵だったから…。"},
        { "location": "1486/TALK"  , "narrator": "ガブリエラ", "text": "家の白いお皿に、\n同じ模様を描こうとして\n怒られたっけ…。"},
        { "location": "1487/TALK"  , "narrator": "神楽", "text": "ふふっ、可愛らしい\n思い出ですね。"},
        { "location": "1488/TALK"  , "narrator": "ガブリエラ", "text": "か、可愛らしくなんか\nないわよ！"},
        { "location": "1489/TALK"  , "narrator": "神楽", "text": "…きっと、\n素敵なお皿になると\n思いますよ。"},
        { "location": "1491/TALK"  , "narrator": "ガブリエラ", "text": "…そうね。\nそうなってくれると、\n嬉しいわ"}
    ]
}
