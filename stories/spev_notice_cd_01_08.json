    "info": {
        "story_id": "91058",
        "cid": "",
        "title": "008 アフターストーリー",
        "sub_title": "<size=36>CAFÉ</size><size=10>　</size><size=36>FOYER</size><size=10>　</size><size=36>-KAGURAZAKA</size><size=10>　</size><size=36>TRINARY-</size>"
    },
    "entry":
    [
        { "location": "2067/DIALOG", "narrator": "", "text": "<color=green>某月某日　11:13 PM</color>\nとある休日、神楽坂トライナリー楽屋にて。"},
        { "location": "2069/TALK"  , "narrator": "つばめ", "text": "アーヤさん！\n食器が完成したって\n本当ですか？"},
        { "location": "2071/TALK"  , "narrator": "アーヤ", "text": "ええ、今さっき\n届いたばかりよ。"},
        { "location": "2073/TALK"  , "narrator": "ガブリエラ", "text": "その段ボールの中ね？\n早く開けてよ。"},
        { "location": "2074/TALK"  , "narrator": "アーヤ", "text": "はいはい。\n今開けるから\n慌てないで…。"},
        { "location": "2079/TALK"  , "narrator": "ガブリエラ", "text": "小皿は？\nあたしの小皿はどこ？"},
        { "location": "2080/TALK"  , "narrator": "アーヤ", "text": "ちょっと待って。\n一番上から順番に\n出すから…。"},
        { "location": "2081/TALK"  , "narrator": "アーヤ", "text": "まずは、みやびの\n小鉢からね。"},
        { "location": "2087/TALK"  , "narrator": "みやび", "text": "おおっ、思うてたより\nえい感じやね！"},
        { "location": "2088/TALK"  , "narrator": "みやび", "text": "ちゃんとうちのロゴも\n綺麗に印刷されちょるし、\nえい仕上がりちや。"},
        { "location": "2090/TALK"  , "narrator": "ガブリエラ", "text": "和と洋がいい感じで\n融合した素敵な一品ね！"},
        { "location": "2091/TALK"  , "narrator": "アーヤ", "text": "ほんとね。\nランチデザートに\nぴったりだわ。"},
        { "location": "2095/TALK"  , "narrator": "神楽", "text": "あっ、次のって\nつばめさんのじゃ\nないですか？"},
        { "location": "2096/TALK"  , "narrator": "つばめ", "text": "あっ、本当だ！"},
        { "location": "2101/TALK"  , "narrator": "つばめ", "text": "やったー！\n見てみて、神楽ちゃん。\nわたしのお茶碗！"},
        { "location": "2102/TALK"  , "narrator": "神楽", "text": "とっても素敵です！\n可愛いお茶碗に\nなりましたね。"},
        { "location": "2104/TALK"  , "narrator": "みやび", "text": "うちもそう思うがよ。\nこれ、一つもらってって\nえいか？"},
        { "location": "2106/TALK"  , "narrator": "ガブリエラ", "text": "お店で使うんだから\nダメに決まってるでしょ。"},
        { "location": "2109/TALK"  , "narrator": "アーヤ", "text": "あはは、多分大丈夫よ。"},
        { "location": "2110/TALK"  , "narrator": "アーヤ", "text": "かなり沢山\nあるみたいだし……"},
        { "location": "2112/TALK"  , "narrator": "みやび", "text": "さすがまほさん！\n気が利ぃちゅうがね。"},
        { "location": "2113/TALK"  , "narrator": "アーヤ", "text": "まあ、とりあえず\nそれは全部出してから\nということで…。"},
        { "location": "2114/TALK"  , "narrator": "アーヤ", "text": "あっ、これは…。"},
        { "location": "2118/TALK"  , "narrator": "神楽", "text": "アーヤさんのですね。"},
        { "location": "2121/TALK"  , "narrator": "ガブリエラ", "text": "フォークとスプーン…、\nアーヤのは二つなのね。"},
        { "location": "2122/TALK"  , "narrator": "アーヤ", "text": "だって、こういうのは\n普通セットでしょ？"},
        { "location": "2124/TALK"  , "narrator": "みやび", "text": "…ま、確かにそうやね。\nフォーク一本じゃ\nパスタも食べられんし。"},
        { "location": "2126/TALK"  , "narrator": "つばめ", "text": "でも、アーヤさんなら\nフォークとナイフの方が\nよかったんじゃ…。"},
        { "location": "2128/TALK"  , "narrator": "アーヤ", "text": "それも考えてたけど、\n縁起がね…。"},
        { "location": "2131/TALK"  , "narrator": "ガブリエラ", "text": "アーヤらしいわね。\nまったく…。"},
        { "location": "2132/TALK"  , "narrator": "アーヤ", "text": "い、いいでしょ？\nほら、次はギャヴィの\n小皿よ。"},
        { "location": "2134/TALK"  , "narrator": "ガブリエラ", "text": "え、どれどれ！"},
        { "location": "2138/TALK"  , "narrator": "ガブリエラ", "text": "わぁ、イメージ通りよ！"},
        { "location": "2140/TALK"  , "narrator": "つばめ", "text": "かわいい！\nあ、いいこと思いついた！"},
        { "location": "2142/TALK"  , "narrator": "つばめ", "text": "コレの隣に、アーヤさんの\nフォークとスプーンの\nセットを置くと…。"},
        { "location": "2143/TALK"  , "narrator": "神楽", "text": "あ、いいバランスですね。\nデザートとかにいいんじゃ\nないですか？"},
        { "location": "2145/TALK"  , "narrator": "ガブリエラ", "text": "へぇ…つばめにしては\nいいところに\n気づいたわね。"},
        { "location": "2146/TALK"  , "narrator": "つばめ", "text": "えへへ…。"},
        { "location": "2148/TALK"  , "narrator": "ガブリエラ", "text": "それじゃあ、\n最後は神楽のね。"},
        { "location": "2149/TALK"  , "narrator": "神楽", "text": "はい…。アーヤさん、\nお願いします。"},
        { "location": "2151/TALK"  , "narrator": "アーヤ", "text": "ええ、今出すわ。"},
        { "location": "2155/TALK"  , "narrator": "アーヤ", "text": "はい、これね。"},
        { "location": "2157/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2161/TALK"  , "narrator": "つばめ", "text": "あれ、どうしたの？\nイメージと違ってた？"},
        { "location": "2163/TALK"  , "narrator": "神楽", "text": "…いいえ。\nとっても素敵です。"},
        { "location": "2164/TALK"  , "narrator": "神楽", "text": "ちょっと感動しちゃって、\n言葉に詰まってました。"},
        { "location": "2166/TALK"  , "narrator": "ガブリエラ", "text": "大袈裟すぎでしょ…。"},
        { "location": "2167/TALK"  , "narrator": "神楽", "text": "でも、本当に素敵で…。"},
        { "location": "2168/TALK"  , "narrator": "神楽", "text": "あ、そうだ！\nもしよかったら\nあとで…。"},
        { "location": "2169/TALK"  , "narrator": "神楽", "text": "このマグカップで、\nティータイムに\nしませんか？"},
        { "location": "2171/TALK"  , "narrator": "みやび", "text": "おっ、早速使うか。"},
        { "location": "2176/TALK"  , "narrator": "つばめ", "text": "いいなぁ。\nわたしのはお茶碗だから\n使えないし…。"},
        { "location": "2178/TALK"  , "narrator": "ガブリエラ", "text": "うー、あたしも\nティーカップとかにすれば\nよかったかも…。"},
        { "location": "2180/TALK"  , "narrator": "アーヤ", "text": "ふふっ、これから\nいくらでも使うときが\n出てくるわよ。"},
        { "location": "2182/TALK"  , "narrator": "みやび", "text": "しっかし、うちらが\nもらう分を抜いたと\nしても…。"},
        { "location": "2183/TALK"  , "narrator": "みやび", "text": "かなりの量あると\n思うんやけんど…。"},
        { "location": "2184/TALK"  , "narrator": "アーヤ", "text": "っていうか、どうして\nこんなに沢山作ったの？"},
        { "location": "2185/TALK"  , "narrator": "神楽", "text": "コスパの問題だって\n真幌さんが\n言ってましたよ？"},
        { "location": "2186/TALK"  , "narrator": "ガブリエラ", "text": "そうは言っても\n限度ってものが\nあるでしょ……。"},
        { "location": "2188/TALK"  , "narrator": "つばめ", "text": "でも、お客さんが沢山\n来たら、あって良かった\nって思うかも！"},
        { "location": "2190/TALK"  , "narrator": "アーヤ", "text": "えっと、その分の料理は\n誰が創るのかしら……。"},
        { "location": "2192/TALK"  , "narrator": "ガブリエラ", "text": "まあ、あれよね。\nつばめが転んで\n割るかもしれないし。"},
        { "location": "2194/TALK"  , "narrator": "つばめ", "text": "こ、こんなに\n沢山割るほど\n転ばないよ！"},
        { "location": "2196/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2198/TALK"  , "narrator": "神楽", "text": "あの…その食器ですけど、\nもし本当に余裕がある\nようでしたら…。"},
        { "location": "2199/TALK"  , "narrator": "神楽", "text": "ギフトセットにして\n販売するっていうのは\nどうでしょう？"},
        { "location": "2202/TALK"  , "narrator": "アーヤ", "text": "あ、それそれ！\n私もそういうのが\nやってみたかったのよね。"},
        { "location": "2204/TALK"  , "narrator": "みやび", "text": "ふむ、なるほど。\nまあ、遊ばせておくより\nよっぽどえいね。"},
        { "location": "2205/TALK"  , "narrator": "みやび", "text": "ほんだら、ついでと\n言っちゃなんやけんど、\n相棒にも送っちゃろか。"},
        { "location": "2207/TALK"  , "narrator": "神楽", "text": "$handle$さんに？\nそれ、名案ですね！\n例のアレも使えますし。"},
        { "location": "2208/TALK"  , "narrator": "みやび", "text": "うむ。\n卯月の本使った転送試験も\n成功したしな。"},
        { "location": "2209/TALK"  , "narrator": "つばめ", "text": "それ、賛成！\nわたしも送りたい。"},
        { "location": "2211/TALK"  , "narrator": "アーヤ", "text": "私も、賛成するわ。"},
        { "location": "2212/TALK"  , "narrator": "ガブリエラ", "text": "…そうね。"},
        { "location": "2213/TALK"  , "narrator": "ガブリエラ", "text": "同じ器で\nご飯たべられたら、\nちょっといいかも……。"},
        { "location": "2218/TALK"  , "narrator": "みやび", "text": "よし、ほんだら早速\n相棒に話してみるかね。"},
        { "location": "2224/TALK"  , "narrator": "神楽", "text": "わかりました。\nじゃあ、私のＷＡＶＥで\n話しかけますね。"},
        { "location": "2225/TALK"  , "narrator": "神楽", "text": "皆さんも一緒に\n入ってきてください。"},
        { "location": "2238/TALK"  , "narrator": "神楽", "text": "$handle$さん♪"},
        { "location": "2240/TALK"  , "narrator": "つばめ", "text": "$handle$さーんヽ(*´∀｀*)ﾉ"},
        { "location": "2242/TALK"  , "narrator": "みやび", "text": "む"},
        { "location": "2244/TALK"  , "narrator": "ガブリエラ", "text": "入ったわよ"},
        { "location": "2245/TALK"  , "narrator": "アーヤ", "text": "みんないると賑やかね(^^"},
        { "location": "2246/TALK"  , "narrator": "神楽", "text": "Welcome To Our Phantasy!!"},
        { "location": "2248/TALK"  , "narrator": "神楽", "text": "ようこそ乙女の園へ♪"},
        { "location": "2250/SEL"   , "narrator": "（選択肢）", "text": "たまらないなぁ"},
        { "location": "2251/SEL"   , "narrator": "（選択肢）", "text": "全員揃ってどうしたの？"},
        { "location": "2252/ACT"   , "narrator": "", "text": "たまらないなぁ"},
        { "location": "2253/TALK"  , "narrator": "神楽", "text": "なにがですか？ちゃんと具体的に言ってくれないとわかりませんよ？？"},
        { "location": "2255/TALK"  , "narrator": "つばめ", "text": "たまらなぃって"},
        { "location": "2256/TALK"  , "narrator": "つばめ", "text": "なにがかな？(･Д･｀)"},
        { "location": "2258/TALK"  , "narrator": "アーヤ", "text": "気にしないでいいから(>_<)"},
        { "location": "2259/TALK"  , "narrator": "アーヤ", "text": "$handle$も"},
        { "location": "2260/TALK"  , "narrator": "アーヤ", "text": "変なこと言わない(｀ヘ´)"},
        { "location": "2261/ACT"   , "narrator": "", "text": "全員揃ってどうしたの？"},
        { "location": "2262/TALK"  , "narrator": "ガブリエラ", "text": "$handle$にお話ししたいことがあるのよ？"},
        { "location": "2263/TALK"  , "narrator": "みやび", "text": "まあ、そういうことだ"},
        { "location": "2264/TALK"  , "narrator": "みやび", "text": "付き合ってもらうぞね"},
        { "location": "2267/TALK"  , "narrator": "アーヤ", "text": "私たちの作った食器"},
        { "location": "2268/TALK"  , "narrator": "アーヤ", "text": "今日届いたの(*^^*)"},
        { "location": "2269/TALK"  , "narrator": "つばめ", "text": "どれも"},
        { "location": "2271/TALK"  , "narrator": "つばめ", "text": "とってもかわぃぃんだょ～～～～！"},
        { "location": "2273/TALK"  , "narrator": "みやび", "text": "ロゴも明瞭"},
        { "location": "2274/TALK"  , "narrator": "みやび", "text": "素晴らしき印刷技術"},
        { "location": "2276/TALK"  , "narrator": "ガブリエラ", "text": "あまり印刷って言わないで欲しいんだけど？"},
        { "location": "2277/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと感動が薄れちゃうわよね"},
        { "location": "2278/TALK"  , "narrator": "神楽", "text": "そういうわけで、私たちのカフェで使う食器が出来ましたので、今日は$handle$さんにもお披露目しちゃいます♪"},
        { "location": "2279/TALK"  , "narrator": "神楽", "text": "それで、もし気に入ったなら送っちゃおうかと！"},
        { "location": "2281/TALK"  , "narrator": "みやび", "text": "例のあのシステムな"},
        { "location": "2284/TALK"  , "narrator": "神楽", "text": "夏にぴょんこの薄い本を送ったアレですよっ♪"},
        { "location": "2286/SEL"   , "narrator": "（選択肢）", "text": "転送してくれるの？"},
        { "location": "2287/ACT"   , "narrator": "", "text": "転送してくれるの？"},
        { "location": "2289/TALK"  , "narrator": "アーヤ", "text": "もちろんよ(*^o^*)"},
        { "location": "2290/TALK"  , "narrator": "アーヤ", "text": "まあ、$handle$が欲しければ、だけど(^^;;"},
        { "location": "2291/TALK"  , "narrator": "神楽", "text": "ガブちゃんが、$handle$さんと同じ食器で御食事出来るなんてシ・ア・ワ・セ♪って言ってましたよ？"},
        { "location": "2293/TALK"  , "narrator": "ガブリエラ", "text": "ちょちょっと神楽！そんな事言ってないから！！！！"},
        { "location": "2294/TALK"  , "narrator": "つばめ", "text": "でも、$handle$さんと同じものでご飯食べてるって思えたら"},
        { "location": "2295/TALK"  , "narrator": "つばめ", "text": "わたしもちょっと嬉しいかなぁ:.ﾟヽ(´∀`｡)ﾉﾟ.:｡ ゜"},
        { "location": "2297/TALK"  , "narrator": "ガブリエラ", "text": "言ってないはちょっと正確じゃなかったわ…"},
        { "location": "2298/TALK"  , "narrator": "ガブリエラ", "text": "私もつばめと同じ"},
        { "location": "2299/TALK"  , "narrator": "みやび", "text": "うちの使いづらい小鉢、使いこなせるかね？"},
        { "location": "2300/TALK"  , "narrator": "みやび", "text": "これは挑戦状である。受けて立て"},
        { "location": "2302/TALK"  , "narrator": "神楽", "text": "私のはマグカップですから、まったり使えますよっ♪"},
        { "location": "2303/TALK"  , "narrator": "神楽", "text": "私だと思って、いつも枕元においてくださいねっ♪"},
        { "location": "2305/TALK"  , "narrator": "みやび", "text": "ソッコー茶渋塗れ街道驀進か"},
        { "location": "2306/TALK"  , "narrator": "神楽", "text": "私だと思ってちゃんと毎日洗ってくださいね"},
        { "location": "2308/TALK"  , "narrator": "アーヤ", "text": "心配しなくても"},
        { "location": "2309/TALK"  , "narrator": "アーヤ", "text": "綺麗に使ってくれると思う"},
        { "location": "2310/TALK"  , "narrator": "ガブリエラ", "text": "はいはいそういう話はリアルでして"},
        { "location": "2311/TALK"  , "narrator": "ガブリエラ", "text": "とにかく$marzanna$"},
        { "location": "2312/TALK"  , "narrator": "ガブリエラ", "text": "もし受け取ってもらえるなら、私たちの作った食器を"},
        { "location": "2313/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$にもお裾分けするってことだから"},
        { "location": "2314/TALK"  , "narrator": "ガブリエラ", "text": "大切に使ってよね？"},
        { "location": "2315/TALK"  , "narrator": "つばめ", "text": "毎日使ってくれると嬉しぃなぁ～～～(≧ω≦)"},
        { "location": "2317/TALK"  , "narrator": "みやび", "text": "使わず保存はいかんぞ"},
        { "location": "2318/TALK"  , "narrator": "みやび", "text": "食器も"},
        { "location": "2319/TALK"  , "narrator": "みやび", "text": "神隠しに合うのだ"},
        { "location": "2321/TALK"  , "narrator": "アーヤ", "text": "なくなるだけだから(-ω-;)"},
        { "location": "2322/TALK"  , "narrator": "つばめ", "text": "一緒にご飯食べてる気持ちになれるし"},
        { "location": "2324/TALK"  , "narrator": "つばめ", "text": "ちょっぴりしあわせ～～～(*´ω｀*)"},
        { "location": "2326/SEL"   , "narrator": "（選択肢）", "text": "楽しみにしてる"},
        { "location": "2327/SEL"   , "narrator": "（選択肢）", "text": "大切に使わせてもらうね"},
        { "location": "2328/SEL"   , "narrator": "（選択肢）", "text": "ついでに全員、お嫁においでよ"},
        { "location": "2329/ACT"   , "narrator": "", "text": "楽しみにしてる"},
        { "location": "2330/TALK"  , "narrator": "つばめ", "text": "ぅん(´∀｀*)ｳﾌﾌ"},
        { "location": "2332/TALK"  , "narrator": "ガブリエラ", "text": "今のうちに食器に合う料理を作れるように"},
        { "location": "2333/TALK"  , "narrator": "ガブリエラ", "text": "練習しておくといいんじゃないかしらｖｖｖ"},
        { "location": "2334/TALK"  , "narrator": "アーヤ", "text": "てことは、少なくとも"},
        { "location": "2335/TALK"  , "narrator": "アーヤ", "text": "五品は作れるようになるわね(￣∇￣)"},
        { "location": "2336/TALK"  , "narrator": "みやび", "text": "茶碗とマグカップに注ぐものは果たして料理と言えるものなのだろうか"},
        { "location": "2338/TALK"  , "narrator": "つばめ", "text": "美味しぃぉ米を炊く練習をするんだょ！ (´ω｀*)"},
        { "location": "2340/TALK"  , "narrator": "神楽", "text": "マグカップも、マグヌードルがありますっ♪"},
        { "location": "2342/TALK"  , "narrator": "アーヤ", "text": "それなら"},
        { "location": "2343/TALK"  , "narrator": "アーヤ", "text": "フォークで食べれるわね！！＼(^O^)／"},
        { "location": "2344/TALK"  , "narrator": "みやび", "text": "（´-`）.｡oO（うら若き乙女達よ…それでいいのか？）"},
        { "location": "2346/ACT"   , "narrator": "", "text": "大切に使わせてもらうね"},
        { "location": "2347/TALK"  , "narrator": "みやび", "text": "うむ"},
        { "location": "2349/TALK"  , "narrator": "みやび", "text": "使われれば食器も喜ぶであろう"},
        { "location": "2351/TALK"  , "narrator": "つばめ", "text": "ぉ茶碗でご飯"},
        { "location": "2352/TALK"  , "narrator": "つばめ", "text": "ぃーっぱぃ食べてね(๑･ㅂ･)و☆"},
        { "location": "2354/TALK"  , "narrator": "ガブリエラ", "text": "$handle$を太らせるつもり？"},
        { "location": "2355/TALK"  , "narrator": "アーヤ", "text": "んーでも確かに"},
        { "location": "2356/TALK"  , "narrator": "アーヤ", "text": "痩せすぎてるよりはいいんじゃない？"},
        { "location": "2357/TALK"  , "narrator": "神楽", "text": "正解は！"},
        { "location": "2358/TALK"  , "narrator": "神楽", "text": "沢山食べて沢山運動する、だぴょん♪"},
        { "location": "2360/TALK"  , "narrator": "みやび", "text": "相棒よ、いっぱい食べて胸をおおきくすべし"},
        { "location": "2362/TALK"  , "narrator": "神楽", "text": "後でみやびさんのお部屋にお邪魔しますね♪"},
        { "location": "2364/ACT"   , "narrator": "", "text": "ついでに全員、お嫁においでよ"},
        { "location": "2365/TALK"  , "narrator": "つばめ", "text": "ぇぇっ！？(ﾟ△ﾟ;ﾉ)ﾉ"},
        { "location": "2368/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと！なんてこと言い出すのよ；；；"},
        { "location": "2369/TALK"  , "narrator": "アーヤ", "text": "確かにちょっと失礼な話よね"},
        { "location": "2370/TALK"  , "narrator": "アーヤ", "text": "私たちは食器のついでってことでしょ？(--#)"},
        { "location": "2371/TALK"  , "narrator": "みやび", "text": "アーヤ先生目の付け所が違う斬新発想"},
        { "location": "2373/TALK"  , "narrator": "ガブリエラ", "text": "ていうか、みんなお嫁にとか言ってるけど"},
        { "location": "2374/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$の方って、重婚が法律でOKってことなのかしらね？？"},
        { "location": "2375/TALK"  , "narrator": "神楽", "text": "ガブちゃん、それくらいにしておいてあげてください"},
        { "location": "2376/TALK"  , "narrator": "神楽", "text": "$handle$さんは、ハーレムというラノベ主人公的な妄想に浸っていただけなのです。もう少し夢をみさせてあげましょう♪"},
        { "location": "2378/TALK"  , "narrator": "ガブリエラ", "text": "いいこといってる風でかなり$marzanna$のことディスってない？"},
        { "location": "2379/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "2380/TALK"  , "narrator": "つばめ", "text": "みんなで$handle$さんのぉ嫁さんになれたら"},
        { "location": "2381/TALK"  , "narrator": "つばめ", "text": "ちょっと楽しそぅかも (*´∀`*)"},
        { "location": "2383/TALK"  , "narrator": "ガブリエラ", "text": "いやなにバカなこと言ってんのよ！？"},
        { "location": "2386/TALK"  , "narrator": "つばめ", "text": "だって"},
        { "location": "2387/TALK"  , "narrator": "つばめ", "text": "ずーっとみんな一緒だし(≧艸≦*)"},
        { "location": "2389/TALK"  , "narrator": "アーヤ", "text": "まあ、確かにそう考えると楽しいかもしれないけど"},
        { "location": "2390/TALK"  , "narrator": "アーヤ", "text": "でもやっぱり、プライベートな時間がないと疲れちゃうかも…（；￢＿￢）"},
        { "location": "2391/TALK"  , "narrator": "神楽", "text": "ぴょんこは、つばめさんらしい可愛らしい考えだと思いますっ♪でもぴょんこ自身はつばめさんとのプライベートステージを希望します♪"},
        { "location": "2393/TALK"  , "narrator": "みやび", "text": "では最後にうちの見解を聞かせてやろうか相棒"},
        { "location": "2395/TALK"  , "narrator": "みやび", "text": "結婚などという法的見解を求められる言葉を使うからこのようなややこしいことになる"},
        { "location": "2396/TALK"  , "narrator": "みやび", "text": "男だろうが女だろうがそこは正々堂々と5人まとめてイチャイチャしたいと言ってみいや"},
        { "location": "2398/SEL"   , "narrator": "（選択肢）", "text": "5人まとめてイチャイチャしたい！"},
        { "location": "2399/ACT"   , "narrator": "", "text": "5人まとめてイチャイチャしたい！"},
        { "location": "2401/TALK"  , "narrator": "みやび", "text": "却下"},
        { "location": "2403/TALK"  , "narrator": "神楽", "text": "呪まーす"},
        { "location": "2405/TALK"  , "narrator": "つばめ", "text": "えええええええっ！！"},
        { "location": "2407/TALK"  , "narrator": "つばめ", "text": "$handle$さんがかわいそぅ(´つω・｀)ｼｭﾝ"},
        { "location": "2408/TALK"  , "narrator": "つばめ", "text": "さっきまでみんな前向きだったのに"},
        { "location": "2410/TALK"  , "narrator": "アーヤ", "text": "えっと"},
        { "location": "2411/TALK"  , "narrator": "アーヤ", "text": "私はプライベートな時間が欲しいって言ったと思うけど(^^;;"},
        { "location": "2412/TALK"  , "narrator": "アーヤ", "text": "やっぱり二人だけの時間って大事よね、とっても(*^.^*)"},
        { "location": "2413/TALK"  , "narrator": "ガブリエラ", "text": "なにその乙女発言"},
        { "location": "2414/TALK"  , "narrator": "アーヤ", "text": "ギャヴィはみんなで一緒がいいと( ・_・)σﾞ"},
        { "location": "2415/TALK"  , "narrator": "ガブリエラ", "text": "そうは言ってないから！！！"},
        { "location": "2416/TALK"  , "narrator": "ガブリエラ", "text": "私だって同じ風に思ってるし"},
        { "location": "2417/TALK"  , "narrator": "みやび", "text": "判決"},
        { "location": "2418/TALK"  , "narrator": "みやび", "text": "敗訴！！！"},
        { "location": "2420/TALK"  , "narrator": "神楽", "text": "ぴょんこぴょこぴょこみぴょこぴょこあわせてぴょこぴょこむぴょんこぴょんこ♪"},
        { "location": "2422/TALK"  , "narrator": "アーヤ", "text": "早口言葉！？"},
        { "location": "2423/TALK"  , "narrator": "神楽", "text": "全部で６ぴょんこですっ♪"},
        { "location": "2425/TALK"  , "narrator": "つばめ", "text": "卯月さん意味わからないょ"},
        { "location": "2426/TALK"  , "narrator": "つばめ", "text": "ごめんね、$handle$さん"},
        { "location": "2427/TALK"  , "narrator": "つばめ", "text": "よくわかんない話しになっちゃって(´･ω･｀) "},
        { "location": "2428/TALK"  , "narrator": "つばめ", "text": "でもほんとに、わたしは$handle$さんと同じ器でご飯食べられたら嬉しいなって思うから"},
        { "location": "2430/TALK"  , "narrator": "つばめ", "text": "もしよかったら受け取ってくれたら嬉しいですヽ(*´∀｀)ノ"},
        { "location": "2445/TALK"  , "narrator": "神楽", "text": "さてと、とりあえず\n一度全部洗わないと\nいけませんね。"},
        { "location": "2447/TALK"  , "narrator": "アーヤ", "text": "洗うのだったら、\n私とみやびでやるわ。"},
        { "location": "2448/TALK"  , "narrator": "神楽", "text": "じゃあ、残りの三人で\n食器を置く場所の\n準備を…。"},
        { "location": "2450/TALK"  , "narrator": "ガブリエラ", "text": "あたしとつばめで\n大丈夫よ。"},
        { "location": "2451/TALK"  , "narrator": "ガブリエラ", "text": "あんたは仕切り役なん\nだから、まずはまほに\n報告でしょ？"},
        { "location": "2452/TALK"  , "narrator": "アーヤ", "text": "そういうこと。\n雑務は報告作業が\n終わってからよ。"},
        { "location": "2453/TALK"  , "narrator": "神楽", "text": "…ふふっ、仕切り役って\nやること沢山で、\nとっても重労働ですね。"},
        { "location": "2455/TALK"  , "narrator": "みやび", "text": "アーヤがやりたがらん\nかった気持ち、\nわかったか？"},
        { "location": "2456/TALK"  , "narrator": "アーヤ", "text": "いや、面倒だからやりたく\nなかったわけじゃなくて、\n卯月に――"},
        { "location": "2457/TALK"  , "narrator": "アーヤ", "text": "あ、ううん。\nそうなのよ、ちょっと\n面倒になっちゃって…。"},
        { "location": "2458/TALK"  , "narrator": "神楽", "text": "…ふふっ。"},
        { "location": "2459/TALK"  , "narrator": "神楽", "text": "では、皆さん。\n早速作業に取り掛かって\nくださいね。"},
        { "location": "2460/TALK"  , "narrator": "みやび", "text": "あいあい。"},
        { "location": "2461/TALK"  , "narrator": "つばめ", "text": "はーい！"},
        { "location": "2471/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2480/TALK"  , "narrator": "神楽", "text": "ぴょんこぴょんこ"},
        { "location": "2483/SEL"   , "narrator": "（選択肢）", "text": "ご機嫌？"},
        { "location": "2484/ACT"   , "narrator": "", "text": "ご機嫌？"},
        { "location": "2486/TALK"  , "narrator": "神楽", "text": "ぴょん♪"},
        { "location": "2488/TALK"  , "narrator": "神楽", "text": "今回はいろいろありがとぴょん！！"},
        { "location": "2489/TALK"  , "narrator": "神楽", "text": "カフェ計画も順調だし、みんなとも前よりぎこちなさが無くなった気がする"},
        { "location": "2490/TALK"  , "narrator": "神楽", "text": "なんていうか、むしろ前よりももっと近くにいられるようになったっていうか"},
        { "location": "2491/TALK"  , "narrator": "神楽", "text": "とにかく、一緒にいても全然辛くなくなったの"},
        { "location": "2493/SEL"   , "narrator": "（選択肢）", "text": "それはよかった"},
        { "location": "2494/ACT"   , "narrator": "", "text": "それはよかった"},
        { "location": "2496/TALK"  , "narrator": "神楽", "text": "うん"},
        { "location": "2497/TALK"  , "narrator": "神楽", "text": "多分それは"},
        { "location": "2500/TALK"  , "narrator": "神楽", "text": "$handle$のおかげでもあるから"},
        { "location": "2501/TALK"  , "narrator": "神楽", "text": "お礼を言いたくて"},
        { "location": "2503/SEL"   , "narrator": "（選択肢）", "text": "なにもしてないよ？"},
        { "location": "2504/ACT"   , "narrator": "", "text": "なにもしてないよ？"},
        { "location": "2506/TALK"  , "narrator": "神楽", "text": "ぴょんこの愚痴とか、色々聞いてくれたりアドバイスくれたりしたぴょん"},
        { "location": "2507/TALK"  , "narrator": "神楽", "text": "けど、ぴょんこは$handle$を傷つけるばかりだったよね"},
        { "location": "2508/TALK"  , "narrator": "神楽", "text": "ごめんね？"},
        { "location": "2509/TALK"  , "narrator": "神楽", "text": "ずっとイライラしてたからたまに歯止めがきかなくて"},
        { "location": "2510/TALK"  , "narrator": "神楽", "text": "どうして$handle$は、それでも逢いに来てくれるの？ぴょんこは酷いことばかりしてるのに"},
        { "location": "2512/SEL"   , "narrator": "（選択肢）", "text": "愛してるから"},
        { "location": "2513/SEL"   , "narrator": "（選択肢）", "text": "大切だから"},
        { "location": "2514/SEL"   , "narrator": "（選択肢）", "text": "続きが見たかっただけ"},
        { "location": "2515/ACT"   , "narrator": "", "text": "愛してるから"},
        { "location": "2516/TALK"  , "narrator": "神楽", "text": "そっか"},
        { "location": "2517/TALK"  , "narrator": "神楽", "text": "じゃあ"},
        { "location": "2518/TALK"  , "narrator": "神楽", "text": "(ﾟ∀ﾟ)人(ﾟ∀ﾟ)ｹｺｰﾝ"},
        { "location": "2520/ACT"   , "narrator": "", "text": "大切だから"},
        { "location": "2522/TALK"  , "narrator": "神楽", "text": "ぴょん"},
        { "location": "2523/TALK"  , "narrator": "神楽", "text": "ぴょんこは、それじゃやだ"},
        { "location": "2524/TALK"  , "narrator": "神楽", "text": "もっとちゃんと言って"},
        { "location": "2526/SEL"   , "narrator": "（選択肢）", "text": "ｽｷ"},
        { "location": "2527/SEL"   , "narrator": "（選択肢）", "text": "大事なパートナーだよ"},
        { "location": "2530/TALK"  , "narrator": "神楽", "text": "ぴょんぴょん♪"},
        { "location": "2533/ACT"   , "narrator": "", "text": "大事なパートナーだよ"},
        { "location": "2535/TALK"  , "narrator": "神楽", "text": "ありがとぴょん♪"},
        { "location": "2536/TALK"  , "narrator": "神楽", "text": "私にとっても$handle$は大事な人です"},
        { "location": "2538/ACT"   , "narrator": "", "text": "続きが見たかっただけ"},
        { "location": "2539/TALK"  , "narrator": "神楽", "text": "そっかー"},
        { "location": "2540/TALK"  , "narrator": "神楽", "text": "じゃ、一方通行"},
        { "location": "2541/TALK"  , "narrator": "神楽", "text": "なーんて♪ぴょんこはさすらいのぴょんこ。誰にも縛られないぴょん♪"},
        { "location": "2542/TALK"  , "narrator": "神楽", "text": "だからそれくらいの関係が一番付き合いやすいぴょん♪"},
        { "location": "2546/TALK"  , "narrator": "神楽", "text": "でもほんとに、ありがと"},
        { "location": "2547/TALK"  , "narrator": "神楽", "text": "いま、神楽は幸せです"},
        { "location": "2548/TALK"  , "narrator": "神楽", "text": "あとは、一生涯のパートナーができたら最高♪"},
        { "location": "2550/TALK"  , "narrator": "神楽", "text": "伝えたから"},
        { "location": "2551/TALK"  , "narrator": "神楽", "text": "ね？"},
        { "location": "2555/TALK"  , "narrator": "神楽", "text": "また$handle$にかまかまするー"},
        { "location": "2556/TALK"  , "narrator": "神楽", "text": "|д･)<いい？"},
        { "location": "2558/SEL"   , "narrator": "（選択肢）", "text": "もっとデレッデレに甘えてこい！"},
        { "location": "2559/SEL"   , "narrator": "（選択肢）", "text": "もちろん、いつでもいいよ"},
        { "location": "2560/ACT"   , "narrator": "", "text": "もっとデレッデレに甘えてこい！"},
        { "location": "2561/TALK"  , "narrator": "神楽", "text": "わかった"},
        { "location": "2562/TALK"  , "narrator": "神楽", "text": "ドロッドロに甘えるわ"},
        { "location": "2564/TALK"  , "narrator": "神楽", "text": "ドロドロだから立てないしずっとベッドでドロドロしてます♪"},
        { "location": "2565/TALK"  , "narrator": "神楽", "text": "ぴょんこの身のまわりの面倒な事全部やってね？"},
        { "location": "2566/TALK"  , "narrator": "神楽", "text": "ぴょんこはずっとベッドでスマホみてドロドロしてるぴょん"},
        { "location": "2567/TALK"  , "narrator": "神楽", "text": "楽しみ♪"},
        { "location": "2568/ACT"   , "narrator": "", "text": "もちろん、いつでもいいよ"},
        { "location": "2570/TALK"  , "narrator": "神楽", "text": "わーいわーい"},
        { "location": "2571/TALK"  , "narrator": "神楽", "text": "かまかまーかまかまー"},
        { "location": "2572/TALK"  , "narrator": "神楽", "text": "それじゃ、かまかましたいときは絶対に来てぴょん？"},
        { "location": "2573/TALK"  , "narrator": "神楽", "text": "待ってるぴょん♪"},
        { "location": "2575/TALK"  , "narrator": "神楽", "text": "ぴょんこはホントは$handle$と逢いたいんだぞ？"},
        { "location": "2577/TALK"  , "narrator": "神楽", "text": "いつかオフミしたいな、二人だけで♪"}
    ]
}
