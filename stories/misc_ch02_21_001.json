        { "location": "7/SCENARIO", "narrator": "", "text": "031_花の名前"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "タチアオイが咲いてたわ"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "夏だわね"},
        { "location": "37/SEL"    , "narrator": "", "text": "何それ？"},
        { "location": "38/SEL"    , "narrator": "", "text": "ヒマワリとかじゃないの？"},
        { "location": "39/SEL"    , "narrator": "", "text": "ああ、ホリホックね"},
        { "location": "40/ACT"    , "narrator": "", "text": "何それ？"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "花よ"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "ハイビスカスみたいな花"},
        { "location": "43/ACT"    , "narrator": "", "text": "ヒマワリとかじゃないの？"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "それも夏の華ね"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "花ね"},
        { "location": "46/ACT"    , "narrator": "", "text": "ああ、ホリホックね"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "彫りホック"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "ホリホック"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "そんな名前もあるのね"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "ひとつ賢くなったわ＼(^O^)／"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "タチアオイは開花時期が長いから"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "初夏からずっと咲いてる感じね"},
        { "location": "57/SEL"    , "narrator": "", "text": "飽きない？"},
        { "location": "58/SEL"    , "narrator": "", "text": "気にしたことなかったな"},
        { "location": "59/SEL"    , "narrator": "", "text": "$me$の心には永遠の花が咲く"},
        { "location": "60/ACT"    , "narrator": "", "text": "飽きない？"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "飽きないわよ（；￢＿￢）"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "いつ見ても鼻はいいものよ"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "花はね！！！！"},
        { "location": "64/ACT"    , "narrator": "", "text": "気にしたことなかったな"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "そういうものかしら"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "でもこれからは"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "気にしてみてね(^з^)-☆"},
        { "location": "68/ACT"    , "narrator": "", "text": "$me$の心には永遠の花が咲く"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "あら"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "随分気障ね"},
        { "location": "74/SEL"    , "narrator": "", "text": "花の名前はアーヤ"},
        { "location": "75/ACT"    , "narrator": "", "text": "花の名前はアーヤ"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "またそんなことばっかり"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "相変わらずね"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "飛んだ王子様だわ"}
