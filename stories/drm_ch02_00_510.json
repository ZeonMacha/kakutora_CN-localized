        { "location": "276/TALK"    , "narrator": "アーヤ", "text": "疲れちゃったわ"},
        { "location": "277/TALK"    , "narrator": "アーヤ", "text": "じゃあね"},
        { "location": "278/ACT"     , "narrator": "", "text": "バイク通学してるんだ？"},
        { "location": "280/TALK"    , "narrator": "アーヤ", "text": "えっと"},
        { "location": "283/SEL"     , "narrator": "", "text": "かっこいい"},
