        { "location": "285/SEL"     , "narrator": "", "text": "そうなんだ"},
        { "location": "286/ACT"     , "narrator": "", "text": "かっこいい"},
        { "location": "287/TALK"    , "narrator": "アーヤ", "text": "そう？"},
        { "location": "288/ACT"     , "narrator": "", "text": "知らなかった"},
        { "location": "289/TALK"    , "narrator": "アーヤ", "text": "言ってなかったものね"},
        { "location": "290/ACT"     , "narrator": "", "text": "そうなんだ"},
        { "location": "291/TALK"    , "narrator": "アーヤ", "text": "そうなの"},
        { "location": "293/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "294/TALK"    , "narrator": "アーヤ", "text": "いつもじゃないのよ"},
        { "location": "295/TALK"    , "narrator": "アーヤ", "text": "急いでる時とか"},
        { "location": "296/TALK"    , "narrator": "アーヤ", "text": "荷物が多い時とかくらいよ？"},
        { "location": "298/SEL"     , "narrator": "", "text": "事故には気を付けて"},
        { "location": "299/SEL"     , "narrator": "", "text": "意外だな"},
        { "location": "300/ACT"     , "narrator": "", "text": "事故には気を付けて"},
        { "location": "310/TALK"    , "narrator": "アーヤ", "text": "そうね"},
