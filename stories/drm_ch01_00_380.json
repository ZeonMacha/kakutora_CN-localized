    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "東京を一時離れて"},
        { "location": "20/TALK"   , "narrator": "アーヤ", "text": "はぁ…いいわねぇ…。"},
        { "location": "21/TALK"   , "narrator": "アーヤ", "text": "こうやって砂浜で、\n何もせずゆったりと\n過ごすのも…。"},
        { "location": "22/TALK"   , "narrator": "神楽", "text": "他に人がいない、って\nいうのも素敵ですね。"},
        { "location": "23/TALK"   , "narrator": "神楽", "text": "この時期の海といえば、\nどこに行っても人で\n溢れかえってますし。"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "正直、あんまり期待して\nなかったけど――"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "他の人を気にしないで\nおもいっきり遊べるし――"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "のんびりもできるから、\n来て良かったわ。"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "そうだね…。"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "ねえ、ガブちゃん。\n少し休んだら、沖の方まで\n泳いでみない？"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "あ、あんた、元気ね…。"},
        { "location": "36/TALK"   , "narrator": "神楽", "text": "ビーチバレーやった\nばかりなのに、\n疲れてないんですか？"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "えへへ…楽しいからかな？\nあまり疲れてる感じが\nしないんだ。"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "何にせよ、もう少し\n休んでからがいいわね。"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "つばめは良くても、\nギャヴィも卯月も\n疲れてるみたいだし。"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "三十分くらい昼寝するわ。\n朝の特訓もあったから、\nさすがに疲れたし。"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "じゃあ、起きたら\n泳ぎに行こうね。"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "一人で行ってもらえると\n嬉しいんだけど？"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "でも、ガブちゃんと\n一緒の方が楽しそう\nだし…。"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "だめ？"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "…ま、まあ、休んだ後なら\n考えてあげなくもないわ。"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "やった！"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "なんだかんだ言っても、\nガブちゃんは優しい\n女の子ですね！"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "う、うるさい！\n寝るんだから、ちょっと\n静かにしてて！"},
        { "location": "60/TALK"   , "narrator": "神楽", "text": "…つばめさんも、\nガブちゃんが起きるまでは\n休んだ方が良いですよ。"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "沖まで泳いだところで\n疲れちゃったら、\n大変ですし。"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "うん、そうするよ。"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "まったりぃ(*´ω｀)"},
        { "location": "81/SEL"    , "narrator": "", "text": "また相談？"},
        { "location": "82/SEL"    , "narrator": "", "text": "エマージェンシーコール？"},
        { "location": "83/SEL"    , "narrator": "", "text": "何用？"},
        { "location": "84/ACT"    , "narrator": "", "text": "また相談？"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "違ぅよ(´・ω・`) "},
        { "location": "86/TALK"   , "narrator": "つばめ", "text": "凄く楽しぃから"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "$handle$さんとぉ話したくなったの"},
        { "location": "89/ACT"    , "narrator": "", "text": "エマージェンシーコール？"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "えぇっ！？(ﾟ△ﾟ;ﾉ)ﾉ"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "違ぅよ(´・ω・`) "},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "もしかして何か大変なことがぁったの？"},
        { "location": "95/SEL"    , "narrator": "", "text": "何もないよ"},
        { "location": "96/ACT"    , "narrator": "", "text": "何もないよ"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "よかった(o´Д`)=з"},
        { "location": "99/TALK"   , "narrator": "つばめ", "text": "そっちが大変なのかと思ったよ"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "こっちは凄く楽しぃよ(*´︶`*)"},
        { "location": "102/ACT"   , "narrator": "", "text": "何用？"},
        { "location": "103/TALK"  , "narrator": "つばめ", "text": "ぅぅん"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "特に用事はなぃの(●´ω｀●)ゞ"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "ただ"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "$handle$さんとお話したくなって(´ω｀*)"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "それで声掛けたの(´∀｀*)ｳﾌﾌ"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "今はまったりタィムだけど"},
        { "location": "111/TALK"  , "narrator": "つばめ", "text": "ガブちゃんが起きたら"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "沖まで泳ごぅって約束してるんだ"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "凄く楽しみ(*≧∀≦*) "},
        { "location": "116/SEL"   , "narrator": "", "text": "はしゃいでるみたいだね"},
        { "location": "117/ACT"   , "narrator": "", "text": "はしゃいでるみたいだね"},
        { "location": "119/TALK"  , "narrator": "つばめ", "text": "友達と海で遊ぶのって初めてだから"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "凄く楽しくてｖ(*´∀｀*)ｖ"},
        { "location": "122/SEL"   , "narrator": "", "text": "いっぱい楽しんでね"},
        { "location": "123/ACT"   , "narrator": "", "text": "いっぱい楽しんでね"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "そぅするよ(*´ω｀*)"},
        { "location": "139/TALK"  , "narrator": "つばめ", "text": "…ガブちゃん、\n早く起きないかなぁ？"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "…いや、まだ三分も\n経ってないし、\n寝つけてもないから…。"},
        { "location": "18/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月某日　 3:16 PM</color>\n合宿中、みやびの実家近くの砂浜にて"}
    ]
}
