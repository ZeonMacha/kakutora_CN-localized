        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "苦いけど"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "そこがいいのよ"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "$handle$さんは"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "お酒イケる口だっけ？"},
        { "location": "54/SEL"    , "narrator": "", "text": "普通だよ"},
        { "location": "55/SEL"    , "narrator": "", "text": "まだ飲めないから"},
        { "location": "56/SEL"    , "narrator": "", "text": "苦手かな"},
