        { "location": "37/SEL"    , "narrator": "", "text": "未成年なので"},
        { "location": "38/SEL"    , "narrator": "", "text": "だよね"},
        { "location": "39/SEL"    , "narrator": "", "text": "ビールって苦くない？"},
        { "location": "40/ACT"    , "narrator": "", "text": "未成年なので"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "ごめんごめん"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "家庭の話にして"},
