        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "無理強いはよくないものね"},
        { "location": "68/ACT"    , "narrator": "", "text": "アーヤが一番いけてる"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "そういうことは聞いてないわ"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "そのくらいは知ってる"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "なんなのかしら"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "お酒って"},
        { "location": "86/SEL"    , "narrator": "", "text": "百薬の長"},
        { "location": "87/SEL"    , "narrator": "", "text": "炭化水素の水素原子をヒドロキシ基で置き換えたもの"},
        { "location": "88/SEL"    , "narrator": "", "text": "アーヤが好きな飲み物"},
        { "location": "89/ACT"    , "narrator": "", "text": "百薬の長"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "古い言い方するのね"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "正解だけど"},
        { "location": "93/ACT"    , "narrator": "", "text": "炭化水素の水素原子をヒドロキシ基で置き換えたもの"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "え"},
