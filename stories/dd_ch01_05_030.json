{
    "dir": "chap05/daydra/dd_ch01_05_030.js",
    "type": "MainStory",
    "info": {
        "story_id": "5157",
        "cid": "tsubame",
        "title": "Extra007 プレミアムストーリー",
        "sub_title": "次の映画は？"
    },
    "entry":
    [
        { "location": "552/SCENARIO", "narrator": "", "text": "次の映画は？"},
        { "location": "567/TALK"    , "narrator": "真幌", "text": "そういえば、\n逢瀬はどんな映画が\n好きなんだ？"},
        { "location": "569/TALK"    , "narrator": "つばめ", "text": "え？"},
        { "location": "570/TALK"    , "narrator": "真幌", "text": "いや、おまえがどんな\n作品が好きなのか――"},
        { "location": "571/TALK"    , "narrator": "真幌", "text": "まだ聞いていなかった\nのを思い出してな。"},
        { "location": "572/TALK"    , "narrator": "つばめ", "text": "は、はあ…。\nでも、どうして\nですか？"},
        { "location": "573/TALK"    , "narrator": "真幌", "text": "…このことも説明して\nおかなければならな\nかったな。"},
        { "location": "574/TALK"    , "narrator": "真幌", "text": "うちの劇場は\nトライナリーの本部\nであると同時に――"},
        { "location": "575/TALK"    , "narrator": "真幌", "text": "カモフラージュに、\n映画館もやって\nいるんだ。"},
        { "location": "576/TALK"    , "narrator": "つばめ", "text": "なるほど…。"},
        { "location": "577/TALK"    , "narrator": "真幌", "text": "…まあ、正直に言うと\nだな――"},
        { "location": "578/TALK"    , "narrator": "真幌", "text": "次の映画を何にするか\n決まっていないんだ。"},
        { "location": "579/TALK"    , "narrator": "真幌", "text": "だから、参考に逢瀬の\n好みを教えてほしい。"},
        { "location": "580/TALK"    , "narrator": "真幌", "text": "ちなみに、\n今上映しているのは\n怪獣映画だ。"},
        { "location": "584/TALK"    , "narrator": "つばめ", "text": "…でも、わたしって面白い\n映画は何でも好きって\n思うタイプだから――"},
        { "location": "586/TALK"    , "narrator": "つばめ", "text": "どの映画がいいか、って\n聞かれても、ちょっと…。"},
        { "location": "587/TALK"    , "narrator": "真幌", "text": "難しく考える必要はない。\nどうせ何を流そうとも\n客なんか来ないからな。"},
        { "location": "588/TALK"    , "narrator": "真幌", "text": "頭に浮かんだジャンルを\n一つ言ってもらえれば、\nそれで構わん。"},
        { "location": "591/TALK"    , "narrator": "つばめ", "text": "う～ん…\nジャンルですかぁ…。"},
        { "location": "593/TALK"    , "narrator": "つばめ", "text": "本当にそういうの気にして\n見ないから、まったく\n思いつかないよ…。"},
        { "location": "594/TALK"    , "narrator": "つばめ", "text": "…相談してみようかな？"},
        { "location": "597/TALK"    , "narrator": "つばめ", "text": "ちょ、ちょっとだけ\n待ってください。\nえっと…。"},
        { "location": "611/TALK"    , "narrator": "つばめ", "text": "真幌さんに、今度映画館で流す映画を決めろって言われてるの"},
        { "location": "612/TALK"    , "narrator": "つばめ", "text": "なんて答えれば\nいいのかな？"},
        { "location": "613/TALK"    , "narrator": "つばめ", "text": "わたしじゃわからないの、手伝って！"},
        { "location": "615/SEL"     , "narrator": "", "text": "ミステリーは？"},
        { "location": "616/SEL"     , "narrator": "", "text": "怪獣映画は？"},
        { "location": "617/SEL"     , "narrator": "", "text": "ラブロマンスがいい"},
        { "location": "618/ACT"     , "narrator": "", "text": "ミステリーは？"},
        { "location": "619/TALK"    , "narrator": "つばめ", "text": "ミステリーって、推理モノだよね？"},
        { "location": "620/TALK"    , "narrator": "つばめ", "text": "わかったよ、ありがと！"},
        { "location": "632/TALK"    , "narrator": "つばめ", "text": "それじゃあ、ミステリー\n映画とかはどうですか？"},
        { "location": "633/TALK"    , "narrator": "真幌", "text": "おっ、いいぞ逢瀬！\n素晴らしいじゃないか！"},
        { "location": "634/TALK"    , "narrator": "つばめ", "text": "本当ですか！？"},
        { "location": "635/TALK"    , "narrator": "真幌", "text": "ああ、最高だ！"},
        { "location": "636/TALK"    , "narrator": "真幌", "text": "次の映画を何にするか\n必死で悩んでいた私と\n同じように――"},
        { "location": "637/TALK"    , "narrator": "真幌", "text": "見に来た観客にも、\n犯人が誰なのか悩んで\nもらうとしよう。"},
        { "location": "639/TALK"    , "narrator": "つばめ", "text": "そ、そうですか…。\nお客さん、来てくれると\nいいですね。"},
        { "location": "640/TALK"    , "narrator": "真幌", "text": "大勢来られては困るが…\nまあ、十人くらいは\n来てもらいたいな。"},
        { "location": "641/ACT"     , "narrator": "", "text": "怪獣映画は？"},
        { "location": "642/TALK"    , "narrator": "つばめ", "text": "怪獣映画も良さそうだね"},
        { "location": "643/TALK"    , "narrator": "つばめ", "text": "そう言ってみるよ、ありがと"},
        { "location": "655/TALK"    , "narrator": "つばめ", "text": "あの、怪獣映画が\nいいと思います！"},
        { "location": "656/TALK"    , "narrator": "真幌", "text": "怪獣映画って…\n本気か？"},
        { "location": "658/TALK"    , "narrator": "つばめ", "text": "はい！"},
        { "location": "660/TALK"    , "narrator": "真幌", "text": "……そうか。"},
        { "location": "662/TALK"    , "narrator": "真幌", "text": "正直、連続で\n怪獣映画はどうかと\n思ったんだが…。"},
        { "location": "664/TALK"    , "narrator": "つばめ", "text": "あっ、そういえば今も\n怪獣映画やってるの\n忘れてた！"},
        { "location": "666/TALK"    , "narrator": "真幌", "text": "まあ、何も思い\n浮かばんのだから、\n仕方ないな。"},
        { "location": "668/TALK"    , "narrator": "つばめ", "text": "…怪獣映画以外で、\nって聞けば\nよかったなぁ。"},
        { "location": "669/ACT"     , "narrator": "", "text": "ラブロマンスがいい"},
        { "location": "680/TALK"    , "narrator": "つばめ", "text": "ラブロマンスってことは、恋愛映画のことかな？"},
        { "location": "681/TALK"    , "narrator": "つばめ", "text": "じゃあ、そう言っておくね"},
        { "location": "693/TALK"    , "narrator": "つばめ", "text": "あの、\nラブロマンス…って\nいうのはどうですか？"},
        { "location": "694/TALK"    , "narrator": "真幌", "text": "…なんだと？"},
        { "location": "696/TALK"    , "narrator": "つばめ", "text": "ラブロマンスです。"},
        { "location": "697/TALK"    , "narrator": "真幌", "text": "…驚いた。まさか\n逢瀬の口からそんな\n単語が出てくるとは。"},
        { "location": "698/TALK"    , "narrator": "真幌", "text": "まあいい、それにしよう。"},
        { "location": "699/TALK"    , "narrator": "真幌", "text": "次はラブロマンス。\nそれも、少し大人の\n恋愛映画に決まりだ！"},
        { "location": "700/TALK"    , "narrator": "つばめ", "text": "ほっ…\n力になれたみたいで\nよかったです。"},
        { "location": "702/TALK"    , "narrator": "真幌", "text": "ああ…だがな、逢瀬。"},
        { "location": "704/TALK"    , "narrator": "真幌", "text": "おまえとギャヴィは、\n絶対にその映画を\n見るんじゃないぞ。"},
        { "location": "705/TALK"    , "narrator": "つばめ", "text": "え、なんでですか？"},
        { "location": "706/TALK"    , "narrator": "真幌", "text": "おまえ達には、\nまだ早いからだ。"},
        { "location": "707/TALK"    , "narrator": "つばめ", "text": "少し大人向けの映画\nだからですか？"},
        { "location": "708/TALK"    , "narrator": "真幌", "text": "ハッキリ言えば、\n濃厚なラブシーンが\nある映画だ。"},
        { "location": "709/TALK"    , "narrator": "つばめ", "text": "えっと…普通のよりも\n凄いってことですか？"},
        { "location": "710/TALK"    , "narrator": "真幌", "text": "そういうことだが…\nまさかどういうことか\nわかっていないのか？"},
        { "location": "712/TALK"    , "narrator": "つばめ", "text": "う～ん…\n多分そうだと思います。"},
        { "location": "714/TALK"    , "narrator": "つばめ", "text": "わたし、恋愛映画って、\nあんまり見たことも\nないし…。"},
        { "location": "715/TALK"    , "narrator": "真幌", "text": "…ふふっ、そうだったか。"},
        { "location": "716/TALK"    , "narrator": "真幌", "text": "ならば特別授業として、\n私が濃厚なラブシーンが\nどういうものかを――"},
        { "location": "717/TALK"    , "narrator": "真幌", "text": "しっかり、わかり\nやすく、丁寧に教育\nしてやるとしよう！"},
        { "location": "719/TALK"    , "narrator": "つばめ", "text": "えっ？　でも私には\nまだ早過ぎるんじゃ…。"},
        { "location": "721/TALK"    , "narrator": "真幌", "text": "この映画は早すぎるが、\n逢瀬は少し初心過ぎる\n気がするのでな。"},
        { "location": "723/TALK"    , "narrator": "真幌", "text": "教師としてしっかりと、\nわかりやすく説明して\nやろう。"},
        { "location": "725/TALK"    , "narrator": "つばめ", "text": "な、なんでこんなに\n楽しそうなんだろう？"},
        { "location": "726/TALK"    , "narrator": "つばめ", "text": "興味はあるけど、\nちょっと怖いから\n断ろう…。"},
        { "location": "729/TALK"    , "narrator": "つばめ", "text": "い、いえ、結構です！\nちょっと怖い気も\nするし、遠慮します！"},
        { "location": "730/TALK"    , "narrator": "真幌", "text": "なんだ、つまらん。\n知らな過ぎも問題だぞ？"},
        { "location": "732/TALK"    , "narrator": "つばめ", "text": "でも、\n真幌さんに聞くのは\nちょっと怖いし…。"},
        { "location": "733/TALK"    , "narrator": "つばめ", "text": "あとで、\n$handle$さんに\n聞いてみようかな？"},
        { "location": "558/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月8日　3:45 PM</color>\nＧＷ最終日、東京の学校に転校する前日のこと。"},
        { "location": "676/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "744/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch01", "text": "【こどもはねるじかん】"}
    ]
}
