        { "location": "7/SCENARIO", "narrator": "", "text": "002_いつかモフれる日が来たら"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "猫"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "買いたかったわ"},
        { "location": "36/SEL"    , "narrator": "", "text": "ご予算は？"},
        { "location": "37/SEL"    , "narrator": "", "text": "どこで売ってるの？"},
        { "location": "38/SEL"    , "narrator": "", "text": "飼えればよかったのにね"},
        { "location": "39/ACT"    , "narrator": "", "text": "ご予算は？"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "え？"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "って"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "買いたかったの"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "ちが"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "飼いたかったの！"},
        { "location": "46/ACT"    , "narrator": "", "text": "どこで売ってるの？"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "売ってるけど"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "買わないし(--#)"},
        { "location": "49/ACT"    , "narrator": "", "text": "飼えればよかったのにね"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "難しいのはわかってるけど"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "ここの子にしたかったわ"},
        { "location": "68/SEL"    , "narrator": "", "text": "猫好きだったんだ？"},
        { "location": "69/SEL"    , "narrator": "", "text": "ワガママな一面を見れた"},
        { "location": "70/SEL"    , "narrator": "", "text": "夜、一匹になっちゃうよ？"},
        { "location": "71/ACT"    , "narrator": "", "text": "猫好きだったんだ？"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "好き"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "猫だけじゃなくて"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "動物は全部大好き"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "色々飼ってみたいけど"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "今はやっぱり難しいわね(｡-_-｡)"},
        { "location": "79/ACT"    , "narrator": "", "text": "ワガママな一面を見れた"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "もう"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "そんなこと言わないで！"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "この年でわがままとか"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "恥ずかしいから！"},
        { "location": "86/ACT"    , "narrator": "", "text": "夜、一匹になっちゃうよ？"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "そっか"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "だったらかわいそうかも"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "館長も頼りにならなさそうだし"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "ちょうどよかったのかもね"},
        { "location": "55/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
