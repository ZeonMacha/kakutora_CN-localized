    "entry":
    [
        { "location": "6805/SCENARIO", "narrator": "", "text": "悪食なのは昔から"},
        { "location": "6832/TALK"    , "narrator": "神楽", "text": "鹿肉美味しいのになー"},
        { "location": "6834/SEL"     , "narrator": "", "text": "食べたことない"},
        { "location": "6835/SEL"     , "narrator": "", "text": "ウマいよねシカだけど"},
        { "location": "6836/SEL"     , "narrator": "", "text": "今後は注目する"},
        { "location": "6837/ACT"     , "narrator": "", "text": "食べたことない"},
        { "location": "6838/TALK"    , "narrator": "神楽", "text": "そっか残念"},
        { "location": "6839/ACT"     , "narrator": "", "text": "ウマいよねシカだけど"},
        { "location": "6841/TALK"    , "narrator": "神楽", "text": "だれうまｗｗｗｗ"},
        { "location": "6843/TALK"    , "narrator": "神楽", "text": "うまいんだよシカだけど！"},
        { "location": "6844/TALK"    , "narrator": "神楽", "text": "馬いよねー鹿だけど！"},
        { "location": "6845/ACT"     , "narrator": "", "text": "今後は注目する"},
        { "location": "6846/TALK"    , "narrator": "神楽", "text": "そうして"},
        { "location": "6848/TALK"    , "narrator": "神楽", "text": "なんかつばめさん食べたことないんだって"},
        { "location": "6849/TALK"    , "narrator": "神楽", "text": "頭の中イチゴしか詰まってないのかな？"},
        { "location": "6851/SEL"     , "narrator": "", "text": "ホントは好きなくせに"},
        { "location": "6852/SEL"     , "narrator": "", "text": "$me$は神楽で頭がいっぱい"},
        { "location": "6853/SEL"     , "narrator": "", "text": "$me$もイチゴの方が好きかな…"},
        { "location": "6854/ACT"     , "narrator": "", "text": "ホントは好きなくせに"},
        { "location": "6855/TALK"    , "narrator": "神楽", "text": "当たり前ぴょん"},
        { "location": "6856/TALK"    , "narrator": "神楽", "text": "馬鹿な子ほどかわいい！！！！！"},
        { "location": "6857/ACT"     , "narrator": "", "text": "$me$は神楽で頭がいっぱい"},
        { "location": "6859/TALK"    , "narrator": "神楽", "text": "よしよし"},
        { "location": "6860/TALK"    , "narrator": "神楽", "text": "それでこそ$handlek$ぴょん"},
        { "location": "6861/TALK"    , "narrator": "神楽", "text": "いつもそうじゃなきゃ困るぴょん"},
        { "location": "6862/TALK"    , "narrator": "神楽", "text": "でもちょっとキモイかなー？"},
        { "location": "6863/TALK"    , "narrator": "神楽", "text": "なんてウソウソ♪"},
        { "location": "6865/TALK"    , "narrator": "神楽", "text": "うれしいぴょん♪"},
        { "location": "6866/ACT"     , "narrator": "", "text": "$me$もイチゴの方が好きかな…"},
        { "location": "6867/TALK"    , "narrator": "神楽", "text": "スイーツ系だったぴょん？？"},
        { "location": "6868/TALK"    , "narrator": "神楽", "text": "いやフルーツ系？？？"},
        { "location": "6869/TALK"    , "narrator": "神楽", "text": "そういや果物って水菓子って言うしね"},
        { "location": "6870/TALK"    , "narrator": "神楽", "text": "てことはスイーツ系でいっか"}
    ]
