        "title": "【EXストーリー】スーパーメナー",
        "sub_title": "コネクトストーリー"
    },
    "entry":
    [
        { "location": "339/SCENARIO", "narrator": "", "text": "【導入】モーフィアス（ブー太郎）"},
        { "location": "345/DIALOG"  , "narrator": "", "text": "<size=40>CURAN STORY. 01</size>\nKAGURA UZUKI\n\n<size=45>モーフィアス</size>\n<size=35>～エアプだけはありえない～</size>"},
        { "location": "361/TALK"    , "narrator": "神楽", "text": "お帰りなさい、\n$handle$さま。"},
        { "location": "362/TALK"    , "narrator": "神楽", "text": "ここは、私たち\nトライナリーと、\nクランたちとの交差点。"},
        { "location": "363/TALK"    , "narrator": "神楽", "text": "ココロとココロが\n出逢い、共鳴し、\nそして繋がりあう場所。"},
        { "location": "371/SEL"     , "narrator": "（選択肢）", "text": "概要説明を飛ばす"},
        { "location": "372/SEL"     , "narrator": "（選択肢）", "text": "もう一度聞く"},
        { "location": "373/ACT"     , "narrator": "", "text": "概要説明を飛ばす"},
        { "location": "374/TALK"    , "narrator": "神楽", "text": "というわけで、\n早速今回のクランを\n紹介しますね。"},
        { "location": "376/ACT"     , "narrator": "", "text": "もう一度聞く"},
        { "location": "381/TALK"    , "narrator": "神楽", "text": "ここでは、普段私たちを\n助けてくれるサーバント\nクランを紹介いたします。"},
        { "location": "382/TALK"    , "narrator": "神楽", "text": "そして、貴方が直接\n彼らと繋がれるよう、\n手続きをいたします。"},
        { "location": "383/SEL"     , "narrator": "（選択肢）", "text": "ちょっと待って"},
        { "location": "384/ACT"     , "narrator": "", "text": "ちょっと待って"},
        { "location": "386/TALK"    , "narrator": "神楽", "text": "どうか\nなさいましたか。"},
        { "location": "387/SEL"     , "narrator": "（選択肢）", "text": "お帰りなさいって？"},
        { "location": "388/SEL"     , "narrator": "（選択肢）", "text": "来たことないんだけど、ここ"},
        { "location": "389/SEL"     , "narrator": "（選択肢）", "text": "どういう設定なの？"},
        { "location": "390/ACT"     , "narrator": "", "text": "お帰りなさいって？"},
        { "location": "391/TALK"    , "narrator": "神楽", "text": "挨拶ですが、\nどうかなさいましたか？"},
        { "location": "392/ACT"     , "narrator": "", "text": "来たことないんだけど、ここ"},
        { "location": "393/TALK"    , "narrator": "神楽", "text": "まさか\n憶えてらっしゃらない？"},
        { "location": "394/ACT"     , "narrator": "", "text": "どういう設定なの？"},
        { "location": "395/TALK"    , "narrator": "神楽", "text": "設定とは\n不思議なことを\nおっしゃいますね。"},
        { "location": "397/TALK"    , "narrator": "神楽", "text": "ここで私が\n$handle$さまに\n伝えたいことは。"},
        { "location": "398/TALK"    , "narrator": "神楽", "text": "クランとの【儀式】\nによって、貴方とココロを\n繋げられるということ。"},
        { "location": "399/TALK"    , "narrator": "神楽", "text": "ここまでは\nご理解いただけ\nましたか？"},
        { "location": "400/SEL"     , "narrator": "（選択肢）", "text": "それはわかったけど"},
        { "location": "401/SEL"     , "narrator": "（選択肢）", "text": "いや、そうじゃなくて"},
        { "location": "402/SEL"     , "narrator": "（選択肢）", "text": "もういいやそれで"},
        { "location": "403/ACT"     , "narrator": "", "text": "それはわかったけど"},
        { "location": "404/TALK"    , "narrator": "神楽", "text": "ならば何も\n問題はございませんね。"},
        { "location": "405/ACT"     , "narrator": "", "text": "いや、そうじゃなくて"},
        { "location": "406/TALK"    , "narrator": "神楽", "text": "何が違うのか\nわかりかねます。"},
        { "location": "407/ACT"     , "narrator": "", "text": "もういいやそれで"},
        { "location": "408/TALK"    , "narrator": "神楽", "text": "ご理解いただき\n感謝いたします。"},
        { "location": "411/TALK"    , "narrator": "神楽", "text": "ではお話を\n続けるとしましょう。"},
        { "location": "412/TALK"    , "narrator": "神楽", "text": "【儀式】には『コネクト』\nと『シンクロ』の２つが\nございます。"},
        { "location": "413/TALK"    , "narrator": "神楽", "text": "『コネクト』は、貴方と\nクランが物理的に繋がる\nための儀式となります。"},
        { "location": "414/TALK"    , "narrator": "神楽", "text": "バトルをして彼と貴方の\n中にある抵抗勢力を\n無力できれば完了です。"},
        { "location": "415/TALK"    , "narrator": "神楽", "text": "次の『シンクロ』では、\nクランの過去を知り、\n共感していただきます。"},
        { "location": "416/TALK"    , "narrator": "神楽", "text": "クランの過去の\n物語をシェアすることで\n心を通わせるものです。"},
        { "location": "418/TALK"    , "narrator": "神楽", "text": "ここまで、\nご理解いただけ\nましたでしょうか？"},
        { "location": "419/TALK"    , "narrator": "神楽", "text": "もし、入るセクターを\n間違えたという場合\n退場も可能ですが。"},
        { "location": "420/SEL"     , "narrator": "（選択肢）", "text": "大丈夫、次に行って"},
        { "location": "421/SEL"     , "narrator": "（選択肢）", "text": "あ、退場する"},
        { "location": "422/SEL"     , "narrator": "（選択肢）", "text": "えーと、メイドなの？"},
        { "location": "423/ACT"     , "narrator": "", "text": "大丈夫、次に行って"},
        { "location": "424/TALK"    , "narrator": "神楽", "text": "承知いたしました。\nそれでは早速、今回の\nクランを紹介いたします。"},
        { "location": "425/ACT"     , "narrator": "", "text": "あ、退場する"},
        { "location": "426/TALK"    , "narrator": "神楽", "text": "残念ですがここで\nお別れですね。"},
        { "location": "428/TALK"    , "narrator": "神楽", "text": "お戻りになる日を\n心待ちに\nしております。"},
        { "location": "429/TALK"    , "narrator": "神楽", "text": "$handle$さまと\n私に、\n素敵なココロの旅を。"},
        { "location": "431/ACT"     , "narrator": "", "text": "えーと、メイドなの？"},
        { "location": "432/TALK"    , "narrator": "神楽", "text": "え？"},
        { "location": "434/TALK"    , "narrator": "神楽", "text": "改めて聞かれると\n困ってしまいますね。"},
        { "location": "435/TALK"    , "narrator": "神楽", "text": "お好きに解釈\nしていただいて\n構いません。"},
        { "location": "436/TALK"    , "narrator": "神楽", "text": "それでは今回の\nクランを紹介\nいたしますね。"},
        { "location": "445/TALK"    , "narrator": "神楽", "text": "オープンプロセス、\n0xC4E番地から\n0xFFF番地へ。"},
        { "location": "446/TALK"    , "narrator": "神楽", "text": "共通意識野を経由、\n外部スフィアへ接続。"},
        { "location": "447/TALK"    , "narrator": "神楽", "text": "EXEC_SEEK_SECTOR\n=>Link() EXT_SPHERE/."},
        { "location": "472/TALK"    , "narrator": "神楽", "text": "シーク完了\nいたしました。"},
        { "location": "473/TALK"    , "narrator": "神楽", "text": "さて――。"},
        { "location": "475/TALK"    , "narrator": "神楽", "text": "今回、貴方に\n紹介するクランは\n<color=red>【モーフィアス】</color>。"},
        { "location": "477/TALK"    , "narrator": "神楽", "text": "発症者は朝倉祥太郎\n２６歳。\n江東区豊洲にて発症。"},
        { "location": "478/TALK"    , "narrator": "神楽", "text": "ココロファイルナンバー\nE05-010-19によれば、\n今回の発症の原因は……"},
        { "location": "479/TALK"    , "narrator": "神楽", "text": "スマホゲーム\n上位ランカーからの\n没落。"},
        { "location": "480/TALK"    , "narrator": "神楽", "text": "バカみたいですね。"},
        { "location": "483/TALK"    , "narrator": "神楽", "text": "でもそれまでの\n課金額は一千万を超えて\nいたそうですから。"},
        { "location": "484/TALK"    , "narrator": "神楽", "text": "発症してしまったのも\nいたしかたないと\n言えるでしょう。"},
        { "location": "485/SEL"     , "narrator": "（選択肢）", "text": "えー……"},
        { "location": "486/SEL"     , "narrator": "（選択肢）", "text": "何で神楽が仕切ってるの？"},
        { "location": "487/ACT"     , "narrator": "", "text": "えー……"},
        { "location": "488/TALK"    , "narrator": "神楽", "text": "$handle$さまの\n反応はもっともかと。"},
        { "location": "489/ACT"     , "narrator": "", "text": "何で神楽が仕切ってるの？"},
        { "location": "490/TALK"    , "narrator": "神楽", "text": "罪をあがなって\nいただくためです。"},
        { "location": "491/TALK"    , "narrator": "神楽", "text": "随分と酷いことを\nされてしまい\nましたから。"},
        { "location": "492/TALK"    , "narrator": "神楽", "text": "このゴミには。"},
        { "location": "493/SEL"     , "narrator": "（選択肢）", "text": "えっ！？"},
        { "location": "494/ACT"     , "narrator": "", "text": "えっ！？"},
        { "location": "496/TALK"    , "narrator": "神楽", "text": "どうか\nなさいましたか？"},
        { "location": "497/SEL"     , "narrator": "（選択肢）", "text": "…いやなんでもない"},
        { "location": "498/SEL"     , "narrator": "（選択肢）", "text": "話を続けて？"},
        { "location": "499/SEL"     , "narrator": "（選択肢）", "text": "気のせいだよねきっと"},
        { "location": "500/ACT"     , "narrator": "", "text": "…いやなんでもない"},
        { "location": "501/TALK"    , "narrator": "神楽", "text": "ならよいのですけれど。"},
        { "location": "502/ACT"     , "narrator": "", "text": "話を続けて？"},
        { "location": "503/TALK"    , "narrator": "神楽", "text": "承知いたしました。"},
        { "location": "504/ACT"     , "narrator": "", "text": "気のせいだよねきっと"},
        { "location": "505/TALK"    , "narrator": "神楽", "text": "何のことでしょうか？"},
        { "location": "508/TALK"    , "narrator": "神楽", "text": "このセクタでは、クランと\n一番相性がいい\nトライナリーが参ります。"},
        { "location": "509/TALK"    , "narrator": "神楽", "text": "つまり他のクランは\n他のメンバーが\n語るということですね。"},
        { "location": "510/TALK"    , "narrator": "神楽", "text": "それでは精神共有と\n参りましょうか。"},
        { "location": "511/SEL"     , "narrator": "（選択肢）", "text": "どうやるの？"},
        { "location": "512/ACT"     , "narrator": "", "text": "どうやるの？"},
        { "location": "514/TALK"    , "narrator": "神楽", "text": "おさらいしましょうか。\nまずは『コネクト』の\nプロセスを行います。"},
        { "location": "515/TALK"    , "narrator": "神楽", "text": "具体的には、\n彼の抵抗する意志と\n戦うのです。"},
        { "location": "516/TALK"    , "narrator": "神楽", "text": "それが終われば、\n彼は貴方に色々\n教えてくれるでしょう。"},
        { "location": "517/TALK"    , "narrator": "神楽", "text": "$handle$さまが\nそれを共有すれば、\n『シンクロ』完了です。"},
        { "location": "518/TALK"    , "narrator": "神楽", "text": "『コネクト』『シンクロ』\n両方完了することで、\n貴方と彼は繋がれます。"},
        { "location": "519/SEL"     , "narrator": "（選択肢）", "text": "それでおしまい？"},
        { "location": "520/ACT"     , "narrator": "", "text": "それでおしまい？"},
        { "location": "522/TALK"    , "narrator": "神楽", "text": "ここからが\n始まりですよ！"},
        { "location": "523/TALK"    , "narrator": "神楽", "text": "$handle$さまは\nモーフィアスを使える\nようになるんです！"},
        { "location": "524/TALK"    , "narrator": "神楽", "text": "ですから、『シンクロ』\nまで完了できるように\n頑張ってください！"},
        { "location": "525/TALK"    , "narrator": "神楽", "text": "あ。"},
        { "location": "526/TALK"    , "narrator": "神楽", "text": "$handle$さまには\n頑張っていただきたく\n思っております。"},
        { "location": "527/TALK"    , "narrator": "神楽", "text": "それでは。\nモーフィアスの世界に\nアクセスいたします。"},
        { "location": "529/TALK"    , "narrator": "神楽", "text": "$handle$さまと\n私とモーフィアスに、\n素敵なココロの旅を！"}
    ]
}
