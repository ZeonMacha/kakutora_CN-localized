        { "location": "162/SCENARIO", "narrator": "", "text": "忘れ物、落し物"},
        { "location": "189/TALK"    , "narrator": "アーヤ", "text": "物の定位置を決めれば"},
        { "location": "190/TALK"    , "narrator": "アーヤ", "text": "失くしたりしないって言ってあるのに"},
        { "location": "191/TALK"    , "narrator": "アーヤ", "text": "なんでそれがわからないのかしら"},
        { "location": "193/SEL"     , "narrator": "", "text": "話には聞くけどね"},
        { "location": "194/SEL"     , "narrator": "", "text": "面倒くさいから"},
        { "location": "195/SEL"     , "narrator": "", "text": "アーヤはきちんとしてるもんね"},
        { "location": "196/ACT"     , "narrator": "", "text": "話には聞くけどね"},
        { "location": "197/TALK"    , "narrator": "アーヤ", "text": "いやいや"},
        { "location": "198/TALK"    , "narrator": "アーヤ", "text": "ちゃんと"},
        { "location": "199/TALK"    , "narrator": "アーヤ", "text": "実践して欲しいのよ"},
        { "location": "200/ACT"     , "narrator": "", "text": "面倒くさいから"},
        { "location": "201/TALK"    , "narrator": "アーヤ", "text": "違うわよ"},
        { "location": "202/TALK"    , "narrator": "アーヤ", "text": "失くしたりする方が"},
        { "location": "204/TALK"    , "narrator": "アーヤ", "text": "よっぽど面倒くさいのよ"},
        { "location": "205/ACT"     , "narrator": "", "text": "アーヤはきちんとしてるもんね"},
        { "location": "207/TALK"    , "narrator": "アーヤ", "text": "そう言われるわ"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "209/TALK"    , "narrator": "アーヤ", "text": "普通のことだと思うのよね"},
        { "location": "212/SEL"     , "narrator": "", "text": "それが普通は難しい"},
        { "location": "213/SEL"     , "narrator": "", "text": "$me$もそう思うけど"},
        { "location": "214/SEL"     , "narrator": "", "text": "それが普通にできるアーヤが好き"},
        { "location": "215/ACT"     , "narrator": "", "text": "それが普通は難しい"},
        { "location": "216/TALK"    , "narrator": "アーヤ", "text": "どうも"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "そうみたいね"},
        { "location": "218/ACT"     , "narrator": "", "text": "$me$もそう思うけど"},
        { "location": "219/TALK"    , "narrator": "アーヤ", "text": "それがなかなか"},
        { "location": "220/TALK"    , "narrator": "アーヤ", "text": "わかってもらえないのよね"},
        { "location": "221/ACT"     , "narrator": "", "text": "それが普通にできるアーヤが好き"},
        { "location": "223/TALK"    , "narrator": "アーヤ", "text": "またそんなことばっかり"},
        { "location": "224/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "225/TALK"    , "narrator": "アーヤ", "text": "信じてあげるわ"},
        { "location": "227/TALK"    , "narrator": "アーヤ", "text": "どう言えば"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "わかってもらえるのかしら"},
        { "location": "229/TALK"    , "narrator": "アーヤ", "text": "難しいわ"}
    ]
