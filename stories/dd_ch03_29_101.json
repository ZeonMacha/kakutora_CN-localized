    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "かしこみかしこみ"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "……うーん……。"},
        { "location": "25/TALK"   , "narrator": "ガブリエラ", "text": "…変な時間に\n目が覚めちゃったわ…。"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "…今何時かしら…。"},
        { "location": "27/TALK"   , "narrator": "ガブリエラ", "text": "二時？　夜中の！？"},
        { "location": "29/TALK"   , "narrator": "透明みやび", "text": "くー…。くー…。"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "よく寝てられるわね\nみやびったら。"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "この世界が\nフェノメノンだって\nわかったのに…。"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "…？\n何かしら？"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "……。"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "アーヤ？"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "ギャヴィ？"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "起こしちゃった？\nごめんね。"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "それはいいんだけど…。\n何してるの？"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "禊ぎ。"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "本来は神様に\n誓いを立てる前に\nするものだけど。"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "今は自分自身に\n活を入れるために\nしているの。"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "なんだか\n落ち着かなくて。"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "ねえ。"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "それあたしも\nやっていい？\nしてもいいこと？"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "…大歓迎よ。"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "浴衣とはまたちょっと\n違うのね…。"},
        { "location": "110/SEL"   , "narrator": "", "text": "萌える！"},
        { "location": "111/SEL"   , "narrator": "", "text": "気合い入れてこ！"},
        { "location": "112/ACT"   , "narrator": "", "text": "萌える！"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "そういうのは"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "今はいいから"},
        { "location": "130/ACT"   , "narrator": "", "text": "気合い入れてこ！"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "そうするわ"},
        { "location": "160/TALK"  , "narrator": "アーヤ", "text": "冷たいから\n気をつけてね。"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "う、うん。"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "…予想以上に冷たい…！"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "…でもアーヤは平気な\n顔をしてるわ……。　"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "…あたしだって…！　"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "…どう？"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "…なんだか少し\n気持ちがすっきりした\n気がするわ。"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "そう。\nならよかった。"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "どこに行ったか\n思うたら。"},
        { "location": "184/TALK"  , "narrator": "みやび", "text": "こんなところに\nおったぞね。"},
        { "location": "186/TALK"  , "narrator": "アーヤ", "text": "みやびも\n起こしちゃった？"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "というより\n寝付けんかったぞね。"},
        { "location": "188/TALK"  , "narrator": "みやび", "text": "うちは繊細やき。"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "さっきいびきかいて\n寝てたわよね？"},
        { "location": "195/TALK"  , "narrator": "みやび", "text": "気のせいやき。"},
        { "location": "196/TALK"  , "narrator": "みやび", "text": "フェノメノンの中で\n爆睡できるほどの\n度胸はないぞね。"},
        { "location": "198/TALK"  , "narrator": "ガブリエラ", "text": "……ここって\nつばめの作った\n世界なのよね。"},
        { "location": "201/TALK"  , "narrator": "アーヤ", "text": "姉の言葉を\n信じるならね。"},
        { "location": "203/TALK"  , "narrator": "ガブリエラ", "text": "だったら。\n本当のあたしたちって\nどんななのかしら。"},
        { "location": "205/TALK"  , "narrator": "みやび", "text": "今とは似ても似つかん\n姿かもわからんねえ。"},
        { "location": "207/TALK"  , "narrator": "ガブリエラ", "text": "ビデオの中の\nあたしたちは今と\n同じだったでしょ？"},
        { "location": "208/TALK"  , "narrator": "みやび", "text": "あれは認知のゆがみで\nそう見えるだけかも\nわからんき。"},
        { "location": "210/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと！\n怖くなるようなこと\n言わないでよ！"},
        { "location": "258/TALK"  , "narrator": "ガブリエラ", "text": "　"},
        { "location": "273/TALK"  , "narrator": "ガブリエラの元司書", "text": "きたわね！"},
        { "location": "274/TALK"  , "narrator": "ガブリエラの元司書", "text": "この前はごめんなさいね。\nあたしの変態人格が\nヘンなこと言っちゃって。"},
        { "location": "275/SEL"   , "narrator": "", "text": "ガブリエラの中には高慢が潜んでいるんだね"},
        { "location": "276/SEL"   , "narrator": "", "text": "ブヒィィィィ！！"},
        { "location": "277/ACT"   , "narrator": "", "text": "ガブリエラの中には高慢が潜んでいるんだね"},
        { "location": "278/TALK"  , "narrator": "ガブリエラの元司書", "text": "そうみたい。\nあたしには\n理解できないけど。"},
        { "location": "279/ACT"   , "narrator": "", "text": "ブヒィィィィ！！"},
        { "location": "281/TALK"  , "narrator": "ガブリエラの元司書", "text": "も、もしかしてあんた、\n本気でアイツの豚に\nなるつもり！？"},
        { "location": "282/SEL"   , "narrator": "", "text": "冗談です！"},
        { "location": "283/SEL"   , "narrator": "", "text": "本気です！"},
        { "location": "284/ACT"   , "narrator": "", "text": "冗談です！"},
        { "location": "285/TALK"  , "narrator": "ガブリエラの元司書", "text": "はぁ…。\nもう、びっくり\nさせないでよね……。"},
        { "location": "286/ACT"   , "narrator": "", "text": "本気です！"},
        { "location": "288/TALK"  , "narrator": "ガブリエラの元司書", "text": "……っ。"},
        { "location": "289/TALK"  , "narrator": "ガブリエラの元司書", "text": "……。"},
        { "location": "291/TALK"  , "narrator": "ガブリエラの元司書", "text": "も、もしかして、\nああいうのが好みだったり\nするのかしら？"},
        { "location": "292/SEL"   , "narrator": "", "text": "冗談です！！"},
        { "location": "293/SEL"   , "narrator": "", "text": "そうです！！"},
        { "location": "294/ACT"   , "narrator": "", "text": "冗談です！！"},
        { "location": "296/TALK"  , "narrator": "ガブリエラの元司書", "text": "はぁ…。\nもう、びっくり\nさせないでよね……。"},
        { "location": "297/ACT"   , "narrator": "", "text": "そうです！！"},
        { "location": "299/TALK"  , "narrator": "ガブリエラの元司書", "text": "そ、そうなのね……。"},
        { "location": "300/TALK"  , "narrator": "ガブリエラの元司書", "text": "……。"},
        { "location": "301/TALK"  , "narrator": "ガブリエラの元司書", "text": "わ、わかったわ。\nいいわよ。"},
        { "location": "302/TALK"  , "narrator": "ガブリエラの元司書", "text": "それじゃ、今日から\nあたしがあんたを\nかっ……"},
        { "location": "303/TALK"  , "narrator": "ガブリエラの元司書", "text": "かかか飼って\nあげるんだから！\nこ、こここの豚！！"},
        { "location": "304/TALK"  , "narrator": "ガブリエラの元司書", "text": "……ちゃん。"},
        { "location": "305/SEL"   , "narrator": "", "text": "ブヒィィィィィィィィィィィィィィィィィィィィィィィィ！！"},
        { "location": "306/SEL"   , "narrator": "", "text": "そういうのじゃないんだ！もっと激しく罵ってくれ！！"},
        { "location": "307/ACT"   , "narrator": "", "text": "ブヒィィィィィィィィィィィィィィィィィィィィィィィィ！！"},
        { "location": "310/TALK"  , "narrator": "ガブリエラの元司書", "text": "きゃぁぁぁっ！\n落ち着いて落ち着いて！"},
        { "location": "311/ACT"   , "narrator": "", "text": "そういうのじゃないんだ！もっと激しく罵ってくれ！！"},
        { "location": "314/TALK"  , "narrator": "ガブリエラの元司書", "text": "えええええっ！？\n今ので精一杯よ！"},
        { "location": "316/TALK"  , "narrator": "ガブリエラの元司書", "text": "やっぱりあたしには\n無理だわね。\nそういうのは……。"},
        { "location": "317/SEL"   , "narrator": "", "text": "君は今まで通りの方法で$me$を愛してくれればそれでいい（キリッ"},
        { "location": "318/SEL"   , "narrator": "", "text": "リヴォルカにメロメロになりそう"},
        { "location": "319/ACT"   , "narrator": "", "text": "君は今まで通りの方法で$me$を愛してくれればそれでいい（キリッ"},
        { "location": "321/TALK"  , "narrator": "ガブリエラの元司書", "text": "今更そんなキリッと\nされても、全然かっこよく\nないわよ、豚。"},
        { "location": "322/TALK"  , "narrator": "ガブリエラの元司書", "text": "ああっ！！"},
        { "location": "323/ACT"   , "narrator": "", "text": "リヴォルカにメロメロになりそう"},
        { "location": "325/TALK"  , "narrator": "ガブリエラの元司書", "text": "はぁぁぁ……\nもういいわ。"},
        { "location": "326/TALK"  , "narrator": "ガブリエラの元司書", "text": "そんなに豚になりたいなら\n好きにすればいいのよ。"},
        { "location": "327/SEL"   , "narrator": "", "text": "だって、司書さん名前教えてくれないし"},
        { "location": "328/ACT"   , "narrator": "", "text": "だって、司書さん名前教えてくれないし"},
        { "location": "331/TALK"  , "narrator": "ガブリエラの元司書", "text": "え！？\nえ、えっと、それは……"},
        { "location": "333/TALK"  , "narrator": "ガブリエラの元司書", "text": "だ、ダメよ……\nそれはまだ、心の準備が。"},
        { "location": "338/TALK"  , "narrator": "ガブリエラの元司書", "text": "――って！\nそんなこと話してる\n場合じゃなかったわ！"},
        { "location": "339/TALK"  , "narrator": "ガブリエラの元司書", "text": "前回リヴォルカが、\nマークスマンは進化の\n準備に入ったって…。"},
        { "location": "340/TALK"  , "narrator": "ガブリエラの元司書", "text": "あの後、\nその言葉の意味を\n色々考えてみたのよ。"},
        { "location": "341/TALK"  , "narrator": "ガブリエラの元司書", "text": "そしたら１つ、\nかなり不安な可能性が\n浮かび上がってきて……。"},
        { "location": "342/SEL"   , "narrator": "", "text": "どんなこと？"},
        { "location": "343/ACT"   , "narrator": "", "text": "どんなこと？"},
        { "location": "345/TALK"  , "narrator": "ガブリエラの元司書", "text": "人格の進化っていうのは、\nあまり使わない\n言葉なんだけど――"},
        { "location": "346/TALK"  , "narrator": "ガブリエラの元司書", "text": "人が困難を乗り越えて成長\nするときや、逆にトラウマ\nを作ってしまうとき。"},
        { "location": "347/TALK"  , "narrator": "ガブリエラの元司書", "text": "そういう時には、必ず\n人格に変化が発生する。"},
        { "location": "348/TALK"  , "narrator": "ガブリエラの元司書", "text": "「人格の変化」なんて\n言い方、すごく生易しい\nけど、率直に言うと…"},
        { "location": "349/SEL"   , "narrator": "", "text": "クランの発症？"},
        { "location": "350/ACT"   , "narrator": "", "text": "クランの発症？"},
        { "location": "352/TALK"  , "narrator": "ガブリエラの元司書", "text": "……そう。"},
        { "location": "353/TALK"  , "narrator": "ガブリエラの元司書", "text": "人格は、何かを乗り越え\nようとするときや、衝撃を\n受けた時、クラン化する。"},
        { "location": "354/TALK"  , "narrator": "ガブリエラの元司書", "text": "それは、自分の持つ力を\n１２０％発揮して、その\n事象に対抗する為。"},
        { "location": "355/TALK"  , "narrator": "ガブリエラの元司書", "text": "そしてそれを達成した\nクランは、ほとぼりが\n冷めると元の人格に戻る。"},
        { "location": "356/TALK"  , "narrator": "ガブリエラの元司書", "text": "だから、リヴォルカの\n言っていた「進化」の\n心当たりとしては――"},
        { "location": "357/TALK"  , "narrator": "ガブリエラの元司書", "text": "マークスマンの発症を\n意味している可能性が\n高いの。"},
        { "location": "358/TALK"  , "narrator": "ガブリエラの元司書", "text": "けど、セルフクランは\nほとんど発症することは\nないのよ。"},
        { "location": "359/TALK"  , "narrator": "ガブリエラの元司書", "text": "そして、\nセルフクランの発症は、\n相当なリスクを伴うわ。"},
        { "location": "360/SEL"   , "narrator": "", "text": "フェノメノンを生み出してしまうから？"},
        { "location": "361/ACT"   , "narrator": "", "text": "フェノメノンを生み出してしまうから？"},
        { "location": "363/TALK"  , "narrator": "ガブリエラの元司書", "text": "うーん、\n確かにそれも\nそうなんだけど。"},
        { "location": "364/TALK"  , "narrator": "ガブリエラの元司書", "text": "それは、外的な力によって\n無理矢理作られている\nものだから例外として。"},
        { "location": "365/TALK"  , "narrator": "ガブリエラの元司書", "text": "セルフクランの発症は、\n全人格否定、もしくは\n悟りを開くレベルの事。"},
        { "location": "366/TALK"  , "narrator": "ガブリエラの元司書", "text": "そんなことが起こったら、\nあたしはあたしじゃ\nなくなっちゃうのよ。"},
        { "location": "367/SEL"   , "narrator": "", "text": "ヤバイね"},
        { "location": "368/SEL"   , "narrator": "", "text": "リヴォルカはそれを狙ってるってこと？"},
        { "location": "369/ACT"   , "narrator": "", "text": "ヤバイね"},
        { "location": "370/TALK"  , "narrator": "ガブリエラの元司書", "text": "この仮説が\n当たってたらの話よ？"},
        { "location": "371/TALK"  , "narrator": "ガブリエラの元司書", "text": "できればハズレていて\n欲しいけど……。"},
        { "location": "372/ACT"   , "narrator": "", "text": "リヴォルカはそれを狙ってるってこと？"},
        { "location": "373/TALK"  , "narrator": "ガブリエラの元司書", "text": "わからないわ。"},
        { "location": "374/TALK"  , "narrator": "ガブリエラの元司書", "text": "でも、この前の\n話しぶりだと、肯定的な\n感じはしたわね。"},
        { "location": "375/TALK"  , "narrator": "ガブリエラの元司書", "text": "まあそもそも、\n進化＝発症を意味するかは\nわからないんだけど……。"},
        { "location": "377/TALK"  , "narrator": "ガブリエラの元司書", "text": "けど、１つ言えることは、\nもうノンビリしてる時間は\n本当に無いってこと。"},
        { "location": "378/TALK"  , "narrator": "ガブリエラの元司書", "text": "すぐにでも殴り込みを\nかけに行かなくちゃ！！"},
        { "location": "379/SEL"   , "narrator": "", "text": "よし、行こう！"},
        { "location": "380/SEL"   , "narrator": "", "text": "待て待て、返り討ちに遭ったら余計ヤバイから！"},
        { "location": "381/ACT"   , "narrator": "", "text": "よし、行こう！"},
        { "location": "382/TALK"  , "narrator": "ガブリエラの元司書", "text": "ええ、そうね！"},
        { "location": "383/TALK"  , "narrator": "ガブリエラの元司書", "text": "でも、そのまま行っても\n良い結果を生まないような\n気もするわね……。"},
        { "location": "384/ACT"   , "narrator": "", "text": "待て待て、返り討ちに遭ったら余計ヤバイから！"},
        { "location": "385/TALK"  , "narrator": "ガブリエラの元司書", "text": "あーもう！\nそれじゃ、\nどうすればいいのよ！"},
        { "location": "387/SEL"   , "narrator": "", "text": "作戦を考えよう"},
        { "location": "388/ACT"   , "narrator": "", "text": "作戦を考えよう"},
        { "location": "390/TALK"  , "narrator": "ガブリエラの元司書", "text": "そ、そうね。\n何かいい作戦を……"},
        { "location": "391/TALK"  , "narrator": "ガブリエラの元司書", "text": "…うーん……。"},
        { "location": "392/TALK"  , "narrator": "ガブリエラの元司書", "text": "$handle$は、\n何か妙案あるかしら。"},
        { "location": "393/SEL"   , "narrator": "", "text": "囮作戦"},
        { "location": "394/SEL"   , "narrator": "", "text": "ブヒブヒ作戦"},
        { "location": "395/ACT"   , "narrator": "", "text": "囮作戦"},
        { "location": "396/TALK"  , "narrator": "ガブリエラの元司書", "text": "おとり？\nどういう作戦なの？"},
        { "location": "397/SEL"   , "narrator": "", "text": "$me$だけでリヴォルカの前に出て、$me$が話をしてるうちに裏で動いて"},
        { "location": "398/ACT"   , "narrator": "", "text": "$me$だけでリヴォルカの前に出て、$me$が話をしてるうちに裏で動いて"},
        { "location": "400/TALK"  , "narrator": "ガブリエラの元司書", "text": "うーん、\nそんなので\n上手くいくかしら。"},
        { "location": "401/TALK"  , "narrator": "ガブリエラの元司書", "text": "でも、あんたの発案だし、\nきっと巧みに気を逸らして\nくれるのかしらね？"},
        { "location": "402/ACT"   , "narrator": "", "text": "ブヒブヒ作戦"},
        { "location": "404/TALK"  , "narrator": "ガブリエラの元司書", "text": "ちょっと。\nふざけてる場合じゃ\nないんだけど。"},
        { "location": "405/SEL"   , "narrator": "", "text": "ふざけてない"},
        { "location": "406/ACT"   , "narrator": "", "text": "ふざけてない"},
        { "location": "408/TALK"  , "narrator": "ガブリエラの元司書", "text": "あらそう。\nそれじゃ、説明して\nもらいましょうか？"},
        { "location": "409/SEL"   , "narrator": "", "text": "$me$がリヴォルカの豚になってブヒってる間に裏で動いて"},
        { "location": "410/ACT"   , "narrator": "", "text": "$me$がリヴォルカの豚になってブヒってる間に裏で動いて"},
        { "location": "412/TALK"  , "narrator": "ガブリエラの元司書", "text": "……。"},
        { "location": "413/TALK"  , "narrator": "ガブリエラの元司書", "text": "それ、あんたが\nブヒりたいだけなんじゃ\nないの？"},
        { "location": "414/SEL"   , "narrator": "", "text": "まさか！"},
        { "location": "415/SEL"   , "narrator": "", "text": "もちろんさ（キリッ"},
        { "location": "416/ACT"   , "narrator": "", "text": "まさか！"},
        { "location": "417/TALK"  , "narrator": "ガブリエラの元司書", "text": "ふーん。\nまあいいけど。"},
        { "location": "418/ACT"   , "narrator": "", "text": "もちろんさ（キリッ"},
        { "location": "420/TALK"  , "narrator": "ガブリエラの元司書", "text": "変態。"},
        { "location": "422/TALK"  , "narrator": "ガブリエラの元司書", "text": "まあでも、むかつくけど\n案外上手くいきそうな気も\nするから悔しいわよね。"},
        { "location": "424/TALK"  , "narrator": "ガブリエラの元司書", "text": "いいわ。\nそれで一度\nやってみましょ。"},
        { "location": "425/TALK"  , "narrator": "ガブリエラの元司書", "text": "ただ、この作戦の場合、\nあんたとあたしが別々に\n1xへ行かないとなのよね。"},
        { "location": "426/TALK"  , "narrator": "ガブリエラの元司書", "text": "一緒にアイツの前に\n姿を現したら、\nバレバレなワケだし……。"},
        { "location": "427/TALK"  , "narrator": "ガブリエラの元司書", "text": "まあ、その辺りの\nオペレーションは\nあたしが考えておくわ。"},
        { "location": "428/SEL"   , "narrator": "", "text": "よろしく"},
        { "location": "429/ACT"   , "narrator": "", "text": "よろしく"},
        { "location": "431/TALK"  , "narrator": "ガブリエラの元司書", "text": "ええ。"},
        { "location": "432/TALK"  , "narrator": "ガブリエラの元司書", "text": "それじゃひとまずは、\n今回のココロの葛藤を\n何とかしちゃいましょ。"},
        { "location": "439/TALK"  , "narrator": "ガブリエラの元司書", "text": "オープンプロセス、\n0x887番地から\n0x10A番地へ。"},
        { "location": "461/TALK"  , "narrator": "ガブリエラの元司書", "text": "シーク完了。"},
        { "location": "466/TALK"  , "narrator": "ガブリエラの元司書", "text": "で、今回は……？"},
        { "location": "467/TALK"  , "narrator": "ガブリエラの元司書", "text": "…ああっ！！\n久し振りに\nつばめの事なのね！"},
        { "location": "468/TALK"  , "narrator": "ガブリエラの元司書", "text": "つばめのフェノメノンに\n包まれてることで、更に\nつばめを意識してるのね。"},
        { "location": "469/TALK"  , "narrator": "ガブリエラの元司書", "text": "けど大丈夫よ！\n現実のあたしちゃん。"},
        { "location": "470/TALK"  , "narrator": "ガブリエラの元司書", "text": "つばめはあたしのことは\n絶対に嫌ってなんて\nいないんだから！"},
        { "location": "471/TALK"  , "narrator": "ガブリエラの元司書", "text": "…という風に、\nクランを仕留めてきて\n頂戴！"},
        { "location": "472/SEL"   , "narrator": "", "text": "それって単なる司書さんの願望じゃ……"},
        { "location": "473/ACT"   , "narrator": "", "text": "それって単なる司書さんの願望じゃ……"},
        { "location": "475/TALK"  , "narrator": "ガブリエラの元司書", "text": "ち、違うわよ！\nちゃんと送られてきた\n情報に書いてあるもん！"},
        { "location": "476/TALK"  , "narrator": "ガブリエラの元司書", "text": "それじゃ行くわよ！"},
        { "location": "477/TALK"  , "narrator": "ガブリエラの元司書", "text": "あたしと\n$handle$に\n素敵なココロの旅を。"},
        { "location": "22/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月5日　 2:11 AM</color>\nストライキ３日目、長野県松代アーヤの実家にて"},
        { "location": "223/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "225/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
