{
    "dir": "chap18/daydra/dd_ch04_18_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "18402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "WAREZ＜前編＞"
    },
    "entry":
    [
        { "location": "35/TALK"   , "narrator": "みやび", "text": "ふぁ～…。"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "最近寝不足やき、\nどうにも本調子が\n出んなぁ…。"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "まあ、とりあえず\n昼ご飯食わんと…。"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "…また相棒か？\n今日はどんな用事――"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "…ウサギ！？"},
        { "location": "50/TALK"   , "narrator": "ラビットアニマ", "text": "クイーン"},
        { "location": "51/TALK"   , "narrator": "ラビットアニマ", "text": "申し訳ありませんが"},
        { "location": "52/TALK"   , "narrator": "ラビットアニマ", "text": "今すぐ場所を移動してください"},
        { "location": "55/TALK"   , "narrator": "フェイタルクイーン", "text": "どういうことか説明を求める"},
        { "location": "57/TALK"   , "narrator": "ラビットアニマ", "text": "人のいない場所へ移動してください"},
        { "location": "60/TALK"   , "narrator": "フェイタルクイーン", "text": "私の素性を知っているなら"},
        { "location": "61/TALK"   , "narrator": "フェイタルクイーン", "text": "学生だということも"},
        { "location": "62/TALK"   , "narrator": "フェイタルクイーン", "text": "もう知っているのだろう？"},
        { "location": "63/TALK"   , "narrator": "フェイタルクイーン", "text": "学校で人のいない場所など"},
        { "location": "64/TALK"   , "narrator": "フェイタルクイーン", "text": "校舎端のトイレくらいしか思いつかん"},
        { "location": "67/TALK"   , "narrator": "ラビットアニマ", "text": "では"},
        { "location": "68/TALK"   , "narrator": "ラビットアニマ", "text": "屋上へ来てください"},
        { "location": "69/TALK"   , "narrator": "ラビットアニマ", "text": "お待ちしてます"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "…待ってる？\nウサギが…屋上で！？"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "勢いよく飛び出しは\nしたけんど…、\n不用意過ぎたか？"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "こっちの素性を\n知っちょった\n相手に…。"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "う～ん…。"},
        { "location": "95/SEL"    , "narrator": "", "text": "会うの楽しみだね"},
        { "location": "96/ACT"    , "narrator": "", "text": "会うの楽しみだね"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "能天気め"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "楽観し過ぎや"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "頭の中花畑とはまさにこのこと"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "生徒なのか"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "教師なのか"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "もしかすると大学の方の人間かもしれん"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "ともかく"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "こっちはテンパリ中だというのに"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "呑気な奴め"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "…やはり、気持ちが\n乱れちょるな。"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "ウサギに会えるんは\n嬉しい。"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "けんど、\nどうにも怪しい感じが\n捨てきれん。"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "…屋上、行かん方が\nえいかもしれんな…。"},
        { "location": "185/TALK"  , "narrator": "みやび", "text": "　"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "おお、相棒か。"},
        { "location": "214/TALK"  , "narrator": "みやび", "text": "ぶはっ！！"},
        { "location": "217/TALK"  , "narrator": "みやび", "text": "もみっ！！"},
        { "location": "220/TALK"  , "narrator": "みやび", "text": "グホアァっ！"},
        { "location": "224/TALK"  , "narrator": "みやび", "text": "なんぞ、\n今回は強烈やね！\nいつもの１０倍マシか？"},
        { "location": "225/SEL"   , "narrator": "", "text": "屋上でボコられると聞いたので、予行演習をと思って"},
        { "location": "226/ACT"   , "narrator": "", "text": "屋上でボコられると聞いたので、予行演習をと思って"},
        { "location": "229/TALK"  , "narrator": "みやび", "text": "そんな予行演習\n必要ないぞね。"},
        { "location": "230/TALK"  , "narrator": "みやび", "text": "それより、今回はいよいよ\nつばめちゃんの元司書が\nいる場所へ向かう。"},
        { "location": "231/TALK"  , "narrator": "みやび", "text": "元司書ちゃんの\n正式な名も\nわかったしな。"},
        { "location": "232/SEL"   , "narrator": "", "text": "それはよかった"},
        { "location": "233/SEL"   , "narrator": "", "text": "え？なんだったの！？"},
        { "location": "234/ACT"   , "narrator": "", "text": "それはよかった"},
        { "location": "235/TALK"  , "narrator": "みやび", "text": "うむ。"},
        { "location": "236/TALK"  , "narrator": "みやび", "text": "まあ、うちのサーチ能力に\nかかれば、こんなこと\nくらい楽勝やき……"},
        { "location": "237/TALK"  , "narrator": "みやび", "text": "と言えればえいんやけんど\n今回はさすがにちっくと\n骨が折れたちや。"},
        { "location": "238/ACT"   , "narrator": "", "text": "え？なんだったの！？"},
        { "location": "239/TALK"  , "narrator": "みやび", "text": "教えんよ。"},
        { "location": "240/TALK"  , "narrator": "みやび", "text": "ココロの司書に限らず\n人格が本当の名前を\n教えるゆうんは――"},
        { "location": "241/TALK"  , "narrator": "みやび", "text": "その存在に自分の全てを\n捧げることと同義やき。"},
        { "location": "243/TALK"  , "narrator": "みやび", "text": "ちゅうわけで、\n覚悟はえいか？"},
        { "location": "244/SEL"   , "narrator": "", "text": "望むところ"},
        { "location": "245/SEL"   , "narrator": "", "text": "ちょっと怖い"},
        { "location": "246/ACT"   , "narrator": "", "text": "望むところ"},
        { "location": "247/TALK"  , "narrator": "みやび", "text": "えい度胸や。"},
        { "location": "248/ACT"   , "narrator": "", "text": "ちょっと怖い"},
        { "location": "249/TALK"  , "narrator": "みやび", "text": "まあ、それが\n一般ピーポーな感覚や。\n気にするな。"},
        { "location": "253/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n0x889番地から\nC1:2:28E//1x0FF番地へ。"},
        { "location": "258/TALK"  , "narrator": "みやび", "text": "倍速、２倍。"},
        { "location": "262/TALK"  , "narrator": "みやび", "text": "更に倍。ドン。"},
        { "location": "288/TALK"  , "narrator": "みやび", "text": "完了。"},
        { "location": "290/TALK"  , "narrator": "つばめ", "text": "…え？"},
        { "location": "291/TALK"  , "narrator": "つばめ", "text": "ああっ！\nあなたたちはっ！？"},
        { "location": "293/SEL"   , "narrator": "", "text": "無事だったんだね！"},
        { "location": "294/ACT"   , "narrator": "", "text": "無事だったんだね！"},
        { "location": "297/TALK"  , "narrator": "つばめ", "text": "$handle$さんっ！\nどうしてここに！？"},
        { "location": "298/TALK"  , "narrator": "みやび", "text": "うちがお前さんの本名から\nココロスフィアをサーチ\nして見つけたんよ。"},
        { "location": "299/SEL"   , "narrator": "", "text": "ここは？"},
        { "location": "300/SEL"   , "narrator": "", "text": "会いたかったよ！"},
        { "location": "301/ACT"   , "narrator": "", "text": "ここは？"},
        { "location": "302/TALK"  , "narrator": "つばめ", "text": "ここがどこかは\n答えられません。"},
        { "location": "303/TALK"  , "narrator": "つばめ", "text": "わたし、ずっと\n監視されてますから。"},
        { "location": "304/TALK"  , "narrator": "つばめ", "text": "そんなことより、\nここに来たらダメですよ！"},
        { "location": "305/ACT"   , "narrator": "", "text": "会いたかったよ！"},
        { "location": "306/TALK"  , "narrator": "つばめ", "text": "ええええっ！\nそ、そうなんですか？"},
        { "location": "307/TALK"  , "narrator": "つばめ", "text": "あの、その……\nとっ……"},
        { "location": "308/TALK"  , "narrator": "つばめ", "text": "とっても嬉しいです…っ。"},
        { "location": "309/TALK"  , "narrator": "つばめ", "text": "わたしも、\nとってもとっても\n逢いたかったですっ！"},
        { "location": "311/TALK"  , "narrator": "みやび", "text": "……あの、一応、うち\nいるんやけんど。"},
        { "location": "312/SEL"   , "narrator": "", "text": "あーごめん"},
        { "location": "313/SEL"   , "narrator": "", "text": "妬いてる？"},
        { "location": "314/ACT"   , "narrator": "", "text": "あーごめん"},
        { "location": "315/TALK"  , "narrator": "みやび", "text": "まったく。\n社長の前でいちゃつくとは\nなっとらんね。"},
        { "location": "316/ACT"   , "narrator": "", "text": "妬いてる？"},
        { "location": "317/TALK"  , "narrator": "みやび", "text": "……頭、沸いちゅうが？"},
        { "location": "320/TALK"  , "narrator": "つばめ", "text": "って！\nそんなことやってる\n場合じゃないんです！"},
        { "location": "324/TALK"  , "narrator": "つばめ", "text": "$handle$さんじゃ\nないですか。\nどうもお久し振りです！"},
        { "location": "325/SEL"   , "narrator": "", "text": "ここは？"},
        { "location": "326/ACT"   , "narrator": "", "text": "ここは？"},
        { "location": "328/TALK"  , "narrator": "つばめ", "text": "ここがどこかは\n答えられません。"},
        { "location": "329/TALK"  , "narrator": "つばめ", "text": "わたし、ずっと\n監視されてますから。"},
        { "location": "330/TALK"  , "narrator": "つばめ", "text": "そんなことより、\nここに来たらダメですよ！"},
        { "location": "333/TALK"  , "narrator": "つばめ", "text": "早くここから\n逃げてください！"},
        { "location": "335/TALK"  , "narrator": "みやび", "text": "つばめちゃん、\n一体何が起こっちゅう？"},
        { "location": "336/TALK"  , "narrator": "つばめ", "text": "そんな話してるヒマ\nありませんから！"},
        { "location": "337/SEL"   , "narrator": "", "text": "なら一緒に逃げよう！"},
        { "location": "338/ACT"   , "narrator": "", "text": "なら一緒に逃げよう！"},
        { "location": "341/TALK"  , "narrator": "つばめ", "text": "無理ですよ！\nわたしは今、\n再教育中の身なんです！"},
        { "location": "342/TALK"  , "narrator": "つばめ", "text": "一挙一動が\n監視されてます！"},
        { "location": "343/TALK"  , "narrator": "つばめ", "text": "多分もう\nこっちに――"},
        { "location": "375/TALK"  , "narrator": "みやび", "text": "…なんや…こいつ。"},
        { "location": "376/TALK"  , "narrator": "つばめ", "text": "教官さんです……。"},
        { "location": "377/TALK"  , "narrator": "みやび", "text": "なんやて…？"},
        { "location": "378/TALK"  , "narrator": "？？？", "text": "……。"},
        { "location": "379/TALK"  , "narrator": "？？？", "text": "サーチ完了。\nC4:7:000 ――"},
        { "location": "380/TALK"  , "narrator": "みやび", "text": "なっ！！\nそれ、うちの……\nそんな馬鹿な！？"},
        { "location": "381/TALK"  , "narrator": "みやび", "text": "くっそ…\n迂闊やったか。"},
        { "location": "382/TALK"  , "narrator": "みやび", "text": "相棒…。\nうちのゆうことを\nよく聞きや。"},
        { "location": "384/SEL"   , "narrator": "", "text": "おい！そこの黒いの！！"},
        { "location": "385/TALK"  , "narrator": "みやび", "text": "今からお前さんを\nうちのスフィアに戻す。"},
        { "location": "394/TALK"  , "narrator": "みやび", "text": "それと、今から言うこと\nだけは、絶対に覚えとけ。\n絶対に忘れるな。"},
        { "location": "395/TALK"  , "narrator": "みやび", "text": "カレンディサイプロブ\nイシュリールシンギュ\nラリティー！"},
        { "location": "396/TALK"  , "narrator": "みやび", "text": "うちと\nつばめちゃんからの\nラブコールや。"},
        { "location": "397/TALK"  , "narrator": "みやび", "text": "あとはよろしく\n頼んだで。"},
        { "location": "399/TALK"  , "narrator": "つばめ", "text": "$handle$さん、\nどうかご無事で！"},
        { "location": "400/SEL"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "401/ACT"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "404/ACT"   , "narrator": "", "text": "おい！そこの黒いの！！"},
        { "location": "408/TALK"  , "narrator": "みやび", "text": "ドあほ！！\n黙って聞け！！"},
        { "location": "409/TALK"  , "narrator": "みやび", "text": "カレンディサイプロブ\nイシュリールシンギュ\nラリティー！"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月25日　0:03 PM</color>\nとある夏休み直前の平日、みやびの教室にて。"},
        { "location": "150/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "152/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "154/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "156/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "158/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "200/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "223/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "432/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\n司書が存在しません。(p12)"},
        { "location": "433/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\nAutoBatchが\n検出されました。\n\nコマンド\n<color=blue>【EXEC_SEEK_SECTOR/.】</color>\nを、実行します。"},
        { "location": "438/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:SeekSector】</color>\nOpenProcess...\n(0x889 => 0x21F)"},
        { "location": "451/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:SeekSector】</color>\nSucceed access file!\n\n<color=blue>【File :: 04-628-17】</color>\n<color=red>Fatal Error Occured !</color>\n\nハッカーとして顔割れは厳禁。ましてや同業者に対しては決して警戒を怠っては成らない――。\n\nそう頭ではわかっていても、ココロの総意はRabbitAnimaがどのような輩なのか知りたくて、もはや選択の余地もない状態。"}
    ]
}
