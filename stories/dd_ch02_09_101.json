{
    "dir": "chap09/daydra/dd_ch02_09_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "9202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "臆する季節＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "臆する季節"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "んーっ！\nやっとお昼ね…。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "今日は２講までで\n終わりだから――"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "お昼は外で食べよう\nかしら？"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "アーヤ。"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "ん？"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと聞きたい\nことがあるんだけど。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "あら、ギャヴィ。\nどうかしたの？"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "うん、前の休み時間に\nまほに聞かれたん\nだけど――"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "今日のシフトって\n誰だったっけ？"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "えっと、確か…、\nつばめとみやびじゃ\nなかったかしら？"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "そっか…なんか、\nこの前出動した時の\n報告書を作るから――"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "もう一度みんなから\n話を聞きたいみたい。"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "うーん、確か明後日は\n全員シフトに入ってる\nはずだけど――"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "急ぎなら、私から\nみんなにＷＡＶＥ\n送っとくわ。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "明後日だ、って\nまほに伝えておくわ。"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "シフトのない日に\n劇場行きたくない\nもの。"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "でも――"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "いいの！\nていうか、アーヤは\n真面目過ぎなのよ。"},
        { "location": "60/TALK"   , "narrator": "小夜", "text": "アーヤ。"},
        { "location": "63/TALK"   , "narrator": "小夜", "text": "おつかれー。\n今、丁度ＷＡＶＥ\n送ろうかな、って――"},
        { "location": "65/TALK"   , "narrator": "小夜", "text": "…あら？"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "あ、どうも…。"},
        { "location": "68/TALK"   , "narrator": "小夜", "text": "こんにちは。\nえっと…アーヤの\n知り合いかしら？"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "ええ、ちょっとね。"},
        { "location": "73/TALK"   , "narrator": "小夜", "text": "？"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "じゃあ、あたしは\nもう行くから――"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "くれぐれも、\nまほに余計なこと\n言ったらダメよ？"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "あ、ちょっと！\n待ってギャヴィ…。"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "…もう、\nいい加減なんだから。"},
        { "location": "85/TALK"   , "narrator": "小夜", "text": "…邪魔しちゃった？"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "あ、ううん。\nそんなことないわ。"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "それより、用事が\nあるんじゃないの？"},
        { "location": "89/TALK"   , "narrator": "小夜", "text": "あ、そうだった。"},
        { "location": "90/TALK"   , "narrator": "小夜", "text": "アーヤさ、今日って\n３講取ってたっけ？"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "ううん、今日は\n２講までよ。"},
        { "location": "92/TALK"   , "narrator": "小夜", "text": "よかった。\n私も今日は２講で\n終わりだから――"},
        { "location": "93/TALK"   , "narrator": "小夜", "text": "この後サークル棟\n行かない？"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "いいわよ。\n私も行こうと思ってた\nところだったし。"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "でも、その前に\nお昼を食べないとね。"},
        { "location": "96/TALK"   , "narrator": "小夜", "text": "じゃ、学食\n行きましょ。"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "えっ？　今日は外に\n食べに行くつもり\nだったんだけど…。"},
        { "location": "99/TALK"   , "narrator": "小夜", "text": "折角リーズナブルな\n学食があるのに――"},
        { "location": "100/TALK"  , "narrator": "小夜", "text": "行かないなんて\nもったいないでしょ。"},
        { "location": "101/TALK"  , "narrator": "小夜", "text": "ほら、行こ行こ。"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "もぅ、仕方ないわね。"},
        { "location": "120/TALK"  , "narrator": "小夜", "text": "いただきまーす！"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "124/TALK"  , "narrator": "小夜", "text": "どうかしたの？"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "…よく食べるなぁ、\nと思ってね。"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "スーパースペシャル\nって、運動部用の\nメニューよ？"},
        { "location": "131/TALK"  , "narrator": "小夜", "text": "毎日一生懸命だと、\nどうしたって\nお腹が減るのよ。"},
        { "location": "133/TALK"  , "narrator": "小夜", "text": "ていうか、アーヤは\n食べな過ぎじゃない？"},
        { "location": "134/TALK"  , "narrator": "小夜", "text": "サラダだけじゃ\n身体持たないでしょ。"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "小夜ほどじゃない\nけど、ちゃんと\nお肉も食べてるわ。"},
        { "location": "136/TALK"  , "narrator": "小夜", "text": "コスパいいなぁ。\nちょっと羨ましい\nかも。"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "あ、あはは…。"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "…そんな肉ばっかり\n食べてその体系を\n維持できてる――"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "小夜の方が羨ましいん\nだけど…。"},
        { "location": "145/TALK"  , "narrator": "小夜", "text": "…デザートにパフェも\n頼もうかしら？"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "…小夜って、絶対に\n運動系サークルにも\n入ってるでしょ？"},
        { "location": "149/TALK"  , "narrator": "小夜", "text": "ないない。\n人形サークルだけで\n手いっぱいだって。"},
        { "location": "151/TALK"  , "narrator": "小夜", "text": "…っていうか、\nアーヤの方は、\n最近忙しそうね？"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "…トライナリーの\nこと？"},
        { "location": "155/TALK"  , "narrator": "小夜", "text": "うん。\n最近、出撃がちょっと\n多くない？"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "うーん…まあ、\nぼちぼち、って\nとこかしら？"},
        { "location": "157/TALK"  , "narrator": "小夜", "text": "命がけの出動が\nぼちぼちあるって、\n相当なもんよね…。"},
        { "location": "159/TALK"  , "narrator": "小夜", "text": "でも、戦ってる時の\nアーヤって、凄いん\nだろうなぁ…。"},
        { "location": "161/TALK"  , "narrator": "アーヤ", "text": "凄いっていうと？"},
        { "location": "164/TALK"  , "narrator": "小夜", "text": "自慢の剣道スキルを\nフル活用して――"},
        { "location": "165/TALK"  , "narrator": "小夜", "text": "群がる敵をバッサ\nバッサ薙ぎ倒してるん\nでしょ？"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "そこまで派手じゃ\nないかな？"},
        { "location": "169/TALK"  , "narrator": "小夜", "text": "あ、かっこいい\n名乗りとかもするの？"},
        { "location": "171/TALK"  , "narrator": "アーヤ", "text": "しないって。\n特撮ヒーローじゃ\nあるまいし。"},
        { "location": "172/TALK"  , "narrator": "小夜", "text": "あはは、勿体ない。\n劇で鍛えたスキルを\n使うチャンスなのに。"},
        { "location": "174/TALK"  , "narrator": "アーヤ", "text": "でも、名前って\n個人情報だし。"},
        { "location": "177/TALK"  , "narrator": "小夜", "text": "ドライ過ぎない？\nまあ、アーヤっぽくは\nあるけどさぁ…。"},
        { "location": "178/TALK"  , "narrator": "小夜", "text": "じゃあ、必殺技の\n名前は？"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "ないから。"},
        { "location": "183/TALK"  , "narrator": "小夜", "text": "ん～、じゃあ他の子の\n武器とか技は？"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "…色々、それぞれに\n得意分野があるわ。"},
        { "location": "185/TALK"  , "narrator": "小夜", "text": "例えば？"},
        { "location": "186/TALK"  , "narrator": "アーヤ", "text": "だから、色々よ。"},
        { "location": "187/TALK"  , "narrator": "小夜", "text": "そうやってはぐらか\nして、全然教えて\nくれないんだから…。"},
        { "location": "188/TALK"  , "narrator": "アーヤ", "text": "仕方ないでしょ？\n秘密にするのが\n規則なんだから…。"},
        { "location": "189/TALK"  , "narrator": "小夜", "text": "うちの学生には\n該当しないじゃん。"},
        { "location": "191/TALK"  , "narrator": "アーヤ", "text": "それはそうだけど…。"},
        { "location": "192/TALK"  , "narrator": "小夜", "text": "本当、アーヤってば\n堅いんだから…。"},
        { "location": "193/TALK"  , "narrator": "アーヤ", "text": "…そうかしら？"},
        { "location": "237/TALK"  , "narrator": "アーヤ", "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。"},
        { "location": "238/TALK"  , "narrator": "アーヤ", "text": "今回も私を助けに\n来てくれたのね。\nいつもありがとう。"},
        { "location": "240/TALK"  , "narrator": "アーヤ", "text": "それじゃ早速\n扉をコールするわね。"},
        { "location": "245/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0x992番地から\n0x05F番地へ。"},
        { "location": "260/TALK"  , "narrator": "アーヤ", "text": "シーク完了。"},
        { "location": "262/TALK"  , "narrator": "アーヤ", "text": "えーっと、\n今回の停滞は……？"},
        { "location": "264/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "265/TALK"  , "narrator": "アーヤ", "text": "………。"},
        { "location": "266/TALK"  , "narrator": "アーヤ", "text": "なるほどね。\n心配性の私らしい停滞ね。"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "今回のロックは、\n割とわかりやすい\n理由みたいよ。"},
        { "location": "268/TALK"  , "narrator": "アーヤ", "text": "小夜にリスクを追わせたく\nない気持ちと、信じたい\n気持ちのせめぎ合いね。"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "でもやっぱり、アンパイを\n選んで、今回も何も喋る\nつもりはないみたい。"},
        { "location": "271/TALK"  , "narrator": "アーヤ", "text": "本当はもっと\n色んな話をしたいって\n思ってるのにね。"},
        { "location": "272/TALK"  , "narrator": "アーヤ", "text": "自分で自分に枷を\nつけちゃって。"},
        { "location": "273/SEL"   , "narrator": "", "text": "アーヤらしいね"},
        { "location": "274/ACT"   , "narrator": "", "text": "アーヤらしいね"},
        { "location": "276/TALK"  , "narrator": "アーヤ", "text": "ふふ。ほんとね。"},
        { "location": "277/TALK"  , "narrator": "アーヤ", "text": "でも、貴方が協力して\nくれれば、その枷を\n外すことができる。"},
        { "location": "278/TALK"  , "narrator": "アーヤ", "text": "私が本当になりたい私に\n一歩近づけるのよ。"},
        { "location": "279/TALK"  , "narrator": "アーヤ", "text": "だから、今回も\n宜しくお願いね。"},
        { "location": "280/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "281/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "284/TALK"  , "narrator": "アーヤ", "text": "ふふ、ありがと。"},
        { "location": "285/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！"},
        { "location": "30/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月12日　12:06 PM</color>\nとある平日の昼休み、学園廊下にて。"},
        { "location": "205/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
