    "entry":
    [
        { "location": "483/SCENARIO", "narrator": "", "text": "それぞれの入隊"},
        { "location": "496/SEL"     , "narrator": "", "text": "ごめんね"},
        { "location": "497/ACT"     , "narrator": "", "text": "ごめんね"},
        { "location": "501/TALK"    , "narrator": "アーヤ", "text": "はぁ…しつこいわね。"},
        { "location": "517/TALK"    , "narrator": "アーヤ", "text": "え？"},
        { "location": "518/TALK"    , "narrator": "アーヤ", "text": "なにが？"},
        { "location": "520/SEL"     , "narrator": "", "text": "お姉さんのこと、もう聞かない"},
        { "location": "521/ACT"     , "narrator": "", "text": "お姉さんのこと、もう聞かない"},
        { "location": "524/TALK"    , "narrator": "アーヤ", "text": "ありがとう(｡-_-｡)"},
        { "location": "525/TALK"    , "narrator": "アーヤ", "text": "そうしてもらえると"},
        { "location": "526/TALK"    , "narrator": "アーヤ", "text": "私も助かるわ(^^"},
        { "location": "528/SEL"     , "narrator": "", "text": "誰でも聞かれたくないことはあるよね？"},
        { "location": "529/ACT"     , "narrator": "", "text": "誰でも聞かれたくないことはあるよね？"},
        { "location": "531/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "533/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔでも"},
        { "location": "534/TALK"    , "narrator": "アーヤ", "text": "そういうのわかるんだ？(￣∇￣)"},
        { "location": "535/TALK"    , "narrator": "アーヤ", "text": "凄いのね(*^.^*)"},
        { "location": "537/SEL"     , "narrator": "", "text": "$me$に何かできる？"},
        { "location": "538/ACT"     , "narrator": "", "text": "$me$に何かできる？"},
        { "location": "540/TALK"    , "narrator": "アーヤ", "text": "どういうこと？（￣ー￣？）"},
        { "location": "542/SEL"     , "narrator": "", "text": "アーヤの支えになりたい"},
        { "location": "543/ACT"     , "narrator": "", "text": "アーヤの支えになりたい"},
        { "location": "546/TALK"    , "narrator": "アーヤ", "text": "いや"},
        { "location": "547/TALK"    , "narrator": "アーヤ", "text": "真剣過ぎだから"},
        { "location": "548/TALK"    , "narrator": "アーヤ", "text": "ちょっと笑っちゃったわ(*ﾉ∀`*) "},
        { "location": "550/TALK"    , "narrator": "アーヤ", "text": "もういいわ"},
        { "location": "551/TALK"    , "narrator": "アーヤ", "text": "こうやって話してたら"},
        { "location": "552/TALK"    , "narrator": "アーヤ", "text": "さっきまでのモヤモヤ"},
        { "location": "553/TALK"    , "narrator": "アーヤ", "text": "消えちゃったみたい＼(^O^)／"},
        { "location": "555/SEL"     , "narrator": "", "text": "$me$のおかげだ！"},
        { "location": "556/ACT"     , "narrator": "", "text": "$me$のおかげだ！"},
        { "location": "558/TALK"    , "narrator": "アーヤ", "text": "調子に乗ってる？( ・_・)σﾞ"},
        { "location": "559/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "560/TALK"    , "narrator": "アーヤ", "text": "そうかもね(^^"},
        { "location": "561/TALK"    , "narrator": "アーヤ", "text": "あなたと話したおかげで"},
        { "location": "562/TALK"    , "narrator": "アーヤ", "text": "落ち着いて考えられたんだし"},
        { "location": "564/TALK"    , "narrator": "アーヤ", "text": "ありがとう(^з^)-☆"},
        { "location": "565/TALK"    , "narrator": "アーヤ", "text": "もうちょっと"},
        { "location": "566/TALK"    , "narrator": "アーヤ", "text": "自分の心の中"},
        { "location": "567/TALK"    , "narrator": "アーヤ", "text": "整理してみるわ☆彡"},
        { "location": "578/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "579/TALK"    , "narrator": "アーヤ", "text": "もうちょっと、\n自分の心の整理が\n出来たら――"},
        { "location": "580/TALK"    , "narrator": "アーヤ", "text": "その時は、\n姉のこと聞いて\nもらおうかしら？"},
        { "location": "581/TALK"    , "narrator": "アーヤ", "text": "…それにしても。\n館長に言われて\n気付いたけど――"},
        { "location": "582/TALK"    , "narrator": "アーヤ", "text": "私、もうこっちで\n暮らし始めてから、\n半年も経つんだ…。"},
        { "location": "583/TALK"    , "narrator": "アーヤ", "text": "…私一人だけだった\nトライナリーも、\n今じゃ四人…。"},
        { "location": "584/TALK"    , "narrator": "アーヤ", "text": "ううん、もうすぐ\n五人になるのよね。"},
        { "location": "585/TALK"    , "narrator": "アーヤ", "text": "…一人だけだった\n頃よりも賑やかに\nなるけど――"},
        { "location": "586/TALK"    , "narrator": "アーヤ", "text": "私に圧し掛かる\n責任も重くなる、\nか…。"},
        { "location": "588/TALK"    , "narrator": "アーヤ", "text": "はぁ…。\n一人の頃みたいには\nいかないわね…。"},
        { "location": "589/SEL"     , "narrator": "", "text": "リーダーは大変だね"},
        { "location": "590/ACT"     , "narrator": "", "text": "リーダーは大変だね"},
        { "location": "607/TALK"    , "narrator": "アーヤ", "text": "まあね"},
        { "location": "609/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "610/TALK"    , "narrator": "アーヤ", "text": "それが仕事だし(；´Д｀)"},
        { "location": "612/SEL"     , "narrator": "", "text": "ガブリエラ達が入った時のこと話して"},
        { "location": "613/SEL"     , "narrator": "", "text": "愚痴ならいつでも聞くよ"},
        { "location": "614/SEL"     , "narrator": "", "text": "さっきの話は本当なの？"},
        { "location": "615/ACT"     , "narrator": "", "text": "ガブリエラ達が入った時のこと話して"},
        { "location": "616/TALK"    , "narrator": "アーヤ", "text": "二人は円満入隊よ"},
        { "location": "617/TALK"    , "narrator": "アーヤ", "text": "ギャヴィはトライナリーになることを条件に"},
        { "location": "618/TALK"    , "narrator": "アーヤ", "text": "日本へ留学して来たの"},
        { "location": "619/TALK"    , "narrator": "アーヤ", "text": "みやびは自分から志願して来たし"},
        { "location": "620/TALK"    , "narrator": "アーヤ", "text": "理由はよくわからないけど"},
        { "location": "621/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "622/TALK"    , "narrator": "アーヤ", "text": "みやびの両親はうちと違って"},
        { "location": "623/TALK"    , "narrator": "アーヤ", "text": "入隊を名誉なことだって喜んだみたい"},
        { "location": "624/TALK"    , "narrator": "アーヤ", "text": "うちの親は"},
        { "location": "627/TALK"    , "narrator": "アーヤ", "text": "本当"},
        { "location": "628/TALK"    , "narrator": "アーヤ", "text": "親も色々よね(；´Д｀)"},
        { "location": "629/ACT"     , "narrator": "", "text": "愚痴ならいつでも聞くよ"},
        { "location": "630/TALK"    , "narrator": "アーヤ", "text": "ありがと(^^"},
        { "location": "631/TALK"    , "narrator": "アーヤ", "text": "愚痴を言える場所があるだけでも"},
        { "location": "632/TALK"    , "narrator": "アーヤ", "text": "気持ちがラクになるから"},
        { "location": "633/TALK"    , "narrator": "アーヤ", "text": "リーダーの私が"},
        { "location": "634/TALK"    , "narrator": "アーヤ", "text": "他のみんなに愚痴ったりできないし"},
        { "location": "635/TALK"    , "narrator": "アーヤ", "text": "頼りにしてるわ(^ε^)-☆!!"},
        { "location": "638/ACT"     , "narrator": "", "text": "さっきの話は本当なの？"},
        { "location": "640/TALK"    , "narrator": "アーヤ", "text": "全部本当よ(-.-;)"},
        { "location": "642/TALK"    , "narrator": "アーヤ", "text": "あの時は結局"},
        { "location": "643/TALK"    , "narrator": "アーヤ", "text": "私が勘当同然で家を飛び出して(T_T)"},
        { "location": "644/TALK"    , "narrator": "アーヤ", "text": "フェノメノンを収束させたの"},
        { "location": "645/TALK"    , "narrator": "アーヤ", "text": "今は親とも和解出来たけど"},
        { "location": "646/TALK"    , "narrator": "アーヤ", "text": "まだ納得はしてくれてなくて"},
        { "location": "647/TALK"    , "narrator": "アーヤ", "text": "今でも時々辞めろって言われる(´o｀；"},
        { "location": "648/TALK"    , "narrator": "アーヤ", "text": "でもとりあえず"},
        { "location": "649/TALK"    , "narrator": "アーヤ", "text": "帰る場所を失くさないで済んで"},
        { "location": "650/TALK"    , "narrator": "アーヤ", "text": "ほっとしたわ"},
        { "location": "652/TALK"    , "narrator": "アーヤ", "text": "まあなんであれ"},
        { "location": "653/TALK"    , "narrator": "アーヤ", "text": "逢瀬さんが自主的に入隊してくれたこと"},
        { "location": "654/TALK"    , "narrator": "アーヤ", "text": "それについては純粋に嬉しいの(*^o^*)"},
        { "location": "656/TALK"    , "narrator": "アーヤ", "text": "仲間が増えたってことだし"},
        { "location": "657/TALK"    , "narrator": "アーヤ", "text": "きっと"},
        { "location": "658/TALK"    , "narrator": "アーヤ", "text": "今は不安でいっぱいだろうから"},
        { "location": "659/TALK"    , "narrator": "アーヤ", "text": "しばらくは私が力になってあげなくちゃ"},
        { "location": "661/SEL"     , "narrator": "", "text": "応援してるよ、リーダー"},
        { "location": "662/ACT"     , "narrator": "", "text": "応援してるよ、リーダー"},
        { "location": "664/TALK"    , "narrator": "アーヤ", "text": "ありがと(*^^*)"},
        { "location": "686/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【05 金色の髪のカグラ】"}
    ]
}
