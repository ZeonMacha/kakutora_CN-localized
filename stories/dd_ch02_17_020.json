    "type": "MainStory",
    "info": {
        "story_id": "17256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "勉強疲れ"
    },
    "entry":
    [
        { "location": "285/SCENARIO", "narrator": "", "text": "勉強疲れ"},
        { "location": "300/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "301/TALK"    , "narrator": "アーヤ", "text": "ふぅ…。"},
        { "location": "302/TALK"    , "narrator": "アーヤ", "text": "…ダメだわ。\n今日は全然講義の内容が\n頭に入らない…。"},
        { "location": "315/TALK"    , "narrator": "アーヤ", "text": "今日はもう、講義受けたくない気分"},
        { "location": "317/SEL"     , "narrator": "", "text": "だらしないよ"},
        { "location": "318/SEL"     , "narrator": "", "text": "珍しいね？"},
        { "location": "319/ACT"     , "narrator": "", "text": "だらしないよ"},
        { "location": "320/TALK"    , "narrator": "アーヤ", "text": "ごめんなさい…"},
        { "location": "321/TALK"    , "narrator": "アーヤ", "text": "だらけちゃダメよね？"},
        { "location": "322/TALK"    , "narrator": "アーヤ", "text": "頑張る(>_<)"},
        { "location": "333/TALK"    , "narrator": "アーヤ", "text": "…しっかりしないと、\nダメよね。"},
        { "location": "334/TALK"    , "narrator": "アーヤ", "text": "頑張らないと…。"},
        { "location": "336/TALK"    , "narrator": "アーヤ", "text": "…はぁ。"},
        { "location": "338/ACT"     , "narrator": "", "text": "珍しいね？"},
        { "location": "339/TALK"    , "narrator": "アーヤ", "text": "多分、ストレスが溜まってるからだと思うの"},
        { "location": "340/TALK"    , "narrator": "アーヤ", "text": "愚痴っちゃうけど、いい？"},
        { "location": "343/SEL"     , "narrator": "", "text": "話して"},
        { "location": "344/ACT"     , "narrator": "", "text": "話して"},
        { "location": "346/TALK"    , "narrator": "アーヤ", "text": "少し前なんだけど、バイクで日帰り温泉旅行に行く予定だったの"},
        { "location": "347/TALK"    , "narrator": "アーヤ", "text": "けど、その日にフェノメノンが出て、計画が潰れちゃって…"},
        { "location": "348/TALK"    , "narrator": "アーヤ", "text": "まあ、つまりお休みが欲しいな、ってこと"},
        { "location": "350/SEL"     , "narrator": "", "text": "今日はもうサボッちゃえ"},
        { "location": "351/SEL"     , "narrator": "", "text": "仕事なんだから仕方ないよ"},
        { "location": "352/ACT"     , "narrator": "", "text": "今日はもうサボッちゃえ"},
        { "location": "353/TALK"    , "narrator": "アーヤ", "text": "そういうわけにもいかないわ"},
        { "location": "354/TALK"    , "narrator": "アーヤ", "text": "サボッたのみんなにバレたら、絶対色々言われるだろうし…"},
        { "location": "355/TALK"    , "narrator": "アーヤ", "text": "愚痴聞いてもらっただけで十分よ、ありがと"},
        { "location": "367/TALK"    , "narrator": "アーヤ", "text": "…頑張らないと。"},
        { "location": "369/TALK"    , "narrator": "アーヤ", "text": "…はぁ。"},
        { "location": "383/TALK"    , "narrator": "つばめ", "text": "――っていうことが\nあったんですよ。"},
        { "location": "384/TALK"    , "narrator": "つばめ", "text": "その時、ひなこちゃんが\nキリトくん達に…。"},
        { "location": "385/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "386/TALK"    , "narrator": "つばめ", "text": "…アーヤさん？"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "えっ？"},
        { "location": "390/TALK"    , "narrator": "つばめ", "text": "えっと、ずっと話を\nしてたんですけど…。"},
        { "location": "391/TALK"    , "narrator": "アーヤ", "text": "あっ、ごめんごめん。\n少しぼーっとしちゃってた\nみたい…。"},
        { "location": "392/TALK"    , "narrator": "つばめ", "text": "…どこか、具合でも\n悪いんですか？"},
        { "location": "394/TALK"    , "narrator": "アーヤ", "text": "ううん、そうじゃないの。\n本当にぼーっとしちゃった\nだけよ。"},
        { "location": "395/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "396/TALK"    , "narrator": "アーヤ", "text": "ほら、冷めちゃうから\n早く食べちゃいましょ。"},
        { "location": "397/TALK"    , "narrator": "つばめ", "text": "は、はい。"},
        { "location": "398/TALK"    , "narrator": "つばめ", "text": "…やっぱり、具合悪そうに\n見えるんだけどなぁ？"},
        { "location": "405/TALK"    , "narrator": "つばめ", "text": "アーヤさん、何だか元気がないみたいなの"},
        { "location": "407/TALK"    , "narrator": "つばめ", "text": "何があったか、$handle$さんは知ってる？"},
        { "location": "409/SEL"     , "narrator": "", "text": "休みが欲しいみたい"},
        { "location": "410/SEL"     , "narrator": "", "text": "超お腹が減ってるみたい"},
        { "location": "411/ACT"     , "narrator": "", "text": "休みが欲しいみたい"},
        { "location": "412/TALK"    , "narrator": "つばめ", "text": "あっ、思い出した！"},
        { "location": "413/TALK"    , "narrator": "つばめ", "text": "この前のアーヤさんのお休み、フェノメノンのせいで潰れちゃったんだった…"},
        { "location": "414/TALK"    , "narrator": "つばめ", "text": "そっか…ありがと"},
        { "location": "421/TALK"    , "narrator": "つばめ", "text": "あの日って、温泉旅行に\n行くとか言ってたし――"},
        { "location": "422/TALK"    , "narrator": "つばめ", "text": "元気ないの、当然だよ。"},
        { "location": "423/TALK"    , "narrator": "つばめ", "text": "…アーヤさんが今度、\n大学もバイトもお休みの\n日って、いつでしたっけ？"},
        { "location": "425/TALK"    , "narrator": "アーヤ", "text": "しばらくないわ。\nどっちかは必ず予定に\n入っちゃってて…。"},
        { "location": "426/TALK"    , "narrator": "つばめ", "text": "大学がお休みの日は\nいつですか？"},
        { "location": "427/TALK"    , "narrator": "アーヤ", "text": "えっと…明後日が確か\nそうだったかしら？"},
        { "location": "428/TALK"    , "narrator": "つばめ", "text": "丁度良かったです。\nわたし、その日はバイトが\nお休みなんで――"},
        { "location": "429/TALK"    , "narrator": "つばめ", "text": "よかったらわたしの\nシフトと変わりませんか？"},
        { "location": "430/TALK"    , "narrator": "アーヤ", "text": "…もしかして、\n気を使ってくれてる？"},
        { "location": "433/TALK"    , "narrator": "つばめ", "text": "えっ？　えっと…。"},
        { "location": "435/TALK"    , "narrator": "アーヤ", "text": "ありがと…\nでも、気持ちだけで\n十分よ。"},
        { "location": "438/TALK"    , "narrator": "つばめ", "text": "で、でも、この前の\nお休みはフェノメノンの\nせいで潰れちゃったし――"},
        { "location": "439/TALK"    , "narrator": "つばめ", "text": "それに、凄く疲れてる\nでしょう？"},
        { "location": "440/TALK"    , "narrator": "つばめ", "text": "リーダーのアーヤさんは、\n常にベストな状態でいて\nもらわないと困りますよ。"},
        { "location": "441/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "442/TALK"    , "narrator": "つばめ", "text": "…えっと、ちょっと\n生意気でしたか？"},
        { "location": "443/TALK"    , "narrator": "アーヤ", "text": "…ううん。\nつばめの言う通りよ。"},
        { "location": "444/TALK"    , "narrator": "アーヤ", "text": "それじゃあ、お言葉に\n甘えてシフトを交換して\nもらっていいかしら？"},
        { "location": "445/TALK"    , "narrator": "つばめ", "text": "もちろんです。"},
        { "location": "447/TALK"    , "narrator": "アーヤ", "text": "ふふっ…それじゃあ、\nこの前行けなかった\n温泉旅行――"},
        { "location": "448/TALK"    , "narrator": "アーヤ", "text": "もう一度計画して\nみようかしら？"},
        { "location": "450/TALK"    , "narrator": "つばめ", "text": "…よかった。\n喜んでもらえて。"},
        { "location": "468/ACT"     , "narrator": "", "text": "超お腹が減ってるみたい"},
        { "location": "469/TALK"    , "narrator": "つばめ", "text": "そうだったんだ…"},
        { "location": "470/TALK"    , "narrator": "つばめ", "text": "わかった、ありがと"},
        { "location": "477/TALK"    , "narrator": "つばめ", "text": "アーヤさん。\nご飯、美味しいですね。"},
        { "location": "479/TALK"    , "narrator": "アーヤ", "text": "え？　ええ、そうね。"},
        { "location": "480/TALK"    , "narrator": "つばめ", "text": "わたしの唐揚げ、\n一つあげます。"},
        { "location": "481/TALK"    , "narrator": "アーヤ", "text": "え？　あ、うん…\nよくわからないけど、\nありがと…。"},
        { "location": "482/TALK"    , "narrator": "つばめ", "text": "…………？"},
        { "location": "483/TALK"    , "narrator": "つばめ", "text": "あ、あれ？\nなんか、全然美味しそうに\n食べてないような…。"},
        { "location": "485/TALK"    , "narrator": "つばめ", "text": "…もしかして、\nお腹が減ってるわけじゃ\nないのかな？"},
        { "location": "486/TALK"    , "narrator": "つばめ", "text": "あ、あの、アーヤさ――"},
        { "location": "487/TALK"    , "narrator": "アーヤ", "text": "じゃあ、食べ終わったから\nお先に。"},
        { "location": "491/TALK"    , "narrator": "つばめ", "text": "あっ…。"},
        { "location": "493/TALK"    , "narrator": "つばめ", "text": "…行っちゃった。"},
        { "location": "495/TALK"    , "narrator": "つばめ", "text": "…元気がなかった理由、\n結局わからなかった\nなぁ…。"},
        { "location": "496/TALK"    , "narrator": "つばめ", "text": "…心配だなぁ。"},
        { "location": "498/ACT"     , "narrator": "", "text": "仕事なんだから仕方ないよ"},
        { "location": "499/TALK"    , "narrator": "アーヤ", "text": "…そうよね"},
        { "location": "500/TALK"    , "narrator": "アーヤ", "text": "ありがと、ちょっと吹っ切れたわ"},
        { "location": "511/TALK"    , "narrator": "アーヤ", "text": "…しっかりしないと、\nダメよね。"},
        { "location": "512/TALK"    , "narrator": "アーヤ", "text": "頑張らないと…。"},
        { "location": "514/TALK"    , "narrator": "アーヤ", "text": "…はぁ。"},
        { "location": "292/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月19日　1:32 PM</color>\nとある平日の休み時間、附属学園アーヤの教室にて。"},
        { "location": "461/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch02", "text": "【サヴォタージュ】"}
    ]
}
