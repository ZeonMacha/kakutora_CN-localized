    "entry":
    [
        { "location": "6503/SCENARIO", "narrator": "", "text": "偏頭痛メトロノーム"},
        { "location": "6530/TALK"    , "narrator": "神楽", "text": "チクタクチクタクチクタクと"},
        { "location": "6531/TALK"    , "narrator": "神楽", "text": "偏頭痛が時間を刻む"},
        { "location": "6533/SEL"     , "narrator": "", "text": "飲みすぎじゃない？"},
        { "location": "6534/SEL"     , "narrator": "", "text": "大丈夫？"},
        { "location": "6535/SEL"     , "narrator": "", "text": "代わってあげられたらいいのに"},
        { "location": "6536/ACT"     , "narrator": "", "text": "飲みすぎじゃない？"},
        { "location": "6537/TALK"    , "narrator": "神楽", "text": "ぴょんこは未成年ですし"},
        { "location": "6538/TALK"    , "narrator": "神楽", "text": "飲んだりなんてしません！！！"},
        { "location": "6539/ACT"     , "narrator": "", "text": "大丈夫？"},
        { "location": "6540/TALK"    , "narrator": "神楽", "text": "ＷＡＶＥできる程度には"},
        { "location": "6541/TALK"    , "narrator": "神楽", "text": "大丈夫ぴょん"},
        { "location": "6542/ACT"     , "narrator": "", "text": "代わってあげられたらいいのに"},
        { "location": "6544/TALK"    , "narrator": "神楽", "text": "そんなこと、、、"},
        { "location": "6546/TALK"    , "narrator": "神楽", "text": "してもらっちゃおうかな！？"},
        { "location": "6547/TALK"    , "narrator": "神楽", "text": "いたいのいたいのとんでけー"},
        { "location": "6548/TALK"    , "narrator": "神楽", "text": "$handlek$のところにとんでけー！！！"},
        { "location": "6551/TALK"    , "narrator": "神楽", "text": "、、、どうかな？？？"},
        { "location": "6553/TALK"    , "narrator": "神楽", "text": "こういうのって"},
        { "location": "6554/TALK"    , "narrator": "神楽", "text": "毎日のように出る人もいれば全然出ない人もいるぴょん"},
        { "location": "6555/TALK"    , "narrator": "神楽", "text": "不公平だなーって思うぴょん"},
        { "location": "6557/SEL"     , "narrator": "", "text": "お大事にね"},
        { "location": "6558/SEL"     , "narrator": "", "text": "$me$は出ないんだよね"},
        { "location": "6559/SEL"     , "narrator": "", "text": "頭なでなでしてあげる"},
        { "location": "6560/ACT"     , "narrator": "", "text": "お大事にね"},
        { "location": "6561/TALK"    , "narrator": "神楽", "text": "うん、、、"},
        { "location": "6563/TALK"    , "narrator": "神楽", "text": "今日は早く休むぴょん、、、"},
        { "location": "6564/ACT"     , "narrator": "", "text": "$me$は出ないんだよね"},
        { "location": "6565/TALK"    , "narrator": "神楽", "text": "あっそ"},
        { "location": "6566/TALK"    , "narrator": "神楽", "text": "自慢は聞きたくない！！！！"},
        { "location": "6567/TALK"    , "narrator": "神楽", "text": "さよなら！！！！"},
        { "location": "6568/ACT"     , "narrator": "", "text": "頭なでなでしてあげる"},
        { "location": "6570/TALK"    , "narrator": "神楽", "text": "グフフフフ"},
        { "location": "6571/TALK"    , "narrator": "神楽", "text": "少し収まった気がするぴょん"},
        { "location": "6573/TALK"    , "narrator": "神楽", "text": "$handlek$ったらやさしぃ、、、"},
        { "location": "6575/TALK"    , "narrator": "神楽", "text": "今日はいい夢が見れる気がするぴょん、、、"},
        { "location": "6576/TALK"    , "narrator": "神楽", "text": "おやすみなさい。"}
    ]
}
