{
    "dir": "chap29/daydra/dd_ch04_29_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "29405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "向かい合わせの鏡＜後編＞"
    },
    "entry":
    [
        { "location": "368/SCENARIO", "narrator": "", "text": "向かい合わせの鏡のように"},
        { "location": "383/TALK"    , "narrator": "みやび", "text": "ああ。\n考え違いをしとった。"},
        { "location": "385/TALK"    , "narrator": "みやび", "text": "今考えんといかんのは\nそういうことやない。"},
        { "location": "386/TALK"    , "narrator": "みやび", "text": "まずはこの世界の\n事実の把握をせんと。"},
        { "location": "388/TALK"    , "narrator": "真幌", "text": "みやび？"},
        { "location": "390/TALK"    , "narrator": "みやび", "text": "すみません。\nエリカさんの話を\n聞かせてください。"},
        { "location": "391/TALK"    , "narrator": "真幌", "text": "…元々はエリカも自分も\n管理庁のエージェントの\nようなものだった。"},
        { "location": "392/TALK"    , "narrator": "真幌", "text": "自分は情報統制担当、\nエリカは技術担当だ。"},
        { "location": "393/TALK"    , "narrator": "真幌", "text": "エリカは長官の右腕と\n言うべきポジションで\n仕事をしていた。"},
        { "location": "394/TALK"    , "narrator": "真幌", "text": "ところが突然\n管理庁から離れて\n付属大の教授になった。"},
        { "location": "395/TALK"    , "narrator": "真幌", "text": "驚いて理由を聞いたが\n教えてはもらえなかった。"},
        { "location": "396/TALK"    , "narrator": "真幌", "text": "そしてある日連絡が来た。"},
        { "location": "397/TALK"    , "narrator": "真幌", "text": "「長官の言う事には\n常に気をつけて。\n臭ったときには連絡を」"},
        { "location": "398/TALK"    , "narrator": "真幌", "text": "そう言い残してエリカは\n音信不通になった。"},
        { "location": "399/TALK"    , "narrator": "真幌", "text": "今回連絡をしてくるまで\n私も連絡が取れなかった。"},
        { "location": "400/TALK"    , "narrator": "真幌", "text": "だから私にも\nわからないことだらけ\nなんだ。"},
        { "location": "401/TALK"    , "narrator": "真幌", "text": "…すまないな。"},
        { "location": "402/TALK"    , "narrator": "みやび", "text": "…いえ。"},
        { "location": "403/SEL"     , "narrator": "", "text": "嘘かもよ"},
        { "location": "404/SEL"     , "narrator": "", "text": "これ以上は聞き出せないか"},
        { "location": "405/SEL"     , "narrator": "", "text": "あんまり進展しないね"},
        { "location": "406/ACT"     , "narrator": "", "text": "嘘かもよ"},
        { "location": "422/TALK"    , "narrator": "みやび", "text": "そうだとしても"},
        { "location": "423/TALK"    , "narrator": "みやび", "text": "これ以上は"},
        { "location": "424/TALK"    , "narrator": "みやび", "text": "聞けんろうね"},
        { "location": "426/ACT"     , "narrator": "", "text": "これ以上は聞き出せないか"},
        { "location": "442/TALK"    , "narrator": "みやび", "text": "確かにの"},
        { "location": "443/TALK"    , "narrator": "みやび", "text": "残念だが"},
        { "location": "445/ACT"     , "narrator": "", "text": "あんまり進展しないね"},
        { "location": "461/TALK"    , "narrator": "みやび", "text": "それはもう"},
        { "location": "462/TALK"    , "narrator": "みやび", "text": "仕方がないか"},
        { "location": "463/TALK"    , "narrator": "みやび", "text": "がっかりだ"},
        { "location": "477/TALK"    , "narrator": "みやび", "text": "大丈夫です。\n情報はこちらでも\n集めます。"},
        { "location": "479/TALK"    , "narrator": "みやび", "text": "音羽のことはともかく\nつばめちゃんのことや\n卯月のこともありますし。"},
        { "location": "480/TALK"    , "narrator": "真幌", "text": "頼む。"},
        { "location": "481/TALK"    , "narrator": "みやび", "text": "國政家のアンペア数が\nもう少しあれば\nもっとええんですけど…。"},
        { "location": "482/TALK"    , "narrator": "真幌", "text": "そういえば。"},
        { "location": "483/TALK"    , "narrator": "真幌", "text": "みやびとエリカは\n雰囲気が似ているな。"},
        { "location": "484/TALK"    , "narrator": "みやび", "text": "…本当ですか？"},
        { "location": "485/TALK"    , "narrator": "真幌", "text": "集中している時の\nオーラとかそういう\nところが。"},
        { "location": "486/TALK"    , "narrator": "真幌", "text": "研究者の情熱を\n感じるんだ。"},
        { "location": "488/TALK"    , "narrator": "みやび", "text": "おおお。"},
        { "location": "489/TALK"    , "narrator": "真幌", "text": "しかしエリカには\nサボり癖はないがな。"},
        { "location": "491/TALK"    , "narrator": "みやび", "text": "…やる時にやれれば\n十分やないですか。"},
        { "location": "492/TALK"    , "narrator": "真幌", "text": "いややっぱり\n似てないな。\n前言撤回。"},
        { "location": "494/TALK"    , "narrator": "みやび", "text": "えー！\nそこはもっとおだてて\nくださいよー。"},
        { "location": "495/TALK"    , "narrator": "真幌", "text": "あはははは。"},
        { "location": "506/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【MV EXE_MiYABi】"}
    ]
}
