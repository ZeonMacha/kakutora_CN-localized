        { "location": "343/TALK"    , "narrator": "つばめ", "text": "ぅぅん"},
        { "location": "344/TALK"    , "narrator": "つばめ", "text": "謝って欲しぃわけじゃなかったの"},
        { "location": "345/TALK"    , "narrator": "つばめ", "text": "$handle$さんと話したかっただけなの(*´︶`*)"},
