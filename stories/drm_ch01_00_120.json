        { "location": "281/TALK"    , "narrator": "つばめ", "text": "$handle$さんはゃさしぃね(●´ω｀●)ゞ"},
        { "location": "284/TALK"    , "narrator": "つばめ", "text": "ぅんとね・・・"},
        { "location": "285/TALK"    , "narrator": "つばめ", "text": "$handle$さんはみんなと話してる？"},
        { "location": "286/TALK"    , "narrator": "つばめ", "text": "最近"},
        { "location": "288/SEL"     , "narrator": "", "text": "話してる"},
