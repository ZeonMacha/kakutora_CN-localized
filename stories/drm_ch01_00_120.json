        { "location": "311/TALK"    , "narrator": "つばめ", "text": "えっとね"},
        { "location": "312/TALK"    , "narrator": "つばめ", "text": "ぁたしわね"},
        { "location": "313/TALK"    , "narrator": "つばめ", "text": "$handle$さんと話すのが楽しいし嬉しいんだ(*´︶`*)"},
        { "location": "314/TALK"    , "narrator": "つばめ", "text": "でもみんなゎちょっと違うみたいなの"},
        { "location": "317/SEL"     , "narrator": "", "text": "それが普通だよ"},
        { "location": "318/SEL"     , "narrator": "", "text": "そういうものだよ"},
