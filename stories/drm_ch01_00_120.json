        { "location": "336/ACT"     , "narrator": "", "text": "そっか"},
        { "location": "337/TALK"    , "narrator": "つばめ", "text": "あ"},
        { "location": "338/TALK"    , "narrator": "つばめ", "text": "ぁたしは$handle$さんのこと"},
        { "location": "339/TALK"    , "narrator": "つばめ", "text": "好きなんだよ？"},
