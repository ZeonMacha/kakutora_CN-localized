{
    "dir": "chap15/daydra/dd_ch04_15_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "15402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "適正な役割分担とは＜前編＞"
    },
    "entry":
    [
        { "location": "44/TALK"   , "narrator": "みやび", "text": "すまんね、光月さん。\n面倒くさいこと\n手伝わせてしもうて。"},
        { "location": "45/TALK"   , "narrator": "繭", "text": "いえ…簡単なシステム\nチェック程度しか\n手伝えなくて――"},
        { "location": "46/TALK"   , "narrator": "繭", "text": "逆にご迷惑になって\nいないか、心配です。"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "いやいや、まっこと\n助かっちゅうよ。"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "これは後でご褒美を\nやらんといかんなぁ。"},
        { "location": "51/TALK"   , "narrator": "繭", "text": "ご、ご褒美！？\nみやび先輩が、\n私に！？"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "うむ…ちゅうても、\n甘いもん奢る程度\nしかできんけんど。"},
        { "location": "53/TALK"   , "narrator": "繭", "text": "そんな、\n凄く嬉しいです。"},
        { "location": "54/TALK"   , "narrator": "繭", "text": "それだけでも\nこうして手伝った\n甲斐がありました。"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "そう言うてくれて\n助かるちや。"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "これがもし男の子\nやったとしたら――"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "チュウかナデナデは\nしてやらんといかん\nかったきね。"},
        { "location": "60/TALK"   , "narrator": "繭", "text": "は！？\nチュウかナデナデ！？"},
        { "location": "63/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "ん？　どうしたが？"},
        { "location": "68/TALK"   , "narrator": "繭", "text": "いえ…女ではなく\n男に生まれていれば、\nと悔やんでました。"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "そんなカワイイ\n外見に産んでくれた\n両親を恨んだら――"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "罰が当たるかも\nしれんぞね。"},
        { "location": "76/TALK"   , "narrator": "繭", "text": "フェノメノンアラート\nですか！？"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "ほれ、早速罰が\nあたりよった…。"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "もしもし、まほさん。\nフェノメノンですか？"},
        { "location": "83/TALK"   , "narrator": "透明真幌", "text": "ああ、まだ詳しい\n内部の情報は入って\nきてないが――"},
        { "location": "84/TALK"   , "narrator": "透明真幌", "text": "どうやら、今回は\nゲームの世界に\nなっているようだ。"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "ゲームの世界、\nですか？"},
        { "location": "86/TALK"   , "narrator": "透明真幌", "text": "うむ。\nスマホのアプリゲームが\n元となった世界らしい。"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "なるほどなぁ…。"},
        { "location": "90/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "92/TALK"   , "narrator": "透明真幌", "text": "情報が入り次第、\n詳しいデータを\n送る。"},
        { "location": "93/TALK"   , "narrator": "透明真幌", "text": "とにかく、\n今は早急に現場へ\n向かってほしい。"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "ラジャーです。\n至急現場に向かうが\nですよ。"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "…ちゅうわけやき、\nご褒美は次の機会に\n持ち越しやね。"},
        { "location": "101/TALK"  , "narrator": "繭", "text": "…フェノメノンが\n出たとあっては、\n仕方がありません。"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "すまんね。"},
        { "location": "104/TALK"  , "narrator": "繭", "text": "いえ…ですが、\nみやび先輩の\n腕の見せ所ですね。"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "？"},
        { "location": "106/TALK"  , "narrator": "繭", "text": "ご活躍を\n期待してます。"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "いや、\nちくっと待ちぃ。"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "うちの腕の見せ所\nっちゅうのは、\nどういう意味や？"},
        { "location": "110/TALK"  , "narrator": "繭", "text": "今回の戦闘は、\nアプリゲーム戦ですよね？"},
        { "location": "111/TALK"  , "narrator": "繭", "text": "ならば、ハッカーとしての\n腕の見せ所なのでは、\nと思ったのですが…。"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "そ、そうか！\nその手があった！"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "ゲームっちゅうことは、\nプログラムでできた\n世界っちゅうことや。"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "となると、\nプログラムの改変なんぞも\nできるはずやな。"},
        { "location": "120/TALK"  , "narrator": "繭", "text": "はい、そう思っての\n発言でしたが…、\n違ってましたか？"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "いや、光月さん。\nあんたえいところに\n気付いた。"},
        { "location": "122/TALK"  , "narrator": "繭", "text": "え、えっと…、\nお役に立てたの\nでしょうか？"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "まっこと役に――"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "ん？　いや、けんど\nちくっと待ちぃ…。"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "そうなると今回、\nうちはこっちに残って\n後方作業になるんか…。"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "…不安やな。"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "現場におると、\n状況変化が手に取る\nようにわかるし。"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "けんど、内部からは\n改変できん可能性も\nありよる…。"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "第一、うちはアーヤ達\nみたいなバリバリの\n戦闘系やない。"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "っちゅうことは、\nやはり残った方が\n得策やな。"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "それに、フェノメノン\nそのものの解析も、\n同時に進められるし。"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "やはり、残るのが得策か。\nうちにもみんなにも、\nその方がえいはずや。"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "…まあ、ハッキング\nできん可能性もなきにしは\nあらずやけんど。"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "それでも、何もできん\nことはないやろうし…。"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "はぁ…、\nどうしたもんかなぁ？"},
        { "location": "238/TALK"  , "narrator": "アーヤ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "259/TALK"  , "narrator": "アーヤ", "text": "いたっ！\nちょ、ちょっとなに！？"},
        { "location": "263/TALK"  , "narrator": "アーヤ", "text": "きゃあっ！！\nな、何やってるの！？"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "ふわあっ！\n突然触らないで！"},
        { "location": "274/TALK"  , "narrator": "アーヤ", "text": "もう！\nどういうことなの！？"},
        { "location": "277/SEL"   , "narrator": "", "text": "なんでアーヤがいるの！？"},
        { "location": "278/ACT"   , "narrator": "", "text": "なんでアーヤがいるの！？"},
        { "location": "280/TALK"  , "narrator": "アーヤ", "text": "ビックリしたでしょ？"},
        { "location": "281/TALK"  , "narrator": "アーヤ", "text": "ココロの中でもみんなと\n親睦を深めようと思って、\n回ってみることにしたの。"},
        { "location": "282/TALK"  , "narrator": "アーヤ", "text": "せっかく\n行き来できるように\nなったんだしね。"},
        { "location": "283/SEL"   , "narrator": "", "text": "ココロの中って行き来出来るの！？"},
        { "location": "284/ACT"   , "narrator": "", "text": "ココロの中って行き来出来るの！？"},
        { "location": "286/TALK"  , "narrator": "アーヤ", "text": "実は私も驚いてる。"},
        { "location": "287/TALK"  , "narrator": "アーヤ", "text": "いつの間にか、\n普通に行き来できるように\nなっていたのよね。"},
        { "location": "288/TALK"  , "narrator": "アーヤ", "text": "とはいっても、\n[ココロゲート]まで\nみたいだけど。"},
        { "location": "289/TALK"  , "narrator": "アーヤ", "text": "だから今回は、みんなの\n[ココロゲート]にお邪魔\nしようかと思ってる。"},
        { "location": "291/SEL"   , "narrator": "", "text": "なんか不思議な感じ"},
        { "location": "292/SEL"   , "narrator": "", "text": "なんか怖い"},
        { "location": "293/ACT"   , "narrator": "アーヤ", "text": "なんか不思議な感じ"},
        { "location": "295/ACT"   , "narrator": "アーヤ", "text": "なんか怖い"},
        { "location": "296/TALK"  , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "297/TALK"  , "narrator": "アーヤ", "text": "まあ確かに、他の人の\n心の中を侵蝕している\nようにも見えるけど。"},
        { "location": "298/TALK"  , "narrator": "アーヤ", "text": "でも、扉の外はパブリック\nスペースだから、\nプライバシーは守られる。"},
        { "location": "299/TALK"  , "narrator": "アーヤ", "text": "私も最初はちょっと\n怖かったけど、そんな感じ\nだから心配しないで。"},
        { "location": "301/TALK"  , "narrator": "アーヤ", "text": "それはそうと、いきなり\n触ってきたりして、\nどういうことなの？"},
        { "location": "303/SEL"   , "narrator": "", "text": "ごめん。みやびかと思って"},
        { "location": "304/SEL"   , "narrator": "", "text": "誤解です！単なる目覚ましです！"},
        { "location": "305/ACT"   , "narrator": "", "text": "ごめん。みやびかと思って"},
        { "location": "306/TALK"  , "narrator": "アーヤ", "text": "えっ……\nまさか、みやびとは\n毎回こんなことを……！"},
        { "location": "307/SEL"   , "narrator": "", "text": "バレちゃったか"},
        { "location": "308/ACT"   , "narrator": "", "text": "バレちゃったか"},
        { "location": "310/TALK"  , "narrator": "アーヤ", "text": "えええっ！\n不潔よ！\n$handle$さん！"},
        { "location": "311/ACT"   , "narrator": "", "text": "誤解です！単なる目覚ましです！"},
        { "location": "313/TALK"  , "narrator": "アーヤ", "text": "目覚まし…？\n意味が\n分からないんだけど。"},
        { "location": "315/TALK"  , "narrator": "アーヤ", "text": "それじゃ貴方は、\n彼女ができたら、起こす\nときは胸をさわるわけ？"},
        { "location": "316/SEL"   , "narrator": "", "text": "いや、まさか"},
        { "location": "317/SEL"   , "narrator": "", "text": "是非そうしたいと考えております"},
        { "location": "318/ACT"   , "narrator": "", "text": "いや、まさか"},
        { "location": "319/TALK"  , "narrator": "アーヤ", "text": "よかった。\n常識ある人で。"},
        { "location": "320/ACT"   , "narrator": "", "text": "是非そうしたいと考えております"},
        { "location": "321/TALK"  , "narrator": "アーヤ", "text": "はぁ。\n困った人。"},
        { "location": "324/TALK"  , "narrator": "アーヤ", "text": "それじゃ貴方は、\n彼女ができたら、起こす\nときはお腹をさわるわけ？"},
        { "location": "325/SEL"   , "narrator": "", "text": "いや、まさか"},
        { "location": "326/SEL"   , "narrator": "", "text": "是非そうしたいと考えております"},
        { "location": "327/ACT"   , "narrator": "", "text": "いや、まさか"},
        { "location": "328/TALK"  , "narrator": "アーヤ", "text": "よかった。\n常識ある人で。"},
        { "location": "329/ACT"   , "narrator": "", "text": "是非そうしたいと考えております"},
        { "location": "330/TALK"  , "narrator": "アーヤ", "text": "はぁ。\n困った人。"},
        { "location": "350/TALK"  , "narrator": "みやび", "text": "そんな\n誤解されるようなこと\n言わんといてや。"},
        { "location": "351/TALK"  , "narrator": "みやび", "text": "アーヤ、来るなら\n先に一報入れてからに\nしてくれんかね。"},
        { "location": "352/TALK"  , "narrator": "アーヤ", "text": "え？\n先にメッセージを送って\nおいたはずだけど？"},
        { "location": "354/TALK"  , "narrator": "みやび", "text": "いや、そんなことは…"},
        { "location": "356/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "358/TALK"  , "narrator": "みやび", "text": "確かに。"},
        { "location": "359/TALK"  , "narrator": "アーヤ", "text": "でしょ？"},
        { "location": "361/TALK"  , "narrator": "みやび", "text": "うちとしたことが、\n失敗したちや。"},
        { "location": "362/TALK"  , "narrator": "みやび", "text": "まさか、\nメッセージを見落とした\nことが原因で――"},
        { "location": "363/TALK"  , "narrator": "みやび", "text": "相棒との秘密の営みを、\n他のメンバーに\n取られてしまうとは！！"},
        { "location": "365/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "366/SEL"   , "narrator": "", "text": "え！？"},
        { "location": "367/ACT"   , "narrator": "", "text": "え！？"},
        { "location": "371/TALK"  , "narrator": "みやび", "text": "おぉ、\nこれが噂に聞くNT…"},
        { "location": "372/SEL"   , "narrator": "", "text": "違うから！みやびが一番誤解されること言ってるから！"},
        { "location": "373/SEL"   , "narrator": "", "text": "それ以上はやめてください！"},
        { "location": "374/ACT"   , "narrator": "", "text": "違うから！みやびが一番誤解されること言ってるから！"},
        { "location": "375/TALK"  , "narrator": "みやび", "text": "違ったか。\n今最高にエキサイティング\nやったのに。"},
        { "location": "376/ACT"   , "narrator": "", "text": "それ以上はやめてください！"},
        { "location": "377/TALK"  , "narrator": "みやび", "text": "ふむ。\n相棒がそう言うなら\nやめておくか。"},
        { "location": "379/TALK"  , "narrator": "アーヤ", "text": "で？　実際の所\n何をやってるのかしら？"},
        { "location": "380/TALK"  , "narrator": "アーヤ", "text": "ココロの風紀委員\nあやみとしては、看過\nできない状況なんだけど。"},
        { "location": "381/SEL"   , "narrator": "", "text": "いつから風紀委員に！？"},
        { "location": "382/SEL"   , "narrator": "", "text": "完全に誤解だから"},
        { "location": "383/ACT"   , "narrator": "", "text": "いつから風紀委員に！？"},
        { "location": "385/TALK"  , "narrator": "アーヤ", "text": "生まれたときから\nココロは風紀委員よ。"},
        { "location": "386/ACT"   , "narrator": "", "text": "完全に誤解だから"},
        { "location": "387/TALK"  , "narrator": "アーヤ", "text": "そうやって頑なに\n否定されると、ますます\nあやしいわよね。"},
        { "location": "390/TALK"  , "narrator": "みやび", "text": "いや、$handle$が\nゆうてることは\n正しいぞね。"},
        { "location": "391/TALK"  , "narrator": "みやび", "text": "うちがいつも\n寝ちゅうき、相棒が\n起こしてくれるちや。"},
        { "location": "392/TALK"  , "narrator": "みやび", "text": "その時に、頭や\n胸やお腹を叩いて\n起こしてくれるだけや。"},
        { "location": "393/SEL"   , "narrator": "", "text": "相変わらず全然フォローになってないですね"},
        { "location": "394/ACT"   , "narrator": "", "text": "相変わらず全然フォローになってないですね"},
        { "location": "397/TALK"  , "narrator": "アーヤ", "text": "ま、いいわ。\n他人のココロに介入\nするのはルール違反だし。"},
        { "location": "398/TALK"  , "narrator": "みやび", "text": "ところでアーヤ、今日は\nどうしたん？"},
        { "location": "399/TALK"  , "narrator": "みやび", "text": "お、もしや！\nココロの司書\n出張サービスかね？"},
        { "location": "401/TALK"  , "narrator": "みやび", "text": "やったら、後は任せた！\nついでに\n今後も全部任せちゃる！"},
        { "location": "402/TALK"  , "narrator": "アーヤ", "text": "違う違う！　違うから！\nちょっと親睦を深めに\n来ただけだから。"},
        { "location": "403/TALK"  , "narrator": "みやび", "text": "なんや、そういう事か。\nならとっとと仕事して\n二度寝の続きをするちや。"},
        { "location": "408/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n0x9F4番地から\n0x22C番地へ。"},
        { "location": "422/TALK"  , "narrator": "みやび", "text": "完了。"},
        { "location": "425/TALK"  , "narrator": "みやび", "text": "……。\nなるほど。"},
        { "location": "426/TALK"  , "narrator": "みやび", "text": "今回アーヤが\nここにいるのは\nどういう因果か。"},
        { "location": "428/TALK"  , "narrator": "アーヤ", "text": "なぁに、それ。\n嫌な予感しか\nしないんだけど。"},
        { "location": "430/TALK"  , "narrator": "みやび", "text": "いや、アーヤにとっては\nあまり不利益があるとは\n思えないけんど。"},
        { "location": "431/TALK"  , "narrator": "みやび", "text": "アーヤのリアクション\n次第で、うちのココロの\n方向性が変わりそうでな。"},
        { "location": "432/TALK"  , "narrator": "アーヤ", "text": "あー、\nそれは良くないわね。"},
        { "location": "433/TALK"  , "narrator": "アーヤ", "text": "なるべく何があっても\nリアクションしないように\nするから、続けて。"},
        { "location": "434/TALK"  , "narrator": "みやび", "text": "ふむ。\nそうしてもらえると\n有り難いではある。"},
        { "location": "436/TALK"  , "narrator": "みやび", "text": "では相棒。\n早速続ける事にしようか。"},
        { "location": "437/TALK"  , "narrator": "みやび", "text": "今回の問題はなぁ……"},
        { "location": "438/TALK"  , "narrator": "みやび", "text": "これから出動する\nフェノメノンに\nアーヤがつけていく――"},
        { "location": "439/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "440/TALK"  , "narrator": "みやび", "text": "下着の色が、黒か青かに\nよって、うちの生死が\n決まる状況なんよ。"},
        { "location": "442/TALK"  , "narrator": "アーヤ", "text": "は！？"},
        { "location": "443/SEL"   , "narrator": "", "text": "それは大変だ！　どっちか教えてください！"},
        { "location": "444/SEL"   , "narrator": "", "text": "黒希望！"},
        { "location": "445/SEL"   , "narrator": "", "text": "青希望！"},
        { "location": "446/SEL"   , "narrator": "", "text": "冗談はやめてください"},
        { "location": "447/ACT"   , "narrator": "", "text": "それは大変だ！　どっちか教えてください！"},
        { "location": "451/TALK"  , "narrator": "アーヤ", "text": "教えるわけないでしょ！"},
        { "location": "453/TALK"  , "narrator": "みやび", "text": "はて。\nリアクションしないんや\nなかったっけ？"},
        { "location": "455/ACT"   , "narrator": "", "text": "黒希望！"},
        { "location": "459/TALK"  , "narrator": "アーヤ", "text": "希望なんて\n聞かないわよ！"},
        { "location": "460/TALK"  , "narrator": "みやび", "text": "む。\n相棒は黒派か。\nうちと気が合うな。"},
        { "location": "463/TALK"  , "narrator": "アーヤ", "text": "何の話をしてるのよ。\nココロの中だといっても\n度が過ぎてるわよ？"},
        { "location": "465/TALK"  , "narrator": "みやび", "text": "相変わらず\n冗談が通じない人やね。"},
        { "location": "466/TALK"  , "narrator": "みやび", "text": "うちのリアクション含め\n全部冗談やよ。"},
        { "location": "467/TALK"  , "narrator": "みやび", "text": "とゆうか、\nリアクションしないんや\nなかったっけ？"},
        { "location": "468/ACT"   , "narrator": "", "text": "青希望！"},
        { "location": "472/TALK"  , "narrator": "アーヤ", "text": "希望なんて\n聞かないわよ！"},
        { "location": "473/TALK"  , "narrator": "みやび", "text": "む。\n相棒は青派か。\nうちとは気が合わんな。"},
        { "location": "474/TALK"  , "narrator": "みやび", "text": "うちは基本的に\n<size=20>R<129 && G<32 && B<180</size>\n限定やきね。"},
        { "location": "475/TALK"  , "narrator": "みやび", "text": "しかしあれやね、そろそろ\nアパレル業界も色指定を\nRGBで指定できるよう――"},
        { "location": "479/TALK"  , "narrator": "アーヤ", "text": "何の話をしてるのよ！\nココロの中だといっても\n度が過ぎてるわよ？"},
        { "location": "481/TALK"  , "narrator": "みやび", "text": "相変わらず\n冗談が通じない人やね。"},
        { "location": "482/TALK"  , "narrator": "みやび", "text": "うちのリアクション含め\n全部冗談やよ。"},
        { "location": "483/TALK"  , "narrator": "みやび", "text": "とゆうか、\nリアクションしないんや\nなかったっけ？"},
        { "location": "484/ACT"   , "narrator": "", "text": "冗談はやめてください"},
        { "location": "486/TALK"  , "narrator": "アーヤ", "text": "$handle$さんの\n言う通りよ！"},
        { "location": "487/TALK"  , "narrator": "みやび", "text": "ふむ。\n$handle$は冗談が\n通じんヤツやったか。"},
        { "location": "489/TALK"  , "narrator": "アーヤ", "text": "ありがと。\n助かったわ。"},
        { "location": "491/TALK"  , "narrator": "アーヤ", "text": "ココロの中だといっても\n度が過ぎてるのよ！"},
        { "location": "493/TALK"  , "narrator": "みやび", "text": "なるほど。\nそれはさておき、実際\n今日は何色なん？"},
        { "location": "494/TALK"  , "narrator": "アーヤ", "text": "教えるわけないでしょ！"},
        { "location": "495/TALK"  , "narrator": "みやび", "text": "はて。そういえば、\nリアクションしないんや\nなかったっけ？"},
        { "location": "498/TALK"  , "narrator": "アーヤ", "text": "わざとやってるでしょ！"},
        { "location": "499/TALK"  , "narrator": "みやび", "text": "うむ。\nバレちょったか。"},
        { "location": "500/TALK"  , "narrator": "アーヤ", "text": "それくらい\nわかるわよ…もう。"},
        { "location": "501/TALK"  , "narrator": "アーヤ", "text": "で？\n本当のところ何なの？\nそろそろ本題に入らない？"},
        { "location": "502/TALK"  , "narrator": "みやび", "text": "うむ。そうやね。\nひとしきり\nいじくり倒したことやし。"},
        { "location": "503/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "504/TALK"  , "narrator": "みやび", "text": "いやなに、\n今回のフェノメノンの\n出動のことやけんど…。"},
        { "location": "505/TALK"  , "narrator": "みやび", "text": "ちくっと特殊なヤツ\nみたいやき、劇場に残って\n任務に当たりたいんよ。"},
        { "location": "506/TALK"  , "narrator": "みやび", "text": "けんど、現場の人数が\n減ってまうし、皆に\n申し訳無いなと。"},
        { "location": "507/TALK"  , "narrator": "アーヤ", "text": "なるほど、\nそういうことなのね。"},
        { "location": "508/TALK"  , "narrator": "アーヤ", "text": "でも、ちゃんと\n理由があるんでしょ？"},
        { "location": "509/TALK"  , "narrator": "みやび", "text": "うむ。まほさん曰く、\n今回はゲームの世界や\nゆうき、あれよ。"},
        { "location": "510/TALK"  , "narrator": "みやび", "text": "裏からアタックを\n仕掛けた方が早いかな\n思うてな。"},
        { "location": "511/TALK"  , "narrator": "アーヤ", "text": "なるほどね。\n私はいいと思うわよ。"},
        { "location": "512/TALK"  , "narrator": "アーヤ", "text": "多分、現実の私も\n同じ答えを言うと思う。"},
        { "location": "513/TALK"  , "narrator": "みやび", "text": "そうゆうてくれると\n助かるぞね。"},
        { "location": "514/SEL"   , "narrator": "", "text": "わりとアッサリだったね"},
        { "location": "515/ACT"   , "narrator": "", "text": "わりとアッサリだったね"},
        { "location": "518/TALK"  , "narrator": "みやび", "text": "まあそれが解っちょったき\n先に遊び倒しておいたん\nやけんどな。"},
        { "location": "520/TALK"  , "narrator": "みやび", "text": "アーヤはうちが真面目に\n考えゆうときは、尊重\nしてくれるきね。"},
        { "location": "521/TALK"  , "narrator": "みやび", "text": "やき、実は結論については\n全然心配しちょらんかった\nちや。"},
        { "location": "522/TALK"  , "narrator": "アーヤ", "text": "みやびが何か提案してくる\n時って、必ず裏付けが\nあるもの。"},
        { "location": "523/TALK"  , "narrator": "アーヤ", "text": "そういうところは信頼して\nいるから、確かにだいたい\n意向を汲んでるわね。"},
        { "location": "524/TALK"  , "narrator": "アーヤ", "text": "でもそれなら、\nどうしてクランが出るほど\n迷ってるの？"},
        { "location": "525/TALK"  , "narrator": "みやび", "text": "まあ、あれやね。\nやっぱり戦力低下には\nなるき、悪いなと――"},
        { "location": "526/TALK"  , "narrator": "アーヤ", "text": "そんなこと\n気にしなくても大丈夫よ。"},
        { "location": "528/TALK"  , "narrator": "アーヤ", "text": "みやびが考えたことなら\nきっといい方向に行くって\n信じてるから。"},
        { "location": "529/TALK"  , "narrator": "みやび", "text": "助かるぞね。\nこれでクランも少しは\n弱体化したやもしれんし。"},
        { "location": "530/SEL"   , "narrator": "", "text": "意外なほど信頼しあってる！？"},
        { "location": "531/SEL"   , "narrator": "", "text": "内心繋がってると思ってたよ"},
        { "location": "532/ACT"   , "narrator": "", "text": "意外なほど信頼しあってる！？"},
        { "location": "534/TALK"  , "narrator": "みやび", "text": "なんぞ、まるでうちらが\n心の底まで険悪な関係やと\n思っちょったが？"},
        { "location": "537/TALK"  , "narrator": "アーヤ", "text": "イタズラの度が過ぎた時は\n本気で怒るけど、真面目な\n時は信頼してるのよ？"},
        { "location": "538/TALK"  , "narrator": "みやび", "text": "まあ、９割９分は\nイタズラの度が過ぎちゅう\nき、険悪にも見えるか。"},
        { "location": "539/TALK"  , "narrator": "アーヤ", "text": "自覚があるなら\n反省して。"},
        { "location": "540/TALK"  , "narrator": "みやび", "text": "そこを反省したら、\nうちという人間を全否定\nすることになるぞね。"},
        { "location": "542/TALK"  , "narrator": "アーヤ", "text": "ドヤ顔しながら\n言わないで…。"},
        { "location": "543/ACT"   , "narrator": "", "text": "内心繋がってると思ってたよ"},
        { "location": "545/TALK"  , "narrator": "みやび", "text": "ほう。\n相棒は鋭いな。後出し\nジャンケンでなければ。"},
        { "location": "546/TALK"  , "narrator": "アーヤ", "text": "そこは信用しましょ。\nずっと私たちを\n見てきてるんだし。"},
        { "location": "548/TALK"  , "narrator": "みやび", "text": "まあ確かに。\n$handle$やて\n人間やしな（暫定）。"},
        { "location": "549/TALK"  , "narrator": "アーヤ", "text": "またそういうことを…。"},
        { "location": "552/TALK"  , "narrator": "みやび", "text": "ま、何にしてもリーダーの\nお墨付きも貰ったき、\nサッとクランを倒すぞね。"},
        { "location": "554/TALK"  , "narrator": "アーヤ", "text": "私からもよろしくね、\n$handle$さん。"},
        { "location": "555/SEL"   , "narrator": "", "text": "二人のために一肌脱ぎますか"},
        { "location": "556/ACT"   , "narrator": "", "text": "二人のために一肌脱ぎますか"},
        { "location": "558/TALK"  , "narrator": "みやび", "text": "うむ。\n服は脱がんでも\nえいからな。"},
        { "location": "559/TALK"  , "narrator": "みやび", "text": "ほんだら、今回も\nよろしく頼むきね。"},
        { "location": "561/TALK"  , "narrator": "みやび", "text": "うちとアーヤと\n$handle$に、\nえいココロの旅を。"},
        { "location": "26/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月24日　5:12 PM</color>\nとある初夏の休日、神楽坂トライナリーバイト中のこと。"},
        { "location": "169/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "171/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "173/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "175/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "177/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
