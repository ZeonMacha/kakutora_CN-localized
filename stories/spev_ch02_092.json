    "dir": "chap00/daydra/spev_ch02_092.js",
    "type": "",
    "info": {
        "story_id": "91033",
        "cid": "",
        "title": "ぴょんこのサマー大作戦♪",
        "sub_title": "ぴょんこのサマー大作戦♪③【アーヤ編】"
    },
    "entry":
    [
        { "location": "20/DIALOG", "narrator": "", "text": "<color=green>7月20日　3:43 PM</color>\nとある平日、付属学園アーヤの教室にて"},
        { "location": "21/TALK"  , "narrator": "小夜", "text": "そういえば、アーヤ。\nこの前の講義\n出てなかったでしょ？"},
        { "location": "22/TALK"  , "narrator": "小夜", "text": "あの時取ったノート、\nコピーする？"},
        { "location": "24/TALK"  , "narrator": "アーヤ", "text": "助かるわ。\nちょうどお願いしようかと\n思ってたのよ。"},
        { "location": "25/TALK"  , "narrator": "小夜", "text": "だと思ったから、\n実はもうコピーして\nあるのよね。"},
        { "location": "26/TALK"  , "narrator": "アーヤ", "text": "さすが！\nランチ奢るわ"},
        { "location": "27/TALK"  , "narrator": "小夜", "text": "えー、そこまですること\nないってー。\nごちそうさまー。"},
        { "location": "28/TALK"  , "narrator": "アーヤ", "text": "それじゃ週末にでも…。"},
        { "location": "31/TALK"  , "narrator": "アーヤ", "text": "んっ？"},
        { "location": "32/TALK"  , "narrator": "小夜", "text": "どうしたの？"},
        { "location": "34/TALK"  , "narrator": "アーヤ", "text": "…気のせいかしら？\n視線を感じるんだけど…。"},
        { "location": "48/TALK"  , "narrator": "神楽", "text": "…思った通り。"},
        { "location": "49/TALK"  , "narrator": "神楽", "text": "アーヤさんと小夜さんは、\n見てるだけで色々と\nネタになりますね。"},
        { "location": "50/TALK"  , "narrator": "神楽", "text": "同人誌、ラノベにするのは\nやめて正解だったかも。"},
        { "location": "51/TALK"  , "narrator": "神楽", "text": "やっぱり、せっかく\n画像編集ソフトを\n入れたんですから…ふふ。"},
        { "location": "53/TALK"  , "narrator": "神楽", "text": "えーっと…講義のノートを\n貸してもらう、という\n展開だと、オチは…。"},
        { "location": "58/TALK"  , "narrator": "アーヤ", "text": "…卯月、さっきから\nコソコソなにしてるの？"},
        { "location": "61/TALK"  , "narrator": "神楽", "text": "はい。アーヤさんを\n観察することで\n創作のネタを…。"},
        { "location": "63/TALK"  , "narrator": "神楽", "text": "え？"},
        { "location": "65/TALK"  , "narrator": "アーヤ", "text": "ソウサク？"},
        { "location": "67/TALK"  , "narrator": "神楽", "text": "あ、アーヤさん！？"},
        { "location": "69/TALK"  , "narrator": "アーヤ", "text": "大学まで来て、\nなにやってるの？"},
        { "location": "71/TALK"  , "narrator": "神楽", "text": "えっ！？\nそ、それは、えっと…。"},
        { "location": "74/TALK"  , "narrator": "小夜", "text": "ソウサクがどうのこうの\n言ってたみたいだけど？"},
        { "location": "76/TALK"  , "narrator": "神楽", "text": "そ、ソウサク！\nそうなんです！！"},
        { "location": "77/TALK"  , "narrator": "神楽", "text": "アーヤさんのことを、\nずっと捜索してたん\nですよ。"},
        { "location": "78/TALK"  , "narrator": "アーヤ", "text": "ＷＡＶＥで連絡くれれば\nよかったのに。"},
        { "location": "79/TALK"  , "narrator": "神楽", "text": "そ、そうですよね…。"},
        { "location": "80/TALK"  , "narrator": "小夜", "text": "あはは、神楽ちゃんって\n意外とうっかり屋さん\nなのね。"},
        { "location": "82/TALK"  , "narrator": "神楽", "text": "あはは…。"},
        { "location": "83/TALK"  , "narrator": "アーヤ", "text": "っていうか、\n用事があるなら\nどうして隠れてたの？"},
        { "location": "84/TALK"  , "narrator": "神楽", "text": "そ、それは…小夜さんと\nお話し中だったので、\nお邪魔になるかと…。"},
        { "location": "85/TALK"  , "narrator": "小夜", "text": "邪魔なんて思わないって。\n神楽ちゃん、気にし過ぎ。"},
        { "location": "86/TALK"  , "narrator": "アーヤ", "text": "そうよ。\n大したこと話してた\nわけじゃないんだし。"},
        { "location": "88/TALK"  , "narrator": "小夜", "text": "ちょ、それ酷くない！？"},
        { "location": "92/TALK"  , "narrator": "アーヤ", "text": "ふふっ、冗談よ。"},
        { "location": "93/TALK"  , "narrator": "神楽", "text": "…お二人とも、\n本当に仲がいいんですね。"},
        { "location": "95/TALK"  , "narrator": "小夜", "text": "そう？\n普通じゃない？"},
        { "location": "98/TALK"  , "narrator": "アーヤ", "text": "普通だと思うけど？"},
        { "location": "99/TALK"  , "narrator": "神楽", "text": "そうですか？\nとっても仲がいいように\n見えますけど…。"},
        { "location": "100/TALK" , "narrator": "神楽", "text": "そういえば、この前\nガブちゃんもヤキモチ\n焼いてました。"},
        { "location": "101/TALK" , "narrator": "神楽", "text": "アーヤさんは大学の\nお友達とばっかり\n一緒にいる、って。"},
        { "location": "103/TALK" , "narrator": "アーヤ", "text": "ギャヴィがヤキモチ？\nまさか。"},
        { "location": "104/TALK" , "narrator": "小夜", "text": "あはは。\nガブリエラちゃん、\n相変わらずかわいいなぁ。"},
        { "location": "106/TALK" , "narrator": "小夜", "text": "私と話すのもいいけど、\nあんまし寂しがらせるのは\nよくないわよ？"},
        { "location": "109/TALK" , "narrator": "アーヤ", "text": "なに言ってるの。\nギャヴィとは\n毎日顔合わせてるのよ？"},
        { "location": "110/TALK" , "narrator": "小夜", "text": "そういうんじゃなくて、\nうーん…なんていえば\nいいのかなぁ…？"},
        { "location": "111/TALK" , "narrator": "神楽", "text": "お姉ちゃん大好きな妹が\n抱く感情、みたいなもの\nでしょうか？"},
        { "location": "113/TALK" , "narrator": "アーヤ", "text": "は？"},
        { "location": "115/TALK" , "narrator": "神楽", "text": "えっと、お姉ちゃんには\nとっても仲のいい友達が\nいたとします。"},
        { "location": "116/TALK" , "narrator": "神楽", "text": "すると、妹はお姉ちゃんを\n取られたと思い、不機嫌に\nなっちゃうんです。"},
        { "location": "118/TALK" , "narrator": "小夜", "text": "あ、それわかる！\n私の友達の妹が\nまさにそれだったわ。"},
        { "location": "119/TALK" , "narrator": "アーヤ", "text": "それをギャヴィが？\nどうにも信じられないわ。"},
        { "location": "120/TALK" , "narrator": "神楽", "text": "確かに、ガブちゃんとは\n毎日話してるかも\nしれませんけど。"},
        { "location": "121/TALK" , "narrator": "神楽", "text": "小夜さんと話すみたいに、\n対等の立場で話したりは\nしないでしょう？"},
        { "location": "123/TALK" , "narrator": "小夜", "text": "あ～、そりゃ当然だよ。"},
        { "location": "124/TALK" , "narrator": "小夜", "text": "アーヤって年下の前だと、\nいっつもいいかっこしか\n見せようとしないし。"},
        { "location": "127/TALK" , "narrator": "アーヤ", "text": "ちょ、小夜！\nそんなことないでしょ？"},
        { "location": "129/TALK" , "narrator": "小夜", "text": "いや、あるから\n神楽ちゃんだって\nこう言ってるんじゃん。"},
        { "location": "130/TALK" , "narrator": "神楽", "text": "なるほど…。\nアーヤさんは普段から、\nかっこつけていた、と。"},
        { "location": "131/TALK" , "narrator": "アーヤ", "text": "つけてません！"},
        { "location": "134/TALK" , "narrator": "アーヤ", "text": "でも、年長者として\nみんなと同じってわけには\nいかないでしょ？"},
        { "location": "135/TALK" , "narrator": "アーヤ", "text": "だから、年長者らしく\n振る舞おうとはしてるけど\nかっこつけてはいないわ。"},
        { "location": "136/TALK" , "narrator": "神楽", "text": "…なるほど。\nガブちゃんがヤキモチを\n焼くのもわかりますね。"},
        { "location": "137/TALK" , "narrator": "神楽", "text": "小夜さんは、アーヤさんが\n普通の大学生でいられる\n相手みたいですし。"},
        { "location": "139/TALK" , "narrator": "神楽", "text": "…でも、ちょっと\n引っかかるところも\nありますけど。"},
        { "location": "142/TALK" , "narrator": "アーヤ", "text": "引っかかる？"},
        { "location": "143/TALK" , "narrator": "神楽", "text": "はい…お二人のことを\n見ていると、友達って\nいうよりは。"},
        { "location": "144/TALK" , "narrator": "神楽", "text": "なにか、もっと違う\n関係があるようにも\n感じるんです。"},
        { "location": "146/TALK" , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "147/TALK" , "narrator": "神楽", "text": "もしかしてガブちゃん、\nそれに対してヤキモチを\n焼いているのかも…。"},
        { "location": "149/TALK" , "narrator": "小夜", "text": "ああ、もしかしてそれ、\nにんぎょ――"},
        { "location": "151/TALK" , "narrator": "アーヤ", "text": "なにもないから！\n神楽の勘違いよ！"},
        { "location": "153/TALK" , "narrator": "小夜", "text": "…アーヤ、ちょっと。"},
        { "location": "158/TALK" , "narrator": "アーヤ", "text": "え！？\nちょっと、どうしたの？"},
        { "location": "164/TALK" , "narrator": "小夜", "text": "…もしかして、アーヤ。\nサークルのこと\nまだみんなに内緒なの？"},
        { "location": "166/TALK" , "narrator": "アーヤ", "text": "そういうこと。\nだから小夜も\n話し合わせて！"},
        { "location": "167/TALK" , "narrator": "小夜", "text": "はいはい…まったく、\n世話焼けるんだから…。"},
        { "location": "173/TALK" , "narrator": "神楽", "text": "アーヤさんの慌てようと、\n小夜さんとのヒソヒソ話。"},
        { "location": "174/TALK" , "narrator": "神楽", "text": "やっぱり、この二人には\nなにか特別な関係性が\nあるのは間違いない！"},
        { "location": "182/TALK" , "narrator": "小夜", "text": "ごめんね、\nちょっと急な\n連絡事項があって。"},
        { "location": "184/TALK" , "narrator": "神楽", "text": "全然お気に\nなさらないでください！"},
        { "location": "185/TALK" , "narrator": "神楽", "text": "アーヤさんが\n小夜さんとラブラブなのは\nよくわかりましたから！"},
        { "location": "188/TALK" , "narrator": "アーヤ", "text": "は！？"},
        { "location": "189/TALK" , "narrator": "神楽", "text": "でも、ガブちゃんのことも\n気にかけてあげないと、\nフラれちゃいますよ？"},
        { "location": "192/TALK" , "narrator": "小夜", "text": "あ～、ラブラブなの\nバレちゃったねー。"},
        { "location": "196/TALK" , "narrator": "アーヤ", "text": "ちょ、小夜！！\nなに言ってんのよ！？"},
        { "location": "197/TALK" , "narrator": "小夜", "text": "いや、話し合わせろって\n言われたから…。"},
        { "location": "199/TALK" , "narrator": "アーヤ", "text": "卯月に合わせて\nどうするのよ…。"},
        { "location": "201/TALK" , "narrator": "神楽", "text": "えっ？　えっ！？\nまさか、本当にそういう\n関係なんですか！？"},
        { "location": "203/TALK" , "narrator": "アーヤ", "text": "ああもう…どうしてこう\n面倒なことになるかな…。"},
        { "location": "204/SEL"  , "narrator": "（選択肢）", "text": "その通りだって認めちゃえば？"},
        { "location": "205/SEL"  , "narrator": "（選択肢）", "text": "神楽に観察されてるよ"},
        { "location": "206/SEL"  , "narrator": "（選択肢）", "text": "禁断の三角関係クルー！？"},
        { "location": "207/ACT"  , "narrator": "", "text": "その通りだって認めちゃえば？"},
        { "location": "224/TALK" , "narrator": "アーヤ", "text": "そんなことしたら"},
        { "location": "225/TALK" , "narrator": "アーヤ", "text": "余計面倒なことになるから"},
        { "location": "226/TALK" , "narrator": "アーヤ", "text": "第一"},
        { "location": "227/TALK" , "narrator": "アーヤ", "text": "そんな勘違い"},
        { "location": "228/TALK" , "narrator": "アーヤ", "text": "嬉しくないし"},
        { "location": "229/TALK" , "narrator": "アーヤ", "text": "大体"},
        { "location": "230/TALK" , "narrator": "アーヤ", "text": "そうじゃないって"},
        { "location": "231/TALK" , "narrator": "アーヤ", "text": "知ってるでしょ？"},
        { "location": "239/TALK" , "narrator": "アーヤ", "text": "…まったく。\nこんなの見られたら\n更に誤解されて…。"},
        { "location": "240/TALK" , "narrator": "神楽", "text": "$handle$さんから\nなにか言われたんですか？"},
        { "location": "242/TALK" , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "243/TALK" , "narrator": "小夜", "text": "$handle$って、\n確かBotだっけ？"},
        { "location": "245/TALK" , "narrator": "アーヤ", "text": "あ、えっと…。"},
        { "location": "247/TALK" , "narrator": "小夜", "text": "なになに…。\n『その通りだって\n　認めちゃえば…？』"},
        { "location": "248/TALK" , "narrator": "神楽", "text": "や、やっぱり！"},
        { "location": "249/TALK" , "narrator": "アーヤ", "text": "いや、違うから！\nこれは$handle$が\n勝手に言ってるだけ。"},
        { "location": "252/TALK" , "narrator": "アーヤ", "text": "私と小夜は、\n本当にただの友達って\nだけだから。"},
        { "location": "254/TALK" , "narrator": "小夜", "text": "そうそう。\n同じ趣味の同志でも\nあるけどね。"},
        { "location": "255/TALK" , "narrator": "神楽", "text": "趣味？"},
        { "location": "258/TALK" , "narrator": "アーヤ", "text": "ちょ、小夜！"},
        { "location": "260/TALK" , "narrator": "小夜", "text": "えっ！？\n今のもダメなの？"},
        { "location": "262/TALK" , "narrator": "神楽", "text": "なるほど…。\n友人であり、同じ趣味を\n共有する同志…。"},
        { "location": "264/TALK" , "narrator": "神楽", "text": "私達には言えない、\n秘密の趣味を大学の\nお友達と共有する。"},
        { "location": "265/TALK" , "narrator": "神楽", "text": "仲間達には見せられない、\nしっかり者のリーダーの\n知られざる趣味とは！？"},
        { "location": "267/TALK" , "narrator": "神楽", "text": "これは、なにかネタに\n使えるかもしれません！"},
        { "location": "271/TALK" , "narrator": "アーヤ", "text": "あのね、卯月。\n今小夜が言ったことは\n気にしないで――"},
        { "location": "273/TALK" , "narrator": "神楽", "text": "大丈夫です！"},
        { "location": "274/TALK" , "narrator": "神楽", "text": "もうこれ以上、\n私はなにも\nお尋ねしませんから。"},
        { "location": "275/TALK" , "narrator": "アーヤ", "text": "えっ？"},
        { "location": "276/TALK" , "narrator": "神楽", "text": "ありがとうございました。\nそれじゃ、また劇場で。"},
        { "location": "277/TALK" , "narrator": "アーヤ", "text": "あ、ちょっと卯月。\n用事はなんだったの？"},
        { "location": "279/TALK" , "narrator": "神楽", "text": "大丈夫です。\nもう解決しましたから！"},
        { "location": "285/TALK" , "narrator": "アーヤ", "text": "…な、なんだったの？"},
        { "location": "287/TALK" , "narrator": "小夜", "text": "さあ…でも楽しかったし、\nそれでいいんじゃない？"},
        { "location": "288/ACT"  , "narrator": "", "text": "神楽に観察されてるよ"},
        { "location": "305/TALK" , "narrator": "アーヤ", "text": "そうみたい"},
        { "location": "306/TALK" , "narrator": "アーヤ", "text": "サークルのこととか"},
        { "location": "307/TALK" , "narrator": "アーヤ", "text": "色々知られちゃうかも"},
        { "location": "309/SEL"  , "narrator": "（選択肢）", "text": "反応を見てるだけだと思う"},
        { "location": "310/ACT"  , "narrator": "", "text": "反応を見てるだけだと思う"},
        { "location": "312/TALK" , "narrator": "アーヤ", "text": "どういうこと？"},
        { "location": "314/SEL"  , "narrator": "（選択肢）", "text": "試しに聞いてみれば？"},
        { "location": "315/ACT"  , "narrator": "", "text": "試しに聞いてみれば？"},
        { "location": "317/TALK" , "narrator": "アーヤ", "text": "よくわからないけど"},
        { "location": "318/TALK" , "narrator": "アーヤ", "text": "まあ"},
        { "location": "319/TALK" , "narrator": "アーヤ", "text": "話の方向変えられるかもしれないし"},
        { "location": "320/TALK" , "narrator": "アーヤ", "text": "聞いてみる"},
        { "location": "333/TALK" , "narrator": "アーヤ", "text": "…ねえ、卯月。\n私からも聞きたいこと\nあるんだけど。"},
        { "location": "334/TALK" , "narrator": "神楽", "text": "はい、なんですか？"},
        { "location": "335/TALK" , "narrator": "アーヤ", "text": "もしかして…、\n私のこと、さっきから\n観察してた？"},
        { "location": "336/TALK" , "narrator": "神楽", "text": "っ！？"},
        { "location": "340/TALK" , "narrator": "神楽", "text": "え…、えっ？\nな、なんのことでしょう？"},
        { "location": "342/TALK" , "narrator": "小夜", "text": "か、神楽ちゃん。\nさすがにその反応、\nあからさま過ぎだよ？"},
        { "location": "343/TALK" , "narrator": "アーヤ", "text": "やっぱり。\nなにか企んでるんじゃ\nないでしょうね？"},
        { "location": "346/TALK" , "narrator": "神楽", "text": "ま、まさか！\n私はただ、ちょっと\nネタがほしいと思って…。"},
        { "location": "347/TALK" , "narrator": "アーヤ", "text": "ネタ？"},
        { "location": "348/TALK" , "narrator": "神楽", "text": "あっ！"},
        { "location": "349/TALK" , "narrator": "神楽", "text": "ち、違うんです！\nネタっていうか、\nきっかけっていうか…。"},
        { "location": "350/TALK" , "narrator": "神楽", "text": "とにかく、いい刺激は\nいただけました！\nそれじゃあ、また劇場で！"},
        { "location": "357/TALK" , "narrator": "アーヤ", "text": "あ、卯月、待ちなさい！"},
        { "location": "359/TALK" , "narrator": "小夜", "text": "…行っちゃった。\n結局、なんの用事で\n来たのかしら？"},
        { "location": "361/TALK" , "narrator": "アーヤ", "text": "わからないけど、\nロクなことじゃないのは\n確かみたいね。"},
        { "location": "362/ACT"  , "narrator": "", "text": "禁断の三角関係クルー！？"},
        { "location": "379/TALK" , "narrator": "アーヤ", "text": "来ません！"},
        { "location": "380/TALK" , "narrator": "アーヤ", "text": "そういう関係じゃないの"},
        { "location": "381/TALK" , "narrator": "アーヤ", "text": "わかってるでしょ？"},
        { "location": "383/SEL"  , "narrator": "（選択肢）", "text": "もしかしたらってことも…"},
        { "location": "384/SEL"  , "narrator": "（選択肢）", "text": "$me$も話に合わせてみた"},
        { "location": "385/ACT"  , "narrator": "", "text": "もしかしたらってことも…"},
        { "location": "386/TALK" , "narrator": "アーヤ", "text": "絶対ないから"},
        { "location": "387/TALK" , "narrator": "アーヤ", "text": "そもそも"},
        { "location": "388/TALK" , "narrator": "アーヤ", "text": "ギャヴィは仲間で"},
        { "location": "389/TALK" , "narrator": "アーヤ", "text": "小夜は友達"},
        { "location": "390/TALK" , "narrator": "アーヤ", "text": "大切だけど"},
        { "location": "391/TALK" , "narrator": "アーヤ", "text": "そう言うのと違うから"},
        { "location": "392/ACT"  , "narrator": "", "text": "$me$も話に合わせてみた"},
        { "location": "393/TALK" , "narrator": "アーヤ", "text": "$handle$と小夜"},
        { "location": "394/TALK" , "narrator": "アーヤ", "text": "気が合いそうね"},
        { "location": "395/TALK" , "narrator": "アーヤ", "text": "でも"},
        { "location": "396/TALK" , "narrator": "アーヤ", "text": "お願いだから"},
        { "location": "397/TALK" , "narrator": "アーヤ", "text": "私の方に合わせて"},
        { "location": "411/TALK" , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "412/TALK" , "narrator": "神楽", "text": "あれ？\nアーヤさん、\n大丈夫ですか？"},
        { "location": "415/TALK" , "narrator": "アーヤ", "text": "ええ…ちょっと、\nこの会話のノリに\n疲れただけだから…。"},
        { "location": "418/TALK" , "narrator": "小夜", "text": "う～ん、アーヤには\nちょっと苦手なノリ\nだったかしら？"},
        { "location": "419/TALK" , "narrator": "小夜", "text": "次の講義まではまだ\n時間あるし、ちょっと\n食堂で休みましょ。"},
        { "location": "422/TALK" , "narrator": "アーヤ", "text": "そうね…。\nちょっと冷たいものでも\n飲みたいわ。"},
        { "location": "423/TALK" , "narrator": "小夜", "text": "疲れてるってことは、\nアイスミルクティー？"},
        { "location": "424/TALK" , "narrator": "アーヤ", "text": "そうね。"},
        { "location": "425/TALK" , "narrator": "神楽", "text": "つ、疲れてるアーヤさんを\n見ただけで、そんなことが\nわかるなんて…。"},
        { "location": "427/TALK" , "narrator": "神楽", "text": "ガブちゃんに最強の\nライバル現る！"},
        { "location": "428/TALK" , "narrator": "神楽", "text": "そう、恋のライバル。\nこれ、もしかしたら\nネタになるかも…。"},
        { "location": "430/TALK" , "narrator": "アーヤ", "text": "…そういえば、\n私に用事があったんじゃ\nなかった？"},
        { "location": "432/TALK" , "narrator": "神楽", "text": "あ、大丈夫です。\nたった今、最高のものを\nもらったので。"},
        { "location": "434/TALK" , "narrator": "神楽", "text": "それじゃあ、失礼します。"},
        { "location": "441/TALK" , "narrator": "小夜", "text": "…アーヤ、神楽ちゃんに\nなにかあげたの？"},
