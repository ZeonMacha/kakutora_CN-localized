        { "location": "618/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "620/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "622/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "628/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "630/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "632/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "635/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "636/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "638/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "639/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "641/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "642/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "645/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "646/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "656/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "657/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "658/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "660/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "661/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "662/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "665/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "666/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "668/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "671/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "672/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "674/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "675/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "676/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "683/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "684/TALK", "narrator": "神楽", "text": "ありえネー"}
