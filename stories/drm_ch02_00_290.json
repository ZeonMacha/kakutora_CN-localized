    [
        { "location": "146/SCENARIO", "narrator": "", "text": "210_聞いていい？"},
        { "location": "171/TALK"    , "narrator": "アーヤ", "text": "$handle$さんって"},
        { "location": "172/TALK"    , "narrator": "アーヤ", "text": "実在してるのよね"},
        { "location": "174/SEL"     , "narrator": "", "text": "生きてる"},
        { "location": "175/SEL"     , "narrator": "", "text": "別の次元にいる"},
        { "location": "176/SEL"     , "narrator": "", "text": "どうなのかなー"},
        { "location": "177/ACT"     , "narrator": "", "text": "生きてる"},
        { "location": "178/TALK"    , "narrator": "アーヤ", "text": "うん"},
        { "location": "179/TALK"    , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "180/ACT"     , "narrator": "", "text": "別の次元にいる"},
        { "location": "181/TALK"    , "narrator": "アーヤ", "text": "次元の問題"},
        { "location": "182/TALK"    , "narrator": "アーヤ", "text": "むつかしいわー"},
        { "location": "183/ACT"     , "narrator": "", "text": "どうなのかなー"},
        { "location": "184/TALK"    , "narrator": "アーヤ", "text": "え"},
        { "location": "185/TALK"    , "narrator": "アーヤ", "text": "脅かさないで"},
        { "location": "187/TALK"    , "narrator": "アーヤ", "text": "なんかちゃんと聞いたことなかったけど"},
        { "location": "188/TALK"    , "narrator": "アーヤ", "text": "何をしている人なの（￣ー￣？）"},
        { "location": "190/SEL"     , "narrator": "", "text": "学生"},
        { "location": "191/SEL"     , "narrator": "", "text": "プー"},
        { "location": "192/SEL"     , "narrator": "", "text": "社会人"},
        { "location": "193/ACT"     , "narrator": "", "text": "学生"},
        { "location": "194/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "195/TALK"    , "narrator": "アーヤ", "text": "そうなのね"},
        { "location": "196/TALK"    , "narrator": "アーヤ", "text": "私と同じね＼(^O^)／"},
        { "location": "198/TALK"    , "narrator": "アーヤ", "text": "へー"},
        { "location": "199/ACT"     , "narrator": "", "text": "プー"},
        { "location": "200/TALK"    , "narrator": "アーヤ", "text": "もしかしてクマ？"},
        { "location": "202/TALK"    , "narrator": "アーヤ", "text": "ってことじゃないわよね(;^_^A"},
        { "location": "203/ACT"     , "narrator": "", "text": "社会人"},
        { "location": "204/TALK"    , "narrator": "アーヤ", "text": "そうなのね"},
        { "location": "205/TALK"    , "narrator": "アーヤ", "text": "ちょっと大人の人なのね"},
        { "location": "206/TALK"    , "narrator": "アーヤ", "text": "へー"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "そっか＼(^O^)／"},
        { "location": "210/TALK"    , "narrator": "アーヤ", "text": "特になんてこともないんだけど"},
        { "location": "211/TALK"    , "narrator": "アーヤ", "text": "ちょっと気になったから"},
        { "location": "213/SEL"     , "narrator": "", "text": "2人の秘密だからね"},
        { "location": "214/SEL"     , "narrator": "", "text": "そういうもの？"},
        { "location": "215/ACT"     , "narrator": "", "text": "2人の秘密だからね"},
        { "location": "225/TALK"    , "narrator": "アーヤ", "text": "あら♪"},
        { "location": "226/TALK"    , "narrator": "アーヤ", "text": "二人の秘密なんて"},
        { "location": "227/TALK"    , "narrator": "アーヤ", "text": "ちょっといい響き"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "わかったわ"},
        { "location": "229/TALK"    , "narrator": "アーヤ", "text": "他の子には"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "内緒にしておくわね(^ε^)―☆!!"},
        { "location": "231/TALK"    , "narrator": "アーヤ", "text": "あと"},
        { "location": "234/TALK"    , "narrator": "ボイスメール", "text": "平行世界の世界線"},
        { "location": "252/TALK"    , "narrator": "アーヤ", "text": "これも秘密ね♪"},
        { "location": "253/ACT"     , "narrator": "", "text": "そういうもの？"},
        { "location": "254/TALK"    , "narrator": "アーヤ", "text": "んー"},
        { "location": "255/TALK"    , "narrator": "アーヤ", "text": "そういうものよ"},
        { "location": "221/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>600pt.</b></color></size>\nアップしました！"},
        { "location": "246/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【平行世界の世界線】</color>\nをゲットしました！"}
