        "title": "らぶとーく 第61話",
        "sub_title": "おとぎ話の結末は"
    },
    "entry":
    [
        { "location": "1405/SCENARIO", "narrator": "", "text": "おとぎ話の結末は"},
        { "location": "1430/TALK"    , "narrator": "神楽", "text": "嘘つきは泥棒の始まりって言うけど"},
        { "location": "1431/TALK"    , "narrator": "神楽", "text": "詐欺師じゃないのってぴょんこは思う"},
        { "location": "1432/TALK"    , "narrator": "神楽", "text": "嘘つきなんだから"},
        { "location": "1434/SEL"     , "narrator": "", "text": "一理ある"},
        { "location": "1435/SEL"     , "narrator": "", "text": "悪いことをするなって意味だよ"},
        { "location": "1436/SEL"     , "narrator": "", "text": "$me$はどっちでもないけど"},
        { "location": "1437/ACT"     , "narrator": "", "text": "一理ある"},
        { "location": "1438/TALK"    , "narrator": "神楽", "text": "でしょー"},
        { "location": "1440/TALK"    , "narrator": "神楽", "text": "洞察力に優れたぴょんこ♪"},
        { "location": "1441/ACT"     , "narrator": "", "text": "悪いことをするなって意味だよ"},
        { "location": "1442/TALK"    , "narrator": "神楽", "text": "まーねー"},
        { "location": "1443/TALK"    , "narrator": "神楽", "text": "$handle$は正解が望まれた答えとは限らないって知るべき"},
        { "location": "1444/ACT"     , "narrator": "", "text": "$me$はどっちでもないけど"},
        { "location": "1445/TALK"    , "narrator": "神楽", "text": "ふうん？"},
        { "location": "1447/TALK"    , "narrator": "神楽", "text": "で"},
        { "location": "1448/TALK"    , "narrator": "神楽", "text": "ぴょんこは稀代の詐欺師になれると思ってる"},
        { "location": "1450/SEL"     , "narrator": "", "text": "自分から言う人は無理じゃない？"},
        { "location": "1451/SEL"     , "narrator": "", "text": "$me$は神楽に騙されまくり"},
        { "location": "1452/SEL"     , "narrator": "", "text": "ならない方がいいんじゃないかなー"},
        { "location": "1453/ACT"     , "narrator": "", "text": "自分から言う人は無理じゃない？"},
        { "location": "1454/TALK"    , "narrator": "神楽", "text": "確かにそうかも"},
        { "location": "1455/ACT"     , "narrator": "", "text": "$me$は神楽に騙されまくり"},
        { "location": "1456/TALK"    , "narrator": "神楽", "text": "そんなことないでしょ"},
        { "location": "1457/TALK"    , "narrator": "神楽", "text": "それは$handle$に騙されたいって欲望があるから♪"},
        { "location": "1458/TALK"    , "narrator": "神楽", "text": "ぴょんこはその欲望に応えてるだけぴょん"},
        { "location": "1459/ACT"     , "narrator": "", "text": "ならない方がいいんじゃないかなー"},
        { "location": "1460/TALK"    , "narrator": "神楽", "text": "まーね"},
        { "location": "1461/TALK"    , "narrator": "神楽", "text": "正論"},
        { "location": "1463/TALK"    , "narrator": "神楽", "text": "なんて"},
        { "location": "1464/TALK"    , "narrator": "神楽", "text": "そう思わないとやってけないって"},
        { "location": "1465/TALK"    , "narrator": "神楽", "text": "この話題も何回目だろ～ねもう！！！"},
        { "location": "1469/TALK"    , "narrator": "神楽", "text": "同じところで足踏みしてるみたいでもやもやする"},
        { "location": "1472/SEL"     , "narrator": "", "text": "それだけ大変なんだよね"},
        { "location": "1473/SEL"     , "narrator": "", "text": "そういう時もあるよ"},
        { "location": "1474/SEL"     , "narrator": "", "text": "まあ肩の力抜こうか"},
        { "location": "1475/ACT"     , "narrator": "", "text": "それだけ大変なんだよね"},
        { "location": "1476/TALK"    , "narrator": "神楽", "text": "そうぴょん"},
        { "location": "1477/ACT"     , "narrator": "", "text": "そういう時もあるよ"},
        { "location": "1478/TALK"    , "narrator": "神楽", "text": "あるのかな"},
        { "location": "1479/TALK"    , "narrator": "神楽", "text": "ない方がいいぴょん"},
        { "location": "1480/ACT"     , "narrator": "", "text": "まあ肩の力抜こうか"},
        { "location": "1481/TALK"    , "narrator": "神楽", "text": "はぁぁぁぁん"},
        { "location": "1483/TALK"    , "narrator": "神楽", "text": "無理ぽ、、、"},
        { "location": "1485/TALK"    , "narrator": "神楽", "text": "でもぴょんこには$handle$がいてくれるでしょ"},
        { "location": "1487/SEL"     , "narrator": "", "text": "もちろん！"},
        { "location": "1488/SEL"     , "narrator": "", "text": "ずっと一緒だよ"},
        { "location": "1489/SEL"     , "narrator": "", "text": "それはどうかな…"},
        { "location": "1490/ACT"     , "narrator": "", "text": "もちろん！"},
        { "location": "1491/TALK"    , "narrator": "神楽", "text": "よしよし"},
        { "location": "1492/TALK"    , "narrator": "神楽", "text": "ぴょんこもｱｲｼﾃﾙ"},
        { "location": "1493/ACT"     , "narrator": "", "text": "ずっと一緒だよ"},
        { "location": "1494/TALK"    , "narrator": "神楽", "text": "ずっとね"},
        { "location": "1495/TALK"    , "narrator": "神楽", "text": "絶対だぞ！"},
        { "location": "1496/ACT"     , "narrator": "", "text": "それはどうかな…"},
        { "location": "1497/TALK"    , "narrator": "神楽", "text": "そっか"},
        { "location": "1498/TALK"    , "narrator": "神楽", "text": "さよなら"},
        { "location": "1509/TALK"    , "narrator": "神楽", "text": "でもさ"},
        { "location": "1510/TALK"    , "narrator": "神楽", "text": "ぴょんこの秘密を知っても"},
        { "location": "1511/TALK"    , "narrator": "神楽", "text": "そんなことが言える？"},
        { "location": "1513/SEL"     , "narrator": "", "text": "どんな神楽も受け止める"},
        { "location": "1514/SEL"     , "narrator": "", "text": "秘密なんてもうないでしょ"},
        { "location": "1515/SEL"     , "narrator": "", "text": "ちょっと考えさせて"},
        { "location": "1516/ACT"     , "narrator": "", "text": "どんな神楽も受け止める"},
        { "location": "1517/TALK"    , "narrator": "神楽", "text": "ｲｲ覚悟だね"},
        { "location": "1518/ACT"     , "narrator": "", "text": "秘密なんてもうないでしょ"},
        { "location": "1519/TALK"    , "narrator": "神楽", "text": "あるに決まってるでしょ"},
        { "location": "1520/ACT"     , "narrator": "", "text": "ちょっと考えさせて"},
        { "location": "1521/TALK"    , "narrator": "神楽", "text": "うんわかった"},
        { "location": "1522/TALK"    , "narrator": "神楽", "text": "考えといてね"},
        { "location": "1533/TALK"    , "narrator": "神楽", "text": "でも秘密って"},
        { "location": "1534/TALK"    , "narrator": "神楽", "text": "打ち明けた時点で秘密じゃなくなるよね"},
        { "location": "1536/TALK"    , "narrator": "神楽", "text": "そう思うと"},
        { "location": "1537/TALK"    , "narrator": "神楽", "text": "言わない方がいいのかな"},
        { "location": "1538/TALK"    , "narrator": "神楽", "text": "なんて思ったりもするぴょん"},
        { "location": "1540/SEL"     , "narrator": "", "text": "二人きりの秘密もあるでしょ"},
        { "location": "1541/SEL"     , "narrator": "", "text": "神楽が決めてくれればいいよ"},
        { "location": "1542/SEL"     , "narrator": "", "text": "それでも聞きたいな…"},
        { "location": "1543/ACT"     , "narrator": "", "text": "二人きりの秘密もあるでしょ"},
        { "location": "1544/TALK"    , "narrator": "神楽", "text": "いい響き♪"},
        { "location": "1545/TALK"    , "narrator": "神楽", "text": "二人きりの秘密って"},
        { "location": "1546/ACT"     , "narrator": "", "text": "神楽が決めてくれればいいよ"},
        { "location": "1547/TALK"    , "narrator": "神楽", "text": "ぴょんこは迷ってるから"},
        { "location": "1548/TALK"    , "narrator": "神楽", "text": "$handle$に決めて欲しかったのにー！"},
        { "location": "1549/ACT"     , "narrator": "", "text": "それでも聞きたいな…"},
        { "location": "1550/TALK"    , "narrator": "神楽", "text": "あっなんかかわいい？"},
        { "location": "1553/TALK"    , "narrator": "神楽", "text": "っていうかね"},
        { "location": "1554/TALK"    , "narrator": "神楽", "text": "言ったらぴょんこはもうぴょんこじゃなくなるような気がするから"},
        { "location": "1555/TALK"    , "narrator": "神楽", "text": "やっぱり言うのは無理かなって"},
        { "location": "1557/SEL"     , "narrator": "", "text": "だったら言わなくていいよ"},
        { "location": "1558/SEL"     , "narrator": "", "text": "ちょっと残念だけど"},
        { "location": "1559/SEL"     , "narrator": "", "text": "えーケチだな～"},
        { "location": "1560/ACT"     , "narrator": "", "text": "だったら言わなくていいよ"},
        { "location": "1561/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "1562/TALK"    , "narrator": "神楽", "text": "それでいい？"},
        { "location": "1563/ACT"     , "narrator": "", "text": "ちょっと残念だけど"},
        { "location": "1564/TALK"    , "narrator": "神楽", "text": "そっか"},
        { "location": "1565/TALK"    , "narrator": "神楽", "text": "ごめんね"},
        { "location": "1566/ACT"     , "narrator": "", "text": "えーケチだな～"},
        { "location": "1567/TALK"    , "narrator": "神楽", "text": "ｳｯｻｲﾊﾞｰｶバーカ"},
        { "location": "1580/SEL"     , "narrator": "", "text": "言う気になったら言って"},
        { "location": "1581/SEL"     , "narrator": "", "text": "無理はしないで"},
        { "location": "1582/SEL"     , "narrator": "", "text": "$me$の愛は公開情報だから"},
        { "location": "1583/ACT"     , "narrator": "", "text": "言う気になったら言って"},
        { "location": "1584/TALK"    , "narrator": "神楽", "text": "そうするね"},
        { "location": "1585/ACT"     , "narrator": "", "text": "無理はしないで"},
        { "location": "1586/TALK"    , "narrator": "神楽", "text": "わかった"},
        { "location": "1587/ACT"     , "narrator": "", "text": "$me$の愛は公開情報だから"},
        { "location": "1588/TALK"    , "narrator": "神楽", "text": "そうだったんだ！"},
        { "location": "1590/TALK"    , "narrator": "神楽", "text": "ちょっと色々考えすぎカモ"},
        { "location": "1592/TALK"    , "narrator": "神楽", "text": "でも"},
        { "location": "1593/TALK"    , "narrator": "神楽", "text": "こうやってＷＡＶＥしてる時は大丈夫って"},
        { "location": "1594/TALK"    , "narrator": "神楽", "text": "そう思えるから"},
        { "location": "1595/TALK"    , "narrator": "神楽", "text": "またね"},
        { "location": "1597/SEL"     , "narrator": "", "text": "神楽"},
        { "location": "1598/ACT"     , "narrator": "", "text": "神楽"},
        { "location": "1600/TALK"    , "narrator": "神楽", "text": "何？？？"},
        { "location": "1602/SEL"     , "narrator": "", "text": "いつでも話聞くからね"},
        { "location": "1603/SEL"     , "narrator": "", "text": "おとぎ話の最後はみんな幸せになりました、だよ"},
        { "location": "1604/SEL"     , "narrator": "", "text": "辛い時は泣いていいんだよ"},
        { "location": "1605/ACT"     , "narrator": "", "text": "いつでも話聞くからね"},
        { "location": "1606/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "1608/TALK"    , "narrator": "神楽", "text": "ｱﾘｶﾞﾄ、、、"},
        { "location": "1609/ACT"     , "narrator": "", "text": "おとぎ話の最後はみんな幸せになりました、だよ"},
        { "location": "1610/TALK"    , "narrator": "神楽", "text": "そうだよね"},
        { "location": "1611/TALK"    , "narrator": "神楽", "text": "そうなんだよね！"},
        { "location": "1612/ACT"     , "narrator": "", "text": "辛い時は泣いていいんだよ"},
        { "location": "1613/TALK"    , "narrator": "神楽", "text": "そうかもしれないけど"},
        { "location": "1614/TALK"    , "narrator": "神楽", "text": "できたら笑っていたいぴょん"}
    ]
}
