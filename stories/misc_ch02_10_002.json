        { "location": "77/SCENARIO", "narrator": "", "text": "00-00_LEDと白熱球"},
        { "location": "102/TALK"   , "narrator": "アーヤ", "text": "館長にこの建物には白熱球の光が似合うって"},
        { "location": "103/TALK"   , "narrator": "アーヤ", "text": "買い溜めさせられたんだけど"},
        { "location": "104/TALK"   , "narrator": "アーヤ", "text": "調べてみたら"},
        { "location": "105/TALK"   , "narrator": "アーヤ", "text": "LEDの方がたくさん使ってたのよ"},
        { "location": "106/TALK"   , "narrator": "アーヤ", "text": "（ノ ﾟДﾟ）ノ\n　　＝＝＝＝　┻━━┻ "},
        { "location": "108/SEL"    , "narrator": "", "text": "LEDより白熱球のほうがいいってことだね"},
        { "location": "109/SEL"    , "narrator": "", "text": "生産中止になったしね"},
        { "location": "110/SEL"    , "narrator": "", "text": "上司は思い付きでモノを言う"},
        { "location": "111/ACT"    , "narrator": "", "text": "LEDより白熱球のほうがいいってことだね"},
        { "location": "112/TALK"   , "narrator": "アーヤ", "text": "そうなのよ(;^_^A"},
        { "location": "113/TALK"   , "narrator": "アーヤ", "text": "でも肝心の使用箇所が"},
        { "location": "114/TALK"   , "narrator": "アーヤ", "text": "そんなになかったのよ（｀皿´ )"},
        { "location": "115/ACT"    , "narrator": "", "text": "生産中止になったしね"},
        { "location": "116/TALK"   , "narrator": "アーヤ", "text": "そうみいたいね"},
        { "location": "117/TALK"   , "narrator": "アーヤ", "text": "そうみたいね"},
        { "location": "118/ACT"    , "narrator": "", "text": "上司は思い付きでモノを言う"},
        { "location": "120/TALK"   , "narrator": "アーヤ", "text": "ほんとそれね！"},
        { "location": "121/TALK"   , "narrator": "アーヤ", "text": "なんでなのかしら"},
        { "location": "122/TALK"   , "narrator": "アーヤ", "text": "もー"},
        { "location": "124/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "125/TALK"   , "narrator": "アーヤ", "text": "わかってくれてうれしいわ"},
        { "location": "127/TALK"   , "narrator": "アーヤ", "text": "確かにこの建物には"},
        { "location": "128/TALK"   , "narrator": "アーヤ", "text": "白熱球の光の方が似合う気がするのよ"},
        { "location": "129/TALK"   , "narrator": "アーヤ", "text": "それには同意なのよね"},
        { "location": "131/SEL"    , "narrator": "", "text": "色調かな"},
        { "location": "132/SEL"    , "narrator": "", "text": "その時代ごとに似合うものって変わるよね"},
        { "location": "133/SEL"    , "narrator": "", "text": "アーヤには$me$が似合うよ"},
        { "location": "134/ACT"    , "narrator": "", "text": "色調かな"},
        { "location": "135/TALK"   , "narrator": "アーヤ", "text": "そうかも"},
        { "location": "136/TALK"   , "narrator": "アーヤ", "text": "柔らかい光が"},
        { "location": "137/TALK"   , "narrator": "アーヤ", "text": "ここの雰囲気にあってるのかもね"},
        { "location": "138/ACT"    , "narrator": "", "text": "その時代ごとに似合うものって変わるよね"},
        { "location": "139/TALK"   , "narrator": "アーヤ", "text": "それはありそう"},
        { "location": "140/TALK"   , "narrator": "アーヤ", "text": "此処はちょっとレトロな感じだから"},
        { "location": "141/TALK"   , "narrator": "アーヤ", "text": "その時代のものが似合うんだわ"},
        { "location": "142/ACT"    , "narrator": "", "text": "アーヤには$me$が似合うよ"},
        { "location": "144/TALK"   , "narrator": "アーヤ", "text": "そういう話じゃないわよ"},
        { "location": "145/TALK"   , "narrator": "アーヤ", "text": "いつも貴方はそうね"},
        { "location": "146/TALK"   , "narrator": "アーヤ", "text": "たまにはもう少し"},
        { "location": "147/TALK"   , "narrator": "アーヤ", "text": "真面目に話をして欲しいわ"}
    ]
