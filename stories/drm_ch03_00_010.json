    [
        { "location": "7/SCENARIO", "narrator": "", "text": "010_幼気な恋"},
        { "location": "23/TALK"   , "narrator": "千羽鶴", "text": "まずはおめでとう。"},
        { "location": "24/TALK"   , "narrator": "千羽鶴", "text": "貴方が今ここにいると\nいうことは、彼女との\n関係の開始を意味する。"},
        { "location": "26/SEL"    , "narrator": "", "text": "関係の開始って、つまり…"},
        { "location": "27/ACT"    , "narrator": "", "text": "関係の開始って、つまり…"},
        { "location": "30/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "31/TALK"   , "narrator": "千羽鶴", "text": "今この瞬間から、貴方と\n彼女は、真のパートナー\nとして歩み始める。"},
        { "location": "32/TALK"   , "narrator": "千羽鶴", "text": "その結果としては、\n恋人になったり、結婚\nしたりするかもしれない。"},
        { "location": "33/TALK"   , "narrator": "千羽鶴", "text": "もちろんそれは、\nあくまで可能性でしか\nないけれども。"},
        { "location": "34/TALK"   , "narrator": "千羽鶴", "text": "１つだけ言えることは、\n全ては貴方の行動次第\nということ。"},
        { "location": "35/TALK"   , "narrator": "千羽鶴", "text": "何にしても、今後\n貴方と彼女の関係進展は、\n全てここで行われる。"},
        { "location": "36/TALK"   , "narrator": "千羽鶴", "text": "一見貴方に関係無いような\nお話が繰り広げられる事も\nあるけど、全部関係ある。"},
        { "location": "37/TALK"   , "narrator": "千羽鶴", "text": "だから、彼女を大切に\n想うなら、ここでの物語は\n決して軽視しないよう。"},
        { "location": "38/SEL"    , "narrator": "", "text": "これでもうパートナーは決まっちゃったの？"},
        { "location": "39/ACT"    , "narrator": "", "text": "これでもうパートナーは決まっちゃったの？"},
        { "location": "41/TALK"   , "narrator": "千羽鶴", "text": "まさか。\nまだ始まりに過ぎない。"},
        { "location": "42/TALK"   , "narrator": "千羽鶴", "text": "もちろん、複数の子と\n関係を深められる。\nというか深めて欲しい。"},
        { "location": "43/TALK"   , "narrator": "千羽鶴", "text": "最初にも言ったとおり、\n貴方には、全員の支えに\nなって欲しいと思ってる。"},
        { "location": "44/TALK"   , "narrator": "千羽鶴", "text": "もちろん、\n強制はしないけど。"},
        { "location": "45/TALK"   , "narrator": "千羽鶴", "text": "貴方がしたいように、\n彼女たちとの物語を\n紡いでいけばいい。"},
        { "location": "46/TALK"   , "narrator": "千羽鶴", "text": "それじゃ、頑張って。\n彼女のココロは、貴方の\n頑張りに委ねられている。"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "一体全体、どうすればいいんでしょうか。"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "姫はどんな名医にも治せない、厄介な病気にかかってしまったのです。"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "これまでに同じことがあったのではありませんか？　医師はそう聞きます。"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "なぜそんなことを聞くの？　姫は医師に聞き返します。"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "原因はわかっております。しかし、初めてかどうかがこの病の治療には必要不可欠な情報なのです。"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "なぜなら・・・"},
        { "location": "87/SEL"    , "narrator": "", "text": "またお姫様ごっこ？"},
        { "location": "88/SEL"    , "narrator": "", "text": "体調が悪いの？"},
        { "location": "89/SEL"    , "narrator": "", "text": "姫、いかがなさいましたか？"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "なぜなら・・・"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "姫の病は恋だからです。"},
        { "location": "102/ACT"   , "narrator": "", "text": "またお姫様ごっこ？"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "そんな言い方ってないと思うわ"},
        { "location": "107/ACT"   , "narrator": "", "text": "体調が悪いの？"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "大丈夫よ、私は平気"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "いい子ねv"},
        { "location": "110/ACT"   , "narrator": "", "text": "姫、いかがなさいましたか？"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "あら、心配かけちゃったかしら"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "大丈夫よ、私は平気なの"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "いい子ねv"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "あのね・・・"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナにだけ教えてあげるv"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "私ね、今、すきなひとがいるのvvvvvvv"},
        { "location": "130/SEL"   , "narrator": "", "text": "それは誰？"},
        { "location": "131/SEL"   , "narrator": "", "text": "$handle$のことだよね？"},
        { "location": "132/ACT"   , "narrator": "", "text": "それは誰？"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "・・・聞きたい？"},
        { "location": "137/ACT"   , "narrator": "", "text": "$handle$のことだよね？"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "まあマルザンナ！"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "また変なこと言って！"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナはマルザンナでしょう？\n$handle$なんて変な名前はやめてちょうだいね？"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "すきなひとの話だけど・・・・"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "ヒカルくんっていうの"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "あ"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "私ばっかり話しちゃったわね？"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナにも楽しい話をしてあげるわねvvvvvvv"},
        { "location": "161/TALK"  , "narrator": "ボイスメール", "text": "白ウサギの優しき嘘"},
        { "location": "178/TALK"  , "narrator": "ガブリエラ", "text": "じゃあねvvvvvvvv"},
        { "location": "117/DIALOG", "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "173/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【ガブリエラ】</color>のボイスメール\n<color=red>【白ウサギの優しき嘘】</color>\nをゲットしました！"}
    ]
