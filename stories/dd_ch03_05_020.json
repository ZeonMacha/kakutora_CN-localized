{
    "dir": "chap05/daydra/dd_ch03_05_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "5356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "料理教室"
    },
    "entry":
    [
        { "location": "212/SCENARIO", "narrator": "", "text": "料理教室"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "…ふむ。\n和食の作り方を\n教えてほしいが？"},
        { "location": "229/TALK"    , "narrator": "ガブリエラ", "text": "うん。"},
        { "location": "230/TALK"    , "narrator": "ガブリエラ", "text": "和食って、レシピ\n見たり創作したり\nだったから――"},
        { "location": "231/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんと\n習ったことって\n一度もないのよ。"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "別に、教わる必要は\nないと思うけんど？"},
        { "location": "233/TALK"    , "narrator": "みやび", "text": "ガブちゃんの料理、\n普通に美味いと思うし。"},
        { "location": "234/TALK"    , "narrator": "ガブリエラ", "text": "けど、一度しっかりと\n習っておきたいの。"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "…勉強熱心やねぇ。"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "わかったちや。\nうちでえいなら\n力になるぞね！"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "ありがと。\nそれじゃあ早速教えて\nもらえるかしら？"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "ああ、えいよ。"},
        { "location": "239/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "240/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "…一応言っておく\nけんど――"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "ただ教えてくれ\n言われても、\nうちも困るき。"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "何か作りたい料理を\n言ってほしいんやけんど。"},
        { "location": "245/TALK"    , "narrator": "ガブリエラ", "text": "えっ！？\nえ、えっと…。"},
        { "location": "247/TALK"    , "narrator": "みやび", "text": "…考えてなかったが？"},
        { "location": "249/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、ちょっと\n調べるから待ってて！"},
        { "location": "262/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナ、協力して！"},
        { "location": "264/SEL"     , "narrator": "", "text": "何を作るかの相談だね？"},
        { "location": "265/ACT"     , "narrator": "", "text": "何を作るかの相談だね？"},
        { "location": "267/TALK"    , "narrator": "ガブリエラ", "text": "本当、話が早くて助かるわ"},
        { "location": "268/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナは、何を教えてもらったらいいと思う？"},
        { "location": "270/SEL"     , "narrator": "", "text": "豚汁"},
        { "location": "271/SEL"     , "narrator": "", "text": "ハンバーグ"},
        { "location": "272/SEL"     , "narrator": "", "text": "刺身の盛り付け"},
        { "location": "273/ACT"     , "narrator": "", "text": "豚汁"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "なんだか、マルザンナが豚汁って言うの、ちょっとおかしいかも"},
        { "location": "286/TALK"    , "narrator": "ガブリエラ", "text": "でも、豚汁って意見には賛成よ"},
        { "location": "299/TALK"    , "narrator": "ガブリエラ", "text": "うん、豚汁が良いわ。\nあれって具が多いから、\n結構難しいのよね。"},
        { "location": "300/TALK"    , "narrator": "ガブリエラ", "text": "前に作った時は、\n微妙に美味しく\nなかったし…。"},
        { "location": "301/TALK"    , "narrator": "みやび", "text": "豚汁…。"},
        { "location": "302/TALK"    , "narrator": "みやび", "text": "まさかとは思うけんど、\n材料湯の中に入れて\n温めちょらんよな？"},
        { "location": "303/TALK"    , "narrator": "ガブリエラ", "text": "えっ、違うの？\nお味噌汁と同じ感じで\n作ってたわ。"},
        { "location": "304/TALK"    , "narrator": "みやび", "text": "…なるほど。\nまあ、初心者には\nよくある間違いやね。"},
        { "location": "305/TALK"    , "narrator": "みやび", "text": "じゃあ、豚汁の\n作り方を教えるちや。\n準備はえいか？"},
        { "location": "309/TALK"    , "narrator": "ガブリエラ", "text": "ええ、\nいつでもＯＫよ！"},
        { "location": "321/TALK"    , "narrator": "真幌", "text": "…ほう、豚汁か。\n私が試食していいのか？"},
        { "location": "324/TALK"    , "narrator": "ガブリエラ", "text": "うん…まほなら\n遠慮なく感想言って\nくれそうだし。"},
        { "location": "325/TALK"    , "narrator": "真幌", "text": "言っておくが、\n不味かったらはっきり\nそう言うぞ？"},
        { "location": "327/TALK"    , "narrator": "みやび", "text": "その心配はないき、\nグイッといくちや。"},
        { "location": "328/TALK"    , "narrator": "真幌", "text": "火傷するだろうが。\nでは、いただこう…。"},
        { "location": "330/TALK"    , "narrator": "真幌", "text": "ズズッ…。"},
        { "location": "331/TALK"    , "narrator": "真幌", "text": "……むっ？"},
        { "location": "332/TALK"    , "narrator": "ガブリエラ", "text": "……ど、どう？"},
        { "location": "334/TALK"    , "narrator": "真幌", "text": "…これ、美味いな。"},
        { "location": "336/TALK"    , "narrator": "ガブリエラ", "text": "ほ、本当！？"},
        { "location": "338/TALK"    , "narrator": "真幌", "text": "ああ…お世辞抜きに、\n驚くほどの美味さだ。"},
        { "location": "339/TALK"    , "narrator": "真幌", "text": "これをみやびではなく、\nギャヴィが作ったのか？"},
        { "location": "340/TALK"    , "narrator": "ガブリエラ", "text": "教わりながらだけどね。"},
        { "location": "341/TALK"    , "narrator": "みやび", "text": "けんど、うちは一切\n手を加えてないがよ。"},
        { "location": "342/TALK"    , "narrator": "みやび", "text": "全部、ガブちゃんが\n一人で作ったちや。"},
        { "location": "343/TALK"    , "narrator": "真幌", "text": "大したものだ。"},
        { "location": "344/TALK"    , "narrator": "真幌", "text": "ギャヴィ、おかわりの\n準備をしておけ。\nあと三杯はもらうぞ。"},
        { "location": "348/TALK"    , "narrator": "みやび", "text": "良かったな、ガブちゃん。\n大成功やね。"},
        { "location": "351/TALK"    , "narrator": "ガブリエラ", "text": "みやびのおかげよ。\nまた今度、違う料理を\n教えてね。"},
        { "location": "352/TALK"    , "narrator": "みやび", "text": "…難しいのは面倒やき、\n簡単なのやったら\nえいなぁ。"},
        { "location": "353/ACT"     , "narrator": "", "text": "ハンバーグ"},
        { "location": "354/TALK"    , "narrator": "ガブリエラ", "text": "それは洋食よ！"},
        { "location": "355/TALK"    , "narrator": "ガブリエラ", "text": "洋食と和食の違い、マルザンナにはわからないのかしら？"},
        { "location": "368/TALK"    , "narrator": "ガブリエラ", "text": "…でも和食って洋食を\n和風にしたものも、\n結構あるわよね。"},
        { "location": "369/TALK"    , "narrator": "ガブリエラ", "text": "聞くだけ\n聞いてみようかしら？"},
        { "location": "371/TALK"    , "narrator": "ガブリエラ", "text": "ハンバーグみたいな\n感じの和食って…\nやっぱりないわよね？"},
        { "location": "372/TALK"    , "narrator": "みやび", "text": "あるよ。"},
        { "location": "375/TALK"    , "narrator": "ガブリエラ", "text": "あるの！？"},
        { "location": "376/TALK"    , "narrator": "みやび", "text": "豆腐ハンバーグちゅう、\nヘルシーなのが\nあるちや。"},
        { "location": "378/TALK"    , "narrator": "ガブリエラ", "text": "それ、面白そう！\nその作り方教えて。"},
        { "location": "380/TALK"    , "narrator": "みやび", "text": "わかったちや。\nそれじゃあ、野菜と\n豆腐を用意するぞね。"},
        { "location": "391/TALK"    , "narrator": "真幌", "text": "…なるほど。\nそれで、私に試食して\nほしいというのだな？"},
        { "location": "393/TALK"    , "narrator": "ガブリエラ", "text": "そういうこと。\n率直な感想を\n聞きたいの。"},
        { "location": "394/TALK"    , "narrator": "みやび", "text": "冷めたら不味くなるき、\n熱いうちに食べるんが\nえいですよ。"},
        { "location": "395/TALK"    , "narrator": "真幌", "text": "そうだな。\nでは、いただく。"},
        { "location": "397/TALK"    , "narrator": "真幌", "text": "あむっ……。"},
        { "location": "398/TALK"    , "narrator": "ガブリエラ", "text": "……ど、どう？"},
        { "location": "399/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "401/TALK"    , "narrator": "真幌", "text": "…美味いな。"},
        { "location": "403/TALK"    , "narrator": "ガブリエラ", "text": "…なんか、不満そうに\n見えるけど…。"},
        { "location": "404/TALK"    , "narrator": "真幌", "text": "味に文句があるわけ\nではないんだ。"},
        { "location": "406/TALK"    , "narrator": "真幌", "text": "ただ、ハンバーグと\n思って食べると――"},
        { "location": "407/TALK"    , "narrator": "真幌", "text": "この味はヘルシーで、\n少々物足りなさを\n感じてしまってな…。"},
        { "location": "408/TALK"    , "narrator": "みやび", "text": "肉は一切使ってない\n豆腐ハンバーグやき、\n当然やね。"},
        { "location": "410/TALK"    , "narrator": "真幌", "text": "本当にこれは\nハンバーグと言って\nいいのだろうか。"},
        { "location": "411/TALK"    , "narrator": "ガブリエラ", "text": "でも、美味しいとは\n思ってくれてるのよね？"},
        { "location": "412/TALK"    , "narrator": "真幌", "text": "…ああ、美味い。\n本当に美味いぞ。"},
        { "location": "413/TALK"    , "narrator": "ガブリエラ", "text": "それが聞ければ満足よ。\n新しい和食のレパー\nトリーが増えたわ。"},
        { "location": "414/ACT"     , "narrator": "", "text": "刺身の盛り付け"},
        { "location": "424/TALK"    , "narrator": "ガブリエラ", "text": "盛り付けって、料理なのかしら？"},
        { "location": "425/TALK"    , "narrator": "ガブリエラ", "text": "でも、お刺身を綺麗に盛り付けるやり方"},
        { "location": "426/TALK"    , "narrator": "ガブリエラ", "text": "あれができるようになったらかっこいいかも！"},
        { "location": "439/TALK"    , "narrator": "ガブリエラ", "text": "みやび、\nお刺身が良いわ。"},
        { "location": "440/TALK"    , "narrator": "ガブリエラ", "text": "お刺身を綺麗に\n盛り付けるやり方、\n教えて！"},
        { "location": "441/TALK"    , "narrator": "みやび", "text": "あ～…\nお造りのことやね。"},
        { "location": "442/TALK"    , "narrator": "ガブリエラ", "text": "そう！\n…難しいかしら？"},
        { "location": "443/TALK"    , "narrator": "みやび", "text": "いや、そんなことは\nないぞね。"},
        { "location": "445/TALK"    , "narrator": "みやび", "text": "コツさえ掴めば、\nとりあえずそれっぽくは\nできるちや。"},
        { "location": "447/TALK"    , "narrator": "ガブリエラ", "text": "それじゃお願い\nするわ。まずは\n何をすればいい？"},
        { "location": "448/TALK"    , "narrator": "みやび", "text": "盛り付けをするには、\nとにかく刺身が必要に\nなるき――"},
        { "location": "449/TALK"    , "narrator": "みやび", "text": "せっかくやし、\n魚をさばくところから\n始めるちや。"},
        { "location": "459/TALK"    , "narrator": "真幌", "text": "…随分と高級そうな\n刺身のようだが――"},
        { "location": "461/TALK"    , "narrator": "真幌", "text": "本当に私が食べて\nしまっていいのか？"},
        { "location": "464/TALK"    , "narrator": "ガブリエラ", "text": "ふふっ…\nそう見えるでしょ？"},
        { "location": "465/TALK"    , "narrator": "みやび", "text": "まほさん、\n安心してえいよ。"},
        { "location": "466/TALK"    , "narrator": "みやび", "text": "盛り付けで豪華に\n見えるけんど、魚は\nスーパーの安物やき。"},
        { "location": "467/TALK"    , "narrator": "ガブリエラ", "text": "そういうこと。\nほら、早く食べてみて。"},
        { "location": "469/TALK"    , "narrator": "真幌", "text": "あ、ああ…あむっ…。"},
        { "location": "471/TALK"    , "narrator": "真幌", "text": "…凄いな。\nとても安い魚とは\n思えん美味さだ。"},
        { "location": "473/TALK"    , "narrator": "ガブリエラ", "text": "本当！？"},
        { "location": "475/TALK"    , "narrator": "真幌", "text": "ああ、見た目が\n素晴らしいからだと\n思うが――"},
        { "location": "476/TALK"    , "narrator": "真幌", "text": "まるで料亭の刺身を\n食べているような\n気分だ。"},
        { "location": "477/TALK"    , "narrator": "真幌", "text": "まさか劇場でこんなに\n素晴らしい物が食べれる\nとは…感動したぞ。"},
        { "location": "481/TALK"    , "narrator": "みやび", "text": "べた褒めやな。\n相当美味しかった\nようやね。"},
        { "location": "484/TALK"    , "narrator": "ガブリエラ", "text": "みやびのおかげよ。\nまた得意料理が一つ…。"},
        { "location": "485/TALK"    , "narrator": "ガブリエラ", "text": "って、そうだ。\n一つ疑問に思ってた\nことがあるんだけど――"},
        { "location": "486/TALK"    , "narrator": "ガブリエラ", "text": "盛り付けっていうのは、\n料理の内に入るの？"},
        { "location": "488/TALK"    , "narrator": "みやび", "text": "…そんなの知らんぞね。"},
        { "location": "220/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月17日　4:33 PM</color>\nとある平日の午後、神楽坂トライナリーのバイト中にて。"},
        { "location": "279/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "420/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
