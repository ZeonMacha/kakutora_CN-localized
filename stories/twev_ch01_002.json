        { "location": "172/TALK"  , "narrator": "透明つばめ", "text": "可愛いなぁ…。\nこの服、本当にあったら\nいいのに…。"},
        { "location": "173/TALK"  , "narrator": "透明神楽", "text": "つ、つばめさーん。\nいい加減その絵、\n返してください。"},
        { "location": "175/TALK"  , "narrator": "透明つばめ", "text": "もうちょっとだけー。\n卯月さんの絵、\nとっても可愛いよ。"},
        { "location": "176/TALK"  , "narrator": "透明みやび", "text": "いつも見せちょるやろ？\nなんでこれだけ\n恥ずかしがるんや？"},
        { "location": "178/TALK"  , "narrator": "透明神楽", "text": "だって、その絵はまだ\n見せるタイミングのじゃ\nありませんでしたし…。"},
        { "location": "179/TALK"  , "narrator": "透明ガブリエラ", "text": "いや、恥ずかしいのは\nあたしの方だから！"},
        { "location": "180/TALK"  , "narrator": "透明ガブリエラ", "text": "みやびも、どうして\nわざわざこの絵を\nネットに載せたのよ？"},
        { "location": "181/TALK"  , "narrator": "透明みやび", "text": "一人一人に聞くの\n面倒やったがよ。"},
        { "location": "183/TALK"  , "narrator": "透明ガブリエラ", "text": "まったく…神楽が\nカレー屋にノートを\n忘れたりしなければ…。"},
        { "location": "184/TALK"  , "narrator": "透明神楽", "text": "わ、私のせいですか！？"},
        { "location": "185/TALK"  , "narrator": "透明ガブリエラ", "text": "そりゃそうでしょ？\n持ち主なんだから。"},
        { "location": "186/TALK"  , "narrator": "透明みやび", "text": "ちゅうか、どの絵を\n載せるかでかなり\n悩んだちや。"},
        { "location": "187/TALK"  , "narrator": "透明みやび", "text": "載せた瞬間アカウント\n凍結しそうな際どいのも\nあったき。"},
        { "location": "189/TALK"  , "narrator": "透明神楽", "text": "ちょ！？　それ以上は\n言わないでください！"},
        { "location": "190/TALK"  , "narrator": "透明ガブリエラ", "text": "神楽！\nあんた普段どんな絵\n描いてんのよ！？"},
        { "location": "192/TALK"  , "narrator": "透明つばめ", "text": "ふふっ、可愛いなぁ…。\nそうだ！"},
        { "location": "194/TALK"  , "narrator": "つばめ", "text": "ジャーン！！ヽ(･ω･ )ゝ✧"},
        { "location": "195/TALK"  , "narrator": "つばめ", "text": "この絵見て"},
        { "location": "196/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんが描ぃたの(*≧∀≦*) "},
        { "location": "197/SEL"   , "narrator": "（選択肢）", "text": "つばめ可愛いね"},
        { "location": "198/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラ可愛いね"},
        { "location": "199/ACT"   , "narrator": "", "text": "つばめ可愛いね"},
