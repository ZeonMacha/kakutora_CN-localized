        { "location": "202/TALK"  , "narrator": "つばめ", "text": "わたしも気に入ってるの"},
        { "location": "203/TALK"  , "narrator": "つばめ", "text": "かわぃぃよね(´∀｀*)"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "この服"},
