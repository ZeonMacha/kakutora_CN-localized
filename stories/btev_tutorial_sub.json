        "sub_title": "チュートリアルサブ"
    },
    "entry":
    [
        { "location": "5/SCENARIO", "narrator": "", "text": "チュートリアルサブ"},
        { "location": "8/SEL"     , "narrator": "", "text": "深層世界って？"},
        { "location": "9/SEL"     , "narrator": "", "text": "ここもココロスフィア？"},
        { "location": "10/ACT"    , "narrator": "", "text": "深層世界って？"},
        { "location": "11/TALK"   , "narrator": "千羽鶴", "text": "その名の通り、心の深層に\nある、本人も気づいて\nいない意識の世界。"},
        { "location": "12/ACT"    , "narrator": "", "text": "ここもココロスフィア？"},
        { "location": "13/TALK"   , "narrator": "千羽鶴", "text": "そう。\nココロココモスフィア。"},
        { "location": "15/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "16/TALK"   , "narrator": "千羽鶴", "text": "ココも[ココロスフィア]…。"},
        { "location": "17/SEL"    , "narrator": "", "text": "もしかして噛んだ？"},
        { "location": "18/ACT"    , "narrator": "", "text": "もしかして噛んだ？"},
        { "location": "21/TALK"   , "narrator": "千羽鶴", "text": "……いいえ。"},
        { "location": "22/SEL"    , "narrator": "", "text": "いやいやそんなことないでしょ"},
        { "location": "23/ACT"    , "narrator": "", "text": "いやいやそんなことないでしょ"},
        { "location": "25/TALK"   , "narrator": "千羽鶴", "text": "ちょっと韻を踏んだだけ。"},
        { "location": "26/TALK"   , "narrator": "千羽鶴", "text": "貴方にはその高度な\n洒落ッ気がわからないのね。"},
        { "location": "27/SEL"    , "narrator": "", "text": "そうなんだ"},
        { "location": "28/SEL"    , "narrator": "", "text": "ココロココモちはるちゃんかわいい"},
        { "location": "29/ACT"    , "narrator": "", "text": "そうなんだ"},
        { "location": "30/TALK"   , "narrator": "千羽鶴", "text": "そうなの。"},
        { "location": "31/ACT"    , "narrator": "", "text": "ココロココモちはるちゃんかわいい"},
        { "location": "32/TALK"   , "narrator": "千羽鶴", "text": "うるさい！"},
        { "location": "33/TALK"   , "narrator": "千羽鶴", "text": "まったく、貴方のせいで\n本題が全然進まない。"},
        { "location": "35/TALK"   , "narrator": "千羽鶴", "text": "とにかく、\nここは$fullname$の\n深層世界。"},
        { "location": "37/TALK"   , "narrator": "千羽鶴", "text": "この世界で見聞きする\nものは、そのすべてが\n彼女の真実。"},
        { "location": "38/TALK"   , "narrator": "千羽鶴", "text": "心の奥底は\n絶対に嘘をつかないから、\nそれだけは絶対言える。"},
        { "location": "39/TALK"   , "narrator": "千羽鶴", "text": "けど、日々を生きる\n彼女たちには、それは\nわからない。"},
        { "location": "40/TALK"   , "narrator": "千羽鶴", "text": "もしくは、しらばっくれて\n嘘をつくかもしれない。"},
        { "location": "41/TALK"   , "narrator": "千羽鶴", "text": "だから、この世界で\n見聞きしたことに対し、\n彼女が否定したとしても―"},
        { "location": "42/TALK"   , "narrator": "千羽鶴", "text": "それは恥ずかしがってたり\nしてるだけだから、そこは\n暖かく見守ってあげて。"},
        { "location": "43/SEL"    , "narrator": "", "text": "でも、どうして$me$が深層世界を見られるようになってるの？"},
        { "location": "44/ACT"    , "narrator": "", "text": "でも、どうして$me$が深層世界を見られるようになってるの？"},
        { "location": "46/TALK"   , "narrator": "千羽鶴", "text": "前にも言ったとおり、\n貴方には彼女をより深く\n支えて欲しいから。"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "普段からも、貴方には\n彼女の心の中で、葛藤を\n駆逐してもらってる。"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "けど、やはり\nそれだけでは不十分。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "例えるなら、風邪をひいた\n彼女に、熱冷ましの薬を\n与えているに過ぎない。"},
        { "location": "50/TALK"   , "narrator": "千羽鶴", "text": "炎症を対処的に改善してる\nだけで、決して根本的な\n解決にはなってないの。"},
        { "location": "51/TALK"   , "narrator": "千羽鶴", "text": "翻し、この深層世界では、\n彼女の悩み、葛藤、怯えの\n根本を解決できる。"},
        { "location": "52/TALK"   , "narrator": "千羽鶴", "text": "そして貴方は、この世界に\n入り、彼女の深層意識と\n対話することができるの。"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "ここまで、いい？"},
        { "location": "54/SEL"    , "narrator": "", "text": "はい"},
        { "location": "55/SEL"    , "narrator": "", "text": "なんか大変そう"},
        { "location": "56/SEL"    , "narrator": "", "text": "それって今度こそガチの洗脳では…"},
        { "location": "57/ACT"    , "narrator": "", "text": "はい"},
        { "location": "58/TALK"   , "narrator": "千羽鶴", "text": "よかった。"},
        { "location": "59/ACT"    , "narrator": "", "text": "なんか大変そう"},
        { "location": "60/TALK"   , "narrator": "千羽鶴", "text": "もちろん大変。"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "ココロの中の彼女は、\n現実と違って容赦ない。"},
        { "location": "62/TALK"   , "narrator": "千羽鶴", "text": "遠慮もない。\n自制することもない。\n時として恥じらいもない。"},
        { "location": "63/TALK"   , "narrator": "千羽鶴", "text": "だから、場合によっては\n貴方も何らかの精神的\n被害を被るかもしれない。"},
        { "location": "64/SEL"    , "narrator": "", "text": "なにそれ怖い"},
        { "location": "65/SEL"    , "narrator": "", "text": "ご褒美戴きました！"},
        { "location": "66/ACT"    , "narrator": "", "text": "なにそれ怖い"},
        { "location": "67/TALK"   , "narrator": "千羽鶴", "text": "そうね。\n人の本心に関わるって\nそういうこと。"},
        { "location": "68/TALK"   , "narrator": "千羽鶴", "text": "だから、この世界に\n関わることを、私は\n強制はしない。"},
        { "location": "69/TALK"   , "narrator": "千羽鶴", "text": "やりたくなければ\nやらなくても大丈夫。"},
        { "location": "70/TALK"   , "narrator": "千羽鶴", "text": "すぐに現実に戻って、\n普段の彼女と関わるのが\nいいと思う。"},
        { "location": "71/ACT"    , "narrator": "", "text": "ご褒美戴きました！"},
        { "location": "72/TALK"   , "narrator": "千羽鶴", "text": "あなた、ドエムッ子？"},
        { "location": "73/TALK"   , "narrator": "千羽鶴", "text": "やーい、\n$handle$は\nドエムッ子ー。"},
        { "location": "75/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "77/TALK"   , "narrator": "千羽鶴", "text": "気が済んだ。"},
        { "location": "79/ACT"    , "narrator": "", "text": "それって今度こそガチの洗脳では…"},
        { "location": "80/TALK"   , "narrator": "千羽鶴", "text": "んー"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "まあ、貴方がそう思うなら\nそうなんでしょう。"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "だって、彼女の心の中で\n何をして、どうなりたいか\n決めるのは全部貴方だもの。"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "私はこの\n深層世界へのダイブを\n強制するつもりはない。"},
        { "location": "84/TALK"   , "narrator": "千羽鶴", "text": "どう解釈しても洗脳にしか\nならない、それが嫌という\nなら、やらなくてもいい。"},
        { "location": "85/TALK"   , "narrator": "千羽鶴", "text": "要は、\n貴方が心の中に入って\n彼女に何を与えたいか。"},
        { "location": "86/TALK"   , "narrator": "千羽鶴", "text": "それ次第では、ガチな\n洗脳にもなるし、彼女の\n心の支えにもなる。"},
        { "location": "87/TALK"   , "narrator": "千羽鶴", "text": "これが私の\n正直な回答ね。"}
    ]
}
