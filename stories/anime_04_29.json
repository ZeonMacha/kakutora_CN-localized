{
    "dir": "chap29/daydra/anime_04_29.js",
    "type": "MainStory",
    "info": {
        "story_id": "29401",
        "cid": "miyabi",
        "title": "001 アニメーション",
        "sub_title": "エクセプション"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第29話"},
        { "location": "48/TALK"   , "narrator": "エリカ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "50/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回はつばめちゃんの\nお話をするだけでもいい？"},
        { "location": "52/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回は綾ちゃんの\nお話をするだけでもいい？"},
        { "location": "54/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回はガブリエラちゃんの\nお話をするだけでもいい？"},
        { "location": "56/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回はみやびちゃんの\nお話をするだけでもいい？"},
        { "location": "58/SEL"    , "narrator": "", "text": "はい"},
        { "location": "59/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "60/ACT"    , "narrator": "", "text": "はい"},
        { "location": "62/TALK"   , "narrator": "エリカ", "text": "うん、わかった。"},
        { "location": "64/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "66/TALK"   , "narrator": "エリカ", "text": "はーい。\nそれじゃ、少しだけ\n巻き戻しするね？"},
        { "location": "71/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "72/TALK"   , "narrator": "エリカ", "text": "こんにちは、\nエリカです。"},
        { "location": "74/TALK"   , "narrator": "エリカ", "text": "前回も色々\n頑張ってくれて\nありがとう！"},
        { "location": "75/TALK"   , "narrator": "エリカ", "text": "お陰で本当に\n助かってるよ。"},
        { "location": "76/TALK"   , "narrator": "エリカ", "text": "そういえば、綾ちゃんに\n送ったメール、綾ちゃん\n読んでくれたかな？"},
        { "location": "77/SEL"    , "narrator": "", "text": "読んだよ"},
        { "location": "78/SEL"    , "narrator": "", "text": "$me$は渡してない"},
        { "location": "79/ACT"    , "narrator": "", "text": "読んだよ"},
        { "location": "80/TALK"   , "narrator": "エリカ", "text": "ほんと！？\nよかった！"},
        { "location": "81/TALK"   , "narrator": "エリカ", "text": "それで、名前は\n何がいいって言ってた？"},
        { "location": "82/SEL"    , "narrator": "", "text": "アヤボットちゃん"},
        { "location": "83/SEL"    , "narrator": "", "text": "あやみんロボ"},
        { "location": "84/SEL"    , "narrator": "", "text": "綾水１．５号"},
        { "location": "85/SEL"    , "narrator": "", "text": "無視されたよ"},
        { "location": "86/ACT"    , "narrator": "", "text": "アヤボットちゃん"},
        { "location": "89/TALK"   , "narrator": "エリカ", "text": "そっかぁ。\nわたしもそうだと\n思ってたんだ。"},
        { "location": "90/TALK"   , "narrator": "エリカ", "text": "ありがとう、\n教えてくれて！"},
        { "location": "91/ACT"    , "narrator": "", "text": "あやみんロボ"},
        { "location": "93/TALK"   , "narrator": "エリカ", "text": "へぇ、ちょっと意外。"},
        { "location": "95/TALK"   , "narrator": "エリカ", "text": "でも、せっかく綾ちゃんが\n選んでくれたんだし、\nこれにしよっかな。"},
        { "location": "96/ACT"    , "narrator": "", "text": "綾水１．５号"},
        { "location": "98/TALK"   , "narrator": "エリカ", "text": "えー、そうなの！？\nこれ、捨て案だったのに。"},
        { "location": "99/TALK"   , "narrator": "エリカ", "text": "でも、綾ちゃんが\nこれがいいなら、\nこれにするよ。"},
        { "location": "100/ACT"   , "narrator": "", "text": "無視されたよ"},
        { "location": "102/TALK"  , "narrator": "エリカ", "text": "そっかー。\nえへへ、\nやっぱりそうだよね。"},
        { "location": "103/TALK"  , "narrator": "エリカ", "text": "実はわかってて\n聞いちゃった。\nごめんなさい。"},
        { "location": "104/TALK"  , "narrator": "エリカ", "text": "綾ちゃん、今まで名前の\n相談しても、一度も選んで\nくれたことないから。"},
        { "location": "105/TALK"  , "narrator": "エリカ", "text": "あ、そうだ。\nそういえば……"},
        { "location": "106/TALK"  , "narrator": "エリカ", "text": "その綾ちゃんロボット\n（仮）なんだけど、\nだいたい完成したの。"},
        { "location": "107/TALK"  , "narrator": "エリカ", "text": "綾ちゃんに見せる前に、\nあなたの意見を聞きたいん\nだけど、いいかな？"},
        { "location": "108/SEL"   , "narrator": "", "text": "是非見せて！"},
        { "location": "109/SEL"   , "narrator": "", "text": "お断りします！"},
        { "location": "110/ACT"   , "narrator": "", "text": "是非見せて！"},
        { "location": "112/TALK"  , "narrator": "エリカ", "text": "ありがとう！"},
        { "location": "118/TALK"  , "narrator": "エリカ", "text": "ぱぱーん！\nこれだよ！"},
        { "location": "119/TALK"  , "narrator": "エリカ", "text": "どうかな！\nどうかな！"},
        { "location": "122/SEL"   , "narrator": "", "text": "おおう…"},
        { "location": "123/SEL"   , "narrator": "", "text": "カッコイイ！"},
        { "location": "124/SEL"   , "narrator": "", "text": "今、$me$はアーヤとココロがシンクロした"},
        { "location": "125/ACT"   , "narrator": "", "text": "おおう…"},
        { "location": "126/TALK"  , "narrator": "エリカ", "text": "ん？"},
        { "location": "127/TALK"  , "narrator": "エリカ", "text": "なんだか\n不思議な反応？"},
        { "location": "128/ACT"   , "narrator": "", "text": "カッコイイ！"},
        { "location": "130/TALK"  , "narrator": "エリカ", "text": "本当！？\nやったぁ！"},
        { "location": "131/TALK"  , "narrator": "エリカ", "text": "それじゃ、早速今度\n綾ちゃんに小包で\n送ってあげよっと！"},
        { "location": "132/ACT"   , "narrator": "", "text": "今、$me$はアーヤとココロがシンクロした"},
        { "location": "135/TALK"  , "narrator": "エリカ", "text": "ええっ！\nそれって……"},
        { "location": "136/TALK"  , "narrator": "エリカ", "text": "$handle$さんは、\nもう綾ちゃんとそんな\n深い関係だったんだね！"},
        { "location": "138/TALK"  , "narrator": "エリカ", "text": "で、綾ちゃんは\n何て言ってる？"},
        { "location": "139/SEL"   , "narrator": "", "text": "え？？"},
        { "location": "140/ACT"   , "narrator": "", "text": "え？？"},
        { "location": "142/TALK"  , "narrator": "エリカ", "text": "ん？\n綾ちゃんとテレパシー\nしてるんじゃないの？"},
        { "location": "143/SEL"   , "narrator": "", "text": "いや、もういいです…"},
        { "location": "144/ACT"   , "narrator": "", "text": "いや、もういいです…"},
        { "location": "146/TALK"  , "narrator": "エリカ", "text": "？？"},
        { "location": "148/TALK"  , "narrator": "エリカ", "text": "なんにしても、\n意見くれてありがとう！"},
        { "location": "149/TALK"  , "narrator": "エリカ", "text": "次はもっと素敵な\nロボットを頑張って\n作るからね。"},
        { "location": "150/ACT"   , "narrator": "", "text": "お断りします！"},
        { "location": "151/TALK"  , "narrator": "エリカ", "text": "えええっ！？\nそうなの？"},
        { "location": "152/TALK"  , "narrator": "エリカ", "text": "残念。"},
        { "location": "155/ACT"   , "narrator": "", "text": "$me$は渡してない"},
        { "location": "156/TALK"  , "narrator": "エリカ", "text": "そっかー。"},
        { "location": "157/TALK"  , "narrator": "エリカ", "text": "もし今後渡すタイミングに\nなったら、また聞くね？"},
        { "location": "160/TALK"  , "narrator": "エリカ", "text": "さーて。\nそれじゃ、今週の\n本題に入るよ。"},
        { "location": "161/TALK"  , "narrator": "エリカ", "text": "前回、あなたの世界の\nSNSに質問を投げて\nもらったけど――"},
        { "location": "163/TALK"  , "narrator": "エリカ", "text": "すごい沢山の質問が来て、\nビックリしちゃったよ。"},
        { "location": "164/TALK"  , "narrator": "エリカ", "text": "その質問の中から、\nこれは重要だって思った\nものを答えるね。"},
        { "location": "166/SEL"   , "narrator": "", "text": "つばめのフェノメノンが消えたら、彼女たちはどうなっちゃうの？"},
        { "location": "167/SEL"   , "narrator": "", "text": "千羽鶴が記録映像を調整していたなら、何故想定外の映像が入ってたの？"},
        { "location": "168/SEL"   , "narrator": "", "text": "真幌が見た「情報管理庁」タワーがある世界ってなに？"},
        { "location": "169/SEL"   , "narrator": "", "text": "千羽鶴って結局何者なの？"},
        { "location": "170/SEL"   , "narrator": "", "text": "もう大丈夫 \n<color=blue>（※先へ進みます）</color>"},
        { "location": "171/ACT"   , "narrator": "", "text": "つばめのフェノメノンが消えたら、彼女たちはどうなっちゃうの？"},
        { "location": "172/TALK"  , "narrator": "エリカ", "text": "元に戻るだけ。"},
        { "location": "173/TALK"  , "narrator": "エリカ", "text": "それは、あなたが今まで\n見てきたフェノメノンの\n犠牲者と同じ。"},
        { "location": "174/TALK"  , "narrator": "エリカ", "text": "フェノメノンは、そこに\n取り込まれた全ての生命に\n役割を与える。"},
        { "location": "175/TALK"  , "narrator": "エリカ", "text": "けど、相当特殊な事情が\n無い限りは、子供をおじい\nちゃんにしたりはしない。"},
        { "location": "176/TALK"  , "narrator": "エリカ", "text": "綾ちゃんたちも、\nその例外に漏れず、\n役割を演じているの。"},
        { "location": "177/TALK"  , "narrator": "エリカ", "text": "だから、\nフェノメノンが消えたら、\n元の自分に戻るだけ。"},
        { "location": "178/SEL"   , "narrator": "", "text": "元のみんなって、どんな感じなの？"},
        { "location": "179/ACT"   , "narrator": "", "text": "元のみんなって、どんな感じなの？"},
        { "location": "182/TALK"  , "narrator": "エリカ", "text": "んー、それは……"},
        { "location": "184/TALK"  , "narrator": "エリカ", "text": "わたしが口で言うと、\n変な思い込みがついちゃう\nかもしれないから――"},
        { "location": "185/TALK"  , "narrator": "エリカ", "text": "いずれ来るかもしれない\nその時になったら、自分で\n確認するのがいいよ。"},
        { "location": "186/TALK"  , "narrator": "エリカ", "text": "他は？"},
        { "location": "188/ACT"   , "narrator": "", "text": "千羽鶴が記録映像を調整していたなら、何故想定外の映像が入ってたの？"},
        { "location": "189/TALK"  , "narrator": "エリカ", "text": "前も少しお話したけど、\n千羽鶴ちゃんは、世界を\n操作できるわけじゃない。"},
        { "location": "190/TALK"  , "narrator": "エリカ", "text": "何度も繰り返し、\nシミュレーションを\nしてるだけ。"},
        { "location": "191/TALK"  , "narrator": "エリカ", "text": "だから、繰り返しの\nタイミングのどこかで、\n別要因の介入はあり得る。"},
        { "location": "192/TALK"  , "narrator": "エリカ", "text": "どうやったって、\n世界はゆらぐから。"},
        { "location": "193/TALK"  , "narrator": "エリカ", "text": "だからわたしも、前に\n説明するとき「大抵は\nその通り」と言ったの。"},
        { "location": "194/TALK"  , "narrator": "エリカ", "text": "そうでない、予想外の\n未来になることもある。"},
        { "location": "195/TALK"  , "narrator": "エリカ", "text": "記録映像だって、直近の\nプレビューとは違うものを\n映すこともある。"},
        { "location": "196/TALK"  , "narrator": "エリカ", "text": "他は？"},
        { "location": "198/ACT"   , "narrator": "", "text": "真幌が見た「情報管理庁」タワーがある世界ってなに？"},
        { "location": "199/TALK"  , "narrator": "エリカ", "text": "断定はできないけど、\n千羽鶴ちゃんが想い描く\n理想の日本だと思う。"},
        { "location": "200/TALK"  , "narrator": "エリカ", "text": "わたしが彼女と一緒に\nいた頃、彼女が言っていた\nビジョンと合致するから。"},
        { "location": "201/SEL"   , "narrator": "", "text": "何故それを真幌が？"},
        { "location": "202/ACT"   , "narrator": "", "text": "何故それを真幌が？"},
        { "location": "205/TALK"  , "narrator": "エリカ", "text": "んー、ちょっと難しいけど\n多分あれは、まほちゃんが\n見たというよりは――"},
        { "location": "206/TALK"  , "narrator": "エリカ", "text": "迷い込んだ、という方が\n正しいかもしれないね。"},
        { "location": "207/TALK"  , "narrator": "エリカ", "text": "恐らくは、神楽ちゃんの\n攻撃で、つばめちゃんの\nココロに隙ができた。"},
        { "location": "208/TALK"  , "narrator": "エリカ", "text": "それは瞬間的なもの\nだったけど、日本の一部を\n書き換えてしまった。"},
        { "location": "209/TALK"  , "narrator": "エリカ", "text": "あの瞬間、日本は２つの\n世界が局所的に入り乱れた\n状態になっていたの。"},
        { "location": "210/TALK"  , "narrator": "エリカ", "text": "フェノメノンの中に\n別のフェノメノンが\n混ざってる状態？"},
        { "location": "211/SEL"   , "narrator": "", "text": "何故千羽鶴にそんな力が？"},
        { "location": "212/ACT"   , "narrator": "", "text": "何故千羽鶴にそんな力が？"},
        { "location": "214/TALK"  , "narrator": "エリカ", "text": "それについては…、\n今回の記録映像を\n見てくれた方が早いかな。"},
        { "location": "215/TALK"  , "narrator": "エリカ", "text": "他は？"},
        { "location": "217/ACT"   , "narrator": "", "text": "千羽鶴って結局何者なの？"},
        { "location": "218/TALK"  , "narrator": "エリカ", "text": "わたしが今ここで\n説明してもいいけど――"},
        { "location": "219/TALK"  , "narrator": "エリカ", "text": "それより、今回の記録\n映像を見てもらった方が\n分かりやすいし的確だよ。"},
        { "location": "221/TALK"  , "narrator": "エリカ", "text": "今回はなんとか記録映像を\n２回まわす事ができたから\n先を知ってるんだ。"},
        { "location": "222/SEL"   , "narrator": "", "text": "そういえば、なんで千羽鶴には、何度も試行錯誤する能力があるの？"},
        { "location": "223/ACT"   , "narrator": "", "text": "そういえば、なんで千羽鶴は何度も試行錯誤する能力があるの？"},
        { "location": "225/TALK"  , "narrator": "エリカ", "text": "それも、記録映像を\n見てもらってから\n説明すればすぐだから。"},
        { "location": "226/TALK"  , "narrator": "エリカ", "text": "まずは見てみよ？"},
        { "location": "227/TALK"  , "narrator": "エリカ", "text": "他は？"},
        { "location": "229/ACT"   , "narrator": "", "text": "もう大丈夫 \n<color=blue>（※先へ進みます）</color>"},
        { "location": "231/TALK"  , "narrator": "エリカ", "text": "うん、わかった。"},
        { "location": "232/TALK"  , "narrator": "エリカ", "text": "それじゃ、今回の\n記録映像を見よっか。"},
        { "location": "234/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/82MB 5:17】</color>"},
        { "location": "235/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/27MB 5:17】</color>"},
        { "location": "236/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "237/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/82MB 5:17】</color>"},
        { "location": "238/TALK"  , "narrator": "エリカ", "text": "わかった。"},
        { "location": "244/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/27MB 5:17】</color>"},
        { "location": "245/TALK"  , "narrator": "エリカ", "text": "わかった。"},
        { "location": "251/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "252/TALK"  , "narrator": "エリカ", "text": "あらら。"},
        { "location": "285/TALK"  , "narrator": "エリカ", "text": "――ということなの。"},
        { "location": "286/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんは、\nつばめちゃんのクラン。"},
        { "location": "287/TALK"  , "narrator": "エリカ", "text": "そして、今の日本を\n形成しているのは\n千羽鶴ちゃんなの。"},
        { "location": "289/SEL"   , "narrator": "", "text": "千羽鶴がいるのにつばめがいる？？"},
        { "location": "290/SEL"   , "narrator": "", "text": "千羽鶴が記録映像の試行錯誤を何度も出来るのって…"},
        { "location": "291/SEL"   , "narrator": "", "text": "そっちの世界は、こっちの2016年の映し鏡なのに改変出来るの？"},
        { "location": "292/SEL"   , "narrator": "", "text": "もう大丈夫 \n<color=blue>（※先へ進みます）</color>"},
        { "location": "293/ACT"   , "narrator": "", "text": "千羽鶴がいるのにつばめがいる？？"},
        { "location": "294/TALK"  , "narrator": "エリカ", "text": "クランはそのフェノメノン\nにおいては神にも近い\n存在なの。"},
        { "location": "295/TALK"  , "narrator": "エリカ", "text": "だから、程度の差こそあれ\n本人を量産することさえ\n可能ではあるよ。"},
        { "location": "296/TALK"  , "narrator": "エリカ", "text": "ただ、その場合は\n虚像で人間じゃないけど。"},
        { "location": "297/SEL"   , "narrator": "", "text": "じゃあ、つばめも虚像なの？"},
        { "location": "298/ACT"   , "narrator": "", "text": "じゃあ、つばめも虚像なの？"},
        { "location": "300/TALK"  , "narrator": "エリカ", "text": "ううん。\nつばめちゃんはホンモノ。"},
        { "location": "301/TALK"  , "narrator": "エリカ", "text": "通常、クランが抜けて\nしまうと、本体は文字通り\n抜け殻になってしまう。"},
        { "location": "302/TALK"  , "narrator": "エリカ", "text": "けど、つばめちゃんの\n能力は、一般の人のそれを\n遙かに凌駕する。"},
        { "location": "303/TALK"  , "narrator": "エリカ", "text": "その為、千羽鶴が分離\nしても尚、自我を保って\n存在できているの。"},
        { "location": "304/TALK"  , "narrator": "エリカ", "text": "ただ、千羽鶴ちゃんが\n抜けているから、性格は\n少し変わってるけど。"},
        { "location": "305/SEL"   , "narrator": "", "text": "怒らないところとか？"},
        { "location": "306/ACT"   , "narrator": "", "text": "怒らないところとか？"},
        { "location": "308/TALK"  , "narrator": "エリカ", "text": "そうだね。"},
        { "location": "309/TALK"  , "narrator": "エリカ", "text": "喜怒哀楽の感覚は、\n普通の人とは少しだけ\n違ってるかも。"},
        { "location": "310/TALK"  , "narrator": "エリカ", "text": "他はどうかな？"},
        { "location": "312/ACT"   , "narrator": "", "text": "千羽鶴が記録映像の試行錯誤を何度も出来るのって…"},
        { "location": "313/TALK"  , "narrator": "エリカ", "text": "自分が創造した\n世界だからだよ。"},
        { "location": "314/TALK"  , "narrator": "エリカ", "text": "前にもちょこっと話した\nけど、千羽鶴ちゃんは、\n世界を改変できる。"},
        { "location": "315/TALK"  , "narrator": "エリカ", "text": "もちろん、つばめちゃんと\nいう枷があるから、かなり\n制限はかかるんだけど。"},
        { "location": "316/TALK"  , "narrator": "エリカ", "text": "物のある場所を変えたり\nするくらいの状況改変は\n普通にできる。"},
        { "location": "317/TALK"  , "narrator": "エリカ", "text": "だから、それができない\nわたしの10倍、100倍の\n確度で未来を誘導できる。"},
        { "location": "318/TALK"  , "narrator": "エリカ", "text": "それにプラスして、\n彼女はレディネスと\n直結してるし。"},
        { "location": "319/SEL"   , "narrator": "", "text": "レディネスって何？"},
        { "location": "320/ACT"   , "narrator": "", "text": "レディネスって何？"},
        { "location": "322/TALK"  , "narrator": "エリカ", "text": "2031年現在において、\n広く普及している\n情報端末だよ。"},
        { "location": "323/TALK"  , "narrator": "エリカ", "text": "量子論を応用した通信を\n行うことで、テレパシー\nのような通信が可能なの。"},
        { "location": "324/TALK"  , "narrator": "エリカ", "text": "通信は５感を通じてでは\nなくて、直接脳内で\n処理される。"},
        { "location": "325/TALK"  , "narrator": "エリカ", "text": "究極のウェアラブル端末\nといったところかな。"},
        { "location": "326/TALK"  , "narrator": "エリカ", "text": "もちろんわたしも、\nそして綾ちゃんたちも\nみんな入れてる。"},
        { "location": "327/TALK"  , "narrator": "エリカ", "text": "権限にもよるけど、\nレディネスを介して\n量子的な操作も可能。"},
        { "location": "328/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんは、\nその持っている権限が\nとても大きい。"},
        { "location": "329/TALK"  , "narrator": "エリカ", "text": "特殊な\nレディネスだからね。"},
        { "location": "330/TALK"  , "narrator": "エリカ", "text": "記録映像は、そういった\n機能を使って作り出した\n映像なんだ。"},
        { "location": "331/TALK"  , "narrator": "エリカ", "text": "他はどうかな？"},
        { "location": "333/ACT"   , "narrator": "", "text": "そっちの世界は、こっちの2016年の映し鏡なのに改変出来るの？"},
        { "location": "335/TALK"  , "narrator": "エリカ", "text": "あくまで、ベースにしてる\nというだけのことだよ。"},
        { "location": "336/TALK"  , "narrator": "エリカ", "text": "そうでなければ、\n情報管理庁だって\n作れないはずでしょ？"},
        { "location": "337/TALK"  , "narrator": "エリカ", "text": "普通の人が作り出す\nフェノメノンが、白紙から\n描いているのに対し――"},
        { "location": "338/TALK"  , "narrator": "エリカ", "text": "つばめちゃんの場合は、\n2016年の世界をベースに\n改変してる感じかな。"},
        { "location": "339/TALK"  , "narrator": "エリカ", "text": "その改変度合や方向性で\nつばめちゃんと千羽鶴は\n終始潜在的に牽制してる。"},
        { "location": "340/TALK"  , "narrator": "エリカ", "text": "だから結果的に、\n局所的な改変に\n留まってるというわけ。"},
        { "location": "341/TALK"  , "narrator": "エリカ", "text": "与党と野党が拮抗した\n国会では、革新的な決定が\n出来ないのと似てるかな。"},
        { "location": "342/TALK"  , "narrator": "エリカ", "text": "他はどうかな？"},
        { "location": "344/ACT"   , "narrator": "", "text": "もう大丈夫 \n<color=blue>（※先へ進みます）</color>"},
        { "location": "346/TALK"  , "narrator": "エリカ", "text": "わかった。"},
        { "location": "347/TALK"  , "narrator": "エリカ", "text": "それじゃ、\n今回お願いしたいことを\n伝えるね。"},
        { "location": "352/TALK"  , "narrator": "エリカ", "text": "今回の\nつばめちゃんだけど――"},
        { "location": "353/TALK"  , "narrator": "エリカ", "text": "やっぱりまだ\n回線が繋がらない\nみたいだね。"},
        { "location": "354/TALK"  , "narrator": "エリカ", "text": "早急になんとか連絡とる\n手段を考えるけど、今回も\nココロ側の支援をお願い。"},
        { "location": "355/TALK"  , "narrator": "エリカ", "text": "せめて、つばめちゃんの\nガジェットが手元にあれば\n何とかなるんだけど…。"},
        { "location": "356/TALK"  , "narrator": "エリカ", "text": "個体識別IDを、別の試験用\n個体とかに変更すれば、\n解決するかもしれないし。"},
        { "location": "357/TALK"  , "narrator": "エリカ", "text": "あなたが指示して\nつばめちゃんにやって\nもらうのは――"},
        { "location": "359/TALK"  , "narrator": "エリカ", "text": "やっぱりちょっと\n難しいかも。"},
        { "location": "360/TALK"  , "narrator": "エリカ", "text": "かなり専門的な知識が\n必要になってくるしね。"},
        { "location": "361/TALK"  , "narrator": "エリカ", "text": "とにかく、何とかして\n方法は探るから、その間\nココロの方を宜しくね。"},
        { "location": "365/TALK"  , "narrator": "エリカ", "text": "今回の綾ちゃんに\nついてだけど――"},
        { "location": "366/TALK"  , "narrator": "エリカ", "text": "今回は特に、わたしから\n何かお願いすることは\nないかな。"},
        { "location": "367/TALK"  , "narrator": "エリカ", "text": "ただ……"},
        { "location": "368/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "369/SEL"   , "narrator": "", "text": "…どうしたの？"},
        { "location": "370/ACT"   , "narrator": "", "text": "…どうしたの？"},
        { "location": "372/TALK"  , "narrator": "エリカ", "text": "え？\nあ、ううん。\nなんでもないの。"},
        { "location": "373/TALK"  , "narrator": "エリカ", "text": "ちょっと\n悩んでることが\nあって。"},
        { "location": "374/TALK"  , "narrator": "エリカ", "text": "でもやっぱり、今回はまだ\n綾ちゃんにお願いするか\nどうか決められないから、"},
        { "location": "375/TALK"  , "narrator": "エリカ", "text": "綾ちゃんを\n暖かく見守ってあげて\n欲しいかも。"},
        { "location": "376/TALK"  , "narrator": "エリカ", "text": "でも、次回までには絶対\n決めなくちゃいけない\nことだから――"},
        { "location": "377/TALK"  , "narrator": "エリカ", "text": "こっちも、それまでには\n結論を出しておくね。"},
        { "location": "381/TALK"  , "narrator": "エリカ", "text": "さて、今回の\nガブリエラちゃんだけど。"},
        { "location": "382/TALK"  , "narrator": "エリカ", "text": "今回は特にお願いしたい\nことは無いんだけど――"},
        { "location": "383/TALK"  , "narrator": "エリカ", "text": "やっぱりフェノメノンの\n中だったことに、動揺を\n隠せないみたい。"},
        { "location": "384/TALK"  , "narrator": "エリカ", "text": "精神的にちょっと\n揺れちゃってるから、\n話し相手になってあげて？"},
        { "location": "388/TALK"  , "narrator": "エリカ", "text": "さて、今回の\nみやびちゃんだけど。"},
        { "location": "389/TALK"  , "narrator": "エリカ", "text": "とにかく、頑張って\nわたしの資料を読み解いて\nもらわなくちゃ。"},
        { "location": "390/TALK"  , "narrator": "エリカ", "text": "その為には、常に客観的で\n冷静になって物事を\n考えなくちゃだけど――"},
        { "location": "391/TALK"  , "narrator": "エリカ", "text": "やっぱり今は、\nフェノメノンの中だった\nことに動揺してるみたい。"},
        { "location": "392/TALK"  , "narrator": "エリカ", "text": "あなたからも彼女に\n話しかけたりして、\n助けてあげてね？"},
        { "location": "393/SEL"   , "narrator": "", "text": "でも、その関係も今回で終わりかもしれない"},
        { "location": "394/ACT"   , "narrator": "", "text": "でも、その関係も今回で終わりかもしれない"},
        { "location": "397/TALK"  , "narrator": "エリカ", "text": "ええっ！？\n一体どうしちゃったの？"},
        { "location": "398/TALK"  , "narrator": "エリカ", "text": "みやびちゃんのこと、\n嫌いになっちゃった？"},
        { "location": "399/SEL"   , "narrator": "", "text": "みやびの新しい司書に追放されそうになってる"},
        { "location": "400/ACT"   , "narrator": "", "text": "みやびの新しい司書に追放されそうになってる"},
        { "location": "402/TALK"  , "narrator": "エリカ", "text": "え？\nそんなことに\nなってたの？"},
        { "location": "404/TALK"  , "narrator": "エリカ", "text": "うーん、そっかー。\nうーん……。"},
        { "location": "405/TALK"  , "narrator": "エリカ", "text": "……わかった。"},
        { "location": "406/TALK"  , "narrator": "エリカ", "text": "こっちでも何か\n対策を考えてみる。"},
        { "location": "407/TALK"  , "narrator": "エリカ", "text": "けど、今回には\n間に合わないと思うから…"},
        { "location": "408/TALK"  , "narrator": "エリカ", "text": "何とか今回だけは、\n追放されないように\n頑張ってみて？"},
        { "location": "409/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "410/SEL"   , "narrator": "", "text": "自信ない…"},
        { "location": "411/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "412/TALK"  , "narrator": "エリカ", "text": "うん。"},
        { "location": "413/ACT"   , "narrator": "", "text": "自信ない…"},
        { "location": "414/TALK"  , "narrator": "エリカ", "text": "大丈夫だよ！"},
        { "location": "415/TALK"  , "narrator": "エリカ", "text": "みやびちゃんだって、\n全部が全部、あなたと\n別れたいわけじゃない。"},
        { "location": "416/TALK"  , "narrator": "エリカ", "text": "あなたと別れたくない\n気持ちの方が、遙かに\n強い筈なんだよ？"},
        { "location": "417/TALK"  , "narrator": "エリカ", "text": "ここであなたが諦めたら、\nみやびちゃんが\n可哀想だよ。"},
        { "location": "418/TALK"  , "narrator": "エリカ", "text": "結果的にどうなるかは\nさておいて、最後まで\n諦めずにやろうよ。"},
        { "location": "419/TALK"  , "narrator": "エリカ", "text": "わたしも一緒に\n解決の糸口を探すから。"},
        { "location": "420/TALK"  , "narrator": "エリカ", "text": "…ね？"},
        { "location": "428/TALK"  , "narrator": "エリカ", "text": "あと、今回も\n東京側の動向を少しだけ\n追加しておいたよ。"},
        { "location": "430/TALK"  , "narrator": "エリカ", "text": "今回はとっても重要な\n回になるから、是非\n手伝ってあげてね？"},
        { "location": "435/TALK"  , "narrator": "エリカ", "text": "というわけで――"},
        { "location": "436/SEL"   , "narrator": "", "text": "はいストップ"},
        { "location": "437/SEL"   , "narrator": "", "text": "（何も言わない）"},
        { "location": "438/ACT"   , "narrator": "", "text": "はいストップ"},
        { "location": "440/TALK"  , "narrator": "エリカ", "text": "え！？"},
        { "location": "441/SEL"   , "narrator": "", "text": "何かお忘れではありませんか？"},
        { "location": "442/ACT"   , "narrator": "", "text": "何かお忘れではありませんか？"},
        { "location": "444/TALK"  , "narrator": "エリカ", "text": "えっと…？"},
        { "location": "445/SEL"   , "narrator": "", "text": "パーツ屋"},
        { "location": "446/ACT"   , "narrator": "", "text": "パーツ屋"},
        { "location": "448/TALK"  , "narrator": "エリカ", "text": "ああっ！！"},
        { "location": "450/TALK"  , "narrator": "エリカ", "text": "そうだったね、\nパーツ屋でデートするって\n言ってたんだ。"},
        { "location": "451/TALK"  , "narrator": "エリカ", "text": "ごめんね、ちょっと\n色々バタバタしてて\nウッカリしてたよ。"},
        { "location": "452/TALK"  , "narrator": "エリカ", "text": "けど、ちゃんと準備は\nしてあったんだよ？"},
        { "location": "453/SEL"   , "narrator": "", "text": "ほんと！？"},
        { "location": "454/SEL"   , "narrator": "", "text": "遅いよー"},
        { "location": "455/ACT"   , "narrator": "", "text": "ほんと！？"},
        { "location": "456/TALK"  , "narrator": "エリカ", "text": "うん！\n楽しみにしてたんだから。"},
        { "location": "457/ACT"   , "narrator": "", "text": "遅いよー"},
        { "location": "458/TALK"  , "narrator": "エリカ", "text": "ごめんね？"},
        { "location": "459/TALK"  , "narrator": "エリカ", "text": "でも、そのぶん思いっきり\n楽しもうね！"},
        { "location": "461/TALK"  , "narrator": "エリカ", "text": "それじゃ、いくよ！"},
        { "location": "466/TALK"  , "narrator": "エリカ", "text": "はぁー、\n楽しかったね！"},
        { "location": "467/SEL"   , "narrator": "", "text": "エリカさんかわいかった"},
        { "location": "468/SEL"   , "narrator": "", "text": "もっと長居したかった"},
        { "location": "469/ACT"   , "narrator": "", "text": "エリカさんかわいかった"},
        { "location": "471/TALK"  , "narrator": "エリカ", "text": "えーっ。\nそうなの！？"},
        { "location": "472/TALK"  , "narrator": "エリカ", "text": "なんか、変なお話ばかり\nしちゃってたし……。"},
        { "location": "474/TALK"  , "narrator": "エリカ", "text": "ごめんね？"},
        { "location": "475/SEL"   , "narrator": "", "text": "もっといっぱい変なお話して？"},
        { "location": "476/SEL"   , "narrator": "", "text": "次は違う話題で"},
        { "location": "477/ACT"   , "narrator": "", "text": "もっといっぱい変なお話して？"},
        { "location": "478/TALK"  , "narrator": "エリカ", "text": "ほんとに？"},
        { "location": "479/TALK"  , "narrator": "エリカ", "text": "それじゃ、またお言葉に\n甘えちゃおうかな？"},
        { "location": "480/ACT"   , "narrator": "", "text": "次は違う話題で"},
        { "location": "481/TALK"  , "narrator": "エリカ", "text": "うん、そうだね。"},
        { "location": "483/ACT"   , "narrator": "", "text": "もっと長居したかった"},
        { "location": "484/TALK"  , "narrator": "エリカ", "text": "そうなの！？"},
        { "location": "485/TALK"  , "narrator": "エリカ", "text": "もしかして、\nあなたもパーツ屋さんが\n好きなのかな？"},
        { "location": "486/SEL"   , "narrator": "", "text": "エリカさんと一緒にいたいの"},
        { "location": "487/SEL"   , "narrator": "", "text": "実は好き"},
        { "location": "488/ACT"   , "narrator": "", "text": "エリカさんと一緒にいたいの"},
        { "location": "490/TALK"  , "narrator": "エリカ", "text": "そっかー。"},
        { "location": "491/TALK"  , "narrator": "エリカ", "text": "それじゃ、次回も\nまた来てくれたら\n嬉しいかな…えへへ。"},
        { "location": "492/ACT"   , "narrator": "", "text": "実は好き"},
        { "location": "494/TALK"  , "narrator": "エリカ", "text": "ほんと！？"},
        { "location": "496/TALK"  , "narrator": "エリカ", "text": "それじゃまた一緒に\nパーツ屋さんに行こうね？"},
        { "location": "497/TALK"  , "narrator": "エリカ", "text": "今度は、あなたの\nこだわりを教えてくれると\n嬉しいかな！"},
        { "location": "501/ACT"   , "narrator": "", "text": "（何も言わない）"},
        { "location": "504/TALK"  , "narrator": "エリカ", "text": "それじゃ、\n今回もよろしく\nお願いします！"},
        { "location": "116/DIALOG", "narrator": "Event/Dialog_EventPic", "text": "綾ちゃんロボット（仮）"},
        { "location": "262/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "264/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "266/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "268/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "270/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"},
        { "location": "426/DIALOG", "narrator": "Event/Dialog_EventPicWideNW", "text": "サイドストーリーサービスが、開始されました。\n【イベントクエスト】にアクセスしてください。"}
    ]
}
