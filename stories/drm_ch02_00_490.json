        { "location": "7/SCENARIO", "narrator": "", "text": "410_やっぱり乙女"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "言っておきたいの(￣Д￣ )"},
        { "location": "35/SEL"    , "narrator": "", "text": "愛の言葉？"},
        { "location": "36/SEL"    , "narrator": "", "text": "何かなー"},
        { "location": "37/ACT"    , "narrator": "", "text": "愛の言葉？"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "ある意味"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "50/ACT"    , "narrator": "", "text": "何かなー"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "全然覚えてないかもしれないわね"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "本人は"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "前に彼氏がいなくても平気そうって言ったわよね"},
        { "location": "56/SEL"    , "narrator": "", "text": "言ったね"},
        { "location": "57/SEL"    , "narrator": "", "text": "言ったっけ？"},
        { "location": "58/SEL"    , "narrator": "", "text": "$me$に恋人はいない！"},
        { "location": "59/ACT"    , "narrator": "", "text": "言ったね"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "言ったでしょ"},
        { "location": "61/ACT"    , "narrator": "", "text": "言ったっけ？"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "言ったわよ"},
        { "location": "63/ACT"    , "narrator": "", "text": "$me$に恋人はいない！"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "その通りだわ"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "知ってるから"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "あれって"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "なんだったのかしら(-ω-;)"},
        { "location": "80/SEL"    , "narrator": "", "text": "今彼氏いるからいいじゃない"},
        { "location": "81/SEL"    , "narrator": "", "text": "嫉妬……的な？"},
        { "location": "82/ACT"    , "narrator": "", "text": "今彼氏いるからいいじゃない"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "そういうことじゃないわよ（｀皿´ )"},
        { "location": "84/ACT"    , "narrator": "", "text": "嫉妬……的な？"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "嫉妬って"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "そうじゃないでしょ"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "（ノ ﾟДﾟ）ノ\n　　＝＝＝＝　┻━━┻ "},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "そういう時は"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "立候補したりするものよ(--*;"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "もー！！！！！！"},
        { "location": "93/SEL"    , "narrator": "", "text": "ごめんね"},
        { "location": "94/SEL"    , "narrator": "", "text": "そうだったんだ！"},
        { "location": "95/ACT"    , "narrator": "", "text": "ごめんね"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "まあ別に"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "いいわよ、、、"},
        { "location": "98/ACT"    , "narrator": "", "text": "そうだったんだ！"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "そうよ！"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "わからないひとね"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "まあ今はその(>_<)"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "おつきあいしてるからもういいんだけど"},
        { "location": "107/SEL"   , "narrator": "", "text": "じゃあいいよね"},
        { "location": "108/SEL"   , "narrator": "", "text": "好きだよ、アーヤ"},
        { "location": "109/SEL"   , "narrator": "", "text": "気になったことは教えて"},
        { "location": "110/ACT"   , "narrator": "", "text": "じゃあいいよね"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "工ｴｴｪｪ(´д｀)ｪｪｴｴ工"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "そういうことじゃないの"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "もう！"},
        { "location": "115/ACT"   , "narrator": "", "text": "好きだよ、アーヤ"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "またそうやって、、、(-.-;)"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "私も好きよ(^ε^)-☆!!"},
        { "location": "130/ACT"   , "narrator": "", "text": "気になったことは教えて"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "本当は気づいて欲しいの"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "仕方ないわね"},
