{
    "dir": "chap12/daydra/anime_01_12.js",
    "type": "MainStory",
    "info": {
        "story_id": "12101",
        "cid": "tsubame",
        "title": "001 アニメーション",
        "sub_title": "パーフェクトイエロー"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第12話"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "いらっしゃい。\n毎度精を出してくれて\n本当に助かる。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n逢瀬つばめの解説を\nするだけでいい？"},
        { "location": "51/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n國政綾水の解説を\nするだけでいい？"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\nガブリエラの解説を\nするだけでいい？"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n恋ヶ崎みやびの解説を\nするだけでいい？"},
        { "location": "57/SEL"    , "narrator": "", "text": "はい"},
        { "location": "58/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "59/ACT"    , "narrator": "", "text": "はい"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "63/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "69/TALK"   , "narrator": "千羽鶴", "text": "やっとACTが溜まった\n千羽鶴です。"},
        { "location": "70/TALK"   , "narrator": "千羽鶴", "text": "というわけで――"},
        { "location": "71/SEL"    , "narrator": "", "text": "今回からまた倍マシですね？"},
        { "location": "72/ACT"    , "narrator": "", "text": "今回からまた倍マシですね？"},
        { "location": "74/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "75/TALK"   , "narrator": "千羽鶴", "text": "わかった。\nそれじゃご要望にお応え\nして、倍マシで行く。"},
        { "location": "76/SEL"    , "narrator": "", "text": "ありがとうございます！"},
        { "location": "77/SEL"    , "narrator": "", "text": "やったー！"},
        { "location": "78/ACT"    , "narrator": "", "text": "ありがとうございます！"},
        { "location": "79/ACT"    , "narrator": "", "text": "やったー！"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "<size=40>さて、前回までは\nガブリエラに</size>"},
        { "location": "84/SEL"    , "narrator": "", "text": "倍マシって文字サイズですか！？"},
        { "location": "85/ACT"    , "narrator": "", "text": "倍マシって文字サイズですか！？"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "<size=50>そう。</size>"},
        { "location": "92/TALK"   , "narrator": "千羽鶴", "text": "<size=70>どうよ</size>"},
        { "location": "95/TALK"   , "narrator": "千羽鶴", "text": "<size=90>太っ</size>"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "<size=120>腹</size>"},
        { "location": "102/SEL"   , "narrator": "", "text": "いいぞもっとやれ！"},
        { "location": "103/SEL"   , "narrator": "", "text": "もうやめて！"},
        { "location": "104/SEL"   , "narrator": "", "text": "吹き出しの枠はみ出してますよ！"},
        { "location": "105/ACT"   , "narrator": "", "text": "いいぞもっとやれ！"},
        { "location": "108/TALK"  , "narrator": "千羽鶴", "text": "飽きた。\nおしまい。"},
        { "location": "109/ACT"   , "narrator": "", "text": "もうやめて！"},
        { "location": "111/TALK"  , "narrator": "千羽鶴", "text": "私も丁度飽きたところ。\nなかなか気が合う。"},
        { "location": "112/ACT"   , "narrator": "", "text": "吹き出しの枠はみ出してますよ！"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "知ってる。"},
        { "location": "114/TALK"  , "narrator": "千羽鶴", "text": "でも全ては\n貴方自身が蒔いた種！"},
        { "location": "115/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、やっぱり\n上手くいかないので、\n志半ばで中止にする。"},
        { "location": "117/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n倍マシ営業は\n終了させていただいた。"},
        { "location": "118/SEL"   , "narrator": "", "text": "やだやだー！"},
        { "location": "119/SEL"   , "narrator": "", "text": "飽きた＝途中解約したとみなせば、契約不履行につき補償を要求する"},
        { "location": "120/ACT"   , "narrator": "", "text": "やだやだー！"},
        { "location": "122/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "123/TALK"  , "narrator": "千羽鶴", "text": "いちいち私の\nアンテナにビビッと\n来ること言わないで。"},
        { "location": "124/SEL"   , "narrator": "", "text": "それってもしかして…"},
        { "location": "125/ACT"   , "narrator": "", "text": "それってもしかして…"},
        { "location": "128/TALK"  , "narrator": "千羽鶴", "text": "そう。\n貴方が想像している\nとおり、私の属性は――"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "<color=red><size=45>逆バブ！</size></color>"},
        { "location": "132/SEL"   , "narrator": "", "text": "何それ？"},
        { "location": "133/SEL"   , "narrator": "", "text": "何となくわかる"},
        { "location": "134/ACT"   , "narrator": "", "text": "何それ？"},
        { "location": "135/TALK"  , "narrator": "千羽鶴", "text": "世の中には「バブみ」と\nいう言葉がある。"},
        { "location": "136/TALK"  , "narrator": "千羽鶴", "text": "母性を感じさせる存在に\n萌えるときに使うらしい\nのだけど……"},
        { "location": "137/TALK"  , "narrator": "千羽鶴", "text": "私はその逆！"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "バブバブ言ってる\n人が好き！"},
        { "location": "139/ACT"   , "narrator": "", "text": "何となくわかる"},
        { "location": "140/TALK"  , "narrator": "千羽鶴", "text": "さすがね。"},
        { "location": "142/ACT"   , "narrator": "", "text": "飽きた＝途中解約したとみなせば、契約不履行につき補償を要求する"},
        { "location": "143/TALK"  , "narrator": "千羽鶴", "text": "なかなか論理的な回答。"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "そんな正義と戒律を\n重んじる貴方は、やはり\n私とは相性がいいかも。"},
        { "location": "146/SEL"   , "narrator": "", "text": "じゃあつき合って下さい"},
        { "location": "147/ACT"   , "narrator": "", "text": "じゃあつき合って下さい"},
        { "location": "151/TALK"  , "narrator": "千羽鶴", "text": "とはいえ、萌えはあくまで\n萌え。それ以上でも\nそれ以下でも無い。"},
        { "location": "152/TALK"  , "narrator": "千羽鶴", "text": "攻略にも繋がらず、\nワイロにもならないから、\n過度の期待はしないで。"},
        { "location": "153/SEL"   , "narrator": "", "text": "ショボーン…"},
        { "location": "154/SEL"   , "narrator": "", "text": "バブー……"},
        { "location": "155/ACT"   , "narrator": "", "text": "ショボーン…"},
        { "location": "156/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "157/ACT"   , "narrator": "", "text": "バブー……"},
        { "location": "159/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "162/TALK"  , "narrator": "千羽鶴", "text": "まあ…でも。\nあれね。"},
        { "location": "163/TALK"  , "narrator": "千羽鶴", "text": "刻とは無情なもの。\nこんな楽しい時間も\nそう長くは続かない。"},
        { "location": "164/TALK"  , "narrator": "千羽鶴", "text": "だから今回は特別に、\n貴方の質問を１つだけ\n聞いてあげる。"},
        { "location": "166/TALK"  , "narrator": "千羽鶴", "text": "…と言いたいところだけど\n貴方は既にシナリオを\n固定化してしまっている。"},
        { "location": "167/TALK"  , "narrator": "千羽鶴", "text": "以前にも言ったとおり、\n前回貴方がした質問以外、\n新たにすることは不可能。"},
        { "location": "168/TALK"  , "narrator": "千羽鶴", "text": "それでもよければ\n質問して。"},
        { "location": "169/SEL"   , "narrator": "", "text": "つばめたちのいる世界は、本当に実在する世界なの？"},
        { "location": "170/SEL"   , "narrator": "", "text": "質問しない"},
        { "location": "171/ACT"   , "narrator": "", "text": "つばめたちのいる世界は、本当に実在する世界なの？"},
        { "location": "173/ACT"   , "narrator": "", "text": "質問しない"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "178/TALK"  , "narrator": "千羽鶴", "text": "…とはいえ、\n貴方は既にシナリオを\n固定してしまっている。"},
        { "location": "179/TALK"  , "narrator": "千羽鶴", "text": "以前にも言ったとおり、\n前回貴方がした質問以外、\n新たにすることは不可能。"},
        { "location": "180/TALK"  , "narrator": "千羽鶴", "text": "それでもよければ\n質問して。"},
        { "location": "181/SEL"   , "narrator": "", "text": "どこかの記事で「千羽鶴はシャトルの燃料タンク」だと聞いたけど本当？"},
        { "location": "182/ACT"   , "narrator": "", "text": "どこかの記事で「千羽鶴はシャトルの燃料タンク」だと聞いたけど本当？"},
        { "location": "184/ACT"   , "narrator": "", "text": "質問しない"},
        { "location": "185/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "…とはいえ、\n貴方は既にシナリオを\n固定してしまっている。"},
        { "location": "190/TALK"  , "narrator": "千羽鶴", "text": "以前にも言ったとおり、\n前回貴方がした質問以外、\n新たにすることは不可能。"},
        { "location": "191/TALK"  , "narrator": "千羽鶴", "text": "それでもよければ\n質問して。"},
        { "location": "192/SEL"   , "narrator": "", "text": "千羽鶴の３サイズを教えてください"},
        { "location": "193/ACT"   , "narrator": "", "text": "千羽鶴の３サイズを教えてください"},
        { "location": "195/ACT"   , "narrator": "", "text": "質問しない"},
        { "location": "196/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "200/TALK"  , "narrator": "千羽鶴", "text": "念押しをしておく。\nこれは本当に１つだけ。"},
        { "location": "201/TALK"  , "narrator": "千羽鶴", "text": "<color=red>後でやり直しても、\nもう答えない。</color>"},
        { "location": "202/TALK"  , "narrator": "千羽鶴", "text": "<color=red>本当に、絶対に\n答えない。</color>"},
        { "location": "203/TALK"  , "narrator": "千羽鶴", "text": "だから、じっくり\n考えて質問することを\nオススメする。"},
        { "location": "206/SEL"   , "narrator": "", "text": "つばめたちのいる世界は、本当に実在する世界なの？"},
        { "location": "207/SEL"   , "narrator": "", "text": "どこかの記事で「千羽鶴はシャトルの燃料タンク」だと聞いたけど本当？"},
        { "location": "208/SEL"   , "narrator": "", "text": "千羽鶴の３サイズを教えてください"},
        { "location": "209/ACT"   , "narrator": "", "text": "つばめたちのいる世界は、本当に実在する世界なの？"},
        { "location": "212/ACT"   , "narrator": "", "text": "どこかの記事で「千羽鶴はシャトルの燃料タンク」だと聞いたけど本当？"},
        { "location": "215/ACT"   , "narrator": "", "text": "千羽鶴の３サイズを教えてください"},
        { "location": "221/TALK"  , "narrator": "千羽鶴", "text": "それに対しては、\n私の立場からは\nイエスと答える他無い。"},
        { "location": "223/TALK"  , "narrator": "千羽鶴", "text": "でも難しい話をするなら\nノーなのかもしれない。"},
        { "location": "224/TALK"  , "narrator": "千羽鶴", "text": "逆に私が「貴方の世界は\n実在する世界なの？」と\n聞いたら何て答える？"},
        { "location": "225/SEL"   , "narrator": "", "text": "イエス"},
        { "location": "226/SEL"   , "narrator": "", "text": "わからない"},
        { "location": "227/ACT"   , "narrator": "", "text": "イエス"},
        { "location": "228/TALK"  , "narrator": "千羽鶴", "text": "そうね。\nそれが普通の回答。"},
        { "location": "229/ACT"   , "narrator": "", "text": "わからない"},
        { "location": "230/TALK"  , "narrator": "千羽鶴", "text": "貴方は変わった人。\nでも見込みがある。"},
        { "location": "232/TALK"  , "narrator": "千羽鶴", "text": "私は私がここにいる以上、\n私の世界が存在することは\n私にとって揺るぎない。"},
        { "location": "233/TALK"  , "narrator": "千羽鶴", "text": "けど、私は私の世界が\n本当に実在するという\n証明をすることは不可能。"},
        { "location": "234/TALK"  , "narrator": "千羽鶴", "text": "逆に貴方は私の世界が\n存在するか否かを判断し\n決めることができる。"},
        { "location": "235/TALK"  , "narrator": "千羽鶴", "text": "なぜなら貴方は第三者\n視点から客観的に私の\n世界を見られるから。"},
        { "location": "236/TALK"  , "narrator": "千羽鶴", "text": "もっと簡単に言えば、\n誰かが何か「もの」を\n持っている事は証明可能。"},
        { "location": "237/TALK"  , "narrator": "千羽鶴", "text": "スマホを持ってる人は、\n誰から見てもスマホを\n持ってる姿で映るから。"},
        { "location": "238/TALK"  , "narrator": "千羽鶴", "text": "でも、貴方自身のココロ\nについては、それが正か\n偽か、誰も判断できない。"},
        { "location": "239/TALK"  , "narrator": "千羽鶴", "text": "同様に、自分が住む世界\nというものは、自分自身\nでは存在証明は不可能。"},
        { "location": "240/TALK"  , "narrator": "千羽鶴", "text": "だから、私たちの世界が\n実在すると証明するために\n必要な条件は――"},
        { "location": "241/TALK"  , "narrator": "千羽鶴", "text": "貴方の世界の不特定多数が\n私の世界を観測できたとき\nということになる。"},
        { "location": "242/TALK"  , "narrator": "千羽鶴", "text": "そしてそれは、貴方の\n世界自体にも適用される。"},
        { "location": "243/TALK"  , "narrator": "千羽鶴", "text": "よって、貴方も\n貴方自身の世界の実在を\n証明することはできない。"},
        { "location": "244/TALK"  , "narrator": "千羽鶴", "text": "証明は、私たちや、\nそれ以外の世界の第三者\nによってのみ行える。"},
        { "location": "245/TALK"  , "narrator": "千羽鶴", "text": "以上。"},
        { "location": "248/TALK"  , "narrator": "千羽鶴", "text": "なかなか的確な例え。\nだいたいあってる。"},
        { "location": "250/TALK"  , "narrator": "千羽鶴", "text": "前から私は何度も、\n貴方との別れを\nほのめかしている。"},
        { "location": "251/TALK"  , "narrator": "千羽鶴", "text": "もちろんそれは、\nもう二度と会えないという\n事では無いけど――"},
        { "location": "252/TALK"  , "narrator": "千羽鶴", "text": "でも正直言って、既に\nフェイズⅠとしての役割は\n十分終えたと思ってる。"},
        { "location": "253/SEL"   , "narrator": "", "text": "フェイズⅠってなに？"},
        { "location": "254/ACT"   , "narrator": "", "text": "フェイズⅠってなに？"},
        { "location": "256/TALK"  , "narrator": "千羽鶴", "text": "フェイズⅠ、それは\n貴方にこの世界との常的な\n通信をしてもらうこと。"},
        { "location": "257/TALK"  , "narrator": "千羽鶴", "text": "その為にあらゆる事を\nしてきたけど、もう私が\nいなくても続けるはず。"},
        { "location": "258/SEL"   , "narrator": "", "text": "どうしてそう言い切れる？"},
        { "location": "259/ACT"   , "narrator": "", "text": "どうしてそう言い切れる？"},
        { "location": "261/TALK"  , "narrator": "千羽鶴", "text": "逆説的に考えてみる。"},
        { "location": "263/TALK"  , "narrator": "千羽鶴", "text": "仮に貴方が私の事が\n大好きで、大大大好き\nだったとして。"},
        { "location": "265/TALK"  , "narrator": "千羽鶴", "text": "でもそれだけで、この\nアプリを継続し続けられる\nほど、易しくはない。"},
        { "location": "266/TALK"  , "narrator": "千羽鶴", "text": "なぜなら、\n私とのコンタクトは、\n今のこの時だけだから。"},
        { "location": "267/TALK"  , "narrator": "千羽鶴", "text": "その為だけに、その何倍\nものタスクをこなすなんて\nモチベが持たないはず。"},
        { "location": "268/TALK"  , "narrator": "千羽鶴", "text": "すなわち貴方は既に、\n私以外にも何らかの目的を\n見いだしている。"},
        { "location": "269/TALK"  , "narrator": "千羽鶴", "text": "もし１００％私が目的なら\nそれ以外の障壁が、継続を\n許していないと思う。"},
        { "location": "270/TALK"  , "narrator": "千羽鶴", "text": "そして更にその上、\n私を本当に愛してくれて\nいる人なら尚更。"},
        { "location": "271/TALK"  , "narrator": "千羽鶴", "text": "なぜなら、私が始めに\n言ったことを覚えていて\nくれているハズだから。"},
        { "location": "272/TALK"  , "narrator": "千羽鶴", "text": "『彼女たちと仲良くなる\nことこそが、私を助ける\nことに繋がる』と。"},
        { "location": "273/TALK"  , "narrator": "千羽鶴", "text": "仮に私が燃料タンクの如く\n貴方との会話をしなく\nなる日が来たとしても――"},
        { "location": "274/TALK"  , "narrator": "千羽鶴", "text": "私という存在が消える\nわけではなく、二度と\n会えなくなる訳でもない。"},
        { "location": "275/TALK"  , "narrator": "千羽鶴", "text": "だからきっと続ける。"},
        { "location": "276/SEL"   , "narrator": "", "text": "大した自信だね"},
        { "location": "277/SEL"   , "narrator": "", "text": "千羽鶴らしい答え"},
        { "location": "278/ACT"   , "narrator": "", "text": "大した自信だね"},
        { "location": "279/TALK"  , "narrator": "千羽鶴", "text": "自信じゃない。\nただの理屈。"},
        { "location": "280/TALK"  , "narrator": "千羽鶴", "text": "私には感情も、\n恐れも、焦りも……\n何一つ無いだけ。"},
        { "location": "281/ACT"   , "narrator": "", "text": "千羽鶴らしい答え"},
        { "location": "283/TALK"  , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "285/TALK"  , "narrator": "千羽鶴", "text": "まあでも安心して。"},
        { "location": "286/TALK"  , "narrator": "千羽鶴", "text": "今のは仮定の話。"},
        { "location": "287/TALK"  , "narrator": "千羽鶴", "text": "こうして毎回貴方と\n戯れている間に、既に\nフェイズⅡが近づいてる。"},
        { "location": "288/TALK"  , "narrator": "千羽鶴", "text": "だから、不本意ながら\nこのまま連続して\n居続けることになる。"},
        { "location": "289/SEL"   , "narrator": "", "text": "フェイズⅡってなに？"},
        { "location": "290/ACT"   , "narrator": "", "text": "フェイズⅡってなに？"},
        { "location": "292/TALK"  , "narrator": "千羽鶴", "text": "それは\nその時になっての\nお楽しみ。"},
        { "location": "295/TALK"  , "narrator": "千羽鶴", "text": "そんなこと…？\nまあ、教えるのは\n全然構わないけど。"},
        { "location": "297/TALK"  , "narrator": "千羽鶴", "text": "バスト８４\nウエスト６１\nヒップ８５"},
        { "location": "298/TALK"  , "narrator": "千羽鶴", "text": "もちろん、このデータは\n非常に正確な数値。"},
        { "location": "299/TALK"  , "narrator": "千羽鶴", "text": "貴重な質問の時間を\n<color=red>こんなことに使った</color>貴方へ\nせめてものねぎらい。"},
        { "location": "303/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n質問と回答はおしまい。"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "他にも質問したいことが\nあっても、それはもう\n受け付けられない。"},
        { "location": "305/TALK"  , "narrator": "千羽鶴", "text": "どうしても知りたければ、\n貴方の世界の卓越した\nSNSを使えばいい。"},
        { "location": "306/TALK"  , "narrator": "千羽鶴", "text": "例えば、\n<color=green>#Ep9千羽鶴の質問</color>\nなんて付けた上で。"},
        { "location": "307/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\nだいぶ遅くなったけど\n本題に入ろうと思う。"},
        { "location": "308/TALK"  , "narrator": "千羽鶴", "text": "前回まではガブリエラが\nメインの記録映像だった\nけど、今回は違う。"},
        { "location": "309/TALK"  , "narrator": "千羽鶴", "text": "百聞は一見にしかず。\nどう違うのかは映像を\nみるのが一番早い。"},
        { "location": "311/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:55】</color>"},
        { "location": "312/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:55】</color>"},
        { "location": "313/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "314/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:55】</color>"},
        { "location": "315/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "321/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:55】</color>"},
        { "location": "322/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "328/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "329/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "362/TALK"  , "narrator": "千羽鶴", "text": "前回に引き続き、\nとても微笑ましい\n日常回だった。"},
        { "location": "363/TALK"  , "narrator": "千羽鶴", "text": "感想あれば。"},
        { "location": "365/SEL"   , "narrator": "", "text": "神楽ちゃん怖い"},
        { "location": "366/SEL"   , "narrator": "", "text": "そっちの東京って今人口少ないの？"},
        { "location": "367/SEL"   , "narrator": "", "text": "フレイメノウって実際どんなアーティストなの？"},
        { "location": "368/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "369/ACT"   , "narrator": "", "text": "神楽ちゃん怖い"},
        { "location": "370/TALK"  , "narrator": "千羽鶴", "text": "まあ、彼女だって\n人間なんだから、\nNGワードだってある。"},
        { "location": "371/TALK"  , "narrator": "千羽鶴", "text": "貴方だってあるでしょう？\nこれ言われたらキレる、\nってことの１つくらい。"},
        { "location": "372/SEL"   , "narrator": "", "text": "神楽にとってのNGワードはメノウのことなの？"},
        { "location": "373/ACT"   , "narrator": "", "text": "神楽にとってのNGワードはメノウのことなの？"},
        { "location": "375/TALK"  , "narrator": "千羽鶴", "text": "それは私からは言えない。"},
        { "location": "376/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラの時と同じ、\n彼女のプライバシーに\nかかわることだから。"},
        { "location": "377/SEL"   , "narrator": "", "text": "それ以外にも、いろいろNGワードがありそう"},
        { "location": "378/ACT"   , "narrator": "", "text": "それ以外にも、いろいろNGワードがありそう"},
        { "location": "381/TALK"  , "narrator": "千羽鶴", "text": "そうね。今回彼女の\nココロは、かなり揺れ\n動いていたようだし。"},
        { "location": "382/SEL"   , "narrator": "", "text": "でもなんで突然？"},
        { "location": "383/SEL"   , "narrator": "", "text": "いよいよ何か\n事件が起きる！？"},
        { "location": "384/ACT"   , "narrator": "", "text": "でもなんで突然？"},
        { "location": "385/TALK"  , "narrator": "千羽鶴", "text": "突然？\nそんなに突然？"},
        { "location": "386/TALK"  , "narrator": "千羽鶴", "text": "過去の記録映像にも\n色々と不自然な点は\nあった。"},
        { "location": "387/TALK"  , "narrator": "千羽鶴", "text": "心当たりが無いというなら\n一度見返してみるといい。"},
        { "location": "388/ACT"   , "narrator": "", "text": "いよいよ何か\n事件が起きる！？"},
        { "location": "389/TALK"  , "narrator": "千羽鶴", "text": "どうかしら。"},
        { "location": "390/TALK"  , "narrator": "千羽鶴", "text": "彼女は貴方が思うよりも\n遙かに賢いかもしれない。"},
        { "location": "391/TALK"  , "narrator": "千羽鶴", "text": "そう簡単に、感情に任せて\n何かをするとは\n思えないけど。"},
        { "location": "393/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "395/ACT"   , "narrator": "", "text": "そっちの東京って今人口少ないの？"},
        { "location": "396/TALK"  , "narrator": "千羽鶴", "text": "他の世界の人に\nこっちの世界の統計は、\n簡単には教えられない。"},
        { "location": "397/TALK"  , "narrator": "千羽鶴", "text": "もしあなたの世界と\n私の世界が戦争することに\nなったら不利になる。"},
        { "location": "398/SEL"   , "narrator": "", "text": "戦争するの！？"},
        { "location": "399/ACT"   , "narrator": "", "text": "戦争するの！？"},
        { "location": "401/TALK"  , "narrator": "千羽鶴", "text": "例えばの話。"},
        { "location": "402/TALK"  , "narrator": "千羽鶴", "text": "まあでも、恐らくは\nあなたの世界の東京より\n人口は少ないと思う。"},
        { "location": "403/TALK"  , "narrator": "千羽鶴", "text": "電車の中でも\n割と普通に、いつでも\nシートに座れるし。"},
        { "location": "404/SEL"   , "narrator": "", "text": "それってめっちゃ快適じゃない！？"},
        { "location": "405/SEL"   , "narrator": "", "text": "それってヤバイくらい人が少なくない？"},
        { "location": "406/ACT"   , "narrator": "", "text": "それってめっちゃ快適じゃない！？"},
        { "location": "407/TALK"  , "narrator": "千羽鶴", "text": "確かに、住むには\n快適かもしれない。"},
        { "location": "408/TALK"  , "narrator": "千羽鶴", "text": "というか、今のはちょっと\n誇大表現だったかも。\nいつでもとは限らないし。"},
        { "location": "409/ACT"   , "narrator": "", "text": "それってヤバイくらい人が少なくない？"},
        { "location": "410/TALK"  , "narrator": "千羽鶴", "text": "そうなの？"},
        { "location": "411/TALK"  , "narrator": "千羽鶴", "text": "正直言うと、私は\nあなたの世界の東京の\n人口を知らない。"},
        { "location": "412/TALK"  , "narrator": "千羽鶴", "text": "だから、多いか少ないか\n判断はできない。"},
        { "location": "413/SEL"   , "narrator": "", "text": "首都圏で３０００万人くらいだよ"},
        { "location": "414/SEL"   , "narrator": "", "text": "黙ってる"},
        { "location": "415/ACT"   , "narrator": "", "text": "首都圏で３０００万人くらいだよ"},
        { "location": "417/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "418/ACT"   , "narrator": "", "text": "黙ってる"},
        { "location": "421/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "423/ACT"   , "narrator": "", "text": "フレイメノウって実際どんなアーティストなの？"},
        { "location": "427/TALK"  , "narrator": "千羽鶴", "text": "FreyMENOWは日本の\nアーティスト、歌手。\n作詞家、作曲家。"},
        { "location": "428/TALK"  , "narrator": "千羽鶴", "text": "ジャンルは、現在は\nファンタジーメタル。\n以前はフィーリング。"},
        { "location": "429/TALK"  , "narrator": "千羽鶴", "text": "デビュー当時、中学生\nソロアーティストとして\n脚光を浴びる。"},
        { "location": "430/TALK"  , "narrator": "千羽鶴", "text": "けど、マイナーなジャンル\n故に、当時は知る人ぞ知る\nアーティストだった。"},
        { "location": "431/TALK"  , "narrator": "千羽鶴", "text": "しかしその後、事務所を\n変わり、音楽性も変えて\n再デビュー。"},
        { "location": "432/TALK"  , "narrator": "千羽鶴", "text": "以降、破竹の勢いで有名に\nなっていき、本年、ドーム\nライブを実施するに至る。"},
        { "location": "435/TALK"  , "narrator": "千羽鶴", "text": "こんなところ。"},
        { "location": "436/SEL"   , "narrator": "", "text": "つばめが好きなのは、昔のヒーリング音楽の方ってこと？"},
        { "location": "437/SEL"   , "narrator": "", "text": "なんで事務所と音楽性を変えたんだろう"},
        { "location": "438/ACT"   , "narrator": "", "text": "つばめが好きなのは、昔のヒーリング音楽の方ってこと？"},
        { "location": "439/TALK"  , "narrator": "千羽鶴", "text": "恐らくは。"},
        { "location": "440/ACT"   , "narrator": "", "text": "なんで事務所と音楽性を変えたんだろう"},
        { "location": "441/TALK"  , "narrator": "千羽鶴", "text": "さあ。"},
        { "location": "442/TALK"  , "narrator": "千羽鶴", "text": "大抵の場合がそうである\nように、大人の事情に\nよる可能性が高いと思う。"},
        { "location": "444/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "446/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "448/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "483/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n逢瀬つばめについて。"},
        { "location": "484/TALK"  , "narrator": "千羽鶴", "text": "記録映像では割と緊迫した\n状況になってるけど、\nそれについては特にない。"},
        { "location": "485/TALK"  , "narrator": "千羽鶴", "text": "なぜなら、逢瀬つばめ\n自身がその事に気づいて\nいないから。"},
        { "location": "487/TALK"  , "narrator": "千羽鶴", "text": "その代わり、彼女に\nついても、他の子と同様\n雛たちの件を共有する。"},
        { "location": "488/TALK"  , "narrator": "千羽鶴", "text": "彼女たちは逢瀬つばめの\nクラスメイトである故に\nこの記録は非常に重要。"},
        { "location": "490/TALK"  , "narrator": "千羽鶴", "text": "その代わり、同期間に\n発生した重大事件について\n共有したいと思う。"},
        { "location": "491/TALK"  , "narrator": "千羽鶴", "text": "これは神楽坂トライナリー\nにとっても歴史的な瞬間\nと言えるかもしれない。"},
        { "location": "493/TALK"  , "narrator": "千羽鶴", "text": "特にアドバイスは無いけど\n大したことにはならないと\n思うから心配しないで。"},
        { "location": "494/TALK"  , "narrator": "千羽鶴", "text": "それじゃ今回も\n貴方の手腕に期待してる。"},
        { "location": "495/TALK"  , "narrator": "千羽鶴", "text": "グッドラック。"},
        { "location": "500/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n國政綾水について\nなんだけども。"},
        { "location": "501/TALK"  , "narrator": "千羽鶴", "text": "今回彼女は、\n記録映像には\n登場していない。"},
        { "location": "503/TALK"  , "narrator": "千羽鶴", "text": "その為、國政綾水に\nおいても、雛たちの件に\nついて共有してみる。"},
        { "location": "504/TALK"  , "narrator": "千羽鶴", "text": "とは言っても、彼女は\n殆ど関わってないから、\n触り程度ではあるけど。"},
        { "location": "506/TALK"  , "narrator": "千羽鶴", "text": "その為、同時期に発生した\n大きな事件について\nスポットを当ててみる。"},
        { "location": "507/TALK"  , "narrator": "千羽鶴", "text": "これは神楽坂トライナリー\nにとっても歴史的な瞬間\nと言えるかもしれない。"},
        { "location": "509/TALK"  , "narrator": "千羽鶴", "text": "特にアドバイスは無いけど\n大したことにはならないと\n思うから心配しないで。"},
        { "location": "510/TALK"  , "narrator": "千羽鶴", "text": "それじゃ今回も\n貴方の手腕に期待してる。"},
        { "location": "511/TALK"  , "narrator": "千羽鶴", "text": "グッドラック。"},
        { "location": "516/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\nガブリエラについて\nなんだけども。"},
        { "location": "517/TALK"  , "narrator": "千羽鶴", "text": "今回彼女は、\n記録映像には\n登場していない。"},
        { "location": "519/TALK"  , "narrator": "千羽鶴", "text": "その為、ガブリエラに\nおいても、雛たちの件に\nついて共有してみる。"},
        { "location": "520/TALK"  , "narrator": "千羽鶴", "text": "実は彼女との絡みが、\n雛たちにとって最も重要な\n要素かもしれない。"},
        { "location": "521/TALK"  , "narrator": "千羽鶴", "text": "そして私からも、可能な\n限りガブリエラを支援して\n欲しいと伝えておく。"},
        { "location": "523/TALK"  , "narrator": "千羽鶴", "text": "その為、同時期に発生した\n大きな事件について\nスポットを当ててみる。"},
        { "location": "524/TALK"  , "narrator": "千羽鶴", "text": "これは神楽坂トライナリー\nにとっても歴史的な瞬間\nと言えるかもしれない。"},
        { "location": "525/TALK"  , "narrator": "千羽鶴", "text": "そして実はこの事件、\nガブリエラが鍵を\n握っている案件でもある。"},
        { "location": "526/TALK"  , "narrator": "千羽鶴", "text": "だから私からも、彼女には\n特に濃厚な支援をして\n欲しいと伝えておく。"},
        { "location": "528/TALK"  , "narrator": "千羽鶴", "text": "今回の貴方の手腕には、\n特に期待をせざるを得ない\n状況にある。"},
        { "location": "529/TALK"  , "narrator": "千羽鶴", "text": "そんなわけだから、\n最大限頑張って欲しい。"},
        { "location": "534/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n恋ヶ崎みやびについて\nなんだけども。"},
        { "location": "535/TALK"  , "narrator": "千羽鶴", "text": "今回彼女は、\n記録映像には\n登場していない。"},
        { "location": "536/TALK"  , "narrator": "千羽鶴", "text": "その為、恋ヶ崎みやびに\nおいては、日常のちょっと\nした出来事を共有する。"},
        { "location": "537/TALK"  , "narrator": "千羽鶴", "text": "これは前回に引き続き、\n彼女の未来にとって非常に\n重要な出来事の布石。"},
        { "location": "538/TALK"  , "narrator": "千羽鶴", "text": "貴方はいつもどおり、\n彼女のココロを一押し\nしてあげるだけでいい。"},
        { "location": "539/TALK"  , "narrator": "千羽鶴", "text": "それじゃ今回も\n貴方の手腕に期待してる。"},
        { "location": "540/TALK"  , "narrator": "千羽鶴", "text": "グッドラック。"},
