        "title": "スペシャルエピソード",
        "sub_title": "クリスマスの魔法"
    },
    "entry":
    [
        { "location": "31/TALK" , "narrator": "シャペロン", "text": "…………。"},
        { "location": "32/TALK" , "narrator": "透明アーヤ", "text": "ほ、ほら、ヒストン\nシャペロン。\nグラスが空いてるわ。"},
        { "location": "34/TALK" , "narrator": "透明アーヤ", "text": "沢山あるんだから、\nどんどん飲んでね。"},
        { "location": "35/TALK" , "narrator": "シャペロン", "text": "ええ、ありがとう\nございます。"},
        { "location": "36/TALK" , "narrator": "透明アーヤ", "text": "…せっかくのクリスマス\nなんだから、楽しまないと\n勿体ないわよ？"},
        { "location": "37/TALK" , "narrator": "シャペロン", "text": "アーヤは楽しんでますか？"},
        { "location": "38/TALK" , "narrator": "透明アーヤ", "text": "ええ…ヒストン\nシャペロンも\n着てくれたしね。"},
        { "location": "39/TALK" , "narrator": "シャペロン", "text": "それでしたら、私も\n参加した甲斐があったと\nいうものですね。"},
        { "location": "41/TALK" , "narrator": "透明アーヤ", "text": "…あ、あなたももっと\n楽しまないとダメよ？"},
        { "location": "42/TALK" , "narrator": "透明アーヤ", "text": "せっかくのクリスマス\nパーティーなんだから…。"},
        { "location": "43/TALK" , "narrator": "透明アーヤ", "text": "おもいっきり\n楽しまなきゃ損よ。"},
        { "location": "44/TALK" , "narrator": "シャペロン", "text": "大丈夫ですよ。\nこれでも、ちゃんと\n楽しんでますから。"},
        { "location": "45/TALK" , "narrator": "透明アーヤ", "text": "そ、そう…。"},
        { "location": "46/TALK" , "narrator": "シャペロン", "text": "ええ、そうですよ。"},
        { "location": "47/TALK" , "narrator": "透明アーヤ", "text": "…………。"},
        { "location": "49/TALK" , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "51/TALK" , "narrator": "アーヤ", "text": "無理強いしちゃったみたい(-.-;)"},
        { "location": "52/TALK" , "narrator": "アーヤ", "text": "ヒストンシャペロン"},
        { "location": "53/TALK" , "narrator": "アーヤ", "text": "あまり楽しくなさそう(; ;)"},
        { "location": "54/TALK" , "narrator": "アーヤ", "text": "余計なことしたかも"},
        { "location": "55/SEL"  , "narrator": "（選択肢）", "text": "心配？"},
        { "location": "56/ACT"  , "narrator": "", "text": "心配？"},
        { "location": "58/TALK" , "narrator": "アーヤ", "text": "当然でしょ？(>_<)"},
        { "location": "59/TALK" , "narrator": "アーヤ", "text": "楽しんでもらおうと思ったのに"},
        { "location": "60/TALK" , "narrator": "アーヤ", "text": "逆に"},
        { "location": "61/TALK" , "narrator": "アーヤ", "text": "居づらい気持ちにさせちゃうなんて"},
        { "location": "62/TALK" , "narrator": "アーヤ", "text": "私の責任だもの(T_T)"},
        { "location": "63/SEL"  , "narrator": "（選択肢）", "text": "気にしすぎだと思うよ？"},
        { "location": "64/SEL"  , "narrator": "（選択肢）", "text": "本人は楽しいって言ってるよ？"},
        { "location": "65/ACT"  , "narrator": "", "text": "気にしすぎだと思うよ？"},
        { "location": "66/TALK" , "narrator": "アーヤ", "text": "$handle$は"},
        { "location": "67/TALK" , "narrator": "アーヤ", "text": "そう思うの？(￣Д￣ )"},
        { "location": "68/TALK" , "narrator": "アーヤ", "text": "私には思えない"},
        { "location": "69/TALK" , "narrator": "アーヤ", "text": "パーティーなのに"},
        { "location": "70/TALK" , "narrator": "アーヤ", "text": "全然楽しくなさそうだし(-ω-;)"},
        { "location": "71/SEL"  , "narrator": "（選択肢）", "text": "帰らないのは、イヤではない証拠"},
        { "location": "72/SEL"  , "narrator": "（選択肢）", "text": "イヤがってるなら衣装は着ないと思う"},
        { "location": "73/ACT"  , "narrator": "", "text": "帰らないのは、イヤではない証拠"},
        { "location": "74/TALK" , "narrator": "アーヤ", "text": "そうかしら？(-.-;)"},
        { "location": "75/TALK" , "narrator": "アーヤ", "text": "でも楽しんでるようには"},
        { "location": "78/TALK" , "narrator": "アーヤ", "text": "あっ"},
        { "location": "79/TALK" , "narrator": "アーヤ", "text": "もしかしたら！"},
        { "location": "80/ACT"  , "narrator": "", "text": "イヤがってるなら衣装は着ないと思う"},
        { "location": "83/TALK" , "narrator": "アーヤ", "text": "あっ！"},
        { "location": "85/TALK" , "narrator": "アーヤ", "text": "気づかなかったけど"},
        { "location": "86/TALK" , "narrator": "アーヤ", "text": "サンタの衣装着てくれてる！"},
        { "location": "88/ACT"  , "narrator": "", "text": "本人は楽しいって言ってるよ？"},
        { "location": "89/TALK" , "narrator": "アーヤ", "text": "言ってはいるけど"},
        { "location": "90/TALK" , "narrator": "アーヤ", "text": "楽しんでる様子がどこにも(-.-;)"},
        { "location": "93/TALK" , "narrator": "アーヤ", "text": "あっ"},
        { "location": "94/TALK" , "narrator": "アーヤ", "text": "ちょっと待って！"},
        { "location": "97/TALK" , "narrator": "透明アーヤ", "text": "…ねえ、ヒストン\nシャペロン。"},
        { "location": "98/TALK" , "narrator": "シャペロン", "text": "はい？"},
        { "location": "99/TALK" , "narrator": "透明アーヤ", "text": "サンタ服、\nとっても似合ってるわ。"},
        { "location": "102/TALK", "narrator": "シャペロン", "text": "！？"},
        { "location": "104/TALK", "narrator": "透明アーヤ", "text": "ふふっ、よかった。\n楽しみにしてくれてた\nみたいで。"},
        { "location": "105/TALK", "narrator": "シャペロン", "text": "…だ、だから、最初から\n楽しんでると言ってるじゃ\nないですか…。"},
        { "location": "106/TALK", "narrator": "透明アーヤ", "text": "ええ、そうね。\nよかった…。"},
        { "location": "107/TALK", "narrator": "シャペロン", "text": "…………。"},
        { "location": "109/TALK", "narrator": "アーヤ", "text": "よかった"},
        { "location": "110/TALK", "narrator": "アーヤ", "text": "楽しんでくれてるみたい(^^"},
        { "location": "111/TALK", "narrator": "アーヤ", "text": "っていうか"},
        { "location": "113/TALK", "narrator": "アーヤ", "text": "最初からそう言ってたのに"},
        { "location": "114/TALK", "narrator": "アーヤ", "text": "私が信じなかったのよね(・・。)ゞ"},
        { "location": "115/SEL" , "narrator": "（選択肢）", "text": "表情に出ないからね"},
        { "location": "116/SEL" , "narrator": "（選択肢）", "text": "アーヤは心配性だから"},
        { "location": "117/ACT" , "narrator": "", "text": "表情に出ないからね"},
        { "location": "118/TALK", "narrator": "アーヤ", "text": "笑わない子だから(;^_^A"},
        { "location": "119/TALK", "narrator": "アーヤ", "text": "でも"},
        { "location": "120/TALK", "narrator": "アーヤ", "text": "彼女なりの楽しみ方が"},
        { "location": "121/TALK", "narrator": "アーヤ", "text": "ちゃんとあるのよね"},
        { "location": "122/TALK", "narrator": "アーヤ", "text": "それがわかっただけでも"},
        { "location": "123/TALK", "narrator": "アーヤ", "text": "よかったわ＼(^O^)／"},
        { "location": "124/TALK", "narrator": "アーヤ", "text": "無駄な心配はもうおしまい"},
        { "location": "125/TALK", "narrator": "アーヤ", "text": "今はパーティーの最中なんだし(*^.^*)"},
        { "location": "126/ACT" , "narrator": "", "text": "アーヤは心配性だから"},
        { "location": "129/TALK", "narrator": "アーヤ", "text": "そうなのよね(￣Д￣ )"},
        { "location": "130/TALK", "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "131/TALK", "narrator": "アーヤ", "text": "反省しないと(>_<)"},
        { "location": "132/SEL" , "narrator": "（選択肢）", "text": "それはパーティーの後でね"},
        { "location": "133/SEL" , "narrator": "（選択肢）", "text": "そういう真面目なところが好き"},
        { "location": "134/ACT" , "narrator": "", "text": "それはパーティーの後でね"},
        { "location": "137/TALK", "narrator": "アーヤ", "text": "そうね(^^"},
        { "location": "138/ACT" , "narrator": "", "text": "そういう真面目なところが好き"},
        { "location": "141/TALK", "narrator": "アーヤ", "text": "慰めてくれてる？"},
        { "location": "142/TALK", "narrator": "アーヤ", "text": "ありがと(^^"},
        { "location": "144/TALK", "narrator": "アーヤ", "text": "大丈夫よ(^з^)-☆"},
        { "location": "145/TALK", "narrator": "アーヤ", "text": "とにかく今はパーティーの最中なんだし"},
        { "location": "148/TALK", "narrator": "アーヤ", "text": "私も"},
        { "location": "149/TALK", "narrator": "アーヤ", "text": "楽しまなくちゃ(=^0^=)"},
        { "location": "151/TALK", "narrator": "透明アーヤ", "text": "さてと、私も今日は\n飲もうかしら。"},
        { "location": "152/TALK", "narrator": "透明アーヤ", "text": "ヒストンシャペロン、\n私にも注いで。"},
        { "location": "153/TALK", "narrator": "シャペロン", "text": "あ、すみません。\n私ばかり…どうぞ。"},
        { "location": "154/TALK", "narrator": "透明アーヤ", "text": "ありがとう。\nんっ…。"},
        { "location": "155/TALK", "narrator": "シャペロン", "text": "…意外でした。\nアーヤも、\nお酒を飲むんですね。"},
        { "location": "158/TALK", "narrator": "透明アーヤ", "text": "そりゃそうよ。\n大学生ではあるけど、\n成人してるし。"},
        { "location": "159/TALK", "narrator": "透明アーヤ", "text": "友達や館長と食事に\n行ったりすると、\n毎回飲むのよ？"},
        { "location": "160/TALK", "narrator": "シャペロン", "text": "そうでしたか…。"},
        { "location": "161/TALK", "narrator": "透明アーヤ", "text": "ま、館長みたいに\n酔っ払うほど飲みは\nしないけど…。"},
        { "location": "162/TALK", "narrator": "シャペロン", "text": "…アーヤ、早速グラスが\n空いたようですね。\nおかわりをどうぞ。"},
        { "location": "163/TALK", "narrator": "透明アーヤ", "text": "ふふっ、まさか私を\n酔わせるつもりじゃ\nないでしょうね？"},
        { "location": "164/TALK", "narrator": "シャペロン", "text": "いえ…ただ、私はまだ\nアーヤの知らないところが\n色々あるようなので…。"},
        { "location": "165/TALK", "narrator": "シャペロン", "text": "お酒を酌み交わしながら、\nじっくりと話をするのも\n楽しいかと思ったんです。"},
        { "location": "166/TALK", "narrator": "透明アーヤ", "text": "そういえば、\n今までそういう機会って\nなかったわね。"},
        { "location": "169/TALK", "narrator": "透明アーヤ", "text": "…うん、いいかも。\n今日はじっくりと、\n話し合いましょ。"},
        { "location": "170/TALK", "narrator": "シャペロン", "text": "…ありがとうございます。"},
        { "location": "171/TALK", "narrator": "シャペロン", "text": "では、前からずっと\n聞きたかったのですが、\nアーヤは――"}
    ]
}
