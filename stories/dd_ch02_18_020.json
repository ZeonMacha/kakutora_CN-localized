{
    "dir": "chap18/daydra/dd_ch02_18_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "18256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "徹夜の準備"
    },
    "entry":
    [
        { "location": "276/SCENARIO", "narrator": "", "text": "徹夜の準備"},
        { "location": "289/TALK"    , "narrator": "ガブリエラ", "text": "ん？　何かしらこの袋？"},
        { "location": "294/TALK"    , "narrator": "アーヤ", "text": "私の夕飯よ。\nさっきコンビニで\n買ってきたの。"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "珍しいわね。\nしっかり者のアーヤが\n手抜きご飯なんて。"},
        { "location": "298/TALK"    , "narrator": "アーヤ", "text": "今日は特別。\n明日提出しなきゃいけない\nレポートがあってね。"},
        { "location": "299/TALK"    , "narrator": "アーヤ", "text": "多分徹夜作業になるから、\n今日はささっと夕飯を\n済ませたいのよ。"},
        { "location": "300/TALK"    , "narrator": "ガブリエラ", "text": "ふ～ん…っていうか、\nこのラインナップは\n酷いんじゃない？"},
        { "location": "301/TALK"    , "narrator": "ガブリエラ", "text": "おにぎりと缶コーヒー、\nそれにエナジードリンク？"},
        { "location": "302/TALK"    , "narrator": "アーヤ", "text": "本当に夕飯を作る時間も\n惜しいくらいなのよ。"},
        { "location": "303/TALK"    , "narrator": "ガブリエラ", "text": "だからって…\nこれじゃ身体壊すわよ。"},
        { "location": "304/TALK"    , "narrator": "アーヤ", "text": "たった一日くらいで\n壊れたりしないってば。"},
        { "location": "305/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "308/TALK"    , "narrator": "ガブリエラ", "text": "あたしが、夕飯作って\nあげてもいいけど？"},
        { "location": "310/TALK"    , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "311/SEL"     , "narrator": "", "text": "作ってもらいなよ"},
        { "location": "312/SEL"     , "narrator": "", "text": "遠慮した方が良いと思う"},
        { "location": "313/SEL"     , "narrator": "", "text": "何かリクエストすれば？"},
        { "location": "314/ACT"     , "narrator": "", "text": "作ってもらいなよ"},
        { "location": "316/ACT"     , "narrator": "", "text": "遠慮した方が良いと思う"},
        { "location": "318/ACT"     , "narrator": "", "text": "何かリクエストすれば？"},
        { "location": "327/TALK"    , "narrator": "ガブリエラ", "text": "か、勘違いしないで！"},
        { "location": "328/TALK"    , "narrator": "ガブリエラ", "text": "アーヤはトライナリーの\nリーダーでしょ？"},
        { "location": "329/SEL"     , "narrator": "", "text": "気づいて"},
        { "location": "330/ACT"     , "narrator": "", "text": "気づいて"},
        { "location": "335/TALK"    , "narrator": "ガブリエラ", "text": "なのに、そんな身体に\n悪い食事して倒れでも\nしたら――"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "あたし達が面倒なことに\nなるでしょ？"},
        { "location": "338/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "341/TALK"    , "narrator": "ガブリエラ", "text": "だから、ご飯くらい\n作ってあげてもいいわ。"},
        { "location": "342/SEL"     , "narrator": "", "text": "おーい！！"},
        { "location": "343/ACT"     , "narrator": "", "text": "おーい！！"},
        { "location": "349/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "352/TALK"    , "narrator": "ガブリエラ", "text": "ってか、さっきから\nＷＡＶＥの着信が\nうるさいから――"},
        { "location": "353/TALK"    , "narrator": "ガブリエラ", "text": "先にそっちすまし\nちゃえば？"},
        { "location": "356/TALK"    , "narrator": "アーヤ", "text": "そ、そうね。\nまったく、誰かしら？"},
        { "location": "369/TALK"    , "narrator": "プレイヤー", "text": "気づいて"},
        { "location": "370/TALK"    , "narrator": "プレイヤー", "text": "おーい！！"},
        { "location": "372/TALK"    , "narrator": "アーヤ", "text": "しつこい(｀Д´)"},
        { "location": "373/TALK"    , "narrator": "アーヤ", "text": "でも、"},
        { "location": "374/TALK"    , "narrator": "アーヤ", "text": "聞いて欲しかった"},
        { "location": "376/TALK"    , "narrator": "アーヤ", "text": "ギャヴィが私のために夕飯作ってくれるって"},
        { "location": "377/TALK"    , "narrator": "アーヤ", "text": "感激だよー(TωT)"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "もちろん！(≧∇≦)b"},
        { "location": "401/TALK"    , "narrator": "アーヤ", "text": "お待たせ。"},
        { "location": "402/TALK"    , "narrator": "アーヤ", "text": "それじゃあ、お言葉に\n甘えてご馳走になるわ。"},
        { "location": "404/TALK"    , "narrator": "ガブリエラ", "text": "そ、そう…。"},
        { "location": "407/TALK"    , "narrator": "アーヤ", "text": "洗い物くらいはするから。"},
        { "location": "410/TALK"    , "narrator": "ガブリエラ", "text": "そういうの良いから、\n食べたらすぐレポート\nやんなさいよ。"},
        { "location": "414/TALK"    , "narrator": "アーヤ", "text": "ふふっ…ありがと。\nそうさせてもらうわ。"},
        { "location": "417/TALK"    , "narrator": "ガブリエラ", "text": "まったく…。"},
        { "location": "418/TALK"    , "narrator": "ガブリエラ", "text": "とにかく、今夜は期待\nしてなさい。"},
        { "location": "419/TALK"    , "narrator": "ガブリエラ", "text": "うんと美味しくて、\n栄養タップリの\n和食を作ってあげるわ。"},
        { "location": "421/TALK"    , "narrator": "アーヤ", "text": "和食ってことは、やっぱり\nギャヴィオリジナルの\nアレンジ料理？"},
        { "location": "424/TALK"    , "narrator": "ガブリエラ", "text": "何よ、不満なの？"},
        { "location": "426/TALK"    , "narrator": "アーヤ", "text": "味見さえして\nもらえればね。"},
        { "location": "428/TALK"    , "narrator": "ガブリエラ", "text": "言ったわね！？"},
        { "location": "430/TALK"    , "narrator": "ガブリエラ", "text": "絶対美味しいの作って\n驚かせてやるんだから！"},
        { "location": "431/TALK"    , "narrator": "アーヤ", "text": "うん、楽しみにしてるわ。"},
        { "location": "434/TALK"    , "narrator": "アーヤ", "text": "…甘え過ぎかしら？"},
        { "location": "435/TALK"    , "narrator": "アーヤ", "text": "ギャヴィのことだから、きっと手の込んだ料理作りそうだし"},
        { "location": "436/TALK"    , "narrator": "アーヤ", "text": "…断った方がいいわね"},
        { "location": "448/TALK"    , "narrator": "アーヤ", "text": "やっぱり遠慮するわ。"},
        { "location": "449/TALK"    , "narrator": "ガブリエラ", "text": "…あたしの料理に\n不満があるとか？"},
        { "location": "450/TALK"    , "narrator": "アーヤ", "text": "そうじゃなくて、\n二人分作らせるなんて\n迷惑だと思うし…。"},
        { "location": "452/TALK"    , "narrator": "ガブリエラ", "text": "何でそうなるのよ？"},
        { "location": "453/TALK"    , "narrator": "ガブリエラ", "text": "食べに来なさい、って\n言ってるのはあたし\nでしょ？"},
        { "location": "454/TALK"    , "narrator": "ガブリエラ", "text": "あたしがそう言ってるん\nだから、迷惑だなんて\n勝手に決めないでよ。"},
        { "location": "455/TALK"    , "narrator": "アーヤ", "text": "でも…。"},
        { "location": "456/TALK"    , "narrator": "ガブリエラ", "text": "そんな理由で断られる方が\n迷惑なんだってば！"},
        { "location": "458/TALK"    , "narrator": "ガブリエラ", "text": "迷惑掛けるのが嫌なら、\n大人しく食べに来なさい。"},
        { "location": "459/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "461/TALK"    , "narrator": "アーヤ", "text": "ありがとう。\nじゃあ、ご馳走になるわ。"},
        { "location": "462/TALK"    , "narrator": "ガブリエラ", "text": "それでいいのよ。"},
        { "location": "464/TALK"    , "narrator": "ガブリエラ", "text": "精が付くもの沢山\n作るから、お腹いっぱい\n食べなきゃダメよ。"},
        { "location": "467/TALK"    , "narrator": "アーヤ", "text": "眠くなっちゃうから、\n程々にしてもらえると\n嬉しいかな…。"},
        { "location": "473/TALK"    , "narrator": "アーヤ", "text": "そうするわ"},
        { "location": "474/TALK"    , "narrator": "アーヤ", "text": "久しぶりに食べたい物があるのo(^∇^)o"},
        { "location": "486/TALK"    , "narrator": "アーヤ", "text": "じゃあ、ポーランド料理を\nリクエストしようかしら。"},
        { "location": "489/TALK"    , "narrator": "ガブリエラ", "text": "…リクエストを受け付ける\nとは言ってないんだけど？"},
        { "location": "491/TALK"    , "narrator": "アーヤ", "text": "受け付けないとも\n言ってないでしょ？"},
        { "location": "494/TALK"    , "narrator": "ガブリエラ", "text": "そこまで甘えないでよ。\nレポート提出したら\n自分で作ればいいでしょ？"},
        { "location": "495/TALK"    , "narrator": "アーヤ", "text": "本場の味をよく知ってる、\nギャヴィの作ったものを\n食べたいのよ。"},
        { "location": "496/TALK"    , "narrator": "アーヤ", "text": "…ダメかしら？"},
        { "location": "499/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "502/TALK"    , "narrator": "ガブリエラ", "text": "…まあ、いいけど。\nあたしも久しぶりに\n食べたいし――"},
        { "location": "503/TALK"    , "narrator": "ガブリエラ", "text": "最近は創作和食ばかりで、\nずっと作ってなかった\nから、自信ないけど。"},
        { "location": "504/TALK"    , "narrator": "アーヤ", "text": "大丈夫よ。\n楽しみにしてるわ。"},
        { "location": "506/TALK"    , "narrator": "ガブリエラ", "text": "ふんっ、勝手なんだから。"},
        { "location": "510/TALK"    , "narrator": "ガブリエラ", "text": "…絶対に美味しいの\n作ってみせるわ！"},
        { "location": "286/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月28日　6:41 PM</color>\nとある平日の午後、寮「とらいあんぐる」アーヤの部屋にて。"},
        { "location": "521/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch02", "text": "【夜食をどうぞ】"}
    ]
}
