        { "location": "424/TALK"    , "narrator": "つばめ", "text": "ぁ"},
        { "location": "425/TALK"    , "narrator": "つばめ", "text": "そぅなの"},
        { "location": "426/ACT"     , "narrator": "", "text": "当ててみて"},
        { "location": "427/TALK"    , "narrator": "つばめ", "text": "ぇ(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "428/TALK"    , "narrator": "つばめ", "text": "難しぃょ(´・ω・｀)"},
