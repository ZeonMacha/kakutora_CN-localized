        { "location": "466/TALK"    , "narrator": "つばめ", "text": "ぁれ(´･ω･｀) "},
        { "location": "467/TALK"    , "narrator": "つばめ", "text": "ぁたしまた変なこと言ったんだね"},
        { "location": "468/ACT"     , "narrator": "", "text": "もっと色々欲しいな……"},
        { "location": "469/TALK"    , "narrator": "つばめ", "text": "やっぱり"},
        { "location": "470/TALK"    , "narrator": "つばめ", "text": "そう思うもんなんだね(･ｪ･^ )( ^･ｪ･)"},
        { "location": "472/TALK"    , "narrator": "つばめ", "text": "そっかー"},
        { "location": "474/SEL"     , "narrator": "", "text": "恋に落ちるって言うでしょ"},
        { "location": "475/SEL"     , "narrator": "", "text": "キュンって気持ちが必要でしょ"},
        { "location": "476/ACT"     , "narrator": "", "text": "恋に落ちるって言うでしょ"},
        { "location": "477/TALK"    , "narrator": "つばめ", "text": "落ちるの・・・？"},
        { "location": "479/TALK"    , "narrator": "つばめ", "text": "怪我とかしない？"},
        { "location": "480/ACT"     , "narrator": "", "text": "キュンって気持ちが必要でしょ"},
        { "location": "481/TALK"    , "narrator": "つばめ", "text": "キュンかー"},
        { "location": "482/TALK"    , "narrator": "つばめ", "text": "キュンキュンって"},
        { "location": "483/TALK"    , "narrator": "つばめ", "text": "こう言うと"},
        { "location": "484/TALK"    , "narrator": "つばめ", "text": "子犬みたいだね"},
        { "location": "486/SEL"     , "narrator": "", "text": "まったりなのもありかな･･････"},
        { "location": "487/SEL"     , "narrator": "", "text": "世界の中心で愛が叫びたいんだよ"},
        { "location": "488/ACT"     , "narrator": "", "text": "まったりなのもありかな･･････"},
        { "location": "489/TALK"    , "narrator": "つばめ", "text": "まったり"},
        { "location": "491/TALK"    , "narrator": "つばめ", "text": "ぃぃょね(*´︶`*)"},
        { "location": "492/ACT"     , "narrator": "", "text": "世界の中心で愛が叫びたいんだよ"},
        { "location": "493/TALK"    , "narrator": "つばめ", "text": "それは(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "494/TALK"    , "narrator": "つばめ", "text": "ちょっと恥ずかしぃかも"},
        { "location": "495/TALK"    , "narrator": "つばめ", "text": "目立つし"},
        { "location": "497/TALK"    , "narrator": "つばめ", "text": "恋とかは"},
        { "location": "498/TALK"    , "narrator": "つばめ", "text": "やっぱり"},
        { "location": "499/TALK"    , "narrator": "つばめ", "text": "ガブちゃんの方がむぃてるょうな気がしてきたょ"},
        { "location": "500/TALK"    , "narrator": "つばめ", "text": "難しぃねヽ(；▽；)ノ"},
        { "location": "502/TALK"    , "narrator": "つばめ", "text": "難しいけど考えてみた"},
        { "location": "504/TALK"    , "narrator": "つばめ", "text": "こぅぃぅことかな？"},
        { "location": "507/TALK"    , "narrator": "ボイスメール", "text": "だから、は恋じゃない"},
