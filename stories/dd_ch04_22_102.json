{
    "dir": "chap22/daydra/dd_ch04_22_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "22405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "勇気＜後編＞"
    },
    "entry":
    [
        { "location": "372/TALK"  , "narrator": "みやび", "text": "…いかん。"},
        { "location": "373/TALK"  , "narrator": "みやび", "text": "うち、今めっちゃ\nビビっちょる。"},
        { "location": "374/TALK"  , "narrator": "みやび", "text": "見なかったことに\nするなんて\n絶対にありえん。"},
        { "location": "375/TALK"  , "narrator": "みやび", "text": "今までの活動\n丸ごと無駄になる。"},
        { "location": "376/TALK"  , "narrator": "みやび", "text": "…やはり、管理庁に\n何か行動を起こさん\nわけにはいかんな。"},
        { "location": "377/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "379/TALK"  , "narrator": "みやび", "text": "今のうちらに\nできることは\n何や？"},
        { "location": "383/TALK"  , "narrator": "みやび", "text": "急募"},
        { "location": "384/TALK"  , "narrator": "みやび", "text": "管理庁をギャフンと言わせられる行動"},
        { "location": "385/TALK"  , "narrator": "みやび", "text": "条件"},
        { "location": "386/TALK"  , "narrator": "みやび", "text": "うちらの安全重視"},
        { "location": "387/TALK"  , "narrator": "みやび", "text": "何かアイデアは？"},
        { "location": "389/SEL"   , "narrator": "", "text": "$me$に聞くの？"},
        { "location": "390/ACT"   , "narrator": "", "text": "$me$に聞くの？"},
        { "location": "392/TALK"  , "narrator": "みやび", "text": "第三者の意見が欲しい"},
        { "location": "393/TALK"  , "narrator": "みやび", "text": "つまり相棒"},
        { "location": "394/TALK"  , "narrator": "みやび", "text": "君に決めた！"},
        { "location": "395/TALK"  , "narrator": "みやび", "text": "さあアイデアは？"},
        { "location": "397/SEL"   , "narrator": "", "text": "みんなに相談するべきだ"},
        { "location": "398/SEL"   , "narrator": "", "text": "繭には聞かないの？"},
        { "location": "399/ACT"   , "narrator": "", "text": "みんなに相談するべきだ"},
        { "location": "402/TALK"  , "narrator": "みやび", "text": "考えてはいた"},
        { "location": "403/TALK"  , "narrator": "みやび", "text": "けんど問題が一つ"},
        { "location": "404/TALK"  , "narrator": "みやび", "text": "うちらの中にいるスパイの存在や"},
        { "location": "405/TALK"  , "narrator": "みやび", "text": "まほさんとアーヤは違うと思う"},
        { "location": "406/TALK"  , "narrator": "みやび", "text": "残りの三人は"},
        { "location": "409/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "411/TALK"  , "narrator": "みやび", "text": "そういうことやき"},
        { "location": "412/TALK"  , "narrator": "みやび", "text": "全員に話せない以上は誰にも相談できん"},
        { "location": "413/TALK"  , "narrator": "みやび", "text": "仲間に対して疑心暗鬼とか"},
        { "location": "414/TALK"  , "narrator": "みやび", "text": "うちだけで十分や"},
        { "location": "415/ACT"   , "narrator": "", "text": "繭には聞かないの？"},
        { "location": "417/TALK"  , "narrator": "みやび", "text": "聞けるわけがない"},
        { "location": "418/TALK"  , "narrator": "みやび", "text": "大抵のことは相談できても"},
        { "location": "419/TALK"  , "narrator": "みやび", "text": "事の大きさを考えると"},
        { "location": "420/TALK"  , "narrator": "みやび", "text": "これはうちが決めなければならんし"},
        { "location": "423/TALK"  , "narrator": "みやび", "text": "あまりうちの情けない姿"},
        { "location": "424/TALK"  , "narrator": "みやび", "text": "うさぎに見せるのは"},
        { "location": "425/TALK"  , "narrator": "みやび", "text": "好ましくない"},
        { "location": "427/SEL"   , "narrator": "", "text": "じゃあみんなに相談しよう"},
        { "location": "428/ACT"   , "narrator": "", "text": "じゃあみんなに相談しよう"},
        { "location": "432/TALK"  , "narrator": "みやび", "text": "仕方がない"},
        { "location": "433/TALK"  , "narrator": "みやび", "text": "自分で考えるしかなさそうやね"},
        { "location": "438/TALK"  , "narrator": "みやび", "text": "ふむ…。"},
        { "location": "439/TALK"  , "narrator": "繭", "text": "…事が事なだけに、\n簡単に答えを\n出せませんね。"},
        { "location": "440/TALK"  , "narrator": "みやび", "text": "うん…いや、\nちっくと\n整理すれば……。"},
        { "location": "444/TALK"  , "narrator": "みやび", "text": "なっ！？"},
        { "location": "445/TALK"  , "narrator": "繭", "text": "フェノメノン\nアラートですか！？"},
        { "location": "446/TALK"  , "narrator": "みやび", "text": "そのようや…。\nこんな時間に、\nまったく…。"},
        { "location": "447/TALK"  , "narrator": "みやび", "text": "うさぎ、すまん。\n話の続きはまた\n後でや。"},
        { "location": "448/TALK"  , "narrator": "繭", "text": "了解しました。\nみやび先輩、\nお気をつけて…。"},
        { "location": "452/TALK"  , "narrator": "みやび", "text": "…みんなのとこ\n行かんと！"},
        { "location": "463/DIALOG", "narrator": "Dialog_chapter_ch04", "text": "【18 ブラック・クラン】"}
    ]
}
