{
    "dir": "chap00/daydra/spev_comike_2018_020.js",
    "type": "",
    "info": {
        "story_id": "91072",
        "cid": "",
        "title": "がすとちゃんサマー大作戦♪",
        "sub_title": "作戦２：特大布ポスターたたき売り！？"
    },
    "entry":
    [
        { "location": "403/SCENARIO", "narrator": "", "text": "タペストリ"},
        { "location": "443/TALK"    , "narrator": "がすとちゃん", "text": "こんにちは！ ですの！"},
        { "location": "444/TALK"    , "narrator": "がすとちゃん", "text": "みんなの夢を叶える\nがすとちゃんですの。"},
        { "location": "445/TALK"    , "narrator": "がすとちゃん", "text": "今回は、来たる\n夏の一大イベント情報を\nお届けするですの！"},
        { "location": "446/SEL"     , "narrator": "（選択肢）", "text": "待ってました！"},
        { "location": "447/SEL"     , "narrator": "（選択肢）", "text": "よっ、守銭奴！"},
        { "location": "448/ACT"     , "narrator": "", "text": "待ってました！"},
        { "location": "457/TALK"    , "narrator": "がすとちゃん", "text": "お待たせですの！"},
        { "location": "460/TALK"    , "narrator": "がすとちゃん", "text": "ところで、\n$handle$さんは\n勿論買いまくるですの？"},
        { "location": "461/SEL"     , "narrator": "（選択肢）", "text": "まぁ、欲しい分だけ"},
        { "location": "462/ACT"     , "narrator": "", "text": "まぁ、欲しい分だけ"},
        { "location": "465/TALK"    , "narrator": "がすとちゃん", "text": "やる気が足りないですの！"},
        { "location": "466/TALK"    , "narrator": "がすとちゃん", "text": "もっとこう、\n破産するくらいの勢いで\n買う意欲を見せるですの。"},
        { "location": "468/TALK"    , "narrator": "がすとちゃん", "text": "$handle$なら\n出来るはずですの！"},
        { "location": "469/ACT"     , "narrator": "", "text": "よっ、守銭奴！"},
        { "location": "471/TALK"    , "narrator": "がすとちゃん", "text": "守銭奴とは何ですの！"},
        { "location": "472/TALK"    , "narrator": "がすとちゃん", "text": "がすとは真心込めて\n利益を追求してる\nだけですの！"},
        { "location": "474/TALK"    , "narrator": "がすとちゃん", "text": "それが即ち\n$handle$の\n利益にもなるですの！"},
        { "location": "476/SEL"     , "narrator": "（選択肢）", "text": "お客を呼び捨て！？"},
        { "location": "477/ACT"     , "narrator": "", "text": "お客を呼び捨て！？"},
        { "location": "490/TALK"    , "narrator": "がすとちゃん", "text": "細けぇことはいいですの。\n$handle$と\nがすとの仲ですの。"},
        { "location": "493/TALK"    , "narrator": "がすとちゃん", "text": "というわけで、\nさっそくお知らせですの！"},
        { "location": "494/TALK"    , "narrator": "がすとちゃん", "text": "まずは、コレ！"},
        { "location": "501/DIALOG"  , "narrator": "", "text": "type.トライナリー"},
        { "location": "503/TALK"    , "narrator": "がすとちゃん", "text": "特大タペストリー\ntype.トライナリー\nですの！"},
        { "location": "507/SEL"     , "narrator": "（選択肢）", "text": "お～！"},
        { "location": "508/ACT"     , "narrator": "", "text": "お～！"},
        { "location": "512/DIALOG"  , "narrator": "", "text": "type.トライナリー"},
        { "location": "515/TALK"    , "narrator": "がすとちゃん", "text": "このアイテムは\n全botさん必携ですの。"},
        { "location": "516/TALK"    , "narrator": "がすとちゃん", "text": "なんてったって\nトライナリーの5人全員が\n描かれてるんですの！"},
        { "location": "518/TALK"    , "narrator": "がすとちゃん", "text": "がすとが調べた\nところによると…。"},
        { "location": "519/TALK"    , "narrator": "がすとちゃん", "text": "botという人種は\n大きく5つのタイプに\n分類できる様子ですの。"},
        { "location": "521/TALK"    , "narrator": "がすとちゃん", "text": "まずは、\n逢瀬つばめ推しの\n「フィナンシェ」！"},
        { "location": "522/TALK"    , "narrator": "がすとちゃん", "text": "フィナンシェの印象は\n一見すると穏健だけど\n中身はヤバそうですの。"},
        { "location": "523/TALK"    , "narrator": "がすとちゃん", "text": "それと、\n國政綾水推しの\n「アヤミスト」！"},
        { "location": "524/TALK"    , "narrator": "がすとちゃん", "text": "アヤミストは\n行動力とか内に秘めたる\n情愛とかが凄そうですの！"},
        { "location": "525/TALK"    , "narrator": "がすとちゃん", "text": "要するにヤベーですの！"},
        { "location": "527/TALK"    , "narrator": "がすとちゃん", "text": "ガブリエラ推しの\n「マルザンナ」は\n何かもうヤベーですの！"},
        { "location": "528/TALK"    , "narrator": "がすとちゃん", "text": "たとえ一部だけであっても\n全体がヤバそうですの！"},
        { "location": "530/TALK"    , "narrator": "がすとちゃん", "text": "その一方で、\n恋ヶ崎みやび推しの\n「相棒」は──"},
        { "location": "531/TALK"    , "narrator": "がすとちゃん", "text": "見たところ一番\n穏やかそうな派閥ですの。"},
        { "location": "533/TALK"    , "narrator": "がすとちゃん", "text": "でも、想いを募らせると\nヤバいくらいに真剣な\n想いが出てきそうですの。"},
        { "location": "534/TALK"    , "narrator": "がすとちゃん", "text": "そして、\n卯月神楽推しの\nbotさんたちは…。"},
        { "location": "535/TALK"    , "narrator": "がすとちゃん", "text": "何て呼べばいいですの？\nゴミ？　犬？\n下僕ちゃん？"},
        { "location": "537/TALK"    , "narrator": "がすとちゃん", "text": "いずれにしても、\nそんな扱いでも愛を貫く\nヤベー人たちですの！"},
        { "location": "538/TALK"    , "narrator": "がすとちゃん", "text": "結論！\nbotさんはみんな\nヤベーですの！！"},
        { "location": "545/TALK"    , "narrator": "がすとちゃん", "text": "あ、ヤベーってのは\nいちおう誉め言葉と\n受け取ってほしいですの。"},
        { "location": "546/TALK"    , "narrator": "がすとちゃん", "text": "ちなみに、\n$handle$は\nどのタイプですの？"},
        { "location": "547/SEL"     , "narrator": "（選択肢）", "text": "フィナンシェ"},
        { "location": "548/SEL"     , "narrator": "（選択肢）", "text": "アヤミスト"},
        { "location": "549/SEL"     , "narrator": "（選択肢）", "text": "マルザンナ"},
        { "location": "550/SEL"     , "narrator": "（選択肢）", "text": "相棒"},
        { "location": "551/SEL"     , "narrator": "（選択肢）", "text": "ゴミ、犬、下僕"},
        { "location": "554/ACT"     , "narrator": "", "text": "フィナンシェ"},
        { "location": "555/ACT"     , "narrator": "", "text": "アヤミスト"},
        { "location": "556/ACT"     , "narrator": "", "text": "マルザンナ"},
        { "location": "557/ACT"     , "narrator": "", "text": "相棒"},
        { "location": "558/ACT"     , "narrator": "", "text": "ゴミ、犬、下僕"},
        { "location": "560/TALK"    , "narrator": "がすとちゃん", "text": "いや、\n聞くまでもないですの。"},
        { "location": "578/TALK"    , "narrator": "がすとちゃん", "text": "どっちみち\n$handle$は\nヤベーですの！"},
        { "location": "579/SEL"     , "narrator": "（選択肢）", "text": "聞けよ！"},
        { "location": "580/ACT"     , "narrator": "", "text": "聞けよ！"},
        { "location": "581/TALK"    , "narrator": "がすとちゃん", "text": "積もる話は\nお会計の時にでも\n聞くですの！"},
        { "location": "584/TALK"    , "narrator": "がすとちゃん", "text": "と、脱線したけど\nこのタペストリーは\n服装にも注目ですの。"},
        { "location": "585/TALK"    , "narrator": "がすとちゃん", "text": "いくつかある\nヒロインたちの\n私服のうち──"},
        { "location": "587/TALK"    , "narrator": "がすとちゃん", "text": "これまでイラストで\nあまり描かれたことのない\nバージョンの私服ですの！"},
        { "location": "592/TALK"    , "narrator": "がすとちゃん", "text": "私服の姿で\n至福のひととき！\nですの！！"},
        { "location": "594/TALK"    , "narrator": "がすとちゃん", "text": "こういう私服の\n設定画とかもブログで\n公開すれば──"},
        { "location": "595/TALK"    , "narrator": "がすとちゃん", "text": "きっとタペストリーの\n販促になるですの。"},
        { "location": "596/TALK"    , "narrator": "がすとちゃん", "text": "デイトラの関係者に\n提案してやるですの…！"},
        { "location": "597/SEL"     , "narrator": "（選択肢）", "text": "何か企んでる？"},
        { "location": "598/ACT"     , "narrator": "", "text": "何か企んでる？"},
        { "location": "600/TALK"    , "narrator": "がすとちゃん", "text": "大丈夫ですの。\n企んでるのは\nいつものことですの。"},
        { "location": "602/TALK"    , "narrator": "がすとちゃん", "text": "そして！\nタペストリーは\nもうひとつあるですの。"},
        { "location": "604/TALK"    , "narrator": "がすとちゃん", "text": "それが、コレ！"},
        { "location": "611/DIALOG"  , "narrator": "", "text": "type.千羽鶴＆エリカ"},
        { "location": "613/TALK"    , "narrator": "がすとちゃん", "text": "特大タペストリー\ntype.千羽鶴＆エリカ\nですのー！"},
        { "location": "617/SEL"     , "narrator": "（選択肢）", "text": "ちーちゃん！"},
        { "location": "618/SEL"     , "narrator": "（選択肢）", "text": "エリカ！"},
        { "location": "619/ACT"     , "narrator": "", "text": "ちーちゃん！"},
        { "location": "622/DIALOG"  , "narrator": "", "text": "type.千羽鶴＆エリカ"},
        { "location": "624/TALK"    , "narrator": "がすとちゃん", "text": "そうですの。\nみんな大好き\nラブラブトレーナー！"},
        { "location": "626/TALK"    , "narrator": "がすとちゃん", "text": "以前のタペストリーとは\nちょっと違うデザインの\n水着で登場ですの。"},
        { "location": "627/TALK"    , "narrator": "がすとちゃん", "text": "こんな格好で\n手を振られたら\nbotはイチコロですの！"},
        { "location": "628/TALK"    , "narrator": "がすとちゃん", "text": "海よりも先に\nちーちゃんさんにダイブ\nしたくなるですのー！"},
        { "location": "629/ACT"     , "narrator": "", "text": "エリカ！"},
        { "location": "632/DIALOG"  , "narrator": "", "text": "type.千羽鶴＆エリカ"},
        { "location": "634/TALK"    , "narrator": "がすとちゃん", "text": "そうですの。\nコーンコンな\nお姉さんですの！"},
        { "location": "636/TALK"    , "narrator": "がすとちゃん", "text": "エリカさんの見所は\n何といっても豊満な\nそのお胸！ ですの！"},
        { "location": "637/TALK"    , "narrator": "がすとちゃん", "text": "ポニーテールな\n感じになってて\nいつもと違う髪型と──"},
        { "location": "638/TALK"    , "narrator": "がすとちゃん", "text": "咥えたゴム、\nお胸が強調される\nポーズも絶妙ですの！"},
        { "location": "641/TALK"    , "narrator": "がすとちゃん", "text": "…って、\n何を言わせるですのーっ！"},
        { "location": "645/SEL"     , "narrator": "（選択肢）", "text": "言わせてねぇよ"},
        { "location": "646/ACT"     , "narrator": "", "text": "言わせてねぇよ"},
        { "location": "650/DIALOG"  , "narrator": "", "text": "type.千羽鶴＆エリカ"},
        { "location": "652/TALK"    , "narrator": "がすとちゃん", "text": "まったく、\nしょうがない\n$handle$ですの。"},
        { "location": "654/TALK"    , "narrator": "がすとちゃん", "text": "ちなみに、\n背景の中央が白いのは\nそういう仕様ですの。"},
        { "location": "655/TALK"    , "narrator": "がすとちゃん", "text": "世界のことに詳しい人から\nいちおう説明は\n受けたけど──"},
        { "location": "656/TALK"    , "narrator": "がすとちゃん", "text": "この二人は\n本来同じ場所には\nどうのこうの…。"},
        { "location": "657/TALK"    , "narrator": "がすとちゃん", "text": "がすとには難しくて\n理解できなかったですの。"},
        { "location": "658/TALK"    , "narrator": "がすとちゃん", "text": "きっと、あの人は\n地下室に閉じ込められて\nおかしくなってるですの。"},
        { "location": "666/TALK"    , "narrator": "がすとちゃん", "text": "とにかく、こうして\n出来上がったのが二人の\n素敵な水着シーンですの！"},
        { "location": "667/TALK"    , "narrator": "がすとちゃん", "text": "今回紹介した2つの\nタペストリーの\nほかにも──"},
        { "location": "669/TALK"    , "narrator": "がすとちゃん", "text": "いろんな商品が\n$handle$を\n待ってるですの！"},
        { "location": "678/TALK"    , "narrator": "がすとちゃん", "text": "詳しいことは\nガストショップで確認して\n夏本番に備えるですのー！"},
        { "location": "679/SEL"     , "narrator": "（選択肢）", "text": "あーはいはい"},
        { "location": "680/ACT"     , "narrator": "", "text": "あーはいはい"},
        { "location": "681/TALK"    , "narrator": "がすとちゃん", "text": "いい返事ですの。"},
        { "location": "687/TALK"    , "narrator": "がすとちゃん", "text": "それでは\n$handle$よ、\nレジの前でまた会おう！"},
        { "location": "688/TALK"    , "narrator": "がすとちゃん", "text": "ですの！！"},
        { "location": "691/DIALOG"  , "narrator": "", "text": "特大タペストリーの\n詳細情報を見ますか？"}
    ]
}
