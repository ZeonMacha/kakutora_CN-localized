{
    "dir": "chap37/daydra/dd_ch04_37_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "37402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "たったひとつの＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "たったひとつの"},
        { "location": "37/TALK"   , "narrator": "現実世界のみやび", "text": "宇宙…？"},
        { "location": "38/TALK"   , "narrator": "現実世界のみやび", "text": "確かうちは…。\nえーと……。"},
        { "location": "40/TALK"   , "narrator": "現実世界のみやび", "text": "フェノメノン！"},
        { "location": "41/TALK"   , "narrator": "現実世界のみやび", "text": "フェノメノンと化す\n途中やった。"},
        { "location": "42/TALK"   , "narrator": "現実世界のみやび", "text": "やき、ここに\n思考だけが浮いて\nしもうた。"},
        { "location": "43/TALK"   , "narrator": "現実世界のみやび", "text": "そいてうちは\n色んなうちの\n記憶を覗いた。"},
        { "location": "44/TALK"   , "narrator": "現実世界のみやび", "text": "…どのうちも\n結構ひどい目に\n遭うとったねえ。"},
        { "location": "49/TALK"   , "narrator": "恋ヶ崎みやび　", "text": "そこに居るんは\nみやびさんかね。"},
        { "location": "51/TALK"   , "narrator": "現実世界のみやび", "text": "…そういうあなたも\nみやびさん\nみたいやねえ。"},
        { "location": "52/TALK"   , "narrator": "恋ヶ崎みやび　", "text": "そっちのみやびさんは\n今がどうなっとるか\nわかるかね？"},
        { "location": "54/TALK"   , "narrator": "現実世界のみやび", "text": "…それがうちにも\nさっぱりやき。"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "恋ヶ崎みやびは\n再び別れた。"},
        { "location": "59/TALK"   , "narrator": "恋ヶ崎みやび　", "text": "つばめちゃん！？"},
        { "location": "60/TALK"   , "narrator": "現実世界のみやび", "text": "逢瀬つばめ…。"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "元々別の人間だった\n恋ヶ崎みやびは一度\n一人になり、また別れた。"},
        { "location": "62/TALK"   , "narrator": "現実世界のみやび", "text": "それが今の\nうちらいうこと？"},
        { "location": "63/TALK"   , "narrator": "恋ヶ崎みやび　", "text": "…そうみたいぞね。"},
        { "location": "64/SEL"    , "narrator": "", "text": "また違う世界のみやびになったってこと"},
        { "location": "65/SEL"    , "narrator": "", "text": "本来なら二人が出会うことはなかったはず"},
        { "location": "66/SEL"    , "narrator": "", "text": "今はイレギュラーな状態なんだよ"},
        { "location": "67/ACT"    , "narrator": "", "text": "また違う世界のみやびになったってこと"},
        { "location": "69/TALK"   , "narrator": "現実世界のみやび", "text": "現実世界のうちは\nフェノメノンの中の\nみやびやない。"},
        { "location": "70/TALK"   , "narrator": "恋ヶ崎みやび　", "text": "うちが現実世界の\nうちを知らんかったのと\n同じいうことやね。"},
        { "location": "71/ACT"    , "narrator": "", "text": "本来なら二人が出会うことはなかったはず"},
        { "location": "73/TALK"   , "narrator": "現実世界のみやび", "text": "同じ世界にうちが\n二人居ることは\n本来ないきね。"},
        { "location": "75/TALK"   , "narrator": "恋ヶ崎みやび　", "text": "これまでに色んな無茶が\n重なって\nしもうたきねえ。"},
        { "location": "76/ACT"    , "narrator": "", "text": "今はイレギュラーな状態なんだよ"},
        { "location": "78/TALK"   , "narrator": "現実世界のみやび", "text": "それはそうやろうね。"},
        { "location": "79/TALK"   , "narrator": "恋ヶ崎みやび　", "text": "お互い正常化を\n目指したいところ\nやね。"},
        { "location": "82/TALK"   , "narrator": "現実世界のみやび", "text": "うちはこの状態を\n正常に戻したい。"},
        { "location": "84/TALK"   , "narrator": "恋ヶ崎みやび　", "text": "気が合うね。\nさすがみやびさん。"},
        { "location": "85/TALK"   , "narrator": "恋ヶ崎みやび　", "text": "最後の記憶は…\n確か神楽が歌を\n歌うちょったろう。"},
        { "location": "86/TALK"   , "narrator": "現実世界のみやび", "text": "うちはセカイを\n蒸着する予定やった。"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "今フェノメノンは\n急速に収束しつつある。"},
        { "location": "88/TALK"   , "narrator": "現実世界のみやび", "text": "うわ……。"},
        { "location": "90/TALK"   , "narrator": "恋ヶ崎みやび　", "text": "そうなっちょるん\nかね…！"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "千羽鶴とのリンクが\n切断されたのが\n原因で。"},
        { "location": "92/TALK"   , "narrator": "現実世界のみやび", "text": "うちは何も\n持っちょらん。"},
        { "location": "93/TALK"   , "narrator": "現実世界のみやび", "text": "リンクの再接続は\n不可能ぞね…！"},
        { "location": "94/TALK"   , "narrator": "恋ヶ崎みやび　", "text": "ちうことは\nフェノメノンは\n消失する。"},
        { "location": "95/TALK"   , "narrator": "恋ヶ崎みやび　", "text": "うちは一緒に\n消えるんか？"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "いいえ。\nそうはならない。"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "恋ヶ崎みやびは\n統合される。"},
        { "location": "99/TALK"   , "narrator": "つばめ", "text": "ただ人格は\n統合できない。"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "だから表層のみやびと\n深層のみやびの\n二重構造になる。"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "深層のみやびは\n深く深く眠り続ける\nことになる。"},
        { "location": "103/TALK"  , "narrator": "恋ヶ崎みやび　", "text": "やったら。\n深層のみやび役は\n譲るきね。"},
        { "location": "104/TALK"  , "narrator": "恋ヶ崎みやび　", "text": "たっぷりと惰眠を\n貪ってくれ。\n現実のうち。"},
        { "location": "105/TALK"  , "narrator": "現実世界のみやび", "text": "またまた。\n遠慮はせんでええき。"},
        { "location": "106/TALK"  , "narrator": "現実世界のみやび", "text": "フェノメノンの\nうちこそゆっくり\n休めばええき。"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "どちらを表層にし\nどちらを深層にするかを\n決めることは――"},
        { "location": "109/TALK"  , "narrator": "つばめ", "text": "本人にはできない。"},
        { "location": "110/TALK"  , "narrator": "現実世界のみやび", "text": "何やて？"},
        { "location": "112/TALK"  , "narrator": "恋ヶ崎みやび　", "text": "やったら誰が\n決めるんか？"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "それは\n$handle$。"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "$handle$が\nその決定を下す。"},
        { "location": "181/TALK"  , "narrator": "なご", "text": "うち、ついに\n昇華できるんか！？"},
        { "location": "182/TALK"  , "narrator": "四十九夜", "text": "そうやよ、なごちゃん。\n$handle$が\n力になってくれたきね。"},
        { "location": "183/TALK"  , "narrator": "なご", "text": "えいやつやね、\n$handle$。"},
        { "location": "184/TALK"  , "narrator": "シンギュラリティ　", "text": "……。"},
        { "location": "185/TALK"  , "narrator": "なご", "text": "ほんだら早速、\n素敵なココロの旅へ\n向かうぞね――"},
        { "location": "199/TALK"  , "narrator": "なご", "text": "……うち。\nなんか少し\n変わったきがするけんど。"},
        { "location": "200/TALK"  , "narrator": "シンギュラリティ　", "text": "そうやね。"},
        { "location": "201/TALK"  , "narrator": "四十九夜", "text": "けんど……。"},
        { "location": "202/TALK"  , "narrator": "なご", "text": "フェノメノンは\n纏っちょらんよ？"},
        { "location": "203/TALK"  , "narrator": "シンギュラリティ　", "text": "うむ、確かに。"},
        { "location": "211/TALK"  , "narrator": "四十九夜", "text": "$handle$。\nお前さん、何か\n細工しよったが？"},
        { "location": "212/TALK"  , "narrator": "なご", "text": "酷いねや、\n$handle$。"},
        { "location": "213/SEL"   , "narrator": "", "text": "違いますよ！！"},
        { "location": "214/SEL"   , "narrator": "", "text": "なごちゃんに嫌われたら生きていけない！"},
        { "location": "215/ACT"   , "narrator": "", "text": "違いますよ！！"},
        { "location": "216/ACT"   , "narrator": "", "text": "なごちゃんに嫌われたら生きていけない！"},
        { "location": "217/TALK"  , "narrator": "四十九夜", "text": "何を\nうちみたいなことを\n言いゆうが。"},
        { "location": "218/TALK"  , "narrator": "なご", "text": "べつに、\n死んでもえいんよ？"},
        { "location": "221/TALK"  , "narrator": "シンギュラリティ　", "text": "なごちゃん……"},
        { "location": "222/TALK"  , "narrator": "なご", "text": "冗談やき。"},
        { "location": "227/TALK"  , "narrator": "四十九夜", "text": "やとすると、\nどういう事や……。"},
        { "location": "228/SEL"   , "narrator": "", "text": "千羽鶴が撃たれたんだよ"},
        { "location": "229/ACT"   , "narrator": "", "text": "千羽鶴が撃たれたんだよ"},
        { "location": "232/TALK"  , "narrator": "四十九夜", "text": "冗談は\n選択肢だけにしいや。"},
        { "location": "233/TALK"  , "narrator": "なご", "text": "四十九夜…。\n$handle$は\n選択肢でしか冗談言わんよ"},
        { "location": "234/TALK"  , "narrator": "四十九夜", "text": "しまった。\n抜かったね。"},
        { "location": "237/TALK"  , "narrator": "シンギュラリティ　", "text": "ぼけ突っ込み\nしゆう場合か！"},
        { "location": "238/TALK"  , "narrator": "シンギュラリティ　", "text": "で、今の状況は\nどうなっちゅう！？"},
        { "location": "239/SEL"   , "narrator": "", "text": "まさに今消滅してる"},
        { "location": "240/ACT"   , "narrator": "", "text": "まさに今消滅してる"},
        { "location": "247/TALK"  , "narrator": "シンギュラリティ　", "text": "いかんちや。\nどエラいことやぞ\nこれは！"},
        { "location": "248/TALK"  , "narrator": "シンギュラリティ　", "text": "うちと$handle$の\nラブラブメモリーが\n全部消えてまうぞね！"},
        { "location": "249/TALK"  , "narrator": "シンギュラリティ　", "text": "消えるのは\nHDDのデータだけで\n十分やよ……！"},
        { "location": "250/TALK"  , "narrator": "なご", "text": "ゆうても、\n何とかする方法なぞ――"},
        { "location": "251/TALK"  , "narrator": "千羽鶴", "text": "ある。"},
        { "location": "253/TALK"  , "narrator": "なご", "text": "……。"},
        { "location": "254/TALK"  , "narrator": "四十九夜", "text": "なごちゃん、どうなが？"},
        { "location": "260/TALK"  , "narrator": "シンギュラリティ　", "text": "……なごちゃん。"},
        { "location": "261/TALK"  , "narrator": "四十九夜", "text": "なんも\n変わっちょらんね。"},
        { "location": "262/TALK"  , "narrator": "なご", "text": "……。"},
        { "location": "263/TALK"  , "narrator": "なご", "text": "やっぱり\n$handle$は\n鬼悪魔や。"},
        { "location": "264/SEL"   , "narrator": "", "text": "それより大変なことが"},
        { "location": "265/SEL"   , "narrator": "", "text": "なごちゃんお願いだから嫌わないで"},
        { "location": "266/ACT"   , "narrator": "", "text": "それより大変なことが"},
        { "location": "275/ACT"   , "narrator": "", "text": "なごちゃんお願いだから嫌わないで"},
        { "location": "284/TALK"  , "narrator": "なご", "text": "$handle$に\n言われると\n意地悪したくなるぞね。"},
        { "location": "292/TALK"  , "narrator": "なご", "text": "どういたん？"},
        { "location": "293/SEL"   , "narrator": "", "text": "千羽鶴が殺された"},
        { "location": "294/ACT"   , "narrator": "", "text": "千羽鶴が殺された"},
        { "location": "296/TALK"  , "narrator": "なご", "text": "……。"},
        { "location": "297/TALK"  , "narrator": "なご", "text": "なご、もしかして\n$handle$に\n意地悪されゆう？"},
        { "location": "300/TALK"  , "narrator": "四十九夜", "text": "すぐ調べるよ。\nもしそうなら、すぐに\n追い出しちゃるき。"},
        { "location": "306/TALK"  , "narrator": "四十九夜", "text": "どーれどれ……"},
        { "location": "310/TALK"  , "narrator": "四十九夜", "text": "……。"},
        { "location": "313/TALK"  , "narrator": "四十九夜", "text": "ふむ。\n$handle$の\n言う通りぞね……。"},
        { "location": "314/TALK"  , "narrator": "シンギュラリティ　", "text": "なんやと！？\nちゅうことは――"},
        { "location": "316/SEL"   , "narrator": "", "text": "つばめの日本が消えかかってる"},
        { "location": "317/ACT"   , "narrator": "", "text": "つばめの日本が消えかかってる"},
        { "location": "325/TALK"  , "narrator": "なご", "text": "そうなってしまうね。"},
        { "location": "328/TALK"  , "narrator": "シンギュラリティ　", "text": "あぁ……\nうちと$handle$の\n貴重なセーブデータが……"},
        { "location": "329/TALK"  , "narrator": "四十九夜", "text": "何事も諸行無常や。\nなごちゃんのときも\nそうやったけんど。"},
        { "location": "330/TALK"  , "narrator": "四十九夜", "text": "形あるもの皆壊れる。\n諦めや。"},
        { "location": "331/TALK"  , "narrator": "なご", "text": "何言いゆう。\nうちらも同じぞね。"},
        { "location": "338/TALK"  , "narrator": "なご", "text": "あの冷徹きわまりない\n連中の前で、丸裸に\nなっちゅうんと同じやよ？"},
        { "location": "339/TALK"  , "narrator": "四十九夜", "text": "……たしかに、そうやね。"},
        { "location": "340/SEL"   , "narrator": "", "text": "みやび殺されちゃう！？"},
        { "location": "341/ACT"   , "narrator": "", "text": "みやび殺されちゃう！？"},
        { "location": "349/TALK"  , "narrator": "四十九夜", "text": "まあ、そうなるやろね。\n現実は現実。\nしっかりと受け入れ――"},
        { "location": "350/TALK"  , "narrator": "シンギュラリティ　", "text": "そんなこと出来るか！\nお前さんは\n達観し過ぎぞね！"},
        { "location": "351/TALK"  , "narrator": "なご", "text": "うちやってまだ\n元気に遊びたい盛りやよ。"},
        { "location": "353/TALK"  , "narrator": "四十九夜", "text": "突如阿鼻叫喚地獄に\nなりよった。"},
        { "location": "354/TALK"  , "narrator": "シンギュラリティ　", "text": "$handle$よ。\nこうなったら\n最後のちゅうを――"},
        { "location": "357/TALK"  , "narrator": "四十九夜", "text": "それ、ただ\nちゅうしたいだけと\n違うん？"},
        { "location": "358/TALK"  , "narrator": "なご", "text": "なんでうちら、\nこんな死の瀬戸際まで\nぼけツッコミしゆうが…。"},
        { "location": "361/TALK"  , "narrator": "シンギュラリティ　", "text": "なごちゃんの言う通りや！\nもっと建設的な話を\nせんといかんぞね！"},
        { "location": "362/TALK"  , "narrator": "四十九夜", "text": "お前がゆうな。"},
        { "location": "363/TALK"  , "narrator": "千羽鶴", "text": "私もそれに賛成。"},
        { "location": "400/TALK"  , "narrator": "シンギュラリティ　", "text": "お前は……"},
        { "location": "401/TALK"  , "narrator": "なご", "text": "お、千羽鶴や。"},
        { "location": "402/TALK"  , "narrator": "四十九夜", "text": "今宵は何用で？"},
        { "location": "404/SEL"   , "narrator": "", "text": "来たね"},
        { "location": "405/ACT"   , "narrator": "", "text": "来たね"},
        { "location": "409/SEL"   , "narrator": "", "text": "千羽鶴！\nエリカと話したの？"},
        { "location": "410/ACT"   , "narrator": "", "text": "千羽鶴！\nエリカと話したの？"},
        { "location": "413/TALK"  , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "414/TALK"  , "narrator": "千羽鶴", "text": "エリカとは\nちゃんと話をした。\nその結果――"},
        { "location": "415/TALK"  , "narrator": "千羽鶴", "text": "フェノメノンの存続には\n皆から力をもらう必要が\nあるとの判断に至った。"},
        { "location": "417/SEL"   , "narrator": "", "text": "千羽鶴は死んじゃうの！？"},
        { "location": "418/SEL"   , "narrator": "", "text": "力をもらうってどういうこと？"},
        { "location": "419/ACT"   , "narrator": "", "text": "千羽鶴は死んじゃうの！？"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "……まだ100％消えると\n決まったわけじゃない。"},
        { "location": "421/TALK"  , "narrator": "千羽鶴", "text": "この作戦が上手くいけば\nあるいは――"},
        { "location": "422/ACT"   , "narrator": "", "text": "力をもらうってどういうこと？"},
        { "location": "423/TALK"  , "narrator": "千羽鶴", "text": "今からそのことを話す。"},
        { "location": "426/SEL"   , "narrator": "", "text": "力をもらうってどういうこと？ "},
        { "location": "427/ACT"   , "narrator": "", "text": "力をもらうってどういうこと？ "},
        { "location": "429/TALK"  , "narrator": "千羽鶴", "text": "今からそのことを話す。"},
        { "location": "432/TALK"  , "narrator": "千羽鶴", "text": "あ、それから。"},
        { "location": "434/TALK"  , "narrator": "千羽鶴", "text": "エリカから、\n貴方が私の死を\n凄く心配してると聞いた。"},
        { "location": "436/TALK"  , "narrator": "千羽鶴", "text": "まあ、現状では\nそれに対する答えは\nどちらともいえないけど。"},
        { "location": "437/TALK"  , "narrator": "千羽鶴", "text": "ひとつだけ\n言わなくちゃいけない\nことがある。"},
        { "location": "440/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "441/TALK"  , "narrator": "千羽鶴", "text": "……ありがと。"},
        { "location": "448/TALK"  , "narrator": "千羽鶴", "text": "言わずともわかると\n思うけど、このままだと\n私は消滅する。"},
        { "location": "449/TALK"  , "narrator": "千羽鶴", "text": "そして、当然\n日本を包むフェノメノンも\n消えて、瓦礫と化す。"},
        { "location": "450/TALK"  , "narrator": "千羽鶴", "text": "もはや、全世界を発症に\nよって包み込むなんて事は\n確実に不可能だけど――"},
        { "location": "451/TALK"  , "narrator": "千羽鶴", "text": "現状のフェノメノンを\n維持する方法なら\n１つだけある。"},
        { "location": "452/TALK"  , "narrator": "なご", "text": "どうするん？"},
        { "location": "454/TALK"  , "narrator": "千羽鶴", "text": "今の貴方の状態、\nすなわちフェノメノン\n発症状態を維持すること。"},
        { "location": "455/TALK"  , "narrator": "千羽鶴", "text": "貴方と$handle$は\n共に合意の上で\nフェノメノンを発症した。"},
        { "location": "456/TALK"  , "narrator": "千羽鶴", "text": "だから、そのまま\n維持し続けることに\n異論は無いと思うけど――"},
        { "location": "457/TALK"  , "narrator": "千羽鶴", "text": "心に介入することで、\nその理由が変わった以上\n同意を得る必要がある。"},
        { "location": "458/TALK"  , "narrator": "千羽鶴", "text": "だから、\n改めて聞きます。"},
        { "location": "459/TALK"  , "narrator": "千羽鶴", "text": "なご。\n$handle$――。"},
        { "location": "460/TALK"  , "narrator": "千羽鶴", "text": "このまま発症した状態で\n私を受け入れ委ねてもらう\nことは可能か否か。"},
        { "location": "462/TALK"  , "narrator": "千羽鶴", "text": "なご。\n貴方の力を\n使わせてもらうこと。"},
        { "location": "463/TALK"  , "narrator": "四十九夜", "text": "それは要するに、\n慰霊祭をするのと同義。"},
        { "location": "465/TALK"  , "narrator": "千羽鶴", "text": "違う。"},
        { "location": "466/TALK"  , "narrator": "千羽鶴", "text": "ただ単に、\nわたしとココロを\n繋げて欲しいだけ。"},
        { "location": "467/TALK"  , "narrator": "千羽鶴", "text": "1xではなく、\n2xとして。"},
        { "location": "468/TALK"  , "narrator": "シンギュラリティ　", "text": "また新たな機能追加か。\nパンピーに優しくない\nOSやね。"},
        { "location": "469/TALK"  , "narrator": "千羽鶴", "text": "1xは、単にココロ同士を\n連絡線で繋いでいるだけの\n独立した魂同士だけど――"},
        { "location": "470/TALK"  , "narrator": "千羽鶴", "text": "2xは、完全にココロに\nとけ込む状態。\nすなわち“一心”になる。"},
        { "location": "471/TALK"  , "narrator": "千羽鶴", "text": "単純に言えば――"},
        { "location": "472/TALK"  , "narrator": "千羽鶴", "text": "私、厳密には逢瀬つばめが\n貴方と潜在意識下で\nココロを共有する。"},
        { "location": "473/TALK"  , "narrator": "千羽鶴", "text": "もちろん永久ではない。\nフェノメノンが消えれば\n繋がりも消える。"},
        { "location": "474/TALK"  , "narrator": "千羽鶴", "text": "発症と違い、力も不要で\nココロが壊れるような\nリスクもない。"},
        { "location": "475/TALK"  , "narrator": "千羽鶴", "text": "ただ。"},
        { "location": "476/TALK"  , "narrator": "千羽鶴", "text": "当然他人のココロを繋ぐ\nわけだから、当人の\n承諾無しにはできない。"},
        { "location": "477/TALK"  , "narrator": "千羽鶴", "text": "だから、最終判断は\n貴方たちに委ねる。"},
        { "location": "478/TALK"  , "narrator": "なご", "text": "わかった。\nようわかったよ。"},
        { "location": "482/TALK"  , "narrator": "なご", "text": "けんど、\nなかなか難しい問題ぞね。"},
        { "location": "483/TALK"  , "narrator": "なご", "text": "うち、元々\n千羽鶴のため、ゆうんは\nあまり無かったきね。"},
        { "location": "484/TALK"  , "narrator": "なご", "text": "意味の無いことで\nあまり力は使いたく\nないけんど――"},
        { "location": "485/TALK"  , "narrator": "なご", "text": "なあ、$handle$。\nお前はどう思うん？"},
        { "location": "486/TALK"  , "narrator": "なご", "text": "千羽鶴に力を\n与えた方がえいんかね？"},
        { "location": "488/SEL"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れない"},
        { "location": "489/ACT"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れない"},
        { "location": "494/SEL"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れる"},
        { "location": "495/SEL"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れない "},
        { "location": "496/ACT"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れる"},
        { "location": "499/ACT"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れない "},
        { "location": "504/TALK"  , "narrator": "なご", "text": "そうかー。\nわかった。"},
        { "location": "505/TALK"  , "narrator": "なご", "text": "ほんだらうちは――"},
        { "location": "506/TALK"  , "narrator": "なご", "text": "……悩むなぁ。"},
        { "location": "548/TALK"  , "narrator": "なご", "text": "うちは、\n協力することにするぞね。"},
        { "location": "552/TALK"  , "narrator": "なご", "text": "うちは、\n協力せんことにするぞね。"},
        { "location": "554/TALK"  , "narrator": "なご", "text": "前も話したとおり、\nうちの目的は、本物の\nなごちゃんの為やき。"},
        { "location": "555/TALK"  , "narrator": "なご", "text": "やき、今回の件は\nうち自体にとっては、\n重要やないんよ。"},
        { "location": "556/TALK"  , "narrator": "なご", "text": "どっちにしても、\n実現にはほど遠い\n状況やし――"},
        { "location": "557/TALK"  , "narrator": "なご", "text": "ほんだら、\n$handle$に賭けて\n見てもえいかと思うてな。"},
        { "location": "558/TALK"  , "narrator": "なご", "text": "うち以上にうちのこと\n見てくれちょるし、今回の\n答えも意味はあるかと。"},
        { "location": "559/TALK"  , "narrator": "なご", "text": "やき、うちの答えは\n$handle$と\n一緒やよ。"},
        { "location": "563/TALK"  , "narrator": "なご", "text": "うちは、\n協力せんことにするぞね。"},
        { "location": "564/TALK"  , "narrator": "なご", "text": "前も話したとおり、\nうちの目的は、本物の\nなごちゃんの為やき。"},
        { "location": "565/TALK"  , "narrator": "なご", "text": "やき、今回の件は\nうち自体にとっては、\n重要やないんよ。"},
        { "location": "566/TALK"  , "narrator": "なご", "text": "どっちにしても、\nうちの目的実現には\nほど遠い状況やし――"},
        { "location": "567/TALK"  , "narrator": "なご", "text": "うちの力を\n無駄な事には使いたく\nないと思うたんよ。"},
        { "location": "568/TALK"  , "narrator": "なご", "text": "$handle$の意見も\n参考にしようかと\n思うたけんどなぁ……"},
        { "location": "569/TALK"  , "narrator": "なご", "text": "こいつの行動見ちゅうと\n結構いい加減やし、\nまっことえいことせんき。"},
        { "location": "570/SEL"   , "narrator": "", "text": "心当たりはあります"},
        { "location": "571/SEL"   , "narrator": "", "text": "え、なんで！？"},
        { "location": "572/ACT"   , "narrator": "", "text": "ですよねー"},
        { "location": "573/ACT"   , "narrator": "", "text": "え、なんで！？"},
        { "location": "574/TALK"  , "narrator": "なご", "text": "どの口が\nそれを言いゆう。"},
        { "location": "576/TALK"  , "narrator": "なご", "text": "お前さん、\nうちのこと“適当でえい”\nとか言うちょったやか。"},
        { "location": "578/TALK"  , "narrator": "なご", "text": "お前さん“うちの死亡確認\nをとる”とか言うて\nバカにしちょったが。"},
        { "location": "580/TALK"  , "narrator": "なご", "text": "別にお前さんのことが\n嫌いゆうわけやないよ？"},
        { "location": "581/TALK"  , "narrator": "なご", "text": "ただ、こうゆう大事な\n局面では参考にせん、\nゆうだけやきね。"},
        { "location": "583/TALK"  , "narrator": "なご", "text": "そうゆうわけやき、\nうちは力は貸さんよ。"},
        { "location": "587/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "588/TALK"  , "narrator": "千羽鶴", "text": "貴方たちの選択のお陰で\nこの世界は継続するかも\nしれない。"},
        { "location": "589/TALK"  , "narrator": "千羽鶴", "text": "ただ、問題はここから。"},
        { "location": "590/TALK"  , "narrator": "千羽鶴", "text": "まず、恋ヶ崎みやびは\nこれから私を受け入れる\nため、戦う必要がある。"},
        { "location": "591/TALK"  , "narrator": "千羽鶴", "text": "それは、私を承認する為に\n必要不可欠なこと。"},
        { "location": "593/TALK"  , "narrator": "千羽鶴", "text": "そして、\n$handle$――"},
        { "location": "595/TALK"  , "narrator": "千羽鶴", "text": "貴方の意志としては私を\n受け入れなかったけど、\n最終結論は総意による。"},
        { "location": "597/TALK"  , "narrator": "千羽鶴", "text": "貴方の意志としては私を\n受け入れてくれたけど、\n最終結論は総意による。"},
        { "location": "601/SEL"   , "narrator": "", "text": "総意が関係するからでしょ？"},
        { "location": "602/SEL"   , "narrator": "", "text": "総意？"},
        { "location": "603/ACT"   , "narrator": "", "text": "総意が関係するからでしょ？"},
        { "location": "605/ACT"   , "narrator": "", "text": "総意？"},
        { "location": "610/SEL"   , "narrator": "", "text": "総意？ "},
        { "location": "611/ACT"   , "narrator": "", "text": "総意？ "},
        { "location": "616/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "619/TALK"  , "narrator": "千羽鶴", "text": "そう。総意。"},
        { "location": "620/TALK"  , "narrator": "千羽鶴", "text": "この問題は、私個人の\n感情や記憶にかかわる\nものではない。"},
        { "location": "621/TALK"  , "narrator": "千羽鶴", "text": "このフェノメノン\n全体という、\n世界としての判断になる。"},
        { "location": "622/TALK"  , "narrator": "千羽鶴", "text": "わかりやすく言えば、\n今の日本は、貴方たちの\n総意が作り出してる。"},
        { "location": "624/TALK"  , "narrator": "千羽鶴", "text": "貴方一人が私を否定しても\n他の協力者が肯定したら、\n継続されることになる。"},
        { "location": "625/TALK"  , "narrator": "千羽鶴", "text": "だから、今の段階では\n100％希望に添えるかは\nわからないということ。"},
        { "location": "627/TALK"  , "narrator": "千羽鶴", "text": "貴方一人が継続を願っても\n他の協力者が否定したら、\nそれは継続不可能になる。"},
        { "location": "628/TALK"  , "narrator": "千羽鶴", "text": "だから、今の段階では\n100％希望に添えるかは\nわからないということ。"},
        { "location": "629/TALK"  , "narrator": "千羽鶴", "text": "それまで貴方は、\n今の想いを変えずに\nいてもらいたい。"},
        { "location": "634/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、準備はいい？"},
        { "location": "636/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "637/TALK"  , "narrator": "千羽鶴", "text": "心と心の問題だから、\n素直な気持ちに忠実な\n選択をするしかない。"},
        { "location": "638/TALK"  , "narrator": "千羽鶴", "text": "ただ、その場合、\n私は貴方を無力化\nしなければならない。"},
        { "location": "639/TALK"  , "narrator": "千羽鶴", "text": "なぜなら、私にとって\nこのフェノメノンは、\nまだ必要なものだから。"},
        { "location": "640/TALK"  , "narrator": "千羽鶴", "text": "私はまだ全然\n諦めていない。"},
        { "location": "641/TALK"  , "narrator": "千羽鶴", "text": "この世界から“彼ら”を\n排除し、理想的社会を\n構築することを。"},
        { "location": "642/TALK"  , "narrator": "千羽鶴", "text": "その最後の牙城である\nこのフェノメノンの維持は\n必要不可欠なの。"},
        { "location": "643/TALK"  , "narrator": "千羽鶴", "text": "だから、貴方には\n恨みがあるわけではない。\nけど――"},
        { "location": "644/TALK"  , "narrator": "千羽鶴", "text": "私には護らねばならない\nものがある。\nだから、戦う。"},
        { "location": "645/TALK"  , "narrator": "なご", "text": "構わんよ。\nうちは元々お前のこと\nあまり好いちょらんき。"},
        { "location": "646/TALK"  , "narrator": "千羽鶴", "text": "…そうだったかも。"},
        { "location": "648/TALK"  , "narrator": "なご", "text": "$handle$。"},
        { "location": "650/TALK"  , "narrator": "なご", "text": "何やかや言うたけんど、\nうちはお前さんのこと\n感謝しちゅうよ？"},
        { "location": "651/SEL"   , "narrator": "", "text": "嫌われてなくてよかった！"},
        { "location": "652/SEL"   , "narrator": "", "text": "なごちゃんかわいいよ尊いよハァハァ"},
        { "location": "653/ACT"   , "narrator": "", "text": "嫌われてなくてよかった！"},
        { "location": "654/TALK"  , "narrator": "なご", "text": "うちがお前さんに\n冷たいのは、いじめたく\nなるからやき。"},
        { "location": "655/TALK"  , "narrator": "なご", "text": "今後もあまり\n心配せんでもえいよ？"},
        { "location": "656/ACT"   , "narrator": "", "text": "なごちゃんかわいいよ尊いよハァハァ"},
        { "location": "657/TALK"  , "narrator": "なご", "text": "前言撤回や。\nただの変態やったね。"},
        { "location": "658/TALK"  , "narrator": "なご", "text": "訂正はせんよ。\n投げっぱにしとき。"},
        { "location": "659/TALK"  , "narrator": "シンギュラリティ　", "text": "いじり倒して放置とは！"},
        { "location": "660/TALK"  , "narrator": "四十九夜", "text": "なごちゃん強いね…。"},
        { "location": "664/TALK"  , "narrator": "なご", "text": "けんどなぁ。"},
        { "location": "665/TALK"  , "narrator": "なご", "text": "恋ヶ崎みやびは、\nまっこと、お前さんに\n逢えたことを幸せに思う。"},
        { "location": "666/TALK"  , "narrator": "なご", "text": "うちに必要やったんは、\n同情してくれる輩でも、\nボディーガードでもなく。"},
        { "location": "667/TALK"  , "narrator": "なご", "text": "ただ、うちの傍にいて\n話を聞いてくれる輩\nやったんよ。"},
        { "location": "668/TALK"  , "narrator": "なご", "text": "お前さんは、いつだって\nうちの話を辛抱強く\n聞いてくれよったき。"},
        { "location": "669/TALK"  , "narrator": "なご", "text": "それだけで、うちが\nどれだけ幸せやったか、\nわからんきね。"},
        { "location": "670/TALK"  , "narrator": "なご", "text": "そうゆう意味では、\n縁組みをした千羽鶴にも\n少しは感謝せんとやね。"},
        { "location": "671/TALK"  , "narrator": "なご", "text": "これっきりや、\nもう言わんよ。"},
        { "location": "672/TALK"  , "narrator": "なご", "text": "うちと一緒にいてくれて\nありがとうね。"},
        { "location": "674/TALK"  , "narrator": "千羽鶴", "text": "そろそろいい？"},
        { "location": "675/TALK"  , "narrator": "なご", "text": "えいよ。\nお互いフルボッコで\nいこうな。"},
        { "location": "676/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\nよろしくお願いします。"},
        { "location": "677/TALK"  , "narrator": "千羽鶴", "text": "恋ヶ崎みやびと\nこのフェノメノンの未来に\n素敵なココロの旅を。"},
        { "location": "31/DIALOG" , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "35/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>-月--日　 -:-- --</color>\nNull"}
