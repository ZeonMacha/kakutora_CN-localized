{
    "dir": "chap10/daydra/dd_ch02_10_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "10205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "切れない物が怖い＜後編＞"
    },
    "entry":
    [
        { "location": "433/SCENARIO", "narrator": "", "text": "切れない物が怖い"},
        { "location": "453/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "454/TALK"    , "narrator": "アーヤ", "text": "マズいわ。\nもうこんな時間…。"},
        { "location": "455/TALK"    , "narrator": "アーヤ", "text": "そろそろ帰らないと、\nさすがに迷惑よね？"},
        { "location": "457/TALK"    , "narrator": "アーヤ", "text": "でも…今は部屋に\n戻りたくないし…。"},
        { "location": "459/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "460/TALK"    , "narrator": "アーヤ", "text": "やっぱり、時計の方\n気にしてる！"},
        { "location": "461/TALK"    , "narrator": "アーヤ", "text": "どうしよう…。"},
        { "location": "462/SEL"     , "narrator": "", "text": "つばめにも護身術を教えよう"},
        { "location": "463/SEL"     , "narrator": "", "text": "つばめに好きだから同棲しようと伝えよう"},
        { "location": "464/ACT"     , "narrator": "", "text": "つばめにも護身術を教えよう"},
        { "location": "480/TALK"    , "narrator": "アーヤ", "text": "それいいかも(^^"},
        { "location": "481/TALK"    , "narrator": "アーヤ", "text": "それならもうしばらく"},
        { "location": "482/TALK"    , "narrator": "アーヤ", "text": "部屋に帰らなくてすむし＼(^O^)／"},
        { "location": "483/TALK"    , "narrator": "アーヤ", "text": "早速言ってみるわ"},
        { "location": "495/TALK"    , "narrator": "アーヤ", "text": "逢瀬さん。\nよければだけど――"},
        { "location": "496/TALK"    , "narrator": "アーヤ", "text": "今から、簡単な\n護身術を教えま\nしょうか？"},
        { "location": "500/TALK"    , "narrator": "つばめ", "text": "えっ！？\n今からですか？"},
        { "location": "501/TALK"    , "narrator": "アーヤ", "text": "…やっぱり、\nダメよね。"},
        { "location": "502/TALK"    , "narrator": "つばめ", "text": "あ、えと…ダメって\nわけじゃないです\nけど――"},
        { "location": "503/TALK"    , "narrator": "つばめ", "text": "でも、これ以上部屋に\n引き留めるのは\n迷惑なんじゃ…。"},
        { "location": "504/TALK"    , "narrator": "アーヤ", "text": "全然迷惑じゃない\nから！"},
        { "location": "505/TALK"    , "narrator": "つばめ", "text": "そ、そうですか？"},
        { "location": "506/TALK"    , "narrator": "つばめ", "text": "それじゃあ、\nお願いしようかな？"},
        { "location": "508/TALK"    , "narrator": "アーヤ", "text": "やった！！\nこれで部屋に戻らずに\n済むわ！"},
        { "location": "510/TALK"    , "narrator": "アーヤ", "text": "じゃあ、うどんを\n食べたら早速始め\nましょ。"},
        { "location": "530/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "537/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…。\n何やってんのかしら、\nうるさいわね…。"},
        { "location": "543/TALK"    , "narrator": "ガブリエラ", "text": "ああもう！！"},
        { "location": "566/TALK"    , "narrator": "アーヤ", "text": "じゃあ、もう一度\n行くわよ。"},
        { "location": "567/TALK"    , "narrator": "つばめ", "text": "はい！"},
        { "location": "568/TALK"    , "narrator": "アーヤ", "text": "相手に肩を掴まれたり\nした時は、こうして！"},
        { "location": "609/TALK"    , "narrator": "ガブリエラ", "text": "うるさーい！！\n何やってんのよ、\nこんな夜中、に…。"},
        { "location": "611/TALK"    , "narrator": "つばめ", "text": "えっ？"},
        { "location": "612/TALK"    , "narrator": "アーヤ", "text": "あら、ギャヴィ。"},
        { "location": "616/TALK"    , "narrator": "ガブリエラ", "text": "あ、あんた達、\n何やってんのよ！？"},
        { "location": "617/TALK"    , "narrator": "つばめ", "text": "凄いんですよ。\nアーヤさん、色んな\nこと知ってるんです！"},
        { "location": "619/TALK"    , "narrator": "ガブリエラ", "text": "知ってる！？\n何を！？"},
        { "location": "620/TALK"    , "narrator": "アーヤ", "text": "ごめんなさい。\nうるさかったかしら？"},
        { "location": "621/TALK"    , "narrator": "アーヤ", "text": "でも、せっかくだから\nギャヴィもどう？"},
        { "location": "622/TALK"    , "narrator": "ガブリエラ", "text": "や、やるわけない\nでしょ！！\n二人とも、不潔よー！"},
        { "location": "644/TALK"    , "narrator": "みやび", "text": "んー、\n確かこの辺に\n落ちたような…。"},
        { "location": "646/TALK"    , "narrator": "みやび", "text": "おっ、あったあった。\nどこも壊れちょらん\nようやな。"},
        { "location": "647/TALK"    , "narrator": "みやび", "text": "ドローンに、\nカカシ括り付けて\n飛ばそういうんは――"},
        { "location": "648/TALK"    , "narrator": "みやび", "text": "ちくっと無理あった\nようやな…。"},
        { "location": "649/TALK"    , "narrator": "みやび", "text": "成功すれば、次は\nうちがぶら下がる\n予定やったけんど――"},
        { "location": "651/TALK"    , "narrator": "みやび", "text": "空を自由に飛べるように\nなるんは、まだまだ\n未来の話か…。"},
        { "location": "658/TALK"    , "narrator": "ガブリエラ", "text": "二人とも、不潔よー！"},
        { "location": "661/TALK"    , "narrator": "みやび", "text": "はぁ…、\n近所迷惑やねぇ…。"},
        { "location": "662/ACT"     , "narrator": "", "text": "つばめに好きだから同棲しようと伝えよう"},
        { "location": "680/TALK"    , "narrator": "アーヤ", "text": "あのね(--#)"},
        { "location": "681/TALK"    , "narrator": "アーヤ", "text": "ちょっとふざけ過ぎよ"},
        { "location": "682/TALK"    , "narrator": "アーヤ", "text": "今はそんな冗談で笑えないわ(｀ヘ´)"},
        { "location": "684/SEL"     , "narrator": "", "text": "つばめが動揺すれば、その間はいられる"},
        { "location": "685/ACT"     , "narrator": "", "text": "つばめが動揺すれば、その間はいられる"},
        { "location": "687/TALK"    , "narrator": "アーヤ", "text": "そうかもしれないけど"},
        { "location": "688/TALK"    , "narrator": "アーヤ", "text": "もっと方法あるでしょ？(´o｀；"},
        { "location": "689/TALK"    , "narrator": "アーヤ", "text": "同棲しようとか"},
        { "location": "690/TALK"    , "narrator": "アーヤ", "text": "ぶっ飛び過ぎよ(-ω-；)"},
        { "location": "692/SEL"     , "narrator": "", "text": "そんなこと言ってると、部屋に帰されるよ？"},
        { "location": "693/ACT"     , "narrator": "", "text": "そんなこと言ってると、部屋に帰されるよ？"},
        { "location": "695/TALK"    , "narrator": "アーヤ", "text": "そうかもしれないけど"},
        { "location": "696/TALK"    , "narrator": "アーヤ", "text": "違う方法でお願いしたいわm(_ _)m"},
        { "location": "698/SEL"     , "narrator": "", "text": "グッドラック！"},
        { "location": "699/ACT"     , "narrator": "", "text": "グッドラック！"},
        { "location": "703/TALK"    , "narrator": "アーヤ", "text": "なっ！？"},
        { "location": "706/TALK"    , "narrator": "アーヤ", "text": "チャット閉じた！？\nなんて薄情な…！！"},
        { "location": "709/TALK"    , "narrator": "つばめ", "text": "…あっ、すみません。"},
        { "location": "711/TALK"    , "narrator": "つばめ", "text": "わたし、そろそろ\n寝る時間で…。"},
        { "location": "714/TALK"    , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "715/TALK"    , "narrator": "アーヤ", "text": "あ、そ、そうよね！\nああ、それじゃあ\n私も――"},
        { "location": "716/TALK"    , "narrator": "アーヤ", "text": "逢瀬さんと\n一緒に寝るわ。"},
        { "location": "718/TALK"    , "narrator": "つばめ", "text": "はい。\nそれじゃあまた――"},
        { "location": "721/TALK"    , "narrator": "つばめ", "text": "…って、えぇっ！？"},
        { "location": "722/TALK"    , "narrator": "アーヤ", "text": "ど、どうしよう！\n勢いで変なこと\n言っちゃった！"},
        { "location": "723/TALK"    , "narrator": "つばめ", "text": "あ、あの、気持ちは\n嬉しいですけど――"},
        { "location": "724/TALK"    , "narrator": "つばめ", "text": "もう、わたし一人でも\n大丈夫ですから。"},
        { "location": "725/TALK"    , "narrator": "アーヤ", "text": "そ、そう？\nまあ、確かにもう…。"},
        { "location": "727/TALK"    , "narrator": "アーヤ", "text": "ううん、ダメ！\nその考え甘い！！"},
        { "location": "728/TALK"    , "narrator": "アーヤ", "text": "女の子の一人暮らしは\n常に危険と隣合わせ\nなのよ？"},
        { "location": "729/TALK"    , "narrator": "アーヤ", "text": "だから、私もここで\n一緒に寝るわ。"},
        { "location": "730/TALK"    , "narrator": "つばめ", "text": "そ、そんなに東京って\n危険なんですか！？"},
        { "location": "732/TALK"    , "narrator": "つばめ", "text": "なら、ガブリエラ\nせんぱいも一人だと\n危険なんじゃ…？"},
        { "location": "733/TALK"    , "narrator": "アーヤ", "text": "あああ…、何だか\nややこしいことに\nなってきちゃってる。"},
        { "location": "734/SEL"     , "narrator": "", "text": "今からでも遅くない、言うんだ！"},
        { "location": "735/ACT"     , "narrator": "", "text": "今からでも遅くない、言うんだ！"},
        { "location": "754/TALK"    , "narrator": "アーヤ", "text": "ああもう"},
        { "location": "755/TALK"    , "narrator": "アーヤ", "text": "ちょっと黙ってて！"},
        { "location": "766/TALK"    , "narrator": "つばめ", "text": "あの、わたし今から\nせんぱいを呼んで――"},
        { "location": "767/TALK"    , "narrator": "アーヤ", "text": "だ、ダメ！！\nそうじゃないの！"},
        { "location": "768/TALK"    , "narrator": "アーヤ", "text": "私は、逢瀬さんを\n放っておけないから\n言ってるの。"},
        { "location": "769/TALK"    , "narrator": "つばめ", "text": "え？"},
        { "location": "770/TALK"    , "narrator": "アーヤ", "text": "だって、ほら…、\n逢瀬さんって――"},
        { "location": "771/TALK"    , "narrator": "アーヤ", "text": "一人にしておけない、\nこう…危なっかしさ？\nそういうのあるから。"},
        { "location": "773/TALK"    , "narrator": "つばめ", "text": "えーっ！？\nそ、そんなこと\nないですよー！"},
        { "location": "774/TALK"    , "narrator": "つばめ", "text": "こっちでの生活にも\n慣れてきてますし――"},
        { "location": "775/TALK"    , "narrator": "つばめ", "text": "それに、そんなに\n子供じゃないです！"},
        { "location": "777/TALK"    , "narrator": "アーヤ", "text": "子供扱いしてる\nわけじゃなくて――"},
        { "location": "778/TALK"    , "narrator": "アーヤ", "text": "危なっかしくて\n一人に出来ない、\nって言ってるの！"},
        { "location": "780/TALK"    , "narrator": "つばめ", "text": "それ、同じですよ！"},
        { "location": "799/TALK"    , "narrator": "ガブリエラ", "text": "ほっ…寝る前の\nハーブティーって、\n凄く落ち着くわ…。"},
        { "location": "800/TALK"    , "narrator": "ガブリエラ", "text": "今日もいい気分で\nベッドに入れ――"},
        { "location": "803/TALK"    , "narrator": "透明つばめ", "text": "えーっ！？"},
        { "location": "804/TALK"    , "narrator": "ガブリエラ", "text": "ぶっ！！"},
        { "location": "805/TALK"    , "narrator": "透明つばめ", "text": "そ、そんなこと\nないですよー！"},
        { "location": "806/TALK"    , "narrator": "ガブリエラ", "text": "げほっ、げほっ…。\nあ、あのバカ新人…！"},
        { "location": "807/TALK"    , "narrator": "透明つばめ", "text": "それ、同じですよ！"},
        { "location": "809/TALK"    , "narrator": "ガブリエラ", "text": "あたしの、大切な\n夜のひと時を…！！"},
        { "location": "842/TALK"    , "narrator": "つばめ", "text": "もう、本当にわたし\n一人でも平気ですから！"},
        { "location": "845/TALK"    , "narrator": "アーヤ", "text": "いや、ダメって\n言ってるわけじゃ\nないのよ？"},
        { "location": "846/TALK"    , "narrator": "アーヤ", "text": "ただ、私が個人的に\n放っておけないって\n思ってるだけで…。"},
        { "location": "847/TALK"    , "narrator": "つばめ", "text": "わーん！\nやっぱり子供扱い\nされてるー！"},
        { "location": "848/TALK"    , "narrator": "アーヤ", "text": "だから、子供扱いを\nしてるわけじゃ――"},
        { "location": "849/TALK"    , "narrator": "アーヤ", "text": "ああ、もう！\nわかった、言うわ！！"},
        { "location": "850/TALK"    , "narrator": "アーヤ", "text": "私は――"},
        { "location": "855/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと、新人！！\nこんな時間に\n何騒いで――"},
        { "location": "856/TALK"    , "narrator": "アーヤ", "text": "私は逢瀬さんのことが\n大好きなの！！"},
        { "location": "857/TALK"    , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "859/TALK"    , "narrator": "つばめ", "text": "えっ？"},
        { "location": "860/TALK"    , "narrator": "アーヤ", "text": "だから、一人にする\nのが不安で――"},
        { "location": "862/TALK"    , "narrator": "ガブリエラ", "text": "…な、なによ…。\n何よ、それ…。"},
        { "location": "863/TALK"    , "narrator": "アーヤ", "text": "あ、ギャヴィ？\nいつの間に来て――"},
        { "location": "864/TALK"    , "narrator": "ガブリエラ", "text": "う…。"},
        { "location": "866/TALK"    , "narrator": "ガブリエラ", "text": "うわーん！！\nアーヤのバカー！！"},
        { "location": "867/TALK"    , "narrator": "アーヤ", "text": "ちょ、何！？\n何で泣くのよ！？"},
        { "location": "870/TALK"    , "narrator": "つばめ", "text": "うわーん！！\nやっぱり子供扱いじゃ\nないですかー！！"},
        { "location": "871/TALK"    , "narrator": "アーヤ", "text": "いや、だからそうじゃ\nなくって！！"},
        { "location": "874/TALK"    , "narrator": "アーヤ", "text": "…私も、泣きたく\nなってきたわ…。"},
        { "location": "897/TALK"    , "narrator": "みやび", "text": "んー、\n確かこの辺に\n落ちたような…。"},
        { "location": "899/TALK"    , "narrator": "みやび", "text": "おっ、あったあった。\nどこも壊れちょらん\nようやな。"},
        { "location": "900/TALK"    , "narrator": "みやび", "text": "ドローンに、\nカカシ括り付けて\n飛ばそういうんは――"},
        { "location": "901/TALK"    , "narrator": "みやび", "text": "ちくっと無理あった\nようやな…。"},
        { "location": "902/TALK"    , "narrator": "みやび", "text": "成功すれば、次は\nうちがぶら下がる\n予定やったけんど――"},
        { "location": "904/TALK"    , "narrator": "みやび", "text": "空を自由に飛べるように\nなるんは、まだまだ\n未来の話か…。"},
        { "location": "908/TALK"    , "narrator": "透明ガブリエラ", "text": "うわーん！！\nアーヤのバカー！！"},
        { "location": "910/TALK"    , "narrator": "透明つばめ", "text": "うわーん！！\nやっぱり子供扱いじゃ\nないですかー！！"},
        { "location": "911/TALK"    , "narrator": "透明アーヤ", "text": "いや、だからそうじゃ\nなくって！！"},
        { "location": "914/TALK"    , "narrator": "みやび", "text": "はぁ…、\n近所迷惑やねぇ…。"},
        { "location": "926/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【08 HANABI】"}
    ]
}
