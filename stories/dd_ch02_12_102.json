        "title": "005 メインストーリー",
        "sub_title": "アーヤの午後＜後編＞"
    },
    "entry":
    [
        { "location": "344/SCENARIO", "narrator": "", "text": "アーヤの午後"},
        { "location": "363/TALK"    , "narrator": "プレイヤー", "text": "アーヤのタイプって？"},
        { "location": "364/TALK"    , "narrator": "アーヤ", "text": "それは"},
        { "location": "365/TALK"    , "narrator": "アーヤ", "text": "うーん"},
        { "location": "371/TALK"    , "narrator": "アーヤ", "text": "笑わないし"},
        { "location": "372/TALK"    , "narrator": "アーヤ", "text": "誰にも言わないって約束するなら"},
        { "location": "373/TALK"    , "narrator": "アーヤ", "text": "ヒントくらいは言ってもいいかも(｡-_-｡)"},
        { "location": "375/SEL"     , "narrator": "", "text": "約束します"},
        { "location": "376/ACT"     , "narrator": "", "text": "約束します"},
        { "location": "379/TALK"    , "narrator": "アーヤ", "text": "じゃあヒントね"},
        { "location": "380/TALK"    , "narrator": "アーヤ", "text": "いつも凛としていて"},
        { "location": "381/TALK"    , "narrator": "アーヤ", "text": "私を支えてくれる人(*^.^*)"},
        { "location": "384/TALK"    , "narrator": "アーヤ", "text": "はいおしまい(>_<)"},
        { "location": "386/SEL"     , "narrator": "", "text": "もう少しヒントを！"},
        { "location": "387/ACT"     , "narrator": "", "text": "もう少しヒントを！"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "ダメ(｀ヘ´)"},
        { "location": "390/TALK"    , "narrator": "アーヤ", "text": "この話はもうおしまい"},
        { "location": "398/TALK"    , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "400/TALK"    , "narrator": "アーヤ", "text": "…さすがに、\nこれ以上は\n言えないわ。"},
        { "location": "401/TALK"    , "narrator": "アーヤ", "text": "こんな時代なのに\n亭主関白な人が\n理想だなんて。"},
        { "location": "402/TALK"    , "narrator": "アーヤ", "text": "笑われる？\nううん、ドン引き\nされるわ。"},
        { "location": "405/TALK"    , "narrator": "店員", "text": "お待たせいたし\nました。"},
        { "location": "407/TALK"    , "narrator": "アーヤ", "text": "あ、どうも…。"},
        { "location": "409/TALK"    , "narrator": "店員", "text": "…？\n何かありましたか？"},
        { "location": "412/TALK"    , "narrator": "アーヤ", "text": "へ！？"},
        { "location": "415/TALK"    , "narrator": "店員", "text": "いえ、先ほどより\n元気がない感じに\n見えたので。"},
        { "location": "417/TALK"    , "narrator": "アーヤ", "text": "そ、そうですか？\n別に、なんてこと\nないですけど…。"},
        { "location": "419/TALK"    , "narrator": "店員", "text": "…そうですか。\nそれならばよいの\nですが。"},
        { "location": "420/TALK"    , "narrator": "店員", "text": "では、ごゆっくり。"},
        { "location": "425/TALK"    , "narrator": "アーヤ", "text": "…ここのマスター、\n相変わらず観察力が\n凄いわ。"},
        { "location": "426/SEL"     , "narrator": "", "text": "仲良さそうだね"},
        { "location": "427/ACT"     , "narrator": "", "text": "仲良さそうだね"},
        { "location": "439/TALK"    , "narrator": "アーヤ", "text": "仲が良いっていうのかしら？(｡-_-｡)"},
        { "location": "440/TALK"    , "narrator": "アーヤ", "text": "よく来る店だから"},
        { "location": "441/TALK"    , "narrator": "アーヤ", "text": "顔を覚えられてるだけよ(^^"},
        { "location": "444/TALK"    , "narrator": "アーヤ", "text": "仲良しといえば"},
        { "location": "445/TALK"    , "narrator": "アーヤ", "text": "つばめのお友達のこと知ってる？(￣Д￣ )"},
        { "location": "447/SEL"     , "narrator": "", "text": "雛達のこと？"},
        { "location": "448/ACT"     , "narrator": "", "text": "雛達のこと？"},
        { "location": "450/TALK"    , "narrator": "アーヤ", "text": "そう"},
        { "location": "451/TALK"    , "narrator": "アーヤ", "text": "あの子達ってば"},
        { "location": "452/TALK"    , "narrator": "アーヤ", "text": "うちの劇場でアルバイトすることになったの(☆｡☆)"},
        { "location": "453/TALK"    , "narrator": "アーヤ", "text": "正確には"},
        { "location": "454/TALK"    , "narrator": "アーヤ", "text": "劇場のバイト兼トライナリーの手伝いだけど(￣∇￣)"},
        { "location": "456/SEL"     , "narrator": "", "text": "真幌は許可したの？"},
        { "location": "457/ACT"     , "narrator": "", "text": "真幌は許可したの？"},
        { "location": "459/TALK"    , "narrator": "アーヤ", "text": "したらしいわ"},
        { "location": "460/TALK"    , "narrator": "アーヤ", "text": "実はあの子達"},
        { "location": "461/TALK"    , "narrator": "アーヤ", "text": "バイトをしたいから館長に口添えしてくれって"},
        { "location": "462/TALK"    , "narrator": "アーヤ", "text": "私のところに来たのよ"},
        { "location": "463/TALK"    , "narrator": "アーヤ", "text": "もちろん断ったけど(￣Д￣ )"},
        { "location": "464/TALK"    , "narrator": "アーヤ", "text": "トライナリーは秘密の特殊部隊だし"},
        { "location": "465/TALK"    , "narrator": "アーヤ", "text": "でもその後"},
        { "location": "466/TALK"    , "narrator": "アーヤ", "text": "ギャヴィに頼んで口添えしてもらったらしいの(>_<)"},
        { "location": "468/SEL"     , "narrator": "", "text": "ガブリエラが？　珍しいね"},
        { "location": "469/ACT"     , "narrator": "", "text": "ガブリエラが？　珍しいね"},
        { "location": "471/TALK"    , "narrator": "アーヤ", "text": "私も驚いたわ(☆｡☆)"},
        { "location": "473/TALK"    , "narrator": "アーヤ", "text": "ギャヴィがそんな手伝いをするなんて"},
        { "location": "474/TALK"    , "narrator": "アーヤ", "text": "ちょっと意外かも"},
        { "location": "476/SEL"     , "narrator": "", "text": "でも、みんないい子だよ"},
        { "location": "477/ACT"     , "narrator": "", "text": "でも、みんないい子だよ"},
        { "location": "479/TALK"    , "narrator": "アーヤ", "text": "それは心配してないわ"},
        { "location": "480/TALK"    , "narrator": "アーヤ", "text": "つばめのお友達なら"},
        { "location": "481/TALK"    , "narrator": "アーヤ", "text": "変な子じゃないと思うし(^^"},
        { "location": "483/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "484/TALK"    , "narrator": "アーヤ", "text": "日向さんがちょっと困るかも(；´Д｀)"},
        { "location": "485/TALK"    , "narrator": "アーヤ", "text": "私のこと"},
        { "location": "486/TALK"    , "narrator": "アーヤ", "text": "綾水様って呼ぶのがね(-ω-;)"},
        { "location": "487/TALK"    , "narrator": "アーヤ", "text": "それがちょっと恥ずかしくて(>_<)"},
        { "location": "489/SEL"     , "narrator": "", "text": "アーヤは雛の白馬の王子様なんだよ"},
        { "location": "490/ACT"     , "narrator": "", "text": "アーヤは雛の白馬の王子様なんだよ"},
        { "location": "492/TALK"    , "narrator": "アーヤ", "text": "喜べないから！(｀ヘ´)"},
        { "location": "500/TALK"    , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "501/TALK"    , "narrator": "アーヤ", "text": "私が望んでるのは、\nその逆なのに。"},
        { "location": "502/TALK"    , "narrator": "アーヤ", "text": "私、いつまで経っても\nこうなのね…。"},
        { "location": "513/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【10 江戸川橋物語】"}
    ]
}
