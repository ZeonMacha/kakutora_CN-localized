        { "location": "157/SCENARIO", "narrator": "", "text": "140_キューピッドになりなさい"},
        { "location": "182/TALK"    , "narrator": "ガブリエラ", "text": "色々考えたのよ"},
        { "location": "183/TALK"    , "narrator": "ガブリエラ", "text": "貴方のこと"},
        { "location": "185/SEL"     , "narrator": "", "text": "$handle$のことが好きなんだね"},
        { "location": "186/SEL"     , "narrator": "", "text": "それはうれしいな"},
        { "location": "187/SEL"     , "narrator": "", "text": "結論は？"},
        { "location": "188/ACT"     , "narrator": "", "text": "$handle$のことが好きなんだね"},
        { "location": "189/ACT"     , "narrator": "", "text": "それはうれしいな"},
        { "location": "190/ACT"     , "narrator": "", "text": "結論は？"},
        { "location": "192/TALK"    , "narrator": "ガブリエラ", "text": "貴方が人間なんだったら"},
        { "location": "193/TALK"    , "narrator": "ガブリエラ", "text": "ヒカルくんの気持ちもわかるわよね"},
        { "location": "195/SEL"     , "narrator": "", "text": "わからなくもないけど"},
        { "location": "196/SEL"     , "narrator": "", "text": "なんでそうなるの？"},
        { "location": "197/ACT"     , "narrator": "", "text": "わからなくもないけど"},
        { "location": "207/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "そうだと思っていたわv"},
        { "location": "210/ACT"     , "narrator": "", "text": "なんでそうなるの？"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "違うの？"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "ありえないわ"},
        { "location": "215/TALK"    , "narrator": "ガブリエラ", "text": "そんなわけで"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "貴方にはヒカルくんとのキューピッドになってもらうわ"},
        { "location": "218/SEL"     , "narrator": "", "text": "了解いたしました、姫"},
        { "location": "219/SEL"     , "narrator": "", "text": "なんでそうなるの？"},
        { "location": "220/SEL"     , "narrator": "", "text": "だが断る"},
        { "location": "221/ACT"     , "narrator": "", "text": "了解いたしました、姫"},
        { "location": "231/TALK"    , "narrator": "ガブリエラ", "text": "いいお返事ねv"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "よくできましたv"},
        { "location": "234/ACT"     , "narrator": "", "text": "なんでそうなるの？"},
        { "location": "235/TALK"    , "narrator": "ガブリエラ", "text": "なんでって"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "なんででもよ"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "当たり前じゃない"},
        { "location": "239/TALK"    , "narrator": "ガブリエラ", "text": "そんなの"},
        { "location": "240/ACT"     , "narrator": "", "text": "だが断る"},
        { "location": "241/TALK"    , "narrator": "ガブリエラ", "text": "ひどいこと言うのね！"},
        { "location": "243/TALK"    , "narrator": "ガブリエラ", "text": "貴方がずっと嘘をついていたんじゃないの"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "いいから言うことを聞きなさい"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "そういうことだから！"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんと協力するのよ？"},
        { "location": "249/SEL"     , "narrator": "", "text": "わかった"},
        { "location": "250/SEL"     , "narrator": "", "text": "いやだ"},
        { "location": "251/SEL"     , "narrator": "", "text": "$handle$の気持ちは？"},
        { "location": "252/ACT"     , "narrator": "", "text": "わかった"},
        { "location": "253/TALK"    , "narrator": "ガブリエラ", "text": "よしよしv"},
        { "location": "255/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ頼むわね"},
        { "location": "256/ACT"     , "narrator": "", "text": "いやだ"},
        { "location": "257/TALK"    , "narrator": "ガブリエラ", "text": "この期に及んでそんなこと言うの！？"},
        { "location": "258/TALK"    , "narrator": "ガブリエラ", "text": "本当にありえないわね"},
        { "location": "259/TALK"    , "narrator": "ガブリエラ", "text": "でもこのことは決定事項だから！"},
        { "location": "260/TALK"    , "narrator": "ガブリエラ", "text": "頼んだわよ！"},
        { "location": "261/ACT"     , "narrator": "", "text": "$handle$の気持ちは？"},
        { "location": "262/TALK"    , "narrator": "ガブリエラ", "text": "知らないわ、そんなもの"},
        { "location": "263/TALK"    , "narrator": "ガブリエラ", "text": "私の気持ちをずっと"},
        { "location": "264/TALK"    , "narrator": "ガブリエラ", "text": "ううん、そんなことどうでもいいわ"},
        { "location": "265/TALK"    , "narrator": "ガブリエラ", "text": "とにかく決めたから！"},
        { "location": "266/TALK"    , "narrator": "ガブリエラ", "text": "頼んだわよ！"},
        { "location": "268/TALK"    , "narrator": "ガブリエラ", "text": "大事な事だから"},
        { "location": "269/TALK"    , "narrator": "ガブリエラ", "text": "ボイスメールでも送っておくわね"},
        { "location": "270/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんと聞いてちょうだいね！？"},
        { "location": "273/TALK"    , "narrator": "ボイスメール", "text": "恋と慎み"},
        { "location": "203/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "227/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
