        { "location": "250/SCENARIO", "narrator": "", "text": "決めなきゃいけない"},
        { "location": "277/TALK"    , "narrator": "つばめ", "text": "自分を大事にするってどうゅぅことなの？"},
        { "location": "278/TALK"    , "narrator": "つばめ", "text": "みんなに言われちゃった"},
        { "location": "279/TALK"    , "narrator": "つばめ", "text": "ぁたしはそれができてないの？"},
        { "location": "281/SEL"     , "narrator": "", "text": "一緒に考えてみようか"},
        { "location": "282/SEL"     , "narrator": "", "text": "難しい子もいるよ"},
        { "location": "283/SEL"     , "narrator": "", "text": "つばめは本当はどうしたいの"},
        { "location": "285/ACT"     , "narrator": "", "text": "一緒に考えてみようか"},
        { "location": "286/TALK"    , "narrator": "つばめ", "text": "$handle$さんは"},
        { "location": "287/TALK"    , "narrator": "つばめ", "text": "いっつも優しいょね(´・ω・｀)"},
        { "location": "288/ACT"     , "narrator": "", "text": "難しい子もいるよ"},
        { "location": "289/TALK"    , "narrator": "つばめ", "text": "ぁたしは難しい子なんだね"},
        { "location": "290/TALK"    , "narrator": "つばめ", "text": "なんでなんだろぅ(´・ω・｀)"},
        { "location": "291/ACT"     , "narrator": "", "text": "つばめは本当はどうしたいの"},
        { "location": "302/TALK"    , "narrator": "つばめ", "text": "ぁたしが本当にしたいこと・・・"},
        { "location": "305/TALK"    , "narrator": "つばめ", "text": "(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "308/SEL"     , "narrator": "", "text": "思いついたらでいいよ"},
        { "location": "309/ACT"     , "narrator": "", "text": "思いついたらでいいよ"},
        { "location": "311/TALK"    , "narrator": "つばめ", "text": "そぅ(*´﹃｀*)？"},
        { "location": "312/TALK"    , "narrator": "つばめ", "text": "よかった"},
        { "location": "314/TALK"    , "narrator": "つばめ", "text": "$handle$さんやさしぃからすき"},
        { "location": "317/TALK"    , "narrator": "つばめ", "text": "えっとね"},
        { "location": "318/TALK"    , "narrator": "つばめ", "text": "笑わないできぃて"},
        { "location": "319/TALK"    , "narrator": "つばめ", "text": "ぁたしはみんなが幸せになるようにしたぃの"},
        { "location": "320/TALK"    , "narrator": "つばめ", "text": "卯月さんも"},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "ほかのみんなも"},
        { "location": "322/TALK"    , "narrator": "つばめ", "text": "できるとおもぅ(´ｪ｀；)三(；´ｪ｀)？"},
        { "location": "324/SEL"     , "narrator": "", "text": "できるとも"},
        { "location": "325/SEL"     , "narrator": "", "text": "頑張り次第"},
        { "location": "326/ACT"     , "narrator": "", "text": "できるとも"},
        { "location": "327/TALK"    , "narrator": "つばめ", "text": "できるかな"},
        { "location": "328/TALK"    , "narrator": "つばめ", "text": "$handle$さんが言うなら"},
        { "location": "330/TALK"    , "narrator": "つばめ", "text": "できるょね"},
        { "location": "331/ACT"     , "narrator": "", "text": "頑張り次第"},
        { "location": "332/TALK"    , "narrator": "つばめ", "text": "がんばらないといけないよね"},
        { "location": "333/TALK"    , "narrator": "つばめ", "text": "でもきっと"},
        { "location": "334/TALK"    , "narrator": "つばめ", "text": "できると思うんだ"},
        { "location": "337/TALK"    , "narrator": "つばめ", "text": "これって"},
        { "location": "338/TALK"    , "narrator": "つばめ", "text": "自分を大事にしてることになるの？"},
        { "location": "340/SEL"     , "narrator": "", "text": "自己犠牲を伴わなければ"},
        { "location": "341/SEL"     , "narrator": "", "text": "信念があれば"},
        { "location": "342/SEL"     , "narrator": "", "text": "なるなる、超なる"},
        { "location": "343/ACT"     , "narrator": "", "text": "自己犠牲を伴わなければ"},
        { "location": "344/TALK"    , "narrator": "つばめ", "text": "それゎ"},
        { "location": "345/TALK"    , "narrator": "つばめ", "text": "自分を大事にしてなぃってことなんだね"},
        { "location": "346/TALK"    , "narrator": "つばめ", "text": "・・・そっかー(･Д･｀)"},
        { "location": "347/ACT"     , "narrator": "", "text": "信念があれば"},
        { "location": "348/TALK"    , "narrator": "つばめ", "text": "信念かぁ"},
        { "location": "349/TALK"    , "narrator": "つばめ", "text": "ぁたしはそれがなぃのかな(*´﹃｀*)"},
        { "location": "350/ACT"     , "narrator": "", "text": "なるなる、超なる"},
        { "location": "351/TALK"    , "narrator": "つばめ", "text": "もー"},
        { "location": "353/TALK"    , "narrator": "つばめ", "text": "真面目な話してるのに―ヽ(；▽；)ノ"},
        { "location": "356/SEL"     , "narrator": "", "text": "ひとつだけ約束して"},
        { "location": "357/ACT"     , "narrator": "", "text": "ひとつだけ約束して"},
        { "location": "359/TALK"    , "narrator": "つばめ", "text": "なあに？"},
        { "location": "361/SEL"     , "narrator": "", "text": "「みんな」の中につばめを入れること"},
        { "location": "362/ACT"     , "narrator": "", "text": "「みんな」の中につばめを入れること"},
        { "location": "364/TALK"    , "narrator": "つばめ", "text": "ぁたしも仲間外れは嫌だょ"},
        { "location": "366/SEL"     , "narrator": "", "text": "つばめもちゃんと幸せになること"},
        { "location": "367/ACT"     , "narrator": "", "text": "つばめもちゃんと幸せになること"},
