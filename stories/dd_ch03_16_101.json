{
    "dir": "chap16/daydra/dd_ch03_16_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "16302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "プライベートタイム＜前編＞"
    },
    "entry":
    [
        { "location": "29/TALK"   , "narrator": "雛", "text": "つばめちゃん。\n帰りにカフェに\n寄ってかない？"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "ごめん…。\n今日、バイトのシフト\n入ってて…。"},
        { "location": "33/TALK"   , "narrator": "雛", "text": "あれ？　今日って\nそうだったっけ？"},
        { "location": "34/TALK"   , "narrator": "繭", "text": "キリト達と一緒に\nシフト入ってたはず。"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "うん。そういうこと\nだから、今日は先に\n帰るね。"},
        { "location": "36/TALK"   , "narrator": "雛", "text": "おっけー。\nバイト頑張ってねー。"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "うん、また明日ー。"},
        { "location": "41/TALK"   , "narrator": "雛", "text": "…さてと、それじゃ\nどこ行こっか？"},
        { "location": "43/TALK"   , "narrator": "繭", "text": "カフェでいいと思う。\n座れるし。"},
        { "location": "45/TALK"   , "narrator": "雛", "text": "だねー。\nじゃ、それで。"},
        { "location": "47/TALK"   , "narrator": "雛", "text": "あっ、\nガブリエラちゃん！"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "あら、そっちも\n今帰り？"},
        { "location": "54/TALK"   , "narrator": "雛", "text": "うん…もしかして、\n今日ってこれから\nバイト入ってる？"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "え？　ううん、\n入ってないけど…。"},
        { "location": "56/TALK"   , "narrator": "雛", "text": "じゃ、決まりねー。\n一緒にカフェに行こ。"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "ちょ！？　勝手に\n決めないでよ！"},
        { "location": "58/TALK"   , "narrator": "繭", "text": "何か予定でもあるの？"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "べ、別にないけど…。"},
        { "location": "61/TALK"   , "narrator": "雛", "text": "じゃあいいじゃん。\n手伝ってほしいことも\nあるんだしー。"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "は？"},
        { "location": "64/TALK"   , "narrator": "繭", "text": "アプリゲームで、\n今日から新しい\nイベントが始まるの。"},
        { "location": "65/TALK"   , "narrator": "繭", "text": "でも、攻略するには、\n一人でも多くの助けが\n必要…。"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "アプリゲーム？\nああ、もしかして\nカプドラのこと？"},
        { "location": "67/TALK"   , "narrator": "雛", "text": "そうそう！\nガブリエラちゃんも\nやってる？"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "まあね…。\nイベントのことは\n忘れてたけど。"},
        { "location": "70/TALK"   , "narrator": "繭", "text": "やってるなら好都合。\n手伝ってほしい。"},
        { "location": "71/TALK"   , "narrator": "繭", "text": "協力プレイなら\n一日で結構進むと\n思う。"},
        { "location": "72/TALK"   , "narrator": "雛", "text": "だからさ、放課後は\n三人でカプドラして\n遊ぼうよ！"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "75/TALK"   , "narrator": "雛", "text": "あれ？　もしかして\nソロプレイ派？"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "そ、そういうわけじゃ\nないけど…。"},
        { "location": "77/TALK"   , "narrator": "繭", "text": "何か問題？"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "え、えっと…。"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "…なんか、やたらと\nフレンドリーに\n誘ってくるわね？"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "そんなに仲がいいって\nわけじゃないのに…。"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "でも、つばめの教室\nとか劇場ではよく\n話してるもの。"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "これくらいは普通…\nなのかしら？"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "でも、放課後一緒に\nゲームするほどの\n仲じゃないし…"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "う～ん…。"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "　"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "あら、$handle$。\nいらっしゃい。"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "今回の悩みは\n何なのかしらね！"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x333番地から\n0xFCC番地へ。"},
        { "location": "183/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了っ♪"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "それで、\n今回のあたしは……？"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "ああ、なるほど。\nあたしらしい悩みね。"},
        { "location": "189/SEL"   , "narrator": "", "text": "自分から見ると、放課後一緒にゲームするくらいの仲に見える"},
        { "location": "190/SEL"   , "narrator": "", "text": "放課後遊ぶとなると、またちょっと構えちゃうよね"},
        { "location": "191/ACT"   , "narrator": "", "text": "自分から見ると、放課後一緒にゲームするくらいの仲に見える"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "うーん、そういうもの\nなのかしらね？"},
        { "location": "193/ACT"   , "narrator": "", "text": "放課後遊ぶとなると、またちょっと構えちゃうよね"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "そうそう。\nそうなのよね。"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "学校にいる時に仲良く\nお話するからって、\n放課後もっていうと――"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "それはそれで\n全然別の話だもの。"},
        { "location": "199/TALK"  , "narrator": "ガブリエラ", "text": "パブリックな時間と\nプライベートな時間では\n付き合い方も違うのよ。"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "学校にいる時間は\nパブリックな時間。"},
        { "location": "201/TALK"  , "narrator": "ガブリエラ", "text": "でも、解放されたら\nそこからはプライベートな\n時間なの。"},
        { "location": "202/TALK"  , "narrator": "ガブリエラ", "text": "プライベートな時間に\n一緒にいる人っていうのは\nやっぱり特別なのよね。"},
        { "location": "203/SEL"   , "narrator": "", "text": "西洋的な考え方だね"},
        { "location": "204/SEL"   , "narrator": "", "text": "てことはアーヤは特別なんだね"},
        { "location": "205/SEL"   , "narrator": "", "text": "てことはつばめは特別なんだね"},
        { "location": "206/SEL"   , "narrator": "", "text": "てことは$me$は特別なんだね"},
        { "location": "207/ACT"   , "narrator": "", "text": "西洋的な考え方だね"},
        { "location": "209/TALK"  , "narrator": "ガブリエラ", "text": "あたしからすれば、\n放課後までつき合うなんて\n日本的だと思うわよ？"},
        { "location": "210/TALK"  , "narrator": "ガブリエラ", "text": "まあでも、前に本で\n読んだけど、日本って\nそうなのよね。"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "仕事終わってからも\n会社の人と飲んだり\nするんでしょう？"},
        { "location": "212/TALK"  , "narrator": "ガブリエラ", "text": "それって結構\nブルーよね。"},
        { "location": "213/TALK"  , "narrator": "ガブリエラ", "text": "だって、朝から寝る前まで\n１日中仕事してるって\nことじゃない。"},
        { "location": "214/TALK"  , "narrator": "ガブリエラ", "text": "あれを読んだとき、\nちょっと目眩がしたわね。"},
        { "location": "215/SEL"   , "narrator": "", "text": "飲み会と仕事は違うよ"},
        { "location": "216/SEL"   , "narrator": "", "text": "その気持ちすごくわかる！！"},
        { "location": "217/ACT"   , "narrator": "", "text": "飲み会と仕事は違うよ"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "そうなのね。\nそういう感覚なのね、\nやっぱり。"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "日本のことは大好きだけど\nそこだけはどうしても\n共感できないのよね。"},
        { "location": "220/ACT"   , "narrator": "", "text": "その気持ちすごくわかる！！"},
        { "location": "221/TALK"  , "narrator": "ガブリエラ", "text": "ほんと！？"},
        { "location": "222/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり\n$handle$とは\n気が合うわね！"},
        { "location": "223/TALK"  , "narrator": "ガブリエラ", "text": "学校で昼間ずっと\n縛られてるんだもの！"},
        { "location": "224/TALK"  , "narrator": "ガブリエラ", "text": "放課後くらい、自分の\n自由意志で行動したい\nじゃない！"},
        { "location": "225/TALK"  , "narrator": "ガブリエラ", "text": "あたしたち、\n似てるわね～♪"},
        { "location": "227/ACT"   , "narrator": "", "text": "てことはアーヤは特別なんだね"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "え？\nそうかしら？"},
        { "location": "230/SEL"   , "narrator": "", "text": "放課後や休日一緒にいるよね"},
        { "location": "231/ACT"   , "narrator": "", "text": "放課後や休日一緒にいるよね"},
        { "location": "233/TALK"  , "narrator": "ガブリエラ", "text": "そんなこと――"},
        { "location": "234/TALK"  , "narrator": "ガブリエラ", "text": "……た、たまたまよ。"},
        { "location": "235/TALK"  , "narrator": "ガブリエラ", "text": "たまたまあんたが\n見ている瞬間に、偶然\n一緒にいるだけだから。"},
        { "location": "236/SEL"   , "narrator": "", "text": "そういうことにしておきますね"},
        { "location": "237/ACT"   , "narrator": "", "text": "そういうことにしておきますね"},
        { "location": "239/TALK"  , "narrator": "ガブリエラ", "text": "そ、そうよ！\nそれでいいのよ。"},
        { "location": "240/ACT"   , "narrator": "", "text": "てことはつばめは特別なんだね"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "もちろんよ！\nつばめは特別なの！"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "現実のあたしは\n絶対に認めないけど。"},
        { "location": "243/ACT"   , "narrator": "", "text": "てことは$me$は特別なんだね"},
        { "location": "244/TALK"  , "narrator": "ガブリエラ", "text": "ええ、そうね！\nあたしにとっては\nすごい特別よ？"},
        { "location": "245/SEL"   , "narrator": "", "text": "あたしにとって「は」？"},
        { "location": "246/SEL"   , "narrator": "", "text": "ガブリエラ全体にとっては、だよね？"},
        { "location": "247/ACT"   , "narrator": "", "text": "あたしにとって「は」？"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "ええ。そうだけど？\n何か問題あったかしら？"},
        { "location": "249/TALK"  , "narrator": "ガブリエラ", "text": "前にもお話ししたけど、\n$handle$は\nあたしの大切な人だもの。"},
        { "location": "250/SEL"   , "narrator": "", "text": "他の人格は？"},
        { "location": "251/ACT"   , "narrator": "", "text": "他の人格は？"},
        { "location": "253/TALK"  , "narrator": "ガブリエラ", "text": "んー、それはちょっと\nわからないかな。"},
        { "location": "254/TALK"  , "narrator": "ガブリエラ", "text": "自分自身じゃないもの。"},
        { "location": "255/ACT"   , "narrator": "", "text": "ガブリエラ全体にとっては、だよね？"},
        { "location": "256/TALK"  , "narrator": "ガブリエラ", "text": "んー、それはちょっと\nわからないかな。"},
        { "location": "257/TALK"  , "narrator": "ガブリエラ", "text": "自分自身じゃないもの。"},
        { "location": "259/TALK"  , "narrator": "ガブリエラ", "text": "で、なんだったかしら。\nえっと――"},
        { "location": "260/TALK"  , "narrator": "ガブリエラ", "text": "あ、そうそう、\n放課後つき合うような仲か\nだったわね。"},
        { "location": "261/TALK"  , "narrator": "ガブリエラ", "text": "実際にどうかは\nわからないけど、あたしは\n一緒に遊びたいかしら。"},
        { "location": "262/TALK"  , "narrator": "ガブリエラ", "text": "郷には入れば郷に従え\nなんて言葉もあるけど、\nやっぱり刷り込みは強烈。"},
        { "location": "263/TALK"  , "narrator": "ガブリエラ", "text": "どうしてもプライベートを\n共にするに値する相手か、\n値すると思われてるか。"},
        { "location": "264/TALK"  , "narrator": "ガブリエラ", "text": "そういうのを\n気にしちゃうのよね。"},
        { "location": "265/SEL"   , "narrator": "", "text": "確かに子供の頃にやってたことって刷り込まれるよね"},
        { "location": "266/SEL"   , "narrator": "", "text": "もっと気楽に生きよう"},
        { "location": "267/ACT"   , "narrator": "", "text": "確かに子供の頃にやってたことって刷り込まれるよね"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "ほんと。\n三つ子の魂百までって\n言うものね。"},
        { "location": "269/SEL"   , "narrator": "", "text": "ホントによく知ってるね"},
        { "location": "270/SEL"   , "narrator": "", "text": "流石に知識ありすぎじゃない？"},
        { "location": "271/ACT"   , "narrator": "", "text": "ホントによく知ってるね"},
        { "location": "272/TALK"  , "narrator": "ガブリエラ", "text": "ええ。\nいっぱい勉強したもの。\n日本に来るためにね。"},
        { "location": "273/ACT"   , "narrator": "", "text": "流石に知識ありすぎじゃない？"},
        { "location": "274/TALK"  , "narrator": "ガブリエラ", "text": "ん？\nなんだかちょっと\n訝しげな発言ね。"},
        { "location": "275/TALK"  , "narrator": "ガブリエラ", "text": "普通に興味を持って\n勉強していれば、\nこれくらい覚えるわよ。"},
        { "location": "277/ACT"   , "narrator": "", "text": "もっと気楽に生きよう"},
        { "location": "278/TALK"  , "narrator": "ガブリエラ", "text": "それができたらね～。"},
        { "location": "282/TALK"  , "narrator": "ガブリエラ", "text": "というわけで、\n今回もよろしくお願いね。"},
        { "location": "283/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！"},
        { "location": "28/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月22日　3:18 PM</color>\nフェノメノン発生の２日前、平日の放課後学園校門にて。"},
        { "location": "102/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "104/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "106/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "108/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "110/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
