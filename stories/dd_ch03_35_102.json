        "title": "005 メインストーリー",
        "sub_title": "天使の役割＜後編＞"
    },
    "entry":
    [
        { "location": "717/SCENARIO", "narrator": "", "text": "任務を続行せよ"},
        { "location": "737/TALK"    , "narrator": "ガブリエラ", "text": "宇宙…？\nなんで……。"},
        { "location": "740/TALK"    , "narrator": "ガブリエラ", "text": "知らないあたしの\n記憶が……！？"},
        { "location": "741/TALK"    , "narrator": "ガブリエラ", "text": "これがフェノメノンの\n中のあたし…！？"},
        { "location": "742/TALK"    , "narrator": "ガブリエラ", "text": "……このままじゃまずい。"},
        { "location": "743/TALK"    , "narrator": "ガブリエラ", "text": "一刻も早く\n逢瀬つばめのセカイを\n蒸着させないと…！"},
        { "location": "744/SEL"     , "narrator": "", "text": "大丈夫？"},
        { "location": "745/SEL"     , "narrator": "", "text": "どうなってるの？"},
        { "location": "746/SEL"     , "narrator": "", "text": "落ち着こう"},
        { "location": "747/ACT"     , "narrator": "", "text": "大丈夫？"},
        { "location": "748/TALK"    , "narrator": "ガブリエラ", "text": "あまりよくはないわ。"},
        { "location": "749/ACT"     , "narrator": "", "text": "どうなってるの？"},
        { "location": "750/TALK"    , "narrator": "ガブリエラ", "text": "わからないけど。"},
        { "location": "751/ACT"     , "narrator": "", "text": "落ち着こう"},
        { "location": "752/TALK"    , "narrator": "ガブリエラ", "text": "落ち着いてるわ。"},
        { "location": "754/TALK"    , "narrator": "ガブリエラ", "text": "それよりあなた\n早く協力して。"},
        { "location": "755/TALK"    , "narrator": "ガブリエラ", "text": "今かなりまずい事態に\nなってるの。"},
        { "location": "756/SEL"     , "narrator": "", "text": "そんなこと言われても"},
        { "location": "757/SEL"     , "narrator": "", "text": "こっちも大変なんだ"},
        { "location": "758/SEL"     , "narrator": "", "text": "どうすればいいのかな？"},
        { "location": "759/ACT"     , "narrator": "", "text": "そんなこと言われても"},
        { "location": "760/TALK"    , "narrator": "ガブリエラ", "text": "計画通りに進めないと\n大変なことになるわ。"},
        { "location": "761/ACT"     , "narrator": "", "text": "こっちも大変なんだ"},
        { "location": "762/TALK"    , "narrator": "ガブリエラ", "text": "そんなの後回しで\nいいわよ。"},
        { "location": "763/ACT"     , "narrator": "", "text": "どうすればいいのかな？"},
        { "location": "764/TALK"    , "narrator": "ガブリエラ", "text": "依頼主から\n聞いてないの？"},
        { "location": "779/TALK"    , "narrator": "ガブリエラ", "text": "何これ！？"},
        { "location": "781/TALK"    , "narrator": "ガブリエラ", "text": "どうなってるの？\n説明して！"},
        { "location": "782/SEL"     , "narrator": "", "text": "$me$じゃない"},
        { "location": "783/SEL"     , "narrator": "", "text": "$me$にもわからない"},
        { "location": "784/SEL"     , "narrator": "", "text": "心当たりはないの？"},
        { "location": "785/ACT"     , "narrator": "", "text": "$me$じゃない"},
        { "location": "786/TALK"    , "narrator": "ガブリエラ", "text": "それでもわかることとか\nあるんじゃないの？"},
        { "location": "787/ACT"     , "narrator": "", "text": "$me$にもわからない"},
        { "location": "788/TALK"    , "narrator": "ガブリエラ", "text": "これは完全に\n任務遂行妨害よ！"},
        { "location": "789/ACT"     , "narrator": "", "text": "心当たりはないの？"},
        { "location": "790/TALK"    , "narrator": "ガブリエラ", "text": "あったら聞かないわ！"},
        { "location": "792/TALK"    , "narrator": "ガブリエラ", "text": "せめて回転を止めて！"},
        { "location": "820/TALK"    , "narrator": "ガブリエラ", "text": "……え？"},
        { "location": "821/TALK"    , "narrator": "ガブリエラ", "text": "ここって……。"},
        { "location": "732/DIALOG"  , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "768/DIALOG"  , "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0xFE】</color>\n\nココロアドレスが\nコンフリクトしています。\n\n至急、競合の解除をしてください。\n(295)"},
