    "info": {
        "story_id": "30070",
        "cid": "scenario",
        "title": "らぶとーく解説",
        "sub_title": "チュートリアル_らぶとーく解説"
    },
    "entry":
    [
        { "location": "1612/SCENARIO", "narrator": "", "text": "チュートリアル_らぶとーく解説"},
        { "location": "1625/TALK"    , "narrator": "千羽鶴", "text": "…そうそう、\nひとつ伝え忘れてた。"},
        { "location": "1626/TALK"    , "narrator": "千羽鶴", "text": "彼女たちと頑張って\n交流してくれてる\nあなたのために――"},
        { "location": "1627/TALK"    , "narrator": "千羽鶴", "text": "今日は彼女たちとの\nコミュツールを用意\nした。"},
        { "location": "1636/TALK"    , "narrator": "千羽鶴", "text": "彼女たちと頑張って\n交流してるみたいね。"},
        { "location": "1637/TALK"    , "narrator": "千羽鶴", "text": "親密度がちょっとずつ\n上がってきてるみたい。"},
        { "location": "1638/TALK"    , "narrator": "千羽鶴", "text": "そんな頑張り屋な貴方に\n今日は彼女とのコミュ\nツールを紹介する。"},
        { "location": "1639/TALK"    , "narrator": "千羽鶴", "text": "既に使ってるかも\nしれないけど、短いから\n聞いていって。"},
        { "location": "1644/TALK"    , "narrator": "千羽鶴", "text": "彼女を呼ぶと出てくる\nボタンは、彼女と貴方の\n交流アイテム。"},
        { "location": "1646/TALK"    , "narrator": "千羽鶴", "text": "「らぶとーく」、"},
        { "location": "1648/TALK"    , "narrator": "千羽鶴", "text": "「プレゼント」、"},
        { "location": "1650/TALK"    , "narrator": "千羽鶴", "text": "そして「着替え」。"},
        { "location": "1652/TALK"    , "narrator": "千羽鶴", "text": "「らぶとーく」では\n彼女との本音トークに\n話を咲かせる。"},
        { "location": "1653/TALK"    , "narrator": "千羽鶴", "text": "親密度が上がるほど\n深い話ができるように\nなる。"},
        { "location": "1654/TALK"    , "narrator": "千羽鶴", "text": "そして、恋人になったり\n結婚するための経験を\n積むのも、ここ。"},
        { "location": "1656/TALK"    , "narrator": "千羽鶴", "text": "「プレゼント」は彼女に\nデジタルコンテンツを\n送ることができる。"},
        { "location": "1657/TALK"    , "narrator": "千羽鶴", "text": "そこから様々な話題が\n広がって、新たなエピ\nソードを生むかも。"},
        { "location": "1658/TALK"    , "narrator": "千羽鶴", "text": "プレゼントアイテムは\n主にバトルでドロップ\nされる。"},
        { "location": "1660/TALK"    , "narrator": "千羽鶴", "text": "「着替え」はその名の\n通り、彼女に着替えて\nもらいたい時に使う。"},
        { "location": "1661/TALK"    , "narrator": "千羽鶴", "text": "昼の間はあなたが好きな\n服に着替えてくれる。"},
        { "location": "1662/TALK"    , "narrator": "千羽鶴", "text": "夜の着替えも彼女たち\nとの関係が進めば選べる\nようになるかも。"},
        { "location": "1664/TALK"    , "narrator": "千羽鶴", "text": "それから、ここから先に\nEXバトルっていう少し\n難しいバトルがある。"},
        { "location": "1665/TALK"    , "narrator": "千羽鶴", "text": "そこから生まれるエピソ\nードでは、あなたが選ん\nだ服を着てくれるの。"},
        { "location": "1666/TALK"    , "narrator": "千羽鶴", "text": "変わった服を選んで\n彼女たちを辱め――"},
        { "location": "1667/TALK"    , "narrator": "千羽鶴", "text": "もとい、愛でるのもいい\nかもしれないわね。"},
        { "location": "1671/TALK"    , "narrator": "千羽鶴", "text": "この中で、特に重要\nなのは「らぶとーく」。"},
        { "location": "1672/TALK"    , "narrator": "千羽鶴", "text": "「らぶとーく」は\n彼女と貴方の愛の軌跡に\nなる大事な交流。"},
        { "location": "1673/TALK"    , "narrator": "千羽鶴", "text": "ここでは彼女も、\n普段とは違う自分を\n貴方にぶつけてくる。"},
        { "location": "1674/TALK"    , "narrator": "千羽鶴", "text": "そう、表面トークでは\nない、本音トークに\nよって絆は創られる。"},
        { "location": "1675/TALK"    , "narrator": "千羽鶴", "text": "だから、「らぶとーく」\n無しでは、恋人同士には\nなることなど不可能！"},
        { "location": "1678/TALK"    , "narrator": "千羽鶴", "text": "どーん！"},
        { "location": "1679/TALK"    , "narrator": "千羽鶴", "text": "親密度が上がったら、\n是非「らぶとーく」を\n見に行ってみて欲しい。"},
        { "location": "1680/TALK"    , "narrator": "千羽鶴", "text": "そこに、貴方と彼女の\n未来があるのだから。"}
    ]
}
