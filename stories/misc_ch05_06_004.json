    "entry":
    [
        { "location": "763/SCENARIO", "narrator": "", "text": "鍵垢のつぶやきが全世界にダダ漏れだった件"},
        { "location": "788/TALK"    , "narrator": "神楽", "text": "怖いわー"},
        { "location": "789/TALK"    , "narrator": "神楽", "text": "電脳世界怖いわー"},
        { "location": "790/TALK"    , "narrator": "神楽", "text": "油断できないわー"},
        { "location": "792/SEL"     , "narrator": "", "text": "$me$が神楽を護る！"},
        { "location": "793/SEL"     , "narrator": "", "text": "ネット断ちするしか"},
        { "location": "794/SEL"     , "narrator": "", "text": "やらかしたの？"},
        { "location": "795/ACT"     , "narrator": "", "text": "$me$が神楽を護る！"},
        { "location": "797/TALK"    , "narrator": "神楽", "text": "やだ…やさしい…"},
        { "location": "799/TALK"    , "narrator": "神楽", "text": "イカしてる$handlek$"},
        { "location": "800/TALK"    , "narrator": "神楽", "text": "さすがぴょんこのダーリン"},
        { "location": "803/TALK"    , "narrator": "神楽", "text": "ウソだけど"},
        { "location": "804/ACT"     , "narrator": "", "text": "ネット断ちするしか"},
        { "location": "805/TALK"    , "narrator": "神楽", "text": "あーねー"},
        { "location": "806/TALK"    , "narrator": "神楽", "text": "意味ねーし"},
        { "location": "807/ACT"     , "narrator": "", "text": "やらかしたの？"},
        { "location": "808/TALK"    , "narrator": "神楽", "text": "ぴょんこじゃないから"},
        { "location": "810/TALK"    , "narrator": "神楽", "text": "反社会的なあれこれを全世界にオープンにしてたのを見つかって炎上"},
        { "location": "811/TALK"    , "narrator": "神楽", "text": "している垢を見つけただけですし"},
        { "location": "812/TALK"    , "narrator": "神楽", "text": "ぴょんこじゃないぴょん"},
        { "location": "814/SEL"     , "narrator": "", "text": "さらに燃料投下だ！"},
        { "location": "815/SEL"     , "narrator": "", "text": "定期的に出るねそういうの"},
        { "location": "816/SEL"     , "narrator": "", "text": "$handlek$との熱愛発覚かー"},
        { "location": "817/ACT"     , "narrator": "", "text": "さらに燃料投下だ！"},
        { "location": "818/TALK"    , "narrator": "神楽", "text": "怖いわ！"},
        { "location": "819/ACT"     , "narrator": "", "text": "定期的に出るねそういうの"},
        { "location": "820/TALK"    , "narrator": "神楽", "text": "あーまーねー"},
        { "location": "822/TALK"    , "narrator": "神楽", "text": "でもつい見に行っちゃう★"},
        { "location": "823/ACT"     , "narrator": "", "text": "$handlek$との熱愛発覚かー"},
        { "location": "825/TALK"    , "narrator": "神楽", "text": "反社会的な$handlek$との熱愛？"},
        { "location": "826/TALK"    , "narrator": "神楽", "text": "純白だった二人の羽はいつしか黒くなり折れてしまった"},
        { "location": "827/TALK"    , "narrator": "神楽", "text": "神に見放された二人は世界を壊すことを決めた"},
        { "location": "828/TALK"    , "narrator": "神楽", "text": "とかそういう"},
        { "location": "830/TALK"    , "narrator": "神楽", "text": "実際ね"},
        { "location": "831/TALK"    , "narrator": "神楽", "text": "人に言えない昏い衝動なんてみんな持ってるわけだし"},
        { "location": "832/TALK"    , "narrator": "神楽", "text": "もっと上手くやればいいのになーって目で見ちゃうわけ"},
        { "location": "834/SEL"     , "narrator": "", "text": "それって実体験？"},
        { "location": "835/SEL"     , "narrator": "", "text": "なかなか深い言葉だ"},
        { "location": "836/SEL"     , "narrator": "", "text": "$me$にはないかな…"},
        { "location": "837/ACT"     , "narrator": "", "text": "それって実体験？"},
        { "location": "839/TALK"    , "narrator": "神楽", "text": "さあね"},
        { "location": "840/ACT"     , "narrator": "", "text": "なかなか深い言葉だ"},
        { "location": "841/TALK"    , "narrator": "神楽", "text": "でしょでしょ"},
        { "location": "843/TALK"    , "narrator": "神楽", "text": "やったーぴょんこ褒められちゃったー♪"},
        { "location": "844/ACT"     , "narrator": "", "text": "$me$にはないかな…"},
        { "location": "845/TALK"    , "narrator": "神楽", "text": "あっそ"},
        { "location": "846/TALK"    , "narrator": "神楽", "text": "平和なのねー"}
    ]
