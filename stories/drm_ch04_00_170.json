    "entry":
    [
        { "location": "525/SCENARIO", "narrator": "", "text": "新案・ご近所ミステリ"},
        { "location": "534/TALK"    , "narrator": "みやび", "text": "一見普段通りの\n夕方ぞね。"},
        { "location": "535/TALK"    , "narrator": "みやび", "text": "さて、と。"},
        { "location": "547/TALK"    , "narrator": "みやび", "text": "そろそろアーヤがここを通りかかるのだ"},
        { "location": "548/TALK"    , "narrator": "みやび", "text": "その前にはっきりさせねばならぬことがある"},
        { "location": "549/TALK"    , "narrator": "みやび", "text": "当然協力してもらう"},
        { "location": "551/SEL"     , "narrator": "", "text": "条件によるね"},
        { "location": "552/SEL"     , "narrator": "", "text": "いや、こっちにも都合がある"},
        { "location": "553/ACT"     , "narrator": "", "text": "条件によるね"},
        { "location": "554/TALK"    , "narrator": "みやび", "text": "絶対に協力せざるを得ない条件である"},
        { "location": "555/ACT"     , "narrator": "", "text": "いや、こっちにも都合がある"},
        { "location": "556/TALK"    , "narrator": "みやび", "text": "その都合が都合なのだ"},
        { "location": "557/TALK"    , "narrator": "みやび", "text": "こちらの"},
        { "location": "559/TALK"    , "narrator": "みやび", "text": "アーヤに姉がいるのを"},
        { "location": "560/TALK"    , "narrator": "みやび", "text": "知っちょろう"},
        { "location": "562/SEL"     , "narrator": "", "text": "そうらしいけど"},
        { "location": "563/SEL"     , "narrator": "", "text": "詳しくは知らない"},
        { "location": "564/SEL"     , "narrator": "", "text": "初耳だ"},
        { "location": "565/ACT"     , "narrator": "", "text": "そうらしいけど"},
        { "location": "566/TALK"    , "narrator": "みやび", "text": "いるのだ"},
        { "location": "567/ACT"     , "narrator": "", "text": "詳しくは知らない"},
        { "location": "568/TALK"    , "narrator": "みやび", "text": "今はそれでいい"},
        { "location": "569/ACT"     , "narrator": "", "text": "初耳だ"},
        { "location": "570/TALK"    , "narrator": "みやび", "text": "これで知ることになったな"},
        { "location": "572/TALK"    , "narrator": "みやび", "text": "そんなわけで"},
        { "location": "573/TALK"    , "narrator": "みやび", "text": "アーヤの姉について調べるのが貴殿の任務"},
        { "location": "574/TALK"    , "narrator": "みやび", "text": "ただし、アーヤには聞くなよ"},
        { "location": "575/TALK"    , "narrator": "みやび", "text": "朗報を期待する"},
        { "location": "588/TALK"    , "narrator": "みやび", "text": "ふう……。"},
        { "location": "591/TALK"    , "narrator": "アーヤ", "text": "みやび？"},
        { "location": "594/TALK"    , "narrator": "みやび", "text": "お。\nちょうどいいところに。"},
        { "location": "595/TALK"    , "narrator": "アーヤ", "text": "ん？\nどうしたの？"},
        { "location": "596/TALK"    , "narrator": "みやび", "text": "今ちょっとした\n仕掛けをした\nところぞね。"},
        { "location": "597/TALK"    , "narrator": "アーヤ", "text": "仕掛けって？"},
        { "location": "598/TALK"    , "narrator": "みやび", "text": "Ｂｏｔの意図を\n探るための\n仕掛けぞね。"},
        { "location": "600/TALK"    , "narrator": "アーヤ", "text": "……。"},
        { "location": "602/TALK"    , "narrator": "みやび", "text": "うちにはやっぱり\n何の理由もないとは\n思えん。"},
        { "location": "604/TALK"    , "narrator": "みやび", "text": "トライナリーと\n接触しちゅうことには\n裏がある。"},
        { "location": "605/TALK"    , "narrator": "アーヤ", "text": "……ねえ\nみやび、あのね。"},
        { "location": "606/TALK"    , "narrator": "アーヤ", "text": "たまたまが\n重なっただけかも\nしれないでしょ。"},
        { "location": "608/TALK"    , "narrator": "みやび", "text": "偶然？"},
        { "location": "609/TALK"    , "narrator": "アーヤ", "text": "そう。"},
        { "location": "610/TALK"    , "narrator": "みやび", "text": "……そんなことは\nないと思うぞね。"},
        { "location": "622/TALK"    , "narrator": "みやび", "text": "アーヤが出た"},
        { "location": "623/TALK"    , "narrator": "みやび", "text": "先ほどの件の進捗はいかに"},
        { "location": "626/SEL"     , "narrator": "", "text": "調べないよ"},
        { "location": "629/ACT"     , "narrator": "", "text": "調べないよ"},
        { "location": "630/TALK"    , "narrator": "みやび", "text": "なんでだ"},
        { "location": "632/TALK"    , "narrator": "みやび", "text": "なぜ調査を進めぬ"},
        { "location": "633/SEL"     , "narrator": "", "text": "みやびが本人に聞く方が早いし"},
        { "location": "634/SEL"     , "narrator": "", "text": "こそこそ調べるのはいい趣味じゃないし"},
        { "location": "635/ACT"     , "narrator": "", "text": "みやびが本人に聞く方が早いし"},
        { "location": "636/TALK"    , "narrator": "みやび", "text": "それでは"},
        { "location": "637/TALK"    , "narrator": "みやび", "text": "情報に不備が出るのだ"},
        { "location": "638/ACT"     , "narrator": "", "text": "こそこそ調べるのはいい趣味じゃないし"},
        { "location": "639/TALK"    , "narrator": "みやび", "text": "なんと"},
        { "location": "641/TALK"    , "narrator": "みやび", "text": "常識的な発言"},
        { "location": "643/TALK"    , "narrator": "みやび", "text": "いいから"},
        { "location": "644/TALK"    , "narrator": "みやび", "text": "情報を渡すちや"},
        { "location": "646/SEL"     , "narrator": "", "text": "何も持ってないよ"},
        { "location": "647/SEL"     , "narrator": "", "text": "みやびの方が知ってるって"},
        { "location": "648/ACT"     , "narrator": "", "text": "何も持ってないよ"},
        { "location": "649/TALK"    , "narrator": "みやび", "text": "そんなわけなかろ"},
        { "location": "650/ACT"     , "narrator": "", "text": "みやびの方が知ってるって"},
        { "location": "651/TALK"    , "narrator": "みやび", "text": "またまた"},
        { "location": "664/TALK"    , "narrator": "みやび", "text": "あいかわらず\n見事なとぼけぶり。"},
        { "location": "665/TALK"    , "narrator": "みやび", "text": "油断ならん。"},
        { "location": "667/TALK"    , "narrator": "アーヤ", "text": "…そういうの\nみやびらしく\nないような。"},
        { "location": "669/TALK"    , "narrator": "みやび", "text": "うちらしくない？\nどういうことぞね。"},
        { "location": "670/TALK"    , "narrator": "アーヤ", "text": "なんだか\n思い込みだけで\n動いてるみたい。"},
        { "location": "671/TALK"    , "narrator": "アーヤ", "text": "人間なら\nスパイに違いないって\n決めつけてる感じ。"},
        { "location": "672/TALK"    , "narrator": "みやび", "text": "そういうアーヤは\nＢｏｔが人間だと\n納得しとらんろう。"},
        { "location": "673/TALK"    , "narrator": "みやび", "text": "そういう意味では\nアーヤも思い込み\nだけと言えるぞね。"},
        { "location": "676/TALK"    , "narrator": "アーヤ", "text": "…そうかも\nしれないわね……。"},
        { "location": "688/TALK"    , "narrator": "みやび", "text": "$handle$よ"},
        { "location": "690/SEL"     , "narrator": "", "text": "まだ何か？"},
        { "location": "691/SEL"     , "narrator": "", "text": "調べないったら"},
        { "location": "692/ACT"     , "narrator": "", "text": "まだ何か？"},
        { "location": "694/TALK"    , "narrator": "みやび", "text": "いや何も"},
        { "location": "695/ACT"     , "narrator": "", "text": "調べないったら"},
        { "location": "697/TALK"    , "narrator": "みやび", "text": "調べないんだな"},
        { "location": "709/TALK"    , "narrator": "みやび", "text": "……。"},
        { "location": "710/TALK"    , "narrator": "みやび", "text": "先入観だけで\n判断するのは\nうちらしゅうない。"},
        { "location": "711/TALK"    , "narrator": "みやび", "text": "仮説は必要や。"},
        { "location": "713/TALK"    , "narrator": "みやび", "text": "けんど、仮説は\nあくまで仮説\nでしかない。"},
        { "location": "714/TALK"    , "narrator": "みやび", "text": "と、いうことやね……。"}
    ]
}
