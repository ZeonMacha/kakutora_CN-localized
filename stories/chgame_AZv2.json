    "entry":
    [
        { "location": "1555/SCENARIO", "narrator": "", "text": "AZご褒美（普通に宝箱）"},
        { "location": "1560/TALK"    , "narrator": "千羽鶴", "text": "ここは、\n普通の宝箱が\n置いてあった場所。"},
        { "location": "1561/TALK"    , "narrator": "千羽鶴", "text": "RPGには宝箱が\nつきものだから。"},
        { "location": "1562/TALK"    , "narrator": "千羽鶴", "text": "それに、こういった\n奥まった場所には大抵\nイイモノが入ってる。"},
        { "location": "1563/TALK"    , "narrator": "千羽鶴", "text": "だからここには、\nココロキャンディを大量に\n詰め込んでおいた。"},
        { "location": "1564/TALK"    , "narrator": "千羽鶴", "text": "それはそうと。"},
        { "location": "1565/TALK"    , "narrator": "千羽鶴", "text": "実はこの宝箱には\n心理的なトラップを\n仕掛けておいたんだけど。"},
        { "location": "1566/SEL"     , "narrator": "", "text": "どんな仕掛け？"},
        { "location": "1567/SEL"     , "narrator": "", "text": "興味無い"},
        { "location": "1568/ACT"     , "narrator": "", "text": "どんな仕掛け？"},
        { "location": "1569/TALK"    , "narrator": "千羽鶴", "text": "RPGでは、宝箱の解放には\nミミックのリスクが\n伴うのは周知のこと。"},
        { "location": "1570/TALK"    , "narrator": "千羽鶴", "text": "そのドキドキ感は、\n実にゲーム的だと思う。"},
        { "location": "1571/TALK"    , "narrator": "千羽鶴", "text": "そしてそのスリル的な\n感覚は、人間の学習能力に\nよって享受される。"},
        { "location": "1572/TALK"    , "narrator": "千羽鶴", "text": "すなわち――"},
        { "location": "1573/TALK"    , "narrator": "千羽鶴", "text": "ミミックに一度も\n遭遇してなければ、\nなんの緊張もせず――"},
        { "location": "1574/TALK"    , "narrator": "千羽鶴", "text": "あっさり宝箱を\n開けてそれでお終い。"},
        { "location": "1575/TALK"    , "narrator": "千羽鶴", "text": "けれども、一度でも\nミミックを開けてしまうと\n次からは疑心暗鬼になる。"},
        { "location": "1576/TALK"    , "narrator": "千羽鶴", "text": "だから、このゲームの\nレベルデザインとして、\nまずミミックを置いた。"},
        { "location": "1577/TALK"    , "narrator": "千羽鶴", "text": "そして、その後に\nこの宝箱を配置した。"},
        { "location": "1578/SEL"     , "narrator": "", "text": "もしかしてミミックって、ガブ……"},
        { "location": "1579/ACT"     , "narrator": "", "text": "もしかしてミミックって、ガブ……"},
        { "location": "1581/TALK"    , "narrator": "千羽鶴", "text": "そう。\nガブリエラ。"},
        { "location": "1582/SEL"     , "narrator": "", "text": "ちっちゃ可愛いやつだ！"},
        { "location": "1583/ACT"     , "narrator": "", "text": "ちっちゃ可愛いやつだ！"},
        { "location": "1585/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1586/TALK"    , "narrator": "千羽鶴", "text": "…って、あれ？\n警戒してない？"},
        { "location": "1587/TALK"    , "narrator": "千羽鶴", "text": "失敗だったか。"},
        { "location": "1589/ACT"     , "narrator": "", "text": "興味無い"}
    ]
}
