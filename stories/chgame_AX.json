        { "location": "356/SCENARIO", "narrator": "", "text": "AX強い敵（死ぬ） アーヤ"},
        { "location": "381/TALK"    , "narrator": "アーヤ", "text": "やっと来たわね！\n待ってたわよ！！"},
        { "location": "382/TALK"    , "narrator": "千羽鶴", "text": "いけない！\nこの子は\nイカズゴケアーヤ！"},
        { "location": "383/TALK"    , "narrator": "千羽鶴", "text": "婚期を逃すことを\n恐れるあまり、最強の\n敵になってしまった。"},
        { "location": "384/TALK"    , "narrator": "アーヤ", "text": "何をごちゃごちゃ\n言ってるの？"},
        { "location": "385/TALK"    , "narrator": "アーヤ", "text": "ここで会ったが\n１００年目。貴方から\n$handle$を奪う！"},
        { "location": "386/TALK"    , "narrator": "アーヤ", "text": "そして、\n華々しく早婚を\nするんだから！"},
        { "location": "387/TALK"    , "narrator": "千羽鶴", "text": "そんなことしなくても、\n$handle$は\n貴方の物よ、どーどー。"},
        { "location": "388/SEL"     , "narrator": "", "text": "貴方の「もの」って…"},
        { "location": "389/SEL"     , "narrator": "", "text": "どーどーって…"},
        { "location": "390/ACT"     , "narrator": "", "text": "貴方の「もの」って…"},
        { "location": "391/ACT"     , "narrator": "", "text": "どーどーって…"},
        { "location": "395/TALK"    , "narrator": "千羽鶴", "text": "大丈夫よ、落ち着いて。\n今ならこの子を倒せるわ。"},
        { "location": "396/TALK"    , "narrator": "千羽鶴", "text": "さっき見つけた\n【早婚の杖】を\n使えば…！！"},
        { "location": "400/TALK"    , "narrator": "千羽鶴", "text": "えーいっ！"},
        { "location": "405/TALK"    , "narrator": "アーヤ", "text": "きゃああっ！！"},
        { "location": "406/TALK"    , "narrator": "アーヤ", "text": "やられたぁぁ。"},
        { "location": "418/TALK"    , "narrator": "千羽鶴", "text": "杖のお陰で\n何とか倒せた。"},
        { "location": "419/TALK"    , "narrator": "千羽鶴", "text": "先へ進みましょ。"},
        { "location": "432/TALK"    , "narrator": "千羽鶴", "text": "いけない。\nこの子は強い。"},
        { "location": "434/TALK"    , "narrator": "千羽鶴", "text": "今の私たちでは\nとても太刀打ちできない。"},
        { "location": "436/TALK"    , "narrator": "千羽鶴", "text": "私は\n非攻略対象！"},
        { "location": "443/TALK"    , "narrator": "アーヤ", "text": "はああっ！！"},
        { "location": "363/DIALOG"  , "narrator": "NOTICE", "text": "敵が現れた！！"},
        { "location": "398/DIALOG"  , "narrator": "INFO", "text": "千羽鶴は\n【早婚の杖】を\nつかった！"},
        { "location": "435/DIALOG"  , "narrator": "INFO", "text": "千羽鶴のこうげき！"},
        { "location": "441/DIALOG"  , "narrator": "INFO", "text": "イカズゴケアーヤに\n１ポイントのダメージ"},
        { "location": "442/DIALOG"  , "narrator": "INFO", "text": "イカズゴケアーヤの\nこうげき！"},
        { "location": "449/DIALOG"  , "narrator": "INFO", "text": "千羽鶴は\n10000ポイントのダメージ"},
        { "location": "450/DIALOG"  , "narrator": "INFO", "text": "千羽鶴は\n死んでしまった。"}
    ]
}
