        { "location": "2205/TALK"  , "narrator": "エリカ", "text": "承知致しました"},
        { "location": "2206/TALK"  , "narrator": "エリカ", "text": "では、もしまたお願い出来るようであれば、こちらにいらしてください"},
        { "location": "2207/TALK"  , "narrator": "エリカ", "text": "お話聞いて下さり、ありがとうございました！"},
        { "location": "2212/SEL"   , "narrator": "", "text": "…どうする？"},
        { "location": "2213/ACT"   , "narrator": "", "text": "…どうする？"},
        { "location": "2215/TALK"  , "narrator": "つばめ", "text": "あ、ここで待ってますよ？\n気にしないで――"},
        { "location": "2220/TALK"  , "narrator": "つばめ", "text": "あ、エリカさんからです。"},
        { "location": "2222/TALK"  , "narrator": "つばめ", "text": "エリカさんが、\n転送してくれるそうです！"},
        { "location": "2223/SEL"   , "narrator": "", "text": "それはよかった"},
        { "location": "2224/ACT"   , "narrator": "", "text": "それはよかった"},
        { "location": "2226/TALK"  , "narrator": "つばめ", "text": "はい！"},
        { "location": "2227/TALK"  , "narrator": "つばめ", "text": "$handle$さん、\n色々ありがとう\nございました！"},
        { "location": "2228/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんのこと、\nどうかよろしく\nお願いします！！"},
        { "location": "2274/TALK"  , "narrator": "ぴょんこ", "text": "やめてください！\n何処かへ行ってください！\nキモイですし！"},
        { "location": "2275/TALK"  , "narrator": "神楽の新司書　", "text": "そんな怖がらなくても\n大丈夫ですよっ♪"},
        { "location": "2276/TALK"  , "narrator": "神楽の新司書　", "text": "別に何か痛いことを\nするわけでも\nありませんし。"},
        { "location": "2277/TALK"  , "narrator": "神楽の新司書　", "text": "ただ、私と一緒に\n0x111までお散歩する\nだけですから！"},
        { "location": "2278/TALK"  , "narrator": "ぴょんこ", "text": "誰が\nあんなところへなんて、\n戻るもんですか！"},
        { "location": "2279/SEL"   , "narrator": "", "text": "ぴょんこ！！"},
        { "location": "2280/ACT"   , "narrator": "", "text": "ぴょんこ！！"},
        { "location": "2285/TALK"  , "narrator": "ぴょんこ", "text": "え？"},
        { "location": "2290/TALK"  , "narrator": "ぴょんこ", "text": "<size=50>$handle$さんっ！</size>"},
        { "location": "2292/SEL"   , "narrator": "", "text": "ちょっ！はみ出てるはみ出てる！！"},
        { "location": "2293/ACT"   , "narrator": "", "text": "ちょっ！はみ出てるはみ出てる！！"},
        { "location": "2297/TALK"  , "narrator": "ぴょんこ", "text": "<size=120>助けに来てくれたんですねっ！！</size>"},
        { "location": "2299/SEL"   , "narrator": "", "text": "ごめん！ちょっと読めないから！"},
        { "location": "2300/ACT"   , "narrator": "", "text": "ごめん！ちょっと読めないから！"},
        { "location": "2304/TALK"  , "narrator": "ぴょんこ", "text": "<color=red><size=200>すきすきすきすきすき♪</size></color>"},
        { "location": "2305/SEL"   , "narrator": "", "text": "落ち着いて！あと、小さくして小さく！"},
        { "location": "2306/ACT"   , "narrator": "", "text": "落ち着いて！あと、小さくして小さく！"},
        { "location": "2308/TALK"  , "narrator": "ぴょんこ", "text": "ああっ！\nごめんなさい。"},
        { "location": "2309/TALK"  , "narrator": "ぴょんこ", "text": "あまりに\n想いが募っちゃって、\nつい……。"},
        { "location": "2310/SEL"   , "narrator": "", "text": "無事で良かった"},
        { "location": "2311/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2312/ACT"   , "narrator": "", "text": "無事で良かった"},
        { "location": "2313/TALK"  , "narrator": "ぴょんこ", "text": "はいっ！"},
        { "location": "2314/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんと\nまた逢いたくて、\n何とか生き延びましたっ！"},
        { "location": "2315/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2319/TALK"  , "narrator": "ぴょんこ", "text": "拉致監禁後の\n初ぴょんこｽｷ\nいただきました～♪"},
        { "location": "2321/SEL"   , "narrator": "", "text": "一体何がどうなってるの？"},
        { "location": "2322/ACT"   , "narrator": "", "text": "一体何がどうなってるの？"},
        { "location": "2325/TALK"  , "narrator": "神楽の新司書　", "text": "あなたが\n$handle$さん\nですか？"},
        { "location": "2326/SEL"   , "narrator": "", "text": "誰？"},
        { "location": "2327/SEL"   , "narrator": "", "text": "コイツ、悪いヤツ？"},
        { "location": "2328/ACT"   , "narrator": "", "text": "誰？"},
        { "location": "2329/ACT"   , "narrator": "", "text": "コイツ、悪いヤツ？"},
        { "location": "2330/TALK"  , "narrator": "ぴょんこ", "text": "そうなのだぴょん！！"},
        { "location": "2332/TALK"  , "narrator": "神楽の新司書　", "text": "失礼なこと\nいわないでください！"},
        { "location": "2335/TALK"  , "narrator": "神楽の新司書　", "text": "同化準備班ですよっ。"},
        { "location": "2336/TALK"  , "narrator": "神楽の新司書　", "text": "ココロの秩序の為に\n清く正しく働く、\nココロ公務員です！"},
        { "location": "2337/TALK"  , "narrator": "神楽の新司書　", "text": "同化が完了したら、\n以後、ココロの司書に\nなる予定ですので！"},
        { "location": "2338/TALK"  , "narrator": "神楽の新司書　", "text": "チャッキチャキの\n純粋培養0x出身です！\nよろしくお願いします♪"},
        { "location": "2339/SEL"   , "narrator": "", "text": "よろしく"},
        { "location": "2340/SEL"   , "narrator": "", "text": "ぴょんこに危害を加えるな！"},
