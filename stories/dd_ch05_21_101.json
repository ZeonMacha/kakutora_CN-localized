{
    "dir": "chap21/daydra/dd_ch05_21_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "21502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "嘘つきは何が始まる？＜前編＞"
    },
    "entry":
    [
        { "location": "1688/TALK"  , "narrator": "みやび", "text": "うーん……。"},
        { "location": "1689/TALK"  , "narrator": "ガブリエラ", "text": "どうかしたの？"},
        { "location": "1690/TALK"  , "narrator": "みやび", "text": "なんとも平和な\n昼下がり。"},
        { "location": "1692/TALK"  , "narrator": "つばめ", "text": "まったりって\nいいですよね。"},
        { "location": "1693/TALK"  , "narrator": "みやび", "text": "つばめちゃんは\nそう思うかね。"},
        { "location": "1694/TALK"  , "narrator": "つばめ", "text": "えっ…。\nみやびさんは違うん\nですか？"},
        { "location": "1695/TALK"  , "narrator": "みやび", "text": "まったりすなわち\n刺激が足りんと\nいうことぞね。"},
        { "location": "1696/TALK"  , "narrator": "みやび", "text": "そうは思わん？"},
        { "location": "1697/TALK"  , "narrator": "神楽", "text": "まあそれは\nそうでしょうけど…。"},
        { "location": "1698/TALK"  , "narrator": "ガブリエラ", "text": "刺激ねえ。"},
        { "location": "1699/TALK"  , "narrator": "つばめ", "text": "何か楽しい\nことですよね…。"},
        { "location": "1721/TALK"  , "narrator": "神楽", "text": "待って！！"},
        { "location": "1724/TALK"  , "narrator": "神楽", "text": "はぁ、はぁ…。"},
        { "location": "1729/TALK"  , "narrator": "千羽鶴", "text": "…なにかしら。\nまだなにかあるの？"},
        { "location": "1731/TALK"  , "narrator": "神楽", "text": "…もう一度、\n確認させてください。"},
        { "location": "1733/TALK"  , "narrator": "神楽", "text": "本当に母のことを、\n治すことが\nできるんですか？"},
        { "location": "1735/TALK"  , "narrator": "千羽鶴", "text": "ええ、もちろん。"},
        { "location": "1736/TALK"  , "narrator": "神楽", "text": "五体満足で？"},
        { "location": "1737/TALK"  , "narrator": "千羽鶴", "text": "…疑い深いのね。\n当然、五体満足の\n状態で戻すわ。"},
        { "location": "1738/TALK"  , "narrator": "神楽", "text": "…それなら、\n音羽のことも\n一緒に治せませんか？"},
        { "location": "1739/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1740/TALK"  , "narrator": "千羽鶴", "text": "治せないことはない。"},
        { "location": "1741/TALK"  , "narrator": "千羽鶴", "text": "けど、\n契約外のことだから、\n確証は持てない。"},
        { "location": "1742/TALK"  , "narrator": "神楽", "text": "…構いません。"},
        { "location": "1744/TALK"  , "narrator": "千羽鶴", "text": "そう…、わかった。"},
        { "location": "1745/TALK"  , "narrator": "千羽鶴", "text": "いずれにしても、\n全ては逢瀬つばめを\n壊してから。"},
        { "location": "1746/TALK"  , "narrator": "千羽鶴", "text": "忘れないで。\n貴方の役目を…。"},
        { "location": "1751/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1752/TALK"  , "narrator": "神楽", "text": "わかってたことよ。\nこれは、契約だもの。"},
        { "location": "1753/TALK"  , "narrator": "神楽", "text": "私は、つばめさんを\n壊さなくちゃ\nならないし…。"},
        { "location": "1754/TALK"  , "narrator": "神楽", "text": "その役目から\n逃げることも、\nできない。"},
        { "location": "1755/TALK"  , "narrator": "神楽", "text": "…でも。"},
        { "location": "1757/TALK"  , "narrator": "神楽", "text": "本当に、できるの？"},
        { "location": "1759/TALK"  , "narrator": "神楽", "text": "私に、つばめさんを\n壊すなんて…。"},
        { "location": "1770/TALK"  , "narrator": "千羽鶴", "text": "私は――"},
        { "location": "1771/SEL"   , "narrator": "", "text": "本当のことを言った方がいいよ"},
        { "location": "1772/SEL"   , "narrator": "", "text": "（※何も言わない）"},
        { "location": "1773/ACT"   , "narrator": "", "text": "本当のことを言った方がいいよ"},
        { "location": "1780/ACT"   , "narrator": "", "text": "（※何も言わない）"},
        { "location": "1787/TALK"  , "narrator": "千羽鶴", "text": "私は、皇千羽鶴。\n逢瀬つばめではない。"},
        { "location": "1788/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1789/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "1790/TALK"  , "narrator": "神楽", "text": "…わかりました。\n変なことを聞いて\nすみません。"},
        { "location": "1791/TALK"  , "narrator": "千羽鶴", "text": "わかってくれたなら\nそれでいい。"},
        { "location": "1792/TALK"  , "narrator": "神楽", "text": "はい…、\nよくわかりました。"},
        { "location": "1794/TALK"  , "narrator": "神楽", "text": "あなたがウソつきだ\nっていうコトがね…。"},
        { "location": "1803/TALK"  , "narrator": "千羽鶴", "text": "…ごめんなさい。\n誰かから連絡みたい。"},
        { "location": "1808/TALK"  , "narrator": "プレイヤー", "text": "本当のことを言った方がいいよ"},
        { "location": "1811/TALK"  , "narrator": "千羽鶴", "text": "何故？"},
        { "location": "1813/SEL"   , "narrator": "", "text": "ウソがバレると契約違反だよ？"},
        { "location": "1814/ACT"   , "narrator": "", "text": "ウソがバレると契約違反だよ？"},
        { "location": "1823/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "1824/TALK"  , "narrator": "千羽鶴", "text": "何故私のWAVEを…？"},
        { "location": "1825/TALK"  , "narrator": "神楽", "text": "…どうかしたん\nですか？"},
        { "location": "1827/TALK"  , "narrator": "千羽鶴", "text": "…なんでもないわ。\nそれより、あなたの\n質問の答えだけど――"},
        { "location": "1828/TALK"  , "narrator": "千羽鶴", "text": "私は、皇千羽鶴。"},
        { "location": "1829/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめの、\nセルフクラン。"},
        { "location": "1830/TALK"  , "narrator": "神楽", "text": "…そう、ですか。\nなるほど。"},
        { "location": "1831/TALK"  , "narrator": "神楽", "text": "それじゃあ…、\nつまり、音羽のことを\n壊したのは…。"},
        { "location": "1832/TALK"  , "narrator": "千羽鶴", "text": "そう、私がやった。"},
        { "location": "1833/TALK"  , "narrator": "神楽", "text": "なんで！？\nどうしてあんなこと\nしたの！？"},
        { "location": "1834/TALK"  , "narrator": "千羽鶴", "text": "それしか方法が\nなかったから。"},
        { "location": "1835/TALK"  , "narrator": "神楽", "text": "それじゃわからない！\nちゃんと説明して！"},
        { "location": "1836/TALK"  , "narrator": "千羽鶴", "text": "…貴方がそれを\n望むなら、こちらには\n話す準備があるけど。"},
        { "location": "1837/TALK"  , "narrator": "千羽鶴", "text": "私が話せば話すほど、\n貴方の心が\nかき乱されるだけ。"},
        { "location": "1838/TALK"  , "narrator": "千羽鶴", "text": "きっと、\nなんの解決にも\nならない。"},
        { "location": "1839/TALK"  , "narrator": "千羽鶴", "text": "なぜなら、私がウソを\nつかない以上――"},
        { "location": "1840/TALK"  , "narrator": "千羽鶴", "text": "貴方は約束を\n履行しなければ\nならないから。"},
        { "location": "1841/TALK"  , "narrator": "千羽鶴", "text": "そうしなければ、\n貴方が一方的に\n不利になるだけ。"},
        { "location": "1842/TALK"  , "narrator": "千羽鶴", "text": "そういう\n契約でしかない。"},
        { "location": "1844/TALK"  , "narrator": "千羽鶴", "text": "貴方は、私に対して\n反抗するつもりだった\nのかもしれないけど。"},
        { "location": "1845/TALK"  , "narrator": "千羽鶴", "text": "私は貴方の友達でも\nなんでもない。"},
        { "location": "1846/TALK"  , "narrator": "千羽鶴", "text": "貴方が私を恨もうが\nどうしようが、\n私は構わない。"},
        { "location": "1847/TALK"  , "narrator": "千羽鶴", "text": "契約さえ履行して\nもらえれば。"},
        { "location": "1848/TALK"  , "narrator": "千羽鶴", "text": "…でも、もし私を\n殺したり、危害を\n加えたりしたら――"},
        { "location": "1849/TALK"  , "narrator": "千羽鶴", "text": "母親を戻すことも、\n彼らの束縛から逃げる\nこともできなくなる。"},
        { "location": "1851/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1852/TALK"  , "narrator": "千羽鶴", "text": "…貴方は、\nいずこから真実を\n知った。"},
        { "location": "1853/TALK"  , "narrator": "千羽鶴", "text": "そして、それを武器に\n私を殴るつもり\nだったのだろうけど。"},
        { "location": "1854/TALK"  , "narrator": "千羽鶴", "text": "それは、私にとって\n痛くも痒くもない。"},
        { "location": "1855/TALK"  , "narrator": "千羽鶴", "text": "むしろ、貴方にとって\n大きなダメージを\n与える結果となった。"},
        { "location": "1856/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1857/TALK"  , "narrator": "千羽鶴", "text": "…準備が整った\nからには――"},
        { "location": "1858/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめの破壊を、\n早く実行してほしい\nという希望がある。"},
        { "location": "1859/TALK"  , "narrator": "千羽鶴", "text": "これは、貴方の望みと\n合致すると思っていた\nから。"},
        { "location": "1860/TALK"  , "narrator": "千羽鶴", "text": "敢えて\n言わなかっただけ。"},
        { "location": "1861/TALK"  , "narrator": "千羽鶴", "text": "でも、そうでないなら\n貴方に契約履行意思が\nないと判断する。"},
        { "location": "1862/TALK"  , "narrator": "千羽鶴", "text": "…履行意思があるなら\nこの合宿中に\n動いてほしい"},
        { "location": "1864/TALK"  , "narrator": "神楽", "text": "…私に、その意思が\nないとしたら？"},
        { "location": "1865/TALK"  , "narrator": "千羽鶴", "text": "当然、私の方で\n介入することになる\nかもしれない。"},
        { "location": "1866/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1867/TALK"  , "narrator": "千羽鶴", "text": "…話は以上。\n健闘を祈ってる。"},
        { "location": "1872/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1873/TALK"  , "narrator": "神楽", "text": "音羽を破壊したのは、\nつばめさんじゃない。"},
        { "location": "1874/TALK"  , "narrator": "神楽", "text": "それはわかったけど、\nでも…。"},
        { "location": "1888/TALK"  , "narrator": "神楽", "text": "教えてください"},
        { "location": "1889/TALK"  , "narrator": "神楽", "text": "どういうつもりで"},
        { "location": "1890/TALK"  , "narrator": "神楽", "text": "私に話したんですか？"},
        { "location": "1891/TALK"  , "narrator": "神楽", "text": "皇千羽鶴が"},
        { "location": "1892/TALK"  , "narrator": "神楽", "text": "つばめさんのセルフクランだということを"},
        { "location": "1894/SEL"   , "narrator": "", "text": "真実を知ってほしかったから"},
        { "location": "1895/SEL"   , "narrator": "", "text": "千羽鶴に対する交渉材料になると思って…"},
        { "location": "1896/ACT"   , "narrator": "", "text": "真実を知ってほしかったから"},
        { "location": "1897/TALK"  , "narrator": "神楽", "text": "知ってどうなると？"},
        { "location": "1898/TALK"  , "narrator": "神楽", "text": "知ったところで"},
        { "location": "1899/TALK"  , "narrator": "神楽", "text": "私がやることに変わりはないのに"},
        { "location": "1900/TALK"  , "narrator": "神楽", "text": "余計苦しくなっただけじゃないですか"},
        { "location": "1901/ACT"   , "narrator": "", "text": "千羽鶴に対する交渉材料になると思って…"},
        { "location": "1905/TALK"  , "narrator": "神楽", "text": "呆れました"},
        { "location": "1906/TALK"  , "narrator": "神楽", "text": "$handlek$は"},
        { "location": "1907/TALK"  , "narrator": "神楽", "text": "契約というものの神髄を知らないんですね"},
        { "location": "1908/TALK"  , "narrator": "神楽", "text": "感情や善悪論なんてものは"},
        { "location": "1909/TALK"  , "narrator": "神楽", "text": "契約の前には無意味なんですよ？"},
        { "location": "1910/TALK"  , "narrator": "神楽", "text": "そんなことも知らないで余計なことを、、、"},
        { "location": "1913/TALK"  , "narrator": "神楽", "text": "不毛です"},
        { "location": "1914/TALK"  , "narrator": "神楽", "text": "もういいです"},
        { "location": "1926/TALK"  , "narrator": "神楽", "text": "……いや、これは\n$handlek$の\nせいじゃない。"},
        { "location": "1927/TALK"  , "narrator": "神楽", "text": "情報をダシに\n千羽鶴の弱みを握ろうと\nしたのは私だもの。"},
        { "location": "1928/TALK"  , "narrator": "神楽", "text": "でも、　\n皇千羽鶴の正体が――"},
        { "location": "1929/TALK"  , "narrator": "神楽", "text": "つばめさんの\nセルフクラン\nだったなんて…。"},
        { "location": "1930/TALK"  , "narrator": "神楽", "text": "…どうしよう。\n私は、どうすれば\nいいの？"},
        { "location": "1932/TALK"  , "narrator": "神楽", "text": "これから、いったい\nどうすれば…。"},
        { "location": "1989/TALK"  , "narrator": "ぴょんこ", "text": "　"},
        { "location": "2023/TALK"  , "narrator": "つばめ", "text": "$handle$さん！？"},
        { "location": "2024/TALK"  , "narrator": "つばめ", "text": "よかったぁ～！"},
        { "location": "2025/SEL"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "2026/ACT"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "2028/TALK"  , "narrator": "つばめ", "text": "実はちょっと\n迷っちゃって……\nあはは……"},
        { "location": "2029/SEL"   , "narrator": "", "text": "じゃあ、用事が済んだら送っていこうか？"},
        { "location": "2030/SEL"   , "narrator": "", "text": "本当につばめ？"},
        { "location": "2031/ACT"   , "narrator": "", "text": "じゃあ、用事が済んだら送っていこうか？"},
        { "location": "2033/TALK"  , "narrator": "つばめ", "text": "本当ですか！\nありがとうございます！"},
        { "location": "2034/ACT"   , "narrator": "", "text": "本当につばめ？"},
        { "location": "2035/TALK"  , "narrator": "つばめ", "text": "ええええっ！\n本物だよぅ！！"},
        { "location": "2036/SEL"   , "narrator": "", "text": "本当のつばめなら、啓介さんのことはパパと呼んでいる筈だ！"},
        { "location": "2037/SEL"   , "narrator": "", "text": "本当のつばめなら、胸くらい触らせてくれる筈だ！"},
        { "location": "2038/ACT"   , "narrator": "", "text": "本当のつばめなら、啓介さんのことはパパと呼んでいる筈だ！"},
        { "location": "2039/TALK"  , "narrator": "つばめ", "text": "呼びません！"},
        { "location": "2040/SEL"   , "narrator": "", "text": "じゃあ何て？"},
        { "location": "2041/ACT"   , "narrator": "", "text": "じゃあ何て？"},
        { "location": "2044/TALK"  , "narrator": "つばめ", "text": "……お父さん。"},
        { "location": "2045/SEL"   , "narrator": "", "text": "ううむ、白だな"},
        { "location": "2046/ACT"   , "narrator": "", "text": "ううむ、白だな"},
        { "location": "2049/ACT"   , "narrator": "", "text": "本当のつばめなら、胸くらい触らせてくれる筈だ！"},
        { "location": "2050/TALK"  , "narrator": "つばめ", "text": "触らせませんから。"},
        { "location": "2051/SEL"   , "narrator": "", "text": "最初はダメでも、土下座して頼み込めば触らせてくれる筈だ！！"},
        { "location": "2052/ACT"   , "narrator": "", "text": "最初はダメでも、土下座して頼み込めば触らせてくれる筈だ！！"},
        { "location": "2054/TALK"  , "narrator": "つばめ", "text": "無理です。\n意味が分かりません。"},
        { "location": "2055/SEL"   , "narrator": "", "text": "残念ながらっ……本物だっ……ガクッ"},
        { "location": "2056/ACT"   , "narrator": "", "text": "残念ながらっ……本物だっ……ガクッ"},
        { "location": "2059/TALK"  , "narrator": "つばめ", "text": "当たり前だよ！"},
        { "location": "2060/TALK"  , "narrator": "つばめ", "text": "もー、こっちは\n本当に困ってるのにー。"},
        { "location": "2061/SEL"   , "narrator": "", "text": "じゃあ、用事が済んだら送っていこうか？"},
        { "location": "2062/ACT"   , "narrator": "", "text": "じゃあ、用事が済んだら送っていこうか？"},
        { "location": "2067/SEL"   , "narrator": "", "text": "ところで、この辺りに誰かいなかった？神楽以外で"},
        { "location": "2068/ACT"   , "narrator": "", "text": "ところで、この辺りに誰かいなかった？神楽以外で"},
        { "location": "2070/TALK"  , "narrator": "つばめ", "text": "え？\n神楽ちゃん以外ですか？"},
        { "location": "2071/TALK"  , "narrator": "つばめ", "text": "うーん、\n誰も会ってないかなぁ。"},
        { "location": "2072/SEL"   , "narrator": "", "text": "ぴょんこがいなくなった原因がここにあって"},
        { "location": "2073/SEL"   , "narrator": "", "text": "寝ぼけてたんじゃなくて？"},
        { "location": "2074/ACT"   , "narrator": "", "text": "ぴょんこがいなくなった原因がここにあって"},
        { "location": "2075/TALK"  , "narrator": "つばめ", "text": "ええっ！\nぴょんこちゃんが？"},
        { "location": "2076/SEL"   , "narrator": "", "text": "知ってるの！？"},
        { "location": "2077/ACT"   , "narrator": "", "text": "知ってるの！？"},
        { "location": "2079/TALK"  , "narrator": "つばめ", "text": "知ってるも何も、\n何度も助けに\n来てますよね？"},
        { "location": "2080/SEL"   , "narrator": "", "text": "あれ？未来のつばめだったの？でも服装が…"},
        { "location": "2081/ACT"   , "narrator": "", "text": "あれ？未来のつばめだったの？でも服装が…"},
        { "location": "2083/TALK"  , "narrator": "つばめ", "text": "そうなんですよ、\nなんかいつの間にか\n普段着に――"},
        { "location": "2084/ACT"   , "narrator": "", "text": "寝ぼけてたんじゃなくて？"},
        { "location": "2085/TALK"  , "narrator": "つばめ", "text": "寝ぼけてなんて\nいませんから！"},
        { "location": "2087/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "2088/TALK"  , "narrator": "つばめ", "text": "いえ。"},
        { "location": "2090/TALK"  , "narrator": "つばめ", "text": "自信はないです！"},
        { "location": "2096/TALK"  , "narrator": "エリカ", "text": "$handle$さん"},
        { "location": "2098/TALK"  , "narrator": "エリカ", "text": "ぴょんこさんがいるアドレスが見つかりました"},
        { "location": "2099/SEL"   , "narrator": "", "text": "ほんと！？"},
        { "location": "2100/SEL"   , "narrator": "", "text": "なんか盛り上がらねえ"},
        { "location": "2101/ACT"   , "narrator": "", "text": "ほんと！？"},
        { "location": "2102/TALK"  , "narrator": "エリカ", "text": "はい"},
        { "location": "2103/ACT"   , "narrator": "", "text": "なんか盛り上がらねえ"},
        { "location": "2104/TALK"  , "narrator": "エリカ", "text": "すみません……"},
        { "location": "2106/TALK"  , "narrator": "エリカ", "text": "アドレスが変わっていて、これだと確かに、みやびさんの仕掛けた検索では引っかからないと思います"},
        { "location": "2107/TALK"  , "narrator": "エリカ", "text": "アドレスは、1x100"},
        { "location": "2108/SEL"   , "narrator": "", "text": "えっ？１ｘ？"},
        { "location": "2109/ACT"   , "narrator": "", "text": "えっ？１ｘ？"},
        { "location": "2111/TALK"  , "narrator": "エリカ", "text": "そうです、1xです"},
        { "location": "2112/TALK"  , "narrator": "エリカ", "text": "すなわち、Rediness拡張意識野です"},
        { "location": "2113/SEL"   , "narrator": "", "text": "千羽鶴が利用してたとこだっけ"},
        { "location": "2114/SEL"   , "narrator": "", "text": "新しい司書のアドレスだったやつだ"},
        { "location": "2115/ACT"   , "narrator": "", "text": "千羽鶴が利用してたとこだっけ"},
        { "location": "2116/ACT"   , "narrator": "", "text": "新しい司書のアドレスだったやつだ"},
        { "location": "2118/TALK"  , "narrator": "エリカ", "text": "そうですね。厳密には、Redinessから直接アクセス出来る、脳の拡張部分のアドレスです"},
        { "location": "2119/TALK"  , "narrator": "エリカ", "text": "トライナリーとして活躍できたり、フェノメノンの発生原因にもなっている、人工的に拡張されて作られた、脳の意識野です"},
        { "location": "2120/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "2121/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "2123/TALK"  , "narrator": "エリカ", "text": "Redinessは松果体を経由して脳と量子サーバーを接続し、Redinessユーザーに対して外部記憶装置、および外部演算装置を提供します"},
        { "location": "2124/TALK"  , "narrator": "エリカ", "text": "そのことを1xと言います"},
        { "location": "2125/TALK"  , "narrator": "エリカ", "text": "ちょっと難しい事を言ってるように聞こえるかもしれませんが、PCに例えると簡単になりますよ"},
        { "location": "2126/TALK"  , "narrator": "エリカ", "text": "普段貴方も使ってるかもしれませんが、ネット上で表計算したり、ネット上にストレージを持ったりしませんか？"},
        { "location": "2127/TALK"  , "narrator": "エリカ", "text": "それと同じ事をやってるに過ぎません"},
        { "location": "2128/TALK"  , "narrator": "エリカ", "text": "脳の海馬や前頭葉の補佐的役割を担い、拡張してるんです"},
        { "location": "2129/SEL"   , "narrator": "", "text": "１ｘってそういうものだったのか"},
        { "location": "2130/SEL"   , "narrator": "", "text": "あれあれあれあれ、それと似たようなアプリを知ってるぞ"},
        { "location": "2131/ACT"   , "narrator": "", "text": "１ｘってそういうものだったのか"},
        { "location": "2132/TALK"  , "narrator": "エリカ", "text": "そうです"},
        { "location": "2133/TALK"  , "narrator": "エリカ", "text": "だから、量子サーバーにプログラムを入れて、Rediness経由でアクセスすれば、例えば貴方は今から暗算王になることも出来ますし、プログラム次第では超能力者にだってなれてしまうんです、理論上は"},
        { "location": "2134/TALK"  , "narrator": "エリカ", "text": "もちろん、現在ではソフト面が全く追いついていないので、せいぜい記憶の拡張をする程度が関の山ですが…"},
        { "location": "2135/TALK"  , "narrator": "エリカ", "text": "この件は、あまりに強烈な可能性を秘めてるので、私を含むコアの開発者にしかその可能性を公開していません"},
        { "location": "2136/TALK"  , "narrator": "エリカ", "text": "ですから、これは秘密です"},
        { "location": "2137/ACT"   , "narrator": "", "text": "あれあれあれあれ、それと似たようなアプリを知ってるぞ"},
        { "location": "2138/TALK"  , "narrator": "エリカ", "text": "えっと、もしかして"},
        { "location": "2139/TALK"  , "narrator": "エリカ", "text": "神楽さんの記憶の中に出てきたのでしょうか？"},
        { "location": "2141/TALK"  , "narrator": "エリカ", "text": "この1xという機能は、Redinessになる前には別の会社が作っていた別のシステムでした"},
        { "location": "2142/TALK"  , "narrator": "エリカ", "text": "ライフギャザーというエンジンを積んだ、Q-CLOUDというソフトでした"},
        { "location": "2143/SEL"   , "narrator": "", "text": "やはりそれか…"},
        { "location": "2144/ACT"   , "narrator": "", "text": "やはりそれか…"},
        { "location": "2146/TALK"  , "narrator": "エリカ", "text": "はい"},
        { "location": "2147/TALK"  , "narrator": "エリカ", "text": "ちなみに1xがS2P、すなわちサーバークライアント接続で、2xがP2P、すなわちクライアント間接続のことです"},
        { "location": "2148/SEL"   , "narrator": "", "text": "でも、なんで1xにぴょんこが？"},
        { "location": "2149/ACT"   , "narrator": "", "text": "でも、なんで1xにぴょんこが？"},
        { "location": "2151/TALK"  , "narrator": "エリカ", "text": "それはわかりません"},
        { "location": "2152/TALK"  , "narrator": "エリカ", "text": "私からでは、そこに存在するという1ビットの情報だけしか見えませんので"},
        { "location": "2153/TALK"  , "narrator": "エリカ", "text": "あ、でも、"},
        { "location": "2154/SEL"   , "narrator": "", "text": "なに！？"},
        { "location": "2155/ACT"   , "narrator": "", "text": "なに！？"},
        { "location": "2158/SEL"   , "narrator": "", "text": "おーい"},
        { "location": "2159/ACT"   , "narrator": "", "text": "おーい"},
        { "location": "2161/TALK"  , "narrator": "エリカ", "text": "いえ、これはまた今度改めて、ちゃんとお話します"},
        { "location": "2162/TALK"  , "narrator": "エリカ", "text": "とにかく、ぴょんこさんがいる場所は特定できました"},
        { "location": "2163/TALK"  , "narrator": "エリカ", "text": "もし、$handle$さんがよろしければ、そこに今から転送しますので、行って頂けませんか？"},
        { "location": "2164/TALK"  , "narrator": "エリカ", "text": "もちろん、危険もあるかも知れませんが"},
        { "location": "2165/SEL"   , "narrator": "", "text": "もちろん行くよ"},
        { "location": "2166/SEL"   , "narrator": "", "text": "行かない"},
        { "location": "2167/ACT"   , "narrator": "", "text": "もちろん行くよ"},
        { "location": "2168/TALK"  , "narrator": "エリカ", "text": "ありがとうございます！"},
        { "location": "2169/TALK"  , "narrator": "エリカ", "text": "それでは只今から、$handle$さんを、ぴょんこさんがいる1x100に転送しますね"},
        { "location": "2170/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "2171/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "2173/TALK"  , "narrator": "エリカ", "text": "どうかよろしくお願いします"},
        { "location": "2174/TALK"  , "narrator": "エリカ", "text": "あ、ところで"},
        { "location": "2175/TALK"  , "narrator": "エリカ", "text": "同化に関与していた原因が何か、わかりましたか？"},
        { "location": "2176/SEL"   , "narrator": "", "text": "よくわからなかった"},
        { "location": "2177/SEL"   , "narrator": "", "text": "犯人は逢瀬つばめだ！"},
        { "location": "2178/ACT"   , "narrator": "", "text": "よくわからなかった"},
        { "location": "2179/TALK"  , "narrator": "エリカ", "text": "そうですか"},
        { "location": "2180/SEL"   , "narrator": "", "text": "でも、つばめがいたよ"},
        { "location": "2181/ACT"   , "narrator": "", "text": "でも、つばめがいたよ"},
        { "location": "2183/TALK"  , "narrator": "エリカ", "text": "え？"},
        { "location": "2184/TALK"  , "narrator": "エリカ", "text": "何故ですか？"},
        { "location": "2185/SEL"   , "narrator": "", "text": "わからないけど。変わる？"},
        { "location": "2186/ACT"   , "narrator": "", "text": "わからないけど。変わる？"},
        { "location": "2188/ACT"   , "narrator": "", "text": "犯人は逢瀬つばめだ！"},
        { "location": "2189/TALK"  , "narrator": "エリカ", "text": "え？"},
        { "location": "2190/TALK"  , "narrator": "エリカ", "text": "何故ですか？"},
        { "location": "2191/SEL"   , "narrator": "", "text": "その場にいたんだよね。今も一緒だけど、変わる？"},
        { "location": "2192/ACT"   , "narrator": "", "text": "その場にいたんだよね。今も一緒だけど、変わる？"},
        { "location": "2195/TALK"  , "narrator": "エリカ", "text": "いえ、大丈夫です。後で私からCHATを繋いで聞いてみます。"},
        { "location": "2196/TALK"  , "narrator": "エリカ", "text": "それより$handle$さんには、早くぴょんこさんの所に行ってもらわないといけませんから"},
        { "location": "2197/TALK"  , "narrator": "エリカ", "text": "今はまだ普通に生存反応がありますが、またいつイレギュラーなことになるかわかりません"},
        { "location": "2198/TALK"  , "narrator": "エリカ", "text": "どうか、よろしくお願いします"},
        { "location": "2199/SEL"   , "narrator": "", "text": "つばめは？"},
        { "location": "2200/ACT"   , "narrator": "", "text": "つばめは？"},
