    "entry":
    [
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "58/SEL"    , "narrator": "", "text": "空気が重いね"},
        { "location": "59/ACT"    , "narrator": "", "text": "空気が重いね"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "仕方ない"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "神楽がスパイで"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "私たちの敵だったから"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "みんな"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "ショックが大きいのよ"},
        { "location": "80/SEL"    , "narrator": "", "text": "アーヤは平気？"},
        { "location": "81/ACT"    , "narrator": "", "text": "アーヤは平気？"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "私のことはいいから"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "今は"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "みんなをどうにかしなきゃ"},
        { "location": "87/SEL"    , "narrator": "", "text": "手伝おうか？"},
        { "location": "88/SEL"    , "narrator": "", "text": "役に立てることはない？"},
        { "location": "89/SEL"    , "narrator": "", "text": "話なら聞けるよ"},
        { "location": "90/SEL"    , "narrator": "", "text": "一人で抱え込まないで"},
        { "location": "91/ACT"    , "narrator": "", "text": "手伝おうか？"},
        { "location": "92/ACT"    , "narrator": "", "text": "役に立てることはない？"},
        { "location": "93/ACT"    , "narrator": "", "text": "話なら聞けるよ"},
        { "location": "94/ACT"    , "narrator": "", "text": "一人で抱え込まないで"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "大丈夫"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "何とかするから"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "心配しないで"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "そうだ。\n確か今日って…。"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "…で？\nどうして横須賀で\n降りたのよ？"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "あら、知らないの？"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "今日はあの有名な、\n横須賀花火大会の\n日なのよ？"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "…で？"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "ノリが悪いわね…。"},
        { "location": "158/TALK"  , "narrator": "アーヤ", "text": "つまり、今日は\nおもいきって遊ぼう、\nってことよ。"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "…正気？\n昨日の夜のこと\n忘れたの！？"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "遊ぶ気になんて\nなれるわけないでしょ！"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "163/TALK"  , "narrator": "アーヤ", "text": "…じゃあ、何？\nまっすぐ劇場に帰る？"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "当然よ。\nまずは帰る。"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "それから――"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "何もできないわよ。"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "私たちは、管理庁の\n判断がないと動けない\n立場なんだから。"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "それに…劇場に戻って\n何をするつもり？"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "卯月を探しに行く？\nどこにいるか\nわかってるの？"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "171/TALK"  , "narrator": "みやび", "text": "…まあ、バカ正直に\n自宅に帰っちょる\nわけないきね。"},
        { "location": "174/TALK"  , "narrator": "ガブリエラ", "text": "わかってるわよ！\nそんなの…。"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "…なら、急いで\n帰ったところで\n意味ないでしょ？"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "今日は館長も、\n管理庁の判断を仰ぎに\n行ってるし。"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "多分、夜までは\n戻らないはずよ。"},
        { "location": "178/TALK"  , "narrator": "アーヤ", "text": "だから、今日は\n気分転換の日にした方が\nいいと思うの。"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "182/TALK"  , "narrator": "みやび", "text": "…それはあれか？\nリーダーとしての\n命令なが？"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "まさか。\n命令じゃなくて提案よ。"},
        { "location": "186/TALK"  , "narrator": "アーヤ", "text": "というわけだから、\n私は今日一日、\nおもいっきり遊ぶわ。"},
        { "location": "188/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "194/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ達も、\nあとは好きにして\nいいから…じゃあね。"},
        { "location": "199/TALK"  , "narrator": "ガブリエラ", "text": "…ふんっ。"},
        { "location": "203/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "225/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "バカ…。\nあたしの、バカ…。"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "神楽が裏切者だった\nことに、どうして\n気づかなかったの？"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "あたし、ちゃんと\n警戒してたはず\nなのに…。"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "神楽とつばめは、\n何かヤバいって…。"},
        { "location": "230/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "231/TALK"  , "narrator": "ガブリエラ", "text": "甘かった…。"},
        { "location": "232/TALK"  , "narrator": "ガブリエラ", "text": "確信もないのに警戒を\n解くのは自殺行為だって、\nちゃんとわかってたのに！"},
        { "location": "233/TALK"  , "narrator": "ガブリエラ", "text": "なのに、あたし…。"},
        { "location": "234/TALK"  , "narrator": "ガブリエラ", "text": "…っ！？"},
        { "location": "235/TALK"  , "narrator": "ガブリエラ", "text": "…場所、移そうかしら。"},
        { "location": "236/TALK"  , "narrator": "ガブリエラ", "text": "どこか、大声出しても\nよさそうなところ\n探したいし…。"},
        { "location": "237/SEL"   , "narrator": "", "text": "誰か呼ぼうか？"},
        { "location": "238/SEL"   , "narrator": "", "text": "ガブリエラ、大丈夫？"},
        { "location": "239/ACT"   , "narrator": "", "text": "誰か呼ぼうか？"},
        { "location": "250/TALK"  , "narrator": "ガブリエラ", "text": "やめて"},
        { "location": "251/TALK"  , "narrator": "ガブリエラ", "text": "余計なことしないでちょうだい"},
        { "location": "252/TALK"  , "narrator": "ガブリエラ", "text": "これ以上"},
        { "location": "253/TALK"  , "narrator": "ガブリエラ", "text": "勝手なことしたら投げ捨てるわよ"},
        { "location": "254/ACT"   , "narrator": "", "text": "ガブリエラ、大丈夫？"},
        { "location": "265/TALK"  , "narrator": "ガブリエラ", "text": "大丈夫って言ったら信じるの？"},
        { "location": "266/TALK"  , "narrator": "ガブリエラ", "text": "そんなわけないでしょう？"},
        { "location": "267/TALK"  , "narrator": "ガブリエラ", "text": "なんて"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "八つ当たりもいいところね"},
        { "location": "271/SEL"   , "narrator": "", "text": "神楽にイライラしてるの？"},
        { "location": "272/ACT"   , "narrator": "", "text": "神楽にイライラしてるの？"},
        { "location": "274/TALK"  , "narrator": "ガブリエラ", "text": "あいつに対してはイライラじゃすまないから"},
        { "location": "275/TALK"  , "narrator": "ガブリエラ", "text": "イライラしてるのは"},
        { "location": "276/TALK"  , "narrator": "ガブリエラ", "text": "自分に対してよ"},
        { "location": "277/TALK"  , "narrator": "ガブリエラ", "text": "あたしいつの間にかうぬぼれてたのかもしれないわ"},
        { "location": "279/TALK"  , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "280/TALK"  , "narrator": "ガブリエラ", "text": "神楽に命中はさせたのよ"},
        { "location": "281/TALK"  , "narrator": "ガブリエラ", "text": "だから腕が足りてないなんてことはないの"},
        { "location": "282/TALK"  , "narrator": "ガブリエラ", "text": "ライフルが通用しない相手を想定をしていなかったことにイライラしてるの"},
        { "location": "284/SEL"   , "narrator": "", "text": "ふうん？"},
        { "location": "285/SEL"   , "narrator": "", "text": "当たらなくてよかったよ"},
        { "location": "286/SEL"   , "narrator": "", "text": "次は倒すんでしょ"},
        { "location": "287/ACT"   , "narrator": "", "text": "ふうん？"},
        { "location": "288/TALK"  , "narrator": "ガブリエラ", "text": "気のないお返事ね"},
        { "location": "289/ACT"   , "narrator": "", "text": "当たらなくてよかったよ"},
        { "location": "290/TALK"  , "narrator": "ガブリエラ", "text": "そんなわけないでしょう？"},
        { "location": "291/ACT"   , "narrator": "", "text": "次は倒すんでしょ"},
        { "location": "292/TALK"  , "narrator": "ガブリエラ", "text": "当然よ"},
        { "location": "295/SEL"   , "narrator": "", "text": "でも"},
        { "location": "296/ACT"   , "narrator": "", "text": "でも"},
        { "location": "298/TALK"  , "narrator": "ガブリエラ", "text": "何かしら？"},
        { "location": "300/SEL"   , "narrator": "", "text": "友達なんでしょ？"},
        { "location": "301/ACT"   , "narrator": "", "text": "友達なんでしょ？"},
        { "location": "304/TALK"  , "narrator": "ガブリエラ", "text": "何を言っているの？"},
        { "location": "305/TALK"  , "narrator": "ガブリエラ", "text": "これは戦いなの"},
        { "location": "306/TALK"  , "narrator": "ガブリエラ", "text": "あいつは私たちを裏切った"},
        { "location": "307/TALK"  , "narrator": "ガブリエラ", "text": "つばめのことを殺そうとした"},
        { "location": "308/TALK"  , "narrator": "ガブリエラ", "text": "なのに友達だからって何なの？"},
        { "location": "309/TALK"  , "narrator": "ガブリエラ", "text": "バカ言わないで"},
        { "location": "310/TALK"  , "narrator": "ガブリエラ", "text": "つばめを殺そうとしたのを見た瞬間"},
        { "location": "311/TALK"  , "narrator": "ガブリエラ", "text": "あいつは敵になったの"},
        { "location": "312/TALK"  , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "313/TALK"  , "narrator": "ガブリエラ", "text": "撃つのに躊躇したりしないわ"},
        { "location": "315/SEL"   , "narrator": "", "text": "もう敵でしかないの？"},
        { "location": "316/SEL"   , "narrator": "", "text": "でも友達なんでしょ？"},
        { "location": "317/SEL"   , "narrator": "", "text": "友達を撃つの？"},
        { "location": "318/ACT"   , "narrator": "", "text": "もう敵でしかないの？"},
        { "location": "319/TALK"  , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "320/ACT"   , "narrator": "", "text": "でも友達なんでしょ？"},
        { "location": "321/TALK"  , "narrator": "ガブリエラ", "text": "そんなの"},
        { "location": "322/ACT"   , "narrator": "", "text": "友達を撃つの？"},
        { "location": "323/TALK"  , "narrator": "ガブリエラ", "text": "友達とか"},
        { "location": "325/TALK"  , "narrator": "ガブリエラ", "text": "だから違う！"},
        { "location": "326/TALK"  , "narrator": "ガブリエラ", "text": "決めつけないで！"},
        { "location": "327/TALK"  , "narrator": "ガブリエラ", "text": "何でそうなるのよ！？"},
        { "location": "329/SEL"   , "narrator": "", "text": "ガブリエラに神楽は撃てない"},
        { "location": "330/ACT"   , "narrator": "", "text": "ガブリエラに神楽は撃てない"},
        { "location": "332/TALK"  , "narrator": "ガブリエラ", "text": "そんなことない！"},
        { "location": "333/TALK"  , "narrator": "ガブリエラ", "text": "神楽は敵！"},
        { "location": "334/TALK"  , "narrator": "ガブリエラ", "text": "敵を撃たないで何を撃つのよ？"},
        { "location": "336/SEL"   , "narrator": "", "text": "無理だ、撃てない"},
        { "location": "337/ACT"   , "narrator": "", "text": "無理だ、撃てない"},
        { "location": "339/TALK"  , "narrator": "ガブリエラ", "text": "撃つわ"},
        { "location": "340/TALK"  , "narrator": "ガブリエラ", "text": "人を撃つ覚悟もなくて銃を握ってないの"},
        { "location": "341/TALK"  , "narrator": "ガブリエラ", "text": "だから絶対に撃って"},
        { "location": "342/TALK"  , "narrator": "ガブリエラ", "text": "確実に仕留める"},
        { "location": "344/SEL"   , "narrator": "", "text": "本気で言ってるの？"},
        { "location": "345/SEL"   , "narrator": "", "text": "待って待って待って"},
        { "location": "346/SEL"   , "narrator": "", "text": "できるわけないよ"},
        { "location": "347/ACT"   , "narrator": "", "text": "本気で言ってるの？"},
        { "location": "348/TALK"  , "narrator": "ガブリエラ", "text": "当然"},
        { "location": "349/ACT"   , "narrator": "", "text": "待って待って待って"},
        { "location": "350/TALK"  , "narrator": "ガブリエラ", "text": "何よ"},
        { "location": "351/ACT"   , "narrator": "", "text": "できるわけないよ"},
        { "location": "352/TALK"  , "narrator": "ガブリエラ", "text": "は？"},
        { "location": "354/TALK"  , "narrator": "ガブリエラ", "text": "何なのよ！"},
        { "location": "355/TALK"  , "narrator": "ガブリエラ", "text": "私の何を知ってるのよ！"},
        { "location": "356/TALK"  , "narrator": "ガブリエラ", "text": "勝手にできないなんて決めつけないで"},
        { "location": "358/SEL"   , "narrator": "", "text": "じゃあ何でできるって言えるの？"},
        { "location": "359/ACT"   , "narrator": "", "text": "じゃあ何でできるって言えるの？"},
        { "location": "361/TALK"  , "narrator": "ガブリエラ", "text": "そんなの"},
        { "location": "362/TALK"  , "narrator": "ガブリエラ", "text": "お母さんを殺した私には"},
        { "location": "364/SEL"   , "narrator": "", "text": "え？"},
        { "location": "365/ACT"   , "narrator": "", "text": "え？"},
        { "location": "368/TALK"  , "narrator": "ガブリエラ", "text": "え"},
        { "location": "369/TALK"  , "narrator": "ガブリエラ", "text": "なに"},
        { "location": "370/TALK"  , "narrator": "ガブリエラ", "text": "これ"},
        { "location": "371/TALK"  , "narrator": "ガブリエラ", "text": "知らない"},
        { "location": "372/TALK"  , "narrator": "ガブリエラ", "text": "私知らないから"},
        { "location": "373/TALK"  , "narrator": "ガブリエラ", "text": "お母様は強盗に殺されたのよ"},
        { "location": "380/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "382/TALK"  , "narrator": "ガブリエラ", "text": "あたし…\nあたしったら…！"},
        { "location": "447/TALK"  , "narrator": "ガブリエラ", "text": "　"},
        { "location": "464/TALK"  , "narrator": "ガブリエラ", "text": "！？"},
        { "location": "465/TALK"  , "narrator": "ガブリエラ", "text": "$handle$危ない！"},
        { "location": "466/SEL"   , "narrator": "", "text": "え！？"},
        { "location": "467/ACT"   , "narrator": "", "text": "え！？"},
        { "location": "474/TALK"  , "narrator": "ガブリエラ", "text": "大丈夫！？\n丁度いいところに\n来てくれたわ。"},
        { "location": "478/SEL"   , "narrator": "", "text": "何が起こってるの！？"},
        { "location": "479/ACT"   , "narrator": "", "text": "何が起こってるの！？"},
        { "location": "481/TALK"  , "narrator": "ガブリエラ", "text": "説明は後！\nそれより、ちょっと\nお願いがあるんだけど！"},
        { "location": "485/TALK"  , "narrator": "ガブリエラ", "text": "扉を\nC3:5:91A//1x082番地へ\n回して頂戴！"},
        { "location": "486/TALK"  , "narrator": "ガブリエラ", "text": "コマンドは\nEXEC_SEEK_\nEXTERNAL_SECTOR/."},
        { "location": "487/TALK"  , "narrator": "ガブリエラ", "text": "早く！！"},
        { "location": "492/SEL"   , "narrator": "", "text": "EXEC_SEEK_SECTOR/."},
        { "location": "493/SEL"   , "narrator": "", "text": "EXEC_SEEK_EXTERNAL_SECTOR/."},
        { "location": "497/SEL"   , "narrator": "", "text": "Type::Secret"},
        { "location": "498/SEL"   , "narrator": "", "text": "Type::EternalDreaming"},
        { "location": "499/SEL"   , "narrator": "", "text": "Type::"},
        { "location": "510/SEL"   , "narrator": "", "text": "Addr::C3:5:91A//1x082"},
        { "location": "559/TALK"  , "narrator": "ガブリエラ", "text": "え！？"},
        { "location": "579/TALK"  , "narrator": "ガブリエラ", "text": "うーん、\nやっぱりもっと牛乳\n飲まないとダメかしらね。"},
        { "location": "580/TALK"  , "narrator": "ガブリエラ", "text": "アーヤとか、\n何を食べて\n育ったのかしら。"},
        { "location": "581/TALK"  , "narrator": "ガブリエラ", "text": "いや、みやびの方が\nもっと気になるわね。"},
        { "location": "582/TALK"  , "narrator": "ガブリエラ", "text": "あ、もしかして、\nあまり運動してないから\n脂肪がつきやすい？"},
        { "location": "583/SEL"   , "narrator": "", "text": "ガブリエラは今のままが一番美しい"},
        { "location": "584/SEL"   , "narrator": "", "text": "好きな人に揉まれるといいらしいよ"},
        { "location": "585/ACT"   , "narrator": "", "text": "ガブリエラは今のままが一番美しい"},
        { "location": "587/TALK"  , "narrator": "ガブリエラ", "text": "ふふ、そう？"},
        { "location": "588/ACT"   , "narrator": "", "text": "好きな人に揉まれるといいらしいよ"},
        { "location": "589/TALK"  , "narrator": "ガブリエラ", "text": "好きな人っていえば――"},
        { "location": "592/TALK"  , "narrator": "ガブリエラ", "text": "って！！\nええええっ！！"},
        { "location": "593/TALK"  , "narrator": "ガブリエラ", "text": "撃つわよ！！"},
        { "location": "626/TALK"  , "narrator": "ガブリエラ", "text": "はぁ……\n日本は暑いわね…。"},
        { "location": "627/TALK"  , "narrator": "ガブリエラ", "text": "ポーランドくらい\n涼しければもっと\n素敵なのに……。"},
        { "location": "628/TALK"  , "narrator": "ガブリエラ", "text": "あ、でもそうしたら\nかき氷が食べられなく\nなっちゃうかも……。"},
        { "location": "629/SEL"   , "narrator": "", "text": "今後地球は寒冷期に突入するから今すぐ食べに行かないと！"},
        { "location": "630/ACT"   , "narrator": "", "text": "今後地球は寒冷期に突入するから今すぐ食べに行かないと！"},
        { "location": "632/TALK"  , "narrator": "ガブリエラ", "text": "ええっ！？\nそうなの！？"},
        { "location": "651/TALK"  , "narrator": "ガブリエラ", "text": "かき氷～♪\n楽しみだわ！"},
        { "location": "652/SEL"   , "narrator": "", "text": "何味が好きなの？"},
        { "location": "653/ACT"   , "narrator": "", "text": "何味が好きなの？"},
        { "location": "655/TALK"  , "narrator": "ガブリエラ", "text": "あたしが好きなのは、\nやっぱり「あずきみるく\nお餅入り」ね！"},
        { "location": "656/SEL"   , "narrator": "", "text": "奇遇だね！$me$もそれが好きだよ"},
        { "location": "657/SEL"   , "narrator": "", "text": "なかなか渋いね"},
        { "location": "658/ACT"   , "narrator": "", "text": "奇遇だね！$me$もそれが好きだよ"},
        { "location": "659/TALK"  , "narrator": "ガブリエラ", "text": "ほんとに？\n気が合うわね～♪"},
        { "location": "660/ACT"   , "narrator": "", "text": "なかなか渋いね"},
        { "location": "661/TALK"  , "narrator": "ガブリエラ", "text": "そ、そうかしらね。"},
        { "location": "663/TALK"  , "narrator": "ガブリエラ", "text": "$handle$は\n何が好きなの？"},
        { "location": "664/SEL"   , "narrator": "", "text": "いちご"},
        { "location": "665/SEL"   , "narrator": "", "text": "レモン"},
        { "location": "666/SEL"   , "narrator": "", "text": "メロン"},
        { "location": "667/SEL"   , "narrator": "", "text": "ブルーハワイ"},
        { "location": "668/SEL"   , "narrator": "", "text": "カンロ"},
        { "location": "669/SEL"   , "narrator": "", "text": "ミルク"},
        { "location": "670/SEL"   , "narrator": "", "text": "あずき"},
        { "location": "671/SEL"   , "narrator": "", "text": "あまり一般的ではないレアなヤツ"},
        { "location": "672/ACT"   , "narrator": "", "text": "いちご"},
        { "location": "673/TALK"  , "narrator": "ガブリエラ", "text": "あら、\nつばめみたいね。"},
        { "location": "674/ACT"   , "narrator": "", "text": "レモン"},
        { "location": "675/TALK"  , "narrator": "ガブリエラ", "text": "とっても酸っぱそうね。"},
        { "location": "676/ACT"   , "narrator": "", "text": "メロン"},
        { "location": "677/TALK"  , "narrator": "ガブリエラ", "text": "お口の中が\n緑色になるヤツよね。"},
        { "location": "678/ACT"   , "narrator": "", "text": "ブルーハワイ"},
        { "location": "679/TALK"  , "narrator": "ガブリエラ", "text": "いかにも夏！だけど\nどんな味だったかしら。"},
        { "location": "680/ACT"   , "narrator": "", "text": "カンロ"},
        { "location": "681/TALK"  , "narrator": "ガブリエラ", "text": "一瞬氷だけに\n見えるわよね。\n甘くてあたしも好きよ？"},
        { "location": "682/ACT"   , "narrator": "", "text": "ミルク"},
        { "location": "683/TALK"  , "narrator": "ガブリエラ", "text": "ミルクも美味しいわよね。\n濃厚なのは大好き♪"},
        { "location": "684/ACT"   , "narrator": "", "text": "あずき"},
        { "location": "685/TALK"  , "narrator": "ガブリエラ", "text": "やっぱりあずきよね！\n氷とすごく良く合うのよ。"},
        { "location": "686/ACT"   , "narrator": "", "text": "あまり一般的ではないレアなヤツ"},
        { "location": "687/TALK"  , "narrator": "ガブリエラ", "text": "何なのかしらね。\nちょっと気になるわね。"},
        { "location": "689/TALK"  , "narrator": "ガブリエラ", "text": "$handle$とは、\n早く現実でも一緒に\n氷食べたいわね。"},
        { "location": "690/TALK"  , "narrator": "ガブリエラ", "text": "待ってるから。"},
        { "location": "753/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…はぁ……"},
        { "location": "754/TALK"  , "narrator": "ガブリエラ", "text": "ふぅ……"},
        { "location": "755/TALK"  , "narrator": "ガブリエラ", "text": "さすが$handle$。\n飛び先バッチリよ。"},
        { "location": "756/SEL"   , "narrator": "", "text": "ここは？"},
        { "location": "757/SEL"   , "narrator": "", "text": "何で戦ってたの？"},
        { "location": "758/SEL"   , "narrator": "", "text": "逃げて大丈夫だったの？"},
        { "location": "759/ACT"   , "narrator": "", "text": "ここは？"},
        { "location": "760/TALK"  , "narrator": "ガブリエラ", "text": "ここは、あたしの世界とは\n似て非なるところ。"},
        { "location": "761/TALK"  , "narrator": "ガブリエラ", "text": "人格たちの間では\n1xと呼ばれてる。"},
        { "location": "762/TALK"  , "narrator": "ガブリエラ", "text": "0xの人格でも、司書だけは\n入ることを許されてるけど\n長居はできないわ。"},
        { "location": "763/TALK"  , "narrator": "ガブリエラ", "text": "だから速やかに\n用事を済ませて\n戻らなくちゃ。"},
        { "location": "764/ACT"   , "narrator": "", "text": "何で戦ってたの？"},
        { "location": "765/TALK"  , "narrator": "ガブリエラ", "text": "前回法規違反を犯した\nとかで、あたしの抹殺\n命令が出てるみたい。"},
        { "location": "766/TALK"  , "narrator": "ガブリエラ", "text": "まあ、そんなことは\n百も承知だったけど。"},
        { "location": "767/TALK"  , "narrator": "ガブリエラ", "text": "誤算だったのは、\n丁度$handle$が\n来ちゃったこと。"},
        { "location": "768/TALK"  , "narrator": "ガブリエラ", "text": "まあ、そのお陰で\nだいぶ楽にここへ\n来る事ができたんだけど。"},
        { "location": "769/ACT"   , "narrator": "", "text": "何で戦ってたの？"},
        { "location": "770/TALK"  , "narrator": "ガブリエラ", "text": "失礼ね、\n逃げたわけじゃないわ。"},
        { "location": "771/TALK"  , "narrator": "ガブリエラ", "text": "元々ココに来たかったの。"},
        { "location": "772/TALK"  , "narrator": "ガブリエラ", "text": "ただ、敵の攻撃が\n想像以上に激しくて、\n扉回してるヒマがなくて。"},
        { "location": "773/TALK"  , "narrator": "ガブリエラ", "text": "だから、\n$handle$が\n回してくれて助かったわ。"},
        { "location": "775/SEL"   , "narrator": "", "text": "ところでその格好…"},
        { "location": "776/ACT"   , "narrator": "", "text": "ところでその格好…"},
        { "location": "778/TALK"  , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "782/TALK"  , "narrator": "ガブリエラ", "text": "あ…"},
        { "location": "784/TALK"  , "narrator": "ガブリエラ", "text": "懐かしい。\nウォヴィッチだなんて。"},
        { "location": "785/SEL"   , "narrator": "", "text": "とても似合ってる"},
        { "location": "786/SEL"   , "narrator": "", "text": "ポーランドの民族衣装？"},
        { "location": "787/ACT"   , "narrator": "", "text": "とても似合ってる"},
        { "location": "788/TALK"  , "narrator": "ガブリエラ", "text": "ふふ、ありがと。"},
        { "location": "789/TALK"  , "narrator": "ガブリエラ", "text": "あたしもとっても\nお気に入りなのよね。"},
        { "location": "790/ACT"   , "narrator": "", "text": "ポーランドの民族衣装？"},
        { "location": "791/TALK"  , "narrator": "ガブリエラ", "text": "ええ、そうよ。"},
        { "location": "792/TALK"  , "narrator": "ガブリエラ", "text": "子供の頃は、\nこの衣装を着れる日が\n楽しみだったわ。"},
        { "location": "793/TALK"  , "narrator": "ガブリエラ", "text": "和服と同じで、\nいつも着てるわけじゃ\nないから。"},
        { "location": "795/SEL"   , "narrator": "", "text": "ここはポーランドなの？"},
        { "location": "796/ACT"   , "narrator": "", "text": "ここはポーランドなの？"},
        { "location": "798/TALK"  , "narrator": "ガブリエラ", "text": "そうみたい。"},
        { "location": "799/TALK"  , "narrator": "ガブリエラ", "text": "まったく、\n1xのくせに生意気ね。"},
        { "location": "800/SEL"   , "narrator": "", "text": "どういうこと？"},
        { "location": "801/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "803/TALK"  , "narrator": "ガブリエラ", "text": "1xは、あたしの心の中\nではあるけど、厳密には\n完全なものじゃないのよ。"},
        { "location": "804/TALK"  , "narrator": "ガブリエラ", "text": "半分はあたしじゃない\n存在によって\n構成されてる。"},
        { "location": "805/TALK"  , "narrator": "ガブリエラ", "text": "だから、1xにいる人格は\nあたしと別の何かの人格が\n混ざってる存在なの。"},
        { "location": "806/TALK"  , "narrator": "ガブリエラ", "text": "正直、\nちょっとキモくない？"},
        { "location": "807/TALK"  , "narrator": "ガブリエラ", "text": "でも、トライナリーとして\n活動するには、必要\n不可欠なことなのよね。"},
        { "location": "808/SEL"   , "narrator": "", "text": "改造人間だったのか！"},
        { "location": "809/SEL"   , "narrator": "", "text": "未来を見据える力？"},
        { "location": "810/ACT"   , "narrator": "", "text": "改造人間だったのか！"},
        { "location": "811/TALK"  , "narrator": "ガブリエラ", "text": "人聞き悪い事\n言わないで頂戴？"},
        { "location": "812/TALK"  , "narrator": "ガブリエラ", "text": "どこも改造なんて\nされてないわよ。"},
        { "location": "813/TALK"  , "narrator": "ガブリエラ", "text": "外の何かと少しだけ\n精神が繋がってるだけ。"},
        { "location": "814/ACT"   , "narrator": "", "text": "未来を見据える力？"},
        { "location": "815/TALK"  , "narrator": "ガブリエラ", "text": "惜しいわね。\n正確には、客観的な視点で\n世界を見渡せる力。"},
        { "location": "817/TALK"  , "narrator": "ガブリエラ", "text": "1xの人格は、あたしの\n外側から世界を見たり、\n過去や未来を見られる。"},
        { "location": "818/TALK"  , "narrator": "ガブリエラ", "text": "だから、無意識的に\n状況を判断して、的確に\n行動することができる。"},
        { "location": "819/SEL"   , "narrator": "", "text": "だから訓練無しであんなバトルできるのか！"},
        { "location": "820/ACT"   , "narrator": "", "text": "だから訓練無しであんなバトルできるのか！"},
        { "location": "822/TALK"  , "narrator": "ガブリエラ", "text": "まあ、それも\n恩恵の一つよね。"},
        { "location": "823/TALK"  , "narrator": "ガブリエラ", "text": "…っと、そんな話を\nしてる場合じゃないわ。"},
        { "location": "824/TALK"  , "narrator": "ガブリエラ", "text": "やることやって\nさっさと戻らなくちゃ。"},
        { "location": "825/SEL"   , "narrator": "", "text": "何をしに来たの？"},
        { "location": "826/ACT"   , "narrator": "", "text": "何をしに来たの？"},
        { "location": "828/TALK"  , "narrator": "ガブリエラ", "text": "未来を覗きに来たの。"},
        { "location": "829/SEL"   , "narrator": "", "text": "どういうこと！？"},
        { "location": "830/ACT"   , "narrator": "", "text": "どういうこと！？"},
        { "location": "832/TALK"  , "narrator": "ガブリエラ", "text": "その言葉の通りよ。"},
        { "location": "833/TALK"  , "narrator": "ガブリエラ", "text": "あたしみたいな0xの\n人格は、主観的にしか\n物事を見られない。"},
        { "location": "834/TALK"  , "narrator": "ガブリエラ", "text": "当然1xみたいに\n未来なんかも見られない。"},
        { "location": "835/TALK"  , "narrator": "ガブリエラ", "text": "でも、あたしは司書として\n1xに入る特権を持ってる。"},
        { "location": "836/TALK"  , "narrator": "ガブリエラ", "text": "それを使わない手は\nないでしょ？"},
        { "location": "837/TALK"  , "narrator": "ガブリエラ", "text": "自分の目で\n確認したいのよ。"},
        { "location": "839/TALK"  , "narrator": "ガブリエラ", "text": "このまま外部リンクを\nした状態の方が、\n幸せなのか、それとも――"},
        { "location": "841/TALK"  , "narrator": "ガブリエラ", "text": "この前攻めてきた人格の\n言う通り、切り離した方が\n幸せになれるのか。"},
        { "location": "842/TALK"  , "narrator": "ガブリエラ", "text": "1xにある、\n【時を伝う部屋】に行けば\nそれが見られるの。"},
        { "location": "843/TALK"  , "narrator": "ガブリエラ", "text": "だからあたしは、\nそこを目指してる。"},
        { "location": "844/SEL"   , "narrator": "", "text": "すごく危ない気がするんだけど"},
        { "location": "845/SEL"   , "narrator": "", "text": "$me$も手伝うよ"},
        { "location": "846/ACT"   , "narrator": "", "text": "すごく危ない気がするんだけど"},
        { "location": "847/TALK"  , "narrator": "ガブリエラ", "text": "わかってるわよ。"},
        { "location": "848/TALK"  , "narrator": "ガブリエラ", "text": "でも、もう自分のココロの\n中はボロボロなの。"},
        { "location": "849/TALK"  , "narrator": "ガブリエラ", "text": "何が正解で、何を信じたら\n後悔しないのか、自分でも\nまったくわからない。"},
        { "location": "850/TALK"  , "narrator": "ガブリエラ", "text": "司書として、言われるが\nママに扉を回してれば\n安泰かと思ってた。"},
        { "location": "851/TALK"  , "narrator": "ガブリエラ", "text": "けど、あたしの\nココロの住人は、\nそんな甘くなかった。"},
        { "location": "852/TALK"  , "narrator": "ガブリエラ", "text": "正解が見つからないまま\n戦いを繰り返してたら、\n心の中は廃墟になる。"},
        { "location": "853/TALK"  , "narrator": "ガブリエラ", "text": "その前に、未来の正解を\n自分自身の目で、\n確かめたいの。"},
        { "location": "854/ACT"   , "narrator": "", "text": "$me$も手伝うよ"},
        { "location": "855/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう。\nすごく嬉しい。"},
        { "location": "857/TALK"  , "narrator": "ガブリエラ", "text": "でもこれは、\nあたしの問題だから。"},
        { "location": "858/TALK"  , "narrator": "ガブリエラ", "text": "$handle$には\n迷惑かけられない。"},
        { "location": "859/TALK"  , "narrator": "ガブリエラ", "text": "それに、\n$handle$は現実の\nあたしを見なくちゃだし。"},
        { "location": "860/TALK"  , "narrator": "ガブリエラ", "text": "……っと！　そういえば\nそれで思い出したけど、\n何かココロに問題が？"},
        { "location": "861/SEL"   , "narrator": "", "text": "お母さん殺したのってガブちゃんなの！？"},
        { "location": "862/ACT"   , "narrator": "", "text": "お母さん殺したのってガブちゃんなの！？"},
        { "location": "864/TALK"  , "narrator": "ガブリエラ", "text": "え"},
        { "location": "865/TALK"  , "narrator": "ガブリエラ", "text": "えええええっ！？"},
        { "location": "866/TALK"  , "narrator": "ガブリエラ", "text": "それ、\n現実のあたしが\n言ったの！？"},
        { "location": "867/SEL"   , "narrator": "", "text": "そうだよ"},
        { "location": "868/ACT"   , "narrator": "", "text": "そうだよ"},
        { "location": "870/TALK"  , "narrator": "ガブリエラ", "text": "……そ、そんな…"},
        { "location": "871/TALK"  , "narrator": "ガブリエラ", "text": "馬鹿な……"},
        { "location": "872/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "873/SEL"   , "narrator": "", "text": "どうしたの！？\n大丈夫！？"},
        { "location": "874/SEL"   , "narrator": "", "text": "過去に何があったの！？"},
        { "location": "875/ACT"   , "narrator": "", "text": "どうしたの！？\n大丈夫！？"},
        { "location": "876/TALK"  , "narrator": "ガブリエラ", "text": "……ううん。\nなんでもない…。"},
        { "location": "877/ACT"   , "narrator": "", "text": "過去に何があったの！？"},
        { "location": "878/TALK"  , "narrator": "ガブリエラ", "text": "……いえ、\nそれは……"},
        { "location": "880/SEL"   , "narrator": "", "text": "言ってはいけないことだった？"},
        { "location": "881/ACT"   , "narrator": "", "text": "言ってはいけないことだった？"},
        { "location": "883/TALK"  , "narrator": "ガブリエラ", "text": "言ってはいけない\nことなんて、ココロの\n中には存在しないわ。"},
        { "location": "884/TALK"  , "narrator": "ガブリエラ", "text": "ただ、事態は想像以上に\n深刻なんだわって、\nちょっとビックリしたの。"},
        { "location": "885/TALK"  , "narrator": "ガブリエラ", "text": "母親を殺した事、もし\n本当に自分で言ったなら、\n遂に封印が解かれたのね。"},
        { "location": "886/SEL"   , "narrator": "", "text": "封印ってなに！？"},
        { "location": "887/ACT"   , "narrator": "", "text": "封印ってなに！？"},
        { "location": "889/TALK"  , "narrator": "ガブリエラ", "text": "認識すると精神に破綻を\nきたす記憶は、野放しに\nできないから封印する。"},
        { "location": "890/TALK"  , "narrator": "ガブリエラ", "text": "そういった心の封印は、\n一度されれば、自然に\n解けることは、まずない。"},
        { "location": "891/TALK"  , "narrator": "ガブリエラ", "text": "ということは……"},
        { "location": "892/TALK"  , "narrator": "ガブリエラ", "text": "この前襲ってきた\n反司書派がやったのか、\n1xの誰かがやったのか――"},
        { "location": "893/TALK"  , "narrator": "ガブリエラ", "text": "それとも、\nマークスマン自身が？\nまさか……"},
        { "location": "894/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり早く\n【時を伝う部屋】へ\n行かなくちゃだわね……。"},
        { "location": "895/TALK"  , "narrator": "ガブリエラ", "text": "とにかく、\n情報を見てみるわ。"},
        { "location": "897/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "898/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり。\nかなり気が動転してる。"},
        { "location": "899/TALK"  , "narrator": "ガブリエラ", "text": "単純にその弾みで\n記憶が飛び出したって\nこともあるかもだけど――"},
        { "location": "900/TALK"  , "narrator": "ガブリエラ", "text": "うーん、やっぱり\nその可能性は低いわね。"},
        { "location": "901/TALK"  , "narrator": "ガブリエラ", "text": "書かれていた指針は\n興奮させているクランを\n倒すこと、だそうよ。"},
        { "location": "902/TALK"  , "narrator": "ガブリエラ", "text": "それと、ココロのケアも\nしなくちゃだわね。"},
        { "location": "903/TALK"  , "narrator": "ガブリエラ", "text": "そのあたり、\n$handle$に\nお願いしていい？"},
        { "location": "904/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "905/SEL"   , "narrator": "", "text": "どうすればいい？"},
        { "location": "906/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "907/TALK"  , "narrator": "ガブリエラ", "text": "ありがと。"},
        { "location": "908/ACT"   , "narrator": "", "text": "どうすればいい？"},
        { "location": "909/TALK"  , "narrator": "ガブリエラ", "text": "そうね。"},
        { "location": "910/TALK"  , "narrator": "ガブリエラ", "text": "話しちゃった以上、\nそれは取り消せないわけで\nそうなると答えは１つ。"},
        { "location": "911/TALK"  , "narrator": "ガブリエラ", "text": "$handle$が、\n話しても安全な存在だと\n認識すること。"},
        { "location": "912/TALK"  , "narrator": "ガブリエラ", "text": "そうすれば、\n現実のあたしも\nその場では落ち着く。"},
        { "location": "913/TALK"  , "narrator": "ガブリエラ", "text": "どうやって安全だって\n認識させるかは、\nお任せするわ。"},
        { "location": "915/TALK"  , "narrator": "ガブリエラ", "text": "あたしの方は、\nどうして封印が解けたのか\n調べて見るわね。"},
        { "location": "916/TALK"  , "narrator": "ガブリエラ", "text": "このままだと、\n今は何ともないかも\nしれないけど――"},
        { "location": "917/TALK"  , "narrator": "ガブリエラ", "text": "いずれ段々と歪みが\n出てきて、思い詰まって\n何をするか分からない。"},
        { "location": "918/TALK"  , "narrator": "ガブリエラ", "text": "その前に再封印するか、\n散らすか、とにかく\n何とかしなくちゃだから。"},
        { "location": "919/SEL"   , "narrator": "", "text": "頑張ってね"},
        { "location": "920/ACT"   , "narrator": "", "text": "頑張ってね"},
        { "location": "922/TALK"  , "narrator": "ガブリエラ", "text": "ええ、お互いね。"},
        { "location": "923/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "924/TALK"  , "narrator": "ガブリエラ", "text": "本当は知りたいでしょう？\nあたしが母親を殺したのは\n事実なのか。"},
        { "location": "925/TALK"  , "narrator": "ガブリエラ", "text": "もしそうなら、\n何故殺したのか。"},
        { "location": "926/SEL"   , "narrator": "", "text": "知りたい"},
        { "location": "927/SEL"   , "narrator": "", "text": "別に知りたくない"},
        { "location": "928/ACT"   , "narrator": "", "text": "知りたい"},
        { "location": "929/TALK"  , "narrator": "ガブリエラ", "text": "そうよね。"},
        { "location": "930/TALK"  , "narrator": "ガブリエラ", "text": "無理に聞いたりしないで\nいてくれて、ありがと。"},
        { "location": "931/TALK"  , "narrator": "ガブリエラ", "text": "もうちょっと落ち着いたら\nお話できるかもだから。"},
        { "location": "932/TALK"  , "narrator": "ガブリエラ", "text": "今は現実のあたしのこと、\n宜しくお願いするわね。"},
        { "location": "933/ACT"   , "narrator": "", "text": "別に知りたくない"},
        { "location": "934/TALK"  , "narrator": "ガブリエラ", "text": "そう。"},
        { "location": "935/TALK"  , "narrator": "ガブリエラ", "text": "気を遣って言って\nくれてるのかしらね。"},
        { "location": "936/TALK"  , "narrator": "ガブリエラ", "text": "もし本心からなら、\nそれはそれでちょっと\n寂しいかもだけど。"},
        { "location": "937/TALK"  , "narrator": "ガブリエラ", "text": "まあ、しつこく尋問\nされるよりは全然\nいいけどね。"},
        { "location": "939/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ早速だけど…\n今から$handle$だけ\n0xに戻すわね。"},
        { "location": "940/TALK"  , "narrator": "ガブリエラ", "text": "扉は既にさっき回して\nセッティングされてるから\nそのまま飛び込んで。"},
        { "location": "941/SEL"   , "narrator": "", "text": "ここでお別れなの！？"},
        { "location": "942/ACT"   , "narrator": "", "text": "ここでお別れなの！？"},
        { "location": "944/TALK"  , "narrator": "ガブリエラ", "text": "大丈夫よ。次回はここに\n転送されるように、\nマーカー付けておくから。"},
        { "location": "945/TALK"  , "narrator": "ガブリエラ", "text": "……$handle$。\n今は貴方だけが頼りなの。"},
        { "location": "946/TALK"  , "narrator": "ガブリエラ", "text": "あたしの大切な人。"},
        { "location": "947/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、\nいくわよ。"},
        { "location": "948/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$に\n素敵なココロの旅を。"},
        { "location": "973/SEL"   , "narrator": "", "text": "扉に入る"},
        { "location": "974/ACT"   , "narrator": "", "text": "扉に入る"},
        { "location": "978/SEL"   , "narrator": "", "text": "！？"},
        { "location": "979/ACT"   , "narrator": "", "text": "！？"},
        { "location": "38/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月30日　 2:20 PM</color>\n合宿終了の日、帰りの電車内でのこと"},
        { "location": "40/DIALOG" , "narrator": "YES_NO", "text": "共通エピソード部分を\n飛ばしますか？"},
        { "location": "412/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "414/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "416/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "418/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "420/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "496/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:SeekSector】</color>\nココロの扉を検索します。\n検索コマンドを入力_?"},
        { "location": "509/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:SeekExtSector】</color>\nココロの扉を外部接続します。\nアドレス入力？"},
        { "location": "527/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:SeekSector】</color>\nOpenProcess…"},
        { "location": "598/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)"},
        { "location": "695/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)"},
        { "location": "721/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Alert】</color>\nEmpty(0)."}
    ]
