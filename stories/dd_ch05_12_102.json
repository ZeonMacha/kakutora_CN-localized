{
    "dir": "chap12/daydra/dd_ch05_12_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "12505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "つばめさんを○したい？＜後編＞"
    },
    "entry":
    [
        { "location": "2497/TALK"  , "narrator": "神楽", "text": "…っ！？"},
        { "location": "2498/TALK"  , "narrator": "神楽", "text": "いけない。\n一瞬だけど意識が\n飛んでたみたい…。"},
        { "location": "2499/TALK"  , "narrator": "神楽", "text": "そ、そうだ！\n音羽を――！！"},
        { "location": "2507/TALK"  , "narrator": "透明神楽", "text": "…あれ？"},
        { "location": "2508/TALK"  , "narrator": "透明神楽", "text": "なにか、話してる？"},
        { "location": "2509/TALK"  , "narrator": "透明つばめ", "text": "今日はね、わたし、\n半分お休みなの。"},
        { "location": "2510/TALK"  , "narrator": "透明つばめ", "text": "でも、部屋の片付けも\nしなきゃだし…。"},
        { "location": "2511/TALK"  , "narrator": "透明神楽", "text": "…どういうこと？"},
        { "location": "2512/TALK"  , "narrator": "透明神楽", "text": "音羽を、傷つけに\n来たんじゃなかったの？"},
        { "location": "2513/TALK"  , "narrator": "透明つばめ", "text": "この間の浴衣の陰干しも\nあるし、やること沢山…。"},
        { "location": "2514/TALK"  , "narrator": "透明神楽", "text": "…なによ、これ。"},
        { "location": "2515/TALK"  , "narrator": "透明神楽", "text": "どうして、あんなに優しく\n話しかけてるの？"},
        { "location": "2516/TALK"  , "narrator": "透明神楽", "text": "音羽をあんな風にしたのは、\nつばめさんなのに。"},
        { "location": "2517/TALK"  , "narrator": "透明神楽", "text": "それなのに、どうして…。"},
        { "location": "2518/TALK"  , "narrator": "透明つばめ", "text": "…あれ？"},
        { "location": "2538/TALK"  , "narrator": "つばめ", "text": "卯月さん。"},
        { "location": "2540/TALK"  , "narrator": "神楽", "text": "っ！？"},
        { "location": "2541/TALK"  , "narrator": "神楽", "text": "いけない、\n見つかっちゃった！！"},
        { "location": "2542/TALK"  , "narrator": "神楽", "text": "なにか…何か言わないと。\nえっと…。"},
        { "location": "2545/TALK"  , "narrator": "神楽", "text": "…カフェにでも\n行きませんか？"},
        { "location": "2562/TALK"  , "narrator": "神楽", "text": "はぁ…。"},
        { "location": "2563/TALK"  , "narrator": "神楽", "text": "…一応、伝えておいた方が\nいいのかな…。"},
        { "location": "2575/TALK"  , "narrator": "神楽", "text": "こんばんは"},
        { "location": "2576/TALK"  , "narrator": "神楽", "text": "ちょっといいですか？"},
        { "location": "2579/SEL"   , "narrator": "", "text": "つばめと何かあったんだね？"},
        { "location": "2580/ACT"   , "narrator": "", "text": "つばめと何かあったんだね？"},
        { "location": "2582/TALK"  , "narrator": "神楽", "text": "全部お見通しですか"},
        { "location": "2584/TALK"  , "narrator": "神楽", "text": "それとも"},
        { "location": "2585/TALK"  , "narrator": "神楽", "text": "こうなることも最初から知ってたとか？"},
        { "location": "2587/SEL"   , "narrator": "", "text": "なんのことだか？"},
        { "location": "2588/ACT"   , "narrator": "", "text": "なんのことだか？"},
        { "location": "2590/TALK"  , "narrator": "神楽", "text": "だと思いました"},
        { "location": "2592/TALK"  , "narrator": "神楽", "text": "とにかく"},
        { "location": "2593/TALK"  , "narrator": "神楽", "text": "一応伝えておきます"},
        { "location": "2594/TALK"  , "narrator": "神楽", "text": "今度つばめさんと一緒に"},
        { "location": "2595/TALK"  , "narrator": "神楽", "text": "秋葉原に行くことになりました"},
        { "location": "2598/TALK"  , "narrator": "神楽", "text": "あの街には"},
        { "location": "2599/TALK"  , "narrator": "神楽", "text": "私の大好きなお店も沢山あって"},
        { "location": "2600/TALK"  , "narrator": "神楽", "text": "そこにつばめさんも"},
        { "location": "2601/TALK"  , "narrator": "神楽", "text": "連れて行こうと思って"},
        { "location": "2603/SEL"   , "narrator": "", "text": "どうしてそう思ったわけ？"},
        { "location": "2604/SEL"   , "narrator": "", "text": "一緒に遊びたかったの？"},
        { "location": "2605/ACT"   , "narrator": "", "text": "どうしてそう思ったわけ？"},
        { "location": "2606/TALK"  , "narrator": "神楽", "text": "どうしてって"},
        { "location": "2607/TALK"  , "narrator": "神楽", "text": "それは"},
        { "location": "2608/ACT"   , "narrator": "", "text": "一緒に遊びたかったの？"},
        { "location": "2610/TALK"  , "narrator": "神楽", "text": "遊びたいわけじゃなくて"},
        { "location": "2611/TALK"  , "narrator": "神楽", "text": "その"},
        { "location": "2615/TALK"  , "narrator": "神楽", "text": "興味が出てきたんです"},
        { "location": "2616/TALK"  , "narrator": "神楽", "text": "つばめさんの素顔に"},
        { "location": "2619/TALK"  , "narrator": "神楽", "text": "私がいつも見ているつばめさんは"},
        { "location": "2620/TALK"  , "narrator": "神楽", "text": "可愛くて優しい子です"},
        { "location": "2621/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "2622/TALK"  , "narrator": "神楽", "text": "ドームで見せたあの冷徹な顔"},
        { "location": "2623/TALK"  , "narrator": "神楽", "text": "あれもつばめさんです"},
        { "location": "2627/TALK"  , "narrator": "神楽", "text": "あの時見せた冷徹な顔はなんだったのか？"},
        { "location": "2628/TALK"  , "narrator": "神楽", "text": "知らなくても任務は達成できると思うんです"},
        { "location": "2629/TALK"  , "narrator": "神楽", "text": "でもそうなったら"},
        { "location": "2630/TALK"  , "narrator": "神楽", "text": "絶対に後悔すると思うから"},
        { "location": "2633/TALK"  , "narrator": "神楽", "text": "それに"},
        { "location": "2634/TALK"  , "narrator": "神楽", "text": "もしも冷徹なつばめさんが本当で"},
        { "location": "2635/TALK"  , "narrator": "神楽", "text": "優しいつばめさんが演技だとしたら"},
        { "location": "2636/TALK"  , "narrator": "神楽", "text": "音羽が浮かばれません"},
        { "location": "2637/TALK"  , "narrator": "神楽", "text": "あんな酷いことしておきながら"},
        { "location": "2638/TALK"  , "narrator": "神楽", "text": "記憶がないフリをして"},
        { "location": "2639/TALK"  , "narrator": "神楽", "text": "優しく話しかけていたなんて"},
        { "location": "2642/TALK"  , "narrator": "神楽", "text": "だから"},
        { "location": "2643/TALK"  , "narrator": "神楽", "text": "本当はどうなのか？"},
        { "location": "2644/TALK"  , "narrator": "神楽", "text": "それを知るヒントでもいいから探り出したいんです"},
        { "location": "2646/SEL"   , "narrator": "", "text": "知ったら辛くなるかも"},
        { "location": "2647/SEL"   , "narrator": "", "text": "てか、まだ演技だと疑ってるの？"},
        { "location": "2648/ACT"   , "narrator": "", "text": "知ったら辛くなるかも"},
        { "location": "2649/TALK"  , "narrator": "神楽", "text": "今でも辛いです"},
        { "location": "2650/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "2651/TALK"  , "narrator": "神楽", "text": "知っても知らなくても辛いなら"},
        { "location": "2652/TALK"  , "narrator": "神楽", "text": "知って辛い方がマシ"},
        { "location": "2653/TALK"  , "narrator": "神楽", "text": "そう考えて"},
        { "location": "2654/TALK"  , "narrator": "神楽", "text": "そう決めたです"},
        { "location": "2655/ACT"   , "narrator": "", "text": "てか、まだ演技だと疑ってるの？"},
        { "location": "2656/TALK"  , "narrator": "神楽", "text": "演技じゃないという結論が出てない以上"},
        { "location": "2657/TALK"  , "narrator": "神楽", "text": "疑うのは当然です"},
        { "location": "2658/TALK"  , "narrator": "神楽", "text": "疑わないっていうのは"},
        { "location": "2659/TALK"  , "narrator": "神楽", "text": "うやむやにするのと同じだし"},
        { "location": "2660/TALK"  , "narrator": "神楽", "text": "それだけは絶対イヤなんです"},
        { "location": "2662/TALK"  , "narrator": "神楽", "text": "だから任務遂行のタイムリミットまでに"},
        { "location": "2663/TALK"  , "narrator": "神楽", "text": "その真相を明かしたいんです"},
        { "location": "2664/TALK"  , "narrator": "神楽", "text": "そうすれば"},
        { "location": "2665/TALK"  , "narrator": "神楽", "text": "私は"},
        { "location": "2669/SEL"   , "narrator": "", "text": "任務に集中できる？"},
        { "location": "2670/SEL"   , "narrator": "", "text": "つばめを破壊しない方法を探せる？"},
        { "location": "2671/ACT"   , "narrator": "", "text": "任務に集中できる？"},
        { "location": "2673/TALK"  , "narrator": "神楽", "text": "そうです"},
        { "location": "2674/TALK"  , "narrator": "神楽", "text": "そういうことです"},
        { "location": "2685/TALK"  , "narrator": "神楽", "text": "…そうよ。\nこれは、任務に集中する\nために必要なこと…。"},
        { "location": "2686/TALK"  , "narrator": "神楽", "text": "それだけよ。\nそれ以外の理由なんて…。"},
        { "location": "2687/TALK"  , "narrator": "神楽", "text": "…ないんだから。"},
        { "location": "2688/ACT"   , "narrator": "", "text": "つばめを破壊しない方法を探せる？"},
        { "location": "2700/TALK"  , "narrator": "神楽", "text": "…つばめさんを\n破壊しない方法、か。"},
        { "location": "2701/TALK"  , "narrator": "神楽", "text": "…バカみたい。"},
        { "location": "2703/TALK"  , "narrator": "神楽", "text": "夢みたいなことばかり\n言って、どこまで私を\n混乱させるつもりなの…？"},
        { "location": "2704/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2705/TALK"  , "narrator": "神楽", "text": "でも…もし本当に、\nそんな方法があったら…。"},
        { "location": "2706/TALK"  , "narrator": "神楽", "text": "私…私は、\nどうすれば…。"},
        { "location": "2709/TALK"  , "narrator": "神楽", "text": "…本当、バカみたい。"},
        { "location": "2710/TALK"  , "narrator": "神楽", "text": "そんな無駄な期待、\nしない方がいいに\n決まってるわ。"},
        { "location": "2711/TALK"  , "narrator": "神楽", "text": "そんな都合のいい方法が、\n上手く見つかるはずないん\nだから…。"},
        { "location": "2721/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【10 江戸川橋物語】"},
        { "location": "2733/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【10 江戸川橋物語】"}
    ]
}
