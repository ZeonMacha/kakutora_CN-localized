{
    "dir": "chap23/daydra/dd_ch05_23_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "23502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "パーフェクト撤退＜前編＞"
    },
    "entry":
    [
        { "location": "1893/TALK"  , "narrator": "パイロット", "text": "目標地点へ\n到着しましたが…。"},
        { "location": "1894/TALK"  , "narrator": "パイロット", "text": "フェノメノンの発生を\n確認したため、\n着陸は危険です！"},
        { "location": "1896/TALK"  , "narrator": "千羽鶴", "text": "ええ、わかってる。\n着陸の必要はない。"},
        { "location": "1897/TALK"  , "narrator": "千羽鶴", "text": "このまま三戸浜付近を\n周回しつつ待機。"},
        { "location": "1898/TALK"  , "narrator": "パイロット", "text": "了解しました。"},
        { "location": "1900/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "1901/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめが\n卯月神楽に破壊された\nその瞬間に――"},
        { "location": "1902/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめを\n爆心地として、\nこの世界は変わる…。"},
        { "location": "1904/TALK"  , "narrator": "千羽鶴", "text": "…この時、日本という\nフェノメノンを\n構成する欠片が。"},
        { "location": "1905/TALK"  , "narrator": "千羽鶴", "text": "破壊されたときに、\nどうなってしまうのか。"},
        { "location": "1906/TALK"  , "narrator": "千羽鶴", "text": "私と逢瀬つばめ…。\n正確には、\n私とカレン。"},
        { "location": "1907/TALK"  , "narrator": "千羽鶴", "text": "クラン二人が\n互いのパワーを\n拮抗させつつ…。"},
        { "location": "1908/TALK"  , "narrator": "千羽鶴", "text": "一つの世界を保つ\nなんていうのは、\n前例のないこと。"},
        { "location": "1909/TALK"  , "narrator": "千羽鶴", "text": "故に、一方が一瞬で\n崩壊した際に、\nなにが起こるのか？"},
        { "location": "1911/TALK"  , "narrator": "千羽鶴", "text": "もしかしたら、\n私の力が暴走する\nという可能性もある。"},
        { "location": "1912/TALK"  , "narrator": "千羽鶴", "text": "…予測できない以上、\nその瞬間にどうなって\nしまうのかを…。"},
        { "location": "1913/TALK"  , "narrator": "千羽鶴", "text": "しっかりと、\n目視することが重要。"},
        { "location": "1914/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽の回収は、\n必要ない…。"},
        { "location": "1921/TALK"  , "narrator": "オペレーター", "text": "長官。\nフェノメノン警報を\n発令しました。"},
        { "location": "1922/TALK"  , "narrator": "千羽鶴", "text": "そう…ありがと。"},
        { "location": "1925/TALK"  , "narrator": "千羽鶴", "text": "…思ったよりも\n早く発令されたけど、\n仕方ない…。"},
        { "location": "1926/SEL"   , "narrator": "", "text": "どうして警報を発動したの？"},
        { "location": "1927/ACT"   , "narrator": "", "text": "どうして警報を発動したの？"},
        { "location": "1938/TALK"  , "narrator": "千羽鶴", "text": "簡単なこと"},
        { "location": "1939/TALK"  , "narrator": "千羽鶴", "text": "もしも発動しなければ"},
        { "location": "1940/TALK"  , "narrator": "千羽鶴", "text": "怪しむ者が出てくるから"},
        { "location": "1941/TALK"  , "narrator": "千羽鶴", "text": "このフェノメノンは"},
        { "location": "1942/TALK"  , "narrator": "千羽鶴", "text": "あくまでも他のと同じ"},
        { "location": "1943/TALK"  , "narrator": "千羽鶴", "text": "一般的なフェノメノンでなくてはならない"},
        { "location": "1944/TALK"  , "narrator": "千羽鶴", "text": "発令までの時間は"},
        { "location": "1945/TALK"  , "narrator": "千羽鶴", "text": "これでも限界まで引き延ばした"},
        { "location": "1948/TALK"  , "narrator": "千羽鶴", "text": "ところで"},
        { "location": "1950/TALK"  , "narrator": "千羽鶴", "text": "貴方は誰？"},
        { "location": "1952/SEL"   , "narrator": "", "text": "$handle$です"},
        { "location": "1953/ACT"   , "narrator": "", "text": "$handle$です"},
        { "location": "1955/TALK"  , "narrator": "千羽鶴", "text": "私のアカウントは"},
        { "location": "1957/TALK"  , "narrator": "千羽鶴", "text": "貴方には教えていない"},
        { "location": "1958/TALK"  , "narrator": "千羽鶴", "text": "どうして知ってるの？"},
        { "location": "1961/SEL"   , "narrator": "", "text": "つばめから教えてもらったから"},
        { "location": "1962/ACT"   , "narrator": "", "text": "つばめから教えてもらったから"},
        { "location": "1965/SEL"   , "narrator": "", "text": "千羽鶴から教えてもらったから"},
        { "location": "1966/ACT"   , "narrator": "", "text": "千羽鶴から教えてもらったから"},
        { "location": "1969/TALK"  , "narrator": "千羽鶴", "text": "本当のことを言った方がいい"},
        { "location": "1970/TALK"  , "narrator": "千羽鶴", "text": "嘘は身を滅ぼす"},
        { "location": "1972/SEL"   , "narrator": "", "text": "本当だよ"},
        { "location": "1973/SEL"   , "narrator": "", "text": "じゃあ$me$は身を滅ぼさないね"},
        { "location": "1974/ACT"   , "narrator": "", "text": "本当だよ"},
        { "location": "1976/TALK"  , "narrator": "千羽鶴", "text": "確かに、否定するにも根拠がなさすぎる"},
        { "location": "1977/TALK"  , "narrator": "千羽鶴", "text": "けど"},
        { "location": "1978/ACT"   , "narrator": "", "text": "じゃあ$me$は身を滅ぼさないね"},
        { "location": "1979/TALK"  , "narrator": "千羽鶴", "text": "そう思いたければ"},
        { "location": "1980/TALK"  , "narrator": "千羽鶴", "text": "勝手に思っていればいい"},
        { "location": "1981/TALK"  , "narrator": "千羽鶴", "text": "けど"},
        { "location": "1982/TALK"  , "narrator": "千羽鶴", "text": "これだけは教えて"},
        { "location": "1984/TALK"  , "narrator": "千羽鶴", "text": "$handle$はどこの誰？"},
        { "location": "1985/TALK"  , "narrator": "千羽鶴", "text": "なんの目的があって"},
        { "location": "1986/TALK"  , "narrator": "千羽鶴", "text": "私にコンタクトを取ってるの？"},
        { "location": "1988/SEL"   , "narrator": "", "text": "それは明かせない"},
        { "location": "1989/ACT"   , "narrator": "", "text": "それは明かせない"},
        { "location": "1992/TALK"  , "narrator": "千羽鶴", "text": "まあいい"},
        { "location": "1993/TALK"  , "narrator": "千羽鶴", "text": "今回の件が終わったら"},
        { "location": "1994/TALK"  , "narrator": "千羽鶴", "text": "トレースして突き止めるから"},
        { "location": "1998/TALK"  , "narrator": "千羽鶴", "text": "…$handle$。\nいったい何者…？"},
        { "location": "2000/TALK"  , "narrator": "千羽鶴", "text": "…ん？"},
        { "location": "2001/TALK"  , "narrator": "千羽鶴", "text": "トライナリーが\n動き出したか…。\n思ったより早い。"},
        { "location": "2002/TALK"  , "narrator": "千羽鶴", "text": "まあ、近場だったから\n仕方がないけれど…。"},
        { "location": "2003/TALK"  , "narrator": "千羽鶴", "text": "彼女たちが中に入ると\nコトが複雑になる…。"},
        { "location": "2004/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "2006/TALK"  , "narrator": "千羽鶴", "text": "聞こえてる？\n予定を変更する。"},
        { "location": "2007/TALK"  , "narrator": "千羽鶴", "text": "リンクが完了次第、\nフェノメノン内部へ\n侵入して。"},
        { "location": "2008/TALK"  , "narrator": "パイロット", "text": "了解。"},
        { "location": "2012/TALK"  , "narrator": "アナウンス", "text": "これより当機は、\n“不確定状態”を\n通過いたします。"},
        { "location": "2013/TALK"  , "narrator": "アナウンス", "text": "“不確定状態”への\n到達までは、\nあと５分程を――"},
        { "location": "2020/SEL"   , "narrator": "", "text": "操作：機体とトライガジェットをコネクトする"},
        { "location": "2021/ACT"   , "narrator": "", "text": "操作：機体とトライガジェットをコネクトする"},
        { "location": "2024/TALK"  , "narrator": "アナウンス", "text": "トライガジェット\nTRI-X1\nリンク接続確認しました。"},
        { "location": "2025/TALK"  , "narrator": "アナウンス", "text": "セルフチェック完了。\n正常動作確認しました。"},
        { "location": "2026/TALK"  , "narrator": "アナウンス", "text": "定刻通りフェノメノンへ\n突入します。"},
        { "location": "2029/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "2030/TALK"  , "narrator": "千羽鶴", "text": "…いよいよね。"},
        { "location": "2031/TALK"  , "narrator": "千羽鶴", "text": "これが上手くいけば、\n全て上手くいく。"},
        { "location": "2032/TALK"  , "narrator": "千羽鶴", "text": "ここでの成功は、\n世界の為になる。"},
        { "location": "2033/TALK"  , "narrator": "アナウンス", "text": "不確定量子雲へ\n進入します。"},
        { "location": "2034/TALK"  , "narrator": "アナウンス", "text": "搭乗者は衝撃に\n備えてください"},
        { "location": "2035/TALK"  , "narrator": "千羽鶴", "text": "――ッ！！"},
        { "location": "2078/TALK"  , "narrator": "月神楽　", "text": "というわけで。"},
        { "location": "2079/TALK"  , "narrator": "月神楽　", "text": "私たちが見送れるのは\nここまでです。"},
        { "location": "2080/TALK"  , "narrator": "月神楽　", "text": "ここから先は、\n卯月神楽の心ではなく――"},
        { "location": "2081/TALK"  , "narrator": "月神楽　", "text": "Redinessによって\n接続された、\n量子サーバーですからね。"},
        { "location": "2082/TALK"  , "narrator": "ぴょんこ", "text": "はい。\nありがとうございます！"},
        { "location": "2085/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんっ！"},
        { "location": "2086/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは、\n頑張りますっ！"},
        { "location": "2087/TALK"  , "narrator": "ぴょんこ", "text": "必ず接続を元通りにして\n戻って来ますね！"},
        { "location": "2088/SEL"   , "narrator": "", "text": "頑張って！"},
        { "location": "2089/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2090/ACT"   , "narrator": "", "text": "頑張って！"},
        { "location": "2092/TALK"  , "narrator": "ぴょんこ", "text": "はいっ！"},
        { "location": "2093/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2098/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "2099/TALK"  , "narrator": "ぴょんこ", "text": "出がけに言ってくれて\nありがとうございますっ！"},
        { "location": "2100/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこも、\n$handle$さんが\n大好きですっ！"},
        { "location": "2102/TALK"  , "narrator": "ぴょんこ", "text": "それでは、\nぴょんこは\n行ってまいります！"},
        { "location": "2103/TALK"  , "narrator": "ぴょんこ", "text": "あっ！"},
        { "location": "2104/SEL"   , "narrator": "", "text": "？"},
        { "location": "2105/ACT"   , "narrator": "", "text": "？"},
        { "location": "2107/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこ、落ち着いたら\n$handle$さんに、\nお手紙書きますから！"},
        { "location": "2108/SEL"   , "narrator": "", "text": "楽しみにしてるよ"},
        { "location": "2109/ACT"   , "narrator": "", "text": "楽しみにしてるよ"},
        { "location": "2111/TALK"  , "narrator": "ぴょんこ", "text": "ホントに、\nいっぱいいっぱい、\n書きますんで！！"},
        { "location": "2112/TALK"  , "narrator": "月神楽　", "text": "いや、もういいから\n行ってください。"},
        { "location": "2113/TALK"  , "narrator": "ぴょんこ", "text": "じゃあ、\n今度こそ本当に――"},
        { "location": "2114/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんと\n全ての私に\n素敵なココロの旅を！"},
        { "location": "2128/TALK"  , "narrator": "月神楽　", "text": "ふぅ……。\n行っちゃいましたね。"},
        { "location": "2129/SEL"   , "narrator": "", "text": "なんか寂しい"},
        { "location": "2130/SEL"   , "narrator": "", "text": "ぴょんこ弱いのに、大丈夫かな……"},
        { "location": "2131/ACT"   , "narrator": "", "text": "なんか寂しい"},
        { "location": "2132/TALK"  , "narrator": "月神楽　", "text": "空蝉の\nむなしき恋に\n身をやかへてむ。"},
        { "location": "2133/TALK"  , "narrator": "月神楽　", "text": "$handle$さんは、\n寂しがりやさん\nなんですね。"},
        { "location": "2134/TALK"  , "narrator": "月神楽　", "text": "まあ、どうせ\nすぐに戻って来ますよ。"},
        { "location": "2135/ACT"   , "narrator": "", "text": "ぴょんこ弱いのに、大丈夫かな……"},
        { "location": "2136/TALK"  , "narrator": "月神楽　", "text": "ああ…、あれは\n仕方ないんですよ。"},
        { "location": "2137/TALK"  , "narrator": "月神楽　", "text": "彼女のパワーの殆どは\nミサミサから\nもらっていましたから。"},
        { "location": "2138/TALK"  , "narrator": "月神楽　", "text": "本来の力を持てば、\nかなり強い――"},
        { "location": "2154/TALK"  , "narrator": "月神楽　", "text": "は！？"},
        { "location": "2155/TALK"  , "narrator": "ぴょんこ", "text": "ぴょーん！！"},
        { "location": "2156/TALK"  , "narrator": "月神楽　", "text": "何やってるんですか！"},
        { "location": "2158/TALK"  , "narrator": "ぴょんこ", "text": "どうしても１つ\n心残りの事があって！！"},
        { "location": "2159/SEL"   , "narrator": "", "text": "何！？"},
        { "location": "2160/SEL"   , "narrator": "", "text": "ま、まさか……"},
        { "location": "2161/ACT"   , "narrator": "", "text": "何！？"},
        { "location": "2163/TALK"  , "narrator": "ぴょんこ", "text": "キスチケ\nジャンケンで～すっ！！"},
        { "location": "2164/TALK"  , "narrator": "月神楽　", "text": "はぁぁぁ……"},
        { "location": "2165/SEL"   , "narrator": "", "text": "えっ…その為に戻って来たの！？"},
        { "location": "2166/ACT"   , "narrator": "", "text": "えっ…その為に戻って来たの！？"},
        { "location": "2168/TALK"  , "narrator": "ぴょんこ", "text": "もちのろんですよっ！"},
        { "location": "2169/ACT"   , "narrator": "", "text": "ま、まさか……"},
        { "location": "2171/TALK"  , "narrator": "ぴょんこ", "text": "キスチケ\nジャンケンで～すっ！！"},
        { "location": "2172/TALK"  , "narrator": "月神楽　", "text": "はぁぁぁ……"},
        { "location": "2173/SEL"   , "narrator": "", "text": "やはりな……"},
        { "location": "2174/ACT"   , "narrator": "", "text": "やはりな……"},
        { "location": "2177/TALK"  , "narrator": "ぴょんこ", "text": "さあ！\n時間無いんで！\n急いで！　急いで！！"},
        { "location": "2178/SEL"   , "narrator": "", "text": "お、おう、わかった！"},
        { "location": "2179/SEL"   , "narrator": "", "text": "どうせなら、昇華したぴょんこの姿でジャンケンとご褒美を……"},
        { "location": "2180/SEL"   , "narrator": "", "text": "遠慮します…"},
        { "location": "2181/ACT"   , "narrator": "", "text": "お、おう、わかった！"},
        { "location": "2182/TALK"  , "narrator": "ぴょんこ", "text": "よーぅし！\n負けませんよ～～っ！！"},
        { "location": "2183/ACT"   , "narrator": "", "text": "どうせなら、昇華したぴょんこの姿でジャンケンとご褒美を……"},
        { "location": "2186/TALK"  , "narrator": "ぴょんこ", "text": "あ～～～っ！！\nあぁぁぁぁ～～～っ！！"},
        { "location": "2187/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さん、\nそういうのが\n好きなんですね～～っ！"},
        { "location": "2188/TALK"  , "narrator": "ぴょんこ", "text": "そんな恐る恐る\n言わなくても、ぴょんこ\n軽蔑したりしませんよっ！"},
        { "location": "2189/TALK"  , "narrator": "ぴょんこ", "text": "むしろ、現実の私にも\n言っちゃいましょう！！"},
        { "location": "2190/TALK"  , "narrator": "ぴょんこ", "text": "ラブラブな関係なら、\nバッチやってくれると\n思うんで――"},
        { "location": "2192/ACT"   , "narrator": "", "text": "遠慮します…"},
        { "location": "2193/TALK"  , "narrator": "ぴょんこ", "text": "ぴょ～～～～ん……"},
        { "location": "2194/TALK"  , "narrator": "ぴょんこ", "text": "１回だけ！\n１回だけやって\nいきませんかっ？"},
        { "location": "2195/TALK"  , "narrator": "ぴょんこ", "text": "ほんと、\nジャンケンだけで\nいいんで！"},
        { "location": "2229/TALK"  , "narrator": "月神楽　", "text": "いや、お前さあ。"},
        { "location": "2230/TALK"  , "narrator": "ぴょんこ", "text": "あい……"},
        { "location": "2231/TALK"  , "narrator": "月神楽　", "text": "せっかく人が協力\nしてやって、見送りまで\nしてさぁ！"},
        { "location": "2232/TALK"  , "narrator": "月神楽　", "text": "あまつさえ\n寂しくなったね～～とか\n忍んでやってたのにさぁ！"},
        { "location": "2233/TALK"  , "narrator": "ぴょんこ", "text": "あい…すみません……"},
        { "location": "2234/TALK"  , "narrator": "月神楽　", "text": "なんなの？　これ！\nねえ！　なんなの！？"},
        { "location": "2235/SEL"   , "narrator": "", "text": "待って、$me$もぴょんことジャンケンしたいから"},
        { "location": "2236/SEL"   , "narrator": "", "text": "ぴょんこ、本当に早く行ってきなよ？"},
        { "location": "2237/ACT"   , "narrator": "", "text": "待って、$me$もぴょんことジャンケンしたいから"},
        { "location": "2239/TALK"  , "narrator": "月神楽　", "text": "はぁ～～。"},
        { "location": "2240/TALK"  , "narrator": "月神楽　", "text": "もう、好きにすれば？"},
        { "location": "2241/TALK"  , "narrator": "月神楽　", "text": "ちょっとラノベ\n読んでくるから、\n終わったら呼んで。"},
        { "location": "2252/TALK"  , "narrator": "ぴょんこ", "text": "ふふふ～～♪"},
        { "location": "2253/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんことジャンケン\nしてくれて、\nありがとうございます♪"},
        { "location": "2254/TALK"  , "narrator": "ぴょんこ", "text": "旅立つ前に\nしてもらえて\n本当に嬉しいです。"},
        { "location": "2255/SEL"   , "narrator": "", "text": "$me$も嬉しい"},
        { "location": "2256/SEL"   , "narrator": "", "text": "よかった"},
        { "location": "2257/ACT"   , "narrator": "", "text": "$me$も嬉しい"},
        { "location": "2259/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "2260/ACT"   , "narrator": "", "text": "よかった"},
        { "location": "2262/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、\n早速やりましょうっ！"},
        { "location": "2268/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\n今キスチケを\n１枚も持っていませんね。"},
        { "location": "2271/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\n今キスチケを\n$pyonko_kissticket$枚持ってますね。"},
        { "location": "2275/TALK"  , "narrator": "ぴょんこ", "text": "今、$handle$さんは\n$pyonko_kissticket$枚のキスチケを\n持っていますね♪"},
        { "location": "2277/TALK"  , "narrator": "ぴょんこ", "text": "3枚以上持っている間は\n何度でも特別なキッスが\n出来ちゃいますよっ！"},
        { "location": "2278/TALK"  , "narrator": "ぴょんこ", "text": "今回もどうですかっ！"},
        { "location": "2280/TALK"  , "narrator": "ぴょんこ", "text": "というわけで！\nおめでとうございます！"},
        { "location": "2281/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\nキスチケを3枚以上\n獲得してますので！"},
        { "location": "2282/TALK"  , "narrator": "ぴょんこ", "text": "今から特別なキッスを\n進呈しちゃいまーす♪"},
        { "location": "2285/SEL"   , "narrator": "", "text": "やったー！"},
        { "location": "2286/SEL"   , "narrator": "", "text": "今！？"},
        { "location": "2287/SEL"   , "narrator": "", "text": "今はそういう気分じゃないから、また今度で"},
        { "location": "2288/ACT"   , "narrator": "", "text": "やったー！"},
        { "location": "2289/ACT"   , "narrator": "", "text": "今！？"},
        { "location": "2290/TALK"  , "narrator": "ぴょんこ", "text": "今じゃなきゃ\nいつやるんですかっ！？"},
        { "location": "2291/TALK"  , "narrator": "ぴょんこ", "text": "今でしょ！"},
        { "location": "2292/SEL"   , "narrator": "", "text": "古くない？"},
        { "location": "2293/ACT"   , "narrator": "", "text": "古くない？"},
        { "location": "2295/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "2296/ACT"   , "narrator": "", "text": "今はそういう気分じゃないから、また今度で"},
        { "location": "2297/TALK"  , "narrator": "ぴょんこ", "text": "わかったぴょん。"},
        { "location": "2298/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこはいつでも\nオッケーですから、\n気が向いた時にどうぞ♪"},
        { "location": "2302/TALK"  , "narrator": "ぴょんこ", "text": "というわけで今回は、\n$handle$さんの\n好きな服で好きな所に！"},
        { "location": "2303/TALK"  , "narrator": "ぴょんこ", "text": "これからぴょんこは、\n今、現実の私が着てる服に\n着替えてきます♪"},
        { "location": "2304/TALK"  , "narrator": "ぴょんこ", "text": "いっぱい\n楽しんじゃって\nくださいねっ！"},
        { "location": "2314/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "2315/TALK"  , "narrator": "ぴょんこ", "text": "どうですかっ？\nそれでは――"},
        { "location": "2317/SEL"   , "narrator": "", "text": "頬、唇"},
        { "location": "2318/SEL"   , "narrator": "", "text": "胸"},
        { "location": "2319/SEL"   , "narrator": "", "text": "おなか"},
        { "location": "2320/ACT"   , "narrator": "", "text": "頬、唇"},
        { "location": "2324/ACT"   , "narrator": "", "text": "胸"},
        { "location": "2329/ACT"   , "narrator": "", "text": "おなか"},
        { "location": "2351/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "2354/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "2357/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "2360/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "2363/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "2366/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "2375/TALK"  , "narrator": "ぴょんこ", "text": "まさに\nメルティキッス♪"},
        { "location": "2377/TALK"  , "narrator": "ぴょんこ", "text": "温かくて\n柔らかい…。"},
        { "location": "2379/TALK"  , "narrator": "ぴょんこ", "text": "もっともっとー♪"},
        { "location": "2383/TALK"  , "narrator": "ぴょんこ", "text": "な、なんだか\n思ったよりも全然\nドキドキしますねっ！"},
        { "location": "2385/TALK"  , "narrator": "ぴょんこ", "text": "不思議と\n嫌じゃないぴょん♪"},
        { "location": "2387/TALK"  , "narrator": "ぴょんこ", "text": "かまかま～～♪"},
        { "location": "2391/TALK"  , "narrator": "ぴょんこ", "text": "おなかって……\nキスされると\nくすぐったいんですねっ…"},
        { "location": "2393/TALK"  , "narrator": "ぴょんこ", "text": "デリケートなので\n優しくしてくださいねっ！"},
        { "location": "2395/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんぴょん♪"},
        { "location": "2398/SEL"   , "narrator": "", "text": "もう一度"},
        { "location": "2399/SEL"   , "narrator": "", "text": "もうやめる"},
        { "location": "2400/ACT"   , "narrator": "", "text": "もう一度"},
        { "location": "2402/ACT"   , "narrator": "", "text": "もうやめる"},
        { "location": "2420/TALK"  , "narrator": "ぴょんこ", "text": "はぁっ。\n想像以上に\n恥ずかしいですね……。"},
        { "location": "2421/TALK"  , "narrator": "ぴょんこ", "text": "でも、とっても\n素敵な時間でした♪"},
        { "location": "2422/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこはいつでも\nオッケーですから、\nまたしましょうね♪"},
        { "location": "2429/TALK"  , "narrator": "ぴょんこ", "text": "というわけで！\nジャンケンしましょう、\nジャンケン♪"},
        { "location": "2432/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、\nいきますよっ！"},
        { "location": "2434/TALK"  , "narrator": "ぴょんこ", "text": "と思いましたけど、\n既に事後でしたね…。"},
        { "location": "2456/TALK"  , "narrator": "ぴょんこ", "text": "ふわぁっ！\n負けちゃいました…。"},
        { "location": "2460/TALK"  , "narrator": "ぴょんこ", "text": "約束通り、\nキスチケ１枚進呈ぴょん♪"},
        { "location": "2466/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの\n勝ちでーすっ♪"},
        { "location": "2467/TALK"  , "narrator": "ぴょんこ", "text": "約束通り、\nキスチケ１枚没収ぴょん♪"},
        { "location": "2472/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの\n勝ちでーすっ♪"},
        { "location": "2473/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\nプレゼントはナシ！！"},
        { "location": "2479/TALK"  , "narrator": "ぴょんこ", "text": "ふぅ……\nとっても楽しかったです♪"},
        { "location": "2483/TALK"  , "narrator": "ぴょんこ", "text": "って！\nああっ！！"},
        { "location": "2484/TALK"  , "narrator": "ぴょんこ", "text": "おめでとうございます！\nキスチケ３枚以上\nゲットしちゃいましたね♪"},
        { "location": "2485/TALK"  , "narrator": "ぴょんこ", "text": "というわけで！\n早速今から特別なキッスを\n進呈しちゃいまーす♪"},
        { "location": "2492/TALK"  , "narrator": "ぴょんこ", "text": "本当に、\n最後までつき合ってくれて\nありがとうございました！"},
        { "location": "2493/TALK"  , "narrator": "ぴょんこ", "text": "この続きは、\nぴょんこが帰ってきてから\nまたやりましょうねっ♪"},
        { "location": "2494/SEL"   , "narrator": "", "text": "楽しみにしてるよ"},
        { "location": "2495/SEL"   , "narrator": "", "text": "それ死亡フラグ"},
        { "location": "2496/ACT"   , "narrator": "", "text": "楽しみにしてるよ"},
        { "location": "2497/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "2498/ACT"   , "narrator": "", "text": "それ死亡フラグ"},
        { "location": "2499/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこに\n死亡フラグなどという\nフラグは無いのです♪"},
        { "location": "2501/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、\n改めて……。"},
        { "location": "2502/TALK"  , "narrator": "ぴょんこ", "text": "私と$handle$さん、\nそしてミサミサにとって\n素敵なココロの旅を♪"},
        { "location": "2511/ACT"   , "narrator": "", "text": "ぴょんこ、本当に早く行ってきなよ？"},
        { "location": "2512/TALK"  , "narrator": "月神楽　", "text": "ほらぁ！\n$handle$さんも\nそう言ってるし！"},
        { "location": "2513/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん……。"},
        { "location": "2537/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、\n$handle$さん――"},
        { "location": "2538/TALK"  , "narrator": "ぴょんこ", "text": "改めて、\n行ってきます。"},
        { "location": "2539/SEL"   , "narrator": "", "text": "頑張って！"},
        { "location": "2540/ACT"   , "narrator": "", "text": "頑張って！"},
        { "location": "2542/TALK"  , "narrator": "ぴょんこ", "text": "はいっ♪"},
        { "location": "2543/TALK"  , "narrator": "ぴょんこ", "text": "戻って来たら、今度こそ\nキスチケジャンケン\nしてくださいね？"},
        { "location": "2544/TALK"  , "narrator": "月神楽　", "text": "いいから\nはよ行きなさいよ。"},
        { "location": "2545/TALK"  , "narrator": "ぴょんこ", "text": "ぴょ…。"},
        { "location": "2546/TALK"  , "narrator": "ぴょんこ", "text": "それでは、\n卯月ぴょんこ、\n行って参りますっ！！"},
        { "location": "2547/TALK"  , "narrator": "ぴょんこ", "text": "私と$handle$さん、\nそしてミサミサにとって\n素敵なココロの旅を♪"},
        { "location": "2572/TALK"  , "narrator": "月神楽", "text": "あら、お帰りなさい。\nもう終わったんですか？"},
        { "location": "2574/TALK"  , "narrator": "月神楽", "text": "はぁ…本当に、\n騒がしい子ですよね。"},
        { "location": "2576/SEL"   , "narrator": "", "text": "え？　なにその格好！"},
        { "location": "2577/ACT"   , "narrator": "", "text": "え？　なにその格好！"},
        { "location": "2579/TALK"  , "narrator": "月神楽", "text": "何って――"},
        { "location": "2580/TALK"  , "narrator": "月神楽", "text": "これが私の\n正装ですし……。"},
        { "location": "2581/TALK"  , "narrator": "月神楽", "text": "というわけで、\n改めて自己紹介を\nさせてくださいね？"},
        { "location": "2582/TALK"  , "narrator": "月神楽", "text": "わたしの名前は\n月神楽と申します。"},
        { "location": "2583/TALK"  , "narrator": "月神楽", "text": "これから、あなたの為の\nココロの司書として\nお手伝い致します。"},
        { "location": "2584/TALK"  , "narrator": "月神楽", "text": "どうか、\n宜しくお願いしますね。"},
        { "location": "2585/SEL"   , "narrator": "", "text": "よろしく"},
        { "location": "2586/SEL"   , "narrator": "", "text": "『卯』は何処かに忘れてきちゃったの？"},
        { "location": "2587/ACT"   , "narrator": "", "text": "よろしく"},
        { "location": "2588/TALK"  , "narrator": "月神楽", "text": "はい♪"},
        { "location": "2589/ACT"   , "narrator": "", "text": "「卯」は何処かに忘れてきちゃったの？"},
        { "location": "2590/TALK"  , "narrator": "月神楽", "text": "え？"},
        { "location": "2591/TALK"  , "narrator": "月神楽", "text": "何ですかそれ？"},
        { "location": "2592/TALK"  , "narrator": "月神楽", "text": "もしかして、『ちょっと\nハイセンスなダジャレ\n思いついちゃった』とか―"},
        { "location": "2593/TALK"  , "narrator": "月神楽", "text": "思ってたりしませんか？"},
        { "location": "2594/TALK"  , "narrator": "月神楽", "text": "それ、全っぜんっ！\n面白くないですから。"},
        { "location": "2595/SEL"   , "narrator": "", "text": "しょぼん"},
        { "location": "2596/SEL"   , "narrator": "", "text": "そういうつもりじゃ…"},
        { "location": "2597/ACT"   , "narrator": "", "text": "しょぼん"},
        { "location": "2599/TALK"  , "narrator": "月神楽", "text": "ふふふ～。"},
        { "location": "2600/ACT"   , "narrator": "", "text": "そういうつもりじゃ…"},
        { "location": "2601/TALK"  , "narrator": "月神楽", "text": "じゃあ、\nどういうつもりなんです？"},
        { "location": "2602/SEL"   , "narrator": "", "text": "本当に誤植かと思った"},
        { "location": "2603/SEL"   , "narrator": "", "text": "おしえないよ！！"},
        { "location": "2604/ACT"   , "narrator": "", "text": "本当に誤植かと思った"},
        { "location": "2605/TALK"  , "narrator": "月神楽", "text": "ふふふ～。"},
        { "location": "2606/TALK"  , "narrator": "月神楽", "text": "そういう天然なところ\n嫌いじゃないですよ？"},
        { "location": "2607/ACT"   , "narrator": "", "text": "おしえないよ！！"},
        { "location": "2609/TALK"  , "narrator": "月神楽", "text": "そうですか。"},
        { "location": "2610/TALK"  , "narrator": "月神楽", "text": "そうやって\n素直じゃないところ、\n興奮しちゃいます♪"},
        { "location": "2612/TALK"  , "narrator": "月神楽", "text": "どこまで責めたら\n従順になるのかしら。\nふふ～。"},
        { "location": "2617/TALK"  , "narrator": "月神楽", "text": "それでですね。"},
        { "location": "2618/TALK"  , "narrator": "月神楽", "text": "せっかく来ていただいたの\nですが、あいにく今回は\nイレギュラーですので。"},
        { "location": "2619/TALK"  , "narrator": "月神楽", "text": "卯月神楽の心の葛藤\nみたいなものは、\n無いんですよね。"},
        { "location": "2620/TALK"  , "narrator": "月神楽", "text": "ですから、もしよければ\n私の部屋で、\n親睦を深めませんか？"},
        { "location": "2621/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "2622/SEL"   , "narrator": "", "text": "だめ"},
        { "location": "2623/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "2626/TALK"  , "narrator": "月神楽", "text": "ありがとうございます♪"},
        { "location": "2627/TALK"  , "narrator": "月神楽", "text": "それでは、\n参りましょう♪"},
        { "location": "2629/ACT"   , "narrator": "", "text": "だめ"},
        { "location": "2630/TALK"  , "narrator": "月神楽", "text": "え？\nどうしてですか？"},
        { "location": "2631/SEL"   , "narrator": "", "text": "心に決めた人がいるんだ"},
        { "location": "2632/SEL"   , "narrator": "", "text": "ぴょんこ一筋なんだよ"},
        { "location": "2633/SEL"   , "narrator": "", "text": "怖い"},
        { "location": "2634/ACT"   , "narrator": "", "text": "心に決めた人がいるんだ"},
        { "location": "2635/TALK"  , "narrator": "月神楽", "text": "はあ。"},
        { "location": "2636/TALK"  , "narrator": "月神楽", "text": "部屋っていっても、\nわたしのホームアドレスに\n行くだけですよ？"},
        { "location": "2637/TALK"  , "narrator": "月神楽", "text": "あーっ。\n$handle$さん、\nヘンなこと考えました？"},
        { "location": "2639/TALK"  , "narrator": "月神楽", "text": "何考えちゃったんですか？\n教えてください♪"},
        { "location": "2640/SEL"   , "narrator": "", "text": "いや、いいです"},
        { "location": "2641/SEL"   , "narrator": "", "text": "月神楽に襲われるんじゃないかと！"},
        { "location": "2642/ACT"   , "narrator": "", "text": "いや、いいです"},
        { "location": "2643/TALK"  , "narrator": "月神楽", "text": "え～～～～っ。\n言えないくらい\n恥ずかしい事なんですか？"},
        { "location": "2644/TALK"  , "narrator": "月神楽", "text": "$handle$さんって\nそんな恥ずかしいこと\n考えちゃう人なんですね♪"},
        { "location": "2645/ACT"   , "narrator": "", "text": "月神楽に襲われるんじゃないかと！"},
        { "location": "2646/TALK"  , "narrator": "月神楽", "text": "きゃ～～～♪"},
        { "location": "2647/TALK"  , "narrator": "月神楽", "text": "そんなこと\nしませんよっ♪"},
        { "location": "2648/TALK"  , "narrator": "月神楽", "text": "それとも、実は\nされたい気持ちの\n裏返しだったりしません？"},
        { "location": "2649/SEL"   , "narrator": "", "text": "まさか！"},
        { "location": "2650/SEL"   , "narrator": "", "text": "…ちょっとだけ"},
        { "location": "2651/ACT"   , "narrator": "", "text": "まさか！"},
        { "location": "2652/TALK"  , "narrator": "月神楽", "text": "ふ～ん。"},
        { "location": "2653/TALK"  , "narrator": "月神楽", "text": "まあ、いいです♪"},
        { "location": "2654/ACT"   , "narrator": "", "text": "…ちょっとだけ"},
        { "location": "2657/TALK"  , "narrator": "月神楽", "text": "ふふふ～。"},
        { "location": "2658/TALK"  , "narrator": "月神楽", "text": "正直で素敵です♪"},
        { "location": "2659/TALK"  , "narrator": "月神楽", "text": "心に決めた人には、\nそのことはナイショに\nしておいてあげますね♪"},
        { "location": "2663/ACT"   , "narrator": "", "text": "ぴょんこ一筋なんだよ"},
        { "location": "2665/TALK"  , "narrator": "月神楽", "text": "キャー♪\nプラトニックなんですね！"},
        { "location": "2667/TALK"  , "narrator": "月神楽", "text": "でも、本当ですか？"},
        { "location": "2668/TALK"  , "narrator": "月神楽", "text": "そんなこと言っておいて、\n実は他にココロ決めた\n相手の人とか――"},
        { "location": "2669/TALK"  , "narrator": "月神楽", "text": "あまつさえ、結婚なんか\nしちゃったりしてる子が\nいたりしませんか？"},
        { "location": "2670/TALK"  , "narrator": "月神楽", "text": "調べれば、すぐに\nわかっちゃいますからね？"},
        { "location": "2671/SEL"   , "narrator": "", "text": "すみません、います"},
        { "location": "2672/SEL"   , "narrator": "", "text": "いません、ガチでぴょんこ一筋だよ"},
        { "location": "2673/ACT"   , "narrator": "", "text": "すみません、います"},
        { "location": "2675/TALK"  , "narrator": "月神楽", "text": "よしよし♪\n正直でよろしい♪"},
        { "location": "2676/ACT"   , "narrator": "", "text": "いません、ガチでぴょんこ一筋だよ"},
        { "location": "2678/TALK"  , "narrator": "月神楽", "text": "本当にぴょんこが\n好きなんですね。"},
        { "location": "2679/TALK"  , "narrator": "月神楽", "text": "でも、ぴょんこも\n私も全く同じですから。\n卯月神楽なんです♪"},
        { "location": "2680/SEL"   , "narrator": "", "text": "ぴょんこには美佐子が入ってるよ"},
        { "location": "2681/SEL"   , "narrator": "", "text": "神楽じゃなくて、ぴょんこがいいんだよ"},
        { "location": "2682/SEL"   , "narrator": "", "text": "確かにそうだけど"},
        { "location": "2683/ACT"   , "narrator": "", "text": "ぴょんこには美佐子が入ってるよ"},
        { "location": "2684/TALK"  , "narrator": "月神楽", "text": "あっ！\n察しました！"},
        { "location": "2685/TALK"  , "narrator": "月神楽", "text": "もしかして、\nママの方が\n好みだったり？"},
        { "location": "2686/TALK"  , "narrator": "月神楽", "text": "わかります～～～♪\nママ、綺麗ですもんね。"},
        { "location": "2687/TALK"  , "narrator": "月神楽", "text": "で、どうなんですか？\n私よりも、ママの方が\n好みだったりしません？"},
        { "location": "2688/SEL"   , "narrator": "", "text": "実はみさみさがドストライクです"},
        { "location": "2689/SEL"   , "narrator": "", "text": "神楽の方がいいに決まってる"},
        { "location": "2690/SEL"   , "narrator": "", "text": "どっちも違うよ"},
        { "location": "2691/ACT"   , "narrator": "", "text": "実はみさみさがドストライクです"},
        { "location": "2693/TALK"  , "narrator": "月神楽", "text": "ふふふ～。\n正直でいい子♪"},
        { "location": "2694/TALK"  , "narrator": "月神楽", "text": "安心してくださいね？\n今の発言は、月神楽と、\n貴方だけの秘密です♪"},
        { "location": "2695/ACT"   , "narrator": "", "text": "神楽の方がいいに決まってる"},
        { "location": "2697/TALK"  , "narrator": "月神楽", "text": "へぇ～、そうなんですね。"},
        { "location": "2698/TALK"  , "narrator": "月神楽", "text": "でも、それならやっぱり\nぴょんこじゃなくても、\n私でもいいですよね？"},
        { "location": "2699/ACT"   , "narrator": "", "text": "どっちも違うよ"},
        { "location": "2701/TALK"  , "narrator": "月神楽", "text": "ということは、必然的に\n貴方には誰も好きな人や\n心に決めた人はいないと。"},
        { "location": "2702/TALK"  , "narrator": "月神楽", "text": "ふ～～～～ん。"},
        { "location": "2703/TALK"  , "narrator": "月神楽", "text": "今度調べておきますね♪"},
        { "location": "2705/ACT"   , "narrator": "", "text": "神楽じゃなくて、ぴょんこがいいんだよ"},
        { "location": "2707/TALK"  , "narrator": "月神楽", "text": "あ～～、そうなんですね。\n察しました。"},
        { "location": "2708/TALK"  , "narrator": "月神楽", "text": "卯月神楽本体じゃなくて、\nぴょんこが\n好きなんですね。"},
        { "location": "2709/TALK"  , "narrator": "月神楽", "text": "はぁ～～～。"},
        { "location": "2710/TALK"  , "narrator": "月神楽", "text": "まあでも、\nそんなことはいいんです！"},
        { "location": "2711/ACT"   , "narrator": "", "text": "確かにそうだけど"},
        { "location": "2712/TALK"  , "narrator": "月神楽", "text": "ですよね～～っ♪"},
        { "location": "2713/TALK"  , "narrator": "月神楽", "text": "ならば、私だって同じ\n卯月神楽ですっ♪"},
        { "location": "2716/ACT"   , "narrator": "", "text": "怖い"},
        { "location": "2717/TALK"  , "narrator": "月神楽", "text": "え～～～～っ。"},
        { "location": "2718/TALK"  , "narrator": "月神楽", "text": "私が怖いんですか？"},
        { "location": "2719/TALK"  , "narrator": "月神楽", "text": "ということは、\n現実の神楽のことも\n怖いってことですよね？"},
        { "location": "2720/SEL"   , "narrator": "", "text": "それは違う"},
        { "location": "2721/SEL"   , "narrator": "", "text": "ちょっと怖いかも"},
        { "location": "2722/ACT"   , "narrator": "", "text": "それは違う"},
        { "location": "2723/TALK"  , "narrator": "月神楽", "text": "でもでも、私は0xですし\n0xは総体である卯月神楽に\n対する必要条件ですよ？"},
        { "location": "2724/TALK"  , "narrator": "月神楽", "text": "ですから、私が怖ければ\n卯月神楽という現実の\n彼女も同様に怖い筈です。"},
        { "location": "2725/ACT"   , "narrator": "", "text": "ちょっと怖いかも"},
        { "location": "2726/TALK"  , "narrator": "月神楽", "text": "ふふふ～。\n正直ですね♪"},
        { "location": "2727/TALK"  , "narrator": "月神楽", "text": "それが普通の感覚だと\n思いますよ？"},
        { "location": "2728/TALK"  , "narrator": "月神楽", "text": "卯月神楽って、ちょっと\n病んでそうだったり、怖い\nこと言ったりしますしね。"},
        { "location": "2732/TALK"  , "narrator": "月神楽", "text": "というわけで！"},
        { "location": "2733/TALK"  , "narrator": "月神楽", "text": "まあ細かいことは\nいろいろあると思いますが\nとりあえず行きましょか！"},
        { "location": "2734/SEL"   , "narrator": "", "text": "むー、ちょっとだけだよ？"},
        { "location": "2735/SEL"   , "narrator": "", "text": "いやいや行かないから！"},
        { "location": "2736/ACT"   , "narrator": "", "text": "むー、ちょっとだけだよ？"},
        { "location": "2738/TALK"  , "narrator": "月神楽", "text": "ふふ～～♪\n嬉しいですっ！"},
        { "location": "2739/TALK"  , "narrator": "月神楽", "text": "それじゃ早速\n参りましょう♪"},
        { "location": "2740/ACT"   , "narrator": "", "text": "いやいや行かないから！"},
        { "location": "2742/TALK"  , "narrator": "月神楽", "text": "そうですか。\nわかりました。"},
        { "location": "2754/SEL"   , "narrator": "", "text": "あれ？　どうしたの？"},
        { "location": "2755/ACT"   , "narrator": "", "text": "あれ？　どうしたの？"},
        { "location": "2757/TALK"  , "narrator": "月神楽", "text": "お仕事みたいですよ、\n$handle$さん。"},
        { "location": "2758/SEL"   , "narrator": "", "text": "仕事！？"},
        { "location": "2759/ACT"   , "narrator": "", "text": "仕事！？"},
        { "location": "2761/TALK"  , "narrator": "月神楽", "text": "クランの除去です。\n今、救援要請が来ました。"},
        { "location": "2762/TALK"  , "narrator": "月神楽", "text": "思考の矛盾によって\n混乱した幾つかの人格が、\nクラン化してるようです。"},
        { "location": "2763/TALK"  , "narrator": "月神楽", "text": "これはもしかすると、\nかなり早いうちに記憶の\n最適化が行われるかも。"},
        { "location": "2764/TALK"  , "narrator": "月神楽", "text": "いずれにせよ、\nお願い出来ますか？\n卯月神楽のために。"},
        { "location": "2765/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "2766/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "2768/TALK"  , "narrator": "月神楽", "text": "それでは、\nよろしくお願いします。"},
        { "location": "2769/TALK"  , "narrator": "月神楽", "text": "卯月神楽と\n$handle$さんに\n素敵なココロの旅を。"},
        { "location": "2794/TALK"  , "narrator": "月神楽", "text": "ようこそ、\n私の部屋へ♪"},
        { "location": "2795/SEL"   , "narrator": "", "text": "ちょ！　なんで寝てるの？"},
        { "location": "2796/SEL"   , "narrator": "", "text": "風邪引いたの？"},
        { "location": "2797/ACT"   , "narrator": "", "text": "ちょ！　なんで寝てるの？"},
        { "location": "2798/TALK"  , "narrator": "月神楽", "text": "え？\nなんでって……"},
        { "location": "2800/TALK"  , "narrator": "月神楽", "text": "$handle$さんは\n自分の家でゴロゴロしたり\nしないんですか～？"},
        { "location": "2801/SEL"   , "narrator": "", "text": "いや、しますけど…"},
        { "location": "2802/SEL"   , "narrator": "", "text": "拙者侍ゆえ家の中でゴロゴロなどせん"},
        { "location": "2803/ACT"   , "narrator": "", "text": "いや、しますけど…"},
        { "location": "2804/TALK"  , "narrator": "月神楽", "text": "ふふ～。\nじゃあ～♪"},
        { "location": "2805/ACT"   , "narrator": "", "text": "拙者侍ゆえ家の中でゴロゴロなどせん"},
        { "location": "2806/TALK"  , "narrator": "月神楽", "text": "じゃあ、初体験ですねっ♪"},
        { "location": "2808/ACT"   , "narrator": "", "text": "風邪引いたの？"},
        { "location": "2811/TALK"  , "narrator": "月神楽", "text": "そうなんです……。\nちょっと熱っぽくて。"},
        { "location": "2812/TALK"  , "narrator": "月神楽", "text": "だから――"},
        { "location": "2814/TALK"  , "narrator": "月神楽", "text": "こっちに来て。"},
        { "location": "2815/TALK"  , "narrator": "月神楽", "text": "一緒にゴロゴロしよ？"},
        { "location": "2816/SEL"   , "narrator": "", "text": "か～～ぐらちゃ～～～ん♪"},
        { "location": "2817/SEL"   , "narrator": "", "text": "いえ、ここでお話を聞くだけで大丈夫です"},
        { "location": "2818/ACT"   , "narrator": "", "text": "か～～ぐらちゃ～～～ん♪"},
        { "location": "2820/ACT"   , "narrator": "", "text": "いえ、ここでお話を聞くだけで大丈夫です"},
        { "location": "2825/TALK"  , "narrator": "月神楽", "text": "む？"},
        { "location": "2829/TALK"  , "narrator": "月神楽", "text": "はぁ～～～。"},
        { "location": "2830/TALK"  , "narrator": "月神楽", "text": "なんか、\nお仕事みたいですよ。\n$handle$さん。"},
        { "location": "2831/SEL"   , "narrator": "", "text": "仕事！？"},
        { "location": "2832/ACT"   , "narrator": "", "text": "仕事！？"},
        { "location": "2834/TALK"  , "narrator": "月神楽", "text": "クランの除去です。\n今、救援要請が来ました。"},
        { "location": "2835/TALK"  , "narrator": "月神楽", "text": "思考の矛盾によって\n混乱した幾つかの人格が、\nクラン化してるようです。"},
        { "location": "2836/TALK"  , "narrator": "月神楽", "text": "これはもしかすると、\nかなり早いうちに記憶の\n最適化が行われるかも。"},
        { "location": "2837/TALK"  , "narrator": "月神楽", "text": "いずれにせよ、\nお願い出来ますか？\n卯月神楽のために。"},
        { "location": "2838/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "2839/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "2842/TALK"  , "narrator": "月神楽", "text": "あ～あ……。\nお楽しみはまた今度。\nお預けですね。"},
        { "location": "2844/TALK"  , "narrator": "月神楽", "text": "それでは、\nよろしくお願いします。"},
        { "location": "2845/TALK"  , "narrator": "月神楽", "text": "卯月神楽と\n$handle$さんに\n素敵なココロの旅を。"},
