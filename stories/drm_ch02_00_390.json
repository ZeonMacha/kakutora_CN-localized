{
    "dir": "dramatics/daydra/drm_ch02_00_390.js",
    "type": "Episode",
    "info": {
        "story_id": "2039",
        "cid": "ayami",
        "title": "らぶとーく 第39話",
        "sub_title": "雨降って"
    },
    "entry":
    [
        { "location": "305/SCENARIO", "narrator": "", "text": "雨降って"},
        { "location": "317/TALK"    , "narrator": "アーヤ", "text": "んー…もう少し丸い方が\n可愛いかしら？"},
        { "location": "321/TALK"    , "narrator": "アーヤ", "text": "はーい。\n開いてるわよー。"},
        { "location": "326/TALK"    , "narrator": "ガブリエラ", "text": "遅くにごめん。\n寝てた？"},
        { "location": "328/TALK"    , "narrator": "アーヤ", "text": "ううん、もうしばらくは\n起きてるつもりだったわ。"},
        { "location": "329/TALK"    , "narrator": "ガブリエラ", "text": "そう…編み物中？"},
        { "location": "330/TALK"    , "narrator": "アーヤ", "text": "うん…まあね…。"},
        { "location": "331/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "333/TALK"    , "narrator": "アーヤ", "text": "それより、用事は？"},
        { "location": "335/TALK"    , "narrator": "ガブリエラ", "text": "あっ、うん…。\nルーズリーフが切れて、\n宿題が出来なくて…。"},
        { "location": "336/TALK"    , "narrator": "アーヤ", "text": "それなら机の上よ。\n少し多めに持って行って\nいいから。"},
        { "location": "339/TALK"    , "narrator": "ガブリエラ", "text": "…ありがと。"},
        { "location": "341/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "342/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "343/TALK"    , "narrator": "アーヤ", "text": "…ぬいぐるみよ。"},
        { "location": "344/TALK"    , "narrator": "アーヤ", "text": "ボランティアで使う\nぬいぐるみを作ってるの。"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "やっぱりね。\nそれって犬かしら？"},
        { "location": "347/TALK"    , "narrator": "アーヤ", "text": "犬の大工さん。\n森一番の大工さん、って\n設定なの。"},
        { "location": "349/TALK"    , "narrator": "ガブリエラ", "text": "相変わらず、子供向けの\n話をやるみたいね。"},
        { "location": "351/TALK"    , "narrator": "アーヤ", "text": "幼稚園で見せる劇だもの。\n当然でしょ？"},
        { "location": "352/TALK"    , "narrator": "ガブリエラ", "text": "そりゃそうよね。"},
        { "location": "353/TALK"    , "narrator": "ガブリエラ", "text": "…続けることにしたんだ？"},
        { "location": "354/TALK"    , "narrator": "アーヤ", "text": "…うん。\n色々あったけど、\nそういうことになったわ。"},
        { "location": "355/TALK"    , "narrator": "アーヤ", "text": "心配かけたわね。"},
        { "location": "357/TALK"    , "narrator": "ガブリエラ", "text": "べ、別に？\nそんなのしてないし。"},
        { "location": "358/TALK"    , "narrator": "ガブリエラ", "text": "…っていうか、それなら\n今度の劇はあたしにも\n見せなさいよ。"},
        { "location": "360/TALK"    , "narrator": "アーヤ", "text": "ついでに出演してくれる\nなら、考えてもいいわ。"},
        { "location": "362/TALK"    , "narrator": "ガブリエラ", "text": "それはもうお断りよ！"},
        { "location": "363/TALK"    , "narrator": "ガブリエラ", "text": "それじゃ、戻るわ。\nルーズリーフありがとね。"},
        { "location": "366/TALK"    , "narrator": "アーヤ", "text": "…そうだ。\n$handle$さんにも\n報告しておかないと。"},
        { "location": "378/TALK"    , "narrator": "アーヤ", "text": "$handle$さん"},
        { "location": "380/TALK"    , "narrator": "アーヤ", "text": "報告しておきたいことがあるの(*^o^*)"},
        { "location": "381/TALK"    , "narrator": "アーヤ", "text": "私達"},
        { "location": "382/TALK"    , "narrator": "アーヤ", "text": "ボランティアを続けることになったの＼(^O^)／"},
        { "location": "384/SEL"     , "narrator": "", "text": "本当に！？"},
        { "location": "385/ACT"     , "narrator": "", "text": "本当に！？"},
        { "location": "388/TALK"    , "narrator": "アーヤ", "text": "$handle$さんの助言のおかげよ(^ε^)-☆!!"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "みんなとしっかり話して"},
        { "location": "390/TALK"    , "narrator": "アーヤ", "text": "どうするか考えたら"},
        { "location": "391/TALK"    , "narrator": "アーヤ", "text": "みんな続けたいって言ってくれて"},
        { "location": "392/TALK"    , "narrator": "アーヤ", "text": "それなら"},
        { "location": "393/TALK"    , "narrator": "アーヤ", "text": "続けなくちゃ勿体ない！(>_<)"},
        { "location": "394/TALK"    , "narrator": "アーヤ", "text": "って決まったの"},
        { "location": "396/SEL"     , "narrator": "", "text": "よかったね"},
        { "location": "397/SEL"     , "narrator": "", "text": "心配してた"},
        { "location": "398/SEL"     , "narrator": "", "text": "$me$のおかけだよね！"},
        { "location": "399/ACT"     , "narrator": "", "text": "よかったね"},
        { "location": "401/TALK"    , "narrator": "アーヤ", "text": "雨降って地固まる"},
        { "location": "403/TALK"    , "narrator": "アーヤ", "text": "ってやつね(^^"},
        { "location": "404/ACT"     , "narrator": "", "text": "心配してた"},
        { "location": "405/TALK"    , "narrator": "アーヤ", "text": "心配かけちゃってた？"},
        { "location": "406/TALK"    , "narrator": "アーヤ", "text": "ごめんなさいm(_ _)m"},
        { "location": "407/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "408/TALK"    , "narrator": "アーヤ", "text": "もう平気よ"},
        { "location": "409/ACT"     , "narrator": "", "text": "$me$のおかけだよね！"},
        { "location": "412/TALK"    , "narrator": "アーヤ", "text": "そう無邪気に言えるって凄いわね"},
        { "location": "413/TALK"    , "narrator": "アーヤ", "text": "でも、実際そうだから"},
        { "location": "416/TALK"    , "narrator": "アーヤ", "text": "詳しい話はまた今度"},
        { "location": "417/TALK"    , "narrator": "アーヤ", "text": "ちょっと急ぎの作業中だから"},
        { "location": "418/TALK"    , "narrator": "アーヤ", "text": "今夜中に完成させたいの(>_<)"},
        { "location": "420/SEL"     , "narrator": "", "text": "頑張ってね"},
        { "location": "421/ACT"     , "narrator": "", "text": "頑張ってね"},
        { "location": "424/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "425/TALK"    , "narrator": "アーヤ", "text": "一言だけ"},
        { "location": "428/TALK"    , "narrator": "ボイスメール", "text": "ありがとう"},
        { "location": "456/TALK"    , "narrator": "アーヤ", "text": "ふぅ…。"},
        { "location": "457/TALK"    , "narrator": "アーヤ", "text": "…よし、頑張ろ！"},
        { "location": "315/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　10:55 PM</color>\nとある平日の夜、寮「とらいあんぐる」アーヤの部屋にて"},
        { "location": "440/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【ありがとう】</color>\nをゲットしました！"}
    ]
}
