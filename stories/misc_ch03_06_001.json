    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "05_003_きんいろの雲"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "みんなもっと"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "天気に気を付けなきゃいけないわ"},
        { "location": "36/SEL"    , "narrator": "", "text": "傘とか準備しなきゃいけないしね"},
        { "location": "37/SEL"    , "narrator": "", "text": "見ればわかると思うけど"},
        { "location": "38/SEL"    , "narrator": "", "text": "天気って乙女心みたいだものね"},
        { "location": "39/ACT"    , "narrator": "", "text": "傘とか準備しなきゃいけないしね"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "それもあるわね"},
        { "location": "43/ACT"    , "narrator": "", "text": "見ればわかると思うけど"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "今現在の天気だけじゃないのよ"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "その先の予報も大事なのよ"},
        { "location": "46/ACT"    , "narrator": "", "text": "天気って乙女心みたいだものね"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "そうねｖｖｖ"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "そんな部分もあるわねｖｖｖ"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "でも今言いたいのはそこじゃないのよ"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "現時点だと風向きやなんか"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "これから先の天気の情報って"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "戦闘ではとても大事な要素になってくるのよ"},
        { "location": "57/SEL"    , "narrator": "", "text": "え、そっち？"},
        { "location": "58/SEL"    , "narrator": "", "text": "本気なんだ"},
        { "location": "59/SEL"    , "narrator": "", "text": "さすが"},
        { "location": "60/ACT"    , "narrator": "", "text": "え、そっち？"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "そうよ"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "他に何があるのかしら？"},
        { "location": "63/ACT"    , "narrator": "", "text": "本気なんだ"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "当たり前でしょう"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "遊びじゃないのよ"},
        { "location": "66/ACT"    , "narrator": "", "text": "さすが"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "いやだわ"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "当たり前のことよ"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "屋外ってことは今のところないけれど"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "そうなった時のためにも"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "天気については気を配るべきだと思うのよね"},
        { "location": "74/SEL"    , "narrator": "", "text": "真幌に提案しよう"},
        { "location": "75/SEL"    , "narrator": "", "text": "アーヤに提案しよう"},
        { "location": "76/SEL"    , "narrator": "", "text": "新人に教えよう"},
        { "location": "77/ACT"    , "narrator": "", "text": "真幌に提案しよう"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "話をするのは"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "それが一番いいんでしょうね"},
        { "location": "81/ACT"    , "narrator": "", "text": "アーヤに提案しよう"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "まずはアーヤに言ってみて"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "そこからみんなにも言えばいいわよね"},
        { "location": "85/ACT"    , "narrator": "", "text": "新人に教えよう"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "え"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "そんなこと言っても"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "意味がよくわからないかもしれないわ"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "それはちょっと"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "やめておくわね"}
    ]
}
