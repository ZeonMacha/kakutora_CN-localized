{
    "dir": "chap08/daydra/dd_ch03_08_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "8352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "ガブリエラの知らない世界"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ガブリエラの知らない世界"},
        { "location": "20/TALK"   , "narrator": "アーヤ", "text": "…そういえば――"},
        { "location": "22/TALK"   , "narrator": "アーヤ", "text": "ギャヴィって、日本の\n食べ物で食べられない\nものはないの？"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "ええ、あたしの知る限り\nないわ。"},
        { "location": "25/TALK"   , "narrator": "ガブリエラ", "text": "納豆でも漬物でも\n刺身でも、何だって\n食べれるもの！"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "凄いわね…漬物って、\n私でも苦手なのが\nあるのに…。"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "ほほぅ、なかなか面白い\n話しゆうね。"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "ならガブちゃん、\n活き造りは食べたこと\nあるが？"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "イキヅクリ？\n聞いたことないわ。"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "やっぱしな…。\n外国の人間にはちっくと\nエグい料理やき。"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "どんな料理なの？"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "刺身にされながらも、\n生きて動いている魚を\n見ながら食べる料理や。"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "みやび！！\n冗談でも言って良いことと\n悪いことがあるでしょ！？"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "冗談やない。\n活き造りは昔から日本に\nある料理やき。"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "まさか、そんな料理が\nあるわけないじゃない。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "…でも、ちょっと気に\nなるかも。"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "ちょー気分悪い！"},
        { "location": "64/SEL"    , "narrator": "", "text": "何を怒ってるの？"},
        { "location": "65/ACT"    , "narrator": "", "text": "何を怒ってるの？"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "みやびが酷い冗談言ったのよ"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "魚を生きたままお刺身にして食べる"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "活き造りとかいう料理があるって"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "そんなのウソに決まってるわ"},
        { "location": "72/SEL"    , "narrator": "", "text": "いや、普通にあるよ"},
        { "location": "73/SEL"    , "narrator": "", "text": "酷い冗談だ、怒った方が良い"},
        { "location": "74/SEL"    , "narrator": "", "text": "踊り食いは知ってる？"},
        { "location": "75/ACT"    , "narrator": "", "text": "いや、普通にあるよ"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "まさか、本当に存在するの！？"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "あ、アーヤ！\n活き造りって料理、\n本当に存在するの！？"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "ええ、そこまで珍しい\nものではないわよ？"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "はぁ！？"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、何なのその\nおぞましさの塊みたいな\n料理！？"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "どうしてお刺身の状態に\nしてまで、魚を生かして\nおく必要があるのよ？"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "活きの良さを見せるために\n決まっとるがよ。"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "うん、今できたわ。\n見たくもないくらい\n苦手な和食が。"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "食べてみれば\nイメージ変わると\n思うんだけど…。"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "絶対食べないから！！"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "やっぱり、外国人の\nガブちゃんには\nちっくとキツ過ぎたか。"},
        { "location": "124/ACT"   , "narrator": "", "text": "酷い冗談だ、怒った方が良い"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとこれは酷過ぎるわ！"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "みやび、今回の冗談は\n笑えないし度を越してる\nしで、最低よ。"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "もう二度と活き造りの\n話はしないで。"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "でもギャヴィ、\n活き造りは――"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "アーヤ、えいから。"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "世の中には知らん方が\nえいこともあるんよ。"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "すまんな、ガブちゃん。\n性質の悪い冗談言うて。"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "わかればいいのよ。\nまったく…。"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "でもな、ガブちゃん。"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "本当にそんなイヤなら、\n絶対に検索せん方が\nえいよ。"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "そうね…。\n私もそう思うわ。"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "な、何よ？\nアーヤまでそんな\n反応しちゃって。"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "まさか、本当にそんな\n料理が存在するとか？"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "ううん、そんなのない！\nあるわけない！\nだから検索もしない！"},
        { "location": "166/ACT"   , "narrator": "", "text": "踊り食いは知ってる？"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "何だか、お行儀の悪い食べ方ね"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "本当にそんなのあるのかしら？"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "ねえ、踊り食いって\n知ってる？"},
        { "location": "182/TALK"  , "narrator": "アーヤ", "text": "ええ…、小さな魚を\n生きたまま飲み込む\n食べ方よね？"},
        { "location": "184/TALK"  , "narrator": "ガブリエラ", "text": "…は？"},
        { "location": "185/TALK"  , "narrator": "みやび", "text": "しょうゆとかポン酢に\nつけて、ちゅるんと\n飲み込むんよ。"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "和食の闇を\n知ってしまったわ。"},
        { "location": "192/TALK"  , "narrator": "みやび", "text": "別に闇でもなんでも\nないんやけどなぁ。"},
        { "location": "193/TALK"  , "narrator": "アーヤ", "text": "そこまで珍しい料理、\nってわけでもないん\nだけど…。"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "ていうか、それ料理とは\n言えないわよ！"},
        { "location": "18/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月14日　3:24 PM</color>\nＷＡＶＥ戦から5日後、アーヤの部屋にて。"},
        { "location": "118/DIALOG", "narrator": "Dialog_GEThimegoto_ch03", "text": "【身近にあるホラー】"}
    ]
}
