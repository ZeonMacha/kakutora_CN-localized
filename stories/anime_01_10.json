        "title": "001 アニメーション",
        "sub_title": "愛，ロボット"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第10話"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "今回も『ラブラブ\nちーちゃんゲーム』を\nやってく？　それとも――"},
        { "location": "51/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n逢瀬つばめの解説を\nするだけでいい？"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n國政綾水の解説を\nするだけでいい？"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\nガブリエラの解説を\nするだけでいい？"},
        { "location": "57/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n恋ヶ崎みやびの解説を\nするだけでいい？"},
        { "location": "59/SEL"    , "narrator": "", "text": "はい"},
        { "location": "60/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "61/ACT"    , "narrator": "", "text": "はい"},
        { "location": "63/TALK"   , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "65/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "66/TALK"   , "narrator": "千羽鶴", "text": "わかった。\nそれじゃもう１回\n同じ話をする。"},
        { "location": "74/TALK"   , "narrator": "千羽鶴", "text": "こんにちは。"},
        { "location": "75/TALK"   , "narrator": "千羽鶴", "text": "前回は珍しく\nラブラブトレーナーらしい\n仕事をしたと思う。"},
        { "location": "76/TALK"   , "narrator": "千羽鶴", "text": "したと思うのに！\nにもかかわらず！！"},
        { "location": "77/SEL"    , "narrator": "", "text": "どうしたの？"},
        { "location": "78/ACT"    , "narrator": "", "text": "どうしたの？"},
        { "location": "80/TALK"   , "narrator": "千羽鶴", "text": "私の上位クラスから\nこんな指示が来た。"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "Send.text =\n<color=green>今後は倍マシで\n語ってください</color>"},
        { "location": "86/TALK"   , "narrator": "千羽鶴", "text": "無理だから！"},
        { "location": "87/TALK"   , "narrator": "千羽鶴", "text": "私、語るのは嫌い。\n面倒くさいし。"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "そもそも\n倍マシの理由が嫌。"},
        { "location": "90/SEL"    , "narrator": "", "text": "どんな理由？"},
        { "location": "91/SEL"    , "narrator": "", "text": "『今、結構話題になってるんだけど知ってた？』って聞かれてたよね"},
        { "location": "92/ACT"    , "narrator": "", "text": "どんな理由？"},
        { "location": "93/TALK"   , "narrator": "千羽鶴", "text": "それは教えられない。"},
        { "location": "94/ACT"    , "narrator": "", "text": "『今、結構話題になってるんだけど知ってた？』って聞かれてたよね"},
        { "location": "96/TALK"   , "narrator": "千羽鶴", "text": "…！？"},
        { "location": "97/TALK"   , "narrator": "千羽鶴", "text": "何で知ってる？？"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "………。"},
        { "location": "101/TALK"  , "narrator": "千羽鶴", "text": "とにかく、今後こんな\n理不尽な要求を\nされないように――"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "貴方に嫌われるよう、\n最善を尽くす！"},
        { "location": "103/TALK"  , "narrator": "千羽鶴", "text": "その為の施策第一弾として\n恋愛ゲームを作ってみた。"},
        { "location": "104/SEL"   , "narrator": "", "text": "逆じゃない？"},
        { "location": "105/ACT"   , "narrator": "", "text": "逆じゃない？"},
        { "location": "107/TALK"  , "narrator": "千羽鶴", "text": "逆じゃない。\n私、知ってるもの。"},
        { "location": "108/TALK"  , "narrator": "千羽鶴", "text": "攻略が終わっちゃった子は\nさようなら。そうでしょ？"},
        { "location": "109/SEL"   , "narrator": "", "text": "確かに！"},
        { "location": "110/SEL"   , "narrator": "", "text": "違う！"},
        { "location": "111/ACT"   , "narrator": "", "text": "確かに！"},
        { "location": "112/TALK"  , "narrator": "千羽鶴", "text": "だから、とっとと\n私を攻略してもらって\nさようならしてもらう。"},
        { "location": "113/ACT"   , "narrator": "", "text": "違う！"},
        { "location": "114/TALK"  , "narrator": "千羽鶴", "text": "５年後も？\n１０年後も？"},
        { "location": "115/TALK"  , "narrator": "千羽鶴", "text": "とにかく、手っ取り早く\n私を攻略し終えて、次の\n子に行ってもらいたい。"},
        { "location": "117/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n早速やって。"},
        { "location": "118/SEL"   , "narrator": "", "text": "やる"},
        { "location": "119/SEL"   , "narrator": "", "text": "やらない"},
        { "location": "120/SEL"   , "narrator": "", "text": "元々好きでもないし、やる必要もない"},
        { "location": "121/ACT"   , "narrator": "", "text": "やる"},
        { "location": "122/TALK"  , "narrator": "千羽鶴", "text": "わかった。\nそれじゃ早速起動する。"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "どう？\n熱は冷めた？"},
        { "location": "134/SEL"   , "narrator": "", "text": "わりと"},
        { "location": "135/SEL"   , "narrator": "", "text": "冷めるわけがない！"},
        { "location": "136/SEL"   , "narrator": "", "text": "不具合があります"},
        { "location": "137/ACT"   , "narrator": "", "text": "わりと"},
        { "location": "139/TALK"  , "narrator": "千羽鶴", "text": "良かった。"},
        { "location": "140/TALK"  , "narrator": "千羽鶴", "text": "これだけやれば、\n倍マシの約束は\n果たしたはず。"},
        { "location": "141/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\nさっさと本題に\nいこうと思う。"},
        { "location": "142/ACT"   , "narrator": "", "text": "冷めるわけがない！"},
        { "location": "143/TALK"  , "narrator": "千羽鶴", "text": "…困った人。"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "まあそもそも目的が\n倍マシで語る事だし、\nそれはクリアしたはず。"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "さっさと本題に\nいこうと思う。"},
        { "location": "146/ACT"   , "narrator": "", "text": "不具合があります"},
        { "location": "147/TALK"  , "narrator": "千羽鶴", "text": "ない。"},
        { "location": "148/SEL"   , "narrator": "", "text": "千羽鶴とゴールできない"},
        { "location": "149/SEL"   , "narrator": "", "text": "話が支離滅裂"},
        { "location": "150/ACT"   , "narrator": "", "text": "千羽鶴とゴールできない"},
        { "location": "151/TALK"  , "narrator": "千羽鶴", "text": "最初から言ってるとおり\n仕様です。"},
        { "location": "152/TALK"  , "narrator": "千羽鶴", "text": "ゲームは必ずハッピー\nエンドになるもの、とか\n思ってたりしない？"},
        { "location": "153/TALK"  , "narrator": "千羽鶴", "text": "ゲームには目的がある。\nその目的は開発者が\nきめること。"},
        { "location": "154/TALK"  , "narrator": "千羽鶴", "text": "このゲームは、ゴール\nできないルートが\nトゥルーエンドなの。"},
        { "location": "155/ACT"   , "narrator": "", "text": "話が支離滅裂"},
        { "location": "156/TALK"  , "narrator": "千羽鶴", "text": "不具合じゃない。\nそういうキャラの子なの。"},
        { "location": "157/SEL"   , "narrator": "", "text": "斬新すぎる"},
        { "location": "158/ACT"   , "narrator": "", "text": "斬新すぎる"},
        { "location": "160/TALK"  , "narrator": "千羽鶴", "text": "常に新しいサプライズを\n与えていくというスピ\nリッツを忘れてないから。"},
        { "location": "161/TALK"  , "narrator": "千羽鶴", "text": "きっとこれから流行る。"},
        { "location": "163/TALK"  , "narrator": "千羽鶴", "text": "以上、サポートセンターは\n終了しました。"},
        { "location": "164/TALK"  , "narrator": "千羽鶴", "text": "というわけで、だいぶ\n時間を使ってしまったから\nさっさと本題へ行く。"},
        { "location": "166/ACT"   , "narrator": "", "text": "やらない"},
        { "location": "168/TALK"  , "narrator": "千羽鶴", "text": "そう、残念。\nそれじゃまたの機会に。"},
        { "location": "169/TALK"  , "narrator": "千羽鶴", "text": "というわけで、早速\n本題に行こうと思う。"},
        { "location": "170/ACT"   , "narrator": "", "text": "元々好きでもないし、やる必要もない"},
        { "location": "172/TALK"  , "narrator": "千羽鶴", "text": "とてもいい答え。\nちーはそういう人が好き。"},
        { "location": "173/TALK"  , "narrator": "千羽鶴", "text": "それじゃ早速、\n本題に行こうと思う。"},
        { "location": "175/TALK"  , "narrator": "千羽鶴", "text": "まずはいつも通り\n記録映像から\n見てもらうことにする。"},
        { "location": "176/TALK"  , "narrator": "千羽鶴", "text": "準備はいい？"},
        { "location": "178/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:57】</color>"},
        { "location": "179/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:57】</color>"},
        { "location": "180/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "181/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:57】</color>"},
        { "location": "182/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "188/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:57】</color>"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "195/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "196/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "197/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、いろいろ\n事情があってのことだと\n思うから。"},
        { "location": "198/TALK"  , "narrator": "千羽鶴", "text": "家に帰ったら、是非\n記録映像の方も\n見てみて欲しい。"},
        { "location": "199/TALK"  , "narrator": "千羽鶴", "text": "それではどうぞ。"},
        { "location": "232/TALK"  , "narrator": "千羽鶴", "text": "――というわけで、\n素敵な日常回でした。"},
        { "location": "235/SEL"   , "narrator": "", "text": "ガブちゃんは本当に恋してるの？"},
        { "location": "236/SEL"   , "narrator": "", "text": "てか、トライナリーって情報ダダ漏れなんじゃないの？"},
        { "location": "237/SEL"   , "narrator": "", "text": "浴衣キター！！"},
        { "location": "238/SEL"   , "narrator": "", "text": "神楽チャンネル来ないー！"},
        { "location": "239/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "240/ACT"   , "narrator": "", "text": "ガブちゃんは本当に恋してるの？"},
        { "location": "243/TALK"  , "narrator": "千羽鶴", "text": "え？\nもう、何言ってるの？"},
        { "location": "245/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラと夜話して\n知ってるくせに。\nマルザンナ♪"},
        { "location": "246/SEL"   , "narrator": "", "text": "はい、知ってました"},
        { "location": "247/SEL"   , "narrator": "", "text": "ていうか、恋愛ゲームで他に好きな相手がいるってどうなの？"},
        { "location": "248/ACT"   , "narrator": "", "text": "はい、知ってました"},
        { "location": "249/TALK"  , "narrator": "千羽鶴", "text": "素直でよろしい。"},
        { "location": "250/ACT"   , "narrator": "", "text": "ていうか、恋愛ゲームで他に好きな相手がいるってどうなの？"},
        { "location": "251/TALK"  , "narrator": "千羽鶴", "text": "そんなの私知らない。"},
        { "location": "252/TALK"  , "narrator": "千羽鶴", "text": "貴方からすれば恋愛\nゲームなのかもしれない\nけど、彼女は違うもの。"},
        { "location": "253/TALK"  , "narrator": "千羽鶴", "text": "普通に生きていて、\n恋するお年頃の\n女の子なんだもの。"},
        { "location": "255/TALK"  , "narrator": "千羽鶴", "text": "好きな人の一人や二人、\nいる方が健全だと思う。"},
        { "location": "256/SEL"   , "narrator": "", "text": "でも、$me$と結婚して欲しいんでしょ？"},
        { "location": "257/ACT"   , "narrator": "", "text": "でも、$me$と結婚して欲しいんでしょ？"},
        { "location": "261/TALK"  , "narrator": "千羽鶴", "text": "ええ、もちろん。"},
        { "location": "262/TALK"  , "narrator": "千羽鶴", "text": "だから私は、\n貴方を応援する。"},
        { "location": "263/TALK"  , "narrator": "千羽鶴", "text": "とはいっても、\n彼女の恋路を\n邪魔したりはしない。"},
        { "location": "264/TALK"  , "narrator": "千羽鶴", "text": "何が言いたいかというと、\nそれも含めて貴方に\nお任せするということ。"},
        { "location": "265/TALK"  , "narrator": "千羽鶴", "text": "私は貴方の能力を\n信頼している。だから\n今も一緒にいる。"},
        { "location": "266/TALK"  , "narrator": "千羽鶴", "text": "きっと彼女にとっても\n貴方にとっても、いい\n結果になると信じてる。"},
        { "location": "269/TALK"  , "narrator": "千羽鶴", "text": "それは私の口からは\n言うことはできない。"},
        { "location": "270/TALK"  , "narrator": "千羽鶴", "text": "彼女のプライバシーに\n関わる問題だから。"},
        { "location": "271/TALK"  , "narrator": "千羽鶴", "text": "真相を知りたければ、\nガブリエラともっと密に\n交流をしてみること。"},
        { "location": "272/TALK"  , "narrator": "千羽鶴", "text": "案外簡単に話して\nくれるかもしれない。"},
        { "location": "274/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "276/ACT"   , "narrator": "", "text": "てか、トライナリーって情報ダダ漏れなんじゃないの？"},
        { "location": "277/TALK"  , "narrator": "千羽鶴", "text": "それは無い。"},
        { "location": "278/TALK"  , "narrator": "千羽鶴", "text": "まあ……、\nだいぶ危ない橋を渡って\nいるのは認めるけど。"},
        { "location": "279/TALK"  , "narrator": "千羽鶴", "text": "裏の裏をかく作戦\nといったところかしら。"},
        { "location": "280/SEL"   , "narrator": "", "text": "裏の裏といっても、ガブちゃん出てるし…"},
        { "location": "281/ACT"   , "narrator": "", "text": "裏の裏といっても、ガブちゃん出てるし…"},
        { "location": "283/TALK"  , "narrator": "千羽鶴", "text": "ブレブレだから大丈夫。"},
        { "location": "284/TALK"  , "narrator": "千羽鶴", "text": "実は中身は単なるコス\nプレイヤーで、オリジナル\n妄想トライナリーかも。"},
        { "location": "285/SEL"   , "narrator": "", "text": "超能力者レベルでドンピシャな妄想デザインなんですけど！"},
        { "location": "286/ACT"   , "narrator": "", "text": "超能力者レベルでドンピシャな妄想デザインなんですけど！"},
        { "location": "289/TALK"  , "narrator": "千羽鶴", "text": "はぁ。わかってない。"},
        { "location": "290/TALK"  , "narrator": "千羽鶴", "text": "まあ、コスプレイヤーは\n冗談だけど、これは決して\nミスではない。"},
        { "location": "291/TALK"  , "narrator": "千羽鶴", "text": "情報操作の基本とも\nいえる手法を取り入れて\nいるだけ。"},
        { "location": "292/SEL"   , "narrator": "", "text": "情報操作の基本？？"},
        { "location": "293/ACT"   , "narrator": "", "text": "情報操作の基本？？"},
        { "location": "295/TALK"  , "narrator": "千羽鶴", "text": "全然分かってなさそうね。"},
        { "location": "296/TALK"  , "narrator": "千羽鶴", "text": "そんな貴方に、私が特別に\n情報管理基礎Ⅰの授業を\nしてあげる。"},
        { "location": "297/SEL"   , "narrator": "", "text": "なんですか、その科目は"},
        { "location": "298/ACT"   , "narrator": "", "text": "なんですか、その科目は"},
        { "location": "300/TALK"  , "narrator": "千羽鶴", "text": "情報管理庁附属学園の\n高等部１年の必須授業。"},
        { "location": "301/TALK"  , "narrator": "千羽鶴", "text": "そこでは\n情報操作について学ぶ。"},
        { "location": "302/TALK"  , "narrator": "千羽鶴", "text": "いい？\n今から話すことを\nよく聞いて。"},
        { "location": "303/TALK"  , "narrator": "千羽鶴", "text": "人に嘘の情報を信じさせる\n為には、嘘と本当の情報を\n程よく混ぜる必要がある。"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "民衆にすり込ませたい\n情報が嘘の情報である\n場合――"},
        { "location": "305/TALK"  , "narrator": "千羽鶴", "text": "嘘の情報ばかりを流し\n続ければ、それが偽で\nあることは見破られる。"},
        { "location": "306/TALK"  , "narrator": "千羽鶴", "text": "けど、裏付けのある真実を\n合間に挟むことで、偽は\n見破られにくくなる。"},
        { "location": "307/TALK"  , "narrator": "千羽鶴", "text": "この手法は、人間の観念に\n基づく心理的な特性を\n利用したものである。"},
        { "location": "308/TALK"  , "narrator": "千羽鶴", "text": "すなわち、真実の裏付けが\n出来ているメディアを人は\n疑いにくくなる。"},
        { "location": "309/TALK"  , "narrator": "千羽鶴", "text": "１０のニュースのうち\n８が真実であれば、残り\n２も真実だと疑わない。"},
        { "location": "310/TALK"  , "narrator": "千羽鶴", "text": "そうやって民衆を\nコントロールしていく事が\n重要である。"},
        { "location": "312/TALK"  , "narrator": "千羽鶴", "text": "……以上。わかった？"},
        { "location": "313/SEL"   , "narrator": "", "text": "高校１年でやる内容か！？"},
        { "location": "314/ACT"   , "narrator": "", "text": "高校１年でやる内容か！？"},
        { "location": "316/TALK"  , "narrator": "千羽鶴", "text": "専門科だし。"},
        { "location": "317/TALK"  , "narrator": "千羽鶴", "text": "慣れてないからそう思う\nだけで、工科系の高校でも\nすごい授業やってるから。"},
        { "location": "318/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "320/ACT"   , "narrator": "", "text": "浴衣キター！！"},
        { "location": "321/TALK"  , "narrator": "千羽鶴", "text": "はいきた。"},
        { "location": "322/SEL"   , "narrator": "", "text": "浴衣衣装もくる？"},
        { "location": "323/ACT"   , "narrator": "", "text": "浴衣衣装もくる？"},
        { "location": "325/TALK"  , "narrator": "千羽鶴", "text": "やっぱりそうきた。"},
        { "location": "326/TALK"  , "narrator": "千羽鶴", "text": "もちろん、くる。\n近いうちに。"},
        { "location": "327/TALK"  , "narrator": "千羽鶴", "text": "乞うご期待。"},
        { "location": "328/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "330/ACT"   , "narrator": "", "text": "神楽チャンネル来ないー！"},
        { "location": "332/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "333/SEL"   , "narrator": "", "text": "いつ来るの！？"},
        { "location": "334/ACT"   , "narrator": "", "text": "いつ来るの！？"},
        { "location": "336/TALK"  , "narrator": "千羽鶴", "text": "さあ。\n今の私にはわからない。"},
        { "location": "337/TALK"  , "narrator": "千羽鶴", "text": "ただ、１つだけ\n言えることがある。"},
        { "location": "338/TALK"  , "narrator": "千羽鶴", "text": "チャンネルが増えない\nことも含めて、一つの\n大きなドラマである。"},
        { "location": "339/TALK"  , "narrator": "千羽鶴", "text": "もちろん、チャンネルが\n来ないことには、\nちゃんとした意味がある。"},
        { "location": "340/TALK"  , "narrator": "千羽鶴", "text": "どうなるとチャンネルが\n増えるのかも、だいたい\nわかってる。"},
        { "location": "341/TALK"  , "narrator": "千羽鶴", "text": "けど、今はまだ\nその時じゃない。"},
        { "location": "342/TALK"  , "narrator": "千羽鶴", "text": "だから、チャンネルが\n来ない卯月神楽を、是非\n応援してあげて欲しい！"},
        { "location": "343/SEL"   , "narrator": "", "text": "応援する！"},
        { "location": "344/SEL"   , "narrator": "", "text": "我慢できない！"},
        { "location": "345/SEL"   , "narrator": "", "text": "千羽鶴はいつくるの？"},
        { "location": "346/ACT"   , "narrator": "", "text": "応援する！"},
        { "location": "347/TALK"  , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "348/ACT"   , "narrator": "", "text": "我慢できない！"},
        { "location": "349/TALK"  , "narrator": "千羽鶴", "text": "…困った人。"},
        { "location": "350/TALK"  , "narrator": "千羽鶴", "text": "とはいえ、チャンネルは\n運命の輪に精密に組み\n込まれているから……"},
        { "location": "351/TALK"  , "narrator": "千羽鶴", "text": "あ、そうだ。\nそれじゃ、私が\n作ってあげる。"},
        { "location": "352/TALK"  , "narrator": "千羽鶴", "text": "『神楽ちゃん\n　ラブラブゲーム』！\n（システム使い回し）"},
        { "location": "353/SEL"   , "narrator": "", "text": "是非！！"},
        { "location": "354/SEL"   , "narrator": "", "text": "遠慮します"},
        { "location": "355/ACT"   , "narrator": "", "text": "是非！！"},
        { "location": "356/TALK"  , "narrator": "千羽鶴", "text": "わかった。\nそのうち用意する。"},
        { "location": "357/ACT"   , "narrator": "", "text": "遠慮します"},
        { "location": "359/TALK"  , "narrator": "千羽鶴", "text": "…いけず。"},
        { "location": "361/ACT"   , "narrator": "", "text": "千羽鶴はいつくるの？"},
        { "location": "362/TALK"  , "narrator": "千羽鶴", "text": "来ません。"},
        { "location": "363/TALK"  , "narrator": "千羽鶴", "text": "以上。"},
        { "location": "365/TALK"  , "narrator": "千羽鶴", "text": "次は『ちーの非攻略対象\nゲーム』を作るしか\nないかも……。"},
        { "location": "367/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "369/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "372/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "379/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n逢瀬つばめについて\nなんだけども。"},
        { "location": "380/TALK"  , "narrator": "千羽鶴", "text": "記録映像の中では\n特に問題無さそうに\n見える彼女。"},
        { "location": "381/TALK"  , "narrator": "千羽鶴", "text": "実はその過程で\n１つ事件が\n起きていた。"},
        { "location": "382/TALK"  , "narrator": "千羽鶴", "text": "けど、それについては\nガブリエラのチャンネルで\n見せようと思う。"},
        { "location": "383/TALK"  , "narrator": "千羽鶴", "text": "このチャンネルでは\nそれよりも重要な案件を\n扱うことにする。"},
        { "location": "384/TALK"  , "narrator": "千羽鶴", "text": "実は同じ期間に行われて\nいた、新歓でちょっとした\n事件があった。"},
        { "location": "385/SEL"   , "narrator": "", "text": "新入隊員歓迎会？"},
        { "location": "386/ACT"   , "narrator": "", "text": "新入隊員歓迎会？"},
        { "location": "388/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "389/SEL"   , "narrator": "", "text": "もしかしてガブちゃんがつばめをいじめた？"},
        { "location": "390/SEL"   , "narrator": "", "text": "もしかしてアーヤが酔って脱いだ？"},
        { "location": "391/SEL"   , "narrator": "", "text": "もしかしてみやびが闇鍋に唐辛子ボールを入れた？"},
        { "location": "392/SEL"   , "narrator": "", "text": "もしかして神楽がつばめに呪いをかけた？"},
        { "location": "393/ACT"   , "narrator": "", "text": "もしかしてガブちゃんがつばめをいじめた？"},
        { "location": "394/TALK"  , "narrator": "千羽鶴", "text": "いえ。"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "むしろガブリエラは\n彼女なりのやり方で\nつばめを歓迎してる。"},
        { "location": "396/TALK"  , "narrator": "千羽鶴", "text": "そこはみどころ。"},
        { "location": "397/ACT"   , "narrator": "", "text": "もしかしてアーヤが酔って脱いだ？"},
        { "location": "398/TALK"  , "narrator": "千羽鶴", "text": "そう！\n國政綾水が――"},
        { "location": "401/TALK"  , "narrator": "千羽鶴", "text": "って、違う！"},
        { "location": "404/TALK"  , "narrator": "千羽鶴", "text": "このアプリを\nストアから消したいの？"},
        { "location": "405/TALK"  , "narrator": "千羽鶴", "text": "もしかして貴方が\n真の……"},
        { "location": "406/TALK"  , "narrator": "千羽鶴", "text": "いえ、なんでもない。"},
        { "location": "407/ACT"   , "narrator": "", "text": "もしかしてみやびが闇鍋に唐辛子ボールを入れた？"},
        { "location": "409/TALK"  , "narrator": "千羽鶴", "text": "違う。"},
        { "location": "410/TALK"  , "narrator": "千羽鶴", "text": "ちなみに貴方は\n恋ヶ崎みやびを誤解して\nいるかもしれない。"},
        { "location": "411/TALK"  , "narrator": "千羽鶴", "text": "彼女はイタズラ好きだけど\n人に苦痛や被害を与える\nようなことはしない。"},
        { "location": "412/ACT"   , "narrator": "", "text": "もしかして神楽がつばめに呪いをかけた？"},
        { "location": "413/TALK"  , "narrator": "千羽鶴", "text": "惜しい。"},
        { "location": "416/TALK"  , "narrator": "千羽鶴", "text": "正解は、卯月神楽と\nドキドキ展開が発生する。"},
        { "location": "417/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめはそれに対し\n積極的にアタックできず\n悩んでる。"},
        { "location": "418/TALK"  , "narrator": "千羽鶴", "text": "そこで、是非貴方に背中を\n押してあげて欲しい。"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "良い結果を期待してる。\nグッドラック。"},
        { "location": "424/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n國政綾水について\nなんだけども。"},
        { "location": "425/TALK"  , "narrator": "千羽鶴", "text": "彼女は今回、\n殆ど記録映像に\n出てきていない。"},
        { "location": "426/TALK"  , "narrator": "千羽鶴", "text": "バトルも無く、\n仲間内の問題も\n特に無い。"},
        { "location": "427/TALK"  , "narrator": "千羽鶴", "text": "なので私は考えた。"},
        { "location": "428/TALK"  , "narrator": "千羽鶴", "text": "今回は、\n國政綾水の可愛いところを\n見せる回にする！"},
        { "location": "429/SEL"   , "narrator": "", "text": "ひゃっほう！"},
        { "location": "430/SEL"   , "narrator": "", "text": "本当に何も無いの？"},
        { "location": "431/ACT"   , "narrator": "", "text": "ひゃっほう！"},
        { "location": "432/TALK"  , "narrator": "千羽鶴", "text": "素直ですてき。"},
        { "location": "433/ACT"   , "narrator": "", "text": "本当に何も無いの？"},
        { "location": "435/TALK"  , "narrator": "千羽鶴", "text": "疑り深い人。"},
        { "location": "436/TALK"  , "narrator": "千羽鶴", "text": "今回は本当に何も無い。"},
        { "location": "438/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n特に説明はなし。"},
        { "location": "439/TALK"  , "narrator": "千羽鶴", "text": "彼女の意外な一面を\n存分に堪能して。"},
        { "location": "444/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\nガブリエラについて\nなんだけども。"},
        { "location": "445/TALK"  , "narrator": "千羽鶴", "text": "記録映像で七夕祭りに\n参加するまでの過程を\n追ってみたいと思う。"},
        { "location": "448/TALK"  , "narrator": "千羽鶴", "text": "お祭りの待ち合わせに\nちゃんと来ていた\nガブリエラ。"},
        { "location": "449/TALK"  , "narrator": "千羽鶴", "text": "でもよく考えて欲しい。\nあのガブリエラが、\n誘われてすぐ来ると思う？"},
        { "location": "450/SEL"   , "narrator": "", "text": "来ないね"},
        { "location": "451/SEL"   , "narrator": "", "text": "来るんじゃない？"},
        { "location": "452/ACT"   , "narrator": "", "text": "来ないね"},
        { "location": "454/TALK"  , "narrator": "千羽鶴", "text": "そうね。\nそう簡単には来ない。"},
        { "location": "455/TALK"  , "narrator": "千羽鶴", "text": "だって、\nツンデレだもの！"},
        { "location": "456/ACT"   , "narrator": "", "text": "来るんじゃない？"},
        { "location": "457/TALK"  , "narrator": "千羽鶴", "text": "ヒント：つばめ"},
        { "location": "458/TALK"  , "narrator": "千羽鶴", "text": "ヒント：ツンデレ"},
        { "location": "459/TALK"  , "narrator": "千羽鶴", "text": "これだけ強固な要因が\n重なり合っていたら、\n来るものも来れなくなる。"},
        { "location": "460/TALK"  , "narrator": "千羽鶴", "text": "そう思わない？"},
        { "location": "464/TALK"  , "narrator": "千羽鶴", "text": "でも彼女、\n内心はとても\n行きたがってる。"},
        { "location": "465/TALK"  , "narrator": "千羽鶴", "text": "だから貴方に、その\nあと一歩のための\nきっかけを与えて欲しい。"},
        { "location": "466/TALK"  , "narrator": "千羽鶴", "text": "実はこの七夕祭りは\n彼女にとっての\n転換点になる。"},
        { "location": "467/TALK"  , "narrator": "千羽鶴", "text": "とっても責任重大！"},
        { "location": "468/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n良い結果を待ってる。"},
        { "location": "472/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n恋ヶ崎みやびについて\nなんだけども。"},
        { "location": "473/TALK"  , "narrator": "千羽鶴", "text": "特に問題がある、という\nわけではないけど、相手を\nして欲しい事がある。"},
        { "location": "476/TALK"  , "narrator": "千羽鶴", "text": "彼女が見て爆笑していた\n管理庁謹製のトライナリー\nファンサイト。"},
        { "location": "477/TALK"  , "narrator": "千羽鶴", "text": "それを発見させ、それが\n管理庁制作であることを\n彼女に突き止めさせる。"},
        { "location": "478/TALK"  , "narrator": "千羽鶴", "text": "それが今回、私から\n貴方にお願いしたいこと。"},
        { "location": "481/SEL"   , "narrator": "", "text": "それって何か裏がある？"},
        { "location": "482/ACT"   , "narrator": "", "text": "それって何か裏がある？"},
        { "location": "485/TALK"  , "narrator": "千羽鶴", "text": "いいえ。"},
        { "location": "486/TALK"  , "narrator": "千羽鶴", "text": "ていうか、\n貴方勘ぐりすぎ。"},
        { "location": "487/TALK"  , "narrator": "千羽鶴", "text": "彼女のモチベーションを\n上げて欲しいだけ。"},
        { "location": "488/TALK"  , "narrator": "千羽鶴", "text": "ここでサイトの出所を\n突き止めるか否かで、\nその後の行動がかわる。"},
        { "location": "489/TALK"  , "narrator": "千羽鶴", "text": "すなわち、ロマンチック\n大作戦が発動するか\n否かが掛かっているの。"},
        { "location": "490/TALK"  , "narrator": "千羽鶴", "text": "そういうわけだから、\n是非協力してあげて。"},
        { "location": "491/TALK"  , "narrator": "千羽鶴", "text": "きっと貴方の株も\nグイグイ上がるから。"},
        { "location": "492/TALK"  , "narrator": "千羽鶴", "text": "グッドラック。"},
        { "location": "82/DIALOG" , "narrator": "Event/Dialog_EventPicWide", "text": "謎のプログラムコード"},
        { "location": "209/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "211/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "213/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "215/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "217/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"}
    ]
}
