{
    "dir": "chap06/daydra/dd_ch04_06_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "6408",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "手書き嫌い"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "手書き嫌い"},
        { "location": "24/TALK"   , "narrator": "みやび", "text": "はぁ…憂鬱や。"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "何か嫌なことでも\nあったの？"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "いやな、うちは普段\nからＰＣのキーボード\n叩くんに慣れちゅう。"},
        { "location": "30/TALK"   , "narrator": "みやび", "text": "やき、黒板の文字を\n手でノートに書くんが、\n苦行過ぎて堪らんちや。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "う～ん…まあ、みやびの\n気持ちもわからないでは\nないわ。"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "黒板から目を逸らさずに\nタッタカ打ち込んで\nいけるだろうし。"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "それを考えると、\n本気でアホらしゅう\nなってくるんよ…。"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "なのに、キーボードの\n音が授業の邪魔になる\nから禁止、やと？"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "アホらしゅうて\n呆れるがよ。"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "まあ、そういうルール\nだと思って、諦める\nしかないんじゃない？"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "諦められんから\n言っちゅうに…。"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "っと、そろそろ講義が\n始まるから、行くわ。"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "…うちも、\n授業の準備せんと。"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "やっぱり、どうにも\nアナログな作業は\n合わんなぁ…。"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "てか、先生そこに立つと\n黒板が見えんちや！"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "はぁ…もう面倒やし、\n寝てしまうかが？"},
        { "location": "61/SEL"    , "narrator": "", "text": "コッソリ黒板を撮影だ"},
        { "location": "62/SEL"    , "narrator": "", "text": "美文字の練習だと思おう"},
        { "location": "63/SEL"    , "narrator": "", "text": "タブレットに書こう"},
        { "location": "64/ACT"    , "narrator": "", "text": "コッソリ黒板を撮影だ"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "盲点やった！"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "撮影ゆう手段があったちや！"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "相棒は天才やね"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "文字認識ソフトが入った\nカメラアプリを\nダウンロードして…。"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "……ん？"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "相棒、その案は却下や"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "シャッター音で一発で気づかれて、お説教コースへご招待の未来がお待ちや！"},
        { "location": "86/SEL"    , "narrator": "", "text": "万事休すだ"},
        { "location": "87/ACT"    , "narrator": "", "text": "万事休すだ"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "代案はないんか？"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "しゃあないな…諦めてアナログ作業を頑張るとするちや"},
        { "location": "93/ACT"    , "narrator": "", "text": "美文字の練習だと思おう"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "…相棒、今えいこと言うたぞ"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "最近、ちっくと自分で\n書く文字が歪んできてたんよ"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "小さい頃綺麗な文字を\n書く練習したき、\n自慢やったけんど――"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "キーボード入力ばかり\nしちゅうたら、文字が\n歪むんは当然やね。"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "リハビリやと思うて、\n頑張るとするちや。"},
        { "location": "112/ACT"   , "narrator": "", "text": "タブレットに書こう"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "ノートに書くんとやることは\n変わらん気がするけんど"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "まあ、使い慣れた\nタブレットの方が、\n気持ち的にちっくとラクになるかもしれんね"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "その案、採用や！"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "…けんど、タッチペンは\nカツカツ音がするき、\n注意されそうやな。"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "指で書くんは\n絶対却下とすると…"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "…タブレット案は\nなしやな。"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "はぁ…まっこと面倒や…。"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月17日　10:02 AM</color>\nとある休み時間、学園廊下にて。"}
    ]
}
