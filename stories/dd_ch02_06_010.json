{
    "dir": "chap06/daydra/dd_ch02_06_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "6252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "ゲームの発売日"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ゲームの発売日"},
        { "location": "21/TALK"   , "narrator": "アーヤ", "text": "…話は聞いてたけど、\n実際に見ると驚きね。"},
        { "location": "23/TALK"   , "narrator": "みやび", "text": "何がや？"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "ゲームの早朝販売よ。\nまさか、平日の朝でも\nこんなに並ぶなんて…。"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "ファンなら一分一秒でも\n早く手に入れたいって\n思うのが普通でしょ？"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "…まあ、わからなくは\nないわね。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "並んでる人達見てると、\nみんなゲーム好きって\nいうのはよくわかる…。"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "スマホがあれば、\nどこでも\nゲームできるきね。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "あ、みやび死にそう。\n回復薬使うわ。"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "ナイスやガブちゃん！\n物理防御張るき、\n特攻任せるちや！"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "任せて。\n一気に畳みかけるわ！"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "はぁ…並んでる時間も、\nそれなら暇せずに\nすみそうね。"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、アーヤが\n一緒にいるのが驚きよ。"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "これを機に、ゲーム機\n買うつもりなの？"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "遠くに住んでる大学の\n友達に頼まれたのよ。\n昼食を条件にね。"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "…ついでに、館長からも\n貴方たちの監視を頼まれ\nてるし。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "二人が学校サボらない\nか、しっかり見てろ、\nって。"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "わかってない友達ね。\n自分で並んで買うから\nこそ達成感あるのに。"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "並んで買ったって、\nどうせ遊べるのは\n帰ってからでしょ？"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "ギャヴィ達だって、\n学校終わるまでは\n遊べないんだし…。"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "…っていうか、\n放課後まで\n我慢できるの？"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "…それは、まあ…ねぇ？"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "学校にゲーム機\n持ち込むわけには\nいかんしね…。"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "？"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "まあ、学校に行くなら\n我慢しないといけない\nわよね？"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "…怪しい。"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "うちらはどこも怪しく\nないぞね。"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "そうよ。\nあんまり疑うのは\n良くないんじゃない？"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "凄く怪しいわ…この子\n達なら本当にサボり\nかねないし…。"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "でも、本当にサボる\nつもりがなかったと\nしたら――"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "二人とも、凄く気分が\n悪くなると思うし…。"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "…少し信じたフリして、\n様子を見た方が良いかも。"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "…疑って悪かったわ。\n私の考え過ぎだった\nみたい。"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "あ、謝るようなことじゃ\nないって。\n気にしてないし…ね？"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "アーヤはリーダーやき、\n考え過ぎるくらいが\n丁度えいんよ。"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "それでも、一応謝りは\nしておくわ。"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "あまり疑われるのって、\n息苦しい感じがして\nいい気分しないし。"},
        { "location": "103/SEL"   , "narrator": "", "text": "信じる心は素晴らしい"},
        { "location": "104/SEL"   , "narrator": "", "text": "二人の服装に注目"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "…もっと疑われると\n思うてたけんど、\n意外やね。"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "そうね。\nまあ、結果オーライ\nじゃない？"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "二人とも、どうしたの？"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "な、何でもないわ。\nちょっとゲーム攻略の\n相談をしてただけよ。"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "本当にそれだけやき。\nアーヤも、販売始まるまで\n本でも読んでてえいよ。"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "やっぱり怪しいわ。\nこの子達、絶対に…。"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "あっ、そうだ！"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "…そういえば今日って\n私も朝一から講義が\n入ってるから――"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "学校には貴方たちと\n一緒に行けるわね。"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "はぁ！？"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "いや、アーヤ…\nうちらは買ったら一度、\n寮に戻るき…。"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "私も教科書とか取りに\n戻らないといけないから、\n問題ないわ。"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "何か不都合でもある？"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "…ないわよ。\nもう諦めたわ。"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "はぁ…悪いことはできん\nもんやね…。"},
        { "location": "153/TALK"  , "narrator": "アーヤ", "text": "…やっぱりサボるつもり\nだったのね？\nまったく…。"},
        { "location": "155/ACT"   , "narrator": "", "text": "信じる心は素晴らしい"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "もしかして、疑い過ぎだったかしら？(-.-;)"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "仲間を疑い過ぎるのはいけなかったわね"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "放課後まで我慢しなきゃ\nいけないって、ちゃんと\nわかってるんだから――"},
        { "location": "191/TALK"  , "narrator": "アーヤ", "text": "怪しまないで、\n信じなくちゃね。"},
        { "location": "192/TALK"  , "narrator": "アーヤ", "text": "仲間なんだし。"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "うっ！"},
        { "location": "199/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "201/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ、どうかしたの？"},
        { "location": "204/TALK"  , "narrator": "ガブリエラ", "text": "…な、何でもないわ。"},
        { "location": "208/TALK"  , "narrator": "みやび", "text": "…ガブちゃん、大丈夫？\n何に苦しんでるかは\n察しがつくけんど…。"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "…なんだかあたし、\n凄く後ろめたい気持ちに\nなってきてるんだけど。"},
        { "location": "212/TALK"  , "narrator": "みやび", "text": "うちもや…。まさか、\n純粋に信じられるとは\n思うてなかったちや。"},
        { "location": "215/TALK"  , "narrator": "ガブリエラ", "text": "これじゃサボッて\nゲームしても――"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "モヤモヤした気持ちが\n残って楽しめないわ。"},
        { "location": "217/TALK"  , "narrator": "みやび", "text": "…そうやね。"},
        { "location": "219/TALK"  , "narrator": "みやび", "text": "信じる心は時として\n裏切られる、いうんを\n思い知らせる気は――"},
        { "location": "220/TALK"  , "narrator": "みやび", "text": "さすがのうちにも\nないき、どうする\nこともできん。"},
        { "location": "222/TALK"  , "narrator": "みやび", "text": "…学校、行かんと\nならんようやね。"},
        { "location": "224/TALK"  , "narrator": "ガブリエラ", "text": "そうね…。ゲームを\n楽しむためにも、大人\nしく学校行こっか…。"},
        { "location": "225/ACT"   , "narrator": "", "text": "二人の服装に注目"},
        { "location": "247/TALK"  , "narrator": "アーヤ", "text": "え？　別にいつもの服でしょ？"},
        { "location": "265/TALK"  , "narrator": "アーヤ", "text": "って、私服！？\nこれから学校でしょ！？"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "やばっ、バレた！！"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "貴方たち、やっぱり\n最初から学校サボる気\n満々だったんじゃない！"},
        { "location": "274/TALK"  , "narrator": "みやび", "text": "違うぞね。"},
        { "location": "275/TALK"  , "narrator": "みやび", "text": "うちらが制服じゃない\nのには、ちゃんとした\n理由があるんよ。"},
        { "location": "276/TALK"  , "narrator": "アーヤ", "text": "どんな理由よ？"},
        { "location": "277/TALK"  , "narrator": "みやび", "text": "平日の朝っぱらから、\n制服姿の女子高生が\n並んでたら――"},
        { "location": "278/TALK"  , "narrator": "みやび", "text": "学校はどうした、朝から\nこんなところで何をして\nいるんだ――"},
        { "location": "279/TALK"  , "narrator": "みやび", "text": "とか言うてくる大人に、\n絡まれるかもしれんきね。"},
        { "location": "280/TALK"  , "narrator": "みやび", "text": "そうならんように、\nわざわざ私服で並んだ\nだけちや。"},
        { "location": "281/TALK"  , "narrator": "アーヤ", "text": "…まあ、無くはない\n話だけど…本当なの？"},
        { "location": "284/TALK"  , "narrator": "みやび", "text": "まっことの話や。\nな、ガブちゃん？"},
        { "location": "289/TALK"  , "narrator": "ガブリエラ", "text": "そ、そうよ。\n変なオッサンに絡まれて\nトラブルになったら――"},
        { "location": "290/TALK"  , "narrator": "ガブリエラ", "text": "色々と面倒でしょ？"},
        { "location": "291/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "294/TALK"  , "narrator": "みやび", "text": "それに、買うてから\n一度寮に戻って着替え\nたとしても――"},
        { "location": "295/TALK"  , "narrator": "みやび", "text": "登校時間には十分過ぎる\nくらい間に合うきね。"},
        { "location": "296/TALK"  , "narrator": "アーヤ", "text": "…確かに、時間は\nたっぷりあるわね。"},
        { "location": "297/TALK"  , "narrator": "みやび", "text": "やき、私服で並んでた。\nそれだけぞね。"},
        { "location": "298/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "299/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "300/TALK"  , "narrator": "アーヤ", "text": "…一応、ちゃんとした\n理由になってるし…\nう～ん…。"},
        { "location": "301/TALK"  , "narrator": "アーヤ", "text": "…本当に、ちゃんと\n学校には行きなさいよ？"},
        { "location": "303/TALK"  , "narrator": "ガブリエラ", "text": "やった！"},
        { "location": "304/TALK"  , "narrator": "アーヤ", "text": "え？"},
        { "location": "305/TALK"  , "narrator": "ガブリエラ", "text": "う、ううん！　信じて\nもらえて嬉しいな、\nって思っただけだって。"},
        { "location": "309/TALK"  , "narrator": "みやび", "text": "かなり疑われては\nいるけんど、どうにか\nなったようやね。"},
        { "location": "313/TALK"  , "narrator": "ガブリエラ", "text": "ふふっ、今日は一日中\nゲーム三昧よ！"},
        { "location": "20/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月23日　7:11 AM</color>\nとある朝、秋葉原の某ゲームショップ前にて。"}
    ]
}
