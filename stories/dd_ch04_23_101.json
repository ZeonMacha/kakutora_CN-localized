        { "location": "673/TALK"  , "narrator": "みやびの新司書", "text": "わかったわかった。\nわかったから\nちくっと待ちいや。"},
        { "location": "679/SEL"   , "narrator": "", "text": "なんで！？"},
        { "location": "680/ACT"   , "narrator": "", "text": "なんで！？"},
        { "location": "682/TALK"  , "narrator": "みやびの新司書", "text": "そういうところやよ。"},
        { "location": "683/TALK"  , "narrator": "みやびの新司書", "text": "放っておいて\n欲しいところで、\n放っておかんからや。"},
        { "location": "684/TALK"  , "narrator": "みやびの新司書", "text": "うちかて同じぞね。"},
        { "location": "685/TALK"  , "narrator": "みやびの新司書", "text": "徹底最高効率重視、\n文字数さえも選んで喋る\nみやびさんの一人格。"},
        { "location": "686/TALK"  , "narrator": "みやびの新司書", "text": "人呼んで\n『品管のみやびさん』に\nドツキまくりよって。"},
        { "location": "687/TALK"  , "narrator": "みやびの新司書", "text": "お陰で今も、\nこうやって無駄工数が\n大量に発生しちゅう。"},
        { "location": "688/SEL"   , "narrator": "", "text": "無駄こそが人生には重要だよ"},
        { "location": "689/SEL"   , "narrator": "", "text": "それはそうと、前の司書は本当に消したの？"},
        { "location": "690/ACT"   , "narrator": "", "text": "無駄こそが人生には重要だよ"},
        { "location": "691/TALK"  , "narrator": "みやびの新司書", "text": "はい終了。\n最も無駄な議論。"},
        { "location": "692/ACT"   , "narrator": "", "text": "それはそうと、前の司書は本当に消したの？"},
        { "location": "693/TALK"  , "narrator": "みやびの新司書", "text": "……。\n何のことやか\n意味がわからんのだが。"},
        { "location": "694/SEL"   , "narrator": "", "text": "$me$が扉に入った後独り言で言ってなかった？"},
        { "location": "695/ACT"   , "narrator": "", "text": "$me$が扉に入った後独り言で言ってなかった？"},
        { "location": "697/TALK"  , "narrator": "みやびの新司書", "text": "なるほどね。\n特権階級ちゅうことか。"},
        { "location": "699/TALK"  , "narrator": "みやびの新司書", "text": "まあえい。\nシラを切るだけ時間の\n無駄なのは明白。"},
        { "location": "700/TALK"  , "narrator": "みやびの新司書", "text": "消したぞね。\n-fオプションつけて\n綺麗さっぱり。"},
        { "location": "701/SEL"   , "narrator": "", "text": "なんてことを！"},
        { "location": "702/SEL"   , "narrator": "", "text": "いつかお前も-fつけて消してやる"},
        { "location": "703/ACT"   , "narrator": "", "text": "なんてことを！"},
        { "location": "704/TALK"  , "narrator": "みやびの新司書", "text": "致し方あるまい。\nあの人格は、うちの\nココロにとって有害。"},
        { "location": "705/TALK"  , "narrator": "みやびの新司書", "text": "お前さんも巻き込んで\n色々暴走し過ぎたき。"},
        { "location": "706/TALK"  , "narrator": "みやびの新司書", "text": "本人格も、その事は\n覚悟していたはず。"},
        { "location": "707/TALK"  , "narrator": "みやびの新司書", "text": "だから、お前さんが\n気に病むことはない。"},
        { "location": "708/SEL"   , "narrator": "", "text": "気に病むとかじゃなくて！"},
        { "location": "709/ACT"   , "narrator": "", "text": "気に病むとかじゃなくて！"},
        { "location": "711/ACT"   , "narrator": "", "text": "いつかお前も-fつけて消してやる"},
        { "location": "713/TALK"  , "narrator": "みやびの新司書", "text": "まあ。それが可能で、\nそれにより消去されるなら\nその程度の存在やき。"},
        { "location": "714/TALK"  , "narrator": "みやびの新司書", "text": "やってみればえいよ？"},
        { "location": "717/TALK"  , "narrator": "みやびの新司書", "text": "ちゅうわけで、\nそろそろクランを消しに\n行ってもらえんかね。"},
        { "location": "718/TALK"  , "narrator": "みやびの新司書", "text": "結論から言うと、\n程々にして無視しておけ\nゆうお達しやよ、今回は。"},
        { "location": "719/TALK"  , "narrator": "みやびの新司書", "text": "では、いくぞね。"},
        { "location": "721/TALK"  , "narrator": "みやびの新司書", "text": "ほんで、結論から言うと、\n程々にして無視しておけ\nゆうお達しやよ、今回は。"},
        { "location": "722/TALK"  , "narrator": "みやびの新司書", "text": "ちゅうわけで、\nはよいてら。"},
        { "location": "724/TALK"  , "narrator": "みやびの新司書", "text": "うちと\n$handle$に\n素敵なココロの旅を。"},
