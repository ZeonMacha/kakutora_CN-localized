{
    "dir": "chap23/daydra/dd_ch04_23_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "23402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "らしくないらしい＜前編＞"
    },
    "entry":
    [
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "59/SEL"    , "narrator": "", "text": "空気が重いね"},
        { "location": "60/ACT"    , "narrator": "", "text": "空気が重いね"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "仕方ない"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "神楽がスパイで"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "私たちの敵だったから"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "みんな"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "ショックが大きいのよ"},
        { "location": "81/SEL"    , "narrator": "", "text": "アーヤは平気？"},
        { "location": "82/ACT"    , "narrator": "", "text": "アーヤは平気？"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "私のことはいいから"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "今は"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "みんなをどうにかしなきゃ"},
        { "location": "88/SEL"    , "narrator": "", "text": "手伝おうか？"},
        { "location": "89/SEL"    , "narrator": "", "text": "役に立てることはない？"},
        { "location": "90/SEL"    , "narrator": "", "text": "話なら聞けるよ"},
        { "location": "91/SEL"    , "narrator": "", "text": "一人で抱え込まないで"},
        { "location": "92/ACT"    , "narrator": "", "text": "手伝おうか？"},
        { "location": "93/ACT"    , "narrator": "", "text": "役に立てることはない？"},
        { "location": "94/ACT"    , "narrator": "", "text": "話なら聞けるよ"},
        { "location": "95/ACT"    , "narrator": "", "text": "一人で抱え込まないで"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "大丈夫"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "何とかするから"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "心配しないで"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "そうだ。\n確か今日って…。"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "…で？\nどうして横須賀で\n降りたのよ？"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "あら、知らないの？"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "今日はあの有名な、\n横須賀花火大会の\n日なのよ？"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "…で？"},
        { "location": "158/TALK"  , "narrator": "アーヤ", "text": "ノリが悪いわね…。"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "つまり、今日は\nおもいきって遊ぼう、\nってことよ。"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "…正気？\n昨日の夜のこと\n忘れたの！？"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "遊ぶ気になんて\nなれるわけないでしょ！"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "…じゃあ、何？\nまっすぐ劇場に帰る？"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "当然よ。\nまずは帰る。"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "それから――"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "何もできないわよ。"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "私たちは、管理庁の\n判断がないと動けない\n立場なんだから。"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "それに…劇場に戻って\n何をするつもり？"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "卯月を探しに行く？\nどこにいるか\nわかってるの？"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "…まあ、バカ正直に\n自宅に帰っちょる\nわけないきね。"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "わかってるわよ！\nそんなの…。"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "…なら、急いで\n帰ったところで\n意味ないでしょ？"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "今日は館長も、\n管理庁の判断を仰ぎに\n行ってるし。"},
        { "location": "178/TALK"  , "narrator": "アーヤ", "text": "多分、夜までは\n戻らないはずよ。"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "だから、今日は\n気分転換の日にした方が\nいいと思うの。"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "183/TALK"  , "narrator": "みやび", "text": "…それはあれか？\nリーダーとしての\n命令なが？"},
        { "location": "185/TALK"  , "narrator": "アーヤ", "text": "まさか。\n命令じゃなくて提案よ。"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "というわけだから、\n私は今日一日、\nおもいっきり遊ぶわ。"},
        { "location": "189/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ達も、\nあとは好きにして\nいいから…じゃあね。"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "…ふんっ。"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "229/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "231/TALK"  , "narrator": "みやび", "text": "はぁ…。"},
        { "location": "232/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "234/TALK"  , "narrator": "みやび", "text": "ふむ……。"},
        { "location": "235/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "237/TALK"  , "narrator": "みやび", "text": "ふぁ～…。"},
        { "location": "238/TALK"  , "narrator": "繭", "text": "…見つけました。"},
        { "location": "240/TALK"  , "narrator": "みやび", "text": "ん？"},
        { "location": "243/TALK"  , "narrator": "繭", "text": "みやび先輩…。\nこんなところに\nいたんですね？"},
        { "location": "244/TALK"  , "narrator": "みやび", "text": "…なんや、わざわざ\n来たんか？"},
        { "location": "245/TALK"  , "narrator": "繭", "text": "はい…ＷＡＶＥを\nいただいたので。"},
        { "location": "246/TALK"  , "narrator": "みやび", "text": "呼び出したわけや\nないやろ？"},
        { "location": "247/TALK"  , "narrator": "みやび", "text": "東京戻る前に、\nちくっと横須賀に\n寄り道する。"},
        { "location": "248/TALK"  , "narrator": "みやび", "text": "昨日の話の続きは\n夜にしよう、\n言うただけやろ？"},
        { "location": "249/TALK"  , "narrator": "みやび", "text": "それに…どうやって\nうちのおる場所を知った？"},
        { "location": "250/TALK"  , "narrator": "繭", "text": "勘だと言って、\n信じますか？"},
        { "location": "251/TALK"  , "narrator": "みやび", "text": "言うたら怒るぞね。"},
        { "location": "252/TALK"  , "narrator": "繭", "text": "ＧＰＳのハッキング程度、\n我々には簡単でしょう？"},
        { "location": "254/TALK"  , "narrator": "みやび", "text": "…正直でよろしい。\n悪びれないところも\n嫌いやないがよ。"},
        { "location": "255/TALK"  , "narrator": "繭", "text": "…ですが、\n勘というのも本当です。"},
        { "location": "256/TALK"  , "narrator": "繭", "text": "ＷＡＶＥの文面から\nみやび先輩の様子が\n変だと感じました。"},
        { "location": "257/TALK"  , "narrator": "繭", "text": "なので、実際にそれを\n確かめるため、\nここまで来たんです。"},
        { "location": "259/TALK"  , "narrator": "みやび", "text": "…大ハズレや。"},
        { "location": "261/TALK"  , "narrator": "みやび", "text": "うちはいつもと、\nなんも変わらんぞね。"},
        { "location": "262/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "264/TALK"  , "narrator": "みやび", "text": "…疑うてるが？\nうちの言うことが\n信じられんと？"},
        { "location": "265/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "266/TALK"  , "narrator": "みやび", "text": "…いくら待っても、\n期待には応えられん\nがよ。"},
        { "location": "267/TALK"  , "narrator": "繭", "text": "期待はしてませんが、\n何もないとも思えません。"},
        { "location": "268/TALK"  , "narrator": "繭", "text": "…まあ、私に話せない\n内容だというのであれば、\n詮索いたしませんが。"},
        { "location": "270/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "271/TALK"  , "narrator": "繭", "text": "話がないのであれば、\n私はこれで…。"},
        { "location": "274/TALK"  , "narrator": "みやび", "text": "神楽がスパイやった。"},
        { "location": "275/TALK"  , "narrator": "みやび", "text": "昨日の夜、つばめちゃんを\n殺そうとしよった。"},
        { "location": "276/TALK"  , "narrator": "みやび", "text": "最後は管理庁の\nヘリでどっか行って\nしもうた。"},
        { "location": "278/TALK"  , "narrator": "みやび", "text": "…以上や。"},
        { "location": "280/TALK"  , "narrator": "繭", "text": "…そうでしたか。"},
        { "location": "282/TALK"  , "narrator": "繭", "text": "逢瀬さんは\n無事ですか？"},
        { "location": "283/TALK"  , "narrator": "みやび", "text": "命に別状はない\nけんど、精神的には\nヤバそうや。"},
        { "location": "284/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "285/TALK"  , "narrator": "繭", "text": "みやび先輩は、\nどうですか？"},
        { "location": "286/TALK"  , "narrator": "みやび", "text": "…問題あるように\n見えるが？"},
        { "location": "287/TALK"  , "narrator": "みやび", "text": "うちは平気や。\nわかっちょるやろ。"},
        { "location": "288/TALK"  , "narrator": "繭", "text": "…そうですね。"},
        { "location": "289/TALK"  , "narrator": "繭", "text": "卯月さんには、\n前から怪しいところが\nありました。"},
        { "location": "290/TALK"  , "narrator": "繭", "text": "なので、今更過ぎる真実、\nといったところですね。"},
        { "location": "292/TALK"  , "narrator": "みやび", "text": "…そういうことや。"},
        { "location": "293/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "294/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "295/TALK"  , "narrator": "みやび", "text": "…腹減ったな。"},
        { "location": "296/TALK"  , "narrator": "繭", "text": "…そろそろお昼の\n時間ですね。"},
        { "location": "297/TALK"  , "narrator": "繭", "text": "何か、食べに行きますか？"},
        { "location": "299/TALK"  , "narrator": "みやび", "text": "何でもえいき、\nウサギが決めぃ。"},
        { "location": "300/TALK"  , "narrator": "繭", "text": "では、横須賀カレーは\nどうでしょうか？"},
        { "location": "301/TALK"  , "narrator": "みやび", "text": "ありえん。"},
        { "location": "302/TALK"  , "narrator": "みやび", "text": "このクソ暑い真夏に\nカレー食うとか、\n正気の沙汰やない。"},
        { "location": "303/TALK"  , "narrator": "みやび", "text": "うちは冷たいもん\n食べたいちや。"},
        { "location": "304/TALK"  , "narrator": "繭", "text": "そうですか…。\nでは、お蕎麦とか\nうどんは？"},
        { "location": "305/TALK"  , "narrator": "みやび", "text": "そんなもん、\nどこでも食えるやろ。"},
        { "location": "306/TALK"  , "narrator": "繭", "text": "…だとすると、後は…。"},
        { "location": "307/TALK"  , "narrator": "みやび", "text": "冷やし中華にするぞね。"},
        { "location": "308/TALK"  , "narrator": "繭", "text": "…は？"},
        { "location": "309/TALK"  , "narrator": "みやび", "text": "冷たいもん言うたら\nそれしかないやろ。"},
        { "location": "311/TALK"  , "narrator": "みやび", "text": "ほれ、付いてくるなら\nさっさとしぃ。"},
        { "location": "315/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "342/TALK"  , "narrator": "みやび", "text": "――とまあ、\nそういうわけながよ。"},
        { "location": "344/TALK"  , "narrator": "みやび", "text": "何の前触れもなく、\n急に卯月のヤツ、\n行動に出たんよ。"},
        { "location": "345/TALK"  , "narrator": "みやび", "text": "こっちも、四六時中\n卯月の監視なんぞ\nできんし。"},
        { "location": "346/TALK"  , "narrator": "みやび", "text": "対処しようもなくて、\n好き放題されまくった\nっちゅうことや。"},
        { "location": "347/TALK"  , "narrator": "繭", "text": "…正直あり得ません。"},
        { "location": "348/TALK"  , "narrator": "みやび", "text": "当然や。"},
        { "location": "349/TALK"  , "narrator": "みやび", "text": "…あの時も、もっと\n攻めの姿勢で行くべき\nやったのかもなぁ。"},
        { "location": "350/TALK"  , "narrator": "繭", "text": "…いつのことですか？"},
        { "location": "351/TALK"  , "narrator": "みやび", "text": "卯月がメノウっちゅう\nことが発覚した時に\n決まっちょる。"},
        { "location": "352/TALK"  , "narrator": "みやび", "text": "あの時点で管理庁が\n何か隠してるんは\n確実やったきね。"},
        { "location": "353/TALK"  , "narrator": "みやび", "text": "まほさんも、もっと\nしっかり追及するべき\nやったんよ。"},
        { "location": "354/TALK"  , "narrator": "みやび", "text": "ウサギはどう思う？"},
        { "location": "355/TALK"  , "narrator": "繭", "text": "同感です。"},
        { "location": "356/TALK"  , "narrator": "みやび", "text": "そうやろ？\nやっぱそうやろ？"},
        { "location": "357/TALK"  , "narrator": "みやび", "text": "まほさんも、\nお上相手に強気には\nなれんゆうことやな。"},
        { "location": "358/TALK"  , "narrator": "繭", "text": "…まあ、政府機関を\n気軽に敵に回すのは、\n得策ではありませんね。"},
        { "location": "360/TALK"  , "narrator": "みやび", "text": "まったく、\n情けない話やね…。"},
        { "location": "361/TALK"  , "narrator": "みやび", "text": "…それより、\n今はこっちの方が問題や。"},
        { "location": "362/TALK"  , "narrator": "みやび", "text": "何も横須賀まで来て、\n冷やし中華食うたんは\n失敗やったと思わんか？"},
        { "location": "363/TALK"  , "narrator": "みやび", "text": "こんなもん、\nどこでも食えるし。"},
        { "location": "365/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "366/TALK"  , "narrator": "みやび", "text": "口直しや。\nカレー食いに行こう。"},
        { "location": "368/TALK"  , "narrator": "繭", "text": "良いのですか？\nこんな真夏に\nカレーを食べて。"},
        { "location": "369/TALK"  , "narrator": "みやび", "text": "どうせ食うんは\nエアコン聞いた店内や。"},
        { "location": "370/TALK"  , "narrator": "みやび", "text": "季節なんぞ、\n関係ないちや。"},
        { "location": "371/TALK"  , "narrator": "繭", "text": "…なるほど。"},
        { "location": "372/TALK"  , "narrator": "みやび", "text": "偉大なる科学の力に\n感謝しぃ。"},
        { "location": "373/SEL"   , "narrator": "", "text": "ちょっとワガママ過ぎない？"},
        { "location": "374/ACT"   , "narrator": "", "text": "ちょっとワガママ過ぎない？"},
        { "location": "387/TALK"  , "narrator": "みやび", "text": "おやおやうちに文句か？"},
        { "location": "388/TALK"  , "narrator": "みやび", "text": "別に相棒には何も言ってない"},
        { "location": "389/TALK"  , "narrator": "みやび", "text": "それにうちは"},
        { "location": "390/TALK"  , "narrator": "みやび", "text": "マイペース"},
        { "location": "391/TALK"  , "narrator": "みやび", "text": "ワガママなんぞ言うてない"},
        { "location": "392/TALK"  , "narrator": "みやび", "text": "いつもと同じや"},
        { "location": "394/SEL"   , "narrator": "", "text": "色々大変だったしね"},
        { "location": "395/SEL"   , "narrator": "", "text": "なんか違う気がする"},
        { "location": "396/ACT"   , "narrator": "", "text": "色々大変だったしね"},
        { "location": "397/TALK"  , "narrator": "みやび", "text": "それには同意や"},
        { "location": "399/SEL"   , "narrator": "", "text": "今日はワガママでもいいよね"},
        { "location": "400/ACT"   , "narrator": "", "text": "今日はワガママでもいいよね"},
        { "location": "401/TALK"  , "narrator": "みやび", "text": "おや"},
        { "location": "402/TALK"  , "narrator": "みやび", "text": "相棒からの"},
        { "location": "403/TALK"  , "narrator": "みやび", "text": "労いはないと？"},
        { "location": "406/SEL"   , "narrator": "", "text": "なでなでしてあげよう"},
        { "location": "407/SEL"   , "narrator": "", "text": "打ち上げしようよ！"},
        { "location": "408/SEL"   , "narrator": "", "text": "繭と楽しんで"},
        { "location": "409/ACT"   , "narrator": "", "text": "なでなでしてあげよう"},
        { "location": "410/TALK"  , "narrator": "みやび", "text": "気持ちだけで"},
        { "location": "411/TALK"  , "narrator": "みやび", "text": "結構ぞね"},
        { "location": "412/ACT"   , "narrator": "", "text": "打ち上げしようよ！"},
        { "location": "413/TALK"  , "narrator": "みやび", "text": "こらこら"},
        { "location": "414/TALK"  , "narrator": "みやび", "text": "何も解決はしておらん"},
        { "location": "415/ACT"   , "narrator": "", "text": "繭と楽しんで"},
        { "location": "416/TALK"  , "narrator": "みやび", "text": "言われなくとも"},
        { "location": "417/TALK"  , "narrator": "みやび", "text": "ラブラブ女子会ぞね"},
        { "location": "418/TALK"  , "narrator": "みやび", "text": "妬いてもええぞ？"},
        { "location": "426/TALK"  , "narrator": "みやび", "text": "こんな簡単に\n乗せられて\nええんかいね？"},
        { "location": "427/ACT"   , "narrator": "", "text": "なんか違う気がする"},
        { "location": "428/TALK"  , "narrator": "みやび", "text": "そんなことはない"},
