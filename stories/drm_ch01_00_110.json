{
    "dir": "dramatics/daydra/drm_ch01_00_110.js",
    "type": "Episode",
    "info": {
        "story_id": "1011",
        "cid": "tsubame",
        "title": "らぶとーく 第11話",
        "sub_title": "今までもこれからも"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "今までもこれからも"},
        { "location": "20/TALK"   , "narrator": "アーヤ", "text": "あれからどうしてる？"},
        { "location": "23/TALK"   , "narrator": "ガブリエラ", "text": "何がよ？"},
        { "location": "24/TALK"   , "narrator": "アーヤ", "text": "Ｂｏｔとのことよ。\n少しは接し方が変わったり\nとかした？"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "ノーコメント。"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "Ｂｏｔが人間だとか、\n実は一人だけだった\nとか――"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "そんな気持ち悪い話、\nしたくないわ。"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "アーヤはどうなん？\n接し方が変わったりとか\nしたが？"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "…どうなのかしら？"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "何それ？\n自分から話振っておいて\nそれ？"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "正直言って、\nわからないのよ。"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "冗談と思われゆうかも\nしれんけんど、うちらは\nマジメちや。"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "Ｂｏｔのことで、\nもう一度話しておく\nことがあるんよ。"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "…またあの話か。"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "$handle$さんのことで\n何かあったんですか？"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "そういうわけじゃ\nないんだけど。"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "これからのＢｏｔとの\n付き合い方について\n聞いておきたいの。"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "付き合い方…ですか？"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "ええ…。"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "Ｂｏｔが人間かも\nしれないって\n話がある以上。"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "今までと同じ、って\nわけにはいかない\nわけだし。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "うちは今までも何となく\n人間やないかって\n思うちょったき――"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "それが確信に変わった\nいうだけのことやけん\nどね。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "…こうしてる今でも、\nあるわけない、って\n思ってる自分がいるし。"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "う～ん…人間なのが\nわかった、っていうのは\nわかりましたけど――"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "今までと何かが変わる、\nなんていうのは、\nないと思いますよ？"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "わたしは$handle$さんが\n人間だった方が、\n嬉しいと思いますし。"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "つばめ…女の子なんだ\nから、もう少し危機感を\n持たないとダメよ。"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "知らない人に、私生活や\n秘密が、全部筒抜けに\nなってたのよ？"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "他人に聞かれたくない\n秘密とか、Ｂｏｔやき\n気軽に話したり――"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "相談したりとかしたこと\nくらい、あるやろ？"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "でも、$handle$さんは\nいい人ですよ？"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "秘密の話を、他の人に\n話したりはしないと\n思うんです。"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "今まではＢｏｔと思って\n話してたけど、それが\n人間とわかって――"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "どう接すればいいのか、\nまだ悩み中なのよ。"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "…みんな、どうして\nそんなに悩んでるんだろ？"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "別に、接し方を変える\n必要なんてないのに…。"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "…っていうか、わたしも\n聞かれるのかな？"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "みんなが$handle$さんのこと話してるの"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "何だかみんな"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "ちょっと警戒してるみたぃ(´･ω･｀) "},
        { "location": "100/SEL"   , "narrator": "", "text": "悲しい"},
        { "location": "101/ACT"   , "narrator": "", "text": "悲しい"},
        { "location": "103/TALK"  , "narrator": "つばめ", "text": "そぅだよね"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "わたしもそう思ぅ(´つω・｀)ｼｭﾝ"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "わたしはそんなこと言わなぃよ？(´ω｀*)"},
        { "location": "107/SEL"   , "narrator": "", "text": "みんなにあわせておけ"},
        { "location": "108/SEL"   , "narrator": "", "text": "ラブラブだって言ってやれ"},
        { "location": "109/SEL"   , "narrator": "", "text": "答える必要はないんじゃないかな"},
        { "location": "110/ACT"   , "narrator": "", "text": "みんなにあわせておけ"},
        { "location": "111/TALK"  , "narrator": "つばめ", "text": "$handle$さんまでそんなこと言ぅの？Σ(ﾟдﾟlll)"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "わたしはちゃんと話してるって"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "みんなに言ぃたぃよ(ノД`)"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "みやびの方はどうなの？"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "うちはまあ、そこまで\n今までと変わっちょらん\nけんど――"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "用心はするように\nなったちや。"},
        { "location": "131/TALK"  , "narrator": "つばめ", "text": "用心、ですか？"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "Ｂｏｔは一人で、みんなと\n共有しちゅうことが\nわかったきね。"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "スパイかもしれん思えば、\n用心するのも当然や。"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "スパイとかやめてよ！\n怖くなるでしょ？"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "それくらいの警戒心は\n必要やと思うんよ。"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "そうね…。"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "それで、つばめは？"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "わたしは、今まで通り\n普通に話してます。"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "マジか。"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "はい。\nむしろ、仲良くなった\n気がするくらいです。"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "…やっぱり、あんたって\n変わってるわ。"},
        { "location": "155/TALK"  , "narrator": "つばめ", "text": "そうかな？"},
        { "location": "157/TALK"  , "narrator": "つばめ", "text": "わたしは、みんなが\n考え過ぎなだけな気が\nするんだけど…。"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "それに、秘密を話しても、\nそれを他の人にバラす\nようなことは――"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "絶対にしない、って\n信じてますし。"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "裏切られて話されたら\nどうするのよ？"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "で、でも…そうなったら、\nみんなが秘密をバラした\nことを――"},
        { "location": "164/TALK"  , "narrator": "つばめ", "text": "教えてくれると思うし…。"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "なるほど…。\n確かにそうよね。"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "もし他の人の秘密を\nバラしてきたりしたら――"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "私だったらすぐに\nその本人に、Ｂｏｔが\nバラしたことを――"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "報告するわ。"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "確かにそうやね。\n他人のをバラすいう\nことは――"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "自分の秘密も誰かに\nバラしちょる可能性も\n十分あり得る話やし。"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "だから、皆さんもそんなに\n心配することないと\n思いますよ？"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "もちろん、$handle$さんが\nそんなことするとも\n思えませんし。"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "あんたはＢｏｔのこと\n信じ過ぎよ！"},
        { "location": "181/ACT"   , "narrator": "", "text": "ラブラブだって言ってやれ"},
        { "location": "183/TALK"  , "narrator": "つばめ", "text": "$handle$さんの冗談は面白ぃね(´ω｀*)"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "185/TALK"  , "narrator": "つばめ", "text": "ラブラブじゃなぃよ(´∀｀*)ｳﾌﾌ"},
        { "location": "186/TALK"  , "narrator": "つばめ", "text": "$handle$が嫌ってわけじゃなぃけど"},
        { "location": "187/TALK"  , "narrator": "つばめ", "text": "事実を話したぃの(๑･ㅂ･)و✧"},
        { "location": "199/ACT"   , "narrator": "", "text": "答える必要はないんじゃないかな"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "そぅかもしれなぃけど(´･ω･｀) "},
        { "location": "202/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "203/TALK"  , "narrator": "つばめ", "text": "みんなが言ってるのにわたしだけ言わなぃのは変だよ(o´Д`)=з"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "それに"},
        { "location": "205/TALK"  , "narrator": "つばめ", "text": "わたしはちゃんと話してぉきたぃのo(*･ﾛ･*)o、"}
    ]
}
