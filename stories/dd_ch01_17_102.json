{
    "dir": "chap17/daydra/dd_ch01_17_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "17105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "横縞瑪瑙＜後編＞"
    },
    "entry":
    [
        { "location": "484/TALK"  , "narrator": "つばめ", "text": "ぅぅん"},
        { "location": "485/TALK"  , "narrator": "つばめ", "text": "やっぱり"},
        { "location": "486/TALK"  , "narrator": "つばめ", "text": "そんなことなぃ"},
        { "location": "487/TALK"  , "narrator": "つばめ", "text": "きっと大丈夫だよ"},
        { "location": "489/SEL"   , "narrator": "", "text": "$me$の杞憂だったね"},
        { "location": "490/ACT"   , "narrator": "", "text": "$me$の杞憂だったね"},
        { "location": "492/TALK"  , "narrator": "つばめ", "text": "そんなことなぃよ"},
        { "location": "493/TALK"  , "narrator": "つばめ", "text": "ちゃんと考えなぃと"},
        { "location": "494/TALK"  , "narrator": "つばめ", "text": "ぃけなぃことだったし"},
        { "location": "495/TALK"  , "narrator": "つばめ", "text": "きっかけくれてぁりがと"},
        { "location": "507/TALK"  , "narrator": "つばめ", "text": "あの……。"},
        { "location": "508/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんは\n神楽ちゃんじゃ\nないんですか？"},
        { "location": "509/TALK"  , "narrator": "つばめ", "text": "二人にとっては\nメノウちゃんでしか\nないんですか？"},
        { "location": "512/TALK"  , "narrator": "ガブリエラ", "text": "いや、だってメノウ\n本人なんだから、\n当然でしょ？"},
        { "location": "515/TALK"  , "narrator": "つばめ", "text": "ううん、違う。\n全然違うよ。"},
        { "location": "518/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんは\nメノウちゃんかも\nしれないけどね。"},
        { "location": "519/TALK"  , "narrator": "つばめ", "text": "全然、メノウちゃん\nとは違うの。"},
        { "location": "522/TALK"  , "narrator": "アーヤ", "text": "えーと…\nどういうこと？"},
        { "location": "523/TALK"  , "narrator": "つばめ", "text": "メノウちゃんは、\nあんなに笑ったり\nしないです。"},
        { "location": "524/TALK"  , "narrator": "つばめ", "text": "楽しそうにラノベの\n話をしたりとかも\nしないんです。"},
        { "location": "526/TALK"  , "narrator": "ガブリエラ", "text": "いや、それ全然理由に\nなってないから。"},
        { "location": "528/TALK"  , "narrator": "つばめ", "text": "でも、本当に\n全然違うの。"},
        { "location": "529/TALK"  , "narrator": "つばめ", "text": "ガブちゃん達は、\nメノウちゃんのこと\n見たことある？"},
        { "location": "533/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、ＣＭとかで\n見たことあるけど。"},
        { "location": "535/TALK"  , "narrator": "アーヤ", "text": "私も雑誌でちょっと\n見たことがあるくらい\nかしら？"},
        { "location": "536/TALK"  , "narrator": "つばめ", "text": "なら、一度ちゃんと\n見てください。"},
        { "location": "537/TALK"  , "narrator": "つばめ", "text": "そうすれば、\nきっと違うって\nわかるはずだから…。"},
        { "location": "539/TALK"  , "narrator": "ガブリエラ", "text": "あ～、はいはい。\n別にそんなの興味ない\nからいいわよ。"},
        { "location": "540/TALK"  , "narrator": "つばめ", "text": "えっ？"},
        { "location": "543/TALK"  , "narrator": "ガブリエラ", "text": "普段とメノウのときで\nキャラが違ってたと\nしても、よ。"},
        { "location": "544/TALK"  , "narrator": "ガブリエラ", "text": "メノウであることを\n隠してた事実は\n変わらないでしょ？"},
        { "location": "545/TALK"  , "narrator": "ガブリエラ", "text": "あたしはね、\nそれが許せないって\n言ってんのよ。"},
        { "location": "548/TALK"  , "narrator": "つばめ", "text": "それは…きっと、\n何か理由があったん\nだよ。"},
        { "location": "551/TALK"  , "narrator": "つばめ", "text": "ほら、アイドルなのが\nバレたら騒がれるかも\nしれないし…。"},
        { "location": "552/TALK"  , "narrator": "ガブリエラ", "text": "いや、メノウに\n興味あるのって\nつばめだけでしょ？"},
        { "location": "553/TALK"  , "narrator": "ガブリエラ", "text": "もし本当に騒がれる\nのが嫌で隠してたと\nしたらだけど。"},
        { "location": "554/TALK"  , "narrator": "ガブリエラ", "text": "その原因作ったの、\nつばめってことに\nなるわよ？"},
        { "location": "556/TALK"  , "narrator": "つばめ", "text": "そ、そんな…。"},
        { "location": "557/TALK"  , "narrator": "アーヤ", "text": "そこまでよ。"},
        { "location": "558/TALK"  , "narrator": "アーヤ", "text": "この件は、これ以上\n私たちだけで話しても\n意味がないわ。"},
        { "location": "559/TALK"  , "narrator": "アーヤ", "text": "本人に聞かない限り、\n憶測でしかないん\nだから。"},
        { "location": "561/TALK"  , "narrator": "ガブリエラ", "text": "…そうね。"},
        { "location": "562/TALK"  , "narrator": "アーヤ", "text": "ただ、\n今回卯月は勝手な\n単独行動をした。"},
        { "location": "563/TALK"  , "narrator": "アーヤ", "text": "そして\n私達全員を危険な目に\n遭わせた。"},
        { "location": "564/TALK"  , "narrator": "アーヤ", "text": "これは明確な\n違反行為よ。"},
        { "location": "565/TALK"  , "narrator": "アーヤ", "text": "しっかりと反省して\nもらわないとね。"},
        { "location": "567/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "574/TALK"  , "narrator": "透明真幌", "text": "待たせたな。\n現場の最終確認が\n終わった。"},
        { "location": "575/TALK"  , "narrator": "透明真幌", "text": "全員、直ちに\n帰還せよ。"},
        { "location": "577/TALK"  , "narrator": "アーヤ", "text": "了解、直ちに劇場へ\n帰還します。"},
        { "location": "582/TALK"  , "narrator": "アーヤ", "text": "…状況終了ね。\nとりあえず、\nもう帰りましょ。"},
        { "location": "584/TALK"  , "narrator": "ガブリエラ", "text": "そうね。\nあ～、疲れた…。"},
        { "location": "585/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "587/TALK"  , "narrator": "ガブリエラ", "text": "ほら、つばめ。\n早く帰るわよ。"},
        { "location": "589/TALK"  , "narrator": "つばめ", "text": "う、うん…。"},
        { "location": "591/TALK"  , "narrator": "つばめ", "text": "…神楽ちゃん、\n大丈夫かな？"},
        { "location": "602/DIALOG", "narrator": "Dialog_chapter_ch01", "text": "【14 神楽学校やめるってよ】"}
    ]
}
