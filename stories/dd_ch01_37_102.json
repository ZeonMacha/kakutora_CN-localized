{
    "dir": "chap37/daydra/dd_ch01_37_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "37105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "そして、わたしも＜後編＞"
    },
    "entry":
    [
        { "location": "776/TALK"  , "narrator": "つばめ", "text": "…ここはわたしが\n創った世界だけど。"},
        { "location": "777/TALK"  , "narrator": "つばめ", "text": "色んな人が\n育てた世界なんだ…。"},
        { "location": "778/SEL"   , "narrator": "", "text": "元気？"},
        { "location": "779/SEL"   , "narrator": "", "text": "少し話せる？"},
        { "location": "780/SEL"   , "narrator": "", "text": "$me$を恨んでる？"},
        { "location": "781/ACT"   , "narrator": "", "text": "元気？"},
        { "location": "783/TALK"  , "narrator": "つばめ", "text": "うん。\n平気だよ。"},
        { "location": "784/ACT"   , "narrator": "", "text": "少し話せる？"},
        { "location": "786/TALK"  , "narrator": "つばめ", "text": "はい。\n大丈夫。"},
        { "location": "787/ACT"   , "narrator": "", "text": "$me$を恨んでる？"},
        { "location": "788/TALK"  , "narrator": "つばめ", "text": "なんで？\nそんなわけないよ。"},
        { "location": "790/TALK"  , "narrator": "つばめ", "text": "$handle$さん、\nあのね。"},
        { "location": "791/TALK"  , "narrator": "つばめ", "text": "わたし、この世界を\n続けたい。"},
        { "location": "792/TALK"  , "narrator": "つばめ", "text": "みんなが幸せに暮らせる\n平凡で普通な、\n退屈だけど平和な世界を。"},
        { "location": "793/SEL"   , "narrator": "", "text": "そっか"},
        { "location": "794/SEL"   , "narrator": "", "text": "決めたんだね"},
        { "location": "795/SEL"   , "narrator": "", "text": "いいことだと思うよ"},
        { "location": "796/ACT"   , "narrator": "", "text": "そっか"},
        { "location": "797/TALK"  , "narrator": "つばめ", "text": "うん。\n今のみんなと\n一緒にいたい。"},
        { "location": "798/ACT"   , "narrator": "", "text": "決めたんだね"},
        { "location": "799/TALK"  , "narrator": "つばめ", "text": "そう。\n決めたんだ。"},
        { "location": "800/ACT"   , "narrator": "", "text": "いいことだと思うよ"},
        { "location": "801/TALK"  , "narrator": "つばめ", "text": "本当にそう\n思ってくれる…？"},
        { "location": "803/TALK"  , "narrator": "つばめ", "text": "でもね。"},
        { "location": "805/TALK"  , "narrator": "つばめ", "text": "わたしがそう思うだけで\n本当に実現\nするのかな？"},
        { "location": "806/SEL"   , "narrator": "", "text": "$me$を信じて"},
        { "location": "807/SEL"   , "narrator": "", "text": "$me$が言うこと信用できない？"},
        { "location": "808/SEL"   , "narrator": "", "text": "だってつばめの世界だよ！"},
        { "location": "809/ACT"   , "narrator": "", "text": "$me$を信じて"},
        { "location": "810/TALK"  , "narrator": "つばめ", "text": "…うん。\nそうだね。"},
        { "location": "811/ACT"   , "narrator": "", "text": "$me$が言うこと信用できない？"},
        { "location": "812/TALK"  , "narrator": "つばめ", "text": "そんなわけないよ！"},
        { "location": "813/ACT"   , "narrator": "", "text": "だってつばめの世界だよ！"},
        { "location": "814/TALK"  , "narrator": "つばめ", "text": "わたしの、世界…。"},
        { "location": "816/TALK"  , "narrator": "つばめ", "text": "…わたしね。"},
        { "location": "817/TALK"  , "narrator": "つばめ", "text": "ずっと今まで\n何をするにも\n自信がなくて。"},
        { "location": "818/TALK"  , "narrator": "つばめ", "text": "辛かったの。\n何かをするのが。"},
        { "location": "819/TALK"  , "narrator": "つばめ", "text": "でもね。\n$handle$さんが\nわたしに自信をくれた。"},
        { "location": "820/TALK"  , "narrator": "つばめ", "text": "側にいてくれて、\n励ましてくれて、\n頑張ってくれたから。"},
        { "location": "821/TALK"  , "narrator": "つばめ", "text": "わたしは少し\n変わることができた。"},
        { "location": "822/TALK"  , "narrator": "つばめ", "text": "この世界を続けたいって\n決心ができたのも。"},
        { "location": "823/TALK"  , "narrator": "つばめ", "text": "$handle$さんが\nいてくれたからだよ。"},
        { "location": "824/TALK"  , "narrator": "つばめ", "text": "$handle$さんは\nこの日本も護って\nくれてたんだね。"},
        { "location": "826/TALK"  , "narrator": "つばめ", "text": "この先も、この世界を\n護ってくれるんだね。"},
        { "location": "827/SEL"   , "narrator": "", "text": "まだわからないけど"},
        { "location": "828/SEL"   , "narrator": "", "text": "そういうことになるのかな"},
        { "location": "829/SEL"   , "narrator": "", "text": "努力するよ"},
        { "location": "830/ACT"   , "narrator": "", "text": "まだわからないけど"},
        { "location": "831/TALK"  , "narrator": "つばめ", "text": "…そうだね。\nでもきっと\nそうなるんだよね。"},
        { "location": "832/ACT"   , "narrator": "", "text": "そういうことになるのかな"},
        { "location": "833/TALK"  , "narrator": "つばめ", "text": "そうでしょ？\n…違うかな？"},
        { "location": "834/ACT"   , "narrator": "", "text": "努力するよ"},
        { "location": "835/TALK"  , "narrator": "つばめ", "text": "…うん。\nありがとう。"},
        { "location": "837/TALK"  , "narrator": "つばめ", "text": "$handle$さんは\nいつもわたしのために\n頑張ってくれたよね。"},
        { "location": "838/TALK"  , "narrator": "つばめ", "text": "大変なことも\nあったはずなのに。"},
        { "location": "839/TALK"  , "narrator": "つばめ", "text": "だから今度は\nわたしが頑張らなきゃ。"},
        { "location": "840/TALK"  , "narrator": "つばめ", "text": "もし辛いことがあっても\nそれって必要な\nことだと思ってる。"},
        { "location": "841/TALK"  , "narrator": "つばめ", "text": "わたしの中で\n$handle$さんは\n世界そのものなんだ。"},
        { "location": "845/TALK"  , "narrator": "つばめ", "text": "…わたし、\n$handle$さんに\n会いたい。"},
        { "location": "846/TALK"  , "narrator": "つばめ", "text": "だって\n$handle$さんは\n特別な人だから。"},
        { "location": "847/TALK"  , "narrator": "つばめ", "text": "もっと近くにいたい。\nそれからお話だって。"},
        { "location": "848/SEL"   , "narrator": "", "text": "いつもしてるよね？"},
        { "location": "849/SEL"   , "narrator": "", "text": "急にどうしたの"},
        { "location": "850/SEL"   , "narrator": "", "text": "今までとは違うの？"},
        { "location": "851/ACT"   , "narrator": "", "text": "いつもしてるよね？"},
        { "location": "852/TALK"  , "narrator": "つばめ", "text": "してるけど。\nしてたけど。\nこんなんじゃなくて。"},
        { "location": "853/TALK"  , "narrator": "つばめ", "text": "もっと全然\n近くなりたいの。"},
        { "location": "854/ACT"   , "narrator": "", "text": "急にどうしたの"},
        { "location": "855/TALK"  , "narrator": "つばめ", "text": "わかんない。\n自分でもびっくり\nしてる。"},
        { "location": "856/TALK"  , "narrator": "つばめ", "text": "でもこの気持ちは\n本当だから。"},
        { "location": "857/ACT"   , "narrator": "", "text": "今までとは違うの？"},
        { "location": "858/TALK"  , "narrator": "つばめ", "text": "全然違うよ！"},
        { "location": "859/TALK"  , "narrator": "つばめ", "text": "$handle$さんって\n思っただけで\nドキドキするの。"},
        { "location": "861/SEL"   , "narrator": "", "text": "$me$に恋したんだね"},
        { "location": "862/SEL"   , "narrator": "", "text": "$me$はずっとそう思ってたよ"},
        { "location": "863/SEL"   , "narrator": "", "text": "つばめ愛してる"},
        { "location": "864/ACT"   , "narrator": "", "text": "$me$に恋したんだね"},
        { "location": "865/TALK"  , "narrator": "つばめ", "text": "恋！？"},
        { "location": "866/TALK"  , "narrator": "つばめ", "text": "でもこれは\n恋よりもっと\n大事な気持ちだよ。"},
        { "location": "867/ACT"   , "narrator": "", "text": "$me$はずっとそう思ってたよ"},
        { "location": "868/TALK"  , "narrator": "つばめ", "text": "そうだったの！？"},
        { "location": "869/TALK"  , "narrator": "つばめ", "text": "でもそうだよね…。\nそんな気がしてた。"},
        { "location": "870/ACT"   , "narrator": "", "text": "つばめ愛してる"},
        { "location": "871/TALK"  , "narrator": "つばめ", "text": "…わたしも。\n$handle$さんを\n愛してる。"},
        { "location": "872/TALK"  , "narrator": "つばめ", "text": "でもそれよりうんと\n大事なものなの。\nこの気持ちは。"},
        { "location": "874/TALK"  , "narrator": "つばめ", "text": "なんでだろう。"},
        { "location": "875/TALK"  , "narrator": "つばめ", "text": "$handle$さんとは\nずっと一緒にいたのに。"},
        { "location": "876/TALK"  , "narrator": "つばめ", "text": "今急にすごく\n$handle$さんへの\n気持ちが溢れてる。"},
        { "location": "878/TALK"  , "narrator": "つばめ", "text": "不思議……。"},
        { "location": "880/TALK"  , "narrator": "つばめ", "text": "この先がどうなるかは\nまだわからないけど。"},
        { "location": "881/TALK"  , "narrator": "つばめ", "text": "わたしは今とても\n幸せだよ。"},
        { "location": "882/TALK"  , "narrator": "つばめ", "text": "$handle$さんが\n色々考えて\n決めてくれたから。"},
        { "location": "884/TALK"  , "narrator": "つばめ", "text": "…変かな？\nそんなことないよね。"},
        { "location": "885/TALK"  , "narrator": "つばめ", "text": "だってわたしのことを\n一番考えてくれた\n$handle$さんが。"},
        { "location": "886/TALK"  , "narrator": "つばめ", "text": "うんと考えて\n決めてくれたんだもん。"},
        { "location": "887/TALK"  , "narrator": "つばめ", "text": "それって幸せな\nことだよね。"},
        { "location": "888/TALK"  , "narrator": "つばめ", "text": "それでね、わたし、\nそのことが嬉しいの。"},
        { "location": "889/TALK"  , "narrator": "つばめ", "text": "だから、この先に\n何があっても。"},
        { "location": "890/TALK"  , "narrator": "つばめ", "text": "$handle$さんを\n信じて生きてく。"},
        { "location": "891/TALK"  , "narrator": "つばめ", "text": "$handle$さんは\nわたしの希望だから。"},
        { "location": "892/TALK"  , "narrator": "つばめ", "text": "ありがとう。"},
        { "location": "893/TALK"  , "narrator": "つばめ", "text": "そんな言葉じゃ\n足りないけど。\n他に思いつかなくて。"},
        { "location": "895/TALK"  , "narrator": "つばめ", "text": "ありがとう。\n本当にありがとう。"},
        { "location": "896/TALK"  , "narrator": "つばめ", "text": "大好き。"},
        { "location": "772/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "907/DIALOG", "narrator": "Dialog_chapter_ch01", "text": "【MV EXE_TSuBaMe】"}
    ]
}
