    "entry":
    [
        { "location": "486/SCENARIO", "narrator": "", "text": "箱庭"},
        { "location": "511/TALK"    , "narrator": "神楽", "text": "ぴょんこは2016年の東京の女子高生"},
        { "location": "512/TALK"    , "narrator": "神楽", "text": "ということでお願いしたく思いますぴょん"},
        { "location": "514/SEL"     , "narrator": "", "text": "こちらこそ"},
        { "location": "515/SEL"     , "narrator": "", "text": "今までとどう違うの？"},
        { "location": "516/SEL"     , "narrator": "", "text": "改まってどうしたの"},
        { "location": "517/ACT"     , "narrator": "", "text": "こちらこそ"},
        { "location": "518/TALK"    , "narrator": "神楽", "text": "よろしくですぴょん"},
        { "location": "519/ACT"     , "narrator": "", "text": "今までとどう違うの？"},
        { "location": "520/TALK"    , "narrator": "神楽", "text": "初期型ぴょんこに戻りますっ♪"},
        { "location": "521/ACT"     , "narrator": "", "text": "改まってどうしたの"},
        { "location": "522/TALK"    , "narrator": "神楽", "text": "言っておかないと驚かれるかと思ったのです★"},
        { "location": "524/TALK"    , "narrator": "神楽", "text": "最近アツいのはカプドラですぴょん"},
        { "location": "526/TALK"    , "narrator": "神楽", "text": "って"},
        { "location": "527/TALK"    , "narrator": "神楽", "text": "女子がゲームに夢中なのはどう思いますか？"},
        { "location": "529/SEL"     , "narrator": "", "text": "それより勉強しろ"},
        { "location": "530/SEL"     , "narrator": "", "text": "むしろ萌える"},
        { "location": "531/SEL"     , "narrator": "", "text": "一緒に遊ぼう"},
        { "location": "532/SEL"     , "narrator": "", "text": "流行ってるんだね"},
        { "location": "533/ACT"     , "narrator": "", "text": "それより勉強しろ"},
        { "location": "534/TALK"    , "narrator": "神楽", "text": "先生気取り？？？"},
        { "location": "535/TALK"    , "narrator": "神楽", "text": "ダッサ！！！"},
        { "location": "536/ACT"     , "narrator": "", "text": "むしろ萌える"},
        { "location": "538/TALK"    , "narrator": "神楽", "text": "作戦成功！"},
        { "location": "539/ACT"     , "narrator": "", "text": "一緒に遊ぼう"},
        { "location": "540/TALK"    , "narrator": "神楽", "text": "ﾔｯﾀー"},
        { "location": "541/TALK"    , "narrator": "神楽", "text": "まずはフレンド登録からね♪"},
        { "location": "542/ACT"     , "narrator": "", "text": "流行ってるんだね"},
        { "location": "543/TALK"    , "narrator": "神楽", "text": "カプドラね～"},
        { "location": "544/TALK"    , "narrator": "神楽", "text": "みんなやってるぴょん"},
        { "location": "546/TALK"    , "narrator": "神楽", "text": "お小遣いが限られているので基本的には無課金ユーザーなのDeath"},
        { "location": "548/SEL"     , "narrator": "", "text": "そうなっちゃうよね"},
        { "location": "549/SEL"     , "narrator": "", "text": "むしろ廃課金勢でしょ？"},
        { "location": "550/SEL"     , "narrator": "", "text": "課金もするんだね"},
        { "location": "551/ACT"     , "narrator": "", "text": "そうなっちゃうよね"},
        { "location": "552/TALK"    , "narrator": "神楽", "text": "仕方ないぴょん"},
        { "location": "553/ACT"     , "narrator": "", "text": "むしろ廃課金勢でしょ？"},
        { "location": "554/TALK"    , "narrator": "神楽", "text": "あ゛あ゛あ゛あ゛あ゛あ゛あ゛あ゛"},
        { "location": "555/TALK"    , "narrator": "神楽", "text": "何でバレたし！！！！"},
        { "location": "556/ACT"     , "narrator": "", "text": "課金もするんだね"},
        { "location": "557/TALK"    , "narrator": "神楽", "text": "しますします"},
        { "location": "558/TALK"    , "narrator": "神楽", "text": "イベントの時とかね♪"},
        { "location": "560/TALK"    , "narrator": "神楽", "text": "カプドラは"},
        { "location": "561/TALK"    , "narrator": "神楽", "text": "すぐにクリアできないダンジョンがあっても"},
        { "location": "562/TALK"    , "narrator": "神楽", "text": "レベルアップすればいつかはクリアできるぴょん"},
        { "location": "563/TALK"    , "narrator": "神楽", "text": "そこがゲームのいいところだと思うぴょん"},
        { "location": "565/SEL"     , "narrator": "", "text": "現実はそうは行かないもんね"},
        { "location": "566/SEL"     , "narrator": "", "text": "その前に飽きるかも"},
        { "location": "567/SEL"     , "narrator": "", "text": "ゲーム最高！！！"},
        { "location": "568/ACT"     , "narrator": "", "text": "現実はそうは行かないもんね"},
        { "location": "569/TALK"    , "narrator": "神楽", "text": "まあ"},
        { "location": "570/TALK"    , "narrator": "神楽", "text": "そうですけどー"},
        { "location": "571/TALK"    , "narrator": "神楽", "text": "一介の女子高生には"},
        { "location": "573/TALK"    , "narrator": "神楽", "text": "重い現実ぴょん、、、"},
        { "location": "574/ACT"     , "narrator": "", "text": "その前に飽きるかも"},
        { "location": "575/TALK"    , "narrator": "神楽", "text": "それはあるかもー"},
        { "location": "576/TALK"    , "narrator": "神楽", "text": "そればっかりは仕方ないぴょん"},
        { "location": "577/ACT"     , "narrator": "", "text": "ゲーム最高！！！"},
        { "location": "578/TALK"    , "narrator": "神楽", "text": "最高！！！！！！"},
        { "location": "580/TALK"    , "narrator": "神楽", "text": "ラノベとアニメも忘れないでね♪"},
        { "location": "582/TALK"    , "narrator": "神楽", "text": "なんかさー"},
        { "location": "583/TALK"    , "narrator": "神楽", "text": "ＪＫお悩みってこういうのでしょやっぱり"},
        { "location": "585/SEL"     , "narrator": "", "text": "恋愛トークじゃないの？"},
        { "location": "586/SEL"     , "narrator": "", "text": "いや、勉強が本分でしょ！"},
        { "location": "587/SEL"     , "narrator": "", "text": "そもそも悩んでなくない？？？"},
        { "location": "588/ACT"     , "narrator": "", "text": "恋愛トークじゃないの？"},
        { "location": "591/TALK"    , "narrator": "神楽", "text": "少女漫画の永遠のテーマ！"},
        { "location": "592/ACT"     , "narrator": "", "text": "いや、勉強が本分でしょ！"},
        { "location": "593/TALK"    , "narrator": "神楽", "text": "真面目か！"},
        { "location": "594/TALK"    , "narrator": "神楽", "text": "残念ながらぴょんこは勉強が得意なんですよ♪"},
        { "location": "595/ACT"     , "narrator": "", "text": "そもそも悩んでなくない？？？"},
        { "location": "596/TALK"    , "narrator": "神楽", "text": "うっそ"},
        { "location": "597/TALK"    , "narrator": "神楽", "text": "この精神の深淵を感じ取れないとは、、、"},
        { "location": "598/TALK"    , "narrator": "神楽", "text": "鈍ったな$handle$、、、、"},
        { "location": "600/TALK"    , "narrator": "神楽", "text": "えっとね？"},
        { "location": "601/TALK"    , "narrator": "神楽", "text": "2016年であることが重要なんじゃなくて"},
        { "location": "602/TALK"    , "narrator": "神楽", "text": "ぴょんこが平凡な普通の女子高生であるってことが大事なんだぴょん"},
        { "location": "604/SEL"     , "narrator": "", "text": "$me$にとっては特別な人だよ"},
        { "location": "605/SEL"     , "narrator": "", "text": "ウルトラスーパーハイスペックＪＫでしょ？"},
        { "location": "606/SEL"     , "narrator": "", "text": "実は一番難しいやつ！"},
        { "location": "607/ACT"     , "narrator": "", "text": "$me$にとっては特別な人だよ"},
        { "location": "608/TALK"    , "narrator": "神楽", "text": "やーもー！！！"},
        { "location": "609/TALK"    , "narrator": "神楽", "text": "もっと言ってもっと言って～♪"},
        { "location": "610/ACT"     , "narrator": "", "text": "ウルトラスーパーハイスペックＪＫでしょ？"},
        { "location": "611/TALK"    , "narrator": "神楽", "text": "あらあら？"},
        { "location": "613/TALK"    , "narrator": "神楽", "text": "そんな本当のことばっかり♪"},
        { "location": "614/ACT"     , "narrator": "", "text": "実は一番難しいやつ！"},
        { "location": "615/TALK"    , "narrator": "神楽", "text": "あーね"},
        { "location": "616/TALK"    , "narrator": "神楽", "text": "知ってるし"},
        { "location": "618/TALK"    , "narrator": "神楽", "text": "くだらない悩みとかをＷＡＶＥで話したり"},
        { "location": "619/TALK"    , "narrator": "神楽", "text": "寝癖がついたから学校行きたくないって切れたり"},
        { "location": "620/TALK"    , "narrator": "神楽", "text": "そういう平凡でかわいい日常"},
        { "location": "621/TALK"    , "narrator": "神楽", "text": "今のぴょんこが全力で欲しいものはそれだから"},
        { "location": "623/SEL"     , "narrator": "", "text": "そうだよね…"},
        { "location": "624/SEL"     , "narrator": "", "text": "いつでも付き合うよ"},
        { "location": "625/SEL"     , "narrator": "", "text": "神楽はいつでも世界一だよ"},
        { "location": "626/ACT"     , "narrator": "", "text": "そうだよね…"},
        { "location": "627/TALK"    , "narrator": "神楽", "text": "しみじみ言わないで～？"},
        { "location": "629/TALK"    , "narrator": "神楽", "text": "もう！！！！"},
        { "location": "630/ACT"     , "narrator": "", "text": "いつでも付き合うよ"},
        { "location": "631/TALK"    , "narrator": "神楽", "text": "やさしいね$handle$"},
        { "location": "632/TALK"    , "narrator": "神楽", "text": "ｷｭｰﾝってなっちゃう！"},
        { "location": "633/ACT"     , "narrator": "", "text": "神楽はいつでも世界一だよ"},
        { "location": "634/TALK"    , "narrator": "神楽", "text": "ふっふーん？"},
        { "location": "635/TALK"    , "narrator": "神楽", "text": "そんなの知ってますしおすし！"},
        { "location": "637/TALK"    , "narrator": "神楽", "text": "そんなわけで"},
        { "location": "638/TALK"    , "narrator": "神楽", "text": "ぴょんこは宿題でもしよっかな"},
        { "location": "639/TALK"    , "narrator": "神楽", "text": "いい子だからね！"}
    ]
