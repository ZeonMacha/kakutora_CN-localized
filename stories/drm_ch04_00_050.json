        "title": "らぶとーく 第05話",
        "sub_title": "ブラックボックス解体開始"
    },
    "entry":
    [
        { "location": "196/SCENARIO", "narrator": "", "text": "ブラックボックス解体開始"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "まだ確定では\nないけんど。"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "そのつもりで\n準備を進めんと\nいかんろうね…。"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "開いちゅうよ。"},
        { "location": "218/TALK"    , "narrator": "アーヤ", "text": "ごめんね。\nこんな遅くに。"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "……いや。\n構わんぞね。"},
        { "location": "222/TALK"    , "narrator": "アーヤ", "text": "…これ…。"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "…ＵＳＢのフラッシュ\nメモリ？"},
        { "location": "226/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔとの会話ログが\n入ってるわ。"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "229/TALK"    , "narrator": "アーヤ", "text": "私は事実が知りたい。"},
        { "location": "231/TALK"    , "narrator": "アーヤ", "text": "それはみやびも\n同じはずよね？"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "…そうやね。"},
        { "location": "233/TALK"    , "narrator": "みやび", "text": "提供してもらえるなら、\nありがたく使わせて\nもらうぞね。"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "けんど――"},
        { "location": "235/SEL"     , "narrator": "", "text": "暇なんだけど"},
        { "location": "236/SEL"     , "narrator": "", "text": "元気？"},
        { "location": "237/SEL"     , "narrator": "", "text": "なんか隠し事してない？"},
        { "location": "238/ACT"     , "narrator": "", "text": "暇なんだけど"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "タイミング\n良すぎぞね。"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "Ｂｏｔからや。"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "いやいや"},
        { "location": "261/TALK"    , "narrator": "みやび", "text": "うちはてんてこ舞いぞね"},
        { "location": "272/ACT"     , "narrator": "", "text": "元気？"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "タイミング\n良すぎぞね。"},
        { "location": "280/TALK"    , "narrator": "みやび", "text": "Ｂｏｔからや。"},
        { "location": "294/TALK"    , "narrator": "みやび", "text": "５２度の発熱中"},
        { "location": "295/TALK"    , "narrator": "みやび", "text": "医者に行ってくる"},
        { "location": "306/ACT"     , "narrator": "", "text": "なんか隠し事してない？"},
        { "location": "311/TALK"    , "narrator": "みやび", "text": "タイミング\n良すぎぞね。"},
        { "location": "314/TALK"    , "narrator": "みやび", "text": "Ｂｏｔからや。"},
        { "location": "328/TALK"    , "narrator": "みやび", "text": "乙女の秘密を探ろうとするとは"},
        { "location": "329/TALK"    , "narrator": "みやび", "text": "さては恋泥棒ぞね"},
        { "location": "341/TALK"    , "narrator": "アーヤ", "text": "…気付かれたかしら？"},
        { "location": "342/TALK"    , "narrator": "みやび", "text": "それやったらそれで、\n面白い展開やね。"},
        { "location": "344/TALK"    , "narrator": "みやび", "text": "反応によっては、\n正体を突き止めるヒントに\nなるかもしれんきね。"},
        { "location": "345/TALK"    , "narrator": "アーヤ", "text": "それはまあ、\nそうなんだけど…。"},
        { "location": "347/TALK"    , "narrator": "みやび", "text": "…なんや、ハッキリせんな？"},
        { "location": "349/TALK"    , "narrator": "アーヤ", "text": "…複雑なのよ。"},
        { "location": "350/TALK"    , "narrator": "アーヤ", "text": "真相を知りたいのか、\n知りたくないのか、\nハッキリしてなくて…。"},
        { "location": "351/TALK"    , "narrator": "みやび", "text": "…うちにログを渡したのに\nそういうこと言うが？"},
        { "location": "353/TALK"    , "narrator": "アーヤ", "text": "だから複雑なのよ。"},
        { "location": "354/TALK"    , "narrator": "アーヤ", "text": "何なのかしらね？\nこのモヤモヤした\n気持ちは…。"},
        { "location": "355/TALK"    , "narrator": "みやび", "text": "…実はうちも\n同じ気持ちぞね。"},
        { "location": "356/TALK"    , "narrator": "みやび", "text": "けんど。\nもう引き返せん。\n覚悟はできちゅう？"},
        { "location": "358/TALK"    , "narrator": "アーヤ", "text": "…できてるわ。"},
        { "location": "359/TALK"    , "narrator": "みやび", "text": "アーヤは\n度胸があるね。"},
        { "location": "361/TALK"    , "narrator": "アーヤ", "text": "からかうのはよして。"},
        { "location": "362/TALK"    , "narrator": "みやび", "text": "本気で言っちゅう。"},
        { "location": "364/TALK"    , "narrator": "みやび", "text": "うちも覚悟を\n決めんといかんね。"},
        { "location": "207/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月某日　8:59 PM</color>\nとある平日の夜、みやびの部屋にて。"}
    ]
}
