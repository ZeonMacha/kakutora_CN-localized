        { "location": "7/SCENARIO", "narrator": "", "text": "004_発展などしなくてよろしい"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "私が古いとかそういうわけじゃないと思うの"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "高校生が人目のあるところでキスとか"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "ダメだと思うのよ(;^_^A"},
        { "location": "37/SEL"    , "narrator": "", "text": "同感だ"},
        { "location": "38/SEL"    , "narrator": "", "text": "いや、あれが普通だから"},
        { "location": "39/SEL"    , "narrator": "", "text": "外だからそれで済んでる"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "なんていうの"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "進みすぎ？"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "そう"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "絶対"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "ス済すぎ！"},
        { "location": "46/ACT"    , "narrator": "", "text": "同感だ"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "やっぱり貴方は"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "わかってる！"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "みやびと館長が落ち着きすぎなのよね"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "なんなのかしらあれ"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "もー"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "やんなっちゃう"},
        { "location": "57/ACT"    , "narrator": "", "text": "いや、あれが普通だから"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "え"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "うそでしょ"},
        { "location": "61/SEL"    , "narrator": "", "text": "本当"},
        { "location": "62/SEL"    , "narrator": "", "text": "知らないの？"},
        { "location": "63/ACT"    , "narrator": "", "text": "本当"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "工ｴｴｪｪ(´д｀)ｪｪｴｴ工"},
        { "location": "65/ACT"    , "narrator": "", "text": "知らないの？"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "そんあの"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "知ってる湧かないわ"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "わけないわ"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "もうちょっといろんな人に聞いてみるね"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "私が古いの？"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "信じたくなーい！"},
        { "location": "74/ACT"    , "narrator": "", "text": "外だからそれで済んでる"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "え"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "ちょと"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "何を言い出すの"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "やめて"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "創造するから！！！！"}
    ]
}
