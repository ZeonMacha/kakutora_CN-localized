{
    "dir": "chap32/daydra/dd_ch03_32_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "32302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "偶然は運命にも似て＜前編＞"
    },
    "entry":
    [
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "都内に入ったわよ。"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "後は首都高で一直線。\n文京ドームにも\nもうすぐ着くわ。"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "意外と早かったわね。\nもう少しドンパチが\nあるかと思ったけど。"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "そこはほれ。\nキリト君たちが\nがんばってくれたきね。"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "なかなか将来有望ちや。"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "…本当は褒められた\nことじゃないけど。"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "助けられたのは\n事実ね。"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "……だけど……。"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "さすがに何も\nなさすぎるような\n気がする。"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "監視システムが\n無効化されたせいで\n混乱しているとしても。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "人海戦術を取るだけの\n人員はいるはず。"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "なぜその手段を\n取ってないの…？"},
        { "location": "60/SEL"    , "narrator": "", "text": "一言いい？"},
        { "location": "61/ACT"    , "narrator": "", "text": "一言いい？"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "どうしたのかしら？"},
        { "location": "73/SEL"    , "narrator": "", "text": "油断しないで"},
        { "location": "74/SEL"    , "narrator": "", "text": "ここからが正念場"},
        { "location": "75/SEL"    , "narrator": "", "text": "仕掛けはまだ解除されてない"},
        { "location": "76/ACT"    , "narrator": "", "text": "油断しないで"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "わかってる"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "気を付けるわ"},
        { "location": "79/ACT"    , "narrator": "", "text": "ここからが正念場"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "本当よね"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "がんばらなきゃ"},
        { "location": "82/ACT"    , "narrator": "", "text": "仕掛けはまだ解除されてない"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "まだ罠があるってことね"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "確かにそうよね"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$ったら\n心配して\nくれているのね。"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "こんな時に不謹慎だけど\nちょっとうれしいわ。"},
        { "location": "93/SEL"    , "narrator": "", "text": "聞いて"},
        { "location": "94/ACT"    , "narrator": "", "text": "聞いて"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "なんでも聞くわよｖｖｖ"},
        { "location": "107/SEL"   , "narrator": "", "text": "このままだと死ぬ"},
        { "location": "108/SEL"   , "narrator": "", "text": "とにかく気を抜いちゃダメ"},
        { "location": "109/SEL"   , "narrator": "", "text": "生きることを第一に考えて"},
        { "location": "110/ACT"   , "narrator": "", "text": "このままだと死ぬ"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "なんてことを言うの"},
        { "location": "112/ACT"   , "narrator": "", "text": "とにかく気を抜いちゃダメ"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "抜くわけないでしょ"},
        { "location": "115/SEL"   , "narrator": "", "text": "気を抜くと死ぬ"},
        { "location": "116/SEL"   , "narrator": "", "text": "死と隣り合わせって自覚して"},
        { "location": "117/SEL"   , "narrator": "", "text": "いのちだいじに"},
        { "location": "118/ACT"   , "narrator": "", "text": "気を抜くと死ぬ"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "何それ"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "そんなこと言わないでよ！"},
        { "location": "122/ACT"   , "narrator": "", "text": "死と隣り合わせって自覚して"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "やめてよ"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "縁起でもない"},
        { "location": "125/ACT"   , "narrator": "", "text": "いのちだいじに"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "当たり前でしょ"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "そんなの！"},
        { "location": "129/ACT"   , "narrator": "", "text": "生きることを第一に考えて"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "そうしないと"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "生きていけないわ"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "変なこと言わないで"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "怒るわよ"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "それとも$marzanna$は"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "死神なの？"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "死の女神なの？"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "どっちにしても切るわね"},
        { "location": "144/TALK"  , "narrator": "ガブリエラ", "text": "なんなのよ…！\nそんなわけ\nないじゃない！"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "ポーランドに\nいた時は毎日死と\n隣り合わせだったわ。"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "前線からは離れてたけど。\nそれでも日本より\n遙かに危険だった。"},
        { "location": "148/TALK"  , "narrator": "ガブリエラ", "text": "今はアーヤ達と一緒だし。\nトライガジェット\nだってある。"},
        { "location": "149/TALK"  , "narrator": "ガブリエラ", "text": "訓練も実戦も\nたくさん積んだわ。"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "だから――"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとアーヤ！\n急ハンドルとか\n危ないわよ！"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "…安全運転で\nオナシャス…！"},
        { "location": "162/TALK"  , "narrator": "アーヤ", "text": "違う、違うのよ！"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "何が違うの？"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "元々運転が荒いのは\n知ってるけど！"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "それにしても\nひどすぎるわよ！"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "もう少し淑女な走りを\n期待したいちや…。"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "首都高だからって\nスピード出しすぎ\nでしょ！"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "私じゃない！\nコントロールが\n利かないの！"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "ハンドルもブレーキも\n利かないのよ！"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "172/TALK"  , "narrator": "アーヤ", "text": "止められないわ！"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと$marzanna$"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "どういうことなの"},
        { "location": "181/SEL"   , "narrator": "", "text": "$me$にもよく"},
        { "location": "182/SEL"   , "narrator": "", "text": "こう来たか"},
        { "location": "183/SEL"   , "narrator": "", "text": "まず落ち着こう"},
        { "location": "184/ACT"   , "narrator": "", "text": "$me$にもよく"},
        { "location": "185/TALK"  , "narrator": "ガブリエラ", "text": "何よそれ"},
        { "location": "186/ACT"   , "narrator": "", "text": "こう来たか"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "のんきにしてる場合じゃないの"},
        { "location": "188/ACT"   , "narrator": "", "text": "まず落ち着こう"},
        { "location": "189/TALK"  , "narrator": "ガブリエラ", "text": "そんなこと"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "できるわけないでしょ"},
        { "location": "193/SEL"   , "narrator": "", "text": "ごめん"},
        { "location": "194/SEL"   , "narrator": "", "text": "ちょっと想定外"},
        { "location": "195/SEL"   , "narrator": "", "text": "この先でどうにかするから"},
        { "location": "196/ACT"   , "narrator": "", "text": "ごめん"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "謝らなくていいから"},
        { "location": "198/TALK"  , "narrator": "ガブリエラ", "text": "どうにかして"},
        { "location": "199/ACT"   , "narrator": "", "text": "ちょっと想定外"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "それはそれでいいから"},
        { "location": "201/TALK"  , "narrator": "ガブリエラ", "text": "なんとかしなさい"},
        { "location": "202/ACT"   , "narrator": "", "text": "この先でどうにかするから"},
        { "location": "203/TALK"  , "narrator": "ガブリエラ", "text": "絶対よ"},
        { "location": "204/TALK"  , "narrator": "ガブリエラ", "text": "絶対なんだから"},
        { "location": "206/TALK"  , "narrator": "ガブリエラ", "text": "あなたは豊穣の女神"},
        { "location": "207/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナでしょ"},
        { "location": "209/TALK"  , "narrator": "ガブリエラ", "text": "神様なら奇跡を起こして"},
        { "location": "212/SEL"   , "narrator": "", "text": "今は違う"},
        { "location": "213/SEL"   , "narrator": "", "text": "そんな時もあったけど"},
        { "location": "214/SEL"   , "narrator": "", "text": "マルザンナなんかじゃない"},
        { "location": "215/ACT"   , "narrator": "", "text": "今は違う"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "$handle$だわ"},
        { "location": "218/ACT"   , "narrator": "", "text": "そんな時もあったけど"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "$handle$にとっては"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "昔かもしれないけど"},
        { "location": "221/TALK"  , "narrator": "ガブリエラ", "text": "あたしは忘れられないわ"},
        { "location": "222/ACT"   , "narrator": "", "text": "マルザンナなんかじゃない"},
        { "location": "223/TALK"  , "narrator": "ガブリエラ", "text": "本当は"},
        { "location": "224/TALK"  , "narrator": "ガブリエラ", "text": "最初からそうだったわね"},
        { "location": "225/TALK"  , "narrator": "ガブリエラ", "text": "今は知ってる"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "本当は"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナより"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "あなたに守ってほしいの"},
        { "location": "230/TALK"  , "narrator": "ガブリエラ", "text": "ねえ$handle$"},
        { "location": "231/TALK"  , "narrator": "ガブリエラ", "text": "もしそれが無理だったとしても"},
        { "location": "232/TALK"  , "narrator": "ガブリエラ", "text": "あいしてる"},
        { "location": "233/TALK"  , "narrator": "ガブリエラ", "text": "わすれない"},
        { "location": "236/TALK"  , "narrator": "ガブリエラ", "text": "だいすき"},
        { "location": "287/TALK"  , "narrator": "ガブリエラ", "text": "　"},
        { "location": "342/TALK"  , "narrator": "昇華マルザンナ", "text": "これがあたしの\n本当の姿なの――"},
        { "location": "343/TALK"  , "narrator": "リヴォルカ", "text": "はぁ……\n本当に発症しちゃうなんて\nどうかしてるわ…。"},
        { "location": "344/TALK"  , "narrator": "昇華マルザンナ", "text": "あんたに理解して\nもらおうとは思ってない。"},
        { "location": "345/TALK"  , "narrator": "昇華マルザンナ", "text": "だって、あんたは\n今の現実のあたしが\n好きじゃないでしょう？"},
        { "location": "346/TALK"  , "narrator": "昇華マルザンナ", "text": "でもあたしは好きなの。"},
        { "location": "347/TALK"  , "narrator": "昇華マルザンナ", "text": "だから、ここで発症して\nアーヤたちと会えなく\nなるのは絶対に嫌なの。"},
        { "location": "348/TALK"  , "narrator": "リヴォルカ", "text": "もう無理よ。\n外の状況、\n把握してるでしょ？"},
        { "location": "349/TALK"  , "narrator": "リヴォルカ", "text": "謎の暴走。\nいつ死ぬかもわからない\n極限の恐怖。"},
        { "location": "350/TALK"  , "narrator": "リヴォルカ", "text": "今こうしてる間にも、\n着々とセルフクランは\n発症の機を伺っている。"},
        { "location": "351/TALK"  , "narrator": "リヴォルカ", "text": "外的要因も助けて、\n今ココロの中は急速に\n発症に向かってるのよ。"},
        { "location": "352/TALK"  , "narrator": "昇華マルザンナ", "text": "でも、\nまだ発症してないわ。"},
        { "location": "353/TALK"  , "narrator": "リヴォルカ", "text": "はぁ……\nホントに頭悪いわね…。"},
        { "location": "354/TALK"  , "narrator": "昇華マルザンナ", "text": "$handle$、\nお願いがあるの。"},
        { "location": "355/TALK"  , "narrator": "昇華マルザンナ", "text": "あたしと一緒に、\nざわついてるクランを\n沈静化して欲しいのよ。"},
        { "location": "356/SEL"   , "narrator": "", "text": "どうやって？"},
        { "location": "357/ACT"   , "narrator": "", "text": "どうやって？"},
        { "location": "359/TALK"  , "narrator": "昇華マルザンナ", "text": "何も難しい\nことじゃないわ。"},
        { "location": "360/TALK"  , "narrator": "昇華マルザンナ", "text": "今まであたしと\n$handle$とで\nずっとやってきたこと。"},
        { "location": "361/TALK"  , "narrator": "昇華マルザンナ", "text": "ココロがざわついたら\nクランを沈静化して\n平静を保てるようにする。"},
        { "location": "362/TALK"  , "narrator": "昇華マルザンナ", "text": "それをやるだけ。"},
        { "location": "363/TALK"  , "narrator": "昇華マルザンナ", "text": "ただ、今までと違うのは、\nあたしも一緒に\n戦えること。"},
        { "location": "364/SEL"   , "narrator": "", "text": "それってすごい！"},
        { "location": "365/ACT"   , "narrator": "", "text": "それってすごい！"},
        { "location": "367/TALK"  , "narrator": "昇華マルザンナ", "text": "司書の姿じゃ、そんな\n力は持てなかったけど、\n今なら――"},
        { "location": "369/TALK"  , "narrator": "千羽鶴", "text": "申し訳無いけど、\nそれは止めてもらいたい。"},
        { "location": "377/TALK"  , "narrator": "昇華マルザンナ", "text": "千羽鶴！？"},
        { "location": "378/TALK"  , "narrator": "リヴォルカ", "text": "ああっ、契約主！\nいいところに\n来てくれたわね！"},
        { "location": "379/TALK"  , "narrator": "千羽鶴", "text": "しばらく追い出されて\nいたから来れなかったけど\nやっと戻ってこれた。"},
        { "location": "383/SEL"   , "narrator": "", "text": "千羽鶴…"},
        { "location": "384/ACT"   , "narrator": "", "text": "千羽鶴…"},
        { "location": "387/TALK"  , "narrator": "千羽鶴", "text": "こんにちは。\nまた会ったわね。"},
        { "location": "388/SEL"   , "narrator": "", "text": "また発症させに来たのか？"},
        { "location": "389/SEL"   , "narrator": "", "text": "一応、どういうことかもう一度説明してもらってもいい？"},
        { "location": "390/ACT"   , "narrator": "", "text": "また発症させに来たのか？"},
        { "location": "391/TALK"  , "narrator": "千羽鶴", "text": "その通り。\n話が早くて助かる。"},
        { "location": "393/TALK"  , "narrator": "千羽鶴", "text": "貴方のセルフクランは、\n発症によりフェノメノンを\n展開する事を望んでいる。"},
        { "location": "394/TALK"  , "narrator": "千羽鶴", "text": "それは、逢瀬つばめに\n洗脳された$ev32_fullname$\nのことではない。"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "日本を覆うフェノメノンの\n外側、現実における\n$ev32_fullname$のこと。"},
        { "location": "396/TALK"  , "narrator": "千羽鶴", "text": "彼女と私とは\n誓いを立てている。"},
        { "location": "397/TALK"  , "narrator": "千羽鶴", "text": "だから私には、\n彼女を発症させる\n義務がある。"},
        { "location": "398/ACT"   , "narrator": "", "text": "一応、どういうことかもう一度説明してもらってもいい？"},
        { "location": "399/TALK"  , "narrator": "千羽鶴", "text": "わかった。\n大事な事なので\n何度でも説明する。"},
        { "location": "400/TALK"  , "narrator": "千羽鶴", "text": "私はセルフクランを\n発症させたいと思ってる。"},
        { "location": "401/TALK"  , "narrator": "千羽鶴", "text": "そして、発症させるのに\n貴方の力は\nとても役にたつ。"},
        { "location": "406/SEL"   , "narrator": "", "text": "どうしてここに！？"},
        { "location": "407/ACT"   , "narrator": "", "text": "どうしてここに！？"},
        { "location": "410/TALK"  , "narrator": "千羽鶴", "text": "こんにちは。"},
        { "location": "411/TALK"  , "narrator": "千羽鶴", "text": "貴方こそ、\nどうしてここに？"},
        { "location": "412/TALK"  , "narrator": "千羽鶴", "text": "まあでも、\n貴方が今ここにいて\nくれたのは好都合。"},
        { "location": "413/TALK"  , "narrator": "千羽鶴", "text": "発症には貴方がいて\nくれた方がよりスムーズ。"},
        { "location": "415/TALK"  , "narrator": "千羽鶴", "text": "手伝ってもらえる？"},
        { "location": "416/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "417/SEL"   , "narrator": "", "text": "まさか"},
        { "location": "418/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "421/ACT"   , "narrator": "", "text": "まさか"},
        { "location": "424/TALK"  , "narrator": "千羽鶴", "text": "まさか？"},
        { "location": "425/TALK"  , "narrator": "千羽鶴", "text": "まさか、\nそんなはずはない。"},
        { "location": "426/TALK"  , "narrator": "千羽鶴", "text": "貴方は確かに言った。\n『千羽鶴の為、彼女に\n犠牲になってもらう』と。"},
        { "location": "427/SEL"   , "narrator": "", "text": "言いましたね"},
        { "location": "428/SEL"   , "narrator": "", "text": "身に覚えがありません"},
        { "location": "429/ACT"   , "narrator": "", "text": "言いましたね"},
        { "location": "430/ACT"   , "narrator": "", "text": "身に覚えがありません"},
        { "location": "431/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "432/TALK"  , "narrator": "千羽鶴", "text": "ならばOSのシステムバグ\nということになる。"},
        { "location": "433/TALK"  , "narrator": "千羽鶴", "text": "OSの製造元に問い合わせて\n修正してもらったら？"},
        { "location": "436/TALK"  , "narrator": "千羽鶴", "text": "ちなみに、このツッコミは\n彼女を不幸にする事を肯定\nするものではない。"},
        { "location": "437/TALK"  , "narrator": "千羽鶴", "text": "発症に関しては、目先だけ\n見れば不幸を強いている\nように見えるかもだけど、"},
        { "location": "438/TALK"  , "narrator": "千羽鶴", "text": "彼女の本質的な\n見方をすれば、彼女の\n幸せに繋がること。"},
        { "location": "439/TALK"  , "narrator": "千羽鶴", "text": "問題はそこではなく。"},
        { "location": "440/TALK"  , "narrator": "千羽鶴", "text": "貴方が彼女を不幸にすると\n『思い込んだ』事に対して\n私の協力を拒んだこと。"},
        { "location": "441/TALK"  , "narrator": "千羽鶴", "text": "私を犠牲にしても彼女を\n護る、の方を選んだのなら\n全く問題無いのだけど。"},
        { "location": "442/TALK"  , "narrator": "千羽鶴", "text": "……まあ、\nこの事については、もう\nこれくらいにしておく。"},
        { "location": "443/TALK"  , "narrator": "千羽鶴", "text": "口頭質問だったし、\n貴方もさほど考えて回答\nしてないのでしょうし。"},
        { "location": "444/TALK"  , "narrator": "千羽鶴", "text": "そんなことより、\nセルフクランの発症の話。"},
        { "location": "445/TALK"  , "narrator": "千羽鶴", "text": "発症は彼女にとっては\n寧ろ幸せに繋がること。"},
        { "location": "448/TALK"  , "narrator": "千羽鶴", "text": "まあ、\n予想はしていた。"},
        { "location": "449/TALK"  , "narrator": "千羽鶴", "text": "確かに、イメージとして\n発症はかなり印象悪い。"},
        { "location": "450/TALK"  , "narrator": "千羽鶴", "text": "協力するのは殺人に手を\n貸すのと同じ、くらいの\n印象なんでしょう？"},
        { "location": "451/SEL"   , "narrator": "", "text": "実際そうでしょ"},
        { "location": "452/SEL"   , "narrator": "", "text": "そこまでは言ってない"},
        { "location": "453/ACT"   , "narrator": "", "text": "実際そうでしょ"},
        { "location": "454/TALK"  , "narrator": "千羽鶴", "text": "発症は殺人ではない。"},
        { "location": "455/TALK"  , "narrator": "千羽鶴", "text": "それは、量子学とケーキが\n同じものだと言うくらい\n意味が分からない。"},
        { "location": "456/ACT"   , "narrator": "", "text": "そこまでは言ってない"},
        { "location": "457/TALK"  , "narrator": "千羽鶴", "text": "そう？\nでも、いやなことだと\n思ったのでしょう？"},
        { "location": "459/TALK"  , "narrator": "千羽鶴", "text": "結論から言えば、\n発症は彼女を\n不幸にするものではない。"},
        { "location": "460/TALK"  , "narrator": "千羽鶴", "text": "目先だけを見れば\n不幸を強いているように\n見えるかもだけど――"},
        { "location": "461/TALK"  , "narrator": "千羽鶴", "text": "彼女の本質的な\n見方をすれば、彼女の\n幸せに繋がること。"},
        { "location": "465/SEL"   , "narrator": "", "text": "何故！？"},
        { "location": "466/ACT"   , "narrator": "", "text": "何故！？"},
        { "location": "468/TALK"  , "narrator": "千羽鶴", "text": "さっき\n$ev32_lib$が\n言ったとおり。"},
        { "location": "469/TALK"  , "narrator": "千羽鶴", "text": "セルフクランは発症による\nフェノメノン化を\n望んでいる――。"},
        { "location": "470/SEL"   , "narrator": "", "text": "いやいやいや、なぜそう言い切れる！？"},
        { "location": "471/ACT"   , "narrator": "", "text": "いやいやいや、なぜそう言い切れる！？"},
        { "location": "473/TALK"  , "narrator": "千羽鶴", "text": "彼女と私とは\n誓いを立てているから。"},
        { "location": "474/TALK"  , "narrator": "千羽鶴", "text": "忘れてない？\n今の日本が巨大な\nフェノメノンであること。"},
        { "location": "475/TALK"  , "narrator": "千羽鶴", "text": "そして、フェノメノンより\n前の$ev32_fullname$には\n別の人生があったことを。"},
        { "location": "476/SEL"   , "narrator": "", "text": "あ"},
        { "location": "477/ACT"   , "narrator": "", "text": "あ"},
        { "location": "482/TALK"  , "narrator": "リヴォルカ", "text": "…ですって。"},
        { "location": "483/TALK"  , "narrator": "リヴォルカ", "text": "これじゃあ、\nフェノメノンを展開しない\nわけにはいかないわよね。"},
        { "location": "484/TALK"  , "narrator": "昇華マルザンナ", "text": "あたしは\n諦めない。"},
        { "location": "485/TALK"  , "narrator": "昇華マルザンナ", "text": "ここで発症したら、\n今の全てが\n終わってしまうわ。"},
        { "location": "486/TALK"  , "narrator": "昇華マルザンナ", "text": "現実のあたしだって\n言ってた。"},
        { "location": "487/TALK"  , "narrator": "昇華マルザンナ", "text": "『あたしは、\n今のこの世界を守る』と。"},
        { "location": "488/TALK"  , "narrator": "昇華マルザンナ", "text": "あたしは\nその想いに忠実でいたい。"},
        { "location": "489/TALK"  , "narrator": "昇華マルザンナ", "text": "だから、発症はさせない。"},
        { "location": "491/SEL"   , "narrator": "", "text": "ダメだ落ち着け！\n千羽鶴に支配される！"},
        { "location": "492/ACT"   , "narrator": "", "text": "ダメだ落ち着け！\n千羽鶴に支配される！"},
        { "location": "494/TALK"  , "narrator": "昇華マルザンナ", "text": "え？"},
        { "location": "495/TALK"  , "narrator": "千羽鶴", "text": "もう遅い。"},
        { "location": "497/TALK"  , "narrator": "昇華マルザンナ", "text": "お願い$handle$、\nあたしに協力して！"},
        { "location": "498/TALK"  , "narrator": "昇華マルザンナ", "text": "そうすれば、\nセルフクランは\n発症を回避できるの！"},
        { "location": "499/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "500/SEL"   , "narrator": "", "text": "だが断る"},
        { "location": "501/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "503/TALK"  , "narrator": "昇華マルザンナ", "text": "ありがとう！"},
        { "location": "504/ACT"   , "narrator": "", "text": "だが断る"},
        { "location": "506/TALK"  , "narrator": "昇華マルザンナ", "text": "そんな！"},
        { "location": "508/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、\nそれは出来ないと思う。"},
        { "location": "509/TALK"  , "narrator": "昇華マルザンナ", "text": "出来るわ！"},
        { "location": "510/TALK"  , "narrator": "千羽鶴", "text": "無理よ。\nだって私が――"},
        { "location": "511/TALK"  , "narrator": "千羽鶴", "text": "貴方を破壊するから。"},
        { "location": "518/TALK"  , "narrator": "昇華マルザンナ", "text": "うっ……くっ…\nあああ……っ！"},
        { "location": "519/TALK"  , "narrator": "リヴォルカ", "text": "えっ！？"},
        { "location": "524/SEL"   , "narrator": "", "text": "マルザンナ！！"},
        { "location": "525/SEL"   , "narrator": "", "text": "やめろ千羽鶴！！"},
        { "location": "526/ACT"   , "narrator": "", "text": "マルザンナ！！"},
        { "location": "531/TALK"  , "narrator": "昇華マルザンナ", "text": "たす…けて……\nココロの中に何かが\n入って…くるのっ…！！"},
        { "location": "536/TALK"  , "narrator": "昇華マルザンナ", "text": "何かに……\n侵される…っ！！"},
        { "location": "537/ACT"   , "narrator": "", "text": "やめろ千羽鶴！！"},
        { "location": "538/TALK"  , "narrator": "千羽鶴", "text": "大丈夫。"},
        { "location": "540/TALK"  , "narrator": "千羽鶴", "text": "さっきと同じで、\n一時的に人格の変化を\n促してるだけ。"},
        { "location": "541/TALK"  , "narrator": "千羽鶴", "text": "事が終われば\n元に戻すから\n心配しないで。"},
        { "location": "543/TALK"  , "narrator": "千羽鶴", "text": "この子の心を\n一時的に、擬似的に\n変化させてるだけ。"},
        { "location": "544/TALK"  , "narrator": "千羽鶴", "text": "フェノメノンに洗脳された\n人と同じ状態を、人格に\n作り出してるだけだから。"},
        { "location": "545/TALK"  , "narrator": "千羽鶴", "text": "心配しないで。"},
        { "location": "552/TALK"  , "narrator": "リヴォルカ", "text": "ちょっ…ちょっと、\nさすがにやり過ぎじゃ……"},
        { "location": "553/TALK"  , "narrator": "千羽鶴", "text": "時間があって誤差が少なく\n敵対する相手がいなくて\n平穏ならこんな事しない。"},
        { "location": "554/TALK"  , "narrator": "昇華マルザンナ", "text": "お願いっ……\n$handle$さんっ！！"},
        { "location": "559/TALK"  , "narrator": "昇華マルザンナ", "text": "私を壊して！！"},
        { "location": "562/SEL"   , "narrator": "", "text": "出来るか！！"},
        { "location": "563/ACT"   , "narrator": "", "text": "出来るか！！"},
        { "location": "565/TALK"  , "narrator": "昇華マルザンナ", "text": "大丈夫！！\nクランの…収束と…っ…\n同じことだから…っ…"},
        { "location": "571/TALK"  , "narrator": "昇華マルザンナ", "text": "死にはしないから…っ！\n早く！！！"},
        { "location": "45/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月11日　 5:12 PM</color>\n長野から東京へ戻る途中、アーケロン車内にて。"},
        { "location": "252/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "254/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "256/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "258/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "260/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
