{
    "dir": "chap15/daydra/dd_ch02_15_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "15202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "ここは横須賀＜前編＞"
    },
    "entry":
    [
        { "location": "27/TALK"   , "narrator": "雛", "text": "お疲れ様でした、\n綾水様！！"},
        { "location": "29/TALK"   , "narrator": "雛", "text": "ここが目的地の\n横須賀ですよー！"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "ひ、日向さん。\n元気がいいのは\nわかったから、その……"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "もう少しだけ声を\n抑えてもらえるかしら？"},
        { "location": "36/TALK"   , "narrator": "雛", "text": "あはは、すみません。\nちょっとテンション\n上がっちゃってて。"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "あはは…。"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "でも、日向さんの\n言う通り、電車の旅も\nなかなかいいものね。"},
        { "location": "41/TALK"   , "narrator": "雛", "text": "本当ですか！？"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "ええ。バイク旅だと\n運転してるからあまり\n景色を楽しめないもの。"},
        { "location": "45/TALK"   , "narrator": "雛", "text": "あ～…、なるほどー。\n綾水様は、電車旅は景色を\n楽しむ派なんですね！"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "え？　日向さんは\nそうじゃないの？"},
        { "location": "50/TALK"   , "narrator": "雛", "text": "あたしは景色よりも\n電車が目当ての女です\nからねー。"},
        { "location": "51/TALK"   , "narrator": "雛", "text": "景色よりも車両を\n重要視するタイプ\nなんですよー。"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "あはは、本当に\n電車が好きなのね。"},
        { "location": "53/TALK"   , "narrator": "雛", "text": "はい！"},
        { "location": "54/TALK"   , "narrator": "雛", "text": "東京２３区内を丸一日\nかけて、色んな路線を\n渡り歩くのが最高です！"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "渡り歩くって、\nえ？　それだけ？"},
        { "location": "58/TALK"   , "narrator": "雛", "text": "何言ってるんですか！"},
        { "location": "59/TALK"   , "narrator": "雛", "text": "１日中電車に乗って\nいられるなんて、すごい\n贅沢旅だと思いませんか？"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "うーん…でもそれ、\n旅って言っても\nいいのかしら…？"},
        { "location": "65/TALK"   , "narrator": "雛", "text": "距離的には凄いことに\nなりますからねー。"},
        { "location": "66/TALK"   , "narrator": "雛", "text": "都区内パスがあれば\n１０００円以内で、都内の\n隅から隅まで行けますし。"},
        { "location": "68/TALK"   , "narrator": "雛", "text": "超お得なんですよ！"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "そうなんだ…。\n本当、電車のことに\n詳しいのね。"},
        { "location": "71/TALK"   , "narrator": "雛", "text": "えへへ…、そう言って\nもらえると、とっても\n嬉しいです…。"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "ふふっ…。"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "さてと、せっかく横須賀\nまで来たんだし、名所的な\n所に行きたいわね。"},
        { "location": "76/TALK"   , "narrator": "雛", "text": "う～ん、横須賀の\n名所ですか…。"},
        { "location": "77/TALK"   , "narrator": "雛", "text": "横須賀といえば\nやっぱり――"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "花火大会、かしら？"},
        { "location": "81/TALK"   , "narrator": "雛", "text": "有名ですよねー。\nでもあれがやるの、\n夏休みなんです…。"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "ごめんなさい。\nそれくらいしか\n知らなくて…。"},
        { "location": "83/TALK"   , "narrator": "雛", "text": "いえ、あたしも\n詳しいわけじゃ\nないんです。"},
        { "location": "84/TALK"   , "narrator": "雛", "text": "…綾水様の趣味に\n合うかわからないん\nですけど――"},
        { "location": "85/TALK"   , "narrator": "雛", "text": "名所を一つだけ\n知ってます。\n…どうしますか？"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "構わないわ。\nせっかく来たんだし、\n行ってみましょ。"},
        { "location": "88/TALK"   , "narrator": "雛", "text": "わかりました。\nでは、こちらですー。"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "わぁ、すごい！"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "これ、本物の戦艦？"},
        { "location": "110/TALK"  , "narrator": "雛", "text": "はい…。"},
        { "location": "112/TALK"  , "narrator": "雛", "text": "日露戦争で連合艦隊\n旗艦を務め、東郷平八郎も\n座乗した、戦艦三笠です。"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "随分詳しいのね？"},
        { "location": "117/TALK"  , "narrator": "雛", "text": "キリトに何十回と\n聞かされましたから…。"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "そっか…。"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "…この船が、本当に\n戦争で戦ってたのね。"},
        { "location": "123/TALK"  , "narrator": "雛", "text": "…わかってはいても、\nあんまり実感が\nわきませんよね？"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "ええ…戦艦なんて、\n映画の中でしか\n見ないからかも。"},
        { "location": "126/TALK"  , "narrator": "雛", "text": "でも、トライナリーは\n戦艦くらい持ってるん\nじゃないですか？"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "ないない。\nさすがにそんなの\n持ってないわ。"},
        { "location": "130/TALK"  , "narrator": "雛", "text": "本当ですかぁ？\n実は秘密兵器として\nあるんじゃ…。"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "そりゃ、そんなのが\nあれば心強いとは\n思うけど――"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "強力過ぎるから、\nちょっと使うのが\n怖いわね。"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "それに、使える場所も\n限定されるし。"},
        { "location": "139/TALK"  , "narrator": "雛", "text": "そっかー。\n戦艦だと海辺以外じゃ\n使えませんからねー。"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "そういうこと。"},
        { "location": "143/TALK"  , "narrator": "雛", "text": "…さてと、これから\nどうしましょうか？"},
        { "location": "144/TALK"  , "narrator": "雛", "text": "あたしが案内できる\n場所は、これくらい\nですし…。"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "う～ん、そうね…。"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "凄い戦艦も見れたし、\n電車旅の楽しさも\nわかったから……"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "そろそろ帰って、\n部屋でのんびり\nしようかしら？"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "サークルで使う\n新しい人形も\n作りたいし…。"},
        { "location": "149/SEL"   , "narrator": "", "text": "まさか帰ろうとしてる？"},
        { "location": "150/ACT"   , "narrator": "", "text": "まさか帰ろうとしてる？"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "だって"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "目的が済んだから"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "これ以上"},
        { "location": "171/TALK"  , "narrator": "アーヤ", "text": "いる意味ないし"},
        { "location": "172/TALK"  , "narrator": "アーヤ", "text": "日向さんも"},
        { "location": "173/TALK"  , "narrator": "アーヤ", "text": "あまり長い時間"},
        { "location": "174/TALK"  , "narrator": "アーヤ", "text": "付き合わせたら悪いわ"},
        { "location": "176/SEL"   , "narrator": "", "text": "雛はアーヤに憧れてるから大丈夫"},
        { "location": "177/ACT"   , "narrator": "", "text": "雛はアーヤに憧れてるから大丈夫"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "これ以上"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "話すこともないし"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "嫌いってわけじゃなくて"},
        { "location": "185/TALK"  , "narrator": "アーヤ", "text": "まだ"},
        { "location": "186/TALK"  , "narrator": "アーヤ", "text": "共通の話題？"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "そういうのわからないから"},
        { "location": "188/TALK"  , "narrator": "アーヤ", "text": "目的が無いと"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "間が持たないと思う"},
        { "location": "192/SEL"   , "narrator": "", "text": "二人とも旅好きじゃん"},
        { "location": "193/ACT"   , "narrator": "", "text": "二人とも旅好きじゃん"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "196/TALK"  , "narrator": "アーヤ", "text": "微妙に食い違ってるし"},
        { "location": "199/TALK"  , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "200/TALK"  , "narrator": "アーヤ", "text": "今日は帰るわ"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "…それがいいわね。\n結構気を使わせ\nちゃってもいるし。"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "もう少し劇場で一緒に\nバイトすれば、共通の\n話題も増えるだろうから。"},
        { "location": "213/TALK"  , "narrator": "アーヤ", "text": "今日はもう帰ろう。"},
        { "location": "217/TALK"  , "narrator": "アーヤ", "text": "さてと、日向さん。\nそろそろ――"},
        { "location": "287/TALK"  , "narrator": "アーヤ", "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。"},
        { "location": "289/TALK"  , "narrator": "アーヤ", "text": "今日も早速\n何を悩んでるのか\n検索するわね。"},
        { "location": "294/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0xF28番地から\n0x331番地へ。"},
        { "location": "309/TALK"  , "narrator": "アーヤ", "text": "シーク完了。"},
        { "location": "312/TALK"  , "narrator": "アーヤ", "text": "さて、と。\n今回は……"},
        { "location": "314/TALK"  , "narrator": "アーヤ", "text": "あー……。"},
        { "location": "315/SEL"   , "narrator": "", "text": "また恥ずかしいこと？"},
        { "location": "316/SEL"   , "narrator": "", "text": "また平和な悩み？"},
        { "location": "317/ACT"   , "narrator": "", "text": "また恥ずかしいこと？"},
        { "location": "319/TALK"  , "narrator": "アーヤ", "text": "また…って！\n私は一度も恥ずかしい姿\n晒した事なんてないわよ！"},
        { "location": "320/SEL"   , "narrator": "", "text": "え？でも前回「恥ずかしい女」だ、って自分で…"},
        { "location": "321/ACT"   , "narrator": "", "text": "え？でも前回「恥ずかしい女」だ、って自分で…"},
        { "location": "323/TALK"  , "narrator": "アーヤ", "text": "え？"},
        { "location": "324/TALK"  , "narrator": "アーヤ", "text": "あ、ああ、\nそっちの意味の\n恥ずかしいだったのね。"},
        { "location": "325/SEL"   , "narrator": "", "text": "アーヤはどっちの「恥ずかしい」だと思ってたの？"},
        { "location": "326/ACT"   , "narrator": "", "text": "アーヤはどっちの「恥ずかしい」だと思ってたの？"},
        { "location": "328/TALK"  , "narrator": "アーヤ", "text": "な、なんだって\nいいでしょう？"},
        { "location": "329/SEL"   , "narrator": "", "text": "勘違いするってことは、つまり……"},
        { "location": "330/SEL"   , "narrator": "", "text": "アーヤかわいいのでこの辺で許してあげる"},
        { "location": "331/ACT"   , "narrator": "", "text": "勘違いするってことは、つまり……"},
        { "location": "332/TALK"  , "narrator": "アーヤ", "text": "いや、そうじゃなくて！"},
        { "location": "333/TALK"  , "narrator": "アーヤ", "text": "つまりもハマリも\nありませんから。"},
        { "location": "334/TALK"  , "narrator": "アーヤ", "text": "ま、まあ、心当たりは\nないわけじゃないけど……"},
        { "location": "335/ACT"   , "narrator": "", "text": "アーヤかわいいのでこの辺で許してあげる"},
        { "location": "336/TALK"  , "narrator": "アーヤ", "text": "はいはい。\n許してくれてありがと。"},
        { "location": "339/TALK"  , "narrator": "アーヤ", "text": "ふぅ……。"},
        { "location": "340/TALK"  , "narrator": "アーヤ", "text": "話、戻していい？"},
        { "location": "341/ACT"   , "narrator": "", "text": "また平和な悩み？"},
        { "location": "342/TALK"  , "narrator": "アーヤ", "text": "え？\n平和な悩みっていうのは？"},
        { "location": "343/SEL"   , "narrator": "", "text": "アーヤの悩みは他の子に比べて重くない気がするから"},
        { "location": "344/ACT"   , "narrator": "", "text": "アーヤの悩みは他の子に比べて重くない気がするから"},
        { "location": "346/TALK"  , "narrator": "アーヤ", "text": "あー、そうね。\n自分でもそんなこと\n言ったかもしれない。"},
        { "location": "347/TALK"  , "narrator": "アーヤ", "text": "でも……本当に、\nどうしてなのかしらね。"},
        { "location": "348/TALK"  , "narrator": "アーヤ", "text": "なんて考えていても\nわかるものでもなし。\n話を戻すわね。"},
        { "location": "350/TALK"  , "narrator": "アーヤ", "text": "ココロファイルナンバー\n02-331-59によると――"},
        { "location": "351/TALK"  , "narrator": "アーヤ", "text": "日向さんと一緒にいるのが\n気まずいから、帰ろうか\nどうしようか悩んでる。"},
        { "location": "352/TALK"  , "narrator": "アーヤ", "text": "でも、総意としては\n日向さんともっと親睦を\n深めたいから――"},
        { "location": "353/TALK"  , "narrator": "アーヤ", "text": "もうちょっと一緒に\nいたいって思ってるわね。"},
        { "location": "354/SEL"   , "narrator": "", "text": "いればいいじゃん"},
        { "location": "355/SEL"   , "narrator": "", "text": "やっぱり平和な悩みだねえ"},
        { "location": "356/ACT"   , "narrator": "", "text": "いればいいじゃん"},
        { "location": "357/TALK"  , "narrator": "アーヤ", "text": "そうなんだけど、\nどっちかというと、気に\nしてるのは日向さんの方。"},
        { "location": "358/TALK"  , "narrator": "アーヤ", "text": "本当はつまらなくて、\nでも年長者だから仕方なく\nつき合ってるのかもって。"},
        { "location": "359/SEL"   , "narrator": "", "text": "それはないと思う"},
        { "location": "360/ACT"   , "narrator": "", "text": "それはないと思う"},
        { "location": "362/TALK"  , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "363/TALK"  , "narrator": "アーヤ", "text": "でも貴方がそう言うなら\nそうなんでしょうね。"},
        { "location": "364/TALK"  , "narrator": "アーヤ", "text": "結構びっくりするような\n事を知ってたりするから、\n今回もそうなんでしょ？"},
        { "location": "365/TALK"  , "narrator": "アーヤ", "text": "なんにせよ、貴方の言葉で\n少しだけクランが\n弱体化したかも。"},
        { "location": "366/ACT"   , "narrator": "", "text": "やっぱり平和な悩みだねえ"},
        { "location": "368/TALK"  , "narrator": "アーヤ", "text": "まあ、そう…なのかも\nしれないわね。"},
        { "location": "369/TALK"  , "narrator": "アーヤ", "text": "でも、あれよ？"},
        { "location": "370/TALK"  , "narrator": "アーヤ", "text": "悩みの重さは人それぞれ。"},
        { "location": "371/TALK"  , "narrator": "アーヤ", "text": "他人から見たら\n些細なことでも当人には\n重大な事ってあるから。"},
        { "location": "372/SEL"   , "narrator": "", "text": "他にもっと深刻な悩みはないの？"},
        { "location": "373/ACT"   , "narrator": "", "text": "他にもっと深刻な悩みはないの？"},
        { "location": "375/TALK"  , "narrator": "アーヤ", "text": "え？\nなにそれ。"},
        { "location": "376/TALK"  , "narrator": "アーヤ", "text": "まるで、深刻な悩みが\nあるのが当たり前みたいな\n言い方ね？"},
        { "location": "377/SEL"   , "narrator": "", "text": "普通あるし"},
        { "location": "378/SEL"   , "narrator": "", "text": "本当は隠してない？"},
        { "location": "379/ACT"   , "narrator": "", "text": "普通あるし"},
        { "location": "380/TALK"  , "narrator": "アーヤ", "text": "普通なんて\n人それぞれでしょ？"},
        { "location": "381/ACT"   , "narrator": "", "text": "本当は隠してない？"},
        { "location": "384/TALK"  , "narrator": "アーヤ", "text": "私はいつも\n本当の事しか\n言わないから。"},
        { "location": "386/TALK"  , "narrator": "アーヤ", "text": "前にも言ったけど、\n司書は本当の事だけを\n伝えるのよ。"},
        { "location": "389/TALK"  , "narrator": "アーヤ", "text": "貴方は知らないと思うけど\n司書は本当の事しか\n言わないの。"},
        { "location": "391/TALK"  , "narrator": "アーヤ", "text": "ま、そういうわけだから、\nこの話はこれでおしまい。\nね？"},
        { "location": "394/TALK"  , "narrator": "アーヤ", "text": "それじゃ今回も\nよろしくお願いね。"},
        { "location": "396/TALK"  , "narrator": "アーヤ", "text": "いつも協力してくれて\nありがとう。"},
        { "location": "397/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！"},
        { "location": "409/TALK"  , "narrator": "アーヤ", "text": "はぁ……。"},
        { "location": "25/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月23日　11:31 AM</color>\nとある休日、横須賀にて。"},
        { "location": "246/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "248/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
