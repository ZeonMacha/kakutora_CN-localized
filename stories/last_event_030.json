{
    "dir": "chap40/daydra/last_event_030.js",
    "type": "",
    "info": {
        "story_id": "12204",
        "cid": "",
        "title": "ラストストーリー",
        "sub_title": "ガブリエラより～まず銃は置いて"
    },
    "entry":
    [
        { "location": "23/TALK"   , "narrator": "ガブリエラ", "text": "ふふっ、買い物に\n行って正解だったわ。"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "早く帰って\n飾りたいわ。"},
        { "location": "25/SEL"    , "narrator": "（選択肢）", "text": "いいことでもあったの？"},
        { "location": "26/ACT"    , "narrator": "", "text": "いいことでもあったの？"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよ。\n浅草でとっても可愛い\nこけしを見つけて――"},
        { "location": "29/TALK"   , "narrator": "ガブリエラ", "text": "……は？"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "今のって…、\n$marzanna$！？"},
        { "location": "32/SEL"    , "narrator": "（選択肢）", "text": "よくわかったね"},
        { "location": "33/ACT"    , "narrator": "", "text": "よくわかったね"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "…待って。\nちょっと、冷静に\nなりたいから。"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "場所を変えましょ。\n座ってゆっくり\n話したいわ。"},
        { "location": "59/TALK"   , "narrator": "透明ガブリエラ", "text": "…$marzanna$？"},
        { "location": "60/SEL"    , "narrator": "（選択肢）", "text": "ここにいるよ"},
        { "location": "61/ACT"    , "narrator": "", "text": "ここにいるよ"},
        { "location": "63/TALK"   , "narrator": "透明ガブリエラ", "text": "やっぱり、幻聴じゃ\nなかったのね…。"},
        { "location": "65/TALK"   , "narrator": "透明ガブリエラ", "text": "どういうことなの！？\n今まで、こんな風に\n話せなかったのに…。"},
        { "location": "66/SEL"    , "narrator": "（選択肢）", "text": "ライフギャザーを掌握して、無敵になったからね"},
        { "location": "67/ACT"    , "narrator": "", "text": "ライフギャザーを掌握して、無敵になったからね"},
        { "location": "69/TALK"   , "narrator": "透明ガブリエラ", "text": "なったからねって、\nそれじゃ意味が…。"},
        { "location": "71/TALK"   , "narrator": "透明ガブリエラ", "text": "…ううん、いいわ。\n実際、話せてるのは\n事実なんだし。"},
        { "location": "72/TALK"   , "narrator": "透明ガブリエラ", "text": "…………。"},
        { "location": "73/SEL"    , "narrator": "（選択肢）", "text": "今日は大人しいね？"},
        { "location": "74/SEL"    , "narrator": "（選択肢）", "text": "どうかしたの？"},
        { "location": "75/ACT"    , "narrator": "", "text": "今日は大人しいね？"},
        { "location": "77/TALK"   , "narrator": "透明ガブリエラ", "text": "いつもうるさい\nみたいな言い方\nしないでくれる？"},
        { "location": "78/ACT"    , "narrator": "", "text": "どうかしたの？"},
        { "location": "79/TALK"   , "narrator": "透明ガブリエラ", "text": "別に…大したことじゃ\nないんだけど…。"},
        { "location": "82/TALK"   , "narrator": "透明ガブリエラ", "text": "ただ、まさか急に\nこんなことになると\n思わなかったから…。"},
        { "location": "83/TALK"   , "narrator": "透明ガブリエラ", "text": "ちょっと、色んなこと\n考えたり、思い出し\nたりしちゃってね。"},
        { "location": "84/SEL"    , "narrator": "（選択肢）", "text": "例えば、どんなこと？"},
        { "location": "85/SEL"    , "narrator": "（選択肢）", "text": "お祭りのこととか？"},
        { "location": "86/ACT"    , "narrator": "", "text": "例えば、どんなこと？"},
        { "location": "88/TALK"   , "narrator": "透明ガブリエラ", "text": "言えないわよ。\n本当、色んなこと\nだから…。"},
        { "location": "89/TALK"   , "narrator": "透明ガブリエラ", "text": "でも…、どれも全部、\n$marzanna$が\n関係してるけど。"},
        { "location": "90/ACT"    , "narrator": "", "text": "お祭りのこととか？"},
        { "location": "92/TALK"   , "narrator": "透明ガブリエラ", "text": "ち、違うわよ！！\nってか、よりによって\nどうしてそれよ？"},
        { "location": "93/TALK"   , "narrator": "透明ガブリエラ", "text": "明らかに狙って\n言ってるように\n思えるんだけど？"},
        { "location": "94/SEL"    , "narrator": "（選択肢）", "text": "じゃあ、アーヤとお風呂入ったこと？"},
        { "location": "95/SEL"    , "narrator": "（選択肢）", "text": "$me$のことだったりして"},
        { "location": "96/ACT"    , "narrator": "", "text": "じゃあ、アーヤとお風呂入ったこと？"},
        { "location": "97/TALK"   , "narrator": "透明ガブリエラ", "text": "よくしてるから、\nわざわざ思い出す\nようなことじゃ――"},
        { "location": "98/TALK"   , "narrator": "透明ガブリエラ", "text": "て、テルマエでよ！？\n部屋のお風呂じゃない\nから！！"},
        { "location": "99/TALK"   , "narrator": "透明ガブリエラ", "text": "それに、思い出すのは\n$marzanna$との\nことよ。"},
        { "location": "100/ACT"   , "narrator": "", "text": "$me$のことだったりして"},
        { "location": "101/TALK"  , "narrator": "透明ガブリエラ", "text": "…わかってて\nお祭りの話題\n出したわね？"},
        { "location": "102/TALK"  , "narrator": "透明ガブリエラ", "text": "まあ、わかってるなら\nいいんだけど…。"},
        { "location": "106/TALK"  , "narrator": "透明ガブリエラ", "text": "なんか、あたし達って\nずっとチャットでしか\n話せなかったでしょ？"},
        { "location": "107/TALK"  , "narrator": "透明ガブリエラ", "text": "それが急に、こうして\n普通に話せるように\nなったのに…。"},
        { "location": "109/TALK"  , "narrator": "透明ガブリエラ", "text": "あたし、今みたいに\n普通に話せてる。"},
        { "location": "110/TALK"  , "narrator": "透明ガブリエラ", "text": "これって、その…、\n結構スゴいことなん\nだから。"},
        { "location": "111/SEL"   , "narrator": "（選択肢）", "text": "普通、少し緊張するよね？"},
        { "location": "112/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラって警戒心強いしね"},
        { "location": "113/ACT"   , "narrator": "", "text": "普通、少し緊張するよね？"},
        { "location": "115/TALK"  , "narrator": "透明ガブリエラ", "text": "緊張っていうか…、\nまあ、少しはそれも\nあるけど…。"},
        { "location": "116/TALK"  , "narrator": "透明ガブリエラ", "text": "あたしの場合は、\n警戒心の方が\n強いから…。"},
        { "location": "117/ACT"   , "narrator": "", "text": "ガブリエラって警戒心強いしね"},
        { "location": "119/TALK"  , "narrator": "透明ガブリエラ", "text": "…さすがね。\nよくわかってる\nじゃない。"},
        { "location": "120/TALK"  , "narrator": "透明ガブリエラ", "text": "昔からそうなのよ。\nあたし、どうしても\n初対面の人って…。"},
        { "location": "121/TALK"  , "narrator": "透明ガブリエラ", "text": "人一倍\n警戒しちゃうから…。"},
        { "location": "124/TALK"  , "narrator": "透明ガブリエラ", "text": "今みたいに、言葉で\n話してるのに平然と\nしてる自分が…。"},
        { "location": "125/TALK"  , "narrator": "透明ガブリエラ", "text": "ちょっと不思議だな、\nって感じたの。"},
        { "location": "126/SEL"   , "narrator": "（選択肢）", "text": "信頼してくれてる証拠かな？"},
        { "location": "127/SEL"   , "narrator": "（選択肢）", "text": "愛してくれてる証拠かな？"},
        { "location": "128/ACT"   , "narrator": "", "text": "信頼してくれてる証拠かな？"},
        { "location": "131/TALK"  , "narrator": "透明ガブリエラ", "text": "…それ以上に、\n$marzanna$の\nことを…。"},
        { "location": "132/TALK"  , "narrator": "透明ガブリエラ", "text": "…あ、あい…、\n愛してるから…\nじゃないかしら…。"},
        { "location": "134/TALK"  , "narrator": "透明ガブリエラ", "text": "ふ～ん、自分で\nそんなこと\n言っちゃうんだ？"},
        { "location": "135/TALK"  , "narrator": "透明ガブリエラ", "text": "随分と自信あるのね？"},
        { "location": "139/ACT"   , "narrator": "", "text": "愛してくれてる証拠かな？"},
        { "location": "142/TALK"  , "narrator": "透明ガブリエラ", "text": "…………。"},
        { "location": "143/TALK"  , "narrator": "透明ガブリエラ", "text": "わかった、認める！\nそうよ、愛してるから\n平気なの！"},
        { "location": "144/TALK"  , "narrator": "透明ガブリエラ", "text": "平然としてるって\n言ったけど、\n本当はあたし…。"},
        { "location": "145/TALK"  , "narrator": "透明ガブリエラ", "text": "今、とっても嬉しくて\n舞い上がってるし。"},
        { "location": "146/TALK"  , "narrator": "透明ガブリエラ", "text": "うう…も、もう十分\n伝わったでしょ？"},
        { "location": "148/TALK"  , "narrator": "透明ガブリエラ", "text": "な、なんで\nそうなるのよ！！"},
        { "location": "149/TALK"  , "narrator": "透明ガブリエラ", "text": "そりゃ、ちょっとは\n信頼してるのは\n事実だけど…。"},
        { "location": "150/TALK"  , "narrator": "透明ガブリエラ", "text": "愛はないから！\n調子乗りすぎ！！"},
        { "location": "155/TALK"  , "narrator": "透明ガブリエラ", "text": "…信じてもらえない\nかもしれないけど。"},
        { "location": "156/TALK"  , "narrator": "透明ガブリエラ", "text": "あたし、今こうして\n話せてるのが、\n本当に嬉しいのよ？"},
        { "location": "157/TALK"  , "narrator": "透明ガブリエラ", "text": "大好きな人と、\nやっと言葉で会話する\nことができて…。"},
        { "location": "158/TALK"  , "narrator": "透明ガブリエラ", "text": "ココロの中、とっても\nぽかぽかした気持ちで\nいっぱいなの。"},
        { "location": "161/TALK"  , "narrator": "透明ガブリエラ", "text": "…でも、あたしは\n今まで何度も\nあなたに…。"},
        { "location": "162/TALK"  , "narrator": "透明ガブリエラ", "text": "$marzanna$に、\n助けられてきた。"},
        { "location": "163/TALK"  , "narrator": "透明ガブリエラ", "text": "だから…、\n正直に言うけど――"},
        { "location": "164/TALK"  , "narrator": "透明ガブリエラ", "text": "信頼してる。\nだから、平気だったと\n思ってるわ。"},
        { "location": "166/SEL"   , "narrator": "（選択肢）", "text": "それが聞けてよかった"},
        { "location": "167/SEL"   , "narrator": "（選択肢）", "text": "$me$も同じだよ"},
        { "location": "168/ACT"   , "narrator": "", "text": "それが聞けてよかった"},
        { "location": "171/TALK"  , "narrator": "透明ガブリエラ", "text": "あ、あたしだって…、\n正直になれて、\nよかったと思ってる。"},
        { "location": "173/TALK"  , "narrator": "透明ガブリエラ", "text": "…あたしも、正直に\n言えてよかった。"},
        { "location": "175/ACT"   , "narrator": "", "text": "$me$も同じだよ"},
        { "location": "178/TALK"  , "narrator": "透明ガブリエラ", "text": "…嬉しい。"},
        { "location": "180/TALK"  , "narrator": "透明ガブリエラ", "text": "…な、なによ？\nあたしが喜んだら\nいけない！？"},
        { "location": "182/TALK"  , "narrator": "透明ガブリエラ", "text": "ぱ、パートナーと、\n同じ気持ちだったん\nだもの。"},
        { "location": "184/TALK"  , "narrator": "透明ガブリエラ", "text": "恋人と同じ気持ち\nだったんだもの。"},
        { "location": "186/TALK"  , "narrator": "透明ガブリエラ", "text": "嬉しいわよ…。\nと、当然でしょ！？"},
        { "location": "189/TALK"  , "narrator": "透明ガブリエラ", "text": "文字で伝えるのと、\n言葉で伝えるのって、\n全然違うわね。"},
        { "location": "190/TALK"  , "narrator": "透明ガブリエラ", "text": "ちょっとだけ\n恥ずかしい気持ちに\nなるけど…。"},
        { "location": "194/TALK"  , "narrator": "透明ガブリエラ", "text": "ああ、もう…、\nやっぱりダメ、\nストップ！"},
        { "location": "195/TALK"  , "narrator": "透明ガブリエラ", "text": "今日のあたし、\nなんかダメかも。\nっていうか変よ！"},
        { "location": "196/TALK"  , "narrator": "透明ガブリエラ", "text": "こんな、気持ちが\n先走ってどんどん\n言葉が出てきて…。"},
        { "location": "197/TALK"  , "narrator": "透明ガブリエラ", "text": "言う度に恥ずかしい\n気持ちと、嬉しい\n気持ちになって…。"},
        { "location": "198/TALK"  , "narrator": "透明ガブリエラ", "text": "ううう、なんだか\n暑くなって\nきちゃった。"},
        { "location": "199/SEL"   , "narrator": "（選択肢）", "text": "$me$も顔が暑くなってきた"},
        { "location": "200/SEL"   , "narrator": "（選択肢）", "text": "冷たい物でも頼もう"},
        { "location": "201/SEL"   , "narrator": "（選択肢）", "text": "脱いでいいよ！！"},
        { "location": "202/ACT"   , "narrator": "", "text": "$me$も顔が暑くなってきた"},
        { "location": "203/TALK"  , "narrator": "透明ガブリエラ", "text": "だ、大丈夫よ。\n言いたいことは\nもう全部言えたから。"},
        { "location": "204/ACT"   , "narrator": "", "text": "冷たい物でも頼もう"},
        { "location": "206/TALK"  , "narrator": "透明ガブリエラ", "text": "イヤよ！\nこんな真っ赤な顔、\n見られたくないわ。"},
        { "location": "208/TALK"  , "narrator": "透明ガブリエラ", "text": "それに、その程度で\nどうにかなるとも\n思えないし…。"},
        { "location": "210/TALK"  , "narrator": "透明ガブリエラ", "text": "少し落ち着かないと。\nはぁ…まったく、\n困ったものだわ。"},
        { "location": "213/ACT"   , "narrator": "", "text": "脱いでいいよ！！"},
        { "location": "216/TALK"  , "narrator": "透明ガブリエラ", "text": "ちょっと！\nムードぶち壊すような\nこと言わないで！"},
        { "location": "217/TALK"  , "narrator": "透明ガブリエラ", "text": "まったく、隙あらば\nすぐにエッチなこと\n言うんだから…。"},
        { "location": "218/TALK"  , "narrator": "透明ガブリエラ", "text": "…あ、あたし以外に\nこんなこと言ったら、\n絶対許さないから！"},
        { "location": "220/TALK"  , "narrator": "透明ガブリエラ", "text": "…$marzanna$って、\n一気に冷める発言する\n天才よね。"},
        { "location": "221/TALK"  , "narrator": "透明ガブリエラ", "text": "でも、なんでかしら？\n本気でイヤとは\n思えないのよね…。"},
        { "location": "222/TALK"  , "narrator": "透明ガブリエラ", "text": "…時間掛けて\n洗脳させられたの\nかしら？"},
        { "location": "227/TALK"  , "narrator": "透明ガブリエラ", "text": "…$marzanna$は、\nあたしとずーっと\n一緒にいるけど…。"},
        { "location": "228/TALK"  , "narrator": "透明ガブリエラ", "text": "あたしの、どういう\nところを気に入って\nくれたの？"},
        { "location": "230/TALK"  , "narrator": "透明ガブリエラ", "text": "…ねえ、$marzanna$は\nあたしとずっと一緒に\nいてくれたけど…。"},
        { "location": "231/TALK"  , "narrator": "透明ガブリエラ", "text": "あたしのどこが\n気に入って、一緒に\nいてくれたの？"},
        { "location": "233/SEL"   , "narrator": "（選択肢）", "text": "見た目が可愛いところ"},
        { "location": "234/SEL"   , "narrator": "（選択肢）", "text": "かっこいいところ"},
        { "location": "235/SEL"   , "narrator": "（選択肢）", "text": "ツンデレで可愛いところ"},
        { "location": "236/SEL"   , "narrator": "（選択肢）", "text": "優しくて可愛いところ"},
        { "location": "237/ACT"   , "narrator": "", "text": "見た目が可愛いところ"},
        { "location": "239/TALK"  , "narrator": "透明ガブリエラ", "text": "あ、あのね…。"},
        { "location": "241/TALK"  , "narrator": "透明ガブリエラ", "text": "はぁ…、まあいいわ。\n好きになってもらえた\nのは事実なんだし…。"},
        { "location": "242/TALK"  , "narrator": "透明ガブリエラ", "text": "あたしも、そういう\n$marzanna$を\n好きになったんだし。"},
        { "location": "244/TALK"  , "narrator": "透明ガブリエラ", "text": "はぁ…、まあいいわ。\n碌でもない理由では\nあるけど…。"},
        { "location": "245/TALK"  , "narrator": "透明ガブリエラ", "text": "正直なところは\n信頼できるし。"},
        { "location": "247/ACT"   , "narrator": "", "text": "かっこいいところ"},
        { "location": "249/TALK"  , "narrator": "透明ガブリエラ", "text": "そ、そうなんだ…？\nそっか…あたしって\nかっこいいんだ…。"},
        { "location": "250/TALK"  , "narrator": "透明ガブリエラ", "text": "…ちょっとは、アーヤ\nみたいになれてる、\nってことなのかしら？"},
        { "location": "251/TALK"  , "narrator": "透明ガブリエラ", "text": "ふふっ、ありがと。\n今の、嬉しかったわ。"},
        { "location": "252/ACT"   , "narrator": "", "text": "ツンデレで可愛いところ"},
        { "location": "255/TALK"  , "narrator": "透明ガブリエラ", "text": "…ふーん。\nあたしがツンデレ？"},
        { "location": "256/TALK"  , "narrator": "透明ガブリエラ", "text": "…あたしは、\n$marzanna$が\n好きよ。"},
        { "location": "257/TALK"  , "narrator": "透明ガブリエラ", "text": "…どう？\nツンデレにこんなこと\n言えるかしら？"},
        { "location": "259/TALK"  , "narrator": "透明ガブリエラ", "text": "つ、ツンデレとか\n言わないでよ！"},
        { "location": "260/TALK"  , "narrator": "透明ガブリエラ", "text": "第一、あたしは\nツンデレなんかじゃ\nないし…。"},
        { "location": "262/SEL"   , "narrator": "（選択肢）", "text": "すみませんでした！"},
        { "location": "263/SEL"   , "narrator": "（選択肢）", "text": "もう一度言ってもらえる？"},
        { "location": "264/ACT"   , "narrator": "", "text": "すみませんでした！"},
        { "location": "266/TALK"  , "narrator": "透明ガブリエラ", "text": "…あたしだって、\nちょっとは成長して\nるんだから。"},
        { "location": "268/TALK"  , "narrator": "透明ガブリエラ", "text": "わかればいいのよ。\nまったく…。"},
        { "location": "270/ACT"   , "narrator": "", "text": "もう一度言ってもらえる？"},
        { "location": "272/TALK"  , "narrator": "透明ガブリエラ", "text": "え、ええ、何度でも\n言って…。"},
        { "location": "273/TALK"  , "narrator": "透明ガブリエラ", "text": "…って、無理。\nさすがにそれは\nちょっと…。"},
        { "location": "274/TALK"  , "narrator": "透明ガブリエラ", "text": "でも！　前に比べて\nちょっとは成長して\nるんだから。"},
        { "location": "275/TALK"  , "narrator": "透明ガブリエラ", "text": "そこは認めてよね。"},
        { "location": "277/TALK"  , "narrator": "透明ガブリエラ", "text": "う、うるさいわね！\n一度で十分でしょ！？"},
        { "location": "278/TALK"  , "narrator": "透明ガブリエラ", "text": "…自分でも、ちゃんと\nわかってるんだから。"},
        { "location": "281/ACT"   , "narrator": "", "text": "優しくて可愛いところ"},
        { "location": "283/TALK"  , "narrator": "透明ガブリエラ", "text": "…ありがと。\nお世辞でも嬉しいわ。"},
        { "location": "284/TALK"  , "narrator": "透明ガブリエラ", "text": "けど、優しかったら\nもっと人生上手く\nいってたかも。"},
        { "location": "285/TALK"  , "narrator": "透明ガブリエラ", "text": "つばめにだって、\n始めはあんなにキツく\nあたってたし…。"},
        { "location": "286/SEL"   , "narrator": "（選択肢）", "text": "優しいから仲直りできた"},
        { "location": "287/SEL"   , "narrator": "（選択肢）", "text": "今はもう大好きでしょ？"},
        { "location": "288/ACT"   , "narrator": "", "text": "優しいから仲直りできた"},
        { "location": "291/TALK"  , "narrator": "透明ガブリエラ", "text": "あれは…あたしが\n優しいからじゃ\nないわ。"},
        { "location": "292/TALK"  , "narrator": "透明ガブリエラ", "text": "$marzanna$が\nいてくれて…。"},
        { "location": "293/TALK"  , "narrator": "透明ガブリエラ", "text": "頑張ってくれたから\nだと思ってるわ。"},
        { "location": "295/TALK"  , "narrator": "透明ガブリエラ", "text": "…でも、あたしが\n優しいのも理由だって\n言ってもらえると…。"},
        { "location": "296/TALK"  , "narrator": "透明ガブリエラ", "text": "結構嬉しいわ…。\nふふっ。"},
        { "location": "298/TALK"  , "narrator": "透明ガブリエラ", "text": "…だといいんだけど。"},
        { "location": "300/TALK"  , "narrator": "透明ガブリエラ", "text": "でも、$marzanna$が\n思ってくれたなら…。"},
        { "location": "301/TALK"  , "narrator": "透明ガブリエラ", "text": "本当にそうなのかも、\nって思えるくらい…。"},
        { "location": "302/TALK"  , "narrator": "透明ガブリエラ", "text": "あたし、$marzanna$の\nことを信頼してるわ。"},
        { "location": "304/ACT"   , "narrator": "", "text": "今はもう大好きでしょ？"},
        { "location": "306/TALK"  , "narrator": "透明ガブリエラ", "text": "ま、まあ…あの時より\nマシにはなってるのは\n確かね。"},
        { "location": "307/TALK"  , "narrator": "透明ガブリエラ", "text": "それに、元々嫌ってた\nわけでもないし。"},
        { "location": "308/TALK"  , "narrator": "透明ガブリエラ", "text": "でも、今みたいに\n仲良しになれたのは、\n予想外だったけど。"},
        { "location": "312/TALK"  , "narrator": "透明ガブリエラ", "text": "…あっ、いけない。\n結構長居しちゃった\nみたい…。"},
        { "location": "313/TALK"  , "narrator": "透明ガブリエラ", "text": "暗くなっちゃうから、\nもう帰らないと。"},
        { "location": "329/TALK"  , "narrator": "ガブリエラ", "text": "…なんか、普通に\n話が出来るように\nなったら…。"},
        { "location": "330/TALK"  , "narrator": "ガブリエラ", "text": "時間があっという間に\n過ぎてく感じが\nするわ。"},
        { "location": "331/SEL"   , "narrator": "（選択肢）", "text": "喜んでくれてるのかな？"},
        { "location": "332/SEL"   , "narrator": "（選択肢）", "text": "ちょっと勿体ない気もする"},
        { "location": "333/ACT"   , "narrator": "", "text": "喜んでくれてるのかな？"},
        { "location": "335/TALK"  , "narrator": "ガブリエラ", "text": "…当然でしょ？\n当たり前のこと\n聞かないでよね。"},
        { "location": "337/TALK"  , "narrator": "ガブリエラ", "text": "当然よ。\nそもそもこういうのが\n普通なんだし。"},
        { "location": "339/ACT"   , "narrator": "", "text": "ちょっと勿体ない気もする"},
        { "location": "341/TALK"  , "narrator": "ガブリエラ", "text": "でも、チャットとは\n違って、今までより\n色んなこと…。"},
        { "location": "342/TALK"  , "narrator": "ガブリエラ", "text": "沢山話せるように\nなったから、あたしは\nいいと思うわ。"},
        { "location": "344/TALK"  , "narrator": "ガブリエラ", "text": "その分、話しやすく\nなったんだから\nいいんじゃない？"},
        { "location": "348/TALK"  , "narrator": "ガブリエラ", "text": "…ねえ、\n$marzanna$。"},
        { "location": "349/TALK"  , "narrator": "ガブリエラ", "text": "今まで、本当に\nありがとう。"},
        { "location": "351/TALK"  , "narrator": "ガブリエラ", "text": "…あのさ、\n$marzanna$。"},
        { "location": "352/TALK"  , "narrator": "ガブリエラ", "text": "…あ、ありがとう。"},
        { "location": "354/SEL"   , "narrator": "（選択肢）", "text": "どうして？"},
        { "location": "355/ACT"   , "narrator": "", "text": "どうして？"},
        { "location": "357/TALK"  , "narrator": "ガブリエラ", "text": "今日、こうやって\n平和な日々を迎えて\nいられるのは…。"},
        { "location": "358/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$の\nサポートがあったから\nだもの。"},
        { "location": "359/TALK"  , "narrator": "ガブリエラ", "text": "辛くて苦しいとき、\n何かに悩んでるとき、\nいつも…。"},
        { "location": "360/TALK"  , "narrator": "ガブリエラ", "text": "あたしを、支えて\nくれたから、今日まで\n頑張ってこられた。"},
        { "location": "361/TALK"  , "narrator": "ガブリエラ", "text": "そのお礼よ…。"},
        { "location": "362/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "363/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、ちょっと、\nなにか返しなさいよ！"},
        { "location": "364/TALK"  , "narrator": "ガブリエラ", "text": "あたし、結構勇気\n出して言ったのよ？"},
        { "location": "365/SEL"   , "narrator": "（選択肢）", "text": "そう言ってもらえて嬉しい"},
        { "location": "366/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラが大好きだからね"},
        { "location": "367/ACT"   , "narrator": "", "text": "そう言ってもらえて嬉しい"},
        { "location": "368/TALK"  , "narrator": "ガブリエラ", "text": "ふふっ、そうそう。\nそうやって素直に\n言えばいいのよ？"},
        { "location": "369/ACT"   , "narrator": "", "text": "ガブリエラが大好きだからね"},
        { "location": "370/TALK"  , "narrator": "ガブリエラ", "text": "ちょっ！\nちょっと！！"},
        { "location": "371/TALK"  , "narrator": "ガブリエラ", "text": "こ、こんなところで\n言わなくても……。"},
        { "location": "373/TALK"  , "narrator": "ガブリエラ", "text": "そ、そりゃ\nあたしだって、\n…だ、大好き…よ？"},
        { "location": "375/TALK"  , "narrator": "ガブリエラ", "text": "もう、知らない！"},
        { "location": "381/TALK"  , "narrator": "ガブリエラ", "text": "…今日はサプライズが\nいっぱいで、本当に\n素敵な一日だったわ。"},
        { "location": "382/TALK"  , "narrator": "ガブリエラ", "text": "こんな素敵な日、\nこれからも沢山\nあって欲しいから…。"},
        { "location": "384/TALK"  , "narrator": "ガブリエラ", "text": "これからも…、\nずっとずっと\n一緒にいてね。"},
        { "location": "386/TALK"  , "narrator": "ガブリエラ", "text": "ふう、まったく。\n$marzanna$といると\n疲れちゃうわよね。"},
        { "location": "387/TALK"  , "narrator": "ガブリエラ", "text": "…でも、あんたとの\n毎日は、とっても\n楽しいと思ってる。"},
        { "location": "388/TALK"  , "narrator": "ガブリエラ", "text": "だから…これからも、\nまだまだずっと一緒に\nいなさいよね？"},
        { "location": "390/SEL"   , "narrator": "（選択肢）", "text": "もちろんだよ"},
        { "location": "391/SEL"   , "narrator": "（選択肢）", "text": "実はガブリエラに伝えなければならないことがある"},
        { "location": "392/ACT"   , "narrator": "", "text": "もちろんだよ"},
        { "location": "393/TALK"  , "narrator": "ガブリエラ", "text": "ふふっ、よかった。"},
        { "location": "394/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、またね♪"},
        { "location": "396/ACT"   , "narrator": "", "text": "実はガブリエラに伝えなければならないことがある"},
        { "location": "401/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "402/TALK"  , "narrator": "ガブリエラ", "text": "お別れの時が\n来てしまったのね。"},
        { "location": "403/SEL"   , "narrator": "（選択肢）", "text": "どうしてわかったの？"},
        { "location": "404/ACT"   , "narrator": "", "text": "どうしてわかったの？"},
        { "location": "406/TALK"  , "narrator": "ガブリエラ", "text": "何かしら。直感？\n自分でもよく\nわからないんだけど。"},
        { "location": "407/TALK"  , "narrator": "ガブリエラ", "text": "でも、これだけは\n誤解しないで欲しいの。"},
        { "location": "408/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$との\n別れが寂しくない訳じゃ\nないのよ？"},
        { "location": "409/TALK"  , "narrator": "ガブリエラ", "text": "むしろ、泣きたいくらい\n寂しくて、しがみついて\nでも止めたいくらい。"},
        { "location": "410/TALK"  , "narrator": "ガブリエラ", "text": "けれど、それよりも…\n何かしら。"},
        { "location": "411/TALK"  , "narrator": "ガブリエラ", "text": "温かい気持ちで\nいっぱいで……。"},
        { "location": "412/TALK"  , "narrator": "ガブリエラ", "text": "ただ、\n$marzanna$に、\nありがとう…って。"},
        { "location": "413/TALK"  , "narrator": "ガブリエラ", "text": "そう思ってる。"},
        { "location": "415/TALK"  , "narrator": "ガブリエラ", "text": "えっ――"},
        { "location": "416/TALK"  , "narrator": "ガブリエラ", "text": "な……"},
        { "location": "417/TALK"  , "narrator": "ガブリエラ", "text": "なに？"},
        { "location": "418/SEL"   , "narrator": "（選択肢）", "text": "あと数日でお別れなんだ"},
        { "location": "421/ACT"   , "narrator": "", "text": "あと数日でお別れなんだ"},
        { "location": "423/TALK"  , "narrator": "ガブリエラ", "text": "待って！\nろくでもないことだったら\n怒るから！"},
        { "location": "424/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラをずっと愛してる"},
        { "location": "425/SEL"   , "narrator": "（選択肢）", "text": "こっちの時間で数日後、回線が切れてしまって、もう会えなくなる"},
        { "location": "426/ACT"   , "narrator": "", "text": "ガブリエラをずっと愛してる"},
        { "location": "427/TALK"  , "narrator": "ガブリエラ", "text": "……え？"},
        { "location": "428/TALK"  , "narrator": "ガブリエラ", "text": "それ…なの？"},
        { "location": "430/TALK"  , "narrator": "ガブリエラ", "text": "そんなこと、\n改めて言われなくても\nわかってるから……。"},
        { "location": "431/TALK"  , "narrator": "ガブリエラ", "text": "もう、バカ。"},
        { "location": "433/TALK"  , "narrator": "ガブリエラ", "text": "もう、\nビックリしちゃったわよ。"},
        { "location": "434/TALK"  , "narrator": "ガブリエラ", "text": "でも、愛してるはちょっと\n言い過ぎね。大好き、\nくらいにしておいて頂戴？"},
        { "location": "436/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、またね。"},
        { "location": "438/ACT"   , "narrator": "", "text": "こっちの時間で数日後、回線が切れてしまって、もう会えなくなる"},
        { "location": "439/TALK"  , "narrator": "ガブリエラ", "text": "数日！？！？"},
        { "location": "440/TALK"  , "narrator": "ガブリエラ", "text": "なんで！？\nどうして！？"},
        { "location": "441/TALK"  , "narrator": "ガブリエラ", "text": "なんでそんな、\nあと数日になるまで\n黙ってたの！？"},
        { "location": "442/SEL"   , "narrator": "（選択肢）", "text": "ごめんなさい…"},
        { "location": "443/SEL"   , "narrator": "（選択肢）", "text": "いや、運営が…"},
        { "location": "444/ACT"   , "narrator": "", "text": "ごめんなさい…"},
        { "location": "445/ACT"   , "narrator": "", "text": "いや、運営が…"},
        { "location": "446/TALK"  , "narrator": "ガブリエラ", "text": "言い訳なんか\n聞きたくないし！！"},
        { "location": "448/TALK"  , "narrator": "ガブリエラ", "text": "うっ……酷い、\nあと数日なんて……"},
        { "location": "449/TALK"  , "narrator": "ガブリエラ", "text": "心の整理が\nつけられないし……っ。"},
        { "location": "450/SEL"   , "narrator": "（選択肢）", "text": "ごめんね…"},
        { "location": "451/ACT"   , "narrator": "", "text": "ごめんね…"},
        { "location": "453/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "454/TALK"  , "narrator": "ガブリエラ", "text": "ううん、\nこっちこそごめんなさい。"},
        { "location": "455/TALK"  , "narrator": "ガブリエラ", "text": "大人げなかったわね。"},
        { "location": "456/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと、あまりに\n急だったから\n取り乱しちゃって……。"},
        { "location": "457/TALK"  , "narrator": "ガブリエラ", "text": "あたしも\nまだまだよね…。"},
        { "location": "460/TALK"  , "narrator": "ガブリエラ", "text": "でも……"},
        { "location": "461/TALK"  , "narrator": "ガブリエラ", "text": "わざわざ改まって言うって\nことは、もうどうにも\nならないって事なのよね？"},
        { "location": "462/SEL"   , "narrator": "（選択肢）", "text": "うん"},
        { "location": "463/ACT"   , "narrator": "", "text": "うん"},
        { "location": "465/TALK"  , "narrator": "ガブリエラ", "text": "そう……"},
        { "location": "466/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "467/TALK"  , "narrator": "ガブリエラ", "text": "………。"},
        { "location": "468/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう。\nちゃんと教えてくれて。"},
        { "location": "471/TALK"  , "narrator": "ガブリエラ", "text": "……あまり長々と\nお話しても悪いわよね。"},
        { "location": "472/TALK"  , "narrator": "ガブリエラ", "text": "最後まで、\nあたしと一緒にいてくれて\nありがとう。"},
        { "location": "473/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$の幸せを\nずっとずっと、\n願ってるから。"},
        { "location": "476/TALK"  , "narrator": "ガブリエラ", "text": "あのね。あたし、今ので\nちょっと決心がついた\nことがあって。"},
        { "location": "477/SEL"   , "narrator": "（選択肢）", "text": "もしかして、$me$と絶交するの！？"},
        { "location": "478/SEL"   , "narrator": "（選択肢）", "text": "どんなこと？"},
        { "location": "479/ACT"   , "narrator": "", "text": "もしかして、$me$と絶交するの！？"},
        { "location": "480/TALK"  , "narrator": "ガブリエラ", "text": "ちっ…ちがうわよ！"},
        { "location": "481/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$と\n絶交なんて、するわけ\nないじゃない……。"},
        { "location": "482/TALK"  , "narrator": "ガブリエラ", "text": "例えもう、会えなく\nなっちゃうんだとしても―"},
        { "location": "483/TALK"  , "narrator": "ガブリエラ", "text": "ううん。\nだったら尚更。"},
        { "location": "484/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$のことは\n絶対に忘れない。"},
        { "location": "485/TALK"  , "narrator": "ガブリエラ", "text": "絶交なんて、\nもってのほかよ。"},
        { "location": "486/SEL"   , "narrator": "（選択肢）", "text": "よかった"},
        { "location": "487/ACT"   , "narrator": "", "text": "よかった"},
        { "location": "489/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "490/ACT"   , "narrator": "", "text": "どんなこと？"},
        { "location": "492/TALK"  , "narrator": "ガブリエラ", "text": "…あのね。"},
        { "location": "493/TALK"  , "narrator": "ガブリエラ", "text": "決心ついたことって\nいうのはね……。"},
        { "location": "494/TALK"  , "narrator": "ガブリエラ", "text": "お、"},
        { "location": "495/TALK"  , "narrator": "ガブリエラ", "text": "お父様と、\n仲直りしようと思って。"},
        { "location": "496/TALK"  , "narrator": "ガブリエラ", "text": "こんどワルシャワに\n帰省するの！"},
        { "location": "497/TALK"  , "narrator": "ガブリエラ", "text": "さっきまでは、叔父様の\nところにだけご挨拶\nしようと思ってたけど――"},
        { "location": "498/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり\nお父様のところに\n会いに行く。"},
        { "location": "499/TALK"  , "narrator": "ガブリエラ", "text": "だって！　今なら\n$marzanna$が\n一緒にいてくれるでしょ？"},
        { "location": "500/SEL"   , "narrator": "（選択肢）", "text": "もちろんだよ"},
        { "location": "501/ACT"   , "narrator": "", "text": "もちろんだよ"},
        { "location": "503/TALK"  , "narrator": "ガブリエラ", "text": "あたし、どこかで\n安心してた。"},
        { "location": "504/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$は\nずっと一緒にいるんだろう\nなぁ…って。"},
        { "location": "505/TALK"  , "narrator": "ガブリエラ", "text": "だから、いつかは\nお父様と仲直りしなくちゃ\nって思ってたけど――"},
        { "location": "506/TALK"  , "narrator": "ガブリエラ", "text": "その時は、\n$marzanna$も\nいてもらおうと思ってて。"},
        { "location": "507/TALK"  , "narrator": "ガブリエラ", "text": "それで、実は少しだけ\n安心しちゃってて。\nいつでもいいか…って。"},
        { "location": "508/TALK"  , "narrator": "ガブリエラ", "text": "でも。"},
        { "location": "509/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$が\nいなくなっちゃうって\n聞いて、思ったの。"},
        { "location": "510/TALK"  , "narrator": "ガブリエラ", "text": "今しかない…って。"},
        { "location": "511/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$から\n勇気をもらって、\nお父様と仲直りするの――"},
        { "location": "512/TALK"  , "narrator": "ガブリエラ", "text": "今しかないんだって、\n思ったの。"},
        { "location": "513/SEL"   , "narrator": "（選択肢）", "text": "出来る事なら何でも協力するよ"},
        { "location": "514/ACT"   , "narrator": "", "text": "出来る事なら何でも協力するよ"},
        { "location": "516/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう。"},
        { "location": "517/TALK"  , "narrator": "ガブリエラ", "text": "でも$marzanna$は、\n何もしてくれなくても\nいいの。"},
        { "location": "518/TALK"  , "narrator": "ガブリエラ", "text": "ただ見守ってくれて\nいるだけで。"},
        { "location": "519/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "520/TALK"  , "narrator": "ガブリエラ", "text": "これは、自分だけで\n解決しなくちゃいけない\n問題だから。"},
        { "location": "521/TALK"  , "narrator": "ガブリエラ", "text": "だから、\n$marzanna$は\n何もしないで欲しいの。"},
        { "location": "522/SEL"   , "narrator": "（選択肢）", "text": "わかったよ"},
        { "location": "523/ACT"   , "narrator": "", "text": "わかったよ"},
        { "location": "525/TALK"  , "narrator": "ガブリエラ", "text": "ありがと。"},
        { "location": "527/TALK"  , "narrator": "ガブリエラ", "text": "でも、その間ね、\nずっと傍で待っていて\n欲しくて。"},
        { "location": "528/TALK"  , "narrator": "ガブリエラ", "text": "何故だかわかるかしら？"},
        { "location": "529/SEL"   , "narrator": "（選択肢）", "text": "どうして？"},
        { "location": "530/ACT"   , "narrator": "", "text": "どうして？"},
        { "location": "532/TALK"  , "narrator": "ガブリエラ", "text": "あたしが、お父様と\n仲直り出来た後で。"},
        { "location": "533/TALK"  , "narrator": "ガブリエラ", "text": "そのことを、誰よりも早く\n$marzanna$に\n報告したいから。"},
        { "location": "535/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$に\n良かったね！って\n言って欲しいから……っ。"},
        { "location": "536/TALK"  , "narrator": "ガブリエラ", "text": "だから、\n一緒にいて…？"},
        { "location": "537/SEL"   , "narrator": "（選択肢）", "text": "もちろんだよ"},
        { "location": "538/ACT"   , "narrator": "", "text": "もちろんだよ"},
        { "location": "540/TALK"  , "narrator": "ガブリエラ", "text": "嬉しい……"},
        { "location": "541/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう、\n$marzanna$……。"},
        { "location": "542/TALK"  , "narrator": "ガブリエラ", "text": "あたしの王子様――"},
        { "location": "548/DIALOG", "narrator": "", "text": "それから１ヶ月後。\n\nポーランド共和国、ワルシャワ市――。"},
        { "location": "584/TALK"  , "narrator": "ガブリエラ", "text": "はぁ………。"},
        { "location": "585/TALK"  , "narrator": "ガブリエラ", "text": "あんなに待ちに待った\n故郷に辿り着いたのに…"},
        { "location": "586/TALK"  , "narrator": "ガブリエラ", "text": "いざ、この時に\nなってみると、怖くて\n震えが止まらないわね。"},
        { "location": "587/TALK"  , "narrator": "ガブリエラ", "text": "……お父様。"},
        { "location": "588/TALK"  , "narrator": "ガブリエラ", "text": "たった１年ちょっとの\nことなのに、とても長い間\nお逢いしてない気がするわ"},
        { "location": "589/TALK"  , "narrator": "ガブリエラ", "text": "早く家に戻りたいのに、\n怖くて戻れない。"},
        { "location": "590/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "591/TALK"  , "narrator": "ガブリエラ", "text": "……少しだけ、\nホントにちょっとだけ、\nカフェでお茶しましょ。"},
        { "location": "595/TALK"  , "narrator": "つばめ", "text": "あれ？　ガブちゃん\nどうしちゃったんだろう！"},
        { "location": "596/TALK"  , "narrator": "アーヤ", "text": "疲れたんじゃない？\n家まで後どれくらい\nなのかしらね？"},
        { "location": "599/TALK"  , "narrator": "みやび", "text": "コイガサキは、\nガブちゃんがビビって\n家に帰れないに1000点。"},
        { "location": "601/TALK"  , "narrator": "神楽", "text": "私もそこに1000点ですっ！"},
        { "location": "602/TALK"  , "narrator": "アーヤ", "text": "ちょっと！\n二人とも、応援しに\n来たんじゃないの？"},
        { "location": "603/TALK"  , "narrator": "つばめ", "text": "そうですよっ！\nガブちゃんを励まして\n元気づけなきゃ！"},
        { "location": "604/TALK"  , "narrator": "つばめ", "text": "わたし、行ってきます！"},
        { "location": "607/TALK"  , "narrator": "アーヤ", "text": "あーっ、ちょっと\nつばめ！！"},
        { "location": "610/TALK"  , "narrator": "つばめ", "text": "はい！？"},
        { "location": "611/TALK"  , "narrator": "アーヤ", "text": "私達、一応\nお忍びで来てるんだから！"},
        { "location": "612/TALK"  , "narrator": "つばめ", "text": "ああっ！\nそ、そうでした…えへへ。"},
        { "location": "613/TALK"  , "narrator": "神楽", "text": "ほんっとにもう、\nつばめさんは……"},
        { "location": "617/TALK"  , "narrator": "神楽", "text": "可愛いですねぇっ！！"},
        { "location": "619/TALK"  , "narrator": "アーヤ", "text": "でもホント、\nギャヴィ大丈夫かしら…。"},
        { "location": "620/TALK"  , "narrator": "アーヤ", "text": "ちゃんとお父様と\nお話できると\nいいんだけど……。"},
        { "location": "621/TALK"  , "narrator": "アーヤ", "text": "頑張って、ギャヴィ。\n私達が\n見守ってるから――。"},
        { "location": "641/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "642/TALK"  , "narrator": "ガブリエラ", "text": "ついに来ちゃった。"},
        { "location": "644/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$、いる？"},
        { "location": "645/SEL"   , "narrator": "（選択肢）", "text": "いるよ"},
        { "location": "646/ACT"   , "narrator": "", "text": "いるよ"},
        { "location": "648/TALK"  , "narrator": "ガブリエラ", "text": "良かった。"},
        { "location": "649/TALK"  , "narrator": "ガブリエラ", "text": "ここがあたしの家。\n今はお父様が一人で\n暮らしてるわ。"},
        { "location": "650/SEL"   , "narrator": "（選択肢）", "text": "一緒にガブリエラの家に来れて幸せだよ"},
        { "location": "651/SEL"   , "narrator": "（選択肢）", "text": "心の準備はどう？"},
        { "location": "652/ACT"   , "narrator": "", "text": "一緒にガブリエラの家に来れて幸せだよ"},
        { "location": "653/TALK"  , "narrator": "ガブリエラ", "text": "…ふふ、そうね。"},
        { "location": "654/TALK"  , "narrator": "ガブリエラ", "text": "あたしもちょっと、\n嬉しいかも。"},
        { "location": "655/ACT"   , "narrator": "", "text": "心の準備はどう？"},
        { "location": "656/TALK"  , "narrator": "ガブリエラ", "text": "……うん。\n大丈夫よ？"},
        { "location": "658/TALK"  , "narrator": "ガブリエラ", "text": "ねえ、\n$marzanna$……。"},
        { "location": "659/TALK"  , "narrator": "ガブリエラ", "text": "心臓がドキドキしてる。"},
        { "location": "660/TALK"  , "narrator": "ガブリエラ", "text": "どんな緊張する\n射撃の試合の時だって、"},
        { "location": "661/TALK"  , "narrator": "ガブリエラ", "text": "トライナリーで、\n生死を分かつような\n任務の時だって――"},
        { "location": "662/TALK"  , "narrator": "ガブリエラ", "text": "こんなにドキドキした\nことは無かったわ。"},
        { "location": "663/TALK"  , "narrator": "ガブリエラ", "text": "でもね。"},
        { "location": "664/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$が\n傍にいてくれてるって\nわかってから、"},
        { "location": "665/TALK"  , "narrator": "ガブリエラ", "text": "とっても安心したの。"},
        { "location": "666/SEL"   , "narrator": "（選択肢）", "text": "良かった"},
        { "location": "667/ACT"   , "narrator": "", "text": "良かった"},
        { "location": "669/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "670/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$、\nひとつ、ワガママな\nお願いがあるんだけど。"},
        { "location": "671/TALK"  , "narrator": "ガブリエラ", "text": "あたしが、家でお父様と\nお話している間、回線を\n切ってて欲しいの。"},
        { "location": "672/TALK"  , "narrator": "ガブリエラ", "text": "もちろん、\n終わったらまた\n声を掛けるわ。"},
        { "location": "673/TALK"  , "narrator": "ガブリエラ", "text": "お父様とのお話は、\n真剣勝負だから――"},
        { "location": "674/TALK"  , "narrator": "ガブリエラ", "text": "ひとりで、\nちゃんと自分と向き合って\nやりたいの。"},
        { "location": "675/TALK"  , "narrator": "ガブリエラ", "text": "…いいかしら。"},
        { "location": "676/SEL"   , "narrator": "（選択肢）", "text": "もちろんだよ"},
        { "location": "677/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラは本当に立派だよ"},
        { "location": "678/ACT"   , "narrator": "", "text": "もちろんだよ"},
        { "location": "679/ACT"   , "narrator": "", "text": "ガブリエラは本当に立派だよ"},
        { "location": "681/TALK"  , "narrator": "ガブリエラ", "text": "……ありがとう。"},
        { "location": "682/TALK"  , "narrator": "ガブリエラ", "text": "………。"},
        { "location": "683/TALK"  , "narrator": "ガブリエラ", "text": "…よし。"},
        { "location": "684/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、\n$marzanna$。"},
        { "location": "685/TALK"  , "narrator": "ガブリエラ", "text": "行ってきます！"},
        { "location": "727/TALK"  , "narrator": "マルザンナ", "text": "ついに行っちゃったわね！"},
        { "location": "728/TALK"  , "narrator": "リヴォルカ　", "text": "まあ、後は\n野となれ海となれね。"},
        { "location": "729/TALK"  , "narrator": "マルザンナ", "text": "海じゃなくて山よ……。"},
        { "location": "730/SEL"   , "narrator": "（選択肢）", "text": "二人とも"},
        { "location": "731/ACT"   , "narrator": "", "text": "二人とも"},
        { "location": "734/TALK"  , "narrator": "マルザンナ", "text": "あっ！\n$handle$！！"},
        { "location": "736/TALK"  , "narrator": "リヴォルカ　", "text": "誰かと思えば、\nタダの豚じゃない。"},
        { "location": "737/TALK"  , "narrator": "マルザンナ", "text": "また会えて嬉しいわ。\nリヴォルカなんて、\n毎日寂しがってたし！"},
        { "location": "739/TALK"  , "narrator": "リヴォルカ　", "text": "適当な事\n言わないでよね！！"},
        { "location": "741/TALK"  , "narrator": "リヴォルカ　", "text": "豚が全然来ないから！\nアンタを飼うための\n豚舎が無駄になってるの！"},
        { "location": "742/TALK"  , "narrator": "リヴォルカ　", "text": "責任もって、\nちゃんと住みなさいよ。"},
        { "location": "744/TALK"  , "narrator": "マルザンナ", "text": "リヴォルカ、\n無理を言っちゃダメよ。"},
        { "location": "746/TALK"  , "narrator": "リヴォルカ　", "text": "はいはい、\n解ってるわよ。"},
        { "location": "748/TALK"  , "narrator": "リヴォルカ　", "text": "もうお別れなんでしょ？"},
        { "location": "750/TALK"  , "narrator": "マルザンナ", "text": "寂しいわね。"},
        { "location": "751/SEL"   , "narrator": "（選択肢）", "text": "$me$も寂しい"},
        { "location": "752/SEL"   , "narrator": "（選択肢）", "text": "また会えるよ！"},
        { "location": "753/ACT"   , "narrator": "", "text": "$me$も寂しい"},
        { "location": "754/ACT"   , "narrator": "", "text": "また会えるよ！"},
        { "location": "756/TALK"  , "narrator": "リヴォルカ　", "text": "……せっかく。"},
        { "location": "757/TALK"  , "narrator": "リヴォルカ　", "text": "せっかくこれからだと\n思ってたのに。"},
        { "location": "758/TALK"  , "narrator": "マルザンナ", "text": "でも、本当に。"},
        { "location": "759/TALK"  , "narrator": "マルザンナ", "text": "お別れの最後の最後まで\n一緒にいてくれて\nありがとう。"},
        { "location": "760/TALK"  , "narrator": "マルザンナ", "text": "ねえ、$handle$。\nあたしね――"},
        { "location": "761/TALK"  , "narrator": "マルザンナ", "text": "お父様とは絶対に\n死ぬまで和解出来ないって\n思ってたわ。"},
        { "location": "762/TALK"  , "narrator": "マルザンナ", "text": "でも、いまあたしは、\nお父様とお話してる。"},
        { "location": "763/TALK"  , "narrator": "リヴォルカ　", "text": "正直言えば、\nちょっと信じられない\nことなのよね。"},
        { "location": "764/TALK"  , "narrator": "リヴォルカ　", "text": "あまり認めたくないけど、\nこれも豚のお陰なのよ。"},
        { "location": "765/TALK"  , "narrator": "マルザンナ", "text": "だから、あたしからも\nお礼を言わせて。"},
        { "location": "766/TALK"  , "narrator": "マルザンナ", "text": "……ありがとう。"},
        { "location": "768/TALK"  , "narrator": "マルザンナ", "text": "……ほら、\nリヴォルカも。"},
        { "location": "770/TALK"  , "narrator": "リヴォルカ　", "text": "わ、わかってるわよ！"},
        { "location": "774/TALK"  , "narrator": "リヴォルカ　", "text": "その――"},
        { "location": "775/TALK"  , "narrator": "リヴォルカ　", "text": "あ、ありが…と……豚。"},
        { "location": "777/TALK"  , "narrator": "マルザンナ", "text": "……。"},
        { "location": "778/TALK"  , "narrator": "マルザンナ", "text": "どうか、最後まで\n見届けてください。"},
        { "location": "779/TALK"  , "narrator": "マルザンナ", "text": "あたしの、\n一生で一番の頑張りを。"},
        { "location": "780/SEL"   , "narrator": "（選択肢）", "text": "もちろん見届けるさ"},
        { "location": "781/ACT"   , "narrator": "", "text": "もちろん見届けるさ"},
        { "location": "783/TALK"  , "narrator": "マルザンナ", "text": "ええ。"},
        { "location": "786/TALK"  , "narrator": "リヴォルカ　", "text": "……。"},
        { "location": "787/TALK"  , "narrator": "リヴォルカ　", "text": "終わったみたいよ。\nあたしが豚を呼んでるわ。"},
        { "location": "788/TALK"  , "narrator": "マルザンナ", "text": "行ってあげて、\n$handle$。"},
        { "location": "789/SEL"   , "narrator": "（選択肢）", "text": "二人ともありがとう"},
        { "location": "790/ACT"   , "narrator": "", "text": "二人ともありがとう"},
        { "location": "792/TALK"  , "narrator": "マルザンナ", "text": "ええ。"},
        { "location": "793/TALK"  , "narrator": "リヴォルカ　", "text": "それじゃ――"},
        { "location": "794/TALK"  , "narrator": "マルザンナ", "text": "$handle$と、\nあたしの全てに。"},
        { "location": "795/TALK"  , "narrator": "リヴォルカ　", "text": "素敵なココロの旅を！"},
        { "location": "807/DIALOG", "narrator": "", "text": "$marzanna$！！\n\nねえ、\n$marzanna$！！"},
        { "location": "817/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$！！"},
        { "location": "818/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラ、いるよ！"},
        { "location": "819/ACT"   , "narrator": "", "text": "ガブリエラ、いるよ！"},
        { "location": "821/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$！\nあたし…あたし……"},
        { "location": "822/TALK"  , "narrator": "ガブリエラ", "text": "言えたわ……\nお父様に"},
        { "location": "823/TALK"  , "narrator": "ガブリエラ", "text": "今までごめんなさいって。"},
        { "location": "824/TALK"  , "narrator": "ガブリエラ", "text": "勝手に家を飛び出して\nごめんなさい…って……"},
        { "location": "826/TALK"  , "narrator": "ガブリエラ", "text": "そしたらね、"},
        { "location": "827/TALK"  , "narrator": "ガブリエラ", "text": "お父様も、\n謝ってくださったわ。"},
        { "location": "828/TALK"  , "narrator": "ガブリエラ", "text": "お母様のこと、\nお前のせいじゃないのに\n辛くてずっと遠ざけて――"},
        { "location": "829/TALK"  , "narrator": "ガブリエラ", "text": "銃のことも……。\nあたしが好きでやるなら\n続ければいいって。"},
        { "location": "830/SEL"   , "narrator": "（選択肢）", "text": "よかった！！\nホントによかったよ！"},
        { "location": "831/ACT"   , "narrator": "", "text": "よかった！！\nホントによかったよ！"},
        { "location": "833/TALK"  , "narrator": "ガブリエラ", "text": "嬉しかった……"},
        { "location": "834/TALK"  , "narrator": "ガブリエラ", "text": "ほんとに、ほんとに\n嬉しかった……。"},
        { "location": "835/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう、\n$marzanna$…。"},
        { "location": "841/DIALOG", "narrator": "", "text": "$marzanna$。\nあたしの大切な人。\n\n貴方に出逢えて\n本当によかった――。"}
    ]
}
