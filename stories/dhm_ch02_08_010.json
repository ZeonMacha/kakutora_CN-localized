    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "010_コミットしちゃう？"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "運動には向き不向きがあるって言っても"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "ちょっとみやびのは度を過ぎてるわ"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "運動不足にもほどがある(´o｀；"},
        { "location": "37/SEL"    , "narrator": "", "text": "気にし過ぎじゃない？"},
        { "location": "38/SEL"    , "narrator": "", "text": "体育で十分だよ"},
        { "location": "39/SEL"    , "narrator": "", "text": "一歩前進はしたね"},
        { "location": "40/ACT"    , "narrator": "", "text": "気にし過ぎじゃない？"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "いやいやいやいや"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "高校生であのかた差はないわ"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "固さはないわ"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "ちゃんとしないと"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "困るわよ"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "あれあ"},
        { "location": "47/ACT"    , "narrator": "", "text": "体育で十分だよ"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "授業なら無理にでも運動できるかしら"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "館長からお願いしてもらって"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "特別メニュー組んでもらった方がいいかしら"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "うーん"},
        { "location": "53/ACT"    , "narrator": "", "text": "一歩前進はしたね"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "なあね"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "ここからが大事なのよね"},
        { "location": "59/SEL"    , "narrator": "", "text": "そうなの？"},
        { "location": "60/SEL"    , "narrator": "", "text": "そうかも"},
        { "location": "61/ACT"    , "narrator": "", "text": "そうなの？"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "63/ACT"    , "narrator": "", "text": "そうかも"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "そうでしょ"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "今だけじゃなくて"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "今後にも関わってくるのよ"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "現状がアレだから"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "すぐ改善できるはず"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "って"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "余計なお世話なのかな"}
    ]
