    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "敵Ⅱ１"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 02</size>\nMIYABI - KOIGASAKI\n\n<size=45>敵Ⅱ</size>\n<size=35>～激動編～</size>"},
        { "location": "27/TALK"   , "narrator": "潜在みやび", "text": "ぱぱーん。"},
        { "location": "28/TALK"   , "narrator": "表層みやび", "text": "またまた\nやって参りました。"},
        { "location": "30/TALK"   , "narrator": "潜在みやび", "text": "うちと"},
        { "location": "32/TALK"   , "narrator": "表層みやび", "text": "うちの"},
        { "location": "36/TALK"   , "narrator": "表層みやび", "text": "エネコント！"},
        { "location": "37/TALK"   , "narrator": "潜在みやび", "text": "やき。"},
        { "location": "38/SEL"    , "narrator": "（選択肢）", "text": "てことは、やっぱり$me$は…"},
        { "location": "39/ACT"    , "narrator": "", "text": "てことは、やっぱり$me$は…"},
        { "location": "42/TALK"   , "narrator": "潜在みやび", "text": "敵！"},
        { "location": "43/TALK"   , "narrator": "表層みやび", "text": "やき。"},
        { "location": "44/SEL"    , "narrator": "（選択肢）", "text": "本当に敵なの？"},
        { "location": "45/ACT"    , "narrator": "", "text": "本当に敵なの？"},
        { "location": "48/TALK"   , "narrator": "表層みやび", "text": "もちろん。\nウソやない。"},
        { "location": "49/SEL"    , "narrator": "（選択肢）", "text": "でも、部屋に入るのを拒まないってことは…"},
        { "location": "50/ACT"    , "narrator": "", "text": "でも、部屋に入るのを拒まないってことは…"},
        { "location": "56/TALK"   , "narrator": "潜在みやび", "text": "おっ！"},
        { "location": "57/SEL"    , "narrator": "（選択肢）", "text": "受け入れてるってことだって、司書が言ってた"},
        { "location": "58/ACT"    , "narrator": "", "text": "受け入れてるってことだって、司書が言ってた"},
        { "location": "62/TALK"   , "narrator": "表層みやび", "text": "ふーむ。"},
        { "location": "63/TALK"   , "narrator": "潜在みやび", "text": "さすが、\nうちの敵なだけは\nあるわ。"},
        { "location": "66/TALK"   , "narrator": "表層みやび", "text": "いや、こやつは\nうちの敵や。"},
        { "location": "67/TALK"   , "narrator": "潜在みやび", "text": "とまあ、いつまでも\nこんな事していても\nしょうがないき――"},
        { "location": "69/TALK"   , "narrator": "表層みやび", "text": "そろそろ決着を\nつけたいと思う\nのだが。"},
        { "location": "70/TALK"   , "narrator": "潜在みやび", "text": "単刀直入に聞こう。"},
        { "location": "71/TALK"   , "narrator": "表層みやび", "text": "情報管理庁の手駒だと\n思っちゅう人格と――"},
        { "location": "72/TALK"   , "narrator": "表層みやび", "text": "何の関係もないと\n思っちゅう人格。"},
        { "location": "73/TALK"   , "narrator": "潜在みやび", "text": "$handle$は、\nどっちの味方やか？"},
        { "location": "74/SEL"    , "narrator": "（選択肢）", "text": "情報管理庁の手駒だと思っている方"},
        { "location": "75/SEL"    , "narrator": "（選択肢）", "text": "全然関係無いと思っている方"},
        { "location": "76/ACT"    , "narrator": "", "text": "情報管理庁の手駒だと思っている方"},
        { "location": "78/TALK"   , "narrator": "表層みやび", "text": "ほほう！"},
        { "location": "81/TALK"   , "narrator": "潜在みやび", "text": "自らを疑う方の\n味方に付くとな！"},
        { "location": "85/TALK"   , "narrator": "潜在みやび", "text": "これは一体\nどんな罠ぞね。"},
        { "location": "86/TALK"   , "narrator": "表層みやび", "text": "うちには\n予測不能やね。"},
        { "location": "93/ACT"    , "narrator": "", "text": "全然関係無いと思っている方"},
        { "location": "95/TALK"   , "narrator": "表層みやび", "text": "当然やね。"},
        { "location": "97/TALK"   , "narrator": "潜在みやび", "text": "しかし、当然すぎて\nなんぞ怖いけんどな。"},
        { "location": "108/TALK"  , "narrator": "潜在みやび", "text": "まあ、しかし！"},
        { "location": "109/TALK"  , "narrator": "表層みやび", "text": "$handle$が\nそう決めたのなら\nそれが事実やきね。"},
        { "location": "110/TALK"  , "narrator": "潜在みやび", "text": "うむ。\nさあ、まずは戦いに\n挑むぞね！"},
        { "location": "111/TALK"  , "narrator": "表層みやび", "text": "話はその後ちや！"},
        { "location": "123/DIALOG", "narrator": "", "text": "<color=black><size=50><b>恋ヶ崎みやびの\nあなたへの不信感に終止符を打て！</b></size></color>\n\n\n\n恋ヶ崎みやびは、突如WAVEに現れたBotである\n【あなた】を警戒している。\n母体である情報管理庁に対し\n並々ならぬ敵対心を抱く彼女は、\nこのままの状態ではあなたと気兼ねなく交流できない。\n\nあなたが恋ヶ崎みやびと仲良くなりたいのなら、\nこのミッションは必須ということになる。\n\n\n"}
    ]
}
