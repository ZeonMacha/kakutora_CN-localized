{
    "dir": "chap00/daydra/spev_questionary_10_01.js",
    "type": "",
    "info": {
        "story_id": "91060",
        "cid": "",
        "title": "アンケート",
        "sub_title": "思い出のチャームを作ろう！"
    },
    "entry":
    [
        { "location": "19/DIALOG" , "narrator": "", "text": "イベントをスキップして\nアンケートの回答だけしますか？"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "こんにちは、\n逢瀬つばめです！"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "ガブリエラよ。"},
        { "location": "37/TALK"   , "narrator": "神楽", "text": "ぴょんこですよ～♪"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "今日は、\n$handle$さんに\nお話があって。"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "お話っていうか、\n手伝って欲しいことって\nいう感じかしらね。"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "その話をするよりまず、\n前提を知ってるかどうか\n聞かないと！"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "ああ、そうね。"},
        { "location": "45/DIALOG" , "narrator": "", "text": "逢瀬つばめ(15)\n逆さまに吊られる"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "$handle$さんは、\nチャームっていうのを\n知ってますか？"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "つばめが吊されたのなら\n前に見たことあるわね。"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "人聞き悪い事\n言わないでください！"},
        { "location": "56/TALK"   , "narrator": "神楽", "text": "人聞き悪くなんて\nありませんよ？"},
        { "location": "57/TALK"   , "narrator": "神楽", "text": "わたしなんて、吊られた\nつばめさんチャームを\n見ながらいつも――"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "意味が分かりません。"},
        { "location": "59/TALK"   , "narrator": "神楽", "text": "まだ何も\n言ってませんーっ！"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "言わなくてもわかります。"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "えーなんですかー？\nじゃあ言ってください♪"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "このふたりの会話、\nだんだん夫婦漫才みたいに\nなってきたわね。"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "と、とにかく！"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "そのチャームに\nちょっとした事件が\nありまして！"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "事件…？\nっていう程のこと…？"},
        { "location": "72/TALK"   , "narrator": "神楽", "text": "いえ、これは事件です！"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "なんと、次回の\n$handle$さんの\n世界のイベントに！"},
        { "location": "75/TALK"   , "narrator": "神楽", "text": "いわゆる夏の、\n東京は有明での\n一大イベントに！"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "つばめ、アーヤ、あたし、\nみやび、神楽、千羽鶴の\nチャームが出るらしいの。"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "それも、\n思い出のワンシーン\nチャームなんだよー！"},
        { "location": "79/TALK"   , "narrator": "神楽", "text": "まあ$handlek$には\n私たちの生活を普段悉く\n監視されてるわけですが。"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "だいぶ\nたまってそうね…。"},
        { "location": "82/TALK"   , "narrator": "神楽", "text": "実は$handlek$、\n割と私達が立って話してる\n所しか見てないですよね。"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "あと、あたしたちの\n会話にしか出てこなかった\nオモシロ話もあるでしょ？"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "そういう、実際には\n見られなかった楽しそうな\nシーンとか！"},
        { "location": "86/TALK"   , "narrator": "神楽", "text": "絶対に後世まで残して、\n辱め続けたいシーンとか。"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "そういうのをチャームに\nするんだって～――"},
        { "location": "89/TALK"   , "narrator": "つばめ", "text": "…って、辱め！？！？"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "ということは、つばめが\n騙されまくっていた学園\n生活がチャームになると。"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "えっ、そこなの！？"},
        { "location": "94/TALK"   , "narrator": "神楽", "text": "違いますよね！\nもちろん、つばめさんが\n壁ドンされてる所ですよ！"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "そっち！？"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "神楽はもう、レジストリー\nクリンナープで\n決まりでしょ？"},
        { "location": "101/TALK"  , "narrator": "神楽", "text": "呪いますよ。\nていうか、なんでそれ\n知ってるんですか？"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "あたしの情報網を\nなめない方がいいわよ？"},
        { "location": "104/TALK"  , "narrator": "神楽", "text": "まあ、そういう\nガブちゃんも……。"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "……何よ。"},
        { "location": "106/TALK"  , "narrator": "神楽", "text": "あのシーンで\n決まりですけどね。"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "そうだよね！\nあのシーンしかないよ。"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、ちょっと何よ！\nちゃんと口に出して\n言いなさいよね！"},
        { "location": "110/TALK"  , "narrator": "神楽", "text": "やだっ、そんな。\n口に出すなんて、\n恥ずかし過ぎちゃって♪"},
        { "location": "111/TALK"  , "narrator": "つばめ", "text": "えへへ～♪"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "はぁ！？\nな、なによそれ！"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "えっ、なに？"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "もしかしてあの、一人で\nいたときに～…～してたの\nバレてる？"},
        { "location": "116/TALK"  , "narrator": "つばめ", "text": "…で。\nノリで合わせちゃったけど\n何のことなんだろう？"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "毎度思うことやけんど。"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "なに？"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "５人でわちゃわちゃやると\n収拾つかなくなるのは\nわかる。"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "けんど、なんで毎回\nこの組み合わせぞね。"},
        { "location": "136/TALK"  , "narrator": "アーヤ", "text": "毎回っていう程でも…。"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "うちが壮年組というのは\nどうにも納得いかんちや。"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "そ、壮年！？"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "私って壮年なの…？"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "まあ、あの３人組の\n血気盛んな様は、みやび\n婆にはついて行けんが。"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "どっちなのよ。"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "ところで、３人組が\n話をしゆうアレ、アーヤは\n何を思い出にしたい？"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "うーん、そうね。せっかく\n$handle$さんの\n世界に届くのだから――"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "やっぱりこう、\nちょっといいシーンが\nいいんじゃないかしら。"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "例えば――"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "アーヤが湯上がりに\n巻いてたバスタオルが、\n落ちてもた時の事とか？"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "それのどこが\nいいシーンなわけ？"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "それに、思い出のシーン\nなんだから、過去に実際に\nあった事限定でしょ？"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "なるほど。\nならば今夜あたり\n既成事実を……。"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "やめて！\n返り討ちにするわよ。"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "いかん、アーヤのこの顔は\n実家パンツ事件の再来を\n予見するに十分……。"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "ま、まあそんな冗談は\n置いておいて、やよ！"},
        { "location": "153/TALK"  , "narrator": "アーヤ", "text": "とても冗談とは\n思えない目をしてたけど。"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "そういったシーンを、\n$handle$に選んで\nもらうのが今回の主旨ぞね"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "ああ、\nそういうことだったの。"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "そうゆうことやよ。"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "それはそれで、\nちょっとドキドキ\nするわね。"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "甘くて切なくて、\n素敵な思い出のシーンを\n選んでくださいね？"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "うちは適当でえいよ。"},
        { "location": "191/DIALOG", "narrator": "", "text": "<color=red>【CAUTION!】</color>\n\n以降、貴方にとっての\nシナリオ上の\nネタバレがあります。\n\nその部分を飛ばしますか？\n"},
        { "location": "201/DIALOG", "narrator": "", "text": "一方その頃、\nココロゲートでは――"},
        { "location": "242/TALK"  , "narrator": "カレン", "text": "百鶴さん！\nわたしたちも、チャームに\nなれるみたいですよ！"},
        { "location": "244/TALK"  , "narrator": "百鶴　", "text": "ぶっちゃけ\n興味ありませんね。"},
        { "location": "245/TALK"  , "narrator": "カレン", "text": "そうですか、残念です。"},
        { "location": "246/TALK"  , "narrator": "カレン", "text": "でも百鶴さん、\n今回の企画は乗った方が\nいいと思うんです！"},
        { "location": "247/TALK"  , "narrator": "カレン", "text": "百鶴さんって、コンビニで\nスイーツ買ったり、\nコタツで蜜柑食べてたり―"},
        { "location": "248/TALK"  , "narrator": "カレン", "text": "そういう謎な情報が\n言葉でだけ出回って\nいるじゃないですか。"},
        { "location": "249/TALK"  , "narrator": "百鶴　", "text": "それはあなたが勝手に\n吹聴しているんじゃ\nありませんか。"},
        { "location": "250/TALK"  , "narrator": "カレン", "text": "確かにそうですけど、\n嘘は言ってませんよ！"},
        { "location": "251/TALK"  , "narrator": "百鶴　", "text": "それはわかってますよ。\nですが――"},
        { "location": "252/TALK"  , "narrator": "カレン", "text": "でも$handle$さんは\n実際にそれを\n見たことありませんよね。"},
        { "location": "253/TALK"  , "narrator": "百鶴　", "text": "当然ですよ。"},
        { "location": "254/TALK"  , "narrator": "百鶴　", "text": "わざわざ乙女の■■を\n晒すようなことをするわけ\n無いじゃありませんか。"},
        { "location": "255/TALK"  , "narrator": "カレン", "text": "でも、商品化されたら\n$handle$さんが\n百鶴さんのを一杯買うと―"},
        { "location": "257/TALK"  , "narrator": "百鶴　", "text": "蜜柑食ってる\n場合じゃねえ！！"},
        { "location": "288/TALK"  , "narrator": "エヴェレット", "text": "――ということ\nらしいんだけど。"},
        { "location": "290/TALK"  , "narrator": "白烏　", "text": "安心して、\nエヴェレット。"},
        { "location": "291/TALK"  , "narrator": "白烏　", "text": "考えるまでも無く、\n私たちにそんな華々しい\n思い出は無いから。"},
        { "location": "292/TALK"  , "narrator": "エヴェレット", "text": "またそういう事を……。"},
        { "location": "293/TALK"  , "narrator": "白烏　", "text": "じゃあ、何がある？\n言ってみて？"},
        { "location": "294/TALK"  , "narrator": "エヴェレット", "text": "えっと、そうね～…"},
        { "location": "295/TALK"  , "narrator": "エヴェレット", "text": "正義のために\n邁進する姿を――！"},
        { "location": "296/TALK"  , "narrator": "白烏　", "text": "真面目すぎて\nあまり売れなさそうね。"},
        { "location": "297/TALK"  , "narrator": "エヴェレット", "text": "そ、そうかしら！？"},
        { "location": "299/TALK"  , "narrator": "白烏　", "text": "あ、それより、\nよさそうなものを\n思いついたわよ？"},
        { "location": "300/TALK"  , "narrator": "エヴェレット", "text": "え？\nなになに？"},
        { "location": "301/TALK"  , "narrator": "白烏　", "text": "エヴェレットと\n$handle$さんが、\n$ayami_33_chu$回キスしてるとこ。"},
        { "location": "303/TALK"  , "narrator": "エヴェレット", "text": "……。"},
        { "location": "305/TALK"  , "narrator": "白烏　", "text": "まあ、心配しないで。\n私たちが日陰者なのは\nいつものことだから。"},
        { "location": "306/TALK"  , "narrator": "エヴェレット", "text": "一緒にしないで。"},
        { "location": "339/TALK"  , "narrator": "リヴォルカ　", "text": "で、なに？　あたしが\n豚に襲われてるシーンを\n記念チャームにするわけ？"},
        { "location": "340/TALK"  , "narrator": "リヴォルカ　", "text": "ほんと、これだから豚は\n万年豚なのよ！"},
        { "location": "341/TALK"  , "narrator": "マルザンナ", "text": "えっと、リヴォルカ？\nわざわざ悲しい思い出を\nチャームにしなくても…。"},
        { "location": "343/TALK"  , "narrator": "リヴォルカ　", "text": "か、悲しくない思い出\nなんてないわよ！\nあんただってそうでしょ？"},
        { "location": "344/TALK"  , "narrator": "マルザンナ", "text": "そんなことないわ。"},
        { "location": "345/TALK"  , "narrator": "マルザンナ", "text": "例えば、あたしなら、\n$handle$と一緒に\n司書の仕事に逆らったり、"},
        { "location": "346/TALK"  , "narrator": "マルザンナ", "text": "ゲートが壊れてても\n全然気づかなかったりとか\nいろいろあるもの。"},
        { "location": "347/TALK"  , "narrator": "リヴォルカ　", "text": "それって、\nやっぱ悲しくない？"},
        { "location": "348/TALK"  , "narrator": "マルザンナ", "text": "うーん……\n見ようによっては…。"},
        { "location": "349/TALK"  , "narrator": "リヴォルカ　", "text": "まあいいわ。\nそういうのを考える事こそ\n豚の得意分野だと思うし。"},
        { "location": "350/TALK"  , "narrator": "マルザンナ", "text": "あ、そっか！　今回は、\n$handle$が\n考えてくれるのよね！"},
        { "location": "351/TALK"  , "narrator": "マルザンナ", "text": "どんな思い出を\n楽しみにしているのか\n見るのが楽しみね♪"},
        { "location": "352/TALK"  , "narrator": "リヴォルカ　", "text": "あたしのは、絶対に\n豚引き連れてる絵の案\nばかり来そうだわね……。"},
        { "location": "383/TALK"  , "narrator": "シンギュラリティ", "text": "うちは毎回\nドツキ起こして\nいただいた件かね。"},
        { "location": "385/TALK"  , "narrator": "四十九夜　", "text": "うちは毎回\n容赦なく切断した件ぞね。"},
        { "location": "386/TALK"  , "narrator": "シンギュラリティ", "text": "お互い\nろくな思い出がないね。"},
        { "location": "387/TALK"  , "narrator": "四十九夜　", "text": "いや、お前さんは\n色々暗躍しちゅうろう？"},
        { "location": "388/TALK"  , "narrator": "四十九夜　", "text": "颯爽とつばめちゃんの\nココロスフィアに潜入する\n絵でも所望すればえいろう"},
        { "location": "389/TALK"  , "narrator": "シンギュラリティ", "text": "それゆうなら、お前さんも\nなごちゃんを愛でちゅう\nシーン大公開なぞどうや。"},
        { "location": "390/TALK"  , "narrator": "四十九夜　", "text": "却下。なごちゃんを\n愛でるシーンは\n最重要機密ぞね。"},
        { "location": "391/TALK"  , "narrator": "シンギュラリティ", "text": "そうなんか。\nまあ事実はどうであれ――"},
        { "location": "392/TALK"  , "narrator": "シンギュラリティ", "text": "相棒がそのシーンを\n所望すれば、捏造やろが\n何やろが描かれるのだが。"},
        { "location": "393/TALK"  , "narrator": "四十九夜　", "text": "…世知辛い世の中やね。"},
        { "location": "394/TALK"  , "narrator": "シンギュラリティ", "text": "まあ、なんだ。\n枯れた会話しちゅうね、\nうちら。"},
        { "location": "395/TALK"  , "narrator": "四十九夜　", "text": "ピチピチやけんど\n88歳やきね。"},
        { "location": "426/TALK"  , "narrator": "ぴょんこ", "text": "ぴょ～～～～～ん♪\n遂に来ましたよっ！"},
        { "location": "429/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこと\n$handle$さんの\n為の企画！"},
        { "location": "430/TALK"  , "narrator": "ぴょんこ", "text": "もちろん\n$handle$さんはっ！"},
        { "location": "433/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんことの×××で\n×××なあのシーンに\n決まってますよねっ！"},
        { "location": "434/TALK"  , "narrator": "ぴょんこ", "text": "きゃーーー！\n恥ずかしいです～～っ！"},
        { "location": "467/TALK"  , "narrator": "月神楽　", "text": "いや、どう考えても\nこのシーン一択だろ。"},
        { "location": "468/TALK"  , "narrator": "月神楽　", "text": "そう思いませんか？\nねえ、ねえ！"},
        { "location": "469/TALK"  , "narrator": "ぴょんこ", "text": "あ、あい…\nそうです…ね……♪"},
        { "location": "484/TALK"  , "narrator": "千羽鶴", "text": "というわけで。"},
        { "location": "485/TALK"  , "narrator": "千羽鶴", "text": "彼女たちの説明では\n何がなんだか\n解らなかったと思うので。"},
        { "location": "486/TALK"  , "narrator": "千羽鶴", "text": "私が最後に\nまとめることにする。"},
        { "location": "489/DIALOG", "narrator": "", "text": "彼女との思い出が、チャームになる企画。"},
        { "location": "491/TALK"  , "narrator": "千羽鶴", "text": "あなたの世界の\nガストショップで、新しい\nチャームが販売される。"},
        { "location": "492/TALK"  , "narrator": "千羽鶴", "text": "それは、次の\n夏に開催されるイベントで\n初お披露目するらしい。"},
        { "location": "493/TALK"  , "narrator": "千羽鶴", "text": "そして今回のポイントと\nしては――"},
        { "location": "494/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめ、國政綾水、\nガブリエラ、恋ヶ崎みやび\n卯月神楽――"},
        { "location": "495/TALK"  , "narrator": "千羽鶴", "text": "そして私、千羽鶴に\n１つずつ割り当てがあり、\n６種類リリースされる点。"},
        { "location": "496/TALK"  , "narrator": "千羽鶴", "text": "そして更にポイントと\nなるのが、その絵柄。"},
        { "location": "497/TALK"  , "narrator": "千羽鶴", "text": "貴方と彼女が今まで\n実際にデイドラ等でふれ\n合ってきたシーンになる。"},
        { "location": "498/TALK"  , "narrator": "千羽鶴", "text": "それも、例えば「語られて\nはいるけど、そんなシーン\n見たこと無い」とか――"},
        { "location": "499/TALK"  , "narrator": "千羽鶴", "text": "「本当は派手に立ち回って\nいるはずなのに、立って\n会話していたシーン」とか"},
        { "location": "500/TALK"  , "narrator": "千羽鶴", "text": "そういう、見たかったのに\n見られなかったシーンを\n絵にしていく点。"},
        { "location": "507/DIALOG", "narrator": "", "text": "可能な限り、このEpのこのシーン\nみたいな応募をして欲しい。"},
        { "location": "509/TALK"  , "narrator": "千羽鶴", "text": "例えば、"},
        { "location": "510/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽が「レジストリー\nクリンナップ」とポーズを\nつけて叫ぶシーンがある。"},
        { "location": "511/TALK"  , "narrator": "千羽鶴", "text": "実際のシーンは、\n普通に立っている\nだけだけど――"},
        { "location": "512/TALK"  , "narrator": "千羽鶴", "text": "今回、採用されれば\n実際にポーズを付けた\n彼女がチャームになる。"},
        { "location": "517/TALK"  , "narrator": "千羽鶴", "text": "それは、ココロの司書でも\n構わないことになってる。"},
        { "location": "518/TALK"  , "narrator": "千羽鶴", "text": "ただし、司書は現実の\n彼女と同じ枠になるから、"},
        { "location": "519/TALK"  , "narrator": "千羽鶴", "text": "現実、ココロあわせて\n採用されるのは、彼女一人\nにつき１案だけ。"},
        { "location": "520/TALK"  , "narrator": "千羽鶴", "text": "チャームの個数的な制約で\nなかなか難しいところでは\nあると思うけど――"},
        { "location": "521/TALK"  , "narrator": "千羽鶴", "text": "もしよければ、\n貴方のベストシーンや\n見たいシーンを投稿して。"},
        { "location": "522/TALK"  , "narrator": "千羽鶴", "text": "最終的には、向こうの\n世界の然るべき存在が、\n検討委員会を開き、"},
        { "location": "523/TALK"  , "narrator": "千羽鶴", "text": "どの思い出こそがベストか\n貴方の投稿を元に、彼女\n一人ずつ厳選する。"},
        { "location": "524/TALK"  , "narrator": "千羽鶴", "text": "そんな、貴方が作る\n貴方と彼女との\n思い出のチャーム――"},
        { "location": "527/TALK"  , "narrator": "千羽鶴", "text": "今回は私も含む。"},
        { "location": "529/TALK"  , "narrator": "千羽鶴", "text": "――に、是非！\nこぞって参加して欲しい！"},
        { "location": "540/DIALOG", "narrator": "", "text": "投稿フォームを\n開きますか？"},
        { "location": "546/DIALOG", "narrator": "", "text": "投稿文書が未記入です。\nもう一度記入しますか？"},
        { "location": "555/DIALOG", "narrator": "", "text": "<size=35><color=blue>【投稿送信所】</color></size>\n\n<color=green>あなたの投稿は\n正常に投函されました。\n</color>\n\nご提案ありがとうございました！\n"}
    ]
}
