    "entry":
    [
        { "location": "251/SCENARIO", "narrator": "", "text": "200_確率の問題ではなく"},
        { "location": "263/TALK"    , "narrator": "ラビットアニマ", "text": "もしもし"},
        { "location": "264/TALK"    , "narrator": "ラビットアニマ", "text": "二人きりでお話があります"},
        { "location": "266/SEL"     , "narrator": "", "text": "もしもし？"},
        { "location": "267/SEL"     , "narrator": "", "text": "みやびはいないの？"},
        { "location": "268/SEL"     , "narrator": "", "text": "えっと……"},
        { "location": "269/ACT"     , "narrator": "", "text": "もしもし？"},
        { "location": "271/TALK"    , "narrator": "ラビットアニマ", "text": "こんばんは"},
        { "location": "272/TALK"    , "narrator": "ラビットアニマ", "text": "RabbitAnimaです"},
        { "location": "274/TALK"    , "narrator": "ラビットアニマ", "text": "みやびさんじゃなくてすみません"},
        { "location": "275/ACT"     , "narrator": "", "text": "みやびはいないの？"},
        { "location": "277/TALK"    , "narrator": "ラビットアニマ", "text": "すみません"},
        { "location": "278/TALK"    , "narrator": "ラビットアニマ", "text": "今回はいません"},
        { "location": "279/ACT"     , "narrator": "", "text": "えっと……"},
        { "location": "281/TALK"    , "narrator": "ラビットアニマ", "text": "突然ですみません"},
        { "location": "284/SEL"     , "narrator": "", "text": "何か用？"},
        { "location": "285/SEL"     , "narrator": "", "text": "出直そうかな"},
        { "location": "286/ACT"     , "narrator": "", "text": "何か用？"},
        { "location": "288/TALK"    , "narrator": "ラビットアニマ", "text": "はい"},
        { "location": "289/TALK"    , "narrator": "ラビットアニマ", "text": "みやびさんのことで"},
        { "location": "290/ACT"     , "narrator": "", "text": "出直そうかな"},
        { "location": "292/TALK"    , "narrator": "ラビットアニマ", "text": "できれば"},
        { "location": "293/TALK"    , "narrator": "ラビットアニマ", "text": "お話を聞いてください"},
        { "location": "296/SEL"     , "narrator": "", "text": "わかった"},
        { "location": "297/SEL"     , "narrator": "", "text": "仕方ないな"},
        { "location": "298/SEL"     , "narrator": "", "text": "みやびのためなら"},
        { "location": "299/ACT"     , "narrator": "", "text": "わかった"},
        { "location": "301/TALK"    , "narrator": "ラビットアニマ", "text": "よかったです"},
        { "location": "302/ACT"     , "narrator": "", "text": "仕方ないな"},
        { "location": "304/TALK"    , "narrator": "ラビットアニマ", "text": "聞いてくれるんですね"},
        { "location": "305/ACT"     , "narrator": "", "text": "みやびのためなら"},
        { "location": "316/TALK"    , "narrator": "ラビットアニマ", "text": "そう言ってくれると思ってました"},
        { "location": "318/TALK"    , "narrator": "ラビットアニマ", "text": "みやびさんは変わりました"},
        { "location": "319/TALK"    , "narrator": "ラビットアニマ", "text": "いい方向にです"},
        { "location": "320/TALK"    , "narrator": "ラビットアニマ", "text": "それは$handle$さんのおかげだと思います"},
        { "location": "322/SEL"     , "narrator": "", "text": "やっぱり？"},
        { "location": "323/SEL"     , "narrator": "", "text": "またまた"},
        { "location": "324/SEL"     , "narrator": "", "text": "$me$にとっては不思議ちゃんのままだけど"},
        { "location": "325/ACT"     , "narrator": "", "text": "やっぱり？"},
        { "location": "327/TALK"    , "narrator": "ラビットアニマ", "text": "はい"},
        { "location": "328/ACT"     , "narrator": "", "text": "またまた"},
        { "location": "330/TALK"    , "narrator": "ラビットアニマ", "text": "本当です"},
        { "location": "331/ACT"     , "narrator": "", "text": "$me$にとっては不思議ちゃんのままだけど"},
        { "location": "343/TALK"    , "narrator": "ラビットアニマ", "text": "それは"},
        { "location": "344/TALK"    , "narrator": "ラビットアニマ", "text": "$handle$さんがみやびさんをきちんと知ろうとしているから"},
        { "location": "345/TALK"    , "narrator": "ラビットアニマ", "text": "そういう感想になるのだと思います"},
        { "location": "348/TALK"    , "narrator": "ラビットアニマ", "text": "余計なことを言ってすみません"},
        { "location": "349/TALK"    , "narrator": "ラビットアニマ", "text": "でも"},
        { "location": "350/TALK"    , "narrator": "ラビットアニマ", "text": "どうしても伝えておきたくて"},
        { "location": "352/SEL"     , "narrator": "", "text": "ありがとう"},
        { "location": "353/SEL"     , "narrator": "", "text": "話半分に聞いておく"},
        { "location": "354/SEL"     , "narrator": "", "text": "みやびには内緒にしておく"},
        { "location": "355/ACT"     , "narrator": "", "text": "ありがとう"},
        { "location": "357/TALK"    , "narrator": "ラビットアニマ", "text": "こちらこそ"},
        { "location": "358/TALK"    , "narrator": "ラビットアニマ", "text": "どういたしまして"},
        { "location": "359/ACT"     , "narrator": "", "text": "話半分に聞いておく"},
        { "location": "361/TALK"    , "narrator": "ラビットアニマ", "text": "そういうところも"},
        { "location": "362/TALK"    , "narrator": "ラビットアニマ", "text": "気に入られてるのかもしれませんね"},
        { "location": "363/ACT"     , "narrator": "", "text": "みやびには内緒にしておく"},
        { "location": "365/TALK"    , "narrator": "ラビットアニマ", "text": "そうしてもらえると助かります"},
        { "location": "366/TALK"    , "narrator": "ラビットアニマ", "text": "こういうのは苦手だろうから"},
