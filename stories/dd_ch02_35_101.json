{
    "dir": "chap35/daydra/dd_ch02_35_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "35202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "記憶のドア＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "記憶のドア"},
        { "location": "28/TALK"   , "narrator": "アーヤ", "text": "……。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "ここはどこ？"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "ええと。\n誰かいませんかー？"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "無理かしら？"},
        { "location": "36/SEL"    , "narrator": "", "text": "あなたは死にました"},
        { "location": "37/ACT"    , "narrator": "", "text": "あなたは死にました"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "…そうなのね。"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "ご親切にありがとうって\n言うべきよね。"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "ところで\nあなたは誰？"},
        { "location": "42/SEL"    , "narrator": "", "text": "$me$だよ"},
        { "location": "43/SEL"    , "narrator": "", "text": "$handle$"},
        { "location": "44/SEL"    , "narrator": "", "text": "わからない？"},
        { "location": "45/ACT"    , "narrator": "", "text": "$me$だよ"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "$me$さん？"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "どこかで\n会ったことがある？"},
        { "location": "49/ACT"    , "narrator": "", "text": "わからない？"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "ちょっとわからないわ。"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "ところでどうして\n私が死んだことを\n知ってるの？"},
        { "location": "53/SEL"    , "narrator": "", "text": "選択肢に出たから"},
        { "location": "54/SEL"    , "narrator": "", "text": "勘みたいなアレ"},
        { "location": "55/SEL"    , "narrator": "", "text": "それは秘密"},
        { "location": "56/ACT"    , "narrator": "", "text": "選択肢に出たから"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "そうなのね。"},
        { "location": "58/ACT"    , "narrator": "", "text": "勘みたいなアレ"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "それでわかるの？"},
        { "location": "60/ACT"    , "narrator": "", "text": "それは秘密"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "教えてはくれないのね。"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "私、死んだのか。\n発症したわけ\nじゃなくて。"},
        { "location": "65/SEL"    , "narrator": "", "text": "そうみたい"},
        { "location": "66/SEL"    , "narrator": "", "text": "詳しくはわからない"},
        { "location": "67/SEL"    , "narrator": "", "text": "事情に詳しそうだね"},
        { "location": "68/ACT"    , "narrator": "", "text": "そうみたい"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "はっきりとは\nわからないのね。"},
        { "location": "70/ACT"    , "narrator": "", "text": "詳しくはわからない"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "もう少し\n情報が欲しい\nところだけど。"},
        { "location": "72/ACT"    , "narrator": "", "text": "事情に詳しそうだね"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "多少はね。\n当事者だもの。"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "どっちにしても\n志半ばで力尽きたって\nことよね。"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "もう少し善戦できる\nつもりだったのに。"},
        { "location": "77/SEL"    , "narrator": "", "text": "いつものアーヤと違う"},
        { "location": "78/SEL"    , "narrator": "", "text": "$me$の知ってる\nアーヤじゃない"},
        { "location": "79/SEL"    , "narrator": "", "text": "アーヤはどこ軸の\nアーヤなの？"},
        { "location": "80/ACT"    , "narrator": "", "text": "いつものアーヤと違う"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "…あ。"},
        { "location": "82/ACT"    , "narrator": "", "text": "$me$の知ってる\nアーヤじゃない"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "知ってるアーヤ？"},
        { "location": "84/ACT"    , "narrator": "", "text": "アーヤはどこ軸の\nアーヤなの？"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "どこ軸って…。"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "もしかして私\nフェノメノンに\n囚われてた？"},
        { "location": "88/SEL"    , "narrator": "", "text": "たぶん"},
        { "location": "89/SEL"    , "narrator": "", "text": "そういうことだと思う"},
        { "location": "90/SEL"    , "narrator": "", "text": "察しがいいね"},
        { "location": "91/ACT"    , "narrator": "", "text": "たぶん"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "なるほどね。"},
        { "location": "93/ACT"    , "narrator": "", "text": "そういうことだと思う"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "状況が少し\nわかったわ。"},
        { "location": "95/ACT"    , "narrator": "", "text": "察しがいいね"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "自分のことだし。"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "あなたの知ってる\n國政綾水と私は\n同じだけど別の人間。"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "なんて言うと誤解\nされそうね。\n順を追って話すわ。"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "そもそも私は\n２０３１年の世界から\n送り込まれたの。"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "逢瀬つばめの作った\nフェノメノンの中に。"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "日本を覆うフェノメノンを\n解消するために。"},
        { "location": "104/SEL"   , "narrator": "", "text": "それがアーヤの目的？"},
        { "location": "105/SEL"   , "narrator": "", "text": "そんなアーヤ知らない"},
        { "location": "106/SEL"   , "narrator": "", "text": "今までのアーヤは？"},
        { "location": "107/ACT"   , "narrator": "", "text": "それがアーヤの目的？"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "そうよ。"},
        { "location": "109/ACT"   , "narrator": "", "text": "そんなアーヤ知らない"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "そんなこと\n言われても…。"},
        { "location": "111/ACT"   , "narrator": "", "text": "今までのアーヤは？"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "こっちが聞きたいわ。"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "事前の説明では\n中に入っても記憶は保持\nされるって話だった。"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "でも私、中で何をして\nこうなったのか\n全く憶えてないわ。"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "ねえ。\nあなたは誰？\n私とどういう関係なの？"},
        { "location": "120/SEL"   , "narrator": "", "text": "アーヤの恋人"},
        { "location": "121/SEL"   , "narrator": "", "text": "本当に忘れたんだ…"},
        { "location": "122/SEL"   , "narrator": "", "text": "支援者だよ"},
        { "location": "123/ACT"   , "narrator": "", "text": "アーヤの恋人"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "冗談はやめて。"},
        { "location": "125/ACT"   , "narrator": "", "text": "本当に忘れたんだ…"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい。\n憶えてないのよ。"},
        { "location": "127/ACT"   , "narrator": "", "text": "支援者だよ"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "何を支援して\nくれていたの？"},
        { "location": "129/SEL"   , "narrator": "", "text": "色々"},
        { "location": "130/SEL"   , "narrator": "", "text": "アーヤのこととか"},
        { "location": "131/SEL"   , "narrator": "", "text": "この世界かな…？"},
        { "location": "132/ACT"   , "narrator": "", "text": "色々"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "もっと具体的に\n言って。"},
        { "location": "134/ACT"   , "narrator": "", "text": "アーヤのこととか"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "それはそうだと\n思うけど。"},
        { "location": "136/ACT"   , "narrator": "", "text": "この世界かな…？"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "疑問系なの？"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "どうして支援者に？"},
        { "location": "140/SEL"   , "narrator": "", "text": "千羽鶴に頼まれた"},
        { "location": "141/ACT"   , "narrator": "", "text": "千羽鶴に頼まれた"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "千羽鶴？"},
        { "location": "144/SEL"   , "narrator": "", "text": "つばめのクラン"},
        { "location": "145/ACT"   , "narrator": "", "text": "つばめのクラン"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "…ああ。\nなるほどね。"},
        { "location": "149/TALK"  , "narrator": "アーヤ", "text": "そういう人格が\n顕現しちゃったのね…。"},
        { "location": "151/SEL"   , "narrator": "", "text": "えと…みやびは？"},
        { "location": "152/SEL"   , "narrator": "", "text": "ガブリエラって知ってる？"},
        { "location": "153/SEL"   , "narrator": "", "text": "つばめはわかるよね"},
        { "location": "154/SEL"   , "narrator": "", "text": "神楽っていたよね…？"},
        { "location": "155/ACT"   , "narrator": "", "text": "えと…みやびは？"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "恋ヶ崎みやびね。\n量子系エンジニアの。"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "よくセリシアと一緒に\nいたはず。\n同じ会社だしね。"},
        { "location": "158/TALK"  , "narrator": "アーヤ", "text": "それに、同じ目的を\n志す仲間でもあるわ。"},
        { "location": "159/ACT"   , "narrator": "", "text": "ガブリエラって知ってる？"},
        { "location": "160/TALK"  , "narrator": "アーヤ", "text": "ポーランド軍将校の\n娘さんでしょ。"},
        { "location": "161/TALK"  , "narrator": "アーヤ", "text": "とても無口な子よね。\nまだ中学生くらいだと\n思うけど。"},
        { "location": "162/TALK"  , "narrator": "アーヤ", "text": "同じ目的を志す仲間でも\nあるけど、素性はよく\nわからないわね。"},
        { "location": "163/ACT"   , "narrator": "", "text": "つばめはわかるよね"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "当たり前でしょ\n被験体だもの。"},
        { "location": "165/ACT"   , "narrator": "", "text": "神楽っていたよね…？"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "誰それ？\n知らないわ…。"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "ねえ。私は\n逢瀬つばめの世界の中で\n何をしていたの？"},
        { "location": "170/SEL"   , "narrator": "", "text": "フェノメノンの収束"},
        { "location": "171/SEL"   , "narrator": "", "text": "人形劇サークル"},
        { "location": "172/SEL"   , "narrator": "", "text": "ガブリエラとイチャコラ"},
        { "location": "173/SEL"   , "narrator": "", "text": "$me$の恋人"},
        { "location": "174/ACT"   , "narrator": "", "text": "フェノメノンの収束"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "フェノメノンに洗脳されて\nフェノメノンの収束を\nさせられてたなんて。"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "悪い夢か呪いみたい。"},
        { "location": "178/ACT"   , "narrator": "", "text": "人形劇サークル"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "そんなことしてたの？"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "人形劇ねえ…。\nちょっと子供っぽい\n感じよね。"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "逢瀬つばめの趣味\nだったの？"},
        { "location": "182/TALK"  , "narrator": "アーヤ", "text": "かわいいものが\n好きみたいだし。"},
        { "location": "183/ACT"   , "narrator": "", "text": "ガブリエラとイチャコラ"},
        { "location": "185/TALK"  , "narrator": "アーヤ", "text": "は！？"},
        { "location": "186/TALK"  , "narrator": "アーヤ", "text": "確かにかわいいなって\n思ったけど\nそんな趣味はないわ！？"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "逢瀬つばめ……\nなんでそんなこと…。"},
        { "location": "188/ACT"   , "narrator": "", "text": "$me$の恋人"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "私が憶えてないからって\n適当なこと言わないで。"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "そういう冗談は\n面白くないわ。"},
        { "location": "192/SEL"   , "narrator": "", "text": "$me$は悲しい"},
        { "location": "193/SEL"   , "narrator": "", "text": "アーヤだけど\nアーヤじゃないんだね"},
        { "location": "194/SEL"   , "narrator": "", "text": "思い出してよ"},
        { "location": "195/ACT"   , "narrator": "", "text": "$me$は悲しい"},
        { "location": "196/TALK"  , "narrator": "アーヤ", "text": "そんなこと\n言われても…。"},
        { "location": "197/ACT"   , "narrator": "", "text": "アーヤだけど\nアーヤじゃないんだね"},
        { "location": "198/TALK"  , "narrator": "アーヤ", "text": "そうね。\n最初に言った通りよ。"},
        { "location": "199/ACT"   , "narrator": "", "text": "思い出してよ"},
        { "location": "200/TALK"  , "narrator": "アーヤ", "text": "私だってそうしたいわ。"},
        { "location": "202/TALK"  , "narrator": "アーヤ", "text": "聞きたいことは\n山ほどあるけど。"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "聞いても結局\n虚像でしかない。"},
        { "location": "204/TALK"  , "narrator": "アーヤ", "text": "それに今はもっと\n大事なことがあるわ。\n本部への現状報告。"},
        { "location": "205/TALK"  , "narrator": "アーヤ", "text": "作戦失敗と科学者の\n推測が外れていたこと。"},
        { "location": "206/TALK"  , "narrator": "アーヤ", "text": "特殊部隊が完全に\nフェノメノンに\n取り込まれていたこと。"},
        { "location": "208/TALK"  , "narrator": "アーヤ", "text": "問題は死んでいて\n報告できるか\nどうかってとこ。"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "でも量子的存在なら\n魂だけの私とだって\nコンタクト可能なはず。"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "あなた…ええと\n名前は…。"},
        { "location": "211/SEL"   , "narrator": "", "text": "$handle$だよ"},
        { "location": "212/ACT"   , "narrator": "", "text": "$handle$だよ"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "$handle$、\n協力して。"},
        { "location": "215/TALK"  , "narrator": "アーヤ", "text": "逢瀬つばめの\nフェノメノンからの\n脱出を。"},
        { "location": "216/SEL"   , "narrator": "", "text": "アーヤのために協力する"},
        { "location": "217/SEL"   , "narrator": "", "text": "あなたは$me$の契る\nアーヤではない"},
        { "location": "218/ACT"   , "narrator": "", "text": "アーヤのために協力する"},
        { "location": "220/ACT"   , "narrator": "", "text": "あなたは$me$の契る\nアーヤではない"},
        { "location": "255/TALK"  , "narrator": "エヴェレット", "text": "$handle$さん！！"},
        { "location": "256/SEL"   , "narrator": "", "text": "エヴェレット！"},
        { "location": "257/ACT"   , "narrator": "", "text": "エヴェレット！"},
        { "location": "259/TALK"  , "narrator": "エヴェレット", "text": "来てくれたのね！\n嬉しい！"},
        { "location": "260/TALK"  , "narrator": "エヴェレット", "text": "発症が収まってから\nずっと逢いたかったの。"},
        { "location": "261/SEL"   , "narrator": "", "text": "大丈夫？\n問題ない？"},
        { "location": "262/ACT"   , "narrator": "", "text": "大丈夫？\n問題ない？"},
        { "location": "265/TALK"  , "narrator": "エヴェレット", "text": "ええ、お陰様で。"},
        { "location": "266/TALK"  , "narrator": "エヴェレット", "text": "それより私ね、\n発症したことで\n気づいたことがあるの。"},
        { "location": "267/TALK"  , "narrator": "エヴェレット", "text": "それは、私にとって\n$handle$さんは\n特別な存在だってこと。"},
        { "location": "268/TALK"  , "narrator": "エヴェレット", "text": "私が生きていく中で、\n掛け替えのない存在に\nなっていた貴方。"},
        { "location": "269/TALK"  , "narrator": "エヴェレット", "text": "どうしてもっと早く\nそれに気づけなかったの\nかって、後悔したわ。"},
        { "location": "271/TALK"  , "narrator": "エヴェレット", "text": "だから、また……\nその……"},
        { "location": "272/TALK"  , "narrator": "エヴェレット", "text": "いいかしら？"},
        { "location": "273/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "274/SEL"   , "narrator": "", "text": "愛は形や行動じゃないよ、想いだよ"},
        { "location": "275/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "276/TALK"  , "narrator": "エヴェレット", "text": "ほんと！？\n嬉しい！"},
        { "location": "278/TALK"  , "narrator": "エヴェレット", "text": "それじゃ……"},
        { "location": "299/TALK"  , "narrator": "エヴェレット", "text": "ふわっ……"},
        { "location": "300/TALK"  , "narrator": "エヴェレット", "text": "この感触\nほんとすき。"},
        { "location": "305/TALK"  , "narrator": "エヴェレット", "text": "ひぁっ…"},
        { "location": "307/TALK"  , "narrator": "エヴェレット", "text": "ど、どうしよう、\n止まらない…っ。"},
        { "location": "309/TALK"  , "narrator": "エヴェレット", "text": "ほんと…\n甘い感覚……"},
        { "location": "320/TALK"  , "narrator": "エヴェレット", "text": "……？"},
        { "location": "321/TALK"  , "narrator": "エヴェレット", "text": "えっと、その……\nしてくれないの？"},
        { "location": "322/SEL"   , "narrator": "", "text": "しますします"},
        { "location": "323/SEL"   , "narrator": "", "text": "やっぱやめとく"},
        { "location": "324/ACT"   , "narrator": "", "text": "しますします"},
        { "location": "328/ACT"   , "narrator": "", "text": "やっぱやめとく"},
        { "location": "332/TALK"  , "narrator": "エヴェレット", "text": "はぁ、…はぁっ…。"},
        { "location": "334/TALK"  , "narrator": "エヴェレット", "text": "…もうおわり？\nまだしたいの……"},
        { "location": "335/SEL"   , "narrator": "", "text": "はいはい"},
        { "location": "336/SEL"   , "narrator": "", "text": "もうお終いお終い"},
        { "location": "337/ACT"   , "narrator": "", "text": "はいはい"},
        { "location": "346/ACT"   , "narrator": "", "text": "もうお終いお終い"},
        { "location": "351/TALK"  , "narrator": "エヴェレット", "text": "えええっ！？\nそうなの……？"},
        { "location": "352/TALK"  , "narrator": "エヴェレット", "text": "でも、この前なんて、\n$ayami_33_chu$回も\nキスしてくれたのに。"},
        { "location": "353/TALK"  , "narrator": "エヴェレット", "text": "今度来たときには、\nまたしてね？"},
        { "location": "355/TALK"  , "narrator": "エヴェレット", "text": "えええっ！？\nそうなの……？"},
        { "location": "356/TALK"  , "narrator": "エヴェレット", "text": "まあでも、\nもう$ayami_35_chu$回も\nしてくれたものね。"},
        { "location": "357/TALK"  , "narrator": "エヴェレット", "text": "今度来たときに\nまたしてね？"},
        { "location": "363/TALK"  , "narrator": "エヴェレット", "text": "あっ……そういえば、\nさっきずっと気になってた\nことがあるんだけど。"},
        { "location": "364/SEL"   , "narrator": "", "text": "なに？"},
        { "location": "365/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "367/TALK"  , "narrator": "エヴェレット", "text": "あのね？\nキスするとき、ちゃんと\nその…唇でしてくれてた？"},
        { "location": "368/SEL"   , "narrator": "", "text": "もちろんですよ！"},
        { "location": "369/SEL"   , "narrator": "", "text": "いいえ……"},
        { "location": "370/SEL"   , "narrator": "", "text": "うわ面倒くせぇぇ！"},
        { "location": "371/ACT"   , "narrator": "", "text": "もちろんですよ！"},
        { "location": "372/TALK"  , "narrator": "エヴェレット", "text": "ほんと？\n嬉しい！"},
        { "location": "373/TALK"  , "narrator": "エヴェレット", "text": "またしてね？"},
        { "location": "374/ACT"   , "narrator": "", "text": "いいえ……"},
        { "location": "375/TALK"  , "narrator": "エヴェレット", "text": "ええええっ！"},
        { "location": "376/TALK"  , "narrator": "エヴェレット", "text": "それ、やり直し！"},
        { "location": "383/ACT"   , "narrator": "", "text": "うわ面倒くせぇぇ！"},
        { "location": "384/TALK"  , "narrator": "エヴェレット", "text": "ええっ！？\nそうなの？"},
        { "location": "385/TALK"  , "narrator": "エヴェレット", "text": "うーん……面倒くさいの？\nちょっと意味が\nわからないんだけど。"},
        { "location": "386/TALK"  , "narrator": "エヴェレット", "text": "まあいいわ。なんか\n盛り下がっちゃったし。"},
        { "location": "389/ACT"   , "narrator": "", "text": "愛は形や行動じゃないよ、想いだよ"},
        { "location": "390/TALK"  , "narrator": "エヴェレット", "text": "え……\nそ、そうなの？"},
        { "location": "391/TALK"  , "narrator": "エヴェレット", "text": "ちょっと残念……。"},
        { "location": "395/TALK"  , "narrator": "エヴェレット", "text": "$handle$さん。"},
        { "location": "396/SEL"   , "narrator": "", "text": "エヴェレット、無事だった？"},
        { "location": "397/ACT"   , "narrator": "", "text": "エヴェレット、無事だった？"},
        { "location": "399/TALK"  , "narrator": "エヴェレット", "text": "ええ、お陰様で。"},
        { "location": "403/SEL"   , "narrator": "", "text": "ところで、白烏は無事なの？"},
        { "location": "404/ACT"   , "narrator": "", "text": "ところで、白烏は無事なの？"},
        { "location": "406/TALK"  , "narrator": "エヴェレット", "text": "え？"},
        { "location": "407/TALK"  , "narrator": "エヴェレット", "text": "ええ、もちろん無事よ。\n貴方のお陰で。"},
        { "location": "408/SEL"   , "narrator": "", "text": "よかった！"},
        { "location": "409/ACT"   , "narrator": "", "text": "よかった！"},
        { "location": "411/TALK"  , "narrator": "エヴェレット", "text": "……へえ。"},
        { "location": "412/SEL"   , "narrator": "", "text": "なに？"},
        { "location": "413/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "415/TALK"  , "narrator": "エヴェレット", "text": "いいえ。"},
        { "location": "417/TALK"  , "narrator": "エヴェレット", "text": "貴方が白烏の心配を\nするのってちょっと\n意外だと思っただけ。"},
        { "location": "419/TALK"  , "narrator": "エヴェレット", "text": "やっぱり貴方は\n白烏に魅力を感じて\nいるんだなぁと思って。"},
        { "location": "420/TALK"  , "narrator": "エヴェレット", "text": "前の時も、白烏の\n考えに共感してた\nみたいだし。"},
        { "location": "422/SEL"   , "narrator": "", "text": "なにそれ嫉妬？"},
        { "location": "423/ACT"   , "narrator": "", "text": "なにそれ嫉妬？"},
        { "location": "426/TALK"  , "narrator": "エヴェレット", "text": "ええ。\nそうかもしれないわね。"},
        { "location": "428/TALK"  , "narrator": "エヴェレット", "text": "え？　私が？\nまさか。"},
        { "location": "430/TALK"  , "narrator": "エヴェレット", "text": "なんて、\n馬鹿なこと話してる\n場合じゃなかったわ。"},
        { "location": "431/TALK"  , "narrator": "エヴェレット", "text": "今から私と一緒に\n白烏のところへ\n来てもらえないかしら。"},
        { "location": "433/TALK"  , "narrator": "エヴェレット", "text": "――っと、\nそういえば！"},
        { "location": "435/TALK"  , "narrator": "エヴェレット", "text": "キスしてる\n場合じゃなかったのよ。"},
        { "location": "437/TALK"  , "narrator": "エヴェレット", "text": "ちょっと今から、\n私と一緒に白烏の所に\n来てくれない？"},
        { "location": "438/SEL"   , "narrator": "", "text": "白烏生きてたの！？"},
        { "location": "439/ACT"   , "narrator": "", "text": "白烏生きてたの！？"},
        { "location": "441/TALK"  , "narrator": "エヴェレット", "text": "そりゃそうよ。"},
        { "location": "442/TALK"  , "narrator": "エヴェレット", "text": "人格は倒されても\n死んだり消滅したり\nしないから。"},
        { "location": "443/TALK"  , "narrator": "エヴェレット", "text": "私という総意から\n切り離されることは\nあるけど。"},
        { "location": "444/TALK"  , "narrator": "エヴェレット", "text": "でも、どう転ぶかは\n戦った相手の想い次第\nなんだけどね。"},
        { "location": "445/TALK"  , "narrator": "エヴェレット", "text": "そういう意味では、\n貴方にお礼を\nいわなくちゃね。"},
        { "location": "446/SEL"   , "narrator": "", "text": "なんで？"},
        { "location": "447/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "449/TALK"  , "narrator": "エヴェレット", "text": "白烏の考え方が\n随分と変わった\nみたいだから。"},
        { "location": "450/TALK"  , "narrator": "エヴェレット", "text": "それじゃ、\nいくわよ。"},
        { "location": "456/TALK"  , "narrator": "エヴェレット", "text": "オープンプロセス、\n0x3CB番地から\n0xD4A番地へ。"},
        { "location": "478/TALK"  , "narrator": "エヴェレット", "text": "シーク完了。"},
        { "location": "503/SEL"   , "narrator": "", "text": "白烏！？"},
        { "location": "504/ACT"   , "narrator": "", "text": "白烏！？"},
        { "location": "506/TALK"  , "narrator": "白烏", "text": "…ちょっと。"},
        { "location": "507/TALK"  , "narrator": "白烏", "text": "なんで\n$handle$さんを\n連れてきてるわけ？"},
        { "location": "508/TALK"  , "narrator": "白烏", "text": "やめてって\n言ったじゃない。"},
        { "location": "509/SEL"   , "narrator": "", "text": "大丈夫？\n怪我とかは？"},
        { "location": "510/SEL"   , "narrator": "", "text": "本当に生きてたんだ"},
        { "location": "511/SEL"   , "narrator": "", "text": "なんでそんな尊い格好してるの？"},
        { "location": "512/ACT"   , "narrator": "", "text": "大丈夫？\n怪我とかは？"},
        { "location": "514/TALK"  , "narrator": "白烏", "text": "お陰様で、\n特にダメージはナシ。"},
        { "location": "515/TALK"  , "narrator": "白烏", "text": "貴方の殴り方が\n良かったのね。"},
        { "location": "516/ACT"   , "narrator": "", "text": "本当に生きてたんだ"},
        { "location": "518/TALK"  , "narrator": "白烏", "text": "残念ながらね。"},
        { "location": "519/ACT"   , "narrator": "", "text": "なんでそんな尊い格好してるの？"},
        { "location": "521/TALK"  , "narrator": "白烏", "text": "え？\nああ、神子装束のこと？"},
        { "location": "522/TALK"  , "narrator": "白烏", "text": "まあ確かに神前衣装だから\n尊い格好ではあると\n思うけど――"},
        { "location": "523/TALK"  , "narrator": "白烏", "text": "そんな風にダイレクトに\n言われたのは初めてね。"},
        { "location": "524/TALK"  , "narrator": "白烏", "text": "この姿は、\n本来の私の正装よ。"},
        { "location": "525/TALK"  , "narrator": "白烏", "text": "一応これでも私、\n水鏡の神子の祭司だから。"},
        { "location": "526/TALK"  , "narrator": "白烏", "text": "はぁ…わかってはいたけど\nやっぱり見られると\n恥ずかしいわね。"},
        { "location": "529/SEL"   , "narrator": "", "text": "無事で良かった。\n心配してたんだよ。"},
        { "location": "530/SEL"   , "narrator": "", "text": "それで、どうしてここに連れてきたの？"},
        { "location": "531/ACT"   , "narrator": "", "text": "無事で良かった。\n心配してたんだよ。"},
        { "location": "532/TALK"  , "narrator": "白烏", "text": "またそんな、\nココロにも無い事\n言わないで。"},
        { "location": "533/TALK"  , "narrator": "エヴェレット　", "text": "悟りを開いても\n素直じゃないところは\n変わらないのね。"},
        { "location": "534/TALK"  , "narrator": "白烏", "text": "そ、そんなこと……"},
        { "location": "535/TALK"  , "narrator": "白烏", "text": "…わ、わかったわよ。"},
        { "location": "536/TALK"  , "narrator": "白烏", "text": "ありがと。\n私のことを禊いでくれて。"},
        { "location": "555/TALK"  , "narrator": "白烏", "text": "はあっ…！！"},
        { "location": "556/TALK"  , "narrator": "白烏", "text": "ビックリした…"},
        { "location": "562/TALK"  , "narrator": "白烏", "text": "もう、急に\n撫でたりしないで！"},
        { "location": "563/TALK"  , "narrator": "白烏", "text": "でも、まあ、\n嫌じゃなかったけど……"},
        { "location": "564/ACT"   , "narrator": "", "text": "それで、どうしてここに連れてきたの？"},
        { "location": "567/SEL"   , "narrator": "", "text": "それで、どうしてここに連れてきたの？"},
        { "location": "568/ACT"   , "narrator": "", "text": "それで、どうしてここに連れてきたの？"},
        { "location": "571/TALK"  , "narrator": "エヴェレット　", "text": "それなんだけどね。"},
        { "location": "594/TALK"  , "narrator": "エヴェレット　", "text": "実は、白烏から「種」を\n取り除いたことで\n気づいたんだけど。"},
        { "location": "595/TALK"  , "narrator": "白烏", "text": "今、２つの記憶が\n何の心構えも無い状態で、\n混濁し始めてるのよ。"},
        { "location": "596/SEL"   , "narrator": "", "text": "２つの記憶って？"},
        { "location": "597/SEL"   , "narrator": "", "text": "混濁するってどういうこと？"},
        { "location": "598/ACT"   , "narrator": "", "text": "２つの記憶って？"},
        { "location": "599/TALK"  , "narrator": "白烏", "text": "現実である\n2031年時点の記憶と、\nつばめの世界での記憶。"},
        { "location": "600/ACT"   , "narrator": "", "text": "混濁するってどういうこと？"},
        { "location": "601/TALK"  , "narrator": "エヴェレット　", "text": "貴方にも感覚的に\nわかるだろう言い方を\nするならば――"},
        { "location": "602/TALK"  , "narrator": "エヴェレット　", "text": "夢と現実が\n区別つかなくなる状態。"},
        { "location": "604/SEL"   , "narrator": "", "text": "あーやっぱり"},
        { "location": "605/ACT"   , "narrator": "", "text": "あーやっぱり"},
        { "location": "607/TALK"  , "narrator": "エヴェレット　", "text": "何か心当たりがあるの？"},
        { "location": "608/SEL"   , "narrator": "", "text": "今、現実のアーヤが別人のようになってる"},
        { "location": "609/ACT"   , "narrator": "", "text": "今、現実のアーヤが別人のようになってる"},
        { "location": "611/TALK"  , "narrator": "白烏", "text": "なるほどね。\nやっぱり\nそうなってるか……。"},
        { "location": "612/SEL"   , "narrator": "", "text": "どうしてそんなことに？"},
        { "location": "613/ACT"   , "narrator": "", "text": "どうしてそんなことに？"},
        { "location": "615/TALK"  , "narrator": "白烏", "text": "恐らくは、今\n現実の私が置かれてる\n環境が問題ね。"},
        { "location": "616/TALK"  , "narrator": "エヴェレット　", "text": "もっと具体的に言えば、\n卯月の歌。"},
        { "location": "617/TALK"  , "narrator": "白烏", "text": "つばめのフェノメノンが\n飛散しかけてるの。"},
        { "location": "618/TALK"  , "narrator": "エヴェレット　", "text": "フェノメノンの中から、\nその外側にある現実が\n透けて見えている状態。"},
        { "location": "619/TALK"  , "narrator": "白烏", "text": "ココロは現実の状況に\n即影響される。"},
        { "location": "620/SEL"   , "narrator": "", "text": "そうすると……？"},
        { "location": "621/ACT"   , "narrator": "", "text": "そうすると……？"},
        { "location": "623/TALK"  , "narrator": "エヴェレット　", "text": "そうすると――"},
        { "location": "624/TALK"  , "narrator": "白烏", "text": "私は貴方のことを\n忘れてしまうかも\nしれない。"},
        { "location": "625/TALK"  , "narrator": "エヴェレット　", "text": "厳密には、\n夢オチにされちゃうって\n感じなんだけど。"},
        { "location": "626/SEL"   , "narrator": "", "text": "それは辛すぎる！"},
        { "location": "627/ACT"   , "narrator": "", "text": "それは辛すぎる！"},
        { "location": "630/TALK"  , "narrator": "エヴェレット　", "text": "あら、そうなの？"},
        { "location": "632/TALK"  , "narrator": "エヴェレット　", "text": "私だって同じよ！"},
        { "location": "634/TALK"  , "narrator": "白烏", "text": "……。"},
        { "location": "636/TALK"  , "narrator": "エヴェレット　", "text": "あら？\n白烏は？"},
        { "location": "638/TALK"  , "narrator": "白烏", "text": "自分いじめ？"},
        { "location": "639/TALK"  , "narrator": "エヴェレット　", "text": "貴方が不幸体質だから\n協力してあげてるのよ。"},
        { "location": "640/TALK"  , "narrator": "白烏", "text": "それ、\nちょっと誤解してるから。"},
        { "location": "641/TALK"  , "narrator": "エヴェレット　", "text": "で？\nどうなのよ。"},
        { "location": "642/TALK"  , "narrator": "白烏", "text": "そりゃ、まあ……\nちょっとは寂しいけど……"},
        { "location": "643/TALK"  , "narrator": "エヴェレット　", "text": "よし、それじゃ決まりね。"},
        { "location": "644/SEL"   , "narrator": "", "text": "何が？"},
        { "location": "645/ACT"   , "narrator": "", "text": "何が？"},
        { "location": "648/TALK"  , "narrator": "エヴェレット　", "text": "水鏡の神子のところへ\n行くのよ。"},
        { "location": "672/TALK"  , "narrator": "水鏡の神子", "text": "エヴェレットと\n白烏ですか。"},
        { "location": "673/TALK"  , "narrator": "水鏡の神子", "text": "何故戻れたのです？"},
        { "location": "674/TALK"  , "narrator": "エヴェレット　", "text": "ダーリンのお陰で。"},
        { "location": "675/TALK"  , "narrator": "白烏", "text": "ええ。\n五体満足で生きてるわよ。"},
        { "location": "676/TALK"  , "narrator": "水鏡の神子", "text": "そうでしたか。"},
        { "location": "677/SEL"   , "narrator": "", "text": "お久し振りです"},
        { "location": "678/SEL"   , "narrator": "", "text": "お前ちょっと気に入らないんだけど"},
        { "location": "679/ACT"   , "narrator": "", "text": "お久し振りです"},
        { "location": "680/ACT"   , "narrator": "", "text": "お前ちょっと気に入らないんだけど"},
        { "location": "681/TALK"  , "narrator": "水鏡の神子", "text": "ということは、\n國政綾水のことが\n嫌いなんですね？"},
        { "location": "682/SEL"   , "narrator": "", "text": "まさか！"},
        { "location": "683/SEL"   , "narrator": "", "text": "まあ、ぶっちゃけ推しじゃないけど"},
        { "location": "684/ACT"   , "narrator": "", "text": "まさか！"},
        { "location": "686/TALK"  , "narrator": "水鏡の神子", "text": "國政綾水は私自身\nなのですが……"},
        { "location": "687/TALK"  , "narrator": "水鏡の神子", "text": "まあいいでしょう。"},
        { "location": "688/ACT"   , "narrator": "", "text": "まあ、ぶっちゃけ推しじゃないけど"},
        { "location": "689/TALK"  , "narrator": "水鏡の神子", "text": "推し…？"},
        { "location": "693/TALK"  , "narrator": "エヴェレット　", "text": "は！？"},
        { "location": "694/TALK"  , "narrator": "白烏", "text": "え！？"},
        { "location": "695/SEL"   , "narrator": "", "text": "え"},
        { "location": "696/ACT"   , "narrator": "", "text": "え"},
        { "location": "698/TALK"  , "narrator": "エヴェレット　", "text": "そうなの！？"},
        { "location": "699/TALK"  , "narrator": "白烏", "text": "私の事、\nどうでもいい感じ\nだったのね。"},
        { "location": "700/SEL"   , "narrator": "", "text": "ごめん、そうなんだ"},
        { "location": "701/SEL"   , "narrator": "", "text": "いや、推しじゃないのとずっと支えて行きたいのは別の気持ちだよ！！"},
        { "location": "702/ACT"   , "narrator": "", "text": "ごめん、そうなんだ"},
        { "location": "703/TALK"  , "narrator": "エヴェレット　", "text": "そう。\nもういいわ。"},
        { "location": "704/TALK"  , "narrator": "白烏", "text": "出ていって。"},
        { "location": "711/ACT"   , "narrator": "", "text": "いや、推しじゃないのとずっと支えて行きたいのは別の気持ちだよ！！"},
        { "location": "713/TALK"  , "narrator": "エヴェレット　", "text": "……ふーん。"},
        { "location": "714/TALK"  , "narrator": "白烏", "text": "まあ、いいけど。"},
        { "location": "720/TALK"  , "narrator": "エヴェレット　", "text": "水鏡の神子。\n今日は問題があって\n相談しに来ました。"},
        { "location": "721/TALK"  , "narrator": "白烏", "text": "今、現実とフェノメノンの\n記憶が混濁して、とても\n危険な事になってます。"},
        { "location": "722/TALK"  , "narrator": "水鏡の神子", "text": "そのようですね。"},
        { "location": "723/TALK"  , "narrator": "エヴェレット　", "text": "早急に\n何とかする必要が――"},
        { "location": "724/TALK"  , "narrator": "水鏡の神子", "text": "心配いりません。"},
        { "location": "725/TALK"  , "narrator": "水鏡の神子", "text": "昇華し、フェノメノンを\n纏って世界となれば、\n全ては解決します。"},
        { "location": "726/TALK"  , "narrator": "水鏡の神子", "text": "昇華とフェノメノンは\nすなわち神となること。"},
        { "location": "727/TALK"  , "narrator": "水鏡の神子", "text": "己を含む、その世界全てを\n俯瞰して見ることができ、\nココロは安寧を迎えます。"},
        { "location": "728/TALK"  , "narrator": "エヴェレット　", "text": "残念ですけど、\nフェノメノンはもう\n発生させられません。"},
        { "location": "729/TALK"  , "narrator": "白烏", "text": "私の中から\n種を取ってしまったから。"},
        { "location": "730/TALK"  , "narrator": "水鏡の神子", "text": "……。"},
        { "location": "731/TALK"  , "narrator": "エヴェレット　", "text": "………。"},
        { "location": "732/TALK"  , "narrator": "白烏", "text": "…………。"},
        { "location": "733/SEL"   , "narrator": "", "text": "……………。"},
        { "location": "734/ACT"   , "narrator": "", "text": "……………。"},
        { "location": "737/TALK"  , "narrator": "水鏡の神子", "text": "いいえ。\nまだ存在するようですが。"},
        { "location": "738/TALK"  , "narrator": "エヴェレット　", "text": "え……"},
        { "location": "739/TALK"  , "narrator": "白烏", "text": "ええっ！？\nどういうこと！？"},
        { "location": "740/TALK"  , "narrator": "水鏡の神子", "text": "種を取ったと言いましたが\nどのように？"},
        { "location": "741/TALK"  , "narrator": "白烏", "text": "私が発症し、\n$handle$さんに\n壊してもらったのよ。"},
        { "location": "742/TALK"  , "narrator": "水鏡の神子", "text": "$handle$さん。\n貴方の心持ちを\n正直に伝えてください。"},
        { "location": "747/SEL"   , "narrator": "", "text": "千羽鶴に協力して発症を推進します"},
        { "location": "748/ACT"   , "narrator": "", "text": "千羽鶴に協力して発症を推進します"},
        { "location": "750/TALK"  , "narrator": "エヴェレット　", "text": "……。"},
        { "location": "751/TALK"  , "narrator": "白烏", "text": "なるほどね。\nそういう事か。"},
        { "location": "752/TALK"  , "narrator": "エヴェレット　", "text": "わざとなの！？"},
        { "location": "753/TALK"  , "narrator": "白烏", "text": "落ち着いて、\nエヴェレット。"},
        { "location": "754/TALK"  , "narrator": "白烏", "text": "$handle$さんは\nわざとはやってない。"},
        { "location": "755/TALK"  , "narrator": "白烏", "text": "発症したクランと\n相まみえたとき――"},
        { "location": "756/TALK"  , "narrator": "白烏", "text": "そのクランをどう\n対処するかは、\n戦った相手次第。"},
        { "location": "757/TALK"  , "narrator": "エヴェレット　", "text": "まさか……\nそういうこと……？"},
        { "location": "758/TALK"  , "narrator": "白烏", "text": "そう。\n$handle$さんは、\n発症を望んでいた。"},
        { "location": "759/TALK"  , "narrator": "白烏", "text": "だから、私が発症した\n理由である、種の除去を\n否定してしまったのよ。"},
        { "location": "760/TALK"  , "narrator": "白烏", "text": "無意識でね。"},
        { "location": "761/TALK"  , "narrator": "水鏡の神子", "text": "そのようですね。"},
        { "location": "762/TALK"  , "narrator": "エヴェレット　", "text": "なんてこと……。"},
        { "location": "763/TALK"  , "narrator": "白烏", "text": "まあ、そういう事も\nあるわよ、ね。"},
        { "location": "764/TALK"  , "narrator": "白烏", "text": "ところで、\n$handle$さんに１つ\n聞きたいことがあるの。"},
        { "location": "765/TALK"  , "narrator": "白烏", "text": "私をフェノメノンに\nしたいという希望は\nわかった。"},
        { "location": "766/TALK"  , "narrator": "白烏", "text": "でも、大事なことを\nちゃんと言葉で\n教えて欲しい。"},
        { "location": "767/TALK"  , "narrator": "白烏", "text": "貴方が私にフェノメノンを\n展開させる理由は、\n私の為？　世界の為？"},
        { "location": "768/SEL"   , "narrator": "", "text": "今は大変でも、後で絶対良かったって思ってもらえると信じてるから"},
        { "location": "769/SEL"   , "narrator": "", "text": "申し訳無いけど、アーヤよりも世界の先行きが大事"},
        { "location": "770/ACT"   , "narrator": "", "text": "今は大変でも、後で絶対良かったって思ってもらえると信じてるから"},
        { "location": "771/TALK"  , "narrator": "白烏", "text": "そう。"},
        { "location": "772/TALK"  , "narrator": "白烏", "text": "なら私は、\n$handle$さんを\n信じる。"},
        { "location": "776/TALK"  , "narrator": "エヴェレット　", "text": "ええっ！？\nちょっとどういうこと？"},
        { "location": "779/TALK"  , "narrator": "白烏", "text": "貴方には\n難しいでしょうね、\nエヴェレット。"},
        { "location": "780/TALK"  , "narrator": "白烏", "text": "けど、私は以前、\n発症を任された存在だから\nわかるのよ。"},
        { "location": "781/TALK"  , "narrator": "白烏", "text": "発症は決して悪ではない。\n考え方と\n扱い方次第だって。"},
        { "location": "782/TALK"  , "narrator": "エヴェレット　", "text": "無理無理無理。\nちょっと何言ってるか\nわからないから。"},
        { "location": "783/TALK"  , "narrator": "白烏", "text": "まあ、無理も無いわよね。"},
        { "location": "786/TALK"  , "narrator": "白烏", "text": "少しだけ\nお話しましょうか。"},
        { "location": "789/TALK"  , "narrator": "白烏", "text": "水鏡の神子も\n$handle$さんも\n一緒に。"},
        { "location": "790/ACT"   , "narrator": "", "text": "申し訳無いけど、アーヤよりも世界の先行きが大事"},
        { "location": "791/TALK"  , "narrator": "白烏", "text": "そう。"},
        { "location": "792/TALK"  , "narrator": "白烏", "text": "申し訳無いけど、\nそれだったら\n賛同できない。"},
        { "location": "793/TALK"  , "narrator": "白烏", "text": "後は私たちで\n決着をつけるから、\n貴方は席を外してて。"},
        { "location": "794/SEL"   , "narrator": "", "text": "えっ！？"},
        { "location": "795/ACT"   , "narrator": "", "text": "えっ！？"},
        { "location": "806/TALK"  , "narrator": "水鏡の神子", "text": "……確かに。\nそのようです。"},
        { "location": "807/TALK"  , "narrator": "水鏡の神子", "text": "フェノメノンの為の\nエネルギーの源は\n既に存在しない。"},
        { "location": "808/TALK"  , "narrator": "水鏡の神子", "text": "何故そのような事を？"},
        { "location": "809/TALK"  , "narrator": "エヴェレット　", "text": "それを答える前に、\n逆に聞きたいことが\nあります。"},
        { "location": "810/TALK"  , "narrator": "水鏡の神子", "text": "何でしょうか。"},
        { "location": "811/TALK"  , "narrator": "エヴェレット　", "text": "私がフェノメノン発症に\n否定的なのは\nご存知ですよね？"},
        { "location": "812/TALK"  , "narrator": "水鏡の神子", "text": "もちろん。"},
        { "location": "813/TALK"  , "narrator": "エヴェレット　", "text": "白烏が、\n否定派になったことも\nご存知ですか？"},
        { "location": "814/TALK"  , "narrator": "水鏡の神子", "text": "ええ、もちろん。"},
        { "location": "815/TALK"  , "narrator": "白烏", "text": "では、そこに大きな\n矛盾があることに\nお気づきですか？"},
        { "location": "816/TALK"  , "narrator": "水鏡の神子", "text": "……矛盾？"},
        { "location": "817/TALK"  , "narrator": "白烏", "text": "セルフクランは、\n全ての人格の総元締め。"},
        { "location": "818/TALK"  , "narrator": "白烏", "text": "0xで最も影響力のある\nエヴェレットと――"},
        { "location": "819/TALK"  , "narrator": "エヴェレット　", "text": "1xで発症の役割を\n与えられた白烏。"},
        { "location": "820/TALK"  , "narrator": "白烏", "text": "ほぼ総意に近い影響力を\n網羅する私たちが\n共に否定派の中。"},
        { "location": "821/TALK"  , "narrator": "エヴェレット　", "text": "貴方だけが\n全く揺るぎもせず\n発症に向かっているの。"},
        { "location": "822/TALK"  , "narrator": "水鏡の神子", "text": "……。"},
        { "location": "823/TALK"  , "narrator": "白烏", "text": "それってちょっと\nおかしくないですか？"},
        { "location": "824/TALK"  , "narrator": "エヴェレット　", "text": "セルフクランと\n私たちは、それぞれが\n互いに影響し合う。"},
        { "location": "825/TALK"  , "narrator": "白烏", "text": "なのに今回は、\n全くそれが\n見られないんです。"},
        { "location": "826/SEL"   , "narrator": "", "text": "それってどういう事？"},
        { "location": "827/ACT"   , "narrator": "", "text": "それってどういう事？"},
        { "location": "831/TALK"  , "narrator": "エヴェレット　", "text": "外部からの\n矯正力がとても\n強いのでしょうね。"},
        { "location": "832/TALK"  , "narrator": "白烏", "text": "簡単に言えば、\n洗脳されていると\nいうこと。"},
        { "location": "833/TALK"  , "narrator": "白烏", "text": "まあ、私が\n言える立場では\nないけどね。"},
        { "location": "836/TALK"  , "narrator": "水鏡の神子", "text": "…わかりました。\n私がすこしばかり\n性急すぎたようです。"},
        { "location": "837/TALK"  , "narrator": "水鏡の神子", "text": "少し腰を据えて\n話をしましょうか。"},
        { "location": "838/TALK"  , "narrator": "水鏡の神子", "text": "$handle$も\n一緒に。"},
