{
    "dir": "chap18/daydra/dd_ch03_18_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "18305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "違う気がする＜後編＞"
    },
    "entry":
    [
        { "location": "479/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "480/TALK"  , "narrator": "ガブリエラ", "text": "確かに、アーヤの\n言う通りなのかも\nしれないわね。"},
        { "location": "481/TALK"  , "narrator": "ガブリエラ", "text": "あんなことが\nなかったら、卯月は\nまだきっと隠してた。"},
        { "location": "482/TALK"  , "narrator": "ガブリエラ", "text": "自分がメノウで\nあることを。"},
        { "location": "483/TALK"  , "narrator": "アーヤ", "text": "でしょ？"},
        { "location": "484/TALK"  , "narrator": "ガブリエラ", "text": "ええ。"},
        { "location": "485/TALK"  , "narrator": "ガブリエラ", "text": "でも…あたしは\n聞いてみようと\n思うわ。"},
        { "location": "486/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "487/TALK"  , "narrator": "ガブリエラ", "text": "アーヤに言われて、\n正直今もまだモヤッと\nしてる。"},
        { "location": "488/TALK"  , "narrator": "ガブリエラ", "text": "それでも、やっぱり\n聞いてみるべきだと\n思うのよ。"},
        { "location": "490/TALK"  , "narrator": "ガブリエラ", "text": "多分、これって\nあたし達には必要な\nことだと思うし。"},
        { "location": "491/TALK"  , "narrator": "アーヤ", "text": "どういうこと？"},
        { "location": "492/TALK"  , "narrator": "ガブリエラ", "text": "神楽ってさ、\n考えてみると\n謎だらけじゃない？"},
        { "location": "493/TALK"  , "narrator": "ガブリエラ", "text": "あたし達が神楽の\nことで知ってること\nなんて。"},
        { "location": "494/TALK"  , "narrator": "ガブリエラ", "text": "実はメノウだった、\nってことくらいだし。"},
        { "location": "495/TALK"  , "narrator": "ガブリエラ", "text": "それにさ、この前の\n出動の時だけど！"},
        { "location": "496/TALK"  , "narrator": "ガブリエラ", "text": "自分の家が巻き込まれ\nてる、っていうの、\n言わなかったでしょ？"},
        { "location": "497/TALK"  , "narrator": "ガブリエラ", "text": "あの子、自分のこと\n全然話さないん\nだもの！"},
        { "location": "498/TALK"  , "narrator": "ガブリエラ", "text": "こっちが知るために\n動かなきゃ、永遠に\n何もわからないままよ。"},
        { "location": "500/TALK"  , "narrator": "アーヤ", "text": "…話してくれないと\n思ってるの？"},
        { "location": "501/TALK"  , "narrator": "ガブリエラ", "text": "ええ、思ってるわ。"},
        { "location": "502/TALK"  , "narrator": "ガブリエラ", "text": "アーヤは思ってるの？\n神楽の方から、色々と\n話してくれる、って。"},
        { "location": "503/TALK"  , "narrator": "アーヤ", "text": "…わからない。"},
        { "location": "504/TALK"  , "narrator": "アーヤ", "text": "想像もできないもの。"},
        { "location": "505/TALK"  , "narrator": "ガブリエラ", "text": "でしょ？？"},
        { "location": "506/TALK"  , "narrator": "ガブリエラ", "text": "だからさ、まあ、\n気は進まないかも\nしれないけど。"},
        { "location": "507/TALK"  , "narrator": "ガブリエラ", "text": "必要なこと、と思って\n聞くべきじゃないの\nかしら？"},
        { "location": "508/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "509/TALK"  , "narrator": "ガブリエラ", "text": "ま、アーヤが聞かない\nって言っても\nあたしは買うけど。"},
        { "location": "510/TALK"  , "narrator": "アーヤ", "text": "…ううん。\n言わないわ。"},
        { "location": "511/TALK"  , "narrator": "アーヤ", "text": "ギャヴィの言う通り、\n卯月から話してくれる\nとは思えないし。"},
        { "location": "512/TALK"  , "narrator": "アーヤ", "text": "それなら、こっちから\n知るための行動を\n起こさないと。"},
        { "location": "513/TALK"  , "narrator": "アーヤ", "text": "…できれば仲良く\nしたいしね。"},
        { "location": "515/TALK"  , "narrator": "ガブリエラ", "text": "そういうこと。"},
        { "location": "516/TALK"  , "narrator": "ガブリエラ", "text": "…って、違うでしょ！\n別に仲良くなる必要は\nないんだから…。"},
        { "location": "517/TALK"  , "narrator": "アーヤ", "text": "そうなの？\n私は卯月とも\n仲良くなりたいけど？"},
        { "location": "518/TALK"  , "narrator": "ガブリエラ", "text": "あたしは違うの！"},
        { "location": "519/TALK"  , "narrator": "ガブリエラ", "text": "ほら、さっさと\nＣＤ買って帰るわよ。"},
        { "location": "520/TALK"  , "narrator": "アーヤ", "text": "ふふっ、\n照れちゃって。"},
        { "location": "522/TALK"  , "narrator": "ガブリエラ", "text": "照れてない！"},
        { "location": "523/TALK"  , "narrator": "ガブリエラ", "text": "…仲良く、か…。"},
        { "location": "524/TALK"  , "narrator": "ガブリエラ", "text": "ＣＤ聞いただけで\n卯月がわかるなんて\n思えないけど。"},
        { "location": "526/TALK"  , "narrator": "ガブリエラ", "text": "…可能性は\nゼロじゃない…。"},
        { "location": "529/TALK"  , "narrator": "ガブリエラ", "text": "…なんて、\n甘いかしらね…。"},
        { "location": "540/DIALOG", "narrator": "Dialog_chapter_ch03", "text": "【15 弾の数だけ抱きしめて】"}
    ]
}
