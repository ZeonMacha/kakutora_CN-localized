    "entry":
    [
        { "location": "1251/SCENARIO", "narrator": "", "text": "モマエらは二次元のおにゃにょこが好きなんだろ？"},
        { "location": "1276/TALK"    , "narrator": "神楽", "text": "ドゥフフフ"},
        { "location": "1277/TALK"    , "narrator": "神楽", "text": "二次元萌ゆるよね"},
        { "location": "1279/SEL"     , "narrator": "", "text": "かわいそうな子だったんだね…"},
        { "location": "1280/SEL"     , "narrator": "", "text": "神楽には萌える！"},
        { "location": "1281/SEL"     , "narrator": "", "text": "嫌いじゃないよ"},
        { "location": "1282/ACT"     , "narrator": "", "text": "かわいそうな子だったんだね…"},
        { "location": "1283/TALK"    , "narrator": "神楽", "text": "は？"},
        { "location": "1285/TALK"    , "narrator": "神楽", "text": "もういい"},
        { "location": "1295/ACT"     , "narrator": "", "text": "神楽には萌える！"},
        { "location": "1297/TALK"    , "narrator": "神楽", "text": "やっぱりそっち側の住人なわけだ"},
        { "location": "1298/TALK"    , "narrator": "神楽", "text": "いやいやわかる、みなまで言うな"},
        { "location": "1299/TALK"    , "narrator": "神楽", "text": "楽しいな～♪"},
        { "location": "1300/ACT"     , "narrator": "", "text": "嫌いじゃないよ"},
        { "location": "1301/TALK"    , "narrator": "神楽", "text": "そういう態度"},
        { "location": "1302/TALK"    , "narrator": "神楽", "text": "ぴょんこはきらーい♪"},
        { "location": "1304/TALK"    , "narrator": "神楽", "text": "もうなんて言うんですかね？"},
        { "location": "1306/TALK"    , "narrator": "神楽", "text": "いいとしか言いようがないですよね？"},
        { "location": "1307/TALK"    , "narrator": "神楽", "text": "二次元！二次元！"},
        { "location": "1309/SEL"     , "narrator": "", "text": "えと…何かあった？"},
        { "location": "1310/SEL"     , "narrator": "", "text": "$me$のヨメは神楽だけどなー"},
        { "location": "1311/SEL"     , "narrator": "", "text": "ずいぶんはしゃいでるね"},
        { "location": "1312/ACT"     , "narrator": "", "text": "えと…何かあった？"},
        { "location": "1313/TALK"    , "narrator": "神楽", "text": "話がわかる人を見つけただけです"},
        { "location": "1314/ACT"     , "narrator": "", "text": "$me$のヨメは神楽だけどなー"},
        { "location": "1316/TALK"    , "narrator": "神楽", "text": "ぴょんこを二次元のヨメ扱いするとは業が深くていらっしゃる"},
        { "location": "1318/TALK"    , "narrator": "神楽", "text": "そういうのもひとつの愛ですから"},
        { "location": "1319/TALK"    , "narrator": "神楽", "text": "ぴょんこは受け入れますけど"},
        { "location": "1320/ACT"     , "narrator": "", "text": "ずいぶんはしゃいでるね"},
        { "location": "1321/TALK"    , "narrator": "神楽", "text": "別に普通"},
        { "location": "1323/TALK"    , "narrator": "神楽", "text": "わからない人にわかってもらう必要はないです"},
        { "location": "1324/TALK"    , "narrator": "神楽", "text": "$handlek$がわかる人でぴょんこはうれしいですけど、、、"},
        { "location": "1325/TALK"    , "narrator": "神楽", "text": "本当ですよ？"}
    ]
