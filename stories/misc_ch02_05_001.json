    [
        { "location": "7/SCENARIO", "narrator": "", "text": "001_つばめのこと"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "どこまで共有されてるのか知りたいの"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "はいかいいえで答えて"},
        { "location": "36/SEL"    , "narrator": "", "text": "はい"},
        { "location": "37/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "38/SEL"    , "narrator": "", "text": "何の話？"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "って"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "いきなり言ってもわからないよね(--#)"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "配属された人の話"},
        { "location": "48/ACT"    , "narrator": "", "text": "はい"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "えーと"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "そうじゃなくて"},
        { "location": "51/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "うーん"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "まいったわ"},
        { "location": "55/ACT"    , "narrator": "", "text": "何の話？"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "あら"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "結構会話になってるじゃない♪"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "つばめがトライナリーのメンバーになったことを知ってる（￣ー￣）？"},
        { "location": "62/SEL"    , "narrator": "", "text": "はい"},
        { "location": "63/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "64/SEL"    , "narrator": "", "text": "何の話？"},
        { "location": "65/ACT"    , "narrator": "", "text": "はい"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "当然だわ"},
        { "location": "68/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "あれ"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "知らないの？"},
        { "location": "71/ACT"    , "narrator": "", "text": "何の話？"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "えと"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "しらばっくれてるのヾ(･･ )？"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "そこのことの抒情とか"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "何か聞いてない？"},
        { "location": "78/SEL"    , "narrator": "", "text": "抒情？"},
        { "location": "79/SEL"    , "narrator": "", "text": "聞いてない"},
        { "location": "80/SEL"    , "narrator": "", "text": "つばめの秘密が知りたいの？"},
        { "location": "81/ACT"    , "narrator": "", "text": "抒情？"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "あつ"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "事情よ、事情"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "もー(；´Д｀)"},
        { "location": "86/ACT"    , "narrator": "", "text": "聞いてない"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "じらばっくれてたら怒るわよ(--*;"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "しらばっくれてたら"},
        { "location": "90/ACT"    , "narrator": "", "text": "つばめの秘密が知りたいの？"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "何か知ってるの？"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "聞いたかいがあったわ"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "あっ"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "へんなことにつかうんじゃなくｔ"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "早くここに慣れて欲しいｋら聞くだけだからね"},
        { "location": "108/SEL"   , "narrator": "", "text": "つばめは最年少"},
        { "location": "109/SEL"   , "narrator": "", "text": "つばめは一人っ子"},
        { "location": "110/SEL"   , "narrator": "", "text": "つばめはメノウのファン"},
        { "location": "111/ACT"   , "narrator": "", "text": "つばめは最年少"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "違うわよ(-.-;)"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "ギャヴィが一番年下だもの"},
        { "location": "114/ACT"   , "narrator": "", "text": "つばめは一人っ子"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "そういえばそう言ってたような？"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "一人っ子の方が気楽でいいかもね(｡-_-｡)"},
        { "location": "119/ACT"   , "narrator": "", "text": "つばめはメノウのファン"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "そんなのみんな知ってるし"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "そもそものきっかけがそれだもの(-.-;)"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "うーん(゜-゜)"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "仕方ないかあ"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "つばめには訳慣れてもらいたかったから知ってたら教えてもらいたかったのに"},
        { "location": "127/SEL"   , "narrator": "", "text": "「早く」慣れてもらいたいんだね"},
        { "location": "128/SEL"   , "narrator": "", "text": "リーダーがんばって"},
        { "location": "129/ACT"   , "narrator": "", "text": "「早く」慣れてもらいたいんだね"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "131/TALK"  , "narrator": "アーヤ", "text": "早くね！！"},
        { "location": "133/ACT"   , "narrator": "", "text": "リーダーがんばって"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "まあね(´o｀；"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "がんばります(￣∇￣*)ゞ"},
