    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "迷子"},
        { "location": "18/TALK"   , "narrator": "つばめ", "text": "えっと、確かここを\n曲がると…。"},
        { "location": "20/TALK"   , "narrator": "つばめ", "text": "…やっぱり違う。\nどうしよう…。"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "道に迷っちゃった(´・ω・｀)"},
        { "location": "34/SEL"    , "narrator": "", "text": "今、どの辺にいるの？"},
        { "location": "35/ACT"    , "narrator": "", "text": "今、どの辺にいるの？"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "神楽坂の駅を出たところ(･ｪ･^ )( ^･ｪ･)"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "そんなに駅から離れてなぃと思うけど"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "よくわからない(´つω・｀)ｼｭﾝ"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "どぅしよぅ"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "言われた時間に遅れちゃぅ・゜・(ノД`)・゜・"},
        { "location": "44/SEL"    , "narrator": "", "text": "みやびに電話して助けてもらおう"},
        { "location": "45/SEL"    , "narrator": "", "text": "父親に電話して助けてもらおう！"},
        { "location": "46/ACT"    , "narrator": "", "text": "みやびに電話して助けてもらおう"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "みやびさんを？"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "大丈夫"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "それに"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "まだほとんど知らなぃ人だし"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "こんな理由で呼び出したら"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "失礼だよ(o´Д`)=з"},
        { "location": "55/SEL"    , "narrator": "", "text": "仲間になる人だよ？"},
        { "location": "56/ACT"    , "narrator": "", "text": "仲間になる人だよ？"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "それはそぅだけど"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "大丈夫かな？(･Д･｀)"},
        { "location": "61/SEL"    , "narrator": "", "text": "みやびは面倒見のいい人だ"},
        { "location": "62/ACT"    , "narrator": "", "text": "みやびは面倒見のいい人だ"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "そぅなの？(*´︶`*)"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "わかった"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "ぉ願ぃしてみるo(*･ﾛ･*)o、"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "…………"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "よし、これで…送信！"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "初めて送るメッセージが\n助けてなんて、ちょっと\nかっこ悪いけど――"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "みやびさん、\nお願いします！"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "……。"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "…あっ！\nみやびさーん！！"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "お待たせ、つばめちゃん。"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "ごめんなさい、急に\n呼び出しちゃったりして。"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "えいからえいから。\nこういう時のための\nお友達登録やき。"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "まあ、まだ来たばかり\nやき、何も恥ずかしい\nことやないよ？"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "ごめんなさい。でも、\nできればこれっきりに\nしたいです…。"},
        { "location": "99/ACT"    , "narrator": "", "text": "父親に電話して助けてもらおう！"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "ぇっ！？"},
        { "location": "102/TALK"  , "narrator": "つばめ", "text": "それはちょっと"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "他の方法考えるよ(´･ω･｀) "},
        { "location": "106/SEL"   , "narrator": "", "text": "どうして？"},
        { "location": "107/ACT"   , "narrator": "", "text": "どうして？"},
        { "location": "109/TALK"  , "narrator": "つばめ", "text": "どぅしてって(･Д･｀)"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "ほら"},
        { "location": "111/TALK"  , "narrator": "つばめ", "text": "ぉ父さん静岡にぃるし"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "電話しても無駄だよ(o´Д`)=з"},
        { "location": "114/SEL"   , "narrator": "", "text": "電話したくないの？"},
        { "location": "115/ACT"   , "narrator": "", "text": "電話したくないの？"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "そぅぃぅわけじゃなくて"},
        { "location": "119/TALK"  , "narrator": "つばめ", "text": "そんなことで電話するほど"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "子供じゃなぃしヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "122/SEL"   , "narrator": "", "text": "もしかして、ケンカ中とか？"},
        { "location": "123/SEL"   , "narrator": "", "text": "ごめん、冗談だった"},
        { "location": "124/ACT"   , "narrator": "", "text": "もしかして、ケンカ中とか？"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "自分で考ぇてみる(´･ω･｀) "},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "それじゃ"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "141/TALK"  , "narrator": "つばめ", "text": "やっぱり、今はまだ\n電話できないかも…。"},
        { "location": "142/TALK"  , "narrator": "つばめ", "text": "何か他の方法を\n考えないと…。"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "何やってんのよ、新人？"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "ひゃわっ！？"},
        { "location": "149/TALK"  , "narrator": "つばめ", "text": "が、ガブちゃん！！"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "ガブちゃん言うな！\nガブリエラ先輩、でしょ？"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "それより、\nこんなところで\n何やってんの？"},
        { "location": "154/TALK"  , "narrator": "つばめ", "text": "えっと…帰り道が\nわからなくなっちゃって、\nその…。"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…迷子とか、\nドン臭いにも\n程があるわ。"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "ほら、劇場はこっちよ。\n早く来なさい。"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "う、うん…"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "でも、せんぱいは\nどうしてここにいるん\nですか？"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "あんたが変なところで\n曲がったのを見たから、\nつけてきたのよ。"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "隠れて何かやってるの\nかと思ったら、まさか\n迷子って…。"},
        { "location": "164/TALK"  , "narrator": "つばめ", "text": "お願い！　このことは\nみんなには秘密にして！"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "は？　\n言うわけないじゃん。"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "他人の失敗を言い触らす\n趣味、持ってないし。"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "170/TALK"  , "narrator": "つばめ", "text": "ありがと、ガブちゃん。"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "う、うるさい！\nそれと先輩って\n呼びなさい！"},
        { "location": "173/ACT"   , "narrator": "", "text": "ごめん、冗談だった"},
        { "location": "174/TALK"  , "narrator": "つばめ", "text": "冗談言ってる状況じゃないよー…"},
        { "location": "175/TALK"  , "narrator": "つばめ", "text": "もういい、自分で考えるね"},
        { "location": "187/TALK"  , "narrator": "つばめ", "text": "どうしよう、このままじゃ\nバイトの時間に間に合わ\nない…。"},
        { "location": "188/TALK"  , "narrator": "つばめ", "text": "道に迷って帰れません、\nって劇場に電話した方が\nいいかな？"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "何やってんのよ、新人？"},
        { "location": "194/TALK"  , "narrator": "つばめ", "text": "ひゃわっ！？"},
