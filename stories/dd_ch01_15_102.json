{
    "dir": "chap15/daydra/dd_ch01_15_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "15105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "薄い本の森＜後編＞"
    },
    "entry":
    [
        { "location": "520/TALK"  , "narrator": "つばめ", "text": "うーん…。"},
        { "location": "522/TALK"  , "narrator": "つばめ", "text": "…や、やっぱり、\nちょっとだけ\n読んでみようかなぁ？"},
        { "location": "523/TALK"  , "narrator": "つばめ", "text": "そ、そーっと…。"},
        { "location": "524/TALK"  , "narrator": "つばめ", "text": "だ、ダメ！\nやっぱり恥ずかしい！"},
        { "location": "525/TALK"  , "narrator": "つばめ", "text": "…でも、やっぱり\nちょっとくらいは\n見てみないと。"},
        { "location": "526/TALK"  , "narrator": "つばめ", "text": "せっかく卯月さんが\n連れてきてくれたん\nだし…。"},
        { "location": "527/TALK"  , "narrator": "つばめ", "text": "…この辺のサンプル、\n見てみようかな。"},
        { "location": "533/TALK"  , "narrator": "神楽", "text": "…ふふっ、つばめさん、\nあんなに慌てて…。"},
        { "location": "535/TALK"  , "narrator": "つばめ", "text": "…あれ？\nこれどうなってるん\nだろう…。"},
        { "location": "536/TALK"  , "narrator": "つばめ", "text": "えっと、この人の身体が\nこうくっついていて、\nそれで…。"},
        { "location": "538/TALK"  , "narrator": "つばめ", "text": "っ！？"},
        { "location": "540/TALK"  , "narrator": "つばめ", "text": "…わ、わたしは何も\n見てません。"},
        { "location": "541/TALK"  , "narrator": "つばめ", "text": "こ、こっちのは…。"},
        { "location": "542/TALK"  , "narrator": "つばめ", "text": "…えぇー。\nこれ、何なんだろ？"},
        { "location": "543/TALK"  , "narrator": "つばめ", "text": "この人、何でこんな\n格好してるのに\n恥ずかしくないの？"},
        { "location": "544/TALK"  , "narrator": "つばめ", "text": "…よくわからない\n漫画だなぁ。"},
        { "location": "545/TALK"  , "narrator": "つばめ", "text": "こっちのは…。"},
        { "location": "546/TALK"  , "narrator": "つばめ", "text": "…露骨過ぎて、\nタイトルだけで\nわかっちゃうよ…。"},
        { "location": "548/TALK"  , "narrator": "神楽", "text": "…くすくす。"},
        { "location": "550/TALK"  , "narrator": "つばめ", "text": "じゃ、じゃあ、\nこっちは…。"},
        { "location": "553/TALK"  , "narrator": "神楽", "text": "つーばーめーさんっ！"},
        { "location": "556/TALK"  , "narrator": "つばめ", "text": "ひゃぁぁぁっ！！\nう、卯月さん！？"},
        { "location": "557/TALK"  , "narrator": "神楽", "text": "ふふっ、一人にされて\n戸惑ってるつばめさん、\n可愛かったですよ。"},
        { "location": "559/TALK"  , "narrator": "つばめ", "text": "もしかして、わたしに\n見せたい本がある、って\nいうのは…。"},
        { "location": "560/TALK"  , "narrator": "神楽", "text": "もちろん、つばめさんの\n可愛い姿を見るための\n冗談です。"},
        { "location": "561/TALK"  , "narrator": "つばめ", "text": "それなら、\nもう少し早く戻ってきて\nほしかったよ…。"},
        { "location": "562/TALK"  , "narrator": "神楽", "text": "ごめんなさい。\nでも、なんだか真剣に\n本を見てましたよね？"},
        { "location": "563/TALK"  , "narrator": "神楽", "text": "だから邪魔をしたら\nいけないと思って、\n少し待ってたんです。"},
        { "location": "566/TALK"  , "narrator": "つばめ", "text": "みみみ、見てないよ！\nわたし、ちょっとしか\n見てないから…。"},
        { "location": "567/TALK"  , "narrator": "神楽", "text": "ちょっとは\n見てくれたんですね！"},
        { "location": "568/TALK"  , "narrator": "神楽", "text": "つばめさんが、薄い本の\n沼に興味を持ってくれて\n嬉しいですっ！"},
        { "location": "572/TALK"  , "narrator": "つばめ", "text": "ご、誤解だよぉ！"},
        { "location": "573/TALK"  , "narrator": "つばめ", "text": "興味があったわけ\nじゃなくて、\nえっと――"},
        { "location": "575/TALK"  , "narrator": "つばめ", "text": "あ、絵だよ、絵！\n絵が可愛いなぁ、って\n思っただけだから…。"},
        { "location": "577/TALK"  , "narrator": "神楽", "text": "もぅ、そんなに\n恥ずかしがらなくても\nいいんですよ？"},
        { "location": "578/TALK"  , "narrator": "つばめ", "text": "本当なのにぃ…。"},
        { "location": "579/TALK"  , "narrator": "つばめ", "text": "…そうだ、じゃあ――"},
        { "location": "591/TALK"  , "narrator": "つばめ", "text": "$handle$さーん"},
        { "location": "592/TALK"  , "narrator": "つばめ", "text": "卯月さんが"},
        { "location": "594/TALK"  , "narrator": "つばめ", "text": "信じてくれなぃの(´つω・｀)ｼｭﾝ"},
        { "location": "595/TALK"  , "narrator": "つばめ", "text": "$handle$さんなら"},
        { "location": "596/TALK"  , "narrator": "つばめ", "text": "わかるよね？(*´ω｀*)"},
        { "location": "597/TALK"  , "narrator": "つばめ", "text": "わたしが"},
        { "location": "598/TALK"  , "narrator": "つばめ", "text": "こぅぃぅのに"},
        { "location": "599/TALK"  , "narrator": "つばめ", "text": "興味ぁったわけじゃなぃって(/ω＼)"},
        { "location": "601/SEL"   , "narrator": "", "text": "信じるよ"},
        { "location": "602/SEL"   , "narrator": "", "text": "興味あるんでしょ？"},
        { "location": "603/SEL"   , "narrator": "", "text": "つばめはムッツリだなぁ"},
        { "location": "604/ACT"   , "narrator": "", "text": "信じるよ"},
        { "location": "605/TALK"  , "narrator": "つばめ", "text": "ぁりがとぅ(●´ω｀●)"},
        { "location": "606/TALK"  , "narrator": "つばめ", "text": "わたしも"},
        { "location": "607/TALK"  , "narrator": "つばめ", "text": "$handle$さんなら"},
        { "location": "608/TALK"  , "narrator": "つばめ", "text": "わかってくれるって"},
        { "location": "609/TALK"  , "narrator": "つばめ", "text": "信じてたよ(●´ω｀●)ゞｴﾍﾍ"},
        { "location": "622/TALK"  , "narrator": "つばめ", "text": "ほら、見たでしょ？\n$handle$も\n信じてくれるって。"},
        { "location": "623/TALK"  , "narrator": "つばめ", "text": "だから、卯月さんにも\n信じてもらいたいな。"},
        { "location": "625/TALK"  , "narrator": "神楽", "text": "つばめさん…、\nこんなの信じたら\nダメですよ。"},
        { "location": "626/TALK"  , "narrator": "神楽", "text": "つばめさんの味方を\nして、好感度を上げ\nたいだけですから。"},
        { "location": "628/TALK"  , "narrator": "つばめ", "text": "えぇっ！？\nそんなことないと\n思うけど…。"},
        { "location": "630/TALK"  , "narrator": "神楽", "text": "あるんです。"},
        { "location": "631/TALK"  , "narrator": "神楽", "text": "つばめさんは\n初心だから\nわからないんです。"},
        { "location": "632/TALK"  , "narrator": "つばめ", "text": "そ、そうなのかなぁ？"},
        { "location": "634/TALK"  , "narrator": "神楽", "text": "そうですよ。\nだからそういうことを\n勉強するために――"},
        { "location": "635/TALK"  , "narrator": "神楽", "text": "急いで次のお店に\n行きましょう。"},
        { "location": "637/TALK"  , "narrator": "つばめ", "text": "あ、う、卯月さん。\n引っ張らないで―！"},
        { "location": "638/ACT"   , "narrator": "", "text": "興味あるんでしょ？"},
        { "location": "639/TALK"  , "narrator": "つばめ", "text": "なぃよ(ﾟ△ﾟ;ﾉ)ﾉ"},
        { "location": "640/TALK"  , "narrator": "つばめ", "text": "本当"},
        { "location": "641/TALK"  , "narrator": "つばめ", "text": "興味ぁって"},
        { "location": "642/TALK"  , "narrator": "つばめ", "text": "見てたわけじゃなぃのに"},
        { "location": "643/TALK"  , "narrator": "つばめ", "text": "(´つω・｀)ｼｭﾝ"},
        { "location": "655/TALK"  , "narrator": "つばめ", "text": "はぁ…。"},
        { "location": "657/TALK"  , "narrator": "神楽", "text": "疑われてましたね？"},
        { "location": "659/TALK"  , "narrator": "つばめ", "text": "で、でも、本当に\n誤解だからね！？"},
        { "location": "660/TALK"  , "narrator": "つばめ", "text": "$handle$も、\nきっと冗談で\n言ったんだと思うし。"},
        { "location": "661/TALK"  , "narrator": "神楽", "text": "まあまあ、\n落ち着いてください。"},
        { "location": "662/TALK"  , "narrator": "神楽", "text": "私は信じますから。"},
        { "location": "663/TALK"  , "narrator": "つばめ", "text": "…本当？"},
        { "location": "665/TALK"  , "narrator": "神楽", "text": "もちろんです。\nだってつばめさん――"},
        { "location": "666/TALK"  , "narrator": "神楽", "text": "今も、本を手に持った\nままですし…。"},
        { "location": "669/TALK"  , "narrator": "つばめ", "text": "え？　あっ！"},
        { "location": "671/TALK"  , "narrator": "神楽", "text": "ふふっ…どうです？\n薄い本の魅力が\nわかってきましたか？"},
        { "location": "673/TALK"  , "narrator": "つばめ", "text": "もーっ！！"},
        { "location": "674/TALK"  , "narrator": "つばめ", "text": "こんなエッチな本\nばっかりなお店は\n来ちゃだめだよ！"},
        { "location": "675/ACT"   , "narrator": "", "text": "つばめはムッツリだなぁ"},
        { "location": "676/TALK"  , "narrator": "つばめ", "text": "ムッツリ？"},
        { "location": "677/TALK"  , "narrator": "つばめ", "text": "ムッツリって何？(*´﹃｀*)"},
        { "location": "679/SEL"   , "narrator": "", "text": "神楽に聞いた方がいいかも"},
        { "location": "680/ACT"   , "narrator": "", "text": "神楽に聞いた方がいいかも"},
        { "location": "682/TALK"  , "narrator": "つばめ", "text": "卯月さんに？(･Д･｀)"},
        { "location": "683/TALK"  , "narrator": "つばめ", "text": "よくわからなぃけど"},
        { "location": "684/TALK"  , "narrator": "つばめ", "text": "聞ぃてみるね(´∀｀*)"},
        { "location": "688/TALK"  , "narrator": "つばめ", "text": "…ねえ、卯月さん。\nこんなこと言われたん\nだけど。"},
        { "location": "690/TALK"  , "narrator": "神楽", "text": "えっと…。"},
        { "location": "691/TALK"  , "narrator": "神楽", "text": "ぶふっ！！"},
        { "location": "692/TALK"  , "narrator": "つばめ", "text": "卯月さん？"},
        { "location": "696/TALK"  , "narrator": "神楽", "text": "ふ、ふふっ…さあ？\nわ、私には、その…、\n何が何だか…クスッ。"},
        { "location": "697/TALK"  , "narrator": "つばめ", "text": "本当かなぁ？\n何だか、知ってるのに\n隠されてるような…。"},
        { "location": "699/TALK"  , "narrator": "神楽", "text": "ほ、本当ですよ。\n私を信じてください！"},
        { "location": "702/TALK"  , "narrator": "神楽", "text": "でも、もし本当に\nムッツリだと\nしても――"},
        { "location": "703/TALK"  , "narrator": "神楽", "text": "つばめさんは、\n変わらず可愛い\n女の子です。"},
        { "location": "705/TALK"  , "narrator": "神楽", "text": "だから、ムッツリでも\n何も問題なですよ！"},
        { "location": "707/TALK"  , "narrator": "つばめ", "text": "えっと、問題とか\nそういうこと言ってる\nわけじゃなくて…。"},
        { "location": "709/TALK"  , "narrator": "つばめ", "text": "っていうか、\n絶対ムッツリの意味\n知ってるよね？"},
        { "location": "712/TALK"  , "narrator": "神楽", "text": "…いいえー、\n知りませんよー。"},
        { "location": "714/TALK"  , "narrator": "つばめ", "text": "…きっと、いい意味の\n言葉じゃないんだろう\nなぁ…。"},
        { "location": "726/DIALOG", "narrator": "Dialog_chapter_ch01", "text": "【12 ピクシャル】"}
    ]
}
