{
    "dir": "chap05/daydra/dd_ch02_05_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "5253",
        "cid": "ayami",
        "title": "Extra003 プレミアムストーリー",
        "sub_title": "公園の思い出"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "公園の思い出"},
        { "location": "22/TALK"   , "narrator": "つばめ", "text": "今日は手続き手伝って\nくれて、ありがとう\nございました。"},
        { "location": "24/TALK"   , "narrator": "アーヤ", "text": "色々しないといけない\nことが多いから、\n面倒だったでしょ？"},
        { "location": "25/TALK"   , "narrator": "つばめ", "text": "はい…わたしだけじゃ\n今日だけで終わらな\nかったと思います…。"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "でも、明日からかぁ…\nちょっと不安です…。"},
        { "location": "28/TALK"   , "narrator": "アーヤ", "text": "ごめんなさい。\nいくらなんでも、\n突然過ぎだものね…。"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "そんな、謝らないで\nください。\nそれに――"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "トライナリーの方も、\nちゃんとやって\nいけるかどうか…。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "大丈夫。さっき教えた\n通りにコネクト\nできれば心配ないわ。"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "でも、本番でも\n落ち着いてできるか\nちょっと不安です。"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "あ、けど！\n失敗しないように\n頑張りますから！"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "ええ、期待してる。\nでも、あまり\n気負わないでね？"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "はい！"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "…あれ？"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "ん、どうしたの？"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "ここの公園、遊具が\n少なくないですか？"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "ああ、\nつばめもそう思う？"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "何でも、子供がケガを\nする危険があるから、\nって理由で――"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "色々撤去された結果、\nブランコと砂場しか\n残らなかったらしいの。"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "少なくとも、私が東京に\n出てきた時には――"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "ジャングルジムと\nシーソーが残ってたわ。"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "そうだったんですか…。"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "…もしかして、\n遊びたかった？"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "えへへ…ちょっとだけ\nそう思ってました。"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "つばめはどれが\n一番好きなの？"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "う、う～ん…。"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "遊具の名前って、\n実はよく知らないん\nですよね…。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "それ、わかるわ。\nみんな独自の愛称で\n呼ぶことが多いし。"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "うんていのことを\n空中桟橋、って呼ぶ子とか\nいたわ。"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "あはは、オシャレで\n良いですね。"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "アーヤさんは、\n子供の頃はどんな遊具で\n遊んでたんですか？"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "う～ん…そうね…。"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "公園には結構思い出が\nあるから、どれか一つを\n選ぶのは悩むかも…。"},
        { "location": "67/SEL"    , "narrator": "", "text": "箱型ブランコは？"},
        { "location": "68/SEL"    , "narrator": "", "text": "ジャングルジムは？"},
        { "location": "69/SEL"    , "narrator": "", "text": "のぼり棒は？"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "………………。"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "……。"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "そんなによく\n遊んでたんですか？"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "近所に、ちょっとだけ\n大きい公園があってね。"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "約束とかしなくても\n行けば誰かしらいて、\n沢山遊んだわ。"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "そういえば、ジャングル\nジムは好きだったわ。"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "色んな遊具があったけど、\n一日一回は絶対に遊ぶ\nくらいに好きだったの。"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "ジャングルジムって、\nどういう風に遊ぶん\nですか？"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "誰が一番最初に\nてっぺんまで登れるかを\n競ったり――"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "ジャングルジムの上で\n鬼ごっこしたりとか､\nかしら？"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "そ、そんなことしてたん\nですか！？"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "え？　ジャングルジムって\nそうやって遊ぶものじゃ\nないの？"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "…アーヤさんって、\n意外とおてんばさん\nだったのかな？"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "楽しかったなぁ…。\n大人になった今じゃ、\nもう遊べないけど――"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "子供に戻れるなら、\nまたジャングルジムで\n鬼ごっこをしたいわ。"},
        { "location": "94/ACT"    , "narrator": "", "text": "箱型ブランコは？"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "あ、それがあったわ"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "思い出話にはいいかも"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "…箱型ブランコ、って\nわかるかしら？"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "えっと…観覧車の座席\nみたいになってるやつ\nですか？"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "そう、それそれ。"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "地元にね、箱型ブランコの\n噂話があったの。"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "好きな人同士が乗って、\n十分間乗り続けられると\n恋が実る、って噂が。"},
        { "location": "132/TALK"  , "narrator": "つばめ", "text": "わぁ、何だか可愛いです！"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "ふふっ、そうね。"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "私の友達も、何人かは\nそれを実行した人が\nいるんだけど――"},
        { "location": "136/TALK"  , "narrator": "アーヤ", "text": "なんと、そのうちの一組は\nこの前婚約したの。"},
        { "location": "138/TALK"  , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "噂もバカにはできない、\nってことなのかしらね？"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "…素敵ですね。"},
        { "location": "141/TALK"  , "narrator": "つばめ", "text": "そういえば、アーヤさんも\n誰かと乗ったりしたん\nですか？"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "えっ！？\nえっと、どうだった\nかしら…？"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "忘れちゃったわ。"},
        { "location": "144/TALK"  , "narrator": "つばめ", "text": "アーヤさん、\n顔が赤くなってますよ？"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "な、なってないから！\n多分、夕日のせいよ。"},
        { "location": "164/ACT"   , "narrator": "", "text": "ジャングルジムは？"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "そういえば、一番好きな遊具だったわ"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "思い出させてくれてありがと"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "私、遊具の中では\nジャングルジムが\n一番好きだったの。"},
        { "location": "204/TALK"  , "narrator": "アーヤ", "text": "一日一回は絶対に\n遊んでたくらいだし。"},
        { "location": "206/TALK"  , "narrator": "つばめ", "text": "ジャングルジムって、\nどういう風に遊ぶん\nですか？"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "誰が一番最初に\nてっぺんまで登れるかを\n競ったり――"},
        { "location": "208/TALK"  , "narrator": "アーヤ", "text": "ジャングルジムの上で\n鬼ごっこしたりとか\nかしら？"},
        { "location": "210/TALK"  , "narrator": "つばめ", "text": "そ、そんなことしてたん\nですか！？"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "え？　ジャングルジムって\nそうやって遊ぶものじゃ\nないの？"},
        { "location": "213/TALK"  , "narrator": "つばめ", "text": "…アーヤさんって、\n意外とおてんばさん\nだったのかな？"},
        { "location": "214/ACT"   , "narrator": "", "text": "のぼり棒は？"},
        { "location": "239/TALK"  , "narrator": "アーヤ", "text": "う～ん…"},
        { "location": "240/TALK"  , "narrator": "アーヤ", "text": "まあ、今なら笑い話だし、いいかな"},
        { "location": "252/TALK"  , "narrator": "アーヤ", "text": "…遊んでたっていうか、\nよく挑戦したのが\nのぼり棒だったわ。"},
        { "location": "253/TALK"  , "narrator": "つばめ", "text": "のぼり棒、ですか？"},
        { "location": "256/TALK"  , "narrator": "アーヤ", "text": "ええ…私、あれだけは\n一度ものぼれたことが\nないの…。"},
        { "location": "257/TALK"  , "narrator": "つばめ", "text": "えっ、そうだったん\nですか！？"},
        { "location": "260/TALK"  , "narrator": "アーヤ", "text": "うん…友達はみんな\nひょいひょいのぼって\nいくのに――"},
        { "location": "262/TALK"  , "narrator": "アーヤ", "text": "私は棒にしがみついて、\nズルズル地面に落ちる\nだけでね…。"},
        { "location": "263/TALK"  , "narrator": "アーヤ", "text": "悔しくて沢山練習した\nけど、結局一度も\nのぼれず仕舞いだったわ。"},
        { "location": "264/TALK"  , "narrator": "つばめ", "text": "…必死にのぼろうと\nしてるのに、ズルズル\n落ちるアーヤさん…。"},
        { "location": "266/TALK"  , "narrator": "つばめ", "text": "…ぷっ。"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "あっ、今笑った？"},
        { "location": "268/TALK"  , "narrator": "つばめ", "text": "ご、ごめんなさい。"},
        { "location": "269/TALK"  , "narrator": "つばめ", "text": "でも、想像したら\nなんか可愛くて…。"},
        { "location": "271/TALK"  , "narrator": "アーヤ", "text": "…それで？\nつばめにはどんな\n思い出があるの？"},
        { "location": "273/TALK"  , "narrator": "つばめ", "text": "わたしは、その…。"},
        { "location": "274/TALK"  , "narrator": "つばめ", "text": "…実は、あんまり公園で\n遊んだ記憶、ないんです。"},
        { "location": "275/TALK"  , "narrator": "アーヤ", "text": "外で遊ぶのが\n嫌いだった、とか？"},
        { "location": "276/TALK"  , "narrator": "つばめ", "text": "いえ、そうじゃないん\nですけど――"},
        { "location": "277/TALK"  , "narrator": "つばめ", "text": "お父さんが、あまり外で\n遊ぶのを許してくれ\nなかったんです。"},
        { "location": "279/TALK"  , "narrator": "アーヤ", "text": "…そうだったんだ。"},
        { "location": "281/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "284/TALK"  , "narrator": "アーヤ", "text": "ブランコ競争、って\n遊びがあるの。"},
        { "location": "285/TALK"  , "narrator": "つばめ", "text": "ブランコ競争、ですか？"},
        { "location": "286/TALK"  , "narrator": "アーヤ", "text": "うん、誰が一番高くまで、\nブランコで上がれるかを\n競う遊びなんだけど――"},
        { "location": "287/TALK"  , "narrator": "アーヤ", "text": "今から、やってみない？"},
        { "location": "288/TALK"  , "narrator": "つばめ", "text": "えっ、今からですか！？"},
        { "location": "289/TALK"  , "narrator": "アーヤ", "text": "ブランコは撤去されて\nいないし――"},
        { "location": "290/TALK"  , "narrator": "アーヤ", "text": "私達以外誰もいないから、\nやるならチャンスよ。"},
        { "location": "291/TALK"  , "narrator": "つばめ", "text": "そ、そうですけど…。\nでも、高校生にもなって\nブランコは…。"},
        { "location": "292/TALK"  , "narrator": "アーヤ", "text": "だからこそ、やるのよ。"},
        { "location": "293/TALK"  , "narrator": "アーヤ", "text": "だって、絶対に笑える\n思い出になるでしょ？"},
        { "location": "294/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "295/TALK"  , "narrator": "つばめ", "text": "…ふふっ、そうですね。"},
        { "location": "296/TALK"  , "narrator": "アーヤ", "text": "よし、決まりね！\n久しぶりにおもいっきり\nこぐわよ！"},
        { "location": "297/TALK"  , "narrator": "つばめ", "text": "わ、わたしも、\n初めてだけど負けません。"},
        { "location": "298/TALK"  , "narrator": "アーヤ", "text": "じゃあ、負けた方が\nジュース一本ね。"},
        { "location": "299/TALK"  , "narrator": "つばめ", "text": "望むところです。\nよーし、頑張るぞー！"},
        { "location": "301/TALK"  , "narrator": "アーヤ", "text": "ふふっ…。"},
        { "location": "302/TALK"  , "narrator": "アーヤ", "text": "こうやって、童心に返る\nのも悪くないわね。"},
        { "location": "19/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月5日　6:30 PM</color>\nドーム戦の2日後、神楽坂付近の路上にて。"},
        { "location": "158/DIALOG", "narrator": "Dialog_GEThimegoto_ch02", "text": "【もしかして：初恋】"},
        { "location": "170/DIALOG", "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "220/DIALOG", "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
