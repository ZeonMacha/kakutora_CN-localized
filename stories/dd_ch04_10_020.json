{
    "dir": "chap10/daydra/dd_ch04_10_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "10456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "洋菓子初心者"
    },
    "entry":
    [
        { "location": "233/SCENARIO", "narrator": "", "text": "洋菓子初心者"},
        { "location": "246/TALK"    , "narrator": "神楽", "text": "――っていうことが\nあったんですよ。"},
        { "location": "248/TALK"    , "narrator": "つばめ", "text": "えっ、それ本当！？"},
        { "location": "249/TALK"    , "narrator": "神楽", "text": "はい。そうだ、今度は\nつばめさんも一緒に\n行ってみませんか？"},
        { "location": "251/TALK"    , "narrator": "つばめ", "text": "わぁ、楽しそう！\n絶対行くよ。"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "信じられん。"},
        { "location": "255/TALK"    , "narrator": "つばめ", "text": "はい？"},
        { "location": "257/TALK"    , "narrator": "神楽", "text": "ウソなんかついて\nませんよ。"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "そうやなくて、\n放課後にこんな洒落た\nカフェで――"},
        { "location": "261/TALK"    , "narrator": "みやび", "text": "うちがガールズトークに\n花咲かせちゅうことがや。"},
        { "location": "262/TALK"    , "narrator": "神楽", "text": "みやびさんは\nトークしてないじゃ\nないですか。"},
        { "location": "263/TALK"    , "narrator": "つばめ", "text": "さっきからずっと\nパフェを食べてます。"},
        { "location": "265/TALK"    , "narrator": "みやび", "text": "そうやったか？"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "まあ、ここのパフェが\n美味いのが悪い。"},
        { "location": "269/TALK"    , "narrator": "みやび", "text": "ほれ、卯月。\nあーん…。"},
        { "location": "270/TALK"    , "narrator": "神楽", "text": "あーん…"},
        { "location": "271/TALK"    , "narrator": "神楽", "text": "んんっ！\n甘いです！"},
        { "location": "273/TALK"    , "narrator": "みやび", "text": "つばめちゃんも、\nあーんしいや。"},
        { "location": "274/TALK"    , "narrator": "つばめ", "text": "あ、あーん…\n"},
        { "location": "275/TALK"    , "narrator": "つばめ", "text": "んっ、美味しい！！"},
        { "location": "277/TALK"    , "narrator": "つばめ", "text": "卯月さん、わたし達も\nパフェ頼もう。"},
        { "location": "279/TALK"    , "narrator": "神楽", "text": "賛成です。"},
        { "location": "281/TALK"    , "narrator": "神楽", "text": "あ、すみません。\n追加の注文で――"},
        { "location": "284/TALK"    , "narrator": "みやび", "text": "あむっ…んっ、んん…\nえいねえいね、ここの\nパフェは最高ちや。"},
        { "location": "285/TALK"    , "narrator": "みやび", "text": "シリアルが入っとらんき、\n誤魔化された気にならん\n完璧なパフェや。"},
        { "location": "287/TALK"    , "narrator": "つばめ", "text": "でも、みやびさんだったら\nこういう洋菓子も、自分で\n作れちゃうんじゃ…。"},
        { "location": "290/TALK"    , "narrator": "みやび", "text": "うち、洋菓子は\n作ったことないき、\nあんまし自信ないがよ。"},
        { "location": "292/TALK"    , "narrator": "神楽", "text": "みやびさんでも\n作ったことのない\n料理ってあるんですか？"},
        { "location": "294/TALK"    , "narrator": "みやび", "text": "うちは基本、和食しか\n作らんきね。"},
        { "location": "295/TALK"    , "narrator": "つばめ", "text": "そうだったんですか…。"},
        { "location": "298/TALK"    , "narrator": "みやび", "text": "それに、洋菓子はうちの\n好物の一つやき。"},
        { "location": "299/TALK"    , "narrator": "みやび", "text": "自分で作った物より、\nプロが作った物を\n食べたいんよ。"},
        { "location": "300/SEL"     , "narrator": "", "text": "練習くらいはしておけば？"},
        { "location": "301/SEL"     , "narrator": "", "text": "その気持ちわかるかも"},
        { "location": "303/TALK"    , "narrator": "神楽", "text": "みやびさんだって\nプロ級の腕を持ってる\nじゃないですか。"},
        { "location": "305/TALK"    , "narrator": "みやび", "text": "和食は作り慣れちょるき、\nあんだけできるがよ。"},
        { "location": "310/TALK"    , "narrator": "みやび", "text": "けんど、ケーキは美味しく\n作れるかわからんちや。"},
        { "location": "311/TALK"    , "narrator": "みやび", "text": "失敗して、ガッカリな\n結果になるんも嫌ながよ。"},
        { "location": "313/TALK"    , "narrator": "つばめ", "text": "そうですか…。"},
        { "location": "315/TALK"    , "narrator": "つばめ", "text": "みやびさんの作った\nケーキ、食べてみた\nかったなぁ…。"},
        { "location": "317/ACT"     , "narrator": "", "text": "練習くらいはしておけば？"},
        { "location": "332/TALK"    , "narrator": "みやび", "text": "相棒はそう思うがか？"},
        { "location": "333/TALK"    , "narrator": "みやび", "text": "ん～…まあ、作れるようになっておくんは、悪くない考えやけんど"},
        { "location": "340/TALK"    , "narrator": "みやび", "text": "…自分で作る練習は、\nやっぱし不安があるなぁ。"},
        { "location": "342/TALK"    , "narrator": "神楽", "text": "そんなに自信ないん\nですか？"},
        { "location": "345/TALK"    , "narrator": "みやび", "text": "いや、レシピ見ながら\nやるき――"},
        { "location": "346/TALK"    , "narrator": "みやび", "text": "失敗せん限りは、\n不味いもんはできんと\n思うがよ。"},
        { "location": "348/TALK"    , "narrator": "みやび", "text": "けんど、予想より美味く\n出来た時のことを思うと\n不安ちや。"},
        { "location": "350/TALK"    , "narrator": "つばめ", "text": "…どうしてですか？"},
        { "location": "352/TALK"    , "narrator": "みやび", "text": "作り過ぎて、太ってしまう\n可能性があるがよ。"},
        { "location": "355/TALK"    , "narrator": "神楽", "text": "…凄くありそうですね。"},
        { "location": "356/TALK"    , "narrator": "つばめ", "text": "みやびさん、絶対に\n美味しいケーキ作るもん。"},
        { "location": "358/TALK"    , "narrator": "みやび", "text": "うち、あんまし運動とか\nせんき、そんなことしたら\n間違いなく太るきね。"},
        { "location": "359/TALK"    , "narrator": "みやび", "text": "そういうこともあって、\n洋菓子は自分で作らん\nようにしてるちや。"},
        { "location": "361/TALK"    , "narrator": "つばめ", "text": "…わたしも、ケーキは\n作らないようにしよう。"},
        { "location": "363/TALK"    , "narrator": "つばめ", "text": "美味しいのができたら、\nみやびさんが言った\nみたいになりそうだし…。"},
        { "location": "366/TALK"    , "narrator": "神楽", "text": "そうですね。\n私も同じです。"},
        { "location": "384/ACT"     , "narrator": "", "text": "その気持ちわかるかも"},
        { "location": "398/TALK"    , "narrator": "みやび", "text": "さすがは相棒、わかっちゅうね"},
        { "location": "399/TALK"    , "narrator": "みやび", "text": "じゃあ、うちの代わりに、うちが食べるケーキ作ってくれるか？"},
        { "location": "401/SEL"     , "narrator": "", "text": "え！？"},
        { "location": "402/ACT"     , "narrator": "", "text": "え！？"},
        { "location": "404/TALK"    , "narrator": "みやび", "text": "冗談やき、驚かせてすまん"},
        { "location": "412/TALK"    , "narrator": "ウェイトレス", "text": "お待たせいたしました。\nフルーツパフェ\n二点になります。"},
        { "location": "414/TALK"    , "narrator": "神楽", "text": "あ、どうも。"},
        { "location": "415/TALK"    , "narrator": "ウェイトレス", "text": "ごゆっくりどうぞ。"},
        { "location": "421/TALK"    , "narrator": "つばめ", "text": "わぁ、来た来た！"},
        { "location": "423/TALK"    , "narrator": "神楽", "text": "ふふっ…まあ、近所に\nこういう美味しい\nお店があれば――"},
        { "location": "424/TALK"    , "narrator": "神楽", "text": "自分で作らなくても\n困らないですしね。"},
        { "location": "426/TALK"    , "narrator": "つばめ", "text": "だね。"},
        { "location": "428/TALK"    , "narrator": "つばめ", "text": "はい、みやびさん。\nあーん。"},
        { "location": "430/TALK"    , "narrator": "みやび", "text": "は？"},
        { "location": "432/TALK"    , "narrator": "神楽", "text": "さっき一口くれた\nお礼です。\nあーん…。"},
        { "location": "436/TALK"    , "narrator": "みやび", "text": "…いや、うちはえいき。\n気持ちだけもらうちや。"},
        { "location": "437/TALK"    , "narrator": "つばめ", "text": "でも、貰ったらお返し\nしないと…ね？"},
        { "location": "438/TALK"    , "narrator": "神楽", "text": "そうですよ。\n早く食べてくれないと、\nパフェが溶けちゃいます。"},
        { "location": "439/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "442/TALK"    , "narrator": "みやび", "text": "あーん…んむっ…。"},
        { "location": "444/TALK"    , "narrator": "神楽", "text": "さ、次はこっちです。"},
        { "location": "446/TALK"    , "narrator": "みやび", "text": "…あーん…あむっ…。"},
        { "location": "449/TALK"    , "narrator": "みやび", "text": "…こういうの、するんは\nえいけんど、されるんは\n苦手やのに…。"},
        { "location": "451/TALK"    , "narrator": "つばめ", "text": "どうですか、みやびさん。\n美味しいですか？"},
        { "location": "453/TALK"    , "narrator": "みやび", "text": "…うん、最高やね。"},
        { "location": "245/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>6月11日　1:38 PM</color>\nとある休日の午後、カフェにて。"},
        { "location": "378/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch04", "text": "【ためいきのシュガー】"}
    ]
}
