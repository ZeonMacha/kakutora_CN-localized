{
    "dir": "chap17/daydra/dd_ch03_17_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "17305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "マナーか娯楽か＜後編＞"
    },
    "entry":
    [
        { "location": "307/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "311/TALK"  , "narrator": "ガブリエラ", "text": "ううん…やっぱり、\n繭の言う通りなの\nかも…。"},
        { "location": "324/TALK"  , "narrator": "ガブリエラ", "text": "聞いてほしいの"},
        { "location": "325/TALK"  , "narrator": "ガブリエラ", "text": "私ね"},
        { "location": "326/TALK"  , "narrator": "ガブリエラ", "text": "あの時ちゃんと対応しなかったことを"},
        { "location": "327/TALK"  , "narrator": "ガブリエラ", "text": "本当に後悔しているの"},
        { "location": "328/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "329/TALK"  , "narrator": "ガブリエラ", "text": "発症者が出るなんて"},
        { "location": "330/TALK"  , "narrator": "ガブリエラ", "text": "わかりっこなかったんだし"},
        { "location": "331/TALK"  , "narrator": "ガブリエラ", "text": "私が必要以上に気にするのって"},
        { "location": "332/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり変だと思う？"},
        { "location": "334/SEL"   , "narrator": "", "text": "ゲームで発症する方がおかしい"},
        { "location": "335/SEL"   , "narrator": "", "text": "気にすることじゃない"},
        { "location": "336/SEL"   , "narrator": "", "text": "それを予測してこそトライナリー"},
        { "location": "337/ACT"   , "narrator": "", "text": "ゲームで発症する方がおかしい"},
        { "location": "338/TALK"  , "narrator": "ガブリエラ", "text": "どうなのかしらね？"},
        { "location": "339/TALK"  , "narrator": "ガブリエラ", "text": "最近はね"},
        { "location": "340/TALK"  , "narrator": "ガブリエラ", "text": "アプリゲームに一千万とか課金する人もいるらしいの"},
        { "location": "341/TALK"  , "narrator": "ガブリエラ", "text": "それにね"},
        { "location": "342/TALK"  , "narrator": "ガブリエラ", "text": "十万円とか課金しても"},
        { "location": "343/TALK"  , "narrator": "ガブリエラ", "text": "レアキャラが出ないの当然だから"},
        { "location": "344/TALK"  , "narrator": "ガブリエラ", "text": "変ではないわよ"},
        { "location": "347/TALK"  , "narrator": "ガブリエラ", "text": "っていうか"},
        { "location": "348/TALK"  , "narrator": "ガブリエラ", "text": "それ考えたら発症者に同情しちゃうわ"},
        { "location": "349/ACT"   , "narrator": "", "text": "気にすることじゃない"},
        { "location": "350/TALK"  , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "351/TALK"  , "narrator": "ガブリエラ", "text": "何が発症の原因になるかなんて"},
        { "location": "352/TALK"  , "narrator": "ガブリエラ", "text": "誰にもわからないんだし"},
        { "location": "353/TALK"  , "narrator": "ガブリエラ", "text": "対処のしようがないのよね"},
        { "location": "354/TALK"  , "narrator": "ガブリエラ", "text": "発症は防げないし"},
        { "location": "355/TALK"  , "narrator": "ガブリエラ", "text": "予測もできない"},
        { "location": "356/TALK"  , "narrator": "ガブリエラ", "text": "だからこそ私たちがいるのよね？"},
        { "location": "357/ACT"   , "narrator": "", "text": "それを予測してこそトライナリー"},
        { "location": "358/TALK"  , "narrator": "ガブリエラ", "text": "それができれば苦労しないわ"},
        { "location": "359/TALK"  , "narrator": "ガブリエラ", "text": "発症者が出るのが予測できたとしたら"},
        { "location": "360/TALK"  , "narrator": "ガブリエラ", "text": "私達トライナリーはいらないわよ"},
        { "location": "361/TALK"  , "narrator": "ガブリエラ", "text": "預言者集団じゃないんだし"},
        { "location": "364/TALK"  , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "365/TALK"  , "narrator": "ガブリエラ", "text": "預言者じゃないんだから"},
        { "location": "366/TALK"  , "narrator": "ガブリエラ", "text": "止められるはずがなかったのよ"},
        { "location": "368/TALK"  , "narrator": "ガブリエラ", "text": "少し後悔は残るけれど"},
        { "location": "369/TALK"  , "narrator": "ガブリエラ", "text": "もうこのこと"},
        { "location": "370/TALK"  , "narrator": "ガブリエラ", "text": "気にするのやめにするわ"},
        { "location": "371/TALK"  , "narrator": "ガブリエラ", "text": "勝手に言いたいことばかり言ってしまったわね"},
        { "location": "372/TALK"  , "narrator": "ガブリエラ", "text": "でもスッキリしたわ"},
        { "location": "386/TALK"  , "narrator": "ガブリエラ", "text": "…そういえば、\nあれからカプドラは\nどうなったの？"},
        { "location": "388/TALK"  , "narrator": "雛", "text": "ガブリエラちゃん、\n知らないの？"},
        { "location": "390/TALK"  , "narrator": "雛", "text": "あの炎上のあと、\nすぐにパッチで\nバグが修正されたの。"},
        { "location": "391/TALK"  , "narrator": "雛", "text": "今はもう次のイベント\n始まってるよー。"},
        { "location": "395/TALK"  , "narrator": "ガブリエラ", "text": "は！？　何それ！"},
        { "location": "396/TALK"  , "narrator": "ガブリエラ", "text": "発症者出した原因\n作っときながら、\n普通に続いてるの！？"},
        { "location": "397/TALK"  , "narrator": "繭", "text": "発症の原因は、\n一般には公開されて\nないからね。"},
        { "location": "398/TALK"  , "narrator": "繭", "text": "多分、公式は\n気づいてすらいないと\n思う。"},
        { "location": "400/TALK"  , "narrator": "ガブリエラ", "text": "…それはそれで、\nなんかモヤッとした\n気持ちになるわね。"},
        { "location": "401/TALK"  , "narrator": "繭", "text": "なんにせよ、\nもう済んだこと。\n気にするだけ無駄。"},
        { "location": "403/TALK"  , "narrator": "雛", "text": "そういうことだよ。\nというわけでー。"},
        { "location": "404/TALK"  , "narrator": "雛", "text": "平和になったカプドラ\nやって、嫌な気持ちを\n吹き飛ばしちゃおー！"},
        { "location": "406/TALK"  , "narrator": "ガブリエラ", "text": "この流れで\nカプドラ！？"},
        { "location": "407/TALK"  , "narrator": "繭", "text": "炎上した後だけに、\n今は超安全。"},
        { "location": "408/TALK"  , "narrator": "雛", "text": "今回こそ、イベント\n攻略目指そ。"},
        { "location": "409/TALK"  , "narrator": "ガブリエラ", "text": "…仕方ないわね。"},
        { "location": "411/TALK"  , "narrator": "ガブリエラ", "text": "疲れてるから、\n１プレイだけよ？"},
        { "location": "412/TALK"  , "narrator": "雛", "text": "やった！\nじゃあ、とりあえず\nイベントクエの――"},
        { "location": "423/DIALOG", "narrator": "Dialog_chapter_ch03", "text": "【14 神楽学校やめるってよ】"}
    ]
}
