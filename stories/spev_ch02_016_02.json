    "entry":
    [
        { "location": "178/SCENARIO", "narrator": "", "text": "チュアブル錠"},
        { "location": "180/TALK"    , "narrator": "アーヤ", "text": "ありがと"},
        { "location": "181/TALK"    , "narrator": "アーヤ", "text": "でもだいじょうぶ！"},
        { "location": "182/TALK"    , "narrator": "アーヤ", "text": "実はあやみには最終手段"},
        { "location": "183/TALK"    , "narrator": "アーヤ", "text": "オレンジ味の"},
        { "location": "184/TALK"    , "narrator": "アーヤ", "text": "カルシウム剤があるのよ！"},
        { "location": "186/SEL"     , "narrator": "", "text": "へー"},
        { "location": "187/SEL"     , "narrator": "", "text": "イライラしてるの？"},
        { "location": "188/SEL"     , "narrator": "", "text": "あれおいしいよね"},
        { "location": "189/ACT"     , "narrator": "", "text": "へー"},
        { "location": "190/TALK"    , "narrator": "アーヤ", "text": "あんまりそういうのは"},
        { "location": "191/TALK"    , "narrator": "アーヤ", "text": "興味ないみたいね"},
        { "location": "192/ACT"     , "narrator": "", "text": "イライラしてるの？"},
        { "location": "193/TALK"    , "narrator": "アーヤ", "text": "イライラといえば"},
        { "location": "194/TALK"    , "narrator": "アーヤ", "text": "イライラかな"},
        { "location": "195/ACT"     , "narrator": "", "text": "あれおいしいよね"},
        { "location": "196/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "197/TALK"    , "narrator": "アーヤ", "text": "結構そういうの詳しい？"},
        { "location": "198/TALK"    , "narrator": "アーヤ", "text": "美味しいから試してみて"},
        { "location": "200/TALK"    , "narrator": "アーヤ", "text": "なんて言えばいいかな"},
        { "location": "201/TALK"    , "narrator": "アーヤ", "text": "体力をつけるとか"},
        { "location": "202/TALK"    , "narrator": "アーヤ", "text": "きちんとご飯食べるとか"},
        { "location": "203/TALK"    , "narrator": "アーヤ", "text": "ゆっくりお風呂に入るとか"},
        { "location": "204/TALK"    , "narrator": "アーヤ", "text": "そういうのも大事なんだけど"},
        { "location": "205/TALK"    , "narrator": "アーヤ", "text": "もう少しだけ"},
        { "location": "206/TALK"    , "narrator": "アーヤ", "text": "おまじない？みたいなものが欲しいなって"},
        { "location": "208/SEL"     , "narrator": "", "text": "カルシウムって強そうだもんね"},
        { "location": "209/SEL"     , "narrator": "", "text": "自分のところの御守りとかは？"},
        { "location": "210/SEL"     , "narrator": "", "text": "$me$が魔法をかけてあげる"},
        { "location": "211/ACT"     , "narrator": "", "text": "カルシウムって強そうだもんね"},
        { "location": "212/TALK"    , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "213/TALK"    , "narrator": "アーヤ", "text": "強くならなきゃ"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "いけないから"},
        { "location": "215/ACT"     , "narrator": "", "text": "自分のところの御守りとかは？"},
        { "location": "216/TALK"    , "narrator": "アーヤ", "text": "自分で使うのは"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "やっぱりね"},
        { "location": "218/ACT"     , "narrator": "", "text": "$me$が魔法をかけてあげる"},
        { "location": "219/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "220/TALK"    , "narrator": "アーヤ", "text": "お願いするわ"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "素敵な魔法を"},
        { "location": "223/TALK"    , "narrator": "アーヤ", "text": "強さが欲しいわ"},
        { "location": "224/TALK"    , "narrator": "アーヤ", "text": "それから優しさもね"},
        { "location": "225/TALK"    , "narrator": "アーヤ", "text": "そうしないと"},
        { "location": "226/TALK"    , "narrator": "アーヤ", "text": "みんなを守れないもの"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "よし！"},
        { "location": "229/TALK"    , "narrator": "アーヤ", "text": "明日も買ってこよっと"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "オレンジ味のカルシウム(*^^*)"}
    ]
}
