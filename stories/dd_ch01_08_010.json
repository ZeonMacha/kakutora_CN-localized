{
    "dir": "chap08/daydra/dd_ch01_08_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "8152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "父親へのメール"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "父親へのメール"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "う～ん…。"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "あら、悩みごと？"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "はい…お父さんから\nメールが来ていて…。"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "だったら、さっさと\n返信してやんなさいよ。"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "ガブちゃんの\n言う通りや。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "一人娘が突然上京したん\nやき、心配なんよ。"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "でも、毎回送ってくる\n内容が同じだと――"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "なんて返せばいいか\n悩みますよぉ…。"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "どんな内容なの？"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "「上手くやれてるか？」\nとか――"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "「どうして連絡して\nこないんだ？」\nみたいなのばっかりです。"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "なのに、わたしがいつも\n同じ内容で返すと――"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "同じ返事ばかりを\nするんじゃない、って\n怒るんです。"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "…微笑まし過ぎぞね。"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "微笑ましくないですよぉ。\nこっちは本気で\n悩んでるのに…。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "だったら、ハッキリと\n言ってやんなさいよ。"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "いつも同じことばかり\n聞いてくるな、って。"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "えぇっ！？\nそんなハッキリなんて\n言えませんよ！"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "うーん…それなら――"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "毎日代わり映えしない、\nって書いたら？"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "それならお父さんも\n納得してくれるんじゃ\nないかしら。"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "いんや、ここはちっくと\n奇をてらった方がえいな。"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "何でそうなるのよ？"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "いつもと同じ返事や\nのうて、変わった返事を\n期待されてるんやき――"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "それくらいの方が\nえいと思うんよ。"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "奇をてらった返事って、\nどんなのですか？"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "パパン大好きだよ、\nとか？"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "それじゃ別人ですよ！\nそれにパパンなんて\n呼んでませんし！"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "いいから、さっさと\n返してあげなさい。"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "催促のメールまで来たら\n余計返し難くなるわよ？"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "わ、わかりました！"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "でも、本当になんて\n返そう…。"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "相談に乗ってー"},
        { "location": "100/SEL"   , "narrator": "", "text": "返信の内容？"},
        { "location": "101/ACT"   , "narrator": "", "text": "返信の内容？"},
        { "location": "103/TALK"  , "narrator": "つばめ", "text": "そう！"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "凄く困ってるの…（泣）"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "みんなが色々アドバイスしてくれたんだけど"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "誰のを参考にしようかな？"},
        { "location": "108/SEL"   , "narrator": "", "text": "誰が何て言ってたっけ？"},
        { "location": "109/ACT"   , "narrator": "", "text": "誰が何て言ってたっけ？"},
        { "location": "111/TALK"  , "narrator": "つばめ", "text": "ガブリエラせんぱいが"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "いつも同じ質問ばかりするな、で"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "アーヤさんが"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "毎日代わり映えしない、で"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "みやびさんが、えっと…"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "パパン大好きだよ、だね…"},
        { "location": "119/SEL"   , "narrator": "", "text": "ガブリエラのが良さそう"},
        { "location": "120/SEL"   , "narrator": "", "text": "アーヤのが無難かな？"},
        { "location": "121/SEL"   , "narrator": "", "text": "みやびのアイデアが一番"},
        { "location": "122/ACT"   , "narrator": "", "text": "ガブリエラのが良さそう"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "…こっちも、ちょっとは強気で行かないとダメかな？"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "よーし、決めた！"},
        { "location": "129/TALK"  , "narrator": "つばめ", "text": "いつも同じ質問ばかり\nしてくるからだよ、と。"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "送信！"},
        { "location": "138/TALK"  , "narrator": "つばめ", "text": "せんぱいに言われた通り、\n同じことばかり聞くな、\nって返しました。"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "これでたまには違うこと\n聞かれるんじゃない？"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "だと良いんですけど…"},
        { "location": "144/TALK"  , "narrator": "つばめ", "text": "あ、あれ？"},
        { "location": "149/TALK"  , "narrator": "アーヤ", "text": "もう返事が来たの？"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "そうみたいです。\nえっと…。"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "「…だったら、たまには\nそっちからもメールを\n送ってきなさい。」"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "…たまには？"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "もしかして、いつも\nお父さんから来るまで、\nメール送らないの？"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "え、えっと…\nつい忘れちゃって。"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "そりゃあんたが悪いわ。"},
        { "location": "158/TALK"  , "narrator": "アーヤ", "text": "お父さんだって、\n毎回違うこと聞けたりは\nしないわよ。"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "ううっ…すみません。"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "謝る相手も違うし。\nほら、メールメール！"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "はい…「ごめんなさい。\n明日こそはこっちから\nメールします」っと。"},
        { "location": "168/TALK"  , "narrator": "みやび", "text": "忘れんようにね。"},
        { "location": "169/TALK"  , "narrator": "つばめ", "text": "そうですね。\n忘れたら、今度は\n怒られちゃうと思うし…。"},
        { "location": "170/ACT"   , "narrator": "", "text": "アーヤのが無難かな？"},
        { "location": "171/TALK"  , "narrator": "つばめ", "text": "そうだよね"},
        { "location": "172/TALK"  , "narrator": "つばめ", "text": "実際、毎日代わり映えしないんだし"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "えっと…毎日代わり映え\nしなくて、書くことが\nありません。"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "送信！"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "アーヤさんのアドバイス、\n参考にしました。"},
        { "location": "186/TALK"  , "narrator": "アーヤ", "text": "力になれてよかった。\nお父さん、納得して\nくれるといいわね。"},
        { "location": "187/TALK"  , "narrator": "つばめ", "text": "はい！"},
        { "location": "192/TALK"  , "narrator": "つばめ", "text": "って、あれ！？"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "もう返事来たの！？"},
        { "location": "198/TALK"  , "narrator": "つばめ", "text": "みたいです。\nえっと…。"},
        { "location": "199/TALK"  , "narrator": "つばめ", "text": "「毎日同じわけあるか。\n少しは変わったことも\nあっただろう？」"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "もぉ…何も無いって\n言ってるのに！"},
        { "location": "202/TALK"  , "narrator": "みやび", "text": "それだけ心配しちゅう\n証拠やね。"},
        { "location": "204/TALK"  , "narrator": "みやび", "text": "きっと、つばめちゃんと\n色んなこと話したいんや\nない？"},
        { "location": "207/TALK"  , "narrator": "つばめ", "text": "そうでしょうか？"},
        { "location": "208/TALK"  , "narrator": "アーヤ", "text": "多分ね。"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "きっと、お父さんも\n寂しいんじゃないかしら？"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "つばめがこっちに来て、\n急に一人になっちゃった\nわけだし…。"},
        { "location": "211/TALK"  , "narrator": "つばめ", "text": "そっか…。\nお父さん、\n家で一人なんだ…。"},
        { "location": "213/TALK"  , "narrator": "つばめ", "text": "今夜、お父さんに\n電話してみようかな？"},
        { "location": "214/ACT"   , "narrator": "", "text": "みやびのアイデアが一番"},
        { "location": "216/TALK"  , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "217/TALK"  , "narrator": "つばめ", "text": "まさか、みやびさんのを勧めてくるとは思わなかったよ"},
        { "location": "218/TALK"  , "narrator": "つばめ", "text": "う～ん…大丈夫かなぁ？"},
        { "location": "219/TALK"  , "narrator": "つばめ", "text": "…でも、驚いたお父さんが\nどう返してくるか、\nちょっと気になるかも。"},
        { "location": "222/TALK"  , "narrator": "つばめ", "text": "よーし…「パパン、\n大好きだよ」っと。"},
        { "location": "223/TALK"  , "narrator": "つばめ", "text": "送信です！"},
        { "location": "231/TALK"  , "narrator": "つばめ", "text": "思い切って、奇をてらって\nみました！"},
        { "location": "233/TALK"  , "narrator": "アーヤ", "text": "あはは…お父さん、\nきっと驚くわね。"},
        { "location": "234/TALK"  , "narrator": "ガブリエラ", "text": "てか、パパンなんて\n冗談でも恥ずかしいわ。"},
        { "location": "235/TALK"  , "narrator": "つばめ", "text": "い、いいんです。\nいつもと違った内容では\nあるんだし…。"},
        { "location": "236/TALK"  , "narrator": "みやび", "text": "別人やと思われなければ\nえいんやけんどね。"},
        { "location": "240/TALK"  , "narrator": "みやび", "text": "…ん？\nつばめちゃん、スマホが\n震えちゅう。"},
        { "location": "242/TALK"  , "narrator": "つばめ", "text": "えっ？"},
        { "location": "246/TALK"  , "narrator": "つばめ", "text": "あっ！\nもう返信が着ました！"},
        { "location": "247/TALK"  , "narrator": "ガブリエラ", "text": "何て返ってきた？"},
        { "location": "248/TALK"  , "narrator": "つばめ", "text": "えーっと…。"},
        { "location": "249/TALK"  , "narrator": "つばめ", "text": "「電話で同じことを\n言えるのか？――"},
        { "location": "250/TALK"  , "narrator": "つばめ", "text": "言えないことは\n書くんじゃない」"},
        { "location": "251/TALK"  , "narrator": "アーヤ", "text": "…驚いてはいない\nみたいね。"},
        { "location": "253/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、狙い過ぎて\nスベッてるじゃん。"},
        { "location": "254/TALK"  , "narrator": "みやび", "text": "ふむ…中々上手い返しを\nしてくるお父さんやね。"},
        { "location": "258/TALK"  , "narrator": "つばめ", "text": "感心しないでください！\nこういう時、なんて\n返せばいいんですか？"},
        { "location": "259/TALK"  , "narrator": "みやび", "text": "寄をてらうんやったら\n「怒りん坊のパパンも\nカワイイ☆」やね。"},
        { "location": "260/TALK"  , "narrator": "みやび", "text": "狙わないんやったら、\n「ごめんなさい」が\nえいと思うよ。"},
        { "location": "265/TALK"  , "narrator": "つばめ", "text": "「ごめんなさい」送信！"},
        { "location": "268/TALK"  , "narrator": "アーヤ", "text": "…凄く後悔してる\nみたいよ？"},
        { "location": "270/TALK"  , "narrator": "みやび", "text": "つばめちゃんのお父さん、\nジョークの通じん人\nやったみたいやね。"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月11日　4:56 PM</color>\n転校３日目、神楽坂トライナリーでのバイト中のこと。"}
    ]
}
