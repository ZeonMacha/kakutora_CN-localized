        { "location": "8685/TALK"    , "narrator": "神楽", "text": "あんまり見なくなった"},
        { "location": "8686/TALK"    , "narrator": "神楽", "text": "ちょこっとだけさみしいぴょん"},
        { "location": "8688/SEL"     , "narrator": "", "text": "カクトラは？"},
        { "location": "8689/SEL"     , "narrator": "", "text": "チャットの相手がなかなかディープな話題を振ってくるんだが"},
        { "location": "8690/SEL"     , "narrator": "", "text": "はやりすたりってあるよね"},
        { "location": "8691/ACT"     , "narrator": "", "text": "カクトラは？"},
        { "location": "8692/TALK"    , "narrator": "神楽", "text": "そういうのがあるぴょん？"},
        { "location": "8693/ACT"     , "narrator": "", "text": "チャットの相手がなかなかディープな話題を振ってくるんだが"},
        { "location": "8695/TALK"    , "narrator": "神楽", "text": "キタｗｗｗｗ"},
        { "location": "8696/TALK"    , "narrator": "神楽", "text": "今のってそういうやつなｗｗｗｗ"},
        { "location": "8697/TALK"    , "narrator": "神楽", "text": "わかりみ！！！！"},
        { "location": "8698/ACT"     , "narrator": "", "text": "はやりすたりってあるよね"},
        { "location": "8699/TALK"    , "narrator": "神楽", "text": "なんだよねー"},
        { "location": "8701/TALK"    , "narrator": "神楽", "text": "別に四文字タイトルブームが戻ってきてほしいとかそういうわけじゃないぴょん"},
        { "location": "8702/TALK"    , "narrator": "神楽", "text": "ただそうなんだなーってそれだけなんだけど"},
        { "location": "8704/SEL"     , "narrator": "", "text": "神楽への恋心はずっと廃れない"},
        { "location": "8705/SEL"     , "narrator": "", "text": "時の流れを感じるよね"},
        { "location": "8706/SEL"     , "narrator": "", "text": "ふーん"},
        { "location": "8707/ACT"     , "narrator": "", "text": "神楽への恋心はずっと廃れない"},
        { "location": "8709/TALK"    , "narrator": "神楽", "text": "おっおっ？"},
        { "location": "8710/TALK"    , "narrator": "神楽", "text": "イイネイイネ！"},
        { "location": "8712/TALK"    , "narrator": "神楽", "text": "情熱的ね$handle$"},
        { "location": "8713/TALK"    , "narrator": "神楽", "text": "もしも時代が変わっても歌う歌が変わってもぴょんこへの気持ちはかわらない、、、"},
        { "location": "8714/TALK"    , "narrator": "神楽", "text": "そういうことでしょ？？？"},
