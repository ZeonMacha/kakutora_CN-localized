    "dir": "chap00/daydra/spev_ch01_091_03.js",
    "type": "",
    "info": {
        "story_id": "91023",
        "cid": "",
        "title": "シャッツキステリンク",
        "sub_title": "忘れもの見つけたよ！"
    },
    "entry":
    [
        { "location": "688/SCENARIO", "narrator": "", "text": "報告イベント"},
        { "location": "711/DIALOG"  , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "744/TALK"    , "narrator": "神楽", "text": "はぁ…。"},
        { "location": "749/TALK"    , "narrator": "神楽", "text": "最近ほんとにダメです、\n私……。"},
        { "location": "754/TALK"    , "narrator": "神楽", "text": "ションボリです……。"},
        { "location": "759/TALK"    , "narrator": "神楽", "text": "奇跡的に見つかったり、\nしないですよね……。"},
        { "location": "764/TALK"    , "narrator": "神楽", "text": "……。"},
        { "location": "783/TALK"    , "narrator": "神楽", "text": "きゃっ！？"},
        { "location": "788/TALK"    , "narrator": "神楽", "text": "えっ！？"},
        { "location": "793/TALK"    , "narrator": "神楽", "text": "はわっ！"},
        { "location": "796/DIALOG"  , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "797/TALK"    , "narrator": "神楽", "text": "貴方は確か――！！"},
        { "location": "798/SEL"     , "narrator": "（選択肢）", "text": "プリ見つけたよ"},
        { "location": "799/ACT"     , "narrator": "", "text": "プリ見つけたよ"},
        { "location": "802/TALK"    , "narrator": "神楽", "text": "えぇっ！\n本当に見つけて\nくれたんですか！？"},
        { "location": "803/TALK"    , "narrator": "神楽", "text": "よかった…。\nもう、見つからないと\n思ってました…。"},
        { "location": "804/SEL"     , "narrator": "（選択肢）", "text": "そんなに大切だったんだ？"},
        { "location": "805/ACT"     , "narrator": "", "text": "そんなに大切だったんだ？"},
        { "location": "807/TALK"    , "narrator": "神楽", "text": "…はい。"},
        { "location": "808/TALK"    , "narrator": "神楽", "text": "このプリは…、\n私には、本当に特別で、\n大切なものなんです。"},
        { "location": "809/TALK"    , "narrator": "神楽", "text": "このプリがあるから、\n私は今も、つばめさんの\nことを…。"},
        { "location": "810/SEL"     , "narrator": "（選択肢）", "text": "つばめを、なに？"},
        { "location": "811/ACT"     , "narrator": "", "text": "つばめを、なに？"},
        { "location": "813/TALK"    , "narrator": "神楽", "text": "…友達だと、\n思えているんです。"},
        { "location": "814/TALK"    , "narrator": "神楽", "text": "もしこれが無かったら、\nきっと私は、今頃…。"},
        { "location": "815/SEL"     , "narrator": "（選択肢）", "text": "なんか不穏だね"},
        { "location": "816/ACT"     , "narrator": "", "text": "なんか不穏だね"},
        { "location": "818/TALK"    , "narrator": "神楽", "text": "…ごめんなさい。\n変な話しちゃって。"},
        { "location": "819/TALK"    , "narrator": "神楽", "text": "とにかく、これは私と\nつばめさんの絆で、\n大切なものってことです。"},
        { "location": "820/SEL"     , "narrator": "（選択肢）", "text": "見つかってよかった"},
        { "location": "821/SEL"     , "narrator": "（選択肢）", "text": "早く繋がりたいよ！"},
        { "location": "822/ACT"     , "narrator": "", "text": "見つかってよかった"},
        { "location": "823/TALK"    , "narrator": "神楽", "text": "私も、見つけていただけて\n本当に嬉しいです。"},
        { "location": "824/TALK"    , "narrator": "神楽", "text": "何と感謝すれば\nよいのやら…。"},
        { "location": "825/SEL"     , "narrator": "（選択肢）", "text": "神楽が喜んでるならＯＫ"},
        { "location": "826/SEL"     , "narrator": "（選択肢）", "text": "デート一回でいいよ"},
        { "location": "827/ACT"     , "narrator": "", "text": "神楽が喜んでるならＯＫ"},
        { "location": "829/TALK"    , "narrator": "神楽", "text": "ふふっ、\n紳士さんですね。"},
        { "location": "830/ACT"     , "narrator": "", "text": "デート一回でいいよ"},
        { "location": "831/TALK"    , "narrator": "神楽", "text": "気持ちは、\nとても嬉しいです。"},
        { "location": "833/TALK"    , "narrator": "神楽", "text": "でも…これから先も、\nそう思ってもらえるか\nどうか…。"},
        { "location": "834/SEL"     , "narrator": "（選択肢）", "text": "どういうこと？"},
        { "location": "835/ACT"     , "narrator": "", "text": "どういうこと？"},
        { "location": "838/TALK"    , "narrator": "神楽", "text": "あ、いえ！\nなんでもありません…。"},
        { "location": "839/TALK"    , "narrator": "神楽", "text": "では、機会があれば、\n一緒にデートしましょう。"},
        { "location": "841/TALK"    , "narrator": "神楽", "text": "その時はもちろん、\nシャッツキステで。"},
        { "location": "843/ACT"     , "narrator": "", "text": "早く繋がりたいよ！"},
        { "location": "844/TALK"    , "narrator": "神楽", "text": "ふふ。\n私も同じ事を\n思ってますよ？"},
        { "location": "845/TALK"    , "narrator": "神楽", "text": "あなたは、みんなを支えて\nくれている素敵な人です。"},
        { "location": "846/TALK"    , "narrator": "神楽", "text": "それに、今日は私も\n助けてもらっちゃったし。"},
        { "location": "847/TALK"    , "narrator": "神楽", "text": "貴方のことを、みんなが\n好きになるの、少しだけ\nわかった気がします。"},
        { "location": "848/TALK"    , "narrator": "神楽", "text": "…もし、これから先も\n私のことを見限らないで\nくれるなら。"},
        { "location": "849/TALK"    , "narrator": "神楽", "text": "私も…今よりもっと、\n仲良くしたいです。"},
        { "location": "851/TALK"    , "narrator": "神楽", "text": "何にしても、今回は\nありがとうございました！"},
        { "location": "852/TALK"    , "narrator": "神楽", "text": "お店まで足を運ぶの、\n大変じゃありません\nでしたか？"},
        { "location": "853/SEL"     , "narrator": "（選択肢）", "text": "全然平気！"},
        { "location": "854/SEL"     , "narrator": "（選択肢）", "text": "ちょっと遠かった"},
        { "location": "855/SEL"     , "narrator": "（選択肢）", "text": "それより、プリはどうすればいい？"},
        { "location": "856/ACT"     , "narrator": "", "text": "全然平気！"},
        { "location": "857/TALK"    , "narrator": "神楽", "text": "ふふ、安心しました♪"},
        { "location": "858/TALK"    , "narrator": "神楽", "text": "あと、せっかく見つけて\nくれたのに、こんな事を\n言うのも何ですが――"},
        { "location": "859/ACT"     , "narrator": "", "text": "ちょっと遠かった"},
        { "location": "860/TALK"    , "narrator": "神楽", "text": "大変！\nそこまでして探しに\n来てくれたんですね。"},
        { "location": "861/TALK"    , "narrator": "神楽", "text": "本当に\nありがとうございます！"},
        { "location": "862/TALK"    , "narrator": "神楽", "text": "あと、せっかく見つけて\nくれたのに、こんな事を\n言うのも何ですが――"},
        { "location": "863/ACT"     , "narrator": "", "text": "それより、プリはどうすればいい？"},
        { "location": "864/TALK"    , "narrator": "神楽", "text": "あ、はい。\nそのことなんですけど。"},
        { "location": "865/TALK"    , "narrator": "神楽", "text": "せっかく見つけて\nくれたのに、こんな事を\n言うのもなんですが――"},
        { "location": "867/TALK"    , "narrator": "神楽", "text": "そのプリは\n貴方に差し上げます。"},
        { "location": "868/TALK"    , "narrator": "神楽", "text": "私が持っていても、\nいつか……。"},
        { "location": "869/TALK"    , "narrator": "神楽", "text": "いつか無くしちゃいそう\nですから。えへへ。"},
        { "location": "870/TALK"    , "narrator": "神楽", "text": "私、お掃除苦手なんです！"},
        { "location": "871/SEL"     , "narrator": "（選択肢）", "text": "ドヤ顔で言う？"},
        { "location": "872/ACT"     , "narrator": "", "text": "ドヤ顔で言う？"},
        { "location": "874/TALK"    , "narrator": "神楽", "text": "っと、ごめんなさい。\nついつい長話を\nしちゃいましたね。"},
        { "location": "876/TALK"    , "narrator": "神楽", "text": "それでは、\nまたお逢いできる日まで。"},
        { "location": "877/TALK"    , "narrator": "神楽", "text": "貴方と私に、\n素敵なココロの旅を！"},
        { "location": "880/DIALOG"  , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:SYSTEM】</color>\n\n<color=red>回線が切断されました。</color>\n\nこのままお店の方に\nお戻しください。\n\nTRI-OS異世界間通信サービスの\nご利用、ありがとうございました。"}
    ]
}
