        { "location": "7/SCENARIO", "narrator": "", "text": "022_今は原始ではないのでね"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "いやしかし"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "みやびさんには"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "刺激の強い書籍だったぞね"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "あの忘れ物は"},
        { "location": "37/SEL"    , "narrator": "", "text": "そうだよね"},
        { "location": "38/SEL"    , "narrator": "", "text": "そうだっけ"},
        { "location": "39/ACT"    , "narrator": "", "text": "そうだよね"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "41/ACT"    , "narrator": "", "text": "そうだっけ"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "そうだって"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "俗語で言うところのエロ本"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "ちゅーやつぞね"},
        { "location": "48/SEL"    , "narrator": "", "text": "エロ本だったんだ？"},
        { "location": "49/SEL"    , "narrator": "", "text": "そういう忘れ物多いの？"},
        { "location": "50/SEL"    , "narrator": "", "text": "客商売は大変だね"},
        { "location": "51/ACT"    , "narrator": "", "text": "エロ本だったんだ？"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "エロスとリビドー"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "困るわー"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "ホント困るわー"},
        { "location": "57/ACT"    , "narrator": "", "text": "そういう忘れ物多いの？"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "そういうどころか"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "忘れ物自体が"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "なかった"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "なぜなら"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "客が来ぬからだ"},
        { "location": "63/ACT"    , "narrator": "", "text": "客商売は大変だね"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "おお相棒よ"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "わかってくれとるの"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "しかし"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "よりによってあんなもん"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "忘れるなや！！！！"}
    ]
