        { "location": "100/SCENARIO", "narrator": "", "text": "032_蚊取り線香花火"},
        { "location": "127/TALK"    , "narrator": "みやび", "text": "蚊帳だ蚊帳だ"},
        { "location": "128/TALK"    , "narrator": "みやび", "text": "蚊帳を持て"},
        { "location": "130/SEL"     , "narrator": "", "text": "蚊帳って何"},
        { "location": "131/SEL"     , "narrator": "", "text": "送ったよー"},
        { "location": "132/SEL"     , "narrator": "", "text": "風情があるね"},
        { "location": "133/ACT"     , "narrator": "", "text": "蚊帳って何"},
        { "location": "134/TALK"    , "narrator": "みやび", "text": "なんと"},
        { "location": "135/TALK"    , "narrator": "みやび", "text": "知らぬとは"},
        { "location": "136/ACT"     , "narrator": "", "text": "送ったよー"},
        { "location": "137/TALK"    , "narrator": "みやび", "text": "よしよし"},
        { "location": "138/TALK"    , "narrator": "みやび", "text": "届くまで待つとしよう"},
        { "location": "139/ACT"     , "narrator": "", "text": "風情があるね"},
        { "location": "141/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "143/TALK"    , "narrator": "みやび", "text": "エアコンよりやはり蚊帳だ"},
        { "location": "144/TALK"    , "narrator": "みやび", "text": "PCの放射熱さえなければだが"},
        { "location": "146/TALK"    , "narrator": "みやび", "text": "蚊帳で蚊の侵入を防ぐ"},
        { "location": "147/TALK"    , "narrator": "みやび", "text": "これは大変に大事なことである"},
        { "location": "148/TALK"    , "narrator": "みやび", "text": "だが、もうひとつの武器も必要だ"},
        { "location": "149/TALK"    , "narrator": "みやび", "text": "何かわかるかな"},
        { "location": "151/SEL"     , "narrator": "", "text": "蚊取り線香"},
        { "location": "152/SEL"     , "narrator": "", "text": "アサルトライフル"},
        { "location": "153/SEL"     , "narrator": "", "text": "みやびのお色気"},
        { "location": "154/ACT"     , "narrator": "", "text": "蚊取り線香"},
        { "location": "155/TALK"    , "narrator": "みやび", "text": "正解"},
        { "location": "156/TALK"    , "narrator": "みやび", "text": "しかし"},
        { "location": "157/TALK"    , "narrator": "みやび", "text": "凡庸"},
        { "location": "158/ACT"     , "narrator": "", "text": "アサルトライフル"},
        { "location": "159/TALK"    , "narrator": "みやび", "text": "文字通りの武器"},
        { "location": "161/TALK"    , "narrator": "みやび", "text": "いらんやろ"},
        { "location": "162/ACT"     , "narrator": "", "text": "みやびのお色気"},
        { "location": "164/TALK"    , "narrator": "みやび", "text": "確かに大事だ"},
        { "location": "165/TALK"    , "narrator": "みやび", "text": "しかし"},
        { "location": "166/TALK"    , "narrator": "みやび", "text": "血を吸う蚊は全てメスである"},
        { "location": "174/TALK"    , "narrator": "みやび", "text": "蚊取り線香を焚き"},
        { "location": "175/TALK"    , "narrator": "みやび", "text": "蚊帳を張って眠る"},
        { "location": "176/TALK"    , "narrator": "みやび", "text": "日本情緒の極み"},
        { "location": "177/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "179/TALK"    , "narrator": "みやび", "text": "エアコンの方が快適かもしれんがの"}
    ]
