        { "location": "318/SCENARIO", "narrator": "", "text": "410_Rain、あるいは言の葉の庭"},
        { "location": "343/TALK"    , "narrator": "ガブリエラ", "text": "私の右手の小さな窓から"},
        { "location": "344/TALK"    , "narrator": "ガブリエラ", "text": "私は空を覗きます"},
        { "location": "345/TALK"    , "narrator": "ガブリエラ", "text": "でも太陽も月も星も"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "泣き出しそうな雲に隠れていて"},
        { "location": "347/TALK"    , "narrator": "ガブリエラ", "text": "見ることができません"},
        { "location": "348/TALK"    , "narrator": "ガブリエラ", "text": "雲はどうすれば晴れるのでしょうか"},
        { "location": "349/TALK"    , "narrator": "ガブリエラ", "text": "私はまた、"},
        { "location": "350/TALK"    , "narrator": "ガブリエラ", "text": "晴れた空が見たいのです"},
        { "location": "351/TALK"    , "narrator": "ガブリエラ", "text": "それが私の願いです"},
