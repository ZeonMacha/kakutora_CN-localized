    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "05_000_戦う少女は"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "戦う少女か"},
        { "location": "35/SEL"    , "narrator": "", "text": "美少女限定でお願いします"},
        { "location": "36/SEL"    , "narrator": "", "text": "自分のこと？"},
        { "location": "37/ACT"    , "narrator": "", "text": "美少女限定でお願いします"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "贅沢な"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "しかし"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "真理かもしれず"},
        { "location": "41/ACT"    , "narrator": "", "text": "自分のこと？"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "今回は違う"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "戦う少女とは"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "卯月のことぞね"},
        { "location": "49/SEL"    , "narrator": "", "text": "そうなの"},
        { "location": "50/SEL"    , "narrator": "", "text": "気になることがあるの"},
        { "location": "51/SEL"    , "narrator": "", "text": "みやびだってそうでしょ"},
        { "location": "52/ACT"    , "narrator": "", "text": "そうなの"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "そう"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "ぞね"},
        { "location": "55/ACT"    , "narrator": "", "text": "気になることがあるの"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "ちょっとな"},
        { "location": "58/ACT"    , "narrator": "", "text": "みやびだってそうでしょ"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "だからうちのことではないと"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "そう思ってくれてる分には問題ないが"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "卯月が"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "どうにもちょっと"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "考えすぎか"},
        { "location": "71/SEL"    , "narrator": "", "text": "とりあえず考えを言ってみて"},
        { "location": "72/SEL"    , "narrator": "", "text": "だったらいいんだけど"},
        { "location": "73/ACT"    , "narrator": "", "text": "とりあえず考えを言ってみて"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "どうにも"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "無理をしている風に見えた"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "が"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "きっと気のせいだろう"},
        { "location": "79/ACT"    , "narrator": "", "text": "だったらいいんだけど"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "気のせいだな"}
    ]
}
