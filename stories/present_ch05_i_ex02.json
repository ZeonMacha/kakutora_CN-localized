        { "location": "627/TALK", "narrator": "神楽", "text": "あらあら♪"},
        { "location": "628/TALK", "narrator": "神楽", "text": "ぴょんこの側だけじゃなくて"},
        { "location": "629/TALK", "narrator": "神楽", "text": "あなたも危険なんですよっ★"},
        { "location": "632/SEL" , "narrator": "", "text": "それでも神楽と繋がりたいな"},
