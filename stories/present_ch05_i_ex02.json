        { "location": "527/TALK", "narrator": "神楽", "text": "これ、、、"},
        { "location": "528/TALK", "narrator": "神楽", "text": "なんでここにあるんですか？"},
        { "location": "530/TALK", "narrator": "神楽", "text": "開発されたのは2026年のはずなのに、、、"},
        { "location": "532/SEL" , "narrator": "", "text": "ホワイトデーサプライズだよ"},
        { "location": "533/ACT" , "narrator": "", "text": "ホワイトデーサプライズだよ"},
        { "location": "536/TALK", "narrator": "神楽", "text": "ドヤ顔ですね！？！？"},
        { "location": "539/SEL" , "narrator": "", "text": "ところでどんなアプリなの？"},
        { "location": "540/SEL" , "narrator": "", "text": "ドヤ顔くらいさせて"},
        { "location": "541/SEL" , "narrator": "", "text": "すごいアプリだもんね"},
        { "location": "542/ACT" , "narrator": "", "text": "ところでどんなアプリなの？"},
        { "location": "544/TALK", "narrator": "神楽", "text": "高機能量子クラウドサービス、、、"},
        { "location": "545/TALK", "narrator": "神楽", "text": "だとざっくりすぎますね"},
        { "location": "546/TALK", "narrator": "神楽", "text": "特別に開発されたヘッドセットを付けると脳内に思い描いたものをクラウドに展開できるんです"},
        { "location": "547/TALK", "narrator": "神楽", "text": "要は脳内がそのままクラウド上に映像としてアップできるサービス"},
        { "location": "548/TALK", "narrator": "神楽", "text": "そして設計にはぴょんこの父が携わったんです"},
        { "location": "549/ACT" , "narrator": "", "text": "ドヤ顔くらいさせて"},
        { "location": "551/TALK", "narrator": "神楽", "text": "してもいいですけど、、、"},
        { "location": "552/ACT" , "narrator": "", "text": "すごいアプリだもんね"},
        { "location": "554/TALK", "narrator": "神楽", "text": "そうですよ"},
        { "location": "555/TALK", "narrator": "神楽", "text": "ありえないくらい高機能なんです"},
        { "location": "559/SEL" , "narrator": "", "text": "神楽にとって大切な思い出のアプリでしょ"},
        { "location": "560/SEL" , "narrator": "", "text": "この技術があれば神楽ともっと色んなことを伝えあえるのに"},
        { "location": "561/ACT" , "narrator": "", "text": "神楽にとって大切な思い出のアプリでしょ"},
        { "location": "563/TALK", "narrator": "神楽", "text": "思い出ですか、、、"},
        { "location": "564/TALK", "narrator": "神楽", "text": "実はあんまりないんですよね"},
        { "location": "565/TALK", "narrator": "神楽", "text": "父とのことは"},
        { "location": "568/SEL" , "narrator": "", "text": "そうなの？"},
        { "location": "569/SEL" , "narrator": "", "text": "意外だな"},
        { "location": "570/ACT" , "narrator": "", "text": "そうなの？"},
        { "location": "572/TALK", "narrator": "神楽", "text": "一言で言うと真面目が服を着ているような人で"},
        { "location": "573/TALK", "narrator": "神楽", "text": "ぴょんこの成績以外にはあんまり興味もないみたいで"},
        { "location": "574/TALK", "narrator": "神楽", "text": "そういう話しかしたことなかったんですよ"},
        { "location": "575/ACT" , "narrator": "", "text": "意外だな"},
        { "location": "577/TALK", "narrator": "神楽", "text": "そうですか？"},
        { "location": "578/TALK", "narrator": "神楽", "text": "でもぴょんこは尊敬していましたよ父のこと"},
        { "location": "579/TALK", "narrator": "神楽", "text": "努力家で、目標を持ってる人だったから"},
        { "location": "582/SEL" , "narrator": "", "text": "神楽に似てる"},
        { "location": "583/SEL" , "narrator": "", "text": "親子だもんね"},
        { "location": "584/ACT" , "narrator": "", "text": "神楽に似てる"},
        { "location": "586/TALK", "narrator": "神楽", "text": "初めて言われました"},
        { "location": "587/TALK", "narrator": "神楽", "text": "なんかびっくりです"},
        { "location": "588/TALK", "narrator": "神楽", "text": "でもうれしい"},
        { "location": "589/ACT" , "narrator": "", "text": "親子だもんね"},
        { "location": "591/TALK", "narrator": "神楽", "text": "そうですね"},
        { "location": "592/TALK", "narrator": "神楽", "text": "会えるなら会いたい"},
        { "location": "593/TALK", "narrator": "神楽", "text": "今ならもっと色々な話ができるはずなのに、、、"},
        { "location": "598/SEL" , "narrator": "", "text": "泣かないで"},
        { "location": "599/SEL" , "narrator": "", "text": "なんかごめん"},
        { "location": "600/ACT" , "narrator": "", "text": "泣かないで"},
        { "location": "602/TALK", "narrator": "神楽", "text": "ごめんなさい"},
        { "location": "603/TALK", "narrator": "神楽", "text": "アプリはとてもうれしかった"},
        { "location": "604/TALK", "narrator": "神楽", "text": "それは本当ですよ"},
        { "location": "607/ACT" , "narrator": "", "text": "なんかごめん"},
        { "location": "609/TALK", "narrator": "神楽", "text": "違うんです"},
        { "location": "610/TALK", "narrator": "神楽", "text": "あなたは悪くないの"},
        { "location": "611/TALK", "narrator": "神楽", "text": "だから大丈夫です"},
        { "location": "615/ACT" , "narrator": "", "text": "この技術があれば神楽ともっと色んなことを伝えあえるのに"},
        { "location": "617/TALK", "narrator": "神楽", "text": "そうかもですね"},
        { "location": "618/TALK", "narrator": "神楽", "text": "でも脳内のことが全部公開されたりとか"},
        { "location": "619/TALK", "narrator": "神楽", "text": "危険なアプリでもあったんですよ"},
        { "location": "622/SEL" , "narrator": "", "text": "神楽の考えなら全部知りたい"},
