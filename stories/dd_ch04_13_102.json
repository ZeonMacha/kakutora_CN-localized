    "type": "MainStory",
    "info": {
        "story_id": "13405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "穴へは飛び込むべきか＜後編＞"
    },
    "entry":
    [
        { "location": "319/SCENARIO", "narrator": "", "text": "うさぎと女王"},
        { "location": "331/TALK"    , "narrator": "みやび", "text": "…いや、さすがに\n回数減らすんは問題やな。"},
        { "location": "332/TALK"    , "narrator": "みやび", "text": "作業に支障が出る\n恐れもあるし。"},
        { "location": "333/TALK"    , "narrator": "みやび", "text": "…まあ、うちらは\n今くらいの距離が一番\nえいかもしれんね…。"},
        { "location": "337/TALK"    , "narrator": "みやび", "text": "ん…なんや？"},
        { "location": "342/TALK"    , "narrator": "ラビットアニマ", "text": "申し訳ありません"},
        { "location": "343/TALK"    , "narrator": "ラビットアニマ", "text": "先ほど伝え忘れていましたが"},
        { "location": "344/TALK"    , "narrator": "ラビットアニマ", "text": "こちらでも解析したデータがありました"},
        { "location": "347/TALK"    , "narrator": "フェイタルクイーン", "text": "ご苦労"},
        { "location": "348/TALK"    , "narrator": "フェイタルクイーン", "text": "ファイルはいつもの場所によろしく"},
        { "location": "350/TALK"    , "narrator": "ラビットアニマ", "text": "承知しました"},
        { "location": "352/TALK"    , "narrator": "ラビットアニマ", "text": "アップしましたので、後程確認を"},
        { "location": "354/TALK"    , "narrator": "フェイタルクイーン", "text": "了解"},
        { "location": "356/TALK"    , "narrator": "ラビットアニマ", "text": "それでは"},
        { "location": "358/TALK"    , "narrator": "フェイタルクイーン", "text": "いや待て"},
        { "location": "361/TALK"    , "narrator": "ラビットアニマ", "text": "他に何か？"},
        { "location": "365/TALK"    , "narrator": "フェイタルクイーン", "text": "いや"},
        { "location": "366/TALK"    , "narrator": "フェイタルクイーン", "text": "大したことではないが"},
        { "location": "368/TALK"    , "narrator": "フェイタルクイーン", "text": "ふと思ってな"},
        { "location": "369/TALK"    , "narrator": "フェイタルクイーン", "text": "うさぎとも"},
        { "location": "370/TALK"    , "narrator": "フェイタルクイーン", "text": "大分長い付き合いになったなと"},
        { "location": "373/TALK"    , "narrator": "ラビットアニマ", "text": "そうですね"},
        { "location": "375/TALK"    , "narrator": "ラビットアニマ", "text": "突然どうしたのですか？"},
        { "location": "377/TALK"    , "narrator": "フェイタルクイーン", "text": "いや"},
        { "location": "379/TALK"    , "narrator": "フェイタルクイーン", "text": "私のしている行為は大袈裟でなく"},
        { "location": "380/TALK"    , "narrator": "フェイタルクイーン", "text": "かなり危険なものだ"},
        { "location": "381/TALK"    , "narrator": "フェイタルクイーン", "text": "国に対する反逆行為と言っても過言ではない"},
        { "location": "383/TALK"    , "narrator": "フェイタルクイーン", "text": "なのに"},
        { "location": "384/TALK"    , "narrator": "フェイタルクイーン", "text": "君は文句ひとつ言わず協力してくれている"},
        { "location": "388/TALK"    , "narrator": "フェイタルクイーン", "text": "感謝する"},
        { "location": "389/TALK"    , "narrator": "フェイタルクイーン", "text": "これからも頼りにしていいだろうか？"},
        { "location": "392/TALK"    , "narrator": "ラビットアニマ", "text": "愚問です"},
        { "location": "393/TALK"    , "narrator": "システム", "text": "『RabbitAnimaが退出しました』"},
        { "location": "395/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "397/TALK"    , "narrator": "みやび", "text": "ははっ…、\n愚問と来たかぁ…。"},
        { "location": "402/TALK"    , "narrator": "みやび", "text": "らしくないことをするとどうなるか？"},
        { "location": "403/TALK"    , "narrator": "みやび", "text": "答えは簡単"},
        { "location": "404/TALK"    , "narrator": "みやび", "text": "顔が熱くなる"},
        { "location": "407/SEL"     , "narrator": "", "text": "照れてる、ってことね？"},
        { "location": "408/ACT"     , "narrator": "", "text": "照れてる、ってことね？"},
        { "location": "411/TALK"    , "narrator": "みやび", "text": "簡単に言えばそうなる"},
        { "location": "412/TALK"    , "narrator": "みやび", "text": "しかし"},
        { "location": "413/TALK"    , "narrator": "みやび", "text": "まっことうちらしくない"},
        { "location": "414/TALK"    , "narrator": "みやび", "text": "ウサギも今頃"},
        { "location": "415/TALK"    , "narrator": "みやび", "text": "クイーン壊れた"},
        { "location": "416/TALK"    , "narrator": "みやび", "text": "とか思うてるに違いない"},
        { "location": "418/SEL"     , "narrator": "", "text": "でも、気持ちを伝えるのは大切"},
        { "location": "419/ACT"     , "narrator": "", "text": "でも、気持ちを伝えるのは大切"},
        { "location": "423/TALK"    , "narrator": "みやび", "text": "反論の余地なし"},
        { "location": "424/TALK"    , "narrator": "みやび", "text": "うちもそう思う"},
        { "location": "425/TALK"    , "narrator": "みやび", "text": "言うてよかった"},
        { "location": "427/TALK"    , "narrator": "みやび", "text": "らしくないことも"},
        { "location": "428/TALK"    , "narrator": "みやび", "text": "たまには良しとしよう"},
        { "location": "433/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "434/TALK"    , "narrator": "みやび", "text": "さっきの会話ログ、\n保存しとくか…。"},
        { "location": "445/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【MV EXE_AYAMi】"}
    ]
}
