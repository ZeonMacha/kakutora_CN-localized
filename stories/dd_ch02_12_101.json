        "title": "002 メインストーリー",
        "sub_title": "アーヤの午後＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "アーヤの午後"},
        { "location": "24/TALK"   , "narrator": "アーヤ", "text": "さてと、今日は午前で\n終わりだし――"},
        { "location": "27/TALK"   , "narrator": "アーヤ", "text": "これからどうする？\n次の劇のことも\n話したいんだけど…。"},
        { "location": "29/TALK"   , "narrator": "小夜", "text": "ごっめーん！\n私、今日午後から\nバイト入ってるの。"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "そっか…。\nじゃあ、話はまた\n今度ね。"},
        { "location": "33/TALK"   , "narrator": "小夜", "text": "だね。\nじゃ、また明日ね。"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "…じゃあ、買い物でも\n行こうかしら？"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "ん～、服を見に\n行くのはやめた方が\nいいかしら？"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "この前も買ったばかり\nなんだし…。"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "でも、もしかしたら\n新作が出てるかも\nしれないわね。"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "…まあ、見るだけなら\nタダなんだし、\n行ってみよう。"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "やだ、新作出てる！"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "このシャツ、この前\n買った白のパンツと\n合わせれば…。"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "って、ダメダメ。\n今日は見るだけって\n決めたんだから。"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "75/TALK"   , "narrator": "ウェイトレス", "text": "そちら、本日入荷した\n新作ですよー。"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "あ、はあ…。"},
        { "location": "80/TALK"   , "narrator": "ウェイトレス", "text": "上に羽織っても、\n直に着てもいい\nデザインになんです。"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "ですね…。\nとっても素敵だとは\n思うんですけど…。"},
        { "location": "82/TALK"   , "narrator": "ウェイトレス", "text": "よろしければ、\n試着だけでも\nどうですか？"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "試着なんかしたら、\n絶対に…。"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "…結局、\n買っちゃった。"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "今日は見るだけって\n決めてたのに…、\n意思が弱いなぁ…。"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "まあ、いい買い物では\nあったかな？"},
        { "location": "112/TALK"  , "narrator": "店員", "text": "いらっしゃいませ。"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "あ、こんにちは。"},
        { "location": "116/TALK"  , "narrator": "店員", "text": "何か、いいことでも\nあったようですね。"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "ええ…ちょっと、\nいい買い物ができた\nので。"},
        { "location": "118/TALK"  , "narrator": "店員", "text": "そういうこと\nでしたか。"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "あはは…。"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "あ、注文だけど、\nバーニャカウダー\nお願いします。"},
        { "location": "124/TALK"  , "narrator": "店員", "text": "かしこまりました。\n少々お待ちください。"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "ふぅ…。"},
        { "location": "130/SEL"   , "narrator": "", "text": "結構楽しんでる？"},
        { "location": "131/ACT"   , "narrator": "", "text": "結構楽しんでる？"},
        { "location": "136/TALK"  , "narrator": "アーヤ", "text": "あら？"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "ええ(^^"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "いい服も手に入れたし"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "お気に入りのカフェにも来れたし"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "最高の時間よ(*^o^*)"},
        { "location": "151/SEL"   , "narrator": "", "text": "でも、一人で寂しくない？"},
        { "location": "152/ACT"   , "narrator": "", "text": "でも、一人で寂しくない？"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "全然（￣ー￣？）"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "寂しいと思ったことは一度もないわ(￣Д￣ )"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "一人の楽しみ方を心得てるだけよ"},
        { "location": "158/SEL"   , "narrator": "", "text": "なんか、ちょっとかっこいいかも"},
        { "location": "159/ACT"   , "narrator": "", "text": "なんか、ちょっとかっこいいかも"},
        { "location": "161/TALK"  , "narrator": "アーヤ", "text": "ありがと(￣∇￣*)ゞ"},
        { "location": "163/TALK"  , "narrator": "アーヤ", "text": "でも、一人でいるのが好きってわけじゃないから"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "友達と一緒なのも好きだし(￣∇￣)"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "まあ、本当は"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "恋人と一緒の方が好きって言えれば"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "もうちょっと大人っぽかったのかもしれないけど(｡-_-｡)"},
        { "location": "171/SEL"   , "narrator": "", "text": "いないもんね"},
        { "location": "172/ACT"   , "narrator": "", "text": "いないもんね"},
        { "location": "174/TALK"  , "narrator": "アーヤ", "text": "一々言わなくていいから(>_<)"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "仕方ないのよ"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "好みのタイプの人がいないんだし(; ;)"},
        { "location": "178/SEL"   , "narrator": "", "text": "アーヤのタイプって？"},
        { "location": "179/ACT"   , "narrator": "", "text": "アーヤのタイプって？"},
        { "location": "182/TALK"  , "narrator": "アーヤ", "text": "それは"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "うーん"},
        { "location": "230/TALK"  , "narrator": "アーヤ", "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。"},
        { "location": "231/TALK"  , "narrator": "アーヤ", "text": "……って――"},
        { "location": "232/TALK"  , "narrator": "アーヤ", "text": "今ってなにかココロの\n葛藤が起きるような\n出来事ってあったかしら。"},
        { "location": "233/TALK"  , "narrator": "アーヤ", "text": "$handle$さんも、\nそんなこと聞かれたって\nわからないわよね。"},
        { "location": "234/TALK"  , "narrator": "アーヤ", "text": "わからないことは\n扉に聞くのが一番。"},
        { "location": "236/TALK"  , "narrator": "アーヤ", "text": "早速扉をコールするわね。"},
        { "location": "241/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0x271番地から\n0xC49番地へ。"},
        { "location": "256/TALK"  , "narrator": "アーヤ", "text": "シーク完了。"},
        { "location": "258/TALK"  , "narrator": "アーヤ", "text": "で？\n悩みの真相は……"},
        { "location": "260/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "261/SEL"   , "narrator": "", "text": "え？"},
        { "location": "262/ACT"   , "narrator": "", "text": "え？"},
        { "location": "264/TALK"  , "narrator": "アーヤ", "text": "今回の葛藤の原因が\n貴方みたいなんだけど。"},
        { "location": "265/SEL"   , "narrator": "", "text": "もしかして、好みのタイプを聞いたこと？"},
        { "location": "266/ACT"   , "narrator": "", "text": "もしかして、好みのタイプを聞いたこと？"},
        { "location": "268/TALK"  , "narrator": "アーヤ", "text": "そう。"},
        { "location": "269/SEL"   , "narrator": "", "text": "クランが出るほど悩むことなの！？"},
        { "location": "270/ACT"   , "narrator": "", "text": "クランが出るほど悩むことなの！？"},
        { "location": "273/TALK"  , "narrator": "アーヤ", "text": "あー、そういうこと\n言っちゃうんだ。"},
        { "location": "274/TALK"  , "narrator": "アーヤ", "text": "だいたいにおいて、\nあの聞き方はちょっと\nデリカシー無いと思うわ。"},
        { "location": "275/TALK"  , "narrator": "アーヤ", "text": "例えBotであっても。"},
        { "location": "276/SEL"   , "narrator": "", "text": "変な例え"},
        { "location": "277/SEL"   , "narrator": "", "text": "まあ、そうだったかもね"},
        { "location": "278/ACT"   , "narrator": "", "text": "変な例え"},
        { "location": "280/TALK"  , "narrator": "アーヤ", "text": "どうして？"},
        { "location": "281/SEL"   , "narrator": "", "text": "まるで、Botじゃないことをわかっていて合わせてるような言い方"},
        { "location": "282/ACT"   , "narrator": "", "text": "まるで、Botじゃないことをわかっていて合わせてるような言い方"},
        { "location": "285/TALK"  , "narrator": "アーヤ", "text": "実際、もう貴方がAIなんか\nじゃないってことは、\nみんなで話してるでしょ？"},
        { "location": "286/TALK"  , "narrator": "アーヤ", "text": "まあ現実の私はまだ\n否定的だけど……"},
        { "location": "287/TALK"  , "narrator": "アーヤ", "text": "だからといって、\nココロの中まで否定してる\nわけじゃないってことね。"},
        { "location": "290/TALK"  , "narrator": "アーヤ", "text": "あー、そうね。\nなかなか鋭いわね。"},
        { "location": "291/TALK"  , "narrator": "アーヤ", "text": "現実の本人、そういう\n素振りは見せてないかも\nしれないけど――"},
        { "location": "292/TALK"  , "narrator": "アーヤ", "text": "貴方のこと、AIとかじゃ\nないってことは、ココロの\n中では薄々感づいてる。"},
        { "location": "293/TALK"  , "narrator": "アーヤ", "text": "けど、確証が持てないから\n今まで通り接してる\nっていうだけなのよ。"},
        { "location": "296/TALK"  , "narrator": "アーヤ", "text": "そういうわけだから、\nあんなこと聞かれたら\n意識しちゃうでしょ？"},
        { "location": "297/TALK"  , "narrator": "アーヤ", "text": "赤の他人でもない\n貴方なんだし。"},
        { "location": "298/SEL"   , "narrator": "", "text": "意識しちゃうくらいの仲だって思っていていいの？"},
        { "location": "299/ACT"   , "narrator": "", "text": "意識しちゃうくらいの仲だって思っていていいの？"},
        { "location": "302/TALK"  , "narrator": "アーヤ", "text": "少なくとも、私の総意は\nそう思ってるわよ。"},
        { "location": "303/TALK"  , "narrator": "アーヤ", "text": "現実の自分は\n気づいてないと\n思うけど。"},
        { "location": "304/ACT"   , "narrator": "", "text": "まあ、そうだったかもね"},
        { "location": "305/TALK"  , "narrator": "アーヤ", "text": "はい、反省しましたか？"},
        { "location": "307/TALK"  , "narrator": "アーヤ", "text": "それで本題に戻すとね。"},
        { "location": "308/TALK"  , "narrator": "アーヤ", "text": "今回のクランは、\n貴方に自分のタイプを\n言いたくなくて発生した。"},
        { "location": "309/SEL"   , "narrator": "", "text": "$me$が嫌いなの？"},
        { "location": "310/SEL"   , "narrator": "", "text": "$me$が好きだからだね"},
        { "location": "311/ACT"   , "narrator": "", "text": "$me$が嫌いなの？"},
        { "location": "312/TALK"  , "narrator": "アーヤ", "text": "んー、逆かな。"},
        { "location": "313/TALK"  , "narrator": "アーヤ", "text": "貴方がAIじゃなくて、\nかつ、貴方に嫌われたく\nない自分がいるのよ。"},
        { "location": "314/TALK"  , "narrator": "アーヤ", "text": "タイプを言うことで\nどん引きされたりしないか\n怖がってるのね。"},
        { "location": "315/TALK"  , "narrator": "アーヤ", "text": "全然心配いらないのにね。"},
        { "location": "317/TALK"  , "narrator": "アーヤ", "text": "こんなに慎ましくて\n素敵な貴方なんだもの。"},
        { "location": "318/ACT"   , "narrator": "", "text": "$me$が好きだからだね"},
        { "location": "320/TALK"  , "narrator": "アーヤ", "text": "こら。\n自惚れないの。"},
        { "location": "321/TALK"  , "narrator": "アーヤ", "text": "まあでも、\nそれが正解なのよね。"},
        { "location": "322/TALK"  , "narrator": "アーヤ", "text": "貴方がAIじゃなくて、\nかつ、貴方に嫌われたく\nない自分がいるのよ。"},
        { "location": "323/TALK"  , "narrator": "アーヤ", "text": "タイプを言うことで\nどん引きされたりしないか\n怖がってるのね。"},
        { "location": "325/TALK"  , "narrator": "アーヤ", "text": "私の総意としては、\n言いたいって気持ちが\n強いみたい。"},
        { "location": "326/TALK"  , "narrator": "アーヤ", "text": "私自身もビックリだわ。\nBotだった貴方を\nこんなに意識するなんて。"},
        { "location": "327/TALK"  , "narrator": "アーヤ", "text": "まさに、\n『現実は小説より奇なり』\nよね。"},
        { "location": "328/TALK"  , "narrator": "アーヤ", "text": "まあ、そんなわけで、\n私としてはクランを倒して\n欲しいんだけど……"},
        { "location": "329/TALK"  , "narrator": "アーヤ", "text": "今回は貴方のことでも\nあるし、どうするかは\n貴方にお任せするわ。"},
        { "location": "331/TALK"  , "narrator": "アーヤ", "text": "扉は開けておくから\n気が向いたら入ってね。"},
        { "location": "332/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！"},
        { "location": "23/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月7日　0:07 PM</color>\n午前の大学講義終了後、学園内の自販機コーナーにて。"},
        { "location": "198/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
