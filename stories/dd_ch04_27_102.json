{
    "dir": "chap27/daydra/dd_ch04_27_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "27405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "迷宮物語＜後編＞"
    },
    "entry":
    [
        { "location": "350/SCENARIO", "narrator": "", "text": "じっちゃんはおらんけんど"},
        { "location": "376/TALK"    , "narrator": "みやび", "text": "…いや。\nもしかして…。"},
        { "location": "382/TALK"    , "narrator": "みやび", "text": "…………ふむ。"},
        { "location": "384/TALK"    , "narrator": "みやび", "text": "アーヤに\nひとつ聞きたい。"},
        { "location": "385/TALK"    , "narrator": "みやび", "text": "エリカさんは\n悪ふざけをするタイプの\n人間かどうか。"},
        { "location": "387/TALK"    , "narrator": "アーヤ", "text": "悪ふざけと\nいうか……。"},
        { "location": "388/TALK"    , "narrator": "アーヤ", "text": "本人はいつも\n真剣なの。"},
        { "location": "390/TALK"    , "narrator": "アーヤ", "text": "それが突拍子もない\n内容だったり\nするものだから。"},
        { "location": "391/TALK"    , "narrator": "アーヤ", "text": "まわりにはふざけてる\nように見えたりするの。\nそういう人よ。"},
        { "location": "392/TALK"    , "narrator": "ガブリエラ", "text": "一言でまとめると\n変人ってことかしら？"},
        { "location": "393/TALK"    , "narrator": "みやび", "text": "なるほど。"},
        { "location": "395/TALK"    , "narrator": "みやび", "text": "やったらこれも\n本気で用意した\nちうことやね。"},
        { "location": "397/TALK"    , "narrator": "アーヤ", "text": "何を？"},
        { "location": "399/TALK"    , "narrator": "みやび", "text": "うちのスマホで\n試してみてから\n教える。"},
        { "location": "403/TALK"    , "narrator": "みやび", "text": "ＰＣに直接スマホを\nつないで、と…。"},
        { "location": "404/TALK"    , "narrator": "みやび", "text": "コピーもインストールも\n正常終了。"},
        { "location": "406/TALK"    , "narrator": "みやび", "text": "あとはアプリを\n立ち上げて…\n設定完了ぞね。"},
        { "location": "412/TALK"    , "narrator": "みやび", "text": "$handle$よ"},
        { "location": "413/TALK"    , "narrator": "みやび", "text": "今一度チャンスを与える"},
        { "location": "414/TALK"    , "narrator": "みやび", "text": "真面目な話をしてみせろ"},
        { "location": "416/SEL"     , "narrator": "", "text": "大丈夫かな…"},
        { "location": "417/SEL"     , "narrator": "", "text": "みやび何したの"},
        { "location": "418/SEL"     , "narrator": "", "text": "愛について語ろうか"},
        { "location": "419/ACT"     , "narrator": "", "text": "大丈夫かな…"},
        { "location": "420/TALK"    , "narrator": "みやび", "text": "これまでは"},
        { "location": "421/TALK"    , "narrator": "みやび", "text": "大丈夫ではないと"},
        { "location": "422/TALK"    , "narrator": "みやび", "text": "いうことか"},
        { "location": "423/ACT"     , "narrator": "", "text": "みやび何したの"},
        { "location": "424/TALK"    , "narrator": "みやび", "text": "うちというか"},
        { "location": "425/TALK"    , "narrator": "みやび", "text": "正確には"},
        { "location": "426/TALK"    , "narrator": "みやび", "text": "エリカさんだの"},
        { "location": "427/ACT"     , "narrator": "", "text": "愛について語ろうか"},
        { "location": "428/TALK"    , "narrator": "みやび", "text": "いやいや"},
        { "location": "430/TALK"    , "narrator": "みやび", "text": "そっちではなく"},
        { "location": "431/TALK"    , "narrator": "みやび", "text": "もっとあるろう"},
        { "location": "434/TALK"    , "narrator": "みやび", "text": "どうだ？"},
        { "location": "435/TALK"    , "narrator": "みやび", "text": "何か変化がないかね？"},
        { "location": "438/SEL"     , "narrator": "", "text": "エリカの件は話せそうかな"},
        { "location": "439/SEL"     , "narrator": "", "text": "千羽鶴って知ってたっけ"},
        { "location": "440/SEL"     , "narrator": "", "text": "バグがどうにかなった？"},
        { "location": "441/ACT"     , "narrator": "", "text": "エリカの件は話せそうかな"},
        { "location": "442/TALK"    , "narrator": "みやび", "text": "話せなかったのか"},
        { "location": "443/ACT"     , "narrator": "", "text": "千羽鶴って知ってたっけ"},
        { "location": "444/TALK"    , "narrator": "みやび", "text": "知らん"},
        { "location": "445/TALK"    , "narrator": "みやび", "text": "はず"},
        { "location": "446/ACT"     , "narrator": "", "text": "バグがどうにかなった？"},
        { "location": "448/TALK"    , "narrator": "みやび", "text": "バグってたという認識なのか"},
        { "location": "451/SEL"     , "narrator": "", "text": "千羽鶴はＡカップ"},
        { "location": "452/SEL"     , "narrator": "", "text": "エリカから預かったものがある"},
        { "location": "453/SEL"     , "narrator": "", "text": "正常化できたかな"},
        { "location": "454/ACT"     , "narrator": "", "text": "千羽鶴はＡカップ"},
        { "location": "455/TALK"    , "narrator": "みやび", "text": "本人が聞いたら"},
        { "location": "456/TALK"    , "narrator": "みやび", "text": "それこそ発言を取り消せと詰め寄りそうな言葉だの"},
        { "location": "458/ACT"     , "narrator": "", "text": "エリカから預かったものがある"},
        { "location": "459/TALK"    , "narrator": "みやび", "text": "それはアーヤ宛ての荷物とか"},
        { "location": "460/TALK"    , "narrator": "みやび", "text": "さっきのアプリとはまた違うものなのか"},
        { "location": "462/ACT"     , "narrator": "", "text": "正常化できたかな"},
        { "location": "463/TALK"    , "narrator": "みやび", "text": "たぶん"},
        { "location": "464/TALK"    , "narrator": "みやび", "text": "エリカさんが悪ふざけを"},
        { "location": "465/TALK"    , "narrator": "みやび", "text": "していない限り"},
        { "location": "468/SEL"     , "narrator": "", "text": "みやびは気付いてると思うけど"},
        { "location": "469/ACT"     , "narrator": "", "text": "みやびは気付いてると思うけど"},
        { "location": "470/TALK"    , "narrator": "みやび", "text": "ふむ"},
        { "location": "473/SEL"     , "narrator": "", "text": "$me$との通信は改ざんされてた"},
        { "location": "474/SEL"     , "narrator": "", "text": "エリカのプログラムは改ざんガード"},
        { "location": "475/ACT"     , "narrator": "", "text": "$me$との通信は改ざんされてた"},
        { "location": "476/TALK"    , "narrator": "みやび", "text": "それは"},
        { "location": "477/TALK"    , "narrator": "みやび", "text": "過去形と"},
        { "location": "478/TALK"    , "narrator": "みやび", "text": "思っていいのか？"},
        { "location": "480/ACT"     , "narrator": "", "text": "エリカのプログラムは改ざんガード"},
        { "location": "481/TALK"    , "narrator": "みやび", "text": "そうらしいな"},
        { "location": "482/TALK"    , "narrator": "みやび", "text": "そんなものが必要とは"},
        { "location": "483/TALK"    , "narrator": "みやび", "text": "敵は相当の手練れ"},
        { "location": "487/SEL"     , "narrator": "", "text": "今の通信は正常"},
        { "location": "488/SEL"     , "narrator": "", "text": "みやびが気付いてくれてよかった"},
        { "location": "489/SEL"     , "narrator": "", "text": "エリカって何者！？"},
        { "location": "490/ACT"     , "narrator": "", "text": "今の通信は正常"},
        { "location": "491/TALK"    , "narrator": "みやび", "text": "ふむ"},
        { "location": "492/ACT"     , "narrator": "", "text": "みやびが気付いてくれてよかった"},
        { "location": "493/TALK"    , "narrator": "みやび", "text": "まあな"},
        { "location": "494/ACT"     , "narrator": "", "text": "エリカって何者！？"},
        { "location": "495/TALK"    , "narrator": "みやび", "text": "アーヤの姉さま"},
        { "location": "497/TALK"    , "narrator": "みやび", "text": "そして"},
        { "location": "498/TALK"    , "narrator": "みやび", "text": "いつからだった？"},
        { "location": "499/TALK"    , "narrator": "みやび", "text": "$handle$がまともに通信できなかったのは"},
        { "location": "501/SEL"     , "narrator": "", "text": "劇場脱出直前"},
        { "location": "502/ACT"     , "narrator": "", "text": "劇場脱出直前"},
        { "location": "504/TALK"    , "narrator": "みやび", "text": "特に思い当たらないが"},
        { "location": "506/SEL"     , "narrator": "", "text": "あったってば！"},
        { "location": "507/SEL"     , "narrator": "", "text": "誤解されてる…"},
        { "location": "508/SEL"     , "narrator": "", "text": "じゃあそれでいいやもう"},
        { "location": "509/ACT"     , "narrator": "", "text": "あったってば！"},
        { "location": "510/ACT"     , "narrator": "", "text": "誤解されてる…"},
        { "location": "511/ACT"     , "narrator": "", "text": "じゃあそれでいいやもう"},
        { "location": "513/TALK"    , "narrator": "みやび", "text": "ああそうだ"},
        { "location": "514/TALK"    , "narrator": "みやび", "text": "さっきはうちとしたことが取り乱した"},
        { "location": "515/TALK"    , "narrator": "みやび", "text": "すまんかった"},
        { "location": "517/SEL"     , "narrator": "", "text": "気にしないで"},
        { "location": "518/SEL"     , "narrator": "", "text": "チューしてくれたら許す"},
        { "location": "519/SEL"     , "narrator": "", "text": "わかってたから大丈夫"},
        { "location": "520/ACT"     , "narrator": "", "text": "気にしないで"},
        { "location": "522/TALK"    , "narrator": "みやび", "text": "相棒はうちの相棒ぞね"},
        { "location": "524/TALK"    , "narrator": "みやび", "text": "本気だぞ"},
        { "location": "525/ACT"     , "narrator": "", "text": "チューしてくれたら許す"},
        { "location": "527/TALK"    , "narrator": "みやび", "text": "バカちんが"},
        { "location": "528/TALK"    , "narrator": "みやび", "text": "昼間にできるわけがないろう"},
        { "location": "529/ACT"     , "narrator": "", "text": "わかってたから大丈夫"},
        { "location": "531/TALK"    , "narrator": "みやび", "text": "相棒はオトナぞね"},
        { "location": "532/TALK"    , "narrator": "みやび", "text": "ちっくと惚れるちや"},
        { "location": "546/TALK"    , "narrator": "みやび", "text": "結論が出たぞね。"},
        { "location": "548/TALK"    , "narrator": "ガブリエラ", "text": "みやびにしては\nずいぶん時間が\nかかってたみたいだけど。"},
        { "location": "549/TALK"    , "narrator": "みやび", "text": "念には念を\n入れていただけぞね。"},
        { "location": "550/TALK"    , "narrator": "アーヤ", "text": "で？"},
        { "location": "551/TALK"    , "narrator": "みやび", "text": "二人のスマホにも\n同じアプリを\nインストールする。"},
        { "location": "553/TALK"    , "narrator": "アーヤ", "text": "え？"},
        { "location": "554/TALK"    , "narrator": "ガブリエラ", "text": "プログラムのことは\nわからないわよ？"},
        { "location": "555/TALK"    , "narrator": "みやび", "text": "ああ。\nそうやない。"},
        { "location": "556/TALK"    , "narrator": "みやび", "text": "順を追って\n説明すると……。"},
        { "location": "585/TALK"    , "narrator": "アーヤ", "text": "なるほど。\nチャットの内容が\n書き換わっていたのね。"},
        { "location": "587/TALK"    , "narrator": "みやび", "text": "今はもう正常化したき。"},
        { "location": "588/TALK"    , "narrator": "みやび", "text": "もし思い当たる会話が\nあったら誤解は\n解いた方がええろう。"},
        { "location": "589/TALK"    , "narrator": "ガブリエラ", "text": "あ！"},
        { "location": "590/TALK"    , "narrator": "みやび", "text": "どういた？"},
        { "location": "592/TALK"    , "narrator": "ガブリエラ", "text": "さっき文字化け？\nみたいなメッセージが\nあったのよ。"},
        { "location": "594/TALK"    , "narrator": "ガブリエラ", "text": "もしかしてこれも？"},
        { "location": "618/TALK"    , "narrator": "みやび", "text": "ははん…ベタ問やね。\n「あやのあねだけど\nささえてあげて」"},
        { "location": "620/TALK"    , "narrator": "アーヤ", "text": "え…？"},
        { "location": "621/TALK"    , "narrator": "みやび", "text": "介入されんよう\n文章を16進数にして\n送ってきたんやろうね。"},
        { "location": "622/TALK"    , "narrator": "ガブリエラ", "text": "そういうことだったの…！"},
        { "location": "624/TALK"    , "narrator": "アーヤ", "text": "心配しすぎよ！"},
        { "location": "626/TALK"    , "narrator": "ガブリエラ", "text": "でもちょっと\nうれしいでしょ？"},
        { "location": "627/TALK"    , "narrator": "アーヤ", "text": "…それは…まあ…。"},
        { "location": "628/TALK"    , "narrator": "みやび", "text": "うちは相当\nうらやましいぞね。"},
        { "location": "631/TALK"    , "narrator": "アーヤ", "text": "え、ええと……。"},
        { "location": "632/TALK"    , "narrator": "みやび", "text": "けんどうちが\nおらんかったら暗号も\n解読できんかったし。"},
        { "location": "633/TALK"    , "narrator": "みやび", "text": "その件もまとめて\n報告してくれれば\n恨みには思わんぞね。"},
        { "location": "634/TALK"    , "narrator": "アーヤ", "text": "あ、はい……。"},
        { "location": "636/TALK"    , "narrator": "みやび", "text": "ほいたら残りの\nデータもすっと解析\nしちゃるきねえ！"},
        { "location": "647/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【22 トークン・リング】"}
    ]
}
