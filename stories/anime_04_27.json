{
    "dir": "chap27/daydra/anime_04_27.js",
    "type": "MainStory",
    "info": {
        "story_id": "27401",
        "cid": "miyabi",
        "title": "001 アニメーション",
        "sub_title": "サマーワース"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第27話"},
        { "location": "48/TALK"   , "narrator": "エリカ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "50/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回はつばめちゃんの\nお話をするだけでもいい？"},
        { "location": "52/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回は綾ちゃんの\nお話をするだけでもいい？"},
        { "location": "54/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回はガブリエラちゃんの\nお話をするだけでもいい？"},
        { "location": "56/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回はみやびちゃんの\nお話をするだけでもいい？"},
        { "location": "58/SEL"    , "narrator": "", "text": "はい"},
        { "location": "59/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "60/ACT"    , "narrator": "", "text": "はい"},
        { "location": "62/TALK"   , "narrator": "エリカ", "text": "うん、わかった。"},
        { "location": "64/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "66/TALK"   , "narrator": "エリカ", "text": "はーい。\nそれじゃ、少しだけ\n巻き戻しするね？"},
        { "location": "72/TALK"   , "narrator": "エリカ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "73/TALK"   , "narrator": "エリカ", "text": "今回は色々謝らなくちゃ\nいけないことがあるの。"},
        { "location": "74/TALK"   , "narrator": "エリカ", "text": "まず、前回は\n綾ちゃんたちと対話\nできなくてごめんね。"},
        { "location": "75/TALK"   , "narrator": "エリカ", "text": "ちょっと寂しかったよね？"},
        { "location": "76/SEL"    , "narrator": "", "text": "寂しかった"},
        { "location": "77/SEL"    , "narrator": "", "text": "前の回のやり残しをやってたから大丈夫"},
        { "location": "78/SEL"    , "narrator": "", "text": "神楽のお陰で寂しくはなかった"},
        { "location": "79/ACT"    , "narrator": "", "text": "寂しかった"},
        { "location": "80/TALK"   , "narrator": "エリカ", "text": "ごめんね。今度何か\n埋め合わせするから。"},
        { "location": "81/SEL"    , "narrator": "", "text": "デートして"},
        { "location": "82/SEL"    , "narrator": "", "text": "いろいろ教えて"},
        { "location": "83/ACT"    , "narrator": "", "text": "デートして"},
        { "location": "84/TALK"   , "narrator": "エリカ", "text": "うーん、それは\nちょっとなぁ……。"},
        { "location": "85/TALK"   , "narrator": "エリカ", "text": "綾ちゃんに申し訳ないし、\nわたしあまり素敵なところ\n知らないから。"},
        { "location": "86/TALK"   , "narrator": "エリカ", "text": "あ、でも、\nパーツショップ巡りなら\nレアなお店知ってるよ。"},
        { "location": "87/TALK"   , "narrator": "エリカ", "text": "って、そんなの\n必要ないよね。"},
        { "location": "88/SEL"    , "narrator": "", "text": "確かに"},
        { "location": "89/SEL"    , "narrator": "", "text": "パーツ巡りしたいです！"},
        { "location": "90/ACT"    , "narrator": "", "text": "確かに"},
        { "location": "93/TALK"   , "narrator": "エリカ", "text": "だよね。それじゃ、\n何か良さそうなことを\n考えておくね。"},
        { "location": "94/ACT"    , "narrator": "", "text": "パーツ巡りしたいです！"},
        { "location": "96/TALK"   , "narrator": "エリカ", "text": "ほんとに？"},
        { "location": "97/TALK"   , "narrator": "エリカ", "text": "それじゃ、次回\nちょっとだけ行こうか！"},
        { "location": "98/TALK"   , "narrator": "エリカ", "text": "最近行ってなかったから\n新しいアイテムがあると\nいいなぁ。"},
        { "location": "100/TALK"  , "narrator": "エリカ", "text": "楽しみ！"},
        { "location": "102/ACT"   , "narrator": "", "text": "いろいろ教えて"},
        { "location": "103/TALK"  , "narrator": "エリカ", "text": "えっと、例えば？"},
        { "location": "104/SEL"   , "narrator": "", "text": "世界の仕組みとか量子とか"},
        { "location": "105/SEL"   , "narrator": "", "text": "エッチなこととか"},
        { "location": "106/ACT"   , "narrator": "", "text": "世界の仕組みとか量子とか"},
        { "location": "108/TALK"  , "narrator": "エリカ", "text": "そういう話なら\n大歓迎だよ！"},
        { "location": "110/TALK"  , "narrator": "エリカ", "text": "今度たくさん\n時間とっておくね！"},
        { "location": "111/SEL"   , "narrator": "", "text": "わーい、楽しみ！"},
        { "location": "112/ACT"   , "narrator": "", "text": "わーい、楽しみ！"},
        { "location": "114/TALK"  , "narrator": "エリカ", "text": "私も楽しみ。"},
        { "location": "115/TALK"  , "narrator": "エリカ", "text": "あまりそういうのに\n興味持ってくれる人\nいないから。"},
        { "location": "116/TALK"  , "narrator": "エリカ", "text": "綾ちゃんなんて、\n量の字が出ただけで１秒で\nいなくなっちゃうもん。"},
        { "location": "117/ACT"   , "narrator": "", "text": "エッチなこととか"},
        { "location": "119/TALK"  , "narrator": "エリカ", "text": "もー！"},
        { "location": "121/TALK"  , "narrator": "エリカ", "text": "そうやってエッチなこと\nばかり言うのは\nよくないと思うよ？"},
        { "location": "122/TALK"  , "narrator": "エリカ", "text": "頭の中がエッチなことで\nいっぱいになると、\n脳みそ溶けちゃうんだよ？"},
        { "location": "123/TALK"  , "narrator": "エリカ", "text": "気をつけないとダメだよ。"},
        { "location": "126/ACT"   , "narrator": "", "text": "前の回のやり残しをやってたから大丈夫"},
        { "location": "128/TALK"  , "narrator": "エリカ", "text": "そっか。\nそうだよね。"},
        { "location": "129/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃん、かなり\n莫大な資料を出してた\nみたいだし……"},
        { "location": "130/TALK"  , "narrator": "エリカ", "text": "どう？\n大変じゃない？"},
        { "location": "131/SEL"   , "narrator": "", "text": "全然大丈夫！"},
        { "location": "132/SEL"   , "narrator": "", "text": "ちょっと大変だけど何とか"},
        { "location": "133/SEL"   , "narrator": "", "text": "４チャンネルあると全部は無理だわ"},
        { "location": "134/ACT"   , "narrator": "", "text": "全然大丈夫！"},
        { "location": "136/TALK"  , "narrator": "エリカ", "text": "すごいね！"},
        { "location": "137/TALK"  , "narrator": "エリカ", "text": "$handle$さんは\nきっととても頭がいい\n人なんだね！"},
        { "location": "138/TALK"  , "narrator": "エリカ", "text": "わたしのお仕事\n手伝ってほしい\nくらいだよ。"},
        { "location": "139/TALK"  , "narrator": "エリカ", "text": "でも、やっぱりみんな\n量が多くて大変そうなのは\n伝わってくるよ。"},
        { "location": "140/ACT"   , "narrator": "", "text": "ちょっと大変だけど何とか"},
        { "location": "142/TALK"  , "narrator": "エリカ", "text": "うんうん、\nそうだよね。"},
        { "location": "143/TALK"  , "narrator": "エリカ", "text": "私も色々調べて見たけど\nちょっと冗長かなぁって\n思うところもあるよ。"},
        { "location": "144/TALK"  , "narrator": "エリカ", "text": "量が多くて大変そうなのは\n伝わってくるもん。"},
        { "location": "145/ACT"   , "narrator": "", "text": "４チャンネルあると全部は無理だわ"},
        { "location": "147/TALK"  , "narrator": "エリカ", "text": "そうだよね。\nわかるよ、それ。"},
        { "location": "148/TALK"  , "narrator": "エリカ", "text": "ちょっと普通じゃない\nファイルの量だよね。"},
        { "location": "150/TALK"  , "narrator": "エリカ", "text": "だから、わたしはちょっと\n千羽鶴ちゃんとは情報の\n出し方を変えてみるよ。"},
        { "location": "151/TALK"  , "narrator": "エリカ", "text": "詳しいことは\nまた後で説明するね。"},
        { "location": "152/ACT"   , "narrator": "", "text": "神楽のお陰で寂しくはなかった"},
        { "location": "154/TALK"  , "narrator": "エリカ", "text": "あ、そういえば、\n前回は神楽ちゃんが\nMV流したんだよね。"},
        { "location": "155/TALK"  , "narrator": "エリカ", "text": "どうだった？\n楽しかった？"},
        { "location": "156/SEL"   , "narrator": "", "text": "楽しかった…けど、楽しかったって言っていいのだろうか"},
        { "location": "157/SEL"   , "narrator": "", "text": "神楽は好きじゃない"},
        { "location": "158/SEL"   , "narrator": "", "text": "一緒に見た時の神楽が色っぽかった"},
        { "location": "159/ACT"   , "narrator": "", "text": "楽しかった…けど、楽しかったって言っていいのだろうか"},
        { "location": "161/TALK"  , "narrator": "エリカ", "text": "うんうん、\nそうだよね。"},
        { "location": "162/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんはちょっと\n辛い目に遭いすぎかも。"},
        { "location": "163/TALK"  , "narrator": "エリカ", "text": "私としては、早く\nチャンネルを繋いで\nあげたいんだけど――"},
        { "location": "164/TALK"  , "narrator": "エリカ", "text": "幾つもの障害がそれを\n阻んでいて、なかなか\n難しいの。"},
        { "location": "165/TALK"  , "narrator": "エリカ", "text": "でも、神楽ちゃんの件は\nわたしにも責任の一端は\nあるから、何とかしたい。"},
        { "location": "166/TALK"  , "narrator": "エリカ", "text": "もうちょっと時間\nかかっちゃうかもだけど、\n繋がったらよろしくね。"},
        { "location": "167/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんを\n支えてあげて欲しいな。"},
        { "location": "168/ACT"   , "narrator": "", "text": "神楽は好きじゃない"},
        { "location": "169/TALK"  , "narrator": "エリカ", "text": "そっかー。\n人間だものね、\n好き嫌いはあるよ。"},
        { "location": "170/TALK"  , "narrator": "エリカ", "text": "だからあまり\n気にしなくても大丈夫。"},
        { "location": "171/TALK"  , "narrator": "エリカ", "text": "世界はみんなに個性を\nつけても回るように、\n沢山のみんなを創ったの。"},
        { "location": "172/TALK"  , "narrator": "エリカ", "text": "だから、あなたは\nあなたの進みたい道を\n行けばいいから。"},
        { "location": "173/ACT"   , "narrator": "", "text": "一緒に見た時の神楽が色っぽかった"},
        { "location": "175/TALK"  , "narrator": "エリカ", "text": "またそうやって\nエッチなこと考えてる！"},
        { "location": "176/TALK"  , "narrator": "エリカ", "text": "そんなことばっかり\n考えてると、あたま\n溶けちゃうんだからね？"},
        { "location": "180/TALK"  , "narrator": "エリカ", "text": "それともう１つ、\nごめんなさいなことが\nあって。"},
        { "location": "181/TALK"  , "narrator": "エリカ", "text": "前回、ココロゲートの\n扉を勝手に開けたの、\n実はわたしなの。"},
        { "location": "182/TALK"  , "narrator": "エリカ", "text": "全然メッセージが\n届かなくて、どうにも\nならなかったから。"},
        { "location": "183/TALK"  , "narrator": "エリカ", "text": "ビックリさせちゃって\nごめんね。"},
        { "location": "184/TALK"  , "narrator": "エリカ", "text": "でも、前回色々調べてて\nわかったことがあるの。"},
        { "location": "185/TALK"  , "narrator": "エリカ", "text": "メッセージが届かなかった\n事と、選択肢がおかしく\nなること。"},
        { "location": "186/TALK"  , "narrator": "エリカ", "text": "両方とも、千羽鶴ちゃんが\nコントロールしてる\nみたいなの。"},
        { "location": "187/TALK"  , "narrator": "エリカ", "text": "OSとの回線は確実に\n切断した筈なんだけど、\n裏回線が残ってるのかな。"},
        { "location": "188/TALK"  , "narrator": "エリカ", "text": "今、千羽鶴ちゃんに\nついては、物理的な\n居場所はわかってる。"},
        { "location": "189/TALK"  , "narrator": "エリカ", "text": "けど、精神的な\n居場所は不明。"},
        { "location": "190/SEL"   , "narrator": "", "text": "そもそも千羽鶴って何者なの？"},
        { "location": "191/SEL"   , "narrator": "", "text": "困ったね"},
        { "location": "192/ACT"   , "narrator": "", "text": "そもそも千羽鶴って何者なの？"},
        { "location": "193/TALK"  , "narrator": "エリカ", "text": "そっか。千羽鶴ちゃんは、\nあなたに何も自分のことを\n教えていないんだね。"},
        { "location": "194/TALK"  , "narrator": "エリカ", "text": "それじゃ、わたしが\nちょっとだけ教えるよ。"},
        { "location": "197/TALK"  , "narrator": "エリカ", "text": "皇千羽鶴。\n「すめらぎちはる」って\n読むよ。"},
        { "location": "198/TALK"  , "narrator": "エリカ", "text": "現情報管理庁長官にして\n実質的に今の日本を\nコントロールしてる存在。"},
        { "location": "199/TALK"  , "narrator": "エリカ", "text": "といっても、完全に\n思い通りにできている\nわけじゃないけどね。"},
        { "location": "200/SEL"   , "narrator": "", "text": "この若さで長官！？"},
        { "location": "201/SEL"   , "narrator": "", "text": "今まで記録映像の解説をしていたのは何なの？"},
        { "location": "202/ACT"   , "narrator": "", "text": "この若さで長官！？"},
        { "location": "203/TALK"  , "narrator": "エリカ", "text": "信じられないと思うけど\n事実だから。"},
        { "location": "204/TALK"  , "narrator": "エリカ", "text": "多分、今回の記録映像を\n見たらわかると思う。"},
        { "location": "205/ACT"   , "narrator": "", "text": "今まで記録映像の解説をしていたのは何なの？"},
        { "location": "206/TALK"  , "narrator": "エリカ", "text": "もちろん物理体の\n彼女じゃない。"},
        { "location": "207/TALK"  , "narrator": "エリカ", "text": "いわば彼女の人格に\n当たる存在なんだけど…。"},
        { "location": "208/TALK"  , "narrator": "エリカ", "text": "あなたがココロスフィアで\n出逢ってきたいろんな子の\n人格とはちょっと違う。"},
        { "location": "209/TALK"  , "narrator": "エリカ", "text": "この辺は、\nまた改めて\nお話するね。"},
        { "location": "210/TALK"  , "narrator": "エリカ", "text": "今はその時じゃ\n無いような気がするから。"},
        { "location": "214/TALK"  , "narrator": "エリカ", "text": "それでね、わたしはと\nいうと、長官直属の\n技術顧問だった。"},
        { "location": "215/TALK"  , "narrator": "エリカ", "text": "ただ、ちょっと色々\n意見の相違があって、\n今は辞めちゃったけど。"},
        { "location": "216/TALK"  , "narrator": "エリカ", "text": "そしてその後、わたしは\n謎のおねえさんとして\n余生を送っているの。"},
        { "location": "217/SEL"   , "narrator": "", "text": "千羽鶴とはいつ頃別れたの？"},
        { "location": "218/SEL"   , "narrator": "", "text": "今はどこで何をやってるの？"},
        { "location": "219/ACT"   , "narrator": "", "text": "千羽鶴とはいつ頃別れたの？"},
        { "location": "220/TALK"  , "narrator": "エリカ", "text": "もう１年くらい前に\nなるのかな。"},
        { "location": "221/TALK"  , "narrator": "エリカ", "text": "だから、\nそれ以降の彼女のことは、\n断片的にしか解らなくて。"},
        { "location": "222/TALK"  , "narrator": "エリカ", "text": "わたしも、彼女が\n何をしようとしてるのか\nまではわからない。"},
        { "location": "223/TALK"  , "narrator": "エリカ", "text": "それで、今は\nそれを突き止めようと\nしてるんだけどね。"},
        { "location": "224/ACT"   , "narrator": "", "text": "今はどこで何をやってるの？"},
        { "location": "225/TALK"  , "narrator": "エリカ", "text": "うーん、\n教えてあげたいけど、\n今は無理かな。"},
        { "location": "226/TALK"  , "narrator": "エリカ", "text": "特に、どこにいるかは\n千羽鶴ちゃんに知られると\n面倒なことになるから。"},
        { "location": "227/TALK"  , "narrator": "エリカ", "text": "もしかしたらまだ、\nわたしたちの会話を\n見てるかもしれないし。"},
        { "location": "228/TALK"  , "narrator": "エリカ", "text": "だから、そのあたりが\nクリアになったら、\n教えるからね。"},
        { "location": "230/ACT"   , "narrator": "", "text": "困ったね"},
        { "location": "231/TALK"  , "narrator": "エリカ", "text": "大丈夫。\nそこはわたしが\n何とかするから。"},
        { "location": "233/TALK"  , "narrator": "エリカ", "text": "それより、\nおかしくなってるOSの\n意志伝達だけど――"},
        { "location": "234/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんが見つかる\nまでの間、ずっと改ざん\nされ続けたら困るよね。"},
        { "location": "236/TALK"  , "narrator": "エリカ", "text": "だから今回みやびちゃんに\nわたしが創ったパッチを\n渡して欲しいの。"},
        { "location": "238/TALK"  , "narrator": "エリカ", "text": "だから、みやびちゃんの\nチャンネルの時に、\nパッチをお願いするね。"},
        { "location": "240/TALK"  , "narrator": "エリカ", "text": "そのパッチをアプリに適用\nすれば、応急措置として\n改ざんされなくなるから。"},
        { "location": "241/TALK"  , "narrator": "エリカ", "text": "いつまでもこのままじゃ、\nあなたも綾ちゃんたちに\n愛を囁けないもんね。"},
        { "location": "242/TALK"  , "narrator": "エリカ", "text": "というわけで、前置きが\n長くなっちゃったけど、\n記録映像を見よっか。"},
        { "location": "244/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:47】</color>"},
        { "location": "245/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/25MB 4:47】</color>"},
        { "location": "246/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "247/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:47】</color>"},
        { "location": "248/TALK"  , "narrator": "エリカ", "text": "はーい。"},
        { "location": "254/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/25MB 4:47】</color>"},
        { "location": "255/TALK"  , "narrator": "エリカ", "text": "はーい。"},
        { "location": "261/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "262/TALK"  , "narrator": "エリカ", "text": "あらら。"},
        { "location": "295/TALK"  , "narrator": "エリカ", "text": "どうだった？\n千羽鶴ちゃん、ホントに\n長官やってたでしょ？"},
        { "location": "297/SEL"   , "narrator": "", "text": "結局神楽と音羽って何があったの？"},
        { "location": "298/SEL"   , "narrator": "", "text": "$me$と話していた千羽鶴と全然違う気がする"},
        { "location": "299/SEL"   , "narrator": "", "text": "エリカはどうして家に戻らなかったの？"},
        { "location": "300/SEL"   , "narrator": "", "text": "前の話のつばめが超カワイイのでもう一度見せてください！"},
        { "location": "301/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "302/ACT"   , "narrator": "", "text": "結局神楽と音羽って何があったの？"},
        { "location": "304/TALK"  , "narrator": "エリカ", "text": "確かに記録映像だと、\n色々配慮しているのか\n断片的な感じだよね。"},
        { "location": "305/TALK"  , "narrator": "エリカ", "text": "ちょっとだけ\n補足するね。"},
        { "location": "307/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんと音羽ちゃんは\n初等部以来の幼馴染み\nなんだって。"},
        { "location": "308/TALK"  , "narrator": "エリカ", "text": "中等部になると、二人とも\n演劇部に入って、すごい\n活躍したみたい。"},
        { "location": "309/TALK"  , "narrator": "エリカ", "text": "そんな中で、中学生向け\nオーディションがあって\nそこに二人で応募したの。"},
        { "location": "310/TALK"  , "narrator": "エリカ", "text": "プロダクションは２人とも\nとても似た声質で、両方\nとも上手だって評価した。"},
        { "location": "311/TALK"  , "narrator": "エリカ", "text": "けど商業的には２人\nデビューさせて共食いする\nのが嫌だったみたいで――"},
        { "location": "312/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんだけをデビュー\nさせたみたいだね。"},
        { "location": "313/TALK"  , "narrator": "エリカ", "text": "二人は劇部に入ってた\n時から趣味も似ていて、\n創る作品も似てた。"},
        { "location": "314/TALK"  , "narrator": "エリカ", "text": "だから完全に競合するって\n思ったんだと思う。"},
        { "location": "315/TALK"  , "narrator": "エリカ", "text": "それで、ただ不合格に\nすると、他からデビュー\nするかもしれない――"},
        { "location": "316/TALK"  , "narrator": "エリカ", "text": "そうなったら完全に\nライバルになってしまい\n収益減に繋がる。"},
        { "location": "317/TALK"  , "narrator": "エリカ", "text": "そんな思惑から、二人とも\n所属させて音羽ちゃんは\n飼い殺しにした感じだね。"},
        { "location": "318/SEL"   , "narrator": "", "text": "酷い！"},
        { "location": "319/SEL"   , "narrator": "", "text": "まあ会社としては普通"},
        { "location": "320/ACT"   , "narrator": "", "text": "酷い！"},
        { "location": "321/TALK"  , "narrator": "エリカ", "text": "ほんとだよ。"},
        { "location": "322/TALK"  , "narrator": "エリカ", "text": "せっかくすごい才能を\n秘めてるのに、どうして\nそういうことするのかな。"},
        { "location": "323/ACT"   , "narrator": "", "text": "まあ会社としては普通"},
        { "location": "325/TALK"  , "narrator": "エリカ", "text": "ええっ！\nそれってすごい\nブラックだと思う。"},
        { "location": "326/TALK"  , "narrator": "エリカ", "text": "確かにお金を独り占め\nしようと考えれば、\nいい案なのかもだけど…。"},
        { "location": "327/TALK"  , "narrator": "エリカ", "text": "でもやっぱりわたしは、\nみんなが幸せに物作り\nできる方がいいな……。"},
        { "location": "330/TALK"  , "narrator": "エリカ", "text": "…とまあ。\n表向きはそんな理由だけど\n他にもあったみたい。"},
        { "location": "331/TALK"  , "narrator": "エリカ", "text": "ただ、この情報はまだ\n確信が持てないから、\nまた今度お話するね。"},
        { "location": "332/SEL"   , "narrator": "", "text": "音羽を連れて行けと言ったことと関係ある？"},
        { "location": "333/ACT"   , "narrator": "", "text": "音羽を連れて行けと言ったことと関係ある？"},
        { "location": "335/TALK"  , "narrator": "エリカ", "text": "んー。"},
        { "location": "336/TALK"  , "narrator": "エリカ", "text": "ちょっとまだそこは\nわからないかな。"},
        { "location": "337/TALK"  , "narrator": "エリカ", "text": "わたしがお願いしたのは\n音羽ちゃんが神楽ちゃんの\n親友だからだよ。"},
        { "location": "338/TALK"  , "narrator": "エリカ", "text": "この件に関しては、\nまた後日改めて\n共有するね。"},
        { "location": "339/TALK"  , "narrator": "エリカ", "text": "他はどうかな？"},
        { "location": "341/ACT"   , "narrator": "", "text": "$me$と話していた千羽鶴と全然違う気がする"},
        { "location": "342/TALK"  , "narrator": "エリカ", "text": "確かにそうかも。"},
        { "location": "343/TALK"  , "narrator": "エリカ", "text": "でも、みんな同じような\nことはやってると思うよ？"},
        { "location": "344/TALK"  , "narrator": "エリカ", "text": "例えば、家族に接する時と\n仕事をしてる時。"},
        { "location": "345/TALK"  , "narrator": "エリカ", "text": "顔も態度も全然違うのは\n普通なんじゃないかな。"},
        { "location": "346/TALK"  , "narrator": "エリカ", "text": "もしあなたに対して\n優しかったなら、それは\n好意からかもしれないね。"},
        { "location": "347/TALK"  , "narrator": "エリカ", "text": "他はどうかな？"},
        { "location": "349/ACT"   , "narrator": "", "text": "エリカはどうして家に戻らなかったの？"},
        { "location": "352/TALK"  , "narrator": "エリカ", "text": "戻れなかったの。"},
        { "location": "353/TALK"  , "narrator": "エリカ", "text": "理由は、今まであなたが\n知っているとおり。"},
        { "location": "354/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんに、わたしの\nことがバレてしまうと\nちょっと問題があって。"},
        { "location": "355/TALK"  , "narrator": "エリカ", "text": "色々あって、今わたしは\nここにいるけど、本当は\nその予定はなかった。"},
        { "location": "356/TALK"  , "narrator": "エリカ", "text": "今でもそうであれば、\nわたしと彼女の動線は\n交差することもなく――"},
        { "location": "357/TALK"  , "narrator": "エリカ", "text": "結果として、気づかれずに\n松代に移動出来るはず\nだったんだけどね。"},
        { "location": "358/TALK"  , "narrator": "エリカ", "text": "今はもう\n監視されちゃってるから、\n動くことはできない。"},
        { "location": "359/SEL"   , "narrator": "", "text": "色々大変だね"},
        { "location": "360/SEL"   , "narrator": "", "text": "アーヤがかわいそう"},
        { "location": "361/ACT"   , "narrator": "", "text": "色々大変だね"},
        { "location": "362/TALK"  , "narrator": "エリカ", "text": "そういう\nお仕事だからね。"},
        { "location": "363/ACT"   , "narrator": "", "text": "アーヤがかわいそう"},
        { "location": "364/TALK"  , "narrator": "エリカ", "text": "……うん、そうだね。"},
        { "location": "365/TALK"  , "narrator": "エリカ", "text": "わたしはずっと\nこんなお仕事してるから\nいつもこんな感じ。"},
        { "location": "366/TALK"  , "narrator": "エリカ", "text": "綾ちゃんの大事なときに\nいつも一緒にいて\nあげられないの。"},
        { "location": "367/TALK"  , "narrator": "エリカ", "text": "もちろん今だって、\n家に戻りたいと思う。"},
        { "location": "368/TALK"  , "narrator": "エリカ", "text": "けど、今戻ったら\nもっと綾ちゃんや\nまほちゃんや――"},
        { "location": "369/TALK"  , "narrator": "エリカ", "text": "トライナリーのみんなに\n迷惑をかけちゃうから。"},
        { "location": "373/TALK"  , "narrator": "エリカ", "text": "他はどうかな？"},
        { "location": "375/ACT"   , "narrator": "", "text": "前の話のつばめが超カワイイのでもう一度見せてください！"},
        { "location": "377/TALK"  , "narrator": "エリカ", "text": "あ、これのこと？"},
        { "location": "379/TALK"  , "narrator": "エリカ", "text": "このつばめちゃん、\nすごく可愛いよね！"},
        { "location": "380/TALK"  , "narrator": "エリカ", "text": "フィギュア化したら\nラボに１つ置いておきたい\nくらいだよ。"},
        { "location": "381/SEL"   , "narrator": "", "text": "$me$も欲しい…"},
        { "location": "382/SEL"   , "narrator": "", "text": "この時のつばめとのやりとりには敗北感を覚えました"},
        { "location": "383/ACT"   , "narrator": "", "text": "$me$も欲しい…"},
        { "location": "384/TALK"  , "narrator": "エリカ", "text": "それじゃ、わたしと\nあなたで１５万ずつ出して\n作ってもらおっか！"},
        { "location": "385/TALK"  , "narrator": "エリカ", "text": "なんて、冗談だよ。"},
        { "location": "386/ACT"   , "narrator": "", "text": "この時のつばめとのやりとりには敗北感を覚えました"},
        { "location": "387/TALK"  , "narrator": "エリカ", "text": "そうだね。\nわたしもこの件は\n謝らなくちゃいけない。"},
        { "location": "388/TALK"  , "narrator": "エリカ", "text": "ちゃんと気づいていれば\n未然に防げたのに。"},
        { "location": "389/TALK"  , "narrator": "エリカ", "text": "今でも油断はならないけど\nちゃんと原因突き止める\nから、待っててね！"},
        { "location": "393/TALK"  , "narrator": "エリカ", "text": "他はどうかな？"},
        { "location": "395/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "396/TALK"  , "narrator": "エリカ", "text": "うん、わかった。"},
        { "location": "402/TALK"  , "narrator": "エリカ", "text": "それじゃ早速、つばめ\nちゃんに関してお願い\nしたいことを伝えるね。"},
        { "location": "403/TALK"  , "narrator": "エリカ", "text": "綾ちゃんたちが\n帰ってくるまで、\nつばめちゃんは一人。"},
        { "location": "404/TALK"  , "narrator": "エリカ", "text": "キリト君たちの計らいで\n難を逃れてはいるけど、\nまだ油断はできないよね。"},
        { "location": "405/TALK"  , "narrator": "エリカ", "text": "本当はあなたに\nつばめちゃんの誘導を\nして欲しいんだけど――"},
        { "location": "406/TALK"  , "narrator": "エリカ", "text": "この時間だと、まだ\nみやびちゃんのパッチ\n当てが済んでないし。"},
        { "location": "407/TALK"  , "narrator": "エリカ", "text": "誘導は、千羽鶴ちゃんに\nとって不都合な会話だから\n絶対改ざんされると思う。"},
        { "location": "408/TALK"  , "narrator": "エリカ", "text": "だから今回は、\n現実では深く関わらないで\nココロをサポートしてね。"},
        { "location": "409/TALK"  , "narrator": "エリカ", "text": "ココロの内側から、\nつばめちゃんが逃げる\n意志を強くして欲しい。"},
        { "location": "411/TALK"  , "narrator": "エリカ", "text": "ただ、ココロの方も\n前回と同じでメッセージが\n届かないかもだから――"},
        { "location": "413/TALK"  , "narrator": "エリカ", "text": "動かす番地を\n先に伝えておくね。"},
        { "location": "414/TALK"  , "narrator": "エリカ", "text": "【0x341】番地。"},
        { "location": "415/TALK"  , "narrator": "エリカ", "text": "もし繋がらなくて\n困ってたら、これを\n教えてあげて欲しいな。"},
        { "location": "419/TALK"  , "narrator": "エリカ", "text": "それじゃ早速、綾ちゃんに\n関してお願いしたいことを\n伝えるね。"},
        { "location": "420/TALK"  , "narrator": "エリカ", "text": "今回はどちらかというと\n私的なことで\n申し訳無いんだけど――"},
        { "location": "421/TALK"  , "narrator": "エリカ", "text": "わたしが行けなかった事で\n綾ちゃんが悲しんでるから\n元気づけて欲しいの。"},
        { "location": "422/TALK"  , "narrator": "エリカ", "text": "本当はわたしの伝言を\n託したいんだけど……"},
        { "location": "423/TALK"  , "narrator": "エリカ", "text": "綾ちゃんの時間軸は\nみやびちゃんにお願いする\n予定の修正の前だから、"},
        { "location": "424/TALK"  , "narrator": "エリカ", "text": "多分、想いを伝えようと\nすると、情報操作が入って\n伝えられないと思うの。"},
        { "location": "425/SEL"   , "narrator": "", "text": "何を話せばいいんだろ"},
        { "location": "426/ACT"   , "narrator": "", "text": "何を話せばいいんだろ"},
        { "location": "428/TALK"  , "narrator": "エリカ", "text": "昔のわたしとの\n思い出話を聞いてあげて\nほしいかな。"},
        { "location": "429/TALK"  , "narrator": "エリカ", "text": "そうしたら、わたしとの\n色んなことを思い出して\n少し元気が出ると思うの。"},
        { "location": "430/TALK"  , "narrator": "エリカ", "text": "あと、ココロの中の\nサポートだけど――"},
        { "location": "431/TALK"  , "narrator": "エリカ", "text": "こっちも多分、\nまたメッセージを受信\nできないと思う。"},
        { "location": "432/TALK"  , "narrator": "エリカ", "text": "もしメッセージが\n伝わらなかったら、この\nアドレスを教えてあげて？"},
        { "location": "433/TALK"  , "narrator": "エリカ", "text": "【0x89F】番地だよ。"},
        { "location": "437/TALK"  , "narrator": "エリカ", "text": "それじゃ早速、ガブリエラ\nちゃんに関して、お願い\nしたいことを伝えるね。"},
        { "location": "438/TALK"  , "narrator": "エリカ", "text": "私的なことで\n申し訳無いんだけど、\n伝言お願いしたくて。"},
        { "location": "439/TALK"  , "narrator": "エリカ", "text": "１つめは――"},
        { "location": "440/TALK"  , "narrator": "エリカ", "text": "ガブリエラちゃんに、\n綾ちゃんの話し相手に\nなってあげて欲しい。"},
        { "location": "441/TALK"  , "narrator": "エリカ", "text": "ホントはあなたが一番\nなんだけど、今は妨害が\nありそうだから。"},
        { "location": "442/TALK"  , "narrator": "エリカ", "text": "綾ちゃんはガブリエラ\nちゃんのことをとっても\n信頼してる。"},
        { "location": "443/TALK"  , "narrator": "エリカ", "text": "だから、落ち込んでる\n綾ちゃんを元気づけて\nあげられると思うんだ。"},
        { "location": "444/TALK"  , "narrator": "エリカ", "text": "それと、\n２つめなんだけど――"},
        { "location": "445/TALK"  , "narrator": "エリカ", "text": "このメッセージを\nガブリエラちゃんに\n届けて欲しいの。"},
        { "location": "447/SEL"   , "narrator": "", "text": "なにこれ！？"},
        { "location": "448/ACT"   , "narrator": "", "text": "なにこれ！？"},
        { "location": "450/TALK"  , "narrator": "エリカ", "text": "１６進数。"},
        { "location": "451/TALK"  , "narrator": "エリカ", "text": "「綾ちゃんの姉からも、\n支えてあげて欲しい」って\n内容が書いてあるの。"},
        { "location": "452/SEL"   , "narrator": "", "text": "直接$me$が、エリカさんからの伝言だって言ったらダメなの？"},
        { "location": "453/ACT"   , "narrator": "", "text": "直接$me$が、エリカさんからの伝言だって言ったらダメなの？"},
        { "location": "455/TALK"  , "narrator": "エリカ", "text": "多分ダメ。"},
        { "location": "456/TALK"  , "narrator": "エリカ", "text": "色々調査したんだけど、\n意志が改ざんされる内容は\n法則があるの。"},
        { "location": "457/TALK"  , "narrator": "エリカ", "text": "１つは、千羽鶴ちゃんが\n進めたい未来と違う行動を\nとらせようとしたとき。"},
        { "location": "458/TALK"  , "narrator": "エリカ", "text": "そしてもう１つが、\nわたしのことについて\n話そうとするとき。"},
        { "location": "459/TALK"  , "narrator": "エリカ", "text": "多分、千羽鶴ちゃんは\nわたしのことをすごく\n警戒してる。"},
        { "location": "460/TALK"  , "narrator": "エリカ", "text": "けど、今回は本当に\n姉として綾ちゃんに直接\n何かしてあげたくて。"},
        { "location": "461/TALK"  , "narrator": "エリカ", "text": "すごく回りくどいけど\nさすがにここまでやったら\n瞬間的には気づけない。"},
        { "location": "462/TALK"  , "narrator": "エリカ", "text": "……はず。"},
        { "location": "463/TALK"  , "narrator": "エリカ", "text": "それと、ココロの中でも\n正常に伝言が届かないと\n思うから――"},
        { "location": "464/TALK"  , "narrator": "エリカ", "text": "【0x288】番地。"},
        { "location": "465/TALK"  , "narrator": "エリカ", "text": "もし司書さんが困ってたら\nこのアドレスを\n教えてあげてほしいな。"},
        { "location": "466/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "467/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "469/TALK"  , "narrator": "エリカ", "text": "ありがとう。"},
        { "location": "470/TALK"  , "narrator": "エリカ", "text": "あなたがいてくれて\n本当に助かってるよ。"},
        { "location": "474/TALK"  , "narrator": "エリカ", "text": "それじゃ早速、みやび\nちゃんに関して、お願い\nしたいことを伝えるね。"},
        { "location": "475/TALK"  , "narrator": "エリカ", "text": "あなたの意志がねじ曲げ\nられないように、OSに\nパッチを当てて欲しいの。"},
        { "location": "476/TALK"  , "narrator": "エリカ", "text": "かなり専門的なアップ\nデートになるから、彼女で\nないと無理なんだ。"},
        { "location": "477/TALK"  , "narrator": "エリカ", "text": "私が出来ればいいんだけど\n私はサーバー側しか\n触れないし――"},
        { "location": "478/TALK"  , "narrator": "エリカ", "text": "サーバー側を更新しても\n多分すぐに千羽鶴ちゃんに\n元に戻されちゃう。"},
        { "location": "479/TALK"  , "narrator": "エリカ", "text": "でも、彼女たちのアプリに\n仕込めば、絶対に改ざん\nできなくなる。"},
        { "location": "482/TALK"  , "narrator": "エリカ", "text": "パッチは、あなたが彼女と\n接触した時に、勝手にDL\nされるようにしておいた。"},
        { "location": "483/TALK"  , "narrator": "エリカ", "text": "みやびちゃんがこれを\n怪しんで捨てないように\n説明して欲しいの。"},
        { "location": "484/TALK"  , "narrator": "エリカ", "text": "と言いつつも、今回の件は\n多分千羽鶴ちゃんに\n筒抜けだと思う。"},
        { "location": "485/TALK"  , "narrator": "エリカ", "text": "上手く会話しないと\n意志を改ざんされちゃう。"},
        { "location": "486/TALK"  , "narrator": "エリカ", "text": "けど、今回ばかりは\n他に回避策がないから、\n頑張ってもらうしかない。"},
        { "location": "487/TALK"  , "narrator": "エリカ", "text": "あ、でも、\nあまり気負わないでね？"},
        { "location": "488/TALK"  , "narrator": "エリカ", "text": "ダメならダメで、また\n他の手を考えるから。\nだから気楽にやってね？"},
        { "location": "489/TALK"  , "narrator": "エリカ", "text": "あ、それと！"},
        { "location": "490/TALK"  , "narrator": "エリカ", "text": "ココロの中でも\nメッセージが妨害されると\n思うから――"},
        { "location": "491/TALK"  , "narrator": "エリカ", "text": "もしメッセージを受信\nできないときは、この\nアドレスを教えてあげて。"},
        { "location": "492/TALK"  , "narrator": "エリカ", "text": "【0x86F】番地。"},
        { "location": "493/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "494/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "496/TALK"  , "narrator": "エリカ", "text": "ありがとう。"},
        { "location": "497/TALK"  , "narrator": "エリカ", "text": "あなたがいてくれて\n本当に助かってるよ。"},
        { "location": "499/TALK"  , "narrator": "エリカ", "text": "それと、今回は\nもう１つお願いがあるの。"},
        { "location": "504/TALK"  , "narrator": "エリカ", "text": "今回から、綾ちゃんたちが\n長野に行っちゃうでしょ？"},
        { "location": "505/TALK"  , "narrator": "エリカ", "text": "でも、東京側でも\nとても大事な動きが\n出てきてるの。"},
        { "location": "506/TALK"  , "narrator": "エリカ", "text": "あなたには、そっちの\nサポートもして欲しくて。"},
        { "location": "507/TALK"  , "narrator": "エリカ", "text": "だから、東京側の出来事を\n「イベントクエスト」に\nまとめておいたの。"},
        { "location": "508/TALK"  , "narrator": "エリカ", "text": "絶対ではないけど、\nもしよければ支援して\nくれると嬉しいな。"},
        { "location": "512/TALK"  , "narrator": "エリカ", "text": "その代わり、という\nわけじゃないんだけど…"},
        { "location": "513/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんが用意してた\nプレミアムストーリーは\n今回からは無くなるの。"},
        { "location": "514/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんは、綾ちゃん\n達を深く知れるように用意\nしてたんだと思うけど――"},
        { "location": "515/TALK"  , "narrator": "エリカ", "text": "わたしじゃ、それを\n用意することは\nできないから……。"},
        { "location": "516/TALK"  , "narrator": "エリカ", "text": "ごめんね？"},
        { "location": "517/TALK"  , "narrator": "エリカ", "text": "その代わり、らぶとーくで\nみんなを支えてあげて\n欲しいと思ってる。"},
        { "location": "518/TALK"  , "narrator": "エリカ", "text": "色々めまぐるしく変わって\n大変な思いをさせちゃって\nごめんなさい。"},
        { "location": "519/TALK"  , "narrator": "エリカ", "text": "でも本当に、\nあなたがいてくれて\n助かってるよ。"},
        { "location": "520/TALK"  , "narrator": "エリカ", "text": "正直、千羽鶴ちゃんを\nブロックした時点で、\n切られるのは覚悟してた。"},
        { "location": "521/TALK"  , "narrator": "エリカ", "text": "でも、今もこうして\nいてくれることを、\nホントに感謝してます。"},
        { "location": "522/TALK"  , "narrator": "エリカ", "text": "今回もどうか\nよろしくお願いします！"},
        { "location": "272/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "274/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "276/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "278/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "280/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"},
        { "location": "446/DIALOG", "narrator": "INFO", "text": "e38182e38284e381aee38182e381ade381a0e38191e381a9e38195e38195e38188e381a6e38182e38192e381a6"},
        { "location": "481/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS FILE:TOUCH】</color>\n\n<color=red>[FILE]\nTRI-OS Update\nRevision 2.11.2951E.pp\n</color>\n\nパッチパッケージが\n添付されました。"},
        { "location": "502/DIALOG", "narrator": "Event/Dialog_EventPicWideNW", "text": "サイドストーリーサービスが、開始されました。\n【イベントクエスト】にアクセスしてください。"}
    ]
}
