        { "location": "7/SCENARIO", "narrator": "", "text": "00-00_草いきれ"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "夏草の匂いが"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "するようになってきたわね"},
        { "location": "35/SEL"    , "narrator": "", "text": "そうだね"},
        { "location": "36/SEL"    , "narrator": "", "text": "そういうのわかんないけど"},
        { "location": "37/SEL"    , "narrator": "", "text": "そしてまた夏が来る"},
        { "location": "38/ACT"    , "narrator": "", "text": "そうだね"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "これからもっと暑くなるわね"},
        { "location": "40/ACT"    , "narrator": "", "text": "そういうのわかんないけど"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "そう"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "残念だわ"},
        { "location": "44/ACT"    , "narrator": "", "text": "そしてまた夏が来る"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "もう夏みたいな暑さの日もあるものね"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "夏草の匂いって"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "夏休みの気持ちを思い出す匂いよね"},
        { "location": "52/SEL"    , "narrator": "", "text": "カブトムシ取りに行こうぜ！"},
        { "location": "53/SEL"    , "narrator": "", "text": "そんな感じ"},
        { "location": "54/SEL"    , "narrator": "", "text": "都会っ子だからそういうのわかんないな"},
        { "location": "55/ACT"    , "narrator": "", "text": "カブトムシ取りに行こうぜ！"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "大学生にもなって"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "そんなことしないわよ"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "もー！"},
        { "location": "59/ACT"    , "narrator": "", "text": "そんな感じ"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "そうよね(￣Д￣ )"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "梅雨が明けたら"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "もう夏だしね"},
        { "location": "63/ACT"    , "narrator": "", "text": "都会っ子だからそういうのわかんないな"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "またそんなこと(--*;"},
