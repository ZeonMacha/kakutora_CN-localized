{
    "dir": "chap09/daydra/dd_ch01_09_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "9105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "激務日和＜後編＞"
    },
    "entry":
    [
        { "location": "400/SCENARIO", "narrator": "", "text": "激務日和"},
        { "location": "439/TALK"    , "narrator": "つばめ", "text": "ちょっと残念だけど"},
        { "location": "440/TALK"    , "narrator": "つばめ", "text": "今日は"},
        { "location": "441/TALK"    , "narrator": "つばめ", "text": "もぅバィトに行くよ"},
        { "location": "452/TALK"    , "narrator": "つばめ", "text": "…わかりました。"},
        { "location": "454/TALK"    , "narrator": "つばめ", "text": "そういうことだから、\nひなこちゃん。"},
        { "location": "455/TALK"    , "narrator": "つばめ", "text": "遊びに行くのは、\nまた今度でいいかな？"},
        { "location": "457/TALK"    , "narrator": "雛", "text": "えぇっ！？\nあ、いいけど、\nでも…。"},
        { "location": "458/TALK"    , "narrator": "神楽", "text": "はぁ…つばめさんが\nそう言うなら――"},
        { "location": "459/TALK"    , "narrator": "神楽", "text": "私も行かないわけには\nいきませんね。"},
        { "location": "462/TALK"    , "narrator": "つばめ", "text": "ごめんね。"},
        { "location": "463/TALK"    , "narrator": "つばめ", "text": "じゃあ、せんぱい。\n今日は色々教えて\nください！"},
        { "location": "465/TALK"    , "narrator": "ガブリエラ", "text": "し、仕方ないわね。\nそれじゃ、さっさと\n行くわよ。"},
        { "location": "467/TALK"    , "narrator": "つばめ", "text": "うん。\nみんな、また明日ね。"},
        { "location": "470/TALK"    , "narrator": "神楽", "text": "さようなら。"},
        { "location": "472/TALK"    , "narrator": "雛", "text": "あ、頑張ってねー！"},
        { "location": "489/TALK"    , "narrator": "キリト", "text": "…行っちまったな。"},
        { "location": "491/TALK"    , "narrator": "雛", "text": "うん…つばめちゃん、\n大丈夫かな？"},
        { "location": "493/TALK"    , "narrator": "ヒカル", "text": "心配ですか？"},
        { "location": "494/TALK"    , "narrator": "雛", "text": "そりゃそうだよー。\nもし私がつばめちゃん\nだったら――"},
        { "location": "495/TALK"    , "narrator": "雛", "text": "絶対怒ってケンカに\nなっちゃうもん。"},
        { "location": "498/TALK"    , "narrator": "みやび", "text": "…あれでも、\nつばめちゃん達の\nこと――"},
        { "location": "500/TALK"    , "narrator": "みやび", "text": "結構気に掛けての\n行動なんよ。"},
        { "location": "502/TALK"    , "narrator": "雛", "text": "えーっ、そうなん\nですか？"},
        { "location": "503/TALK"    , "narrator": "キリト", "text": "そんな風には\n見えなかったっす\nけど？"},
        { "location": "505/TALK"    , "narrator": "みやび", "text": "気に掛けてないん\nやったら――"},
        { "location": "506/TALK"    , "narrator": "みやび", "text": "自分も２時間も早く\nバイトに行ったりは\nせんよ。"},
        { "location": "507/TALK"    , "narrator": "みやび", "text": "つばめちゃんも、\n内心それに気付いて\nたき――"},
        { "location": "509/TALK"    , "narrator": "みやび", "text": "ガブちゃんを立てて\n言う通りにしたんや\nないかと思うがよ。"},
        { "location": "510/TALK"    , "narrator": "みやび", "text": "つばめちゃんは、\n相手を思いやれる\n優しい子やきね。"},
        { "location": "512/TALK"    , "narrator": "みやび", "text": "…ちくっと怖い時も\nあるけんど。"},
        { "location": "513/TALK"    , "narrator": "みやび", "text": "まあ、言うても\n出会うてからまだ\n一カ月程度やき――"},
        { "location": "515/TALK"    , "narrator": "みやび", "text": "うちの憶測満載や\nけんどな。"},
        { "location": "517/TALK"    , "narrator": "ヒカル", "text": "いえ…今の話、\nわかる気がします。"},
        { "location": "519/TALK"    , "narrator": "雛", "text": "なるほどねー。\nガブリエラちゃんは\nツンデレだったかー。"},
        { "location": "520/TALK"    , "narrator": "キリト", "text": "リアルツンデレとか、\n初めて見たぜ。"},
        { "location": "522/TALK"    , "narrator": "みやび", "text": "それ、ガブちゃんの\n前で言わんように\n気ぃつけてな。"},
        { "location": "524/TALK"    , "narrator": "みやび", "text": "ところで…あんたら、\nつばめちゃん達の\nお友達かの？"},
        { "location": "527/TALK"    , "narrator": "雛", "text": "いえす！"},
        { "location": "529/TALK"    , "narrator": "みやび", "text": "そうか…。\n男の子達に聞きたいん\nやけんど――"},
        { "location": "530/TALK"    , "narrator": "みやび", "text": "つばめちゃんと卯月、\nどっちが好み？"},
        { "location": "532/TALK"    , "narrator": "ヒカル", "text": "えっ！？\nきゅ、急に何ですか？"},
        { "location": "534/TALK"    , "narrator": "みやび", "text": "トライナリー新人\n人気コンテスト\nプログラムぞね。"},
        { "location": "539/TALK"    , "narrator": "キリト", "text": "いやー、俺としては\nみやび先輩の方が――"},
        { "location": "543/TALK"    , "narrator": "繭", "text": "ふんっ！"},
        { "location": "548/TALK"    , "narrator": "キリト", "text": "ぐはっ！？"},
        { "location": "551/TALK"    , "narrator": "みやび", "text": "…まあ、いずれ必要に\nなるかもしれんき――"},
        { "location": "552/TALK"    , "narrator": "みやび", "text": "うちから二人の\n攻略法教えたるき、\nよう聞きいや。"},
        { "location": "553/TALK"    , "narrator": "みやび", "text": "まず、つばめちゃん\nやけんど、あの子は\n簡単や。"},
        { "location": "556/TALK"    , "narrator": "みやび", "text": "鷹が兎を襲うが如し！"},
        { "location": "558/TALK"    , "narrator": "みやび", "text": "四の五の言われても\n無理やり押し倒し\nちゃれば――"},
        { "location": "559/TALK"    , "narrator": "みやび", "text": "嫌よ嫌よも好きの\nうちや。\nコロッと落ちるで。"},
        { "location": "562/TALK"    , "narrator": "キリト", "text": "そ、それって、\nマジっすか！？"},
        { "location": "564/TALK"    , "narrator": "ヒカル", "text": "いや、無理やりって、\nそれ問題だと思います\nけど…。"},
        { "location": "567/TALK"    , "narrator": "みやび", "text": "逆に、卯月の場合は\nこじゃんと難しい。\nナイトメアモードや。"},
        { "location": "568/TALK"    , "narrator": "みやび", "text": "見た感じ、人当たり\n良さそうやけんど――"},
        { "location": "569/TALK"    , "narrator": "みやび", "text": "一枚、仮面を\n被っちょる。"},
        { "location": "571/TALK"    , "narrator": "雛", "text": "えっ、そうなん\nですか！？"},
        { "location": "573/TALK"    , "narrator": "みやび", "text": "うちの分析はよく\n当たると評判やき。"},
        { "location": "574/TALK"    , "narrator": "みやび", "text": "まあ、その仮面の\n裏側にある本性は、\nうちにも予測不能や。"},
        { "location": "577/TALK"    , "narrator": "みやび", "text": "やき、もしアタック\nするなら――"},
        { "location": "578/TALK"    , "narrator": "みやび", "text": "そこも承知で\nかからんといかんよ。"},
        { "location": "579/TALK"    , "narrator": "ヒカル", "text": "は、はあ…。"},
        { "location": "582/TALK"    , "narrator": "みやび", "text": "ほな、うちもそろそろ\n行くきね。"},
        { "location": "585/TALK"    , "narrator": "繭", "text": "…寧ろ、私には――"},
        { "location": "586/TALK"    , "narrator": "繭", "text": "みやび先輩の攻略法を\n教えて欲しいです。"},
        { "location": "589/TALK"    , "narrator": "キリト", "text": "えっ！？\nおまえ、何言っちゃ\nってんの？"},
        { "location": "591/TALK"    , "narrator": "繭", "text": "は！？　何が！？"},
        { "location": "592/TALK"    , "narrator": "キリト", "text": "いや、今おまえ、\nみやび先輩の攻略法を\nなんとかって…。"},
        { "location": "594/TALK"    , "narrator": "繭", "text": "言ってません。"},
        { "location": "595/TALK"    , "narrator": "キリト", "text": "いや、言ってたって。\nなんかこう、乙女みた\nいな目をしてさあ。"},
        { "location": "597/TALK"    , "narrator": "繭", "text": "言ってないって\n言ってるだろ。"},
        { "location": "601/TALK"    , "narrator": "雛", "text": "そんなことより！\nつばめちゃん、\n大丈夫かなぁ？"},
        { "location": "603/TALK"    , "narrator": "ヒカル", "text": "何か心配なことでも\nあるんですか？"},
        { "location": "605/TALK"    , "narrator": "雛", "text": "もしかしたらだけど、\nつばめちゃんって――"},
        { "location": "606/TALK"    , "narrator": "雛", "text": "トライナリーの\nみんなに、イジメられ\nてるんじゃないかな？"},
        { "location": "609/TALK"    , "narrator": "キリト", "text": "う～ん…そうだなぁ。\nさっきのガブリエラの\n態度を見ると――"},
        { "location": "611/TALK"    , "narrator": "キリト", "text": "ありえねぇ、とは\n言えなそうだな。"},
        { "location": "613/TALK"    , "narrator": "雛", "text": "心配だなぁ。\nつばめちゃん、\n大丈夫かな？"},
        { "location": "615/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "616/TALK"    , "narrator": "繭", "text": "みやび先輩達に、\nイジメられる\n逢瀬さん、か…。"},
        { "location": "652/TALK"    , "narrator": "つばめ", "text": "ふぅ…こっちの床、\n拭き終わったよ。"},
        { "location": "654/TALK"    , "narrator": "神楽", "text": "凄く綺麗になって\nますね。"},
        { "location": "657/TALK"    , "narrator": "神楽", "text": "それに比べて、\n私の方は…痛っ！？"},
        { "location": "659/TALK"    , "narrator": "つばめ", "text": "どうしたの！？"},
        { "location": "661/TALK"    , "narrator": "神楽", "text": "て、手が、あかぎれで\n痛くて…。"},
        { "location": "662/TALK"    , "narrator": "つばめ", "text": "酷い…卯月さんは\nそっちで休んでて。"},
        { "location": "663/TALK"    , "narrator": "つばめ", "text": "こっちは、わたしが\n綺麗に拭くから！"},
        { "location": "665/TALK"    , "narrator": "神楽", "text": "ありがとうござい\nます、つばめさん。"},
        { "location": "666/TALK"    , "narrator": "つばめ", "text": "気にしないで。\n友達なんだから、\n困った時は――"},
        { "location": "669/TALK"    , "narrator": "ガブリエラ", "text": "こらー、新人！\nいつまでダラダラ\n掃除してんのよ！？"},
        { "location": "671/TALK"    , "narrator": "つばめ", "text": "ひっ！？\nが、ガブリエラ\nせんぱい！"},
        { "location": "674/TALK"    , "narrator": "ガブリエラ", "text": "ん～？　こら、新人！\nあんたの方、全然\n拭けてないじゃない！"},
        { "location": "676/TALK"    , "narrator": "つばめ", "text": "あ、それはその、\n卯月さんが――"},
        { "location": "678/TALK"    , "narrator": "神楽", "text": "怒らないでください！"},
        { "location": "680/TALK"    , "narrator": "神楽", "text": "つばめさんは、\nちょっと手際が\n悪いだけなんです。"},
        { "location": "683/TALK"    , "narrator": "つばめ", "text": "えぇっ！？\nち、違うよ！"},
        { "location": "685/TALK"    , "narrator": "つばめ", "text": "卯月さんのいる方が、\nわたしの拭いた\nところで――"},
        { "location": "688/TALK"    , "narrator": "ガブリエラ", "text": "問答無用！\n立ちなさい。\n根性入れてあげるわ。"},
        { "location": "691/TALK"    , "narrator": "つばめ", "text": "はわわ！"},
        { "location": "694/TALK"    , "narrator": "みやび", "text": "まあまあ、\nそれくらいに\nしてやり。"},
        { "location": "696/TALK"    , "narrator": "つばめ", "text": "み、みやび先輩！"},
        { "location": "698/TALK"    , "narrator": "ガブリエラ", "text": "もう、また新人を\n甘やかして！"},
        { "location": "699/TALK"    , "narrator": "つばめ", "text": "みやび先輩…、\nありがとうござい\nます！"},
        { "location": "701/TALK"    , "narrator": "みやび", "text": "それより、さっき服を\n畳んでおいて、って\n頼んだ件やけど――"},
        { "location": "703/TALK"    , "narrator": "みやび", "text": "畳み方、雑過ぎや\nせんか？"},
        { "location": "706/TALK"    , "narrator": "つばめ", "text": "あ、畳むのは全部、\n卯月さんが――"},
        { "location": "707/TALK"    , "narrator": "神楽", "text": "つばめさんが\n言ったんです！"},
        { "location": "709/TALK"    , "narrator": "神楽", "text": "どうせ着るものを、\nわざわざ畳む必要\nなんてない、って！"},
        { "location": "713/TALK"    , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "715/TALK"    , "narrator": "ガブリエラ", "text": "あ、あんたねぇ…。\n洗濯もまともに\nできないの！？"},
        { "location": "717/TALK"    , "narrator": "みやび", "text": "はぁ…仕方ない。\nつばめちゃん、\nちくっと動かんで。"},
        { "location": "723/TALK"    , "narrator": "つばめ", "text": "え…あっ。\n顔、撫でないで…。"},
        { "location": "724/TALK"    , "narrator": "みやび", "text": "つばめちゃんは\n超が付くレベルの\n問題児やき――"},
        { "location": "725/TALK"    , "narrator": "みやび", "text": "言葉だけじゃなくて、\n身体にも教えて\nやらんといかんね。"},
        { "location": "728/TALK"    , "narrator": "つばめ", "text": "か、身体に！？\nあっ、みやびさん…。"},
        { "location": "729/TALK"    , "narrator": "みやび", "text": "ほほぅ、思うてた\n以上にスベスベもち\nもちやな。"},
        { "location": "730/TALK"    , "narrator": "みやび", "text": "これは時間を掛けて、\nたっぷりレクチャー\nせんと勿体ないがよ。"},
        { "location": "734/TALK"    , "narrator": "つばめ", "text": "だ、ダメです。\nそんな…。"},
        { "location": "735/TALK"    , "narrator": "みやび", "text": "ほれ、うちに全てを\n任せるぞね…。"},
        { "location": "736/TALK"    , "narrator": "みやび", "text": "上、脱ごうか？"},
        { "location": "737/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "754/TALK"    , "narrator": "繭", "text": "違う！\nみやび先輩は、\nそんなことしない！"},
        { "location": "756/TALK"    , "narrator": "ヒカル", "text": "えっ！？\n繭さん、どうしたん\nですか？"},
        { "location": "759/TALK"    , "narrator": "繭", "text": "…何でもない。"},
        { "location": "760/TALK"    , "narrator": "キリト", "text": "なんか、違うこと\n想像してたんじゃ\nねぇか？"},
        { "location": "761/TALK"    , "narrator": "雛", "text": "まあ、冗談はともかく\nとして――"},
        { "location": "762/TALK"    , "narrator": "雛", "text": "任務以外にバイトも\nあるなんて、特別\n攻撃隊も大変だね。"},
        { "location": "764/TALK"    , "narrator": "ヒカル", "text": "そうですね。\n学校終わってからも\n仕事なんですから。"},
        { "location": "765/TALK"    , "narrator": "雛", "text": "あたし達も、\n手伝えることあれば\nいいんだけどなぁ…。"},
        { "location": "766/TALK"    , "narrator": "キリト", "text": "手伝うっつーか、\n俺もやりてぇよ。"},
        { "location": "767/TALK"    , "narrator": "キリト", "text": "小遣いだけじゃ、\n中々欲しい物も\n買えねぇしなぁ…。"},
        { "location": "769/TALK"    , "narrator": "雛", "text": "わかるわかる。\nやっぱバイトとか、\nしたいよねー。"},
        { "location": "770/TALK"    , "narrator": "雛", "text": "お小遣いだけだと、\n欲しい物も中々\n買えないし…。"},
        { "location": "772/TALK"    , "narrator": "ヒカル", "text": "戦艦や鉄道の模型は、\n高い物が多いです\nからね。"},
        { "location": "774/TALK"    , "narrator": "キリト", "text": "っ！？\nな、何でわかるん\nだよ！？"},
        { "location": "776/TALK"    , "narrator": "雛", "text": "まさかヒカルくん、\n超能力使いなの！？"},
        { "location": "779/TALK"    , "narrator": "ヒカル", "text": "あ、いえ、そういう\nことじゃなくて、\nえぇっと…。"},
        { "location": "782/TALK"    , "narrator": "繭", "text": "…ワンパターンって\n気付いてないのか。"},
        { "location": "793/DIALOG"  , "narrator": "Dialog_chapter_ch01", "text": "【07 愛，ロボット】"}
    ]
}
