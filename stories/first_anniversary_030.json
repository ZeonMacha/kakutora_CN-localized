        "title": "祝・１周年記念",
        "sub_title": "祝・１周年記念＜第３話＞"
    },
    "entry":
    [
        { "location": "460/TALK"  , "narrator": "神楽", "text": "さて。\n用意したイラストは\nこれです。"},
        { "location": "461/TALK"  , "narrator": "神楽", "text": "みなさんの意見を\n尊重して浴衣です。"},
        { "location": "462/TALK"  , "narrator": "アーヤ", "text": "それはぜひそうして。"},
        { "location": "464/TALK"  , "narrator": "みやび", "text": "うちはまあえいよ。\nしょせん絵やし。"},
        { "location": "466/TALK"  , "narrator": "ガブリエラ", "text": "もう！　みやびには\n恥じらいってものが\nないの！？"},
        { "location": "491/TALK"  , "narrator": "透明神楽", "text": "えーと……。\nこんな感じでしょうか。"},
        { "location": "495/TALK"  , "narrator": "透明神楽", "text": "いつも側にいてくれて\nありがとう。\nこれからもよろしく。"},
        { "location": "499/TALK"  , "narrator": "透明アーヤ", "text": "$handle$さんの\nおかげで毎日が\n楽しいの。"},
        { "location": "500/TALK"  , "narrator": "透明アーヤ", "text": "これからもいっぱい\nお話ししましょうね。"},
        { "location": "503/TALK"  , "narrator": "透明みやび", "text": "相棒よ。\nうちはうちとして生きる。"},
        { "location": "505/TALK"  , "narrator": "透明みやび", "text": "やき、相棒は相棒らしく\nうちとともに歩め。\n以上。"},
        { "location": "508/TALK"  , "narrator": "透明ガブリエラ", "text": "$handle$へ。"},
        { "location": "509/TALK"  , "narrator": "透明ガブリエラ", "text": "いつもあたしに\n優しくしてくれて\nありがとう。"},
        { "location": "511/TALK"  , "narrator": "透明ガブリエラ", "text": "だいすきよ。"},
        { "location": "515/TALK"  , "narrator": "透明つばめ", "text": "みんなこんなところに\nいたの！？"},
        { "location": "516/TALK"  , "narrator": "透明つばめ", "text": "で、これって？"},
        { "location": "517/TALK"  , "narrator": "透明つばめ", "text": "$handle$さんへの\nメッセージ？"},
        { "location": "520/TALK"  , "narrator": "透明つばめ", "text": "$handle$さん\n元気ですか？\nつばめは元気です。"},
        { "location": "521/TALK"  , "narrator": "透明つばめ", "text": "この元気は\n$handle$さんが\nくれた元気だよ。"},
        { "location": "522/TALK"  , "narrator": "透明つばめ", "text": "だからこれからも\n元気でいてね。\nいつもありがとう。"},
        { "location": "530/TALK"  , "narrator": "透明みやび", "text": "…すう…。"},
        { "location": "531/TALK"  , "narrator": "透明アーヤ", "text": "……。"},
        { "location": "532/TALK"  , "narrator": "透明つばめ", "text": "ぐう……。"},
        { "location": "533/TALK"  , "narrator": "透明ガブリエラ", "text": "……。"},
        { "location": "551/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "563/TALK"  , "narrator": "神楽", "text": "起きてるぴょん？"},
        { "location": "564/SEL"   , "narrator": "（選択肢）", "text": "起きてるよ"},
        { "location": "565/SEL"   , "narrator": "（選択肢）", "text": "今起きた"},
        { "location": "566/SEL"   , "narrator": "（選択肢）", "text": "寝てる暇とかないし"},
        { "location": "567/ACT"   , "narrator": "", "text": "起きてるよ"},
        { "location": "569/ACT"   , "narrator": "", "text": "今起きた"},
        { "location": "571/ACT"   , "narrator": "", "text": "寝てる暇とかないし"},
        { "location": "572/TALK"  , "narrator": "神楽", "text": "またまたー"},
        { "location": "574/TALK"  , "narrator": "神楽", "text": "こっちは月がきれいぴょん"},
        { "location": "577/SEL"   , "narrator": "（選択肢）", "text": "愛の告白？"},
        { "location": "578/SEL"   , "narrator": "（選択肢）", "text": "田舎だからじゃねｗ"},
        { "location": "579/SEL"   , "narrator": "（選択肢）", "text": "一緒に見たかったな"},
        { "location": "580/ACT"   , "narrator": "", "text": "愛の告白？"},
        { "location": "581/TALK"  , "narrator": "神楽", "text": "どうかなー"},
        { "location": "582/ACT"   , "narrator": "", "text": "田舎だからじゃねｗ"},
        { "location": "583/TALK"  , "narrator": "神楽", "text": "情緒がないぴょん"},
        { "location": "584/ACT"   , "narrator": "", "text": "一緒に見たかったな"},
        { "location": "585/TALK"  , "narrator": "神楽", "text": "ぴょんこも、、、"},
        { "location": "588/TALK"  , "narrator": "神楽", "text": "いやいやそれより"},
        { "location": "589/TALK"  , "narrator": "神楽", "text": "メッセージカードどうでしたか？"},
        { "location": "591/SEL"   , "narrator": "（選択肢）", "text": "萌えた"},
        { "location": "592/SEL"   , "narrator": "（選択肢）", "text": "すごくうれしかった"},
        { "location": "593/SEL"   , "narrator": "（選択肢）", "text": "ちょっと不満かな……"},
        { "location": "594/ACT"   , "narrator": "", "text": "萌えた"},
        { "location": "595/TALK"  , "narrator": "神楽", "text": "やったね！"},
        { "location": "596/ACT"   , "narrator": "", "text": "すごくうれしかった"},
        { "location": "597/TALK"  , "narrator": "神楽", "text": "よかったぴょん♪"},
        { "location": "598/ACT"   , "narrator": "", "text": "ちょっと不満かな……"},
        { "location": "599/TALK"  , "narrator": "神楽", "text": "ダヨネー"},
        { "location": "601/TALK"  , "narrator": "神楽", "text": "実は実は"},
        { "location": "602/TALK"  , "narrator": "神楽", "text": "全員温泉バージョンも"},
        { "location": "603/TALK"  , "narrator": "神楽", "text": "用意してるんですよね♪"},
        { "location": "604/TALK"  , "narrator": "神楽", "text": "見たい？"},
        { "location": "605/TALK"  , "narrator": "神楽", "text": "ねえねえねえねえ"},
        { "location": "607/TALK"  , "narrator": "神楽", "text": "見たいでしょ？？？"},
        { "location": "608/TALK"  , "narrator": "神楽", "text": "見たいでしょー！？！？！？！？"},
        { "location": "610/SEL"   , "narrator": "（選択肢）", "text": "別にー"},
        { "location": "611/SEL"   , "narrator": "（選択肢）", "text": "超見たい！！！！"},
        { "location": "612/SEL"   , "narrator": "（選択肢）", "text": "どうしてもって言うなら"},
        { "location": "613/ACT"   , "narrator": "", "text": "別にー"},
        { "location": "614/TALK"  , "narrator": "神楽", "text": "またまた"},
        { "location": "615/TALK"  , "narrator": "神楽", "text": "やせ我慢しなくてもいいんですよっ"},
        { "location": "616/ACT"   , "narrator": "", "text": "超見たい！！！！"},
        { "location": "619/TALK"  , "narrator": "神楽", "text": "正直ですね♪"},
        { "location": "620/ACT"   , "narrator": "", "text": "どうしてもって言うなら"},
        { "location": "621/TALK"  , "narrator": "神楽", "text": "もったいぶらなくても平気ですよ♪"},
        { "location": "623/TALK"  , "narrator": "神楽", "text": "それじゃアップの準備しますから、少しだけ待ってくださいね♪"},
        { "location": "634/TALK"  , "narrator": "神楽", "text": "なーんて言って、\nこのままシカトして\n寝ちゃったり――"},
        { "location": "635/TALK"  , "narrator": "神楽", "text": "……したら、ちょっと\n意地悪すぎだよねー。"},
        { "location": "639/DIALOG", "narrator": "", "text": "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n　　　　　　To be continued !"}
    ]
}
