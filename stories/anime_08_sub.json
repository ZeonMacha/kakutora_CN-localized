    "entry":
    [
        { "location": "473/SCENARIO", "narrator": "", "text": "アニメ第08話みやびサブ"},
        { "location": "475/SEL"     , "narrator": "", "text": "ところで、みやびの心配事は、千羽鶴的にはどうだったの？"},
        { "location": "476/ACT"     , "narrator": "", "text": "ところで、みやびの心配事は、千羽鶴的にはどうだったの？"},
        { "location": "478/TALK"    , "narrator": "千羽鶴", "text": "的中した。"},
        { "location": "479/SEL"     , "narrator": "", "text": "みやびが、つばめたちを信用していないってこと？"},
        { "location": "480/SEL"     , "narrator": "", "text": "みやびが、情報管理庁を信用していないってこと？"},
        { "location": "481/ACT"     , "narrator": "", "text": "みやびが、つばめたちを信用していないってこと？"},
        { "location": "482/ACT"     , "narrator": "", "text": "みやびが、情報管理庁を信用していないってこと？"},
        { "location": "485/TALK"    , "narrator": "千羽鶴", "text": "ええ、まあ。\nそんなところ。"},
        { "location": "486/TALK"    , "narrator": "千羽鶴", "text": "まあでも、\nしばらくは貴方の判断に\n委ねることにする。"},
        { "location": "487/TALK"    , "narrator": "千羽鶴", "text": "すぐに危機的状況に\nなるとは考えにくいし――"},
        { "location": "489/SEL"     , "narrator": "", "text": "今ときめいた"},
        { "location": "490/SEL"     , "narrator": "", "text": "今ゾッとした"},
        { "location": "491/ACT"     , "narrator": "", "text": "今ときめいた"},
        { "location": "493/TALK"    , "narrator": "千羽鶴", "text": "よかった。"},
        { "location": "494/TALK"    , "narrator": "千羽鶴", "text": "貴方が今想像したとおり、\n私は貴方のことを\n信頼してる。"},
        { "location": "496/TALK"    , "narrator": "千羽鶴", "text": "これからも、ちーのために\n頑張って働いてね？\nおねがい。"},
        { "location": "498/TALK"    , "narrator": "千羽鶴", "text": "24時間365日休むことなく。"},
        { "location": "499/ACT"     , "narrator": "", "text": "今ゾッとした"},
        { "location": "501/TALK"    , "narrator": "千羽鶴", "text": "あら、失礼ね。"},
        { "location": "502/TALK"    , "narrator": "千羽鶴", "text": "私がこうやって優しい顔を\nしながらも、実は裏で何か\n企んでいて――"},
        { "location": "503/TALK"    , "narrator": "千羽鶴", "text": "もう引き返せない所まで\n来たときに貴方に無理な\n要求を押しつけて――"},
        { "location": "504/TALK"    , "narrator": "千羽鶴", "text": "『そ、そんなこと\n　$me$にはできないよ！』"},
        { "location": "505/TALK"    , "narrator": "千羽鶴", "text": "『そう、ならば\n　彼女はこれでさよならね』"},
        { "location": "506/TALK"    , "narrator": "千羽鶴", "text": "『き、きたない！\n　汚いぞ千羽鶴！』"},
        { "location": "507/TALK"    , "narrator": "千羽鶴", "text": "『フッ…』"},
        { "location": "509/TALK"    , "narrator": "千羽鶴", "text": "なんてことを\n想像したりしてる？"},
        { "location": "510/SEL"     , "narrator": "", "text": "はい"},
        { "location": "511/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "512/SEL"     , "narrator": "", "text": "寧ろご褒美"},
        { "location": "513/ACT"     , "narrator": "", "text": "はい"},
        { "location": "514/TALK"    , "narrator": "千羽鶴", "text": "映画の見過ぎ。"},
        { "location": "515/TALK"    , "narrator": "千羽鶴", "text": "とはいえ、\nそういうのもちょっと\n面白いかもしれない…。"},
        { "location": "516/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "517/TALK"    , "narrator": "千羽鶴", "text": "そう…。\n勘が外れた。"},
        { "location": "518/TALK"    , "narrator": "千羽鶴", "text": "まあ、何を考えていたかは\n聞かないことにしておく。"},
        { "location": "519/ACT"     , "narrator": "", "text": "寧ろご褒美"},
        { "location": "520/TALK"    , "narrator": "千羽鶴", "text": "…もしかして貴方、\nドエム？"},
        { "location": "522/TALK"    , "narrator": "千羽鶴", "text": "いろんなこと\nしてあげたい。"}
    ]
}
