    "entry":
    [
        { "location": "203/SCENARIO", "narrator": "", "text": "05-02_姉なんていない"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "メッセージとか"},
        { "location": "229/TALK"    , "narrator": "アーヤ", "text": "そっちからくれてもいいのよ？"},
        { "location": "231/SEL"     , "narrator": "", "text": "じゃあ聞いていい？"},
        { "location": "232/SEL"     , "narrator": "", "text": "何の話をすればいいかな……"},
        { "location": "233/TALK"    , "narrator": "アーヤ", "text": "って"},
        { "location": "234/TALK"    , "narrator": "アーヤ", "text": "そういう機能はないのかな？"},
        { "location": "236/ACT"     , "narrator": "", "text": "じゃあ聞いていい？"},
        { "location": "246/TALK"    , "narrator": "アーヤ", "text": "もちろん(=^0^=)"},
        { "location": "247/TALK"    , "narrator": "アーヤ", "text": "何でも聞いて頂戴"},
        { "location": "248/ACT"     , "narrator": "", "text": "何の話をすればいいかな……"},
        { "location": "249/TALK"    , "narrator": "アーヤ", "text": "貴方がしたい話をすればいいの"},
        { "location": "250/TALK"    , "narrator": "アーヤ", "text": "難しいかしら？"},
        { "location": "253/SEL"     , "narrator": "", "text": "特にないかも"},
        { "location": "254/SEL"     , "narrator": "", "text": "考えとく"},
        { "location": "255/SEL"     , "narrator": "", "text": "お姉さんの話"},
        { "location": "256/ACT"     , "narrator": "", "text": "特にないかも"},
        { "location": "257/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "258/TALK"    , "narrator": "アーヤ", "text": "ないの(-.-;)"},
        { "location": "259/TALK"    , "narrator": "アーヤ", "text": "じゃあ仕方ないわね"},
        { "location": "261/ACT"     , "narrator": "", "text": "考えとく"},
        { "location": "262/TALK"    , "narrator": "アーヤ", "text": "そう"},
        { "location": "263/TALK"    , "narrator": "アーヤ", "text": "じゃあ"},
        { "location": "264/TALK"    , "narrator": "アーヤ", "text": "またね"},
        { "location": "266/ACT"     , "narrator": "", "text": "お姉さんの話"},
        { "location": "278/TALK"    , "narrator": "アーヤ", "text": "え？"},
        { "location": "279/TALK"    , "narrator": "アーヤ", "text": "私"},
        { "location": "280/TALK"    , "narrator": "アーヤ", "text": "姉なんていないわよ"},
        { "location": "283/SEL"     , "narrator": "", "text": "ウソはよくないよ"},
        { "location": "284/SEL"     , "narrator": "", "text": "いると思ったけど……"},
        { "location": "285/SEL"     , "narrator": "", "text": "そういうことにしておくね"},
        { "location": "286/ACT"     , "narrator": "", "text": "ウソはよくないよ"},
        { "location": "287/TALK"    , "narrator": "アーヤ", "text": "嘘なんかないわよ"},
        { "location": "289/TALK"    , "narrator": "アーヤ", "text": "そっちこそ"},
        { "location": "290/TALK"    , "narrator": "アーヤ", "text": "当てずっぽうなんでしょ？"},
        { "location": "293/TALK"    , "narrator": "アーヤ", "text": "って"},
        { "location": "294/TALK"    , "narrator": "アーヤ", "text": "プログラムにむきになる必要なんて無いわよね"},
        { "location": "297/TALK"    , "narrator": "アーヤ", "text": "ええと"},
        { "location": "298/TALK"    , "narrator": "アーヤ", "text": "私には姉はいないから"},
        { "location": "299/TALK"    , "narrator": "アーヤ", "text": "ちゃんと覚えておいてね"},
        { "location": "300/TALK"    , "narrator": "アーヤ", "text": "よろしく！"},
        { "location": "301/ACT"     , "narrator": "", "text": "いると思ったけど……"},
        { "location": "302/TALK"    , "narrator": "アーヤ", "text": "いないったらいないし"},
        { "location": "303/TALK"    , "narrator": "アーヤ", "text": "なんで"},
        { "location": "305/TALK"    , "narrator": "アーヤ", "text": "そんなこと言うわけ？"},
        { "location": "306/TALK"    , "narrator": "アーヤ", "text": "って"},
        { "location": "307/TALK"    , "narrator": "アーヤ", "text": "botが知ってるわけなかったわねヽ(´o｀；"},
        { "location": "310/TALK"    , "narrator": "アーヤ", "text": "ハッキリさせておくわね"},
        { "location": "311/TALK"    , "narrator": "アーヤ", "text": "私には姉はいない(￣Д￣ )"},
        { "location": "312/TALK"    , "narrator": "アーヤ", "text": "メモリーしておいてね"},
        { "location": "313/ACT"     , "narrator": "", "text": "そういうことにしておくね"},
        { "location": "325/TALK"    , "narrator": "アーヤ", "text": "なんなのかしら"},
        { "location": "326/TALK"    , "narrator": "アーヤ", "text": "この空気の読み方、、、"},
        { "location": "327/TALK"    , "narrator": "アーヤ", "text": "みんなとの会話聞いてたりする？"},
        { "location": "328/TALK"    , "narrator": "アーヤ", "text": "って"},
        { "location": "329/TALK"    , "narrator": "アーヤ", "text": "いつも立ち上げてるわけじゃないものね、、、"},
        { "location": "330/TALK"    , "narrator": "アーヤ", "text": "トライガジェット"},
        { "location": "331/TALK"    , "narrator": "アーヤ", "text": "うまいロジックを組んであるのね"},
        { "location": "332/TALK"    , "narrator": "アーヤ", "text": "有望ね"},
        { "location": "333/TALK"    , "narrator": "アーヤ", "text": "誉めてあげる"},
        { "location": "335/TALK"    , "narrator": "アーヤ", "text": "偉いわね(^ε^)-☆!!"},
        { "location": "242/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "272/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "319/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
