        "title": "002 メインストーリー",
        "sub_title": "大胆勝負～Case1～＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "大胆勝負"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "はふぅ、\n少しのぼせちゃった\nかも…。"},
        { "location": "33/TALK"   , "narrator": "神楽", "text": "あっ、本当ですね。\n少し顔が赤いですよ？"},
        { "location": "34/TALK"   , "narrator": "神楽", "text": "熱かったなら、\n先に上がってても\nよかったのに…。"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "えへへ、卯月さんと\n一緒に入ってるのが、\n何だか嬉しくて――"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "今まで熱かったの\n気付かなかった\nみたい。"},
        { "location": "42/TALK"   , "narrator": "神楽", "text": "ふふっ、つばめさん\nったら…。"},
        { "location": "44/TALK"   , "narrator": "神楽", "text": "…さっきの言葉、\n本心だったんですね？"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "え？"},
        { "location": "50/TALK"   , "narrator": "神楽", "text": "お風呂で言ってたじゃ\nないですか。"},
        { "location": "51/TALK"   , "narrator": "神楽", "text": "私となら、上手く\nやっていける気が\nする、って…。"},
        { "location": "52/TALK"   , "narrator": "神楽", "text": "突然だったから、\n社交辞令かな、って\n思ってたんです。"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "あ、あはは…、\nビックリさせちゃった\nかな？"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "ええ、ちょっとだけ。"},
        { "location": "57/TALK"   , "narrator": "神楽", "text": "でも、どうして\nそんな風に思って\nくれたんですか？"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "え、えーっと…。"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "…どうしてかな？\nもしかして、友達が\nいなかったから――"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "ちょっと仲良くして\nもらって、そんな風に\n思っちゃった、とか？"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "…どうしてなんだろ？"},
        { "location": "65/SEL"    , "narrator": "", "text": "何も言わずただ見つめろ"},
        { "location": "66/SEL"    , "narrator": "", "text": "初めて会ったあの日からずっと愛してる、と言え"},
        { "location": "67/ACT"    , "narrator": "", "text": "何も言わずただ見つめろ"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "それで伝わるかな？(´･ω･｀) "},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "言葉にできないけど"},
        { "location": "89/TALK"   , "narrator": "つばめ", "text": "本気で思ったから言った"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "わたしの気持ちが(´ω｀*)"},
        { "location": "102/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "103/TALK"  , "narrator": "神楽", "text": "…？"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "じぃーっ。"},
        { "location": "107/TALK"  , "narrator": "神楽", "text": "え、えぇっと…。"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "じぃーーーーーっ。"},
        { "location": "109/TALK"  , "narrator": "神楽", "text": "…いいんですか？"},
        { "location": "111/TALK"  , "narrator": "神楽", "text": "そんなに熱い視線を\n向けられたら、私――"},
        { "location": "114/TALK"  , "narrator": "神楽", "text": "襲っちゃいますよ？"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "えぇっ！？\nそんなに攻撃的な\n視線だった！？"},
        { "location": "117/TALK"  , "narrator": "神楽", "text": "…攻撃的？"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "ごめんね。\n別に、睨んだりしてた\nわけじゃないの。"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "ただ、卯月さんのこと\n見つめてたつもり\nだったのに…。"},
        { "location": "125/TALK"  , "narrator": "神楽", "text": "はぁ…なるほど。"},
        { "location": "126/TALK"  , "narrator": "神楽", "text": "つばめさんって、\nそういうのに\n疎いんですね？"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "そ、そうかな？\n確かに天然とは\n言われるけど…。"},
        { "location": "128/TALK"  , "narrator": "神楽", "text": "そういう意味でも\nないんですけどね。"},
        { "location": "130/TALK"  , "narrator": "神楽", "text": "でも、つばめさんの\nそういうところ、\n本当に可愛いですね。"},
        { "location": "133/TALK"  , "narrator": "つばめ", "text": "か、可愛い？\nうーん、そうなの\nかなぁ？　うーん…。"},
        { "location": "134/TALK"  , "narrator": "神楽", "text": "そうやって困ってる\nところも、とっても\n可愛いですよ。"},
        { "location": "137/TALK"  , "narrator": "神楽", "text": "本当…我慢できなくて\n襲っちゃうかもしれま\nせん…。"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "わたし、そんなに\n攻撃的な困り方\nしてるのかな？"},
        { "location": "141/ACT"   , "narrator": "", "text": "初めて会ったあの日からずっと愛してる、と言え"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "えっと(･Д･｀)"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "あの日っていうか"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "卯月さんに会ったの"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "今日が初めてだよ？(´･ω･｀) "},
        { "location": "165/SEL"   , "narrator": "", "text": "ですよねー"},
        { "location": "166/SEL"   , "narrator": "", "text": "忘れたの？　$me$は未来を見通せるんだよ。つまり"},
        { "location": "167/ACT"   , "narrator": "", "text": "ですよねー"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "そうだよー"},
        { "location": "169/TALK"  , "narrator": "つばめ", "text": "わかってたの？"},
        { "location": "180/TALK"  , "narrator": "つばめ", "text": "…今のって、\n何だったんだろ？"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "まあ、いっか。"},
        { "location": "182/ACT"   , "narrator": "", "text": "忘れたの？　$me$は未来を見通せるんだよ。つまり"},
        { "location": "183/TALK"  , "narrator": "つばめ", "text": "言わないと"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "大変なことになっちゃうの？Σ(ﾟдﾟlll)"},
        { "location": "186/SEL"   , "narrator": "", "text": "言わないと、卯月と絶交の危機だと知っているのだ"},
        { "location": "187/ACT"   , "narrator": "", "text": "言わないと、卯月と絶交の危機だと知っているのだ"},
        { "location": "190/TALK"  , "narrator": "つばめ", "text": "そんなのダメ！・゜・(ノД`)・゜・"},
        { "location": "191/TALK"  , "narrator": "つばめ", "text": "わかったよ"},
        { "location": "192/TALK"  , "narrator": "つばめ", "text": "わたし、言うよ！(๑･ㅂ･)و☆"},
        { "location": "203/TALK"  , "narrator": "つばめ", "text": "言わないと絶交だ\nなんて――"},
        { "location": "205/TALK"  , "narrator": "つばめ", "text": "きっと、卯月さんが\nそれだけ望んでる、\nってことだよね。"},
        { "location": "207/TALK"  , "narrator": "つばめ", "text": "それなら…。"},
        { "location": "210/TALK"  , "narrator": "神楽", "text": "どうしたんですか？\n真剣そうな表情に\nなってますけど…。"},
        { "location": "212/TALK"  , "narrator": "つばめ", "text": "…してます。"},
        { "location": "213/TALK"  , "narrator": "神楽", "text": "……は？"},
        { "location": "215/TALK"  , "narrator": "つばめ", "text": "初めて見た時から、\n愛してます！"},
        { "location": "216/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "217/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "220/TALK"  , "narrator": "神楽", "text": "…ぷっ、ぶふぅっ！！"},
        { "location": "223/TALK"  , "narrator": "つばめ", "text": "え、えぇっ！？"},
        { "location": "224/TALK"  , "narrator": "神楽", "text": "あは、あはははは！！\nだ、ダメ、限界！"},
        { "location": "225/TALK"  , "narrator": "つばめ", "text": "何で笑うの！？"},
        { "location": "226/TALK"  , "narrator": "神楽", "text": "だってつばめさん、\n演技下手過ぎですし。"},
        { "location": "227/TALK"  , "narrator": "つばめ", "text": "え、演技じゃない！\n本気だよ。"},
        { "location": "229/TALK"  , "narrator": "神楽", "text": "いや、本気って…。"},
        { "location": "230/TALK"  , "narrator": "つばめ", "text": "本気だよ！　本気で\n卯月さんのこと\n愛してるよ！"},
        { "location": "231/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "234/TALK"  , "narrator": "神楽", "text": "つばめさん…、\nもっとノーマルに\n生きましょ？"},
        { "location": "235/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "236/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "240/TALK"  , "narrator": "つばめ", "text": "うーん…どうすれば\n本気って信じて\nもらえるかなぁ？"},
        { "location": "242/TALK"  , "narrator": "つばめ", "text": "……っていうか、\nあれ？"},
        { "location": "243/TALK"  , "narrator": "つばめ", "text": "わたし、どうして\n卯月さんとなら――"},
        { "location": "244/TALK"  , "narrator": "つばめ", "text": "上手くやっていける、\nって思ったんだろ？"},
        { "location": "288/TALK"  , "narrator": "つばめ", "text": "ようこそ\n[ココロゲート]へ。"},
        { "location": "289/TALK"  , "narrator": "つばめ", "text": "どうやら今回は\n少しだけ状況が\n違うみたいですね。"},
        { "location": "290/TALK"  , "narrator": "つばめ", "text": "何にしても、\nまずは【問題の扉】の\nコールから始めましょか！"},
        { "location": "298/TALK"  , "narrator": "つばめ", "text": "オープンプロセス、\n0x814番地から\n0x337番地へ。"},
        { "location": "313/TALK"  , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "314/SEL"   , "narrator": "", "text": "で、何が違うの？"},
        { "location": "315/ACT"   , "narrator": "", "text": "で、何が違うの？"},
        { "location": "319/TALK"  , "narrator": "つばめ", "text": "えっとですねー…"},
        { "location": "321/TALK"  , "narrator": "つばめ", "text": "今回の場合、何らかの\n悩みや恐れが扉を閉ざして\nいるわけではないんです。"},
        { "location": "322/TALK"  , "narrator": "つばめ", "text": "ココロファイルナンバー\n01-845-65によれば――"},
        { "location": "323/TALK"  , "narrator": "つばめ", "text": "この件については、\nどういうわけか【参照元\n不明】なんだそうです。"},
        { "location": "324/SEL"   , "narrator": "", "text": "不明？　何それ？？"},
        { "location": "325/ACT"   , "narrator": "", "text": "不明？　何それ？？"},
        { "location": "327/TALK"  , "narrator": "つばめ", "text": "現実のつばめが今回\n引っかかっている問題の\n原因が判らないんですよ。"},
        { "location": "328/TALK"  , "narrator": "つばめ", "text": "『どうして上手くやって\nいけるのか』の解にあたる\nデータベースが無いんです"},
        { "location": "329/SEL"   , "narrator": "", "text": "そんなことってあるの？"},
        { "location": "330/ACT"   , "narrator": "", "text": "そんなことってあるの？"},
        { "location": "333/TALK"  , "narrator": "つばめ", "text": "さあ……。\n少なくともわたしには\n初の体験ですね。"},
        { "location": "334/TALK"  , "narrator": "つばめ", "text": "とにかく、その原因は\nこちらの方で探るとして\n問題は現実のわたしです。"},
        { "location": "335/TALK"  , "narrator": "つばめ", "text": "解のない疑問をずっと\n気にして、日常生活に\n響く危険性があります。"},
        { "location": "336/TALK"  , "narrator": "つばめ", "text": "授業中やバイト中、\n寝る前にも悶々と\n考えちゃいますからね。"},
        { "location": "337/TALK"  , "narrator": "つばめ", "text": "ですから今回は、この\n問題に執着するクランを\n叩くことにしましょう！"},
        { "location": "338/SEL"   , "narrator": "", "text": "そんな軽くミッション変えちゃっていいの！？"},
        { "location": "339/ACT"   , "narrator": "", "text": "そんな軽くミッション変えちゃっていいの！？"},
        { "location": "342/TALK"  , "narrator": "つばめ", "text": "大丈夫ですよ！\n結果オーライ。"},
        { "location": "343/TALK"  , "narrator": "つばめ", "text": "一旦気が逸れれば\n万事解決ですから。"},
        { "location": "344/SEL"   , "narrator": "", "text": "最近性格変わってきてない？"},
        { "location": "345/ACT"   , "narrator": "", "text": "最近性格変わってきてない？"},
        { "location": "347/TALK"  , "narrator": "つばめ", "text": "そ、そんなこと\nありませんよ？"},
        { "location": "350/TALK"  , "narrator": "つばめ", "text": "それでは、\n再検索します！"},
        { "location": "355/TALK"  , "narrator": "つばめ", "text": "オープンプロセス、\n0x337番地から\n0x11F番地へ。"},
        { "location": "370/TALK"  , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "372/TALK"  , "narrator": "つばめ", "text": "さあ、この扉に\n今回のことをずっと\n気にするクランがいます。"},
        { "location": "373/TALK"  , "narrator": "つばめ", "text": "除去してわたしを\nスッキリさせて\nくださいね！"},
        { "location": "375/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
        { "location": "28/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月9日　7:22 PM</color>\n高校でのフェノメノン戦の後、劇場横の銭湯にて。"},
        { "location": "256/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"}
    ]
}
