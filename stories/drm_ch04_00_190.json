        "title": "らぶとーく 第19話",
        "sub_title": "裏の裏の春うらら"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "裏の裏の春うらら"},
        { "location": "19/TALK"   , "narrator": "アーヤ", "text": "ふう。\n平穏無事に\n一日が終わったわね。"},
        { "location": "21/TALK"   , "narrator": "つばめ", "text": "いつもこうだと\nいいんですけど。"},
        { "location": "23/TALK"   , "narrator": "ガブリエラ", "text": "つばめは本当に\n甘いわね。"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "いつでも備えて\nおかなきゃダメよ。"},
        { "location": "26/TALK"   , "narrator": "みやび", "text": "そういうガブちゃんは\n常に備えは万全\nなんかね。"},
        { "location": "27/TALK"   , "narrator": "ガブリエラ", "text": "当然よ。"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "さすがガブちゃん！"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "…素直に言われると\n調子が狂うわ……。"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "相棒よ"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "なぜガブちゃんの備えが常に万全か知っちゅうか？"},
        { "location": "47/SEL"    , "narrator": "", "text": "知らない"},
        { "location": "48/SEL"    , "narrator": "", "text": "教えて"},
        { "location": "49/ACT"    , "narrator": "", "text": "知らない"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "即答か"},
        { "location": "51/ACT"    , "narrator": "", "text": "教えて"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "少しは考えろ"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "ここだけの話"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "ガブちゃんはアンドロイドなのだ"},
        { "location": "58/SEL"    , "narrator": "", "text": "ああ、スマホの"},
        { "location": "59/SEL"    , "narrator": "", "text": "またまた"},
        { "location": "60/ACT"    , "narrator": "", "text": "ああ、スマホの"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "そうそう"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "って"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "違うわ！！！！"},
        { "location": "66/ACT"    , "narrator": "", "text": "またまた"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "これがこれが"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "本当なのだ"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "というわけで"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "その証拠をつかめ"},
        { "location": "73/SEL"    , "narrator": "", "text": "いや、冗談でしょ？"},
        { "location": "74/SEL"    , "narrator": "", "text": "無茶言うなあ"},
        { "location": "75/ACT"    , "narrator": "", "text": "いや、冗談でしょ？"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "本気ぞね"},
        { "location": "77/ACT"    , "narrator": "", "text": "無茶言うなあ"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "無茶ではない"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "仮にもうちの相棒としてやっていくには"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "このくらいのことは軽くこなしてもらわんとな"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "今日はこれで\n解散しましょうか。"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "そうね。\n明日に備えて。"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "ガブちゃんは本当に\n偉いよね…！"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "なんかちょっと\n上から目線な\n感じもするわ…。"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "素直に受け取っとけば\nええぞね。"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "ふふ。"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "何その笑い？"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "いや。"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "羊の夢を見るのは\n人間だけやねえって\n思っただけぞね。"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "羊が一匹、って\nやつですか？"},
        { "location": "109/TALK"  , "narrator": "つばめ", "text": "眠れない時に\n数えるといいって。"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "ああ、そっちでは\nなくてやね。"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "感情に基づいて\n行動するのは\n人間だけっちゅう話や。"}
    ]
}
