        { "location": "414/TALK" , "narrator": "神楽", "text": "ていうか、この話誰かにしたら呪うから"},
        { "location": "416/SEL"  , "narrator": "（選択肢）", "text": "言わないよ"},
        { "location": "417/SEL"  , "narrator": "（選択肢）", "text": "みんな信じていいと思うよ"},
