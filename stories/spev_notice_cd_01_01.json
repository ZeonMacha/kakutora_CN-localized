        { "location": "406/TALK" , "narrator": "神楽", "text": "ズッ友だよ♪（ずっと友達とは言ってない）"},
        { "location": "408/SEL"  , "narrator": "（選択肢）", "text": "つばめたちはそんなことないよ"},
        { "location": "409/SEL"  , "narrator": "（選択肢）", "text": "辛い過去があるんだね"},
        { "location": "410/ACT"  , "narrator": "", "text": "つばめたちはそんなことないよ"},
