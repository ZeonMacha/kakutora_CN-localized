        "title": "001 アフターストーリー",
        "sub_title": "神楽坂トライナリー"
    },
    "entry":
    [
        { "location": "18/DIALOG", "narrator": "", "text": "<color=green>某月某日　1:33 PM</color>\nとある休日、神楽坂トライナリー倉庫にて。"},
        { "location": "19/TALK"  , "narrator": "真幌", "text": "うーん、おかしい…。\n確かこの辺りにしまって\nおいたはずなんだが…。"},
        { "location": "22/TALK"  , "narrator": "つばめ", "text": "真幌さん、ちょっとは\n倉庫も整理しないと…。"},
        { "location": "23/TALK"  , "narrator": "真幌", "text": "中々暇がなくてな。\nん？　この箱は…。"},
        { "location": "27/TALK"  , "narrator": "真幌", "text": "これは…、懐かしい物が\n出てきたな。"},
        { "location": "28/TALK"  , "narrator": "つばめ", "text": "何が出てきたんですか？"},
        { "location": "30/TALK"  , "narrator": "真幌", "text": "ああ…昔、うちの劇場で\n使ってた食器だ。"},
        { "location": "32/TALK"  , "narrator": "つばめ", "text": "…食器？"},
        { "location": "50/TALK"  , "narrator": "ガブリエラ", "text": "へぇ…まだ綺麗だけど、\nデザインがちょっと\n古くない？"},
        { "location": "51/TALK"  , "narrator": "真幌", "text": "当然だ。\n私が生まれる前から\n使ってた物だからな。"},
        { "location": "52/TALK"  , "narrator": "みやび", "text": "こんなに沢山、\nカフェやっちょった\nわけでもなかろうに…。"},
        { "location": "54/TALK"  , "narrator": "真幌", "text": "やってたぞ。"},
        { "location": "56/TALK"  , "narrator": "みやび", "text": "はい？"},
        { "location": "57/TALK"  , "narrator": "真幌", "text": "劇場のホワイエでな、\nちょっとしたカフェを\nやってた時期があるんだ。"},
        { "location": "60/TALK"  , "narrator": "アーヤ", "text": "そうだったんですか？\n初めて聞きました。"},
        { "location": "61/TALK"  , "narrator": "真幌", "text": "私が子供の時に営業を\nやめてしまったからな。"},
        { "location": "63/TALK"  , "narrator": "真幌", "text": "これを見つけるまで、\n私もすっかり忘れていた。"},
        { "location": "64/TALK"  , "narrator": "ガブリエラ", "text": "そんな楽しそうなこと\nしてたなんて…。\nなんで辞めちゃったのよ？"},
        { "location": "65/TALK"  , "narrator": "真幌", "text": "知らんよ。\n私は子供だったからな。"},
        { "location": "66/TALK"  , "narrator": "真幌", "text": "まあ、もう使うことも\nないだろうし…。\n思い切って処分するか。"},
        { "location": "68/TALK"  , "narrator": "つばめ", "text": "いいんですか？\nこれ、思い出の詰まった\n食器なんじゃ…。"},
        { "location": "69/TALK"  , "narrator": "真幌", "text": "思い出はあるが、\nさすがに多すぎる。"},
        { "location": "70/TALK"  , "narrator": "真幌", "text": "第一、使わない物を\n取っておいても、\n仕方がないからな。"},
        { "location": "72/TALK"  , "narrator": "ガブリエラ", "text": "勿体ないわね。\nそんなこと言わないで――"},
        { "location": "73/TALK"  , "narrator": "ガブリエラ", "text": "カフェの営業を\n再開すればいいじゃない。"},
        { "location": "74/TALK"  , "narrator": "真幌", "text": "…は？"},
        { "location": "76/TALK"  , "narrator": "つばめ", "text": "わぁ、それ楽しそう！"},
        { "location": "78/TALK"  , "narrator": "真幌", "text": "おいおいおい、\n冗談だろ？"},
        { "location": "80/TALK"  , "narrator": "ガブリエラ", "text": "ううん、本気よ。\n劇場の仕事は退屈で、\n正直飽きてたとこだし…。"},
        { "location": "82/TALK"  , "narrator": "真幌", "text": "…アーヤ、おまえからも\nなんとか言ってやって\nくれないか？"},
        { "location": "84/TALK"  , "narrator": "アーヤ", "text": "え、えっと…。"},
        { "location": "85/TALK"  , "narrator": "真幌", "text": "…おまえもギャヴィと\n同じ意見か？"},
        { "location": "87/TALK"  , "narrator": "アーヤ", "text": "すみません…。"},
        { "location": "88/TALK"  , "narrator": "アーヤ", "text": "でも、ここ最近いろいろ\nありましたし"},
        { "location": "89/TALK"  , "narrator": "アーヤ", "text": "みんなで一緒に、\n何か今までと違うことを\nやるのもアリかなって。"},
        { "location": "90/TALK"  , "narrator": "真幌", "text": "…なるほど。\nみやびは？"},
        { "location": "91/TALK"  , "narrator": "みやび", "text": "うちが言いたいことは、\nだいたいアーヤが言うて\nくれたき、あとは――"},
        { "location": "92/TALK"  , "narrator": "みやび", "text": "カフェっちゅうことは\nケーキは必須やろ？"},
        { "location": "93/TALK"  , "narrator": "みやび", "text": "なら、うちは大賛成ちや。"},
        { "location": "95/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんは…。"},
        { "location": "97/TALK"  , "narrator": "つばめ", "text": "あれ？"},
        { "location": "116/TALK" , "narrator": "神楽", "text": "…………。"},
        { "location": "117/TALK" , "narrator": "つばめ", "text": "神楽ちゃん。"},
        { "location": "122/TALK" , "narrator": "つばめ", "text": "どうしたの？\nこんな隅っこで…。"},
        { "location": "124/TALK" , "narrator": "神楽", "text": "あ、いえ別に…。"},
        { "location": "126/TALK" , "narrator": "つばめ", "text": "ほら、神楽ちゃんも\nこっちに来て、\n一緒に話そうよ。"},
        { "location": "127/TALK" , "narrator": "神楽", "text": "わ、私はいいです。\n皆さんで決めて\nいただければ――"},
        { "location": "128/TALK" , "narrator": "つばめ", "text": "そんなのダメだよ。\nみんな一緒に決めないと\n面白くないし。"},
        { "location": "129/TALK" , "narrator": "透明ガブリエラ", "text": "ちょっと、そこの二人。\n早くしなさいよ。"},
        { "location": "130/TALK" , "narrator": "つばめ", "text": "あ、はーい！\nほら神楽ちゃん、行こ。"},
        { "location": "132/TALK" , "narrator": "神楽", "text": "わわっ、そんな強引に！"},
        { "location": "151/TALK" , "narrator": "ガブリエラ", "text": "――で？\nつばめは勿論賛成よね？"},
        { "location": "153/TALK" , "narrator": "つばめ", "text": "もちろんだよ！"},
        { "location": "155/TALK" , "narrator": "神楽", "text": "…………。"},
        { "location": "157/TALK" , "narrator": "ガブリエラ", "text": "ほら、神楽。\nあんたはどうなのよ？"},
        { "location": "161/TALK" , "narrator": "神楽", "text": "えっ？"},
        { "location": "164/TALK" , "narrator": "神楽", "text": "あ、はい。\nとっても楽しそうだと\n思います。"},
        { "location": "166/TALK" , "narrator": "みやび", "text": "…………。"},
        { "location": "167/TALK" , "narrator": "アーヤ", "text": "でも、現実問題\nそう簡単にカフェ営業って\nできるのかしら？"},
        { "location": "169/TALK" , "narrator": "アーヤ", "text": "運営資金のことも\n考えないといけないし…。"},
        { "location": "171/TALK" , "narrator": "ガブリエラ", "text": "その辺はまほが出すに\n決まってるでしょ。"},
        { "location": "173/TALK" , "narrator": "アーヤ", "text": "そんな無責任な…。"},
        { "location": "175/TALK" , "narrator": "真幌", "text": "ふむ…場所と食器は\n揃っているから\n問題ないとして。"},
        { "location": "176/TALK" , "narrator": "真幌", "text": "あとは調理用の設備に\n材料費、インテリアと\nその他雑費諸々として…。"},
        { "location": "178/TALK" , "narrator": "真幌", "text": "…よし、わかった。\nそっちの方は私が\nどうにかしよう。"},
        { "location": "180/TALK" , "narrator": "アーヤ", "text": "本当ですか！？"},
        { "location": "181/TALK" , "narrator": "みやび", "text": "まほさん、いつになく\n太っ腹やね。"},
        { "location": "184/TALK" , "narrator": "真幌", "text": "…色々あったからな。"},
        { "location": "185/TALK" , "narrator": "真幌", "text": "みんなで協力して\n何かしようというのは、\nいいことだと思う。"},
        { "location": "189/TALK" , "narrator": "ガブリエラ", "text": "やった！\nじゃあ、カフェをやるのは\nコレで決まりね！"},
        { "location": "190/TALK" , "narrator": "みやび", "text": "それしか解決しちょらん\n言うた方が正しいと\n思うけんどな。"},
        { "location": "192/TALK" , "narrator": "つばめ", "text": "食器もありますよね？"},
        { "location": "194/TALK" , "narrator": "神楽", "text": "あ、でも…。"},
        { "location": "196/TALK" , "narrator": "ガブリエラ", "text": "ん？　どうかしたの？"},
        { "location": "198/TALK" , "narrator": "神楽", "text": "あ、いえ…。\nなんでもありません…。"},
        { "location": "199/TALK" , "narrator": "ガブリエラ", "text": "言いかけてやめられたら\n気持ち悪いでしょ？\nハッキリ言いなさい！"},
        { "location": "201/TALK" , "narrator": "神楽", "text": "…………。"},
        { "location": "202/TALK" , "narrator": "神楽", "text": "この食器ですけど、\nこのまま使うのは\nどうかと思いますよ？"},
        { "location": "204/TALK" , "narrator": "つばめ", "text": "え、どうして？"},
        { "location": "206/TALK" , "narrator": "神楽", "text": "デザインがちょっと、\n今風じゃないですよね？"},
        { "location": "208/TALK" , "narrator": "神楽", "text": "なので、\n今あるデザインを\n生かしつつ――"},
        { "location": "210/TALK" , "narrator": "神楽", "text": "リデザインするのは\nどうかな、と…。"},
        { "location": "211/TALK" , "narrator": "つばめ", "text": "それ、面白そうだよ！\nやってみたいな。"},
        { "location": "213/TALK" , "narrator": "アーヤ", "text": "けど、それって簡単に\nできることなの？"},
        { "location": "215/TALK" , "narrator": "神楽", "text": "もちろん、業者さんに\nお願いすることに\nなりますけど――"},
        { "location": "216/TALK" , "narrator": "神楽", "text": "それが難しそうなら\n流して下さい……。"},
        { "location": "218/TALK" , "narrator": "ガブリエラ", "text": "面白そうじゃない！"},
        { "location": "219/TALK" , "narrator": "真幌", "text": "まあ、まずは\n見積を見るところ\nからだな……。"},
        { "location": "221/TALK" , "narrator": "みやび", "text": "けんど、うちらのなかで\nデザインなんぞ出来るヤツ\nおるが？"},
        { "location": "223/TALK" , "narrator": "ガブリエラ", "text": "別に、難しいデザインを\n作るわけじゃないわ。"},
        { "location": "224/TALK" , "narrator": "ガブリエラ", "text": "例えば、そうね…。\nカフェのロゴを作るとか？"},
        { "location": "227/TALK" , "narrator": "アーヤ", "text": "あ、それ好きかも。"},
        { "location": "228/TALK" , "narrator": "ガブリエラ", "text": "アーヤなら絶対こういうの\n好きだと思ったわ。"},
        { "location": "230/TALK" , "narrator": "真幌", "text": "ああ、カフェのロゴか。\nそれなら既にあるんだが。"},
        { "location": "232/TALK" , "narrator": "ガブリエラ", "text": "ええっ！？\nそうだったの！？"},
        { "location": "233/TALK" , "narrator": "真幌", "text": "ああ。\nまあ、厳密には劇場の\nロゴなんだがな。"},
        { "location": "234/TALK" , "narrator": "真幌", "text": "前にカフェをやってた時は\n同じロゴでやっていた\nそうだ。"},
        { "location": "237/TALK" , "narrator": "つばめ", "text": "えっ！？\n劇場のロゴなんて\nあったんですか！？"},
        { "location": "239/TALK" , "narrator": "真幌", "text": "ああ、そうか。\nまだ誰にも見せたこと\nなかったか。"},
        { "location": "245/TALK" , "narrator": "真幌", "text": "ほら、これだ。\n私が生まれる前から\n使われているモノだぞ。"},
        { "location": "248/TALK" , "narrator": "アーヤ", "text": "見たことないですよ。\nだって、劇場のどこにも\nないじゃないですか…。"},
        { "location": "250/TALK" , "narrator": "ガブリエラ", "text": "へえ、昔からある\nロゴの割りには、\n結構いい感じね。"},
        { "location": "253/TALK" , "narrator": "みやび", "text": "そうやねぇ。\nうちもこのデザインは\n嫌いやないぞね。"},
        { "location": "254/TALK" , "narrator": "みやび", "text": "けんど…ちくっと\n真ん中ら辺りが\n寂しいような…。"},
        { "location": "259/TALK" , "narrator": "みやび", "text": "こんな感じで模様入れたら\nえい感じと思わん？"},
        { "location": "261/TALK" , "narrator": "つばめ", "text": "素敵ですね。\n急にかわいくなった\n感じがします！"},
        { "location": "262/TALK" , "narrator": "みやび", "text": "まほさん。\nロゴに手を加えるんも\nダメですか？"},
        { "location": "264/TALK" , "narrator": "真幌", "text": "これくらいなら構わんよ。\n私も、完成が少し楽しみに\nなってきたからな。"},
        { "location": "267/TALK" , "narrator": "アーヤ", "text": "それじゃあ、とりあえず\nロゴを作るところから\n始めましょ。"},
        { "location": "271/TALK" , "narrator": "つばめ", "text": "わかりました！\nどんなのにしようかなぁ？"},
        { "location": "272/TALK" , "narrator": "真幌", "text": "考えるのは\n帰ってからにしろ。"},
        { "location": "273/TALK" , "narrator": "真幌", "text": "今日はもう遅い。\n話の続きは後日だな。"},
        { "location": "275/TALK" , "narrator": "ガブリエラ", "text": "そうね。\nもうこんな時間だし…。"},
        { "location": "277/TALK" , "narrator": "アーヤ", "text": "それじゃ、今日のところは\n一度解散ね。"},
        { "location": "279/TALK" , "narrator": "神楽", "text": "わかりました。\nそれじゃ皆さん、\nお疲れ様でした。"},
        { "location": "285/TALK" , "narrator": "ガブリエラ", "text": "ちょ、ちょっと神楽！"},
        { "location": "287/TALK" , "narrator": "ガブリエラ", "text": "はぁ…。\nもう、何なのよあの子。"},
        { "location": "289/TALK" , "narrator": "アーヤ", "text": "仕方ないわよ。\nあんなことがあった\nばかりだもの。"},
        { "location": "290/TALK" , "narrator": "アーヤ", "text": "私が卯月でも、やっぱり\nちょっとまだ居づらいかも\nって思っちゃうかも。"},
        { "location": "292/TALK" , "narrator": "つばめ", "text": "でも、みんな神楽ちゃんの\nことは、全然気にしない\nって言ってますし……。"},
        { "location": "294/TALK" , "narrator": "みやび", "text": "うちらが気にせんゆうて、\nはいそうですかと\n受け入れられたら――"},
        { "location": "295/TALK" , "narrator": "みやび", "text": "メンタル強すぎるにも\nほどがあるっちゅう話や。"},
        { "location": "297/TALK" , "narrator": "つばめ", "text": "…真幌さん。\nなにかいい方法は\nありませんか？"},
        { "location": "299/TALK" , "narrator": "真幌", "text": "ふむ…私は特に心配は\nしていないがな。"},
        { "location": "301/TALK" , "narrator": "真幌", "text": "色々あったが、\n卯月は我々の元へ\n戻ってきてくれたんだ。"},
        { "location": "302/TALK" , "narrator": "真幌", "text": "なら、あとは時間が\n解決してくれる。\nそう思っているよ。"},
        { "location": "317/TALK" , "narrator": "神楽", "text": "ただいま…。"},
        { "location": "319/TALK" , "narrator": "神楽", "text": "はぁ…。"},
        { "location": "331/TALK" , "narrator": "神楽", "text": "つらい"},
        { "location": "332/TALK" , "narrator": "神楽", "text": "ねえ、$handle$"},
        { "location": "333/TALK" , "narrator": "神楽", "text": "肩揉んで"},
        { "location": "335/SEL"  , "narrator": "（選択肢）", "text": "ちょっと無理かも"},
        { "location": "336/SEL"  , "narrator": "（選択肢）", "text": "今は肩たたきチケット1枚で許して"},
        { "location": "337/SEL"  , "narrator": "（選択肢）", "text": "胸の間違いでは…？"},
        { "location": "338/ACT"  , "narrator": "", "text": "ちょっと無理かも"},
        { "location": "339/TALK" , "narrator": "神楽", "text": "知ってた"},
        { "location": "340/TALK" , "narrator": "神楽", "text": "けどつまんない答え"},
        { "location": "341/TALK" , "narrator": "神楽", "text": "はーーーーーーー"},
        { "location": "342/ACT"  , "narrator": "", "text": "今は肩たたきチケット1枚で許して"},
        { "location": "343/TALK" , "narrator": "神楽", "text": "１まいにつき１２時間分で！！"},
        { "location": "344/TALK" , "narrator": "神楽", "text": "待ってるぴょん♪"},
        { "location": "345/ACT"  , "narrator": "", "text": "胸の間違いでは…？"},
        { "location": "346/TALK" , "narrator": "神楽", "text": "おいクズ"},
        { "location": "347/TALK" , "narrator": "神楽", "text": "世の中にはTPOってもんがあるんだよ、クズ"},
        { "location": "348/TALK" , "narrator": "神楽", "text": "私じゃなかったら殺されててもおかしくないからね？"},
        { "location": "351/SEL"  , "narrator": "（選択肢）", "text": "話は終わり？"},
        { "location": "352/ACT"  , "narrator": "", "text": "話は終わり？"},
        { "location": "354/TALK" , "narrator": "神楽", "text": "もしかして今忙しい？"},
        { "location": "356/SEL"  , "narrator": "（選択肢）", "text": "ヒマ"},
        { "location": "357/SEL"  , "narrator": "（選択肢）", "text": "超忙しい"},
        { "location": "358/SEL"  , "narrator": "（選択肢）", "text": "神楽のためならいくらでも時間あけるよ"},
        { "location": "359/ACT"  , "narrator": "", "text": "ヒマ"},
        { "location": "360/TALK" , "narrator": "神楽", "text": "知ってた"},
        { "location": "361/TALK" , "narrator": "神楽", "text": "聞くまでもなかった"},
        { "location": "362/TALK" , "narrator": "神楽", "text": "ゴミに仕事なし。ﾌﾟｰｸｽｸｽ"},
        { "location": "364/SEL"  , "narrator": "（選択肢）", "text": "ひどくね？"},
        { "location": "365/ACT"  , "narrator": "", "text": "ひどくね？"},
        { "location": "367/TALK" , "narrator": "神楽", "text": "うそぴょんぴょん♪"},
        { "location": "369/TALK" , "narrator": "神楽", "text": "ごめんね？傷ついちゃった？"},
        { "location": "372/ACT"  , "narrator": "", "text": "超忙しい"},
        { "location": "373/TALK" , "narrator": "神楽", "text": "だが許さん"},
        { "location": "374/TALK" , "narrator": "神楽", "text": "いくら忙しいって言っても、ここで話す時間なんて生まれてから死ぬまでの数億分の一ですよ？$handle$先生"},
        { "location": "375/TALK" , "narrator": "神楽", "text": "ヒント：つき合え"},
        { "location": "376/ACT"  , "narrator": "", "text": "神楽のためならいくらでも時間あけるよ"},
        { "location": "379/TALK" , "narrator": "神楽", "text": "そんなこと言ってると、今夜は寝かしませんよ♪"},
        { "location": "381/TALK" , "narrator": "神楽", "text": "（私は寝ます）"},
        { "location": "383/TALK" , "narrator": "神楽", "text": "でね、本題なんだけど"},
