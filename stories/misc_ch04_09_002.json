    "entry":
    [
        { "location": "95/SCENARIO", "narrator": "", "text": "011_海の色"},
        { "location": "120/TALK"   , "narrator": "みやび", "text": "みやびは東京に海が無いといふ。"},
        { "location": "121/TALK"   , "narrator": "みやび", "text": "ほんとの海が見たいといふ。"},
        { "location": "124/SEL"    , "narrator": "", "text": "え…何それ…"},
        { "location": "125/SEL"    , "narrator": "", "text": "$me$は驚いて海を見る。"},
        { "location": "126/SEL"    , "narrator": "", "text": "土佐の海を見に行きたいな"},
        { "location": "130/ACT"    , "narrator": "", "text": "え…何それ…"},
        { "location": "132/TALK"   , "narrator": "みやび", "text": "さあ…"},
        { "location": "133/TALK"   , "narrator": "みやび", "text": "何かな…"},
        { "location": "134/ACT"    , "narrator": "", "text": "$me$は驚いて海を見る。"},
        { "location": "135/TALK"   , "narrator": "みやび", "text": "桜若葉の間に在るのは、"},
        { "location": "136/TALK"   , "narrator": "みやび", "text": "って"},
        { "location": "137/TALK"   , "narrator": "みやび", "text": "立ち位置がおかしいぞね"},
        { "location": "138/TALK"   , "narrator": "みやび", "text": "海が空にあることになっちゅう"},
        { "location": "139/ACT"    , "narrator": "", "text": "土佐の海を見に行きたいな"},
        { "location": "141/TALK"   , "narrator": "みやび", "text": "そこは"},
        { "location": "142/TALK"   , "narrator": "みやび", "text": "$handle$が桂浜に連れて行くぜよ"},
        { "location": "143/TALK"   , "narrator": "みやび", "text": "と"},
        { "location": "144/TALK"   , "narrator": "みやび", "text": "いうべきであろう"},
        { "location": "145/TALK"   , "narrator": "みやび", "text": "わからんちん"},
        { "location": "148/TALK"   , "narrator": "みやび", "text": "まあみやびさんは智恵子抄ごっこをしていたわけだが"},
        { "location": "150/SEL"    , "narrator": "", "text": "$me$のことは光太郎と呼び給え"},
        { "location": "151/SEL"    , "narrator": "", "text": "よし、続きやろうぜ"},
        { "location": "152/SEL"    , "narrator": "", "text": "何なのそれ…？"},
        { "location": "153/ACT"    , "narrator": "", "text": "$me$のことは光太郎と呼び給え"},
        { "location": "155/TALK"   , "narrator": "みやび", "text": "了解した"},
        { "location": "156/TALK"   , "narrator": "みやび", "text": "ハンドルを変更せよ"},
        { "location": "158/SEL"    , "narrator": "", "text": "それはちょっと"},
        { "location": "159/SEL"    , "narrator": "", "text": "いいよー"},
        { "location": "160/ACT"    , "narrator": "", "text": "それはちょっと"},
        { "location": "161/TALK"   , "narrator": "みやび", "text": "光太郎のくせに"},
        { "location": "162/TALK"   , "narrator": "みやび", "text": "光太郎じゃないということか"},
        { "location": "163/ACT"    , "narrator": "", "text": "いいよー"},
        { "location": "164/TALK"   , "narrator": "みやび", "text": "軽すぎる"},
        { "location": "165/TALK"   , "narrator": "みやび", "text": "もっと光太郎っぽく！"},
        { "location": "167/ACT"    , "narrator": "", "text": "よし、続きやろうぜ"},
        { "location": "168/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "169/TALK"   , "narrator": "みやび", "text": "遊びは終わりだ"},
        { "location": "170/ACT"    , "narrator": "", "text": "何なのそれ…？"},
        { "location": "171/TALK"   , "narrator": "みやび", "text": "この説明では不足か"},
        { "location": "173/TALK"   , "narrator": "みやび", "text": "海の側に育ったもんには"},
        { "location": "174/TALK"   , "narrator": "みやび", "text": "それぞれの海の色があるっちゅーことぞね"}
    ]
}
