        "title": "らぶとーく 第47話",
        "sub_title": "ほんとはずっと聞こえてた"
    },
    "entry":
    [
        { "location": "1371/SCENARIO", "narrator": "", "text": "400_ほんとはずっと聞こえてた"},
        { "location": "1396/TALK"    , "narrator": "アーヤ", "text": "私"},
        { "location": "1397/TALK"    , "narrator": "アーヤ", "text": "勝手なことばかり言ってるって"},
        { "location": "1398/TALK"    , "narrator": "アーヤ", "text": "自覚はあるの"},
        { "location": "1400/SEL"     , "narrator": "", "text": "そうだったんだ"},
        { "location": "1401/SEL"     , "narrator": "", "text": "自重して"},
        { "location": "1402/SEL"     , "narrator": "", "text": "それでいいから"},
        { "location": "1403/ACT"     , "narrator": "", "text": "そうだったんだ"},
        { "location": "1404/TALK"    , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "1406/TALK"    , "narrator": "アーヤ", "text": "そうなんだけど"},
        { "location": "1407/TALK"    , "narrator": "アーヤ", "text": "気づいてくれてなかったのね"},
        { "location": "1408/ACT"     , "narrator": "", "text": "自重して"},
        { "location": "1409/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "1410/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "1411/TALK"    , "narrator": "アーヤ", "text": "そうするわ"},
        { "location": "1412/ACT"     , "narrator": "", "text": "それでいいから"},
        { "location": "1423/TALK"    , "narrator": "アーヤ", "text": "ありがとう"},
        { "location": "1425/TALK"    , "narrator": "アーヤ", "text": "っていいうか"},
        { "location": "1427/TALK"    , "narrator": "アーヤ", "text": "っていうか"},
        { "location": "1428/TALK"    , "narrator": "アーヤ", "text": "そう言ってくれるって"},
        { "location": "1429/TALK"    , "narrator": "アーヤ", "text": "思ってたのよ、私"},
        { "location": "1431/SEL"     , "narrator": "", "text": "だろうね"},
        { "location": "1432/SEL"     , "narrator": "", "text": "うん"},
        { "location": "1433/ACT"     , "narrator": "", "text": "だろうね"},
        { "location": "1434/TALK"    , "narrator": "アーヤ", "text": "そうなの"},
        { "location": "1435/ACT"     , "narrator": "", "text": "うん"},
        { "location": "1436/TALK"    , "narrator": "アーヤ", "text": "わかってたの"},
        { "location": "1438/TALK"    , "narrator": "アーヤ", "text": "$handle$さんとは"},
        { "location": "1439/TALK"    , "narrator": "アーヤ", "text": "合ったこともないのに"},
        { "location": "1441/SEL"     , "narrator": "", "text": "会ったことはないね"},
        { "location": "1442/SEL"     , "narrator": "", "text": "いつか会いたいね"},
        { "location": "1443/ACT"     , "narrator": "", "text": "会ったことはないね"},
        { "location": "1444/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "1445/TALK"    , "narrator": "アーヤ", "text": "会ったことね"},
        { "location": "1446/ACT"     , "narrator": "", "text": "いつか会いたいね"},
        { "location": "1447/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "1449/TALK"    , "narrator": "アーヤ", "text": "いつか"},
        { "location": "1451/TALK"    , "narrator": "アーヤ", "text": "ディスプレイ越しじゃなくて"},
        { "location": "1452/TALK"    , "narrator": "アーヤ", "text": "隣同士だったり"},
        { "location": "1453/TALK"    , "narrator": "アーヤ", "text": "向き合ったりしたいわね"},
        { "location": "1455/SEL"     , "narrator": "", "text": "そうだね　　　"},
        { "location": "1456/SEL"     , "narrator": "", "text": "考えただけで萌える"},
        { "location": "1457/ACT"     , "narrator": "", "text": "そうだね　　　"},
        { "location": "1458/TALK"    , "narrator": "アーヤ", "text": "ね"},
        { "location": "1459/ACT"     , "narrator": "", "text": "考えただけで萌える"},
        { "location": "1460/TALK"    , "narrator": "アーヤ", "text": "変な言い方しないで"},
        { "location": "1461/TALK"    , "narrator": "アーヤ", "text": "もう"},
        { "location": "1463/TALK"    , "narrator": "アーヤ", "text": "それで"},
        { "location": "1464/TALK"    , "narrator": "アーヤ", "text": "スマホ越しじゃなくて"},
        { "location": "1465/TALK"    , "narrator": "アーヤ", "text": "話したりもしたいわ"},
        { "location": "1467/SEL"     , "narrator": "", "text": "アーヤの声が聞きたい"},
        { "location": "1468/SEL"     , "narrator": "", "text": "実現させるから"},
        { "location": "1469/ACT"     , "narrator": "", "text": "アーヤの声が聞きたい"},
        { "location": "1470/TALK"    , "narrator": "アーヤ", "text": "ええとね"},
        { "location": "1471/TALK"    , "narrator": "アーヤ", "text": "改めて"},
        { "location": "1472/TALK"    , "narrator": "アーヤ", "text": "言っておくわね"},
        { "location": "1473/ACT"     , "narrator": "", "text": "実現させるから"},
        { "location": "1474/TALK"    , "narrator": "アーヤ", "text": "本当？"},
        { "location": "1475/TALK"    , "narrator": "アーヤ", "text": "その前に"},
        { "location": "1476/TALK"    , "narrator": "アーヤ", "text": "もう一度、言っておかなきゃね"},
        { "location": "1478/TALK"    , "narrator": "アーヤ", "text": "私は$handle$さんのことが好き"},
        { "location": "1479/TALK"    , "narrator": "アーヤ", "text": "だから付き合って"},
        { "location": "1482/SEL"     , "narrator": "", "text": "はい"},
        { "location": "1483/SEL"     , "narrator": "", "text": "こちらこそ"},
        { "location": "1484/SEL"     , "narrator": "", "text": "$me$だって言いたいよ"},
        { "location": "1485/ACT"     , "narrator": "", "text": "はい"},
        { "location": "1486/TALK"    , "narrator": "アーヤ", "text": "これからは"},
        { "location": "1488/TALK"    , "narrator": "アーヤ", "text": "恋人として"},
        { "location": "1489/ACT"     , "narrator": "", "text": "こちらこそ"},
        { "location": "1490/TALK"    , "narrator": "アーヤ", "text": "よろしくね"},
        { "location": "1492/TALK"    , "narrator": "アーヤ", "text": "ダーリン"},
        { "location": "1493/ACT"     , "narrator": "", "text": "$me$だって言いたいよ"},
        { "location": "1494/TALK"    , "narrator": "アーヤ", "text": "ずっと言ってくれてたじゃない"},
        { "location": "1496/TALK"    , "narrator": "アーヤ", "text": "そうでしょう？"},
        { "location": "1499/TALK"    , "narrator": "アーヤ", "text": "なんだか"},
        { "location": "1500/TALK"    , "narrator": "アーヤ", "text": "たったこれだけのことを言うのに"},
        { "location": "1501/TALK"    , "narrator": "アーヤ", "text": "とても時間がかかっちゃったわ"},
        { "location": "1503/SEL"     , "narrator": "", "text": "そうだね　　　　"},
        { "location": "1504/SEL"     , "narrator": "", "text": "それだけ大事なことでしょ？"},
        { "location": "1505/ACT"     , "narrator": "", "text": "そうだね　　　　"},
        { "location": "1506/TALK"    , "narrator": "アーヤ", "text": "ね？"},
        { "location": "1507/TALK"    , "narrator": "アーヤ", "text": "本当に"},
        { "location": "1508/TALK"    , "narrator": "アーヤ", "text": "それだけのことなのに"},
        { "location": "1509/ACT"     , "narrator": "", "text": "それだけ大事なことでしょ？"},
        { "location": "1510/TALK"    , "narrator": "アーヤ", "text": "そうなの"},
        { "location": "1511/TALK"    , "narrator": "アーヤ", "text": "だから"},
        { "location": "1512/TALK"    , "narrator": "アーヤ", "text": "なかなか言えなかったのね"},
        { "location": "1514/TALK"    , "narrator": "アーヤ", "text": "だけど"},
        { "location": "1515/TALK"    , "narrator": "アーヤ", "text": "これからは"},
        { "location": "1516/TALK"    , "narrator": "アーヤ", "text": "ちゃんと言うから"},
        { "location": "1517/TALK"    , "narrator": "アーヤ", "text": "改めてよろしくね"},
        { "location": "1520/TALK"    , "narrator": "アーヤ", "text": "大好きよ"},
        { "location": "1523/TALK"    , "narrator": "ボイスメール", "text": "早い者勝ちってわけじゃないけど"},
        { "location": "1418/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>900pt.</b></color></size>\nアップしました！"},
        { "location": "1535/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【早い者勝ちってわけじゃないけど】</color>\nをゲットしました！"}
    ]
}
