    "entry":
    [
        { "location": "171/SCENARIO", "narrator": "", "text": "036_見上げてみれば"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "どんな時も"},
        { "location": "197/TALK"    , "narrator": "ガブリエラ", "text": "空を見上げるの"},
        { "location": "199/SEL"     , "narrator": "", "text": "新しい詩？"},
        { "location": "200/SEL"     , "narrator": "", "text": "見下ろしてもいいんじゃない"},
        { "location": "201/SEL"     , "narrator": "", "text": "悲しいことがあった？"},
        { "location": "202/ACT"     , "narrator": "", "text": "新しい詩？"},
        { "location": "203/TALK"    , "narrator": "ガブリエラ", "text": "そういうわけじゃないわ"},
        { "location": "204/ACT"     , "narrator": "", "text": "見下ろしてもいいんじゃない"},
        { "location": "205/TALK"    , "narrator": "ガブリエラ", "text": "それはちょっと"},
        { "location": "206/TALK"    , "narrator": "ガブリエラ", "text": "難しいと思うわ？"},
        { "location": "207/ACT"     , "narrator": "", "text": "悲しいことがあった？"},
        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "心配させちゃったみたいね"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "そうじゃないのよ"},
        { "location": "212/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$は優しい子ね"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "空はいつも違う顔をしてるけど"},
        { "location": "215/TALK"    , "narrator": "ガブリエラ", "text": "それでも広いってところは変わらなくて"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "ごめんちょっと自分でも"},
        { "location": "221/TALK"    , "narrator": "ガブリエラ", "text": "何が言いたいのかわからなくなったわ"},
        { "location": "223/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "224/TALK"    , "narrator": "ガブリエラ", "text": "ちょっとだけ"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "お話がしたかったの"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "何でもいいから"},
        { "location": "228/SEL"     , "narrator": "", "text": "そっか"},
        { "location": "229/SEL"     , "narrator": "", "text": "少しはすっきりした？"},
        { "location": "230/SEL"     , "narrator": "", "text": "いつでも側にいるからね"},
        { "location": "231/ACT"     , "narrator": "", "text": "そっか"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "おやすみなさい"},
        { "location": "234/ACT"     , "narrator": "", "text": "少しはすっきりした？"},
        { "location": "235/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "おやすみなさい"},
        { "location": "237/ACT"     , "narrator": "", "text": "いつでも側にいるからね"},
        { "location": "239/TALK"    , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$ならきっとそう言ってくれるって思ってた"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "だいすきよ"}
    ]
}
