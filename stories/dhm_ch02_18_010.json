    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "030_夜食をどうぞ"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "久しぶりにギャヴィのスープ飲んだわ"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "やっぱりおいしいわね"},
        { "location": "35/SEL"    , "narrator": "", "text": "そんなに美味しかったの？"},
        { "location": "36/SEL"    , "narrator": "", "text": "レポートは終わったの？"},
        { "location": "37/SEL"    , "narrator": "", "text": "仲良いんだね"},
        { "location": "38/ACT"    , "narrator": "", "text": "そんなに美味しかったの？"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "おいしいわよ(*^^*)"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "ポーランド料理ってよくしらないけど"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "結構いい線いってるんじゃないかしら"},
        { "location": "44/SEL"    , "narrator": "", "text": "そうなんだ"},
        { "location": "45/SEL"    , "narrator": "", "text": "食べてみたいな"},
        { "location": "46/ACT"    , "narrator": "", "text": "そうなんだ"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "機会があったら食べてみるといいわよ"},
        { "location": "49/ACT"    , "narrator": "", "text": "食べてみたいな"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "食べられるといいわね"},
        { "location": "53/ACT"    , "narrator": "", "text": "レポートは終わったの？"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "一応ね"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "朝がんばって書いたの"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "スープ飲んだら眠くなっちゃって"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "寝ちゃったのよね"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "意外と"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "なんとかなるものね"},
        { "location": "62/ACT"    , "narrator": "", "text": "仲良いんだね"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "いい"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "のかしらね？"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "ホントはちょっと"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "自信g内の"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "あ"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "自信がないの"},
        { "location": "72/SEL"    , "narrator": "", "text": "自信？"},
        { "location": "73/SEL"    , "narrator": "", "text": "どういうこと？"},
        { "location": "74/ACT"    , "narrator": "", "text": "自信？"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "そう"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "不安になるの"},
        { "location": "78/ACT"    , "narrator": "", "text": "どういうこと？"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "そのまんまよ"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "不安になるの"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "すごく甘えてくるときもあるし"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "びっくりするほど突っかかってくるときもあるし"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "私の方が年上なんだから"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "わかってあげたいとは思うわ"}
    ]
}
