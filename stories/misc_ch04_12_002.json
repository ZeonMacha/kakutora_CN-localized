    "entry":
    [
        { "location": "89/SCENARIO", "narrator": "", "text": "017_ペンギンは明日も飛べやしない"},
        { "location": "114/TALK"   , "narrator": "みやび", "text": "貴殿は空を飛べるかね"},
        { "location": "116/TALK"   , "narrator": "みやび", "text": "こーのーおおぞらをー"},
        { "location": "119/SEL"    , "narrator": "", "text": "まさか"},
        { "location": "120/SEL"    , "narrator": "", "text": "頑張ってみようかな…？"},
        { "location": "121/SEL"    , "narrator": "", "text": "見くびらないでくれたまえ"},
        { "location": "122/ACT"    , "narrator": "", "text": "まさか"},
        { "location": "123/TALK"   , "narrator": "みやび", "text": "せやな"},
        { "location": "124/ACT"    , "narrator": "", "text": "頑張ってみようかな…？"},
        { "location": "125/TALK"   , "narrator": "みやび", "text": "がんばれ！"},
        { "location": "126/ACT"    , "narrator": "", "text": "見くびらないでくれたまえ"},
        { "location": "128/TALK"   , "narrator": "みやび", "text": "おお"},
        { "location": "129/TALK"   , "narrator": "みやび", "text": "ということは"},
        { "location": "131/SEL"    , "narrator": "", "text": "とべません"},
        { "location": "132/ACT"    , "narrator": "", "text": "とべません"},
        { "location": "133/TALK"   , "narrator": "みやび", "text": "ノリ突っ込みか"},
        { "location": "134/TALK"   , "narrator": "みやび", "text": "やってくれる"},
        { "location": "137/TALK"   , "narrator": "みやび", "text": "で？"},
        { "location": "138/TALK"   , "narrator": "みやび", "text": "実際どうなのよ"},
        { "location": "140/SEL"    , "narrator": "", "text": "だから飛べないって"},
        { "location": "141/SEL"    , "narrator": "", "text": "ご想像にお任せします"},
        { "location": "142/ACT"    , "narrator": "", "text": "だから飛べないって"},
        { "location": "143/TALK"   , "narrator": "みやび", "text": "とんちもなしか"},
        { "location": "144/ACT"    , "narrator": "", "text": "ご想像にお任せします"},
        { "location": "145/TALK"   , "narrator": "みやび", "text": "よし"},
        { "location": "146/TALK"   , "narrator": "みやび", "text": "妄想する"},
        { "location": "148/TALK"   , "narrator": "みやび", "text": "実際"},
        { "location": "149/TALK"   , "narrator": "みやび", "text": "適性があっても経験不足なら無理ってこともあるし"},
        { "location": "150/TALK"   , "narrator": "みやび", "text": "辛いな"},
        { "location": "151/TALK"   , "narrator": "みやび", "text": "色々と"},
        { "location": "153/SEL"    , "narrator": "", "text": "何の話？"},
        { "location": "154/SEL"    , "narrator": "", "text": "飛ぶのに適性はないかな……"},
        { "location": "155/SEL"    , "narrator": "", "text": "$me$に話せば楽になるかもよ"},
        { "location": "156/ACT"    , "narrator": "", "text": "何の話？"},
        { "location": "157/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "158/TALK"   , "narrator": "みやび", "text": "こっちの話"},
        { "location": "159/ACT"    , "narrator": "", "text": "飛ぶのに適性はないかな……"},
        { "location": "160/TALK"   , "narrator": "みやび", "text": "いいや"},
        { "location": "161/TALK"   , "narrator": "みやび", "text": "実は適不適があるぞね"},
        { "location": "162/ACT"    , "narrator": "", "text": "$me$に話せば楽になるかもよ"},
        { "location": "164/TALK"   , "narrator": "みやび", "text": "ほう"},
        { "location": "165/TALK"   , "narrator": "みやび", "text": "なかなかの策士ぞね"},
        { "location": "166/TALK"   , "narrator": "みやび", "text": "しかし"},
        { "location": "167/TALK"   , "narrator": "みやび", "text": "楽にはならぬ"},
        { "location": "168/TALK"   , "narrator": "みやび", "text": "それがうちぞね"}
    ]
}
