    [
        { "location": "167/SCENARIO", "narrator": "", "text": "ネコのあくび"},
        { "location": "192/TALK"    , "narrator": "つばめ", "text": "世界中の猫が"},
        { "location": "193/TALK"    , "narrator": "つばめ", "text": "一斉にあくびをする瞬間があるんだって"},
        { "location": "194/TALK"    , "narrator": "つばめ", "text": "知ってた？"},
        { "location": "196/SEL"     , "narrator": "", "text": "知らなかった"},
        { "location": "197/SEL"     , "narrator": "", "text": "知ってたし"},
        { "location": "198/SEL"     , "narrator": "", "text": "誰に騙されたの"},
        { "location": "199/ACT"     , "narrator": "", "text": "知らなかった"},
        { "location": "200/TALK"    , "narrator": "つばめ", "text": "そぅだょね(*´︶`*)"},
        { "location": "202/TALK"    , "narrator": "つばめ", "text": "すごぃこと知っちゃったね(*´︶`*)"},
        { "location": "203/ACT"     , "narrator": "", "text": "知ってたし"},
        { "location": "204/TALK"    , "narrator": "つばめ", "text": "ぇ"},
        { "location": "205/TALK"    , "narrator": "つばめ", "text": "結構有名なの？"},
        { "location": "206/ACT"     , "narrator": "", "text": "誰に騙されたの"},
        { "location": "207/TALK"    , "narrator": "つばめ", "text": "ぇ"},
        { "location": "208/TALK"    , "narrator": "つばめ", "text": "嘘なの？"},
        { "location": "210/SEL"     , "narrator": "", "text": "常識で考えてみて"},
        { "location": "211/SEL"     , "narrator": "", "text": "世界中の猫が起きてることがそもそもある？"},
        { "location": "212/ACT"     , "narrator": "", "text": "常識で考えてみて"},
        { "location": "213/TALK"    , "narrator": "つばめ", "text": "ぇぇー(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "214/TALK"    , "narrator": "つばめ", "text": "なんだか冷たいね"},
        { "location": "215/ACT"     , "narrator": "", "text": "世界中の猫が起きてることがそもそもある？"},
        { "location": "217/TALK"    , "narrator": "つばめ", "text": "そう言われれば"},
        { "location": "218/TALK"    , "narrator": "つばめ", "text": "昼のところも夜のところもあるし"},
        { "location": "219/TALK"    , "narrator": "つばめ", "text": "そんなことはないかも|д･)"},
        { "location": "221/TALK"    , "narrator": "つばめ", "text": "その瞬間を目撃できれば"},
        { "location": "222/TALK"    , "narrator": "つばめ", "text": "どんな願いも叶うんだって"},
        { "location": "223/TALK"    , "narrator": "つばめ", "text": "みやびさん言ってたのに"},
        { "location": "225/TALK"    , "narrator": "つばめ", "text": "嘘だったなんて"},
        { "location": "226/TALK"    , "narrator": "つばめ", "text": "もぅ"},
        { "location": "228/TALK"    , "narrator": "つばめ", "text": "想像したら"},
        { "location": "229/TALK"    , "narrator": "つばめ", "text": "なんだかちょっと楽しいのにね"}
    ]
}
