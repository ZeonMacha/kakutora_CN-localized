{
    "dir": "chap18/daydra/dd_ch03_18_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "18302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "違う気がする＜前編＞"
    },
    "entry":
    [
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "…ここにもない。\nおかしいわね…。"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "フ、の棚はここからの\nはずなのに…。"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "う～ん…。"},
        { "location": "33/SEL"    , "narrator": "", "text": "何してるの？"},
        { "location": "34/ACT"    , "narrator": "", "text": "何してるの？"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと探し物よ"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "でも見つからないの"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "おかしいわ"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "人気ないのかしら？"},
        { "location": "56/SEL"    , "narrator": "", "text": "何を探してるの？"},
        { "location": "57/ACT"    , "narrator": "", "text": "何を探してるの？"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "ＣＤよ"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "わかるでしょ？"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "メノウのＣＤよ"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "別に"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "聞きたいわけじゃないから"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "ファンじゃないし"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "たくさん怒ったからかしらね？"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと吹っ切れたのかも"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "聞いてみようと思ったのよ"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "もしかしたら"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "知れるかもしれないでしょう？"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "神楽のこと"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "ちょっとだけでも"},
        { "location": "77/SEL"    , "narrator": "", "text": "聞いたことないんだっけ？"},
        { "location": "78/SEL"    , "narrator": "", "text": "それで何か知れるかな？"},
        { "location": "79/ACT"    , "narrator": "", "text": "聞いたことないんだっけ？"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよ"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "流行りらしいけど"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "まだ聞いたことなくて"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "よく耳にはするけど"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "いい声よね"},
        { "location": "88/ACT"    , "narrator": "", "text": "それで何か知れるかな？"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "さあ？"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "そんなの知らないわよ"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "メノウのことは知れるんじゃないかしら？"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "売れてる歌手程度にしか知らなかったし"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "メノウをやってるときの神楽が"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "どんな感じなのかだけでも知りたいのよ"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "ＣＤで全部知れるわけないし"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "最初の一歩？"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "それくらいの気持ちよ"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "…でも、肝心のＣＤが\n見つからないのよね。"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "この辺にあるはず\nなんだけど…。"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "…あれ？"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "アーヤ。"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "あら？　ギャヴィも\nＣＤ見に来たの？"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "ええ、神楽――"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "じゃなくて、\nメノウのＣＤをね…。"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "ギャヴィも！？"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "え？　それじゃあ\nアーヤも？"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "ふふっ、考えることは\n同じね。"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "そうみたいね。\nけど、メノウのＣＤ\nなかったでしょ？"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "ああ、それなら\n向こうにコーナーが\n作られてたわ。"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "ああ、それでか…。"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "あれ？　でもアーヤ、\nＣＤ持ってないじゃ\nない。"},
        { "location": "132/TALK"  , "narrator": "アーヤ", "text": "…買おうとは思ったん\nだけど…。"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "なんか、これでいいの\nかな、って気になって\nきちゃって…。"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "どういうこと？"},
        { "location": "136/TALK"  , "narrator": "アーヤ", "text": "だって、メノウの\n正体を卯月はずっと\n隠してたんだもの。"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "それを、こんな形で\n知ったからって――"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "メノウのＣＤを聞いて\nみるっていうのは、\nなんか違くない？"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "だから、\n何が違うのよ？"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "…なんか、卑怯な\n感じがするのよ。"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "卑怯って…ちょっと\n気にし過ぎじゃない？"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "そうかしら…。"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "そうよ。"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "ていうか、そんなこと\n言われたらあたしまで\n買いづらいじゃない。"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "ご、ごめん…。"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "もぅ…。"},
        { "location": "148/TALK"  , "narrator": "ガブリエラ", "text": "…でも、アーヤの\n言ってることも\n一理あるかも。"},
        { "location": "149/TALK"  , "narrator": "ガブリエラ", "text": "知られたくなくて\n隠してたこと\nなんだもの。"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "そこから色々知ろうと\n思うのって、ちょっと\n卑怯なのかも…。"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "だとしたら…。"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "逆に離れられることに\nなっちゃうの？"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "…どうしよう。"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "　"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "あ、$handle$！\nいらっしゃい！"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "さて、今日はどんな\n悩みなのかしらね！"},
        { "location": "239/SEL"   , "narrator": "", "text": "ここに来ると平和で和む"},
        { "location": "240/SEL"   , "narrator": "", "text": "ガブリエラは本当に何ともないの？"},
        { "location": "241/ACT"   , "narrator": "", "text": "ここに来ると平和で和む"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "え？　どうしたの？\n急に。"},
        { "location": "243/ACT"   , "narrator": "", "text": "ガブリエラは本当に何ともないの？"},
        { "location": "244/TALK"  , "narrator": "ガブリエラ", "text": "え？\n何ともない…って？\n何が？"},
        { "location": "246/SEL"   , "narrator": "", "text": "他の子のココロの中はだいぶきな臭くなってるから"},
        { "location": "247/ACT"   , "narrator": "", "text": "他の子のココロの中はだいぶきな臭くなってるから"},
        { "location": "249/TALK"  , "narrator": "ガブリエラ", "text": "こーら。他の乙女のお話を\n乙女のココロの部屋で\n言ったりしないのよ？"},
        { "location": "250/TALK"  , "narrator": "ガブリエラ", "text": "まあ、みんな色々\n問題を抱えてそう\nだものね。"},
        { "location": "251/TALK"  , "narrator": "ガブリエラ", "text": "でもあたしは大丈夫！\nみんなと違って\n幸せにやってるから！"},
        { "location": "252/SEL"   , "narrator": "", "text": "いや、そういう個人的な悩みで修羅場ってるわけじゃなくて…"},
        { "location": "253/SEL"   , "narrator": "", "text": "いや、それは嘘でしょ"},
        { "location": "254/ACT"   , "narrator": "", "text": "いや、そういう個人的な悩みで修羅場ってるわけじゃなくて…"},
        { "location": "255/TALK"  , "narrator": "ガブリエラ", "text": "そうなの？\n個人的な悩みじゃないって\nことは、どういう事なの？"},
        { "location": "256/SEL"   , "narrator": "", "text": "もっとこう、世界全体の潮流っていうか"},
        { "location": "257/SEL"   , "narrator": "", "text": "いや、忘れてくれ"},
        { "location": "258/ACT"   , "narrator": "", "text": "もっとこう、世界全体の潮流っていうか"},
        { "location": "260/TALK"  , "narrator": "ガブリエラ", "text": "……ふーん。\nそういうのがあるのね。"},
        { "location": "261/TALK"  , "narrator": "ガブリエラ", "text": "よくわからないけど、\nあたしはいつも通り\n元気にやってるだけよ？"},
        { "location": "262/ACT"   , "narrator": "", "text": "いや、忘れてくれ"},
        { "location": "263/TALK"  , "narrator": "ガブリエラ", "text": "ええっ？\n$handle$から\n話を振ってきたのに。"},
        { "location": "264/TALK"  , "narrator": "ガブリエラ", "text": "まあいいわ。"},
        { "location": "266/ACT"   , "narrator": "", "text": "いや、それは嘘でしょ"},
        { "location": "267/TALK"  , "narrator": "ガブリエラ", "text": "どうしてよ。"},
        { "location": "269/SEL"   , "narrator": "", "text": "ココロスフィアの中で色々見たから"},
        { "location": "270/SEL"   , "narrator": "", "text": "いや、やっぱり何でもない"},
        { "location": "271/ACT"   , "narrator": "", "text": "ココロスフィアの中で色々見たから"},
        { "location": "273/TALK"  , "narrator": "ガブリエラ", "text": "ふーん、なるほどね。"},
        { "location": "274/TALK"  , "narrator": "ガブリエラ", "text": "まあ確かに、あんたが\n言う事は間違ってないわ。"},
        { "location": "275/TALK"  , "narrator": "ガブリエラ", "text": "ココロの中に何一つ\n傷を持っていない人なんて\n存在しない。"},
        { "location": "276/TALK"  , "narrator": "ガブリエラ", "text": "けど、それと\n『幸せにやっている』\nのとは全然別なの。"},
        { "location": "277/TALK"  , "narrator": "ガブリエラ", "text": "わかるかしら？\nこの違い。"},
        { "location": "278/SEL"   , "narrator": "", "text": "わかる"},
        { "location": "279/SEL"   , "narrator": "", "text": "わからない"},
        { "location": "280/ACT"   , "narrator": "", "text": "わかる"},
        { "location": "281/TALK"  , "narrator": "ガブリエラ", "text": "よかった。\n$handle$が\n常識的な人で。"},
        { "location": "282/ACT"   , "narrator": "", "text": "わからない"},
        { "location": "283/TALK"  , "narrator": "ガブリエラ", "text": "…わからない、ですって？"},
        { "location": "284/TALK"  , "narrator": "ガブリエラ", "text": "じゃああんたは、\n３年前に結婚詐欺にあって\nお金も奪われて――"},
        { "location": "285/TALK"  , "narrator": "ガブリエラ", "text": "１年間立ち直れない\nくらいになったとする。"},
        { "location": "286/TALK"  , "narrator": "ガブリエラ", "text": "それから５年後、\n傷が癒えてとても素敵な\n人と結婚したとして。"},
        { "location": "287/TALK"  , "narrator": "ガブリエラ", "text": "その時、「今幸せ」と\n言ったとしても、それは\n嘘ということになるのね。"},
        { "location": "288/TALK"  , "narrator": "ガブリエラ", "text": "一度背負った十字架は\n一生面と向かって生きろと\nそう言うのね！"},
        { "location": "289/SEL"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "290/ACT"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "292/TALK"  , "narrator": "ガブリエラ", "text": "その十字架の中身だって、\nまだろくに知りもしない\nくせに！"},
        { "location": "293/SEL"   , "narrator": "", "text": "ごめん、ごめんね！"},
        { "location": "294/SEL"   , "narrator": "", "text": "ガブリエラ、既にその歳で結婚詐欺に遭ってるの！？"},
        { "location": "295/ACT"   , "narrator": "", "text": "ごめん、ごめんね！"},
        { "location": "296/TALK"  , "narrator": "ガブリエラ", "text": "……え？"},
        { "location": "297/TALK"  , "narrator": "ガブリエラ", "text": "…あ…　…"},
        { "location": "298/TALK"  , "narrator": "ガブリエラ", "text": "…ご、ごめん。"},
        { "location": "299/TALK"  , "narrator": "ガブリエラ", "text": "あたしもちょっと\nどうかしてたわ。"},
        { "location": "300/TALK"  , "narrator": "ガブリエラ", "text": "と、とにかく！\nこのお話はお終い！"},
        { "location": "301/TALK"  , "narrator": "ガブリエラ", "text": "あんたも今のことは\n忘れること。いいわね？"},
        { "location": "302/SEL"   , "narrator": "", "text": "はい"},
        { "location": "303/ACT"   , "narrator": "", "text": "はい"},
        { "location": "305/ACT"   , "narrator": "", "text": "ガブリエラ、既にその歳で結婚詐欺に遭ってるの！？"},
        { "location": "306/TALK"  , "narrator": "ガブリエラ", "text": "……"},
        { "location": "313/ACT"   , "narrator": "", "text": "いや、やっぱり何でもない"},
        { "location": "314/TALK"  , "narrator": "ガブリエラ", "text": "え？　そうなの？\nまあいいけど。"},
        { "location": "317/SEL"   , "narrator": "", "text": "いや、何となく言ってみただけ"},
        { "location": "318/ACT"   , "narrator": "", "text": "いや、何となく言ってみただけ"},
        { "location": "320/TALK"  , "narrator": "ガブリエラ", "text": "はあ？\nなにそれ？"},
        { "location": "321/TALK"  , "narrator": "ガブリエラ", "text": "あまり適当なことを\n言わないで欲しいわね。"},
        { "location": "323/TALK"  , "narrator": "ガブリエラ", "text": "まあ、今だけは\n許してあげるわ。"},
        { "location": "328/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ今回も、\n張り切っていくわよ。"},
        { "location": "335/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x122番地から\n0x9BF番地へ。"},
        { "location": "350/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了っ♪"},
        { "location": "355/TALK"  , "narrator": "ガブリエラ", "text": "神楽のこと……かぁ。"},
        { "location": "356/TALK"  , "narrator": "ガブリエラ", "text": "あんたは、\nどうした方がいいと思う？"},
        { "location": "357/SEL"   , "narrator": "", "text": "ちゃんとした情報を知る努力をすべきだと思う"},
        { "location": "358/SEL"   , "narrator": "", "text": "個人のプライバシーは大事にすべきだから詮索しない"},
        { "location": "359/ACT"   , "narrator": "", "text": "ちゃんとした情報を知る努力をすべきだと思う"},
        { "location": "361/TALK"  , "narrator": "ガブリエラ", "text": "それが、神楽にとって\n嫌なことだったとしても？"},
        { "location": "362/SEL"   , "narrator": "", "text": "それでも"},
        { "location": "363/SEL"   , "narrator": "", "text": "それはよくない"},
        { "location": "364/ACT"   , "narrator": "", "text": "それでも"},
        { "location": "365/TALK"  , "narrator": "ガブリエラ", "text": "へえっ。\nちょっと意外だったわ。"},
        { "location": "366/TALK"  , "narrator": "ガブリエラ", "text": "まあでも、\nびっくりはしたけど、\n共感はできるわね。"},
        { "location": "367/TALK"  , "narrator": "ガブリエラ", "text": "本人が嫌がることと、\n結果的にみんなの幸せに\n繋がることは別だもの。"},
        { "location": "368/TALK"  , "narrator": "ガブリエラ", "text": "でも、それを見切りで\nやる場合には、違った時の\n責任を抱えることになる。"},
        { "location": "369/TALK"  , "narrator": "ガブリエラ", "text": "仕掛ける人に、\nその覚悟があるかどうか。\nそれだけの事なのよ。"},
        { "location": "370/ACT"   , "narrator": "", "text": "それはよくない"},
        { "location": "371/TALK"  , "narrator": "ガブリエラ", "text": "まあ、そうよね。\n普通はそう考えると\n思うし。"},
        { "location": "372/TALK"  , "narrator": "ガブリエラ", "text": "でも、その考え方も\n割と危険じゃないかしら。"},
        { "location": "373/TALK"  , "narrator": "ガブリエラ", "text": "赤ちゃんが甘い物ばかり\n欲しがるからって、おかし\nばかりあげていたら――"},
        { "location": "374/TALK"  , "narrator": "ガブリエラ", "text": "幸せな未来は\nあまり想像できないもの。\n少なくともあたしには。"},
        { "location": "376/ACT"   , "narrator": "", "text": "個人のプライバシーは大事にすべきだから詮索しない"},
        { "location": "379/TALK"  , "narrator": "ガブリエラ", "text": "立派な人ね。"},
        { "location": "380/TALK"  , "narrator": "ガブリエラ", "text": "違うか。\nあたしにその辺のモラルが\n欠如してるだけ。"},
        { "location": "381/TALK"  , "narrator": "ガブリエラ", "text": "もちろん、悪意のある\nものはダメだと思う。"},
        { "location": "382/TALK"  , "narrator": "ガブリエラ", "text": "それは、詮索するも\nしないも、どちらを\nとるにしても。"},
        { "location": "383/TALK"  , "narrator": "ガブリエラ", "text": "興味本位や、何かを暴いて\n貶めようとして情報を\n集めるなんて最低だし――"},
        { "location": "384/TALK"  , "narrator": "ガブリエラ", "text": "逆に、その子が転落する\nのをわかっていて、何も\nしない聞かないのも最低。"},
        { "location": "385/TALK"  , "narrator": "ガブリエラ", "text": "要は、想いだと思うのよ。"},
        { "location": "386/TALK"  , "narrator": "ガブリエラ", "text": "最近は言葉が一人歩き\nしてる気がする。"},
        { "location": "387/TALK"  , "narrator": "ガブリエラ", "text": "マニュアルが\n出来すぎてるのよね。"},
        { "location": "388/TALK"  , "narrator": "ガブリエラ", "text": "だから、これは悪、これは\n善…って、理由も聞かずに\n決めつけられる。"},
        { "location": "389/TALK"  , "narrator": "ガブリエラ", "text": "でもそれ、罠だから。"},
        { "location": "390/SEL"   , "narrator": "", "text": "すごい難しいこと言っててびっくりしてるんだけど"},
        { "location": "391/SEL"   , "narrator": "", "text": "すごい屁理屈言っててびっくりしてるんだけど"},
        { "location": "392/ACT"   , "narrator": "", "text": "すごい難しいこと言っててびっくりしてるんだけど"},
        { "location": "393/TALK"  , "narrator": "ガブリエラ", "text": "ごく当たり前のことを\n言っただけだけど？"},
        { "location": "394/TALK"  , "narrator": "ガブリエラ", "text": "少なくとも祖国では、\nだけど。"},
        { "location": "395/ACT"   , "narrator": "", "text": "すごい屁理屈言っててびっくりしてるんだけど"},
        { "location": "396/TALK"  , "narrator": "ガブリエラ", "text": "…まあいいわよ。"},
        { "location": "397/TALK"  , "narrator": "ガブリエラ", "text": "あんたが\n理解してくれるって\n思ってたわけじゃない。"},
        { "location": "398/TALK"  , "narrator": "ガブリエラ", "text": "ただ、何事も努力を\n怠らないってことを\n実践しただけだから。"},
        { "location": "401/TALK"  , "narrator": "ガブリエラ", "text": "とにかく、あたしの\n答えは決まってる。"},
        { "location": "402/TALK"  , "narrator": "ガブリエラ", "text": "神楽のことをもっと\n色々知って、ちゃんと\n理解したいのよ。"},
        { "location": "403/TALK"  , "narrator": "ガブリエラ", "text": "今後どう対応してくかは、\nその結果考える。"},
        { "location": "404/TALK"  , "narrator": "ガブリエラ", "text": "そうしないと、\nフェアじゃなくない？"},
        { "location": "405/SEL"   , "narrator": "", "text": "そうだね"},
        { "location": "406/SEL"   , "narrator": "", "text": "それには賛同できない"},
        { "location": "407/ACT"   , "narrator": "", "text": "そうだね"},
        { "location": "408/TALK"  , "narrator": "ガブリエラ", "text": "でしょ？"},
        { "location": "409/TALK"  , "narrator": "ガブリエラ", "text": "だから、今回も\n協力してよね？"},
        { "location": "410/ACT"   , "narrator": "", "text": "それには賛同できない"},
        { "location": "411/TALK"  , "narrator": "ガブリエラ", "text": "そう。残念。"},
        { "location": "412/TALK"  , "narrator": "ガブリエラ", "text": "でも、考え方は\n人それぞれだから\n仕方ないわよね。"},
        { "location": "413/TALK"  , "narrator": "ガブリエラ", "text": "まあ、気が向いたら\n協力してよね。"},
        { "location": "416/SEL"   , "narrator": "", "text": "それにしても、判断がアーヤと正反対で面白い"},
        { "location": "417/ACT"   , "narrator": "", "text": "それにしても、判断がアーヤと正反対で面白い"},
        { "location": "419/TALK"  , "narrator": "ガブリエラ", "text": "アーヤも神楽のことで\n悩んでるってこと？"},
        { "location": "420/SEL"   , "narrator": "", "text": "そう。そして「詮索しない」ことを選んでる"},
        { "location": "421/ACT"   , "narrator": "", "text": "そう。そして「詮索しない」ことを選んでる"},
        { "location": "423/TALK"  , "narrator": "ガブリエラ", "text": "そう。\nまあ、特になんの驚きも\nないわね。"},
        { "location": "424/TALK"  , "narrator": "ガブリエラ", "text": "アーヤらしいっていうか。"},
        { "location": "426/TALK"  , "narrator": "ガブリエラ", "text": "$handle$は\nどっちかというと\nあたしに近い考え方よね。"},
        { "location": "427/TALK"  , "narrator": "ガブリエラ", "text": "ま、本心はどうだか\nわからないけど。"},
        { "location": "429/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "430/TALK"  , "narrator": "ガブリエラ", "text": "でも、\nちょっとだけ嬉しい。"},
        { "location": "431/TALK"  , "narrator": "ガブリエラ", "text": "だってあたし――"},
        { "location": "432/TALK"  , "narrator": "ガブリエラ", "text": "ううん。\nそんなことはいいの。"},
        { "location": "433/TALK"  , "narrator": "ガブリエラ", "text": "あたしはやっぱり\n$handle$のことが\n好き。"},
        { "location": "434/TALK"  , "narrator": "ガブリエラ", "text": "…大好き。"},
        { "location": "436/TALK"  , "narrator": "ガブリエラ", "text": "ただそれだけ。"},
        { "location": "438/TALK"  , "narrator": "ガブリエラ", "text": "$handle$は\nどっちかというと\nアーヤに近い考え方よね。"},
        { "location": "439/TALK"  , "narrator": "ガブリエラ", "text": "アーヤもあれで\nかなり心配性だし、\n気苦労も絶えないから――"},
        { "location": "440/TALK"  , "narrator": "ガブリエラ", "text": "あんたみたいな人が\n傍にいたら、きっと\n安心できると思うわね。"},
        { "location": "441/TALK"  , "narrator": "ガブリエラ", "text": "これは、\n本当に心の底から\n思ってること……。"},
        { "location": "442/TALK"  , "narrator": "ガブリエラ", "text": "これからもずっと、\nアーヤの傍で\n支えてあげて欲しいのよ。"},
        { "location": "443/TALK"  , "narrator": "ガブリエラ", "text": "あたしじゃどうしたって\n限界があるから……。"},
        { "location": "446/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ今回も\n張り切って行くわよ！"},
        { "location": "447/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！"},
        { "location": "28/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月27日　3:15 PM</color>\nとある夏休み直前の放課後、都内某CDショップにて。"},
        { "location": "182/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "184/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "186/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "188/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "190/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
