        { "location": "222/SCENARIO", "narrator": "", "text": "430_錯覚かもしれないけど"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "恋なんて全部錯覚"},
        { "location": "248/TALK"    , "narrator": "ガブリエラ", "text": "会いたいなんて全部妄想"},
        { "location": "249/TALK"    , "narrator": "ガブリエラ", "text": "それでも、やっぱり"},
        { "location": "251/SEL"     , "narrator": "", "text": "さみしいよ"},
        { "location": "252/SEL"     , "narrator": "", "text": "会いたいな"},
        { "location": "253/ACT"     , "narrator": "", "text": "さみしいよ"},
        { "location": "254/ACT"     , "narrator": "", "text": "会いたいな"},
        { "location": "258/SEL"     , "narrator": "", "text": "それじゃダメかな"},
        { "location": "259/ACT"     , "narrator": "", "text": "それじゃダメかな"},
        { "location": "262/TALK"    , "narrator": "ガブリエラ", "text": "わからないわ"},
        { "location": "264/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "266/TALK"    , "narrator": "ガブリエラ", "text": "私も"},
        { "location": "267/TALK"    , "narrator": "ガブリエラ", "text": "なんだかずっと"},
        { "location": "268/TALK"    , "narrator": "ガブリエラ", "text": "さみしいって思ってたのよ"},
        { "location": "270/SEL"     , "narrator": "", "text": "話ができて嬉しいな"},
        { "location": "271/ACT"     , "narrator": "", "text": "話ができて嬉しいな"},
        { "location": "273/TALK"    , "narrator": "ガブリエラ", "text": "本気で言ってる？"},
        { "location": "275/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "276/SEL"     , "narrator": "", "text": "当然"},
        { "location": "277/SEL"     , "narrator": "", "text": "まあね"},
        { "location": "278/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "279/TALK"    , "narrator": "ガブリエラ", "text": "本当かしら？"},
        { "location": "280/ACT"     , "narrator": "", "text": "当然"},
        { "location": "281/TALK"    , "narrator": "ガブリエラ", "text": "当たり前みたいに言うわね・・・"},
        { "location": "282/ACT"     , "narrator": "", "text": "まあね"},
        { "location": "283/TALK"    , "narrator": "ガブリエラ", "text": "なんだか偉そうね"},
        { "location": "285/TALK"    , "narrator": "ガブリエラ", "text": "あのね"},
        { "location": "286/TALK"    , "narrator": "ガブリエラ", "text": "ここしばらく考えていたことがあるの"},
        { "location": "288/SEL"     , "narrator": "", "text": "うん"},
        { "location": "289/SEL"     , "narrator": "", "text": "言ってみて"},
        { "location": "290/SEL"     , "narrator": "", "text": "ぜひ聞きたいな"},
        { "location": "291/ACT"     , "narrator": "", "text": "うん"},
        { "location": "292/ACT"     , "narrator": "", "text": "言ってみて"},
        { "location": "293/ACT"     , "narrator": "", "text": "ぜひ聞きたいな"},
        { "location": "295/TALK"    , "narrator": "ガブリエラ", "text": "えっとね"},
        { "location": "296/TALK"    , "narrator": "ガブリエラ", "text": "怒らない？"},
        { "location": "298/SEL"     , "narrator": "", "text": "怒るかも"},
        { "location": "299/SEL"     , "narrator": "", "text": "絶対に怒らない"},
        { "location": "301/ACT"     , "narrator": "", "text": "怒るかも"},
        { "location": "302/TALK"    , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "303/TALK"    , "narrator": "ガブリエラ", "text": "よね・・・"},
        { "location": "304/TALK"    , "narrator": "ガブリエラ", "text": "でも、聞いて欲しいの"},
        { "location": "305/ACT"     , "narrator": "", "text": "絶対に怒らない"},
        { "location": "315/TALK"    , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "316/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "318/TALK"    , "narrator": "ガブリエラ", "text": "よかった・・・"},
        { "location": "320/TALK"    , "narrator": "ガブリエラ", "text": "ヒカルくんにすきなひとがいるって知ったとき、すごくショックだったの"},
        { "location": "321/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "322/TALK"    , "narrator": "ガブリエラ", "text": "でもね"},
        { "location": "323/TALK"    , "narrator": "ガブリエラ", "text": "その後、$handle$のことを怒らせて"},
        { "location": "324/TALK"    , "narrator": "ガブリエラ", "text": "お話しにくくなった時の方が、悲しいって思ったの"},
        { "location": "325/TALK"    , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "326/TALK"    , "narrator": "ガブリエラ", "text": "$handle$を怒らせちゃったことがすごく悲しかったの"},
        { "location": "328/TALK"    , "narrator": "ガブリエラ", "text": "嫌われたって思ってすごく悲しかったの"},
        { "location": "329/TALK"    , "narrator": "ガブリエラ", "text": "怒ってる？"},
        { "location": "331/SEL"     , "narrator": "", "text": "怒ってるよ"},
        { "location": "332/SEL"     , "narrator": "", "text": "何で怒るの？"},
        { "location": "333/SEL"     , "narrator": "", "text": "むしろうれしいよ"},
        { "location": "335/ACT"     , "narrator": "", "text": "怒ってるよ"},
        { "location": "336/TALK"    , "narrator": "ガブリエラ", "text": "そうだわよね"},
        { "location": "338/SEL"     , "narrator": "", "text": "それを聞いて怒るって思われたことにね"},
        { "location": "339/ACT"     , "narrator": "", "text": "それを聞いて怒るって思われたことにね"},
        { "location": "341/TALK"    , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "342/ACT"     , "narrator": "", "text": "何で怒るの？"},
        { "location": "343/TALK"    , "narrator": "ガブリエラ", "text": "えっと"},
        { "location": "344/TALK"    , "narrator": "ガブリエラ", "text": "ふざけて言ってるんじゃないかって"},
        { "location": "345/TALK"    , "narrator": "ガブリエラ", "text": "怒るんじゃないかって思ったの"},
        { "location": "346/ACT"     , "narrator": "", "text": "むしろうれしいよ"},
        { "location": "356/TALK"    , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "357/TALK"    , "narrator": "ガブリエラ", "text": "なにそれ"},
        { "location": "360/TALK"    , "narrator": "ガブリエラ", "text": "からかってるの？？？？"},
        { "location": "362/SEL"     , "narrator": "", "text": "本気だよ"},
        { "location": "363/ACT"     , "narrator": "", "text": "本気だよ"},
        { "location": "366/TALK"    , "narrator": "ガブリエラ", "text": "もう！！！！"},
        { "location": "368/TALK"    , "narrator": "ガブリエラ", "text": "やだ////////"},
        { "location": "370/TALK"    , "narrator": "ガブリエラ", "text": "じょうだんばっかり"},
        { "location": "372/TALK"    , "narrator": "ガブリエラ", "text": "えっと"},
        { "location": "373/TALK"    , "narrator": "ガブリエラ", "text": "またお話してくれる？"},
        { "location": "375/SEL"     , "narrator": "", "text": "もちろん"},
