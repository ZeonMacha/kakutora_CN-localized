{
    "dir": "chap21/daydra/dd_ch02_21_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "21256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "みやび家の謎"
    },
    "entry":
    [
        { "location": "283/SCENARIO", "narrator": "", "text": "みやび家の謎"},
        { "location": "300/TALK"    , "narrator": "アーヤ", "text": "何やってるの？"},
        { "location": "306/TALK"    , "narrator": "ガブリエラ", "text": "うわっ！？\nお、脅かさないでよ！"},
        { "location": "307/TALK"    , "narrator": "アーヤ", "text": "普通に声掛けただけ\nじゃない。"},
        { "location": "308/TALK"    , "narrator": "アーヤ", "text": "それより、私たちの\n部屋は向こうよ？"},
        { "location": "311/TALK"    , "narrator": "ガブリエラ", "text": "わかってるわよ。\nちょっと探検してるだけ。"},
        { "location": "312/TALK"    , "narrator": "アーヤ", "text": "探検って…。"},
        { "location": "315/TALK"    , "narrator": "アーヤ", "text": "まさか、奥の部屋に\n行こうとしてるんじゃ\nないでしょうね！？"},
        { "location": "316/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "317/TALK"    , "narrator": "アーヤ", "text": "到着した時、みやびに\n言われたこと忘れたの？"},
        { "location": "334/TALK"    , "narrator": "みやび", "text": "あ～、基本的に家の中は\n自由に散策してもろうて\nかまわんけんど――"},
        { "location": "336/TALK"    , "narrator": "みやび", "text": "一つだけ禁止事項な。\n奥の木戸の部屋、\nあそこは立ち入り禁止や。"},
        { "location": "340/TALK"    , "narrator": "ガブリエラ", "text": "木戸の部屋？"},
        { "location": "341/TALK"    , "narrator": "みやび", "text": "他の部屋とは違うき、\n見ればすぐわかるはずや。"},
        { "location": "342/TALK"    , "narrator": "みやび", "text": "それだけは\n守ってもらうぞね。"},
        { "location": "345/TALK"    , "narrator": "ガブリエラ", "text": "だから、なんで――"},
        { "location": "347/TALK"    , "narrator": "アーヤ", "text": "ダメよ、ギャヴィ。"},
        { "location": "348/TALK"    , "narrator": "アーヤ", "text": "ここはみやびのご家族も\n暮らしているんだから――"},
        { "location": "349/TALK"    , "narrator": "アーヤ", "text": "色々プライバシーが\nあるでしょ？"},
        { "location": "351/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "353/TALK"    , "narrator": "みやび", "text": "話が早くて助かる。\nそういうことやき、\n覚えといてな。"},
        { "location": "374/TALK"    , "narrator": "アーヤ", "text": "って、話したこと\n忘れたの？"},
        { "location": "375/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…そういう反応\nされるから、アーヤには\n見られたくなかったのよ。"},
        { "location": "379/TALK"    , "narrator": "ガブリエラ", "text": "大丈夫だってば。\n約束通り、あの部屋には\n入らないから。"},
        { "location": "380/TALK"    , "narrator": "アーヤ", "text": "本当？"},
        { "location": "381/TALK"    , "narrator": "ガブリエラ", "text": "覗くだけよ。"},
        { "location": "384/TALK"    , "narrator": "アーヤ", "text": "覗くのだってダメに\n決まってるでしょ！"},
        { "location": "385/TALK"    , "narrator": "ガブリエラ", "text": "でも、他の部屋はどこも\n出入り自由なのに――"},
        { "location": "386/TALK"    , "narrator": "ガブリエラ", "text": "あの部屋だけダメなんて、\n気になるじゃない。"},
        { "location": "387/TALK"    , "narrator": "アーヤ", "text": "それはそうだけど…。"},
        { "location": "388/TALK"    , "narrator": "アーヤ", "text": "…ギャヴィ、みやびの\n前では言わなかった\nけど――"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "この家って、\n凄く古いでしょ？"},
        { "location": "390/TALK"    , "narrator": "アーヤ", "text": "そういう家にはね、\nその家独自のルールが\n存在するものなの。"},
        { "location": "391/TALK"    , "narrator": "アーヤ", "text": "日本の文化とか伝統が\n好きなら、そういうのも\nわからないとダメよ。"},
        { "location": "394/TALK"    , "narrator": "ガブリエラ", "text": "何それ？"},
        { "location": "395/TALK"    , "narrator": "ガブリエラ", "text": "文化や伝統だから、\nなんて理由じゃ、\nさっぱりわからないわ。"},
        { "location": "396/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ！"},
        { "location": "397/TALK"    , "narrator": "ガブリエラ", "text": "覗くのもダメな部屋なら、\n鍵くらい掛かってるわよ。"},
        { "location": "399/TALK"    , "narrator": "アーヤ", "text": "あっ、待ちなさい！"},
        { "location": "400/SEL"     , "narrator": "", "text": "霊気を感じる"},
        { "location": "401/SEL"     , "narrator": "", "text": "入らないならＯＫでしょ"},
        { "location": "404/TALK"    , "narrator": "アーヤ", "text": "どうしよう…。\nなんて言えばわかって\nもらえるのかしら？"},
        { "location": "405/TALK"    , "narrator": "アーヤ", "text": "もしもあの部屋が、\n私の思ってるような\n部屋だったとしたら――"},
        { "location": "406/TALK"    , "narrator": "アーヤ", "text": "冗談抜きでマズいことに\nなりかねないわ。"},
        { "location": "411/TALK"    , "narrator": "アーヤ", "text": "って、いけない！\n待ちなさいギャヴィ！"},
        { "location": "417/ACT"     , "narrator": "", "text": "霊気を感じる"},
        { "location": "439/TALK"    , "narrator": "アーヤ", "text": "バカ！"},
        { "location": "440/TALK"    , "narrator": "アーヤ", "text": "そういう冗談、本当面白くないから！！"},
        { "location": "442/TALK"    , "narrator": "アーヤ", "text": "…冗談よね？"},
        { "location": "456/TALK"    , "narrator": "アーヤ", "text": "って、いけない！\n待ちなさいギャヴィ！"},
        { "location": "461/ACT"     , "narrator": "", "text": "入らないならＯＫでしょ"},
        { "location": "481/TALK"    , "narrator": "アーヤ", "text": "あなたまで何言ってるの？"},
        { "location": "482/TALK"    , "narrator": "アーヤ", "text": "そういうの、屁理屈って言うの！"},
        { "location": "495/TALK"    , "narrator": "アーヤ", "text": "って、いけない！\n待ちなさいギャヴィ！"},
        { "location": "517/TALK"    , "narrator": "ガブリエラ", "text": "うわぁ…何これ？"},
        { "location": "521/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ！！\nあ、覗いたらダメだって！"},
        { "location": "525/TALK"    , "narrator": "ガブリエラ", "text": "アーヤ、この部屋凄いわ！\n他の部屋と全然違うの！"},
        { "location": "529/TALK"    , "narrator": "アーヤ", "text": "嫌！！\n聞きたくないから！"},
        { "location": "534/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "535/TALK"    , "narrator": "ガブリエラ", "text": "怖いの？"},
        { "location": "538/TALK"    , "narrator": "アーヤ", "text": "なっ！？　バカなこと\n言わないでよ！"},
        { "location": "539/TALK"    , "narrator": "ガブリエラ", "text": "だったらほら――"},
        { "location": "544/TALK"    , "narrator": "ガブリエラ", "text": "ちょっとでいいから\n見てみなって。"},
        { "location": "547/TALK"    , "narrator": "アーヤ", "text": "ちょ、ちょっと、ダメ！\nそんな押したら…っ！？"},
        { "location": "551/TALK"    , "narrator": "アーヤ", "text": "きゃぁっ！"},
        { "location": "554/TALK"    , "narrator": "ガブリエラ", "text": "あ、アーヤッ！？"},
        { "location": "566/TALK"    , "narrator": "アーヤ", "text": "イタタタ…。"},
        { "location": "569/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ！！\nあんたが押すから\nドアが外れて――"},
        { "location": "584/TALK"    , "narrator": "アーヤ", "text": "ひぃっ！？"},
        { "location": "600/TALK"    , "narrator": "ガブリエラ", "text": "やばっ！\nドア外れちゃった！"},
        { "location": "602/TALK"    , "narrator": "ガブリエラ", "text": "ほら、アーヤ！\n直すの手伝って！！"},
        { "location": "603/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "605/TALK"    , "narrator": "ガブリエラ", "text": "アーヤってば！！"},
        { "location": "606/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "608/TALK"    , "narrator": "ガブリエラ", "text": "あちゃー、完全に\n固まっちゃってる…。"},
        { "location": "610/TALK"    , "narrator": "ガブリエラ", "text": "戻ったら、絶対に\nお説教だろうなぁ…。"},
        { "location": "295/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月25日　 9:21 PM</color>\n合宿中、みやびの実家木戸の部屋の前でのこと"},
        { "location": "622/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch02", "text": "【アーヤの恐怖報告】"}
    ]
}
