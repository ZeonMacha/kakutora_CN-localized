        { "location": "232/TALK"    , "narrator": "つばめ", "text": "かわぃぃ格好がぃぃなって(・ω<) ﾃﾍﾍﾟﾛ"},
        { "location": "234/SEL"     , "narrator": "", "text": "萌える戦闘服かー"},
