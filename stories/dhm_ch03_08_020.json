        "title": "Extra007 ヒメゴトチャット",
        "sub_title": "新しい空"
    },
    "entry":
    [
        { "location": "67/SCENARIO", "narrator": "", "text": "022_新しい空"},
        { "location": "92/TALK"    , "narrator": "ガブリエラ", "text": "ええとね"},
        { "location": "93/TALK"    , "narrator": "ガブリエラ", "text": "この前コンクールに出した絵"},
        { "location": "94/TALK"    , "narrator": "ガブリエラ", "text": "飾ってはもらえたけど"},
        { "location": "95/TALK"    , "narrator": "ガブリエラ", "text": "受賞しなかったの"},
        { "location": "98/SEL"     , "narrator": "", "text": "賞目的の絵じゃなかったし"},
        { "location": "99/SEL"     , "narrator": "", "text": "何だと！？　猛抗議だ！"},
        { "location": "100/SEL"    , "narrator": "", "text": "最優秀賞、取りたかったね"},
        { "location": "101/ACT"    , "narrator": "", "text": "賞目的の絵じゃなかったし"},
        { "location": "102/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "103/TALK"   , "narrator": "ガブリエラ", "text": "そうなんだけど"},
        { "location": "104/TALK"   , "narrator": "ガブリエラ", "text": "何の賞も取れなかったのは悔しいの！"},
        { "location": "105/ACT"    , "narrator": "", "text": "何だと！？　猛抗議だ！"},
        { "location": "107/TALK"   , "narrator": "ガブリエラ", "text": "え"},
        { "location": "108/TALK"   , "narrator": "ガブリエラ", "text": "そんなことしなくていいわよ！？"},
        { "location": "109/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "110/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナがそう言ってくれたのは"},
        { "location": "111/TALK"   , "narrator": "ガブリエラ", "text": "うれしいわ"},
        { "location": "112/TALK"   , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "113/ACT"    , "narrator": "", "text": "最優秀賞、取りたかったね"},
        { "location": "114/TALK"   , "narrator": "ガブリエラ", "text": "えと"},
        { "location": "115/TALK"   , "narrator": "ガブリエラ", "text": "そこまでの賞はいらないのよ？"},
        { "location": "116/TALK"   , "narrator": "ガブリエラ", "text": "ただちょっと"},
        { "location": "117/TALK"   , "narrator": "ガブリエラ", "text": "悔しかっただけなの"},
        { "location": "119/TALK"   , "narrator": "ガブリエラ", "text": "やっぱり"},
        { "location": "120/TALK"   , "narrator": "ガブリエラ", "text": "賞目的で描いたわけじゃないから"},
        { "location": "121/TALK"   , "narrator": "ガブリエラ", "text": "入賞しなくて当たり前なのかもね"},
        { "location": "122/TALK"   , "narrator": "ガブリエラ", "text": "それに"},
        { "location": "123/TALK"   , "narrator": "ガブリエラ", "text": "描いてる時は楽しかったし"},
        { "location": "124/TALK"   , "narrator": "ガブリエラ", "text": "それでいいのかもね"}
    ]
}
