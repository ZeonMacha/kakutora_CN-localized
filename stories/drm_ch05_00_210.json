    "entry":
    [
        { "location": "1491/SCENARIO", "narrator": "", "text": "アキバ検定"},
        { "location": "1505/TALK"    , "narrator": "神楽", "text": "…あ、こっちの方が\n近道ですから。"},
        { "location": "1507/TALK"    , "narrator": "つばめ", "text": "うん。\nふふっ。"},
        { "location": "1508/TALK"    , "narrator": "神楽", "text": "どうかしましたか？"},
        { "location": "1509/TALK"    , "narrator": "つばめ", "text": "ううん。\n卯月さんは本当に\nアキバに詳しいなって。"},
        { "location": "1510/SEL"     , "narrator": "", "text": "さすがはアキバの女王"},
        { "location": "1511/ACT"     , "narrator": "", "text": "さすがはアキバの女王"},
        { "location": "1528/TALK"    , "narrator": "神楽", "text": "その称号は"},
        { "location": "1529/TALK"    , "narrator": "神楽", "text": "ﾋﾞﾐｮｳ、、、"},
        { "location": "1532/SEL"     , "narrator": "", "text": "いやｶｺｲｲ！"},
        { "location": "1533/SEL"     , "narrator": "", "text": "やっぱりそうかな～"},
        { "location": "1534/SEL"     , "narrator": "", "text": "つばめの気持ちを代弁しただけなのに"},
        { "location": "1535/ACT"     , "narrator": "", "text": "いやｶｺｲｲ！"},
        { "location": "1537/TALK"    , "narrator": "神楽", "text": "って騙されませんよ～♪"},
        { "location": "1538/ACT"     , "narrator": "", "text": "やっぱりそうかな～"},
        { "location": "1539/TALK"    , "narrator": "神楽", "text": "わかってて言ってる？？？"},
        { "location": "1540/ACT"     , "narrator": "", "text": "つばめの気持ちを代弁しただけなのに"},
        { "location": "1541/TALK"    , "narrator": "神楽", "text": "いやそれは、、、"},
        { "location": "1543/TALK"    , "narrator": "神楽", "text": "本当にそうかもです、、、"},
        { "location": "1545/TALK"    , "narrator": "神楽", "text": "その名前は謹んで遠慮しますねっ♪"},
        { "location": "1547/SEL"     , "narrator": "", "text": "残念だ"},
        { "location": "1548/SEL"     , "narrator": "", "text": "つばめとのデート楽しんで"},
        { "location": "1549/SEL"     , "narrator": "", "text": "今度$me$ともデートしてね"},
        { "location": "1550/ACT"     , "narrator": "", "text": "残念だ"},
        { "location": "1551/TALK"    , "narrator": "神楽", "text": "$handle$さんがそう名乗っていいですよ♪"},
        { "location": "1552/ACT"     , "narrator": "", "text": "つばめとのデート楽しんで"},
        { "location": "1553/TALK"    , "narrator": "神楽", "text": "そうですね～～～"},
        { "location": "1554/TALK"    , "narrator": "神楽", "text": "楽しみますねｸﾞﾌﾌ、、、"},
        { "location": "1555/ACT"     , "narrator": "", "text": "今度$me$ともデートしてね"},
        { "location": "1557/TALK"    , "narrator": "神楽", "text": "絶対ですよ？"},
        { "location": "1558/TALK"    , "narrator": "神楽", "text": "ぴょんこすっごく期待してますから♪"},
        { "location": "1571/TALK"    , "narrator": "つばめ", "text": "こういうのも\n一種の秘密みたいな\nものだよね。"},
        { "location": "1573/TALK"    , "narrator": "神楽", "text": "…こういうのって？"},
        { "location": "1574/TALK"    , "narrator": "つばめ", "text": "卯月さんがここまで\nアキバに詳しいのを\n知ってること。"},
        { "location": "1575/TALK"    , "narrator": "つばめ", "text": "たぶんわたしだけ\nだよね？"},
        { "location": "1576/TALK"    , "narrator": "神楽", "text": "…ああ。\nそういうことですか。"},
        { "location": "1577/TALK"    , "narrator": "神楽", "text": "確かにそうかも\nしれませんね。"},
        { "location": "1578/TALK"    , "narrator": "神楽", "text": "別にオタク趣味を\n隠してるつもりは\nないですけど。"},
        { "location": "1579/TALK"    , "narrator": "神楽", "text": "一緒にアキバまでって\nなるとなかなか\n行く機会もないですし。"},
        { "location": "1580/TALK"    , "narrator": "つばめ", "text": "だよね？\nなんだかうれしいな。\nそういうの。"},
        { "location": "1581/SEL"     , "narrator": "", "text": "$me$はちょっと嫉妬"},
        { "location": "1582/ACT"     , "narrator": "", "text": "$me$はちょっと嫉妬"},
        { "location": "1599/TALK"    , "narrator": "神楽", "text": "あらあらあらあら？"},
        { "location": "1600/TALK"    , "narrator": "神楽", "text": "ちょっとだけ、ですか？"},
        { "location": "1602/SEL"     , "narrator": "", "text": "本当は超絶的に嫉妬してる"},
        { "location": "1603/SEL"     , "narrator": "", "text": "$me$は大人だからね（フッ…"},
        { "location": "1604/SEL"     , "narrator": "", "text": "別に全然してないし！"},
        { "location": "1605/ACT"     , "narrator": "", "text": "本当は超絶的に嫉妬してる"},
        { "location": "1607/TALK"    , "narrator": "神楽", "text": "なんて、信じてあげますね♪"},
        { "location": "1609/ACT"     , "narrator": "", "text": "$me$は大人だからね（フッ…"},
        { "location": "1610/TALK"    , "narrator": "神楽", "text": "ｷｬｰｶｺｲｲーー"},
        { "location": "1611/TALK"    , "narrator": "神楽", "text": "$handle$さんｽﾃｷ♪"},
        { "location": "1613/ACT"     , "narrator": "", "text": "別に全然してないし！"},
        { "location": "1615/TALK"    , "narrator": "神楽", "text": "ずいぶんなツンデレさんですね♪"},
        { "location": "1629/TALK"    , "narrator": "神楽", "text": "…私もうれしいですよ。"},
        { "location": "1631/TALK"    , "narrator": "神楽", "text": "こうやってつばめさんと\nアキバデート\nできるのは。"},
        { "location": "1632/TALK"    , "narrator": "つばめ", "text": "デート！？"},
        { "location": "1633/TALK"    , "narrator": "神楽", "text": "…嫌ですか？\n私とデート\nするのは。"},
        { "location": "1634/TALK"    , "narrator": "つばめ", "text": "え、えっと…。\n嫌っていうか…。"},
        { "location": "1635/TALK"    , "narrator": "神楽", "text": "ふふっ。\nつばめさんったら。"},
        { "location": "1636/TALK"    , "narrator": "神楽", "text": "冗談をすぐ本気に\nしちゃうんだから。"},
        { "location": "1637/TALK"    , "narrator": "つばめ", "text": "えっ！？　また\nからかわれたの！？"},
        { "location": "1639/TALK"    , "narrator": "神楽", "text": "他に何があると\n思います？"},
        { "location": "1640/TALK"    , "narrator": "つばめ", "text": "もー！！！！"},
        { "location": "1641/TALK"    , "narrator": "神楽", "text": "あはははは…。"},
        { "location": "1656/TALK"    , "narrator": "ボイスメール", "text": "ひみつのおんなのこ"},
        { "location": "1504/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　11:15 AM</color>\nとある休日、秋葉原でのこと"},
        { "location": "1668/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【ひみつのおんなのこ】</color>\nをゲットしました！"}
    ]
}
