        { "location": "158/SCENARIO", "narrator": "", "text": "繰り返す預言"},
        { "location": "183/TALK"    , "narrator": "ガブリエラ", "text": "繰り返して見る夢は"},
        { "location": "184/TALK"    , "narrator": "ガブリエラ", "text": "もしかしたら"},
        { "location": "185/TALK"    , "narrator": "ガブリエラ", "text": "現実になるんじゃないかと思ったりするの"},
        { "location": "187/SEL"     , "narrator": "", "text": "気のせいだよ"},
        { "location": "188/SEL"     , "narrator": "", "text": "疲れてるのかな？"},
        { "location": "189/SEL"     , "narrator": "", "text": "予知夢かもしれないね"},
        { "location": "190/ACT"     , "narrator": "", "text": "気のせいだよ"},
        { "location": "191/TALK"    , "narrator": "ガブリエラ", "text": "そうだと"},
        { "location": "192/TALK"    , "narrator": "ガブリエラ", "text": "いいんだけれど"},
        { "location": "193/ACT"     , "narrator": "", "text": "疲れてるのかな？"},
        { "location": "194/TALK"    , "narrator": "ガブリエラ", "text": "そうなのかも"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "しれないわね"},
        { "location": "197/ACT"     , "narrator": "", "text": "予知夢かもしれないね"},
        { "location": "199/TALK"    , "narrator": "ガブリエラ", "text": "やっぱりそうなのかしら？"},
        { "location": "200/TALK"    , "narrator": "ガブリエラ", "text": "非科学的だと思っても"},
        { "location": "201/TALK"    , "narrator": "ガブリエラ", "text": "そう思ってしまうのよ"},
        { "location": "202/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$はわかってくれるのね"},
        { "location": "204/TALK"    , "narrator": "ガブリエラ", "text": "いい夢なら"},
        { "location": "205/TALK"    , "narrator": "ガブリエラ", "text": "現実になって欲しいけど"},
        { "location": "206/TALK"    , "narrator": "ガブリエラ", "text": "辛かったり悲しい夢は"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "実現しない方がいいわね"}
    ]
