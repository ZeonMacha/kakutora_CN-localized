        "title": "Extra004 ヒメゴトチャット",
        "sub_title": "学校の悩み"
    },
    "entry":
    [
        { "location": "152/SCENARIO", "narrator": "", "text": "05-02_学校の悩み"},
        { "location": "177/TALK"    , "narrator": "ガブリエラ", "text": "聞いてマルザンナ"},
        { "location": "178/TALK"    , "narrator": "ガブリエラ", "text": "私ね"},
        { "location": "179/TALK"    , "narrator": "ガブリエラ", "text": "学校にお友達がいないの"},
        { "location": "180/TALK"    , "narrator": "ガブリエラ", "text": "あ、"},
        { "location": "181/TALK"    , "narrator": "ガブリエラ", "text": "今の日本のってことね"},
        { "location": "183/TALK"    , "narrator": "ガブリエラ", "text": "でもいいの"},
        { "location": "184/TALK"    , "narrator": "ガブリエラ", "text": "アーヤたちもいるし"},
        { "location": "185/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナだっていてくれるもの"},
        { "location": "187/SEL"     , "narrator": "", "text": "そうなの？"},
        { "location": "188/SEL"     , "narrator": "", "text": "そのうちできるよ"},
        { "location": "189/SEL"     , "narrator": "", "text": "やせ我慢しなくても"},
        { "location": "190/ACT"     , "narrator": "", "text": "そうなの？"},
        { "location": "192/TALK"    , "narrator": "ガブリエラ", "text": "そうよ"},
        { "location": "193/TALK"    , "narrator": "ガブリエラ", "text": "だから平気"},
        { "location": "195/TALK"    , "narrator": "ガブリエラ", "text": "平気なんだから"},
        { "location": "196/ACT"     , "narrator": "", "text": "そのうちできるよ"},
        { "location": "197/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "198/TALK"    , "narrator": "ガブリエラ", "text": "そうかもしれないわ"},
        { "location": "199/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "200/ACT"     , "narrator": "", "text": "やせ我慢しなくても"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "そういうのって"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "わかっちゃうのね・・・"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "本当はね"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "わかっているの"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "お友達ができない理由"},
        { "location": "223/TALK"    , "narrator": "ガブリエラ", "text": "私ちょっと"},
        { "location": "224/TALK"    , "narrator": "ガブリエラ", "text": "警戒心が強すぎるのよね・・・"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "日本は平和なんだし"},
        { "location": "227/TALK"    , "narrator": "ガブリエラ", "text": "まわりは同い年の子ばっかりなんだから"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "そんなに警戒する必要ないんだってわかっているつもりなの"},
        { "location": "234/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "235/TALK"    , "narrator": "ガブリエラ", "text": "なんだか色々と"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "難しくって"},
        { "location": "238/SEL"     , "narrator": "", "text": "そっか……"},
        { "location": "239/SEL"     , "narrator": "", "text": "難しいことってあるよね"},
        { "location": "240/SEL"     , "narrator": "", "text": "マルザンナが友達だよ"},
        { "location": "241/ACT"     , "narrator": "", "text": "そっか……"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "他の子たちは"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "こんなことで悩んだりしないわよね・・・"},
        { "location": "245/ACT"     , "narrator": "", "text": "難しいことってあるよね"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "変よね"},
        { "location": "248/TALK"    , "narrator": "ガブリエラ", "text": "みんなは普通にできることなのに"},
        { "location": "249/ACT"     , "narrator": "", "text": "マルザンナが友達だよ"},
        { "location": "260/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "262/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "264/TALK"    , "narrator": "ガブリエラ", "text": "素敵なお友達でいてくれて"},
        { "location": "266/TALK"    , "narrator": "ガブリエラ", "text": "学校で一人でいるのは"},
        { "location": "267/TALK"    , "narrator": "ガブリエラ", "text": "やっぱりさみしいわ"},
        { "location": "268/TALK"    , "narrator": "ガブリエラ", "text": "できたら行きたくないって思ってしまうの"},
        { "location": "269/TALK"    , "narrator": "ガブリエラ", "text": "それで"},
        { "location": "270/TALK"    , "narrator": "ガブリエラ", "text": "アーヤと朝からずっといられたらいいのにって思ったりするの"},
        { "location": "272/SEL"     , "narrator": "", "text": "そう"},
        { "location": "273/ACT"     , "narrator": "", "text": "そう"},
        { "location": "274/TALK"    , "narrator": "ガブリエラ", "text": "でもでも"},
        { "location": "276/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナもお友達だものね"},
        { "location": "277/TALK"    , "narrator": "ガブリエラ", "text": "さみしいなんて変よね"},
        { "location": "206/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "255/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
