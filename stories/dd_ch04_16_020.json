{
    "dir": "chap16/daydra/dd_ch04_16_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "16456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ギャルメイク"
    },
    "entry":
    [
        { "location": "251/SCENARIO", "narrator": "", "text": "ギャルメイク"},
        { "location": "268/TALK"    , "narrator": "みやび", "text": "…ギャルメイク、か。"},
        { "location": "270/TALK"    , "narrator": "繭", "text": "っ！？"},
        { "location": "272/TALK"    , "narrator": "雛", "text": "な、なんですか！？\nどうしたんですか\nいきなり！？"},
        { "location": "275/TALK"    , "narrator": "みやび", "text": "いや…さっきまで\n隣に座ってた子達\nやけんど――"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "すっっっっごい、\nギャルメイクや\nなかった？"},
        { "location": "279/TALK"    , "narrator": "つばめ", "text": "あっ、みやびさんも\nそう思いました？"},
        { "location": "280/TALK"    , "narrator": "つばめ", "text": "わたしも、気になって\nずっとチラチラ見ちゃって\nました。"},
        { "location": "282/TALK"    , "narrator": "雛", "text": "この店であそこまで\n凄いギャルを見たの、\n初めてじゃないかな？"},
        { "location": "283/TALK"    , "narrator": "雛", "text": "お召し列車級かも\nしれないよ。"},
        { "location": "285/TALK"    , "narrator": "つばめ", "text": "おしめ列車？"},
        { "location": "287/TALK"    , "narrator": "雛", "text": "お召し列車！\n天皇陛下とかが使う\n特別な列車のことだよ。"},
        { "location": "290/TALK"    , "narrator": "繭", "text": "そこまでレアでは\nないと思う。"},
        { "location": "292/TALK"    , "narrator": "繭", "text": "多分、貨物列車くらい？"},
        { "location": "294/TALK"    , "narrator": "雛", "text": "ん～…\nそんなもんかなぁ？"},
        { "location": "295/TALK"    , "narrator": "雛", "text": "でも、みやび先輩。\nそんなにあの人達が\n気になってたんですか？"},
        { "location": "297/TALK"    , "narrator": "みやび", "text": "あの人達やのうて、\nあの二人のメイクが\n気になったんよ…。"},
        { "location": "299/TALK"    , "narrator": "みやび", "text": "ちっくと、面白そうやき、\nやってみるんも\nえいかもしれん、ってな。"},
        { "location": "302/TALK"    , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "303/TALK"    , "narrator": "雛", "text": "みやび先輩が！？"},
        { "location": "305/TALK"    , "narrator": "繭", "text": "だ、ダメです！！\nそんなの絶対に\n認められません！"},
        { "location": "306/TALK"    , "narrator": "繭", "text": "そもそも、みやび先輩は\nギャルメイクのことを\nどれくらいご存知ですか？"},
        { "location": "309/TALK"    , "narrator": "みやび", "text": "ど素人やね。"},
        { "location": "310/TALK"    , "narrator": "繭", "text": "あのメイクは、するのに\nとてつもなく時間が\n掛かります。"},
        { "location": "312/TALK"    , "narrator": "繭", "text": "慣れている人であっても、\n一時間くらい掛ける人が\n多いんですよ？"},
        { "location": "315/TALK"    , "narrator": "みやび", "text": "そんなに掛かるが！？"},
        { "location": "317/TALK"    , "narrator": "みやび", "text": "…面倒くさいっちゅう\n気持ちより、毎日そんなに\n時間掛けてまで――"},
        { "location": "319/TALK"    , "narrator": "みやび", "text": "しっかりメイクしよう\n思う気持ちに、尊敬を\n覚えるちや。"},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "じゃあ、やったことない\nみやびさんじゃ、もっと\n時間が掛かるんじゃ…？"},
        { "location": "322/TALK"    , "narrator": "繭", "text": "二時間は考えた方が\n良いかと。"},
        { "location": "323/TALK"    , "narrator": "繭", "text": "ちなみに、みやび先輩は\n普段どの程度時間を\n掛けていますか？"},
        { "location": "325/TALK"    , "narrator": "みやび", "text": "あっという間やね。\n適当にチャチャッと\nやるだけやき――"},
        { "location": "326/TALK"    , "narrator": "みやび", "text": "一時間や二時間、\n鏡の前に座るなんて\n無理やね。"},
        { "location": "327/TALK"    , "narrator": "雛", "text": "普通はそうですよ。\nあたしだってそんなの\n無理ですし…。"},
        { "location": "329/TALK"    , "narrator": "つばめ", "text": "わたしも、出来たとして\n三十分くらいが限界かも。"},
        { "location": "331/TALK"    , "narrator": "つばめ", "text": "…まあ、三十分もどこに\n掛ければいいのかは\nわからないけど。"},
        { "location": "332/TALK"    , "narrator": "雛", "text": "そうだよねー。"},
        { "location": "335/TALK"    , "narrator": "みやび", "text": "その点は見習わんと\nいかんかもしれんね。"},
        { "location": "336/TALK"    , "narrator": "みやび", "text": "時間掛けて、少しでも\n自分を綺麗に見せよう\n思うてる証拠やし。"},
        { "location": "337/TALK"    , "narrator": "繭", "text": "…まあ、きっかけは\nどうかと思いますが――"},
        { "location": "338/TALK"    , "narrator": "繭", "text": "見た目を綺麗にする\n努力をしようと思うのは、\n素敵なことだと思います。"},
        { "location": "341/TALK"    , "narrator": "みやび", "text": "そう思うてくれるか？"},
        { "location": "344/TALK"    , "narrator": "繭", "text": "はい…特に、その…\nみやび先輩は、もともと\nとても綺麗なので――"},
        { "location": "345/TALK"    , "narrator": "繭", "text": "それを活かすメイクを\nすれば、もっと素敵に\nなると思いますし…。"},
        { "location": "347/TALK"    , "narrator": "みやび", "text": "…なるほど。"},
        { "location": "348/TALK"    , "narrator": "みやび", "text": "…ちっくと調べてみるき。"},
        { "location": "360/TALK"    , "narrator": "みやび", "text": "と言いつつ、うちは相棒に話しかけるのやった…"},
        { "location": "362/SEL"     , "narrator": "", "text": "化粧するの？"},
        { "location": "363/ACT"     , "narrator": "", "text": "化粧するの？"},
        { "location": "365/TALK"    , "narrator": "みやび", "text": "ちっくと興味がわいてな"},
        { "location": "366/TALK"    , "narrator": "みやび", "text": "みんなには、元を活かしたメイクを調べる言うたけんど"},
        { "location": "367/TALK"    , "narrator": "みやび", "text": "やっぱし、こういうのは相棒に聞いた方が面白いこと言うてくれそうやきね"},
        { "location": "368/TALK"    , "narrator": "みやび", "text": "で、どう思うん？"},
        { "location": "369/TALK"    , "narrator": "みやび", "text": "うちにはどんなメイクが似合うと思う？"},
        { "location": "371/SEL"     , "narrator": "", "text": "いっそギャルメイクを"},
        { "location": "372/SEL"     , "narrator": "", "text": "今くらいが一番だよ"},
        { "location": "373/SEL"     , "narrator": "", "text": "化粧はしない方が良い"},
        { "location": "374/ACT"     , "narrator": "", "text": "いっそギャルメイクを"},
        { "location": "376/TALK"    , "narrator": "みやび", "text": "まあ、面白そうとは思うけんど、いかんせん時間が掛かるんがネックやし…"},
        { "location": "377/TALK"    , "narrator": "みやび", "text": "けんど、一度くらいはしてみるんも、悪くなさそうやね"},
        { "location": "388/TALK"    , "narrator": "みやび", "text": "…やっぱり、一回くらい\nギャルメイクちゅうのを\n試そうと思うちや。"},
        { "location": "391/TALK"    , "narrator": "繭", "text": "何故そこに戻るん\nですか！？"},
        { "location": "394/TALK"    , "narrator": "みやび", "text": "何事も経験やき、\n一回くらいはえいと\n思うたんよ。"},
        { "location": "395/TALK"    , "narrator": "雛", "text": "う～ん…一回かぁ…。"},
        { "location": "396/TALK"    , "narrator": "雛", "text": "一回だけなら、\nあたしもいいと思うなぁ。"},
        { "location": "399/TALK"    , "narrator": "つばめ", "text": "でも、その一回で\n凄く気に入ったら――"},
        { "location": "400/TALK"    , "narrator": "つばめ", "text": "一回じゃすまなくなる\nかもしれないよ？"},
        { "location": "403/TALK"    , "narrator": "みやび", "text": "何度もやるなんてこと、\n面倒くさがり屋のうちには\nありえんことやきね。"},
        { "location": "405/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "407/TALK"    , "narrator": "繭", "text": "勇気があるのですね。\n多大なデメリットを\n抱えているというのに――"},
        { "location": "409/TALK"    , "narrator": "繭", "text": "好奇心に負けて、\nギャルメイクをする\nなんて。"},
        { "location": "411/TALK"    , "narrator": "みやび", "text": "ほう…どの当たりが\nデメリットなのか、\n聞かせてもらえるか？"},
        { "location": "412/TALK"    , "narrator": "みやび", "text": "言うておくが、学園に\nしていくつもりは\nないんよ？"},
        { "location": "414/TALK"    , "narrator": "繭", "text": "だとしても、みやび先輩の\n性格から考えて――"},
        { "location": "415/TALK"    , "narrator": "繭", "text": "ギャルメイクをした日、\n一日部屋で生活する\nとは考えられません。"},
        { "location": "416/TALK"    , "narrator": "繭", "text": "絶対に、寮の方達には\n見せて回り、反応を\n楽しむかと予想します。"},
        { "location": "418/TALK"    , "narrator": "つばめ", "text": "…みやびさんなら、\n確かにやりそうかも。"},
        { "location": "420/TALK"    , "narrator": "みやび", "text": "…まあ、それくらいは\nせんと、面白くないきね。"},
        { "location": "421/TALK"    , "narrator": "みやび", "text": "けんど、それのどこに\nデメリットがあるん？"},
        { "location": "422/TALK"    , "narrator": "繭", "text": "…東雲教官にも、\n間違いなくバレますよ？"},
        { "location": "424/TALK"    , "narrator": "みやび", "text": "っ！？"},
        { "location": "427/TALK"    , "narrator": "繭", "text": "多分、ガブリエラ辺りが\n面白がって、絶対に写真を\n撮って見せるはずです。"},
        { "location": "429/TALK"    , "narrator": "繭", "text": "…そうは思いませんか？"},
        { "location": "431/TALK"    , "narrator": "みやび", "text": "…ガブちゃんなら、\n間違いなくやりそうや。"},
        { "location": "434/TALK"    , "narrator": "繭", "text": "怒られはしないと思い\nますが、ずっとネタに\nされることは――"},
        { "location": "435/TALK"    , "narrator": "繭", "text": "間違いないと、\n私は考えますが…\nどうでしょうか？"},
        { "location": "436/TALK"    , "narrator": "みやび", "text": "…まほさんなら、\n確かにそんな反応\nしそうやな。"},
        { "location": "437/TALK"    , "narrator": "みやび", "text": "酒が入る度に、繰り返し\n話を持ち出されそうやし。"},
        { "location": "441/TALK"    , "narrator": "みやび", "text": "…光月さんは、\nうちの恩人や。"},
        { "location": "442/TALK"    , "narrator": "みやび", "text": "お礼に好きなケーキを\n好きなだけ注文しても\nえいよ。"},
        { "location": "443/TALK"    , "narrator": "繭", "text": "支払いは私の\nポケットマネーですよね？"},
        { "location": "445/TALK"    , "narrator": "みやび", "text": "もちろん。\nまあ、とにかく――"},
        { "location": "447/TALK"    , "narrator": "みやび", "text": "ギャルメイクはやらん方が\n良さそうやね。"},
        { "location": "448/TALK"    , "narrator": "繭", "text": "…それを聞いて、\n心から安心しました。"},
        { "location": "450/TALK"    , "narrator": "雛", "text": "でも、一回くらいは\n見てみたかったなー。"},
        { "location": "452/TALK"    , "narrator": "繭", "text": "うるさい黙れぶり返すな。"},
        { "location": "453/ACT"     , "narrator": "", "text": "今くらいが一番だよ"},
        { "location": "454/TALK"    , "narrator": "みやび", "text": "ふむ…相棒もそう思うんか"},
        { "location": "455/TALK"    , "narrator": "みやび", "text": "あんまし、ぶっ飛んだメイクはせん方が良さそうやね"},
        { "location": "456/TALK"    , "narrator": "みやび", "text": "相棒にドン引きされてさよなら、なんてことになったら、割に合わん"},
        { "location": "468/TALK"    , "narrator": "みやび", "text": "…まあ、元々の顔を\n活かすんやったら――"},
        { "location": "469/TALK"    , "narrator": "みやび", "text": "肌のケアに力を入れた方が\nえいかもしれんね。"},
        { "location": "471/TALK"    , "narrator": "みやび", "text": "ちっくと高い化粧水を\n使ってみるとか。"},
        { "location": "473/TALK"    , "narrator": "繭", "text": "同感です。\n絶対にその方が良いと\n思います。"},
        { "location": "475/TALK"    , "narrator": "雛", "text": "そういえば、土台の肌の\nこともちゃんとケアしな\nいとマズいよね？"},
        { "location": "476/TALK"    , "narrator": "雛", "text": "あたしも、肌年齢だけ\n初老とかにならない\nように気をつけよう…。"},
        { "location": "477/TALK"    , "narrator": "つばめ", "text": "…十代でそこまで\n酷い状態になることって、\nあるのかな？"},
        { "location": "478/ACT"     , "narrator": "", "text": "化粧はしない方が良い"},
        { "location": "482/TALK"    , "narrator": "みやび", "text": "まあ、スッピンだと化粧する時間削れるき、うちとしてはラクやけんど"},
        { "location": "483/TALK"    , "narrator": "みやび", "text": "…光月さんだけやなくて、相棒もそう言うてくれるんやったら"},
        { "location": "484/TALK"    , "narrator": "みやび", "text": "しばらくスッピン生活送るんも、悪くないかもしれん"},
        { "location": "495/TALK"    , "narrator": "みやび", "text": "…うち、しばらく\n一切化粧せんことに\nするちや。"},
        { "location": "499/TALK"    , "narrator": "つばめ", "text": "えっ！？\nそれって、スッピンで\nいるってことですか？"},
        { "location": "501/TALK"    , "narrator": "みやび", "text": "うん…そもそも、\n化粧する必要がないんよ。"},
        { "location": "502/TALK"    , "narrator": "みやび", "text": "社会人になれば、\nマナー的に必要にも\nなるけんど――"},
        { "location": "503/TALK"    , "narrator": "みやび", "text": "十代から化粧品ベタベタ\n塗りたくって、綺麗に\n見せる必要ないちや。"},
        { "location": "505/TALK"    , "narrator": "繭", "text": "た、確かにそうですが…。"},
        { "location": "506/TALK"    , "narrator": "繭", "text": "でも、スッピンで\n平気なんですか？"},
        { "location": "509/TALK"    , "narrator": "みやび", "text": "？　なにがや？"},
        { "location": "511/TALK"    , "narrator": "繭", "text": "…愚問でした。\nみやび先輩ですからね。"},
        { "location": "513/TALK"    , "narrator": "つばめ", "text": "…化粧しないで\n平気って、スゴイよね？"},
        { "location": "514/TALK"    , "narrator": "雛", "text": "うん…あたし達も、\n必要以上にはやらない\nけど――"},
        { "location": "515/TALK"    , "narrator": "雛", "text": "やっぱり、楽しいし\nワクワクするから、\n止められないよ。"},
        { "location": "518/TALK"    , "narrator": "みやび", "text": "女の子やねぇ…。\nそういう気持ち、\n大切にせんといかんよ。"},
        { "location": "521/TALK"    , "narrator": "繭", "text": "…私が言うのは変ですが、\nみやび先輩も少しくらい\n持つべきです。"},
        { "location": "264/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月22日　3:18 PM</color>\nとある平日の午後、某カフェにて。"},
        { "location": "532/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch04", "text": "【女子力は戦闘力に相当するらしい】"}
    ]
}
