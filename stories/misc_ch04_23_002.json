    "entry":
    [
        { "location": "80/SCENARIO", "narrator": "", "text": "いたづらないたずら"},
        { "location": "105/TALK"   , "narrator": "みやび", "text": "徒に"},
        { "location": "106/TALK"   , "narrator": "みやび", "text": "悪戯すると"},
        { "location": "107/TALK"   , "narrator": "みやび", "text": "いたずらだ"},
        { "location": "109/SEL"    , "narrator": "", "text": "俳句？"},
        { "location": "110/SEL"    , "narrator": "", "text": "川柳かな？"},
        { "location": "111/SEL"    , "narrator": "", "text": "みやび語録いただきましたー"},
        { "location": "112/ACT"    , "narrator": "", "text": "俳句？"},
        { "location": "113/TALK"   , "narrator": "みやび", "text": "残念ながら"},
        { "location": "115/TALK"   , "narrator": "みやび", "text": "季語がない"},
        { "location": "116/ACT"    , "narrator": "", "text": "川柳かな？"},
        { "location": "117/TALK"   , "narrator": "みやび", "text": "風刺はあまり効いちゃーせん"},
        { "location": "118/ACT"    , "narrator": "", "text": "みやび語録いただきましたー"},
        { "location": "120/TALK"   , "narrator": "みやび", "text": "いやなに"},
        { "location": "121/TALK"   , "narrator": "みやび", "text": "大したことでない"},
        { "location": "122/TALK"   , "narrator": "みやび", "text": "貴殿の心のメモリーに永久保存するぐらいちや"},
        { "location": "125/TALK"   , "narrator": "みやび", "text": "そんな言葉遊びも"},
        { "location": "126/TALK"   , "narrator": "みやび", "text": "相棒相手なら"},
        { "location": "127/TALK"   , "narrator": "みやび", "text": "はかどるというもの"},
        { "location": "130/SEL"    , "narrator": "", "text": "暇なの？"},
        { "location": "131/SEL"    , "narrator": "", "text": "いくらでも付き合うよ"},
        { "location": "132/SEL"    , "narrator": "", "text": "みやびへの愛は本当だから"},
        { "location": "133/ACT"    , "narrator": "", "text": "暇なの？"},
        { "location": "134/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "135/TALK"   , "narrator": "みやび", "text": "大変に忙しい"},
        { "location": "136/ACT"    , "narrator": "", "text": "いくらでも付き合うよ"},
        { "location": "137/TALK"   , "narrator": "みやび", "text": "左様か"},
        { "location": "138/TALK"   , "narrator": "みやび", "text": "しかしこちらも遊んでばかりはおられん"},
        { "location": "139/ACT"    , "narrator": "", "text": "みやびへの愛は本当だから"},
        { "location": "141/TALK"   , "narrator": "みやび", "text": "そんなもん"},
        { "location": "142/TALK"   , "narrator": "みやび", "text": "口では何とでも言えるわな"},
        { "location": "143/TALK"   , "narrator": "みやび", "text": "行動で示してみい"},
        { "location": "145/TALK"   , "narrator": "みやび", "text": "そんなわけで、"},
        { "location": "146/TALK"   , "narrator": "みやび", "text": "本日はこれまで"}
    ]
}
