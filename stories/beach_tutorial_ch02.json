        { "location": "156/SCENARIO", "narrator": "", "text": "TGSアーヤ"},
        { "location": "176/TALK"    , "narrator": "アーヤ", "text": "気持ちいいわ…。\n私ね、海風って好きなの。"},
        { "location": "177/TALK"    , "narrator": "アーヤ", "text": "ちょっとベタつくけど、\n普段の毎日とは違う、\n潮の香りがする風…。"},
        { "location": "178/TALK"    , "narrator": "アーヤ", "text": "なんだか、\nわくわくした気持ちに\nなってこない？"},
        { "location": "179/SEL"     , "narrator": "", "text": "かわいい反応だね"},
        { "location": "180/SEL"     , "narrator": "", "text": "駆け出したくなるよね"},
        { "location": "181/ACT"     , "narrator": "", "text": "かわいい反応だね"},
        { "location": "183/TALK"    , "narrator": "アーヤ", "text": "えっ！？\nもしかして、ちょっと\n子供っぽかったかしら？"},
        { "location": "184/SEL"     , "narrator": "", "text": "そんなアーヤが好きです"},
        { "location": "185/SEL"     , "narrator": "", "text": "そんなことはないよ"},
        { "location": "186/ACT"     , "narrator": "", "text": "そんなアーヤが好きです"},
        { "location": "187/TALK"    , "narrator": "アーヤ", "text": "…ありがとう。"},
        { "location": "188/TALK"    , "narrator": "アーヤ", "text": "きっと、そんな風に\n言ってくれる人って、\nあなただけだと思う。"},
        { "location": "189/TALK"    , "narrator": "アーヤ", "text": "…っていうより、\nあなた以外に言われても\n嬉しくない、かな…？"},
        { "location": "190/ACT"     , "narrator": "", "text": "そんなことはないよ"},
        { "location": "191/TALK"    , "narrator": "アーヤ", "text": "よかった…。"},
        { "location": "192/TALK"    , "narrator": "アーヤ", "text": "子供っぽくて幻滅されたら\nイヤだもの…。"},
        { "location": "194/ACT"     , "narrator": "", "text": "駆け出したくなるよね"},
        { "location": "195/TALK"    , "narrator": "アーヤ", "text": "さすが、わかってるわね。"},
        { "location": "196/TALK"    , "narrator": "アーヤ", "text": "って、もちろん本当に\n駆け出したりとかは\nしないけど…。"},
        { "location": "198/TALK"    , "narrator": "アーヤ", "text": "さすがに、ちょっと\n子供っぽいと\n思われちゃいそうだし。"},
        { "location": "200/TALK"    , "narrator": "アーヤ", "text": "…ところで、その…、\nどうかしら？"},
        { "location": "201/TALK"    , "narrator": "アーヤ", "text": "実はね、今日のデートの\nために、水着を新調して\n見たんだけど…。"},
        { "location": "202/SEL"     , "narrator": "", "text": "スゴく素敵だ"},
        { "location": "203/SEL"     , "narrator": "", "text": "一言で言うなら、愛しい"},
        { "location": "204/SEL"     , "narrator": "", "text": "ドキドキする"},
        { "location": "205/ACT"     , "narrator": "", "text": "スゴく素敵だ"},
        { "location": "206/TALK"    , "narrator": "アーヤ", "text": "よかった…。"},
        { "location": "207/TALK"    , "narrator": "アーヤ", "text": "本当は、これ着るの\nちょっと照れくさかったん\nだけど…。"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "今の一言で、\n照れくさかった気持ち、\n消えちゃったわ。"},
        { "location": "209/ACT"     , "narrator": "", "text": "一言で言うなら、愛しい"},
        { "location": "210/TALK"    , "narrator": "アーヤ", "text": "えっ！？　えっと…。"},
        { "location": "211/TALK"    , "narrator": "アーヤ", "text": "…想像以上の答えで、\nビックリしたわ。"},
        { "location": "212/TALK"    , "narrator": "アーヤ", "text": "でも、水着以外の時でも\nそう思ってもらえたら、\nもっと嬉しいけど。"},
        { "location": "213/ACT"     , "narrator": "", "text": "ドキドキする"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "もぅ…そんな風に\n言われたら…。"},
        { "location": "215/TALK"    , "narrator": "アーヤ", "text": "私の方まで、なんだか\nドキドキしてきちゃう…。"},
        { "location": "217/SEL"     , "narrator": "", "text": "ちょっと、触っていい？"},
        { "location": "218/ACT"     , "narrator": "", "text": "ちょっと、触っていい？"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "こ、こんなところで…？"},
        { "location": "222/TALK"    , "narrator": "アーヤ", "text": "…まあ、いいけど…、\nちょっとだけよ？"},
        { "location": "241/TALK"    , "narrator": "アーヤ", "text": "…あなたから見たら、\n私もまだまだ\n子供なのかしら？"},
        { "location": "244/TALK"    , "narrator": "アーヤ", "text": "…頭ポンポンされるの\n好きな人の気持ち、\nわかったかも。"},
        { "location": "251/TALK"    , "narrator": "アーヤ", "text": "ちょっ！？\n誰も見てなくても、\nこれはダメよ！"},
        { "location": "252/TALK"    , "narrator": "アーヤ", "text": "あ…二人の時ならいいって\nわけじゃないけど…。"},
        { "location": "255/TALK"    , "narrator": "アーヤ", "text": "ちょ、ダメだったら。"},
        { "location": "256/TALK"    , "narrator": "アーヤ", "text": "いくらなんでも…、\nちょっと強引すぎ！"},
        { "location": "262/TALK"    , "narrator": "アーヤ", "text": "アンッ！？"},
        { "location": "264/TALK"    , "narrator": "アーヤ", "text": "ば、バカ！\n変な声出ちゃった\nじゃない！！"},
        { "location": "266/TALK"    , "narrator": "アーヤ", "text": "な、なんでお腹なのに、\nこんなに恥ずかしいの\nかしら…。"},
        { "location": "272/TALK"    , "narrator": "アーヤ", "text": "…あなたから見たら、\n私もまだまだ\n子供なのかしら？"},
        { "location": "275/TALK"    , "narrator": "アーヤ", "text": "…あなたの撫で方って、\nどうして\nこんなに優しいの？"},
        { "location": "282/TALK"    , "narrator": "アーヤ", "text": "ちょっ！？\n誰も見てなくても、\nこれはダメよ！"},
        { "location": "283/TALK"    , "narrator": "アーヤ", "text": "あ…二人の時ならいいって\nわけじゃないけど…。"},
        { "location": "286/TALK"    , "narrator": "アーヤ", "text": "ちょ、ダメだったら。"},
        { "location": "287/TALK"    , "narrator": "アーヤ", "text": "いくらなんでも…、\nちょっと強引すぎ！"},
        { "location": "293/TALK"    , "narrator": "アーヤ", "text": "アンッ！？"},
        { "location": "295/TALK"    , "narrator": "アーヤ", "text": "ば、バカ！\n変な声出ちゃった\nじゃない！！"},
        { "location": "297/TALK"    , "narrator": "アーヤ", "text": "な、なんでお腹なのに、\nこんなに恥ずかしいの\nかしら…。"},
