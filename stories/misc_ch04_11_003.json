    "entry":
    [
        { "location": "205/SCENARIO", "narrator": "", "text": "015_皆さま何用？"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "記者会見には何を着て行けばええろうね？"},
        { "location": "232/SEL"     , "narrator": "", "text": "着物"},
        { "location": "233/SEL"     , "narrator": "", "text": "制服"},
        { "location": "234/SEL"     , "narrator": "", "text": "っていうか、記者会見？"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "悩むぞね"},
        { "location": "248/ACT"     , "narrator": "", "text": "着物"},
        { "location": "249/TALK"    , "narrator": "みやび", "text": "おおざっぱな"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "格についても触れんか"},
        { "location": "251/ACT"     , "narrator": "", "text": "制服"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "なるほど"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "学生の正装にして戦闘服"},
        { "location": "254/ACT"     , "narrator": "", "text": "っていうか、記者会見？"},
        { "location": "255/TALK"    , "narrator": "みやび", "text": "記者会見ぞね"},
        { "location": "256/TALK"    , "narrator": "みやび", "text": "主役はみやびさん"},
        { "location": "258/TALK"    , "narrator": "みやび", "text": "トライナリーに対する隠蔽工作は行われているが"},
        { "location": "259/TALK"    , "narrator": "みやび", "text": "それが隠しきれなくなった場合は"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "そういう局面になることもあるぞね"},
        { "location": "262/SEL"     , "narrator": "", "text": "あるかもね"},
        { "location": "263/SEL"     , "narrator": "", "text": "心配し過ぎ"},
        { "location": "264/SEL"     , "narrator": "", "text": "本当は楽しんでない？"},
        { "location": "265/ACT"     , "narrator": "", "text": "あるかもね"},
        { "location": "266/TALK"    , "narrator": "みやび", "text": "な？"},
        { "location": "267/ACT"     , "narrator": "", "text": "心配し過ぎ"},
        { "location": "268/TALK"    , "narrator": "みやび", "text": "そんなことはない"},
        { "location": "269/ACT"     , "narrator": "", "text": "本当は楽しんでない？"},
        { "location": "271/TALK"    , "narrator": "みやび", "text": "まあな"},
        { "location": "272/TALK"    , "narrator": "みやび", "text": "そのくらいの楽しみは"},
        { "location": "273/TALK"    , "narrator": "みやび", "text": "あってもよかろ"},
        { "location": "275/TALK"    , "narrator": "みやび", "text": "転ばぬ先の杖"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "その時は"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "どうすればええぞね"},
        { "location": "279/SEL"     , "narrator": "", "text": "とりあえず謝る？"},
        { "location": "280/SEL"     , "narrator": "", "text": "$me$は味方だからね"},
        { "location": "281/SEL"     , "narrator": "", "text": "世界にみやびの美しさをアピール"},
        { "location": "282/ACT"     , "narrator": "", "text": "とりあえず謝る？"},
        { "location": "283/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "284/TALK"    , "narrator": "みやび", "text": "やめとく"},
        { "location": "285/ACT"     , "narrator": "", "text": "$me$は味方だからね"},
        { "location": "289/TALK"    , "narrator": "みやび", "text": "何をもって味方かはさておき"},
        { "location": "290/TALK"    , "narrator": "みやび", "text": "その思考に至ったことには感謝する"},
        { "location": "291/TALK"    , "narrator": "みやび", "text": "頼んだぞ！！！"},
        { "location": "292/ACT"     , "narrator": "", "text": "世界にみやびの美しさをアピール"},
        { "location": "293/TALK"    , "narrator": "みやび", "text": "そんなこと"},
        { "location": "294/TALK"    , "narrator": "みやび", "text": "するまでもなかろう"}
    ]
}
