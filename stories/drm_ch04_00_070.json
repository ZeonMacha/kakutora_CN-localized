        { "location": "7/SCENARIO", "narrator": "", "text": "20_油断は禁物"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "ぬぬぬぬぬ"},
        { "location": "36/SEL"    , "narrator": "", "text": "日本語でお願いします"},
        { "location": "37/SEL"    , "narrator": "", "text": "どうしたの？"},
        { "location": "38/SEL"    , "narrator": "", "text": "ぬねぬねぬ？"},
        { "location": "39/ACT"    , "narrator": "", "text": "日本語でお願いします"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "日本語だ"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "理解セヨ"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "相棒"},
        { "location": "43/ACT"    , "narrator": "", "text": "どうしたの？"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "どうもこうも"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "どうしようかと"},
        { "location": "46/ACT"    , "narrator": "", "text": "ぬねぬねぬ？"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "ややややややや"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "これは"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "なかなか"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "時に相棒"},
        { "location": "63/SEL"    , "narrator": "", "text": "おうよ、兄弟"},
        { "location": "64/SEL"    , "narrator": "", "text": "Yes,my lord."},
        { "location": "65/SEL"    , "narrator": "", "text": "いや、$handle$だから"},
        { "location": "66/ACT"    , "narrator": "", "text": "おうよ、兄弟"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "ふむ"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "相棒にして兄弟とは"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "血は水よりも濃いということだ"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "な"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "英語か……"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "翻訳終了後"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "また頼む"},
        { "location": "76/ACT"    , "narrator": "", "text": "いや、$handle$だから"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "あー"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "そうだったな"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "これはこれは"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "で"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "$handle$は"},
        { "location": "95/SEL"    , "narrator": "", "text": "何？"},
        { "location": "96/SEL"    , "narrator": "", "text": "おーい"},
        { "location": "97/SEL"    , "narrator": "", "text": "みやびさん？"},
        { "location": "98/ACT"    , "narrator": "", "text": "何？"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "なんというか"},
        { "location": "101/ACT"   , "narrator": "", "text": "おーい"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "あ？"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "その、だ"},
        { "location": "104/ACT"   , "narrator": "", "text": "みやびさん？"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "ぬぬ"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "それはうちの名前"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "いややはり"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "ここで聞いては時期尚早"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "ということで"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "さらばだ"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "と思ったが"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "せっかくだからうちの秘密を聞かせてやろう"},
        { "location": "120/TALK"  , "narrator": "ボイスメール", "text": "閻魔様とは懇意なもので"},
        { "location": "52/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>400pt.</b></color></size>\nアップしました！"},
        { "location": "82/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>600pt.</b></color></size>\nアップしました！"},
        { "location": "132/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【閻魔様とは懇意なもので】</color>\nをゲットしました！"}
