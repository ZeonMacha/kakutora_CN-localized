    "entry":
    [
        { "location": "480/TALK"  , "narrator": "ガブリエラ", "text": "あたし…どうして\n廊下なんかで…？"},
        { "location": "481/SEL"   , "narrator": "", "text": "落ち着いたかな？"},
        { "location": "482/SEL"   , "narrator": "", "text": "ちょっとボーッと\nしてる？"},
        { "location": "483/SEL"   , "narrator": "", "text": "何があったかわかる？"},
        { "location": "484/ACT"   , "narrator": "", "text": "落ち着いたかな？"},
        { "location": "486/TALK"  , "narrator": "ガブリエラ", "text": "えと…あたし…。"},
        { "location": "487/ACT"   , "narrator": "", "text": "ちょっとボーッと\nしてる？"},
        { "location": "488/TALK"  , "narrator": "ガブリエラ", "text": "…そうなのかしら…？"},
        { "location": "489/ACT"   , "narrator": "", "text": "何があったかわかる？"},
        { "location": "490/TALK"  , "narrator": "ガブリエラ", "text": "何が…？"},
        { "location": "492/SEL"   , "narrator": "", "text": "君は強盗に襲われたんだ"},
        { "location": "493/SEL"   , "narrator": "", "text": "強盗のことを憶えてる？"},
        { "location": "494/ACT"   , "narrator": "", "text": "君は強盗に襲われたんだ"},
        { "location": "495/TALK"  , "narrator": "ガブリエラ", "text": "え…強盗！？"},
        { "location": "496/ACT"   , "narrator": "", "text": "強盗のことを憶えてる？"},
        { "location": "497/TALK"  , "narrator": "ガブリエラ", "text": "…憶えてるような\n気がするわ…。"},
        { "location": "499/SEL"   , "narrator": "", "text": "そしてお母さんは\n残念ながら…"},
        { "location": "500/SEL"   , "narrator": "", "text": "悪いのは全部強盗だ"},
        { "location": "501/ACT"   , "narrator": "", "text": "そしてお母さんは\n残念ながら…"},
        { "location": "502/TALK"  , "narrator": "ガブリエラ", "text": "…！\nそうよ、そうだった…。"},
        { "location": "503/ACT"   , "narrator": "", "text": "悪いのは全部強盗だ"},
        { "location": "504/TALK"  , "narrator": "ガブリエラ", "text": "え…？\nちょっと待って…。"},
        { "location": "507/TALK"  , "narrator": "ガブリエラ", "text": "あたし、そうよ…\nお母様を……。"},
        { "location": "508/SEL"   , "narrator": "", "text": "ガブリエラは悪くない"},
        { "location": "509/SEL"   , "narrator": "", "text": "自分を責めないで"},
        { "location": "510/SEL"   , "narrator": "", "text": "それは事故だから"},
        { "location": "511/ACT"   , "narrator": "", "text": "ガブリエラは悪くない"},
        { "location": "512/TALK"  , "narrator": "ガブリエラ", "text": "でも…。"},
        { "location": "513/ACT"   , "narrator": "", "text": "自分を責めないで"},
        { "location": "514/TALK"  , "narrator": "ガブリエラ", "text": "だって…。"},
        { "location": "515/ACT"   , "narrator": "", "text": "それは事故だから"},
        { "location": "516/TALK"  , "narrator": "ガブリエラ", "text": "そんなの…。"},
        { "location": "518/TALK"  , "narrator": "ガブリエラ", "text": "あたし……。"},
        { "location": "519/SEL"   , "narrator": "", "text": "$me$がいつも\n側にいるから"},
        { "location": "520/SEL"   , "narrator": "", "text": "ガブリエラのこと\n護りたいんだ"},
        { "location": "521/SEL"   , "narrator": "", "text": "ガブリエラを\n大事にするよ"},
        { "location": "522/ACT"   , "narrator": "", "text": "$me$がいつも\n側にいるから"},
        { "location": "523/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "524/ACT"   , "narrator": "", "text": "ガブリエラのこと\n護りたいんだ"},
        { "location": "525/TALK"  , "narrator": "ガブリエラ", "text": "護るって…。"},
        { "location": "526/ACT"   , "narrator": "", "text": "ガブリエラを\n大事にするよ"},
        { "location": "527/TALK"  , "narrator": "ガブリエラ", "text": "こんなあたしを…？"},
        { "location": "529/TALK"  , "narrator": "ガブリエラ", "text": "……さっきから\nお話ししてくれる\nあなたはだあれ？"},
        { "location": "530/SEL"   , "narrator": "", "text": "マルザンナだよ"},
        { "location": "531/ACT"   , "narrator": "", "text": "マルザンナだよ"},
        { "location": "533/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナ？"},
        { "location": "534/TALK"  , "narrator": "ガブリエラ", "text": "女神の名前ね…。"},
        { "location": "535/SEL"   , "narrator": "", "text": "マルザンナはいつも\nガブリエラの側にいる"},
        { "location": "536/SEL"   , "narrator": "", "text": "豊穣の女神だよ"},
        { "location": "537/SEL"   , "narrator": "", "text": "だから別れは来ないんだ"},
        { "location": "538/ACT"   , "narrator": "", "text": "マルザンナはいつも\nガブリエラの側にいる"},
        { "location": "539/TALK"  , "narrator": "ガブリエラ", "text": "神様だから？"},
        { "location": "540/ACT"   , "narrator": "", "text": "豊穣の女神だよ"},
        { "location": "541/TALK"  , "narrator": "ガブリエラ", "text": "知ってるわ。"},
        { "location": "542/ACT"   , "narrator": "", "text": "だから別れは来ないんだ"},
        { "location": "543/TALK"  , "narrator": "ガブリエラ", "text": "人間じゃないものね。"},
        { "location": "545/SEL"   , "narrator": "", "text": "ねえガブリエラ"},
        { "location": "546/ACT"   , "narrator": "", "text": "ねえガブリエラ"},
        { "location": "548/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "549/SEL"   , "narrator": "", "text": "$me$は\n時を超えていつでも\nガブリエラの側にいるよ"},
        { "location": "550/ACT"   , "narrator": "", "text": "$me$は\n時を超えていつでも\nガブリエラの側にいるよ"},
        { "location": "552/TALK"  , "narrator": "ガブリエラ", "text": "そんなこと…。"},
        { "location": "553/SEL"   , "narrator": "", "text": "本当だから"},
        { "location": "554/SEL"   , "narrator": "", "text": "絶対に"},
        { "location": "555/SEL"   , "narrator": "", "text": "信じてほしいな"},
        { "location": "556/ACT"   , "narrator": "", "text": "本当だから"},
        { "location": "558/TALK"  , "narrator": "ガブリエラ", "text": "本当に？"},
        { "location": "559/ACT"   , "narrator": "", "text": "絶対に"},
        { "location": "561/TALK"  , "narrator": "ガブリエラ", "text": "絶対なの？"},
        { "location": "562/ACT"   , "narrator": "", "text": "信じてほしいな"},
        { "location": "564/TALK"  , "narrator": "ガブリエラ", "text": "あたしに？"},
        { "location": "566/SEL"   , "narrator": "", "text": "だから泣かないで"},
        { "location": "567/SEL"   , "narrator": "", "text": "孤独だなんて思わないで"},
        { "location": "568/SEL"   , "narrator": "", "text": "一人で背負わないで"},
        { "location": "569/ACT"   , "narrator": "", "text": "だから泣かないで"},
        { "location": "570/TALK"  , "narrator": "ガブリエラ", "text": "…あたし…。"},
        { "location": "571/ACT"   , "narrator": "", "text": "孤独だなんて思わないで"},
        { "location": "572/TALK"  , "narrator": "ガブリエラ", "text": "そんなの…。"},
        { "location": "573/ACT"   , "narrator": "", "text": "一人で背負わないで"},
        { "location": "574/TALK"  , "narrator": "ガブリエラ", "text": "だって……。"},
        { "location": "576/SEL"   , "narrator": "", "text": "$me$のこと憶えてて"},
        { "location": "577/SEL"   , "narrator": "", "text": "辛い時は思い出して"},
        { "location": "578/SEL"   , "narrator": "", "text": "君は一人じゃない"},
        { "location": "579/ACT"   , "narrator": "", "text": "$me$のこと憶えてて"},
        { "location": "580/TALK"  , "narrator": "ガブリエラ", "text": "…そうね。"},
        { "location": "581/ACT"   , "narrator": "", "text": "辛い時は思い出して"},
        { "location": "582/TALK"  , "narrator": "ガブリエラ", "text": "…辛い時…。"},
        { "location": "583/ACT"   , "narrator": "", "text": "君は一人じゃない"},
        { "location": "584/TALK"  , "narrator": "ガブリエラ", "text": "…あたしは\n一人なんかじゃない。"},
        { "location": "586/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう。"},
        { "location": "587/TALK"  , "narrator": "ガブリエラ", "text": "あたしのマルザンナ。"},
        { "location": "589/TALK"  , "narrator": "ガブリエラ", "text": "この先ずっと、\nあたしをいつも\n見守ってて…。"},
        { "location": "594/TALK"  , "narrator": "ガブリエラ", "text": "えっ…！？"},
