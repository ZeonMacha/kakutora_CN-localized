{
    "dir": "chap19/daydra/dd_ch01_19_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "19152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "差し入れ"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "差し入れ"},
        { "location": "32/TALK"   , "narrator": "ヒカル", "text": "ひなこさん。\nアンテナに周辺機器を\n取り付け終わりました。"},
        { "location": "34/TALK"   , "narrator": "雛", "text": "おおっ、凄い完璧じゃん！\nヒカルくんもこっち系に\n詳しくなってきたねー。"},
        { "location": "35/TALK"   , "narrator": "ヒカル", "text": "説明書と、ひなこさんの\n教えのおかげですよ。"},
        { "location": "36/TALK"   , "narrator": "雛", "text": "よーし、それじゃあ\nさっさとアンテナを\n設置して――"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "みんな、お疲れ様ー。"},
        { "location": "46/TALK"   , "narrator": "雛", "text": "あっ、つばめちゃん！\nガブリエラちゃんも！"},
        { "location": "47/TALK"   , "narrator": "ヒカル", "text": "こんにちは、\n逢瀬さん、\nガブリエラさん。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "51/TALK"   , "narrator": "雛", "text": "ガブリエラちゃん、\nどうかしたの？"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "鉄塔の上、なんか必死に\n手を振ってるみたい\nだけど…。"},
        { "location": "53/TALK"   , "narrator": "ヒカル", "text": "え？　あっ！"},
        { "location": "59/TALK"   , "narrator": "ヒカル", "text": "ごめん、キリト！\n今すぐ持っていきます！"},
        { "location": "62/TALK"   , "narrator": "雛", "text": "あちゃー、キリトのこと\nすっかり忘れてたわー。"},
        { "location": "63/TALK"   , "narrator": "雛", "text": "ヒカルくん、行ける？\nアンテナ落とさないように\n気を付けてね。"},
        { "location": "66/TALK"   , "narrator": "ヒカル", "text": "はい。\nちょっと行ってきます。"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "わぁ…ヒカルくんって、\n結構力持ちなんだね？"},
        { "location": "81/TALK"   , "narrator": "雛", "text": "あの見た目と性格からは\n想像つかないよねー。"},
        { "location": "83/TALK"   , "narrator": "雛", "text": "意外と、脱いだら筋肉\nムッキムキだったりして。"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "そ、そうかしら？"},
        { "location": "87/TALK"   , "narrator": "雛", "text": "ふっふっふ…惚れた？"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "だから、どうしてそういう\n話につながるのよ！？"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "そ、それより！\nひなこちゃん達、\nお昼まだだよね？"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "差し入れのお弁当\n持ってきたんだけど…。"},
        { "location": "95/SEL"    , "narrator": "", "text": "上、良い景色だろうね？"},
        { "location": "96/SEL"    , "narrator": "", "text": "早く遊びに行こうよ"},
        { "location": "99/TALK"   , "narrator": "雛", "text": "わぁ、それマジ嬉しいよ！"},
        { "location": "100/TALK"  , "narrator": "雛", "text": "この辺り、食事のできる\nお店がないから\n困ってたんだー。"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "いっぱいあるから、\n食べきれないかも\nしれないけど…。"},
        { "location": "102/TALK"  , "narrator": "雛", "text": "う～ん…まあ、大丈夫じゃ\nないかなー？"},
        { "location": "103/TALK"  , "narrator": "雛", "text": "食べ盛りの男の子が\n二人もいるんだし。"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "その言い方だと、\nなんか母親みたいよ？"},
        { "location": "108/TALK"  , "narrator": "雛", "text": "二人が下りて来たら、\n早速頂くよ。"},
        { "location": "109/TALK"  , "narrator": "つばめ", "text": "うん。"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、あたし達は\n戻るから。"},
        { "location": "111/TALK"  , "narrator": "雛", "text": "あらら？\nもう行っちゃうの？"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "あたし達のお昼、\nまだなのよ。"},
        { "location": "113/TALK"  , "narrator": "雛", "text": "そうだったんだ。\nお弁当、\n本当にありがとねー。"},
        { "location": "115/ACT"   , "narrator": "", "text": "上、良い景色だろうね？"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "鉄塔の上のこと？"},
        { "location": "137/TALK"  , "narrator": "つばめ", "text": "そういえば、結構高いもんね"},
        { "location": "149/TALK"  , "narrator": "つばめ", "text": "ひなこちゃんも、\nこの鉄塔登ったりしたの？"},
        { "location": "150/TALK"  , "narrator": "雛", "text": "もちろん。"},
        { "location": "153/TALK"  , "narrator": "雛", "text": "結構上に運ばないと\nいけない物が多くてねー。"},
        { "location": "154/TALK"  , "narrator": "雛", "text": "それに、後でアンテナの\n角度調整でもう一度\n登らないといけないし。"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "こんな高いとこ、\n何度も登り降りしないと\nいけないの！？"},
        { "location": "159/TALK"  , "narrator": "雛", "text": "まあねー。\nでも、鉄塔登るのって\n好きだから――"},
        { "location": "160/TALK"  , "narrator": "雛", "text": "こういう機会をもらえて、\n凄く嬉しいんだ。"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "鉄塔登るのが好きって…\n変わってるわね。"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "ねえねえ、ひなこちゃん。\n鉄塔の上からの景色って、\nどんな感じなの？"},
        { "location": "163/TALK"  , "narrator": "雛", "text": "絶景だよ！\n遠くの方にある山とかも\nすっごいよく見えるし――"},
        { "location": "164/TALK"  , "narrator": "雛", "text": "風も吹いてるから、\n下にいるより涼しくて\n快適なんだ。"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "そっかぁ…。\n気持ちよさそうだなぁ…。"},
        { "location": "166/TALK"  , "narrator": "雛", "text": "もう、さいっこうだよ！"},
        { "location": "169/TALK"  , "narrator": "雛", "text": "…あ、そうだ！\nヒカルくーん、キリトー！"},
        { "location": "170/TALK"  , "narrator": "雛", "text": "ちょっとお願いがあるん\nだけどー！"},
        { "location": "173/TALK"  , "narrator": "つばめ", "text": "…何する気だろ？"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "…なんか、嫌な予感が\nしてきたわ。"},
        { "location": "211/TALK"  , "narrator": "つばめ", "text": "わぁ！！"},
        { "location": "213/TALK"  , "narrator": "つばめ", "text": "凄い、凄いよぉ！\nあんな遠くの方まで\n見えるなんて！"},
        { "location": "215/TALK"  , "narrator": "キリト", "text": "おいおい、逢瀬。\nあんまはしゃぐと\n落ちちまうぞ？"},
        { "location": "218/TALK"  , "narrator": "つばめ", "text": "あっ、ごめんなさい。"},
        { "location": "221/TALK"  , "narrator": "つばめ", "text": "なんか、想像以上に\n素敵な景色で、夢中に\nなっちゃった。"},
        { "location": "225/TALK"  , "narrator": "ヒカル", "text": "逢瀬さんは、高いところ\n平気なんですか？"},
        { "location": "226/TALK"  , "narrator": "ヒカル", "text": "特にここは、手すりも\n何もないところですし。"},
        { "location": "228/TALK"  , "narrator": "つばめ", "text": "登ってる時は\nちょっと怖かったけど――"},
        { "location": "229/TALK"  , "narrator": "つばめ", "text": "この景色見たら、\nそんな気持ち\n消えちゃった。"},
        { "location": "230/TALK"  , "narrator": "ガブリエラ", "text": "んなわけあるかぁ！"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "あっ、ガブちゃん。\nほらほら、早くここまで\n上がってきなよ！"},
        { "location": "236/TALK"  , "narrator": "ガブリエラ", "text": "差し入れ持って来た\nだけなのに――"},
        { "location": "237/TALK"  , "narrator": "ガブリエラ", "text": "どうして鉄塔に登らなきゃ\nならないのよ！？"},
        { "location": "241/TALK"  , "narrator": "雛", "text": "大丈夫だよ、\nガブリエラちゃん。"},
        { "location": "242/TALK"  , "narrator": "雛", "text": "ちゃんと命綱付けてるし、\nあたしも支えてるから\n怖くないよ。"},
        { "location": "245/TALK"  , "narrator": "ガブリエラ", "text": "べ、別に怖がってなんか\nないわよ！"},
        { "location": "247/TALK"  , "narrator": "雛", "text": "下を見なければ平気だよ。"},
        { "location": "250/TALK"  , "narrator": "雛", "text": "ほら、向こうを見て。"},
        { "location": "251/TALK"  , "narrator": "雛", "text": "三崎口駅を出発した\n電車が見えるでしょ？"},
        { "location": "253/TALK"  , "narrator": "ガブリエラ", "text": "う、うん…。"},
        { "location": "255/TALK"  , "narrator": "雛", "text": "ここからだと、隣の\n三浦海岸駅のホームで――"},
        { "location": "256/TALK"  , "narrator": "雛", "text": "電車が止まるのが\n見えるんだよ！"},
        { "location": "257/TALK"  , "narrator": "ガブリエラ", "text": "知らないわよ！\nっていうか、ここまで来て\nやっぱり電車なの！？"},
        { "location": "261/TALK"  , "narrator": "雛", "text": "ここまで来て？\nノンノン、違うよ\nガブリエラちゃん。"},
        { "location": "264/TALK"  , "narrator": "雛", "text": "ここからじゃなきゃ\n見られないんだよ！"},
        { "location": "265/TALK"  , "narrator": "ガブリエラ", "text": "力説されても\nわからないってば！"},
        { "location": "267/TALK"  , "narrator": "つばめ", "text": "ガブちゃん、ほら。\nわたしの、隣に来て。"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "そ、そう言われても…。"},
        { "location": "269/TALK"  , "narrator": "ヒカル", "text": "命綱はしっかり固定して\nあるから、大丈夫ですよ。"},
        { "location": "271/TALK"  , "narrator": "キリト", "text": "逢瀬、大丈夫だから\n引っ張ってやれ。"},
        { "location": "274/TALK"  , "narrator": "つばめ", "text": "うん。"},
        { "location": "277/TALK"  , "narrator": "つばめ", "text": "ほら、ガブちゃん。"},
        { "location": "278/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、きゃぁ！？"},
        { "location": "317/TALK"  , "narrator": "つばめ", "text": "ほら、ガブちゃん。\nもう大丈夫だよ。"},
        { "location": "320/TALK"  , "narrator": "ガブリエラ", "text": "あ、あんたねぇ！\nちょっと無茶し過ぎよ！"},
        { "location": "322/TALK"  , "narrator": "つばめ", "text": "えへへ…それより、ほら。\n下じゃなくて前を見て。"},
        { "location": "324/TALK"  , "narrator": "ガブリエラ", "text": "ま、前って…っ！？"},
        { "location": "326/TALK"  , "narrator": "ガブリエラ", "text": "す、凄い…。\n何、この景色！？"},
        { "location": "329/TALK"  , "narrator": "つばめ", "text": "ビックリだよね？\nこんなに素敵だなんて、\nわたしも思わなかったよ。"},
        { "location": "330/TALK"  , "narrator": "雛", "text": "ここまで登った人しか\n見れない、特別な景色\nだからねー。"},
        { "location": "331/TALK"  , "narrator": "雛", "text": "あたしなんか、何枚も\n写真撮っちゃったし。"},
        { "location": "332/TALK"  , "narrator": "キリト", "text": "電車のな。"},
        { "location": "335/TALK"  , "narrator": "雛", "text": "ここからしか撮れない\n写真に変わりないもん。"},
        { "location": "339/TALK"  , "narrator": "ヒカル", "text": "午前中は富士山も\n見えていたんですよ。"},
        { "location": "340/TALK"  , "narrator": "つばめ", "text": "わぁ、いいなぁ。\nわたしも見たかったよ。"},
        { "location": "348/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "352/TALK"  , "narrator": "つばめ", "text": "あっ…ガブちゃん、\nちょっと震えてる？"},
        { "location": "358/TALK"  , "narrator": "つばめ", "text": "…ガブちゃん。\nもう少しこっち来て。"},
        { "location": "359/TALK"  , "narrator": "ガブリエラ", "text": "えっ？　きゃっ！"},
        { "location": "367/TALK"  , "narrator": "つばめ", "text": "どう？　こうやって\nぎゅーってしてれば、\n寒くないでしょ？"},
        { "location": "370/TALK"  , "narrator": "ガブリエラ", "text": "は？　え？\nさ、寒い？"},
        { "location": "371/TALK"  , "narrator": "つばめ", "text": "だって、ガブちゃん\n震えてるみたいだし。"},
        { "location": "374/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "375/TALK"  , "narrator": "つばめ", "text": "ガブちゃん？"},
        { "location": "379/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…本当、つばめって\n天然よね？"},
        { "location": "380/TALK"  , "narrator": "つばめ", "text": "え…あ、身体の震え、\n止まったみたいだね。"},
        { "location": "381/TALK"  , "narrator": "ガブリエラ", "text": "あんたの天然っぷりを\n見てたら、怖い気持ちも\n吹っ飛んだわ。"},
        { "location": "382/TALK"  , "narrator": "つばめ", "text": "え？　怖かったの？"},
        { "location": "383/TALK"  , "narrator": "ガブリエラ", "text": "あっ、ち、違う！\n寒かっただけよ！"},
        { "location": "386/TALK"  , "narrator": "ガブリエラ", "text": "…今は、つばめの身体が\n温かいから平気だけど。"},
        { "location": "387/TALK"  , "narrator": "つばめ", "text": "じゃあ、もっとギューッて\nした方が良いかな？"},
        { "location": "388/TALK"  , "narrator": "ガブリエラ", "text": "それだと暑いから、\n今くらいでいいってば。"},
        { "location": "389/TALK"  , "narrator": "つばめ", "text": "ん、わかった。"},
        { "location": "391/TALK"  , "narrator": "つばめ", "text": "でも、本当にここから\n見える景色、素敵だね。"},
        { "location": "392/TALK"  , "narrator": "つばめ", "text": "多分、合宿で一番の\n思い出になりそうだよ。"},
        { "location": "394/TALK"  , "narrator": "ガブリエラ", "text": "…うん。\nあたしもそう思う。"},
        { "location": "395/ACT"   , "narrator": "", "text": "早く遊びに行こうよ"},
        { "location": "415/TALK"  , "narrator": "つばめ", "text": "ダメだよ"},
        { "location": "416/TALK"  , "narrator": "つばめ", "text": "頑張ってるひなこちゃん達の前で、そんなこと言ったら"},
        { "location": "428/TALK"  , "narrator": "雛", "text": "つばめちゃん達、\nこれから遊びに行くの？"},
        { "location": "431/TALK"  , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "433/TALK"  , "narrator": "雛", "text": "ごめん、チラッとだけど\nスマホ画面見えちゃった！"},
        { "location": "435/TALK"  , "narrator": "ガブリエラ", "text": "何で仕事してる\nひなこの前で、遊びに行く\n話なんてしてるのよ？"},
        { "location": "436/TALK"  , "narrator": "つばめ", "text": "ご、ごめんね。\nひなこちゃん達は\nまだお仕事してるのに…。"},
        { "location": "437/TALK"  , "narrator": "雛", "text": "あー、いいのいいの。\n大変だけど、この作業って\n結構楽しいし。"},
        { "location": "438/TALK"  , "narrator": "雛", "text": "それに、今の調子だと\n夕方前には終わりそう\nだから――"},
        { "location": "439/TALK"  , "narrator": "雛", "text": "よかったら、その後で\nあたしも合流して\nいいかな？"},
        { "location": "440/TALK"  , "narrator": "つばめ", "text": "うん、もちろん。"},
        { "location": "441/TALK"  , "narrator": "つばめ", "text": "っていうか、わたしも\n手伝った方が、もっと\n早く終わるのかな？"},
        { "location": "443/TALK"  , "narrator": "雛", "text": "う～ん…。\n一つ聞くけど、\nつばめちゃんはさ――"},
        { "location": "446/TALK"  , "narrator": "雛", "text": "ここの鉄塔、一人で重い\n荷物持って登り降りする\nことできる？"},
        { "location": "447/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "449/TALK"  , "narrator": "つばめ", "text": "やっぱり、\n終わるの待ってるよ。"},
        { "location": "450/TALK"  , "narrator": "雛", "text": "うん、それがいいよ。\nなるべく早く終わらせて\n合流するね。"},
        { "location": "460/TALK"  , "narrator": "つばめ", "text": "そうだよね…。\n一人で鉄塔登れなきゃ、\nお手伝いにならないよね？"},
        { "location": "461/TALK"  , "narrator": "ガブリエラ", "text": "最初に気付きなさいよ、\nまったく…。"},
        { "location": "462/TALK"  , "narrator": "ガブリエラ", "text": "…でも、ひなこが普通に\n登れるっていうのも、\n驚きだけどね。"},
        { "location": "31/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月19日　 3:21 PM</color>\n合宿中、みやびの実家付近にて"}
    ]
}
