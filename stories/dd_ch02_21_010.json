{
    "dir": "chap21/daydra/dd_ch02_21_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "21252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "実家の香り"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "実家の香り"},
        { "location": "25/TALK"   , "narrator": "ガブリエラ", "text": "…夜になると暇ねぇ。"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "こんなことなら、\nパーティーゲームでも\n買っとけば良かったわ。"},
        { "location": "28/TALK"   , "narrator": "神楽", "text": "カプドラやりながら\n言うのはどうかと\n思いますよ？"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "明日、何か遊べそうな\nもの買いに行ってみる？"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "そうね…アーヤは\nどう思う？"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "アーヤ？"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "え？　あ、ごめん。\nぼーっとしてた。"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "お疲れみたいですね？\n朝の訓練、頑張り過ぎた\nんじゃないですか？"},
        { "location": "43/TALK"   , "narrator": "つばめ", "text": "布団敷きましょうか？"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "ううん、大丈夫。\nありがと。"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "それで、何の話――"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "あっ、ヤバい死にそう！\nどっちか回復して！"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "わたしに任せて！\nはい、もう大丈夫だよ。"},
        { "location": "57/TALK"   , "narrator": "神楽", "text": "もぅ、ガブちゃん。\n協力プレイ中なんです\nから、集中してください。"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "わ、悪かったわよ…。"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "…ま、いっか。"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "ふぅ…。"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "実家、帰りたいかも"},
        { "location": "82/SEL"    , "narrator": "", "text": "急にどうしたの？"},
        { "location": "83/ACT"    , "narrator": "", "text": "急にどうしたの？"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "こうしてのんびりしてると"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "実家の空気って、やっぱりいいなぁ、って感じちゃって"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "この部屋が実家にある部屋と似てるから、そう思ったのかも"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "変？"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "一番年上の私が、こんなこと言うなんて"},
        { "location": "91/SEL"    , "narrator": "", "text": "普通のことだと思う"},
        { "location": "92/SEL"    , "narrator": "", "text": "メールでも送ったら？"},
        { "location": "93/SEL"    , "narrator": "", "text": "よし、帰ろう！"},
        { "location": "94/ACT"    , "narrator": "", "text": "普通のことだと思う"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "そっか"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "じゃあ、みんなも同じように思ってるのかしら？"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "…なんだか、ここにいると\n実家のことを思い出さ\nない？"},
        { "location": "113/TALK"  , "narrator": "神楽", "text": "？　いえ、特に思い出し\nたりはしませんけど…。"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "…そういえば、卯月の\n実家ってタワーマンション\nだったわ…。"},
        { "location": "118/TALK"  , "narrator": "つばめ", "text": "わたし、思い出します。\n夜、こうやってのんびり\nしてると――"},
        { "location": "119/TALK"  , "narrator": "つばめ", "text": "家にいた頃のことを、\n急に思い出すんです。"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "ふ～ん…そうなんだ？"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "えへへ…ガブちゃんは\nどうなの？"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "…食事の時になると、\nちょっと思い出す\nけど…。"},
        { "location": "132/TALK"  , "narrator": "神楽", "text": "ガブちゃんの実家は\nポーランドですよね？"},
        { "location": "134/TALK"  , "narrator": "神楽", "text": "まさか、ここみたいな\n美味しい和食が、\n毎晩出ていたんですか？"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "そんなわけないでしょ。\nそうじゃなくて――"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "みやびとご両親が\n一緒にいるのを\n見ていると――"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "あたしの家も、\n昔はそうだったな、\nってね…。"},
        { "location": "145/TALK"  , "narrator": "つばめ", "text": "そっか…。"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "言っておくけど、\nホームシックじゃ\nないわよ！？"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "わかってるって。\nふふっ…安心したわ。"},
        { "location": "155/TALK"  , "narrator": "つばめ", "text": "何がですか？"},
        { "location": "158/TALK"  , "narrator": "アーヤ", "text": "…ううん、なんでもない。"},
        { "location": "161/TALK"  , "narrator": "アーヤ", "text": "私が特別寂しがり屋、\nってわけじゃなかった\nみたいね。"},
        { "location": "162/ACT"   , "narrator": "", "text": "メールでも送ったら？"},
        { "location": "163/TALK"  , "narrator": "アーヤ", "text": "メールって言われても"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "特に用事もないし"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "…メールかぁ。"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "…実家の方、やっぱり\n結構変わったのかしら？"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "171/TALK"  , "narrator": "アーヤ", "text": "…最近どんな感じ？\n送信っと。"},
        { "location": "172/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "…あっ、返って来た。"},
        { "location": "178/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "ふふっ…。"},
        { "location": "182/TALK"  , "narrator": "神楽", "text": "？　珍しいですね。\n思い出し笑いですか？"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "ううん…、\n実家からのメールを\n読んでたの。"},
        { "location": "190/TALK"  , "narrator": "つばめ", "text": "何か面白いことでも\n書いてあったんですか？"},
        { "location": "191/TALK"  , "narrator": "アーヤ", "text": "面白くて笑ったんじゃ\nなくて、う～ん――"},
        { "location": "192/TALK"  , "narrator": "アーヤ", "text": "なんか、相変わらずだな、\nって安心したから…\nかしら？"},
        { "location": "194/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "195/TALK"  , "narrator": "つばめ", "text": "わたしも、お父さんに\n送ってみようかな？"},
        { "location": "197/TALK"  , "narrator": "神楽", "text": "つばめさん、結構頻繁に\n送ってませんでした？"},
        { "location": "199/TALK"  , "narrator": "つばめ", "text": "いつもはお父さんから\n来たのに返信するだけ\nだから――"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "今日は、わたしの方から\n送ってみるよ。"},
        { "location": "201/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "203/TALK"  , "narrator": "ガブリエラ", "text": "…お父さん、\n元気にしてるかしら？"},
        { "location": "204/TALK"  , "narrator": "ガブリエラ", "text": "あとで、あたしも\n送ってみよう…。"},
        { "location": "205/ACT"   , "narrator": "", "text": "よし、帰ろう！"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "はいはい"},
        { "location": "208/TALK"  , "narrator": "アーヤ", "text": "まったく、そういう冗談ばっかり言うんだから"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "221/TALK"  , "narrator": "アーヤ", "text": "でも、私が突然そんなこと\n言ったら、みんなどういう\n反応するかしら？"},
        { "location": "223/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "226/TALK"  , "narrator": "アーヤ", "text": "はぁ…もう、実家に帰ろう\nかしら？"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "236/TALK"  , "narrator": "神楽", "text": "ど、どうしたんですか？\n急にらしくないこと\n言って…。"},
        { "location": "238/TALK"  , "narrator": "アーヤ", "text": "ここに来てから、\n自分の実家が懐かしく\n感じちゃって――"},
        { "location": "240/TALK"  , "narrator": "アーヤ", "text": "帰りたいな、って\n気持ちになったのよ。"},
        { "location": "243/TALK"  , "narrator": "ガブリエラ", "text": "ほ、ホームシック？\nアーヤが！？"},
        { "location": "245/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "248/TALK"  , "narrator": "アーヤ", "text": "なんてね、冗談よ。"},
        { "location": "249/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "251/TALK"  , "narrator": "アーヤ", "text": "懐かしい気持ちになりは\nしたけど、本当に帰りたい\nだなんて――"},
        { "location": "252/TALK"  , "narrator": "アーヤ", "text": "さすがに思わないわ、\nふふっ…。"},
        { "location": "253/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "254/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "258/TALK"  , "narrator": "ガブリエラ", "text": "…本当？"},
        { "location": "259/TALK"  , "narrator": "アーヤ", "text": "本当よ。\n冗談って言ったでしょ？"},
        { "location": "265/TALK"  , "narrator": "神楽", "text": "…アーヤさん。\n普段冗談を言わない人が\n急に言ったら――"},
        { "location": "266/TALK"  , "narrator": "神楽", "text": "本当に冗談かどうか\n疑わしく思っちゃい\nますよ。"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "えっ？"},
        { "location": "270/TALK"  , "narrator": "ガブリエラ", "text": "そうね…実家に帰りたい、\nって言ったのも驚いた\nけど――"},
        { "location": "271/TALK"  , "narrator": "ガブリエラ", "text": "そんな冗談をアーヤが\n言ったことの方が、\n驚き度は高いかも。"},
        { "location": "273/TALK"  , "narrator": "アーヤ", "text": "私だって冗談の一つや\n二つくらい言うわよ！"},
        { "location": "277/TALK"  , "narrator": "アーヤ", "text": "…ちょっとは笑って\nもらえるかと思ったのに。"},
        { "location": "21/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月24日　 8:52 PM</color>\n合宿中、みやびの実家でのこと"}
    ]
}
