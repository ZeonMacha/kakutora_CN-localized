{
    "dir": "chap05/daydra/dd_ch04_05_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "5457",
        "cid": "miyabi",
        "title": "Extra007 プレミアムストーリー",
        "sub_title": "就職活動"
    },
    "entry":
    [
        { "location": "242/SCENARIO", "narrator": "", "text": "就職活動"},
        { "location": "260/TALK"    , "narrator": "男子高校生Ａ", "text": "あれ？\nおまえもう帰りか？"},
        { "location": "261/TALK"    , "narrator": "男子高校生Ｂ", "text": "ああ、午後から会社の\n説明会があるんだよ。"},
        { "location": "262/TALK"    , "narrator": "男子高校生Ａ", "text": "そういやおまえ、\n高等部卒業したら\n就職するんだっけか？"},
        { "location": "263/TALK"    , "narrator": "男子高校生Ｂ", "text": "まあな。"},
        { "location": "264/TALK"    , "narrator": "男子高校生Ａ", "text": "就職活動か…\n俺には無理だなぁ。"},
        { "location": "265/TALK"    , "narrator": "男子高校生Ｂ", "text": "いずれおまえも\nやることになるんだよ。"},
        { "location": "274/TALK"    , "narrator": "みやび", "text": "…就職活動、\n大変そうやね。"},
        { "location": "275/TALK"    , "narrator": "アーヤ", "text": "大変だと思うわ。\n特に、高卒ですぐに\n就職なんて…。"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "せっかくここに入学\nしたんやき――"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "大学まで行かんのは\n勿体ない気もする\nけんどね。"},
        { "location": "280/TALK"    , "narrator": "アーヤ", "text": "人それぞれ、色んな\n事情があるものよ。"},
        { "location": "282/TALK"    , "narrator": "アーヤ", "text": "…そういえば、\n私の地元の友達にも――"},
        { "location": "283/TALK"    , "narrator": "アーヤ", "text": "高卒で就職した\n人がいたわ。"},
        { "location": "286/TALK"    , "narrator": "みやび", "text": "やっぱし、あんな感じ\nやったん？"},
        { "location": "287/TALK"    , "narrator": "アーヤ", "text": "ええ、学校早退して、\n説明会やら面接やら、\n走り回ってたわ。"},
        { "location": "288/TALK"    , "narrator": "アーヤ", "text": "登校の時は制服で、\n帰る時はスーツとか、\nしょっちゅうだったし。"},
        { "location": "290/TALK"    , "narrator": "アーヤ", "text": "…みやびも、いずれは\n就職活動するのよね？"},
        { "location": "293/TALK"    , "narrator": "みやび", "text": "そうなるやろうね。"},
        { "location": "294/TALK"    , "narrator": "みやび", "text": "スーツ着てあっちこっち\n行かんとならんこと\n考えると――"},
        { "location": "296/TALK"    , "narrator": "みやび", "text": "今から憂鬱やけんど…。"},
        { "location": "297/SEL"     , "narrator": "", "text": "意外と似合いそうだよ"},
        { "location": "298/SEL"     , "narrator": "", "text": "神楽坂トライナリーに就職だ"},
        { "location": "301/TALK"    , "narrator": "アーヤ", "text": "でしょうね…制服にも\n文句言ってるくらいだし。"},
        { "location": "302/TALK"    , "narrator": "アーヤ", "text": "でも、着てみると意外と\n慣れるかもしれないわよ？"},
        { "location": "305/TALK"    , "narrator": "みやび", "text": "うちがスーツに慣れると、\n本気で思うがか？"},
        { "location": "306/TALK"    , "narrator": "アーヤ", "text": "…ありえなさそうね。"},
        { "location": "311/TALK"    , "narrator": "みやび", "text": "まあ、就職活動いうもん\n自体が、うちにとっては\nあまり興味持てんき――"},
        { "location": "312/TALK"    , "narrator": "みやび", "text": "このままトライナリーで\n一生食っていければ、\nそれが一番やねぇ。"},
        { "location": "314/TALK"    , "narrator": "アーヤ", "text": "何てこと言い出すんだか、\nまったく…。"},
        { "location": "316/TALK"    , "narrator": "アーヤ", "text": "…けど、正直まだまだ\nやめられないとは\n思ってるわ。"},
        { "location": "317/TALK"    , "narrator": "アーヤ", "text": "フェノメノン被害が、\nそう簡単に収束するとは\n思えないし。"},
        { "location": "321/TALK"    , "narrator": "みやび", "text": "…そうやね。"},
        { "location": "322/TALK"    , "narrator": "みやび", "text": "まあ、フェノメノン被害が\nなくなって、うちらも\n自由になったら――"},
        { "location": "323/TALK"    , "narrator": "みやび", "text": "自伝でも書いて、\n印税生活で暮らす方法も\n考えちゅうけんどね。"},
        { "location": "328/TALK"    , "narrator": "アーヤ", "text": "…あんまり、みんなの\nプライベートに関しては\n書かないでよ？"},
        { "location": "330/ACT"     , "narrator": "", "text": "意外と似合いそうだよ"},
        { "location": "349/TALK"    , "narrator": "みやび", "text": "相棒、寝ぼけちゅうが？"},
        { "location": "350/TALK"    , "narrator": "みやび", "text": "どう考えても似合うわけないちや"},
        { "location": "366/TALK"    , "narrator": "みやび", "text": "…なあ？"},
        { "location": "370/TALK"    , "narrator": "アーヤ", "text": "いや、なあ、って\n振られても、何の話か\nわからないし…。"},
        { "location": "371/TALK"    , "narrator": "みやび", "text": "うちがスーツ着ても、\n似合わんちゅう話や。"},
        { "location": "372/TALK"    , "narrator": "みやび", "text": "アーヤもそう思うやろ？"},
        { "location": "377/TALK"    , "narrator": "アーヤ", "text": "う～ん、そうねぇ…。"},
        { "location": "378/TALK"    , "narrator": "アーヤ", "text": "…あら？\nなんか、意外と似合い\nそうかも。"},
        { "location": "381/TALK"    , "narrator": "みやび", "text": "ありえんやろ？"},
        { "location": "382/TALK"    , "narrator": "アーヤ", "text": "ううん、そんなこと\nないって。"},
        { "location": "383/TALK"    , "narrator": "アーヤ", "text": "雰囲気的に、秘書とか\n向いてる気がするし。"},
        { "location": "386/TALK"    , "narrator": "みやび", "text": "秘書の仕事が、\nうちに向いてると\n思うんか？"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "ううん、雰囲気的に\n向いてそうに思える\nだけで――"},
        { "location": "391/TALK"    , "narrator": "アーヤ", "text": "実際に向いてるとは、\n全く思わないわ。"},
        { "location": "394/TALK"    , "narrator": "みやび", "text": "うちもそう思う。\n息苦しゅうて、ずーっと\nイライラしとるやろうね。"},
        { "location": "395/TALK"    , "narrator": "アーヤ", "text": "っていうか、みやびは\n就きたい仕事の希望とか\n条件って、ないの？"},
        { "location": "396/TALK"    , "narrator": "みやび", "text": "服装自由でパソコン\n弄れて、人と会わんで\n済む仕事がえいな。"},
        { "location": "397/TALK"    , "narrator": "アーヤ", "text": "…ピッタリだわ、それ。"},
        { "location": "400/TALK"    , "narrator": "みやび", "text": "うちもそう思うんよ。"},
        { "location": "401/TALK"    , "narrator": "アーヤ", "text": "まあ、それがどんな\n仕事なのかは私には\nわからないけど――"},
        { "location": "403/TALK"    , "narrator": "アーヤ", "text": "叶うことを祈ってるわ。"},
        { "location": "404/ACT"     , "narrator": "", "text": "神楽坂トライナリーに就職だ"},
        { "location": "424/TALK"    , "narrator": "みやび", "text": "相棒、真面目な話するとな"},
        { "location": "425/TALK"    , "narrator": "みやび", "text": "それ、悪くないぞね"},
        { "location": "439/TALK"    , "narrator": "みやび", "text": "…一度、まほさんに\n相談してみるか。"},
        { "location": "442/TALK"    , "narrator": "アーヤ", "text": "主語を抜かされたら\n何のことかわからないわ。"},
        { "location": "445/TALK"    , "narrator": "みやび", "text": "神楽坂トライナリーで\n雇ってもらえないか、\n聞いてみようと思うんよ。"},
        { "location": "448/TALK"    , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "449/TALK"    , "narrator": "みやび", "text": "あそこならスーツとか\n制服もないき、息苦しい\n想いせんですむし――"},
        { "location": "450/TALK"    , "narrator": "みやび", "text": "客も少ないき、気楽で\n自由に働いていけると\n思うがよ。"},
        { "location": "451/TALK"    , "narrator": "アーヤ", "text": "そ、そうかもしれない\nけど…。"},
        { "location": "453/TALK"    , "narrator": "アーヤ", "text": "でも、そんな理由で\n就職したいなんて\n言ったら――"},
        { "location": "454/TALK"    , "narrator": "アーヤ", "text": "絶対館長に怒られるわよ？"},
        { "location": "457/TALK"    , "narrator": "みやび", "text": "…まあ、そうやろうね。"},
        { "location": "461/TALK"    , "narrator": "みやび", "text": "けんど、うちはあの\n劇場の雰囲気、\n嫌いやないんよ。"},
        { "location": "462/TALK"    , "narrator": "みやび", "text": "ちゅうか、好きちや。\n大好きに近いくらい\n好きなんよ。"},
        { "location": "463/TALK"    , "narrator": "アーヤ", "text": "…初耳だわ。"},
        { "location": "464/TALK"    , "narrator": "みやび", "text": "言う機会も、言う必要も\n今までなかったきね。"},
        { "location": "465/TALK"    , "narrator": "みやび", "text": "やき、あそこに残れる\nいうんなら、うちとしては\n喜ばしいことながよ。"},
        { "location": "467/TALK"    , "narrator": "アーヤ", "text": "…なんだ、ちゃんとした\n理由があるんじゃない。"},
        { "location": "468/TALK"    , "narrator": "アーヤ", "text": "だったら、それを館長に\n言えば――"},
        { "location": "471/TALK"    , "narrator": "みやび", "text": "冗談やと思われて、\nそれでおしまいやと\n思うぞね。"},
        { "location": "472/TALK"    , "narrator": "アーヤ", "text": "それは日頃の行いの\nせいよね？"},
        { "location": "476/TALK"    , "narrator": "みやび", "text": "まあ、そういうわけやき、\n冗談と思われん別の理由を\n考えんといかんね。"},
        { "location": "478/TALK"    , "narrator": "アーヤ", "text": "とりあえず就職までは\n何年もあるんだから――"},
        { "location": "479/TALK"    , "narrator": "アーヤ", "text": "ゆっくり考えれば\nいいんじゃない？"},
        { "location": "490/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "491/TALK"    , "narrator": "真幌", "text": "あいつ…そんな風に\n思っていてくれてた\nとは…。"},
        { "location": "492/TALK"    , "narrator": "真幌", "text": "…あの劇場、やはり\n私の代で潰すわけには\nいかないようだな。"},
        { "location": "253/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月13日　3:35 PM</color>\nとある平日、ホームルーム終了直後に高等部廊下にて。"},
        { "location": "503/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch04", "text": "【モナルーム？　モナムール！】"}
    ]
}
