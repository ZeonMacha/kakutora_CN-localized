    [
        { "location": "88/SCENARIO", "narrator": "", "text": "026_ぬくもりの"},
        { "location": "113/TALK"   , "narrator": "アーヤ", "text": "中高時代の交友関係って多分一生もの"},
        { "location": "114/TALK"   , "narrator": "アーヤ", "text": "そんな気がするのよ"},
        { "location": "116/SEL"    , "narrator": "", "text": "そんなもん？"},
        { "location": "117/SEL"    , "narrator": "", "text": "おかんっぽいよ"},
        { "location": "118/SEL"    , "narrator": "", "text": "いいこと言うね"},
        { "location": "119/TALK"   , "narrator": "アーヤ", "text": "だからやっぱり色んな付き合いとか"},
        { "location": "120/TALK"   , "narrator": "アーヤ", "text": "しておくべきよね"},
        { "location": "123/ACT"    , "narrator": "", "text": "そんなもん？"},
        { "location": "124/TALK"   , "narrator": "アーヤ", "text": "そういうものよ"},
        { "location": "125/ACT"    , "narrator": "", "text": "おかんっぽいよ"},
        { "location": "126/TALK"   , "narrator": "アーヤ", "text": "何よ（｀皿´ )"},
        { "location": "127/TALK"   , "narrator": "アーヤ", "text": "悪いかしら（｀皿´ )"},
        { "location": "128/ACT"    , "narrator": "", "text": "いいこと言うね"},
        { "location": "130/TALK"   , "narrator": "アーヤ", "text": "そうかしら"},
        { "location": "131/TALK"   , "narrator": "アーヤ", "text": "普通よ"},
        { "location": "132/TALK"   , "narrator": "アーヤ", "text": "普通"},
        { "location": "134/TALK"   , "narrator": "アーヤ", "text": "つばめは順調にこっちの生活になじんでるみたい"},
        { "location": "135/TALK"   , "narrator": "アーヤ", "text": "だから一安心"},
        { "location": "136/TALK"   , "narrator": "アーヤ", "text": "でもギャヴィがちょっと"},
        { "location": "137/TALK"   , "narrator": "アーヤ", "text": "心配なのよね"},
        { "location": "140/SEL"    , "narrator": "", "text": "そっか"},
        { "location": "141/SEL"    , "narrator": "", "text": "心配し過ぎ"},
        { "location": "142/SEL"    , "narrator": "", "text": "$me$もフォローするよ"},
        { "location": "143/ACT"    , "narrator": "", "text": "そっか"},
        { "location": "144/TALK"   , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "145/ACT"    , "narrator": "", "text": "心配し過ぎ"},
        { "location": "146/TALK"   , "narrator": "アーヤ", "text": "ならいいんだけど"},
        { "location": "147/ACT"    , "narrator": "", "text": "$me$もフォローするよ"},
        { "location": "149/TALK"   , "narrator": "アーヤ", "text": "あら"},
        { "location": "150/TALK"   , "narrator": "アーヤ", "text": "そうしてくれる？"},
        { "location": "151/TALK"   , "narrator": "アーヤ", "text": "それなら少し安心だわ"},
        { "location": "155/TALK"   , "narrator": "アーヤ", "text": "やっぱりね"},
        { "location": "156/TALK"   , "narrator": "アーヤ", "text": "同学年のお友達って特別だもの"},
        { "location": "157/TALK"   , "narrator": "アーヤ", "text": "そればっかりは"},
        { "location": "158/TALK"   , "narrator": "アーヤ", "text": "私がどうにかすることできないし"},
        { "location": "159/TALK"   , "narrator": "アーヤ", "text": "残念だけど"}
    ]
