        "title": "003 アフターストーリー",
        "sub_title": "逢瀬つばめの思い出"
    },
    "entry":
    [
        { "location": "889/DIALOG", "narrator": "", "text": "<color=green>某月某日　5:36 PM</color>\nとある平日の放課後、神楽坂トライナリーのホワイエにて。"},
        { "location": "891/TALK"  , "narrator": "ガブリエラ", "text": "――はい、ご注文\n承りました。\n少々お待ちください。"},
        { "location": "893/TALK"  , "narrator": "ガブリエラ", "text": "…こんな感じ？"},
        { "location": "894/TALK"  , "narrator": "つばめ", "text": "うん、完璧だよ。\n次は神楽ちゃん、\nお客さんが入ってきたよ。"},
        { "location": "895/TALK"  , "narrator": "神楽", "text": "あ、いらっしゃいませ。\n何名様ですか？"},
        { "location": "896/TALK"  , "narrator": "神楽", "text": "二名様ですね。\nでは、窓際の席へどうぞ。"},
        { "location": "898/TALK"  , "narrator": "つばめ", "text": "二人とも、完璧！\n接客は問題なさそうだね。"},
        { "location": "899/TALK"  , "narrator": "ガブリエラ", "text": "まあ、接客業は劇場で\nずっとやってたしね。"},
        { "location": "900/TALK"  , "narrator": "神楽", "text": "本番で緊張しなければ\nこれくらい簡単ですよ。"},
        { "location": "901/TALK"  , "narrator": "つばめ", "text": "ふふっ、そうだね。"},
        { "location": "902/TALK"  , "narrator": "ガブリエラ", "text": "それより、お店の制服も\n作るのよね？"},
        { "location": "903/TALK"  , "narrator": "ガブリエラ", "text": "もうデザインって\n完成してるの？"},
        { "location": "904/TALK"  , "narrator": "つばめ", "text": "あ、うん。\nこんな感じにしてみようと\n思ってるの。"},
        { "location": "905/TALK"  , "narrator": "ガブリエラ", "text": "へー、ロゴの入った\nエプロンと、白いシャツ？"},
        { "location": "906/TALK"  , "narrator": "つばめ", "text": "他のカフェに行って、\n店員さんの格好を\n参考にしてきたんだけど。"},
        { "location": "907/TALK"  , "narrator": "つばめ", "text": "ちょっと地味だったかな？"},
        { "location": "908/TALK"  , "narrator": "ガブリエラ", "text": "あたしは結構好きよ。\nシンプルな方が\nうるさくないし。"},
        { "location": "910/TALK"  , "narrator": "神楽", "text": "えーっ、カフェなんだから\n可愛くしましょうよ。"},
        { "location": "911/TALK"  , "narrator": "神楽", "text": "ガブちゃんなんか、\nメイド服の方が\n絶対にかわいいですし。"},
        { "location": "913/TALK"  , "narrator": "ガブリエラ", "text": "メイドカフェするわけじゃ\nないから！"},
        { "location": "914/TALK"  , "narrator": "つばめ", "text": "でも、メイド服も\n考えはしたんだよ？"},
        { "location": "916/TALK"  , "narrator": "ガブリエラ", "text": "却下よ、却下！！"},
        { "location": "917/TALK"  , "narrator": "つばめ", "text": "だよねぇ…。"},
        { "location": "918/TALK"  , "narrator": "つばめ", "text": "だから、シンプルだけど\n誰でも着れる制服に\nしようと思ったんだ。"},
        { "location": "920/TALK"  , "narrator": "神楽", "text": "冗談抜きでいうなら、\nとっても素敵だと\n思いますよ。"},
        { "location": "921/TALK"  , "narrator": "神楽", "text": "コレなら動きやすいから、\n給仕もしやすいと\n思いますしね。"},
        { "location": "922/TALK"  , "narrator": "ガブリエラ", "text": "あたしも同感。\n採用でいいんじゃない？"},
        { "location": "923/TALK"  , "narrator": "つばめ", "text": "やった！\nじゃああとで真幌さんに\n発注のお願いしてくるよ。"},
        { "location": "924/TALK"  , "narrator": "つばめ", "text": "…でも、どうしよう？\nこれじゃわたしのお仕事、\nもうほとんどないかも…。"},
        { "location": "925/TALK"  , "narrator": "神楽", "text": "つばめさんのお仕事は\n開店してからが\n本番ですよ。"},
        { "location": "926/TALK"  , "narrator": "ガブリエラ", "text": "そうね。\nどんなお客さんが\n来たとしても…。"},
        { "location": "927/TALK"  , "narrator": "ガブリエラ", "text": "臨機応変に対応できる\nように、指示を出さないと\nいけないのよ？"},
        { "location": "930/TALK"  , "narrator": "つばめ", "text": "ううう、\nプレッシャーが…。"},
        { "location": "931/TALK"  , "narrator": "神楽", "text": "ふふっ、大変だとは\n思いますけど、\n頑張ってくださいね。"},
        { "location": "932/TALK"  , "narrator": "神楽", "text": "私たちも、できる限り\n協力しますから。"},
        { "location": "934/TALK"  , "narrator": "つばめ", "text": "ありがと…。"},
        { "location": "935/TALK"  , "narrator": "つばめ", "text": "でも、わたしも\n精一杯頑張るね！"},
        { "location": "936/TALK"  , "narrator": "ガブリエラ", "text": "あはは、つばめが\nそんなに燃えてるのも\n珍しいわね。"},
        { "location": "937/TALK"  , "narrator": "ガブリエラ", "text": "…そういえば、\n食器のことだけど、\nつばめはもう決めたの？"},
        { "location": "938/TALK"  , "narrator": "つばめ", "text": "うーん…まだちょっと\n悩み中かも…。"},
        { "location": "939/TALK"  , "narrator": "ガブリエラ", "text": "一つだけってのが\n難しいところよね。"},
        { "location": "940/TALK"  , "narrator": "神楽", "text": "私も悩んでるんです。\n候補が三つあって…。"},
        { "location": "941/TALK"  , "narrator": "神楽", "text": "つばめさんは、\nいくつ候補が\nあるんですか？"},
        { "location": "942/TALK"  , "narrator": "つばめ", "text": "え、えっとぉ…。"},
        { "location": "943/TALK"  , "narrator": "ガブリエラ", "text": "候補も決まってないとか？"},
        { "location": "944/TALK"  , "narrator": "つばめ", "text": "…一つ。"},
        { "location": "945/TALK"  , "narrator": "ガブリエラ", "text": "は？"},
        { "location": "946/TALK"  , "narrator": "つばめ", "text": "実は、お茶碗とかが\nいいかなぁ、なんて…。"},
        { "location": "948/TALK"  , "narrator": "ガブリエラ", "text": "茶碗？\nカフェなのにお茶碗が\n必要なのかしら。"},
        { "location": "950/TALK"  , "narrator": "神楽", "text": "ガブちゃん、最近の\nカフェは“和モダン”が\nウケるんですよっ！"},
        { "location": "951/TALK"  , "narrator": "神楽", "text": "ほうじ茶や緑茶、\n雑穀スープごはんとかが\n今のトレンドなんです！"},
        { "location": "952/TALK"  , "narrator": "ガブリエラ", "text": "ああっ、むぎまるの隣にも\nそんな感じの洒落た\nカフェがあったわね。"},
        { "location": "953/TALK"  , "narrator": "神楽", "text": "だから、アーヤさんと\n相談して、お茶碗も必要と\nいう結論になりました。"},
        { "location": "954/TALK"  , "narrator": "ガブリエラ", "text": "なるほどね、面白そう。\nでもなんでつばめは\nお茶碗がいいわけ？"},
        { "location": "955/TALK"  , "narrator": "つばめ", "text": "えっと、それは……\n…ちょっとだけ\n恥ずかしいんだけど…。"},
        { "location": "956/TALK"  , "narrator": "ガブリエラ", "text": "ごめん、\n意味不明なんだけど？"},
        { "location": "958/TALK"  , "narrator": "神楽", "text": "お茶碗になにか恥ずかしく\nなるような思い出でも\nあるんですか？"},
        { "location": "959/TALK"  , "narrator": "つばめ", "text": "う～ん、そういうことじゃ\nないんだけど…。"},
        { "location": "960/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、無理には\n聞かないけど――"},
        { "location": "961/TALK"  , "narrator": "ガブリエラ", "text": "後悔しないように\n考えなさいよ。"},
        { "location": "962/TALK"  , "narrator": "つばめ", "text": "…うん、そうするよ。"},
        { "location": "963/TALK"  , "narrator": "神楽", "text": "…じゃあ、つばめさん。\n私たちはそろそろ\n帰りますね。"},
        { "location": "965/TALK"  , "narrator": "つばめ", "text": "あ、うん。\nわざわざありがとね。"},
        { "location": "966/TALK"  , "narrator": "ガブリエラ", "text": "制服のデザイン、\nまほに渡すの忘れたら\nダメよ。"},
        { "location": "972/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "974/TALK"  , "narrator": "つばめ", "text": "食器、\nどうしようかなぁ…。"},
        { "location": "975/SEL"   , "narrator": "（選択肢）", "text": "なにが問題なの？"},
        { "location": "976/ACT"   , "narrator": "", "text": "なにが問題なの？"},
        { "location": "993/TALK"  , "narrator": "つばめ", "text": "問題"},
        { "location": "994/TALK"  , "narrator": "つばめ", "text": "なのかな？(´･ω･｀) "},
        { "location": "995/TALK"  , "narrator": "つばめ", "text": "そぅぃぅのとは"},
        { "location": "996/TALK"  , "narrator": "つばめ", "text": "ちょっと違ぅよぅな(･Д･｀)"},
        { "location": "1000/TALK" , "narrator": "つばめ", "text": "茶碗がぃぃって"},
        { "location": "1001/TALK" , "narrator": "つばめ", "text": "思ったのにはね"},
        { "location": "1002/TALK" , "narrator": "つばめ", "text": "理由がぁるの(´艸`*"},
        { "location": "1003/TALK" , "narrator": "つばめ", "text": "ぁのね"},
        { "location": "1004/TALK" , "narrator": "つばめ", "text": "夫婦茶碗って"},
        { "location": "1005/TALK" , "narrator": "つばめ", "text": "知ってる？(・ω・`)"},
        { "location": "1007/SEL"  , "narrator": "（選択肢）", "text": "知ってる"},
        { "location": "1008/SEL"  , "narrator": "（選択肢）", "text": "知らない"},
        { "location": "1009/ACT"  , "narrator": "", "text": "知ってる"},
        { "location": "1010/ACT"  , "narrator": "", "text": "知らない"},
        { "location": "1011/TALK" , "narrator": "つばめ", "text": "夫婦で使う茶碗で"},
        { "location": "1013/TALK" , "narrator": "つばめ", "text": "大きぃのがぉ父さん"},
        { "location": "1014/TALK" , "narrator": "つばめ", "text": "小さぃのがぉ母さん用なの(´ω｀*)"},
        { "location": "1016/TALK" , "narrator": "つばめ", "text": "ぅちのぉ父さんとぉ母さん"},
        { "location": "1017/TALK" , "narrator": "つばめ", "text": "それ使ってて"},
        { "location": "1018/TALK" , "narrator": "つばめ", "text": "ぃぃなって(´∀｀*)ｳﾌﾌ"},
        { "location": "1019/TALK" , "narrator": "つばめ", "text": "小さぃ頃から思ってたの(≧ω≦)"},
        { "location": "1021/SEL"  , "narrator": "（選択肢）", "text": "あのお父さんが使ってるの！？"},
        { "location": "1022/SEL"  , "narrator": "（選択肢）", "text": "ラブラブ夫婦か！！"},
        { "location": "1023/ACT"  , "narrator": "", "text": "あのお父さんが使ってるの！？"},
        { "location": "1024/TALK" , "narrator": "つばめ", "text": "今は使ってなぃけど(´･ω･｀) "},
        { "location": "1025/ACT"  , "narrator": "", "text": "ラブラブ夫婦か！！"},
        { "location": "1026/TALK" , "narrator": "つばめ", "text": "そぅだよ(*´︶`*)"},
        { "location": "1027/TALK" , "narrator": "つばめ", "text": "ぉ父さんとぉ母さん"},
        { "location": "1028/TALK" , "narrator": "つばめ", "text": "とっても仲良しなの(´∀｀*)"},
        { "location": "1029/TALK" , "narrator": "つばめ", "text": "でも"},
        { "location": "1030/TALK" , "narrator": "つばめ", "text": "今はぉ父さん"},
        { "location": "1031/TALK" , "narrator": "つばめ", "text": "違ぅ茶碗使ってるんだ(´･ω･｀) "},
        { "location": "1033/TALK" , "narrator": "つばめ", "text": "ぉ母さん入院してから"},
        { "location": "1035/TALK" , "narrator": "つばめ", "text": "自分だけ使っても意味がなぃって"},
        { "location": "1036/TALK" , "narrator": "つばめ", "text": "しまっちゃってて(o´Д`)=з"},
        { "location": "1039/TALK" , "narrator": "つばめ", "text": "なんか"},
        { "location": "1040/TALK" , "narrator": "つばめ", "text": "それ見て"},
        { "location": "1041/TALK" , "narrator": "つばめ", "text": "ぃぃなって思っちゃって(´,,･ω･,,｀)"},
        { "location": "1042/TALK" , "narrator": "つばめ", "text": "わたしも使ぃたぃなって"},
        { "location": "1043/TALK" , "narrator": "つばめ", "text": "憧れてるの(●´ω｀●)ゞ"},
        { "location": "1045/SEL"  , "narrator": "（選択肢）", "text": "それで茶碗が好きなんだ？"},
        { "location": "1046/ACT"  , "narrator": "", "text": "それで茶碗が好きなんだ？"},
        { "location": "1048/TALK" , "narrator": "つばめ", "text": "うん(*≧∀≦*) "},
        { "location": "1049/TALK" , "narrator": "つばめ", "text": "でも"},
        { "location": "1050/TALK" , "narrator": "つばめ", "text": "茶碗にした理由聞かれたとき"},
        { "location": "1051/TALK" , "narrator": "つばめ", "text": "ちょっと恥ずかしくて(/ω＼)"},
        { "location": "1054/TALK" , "narrator": "つばめ", "text": "それで悩んでるの"},
        { "location": "1056/SEL"  , "narrator": "（選択肢）", "text": "素敵な理由だと思うよ"},
        { "location": "1057/SEL"  , "narrator": "（選択肢）", "text": "$me$とつばめだけの秘密にしよう"},
        { "location": "1058/ACT"  , "narrator": "", "text": "素敵な理由だと思うよ"},
        { "location": "1059/TALK" , "narrator": "つばめ", "text": "そぅかな？(´･ω･｀) "},
        { "location": "1060/TALK" , "narrator": "つばめ", "text": "本当に"},
        { "location": "1061/TALK" , "narrator": "つばめ", "text": "そぅ思ってくれてる？o(*･ﾛ･*)o、"},
        { "location": "1063/SEL"  , "narrator": "（選択肢）", "text": "つばめ以外にいないと思う"},
        { "location": "1064/ACT"  , "narrator": "", "text": "つばめ以外にいないと思う"},
        { "location": "1066/TALK" , "narrator": "つばめ", "text": "ぁりがと(*´︶`*)"},
        { "location": "1068/TALK" , "narrator": "つばめ", "text": "なんだか"},
        { "location": "1069/TALK" , "narrator": "つばめ", "text": "勇気出てきたかも(๑･ㅂ･)و☆"},
        { "location": "1070/ACT"  , "narrator": "", "text": "$me$とつばめだけの秘密にしよう"},
        { "location": "1071/TALK" , "narrator": "つばめ", "text": "二人だけの秘密(≧艸≦*)"},
        { "location": "1072/TALK" , "narrator": "つばめ", "text": "嬉しぃけど"},
        { "location": "1073/TALK" , "narrator": "つばめ", "text": "できるかな？(´･ω･｀) "},
        { "location": "1074/TALK" , "narrator": "つばめ", "text": "理由聞かれたら"},
        { "location": "1075/TALK" , "narrator": "つばめ", "text": "どう答えればぃぃかな？(･Д･｀)"},
        { "location": "1077/SEL"  , "narrator": "（選択肢）", "text": "ご飯が好きだから"},
        { "location": "1078/SEL"  , "narrator": "（選択肢）", "text": "茶碗が好きだから、で大丈夫"},
        { "location": "1079/ACT"  , "narrator": "", "text": "ご飯が好きだから"},
        { "location": "1080/TALK" , "narrator": "つばめ", "text": "わたし"},
        { "location": "1081/TALK" , "narrator": "つばめ", "text": "食ぃしん坊？Σ(ﾟдﾟlll)"},
        { "location": "1082/ACT"  , "narrator": "", "text": "茶碗が好きだから、で大丈夫"},
        { "location": "1083/TALK" , "narrator": "つばめ", "text": "そっか(｡･ω･｡)"},
        { "location": "1085/TALK" , "narrator": "つばめ", "text": "でも"},
        { "location": "1086/TALK" , "narrator": "つばめ", "text": "それしかなぃよね(・ω・`)"},
        { "location": "1088/TALK" , "narrator": "つばめ", "text": "それじゃぁ"},
        { "location": "1089/TALK" , "narrator": "つばめ", "text": "みんなにＷＡＶＥ送るねヽ(*´∀｀*)ﾉ"},
        { "location": "1090/TALK" , "narrator": "つばめ", "text": "背中押してくれて"},
        { "location": "1091/TALK" , "narrator": "つばめ", "text": "ぁりがと(≧ω≦)"}
    ]
}
