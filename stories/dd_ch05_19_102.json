        { "location": "825/ACT"    , "narrator": "", "text": "つばめに声を掛ける"},
        { "location": "837/TALK"   , "narrator": "つばめ", "text": "$handle$さんどうしたの？"},
        { "location": "839/SEL"    , "narrator": "", "text": "ちょっと気になって"},
        { "location": "840/ACT"    , "narrator": "", "text": "ちょっと気になって"},
        { "location": "841/TALK"   , "narrator": "つばめ", "text": "ぇと"},
        { "location": "842/TALK"   , "narrator": "つばめ", "text": "何が？"},
        { "location": "844/SEL"    , "narrator": "", "text": "初めての海水浴だって聞いて"},
        { "location": "845/SEL"    , "narrator": "", "text": "ずっと入院してたんだよねって思って"},
        { "location": "846/SEL"    , "narrator": "", "text": "$me$も一緒に行きたかったなって"},
        { "location": "847/ACT"    , "narrator": "", "text": "初めての海水浴だって聞いて"},
        { "location": "848/TALK"   , "narrator": "つばめ", "text": "ぅん"},
        { "location": "849/TALK"   , "narrator": "つばめ", "text": "そうなんだ(*´︶`*)"},
        { "location": "850/ACT"    , "narrator": "", "text": "ずっと入院してたんだよねって思って"},
        { "location": "851/TALK"   , "narrator": "つばめ", "text": "そぅなの(´・ω・`) "},
        { "location": "852/TALK"   , "narrator": "つばめ", "text": "検査とかあと体調とかの関係で行けなくて"},
        { "location": "853/ACT"    , "narrator": "", "text": "$me$も一緒に行きたかったなって"},
        { "location": "854/TALK"   , "narrator": "つばめ", "text": "海ぃぃょね(≧ω≦)"},
        { "location": "855/TALK"   , "narrator": "つばめ", "text": "夏っぽいし"},
        { "location": "856/TALK"   , "narrator": "つばめ", "text": "水着も着れるし"},
        { "location": "857/TALK"   , "narrator": "つばめ", "text": "ぁたしも$handle$さんと来たかったょ"},
        { "location": "859/TALK"   , "narrator": "つばめ", "text": "今回は無理だけど"},
        { "location": "860/TALK"   , "narrator": "つばめ", "text": "いつか$handle$さんとも来たぃな"},
        { "location": "861/SEL"    , "narrator": "", "text": "絶対だよ"},
        { "location": "862/SEL"    , "narrator": "", "text": "そうだね"},
        { "location": "863/SEL"    , "narrator": "", "text": "その時は色々楽しもう"},
        { "location": "864/ACT"    , "narrator": "", "text": "絶対だよ"},
        { "location": "865/TALK"   , "narrator": "つばめ", "text": "ぅん絶対"},
        { "location": "866/TALK"   , "narrator": "つばめ", "text": "絶対だからね"},
        { "location": "867/ACT"    , "narrator": "", "text": "そうだね"},
        { "location": "868/TALK"   , "narrator": "つばめ", "text": "でしょ？"},
        { "location": "869/TALK"   , "narrator": "つばめ", "text": "行こうねふたりで"},
        { "location": "870/ACT"    , "narrator": "", "text": "その時は色々楽しもう"},
        { "location": "871/TALK"   , "narrator": "つばめ", "text": "ぅんぅん"},
        { "location": "872/TALK"   , "narrator": "つばめ", "text": "楽しみにしてる"},
        { "location": "884/TALK"   , "narrator": "つばめ", "text": "ふふふ……。\n$handle$さんったら…。"},
        { "location": "897/TALK"   , "narrator": "つばめ", "text": "もしかして$handle$さん心配してくれた？"},
        { "location": "898/TALK"   , "narrator": "つばめ", "text": "ぁたしのこと"},
        { "location": "900/SEL"    , "narrator": "", "text": "ちょっとだけね"},
        { "location": "901/SEL"    , "narrator": "", "text": "話したかっただけだから"},
        { "location": "902/SEL"    , "narrator": "", "text": "みんなも心配してると思うよ"},
        { "location": "903/ACT"    , "narrator": "", "text": "ちょっとだけね"},
        { "location": "904/TALK"   , "narrator": "つばめ", "text": "そっか。。。"},
        { "location": "905/TALK"   , "narrator": "つばめ", "text": "みんなにも心配かけちゃったねきっと"},
        { "location": "906/ACT"    , "narrator": "", "text": "話したかっただけだから"},
        { "location": "907/TALK"   , "narrator": "つばめ", "text": "そぅなの？"},
        { "location": "908/TALK"   , "narrator": "つばめ", "text": "$handle$さんは優しいね"},
        { "location": "909/ACT"    , "narrator": "", "text": "みんなも心配してると思うよ"},
        { "location": "910/TALK"   , "narrator": "つばめ", "text": "そぅだね"},
        { "location": "911/TALK"   , "narrator": "つばめ", "text": "ぁたしはもう気にしてないけど"},
        { "location": "913/TALK"   , "narrator": "つばめ", "text": "みんなに今はすごく楽しいからって"},
        { "location": "914/TALK"   , "narrator": "つばめ", "text": "ちゃんと言うね"},
        { "location": "915/TALK"   , "narrator": "つばめ", "text": "気付かせてくれてぁりがとう"},
        { "location": "916/TALK"   , "narrator": "つばめ", "text": "やっぱり$handle$さんだいすき(´ω｀*)"},
        { "location": "927/TALK"   , "narrator": "つばめ", "text": "えっと。"},
        { "location": "928/TALK"   , "narrator": "つばめ", "text": "あの、わたし、今\nすごく楽しいから。"},
        { "location": "929/TALK"   , "narrator": "つばめ", "text": "みんなとこうやって\n海に来れて\n幸せだし。"},
        { "location": "930/TALK"   , "narrator": "つばめ", "text": "だから、その……。"},
        { "location": "931/TALK"   , "narrator": "ガブリエラ", "text": "そんなに真剣に\nならなくても。"},
        { "location": "933/TALK"   , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "934/TALK"   , "narrator": "アーヤ", "text": "ギャヴィ。\n意地悪言わないの。"},
        { "location": "935/TALK"   , "narrator": "神楽", "text": "そうですよ。\nつばめさんの初めてを\n私たちは奪ったんですよ？"},
        { "location": "936/TALK"   , "narrator": "アーヤ", "text": "それもちょっと\n違うと思うけど……。"},
        { "location": "937/TALK"   , "narrator": "つばめ", "text": "ふふふ……。"},
        { "location": "938/ACT"    , "narrator": "", "text": "アーヤに声を掛ける"},
        { "location": "950/TALK"   , "narrator": "アーヤ", "text": "呼んだ？"},
        { "location": "951/SEL"    , "narrator": "", "text": "話題を変えたいんじゃないかと思って"},
        { "location": "952/ACT"    , "narrator": "", "text": "話題を変えたいんじゃないかと思って"},
        { "location": "953/TALK"   , "narrator": "アーヤ", "text": "さすが$handle$さん"},
        { "location": "955/SEL"    , "narrator": "", "text": "遠泳しようって言ってみよう"},
        { "location": "956/SEL"    , "narrator": "", "text": "日焼け止めの話題を出そう"},
        { "location": "957/SEL"    , "narrator": "", "text": "潮干狩りに誘おう"},
        { "location": "958/ACT"    , "narrator": "", "text": "遠泳しようって言ってみよう"},
        { "location": "959/TALK"   , "narrator": "アーヤ", "text": "なんでそうなるの？"},
        { "location": "960/ACT"    , "narrator": "", "text": "日焼け止めの話題を出そう"},
        { "location": "961/TALK"   , "narrator": "アーヤ", "text": "わかるようなわからないような"},
        { "location": "962/ACT"    , "narrator": "", "text": "潮干狩りに誘おう"},
        { "location": "963/TALK"   , "narrator": "アーヤ", "text": "時期じゃないわよ(-.-;)"},
        { "location": "965/TALK"   , "narrator": "アーヤ", "text": "でもあれね(￣Д￣ )"},
        { "location": "966/TALK"   , "narrator": "アーヤ", "text": "重く取り過ぎるのがよくないって言いたいんでしょ？"},
        { "location": "968/SEL"    , "narrator": "", "text": "そうそれだ！"},
        { "location": "969/SEL"    , "narrator": "", "text": "もちろんだよアーヤ……"},
        { "location": "970/ACT"    , "narrator": "", "text": "そうそれだ！"},
        { "location": "971/TALK"   , "narrator": "アーヤ", "text": "適当なの？"},
        { "location": "972/ACT"    , "narrator": "", "text": "もちろんだよアーヤ……"},
        { "location": "973/TALK"   , "narrator": "アーヤ", "text": "そこまで考えてなかったの？"},
        { "location": "975/TALK"   , "narrator": "アーヤ", "text": "私もつばめも別に話を重くしたかったわけじゃないし"},
        { "location": "976/TALK"   , "narrator": "アーヤ", "text": "確かにそれが一番いいわね"},
        { "location": "978/SEL"    , "narrator": "", "text": "役に立てたかな？"},
        { "location": "979/SEL"    , "narrator": "", "text": "前向きに行こう！"},
        { "location": "980/SEL"    , "narrator": "", "text": "見直してくれた？"},
        { "location": "981/ACT"    , "narrator": "", "text": "役に立てたかな？"},
        { "location": "982/TALK"   , "narrator": "アーヤ", "text": "なんでそういう聞き方するの？"},
        { "location": "983/TALK"   , "narrator": "アーヤ", "text": "$handle$さんはいてくれるだけで十分なのに"},
        { "location": "984/ACT"    , "narrator": "", "text": "前向きに行こう！"},
        { "location": "985/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "986/TALK"   , "narrator": "アーヤ", "text": "それが一番！"},
        { "location": "987/ACT"    , "narrator": "", "text": "見直してくれた？"},
        { "location": "988/TALK"   , "narrator": "アーヤ", "text": "まさか"},
        { "location": "989/TALK"   , "narrator": "アーヤ", "text": "いつでも最高って思ってるだけよ"},
        { "location": "1001/TALK"  , "narrator": "アーヤ", "text": "前向きに前向きに。\n何がいいかしら…。"},
        { "location": "1002/TALK"  , "narrator": "アーヤ", "text": "ねえ。\nちょっとカフェに\n涼みにいかない？"},
        { "location": "1003/TALK"  , "narrator": "ガブリエラ", "text": "あ、いいわね。"},
        { "location": "1004/TALK"  , "narrator": "アーヤ", "text": "せっかくだし\n行ったことの\nないところに。"},
        { "location": "1005/TALK"  , "narrator": "アーヤ", "text": "初めてっていつでも\nわくわくするでしょ？"},
        { "location": "1006/TALK"  , "narrator": "つばめ", "text": "うん。\nそうなんです！"},
        { "location": "1007/TALK"  , "narrator": "ガブリエラ", "text": "たまにはいいこと\n言うわね。"},
        { "location": "1008/TALK"  , "narrator": "神楽", "text": "じゃああの道を\nちょっと右手に行った\n店とかどうですか？"},
        { "location": "1009/TALK"  , "narrator": "アーヤ", "text": "ちょっと\nアジアンテイストな\nカフェのこと？"},
        { "location": "1010/TALK"  , "narrator": "アーヤ", "text": "じゃあ行って\nみましょうか。"},
        { "location": "1011/TALK"  , "narrator": "つばめ", "text": "はい！"},
        { "location": "1012/TALK"  , "narrator": "アーヤ", "text": "$handle$さんは\nいつも優しい気持ちを\nくれるから。"},
        { "location": "1013/TALK"  , "narrator": "アーヤ", "text": "私もみんなに\n優しくできる。"},
        { "location": "1014/TALK"  , "narrator": "アーヤ", "text": "大好きよ、\n$handle$さん。"},
        { "location": "1015/ACT"   , "narrator": "", "text": "ガブリエラに声を掛ける"},
        { "location": "1028/SEL"   , "narrator": "", "text": "提案がある"},
        { "location": "1029/ACT"   , "narrator": "", "text": "提案がある"},
        { "location": "1030/TALK"  , "narrator": "ガブリエラ", "text": "あら何かしら？？？"},
        { "location": "1032/SEL"   , "narrator": "", "text": "海水浴もしたことないのって言ってやれ"},
        { "location": "1033/SEL"   , "narrator": "", "text": "ポーランドの海自慢をしよう"},
        { "location": "1034/SEL"   , "narrator": "", "text": "話題を変えよう"},
        { "location": "1035/ACT"   , "narrator": "", "text": "海水浴もしたことないのって言ってやれ"},
        { "location": "1036/TALK"  , "narrator": "ガブリエラ", "text": "ひどすぎない？？？"},
        { "location": "1037/ACT"   , "narrator": "", "text": "ポーランドの海自慢をしよう"},
        { "location": "1038/TALK"  , "narrator": "ガブリエラ", "text": "それもちょっと、、、"},
        { "location": "1039/ACT"   , "narrator": "", "text": "話題を変えよう"},
        { "location": "1040/TALK"  , "narrator": "ガブリエラ", "text": "そうよねｖｖｖ"},
        { "location": "1041/TALK"  , "narrator": "ガブリエラ", "text": "でも具体的には"},
        { "location": "1042/TALK"  , "narrator": "ガブリエラ", "text": "どうすればいいかしら？"},
        { "location": "1044/TALK"  , "narrator": "ガブリエラ", "text": "なかなか難しいわよね"},
        { "location": "1045/TALK"  , "narrator": "ガブリエラ", "text": "誰が悪いわけでもないのに"},
        { "location": "1046/TALK"  , "narrator": "ガブリエラ", "text": "変な雰囲気になった時って"},
        { "location": "1048/SEL"   , "narrator": "", "text": "確かにね"},
        { "location": "1049/SEL"   , "narrator": "", "text": "$me$が代わってあげたい"},
        { "location": "1050/SEL"   , "narrator": "", "text": "鈍感力も必要"},
        { "location": "1051/ACT"   , "narrator": "", "text": "確かにね"},
        { "location": "1052/TALK"  , "narrator": "ガブリエラ", "text": "そうなのよね、、、"},
        { "location": "1053/ACT"   , "narrator": "", "text": "$me$が代わってあげたい"},
        { "location": "1054/TALK"  , "narrator": "ガブリエラ", "text": "あらｖｖｖｖ"},
        { "location": "1055/ACT"   , "narrator": "", "text": "鈍感力も必要"},
        { "location": "1056/TALK"  , "narrator": "ガブリエラ", "text": "そうかもしれないわ"},
        { "location": "1058/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと先輩らしく"},
        { "location": "1059/TALK"  , "narrator": "ガブリエラ", "text": "何か言ってみるわ"},
        { "location": "1060/TALK"  , "narrator": "ガブリエラ", "text": "見ててね$handle$///////////////////"},
        { "location": "1071/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとつばめ。"},
        { "location": "1072/TALK"  , "narrator": "つばめ", "text": "あ、はい。"},
        { "location": "1073/TALK"  , "narrator": "ガブリエラ", "text": "今回\nあたしたちと来れて\nよかったでしょ。"},
        { "location": "1074/TALK"  , "narrator": "つばめ", "text": "それはもちろん！"},
        { "location": "1076/TALK"  , "narrator": "ガブリエラ", "text": "それにその水着も\nよく見ると結構\n似合ってるし。"},
        { "location": "1077/TALK"  , "narrator": "神楽", "text": "当然ですよ！\n私が選んだん\nですから。"},
        { "location": "1079/TALK"  , "narrator": "ガブリエラ", "text": "だからそれで\nいいじゃない。"},
        { "location": "1080/TALK"  , "narrator": "アーヤ", "text": "ギャヴィったら…。"},
        { "location": "1081/TALK"  , "narrator": "つばめ", "text": "えと…フォローして\nくれた、ん、\nだよね？"},
        { "location": "1082/TALK"  , "narrator": "ガブリエラ", "text": "先輩としてね。\nあくまで。"},
        { "location": "1094/TALK"  , "narrator": "ガブリエラ", "text": "どう？"},
        { "location": "1095/TALK"  , "narrator": "ガブリエラ", "text": "先輩っぽくできたかしら？"},
        { "location": "1096/SEL"   , "narrator": "", "text": "最高！"},
        { "location": "1097/SEL"   , "narrator": "", "text": "いいツンデレだったよ"},
        { "location": "1098/SEL"   , "narrator": "", "text": "今度$me$にも優しくして"},
        { "location": "1099/ACT"   , "narrator": "", "text": "最高！"},
        { "location": "1100/TALK"  , "narrator": "ガブリエラ", "text": "そうでしょ//////////////"},
        { "location": "1101/TALK"  , "narrator": "ガブリエラ", "text": "よかったわそう言ってもらえてｖｖｖｖｖ"},
        { "location": "1102/ACT"   , "narrator": "", "text": "いいツンデレだったよ"},
        { "location": "1103/TALK"  , "narrator": "ガブリエラ", "text": "何よそれ！！！"},
        { "location": "1104/TALK"  , "narrator": "ガブリエラ", "text": "いつもそんな言い方ばっかりするんだからｖｖｖｖｖ"},
        { "location": "1105/ACT"   , "narrator": "", "text": "今度$me$にも優しくして"},
        { "location": "1106/TALK"  , "narrator": "ガブリエラ", "text": "しないわけがないでしょ？"},
        { "location": "1107/TALK"  , "narrator": "ガブリエラ", "text": "私の$handle$///////////////////"},
        { "location": "1119/TALK"  , "narrator": "ガブリエラ", "text": "$handle$ったら\nもう……。"},
        { "location": "1120/TALK"  , "narrator": "ガブリエラ", "text": "照れちゃうじゃ\nないの……。"},
        { "location": "1121/ACT"   , "narrator": "", "text": "神楽に声を掛ける"},
        { "location": "1133/TALK"  , "narrator": "神楽", "text": "んー？"},
        { "location": "1134/SEL"   , "narrator": "", "text": "フォローした方がよくない？"},
        { "location": "1135/ACT"   , "narrator": "", "text": "フォローした方がよくない？"},
        { "location": "1138/SEL"   , "narrator": "", "text": "嫌なら無理にとは言わないけど"},
        { "location": "1139/SEL"   , "narrator": "", "text": "一応流れ的には"},
        { "location": "1140/SEL"   , "narrator": "", "text": "このふいんき辛くない？"},
        { "location": "1141/ACT"   , "narrator": "", "text": "嫌なら無理にとは言わないけど"},
        { "location": "1142/TALK"  , "narrator": "神楽", "text": "嫌っていうわけじゃないぴょん"},
        { "location": "1143/TALK"  , "narrator": "神楽", "text": "でもこれってある種自爆テロっていうかー"},
        { "location": "1144/TALK"  , "narrator": "神楽", "text": "自業自得的なアレじゃね？"},
        { "location": "1145/ACT"   , "narrator": "", "text": "一応流れ的には"},
        { "location": "1146/TALK"  , "narrator": "神楽", "text": "そうかもﾅｰ"},
        { "location": "1147/TALK"  , "narrator": "神楽", "text": "つばめスキーってキャラ的にも"},
        { "location": "1148/TALK"  , "narrator": "神楽", "text": "どうにかしないといけないかもー"},
        { "location": "1149/ACT"   , "narrator": "", "text": "このふいんき辛くない？"},
        { "location": "1150/TALK"  , "narrator": "神楽", "text": "あーまーねー"},
        { "location": "1151/TALK"  , "narrator": "神楽", "text": "微妙だよねー"},
        { "location": "1152/TALK"  , "narrator": "神楽", "text": "ふいんきがなー"},
        { "location": "1154/TALK"  , "narrator": "神楽", "text": "ぴょんこ的には"},
        { "location": "1155/TALK"  , "narrator": "神楽", "text": "何となく流してもいいような気もするけど"},
        { "location": "1156/TALK"  , "narrator": "神楽", "text": "やっぱ冷たく見えるかな？"},
        { "location": "1157/TALK"  , "narrator": "神楽", "text": "$handle$の意見ﾌﾟﾘｰｽﾞ"},
        { "location": "1158/SEL"   , "narrator": "", "text": "見えると思う"},
        { "location": "1159/SEL"   , "narrator": "", "text": "そうでもないかな…？"},
        { "location": "1160/SEL"   , "narrator": "", "text": "自分の気持ちに正直になって！"},
        { "location": "1161/ACT"   , "narrator": "", "text": "見えると思う"},
        { "location": "1162/TALK"  , "narrator": "神楽", "text": "むー"},
        { "location": "1163/ACT"   , "narrator": "", "text": "そうでもないかな…？"},
        { "location": "1164/TALK"  , "narrator": "神楽", "text": "ならいいかな？？？"},
        { "location": "1165/ACT"   , "narrator": "", "text": "自分の気持ちに正直になって！"},
        { "location": "1166/TALK"  , "narrator": "神楽", "text": "お、おう、、、"},
        { "location": "1168/TALK"  , "narrator": "神楽", "text": "ちょっと言っておきたい"},
        { "location": "1169/TALK"  , "narrator": "神楽", "text": "ぴょんこはやっぱりＫＹ系女子でいたいぴょん"},
        { "location": "1171/SEL"   , "narrator": "", "text": "あと任務にも差し障りが出るかも"},
        { "location": "1172/SEL"   , "narrator": "", "text": "照れ隠しなんでしょ、知ってる"},
        { "location": "1173/SEL"   , "narrator": "", "text": "神楽は本当は優しいもんね"},
        { "location": "1174/ACT"   , "narrator": "", "text": "あと任務にも差し障りが出るかも"},
        { "location": "1175/TALK"  , "narrator": "神楽", "text": "あーねー"},
        { "location": "1176/TALK"  , "narrator": "神楽", "text": "それは困る"},
        { "location": "1177/TALK"  , "narrator": "神楽", "text": "$handle$冷静すぎ"},
        { "location": "1178/TALK"  , "narrator": "神楽", "text": "でもそこがｽｷ"},
        { "location": "1179/ACT"   , "narrator": "", "text": "照れ隠しなんでしょ、知ってる"},
        { "location": "1180/TALK"  , "narrator": "神楽", "text": "はぁぁぁぁ？？？"},
        { "location": "1181/TALK"  , "narrator": "神楽", "text": "何を言い出すかと思えば"},
        { "location": "1182/TALK"  , "narrator": "神楽", "text": "そんなことするのは$handle$相手だけぴょん♪"},
        { "location": "1183/TALK"  , "narrator": "神楽", "text": "本気にするように！！！！"},
        { "location": "1184/ACT"   , "narrator": "", "text": "神楽は本当は優しいもんね"},
        { "location": "1185/TALK"  , "narrator": "神楽", "text": "まあね？？？"},
        { "location": "1186/TALK"  , "narrator": "神楽", "text": "でも優しいのは$handle$限定なんだけどﾅｰ"},
        { "location": "1187/TALK"  , "narrator": "神楽", "text": "ぴょんこの乙女心は届いてないのかな？"},
        { "location": "1188/TALK"  , "narrator": "神楽", "text": "ぴょんぴょんぴょーん♪"},
        { "location": "1200/TALK"  , "narrator": "神楽", "text": "確かに今までの行動を\n考えたらフォロー\nしないのは不自然かも。"},
        { "location": "1201/TALK"  , "narrator": "神楽", "text": "つばめさんの\nはじめてに立ちあえて\nうれしいです。"},
        { "location": "1202/TALK"  , "narrator": "神楽", "text": "いい思い出を\nいっぱい作りましょうね。"},
        { "location": "1203/TALK"  , "narrator": "つばめ", "text": "うん！"},
        { "location": "1215/TALK"  , "narrator": "神楽", "text": "どうよ"},
        { "location": "1217/SEL"   , "narrator": "", "text": "さすがだね"},
        { "location": "1218/SEL"   , "narrator": "", "text": "本気も混じってるでしょ"},
        { "location": "1219/SEL"   , "narrator": "", "text": "$me$とも思い出作ろうよ"},
        { "location": "1220/ACT"   , "narrator": "", "text": "さすがだね"},
        { "location": "1221/TALK"  , "narrator": "神楽", "text": "もっとほめてもいいのよ？"},
        { "location": "1222/ACT"   , "narrator": "", "text": "本気も混じってるでしょ"},
        { "location": "1223/TALK"  , "narrator": "神楽", "text": "わるい？"},
        { "location": "1224/ACT"   , "narrator": "", "text": "$me$とも思い出作ろうよ"},
        { "location": "1225/TALK"  , "narrator": "神楽", "text": "今この瞬間が思い出ぴょん♪"},
        { "location": "1227/TALK"  , "narrator": "神楽", "text": "なんかさー"},
        { "location": "1228/TALK"  , "narrator": "神楽", "text": "ぴょんこは$handle$だけが心の支えぴょん"},
        { "location": "1229/TALK"  , "narrator": "神楽", "text": "だからもっと優しくしてくれなきゃﾔﾀﾞ"},
        { "location": "1230/SEL"   , "narrator": "", "text": "世界で一番ステキだよ神楽"},
        { "location": "1231/SEL"   , "narrator": "", "text": "よしよしよくがんばった！"},
        { "location": "1232/SEL"   , "narrator": "", "text": "神楽がいない世界なんてありえない"},
        { "location": "1233/ACT"   , "narrator": "", "text": "世界で一番ステキだよ神楽"},
        { "location": "1234/TALK"  , "narrator": "神楽", "text": "それってただの告白"},
        { "location": "1235/TALK"  , "narrator": "神楽", "text": "でもｳﾚｼｰ"},
        { "location": "1236/ACT"   , "narrator": "", "text": "よしよしよくがんばった！"},
        { "location": "1238/TALK"  , "narrator": "神楽", "text": "そーゆーの待ってたぴょん"},
        { "location": "1239/TALK"  , "narrator": "神楽", "text": "もっともっと(*´Д`)ﾊｧﾊｧ"},
        { "location": "1240/ACT"   , "narrator": "", "text": "神楽がいない世界なんてありえない"},
        { "location": "1241/TALK"  , "narrator": "神楽", "text": "やだセカイ系？"},
        { "location": "1242/TALK"  , "narrator": "神楽", "text": "情熱的～～"},
        { "location": "1243/TALK"  , "narrator": "神楽", "text": "プルプル震えちゃう♪"},
        { "location": "1245/TALK"  , "narrator": "神楽", "text": "よしよし"},
        { "location": "1246/TALK"  , "narrator": "神楽", "text": "ぴょんこはまた頑張る気力がわいてきたぴょん"},
        { "location": "1278/TALK"  , "narrator": "神楽", "text": "…この世界は、\n創られた\nウソの世界…。"},
        { "location": "1279/TALK"  , "narrator": "神楽", "text": "でも、間違いなく\nこの世界は存在する。"},
        { "location": "1280/TALK"  , "narrator": "神楽", "text": "例えこの世界が\nなくなったとしても。"},
        { "location": "1281/TALK"  , "narrator": "神楽", "text": "この世界での経験や\n思い出は…私の中に\n残り続ける。"},
        { "location": "1282/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1284/TALK"  , "narrator": "神楽", "text": "割り切らなきゃ…。\nそれくらいの覚悟、\nとっくに――"},
        { "location": "1286/TALK"  , "narrator": "キリト", "text": "あれ？　あそこに\nいるのって…。"},
        { "location": "1287/TALK"  , "narrator": "雛", "text": "あ、本当だ。\nおーい、\n神楽ちゃーん！"},
        { "location": "1290/TALK"  , "narrator": "神楽", "text": "…え？"},
        { "location": "1296/TALK"  , "narrator": "雛", "text": "おつかれー。"},
        { "location": "1300/TALK"  , "narrator": "キリト", "text": "よぉ、卯月。\n一人でいるなんて\n珍しいな。"},
        { "location": "1303/TALK"  , "narrator": "ヒカル", "text": "こんなところで、\nどうかしたの？"},
        { "location": "1310/TALK"  , "narrator": "神楽", "text": "いえ…ちょっと\nお散歩してる\nだけです…。"},
        { "location": "1312/TALK"  , "narrator": "神楽", "text": "皆さんの方は、\n真幌さんのお手伝い\n終わったんですか？"},
        { "location": "1313/TALK"  , "narrator": "雛", "text": "どうにかねー。\n散々こき使われて、\nヘトヘトだよ…。"},
        { "location": "1314/TALK"  , "narrator": "キリト", "text": "卯月の方も、\n今日は朝から\n特訓だったんだろ？"},
        { "location": "1315/TALK"  , "narrator": "神楽", "text": "はい…。\nお昼過ぎには\n終わりましたけど。"},
        { "location": "1316/TALK"  , "narrator": "キリト", "text": "東雲教官が\n見てないからって、\n遊んでないだろうな？"},
        { "location": "1319/TALK"  , "narrator": "雛", "text": "神楽ちゃんが\nそんな不真面目なこと\nするはずないじゃん。"},
        { "location": "1321/TALK"  , "narrator": "ヒカル", "text": "そうそう。\nキリトとは違うよ。"},
        { "location": "1324/TALK"  , "narrator": "キリト", "text": "なるほど、確かに…。\nって、言ったな！？"},
        { "location": "1325/TALK"  , "narrator": "ヒカル", "text": "あはは、冗談だよ。\nごめんごめん。"},
        { "location": "1327/TALK"  , "narrator": "キリト", "text": "ったく…。"},
        { "location": "1328/TALK"  , "narrator": "雛", "text": "あはは。"},
        { "location": "1329/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1334/TALK"  , "narrator": "雛", "text": "…神楽ちゃん？\nなんか、表情が\n暗いんだけど…。"},
        { "location": "1336/TALK"  , "narrator": "ヒカル", "text": "本当だ…。\n暑さで具合でも\n悪くなっちゃった？"},
        { "location": "1337/TALK"  , "narrator": "神楽", "text": "い、いえ…。\nちょっと、考え事を\nしてたので…。"},
        { "location": "1338/TALK"  , "narrator": "神楽", "text": "あの、私はもう少し\n散歩してきますから。"},
        { "location": "1339/TALK"  , "narrator": "神楽", "text": "皆さんは先に帰って、\nゆっくり休んでて\nください。"},
        { "location": "1341/TALK"  , "narrator": "キリト", "text": "一人で大丈夫か？\n邪魔じゃなければ、\n俺たちも付き合うぞ？"},
        { "location": "1342/TALK"  , "narrator": "神楽", "text": "そんな、平気ですよ。\n具合が悪いわけじゃ\nないですし…。"},
        { "location": "1343/TALK"  , "narrator": "ヒカル", "text": "でも、ちょっと\n心配だし…。\n放っておけないよ。"},
        { "location": "1344/TALK"  , "narrator": "神楽", "text": "本当、大丈夫です。\nそれに、皆さんも\n疲れてるでしょう？"},
        { "location": "1345/TALK"  , "narrator": "キリト", "text": "そりゃまあ、\nそうだけどさ…。"},
        { "location": "1346/TALK"  , "narrator": "雛", "text": "…もしかしてさ、\nトライナリーの\nみんなとのこと？"},
        { "location": "1348/TALK"  , "narrator": "神楽", "text": "えっ！？"},
        { "location": "1349/TALK"  , "narrator": "キリト", "text": "やっぱなぁ…。\nなんかあったって\nことか。"},
        { "location": "1350/TALK"  , "narrator": "神楽", "text": "…ごめんなさい。\nちょっと、\nその話は…。"},
        { "location": "1351/TALK"  , "narrator": "雛", "text": "うん、いいよ。\nムリに聞くつもりは\nないしね。"},
        { "location": "1352/TALK"  , "narrator": "雛", "text": "でも…あたし達は\n友達なんだから。"},
        { "location": "1353/TALK"  , "narrator": "雛", "text": "心配するくらいは\nしてもいいよね？"},
        { "location": "1354/TALK"  , "narrator": "神楽", "text": "…ひなこさん。"},
        { "location": "1355/TALK"  , "narrator": "雛", "text": "えへへ…。"},
        { "location": "1357/TALK"  , "narrator": "ヒカル", "text": "…ひなこさん。\nやっぱり、僕たちは\n先に帰ろう。"},
        { "location": "1358/TALK"  , "narrator": "ヒカル", "text": "考え事なら、\n一人の方が\nまとまると思うし。"},
        { "location": "1361/TALK"  , "narrator": "雛", "text": "そうだねー。\n正直、もう座って\nゆっくりしたいし。"},
        { "location": "1363/TALK"  , "narrator": "雛", "text": "神楽ちゃん、\nやっぱりあたし達、\n先戻ってるよー。"},
        { "location": "1365/TALK"  , "narrator": "神楽", "text": "…わかりました。"},
        { "location": "1366/TALK"  , "narrator": "キリト", "text": "卯月も、夕飯までには\n戻ってこいよ？"},
        { "location": "1374/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1376/TALK"  , "narrator": "神楽", "text": "優しい人達…。"},
        { "location": "1377/TALK"  , "narrator": "神楽", "text": "トライナリーの\n仲間でもなければ。"},
        { "location": "1378/TALK"  , "narrator": "神楽", "text": "私が、メノウなのも\n知らないのに、\n仲良くしてくれて…。"},
        { "location": "1379/TALK"  , "narrator": "神楽", "text": "…でも。"},
        { "location": "1381/TALK"  , "narrator": "神楽", "text": "この世界を壊したら、\nひなこさん達とも、\nもう…。"},
        { "location": "1400/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1401/TALK"  , "narrator": "神楽", "text": "ダメ…やっぱり、\n私にはムリ…。"},
        { "location": "1402/TALK"  , "narrator": "神楽", "text": "ひなこさん達は、\n私の大切なお友達。"},
        { "location": "1403/TALK"  , "narrator": "神楽", "text": "つばめさんや、\nトライナリーの仲間も\nみんな…。"},
        { "location": "1404/TALK"  , "narrator": "神楽", "text": "私には、とっても\n大切な人達だから。"},
        { "location": "1405/TALK"  , "narrator": "神楽", "text": "全部嘘だなんて、\n思えるわけ\nないじゃない！！"},
        { "location": "1406/TALK"  , "narrator": "神楽", "text": "…考えよう。\nこんな方法じゃない、\nもっといい方法を…。"},
        { "location": "1407/TALK"  , "narrator": "千羽鶴", "text": "やっぱりね。"},
        { "location": "1414/TALK"  , "narrator": "千羽鶴", "text": "予想はしてたけど、\nやっぱり割り切れて\nいなかったようね。"},
        { "location": "1416/TALK"  , "narrator": "神楽", "text": "っ！？\nど、どうして\nここに！？"},
        { "location": "1418/TALK"  , "narrator": "千羽鶴", "text": "貴方には、\n私のアドバイスが\n必要になる時が来る。"},
        { "location": "1419/TALK"  , "narrator": "千羽鶴", "text": "そう思って、\nずっと監視していたの\nだけれど…。"},
        { "location": "1420/TALK"  , "narrator": "千羽鶴", "text": "予想通り、\n必要になってる\nみたいね。"},
        { "location": "1421/TALK"  , "narrator": "神楽", "text": "…なにを言って――"},
        { "location": "1422/TALK"  , "narrator": "千羽鶴", "text": "貴方は、役割を持った\n演者でしかない。"},
        { "location": "1423/TALK"  , "narrator": "神楽", "text": "…え？"},
        { "location": "1424/TALK"  , "narrator": "千羽鶴", "text": "貴方がメノウとして、\nステージの上で\nそうするように。"},
        { "location": "1425/TALK"  , "narrator": "千羽鶴", "text": "自分の本心ではなく、\n演者として、\n台本通りに振る舞う。"},
        { "location": "1427/TALK"  , "narrator": "千羽鶴", "text": "貴方はそう思って\nいればいいの。"},
        { "location": "1428/TALK"  , "narrator": "神楽", "text": "…簡単に\n言わないでよ。"},
        { "location": "1429/TALK"  , "narrator": "神楽", "text": "この世界は、確かに\nウソの世界かも\nしれないけど…。"},
        { "location": "1430/TALK"  , "narrator": "神楽", "text": "それでも、\n私の記憶には\n残り続けるのよ！？"},
        { "location": "1431/TALK"  , "narrator": "千羽鶴", "text": "それは舞台だって\n同じこと。"},
        { "location": "1433/TALK"  , "narrator": "千羽鶴", "text": "じゃあ、\nこう考えてみて。"},
        { "location": "1434/TALK"  , "narrator": "千羽鶴", "text": "貴方は、逢瀬つばめを\n壊そうとしている\nけれど…。"},
        { "location": "1435/TALK"  , "narrator": "千羽鶴", "text": "同時に、それが\n心残りでもある。"},
        { "location": "1436/TALK"  , "narrator": "千羽鶴", "text": "でも、舞台でも\n人を殺すシーンは、\nいくらでもあって。"},
        { "location": "1437/TALK"  , "narrator": "千羽鶴", "text": "それは本当に\n殺しているわけじゃ\nないから。"},
        { "location": "1438/TALK"  , "narrator": "千羽鶴", "text": "舞台が終われば、\nいい思い出になる。"},
        { "location": "1439/TALK"  , "narrator": "千羽鶴", "text": "それと同じだと\n思えばいい。"},
        { "location": "1441/TALK"  , "narrator": "神楽", "text": "なっ！？"},
        { "location": "1442/TALK"  , "narrator": "神楽", "text": "つばめさんを\n壊したことも。"},
        { "location": "1443/TALK"  , "narrator": "神楽", "text": "いい思い出になる\nだなんて、本気で\n言ってるの！？"},
        { "location": "1444/TALK"  , "narrator": "千羽鶴", "text": "フェノメノンが\n収束し、\n現実に戻れば。"},
        { "location": "1445/TALK"  , "narrator": "千羽鶴", "text": "誰も死んでないし、\n心に傷も\n負っていない。"},
        { "location": "1446/TALK"  , "narrator": "千羽鶴", "text": "なぜならここは、\nウソの世界…、\n舞台の上と同じ。"},
        { "location": "1447/TALK"  , "narrator": "千羽鶴", "text": "同時に、この世界の\n人間達からは\n記憶も消えるから。"},
        { "location": "1448/TALK"  , "narrator": "千羽鶴", "text": "みんなが、\n劇を懐かしむ\nこともない。"},
        { "location": "1450/TALK"  , "narrator": "千羽鶴", "text": "貴方がなにをしようと\nそれを覚えている者は\n誰もいない。"},
        { "location": "1452/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1453/TALK"  , "narrator": "千羽鶴", "text": "それに、やらない\n理由なんてないはず。"},
        { "location": "1454/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめの\n破壊によって。"},
        { "location": "1455/TALK"  , "narrator": "千羽鶴", "text": "貴方は、全てから\n解放されるのだから。"},
        { "location": "1457/TALK"  , "narrator": "神楽", "text": "でも…。"},
        { "location": "1458/TALK"  , "narrator": "千羽鶴", "text": "母親が今のままでも\nいいの？"},
        { "location": "1460/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1461/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめを\n破壊せず、解決する\n方法が見つかるまで。"},
        { "location": "1462/TALK"  , "narrator": "千羽鶴", "text": "あんな状態のまま、\n母親を放っておくの？"},
        { "location": "1463/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめを壊せば\n助けられるけれど。"},
        { "location": "1464/TALK"  , "narrator": "千羽鶴", "text": "それ以外の方法を\n見つけるまで、\n我慢しててほしい。"},
        { "location": "1465/TALK"  , "narrator": "千羽鶴", "text": "…壊れた母親より、\n嘘の世界の友情が、\n私には大切だから。"},
        { "location": "1466/TALK"  , "narrator": "千羽鶴", "text": "つまりは、\nそういうことね？"},
        { "location": "1468/TALK"  , "narrator": "神楽", "text": "…なによ、それ？\nケンカ売ってるの？"},
        { "location": "1469/TALK"  , "narrator": "千羽鶴", "text": "なら、母親には\nなんて言うつもり？"},
        { "location": "1470/TALK"  , "narrator": "千羽鶴", "text": "貴方を助けたいけど、\n元凶である存在を\n破壊してまで。"},
        { "location": "1471/TALK"  , "narrator": "千羽鶴", "text": "貴方を助けたいとは\n思わない。"},
        { "location": "1472/TALK"  , "narrator": "千羽鶴", "text": "だから、他の方法を\n見つけるまで待ってて\nほしい？"},
        { "location": "1473/TALK"  , "narrator": "神楽", "text": "やめて！！"},
        { "location": "1474/TALK"  , "narrator": "千羽鶴", "text": "これからもこの世界で\n学校へ通い、友達と\n楽しい毎日を過ごし。"},
        { "location": "1475/TALK"  , "narrator": "千羽鶴", "text": "帰ってからは\n母親に暴力を\n振るわれる。"},
        { "location": "1476/TALK"  , "narrator": "千羽鶴", "text": "そんな日々が\n貴方の望む幸せだと\nいうのなら。"},
        { "location": "1477/TALK"  , "narrator": "千羽鶴", "text": "これ以上、\n私から言うことは\nなにもない。"},
        { "location": "1478/SEL"   , "narrator": "", "text": "音羽を壊したのはつばめじゃない"},
        { "location": "1479/SEL"   , "narrator": "", "text": "（※何も言わない）"},
        { "location": "1480/ACT"   , "narrator": "", "text": "音羽を壊したのはつばめじゃない"},
        { "location": "1487/ACT"   , "narrator": "", "text": "（※何も言わない）"},
        { "location": "1495/TALK"  , "narrator": "神楽", "text": "うっ…うぅ…。"},
        { "location": "1496/TALK"  , "narrator": "千羽鶴", "text": "これは、貴方の望みと\n合致するところが\nあったから。"},
        { "location": "1497/TALK"  , "narrator": "千羽鶴", "text": "今まで\n言わなかったけど。"},
        { "location": "1498/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめを\n破壊するための準備が\n整ったからには。"},
        { "location": "1499/TALK"  , "narrator": "千羽鶴", "text": "それを貴方に実行して\nほしいという希望が、\nこちらにはある。"},
        { "location": "1500/TALK"  , "narrator": "千羽鶴", "text": "でも、実行する気が\nないというなら。"},
        { "location": "1501/TALK"  , "narrator": "千羽鶴", "text": "最悪、私の方で\n介入をするかも\nしれない。"},
        { "location": "1502/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1503/TALK"  , "narrator": "千羽鶴", "text": "可能な限り、\n合宿中に速やかに\n破壊してほしい。"},
        { "location": "1504/TALK"  , "narrator": "千羽鶴", "text": "…健闘を祈ってる。\nそれじゃ。"},
        { "location": "1508/TALK"  , "narrator": "神楽", "text": "…わかってない。"},
        { "location": "1509/TALK"  , "narrator": "神楽", "text": "舞台の上と同じ…。\n私は、ただの演者\nでしかない…。"},
        { "location": "1510/TALK"  , "narrator": "神楽", "text": "そう思えないから、\n辛いのに…。"},
        { "location": "1518/TALK"  , "narrator": "神楽", "text": "っ！？\nもう、こんな時に――"},
        { "location": "1521/TALK"  , "narrator": "神楽", "text": "…え？"},
        { "location": "1526/TALK"  , "narrator": "プレイヤー", "text": "音羽を壊したのはつばめじゃない"},
        { "location": "1528/TALK"  , "narrator": "神楽", "text": "どういうこと？"},
        { "location": "1529/TALK"  , "narrator": "神楽", "text": "音羽を壊したのは"},
        { "location": "1530/TALK"  , "narrator": "神楽", "text": "つばめさんでしょう？"},
        { "location": "1532/SEL"   , "narrator": "", "text": "あれは千羽鶴がやったこと"},
        { "location": "1533/ACT"   , "narrator": "", "text": "あれは千羽鶴がやったこと"},
        { "location": "1536/TALK"  , "narrator": "神楽", "text": "待ってください"},
        { "location": "1537/TALK"  , "narrator": "神楽", "text": "意味がわからないんですけど"},
        { "location": "1538/TALK"  , "narrator": "神楽", "text": "音羽を壊したのは"},
        { "location": "1539/TALK"  , "narrator": "神楽", "text": "確かにつばめさんのはず"},
        { "location": "1540/TALK"  , "narrator": "神楽", "text": "みんなも見てましたよ？"},
        { "location": "1542/SEL"   , "narrator": "", "text": "千羽鶴の正体はつばめのセルフクランだ"},
        { "location": "1543/ACT"   , "narrator": "", "text": "千羽鶴の正体はつばめのセルフクランだ"},
        { "location": "1546/TALK"  , "narrator": "神楽", "text": "証拠は？"},
        { "location": "1547/TALK"  , "narrator": "神楽", "text": "そんな話"},
        { "location": "1548/TALK"  , "narrator": "神楽", "text": "信じられない"},
        { "location": "1550/SEL"   , "narrator": "", "text": "神楽に害悪なことは言わない"},
        { "location": "1551/ACT"   , "narrator": "", "text": "神楽に害悪なことは言わない"},
        { "location": "1553/TALK"  , "narrator": "神楽", "text": "それは信じますよ"},
        { "location": "1554/TALK"  , "narrator": "神楽", "text": "だけど、、、"},
        { "location": "1556/SEL"   , "narrator": "", "text": "信じるかどうかは任せる"},
        { "location": "1557/ACT"   , "narrator": "", "text": "信じるかどうかは任せる"},
        { "location": "1560/TALK"  , "narrator": "神楽", "text": "それなら"},
        { "location": "1561/TALK"  , "narrator": "神楽", "text": "私が確かめます"},
        { "location": "1572/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1573/TALK"  , "narrator": "千羽鶴", "text": "…どうかした？"},
        { "location": "1574/TALK"  , "narrator": "神楽", "text": "…一つ、聞きたい\nことがあります。"},
        { "location": "1575/TALK"  , "narrator": "千羽鶴", "text": "どうぞ。"},
        { "location": "1576/TALK"  , "narrator": "神楽", "text": "…あなたは、\nつばめさんの\nセルフクランで――"},
        { "location": "1577/TALK"  , "narrator": "神楽", "text": "音羽を壊したのも\nあなたというのは、\n事実ですか？"},
        { "location": "1578/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "1579/TALK"  , "narrator": "神楽", "text": "…答えて！"},
        { "location": "1580/TALK"  , "narrator": "千羽鶴", "text": "…わかった。"},
        { "location": "1581/TALK"  , "narrator": "千羽鶴", "text": "私は――"},
        { "location": "1593/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【Mv EXE_GARBiELa】"},
        { "location": "1605/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【Mv EXE_GARBiELa】"},
        { "location": "1626/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【16 しあわせのパンツ】"},
        { "location": "1638/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【16 しあわせのパンツ】"}
    ]
}
