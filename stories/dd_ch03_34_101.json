    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "大罪を持つ神の姿"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "嘘、で、しょう…？"},
        { "location": "34/TALK"   , "narrator": "透明ガブリエラ", "text": "神楽があんなものに\n変身してしまう\nなんて……！"},
        { "location": "35/TALK"   , "narrator": "透明ガブリエラ", "text": "あの姿は…\nバフォメット！"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "なんで…\nどういうことなの…！？"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "…っ…！"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "頭痛がする……。"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "収まって…！\n集中できない…！"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "誰？"},
        { "location": "51/TALK"   , "narrator": "透明みやび", "text": "うちぞね。"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "みやび！"},
        { "location": "53/TALK"   , "narrator": "透明みやび", "text": "ガブちゃんが\n元気そうで\nよかったちや。"},
        { "location": "54/TALK"   , "narrator": "透明みやび", "text": "ちっくと不便やけんど\n今後の話は\nこれになるき。"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "…わかったわ。"},
        { "location": "56/TALK"   , "narrator": "透明みやび", "text": "それよりもっと\n大変なことが\n起きちゅう。"},
        { "location": "57/TALK"   , "narrator": "透明みやび", "text": "うちら全員\n卯月のフェノメノンに\n取り込まれちゅう。"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "どういうこと！？"},
        { "location": "60/TALK"   , "narrator": "透明みやび", "text": "そのまんまの意味ぞね。"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "…本当なの…？"},
        { "location": "62/TALK"   , "narrator": "透明みやび", "text": "少なくともアーヤは\n納得してくれたちや。"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "…だったら信じるしか\nないみたいね。"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "ということは\nバフォメットなのは\n操られてるの？"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "海岸でつばめを\n襲った時みたいに。"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "ううん、違う！"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "スコープで見た時\n神楽の首には\nプロテクターがなかった。"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "ということは…\nええと…。"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "…痛っ…！"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "今考えがまとまりそう\nだったのに…！"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "ええと……。\n神楽は外から操作\nされていない。"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "…あの子、\n発症した……？"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "まさか…！"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "…本当にそうだったら\n収束させるしかないわ。"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "でもまだ決まったわけ\nじゃない…！"},
        { "location": "80/TALK"   , "narrator": "透明みやび", "text": "つばめちゃん！？"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "！！　どうしたの？！"},
        { "location": "89/TALK"   , "narrator": "透明ガブリエラ", "text": "つばめ！？"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと…！"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "…え…！？"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "あたしなんで\n$marzanna$が\n見つけられないの！？"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "えっ、と……。"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "これ、ＷＡＶＥの\nフレンド一覧よね。\n$marzanna$は？"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "なんで…！？"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "意味がわからない！"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "こんな時にこそ\nいて欲しいのに…！"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "ううん、いつだって\n$marzanna$はいて\nくれなきゃダメ！"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "だってそうでしょう？\nいて当たり前でしょう？"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "だって$marzanna$\nなんだから！"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "それなのになんで\nいてくれないの！？"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "おかしいわよこんなの！"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "いいからすぐに\n出て来てよ！\n$marzanna$！"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "私がここにいるんだから！\nいないなんて\nありえない……！"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "ねえ……。\n神楽もつばめも\n大変なの…！"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "これで$marzanna$も\nいなくなるの…！？"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "なんで…！？"},
        { "location": "150/SEL"   , "narrator": "", "text": "大変大変！！"},
        { "location": "151/TALK"  , "narrator": "マルザンナ　", "text": "$handle$\n大変大変！！"},
        { "location": "152/ACT"   , "narrator": "", "text": "大変大変！！"},
        { "location": "154/SEL"   , "narrator": "", "text": "あっ、先にどうぞ…ってまた瓦礫！？"},
        { "location": "155/TALK"  , "narrator": "マルザンナ　", "text": "リヴォルカがっ！！\nリヴォルカがっ！！"},
        { "location": "156/ACT"   , "narrator": "", "text": "あっ、先にどうぞ…ってまた瓦礫！？"},
        { "location": "158/TALK"  , "narrator": "マルザンナ　", "text": "リヴォルカが\nあたしの心を\n壊しまくってるのよ！！"},
        { "location": "159/SEL"   , "narrator": "", "text": "えらいこっちゃ！"},
        { "location": "160/SEL"   , "narrator": "", "text": "決闘で何かあったの！？"},
        { "location": "161/ACT"   , "narrator": "", "text": "えらいこっちゃ！"},
        { "location": "162/TALK"  , "narrator": "マルザンナ　", "text": "突然暴れ出したんだけど、\n何が原因なのかしら！！"},
        { "location": "163/ACT"   , "narrator": "", "text": "決闘で何かあったの！？"},
        { "location": "164/TALK"  , "narrator": "マルザンナ　", "text": "決闘なんて\nまだやってないわよ。"},
        { "location": "165/TALK"  , "narrator": "マルザンナ　", "text": "その前に突然\n暴れ出して……\n何が原因なのかしら！！"},
        { "location": "167/SEL"   , "narrator": "", "text": "もしかしたら……"},
        { "location": "168/ACT"   , "narrator": "", "text": "もしかしたら……"},
        { "location": "170/TALK"  , "narrator": "マルザンナ　", "text": "何か心当たりがあるの！？"},
        { "location": "171/TALK"  , "narrator": "マルザンナ　", "text": "ていうか、そういえば\n$handle$も何か\n大変な事があったんじゃ…"},
        { "location": "172/TALK"  , "narrator": "マルザンナ　", "text": "ごめんなさい、\nあたし自分のこと\nばっかりで……"},
        { "location": "173/SEL"   , "narrator": "", "text": "WAVEのアカウントを千羽鶴に消された"},
        { "location": "174/ACT"   , "narrator": "", "text": "WAVEのアカウントを千羽鶴に消された"},
        { "location": "176/TALK"  , "narrator": "マルザンナ　", "text": "え――"},
        { "location": "177/TALK"  , "narrator": "マルザンナ　", "text": "ええええっ！？\nそれじゃ、あたしは……"},
        { "location": "178/SEL"   , "narrator": "", "text": "もう二度と話せないんじゃないかって焦ってる"},
        { "location": "179/ACT"   , "narrator": "", "text": "もう二度と話せないんじゃないかって焦ってる"},
        { "location": "181/TALK"  , "narrator": "マルザンナ　", "text": "……。"},
        { "location": "182/TALK"  , "narrator": "マルザンナ　", "text": "関係あるかも\nしれないわね……。"},
        { "location": "183/TALK"  , "narrator": "マルザンナ　", "text": "とにかく、\n一緒にリヴォルカの所へ\n来て頂戴！"},
        { "location": "203/TALK"  , "narrator": "リヴォルカ", "text": "…はぁっ……はぁっ……"},
        { "location": "208/TALK"  , "narrator": "リヴォルカ", "text": "うわあああああああっ！！"},
        { "location": "214/TALK"  , "narrator": "マルザンナ　", "text": "リヴォルカ！！\n落ち着いて！！"},
        { "location": "215/TALK"  , "narrator": "リヴォルカ", "text": "退けえええええっ！！"},
        { "location": "216/SEL"   , "narrator": "", "text": "リヴォルカ！\nどうしたの！？\nしっかりしろ！"},
        { "location": "217/ACT"   , "narrator": "", "text": "リヴォルカ！\nどうしたの！？\nしっかりしろ！"},
        { "location": "220/TALK"  , "narrator": "リヴォルカ", "text": "…！？"},
        { "location": "221/TALK"  , "narrator": "リヴォルカ", "text": "$handle$……\nこのクソブタあああっ！！"},
        { "location": "222/SEL"   , "narrator": "", "text": "え……$me$！？"},
        { "location": "223/ACT"   , "narrator": "", "text": "え……$me$！？"},
        { "location": "225/TALK"  , "narrator": "リヴォルカ", "text": "よくも！\nよくもよくもよくも\nよくも裏切ったな！？"},
        { "location": "226/TALK"  , "narrator": "リヴォルカ", "text": "ブヒブヒ言って\n媚びへつらってたのも全部\n本心じゃなかったなんて！"},
        { "location": "227/TALK"  , "narrator": "マルザンナ　", "text": "リヴォルカ！\nそんな事ないのよ！"},
        { "location": "228/SEL"   , "narrator": "", "text": "ブヒってたのは本当だし今もブヒるよ！！"},
        { "location": "229/SEL"   , "narrator": "", "text": "ブヒはともかくガブリエラは大事だよ！"},
        { "location": "230/ACT"   , "narrator": "", "text": "ブヒってたのは本当だし今もブヒるよ！！"},
        { "location": "231/ACT"   , "narrator": "", "text": "ブヒはともかくガブリエラは大事だよ！"},
        { "location": "233/TALK"  , "narrator": "リヴォルカ", "text": "じゃあどうして\nあたしの前から\nいなくなった！？"},
        { "location": "234/TALK"  , "narrator": "リヴォルカ", "text": "どうして唐突に\nWAVEアカウント\n消したのよ！！"},
        { "location": "235/SEL"   , "narrator": "", "text": "それは$me$じゃないよ！\n千羽鶴だよ！"},
        { "location": "236/ACT"   , "narrator": "", "text": "それは$me$じゃないよ！\n千羽鶴だよ！"},
        { "location": "238/TALK"  , "narrator": "リヴォルカ", "text": "うるさいっ！\nだれも信じない！\n何も信じないんだから！"},
        { "location": "239/TALK"  , "narrator": "マルザンナ　", "text": "落ち着いて！！"},
        { "location": "240/TALK"  , "narrator": "リヴォルカ", "text": "あたしには\nあたし以外\n誰も要らない！！"},
        { "location": "241/TALK"  , "narrator": "リヴォルカ", "text": "世の中の無能共が\n蠢いてるのを見てると\n吐き気がする！！"},
        { "location": "242/TALK"  , "narrator": "リヴォルカ", "text": "消えろ！！"},
        { "location": "243/SEL"   , "narrator": "", "text": "$me$はガブリエラを護るって決めたんだよ"},
        { "location": "244/SEL"   , "narrator": "", "text": "$me$はガブリエラの味方だよ！！"},
        { "location": "245/ACT"   , "narrator": "", "text": "$me$はガブリエラを護るって決めたんだよ"},
        { "location": "246/ACT"   , "narrator": "", "text": "$me$はガブリエラの味方だよ！！"},
        { "location": "248/TALK"  , "narrator": "リヴォルカ", "text": "うるさい！\n死ね！！"},
        { "location": "250/TALK"  , "narrator": "マルザンナ　", "text": "危ないっ！！"},
        { "location": "261/TALK"  , "narrator": "リヴォルカ", "text": "え！？！？"},
        { "location": "274/TALK"  , "narrator": "リヴォルカ", "text": "……う…　そ…"},
        { "location": "275/SEL"   , "narrator": "", "text": "マルザンナ！！"},
        { "location": "276/ACT"   , "narrator": "", "text": "マルザンナ！！"},
        { "location": "278/TALK"  , "narrator": "マルザンナ　", "text": "…っ…　…はぁ…\n……はぁ…　…"},
        { "location": "279/TALK"  , "narrator": "リヴォルカ", "text": "そ……んな…　…"},
        { "location": "280/TALK"  , "narrator": "リヴォルカ", "text": "うああああああああああ\nあああああああああああ\nああああっっっっ！！！"},
        { "location": "286/TALK"  , "narrator": "マルザンナ　", "text": "……はぁ…\n…　…はぁっ……"},
        { "location": "287/SEL"   , "narrator": "", "text": "しっかりしろ！！"},
        { "location": "288/ACT"   , "narrator": "", "text": "しっかりしろ！！"},
        { "location": "290/TALK"  , "narrator": "マルザンナ　", "text": "大丈夫よ……\n死ぬことは無いから…っ"},
        { "location": "301/SEL"   , "narrator": "", "text": "本当に大丈夫…？"},
        { "location": "302/ACT"   , "narrator": "", "text": "本当に大丈夫…？"},
        { "location": "304/TALK"  , "narrator": "マルザンナ　", "text": "ええ、…大丈夫……"},
        { "location": "305/TALK"  , "narrator": "マルザンナ　", "text": "人格は、撃たれたりしても\n消えたりはしない…"},
        { "location": "306/TALK"  , "narrator": "マルザンナ　", "text": "お願いがあるの、\n$handle$…"},
        { "location": "307/SEL"   , "narrator": "", "text": "なに！？"},
        { "location": "308/ACT"   , "narrator": "", "text": "なに！？"},
        { "location": "310/TALK"  , "narrator": "マルザンナ　", "text": "リヴォルカの心を\n落ち着かせてあげて……"},
        { "location": "311/TALK"  , "narrator": "マルザンナ　", "text": "彼女が暴れ続けると\nセルフクランにも\n影響が出るの…"},
        { "location": "312/TALK"  , "narrator": "マルザンナ　", "text": "そうすれば、\n間違いなくあたしは\n発症してしまうわ。"},
        { "location": "313/SEL"   , "narrator": "", "text": "でも、どうやって落ち着かせれば…！？"},
        { "location": "314/ACT"   , "narrator": "", "text": "でも、どうやって落ち着かせれば…！？"},
        { "location": "316/TALK"  , "narrator": "マルザンナ　", "text": "わからない……\nでもきっと、\n貴方なら出来るわ……"},
        { "location": "317/TALK"  , "narrator": "マルザンナ　", "text": "だって、あの子が\n暴走したのは、WAVEの\nアカウントが消えたから。"},
        { "location": "318/TALK"  , "narrator": "マルザンナ　", "text": "だから、安心させて\nあげられるのもまた、\n貴方しかいないの…っ…"},
        { "location": "319/SEL"   , "narrator": "", "text": "わかった、やってみる"},
        { "location": "320/SEL"   , "narrator": "", "text": "自信は無いけどやるだけやるよ"},
        { "location": "321/ACT"   , "narrator": "", "text": "わかった、やってみる"},
        { "location": "322/TALK"  , "narrator": "マルザンナ　", "text": "ありがと……"},
        { "location": "323/ACT"   , "narrator": "", "text": "自信は無いけどやるだけやるよ"},
        { "location": "324/TALK"  , "narrator": "マルザンナ　", "text": "大丈夫……\nそれで…いいわ……"},
        { "location": "326/TALK"  , "narrator": "マルザンナ　", "text": "リヴォルカは、\n多分あの場所にいる…っ"},
        { "location": "327/TALK"  , "narrator": "マルザンナ　", "text": "セルフクランの手前、\n生家のところ……"},
        { "location": "328/TALK"  , "narrator": "マルザンナ　", "text": "ごめんなさいね……\n勝手に、あたしのことに\n巻き込んじゃって……"},
        { "location": "329/SEL"   , "narrator": "", "text": "ガブリエラを愛してるから"},
        { "location": "330/SEL"   , "narrator": "", "text": "マルザンナを愛してるから"},
        { "location": "331/SEL"   , "narrator": "", "text": "乗りかかった船だし"},
        { "location": "332/ACT"   , "narrator": "", "text": "ガブリエラを愛してるから"},
        { "location": "334/TALK"  , "narrator": "マルザンナ　", "text": "……嬉しい。"},
        { "location": "335/TALK"  , "narrator": "マルザンナ　", "text": "だったら尚更、\n彼女のことをお願い…っ"},
        { "location": "336/ACT"   , "narrator": "", "text": "マルザンナを愛してるから"},
        { "location": "338/TALK"  , "narrator": "マルザンナ　", "text": "……ありがとう。\nあたしも$handle$が\n好きよ？"},
        { "location": "339/ACT"   , "narrator": "", "text": "乗りかかった船だし"},
        { "location": "341/TALK"  , "narrator": "マルザンナ　", "text": "ありがと……\n迷惑かけるわね。"},
        { "location": "344/TALK"  , "narrator": "マルザンナ　", "text": "それと――"},
        { "location": "345/TALK"  , "narrator": "マルザンナ　", "text": "あの子のこと……\nリヴォルカを\n責めないであげて。"},
        { "location": "346/TALK"  , "narrator": "マルザンナ　", "text": "彼女もあたしも、\nガブリエラの何処かを\n担う人格に過ぎないの。"},
        { "location": "347/TALK"  , "narrator": "マルザンナ　", "text": "トラウマを抉るような\n事態が発生すれば、\n誰かが餌食になるわ…"},
        { "location": "348/TALK"  , "narrator": "マルザンナ　", "text": "今回はたまたま彼女だった\nだけで、内容によっては\nあたしだったかもしれない"},
        { "location": "349/TALK"  , "narrator": "マルザンナ　", "text": "だから、お願い、\n彼女を支えてあげて"},
        { "location": "350/SEL"   , "narrator": "", "text": "もちろんだよ"},
        { "location": "351/SEL"   , "narrator": "", "text": "事情はわかったけど、マルザンナを撃ったことは許せない"},
        { "location": "352/ACT"   , "narrator": "", "text": "もちろんだよ"},
        { "location": "353/TALK"  , "narrator": "マルザンナ　", "text": "ありがと。"},
        { "location": "354/ACT"   , "narrator": "", "text": "事情はわかったけど、マルザンナを撃ったことは許せない"},
        { "location": "355/TALK"  , "narrator": "マルザンナ　", "text": "気持ちはよくわかるわ。"},
        { "location": "356/TALK"  , "narrator": "マルザンナ　", "text": "けど、彼女を許せないって\nことは、あたしを許せない\nってことなの。"},
        { "location": "357/TALK"  , "narrator": "マルザンナ　", "text": "彼女とあたしは、\nどちらも同じ\nガブリエラの一部。"},
        { "location": "358/TALK"  , "narrator": "マルザンナ　", "text": "理解し難いかもしれない\nけど、彼女への憎悪は\nあたしへの憎悪と同じ。"},
        { "location": "359/TALK"  , "narrator": "マルザンナ　", "text": "それだけは、\nわかって頂戴……"},
        { "location": "361/TALK"  , "narrator": "マルザンナ　", "text": "それじゃ、\n宜しく頼んだわよ……"},
        { "location": "362/TALK"  , "narrator": "マルザンナ　", "text": "あなただけが、\n頼りなの……っ…"},
        { "location": "376/TALK"  , "narrator": "リヴォルカ", "text": "…！？"},
        { "location": "377/SEL"   , "narrator": "", "text": "リヴォルカ、落ち着いて？"},
        { "location": "378/ACT"   , "narrator": "", "text": "リヴォルカ、落ち着いて？"},
        { "location": "381/TALK"  , "narrator": "リヴォルカ", "text": "来るな…っ\n…来るな豚！！"},
        { "location": "382/SEL"   , "narrator": "", "text": "大丈夫だから"},
        { "location": "383/SEL"   , "narrator": "", "text": "マルザンナを撃ったことは気にするな"},
        { "location": "384/ACT"   , "narrator": "", "text": "大丈夫だから"},
        { "location": "386/TALK"  , "narrator": "リヴォルカ", "text": "来るな！！\n来ないで！！\n来ないで！！！"},
        { "location": "387/TALK"  , "narrator": "リヴォルカ", "text": "もう誰も近づかせない！"},
        { "location": "388/TALK"  , "narrator": "リヴォルカ", "text": "自信は高慢に見せる為の\n手段に変えた！！"},
        { "location": "389/TALK"  , "narrator": "リヴォルカ", "text": "味方なんて要らない！\nもうこれ以上誰も\n傷つけたくない！！"},
        { "location": "390/ACT"   , "narrator": "", "text": "マルザンナを撃ったことは気にするな"},
        { "location": "391/TALK"  , "narrator": "リヴォルカ", "text": "言うなああああっ！！"},
        { "location": "392/TALK"  , "narrator": "リヴォルカ", "text": "撃ちたくて\n撃ったんじゃない！！"},
        { "location": "393/SEL"   , "narrator": "", "text": "わかってる！\nわかってるから！"},
        { "location": "394/ACT"   , "narrator": "", "text": "わかってる！\nわかってるから！"},
        { "location": "396/TALK"  , "narrator": "リヴォルカ", "text": "わかるもんか！！\n豚如きに何がわかる！！"},
        { "location": "397/TALK"  , "narrator": "リヴォルカ", "text": "ええ、そうよ！\nお母様を殺したのは\nあたし！！"},
        { "location": "398/TALK"  , "narrator": "リヴォルカ", "text": "高慢で自信過剰な\nあたしが殺したのよ！"},
        { "location": "399/SEL"   , "narrator": "", "text": "え？\nちょっと何か話がズレてない？"},
        { "location": "400/SEL"   , "narrator": "", "text": "自分で全ての罪を背負わないで！"},
        { "location": "401/ACT"   , "narrator": "", "text": "え？\nちょっと何か話がズレてない？"},
        { "location": "402/TALK"  , "narrator": "リヴォルカ", "text": "だからあたしは、\nもう誰も近づかせない！"},
        { "location": "403/TALK"  , "narrator": "リヴォルカ", "text": "自信は高慢に見せる為の\n手段に変えた！！"},
        { "location": "404/TALK"  , "narrator": "リヴォルカ", "text": "味方なんて要らない！\nもうこれ以上誰も\n傷つけたくない！！"},
        { "location": "405/ACT"   , "narrator": "", "text": "自分で全ての罪を背負わないで！"},
        { "location": "406/TALK"  , "narrator": "リヴォルカ", "text": "自分の犯した罪を\n他人格になすりつけるほど\nあたしは落ちぶれてない！"},
        { "location": "407/TALK"  , "narrator": "リヴォルカ", "text": "あたしは\n一人で生きるために\nあたしを支配してるのよ！"},
        { "location": "408/TALK"  , "narrator": "リヴォルカ", "text": "味方なんて要らない！\nもうこれ以上誰も\n傷つけたくない！！"},
        { "location": "411/TALK"  , "narrator": "リヴォルカ", "text": "だから\nこっちに来るな！！"},
        { "location": "412/TALK"  , "narrator": "リヴォルカ", "text": "あんたが消えた！\n消えた分際で\n顔出すな！！"},
        { "location": "413/SEL"   , "narrator": "", "text": "$me$はどこへも行かないから"},
        { "location": "414/ACT"   , "narrator": "", "text": "$me$はどこへも行かないから"},
        { "location": "417/TALK"  , "narrator": "リヴォルカ", "text": "来るなぁああっ！！"},
        { "location": "418/TALK"  , "narrator": "リヴォルカ", "text": "それ以上近づいたら\nあんたを撃って\nあたしも死ぬ！！"},
        { "location": "425/TALK"  , "narrator": "リヴォルカ", "text": "あああああああぁぁぁっ！"},
        { "location": "436/SEL"   , "narrator": "", "text": "昇華した！？"},
        { "location": "437/ACT"   , "narrator": "", "text": "昇華した！？"},
        { "location": "439/TALK"  , "narrator": "昇華リヴォルカ", "text": "あたしなんて\n生きる資格も無い\n母親殺し……"},
        { "location": "440/TALK"  , "narrator": "昇華リヴォルカ", "text": "もう誰も傷つけたくない\nだから誰も近づくな！！"},
        { "location": "441/TALK"  , "narrator": "昇華リヴォルカ", "text": "あたしは一人で\nやっていける！！"},
        { "location": "442/TALK"  , "narrator": "昇華リヴォルカ", "text": "だからもう\nあたしに関わらないで！！"},
