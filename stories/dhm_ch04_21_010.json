        "title": "Extra007 ヒメゴトチャット",
        "sub_title": "一家らんらん"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "一家らんらん"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "$handle$の言うとおり"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "家族と話を"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "してきたぞ"},
        { "location": "38/SEL"    , "narrator": "", "text": "それは何より"},
        { "location": "39/SEL"    , "narrator": "", "text": "言い方が微妙に殺伐としてない？"},
        { "location": "40/ACT"    , "narrator": "", "text": "それは何より"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "意外と"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "楽しめた"},
        { "location": "44/ACT"    , "narrator": "", "text": "言い方が微妙に殺伐としてない？"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "話をつけてきたわけではないし"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "通常運行だ"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "母と並んで"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "料理もこしらえた"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "なんとも麗しき"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "親子愛ぞね"},
        { "location": "55/SEL"    , "narrator": "", "text": "何か話したの？"},
        { "location": "56/SEL"    , "narrator": "", "text": "親孝行でみやびが作ればよかったのに"},
        { "location": "57/SEL"    , "narrator": "", "text": "恋人関係の話は出なかったの？"},
        { "location": "58/ACT"    , "narrator": "", "text": "何か話したの？"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "話したというか"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "料理の腕について"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "褒められた"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "ゆえにみやびさんは"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "ゴキゲンである"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "以上だ"},
        { "location": "65/ACT"    , "narrator": "", "text": "親孝行でみやびが作ればよかったのに"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "わかっとらんの"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "親子で作ることこそが親孝行"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "量が量だったというのもあるけんど"},
        { "location": "70/ACT"    , "narrator": "", "text": "恋人関係の話は出なかったの？"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "実は"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "見合いの話が"},
        { "location": "75/SEL"    , "narrator": "", "text": "嘘でしょ？"},
        { "location": "76/SEL"    , "narrator": "", "text": "そうなんだ…"},
        { "location": "77/SEL"    , "narrator": "", "text": "$me$はどうなるの！"},
        { "location": "78/ACT"    , "narrator": "", "text": "嘘でしょ？"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "それは"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "どうかな"},
        { "location": "81/ACT"    , "narrator": "", "text": "そうなんだ…"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "なんとも"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "そうなのだ"},
        { "location": "84/ACT"    , "narrator": "", "text": "$me$はどうなるの！"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "どうもこうもないろう"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "しかし東京で"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "いい出会いがあったなら"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "話は別だと"},
        { "location": "91/SEL"    , "narrator": "", "text": "ここにあるでしょ！"},
        { "location": "92/SEL"    , "narrator": "", "text": "これから作ろうよ？"},
        { "location": "93/SEL"    , "narrator": "", "text": "えと…ないよね？"},
        { "location": "94/ACT"    , "narrator": "", "text": "ここにあるでしょ！"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "ううむ"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "どうだろうか"},
        { "location": "97/ACT"    , "narrator": "", "text": "これから作ろうよ？"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "なるほど"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "後付けか"},
        { "location": "100/ACT"   , "narrator": "", "text": "えと…ないよね？"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "それは$handle$が"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "知らぬだけであろう"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "などと"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "$handle$がつい本気にするような嘘をつくのがみやびさん"},
        { "location": "108/SEL"   , "narrator": "", "text": "やめて"},
        { "location": "109/SEL"   , "narrator": "", "text": "ホッとした"},
        { "location": "110/SEL"   , "narrator": "", "text": "本気になんてしてないし"},
        { "location": "111/ACT"   , "narrator": "", "text": "やめて"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "それは無理だ"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "いい加減慣れろ"},
        { "location": "115/ACT"   , "narrator": "", "text": "ホッとした"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "ならばよかった"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "夏の清涼剤だ"},
        { "location": "119/ACT"   , "narrator": "", "text": "本気になんてしてないし"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "なるほど"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "次はもっと込み入った嘘をつくことにしよう"}
    ]
}
