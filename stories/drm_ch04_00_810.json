{
    "dir": "dramatics/daydra/drm_ch04_00_810.js",
    "type": "Episode",
    "info": {
        "story_id": "4085",
        "cid": "miyabi",
        "title": "らぶとーく 第86話",
        "sub_title": "祈念記念日"
    },
    "entry":
    [
        { "location": "316/TALK", "narrator": "みやび", "text": "$handle$の\n気分はどんなかね。"},
        { "location": "317/TALK", "narrator": "みやび", "text": "うちは意外と\n落ち着いちゅう。"},
        { "location": "318/TALK", "narrator": "みやび", "text": "自分でもびっくり\nするくらいに。"},
        { "location": "319/SEL" , "narrator": "", "text": "それはよかった"},
        { "location": "320/SEL" , "narrator": "", "text": "$me$は取り乱してる"},
        { "location": "321/SEL" , "narrator": "", "text": "緊張してるよ…"},
        { "location": "322/ACT" , "narrator": "", "text": "それはよかった"},
        { "location": "323/TALK", "narrator": "みやび", "text": "冷静な判断には\n冷静な思考が\n必要やきね。"},
        { "location": "324/ACT" , "narrator": "", "text": "$me$は取り乱してる"},
        { "location": "325/TALK", "narrator": "みやび", "text": "とりあえず深呼吸とか\nしてみたらえいかも\nしれんぞね。"},
        { "location": "326/TALK", "narrator": "みやび", "text": "吸ってー吐いてー\nヒッヒッフー\nヒッヒッフー。"},
        { "location": "327/SEL" , "narrator": "", "text": "ちょっと違う…"},
        { "location": "328/SEL" , "narrator": "", "text": "それ全部吐く息だよ"},
        { "location": "329/SEL" , "narrator": "", "text": "う、生まれる…！"},
        { "location": "330/ACT" , "narrator": "", "text": "ちょっと違う…"},
        { "location": "332/TALK", "narrator": "みやび", "text": "気付かれるとは\n思わなんだ。"},
        { "location": "333/ACT" , "narrator": "", "text": "それ全部吐く息だよ"},
        { "location": "334/TALK", "narrator": "みやび", "text": "えっ！？"},
        { "location": "335/TALK", "narrator": "みやび", "text": "それは知らんかった…。"},
        { "location": "336/ACT" , "narrator": "", "text": "う、生まれる…！"},
        { "location": "337/TALK", "narrator": "みやび", "text": "何を言っちゅう。"},
        { "location": "338/TALK", "narrator": "みやび", "text": "愛ならとっくに\n生まれとるきね。"},
        { "location": "340/ACT" , "narrator": "", "text": "緊張してるよ…"},
        { "location": "341/TALK", "narrator": "みやび", "text": "ほいたらうちが\n手を握っちゃろう。"},
        { "location": "342/SEL" , "narrator": "", "text": "やった！！！"},
        { "location": "343/SEL" , "narrator": "", "text": "もっと緊張するよ…"},
        { "location": "344/SEL" , "narrator": "", "text": "本当に？"},
        { "location": "345/ACT" , "narrator": "", "text": "やった！！！"},
        { "location": "346/TALK", "narrator": "みやび", "text": "…そんな喜び方を\nするほどうれしいかね。"},
        { "location": "348/TALK", "narrator": "みやび", "text": "…$handle$は\n素直やねえ。"},
        { "location": "349/ACT" , "narrator": "", "text": "もっと緊張するよ…"},
        { "location": "350/TALK", "narrator": "みやび", "text": "またまた。"},
        { "location": "351/TALK", "narrator": "みやび", "text": "そんなんでは\n伴侶として\nやっていけんろう。"},
        { "location": "352/TALK", "narrator": "みやび", "text": "ほれほれ。\nほれほれ。"},
        { "location": "353/ACT" , "narrator": "", "text": "本当に？"},
        { "location": "354/TALK", "narrator": "みやび", "text": "大事なのは\n気持ちやき。"},
        { "location": "355/TALK", "narrator": "みやび", "text": "手をつないどると\n妄想しておけば\n感触も伝わるろう。"},
        { "location": "356/TALK", "narrator": "みやび", "text": "…少しは落ち着いて\nきたかねえ？"},
        { "location": "359/TALK", "narrator": "みやび", "text": "それにしても\n心願成就ちうのは\n便利なもんやね。"},
        { "location": "360/TALK", "narrator": "みやび", "text": "心に秘めた願いやき\nわざわざ内容を\n説明せんでもえい。"},
        { "location": "361/TALK", "narrator": "みやび", "text": "それでいてちゃんと\n神様に話を\n付けてくれるらしい。"},
        { "location": "363/TALK", "narrator": "みやび", "text": "…もしかして世間には\n人に言えん願望のある\n人間ばかりおるんかね？"},
        { "location": "364/SEL" , "narrator": "", "text": "そういうこと？"},
        { "location": "365/SEL" , "narrator": "", "text": "言語化できない\n願望ってあるよ"},
        { "location": "366/SEL" , "narrator": "", "text": "人にはみな\n秘密があるのさ"},
        { "location": "367/ACT" , "narrator": "", "text": "そういうこと？"},
        { "location": "368/TALK", "narrator": "みやび", "text": "そうでなければ\nこの形態には\nならんと思うぞね。"},
        { "location": "369/ACT" , "narrator": "", "text": "言語化できない\n願望ってあるよ"},
        { "location": "370/TALK", "narrator": "みやび", "text": "それは原始的な\n欲望のような\n気がするちや。"},
        { "location": "371/ACT" , "narrator": "", "text": "人にはみな\n秘密があるのさ"},
        { "location": "372/TALK", "narrator": "みやび", "text": "大人な意見ぞね。"},
        { "location": "373/TALK", "narrator": "みやび", "text": "しかし人生とは\nそういうものかも\nしれんねえ。"},
        { "location": "375/TALK", "narrator": "みやび", "text": "それにしても。"},
        { "location": "376/TALK", "narrator": "みやび", "text": "気が付いたら\nびっくりするようなことに\nなっておったぞね。"},
        { "location": "377/TALK", "narrator": "みやび", "text": "$handle$のことは\n怪しい何かとしか認識して\nおらんかったのに。"},
        { "location": "378/TALK", "narrator": "みやび", "text": "今となっては\n離れることは\n考えられんちや。"},
        { "location": "379/SEL" , "narrator": "", "text": "みやびがデレてる…"},
        { "location": "380/SEL" , "narrator": "", "text": "$me$もだよ"},
        { "location": "381/SEL" , "narrator": "", "text": "貢いだからね！"},
        { "location": "382/ACT" , "narrator": "", "text": "みやびがデレてる…"},
        { "location": "384/TALK", "narrator": "みやび", "text": "…デレたら悪いかね？"},
        { "location": "385/ACT" , "narrator": "", "text": "$me$もだよ"},
        { "location": "386/TALK", "narrator": "みやび", "text": "…知っちゅうき。"},
        { "location": "387/ACT" , "narrator": "", "text": "貢いだからね！"},
        { "location": "388/TALK", "narrator": "みやび", "text": "即物的すぎるねえ。"},
        { "location": "389/TALK", "narrator": "みやび", "text": "そんなことうち以外に\n言い出したら\n即別れ話ぞね。"},
        { "location": "391/TALK", "narrator": "みやび", "text": "神様とやらに\n法的拘束力はない。"},
        { "location": "392/TALK", "narrator": "みやび", "text": "何かを強制する\n力などない。"},
        { "location": "393/TALK", "narrator": "みやび", "text": "それに、神頼みは\nリクエスト結果の\n判定も曖昧ぞね。"},
        { "location": "394/TALK", "narrator": "みやび", "text": "やったら式など\n無意味かというたら。"},
        { "location": "395/TALK", "narrator": "みやび", "text": "うちはそうは\n思うとらんぞね。"},
        { "location": "396/SEL" , "narrator": "", "text": "みやびの見解は？"},
        { "location": "397/SEL" , "narrator": "", "text": "照れなくていいのに"},
        { "location": "398/SEL" , "narrator": "", "text": "気持ちの問題でしょ"},
        { "location": "399/ACT" , "narrator": "", "text": "みやびの見解は？"},
        { "location": "400/TALK", "narrator": "みやび", "text": "端的に言うと\n意味はある。"},
        { "location": "401/ACT" , "narrator": "", "text": "照れなくていいのに"},
        { "location": "403/TALK", "narrator": "みやび", "text": "…今日の$handle$は\nちっくと\nはしゃぎすぎぞね。"},
        { "location": "404/ACT" , "narrator": "", "text": "気持ちの問題でしょ"},
        { "location": "405/TALK", "narrator": "みやび", "text": "一言で結論付けると\nそうやけんど。"},
        { "location": "407/TALK", "narrator": "みやび", "text": "不確定要素を\n不確定要素として\n容認しながら。"},
        { "location": "408/TALK", "narrator": "みやび", "text": "自分の意思を\n表明するために必要な\nものだと思うとる。"},
        { "location": "409/SEL" , "narrator": "", "text": "要はみやびが$me$を\n好きってことでしょ"},
        { "location": "410/SEL" , "narrator": "", "text": "好き同士って\nことでいい？"},
        { "location": "411/SEL" , "narrator": "", "text": "$me$はみやびを\n愛してる"},
        { "location": "412/ACT" , "narrator": "", "text": "要はみやびが$me$を\n好きってことでしょ"},
        { "location": "413/TALK", "narrator": "みやび", "text": "そうやね。"},
        { "location": "414/ACT" , "narrator": "", "text": "好き同士って\nことでいい？"},
        { "location": "415/TALK", "narrator": "みやび", "text": "合うとるね。"},
        { "location": "416/ACT" , "narrator": "", "text": "$me$はみやびを\n愛してる"},
        { "location": "417/TALK", "narrator": "みやび", "text": "うちも同じぞね。"},
        { "location": "421/TALK", "narrator": "みやび", "text": "…どういた？"},
        { "location": "422/SEL" , "narrator": "", "text": "ここにいるのは\n本物のみやび？"},
        { "location": "423/SEL" , "narrator": "", "text": "みやびがデレた！"},
        { "location": "424/SEL" , "narrator": "", "text": "いや、不意打ちすぎて"},
        { "location": "425/ACT" , "narrator": "", "text": "ここにいるのは\n本物のみやび？"},
        { "location": "426/TALK", "narrator": "みやび", "text": "紛うことなき本物ぞね。"},
        { "location": "427/ACT" , "narrator": "", "text": "みやびがデレた！"},
        { "location": "428/TALK", "narrator": "みやび", "text": "驚きすぎやき。"},
        { "location": "429/ACT" , "narrator": "", "text": "いや、不意打ちすぎて"},
        { "location": "430/TALK", "narrator": "みやび", "text": "受け答えとしては\n普通やき。"},
        { "location": "432/SEL" , "narrator": "", "text": "普通に答えられて\nびっくりした"},
        { "location": "433/SEL" , "narrator": "", "text": "なんかみやびじゃ\nないみたいで"},
        { "location": "434/SEL" , "narrator": "", "text": "今日は特別だからなの？"},
        { "location": "435/ACT" , "narrator": "", "text": "普通に答えられて\nびっくりした"},
        { "location": "437/TALK", "narrator": "みやび", "text": "うちもそんな気分の\n時くらいあるきね。"},
        { "location": "438/ACT" , "narrator": "", "text": "なんかみやびじゃ\nないみたいで"},
        { "location": "439/TALK", "narrator": "みやび", "text": "女子とは色々な面を\n持っている生き物ぞね。"},
        { "location": "440/ACT" , "narrator": "", "text": "今日は特別だからなの？"},
        { "location": "441/TALK", "narrator": "みやび", "text": "さあ？"},
        { "location": "443/TALK", "narrator": "みやび", "text": "ほいたら\n玉串拝礼を行うき。"},
        { "location": "444/TALK", "narrator": "みやび", "text": "静粛かつ神妙に。"},
        { "location": "448/TALK", "narrator": "みやび", "text": "…ええと…。"},
        { "location": "449/TALK", "narrator": "みやび", "text": "右手で榊の根本を\n上から持ち、左手で先を\n下から支える、と。"},
        { "location": "450/TALK", "narrator": "みやび", "text": "ほいたら玉串の先を\n時計回りに９０度回転。"},
        { "location": "451/TALK", "narrator": "みやび", "text": "左手を下げて元を\n持ったら祈念する。"},
        { "location": "452/TALK", "narrator": "みやび", "text": "…祈念か…。"},
        { "location": "453/TALK", "narrator": "みやび", "text": "うちは本当は一人で\n生きていくつもり\nだったぞね。"},
        { "location": "454/TALK", "narrator": "みやび", "text": "…いまもそう思う\nところがある。"},
        { "location": "455/TALK", "narrator": "みやび", "text": "けんど$handle$の\nことを考えると。"},
        { "location": "456/TALK", "narrator": "みやび", "text": "そんなことはもう\nできんなあと\n思うちや。"},
        { "location": "457/TALK", "narrator": "みやび", "text": "……うちは弱う\nなったんか？"},
        { "location": "458/TALK", "narrator": "みやび", "text": "いや。"},
        { "location": "459/TALK", "narrator": "みやび", "text": "$handle$を\n放っておけなく\nなっただけぞね。"},
        { "location": "461/TALK", "narrator": "みやび", "text": "……いかんいかん。\n祈念のつもりが\n雑念になったぞね。"},
        { "location": "462/TALK", "narrator": "みやび", "text": "玉串をお供えする\n方向に回して、\n案の上に載せる、と。"},
        { "location": "463/TALK", "narrator": "みやび", "text": "二拝二拍手一拝。"},
        { "location": "464/TALK", "narrator": "みやび", "text": "一礼して下がって\n完了ぞね。"},
        { "location": "467/TALK", "narrator": "みやび", "text": "$handle$は\nきちんと儀礼に則って\n祈念できたかいね？"},
        { "location": "468/SEL" , "narrator": "", "text": "超したよ！"},
        { "location": "469/SEL" , "narrator": "", "text": "ちょっと邪念が…"},
        { "location": "470/SEL" , "narrator": "", "text": "できたと思う"},
        { "location": "471/ACT" , "narrator": "", "text": "超したよ！"},
        { "location": "472/TALK", "narrator": "みやび", "text": "軽いねえ。"},
        { "location": "473/ACT" , "narrator": "", "text": "ちょっと邪念が…"},
        { "location": "474/TALK", "narrator": "みやび", "text": "神聖な本殿で\nそれはちっくと\nいかんねえ。"},
        { "location": "475/ACT" , "narrator": "", "text": "できたと思う"},
        { "location": "476/TALK", "narrator": "みやび", "text": "優等生なのか\n曖昧なのか\nわからん答えちや。"},
        { "location": "478/TALK", "narrator": "みやび", "text": "手順というものは\n意味があって成立\nしたものぞね。"},
        { "location": "479/TALK", "narrator": "みやび", "text": "それをおろそかに\nするんは感心せん。"},
        { "location": "480/TALK", "narrator": "みやび", "text": "それに無用な混乱を\n招いたり何かを\n飛ばしてしもうたり。"},
        { "location": "481/TALK", "narrator": "みやび", "text": "結果にも影響を\n与えてしまうきね。"},
        { "location": "482/SEL" , "narrator": "", "text": "うんうん、そうだね"},
        { "location": "483/SEL" , "narrator": "", "text": "ニヤニヤが止まらない"},
        { "location": "484/SEL" , "narrator": "", "text": "みやびはさすがだね"},
        { "location": "485/ACT" , "narrator": "", "text": "うんうん、そうだね"},
        { "location": "487/TALK", "narrator": "みやび", "text": "…どうにも緊張感の\nないことやね。"},
        { "location": "488/TALK", "narrator": "みやび", "text": "今日が何の日か\nもう少し自覚した\n行動をしてほしいちや。"},
        { "location": "489/ACT" , "narrator": "", "text": "ニヤニヤが止まらない"},
        { "location": "490/TALK", "narrator": "みやび", "text": "…それは今日の日が\nうれしすぎていう\nことかいね。"},
        { "location": "491/TALK", "narrator": "みやび", "text": "もう少しビシッと\nして欲しいのは\n山々やけんど。"},
        { "location": "492/TALK", "narrator": "みやび", "text": "…仕方ない部分は\nあるきねえ…。"},
        { "location": "493/ACT" , "narrator": "", "text": "みやびはさすがだね"},
        { "location": "494/TALK", "narrator": "みやび", "text": "$handle$は\nいつもそうやねえ。"},
        { "location": "495/TALK", "narrator": "みやび", "text": "人の意見だけでのうて\n自分でも考えることが\n大事ぞね。"},
        { "location": "497/TALK", "narrator": "みやび", "text": "さて。"},
        { "location": "498/TALK", "narrator": "みやび", "text": "ではここはそろそろ\nおいとまするちや。"},
        { "location": "499/SEL" , "narrator": "", "text": "もう帰るの？"},
        { "location": "500/SEL" , "narrator": "", "text": "もう少しいようよ"},
        { "location": "501/SEL" , "narrator": "", "text": "あと何かあったっけ"},
        { "location": "502/ACT" , "narrator": "", "text": "もう帰るの？"},
        { "location": "503/TALK", "narrator": "みやび", "text": "違うぞね。"},
        { "location": "504/ACT" , "narrator": "", "text": "もう少しいようよ"},
        { "location": "505/TALK", "narrator": "みやび", "text": "次がある。"},
        { "location": "506/ACT" , "narrator": "", "text": "あと何かあったっけ"},
        { "location": "507/TALK", "narrator": "みやび", "text": "もう忘れたかよ。"},
        { "location": "510/TALK", "narrator": "みやび", "text": "昨今の様式美に\n則ったら次の行動は\nひとつしかないぞね。"},
        { "location": "511/SEL" , "narrator": "", "text": "えっ何だろう"},
        { "location": "512/SEL" , "narrator": "", "text": "アレだよね！"},
        { "location": "513/SEL" , "narrator": "", "text": "教えてよ"},
        { "location": "514/ACT" , "narrator": "", "text": "えっ何だろう"},
        { "location": "515/TALK", "narrator": "みやび", "text": "なぜ驚くかね…。"},
        { "location": "516/ACT" , "narrator": "", "text": "アレだよね！"},
        { "location": "517/TALK", "narrator": "みやび", "text": "本当にわかって\n言っとるんかね。"},
        { "location": "518/ACT" , "narrator": "", "text": "教えてよ"},
        { "location": "519/TALK", "narrator": "みやび", "text": "自分で少しは\n考えようという\n気はないのか。"},
        { "location": "521/TALK", "narrator": "みやび", "text": "式の次は旅行。\n当然の流れぞね。"},
        { "location": "522/SEL" , "narrator": "", "text": "そっかー！"},
        { "location": "523/SEL" , "narrator": "", "text": "焦らしてみただけだよ"},
        { "location": "524/SEL" , "narrator": "", "text": "本当は知ってた"},
        { "location": "525/ACT" , "narrator": "", "text": "そっかー！"},
        { "location": "526/TALK", "narrator": "みやび", "text": "さすがに\nわざとらしいとは\n思わんかね？"},
        { "location": "527/ACT" , "narrator": "", "text": "焦らしてみただけだよ"},
        { "location": "529/TALK", "narrator": "みやび", "text": "$handle$のくせに\n妙なことを\n憶えちゅう。"},
        { "location": "530/TALK", "narrator": "みやび", "text": "うちにはきかんき。"},
        { "location": "531/TALK", "narrator": "みやび", "text": "…今日以外は。"},
        { "location": "532/ACT" , "narrator": "", "text": "本当は知ってた"},
        { "location": "533/TALK", "narrator": "みやび", "text": "そうやろうね。"},
        { "location": "534/TALK", "narrator": "みやび", "text": "不思議ちゃんは\nうちだけで十分ぞね。"},
        { "location": "536/TALK", "narrator": "みやび", "text": "ほいたら\n出かけるかねえ。"}
    ]
}
