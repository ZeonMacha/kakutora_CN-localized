{
    "dir": "chap12/daydra/dd_ch04_12_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "12405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "偶然の出会い＜後編＞"
    },
    "entry":
    [
        { "location": "533/SCENARIO", "narrator": "", "text": "偶然の出会い"},
        { "location": "555/TALK"    , "narrator": "みやび", "text": "…いや、やはり\nもうちくっと\n努力してみるか。"},
        { "location": "556/TALK"    , "narrator": "みやび", "text": "成り行きとはいえ、\n座れ言うたんは\nうちなんやし――"},
        { "location": "557/TALK"    , "narrator": "みやび", "text": "やれるだけ\nやっとかんとな。"},
        { "location": "564/TALK"    , "narrator": "みやび", "text": "ヘルプミー"},
        { "location": "565/TALK"    , "narrator": "みやび", "text": "アドバイス頼む"},
        { "location": "567/SEL"     , "narrator": "", "text": "繭とは何度か会ってるでしょ？"},
        { "location": "568/ACT"     , "narrator": "", "text": "繭とは何度か会ってるでしょ？"},
        { "location": "570/TALK"    , "narrator": "みやび", "text": "会ってはいるがまともに話したことはない"},
        { "location": "571/TALK"    , "narrator": "みやび", "text": "故にどんな子か知らん"},
        { "location": "572/TALK"    , "narrator": "みやび", "text": "どうしたらえいのか？"},
        { "location": "574/SEL"     , "narrator": "", "text": "何でもいいから、とにかく質問！"},
        { "location": "575/ACT"     , "narrator": "", "text": "何でもいいから、とにかく質問！"},
        { "location": "577/TALK"    , "narrator": "みやび", "text": "当たり障りないことしか言わんな"},
        { "location": "578/TALK"    , "narrator": "みやび", "text": "まあえいけんど"},
        { "location": "585/TALK"    , "narrator": "みやび", "text": "…質問ゆうても、\n何を聞けば――"},
        { "location": "588/TALK"    , "narrator": "みやび", "text": "ん？　そういえば\n光月さん達――"},
        { "location": "589/TALK"    , "narrator": "みやび", "text": "うちの劇場でバイト\nすることになったん\nやったっけ？"},
        { "location": "590/TALK"    , "narrator": "繭", "text": "はい。\n教官からの許可も\nいただけましたので。"},
        { "location": "593/TALK"    , "narrator": "みやび", "text": "そうか…。\nえーっと、\nなんやったっけ…。"},
        { "location": "596/TALK"    , "narrator": "みやび", "text": "そう、確か\nトライナリー愚連隊\nやったな。"},
        { "location": "597/TALK"    , "narrator": "繭", "text": "応援団です！！"},
        { "location": "598/TALK"    , "narrator": "繭", "text": "あ、いえ…正式には\n応援団という名称も\n違うのですが…。"},
        { "location": "599/TALK"    , "narrator": "みやび", "text": "そうなが？"},
        { "location": "600/TALK"    , "narrator": "繭", "text": "そうなのです。"},
        { "location": "602/TALK"    , "narrator": "繭", "text": "その件では以前、\nみやび先輩に――"},
        { "location": "603/TALK"    , "narrator": "繭", "text": "多大なご迷惑を\nおかけいたしました。"},
        { "location": "604/TALK"    , "narrator": "みやび", "text": "それって、うちに\nまほさんへ口添えして\nくれって――"},
        { "location": "606/TALK"    , "narrator": "みやび", "text": "頼み込んできた時の\nこと言うてる？"},
        { "location": "607/TALK"    , "narrator": "繭", "text": "はい…。"},
        { "location": "609/TALK"    , "narrator": "みやび", "text": "それやったら、\n別に迷惑なんぞ\n掛かっちょらんよ。"},
        { "location": "610/TALK"    , "narrator": "みやび", "text": "うちは何だかんだ\n理由付けて、\n断ったんやきね。"},
        { "location": "611/TALK"    , "narrator": "繭", "text": "それは承知して\nいます。"},
        { "location": "613/TALK"    , "narrator": "繭", "text": "命の危険の話から\n始まり、拘束時間が\n長いわりに――"},
        { "location": "614/TALK"    , "narrator": "繭", "text": "時給が低く、\n遣り甲斐もないから\n勧められない。"},
        { "location": "616/TALK"    , "narrator": "繭", "text": "そう言ってましたね。"},
        { "location": "617/TALK"    , "narrator": "みやび", "text": "あー…うん、確かに\n言うたけんどな、\n実はあれ――"},
        { "location": "618/TALK"    , "narrator": "繭", "text": "教官に口添えをする\nのが面倒だったための\nデタラメ、ですね？"},
        { "location": "620/TALK"    , "narrator": "みやび", "text": "…察しがえいね。\nばれんようにやった\nつもりやったけんど。"},
        { "location": "621/TALK"    , "narrator": "繭", "text": "多分、私もノリ気では\nなかったからだと\n思います。"},
        { "location": "622/TALK"    , "narrator": "みやび", "text": "そうやったが？\nけんど、結局バイト\nしちょるやろ？"},
        { "location": "624/TALK"    , "narrator": "繭", "text": "…あいつらだけに\n任せておいたら――"},
        { "location": "625/TALK"    , "narrator": "繭", "text": "皆さんにご迷惑を\nおかけすると\n思いましたので…。"},
        { "location": "627/TALK"    , "narrator": "みやび", "text": "あはは…そこまで\n心配するほどやないと\n思うけんどね。"},
        { "location": "628/TALK"    , "narrator": "みやび", "text": "…それが理由で、\n一緒にバイトしよう\n思うたが？"},
        { "location": "631/TALK"    , "narrator": "繭", "text": "いえ…実はその、\n大きな声では\n言えないのですが――"},
        { "location": "633/TALK"    , "narrator": "繭", "text": "仕事を手伝うことで、\nトライナリーに\n関する――"},
        { "location": "634/TALK"    , "narrator": "繭", "text": "極秘情報などを知る\nことができるのでは、\nと思ったんです。"},
        { "location": "635/TALK"    , "narrator": "みやび", "text": "表に出したらヤバい\n情報やけんどね。"},
        { "location": "637/TALK"    , "narrator": "繭", "text": "私個人の知的好奇心が\n満たせれば、それで\nいいのです。"},
        { "location": "638/TALK"    , "narrator": "繭", "text": "他にも、指令室に\nあるような見たことも\nない機械に――"},
        { "location": "639/TALK"    , "narrator": "繭", "text": "この手で触れることが\nできるかもしれない。"},
        { "location": "640/TALK"    , "narrator": "繭", "text": "…という、自分勝手な\n理由で協力しようと\n思ったわけです。"},
        { "location": "641/TALK"    , "narrator": "みやび", "text": "あはは、\nなるほどそうかー。"},
        { "location": "643/TALK"    , "narrator": "みやび", "text": "光月さんは正直やね。\nそういう子、うちは\n嫌いやないちや。"},
        { "location": "645/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "646/TALK"    , "narrator": "みやび", "text": "まあ、一応うちも\nトライナリーの隊員\nやきね。"},
        { "location": "647/TALK"    , "narrator": "みやび", "text": "この件については、\n深く聞かんことに\nするぞね。"},
        { "location": "649/TALK"    , "narrator": "繭", "text": "…ありがとうござい\nます。"},
        { "location": "650/TALK"    , "narrator": "みやび", "text": "えいよえいよ。\nそれより、今の話を\n聞く限り――"},
        { "location": "651/TALK"    , "narrator": "みやび", "text": "光月さんは\n機械好きなが？"},
        { "location": "652/TALK"    , "narrator": "繭", "text": "はい…主にＰＣに\n関してですが…。"},
        { "location": "653/TALK"    , "narrator": "みやび", "text": "ほう…自作派？"},
        { "location": "654/TALK"    , "narrator": "繭", "text": "もちろんです。\n隅々まで自分に\n合わせたいので。"},
        { "location": "655/TALK"    , "narrator": "繭", "text": "…みやび先輩は、\n魔改造なども\nしているようですね。"},
        { "location": "657/TALK"    , "narrator": "みやび", "text": "…何故知っちょる？"},
        { "location": "658/TALK"    , "narrator": "繭", "text": "前に、みやび先輩が\n使っている――"},
        { "location": "659/TALK"    , "narrator": "繭", "text": "ノートＰＣの画面が\n見えてしまいまして。"},
        { "location": "660/TALK"    , "narrator": "繭", "text": "外見は数年前の\nマシンだという\nのに――"},
        { "location": "661/TALK"    , "narrator": "繭", "text": "ソフトの立ち上がり\n速度が早過ぎたように\n思ったのです。"},
        { "location": "662/TALK"    , "narrator": "みやび", "text": "よぅ見ちょるなぁ…。\nそれはちくっと\nビックリや。"},
        { "location": "663/TALK"    , "narrator": "繭", "text": "覗き見してしまい、\n申し訳ありません。"},
        { "location": "664/TALK"    , "narrator": "みやび", "text": "えいよえいよ。\n人前でする作業なんぞ\n大したもんやないき。"},
        { "location": "665/TALK"    , "narrator": "みやび", "text": "しかし、そうかぁ…。\nそれだけで\n気付いたかぁ…。"},
        { "location": "666/TALK"    , "narrator": "みやび", "text": "光月さん…思うたより\n話が合うっぽいな。"},
        { "location": "667/TALK"    , "narrator": "みやび", "text": "…もうちくっと、\n色々話してみるんも、\n楽しいかもしれん。"},
        { "location": "668/TALK"    , "narrator": "みやび", "text": "…光月さんは\n魔改造せんが？"},
        { "location": "669/TALK"    , "narrator": "繭", "text": "お恥ずかしながら、\nノートの魔改造は\n未経験でして…。"},
        { "location": "670/TALK"    , "narrator": "みやび", "text": "なんや、別にそう\n難しいことやない\nちや。"},
        { "location": "671/TALK"    , "narrator": "みやび", "text": "例えば、うちの\n普段使いのマシン\nなんかはな――"},
        { "location": "672/TALK"    , "narrator": "繭", "text": "はい…なるほど…。\nですが、それだと\n中身総取り換えでは？"},
        { "location": "674/TALK"    , "narrator": "みやび", "text": "あはは、そう見せ\nかけて実は――"},
        { "location": "686/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【10 江戸川橋物語】"}
    ]
}
