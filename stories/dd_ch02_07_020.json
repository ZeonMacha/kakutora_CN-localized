{
    "dir": "chap07/daydra/dd_ch02_07_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "7255",
        "cid": "ayami",
        "title": "Extra005 プレミアムストーリー",
        "sub_title": "剣道部の指導"
    },
    "entry":
    [
        { "location": "151/SCENARIO", "narrator": "", "text": "剣道部の指導"},
        { "location": "163/TALK"    , "narrator": "アーヤ", "text": "はぁ…\nどうしようかしら？"},
        { "location": "165/TALK"    , "narrator": "ガブリエラ", "text": "浮かない顔してるわね。\n何かあったの？"},
        { "location": "167/TALK"    , "narrator": "アーヤ", "text": "…実は、\n高等部の剣道部に\nお願いされたのよ。"},
        { "location": "168/TALK"    , "narrator": "アーヤ", "text": "うちの指導を\nして欲しい、ってね。"},
        { "location": "171/TALK"    , "narrator": "ガブリエラ", "text": "…ふ～ん。"},
        { "location": "173/TALK"    , "narrator": "アーヤ", "text": "まあ、バイトとか他にも\n色々あるから、時々で\n良いとは言われたけど―"},
        { "location": "174/TALK"    , "narrator": "アーヤ", "text": "どう返事をしようか、\nちょっと迷ってるのよ。"},
        { "location": "177/TALK"    , "narrator": "ガブリエラ", "text": "…断っちゃえば？\nっていうか、悩む必要\nどこにもないと思うし。"},
        { "location": "179/TALK"    , "narrator": "ガブリエラ", "text": "抜け殻のあんたが\n部活の指導なんて、\nできるわけないじゃん。"},
        { "location": "182/TALK"    , "narrator": "アーヤ", "text": "はぁ…あんたねぇ…。"},
        { "location": "183/TALK"    , "narrator": "アーヤ", "text": "…まあ、\n辞めた身としては\n何も言い返せないけど。"},
        { "location": "184/TALK"    , "narrator": "アーヤ", "text": "でも、本当どうしよう\nかしら…。"},
        { "location": "185/SEL"     , "narrator": "", "text": "後輩の頼みは聞こう"},
        { "location": "186/SEL"     , "narrator": "", "text": "嫌なら断るべきだ"},
        { "location": "187/SEL"     , "narrator": "", "text": "アーヤはどうしたいの？"},
        { "location": "188/ACT"     , "narrator": "", "text": "後輩の頼みは聞こう"},
        { "location": "193/TALK"    , "narrator": "アーヤ", "text": "あっ…。"},
        { "location": "194/TALK"    , "narrator": "ガブリエラ", "text": "返事の催促じゃないの？"},
        { "location": "196/TALK"    , "narrator": "アーヤ", "text": "どうかしら？\nえっと…。"},
        { "location": "210/TALK"    , "narrator": "アーヤ", "text": "ずっと聞いてたの？"},
        { "location": "211/TALK"    , "narrator": "アーヤ", "text": "でも、"},
        { "location": "212/TALK"    , "narrator": "アーヤ", "text": "ちょうど悩んでたところだから助かるけど"},
        { "location": "213/TALK"    , "narrator": "アーヤ", "text": "あなたの言うとおり、やってみようと思うわ"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "面識のない私に、わざわざ頼んできたくらいだし"},
        { "location": "215/TALK"    , "narrator": "アーヤ", "text": "それだけ期待してくれてるんだろうし"},
        { "location": "227/TALK"    , "narrator": "アーヤ", "text": "催促じゃなかったけど、\n決めたわ。"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "私、\nやってみようと思う。"},
        { "location": "229/TALK"    , "narrator": "ガブリエラ", "text": "マジで？"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "まさか、これを機に\n本格的に剣道復帰する\nつもりとか？"},
        { "location": "234/TALK"    , "narrator": "アーヤ", "text": "毎日稽古に参加できる\nわけじゃないから、\n復帰は無理よ。"},
        { "location": "235/TALK"    , "narrator": "アーヤ", "text": "中途半端にやってたら、\nどんどん腕が鈍ってくと\n思うし…。"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "でも、\n指導はするんでしょ？"},
        { "location": "237/TALK"    , "narrator": "アーヤ", "text": "自分でするのと\n指導するのは、\nまったくの別物よ。"},
        { "location": "238/TALK"    , "narrator": "アーヤ", "text": "それに、\n後輩の頼みを聞ける\n先輩になりたい――"},
        { "location": "239/TALK"    , "narrator": "アーヤ", "text": "そう思っただけよ。"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "…な～んだ。"},
        { "location": "243/TALK"    , "narrator": "アーヤ", "text": "なんだとは何よ？"},
        { "location": "245/TALK"    , "narrator": "ガブリエラ", "text": "別に。"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "ただ、そんな理由で\n受けても、大したことは\nできなさそうだな――"},
        { "location": "249/TALK"    , "narrator": "ガブリエラ", "text": "って、思っただけよ。\nま、適当に頑張れば？"},
        { "location": "251/TALK"    , "narrator": "アーヤ", "text": "何よ、ちょっとくらい\n応援してくれても\nいいのに。"},
        { "location": "252/ACT"     , "narrator": "", "text": "嫌なら断るべきだ"},
        { "location": "255/TALK"    , "narrator": "アーヤ", "text": "あっ…。"},
        { "location": "256/TALK"    , "narrator": "ガブリエラ", "text": "返事の催促じゃないの？"},
        { "location": "258/TALK"    , "narrator": "アーヤ", "text": "どうかしら？\nえっと…。"},
        { "location": "272/TALK"    , "narrator": "アーヤ", "text": "聞いてたの？"},
        { "location": "273/TALK"    , "narrator": "アーヤ", "text": "嫌、ってわけじゃないわ"},
        { "location": "274/TALK"    , "narrator": "アーヤ", "text": "ただ、あまり乗り気がしないだけよ"},
        { "location": "275/TALK"    , "narrator": "アーヤ", "text": "…って、こんな気持ちで受けても、大したことできないわね"},
        { "location": "287/TALK"    , "narrator": "アーヤ", "text": "…やっぱり、\n断ろうかな。"},
        { "location": "288/TALK"    , "narrator": "アーヤ", "text": "剣道なんて、まともに\nやったの高校時代が\n最後だし…。"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "…毎日自主練してる\nから、腕は落ちて\nないんでしょ？"},
        { "location": "293/TALK"    , "narrator": "アーヤ", "text": "だと良いんだけど…。"},
        { "location": "295/TALK"    , "narrator": "アーヤ", "text": "でも、断ろうって\n思ったのは――"},
        { "location": "296/TALK"    , "narrator": "アーヤ", "text": "一度剣道を辞めた私が、\n人に剣道を教えるなんて\nおこがましい。"},
        { "location": "297/TALK"    , "narrator": "アーヤ", "text": "そう思ったからよ。"},
        { "location": "298/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "302/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…バッカみたい。"},
        { "location": "304/TALK"    , "narrator": "アーヤ", "text": "何よ、それ？"},
        { "location": "307/TALK"    , "narrator": "ガブリエラ", "text": "あんたがじゃないわ。"},
        { "location": "308/TALK"    , "narrator": "ガブリエラ", "text": "ちょっとでも期待した\nあたしがバカだった、\nって思っただけよ。"},
        { "location": "309/TALK"    , "narrator": "アーヤ", "text": "意味わからないわ。"},
        { "location": "312/TALK"    , "narrator": "ガブリエラ", "text": "いいわよ、もう。\n別に期待してないし。"},
        { "location": "313/ACT"     , "narrator": "", "text": "アーヤはどうしたいの？"},
        { "location": "316/TALK"    , "narrator": "アーヤ", "text": "あっ…。"},
        { "location": "317/TALK"    , "narrator": "ガブリエラ", "text": "返事の催促じゃないの？"},
        { "location": "318/TALK"    , "narrator": "アーヤ", "text": "どうかしら？\nえっと…。"},
        { "location": "332/TALK"    , "narrator": "アーヤ", "text": "どうしたいって、もちろんやりたいと思ってるわ"},
        { "location": "333/TALK"    , "narrator": "アーヤ", "text": "嫌いになったから剣道を辞めた、ってわけじゃないし…"},
        { "location": "334/TALK"    , "narrator": "アーヤ", "text": "…なんだ"},
        { "location": "335/TALK"    , "narrator": "アーヤ", "text": "もう答え出てたわ"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "誰からだった？"},
        { "location": "348/TALK"    , "narrator": "アーヤ", "text": "ん？　ちょっとね。"},
        { "location": "349/TALK"    , "narrator": "アーヤ", "text": "私、剣道部の指導の話、\n受けてみようかしら。"},
        { "location": "350/TALK"    , "narrator": "ガブリエラ", "text": "ふ～ん…辞めたくせに、\nよくそんな気持ちに\nなったわね？"},
        { "location": "354/TALK"    , "narrator": "アーヤ", "text": "辞めはしたけど、\n剣道が嫌いになった\nわけじゃないもの。"},
        { "location": "355/TALK"    , "narrator": "アーヤ", "text": "今だって大好きだから、\n例え指導する側だったと\nしても――"},
        { "location": "356/TALK"    , "narrator": "アーヤ", "text": "剣道に関われるなら、\nこれほど嬉しいことは\nないわ。"},
        { "location": "357/TALK"    , "narrator": "ガブリエラ", "text": "…ふ～ん。\nまだ好きだったんだ？"},
        { "location": "360/TALK"    , "narrator": "アーヤ", "text": "当たり前じゃない。\nバカなこと\n聞かないでよ。"},
        { "location": "361/TALK"    , "narrator": "アーヤ", "text": "毎日は参加できない\nから、剣道に復帰する\nわけにはいかないけど―"},
        { "location": "362/TALK"    , "narrator": "アーヤ", "text": "指導者として後輩達を\nビシビシ鍛えようと\n思うわ。"},
        { "location": "365/TALK"    , "narrator": "ガブリエラ", "text": "…まあ、\n好きにすれば？"},
        { "location": "367/TALK"    , "narrator": "ガブリエラ", "text": "…あとで\n見に行ってみよ。"},
        { "location": "161/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月12日　00:04 PM</color>\nとある昼休み、学園中庭にて。"}
    ]
}
