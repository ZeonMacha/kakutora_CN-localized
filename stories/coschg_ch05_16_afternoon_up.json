        { "location": "2113/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "2115/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "2117/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "2123/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "2125/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "2127/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "2130/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "2131/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "2133/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "2134/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "2136/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "2137/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "2140/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "2141/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "2151/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "2152/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "2153/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "2155/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "2156/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "2157/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "2160/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "2161/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "2163/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "2166/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "2167/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "2169/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "2170/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "2171/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "2178/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "2179/TALK", "narrator": "神楽", "text": "ありえネー"}
