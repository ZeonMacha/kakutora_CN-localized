    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "うしろの正面だあれ？"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "さっきのひどくない？"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "脅かすにも限度があるわよ"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "ギャヴィだって私だって"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "気絶するかと思ったわ"},
        { "location": "39/SEL"    , "narrator": "", "text": "まさか信じるとは…"},
        { "location": "40/SEL"    , "narrator": "", "text": "ガブリエラを護ったね"},
        { "location": "41/SEL"    , "narrator": "", "text": "ちょっとやり過ぎた？"},
        { "location": "42/ACT"    , "narrator": "", "text": "まさか信じるとは…"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "まさかじゃないわ"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "本当にそういうのを"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "呼ぶこともあるのよ"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "冗談にしていいことじゃない"},
        { "location": "49/SEL"    , "narrator": "", "text": "えー…"},
        { "location": "50/SEL"    , "narrator": "", "text": "ごめんなさい"},
        { "location": "51/SEL"    , "narrator": "", "text": "アーヤってスピ系の人だったんだ"},
        { "location": "52/ACT"    , "narrator": "", "text": "えー…"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "えーじゃないわ"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "反省してね"},
        { "location": "55/ACT"    , "narrator": "", "text": "ごめんなさい"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "今回はいいけど"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "二度としないでね"},
        { "location": "58/ACT"    , "narrator": "", "text": "アーヤってスピ系の人だったんだ"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "言い方は何でもいいわ"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "とにかくこんなこと"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "二度としちゃダメ"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "ダメだからね！"},
        { "location": "64/ACT"    , "narrator": "", "text": "ガブリエラを護ったね"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "護ったっていうか"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "守られたっていうか"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "ギャヴィったら"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "自分が怖いのに"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "私の心配して"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "怖かったのに"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "あれ見てたら"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "ギャヴィがかわいくて"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "なんだかうれしくなっちゃったわ"},
        { "location": "76/ACT"    , "narrator": "", "text": "ちょっとやり過ぎた？"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "ちょっとどころの"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "騒ぎじゃないわよ！"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "みやびが怒るのも"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "仕方ないわ"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "この部屋に入っちゃダメって言われてたのに"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "勝手に入ったんだもの"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "反省、、、"}
    ]
}
