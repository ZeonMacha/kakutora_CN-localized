{
    "dir": "chap00/daydra/first_anniversary_020.js",
    "type": "",
    "info": {
        "story_id": "11802",
        "cid": "",
        "title": "祝・１周年記念",
        "sub_title": "祝・１周年記念＜第２話＞"
    },
    "entry":
    [
        { "location": "245/TALK"  , "narrator": "みやび", "text": "はー。\nそんなことが\nあったんかね。"},
        { "location": "246/TALK"  , "narrator": "ガブリエラ", "text": "そうなのよ。\n本当につばめは！"},
        { "location": "247/TALK"  , "narrator": "アーヤ", "text": "まあまあ。\n天真爛漫なのよ\nあの子は。"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと！\nアーヤだって\n反対派だったでしょ！"},
        { "location": "250/TALK"  , "narrator": "アーヤ", "text": "それは、まあ……。"},
        { "location": "251/TALK"  , "narrator": "みやび", "text": "けんど、あれよね。\n確かにうちら\n世話になっちゅうき。"},
        { "location": "252/TALK"  , "narrator": "みやび", "text": "$handle$と\n来たいちう気持ちは\nわからんでもない。"},
        { "location": "253/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、多少はね？"},
        { "location": "256/TALK"  , "narrator": "ガブリエラ", "text": "記念日っぽい\n雰囲気にも\nなりそうだし。"},
        { "location": "258/TALK"  , "narrator": "ガブリエラ", "text": "思い出も\n作りたいし。"},
        { "location": "260/TALK"  , "narrator": "ガブリエラ", "text": "楽しそうだし。"},
        { "location": "265/TALK"  , "narrator": "アーヤ", "text": "わかるわよ私も。"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "$handle$さんは\n大事な人だし。"},
        { "location": "269/TALK"  , "narrator": "アーヤ", "text": "あんまり隠し事も\nしたくないし。"},
        { "location": "271/TALK"  , "narrator": "アーヤ", "text": "せっかく遠くに\n行くんだし。"},
        { "location": "276/TALK"  , "narrator": "ガブリエラ", "text": "そういうみやびは\nどうなのよ？"},
        { "location": "278/TALK"  , "narrator": "みやび", "text": "行ってもえいかと\n思うとる。"},
        { "location": "280/TALK"  , "narrator": "みやび", "text": "相棒とは\n離れられん\n間柄やき。"},
        { "location": "282/TALK"  , "narrator": "みやび", "text": "おらんと少し\n寂しいし。"},
        { "location": "284/TALK"  , "narrator": "みやび", "text": "洒落もわかるし。"},
        { "location": "289/TALK"  , "narrator": "みやび", "text": "って感じかねえ。"},
        { "location": "307/TALK"  , "narrator": "つばめ", "text": "いいところだね\n秩父。"},
        { "location": "308/TALK"  , "narrator": "神楽", "text": "そうですか？"},
        { "location": "309/TALK"  , "narrator": "神楽", "text": "激しくオススメした\n甲斐がありました。"},
        { "location": "310/TALK"  , "narrator": "つばめ", "text": "……ふう。"},
        { "location": "311/TALK"  , "narrator": "神楽", "text": "何ですか？"},
        { "location": "312/TALK"  , "narrator": "つばめ", "text": "ううん。\n$handle$さんと\n来たかったなって。"},
        { "location": "313/TALK"  , "narrator": "つばめ", "text": "あっ！\n神楽ちゃんと来れて\nうれしいんだよ！？"},
        { "location": "314/TALK"  , "narrator": "つばめ", "text": "アーヤさんにガブちゃん\nみやびさんもいるし。"},
        { "location": "316/TALK"  , "narrator": "神楽", "text": "そんな気を使わなくて\n大丈夫ですよ。"},
        { "location": "317/TALK"  , "narrator": "神楽", "text": "…でもちょっと\n聞きたいですね。"},
        { "location": "318/TALK"  , "narrator": "神楽", "text": "つばめさんにとって\n$handle$さんが\nどんな存在なのか。"},
        { "location": "320/TALK"  , "narrator": "つばめ", "text": "…うーん…。"},
        { "location": "322/TALK"  , "narrator": "つばめ", "text": "すっごくすっごく\n大事な人！"},
        { "location": "324/TALK"  , "narrator": "つばめ", "text": "色々おしゃべりできる\n恋人？"},
        { "location": "326/TALK"  , "narrator": "つばめ", "text": "不思議なお友達？"},
        { "location": "328/TALK"  , "narrator": "つばめ", "text": "不思議なお友達？"},
        { "location": "332/TALK"  , "narrator": "つばめ", "text": "って感じかなあ。"},
        { "location": "333/TALK"  , "narrator": "神楽", "text": "…そうなんですね。"},
        { "location": "334/TALK"  , "narrator": "つばめ", "text": "あっ！"},
        { "location": "335/TALK"  , "narrator": "つばめ", "text": "忘れ物してた！\n先に行ってて！"},
        { "location": "376/TALK"  , "narrator": "神楽", "text": "みなさんもう\n入ってたんですね。"},
        { "location": "378/TALK"  , "narrator": "みやび", "text": "おお、ちょうど\nええところに。"},
        { "location": "379/TALK"  , "narrator": "アーヤ", "text": "そうね。\n卯月の意見も\n聞きたいわ。"},
        { "location": "380/TALK"  , "narrator": "ガブリエラ", "text": "ねえ。\n$handle$のこと\nどう思ってる？"},
        { "location": "381/TALK"  , "narrator": "神楽", "text": "私がですか？"},
        { "location": "383/TALK"  , "narrator": "神楽", "text": "いるだけで心が\n温かくなる人です。"},
        { "location": "385/TALK"  , "narrator": "神楽", "text": "いないと寂しくて\n仕方ない人…ですね。"},
        { "location": "387/TALK"  , "narrator": "神楽", "text": "話しやすい面白い人…\nですかね。"},
        { "location": "389/TALK"  , "narrator": "神楽", "text": "暇な時にお話とか\nしてくれる人…\nですかね。"},
        { "location": "392/TALK"  , "narrator": "神楽", "text": "でも偶然ですね。\nさっきつばめさんとも\nそんな話をしてたんです。"},
        { "location": "393/TALK"  , "narrator": "みやび", "text": "それは、あれよ。"},
        { "location": "395/TALK"  , "narrator": "みやび", "text": "なんだかんだで\n全員$handle$の\n世話になっちゅうき。"},
        { "location": "397/TALK"  , "narrator": "アーヤ", "text": "そうよね。"},
        { "location": "398/TALK"  , "narrator": "アーヤ", "text": "お礼とかしてみる？\nちょっと改まって。"},
        { "location": "399/TALK"  , "narrator": "ガブリエラ", "text": "たまにはいいかも。"},
        { "location": "400/TALK"  , "narrator": "神楽", "text": "じゃあ私がみんなの\nイラストを\n描きましょうか。"},
        { "location": "401/TALK"  , "narrator": "神楽", "text": "それにメッセージを\nつけてプレゼント。"},
        { "location": "402/TALK"  , "narrator": "みやび", "text": "えいねえ。"},
        { "location": "404/TALK"  , "narrator": "アーヤ", "text": "世界に一つだけの\nプレゼントに\nなるわね。"},
        { "location": "406/TALK"  , "narrator": "ガブリエラ", "text": "かわいく描いてよね！"},
        { "location": "407/TALK"  , "narrator": "神楽", "text": "もちろんです！"},
        { "location": "409/TALK"  , "narrator": "神楽", "text": "しかもお色気も\n盛り込みますよー。"},
        { "location": "412/TALK"  , "narrator": "ガブリエラ", "text": "は？"},
        { "location": "413/TALK"  , "narrator": "神楽", "text": "全員で温泉。\n当然ですよね。"},
        { "location": "415/TALK"  , "narrator": "みやび", "text": "いや、それはちょっと…。"},
        { "location": "417/TALK"  , "narrator": "アーヤ", "text": "ダメよそんなの！\nありえない！"},
        { "location": "419/TALK"  , "narrator": "ガブリエラ", "text": "無理無理無理無理！\n絶対阻止！"},
        { "location": "423/DIALOG", "narrator": "", "text": "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n　　　　　　To be continued !"}
    ]
}
