{
    "dir": "dramatics/daydra/drm_ch01_00_810.js",
    "type": "Episode",
    "info": {
        "story_id": "1081",
        "cid": "tsubame",
        "title": "らぶとーく 第82話",
        "sub_title": "特別な人へ感謝を込めて"
    },
    "entry":
    [
        { "location": "320/TALK", "narrator": "つばめ", "text": "でね。式には\nお父さんを\n呼びたいの。"},
        { "location": "321/SEL" , "narrator": "", "text": "え"},
        { "location": "322/SEL" , "narrator": "", "text": "ちょっと待って！"},
        { "location": "323/SEL" , "narrator": "", "text": "本気で言ってる？"},
        { "location": "324/ACT" , "narrator": "", "text": "え"},
        { "location": "325/TALK", "narrator": "つばめ", "text": "あれ？"},
        { "location": "326/ACT" , "narrator": "", "text": "ちょっと待って！"},
        { "location": "327/TALK", "narrator": "つばめ", "text": "うん。\n準備とかあるもんね。"},
        { "location": "328/ACT" , "narrator": "", "text": "本気で言ってる？"},
        { "location": "329/TALK", "narrator": "つばめ", "text": "えと\n本気だよ？"},
        { "location": "331/TALK", "narrator": "つばめ", "text": "前にちょっと\n言ったよね？"},
        { "location": "332/SEL" , "narrator": "", "text": "そうだった"},
        { "location": "333/SEL" , "narrator": "", "text": "聞いたけど"},
        { "location": "334/SEL" , "narrator": "", "text": "本気だったんだ"},
        { "location": "335/ACT" , "narrator": "", "text": "そうだった"},
        { "location": "336/TALK", "narrator": "つばめ", "text": "ね？"},
        { "location": "337/ACT" , "narrator": "", "text": "聞いたけど"},
        { "location": "338/TALK", "narrator": "つばめ", "text": "言ったもん。"},
        { "location": "339/ACT" , "narrator": "", "text": "本気だったんだ"},
        { "location": "340/TALK", "narrator": "つばめ", "text": "そうだよ？"},
        { "location": "342/SEL" , "narrator": "", "text": "あー…"},
        { "location": "343/SEL" , "narrator": "", "text": "対策しないと"},
        { "location": "344/SEL" , "narrator": "", "text": "ハードル高いなー！"},
        { "location": "345/ACT" , "narrator": "", "text": "あー…"},
        { "location": "346/TALK", "narrator": "つばめ", "text": "あれ？"},
        { "location": "347/ACT" , "narrator": "", "text": "対策しないと"},
        { "location": "348/TALK", "narrator": "つばめ", "text": "……。"},
        { "location": "349/ACT" , "narrator": "", "text": "ハードル高いなー！"},
        { "location": "350/TALK", "narrator": "つばめ", "text": "そうかも……。"},
        { "location": "353/TALK", "narrator": "つばめ", "text": "えとね……。"},
        { "location": "354/TALK", "narrator": "つばめ", "text": "スマホも返してくれたし\n話していいって\n言ってくれたし。"},
        { "location": "355/TALK", "narrator": "つばめ", "text": "$handle$さんの\nこと、嫌いじゃないと\n思うんだ。"},
        { "location": "356/TALK", "narrator": "つばめ", "text": "それにね。"},
        { "location": "357/TALK", "narrator": "つばめ", "text": "お父さんにちゃんと\nわかってもらいたい。"},
        { "location": "358/TALK", "narrator": "つばめ", "text": "わたしたちのこと。"},
        { "location": "359/SEL" , "narrator": "", "text": "そう言われたら…"},
        { "location": "360/SEL" , "narrator": "", "text": "うーん…"},
        { "location": "361/SEL" , "narrator": "", "text": "当たって砕けろか"},
        { "location": "362/ACT" , "narrator": "", "text": "そう言われたら…"},
        { "location": "364/TALK", "narrator": "つばめ", "text": "ちゃんと話せば\nわかってくれるよ。"},
        { "location": "365/ACT" , "narrator": "", "text": "うーん…"},
        { "location": "367/TALK", "narrator": "つばめ", "text": "大丈夫だよ。\nきっと。"},
        { "location": "368/ACT" , "narrator": "", "text": "当たって砕けろか"},
        { "location": "370/TALK", "narrator": "つばめ", "text": "ちょっと怖いけど\n暴力とかはないよ。"},
        { "location": "388/TALK", "narrator": "啓介", "text": "……………………\n……………………\n……………………。"},
        { "location": "389/TALK", "narrator": "つばめ", "text": "そういうわけで\n結婚式に\n出て欲しいんです。"},
        { "location": "390/TALK", "narrator": "啓介", "text": "……………………\n……………………\n……………………。"},
        { "location": "391/TALK", "narrator": "つばめ", "text": "準備とかは\n自分たちで\nちゃんとするから。"},
        { "location": "392/TALK", "narrator": "啓介", "text": "………。"},
        { "location": "393/TALK", "narrator": "つばめ", "text": "お父さんの仕事が\n忙しくない時に\nするつもりだし。"},
        { "location": "394/TALK", "narrator": "啓介", "text": "………。"},
        { "location": "395/TALK", "narrator": "つばめ", "text": "お願い。"},
        { "location": "396/TALK", "narrator": "啓介", "text": "………。"},
        { "location": "397/TALK", "narrator": "つばめ", "text": "あと何て言えば\nいいかな……。"},
        { "location": "398/TALK", "narrator": "啓介", "text": "相手と話を\nさせなさい。"},
        { "location": "399/TALK", "narrator": "つばめ", "text": "……え？"},
        { "location": "400/TALK", "narrator": "啓介", "text": "$handle$と\nやらと二人きりで\n話がしたい。"},
        { "location": "401/TALK", "narrator": "つばめ", "text": "……うん。\nわかった。"},
        { "location": "407/TALK", "narrator": "啓介", "text": "あー……。"},
        { "location": "408/TALK", "narrator": "啓介", "text": "君は本気で\n言っているのか？"},
        { "location": "409/SEL" , "narrator": "", "text": "本気です、お父さん"},
        { "location": "410/SEL" , "narrator": "", "text": "もちろん"},
        { "location": "411/SEL" , "narrator": "", "text": "今のところは"},
        { "location": "412/ACT" , "narrator": "", "text": "本気です、お父さん"},
        { "location": "413/TALK", "narrator": "啓介", "text": "お父さんと言われる\n謂われはない。"},
        { "location": "414/ACT" , "narrator": "", "text": "もちろん"},
        { "location": "415/TALK", "narrator": "啓介", "text": "口では\n何とでも言える。"},
        { "location": "416/ACT" , "narrator": "", "text": "今のところは"},
        { "location": "417/TALK", "narrator": "啓介", "text": "…ある意味正直だな。"},
        { "location": "419/TALK", "narrator": "啓介", "text": "ならなぜ\nここに来ない。"},
        { "location": "420/SEL" , "narrator": "", "text": "無理だからです"},
        { "location": "421/SEL" , "narrator": "", "text": "できるものなら\n行きたいんですが"},
        { "location": "422/SEL" , "narrator": "", "text": "行けるようになれば\n一番最初に伺います"},
        { "location": "423/ACT" , "narrator": "", "text": "無理だからです"},
        { "location": "424/TALK", "narrator": "啓介", "text": "……。"},
        { "location": "425/ACT" , "narrator": "", "text": "できるものなら\n行きたいんですが"},
        { "location": "426/TALK", "narrator": "啓介", "text": "要は無理だと。"},
        { "location": "427/ACT" , "narrator": "", "text": "行けるようになれば\n一番最初に伺います"},
        { "location": "428/TALK", "narrator": "啓介", "text": "…口だけは達者だな。"},
        { "location": "430/TALK", "narrator": "啓介", "text": "こうやって会話を\nする以外の方法が\nないという時点で。"},
        { "location": "431/TALK", "narrator": "啓介", "text": "私は君を信用できない。"},
        { "location": "432/TALK", "narrator": "啓介", "text": "うちの娘がごっこ遊びに\n夢中になっているだけと\nしか思えない。"},
        { "location": "433/TALK", "narrator": "啓介", "text": "ここまでのめり込む前に\n禁止しておけばよかったと\n思っているくらいだ。"},
        { "location": "434/SEL" , "narrator": "", "text": "そんな"},
        { "location": "435/SEL" , "narrator": "", "text": "$me$は本気です"},
        { "location": "436/SEL" , "narrator": "", "text": "認めては\nもらえないんでしょうか"},
        { "location": "437/ACT" , "narrator": "", "text": "そんな"},
        { "location": "438/TALK", "narrator": "啓介", "text": "当然だろう。"},
        { "location": "439/ACT" , "narrator": "", "text": "$me$は本気です"},
        { "location": "440/TALK", "narrator": "啓介", "text": "立場が逆でも\n同じことが\n言えるか？"},
        { "location": "441/ACT" , "narrator": "", "text": "認めては\nもらえないんでしょうか"},
        { "location": "442/TALK", "narrator": "啓介", "text": "それ以前の問題だ。"},
        { "location": "444/TALK", "narrator": "啓介", "text": "しかし、だ。"},
        { "location": "445/TALK", "narrator": "啓介", "text": "娘が言う結婚式と\nやらには出席する。"},
        { "location": "446/SEL" , "narrator": "", "text": "ありがとうございます！"},
        { "location": "447/SEL" , "narrator": "", "text": "本当ですか？"},
        { "location": "448/SEL" , "narrator": "", "text": "ツンデレなんだからもー！"},
        { "location": "449/ACT" , "narrator": "", "text": "ありがとうございます！"},
        { "location": "450/TALK", "narrator": "啓介", "text": "君に礼を言われる\n筋合いはない。"},
        { "location": "451/ACT" , "narrator": "", "text": "本当ですか？"},
        { "location": "452/TALK", "narrator": "啓介", "text": "嘘をついてどうする。"},
        { "location": "453/ACT" , "narrator": "", "text": "ツンデレなんだからもー！"},
        { "location": "454/TALK", "narrator": "啓介", "text": "本当にこんなのの\nどこがいいのか…。"},
        { "location": "456/TALK", "narrator": "啓介", "text": "勘違いするな。\nあくまで娘の\n喜ぶ顔が見たいからだ。"},
        { "location": "457/TALK", "narrator": "啓介", "text": "それに\nごっこ遊びにも\nそのうち飽きるだろう。"},
        { "location": "458/TALK", "narrator": "啓介", "text": "隠れて何かをされて\n取り返しのつかないことに\nなるくらいなら。"},
        { "location": "459/TALK", "narrator": "啓介", "text": "本番の予行演習代わりに\n付き合おう。\nそれだけのことだ。"},
        { "location": "460/SEL" , "narrator": "", "text": "これが本番です！"},
        { "location": "461/SEL" , "narrator": "", "text": "本番も$me$が隣にいます"},
        { "location": "462/SEL" , "narrator": "", "text": "これからを見ていてください"},
        { "location": "463/ACT" , "narrator": "", "text": "これが本番です！"},
        { "location": "464/TALK", "narrator": "啓介", "text": "……なるほど。"},
        { "location": "465/ACT" , "narrator": "", "text": "本番も$me$が隣にいます"},
        { "location": "466/TALK", "narrator": "啓介", "text": "……どうだろうな。"},
        { "location": "467/ACT" , "narrator": "", "text": "これからを見ていてください"},
        { "location": "468/TALK", "narrator": "啓介", "text": "……ほう。"},
        { "location": "470/TALK", "narrator": "啓介", "text": "こちらからは\nそれだけだ。"},
        { "location": "471/SEL" , "narrator": "", "text": "出席ありがとうございます"},
        { "location": "472/SEL" , "narrator": "", "text": "つばめさんを大事にします"},
        { "location": "473/SEL" , "narrator": "", "text": "いつか一緒にお酒を\n酌み交わしたいです"},
        { "location": "474/ACT" , "narrator": "", "text": "出席ありがとうございます"},
        { "location": "475/TALK", "narrator": "啓介", "text": "だから君のためでは\nないと何度言えば。"},
        { "location": "476/ACT" , "narrator": "", "text": "つばめさんを大事にします"},
        { "location": "477/TALK", "narrator": "啓介", "text": "……本当に口だけは\n達者なやつだ。"},
        { "location": "478/ACT" , "narrator": "", "text": "いつか一緒にお酒を\n酌み交わしたいです"},
        { "location": "479/TALK", "narrator": "啓介", "text": "…どうだか。"},
        { "location": "499/TALK", "narrator": "つばめ", "text": "……緊張するね。"},
        { "location": "500/SEL" , "narrator": "", "text": "大丈夫、大丈夫"},
        { "location": "501/SEL" , "narrator": "", "text": "ホントだね……"},
        { "location": "502/SEL" , "narrator": "", "text": "でもうれしいよね"},
        { "location": "503/ACT" , "narrator": "", "text": "大丈夫、大丈夫"},
        { "location": "504/TALK", "narrator": "つばめ", "text": "うん……。"},
        { "location": "505/ACT" , "narrator": "", "text": "ホントだね……"},
        { "location": "506/TALK", "narrator": "つばめ", "text": "$handle$さんも\n緊張してる？"},
        { "location": "507/ACT" , "narrator": "", "text": "でもうれしいよね"},
        { "location": "508/TALK", "narrator": "つばめ", "text": "そうだね……。"},
        { "location": "510/TALK", "narrator": "つばめ", "text": "……。"},
        { "location": "511/TALK", "narrator": "つばめ", "text": "あのね。\n聞いていい？"},
        { "location": "512/TALK", "narrator": "つばめ", "text": "この前家に行った時\nうちのお父さんと\n何の話したの？"},
        { "location": "513/SEL" , "narrator": "", "text": "娘をよろしく"},
        { "location": "514/SEL" , "narrator": "", "text": "世間話とか"},
        { "location": "515/SEL" , "narrator": "", "text": "心配することないよ"},
        { "location": "516/SEL" , "narrator": "", "text": "二人の秘密"},
        { "location": "517/ACT" , "narrator": "", "text": "娘をよろしく"},
        { "location": "519/TALK", "narrator": "つばめ", "text": "え\nお父さんってば…。"},
        { "location": "520/ACT" , "narrator": "", "text": "世間話とか"},
        { "location": "522/TALK", "narrator": "つばめ", "text": "えええ？\n本当に？"},
        { "location": "523/ACT" , "narrator": "", "text": "心配することないよ"},
        { "location": "524/TALK", "narrator": "つばめ", "text": "……かえって心配…。"},
        { "location": "525/ACT" , "narrator": "", "text": "二人の秘密"},
        { "location": "527/TALK", "narrator": "つばめ", "text": "え！\nずるい！"},
        { "location": "529/TALK", "narrator": "つばめ", "text": "……なんかね。"},
        { "location": "530/TALK", "narrator": "つばめ", "text": "わたしお父さんが\nすごく反対するって\n思ったの。"},
        { "location": "531/SEL" , "narrator": "", "text": "だろうね"},
        { "location": "532/SEL" , "narrator": "", "text": "大丈夫って\n言ってなかった？"},
        { "location": "533/SEL" , "narrator": "", "text": "あー…うん…"},
        { "location": "534/ACT" , "narrator": "", "text": "だろうね"},
        { "location": "535/TALK", "narrator": "つばめ", "text": "そう思ってた？"},
        { "location": "536/ACT" , "narrator": "", "text": "大丈夫って\n言ってなかった？"},
        { "location": "537/TALK", "narrator": "つばめ", "text": "うんまあ……。\nそうなんだけど…。"},
        { "location": "538/ACT" , "narrator": "", "text": "あー…うん…"},
        { "location": "539/TALK", "narrator": "つばめ", "text": "あれ！？\n何かあったの？"},
        { "location": "541/TALK", "narrator": "つばめ", "text": "でもね。\n反対なんて\n全然されなくて。"},
        { "location": "542/TALK", "narrator": "つばめ", "text": "すごく一生懸命\n色々相談とか\n乗ってくれたし。"},
        { "location": "543/TALK", "narrator": "つばめ", "text": "だから\n$handle$さんと\n話したからかなって。"},
        { "location": "544/TALK", "narrator": "つばめ", "text": "違うのかな？"},
        { "location": "545/SEL" , "narrator": "", "text": "そのうち話すよ"},
        { "location": "546/SEL" , "narrator": "", "text": "それは違うかな…"},
        { "location": "547/SEL" , "narrator": "", "text": "いいお父さんだよね"},
        { "location": "548/ACT" , "narrator": "", "text": "そのうち話すよ"},
        { "location": "550/TALK", "narrator": "つばめ", "text": "うん。\n待ってる。"},
        { "location": "551/ACT" , "narrator": "", "text": "それは違うかな…"},
        { "location": "552/TALK", "narrator": "つばめ", "text": "あれ？\nそうなの？"},
        { "location": "553/ACT" , "narrator": "", "text": "いいお父さんだよね"},
        { "location": "555/TALK", "narrator": "つばめ", "text": "そうでしょ。\nえへへ。"},
        { "location": "558/TALK", "narrator": "つばめ", "text": "あ！"},
        { "location": "566/TALK", "narrator": "啓介", "text": "準備はできたか。"},
        { "location": "567/TALK", "narrator": "つばめ", "text": "うん！"},
        { "location": "568/TALK", "narrator": "つばめ", "text": "…ねえお父さん。"},
        { "location": "569/TALK", "narrator": "啓介", "text": "何だ。"},
        { "location": "570/TALK", "narrator": "つばめ", "text": "今日は本当に\nありがとう。"},
        { "location": "571/TALK", "narrator": "つばめ", "text": "わたし、世界一\n幸せだよ。"},
        { "location": "572/TALK", "narrator": "啓介", "text": "……。\nそうか。"},
        { "location": "573/TALK", "narrator": "つばめ", "text": "わたし、お父さんの\n娘でよかった。"},
        { "location": "574/TALK", "narrator": "つばめ", "text": "えへへ……。"},
        { "location": "575/TALK", "narrator": "啓介", "text": "……。"},
        { "location": "576/SEL" , "narrator": "", "text": "おじさん"},
        { "location": "577/SEL" , "narrator": "", "text": "お父さん"},
        { "location": "578/ACT" , "narrator": "", "text": "おじさん"},
        { "location": "580/TALK", "narrator": "啓介", "text": "……何だ。"},
        { "location": "581/ACT" , "narrator": "", "text": "お父さん"},
        { "location": "583/TALK", "narrator": "啓介", "text": "……。"},
        { "location": "585/SEL" , "narrator": "", "text": "今日は\nありがとうございます"},
        { "location": "586/SEL" , "narrator": "", "text": "これからも\nお世話になります"},
        { "location": "587/SEL" , "narrator": "", "text": "笑顔でお願いします"},
        { "location": "588/ACT" , "narrator": "", "text": "今日は\nありがとうございます"},
        { "location": "589/TALK", "narrator": "啓介", "text": "……君のためではない。"},
        { "location": "590/ACT" , "narrator": "", "text": "これからも\nお世話になります"},
        { "location": "591/TALK", "narrator": "啓介", "text": "……お世話、か。"},
        { "location": "592/ACT" , "narrator": "", "text": "笑顔でお願いします"},
        { "location": "593/TALK", "narrator": "啓介", "text": "……相変わらず\n一言多いな。"},
        { "location": "595/TALK", "narrator": "つばめ", "text": "もう！\nお父さん！"},
        { "location": "596/TALK", "narrator": "つばめ", "text": "何でそんな\n言い方するの！"},
        { "location": "598/TALK", "narrator": "つばめ", "text": "$handle$さん、\nごめんね。"},
        { "location": "599/TALK", "narrator": "つばめ", "text": "お父さんちょっと…\nちょっと…何だろう…。"},
        { "location": "600/SEL" , "narrator": "", "text": "気にしてないよ"},
        { "location": "601/SEL" , "narrator": "", "text": "大丈夫だから"},
        { "location": "602/SEL" , "narrator": "", "text": "このくらいじゃないとね"},
        { "location": "603/ACT" , "narrator": "", "text": "気にしてないよ"},
        { "location": "604/TALK", "narrator": "つばめ", "text": "そう…？"},
        { "location": "605/ACT" , "narrator": "", "text": "大丈夫だから"},
        { "location": "606/TALK", "narrator": "つばめ", "text": "やっぱりちょっと…\nうーん……。"},
        { "location": "607/ACT" , "narrator": "", "text": "このくらいじゃないとね"},
        { "location": "608/TALK", "narrator": "つばめ", "text": "あっちょっと\nかっこいいかも？"},
        { "location": "610/TALK", "narrator": "つばめ", "text": "……でも今日は\nお祝いなんだから。"},
        { "location": "611/TALK", "narrator": "つばめ", "text": "わたしがぷりぷり\nしてちゃダメだね。"},
        { "location": "612/SEL" , "narrator": "", "text": "そうそう"},
        { "location": "613/SEL" , "narrator": "", "text": "怒った顔もかわいいけど"},
        { "location": "614/SEL" , "narrator": "", "text": "今日もかわいいよ"},
        { "location": "615/ACT" , "narrator": "", "text": "そうそう"},
