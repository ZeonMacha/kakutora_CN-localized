{
    "dir": "chap24/daydra/dd_ch02_24_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "24256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "臨戦態勢ガブリエラ"
    },
    "entry":
    [
        { "location": "299/SCENARIO", "narrator": "", "text": "臨戦態勢ガブリエラ"},
        { "location": "312/TALK"    , "narrator": "アーヤ", "text": "…あら？"},
        { "location": "315/TALK"    , "narrator": "ガブリエラ", "text": "はぁ、はぁ…。"},
        { "location": "316/TALK"    , "narrator": "アーヤ", "text": "おはよう、ギャヴィ…。\nもしかして走って来たの？"},
        { "location": "318/TALK"    , "narrator": "ガブリエラ", "text": "当然でしょ…。\n何のために、合宿で鍛えたと\n思ってんのよ…。"},
        { "location": "319/TALK"    , "narrator": "アーヤ", "text": "…どれくらい走ってきたの？\nすごく疲れてるように\n見えるけど…。"},
        { "location": "320/TALK"    , "narrator": "ガブリエラ", "text": "二つ隣の駅まで行って\n帰ってきただけだから、\n大した距離じゃないわ。"},
        { "location": "321/TALK"    , "narrator": "アーヤ", "text": "そんなに！？\n授業中に寝たりしない\nでしょうね？"},
        { "location": "323/TALK"    , "narrator": "ガブリエラ", "text": "中学の範囲程度、\nとっくにマスターしてるの\nわかってるでしょ？"},
        { "location": "324/TALK"    , "narrator": "アーヤ", "text": "だからって…。"},
        { "location": "326/TALK"    , "narrator": "ガブリエラ", "text": "わかってる、寝ないわよ。\nだからこの話はおしまい！"},
        { "location": "327/TALK"    , "narrator": "ガブリエラ", "text": "シャワー浴びるんだから、\n邪魔しないで。"},
        { "location": "333/TALK"    , "narrator": "アーヤ", "text": "あ、ギャヴィ…。"},
        { "location": "336/TALK"    , "narrator": "アーヤ", "text": "…あの子…大丈夫かしら？"},
        { "location": "337/SEL"     , "narrator": "", "text": "ピリピリしてるね"},
        { "location": "338/ACT"     , "narrator": "", "text": "ピリピリしてるね"},
        { "location": "355/TALK"    , "narrator": "アーヤ", "text": "$handle2$も気づいた？(´o｀；"},
        { "location": "356/TALK"    , "narrator": "アーヤ", "text": "気持ちはわかるけど"},
        { "location": "357/TALK"    , "narrator": "アーヤ", "text": "気持ち張り過ぎ(>_<)"},
        { "location": "358/TALK"    , "narrator": "アーヤ", "text": "あれじゃ"},
        { "location": "359/TALK"    , "narrator": "アーヤ", "text": "気持ちが擦れちゃう(; ;)"},
        { "location": "360/TALK"    , "narrator": "アーヤ", "text": "どうにかしないと"},
        { "location": "362/SEL"     , "narrator": "", "text": "そうしてあげて"},
        { "location": "363/ACT"     , "narrator": "", "text": "そうしてあげて"},
        { "location": "365/TALK"    , "narrator": "アーヤ", "text": "任せて"},
        { "location": "388/TALK"    , "narrator": "ガブリエラ", "text": "…で、何の用事？\n放課後にこんなとこ\n呼び出して…。"},
        { "location": "390/TALK"    , "narrator": "アーヤ", "text": "うん…ちょっと、\n最近のギャヴィのことが\n気になって…。"},
        { "location": "391/TALK"    , "narrator": "ガブリエラ", "text": "何がよ？"},
        { "location": "392/TALK"    , "narrator": "アーヤ", "text": "それよ、その態度。"},
        { "location": "393/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ…三戸浜から\n帰ってから、ちょっと\nピリピリし過ぎよ。"},
        { "location": "394/TALK"    , "narrator": "アーヤ", "text": "少しは落ち着かないと、\n身体も心も擦り切れ\nちゃうわ。"},
        { "location": "397/TALK"    , "narrator": "ガブリエラ", "text": "え？　ちょっと、何それ？"},
        { "location": "398/TALK"    , "narrator": "ガブリエラ", "text": "この状況でピリピリしない\nわけないじゃない。"},
        { "location": "399/TALK"    , "narrator": "アーヤ", "text": "そうかもしれないけど、\n限度ってものがあるでしょ？"},
        { "location": "400/TALK"    , "narrator": "ガブリエラ", "text": "あたしから言わせて\nもらえば、アーヤ達の方が\nおかしく見えるわ。"},
        { "location": "401/TALK"    , "narrator": "ガブリエラ", "text": "東京帰ってきてから、\n行く前と変わらない\n毎日じゃない。"},
        { "location": "402/TALK"    , "narrator": "ガブリエラ", "text": "何考えてんのよ？\n三戸浜での特訓の成果を\n無駄にするつもり？"},
        { "location": "403/TALK"    , "narrator": "アーヤ", "text": "無駄になんてしてないわ。\nみんな、ちゃんと訓練は\n続けてるんだから。"},
        { "location": "405/TALK"    , "narrator": "ガブリエラ", "text": "真剣さが足りないのよ！"},
        { "location": "406/TALK"    , "narrator": "ガブリエラ", "text": "アーヤも、わかってんの？"},
        { "location": "407/TALK"    , "narrator": "ガブリエラ", "text": "相手はフェノメノンと\n神楽だけじゃない…。"},
        { "location": "408/TALK"    , "narrator": "ガブリエラ", "text": "管理庁まで相手にしなきゃ\nいけなくなるかも\nしれないのよ！？"},
        { "location": "410/TALK"    , "narrator": "ガブリエラ", "text": "なのに…どうしてみんな、\nちっとも真剣じゃないのよ？"},
        { "location": "411/TALK"    , "narrator": "アーヤ", "text": "…それ、本気で言ってるの？"},
        { "location": "412/TALK"    , "narrator": "アーヤ", "text": "ギャヴィは…私達が、\nこの状況下で不真面目に\n過ごしてると思ってるの？"},
        { "location": "414/TALK"    , "narrator": "ガブリエラ", "text": "真面目なら、この状況で\n遊んだりできないはずよ。"},
        { "location": "415/TALK"    , "narrator": "アーヤ", "text": "逆よ、それは。"},
        { "location": "416/TALK"    , "narrator": "アーヤ", "text": "これから先は、落ち着ける\n時間なんてほとんど\nなくなるはず。"},
        { "location": "417/TALK"    , "narrator": "アーヤ", "text": "それがわかってるから、\n今のうちにできることを\nしてるのよ。"},
        { "location": "418/TALK"    , "narrator": "ガブリエラ", "text": "そんなの、全部終わらせた\n後だっていいじゃない。"},
        { "location": "419/TALK"    , "narrator": "ガブリエラ", "text": "今気を緩めて、そのせいで\n戦いに負けたりしたら\nどうするつもりよ？"},
        { "location": "420/TALK"    , "narrator": "アーヤ", "text": "緩めてなんかいないわ。\n誰一人としてね。"},
        { "location": "421/TALK"    , "narrator": "アーヤ", "text": "でも、気を張り過ぎて\n危なっかしいメンバーが、\n一人いるけど…。"},
        { "location": "422/TALK"    , "narrator": "ガブリエラ", "text": "…なによ？\nそれ、あたしのこと？"},
        { "location": "423/TALK"    , "narrator": "アーヤ", "text": "他にいないでしょ。"},
        { "location": "424/TALK"    , "narrator": "アーヤ", "text": "いい、ギャヴィ？\n大切なことだから\nよく聞いてちょうだい。"},
        { "location": "425/TALK"    , "narrator": "アーヤ", "text": "気を引き締めてるだけなら、\n私だって何も言わないわ。"},
        { "location": "426/TALK"    , "narrator": "アーヤ", "text": "けど、ずっとピリピリした\n状態でいられたら、\n心配で放っておけない。"},
        { "location": "427/TALK"    , "narrator": "アーヤ", "text": "だからこうして――"},
        { "location": "428/TALK"    , "narrator": "ガブリエラ", "text": "いい加減にして！"},
        { "location": "429/TALK"    , "narrator": "ガブリエラ", "text": "こっちはあんた達と違って、\nいつ戦闘になってもいい\n状態を保ってるの。"},
        { "location": "431/TALK"    , "narrator": "ガブリエラ", "text": "なのに、そんなふうに\n意味の分からない文句ばっか\n言わないで！"},
        { "location": "432/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "433/SEL"     , "narrator": "", "text": "ビシッと言い聞かせるんだ！"},
        { "location": "434/SEL"     , "narrator": "", "text": "大丈夫、心配ないよ"},
        { "location": "435/ACT"     , "narrator": "", "text": "ビシッと言い聞かせるんだ！"},
        { "location": "452/TALK"    , "narrator": "アーヤ", "text": "そうするわ(｀ヘ´)"},
        { "location": "453/TALK"    , "narrator": "アーヤ", "text": "ギャヴィのことだから"},
        { "location": "454/TALK"    , "narrator": "アーヤ", "text": "心配ないと思ったけど"},
        { "location": "455/TALK"    , "narrator": "アーヤ", "text": "そうでもないみたいだし(-ω-;)"},
        { "location": "458/TALK"    , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "459/TALK"    , "narrator": "アーヤ", "text": "残念かも(; ;)"},
        { "location": "471/TALK"    , "narrator": "アーヤ", "text": "あのね…意味わからないで\n終わらせたらダメでしょ？"},
        { "location": "472/TALK"    , "narrator": "アーヤ", "text": "ギャヴィだけじゃなくて、\n仲間達みんなの命にだって\n関係あるんだから。"},
        { "location": "473/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "474/TALK"    , "narrator": "アーヤ", "text": "そもそも、気を張るのが\n悪いと言ってるわけじゃ\nないのよ。"},
        { "location": "475/TALK"    , "narrator": "アーヤ", "text": "ただ、張り過ぎると\n注意力が散漫になって、\n簡単に足元を――"},
        { "location": "478/TALK"    , "narrator": "ガブリエラ", "text": "うるさいなぁ…。"},
        { "location": "479/TALK"    , "narrator": "アーヤ", "text": "なっ…うるさいって\nなによ！？"},
        { "location": "480/TALK"    , "narrator": "ガブリエラ", "text": "余計なお世話だ、って\n言ってんのよ。"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "そんなのわね、\nアーヤに言われたくても\nわかってるわ。"},
        { "location": "482/TALK"    , "narrator": "アーヤ", "text": "いや、わかってるなら\nどうしてそんなに――"},
        { "location": "484/TALK"    , "narrator": "ガブリエラ", "text": "ピリピリする原因を\n作ってるのは、\nアーヤでしょ？"},
        { "location": "485/TALK"    , "narrator": "ガブリエラ", "text": "ただでさえ落ち着かない\n状況なのに、お説教まで\n追加されたら堪んないわ。"},
        { "location": "486/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "488/TALK"    , "narrator": "ガブリエラ", "text": "あたしのことは、\nもう放っておいて。"},
        { "location": "489/TALK"    , "narrator": "ガブリエラ", "text": "…これ以上、あたしを\nイライラさせないでよ…。"},
        { "location": "494/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "495/TALK"    , "narrator": "アーヤ", "text": "私…余計なこと\nしたのかしら…。"},
        { "location": "496/ACT"     , "narrator": "", "text": "大丈夫、心配ないよ"},
        { "location": "514/TALK"    , "narrator": "アーヤ", "text": "心配よ(>_<)"},
        { "location": "515/TALK"    , "narrator": "アーヤ", "text": "本当にこのままで"},
        { "location": "516/TALK"    , "narrator": "アーヤ", "text": "心配ないと思う？"},
        { "location": "518/SEL"     , "narrator": "", "text": "ガブリエラは愚かじゃない"},
        { "location": "519/ACT"     , "narrator": "", "text": "ガブリエラは愚かじゃない"},
        { "location": "522/TALK"    , "narrator": "アーヤ", "text": "そうね(-.-;)"},
        { "location": "523/TALK"    , "narrator": "アーヤ", "text": "ギャヴィは"},
        { "location": "524/TALK"    , "narrator": "アーヤ", "text": "私が一番信頼する仲間だし"},
        { "location": "525/TALK"    , "narrator": "アーヤ", "text": "わからないはずないわね(｡-_-｡)"},
        { "location": "528/TALK"    , "narrator": "アーヤ", "text": "気づけなかったなんて"},
        { "location": "529/TALK"    , "narrator": "アーヤ", "text": "恥ずかしい(-ω-;)"},
        { "location": "543/TALK"    , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "545/TALK"    , "narrator": "ガブリエラ", "text": "なによ、今度は？"},
        { "location": "546/TALK"    , "narrator": "アーヤ", "text": "ううん…なんか、\n余計なことしたかな、\nって…。"},
        { "location": "547/TALK"    , "narrator": "ガブリエラ", "text": "…え？"},
        { "location": "549/TALK"    , "narrator": "アーヤ", "text": "自分でわかってることを、\n他人に指摘されたら、\n気分悪いわよね？"},
        { "location": "551/TALK"    , "narrator": "アーヤ", "text": "…余計なこと言って\nごめんなさい。\nもう言わないわ。"},
        { "location": "553/TALK"    , "narrator": "ガブリエラ", "text": "な、何よ…。\n急に態度変え過ぎよ？"},
        { "location": "555/TALK"    , "narrator": "アーヤ", "text": "反省したのよ…。\n本当、嫌な気持ちにさせて\nごめんなさい…。"},
        { "location": "556/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "557/TALK"    , "narrator": "ガブリエラ", "text": "別に…謝ることないわよ。\nアーヤは間違ったこと、\n言ってないんだし…。"},
        { "location": "558/TALK"    , "narrator": "アーヤ", "text": "…そうなの？"},
        { "location": "561/TALK"    , "narrator": "ガブリエラ", "text": "そうよ…わかった、\n認めるわ。"},
        { "location": "563/TALK"    , "narrator": "ガブリエラ", "text": "今のあたしは、\nかなりピリピリしてるわ。"},
        { "location": "565/TALK"    , "narrator": "ガブリエラ", "text": "今の状態じゃ、多分…、\n照準がブレて狙った場所に\n当てられないと思う。"},
        { "location": "566/TALK"    , "narrator": "アーヤ", "text": "…そう。"},
        { "location": "567/TALK"    , "narrator": "ガブリエラ", "text": "…呆れた？"},
        { "location": "568/TALK"    , "narrator": "アーヤ", "text": "まさか。話してくれて、\nほっとしたわ。"},
        { "location": "569/TALK"    , "narrator": "ガブリエラ", "text": "それはよかったわね。"},
        { "location": "571/TALK"    , "narrator": "ガブリエラ", "text": "こっちも、正直に話して\n少し気持ちが軽くなった\n気がするわ。"},
        { "location": "572/TALK"    , "narrator": "ガブリエラ", "text": "…でも、きっとすぐに\n元の状態に逆戻りだと\n思うけど。"},
        { "location": "573/TALK"    , "narrator": "アーヤ", "text": "…それだけ、卯月に対して\n怒ってるってことね。"},
        { "location": "574/TALK"    , "narrator": "ガブリエラ", "text": "当然よ…。"},
        { "location": "576/TALK"    , "narrator": "ガブリエラ", "text": "でも…そのせいでこれじゃ、\n何の意味もないわね…。\nかっこわるい…。"},
        { "location": "577/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "579/TALK"    , "narrator": "アーヤ", "text": "わかった…。\nギャヴィ、私にちょっと\n付き合って。"},
        { "location": "581/TALK"    , "narrator": "ガブリエラ", "text": "えっ…どこによ？"},
        { "location": "582/TALK"    , "narrator": "アーヤ", "text": "ふふっ…。\n今のギャヴィに必要な物が\nあるところよ。"},
        { "location": "583/TALK"    , "narrator": "ガブリエラ", "text": "…？"},
        { "location": "598/TALK"    , "narrator": "ウェイトレス", "text": "――それでは、\nごゆっくりどうぞ。"},
        { "location": "602/TALK"    , "narrator": "アーヤ", "text": "さ、ギャヴィ。\n早く食べましょ。"},
        { "location": "603/TALK"    , "narrator": "ガブリエラ", "text": "え、えっと…。"},
        { "location": "604/TALK"    , "narrator": "ガブリエラ", "text": "ごめん、アーヤ…。\nちょっとついてけないん\nだけど…。"},
        { "location": "605/TALK"    , "narrator": "アーヤ", "text": "なにが？"},
        { "location": "606/TALK"    , "narrator": "ガブリエラ", "text": "一体このお店のどこに、\nあたしに必要な物が\nあるっていうのよ？"},
        { "location": "607/TALK"    , "narrator": "アーヤ", "text": "あるじゃない。\nほら、今目の前にあるのが\nそれよ。"},
        { "location": "608/TALK"    , "narrator": "ガブリエラ", "text": "それって、パフェのこと？"},
        { "location": "609/TALK"    , "narrator": "アーヤ", "text": "そうよ。"},
        { "location": "610/TALK"    , "narrator": "アーヤ", "text": "…ギャヴィ。\nあなたはね、とっても\n真面目な子なの。"},
        { "location": "611/TALK"    , "narrator": "アーヤ", "text": "だから今の私達の状況で、\n気を抜くのが悪いこと\nみたいに感じるんじゃない？"},
        { "location": "613/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "614/TALK"    , "narrator": "アーヤ", "text": "気持ちはわかる。\n私も、ギャヴィと同じ\nだから…。"},
        { "location": "615/TALK"    , "narrator": "アーヤ", "text": "でも、気だって休めないと、\nいざって時に引き締める\nこともできなくなるわ。"},
        { "location": "617/TALK"    , "narrator": "ガブリエラ", "text": "…だから？"},
        { "location": "618/TALK"    , "narrator": "アーヤ", "text": "気分を変えろ、ってことよ。\nほら、私のブリュレも\n一口どう？"},
        { "location": "619/TALK"    , "narrator": "ガブリエラ", "text": "えっ、あ、いいから。\n自分で食べれるし！"},
        { "location": "620/TALK"    , "narrator": "アーヤ", "text": "いいから、あーん。"},
        { "location": "621/TALK"    , "narrator": "ガブリエラ", "text": "う…。"},
        { "location": "622/TALK"    , "narrator": "ガブリエラ", "text": "あ、あーん…。"},
        { "location": "623/TALK"    , "narrator": "アーヤ", "text": "…どう、美味しい？"},
        { "location": "625/TALK"    , "narrator": "ガブリエラ", "text": "…ふふっ、ちょっと\nほろ苦くて、大人な味ね。"},
        { "location": "626/TALK"    , "narrator": "アーヤ", "text": "甘いと思ったんだけど…、\n違うの注文すれば\nよかったかしら？"},
        { "location": "627/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ、お返しに\nあたしのパフェも\n一口あげるわ。"},
        { "location": "628/TALK"    , "narrator": "アーヤ", "text": "いいの？\nそれじゃあ遠慮なく…。"},
        { "location": "629/TALK"    , "narrator": "ガブリエラ", "text": "うん…。"},
        { "location": "630/TALK"    , "narrator": "ガブリエラ", "text": "…？\nいや、なにやってるの？"},
        { "location": "631/TALK"    , "narrator": "アーヤ", "text": "なにって、食べさせて\nくれるの待ってるんだけど？"},
        { "location": "632/TALK"    , "narrator": "ガブリエラ", "text": "いや、しないから！\n自分で食べなさいよ！"},
        { "location": "633/TALK"    , "narrator": "アーヤ", "text": "なんでよ？\n私は食べさせてあげたのに。"},
        { "location": "635/TALK"    , "narrator": "ガブリエラ", "text": "アーヤが勝手にやった\nだけでしょ？"},
        { "location": "636/TALK"    , "narrator": "ガブリエラ", "text": "あたしはやらないわよ。\nそんなの、恥ずかしいし…。"},
        { "location": "637/TALK"    , "narrator": "アーヤ", "text": "残念…じゃ、失礼して…。"},
        { "location": "638/TALK"    , "narrator": "アーヤ", "text": "んっ、甘くて美味しい。"},
        { "location": "640/TALK"    , "narrator": "ガブリエラ", "text": "ふふっ…あたしより、\nアーヤの方が楽しんでる\nじゃない…。"},
        { "location": "642/TALK"    , "narrator": "アーヤ", "text": "まあね…やっぱり、\nギャヴィと一緒だと\n楽しいし。"},
        { "location": "643/TALK"    , "narrator": "ガブリエラ", "text": "は、はいはい。\nお世辞はいいから\nさっさと食べるわよ。"},
        { "location": "310/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>9月2日　 6:31 AM</color>\nとある平日の朝、寮「とらいあんぐる」玄関前にて。"},
        { "location": "654/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch02", "text": "【ビター・スイート・スイーツ】"}
    ]
}
