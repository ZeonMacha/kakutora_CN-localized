{
    "dir": "chap29/daydra/dd_ch05_29_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "29505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "ロックアウト作戦＜後編＞"
    },
    "entry":
    [
        { "location": "2782/TALK"  , "narrator": "神楽", "text": "…決めた。\n私は、これを使う！"},
        { "location": "2789/TALK"  , "narrator": "神楽", "text": "どうか、\nなにもありません\nように…。"},
        { "location": "2790/SEL"   , "narrator": "", "text": "神楽！"},
        { "location": "2791/ACT"   , "narrator": "", "text": "神楽！"},
        { "location": "2798/TALK"  , "narrator": "神楽", "text": "ッ！？"},
        { "location": "2799/TALK"  , "narrator": "神楽", "text": "$handle$さん！？"},
        { "location": "2800/TALK"  , "narrator": "神楽", "text": "どうして心の中に\n声が聞こえて…。"},
        { "location": "2801/TALK"  , "narrator": "神楽", "text": "あ、そうか。\nこっちに声を聞かせる\nことができたんだ。"},
        { "location": "2802/TALK"  , "narrator": "神楽", "text": "…でも、スマホが\n使えないことには…。"},
        { "location": "2803/TALK"  , "narrator": "神楽", "text": "私の声を伝えること\nできないし。"},
        { "location": "2804/SEL"   , "narrator": "", "text": "安心していいよ、心の中見えてるから"},
        { "location": "2805/ACT"   , "narrator": "", "text": "安心していいよ、心の中見えてるから"},
        { "location": "2808/TALK"  , "narrator": "神楽", "text": "なるほど。\nそれなら――"},
        { "location": "2812/TALK"  , "narrator": "神楽", "text": "ちょ、マジで！？\n私の心の中\n丸見えなんですか！？"},
        { "location": "2813/SEL"   , "narrator": "", "text": "だから話せてる"},
        { "location": "2814/SEL"   , "narrator": "", "text": "丸見えじゃないよ"},
        { "location": "2815/ACT"   , "narrator": "", "text": "だから話せてる"},
        { "location": "2816/ACT"   , "narrator": "", "text": "丸見えじゃないよ"},
        { "location": "2817/TALK"  , "narrator": "神楽", "text": "見えてるから\n私と話せてるんじゃ\nないですか！"},
        { "location": "2820/TALK"  , "narrator": "神楽", "text": "ああもう、\n$handle$さんの\nバカバカ！！"},
        { "location": "2821/TALK"  , "narrator": "神楽", "text": "私、女子高生ですよ？\n乙女なんですよ！？"},
        { "location": "2823/TALK"  , "narrator": "神楽", "text": "なのに、心の中を\n覗けるだなんて、\nサイテーですよ！！"},
        { "location": "2824/SEL"   , "narrator": "", "text": "そういうシステムだから仕方ないの"},
        { "location": "2825/SEL"   , "narrator": "", "text": "うーん、やっぱりそっちの声は見えづらいな"},
        { "location": "2826/SEL"   , "narrator": "", "text": "プライバシーに関わるところは見ないよ"},
        { "location": "2827/ACT"   , "narrator": "", "text": "そういうシステムだから仕方ないの"},
        { "location": "2828/TALK"  , "narrator": "神楽", "text": "仕方ないで\n納得できるような\nことじゃないから！"},
        { "location": "2829/ACT"   , "narrator": "", "text": "うーん、やっぱりそっちの声は見えづらいな"},
        { "location": "2830/TALK"  , "narrator": "神楽", "text": "それ、すっごい\nウソっぽいですから！"},
        { "location": "2831/TALK"  , "narrator": "神楽", "text": "ウソつくなら\nもっと上手なウソ\nついてくださいよ…。"},
        { "location": "2832/ACT"   , "narrator": "", "text": "プライバシーに関わるところは見ないよ"},
        { "location": "2833/TALK"  , "narrator": "神楽", "text": "つまり、見ようと\n思えば見ることは\n可能なんですか…。"},
        { "location": "2834/TALK"  , "narrator": "神楽", "text": "…エッチ。"},
        { "location": "2836/TALK"  , "narrator": "神楽", "text": "…もういいです。"},
        { "location": "2837/TALK"  , "narrator": "神楽", "text": "今はこんなこと\n言ってる場合じゃ\nありませんし。"},
        { "location": "2838/TALK"  , "narrator": "神楽", "text": "でも、落ち着いたら\n$handle$さんの\n心の内も…。"},
        { "location": "2839/TALK"  , "narrator": "神楽", "text": "全部晒して\nもらいますからね。"},
        { "location": "2840/SEL"   , "narrator": "", "text": "$me$の心を見るの！？"},
        { "location": "2841/ACT"   , "narrator": "", "text": "$me$の心を見るの！？"},
        { "location": "2843/TALK"  , "narrator": "神楽", "text": "そうじゃないと\n対等じゃありません。"},
        { "location": "2845/TALK"  , "narrator": "神楽", "text": "ふふふ～、自白剤とか\n用意しておいた方が\nいいですかねー？"},
        { "location": "2846/SEL"   , "narrator": "", "text": "あの、怖いんですけど？"},
        { "location": "2847/ACT"   , "narrator": "", "text": "あの、怖いんですけど？"},
        { "location": "2849/TALK"  , "narrator": "神楽", "text": "怖いでしょ？\n私、もっと怖いこと\n考えちゃいますよ！"},
        { "location": "2850/TALK"  , "narrator": "神楽", "text": "でも、全部筒抜け\nちゃうから…。"},
        { "location": "2851/TALK"  , "narrator": "神楽", "text": "$handle$さんは\n多分拒絶できないん\nですよね？"},
        { "location": "2852/TALK"  , "narrator": "神楽", "text": "あ、そうだ！"},
        { "location": "2853/TALK"  , "narrator": "神楽", "text": "逃げようとして\n暴れられたら\n困りますし…。"},
        { "location": "2854/TALK"  , "narrator": "神楽", "text": "拘束用の椅子とか\n目隠しなんかも\n必要かも。"},
        { "location": "2855/TALK"  , "narrator": "神楽", "text": "ああいうのって、\n高いんですかね？"},
        { "location": "2856/SEL"   , "narrator": "", "text": "マジで勘弁してください"},
        { "location": "2857/SEL"   , "narrator": "", "text": "拘束されるのはご褒美だね"},
        { "location": "2858/SEL"   , "narrator": "", "text": "ＤＩＹしましょう"},
        { "location": "2859/ACT"   , "narrator": "", "text": "マジで勘弁してください"},
        { "location": "2860/TALK"  , "narrator": "神楽", "text": "んー、\nどうしましょう\nかねー？"},
        { "location": "2861/ACT"   , "narrator": "", "text": "拘束されるのはご褒美だね"},
        { "location": "2863/TALK"  , "narrator": "神楽", "text": "うわ、ヘンタイ…。\nそういう趣味\nあったの？"},
        { "location": "2864/ACT"   , "narrator": "", "text": "ＤＩＹしましょう"},
        { "location": "2865/TALK"  , "narrator": "神楽", "text": "ＤＩＹは楽しいかも\nって思いますけど…。"},
        { "location": "2867/TALK"  , "narrator": "神楽", "text": "どうせだったら\nもっと可愛いモノ\n作りたいんですけど？"},
        { "location": "2869/TALK"  , "narrator": "神楽", "text": "…なんて、\n冗談ですよ、\n冗談です。"},
        { "location": "2870/TALK"  , "narrator": "神楽", "text": "ずっと逢いたくて、\nっていうか逢っては\nいませんけど…。"},
        { "location": "2871/TALK"  , "narrator": "神楽", "text": "話せてとっても\n嬉しくて、\nえーっと…。"},
        { "location": "2873/TALK"  , "narrator": "神楽", "text": "…嬉し過ぎて\n頭が働かなくて…、\n変なこと言ってます？"},
        { "location": "2874/TALK"  , "narrator": "神楽", "text": "でもそれくらい\n嬉しいんです！\nわかってくれました？"},
        { "location": "2876/SEL"   , "narrator": "", "text": "よくわかった。ところで、落ち着いた？"},
        { "location": "2877/ACT"   , "narrator": "", "text": "よくわかった。ところで、落ち着いた？"},
        { "location": "2882/TALK"  , "narrator": "神楽", "text": "なんとか…。"},
        { "location": "2883/SEL"   , "narrator": "", "text": "これからの事を話すから、よく聞いて"},
        { "location": "2884/ACT"   , "narrator": "", "text": "これからの事を話すから、よく聞いて"},
        { "location": "2886/TALK"  , "narrator": "神楽", "text": "お願いします。"},
        { "location": "2887/SEL"   , "narrator": "", "text": "このSIMは、繭が作ったものだけど中身は$me$が用意したもの"},
        { "location": "2888/ACT"   , "narrator": "", "text": "このSIMは、繭が作ったものだけど中身は$me$が用意したもの"},
        { "location": "2891/SEL"   , "narrator": "", "text": "ある意味トロイの木馬だったけど、それは$me$の木馬だったのです！"},
        { "location": "2892/ACT"   , "narrator": "", "text": "ある意味トロイの木馬だったけど、それは$me$の木馬だったのです！"},
        { "location": "2895/TALK"  , "narrator": "神楽", "text": "$handle$さんの\n木馬！？"},
        { "location": "2896/TALK"  , "narrator": "神楽", "text": "その言い方だと、\n色々とよからぬ妄想が\n膨らみそうです…。"},
        { "location": "2897/SEL"   , "narrator": "", "text": "というと？"},
        { "location": "2898/SEL"   , "narrator": "", "text": "それは宝物だから渡せない"},
        { "location": "2899/ACT"   , "narrator": "", "text": "というと？"},
        { "location": "2900/TALK"  , "narrator": "神楽", "text": "なんでもありません！"},
        { "location": "2901/TALK"  , "narrator": "神楽", "text": "いいから話の続きを\nお願いします。"},
        { "location": "2902/ACT"   , "narrator": "", "text": "それは宝物だから渡せない"},
        { "location": "2903/TALK"  , "narrator": "神楽", "text": "あー持ってるんですか\nそうですかー。"},
        { "location": "2904/TALK"  , "narrator": "神楽", "text": "そういう趣味は\n程々にしないと\nダメですよ。"},
        { "location": "2905/TALK"  , "narrator": "神楽", "text": "私以外の人に\nそんな話したら、\nどん引きですよ？"},
        { "location": "2906/TALK"  , "narrator": "神楽", "text": "…話がズレました。\n続きをお願いします。"},
        { "location": "2908/SEL"   , "narrator": "", "text": "まず、自分のスマホを使わずつばめのを借りて、神楽のトライガジェットとペアリングして"},
        { "location": "2909/ACT"   , "narrator": "", "text": "まず、自分のスマホを使わずつばめのを借りて、神楽のトライガジェットとペアリングして"},
        { "location": "2911/TALK"  , "narrator": "神楽", "text": "どうして？\n私のじゃ\nダメなんですか？"},
        { "location": "2912/SEL"   , "narrator": "", "text": "神楽のはエンタングルの支給品でしょ？"},
        { "location": "2913/ACT"   , "narrator": "", "text": "神楽のはエンタングルの支給品でしょ？"},
        { "location": "2915/TALK"  , "narrator": "神楽", "text": "そうですけど…。"},
        { "location": "2916/SEL"   , "narrator": "", "text": "危ないからダメ、つばめのを借りて"},
        { "location": "2917/ACT"   , "narrator": "", "text": "危ないからダメ、つばめのを借りて"},
        { "location": "2919/TALK"  , "narrator": "神楽", "text": "理由はわかりました。"},
        { "location": "2920/TALK"  , "narrator": "神楽", "text": "けど、いきなり\nスマホ貸してって\n言うのは変ですよ。"},
        { "location": "2921/SEL"   , "narrator": "", "text": "つばめを見れば、$me$と繋がりたがってるのわかるでしょ？"},
        { "location": "2922/ACT"   , "narrator": "", "text": "つばめを見れば、$me$と繋がりたがってるのわかるでしょ？"},
        { "location": "2925/SEL"   , "narrator": "", "text": "神楽なら繋げてあげることができる"},
        { "location": "2926/ACT"   , "narrator": "", "text": "神楽なら繋げてあげることができる"},
        { "location": "2929/TALK"  , "narrator": "神楽", "text": "あー、なるほど。\n交換条件ですね。"},
        { "location": "2930/TALK"  , "narrator": "神楽", "text": "でも、つばめさんを\n危険に晒すことなんて\nできません…。"},
        { "location": "2931/SEL"   , "narrator": "", "text": "多分大丈夫。問題有っても$me$が何とかする"},
        { "location": "2932/ACT"   , "narrator": "", "text": "多分大丈夫。問題有っても$me$が何とかする"},
        { "location": "2934/TALK"  , "narrator": "神楽", "text": "多分って…、\n本当に信用して\n大丈夫なんだか…。"},
        { "location": "2935/TALK"  , "narrator": "神楽", "text": "…やっぱり、\n最低限つばめさんの\n同意はとりたいです。"},
        { "location": "2936/SEL"   , "narrator": "", "text": "構わないよ"},
        { "location": "2937/ACT"   , "narrator": "", "text": "構わないよ"},
        { "location": "2940/SEL"   , "narrator": "", "text": "ペアリングしたら、今宵はどのような物語をお望みでしょう？と言って"},
        { "location": "2941/ACT"   , "narrator": "", "text": "ペアリングしたら、今宵はどのような物語をお望みでしょう？と言って"},
        { "location": "2944/SEL"   , "narrator": "", "text": "そしたら$me$は「夜神楽して」と言う"},
        { "location": "2945/ACT"   , "narrator": "", "text": "そしたら$me$は「夜神楽して」と言う"},
        { "location": "2948/SEL"   , "narrator": "", "text": "その後、この前の「高い塔に住む少女の物語」の話をして欲しい"},
        { "location": "2949/ACT"   , "narrator": "", "text": "その後、この前の「高い塔に住む少女の物語」の話をして欲しい"},
        { "location": "2951/TALK"  , "narrator": "神楽", "text": "はい？\nなんでですか？"},
        { "location": "2952/SEL"   , "narrator": "", "text": "量子暗号鍵ってやつです。$me$のなりすましを排除する"},
        { "location": "2953/ACT"   , "narrator": "", "text": "量子暗号鍵ってやつです。$me$のなりすましを排除する"},
        { "location": "2955/TALK"  , "narrator": "神楽", "text": "なるほど、\n要するに…。"},
        { "location": "2956/TALK"  , "narrator": "神楽", "text": "チャットで出てくる\n$handle$さんは…。"},
        { "location": "2957/TALK"  , "narrator": "神楽", "text": "今こうして話してる\nあなたではない\n可能性がある、と？"},
        { "location": "2958/SEL"   , "narrator": "", "text": "そういうこと"},
        { "location": "2959/ACT"   , "narrator": "", "text": "そういうこと"},
        { "location": "2961/TALK"  , "narrator": "神楽", "text": "うーん…、でも、\nそうなった時は\n私の頭の中に――"},
        { "location": "2962/TALK"  , "narrator": "神楽", "text": "違う、って\n言ってくれれば\nいいのでは？"},
        { "location": "2963/SEL"   , "narrator": "", "text": "その瞬間に回線が切断されて言えない状況だったら？"},
        { "location": "2964/ACT"   , "narrator": "", "text": "その瞬間に回線が切断されて言えない状況だったら？"},
        { "location": "2966/TALK"  , "narrator": "神楽", "text": "あ、頼もしい返答！\nちょっとドキッと\nしたかも。"},
        { "location": "2967/TALK"  , "narrator": "神楽", "text": "それ聞けて、\n全て納得しました。\nらじゃーです！"},
        { "location": "2973/TALK"  , "narrator": "つばめ", "text": "はあ…。"},
        { "location": "2975/TALK"  , "narrator": "神楽", "text": "つながらない\nみたいですね。"},
        { "location": "2977/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "2978/TALK"  , "narrator": "つばめ", "text": "あ、そうなのかな。"},
        { "location": "2979/TALK"  , "narrator": "つばめ", "text": "忙しいだけかも\nしれないけど。"},
        { "location": "2980/TALK"  , "narrator": "神楽", "text": "…異なる\n可能性セカイの存在。"},
        { "location": "2982/TALK"  , "narrator": "つばめ", "text": "え？　何？"},
        { "location": "2984/TALK"  , "narrator": "神楽", "text": "いえ別に。\nそれより、つなげ方\n知ってますよ。"},
        { "location": "2985/TALK"  , "narrator": "つばめ", "text": "ほんと？"},
        { "location": "2986/TALK"  , "narrator": "神楽", "text": "ですが、ひとつ\n覚悟してください。"},
        { "location": "2987/TALK"  , "narrator": "神楽", "text": "繋げたら間違いなく\n気づかれます。"},
        { "location": "2988/TALK"  , "narrator": "神楽", "text": "最悪、死期が早まるかも\nしれません。"},
        { "location": "2989/TALK"  , "narrator": "神楽", "text": "それでも\n繋げたいですか？"},
        { "location": "2990/TALK"  , "narrator": "つばめ", "text": "え……。"},
        { "location": "2992/TALK"  , "narrator": "つばめ", "text": "でも、単に忙しくて\n出れないだけかも\nしれないし……。"},
        { "location": "2993/TALK"  , "narrator": "神楽", "text": "…そう思うなら\nその方がいいですよ。"},
        { "location": "2994/TALK"  , "narrator": "神楽", "text": "平和で平凡な\n幸せな世界に\n生きている方が。"},
        { "location": "2996/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "2997/TALK"  , "narrator": "つばめ", "text": "決めた。"},
        { "location": "2998/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんの言うこと\n試すことにする。"},
        { "location": "2999/TALK"  , "narrator": "つばめ", "text": "お願いします。\n繋げてください。"},
        { "location": "3000/TALK"  , "narrator": "神楽", "text": "…いいんですか？"},
        { "location": "3001/TALK"  , "narrator": "つばめ", "text": "うん。"},
        { "location": "3002/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんがそこまで\n言うんだから\n本当なんでしょ？"},
        { "location": "3003/TALK"  , "narrator": "つばめ", "text": "だったらわたし\n$handle$さんと\nお話ししときたい。"},
        { "location": "3004/TALK"  , "narrator": "つばめ", "text": "お話しできないまま\n死んじゃうのは\nイヤだから。"},
        { "location": "3007/TALK"  , "narrator": "神楽", "text": "そう、ですか……。"},
        { "location": "3008/TALK"  , "narrator": "つばめ", "text": "うん。"},
        { "location": "3011/TALK"  , "narrator": "神楽", "text": "…ではひとつ交換条件。"},
        { "location": "3012/TALK"  , "narrator": "神楽", "text": "話し終わったら\n切らないでそのまま\nスマホを貸してください。"},
        { "location": "3013/TALK"  , "narrator": "つばめ", "text": "わかった。"},
        { "location": "3024/TALK"  , "narrator": "神楽", "text": "……。\n完了です。"},
        { "location": "3034/TALK"  , "narrator": "つばめ", "text": "$handle$さん？"},
        { "location": "3036/SEL"   , "narrator": "", "text": "やっと繋がった！"},
        { "location": "3037/SEL"   , "narrator": "", "text": "ずっとメッセージ送ってたのに"},
        { "location": "3038/SEL"   , "narrator": "", "text": "つばめは大丈夫？"},
        { "location": "3039/ACT"   , "narrator": "", "text": "やっと繋がった！"},
        { "location": "3040/TALK"  , "narrator": "つばめ", "text": "え"},
        { "location": "3041/TALK"  , "narrator": "つばめ", "text": "やっぱりそうなの"},
        { "location": "3042/ACT"   , "narrator": "", "text": "ずっとメッセージ送ってたのに"},
        { "location": "3043/TALK"  , "narrator": "つばめ", "text": "そんなの"},
        { "location": "3045/TALK"  , "narrator": "つばめ", "text": "全然届いてないよ"},
        { "location": "3046/ACT"   , "narrator": "", "text": "つばめは大丈夫？"},
        { "location": "3047/TALK"  , "narrator": "つばめ", "text": "平気だよ"},
        { "location": "3048/TALK"  , "narrator": "つばめ", "text": "一応ね"},
        { "location": "3053/SEL"   , "narrator": "", "text": "大変みたいだけど"},
        { "location": "3054/SEL"   , "narrator": "", "text": "話できてよかった"},
        { "location": "3055/SEL"   , "narrator": "", "text": "うれしくて泣きそう"},
        { "location": "3056/ACT"   , "narrator": "", "text": "大変みたいだけど"},
        { "location": "3057/TALK"  , "narrator": "つばめ", "text": "大変だけど"},
        { "location": "3059/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんもいるし"},
        { "location": "3060/ACT"   , "narrator": "", "text": "話できてよかった"},
        { "location": "3061/TALK"  , "narrator": "つばめ", "text": "うん"},
        { "location": "3063/TALK"  , "narrator": "つばめ", "text": "ぁたしも"},
        { "location": "3064/ACT"   , "narrator": "", "text": "うれしくて泣きそう"},
        { "location": "3065/TALK"  , "narrator": "つばめ", "text": "そんなこと言わないで"},
        { "location": "3066/TALK"  , "narrator": "つばめ", "text": "ぁたしも泣いちゃう"},
        { "location": "3068/TALK"  , "narrator": "つばめ", "text": "それでね"},
        { "location": "3069/TALK"  , "narrator": "つばめ", "text": "もしかしたら"},
        { "location": "3070/TALK"  , "narrator": "つばめ", "text": "これが最後のお話になるかもしれないの"},
        { "location": "3072/SEL"   , "narrator": "", "text": "そんなことはさせない"},
        { "location": "3073/SEL"   , "narrator": "", "text": "$me$が助けるから"},
        { "location": "3074/SEL"   , "narrator": "", "text": "それはいやだな…"},
        { "location": "3075/ACT"   , "narrator": "", "text": "そんなことはさせない"},
        { "location": "3076/TALK"  , "narrator": "つばめ", "text": "うん"},
        { "location": "3077/TALK"  , "narrator": "つばめ", "text": "ありがとう"},
        { "location": "3078/ACT"   , "narrator": "", "text": "$me$が助けるから"},
        { "location": "3079/TALK"  , "narrator": "つばめ", "text": "絶対だよ？"},
        { "location": "3080/TALK"  , "narrator": "つばめ", "text": "信じてるから"},
        { "location": "3081/ACT"   , "narrator": "", "text": "それはいやだな…"},
        { "location": "3082/TALK"  , "narrator": "つばめ", "text": "そうだよね"},
        { "location": "3083/TALK"  , "narrator": "つばめ", "text": "わたしもいやだよ"},
        { "location": "3085/TALK"  , "narrator": "つばめ", "text": "こうやって"},
        { "location": "3086/TALK"  , "narrator": "つばめ", "text": "$handle$さんと"},
        { "location": "3087/TALK"  , "narrator": "つばめ", "text": "お話しできて"},
        { "location": "3088/TALK"  , "narrator": "つばめ", "text": "うれしい"},
        { "location": "3090/SEL"   , "narrator": "", "text": "また話そう"},
        { "location": "3091/SEL"   , "narrator": "", "text": "いつだって話せるようになるよ"},
        { "location": "3092/SEL"   , "narrator": "", "text": "$me$もうれしい"},
        { "location": "3093/ACT"   , "narrator": "", "text": "また話そう"},
        { "location": "3094/TALK"  , "narrator": "つばめ", "text": "うん"},
        { "location": "3095/TALK"  , "narrator": "つばめ", "text": "またね"},
        { "location": "3097/TALK"  , "narrator": "つばめ", "text": "絶対だよ"},
        { "location": "3098/ACT"   , "narrator": "", "text": "いつだって話せるようになるよ"},
        { "location": "3099/TALK"  , "narrator": "つばめ", "text": "そうだね"},
        { "location": "3100/TALK"  , "narrator": "つばめ", "text": "いつも"},
        { "location": "3102/TALK"  , "narrator": "つばめ", "text": "お話ししようね"},
        { "location": "3103/ACT"   , "narrator": "", "text": "$me$もうれしい"},
        { "location": "3104/TALK"  , "narrator": "つばめ", "text": "よかった"},
        { "location": "3105/TALK"  , "narrator": "つばめ", "text": "でもわたしのほうが"},
        { "location": "3107/TALK"  , "narrator": "つばめ", "text": "絶対うれしいからね"},
        { "location": "3109/TALK"  , "narrator": "つばめ", "text": "あ"},
        { "location": "3111/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんに"},
        { "location": "3112/TALK"  , "narrator": "つばめ", "text": "代わるね"},
        { "location": "3119/TALK"  , "narrator": "つばめ", "text": "今宵はどのような物語をお望みでしょう？"},
        { "location": "3121/SEL"   , "narrator": "", "text": "は？"},
        { "location": "3122/SEL"   , "narrator": "", "text": "夜神楽して"},
        { "location": "3123/ACT"   , "narrator": "", "text": "は？"},
        { "location": "3125/TALK"  , "narrator": "つばめ", "text": "わからないなら"},
        { "location": "3126/TALK"  , "narrator": "つばめ", "text": "それでいいです"},
        { "location": "3128/SEL"   , "narrator": "", "text": "何の話？"},
        { "location": "3129/SEL"   , "narrator": "", "text": "解説して"},
        { "location": "3130/SEL"   , "narrator": "", "text": "卯月って電波なの？"},
        { "location": "3131/ACT"   , "narrator": "", "text": "何の話？"},
        { "location": "3133/TALK"  , "narrator": "つばめ", "text": "そのうちわかる話です"},
        { "location": "3134/ACT"   , "narrator": "", "text": "解説して"},
        { "location": "3136/TALK"  , "narrator": "つばめ", "text": "まさか"},
        { "location": "3137/TALK"  , "narrator": "つばめ", "text": "それは無理です"},
        { "location": "3138/ACT"   , "narrator": "", "text": "卯月って電波なの？"},
        { "location": "3140/TALK"  , "narrator": "つばめ", "text": "そう思うなら"},
        { "location": "3141/TALK"  , "narrator": "つばめ", "text": "そうなんでしょうね"},
        { "location": "3143/ACT"   , "narrator": "", "text": "夜神楽して"},
        { "location": "3145/TALK"  , "narrator": "つばめ", "text": "なるほど"},
        { "location": "3146/TALK"  , "narrator": "つばめ", "text": "そういうことですか"},
        { "location": "3148/SEL"   , "narrator": "", "text": "何の話？"},
        { "location": "3149/SEL"   , "narrator": "", "text": "解説して"},
        { "location": "3150/SEL"   , "narrator": "", "text": "卯月って電波なの？"},
        { "location": "3151/SEL"   , "narrator": "", "text": "月神楽の話の続きが聞きたい"},
        { "location": "3152/ACT"   , "narrator": "", "text": "何の話？"},
        { "location": "3154/TALK"  , "narrator": "つばめ", "text": "そのうちわかる話です"},
        { "location": "3155/ACT"   , "narrator": "", "text": "解説して"},
        { "location": "3157/TALK"  , "narrator": "つばめ", "text": "まさか"},
        { "location": "3158/TALK"  , "narrator": "つばめ", "text": "それは無理です"},
        { "location": "3159/ACT"   , "narrator": "", "text": "卯月って電波なの？"},
        { "location": "3161/TALK"  , "narrator": "つばめ", "text": "そう思うなら"},
        { "location": "3162/TALK"  , "narrator": "つばめ", "text": "そうなんでしょうね"},
        { "location": "3163/ACT"   , "narrator": "", "text": "月神楽の話の続きが聞きたい"},
        { "location": "3166/TALK"  , "narrator": "つばめ", "text": "わかりました"},
        { "location": "3167/TALK"  , "narrator": "つばめ", "text": "それはどんなお話しでしたか？"},
        { "location": "3169/SEL"   , "narrator": "", "text": "つばめとメルティーズする妄想ＳＳ"},
        { "location": "3170/SEL"   , "narrator": "", "text": "高い塔に住む少女の物語"},
        { "location": "3171/ACT"   , "narrator": "", "text": "つばめとメルティーズする妄想ＳＳ"},
        { "location": "3174/TALK"  , "narrator": "つばめ", "text": "え"},
        { "location": "3175/TALK"  , "narrator": "つばめ", "text": "まあいいです！その手の話ならこのぴょんこにお任せください！"},
        { "location": "3177/TALK"  , "narrator": "つばめ", "text": "では今日はオリジナルメルティーストーリーの第36話を語りましょう"},
        { "location": "3179/TALK"  , "narrator": "つばめ", "text": "タイトルは「つばめ、神楽、愛の巣にて」です"},
        { "location": "3181/SEL"   , "narrator": "", "text": "36話って！？"},
        { "location": "3182/ACT"   , "narrator": "", "text": "36話って！？"},
        { "location": "3185/TALK"  , "narrator": "つばめ", "text": "え！？　オリジナルアニメの妄想設定とかするの普通じゃないですか？"},
        { "location": "3187/SEL"   , "narrator": "", "text": "さすが神楽！"},
        { "location": "3188/SEL"   , "narrator": "", "text": "ふ、ふつう…？"},
        { "location": "3189/ACT"   , "narrator": "", "text": "さすが神楽！"},
        { "location": "3191/TALK"  , "narrator": "つばめ", "text": "ふふーん"},
        { "location": "3194/ACT"   , "narrator": "", "text": "ふ、ふつう…？"},
        { "location": "3196/TALK"  , "narrator": "つばめ", "text": "ノーマルです！！"},
        { "location": "3199/TALK"  , "narrator": "つばめ", "text": "ちなみにこの回のあらすじを簡単に説明すると"},
        { "location": "3200/TALK"  , "narrator": "つばめ", "text": "メルティーに変身できなくなった私を心配したつばめさんが"},
        { "location": "3202/TALK"  , "narrator": "つばめ", "text": "私の愛の力を神楽ちゃんにあ・げ・る"},
        { "location": "3203/TALK"  , "narrator": "つばめ", "text": "って、私の部屋にやってきて"},
        { "location": "3207/SEL"   , "narrator": "", "text": "続きをどうぞ"},
        { "location": "3208/ACT"   , "narrator": "", "text": "続きをどうぞ"},
        { "location": "3211/TALK"  , "narrator": "つばめ", "text": "いえ、ちょっと待ってください、目的変わってないですか？"},
        { "location": "3213/TALK"  , "narrator": "つばめ", "text": "そろそろ認証とやらは終わったんでしょうか？"},
        { "location": "3214/TALK"  , "narrator": "つばめ", "text": "なりすましじゃないって"},
        { "location": "3215/ACT"   , "narrator": "", "text": "高い塔に住む少女の物語"},
        { "location": "3218/TALK"  , "narrator": "つばめ", "text": "わかりました"},
        { "location": "3219/TALK"  , "narrator": "つばめ", "text": "それでは、$handlek$の御希望通りに致しましょう"},
        { "location": "3223/TALK"  , "narrator": "つばめ", "text": "高い塔の上に、その少女はたったひとり、暮らしていました"},
        { "location": "3224/TALK"  , "narrator": "つばめ", "text": "その塔はあまりに高いため"},
        { "location": "3225/TALK"  , "narrator": "つばめ", "text": "少女の元へは、誰も来ることはありませんでした"},
        { "location": "3231/SEL"   , "narrator": "", "text": "もういいよ"},
        { "location": "3233/TALK"  , "narrator": "つばめ", "text": "「あーあ、今日もヒマだなー」"},
        { "location": "3235/TALK"  , "narrator": "つばめ", "text": "少女はその塔にただ１つだけある小さな窓から空を見て、そうつぶやきました。"},
        { "location": "3236/TALK"  , "narrator": "つばめ", "text": "すると、突然まどの外側から、小さな猫が顔を出しました。少女はビックリして、窓際から後ずさります。"},
        { "location": "3237/TALK"  , "narrator": "つばめ", "text": "それを見て、猫はふふっと意地悪そうに笑うと、こう言いました。"},
        { "location": "3239/TALK"  , "narrator": "つばめ", "text": "「心配はいらないよ。$me$は$handle$。君をここから連れ出しに来たんだ」"},
        { "location": "3244/TALK"  , "narrator": "つばめ", "text": "どうですか？"},
        { "location": "3245/TALK"  , "narrator": "つばめ", "text": "これくらいで大丈夫ですか？"},
        { "location": "3247/SEL"   , "narrator": "", "text": "ごめん、聴き入っちゃった。もう大丈夫です、ありがとう"},
        { "location": "3248/ACT"   , "narrator": "", "text": "ごめん、聴き入っちゃった。もう大丈夫です、ありがとう"},
        { "location": "3251/TALK"  , "narrator": "つばめ", "text": "よかった"},
        { "location": "3252/TALK"  , "narrator": "つばめ", "text": "即興でしたけど、楽しんでいただけたなら"},
        { "location": "3253/ACT"   , "narrator": "", "text": "もういいよ"},
        { "location": "3256/TALK"  , "narrator": "つばめ", "text": "そうですか？"},
        { "location": "3258/TALK"  , "narrator": "つばめ", "text": "せっかくラストまで"},
        { "location": "3259/TALK"  , "narrator": "つばめ", "text": "ちゃんと話そうと思ったのに、、、"},
        { "location": "3261/TALK"  , "narrator": "つばめ", "text": "全部終わったら"},
        { "location": "3262/TALK"  , "narrator": "つばめ", "text": "改めてまた聞いてくださいね"},
        { "location": "3265/TALK"  , "narrator": "つばめ", "text": "$handle$さん"},
        { "location": "3266/TALK"  , "narrator": "つばめ", "text": "今の私は$handle$さんに"},
        { "location": "3267/TALK"  , "narrator": "つばめ", "text": "命の全てを預けている状態です"},
        { "location": "3269/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "3270/TALK"  , "narrator": "つばめ", "text": "それが$handle$さんでよかった"},
        { "location": "3272/TALK"  , "narrator": "つばめ", "text": "もう何度も死ぬような目にあってきました"},
        { "location": "3274/TALK"  , "narrator": "つばめ", "text": "私の残機はゼロ"},
        { "location": "3276/TALK"  , "narrator": "つばめ", "text": "今の私は、次が最後だと思って生きているんです"},
        { "location": "3277/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "3279/TALK"  , "narrator": "つばめ", "text": "$handle$さんが一緒なら"},
        { "location": "3280/TALK"  , "narrator": "つばめ", "text": "$handle$さんが一緒に歩んでくれる未来なら"},
        { "location": "3281/TALK"  , "narrator": "つばめ", "text": "その先が例えゲームオーバーだったとしても"},
        { "location": "3282/TALK"  , "narrator": "つばめ", "text": "私にとっては"},
        { "location": "3283/TALK"  , "narrator": "つばめ", "text": "トゥルーエンドだと思ってるから"},
        { "location": "3287/TALK"  , "narrator": "つばめ", "text": "いつも一緒にいてくれてありがとう"},
        { "location": "3299/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "3300/TALK"  , "narrator": "つばめ", "text": "神楽…ちゃん？"},
        { "location": "3301/TALK"  , "narrator": "神楽", "text": "あっ、ごめんなさい。\n大丈夫です。\nそれより――"},
        { "location": "3304/TALK"  , "narrator": "神楽", "text": "先につばめさんに\n謝っておかなくては\nいけないことがあります。"},
        { "location": "3305/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "3310/TALK"  , "narrator": "つばめ", "text": "通信終了"},
        { "location": "3311/TALK"  , "narrator": "つばめ", "text": "切断します"},
        { "location": "3324/TALK"  , "narrator": "つばめ", "text": "ありがとう\n神楽ちゃん。"},
        { "location": "3326/TALK"  , "narrator": "神楽", "text": "いいえ。"},
        { "location": "3330/TALK"  , "narrator": "神楽", "text": "それより、\n先につばめさんに\n謝っておきますね。"},
        { "location": "3331/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "3344/TALK"  , "narrator": "透明神楽", "text": "ごめんなさい。"},
        { "location": "3345/TALK"  , "narrator": "透明神楽", "text": "私はきっと、あなたを\n殺してしまう。"},
        { "location": "3347/TALK"  , "narrator": "透明神楽", "text": "正確には\n「殺させられてしまう」。"},
        { "location": "3348/TALK"  , "narrator": "透明神楽", "text": "ごめんなさい。\nこれを止めることは\nできないんです。"},
        { "location": "3349/TALK"  , "narrator": "透明神楽", "text": "私がどう頑張っても\n止められないんです。"},
        { "location": "3350/TALK"  , "narrator": "透明つばめ", "text": "えと……。\n神楽…ちゃん…？"},
        { "location": "3351/TALK"  , "narrator": "透明神楽", "text": "おかしいことを\n言っているのは\nわかっています。"},
        { "location": "3352/TALK"  , "narrator": "透明神楽", "text": "本当にごめんなさい。"},
        { "location": "3353/TALK"  , "narrator": "透明神楽", "text": "だけど。"},
        { "location": "3354/TALK"  , "narrator": "透明神楽", "text": "私はあなたのことが\n大好きです。"},
        { "location": "3355/TALK"  , "narrator": "透明神楽", "text": "つばめさんのことが\n大好きなんです。"},
        { "location": "3356/TALK"  , "narrator": "透明つばめ", "text": "わたしも。"},
        { "location": "3357/TALK"  , "narrator": "透明つばめ", "text": "神楽ちゃんのことが\n大好きだよ。"},
        { "location": "3358/TALK"  , "narrator": "透明つばめ", "text": "だから――"},
        { "location": "3363/TALK"  , "narrator": "透明神楽", "text": "！"},
        { "location": "3230/DIALOG", "narrator": "INFO", "text": "<color=green>Q-LOCKが認証されました。</color>\n\n<color=red><< C5:000 0x000 >></color>\n卯月神楽のココロスフィアと\nトライガジェットが\n<color=blue>SIM:mayuhina001</color>\nにて再接続されました。"},
        { "location": "3373/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【Mv EXE_MiYABi】"},
        { "location": "3385/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【Mv EXE_MiYABi】"},
        { "location": "3406/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【24 K<size=10>　</size>THE<size=10>　</size>METAL<size=10>　</size>IDOL】"},
        { "location": "3418/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【24 K<size=10>　</size>THE<size=10>　</size>METAL<size=10>　</size>IDOL】"}
    ]
