{
    "dir": "chap25/daydra/dd_ch04_25_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "25452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "襲撃前夜＜みやび編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "襲撃前夜～みやび編～"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "――というわけで、\n館長からいつ連絡が\n来るかわからない。"},
        { "location": "27/TALK"   , "narrator": "アーヤ", "text": "だから、今夜はみんな、\n劇場に泊まってもらうわ。"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "やっぱそうなるかぁ…。\nまあ、しゃあないな。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "それと、外部と連絡を\nする場合は、間違っても\nストの話はしないこと。"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "みんな、いい？"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "りょーかい。"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "わかりました…。"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "言うわけないでしょ？\n機密漏えいに\nなっちゃうし…。"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "うん…それじゃみんな、\nよろしくね。"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "…わたしたち、\nどうなっちゃうんだろ？"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "まったく、情けない声\n出して…頼りないわねぇ。"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "ガブちゃんは\n不安じゃないの？"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "不安に決まってるでしょ？"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "でも、不安だからって\n暗くなってても\n仕方ないじゃない。"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "はぁ…。"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "仕方ないことやけんど、\nみんなピリピリしちょって、\n居心地悪いがよ…。"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "こんなとこに一晩とか、\nストレスで胃が潰れかねん。"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "ちくっと、気分転換でも\nしてくるか…。"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "うち、向こうでちくっと\n考え事してるちや。"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "ふむ…やはり客席の\n座り心地はなかなかやな。"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "ここで座って寝るのも、\n悪くないかもしれん…。"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "…子守歌代わりに、\nつまらん映画でも\n流すか？"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "…相棒か？"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "いや…うさぎか。"},
        { "location": "86/TALK"   , "narrator": "ラビットアニマ", "text": "今よろしいでしょうか？"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "どうかしたのか？"},
        { "location": "91/TALK"   , "narrator": "ラビットアニマ", "text": "夜分にすみません"},
        { "location": "92/TALK"   , "narrator": "ラビットアニマ", "text": "先ほどひなこから連絡があったのですが"},
        { "location": "93/TALK"   , "narrator": "ラビットアニマ", "text": "逢瀬さんとの連絡が取れないようなのです"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "つばめちゃん？"},
        { "location": "96/TALK"   , "narrator": "ラビットアニマ", "text": "はい"},
        { "location": "97/TALK"   , "narrator": "ラビットアニマ", "text": "とても心配をしていて"},
        { "location": "98/TALK"   , "narrator": "ラビットアニマ", "text": "私の方から聞いてほしいと頼まれたもので"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "なるほど"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "安心して良い"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "つばめちゃんならさっき"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "疲れたからもう寝る"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "そう言っていた"},
        { "location": "107/TALK"  , "narrator": "ラビットアニマ", "text": "そうでしたか"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "急用なら部屋に起こしに行くが？"},
        { "location": "110/TALK"  , "narrator": "ラビットアニマ", "text": "いえ"},
        { "location": "111/TALK"  , "narrator": "ラビットアニマ", "text": "逢瀬さんが無事ならばひなこも安心します"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "それはよかった"},
        { "location": "116/TALK"  , "narrator": "ラビットアニマ", "text": "すみません"},
        { "location": "117/TALK"  , "narrator": "ラビットアニマ", "text": "もう一つ聞いてほしいと言われていたのを"},
        { "location": "118/TALK"  , "narrator": "ラビットアニマ", "text": "忘れていました。"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "言ってみよ"},
        { "location": "122/TALK"  , "narrator": "ラビットアニマ", "text": "キリトとヒカルの行方についてです"},
        { "location": "123/TALK"  , "narrator": "ラビットアニマ", "text": "通常攻撃隊の任務で呼び出されてから"},
        { "location": "124/TALK"  , "narrator": "ラビットアニマ", "text": "何日も連絡が取れません"},
        { "location": "126/TALK"  , "narrator": "ラビットアニマ", "text": "みやび先輩がなにか聞いていないか"},
        { "location": "127/TALK"  , "narrator": "ラビットアニマ", "text": "聞いてほしいと言われていました"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "すまんがわからない"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "うちらは通常攻撃隊の話は"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "まったく入ってこなくてな"},
        { "location": "132/TALK"  , "narrator": "ラビットアニマ", "text": "そうでしたか"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "だが"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "キリトくん達はまだ学生"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "任務に駆り出されたとしても"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "一番危険な場所に"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "放り出される可能性は低いだろう"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "なので"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "安心するよう伝えておくぞね"},
        { "location": "142/TALK"  , "narrator": "ラビットアニマ", "text": "ですがみやび先輩"},
        { "location": "143/TALK"  , "narrator": "ラビットアニマ", "text": "最近の管理庁の行動は"},
        { "location": "144/TALK"  , "narrator": "ラビットアニマ", "text": "どうにも予測できません"},
        { "location": "146/TALK"  , "narrator": "ラビットアニマ", "text": "もしかしたら"},
        { "location": "147/TALK"  , "narrator": "ラビットアニマ", "text": "学生の隊員にも"},
        { "location": "148/TALK"  , "narrator": "ラビットアニマ", "text": "危険な任務を任せている"},
        { "location": "149/TALK"  , "narrator": "ラビットアニマ", "text": "そういう可能性もあるのでは？"},
        { "location": "151/TALK"  , "narrator": "ラビットアニマ", "text": "どう思いますか？"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "わからない"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "しかし現状"},
        { "location": "155/TALK"  , "narrator": "みやび", "text": "フェノメノンは出ていない"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "ならば"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "今のところは安心してもよいだろう"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "心配なのはわかるが"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "冷静さを忘れてはいけない"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "無用の心配は"},
        { "location": "163/TALK"  , "narrator": "みやび", "text": "己の判断を鈍らせることになる"},
        { "location": "166/TALK"  , "narrator": "ラビットアニマ", "text": "申し訳ありません"},
        { "location": "167/TALK"  , "narrator": "ラビットアニマ", "text": "ひなこには"},
        { "location": "168/TALK"  , "narrator": "ラビットアニマ", "text": "心配ないと伝えておきます"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "うむ"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "またなにかあれば"},
        { "location": "171/TALK"  , "narrator": "みやび", "text": "いつでも連絡してくるがよい"},
        { "location": "182/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "183/TALK"  , "narrator": "みやび", "text": "ふむ…。"},
        { "location": "184/TALK"  , "narrator": "みやび", "text": "フォローはしといたけんど、\nつばめちゃん、ＷＡＶＥを\n返さんかったか…。"},
        { "location": "186/TALK"  , "narrator": "みやび", "text": "なにかしら、思うところが\nあるんやろうなぁ…。"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "200/TALK"  , "narrator": "みやび", "text": "少し驚いたぞね"},
        { "location": "202/SEL"   , "narrator": "", "text": "なにに驚いたの？"},
        { "location": "203/SEL"   , "narrator": "", "text": "繭のこと？"},
        { "location": "204/ACT"   , "narrator": "", "text": "なにに驚いたの？"},
        { "location": "205/TALK"  , "narrator": "みやび", "text": "うさぎのことだ"},
        { "location": "206/TALK"  , "narrator": "みやび", "text": "気づかなかったのか？"},
        { "location": "207/TALK"  , "narrator": "みやび", "text": "どうせ"},
        { "location": "208/TALK"  , "narrator": "みやび", "text": "うちとの会話"},
        { "location": "209/TALK"  , "narrator": "みやび", "text": "見ていたのだろう？"},
        { "location": "210/ACT"   , "narrator": "", "text": "繭のこと？"},
        { "location": "211/TALK"  , "narrator": "みやび", "text": "その通りだ"},
        { "location": "212/TALK"  , "narrator": "みやび", "text": "相棒も気づいたか？"},
        { "location": "214/TALK"  , "narrator": "みやび", "text": "うさぎはあの性格だが"},
        { "location": "215/TALK"  , "narrator": "みやび", "text": "かなり友達思いなのだ"},
        { "location": "216/TALK"  , "narrator": "みやび", "text": "とはいえ"},
        { "location": "218/TALK"  , "narrator": "みやび", "text": "キリトくんとヒカルくんのことを"},
        { "location": "219/TALK"  , "narrator": "みやび", "text": "冷静さを失うほど"},
        { "location": "220/TALK"  , "narrator": "みやび", "text": "心配しているとは"},
        { "location": "221/TALK"  , "narrator": "みやび", "text": "それくらい"},
        { "location": "222/TALK"  , "narrator": "みやび", "text": "大切ということか"},
        { "location": "226/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "227/TALK"  , "narrator": "みやび", "text": "まさかとは思うが"},
        { "location": "229/TALK"  , "narrator": "みやび", "text": "大切なのは二人ではなく"},
        { "location": "230/TALK"  , "narrator": "みやび", "text": "どちらか片方か？"},
        { "location": "232/SEL"   , "narrator": "", "text": "そうだと嬉しい？"},
        { "location": "233/SEL"   , "narrator": "", "text": "そうだと寂しい？"},
        { "location": "234/SEL"   , "narrator": "", "text": "あはは、まさか！"},
        { "location": "235/ACT"   , "narrator": "", "text": "そうだと嬉しい？"},
        { "location": "236/TALK"  , "narrator": "みやび", "text": "どうだろうか？"},
        { "location": "237/TALK"  , "narrator": "みやび", "text": "応援はする"},
        { "location": "238/TALK"  , "narrator": "みやび", "text": "しかし"},
        { "location": "239/TALK"  , "narrator": "みやび", "text": "所詮は他人の恋路"},
        { "location": "240/TALK"  , "narrator": "みやび", "text": "うちが喜ぶことではない"},
        { "location": "243/TALK"  , "narrator": "みやび", "text": "というか"},
        { "location": "244/TALK"  , "narrator": "みやび", "text": "うさぎが恋とか"},
        { "location": "245/TALK"  , "narrator": "みやび", "text": "リアリティ感じられんな"},
        { "location": "246/TALK"  , "narrator": "みやび", "text": "うちの勘違いやろうし"},
        { "location": "248/TALK"  , "narrator": "みやび", "text": "この話はここまでだ"},
        { "location": "249/ACT"   , "narrator": "", "text": "そうだと寂しい？"},
        { "location": "250/TALK"  , "narrator": "みやび", "text": "寂しいとは？"},
        { "location": "252/SEL"   , "narrator": "", "text": "繭を取られちゃうから"},
        { "location": "253/ACT"   , "narrator": "", "text": "繭を取られちゃうから"},
        { "location": "255/TALK"  , "narrator": "みやび", "text": "取られるとか"},
        { "location": "256/TALK"  , "narrator": "みやび", "text": "思うてないぞね"},
        { "location": "257/TALK"  , "narrator": "みやび", "text": "そもそもうちには"},
        { "location": "258/TALK"  , "narrator": "みやび", "text": "うさぎを独占しようという気持ちなど"},
        { "location": "259/TALK"  , "narrator": "みやび", "text": "皆無だ"},
        { "location": "260/TALK"  , "narrator": "みやび", "text": "しかし"},
        { "location": "261/TALK"  , "narrator": "みやび", "text": "信頼と信用はしている"},
        { "location": "262/TALK"  , "narrator": "みやび", "text": "そして何があろうと"},
        { "location": "263/TALK"  , "narrator": "みやび", "text": "うちらは同士なのだ"},
        { "location": "264/TALK"  , "narrator": "みやび", "text": "例えうさぎに恋人ができようと"},
        { "location": "266/TALK"  , "narrator": "みやび", "text": "その関係は変わらんのだ"},
        { "location": "269/TALK"  , "narrator": "みやび", "text": "しかし不思議だ"},
        { "location": "270/TALK"  , "narrator": "みやび", "text": "うさぎを取られるとうちが寂しくなる"},
        { "location": "271/TALK"  , "narrator": "みやび", "text": "何故そう思うた？"},
        { "location": "272/TALK"  , "narrator": "みやび", "text": "まさかとは思うが"},
        { "location": "273/TALK"  , "narrator": "みやび", "text": "うさぎの話ばかりするから"},
        { "location": "274/TALK"  , "narrator": "みやび", "text": "嫉妬でもしたか？"},
        { "location": "276/SEL"   , "narrator": "", "text": "嫉妬してた"},
        { "location": "277/SEL"   , "narrator": "", "text": "そういうわけじゃない"},
        { "location": "278/ACT"   , "narrator": "", "text": "嫉妬してた"},
        { "location": "279/TALK"  , "narrator": "みやび", "text": "かわいいな"},
        { "location": "280/TALK"  , "narrator": "みやび", "text": "そんな一面があったか"},
        { "location": "281/TALK"  , "narrator": "みやび", "text": "確かに"},
        { "location": "282/TALK"  , "narrator": "みやび", "text": "うさぎのことは特別に思っている"},
        { "location": "283/TALK"  , "narrator": "みやび", "text": "同志であり"},
        { "location": "284/TALK"  , "narrator": "みやび", "text": "ある程度の本音を見せられる相手だからな"},
        { "location": "287/TALK"  , "narrator": "みやび", "text": "だが"},
        { "location": "288/TALK"  , "narrator": "みやび", "text": "一定のラインより先の本音は"},
        { "location": "289/TALK"  , "narrator": "みやび", "text": "うさぎにも見せない"},
        { "location": "290/TALK"  , "narrator": "みやび", "text": "それより先は"},
        { "location": "293/TALK"  , "narrator": "みやび", "text": "一人にしか見せん"},
        { "location": "295/SEL"   , "narrator": "", "text": "それは誰？"},
        { "location": "296/ACT"   , "narrator": "", "text": "それは誰？"},
        { "location": "299/TALK"  , "narrator": "みやび", "text": "ノーコメント"},
        { "location": "300/TALK"  , "narrator": "みやび", "text": "朴念仁には教えん"},
        { "location": "301/ACT"   , "narrator": "", "text": "そういうわけじゃない"},
        { "location": "302/TALK"  , "narrator": "みやび", "text": "本当だろうか？"},
        { "location": "303/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "304/TALK"  , "narrator": "みやび", "text": "相棒はうちのパートナーやし"},
        { "location": "305/TALK"  , "narrator": "みやび", "text": "無闇に疑うのは失礼か"},
        { "location": "306/TALK"  , "narrator": "みやび", "text": "よし"},
        { "location": "307/TALK"  , "narrator": "みやび", "text": "ここは信じてやるぞね"},
        { "location": "314/ACT"   , "narrator": "", "text": "あはは、まさか！"},
        { "location": "315/TALK"  , "narrator": "みやび", "text": "さすがに考え過ぎか？"},
        { "location": "316/TALK"  , "narrator": "みやび", "text": "うさぎが恋愛というのは"},
        { "location": "319/TALK"  , "narrator": "みやび", "text": "ちゅうか"},
        { "location": "320/TALK"  , "narrator": "みやび", "text": "うちとしたことが"},
        { "location": "321/TALK"  , "narrator": "みやび", "text": "一般ＪＫのような話をしてしまった"},
        { "location": "323/TALK"  , "narrator": "みやび", "text": "これは恥ずいぞ！？"},
        { "location": "325/TALK"  , "narrator": "みやび", "text": "退却！！"},
        { "location": "25/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月3日　 5:44 PM</color>\nストライキ開始当日、神楽坂トライナリー楽屋にて"}
    ]
}
