{
    "dir": "chap18/daydra/dd_ch02_18_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "18252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "ゲーセン"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ゲーセン"},
        { "location": "18/TALK"   , "narrator": "アーヤ", "text": "…久しぶりに来たけど、\nあまり変わってないわね。"},
        { "location": "19/TALK"   , "narrator": "アーヤ", "text": "…時間潰しになるような\nゲーム、あるかしら？"},
        { "location": "21/TALK"   , "narrator": "アーヤ", "text": "音ゲーは、隣の小学生に、\n倍以上のスコア出された\nことあったし…。"},
        { "location": "23/TALK"   , "narrator": "アーヤ", "text": "シューティングは、\nどれだけ狙っても\n弾が外れるし…。"},
        { "location": "24/TALK"   , "narrator": "アーヤ", "text": "竹刀型コントローラーの\n剣道ゲームとか、\nどこか作らないかしら？"},
        { "location": "28/TALK"   , "narrator": "アーヤ", "text": "…あっ。"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "何、あのクレーンゲームの\nぬいぐるみ！？"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "凄く可愛い！\n何かしらこれ？\nゲームのキャラ？"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "…でも、クレーンゲームは\n一番苦手だし…。"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "100円くらいなら…。"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "いや、ダメダメ！\n100円でなんて\n絶対無理だから！"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "でも…欲しいなぁ…。"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "悩み中(-ω-;)"},
        { "location": "54/SEL"    , "narrator": "", "text": "大学はどうしたの？"},
        { "location": "55/ACT"    , "narrator": "", "text": "大学はどうしたの？"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "次の講義まで時間あるから"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "時間潰し中"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "久しぶりにゲームセンター(^^"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "可愛いぬいぐるみを見つけたけど"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "取る自信なくて…"},
        { "location": "63/SEL"    , "narrator": "", "text": "腕前の方は？"},
        { "location": "64/ACT"    , "narrator": "", "text": "腕前の方は？"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "取ったことはある"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "けど、沢山お金使うし、取れないこともあるから"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "多分下手かも…(; ;)"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "…そうよ。\n下手なんだから、\nやるだけ無駄よね？"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "諦めて、オークションで\n探した方が安上がりだと\n思うし…。"},
        { "location": "84/TALK"   , "narrator": "キリト", "text": "へぇ、綾水先輩も\nそういうのに\n興味あるんすね。"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "えっ…キリト君！？"},
        { "location": "87/TALK"   , "narrator": "キリト", "text": "代わりに取りますよ。\n俺、ゲーム全般は\n得意なんで。"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "そうじゃなくて、\n学校はどうしたの？"},
        { "location": "89/TALK"   , "narrator": "キリト", "text": "いや、今日は格闘\nゲームの最新作が\n稼働する日だから――"},
        { "location": "90/TALK"   , "narrator": "キリト", "text": "とりあえず、ちょっと\n触ってから学校に\n行こうかな、と…。"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "格闘ゲームかぁ…\nコマンド入力とか、\n絶対無理だわ。"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "でも、そういうのが\n好きだなんて、やっぱり\n男の子だなぁ…。"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "理由はわかったけど、\n午前中からゲームセンター\nなんて、よくないわ。"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "運が悪いと\n補導されちゃうわよ？"},
        { "location": "98/TALK"   , "narrator": "キリト", "text": "じゃあ、急がねぇと！\nどのぬいぐるみが\n欲しいんすか？"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "いいわよ。\nそんな簡単に取れないし。"},
        { "location": "100/TALK"  , "narrator": "キリト", "text": "へへっ、俺を誰だと\n思ってるんすか？"},
        { "location": "101/TALK"  , "narrator": "キリト", "text": "狙った獲物は３００円で\n必ずゲットする男っすよ？"},
        { "location": "102/TALK"  , "narrator": "キリト", "text": "それで、どれっすか？\n教えてくれなきゃ、\n適当に取っちゃいますよ？"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "…あそこのコウモリ。\nタキシード着て、\n赤い蝶ネクタイ付けたの。"},
        { "location": "106/TALK"  , "narrator": "キリト", "text": "おっ、あれって確か、\n何かのアニメキャラ\nっすよね？"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "110/TALK"  , "narrator": "キリト", "text": "知らなかったんすか？\nまあいいけど…。"},
        { "location": "114/TALK"  , "narrator": "キリト", "text": "じゃあ、行きますよ。\n真剣になるんで、\n声掛け厳禁で！"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "そんなこと言っても、\nそう簡単に取れるわけ…。"},
        { "location": "120/TALK"  , "narrator": "キリト", "text": "おっ、ラッキー！\n一発で掴んだぜ。"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "はぁ！？"},
        { "location": "125/TALK"  , "narrator": "キリト", "text": "邪魔な周りのをどかそうと\n思ってたけど――"},
        { "location": "126/TALK"  , "narrator": "キリト", "text": "運よく蝶ネクタイに\n引っかかったんすよ。"},
        { "location": "128/TALK"  , "narrator": "キリト", "text": "よーし、そのまま穴まで\n持っていって…。"},
        { "location": "132/TALK"  , "narrator": "キリト", "text": "よっしゃー！！\nどうだ、一発ゲットだぜ！"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "す、凄いわ！\n一回で取るところ、\n初めて見た！"},
        { "location": "136/TALK"  , "narrator": "キリト", "text": "いやー、ラッキーだった\nだけっすよ。"},
        { "location": "139/TALK"  , "narrator": "キリト", "text": "はい、プレゼント。\n大事にしてやって\nくださいね。"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "本当にいいの？"},
        { "location": "142/TALK"  , "narrator": "キリト", "text": "もちろんっすよ。\n俺が持ってるより、\nそいつも喜びますって。"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "嬉しい！\n大切にするわ。"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "ふふっ、実際に手に取って\n見ると、可愛さ倍増ね。"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "どこに置こうかしら？\nタンスの上…ううん、\n枕元とかでもいいかも。"},
        { "location": "148/TALK"  , "narrator": "キリト", "text": "…なんか、綾水先輩の\nレアな姿見ちまった\n気がするな。"},
        { "location": "149/TALK"  , "narrator": "キリト", "text": "ひなこに知れたら大騒ぎに\nなりそうだし、俺だけの\n胸に仕舞っとくか…。"},
        { "location": "152/TALK"  , "narrator": "キリト", "text": "…って、やべぇ！\n格ゲーコーナー、\n人が集まってきてる！"},
        { "location": "153/SEL"   , "narrator": "", "text": "お礼言わないと"},
        { "location": "154/SEL"   , "narrator": "", "text": "止めなくていいの？"},
        { "location": "158/TALK"  , "narrator": "キリト", "text": "じゃあ、綾水先輩。\n俺は戻りますね。"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "わかったわ。\n頑張って勝ってね。"},
        { "location": "160/TALK"  , "narrator": "キリト", "text": "へへっ、余裕っすよ！"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "あっ、ちょっと待って！"},
        { "location": "167/TALK"  , "narrator": "キリト", "text": "は、はい！？"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "言い忘れてたわ。\n取ってくれてありがと。"},
        { "location": "169/TALK"  , "narrator": "キリト", "text": "あ、ああ、いいっすよ。\nお安い御用っすから。"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "ふふっ…それじゃあ、\nまた劇場でね。"},
        { "location": "173/TALK"  , "narrator": "キリト", "text": "…………。"},
        { "location": "174/TALK"  , "narrator": "キリト", "text": "綾水先輩って、\n変なところで\n抜けてるよなぁ…。"},
        { "location": "175/TALK"  , "narrator": "キリト", "text": "まあ、いいか。\nとりあえずもう一戦だ！"},
        { "location": "177/ACT"   , "narrator": "", "text": "お礼言わないと"},
        { "location": "198/TALK"  , "narrator": "アーヤ", "text": "忘れてた！"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "待って、キリト君！"},
        { "location": "212/TALK"  , "narrator": "キリト", "text": "は、はい！？"},
        { "location": "213/TALK"  , "narrator": "アーヤ", "text": "嬉しくて言い忘れてたわ。"},
        { "location": "215/TALK"  , "narrator": "アーヤ", "text": "これ、取ってくれて\nありがとう。"},
        { "location": "216/TALK"  , "narrator": "キリト", "text": "あ、ああ、いいっすよ。\nお安い御用っすから。"},
        { "location": "217/TALK"  , "narrator": "アーヤ", "text": "ふふっ…それじゃあ、\nまた劇場でね。"},
        { "location": "220/TALK"  , "narrator": "キリト", "text": "…………。"},
        { "location": "221/TALK"  , "narrator": "キリト", "text": "綾水先輩って、\n変なところで\n抜けてるよなぁ…。"},
        { "location": "222/TALK"  , "narrator": "キリト", "text": "まあ、いいか。\nとりあえずもう一戦だ！"},
        { "location": "223/ACT"   , "narrator": "", "text": "止めなくていいの？"},
        { "location": "245/TALK"  , "narrator": "アーヤ", "text": "止めるって、何を？"},
        { "location": "256/TALK"  , "narrator": "アーヤ", "text": "…あっ！！"},
        { "location": "259/TALK"  , "narrator": "アーヤ", "text": "キリト君！\n学校行かなきゃダメよ！"},
        { "location": "260/TALK"  , "narrator": "キリト", "text": "げっ…覚えてましたか…。"},
        { "location": "261/TALK"  , "narrator": "アーヤ", "text": "当たり前じゃない。"},
        { "location": "262/TALK"  , "narrator": "アーヤ", "text": "本当はすっかり忘れて\nたんだけど…。"},
        { "location": "263/TALK"  , "narrator": "アーヤ", "text": "さあ、学園に戻りましょ。"},
        { "location": "264/TALK"  , "narrator": "キリト", "text": "いや、でもゲームが…。"},
        { "location": "265/TALK"  , "narrator": "アーヤ", "text": "放課後にまた来れば\nいいでしょ？"},
        { "location": "266/TALK"  , "narrator": "アーヤ", "text": "それなら補導される\n心配もないし。"},
        { "location": "267/TALK"  , "narrator": "キリト", "text": "せ、せめてあと一回！\nあと一回だけ…。"},
        { "location": "268/TALK"  , "narrator": "アーヤ", "text": "行列出来てるから、\n並んでたら午後の授業に\n間に合わなくなるわ。"},
        { "location": "269/TALK"  , "narrator": "アーヤ", "text": "さあ、行きましょ。"},
        { "location": "270/TALK"  , "narrator": "キリト", "text": "あ、あと一回だけー！"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月21日　11:22 AM</color>\nとある平日の午前、某アミューズメントスポットにて。"}
    ]
}
