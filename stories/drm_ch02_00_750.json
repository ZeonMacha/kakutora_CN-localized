        { "location": "134/SCENARIO", "narrator": "", "text": "660_酔い覚まし"},
        { "location": "159/TALK"    , "narrator": "アーヤ", "text": "昨日は本当にごめんなさい"},
        { "location": "160/TALK"    , "narrator": "アーヤ", "text": "反省しています"},
        { "location": "162/SEL"     , "narrator": "", "text": "びっくりしたよ"},
        { "location": "163/SEL"     , "narrator": "", "text": "気にしてないから"},
        { "location": "164/SEL"     , "narrator": "", "text": "別れるのが一番つらいから"},
        { "location": "165/ACT"     , "narrator": "", "text": "びっくりしたよ"},
        { "location": "166/TALK"    , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "168/TALK"    , "narrator": "アーヤ", "text": "自分でもちょっと"},
        { "location": "169/TALK"    , "narrator": "アーヤ", "text": "びっくりしたわ"},
        { "location": "170/ACT"     , "narrator": "", "text": "気にしてないから"},
        { "location": "171/TALK"    , "narrator": "アーヤ", "text": "そう・・・？"},
        { "location": "172/TALK"    , "narrator": "アーヤ", "text": "貴方は優しいから"},
        { "location": "173/TALK"    , "narrator": "アーヤ", "text": "そう言ってくれるのね"},
        { "location": "174/ACT"     , "narrator": "", "text": "別れるのが一番つらいから"},
        { "location": "184/TALK"    , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "185/TALK"    , "narrator": "アーヤ", "text": "本当にそう"},
        { "location": "186/TALK"    , "narrator": "アーヤ", "text": "莫迦だったわ"},
        { "location": "188/TALK"    , "narrator": "アーヤ", "text": "あの"},
        { "location": "189/TALK"    , "narrator": "アーヤ", "text": "こんな私だけど"},
        { "location": "190/TALK"    , "narrator": "アーヤ", "text": "まだ彼女だって"},
        { "location": "191/TALK"    , "narrator": "アーヤ", "text": "思ってくれてる？"},
        { "location": "194/SEL"     , "narrator": "", "text": "当たり前でしょ"},
        { "location": "195/SEL"     , "narrator": "", "text": "わざわざ聞くの？"},
        { "location": "196/SEL"     , "narrator": "", "text": "こっちこそ$me$でいいの？"},
        { "location": "197/ACT"     , "narrator": "", "text": "当たり前でしょ"},
        { "location": "198/TALK"    , "narrator": "アーヤ", "text": "うん"},
        { "location": "199/TALK"    , "narrator": "アーヤ", "text": "そうなのね"},
        { "location": "200/TALK"    , "narrator": "アーヤ", "text": "よかった"},
        { "location": "201/ACT"     , "narrator": "", "text": "わざわざ聞くの？"},
        { "location": "202/TALK"    , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "203/TALK"    , "narrator": "アーヤ", "text": "だって"},
        { "location": "204/TALK"    , "narrator": "アーヤ", "text": "ね？"},
        { "location": "205/ACT"     , "narrator": "", "text": "こっちこそ$me$でいいの？"},
        { "location": "206/TALK"    , "narrator": "アーヤ", "text": "もちろん"},
        { "location": "207/TALK"    , "narrator": "アーヤ", "text": "当たり前でしょ"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "そんなの"},
        { "location": "210/TALK"    , "narrator": "アーヤ", "text": "ね"},
        { "location": "211/TALK"    , "narrator": "アーヤ", "text": "ボイスメッセージ"},
        { "location": "212/TALK"    , "narrator": "アーヤ", "text": "送ってもいい？"},
        { "location": "215/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "216/SEL"     , "narrator": "", "text": "今？"},
        { "location": "217/SEL"     , "narrator": "", "text": "アーヤの声が聞きたい"},
        { "location": "218/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "219/TALK"    , "narrator": "アーヤ", "text": "よかった"},
        { "location": "220/ACT"     , "narrator": "", "text": "今？"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "うん"},
        { "location": "222/TALK"    , "narrator": "アーヤ", "text": "送るわね"},
        { "location": "223/ACT"     , "narrator": "", "text": "アーヤの声が聞きたい"},
        { "location": "224/TALK"    , "narrator": "アーヤ", "text": "私も"},
        { "location": "225/TALK"    , "narrator": "アーヤ", "text": "少しだけ話したい"},
        { "location": "229/TALK"    , "narrator": "ボイスメール", "text": "ミツバチよりも小さな声で"},
        { "location": "180/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
