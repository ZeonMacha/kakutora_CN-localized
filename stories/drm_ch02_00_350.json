    "entry":
    [
        { "location": "202/SCENARIO", "narrator": "", "text": "280_それって、どういうこと？"},
        { "location": "227/TALK"    , "narrator": "アーヤ", "text": "$handle$さん"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "いる？"},
        { "location": "230/SEL"     , "narrator": "", "text": "いるけど……"},
        { "location": "231/SEL"     , "narrator": "", "text": "いません"},
        { "location": "232/SEL"     , "narrator": "", "text": "何か用？"},
        { "location": "233/ACT"     , "narrator": "", "text": "いるけど……"},
        { "location": "234/TALK"    , "narrator": "アーヤ", "text": "こんばんは"},
        { "location": "235/ACT"     , "narrator": "", "text": "いません"},
        { "location": "236/TALK"    , "narrator": "アーヤ", "text": "いるんでしょ？"},
        { "location": "237/ACT"     , "narrator": "", "text": "何か用？"},
        { "location": "238/TALK"    , "narrator": "アーヤ", "text": "用っていうか、、、"},
        { "location": "240/TALK"    , "narrator": "アーヤ", "text": "この前、大学の子たちと飲み会に行くって言ったけど"},
        { "location": "241/TALK"    , "narrator": "アーヤ", "text": "結局やめたの"},
        { "location": "243/SEL"     , "narrator": "", "text": "行けばよかったのに"},
        { "location": "244/SEL"     , "narrator": "", "text": "そんな話したっけ"},
        { "location": "245/SEL"     , "narrator": "", "text": "体調悪いの？"},
        { "location": "246/ACT"     , "narrator": "", "text": "行けばよかったのに"},
        { "location": "247/TALK"    , "narrator": "アーヤ", "text": "そうかもね"},
        { "location": "249/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "250/TALK"    , "narrator": "アーヤ", "text": "ちゃんと約束したわけでもなかったし"},
        { "location": "251/ACT"     , "narrator": "", "text": "そんな話したっけ"},
        { "location": "252/TALK"    , "narrator": "アーヤ", "text": "憶えてない振りとか"},
        { "location": "253/TALK"    , "narrator": "アーヤ", "text": "酷いのね（｀皿´ )"},
        { "location": "263/ACT"     , "narrator": "", "text": "体調悪いの？"},
        { "location": "273/TALK"    , "narrator": "アーヤ", "text": "ううん"},
        { "location": "274/TALK"    , "narrator": "アーヤ", "text": "そういうわけじゃない"},
        { "location": "275/TALK"    , "narrator": "アーヤ", "text": "けど"},
        { "location": "277/TALK"    , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "278/TALK"    , "narrator": "アーヤ", "text": "$handle$さんのことが"},
        { "location": "279/TALK"    , "narrator": "アーヤ", "text": "気になったから"},
        { "location": "281/SEL"     , "narrator": "", "text": "喜んでいいの？"},
        { "location": "282/SEL"     , "narrator": "", "text": "本気で言ってる？"},
        { "location": "283/ACT"     , "narrator": "", "text": "喜んでいいの？"},
        { "location": "284/TALK"    , "narrator": "アーヤ", "text": "どういう意味で？"},
        { "location": "287/ACT"     , "narrator": "", "text": "本気で言ってる？"},
        { "location": "288/TALK"    , "narrator": "アーヤ", "text": "本気、って？"},
        { "location": "293/SEL"     , "narrator": "", "text": "$me$はアーヤのこと好きなんだけど"},
        { "location": "294/SEL"     , "narrator": "", "text": "アーヤの彼氏は$me$だって"},
        { "location": "295/SEL"     , "narrator": "", "text": "$me$に気があるんだよね"},
        { "location": "296/ACT"     , "narrator": "", "text": "$me$はアーヤのこと好きなんだけど"},
        { "location": "297/TALK"    , "narrator": "アーヤ", "text": "ホントに"},
        { "location": "298/TALK"    , "narrator": "アーヤ", "text": "そればっかりね"},
        { "location": "300/TALK"    , "narrator": "アーヤ", "text": "$handle$さんは"},
        { "location": "301/ACT"     , "narrator": "", "text": "アーヤの彼氏は$me$だって"},
        { "location": "302/TALK"    , "narrator": "アーヤ", "text": "なんで"},
        { "location": "303/TALK"    , "narrator": "アーヤ", "text": "そう思えるのかしらね"},
        { "location": "305/TALK"    , "narrator": "アーヤ", "text": "会ったこともないのに"},
        { "location": "306/ACT"     , "narrator": "", "text": "$me$に気があるんだよね"},
        { "location": "307/TALK"    , "narrator": "アーヤ", "text": "ものすごく"},
        { "location": "308/TALK"    , "narrator": "アーヤ", "text": "楽天家ね"},
        { "location": "310/TALK"    , "narrator": "アーヤ", "text": "$handle$さんは"},
        { "location": "312/TALK"    , "narrator": "アーヤ", "text": "言わないとわからない？"},
        { "location": "315/TALK"    , "narrator": "ボイスメール", "text": "約束と束縛"},
        { "location": "269/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>800pt.</b></color></size>\nアップしました！"},
        { "location": "327/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【約束と束縛】</color>\nをゲットしました！"}
    ]
}
