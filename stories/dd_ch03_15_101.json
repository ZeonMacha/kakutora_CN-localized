{
    "dir": "chap15/daydra/dd_ch03_15_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "15302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "話せない理由＜前編＞"
    },
    "entry":
    [
        { "location": "31/TALK"   , "narrator": "キリト", "text": "…本当、ビックリする\nくらい客が来ないな？"},
        { "location": "34/TALK"   , "narrator": "キリト", "text": "もう劇場開けてから\nどれくらい経ったっけか？"},
        { "location": "36/TALK"   , "narrator": "ヒカル", "text": "えっと…二時間かな？\n結構経っちゃったね。"},
        { "location": "37/TALK"   , "narrator": "キリト", "text": "最初の上映が\n終わっちまったぞ？"},
        { "location": "39/TALK"   , "narrator": "キリト", "text": "みやび先輩っぽく\n言うなら――"},
        { "location": "40/TALK"   , "narrator": "キリト", "text": "まっこと潰れんのは\nバックにおるお国様の\nおかげちやぞね？"},
        { "location": "41/TALK"   , "narrator": "ヒカル", "text": "ちょっと違う気も\nするけど、確かに\n言いそうだね。"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "44/TALK"   , "narrator": "キリト", "text": "腹減ったなぁ…。\nバイト終わったら、\n何か食って帰るか？"},
        { "location": "46/TALK"   , "narrator": "ヒカル", "text": "キリトはバイトの日は\n必ず外食だよね。\n使い過ぎじゃない？"},
        { "location": "48/TALK"   , "narrator": "キリト", "text": "バッカ、食わなきゃ\n力出ねぇだろ？\n必要な投資だよ。"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "50/SEL"    , "narrator": "", "text": "居辛そうだね"},
        { "location": "51/ACT"    , "narrator": "", "text": "居辛そうだね"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "居辛そう？"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "それって、私が、ってことかしら？"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "だとしたら、それは考え違いよ"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "私は全然居辛いなんて思っていないから"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "本当よ？"},
        { "location": "76/SEL"    , "narrator": "", "text": "他の子達はいないの？"},
        { "location": "77/ACT"    , "narrator": "", "text": "他の子達はいないの？"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "繭とみやびがいるわ"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "フィルム室でフィルム整理をしてるから"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "邪魔をしたらダメよ？"},
        { "location": "83/SEL"    , "narrator": "", "text": "みやび、呼んであげようか？"},
        { "location": "84/ACT"    , "narrator": "", "text": "みやび、呼んであげようか？"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "だから、余計なことはしないでって言ってるでしょ"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "平気だから"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "それに"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "ここはもう三人もいて、人も足りてるし"},
        { "location": "91/SEL"    , "narrator": "", "text": "じゃあ、ガブリエラが行く？"},
        { "location": "92/ACT"    , "narrator": "", "text": "じゃあ、ガブリエラが行く？"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "何でそうなっちゃうのよ？"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "今日の私は、売店を担当することになってるんだから"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "仕事の邪魔になるようなことを言わないでほしいわ"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "わかった？"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "…$marzanna$ったら。\n気遣ってくれるのは\nいいんだけど……"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "もう少し、\n気遣った言い方は\nできないのかしらね？"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "112/TALK"  , "narrator": "キリト", "text": "？　どうかしたか？"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "117/TALK"  , "narrator": "キリト", "text": "？　何でもないなら\nいいんだけどさ。"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "…ビックリした。\n急に話しかけるなんて\n思わなかったわ…。"},
        { "location": "122/TALK"  , "narrator": "キリト", "text": "なあ、ガブリエラ。\n前から聞きたかったん\nだけどさ――"},
        { "location": "123/TALK"  , "narrator": "キリト", "text": "もしかして、\n俺たちなにか\nヤバイことしてる？"},
        { "location": "125/TALK"  , "narrator": "ヒカル", "text": "キリト、どうして\nそんなこと聞くの？"},
        { "location": "127/TALK"  , "narrator": "キリト", "text": "いや、なんとなく\n前から思ってたん\nだけどさ…。"},
        { "location": "128/TALK"  , "narrator": "キリト", "text": "ガブリエラって、\n俺達といる時だと\n変に緊張してるし――"},
        { "location": "129/TALK"  , "narrator": "キリト", "text": "ぶっちゃけ、\n普通に話したことも\nないだろ？"},
        { "location": "131/TALK"  , "narrator": "ヒカル", "text": "そ、それは…。"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "ど、どうしよう…。\n疑われても\n仕方はないけど――"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "別に、怖いと思ってる\nわけじゃないのに…。"},
        { "location": "136/TALK"  , "narrator": "ヒカル", "text": "…そう思うんなら、\nそんな聞き方したら\n逆効果だと思うよ？"},
        { "location": "137/TALK"  , "narrator": "キリト", "text": "あ、そうだよな…。"},
        { "location": "139/TALK"  , "narrator": "キリト", "text": "いや、でもそうなると\nなんて聞けばいいのか\nわかんねぇし。"},
        { "location": "140/TALK"  , "narrator": "ヒカル", "text": "うーん…例えば、\nもう少し言い方を\n丸くするとか――"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "どうしたらいいのかしら？"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "私のせいで、二人に変な気を使わせてしまってるわ"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "キリトには"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "変な誤解までされちゃってるし"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "お願いよ、$marzanna$"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "アドバイスをちょうだい"},
        { "location": "160/SEL"   , "narrator": "", "text": "返事すればいいのでは？"},
        { "location": "161/ACT"   , "narrator": "", "text": "返事すればいいのでは？"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "それができないから\nこうして相談してるん\nでしょ？"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "できるなら"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "私だってこんなに辛くないわ・・・"},
        { "location": "168/SEL"   , "narrator": "", "text": "そもそも、何で喋れないの？"},
        { "location": "169/ACT"   , "narrator": "", "text": "そもそも、何で喋れないの？"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "174/SEL"   , "narrator": "", "text": "男性恐怖症？"},
        { "location": "175/SEL"   , "narrator": "", "text": "潔癖症？"},
        { "location": "176/SEL"   , "narrator": "", "text": "心因性失声症？"},
        { "location": "177/ACT"   , "narrator": "", "text": "男性恐怖症？"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "そういうのじゃないの！"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "もしそうなら"},
        { "location": "182/TALK"  , "narrator": "ガブリエラ", "text": "今みたいに一緒にいられないでしょ？"},
        { "location": "183/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$の勘違いよ"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$に聞いたのが間違いだったかも"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "今の話忘れていいわ"},
        { "location": "190/ACT"   , "narrator": "", "text": "潔癖症？"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "あのね"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "人と話せないほどのレベルだと"},
        { "location": "194/TALK"  , "narrator": "ガブリエラ", "text": "もう潔癖症とは別物だと思うわ"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "それに"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "もし本当に潔癖症なら"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "つばめ達とも話せないはずでしょ？"},
        { "location": "198/TALK"  , "narrator": "ガブリエラ", "text": "だから間違いよ"},
        { "location": "201/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$に聞いたのが間違いだったかも"},
        { "location": "202/TALK"  , "narrator": "ガブリエラ", "text": "今の話忘れていいわ"},
        { "location": "205/ACT"   , "narrator": "", "text": "心因性失声症？"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "違うから"},
        { "location": "222/TALK"  , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "223/TALK"  , "narrator": "ガブリエラ", "text": "そうじゃなくて"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "だからね"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "病気ってわけじゃなくて"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "だからね"},
        { "location": "331/TALK"  , "narrator": "アーヤ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "334/TALK"  , "narrator": "アーヤ", "text": "また会えたわね。"},
        { "location": "337/SEL"   , "narrator": "", "text": "なんでアーヤがいるの！？"},
        { "location": "338/ACT"   , "narrator": "", "text": "なんでアーヤがいるの！？"},
        { "location": "340/TALK"  , "narrator": "アーヤ", "text": "ビックリしたでしょ？"},
        { "location": "341/TALK"  , "narrator": "アーヤ", "text": "ココロの中でもみんなと\n親睦を深めようと思って、\n回ってみることにしたの。"},
        { "location": "342/TALK"  , "narrator": "アーヤ", "text": "せっかく\n行き来できるように\nなったんだしね。"},
        { "location": "343/SEL"   , "narrator": "", "text": "ココロの中って行き来出来るの！？"},
        { "location": "344/ACT"   , "narrator": "", "text": "ココロの中って行き来出来るの！？"},
        { "location": "346/TALK"  , "narrator": "アーヤ", "text": "実は私も驚いてる。"},
        { "location": "347/TALK"  , "narrator": "アーヤ", "text": "いつの間にか、\n普通に行き来できるように\nなっていたのよね。"},
        { "location": "348/TALK"  , "narrator": "アーヤ", "text": "とはいっても、\n[ココロゲート]まで\nみたいだけど。"},
        { "location": "349/TALK"  , "narrator": "アーヤ", "text": "だから今回は、みんなの\n[ココロゲート]にお邪魔\nしようかと思ってる。"},
        { "location": "350/TALK"  , "narrator": "アーヤ", "text": "よろしくね。"},
        { "location": "351/SEL"   , "narrator": "", "text": "なんか不思議な感じ"},
        { "location": "352/SEL"   , "narrator": "", "text": "なんか怖い"},
        { "location": "353/ACT"   , "narrator": "", "text": "なんか不思議な感じ"},
        { "location": "354/TALK"  , "narrator": "アーヤ", "text": "ほんとね。\n$chrname$の心の中に私が\nいるのはちょっと変かも。"},
        { "location": "355/ACT"   , "narrator": "", "text": "なんか怖い"},
        { "location": "356/TALK"  , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "357/TALK"  , "narrator": "アーヤ", "text": "まあ確かに、他の人の\n心の中を侵蝕している\nようにも見えるけど。"},
        { "location": "358/TALK"  , "narrator": "アーヤ", "text": "でも、扉の外はパブリック\nスペースだから、\nプライバシーは守られる。"},
        { "location": "359/TALK"  , "narrator": "アーヤ", "text": "私も最初はちょっと\n怖かったけど、そんな感じ\nだから心配しないで。"},
        { "location": "379/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、ちょっとちょっと！"},
        { "location": "381/TALK"  , "narrator": "アーヤ", "text": "あら、ギャヴィ。\nいらっしゃい。"},
        { "location": "382/TALK"  , "narrator": "ガブリエラ", "text": "「いらっしゃい」じゃ\nないわよ。ここ、あたしの\n[ココロゲート]なんだけど。"},
        { "location": "383/TALK"  , "narrator": "アーヤ", "text": "ええ、わかってるわよ。\nお邪魔してるわ。"},
        { "location": "384/TALK"  , "narrator": "アーヤ", "text": "せっかくだから、たまには\nココロの中でも親睦を\n図ろうと思って。"},
        { "location": "385/TALK"  , "narrator": "ガブリエラ", "text": "ふーん。\nまあいいけど。"},
        { "location": "386/TALK"  , "narrator": "ガブリエラ", "text": "でも、ココロの中で\n親睦図るより、現実の\n行動を改善して欲しいわ。"},
        { "location": "387/SEL"   , "narrator": "", "text": "ガブリエラ辛辣じゃない？"},
        { "location": "388/SEL"   , "narrator": "", "text": "そういえば、前のココロゲートでも……"},
        { "location": "389/ACT"   , "narrator": "", "text": "ガブリエラ辛辣じゃない？"},
        { "location": "391/TALK"  , "narrator": "ガブリエラ", "text": "感じていることを\nそのまま言ってるだけよ。"},
        { "location": "392/TALK"  , "narrator": "ガブリエラ", "text": "前にも言ったけど、\nあたしにとってアーヤは\n好きと嫌いが混ざってる。"},
        { "location": "393/TALK"  , "narrator": "ガブリエラ", "text": "とっても複雑なのよ。"},
        { "location": "394/ACT"   , "narrator": "", "text": "そういえば、前のココロゲートでも……"},
        { "location": "397/TALK"  , "narrator": "ガブリエラ", "text": "あら、\n覚えていてくれたのね。\n嬉しい。"},
        { "location": "398/TALK"  , "narrator": "ガブリエラ", "text": "そうなのよ。\nあたしにとってアーヤは\n好きと嫌いが混ざってる。"},
        { "location": "399/TALK"  , "narrator": "ガブリエラ", "text": "とっても複雑なの。"},
        { "location": "401/TALK"  , "narrator": "アーヤ", "text": "そうだったのね。\nそれじゃせっかくだから\nその改善点を聞かせて？"},
        { "location": "403/TALK"  , "narrator": "ガブリエラ", "text": "え！？"},
        { "location": "404/TALK"  , "narrator": "アーヤ", "text": "私が自分のココロに戻った\n後で、ちゃんとココロ会議\nして検討するから。"},
        { "location": "405/TALK"  , "narrator": "ガブリエラ", "text": "そ、そんなの\n自分で考えなさいよね。"},
        { "location": "406/TALK"  , "narrator": "アーヤ", "text": "それはやぶさかじゃ\nないけど、私結構鈍いから\n時間かかりそうで。"},
        { "location": "407/TALK"  , "narrator": "アーヤ", "text": "そうすると、私にとっても\nギャヴィにとっても、\nいいこと無いでしょ？"},
        { "location": "408/TALK"  , "narrator": "アーヤ", "text": "だから、ギャヴィと私が\n更に深い関係になる為にも\n教えて？"},
        { "location": "409/TALK"  , "narrator": "ガブリエラ", "text": "だ、だから！"},
        { "location": "410/TALK"  , "narrator": "アーヤ", "text": "お・ね・が・い♪"},
        { "location": "411/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "412/TALK"  , "narrator": "ガブリエラ", "text": "わ、わかったわよ！\nでも、言ったことで\n落ち込んだりしないでよ？"},
        { "location": "413/TALK"  , "narrator": "ガブリエラ", "text": "そんな事になったら、\nあたしの方が\nショックだし……。"},
        { "location": "414/TALK"  , "narrator": "アーヤ", "text": "お気遣いありがとう、\nギャヴィ。"},
        { "location": "415/TALK"  , "narrator": "ガブリエラ", "text": "べ、別にあんたに気を\n遣ったわけじゃないわよ。\n自分が嫌なだけなの！"},
        { "location": "416/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ言うけど。\nアーヤには自分の考えって\nものが無いのよ。"},
        { "location": "417/TALK"  , "narrator": "ガブリエラ", "text": "いつだって周りばっかり\n気にして、周りがこう\nだからって理由で決める。"},
        { "location": "419/TALK"  , "narrator": "ガブリエラ", "text": "たまには自分がこうしたい\nっていう理由で、物事を\n決めてみたら？"},
        { "location": "420/TALK"  , "narrator": "ガブリエラ", "text": "そんなだから、\nあんな理由で剣道を\n辞めちゃうんじゃない。"},
        { "location": "421/TALK"  , "narrator": "アーヤ", "text": "……そっか。\nそうよね。"},
        { "location": "422/SEL"   , "narrator": "", "text": "辞めた「理由」が問題なの？"},
        { "location": "423/SEL"   , "narrator": "", "text": "いつものココロの司書と違う？"},
        { "location": "424/ACT"   , "narrator": "", "text": "辞めた「理由」が問題なの？"},
        { "location": "426/TALK"  , "narrator": "ガブリエラ", "text": "そうよ。\n理由が問題なのよ。"},
        { "location": "427/TALK"  , "narrator": "ガブリエラ", "text": "別に、どんな事があっても\n辞めるな、とか言ってる\nわけじゃないわ。"},
        { "location": "428/ACT"   , "narrator": "", "text": "いつものココロの司書と違う？"},
        { "location": "430/TALK"  , "narrator": "ガブリエラ", "text": "一緒よ！"},
        { "location": "431/TALK"  , "narrator": "ガブリエラ", "text": "前にも言ったとおり、\nつばめに対しては\n特別なの、あたしは。"},
        { "location": "434/TALK"  , "narrator": "ガブリエラ", "text": "はい、ヒントは\nここまで。\nあとは自分で考えなさい。"},
        { "location": "435/TALK"  , "narrator": "アーヤ", "text": "ありがと、ギャヴィ。\n言いたいことは\nよくわかった。"},
        { "location": "436/TALK"  , "narrator": "アーヤ", "text": "現実の私がその事に\n気づくかはわからないけど\nココロの中で会議するわ。"},
        { "location": "437/SEL"   , "narrator": "", "text": "剣道をやめた理由って何なの？"},
        { "location": "438/ACT"   , "narrator": "", "text": "剣道をやめた理由って何なの？"},
        { "location": "441/TALK"  , "narrator": "ガブリエラ", "text": "それは\nアーヤに聞きなさい？"},
        { "location": "443/TALK"  , "narrator": "アーヤ", "text": "そういえば、まだ\n$handle$さんには\nお話してなかったわね。"},
        { "location": "444/TALK"  , "narrator": "アーヤ", "text": "またいずれ、機会があれば\nお話するわね。"},
        { "location": "446/TALK"  , "narrator": "アーヤ", "text": "ギャヴィもありがと。"},
        { "location": "448/TALK"  , "narrator": "ガブリエラ", "text": "だから、\nアーヤの為に\n言ったわけじゃ――"},
        { "location": "449/TALK"  , "narrator": "アーヤ", "text": "そうやっていつも\n私のこと想ってくれてる\nギャヴィが好きよ？"},
        { "location": "450/TALK"  , "narrator": "ガブリエラ", "text": "…っ！？"},
        { "location": "452/TALK"  , "narrator": "ガブリエラ", "text": "ひ、卑怯よ…。\nこんな時に、\nそんな事言うなんて……。"},
        { "location": "453/TALK"  , "narrator": "ガブリエラ", "text": "あーもう！\nアーヤのせいで、司書の\n仕事ができないじゃない！"},
        { "location": "454/SEL"   , "narrator": "", "text": "お仕事の続きをお願いします"},
        { "location": "455/ACT"   , "narrator": "", "text": "お仕事の続きをお願いします"},
        { "location": "457/TALK"  , "narrator": "アーヤ", "text": "ええ。\n気にせず仕事して？"},
        { "location": "458/TALK"  , "narrator": "ガブリエラ", "text": "あんたがそれ言う？\nもう親睦は図ったでしょ？\n自分のココロに戻ったら？"},
        { "location": "459/TALK"  , "narrator": "アーヤ", "text": "そうね。\nでもギャヴィがお仕事する\n所を見てからにするわ。"},
        { "location": "462/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…？\nもう、好きにすれば？"},
        { "location": "469/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x221番地から\n0xFCE番地へ。"},
        { "location": "483/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了。"},
        { "location": "485/TALK"  , "narrator": "ガブリエラ", "text": "それで？\n今回の問題は……"},
        { "location": "487/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "488/TALK"  , "narrator": "ガブリエラ", "text": "………。"},
        { "location": "489/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、ちょっと\n何よこれ！！"},
        { "location": "491/TALK"  , "narrator": "ガブリエラ", "text": "$handle$、\nどうしようっっ！"},
        { "location": "492/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "493/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "495/TALK"  , "narrator": "ガブリエラ", "text": "えっと、それがっ！"},
        { "location": "496/TALK"  , "narrator": "ガブリエラ", "text": "$handle$に\n解決して欲しい事が\n$handle$の事で…"},
        { "location": "497/TALK"  , "narrator": "ガブリエラ", "text": "って、これって\nどう考えても\n仕様バグじゃないの！？"},
        { "location": "498/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ、\n落ち着いて？"},
        { "location": "500/TALK"  , "narrator": "ガブリエラ", "text": "う、うるさいわね。\n落ち着いてるわよ。"},
        { "location": "503/TALK"  , "narrator": "ガブリエラ", "text": "なんでよりによって\nアーヤがいる時に\nこんな悩みが……"},
        { "location": "504/TALK"  , "narrator": "ガブリエラ", "text": "まるであたしが\n全然仕事できない子\nみたいじゃない……"},
        { "location": "505/TALK"  , "narrator": "ガブリエラ", "text": "それにしても困ったわ。\n$handle$のことを\n$handle$に相談？"},
        { "location": "506/TALK"  , "narrator": "ガブリエラ", "text": "そもそも言うか言わないか\n迷ってるのに、聞いたら\n言ってるのと同じよね？"},
        { "location": "507/TALK"  , "narrator": "ガブリエラ", "text": "はぁ、そんなの\n$handle$に\n聞けるわけ――"},
        { "location": "508/SEL"   , "narrator": "", "text": "ちゃんと公正にジャッジするから教えて？"},
        { "location": "509/SEL"   , "narrator": "", "text": "言わなくていいよ。ギャヴィの為なら戦えるから"},
        { "location": "510/ACT"   , "narrator": "", "text": "ちゃんと公正にジャッジするから教えて？"},
        { "location": "514/TALK"  , "narrator": "ガブリエラ", "text": "……うーん。\n$handle$のことは\n信頼してるけど、でも……"},
        { "location": "516/TALK"  , "narrator": "アーヤ", "text": "相談、乗りましょうか？"},
        { "location": "518/TALK"  , "narrator": "ガブリエラ", "text": "結構よ！"},
        { "location": "519/SEL"   , "narrator": "", "text": "乗ってもらうといいと思うよ？"},
        { "location": "520/SEL"   , "narrator": "", "text": "そうとも、これはガブリエラと$me$の問題だ！"},
        { "location": "521/ACT"   , "narrator": "", "text": "乗ってもらうといいと思うよ？"},
        { "location": "522/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "523/TALK"  , "narrator": "ガブリエラ", "text": "わ、わかったわよ。"},
        { "location": "524/TALK"  , "narrator": "ガブリエラ", "text": "$handle$が\nどうしてもアーヤと相談\nしろって言うからなのよ？"},
        { "location": "525/TALK"  , "narrator": "アーヤ", "text": "はいはい。\nわかってるから。"},
        { "location": "526/ACT"   , "narrator": "", "text": "そうとも、これはガブリエラと$me$の問題だ！"},
        { "location": "528/TALK"  , "narrator": "ガブリエラ", "text": "え…ええええっ！？\nいや、まあ、\n確かにそうだけど……"},
        { "location": "529/TALK"  , "narrator": "ガブリエラ", "text": "でもやっぱり今回は……"},
        { "location": "530/TALK"  , "narrator": "アーヤ", "text": "ねえ、ギャヴィ。\nそれじゃこうしない？"},
        { "location": "531/TALK"  , "narrator": "アーヤ", "text": "ギャヴィは本当は一人で\n解決できたけど、無理矢理\n私が聞き出そうとする。"},
        { "location": "532/TALK"  , "narrator": "アーヤ", "text": "だから仕方なく、\n相談する。みたいな。"},
        { "location": "534/TALK"  , "narrator": "ガブリエラ", "text": "…そ、そうよ！"},
        { "location": "535/TALK"  , "narrator": "ガブリエラ", "text": "アーヤが勝手にあたしの\n事に首を突っ込んで\nお節介焼いてるのよね。"},
        { "location": "536/TALK"  , "narrator": "ガブリエラ", "text": "それじゃもう\n相談に乗ってもらうしか\nないじゃない。"},
        { "location": "538/TALK"  , "narrator": "アーヤ", "text": "ふふ、そうね。\nそれでいいんじゃない？"},
        { "location": "539/TALK"  , "narrator": "ガブリエラ", "text": "ま、全く……。\n本当にしょうがないわね。"},
        { "location": "542/TALK"  , "narrator": "アーヤ", "text": "それじゃ、\nちょっとだけ席を\n外してもらってもいい？"},
        { "location": "544/TALK"  , "narrator": "ガブリエラ", "text": "ごめんね？\nすぐに終わるから。"},
        { "location": "562/TALK"  , "narrator": "ガブリエラ", "text": "というわけで、\n結論が出たわ。"},
        { "location": "564/TALK"  , "narrator": "ガブリエラ", "text": "ちゃんと\n$handle$に\n話すことにした。"},
        { "location": "566/TALK"  , "narrator": "ガブリエラ", "text": "でも、気分を害したら\nごめんなさい。"},
        { "location": "567/TALK"  , "narrator": "ガブリエラ", "text": "あたしは\n$handle$のこと\nとっても好きなのよ？"},
        { "location": "568/TALK"  , "narrator": "ガブリエラ", "text": "でも、結論は\n総意で出さなくちゃ\nいけないから……。"},
        { "location": "569/SEL"   , "narrator": "", "text": "わかってるよ、心配しないで？"},
        { "location": "570/ACT"   , "narrator": "", "text": "わかってるよ、心配しないで？"},
        { "location": "573/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう。"},
        { "location": "574/TALK"  , "narrator": "ガブリエラ", "text": "総意としても、\n信頼していないという\nわけじゃないの。"},
        { "location": "575/TALK"  , "narrator": "ガブリエラ", "text": "でも、この話をするのは\nアーヤ以外では\n初めてだから……。"},
        { "location": "576/TALK"  , "narrator": "ガブリエラ", "text": "あたしが男の子と話せない\n本当の理由のこと\nなんだけど……"},
        { "location": "577/TALK"  , "narrator": "ガブリエラ", "text": "残念だけど、今回は\n触りだけしか話さないって\nことになってるの。"},
        { "location": "578/TALK"  , "narrator": "ガブリエラ", "text": "でもそれは、話したくない\nわけじゃなくて、あたしが\n臆病なだけなのよ。"},
        { "location": "579/TALK"  , "narrator": "ガブリエラ", "text": "だから、\nガッカリしないで？"},
        { "location": "580/SEL"   , "narrator": "", "text": "そうか、残念…"},
        { "location": "581/SEL"   , "narrator": "", "text": "正直に言ってくれてありがとう"},
        { "location": "582/ACT"   , "narrator": "", "text": "そうか、残念…"},
        { "location": "583/TALK"  , "narrator": "ガブリエラ", "text": "あ、でも！\nいつか必ず、お話し\nしたいと思ってるから！"},
        { "location": "584/TALK"  , "narrator": "ガブリエラ", "text": "だから、あたしのこと\n嫌いにならないで…。"},
        { "location": "585/SEL"   , "narrator": "", "text": "ならないよ！"},
        { "location": "586/SEL"   , "narrator": "", "text": "どうかなぁ…"},
        { "location": "587/ACT"   , "narrator": "", "text": "ならないよ！"},
        { "location": "589/TALK"  , "narrator": "ガブリエラ", "text": "ほんと！？\nよかった♪"},
        { "location": "590/ACT"   , "narrator": "", "text": "どうかなぁ…"},
        { "location": "591/TALK"  , "narrator": "ガブリエラ", "text": "……ぇ。"},
        { "location": "592/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、そうよね。\n先の事なんて誰にも\nわからないんだもの。"},
        { "location": "593/TALK"  , "narrator": "ガブリエラ", "text": "無理なこと言っちゃって\nごめんなさいね。"},
        { "location": "595/ACT"   , "narrator": "", "text": "正直に言ってくれてありがとう"},
        { "location": "596/TALK"  , "narrator": "ガブリエラ", "text": "ええっ！？\nそこってお礼を言う\nところなの？"},
        { "location": "598/TALK"  , "narrator": "ガブリエラ", "text": "$handle$って\n本当に紳士なのね。"},
        { "location": "600/TALK"  , "narrator": "ガブリエラ", "text": "やっぱりあたしの目に\n狂いは無かったわ！"},
        { "location": "602/ACT"   , "narrator": "", "text": "言わなくていいよ。ギャヴィの為なら戦えるから"},
        { "location": "606/TALK"  , "narrator": "ガブリエラ", "text": "え！？\nなにそれ！？"},
        { "location": "607/TALK"  , "narrator": "ガブリエラ", "text": "ど、どうしよう。\nちょっとかなりキュンと\n来ちゃうんだけど……"},
        { "location": "609/TALK"  , "narrator": "アーヤ", "text": "流石は\n$handle$さんね。"},
        { "location": "610/TALK"  , "narrator": "アーヤ", "text": "本当にギャヴィのことを\n思ってくれてるのね。\nありがとう。"},
        { "location": "612/TALK"  , "narrator": "アーヤ", "text": "ギャヴィも\nお言葉に甘えたら？"},
        { "location": "614/TALK"  , "narrator": "ガブリエラ", "text": "…そ、そうね。\nそうしようかしら。"},
        { "location": "616/TALK"  , "narrator": "ガブリエラ", "text": "ご、ごめんなさいね、\n$handle$。\nでもすごく助かったわ。"},
        { "location": "618/TALK"  , "narrator": "ガブリエラ", "text": "いつか必ず打ち明けられる\n時が来たら、ちゃんと\nお話するから。"},
        { "location": "619/TALK"  , "narrator": "ガブリエラ", "text": "それまで待っててくれると\n嬉しかったりするかも。"},
        { "location": "620/SEL"   , "narrator": "", "text": "もちろん！"},
        { "location": "621/ACT"   , "narrator": "", "text": "もちろん！"},
        { "location": "624/TALK"  , "narrator": "ガブリエラ", "text": "えへへ。ありがと。"},
        { "location": "626/TALK"  , "narrator": "ガブリエラ", "text": "さて、それじゃ今回も\n張り切って行くわよ！"},
        { "location": "628/TALK"  , "narrator": "アーヤ", "text": "ギャヴィと\n$handle$さんに\n素敵なココロの旅を！"},
        { "location": "630/TALK"  , "narrator": "ガブリエラ", "text": "ちょっ！\nそれあたしのセリ――"},
        { "location": "642/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "643/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい。\nなんだか急に\nやりたくなっちゃって。"},
        { "location": "644/TALK"  , "narrator": "ガブリエラ", "text": "まあ、別にいいけど。"},
        { "location": "645/TALK"  , "narrator": "ガブリエラ", "text": "それより……"},
        { "location": "646/TALK"  , "narrator": "アーヤ", "text": "ん？"},
        { "location": "648/TALK"  , "narrator": "ガブリエラ", "text": "こ、今回はありがと。\n色々助かったわ……"},
        { "location": "649/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "663/TALK"  , "narrator": "千羽鶴", "text": "ちーは見た。"},
        { "location": "666/TALK"  , "narrator": "千羽鶴", "text": "どーん！"},
        { "location": "667/SEL"   , "narrator": "", "text": "な、なにをです？"},
        { "location": "668/ACT"   , "narrator": "", "text": "な、なにをです？"},
        { "location": "670/TALK"  , "narrator": "千羽鶴", "text": "貴方は確かに言ったの。"},
        { "location": "671/TALK"  , "narrator": "千羽鶴", "text": "『言わなくていいよ！\n（キリッ』と。"},
        { "location": "672/TALK"  , "narrator": "千羽鶴", "text": "そして、ガブリエラと\nアーヤにべた褒めされた。"},
        { "location": "673/TALK"  , "narrator": "千羽鶴", "text": "けどその後、\n別の可能性世界で\n『教えて？』って言った。"},
        { "location": "674/SEL"   , "narrator": "", "text": "……で？"},
        { "location": "675/ACT"   , "narrator": "", "text": "……で？"},
        { "location": "677/TALK"  , "narrator": "千羽鶴", "text": "別に。"},
        { "location": "678/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラにも、\nアーヤにも、全く悪影響は\n及ぼさない。"},
        { "location": "679/TALK"  , "narrator": "千羽鶴", "text": "ましてや、貴方と彼女の\n未来にも影響せず、バッド\nエンドフラグも立たない。"},
        { "location": "680/TALK"  , "narrator": "千羽鶴", "text": "だから、貴方は全然\n間違った事はしていない。\nただ――"},
        { "location": "681/TALK"  , "narrator": "千羽鶴", "text": "私は見てたから。\n別に何もしないし、\n何の感情も無いけど。"},
        { "location": "682/TALK"  , "narrator": "千羽鶴", "text": "ちーちゃんラブ２ゲームが\nクリア不可能になったりも\nしないから安心して。"},
        { "location": "683/TALK"  , "narrator": "千羽鶴", "text": "ただ、私は見ていた。\nそれを言いたかっただけ。"},
        { "location": "684/SEL"   , "narrator": "", "text": "よかった！"},
        { "location": "685/SEL"   , "narrator": "", "text": "なんか怖い"},
        { "location": "686/ACT"   , "narrator": "", "text": "よかった！"},
        { "location": "687/TALK"  , "narrator": "千羽鶴", "text": "ええ、ほんとに。"},
        { "location": "688/ACT"   , "narrator": "", "text": "なんか怖い"},
        { "location": "690/TALK"  , "narrator": "千羽鶴", "text": "ニヤリ。"},
        { "location": "691/TALK"  , "narrator": "千羽鶴", "text": "まあ、撹乱情報によって\nプチ不安になるくらいの\n事はあってもいいと思う。"},
        { "location": "692/TALK"  , "narrator": "千羽鶴", "text": "結局は単なる\n言葉遊びでしか\n無いんだけど。"},
        { "location": "693/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "694/TALK"  , "narrator": "千羽鶴", "text": "どうせこの考えも\n見えているんでしょう？"},
        { "location": "16/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月20日　18:01 PM</color>\nとある平日の放課後、神楽坂トライナリー劇場でのバイト中のこと。"},
        { "location": "212/DIALOG", "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "260/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "262/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "264/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "266/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "268/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
