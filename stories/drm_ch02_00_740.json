    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "650_答えがないなら"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "全部やめることにしまｓ"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "だって"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "いつまｄも"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "待てないわ"},
        { "location": "38/SEL"    , "narrator": "", "text": "アーヤ？"},
        { "location": "39/SEL"    , "narrator": "", "text": "酔ってるの？"},
        { "location": "40/SEL"    , "narrator": "", "text": "辛いことでもあった？"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "待ったら"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "かわｒなら"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "待てるけど"},
        { "location": "46/ACT"    , "narrator": "", "text": "アーヤ？"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "もういいわ"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "貴方のために作ったものは"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "ｚんぶ捨てたから"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "じゃあね"},
        { "location": "60/ACT"    , "narrator": "", "text": "酔ってるの？"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "ｓおね"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "酔ってるわ"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "でもそんなの関係ないし"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "もう"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "バイバイ"},
        { "location": "76/ACT"    , "narrator": "", "text": "辛いことでもあった？"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "あったわ"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "ううん"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "ずっと辛いの"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "貴方に会えることって"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "できるのあ？"},
        { "location": "94/SEL"    , "narrator": "", "text": "できるよ"},
        { "location": "95/SEL"    , "narrator": "", "text": "もうちょっと待って"},
        { "location": "96/SEL"    , "narrator": "", "text": "無理かも"},
        { "location": "97/ACT"    , "narrator": "", "text": "できるよ"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "適当なことばっかり"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "言わないで"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "そいううの辛すぎる"},
        { "location": "101/ACT"   , "narrator": "", "text": "もうちょっと待って"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "そんなこと言って"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "いつまで待てばいいのか"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "わからないじゃない"},
        { "location": "105/ACT"   , "narrator": "", "text": "無理かも"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "ずっと"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "そうだったわよね"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "だから"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "もう"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "貴方の者は全部捨てたの"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "好きだから"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "辛すぎて"},
        { "location": "82/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
    ]
}
