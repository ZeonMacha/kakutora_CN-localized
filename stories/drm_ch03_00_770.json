        "title": "らぶとーく 第79話",
        "sub_title": "おとぎ話の幕切れは"
    },
    "entry":
    [
        { "location": "27/TALK"   , "narrator": "エリカ", "text": "コーンコン。\nエリカです。"},
        { "location": "28/SEL"    , "narrator": "", "text": "ビックリした！"},
        { "location": "29/ACT"    , "narrator": "", "text": "ビックリした！"},
        { "location": "31/TALK"   , "narrator": "エリカ", "text": "ああっ、ごめんね？\n急に出てきちゃって。"},
        { "location": "33/TALK"   , "narrator": "エリカ", "text": "今回あなたとつばめちゃんに\nとって、とても重要な局面を\n迎えるでしょう？"},
        { "location": "35/TALK"   , "narrator": "エリカ", "text": "今回あなたと綾ちゃんに\nとって、とても重要な局面を\n迎えるでしょう？"},
        { "location": "37/TALK"   , "narrator": "エリカ", "text": "今回あなたとガブリエラ\nちゃんにとって、とても\n重要な局面を迎えるでしょ？"},
        { "location": "39/TALK"   , "narrator": "エリカ", "text": "今回あなたとみやびちゃんに\nとって、とても重要な局面を\n迎えるでしょう？"},
        { "location": "41/TALK"   , "narrator": "エリカ", "text": "だから、ギリギリで\nちょっと心許なくは\nあるんだけど――"},
        { "location": "42/TALK"   , "narrator": "エリカ", "text": "わたしからひとつ、\nふたりにプレゼントが\nあるの！"},
        { "location": "43/SEL"    , "narrator": "", "text": "ありがとう！！　なんだろう？"},
        { "location": "44/SEL"    , "narrator": "", "text": "もしかしてニャボッ……"},
        { "location": "45/ACT"    , "narrator": "", "text": "ありがとう！！　なんだろう？"},
        { "location": "46/TALK"   , "narrator": "エリカ", "text": "えへへ。\n喜んでもらえると\nいいんだけど。"},
        { "location": "47/TALK"   , "narrator": "エリカ", "text": "それじゃ、\nプレゼントしまーす！"},
        { "location": "48/ACT"    , "narrator": "", "text": "もしかしてニャボッ……"},
        { "location": "49/TALK"   , "narrator": "エリカ", "text": "ちがうよぉ……。\nあれはまだ未完成だもん。"},
        { "location": "50/TALK"   , "narrator": "エリカ", "text": "でも、興味あるようなら、\n完成したらあなたにも\n教えるね！"},
        { "location": "51/TALK"   , "narrator": "エリカ", "text": "それでね、\n今回のわたしからの\nプレゼントというのは――"},
        { "location": "52/TALK"   , "narrator": "エリカ", "text": "じゃーん！\nこれでーす！"},
        { "location": "56/SEL"    , "narrator": "", "text": "直接お話できるってこと！？"},
        { "location": "57/ACT"    , "narrator": "", "text": "直接お話できるってこと！？"},
        { "location": "59/TALK"   , "narrator": "エリカ", "text": "その通りだよ！"},
        { "location": "60/TALK"   , "narrator": "エリカ", "text": "でも、ちょっと\nプログラムが間に合わなくて\n完全なものじゃないんだ。"},
        { "location": "61/TALK"   , "narrator": "エリカ", "text": "だから、今回は\nこの先３回だけの限定\n利用にさせて欲しいの。"},
        { "location": "62/TALK"   , "narrator": "エリカ", "text": "けど、今のわたしたちの\nように、ちゃんと向かい\n合ってお話できるから！"},
        { "location": "64/TALK"   , "narrator": "エリカ", "text": "だから、頑張って\nつばめちゃんと素敵な\n思い出を作ってきてね！"},
        { "location": "65/TALK"   , "narrator": "エリカ", "text": "あなたと\nつばめちゃんに\n素敵なココロの旅を！"},
        { "location": "67/TALK"   , "narrator": "エリカ", "text": "だから、頑張って\n綾ちゃんと素敵な\n思い出を作ってきてね！"},
        { "location": "68/TALK"   , "narrator": "エリカ", "text": "あなたと\n綾ちゃんに\n素敵なココロの旅を！"},
        { "location": "70/TALK"   , "narrator": "エリカ", "text": "だから、頑張って\nガブリエラちゃんと素敵な\n思い出を作ってきてね！"},
        { "location": "71/TALK"   , "narrator": "エリカ", "text": "あなたと\nガブリエラちゃんに\n素敵なココロの旅を！"},
        { "location": "73/TALK"   , "narrator": "エリカ", "text": "だから、頑張って\nみやびちゃんと素敵な\n思い出を作ってきてね！"},
        { "location": "74/TALK"   , "narrator": "エリカ", "text": "あなたと\nみやびちゃんに\n素敵なココロの旅を！"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "ねえ$handle$。"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "あたし不満に\n思っている\nことがあるのよ。"},
        { "location": "107/SEL"   , "narrator": "", "text": "$me$はガブリエラに\n不満なんてないよ"},
        { "location": "108/SEL"   , "narrator": "", "text": "お腹が空いてるの？"},
        { "location": "109/SEL"   , "narrator": "", "text": "眠くなっちゃったかな？"},
        { "location": "110/SEL"   , "narrator": "", "text": "$me$何かした？"},
        { "location": "111/SEL"   , "narrator": "", "text": "不満の根源は\n駆逐しよう"},
        { "location": "112/ACT"   , "narrator": "", "text": "$me$はガブリエラに\n不満なんてないよ"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？\n本当に？"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "って、そんな話じゃ\nないのよ。"},
        { "location": "115/ACT"   , "narrator": "", "text": "お腹が空いてるの？"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "なんでそうなるの！？"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "違うから！"},
        { "location": "118/ACT"   , "narrator": "", "text": "眠くなっちゃったかな？"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "すぐにあたしを\n子供扱い\nするんだから！"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "あたしはもう\n中学生なの！"},
        { "location": "121/ACT"   , "narrator": "", "text": "$me$何かした？"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "……えっと…\nまあそうなんだ\nけど……。"},
        { "location": "123/ACT"   , "narrator": "", "text": "不満の根源は\n駆逐しよう"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "そんなこと\nしなくていいわよ！？"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "あたしが寂しく\nなっちゃうし……。"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "えっとね、その…。"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "この前王子様に\nなってくれたでしょ？"},
        { "location": "129/SEL"   , "narrator": "", "text": "キスしたってこと？"},
        { "location": "130/SEL"   , "narrator": "", "text": "本当は$me$も姫だけど"},
        { "location": "131/SEL"   , "narrator": "", "text": "眠り足りないのかな\nお姫様は"},
        { "location": "132/SEL"   , "narrator": "", "text": "またしよう！"},
        { "location": "133/ACT"   , "narrator": "", "text": "キスしたってこと？"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "！？！？！？！？"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "…そうだけど……。"},
        { "location": "137/ACT"   , "narrator": "", "text": "本当は$me$も姫だけど"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "そうだったわね…。"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "そういえば…。"},
        { "location": "140/ACT"   , "narrator": "", "text": "眠り足りないのかな\nお姫様は"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "違うわよ。"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "でもそういうこと\nなのかしら……。"},
        { "location": "143/ACT"   , "narrator": "", "text": "またしよう！"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "えっえっ！？"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "もうちょっと\nロマンチックに\n言ってちょうだい！"},
        { "location": "148/TALK"  , "narrator": "ガブリエラ", "text": "それでその時は\n納得したけど。"},
        { "location": "149/TALK"  , "narrator": "ガブリエラ", "text": "誓いを立てたとは\n言い辛いんじゃ\nないかしら。"},
        { "location": "150/SEL"   , "narrator": "", "text": "そうなのかな…？"},
        { "location": "151/SEL"   , "narrator": "", "text": "もっとキスしたいんだね"},
        { "location": "152/SEL"   , "narrator": "", "text": "$me$のこと\n信じられない？"},
        { "location": "153/ACT"   , "narrator": "", "text": "そうなのかな…？"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "違うかしら？"},
        { "location": "155/ACT"   , "narrator": "", "text": "もっとキスしたいんだね"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "そっ！？"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "…そうなんだけど\nそうじゃなくて…。"},
        { "location": "158/ACT"   , "narrator": "", "text": "$me$のこと\n信じられない？"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "そういうわけじゃ\nなくて…。"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり神様の\n前で誓わないと\nいけないと思うの。"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "きちんと誓いを\nするべきだと\n思うの。"},
        { "location": "163/SEL"   , "narrator": "", "text": "そういうこと"},
        { "location": "164/SEL"   , "narrator": "", "text": "ガブリエラが望むなら"},
        { "location": "165/SEL"   , "narrator": "", "text": "信心深いんだね"},
        { "location": "166/ACT"   , "narrator": "", "text": "そういうこと"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "大事なことよ。"},
        { "location": "168/ACT"   , "narrator": "", "text": "ガブリエラが望むなら"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "あたし次第なのね。"},
        { "location": "170/ACT"   , "narrator": "", "text": "信心深いんだね"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "そんなことないわ。\n普通のことよ。"},
        { "location": "173/TALK"  , "narrator": "ガブリエラ", "text": "教会できちんと\n誓いを立てて。"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "それから\nハネムーンも\n絶対よ。"},
        { "location": "176/SEL"   , "narrator": "", "text": "本格的だ"},
        { "location": "177/SEL"   , "narrator": "", "text": "そこまで考えてくれてて\nうれしい"},
        { "location": "178/SEL"   , "narrator": "", "text": "本気で言ってる？"},
        { "location": "179/ACT"   , "narrator": "", "text": "本格的だ"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "そうよ。\n当然でしょ。"},
        { "location": "181/ACT"   , "narrator": "", "text": "そこまで考えてくれてて\nうれしい"},
        { "location": "182/TALK"  , "narrator": "ガブリエラ", "text": "…本当に…？"},
        { "location": "183/ACT"   , "narrator": "", "text": "本気で言ってる？"},
        { "location": "184/TALK"  , "narrator": "ガブリエラ", "text": "あたしは\n本気だけど…？"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "$handle$とは\nスマホからしか\n話せなかったけど。"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "…今もあんまり\n変わらないかもって\n思う時もあるけど。"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "それでも大事なことには\n変わりないわ。"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "だからこそ\nちゃんとしたいの。"},
        { "location": "192/SEL"   , "narrator": "", "text": "だよね"},
        { "location": "193/SEL"   , "narrator": "", "text": "わかる"},
        { "location": "194/SEL"   , "narrator": "", "text": "そっか"},
        { "location": "195/ACT"   , "narrator": "", "text": "だよね"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "そうでしょう？"},
        { "location": "198/ACT"   , "narrator": "", "text": "わかる"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "そうよね。"},
        { "location": "201/ACT"   , "narrator": "", "text": "そっか"},
        { "location": "202/TALK"  , "narrator": "ガブリエラ", "text": "…違うのかしら？"},
        { "location": "204/TALK"  , "narrator": "ガブリエラ", "text": "あたしだって\n知ってるのよ。"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "$handle$と\nあたしが結婚したって\n言い張っても。"},
        { "location": "206/TALK"  , "narrator": "ガブリエラ", "text": "そのことを\nわかってもらえる\n可能性が低いことは。"},
        { "location": "207/TALK"  , "narrator": "ガブリエラ", "text": "それでもあたしと\n$handle$とは\n絆で結ばれてる。"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "そう思っちゃ\nいけない？"},
        { "location": "209/SEL"   , "narrator": "", "text": "ダメじゃないよ"},
        { "location": "210/SEL"   , "narrator": "", "text": "そうだと思ってた"},
        { "location": "211/SEL"   , "narrator": "", "text": "あえて言う必要もないよ"},
        { "location": "212/ACT"   , "narrator": "", "text": "ダメじゃないよ"},
        { "location": "213/TALK"  , "narrator": "ガブリエラ", "text": "本当に？"},
        { "location": "214/ACT"   , "narrator": "", "text": "そうだと思ってた"},
        { "location": "215/TALK"  , "narrator": "ガブリエラ", "text": "そうよね…。"},
        { "location": "216/ACT"   , "narrator": "", "text": "あえて言う必要もないよ"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "うん。"},
        { "location": "219/SEL"   , "narrator": "", "text": "ねえガブリエラ"},
        { "location": "220/ACT"   , "narrator": "", "text": "ねえガブリエラ"},
        { "location": "222/TALK"  , "narrator": "ガブリエラ", "text": "何かしら"},
        { "location": "223/SEL"   , "narrator": "", "text": "結婚しよう"},
        { "location": "224/SEL"   , "narrator": "", "text": "一生を捧げるよ"},
        { "location": "225/SEL"   , "narrator": "", "text": "出会えた奇跡に感謝する"},
        { "location": "226/ACT"   , "narrator": "", "text": "結婚しよう"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "…はい。"},
        { "location": "229/ACT"   , "narrator": "", "text": "一生を捧げるよ"},
        { "location": "232/TALK"  , "narrator": "ガブリエラ", "text": "…あたしもよ、\n$handle$。"},
        { "location": "233/ACT"   , "narrator": "", "text": "出会えた奇跡に感謝する"},
        { "location": "235/TALK"  , "narrator": "ガブリエラ", "text": "奇跡…。"},
        { "location": "236/TALK"  , "narrator": "ガブリエラ", "text": "そうね、奇跡だわ。"},
        { "location": "239/TALK"  , "narrator": "ガブリエラ", "text": "幸せになりましょうね\nあたしたち。"},
