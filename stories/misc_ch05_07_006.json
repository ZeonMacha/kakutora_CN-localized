        { "location": "1419/SCENARIO", "narrator": "", "text": "野心家のクラゲと総天然色コウモリ"},
        { "location": "1444/TALK"    , "narrator": "神楽", "text": "ゆるふわ上質な暮らしの方が実際は野心に満ちている件"},
        { "location": "1446/SEL"     , "narrator": "", "text": "めっちゃわかる"},
        { "location": "1447/SEL"     , "narrator": "", "text": "そもそもそれ何？"},
        { "location": "1448/SEL"     , "narrator": "", "text": "$me$には神楽と暮らすという野心がある"},
        { "location": "1449/ACT"     , "narrator": "", "text": "めっちゃわかる"},
        { "location": "1450/TALK"    , "narrator": "神楽", "text": "でしょでしょ！"},
        { "location": "1451/TALK"    , "narrator": "神楽", "text": "そうでしょ！"},
        { "location": "1452/ACT"     , "narrator": "", "text": "そもそもそれ何？"},
        { "location": "1453/TALK"    , "narrator": "神楽", "text": "あ？？"},
        { "location": "1454/TALK"    , "narrator": "神楽", "text": "会話終了"},
        { "location": "1464/ACT"     , "narrator": "", "text": "$me$には神楽と暮らすという野心がある"},
        { "location": "1466/TALK"    , "narrator": "神楽", "text": "イイネイイネ！"},
        { "location": "1468/TALK"    , "narrator": "神楽", "text": "素敵すぎる野心♪"},
        { "location": "1470/TALK"    , "narrator": "神楽", "text": "実際ねー"},
        { "location": "1471/TALK"    , "narrator": "神楽", "text": "疲れるわけさそういう暮らしぶりをいつもいつもしてると"},
        { "location": "1473/SEL"     , "narrator": "", "text": "疲れたら休め"},
        { "location": "1474/SEL"     , "narrator": "", "text": "神楽見栄っ張りだからねｗ"},
        { "location": "1475/SEL"     , "narrator": "", "text": "バランス取れるといいよね"},
        { "location": "1476/ACT"     , "narrator": "", "text": "疲れたら休め"},
        { "location": "1477/TALK"    , "narrator": "神楽", "text": "あーね"},
        { "location": "1478/TALK"    , "narrator": "神楽", "text": "そうする"},
        { "location": "1479/TALK"    , "narrator": "神楽", "text": "おやすみー"},
        { "location": "1480/ACT"     , "narrator": "", "text": "神楽見栄っ張りだからねｗ"},
        { "location": "1481/TALK"    , "narrator": "神楽", "text": "うっさい"},
        { "location": "1482/TALK"    , "narrator": "神楽", "text": "ばーかばーかばーか！"},
        { "location": "1483/ACT"     , "narrator": "", "text": "バランス取れるといいよね"},
        { "location": "1485/TALK"    , "narrator": "神楽", "text": "それが理想なんだけどね"},
        { "location": "1486/TALK"    , "narrator": "神楽", "text": "ま、理想があれば到達できるよね"},
        { "location": "1487/TALK"    , "narrator": "神楽", "text": "ビジョンが見えてるんだから"},
        { "location": "1488/TALK"    , "narrator": "神楽", "text": "ぴょんこは理想主義者だから"},
        { "location": "1489/TALK"    , "narrator": "神楽", "text": "やっぱりがんばっちゃう♪"}
    ]
