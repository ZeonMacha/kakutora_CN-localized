        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "謝らなくていいわよ！"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "逢いたいな～っていうのは本当だし・・・"},
        { "location": "72/SEL"    , "narrator": "", "text": "うれしいな"},
