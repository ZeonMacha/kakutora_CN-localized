        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "毎日すごくすごくすごくすごく忙しいんだから！"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "本当なんだからね！"},
        { "location": "66/SEL"    , "narrator": "", "text": "ごめんごめん"},
