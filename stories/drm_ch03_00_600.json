        { "location": "45/SEL"    , "narrator": "", "text": "僕もギャヴィに会いたかったよ"},
        { "location": "46/SEL"    , "narrator": "", "text": "暇なんだね"},
        { "location": "47/ACT"    , "narrator": "", "text": "僕もギャヴィに会いたかったよ"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "ただの詩だから"},
