        { "location": "35/SEL"    , "narrator": "", "text": "こんばんは"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "風がささやく夜なのでした"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "貴方に逢いたい夜なので"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "貴方の声が聞けるでしょうか"},
