        "title": "002 メインストーリー",
        "sub_title": "二人の秘密基地＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "あねいもうと"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "この部屋に入るのも\n久しぶり。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "何かヒントを\n残してないかと\n思ったけど。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "あるわけないか。"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "お姉ちゃんの方が\n先にこの家を\n出たんだもの。"},
        { "location": "34/SEL"    , "narrator": "", "text": "ねえ"},
        { "location": "35/ACT"    , "narrator": "", "text": "ねえ"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "どうしたの？"},
        { "location": "54/SEL"    , "narrator": "", "text": "お姉さんの部屋にいるの？"},
        { "location": "55/SEL"    , "narrator": "", "text": "お姉さんの話が聞きたいな"},
        { "location": "56/SEL"    , "narrator": "", "text": "思い出話ってないの"},
        { "location": "57/ACT"    , "narrator": "", "text": "お姉さんの部屋にいるの？"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "そう"},
        { "location": "59/ACT"    , "narrator": "", "text": "お姉さんの話が聞きたいな"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "姉の？"},
        { "location": "61/ACT"    , "narrator": "", "text": "思い出話ってないの"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "私が家を出た時と"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "全く変わっていないわ"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "この部屋は"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "……。"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "アーヤ。\nここにいたのね。"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "……。"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "……ここって……。"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "姉の使っていた部屋よ。"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "…そう。"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "ねえギャヴィ。"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "何？"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "今ね。\n昔のことを\n思い出してたの。"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "どんな？"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "小学生の頃のこととか。"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "うちの姉は小さい頃\nよくいじめられてたの。"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "空き地に変なもの\n作ったりしてたから\n壊されたりして。"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "壊すような子から\n作ったものを守るのが\n私の役目。"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "…。"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "別に強制されたわけじゃ\nなくて。\nなんとなくそうなってた。"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "でもある日。\n隣町からやってきた\nガキ大将に負けたの。"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "そして姉の作ったものは\n全部壊された。"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "自分が悔しくて\n情けなくて姉の前で\nわんわん泣いたわ。"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "…。"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "姉はね。\nそんな私を抱きしめて\nこう言ったの。"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "アヤちゃんがいるから\nアヤちゃんが味方だから\n壊されたって平気だって。"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "また作れば\nいいだけなんだから\n泣かないでって。"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "アヤちゃんが世界で一番\n強い子だってことも\n知ってるって。"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "だから剣道を\nしていたの？"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "え？"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "お姉さんが世界で一番\n強い子だってアーヤの\nことを言ったから。"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "だから剣道を\n始めたの？"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "　"},
        { "location": "193/TALK"  , "narrator": "アーヤの新司書　", "text": "こんにちは、\n$handle$さん。"},
        { "location": "194/SEL"   , "narrator": "", "text": "あ、ども"},
        { "location": "195/ACT"   , "narrator": "", "text": "あ、ども"},
        { "location": "197/TALK"  , "narrator": "アーヤの新司書　", "text": "やっと来たわね。"},
        { "location": "198/TALK"  , "narrator": "アーヤの新司書　", "text": "それじゃ早速だけど\n行くわよ。"},
        { "location": "199/SEL"   , "narrator": "", "text": "どこへ！？"},
        { "location": "200/ACT"   , "narrator": "", "text": "どこへ！？"},
        { "location": "202/TALK"  , "narrator": "アーヤの新司書　", "text": "エヴェレットが\n幽閉されてるところ。"},
        { "location": "205/TALK"  , "narrator": "アーヤの新司書　", "text": "オープンプロセス、\n0x510番地から\nC2:9:5AF//1x0FF番地へ。"},
        { "location": "209/SEL"   , "narrator": "", "text": "助けに行くの？"},
        { "location": "210/SEL"   , "narrator": "", "text": "消しに行くの？"},
        { "location": "211/ACT"   , "narrator": "", "text": "助けに行くの？"},
        { "location": "212/TALK"  , "narrator": "アーヤの新司書　", "text": "そう。"},
        { "location": "213/ACT"   , "narrator": "", "text": "消しに行くの？"},
        { "location": "215/TALK"  , "narrator": "アーヤの新司書　", "text": "失礼ね。\n助けに行くのよ。"},
        { "location": "217/TALK"  , "narrator": "アーヤの新司書　", "text": "平然とした顔してたと\n思うけど、十中八九\n一人じゃ戻れないから。"},
        { "location": "219/TALK"  , "narrator": "アーヤの新司書　", "text": "……倍速。"},
        { "location": "222/SEL"   , "narrator": "", "text": "ホントは優しいんだね"},
        { "location": "223/SEL"   , "narrator": "", "text": "どういう風の吹き回し！？"},
        { "location": "224/ACT"   , "narrator": "", "text": "ホントは優しいんだね"},
        { "location": "227/TALK"  , "narrator": "アーヤの新司書　", "text": "……。"},
        { "location": "228/TALK"  , "narrator": "アーヤの新司書　", "text": "別に。"},
        { "location": "230/ACT"   , "narrator": "", "text": "どういう風の吹き回し！？"},
        { "location": "231/TALK"  , "narrator": "アーヤの新司書　", "text": "私をどんな人格だと\n思ってるの？"},
        { "location": "233/TALK"  , "narrator": "アーヤの新司書　", "text": "契約主がいなくなった今、\n私個人が彼女に何をする\n理由も無いもの。"},
        { "location": "234/TALK"  , "narrator": "アーヤの新司書　", "text": "それに。あんなのでも\n私の人格だし。\n嫌いだけど。"},
        { "location": "236/TALK"  , "narrator": "アーヤの新司書　", "text": "……４倍速。"},
        { "location": "253/TALK"  , "narrator": "アーヤの新司書　", "text": "完了。"},
        { "location": "255/TALK"  , "narrator": "アーヤの新司書　", "text": "……？"},
        { "location": "256/SEL"   , "narrator": "", "text": "いない？"},
        { "location": "257/ACT"   , "narrator": "", "text": "いない？"},
        { "location": "259/TALK"  , "narrator": "アーヤの新司書　", "text": "いないわね。\n自分でどこかに\n行っちゃったのかしら。"},
        { "location": "261/TALK"  , "narrator": "アーヤの新司書　", "text": "おーい。\nお迎えに\n来てあげたわよ。"},
        { "location": "262/TALK"  , "narrator": "アーヤの新司書　", "text": "……。"},
        { "location": "263/SEL"   , "narrator": "", "text": "脱出したんじゃない？"},
        { "location": "264/SEL"   , "narrator": "", "text": "その辺探してみようか？"},
        { "location": "265/ACT"   , "narrator": "", "text": "脱出したんじゃない？"},
        { "location": "267/TALK"  , "narrator": "アーヤの新司書　", "text": "ないない。"},
        { "location": "268/TALK"  , "narrator": "アーヤの新司書　", "text": "それぞれのアドレスは\n普通は自力では\n行き来できないもの。"},
        { "location": "269/TALK"  , "narrator": "アーヤの新司書　", "text": "司書は例外だけど、\n彼女、消される前に\n司書権剥奪されていたし。"},
        { "location": "270/TALK"  , "narrator": "アーヤの新司書　", "text": "ちょっとその辺りを\n捜索してみるしか\nないわね。"},
        { "location": "271/ACT"   , "narrator": "", "text": "その辺探してみようか？"},
        { "location": "273/TALK"  , "narrator": "アーヤの新司書　", "text": "そうね。\nこのアドレスはちょっと\n広いみたいだし。"},
        { "location": "274/TALK"  , "narrator": "アーヤの新司書　", "text": "ちょっとその辺りを\n捜してみるわ。"},
        { "location": "279/TALK"  , "narrator": "エヴェレット", "text": "$handle$さん"},
        { "location": "280/SEL"   , "narrator": "", "text": "エヴェレットさん！？"},
        { "location": "281/ACT"   , "narrator": "", "text": "エヴェレットさん！？"},
        { "location": "283/TALK"  , "narrator": "エヴェレット", "text": "私は大丈夫だから、"},
        { "location": "284/TALK"  , "narrator": "エヴェレット", "text": "もうちょっとしたら戻るから、気にせず私の心の葛藤を解決して？"},
        { "location": "285/TALK"  , "narrator": "エヴェレット", "text": "今回のは、剣道を始めた理由ね。確かに姉が理由なの"},
        { "location": "286/TALK"  , "narrator": "エヴェレット", "text": "それをちょっと恥ずかしいと思ってるところがあるから、本人あまり肯定したがらないと思う"},
        { "location": "287/SEL"   , "narrator": "", "text": "ちょっと待って、ホントに大丈夫なの？"},
        { "location": "288/ACT"   , "narrator": "", "text": "ちょっと待って、ホントに大丈夫なの？"},
        { "location": "290/TALK"  , "narrator": "エヴェレット", "text": "だからクランが阻んでるのよね"},
        { "location": "292/SEL"   , "narrator": "", "text": "おーい、話聞いて"},
        { "location": "293/ACT"   , "narrator": "", "text": "おーい、話聞いて"},
        { "location": "295/TALK"  , "narrator": "エヴェレット", "text": "私が剣道を始めた理由は、姉との関係において「例え嫌いであっても離れられない理由」を作りたかったからというのがホントの最初です"},
        { "location": "296/SEL"   , "narrator": "", "text": "ホントは大丈夫じゃないんじゃないの？"},
        { "location": "297/ACT"   , "narrator": "", "text": "ホントは大丈夫じゃないんじゃないの？"},
        { "location": "299/TALK"  , "narrator": "エヴェレット", "text": "私が私自身に、姉を護るという使命をこじつけることで、誰からも、自分自身からも姉と離れられないことを正当化して安心できるように"},
        { "location": "300/TALK"  , "narrator": "エヴェレット", "text": "もし自分がどうにも姉が許せなかったり、一緒にいたくなくなっても、離れられないように"},
        { "location": "301/SEL"   , "narrator": "", "text": "エヴェレットさん！！"},
        { "location": "302/ACT"   , "narrator": "", "text": "エヴェレットさん！！"},
        { "location": "304/TALK"  , "narrator": "エヴェレット", "text": "けど、離れて行っちゃったのは姉の方だった。だからその後剣道やめた。もちろん他にも理由はあったけど"},
        { "location": "305/TALK"  , "narrator": "エヴェレット", "text": "今このときに、私にはそのことを肯定して欲しいから、是非早くクランを倒して欲しいの"},
        { "location": "306/TALK"  , "narrator": "エヴェレット", "text": "私は大丈夫だから"},
        { "location": "307/SEL"   , "narrator": "", "text": "大丈夫なら今何処で何してるか教えて！"},
        { "location": "308/ACT"   , "narrator": "", "text": "大丈夫なら今何処で何してるか教えて！"},
        { "location": "310/TALK"  , "narrator": "エヴェレット", "text": "じゃあ、アドレス教えて"},
        { "location": "311/SEL"   , "narrator": "", "text": "0x89F"},
        { "location": "315/SEL"   , "narrator": "", "text": "ちょっと！！！"},
        { "location": "316/ACT"   , "narrator": "", "text": "ちょっと！！！"},
        { "location": "318/TALK"  , "narrator": "エヴェレット", "text": "大好き(^^*"},
        { "location": "28/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月3日　 10:31 PM</color>\n長野県松代、アーヤの実家でのこと"},
        { "location": "131/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "133/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "135/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "137/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "139/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "335/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\n司書が存在しません。(p12)"},
        { "location": "336/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\nAutoBatchが\n検出されました。\n\nコマンド\n<color=blue>【EXEC_SEEK_SECTOR/.】</color>\nを、実行します。"},
        { "location": "341/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:SeekSector】</color>\nOpenProcess...\n(0x510 => 0x89F)"},
        { "location": "361/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:SeekSector】</color>\nSucceed access file!\n\n<color=blue>【File :: 02-338-91】</color>\n<color=red>Fatal Error Occured !</color>\n\n剣道を始めた理由。それは姉のことと関係がある。今の姉に対する態度と異なるため、それを肯定することを拒絶しようとするクランが出現している。\n\n姉との関係を正常化するためにも、素直な気持ちで過去を止まって見返してみるのがよいと思われる。"}
