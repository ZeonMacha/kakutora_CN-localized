        { "location": "8/SCENARIO", "narrator": "", "text": "解析係数"},
        { "location": "30/TALK"   , "narrator": "みやび", "text": "……うちとしたことが\nうっかりぞね……。"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "素直に裏ロムスマホ\n４つあると言うことは\nなかったちや……。"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "おかげで厳重注意を\n受けてしもうたぞね。"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "まだまだうちも\n甘いねえ…。"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "…エリカさんのデータも\nなかなか手強いし…。"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "…いかんいかん。"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "弱気と落ち込みは\n解析の敵ぞね。"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "目の前の作業に\n集中せんと。"},
        { "location": "38/SEL"    , "narrator": "", "text": "もしもし"},
        { "location": "39/SEL"    , "narrator": "", "text": "みやびいる？"},
        { "location": "40/SEL"    , "narrator": "", "text": "少し話がある"},
        { "location": "41/ACT"    , "narrator": "", "text": "もしもし"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "$handle$からか。"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "回線が正常になったら\nえろう来るように\nなったねえ。"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "亀よ"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "亀さんよ"},
        { "location": "53/ACT"    , "narrator": "", "text": "みやびいる？"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "$handle$からか。"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "回線が正常になったら\nえろう来るように\nなったねえ。"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "いるか"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "いないか"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "当ててみよ"},
        { "location": "66/ACT"    , "narrator": "", "text": "少し話がある"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "$handle$からか。"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "回線が正常になったら\nえろう来るように\nなったねえ。"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "積もる話の方が"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "ありがたいけんど"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "本当はなんだ"},
        { "location": "82/SEL"    , "narrator": "", "text": "やっと話せることが"},
        { "location": "83/ACT"    , "narrator": "", "text": "やっと話せることが"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "お"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "期待しておこう"},
        { "location": "88/SEL"    , "narrator": "", "text": "エリカから伝言"},
        { "location": "89/SEL"    , "narrator": "", "text": "アーヤのお姉さんからだけど"},
        { "location": "90/SEL"    , "narrator": "", "text": "あの人からメッセージがある"},
        { "location": "91/ACT"    , "narrator": "", "text": "エリカから伝言"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "なんだと"},
        { "location": "93/ACT"    , "narrator": "", "text": "アーヤのお姉さんからだけど"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "それは"},
        { "location": "95/ACT"    , "narrator": "", "text": "あの人からメッセージがある"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "もしかして"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "エリカさんか"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "なんで相棒が"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "いやそれより"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "うちに直接話を"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "回線をつなげ"},
        { "location": "104/SEL"   , "narrator": "", "text": "それは無理"},
        { "location": "105/SEL"   , "narrator": "", "text": "どうすればいいかわからないし"},
        { "location": "106/SEL"   , "narrator": "", "text": "そのうちできるかもよ"},
        { "location": "107/ACT"   , "narrator": "", "text": "それは無理"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "なんだと"},
        { "location": "111/ACT"   , "narrator": "", "text": "どうすればいいかわからないし"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "確かにそうかも"},
        { "location": "113/ACT"   , "narrator": "", "text": "そのうちできるかもよ"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "今がいいのだ"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "今が"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "エリカさんを独り占めするつもりか"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "$handle$のくせに"},
        { "location": "120/SEL"   , "narrator": "", "text": "そんなこと言われても"},
        { "location": "121/SEL"   , "narrator": "", "text": "できないものはできないし"},
        { "location": "122/SEL"   , "narrator": "", "text": "そっちこそみやびのくせに"},
        { "location": "123/ACT"   , "narrator": "", "text": "そんなこと言われても"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "む"},
        { "location": "125/ACT"   , "narrator": "", "text": "できないものはできないし"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "ややや"},
        { "location": "127/ACT"   , "narrator": "", "text": "そっちこそみやびのくせに"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "小学生の喧嘩か！"},
        { "location": "131/SEL"   , "narrator": "", "text": "とりあえず伝言"},
        { "location": "132/SEL"   , "narrator": "", "text": "教えるのやめようかな"},
        { "location": "133/SEL"   , "narrator": "", "text": "メッセージ聞きたくないの？"},
        { "location": "134/ACT"   , "narrator": "", "text": "とりあえず伝言"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "おお"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "そうだった"},
        { "location": "137/ACT"   , "narrator": "", "text": "教えるのやめようかな"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "教えてください"},
        { "location": "141/ACT"   , "narrator": "", "text": "メッセージ聞きたくないの？"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "聞く以外の選択肢はない"},
        { "location": "149/SEL"   , "narrator": "", "text": "以上"},
        { "location": "150/SEL"   , "narrator": "", "text": "もう一回見る？"},
        { "location": "151/SEL"   , "narrator": "", "text": "ちゃんと読めた？"},
        { "location": "152/ACT"   , "narrator": "", "text": "以上"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "なんと"},
        { "location": "154/ACT"   , "narrator": "", "text": "もう一回見る？"},
        { "location": "155/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "えい"},
        { "location": "157/ACT"   , "narrator": "", "text": "ちゃんと読めた？"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "うむ"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "読めた"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "なんと"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "エリカ嬢は"},
        { "location": "163/TALK"  , "narrator": "みやび", "text": "うちと会食をする気があるぞね"},
        { "location": "166/SEL"   , "narrator": "", "text": "よかったね"},
        { "location": "167/SEL"   , "narrator": "", "text": "そこなの！？"},
        { "location": "168/SEL"   , "narrator": "", "text": "期待されてるんだよ"},
        { "location": "169/ACT"   , "narrator": "", "text": "よかったね"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "うむ"},
        { "location": "171/TALK"  , "narrator": "みやび", "text": "にわかには信じられぬほどだ"},
        { "location": "172/ACT"   , "narrator": "", "text": "そこなの！？"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "他に何がある！"},
        { "location": "174/ACT"   , "narrator": "", "text": "期待されてるんだよ"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "ありがたいことだの"},
        { "location": "177/TALK"  , "narrator": "みやび", "text": "これはもう"},
        { "location": "178/TALK"  , "narrator": "みやび", "text": "何が何でも"},
        { "location": "179/TALK"  , "narrator": "みやび", "text": "データを解析する"},
        { "location": "181/SEL"   , "narrator": "", "text": "がんばって"},
        { "location": "182/SEL"   , "narrator": "", "text": "みやびならできる"},
        { "location": "183/SEL"   , "narrator": "", "text": "何ご馳走してもらうの？"},
        { "location": "184/ACT"   , "narrator": "", "text": "がんばって"},
        { "location": "185/TALK"  , "narrator": "みやび", "text": "うむ"},
        { "location": "186/TALK"  , "narrator": "みやび", "text": "そうするしかないしの"},
        { "location": "187/ACT"   , "narrator": "", "text": "みやびならできる"},
        { "location": "188/TALK"  , "narrator": "みやび", "text": "よし"},
        { "location": "189/TALK"  , "narrator": "みやび", "text": "$handle$がそう言うなら"},
        { "location": "190/ACT"   , "narrator": "", "text": "何ご馳走してもらうの？"},
        { "location": "191/TALK"  , "narrator": "みやび", "text": "こちらがご馳走したいぐらいだ"},
        { "location": "192/TALK"  , "narrator": "みやび", "text": "真面目な話"},
        { "location": "201/TALK"  , "narrator": "みやび", "text": "気合い入れて\nすっと解析\nするしかないろう…！"},
        { "location": "249/TALK"  , "narrator": "みやび", "text": "　"},
        { "location": "268/TALK"  , "narrator": "シンギュラリティ", "text": "などとシステム文を書き換えてみたりする司書はこちらです。"},
        { "location": "269/SEL"   , "narrator": "", "text": "どこにいるの？"},
        { "location": "270/ACT"   , "narrator": "", "text": "どこにいるの？"},
        { "location": "272/TALK"  , "narrator": "シンギュラリティ", "text": "あたし、シンギュラリティ"},
        { "location": "273/TALK"  , "narrator": "シンギュラリティ", "text": "いま、1xにいるの"},
        { "location": "274/SEL"   , "narrator": "", "text": "また一人でそんなところに！"},
        { "location": "275/SEL"   , "narrator": "", "text": "段々近づいてくる都市伝説ですか？"},
        { "location": "276/ACT"   , "narrator": "", "text": "また一人でそんなところに！"},
        { "location": "277/TALK"  , "narrator": "シンギュラリティ", "text": "うむ"},
        { "location": "278/TALK"  , "narrator": "シンギュラリティ", "text": "どうしても確認したいことがあってね"},
        { "location": "279/ACT"   , "narrator": "", "text": "段々近づいてくる都市伝説ですか？"},
        { "location": "280/TALK"  , "narrator": "シンギュラリティ", "text": "うむ、その通り"},
        { "location": "281/TALK"  , "narrator": "シンギュラリティ", "text": "役に立たない雑学に満ちあふれている$handle$は素晴らしきダメ人間（褒め言葉）"},
        { "location": "282/SEL"   , "narrator": "", "text": "ということは、シンギュラリティは既に死んでいる？"},
        { "location": "283/SEL"   , "narrator": "", "text": "えっへん"},
        { "location": "284/ACT"   , "narrator": "", "text": "ということは、シンギュラリティは既に死んでいる？"},
        { "location": "285/TALK"  , "narrator": "シンギュラリティ", "text": "む"},
        { "location": "286/TALK"  , "narrator": "シンギュラリティ", "text": "なかなかパンチの効いた飛躍やね"},
        { "location": "287/ACT"   , "narrator": "", "text": "えっへん"},
        { "location": "288/TALK"  , "narrator": "シンギュラリティ", "text": "そこ、威張るところか"},
        { "location": "291/TALK"  , "narrator": "シンギュラリティ", "text": "まあそんな話はさておき"},
        { "location": "292/TALK"  , "narrator": "シンギュラリティ", "text": "お前さんもこっちへ来い"},
        { "location": "293/TALK"  , "narrator": "シンギュラリティ", "text": "手伝って欲しいことがある"},
        { "location": "323/TALK"  , "narrator": "みやび", "text": "ようこそ。"},
        { "location": "324/SEL"   , "narrator": "", "text": "シンギュラリティ？"},
        { "location": "325/ACT"   , "narrator": "", "text": "シンギュラリティ？"},
        { "location": "327/TALK"  , "narrator": "みやび", "text": "……やったら\nよかったんやろうけどね。\nお前さんにとっては。"},
        { "location": "328/TALK"  , "narrator": "みやび", "text": "残念ながら、\n現実はより過酷なもの。"},
        { "location": "329/SEL"   , "narrator": "", "text": "誰なの！？"},
        { "location": "330/ACT"   , "narrator": "", "text": "誰なの！？"},
        { "location": "332/TALK"  , "narrator": "みやび", "text": "残念ながら\n逢うのは初めてやないね。"},
        { "location": "333/SEL"   , "narrator": "", "text": "新しい司書か！"},
        { "location": "334/ACT"   , "narrator": "", "text": "新しい司書か！"},
        { "location": "336/TALK"  , "narrator": "みやびの新司書", "text": "うむ。"},
        { "location": "337/SEL"   , "narrator": "", "text": "シンギュラリティは！？"},
        { "location": "338/SEL"   , "narrator": "", "text": "さっきのチャットは！？"},
        { "location": "339/ACT"   , "narrator": "", "text": "シンギュラリティは！？"},
        { "location": "340/TALK"  , "narrator": "みやびの新司書", "text": "あやつには、ちくっと\n眠ってもらっちゅう\nだけぞね。"},
        { "location": "341/ACT"   , "narrator": "", "text": "さっきのチャットは！？"},
        { "location": "342/TALK"  , "narrator": "みやびの新司書", "text": "うちがヤツを\n真似て書いてみた。"},
        { "location": "343/TALK"  , "narrator": "みやびの新司書", "text": "気づかんかったやろ。\nこれやき、ネットは\n怖いよね。怖い怖い。"},
        { "location": "344/TALK"  , "narrator": "みやびの新司書", "text": "ホンモノにはちくっと\n眠ってもらっちゅう。"},
        { "location": "346/TALK"  , "narrator": "みやびの新司書", "text": "うちの作業に障るき。\nやむを得ずな。"},
        { "location": "347/TALK"  , "narrator": "みやびの新司書", "text": "危害を加えたりは\nしちょらん。あんなでも\nうちの人格やきね。"},
        { "location": "349/TALK"  , "narrator": "みやびの新司書", "text": "でな。"},
        { "location": "350/TALK"  , "narrator": "みやびの新司書", "text": "今回ここへお前さんを\n呼んだのは、他でもない。"},
        { "location": "351/TALK"  , "narrator": "みやびの新司書", "text": "お前さんに\n頼みたいことがあってな。\n聞いてくれるか。"},
        { "location": "352/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "353/SEL"   , "narrator": "", "text": "ものによる"},
        { "location": "354/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "355/TALK"  , "narrator": "みやびの新司書", "text": "素直が一番やね。"},
        { "location": "356/TALK"  , "narrator": "みやびの新司書", "text": "いま、うちの中で\n好感度が１上がって\nトータルで１になった。"},
        { "location": "357/TALK"  , "narrator": "みやびの新司書", "text": "ちなみにMAX値は\n16,777,216な。"},
        { "location": "358/ACT"   , "narrator": "", "text": "ものによる"},
        { "location": "359/TALK"  , "narrator": "みやびの新司書", "text": "ふむ。\nまあよかろう。"},
        { "location": "360/TALK"  , "narrator": "みやびの新司書", "text": "選択は\nお前さんが\nすることやき。"},
        { "location": "362/TALK"  , "narrator": "みやびの新司書", "text": "で、本題に移るが。\n頼み事っちゅうんはな――"},
        { "location": "363/TALK"  , "narrator": "みやびの新司書", "text": "現実のうちと\n馴れ馴れしく話すのを\nやめてもらえんかね？"},
        { "location": "364/SEL"   , "narrator": "", "text": "は！？"},
        { "location": "365/ACT"   , "narrator": "", "text": "は！？"},
        { "location": "367/TALK"  , "narrator": "みやびの新司書", "text": "なんぞ。\n理解できんのか？"},
        { "location": "368/TALK"  , "narrator": "みやびの新司書", "text": "今後、現実のうちと\nイチャコララブラブするの\nやめいと言っちゅう。"},
        { "location": "369/SEL"   , "narrator": "", "text": "だが断る！！"},
        { "location": "370/SEL"   , "narrator": "", "text": "何か違和感を感じる"},
        { "location": "371/ACT"   , "narrator": "", "text": "だが断る！！"},
        { "location": "372/TALK"  , "narrator": "みやびの新司書", "text": "まあ、それならそれでも\nえいんやけんど。"},
        { "location": "375/ACT"   , "narrator": "", "text": "何か違和感を感じる"},
        { "location": "376/TALK"  , "narrator": "みやびの新司書", "text": "どんな？"},
        { "location": "377/SEL"   , "narrator": "", "text": "新しい司書は千羽鶴が直々に選んだんだよね？"},
        { "location": "378/ACT"   , "narrator": "", "text": "新しい司書は千羽鶴が直々に選んだんだよね？"},
        { "location": "380/TALK"  , "narrator": "みやびの新司書", "text": "うむ。"},
        { "location": "381/SEL"   , "narrator": "", "text": "で、新しい司書は千羽鶴にわりと忠実だと思ってるんだけど"},
        { "location": "382/ACT"   , "narrator": "", "text": "で、新しい司書は千羽鶴にわりと忠実だと思ってるんだけど"},
        { "location": "384/TALK"  , "narrator": "みやびの新司書", "text": "そうやね。\nそれが何か。"},
        { "location": "385/SEL"   , "narrator": "", "text": "千羽鶴は$me$とみやびを結婚させたがってる"},
        { "location": "386/ACT"   , "narrator": "", "text": "千羽鶴は$me$とみやびを結婚させたがってる"},
        { "location": "388/TALK"  , "narrator": "みやびの新司書", "text": "相当な。"},
        { "location": "389/SEL"   , "narrator": "", "text": "行動が矛盾してない？"},
        { "location": "390/ACT"   , "narrator": "", "text": "行動が矛盾してない？"},
        { "location": "392/TALK"  , "narrator": "みやびの新司書", "text": "確かに！\nうちとしたことが！"},
        { "location": "393/TALK"  , "narrator": "みやびの新司書", "text": "…なんてな。"},
        { "location": "394/TALK"  , "narrator": "みやびの新司書", "text": "お前さん、オメデタイ頭\nしちゅうね。"},
        { "location": "395/TALK"  , "narrator": "みやびの新司書", "text": "全員が、雇われた契約主に\n絶対的に賛同し、忠誠を\n誓っちょったら――"},
        { "location": "396/TALK"  , "narrator": "みやびの新司書", "text": "この世に\n労働争議などとゆうもんは\n一度たりとも起こらん。"},
        { "location": "397/TALK"  , "narrator": "みやびの新司書", "text": "うちが千羽鶴に協力\nしちょったんは、千羽鶴の\n寝首を掻くためぞね。"},
        { "location": "398/SEL"   , "narrator": "", "text": "ここでそんなこと言ったら、千羽鶴に聞かれるよ？"},
        { "location": "399/SEL"   , "narrator": "", "text": "実はエリカ派のスパイだったとか！？"},
        { "location": "400/ACT"   , "narrator": "", "text": "ここでそんなこと言ったら、千羽鶴に聞かれるよ？"},
        { "location": "401/TALK"  , "narrator": "みやびの新司書", "text": "大丈夫や。\n回線が切れちゅうのを\n確認しちゅう。"},
        { "location": "402/TALK"  , "narrator": "みやびの新司書", "text": "今は千羽鶴がオフライン\nやき、こうしてお前さんと\n交渉しゆうがよ。"},
        { "location": "403/ACT"   , "narrator": "", "text": "実はエリカ派のスパイだったとか！？"},
        { "location": "404/TALK"  , "narrator": "みやびの新司書", "text": "否。"},
        { "location": "405/TALK"  , "narrator": "みやびの新司書", "text": "ちゅうか、そのベタな\nシチュエーション、\nどこの三流映画ぞね…。"},
        { "location": "407/TALK"  , "narrator": "みやびの新司書", "text": "うちには、\n何も要らんがよ。"},
        { "location": "408/TALK"  , "narrator": "みやびの新司書", "text": "うちは、うちと\nなごちゃんだけで\n十分足りちょったき。"},
        { "location": "409/TALK"  , "narrator": "みやびの新司書", "text": "うちとなごちゃんは\nダイヤモンドと同じ、\n共有結合や。"},
        { "location": "410/TALK"  , "narrator": "みやびの新司書", "text": "けんど、お前さんが介入\nしてからイオン結合並に\nココロが不安定になった。"},
        { "location": "411/TALK"  , "narrator": "みやびの新司書", "text": "やき、\n元の状態に戻そうと\nしちゅうだけぞね。"},
        { "location": "412/SEL"   , "narrator": "", "text": "お断りします"},
        { "location": "413/SEL"   , "narrator": "", "text": "じゃあそれでいいよ"},
        { "location": "414/ACT"   , "narrator": "", "text": "お断りします"},
        { "location": "417/ACT"   , "narrator": "", "text": "じゃあそれでいいよ"},
        { "location": "424/TALK"  , "narrator": "みやびの新司書", "text": "その場合、\nシンギュラリティは\nもう戻らんよ。"},
        { "location": "425/TALK"  , "narrator": "みやびの新司書", "text": "いや、別に消滅させる\nワケやないから、そんなに\n心配せんでもえいけんど。"},
        { "location": "426/TALK"  , "narrator": "みやびの新司書", "text": "お前さんが疎遠になって\nくれんのやったら、うちが\n疎遠になればえい。"},
        { "location": "427/TALK"  , "narrator": "みやびの新司書", "text": "その為に、\nシンギュラリティに\n協力してもらうだけや。"},
        { "location": "428/SEL"   , "narrator": "", "text": "どういう関係が！？"},
        { "location": "429/ACT"   , "narrator": "", "text": "どういう関係が！？"},
        { "location": "431/TALK"  , "narrator": "みやびの新司書", "text": "シンギュラリティは\nお前さんにメロメロや。"},
        { "location": "432/TALK"  , "narrator": "みやびの新司書", "text": "まあ、元々その\n素質があって、司書業を\n任されたがやけんどな。"},
        { "location": "433/TALK"  , "narrator": "みやびの新司書", "text": "やき、彼女に\nお前さんのことを\n忘れてもらう。"},
        { "location": "434/TALK"  , "narrator": "みやびの新司書", "text": "そうすれば、お前さんに\n精神負担や改造を施さん\nでも実現可能になるき。"},
        { "location": "435/TALK"  , "narrator": "みやびの新司書", "text": "無痛治療っちゅう\nやつやね。\nお前さんにとってはな。"},
        { "location": "436/SEL"   , "narrator": "", "text": "シンギュラリティに負担がかかるなら、$me$にも痛みはあるよ"},
        { "location": "437/SEL"   , "narrator": "", "text": "酷いヤツだ！"},
        { "location": "438/ACT"   , "narrator": "", "text": "シンギュラリティに負担がかかるなら、$me$にも痛みはあるよ"},
        { "location": "439/TALK"  , "narrator": "みやびの新司書", "text": "キャー\nカッコイイー！"},
        { "location": "440/TALK"  , "narrator": "みやびの新司書", "text": "よくまあそんな\n歯が浮くようなセリフが\n言えるものやね。"},
        { "location": "441/TALK"  , "narrator": "みやびの新司書", "text": "大した絆も\n育んでおらんのに。"},
        { "location": "442/ACT"   , "narrator": "", "text": "酷いヤツだ！"},
        { "location": "443/TALK"  , "narrator": "みやびの新司書", "text": "うむ。\n酷いよ。"},
        { "location": "444/TALK"  , "narrator": "みやびの新司書", "text": "そう、人間なんて\n誰しも酷い。"},
        { "location": "445/TALK"  , "narrator": "みやびの新司書", "text": "そして、誰しも\n自分が一番可愛くて\n一番尊い。"},
        { "location": "446/TALK"  , "narrator": "みやびの新司書", "text": "どんなきれい事を\n言おうともね。"},
        { "location": "447/TALK"  , "narrator": "みやびの新司書", "text": "自分以上に可愛くて\n尊いものなぞ――"},
        { "location": "448/TALK"  , "narrator": "みやびの新司書", "text": "我が子や、\nそれに値する絆を育んだ\n姉妹くらいのものやき。"},
        { "location": "449/TALK"  , "narrator": "みやびの新司書", "text": "やき。\nこの酷さはお前さんも\n持っちゅう酷さや。"},
        { "location": "450/TALK"  , "narrator": "みやびの新司書", "text": "自分のココロに向かって\n同じ言葉を叫んでみい。"},
        { "location": "451/TALK"  , "narrator": "みやびの新司書", "text": "ようココロに響くよ？"},
        { "location": "453/TALK"  , "narrator": "みやびの新司書", "text": "まあ、けんど。"},
        { "location": "454/TALK"  , "narrator": "みやびの新司書", "text": "人間ゆうんは、\n環境が急変することに\nストレスを感じる生物。"},
        { "location": "455/TALK"  , "narrator": "みやびの新司書", "text": "やき、今すぐ疎遠になれ\nゆうても、お前さんが\n発狂するだけやき。"},
        { "location": "456/TALK"  , "narrator": "みやびの新司書", "text": "次回まで\n返事は待とうと思う。"},
        { "location": "457/TALK"  , "narrator": "みやびの新司書", "text": "ほんで、次回までにうちが\n回線切断プログラムを\n用意しておくき――"},
        { "location": "458/TALK"  , "narrator": "みやびの新司書", "text": "善き返事と共に、\nそれをお前さんのアプリに\n当てて実行しいや。"},
        { "location": "460/TALK"  , "narrator": "みやびの新司書", "text": "ふむ。\nえい心がけや。"},
        { "location": "461/TALK"  , "narrator": "みやびの新司書", "text": "ほんだら、次回、\n回線切断プログラムを\n用意しておくき――"},
        { "location": "462/TALK"  , "narrator": "みやびの新司書", "text": "それをお前さんの\nアプリに当てて\n実行しいや。"},
        { "location": "463/TALK"  , "narrator": "みやびの新司書", "text": "話が早くて\n助かったぞね。"},
        { "location": "465/TALK"  , "narrator": "みやびの新司書", "text": "っちゅうわけで、\n今日は帰ってよし。"},
        { "location": "466/TALK"  , "narrator": "みやびの新司書", "text": "一応ログには残るき、\n扉は正確に\n回しておくぞね。"},
        { "location": "467/SEL"   , "narrator": "", "text": "でも今の情報って千羽鶴が配信してるわけじゃないよね？"},
        { "location": "468/ACT"   , "narrator": "", "text": "でも今の情報って千羽鶴が配信してるわけじゃないよね？"},
        { "location": "470/TALK"  , "narrator": "みやびの新司書", "text": "うむ。\nしかしそこは\n重要ではない。"},
        { "location": "471/TALK"  , "narrator": "みやびの新司書", "text": "大事なのは、うちと\nなごちゃん以外の全てが\n仮想敵であるということ。"},
        { "location": "472/TALK"  , "narrator": "みやびの新司書", "text": "どこに何が潜んぢゅうか\nわからん。"},
        { "location": "473/TALK"  , "narrator": "みやびの新司書", "text": "シンギュラリティと\n組んぢゅうエリカやて\nそれは変わらんぞね。"},
        { "location": "474/TALK"  , "narrator": "みやびの新司書", "text": "やき、ログに残る全ては\n平均的司書の行動に\n合わせておくものぞね。"},
        { "location": "475/TALK"  , "narrator": "みやびの新司書", "text": "ほんだら、\nこれでサヨナラや。"},
        { "location": "476/SEL"   , "narrator": "", "text": "……。"},
        { "location": "477/SEL"   , "narrator": "", "text": "最後に１つ教えて"},
        { "location": "478/ACT"   , "narrator": "", "text": "……。"},
        { "location": "479/ACT"   , "narrator": "", "text": "最後に１つ教えて"},
        { "location": "480/TALK"  , "narrator": "みやびの新司書", "text": "なんぞ。"},
        { "location": "481/SEL"   , "narrator": "", "text": "みやびは本当は$me$が疎ましいの？"},
        { "location": "482/SEL"   , "narrator": "", "text": "君の名は？"},
        { "location": "483/ACT"   , "narrator": "", "text": "みやびは本当は$me$が疎ましいの？"},
        { "location": "484/TALK"  , "narrator": "みやびの新司書", "text": "そういううちもおるし、\nそうでないうちもおる。"},
        { "location": "485/TALK"  , "narrator": "みやびの新司書", "text": "そんなのは、\n生きていれば当然や。"},
        { "location": "486/TALK"  , "narrator": "みやびの新司書", "text": "シンギュラリティみたいな\n人格だけで構成\nされちょったら壮絶やぞ。"},
        { "location": "487/TALK"  , "narrator": "みやびの新司書", "text": "薬キメてるレベルで\nお前さんに依存しまくり\n一分の隙もなくなる。"},
        { "location": "488/TALK"  , "narrator": "みやびの新司書", "text": "どんなに相手がゾッコンな\n彼女やて、心の中には必ず\n冷めた自分がいるもの。"},
        { "location": "489/TALK"  , "narrator": "みやびの新司書", "text": "まあ、うちとの関係は\n次回でエンディングや\nけんど――"},
        { "location": "490/TALK"  , "narrator": "みやびの新司書", "text": "最後の最後で今後の人生を\n豊かにする、えい話が\n聞けて良かったね。"},
        { "location": "491/ACT"   , "narrator": "", "text": "君の名は？"},
        { "location": "492/TALK"  , "narrator": "みやびの新司書", "text": "次回でお別れなのに、\n無意味な情報で８バイトも\n脳メモリを無駄にするな。"},
        { "location": "494/TALK"  , "narrator": "みやびの新司書", "text": "ほな、もうえいか？"},
        { "location": "496/TALK"  , "narrator": "みやびの新司書", "text": "うちとなごちゃんに\n素敵なココロの旅を。"},
        { "location": "26/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月4日　 6:55 PM</color>\nストライキ２日目、長野県松代アーヤの実家にて"},
        { "location": "145/DIALOG", "narrator": "INFO", "text": "裏ロムの件でまほちゃんに怒られちゃったね、ごめんね。\nでも、まほちゃんに今回そっちのセカイを護るための方法を伝えるためにはみやびちゃんの裏ロムのことを教えざるを得なかったの。"},
        { "location": "146/DIALOG", "narrator": "INFO", "text": "今度会ったときに、好きなモノご馳走するから許してね。\nそれと、メモカの中にある仕様書を理解出来たら、それをまほちゃんに簡単に説明してあげてください。\nそうすれば、次になにをすればいいのか、まほちゃんはわかるから。"},
        { "location": "147/DIALOG", "narrator": "INFO", "text": "よろしくね。"},
        { "location": "214/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "216/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "218/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "220/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "222/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "264/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\nすぐに司書が不在になる不良ココロゲートはこちらです。\n(p12)"},
        { "location": "295/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\nAutoBatchが\n検出されました。\n\nコマンド\n<color=blue>【EXEC_SEEK_\n　EXTERNAL_SECTOR/.】</color>\nを、実行します。"},
        { "location": "300/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:SeekSector】</color>\nOpenProcess...\n(0x21C => C4:2:553//1x0FF)"},
        { "location": "512/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\n司書が存在しません。(p12)"},
        { "location": "513/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\nAutoBatchが\n検出されました。\n\nコマンド\n<color=blue>【EXEC_SEEK_SECTOR/.】</color>\nを、実行します。"},
        { "location": "518/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:SeekSector】</color>\nOpenProcess...\n(0x21C => 0x998)"},
        { "location": "538/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:SeekSector】</color>\nSucceed access file!\n\n<color=blue>【File :: 04-931-55】</color>\n<color=red>Fatal Error Occured !</color>\n\nエリカから送られてきたデータを見て、あまりに現実離れした情報を目の当たりにするみやび。\n\n普段だったら自動的に捨てるレベルの情報だが、今回はエリカからである。観念を持たずに冷静に判断する必要がありそうだ。"}
