        { "location": "220/SCENARIO", "narrator": "", "text": "揺れて揺られて"},
        { "location": "247/TALK"    , "narrator": "つばめ", "text": "ぁのね"},
        { "location": "248/TALK"    , "narrator": "つばめ", "text": "アーヤさんゎ、ぁたしより大人でお姉さんなのに自分の気持ちがわからなぃことがあるってぃってた"},
        { "location": "250/SEL"     , "narrator": "", "text": "そういうもんだよ"},
        { "location": "251/SEL"     , "narrator": "", "text": "修業が足りないよね"},
        { "location": "252/SEL"     , "narrator": "", "text": "つばめは違うの？"},
        { "location": "253/TALK"    , "narrator": "つばめ", "text": "それから"},
        { "location": "254/TALK"    , "narrator": "つばめ", "text": "キモチだけの問題じゃなぃこともいっぱぃあるんだって"},
        { "location": "255/ACT"     , "narrator": "", "text": "そういうもんだよ"},
        { "location": "256/TALK"    , "narrator": "つばめ", "text": "$handle$さんもそうだからそういうの？"},
        { "location": "258/ACT"     , "narrator": "", "text": "修業が足りないよね"},
        { "location": "259/TALK"    , "narrator": "つばめ", "text": "修業・・・"},
        { "location": "262/ACT"     , "narrator": "", "text": "つばめは違うの？"},
        { "location": "273/TALK"    , "narrator": "つばめ", "text": "そぅかもしれなぃ"},
        { "location": "274/TALK"    , "narrator": "つばめ", "text": "$handle$さんは"},
        { "location": "275/TALK"    , "narrator": "つばめ", "text": "ぁたしの気持ちわかってるんだね"},
        { "location": "276/TALK"    , "narrator": "つばめ", "text": "ヾ(*´ｴ`*)ﾉ"},
        { "location": "278/TALK"    , "narrator": "つばめ", "text": "アーヤさんゎ自分のおねえさんとのことがそぅなんだって言ってた"},
        { "location": "279/TALK"    , "narrator": "つばめ", "text": "そうぃえばお姉さんがいるって話は聞いたことがあったきがする(*´﹃｀*)"},
        { "location": "280/TALK"    , "narrator": "つばめ", "text": "ぁたしは一人っ子だからぅらやましぃな"},
        { "location": "282/SEL"     , "narrator": "", "text": "お兄ちゃんがここにいるよ"},
        { "location": "283/SEL"     , "narrator": "", "text": "一人っ子の方が気楽でいいよ"},
        { "location": "284/SEL"     , "narrator": "", "text": "兄弟が欲しいの？"},
        { "location": "285/ACT"     , "narrator": "", "text": "お兄ちゃんがここにいるよ"},
        { "location": "286/TALK"    , "narrator": "つばめ", "text": "そぅだったヽ(*´∀｀)ノ"},
        { "location": "288/TALK"    , "narrator": "つばめ", "text": "おにぃちゃん！"},
        { "location": "289/ACT"     , "narrator": "", "text": "一人っ子の方が気楽でいいよ"},
        { "location": "290/TALK"    , "narrator": "つばめ", "text": "そぅかな(●´ω｀●)ゞ"},
        { "location": "291/TALK"    , "narrator": "つばめ", "text": "だったらぃぃかな(・ω<)"},
        { "location": "292/ACT"     , "narrator": "", "text": "兄弟が欲しいの？"},
        { "location": "293/TALK"    , "narrator": "つばめ", "text": "ぅーん_(┐「ε:)_"},
        { "location": "294/TALK"    , "narrator": "つばめ", "text": "時々うらやましぃとは思うけど(●´ω｀●)"},
        { "location": "296/TALK"    , "narrator": "つばめ", "text": "んとね"},
        { "location": "297/TALK"    , "narrator": "つばめ", "text": "キモチだけの問題じゃなぃこともいっぱぃあるってアーヤさん言ってたけど"},
        { "location": "298/TALK"    , "narrator": "つばめ", "text": "$handle$さんもそぅ思う？"},
        { "location": "300/SEL"     , "narrator": "", "text": "お金の問題とか"},
        { "location": "301/SEL"     , "narrator": "", "text": "我慢しろってことかな"},
        { "location": "302/SEL"     , "narrator": "", "text": "キモチいいのが一番"},
        { "location": "303/ACT"     , "narrator": "", "text": "お金の問題とか"},
        { "location": "304/TALK"    , "narrator": "つばめ", "text": "ぅーん_(┐「ε:)_"},
        { "location": "306/TALK"    , "narrator": "つばめ", "text": "確かに大事かもしれなぃね・・・"},
        { "location": "307/ACT"     , "narrator": "", "text": "我慢しろってことかな"},
        { "location": "308/TALK"    , "narrator": "つばめ", "text": "我慢かぁ_(┐「ε:)"},
        { "location": "309/TALK"    , "narrator": "つばめ", "text": "ぁたしわがまま言ってるのかな・・・"},
        { "location": "310/TALK"    , "narrator": "つばめ", "text": "(´・ω・｀)(´・ω・｀)"},
        { "location": "311/ACT"     , "narrator": "", "text": "キモチいいのが一番"},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "えΣ(ﾟдﾟ)"},
        { "location": "322/TALK"    , "narrator": "つばめ", "text": "なにそれ"},
        { "location": "323/TALK"    , "narrator": "つばめ", "text": "ぁたしなんかえっちなこと言った？"},
        { "location": "324/TALK"    , "narrator": "つばめ", "text": "いってないよ！？！？！？！"},
        { "location": "325/TALK"    , "narrator": "つばめ", "text": "もーo(*･ﾛ･*)o"},
        { "location": "326/TALK"    , "narrator": "つばめ", "text": "$handle$さんのえっちー(●ﾉωﾉ)"},
        { "location": "328/TALK"    , "narrator": "つばめ", "text": "もし"},
        { "location": "329/TALK"    , "narrator": "つばめ", "text": "ぁたしがぁたしの気持ちがわからなくなった時は"},
        { "location": "330/TALK"    , "narrator": "つばめ", "text": "どうすればぃぃと思ぅ？"},
