{
    "dir": "chap10/daydra/dd_ch03_10_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "10352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "相撲のチケット"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "相撲のチケット"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…失敗したわ。"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "どうしたらいいと思う？"},
        { "location": "40/SEL"    , "narrator": "", "text": "何が？"},
        { "location": "41/ACT"    , "narrator": "", "text": "何が？"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "相撲のチケットを買ったの"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "けど、間違えて"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "二枚買っちゃってたの"},
        { "location": "47/SEL"    , "narrator": "", "text": "返品はできるの？"},
        { "location": "48/ACT"    , "narrator": "", "text": "返品はできるの？"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "出来るとは思うけど"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "せっかくだから誰か誘おうかしら？"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "相撲はまだ行ったことないから"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "誰かと一緒の方がいいかもしれないし"},
        { "location": "58/SEL"    , "narrator": "", "text": "みやびを誘おう"},
        { "location": "59/SEL"    , "narrator": "", "text": "アーヤを誘おう"},
        { "location": "60/SEL"    , "narrator": "", "text": "つばめを誘おう"},
        { "location": "61/ACT"    , "narrator": "", "text": "みやびを誘おう"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "みやび？"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "確かに相撲とか好きそうな感じかも"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "声かけてみるわ"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "さてと、教室に行けば\nいるかしら？"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "…花も恥らう女子中学生、\nしかも留学生から――"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "何が悲しくて相撲なんぞに\n誘われなあかんのか…。"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "何よ、文句あるの？"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "いんや、ガブちゃんは\n特別やなぁと感心した\nだけやき。"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "えいよ。その誘い、\nありがたく受けるがよ。"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "まったく…ちゃんと\n予定空けときなさいよ？"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "わかっとるき、安心せい。"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "しっかし、相撲か…\nうちも一度行ってみたい\n思うてたんよ。"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "へぇ、そうだったんだ？"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "うん。一度でえいから\nおもいっきり座布団を\n投げてみたくてな…。"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "…ちゃんと相撲も\n見なさいよ？"},
        { "location": "102/ACT"   , "narrator": "", "text": "アーヤを誘おう"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "まあ無難な人選よね"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "ていうか"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "アーヤくらいしかいないし"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "相撲のチケットって…\n凄いもの買ったわね？"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "一度、実際にこの目で\n見てみたかったのよ。"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "まあ、私もテレビでしか\n見たことがないから、\nちょっと興味あるかも。"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "けど、私でいいの？\n力士の名前はまったく\n知らないんだけど…。"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "いいんじゃない？\nあたしも有名な人くらい\nしかしらないんだし。"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "それなら、ありがたく\nご一緒させてもらうわ。"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "決まりね。\n当日はちゃんと予定\n空けておいてよ？"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "まあ、アーヤなら断らない\nとは思ってたから、\n予想通りの結果ね。"},
        { "location": "133/ACT"   , "narrator": "", "text": "つばめを誘おう"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "もぉ、どうして新人を誘わなきゃいけないのよ"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "てか"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "相撲に興味を持ってもいなさそうなのに"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり、アーヤでも誘うわ"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "まったく…。"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "あ、でもこれって\n良いチャンスかも。"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "相撲なんて見に行ったこと\nなさそうな新人に――"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "人生経験を積ませて、\n先輩のありがたさを\n教えられそうだし。"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、気は乗らないけど\n仕方ないわね。"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "というわけで、新人。\nあんたにこのチケットを\nあげるわ。"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "わぁ、本当にいいん\nですか！？"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "ええ…まあ、あんたが\n相撲見ても楽しいとは\n思えないだろうけど――"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "人生経験を積むって\nことで、一度くらいは…。"},
        { "location": "170/TALK"  , "narrator": "つばめ", "text": "すっごく嬉しいです！"},
        { "location": "173/TALK"  , "narrator": "ガブリエラ", "text": "…え？"},
        { "location": "174/TALK"  , "narrator": "つばめ", "text": "わたし、一度お相撲を\n見に行ってみたかったん\nです。"},
        { "location": "175/TALK"  , "narrator": "つばめ", "text": "せんぱいは、実際に\n見に行ったことは\nあるんですか？"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "な、ないけど…。"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "じゃあ、お互い\n初めて同士ですね。"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "早く見に行きたいなぁ…\n当日が待ち遠しいよぉ。"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "…なんか、めちゃくちゃ\n喜んでるみたい。"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "本当は、アーヤとかの方が\nよかった気もするけど――"},
        { "location": "183/TALK"  , "narrator": "ガブリエラ", "text": "今回ばかりは、新人を\n誘ってよかったかも。"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月15日　10:20 AM</color>\nとある平日の午前中、\n附属学園廊下にて。"},
        { "location": "195/DIALOG", "narrator": "Dialog_GEThimegoto_ch03", "text": "【平成立ち合いスモウガール】"}
    ]
}
