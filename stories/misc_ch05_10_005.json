    [
        { "location": "2729/SCENARIO", "narrator": "", "text": "ケルベロスにお手"},
        { "location": "2754/TALK"    , "narrator": "神楽", "text": "地獄の番犬ケルベロスにお手を教えるにはどうすればいいかが知りたいぴょん"},
        { "location": "2756/SEL"     , "narrator": "", "text": "えと…何で？"},
        { "location": "2757/SEL"     , "narrator": "", "text": "もう$me$が教えたよ"},
        { "location": "2758/SEL"     , "narrator": "", "text": "そもそもどうやって行くのｗ"},
        { "location": "2759/ACT"     , "narrator": "", "text": "えと…何で？"},
        { "location": "2760/TALK"    , "narrator": "神楽", "text": "楽しそうだから？"},
        { "location": "2761/ACT"     , "narrator": "", "text": "もう$me$が教えたよ"},
        { "location": "2764/TALK"    , "narrator": "神楽", "text": "ちょっと今すぐやってみせて！"},
        { "location": "2765/TALK"    , "narrator": "神楽", "text": "動画サイトに投稿するから！！！"},
        { "location": "2766/ACT"     , "narrator": "", "text": "そもそもどうやって行くのｗ"},
        { "location": "2767/TALK"    , "narrator": "神楽", "text": "自分で調べろ"},
        { "location": "2769/TALK"    , "narrator": "神楽", "text": "ところでケルベロスの初期設定って頭５０個あったんだって"},
        { "location": "2771/TALK"    , "narrator": "神楽", "text": "多すぎねえ？"},
        { "location": "2773/SEL"     , "narrator": "", "text": "さすがに盛りすぎだろｗ"},
        { "location": "2774/SEL"     , "narrator": "", "text": "キャラデザ泣かせだなー"},
        { "location": "2775/SEL"     , "narrator": "", "text": "神楽なら５０人でも足りないよ！"},
        { "location": "2776/ACT"     , "narrator": "", "text": "さすがに盛りすぎだろｗ"},
        { "location": "2777/TALK"    , "narrator": "神楽", "text": "でしょｗｗｗ"},
        { "location": "2778/ACT"     , "narrator": "", "text": "キャラデザ泣かせだなー"},
        { "location": "2779/TALK"    , "narrator": "神楽", "text": "な？"},
        { "location": "2780/ACT"     , "narrator": "", "text": "神楽なら５０人でも足りないよ！"},
        { "location": "2782/TALK"    , "narrator": "神楽", "text": "$handlek$は神楽に対して欲張りぴょん♪"},
        { "location": "2783/TALK"    , "narrator": "神楽", "text": "その重い愛がたまらないデュフフ"},
        { "location": "2785/TALK"    , "narrator": "神楽", "text": "しかもケルベロス、神話でもらったことになってる食べ物ってパンとか炭水化物系ばっかりなんだけど"},
        { "location": "2786/TALK"    , "narrator": "神楽", "text": "ひょっとしてアイツ、肉食獣じゃないのかな！？"},
        { "location": "2787/TALK"    , "narrator": "神楽", "text": "野生の力を取り戻せケルベロス！！！"},
        { "location": "2788/TALK"    , "narrator": "神楽", "text": "いや番犬だから飼いならされてるって暗示なのかもしれず"},
        { "location": "2790/TALK"    , "narrator": "神楽", "text": "ケルベロスに対する興味は尽きないね！"},
        { "location": "2791/TALK"    , "narrator": "神楽", "text": "ほんとはどうでもいいんだけどね☆彡"}
    ]
}
