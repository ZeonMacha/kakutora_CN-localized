        { "location": "3286/TALK"    , "narrator": "神楽", "text": "そうだから！！！"},
        { "location": "3287/ACT"     , "narrator": "", "text": "だろうね"},
        { "location": "3288/TALK"    , "narrator": "神楽", "text": "わかってて言ってるとか！！"},
        { "location": "3289/TALK"    , "narrator": "神楽", "text": "はーあーあーあーあー！"},
        { "location": "3290/ACT"     , "narrator": "", "text": "$me$は特別でしょ？"},
