        { "location": "3279/TALK"    , "narrator": "神楽", "text": "なんだろ、、、"},
        { "location": "3280/TALK"    , "narrator": "神楽", "text": "ぴょんこにとってはステージに上がるより全然恥ずかしいんだけどそういうの！"},
        { "location": "3282/SEL"     , "narrator": "", "text": "そうなんだ"},
        { "location": "3283/SEL"     , "narrator": "", "text": "だろうね"},
        { "location": "3284/SEL"     , "narrator": "", "text": "$me$は特別でしょ？"},
