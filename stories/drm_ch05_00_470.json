        { "location": "3292/TALK"    , "narrator": "神楽", "text": "そうなんだけど！"},
        { "location": "3293/TALK"    , "narrator": "神楽", "text": "それは間違いないけど！！！"},
        { "location": "3294/TALK"    , "narrator": "神楽", "text": "何その聞き方"},
        { "location": "3297/TALK"    , "narrator": "神楽", "text": "ﾊｧｧ、、、"},
        { "location": "3299/TALK"    , "narrator": "神楽", "text": "$handle$はさー"},
        { "location": "3300/TALK"    , "narrator": "神楽", "text": "そういうことばっかり言ってくるよね、、、"},
        { "location": "3302/SEL"     , "narrator": "", "text": "だって言わないと伝わらないから"},
        { "location": "3303/SEL"     , "narrator": "", "text": "恋人として言っとかないと"},
        { "location": "3304/SEL"     , "narrator": "", "text": "言われたくなかったかな…"},
        { "location": "3305/ACT"     , "narrator": "", "text": "だって言わないと伝わらないから"},
        { "location": "3306/TALK"    , "narrator": "神楽", "text": "そういうのはあるかも"},
        { "location": "3307/ACT"     , "narrator": "", "text": "恋人として言っとかないと"},
        { "location": "3308/TALK"    , "narrator": "神楽", "text": "なんだか今日の$handle$は強気♪"},
        { "location": "3309/ACT"     , "narrator": "", "text": "言われたくなかったかな…"},
        { "location": "3310/TALK"    , "narrator": "神楽", "text": "そういうのとも"},
        { "location": "3311/TALK"    , "narrator": "神楽", "text": "ちょっと違くて"},
        { "location": "3312/TALK"    , "narrator": "神楽", "text": "なんだろ、、、"},
        { "location": "3313/TALK"    , "narrator": "神楽", "text": "慣れてない？？？"},
        { "location": "3315/TALK"    , "narrator": "神楽", "text": "ぴょんこは$handle$とこれからも話したい"},
        { "location": "3316/TALK"    , "narrator": "神楽", "text": "でも時々さー$handle$がびっくりするようなこと言うから"},
        { "location": "3317/TALK"    , "narrator": "神楽", "text": "うーんってなるの"},
        { "location": "3318/TALK"    , "narrator": "神楽", "text": "でもそれって$handle$がぴょんこに感じてることでもあるのかなって"},
        { "location": "3319/TALK"    , "narrator": "神楽", "text": "だったらお互いさまで仕方ないよね★"},
