        { "location": "3264/SEL"     , "narrator": "", "text": "そんな神楽も受け止めたいんだ"},
        { "location": "3265/ACT"     , "narrator": "", "text": "$me$の前では泣いてもいいんだよ"},
        { "location": "3266/TALK"    , "narrator": "神楽", "text": "だからそれは！"},
        { "location": "3267/ACT"     , "narrator": "", "text": "泣きたい時は無理しないで"},
        { "location": "3268/TALK"    , "narrator": "神楽", "text": "ぴょんこ無理なんて"},
        { "location": "3269/TALK"    , "narrator": "神楽", "text": "してるけど"},
        { "location": "3270/TALK"    , "narrator": "神楽", "text": "してるけど！！！！"},
        { "location": "3271/ACT"     , "narrator": "", "text": "そんな神楽も受け止めたいんだ"},
        { "location": "3272/TALK"    , "narrator": "神楽", "text": "おおおおおおお"},
