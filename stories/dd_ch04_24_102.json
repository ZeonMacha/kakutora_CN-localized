{
    "dir": "chap24/daydra/dd_ch04_24_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "24405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "貴方を案ずる手紙＜後編＞"
    },
    "entry":
    [
        { "location": "542/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "543/TALK"  , "narrator": "みやび", "text": "いや、違うな。"},
        { "location": "555/TALK"  , "narrator": "みやび", "text": "結論"},
        { "location": "556/TALK"  , "narrator": "みやび", "text": "やはりうちは正しい"},
        { "location": "557/TALK"  , "narrator": "みやび", "text": "うちは卯月に対して怒ってない"},
        { "location": "558/TALK"  , "narrator": "みやび", "text": "証拠もあるので間違いない"},
        { "location": "560/SEL"   , "narrator": "", "text": "どんな証拠？"},
        { "location": "561/ACT"   , "narrator": "", "text": "どんな証拠？"},
        { "location": "563/TALK"  , "narrator": "みやび", "text": "うちは卯月を責めていない"},
        { "location": "564/TALK"  , "narrator": "みやび", "text": "許さんとも思うてない"},
        { "location": "565/TALK"  , "narrator": "みやび", "text": "謝って責任を取り"},
        { "location": "566/TALK"  , "narrator": "みやび", "text": "条件さえ整えば再び受け入れる気でいる"},
        { "location": "567/TALK"  , "narrator": "みやび", "text": "これが証拠や"},
        { "location": "569/SEL"   , "narrator": "", "text": "謝って責任とるだけじゃダメなの？"},
        { "location": "570/ACT"   , "narrator": "", "text": "謝って責任とるだけじゃダメなの？"},
        { "location": "572/TALK"  , "narrator": "みやび", "text": "当たり前や"},
        { "location": "573/TALK"  , "narrator": "みやび", "text": "謝罪と責任程度で済む話か？"},
        { "location": "574/TALK"  , "narrator": "みやび", "text": "卯月はスパイや"},
        { "location": "575/TALK"  , "narrator": "みやび", "text": "またうちらをスパイする必要が出れば"},
        { "location": "576/TALK"  , "narrator": "みやび", "text": "謝罪と責任を取る程度のこと"},
        { "location": "578/TALK"  , "narrator": "みやび", "text": "平然とやるに違いない"},
        { "location": "579/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "580/TALK"  , "narrator": "みやび", "text": "スパイならやると考えるべき"},
        { "location": "581/TALK"  , "narrator": "みやび", "text": "なので"},
        { "location": "582/TALK"  , "narrator": "みやび", "text": "卯月神楽が"},
        { "location": "583/TALK"  , "narrator": "みやび", "text": "スパイであることに何の理由もなくなる状況"},
        { "location": "584/TALK"  , "narrator": "みやび", "text": "それが必要になる"},
        { "location": "585/TALK"  , "narrator": "みやび", "text": "そうなれば"},
        { "location": "586/TALK"  , "narrator": "みやび", "text": "再び受け入れることも可能やね"},
        { "location": "588/SEL"   , "narrator": "", "text": "そんな状況ありえるの？"},
        { "location": "589/SEL"   , "narrator": "", "text": "それを聞けて安心した"},
        { "location": "590/ACT"   , "narrator": "", "text": "そんな状況ありえるの？"},
        { "location": "591/TALK"  , "narrator": "みやび", "text": "そんなもん知らん"},
        { "location": "592/TALK"  , "narrator": "みやび", "text": "あるかもしれんが"},
        { "location": "593/TALK"  , "narrator": "みやび", "text": "ないかもしれん"},
        { "location": "594/TALK"  , "narrator": "みやび", "text": "それが具体的にどういう状況なのか"},
        { "location": "595/TALK"  , "narrator": "みやび", "text": "それもうちにはわからん"},
        { "location": "596/TALK"  , "narrator": "みやび", "text": "けんど"},
        { "location": "597/TALK"  , "narrator": "みやび", "text": "そうやなければ受け入れられん"},
        { "location": "598/TALK"  , "narrator": "みやび", "text": "不安が残るきね"},
        { "location": "599/TALK"  , "narrator": "みやび", "text": "それに"},
        { "location": "600/TALK"  , "narrator": "みやび", "text": "卯月も安心して戻れんだろうし"},
        { "location": "603/TALK"  , "narrator": "みやび", "text": "けんどまあ"},
        { "location": "604/TALK"  , "narrator": "みやび", "text": "卯月が戻ってきたいと思っているのか"},
        { "location": "605/TALK"  , "narrator": "みやび", "text": "それすら今はわからんのやし"},
        { "location": "606/TALK"  , "narrator": "みやび", "text": "この話題はまだ早すぎるな"},
        { "location": "607/ACT"   , "narrator": "", "text": "それを聞けて安心した"},
        { "location": "608/TALK"  , "narrator": "みやび", "text": "何故安心できるのか？"},
        { "location": "609/TALK"  , "narrator": "みやび", "text": "今うちが言うた条件"},
        { "location": "610/TALK"  , "narrator": "みやび", "text": "かなり酷やぞ？"},
        { "location": "611/TALK"  , "narrator": "みやび", "text": "ぶっちゃけほぼ無理レベルやし"},
        { "location": "612/TALK"  , "narrator": "みやび", "text": "それわかってる？"},
        { "location": "614/SEL"   , "narrator": "", "text": "条件がわかってるだけでも安心"},
        { "location": "615/ACT"   , "narrator": "", "text": "条件がわかってるだけでも安心"},
        { "location": "617/TALK"  , "narrator": "みやび", "text": "そういうもんか？"},
        { "location": "618/TALK"  , "narrator": "みやび", "text": "まあぶっちゃけ"},
        { "location": "619/TALK"  , "narrator": "みやび", "text": "それが一番えい結果なのは確かやね"},
        { "location": "620/TALK"  , "narrator": "みやび", "text": "ゲームで言うならベストエンド"},
        { "location": "621/TALK"  , "narrator": "みやび", "text": "超絶難易度を超えた先にある真のエンディングとは！？"},
        { "location": "622/TALK"  , "narrator": "みやび", "text": "みたいな？"},
        { "location": "623/TALK"  , "narrator": "みやび", "text": "しかもセーブもロードもなし"},
        { "location": "624/TALK"  , "narrator": "みやび", "text": "現実は厳しい"},
        { "location": "625/TALK"  , "narrator": "みやび", "text": "あまり期待はせん方がえいよ"},
        { "location": "627/TALK"  , "narrator": "みやび", "text": "まあ結局のとこ"},
        { "location": "628/TALK"  , "narrator": "みやび", "text": "卯月が今後どう動くか"},
        { "location": "629/TALK"  , "narrator": "みやび", "text": "それを見てからやね"},
        { "location": "640/TALK"  , "narrator": "みやび", "text": "はぁ…。\n小さい画面で長話は\n目に来るなぁ…。"},
        { "location": "646/TALK"  , "narrator": "みやび", "text": "…ったく、\n今度は誰や！？"},
        { "location": "647/TALK"  , "narrator": "みやび", "text": "はい、もしもし？"},
        { "location": "648/TALK"  , "narrator": "透明真幌", "text": "私だ。"},
        { "location": "649/TALK"  , "narrator": "みやび", "text": "ああ、まほさん。\n管理庁への申し立ては\nどうなって――"},
        { "location": "650/TALK"  , "narrator": "透明真幌", "text": "その話はあとだ。\nいいか、よく聞け。"},
        { "location": "651/TALK"  , "narrator": "透明真幌", "text": "今すぐ全員を集めて、\n準備を開始するんだ。"},
        { "location": "653/TALK"  , "narrator": "みやび", "text": "準備？"},
        { "location": "654/TALK"  , "narrator": "透明真幌", "text": "そうだ。"},
        { "location": "655/TALK"  , "narrator": "透明真幌", "text": "現時刻をもって、\n我々は無期限の\nストライキに入る！"},
        { "location": "656/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "657/TALK"  , "narrator": "みやび", "text": "はい？"},
        { "location": "669/DIALOG", "narrator": "Dialog_chapter_ch04", "text": "【20 ２０１６】"}
    ]
}
