        "title": "らぶとーく 第26話",
        "sub_title": "不特定多数の個人的主観"
    },
    "entry":
    [
        { "location": "192/SCENARIO", "narrator": "", "text": "不特定多数の個人的主観"},
        { "location": "201/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "202/TALK"    , "narrator": "繭", "text": "…どうかしましたか？"},
        { "location": "204/TALK"    , "narrator": "みやび", "text": "いや、隣がちょっと。"},
        { "location": "206/TALK"    , "narrator": "繭", "text": "？"},
        { "location": "215/TALK"    , "narrator": "女子高校生Ａ", "text": "ちょっと、真面目に\n聞いてるの？"},
        { "location": "217/TALK"    , "narrator": "男子高校生Ａ", "text": "聞いてるって。\nあんま大きな声出すなよ。"},
        { "location": "218/TALK"    , "narrator": "女子高校生Ａ", "text": "だって、不安だし…"},
        { "location": "219/TALK"    , "narrator": "女子高校生Ａ", "text": "二カ月も来てないのよ？\n絶対変よ。"},
        { "location": "220/TALK"    , "narrator": "男子高校生Ａ", "text": "知らねぇよ。\n俺が出したわけじゃ\nねぇんだし。"},
        { "location": "221/TALK"    , "narrator": "女子高校生Ａ", "text": "そんな、酷い！"},
        { "location": "230/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "237/TALK"    , "narrator": "みやび", "text": "光月さんよ"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "うちはドラマの世界に入ったようや"},
        { "location": "240/TALK"    , "narrator": "繭", "text": "ここは現実です"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "マジ？"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "異世界召喚されてない？"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "ここ日本？"},
        { "location": "245/TALK"    , "narrator": "繭", "text": "落ち着いて"},
        { "location": "246/TALK"    , "narrator": "繭", "text": "あれは修羅場ってるだけのカップル"},
        { "location": "247/TALK"    , "narrator": "みやび", "text": "それ聞いて安心"},
        { "location": "250/TALK"    , "narrator": "繭", "text": "修羅場ってるカップルの隣でそのスタンプはどうかと"},
        { "location": "251/TALK"    , "narrator": "みやび", "text": "けんど"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "やっぱりアレかね"},
        { "location": "256/TALK"    , "narrator": "繭", "text": "ど、どうでしょうか"},
        { "location": "257/TALK"    , "narrator": "みやび", "text": "明言を避けるか"},
        { "location": "258/TALK"    , "narrator": "みやび", "text": "なら"},
        { "location": "259/TALK"    , "narrator": "みやび", "text": "おーい相棒！！"},
        { "location": "261/SEL"     , "narrator": "", "text": "どうしたの？"},
        { "location": "262/ACT"     , "narrator": "", "text": "どうしたの？"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "よく来た"},
        { "location": "267/TALK"    , "narrator": "繭", "text": "こんにちは"},
        { "location": "268/TALK"    , "narrator": "みやび", "text": "早速やけんど"},
        { "location": "269/TALK"    , "narrator": "みやび", "text": "隣の席を見てみぃ"},
        { "location": "270/TALK"    , "narrator": "みやび", "text": "修羅場ってるカップルがいるのがわかるやろ？"},
        { "location": "271/TALK"    , "narrator": "みやび", "text": "奴らの会話を傍受頼む"},
        { "location": "273/TALK"    , "narrator": "繭", "text": "傍受機能をお持ちで？"},
        { "location": "274/SEL"     , "narrator": "", "text": "…あ、あるよ"},
        { "location": "275/ACT"     , "narrator": "", "text": "…あ、あるよ"},
        { "location": "279/TALK"    , "narrator": "繭", "text": "機能がないだけに"},
        { "location": "280/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "281/TALK"    , "narrator": "みやび", "text": "ある言うたんやき"},
        { "location": "283/TALK"    , "narrator": "みやび", "text": "奴らの会話を傍受せぃ！"},
        { "location": "285/TALK"    , "narrator": "繭", "text": "期待する"},
        { "location": "286/SEL"     , "narrator": "", "text": "傍受開始"},
        { "location": "287/ACT"     , "narrator": "", "text": "傍受開始"},
        { "location": "289/TALK"    , "narrator": "繭", "text": "してますね"},
        { "location": "290/TALK"    , "narrator": "みやび", "text": "傍受開始"},
        { "location": "291/TALK"    , "narrator": "みやび", "text": "この言葉かっこいい"},
        { "location": "293/TALK"    , "narrator": "繭", "text": "わかる"},
        { "location": "294/TALK"    , "narrator": "繭", "text": "気分はスパイ映画"},
        { "location": "295/TALK"    , "narrator": "みやび", "text": "ビバハリウッド"},
        { "location": "297/TALK"    , "narrator": "繭", "text": "微妙に古ッ　＞ビバ"},
        { "location": "299/SEL"     , "narrator": "", "text": "傍受完了"},
        { "location": "300/ACT"     , "narrator": "", "text": "傍受完了"},
        { "location": "302/TALK"    , "narrator": "繭", "text": "お疲れ様です"},
        { "location": "303/TALK"    , "narrator": "みやび", "text": "早速報告せぃ、エージェント"},
        { "location": "305/SEL"     , "narrator": "", "text": "別れ話"},
        { "location": "306/SEL"     , "narrator": "", "text": "進路相談"},
        { "location": "307/SEL"     , "narrator": "", "text": "人類の存亡について"},
        { "location": "308/ACT"     , "narrator": "", "text": "別れ話"},
        { "location": "309/TALK"    , "narrator": "みやび", "text": "なんと！？"},
        { "location": "312/TALK"    , "narrator": "繭", "text": "恋する二人別れる二人"},
        { "location": "313/TALK"    , "narrator": "みやび", "text": "こんな真昼間のカフェでか！？"},
        { "location": "314/TALK"    , "narrator": "みやび", "text": "あの男"},
        { "location": "315/TALK"    , "narrator": "みやび", "text": "最悪やな"},
        { "location": "316/TALK"    , "narrator": "みやび", "text": "こんな昼間のカフェでとか"},
        { "location": "317/TALK"    , "narrator": "みやび", "text": "気遣いがない！"},
        { "location": "319/TALK"    , "narrator": "繭", "text": "俗に言うだめんず？"},
        { "location": "320/TALK"    , "narrator": "みやび", "text": "ダメ男や"},
        { "location": "322/SEL"     , "narrator": "", "text": "別れたいのは女の子の方かも"},
        { "location": "323/ACT"     , "narrator": "", "text": "別れたいのは女の子の方かも"},
        { "location": "325/TALK"    , "narrator": "繭", "text": "そんな感じがしなくもない"},
        { "location": "326/TALK"    , "narrator": "みやび", "text": "アホな子やね"},
        { "location": "327/TALK"    , "narrator": "みやび", "text": "別れたい思うてるなら"},
        { "location": "328/TALK"    , "narrator": "みやび", "text": "さっさと別れればえいのに"},
        { "location": "330/SEL"     , "narrator": "", "text": "そう思う？"},
        { "location": "331/ACT"     , "narrator": "", "text": "そう思う？"},
        { "location": "333/TALK"    , "narrator": "みやび", "text": "別れたい思うてる時点で愛が覚めた証拠や"},
        { "location": "334/TALK"    , "narrator": "みやび", "text": "一緒にいても時間の無駄"},
        { "location": "335/TALK"    , "narrator": "みやび", "text": "うちやったらバッサリ連絡断ち切る"},
        { "location": "337/TALK"    , "narrator": "繭", "text": "ズルズルしないだけ良いかも"},
        { "location": "338/TALK"    , "narrator": "みやび", "text": "光月さんも気をつけれ"},
        { "location": "339/TALK"    , "narrator": "みやび", "text": "ダラダラした恋愛したらいかんぞ"},
        { "location": "341/TALK"    , "narrator": "繭", "text": "心配無用"},
        { "location": "342/TALK"    , "narrator": "繭", "text": "興味なしなので"},
        { "location": "343/TALK"    , "narrator": "みやび", "text": "ロンリーウルフ？"},
        { "location": "344/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "345/TALK"    , "narrator": "みやび", "text": "ぼっち女子高生？"},
        { "location": "347/TALK"    , "narrator": "繭", "text": "さすがにその言い方はちょっと……"},
        { "location": "348/ACT"     , "narrator": "", "text": "進路相談"},
        { "location": "349/TALK"    , "narrator": "みやび", "text": "カフェに来て進路相談？"},
        { "location": "351/TALK"    , "narrator": "みやび", "text": "色気の無いカップルや"},
        { "location": "353/TALK"    , "narrator": "繭", "text": "倦怠期なのかも"},
        { "location": "354/TALK"    , "narrator": "みやび", "text": "別れの扉は目の前に"},
        { "location": "356/SEL"     , "narrator": "", "text": "二人の将来に掛かってくる話だよ"},
        { "location": "357/ACT"     , "narrator": "", "text": "二人の将来に掛かってくる話だよ"},
        { "location": "359/TALK"    , "narrator": "繭", "text": "一理あります"},
        { "location": "360/TALK"    , "narrator": "繭", "text": "愛だけでは生きていけないので"},
        { "location": "361/TALK"    , "narrator": "みやび", "text": "なるほど"},
        { "location": "362/TALK"    , "narrator": "みやび", "text": "得るものはある会話やね"},
        { "location": "363/TALK"    , "narrator": "みやび", "text": "属性によって態度を変えるような人間かどうかは"},
        { "location": "364/TALK"    , "narrator": "みやび", "text": "早いうちにわかった方がダメージも少ない"},
        { "location": "366/TALK"    , "narrator": "繭", "text": "属性？"},
        { "location": "367/TALK"    , "narrator": "繭", "text": "職業的な？"},
        { "location": "368/TALK"    , "narrator": "みやび", "text": "ブルーカラーは嫌"},
        { "location": "369/TALK"    , "narrator": "みやび", "text": "ホワイトカラーがえいの"},
        { "location": "370/TALK"    , "narrator": "みやび", "text": "的なヤツ"},
        { "location": "372/TALK"    , "narrator": "繭", "text": "なるほど納得"},
        { "location": "373/ACT"     , "narrator": "", "text": "人類の存亡について"},
        { "location": "374/TALK"    , "narrator": "みやび", "text": "イタタタタ"},
        { "location": "376/TALK"    , "narrator": "みやび", "text": "それはまた大きな話題やね"},
        { "location": "378/TALK"    , "narrator": "繭", "text": "厨二病？"},
        { "location": "379/TALK"    , "narrator": "みやび", "text": "ＳＦマニア？"},
        { "location": "381/TALK"    , "narrator": "繭", "text": "破滅論者？"},
        { "location": "382/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "383/TALK"    , "narrator": "みやび", "text": "恋愛中の相手がいなくなることが"},
        { "location": "384/TALK"    , "narrator": "みやび", "text": "人類存亡以上の重大事項になるらしい"},
        { "location": "386/TALK"    , "narrator": "繭", "text": "個人にとっての世界なんて"},
        { "location": "387/TALK"    , "narrator": "繭", "text": "結局視界の届く範囲でしかないですし"},
        { "location": "388/TALK"    , "narrator": "繭", "text": "あながち間違ってないと思います"},
        { "location": "389/TALK"    , "narrator": "みやび", "text": "わからん"},
        { "location": "390/TALK"    , "narrator": "みやび", "text": "うちには理解できん"},
        { "location": "391/TALK"    , "narrator": "みやび", "text": "都市伝説みたいなもんや"},
        { "location": "393/TALK"    , "narrator": "繭", "text": "わかるかも"},
        { "location": "394/TALK"    , "narrator": "みやび", "text": "光月さんは乙女と認定"},
        { "location": "417/TALK"    , "narrator": "男子高校生Ａ", "text": "だから、俺に聞かれても\nわからねぇって言ってる\nだろ？"},
        { "location": "419/TALK"    , "narrator": "女子高校生Ａ", "text": "何で気にならないのよ！？\n二カ月も来てないなんて、\n絶対変よ！"},
        { "location": "428/TALK"    , "narrator": "繭", "text": "…あの、あまり\n聞き耳をたてるのも…。"},
        { "location": "430/TALK"    , "narrator": "みやび", "text": "しっ！\n黙って耳を澄ましぃ。"},
        { "location": "439/TALK"    , "narrator": "女子高校生Ａ", "text": "あんたのを出したのに、\nどうしてそんなに\n無関心なのよ！？"},
        { "location": "441/TALK"    , "narrator": "男子高校生Ａ", "text": "無関心に決まってんだろ！"},
        { "location": "442/TALK"    , "narrator": "男子高校生Ａ", "text": "俺の履歴書、勝手に\nオーディションなんかに\n送りやがって！"},
        { "location": "450/TALK"    , "narrator": "みやび", "text": "…は？"},
        { "location": "451/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "460/TALK"    , "narrator": "女子高校生Ａ", "text": "だって、よくテレビで\n見るじゃない。"},
        { "location": "461/TALK"    , "narrator": "女子高校生Ａ", "text": "友達が勝手に履歴書\n送ったら合格しちゃった、\nみたいなの。"},
        { "location": "463/TALK"    , "narrator": "男子高校生Ａ", "text": "いや、俺はそういうのに\n興味ねぇし。"},
        { "location": "465/TALK"    , "narrator": "女子高校生Ａ", "text": "何よ！\nあんたがかっこいいと\n思ったから出したのに…。"},
        { "location": "474/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "476/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "481/TALK"    , "narrator": "みやび", "text": "痴話ゲンカか！！"},
        { "location": "482/TALK"    , "narrator": "繭", "text": "修羅場でもなんでもない！！"},
        { "location": "484/SEL"     , "narrator": "", "text": "仲良しカップルで安心した"},
        { "location": "485/ACT"     , "narrator": "", "text": "仲良しカップルで安心した"},
        { "location": "487/TALK"    , "narrator": "みやび", "text": "うちはちっくと腹が立つわ"},
        { "location": "490/TALK"    , "narrator": "繭", "text": "同じく"},
        { "location": "491/TALK"    , "narrator": "繭", "text": "無駄な時間を過ごしました…"}
    ]
}
