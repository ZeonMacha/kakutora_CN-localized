{
    "dir": "chap24/daydra/dd_ch04_24_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "24402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "貴方を案ずる手紙＜前編＞"
    },
    "entry":
    [
        { "location": "31/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "…ウサギか？"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "珍しいなぁ。\nこんな時間に\nボイチャなんて。"},
        { "location": "44/TALK"   , "narrator": "透明繭", "text": "すみません。\nお邪魔でしたか？"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "いや、平気や。\nなんぞあったか？"},
        { "location": "46/TALK"   , "narrator": "透明繭", "text": "いえ…その、\n少々気になったことが\nあって…。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "？"},
        { "location": "48/TALK"   , "narrator": "透明繭", "text": "ここ数日、\nずっとログイン状態が\n続いています。"},
        { "location": "49/TALK"   , "narrator": "透明繭", "text": "ちゃんとお休みになって\nいないのではと思い、\n連絡しました。"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "…なんや、\nうちの体調心配してるが？"},
        { "location": "51/TALK"   , "narrator": "透明繭", "text": "度を越しているように\n思いましたので…。"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "ふむ…、\nまあ、そうやね。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "起きてるときは\nほぼほぼＰＣの前。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "疲れたら寝て、\n腹が減ったら食事する。"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "とまあ、いつもと\n変わらん生活を\nしちょるがよ。"},
        { "location": "56/TALK"   , "narrator": "透明繭", "text": "いえ、私が気にして\nいるのはそういうことでは\nありません。"},
        { "location": "57/TALK"   , "narrator": "透明繭", "text": "休む時間が\n極端に少なすぎるのが\n気になっているんです。"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "59/TALK"   , "narrator": "透明繭", "text": "どうなんですか？\n十分な休息をとって\nいますか？"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "62/TALK"   , "narrator": "透明繭", "text": "…そうですか。"},
        { "location": "63/TALK"   , "narrator": "透明繭", "text": "さしでがましいかも\nしれませんが、\n少しは休まれるべきです。"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "…疲れたらな。\n今は必要ないがよ。"},
        { "location": "66/TALK"   , "narrator": "透明繭", "text": "オーバーワークは\n身体を壊します。"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "わかっちょるけんど、\nやらにゃならん作業が\nわんさかあるがよ。"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "それに、今はうちらも\n大変な時期やきね。"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "出来る限り、\n作業は進めときたいんよ。"},
        { "location": "70/TALK"   , "narrator": "透明繭", "text": "…………。"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "わかってくれたか？"},
        { "location": "72/TALK"   , "narrator": "透明繭", "text": "みやび先輩…、\n相当お怒りのようですね？"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "…何やと？"},
        { "location": "74/TALK"   , "narrator": "透明繭", "text": "卯月神楽が裏切った\nことに対してです。"},
        { "location": "75/TALK"   , "narrator": "透明繭", "text": "みやび先輩も、\n相当お怒りだと\nいうのはわかります。"},
        { "location": "76/TALK"   , "narrator": "透明繭", "text": "ですが、オーバーワークは\n身体を壊しかねません。"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "…なるほどなぁ。"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "うちが卯月の裏切りに\n怒っちょる。"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "やき、寝る間も惜しんで\n作業に没頭しゆう\n思うちょるが？"},
        { "location": "80/TALK"   , "narrator": "透明繭", "text": "はい…違いますか？"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "即答するけんど、\n違うぞね。"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "別に、そのことで\nうちは怒ったり\nしてないがよ。"},
        { "location": "83/TALK"   , "narrator": "透明繭", "text": "…………。"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "信じられん？"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "けんど、うさぎなら\nうちの考え方は\nわかっちょるやろ？"},
        { "location": "87/TALK"   , "narrator": "透明繭", "text": "…なるほど。"},
        { "location": "88/TALK"   , "narrator": "透明繭", "text": "私の思い違いでした。\nすみません。"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "気にせんでえいよ。"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "…心配してくれて\nありがとな。"},
        { "location": "91/TALK"   , "narrator": "透明繭", "text": "…また、気になったら\n遠慮なく連絡させて\nいただきますので。"},
        { "location": "92/TALK"   , "narrator": "透明繭", "text": "それでは。"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "…ウサギのやつ、\n意外と強引なとこ\nあるがよ。"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "…そう見えるんやろか？"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "みやびさんクイズー"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "（ここで拍手）"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "さて"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "うちが怒ってるように見えると言われた"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "果たしてそうだろうか？"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "相棒にはどう見える？"},
        { "location": "109/SEL"   , "narrator": "", "text": "怒ってるでしょ"},
        { "location": "110/SEL"   , "narrator": "", "text": "悲しんでるね"},
        { "location": "111/SEL"   , "narrator": "", "text": "よくわからない"},
        { "location": "112/ACT"   , "narrator": "", "text": "怒ってるでしょ"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "ブー"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "大外れや"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "ちゅうか"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "マジで怒っちょるように見えるが？"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "怒りの矛先はむしろ"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "見破れなかった自分自身だ"},
        { "location": "120/ACT"   , "narrator": "", "text": "悲しんでるね"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "素っ頓狂なこと抜かす相棒に対して"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "悲しみを覚えずにはいられない"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "そんな悲しみであれば抱いてるかもしれん"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "けんど"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "卯月に対しては違うぞ"},
        { "location": "126/ACT"   , "narrator": "", "text": "よくわからない"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "クイズ形式にしたうちの気持ち"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "無駄にしよったな？"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "怒っているかどうかという"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "うちの問いに対する答えはどこへ？"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "酷い奴やね"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "アーヤ達は怒っちょるな"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "けんど"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "うちは違う"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "怒るべきところなのだろうか？"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "卯月はスパイ"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "スパイは対象にバレんよう行動し"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "仲間のようにふるまうもの"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "そして最後は去っていく"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "それは当然のこと"},
        { "location": "144/TALK"  , "narrator": "みやび", "text": "当然のことを怒る必要はない"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "はず"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "と言いつつむかつきを憶えるのは"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "うちがまだティーンエイジャーゆえ"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "それにまあ"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "どちらかというと"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "不安の方が大きいね"},
        { "location": "154/SEL"   , "narrator": "", "text": "神楽が相手だから？"},
        { "location": "155/SEL"   , "narrator": "", "text": "二重スパイに仕立て上げろ"},
        { "location": "156/SEL"   , "narrator": "", "text": "4対1だよ？"},
        { "location": "157/SEL"   , "narrator": "", "text": "もっと平和にできないのかな…？"},
        { "location": "158/ACT"   , "narrator": "", "text": "神楽が相手だから？"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "そりゃな"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "あいつ強いし"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "手強い相手になるだろう"},
        { "location": "163/ACT"   , "narrator": "", "text": "二重スパイに仕立て上げろ"},
        { "location": "164/TALK"  , "narrator": "みやび", "text": "なんというハリウッド映画"},
        { "location": "166/ACT"   , "narrator": "", "text": "4対1だよ？"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "残念だが"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "一小隊にも満たぬ味方対"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "政府とその関連組織だ"},
        { "location": "172/ACT"   , "narrator": "", "text": "もっと平和にできないのかな…？"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "そんな時期はとうに過ぎた"},
        { "location": "174/TALK"  , "narrator": "みやび", "text": "賽は投げられた"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "開戦やむなし"},
        { "location": "178/SEL"   , "narrator": "", "text": "仲間と戦うことに対して躊躇しないの？"},
        { "location": "179/SEL"   , "narrator": "", "text": "理由があってスパイしたのかも"},
        { "location": "180/ACT"   , "narrator": "", "text": "仲間と戦うことに対して躊躇しないの？"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "スパイは仲間ではない"},
        { "location": "182/TALK"  , "narrator": "みやび", "text": "戦うのは自己防衛の手段"},
        { "location": "183/TALK"  , "narrator": "みやび", "text": "うちは死にたくないし"},
        { "location": "186/TALK"  , "narrator": "みやび", "text": "そもそも"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "卯月にはずっと怪しいところがあった"},
        { "location": "188/TALK"  , "narrator": "みやび", "text": "なのに"},
        { "location": "189/TALK"  , "narrator": "みやび", "text": "本気で確認しなかった"},
        { "location": "190/TALK"  , "narrator": "みやび", "text": "うちの甘さも悪い"},
        { "location": "192/ACT"   , "narrator": "", "text": "理由があってスパイしたのかも"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "あって当然"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "理由もなくそんなことはしないはず"},
        { "location": "195/TALK"  , "narrator": "みやび", "text": "けんどな"},
        { "location": "196/TALK"  , "narrator": "みやび", "text": "それはそれ"},
        { "location": "197/TALK"  , "narrator": "みやび", "text": "これはこれや"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "うちらに対して行った行為に対しての"},
        { "location": "199/TALK"  , "narrator": "みやび", "text": "責任はちゃんと取ってもらう"},
        { "location": "200/TALK"  , "narrator": "みやび", "text": "不公平はいかんきね"},
        { "location": "203/SEL"   , "narrator": "", "text": "ちょっと冷たい気がする"},
        { "location": "204/SEL"   , "narrator": "", "text": "一時期は仲間だったんでしょ"},
        { "location": "205/ACT"   , "narrator": "", "text": "ちょっと冷たい気がする"},
        { "location": "206/TALK"  , "narrator": "みやび", "text": "何を言うか"},
        { "location": "207/TALK"  , "narrator": "みやび", "text": "相棒が甘すぎるだけや"},
        { "location": "208/TALK"  , "narrator": "みやび", "text": "生きるか死ぬかの戦いに"},
        { "location": "209/TALK"  , "narrator": "みやび", "text": "情けは無用！"},
        { "location": "210/TALK"  , "narrator": "みやび", "text": "わかったな？"},
        { "location": "211/ACT"   , "narrator": "", "text": "一時期は仲間だったんでしょ"},
        { "location": "212/TALK"  , "narrator": "みやび", "text": "それはもう"},
        { "location": "213/TALK"  , "narrator": "みやび", "text": "過去の話になった"},
        { "location": "214/TALK"  , "narrator": "みやび", "text": "以上"},
        { "location": "219/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "221/TALK"  , "narrator": "みやび", "text": "冷たいとまで\n言われるとは…。\nさすがに驚きや。"},
        { "location": "222/TALK"  , "narrator": "みやび", "text": "確かにドライな\n考え方かもしれん。"},
        { "location": "223/TALK"  , "narrator": "みやび", "text": "けんど、そんな度を越して\n冷たいやろか？"},
        { "location": "224/TALK"  , "narrator": "みやび", "text": "こっちは命が\nかかっちゅう。"},
        { "location": "225/TALK"  , "narrator": "みやび", "text": "当然の反応と\n思うけんど……。"},
        { "location": "226/TALK"  , "narrator": "みやび", "text": "…無意識に卯月に怒り、\nいつの間にか\nムキになっちゅう？"},
        { "location": "227/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "275/TALK"  , "narrator": "千羽鶴", "text": "　"},
        { "location": "318/TALK"  , "narrator": "千羽鶴", "text": "ようこそ、\n恋ヶ崎みやびの\nココロスフィアへ。"},
        { "location": "321/TALK"  , "narrator": "千羽鶴", "text": "國政綾水の\nココロゲートでも\n話をしたけども――"},
        { "location": "323/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラの\nココロゲートでも\n話をしたけども――"},
        { "location": "325/TALK"  , "narrator": "千羽鶴", "text": "恋ヶ崎みやびの\nココロゲートでも\n話をしたけども――"},
        { "location": "327/TALK"  , "narrator": "千羽鶴", "text": "次回から、\n彼女たちの心のメンテは\n私が直接やることにする。"},
        { "location": "328/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n今回だけはクランの\n消去を手伝って欲しい。"},
        { "location": "330/SEL"   , "narrator": "", "text": "なんで千羽鶴が！？"},
        { "location": "331/ACT"   , "narrator": "", "text": "なんで千羽鶴が！？"},
        { "location": "333/TALK"  , "narrator": "千羽鶴", "text": "前回のメンテナンスで\n権限拡大をしたから。"},
        { "location": "334/TALK"  , "narrator": "千羽鶴", "text": "これからは、\n私が直接ココロゲートを\n管理することにする。"},
        { "location": "335/SEL"   , "narrator": "", "text": "なにそれすごい"},
        { "location": "336/SEL"   , "narrator": "", "text": "なにそれやばい"},
        { "location": "337/ACT"   , "narrator": "", "text": "なにそれすごい"},
        { "location": "338/TALK"  , "narrator": "千羽鶴", "text": "本当は最初から\nこうしておく\nべきだった。"},
        { "location": "339/TALK"  , "narrator": "千羽鶴", "text": "だから、途中から\n方針転換をして\n準備はしていた。"},
        { "location": "340/TALK"  , "narrator": "千羽鶴", "text": "けど、OSの機能制限で\nなかなかできず。\nようやく前回実現した。"},
        { "location": "341/ACT"   , "narrator": "", "text": "なにそれやばい"},
        { "location": "342/TALK"  , "narrator": "千羽鶴", "text": "やばくなんかない。"},
        { "location": "343/TALK"  , "narrator": "千羽鶴", "text": "元々の想定では\n私が直接介入する\n予定だったんだから。"},
        { "location": "344/TALK"  , "narrator": "千羽鶴", "text": "けど、OSの機能制限で\nそれはできなかった。\nだから前回調整した。"},
        { "location": "346/SEL"   , "narrator": "", "text": "でも、チュートリアルでは$me$にしか出来ない役割だと…"},
        { "location": "347/ACT"   , "narrator": "", "text": "でも、チュートリアルでは$me$にしか出来ない役割だと…"},
        { "location": "349/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "350/SEL"   , "narrator": "", "text": "どうして、やろうと思えば自分でできたのに$me$にやらせたの？"},
        { "location": "351/ACT"   , "narrator": "", "text": "どうして、やろうと思えば自分でできたのに$me$にやらせたの？"},
        { "location": "353/TALK"  , "narrator": "千羽鶴", "text": "彼女の自由意志によって、\n理想的な世界を創造する\n道程を進んで欲しかった。"},
        { "location": "354/TALK"  , "narrator": "千羽鶴", "text": "私が介入するということは\n洗脳することと同義。"},
        { "location": "355/TALK"  , "narrator": "千羽鶴", "text": "私は貴方と違い、\n自身だけでクランを\n対処できない。"},
        { "location": "356/TALK"  , "narrator": "千羽鶴", "text": "よって、私にできることは\nクランが出る前に\nココロを固めること――"},
        { "location": "357/TALK"  , "narrator": "千羽鶴", "text": "すなわち、\n洗脳することだけ。"},
        { "location": "358/TALK"  , "narrator": "千羽鶴", "text": "けど、それは極力\n避けたかった。"},
        { "location": "359/TALK"  , "narrator": "千羽鶴", "text": "だから、クランに介入\nできる貴方にお願いした。"},
        { "location": "360/TALK"  , "narrator": "千羽鶴", "text": "そうすれば、\n彼女の意志である\nココロの司書と協力し――"},
        { "location": "361/TALK"  , "narrator": "千羽鶴", "text": "彼女自らの意志として\n理想的な未来を\n歩むことができる。"},
        { "location": "362/TALK"  , "narrator": "千羽鶴", "text": "誤算だったのは、\n初代ココロの司書たち。"},
        { "location": "363/SEL"   , "narrator": "", "text": "そこを予測して動かなかったのは落ち度じゃない？"},
        { "location": "364/SEL"   , "narrator": "", "text": "どうして洗脳ではなく、自由意志を重視したの？"},
        { "location": "365/ACT"   , "narrator": "", "text": "そこを予測して動かなかったのは落ち度じゃない？"},
        { "location": "366/TALK"  , "narrator": "千羽鶴", "text": "人のココロを、\n全く介入せず予測するのは\n何より難しい計算。"},
        { "location": "367/TALK"  , "narrator": "千羽鶴", "text": "複数の人間の自由意志を\n保持しつつ、未来を予測\nするのは神業に近い。"},
        { "location": "368/TALK"  , "narrator": "千羽鶴", "text": "その為、上手くいかない\n場合の対応策も用意しつつ\n運用を試みている。"},
        { "location": "369/SEL"   , "narrator": "", "text": "もしかして、それが新しい司書？"},
        { "location": "370/ACT"   , "narrator": "", "text": "もしかして、それが新しい司書？"},
        { "location": "372/TALK"  , "narrator": "千羽鶴", "text": "そう。\nそれが第一の対応策。"},
        { "location": "373/TALK"  , "narrator": "千羽鶴", "text": "半分だけ彼女の意志を\n残した状態で、もう半分を\n意図的に動かせる存在――"},
        { "location": "374/TALK"  , "narrator": "千羽鶴", "text": "半人格による\nココロの制御。"},
        { "location": "375/TALK"  , "narrator": "千羽鶴", "text": "これは例えるなら\n心臓ペースメーカーに\n近い。"},
        { "location": "376/TALK"  , "narrator": "千羽鶴", "text": "免疫力に抵抗されず、\n人工的なシステムによって\n人をサポートする。"},
        { "location": "377/TALK"  , "narrator": "千羽鶴", "text": "そして、それでも\n難しいと判断した場合は、\n私が介入する予定だった。"},
        { "location": "378/TALK"  , "narrator": "千羽鶴", "text": "これは完全なる洗脳に\nなるから、代償が伴う。"},
        { "location": "379/TALK"  , "narrator": "千羽鶴", "text": "けど、それを加味しても\nやらねばならないときが\n来たらやるつもりだった。"},
        { "location": "380/ACT"   , "narrator": "", "text": "どうして洗脳ではなく、自由意志を重視したの？"},
        { "location": "381/TALK"  , "narrator": "千羽鶴", "text": "洗脳による\n未来の創造では\n欠落するものがある。"},
        { "location": "382/TALK"  , "narrator": "千羽鶴", "text": "極力その欠落を\n抑えつつ未来を\n選択せねばならない。"},
        { "location": "383/SEL"   , "narrator": "", "text": "何が欠落するの？"},
        { "location": "384/ACT"   , "narrator": "", "text": "何が欠落するの？"},
        { "location": "386/TALK"  , "narrator": "千羽鶴", "text": "強い意志と精神力。"},
        { "location": "388/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、\n既に私自身が介入する\nことで決定した。"},
        { "location": "390/TALK"  , "narrator": "千羽鶴", "text": "だから、これによって\n貴方は、少しだけ重荷が\nおりることになる。"},
        { "location": "391/TALK"  , "narrator": "千羽鶴", "text": "これからは、ココロの中に\n方針を与える必要は\nなくなるから――"},
        { "location": "392/TALK"  , "narrator": "千羽鶴", "text": "思う存分、彼女と\nイチャイチャするだけで\nオッケー！"},
        { "location": "393/SEL"   , "narrator": "", "text": "やったー！"},
        { "location": "394/SEL"   , "narrator": "", "text": "えー"},
        { "location": "395/ACT"   , "narrator": "", "text": "やったー！"},
        { "location": "396/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n次回からはココロゲートに\n来なくてもいい。"},
        { "location": "397/ACT"   , "narrator": "", "text": "えー"},
        { "location": "398/TALK"  , "narrator": "千羽鶴", "text": "意外。"},
        { "location": "399/TALK"  , "narrator": "千羽鶴", "text": "そこで嫌がられるとは\n思ってもみなかった。"},
        { "location": "400/TALK"  , "narrator": "千羽鶴", "text": "ココロゲートと\nクランのデリートは\nかなり負担だったのでは。"},
        { "location": "401/SEL"   , "narrator": "", "text": "まあ、ね…"},
        { "location": "402/SEL"   , "narrator": "", "text": "いや、楽しかった"},
        { "location": "403/ACT"   , "narrator": "", "text": "まあ、ね…"},
        { "location": "404/TALK"  , "narrator": "千羽鶴", "text": "じゃあどうして\nえーなの？"},
        { "location": "405/ACT"   , "narrator": "", "text": "いや、楽しかった"},
        { "location": "406/TALK"  , "narrator": "千羽鶴", "text": "そうなのね。\nかわった人。"},
        { "location": "407/SEL"   , "narrator": "", "text": "司書たちとラブラブ中だったし"},
        { "location": "408/SEL"   , "narrator": "", "text": "バトル出来なくなるの辛い"},
        { "location": "409/SEL"   , "narrator": "", "text": "お話の核心が見られるから"},
        { "location": "410/SEL"   , "narrator": "", "text": "どっちかというと千羽鶴に任せるのが心配"},
        { "location": "411/ACT"   , "narrator": "", "text": "司書たちとラブラブ中だったし"},
        { "location": "412/TALK"  , "narrator": "千羽鶴", "text": "禁断の恋ね。\n誰とラブラブしたのか\n教えて。"},
        { "location": "413/SEL"   , "narrator": "", "text": "つばめの元司書"},
        { "location": "414/SEL"   , "narrator": "", "text": "つばめの新司書"},
        { "location": "415/SEL"   , "narrator": "", "text": "アーヤの元司書"},
        { "location": "416/SEL"   , "narrator": "", "text": "アーヤの新司書"},
        { "location": "417/SEL"   , "narrator": "", "text": "ガブリエラの司書"},
        { "location": "418/SEL"   , "narrator": "", "text": "みやびの元司書"},
        { "location": "419/SEL"   , "narrator": "", "text": "みやびの新司書"},
        { "location": "420/SEL"   , "narrator": "", "text": "冗談でした"},
        { "location": "421/ACT"   , "narrator": "", "text": "つばめの元司書"},
        { "location": "423/ACT"   , "narrator": "", "text": "つばめの新司書"},
        { "location": "425/ACT"   , "narrator": "", "text": "アーヤの元司書"},
        { "location": "427/ACT"   , "narrator": "", "text": "アーヤの新司書"},
        { "location": "429/ACT"   , "narrator": "", "text": "ガブリエラの司書"},
        { "location": "431/ACT"   , "narrator": "", "text": "みやびの元司書"},
        { "location": "433/ACT"   , "narrator": "", "text": "みやびの新司書"},
        { "location": "435/ACT"   , "narrator": "", "text": "冗談でした"},
        { "location": "438/TALK"  , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "439/ACT"   , "narrator": "", "text": "バトル出来なくなるの辛い"},
        { "location": "440/TALK"  , "narrator": "千羽鶴", "text": "それなら安心して。"},
        { "location": "441/TALK"  , "narrator": "千羽鶴", "text": "これからも要所要所で\n手伝ってもらうから。"},
        { "location": "442/ACT"   , "narrator": "", "text": "お話の核心が見られるから"},
        { "location": "443/TALK"  , "narrator": "千羽鶴", "text": "それなら安心して。"},
        { "location": "444/TALK"  , "narrator": "千羽鶴", "text": "私が毎回\n語ってあげるから。"},
        { "location": "445/ACT"   , "narrator": "", "text": "どっちかというと千羽鶴に任せるのが心配"},
        { "location": "446/TALK"  , "narrator": "千羽鶴", "text": "それって、私を\n信用できないってこと？"},
        { "location": "447/SEL"   , "narrator": "", "text": "イエス！"},
        { "location": "448/SEL"   , "narrator": "", "text": "そういうわけじゃないけど、"},
        { "location": "449/ACT"   , "narrator": "", "text": "イエス！"},
        { "location": "450/TALK"  , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "451/TALK"  , "narrator": "千羽鶴", "text": "それは残念。"},
        { "location": "452/ACT"   , "narrator": "", "text": "そういうわけじゃないけど、"},
        { "location": "453/TALK"  , "narrator": "千羽鶴", "text": "煮え切らない人。"},
        { "location": "458/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、\n貴方がどう思おうが\n状況はかわらない。"},
        { "location": "459/TALK"  , "narrator": "千羽鶴", "text": "今後貴方には、現実の\n彼女をめいっぱい\n支えてあげて欲しい。"},
        { "location": "460/TALK"  , "narrator": "千羽鶴", "text": "さて、そんな状況では\nあるのだけど――"},
        { "location": "461/TALK"  , "narrator": "千羽鶴", "text": "今回ばかりは\n貴方の力が必要だから\n協力して欲しい。"},
        { "location": "462/SEL"   , "narrator": "", "text": "あれ？$me$は必要ないのでは？"},
        { "location": "463/ACT"   , "narrator": "", "text": "あれ？$me$は必要ないのでは？"},
        { "location": "465/TALK"  , "narrator": "千羽鶴", "text": "今回だけは\nまだ不十分なところが\nあるから。"},
        { "location": "466/TALK"  , "narrator": "千羽鶴", "text": "前回の調整からあまり\n時間がなくて、完全な形\nでの対応ができなかった。"},
        { "location": "467/TALK"  , "narrator": "千羽鶴", "text": "次回からは全部\n私の手でやる。"},
        { "location": "469/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "470/SEL"   , "narrator": "", "text": "それはそうと、みやびの司書はどうなった？"},
        { "location": "471/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "472/TALK"  , "narrator": "千羽鶴", "text": "よろしく。"},
        { "location": "473/ACT"   , "narrator": "", "text": "それはそうと、みやびの司書はどうなった？"},
        { "location": "474/TALK"  , "narrator": "千羽鶴", "text": "新しい司書には\n別の仕事がある。"},
        { "location": "475/TALK"  , "narrator": "千羽鶴", "text": "初代司書は\n既に抹消されているはず。"},
        { "location": "476/SEL"   , "narrator": "", "text": "あーなるほど"},
        { "location": "477/SEL"   , "narrator": "", "text": "え？そうなの！？"},
        { "location": "478/ACT"   , "narrator": "", "text": "あーなるほど"},
        { "location": "479/TALK"  , "narrator": "千羽鶴", "text": "彼女は将来進むべき道に\nついて反旗を翻した。"},
        { "location": "480/TALK"  , "narrator": "千羽鶴", "text": "周囲も巻き込んでの\n行動を起こしたため、\n消し去る他なかった。"},
        { "location": "481/ACT"   , "narrator": "", "text": "え？そうなの！？"},
        { "location": "482/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "483/TALK"  , "narrator": "千羽鶴", "text": "彼女は将来進むべき道に\nついて反旗を翻した。"},
        { "location": "484/TALK"  , "narrator": "千羽鶴", "text": "周囲も巻き込んでの\n行動を起こしたため、\n消し去る他なかった。"},
        { "location": "486/TALK"  , "narrator": "千羽鶴", "text": "さて、\nそろそろいい？"},
        { "location": "514/TALK"  , "narrator": "千羽鶴", "text": "貴方とこの世界に\n素敵なココロの旅を。"},
        { "location": "27/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月3日　 5:11 PM</color>\nとある休日の夕方、寮「とらいあんぐる」みやびの部屋にて"},
        { "location": "240/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "242/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "244/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "246/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "248/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
