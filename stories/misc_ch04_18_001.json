    [
        { "location": "7/SCENARIO", "narrator": "", "text": "夏の日差し"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "夏に向かって"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "日光が眩しい季節になってきた"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "外にはもう出たくない"},
        { "location": "36/SEL"    , "narrator": "", "text": "まあそう言わず"},
        { "location": "37/SEL"    , "narrator": "", "text": "引きこもればいいよ"},
        { "location": "38/SEL"    , "narrator": "", "text": "サングラスしてみるとか"},
        { "location": "39/ACT"    , "narrator": "", "text": "まあそう言わず"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "いやだ"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "言う"},
        { "location": "43/ACT"    , "narrator": "", "text": "引きこもればいいよ"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "これが"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "そうもいかん"},
        { "location": "46/ACT"    , "narrator": "", "text": "サングラスしてみるとか"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "物理的解消法"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "なるほど"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "悪くない"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "かも"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "日に当たりたくなさすぎて"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "いっそ夜間部にでも"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "編入しようと思うくらいだ"},
        { "location": "58/SEL"    , "narrator": "", "text": "また極端な"},
        { "location": "59/SEL"    , "narrator": "", "text": "夜間部あったっけ？"},
        { "location": "60/SEL"    , "narrator": "", "text": "どこまででも付いて行くよ"},
        { "location": "61/ACT"    , "narrator": "", "text": "また極端な"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "そのくらい"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "イヤなのじゃ"},
        { "location": "64/ACT"    , "narrator": "", "text": "夜間部あったっけ？"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "確か"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "ない"},
        { "location": "67/ACT"    , "narrator": "", "text": "どこまででも付いて行くよ"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "当然ぞね"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "望むと望まざるに関わらず"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "連れて行くぞ"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "相棒"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "そして"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "こう見えても勤勉なみやびさんは"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "文句を言いつつ"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "仕事も授業もこなすのだ"}
    ]
}
