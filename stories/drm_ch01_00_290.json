        { "location": "169/TALK"    , "narrator": "つばめ", "text": "あれって"},
        { "location": "171/TALK"    , "narrator": "つばめ", "text": "漫画なの・・・？"},
        { "location": "174/ACT"     , "narrator": "", "text": "昭和の漫画とかかな？"},
        { "location": "175/TALK"    , "narrator": "つばめ", "text": "ぅーんとね"},
