        "title": "002 メインストーリー",
        "sub_title": "しろいこ＜前編＞"
    },
    "entry":
    [
        { "location": "1367/TALK"  , "narrator": "？？？", "text": "――神楽さん。"},
        { "location": "1368/TALK"  , "narrator": "？？？", "text": "一之宮神楽さん。"},
        { "location": "1369/TALK"  , "narrator": "神楽", "text": "…あなたは、誰？\nどうして私の名前を…？"},
        { "location": "1370/TALK"  , "narrator": "？？？", "text": "わたしは――"},
        { "location": "1371/TALK"  , "narrator": "？？？", "text": "逢瀬つばめ。"},
        { "location": "1373/TALK"  , "narrator": "神楽", "text": "ッ！？"},
        { "location": "1374/TALK"  , "narrator": "神楽", "text": "あなたが…あなたが、\n逢瀬つばめなんですか？"},
        { "location": "1375/TALK"  , "narrator": "？？？", "text": "そうですよ、\n一之宮神楽さん。"},
        { "location": "1376/TALK"  , "narrator": "神楽", "text": "あなたが…、\nあなたのせいで、\n私たちは…。"},
        { "location": "1377/TALK"  , "narrator": "神楽", "text": "覚悟してください。\n私は、あなたを――"},
        { "location": "1378/TALK"  , "narrator": "？？？", "text": "壊そうというのですよね？\n愚かなことです。"},
        { "location": "1379/TALK"  , "narrator": "神楽", "text": "黙れ！！"},
        { "location": "1380/TALK"  , "narrator": "神楽", "text": "おまえがいなければ…っ！！\nおまえさえいなければ！！"},
        { "location": "1381/TALK"  , "narrator": "？？？", "text": "…ごめんなさい。"},
        { "location": "1383/TALK"  , "narrator": "？？？", "text": "あなたには、随分と\n辛い目にあわせて\nしまったようで…。"},
        { "location": "1384/TALK"  , "narrator": "神楽", "text": "ふざけるな！！\n謝って済むことじゃない！！"},
        { "location": "1386/TALK"  , "narrator": "？？？", "text": "わかってます。\n問題はあなたと…。"},
        { "location": "1387/TALK"  , "narrator": "？？？", "text": "あなたの周りの人達に\n差をつけてしまった\nこと…。"},
        { "location": "1389/TALK"  , "narrator": "？？？", "text": "皆が平等に不幸なら、\nそれが不幸では\nなくなるから。"},
        { "location": "1390/TALK"  , "narrator": "神楽", "text": "は？　なにを言って――"},
        { "location": "1391/TALK"  , "narrator": "？？？", "text": "ですからお詫びに、\n貴方も壊してあげます。"},
        { "location": "1392/TALK"  , "narrator": "神楽", "text": "ッ！？"},
        { "location": "1393/TALK"  , "narrator": "？？？", "text": "あなたのお父さんや、\nお母さんと同じように！"},
        { "location": "1394/TALK"  , "narrator": "神楽", "text": "や――"},
        { "location": "1395/TALK"  , "narrator": "神楽", "text": "やめてーーーーーっ！！！"},
        { "location": "1408/TALK"  , "narrator": "透明神楽", "text": "――っ！？"},
        { "location": "1409/TALK"  , "narrator": "透明神楽", "text": "…あ、れ？"},
        { "location": "1413/TALK"  , "narrator": "透明神楽", "text": "…そっか。"},
        { "location": "1415/TALK"  , "narrator": "透明神楽", "text": "私…、失敗したんだ…。"},
        { "location": "1417/TALK"  , "narrator": "透明神楽", "text": "立てるかな……"},
        { "location": "1418/TALK"  , "narrator": "透明神楽", "text": "――っと"},
        { "location": "1434/TALK"  , "narrator": "神楽", "text": "はぁ……\n酷い目にあった。"},
        { "location": "1435/TALK"  , "narrator": "神楽", "text": "でも、確かにあの時、\n自分でフェノメノンを\n展開したはずなのに…。"},
        { "location": "1446/TALK"  , "narrator": "神楽", "text": "私がフェノメノンを\n展開した後で…。"},
        { "location": "1447/TALK"  , "narrator": "神楽", "text": "誰かがまた、\n別のフェノメノンを\n展開したんだ。"},
        { "location": "1450/TALK"  , "narrator": "神楽", "text": "…最悪。\nタイミングが悪いなんて\nレベルじゃないわ…。"},
        { "location": "1452/TALK"  , "narrator": "神楽", "text": "そういえば…、\n私を助けようとしてくれた\nあの女の子…。"},
        { "location": "1465/TALK"  , "narrator": "神楽", "text": "フェノメノンの中なのに、\n正気を保ってたような…？"},
        { "location": "1466/TALK"  , "narrator": "神楽", "text": "それに最後――"},
        { "location": "1479/TALK"  , "narrator": "神楽", "text": "…あれも、この世界が\n用意したシナリオってこと？"},
        { "location": "1481/TALK"  , "narrator": "神楽", "text": "ダメ…。\nまだぼーっとしてて、\n頭が働かない…。"},
        { "location": "1482/TALK"  , "narrator": "神楽", "text": "少し寝た方がいいかも…。"},
        { "location": "1485/TALK"  , "narrator": "神楽", "text": "でも、私…、\nこれからどうなるんだろう？"},
        { "location": "1486/TALK"  , "narrator": "神楽", "text": "それに、ママは…、\nどうなっちゃうんだろう？"},
        { "location": "1496/TALK"  , "narrator": "神楽", "text": "え？"},
        { "location": "1500/TALK"  , "narrator": "千羽鶴", "text": "…あら？\n起きてたのね。"},
        { "location": "1501/TALK"  , "narrator": "神楽", "text": "…すみません。\nどちら様ですか？"},
        { "location": "1502/TALK"  , "narrator": "千羽鶴", "text": "私は…、この世界で\nフェノメノンを対処する\n組織…。"},
        { "location": "1503/TALK"  , "narrator": "千羽鶴", "text": "情報管理庁に所属する\nエージェント。"},
        { "location": "1504/TALK"  , "narrator": "神楽", "text": "管理庁…エージェント？"},
        { "location": "1505/TALK"  , "narrator": "千羽鶴", "text": "とりあえずは、\n「ちはる」と呼んで。"},
        { "location": "1506/TALK"  , "narrator": "神楽", "text": "…はじめまして、\nちはるさん。"},
        { "location": "1507/TALK"  , "narrator": "千羽鶴", "text": "ええ…早速だけど、\n一之宮神楽。"},
        { "location": "1509/TALK"  , "narrator": "神楽", "text": "えっ！？"},
        { "location": "1510/TALK"  , "narrator": "千羽鶴", "text": "あなたはＡＥＺ統一国家と\n多国籍企業群の\n密命を受けて…。"},
        { "location": "1511/TALK"  , "narrator": "千羽鶴", "text": "このゾルタクスゼイアンに\nやってきた。"},
        { "location": "1512/TALK"  , "narrator": "神楽", "text": "えっ！？\nはぁっ――！？　"},
        { "location": "1513/TALK"  , "narrator": "神楽", "text": "な、なんで！？\nどうして――"},
        { "location": "1514/TALK"  , "narrator": "神楽", "text": "何故…そのことを\n知ってるんですか……。"},
        { "location": "1515/TALK"  , "narrator": "千羽鶴", "text": "けれども、\nその特務は失敗した…。"},
        { "location": "1516/TALK"  , "narrator": "神楽", "text": "…あなたは、\n何者なんですか？"},
        { "location": "1518/TALK"  , "narrator": "千羽鶴", "text": "そこは重要じゃない。"},
        { "location": "1519/TALK"  , "narrator": "千羽鶴", "text": "私は、あまり回りくどい\n言い方や駆け引きが\n好きではない。"},
        { "location": "1520/TALK"  , "narrator": "千羽鶴", "text": "だから、あなたが\n知っていると思われる\n事柄。"},
        { "location": "1521/TALK"  , "narrator": "千羽鶴", "text": "抱えていると思われる\n事情については\n全て割愛し…。"},
        { "location": "1522/TALK"  , "narrator": "千羽鶴", "text": "交渉から入ることにする。"},
        { "location": "1523/TALK"  , "narrator": "神楽", "text": "…な、なんなの、\nこの人は？"},
        { "location": "1524/TALK"  , "narrator": "千羽鶴", "text": "一之宮神楽。\nあなたは『彼ら』の特命を\n全うできなかった。"},
        { "location": "1525/TALK"  , "narrator": "千羽鶴", "text": "この後、リベンジできる\n可能性はないとは\n言わないけど…。"},
        { "location": "1526/TALK"  , "narrator": "千羽鶴", "text": "かなり難しいと思う。"},
        { "location": "1527/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1528/TALK"  , "narrator": "千羽鶴", "text": "だから私は、貴方にとって\n朗報となるであろう話を\n今からしたいと思う。"},
        { "location": "1529/TALK"  , "narrator": "千羽鶴", "text": "一之宮神楽…。\n私と情報管理庁に\n協力して。"},
        { "location": "1530/TALK"  , "narrator": "千羽鶴", "text": "そうすれば、あなたが\n欲しいものは全部、\n私がなんとかする。"},
        { "location": "1531/TALK"  , "narrator": "神楽", "text": "…なに言ってるの？\n私がほしいもの\n全部って…。"},
        { "location": "1532/TALK"  , "narrator": "神楽", "text": "…例えば？\nあなたが私に、\nなにをしてくれるんですか？"},
        { "location": "1534/TALK"  , "narrator": "千羽鶴", "text": "あなたの母、卯月美佐子に\nクラン・スピネルを\n戻してあげることができる。"},
        { "location": "1535/TALK"  , "narrator": "千羽鶴", "text": "そして、母子共に\nフランスへ帰国\nできるようにしてあげる。"},
        { "location": "1536/TALK"  , "narrator": "千羽鶴", "text": "それも、安全に。"},
        { "location": "1537/TALK"  , "narrator": "千羽鶴", "text": "その頃にはきっと、\n貴方を束縛する人は\nいないから。"},
        { "location": "1538/TALK"  , "narrator": "神楽", "text": "……は？"},
        { "location": "1539/TALK"  , "narrator": "神楽", "text": "は……！！！？？"},
        { "location": "1540/TALK"  , "narrator": "千羽鶴", "text": "やってもらうことは、\n逢瀬つばめの破壊。"},
        { "location": "1541/TALK"  , "narrator": "千羽鶴", "text": "“彼ら”から\n与えられた特命と、\nなにも変わらない。"},
        { "location": "1542/TALK"  , "narrator": "千羽鶴", "text": "ただし…条件が一つ\n追加される。"},
        { "location": "1543/TALK"  , "narrator": "千羽鶴", "text": "それは、\n私が「いい」と言うまで、\n破壊してはならない。"},
        { "location": "1544/TALK"  , "narrator": "神楽", "text": "…それだけ？"},
        { "location": "1545/TALK"  , "narrator": "千羽鶴", "text": "ええ、それだけ。"},
        { "location": "1546/TALK"  , "narrator": "千羽鶴", "text": "逆にそこまで\n待っていてくれれば…。"},
        { "location": "1547/TALK"  , "narrator": "千羽鶴", "text": "今度は絶対に\n失敗しないよう、\n私が全部お膳立てする。"},
        { "location": "1548/TALK"  , "narrator": "神楽", "text": "…協力しない、と\n言った場合は？"},
        { "location": "1549/TALK"  , "narrator": "千羽鶴", "text": "私が全力で、\nあなたの任務を阻止し、\n追放する。"},
        { "location": "1550/TALK"  , "narrator": "神楽", "text": "…あなたは、何者なの？"},
        { "location": "1551/TALK"  , "narrator": "千羽鶴", "text": "さっきも言った。\n情報管理庁の\nエージェント。"},
        { "location": "1553/TALK"  , "narrator": "神楽", "text": "…絶対ウソだ。\nそれ以外にも、\n何か隠してる…。"},
        { "location": "1555/TALK"  , "narrator": "神楽", "text": "でも…、協力しない場合に\n阻止するっていうのは、\n本当かも…。"},
        { "location": "1556/TALK"  , "narrator": "神楽", "text": "つまり、選択肢が\nあるようでない、\nって状況…よね。"},
        { "location": "1557/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1560/TALK"  , "narrator": "神楽", "text": "すみません。\nちょっと失礼します。"},
        { "location": "1561/TALK"  , "narrator": "千羽鶴", "text": "ええ、ごゆっくり…。"},
        { "location": "1571/TALK"  , "narrator": "システム", "text": "[ERROR 001]\nRedinessによる\n量子ネットワーク回線に\n接続できません。"},
        { "location": "1577/TALK"  , "narrator": "神楽", "text": "は！？　なにこれ、\n聞いてないんだけど！？"},
        { "location": "1578/TALK"  , "narrator": "神楽", "text": "どうなってるのよ、\nまったく…！！"},
        { "location": "1582/TALK"  , "narrator": "神楽", "text": "いますか？"},
        { "location": "1583/TALK"  , "narrator": "神楽", "text": "聞きたいことがあるんですが"},
        { "location": "1585/SEL"   , "narrator": "", "text": "回線なら$me$が切断した"},
        { "location": "1586/SEL"   , "narrator": "", "text": "千羽鶴のこと？"},
        { "location": "1587/ACT"   , "narrator": "", "text": "回線なら$me$が切断した"},
        { "location": "1589/ACT"   , "narrator": "", "text": "千羽鶴のこと？"},
        { "location": "1590/TALK"  , "narrator": "神楽", "text": "違います"},
        { "location": "1591/TALK"  , "narrator": "神楽", "text": "回線が繋がらないんです"},
        { "location": "1592/TALK"  , "narrator": "神楽", "text": "原因を教えてください"},
        { "location": "1594/SEL"   , "narrator": "", "text": "回線なら$me$が切断した"},
        { "location": "1595/SEL"   , "narrator": "", "text": "そういえば切断されたみたいだよ"},
        { "location": "1596/SEL"   , "narrator": "", "text": "そんなことより千羽鶴に協力して"},
        { "location": "1597/SEL"   , "narrator": "", "text": "そんなことより千羽鶴に協力したらダメだ！！"},
        { "location": "1598/ACT"   , "narrator": "", "text": "回線なら$me$が切断した"},
        { "location": "1600/ACT"   , "narrator": "", "text": "そういえば切断されたみたいだよ"},
        { "location": "1602/TALK"  , "narrator": "神楽", "text": "やっぱり"},
        { "location": "1603/TALK"  , "narrator": "神楽", "text": "再接続をお願いします"},
        { "location": "1605/SEL"   , "narrator": "", "text": "すみません、出来ません"},
        { "location": "1606/SEL"   , "narrator": "", "text": "それは出来ない注文ですね"},
        { "location": "1607/ACT"   , "narrator": "", "text": "すみません、出来ません"},
        { "location": "1608/TALK"  , "narrator": "神楽", "text": "そうですか"},
        { "location": "1609/TALK"  , "narrator": "神楽", "text": "使えない"},
        { "location": "1610/TALK"  , "narrator": "神楽", "text": "なんのためにいるんだか"},
        { "location": "1611/ACT"   , "narrator": "", "text": "それは出来ない注文ですね"},
        { "location": "1613/TALK"  , "narrator": "神楽", "text": "切ったの"},
        { "location": "1614/TALK"  , "narrator": "神楽", "text": "あなたですか"},
        { "location": "1616/ACT"   , "narrator": "", "text": "そんなことより千羽鶴に協力して"},
        { "location": "1617/TALK"  , "narrator": "神楽", "text": "あなたの意見は聞いてないから"},
        { "location": "1618/TALK"  , "narrator": "神楽", "text": "質問に答えないならもういい"},
        { "location": "1619/ACT"   , "narrator": "", "text": "そんなことより千羽鶴に協力したらダメだ！！"},
        { "location": "1620/TALK"  , "narrator": "神楽", "text": "あなたの意見は聞いてないから"},
        { "location": "1621/TALK"  , "narrator": "神楽", "text": "質問に答えないならもういい"},
        { "location": "1625/TALK"  , "narrator": "システム", "text": "神楽さんが\nあなたをブロックしました。"},
        { "location": "1628/SEL"   , "narrator": "", "text": "おーい"},
        { "location": "1629/SEL"   , "narrator": "", "text": "マジ！？"},
        { "location": "1630/SEL"   , "narrator": "", "text": "ハニー！？"},
        { "location": "1631/ACT"   , "narrator": "", "text": "おーい"},
        { "location": "1632/ACT"   , "narrator": "", "text": "マジ！？"},
        { "location": "1633/ACT"   , "narrator": "", "text": "ハニー！？"},
        { "location": "1636/TALK"  , "narrator": "システム", "text": "メッセージは\nブロックされています。"},
        { "location": "1638/SEL"   , "narrator": "", "text": "お話聞いて"},
        { "location": "1639/SEL"   , "narrator": "", "text": "ふざけんなよ！！"},
        { "location": "1640/SEL"   , "narrator": "", "text": "こんなに愛してるのに！？"},
        { "location": "1641/ACT"   , "narrator": "", "text": "お話聞いて"},
        { "location": "1643/ACT"   , "narrator": "", "text": "ふざけんなよ！！"},
        { "location": "1645/ACT"   , "narrator": "", "text": "こんなに愛してるのに！？"},
        { "location": "1697/TALK"  , "narrator": "ぴょんこ", "text": "　"},
        { "location": "1712/TALK"  , "narrator": "ぴょんこ", "text": "こんにちは、\n$handle$さん♪"},
        { "location": "1713/SEL"   , "narrator": "", "text": "こんにちは"},
        { "location": "1714/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "1715/ACT"   , "narrator": "", "text": "こんにちは"},
        { "location": "1716/TALK"  , "narrator": "ぴょんこ", "text": "また来てくれて\n嬉しいですっ♪"},
        { "location": "1717/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "1721/TALK"  , "narrator": "ぴょんこ", "text": "ええっ……\nそうなんですかっ♪"},
        { "location": "1723/TALK"  , "narrator": "ぴょんこ", "text": "そんなこと言われたら\nぴょんこ、\nﾄｩﾝｸしちゃいますっ！"},
        { "location": "1725/TALK"  , "narrator": "ぴょんこ", "text": "ところでところで！"},
        { "location": "1726/TALK"  , "narrator": "ぴょんこ", "text": "初っぱなから\n現実の私に\nBANされましたよねっ！"},
        { "location": "1727/SEL"   , "narrator": "", "text": "え、ええ、まあ"},
        { "location": "1728/ACT"   , "narrator": "", "text": "え、ええ、まあ"},
        { "location": "1730/TALK"  , "narrator": "ぴょんこ", "text": "ちょっ！！\n$handle$\nマジ無能！！"},
        { "location": "1732/TALK"  , "narrator": "ぴょんこ", "text": "だいたいさー、\n「ふざけんなよ！！」\nとか！"},
        { "location": "1733/TALK"  , "narrator": "ぴょんこ", "text": "何逆ギレしてんの？"},
        { "location": "1735/TALK"  , "narrator": "ぴょんこ", "text": "だいたいさー、\n「こんなに愛してるのに」\nとか――"},
        { "location": "1736/TALK"  , "narrator": "ぴょんこ", "text": "言うべきコトの順番が\nぜんっぜん\nちげーだろっていうか！"},
        { "location": "1738/SEL"   , "narrator": "", "text": "すみません"},
        { "location": "1739/SEL"   , "narrator": "", "text": "お前嫌いだわ"},
        { "location": "1740/ACT"   , "narrator": "", "text": "すみません"},
        { "location": "1742/TALK"  , "narrator": "ぴょんこ", "text": "ていうか！\nていうかですね！\nそもそもー！"},
        { "location": "1743/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんって\n誰かとお付き合いした\n経験あるんですかっ？"},
        { "location": "1744/TALK"  , "narrator": "ぴょんこ", "text": "あ、ちなみに\n$handle$さんの\n世界の子に限りまーす♪"},
        { "location": "1745/SEL"   , "narrator": "", "text": "あるよ！"},
        { "location": "1746/SEL"   , "narrator": "", "text": "ありません…"},
        { "location": "1747/ACT"   , "narrator": "", "text": "あるよ！"},
        { "location": "1748/TALK"  , "narrator": "ぴょんこ", "text": "へーそうなんですか。"},
        { "location": "1749/TALK"  , "narrator": "ぴょんこ", "text": "じゃあ、恋人の\nイロハだって\n知ってますよね？"},
        { "location": "1750/TALK"  , "narrator": "ぴょんこ", "text": "私にだって、同じように\n優しくエスコート\nしてくれるんですよね？"},
        { "location": "1751/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "1752/SEL"   , "narrator": "", "text": "神楽は恋人でもないしつき合ってもいない"},
        { "location": "1753/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "1756/TALK"  , "narrator": "ぴょんこ", "text": "ふふっ♪\nそれじゃ、\n期待してますよっ♪"},
        { "location": "1757/TALK"  , "narrator": "ぴょんこ", "text": "私は総じて\n要求水準が\n高いですから♪"},
        { "location": "1758/ACT"   , "narrator": "", "text": "神楽は恋人でもないしつき合ってもいない"},
        { "location": "1760/TALK"  , "narrator": "ぴょんこ", "text": "あーなるほど、\nそうですか。"},
        { "location": "1761/TALK"  , "narrator": "ぴょんこ", "text": "まあ、そうですよね。\n別にどうでもいい話です。"},
        { "location": "1763/ACT"   , "narrator": "", "text": "ありません…"},
        { "location": "1765/TALK"  , "narrator": "ぴょんこ", "text": "ホントですかーっ！！"},
        { "location": "1766/TALK"  , "narrator": "ぴょんこ", "text": "やーいやーい！"},
        { "location": "1767/TALK"  , "narrator": "ぴょんこ", "text": "<size=15>…私と同じぴょん。</size>"},
        { "location": "1768/SEL"   , "narrator": "", "text": "神楽って誰かとつき合ったことないの！？"},
        { "location": "1769/ACT"   , "narrator": "", "text": "神楽って誰かとつき合ったことないの！？"},
        { "location": "1771/TALK"  , "narrator": "ぴょんこ", "text": "同族のよしみで\n教えますけど――"},
        { "location": "1772/TALK"  , "narrator": "ぴょんこ", "text": "一度もないぴょん！！"},
        { "location": "1773/TALK"  , "narrator": "ぴょんこ", "text": "だいたい、この性格で\n男が寄りつくとでも\n思うんですぴょん？"},
        { "location": "1774/TALK"  , "narrator": "ぴょんこ", "text": "まあ、寄りつくとすれば\nめちゃくちゃ物好きか\nドエムかどっちかですね。"},
        { "location": "1775/TALK"  , "narrator": "ぴょんこ", "text": "ですけど！\nですけど！"},
        { "location": "1776/TALK"  , "narrator": "ぴょんこ", "text": "これは大変な事に\nなってきましたぴょん！"},
        { "location": "1777/TALK"  , "narrator": "ぴょんこ", "text": "$handle$も私も\n恋愛経験ゼロ！"},
        { "location": "1778/TALK"  , "narrator": "ぴょんこ", "text": "そんなノーレシピの\nふたりが絶対恐怖領域を\n突破して交流するとか――"},
        { "location": "1779/TALK"  , "narrator": "ぴょんこ", "text": "どれだけの血と肉片が\n飛び交うんでしょうかっ！"},
        { "location": "1780/SEL"   , "narrator": "", "text": "怖いこと言わないで！"},
        { "location": "1781/ACT"   , "narrator": "", "text": "怖いこと言わないで！"},
        { "location": "1783/TALK"  , "narrator": "ぴょんこ", "text": "なんて、冗談ぴょん。"},
        { "location": "1784/TALK"  , "narrator": "ぴょんこ", "text": "でもでも！\nそれを聞いて、ぴょんこ\n少しだけ安心しました。"},
        { "location": "1785/TALK"  , "narrator": "ぴょんこ", "text": "なんだか親近感も\nマシマシですしっ♪"},
        { "location": "1786/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの\n$handle$への\n親密度アーップ♪"},
        { "location": "1788/ACT"   , "narrator": "", "text": "お前嫌いだわ"},
        { "location": "1790/TALK"  , "narrator": "ぴょんこ", "text": "あ、そうですか。"},
        { "location": "1791/TALK"  , "narrator": "ぴょんこ", "text": "まあいいんですけどね。\n私にとっては、司書は\n単なる仕事ですし。"},
        { "location": "1792/TALK"  , "narrator": "ぴょんこ", "text": "仕事で嫌なヤツと\n対話するなんて\n慣れてますし。"},
        { "location": "1793/TALK"  , "narrator": "ぴょんこ", "text": "むしろ\n$handle$さんの\n方が可哀想ですよね。"},
        { "location": "1794/TALK"  , "narrator": "ぴょんこ", "text": "これからずっと、嫌いな\n奴とやりとりし続けないと\nいけないんですから。"},
        { "location": "1795/TALK"  , "narrator": "ぴょんこ", "text": "まあそこは\n自己責任で\nお願いします♪"},
        { "location": "1796/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、\n本題に戻りますねっ！"},
        { "location": "1798/TALK"  , "narrator": "ぴょんこ", "text": "というわけで――"},
        { "location": "1799/TALK"  , "narrator": "ぴょんこ", "text": "改めまして、\n卯月神楽のココロの司書、\nぴょんこです♪"},
        { "location": "1800/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんの\nお世話をさせて\nいただきますっ！"},
        { "location": "1801/SEL"   , "narrator": "", "text": "改めてよろしくね"},
        { "location": "1802/SEL"   , "narrator": "", "text": "何のお世話をしてくれるの？"},
        { "location": "1803/ACT"   , "narrator": "", "text": "改めてよろしくね"},
        { "location": "1804/TALK"  , "narrator": "ぴょんこ", "text": "はいっ♪"},
        { "location": "1805/ACT"   , "narrator": "", "text": "何のお世話をしてくれるの？"},
        { "location": "1807/TALK"  , "narrator": "ぴょんこ", "text": "もちろん！\nおはようから\nおやすみまで！"},
        { "location": "1808/TALK"  , "narrator": "ぴょんこ", "text": "身のまわりのこと\nぜーんぶですよっ♪"},
        { "location": "1809/TALK"  , "narrator": "ぴょんこ", "text": "というわけで早速……"},
        { "location": "1810/TALK"  , "narrator": "ぴょんこ", "text": "そこのコンビニで\nパンと飲み物買ってきて！"},
        { "location": "1811/SEL"   , "narrator": "", "text": "それ逆ですよねぇ！！"},
        { "location": "1812/SEL"   , "narrator": "", "text": "不良グループかよ！！"},
        { "location": "1813/ACT"   , "narrator": "", "text": "それ逆ですよねぇ！！"},
        { "location": "1814/TALK"  , "narrator": "ぴょんこ", "text": "細かいことは\nきにすんな。"},
        { "location": "1815/ACT"   , "narrator": "", "text": "不良グループかよ！！"},
        { "location": "1816/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "1818/TALK"  , "narrator": "ぴょんこ", "text": "なーんて\n冗談ですよっ♪"},
        { "location": "1819/TALK"  , "narrator": "ぴょんこ", "text": "でも見てください！\n目は笑ってませんよ？"},
        { "location": "1820/SEL"   , "narrator": "", "text": "自己申告するな！！"},
        { "location": "1821/ACT"   , "narrator": "", "text": "自己申告するな！！"},
        { "location": "1823/TALK"  , "narrator": "ぴょんこ", "text": "ここまで含めて\n全部冗談ですっ♪"},
        { "location": "1824/TALK"  , "narrator": "ぴょんこ", "text": "まあでも、ぶっちゃけ\nこの世界そのものが冗談\nみたいなものですけどね♪"},
        { "location": "1826/TALK"  , "narrator": "ぴょんこ", "text": "というわけで。"},
        { "location": "1827/TALK"  , "narrator": "ぴょんこ", "text": "【現在のあらすじ】\n$handle$は\nBANされてしまった！"},
        { "location": "1828/TALK"  , "narrator": "ぴょんこ", "text": "BANを解除する方法は\n果たして存在するのか！"},
        { "location": "1829/TALK"  , "narrator": "ぴょんこ", "text": "いや、ある！\n（反語になってない）\n乞うご期待！"},
        { "location": "1830/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\nぴょんこと協力して\n状況を打破しませんかっ？"},
        { "location": "1831/SEL"   , "narrator": "", "text": "お願いします"},
        { "location": "1832/SEL"   , "narrator": "", "text": "どうするの？"},
        { "location": "1833/ACT"   , "narrator": "", "text": "お願いします"},
        { "location": "1834/TALK"  , "narrator": "ぴょんこ", "text": "同意してもらえて\n嬉しいです！"},
        { "location": "1835/TALK"  , "narrator": "ぴょんこ", "text": "ということは、\nすなわちこれが――"},
        { "location": "1836/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんと\nぴょんこの、初めての\n共同作業になりますね…。"},
        { "location": "1837/TALK"  , "narrator": "ぴょんこ", "text": "とっても\nドキドキしますっ！"},
        { "location": "1838/TALK"  , "narrator": "ぴょんこ", "text": "じゃあ早速\n説明していきますね！"},
        { "location": "1839/ACT"   , "narrator": "", "text": "どうするの？"},
        { "location": "1840/TALK"  , "narrator": "ぴょんこ", "text": "はい、説明します！"},
        { "location": "1842/TALK"  , "narrator": "ぴょんこ", "text": "現実の私は\n今、とっても\n混乱しています。"},
        { "location": "1843/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんも\n含めて、もはや何を信じて\nいいのかわかりません。"},
        { "location": "1844/SEL"   , "narrator": "", "text": "そんな感じだろうね"},
        { "location": "1845/SEL"   , "narrator": "", "text": "何を信じていいのか……うっ…頭が……っ"},
        { "location": "1846/ACT"   , "narrator": "", "text": "そんな感じだろうね"},
        { "location": "1847/TALK"  , "narrator": "ぴょんこ", "text": "はいっ！\nそんな感じです。"},
        { "location": "1848/ACT"   , "narrator": "", "text": "何を信じていいのか……うっ…頭が……っ"},
        { "location": "1849/TALK"  , "narrator": "ぴょんこ", "text": "どうしたんですかっ！\nまさか……今、現実の\n私とチャネリングを…！？"},
        { "location": "1850/SEL"   , "narrator": "", "text": "いや…ちょっと既視感が"},
        { "location": "1851/SEL"   , "narrator": "", "text": "そうなんだよ。$me$と神楽は常にオンライン（意味深）だからね"},
        { "location": "1852/ACT"   , "narrator": "", "text": "いや…ちょっと既視感が"},
        { "location": "1853/TALK"  , "narrator": "ぴょんこ", "text": "そうなんですねっ！\nますます親近感が\n湧いちゃいますっ！"},
        { "location": "1854/ACT"   , "narrator": "", "text": "そうなんだよ。$me$と神楽は常にオンライン（意味深）だからね"},
        { "location": "1856/TALK"  , "narrator": "ぴょんこ", "text": "んなわけねーだろ。"},
        { "location": "1859/TALK"  , "narrator": "ぴょんこ", "text": "そんなわけで、\nまずは混乱してる頭を\n整理する必要があります。"},
        { "location": "1860/TALK"  , "narrator": "ぴょんこ", "text": "その為に、葛藤を\n生み出しているクランを\n撃退してくださいっ！"},
        { "location": "1861/TALK"  , "narrator": "ぴょんこ", "text": "そうすれば現実の私は\n自ずと導けるはずです。"},
        { "location": "1862/TALK"  , "narrator": "ぴょんこ", "text": "私には\n$handle$さんが\n必要なんだって！"},
        { "location": "1863/SEL"   , "narrator": "", "text": "なるほどわかった！"},
        { "location": "1864/SEL"   , "narrator": "", "text": "えっと…ちょっとまって？共同作業のぴょんこさん担当分は…？"},
        { "location": "1865/ACT"   , "narrator": "", "text": "なるほどわかった！"},
        { "location": "1866/TALK"  , "narrator": "ぴょんこ", "text": "よかったです♪"},
        { "location": "1867/ACT"   , "narrator": "", "text": "えっと…ちょっとまって？共同作業のぴょんこさん担当分は…？"},
        { "location": "1869/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "1870/TALK"  , "narrator": "ぴょんこ", "text": "これから扉を回す\n作業をするぴょん。"},
        { "location": "1871/SEL"   , "narrator": "", "text": "それだけっすか！！"},
        { "location": "1872/ACT"   , "narrator": "", "text": "それだけっすか！！"},
        { "location": "1874/TALK"  , "narrator": "ぴょんこ", "text": "メンドクサイヤツだなー。"},
        { "location": "1875/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこが扉を回して\n$handle$が\n扉に入る。"},
        { "location": "1876/TALK"  , "narrator": "ぴょんこ", "text": "バッチ共同作業♪\nどうよ！"},
        { "location": "1877/SEL"   , "narrator": "", "text": "あ、はい……"},
        { "location": "1878/ACT"   , "narrator": "", "text": "あ、はい……"},
        { "location": "1881/TALK"  , "narrator": "ぴょんこ", "text": "では早速、\n扉を回しますね♪"},
        { "location": "1885/TALK"  , "narrator": "ぴょんこ", "text": "オープンプロセス、\n2x110番地から\n2xD13番地へ。"},
        { "location": "1909/TALK"  , "narrator": "ぴょんこ", "text": "シーク完了ぴょん♪"},
        { "location": "1910/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ早速、\n心の整理を\nよろしくお願いします♪"},
        { "location": "1911/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんと\nぴょんこにとって\n素敵なココロの旅を♪"},
        { "location": "1363/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "1406/DIALOG", "narrator": "Dialog_EventData", "text": "<color=green>5月3日　 8:23 PM</color>\n情報管理庁付属病院F棟6階。"},
        { "location": "1662/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1664/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1666/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1668/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1670/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
