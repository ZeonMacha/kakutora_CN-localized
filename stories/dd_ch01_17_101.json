        "title": "002 メインストーリー",
        "sub_title": "横縞瑪瑙＜前編＞"
    },
    "entry":
    [
        { "location": "38/TALK"   , "narrator": "透明真幌", "text": "すまんが、もう少し\nその場で待機して\nいてくれ。"},
        { "location": "39/TALK"   , "narrator": "透明真幌", "text": "現場の最終確認に\n時間がかかってる\nらしい。"},
        { "location": "40/TALK"   , "narrator": "透明真幌", "text": "異常がないことが\n確認されるまでの\n辛抱だ。"},
        { "location": "41/TALK"   , "narrator": "透明真幌", "text": "確認が終わったら\nすぐに帰還許可を\n出すからな。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "了解しました。"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "…ということだから、\nもうしばらくここで\n待機ね。"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "まったく、さっさと\n終わらせてほしいわ。"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "つばめ、大丈夫？\n疲れちゃった？"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "あ、いえ…、\n神楽ちゃんのこと\n考えてて…。"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "何が神楽よ？"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "あいつは神楽じゃ\nなくて、フレイメノウ\nでしょ？"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "それは…そうかも\nしれないけど…。"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "かもじゃなくて、\nあいつはメノウなの！"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "ほら、ギャヴィ。\nそんな怒らないで\n落ち着いて。"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "別に、怒ってなんか\nいないわよ…。"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "仕方ないわ。"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "卯月がメノウだって\n私も気付いてなかった\nもの。"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "今まで、そんなそぶり\n見せなかったし。"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "…つばめは、\n本当に平気？"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "え？　何がですか？"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "何がじゃないでしょ？"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "神楽の正体が\nメノウってこと。"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "あんたにとっては\n重大事件なんじゃ\nないの？"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "うん。\nビックリしたよ。"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "メノウちゃんの曲は\n今でも毎日聞いてる\nのに。"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "神楽ちゃんと\n話してても全然気づか\nなかったんだもん。"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "もしかして、\n声変えたりとかも\nできるのかな？"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "いや、そんなこと\n聞いてるんじゃ\nないから。"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "え？　そうなの？"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "だから、あたし達が\n言いたいのは！"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "…ううん、もういい。\nなんか、疲れたわ。"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "えっ？　わたし、\n何か変なこと\n言ってる？"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "気にしないで。\n特に混乱とかしてない\nなら、それでいいの。"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "まあ、さすがは\n天然なだけあるわね。"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "うう、天然扱いする\nなら、せめて理由を\n教えてよぉ…。"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "だから、卯月は\nメノウでもあるのよ。"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "今までと同じに\n話したり\nできないでしょ？"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "…え？　だって、\n神楽ちゃんは\n神楽ちゃんだし…。"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…もういいわよ。\nてか、その天然っぷり\n羨ましいわ…。"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "105/SEL"   , "narrator": "", "text": "悩んだりしてないの？"},
        { "location": "106/ACT"   , "narrator": "", "text": "悩んだりしてないの？"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "$handle$さんまで？"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "大丈夫だよ"},
        { "location": "126/SEL"   , "narrator": "", "text": "本当に別人として見れる？"},
        { "location": "127/ACT"   , "narrator": "", "text": "本当に別人として見れる？"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "それは"},
        { "location": "133/TALK"  , "narrator": "つばめ", "text": "不安かも"},
        { "location": "134/TALK"  , "narrator": "つばめ", "text": "ちょっとだけ"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "メノウちゃんって"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "わかってから"},
        { "location": "137/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんの顔"},
        { "location": "138/TALK"  , "narrator": "つばめ", "text": "メノウちゃんに見ぇて"},
        { "location": "141/TALK"  , "narrator": "つばめ", "text": "今までみたぃに"},
        { "location": "142/TALK"  , "narrator": "つばめ", "text": "お話しできるかな？"},
        { "location": "209/TALK"  , "narrator": "つばめ", "text": "　"},
        { "location": "217/TALK"  , "narrator": "つばめ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "218/SEL"   , "narrator": "", "text": "こんにちは"},
        { "location": "219/SEL"   , "narrator": "", "text": "なんでそんなに怖いんですか？"},
        { "location": "220/ACT"   , "narrator": "", "text": "こんにちは"},
        { "location": "221/ACT"   , "narrator": "", "text": "なんでそんなに怖いんですか？"},
        { "location": "222/TALK"  , "narrator": "つばめ", "text": "怖い、ですか？"},
        { "location": "223/TALK"  , "narrator": "つばめ", "text": "…すみません。\nまだ慣れてないもので。"},
        { "location": "224/TALK"  , "narrator": "つばめ", "text": "どう対応したらいいか\nわかってないんです。"},
        { "location": "226/TALK"  , "narrator": "つばめ", "text": "では早速\n仕事をしましょう。"},
        { "location": "227/SEL"   , "narrator": "", "text": "そうですね"},
        { "location": "228/SEL"   , "narrator": "", "text": "その前に質問が"},
        { "location": "229/ACT"   , "narrator": "", "text": "そうですね"},
        { "location": "230/ACT"   , "narrator": "", "text": "その前に質問が"},
        { "location": "231/TALK"  , "narrator": "つばめ", "text": "手短に。"},
        { "location": "232/TALK"  , "narrator": "つばめ", "text": "１つの質問に答える為には\nおよそ２～３分ほど\nかかるんです。"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "その分人件費が発生します\nから、つばめにとっては\nあまり良くないことです。"},
        { "location": "234/TALK"  , "narrator": "つばめ", "text": "手短に。\n１つだけ答えます。"},
        { "location": "236/TALK"  , "narrator": "つばめ", "text": "…といっても、前回\n答えましたから、今回は\n一択のみですね。"},
        { "location": "237/SEL"   , "narrator": "", "text": "前の司書はどうなっちゃったの？"},
        { "location": "238/ACT"   , "narrator": "", "text": "前の司書はどうなっちゃったの？"},
        { "location": "242/TALK"  , "narrator": "つばめ", "text": "…といっても、前回\n答えましたから、今回は\n一択のみですね。"},
        { "location": "243/SEL"   , "narrator": "", "text": "貴方は以前はどこにいたんですか？"},
        { "location": "244/ACT"   , "narrator": "", "text": "貴方は以前はどこにいたんですか？"},
        { "location": "248/TALK"  , "narrator": "つばめ", "text": "…といっても、前回\n答えましたから、今回は\n一択のみですね。"},
        { "location": "249/SEL"   , "narrator": "", "text": "貴方はつばめの何を司る人格ですか？"},
        { "location": "250/ACT"   , "narrator": "", "text": "貴方はつばめの何を司る人格ですか？"},
        { "location": "254/TALK"  , "narrator": "つばめ", "text": "…といっても、前回\n答えましたから、今回は\n一択のみですね。"},
        { "location": "255/SEL"   , "narrator": "", "text": "好きですつき合ってください"},
        { "location": "256/ACT"   , "narrator": "", "text": "好きですつき合ってください"},
        { "location": "260/TALK"  , "narrator": "つばめ", "text": "もちろん知らないことは\nスカですが、１カウント\nです。注意してください。"},
        { "location": "262/SEL"   , "narrator": "", "text": "前の司書はどうなっちゃったの？"},
        { "location": "263/SEL"   , "narrator": "", "text": "貴方は以前はどこにいたんですか？"},
        { "location": "264/SEL"   , "narrator": "", "text": "貴方はつばめの何を司る人格ですか？"},
        { "location": "265/SEL"   , "narrator": "", "text": "好きですつき合ってください"},
        { "location": "266/SEL"   , "narrator": "", "text": "ちょっと考えさせて（※ノーカウント）"},
        { "location": "267/ACT"   , "narrator": "", "text": "前の司書はどうなっちゃったの？"},
        { "location": "271/ACT"   , "narrator": "", "text": "貴方は以前はどこにいたんですか？"},
        { "location": "275/ACT"   , "narrator": "", "text": "貴方はつばめの何を司る人格ですか？"},
        { "location": "279/ACT"   , "narrator": "", "text": "好きですつき合ってください"},
        { "location": "283/ACT"   , "narrator": "", "text": "ちょっと考えさせて（※ノーカウント）"},
        { "location": "285/TALK"  , "narrator": "つばめ", "text": "別にいつでもいいですよ。"},
        { "location": "291/TALK"  , "narrator": "つばめ", "text": "わたしが元いた場所に\n行きました。"},
        { "location": "292/TALK"  , "narrator": "つばめ", "text": "ココロの保存則です。"},
        { "location": "293/SEL"   , "narrator": "", "text": "それってどこなの？"},
        { "location": "294/ACT"   , "narrator": "", "text": "それってどこなの？"},
        { "location": "296/TALK"  , "narrator": "つばめ", "text": "1x0FFです。"},
        { "location": "299/TALK"  , "narrator": "つばめ", "text": "1x001です。"},
        { "location": "300/SEL"   , "narrator": "", "text": "なんですかそれ"},
        { "location": "301/ACT"   , "narrator": "", "text": "なんですかそれ"},
        { "location": "303/TALK"  , "narrator": "つばめ", "text": "ココロの番地ですよ。\n扉番号とも言います。"},
        { "location": "304/SEL"   , "narrator": "", "text": "扉ごとに人格がいるの？"},
        { "location": "305/SEL"   , "narrator": "", "text": "1xなんて始まりの番地聞いた事ない"},
        { "location": "306/ACT"   , "narrator": "", "text": "扉ごとに人格がいるの？"},
        { "location": "307/TALK"  , "narrator": "つばめ", "text": "そういうこともありますし\n同じ人格が幾つもの扉に\nいることもあります。"},
        { "location": "308/ACT"   , "narrator": "", "text": "1xなんて始まりの番地聞いた事ない"},
        { "location": "309/TALK"  , "narrator": "つばめ", "text": "普通にありますよ。"},
        { "location": "313/TALK"  , "narrator": "つばめ", "text": "わたしは、つばめの\n法と規律を司る人格の\n副次的人格です。"},
        { "location": "314/SEL"   , "narrator": "", "text": "なんですかそれ"},
        { "location": "315/ACT"   , "narrator": "", "text": "なんですかそれ"},
        { "location": "317/TALK"  , "narrator": "つばめ", "text": "それ以上の言い方が\n見つからないので、\n説明できません。"},
        { "location": "321/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "322/TALK"  , "narrator": "つばめ", "text": "…はい。\nでもわたし――"},
        { "location": "323/TALK"  , "narrator": "つばめ", "text": "怒ると怖いよ？\nそれでもいいの…？"},
        { "location": "324/SEL"   , "narrator": "", "text": "知ってた"},
        { "location": "325/SEL"   , "narrator": "", "text": "そう答える子いるいる！"},
        { "location": "326/ACT"   , "narrator": "", "text": "知ってた"},
        { "location": "327/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "328/TALK"  , "narrator": "つばめ", "text": "こういうとき、\nどういう顔をすればいいか\nわからないんです。"},
        { "location": "329/SEL"   , "narrator": "", "text": "笑えばいいと思うよ"},
        { "location": "330/ACT"   , "narrator": "", "text": "笑えばいいと思うよ"},
        { "location": "332/TALK"  , "narrator": "つばめ", "text": "…わかりました。\nそれでは――"},
        { "location": "333/TALK"  , "narrator": "つばめ", "text": "えへ……。"},
        { "location": "335/ACT"   , "narrator": "", "text": "そう答える子いるいる！"},
        { "location": "337/TALK"  , "narrator": "つばめ", "text": "…ですね。"},
        { "location": "338/TALK"  , "narrator": "つばめ", "text": "ちなみにここで\n「はい」と言うと\n契約が成立します。"},
        { "location": "339/TALK"  , "narrator": "つばめ", "text": "そうすると貴方は\nわたしが怒ることを\n咎められなくなります。"},
        { "location": "340/SEL"   , "narrator": "", "text": "そんなのナンセンスだ"},
        { "location": "341/SEL"   , "narrator": "", "text": "誰かが同じ事を言ってたような"},
        { "location": "342/ACT"   , "narrator": "", "text": "そんなのナンセンスだ"},
        { "location": "343/TALK"  , "narrator": "つばめ", "text": "そうかもしれません。"},
        { "location": "344/TALK"  , "narrator": "つばめ", "text": "まあ最終的には\n２人の関係ですから、\n２人が決めることですし。"},
        { "location": "345/ACT"   , "narrator": "", "text": "誰かが同じ事を言ってたような"},
        { "location": "346/TALK"  , "narrator": "つばめ", "text": "そうなんですか？"},
        { "location": "347/TALK"  , "narrator": "つばめ", "text": "よくわかりませんけど、\nわりと一般論ですから\n同じ事言う人はいるかと。"},
        { "location": "352/TALK"  , "narrator": "つばめ", "text": "というわけで\n回答はおしまいです。"},
        { "location": "354/TALK"  , "narrator": "つばめ", "text": "それじゃ、ちゃっちゃと\nお仕事をしましょう。"},
        { "location": "363/TALK"  , "narrator": "つばめ", "text": "オープンプロセス、\n0x412番地から\n0xF2E番地へ。"},
        { "location": "378/TALK"  , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "380/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "383/TALK"  , "narrator": "つばめ", "text": "なるほど。\nわかりました。"},
        { "location": "384/TALK"  , "narrator": "つばめ", "text": "悩みは禁物です。\n特に対人関係の悩みは\n大きな負担になります。"},
        { "location": "385/TALK"  , "narrator": "つばめ", "text": "よって、悩みによって\n発生しているクランを\n抹消してきてください。"},
        { "location": "386/SEL"   , "narrator": "", "text": "オッケー"},
        { "location": "387/SEL"   , "narrator": "", "text": "えっと"},
        { "location": "388/ACT"   , "narrator": "", "text": "オッケー"},
        { "location": "389/TALK"  , "narrator": "つばめ", "text": "ありがとうございます。\nそれではいきましょう。"},
        { "location": "390/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
        { "location": "391/ACT"   , "narrator": "", "text": "えっと"},
        { "location": "392/TALK"  , "narrator": "つばめ", "text": "…？\nなんですか？"},
        { "location": "393/SEL"   , "narrator": "", "text": "いや、なんでもない"},
        { "location": "394/SEL"   , "narrator": "", "text": "やっぱり何かおかしい"},
        { "location": "395/ACT"   , "narrator": "", "text": "いや、なんでもない"},
        { "location": "396/TALK"  , "narrator": "つばめ", "text": "そうですか。\nそれではいきましょう。"},
        { "location": "397/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
        { "location": "398/ACT"   , "narrator": "", "text": "やっぱり何かおかしい"},
        { "location": "399/TALK"  , "narrator": "つばめ", "text": "はぁ…そうですか。"},
        { "location": "400/TALK"  , "narrator": "つばめ", "text": "でも、何がおかしいのか\n具体的に言ってくれないと\nわたしもわかりません。"},
        { "location": "401/SEL"   , "narrator": "", "text": "ちょっとそれは表現できない"},
        { "location": "402/SEL"   , "narrator": "", "text": "本当につばめのために選んでるのか疑問"},
        { "location": "403/ACT"   , "narrator": "", "text": "ちょっとそれは表現できない"},
        { "location": "404/TALK"  , "narrator": "つばめ", "text": "それですと、\n何も答えられませんよ。"},
        { "location": "405/ACT"   , "narrator": "", "text": "本当につばめのために選んでるのか疑問"},
        { "location": "406/TALK"  , "narrator": "つばめ", "text": "当然です！\nわたしはわたしの為に\n選んでますから。"},
        { "location": "407/TALK"  , "narrator": "つばめ", "text": "それだけは\n断言できます！"},
        { "location": "409/TALK"  , "narrator": "つばめ", "text": "何にしてもですよ。"},
        { "location": "410/TALK"  , "narrator": "つばめ", "text": "何でもいいから\nさっさと――"},
        { "location": "411/SEL"   , "narrator": "", "text": "わーちょっと待って！やるから怒らないで！"},
        { "location": "412/SEL"   , "narrator": "", "text": "どうぞ！"},
        { "location": "413/ACT"   , "narrator": "", "text": "わーちょっと待って！やるから怒らないで！"},
        { "location": "414/TALK"  , "narrator": "つばめ", "text": "……。\nわかりました。"},
        { "location": "415/TALK"  , "narrator": "つばめ", "text": "でも、\nそんなに怖いですか？"},
        { "location": "416/SEL"   , "narrator": "", "text": "ええ、とっても"},
        { "location": "417/SEL"   , "narrator": "", "text": "つばめじゃないみたいだもの"},
        { "location": "418/ACT"   , "narrator": "", "text": "ええ、とっても"},
        { "location": "419/TALK"  , "narrator": "つばめ", "text": "そうですか…。\nごめんなさい。"},
        { "location": "420/ACT"   , "narrator": "", "text": "つばめじゃないみたいだもの"},
        { "location": "421/TALK"  , "narrator": "つばめ", "text": "つばめです。"},
        { "location": "422/TALK"  , "narrator": "つばめ", "text": "人格にはいろいろな\n性格があります。"},
        { "location": "423/TALK"  , "narrator": "つばめ", "text": "表面に出てこない性格でも\n内面には存在している\nことも普通にあります。"},
        { "location": "424/TALK"  , "narrator": "つばめ", "text": "ココロスフィアでは\n常識なんですが、\n知らなかったんですね。"},
        { "location": "425/TALK"  , "narrator": "つばめ", "text": "まあでも――"},
        { "location": "427/TALK"  , "narrator": "つばめ", "text": "ちょっとキツく\n言い過ぎているのかも\nしれませんね。"},
        { "location": "428/TALK"  , "narrator": "つばめ", "text": "それじゃ、\n優しくします。"},
        { "location": "429/TALK"  , "narrator": "つばめ", "text": "頑張ってクランを\n消してきてください♪\n■■野郎さん！"},
        { "location": "430/ACT"   , "narrator": "", "text": "どうぞ！"},
        { "location": "431/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "432/TALK"  , "narrator": "つばめ", "text": "やっぱりいいです。\nさっさと倒して\nきてください。"},
        { "location": "433/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
        { "location": "37/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月24日　7:02 PM</color>\nフェノメノン戦終了後、豊洲のマンション前にて。"},
        { "location": "174/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "176/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
