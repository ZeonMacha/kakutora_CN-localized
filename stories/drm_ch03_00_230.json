        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "私にとって貴方が使用人なら納得できるの"},
        { "location": "347/ACT"     , "narrator": "", "text": "$me$は納得してない"},
        { "location": "357/TALK"    , "narrator": "ガブリエラ", "text": "でも決めたから"},
        { "location": "359/SEL"     , "narrator": "", "text": "じゃあ条件を出すぞ"},
        { "location": "360/ACT"     , "narrator": "", "text": "じゃあ条件を出すぞ"},
        { "location": "362/TALK"    , "narrator": "ガブリエラ", "text": "何よ"},
        { "location": "364/TALK"    , "narrator": "ガブリエラ", "text": "言ってごらんなさいよ"},
        { "location": "366/SEL"     , "narrator": "", "text": "お嬢さまって呼ぶ"},
        { "location": "367/SEL"     , "narrator": "", "text": "ガブリエラたんって呼ぶ"},
        { "location": "368/ACT"     , "narrator": "", "text": "お嬢さまって呼ぶ"},
        { "location": "378/TALK"    , "narrator": "ガブリエラ", "text": "あらv"},
        { "location": "380/TALK"    , "narrator": "ガブリエラ", "text": "いいわよv"},
        { "location": "381/TALK"    , "narrator": "ガブリエラ", "text": "いい響きだわねv"},
