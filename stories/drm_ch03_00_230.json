        { "location": "323/TALK"    , "narrator": "ガブリエラ", "text": "決めたわ"},
        { "location": "327/TALK"    , "narrator": "ガブリエラ", "text": "貴方、私の使用人になりなさい"},
        { "location": "329/SEL"     , "narrator": "", "text": "なんで？"},
        { "location": "330/SEL"     , "narrator": "", "text": "断る"},
        { "location": "331/SEL"     , "narrator": "", "text": "恋人にならなってあげる"},
