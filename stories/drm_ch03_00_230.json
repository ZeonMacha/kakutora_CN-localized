        { "location": "336/TALK"    , "narrator": "ガブリエラ", "text": "貴方、キューピッドが気に入らないみたいだから"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ何がいいかって考えて決めたの"},
        { "location": "338/TALK"    , "narrator": "ガブリエラ", "text": "使用人なら納得できるわ"},
