        "title": "Extra006 ヒメゴトチャット",
        "sub_title": "これはいわゆる、その、あれだ"
    },
    "entry":
    [
        { "location": "2207/SCENARIO", "narrator": "", "text": "これはいわゆる、その、あれだ"},
        { "location": "2232/TALK"    , "narrator": "神楽", "text": "夢だらけの学園生活に必要なものは百合成分ぴょん"},
        { "location": "2234/SEL"     , "narrator": "", "text": "それはどうだろう…"},
        { "location": "2235/SEL"     , "narrator": "", "text": "夢じゃなくて現実にしよう！"},
        { "location": "2236/SEL"     , "narrator": "", "text": "夢ならありかもね"},
        { "location": "2237/ACT"     , "narrator": "", "text": "それはどうだろう…"},
        { "location": "2238/TALK"    , "narrator": "神楽", "text": "そうは思わないと"},
        { "location": "2240/TALK"    , "narrator": "神楽", "text": "ゆめのないひとね"},
        { "location": "2241/ACT"     , "narrator": "", "text": "夢じゃなくて現実にしよう！"},
        { "location": "2243/TALK"    , "narrator": "神楽", "text": "夢を夢で終わらせない♪"},
        { "location": "2244/TALK"    , "narrator": "神楽", "text": "ｲｲ響きだﾅｰ"},
        { "location": "2245/TALK"    , "narrator": "神楽", "text": "心強い言葉が得られてぴょんこはうれしいですよ！"},
        { "location": "2246/TALK"    , "narrator": "神楽", "text": "萌ゆるゆりゆり学園生活～！"},
        { "location": "2247/ACT"     , "narrator": "", "text": "夢ならありかもね"},
        { "location": "2248/TALK"    , "narrator": "神楽", "text": "それをリアルに展開したいんだけど？"},
        { "location": "2252/TALK"    , "narrator": "神楽", "text": "百合の系譜は大正時代に端を発する由緒あるものですのよ"},
        { "location": "2254/SEL"     , "narrator": "", "text": "$me$との愛で塗り替えよう"},
        { "location": "2255/SEL"     , "narrator": "", "text": "戦前生まれだったの？"},
        { "location": "2256/SEL"     , "narrator": "", "text": "大正浪漫だ"},
        { "location": "2257/ACT"     , "narrator": "", "text": "$me$との愛で塗り替えよう"},
        { "location": "2259/TALK"    , "narrator": "神楽", "text": "自由恋愛ね$handlek$"},
        { "location": "2260/TALK"    , "narrator": "神楽", "text": "女学生ぴょんこは恋に恋するお年頃だから"},
        { "location": "2261/TALK"    , "narrator": "神楽", "text": "そんな$handlek$に恋しちゃうわ♪"},
        { "location": "2262/ACT"     , "narrator": "", "text": "戦前生まれだったの？"},
        { "location": "2263/TALK"    , "narrator": "神楽", "text": "誰が"},
        { "location": "2264/TALK"    , "narrator": "神楽", "text": "みやびさんと一緒にしないで"},
        { "location": "2265/ACT"     , "narrator": "", "text": "大正浪漫だ"},
        { "location": "2266/TALK"    , "narrator": "神楽", "text": "そうそれ"},
        { "location": "2268/TALK"    , "narrator": "神楽", "text": "そういうやつ"},
        { "location": "2270/TALK"    , "narrator": "神楽", "text": "でも学科はあんまり色気を感じない内容ばかりなの"},
        { "location": "2271/TALK"    , "narrator": "神楽", "text": "実用のみのカリキュラムは学生の創造力を奪うと思うの"},
        { "location": "2272/TALK"    , "narrator": "神楽", "text": "元々そういう目的で設立されてるから仕方ないけどね！"}
    ]
}
