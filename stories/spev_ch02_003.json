        "title": "スペシャルエピソード",
        "sub_title": "掬われた先に"
    },
    "entry":
    [
        { "location": "27/TALK" , "narrator": "透明アーヤ", "text": "集中して、\n狙いを定めたら\n一気に…。"},
        { "location": "28/TALK" , "narrator": "透明アーヤ", "text": "そこ！！"},
        { "location": "36/TALK" , "narrator": "透明アーヤ", "text": "あっ、もう！\nまた穴空いちゃった。"},
        { "location": "39/TALK" , "narrator": "透明みやび", "text": "なんや、アーヤは\n金魚すくいが\n下手なんやねぇ。"},
        { "location": "40/TALK" , "narrator": "透明アーヤ", "text": "ポイが水につけた\n瞬間溶けるんだもの。\nこれじゃ取れないわ。"},
        { "location": "42/TALK" , "narrator": "透明ガブリエラ", "text": "あらぁ？\nそれって負け惜しみ\nかしらぁ？"},
        { "location": "43/TALK" , "narrator": "透明神楽", "text": "ガブちゃんは\n凄過ぎですよ。"},
        { "location": "44/TALK" , "narrator": "透明神楽", "text": "一つのポイで五匹も\n取るなんて、\n普通できませんから。"},
        { "location": "45/TALK" , "narrator": "透明ガブリエラ", "text": "何事も修行よ、修行。\nほら、新人も集中して\nやってみなさいよ。"},
        { "location": "47/TALK" , "narrator": "透明つばめ", "text": "で、できるかなぁ？"},
        { "location": "48/TALK" , "narrator": "透明みやび", "text": "アーヤはどうする？"},
        { "location": "49/TALK" , "narrator": "透明アーヤ", "text": "もちろんやるけど、\nちょっと集中させて。"},
        { "location": "50/TALK" , "narrator": "透明ガブリエラ", "text": "集中だけでどうにか\nなると思ったら\n大間違いよ？"},
        { "location": "52/TALK" , "narrator": "透明アーヤ", "text": "一匹くらいは\n取ってみせるわ…。"},
        { "location": "53/SEL"  , "narrator": "（選択肢）", "text": "楽しそうだね"},
        { "location": "54/ACT"  , "narrator": "", "text": "楽しそうだね"},
        { "location": "61/TALK" , "narrator": "アーヤ", "text": "楽しいけど"},
        { "location": "62/TALK" , "narrator": "アーヤ", "text": "真剣なの！(>_<)"},
        { "location": "63/TALK" , "narrator": "アーヤ", "text": "金魚ってスゴいわ"},
        { "location": "64/TALK" , "narrator": "アーヤ", "text": "自分から"},
        { "location": "65/TALK" , "narrator": "アーヤ", "text": "ポイに穴開けてくるし(☆｡☆)"},
        { "location": "66/SEL"  , "narrator": "（選択肢）", "text": "攻撃的な金魚だね"},
        { "location": "67/ACT"  , "narrator": "", "text": "攻撃的な金魚だね"},
        { "location": "69/TALK" , "narrator": "アーヤ", "text": "金魚だって"},
        { "location": "70/TALK" , "narrator": "アーヤ", "text": "捕まりたくないのかも(￣∇￣)"},
        { "location": "71/TALK" , "narrator": "アーヤ", "text": "そうだ"},
        { "location": "73/TALK" , "narrator": "アーヤ", "text": "金魚すくいのコツ"},
        { "location": "74/TALK" , "narrator": "アーヤ", "text": "何か知らない？( ・_・)σﾞ"},
        { "location": "75/SEL"  , "narrator": "（選択肢）", "text": "ひたすら集中かな？"},
        { "location": "76/SEL"  , "narrator": "（選択肢）", "text": "色仕掛けとかは？"},
        { "location": "77/ACT"  , "narrator": "", "text": "ひたすら集中かな？"},
        { "location": "78/TALK" , "narrator": "アーヤ", "text": "さっきからしてるけど"},
        { "location": "80/TALK" , "narrator": "アーヤ", "text": "全然(-ω-;)"},
        { "location": "81/TALK" , "narrator": "アーヤ", "text": "失敗しまくり"},
        { "location": "82/TALK" , "narrator": "アーヤ", "text": "次が五回目(;^_^A"},
        { "location": "83/SEL"  , "narrator": "（選択肢）", "text": "ハマッてる？"},
        { "location": "84/SEL"  , "narrator": "（選択肢）", "text": "取れないようにできてるんだよ"},
        { "location": "85/ACT"  , "narrator": "", "text": "ハマッてる？"},
        { "location": "86/TALK" , "narrator": "アーヤ", "text": "ハマッてないから(>_<)"},
        { "location": "87/TALK" , "narrator": "アーヤ", "text": "ただ"},
        { "location": "88/TALK" , "narrator": "アーヤ", "text": "ここまで来たら意地よ(｀ヘ´)"},
        { "location": "89/TALK" , "narrator": "アーヤ", "text": "一匹は取りたいわ"},
        { "location": "91/TALK" , "narrator": "アーヤ", "text": "ちょっと悔しいし(￣Д￣ )"},
        { "location": "92/ACT"  , "narrator": "", "text": "取れないようにできてるんだよ"},
        { "location": "93/TALK" , "narrator": "アーヤ", "text": "ギャヴィは一回で五匹取った(￣Д￣ )"},
        { "location": "94/TALK" , "narrator": "アーヤ", "text": "できるのよ"},
        { "location": "95/TALK" , "narrator": "アーヤ", "text": "私ができないだけ(>_<)"},
        { "location": "96/TALK" , "narrator": "アーヤ", "text": "そんなの悔しいわ！(T_T)"},
        { "location": "98/SEL"  , "narrator": "（選択肢）", "text": "意外と負けず嫌い？"},
        { "location": "99/ACT"  , "narrator": "", "text": "意外と負けず嫌い？"},
        { "location": "101/TALK", "narrator": "アーヤ", "text": "意外とっていうか"},
        { "location": "102/TALK", "narrator": "アーヤ", "text": "負けるのは嫌よ(´o｀；"},
        { "location": "104/TALK", "narrator": "アーヤ", "text": "普通そうでしょ？"},
        { "location": "105/TALK", "narrator": "アーヤ", "text": "それに"},
        { "location": "106/TALK", "narrator": "アーヤ", "text": "金魚に負けるとか"},
        { "location": "107/TALK", "narrator": "アーヤ", "text": "かっこ悪過ぎ(ノД`)"},
        { "location": "109/ACT" , "narrator": "", "text": "色仕掛けとかは？"},
        { "location": "111/TALK", "narrator": "アーヤ", "text": "ごめんなさい"},
        { "location": "112/TALK", "narrator": "アーヤ", "text": "意味不明なんだけど（￣ー￣？）"},
        { "location": "113/SEL" , "narrator": "（選択肢）", "text": "浴衣姿が素敵、ってこと"},
        { "location": "114/SEL" , "narrator": "（選択肢）", "text": "その胸元はそれが目的でしょ？"},
        { "location": "115/ACT" , "narrator": "", "text": "浴衣姿が素敵、ってこと"},
        { "location": "117/TALK", "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "119/TALK", "narrator": "アーヤ", "text": "集中乱れるから！(>_<)"},
        { "location": "120/TALK", "narrator": "アーヤ", "text": "急にそういうこと言うのＮＧ！(｀ヘ´)"},
        { "location": "121/TALK", "narrator": "アーヤ", "text": "照れるでしょ？"},
        { "location": "124/TALK", "narrator": "アーヤ", "text": "悪い気はしないけど(｡-_-｡)"},
        { "location": "125/TALK", "narrator": "アーヤ", "text": "私もこの浴衣"},
        { "location": "126/TALK", "narrator": "アーヤ", "text": "お気に入りなの(^^"},
        { "location": "127/TALK", "narrator": "アーヤ", "text": "褒めてくれてありがとう(^ε^)-☆!!"},
        { "location": "128/ACT" , "narrator": "", "text": "その胸元はそれが目的でしょ"},
        { "location": "130/TALK", "narrator": "アーヤ", "text": "ちょっと！"},
        { "location": "132/TALK", "narrator": "アーヤ", "text": "どこ見てるの！？（｀皿´ )"},
        { "location": "133/TALK", "narrator": "アーヤ", "text": "自然にはだけちゃっただけだから！"},
        { "location": "135/TALK", "narrator": "アーヤ", "text": "大体"},
        { "location": "136/TALK", "narrator": "アーヤ", "text": "金魚にそんなの通用しないし(｀ヘ´)"},
        { "location": "137/SEL" , "narrator": "（選択肢）", "text": "$me$には効果アリだ"},
        { "location": "138/ACT" , "narrator": "", "text": "$me$には効果アリだ"},
        { "location": "140/TALK", "narrator": "アーヤ", "text": "だから"},
        { "location": "141/TALK", "narrator": "アーヤ", "text": "そういうこといって"},
        { "location": "142/TALK", "narrator": "アーヤ", "text": "集中乱さないで(>_<)"},
        { "location": "145/TALK", "narrator": "アーヤ", "text": "とにかく"},
        { "location": "146/TALK", "narrator": "アーヤ", "text": "もっと集中してやってみるわ"},
        { "location": "147/TALK", "narrator": "アーヤ", "text": "気持ち的には"},
        { "location": "148/TALK", "narrator": "アーヤ", "text": "居合いだと思って＼(^O^)／"},
        { "location": "150/TALK", "narrator": "透明アーヤ", "text": "…よし！\nおじさん、もう一回！"},
        { "location": "151/TALK", "narrator": "透明ガブリエラ", "text": "何度やっても無駄よ。\nアーヤには向いてない\nのよ。"},
        { "location": "153/TALK", "narrator": "透明アーヤ", "text": "やってみなくちゃ\nわからないでしょ。"},
        { "location": "157/TALK", "narrator": "透明つばめ", "text": "アーヤさん、\n頑張ってー！"},
        { "location": "158/TALK", "narrator": "透明アーヤ", "text": "…相手の動き…、\n次に移動する場所を\n予測して――"},
        { "location": "162/TALK", "narrator": "透明アーヤ", "text": "見えたッ！！"},
        { "location": "163/TALK", "narrator": "透明アーヤ", "text": "……たあっ！！"},
        { "location": "170/TALK", "narrator": "透明みやび", "text": "おおっ！！"},
        { "location": "172/TALK", "narrator": "透明ガブリエラ", "text": "うそっ！？"},
        { "location": "174/TALK", "narrator": "透明アーヤ", "text": "やった！\nやっと取れ――"},
        { "location": "182/TALK", "narrator": "透明アーヤ", "text": "ちょ、えぇぇっ！？"},
        { "location": "186/TALK", "narrator": "透明ガブリエラ", "text": "な、何よその\nエッチな取り方！"},
        { "location": "188/TALK", "narrator": "透明アーヤ", "text": "ち、違う！\n金魚が勝手に\n跳ねて――"},
        { "location": "189/TALK", "narrator": "透明みやび", "text": "なるほど。\n胸をお碗代わりに\nする取り方か！"},
        { "location": "190/TALK", "narrator": "透明アーヤ", "text": "そうじゃなくて！\nそれより早くお碗\n取ってよ！"},
        { "location": "191/TALK", "narrator": "透明つばめ", "text": "は、はい！\nえっと…。"},
        { "location": "193/TALK", "narrator": "透明アーヤ", "text": "あっ、ダメダメダメ！\nこの子、奥入ろうと\nしてる！"},
        { "location": "194/TALK", "narrator": "透明アーヤ", "text": "早く、早くお碗！\nは、入っちゃうから！"},
        { "location": "196/TALK", "narrator": "透明神楽", "text": "アーヤさん…、\n素晴らしいものを\n見せていただいて――"},
        { "location": "197/TALK", "narrator": "透明神楽", "text": "本当にありがとう\nございます！"},
        { "location": "199/TALK", "narrator": "透明アーヤ", "text": "ああもう！\nお碗取ってってば！"}
    ]
}
