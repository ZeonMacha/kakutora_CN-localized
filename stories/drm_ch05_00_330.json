        { "location": "809/SCENARIO", "narrator": "", "text": "お願い"},
        { "location": "834/TALK"    , "narrator": "神楽", "text": "ぴょんこのかわいいお願い聞いてね♪"},
        { "location": "835/TALK"    , "narrator": "神楽", "text": "聞かないと"},
        { "location": "836/TALK"    , "narrator": "神楽", "text": "korす"},
        { "location": "838/SEL"     , "narrator": "", "text": "どうにも穏やかでない"},
        { "location": "839/SEL"     , "narrator": "", "text": "聞く聞くなんでも聞く！"},
        { "location": "840/SEL"     , "narrator": "", "text": "まあ落ち着こう"},
        { "location": "841/ACT"     , "narrator": "", "text": "どうにも穏やかでない"},
        { "location": "842/TALK"    , "narrator": "神楽", "text": "ぴょんこは春一番のように穏やか～～"},
        { "location": "843/ACT"     , "narrator": "", "text": "聞く聞くなんでも聞く！"},
        { "location": "844/TALK"    , "narrator": "神楽", "text": "よしよし♪"},
        { "location": "845/TALK"    , "narrator": "神楽", "text": "$handle$はとてもいいこですぴょん"},
        { "location": "846/ACT"     , "narrator": "", "text": "まあ落ち着こう"},
        { "location": "847/TALK"    , "narrator": "神楽", "text": "動かざること山のごとしですぴょん♪"},
        { "location": "849/TALK"    , "narrator": "神楽", "text": "ぴょんこ行きたいところがあるんだぴょん"},
        { "location": "850/TALK"    , "narrator": "神楽", "text": "$handle$も一緒に来て欲しいの、、、"},
        { "location": "852/SEL"     , "narrator": "", "text": "わかった"},
        { "location": "853/SEL"     , "narrator": "", "text": "どこでもついてくよ"},
        { "location": "854/SEL"     , "narrator": "", "text": "場所によるかな"},
        { "location": "855/ACT"     , "narrator": "", "text": "わかった"},
        { "location": "857/ACT"     , "narrator": "", "text": "どこでもついてくよ"},
        { "location": "859/ACT"     , "narrator": "", "text": "場所によるかな"},
        { "location": "860/TALK"    , "narrator": "神楽", "text": "絶対行きたくなる場所だから♪"},
        { "location": "862/TALK"    , "narrator": "神楽", "text": "ただ、、、"},
        { "location": "863/TALK"    , "narrator": "神楽", "text": "$handle$と行きたいところを巡った後ぴょんこは"},
        { "location": "864/TALK"    , "narrator": "神楽", "text": "月に帰らないといけないのです"},
        { "location": "866/SEL"     , "narrator": "", "text": "だったらやめとく"},
        { "location": "867/SEL"     , "narrator": "", "text": "まあ仕方ないよね"},
        { "location": "868/SEL"     , "narrator": "", "text": "帰らないですむ方法はないの？"},
        { "location": "869/ACT"     , "narrator": "", "text": "だったらやめとく"},
        { "location": "870/TALK"    , "narrator": "神楽", "text": "そっかー"},
        { "location": "871/TALK"    , "narrator": "神楽", "text": "じゃあね～～～♪\n月●　　λ..."},
        { "location": "872/ACT"     , "narrator": "", "text": "まあ仕方ないよね"},
        { "location": "873/TALK"    , "narrator": "神楽", "text": "そんなに簡単に納得しちゃうんですね"},
        { "location": "874/TALK"    , "narrator": "神楽", "text": "$handle$は"},
        { "location": "876/SEL"     , "narrator": "", "text": "簡単じゃないけど…"},
        { "location": "877/SEL"     , "narrator": "", "text": "怒ってる？"},
        { "location": "878/SEL"     , "narrator": "", "text": "神楽が決めたことでしょ"},
        { "location": "879/ACT"     , "narrator": "", "text": "簡単じゃないけど…"},
        { "location": "880/TALK"    , "narrator": "神楽", "text": "けど？"},
        { "location": "881/ACT"     , "narrator": "", "text": "怒ってる？"},
        { "location": "882/TALK"    , "narrator": "神楽", "text": "怒ってなんかない"},
        { "location": "883/TALK"    , "narrator": "神楽", "text": "失望しただけ"},
        { "location": "884/ACT"     , "narrator": "", "text": "神楽が決めたことでしょ"},
        { "location": "885/TALK"    , "narrator": "神楽", "text": "あっあっあっあっ"},
        { "location": "887/TALK"    , "narrator": "神楽", "text": "そーゆーこと言う？？？？"},
        { "location": "891/SEL"     , "narrator": "", "text": "そんなこと言われても"},
        { "location": "892/SEL"     , "narrator": "", "text": "なんかごめん"},
        { "location": "893/SEL"     , "narrator": "", "text": "機嫌直してよ"},
        { "location": "894/ACT"     , "narrator": "", "text": "そんなこと言われても"},
        { "location": "895/TALK"    , "narrator": "神楽", "text": "ふううううん"},
        { "location": "896/TALK"    , "narrator": "神楽", "text": "結局そういう返ししかしてこないんだ？？？"},
        { "location": "897/TALK"    , "narrator": "神楽", "text": "ｻﾖﾅﾗ！\n月●　　λ.."},
        { "location": "898/ACT"     , "narrator": "", "text": "なんかごめん"},
        { "location": "899/TALK"    , "narrator": "神楽", "text": "怒ってる意味とかわかんないのに謝るとか"},
        { "location": "900/TALK"    , "narrator": "神楽", "text": "最低"},
        { "location": "901/ACT"     , "narrator": "", "text": "機嫌直してよ"},
        { "location": "902/TALK"    , "narrator": "神楽", "text": "何その上から目線"},
        { "location": "903/TALK"    , "narrator": "神楽", "text": "さいあく"},
        { "location": "905/ACT"     , "narrator": "", "text": "帰らないですむ方法はないの？"},
        { "location": "908/TALK"    , "narrator": "神楽", "text": "ない"},
        { "location": "910/TALK"    , "narrator": "神楽", "text": "たぶん"},
        { "location": "912/SEL"     , "narrator": "", "text": "まず状況を整理してみない？"},
        { "location": "913/SEL"     , "narrator": "", "text": "神楽がいなくなるのはさみしい"},
        { "location": "914/SEL"     , "narrator": "", "text": "それは大問題だ"},
        { "location": "915/ACT"     , "narrator": "", "text": "まず状況を整理してみない？"},
        { "location": "916/TALK"    , "narrator": "神楽", "text": "そうするとどうなるの？"},
        { "location": "918/SEL"     , "narrator": "", "text": "帰らなくてよくなるかも"},
        { "location": "919/SEL"     , "narrator": "", "text": "現状打破のヒントがあるかも"},
        { "location": "920/SEL"     , "narrator": "", "text": "気持ちが落ち着く？"},
        { "location": "921/ACT"     , "narrator": "", "text": "帰らなくてよくなるかも"},
        { "location": "922/TALK"    , "narrator": "神楽", "text": "闇雲にﾎﾟｼﾞﾃｨﾌﾞ"},
        { "location": "923/ACT"     , "narrator": "", "text": "現状打破のヒントがあるかも"},
        { "location": "924/TALK"    , "narrator": "神楽", "text": "可能性を探るんだ"},
        { "location": "925/ACT"     , "narrator": "", "text": "気持ちが落ち着く？"},
        { "location": "926/TALK"    , "narrator": "神楽", "text": "聞かれてもﾅｰ"},
        { "location": "928/ACT"     , "narrator": "", "text": "神楽がいなくなるのはさみしい"},
        { "location": "929/TALK"    , "narrator": "神楽", "text": "本当にそう思ってる？"},
        { "location": "931/SEL"     , "narrator": "", "text": "当然でしょ"},
        { "location": "932/SEL"     , "narrator": "", "text": "伝わってないのか…"},
        { "location": "933/SEL"     , "narrator": "", "text": "神楽が思ってる以上にさみしい"},
        { "location": "934/ACT"     , "narrator": "", "text": "当然でしょ"},
        { "location": "935/TALK"    , "narrator": "神楽", "text": "当然なんだ？"},
        { "location": "936/ACT"     , "narrator": "", "text": "伝わってないのか…"},
        { "location": "937/TALK"    , "narrator": "神楽", "text": "そういうことなの！？！？"},
        { "location": "938/ACT"     , "narrator": "", "text": "神楽が思ってる以上にさみしい"},
        { "location": "939/TALK"    , "narrator": "神楽", "text": "本気ですかですかですか！？"},
        { "location": "941/ACT"     , "narrator": "", "text": "それは大問題だ"},
        { "location": "942/TALK"    , "narrator": "神楽", "text": "$handle$の中では大問題なんだ"},
        { "location": "943/TALK"    , "narrator": "神楽", "text": "ぴょんこがいなくなるのは"},
        { "location": "945/SEL"     , "narrator": "", "text": "そうだよ！"},
        { "location": "946/SEL"     , "narrator": "", "text": "何でそんなこと聞くかな？"},
        { "location": "947/SEL"     , "narrator": "", "text": "これ以上の問題なんてない（ｷﾘｯ"},
        { "location": "948/ACT"     , "narrator": "", "text": "そうだよ！"},
        { "location": "949/TALK"    , "narrator": "神楽", "text": "ｶﾞﾁ勢だった！"},
        { "location": "950/ACT"     , "narrator": "", "text": "何でそんなこと聞くかな？"},
        { "location": "951/TALK"    , "narrator": "神楽", "text": "聞き返された！？"},
        { "location": "952/ACT"     , "narrator": "", "text": "これ以上の問題なんてない（ｷﾘｯ"},
        { "location": "953/TALK"    , "narrator": "神楽", "text": "$handle$のドヤ顔が見える、、、"},
        { "location": "956/TALK"    , "narrator": "神楽", "text": "そっかそっか"},
        { "location": "957/TALK"    , "narrator": "神楽", "text": "$handle$はぴょんこと離れるのがいやなんだ"},
        { "location": "958/TALK"    , "narrator": "神楽", "text": "そっかー"},
        { "location": "960/SEL"     , "narrator": "", "text": "嫌に決まってるでしょ"},
        { "location": "961/SEL"     , "narrator": "", "text": "何で今さらそんなこと"},
        { "location": "962/SEL"     , "narrator": "", "text": "大事に思ってるからね！"},
        { "location": "963/ACT"     , "narrator": "", "text": "嫌に決まってるでしょ"},
        { "location": "964/TALK"    , "narrator": "神楽", "text": "決まってたとは～～～～～～！！！！！"},
        { "location": "965/ACT"     , "narrator": "", "text": "何で今さらそんなこと"},
        { "location": "966/TALK"    , "narrator": "神楽", "text": "今さらdeathか？"},
        { "location": "967/ACT"     , "narrator": "", "text": "大事に思ってるからね！"},
        { "location": "968/TALK"    , "narrator": "神楽", "text": "あ゛あ゛あ゛あ゛あ゛あ゛あ゛"},
        { "location": "970/TALK"    , "narrator": "神楽", "text": "それはそれとして"},
        { "location": "971/TALK"    , "narrator": "神楽", "text": "行きたいところには付き合ってもらえるぴょん？"},
        { "location": "973/SEL"     , "narrator": "", "text": "…付き合うけど…"},
        { "location": "974/SEL"     , "narrator": "", "text": "できたら帰らない方法が見つかってからがいいけど"},
        { "location": "975/SEL"     , "narrator": "", "text": "デートってことなら…"},
        { "location": "976/ACT"     , "narrator": "", "text": "…付き合うけど…"},
        { "location": "977/TALK"    , "narrator": "神楽", "text": "ありがとぴょん♪"},
        { "location": "978/ACT"     , "narrator": "", "text": "できたら帰らない方法が見つかってからがいいけど"},
        { "location": "979/TALK"    , "narrator": "神楽", "text": "そうすると時間がないし"},
        { "location": "980/TALK"    , "narrator": "神楽", "text": "どうしても行きたいから"},
        { "location": "981/ACT"     , "narrator": "", "text": "デートってことなら…"},
        { "location": "982/TALK"    , "narrator": "神楽", "text": "デートに決まってるぴょん"},
        { "location": "983/TALK"    , "narrator": "神楽", "text": "あたりまえー！！！"},
        { "location": "985/TALK"    , "narrator": "神楽", "text": "じゃあよろしくですよ～～"},
        { "location": "986/TALK"    , "narrator": "神楽", "text": "ぴょんこおめかしするから♪"},
