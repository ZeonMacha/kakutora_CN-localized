        { "location": "190/SCENARIO", "narrator": "", "text": "05_000_そろばんずくの誤算"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "トライナリーのみんなと"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "トランプをやってみたのだが"},
        { "location": "217/TALK"    , "narrator": "みやび", "text": "これが"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "勝てなかったのだよ"},
        { "location": "220/SEL"     , "narrator": "", "text": "何したの"},
        { "location": "221/ACT"     , "narrator": "", "text": "何したの"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "ダウト"},
        { "location": "224/TALK"    , "narrator": "みやび", "text": "ぞね"},
        { "location": "226/SEL"     , "narrator": "", "text": "運もありそうだけど"},
        { "location": "227/SEL"     , "narrator": "", "text": "楽しくはなかったの？"},
        { "location": "228/SEL"     , "narrator": "", "text": "計算し過ぎたんじゃないの"},
        { "location": "229/ACT"     , "narrator": "", "text": "運もありそうだけど"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "それを"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "勝機に変えたかったぞね"},
        { "location": "232/ACT"     , "narrator": "", "text": "楽しくはなかったの？"},
        { "location": "233/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "楽しめた"},
        { "location": "236/ACT"     , "narrator": "", "text": "計算し過ぎたんじゃないの"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "確かに"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "そういうこと"},
        { "location": "240/TALK"    , "narrator": "みやび", "text": "なんじゃろうな"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "さすが相棒"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "勝ちたいというより"},
        { "location": "244/TALK"    , "narrator": "みやび", "text": "負けた原因をはっきりさせたいのだ"},
        { "location": "246/SEL"     , "narrator": "", "text": "遊びなんだから気楽にすれば"},
        { "location": "247/SEL"     , "narrator": "", "text": "冷静な分析が必要だね"},
        { "location": "248/SEL"     , "narrator": "", "text": "相手ごとに対策を練るべきだ"},
        { "location": "249/ACT"     , "narrator": "", "text": "遊びなんだから気楽にすれば"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "251/TALK"    , "narrator": "みやび", "text": "そうかもしれんな"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "そうするか"},
        { "location": "253/ACT"     , "narrator": "", "text": "冷静な分析が必要だね"},
        { "location": "254/TALK"    , "narrator": "みやび", "text": "確かに"},
        { "location": "255/TALK"    , "narrator": "みやび", "text": "しかし今は"},
        { "location": "256/TALK"    , "narrator": "みやび", "text": "意外と冷静になれぬ"},
        { "location": "257/TALK"    , "narrator": "みやび", "text": "ちっくと"},
        { "location": "258/TALK"    , "narrator": "みやび", "text": "頭を冷やすことにするぞね"},
        { "location": "259/ACT"     , "narrator": "", "text": "相手ごとに対策を練るべきだ"},
        { "location": "261/TALK"    , "narrator": "みやび", "text": "確かに"},
        { "location": "262/TALK"    , "narrator": "みやび", "text": "総括ではなく各人に対する対策が必要ぞね"},
        { "location": "263/TALK"    , "narrator": "みやび", "text": "よしよし"},
        { "location": "265/TALK"    , "narrator": "みやび", "text": "勝機が見えたぞね"}
    ]
}
