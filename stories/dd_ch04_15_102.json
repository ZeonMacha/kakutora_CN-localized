{
    "dir": "chap15/daydra/dd_ch04_15_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "15405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "適正な役割分担とは＜後編＞"
    },
    "entry":
    [
        { "location": "586/SCENARIO", "narrator": "", "text": "偶然の出会い"},
        { "location": "603/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "607/TALK"    , "narrator": "みやび", "text": "まほさん、\n一つお願いがあるが\nですよ。"},
        { "location": "608/TALK"    , "narrator": "みやび", "text": "うち、後方援護に\n回りますき、\n残りたいがですよ。"},
        { "location": "609/TALK"    , "narrator": "透明真幌", "text": "後方援護だと？"},
        { "location": "610/TALK"    , "narrator": "みやび", "text": "今回の世界は、\nアプリゲームの世界\n言うてましたよね？"},
        { "location": "612/TALK"    , "narrator": "みやび", "text": "なら、プログラムを\n改変してこちらに\n有利な状況を――"},
        { "location": "613/TALK"    , "narrator": "みやび", "text": "作りだすことも\nできると思うが\nですよ。"},
        { "location": "614/TALK"    , "narrator": "透明真幌", "text": "…現場に行って\n作業することは\nできないのか？"},
        { "location": "615/TALK"    , "narrator": "みやび", "text": "内部からだと、\n改変できん可能性が\nあります。"},
        { "location": "616/TALK"    , "narrator": "みやび", "text": "それと、指令室の\nマシンの方がパワーが\n上やき――"},
        { "location": "617/TALK"    , "narrator": "みやび", "text": "改変作業に重視する\nなら、残った方が\n効率えいがですよ。"},
        { "location": "618/TALK"    , "narrator": "透明真幌", "text": "なるほど…。"},
        { "location": "619/TALK"    , "narrator": "みやび", "text": "どうですか？"},
        { "location": "620/TALK"    , "narrator": "透明真幌", "text": "…いい判断だ。\nでは、みやびは残り\n後方援護を頼む。"},
        { "location": "621/TALK"    , "narrator": "みやび", "text": "了解です。"},
        { "location": "627/TALK"    , "narrator": "みやび", "text": "…ちゅうわけやき、\n光月さんのアイデア、\n使わせてもらうぞね。"},
        { "location": "629/TALK"    , "narrator": "みやび", "text": "まっこと助かった。\nありがとう。"},
        { "location": "630/TALK"    , "narrator": "繭", "text": "い、いえ…、\nお力になれたなら\n光栄です。"},
        { "location": "632/TALK"    , "narrator": "繭", "text": "…それと、もし私の\n思い付きを採用される\nのでしたら――"},
        { "location": "633/TALK"    , "narrator": "繭", "text": "一つ、お願いが\nあるのですが…。"},
        { "location": "635/TALK"    , "narrator": "みやび", "text": "缶ジュースか？\nそれともチュウか？"},
        { "location": "637/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "640/TALK"    , "narrator": "繭", "text": "………………。"},
        { "location": "642/TALK"    , "narrator": "繭", "text": "……………………。"},
        { "location": "645/TALK"    , "narrator": "繭", "text": "…いえ…どちらでも\nなくて…。"},
        { "location": "646/TALK"    , "narrator": "繭", "text": "みやび先輩の、\n作業のお手伝いを\nさせてほしいんです。"},
        { "location": "647/TALK"    , "narrator": "みやび", "text": "手伝ってくれるが？"},
        { "location": "648/TALK"    , "narrator": "繭", "text": "はい…とはいっても、\n簡単な作業程度しか\nお力になれませんが。"},
        { "location": "650/TALK"    , "narrator": "みやび", "text": "いや、正直手伝いが\nおるんは助かる。"},
        { "location": "652/TALK"    , "narrator": "みやび", "text": "それに、光月さんの\nプログラムセンスは\n中々やき――"},
        { "location": "653/TALK"    , "narrator": "みやび", "text": "ハッカー修行にも\n丁度えいかもしれん。"},
        { "location": "654/TALK"    , "narrator": "みやび", "text": "準備ができ次第\n連絡するきね。"},
        { "location": "656/TALK"    , "narrator": "繭", "text": "お待ちしております。"},
        { "location": "657/TALK"    , "narrator": "みやび", "text": "ん、それじゃ…。"},
        { "location": "661/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "662/TALK"    , "narrator": "繭", "text": "ごめんなさい、\nみやび先輩…。"},
        { "location": "663/TALK"    , "narrator": "繭", "text": "私は…、あなたの\nことを利用して\nしまいました…。"},
        { "location": "664/TALK"    , "narrator": "繭", "text": "でも、プログラムの\n奥深くまで潜れさえ\nすれば――"},
        { "location": "665/TALK"    , "narrator": "繭", "text": "きっと、どこかに\nバックドアがある\nはず。"},
        { "location": "666/TALK"    , "narrator": "繭", "text": "それさえ見つけて、\n開けることさえ\nできれば――"},
        { "location": "667/TALK"    , "narrator": "繭", "text": "フェノメノンの\n絡繰りが、何かしら\nわかるかもしれない。"},
        { "location": "668/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "669/TALK"    , "narrator": "繭", "text": "今は、少しでも\n情報を集めることが\n最優先…。"},
        { "location": "670/TALK"    , "narrator": "繭", "text": "ＦａｔａｌＱｕｅｅｎ\nと共に、管理庁の\n謎を解くためにも。"},
        { "location": "671/TALK"    , "narrator": "繭", "text": "だから――"},
        { "location": "672/TALK"    , "narrator": "繭", "text": "許してください、\nみやび先輩…。"},
        { "location": "700/TALK"    , "narrator": "みやび", "text": "聞いてたか相棒？"},
        { "location": "701/TALK"    , "narrator": "みやび", "text": "さっきの光月さんの案"},
        { "location": "702/TALK"    , "narrator": "みやび", "text": "まっこと凄いと思わん？"},
        { "location": "704/SEL"     , "narrator": "", "text": "嬉しそうだね"},
        { "location": "705/ACT"     , "narrator": "", "text": "嬉しそうだね"},
        { "location": "707/TALK"    , "narrator": "みやび", "text": "嬉しさエクスプロージョン"},
        { "location": "709/TALK"    , "narrator": "みやび", "text": "フェノメノンをハッキングして"},
        { "location": "710/TALK"    , "narrator": "みやび", "text": "改変するとか"},
        { "location": "711/TALK"    , "narrator": "みやび", "text": "思い付きにしても凄い"},
        { "location": "712/TALK"    , "narrator": "みやび", "text": "ああいう閃きこそ"},
        { "location": "713/TALK"    , "narrator": "みやび", "text": "ハッカーに大切なセンスなのである"},
        { "location": "715/SEL"     , "narrator": "", "text": "繭にはハッカーのセンスあり？"},
        { "location": "716/ACT"     , "narrator": "", "text": "繭にはハッカーのセンスあり？"},
        { "location": "718/TALK"    , "narrator": "みやび", "text": "大ありやね"},
        { "location": "719/TALK"    , "narrator": "みやび", "text": "ちゅうか"},
        { "location": "720/TALK"    , "narrator": "みやび", "text": "前々からそう思ってはいた"},
        { "location": "721/TALK"    , "narrator": "みやび", "text": "発言やコードの組み方を見ればわかる"},
        { "location": "722/TALK"    , "narrator": "みやび", "text": "ただ者じゃない感半端ない"},
        { "location": "725/TALK"    , "narrator": "みやび", "text": "意外と"},
        { "location": "726/TALK"    , "narrator": "みやび", "text": "うちのＦａｔａｌＱｕｅｅｎとしての活動の方で"},
        { "location": "727/TALK"    , "narrator": "みやび", "text": "花を咲かせるのかもしれん"},
        { "location": "728/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "729/TALK"    , "narrator": "みやび", "text": "勝手な期待やけんど"},
        { "location": "740/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "741/TALK"    , "narrator": "みやび", "text": "いずれは、仲間に\n誘うのもえいかも\nしれんなぁ…。"},
        { "location": "752/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【12 ピクシャル】"}
    ]
}
