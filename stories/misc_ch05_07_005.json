        "title": "Extra007 ヒメゴトチャット",
        "sub_title": "マカロンをどうぞ"
    },
    "entry":
    [
        { "location": "1337/SCENARIO", "narrator": "", "text": "マカロンをどうぞ"},
        { "location": "1362/TALK"    , "narrator": "神楽", "text": "マカロンとババロアは作りたくない"},
        { "location": "1363/TALK"    , "narrator": "神楽", "text": "この二つは最高難易度を誇るお菓子たちだから"},
        { "location": "1365/SEL"     , "narrator": "", "text": "そうなんだ？"},
        { "location": "1366/SEL"     , "narrator": "", "text": "じゃあ$me$がプレゼントするね"},
        { "location": "1367/SEL"     , "narrator": "", "text": "えー作ってよー"},
        { "location": "1368/ACT"     , "narrator": "", "text": "そうなんだ？"},
        { "location": "1369/TALK"    , "narrator": "神楽", "text": "厳密な温度管理と湿度管理が必要だから"},
        { "location": "1370/ACT"     , "narrator": "", "text": "じゃあ$me$がプレゼントするね"},
        { "location": "1372/TALK"    , "narrator": "神楽", "text": "えっ！！！！"},
        { "location": "1374/TALK"    , "narrator": "神楽", "text": "やだ…やさしい…"},
        { "location": "1375/TALK"    , "narrator": "神楽", "text": "絶対にちょうだいね！！！！"},
        { "location": "1376/ACT"     , "narrator": "", "text": "えー作ってよー"},
        { "location": "1377/TALK"    , "narrator": "神楽", "text": "却下"},
        { "location": "1388/TALK"    , "narrator": "神楽", "text": "そういうものはプロが作ったものを買うのが一番いい"},
        { "location": "1390/TALK"    , "narrator": "神楽", "text": "愛情こもった不味いお菓子よりプロの技の美味しいお菓子こそが正義"},
        { "location": "1392/SEL"     , "narrator": "", "text": "そ、そうだね…"},
        { "location": "1393/SEL"     , "narrator": "", "text": "隙があるのが家庭料理のよさ"},
        { "location": "1394/SEL"     , "narrator": "", "text": "神楽のプロ意識格好いい"},
        { "location": "1395/ACT"     , "narrator": "", "text": "そ、そうだね…"},
        { "location": "1396/TALK"    , "narrator": "神楽", "text": "そこで引くタイプかー"},
        { "location": "1397/ACT"     , "narrator": "", "text": "隙があるのが家庭料理のよさ"},
        { "location": "1398/TALK"    , "narrator": "神楽", "text": "それって真理"},
        { "location": "1399/ACT"     , "narrator": "", "text": "神楽のプロ意識格好いい"},
        { "location": "1401/TALK"    , "narrator": "神楽", "text": "当たり前のことを言ってるだけなんだけどね"},
        { "location": "1402/TALK"    , "narrator": "神楽", "text": "プロじゃない人にはあんまりわかってもらえない部分だったり"},
        { "location": "1404/TALK"    , "narrator": "神楽", "text": "マカロンは季節ごとに限定フレーバーも出るから楽しい"},
        { "location": "1405/TALK"    , "narrator": "神楽", "text": "ショーケースの中のマカロンって宝石みたいだし"},
        { "location": "1406/TALK"    , "narrator": "神楽", "text": "味が好きかって聞かれたら実はそうでもないんだけど"},
        { "location": "1407/TALK"    , "narrator": "神楽", "text": "それでも買っちゃう魅力があるって逆にすごいと思う"}
    ]
}
