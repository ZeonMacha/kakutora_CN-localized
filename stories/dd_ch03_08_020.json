{
    "dir": "chap08/daydra/dd_ch03_08_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "8356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "図書室でのこと"
    },
    "entry":
    [
        { "location": "202/SCENARIO", "narrator": "", "text": "図書室でのこと"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…中々ピンとくる\n本が見つからないわ…。"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "この辺りの棚で間違いは\nないはずなんだけど…。"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "何ば探しちゅう？"},
        { "location": "227/TALK"    , "narrator": "ガブリエラ", "text": "うわっ、みやび！\nいきなり出てこないでよ！"},
        { "location": "228/TALK"    , "narrator": "みやび", "text": "シッ！"},
        { "location": "229/TALK"    , "narrator": "みやび", "text": "図書室で大声は厳禁やき。"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "…誰のせいよ、まったく。"},
        { "location": "234/TALK"    , "narrator": "ガブリエラ", "text": "まあ、いいわ。\nていうか、結構\nナイスタイミングだし。"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと聞きたいことが\nあるの。"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "今ね、日本の文化を学べる\nよさそうな本を探してるん\nだけど――"},
        { "location": "238/TALK"    , "narrator": "ガブリエラ", "text": "中々ピンとくるものが\nなくて困ってるの。"},
        { "location": "240/TALK"    , "narrator": "みやび", "text": "日本の文化かぁ…。"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "なら、そっちの棚にある、\nこの本なんかどうや？"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "ありがと。\nえっと…………。"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "って、これラノベの\n棚じゃない…。"},
        { "location": "249/TALK"    , "narrator": "みやび", "text": "今の日本において、\nラノベは一つの文化として\n確立してるき。"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "古いだけやなくて、\n新しい文化にも目を\n向けんといかんきな。"},
        { "location": "252/TALK"    , "narrator": "ガブリエラ", "text": "そ、それはそうだけど、\nう～ん…。"},
        { "location": "254/TALK"    , "narrator": "ガブリエラ", "text": "今学びたいのは、日本の\n昔の文化だったんだけど\nなぁ…。"},
        { "location": "255/TALK"    , "narrator": "ガブリエラ", "text": "でも、みやびの言うとおり\n今の文化を学ぶことも\n大切な気がするし…。"},
        { "location": "256/TALK"    , "narrator": "ガブリエラ", "text": "…仕方ないわね。"},
        { "location": "268/TALK"    , "narrator": "ガブリエラ", "text": "ねえ、マルザンナ"},
        { "location": "269/TALK"    , "narrator": "ガブリエラ", "text": "日本の文化を勉強したくて本をさがしてたら"},
        { "location": "270/TALK"    , "narrator": "ガブリエラ", "text": "ラノベも文化の一つ、って言われたの"},
        { "location": "271/TALK"    , "narrator": "ガブリエラ", "text": "これって本当かしら？"},
        { "location": "273/SEL"     , "narrator": "", "text": "ラノベも面白いよ"},
        { "location": "274/SEL"     , "narrator": "", "text": "からかわれてるだけ"},
        { "location": "275/SEL"     , "narrator": "", "text": "童話を読んだ方がいい"},
        { "location": "276/ACT"     , "narrator": "", "text": "ラノベも面白いよ"},
        { "location": "277/TALK"    , "narrator": "ガブリエラ", "text": "面白さを求めているわけじゃないのよ、もう…"},
        { "location": "289/TALK"    , "narrator": "ガブリエラ", "text": "ま、まあ、一応薦めてもら\nったから読みはするけど…。"},
        { "location": "290/TALK"    , "narrator": "みやび", "text": "そう言ってもらえると、\nうちも薦めた甲斐があるっ\nてもんよ。"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "でも！"},
        { "location": "292/TALK"    , "narrator": "ガブリエラ", "text": "昔の文化を学べる本も\n教えてもらうわ。"},
        { "location": "293/TALK"    , "narrator": "みやび", "text": "えいよ。\nなら向こうの棚に移動や。"},
        { "location": "296/TALK"    , "narrator": "ガブリエラ", "text": "始めっからそっちのを\n薦めてほしかったなぁ…。"},
        { "location": "297/ACT"     , "narrator": "", "text": "からかわれてるだけ"},
        { "location": "298/TALK"    , "narrator": "ガブリエラ", "text": "やっぱりそうよね"},
        { "location": "310/TALK"    , "narrator": "ガブリエラ", "text": "ラノベが今の文化だって\nいうのはよくわかったわ。"},
        { "location": "311/TALK"    , "narrator": "ガブリエラ", "text": "けど、今知りたいのは\n昔の日本の文化だから。"},
        { "location": "313/TALK"    , "narrator": "みやび", "text": "…ラノベはえいのか？"},
        { "location": "314/TALK"    , "narrator": "ガブリエラ", "text": "ラノベ自体は文化でも、\n内容は日本文化とは関係\nないじゃない。"},
        { "location": "315/TALK"    , "narrator": "ガブリエラ", "text": "この本なんて、舞台が地球\nじゃないみたいだし。"},
        { "location": "317/TALK"    , "narrator": "みやび", "text": "…仕方ない。"},
        { "location": "319/TALK"    , "narrator": "みやび", "text": "ちっくとマジメにお薦めの\nえい本を教えちゃるよ。"},
        { "location": "321/TALK"    , "narrator": "ガブリエラ", "text": "最初からマジメに紹介して\nよ…。"},
        { "location": "322/ACT"     , "narrator": "", "text": "童話を読んだ方がいい"},
        { "location": "325/TALK"    , "narrator": "ガブリエラ", "text": "さすがねマルザンナ"},
        { "location": "326/TALK"    , "narrator": "ガブリエラ", "text": "私も、そっちの方がいいわ"},
        { "location": "338/TALK"    , "narrator": "ガブリエラ", "text": "みやび、ラノベはいいから\nお薦めの童話を教えて。"},
        { "location": "339/TALK"    , "narrator": "みやび", "text": "童話って、昔話の絵本で\nえいの？"},
        { "location": "340/TALK"    , "narrator": "ガブリエラ", "text": "童話なら何だって構わない\nわ。"},
        { "location": "341/TALK"    , "narrator": "ガブリエラ", "text": "あ、でも最初だから楽しく\n読めるのがいいかも。"},
        { "location": "342/TALK"    , "narrator": "みやび", "text": "童話は大抵楽しいき、\n心配はないちや。"},
        { "location": "344/TALK"    , "narrator": "みやび", "text": "しっかし、ガブちゃんが\n気に入りそうな童話…\nどれがいいか迷うなぁ。"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "有名どころでいいから早く\n教えてってば…。"},
        { "location": "210/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月10日　3:34 PM</color>\nある日の放課後、学園内図書館にて。"},
        { "location": "357/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch03", "text": "【新約童話もございます】"}
    ]
}
