{
    "dir": "dramatics/daydra/drm_ch03_00_140.js",
    "type": "Episode",
    "info": {
        "story_id": "3014",
        "cid": "gabriella",
        "title": "らぶとーく  第14話",
        "sub_title": "精一杯の、本音"
    },
    "entry":
    [
        { "location": "309/SCENARIO", "narrator": "", "text": "精一杯の、本音"},
        { "location": "323/TALK"    , "narrator": "ガブリエラ", "text": "…今日は学食にでも\n行ってみようかしら？"},
        { "location": "325/TALK"    , "narrator": "雛", "text": "ガブリエラちゃん、\n発見！"},
        { "location": "326/TALK"    , "narrator": "ガブリエラ", "text": "きゃぁっ！？"},
        { "location": "333/TALK"    , "narrator": "ガブリエラ", "text": "な、なに！？\nひなこ！？\nどうしてここに！？"},
        { "location": "335/TALK"    , "narrator": "つばめ", "text": "ごめんなさい、ガブちゃん。\n驚かせちゃった？"},
        { "location": "336/TALK"    , "narrator": "繭", "text": "中等部の教室…\nあんまり高等部とは\n変わらないのね？"},
        { "location": "337/TALK"    , "narrator": "キリト", "text": "だな。\nこれじゃ進級する楽しみ\nねぇだろうに…。"},
        { "location": "338/TALK"    , "narrator": "ヒカル", "text": "教室なんですから、\nどこも似たような感じ\nなのは仕方ないですよ。"},
        { "location": "340/TALK"    , "narrator": "ガブリエラ", "text": "…大勢で来たわね。\nあたしに何か用？"},
        { "location": "341/TALK"    , "narrator": "つばめ", "text": "ガブちゃん、お昼ご飯は\nまだだよね？"},
        { "location": "343/TALK"    , "narrator": "つばめ", "text": "今日は天気もいいから、\n外で食べない？"},
        { "location": "345/TALK"    , "narrator": "ガブリエラ", "text": "お昼のお誘いなら、\nＷＡＶＥで声掛ければ\n済むことじゃない。"},
        { "location": "347/TALK"    , "narrator": "雛", "text": "えーっ、それだと\nそっけなくてつまらない\nじゃん。"},
        { "location": "349/TALK"    , "narrator": "つばめ", "text": "みんなで食べようと\n思って、今日は沢山\n作ってきたんです。"},
        { "location": "350/TALK"    , "narrator": "つばめ", "text": "だから、ガブちゃんも\n一緒に食べに行かない？"},
        { "location": "352/TALK"    , "narrator": "ガブリエラ", "text": "そ、そう言われても…。"},
        { "location": "354/TALK"    , "narrator": "ガブリエラ", "text": "…つばめや、ひなこや\n繭だけならいいんだ\nけど…。"},
        { "location": "355/TALK"    , "narrator": "キリト", "text": "なあ、早いとこメシに\nしようぜ。"},
        { "location": "357/TALK"    , "narrator": "キリト", "text": "俺、もう腹減って\n我慢できねぇよ。"},
        { "location": "359/TALK"    , "narrator": "繭", "text": "寝坊したのが悪い。\n自業自得。"},
        { "location": "360/TALK"    , "narrator": "ヒカル", "text": "まあまあ…でも、午後は\n体育の授業もあります\nからね。"},
        { "location": "361/TALK"    , "narrator": "ヒカル", "text": "お昼はしっかり食べて\nおかないと、身体が\n持ちませんよ。"},
        { "location": "366/TALK"    , "narrator": "ガブリエラ", "text": "…男の子達も一緒に\n食べるのは、\nちょっと…。"},
        { "location": "367/SEL"     , "narrator": "", "text": "断れば？"},
        { "location": "368/SEL"     , "narrator": "", "text": "一緒に食べなよ"},
        { "location": "369/SEL"     , "narrator": "", "text": "$me$も食べたいな"},
        { "location": "372/TALK"    , "narrator": "ガブリエラ", "text": "まともに話せないから、\n空気も悪くしちゃいそう\nだし…。"},
        { "location": "374/TALK"    , "narrator": "ガブリエラ", "text": "…やっぱり、断った方が\n良いかしら。"},
        { "location": "378/TALK"    , "narrator": "ガブリエラ", "text": "遠慮するわ。"},
        { "location": "379/TALK"    , "narrator": "つばめ", "text": "えっ…でもガブちゃん、\nお昼まだだよね？"},
        { "location": "381/TALK"    , "narrator": "ガブリエラ", "text": "今日は学食で食べたい\n気分なのよ。"},
        { "location": "383/TALK"    , "narrator": "ガブリエラ", "text": "そういうわけだから、\nあんた達だけで\n食べてきなさい。"},
        { "location": "385/TALK"    , "narrator": "雛", "text": "ガーンッ！？\nが、学食に負けた…。"},
        { "location": "387/TALK"    , "narrator": "繭", "text": "負けても仕方ない。\nうちの学食、\n美味しいし。"},
        { "location": "390/TALK"    , "narrator": "つばめ", "text": "ガブちゃんと一緒に\n食べたかったなぁ…。"},
        { "location": "392/TALK"    , "narrator": "キリト", "text": "また別の機会に誘いに\n来ればいいじゃん。"},
        { "location": "393/TALK"    , "narrator": "キリト", "text": "それよか、早くメシに\nしようぜ。"},
        { "location": "394/TALK"    , "narrator": "つばめ", "text": "あ、うん。"},
        { "location": "396/TALK"    , "narrator": "つばめ", "text": "それじゃガブちゃん、\n次は一緒に食べに行こうね。"},
        { "location": "398/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "408/TALK"    , "narrator": "ガブリエラ", "text": "楽しそう…。\nあたしも、一緒に\n食べたかったな…。"},
        { "location": "410/ACT"     , "narrator": "", "text": "断れば？"},
        { "location": "426/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "427/TALK"    , "narrator": "ガブリエラ", "text": "私も、そうした方が良いと思うわ"},
        { "location": "428/TALK"    , "narrator": "ガブリエラ", "text": "…残念ではあるけれど"},
        { "location": "440/TALK"    , "narrator": "ガブリエラ", "text": "遠慮するわ。"},
        { "location": "442/TALK"    , "narrator": "つばめ", "text": "えっ…でもガブちゃん、\nお昼まだだよね？"},
        { "location": "444/TALK"    , "narrator": "ガブリエラ", "text": "今日は学食で食べたい\n気分なのよ。"},
        { "location": "446/TALK"    , "narrator": "ガブリエラ", "text": "そういうわけだから、\nあんた達だけで\n食べてきなさい。"},
        { "location": "448/TALK"    , "narrator": "雛", "text": "ガーンッ！？\nが、学食に負けた…。"},
        { "location": "450/TALK"    , "narrator": "繭", "text": "負けても仕方ない。\nうちの学食、\n美味しいし。"},
        { "location": "453/TALK"    , "narrator": "つばめ", "text": "ガブちゃんと一緒に\n食べたかったなぁ…。"},
        { "location": "455/TALK"    , "narrator": "繭", "text": "…っていうか、\n食べきれるかどうかが\n心配。"},
        { "location": "457/TALK"    , "narrator": "繭", "text": "逢瀬さん、気合い入れて\n結構作ってきたみたい\nだし。"},
        { "location": "459/TALK"    , "narrator": "キリト", "text": "なぁに、おかずだったら\n俺に任せとけって！"},
        { "location": "460/TALK"    , "narrator": "ヒカル", "text": "あまり食べ過ぎても、\n体育が辛くなるだけ\nですよ？"},
        { "location": "461/TALK"    , "narrator": "キリト", "text": "ぐっ…そ、そうだな。\n気持ち多めに貰う\n程度にしとくか。"},
        { "location": "462/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "464/TALK"    , "narrator": "ヒカル", "text": "あの…ガブリエラさん。\n僕らだけでは食べきれ\nそうにもないので――"},
        { "location": "465/TALK"    , "narrator": "ヒカル", "text": "助けると思って、\n一緒に食べていただけ\nると嬉しいのですが…。"},
        { "location": "466/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "467/TALK"    , "narrator": "つばめ", "text": "それじゃ、行こっか。"},
        { "location": "469/TALK"    , "narrator": "ガブリエラ", "text": "…ま、待ちなさい！"},
        { "location": "470/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、あたしも\n一緒に食べるわ。"},
        { "location": "472/TALK"    , "narrator": "つばめ", "text": "えっ？\nでも、今日は学食に\n行くんじゃ…。"},
        { "location": "474/TALK"    , "narrator": "ガブリエラ", "text": "そ、そのつもりだった\nけど…。"},
        { "location": "475/TALK"    , "narrator": "ガブリエラ", "text": "あたしが行かないと、\nおかず余っちゃうん\nでしょ？"},
        { "location": "476/TALK"    , "narrator": "ガブリエラ", "text": "なら、今日はあんた達と\n一緒に食べることに\nするわ。"},
        { "location": "478/TALK"    , "narrator": "雛", "text": "やった！\nガブリエラちゃんは\nやっぱ優しいねー。"},
        { "location": "480/TALK"    , "narrator": "ガブリエラ", "text": "食べ物を無駄にするのが\n嫌なだけよ！"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "ほら、早く行くわよ。\nあたしだってお腹\n空いてるんだから。"},
        { "location": "484/TALK"    , "narrator": "つばめ", "text": "う、うん！\n遠慮しないで、\n沢山食べてね。"},
        { "location": "485/ACT"     , "narrator": "", "text": "一緒に食べなよ"},
        { "location": "501/TALK"    , "narrator": "ガブリエラ", "text": "でも、私が行っても空気悪くなるだけな気がするし…"},
        { "location": "503/SEL"     , "narrator": "", "text": "そんなこと絶対にないよ"},
        { "location": "504/ACT"     , "narrator": "", "text": "そんなこと絶対にないよ"},
        { "location": "506/TALK"    , "narrator": "ガブリエラ", "text": "そう思う？"},
        { "location": "507/TALK"    , "narrator": "ガブリエラ", "text": "$handle$がそこまで言うなら"},
        { "location": "508/TALK"    , "narrator": "ガブリエラ", "text": "今日はみんなとお昼を食べることにするわ"},
        { "location": "521/TALK"    , "narrator": "ガブリエラ", "text": "…わかったわ。"},
        { "location": "523/TALK"    , "narrator": "つばめ", "text": "えっ？"},
        { "location": "525/TALK"    , "narrator": "ガブリエラ", "text": "お昼食べるんでしょ？\nあたしも一緒に\n食べるわ。"},
        { "location": "527/TALK"    , "narrator": "雛", "text": "さっすが\nガブリエラちゃん！"},
        { "location": "529/TALK"    , "narrator": "繭", "text": "誘いに来たのが\n無駄にならなくて\n良かった。"},
        { "location": "532/TALK"    , "narrator": "つばめ", "text": "そうだね…はぁ…、\n本当、断られなくて\n良かった。"},
        { "location": "534/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "535/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、やめるわ。"},
        { "location": "537/TALK"    , "narrator": "つばめ", "text": "えっ、なんで！？"},
        { "location": "538/TALK"    , "narrator": "ガブリエラ", "text": "なんか、断られると\n思われてたみたいだし。"},
        { "location": "540/TALK"    , "narrator": "つばめ", "text": "そ、そんなことないよ！"},
        { "location": "541/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "542/TALK"    , "narrator": "つばめ", "text": "うっ…ちょ、ちょっとは\nそう思ったけど――"},
        { "location": "543/TALK"    , "narrator": "つばめ", "text": "でも、一緒に食べよう、\nって説得しようと\n思ってたのはホントだよ。"},
        { "location": "545/TALK"    , "narrator": "ガブリエラ", "text": "本当かしら？"},
        { "location": "548/TALK"    , "narrator": "つばめ", "text": "本当だよぉ…。"},
        { "location": "549/SEL"     , "narrator": "", "text": "$me$もそう思う"},
        { "location": "550/ACT"     , "narrator": "", "text": "$me$もそう思う"},
        { "location": "569/TALK"    , "narrator": "ガブリエラ", "text": "…わかったわ、$handle$"},
        { "location": "570/TALK"    , "narrator": "ガブリエラ", "text": "新人の言葉は信用できないけど、あなたがそう言うなら信じるわ"},
        { "location": "583/TALK"    , "narrator": "つばめ", "text": "信じてよ、ガブちゃん…。"},
        { "location": "584/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…わかったわよ。"},
        { "location": "585/TALK"    , "narrator": "つばめ", "text": "…本当？"},
        { "location": "587/TALK"    , "narrator": "ガブリエラ", "text": "本当だってば。\nほら、お昼にするなら\n早く食べるわよ。"},
        { "location": "589/TALK"    , "narrator": "雛", "text": "うん、賛成！\nつばめちゃん、\n早く中庭に行こう。"},
        { "location": "591/TALK"    , "narrator": "つばめ", "text": "う、うん。"},
        { "location": "594/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "595/TALK"    , "narrator": "ガブリエラ", "text": "…少しだけ、空気悪く\nしちゃったかも。"},
        { "location": "596/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、断った方が\n良かったかしら？"},
        { "location": "597/ACT"     , "narrator": "", "text": "$me$も食べたいな"},
        { "location": "613/TALK"    , "narrator": "ガブリエラ", "text": "$handle$、お弁当に興味があるの？"},
        { "location": "614/TALK"    , "narrator": "ガブリエラ", "text": "あなたに食べさせることができるなら、私もどうにかするんだけど…"},
        { "location": "616/SEL"     , "narrator": "", "text": "代わりに食べてきて"},
        { "location": "617/ACT"     , "narrator": "", "text": "代わりに食べてきて"},
        { "location": "619/TALK"    , "narrator": "ガブリエラ", "text": "もう、ワガママなんだから"},
        { "location": "620/TALK"    , "narrator": "ガブリエラ", "text": "でも、$handle$の頼みなら断れないわ"},
        { "location": "622/TALK"    , "narrator": "ガブリエラ", "text": "何を食べたか、後で報告するから"},
        { "location": "623/TALK"    , "narrator": "ガブリエラ", "text": "楽しみに待っていてね"}
    ]
}
