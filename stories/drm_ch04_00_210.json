        "title": "らぶとーく 第21話",
        "sub_title": "白い烏が啼いたなら"
    },
    "entry":
    [
        { "location": "260/SCENARIO", "narrator": "", "text": "140_白い烏が啼いたなら"},
        { "location": "285/TALK"    , "narrator": "みやび", "text": "そう"},
        { "location": "286/TALK"    , "narrator": "みやび", "text": "カラスは白い"},
        { "location": "288/SEL"     , "narrator": "", "text": "黒いけど"},
        { "location": "289/SEL"     , "narrator": "", "text": "アルビノってやつだね"},
        { "location": "290/SEL"     , "narrator": "", "text": "何かの比喩？"},
        { "location": "291/ACT"     , "narrator": "", "text": "黒いけど"},
        { "location": "292/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "294/TALK"    , "narrator": "みやび", "text": "普通のカラスはな"},
        { "location": "295/ACT"     , "narrator": "", "text": "アルビノってやつだね"},
        { "location": "296/TALK"    , "narrator": "みやび", "text": "いるらしいな"},
        { "location": "297/TALK"    , "narrator": "みやび", "text": "写真で見た"},
        { "location": "298/ACT"     , "narrator": "", "text": "何かの比喩？"},
        { "location": "308/TALK"    , "narrator": "みやび", "text": "左様"},
        { "location": "309/TALK"    , "narrator": "みやび", "text": "これこそ会話の成立"},
        { "location": "310/TALK"    , "narrator": "みやび", "text": "素晴らしき哉"},
        { "location": "314/TALK"    , "narrator": "みやび", "text": "そしてうちは貴殿を"},
        { "location": "315/TALK"    , "narrator": "みやび", "text": "白い烏と認定した由"},
        { "location": "317/SEL"     , "narrator": "", "text": "えーと"},
        { "location": "318/SEL"     , "narrator": "", "text": "もうちょっと説明して"},
        { "location": "319/SEL"     , "narrator": "", "text": "どうもありがとう"},
        { "location": "320/ACT"     , "narrator": "", "text": "えーと"},
        { "location": "321/TALK"    , "narrator": "みやび", "text": "何ぞね"},
        { "location": "322/ACT"     , "narrator": "", "text": "もうちょっと説明して"},
        { "location": "323/TALK"    , "narrator": "みやび", "text": "仕方ないの"},
        { "location": "324/ACT"     , "narrator": "", "text": "どうもありがとう"},
        { "location": "325/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "326/TALK"    , "narrator": "みやび", "text": "苦しゅうない"},
        { "location": "328/TALK"    , "narrator": "みやび", "text": "つまりだ"},
        { "location": "329/TALK"    , "narrator": "みやび", "text": "貴殿はスパイではない"},
        { "location": "330/TALK"    , "narrator": "みやび", "text": "うちがそう確信したということだ"},
        { "location": "333/SEL"     , "narrator": "", "text": "最初からそう言ってたのに"},
        { "location": "334/SEL"     , "narrator": "", "text": "信用してくれてうれしいよ"},
        { "location": "335/SEL"     , "narrator": "", "text": "それはどうかな"},
        { "location": "336/ACT"     , "narrator": "", "text": "最初からそう言ってたのに"},
        { "location": "337/TALK"    , "narrator": "みやび", "text": "言葉だけではなあ"},
        { "location": "338/ACT"     , "narrator": "", "text": "信用してくれてうれしいよ"},
        { "location": "339/TALK"    , "narrator": "みやび", "text": "そういうことになるかな"},
        { "location": "340/ACT"     , "narrator": "", "text": "それはどうかな"},
        { "location": "341/TALK"    , "narrator": "みやび", "text": "おおおおお"},
        { "location": "342/TALK"    , "narrator": "みやび", "text": "今更何を言う"},
        { "location": "344/TALK"    , "narrator": "みやび", "text": "まあ実際"},
        { "location": "345/TALK"    , "narrator": "みやび", "text": "貴殿がスパイだったならば"},
        { "location": "346/TALK"    , "narrator": "みやび", "text": "逆スパイとして洗脳し"},
        { "location": "347/TALK"    , "narrator": "みやび", "text": "世界を掌握するつもりであった"},
        { "location": "349/SEL"     , "narrator": "", "text": "じゃあスパイになる！"},
        { "location": "350/SEL"     , "narrator": "", "text": "またまた"},
        { "location": "351/SEL"     , "narrator": "", "text": "それは遠慮しとく"},
        { "location": "352/ACT"     , "narrator": "", "text": "じゃあスパイになる！"},
        { "location": "353/TALK"    , "narrator": "みやび", "text": "ほう"},
        { "location": "354/TALK"    , "narrator": "みやび", "text": "これは心強い"},
        { "location": "355/TALK"    , "narrator": "みやび", "text": "期待してもいいかね"},
        { "location": "358/ACT"     , "narrator": "", "text": "またまた"},
        { "location": "359/TALK"    , "narrator": "みやび", "text": "いやいや"},
        { "location": "360/TALK"    , "narrator": "みやび", "text": "本気も本気"},
        { "location": "361/ACT"     , "narrator": "", "text": "それは遠慮しとく"},
        { "location": "362/TALK"    , "narrator": "みやび", "text": "なんと"},
        { "location": "364/TALK"    , "narrator": "みやび", "text": "それは残念だ"},
        { "location": "366/TALK"    , "narrator": "みやび", "text": "だがしかし"},
        { "location": "367/TALK"    , "narrator": "みやび", "text": "$handle$はスパイなどではなく"},
        { "location": "368/TALK"    , "narrator": "みやび", "text": "うちもまた"},
        { "location": "369/TALK"    , "narrator": "みやび", "text": "単なるスーパーハッカー兼、女子高生でしかない"},
        { "location": "371/SEL"     , "narrator": "", "text": "女子高生っていい響きだね"},
        { "location": "372/SEL"     , "narrator": "", "text": "単なる？"},
        { "location": "373/SEL"     , "narrator": "", "text": "みやびは世界一の花だよ"},
        { "location": "374/ACT"     , "narrator": "", "text": "女子高生っていい響きだね"},
        { "location": "375/TALK"    , "narrator": "みやび", "text": "そうか？"},
        { "location": "376/TALK"    , "narrator": "みやび", "text": "なら"},
        { "location": "377/TALK"    , "narrator": "みやび", "text": "$handle$もそう自称すればええぞね"},
        { "location": "380/ACT"     , "narrator": "", "text": "単なる？"},
        { "location": "381/TALK"    , "narrator": "みやび", "text": "そう"},
        { "location": "382/TALK"    , "narrator": "みやび", "text": "そういうものだ"},
        { "location": "383/ACT"     , "narrator": "", "text": "みやびは世界一の花だよ"},
        { "location": "384/TALK"    , "narrator": "みやび", "text": "なんと歯の浮くセリフ"},
        { "location": "385/TALK"    , "narrator": "みやび", "text": "どこぞのアイドルグループの歌詞のようだの"},
        { "location": "386/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "387/TALK"    , "narrator": "みやび", "text": "世辞と受け取っておこう"},
        { "location": "389/TALK"    , "narrator": "みやび", "text": "そういうわけで改めて"},
        { "location": "390/TALK"    , "narrator": "みやび", "text": "よろしくな、相棒"},
        { "location": "393/TALK"    , "narrator": "ボイスメール", "text": "八咫烏のつぶやき"},
        { "location": "304/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "405/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【八咫烏のつぶやき】</color>\nをゲットしました！"}
    ]
}
