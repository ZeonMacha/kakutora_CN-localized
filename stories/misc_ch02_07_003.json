    "entry":
    [
        { "location": "183/SCENARIO", "narrator": "", "text": "05_008_ライセンス"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "みんなも早く取ってくれればいいのに"},
        { "location": "209/TALK"    , "narrator": "アーヤ", "text": "免許"},
        { "location": "212/SEL"     , "narrator": "", "text": "調理師とか"},
        { "location": "213/SEL"     , "narrator": "", "text": "年齢がね"},
        { "location": "214/SEL"     , "narrator": "", "text": "いつも運転お疲れさま"},
        { "location": "215/ACT"     , "narrator": "", "text": "調理師とか"},
        { "location": "216/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "そうじゃなくて"},
        { "location": "218/ACT"     , "narrator": "", "text": "年齢がね"},
        { "location": "219/TALK"    , "narrator": "アーヤ", "text": "問題は"},
        { "location": "220/TALK"    , "narrator": "アーヤ", "text": "そこよね"},
        { "location": "221/ACT"     , "narrator": "", "text": "いつも運転お疲れさま"},
        { "location": "223/TALK"    , "narrator": "アーヤ", "text": "分かってくれる？"},
        { "location": "225/TALK"    , "narrator": "アーヤ", "text": "そうなのよね"},
        { "location": "226/TALK"    , "narrator": "アーヤ", "text": "結局私が運転するしかなくて"},
        { "location": "227/TALK"    , "narrator": "アーヤ", "text": "仕方ないんだけど"},
        { "location": "229/TALK"    , "narrator": "アーヤ", "text": "運転しない方は"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "勝手なこと言うわけよ"},
        { "location": "231/TALK"    , "narrator": "アーヤ", "text": "運転が荒いとか"},
        { "location": "232/TALK"    , "narrator": "アーヤ", "text": "飛ばし過ぎとか"},
        { "location": "234/SEL"     , "narrator": "", "text": "実際どうなの？"},
        { "location": "235/SEL"     , "narrator": "", "text": "安全運転しようよ"},
        { "location": "236/SEL"     , "narrator": "", "text": "免許取ったらわかるって"},
        { "location": "237/ACT"     , "narrator": "", "text": "実際どうなの？"},
        { "location": "238/TALK"    , "narrator": "アーヤ", "text": "え"},
        { "location": "240/TALK"    , "narrator": "アーヤ", "text": "ちょっと荒いかも"},
        { "location": "242/TALK"    , "narrator": "アーヤ", "text": "ちょっとだけね！"},
        { "location": "243/ACT"     , "narrator": "", "text": "安全運転しようよ"},
        { "location": "244/TALK"    , "narrator": "アーヤ", "text": "それも大事だけど"},
        { "location": "245/TALK"    , "narrator": "アーヤ", "text": "急がなきゃってのも"},
        { "location": "246/TALK"    , "narrator": "アーヤ", "text": "あるのよ"},
        { "location": "247/ACT"     , "narrator": "", "text": "免許取ったらわかるって"},
        { "location": "248/TALK"    , "narrator": "アーヤ", "text": "そうかしら"},
        { "location": "249/TALK"    , "narrator": "アーヤ", "text": "まだちょっと"},
        { "location": "250/TALK"    , "narrator": "アーヤ", "text": "先の話ね"},
        { "location": "252/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "253/TALK"    , "narrator": "アーヤ", "text": "運転は嫌いじゃないのよ"},
        { "location": "254/TALK"    , "narrator": "アーヤ", "text": "そこは誤解しないでね"}
    ]
}
