    "entry":
    [
        { "location": "237/SCENARIO", "narrator": "", "text": "フェアリーテイルを聞かせて"},
        { "location": "265/TALK"    , "narrator": "ガブリエラ", "text": "その黒い森の中には"},
        { "location": "266/TALK"    , "narrator": "ガブリエラ", "text": "雪よりも輝く毛並みを持つ"},
        { "location": "267/TALK"    , "narrator": "ガブリエラ", "text": "白銀の狼が住んでいました"},
        { "location": "268/TALK"    , "narrator": "ガブリエラ", "text": "ただ一匹で住んでいました"},
        { "location": "278/SEL"     , "narrator": "", "text": "狼って群れで生活するんだよ"},
        { "location": "279/SEL"     , "narrator": "", "text": "新作だね"},
        { "location": "280/SEL"     , "narrator": "", "text": "その狼は$me$？"},
        { "location": "286/ACT"     , "narrator": "", "text": "狼って群れで生活するんだよ"},
        { "location": "287/TALK"    , "narrator": "ガブリエラ", "text": "お話だから"},
        { "location": "288/TALK"    , "narrator": "ガブリエラ", "text": "これでいいのよ"},
        { "location": "289/ACT"     , "narrator": "", "text": "新作だね"},
        { "location": "290/TALK"    , "narrator": "ガブリエラ", "text": "そうなの"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "新しい話を思いついたの"},
        { "location": "292/ACT"     , "narrator": "", "text": "その狼は$me$？"},
        { "location": "305/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり/////////////////////////"},
        { "location": "306/TALK"    , "narrator": "ガブリエラ", "text": "わかっちゃったかしらvvvvvvvvvvvvvv"},
        { "location": "307/TALK"    , "narrator": "ガブリエラ", "text": "そうなのよ///////////////////////////////////"},
        { "location": "312/TALK"    , "narrator": "ガブリエラ", "text": "その狼は"},
        { "location": "313/TALK"    , "narrator": "ガブリエラ", "text": "ある時娘を見かけました"},
        { "location": "314/TALK"    , "narrator": "ガブリエラ", "text": "森の奥の花咲く場所にやってきた"},
        { "location": "315/TALK"    , "narrator": "ガブリエラ", "text": "一人の娘を"},
        { "location": "317/SEL"     , "narrator": "", "text": "それがガブリエラ？"},
        { "location": "318/SEL"     , "narrator": "", "text": "逃げてー娘逃げてー"},
        { "location": "319/ACT"     , "narrator": "", "text": "それがガブリエラ？"},
        { "location": "322/TALK"    , "narrator": "ガブリエラ", "text": "もちろんよ//////////////"},
        { "location": "323/ACT"     , "narrator": "", "text": "逃げてー娘逃げてー"},
        { "location": "324/TALK"    , "narrator": "ガブリエラ", "text": "そういう話じゃないのよ"},
        { "location": "325/TALK"    , "narrator": "ガブリエラ", "text": "もう！"},
        { "location": "327/TALK"    , "narrator": "ガブリエラ", "text": "狼と娘は"},
        { "location": "330/TALK"    , "narrator": "ガブリエラ", "text": "一目見た時に恋に落ち"},
        { "location": "331/TALK"    , "narrator": "ガブリエラ", "text": "末永く幸せに"},
        { "location": "332/TALK"    , "narrator": "ガブリエラ", "text": "とても幸せに暮らしました"},
        { "location": "334/TALK"    , "narrator": "ガブリエラ", "text": "これは私と$handle$の"},
        { "location": "335/TALK"    , "narrator": "ガブリエラ", "text": "恋の物語"},
        { "location": "283/DIALOG"  , "narrator": "Tutorial/Dialog_Tutorial_Candy", "text": "彼女たちとの会話では\n<color=red>【ココロキャンディ】</color>という\nものを消費して先へ進む。\n\n足りない場合、ジュエルで買うか、\nバトル等で貯めてからストーリーを\n再挑戦することになるから注意。\n\n<color=green>今回だけは使っても減らないから、\n好きな選択肢を選んでみて。</color>"},
        { "location": "302/DIALOG"  , "narrator": "Tutorial/Dialog_Tutorial_Love2", "text": "<color=red>【親密度】</color>を沢山貯めると\n彼女との関係性が変化していく。\n\n<color=green>【友達】</color>になり<color=orange>【恋人】</color>になり…\n更にその先まで発展するかも。\n頑張ってハートを集めて欲しい。\n\n集めたハートは<color=red>【PROFILE】</color>で\n確認できるわ。"},
        { "location": "310/DIALOG"  , "narrator": "Tutorial/Dialog_Tutorial_Camera", "text": "そうそう、ひとつお得情報。\n<color=red>カメラボタンを押すことで、\n彼女を見守る視点を変えられる。</color>\n\n今回はお試しでカメラを５つ\n用意しておいた。\n実際には<color=green>ゴキゲンポイント</color>で\n交換して増やしていくことに\nなるから、今のうちにいっぱい\n堪能しておくといいと思う。"}
    ]
}
