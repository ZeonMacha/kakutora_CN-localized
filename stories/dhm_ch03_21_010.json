    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "おどかさないで！"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "一言いっておきたいことがあるの"},
        { "location": "36/SEL"    , "narrator": "", "text": "何？"},
        { "location": "37/SEL"    , "narrator": "", "text": "聞くかどうかは別問題だから"},
        { "location": "38/SEL"    , "narrator": "", "text": "$me$もガブリエラが大好きだよ"},
        { "location": "39/ACT"    , "narrator": "", "text": "何？"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "ええとね"},
        { "location": "41/ACT"    , "narrator": "", "text": "聞くかどうかは別問題だから"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "でも言っておくわ"},
        { "location": "43/ACT"    , "narrator": "", "text": "$me$もガブリエラが大好きだよ"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "そんな話じゃ"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "ないわよ///////////////"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "私が夜中に"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "トイレに行こうとしていた時"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "声を掛けてきたでしょう？"},
        { "location": "53/SEL"    , "narrator": "", "text": "かけた"},
        { "location": "54/SEL"    , "narrator": "", "text": "憶えてないな"},
        { "location": "55/SEL"    , "narrator": "", "text": "気のせいだよ"},
        { "location": "56/ACT"    , "narrator": "", "text": "かけた"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "そうだったわよね"},
        { "location": "58/ACT"    , "narrator": "", "text": "憶えてないな"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "かけてきたのよ"},
        { "location": "60/ACT"    , "narrator": "", "text": "気のせいだよ"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "そんなわけないでしょう？"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "ちょっとあれは"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "いくらなんでも"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "タイミングが悪すぎよ！"},
        { "location": "67/SEL"    , "narrator": "", "text": "ごめんね"},
        { "location": "68/SEL"    , "narrator": "", "text": "怖がってたから、つい…"},
        { "location": "69/SEL"    , "narrator": "", "text": "漏らさなかった？"},
        { "location": "70/ACT"    , "narrator": "", "text": "ごめんね"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "まあいいわよ"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "私もちょっと驚きすぎたし"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "そんなに気にしなくても"},
        { "location": "75/ACT"    , "narrator": "", "text": "怖がってたから、つい…"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "怖がってなんかないわ"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "ただちょっとびっくりして"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "それだけよ"},
        { "location": "79/ACT"    , "narrator": "", "text": "漏らさなかった？"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "！？！？！？！？！？"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "なんてこと聞くの！？"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "レディに対して！"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "もう"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "なんていうのかしら"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "あり得ないわその発言"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "マナー違反とか通り越しててよ？"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "他の子に言ったりしてないでしょうね？"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "なんだかすごく心配になってきたわ・・・"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "いいこと？"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "そんなことは聞かないものなの"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "ちゃんと憶えておいてちょうだいね"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "言いたいことはそれだけよ"}
    ]
}
