        { "location": "76/TALK"  , "narrator": "みやび", "text": "自分で解読してねん"},
        { "location": "78/TALK"  , "narrator": "みやび", "text": "電脳の海では二進数ですべてを表しているわけだが"},
        { "location": "79/TALK"  , "narrator": "みやび", "text": "貴殿はその例外というわけかね？"},
        { "location": "82/SEL"   , "narrator": "", "text": "ええまあ"},
        { "location": "83/SEL"   , "narrator": "", "text": "そういうことになるかな"},
        { "location": "84/SEL"   , "narrator": "", "text": "何言ってるかわかりません"},
        { "location": "85/ACT"   , "narrator": "", "text": "ええまあ"},
        { "location": "95/TALK"  , "narrator": "みやび", "text": "なるほど"},
        { "location": "98/SEL"   , "narrator": "", "text": "いや普通にお願いします"},
        { "location": "99/SEL"   , "narrator": "", "text": "西暦四桁、月日"},
