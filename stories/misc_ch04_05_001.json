        { "location": "101/TALK" , "narrator": "みやび", "text": "これはこれは"},
        { "location": "102/ACT"  , "narrator": "", "text": "西暦四桁、月日"},
        { "location": "103/TALK" , "narrator": "みやび", "text": "簡単すぎたかね"},
        { "location": "105/ACT"  , "narrator": "", "text": "そういうことになるかな"},
        { "location": "106/TALK" , "narrator": "みやび", "text": "ほう"},
        { "location": "110/SEL"  , "narrator": "", "text": "日本語でお願いします"},
        { "location": "111/SEL"  , "narrator": "", "text": "色相0度、彩度0％、明度86％のグレー"},
        { "location": "112/SEL"  , "narrator": "", "text": "R211G211B211"},
        { "location": "113/ACT"  , "narrator": "", "text": "日本語でお願いします"},
