        { "location": "111/SCENARIO", "narrator": "", "text": "620_嘘つきみやびの真っ赤な真実"},
        { "location": "136/TALK"    , "narrator": "みやび", "text": "$handle$よ"},
        { "location": "137/TALK"    , "narrator": "みやび", "text": "折り入って"},
        { "location": "138/TALK"    , "narrator": "みやび", "text": "お願いがある"},
        { "location": "140/SEL"     , "narrator": "", "text": "何？"},
        { "location": "141/SEL"     , "narrator": "", "text": "できることならいいけど"},
        { "location": "142/SEL"     , "narrator": "", "text": "みやびの言うことならなんでも"},
        { "location": "143/ACT"     , "narrator": "", "text": "何？"},
        { "location": "144/TALK"    , "narrator": "みやび", "text": "単刀直入に言おう"},
        { "location": "145/TALK"    , "narrator": "みやび", "text": "別れてくれ"},
        { "location": "147/SEL"     , "narrator": "", "text": "わかった"},
        { "location": "148/SEL"     , "narrator": "", "text": "何で"},
        { "location": "149/SEL"     , "narrator": "", "text": "意味がわからない"},
        { "location": "150/ACT"     , "narrator": "", "text": "わかった"},
        { "location": "151/TALK"    , "narrator": "みやび", "text": "よし"},
        { "location": "152/TALK"    , "narrator": "みやび", "text": "そういうことで"},
        { "location": "153/ACT"     , "narrator": "", "text": "何で"},
        { "location": "154/TALK"    , "narrator": "みやび", "text": "どうしてもぞね"},
        { "location": "155/ACT"     , "narrator": "", "text": "意味がわからない"},
        { "location": "156/TALK"    , "narrator": "みやび", "text": "言葉通り"},
        { "location": "157/TALK"    , "narrator": "みやび", "text": "その通りの意味だ"},
        { "location": "158/TALK"    , "narrator": "みやび", "text": "わかりおれ"},
        { "location": "169/ACT"     , "narrator": "", "text": "できることならいいけど"},
        { "location": "170/TALK"    , "narrator": "みやび", "text": "できる"},
        { "location": "171/TALK"    , "narrator": "みやび", "text": "みやびさんと別れればいいだけぞね"},
        { "location": "173/SEL"     , "narrator": "", "text": "それはできない"},
        { "location": "174/SEL"     , "narrator": "", "text": "できそうにないな"},
        { "location": "175/SEL"     , "narrator": "", "text": "できるもんか"},
        { "location": "176/ACT"     , "narrator": "", "text": "それはできない"},
        { "location": "177/TALK"    , "narrator": "みやび", "text": "そんなことはなかろ"},
        { "location": "178/TALK"    , "narrator": "みやび", "text": "嘘をつくな"},
        { "location": "179/ACT"     , "narrator": "", "text": "できそうにないな"},
        { "location": "180/TALK"    , "narrator": "みやび", "text": "どうしてぞね"},
        { "location": "181/TALK"    , "narrator": "みやび", "text": "簡単であろう"},
        { "location": "182/ACT"     , "narrator": "", "text": "できるもんか"},
        { "location": "183/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "184/TALK"    , "narrator": "みやび", "text": "そう言わず"},
        { "location": "186/TALK"    , "narrator": "みやび", "text": "やってみよう"},
        { "location": "197/ACT"     , "narrator": "", "text": "みやびの言うことならなんでも"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "よく言った"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "では"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "別れてくれ"},
        { "location": "214/SEL"     , "narrator": "", "text": "理由を聞かせて"},
        { "location": "221/ACT"     , "narrator": "", "text": "理由を聞かせて"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "確かに"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "一方的な要求は"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "フェアではない"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "その"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "$handle$といると"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "みやびさんはみやびさんではなくなってしまうのだ"},
        { "location": "235/SEL"     , "narrator": "", "text": "えーと？"},
        { "location": "236/SEL"     , "narrator": "", "text": "みやびはみやびだよ"},
        { "location": "237/ACT"     , "narrator": "", "text": "えーと？"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "やはり"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "わからんか"},
        { "location": "240/ACT"     , "narrator": "", "text": "みやびはみやびだよ"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "それが"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "そういうわけにはいかんぞね"},
        { "location": "246/SEL"     , "narrator": "", "text": "思い込みじゃない？"},
        { "location": "248/SEL"     , "narrator": "", "text": "$me$のこと嫌いになった？"},
        { "location": "249/ACT"     , "narrator": "", "text": "思い込みじゃない？"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "そうなら"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "どんなにいいことか"},
        { "location": "256/ACT"     , "narrator": "", "text": "$me$のこと嫌いになった？"},
        { "location": "258/TALK"    , "narrator": "みやび", "text": "それはちがう"},
        { "location": "259/TALK"    , "narrator": "みやび", "text": "違うぞね"},
        { "location": "262/TALK"    , "narrator": "ボイスメール", "text": "わからんかもしれんけんど"},
        { "location": "203/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "274/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【わからんかもしれんけんど】</color>\nをゲットしました！"}
