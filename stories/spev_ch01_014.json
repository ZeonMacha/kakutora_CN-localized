    "entry":
    [
        { "location": "32/TALK" , "narrator": "透明つばめ", "text": "どうしたの、銀ちゃん。\nさっきからずっと\n小さくなってるけど…。"},
        { "location": "33/TALK" , "narrator": "銀葉樹", "text": "…ま、前向きに考える\nなんて、言わなければ\nよかったの…。"},
        { "location": "34/TALK" , "narrator": "透明つばめ", "text": "え？"},
        { "location": "35/TALK" , "narrator": "銀葉樹", "text": "この服…サンタ服って\nいうから、普通のかと\n思ったけど…。"},
        { "location": "36/TALK" , "narrator": "銀葉樹", "text": "露出が多すぎて、\n恥ずかしいの…。"},
        { "location": "37/TALK" , "narrator": "透明つばめ", "text": "あ、あはは…ごめんね。\nちゃんと確認すれば\nよかったよね…。"},
        { "location": "38/TALK" , "narrator": "透明つばめ", "text": "でも、大丈夫だよ。\nみんなも着てるんだし。"},
        { "location": "39/TALK" , "narrator": "透明つばめ", "text": "それに、わたしは\n銀ちゃんと同じ格好\nしたかったから…。"},
        { "location": "40/TALK" , "narrator": "透明つばめ", "text": "今、とっても嬉しいよ。"},
        { "location": "42/TALK" , "narrator": "銀葉樹", "text": "…………。"},
        { "location": "43/TALK" , "narrator": "銀葉樹", "text": "つばめは、\nとっても似合ってるの。"},
        { "location": "45/TALK" , "narrator": "透明つばめ", "text": "ほんとう？"},
        { "location": "46/TALK" , "narrator": "銀葉樹", "text": "うん…とっても可愛くて、\nいいと思うの。"},
        { "location": "47/TALK" , "narrator": "透明つばめ", "text": "ありがと…。\nでも、正直なこと\n言うとね――"},
        { "location": "48/TALK" , "narrator": "透明つばめ", "text": "実はわたしも、\nちょっとだけ\n恥ずかしいんだ。"},
        { "location": "49/TALK" , "narrator": "銀葉樹", "text": "そうなの？"},
        { "location": "50/TALK" , "narrator": "透明つばめ", "text": "うん。\n可愛いから好きだけど、\n露出が多いのはね…。"},
        { "location": "51/TALK" , "narrator": "銀葉樹", "text": "ふふっ、一緒なの。"},
        { "location": "54/TALK" , "narrator": "透明つばめ", "text": "えへへ…。"},
        { "location": "55/SEL"  , "narrator": "（選択肢）", "text": "お姉さんやってるね"},
        { "location": "56/ACT"  , "narrator": "", "text": "お姉さんやってるね"},
        { "location": "63/TALK" , "narrator": "つばめ", "text": "そぅかな？(●´ω｀●)ゞｴﾍﾍ"},
        { "location": "64/TALK" , "narrator": "つばめ", "text": "$handle$さんから"},
        { "location": "65/TALK" , "narrator": "つばめ", "text": "そぅ見ぇてるなら"},
        { "location": "66/TALK" , "narrator": "つばめ", "text": "安心したよ(*´︶`*)"},
        { "location": "67/TALK" , "narrator": "つばめ", "text": "今日はね"},
        { "location": "68/TALK" , "narrator": "つばめ", "text": "銀ちゃんにも"},
        { "location": "69/TALK" , "narrator": "つばめ", "text": "ぅんと楽しんでほしぃと思ってるのo(*･ﾛ･*)o、"},
        { "location": "70/SEL"  , "narrator": "（選択肢）", "text": "つばめは銀葉樹が好きなんだね"},
        { "location": "71/SEL"  , "narrator": "（選択肢）", "text": "嫉妬を覚える"},
        { "location": "72/ACT"  , "narrator": "", "text": "つばめは銀葉樹が好きなんだね"},
        { "location": "73/TALK" , "narrator": "つばめ", "text": "ぅん(´ω｀*)"},
        { "location": "74/TALK" , "narrator": "つばめ", "text": "なんだか"},
        { "location": "76/TALK" , "narrator": "つばめ", "text": "放ってぉけなくてヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "79/TALK" , "narrator": "つばめ", "text": "なんて"},
        { "location": "80/TALK" , "narrator": "つばめ", "text": "こんな風に"},
        { "location": "81/TALK" , "narrator": "つばめ", "text": "わたしが思ぅの"},
        { "location": "82/TALK" , "narrator": "つばめ", "text": "変かな？(´･ω･｀) "},
        { "location": "83/TALK" , "narrator": "つばめ", "text": "わたしだって"},
        { "location": "84/TALK" , "narrator": "つばめ", "text": "まだまだなのに(o´Д`)=з"},
        { "location": "85/SEL"  , "narrator": "（選択肢）", "text": "つばめは成長したよ"},
        { "location": "86/SEL"  , "narrator": "（選択肢）", "text": "確かに、つばめも放っておけない"},
        { "location": "87/ACT"  , "narrator": "", "text": "つばめは成長したよ"},
        { "location": "90/TALK" , "narrator": "つばめ", "text": "ほんとぅ？o(*･ﾛ･*)o、"},
        { "location": "91/TALK" , "narrator": "つばめ", "text": "$handle$さんに"},
        { "location": "92/TALK" , "narrator": "つばめ", "text": "そう言われると"},
        { "location": "94/TALK" , "narrator": "つばめ", "text": "とっても嬉しぃ(≧ω≦)"},
        { "location": "95/ACT"  , "narrator": "", "text": "確かに、つばめも放っておけない"},
        { "location": "98/TALK" , "narrator": "つばめ", "text": "だよね(o´Д`)=з"},
        { "location": "99/TALK" , "narrator": "つばめ", "text": "でも"},
        { "location": "100/TALK", "narrator": "つばめ", "text": "それもちょっとぃぃかも(*´︶`*)"},
        { "location": "101/TALK", "narrator": "つばめ", "text": "$handle$さんが"},
        { "location": "102/TALK", "narrator": "つばめ", "text": "放っておかなぃでくれるの"},
        { "location": "103/TALK", "narrator": "つばめ", "text": "嬉しぃし(/ω＼)"},
        { "location": "105/ACT" , "narrator": "", "text": "嫉妬を覚える"},
        { "location": "106/TALK", "narrator": "つばめ", "text": "$handle$さんのそぅぃぅところ"},
        { "location": "107/TALK", "narrator": "つばめ", "text": "好きだよ(*´︶`*)"},
        { "location": "108/TALK", "narrator": "つばめ", "text": "ちょっとカワィィし(≧艸≦*)"},
        { "location": "109/TALK", "narrator": "つばめ", "text": "でもね"},
        { "location": "110/TALK", "narrator": "つばめ", "text": "わたしの一番は$handle$さんだから"},
        { "location": "111/TALK", "narrator": "つばめ", "text": "嫉妬しなくて大丈夫だよヾ(*´ｴ`*)ﾉ ｲｯﾁｬｯﾀ"},
        { "location": "115/TALK", "narrator": "つばめ", "text": "ほんとぅは"},
        { "location": "116/TALK", "narrator": "つばめ", "text": "$handle$さんにも"},
        { "location": "117/TALK", "narrator": "つばめ", "text": "参加してほしかったな(´･ω･｀) "},
        { "location": "119/TALK", "narrator": "つばめ", "text": "きっと"},
        { "location": "120/TALK", "narrator": "つばめ", "text": "今よりもっと"},
        { "location": "121/TALK", "narrator": "つばめ", "text": "楽しくなったと思ぅの(*´︶`*)"},
        { "location": "122/TALK", "narrator": "つばめ", "text": "みんなも"},
        { "location": "123/TALK", "narrator": "つばめ", "text": "きっと喜んだはずだから"},
        { "location": "124/SEL" , "narrator": "（選択肢）", "text": "いつかそんな日が来てくれたらいいな"},
        { "location": "125/SEL" , "narrator": "（選択肢）", "text": "一番喜ぶのはもちろん…"},
        { "location": "126/ACT" , "narrator": "", "text": "いつかそんな日が来てくれたらいいな"},
        { "location": "127/TALK", "narrator": "つばめ", "text": "そぅだね(*≧∀≦*) "},
        { "location": "129/TALK", "narrator": "つばめ", "text": "嬉しくて"},
        { "location": "130/TALK", "narrator": "つばめ", "text": "$handle$さんの隣から離れられなくなっちゃぅかも(´∀｀*)ｳﾌﾌ"},
        { "location": "131/SEL" , "narrator": "（選択肢）", "text": "$me$にとっても嬉しいよ"},
        { "location": "132/SEL" , "narrator": "（選択肢）", "text": "銀葉樹も一緒にね"},
        { "location": "133/ACT" , "narrator": "", "text": "$me$にとっても嬉しいよ"},
        { "location": "136/TALK", "narrator": "つばめ", "text": "ぃつか"},
        { "location": "137/TALK", "narrator": "つばめ", "text": "ほんとぅにそんな日が来てくれたら"},
        { "location": "138/TALK", "narrator": "つばめ", "text": "ぉ互ぃに嬉しいね(*´︶`*)"},
        { "location": "139/ACT" , "narrator": "", "text": "銀葉樹も一緒にね"},
        { "location": "142/TALK", "narrator": "つばめ", "text": "もちろん(≧ω≦)"},
        { "location": "143/TALK", "narrator": "つばめ", "text": "銀ちゃんも"},
        { "location": "144/TALK", "narrator": "つばめ", "text": "きっと$handle$さんと仲良くなると思ぅよ(´∀｀*)"},
        { "location": "145/TALK", "narrator": "つばめ", "text": "$handle$さんは"},
        { "location": "146/TALK", "narrator": "つばめ", "text": "とっても素敵な人だから(´艸`*"},
        { "location": "148/ACT" , "narrator": "", "text": "一番喜ぶのはもちろん…"},
        { "location": "151/TALK", "narrator": "つばめ", "text": "わたしだよヽ(･ω･ )ゝ☆"},
        { "location": "152/TALK", "narrator": "つばめ", "text": "$handle$さんの隣は"},
        { "location": "153/TALK", "narrator": "つばめ", "text": "絶対に譲れなぃかも"},
        { "location": "154/TALK", "narrator": "つばめ", "text": "ぇへへ(≧艸≦*)"},
        { "location": "156/TALK", "narrator": "つばめ", "text": "それじゃ"},
        { "location": "158/TALK", "narrator": "つばめ", "text": "パーティーに戻るよ"},
        { "location": "159/TALK", "narrator": "つばめ", "text": "部屋に帰ったら"},
        { "location": "160/TALK", "narrator": "つばめ", "text": "また"},
        { "location": "163/TALK", "narrator": "透明つばめ", "text": "…えへへ。"},
        { "location": "164/TALK", "narrator": "銀葉樹", "text": "つばめ、嬉しそう。\n誰と話してたの？"},
        { "location": "165/TALK", "narrator": "透明つばめ", "text": "うん…わたしのね、\nとっても大切な人だよ。"},
        { "location": "167/TALK", "narrator": "銀葉樹", "text": "えっ！？"},
        { "location": "168/TALK", "narrator": "透明つばめ", "text": "あはは、そのうち\n紹介するよ。"},
        { "location": "169/TALK", "narrator": "透明つばめ", "text": "きっと、銀ちゃんも\nスゴく好きになって\nくれると思うし。"},
        { "location": "170/TALK", "narrator": "銀葉樹", "text": "…ほんとう？"},
        { "location": "171/TALK", "narrator": "透明つばめ", "text": "うん、実はちょっとだけ\nそんな話してたんだ。"},
        { "location": "173/TALK", "narrator": "銀葉樹", "text": "…大丈夫かな？\nちょっと不安なの。"},
        { "location": "174/TALK", "narrator": "透明つばめ", "text": "もぉ、ダメだよ。\nそんなくらい顔してたら、\nカワイイ顔が台無しだよ。"},
        { "location": "175/TALK", "narrator": "銀葉樹", "text": "…うん。"},
        { "location": "176/TALK", "narrator": "透明つばめ", "text": "あはは、そうそう。\nやっぱり銀ちゃんは\nとっても可愛いよー。"},
        { "location": "177/TALK", "narrator": "銀葉樹", "text": "そ、そんなことないの。\nつばめの方が…。"},
        { "location": "178/TALK", "narrator": "透明つばめ", "text": "ううん、銀ちゃんの方が\n絶対可愛いよ。"},
        { "location": "179/TALK", "narrator": "透明つばめ", "text": "サンタ帽も、\nとっても似合ってるし。"},
        { "location": "181/TALK", "narrator": "銀葉樹", "text": "…………。"},
        { "location": "182/TALK", "narrator": "透明つばめ", "text": "うん、ほんとう可愛い！"},
        { "location": "183/TALK", "narrator": "銀葉樹", "text": "…ありがと。"},
        { "location": "185/TALK", "narrator": "透明つばめ", "text": "えへへ…。"}
    ]
}
