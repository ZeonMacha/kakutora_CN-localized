    "entry":
    [
        { "location": "556/SCENARIO", "narrator": "", "text": "現実はかくあるべし"},
        { "location": "572/TALK"    , "narrator": "神楽", "text": "あそこ新しいお店\nできたんですね。"},
        { "location": "573/TALK"    , "narrator": "つばめ", "text": "本当だね。開店は\n来週だって。"},
        { "location": "574/TALK"    , "narrator": "神楽", "text": "開店したら一緒に\n行ってみませんか？"},
        { "location": "575/TALK"    , "narrator": "つばめ", "text": "うんうん！\n絶対行こうね！"},
        { "location": "576/TALK"    , "narrator": "つばめ", "text": "…そういえば。\nこの前卯月さん\n言ってたよね。"},
        { "location": "578/TALK"    , "narrator": "つばめ", "text": "この坂には卯月さんの\nパワーが満ちてるって。"},
        { "location": "579/SEL"     , "narrator": "", "text": "まだ覚えてるみたいだよ？"},
        { "location": "580/ACT"     , "narrator": "", "text": "まだ覚えてるみたいだよ？"},
        { "location": "598/TALK"    , "narrator": "神楽", "text": "忘れててくれればよかったんですけど、、、"},
        { "location": "600/SEL"     , "narrator": "", "text": "せっかくだから嘘をつきとおそう"},
        { "location": "601/SEL"     , "narrator": "", "text": "頭がいいんだか悪いんだか"},
        { "location": "602/SEL"     , "narrator": "", "text": "素直すぎない？"},
        { "location": "603/ACT"     , "narrator": "", "text": "せっかくだから嘘をつきとおそう"},
        { "location": "604/TALK"    , "narrator": "神楽", "text": "その手もありますけど"},
        { "location": "605/TALK"    , "narrator": "神楽", "text": "この先が面倒くさいですね、、、"},
        { "location": "606/ACT"     , "narrator": "", "text": "頭がいいんだか悪いんだか"},
        { "location": "607/TALK"    , "narrator": "神楽", "text": "覚えてたからいいってことですか？"},
        { "location": "608/TALK"    , "narrator": "神楽", "text": "うーん、、、"},
        { "location": "609/ACT"     , "narrator": "", "text": "素直すぎない？"},
        { "location": "610/TALK"    , "narrator": "神楽", "text": "そうなんですよねー"},
        { "location": "612/TALK"    , "narrator": "神楽", "text": "ここまでだとは思いませんでした、、、"},
        { "location": "625/TALK"    , "narrator": "神楽", "text": "…つばめさん。\nその話は…。"},
        { "location": "627/TALK"    , "narrator": "つばめ", "text": "え？\nあ、もしかして！"},
        { "location": "628/TALK"    , "narrator": "つばめ", "text": "秘密にしなきゃ\nいけないことだった？"},
        { "location": "629/TALK"    , "narrator": "神楽", "text": "…ええと。\nそうじゃなくて。"},
        { "location": "630/TALK"    , "narrator": "神楽", "text": "そんなパワーは\n実在しないんです。"},
        { "location": "632/TALK"    , "narrator": "つばめ", "text": "え？"},
        { "location": "633/SEL"     , "narrator": "", "text": "そうだったの！？"},
        { "location": "634/ACT"     , "narrator": "", "text": "そうだったの！？"},
        { "location": "651/TALK"    , "narrator": "神楽", "text": "知ってましたよね、、、"},
        { "location": "653/SEL"     , "narrator": "", "text": "ばれてた？"},
        { "location": "654/SEL"     , "narrator": "", "text": "ここはこう言うべきかなって"},
        { "location": "655/SEL"     , "narrator": "", "text": "いや初耳"},
        { "location": "656/ACT"     , "narrator": "", "text": "ばれてた？"},
        { "location": "657/TALK"    , "narrator": "神楽", "text": "バレるわｳﾞｫｹ"},
        { "location": "658/ACT"     , "narrator": "", "text": "ここはこう言うべきかなって"},
        { "location": "659/TALK"    , "narrator": "神楽", "text": "そんなわけﾈｰﾖ"},
        { "location": "660/ACT"     , "narrator": "", "text": "いや初耳"},
        { "location": "661/TALK"    , "narrator": "神楽", "text": "嘘つくな頃す"},
        { "location": "673/SEL"     , "narrator": "", "text": "口調違くない！？"},
        { "location": "674/SEL"     , "narrator": "", "text": "本性ｷﾀｰ！！！"},
        { "location": "675/SEL"     , "narrator": "", "text": "神楽怒ったの？"},
        { "location": "676/ACT"     , "narrator": "", "text": "口調違くない！？"},
        { "location": "677/ACT"     , "narrator": "", "text": "本性ｷﾀｰ！！！"},
        { "location": "678/ACT"     , "narrator": "", "text": "神楽怒ったの？"},
        { "location": "683/TALK"    , "narrator": "神楽", "text": "そういうことなので…。"},
        { "location": "685/TALK"    , "narrator": "つばめ", "text": "そ、そうなんだ。"},
        { "location": "686/TALK"    , "narrator": "神楽", "text": "ごめんなさい。\n嘘をつくつもりは\nなくて。"},
        { "location": "688/TALK"    , "narrator": "神楽", "text": "冗談で言った\nつもりだったんです。"},
        { "location": "689/TALK"    , "narrator": "つばめ", "text": "あ、ううん。\n気にしないで。"},
        { "location": "690/TALK"    , "narrator": "つばめ", "text": "そっか……。\n冗談だったんだ…。"},
        { "location": "691/TALK"    , "narrator": "神楽", "text": "新しいお店に\n一緒に行きましょうは\n本当ですからね？"},
        { "location": "693/TALK"    , "narrator": "つばめ", "text": "うん！\n絶対だよ！"},
        { "location": "694/TALK"    , "narrator": "神楽", "text": "やれやれ……。"},
