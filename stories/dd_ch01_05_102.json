{
    "dir": "chap05/daydra/dd_ch01_05_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "5105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "社会生活不適応少女＜後編＞"
    },
    "entry":
    [
        { "location": "267/SCENARIO", "narrator": "", "text": "社会生活不適応少女"},
        { "location": "285/TALK"    , "narrator": "つばめ", "text": "…………？"},
        { "location": "286/TALK"    , "narrator": "つばめ", "text": "よかった…。\nちょっと、\n落ち着いたかも…。"},
        { "location": "287/SEL"     , "narrator": "", "text": "ほら、答えないと"},
        { "location": "288/ACT"     , "narrator": "", "text": "ほら、答えないと"},
        { "location": "293/TALK"    , "narrator": "つばめ", "text": "あっ…。"},
        { "location": "296/TALK"    , "narrator": "雛", "text": "あ、いいよいいよー。\nスマホ出て。"},
        { "location": "297/TALK"    , "narrator": "雛", "text": "特別攻撃隊の\n秘密命令かも\nしれないしねー。"},
        { "location": "299/TALK"    , "narrator": "繭", "text": "…まだ、本人かどうか\nわからないんだけど？"},
        { "location": "301/TALK"    , "narrator": "雛", "text": "絶対そうだって！\n間違いないよ。"},
        { "location": "303/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "319/TALK"    , "narrator": "つばめ", "text": "わかってるけど"},
        { "location": "320/TALK"    , "narrator": "つばめ", "text": "ちゃんと言えるかな？(´･ω･｀) "},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "失敗して"},
        { "location": "322/TALK"    , "narrator": "つばめ", "text": "変な子に思われちゃうかも(´つω・｀)ｼｭﾝ"},
        { "location": "324/SEL"     , "narrator": "", "text": "前の学校で友達作ってたじゃん"},
        { "location": "325/SEL"     , "narrator": "", "text": "失敗したときのつばめとは違う"},
        { "location": "326/SEL"     , "narrator": "", "text": "とにかく、当たってみなくちゃアタリかハズレかわからない"},
        { "location": "327/ACT"     , "narrator": "", "text": "前の学校で友達作ってたじゃん"},
        { "location": "328/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "329/TALK"    , "narrator": "つばめ", "text": "あの時は"},
        { "location": "331/TALK"    , "narrator": "つばめ", "text": "席が近かったから"},
        { "location": "332/TALK"    , "narrator": "つばめ", "text": "仲良くなれたんだし(o´Д`)=з"},
        { "location": "334/SEL"     , "narrator": "", "text": "今回は、声をかけられたのがきっかけ"},
        { "location": "335/ACT"     , "narrator": "", "text": "今回は、声をかけられたのがきっかけ"},
        { "location": "337/TALK"    , "narrator": "つばめ", "text": "そっか"},
        { "location": "338/TALK"    , "narrator": "つばめ", "text": "せっかくのきっかけだもん"},
        { "location": "339/TALK"    , "narrator": "つばめ", "text": "無駄にしたら"},
        { "location": "340/TALK"    , "narrator": "つばめ", "text": "勿体ないよねo(*･ﾛ･*)o、"},
        { "location": "341/TALK"    , "narrator": "つばめ", "text": "ありがと"},
        { "location": "342/TALK"    , "narrator": "つばめ", "text": "頑張ってみる！(๑･ㅂ･)و☆"},
        { "location": "354/TALK"    , "narrator": "つばめ", "text": "…せっかく、声かけて\nくれたんだもん。"},
        { "location": "355/TALK"    , "narrator": "つばめ", "text": "わたしも、\n頑張らないと…。"},
        { "location": "358/TALK"    , "narrator": "つばめ", "text": "…あの、\nお待たせしました。"},
        { "location": "359/TALK"    , "narrator": "つばめ", "text": "わたし、今日から\n特別攻撃隊特科に\n転入になった――"},
        { "location": "360/TALK"    , "narrator": "つばめ", "text": "逢瀬つばめです。"},
        { "location": "362/TALK"    , "narrator": "雛", "text": "つばめちゃんって\nいうんだ？"},
        { "location": "363/ACT"     , "narrator": "", "text": "失敗したときのつばめとは違う"},
        { "location": "364/TALK"    , "narrator": "つばめ", "text": "えっ！"},
        { "location": "365/TALK"    , "narrator": "つばめ", "text": "何で知ってるの！？(ﾟ△ﾟ;ﾉ)ﾉ"},
        { "location": "366/TALK"    , "narrator": "つばめ", "text": "っていうか"},
        { "location": "367/TALK"    , "narrator": "つばめ", "text": "何が違うかわからないよ…(o´Д`)=з"},
        { "location": "369/SEL"     , "narrator": "", "text": "$me$がいる"},
        { "location": "370/ACT"     , "narrator": "", "text": "$me$がいる"},
        { "location": "372/TALK"    , "narrator": "つばめ", "text": "ありがと(*´ω｀*)"},
        { "location": "373/TALK"    , "narrator": "つばめ", "text": "凄く心強い味方だね(*≧∀≦*) "},
        { "location": "374/TALK"    , "narrator": "つばめ", "text": "もう"},
        { "location": "375/TALK"    , "narrator": "つばめ", "text": "平気だよ"},
        { "location": "387/TALK"    , "narrator": "つばめ", "text": "…すみません。\nお待たせしました。"},
        { "location": "388/TALK"    , "narrator": "つばめ", "text": "わたし、今日から\n特別攻撃隊特科に\n転入になった――"},
        { "location": "389/TALK"    , "narrator": "つばめ", "text": "逢瀬つばめです。"},
        { "location": "391/TALK"    , "narrator": "雛", "text": "つばめちゃんって\nいうんだ？"},
        { "location": "392/ACT"     , "narrator": "", "text": "とにかく、当たってみなくちゃアタリかハズレかわからない"},
        { "location": "394/TALK"    , "narrator": "つばめ", "text": "当たってみなきゃって"},
        { "location": "395/TALK"    , "narrator": "つばめ", "text": "それ"},
        { "location": "396/TALK"    , "narrator": "つばめ", "text": "ちょっと怖いかも(o´Д`)=з"},
        { "location": "398/SEL"     , "narrator": "", "text": "つばめ、気合いだ！！"},
        { "location": "399/ACT"     , "narrator": "", "text": "つばめ、気合いだ！！"},
        { "location": "401/TALK"    , "narrator": "つばめ", "text": "はい！！"},
        { "location": "412/TALK"    , "narrator": "つばめ", "text": "って、どうしよう！\n勢いでチャット\n閉じちゃった…。"},
        { "location": "413/TALK"    , "narrator": "雛", "text": "…………。"},
        { "location": "414/TALK"    , "narrator": "繭", "text": "…………ハァ。"},
        { "location": "415/TALK"    , "narrator": "つばめ", "text": "…よ、よーし。\n気合い、気合いっ！！"},
        { "location": "416/TALK"    , "narrator": "つばめ", "text": "あ、あの！！"},
        { "location": "417/TALK"    , "narrator": "つばめ", "text": "わたし、特別攻撃隊\n特科に転入します、\n逢瀬つばめです！！"},
        { "location": "418/TALK"    , "narrator": "つばめ", "text": "よろしく\nお願いします！！"},
        { "location": "420/TALK"    , "narrator": "雛", "text": "あ、う、うん。\nつばめちゃんね。"},
        { "location": "422/TALK"    , "narrator": "つばめ", "text": "はい！\n逢瀬つばめです！！"},
        { "location": "423/TALK"    , "narrator": "雛", "text": "大きな声だねー。\nちょっとビックリ\nしちゃったよ。"},
        { "location": "426/TALK"    , "narrator": "つばめ", "text": "や、やっちゃったー！"},
        { "location": "429/TALK"    , "narrator": "つばめ", "text": "す、すみません！\n驚かせたかった\nわけじゃなくて…。"},
        { "location": "431/TALK"    , "narrator": "雛", "text": "あはは、謝らないで\nいいよー。"},
        { "location": "432/TALK"    , "narrator": "雛", "text": "まあ、それは\nともかく――"},
        { "location": "434/TALK"    , "narrator": "雛", "text": "あたし、日向雛。"},
        { "location": "435/TALK"    , "narrator": "雛", "text": "システム科の電気電算\nシステム専攻に在籍して\nるの。"},
        { "location": "437/TALK"    , "narrator": "雛", "text": "それでこっちが――"},
        { "location": "439/TALK"    , "narrator": "繭", "text": "光月繭。\nシステム科情報解析専攻。"},
        { "location": "440/TALK"    , "narrator": "雛", "text": "あたし達、\n学科は違うけど――"},
        { "location": "441/TALK"    , "narrator": "雛", "text": "普通授業はほとんど\n一緒に受けることに\nなるから――"},
        { "location": "442/TALK"    , "narrator": "雛", "text": "これからよろしくね。"},
        { "location": "443/TALK"    , "narrator": "つばめ", "text": "あ、はい…。"},
        { "location": "444/TALK"    , "narrator": "つばめ", "text": "って、ほとんど一緒って\nことは、同じクラスって\nことですか？"},
        { "location": "445/TALK"    , "narrator": "雛", "text": "ピンポーン！\n今日からクラスメイト\nなんだよー。"},
        { "location": "446/TALK"    , "narrator": "つばめ", "text": "そうなんですか…。"},
        { "location": "449/TALK"    , "narrator": "つばめ", "text": "なんか、凄いいきなりで\n驚いたけど――"},
        { "location": "450/TALK"    , "narrator": "つばめ", "text": "悪い人達じゃなさそう、\nかな？"},
        { "location": "451/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "453/TALK"    , "narrator": "つばめ", "text": "こっちの…光月さんは、\nちょっと怖そうだけど…。"},
        { "location": "454/TALK"    , "narrator": "雛", "text": "あはは、初めての人には\nちょっとまゆちんは\n怖いよねー。"},
        { "location": "455/TALK"    , "narrator": "雛", "text": "けど、平気だよ。\nこれで結構可愛いところ\nある子だから。"},
        { "location": "456/TALK"    , "narrator": "雛", "text": "それに、つばめちゃんに\n声掛けたのも――"},
        { "location": "457/TALK"    , "narrator": "雛", "text": "まゆちんがどうしても\nつばめちゃんと話したい、\nって言ったからだし。"},
        { "location": "460/TALK"    , "narrator": "つばめ", "text": "そうなんですか？"},
        { "location": "461/TALK"    , "narrator": "繭", "text": "言ってない。"},
        { "location": "464/TALK"    , "narrator": "雛", "text": "えぇっ！？\nさっき興味あるって\n言ったじゃん。"},
        { "location": "466/TALK"    , "narrator": "繭", "text": "うるさい黙れ。"},
        { "location": "472/TALK"    , "narrator": "つばめ", "text": "…や、やっぱり、\nちょっと怖いかも。"},
        { "location": "473/TALK"    , "narrator": "つばめ", "text": "もしかして、緊張して\nちゃんと話せてない\nから――"},
        { "location": "475/TALK"    , "narrator": "つばめ", "text": "失礼なやつだ、って\n思われてるとか？"},
        { "location": "477/TALK"    , "narrator": "雛", "text": "ほら、まゆちん。\nまたつばめちゃんが\n怖がってるって。"},
        { "location": "478/TALK"    , "narrator": "雛", "text": "ごめんねー。\nでもまゆちんにとって、\nこれが平常運転だから。"},
        { "location": "480/TALK"    , "narrator": "雛", "text": "っていうか、これでも\nつばめちゃんのこと\n歓迎してるんだよ？"},
        { "location": "484/TALK"    , "narrator": "つばめ", "text": "そうなんですか？"},
        { "location": "487/TALK"    , "narrator": "雛", "text": "そうなんだよ。\nねー？"},
        { "location": "488/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "491/TALK"    , "narrator": "雛", "text": "否定しないイコール肯定！\nこれがまゆちんスタイル！"},
        { "location": "493/TALK"    , "narrator": "繭", "text": "違うから。"},
        { "location": "494/TALK"    , "narrator": "つばめ", "text": "…ふふっ。"},
        { "location": "498/TALK"    , "narrator": "雛", "text": "あはは、やっと笑った。"},
        { "location": "499/TALK"    , "narrator": "雛", "text": "ちょっとは緊張ほぐれた？"},
        { "location": "500/TALK"    , "narrator": "つばめ", "text": "はい。\nありがとうございます。"},
        { "location": "501/TALK"    , "narrator": "雛", "text": "お礼はいいって。\nそれより――"},
        { "location": "503/TALK"    , "narrator": "珠緒先生", "text": "こらー！"},
        { "location": "506/TALK"    , "narrator": "雛", "text": "うわっ、たまちゃん先生？"},
        { "location": "509/TALK"    , "narrator": "珠緒先生", "text": "逢瀬さん！\n急にいなくなったら\nダメでしょ？"},
        { "location": "513/TALK"    , "narrator": "つばめ", "text": "ああっ、そうだった！"},
        { "location": "517/TALK"    , "narrator": "つばめ", "text": "わたし、先生に学校の中を\n案内してもらってる\n途中だったんだ…。"},
        { "location": "521/TALK"    , "narrator": "つばめ", "text": "ごめんなさい。\n急にいなくなって…。"},
        { "location": "522/TALK"    , "narrator": "雛", "text": "違うの、たまちゃん先生。"},
        { "location": "523/TALK"    , "narrator": "雛", "text": "あたしがつばめちゃんに\n挨拶したくて、強引に\n引き留めたの。"},
        { "location": "525/TALK"    , "narrator": "珠緒先生", "text": "朝のホームルームで\nちゃんと言ったでしょ？"},
        { "location": "526/TALK"    , "narrator": "珠緒先生", "text": "午後の授業の前に\n紹介する、って。"},
        { "location": "527/TALK"    , "narrator": "雛", "text": "歩いてるの見えたから、\n早めに挨拶しておこう\nかなぁ、って…。"},
        { "location": "529/TALK"    , "narrator": "珠緒先生", "text": "だからって、人が案内を\nしている途中でするのは\nよくないわ。"},
        { "location": "530/TALK"    , "narrator": "雛", "text": "いや、たまちゃん先生って\n小さいから――"},
        { "location": "531/TALK"    , "narrator": "雛", "text": "つばめちゃんの陰に\n完全に隠れてて…。"},
        { "location": "533/TALK"    , "narrator": "珠緒先生", "text": "そ、そんなに\n小さくないです！"},
        { "location": "534/TALK"    , "narrator": "珠緒先生", "text": "それに、たまちゃん先生\nじゃなくて、珠緒先生と\n呼びなさい！"},
        { "location": "535/TALK"    , "narrator": "雛", "text": "ごめんなさい、珠緒先生。\n小柄で可愛いです。"},
        { "location": "536/TALK"    , "narrator": "珠緒先生", "text": "そこは言いなおさなくて\nいいの！"},
        { "location": "538/TALK"    , "narrator": "つばめ", "text": "あ、えっと、その…。"},
        { "location": "540/TALK"    , "narrator": "繭", "text": "…はぁ。"},
        { "location": "543/TALK"    , "narrator": "繭", "text": "珠緒先生。\nもし宜しければ――"},
        { "location": "544/TALK"    , "narrator": "繭", "text": "学校の案内は私達に\n任せていただけませんか？"},
        { "location": "545/TALK"    , "narrator": "珠緒先生", "text": "えっ？"},
        { "location": "546/TALK"    , "narrator": "繭", "text": "転入手続きの書類は、\nもう終わっているん\nですよね？"},
        { "location": "547/TALK"    , "narrator": "珠緒先生", "text": "え、ええ…。"},
        { "location": "548/TALK"    , "narrator": "繭", "text": "でしたら、ここからは\n私達にお任せください。"},
        { "location": "549/TALK"    , "narrator": "繭", "text": "先生も、色々とお忙しいと\n思いますし。"},
        { "location": "550/TALK"    , "narrator": "珠緒先生", "text": "さすがは光月さん。\n学級委員なだけのこと\nあるわね。"},
        { "location": "552/TALK"    , "narrator": "雛", "text": "ふふん。"},
        { "location": "554/TALK"    , "narrator": "つばめ", "text": "…な、何で日向さんが\n自慢気なんだろう？"},
        { "location": "556/TALK"    , "narrator": "珠緒先生", "text": "逢瀬さんも、\nそれで構わない？"},
        { "location": "559/TALK"    , "narrator": "つばめ", "text": "は、はい。\nわたしは構いません。"},
        { "location": "561/TALK"    , "narrator": "珠緒先生", "text": "じゃあ、決まりね。\n光月さん、あとは\nよろしくね。"},
        { "location": "562/TALK"    , "narrator": "繭", "text": "わかりました。"},
        { "location": "566/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "569/TALK"    , "narrator": "つばめ", "text": "あ、あの…光月さん。\nありがとうございます。"},
        { "location": "572/TALK"    , "narrator": "繭", "text": "大丈夫。\n単なる点数稼ぎだから。"},
        { "location": "573/TALK"    , "narrator": "繭", "text": "…案内するから、\n付いてきて。"},
        { "location": "577/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "579/TALK"    , "narrator": "雛", "text": "大丈夫だよ、\nつばめちゃん。"},
        { "location": "580/TALK"    , "narrator": "雛", "text": "まゆちん、口と愛想は\n悪いけど、結構優しい子\nだからねー。"},
        { "location": "581/TALK"    , "narrator": "繭", "text": "早く。\n昼休み終わっちゃうから。"},
        { "location": "582/TALK"    , "narrator": "雛", "text": "ね？　ああ見えても、\n結構つばめちゃんのこと\n気に入ってるんだよ。"},
        { "location": "583/TALK"    , "narrator": "雛", "text": "だから大丈夫。\nほら、行こう！"},
        { "location": "585/TALK"    , "narrator": "つばめ", "text": "…はい、日向さん。"},
        { "location": "587/TALK"    , "narrator": "雛", "text": "っと、そうだそうだ。\nその前にー。"},
        { "location": "588/TALK"    , "narrator": "雛", "text": "つばめちゃん！\n敬語とさん付けは、\n今後一切禁止！！"},
        { "location": "590/TALK"    , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "591/TALK"    , "narrator": "雛", "text": "だってクラスメイトだよ？\n友達だよ？"},
        { "location": "592/TALK"    , "narrator": "雛", "text": "そんな他人行儀じゃ\n楽しくないじゃん。"},
        { "location": "593/TALK"    , "narrator": "雛", "text": "だから、あたしのことは\nひなこ、って呼んでねー。"},
        { "location": "594/TALK"    , "narrator": "つばめ", "text": "…いいんですか？"},
        { "location": "595/TALK"    , "narrator": "雛", "text": "敬語とさん付けは\n良くないんです。"},
        { "location": "596/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "598/TALK"    , "narrator": "つばめ", "text": "うん…わかったよ。\nひ、ひなこ…ちゃん。"},
        { "location": "599/TALK"    , "narrator": "雛", "text": "…………。"},
        { "location": "600/TALK"    , "narrator": "雛", "text": "うん、うんうん！！\nそれでオッケー！！"},
        { "location": "601/TALK"    , "narrator": "雛", "text": "ついでにまゆちんも、\nまゆちんで良いから。"},
        { "location": "602/TALK"    , "narrator": "つばめ", "text": "か、勝手に良いの？"},
        { "location": "605/TALK"    , "narrator": "雛", "text": "ねー、まゆちーん！\nそれでいいでしょー？"},
        { "location": "606/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "608/TALK"    , "narrator": "つばめ", "text": "無言ってことは…。"},
        { "location": "610/TALK"    , "narrator": "つばめ", "text": "…ま、まゆちん！\nよろしくね。"},
        { "location": "611/TALK"    , "narrator": "繭", "text": "…ええ。"},
        { "location": "612/TALK"    , "narrator": "雛", "text": "ふふっ"},
        { "location": "615/TALK"    , "narrator": "雛", "text": "それじゃ、時間ないし急ご！"},
        { "location": "616/TALK"    , "narrator": "つばめ", "text": "うん。"},
        { "location": "619/TALK"    , "narrator": "つばめ", "text": "明るくて元気な\nひなこちゃんと――"},
        { "location": "620/TALK"    , "narrator": "つばめ", "text": "ちょっと怖いけど、\n優しいまゆちん。"},
        { "location": "621/TALK"    , "narrator": "つばめ", "text": "こんなにいい友達が\n出来るなんて、\n凄く嬉しい！"},
        { "location": "632/DIALOG"  , "narrator": "Dialog_chapter_ch01", "text": "【03 赤い髪の転校生】"}
    ]
}
