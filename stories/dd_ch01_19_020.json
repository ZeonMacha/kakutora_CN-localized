{
    "dir": "chap19/daydra/dd_ch01_19_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "19156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "家族からのメール"
    },
    "entry":
    [
        { "location": "468/SCENARIO", "narrator": "", "text": "家族からのメール"},
        { "location": "500/TALK"    , "narrator": "つばめ", "text": "…あっ。"},
        { "location": "505/TALK"    , "narrator": "キリト", "text": "なんだ、ＷＡＶＥか？"},
        { "location": "507/TALK"    , "narrator": "つばめ", "text": "うん、お父さんから。"},
        { "location": "509/TALK"    , "narrator": "雛", "text": "何て書いてあるの？"},
        { "location": "511/TALK"    , "narrator": "つばめ", "text": "えっと…、\n合宿とはいえ、自由時間に\n気を緩め過ぎていないか？"},
        { "location": "512/TALK"    , "narrator": "つばめ", "text": "お友達のご家族に\n迷惑をかけていないか？"},
        { "location": "513/TALK"    , "narrator": "つばめ", "text": "夜遊びはしていないか？"},
        { "location": "516/TALK"    , "narrator": "つばめ", "text": "…そんな感じかな。"},
        { "location": "518/TALK"    , "narrator": "ヒカル", "text": "良いお父さんじゃない\nですか。"},
        { "location": "524/TALK"    , "narrator": "つばめ", "text": "うーん…ちょっと心配性\nだけどね…。"},
        { "location": "526/TALK"    , "narrator": "つばめ", "text": "そういえば、みんなも\n家の人から連絡来てるの？"},
        { "location": "527/TALK"    , "narrator": "雛", "text": "うん、一応ねー。"},
        { "location": "529/TALK"    , "narrator": "キリト", "text": "俺のとこも来るけど…\n逢瀬、おまえの親父さんは\n一日何通送ってくる？"},
        { "location": "530/TALK"    , "narrator": "つばめ", "text": "え？　一回だけど…。"},
        { "location": "531/TALK"    , "narrator": "キリト", "text": "だったら、うちの親の方が\n心配性だな。"},
        { "location": "533/TALK"    , "narrator": "雛", "text": "朝と夜に一回ずつ\n来るもんねー。"},
        { "location": "534/TALK"    , "narrator": "つばめ", "text": "えっ、二回も？"},
        { "location": "536/TALK"    , "narrator": "雛", "text": "意外かもしれないけど、\nキリトの両親って\n超心配性なんだよ？"},
        { "location": "540/TALK"    , "narrator": "キリト", "text": "ああ…普段だって、\n放課後にＷＡＶＥが\n送られてくるんだぜ？"},
        { "location": "541/TALK"    , "narrator": "キリト", "text": "今日は何時頃帰るんだ、\nとか、夕飯何が食べたい、\nとか、色々な。"},
        { "location": "544/TALK"    , "narrator": "ヒカル", "text": "そうだったんですか！？\nそれは知りませんでした。"},
        { "location": "547/TALK"    , "narrator": "キリト", "text": "まあ、大抵スタンプで\n返信するだけなんだけ\nどな。"},
        { "location": "549/TALK"    , "narrator": "つばめ", "text": "ちゃんと返信するんだ？\nわたし、面倒臭くて、\n無視することあるのに…。"},
        { "location": "553/TALK"    , "narrator": "キリト", "text": "…まあ、正直俺もさ、\n超ウゼェ、って思うことは\nあるさ。"},
        { "location": "554/TALK"    , "narrator": "キリト", "text": "けど、人一倍心配性の\nクセに、俺のやりたいこと\n全部応援してくれるし――"},
        { "location": "555/TALK"    , "narrator": "キリト", "text": "養成科入る時だって、\n一言も文句言わなかった\n親だからさ。"},
        { "location": "556/TALK"    , "narrator": "キリト", "text": "なんか、こう、無視したら\nいけねぇなぁ、って気に\nなっちまうんだよ…。"},
        { "location": "558/TALK"    , "narrator": "つばめ", "text": "…そうなんだ。"},
        { "location": "560/TALK"    , "narrator": "つばめ", "text": "キリトくん、家族のことが\n大好きなんだね。"},
        { "location": "563/TALK"    , "narrator": "キリト", "text": "ばっ！？\nそういうんじゃねぇって！"},
        { "location": "565/TALK"    , "narrator": "雛", "text": "キリトは家族に対しては\nツンデレだからねー。"},
        { "location": "566/TALK"    , "narrator": "ヒカル", "text": "あはは、照れること\nないと思いますよ？"},
        { "location": "567/TALK"    , "narrator": "キリト", "text": "照れてねぇよ！"},
        { "location": "569/TALK"    , "narrator": "キリト", "text": "ってか、そうだ！\n逢瀬はヒカルのＷＡＶＥ、\n見たことあるか？"},
        { "location": "570/TALK"    , "narrator": "つばめ", "text": "え？　ないけど…。"},
        { "location": "572/TALK"    , "narrator": "キリト", "text": "こいつの凄いんだよ。\nほら、見せてやれよ。"},
        { "location": "573/TALK"    , "narrator": "つばめ", "text": "え、見ていいの？"},
        { "location": "576/TALK"    , "narrator": "ヒカル", "text": "ええ、構いませんよ。\nどうぞ。"},
        { "location": "580/TALK"    , "narrator": "つばめ", "text": "…あ、あれ？\n何で、全部英語なの？"},
        { "location": "584/TALK"    , "narrator": "キリト", "text": "そうなんだよ。\nこいつ、家族とは英語で\nやりとりしてんだよ。"},
        { "location": "586/TALK"    , "narrator": "つばめ", "text": "えぇっ、そうなの！？"},
        { "location": "588/TALK"    , "narrator": "ヒカル", "text": "逢瀬さんには言ってません\nでしたっけ？"},
        { "location": "589/TALK"    , "narrator": "ヒカル", "text": "うちは父と姉が\n英国人なんです。"},
        { "location": "590/TALK"    , "narrator": "ヒカル", "text": "なので、日常会話は\n日本語で、ＷＡＶＥとか\nメモなどの――"},
        { "location": "591/TALK"    , "narrator": "ヒカル", "text": "文字でやり取りをする\n場合には、英語を使う\n約束になっているんです。"},
        { "location": "593/TALK"    , "narrator": "つばめ", "text": "それって、ヒカルくんが\n英語ができるように\nなるために、かな？"},
        { "location": "597/TALK"    , "narrator": "ヒカル", "text": "だと思います。"},
        { "location": "600/TALK"    , "narrator": "キリト", "text": "ズルいよな？\nそんなことやってりゃ、\n英語の成績いいわけだぜ。"},
        { "location": "601/TALK"    , "narrator": "雛", "text": "ヒカルくんは英語以外の\n成績もいいけどねー。"},
        { "location": "602/SEL"     , "narrator": "", "text": "つばめも真似すれば？"},
        { "location": "603/SEL"     , "narrator": "", "text": "どんなお姉さんなんだろ？"},
        { "location": "604/SEL"     , "narrator": "", "text": "雛の親はどんな人？"},
        { "location": "606/TALK"    , "narrator": "つばめ", "text": "かっこいいなぁ…。"},
        { "location": "607/TALK"    , "narrator": "つばめ", "text": "会話は日本語だけど、\n文字でのやり取りは\n英語かぁ…。"},
        { "location": "612/ACT"     , "narrator": "", "text": "つばめも真似すれば？"},
        { "location": "632/TALK"    , "narrator": "つばめ", "text": "うん"},
        { "location": "633/TALK"    , "narrator": "つばめ", "text": "そうしてみようかな、って思ってたんだ"},
        { "location": "648/TALK"    , "narrator": "つばめ", "text": "…わたしも、真似して\nみようかな？"},
        { "location": "650/TALK"    , "narrator": "雛", "text": "真似って…お父さんに\n英語で返信するの？"},
        { "location": "652/TALK"    , "narrator": "つばめ", "text": "うん。\n丁度返信しようと思ってた\nところだったし。"},
        { "location": "657/TALK"    , "narrator": "つばめ", "text": "えっとぉ…スペルは確か、\nこうだったかな？"},
        { "location": "658/TALK"    , "narrator": "つばめ", "text": "うん、送信！"},
        { "location": "660/TALK"    , "narrator": "ヒカル", "text": "なんて書いたのか、\n聞いてもいいですか？"},
        { "location": "663/TALK"    , "narrator": "つばめ", "text": "「no problem」だよ。"},
        { "location": "666/TALK"    , "narrator": "キリト", "text": "おっ！？\n何かかっこいいな！"},
        { "location": "669/TALK"    , "narrator": "雛", "text": "いやいや、どこの洋画の\n主役だよ！？"},
        { "location": "671/TALK"    , "narrator": "つばめ", "text": "でも、お父さんって\n英語できるのかな？"},
        { "location": "673/TALK"    , "narrator": "雛", "text": "いやー、あれくらいなら\n読めなきゃマズい気が\nするけど…。"},
        { "location": "679/TALK"    , "narrator": "つばめ", "text": "…あっ、お父さんから\n返信が――"},
        { "location": "680/TALK"    , "narrator": "つばめ", "text": "…あ、あれ？"},
        { "location": "681/TALK"    , "narrator": "キリト", "text": "もしかして、\n怒らせちまったのか？"},
        { "location": "684/TALK"    , "narrator": "つばめ", "text": "え、えっと…。"},
        { "location": "687/TALK"    , "narrator": "つばめ", "text": "ヒカルくん、このメール\n翻訳してもらえる？"},
        { "location": "688/TALK"    , "narrator": "ヒカル", "text": "え…うわっ！\n全文英語じゃないですか。"},
        { "location": "689/TALK"    , "narrator": "雛", "text": "そっかぁ…\nあのメールに対して\nこう返してくるかぁ…。"},
        { "location": "690/TALK"    , "narrator": "雛", "text": "つばめちゃんのお父さん、\nノリがいいね！"},
        { "location": "691/TALK"    , "narrator": "つばめ", "text": "全然そういうタイプの\n人じゃないんだけど…。"},
        { "location": "693/TALK"    , "narrator": "ヒカル", "text": "えっと、色々書いて\nありましたが、\n要約すると――"},
        { "location": "694/TALK"    , "narrator": "ヒカル", "text": "ちゃんとした文章に\nして送ってきなさい、\nとのことです。"},
        { "location": "695/TALK"    , "narrator": "キリト", "text": "親父さんの方が\n上手だったみたいだな。"},
        { "location": "699/TALK"    , "narrator": "つばめ", "text": "…何かわたし、メールや\nＷＡＶＥで怒られるの、\n結構多い気がするよ…。"},
        { "location": "700/TALK"    , "narrator": "つばめ", "text": "っていうか、お父さんが\nこんなに英語できるなんて\n知らなかったなぁ…。"},
        { "location": "701/ACT"     , "narrator": "", "text": "どんなお姉さんなんだろ？"},
        { "location": "723/TALK"    , "narrator": "つばめ", "text": "うん、わたしも気になるから聞いてみるね"},
        { "location": "736/TALK"    , "narrator": "つばめ", "text": "そういえば、ヒカルくんの\nお姉さんって、どんな人\nなの？"},
        { "location": "738/TALK"    , "narrator": "ヒカル", "text": "姉ですか？"},
        { "location": "741/TALK"    , "narrator": "キリト", "text": "そういや、俺達もまだ\n詳しく聞いたこと\nなかったな。"},
        { "location": "742/TALK"    , "narrator": "雛", "text": "確か、年が離れてる、\nっていうのは前に\n聞いたかも？"},
        { "location": "744/TALK"    , "narrator": "ヒカル", "text": "はい、姉と僕は母親が\n違いまして――"},
        { "location": "745/TALK"    , "narrator": "ヒカル", "text": "言ってしまえば、\n姉は英国人の父の\n連れ子なんです。"},
        { "location": "748/TALK"    , "narrator": "つばめ", "text": "あっ、そっか。"},
        { "location": "749/TALK"    , "narrator": "つばめ", "text": "お父さんとお姉さんは\n英国人、ってさっき\n言ってたよね？"},
        { "location": "751/TALK"    , "narrator": "ヒカル", "text": "はい、そういうことです。"},
        { "location": "752/TALK"    , "narrator": "キリト", "text": "おまえの姉ちゃん、\n何やってる人なんだ？"},
        { "location": "753/TALK"    , "narrator": "ヒカル", "text": "海外企業でコンサルタント\nとして働いているようなの\nですが――"},
        { "location": "754/TALK"    , "narrator": "ヒカル", "text": "僕も、詳しいことは\nよくわからないんです。"},
        { "location": "756/TALK"    , "narrator": "つばめ", "text": "どうして？"},
        { "location": "757/TALK"    , "narrator": "ヒカル", "text": "…姉が家を出てからと\nいうもの、全然連絡を\nしてこないからです。"},
        { "location": "758/TALK"    , "narrator": "キリト", "text": "そりゃ、海外企業で\nコンサルタントなんて\nやってりゃ――"},
        { "location": "761/TALK"    , "narrator": "キリト", "text": "忙しくて連絡する\n暇が無いんじゃねぇか？"},
        { "location": "762/TALK"    , "narrator": "ヒカル", "text": "…かもしれません。"},
        { "location": "763/TALK"    , "narrator": "雛", "text": "ちょっと寂しいね。"},
        { "location": "764/TALK"    , "narrator": "ヒカル", "text": "…はい。"},
        { "location": "766/TALK"    , "narrator": "ヒカル", "text": "…連絡の一つくらい、\nくれてもいいのに…。"},
        { "location": "769/TALK"    , "narrator": "つばめ", "text": "…ヒカルくん、\nちょっと怒ってるみたい。"},
        { "location": "770/TALK"    , "narrator": "つばめ", "text": "それだけ心配してる、\nってことかな？"},
        { "location": "771/ACT"     , "narrator": "", "text": "雛の親はどんな人？"},
        { "location": "793/TALK"    , "narrator": "つばめ", "text": "そういえば、まだ聞いたことなかったっけ？"},
        { "location": "794/TALK"    , "narrator": "つばめ", "text": "いい機会だし、聞いてみようかな"},
        { "location": "807/TALK"    , "narrator": "つばめ", "text": "ひなこちゃんの親って、\nどんな人なの？"},
        { "location": "808/TALK"    , "narrator": "ヒカル", "text": "っ！？"},
        { "location": "811/TALK"    , "narrator": "キリト", "text": "ちょ、逢瀬！\nおまえそれ…！"},
        { "location": "814/TALK"    , "narrator": "つばめ", "text": "？"},
        { "location": "815/TALK"    , "narrator": "雛", "text": "あ、そっかそっか。\nごめん、うっかりしてた！"},
        { "location": "818/TALK"    , "narrator": "雛", "text": "実はさー、ちょーっとだけ\n衝撃の事実！！　みたいに\nなっちゃいそうだけど――"},
        { "location": "819/TALK"    , "narrator": "雛", "text": "うち、両親とも\n死んじゃってるん\nだよねー。"},
        { "location": "821/TALK"    , "narrator": "つばめ", "text": "…えっ？"},
        { "location": "822/TALK"    , "narrator": "雛", "text": "死んじゃってるの。"},
        { "location": "824/TALK"    , "narrator": "つばめ", "text": "…えぇっ！？"},
        { "location": "827/TALK"    , "narrator": "つばめ", "text": "ご、ごめん！\nごめんなさい！"},
        { "location": "828/TALK"    , "narrator": "つばめ", "text": "わたし知らなくて、\nそれでつい――"},
        { "location": "829/TALK"    , "narrator": "雛", "text": "いやいやいや、そんなに\n謝らなくていいって。"},
        { "location": "830/TALK"    , "narrator": "雛", "text": "あたしもついうっかり\nして、つばめちゃんに\n話すの忘れてたよ。"},
        { "location": "834/TALK"    , "narrator": "キリト", "text": "ってか、そんな話する\nタイミングなかっただろ？"},
        { "location": "837/TALK"    , "narrator": "雛", "text": "だよねー。\n本当この手の話って、\nするタイミング難しいし。"},
        { "location": "839/TALK"    , "narrator": "雛", "text": "つまり、話してないん\nだからつばめちゃんが\n知らないのは当然なの。"},
        { "location": "840/TALK"    , "narrator": "雛", "text": "だから謝る必要は\n一切ナッシング！\nオッケー？"},
        { "location": "844/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "848/TALK"    , "narrator": "つばめ", "text": "うん…。"},
        { "location": "850/TALK"    , "narrator": "雛", "text": "うん、わかってもらえて\nよかった。"},
        { "location": "851/TALK"    , "narrator": "雛", "text": "ちなみにだけど、あたしに\nＷＡＶＥ送って来るのは、\nあたしのお兄ちゃんだよ。"},
        { "location": "852/TALK"    , "narrator": "雛", "text": "「美味いもん食ってる？」\n「土産はいらんから」"},
        { "location": "853/TALK"    , "narrator": "雛", "text": "みたいな内容のばっかり\nだけどね。"},
        { "location": "855/TALK"    , "narrator": "ヒカル", "text": "…でも、毎日ちゃんと\n送ってくれるんですね。"},
        { "location": "858/TALK"    , "narrator": "雛", "text": "まあ、仲良し兄弟なんで！"},
        { "location": "861/TALK"    , "narrator": "つばめ", "text": "そっか…。\n良いお兄さんなんだね。"},
        { "location": "864/TALK"    , "narrator": "雛", "text": "うーん…。"},
        { "location": "867/TALK"    , "narrator": "雛", "text": "えへへ…まあねー。"},
        { "location": "870/TALK"    , "narrator": "つばめ", "text": "…ひなこちゃん、\nご両親いないんだ…。"},
        { "location": "871/TALK"    , "narrator": "つばめ", "text": "出会ってから何カ月も\n経つのに――"},
        { "location": "873/TALK"    , "narrator": "つばめ", "text": "まだまだ知らないこと、\n沢山あるんだなぁ…。"},
        { "location": "496/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月19日　 8:43 PM</color>\n合宿中の夜、みやびの実家にて"}
    ]
}
