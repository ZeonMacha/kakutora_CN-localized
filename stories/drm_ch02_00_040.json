        { "location": "7/SCENARIO", "narrator": "", "text": "33_適性な敵性"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "みやびにも兄弟がいたのは"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "少し驚いたわ"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "そんな話"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "聞いたことなかったから"},
        { "location": "39/SEL"    , "narrator": "", "text": "$me$は知ってたよ"},
        { "location": "40/SEL"    , "narrator": "", "text": "聞いてないことはわからないよね"},
        { "location": "41/SEL"    , "narrator": "", "text": "新しい側面を知ったね"},
        { "location": "42/ACT"    , "narrator": "", "text": "$me$は知ってたよ"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "45/SEL"    , "narrator": "", "text": "嘘だけど"},
        { "location": "46/ACT"    , "narrator": "", "text": "嘘だけど"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "もう！"},
        { "location": "49/ACT"    , "narrator": "", "text": "聞いてないことはわからないよね"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "52/SEL"    , "narrator": "", "text": "でも行間も読めないとね"},
        { "location": "53/ACT"    , "narrator": "", "text": "でも行間も読めないとね"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "今回の話は"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "そういうのじゃないと思うけど"},
        { "location": "57/ACT"    , "narrator": "", "text": "新しい側面を知ったね"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "みやびは意外と"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "秘密主義だから"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "こっちも効かれたくないこと"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "聞かれたくないこと"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "あるし"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "ただちょっと驚いただけ"},
        { "location": "68/SEL"    , "narrator": "", "text": "誰にでも秘密はあるよ"},
        { "location": "69/SEL"    , "narrator": "", "text": "おっとなー"},
        { "location": "70/SEL"    , "narrator": "", "text": "抱えてられないことがあるなら話して"},
        { "location": "71/ACT"    , "narrator": "", "text": "誰にでも秘密はあるよ"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "73/ACT"    , "narrator": "", "text": "おっとなー"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "もう"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "からかわないで"},
        { "location": "76/ACT"    , "narrator": "", "text": "抱えてられないことがあるなら話して"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "あ"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "なんかいいわ(*^.^*)"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "頼れる感じが"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "素敵(*￣(ｴ)￣*)ﾎﾟｯ "},
        { "location": "84/SEL"    , "narrator": "", "text": "$me$もちょっと意外だった"},
        { "location": "85/ACT"    , "narrator": "", "text": "$me$もちょっと意外だった"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "意外って？"},
        { "location": "89/SEL"    , "narrator": "", "text": "アーヤに苦手なものがあるのが"},
        { "location": "90/SEL"    , "narrator": "", "text": "アーヤに秘密があるのが"},
        { "location": "91/ACT"    , "narrator": "", "text": "アーヤに苦手なものがあるのが"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "それはあるわよ"},
        { "location": "93/ACT"    , "narrator": "", "text": "アーヤに秘密があるのが"},
        { "location": "97/SEL"    , "narrator": "", "text": "かわいいなって思った"},
        { "location": "98/SEL"    , "narrator": "", "text": "ちょっとうれしかった"},
        { "location": "99/ACT"    , "narrator": "", "text": "かわいいなって思った"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "かわいいとか"},
        { "location": "101/ACT"   , "narrator": "", "text": "ちょっとうれしかった"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "そういう言葉って"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "どうやって憶えてるの"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "言葉自体より"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "使う場所ね"},
        { "location": "110/SEL"   , "narrator": "", "text": "恋愛シミュレーションゲームで"},
        { "location": "111/SEL"   , "narrator": "", "text": "日常生活"},
        { "location": "112/SEL"   , "narrator": "", "text": "なんか本とか"},
        { "location": "113/ACT"   , "narrator": "", "text": "恋愛シミュレーションゲームで"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "ゲーム？"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "ゲームで憶えるの？"},
        { "location": "116/ACT"   , "narrator": "", "text": "日常生活"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "それは"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "毎日学校とか行ってるってことよね"},
        { "location": "119/ACT"   , "narrator": "", "text": "なんか本とか"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "電子書籍のデータ？"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "ってこと？"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "なんだか、、、"},
        { "location": "125/SEL"   , "narrator": "", "text": "どうかした？"},
        { "location": "126/SEL"   , "narrator": "", "text": "もっと聞きたいことがある？"},
        { "location": "127/ACT"   , "narrator": "", "text": "どうかした？"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "ううん"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "別に"},
        { "location": "130/ACT"   , "narrator": "", "text": "もっと聞きたいことがある？"},
        { "location": "131/TALK"  , "narrator": "アーヤ", "text": "えと"},
        { "location": "132/TALK"  , "narrator": "アーヤ", "text": "そういうわけじゃないの"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "今日はいいわ"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "そういえば"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "学習用のファイルっぽいの作ったんだった"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "じゃあね"},
        { "location": "142/TALK"  , "narrator": "ボイスメール", "text": "むかしむかしあるところに"},
        { "location": "154/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【むかしむかしあるところに】</color>\nをゲットしました！"}
    ]
