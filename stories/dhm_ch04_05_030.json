        "title": "Extra010 ヒメゴトチャット",
        "sub_title": "笑わせるか笑われるか、それが問題だ"
    },
    "entry":
    [
        { "location": "239/SCENARIO", "narrator": "", "text": "030_笑わせるか笑われるか、それが問題だ"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "知っておるか相棒"},
        { "location": "265/TALK"    , "narrator": "みやび", "text": "チョコレートは古来、薬だったのだ"},
        { "location": "266/TALK"    , "narrator": "みやび", "text": "現代においてもガブちゃんに処方したことにより"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "その効果が立証されたろう？"},
        { "location": "270/SEL"     , "narrator": "", "text": "$me$、必要なかったね"},
        { "location": "271/SEL"     , "narrator": "", "text": "あれでよかったの？"},
        { "location": "272/SEL"     , "narrator": "", "text": "どうしてチョコだったの？"},
        { "location": "273/ACT"     , "narrator": "", "text": "$me$、必要なかったね"},
        { "location": "283/TALK"    , "narrator": "みやび", "text": "何を言う"},
        { "location": "285/TALK"    , "narrator": "みやび", "text": "$handle$がいなければガブちゃんに話しかけるのはミッション・インポッシブル"},
        { "location": "286/TALK"    , "narrator": "みやび", "text": "なんて"},
        { "location": "287/TALK"    , "narrator": "みやび", "text": "それは言い過ぎだが"},
        { "location": "288/TALK"    , "narrator": "みやび", "text": "心強かったのは事実だ"},
        { "location": "289/TALK"    , "narrator": "みやび", "text": "相棒よ"},
        { "location": "290/ACT"     , "narrator": "", "text": "あれでよかったの？"},
        { "location": "291/TALK"    , "narrator": "みやび", "text": "当然だ"},
        { "location": "292/TALK"    , "narrator": "みやび", "text": "言いたくないことがある人間に無理にしゃべらせるなど"},
        { "location": "293/TALK"    , "narrator": "みやび", "text": "道理に反する"},
        { "location": "294/TALK"    , "narrator": "みやび", "text": "しかしな"},
        { "location": "295/TALK"    , "narrator": "みやび", "text": "側に人がいるというのは心強い"},
        { "location": "296/TALK"    , "narrator": "みやび", "text": "機微を読め"},
        { "location": "297/ACT"     , "narrator": "", "text": "どうしてチョコだったの？"},
        { "location": "298/TALK"    , "narrator": "みやび", "text": "糖度が高い"},
        { "location": "299/TALK"    , "narrator": "みやび", "text": "即ち"},
        { "location": "300/TALK"    , "narrator": "みやび", "text": "元気の素になる"},
        { "location": "301/TALK"    , "narrator": "みやび", "text": "少なくともうちはそうぞね"},
        { "location": "302/TALK"    , "narrator": "みやび", "text": "女子を口説く気が少しでもあるなら"},
        { "location": "303/TALK"    , "narrator": "みやび", "text": "知っておけ"},
        { "location": "279/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
