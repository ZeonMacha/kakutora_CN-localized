        { "location": "7/SCENARIO", "narrator": "", "text": "000_どうにかするわ"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "どうにかなる"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "と"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "どうにかする"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "って"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "全然違うのね"},
        { "location": "39/SEL"    , "narrator": "", "text": "もちろん"},
        { "location": "40/SEL"    , "narrator": "", "text": "まあね"},
        { "location": "41/SEL"    , "narrator": "", "text": "ガブは日本語に敏感だね"},
        { "location": "42/ACT"    , "narrator": "", "text": "もちろん"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "44/ACT"    , "narrator": "", "text": "まあね"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナも知っているのね"},
        { "location": "47/ACT"    , "narrator": "", "text": "ガブは日本語に敏感だね"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "あらｖｖ"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "そんなの当然でしょう？"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "それでね"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "私はどうにかしたいのよ"},
        { "location": "56/SEL"    , "narrator": "", "text": "何を？"},
        { "location": "57/ACT"    , "narrator": "", "text": "何を？"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "フェノメノンをよ"},
        { "location": "61/SEL"    , "narrator": "", "text": "大きく出たね"},
        { "location": "62/SEL"    , "narrator": "", "text": "今もしてるでしょ"},
        { "location": "63/SEL"    , "narrator": "", "text": "どうにかするしかないよね"},
        { "location": "64/ACT"    , "narrator": "", "text": "大きく出たね"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "そんなことはないと思うわ"},
        { "location": "66/ACT"    , "narrator": "", "text": "今もしてるでしょ"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "確かに"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "そうではあるんだけど"},
        { "location": "69/ACT"    , "narrator": "", "text": "どうにかするしかないよね"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "どうにかしなきゃいけないわ"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "いくら適性が必要だからって"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "覚悟もない女の子がここにいるのは"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりちょっと異常なことだと思うのよ"},
        { "location": "77/SEL"    , "narrator": "", "text": "それはつばめのこと？"},
        { "location": "78/SEL"    , "narrator": "", "text": "本人はそう思ってないかもよ"},
        { "location": "79/SEL"    , "narrator": "", "text": "ガブは優しいね"},
        { "location": "80/ACT"    , "narrator": "", "text": "それはつばめのこと？"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "83/ACT"    , "narrator": "", "text": "本人はそう思ってないかもよ"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "そんなの"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "行動を見ればわかるわよ"},
        { "location": "86/ACT"    , "narrator": "", "text": "ガブは優しいね"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "親切心で"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "言ってるわけじゃなくってよ？"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "だから私は"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "どうにかしたいのよ"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "どうにかなると"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "アーヤとも会えなくなるのかしら"},
        { "location": "103/SEL"   , "narrator": "", "text": "そうかもね"},
        { "location": "104/SEL"   , "narrator": "", "text": "二人は友達でしょ"},
        { "location": "105/SEL"   , "narrator": "", "text": "$me$がいるよ"},
        { "location": "106/ACT"   , "narrator": "", "text": "そうかもね"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "そうなると"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "寂しいわ"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "とても"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "それでも私は"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "どうにかしたいわ"},
        { "location": "115/ACT"   , "narrator": "", "text": "二人は友達でしょ"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "少なくとも私はそう思っているわ"},
        { "location": "119/ACT"   , "narrator": "", "text": "$me$がいるよ"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "そうねｖｖｖ"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "私たちずっと友達よねｖｖｖ"}
