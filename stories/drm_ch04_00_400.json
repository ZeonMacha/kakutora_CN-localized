    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "310_仕事は仕事"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "いささか困ったことになり申した"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "どうしても休みがとりたい日と"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "当直の日が重なってしまったのだ"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "なんという不幸なめぐりあわせ"},
        { "location": "37/SEL"    , "narrator": "", "text": "代わってもらえば？"},
        { "location": "38/SEL"    , "narrator": "", "text": "それは残念だったね"},
        { "location": "39/ACT"    , "narrator": "", "text": "代わってもらえば？"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "最初はそのつもりだった"},
        { "location": "41/ACT"    , "narrator": "", "text": "それは残念だったね"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "その通り"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "代わってもらうよう交渉したものの"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "物別れに終わった"},
        { "location": "48/SEL"    , "narrator": "", "text": "再チャレンジだ"},
        { "location": "49/SEL"    , "narrator": "", "text": "さぼっちゃえ"},
        { "location": "50/SEL"    , "narrator": "", "text": "$me$が頼んでみようか"},
        { "location": "51/ACT"    , "narrator": "", "text": "再チャレンジだ"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "いいか"},
        { "location": "55/ACT"    , "narrator": "", "text": "さぼっちゃえ"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "なるほど！"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "それは"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "ダメな考えだ"},
        { "location": "59/ACT"    , "narrator": "", "text": "$me$が頼んでみようか"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "それは"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "遠慮しておく"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "お気持ちだけで"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "と"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "いうやつぞね"},
        { "location": "80/SEL"    , "narrator": "", "text": "まあそう言わず"},
        { "location": "81/SEL"    , "narrator": "", "text": "任せてくれないの？"},
        { "location": "82/ACT"    , "narrator": "", "text": "まあそう言わず"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "そう言うにきまっちょろう"},
        { "location": "84/ACT"    , "narrator": "", "text": "任せてくれないの？"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "いやいや"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "任せるち言われても困ろう"},
        { "location": "89/SEL"    , "narrator": "", "text": "頑張るから"},
        { "location": "90/SEL"    , "narrator": "", "text": "ちょっとやらせてよ"},
        { "location": "91/ACT"    , "narrator": "", "text": "頑張るから"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "しなくてよい"},
        { "location": "95/ACT"    , "narrator": "", "text": "ちょっとやらせてよ"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "そう簡単な問題ではない"},
        { "location": "99/SEL"    , "narrator": "", "text": "結果報告するね"},
        { "location": "100/SEL"   , "narrator": "", "text": "上手くやるから"},
        { "location": "101/ACT"   , "narrator": "", "text": "結果報告するね"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "そもそも"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "チャレンジせんでよい"},
        { "location": "104/ACT"   , "narrator": "", "text": "上手くやるから"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "いやいや"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "せんでよいというに"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "全くもう"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "この話は"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "ここまでだ"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "お勤めは"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "果たさねばな"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "一応義務だし"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "そういうわけで"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "手出しは無用"},
        { "location": "119/TALK"  , "narrator": "ボイスメール", "text": "グッジョブとは言ってやらぬ"},
        { "location": "65/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>900pt.</b></color></size>\nアップしました！"},
        { "location": "131/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【グッジョブとは言ってやらぬ】</color>\nをゲットしました！"}
