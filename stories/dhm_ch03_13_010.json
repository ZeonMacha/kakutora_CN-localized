    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "018_リアリティとリアリズム"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "ねえマルザンナ"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "私、図書館でのことが頭から離れないわ"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "まさかあんな日本のアニメみたいなことが現実にあるなんて"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "やっぱり日本ってすごいわね"},
        { "location": "37/SEL"    , "narrator": "", "text": "いや、滅多にいないよ？"},
        { "location": "38/SEL"    , "narrator": "", "text": "ガブリエラもいつかしよう"},
        { "location": "39/SEL"    , "narrator": "", "text": "どんなアニメ見てるの？"},
        { "location": "40/ACT"    , "narrator": "", "text": "いや、滅多にいないよ？"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "そうなの？"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "そうなのね"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "じゃあ貴重なものを見たのね"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "その割にはつばめたちは反応が薄かったけど"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "それが奥ゆかしさってやつなのかしら"},
        { "location": "46/ACT"    , "narrator": "", "text": "ガブリエラもいつかしよう"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "無理よ！？！？！？！"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "ああいうのは恥ずかしすぎるわ？？？"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "それに男の人とか苦手だし"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "見るだけでいいわ"},
        { "location": "54/ACT"    , "narrator": "", "text": "どんなアニメ見てるの？"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "学園ものとかが多いかしら♪"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "少女漫画が原作のとかね"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "コメディも切ない系もどっちも好きよ"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "あ"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "純粋にアニメとして楽しんでるだけよ"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "私が男の子が苦手なのは関係ないから"}
    ]
}
