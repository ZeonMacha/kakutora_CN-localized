{
    "dir": "chap36/daydra/dd_ch05_36_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "36502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "ソラノキヲク＜前編＞"
    },
    "entry":
    [
        { "location": "2066/TALK"  , "narrator": "神楽", "text": "…あの時見たのと、\n同じだわ。"},
        { "location": "2067/TALK"  , "narrator": "神楽", "text": "フランスにいた時、\nテレビのニュースで\n見た…。"},
        { "location": "2068/TALK"  , "narrator": "神楽", "text": "あの、日本の景色と。"},
        { "location": "2070/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2072/TALK"  , "narrator": "神楽", "text": "…圏外。\n完全に機能が停止\nしてるみたい…。"},
        { "location": "2076/TALK"  , "narrator": "神楽", "text": "ざまあみろ、\n一之宮北斎。"},
        { "location": "2077/TALK"  , "narrator": "神楽", "text": "日本の、輝ける\n千年王国は大失敗に\n終わったわ。"},
        { "location": "2078/TALK"  , "narrator": "神楽", "text": "あなた達の\nカルトな世界支配は、\nここで終わり。"},
        { "location": "2080/TALK"  , "narrator": "神楽", "text": "これから世界は――"},
        { "location": "2081/TALK"  , "narrator": "神楽", "text": "何も変わらない\n日本を目の当たりに\nするだけ。"},
        { "location": "2082/TALK"  , "narrator": "神楽", "text": "…終わったんだ。\nこれで、本当に…。"},
        { "location": "2083/SEL"   , "narrator": "", "text": "神楽、大丈夫？"},
        { "location": "2084/ACT"   , "narrator": "", "text": "神楽、大丈夫？"},
        { "location": "2095/TALK"  , "narrator": "神楽", "text": "見ての通り"},
        { "location": "2096/TALK"  , "narrator": "神楽", "text": "五体満足です"},
        { "location": "2098/TALK"  , "narrator": "神楽", "text": "っていうか、なんで繋がってるんですか？"},
        { "location": "2100/SEL"   , "narrator": "", "text": "異世界通信の部分だけ復旧したから"},
        { "location": "2101/SEL"   , "narrator": "", "text": "愛の力で繋げた"},
        { "location": "2102/SEL"   , "narrator": "", "text": "振り向いてごらん"},
        { "location": "2103/ACT"   , "narrator": "", "text": "異世界通信の部分だけ復旧したから"},
        { "location": "2104/TALK"  , "narrator": "神楽", "text": "参りました"},
        { "location": "2106/TALK"  , "narrator": "神楽", "text": "そんなことまでできちゃうんですね"},
        { "location": "2107/ACT"   , "narrator": "", "text": "愛の力で繋げた"},
        { "location": "2108/TALK"  , "narrator": "神楽", "text": "無理にそっちに持ってかなくても"},
        { "location": "2110/TALK"  , "narrator": "神楽", "text": "わからない、でいいんですよ？"},
        { "location": "2111/ACT"   , "narrator": "", "text": "振り向いてごらん"},
        { "location": "2112/TALK"  , "narrator": "神楽", "text": "本当にいるとき以外は"},
        { "location": "2114/TALK"  , "narrator": "神楽", "text": "しない方がいいネタなのでは？"},
        { "location": "2117/TALK"  , "narrator": "神楽", "text": "貴方がRedinessを破壊したんですか？"},
        { "location": "2119/SEL"   , "narrator": "", "text": "違う"},
        { "location": "2120/ACT"   , "narrator": "", "text": "違う"},
        { "location": "2122/TALK"  , "narrator": "神楽", "text": "じゃあ、誰が？"},
        { "location": "2124/SEL"   , "narrator": "", "text": "知らない方がいい"},
        { "location": "2125/SEL"   , "narrator": "", "text": "どうしても知りたい？"},
        { "location": "2126/ACT"   , "narrator": "", "text": "知らない方がいい"},
        { "location": "2127/ACT"   , "narrator": "", "text": "どうしても知りたい？"},
        { "location": "2129/TALK"  , "narrator": "神楽", "text": "知ってるなら教えてください！"},
        { "location": "2130/TALK"  , "narrator": "神楽", "text": "つばめさんは？ママは？"},
        { "location": "2131/TALK"  , "narrator": "神楽", "text": "アーヤさんやガブちゃんや、みやびさん"},
        { "location": "2132/TALK"  , "narrator": "神楽", "text": "真幌さんに、クラスのみんなや先生は？"},
        { "location": "2133/TALK"  , "narrator": "神楽", "text": "私の思い出は？"},
        { "location": "2134/TALK"  , "narrator": "神楽", "text": "それを一緒に壊したのは、誰なんですか！？"},
        { "location": "2136/SEL"   , "narrator": "", "text": "神楽、落ち着いて"},
        { "location": "2137/ACT"   , "narrator": "", "text": "神楽、落ち着いて"},
        { "location": "2139/TALK"  , "narrator": "神楽", "text": "じゃあ、早く教えてください！"},
        { "location": "2140/TALK"  , "narrator": "神楽", "text": "教えてくれないなら"},
        { "location": "2141/TALK"  , "narrator": "神楽", "text": "もう貴方とは話しません！"},
        { "location": "2145/SEL"   , "narrator": "", "text": "Redinessを停めたのは、神楽の心だよ"},
        { "location": "2146/ACT"   , "narrator": "", "text": "Redinessを停めたのは、神楽の心だよ"},
        { "location": "2148/TALK"  , "narrator": "神楽", "text": "私の？"},
        { "location": "2151/SEL"   , "narrator": "", "text": "神楽の心の中の人格の一人が停めた"},
        { "location": "2152/ACT"   , "narrator": "", "text": "神楽の心の中の人格の一人が停めた"},
        { "location": "2154/TALK"  , "narrator": "神楽", "text": "そんな"},
        { "location": "2156/TALK"  , "narrator": "神楽", "text": "いえ"},
        { "location": "2158/TALK"  , "narrator": "神楽", "text": "わかる気がします"},
        { "location": "2159/TALK"  , "narrator": "神楽", "text": "私のココロの中にいる誰かが"},
        { "location": "2160/TALK"  , "narrator": "神楽", "text": "どうやってシステムを停止させたのか"},
        { "location": "2161/TALK"  , "narrator": "神楽", "text": "それはわからないけど"},
        { "location": "2162/TALK"  , "narrator": "神楽", "text": "多分"},
        { "location": "2163/TALK"  , "narrator": "神楽", "text": "そこにRedinessのスイッチがあるとしたら"},
        { "location": "2164/TALK"  , "narrator": "神楽", "text": "衝動的に切ってしまうかも"},
        { "location": "2166/TALK"  , "narrator": "神楽", "text": "私も少なからず"},
        { "location": "2167/TALK"  , "narrator": "神楽", "text": "Redinessには否定的ですし"},
        { "location": "2168/TALK"  , "narrator": "神楽", "text": "壊れてしまえば良い"},
        { "location": "2169/TALK"  , "narrator": "神楽", "text": "何度も、そう思ってましたから"},
        { "location": "2170/TALK"  , "narrator": "神楽", "text": "けど、現実には無理だし"},
        { "location": "2171/TALK"  , "narrator": "神楽", "text": "本当にやったら"},
        { "location": "2172/TALK"  , "narrator": "神楽", "text": "失うのはRedinessの罪だけじゃなくて"},
        { "location": "2173/TALK"  , "narrator": "神楽", "text": "Redinessによって作られた思い出や大切な人達"},
        { "location": "2174/TALK"  , "narrator": "神楽", "text": "それまで失ってしまうから"},
        { "location": "2176/TALK"  , "narrator": "神楽", "text": "けど、"},
        { "location": "2177/TALK"  , "narrator": "神楽", "text": "やってしまったんですね"},
        { "location": "2179/TALK"  , "narrator": "神楽", "text": "私は"},
        { "location": "2180/TALK"  , "narrator": "神楽", "text": "私が、この世界を壊してしまったんですね"},
        { "location": "2183/SEL"   , "narrator": "", "text": "大丈夫だよ、神楽"},
        { "location": "2184/ACT"   , "narrator": "", "text": "大丈夫だよ、神楽"},
        { "location": "2186/TALK"  , "narrator": "神楽", "text": "なにがですか？"},
        { "location": "2188/SEL"   , "narrator": "", "text": "Redinessは停止してるだけだから、再起動できる"},
        { "location": "2189/ACT"   , "narrator": "", "text": "Redinessは停止してるだけだから、再起動できる"},
        { "location": "2192/TALK"  , "narrator": "神楽", "text": "じゃあ、元に戻るだけですね"},
        { "location": "2193/TALK"  , "narrator": "神楽", "text": "エンタングルも秒単位で損害があるでしょうから"},
        { "location": "2194/TALK"  , "narrator": "神楽", "text": "復旧も、時間の問題です"},
        { "location": "2196/SEL"   , "narrator": "", "text": "無理だよ、$me$以外再起動できないし"},
        { "location": "2197/ACT"   , "narrator": "", "text": "無理だよ、$me$以外再起動できないし"},
        { "location": "2199/TALK"  , "narrator": "神楽", "text": "まさか"},
        { "location": "2201/TALK"  , "narrator": "神楽", "text": "エンタングルは、Redinessの全てを握ってるんです"},
        { "location": "2202/TALK"  , "narrator": "神楽", "text": "貴方がどんなに超的な存在だとしても"},
        { "location": "2203/TALK"  , "narrator": "神楽", "text": "エンタングルに無理なことが"},
        { "location": "2204/TALK"  , "narrator": "神楽", "text": "可能とは思えません"},
        { "location": "2206/SEL"   , "narrator": "", "text": "Redinessには、エンタングルにも知らない部分がある"},
        { "location": "2207/ACT"   , "narrator": "", "text": "Redinessには、エンタングルにも知らない部分がある"},
        { "location": "2209/TALK"  , "narrator": "神楽", "text": "それを貴方が知ってると？"},
        { "location": "2211/SEL"   , "narrator": "", "text": "神楽の心の中で、神楽のお父さんからその鍵をもらった"},
        { "location": "2212/ACT"   , "narrator": "", "text": "神楽の心の中で、神楽のお父さんからその鍵をもらった"},
        { "location": "2215/TALK"  , "narrator": "神楽", "text": "まさか"},
        { "location": "2217/TALK"  , "narrator": "神楽", "text": "ありえません"},
        { "location": "2218/TALK"  , "narrator": "神楽", "text": "父はもう、この世にいないのに"},
        { "location": "2220/SEL"   , "narrator": "", "text": "Redinessの中枢に、神楽への遺言を残していたんだよ"},
        { "location": "2221/ACT"   , "narrator": "", "text": "Redinessの中枢に、神楽への遺言を残していたんだよ"},
        { "location": "2224/TALK"  , "narrator": "神楽", "text": "なにそれ"},
        { "location": "2225/TALK"  , "narrator": "神楽", "text": "そんな"},
        { "location": "2226/TALK"  , "narrator": "神楽", "text": "今更過ぎる"},
        { "location": "2228/TALK"  , "narrator": "神楽", "text": "生きてるときはなにもしてくれなかったのに"},
        { "location": "2231/SEL"   , "narrator": "", "text": "ねえ、神楽"},
        { "location": "2232/ACT"   , "narrator": "", "text": "ねえ、神楽"},
        { "location": "2235/SEL"   , "narrator": "", "text": "$me$なら、Redinessをどうすることもできる"},
        { "location": "2236/ACT"   , "narrator": "", "text": "$me$なら、Redinessをどうすることもできる"},
        { "location": "2239/SEL"   , "narrator": "", "text": "けど、これは神楽に託されたものだから、$me$が勝手に運用していいものじゃない"},
        { "location": "2240/ACT"   , "narrator": "", "text": "けど、これは神楽に託されたものだから、$me$が勝手に運用していいものじゃない"},
        { "location": "2243/SEL"   , "narrator": "", "text": "神楽はどうしたいの？"},
        { "location": "2244/ACT"   , "narrator": "", "text": "神楽はどうしたいの？"},
        { "location": "2247/TALK"  , "narrator": "神楽", "text": "私は"},
        { "location": "2249/TALK"  , "narrator": "神楽", "text": "みんなとの思い出を元に戻したいです"},
        { "location": "2250/TALK"  , "narrator": "神楽", "text": "つばめさんや"},
        { "location": "2251/TALK"  , "narrator": "神楽", "text": "トライナリーのみんな"},
        { "location": "2252/TALK"  , "narrator": "神楽", "text": "クラスのみんなと"},
        { "location": "2253/TALK"  , "narrator": "神楽", "text": "学園生活したり"},
        { "location": "2254/TALK"  , "narrator": "神楽", "text": "トライナリーとしての任務をこなしたり"},
        { "location": "2255/TALK"  , "narrator": "神楽", "text": "その中で色んな素敵な思い出があって"},
        { "location": "2257/TALK"  , "narrator": "神楽", "text": "そんな何の変哲も無い日常"},
        { "location": "2258/TALK"  , "narrator": "神楽", "text": "私は、それを取り戻したいです！"},
        { "location": "2260/SEL"   , "narrator": "", "text": "わかったよ"},
        { "location": "2261/SEL"   , "narrator": "", "text": "かしこまりました、ご主人様"},
        { "location": "2262/SEL"   , "narrator": "", "text": "いい答えだ"},
        { "location": "2263/ACT"   , "narrator": "", "text": "わかったよ"},
        { "location": "2264/ACT"   , "narrator": "", "text": "かしこまりました、ご主人様"},
        { "location": "2265/TALK"  , "narrator": "神楽", "text": "よろしくお願いします"},
        { "location": "2267/ACT"   , "narrator": "", "text": "いい答えだ"},
        { "location": "2268/TALK"  , "narrator": "神楽", "text": "ありがとうございます"},
        { "location": "2272/SEL"   , "narrator": "", "text": "１つだけ方法がある"},
        { "location": "2273/ACT"   , "narrator": "", "text": "１つだけ方法がある"},
        { "location": "2275/TALK"  , "narrator": "神楽", "text": "教えてください！"},
        { "location": "2277/SEL"   , "narrator": "", "text": "つばめが作ったのと同じフェノメノンを、今度は神楽が作るんだ"},
        { "location": "2278/ACT"   , "narrator": "", "text": "つばめが作ったのと同じフェノメノンを、今度は神楽が作るんだ"},
        { "location": "2280/TALK"  , "narrator": "神楽", "text": "え"},
        { "location": "2281/TALK"  , "narrator": "神楽", "text": "そんなこと"},
        { "location": "2282/TALK"  , "narrator": "神楽", "text": "むりです"},
        { "location": "2283/TALK"  , "narrator": "神楽", "text": "つばめさんは桁外れの力を持ってるから出来たし"},
        { "location": "2284/TALK"  , "narrator": "神楽", "text": "想いだって"},
        { "location": "2286/SEL"   , "narrator": "", "text": "$me$がサポートするから、心配しないで"},
        { "location": "2287/SEL"   , "narrator": "", "text": "そうだね、言っておいてなんだけど$me$はあまりお薦めしない"},
        { "location": "2288/ACT"   , "narrator": "", "text": "$me$がサポートするから、心配しないで"},
        { "location": "2289/TALK"  , "narrator": "神楽", "text": "$handlek$が？？"},
        { "location": "2290/ACT"   , "narrator": "", "text": "そうだね、言っておいてなんだけど$me$はあまりお薦めしない"},
        { "location": "2291/TALK"  , "narrator": "神楽", "text": "そうですか"},
        { "location": "2292/TALK"  , "narrator": "神楽", "text": "でも、一応おしえてもらえませんか？"},
        { "location": "2293/TALK"  , "narrator": "神楽", "text": "自分で考えたいから"},
        { "location": "2296/SEL"   , "narrator": "", "text": "同じ見た目の世界にすることも、$me$の世界と繋がっていればそれ自体は可能"},
        { "location": "2297/ACT"   , "narrator": "", "text": "同じ見た目の世界にすることも、$me$の世界と繋がっていればそれ自体は可能"},
        { "location": "2299/SEL"   , "narrator": "", "text": "けど１つだけ、神楽自身の想いだけは、神楽ががんばらないといけないよ"},
        { "location": "2300/ACT"   , "narrator": "", "text": "けど１つだけ、神楽自身の想いだけは、神楽ががんばらないといけないよ"},
        { "location": "2302/TALK"  , "narrator": "神楽", "text": "それって要するに"},
        { "location": "2304/SEL"   , "narrator": "", "text": "発症を臨界させるための想い。一度発症してるからわかるよね"},
        { "location": "2305/ACT"   , "narrator": "", "text": "発症を臨界させるための想い。一度発症してるからわかるよね"},
        { "location": "2307/TALK"  , "narrator": "神楽", "text": "わかります"},
        { "location": "2310/TALK"  , "narrator": "神楽", "text": "わかりました、私やってみます"},
        { "location": "2311/TALK"  , "narrator": "神楽", "text": "つばめさんたちを、たすけるためだから"},
        { "location": "2312/TALK"  , "narrator": "神楽", "text": "きっと大丈夫"},
        { "location": "2314/TALK"  , "narrator": "神楽", "text": "信頼してるから"},
        { "location": "2316/SEL"   , "narrator": "", "text": "ありがとう"},
        { "location": "2317/ACT"   , "narrator": "", "text": "ありがとう"},
        { "location": "2319/SEL"   , "narrator": "", "text": "あ、でもすぐに人間に戻れるから安心して。エリカさんがそうしてくれるから"},
        { "location": "2320/ACT"   , "narrator": "", "text": "あ、でもすぐに人間に戻れるから安心して。エリカさんがそうしてくれるから"},
        { "location": "2322/TALK"  , "narrator": "神楽", "text": "そうなんですね"},
        { "location": "2323/TALK"  , "narrator": "神楽", "text": "私にとっては、もうどっちでも"},
        { "location": "2324/TALK"  , "narrator": "神楽", "text": "あ、でも"},
        { "location": "2325/TALK"  , "narrator": "神楽", "text": "やっぱり待って！"},
        { "location": "2329/TALK"  , "narrator": "神楽", "text": "もしかしたら"},
        { "location": "2330/TALK"  , "narrator": "神楽", "text": "このままがいいのかも"},
        { "location": "2332/SEL"   , "narrator": "", "text": "なんで？"},
        { "location": "2333/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "2335/TALK"  , "narrator": "神楽", "text": "Redinessが停止したこのままこそ"},
        { "location": "2336/TALK"  , "narrator": "神楽", "text": "世界にとって、最も良いことだと思いませんか？"},
        { "location": "2337/TALK"  , "narrator": "神楽", "text": "つばめさん達に会いたいのは"},
        { "location": "2338/TALK"  , "narrator": "神楽", "text": "単なる、私のエゴに過ぎませんし"},
        { "location": "2339/TALK"  , "narrator": "神楽", "text": "それで元に戻ってしまうのは"},
        { "location": "2340/TALK"  , "narrator": "神楽", "text": "私の勝手なワガママで世界を動かしてしまうということ"},
        { "location": "2341/TALK"  , "narrator": "神楽", "text": "そう思ったんです"},
        { "location": "2343/TALK"  , "narrator": "神楽", "text": "考える時間をください"},
        { "location": "2345/SEL"   , "narrator": "", "text": "待ってるよ"},
        { "location": "2346/ACT"   , "narrator": "", "text": "待ってるよ"},
        { "location": "2359/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2360/TALK"  , "narrator": "神楽", "text": "私は…。"},
        { "location": "2361/TALK"  , "narrator": "神楽", "text": "私は、\nどうすればいいの？"},
        { "location": "2369/TALK"  , "narrator": "神楽", "text": "どうすれば…。"},
        { "location": "2370/TALK"  , "narrator": "神楽", "text": "いったい、\nどうすることが\n正しいの…？"},
        { "location": "2372/TALK"  , "narrator": "神楽", "text": "…はぁ……。"},
        { "location": "2373/SEL"   , "narrator": "", "text": "神楽、大丈夫？"},
        { "location": "2374/ACT"   , "narrator": "", "text": "神楽、大丈夫？"},
        { "location": "2385/TALK"  , "narrator": "神楽", "text": "はい"},
        { "location": "2387/SEL"   , "narrator": "", "text": "そうは見えない、ヨタヨタだよ？"},
        { "location": "2388/ACT"   , "narrator": "", "text": "そうは見えない、ヨタヨタだよ？"},
        { "location": "2390/TALK"  , "narrator": "神楽", "text": "大丈夫ですから"},
        { "location": "2392/TALK"  , "narrator": "神楽", "text": "ご心配なく"},
        { "location": "2394/SEL"   , "narrator": "", "text": "見てられないよ"},
        { "location": "2395/ACT"   , "narrator": "", "text": "見てられないよ"},
        { "location": "2397/TALK"  , "narrator": "神楽", "text": "大丈夫ですって"},
        { "location": "2399/SEL"   , "narrator": "", "text": "絶対大丈夫じゃないよ"},
        { "location": "2400/ACT"   , "narrator": "", "text": "絶対大丈夫じゃないよ"},
        { "location": "2403/TALK"  , "narrator": "神楽", "text": "わからないんです"},
        { "location": "2404/TALK"  , "narrator": "神楽", "text": "どうすることが一番なのか"},
        { "location": "2406/TALK"  , "narrator": "神楽", "text": "私は、Redinessでどうしたいかの権利を持っている"},
        { "location": "2407/TALK"  , "narrator": "神楽", "text": "でも、その結果望むことは"},
        { "location": "2408/TALK"  , "narrator": "神楽", "text": "結局全部自分のエゴでしかないんです"},
        { "location": "2409/TALK"  , "narrator": "神楽", "text": "私は、本当に自分の幸せしか考えてないんです"},
        { "location": "2410/TALK"  , "narrator": "神楽", "text": "こんな娘が、世界を動かす力を託されてるんですよ？"},
        { "location": "2411/TALK"  , "narrator": "神楽", "text": "なんだか、もう世界がおかしいとしか思えなくて"},
        { "location": "2413/TALK"  , "narrator": "神楽", "text": "笑えますよね"},
        { "location": "2415/TALK"  , "narrator": "神楽", "text": "私にくれるプレゼントは"},
        { "location": "2416/TALK"  , "narrator": "神楽", "text": "全部勉強に関する物ばかりでした"},
        { "location": "2417/TALK"  , "narrator": "神楽", "text": "でも、最後の最後まで"},
        { "location": "2418/TALK"  , "narrator": "神楽", "text": "こんな壮大な学習教材を送ってくるなんて"},
        { "location": "2419/TALK"  , "narrator": "神楽", "text": "ホント、大したものですよね"},
        { "location": "2421/TALK"  , "narrator": "神楽", "text": "このまま餓死でもして"},
        { "location": "2422/TALK"  , "narrator": "神楽", "text": "この、死んでしまった私の故郷と同じように"},
        { "location": "2423/TALK"  , "narrator": "神楽", "text": "ここに骨を埋める"},
        { "location": "2424/TALK"  , "narrator": "神楽", "text": "それが一番なのかも"},
        { "location": "2426/SEL"   , "narrator": "", "text": "気持ちはよくわかるけど、そんなこと言わないで"},
        { "location": "2427/ACT"   , "narrator": "", "text": "気持ちはよくわかるけど、そんなこと言わないで"},
        { "location": "2429/TALK"  , "narrator": "神楽", "text": "なんでですか？"},
        { "location": "2432/SEL"   , "narrator": "", "text": "$me$にとって、神楽は大切な人だから"},
        { "location": "2433/ACT"   , "narrator": "", "text": "$me$にとって、神楽は大切な人だから"},
        { "location": "2437/TALK"  , "narrator": "神楽", "text": "貴方は"},
        { "location": "2438/TALK"  , "narrator": "神楽", "text": "別の世界の人でしょう？"},
        { "location": "2439/TALK"  , "narrator": "神楽", "text": "貴方のいる日本は平和なんだから"},
        { "location": "2440/TALK"  , "narrator": "神楽", "text": "それで十分じゃないですか"},
        { "location": "2442/TALK"  , "narrator": "神楽", "text": "通信が切れれば"},
        { "location": "2443/TALK"  , "narrator": "神楽", "text": "いつか、私のことも忘れますよ"},
        { "location": "2445/SEL"   , "narrator": "", "text": "そんなことない！世界の垣根なんて愛する想いには関係無い"},
        { "location": "2446/SEL"   , "narrator": "", "text": "そうかもしれないけど、それでも今の$me$には大切な人だよ"},
        { "location": "2447/ACT"   , "narrator": "", "text": "そんなことない！世界の垣根なんて愛する想いには関係無い"},
        { "location": "2448/TALK"  , "narrator": "神楽", "text": "どうだか？"},
        { "location": "2449/TALK"  , "narrator": "神楽", "text": "そんなのわからないじゃないですか"},
        { "location": "2450/ACT"   , "narrator": "", "text": "そうかもしれないけど、それでも今の$me$には大切な人だよ"},
        { "location": "2451/TALK"  , "narrator": "神楽", "text": "いつか忘れるかもしれない相手のために"},
        { "location": "2452/TALK"  , "narrator": "神楽", "text": "必死になる必要ないですよ"},
        { "location": "2455/SEL"   , "narrator": "", "text": "$me$は神楽に幸せになってほしいと思ってる"},
        { "location": "2456/ACT"   , "narrator": "", "text": "$me$は神楽に幸せになってほしいと思ってる"},
        { "location": "2459/SEL"   , "narrator": "", "text": "そのためなら、最後までやり遂げる覚悟だ"},
        { "location": "2460/ACT"   , "narrator": "", "text": "そのためなら、最後までやり遂げる覚悟だ"},
        { "location": "2463/TALK"  , "narrator": "神楽", "text": "どうして？"},
        { "location": "2465/TALK"  , "narrator": "神楽", "text": "どうして、そんなに必死なんですか？"},
        { "location": "2466/TALK"  , "narrator": "神楽", "text": "私なんて"},
        { "location": "2467/TALK"  , "narrator": "神楽", "text": "違う世界の、絶対に会えることのない存在なのに"},
        { "location": "2469/SEL"   , "narrator": "", "text": "$me$は神楽の幸せを一番に願ってる"},
        { "location": "2470/SEL"   , "narrator": "", "text": "$me$は神楽のいる世界を一番に想ってる"},
        { "location": "2471/ACT"   , "narrator": "", "text": "$me$は神楽の幸せを一番に願ってる"},
        { "location": "2472/ACT"   , "narrator": "", "text": "$me$は神楽のいる世界を一番に想ってる"},
        { "location": "2474/TALK"  , "narrator": "神楽", "text": "そんなのわかってます"},
        { "location": "2475/TALK"  , "narrator": "神楽", "text": "ずっと、一緒にいたんですから"},
        { "location": "2476/TALK"  , "narrator": "神楽", "text": "そんなのはわかってるんです"},
        { "location": "2477/TALK"  , "narrator": "神楽", "text": "だけど"},
        { "location": "2479/SEL"   , "narrator": "", "text": "だから、$me$と一緒に最後までやってみようよ"},
        { "location": "2480/ACT"   , "narrator": "", "text": "だから、$me$と一緒に最後までやってみようよ"},
        { "location": "2483/TALK"  , "narrator": "神楽", "text": "え？"},
        { "location": "2485/SEL"   , "narrator": "", "text": "神楽の想いも苦悩も、$me$はわかってるつもりだよ"},
        { "location": "2486/ACT"   , "narrator": "", "text": "神楽の想いも苦悩も、$me$はわかってるつもりだよ"},
        { "location": "2488/TALK"  , "narrator": "神楽", "text": "はい"},
        { "location": "2490/SEL"   , "narrator": "", "text": "その気持ちを大事にして、最善を尽くしたいんだ"},
        { "location": "2491/ACT"   , "narrator": "", "text": "その気持ちを大事にして、最善を尽くしたいんだ"},
        { "location": "2494/TALK"  , "narrator": "神楽", "text": "いいんですか？"},
        { "location": "2495/TALK"  , "narrator": "神楽", "text": "$handlek$にだって、自分の生活があるのに"},
        { "location": "2497/SEL"   , "narrator": "", "text": "こんな時だからこそ、だよ"},
        { "location": "2498/ACT"   , "narrator": "", "text": "こんな時だからこそ、だよ"},
        { "location": "2502/TALK"  , "narrator": "神楽", "text": "ありがとうございます"},
        { "location": "2503/TALK"  , "narrator": "神楽", "text": "ほんとに"},
        { "location": "2504/TALK"  , "narrator": "神楽", "text": "$handlek$がいてくれてよかった"},
        { "location": "2506/SEL"   , "narrator": "", "text": "でも、最終的には神楽が決めるんだよ？$me$は心の整理をするだけ"},
        { "location": "2507/ACT"   , "narrator": "", "text": "でも、最終的には神楽が決めるんだよ？$me$は心の整理をするだけ"},
        { "location": "2510/SEL"   , "narrator": "", "text": "神楽にとってどんなものであっても、これはお父さんが神楽にくれたものなんだ"},
        { "location": "2511/ACT"   , "narrator": "", "text": "神楽にとってどんなものであっても、これはお父さんが神楽にくれたものなんだ"},
        { "location": "2514/SEL"   , "narrator": "", "text": "その気持ちは大事にしたいし、神楽も大切にして欲しい。それでいい？"},
        { "location": "2515/ACT"   , "narrator": "", "text": "その気持ちは大事にしたいし、神楽も大切にして欲しい。それでいい？"},
        { "location": "2518/TALK"  , "narrator": "神楽", "text": "はい、もちろんです。"},
        { "location": "2520/SEL"   , "narrator": "", "text": "神楽、ありがとう"},
        { "location": "2521/SEL"   , "narrator": "", "text": "神楽、いつも隣にいるからね"},
        { "location": "2522/SEL"   , "narrator": "", "text": "神楽、愛してるよ"},
        { "location": "2523/ACT"   , "narrator": "", "text": "神楽、ありがとう"},
        { "location": "2524/TALK"  , "narrator": "神楽", "text": "お礼を言うのは、こっちですよ"},
        { "location": "2527/ACT"   , "narrator": "", "text": "神楽、いつも隣にいるからね"},
        { "location": "2528/TALK"  , "narrator": "神楽", "text": "はい、信じてます"},
        { "location": "2531/ACT"   , "narrator": "", "text": "神楽、愛してるよ"},
        { "location": "2532/TALK"  , "narrator": "神楽", "text": "ありがとうございます"},
        { "location": "2537/SEL"   , "narrator": "", "text": "じゃあ、まずは神楽のことを良く解ってる人に協力を仰いでくるから待ってて"},
        { "location": "2538/ACT"   , "narrator": "", "text": "じゃあ、まずは神楽のことを良く解ってる人に協力を仰いでくるから待ってて"},
        { "location": "2541/TALK"  , "narrator": "神楽", "text": "え？"},
        { "location": "2542/TALK"  , "narrator": "神楽", "text": "誰ですか？父？"},
        { "location": "2544/SEL"   , "narrator": "", "text": "卯月神楽だよ"},
        { "location": "2545/ACT"   , "narrator": "", "text": "卯月神楽だよ"},
        { "location": "2577/TALK"  , "narrator": "アースタシア", "text": "お久し振りです。"},
        { "location": "2578/SEL"   , "narrator": "", "text": "アースタシア"},
        { "location": "2579/ACT"   , "narrator": "", "text": "アースタシア"},
        { "location": "2581/TALK"  , "narrator": "アースタシア", "text": "つばめさんの彩った世界が\n消えてしまいました。"},
        { "location": "2582/TALK"  , "narrator": "アースタシア", "text": "月神楽が全てを\n無に還してしまいました。"},
        { "location": "2583/TALK"  , "narrator": "アースタシア", "text": "ですが。\nあの子を責めないで\nあげてください。"},
        { "location": "2584/TALK"  , "narrator": "アースタシア", "text": "あの子は、卯月神楽という\n総体の中で、"},
        { "location": "2585/TALK"  , "narrator": "アースタシア", "text": "自身に与えられた役割を\n忠実にこなしただけ。"},
        { "location": "2586/TALK"  , "narrator": "アースタシア", "text": "責められるのであれば、\nそれらを束ねる役務にある\n私こそが相応しいのです。"},
        { "location": "2587/SEL"   , "narrator": "", "text": "自分を責めないで"},
        { "location": "2588/SEL"   , "narrator": "", "text": "月神楽をココロの司書にしたのはどうしてなの？"},
        { "location": "2589/ACT"   , "narrator": "", "text": "自分を責めないで"},
        { "location": "2590/TALK"  , "narrator": "アースタシア", "text": "お気遣い\nありがとうございます。"},
        { "location": "2591/TALK"  , "narrator": "アースタシア", "text": "ですが、これは\n卯月神楽が抱えている\n問題の発露であり――"},
        { "location": "2592/TALK"  , "narrator": "アースタシア", "text": "同時にそれを\n抑制出来なかった\n私の責任なのです"},
        { "location": "2593/ACT"   , "narrator": "", "text": "月神楽をココロの司書にしたのはどうしてなの？"},
        { "location": "2594/TALK"  , "narrator": "アースタシア", "text": "彼女は、卯月神楽の中でも\n超現実派です。"},
        { "location": "2595/TALK"  , "narrator": "アースタシア", "text": "私の人格は皆、\nちょっとぶっ飛んでるのが\n多くて……。"},
        { "location": "2596/TALK"  , "narrator": "アースタシア", "text": "その首根っこ掴んで\nある程度コントロール\nできる人格は限定されます"},
        { "location": "2597/TALK"  , "narrator": "アースタシア", "text": "月神楽はそれが出来る、\n人格でもありました。"},
        { "location": "2599/TALK"  , "narrator": "アースタシア", "text": "ただ、恐らくはその\n生真面目な性格が\n源だったのでしょう。"},
        { "location": "2600/TALK"  , "narrator": "アースタシア", "text": "元々彼女が持っていた\n性質の中に、父親に対する\n憎悪がありました。"},
        { "location": "2601/TALK"  , "narrator": "アースタシア", "text": "それが結びついて、\n今回の様な事態に発展\nしてしまったのです。"},
        { "location": "2602/TALK"  , "narrator": "アースタシア", "text": "いずれにせよ、\n卯月神楽という存在、\nそしてセルフの私――"},
        { "location": "2603/TALK"  , "narrator": "アースタシア", "text": "それこそが、\nつばめさんの世界を壊した\n張本人であり。"},
        { "location": "2604/TALK"  , "narrator": "アースタシア", "text": "また、責任を持って\n再生する義務を持つ\n存在なのは確かです。"},
        { "location": "2605/SEL"   , "narrator": "", "text": "まあそうだね"},
        { "location": "2606/SEL"   , "narrator": "", "text": "贖罪なの？"},
        { "location": "2607/ACT"   , "narrator": "", "text": "まあそうだね"},
        { "location": "2608/TALK"  , "narrator": "アースタシア", "text": "はい。"},
        { "location": "2609/ACT"   , "narrator": "", "text": "贖罪なの？"},
        { "location": "2610/TALK"  , "narrator": "アースタシア", "text": "使命と言った方が\n正しいかもしれません。"},
        { "location": "2612/TALK"  , "narrator": "アースタシア", "text": "卯月神楽の心の中には\n「破壊」と「創造」が\n棲み着いています。"},
        { "location": "2613/TALK"  , "narrator": "アースタシア", "text": "それは、自身の創作を\n爆発的に作り上げる為に\n重要な要素ですが――"},
        { "location": "2614/TALK"  , "narrator": "アースタシア", "text": "時に、それが\n周囲に大きな影響を\n与えることがあります。"},
        { "location": "2615/TALK"  , "narrator": "アースタシア", "text": "それに目をつけたのが\n“彼ら”であって。"},
        { "location": "2616/TALK"  , "narrator": "アースタシア", "text": "その力を利用して\n日本を意のままに動かす\n為の手段が――"},
        { "location": "2617/TALK"  , "narrator": "アースタシア", "text": "イシュフォビア\nだったのです。"},
        { "location": "2618/TALK"  , "narrator": "アースタシア", "text": "月神楽は「破壊」を\n象徴する側の子で\nあったわけです。"},
        { "location": "2619/TALK"  , "narrator": "アースタシア", "text": "それは、純粋に創作を\n高める為には、重要な\n立場ではあるのです。"},
        { "location": "2620/TALK"  , "narrator": "アースタシア", "text": "より良いものを作るには、\nより多くの破壊が\n必要なのですから。"},
        { "location": "2621/TALK"  , "narrator": "アースタシア", "text": "ですが、それを現実に\n持ち込めてしまうのは、\n大変な問題です。"},
        { "location": "2622/TALK"  , "narrator": "アースタシア", "text": "Redinessという端末は、\n良くも悪くも妄想と現実の\n垣根を無くしました。"},
        { "location": "2623/TALK"  , "narrator": "アースタシア", "text": "月神楽は、\nそして卯月神楽は――"},
        { "location": "2624/TALK"  , "narrator": "アースタシア", "text": "自ら無意識のうちに、\n現実を、創造物と同等の\n力で動かしている。"},
        { "location": "2625/TALK"  , "narrator": "アースタシア", "text": "その事について、\n私は厳粛に捉え、責任を\nとらなければなりません。"},
        { "location": "2626/SEL"   , "narrator": "", "text": "責任って…辞任するの！？"},
        { "location": "2627/SEL"   , "narrator": "", "text": "責任とって元通りにするの？"},
        { "location": "2628/ACT"   , "narrator": "", "text": "責任って…辞任するの！？"},
        { "location": "2629/TALK"  , "narrator": "アースタシア", "text": "いえ、まさか。"},
        { "location": "2630/TALK"  , "narrator": "アースタシア", "text": "そのような事をしても、\n何も解決しません。"},
        { "location": "2631/ACT"   , "narrator": "", "text": "責任とって元通りにするの？"},
        { "location": "2632/TALK"  , "narrator": "アースタシア", "text": "そうです。"},
        { "location": "2634/TALK"  , "narrator": "アースタシア", "text": "私は、この世界を大きく\n変えてしまった事に関し、\n責任をとります。"},
        { "location": "2635/TALK"  , "narrator": "アースタシア", "text": "すなわち、\nライフギャザーの機能を\n全て復元し――"},
        { "location": "2636/TALK"  , "narrator": "アースタシア", "text": "失ってしまった、\nつばめさんの世界を\n復元するのです。"},
        { "location": "2637/SEL"   , "narrator": "", "text": "是非お願いします。協力しますよ"},
        { "location": "2638/SEL"   , "narrator": "", "text": "$me$はそれを望んでいない。ライフギャザーは葬り去るべきだ"},
        { "location": "2639/ACT"   , "narrator": "", "text": "是非お願いします。協力しますよ"},
        { "location": "2641/TALK"  , "narrator": "アースタシア", "text": "ありがとうございます。"},
        { "location": "2642/ACT"   , "narrator": "", "text": "$me$はそれを望んでいない。ライフギャザーは葬り去るべきだ"},
        { "location": "2644/TALK"  , "narrator": "アースタシア", "text": "その考え方も\nありだと思います。"},
        { "location": "2645/TALK"  , "narrator": "アースタシア", "text": "ただ、私は私自身が\n自らの責任において、\n原状回復をするだけ。"},
        { "location": "2646/TALK"  , "narrator": "アースタシア", "text": "もし貴方がそれに\n否定的なら――"},
        { "location": "2647/TALK"  , "narrator": "アースタシア", "text": "是非私が直した後に、\n貴方自らの手によって\n停止してください。"},
        { "location": "2648/SEL"   , "narrator": "", "text": "二度手間では…？"},
        { "location": "2649/ACT"   , "narrator": "", "text": "二度手間では…？"},
        { "location": "2651/TALK"  , "narrator": "アースタシア", "text": "物理現象としては\nそうかもしれませんね。"},
        { "location": "2652/TALK"  , "narrator": "アースタシア", "text": "ですが、想いの力の\n見地からすれば、\n全く違います。"},
        { "location": "2653/TALK"  , "narrator": "アースタシア", "text": "誰が、どんな思いで、\nライフギャザーを\n停止したのか。"},
        { "location": "2654/TALK"  , "narrator": "アースタシア", "text": "そこが重要なのですから。"},
        { "location": "2655/TALK"  , "narrator": "アースタシア", "text": "ですから、私は私で自らの\n責務を全うし、ライフ\nギャザーを復活させます。"},
        { "location": "2656/TALK"  , "narrator": "アースタシア", "text": "後は、貴方の\nしたいようにするのが\n良いかと思います。"},
        { "location": "2657/TALK"  , "narrator": "アースタシア", "text": "ライフギャザーの\n管理者権限を\n持っているのですから。"},
        { "location": "2659/TALK"  , "narrator": "アースタシア", "text": "ところで――"},
        { "location": "2660/TALK"  , "narrator": "アースタシア", "text": "$handle$さんは、\n“卯月神楽”とは、\n何だと思いますか？"},
        { "location": "2661/SEL"   , "narrator": "", "text": "歌と世界"},
        { "location": "2662/SEL"   , "narrator": "", "text": "金髪美少女"},
        { "location": "2663/SEL"   , "narrator": "", "text": "貧乳"},
        { "location": "2664/ACT"   , "narrator": "", "text": "歌と世界"},
        { "location": "2666/TALK"  , "narrator": "アースタシア", "text": "そう言ってもらえると\nとても嬉しいです。"},
        { "location": "2667/ACT"   , "narrator": "", "text": "金髪美少女"},
        { "location": "2668/TALK"  , "narrator": "アースタシア", "text": "ありがとうございます。\nそれはそれで、とても\n嬉しくはありますが――"},
        { "location": "2669/TALK"  , "narrator": "アースタシア", "text": "私自身が私という存在を\n客観的に見るならば。"},
        { "location": "2670/TALK"  , "narrator": "アースタシア", "text": "卯月神楽という存在は、\n創作であると思います。"},
        { "location": "2671/ACT"   , "narrator": "", "text": "貧乳"},
        { "location": "2672/TALK"  , "narrator": "アースタシア", "text": "ふざけんな。"},
        { "location": "2673/TALK"  , "narrator": "アースタシア", "text": "お前のそういう所\nホント嫌い。"},
        { "location": "2674/TALK"  , "narrator": "アースタシア", "text": "TPO弁えろよバーカ！"},
        { "location": "2683/TALK"  , "narrator": "アースタシア", "text": "卯月神楽は、これまで\nその人生の大半を、\n創作に費やしてきました。"},
        { "location": "2684/TALK"  , "narrator": "アースタシア", "text": "卯月神楽に今できることは\nその「想いの力」で、\n世界を戻すことだけです。"},
        { "location": "2685/TALK"  , "narrator": "アースタシア", "text": "その「思いの源」たる\nこのアースタシアが\nその任に就きます。"},
        { "location": "2686/TALK"  , "narrator": "アースタシア", "text": "その為に私は\n卯月神楽のセルフとして\n存在しているのですから。"},
        { "location": "2687/SEL"   , "narrator": "", "text": "神楽の創作のためにいるってこと？"},
        { "location": "2688/ACT"   , "narrator": "", "text": "神楽の創作のためにいるってこと？"},
        { "location": "2690/TALK"  , "narrator": "アースタシア", "text": "はい。そうです。"},
        { "location": "2691/TALK"  , "narrator": "アースタシア", "text": "少し変わってると\n思われるでしょうね。"},
        { "location": "2692/TALK"  , "narrator": "アースタシア", "text": "普通、セルフはその\n総意における源の精神を\n体現する存在です。"},
        { "location": "2693/TALK"  , "narrator": "アースタシア", "text": "その意味でも、\n創作が根源にあるという\nことではあるのですが、"},
        { "location": "2694/TALK"  , "narrator": "アースタシア", "text": "逆に言えば、それ故に\n少し地に足が付いてない、"},
        { "location": "2695/TALK"  , "narrator": "アースタシア", "text": "浮世離れした子として\n現実を生きている。"},
        { "location": "2696/TALK"  , "narrator": "アースタシア", "text": "そんな存在なのです。\n卯月神楽というのは。"},
        { "location": "2697/SEL"   , "narrator": "", "text": "だから、あんなに素敵な歌や物語が作れるんだね"},
        { "location": "2698/SEL"   , "narrator": "", "text": "だから、あんなに変わった子なんだね"},
        { "location": "2699/ACT"   , "narrator": "", "text": "だから、あんなに素敵な歌や物語が作れるんだね"},
        { "location": "2701/TALK"  , "narrator": "アースタシア", "text": "そう言っていただけると\n私という総体は、とても\n嬉しく思います。"},
        { "location": "2702/TALK"  , "narrator": "アースタシア", "text": "創作は本当に、\n私にとって生きること\nそのものなのですから。"},
        { "location": "2703/ACT"   , "narrator": "", "text": "だから、あんなに変わった子なんだね"},
        { "location": "2704/TALK"  , "narrator": "アースタシア", "text": "苦笑せざるを得ませんね。"},
        { "location": "2705/TALK"  , "narrator": "アースタシア", "text": "ですが、\n否定はできません。"},
        { "location": "2706/TALK"  , "narrator": "アースタシア", "text": "正直、他の方のセルフに\n比べて、私は頼りないと\n思いませんでしたか？"},
        { "location": "2707/SEL"   , "narrator": "", "text": "正直ちょっと思ってた"},
        { "location": "2708/SEL"   , "narrator": "", "text": "そうは思わなかった"},
        { "location": "2709/ACT"   , "narrator": "", "text": "正直ちょっと思ってた"},
        { "location": "2710/TALK"  , "narrator": "アースタシア", "text": "ですよね。"},
        { "location": "2711/TALK"  , "narrator": "アースタシア", "text": "通常のセルフクランは\n現実の自分に\n全フリですから。"},
        { "location": "2712/TALK"  , "narrator": "アースタシア", "text": "ですが、私は\n卯月神楽の作る世界に\n7割振っているんです。"},
        { "location": "2713/TALK"  , "narrator": "アースタシア", "text": "その分、他の人格たちが\n自立し、動いてくれている\nことを感謝しています。"},
        { "location": "2714/TALK"  , "narrator": "アースタシア", "text": "それと、そんな私をも、\n見放さずに対応してくれる\n貴方にも。"},
        { "location": "2715/ACT"   , "narrator": "", "text": "そうは思わなかった"},
        { "location": "2716/TALK"  , "narrator": "アースタシア", "text": "ありがとうございます。"},
        { "location": "2717/TALK"  , "narrator": "アースタシア", "text": "そう言ってもらえると、\n少し自信が持てますね。"},
        { "location": "2720/TALK"  , "narrator": "アースタシア", "text": "私は、その卯月神楽の\nセルフクランとして――"},
        { "location": "2721/TALK"  , "narrator": "アースタシア", "text": "その激しいまでの\n思いの力を体現することが\nできます。"},
        { "location": "2722/TALK"  , "narrator": "アースタシア", "text": "ですから、\n$handle$さんに\n協力して欲しいのです。"},
        { "location": "2723/TALK"  , "narrator": "アースタシア", "text": "私の殻を破って\nその能力を余すことなく\n開花させて欲しいのです。"},
        { "location": "2724/SEL"   , "narrator": "", "text": "具体的には…？"},
        { "location": "2725/ACT"   , "narrator": "", "text": "具体的には…？"},
        { "location": "2727/TALK"  , "narrator": "アースタシア", "text": "過去に他のセルフクランの\n力を解放した事があれば、\n何となく想像出来るかと。"},
        { "location": "2728/SEL"   , "narrator": "", "text": "戦う？"},
        { "location": "2729/ACT"   , "narrator": "", "text": "戦う？"},
        { "location": "2731/TALK"  , "narrator": "アースタシア", "text": "そうですね。\n端から見れば、\nそうなります。"},
        { "location": "2732/TALK"  , "narrator": "アースタシア", "text": "私との戦いです。"},
        { "location": "2733/TALK"  , "narrator": "アースタシア", "text": "ですがそれは、\n思いの解放、すなわち\n葛藤処理に他なりません。"},
        { "location": "2734/TALK"  , "narrator": "アースタシア", "text": "ですから、\n何も気にすることは\nありません。"},
        { "location": "2735/TALK"  , "narrator": "アースタシア", "text": "むしろ、ありったけの\n想いの力で\n戦って欲しい。"},
        { "location": "2736/TALK"  , "narrator": "アースタシア", "text": "そう、切に願っています。"},
        { "location": "2737/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "2738/SEL"   , "narrator": "", "text": "あまり気が進まない"},
        { "location": "2739/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "2740/TALK"  , "narrator": "アースタシア", "text": "ありがとうございます。"},
        { "location": "2741/ACT"   , "narrator": "", "text": "あまり気が進まない"},
        { "location": "2743/TALK"  , "narrator": "アースタシア", "text": "その気持ちは\nよくわかります。"},
        { "location": "2744/TALK"  , "narrator": "アースタシア", "text": "$handle$さんは、\nライフギャザーを\n消したいのですよね。"},
        { "location": "2745/TALK"  , "narrator": "アースタシア", "text": "ただ、私が\n$handle$さんに\nお伝えしたいのは――"},
        { "location": "2746/TALK"  , "narrator": "アースタシア", "text": "ならばなおのこと、\n貴方自身の手で止めて\n欲しいという事です。"},
        { "location": "2747/TALK"  , "narrator": "アースタシア", "text": "私が存在する以上、\n私は元の世界に\n戻そうとします。"},
        { "location": "2748/TALK"  , "narrator": "アースタシア", "text": "目的は\n変わってしまいますが――"},
        { "location": "2749/TALK"  , "narrator": "アースタシア", "text": "私が世界になった後、\n改めてライフギャザーを\n葬りされるのであれば。"},
        { "location": "2750/TALK"  , "narrator": "アースタシア", "text": "今度は誰も、\nそれを復活しようなどとは\n思わないでしょうから。"},
        { "location": "2752/TALK"  , "narrator": "アースタシア", "text": "そうですか。"},
        { "location": "2753/TALK"  , "narrator": "アースタシア", "text": "色々と複雑な思いが\nあることは、\nよくわかります。"},
        { "location": "2754/TALK"  , "narrator": "アースタシア", "text": "卯月神楽が\n世界になることが\n心配なのでしょうか？"},
        { "location": "2755/TALK"  , "narrator": "アースタシア", "text": "であれば、\n心配には及びませんよ。"},
        { "location": "2756/TALK"  , "narrator": "アースタシア", "text": "私が世界になるのは、\nごく一時的な間です。"},
        { "location": "2757/TALK"  , "narrator": "アースタシア", "text": "既に聞いているかも\nしれませんが――"},
        { "location": "2758/TALK"  , "narrator": "アースタシア", "text": "私が世界を作る役割を\n担っているのは、創造性と\nもう１つ――"},
        { "location": "2759/TALK"  , "narrator": "アースタシア", "text": "今、私達の世界において\n唯一、ライフギャザーを\n掌握しているからです。"},
        { "location": "2760/TALK"  , "narrator": "アースタシア", "text": "ですから卯月神楽は\n世界再生のスターターと\nして発症するのであり。"},
        { "location": "2761/TALK"  , "narrator": "アースタシア", "text": "それが完了すれば、\nエリカさんによる複写で\n2E113に受け継がれます。"},
        { "location": "2762/TALK"  , "narrator": "アースタシア", "text": "その時点で、卯月神楽は\n世界から人へ、戻って\nくることができます。"},
        { "location": "2765/TALK"  , "narrator": "アースタシア", "text": "それでは\n改めまして。"},
        { "location": "2766/TALK"  , "narrator": "アースタシア", "text": "準備は良いでしょうか。"},
        { "location": "2767/SEL"   , "narrator": "", "text": "はい"},
        { "location": "2768/SEL"   , "narrator": "", "text": "待って"},
        { "location": "2769/ACT"   , "narrator": "", "text": "はい"},
        { "location": "2770/ACT"   , "narrator": "", "text": "待って"},
        { "location": "2771/TALK"  , "narrator": "アースタシア", "text": "気持ちはわかります。\nですが、想いが熱いうちに\nどうかお願いします。"},
        { "location": "2772/TALK"  , "narrator": "アースタシア", "text": "私にとって、\n歌と世界を創ることは\n何よりも幸せなこと。"},
        { "location": "2773/TALK"  , "narrator": "アースタシア", "text": "それが現実世界であれば\nこんなに素敵なことは\nありません。"},
        { "location": "2774/TALK"  , "narrator": "アースタシア", "text": "少し不謹慎では\nありますが。"},
        { "location": "2775/TALK"  , "narrator": "アースタシア", "text": "こんな貴重な体験をさせて\nくれている、今回の件、\nそして貴方には――"},
        { "location": "2776/TALK"  , "narrator": "アースタシア", "text": "感謝の気持ちで一杯です。"},
        { "location": "2777/SEL"   , "narrator": "", "text": "神楽も感謝するのだろうか"},
        { "location": "2778/ACT"   , "narrator": "", "text": "神楽も感謝するのだろうか"},
        { "location": "2780/TALK"  , "narrator": "アースタシア", "text": "もちろん、卯月神楽は\nセルフクランの私ほど\n純粋ではありません。"},
        { "location": "2781/TALK"  , "narrator": "アースタシア", "text": "葛藤も強いでしょう。\n素直に喜ぶことは\n難しいとは思います。"},
        { "location": "2782/TALK"  , "narrator": "アースタシア", "text": "ただ、世界を創作する者と\nして、卯月神楽には\nこんな感情もあります。"},
        { "location": "2783/TALK"  , "narrator": "アースタシア", "text": "現実を創造出来ることは、\nその命と引き替えで\nあっても価値のあること。"},
        { "location": "2784/TALK"  , "narrator": "アースタシア", "text": "それは、卯月神楽自身が\n潜在的にずっと夢見て\n来たことそのものだから。"},
        { "location": "2785/TALK"  , "narrator": "アースタシア", "text": "これはまごう事なき\n真実なのです。"},
        { "location": "2786/TALK"  , "narrator": "アースタシア", "text": "ただ単にそれが、\n皆や貴方との絆によって、\nバランスをとれているだけ"},
        { "location": "2787/TALK"  , "narrator": "アースタシア", "text": "それだけの\nことなのです。"},
        { "location": "2789/TALK"  , "narrator": "アースタシア", "text": "さあ、それでは\nよろしくお願いします。"},
        { "location": "2790/TALK"  , "narrator": "アースタシア", "text": "共に創りましょう。"},
        { "location": "2791/TALK"  , "narrator": "アースタシア", "text": "愛と優しさに満ちあふれた\n新しい世界を――！！"},
