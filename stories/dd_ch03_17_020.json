{
    "dir": "chap17/daydra/dd_ch03_17_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "17356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "お手前披露"
    },
    "entry":
    [
        { "location": "299/SCENARIO", "narrator": "", "text": "お手前披露"},
        { "location": "317/TALK"    , "narrator": "つばめ", "text": "わぁ、すごい！\nガブちゃんまた命中だよ！"},
        { "location": "318/TALK"    , "narrator": "雛", "text": "凄いよガブリエラちゃん！\n射撃の腕は世界一だね！"},
        { "location": "321/TALK"    , "narrator": "ガブリエラ", "text": "ま、これくらい当然よ。"},
        { "location": "322/TALK"    , "narrator": "ガブリエラ", "text": "それにしても、エアガンの\nシューティングレンジが\nあるなんて――"},
        { "location": "324/TALK"    , "narrator": "ガブリエラ", "text": "今日まで知らなかったわ。"},
        { "location": "325/TALK"    , "narrator": "ヒカル", "text": "僕とキリトは\nよく来るんですよ。"},
        { "location": "326/TALK"    , "narrator": "ヒカル", "text": "授業で習った射撃訓練の\n復習にもなるので。"},
        { "location": "327/TALK"    , "narrator": "雛", "text": "ん～、関心関心。\n勉強熱心だねー。"},
        { "location": "328/TALK"    , "narrator": "ヒカル", "text": "まあ、半分は遊びみたいな\nものですけど…ね？"},
        { "location": "329/TALK"    , "narrator": "キリト", "text": "…………。"},
        { "location": "330/TALK"    , "narrator": "ヒカル", "text": "キリト、\nどうかしましたか？"},
        { "location": "331/TALK"    , "narrator": "キリト", "text": "…俺のハイスコア、\nガブリエラに抜かれち\nまった。"},
        { "location": "332/TALK"    , "narrator": "ヒカル", "text": "いや、それは仕方ないと\n思いますよ？"},
        { "location": "333/TALK"    , "narrator": "ヒカル", "text": "ガブリエラさんの方が\n銃の経験は豊富に積んで\nいるんですし。"},
        { "location": "335/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "336/TALK"    , "narrator": "キリト", "text": "けどな、俺にも養成科の\n射撃成績一位のプライドが\nあるんだ。"},
        { "location": "338/TALK"    , "narrator": "キリト", "text": "おい、雛。\n俺は今から、ガブリエラに\n勝負を申し込むぜ。"},
        { "location": "340/TALK"    , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "342/TALK"    , "narrator": "雛", "text": "…って言ってるけど、\nどうする？"},
        { "location": "343/TALK"    , "narrator": "ガブリエラ", "text": "ま、まあ、あたしは別に\n構わないけど…。"},
        { "location": "345/TALK"    , "narrator": "つばめ", "text": "でも、ガブちゃんって\nキリトくんのハイスコアを\n抜いたんだよね？"},
        { "location": "346/TALK"    , "narrator": "ヒカル", "text": "そうですよ。\n勝負は見えてるじゃ\nないですか。"},
        { "location": "347/TALK"    , "narrator": "キリト", "text": "へへっ、甘いな。\nちゃーんと考えが\nあってのことさ。"},
        { "location": "348/TALK"    , "narrator": "つばめ", "text": "何か作戦があるの？"},
        { "location": "350/TALK"    , "narrator": "キリト", "text": "ああ…なあ、ガブリエラ。\n俺の提案を聞いてくれ。"},
        { "location": "353/TALK"    , "narrator": "ガブリエラ", "text": "…な、なんだろう？\n何を言われるのかしら？"},
        { "location": "354/TALK"    , "narrator": "キリト", "text": "…………。"},
        { "location": "356/TALK"    , "narrator": "キリト", "text": "ハンデください。"},
        { "location": "358/TALK"    , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "360/TALK"    , "narrator": "つばめ", "text": "ハンデ！？"},
        { "location": "361/TALK"    , "narrator": "雛", "text": "しょぼっ！！\nてか超ダサッ！！"},
        { "location": "364/TALK"    , "narrator": "ヒカル", "text": "き、キリト…\nさすがにそれはどうなん\nですか？"},
        { "location": "367/TALK"    , "narrator": "キリト", "text": "お、おまえらだって\nわかってんだろ！？"},
        { "location": "368/TALK"    , "narrator": "キリト", "text": "俺がまともにやっても、\nガブリエラに勝てるはず\nねぇって！"},
        { "location": "370/TALK"    , "narrator": "雛", "text": "だからって、女の子に\nハンデ貰うって…ねえ？"},
        { "location": "372/TALK"    , "narrator": "ガブリエラ", "text": "ハンデかぁ…\nう～ん…。"},
        { "location": "373/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと調べるから\n待ってて。"},
        { "location": "374/TALK"    , "narrator": "雛", "text": "ごめんね、キリトの\nワガママに付き合わせて。"},
        { "location": "387/TALK"    , "narrator": "ガブリエラ", "text": "相談があるの、マルザンナ"},
        { "location": "389/SEL"     , "narrator": "", "text": "それはそうと、楽しそうだね"},
        { "location": "390/ACT"     , "narrator": "", "text": "それはそうと、楽しそうだね"},
        { "location": "392/TALK"    , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "393/TALK"    , "narrator": "ガブリエラ", "text": "こういうところでみんなと遊ぶの初めてだから、凄く楽しんでるわ"},
        { "location": "394/TALK"    , "narrator": "ガブリエラ", "text": "それで、相談なんだけど"},
        { "location": "396/TALK"    , "narrator": "ガブリエラ", "text": "キリトにハンデをあげるべきかしら？"},
        { "location": "398/SEL"     , "narrator": "", "text": "何か問題でもあるの？"},
        { "location": "399/ACT"     , "narrator": "", "text": "何か問題でもあるの？"},
        { "location": "401/TALK"    , "narrator": "ガブリエラ", "text": "男の子相手にハンデあげて、それでキリトが勝っても嬉しくないと思うの"},
        { "location": "402/TALK"    , "narrator": "ガブリエラ", "text": "だから正々堂々とやった方が良いのかな、って"},
        { "location": "403/TALK"    , "narrator": "ガブリエラ", "text": "でも、友達の頼みだからハンデあげた方が良いのかな、とも思うし"},
        { "location": "404/TALK"    , "narrator": "ガブリエラ", "text": "どっちがいいと思う？"},
        { "location": "406/SEL"     , "narrator": "", "text": "ゲームにハンデは必要"},
        { "location": "407/SEL"     , "narrator": "", "text": "真剣勝負だ"},
        { "location": "408/ACT"     , "narrator": "", "text": "ゲームにハンデは必要"},
        { "location": "410/TALK"    , "narrator": "ガブリエラ", "text": "なるほど…"},
        { "location": "411/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナ、あなたの言う通りだわ"},
        { "location": "422/TALK"    , "narrator": "ガブリエラ", "text": "お待たせ。"},
        { "location": "424/TALK"    , "narrator": "つばめ", "text": "随分長く調べてたね。"},
        { "location": "426/TALK"    , "narrator": "ガブリエラ", "text": "え、えっと…エアガンの\nことを、ちょっとね…。"},
        { "location": "429/TALK"    , "narrator": "ガブリエラ", "text": "ハンデのことだけど、\nあたしは構わないわ。"},
        { "location": "431/TALK"    , "narrator": "キリト", "text": "おおっ、マジか！！"},
        { "location": "433/TALK"    , "narrator": "雛", "text": "ハンデなんかあげて\n大丈夫なの？"},
        { "location": "435/TALK"    , "narrator": "ガブリエラ", "text": "ゲームなんだから、\n互角にしないと\n面白くないわ。"},
        { "location": "436/TALK"    , "narrator": "ガブリエラ", "text": "その方がつばめ達も\n盛り上がれるし、真剣に\n勝負もできるでしょ？"},
        { "location": "437/TALK"    , "narrator": "キリト", "text": "さすが、ガブリエラは\nわかってるなぁ。"},
        { "location": "439/TALK"    , "narrator": "つばめ", "text": "それで、どれくらい\nハンデをつけるの？"},
        { "location": "441/TALK"    , "narrator": "ガブリエラ", "text": "まずは距離ね。\nあたしは１５メートルから\n撃つから――"},
        { "location": "442/TALK"    , "narrator": "ガブリエラ", "text": "１０メートル地点から\n撃っていいわ。"},
        { "location": "444/TALK"    , "narrator": "ガブリエラ", "text": "それと、銃も好きに\nオプション付けて\n構わないから。"},
        { "location": "445/TALK"    , "narrator": "つばめ", "text": "ガブちゃんは？"},
        { "location": "448/TALK"    , "narrator": "ガブリエラ", "text": "何も必要ないわ。\n１５メートルくらいなら\n肉眼でいけるし。"},
        { "location": "449/TALK"    , "narrator": "ヒカル", "text": "…キリト、どうしますか？"},
        { "location": "451/TALK"    , "narrator": "キリト", "text": "スコープとレーザー\nポインターを付けてくれ。"},
        { "location": "452/TALK"    , "narrator": "キリト", "text": "それくらいしねぇと、\nマジで勝てる気しねぇ\nからな…。"},
        { "location": "454/TALK"    , "narrator": "雛", "text": "ガブリエラちゃん、\n頑張ってね！"},
        { "location": "455/TALK"    , "narrator": "つばめ", "text": "ファイト、ガブちゃん！"},
        { "location": "464/TALK"    , "narrator": "雛", "text": "次が最後だね。\nこれで中心を当てれば…。"},
        { "location": "465/TALK"    , "narrator": "つばめ", "text": "ガブちゃん、頑張って！"},
        { "location": "466/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "467/TALK"    , "narrator": "ガブリエラ", "text": "今だっ！"},
        { "location": "474/TALK"    , "narrator": "キリト", "text": "うわっ、やりやがった！"},
        { "location": "476/TALK"    , "narrator": "ガブリエラ", "text": "やった！\n当たったわ！"},
        { "location": "477/TALK"    , "narrator": "つばめ", "text": "やったねガブちゃん！\nガブちゃんの勝ちだよ！"},
        { "location": "479/TALK"    , "narrator": "ガブリエラ", "text": "…ギリギリだったけどね。"},
        { "location": "480/TALK"    , "narrator": "雛", "text": "ハンデ付けたんだから、\nギリギリでも勝ったのは\n凄いよ！"},
        { "location": "481/TALK"    , "narrator": "キリト", "text": "はぁ…負けちまったぁ…。"},
        { "location": "483/TALK"    , "narrator": "ヒカル", "text": "残念でしたね。"},
        { "location": "485/TALK"    , "narrator": "キリト", "text": "ははっ、ちょっとだけな。\nでもすげぇ楽しかったぜ。"},
        { "location": "487/TALK"    , "narrator": "キリト", "text": "もっと腕を磨いたら、\n今度こそリベンジして\nやるさ。"},
        { "location": "488/TALK"    , "narrator": "ヒカル", "text": "あはは、今まで以上に\n射撃訓練に力入れそう\nですね。"},
        { "location": "490/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "492/TALK"    , "narrator": "ガブリエラ", "text": "凄く楽しかったし、\n本当にまた勝負したいな。"},
        { "location": "509/ACT"     , "narrator": "", "text": "真剣勝負だ"},
        { "location": "510/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "511/TALK"    , "narrator": "ガブリエラ", "text": "勝負である以上、真剣にやらないとダメよね"},
        { "location": "522/TALK"    , "narrator": "ガブリエラ", "text": "お待たせ。"},
        { "location": "524/TALK"    , "narrator": "つばめ", "text": "随分長く調べてたね。"},
        { "location": "526/TALK"    , "narrator": "ガブリエラ", "text": "え、えっと…エアガンの\nことを、ちょっとね…。"},
        { "location": "529/TALK"    , "narrator": "ガブリエラ", "text": "ハンデのことだけど、\n却下よ。"},
        { "location": "531/TALK"    , "narrator": "キリト", "text": "なにぃ！？"},
        { "location": "533/TALK"    , "narrator": "雛", "text": "いや、驚くようなことじゃ\nないから…。"},
        { "location": "534/TALK"    , "narrator": "つばめ", "text": "やっぱり、勝負は対等に\nやらなきゃダメだから？"},
        { "location": "536/TALK"    , "narrator": "ガブリエラ", "text": "それもあるけど、\n養成科で鍛えた人の腕が\nどの程度なのか――"},
        { "location": "537/TALK"    , "narrator": "ガブリエラ", "text": "一度、この目で確かめて\nみたいのよ。"},
        { "location": "539/TALK"    , "narrator": "キリト", "text": "…………。"},
        { "location": "541/TALK"    , "narrator": "ヒカル", "text": "キリト、しっかり！\n始める前から諦めないで\nください。"},
        { "location": "543/TALK"    , "narrator": "ガブリエラ", "text": "距離は１５メートル。\n使う弾は十発ね。"},
        { "location": "544/TALK"    , "narrator": "雛", "text": "…だって。\nわかった、キリト？"},
        { "location": "546/TALK"    , "narrator": "キリト", "text": "くそぉ、こうなったら\nやけくそだ！"},
        { "location": "549/TALK"    , "narrator": "ガブリエラ", "text": "…あんなに荒れてたら、\nまず当たらないわね。"},
        { "location": "550/TALK"    , "narrator": "ガブリエラ", "text": "勝負は見えたわ。"},
        { "location": "563/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "564/TALK"    , "narrator": "キリト", "text": "…ま、マジか？"},
        { "location": "565/TALK"    , "narrator": "ヒカル", "text": "はい…ガブリエラさんが\n９４点で、キリトの方が\n９６点なので――"},
        { "location": "566/TALK"    , "narrator": "ヒカル", "text": "ギリギリですが、\nキリトの勝ちです。"},
        { "location": "568/TALK"    , "narrator": "つばめ", "text": "うそっ！？\nガブちゃんが負ける\nなんて！！"},
        { "location": "571/TALK"    , "narrator": "ガブリエラ", "text": "うっ…。"},
        { "location": "573/TALK"    , "narrator": "雛", "text": "ちょ、つばめちゃん！\nそんなハッキリ言ったら\nダメだってば！"},
        { "location": "574/TALK"    , "narrator": "雛", "text": "ああ、ほら、明らかに\n落ち込んじゃってるし…。"},
        { "location": "576/TALK"    , "narrator": "ヒカル", "text": "し、仕方ないですよ！\nガブリエラさんは\n本物派ですし！"},
        { "location": "578/TALK"    , "narrator": "キリト", "text": "そ、そうだぜ！\n弾の飛び方も反動も、\n全然違うだろ？"},
        { "location": "579/TALK"    , "narrator": "キリト", "text": "エアガン慣れしてる\n俺の方が有利なんだから、\n落ち込む必要ねぇって！"},
        { "location": "583/TALK"    , "narrator": "ガブリエラ", "text": "な、なんかメチャクチャ\nフォローされてるし…。"},
        { "location": "584/TALK"    , "narrator": "ガブリエラ", "text": "…ま、まあ、確かに\n本物とは全然違うわね。"},
        { "location": "586/TALK"    , "narrator": "ガブリエラ", "text": "けど…真剣勝負だったん\nだから、負けは負けよ。\n潔く認めるわ。"},
        { "location": "588/TALK"    , "narrator": "つばめ", "text": "…意外と、落ち込んでは\nいないみたいのかな？"},
        { "location": "589/TALK"    , "narrator": "ヒカル", "text": "そうですね。\nちょっと驚いただけなの\nかもしれませんね。"},
        { "location": "591/TALK"    , "narrator": "キリト", "text": "…じゃあ、とりあえず\n勝ちは勝ちなんだし、\n素直に喜んでおくぜ。"},
        { "location": "592/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "594/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと、一時間だけ\n延長してくるわ。"},
        { "location": "596/TALK"    , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "598/TALK"    , "narrator": "ガブリエラ", "text": "べ、別に、悔しいからじゃ\nないわよ！？"},
        { "location": "599/TALK"    , "narrator": "ガブリエラ", "text": "もう少しエアガンを\n撃ってみたい、って\n思っただけだから…。"},
        { "location": "601/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと、行ってくるわ。"},
        { "location": "605/TALK"    , "narrator": "つばめ", "text": "…やっぱり、気にしてた\nみたいだね。"},
        { "location": "607/TALK"    , "narrator": "ヒカル", "text": "まあ、逆に安心しました。"},
        { "location": "608/TALK"    , "narrator": "ヒカル", "text": "ガブリエラさんが得意な\n射撃で負けて、気にしない\nとは思えませんでしたし。"},
        { "location": "609/TALK"    , "narrator": "雛", "text": "これさ、練習しまくって\nいずれキリトにリベンジ\nするつもりじゃないの？"},
        { "location": "611/TALK"    , "narrator": "キリト", "text": "ははっ…ちょっと怖い気も\nするけど――"},
        { "location": "612/TALK"    , "narrator": "キリト", "text": "ガブリエラの方から\n勝負しようって\n言ってきてくれるのは――"},
        { "location": "613/TALK"    , "narrator": "キリト", "text": "ちょっと楽しみかもな。"},
        { "location": "312/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>6月25日　3:11 PM</color>\nとある休日の午後、屋外シューティングレンジにて。"},
        { "location": "503/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch03", "text": "【闇夜に霜の降る如く】"}
    ]
}
