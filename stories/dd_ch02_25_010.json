        "title": "Extra002 プレミアムストーリー",
        "sub_title": "襲撃前夜＜アーヤ編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "襲撃前夜～アーヤ編～"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "――というわけで、\n館長からいつ連絡が\n来るかわからない。"},
        { "location": "27/TALK"   , "narrator": "アーヤ", "text": "だから、今夜はみんな、\n劇場に泊まってもらうわ。"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "やっぱそうなるかぁ…。\nまあ、しゃあないな。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "それと、外部と連絡を\nする場合は、間違っても\nストの話はしないこと。"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "みんな、いい？"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "りょーかい。"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "わかりました…。"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "言うわけないでしょ？\n機密漏えいに\nなっちゃうし…。"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "うん…それじゃみんな、\nよろしくね。"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "…わたしたち、\nどうなっちゃうんだろ？"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "まったく、情けない声\n出して…頼りないわねぇ。"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "ガブちゃんは\n不安じゃないの？"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "不安に決まってるでしょ？"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "でも、不安だからって\n暗くなってても\n仕方ないじゃない。"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "やっぱり、ギャヴィも\n不安みたいね…。"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "まあ、仕方ないか。"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "これからどうなるのかを\n考えれば、誰だって\n不安になると思うし…。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "館長からの次の連絡、\nいつになるのかしら？"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "もしもの時は指揮権を\n譲るって言ってたけど…。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "自分たちの状況すら把握\nできていないのに…、\nどうすればいいんだか…。"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "うち、向こうでちくっと\n考え事してるちや。"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "あっ…。"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "いけない…。\n少しピリピリし過ぎた\nかも…。"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "…みやび、嫌な気持ちに\nさせてしまったかしら？"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "…頭冷やさなくちゃ。"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "ふぅ…。"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "もう真っ暗…。\nいつもだったら、\n寮にいる時間か…。"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "…明日は、小夜と一緒の\n講義があるんだった。"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "終わったらランチに行く\n約束してたけど…、\n確実に無理よね…。"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "…多分、しばらくの間は。"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "…ああ、もう！"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "特別攻撃隊の仕事は、\nなにが起こるか\nわからない。"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "覚悟はしてたけど…、\nこんなの想定外過ぎよ。"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "私だって…本当はみんなと\n同じで不安がったり…。"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "慌てたり焦ったり、\n色々したいのに…！"},
        { "location": "95/SEL"    , "narrator": "", "text": "顔が険しいよ"},
        { "location": "96/SEL"    , "narrator": "", "text": "大丈夫？"},
        { "location": "97/ACT"    , "narrator": "", "text": "顔が険しいよ"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい(>_<)"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "考え事してて(-ω-;)"},
        { "location": "118/ACT"   , "narrator": "", "text": "大丈夫？"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "大丈夫よ"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "136/TALK"  , "narrator": "アーヤ", "text": "考え事してただけだから(￣Д￣ )"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "ねえ$handle2$"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "私達"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "これからどうなるのかしら？(´o｀；"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "フェノメノンと戦ってきたはずなのに"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "いつの間にか"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "私達のボスの"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "管理庁と揉めることになって(>_<)"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "劇場待機って時点で"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "どうなるのか"},
        { "location": "149/TALK"  , "narrator": "アーヤ", "text": "予想できるわ"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "管理庁が乗り込んでくる"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "私達を捕らえるために"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "不安だわ(T_T)"},
        { "location": "156/SEL"   , "narrator": "", "text": "$me$もサポートするよ"},
        { "location": "157/SEL"   , "narrator": "", "text": "やっぱり不安なんだ？"},
        { "location": "158/SEL"   , "narrator": "", "text": "今こそかっこつけよう！"},
        { "location": "159/ACT"   , "narrator": "", "text": "$me$もサポートするよ"},
        { "location": "160/TALK"  , "narrator": "アーヤ", "text": "サポートっていうけど"},
        { "location": "163/TALK"  , "narrator": "アーヤ", "text": "なんでもない"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい"},
        { "location": "165/TALK"  , "narrator": "アーヤ", "text": "今"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "酷い愚痴言いそうになってた"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "深呼吸してきた"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "ちょっと落ち着いたわm(_ _)m"},
        { "location": "172/SEL"   , "narrator": "", "text": "本当に？"},
        { "location": "173/SEL"   , "narrator": "", "text": "愚痴があるなら聞くよ"},
        { "location": "174/ACT"   , "narrator": "", "text": "本当に？"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "本当よ"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "178/TALK"  , "narrator": "アーヤ", "text": "いっぱいいっぱいだったみたい(｡-_-｡)"},
        { "location": "179/ACT"   , "narrator": "", "text": "愚痴があるなら聞くよ"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "平気"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "もう結構聞いてもらってるし(^^"},
        { "location": "182/TALK"  , "narrator": "アーヤ", "text": "それに"},
        { "location": "183/TALK"  , "narrator": "アーヤ", "text": "愚痴って言い過ぎると"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "逆にスッキリしなくなるから(>_<)"},
        { "location": "186/TALK"  , "narrator": "アーヤ", "text": "今見た私のこと"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "みんなには"},
        { "location": "188/TALK"  , "narrator": "アーヤ", "text": "ナイショにして( ・_・)σﾞ"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "絶対見せられない姿だから(；´Д｀)"},
        { "location": "191/SEL"   , "narrator": "", "text": "かっこ悪いもんね"},
        { "location": "192/SEL"   , "narrator": "", "text": "リーダーが不安を見せちゃダメ"},
        { "location": "193/ACT"   , "narrator": "", "text": "かっこ悪いもんね"},
        { "location": "194/TALK"  , "narrator": "アーヤ", "text": "そうじゃなくて(￣Д￣ )"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "私が不安だと"},
        { "location": "196/TALK"  , "narrator": "アーヤ", "text": "みんなにも"},
        { "location": "197/TALK"  , "narrator": "アーヤ", "text": "伝染しちゃうから(>_<)"},
        { "location": "198/ACT"   , "narrator": "", "text": "リーダーが不安を見せちゃダメ"},
        { "location": "199/TALK"  , "narrator": "アーヤ", "text": "そういうこと(￣∇￣)"},
        { "location": "200/TALK"  , "narrator": "アーヤ", "text": "リーダーの不安は"},
        { "location": "201/TALK"  , "narrator": "アーヤ", "text": "伝染しやすい"},
        { "location": "202/TALK"  , "narrator": "アーヤ", "text": "館長に教わったの(￣∇￣*)ゞ"},
        { "location": "204/TALK"  , "narrator": "アーヤ", "text": "だから"},
        { "location": "205/TALK"  , "narrator": "アーヤ", "text": "二人だけの秘密ね"},
        { "location": "206/ACT"   , "narrator": "", "text": "やっぱり不安なんだ？"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "当たり前よ(; ;)"},
        { "location": "208/TALK"  , "narrator": "アーヤ", "text": "忘れてる？"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "成人はしてるけど"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "まだ大学生だから"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "学生の小娘よ？(>_<)"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "なのにこんな大役"},
        { "location": "213/TALK"  , "narrator": "アーヤ", "text": "重くて当然だから(T_T)"},
        { "location": "216/SEL"   , "narrator": "", "text": "すっかり忘れてた"},
        { "location": "217/SEL"   , "narrator": "", "text": "でも、やるんでしょ？"},
        { "location": "218/ACT"   , "narrator": "", "text": "すっかり忘れてた"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "だと思った(-ω-;)"},
        { "location": "222/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "223/TALK"  , "narrator": "アーヤ", "text": "もう平気"},
        { "location": "224/TALK"  , "narrator": "アーヤ", "text": "少し落ち着いたわ(^^"},
        { "location": "227/TALK"  , "narrator": "アーヤ", "text": "愚痴ったからかしら？(・・。)ゞ"},
        { "location": "228/TALK"  , "narrator": "アーヤ", "text": "とにかく"},
        { "location": "229/TALK"  , "narrator": "アーヤ", "text": "かっこ悪いところ見せたけど"},
        { "location": "230/TALK"  , "narrator": "アーヤ", "text": "もう平気(*^.^*)"},
        { "location": "231/TALK"  , "narrator": "アーヤ", "text": "気を引き締めていくわ"},
        { "location": "232/ACT"   , "narrator": "", "text": "でも、やるんでしょ？"},
        { "location": "234/TALK"  , "narrator": "アーヤ", "text": "もちろんよ"},
        { "location": "235/TALK"  , "narrator": "アーヤ", "text": "小娘にだって"},
        { "location": "236/TALK"  , "narrator": "アーヤ", "text": "プライドはあるから(｀ヘ´)"},
        { "location": "237/TALK"  , "narrator": "アーヤ", "text": "最後まで"},
        { "location": "238/TALK"  , "narrator": "アーヤ", "text": "役目をやり遂げるから"},
        { "location": "240/ACT"   , "narrator": "", "text": "今こそかっこつけよう！"},
        { "location": "241/TALK"  , "narrator": "アーヤ", "text": "気づいてたの？＼(◎o◎)／"},
        { "location": "242/TALK"  , "narrator": "アーヤ", "text": "私が時々"},
        { "location": "243/TALK"  , "narrator": "アーヤ", "text": "かっこつけちゃうってこと(・・。)ゞ"},
        { "location": "244/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "245/TALK"  , "narrator": "アーヤ", "text": "大体無意識だから"},
        { "location": "246/TALK"  , "narrator": "アーヤ", "text": "意識的なのは"},
        { "location": "247/TALK"  , "narrator": "アーヤ", "text": "時々だけ(｡-_-｡)"},
        { "location": "249/SEL"   , "narrator": "", "text": "意識的にかっこつける時だ"},
        { "location": "250/ACT"   , "narrator": "", "text": "意識的にかっこつける時だ"},
        { "location": "252/TALK"  , "narrator": "アーヤ", "text": "そうね(^^"},
        { "location": "254/TALK"  , "narrator": "アーヤ", "text": "おもいっきりかっこつけるには"},
        { "location": "255/TALK"  , "narrator": "アーヤ", "text": "最高のシチュエーションね(*^o^*)"},
        { "location": "257/TALK"  , "narrator": "アーヤ", "text": "って"},
        { "location": "258/TALK"  , "narrator": "アーヤ", "text": "不謹慎かしら？(´o｀；"},
        { "location": "260/SEL"   , "narrator": "", "text": "最高にかっこいいよ"},
        { "location": "261/SEL"   , "narrator": "", "text": "不安を消すためだ"},
        { "location": "262/ACT"   , "narrator": "", "text": "かっこいいよ"},
        { "location": "263/TALK"  , "narrator": "アーヤ", "text": "ありがとう(*^^*)"},
        { "location": "265/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "266/TALK"  , "narrator": "アーヤ", "text": "もっとかっこつけて"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "乗り切って見せるから(｀ヘ´)"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "ちゃんと見ててねヾ(´・ω・｀)"},
        { "location": "271/ACT"   , "narrator": "", "text": "不安を消すためだ"},
        { "location": "272/TALK"  , "narrator": "アーヤ", "text": "ありがとう(^^"},
        { "location": "273/TALK"  , "narrator": "アーヤ", "text": "それじゃあ"},
        { "location": "274/TALK"  , "narrator": "アーヤ", "text": "おもいっきりかっこつけてくるわ！＼(^O^)／"},
        { "location": "25/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月3日　 5:44 PM</color>\nストライキ開始当日、神楽坂トライナリー楽屋にて"}
    ]
}
