{
    "dir": "chap10/daydra/dd_ch03_10_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "10302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "七夕祭りへ行きません？＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "七夕祭りへ行きません？"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "七夕まつり？"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "うん！\nもうすぐ近所の神社で\nやるんだって。"},
        { "location": "54/TALK"   , "narrator": "神楽", "text": "みんなで行こうと\n思うんですけど――"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "ガブちゃんも、\nもちろん行きます\nよね？"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "うーん、\n行ってみたいとは\n思ってるけど……"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "じゃあ、一緒に――"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "まだ行くとは\n言ってないわよ。\nそれに！"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "行く時は一人で行く。\nあんた達と一緒には\n行かないわ。"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "えっ…。"},
        { "location": "63/TALK"   , "narrator": "神楽", "text": "何でですか？\n一緒に行った方が\n楽しいのに…。"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "別に、楽しくなんか……"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "そんなこと言わんで、\nみんなで行くぞね。"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "きっと楽しいと\n思うんよ？"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "…みやびがそんなこと\n言うの、珍しいわね？"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "人の多いとこって、\nあまり好きじゃない\nはずなのに。"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "…祭りは別や。\n日本人やきね。"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "…そっか。\nみやびだって\n日本人だものね。"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "ほっ…。"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "でも、ホントお祭りは\n行くにしても\n一人で行くから。"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、あたしは\n一人で行きたいの。"},
        { "location": "86/TALK"   , "narrator": "つばめ", "text": "みんなで行った方が\n絶対楽しいですよ。"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "だから、あんたは\n卯月達と一緒に行けば\n楽しめるでしょ？"},
        { "location": "89/TALK"   , "narrator": "つばめ", "text": "せんぱいもいなきゃ、\n寂しいです…。"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "な、なにそれ？\n意味わかんない。"},
        { "location": "93/TALK"   , "narrator": "神楽", "text": "あーあ、みんなで\n浴衣着ていくお祭り\nなんて――"},
        { "location": "94/TALK"   , "narrator": "神楽", "text": "絶対に楽しいに\n決まってますのに。"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "…確かに、それは\nちょっと楽しそう\nだけど。"},
        { "location": "99/TALK"   , "narrator": "つばめ", "text": "そうですよ。"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "それに、せんぱいが\n喜ぶような作戦も――"},
        { "location": "103/TALK"  , "narrator": "神楽", "text": "ちょ！？\nつばめさん！"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "あっ！"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "…今、作戦って\n聞こえたんだけど？"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "あああ、えっと！\nそれはですね、\nその…。"},
        { "location": "111/TALK"  , "narrator": "神楽", "text": "や、屋台全店制覇\n作戦です！"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "えっ、全店制覇？"},
        { "location": "113/TALK"  , "narrator": "神楽", "text": "そうです。"},
        { "location": "114/TALK"  , "narrator": "神楽", "text": "一人では無理ですが、\n五人でなら可能だと\n思いませんか？"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり、楽しそう。"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "食べ物なんかも、\nシェアすれば\n全部行けるかも。"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "…でも。"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "…どうや？\nうちらを助けると\n思うて――"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "ガブちゃんも\n一緒に来てもらえ\nんか？"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "…そ、そうねぇ。"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "…凄く楽しそう。\nううん、絶対楽しいに\n決まってる。"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "なのに…どうして\nこんなにイライラした\n気持ちになるの？"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "別に、みんなのことが\n嫌いだから、って\nわけでもないのに…。"},
        { "location": "129/TALK"  , "narrator": "つばめ", "text": "せんぱいは、まずは\nどのお店から周りたい\nですか？"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "そ、そんなの、\nあたしの勝手\nでしょ！？"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "第一、あたしは絶対、\nあんたとなんか\n行かないから。"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "えっ…。\nわたし、ですか？"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "そうよ。\nっていうか、\n本当自覚ないのね？"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "あんたは、コネクトも\n何もしない普通の\n状態で――"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "クランを壊すような\n危ない奴なのよ？"},
        { "location": "141/TALK"  , "narrator": "神楽", "text": "ちょ、ガブちゃん。\nそれは今、関係ない\n話じゃ…。"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "大ありよ。"},
        { "location": "144/TALK"  , "narrator": "ガブリエラ", "text": "そんな危ない力を\n持ってるヤツと\n一緒にいたら――"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "警戒して、お祭りを\n楽しむことなんて\nできないわ。"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "…あ。"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "150/TALK"  , "narrator": "神楽", "text": "…が、ガブちゃん！\nいくら何でもそんな…\n酷いです！"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "さすがに、今のは\n言い過ぎやぞ？"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "つばめちゃんに\n謝りぃ。"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "な、なによ。\n正直に話しただけ\nじゃない！"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "だからって、言うて\nえいことと悪いことが\nあるやろ。"},
        { "location": "158/TALK"  , "narrator": "神楽", "text": "そうですよ。"},
        { "location": "159/TALK"  , "narrator": "神楽", "text": "それに、つばめさんは\nガブちゃんに\n対して――"},
        { "location": "160/TALK"  , "narrator": "神楽", "text": "何も悪いことして\nないのに…。"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "そ、そんなの！"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "…わかってるわよ！"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、つばめが\n悪いことするとか、\n考えられないし！"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "そんなの、\nあたしだって\nわかってる！"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "わかってるけど――"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "それでも！"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "と、とにかく！\nあたしはあんた達とは\n絶対に――"},
        { "location": "213/TALK"  , "narrator": "ガブリエラ", "text": "あ、$handle$！\nいらっしゃい！"},
        { "location": "214/TALK"  , "narrator": "ガブリエラ", "text": "前回は本当にありがと。\nお陰で助かったわ。"},
        { "location": "215/SEL"   , "narrator": "", "text": "でも今回も…"},
        { "location": "216/ACT"   , "narrator": "", "text": "でも今回も…"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "……ねぇ。"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "やっぱりつばめの件に\n関してだけは、根っこが\n深いのよね。"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "単にツンデレって\nだけじゃないってことね。"},
        { "location": "221/SEL"   , "narrator": "", "text": "リアルの本人、ツンデレって言うと否定しますよ"},
        { "location": "222/ACT"   , "narrator": "", "text": "リアルの本人、ツンデレって言うと否定しますよ"},
        { "location": "225/TALK"  , "narrator": "ガブリエラ", "text": "そりゃそうよ。\nツンデレだもん。"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ早速！\n今回も頑張って扉を\nコールしちゃうわね！"},
        { "location": "233/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x9FE番地から\n0x884番地へ。"},
        { "location": "255/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了っ♪"},
        { "location": "257/TALK"  , "narrator": "ガブリエラ", "text": "さて、今回は\n検索する必要もない\n気がするけど……。"},
        { "location": "259/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "260/TALK"  , "narrator": "ガブリエラ", "text": "………。"},
        { "location": "261/TALK"  , "narrator": "ガブリエラ", "text": "あ、あら。"},
        { "location": "262/TALK"  , "narrator": "ガブリエラ", "text": "へぇ、そうなのね。"},
        { "location": "263/SEL"   , "narrator": "", "text": "なになに？"},
        { "location": "264/ACT"   , "narrator": "", "text": "なになに？"},
        { "location": "267/TALK"  , "narrator": "ガブリエラ", "text": "ごめんなさい、\nあたしの思い込み\nだったかも。"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "今回の悩みの原因は\nつばめじゃないみたいね。"},
        { "location": "269/SEL"   , "narrator": "", "text": "そうなの？"},
        { "location": "270/ACT"   , "narrator": "", "text": "そうなの？"},
        { "location": "272/TALK"  , "narrator": "ガブリエラ", "text": "うん。\n本人も全然\n気づいてないけど。"},
        { "location": "273/TALK"  , "narrator": "ガブリエラ", "text": "多分クランが扉を塞いで\n真意を分からせないように\nしてるのね。"},
        { "location": "274/SEL"   , "narrator": "", "text": "して、その真意とは？"},
        { "location": "275/ACT"   , "narrator": "", "text": "して、その真意とは？"},
        { "location": "277/TALK"  , "narrator": "ガブリエラ", "text": "その真意は、\n他のトライナリーメンバー\n全員に対する憤りね。"},
        { "location": "278/TALK"  , "narrator": "ガブリエラ", "text": "ここ最近フェノメノンも\n増えてるし、つばめの\n謎もわかってない。"},
        { "location": "279/TALK"  , "narrator": "ガブリエラ", "text": "そんな中で、呑気に縁日に\n行くなんて信じられない、\nっていう気持ちみたいよ？"},
        { "location": "280/SEL"   , "narrator": "", "text": "流石ガブちゃん、トライナリーの良心！"},
        { "location": "281/SEL"   , "narrator": "", "text": "そこまで気を張らなくても……"},
        { "location": "282/ACT"   , "narrator": "", "text": "流石ガブちゃん、トライナリーの良心！"},
        { "location": "284/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？\nえっと、\n褒めてくれてるの？"},
        { "location": "285/SEL"   , "narrator": "", "text": "照れてる？"},
        { "location": "286/ACT"   , "narrator": "", "text": "照れてる？"},
        { "location": "288/TALK"  , "narrator": "ガブリエラ", "text": "そ、そういうわけじゃ\nないけど……"},
        { "location": "289/TALK"  , "narrator": "ガブリエラ", "text": "でも、あまりそう\n言ってくれる人って\nいないから――"},
        { "location": "290/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、ちょっとだけ\n嬉しいって気持ちも、\n無いことはないわよ？"},
        { "location": "291/TALK"  , "narrator": "ガブリエラ", "text": "ただ、今回に関しては\nちょっと気にしすぎって\n気持ちがあるのよね。"},
        { "location": "292/ACT"   , "narrator": "", "text": "そこまで気を張らなくても……"},
        { "location": "293/TALK"  , "narrator": "ガブリエラ", "text": "そうよね。\nあたしも今回は\n同意するわ。"},
        { "location": "295/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり戦場生まれだから\nまだこの辺の感覚に、内心\n途惑ってるのよね。"},
        { "location": "296/TALK"  , "narrator": "ガブリエラ", "text": "リラックスするのと\n油断するのは全然違う。"},
        { "location": "297/TALK"  , "narrator": "ガブリエラ", "text": "それをみんな\n分かってないみたいで、\nすごく心配なのよ。"},
        { "location": "298/TALK"  , "narrator": "ガブリエラ", "text": "とはいっても、\n今回はちょっと\n警戒しすぎ。"},
        { "location": "299/TALK"  , "narrator": "ガブリエラ", "text": "それに、その事を\nつばめに対する気持ちと\n勘違いしてる！"},
        { "location": "300/TALK"  , "narrator": "ガブリエラ", "text": "少なくとも\nそこだけは、あたしに\n気づいてもらわなくちゃ。"},
        { "location": "301/SEL"   , "narrator": "", "text": "本当につばめが好きなんだね"},
        { "location": "302/ACT"   , "narrator": "", "text": "本当につばめが好きなんだね"},
        { "location": "304/TALK"  , "narrator": "ガブリエラ", "text": "ち、違うのよ！\n単に勘違いしてるのが\n嫌なだけなの！"},
        { "location": "306/TALK"  , "narrator": "ガブリエラ", "text": "とにかく、今回も\nあたしのこと\n宜しくお願いね。"},
        { "location": "307/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！"},
        { "location": "18/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月2日　4:17 PM</color>\nとある平日の放課後、神楽坂トライナリーでのバイトの最中のこと。"},
        { "location": "181/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"}
    ]
}
