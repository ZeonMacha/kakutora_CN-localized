    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "つばめさんご指名です"},
        { "location": "25/TALK"   , "narrator": "つばめ", "text": "クランもみんな\n退避させたし…。"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "後は例の扉から\n駐車場に行って\nみんなと合流すれば…。"},
        { "location": "28/TALK"   , "narrator": "つばめ", "text": "…！"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "別の通路を\n使わなきゃ…！"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "……。"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "…！"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "こっちもダメ…！"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "他に使えそうな\n通路って…。"},
        { "location": "43/TALK"   , "narrator": "つばめ", "text": "あ、あっちなら…。"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "……。"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "…！"},
        { "location": "46/TALK"   , "narrator": "通常攻撃隊Ａ", "text": "１階から調べろ"},
        { "location": "47/TALK"   , "narrator": "通常攻撃隊Ｂ", "text": "ああ、わかっている"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "…！"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "逃げなきゃ…！"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "はあ…はあ…。"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "どうしよう$handle1$"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "ぁたし慌てて階段上がっちゃった"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "アーヤさん達と合流したいのに"},
        { "location": "81/SEL"    , "narrator": "", "text": "去るのを待とう"},
        { "location": "82/SEL"    , "narrator": "", "text": "どうにかなるさ"},
        { "location": "83/SEL"    , "narrator": "", "text": "どうすればいいんだろうね"},
        { "location": "84/ACT"    , "narrator": "", "text": "去るのを待とう"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "え"},
        { "location": "86/TALK"   , "narrator": "つばめ", "text": "そんなの"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "見つかっちゃうょ"},
        { "location": "88/ACT"    , "narrator": "", "text": "どうにかなるさ"},
        { "location": "89/TALK"   , "narrator": "つばめ", "text": "その前に"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "どうにもならなぃょ"},
        { "location": "91/ACT"    , "narrator": "", "text": "どうすればいいんだろうね"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "わかんないから"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "聞いてるんだょ"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "失敗しちゃった"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "ぁたし"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "こんなところで"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "みんな待ってるし"},
        { "location": "99/TALK"   , "narrator": "つばめ", "text": "足手まとい"},
        { "location": "102/SEL"   , "narrator": "", "text": "そうだな"},
        { "location": "103/ACT"   , "narrator": "", "text": "そうだな"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "107/SEL"   , "narrator": "", "text": "ひとつ"},
        { "location": "108/ACT"   , "narrator": "", "text": "ひとつ"},
        { "location": "109/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "112/SEL"   , "narrator": "", "text": "提案がある"},
        { "location": "113/ACT"   , "narrator": "", "text": "提案がある"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "何？"},
        { "location": "117/SEL"   , "narrator": "", "text": "悪いようにはしない"},
        { "location": "118/ACT"   , "narrator": "", "text": "悪いようにはしない"},
        { "location": "119/TALK"  , "narrator": "つばめ", "text": "はい"},
        { "location": "122/SEL"   , "narrator": "", "text": "だって$me$はつばめが好きだから"},
        { "location": "123/ACT"   , "narrator": "", "text": "だって$me$はつばめが好きだから"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "そんなの"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "知ってるよ"},
        { "location": "128/SEL"   , "narrator": "", "text": "聞いてくれる？"},
        { "location": "129/ACT"   , "narrator": "", "text": "聞いてくれる？"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "聞くよ？"},
        { "location": "133/SEL"   , "narrator": "", "text": "絶対だね？"},
        { "location": "134/ACT"   , "narrator": "", "text": "絶対だね？"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "もちろん"},
        { "location": "139/SEL"   , "narrator": "", "text": "掃除用具入れに隠れよう"},
        { "location": "140/SEL"   , "narrator": "", "text": "今すぐ劇場から逃げて！"},
        { "location": "141/ACT"   , "narrator": "", "text": "掃除用具入れに隠れよう"},
        { "location": "142/ACT"   , "narrator": "", "text": "掃除用具入れに隠れよう"},
        { "location": "144/SEL"   , "narrator": "", "text": "あれ！？"},
        { "location": "145/ACT"   , "narrator": "", "text": "早く隠れて！"},
        { "location": "207/TALK"  , "narrator": "つばめ", "text": "　"},
        { "location": "226/TALK"  , "narrator": "カレン", "text": "$handle$さん！\n大変です！！"},
        { "location": "227/SEL"   , "narrator": "", "text": "どうしたカレン"},
        { "location": "228/SEL"   , "narrator": "", "text": "洗脳されてるフリしなくていいの？"},
        { "location": "229/ACT"   , "narrator": "", "text": "どうしたカレン"},
        { "location": "230/TALK"  , "narrator": "カレン", "text": "契約主の方が\nいなくなっちゃいました！"},
        { "location": "231/TALK"  , "narrator": "カレン", "text": "ギアスも無くなったので、\n洗脳されてるフリしなくて\nよくなりました！"},
        { "location": "233/ACT"   , "narrator": "", "text": "洗脳されてるフリしなくていいの？"},
        { "location": "234/TALK"  , "narrator": "カレン", "text": "しなくても良く\nなっちゃいました！"},
        { "location": "235/TALK"  , "narrator": "カレン", "text": "契約主の方がいなく\nなっちゃって、ギアスが\n外れたんです！"},
        { "location": "236/TALK"  , "narrator": "カレン", "text": "もう洗脳されてるフリ\nしなくても消される心配が\nなくなりました！"},
        { "location": "238/TALK"  , "narrator": "カレン", "text": "一体どうなっちゃったん\nでしょうか！"},
        { "location": "240/SEL"   , "narrator": "", "text": "千羽鶴が追い出されたのと関係あるんだろうか"},
        { "location": "241/ACT"   , "narrator": "", "text": "千羽鶴が追い出されたのと関係あるんだろうか"},
        { "location": "244/SEL"   , "narrator": "", "text": "千羽鶴が追い出されたんだよ"},
        { "location": "245/ACT"   , "narrator": "", "text": "千羽鶴が追い出されたんだよ"},
        { "location": "248/TALK"  , "narrator": "カレン", "text": "千羽鶴さん？\n誰ですか？"},
        { "location": "249/TALK"  , "narrator": "つばめの新司書　", "text": "わたしとあなたの\n契約主ですよ。"},
        { "location": "251/TALK"  , "narrator": "カレン", "text": "え！？"},
        { "location": "269/TALK"  , "narrator": "カレン", "text": "ああっ！\nあなたは！"},
        { "location": "270/SEL"   , "narrator": "", "text": "新しい司書さん！？"},
        { "location": "271/ACT"   , "narrator": "", "text": "新しい司書さん！？"},
        { "location": "274/TALK"  , "narrator": "つばめの新司書　", "text": "嘘だったんですね。\n洗脳されてるフリを\nしていただけなんですね。"},
        { "location": "275/TALK"  , "narrator": "カレン", "text": "イイエ、ワタシハ\nセンノウサレテイマス"},
        { "location": "276/TALK"  , "narrator": "つばめの新司書　", "text": "……。\nもうバレてるから、\nフリしなくてもいいです。"},
        { "location": "277/TALK"  , "narrator": "カレン", "text": "え？　ほんとですか？\nはぁ、良かったです。"},
        { "location": "278/TALK"  , "narrator": "つばめの新司書　", "text": "は？"},
        { "location": "279/TALK"  , "narrator": "カレン", "text": "洗脳されてるフリするの、\n疲れるんですよね。"},
        { "location": "280/TALK"  , "narrator": "つばめの新司書　", "text": "そこまで露骨に言われると\n■■したくなりますね。"},
        { "location": "282/SEL"   , "narrator": "", "text": "そんなことよりWAVEが何か変じゃない？"},
        { "location": "283/SEL"   , "narrator": "", "text": "そんなことよりどういう状況なの！？"},
        { "location": "284/SEL"   , "narrator": "", "text": "■■しちゃえ！！"},
        { "location": "285/ACT"   , "narrator": "", "text": "そんなことよりWAVEが何か変じゃない？"},
        { "location": "287/ACT"   , "narrator": "", "text": "そんなことよりどういう状況なの！？"},
        { "location": "289/ACT"   , "narrator": "", "text": "■■しちゃえ！！"},
        { "location": "293/SEL"   , "narrator": "", "text": "そんなことよりどういう状況なの！？"},
        { "location": "294/SEL"   , "narrator": "", "text": "■■しちゃえ！！"},
        { "location": "295/ACT"   , "narrator": "", "text": "そんなことよりどういう状況なの！？"},
        { "location": "297/ACT"   , "narrator": "", "text": "■■しちゃえ！！"},
        { "location": "303/TALK"  , "narrator": "つばめの新司書　", "text": "よくわかりませんが、\nどうヘンなのでしょうか。"},
        { "location": "304/SEL"   , "narrator": "", "text": "違う文章になって伝わる"},
        { "location": "305/ACT"   , "narrator": "", "text": "違う文章になって伝わる"},
        { "location": "307/TALK"  , "narrator": "つばめの新司書　", "text": "それはわたしでは\nありませんね。"},
        { "location": "308/TALK"  , "narrator": "つばめの新司書　", "text": "なにせ、わたしに\nできることといえば――"},
        { "location": "309/TALK"  , "narrator": "つばめの新司書　", "text": "「つばめちゃん愛してる」\n「新司書ちゃんすき」\n「カレン爆発しろ」"},
        { "location": "310/TALK"  , "narrator": "つばめの新司書　", "text": "…のような選択肢の\n追加だけですから。"},
        { "location": "311/TALK"  , "narrator": "カレン", "text": "なんでわたしが\n爆発するんですか！"},
        { "location": "313/TALK"  , "narrator": "つばめの新司書　", "text": "あなたは爆発する宿命を\n背負っているからです。"},
        { "location": "314/TALK"  , "narrator": "つばめの新司書　", "text": "そんなことより。"},
        { "location": "318/TALK"  , "narrator": "つばめの新司書　", "text": "残念ですが、事態は\n$handle$さんが\n思うより遙かに深刻です。"},
        { "location": "326/TALK"  , "narrator": "つばめの新司書　", "text": "えっ！？"},
        { "location": "327/TALK"  , "narrator": "つばめの新司書　", "text": "$handle$さん、\nちょっと\n大胆すぎませんか…？"},
        { "location": "328/SEL"   , "narrator": "", "text": "は！？"},
        { "location": "329/ACT"   , "narrator": "", "text": "は！？"},
        { "location": "331/TALK"  , "narrator": "カレン", "text": "そ、そうですよ！\nとっても大胆です！！"},
        { "location": "332/TALK"  , "narrator": "つばめの新司書　", "text": "まあ、やれって言うなら\nやりますけど……。"},
        { "location": "333/TALK"  , "narrator": "つばめの新司書　", "text": "その時はゲートから\n$handle$さんを\n追い出した上でやります！"},
        { "location": "334/TALK"  , "narrator": "カレン", "text": "わ、わたしも\nそれ賛成です！！"},
        { "location": "335/SEL"   , "narrator": "", "text": "意味が分かりません"},
        { "location": "336/SEL"   , "narrator": "", "text": "覗き見しちゃうぞ～"},
        { "location": "337/ACT"   , "narrator": "", "text": "意味が分かりません"},
        { "location": "338/TALK"  , "narrator": "カレン", "text": "そ、それはわたしの\n必殺セリフです！"},
        { "location": "339/ACT"   , "narrator": "", "text": "覗き見しちゃうぞ～"},
        { "location": "340/TALK"  , "narrator": "つばめの新司書　", "text": "そんなエロオヤジみたいな\n$handle$さんには\nどん引きです。"},
        { "location": "345/TALK"  , "narrator": "つばめの新司書　", "text": "そんなことより。"},
        { "location": "350/TALK"  , "narrator": "つばめの新司書　", "text": "わたしとカレンは、\nもはや戦うしかない\n状況になりました。"},
        { "location": "351/TALK"  , "narrator": "カレン", "text": "……。"},
        { "location": "352/SEL"   , "narrator": "", "text": "ちょっと、穏便に！！"},
        { "location": "353/ACT"   , "narrator": "", "text": "ちょっと、穏便に！！"},
        { "location": "355/TALK"  , "narrator": "つばめの新司書　", "text": "いいえ。\nこればかりは無理です。"},
        { "location": "356/TALK"  , "narrator": "カレン", "text": "はい。\nこればかりは\n無理なんです。"},
        { "location": "357/SEL"   , "narrator": "", "text": "いや、話し合うとか、他に解決方法あるよね？"},
        { "location": "358/ACT"   , "narrator": "", "text": "いや、話し合うとか、他に解決方法あるよね？"},
        { "location": "360/TALK"  , "narrator": "カレン", "text": "いいえ、できません。"},
        { "location": "361/TALK"  , "narrator": "つばめの新司書　", "text": "さあ、\n早く始めましょう。"},
        { "location": "362/TALK"  , "narrator": "カレン", "text": "そうですね。\n早く決着つけたいです。"},
        { "location": "363/TALK"  , "narrator": "つばめの新司書　", "text": "$handle$さんと\nイチャラブできるのは\nどっちなのか！"},
        { "location": "364/SEL"   , "narrator": "", "text": "え、えええ！？"},
        { "location": "365/ACT"   , "narrator": "", "text": "え、えええ！？"},
        { "location": "367/TALK"  , "narrator": "カレン", "text": "もちろんそれは\nわたしですよ！！"},
        { "location": "369/TALK"  , "narrator": "カレン", "text": "…ですよね？\n$handle$さん？"},
        { "location": "370/SEL"   , "narrator": "", "text": "そっちの闘いかい！！"},
        { "location": "371/ACT"   , "narrator": "", "text": "そっちの闘いかい！！"},
        { "location": "373/TALK"  , "narrator": "つばめの新司書　", "text": "早速色目ですか。\nわたしがジト目しか\nできないのをいいことに。"},
        { "location": "375/TALK"  , "narrator": "カレン", "text": "1xさんだって、\nたまに色目してるじゃ\nないですか！"},
        { "location": "376/TALK"  , "narrator": "つばめの新司書　", "text": "……あれはとっても\nパワーがいるんです。\nそんなことより――"},
        { "location": "377/TALK"  , "narrator": "つばめの新司書　", "text": "$handle$さんは\n既にわたしに\nラブラブです。"},
        { "location": "378/TALK"  , "narrator": "つばめの新司書　", "text": "高度な精神世界を掌握し、\n外部とのコネクションも\n濃厚なわたしこそ大勝利。"},
        { "location": "379/TALK"  , "narrator": "カレン", "text": "そんなことないですよ！\nわたしとの方が３倍は\n付き合いが長いです！"},
        { "location": "380/TALK"  , "narrator": "カレン", "text": "何より名前を教えちゃって\nますから、既に連れ添って\nいるも同然です！"},
        { "location": "381/SEL"   , "narrator": "", "text": "いや、それこそ同じつばめなんだから、争う必要は無いのでは？"},
        { "location": "382/ACT"   , "narrator": "", "text": "いや、それこそ同じつばめなんだから、争う必要は無いのでは？"},
        { "location": "385/TALK"  , "narrator": "つばめの新司書　", "text": "何を寝ぼけたこと\n言ってるんですか！\nこの■■野郎！"},
        { "location": "387/TALK"  , "narrator": "カレン", "text": "そうですよ！\n$handle$さん！"},
        { "location": "388/TALK"  , "narrator": "カレン", "text": "わたしなのか、\n百鶴さんなのか！\nそれが大事なんです！"},
        { "location": "390/TALK"  , "narrator": "百鶴　", "text": "あ、ちょっと。"},
        { "location": "392/TALK"  , "narrator": "カレン", "text": "はい？"},
        { "location": "393/TALK"  , "narrator": "百鶴　", "text": "とんでもないこと、\n言いましたよね今。"},
        { "location": "394/TALK"  , "narrator": "カレン", "text": "えっと、\nよくわからないです。"},
        { "location": "395/SEL"   , "narrator": "", "text": "もしかしてカレンって天然腹黒系？"},
        { "location": "396/SEL"   , "narrator": "", "text": "百鶴って何て読むの？"},
        { "location": "397/SEL"   , "narrator": "", "text": "えっと……対決は？"},
        { "location": "398/ACT"   , "narrator": "", "text": "もしかしてカレンって天然腹黒系？"},
        { "location": "400/TALK"  , "narrator": "カレン", "text": "ええっ！？\nちょっと意味が\n分からないんですけど…。"},
        { "location": "401/ACT"   , "narrator": "", "text": "百鶴って何て読むの？"},
        { "location": "403/TALK"  , "narrator": "百鶴　", "text": "教えません。"},
        { "location": "404/TALK"  , "narrator": "百鶴　", "text": "発音できなければ\nまだギリギリセーフ\nですから。"},
        { "location": "405/ACT"   , "narrator": "", "text": "えっと……対決は？"},
        { "location": "407/TALK"  , "narrator": "百鶴　", "text": "おっと、\nその通りです！"},
        { "location": "410/TALK"  , "narrator": "百鶴　", "text": "話を戻すと、\n$handle$さんの\n選択は重要です。"},
        { "location": "412/TALK"  , "narrator": "カレン", "text": "そうです！\nわたしを選べば、\n現実のわたしは――"},
        { "location": "413/TALK"  , "narrator": "カレン", "text": "毎日旦那様のことを考え\nつつ、時にお鍋焦がし\nちゃいそうな若妻に！"},
        { "location": "414/TALK"  , "narrator": "百鶴　", "text": "わたしを選べば、\n現実のわたしは――"},
        { "location": "416/TALK"  , "narrator": "百鶴　", "text": "包丁で指切っちゃいそうに\nなりながらも毎日健気に\n帰りを待つ若妻に。"},
        { "location": "419/TALK"  , "narrator": "カレン", "text": "それぞれ\n変わっていくんです！"},
        { "location": "420/SEL"   , "narrator": "", "text": "何か違うんでしょうか…"},
        { "location": "421/ACT"   , "narrator": "", "text": "何か違うんでしょうか…"},
        { "location": "423/TALK"  , "narrator": "カレン", "text": "……。"},
        { "location": "424/TALK"  , "narrator": "百鶴　", "text": "この違いが\nわからないなんて\nまだまだですね。"},
        { "location": "425/SEL"   , "narrator": "", "text": "まだまだで結構です…"},
        { "location": "426/SEL"   , "narrator": "", "text": "それより今回退治するクランを教えてよ"},
        { "location": "427/ACT"   , "narrator": "", "text": "まだまだで結構です…"},
        { "location": "428/TALK"  , "narrator": "百鶴　", "text": "向上心がありませんね。"},
        { "location": "429/SEL"   , "narrator": "", "text": "無くていいです…"},
        { "location": "430/ACT"   , "narrator": "", "text": "無くていいです…"},
        { "location": "432/TALK"  , "narrator": "カレン", "text": "そういえば、\n$handle$さんは\n今回はどうしたんですか？"},
        { "location": "433/SEL"   , "narrator": "", "text": "いつも通りクランを退治しに来たと思うんですが"},
        { "location": "434/ACT"   , "narrator": "", "text": "いつも通りクランを退治しに来たと思うんですが"},
        { "location": "436/TALK"  , "narrator": "カレン", "text": "あ、なるほどです。\nそりゃそうですよね…。"},
        { "location": "437/ACT"   , "narrator": "", "text": "それより今回退治するクランを教えてよ"},
        { "location": "438/TALK"  , "narrator": "カレン", "text": "ああっ！\nそうですよね！\nごめんなさい…。"},
        { "location": "440/TALK"  , "narrator": "百鶴　", "text": "まったく、\nこれだから0xは……。"},
        { "location": "442/TALK"  , "narrator": "カレン", "text": "百鶴さんだって\n同じですよ！"},
        { "location": "443/TALK"  , "narrator": "百鶴　", "text": "刷り込まれるから\nあまり名前で\n呼ばないでください。"},
        { "location": "446/TALK"  , "narrator": "カレン", "text": "そ、それじゃ早速\n扉を回しますね！"},
        { "location": "457/TALK"  , "narrator": "カレン", "text": "オープンプロセ――"},
        { "location": "458/TALK"  , "narrator": "百鶴　", "text": "ダメです。今送られて\nきている情報は、契約主\nからのものではないです。"},
        { "location": "459/TALK"  , "narrator": "カレン", "text": "あ、あれ？"},
        { "location": "460/TALK"  , "narrator": "百鶴　", "text": "どうしたんですか？"},
        { "location": "461/TALK"  , "narrator": "カレン", "text": "情報がありません…。"},
        { "location": "462/TALK"  , "narrator": "百鶴　", "text": "……なるほど。\n確かにありませんね。"},
        { "location": "463/TALK"  , "narrator": "カレン", "text": "これは\n困りましたね……。"},
        { "location": "464/TALK"  , "narrator": "百鶴　", "text": "こんな時こそ、\n契約主の映し鏡である\nわたしが判断します。"},
        { "location": "465/TALK"  , "narrator": "百鶴　", "text": "0x501番地から\n0x021番地へ。"},
        { "location": "468/TALK"  , "narrator": "カレン", "text": "ちょ、ちょっと勝手に！\nしかも逆さまに\n回さないでください！"},
        { "location": "471/TALK"  , "narrator": "百鶴　", "text": "情報が落ちてこなくても\nわたしにはソウルで\nわかりますから。"},
        { "location": "474/TALK"  , "narrator": "カレン", "text": "やめてください！"},
        { "location": "475/SEL"   , "narrator": "", "text": "ちょ、ちょっと待って！"},
        { "location": "476/ACT"   , "narrator": "", "text": "ちょ、ちょっと待って！"},
        { "location": "482/TALK"  , "narrator": "百鶴　", "text": "どうしましたか？"},
        { "location": "483/SEL"   , "narrator": "", "text": "情報は謎のおねえさんが送るって言ってたから、来てないのはおかしい"},
        { "location": "484/ACT"   , "narrator": "", "text": "情報は謎のおねえさんが送るって言ってたから、来てないのはおかしい"},
        { "location": "486/TALK"  , "narrator": "百鶴　", "text": "なるほど、やはり我々の\n契約主からの情報では\nありませんでしたね。"},
        { "location": "487/TALK"  , "narrator": "カレン", "text": "で、でも、それが\n届いていないって\nことは――"},
        { "location": "496/TALK"  , "narrator": "カレン", "text": "え！？"},
        { "location": "497/TALK"  , "narrator": "百鶴　", "text": "え"},
        { "location": "24/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月3日　 7:31 PM</color>\nストライキ開始当日、神楽坂トライナリーにて"},
        { "location": "172/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "174/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "176/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "178/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "180/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
