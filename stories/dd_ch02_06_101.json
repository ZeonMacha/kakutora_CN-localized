{
    "dir": "chap06/daydra/dd_ch02_06_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "6202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "出陣【Case：アーヤ】＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "出陣【アーヤから見たCase】"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "逢瀬さん？"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "は、はいっ！？"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "そんなに緊張しないでも\n平気よ。"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "す、すみません…。\nわたし、こういうのって\n初めてで…。"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "…まあ、緊張するのは\n当然よね。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "最年長のリーダーとして、\n私が支えてあげないと\nダメよね。"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "ここを抜けるまで\n少し時間ありそうだから、\n今のうちに説明するわ。"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "今私達の歩いている\nこの場所は、現実と\n非現実との――"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "…見た感じ、\n逢瀬さんって\n普通の子よね？"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "少なくとも、命がけの\n戦いに参加するような\n子には思えないし。"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "…本当に、こんな子を\n戦闘に連れ出して\n大丈夫なのかしら？"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…ねえ、アーヤ。\nやっぱあたし達だけで\n行った方が良くない？"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "何もわかってない子を\n連れてったって、\n足手まといになるだけよ。"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "ちょっと、ギャヴィ。\nそういう言い方は…。"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "事実を言ったまでよ。"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "い、いいんです。\n勉強不足なわたしが\n悪いんだし…。"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "ギャヴィ、逢瀬さんが\n気に入らないのかしら？"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "だとすると、ちょっと\n困ったことになるわね。"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "まったく…まあ、話を\n続けるとね――"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "なんで私達だけが\n洗脳されないのか――"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "それは今もって研究中。\n解明されていないの。"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "――とりあえず、説明は\nこんなところかしら。\nどう、わかった？"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "え？　あ、は、はい！\nありがとうございます！"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "…あまり頭に入って\nないみたい。"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "まあ、初日だものね。\n緊張するな、っていうのが\n無理な話か…。"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "…そういえば――"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "逢瀬さんのあの力の\nことも考えないと\nいけないわね。"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "あの力が何なのか。\nそれがわからない\nことには――"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "ギャヴィだけじゃ\nなくて、私も怖くて\n堪らないし。"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "あ、あの、その…。"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "大丈夫ですよね？\nだって、皆さんとっても\n強いし…。"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "…だといいけど。"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "…やっぱり、姉に\n連絡するべきかしら？"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "あの人なら、きっと\nすぐに答えを出して\nくれると思うし。"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "ううん。\nやっぱり無理。"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "あの人に連絡なんて、\n絶対に嫌よ！"},
        { "location": "123/SEL"   , "narrator": "", "text": "何でお姉さんのこと、そんな嫌ってるの？"},
        { "location": "124/ACT"   , "narrator": "", "text": "何でお姉さんのこと、そんな嫌ってるの？"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "……"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "…何、今の？"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "私、姉のこと言葉に\n出してなかったのに、\nどうして？"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "まさか、私の心を\n読んでる！？"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "ううん、偶然よ。\n心を読んだりなんて\nできるはずないもの。"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "バカなこと考えて\nないで、少し落ち着か\nないと…。"},
        { "location": "193/TALK"  , "narrator": "アーヤ", "text": "ようこそ[ココロゲート]へ。\nいつも悪いわね。"},
        { "location": "194/TALK"  , "narrator": "アーヤ", "text": "さて、今回の\n【問題の扉】は…っと。"},
        { "location": "201/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0x2FC番地から\n0xE5E番地へ。"},
        { "location": "216/TALK"  , "narrator": "アーヤ", "text": "シーク完了。"},
        { "location": "218/TALK"  , "narrator": "アーヤ", "text": "それで？\n今回はどんな理由で…。"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "…。"},
        { "location": "220/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "221/TALK"  , "narrator": "アーヤ", "text": "ああ、姉のこと……。"},
        { "location": "222/SEL"   , "narrator": "", "text": "アーヤのお姉さんのこと、教えてくれるの？"},
        { "location": "223/ACT"   , "narrator": "", "text": "アーヤのお姉さんのこと、教えてくれるの？"},
        { "location": "225/TALK"  , "narrator": "アーヤ", "text": "えーっと……"},
        { "location": "226/TALK"  , "narrator": "アーヤ", "text": "残念だけど、ココロの\n司書という立場では、\n教えられないのよね。"},
        { "location": "227/TALK"  , "narrator": "アーヤ", "text": "１つだけ言えることは、\n私は姉のことをすごく\n恨んでるってこと。"},
        { "location": "228/TALK"  , "narrator": "アーヤ", "text": "そして今、私はその事で\nまた色々思い出して、\n怒りが大きくなってる。"},
        { "location": "229/TALK"  , "narrator": "アーヤ", "text": "まずはその怒りを鎮め\nないと。今は冷静な判断も\nできない状態だから。"},
        { "location": "230/TALK"  , "narrator": "アーヤ", "text": "お願い。\n協力してくれる？"},
        { "location": "231/TALK"  , "narrator": "アーヤ", "text": "姉と何があったかは、\nきっと近いうちに\n知る機会があると思う。"},
        { "location": "232/TALK"  , "narrator": "アーヤ", "text": "だから今回は、\n何も聞かずに國政綾水に\n協力してください。"},
        { "location": "233/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "234/SEL"   , "narrator": "", "text": "遠慮します"},
        { "location": "235/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "236/TALK"  , "narrator": "アーヤ", "text": "ありがとう！"},
        { "location": "237/TALK"  , "narrator": "アーヤ", "text": "それじゃ、この扉のこと\nよろしくお願いね。"},
        { "location": "239/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！"},
        { "location": "246/ACT"   , "narrator": "", "text": "遠慮します"},
        { "location": "247/TALK"  , "narrator": "アーヤ", "text": "そう、残念。"},
        { "location": "248/TALK"  , "narrator": "アーヤ", "text": "まあでも、無理強いは\nできないものね。"},
        { "location": "249/TALK"  , "narrator": "アーヤ", "text": "また気が向いたら\nつき合ってもらえると\n嬉しいかな。"},
        { "location": "45/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月9日　1:45 PM</color>\nWAVE戦フェノメノン内部へ向かう途中、不確定量子の繭の中にて。"},
        { "location": "158/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
