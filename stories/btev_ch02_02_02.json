{
    "dir": "chap02/battle/btev_ch02_02_02.js",
    "type": "",
    "info": {
        "story_id": "22003",
        "cid": "",
        "title": "003 ココロスフィアストーリー【Lv01】",
        "sub_title": "己の敵は己＜帰結＞"
    },
    "entry":
    [
        { "location": "316/SCENARIO", "narrator": "", "text": "バトル終了"},
        { "location": "327/TALK"    , "narrator": "潜在アーヤ", "text": "あーあ、\nやられちゃったわね。"},
        { "location": "328/TALK"    , "narrator": "表層アーヤ", "text": "当然よ。\n任務の遂行は、何が\nあっても絶対だもの。"},
        { "location": "329/TALK"    , "narrator": "潜在アーヤ", "text": "…そうね。\nま、それが私か。"},
        { "location": "330/TALK"    , "narrator": "潜在アーヤ", "text": "ねえ、最後に１つ\nお願いがあるんだけど、\nいいかしら？"},
        { "location": "331/TALK"    , "narrator": "表層アーヤ", "text": "なに？"},
        { "location": "332/TALK"    , "narrator": "潜在アーヤ", "text": "$handle$さんと\n二人きりで\nお茶したいのだけど。"},
        { "location": "333/TALK"    , "narrator": "表層アーヤ", "text": "貴方、\nまだそんな力が…"},
        { "location": "334/TALK"    , "narrator": "潜在アーヤ", "text": "無いわよ。\nもう間もなく消えるわ。"},
        { "location": "335/TALK"    , "narrator": "潜在アーヤ", "text": "でも、貴方が私を\n打ち負かしたのが\n貴方の想いの力なら―"},
        { "location": "336/TALK"    , "narrator": "潜在アーヤ", "text": "私が\n$handle$さんと\n話すまで消えないのも、"},
        { "location": "337/TALK"    , "narrator": "潜在アーヤ", "text": "やっぱり想いの力よ。"},
        { "location": "338/TALK"    , "narrator": "表層アーヤ", "text": "…でも……"},
        { "location": "339/TALK"    , "narrator": "潜在アーヤ", "text": "貴方の正義感は\n私を形成する重要な\n要素だとは思う。"},
        { "location": "340/TALK"    , "narrator": "潜在アーヤ", "text": "でも、私のような、\n他の色を持った自分も\n大切にしてよ。"},
        { "location": "341/TALK"    , "narrator": "表層アーヤ", "text": "……。"},
        { "location": "342/TALK"    , "narrator": "表層アーヤ", "text": "……ええ。\n分かったわ。"},
        { "location": "344/TALK"    , "narrator": "潜在アーヤ", "text": "ふふ、ありがと。"},
        { "location": "346/TALK"    , "narrator": "潜在アーヤ", "text": "$handle$さん。"},
        { "location": "347/TALK"    , "narrator": "潜在アーヤ", "text": "選択権が無くて申し訳\n無いけど、ちょっと\nつき合ってくださいな。"},
        { "location": "349/TALK"    , "narrator": "表層アーヤ", "text": "くっ……\n何て力なの？"},
        { "location": "350/TALK"    , "narrator": "潜在アーヤ", "text": "どう？　　　　"},
        { "location": "351/TALK"    , "narrator": "潜在アーヤ", "text": "それだけ私の総体としては\n個を大事にしたいって\n思ってるってことよ。"},
        { "location": "352/TALK"    , "narrator": "表層アーヤ", "text": "……そう。"},
        { "location": "354/TALK"    , "narrator": "表層アーヤ", "text": "まあいいわ。\n何を言おうとも、\n負けは負け。"},
        { "location": "355/TALK"    , "narrator": "表層アーヤ", "text": "私はもう、すぐに\n消えてしまう\n身なのだから。"},
        { "location": "356/TALK"    , "narrator": "表層アーヤ", "text": "でも、これだけは\n覚えておいて欲しい。"},
        { "location": "357/TALK"    , "narrator": "表層アーヤ", "text": "私は一人の女性である\n以前に、日本の未来を\n託されている存在。"},
        { "location": "358/TALK"    , "narrator": "表層アーヤ", "text": "普通の女性とは、\nそこが絶対的に\n違うところなの。"},
        { "location": "359/TALK"    , "narrator": "表層アーヤ", "text": "請け負った以上は、\n普通の生活なんて\nできないのよ。"},
        { "location": "360/TALK"    , "narrator": "潜在アーヤ", "text": "わかってるわよ。\nバランスが大事。"},
        { "location": "362/TALK"    , "narrator": "表層アーヤ", "text": "$handle$さん。\n貴方のことは信じてます。"},
        { "location": "363/TALK"    , "narrator": "表層アーヤ", "text": "私が行きすぎたときは\nちゃんと止めてあげて\nくださいね。"},
        { "location": "377/TALK"    , "narrator": "潜在アーヤ", "text": "ふふ。\n今回は協力してくれて\nありがと。"},
        { "location": "378/TALK"    , "narrator": "潜在アーヤ", "text": "やっと二人きりに\nなれたわね。"},
        { "location": "380/TALK"    , "narrator": "潜在アーヤ", "text": "ね！\nちょっと私に\nつき合ってくれない？"},
        { "location": "381/TALK"    , "narrator": "潜在アーヤ", "text": "私のこと、\nもっと色々\n知って欲しいから！"},
        { "location": "382/TALK"    , "narrator": "潜在アーヤ", "text": "ね？　いいでしょ？"},
        { "location": "383/SEL"     , "narrator": "（選択肢）", "text": "もちろん"},
        { "location": "384/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "386/TALK"    , "narrator": "潜在アーヤ", "text": "ありがと！"},
        { "location": "387/TALK"    , "narrator": "潜在アーヤ", "text": "それじゃ、ちょっとだけ\n昔の世界に移動するわね。"},
        { "location": "388/TALK"    , "narrator": "潜在アーヤ", "text": "私がどんな気持ちで\n学生時代を過ごしてたか\n見せてあげる。"},
        { "location": "400/DIALOG"  , "narrator": "", "text": "今から貴方に\n高校生の頃の\n私の話をするわね。"},
        { "location": "412/DIALOG"  , "narrator": "", "text": "高校の時の私は、\nそれこそ非の打ち所がない程の\n模範的な高校生だったわ。\n\n校則通りの制服、\n髪の毛は短く切り、\n化粧なんてしたことも無かった。\n"},
        { "location": "413/DIALOG"  , "narrator": "", "text": "部活や生徒会や、\n学校活動は全力でやったし、\nとても充実した\n学校生活だったけど……\n\nでもやっぱり何か、\nひとつ物足りなかった。\n\nそう――"},
        { "location": "435/TALK"    , "narrator": "男子高校生", "text": "今日どうする？"},
        { "location": "436/TALK"    , "narrator": "女子高校生", "text": "そうだなー、\n久し振りに門前で\nケーキ食べたいかも！"},
        { "location": "437/DIALOG"  , "narrator": "", "text": "内心すごく羨ましかったの。\n\nお化粧してる子。\n\n制服をオシャレに\nアレンジしてる子。\n\nそして、\n男の子と楽しく\nお話している子――。"},
        { "location": "438/TALK"    , "narrator": "男子高校生", "text": "マジかよ！\n…まあいいや、\nんじゃ行くか。"},
        { "location": "439/TALK"    , "narrator": "女子高校生", "text": "やったぁ！"},
        { "location": "447/DIALOG"  , "narrator": "", "text": "うちは父が厳しくて、\nしたくてもそういうのが\nできなかった、というのも\nあったけど――"},
        { "location": "449/DIALOG"  , "narrator": "", "text": "やっぱり勇気が無かったのよね。\nただ単に。"},
        { "location": "463/TALK"    , "narrator": "潜在アーヤ", "text": "体裁を気にする\n現実の私は絶対に\n否定するけど――"},
        { "location": "464/TALK"    , "narrator": "潜在アーヤ", "text": "勉強と部活ばかりで\n恋なんて一度もした\nことがない私だから、"},
        { "location": "465/TALK"    , "narrator": "潜在アーヤ", "text": "憧れの東京で、思いっ\nきりオシャレして、\nカフェやお買い物して、"},
        { "location": "466/TALK"    , "narrator": "潜在アーヤ", "text": "そして、\n素敵な恋をする――。"},
        { "location": "467/TALK"    , "narrator": "潜在アーヤ", "text": "今でもそういうのに\n凄く憧れてるの。\n年甲斐も無くね。"},
        { "location": "468/SEL"     , "narrator": "（選択肢）", "text": "どうしてそんなこと、わざわざ$me$に？"},
        { "location": "469/ACT"     , "narrator": "", "text": "どうしてそんなこと、わざわざ$me$に？"},
        { "location": "471/TALK"    , "narrator": "潜在アーヤ", "text": "そうね。\nそれは――"},
        { "location": "472/TALK"    , "narrator": "潜在アーヤ", "text": "貴方は私の心にまで\n入ってくるような人\nだから、"},
        { "location": "474/TALK"    , "narrator": "潜在アーヤ", "text": "きっとこれからも\n私とつき合っていって\nくれるのかなと思って。"},
        { "location": "475/TALK"    , "narrator": "潜在アーヤ", "text": "……。"},
        { "location": "476/TALK"    , "narrator": "潜在アーヤ", "text": "正直ね、今回の件、\nあのカタブツの私が\n言うこともわかるの。"},
        { "location": "477/TALK"    , "narrator": "潜在アーヤ", "text": "もちろん、\n今の私の任務は\nとても大事なもの。"},
        { "location": "478/TALK"    , "narrator": "潜在アーヤ", "text": "でも、そういう\n責任とか任務とか――"},
        { "location": "479/TALK"    , "narrator": "潜在アーヤ", "text": "高校時代に散々経験\nしたことはもう\nおなかいっぱいで、"},
        { "location": "480/TALK"    , "narrator": "潜在アーヤ", "text": "オシャレしたり彼氏\n作ったりして普通に\n生きたい私もいる。"},
        { "location": "481/TALK"    , "narrator": "潜在アーヤ", "text": "任務のためだからって\n恥ずかしい思いする\nなんてもってのほかよ。"},
        { "location": "482/TALK"    , "narrator": "潜在アーヤ", "text": "他のメンバーだけで\n出来るなら、\n任せればいいって思う。"},
        { "location": "483/TALK"    , "narrator": "潜在アーヤ", "text": "そんな二律背反な\n自分が毎日戦って\nなかなか前に進めない。"},
        { "location": "485/TALK"    , "narrator": "潜在アーヤ", "text": "自分の中だけじゃ、\n何が一番大事なのか\nわからない事もある。"},
        { "location": "486/TALK"    , "narrator": "潜在アーヤ", "text": "貴方なら、それを\nちゃんと見定めて\n一押ししてくれる――"},
        { "location": "487/TALK"    , "narrator": "潜在アーヤ", "text": "何となくそんな気が\nしたから、色々本音を\nお伝えしてみました。"},
        { "location": "488/TALK"    , "narrator": "潜在アーヤ", "text": "他力本願で、自分でも\nちょっとかっこ悪いな\nって思うけど。"},
        { "location": "489/TALK"    , "narrator": "潜在アーヤ", "text": "そんな私でもよければ\nこれからも支えて\nくれると嬉しいかな。"},
        { "location": "490/SEL"     , "narrator": "（選択肢）", "text": "任せて！"},
        { "location": "491/SEL"     , "narrator": "（選択肢）", "text": "まあ、気が向いたら"},
        { "location": "492/ACT"     , "narrator": "", "text": "任せて！"},
        { "location": "493/TALK"    , "narrator": "潜在アーヤ", "text": "ふふ、心強いわ。"},
        { "location": "494/ACT"     , "narrator": "", "text": "まあ、気が向いたら"},
        { "location": "495/TALK"    , "narrator": "潜在アーヤ", "text": "そうね。\n気が向いたらでいいわ。"},
        { "location": "498/TALK"    , "narrator": "潜在アーヤ", "text": "……そろそろここには\nいられなくなりそう。"},
        { "location": "499/TALK"    , "narrator": "潜在アーヤ", "text": "貴方と色々お話できて\n良かった。つき合って\nくれてありがとう。"},
        { "location": "500/TALK"    , "narrator": "潜在アーヤ", "text": "貴方とは、また機会が\nあれば会いたいわね。"},
        { "location": "501/TALK"    , "narrator": "潜在アーヤ", "text": "それじゃ、またね――"},
        { "location": "514/TALK"    , "narrator": "表層アーヤ", "text": "大丈夫だった！？\n変な事されてない？"},
        { "location": "515/SEL"     , "narrator": "（選択肢）", "text": "大丈夫だよ"},
        { "location": "516/SEL"     , "narrator": "（選択肢）", "text": "アーヤの恥ずかしい話色々聞いたよ"},
        { "location": "517/ACT"     , "narrator": "", "text": "大丈夫だよ"},
        { "location": "518/TALK"    , "narrator": "表層アーヤ", "text": "そう、良かった。"},
        { "location": "519/ACT"     , "narrator": "", "text": "アーヤの恥ずかしい話色々聞いたよ"},
        { "location": "525/DIALOG"  , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "531/TALK"    , "narrator": "表層アーヤ", "text": "はあっ！？"},
        { "location": "532/TALK"    , "narrator": "表層アーヤ", "text": "あの私！\n一体どこまで……"},
        { "location": "536/TALK"    , "narrator": "表層アーヤ", "text": "とにかく。"},
        { "location": "537/TALK"    , "narrator": "表層アーヤ", "text": "今回はありがとう\nございました。"},
        { "location": "538/TALK"    , "narrator": "表層アーヤ", "text": "お陰で現実の私も\n少しは吹っ切ることが\nできそう。"},
        { "location": "539/SEL"     , "narrator": "（選択肢）", "text": "よかったね"},
        { "location": "540/ACT"     , "narrator": "", "text": "よかったね"},
        { "location": "542/TALK"    , "narrator": "表層アーヤ", "text": "それで、あの……"},
        { "location": "543/TALK"    , "narrator": "表層アーヤ", "text": "嫌じゃなければ\nまた何か今回みたいな\nことがあったら――"},
        { "location": "544/TALK"    , "narrator": "表層アーヤ", "text": "サポートして\nもらえませんか！？"},
        { "location": "545/SEL"     , "narrator": "（選択肢）", "text": "もちろん！"},
        { "location": "546/SEL"     , "narrator": "（選択肢）", "text": "もう一人のアーヤと同じ事言ってるｗ"},
        { "location": "547/ACT"     , "narrator": "", "text": "もちろん！"},
        { "location": "548/TALK"    , "narrator": "表層アーヤ", "text": "良かった。"},
        { "location": "549/TALK"    , "narrator": "表層アーヤ", "text": "これからも\n宜しくお願いします。"},
        { "location": "550/ACT"     , "narrator": "", "text": "もう一人のアーヤと同じ事言ってるｗ"},
        { "location": "556/DIALOG"  , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "561/TALK"    , "narrator": "表層アーヤ", "text": "え！？"},
        { "location": "562/SEL"     , "narrator": "（選択肢）", "text": "やっぱり同じアーヤなんだね"},
        { "location": "563/ACT"     , "narrator": "", "text": "やっぱり同じアーヤなんだね"},
        { "location": "565/TALK"    , "narrator": "表層アーヤ", "text": "……"},
        { "location": "592/TALK"    , "narrator": "千羽鶴", "text": "おめでとう。"},
        { "location": "593/TALK"    , "narrator": "千羽鶴", "text": "あなたは彼女の\nココロの迷いを解消し、\n一歩前進させた。"},
        { "location": "594/SEL"     , "narrator": "（選択肢）", "text": "えっへん"},
        { "location": "595/SEL"     , "narrator": "（選択肢）", "text": "あまり実感ない"},
        { "location": "596/SEL"     , "narrator": "（選択肢）", "text": "本当にこれで良かったのだろうか"},
        { "location": "597/ACT"     , "narrator": "", "text": "えっへん"},
        { "location": "598/TALK"    , "narrator": "千羽鶴", "text": "そうね。\n今回ばかりは\n誇っていいと思う。"},
        { "location": "599/ACT"     , "narrator": "", "text": "あまり実感ない"},
        { "location": "600/TALK"    , "narrator": "千羽鶴", "text": "そうね。\nそう思うかも知れない。\nでも――"},
        { "location": "601/ACT"     , "narrator": "", "text": "本当にこれで良かったのだろうか"},
        { "location": "603/TALK"    , "narrator": "千羽鶴", "text": "選択に絶対的な\n正解なんて最初から\n存在しない。"},
        { "location": "605/TALK"    , "narrator": "千羽鶴", "text": "汚い言い方をすれば、\n利己的な選択をし、\n結果が伴えば正解。"},
        { "location": "606/TALK"    , "narrator": "千羽鶴", "text": "それは申し訳無いけど\n今はあなたも知らない\n私の思惑も含めて。"},
        { "location": "607/TALK"    , "narrator": "千羽鶴", "text": "一般的にも、ダメな\n選択をしたと思ったら\n物事が好転したり――"},
        { "location": "608/TALK"    , "narrator": "千羽鶴", "text": "逆に順当な選択をした\nつもりが、後悔する\n結果になったりもする。"},
        { "location": "609/TALK"    , "narrator": "千羽鶴", "text": "大事なのは\n「自分はどうしたいか」"},
        { "location": "610/TALK"    , "narrator": "千羽鶴", "text": "周囲のノイズを遮断し\n自分で決めること。"},
        { "location": "611/TALK"    , "narrator": "千羽鶴", "text": "私があなたにお願い\nしたいのは、あくまで\nそのサポートなの。"},
        { "location": "613/TALK"    , "narrator": "千羽鶴", "text": "人のココロを動かす\nには、いつも大きな\n力が必要とは限らない。"},
        { "location": "614/TALK"    , "narrator": "千羽鶴", "text": "些細なきっかけを\n与えるだけで、整理が\nつくこともある。"},
        { "location": "615/TALK"    , "narrator": "千羽鶴", "text": "そうやって、逃げずに\n決めて、それを実行\nすることは――"},
        { "location": "616/TALK"    , "narrator": "千羽鶴", "text": "次第にココロを\n強くすることに繋がる。"},
        { "location": "617/SEL"     , "narrator": "（選択肢）", "text": "よくわからない"},
        { "location": "618/ACT"     , "narrator": "", "text": "よくわからない"},
        { "location": "620/TALK"    , "narrator": "千羽鶴", "text": "一気に理解は\n出来ないと思う。"},
        { "location": "621/TALK"    , "narrator": "千羽鶴", "text": "とにかくあなたには、\nこれからもずっと、\n今回の様に――"},
        { "location": "622/TALK"    , "narrator": "千羽鶴", "text": "彼女のココロの成長を\n支援してあげて欲しい。"},
        { "location": "626/TALK"    , "narrator": "潜在アーヤ", "text": "…っと。\nちょっと長くお話\nし過ぎちゃったかしら？"},
        { "location": "627/TALK"    , "narrator": "潜在アーヤ", "text": "$handle$さん。\n貴方とはまたいずれ、\nすぐに逢える気がします。"},
        { "location": "628/TALK"    , "narrator": "潜在アーヤ", "text": "私のラブラブ直感が\nそう伝えてるの。"},
        { "location": "629/TALK"    , "narrator": "潜在アーヤ", "text": "またココロスフィアに\n遊びに来てね？"},
        { "location": "630/TALK"    , "narrator": "潜在アーヤ", "text": "今度は今よりもっと、\n楽しいことしましょ？"},
        { "location": "631/SEL"     , "narrator": "（選択肢）", "text": "楽しみにしてます！"},
        { "location": "632/SEL"     , "narrator": "（選択肢）", "text": "もういいかな"},
        { "location": "633/ACT"     , "narrator": "", "text": "楽しみにしてます！"},
        { "location": "634/TALK"    , "narrator": "潜在アーヤ", "text": "私もよ？"},
        { "location": "635/ACT"     , "narrator": "", "text": "もういいかな"},
        { "location": "636/TALK"    , "narrator": "潜在アーヤ", "text": "あらそう。\nそれは残念ね。"},
        { "location": "637/TALK"    , "narrator": "潜在アーヤ", "text": "気が向いたら\nいつでも来て。\n扉は開けておくから。"},
        { "location": "640/TALK"    , "narrator": "潜在アーヤ", "text": "それじゃ、またね。"},
        { "location": "664/TALK"    , "narrator": "千羽鶴", "text": "おめでとう。"},
        { "location": "665/TALK"    , "narrator": "千羽鶴", "text": "あなたは彼女の\nココロの迷いを解消し、\n一歩前進させた。"},
        { "location": "666/SEL"     , "narrator": "（選択肢）", "text": "えっへん"},
        { "location": "667/SEL"     , "narrator": "（選択肢）", "text": "あまり実感ない"},
        { "location": "668/SEL"     , "narrator": "（選択肢）", "text": "本当にこれで良かったのだろうか"},
        { "location": "669/ACT"     , "narrator": "", "text": "えっへん"},
        { "location": "670/TALK"    , "narrator": "千羽鶴", "text": "そうね。\n今回ばかりは\n誇っていいと思う。"},
        { "location": "671/ACT"     , "narrator": "", "text": "あまり実感ない"},
        { "location": "672/TALK"    , "narrator": "千羽鶴", "text": "そうね。\nそう思うかも知れない。\nでも――"},
        { "location": "673/ACT"     , "narrator": "", "text": "本当にこれで良かったのだろうか"},
        { "location": "675/TALK"    , "narrator": "千羽鶴", "text": "選択に絶対的な\n正解なんて最初から\n存在しない。"},
        { "location": "677/TALK"    , "narrator": "千羽鶴", "text": "汚い言い方をすれば、\n利己的な選択をし、\n結果が伴えば正解。"},
        { "location": "678/TALK"    , "narrator": "千羽鶴", "text": "それは申し訳無いけど\n今はあなたも知らない\n私の思惑も含めて。"},
        { "location": "679/TALK"    , "narrator": "千羽鶴", "text": "一般的にも、ダメな\n選択をしたと思ったら\n物事が好転したり――"},
        { "location": "680/TALK"    , "narrator": "千羽鶴", "text": "逆に順当な選択をした\nつもりが、後悔する\n結果になったりもする。"},
        { "location": "681/TALK"    , "narrator": "千羽鶴", "text": "大事なのは\n「自分はどうしたいか」"},
        { "location": "682/TALK"    , "narrator": "千羽鶴", "text": "周囲のノイズを遮断し\n自分で決めること。"},
        { "location": "683/TALK"    , "narrator": "千羽鶴", "text": "私があなたにお願い\nしたいのは、あくまで\nそのサポートなの。"},
        { "location": "685/TALK"    , "narrator": "千羽鶴", "text": "人のココロを動かす\nには、いつも大きな\n力が必要とは限らない。"},
        { "location": "686/TALK"    , "narrator": "千羽鶴", "text": "些細なきっかけを\n与えるだけで、整理が\nつくこともある。"},
        { "location": "687/TALK"    , "narrator": "千羽鶴", "text": "そうやって、逃げずに\n決めて、それを実行\nすることは――"},
        { "location": "688/TALK"    , "narrator": "千羽鶴", "text": "次第にココロを\n強くすることに繋がる。"},
        { "location": "689/SEL"     , "narrator": "（選択肢）", "text": "よくわからない"},
        { "location": "690/ACT"     , "narrator": "", "text": "よくわからない"},
        { "location": "692/TALK"    , "narrator": "千羽鶴", "text": "一気に理解は\n出来ないと思う。"},
        { "location": "693/TALK"    , "narrator": "千羽鶴", "text": "とにかくあなたには、\nこれからもずっと、\n今回の様に――"},
        { "location": "694/TALK"    , "narrator": "千羽鶴", "text": "彼女のココロの成長を\n支援してあげて欲しい。"}
    ]
}
