    [
        { "location": "7/SCENARIO", "narrator": "", "text": "012_はぎれならあったから"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "パッチワーク"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "ちょっとやってみたわ"},
        { "location": "35/SEL"    , "narrator": "", "text": "本当にやったとは…"},
        { "location": "36/SEL"    , "narrator": "", "text": "面白かった？"},
        { "location": "37/SEL"    , "narrator": "", "text": "作ったの？"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "人形の意匠なんかの"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "衣装ね"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "切れ端があったから"},
        { "location": "42/ACT"    , "narrator": "", "text": "本当にやったとは…"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "ついね"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "っていうか"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "貴方がその原因作ったんでしょ？"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "まあ(￣Д￣ )"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "他の仕方"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "楽しかったからいいわ"},
        { "location": "51/ACT"    , "narrator": "", "text": "面白かった？"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "まあね"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "モチーフだけ作っても意味ないのよね"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "完成形を意識しないと続かないわ"},
        { "location": "56/ACT"    , "narrator": "", "text": "作ったの？"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "コースターを作って見たわ"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "適当に"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "結構気に入ったけど"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "おかんアートっぽいかも"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "って感じだから"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "もう作らないかもね"}
    ]
}
