        { "location": "7/SCENARIO", "narrator": "", "text": "019_天然氷と山ガール"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "こう暑いと"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "バイク乗った後に"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "冷たいものが欲しくなるわね"},
        { "location": "36/SEL"    , "narrator": "", "text": "やっぱりアイスだよね！"},
        { "location": "37/SEL"    , "narrator": "", "text": "冷たい麦茶～"},
        { "location": "38/SEL"    , "narrator": "", "text": "はい、かちわり氷！"},
        { "location": "39/ACT"    , "narrator": "", "text": "やっぱりアイスだよね！"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "そうよね～(*^^*)"},
        { "location": "41/ACT"    , "narrator": "", "text": "冷たい麦茶～"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "あ～"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "一気飲みしたい(*^o^*)"},
        { "location": "44/ACT"    , "narrator": "", "text": "はい、かちわり氷！"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "って"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "高校球児か！ヾ(･･ )"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "これからもっと暑くなるのよね。。。"},
        { "location": "51/SEL"    , "narrator": "", "text": "$me$とアーヤの仲みたいにね"},
        { "location": "52/SEL"    , "narrator": "", "text": "夏もいいよね"},
        { "location": "53/SEL"    , "narrator": "", "text": "暑いのやだよね"},
        { "location": "54/ACT"    , "narrator": "", "text": "$me$とアーヤの仲みたいにね"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "そんなこと言って"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "暑いと熱いじゃ違うわよ？"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "ｓこはちゃんと"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "わかってる？！"},
        { "location": "61/ACT"    , "narrator": "", "text": "夏もいいよね"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "んー"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "あんまり。。。"},
        { "location": "64/ACT"    , "narrator": "", "text": "暑いのやだよね"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "やなのよー"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "そうよー"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "やっぱりねー"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "風邪がないと"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "辛いわよね"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "風が"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "暑いとね"},
        { "location": "76/SEL"    , "narrator": "", "text": "風があると違うよね"},
        { "location": "77/ACT"    , "narrator": "", "text": "風があると違うよね"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "そうそう"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "バイクだと風を感じるけど"},
