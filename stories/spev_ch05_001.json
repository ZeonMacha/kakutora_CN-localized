    "type": "EventQuest",
    "info": {
        "story_id": "91015",
        "cid": "kagura",
        "title": "【期間限定】誕生日イベント",
        "sub_title": "神楽の誕生日"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "神楽の誕生日（復元）"},
        { "location": "20/TALK"   , "narrator": "神楽", "text": "？\nどうしたんですか？"},
        { "location": "21/SEL"    , "narrator": "", "text": "お誕生日おめでとう！"},
        { "location": "22/ACT"    , "narrator": "", "text": "お誕生日おめでとう！"},
        { "location": "24/TALK"   , "narrator": "神楽", "text": "えええええっ！！\n私の誕生日ですかっ！？"},
        { "location": "25/TALK"   , "narrator": "神楽", "text": "ビックリしちゃいました！\nまさか私の誕生日をお祝\nいしてくれるなんて…"},
        { "location": "26/TALK"   , "narrator": "神楽", "text": "とっても嬉しいです♪"},
        { "location": "27/SEL"    , "narrator": "", "text": "プレゼントあるよ"},
        { "location": "28/ACT"    , "narrator": "", "text": "プレゼントあるよ"},
        { "location": "32/TALK"   , "narrator": "神楽", "text": "えっ！？\nほんとですか？\nすごーい！"},
        { "location": "33/TALK"   , "narrator": "神楽", "text": "至れり尽くせりですねっ！"},
        { "location": "34/TALK"   , "narrator": "神楽", "text": "わあっ！\nとっても楽しみです♪"},
        { "location": "35/TALK"   , "narrator": "神楽", "text": "今すぐ開けてもいいです\nかっ！？"},
        { "location": "36/SEL"    , "narrator": "", "text": "もちろんあけて"},
        { "location": "37/SEL"    , "narrator": "", "text": "嫌な予感がする"},
        { "location": "38/ACT"    , "narrator": "", "text": "もちろんあけて"},
        { "location": "39/ACT"    , "narrator": "", "text": "嫌な予感がする"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "またそんな事言って！\n脅かそうったってそうは\nいきませんよ？"},
        { "location": "42/TALK"   , "narrator": "神楽", "text": "開けまーす♪"},
        { "location": "48/DIALOG" , "narrator": "", "text": "神楽のコスチューム\n<size=40><color=red><b>Dimention Error. 0x01</b></color></size>\nをゲットしました！"},
        { "location": "57/DIALOG" , "narrator": "", "text": "\n\nこれよりTRI-OSは、\n”パラメトリック理論に基づく\n世界選択法”による、未来選択\nモードに移行します。\n\n未来は一時的に不確定性となり\nおよそ7日間の期間を経て再創造\nされることになります。"},
        { "location": "58/SEL"    , "narrator": "", "text": "は！？"},
        { "location": "59/ACT"    , "narrator": "", "text": "は！？"},
        { "location": "63/TALK"   , "narrator": "ソイルトン", "text": "こんにちは、こんばんは、ソイルトンです。"},
        { "location": "64/SEL"    , "narrator": "", "text": "ちょっとｗｗｗなんでソイルトンちゃんがここにｗｗ"},
        { "location": "65/ACT"    , "narrator": "", "text": "ちょっとｗｗｗなんでソイルトンちゃんがここにｗｗ"},
        { "location": "67/TALK"   , "narrator": "ソイルトン", "text": "極小範囲ではあり、世界の一部が不確定性となりましたので、私の出番がやってきたようです。"},
        { "location": "68/SEL"    , "narrator": "", "text": "何が起こってるの？"},
        { "location": "69/ACT"    , "narrator": "", "text": "何が起こってるの？"},
        { "location": "71/TALK"   , "narrator": "ソイルトン", "text": "卯月神楽の誕生日にあたり、$handle$は彼女にプレゼントボックスを贈りました。"},
        { "location": "72/TALK"   , "narrator": "ソイルトン", "text": "そして彼女はそれを開けました。"},
        { "location": "73/TALK"   , "narrator": "ソイルトン", "text": "ところが、このプレゼントボックスには問題がありました。"},
        { "location": "74/TALK"   , "narrator": "ソイルトン", "text": "このプレゼントボックスの中身はまだ一度も\"観測\"されておらず、よって不確定性を保持しているのです。"},
        { "location": "75/TALK"   , "narrator": "ソイルトン", "text": "その為この事象に関しては、皆さんの\"総意\"によってプレゼントボックスの観測と確定をしなければなりません。"},
        { "location": "76/TALK"   , "narrator": "ソイルトン", "text": "さて、プレゼントボックスに入っている可能性があるアイテムは、次の3種類です。"},
        { "location": "77/TALK"   , "narrator": "ソイルトン", "text": "この中で、$handle$が\"どのプレゼントを実現したいか\"を選択して下さい。"},
        { "location": "78/TALK"   , "narrator": "ソイルトン", "text": "それが\"総意\"として収束し、現実に反映されることになります。"},
        { "location": "79/SEL"    , "narrator": "", "text": "要するに多数決でしょ？"},
        { "location": "80/ACT"    , "narrator": "", "text": "要するに多数決でしょ？"},
        { "location": "82/TALK"   , "narrator": "ソイルトン", "text": "観測による不確定性の確定であり量子の収束です。"},
        { "location": "83/TALK"   , "narrator": "ソイルトン", "text": "多数決などという、ユメもキボーもない単語を乱用していると、貴方自身もユメを失ってしまいますよ？"},
        { "location": "85/SEL"    , "narrator": "", "text": "スポーツウェア"},
        { "location": "86/SEL"    , "narrator": "", "text": "Wishpobia(ライブ衣装)"},
        { "location": "87/SEL"    , "narrator": "", "text": "ふたりはラブラブTシャツ"},
        { "location": "88/ACT"    , "narrator": "", "text": "スポーツウェア"},
        { "location": "95/DIALOG" , "narrator": "", "text": "コスチューム\n<color=red><b>【スポーツウェア】</b></color>\nに投票しました！"},
        { "location": "96/ACT"    , "narrator": "", "text": "Wishpobia(ライブ衣装)"},
        { "location": "103/DIALOG", "narrator": "", "text": "コスチューム\n<color=red><b>【Wishphobia】</b></color>\nに投票しました！"},
        { "location": "104/ACT"   , "narrator": "", "text": "ふたりはラブラブTシャツ"},
        { "location": "111/DIALOG", "narrator": "", "text": "コスチューム\n<color=red><b>【ふたりはラブラブTシャツ】</b></color>\nに投票しました！"},
        { "location": "119/TALK"  , "narrator": "神楽", "text": "わあっ！\nとっても素敵なプレゼン\nトですっ！"},
        { "location": "120/SEL"   , "narrator": "", "text": "まだ何もあげてないよ？"},
        { "location": "121/ACT"   , "narrator": "", "text": "まだ何もあげてないよ？"},
        { "location": "123/TALK"  , "narrator": "神楽", "text": "そうかもしれませんね。"},
        { "location": "124/TALK"  , "narrator": "神楽", "text": "でも、私からすればもう\n戴いているようなものな\nんです。"},
        { "location": "125/TALK"  , "narrator": "神楽", "text": "それに――"},
        { "location": "126/TALK"  , "narrator": "神楽", "text": "$handle$さんのプレゼ\nントしてくれる物が嬉し\nくないわけないです。"},
        { "location": "127/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "128/TALK"  , "narrator": "神楽", "text": "あ、そうです！\nちょっとだけ、ふたりで\nゲームをしませんか？"},
        { "location": "129/SEL"   , "narrator": "", "text": "ゲーム？"},
        { "location": "130/ACT"   , "narrator": "", "text": "ゲーム？"},
        { "location": "132/TALK"  , "narrator": "神楽", "text": "そうです！"},
        { "location": "133/TALK"  , "narrator": "神楽", "text": "ジャンケンして\n$handle$さんが勝った\nら――"},
        { "location": "134/TALK"  , "narrator": "神楽", "text": "私にナデナデする権利を\n差し上げます♪"},
        { "location": "135/SEL"   , "narrator": "", "text": "私が負けたら？"},
        { "location": "136/ACT"   , "narrator": "", "text": "私が負けたら？"},
        { "location": "138/TALK"  , "narrator": "神楽", "text": "そのままサヨナラに決まっ\nてるじゃないですか。"},
        { "location": "139/TALK"  , "narrator": "神楽", "text": "それじゃ、いきますよ？"},
        { "location": "143/TALK"  , "narrator": "神楽", "text": "それじゃ約束ですし、ナ\nデナデしてください。"},
        { "location": "144/TALK"  , "narrator": "神楽", "text": "でも、変なところ撫でた\nら呪いますからね？"},
        { "location": "150/DIALOG", "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "170/DIALOG", "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "171/TALK"  , "narrator": "神楽", "text": "ふふっ…。こういうのっ\nて、なんだか興奮しちゃ\nいませんか？"},
        { "location": "172/TALK"  , "narrator": "神楽", "text": "今回は、$handle$さん\nと遊べて楽しかったです♪"},
        { "location": "173/TALK"  , "narrator": "神楽", "text": "また一緒に遊びましょう\nね？"},
        { "location": "174/TALK"  , "narrator": "神楽", "text": "それと――"},
        { "location": "175/TALK"  , "narrator": "神楽", "text": "お誕生日お祝いしてくれ\nてありがとうございます。"},
        { "location": "176/TALK"  , "narrator": "神楽", "text": "最近、あまり誰かにお祝\nいされること無かったか\nら――"},
        { "location": "177/TALK"  , "narrator": "神楽", "text": "ちょっとだけ嬉しかった\nですよ♪"},
        { "location": "178/TALK"  , "narrator": "神楽", "text": "それじゃ、$handle$さ\nん。またです♪"},
        { "location": "189/DIALOG", "narrator": "", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\n誕生日プレゼントの決定は、\n神楽チャンネル解禁時に行います。\n\nまた、そのコスチュームは\n神楽チャンネルをプレイする方\n全員に配布されます。\n\nどうぞお楽しみに！"}
    ]
}
