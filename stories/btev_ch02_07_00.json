        "title": "010 ココロスフィアストーリー【Lv04】",
        "sub_title": "姉妹の隔絶Ⅱ＜提起＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "姉妹の隔絶・後編１"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 04</size>\nAYAMI - KUNIMASA\n\n<size=45>姉妹の隔絶Ⅱ</size>\n<size=35>～その核心に関する調査～</size>"},
        { "location": "24/TALK"   , "narrator": "潜在アーヤ", "text": "ふふ。\n待ってたわよ。"},
        { "location": "25/TALK"   , "narrator": "潜在アーヤ", "text": "絶対に\n来てくれると\n思ってたわ。"},
        { "location": "26/TALK"   , "narrator": "潜在アーヤ", "text": "さあ、それじゃ今日も\n張り切って、姉と和解\n大作戦始めましょうか。"},
        { "location": "28/TALK"   , "narrator": "表層アーヤ", "text": "残念だけど、\n今回は貴方の思い通り\nにはいかないわよ？"},
        { "location": "30/TALK"   , "narrator": "潜在アーヤ", "text": "現れたわね！\n鉄仮面！"},
        { "location": "32/TALK"   , "narrator": "表層アーヤ", "text": "誰が鉄仮面よ。"},
        { "location": "33/TALK"   , "narrator": "潜在アーヤ", "text": "今回も前回に引き続き\n私の思い通りにいく\nわよ。だって私には―"},
        { "location": "34/TALK"   , "narrator": "潜在アーヤ", "text": "素敵な\n$handle$さんが\nついてるんだもの。"},
        { "location": "36/TALK"   , "narrator": "潜在アーヤ", "text": "ねー？　今回も\n私と一緒に\n頑張りましょうね。"},
        { "location": "37/TALK"   , "narrator": "表層アーヤ", "text": "毎度思うんだけど、\n私のイメージを誤解\nさせる仕草――"},
        { "location": "38/TALK"   , "narrator": "表層アーヤ", "text": "やめてもらえない\nかしら？"},
        { "location": "40/TALK"   , "narrator": "潜在アーヤ", "text": "あら、失礼ね。\n私だって貴方と同じ、\n私の一部なのよ？"},
        { "location": "41/TALK"   , "narrator": "潜在アーヤ", "text": "誤解なんかじゃなく\n正真正銘、私の潜在\n的な欲求の１つなの。"},
        { "location": "42/TALK"   , "narrator": "表層アーヤ", "text": "認めない。"},
        { "location": "43/TALK"   , "narrator": "潜在アーヤ", "text": "認めてくれなくても\nいいわよ。だって――"},
        { "location": "44/TALK"   , "narrator": "潜在アーヤ", "text": "貴方はここで\n消える運命に\nあるんだから！"},
        { "location": "56/DIALOG" , "narrator": "", "text": "<color=black><size=50><b>姉を絶対的に排除する人格を倒し\n姉との和解を進展させよ！</b></size></color>\n\n\n\n前回に引き続き、姉を排除する人格が登場。\n\n姉との関係の最も重要なところが\nまだ明かされていない以上\n彼女を倒して更に奥へ進まねばならない。\n\n姉との確執の本質を見つけ出し、\n和解の道を探っていこう。\n"}
    ]
}
