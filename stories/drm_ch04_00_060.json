        "title": "らぶとーく 第06話",
        "sub_title": "テストシナリオ実行完了"
    },
    "entry":
    [
        { "location": "374/SCENARIO", "narrator": "", "text": "テストシナリオ実行完了"},
        { "location": "396/TALK"    , "narrator": "みやび", "text": "ん～…。"},
        { "location": "397/TALK"    , "narrator": "アーヤ", "text": "…どうかしら？"},
        { "location": "398/TALK"    , "narrator": "みやび", "text": "そうやねぇ…。"},
        { "location": "399/TALK"    , "narrator": "みやび", "text": "アーヤから渡された\nこの会話ログを\n見る限り――"},
        { "location": "400/TALK"    , "narrator": "みやび", "text": "多分やけんど、\n答えが出たちや。"},
        { "location": "403/TALK"    , "narrator": "アーヤ", "text": "えっ、もう！？"},
        { "location": "404/TALK"    , "narrator": "みやび", "text": "やはり、データが倍だと\n解析もラクちや。"},
        { "location": "405/TALK"    , "narrator": "みやび", "text": "Ｂｏｔめ…やはりそういう\nことやったか。"},
        { "location": "406/SEL"     , "narrator": "", "text": "何してるの？"},
        { "location": "407/SEL"     , "narrator": "", "text": "遊ぼうよ"},
        { "location": "408/SEL"     , "narrator": "", "text": "お腹空いたんだけど"},
        { "location": "409/ACT"     , "narrator": "", "text": "何してるの？"},
        { "location": "414/TALK"    , "narrator": "アーヤ", "text": "…まさか。"},
        { "location": "415/TALK"    , "narrator": "みやび", "text": "…ヤツや。"},
        { "location": "429/TALK"    , "narrator": "みやび", "text": "何でもない"},
        { "location": "430/TALK"    , "narrator": "みやび", "text": "ただの女子会や"},
        { "location": "431/TALK"    , "narrator": "みやび", "text": "チケットなしは入場お断りぞね"},
        { "location": "444/TALK"    , "narrator": "アーヤ", "text": "…Ｂｏｔは何だって？"},
        { "location": "447/TALK"    , "narrator": "みやび", "text": "何してるのか、やって。"},
        { "location": "450/TALK"    , "narrator": "みやび", "text": "どうやら、うちらが\nＢｏｔのこと調べてるん、\n気付かれてたようやね。"},
        { "location": "453/TALK"    , "narrator": "アーヤ", "text": "それって、監視！？"},
        { "location": "454/TALK"    , "narrator": "みやび", "text": "やとしたら、話しかけて\nくるゆうんは変や。"},
        { "location": "455/TALK"    , "narrator": "みやび", "text": "目的はさっぱりやけんど、\nそういうことじゃないとは\n思うちや。"},
        { "location": "456/TALK"    , "narrator": "みやび", "text": "何にせよ――"},
        { "location": "457/ACT"     , "narrator": "", "text": "遊ぼうよ"},
        { "location": "462/TALK"    , "narrator": "アーヤ", "text": "…まさか。"},
        { "location": "463/TALK"    , "narrator": "みやび", "text": "…ヤツや。"},
        { "location": "477/TALK"    , "narrator": "みやび", "text": "今忙しい"},
        { "location": "478/TALK"    , "narrator": "みやび", "text": "あとで気の済むまで遊んでやるぞね"},
        { "location": "491/TALK"    , "narrator": "アーヤ", "text": "…Ｂｏｔは何だって？"},
        { "location": "494/TALK"    , "narrator": "みやび", "text": "遊ぼうよ、やって。"},
        { "location": "497/TALK"    , "narrator": "みやび", "text": "このタイミングで\n話しかけてくるゆうんは、\nタイミング良過ぎやろ？"},
        { "location": "500/TALK"    , "narrator": "アーヤ", "text": "私もそう思うわ。"},
        { "location": "501/TALK"    , "narrator": "アーヤ", "text": "っていうことは、\nやっぱり…。"},
        { "location": "502/ACT"     , "narrator": "", "text": "お腹空いたんだけど"},
        { "location": "507/TALK"    , "narrator": "アーヤ", "text": "…まさか。"},
        { "location": "508/TALK"    , "narrator": "みやび", "text": "…ヤツや。"},
        { "location": "522/TALK"    , "narrator": "みやび", "text": "腹ペコ？"},
        { "location": "523/TALK"    , "narrator": "みやび", "text": "戸棚にドーナツがあるぞね"},
        { "location": "524/TALK"    , "narrator": "みやび", "text": "食べたければニュイと足を生やして取って来ぃ"},
        { "location": "537/TALK"    , "narrator": "みやび", "text": "…あいつ、\nわけわからんな。"},
        { "location": "540/TALK"    , "narrator": "アーヤ", "text": "何て言ってたの？"},
        { "location": "543/TALK"    , "narrator": "みやび", "text": "お腹空いた言うてた。"},
        { "location": "546/TALK"    , "narrator": "みやび", "text": "変な話やね。\n充電１００％のはず\nやのに…。"},
        { "location": "548/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔの定期会話機能\nみたいなものかしら？"},
        { "location": "549/TALK"    , "narrator": "みやび", "text": "ありえなくはないけんど、\n今までの会話ログの\n内容から考えて――"},
        { "location": "552/TALK"    , "narrator": "みやび", "text": "Ｂｏｔは人間やと、\nうちは断言するぞね。"},
        { "location": "553/TALK"    , "narrator": "アーヤ", "text": "やっぱりね…。"},
        { "location": "554/TALK"    , "narrator": "みやび", "text": "Ｂｏｔ特有の、意味不明な\n返答がないのが決め手や。"},
        { "location": "555/TALK"    , "narrator": "みやび", "text": "まあ、うちの知らない\nところで――"},
        { "location": "556/TALK"    , "narrator": "みやび", "text": "超高性能なＢｏｔが\n作られてたっちゅうなら\n話は別やけんどね。"},
        { "location": "558/TALK"    , "narrator": "アーヤ", "text": "その可能性は？"},
        { "location": "560/TALK"    , "narrator": "みやび", "text": "まずありえんちや。"},
        { "location": "561/TALK"    , "narrator": "みやび", "text": "そんな高性能なＡＩを、\nただのＢｏｔとしてしか\n使わないなんて――"},
        { "location": "562/TALK"    , "narrator": "みやび", "text": "無駄でしかないぞね。"},
        { "location": "565/TALK"    , "narrator": "アーヤ", "text": "…そうなんだろう\nけど……。"},
        { "location": "567/TALK"    , "narrator": "みやび", "text": "そういうことや。"},
        { "location": "569/TALK"    , "narrator": "みやび", "text": "…で？\nこの後はどうするが？"},
        { "location": "572/TALK"    , "narrator": "アーヤ", "text": "とりあえず、みんなに\n報告しないとね。"},
        { "location": "574/TALK"    , "narrator": "アーヤ", "text": "プライバシーにも\n関わってくる問題だし…。"},
        { "location": "575/TALK"    , "narrator": "みやび", "text": "…まあ、なあ……。"}
    ]
}
