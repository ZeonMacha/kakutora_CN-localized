        "title": "013 ココロスフィアストーリー【Lv05】",
        "sub_title": "母とは何たるか＜提起＞"
    },
    "entry":
    [
        { "location": "14/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 05</size>\nGABRIELLA\n\n<size=45>母とは何たるか</size>\n<size=35>～微かな記憶と粛清の嵐～</size>"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "！？"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "ここは…？"},
        { "location": "34/SEL"    , "narrator": "（選択肢）", "text": "…？"},
        { "location": "35/ACT"    , "narrator": "", "text": "…？"},
        { "location": "37/TALK"   , "narrator": "？？？", "text": "ガブリエラ。"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "！！"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "ああっ！"},
        { "location": "42/SEL"    , "narrator": "（選択肢）", "text": "まずい！ガブリエラ逃げろ！"},
        { "location": "43/ACT"    , "narrator": "", "text": "まずい！ガブリエラ逃げろ！"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "え？\nどうして？"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "心配しなくても\n大丈夫よ？"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "紹介するわ。\nあたしのお母様なの。"},
        { "location": "53/SEL"    , "narrator": "（選択肢）", "text": "…え？"},
        { "location": "54/ACT"    , "narrator": "", "text": "…え？"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "お母様、\nあたし今日も\n良い子にしていたわ。"},
        { "location": "62/TALK"   , "narrator": "？？？", "text": "そう。ギャヴィは\nおりこうさんで\nえらいわね。"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "！？"},
        { "location": "66/SEL"    , "narrator": "（選択肢）", "text": "ちょっ！！"},
        { "location": "67/ACT"    , "narrator": "", "text": "ちょっ！！"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "間違えたわ。\nお母様じゃなかった。"},
        { "location": "80/SEL"    , "narrator": "（選択肢）", "text": "ええっ！？"},
        { "location": "81/ACT"    , "narrator": "", "text": "ええっ！？"},
        { "location": "84/TALK"   , "narrator": "？？？", "text": "ガブリエラ。"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "お母様！"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "早く来てくれないから\n不審者をお母様と\n間違えちゃったわ？"},
        { "location": "87/TALK"   , "narrator": "？？？", "text": "ごめんなさいね。\n早くおうちに帰って\nバルシチ食べましょ？"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "また\n間違えちゃった。"},
        { "location": "105/TALK"  , "narrator": "？？？", "text": "何やってるの！\n今日の宿題は\nもう終わったの！？"},
        { "location": "120/TALK"  , "narrator": "？？？", "text": "ガブリエラ。\n今日のクレー射撃は――"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "せんぱい！\n今日のバイトは――"},
        { "location": "149/SEL"   , "narrator": "（選択肢）", "text": "ちょっ！！ためらいなし！？"},
        { "location": "150/ACT"   , "narrator": "", "text": "ちょっ！！ためらいなし！？"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "あたしには\nお母様以外は\n必要無いの。"},
        { "location": "159/TALK"  , "narrator": "？？？", "text": "ギャヴィちゃん！"},
        { "location": "173/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ！"},
        { "location": "177/SEL"   , "narrator": "（選択肢）", "text": "撃つな！"},
        { "location": "178/ACT"   , "narrator": "", "text": "撃つな！"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "あなた、\nなにやってるのよ！"},
        { "location": "182/TALK"  , "narrator": "ガブリエラ", "text": "あ……"},
        { "location": "186/SEL"   , "narrator": "（選択肢）", "text": "…っ！"},
        { "location": "187/SEL"   , "narrator": "（選択肢）", "text": "やめろ！！"},
        { "location": "188/ACT"   , "narrator": "", "text": "…っ！"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "201/TALK"  , "narrator": "ガブリエラ", "text": "……やっぱり。"},
        { "location": "203/TALK"  , "narrator": "ガブリエラ", "text": "あたしには、\nお母様なんて\nいなかったんだわ。"},
        { "location": "216/TALK"  , "narrator": "千羽鶴", "text": "終わってしまった。"},
        { "location": "217/SEL"   , "narrator": "（選択肢）", "text": "何が？"},
        { "location": "218/ACT"   , "narrator": "", "text": "何が？"},
        { "location": "220/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラの世界が。"},
        { "location": "221/TALK"  , "narrator": "千羽鶴", "text": "彼女の心が\n安定してしまった。"},
        { "location": "222/TALK"  , "narrator": "千羽鶴", "text": "よって、この世界は\n閉じられた。"},
        { "location": "223/TALK"  , "narrator": "千羽鶴", "text": "もちろん、安定とは\n言っても、必ずしも\n良いこととは限らない。"},
        { "location": "224/TALK"  , "narrator": "千羽鶴", "text": "停滞の方向に安定して\nしまうと、問題の\n解決や成長は望めない。"},
        { "location": "225/TALK"  , "narrator": "千羽鶴", "text": "そして今は\nまさにその状況にある。"},
        { "location": "226/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラが今\n抱えている心の問題。"},
        { "location": "227/TALK"  , "narrator": "千羽鶴", "text": "それを解決したければ\n別の方法をとること。"},
        { "location": "228/TALK"  , "narrator": "千羽鶴", "text": "それが唯一の手段。"},
        { "location": "229/TALK"  , "narrator": "千羽鶴", "text": "幸い貴方は、何度も\n同じ時間にチャレンジ\nすることができる。"},
        { "location": "230/TALK"  , "narrator": "千羽鶴", "text": "まだその気があれば、\nやってみるのがいい。"},
        { "location": "232/ACT"   , "narrator": "", "text": "やめろ！！"},
        { "location": "235/TALK"  , "narrator": "ガブリエラ", "text": "…っ。"},
        { "location": "238/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "どうして？\n明らかに\nお母様じゃないのに。"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "あたしには\nお母様が\n必要なの！"},
        { "location": "243/TALK"  , "narrator": "ガブリエラ", "text": "お母様以外は\n全て不要なの。"},
        { "location": "244/SEL"   , "narrator": "（選択肢）", "text": "今一瞬、手を止めなかった？"},
        { "location": "245/ACT"   , "narrator": "", "text": "今一瞬、手を止めなかった？"},
        { "location": "247/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "249/TALK"  , "narrator": "ガブリエラ", "text": "……そ、そうね。"},
        { "location": "250/SEL"   , "narrator": "（選択肢）", "text": "どうして？"},
        { "location": "251/ACT"   , "narrator": "", "text": "どうして？"},
        { "location": "253/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "254/TALK"  , "narrator": "ガブリエラ", "text": "一瞬、\n本物のお母様だと\n勘違いしたからよ。"},
        { "location": "255/TALK"  , "narrator": "ガブリエラ", "text": "でも見れば一目瞭然、\nどう見ても\nアーヤじゃないの！"},
        { "location": "256/TALK"  , "narrator": "ガブリエラ", "text": "だから撃つ！"},
        { "location": "257/SEL"   , "narrator": "（選択肢）", "text": "待て待て！！"},
        { "location": "258/ACT"   , "narrator": "", "text": "待て待て！！"},
        { "location": "261/TALK"  , "narrator": "ガブリエラ", "text": "どうして！"},
        { "location": "262/SEL"   , "narrator": "（選択肢）", "text": "なんで撃つ必要があるの？"},
        { "location": "263/ACT"   , "narrator": "", "text": "なんで撃つ必要があるの？"},
        { "location": "265/TALK"  , "narrator": "ガブリエラ", "text": "あたしのお母様を\n偽って心を混乱させる\n元凶だからよ！"},
        { "location": "266/TALK"  , "narrator": "ガブリエラ", "text": "……あたし、\nお母様のこと\nよく覚えてないのよ。"},
        { "location": "267/TALK"  , "narrator": "ガブリエラ", "text": "お父様に聞いても\n全然答えて\nくれなかったし。"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "でも、あたしの心には\nお母様が絶対に\n必要なの。"},
        { "location": "280/DIALOG", "narrator": "", "text": "<color=black><size=50><b>母親のことで暴走状態の\nガブリエラを鎮めよ！</b></size></color>\n\n\n\n\n幼い頃に母を失ったガブリエラ。\nその記憶を追いかける彼女は\nいつしか自身の中に\n絶対にたどり着けない虚像を作り出してしまった。\n\n虚像にとりつかれた\nガブリエラを倒し、\n彼女のココロを安定させよう。"}
    ]
}
