{
    "dir": "chap08/daydra/dd_ch05_08_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "8502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "一触即発＜前編＞"
    },
    "entry":
    [
        { "location": "793/TALK"  , "narrator": "神楽", "text": "ふぅ…いいお湯でしたね。"},
        { "location": "795/TALK"  , "narrator": "つばめ", "text": "そうだね。\nわたし、ちょっとだけ\nのぼせちゃったかも…。"},
        { "location": "797/TALK"  , "narrator": "神楽", "text": "ふふっ、私もちょっと、\nイタズラし過ぎちゃった\nかもしれませんね。"},
        { "location": "798/TALK"  , "narrator": "つばめ", "text": "ちょっとじゃないよ。\nすっごく恥ずかしかったん\nだから…。"},
        { "location": "799/TALK"  , "narrator": "神楽", "text": "つばめさんの反応が\n可愛らしくって、\n夢中になっちゃいました。"},
        { "location": "800/TALK"  , "narrator": "つばめ", "text": "もぉ、卯月さんって\nイタズラッ子だよぉ…。"},
        { "location": "801/TALK"  , "narrator": "神楽", "text": "ふふっ…つばめさん、\n今日はもうお帰りですか？"},
        { "location": "802/TALK"  , "narrator": "つばめ", "text": "うん、そうだけど…。\n卯月さんは帰らないの？"},
        { "location": "804/TALK"  , "narrator": "神楽", "text": "はい、まだ劇場で、\nちょっとやることが\nありますので…。"},
        { "location": "805/TALK"  , "narrator": "つばめ", "text": "わたしも手伝うよ。"},
        { "location": "806/TALK"  , "narrator": "神楽", "text": "いえ、すぐ終わるから\n大丈夫です。"},
        { "location": "807/TALK"  , "narrator": "神楽", "text": "早く帰って、ゆっくり\n休んでくださいね。\nお疲れ様でした。"},
        { "location": "808/TALK"  , "narrator": "つばめ", "text": "あ、うん…。\nそれじゃあ卯月さん、\nまたね。"},
        { "location": "812/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "814/TALK"  , "narrator": "神楽", "text": "はぁ…。"},
        { "location": "829/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "830/TALK"  , "narrator": "神楽", "text": "音羽…。"},
        { "location": "841/TALK"  , "narrator": "神楽", "text": "…返事、するはずないか。"},
        { "location": "842/TALK"  , "narrator": "神楽", "text": "音羽のクランは、\nあの子が壊したん\nだから…。"},
        { "location": "843/TALK"  , "narrator": "神楽", "text": "なのに――"},
        { "location": "862/TALK"  , "narrator": "神楽", "text": "…記憶が、ない？"},
        { "location": "863/TALK"  , "narrator": "真幌", "text": "そう…逢瀬は前回、\nフェノメノンが\n出現した際に…。"},
        { "location": "864/TALK"  , "narrator": "真幌", "text": "偶然現場にいて、\n巻き込まれたんだ。"},
        { "location": "865/TALK"  , "narrator": "真幌", "text": "その際に、あいつは\n生身で発症者を\n相手にしただけでなく…。"},
        { "location": "866/TALK"  , "narrator": "真幌", "text": "素手でクランを引き抜き、\n破壊してみせたんだ。"},
        { "location": "867/TALK"  , "narrator": "神楽", "text": "…それだけのことを\nしたのに、つばめさんは\n覚えてないんですか？"},
        { "location": "868/TALK"  , "narrator": "真幌", "text": "そうだ。"},
        { "location": "869/TALK"  , "narrator": "真幌", "text": "病院で検査はしたものの、\n結局原因究明には\n至らなくてな…。"},
        { "location": "870/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "881/TALK"  , "narrator": "透明神楽", "text": "…真幌さんの\n言ってたとおり…。"},
        { "location": "882/TALK"  , "narrator": "透明神楽", "text": "テルマエでも、ドーム戦の\nことは覚えていないと\n言っていた…。"},
        { "location": "883/TALK"  , "narrator": "透明神楽", "text": "あの様子だと、多分…、\nウソはついていないはず。"},
        { "location": "884/TALK"  , "narrator": "透明神楽", "text": "…………。"},
        { "location": "885/TALK"  , "narrator": "透明神楽", "text": "ねえ、音羽…。\n聞こえてる？"},
        { "location": "886/TALK"  , "narrator": "透明神楽", "text": "あなたをこんな目に\n遭わせておきながら…。"},
        { "location": "887/TALK"  , "narrator": "透明神楽", "text": "あの子、なんにも\n覚えていないんだって。"},
        { "location": "888/TALK"  , "narrator": "透明神楽", "text": "それどころか…、\n音羽も聞いてた？"},
        { "location": "889/TALK"  , "narrator": "透明神楽", "text": "音羽のこと、悪さした子、\nって言ったの…。"},
        { "location": "891/TALK"  , "narrator": "透明神楽", "text": "覚えてないからって、\nあんな、きょとんとした\n顔しながら…。"},
        { "location": "905/TALK"  , "narrator": "神楽", "text": "…辛いよ、音羽。"},
        { "location": "906/TALK"  , "narrator": "神楽", "text": "あんな子と…、\n私から家族と、友達を\n奪ったような子と…。"},
        { "location": "907/TALK"  , "narrator": "神楽", "text": "ウソでも、これからも\n仲良くしていかないと\nいけないなんて…。"},
        { "location": "909/TALK"  , "narrator": "神楽", "text": "…私ね、さっき隣の\nお風呂に行ったときに、\nずっと思ってたの。"},
        { "location": "910/TALK"  , "narrator": "神楽", "text": "あの子の背中を\n流しながら、\nずっと…。"},
        { "location": "911/TALK"  , "narrator": "神楽", "text": "このまま、後ろから\n絞め殺してしまいたい\nって…何度も、何度も…。"},
        { "location": "912/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "914/TALK"  , "narrator": "神楽", "text": "私…我慢できないかも。\n心を壊す前に、\nあの子のことを…。"},
        { "location": "963/TALK"  , "narrator": "ぴょんこ", "text": "　"},
        { "location": "978/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこですよ～♪"},
        { "location": "979/SEL"   , "narrator": "", "text": "こんにちは"},
        { "location": "980/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "981/ACT"   , "narrator": "", "text": "こんにちは"},
        { "location": "982/TALK"  , "narrator": "ぴょんこ", "text": "そろそろこの挨拶も\nマンネリ気味ですねっ♪"},
        { "location": "983/TALK"  , "narrator": "ぴょんこ", "text": "でも今回のココロの中は\n脱マンネリですよっ♪"},
        { "location": "984/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "987/TALK"  , "narrator": "ぴょんこ", "text": "気持ちは嬉しいですけど！"},
        { "location": "988/TALK"  , "narrator": "ぴょんこ", "text": "今、私全体が大ピンチで\nそれどころでは\nありませんっ！"},
        { "location": "990/SEL"   , "narrator": "", "text": "一体何が！？"},
        { "location": "991/ACT"   , "narrator": "", "text": "一体何が！？"},
        { "location": "993/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこはもう――"},
        { "location": "994/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんへの\n募る想いが\n抑えられないんですっ！"},
        { "location": "995/SEL"   , "narrator": "", "text": "本気なの！？"},
        { "location": "996/SEL"   , "narrator": "", "text": "おちついておちついて！(ﾊｧﾊｧ"},
        { "location": "997/ACT"   , "narrator": "", "text": "本気なの！？"},
        { "location": "999/TALK"  , "narrator": "ぴょんこ", "text": "本気ですっ！！"},
        { "location": "1000/ACT"  , "narrator": "", "text": "おちついておちついて！(ﾊｧﾊｧ"},
        { "location": "1003/TALK" , "narrator": "ぴょんこ", "text": "むしろお前がおちつけ。"},
        { "location": "1005/TALK" , "narrator": "ぴょんこ", "text": "とにかく、ぴょんこは\n$handle$さんへの\nしゅきしゅきが――"},
        { "location": "1006/TALK" , "narrator": "ぴょんこ", "text": "MAXフリキレで\nもう我慢できないんです！"},
        { "location": "1007/SEL"  , "narrator": "", "text": "嬉しいけど、どうしてそんなにスキなの？"},
        { "location": "1008/SEL"  , "narrator": "", "text": "いやいや冷静に考えてちょっと時期尚早では…？？"},
        { "location": "1009/ACT"  , "narrator": "", "text": "嬉しいけど、どうしてそんなにスキなの？"},
        { "location": "1010/TALK" , "narrator": "ぴょんこ", "text": "もー。全部\n$handle$さんの\nせいなんですよ？"},
        { "location": "1011/TALK" , "narrator": "ぴょんこ", "text": "責任取ってください！"},
        { "location": "1012/ACT"  , "narrator": "", "text": "いやいや冷静に考えてちょっと時期尚早では…？？"},
        { "location": "1013/TALK" , "narrator": "ぴょんこ", "text": "何を他人事みたいに\n言ってるんですかっ！"},
        { "location": "1014/TALK" , "narrator": "ぴょんこ", "text": "$handle$さんには\nちゃんと責任取って\nもらわないと……っ♪"},
        { "location": "1016/SEL"  , "narrator": "", "text": "さすがにちゃんと説明してほしいかな！？"},
        { "location": "1017/SEL"  , "narrator": "", "text": "意味が分かりません＞＜"},
        { "location": "1018/ACT"  , "narrator": "", "text": "さすがにちゃんと説明してほしいかな！？"},
        { "location": "1019/TALK" , "narrator": "ぴょんこ", "text": "ぴょんこもその理由を\nカミングアウトしたいっ！"},
        { "location": "1020/ACT"  , "narrator": "", "text": "意味が分かりません＞＜"},
        { "location": "1021/TALK" , "narrator": "ぴょんこ", "text": "隅から隅まで解るように\n組んずほぐれつ\nカミングアウトしたいっ！"},
        { "location": "1023/TALK" , "narrator": "ぴょんこ", "text": "ハァハァ！！"},
        { "location": "1024/SEL"  , "narrator": "", "text": "おちつけ！！"},
        { "location": "1025/ACT"  , "narrator": "", "text": "おちつけ！！"},
        { "location": "1028/TALK" , "narrator": "ぴょんこ", "text": "ぺったんぺったん♪"},
        { "location": "1029/TALK" , "narrator": "ぴょんこ", "text": "ふぅ。\nちょっと落ち着きました。"},
        { "location": "1030/TALK" , "narrator": "ぴょんこ", "text": "落ち着いたところで、\nうーん、そうですね。"},
        { "location": "1031/TALK" , "narrator": "ぴょんこ", "text": "$handle$さんが\n好きでたまらない\n理由は、多分――"},
        { "location": "1032/TALK" , "narrator": "ぴょんこ", "text": "ぴょんこが\n普通の人格さんじゃ\nないから……"},
        { "location": "1033/TALK" , "narrator": "ぴょんこ", "text": "おおっと！"},
        { "location": "1034/SEL"  , "narrator": "", "text": "今サラッと重大な事を言った気がする"},
        { "location": "1035/ACT"  , "narrator": "", "text": "今サラッと重大な事を言った気がする"},
        { "location": "1037/TALK" , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "1038/TALK" , "narrator": "ぴょんこ", "text": "よくわからないぴょん♪"},
        { "location": "1039/SEL"  , "narrator": "", "text": "それはとぼけてる時の口調だ！"},
        { "location": "1040/SEL"  , "narrator": "", "text": "ぴょんこは普通の人格じゃないの！？"},
        { "location": "1041/ACT"  , "narrator": "", "text": "それはとぼけてる時の口調だ！"},
        { "location": "1043/TALK" , "narrator": "ぴょんこ", "text": "………。"},
        { "location": "1044/TALK" , "narrator": "ぴょんこ", "text": "ククク……\nバレちゃあ\nしょうがねぇな。"},
        { "location": "1045/SEL"  , "narrator": "", "text": "なん…だと…！？"},
        { "location": "1046/ACT"  , "narrator": "", "text": "なん…だと…！？"},
        { "location": "1048/ACT"  , "narrator": "", "text": "ぴょんこは普通の人格じゃないの！？"},
        { "location": "1050/TALK" , "narrator": "ぴょんこ", "text": "………。"},
        { "location": "1051/TALK" , "narrator": "ぴょんこ", "text": "ククク……どうやら\nぴょんこの本性に気づいて\nしまったようだな。"},
        { "location": "1052/SEL"  , "narrator": "", "text": "いや自分で明言してましたよねえ！？"},
        { "location": "1053/ACT"  , "narrator": "", "text": "いや自分で明言してましたよねえ！？"},
        { "location": "1057/TALK" , "narrator": "ぴょんこ", "text": "$handle$さん。\nそこまで核心を突いたら\nもう後戻りはできません。"},
        { "location": "1058/SEL"  , "narrator": "", "text": "望むところだよ"},
        { "location": "1059/SEL"  , "narrator": "", "text": "無理矢理毒を喰わされた気分なんですが"},
        { "location": "1060/ACT"  , "narrator": "", "text": "望むところだよ"},
        { "location": "1061/TALK" , "narrator": "ぴょんこ", "text": "どうして？"},
        { "location": "1062/SEL"  , "narrator": "", "text": "神楽を護るって決めてるから"},
        { "location": "1063/SEL"  , "narrator": "", "text": "面白そうだから"},
        { "location": "1064/ACT"  , "narrator": "", "text": "神楽を護るって決めてるから"},
        { "location": "1067/ACT"  , "narrator": "", "text": "面白そうだから"},
        { "location": "1070/ACT"  , "narrator": "", "text": "無理矢理毒を喰わされた気分なんですが"},
        { "location": "1071/TALK" , "narrator": "ぴょんこ", "text": "その通り。"},
        { "location": "1072/TALK" , "narrator": "ぴょんこ", "text": "もともと\n$handle$さんに\n選択権は無いのですよ。"},
        { "location": "1073/SEL"  , "narrator": "", "text": "そんなことしなくても、神楽のことなら何でも受け入れるよ？"},
        { "location": "1074/SEL"  , "narrator": "", "text": "まあ面白そうだし、いいか"},
        { "location": "1075/ACT"  , "narrator": "", "text": "そんなことしなくても、神楽のことなら何でも受け入れるよ？"},
        { "location": "1079/TALK" , "narrator": "ぴょんこ", "text": "はぁぁぁ……"},
        { "location": "1080/TALK" , "narrator": "ぴょんこ", "text": "その回答はずるいぴょん…"},
        { "location": "1081/TALK" , "narrator": "ぴょんこ", "text": "せっかく腹黒神楽を\n演じられると思ったのに、\n台無しぴょん！"},
        { "location": "1082/ACT"  , "narrator": "", "text": "まあ面白そうだし、いいか"},
        { "location": "1085/TALK" , "narrator": "ぴょんこ", "text": "エー。"},
        { "location": "1086/TALK" , "narrator": "ぴょんこ", "text": "なんか\nやる気無くしたぴょん。"},
        { "location": "1087/TALK" , "narrator": "ぴょんこ", "text": "まあいいや。\n面倒くさいから\nもうネタバレる。"},
        { "location": "1090/TALK" , "narrator": "ぴょんこ", "text": "ていうか、真面目に\nそろそろカミングアウト\nしたかったので。"},
        { "location": "1091/TALK" , "narrator": "ぴょんこ", "text": "いい機会なので\nぴょんこの秘密を\n大公開しちゃいます♪"},
        { "location": "1092/SEL"  , "narrator": "", "text": "なになに！？！？"},
        { "location": "1093/SEL"  , "narrator": "", "text": "正座待機"},
        { "location": "1094/ACT"  , "narrator": "", "text": "なになに！？！？"},
        { "location": "1095/TALK" , "narrator": "ぴょんこ", "text": "もちつけ\nぺったん。"},
        { "location": "1096/ACT"  , "narrator": "", "text": "正座待機"},
        { "location": "1097/TALK" , "narrator": "ぴょんこ", "text": "紳士さんですねっ♪"},
        { "location": "1099/TALK" , "narrator": "ぴょんこ", "text": "それでは\n発表するぴょん♪"},
        { "location": "1100/TALK" , "narrator": "ぴょんこ", "text": "実はですね、\nぴょんこはですねっ！"},
        { "location": "1103/TALK" , "narrator": "ぴょんこ", "text": "<size=30>ハーフ人格なんですっ！</size>"},
        { "location": "1104/SEL"  , "narrator": "", "text": "えっ"},
        { "location": "1105/SEL"  , "narrator": "", "text": "どういうこと！？"},
        { "location": "1106/ACT"  , "narrator": "", "text": "えっ"},
        { "location": "1107/ACT"  , "narrator": "", "text": "どういうこと！？"},
        { "location": "1109/TALK" , "narrator": "ぴょんこ", "text": "そのまんまの\n意味ですぴょん。"},
        { "location": "1110/TALK" , "narrator": "ぴょんこ", "text": "まあそんなわけですし、\nせっかくですから、\n紹介しておきますね♪"},
        { "location": "1128/TALK" , "narrator": "ぴょんこ", "text": "ぴょんこのもう一人の\n主である、セルフクランの\nスピネルさんで～す♪"},
        { "location": "1129/SEL"  , "narrator": "", "text": "そうきたか！！"},
        { "location": "1130/SEL"  , "narrator": "", "text": "えええええっ！！"},
        { "location": "1131/ACT"  , "narrator": "", "text": "そうきたか！！"},
        { "location": "1132/TALK" , "narrator": "ぴょんこ", "text": "そうなんですよっ♪"},
        { "location": "1133/ACT"  , "narrator": "", "text": "えええええっ！！"},
        { "location": "1134/TALK" , "narrator": "ぴょんこ", "text": "やりました～っ！\nドッキリ大成功ですっ♪"},
        { "location": "1135/TALK" , "narrator": "ぴょんこ", "text": "いや、もちろん\n本当のことですけど♪"},
        { "location": "1137/TALK" , "narrator": "ぴょんこ", "text": "というわけなので！"},
        { "location": "1138/TALK" , "narrator": "ぴょんこ", "text": "ぴょんこの\n$handle$さん\nしゅきしゅきは必然！"},
        { "location": "1139/SEL"  , "narrator": "", "text": "だからそこが繋がらないんだってば！"},
        { "location": "1140/ACT"  , "narrator": "", "text": "だからそこが繋がらないんだってば！"},
        { "location": "1142/TALK" , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "1143/TALK" , "narrator": "ぴょんこ", "text": "だって……"},
        { "location": "1145/TALK" , "narrator": "ぴょんこ", "text": "スピネルママとまた\n一緒になれたのは、\nあなたのお陰だから。"},
        { "location": "1146/SEL"  , "narrator": "", "text": "えっ！？"},
        { "location": "1147/ACT"  , "narrator": "", "text": "えっ！？"},
        { "location": "1151/TALK" , "narrator": "ぴょんこ", "text": "あなたがスピネルママの\n隔離拘束を解除して、私と\n再会させてくれたんです。"},
        { "location": "1152/TALK" , "narrator": "ぴょんこ", "text": "もう覚えていませんか？"},
        { "location": "1153/TALK" , "narrator": "ぴょんこ", "text": "私は直接立ち会って\nいませんけど、千羽鶴が\n立ち会ったと聞きました。"},
        { "location": "1154/SEL"  , "narrator": "", "text": "チュートリアルバトルのことか"},
        { "location": "1155/ACT"  , "narrator": "", "text": "チュートリアルバトルのことか"},
        { "location": "1158/TALK" , "narrator": "ぴょんこ", "text": "多分それですっ！\nぴょんこはあまり詳しく\n知りませんけど。"},
        { "location": "1159/TALK" , "narrator": "ぴょんこ", "text": "だから、\nぴょんこにとっては\n$handle$さんは――"},
        { "location": "1160/TALK" , "narrator": "ぴょんこ", "text": "母とぴょんこを\n再会させてくれた\n恩人なんですっ！"},
        { "location": "1161/TALK" , "narrator": "ぴょんこ", "text": "わりとマジで。"},
        { "location": "1162/TALK" , "narrator": "ぴょんこ", "text": "貴方のことを好きな理由も\n名前を隠すつもりがない\n理由も――"},
        { "location": "1165/TALK" , "narrator": "ぴょんこ", "text": "これで分かって\nもらえましたかっ！"},
        { "location": "1168/TALK" , "narrator": "ぴょんこ", "text": "そこには一切\n裏なんてありませんっ！"},
        { "location": "1171/TALK" , "narrator": "ぴょんこ", "text": "あるのは愛！！"},
        { "location": "1174/TALK" , "narrator": "ぴょんこ", "text": "只ひたすら純粋な\n愛があるだけっ！"},
        { "location": "1175/SEL"  , "narrator": "", "text": "お、おう…"},
        { "location": "1176/SEL"  , "narrator": "", "text": "まだわからない事だらけだ"},
        { "location": "1177/ACT"  , "narrator": "", "text": "お、おう…"},
        { "location": "1178/TALK" , "narrator": "ぴょんこ", "text": "よかったですぴょん♪"},
        { "location": "1179/TALK" , "narrator": "ぴょんこ", "text": "これで、これからは\n心置きなくラブラブ\nできますねっ♪"},
        { "location": "1180/ACT"  , "narrator": "", "text": "まだわからない事だらけだ"},
        { "location": "1181/TALK" , "narrator": "ぴょんこ", "text": "そうですよねっ！"},
        { "location": "1182/TALK" , "narrator": "ぴょんこ", "text": "でもそれは、\nこれから少しずつ\n知っていってください♪"},
        { "location": "1183/TALK" , "narrator": "ぴょんこ", "text": "$handle$さんと\nぴょんこの旅は、今\n始まったばかりなのだから！"},
        { "location": "1185/SEL"  , "narrator": "", "text": "ところで、スピネルは眠ってるの？"},
        { "location": "1186/SEL"  , "narrator": "", "text": "スピネルお義母さんに、改めてご挨拶させてください"},
        { "location": "1187/ACT"  , "narrator": "", "text": "ところで、スピネルは眠ってるの？"},
        { "location": "1188/TALK" , "narrator": "ぴょんこ", "text": "実はそうなのだぴょん。"},
        { "location": "1189/TALK" , "narrator": "ぴょんこ", "text": "スピネルママは今は\n眠り姫なのだぴょん。"},
        { "location": "1190/TALK" , "narrator": "ぴょんこ", "text": "目覚めたら是非、\n$handle$さんには\nご挨拶してもらうぴょん♪"},
        { "location": "1191/ACT"  , "narrator": "", "text": "スピネルお義母さんに、改めてご挨拶させてください"},
        { "location": "1193/TALK" , "narrator": "ぴょんこ", "text": "ぴょんこも是非\nそうして欲しいですっ！"},
        { "location": "1194/TALK" , "narrator": "ぴょんこ", "text": "けれども今、\nスピネルママは、深い\n眠りに落ちてるぴょん。"},
        { "location": "1195/TALK" , "narrator": "ぴょんこ", "text": "だから、\n目覚めたら是非\nお願いするぴょん♪"},
        { "location": "1197/TALK" , "narrator": "ぴょんこ", "text": "というわけで、\nぴょんこのカミングアウト\n大会でした～っ！"},
        { "location": "1198/TALK" , "narrator": "ぴょんこ", "text": "はぁ～～っ。\n全部ぶちまけたら\nスッキリしました♪"},
        { "location": "1199/SEL"  , "narrator": "", "text": "よかったね"},
        { "location": "1200/SEL"  , "narrator": "", "text": "こっちがモヤモヤしてるよ！"},
        { "location": "1201/ACT"  , "narrator": "", "text": "よかったね"},
        { "location": "1202/ACT"  , "narrator": "", "text": "こっちがモヤモヤしてるよ！"},
        { "location": "1203/TALK" , "narrator": "ぴょんこ", "text": "ククク♪"},
        { "location": "1205/TALK" , "narrator": "ぴょんこ", "text": "それでですね。"},
        { "location": "1206/TALK" , "narrator": "ぴょんこ", "text": "スッキリついでに\n思い出したんですけど――"},
        { "location": "1207/SEL"  , "narrator": "", "text": "どうしたの？"},
        { "location": "1208/ACT"  , "narrator": "", "text": "どうしたの？"},
        { "location": "1210/TALK" , "narrator": "ぴょんこ", "text": "うちら、仕事しようず。\nすっかり忘れてたぴょん。"},
        { "location": "1211/SEL"  , "narrator": "", "text": "そうだった"},
        { "location": "1212/SEL"  , "narrator": "", "text": "忘れんなよｗ"},
        { "location": "1213/ACT"  , "narrator": "", "text": "そうだった"},
        { "location": "1214/ACT"  , "narrator": "", "text": "忘れんなよ…"},
        { "location": "1216/TALK" , "narrator": "ぴょんこ", "text": "急いでゲートに\n戻るぴょん！"},
        { "location": "1235/TALK" , "narrator": "ぴょんこ", "text": "わわわっ！\nなにこれすごい！"},
        { "location": "1236/SEL"  , "narrator": "", "text": "まずいことになってない？"},
        { "location": "1237/ACT"  , "narrator": "", "text": "まずいことになってない？"},
        { "location": "1239/TALK" , "narrator": "ぴょんこ", "text": "とにかく扉を\n回してみるぴょん！"},
        { "location": "1243/TALK" , "narrator": "ぴょんこ", "text": "オープンプロセス、\n2x445番地から\n2x9BC番地へ。"},
        { "location": "1268/TALK" , "narrator": "ぴょんこ", "text": "シーク完了ぴょん！"},
        { "location": "1269/TALK" , "narrator": "ぴょんこ", "text": "というわけで、\n今回の心の葛藤は…？"},
        { "location": "1271/TALK" , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "1272/TALK" , "narrator": "ぴょんこ", "text": "うわ、やっべ……。"},
        { "location": "1273/TALK" , "narrator": "ぴょんこ", "text": "しゅきしゅき\n言ってる場合じゃ\nなかったぴょん……。"},
        { "location": "1274/TALK" , "narrator": "ぴょんこ", "text": "つばめさんを\n○したい衝動に\n駆られてる……。"},
        { "location": "1275/SEL"  , "narrator": "", "text": "何とかしないと！"},
        { "location": "1276/ACT"  , "narrator": "", "text": "何とかしないと！"},
        { "location": "1278/TALK" , "narrator": "ぴょんこ", "text": "大丈夫ぴょん！"},
        { "location": "1279/TALK" , "narrator": "ぴょんこ", "text": "まだあわてるような\n時間じゃないぴょん……！"},
        { "location": "1280/SEL"  , "narrator": "", "text": "ほんとに！？"},
        { "location": "1281/SEL"  , "narrator": "", "text": "それ言うときって割と絶望的な時なんですけどｗ"},
        { "location": "1282/ACT"  , "narrator": "", "text": "ほんとに！？"},
        { "location": "1283/TALK" , "narrator": "ぴょんこ", "text": "ほんとですぴょん♪"},
        { "location": "1284/ACT"  , "narrator": "", "text": "それ言うときって割と絶望的な時なんですけどｗ"},
        { "location": "1285/TALK" , "narrator": "ぴょんこ", "text": "大丈夫ぴょん！"},
        { "location": "1286/TALK" , "narrator": "ぴょんこ", "text": "今回は本当にまだ\nあわてなくて\n平気ぴょん。"},
        { "location": "1289/TALK" , "narrator": "ぴょんこ", "text": "ぴょんこ\nうそつかない。"},
        { "location": "1290/SEL"  , "narrator": "", "text": "目が泳いでるよ！！"},
        { "location": "1291/ACT"  , "narrator": "", "text": "目が泳いでるよ！！"},
        { "location": "1294/TALK" , "narrator": "ぴょんこ", "text": "そんなことないぴょん♪\nだって――"},
        { "location": "1295/TALK" , "narrator": "ぴょんこ", "text": "愛する$handle$が\nきっと、\n何とかしてくれるもん♪"},
        { "location": "1296/SEL"  , "narrator": "", "text": "そこかよ！！"},
        { "location": "1297/ACT"  , "narrator": "", "text": "そこかよ！！"},
        { "location": "1299/TALK" , "narrator": "ぴょんこ", "text": "つーわけで、\nヨロシク★マイラバ～♪"},
        { "location": "1300/TALK" , "narrator": "ぴょんこ", "text": "ぴょんこと\n$handle$さんに\n最高なココロの旅を♪"},
        { "location": "791/DIALOG", "narrator": "Dialog_EventData", "text": "<color=green>5月9日　7:45 PM</color>\n高校でのフェノメノン戦の後、劇場横の銭湯にて。"},
        { "location": "928/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "930/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "932/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "934/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "936/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
