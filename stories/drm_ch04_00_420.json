        { "location": "7/SCENARIO", "narrator": "", "text": "330_退いて媚びて省みよ"},
        { "location": "19/TALK"   , "narrator": "ラビットアニマ", "text": "もしもーし"},
        { "location": "20/TALK"   , "narrator": "ラビットアニマ", "text": "いませんか？"},
        { "location": "21/TALK"   , "narrator": "ラビットアニマ", "text": "いたらすぐに"},
        { "location": "22/TALK"   , "narrator": "ラビットアニマ", "text": "お返事ください"},
        { "location": "24/SEL"    , "narrator": "", "text": "いないし"},
        { "location": "25/SEL"    , "narrator": "", "text": "また後でね"},
        { "location": "26/SEL"    , "narrator": "", "text": "みやびのことだよね？"},
        { "location": "27/ACT"    , "narrator": "", "text": "いないし"},
        { "location": "29/TALK"   , "narrator": "ラビットアニマ", "text": "いえ"},
        { "location": "30/TALK"   , "narrator": "ラビットアニマ", "text": "冗談はいいです"},
        { "location": "31/ACT"    , "narrator": "", "text": "また後でね"},
        { "location": "33/TALK"   , "narrator": "ラビットアニマ", "text": "少しだけです"},
        { "location": "34/TALK"   , "narrator": "ラビットアニマ", "text": "時間をください"},
        { "location": "35/ACT"    , "narrator": "", "text": "みやびのことだよね？"},
        { "location": "46/TALK"   , "narrator": "ラビットアニマ", "text": "そうです"},
        { "location": "47/TALK"   , "narrator": "ラビットアニマ", "text": "みやびさんのことです"},
        { "location": "49/TALK"   , "narrator": "ラビットアニマ", "text": "助かります"},
        { "location": "50/TALK"   , "narrator": "ラビットアニマ", "text": "話が早くて"},
        { "location": "52/TALK"   , "narrator": "ラビットアニマ", "text": "彼女が落ち込んでいる理由を知っていますか？"},
        { "location": "54/SEL"    , "narrator": "", "text": "知ってる"},
        { "location": "55/SEL"    , "narrator": "", "text": "見当はついてる"},
        { "location": "56/SEL"    , "narrator": "", "text": "知らない"},
        { "location": "57/ACT"    , "narrator": "", "text": "知ってる"},
        { "location": "59/TALK"   , "narrator": "ラビットアニマ", "text": "知ってるんですね"},
        { "location": "60/ACT"    , "narrator": "", "text": "見当はついてる"},
        { "location": "62/TALK"   , "narrator": "ラビットアニマ", "text": "だったら"},
        { "location": "63/ACT"    , "narrator": "", "text": "知らない"},
        { "location": "65/TALK"   , "narrator": "ラビットアニマ", "text": "本当に？"},
        { "location": "68/TALK"   , "narrator": "ラビットアニマ", "text": "あなたはみやびさんのために何かしましたか？"},
        { "location": "70/SEL"    , "narrator": "", "text": "一応聞いたよ"},
        { "location": "71/SEL"    , "narrator": "", "text": "してないな"},
        { "location": "72/SEL"    , "narrator": "", "text": "そっとしといた方がいいんじゃない"},
        { "location": "73/ACT"    , "narrator": "", "text": "一応聞いたよ"},
        { "location": "75/TALK"   , "narrator": "ラビットアニマ", "text": "一応ですか"},
        { "location": "76/ACT"    , "narrator": "", "text": "してないな"},
        { "location": "78/TALK"   , "narrator": "ラビットアニマ", "text": "どうして"},
        { "location": "79/ACT"    , "narrator": "", "text": "そっとしといた方がいいんじゃない"},
        { "location": "81/TALK"   , "narrator": "ラビットアニマ", "text": "わかってないですね"},
        { "location": "84/TALK"   , "narrator": "ラビットアニマ", "text": "あの人は"},
        { "location": "85/TALK"   , "narrator": "ラビットアニマ", "text": "口に出して助けを求めるタイプじゃない"},
        { "location": "86/TALK"   , "narrator": "ラビットアニマ", "text": "それはわかってますよね？"},
        { "location": "88/SEL"    , "narrator": "", "text": "知ってるよ"},
        { "location": "89/SEL"    , "narrator": "", "text": "まあね"},
        { "location": "90/ACT"    , "narrator": "", "text": "知ってるよ"},
        { "location": "92/TALK"   , "narrator": "ラビットアニマ", "text": "知らないはずがないですよね"},
        { "location": "93/ACT"    , "narrator": "", "text": "まあね"},
        { "location": "95/TALK"   , "narrator": "ラビットアニマ", "text": "当然知ってますよね"},
        { "location": "98/TALK"   , "narrator": "ラビットアニマ", "text": "でもあなたは"},
        { "location": "99/TALK"   , "narrator": "ラビットアニマ", "text": "みやびさんの気持ちを"},
        { "location": "100/TALK"  , "narrator": "ラビットアニマ", "text": "浮上させる手段を知っているはずです"},
        { "location": "101/TALK"  , "narrator": "ラビットアニマ", "text": "助けてほしい内容を知っているはずです"},
        { "location": "103/SEL"   , "narrator": "", "text": "当直を代わって欲しいらしいよ"},
        { "location": "104/ACT"   , "narrator": "", "text": "当直を代わって欲しいらしいよ"},
        { "location": "107/TALK"  , "narrator": "ラビットアニマ", "text": "それをあなたが代行することはできませんか？"},
        { "location": "109/SEL"   , "narrator": "", "text": "無理かな"},
        { "location": "110/SEL"   , "narrator": "", "text": "交渉してみる"},
        { "location": "111/ACT"   , "narrator": "", "text": "無理かな"},
        { "location": "113/TALK"  , "narrator": "ラビットアニマ", "text": "無理なんですか？"},
        { "location": "115/SEL"   , "narrator": "", "text": "頼めそうな相手を探すよ"},
        { "location": "116/ACT"   , "narrator": "", "text": "頼めそうな相手を探すよ"},
        { "location": "118/TALK"  , "narrator": "ラビットアニマ", "text": "よかった"},
        { "location": "119/TALK"  , "narrator": "ラビットアニマ", "text": "絶対ですよ！"},
        { "location": "120/TALK"  , "narrator": "ラビットアニマ", "text": "お願いします。"},
        { "location": "122/ACT"   , "narrator": "", "text": "交渉してみる"},
        { "location": "124/TALK"  , "narrator": "ラビットアニマ", "text": "できることがあるんですね"},
        { "location": "125/TALK"  , "narrator": "ラビットアニマ", "text": "頼みます"},
        { "location": "126/TALK"  , "narrator": "ラビットアニマ", "text": "本当に"},
        { "location": "129/TALK"  , "narrator": "ラビットアニマ", "text": "あんなみやびさんを見るのは"},
        { "location": "130/TALK"  , "narrator": "ラビットアニマ", "text": "辛いですから"},
        { "location": "131/TALK"  , "narrator": "ラビットアニマ", "text": "私だって"},
