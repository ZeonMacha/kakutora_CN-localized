{
    "dir": "chap09/daydra/dd_ch03_09_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "9352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "初めての映画"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "初めての映画"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "わぁ……。"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "新人！　放映中に\n劇場の中を覗かない！"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "せんぱい、今やってる\n映画凄いですよ！\nなんか凄く不思議なの。"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "音楽は流れてるのに、\n声が入ってないんです！"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "サイレント映画なんだから\n当然じゃない。"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "…サイレント映画？"},
        { "location": "43/TALK"   , "narrator": "真幌", "text": "逢瀬、まさかサイレント\n映画を知らんのか？"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "は、はい…\n初めて聞きました。"},
        { "location": "48/TALK"   , "narrator": "真幌", "text": "…信じられん。\n今の世代はみんな\nそうなのか？"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "私も、知ってはいるけど\n見たことはないです。"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "同じく、見たことないわ。"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "白黒映画すら中々見ない\n時代やき、不思議では\nないな。"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、今更そんな\n昔の映画見たいなんて\n思わないでしょ。"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "そもそも声が無いのに\nどう楽しめっていうのよ？"},
        { "location": "62/TALK"   , "narrator": "真幌", "text": "ギャヴィ、\nそれは大間違いだぞ。"},
        { "location": "63/TALK"   , "narrator": "真幌", "text": "声が無くとも役者の演技を\n見ていれば、何をしようと\nしているのか――"},
        { "location": "64/TALK"   , "narrator": "真幌", "text": "そして何を言っているのか\nまでわかってしまうのが、\nサイレント映画だ。"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "声が無いのに、そこまで\nわかっちゃうんですか！？"},
        { "location": "68/TALK"   , "narrator": "真幌", "text": "信じられないか？\nまあ、見たことがないなら\n仕方がないが…。"},
        { "location": "70/TALK"   , "narrator": "真幌", "text": "…よし決めた。"},
        { "location": "72/TALK"   , "narrator": "真幌", "text": "今夜はおまえ等のために、\n特別上映してやろう！"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "本当ですか！？\nやったぁ！！"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "そこ、喜ぶところ？\n今更サイレント映画とか、\n楽しめるわけないじゃん。"},
        { "location": "78/TALK"   , "narrator": "真幌", "text": "文句は見てから言え。"},
        { "location": "80/TALK"   , "narrator": "真幌", "text": "とはいえ、今放映してる\n映画は少し難しい映画\nだからな――"},
        { "location": "81/TALK"   , "narrator": "真幌", "text": "どういうのが見たいか\nリクエストがあれば\n言ってみろ。"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "リクエストかぁ。\nう～ん……"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "やっぱり、最初は有名な\n映画から見たいかも。"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "いや、サイレント映画\nいうたらやっぱホラー\n一択やき。"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "っ！？"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "声付きの映画とは比べ物に\nならんくらい不気味で\n楽しいんよ。"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "な、何言ってるの！\nサイレント映画といったら\nほら、あれよ…。"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "そう、コメディ！\n私はコメディを見て\nみたいわ。"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "怖いんは苦手か？"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "そうなんですか？"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "ま、まさか！\n映画程度で怖がるような\n年齢じゃないわ。"},
        { "location": "106/TALK"  , "narrator": "真幌", "text": "盛り上がるのは構わんが、\n三本も見たら夜中になって\nしまうぞ。"},
        { "location": "108/TALK"  , "narrator": "真幌", "text": "ギャヴィ、今の中だったら\nどれを見たい？"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "あたしが決めるの！？"},
        { "location": "110/TALK"  , "narrator": "真幌", "text": "最後まで何も言わなかった\nおまえが悪い。\nほら、さっさと言え。"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、ちょっと待って。\n今、少し調べるから…。"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "どうしよう、マルザンナ！"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "どんなサイレント映画を見るかで、話し合っていたんだけど"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "あたしが何を見るかを決めることになっちゃったの"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "見たことないあたしにわかるわけないじゃん！"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "だから、あたしが楽しめそうなのを一緒に考えてほしいの"},
        { "location": "130/SEL"   , "narrator": "", "text": "苦手なジャンルはある？"},
        { "location": "131/ACT"   , "narrator": "", "text": "苦手なジャンルはある？"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "特にないわ"},
        { "location": "135/SEL"   , "narrator": "", "text": "有名なのでいいと思う"},
        { "location": "136/SEL"   , "narrator": "", "text": "ホラーがいいよ"},
        { "location": "137/SEL"   , "narrator": "", "text": "時代劇なんかは？"},
        { "location": "138/ACT"   , "narrator": "", "text": "有名なのでいいと思う"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "それだと、新人のリクエストと被るんだけど…"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "まあいいわ"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "どうせ見るならあたしも\n楽しい方がいいし――"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "有名どころが一番無難\nかもしれないわね。"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "あたしも新人に賛成。\nやっぱり最初は有名\nなのから見たいわ。"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "やった！\nありがと、せんぱい。"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "あんたに賛成した\nわけじゃないって。"},
        { "location": "160/TALK"  , "narrator": "真幌", "text": "よし、決まりだな。"},
        { "location": "161/TALK"  , "narrator": "真幌", "text": "上映時刻は業務終了の\n十五分後だ。"},
        { "location": "163/TALK"  , "narrator": "真幌", "text": "全員遅れるなよ！"},
        { "location": "164/ACT"   , "narrator": "", "text": "ホラーがいいよ"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "ホラーね、わかったわ"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "それじゃホラーで。"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ！？"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "閉館後の夜の映画館で\n見るのに、一番ピッタリ\nだと思うし――"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "ホラー映画が怖いって人も\nいないみたいだから、\n問題ないでしょ？"},
        { "location": "194/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "206/TALK"  , "narrator": "アーヤ", "text": "たすけｒｒ"},
        { "location": "208/TALK"  , "narrator": "アーヤ", "text": "たすけたえ"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "たけすてれえ"},
        { "location": "210/SEL"   , "narrator": "", "text": "落ち着け！"},
        { "location": "211/ACT"   , "narrator": "", "text": "落ち着け！"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "ホラー映画嫌い！"},
        { "location": "216/TALK"  , "narrator": "アーヤ", "text": "絶対泣いちゃうよー(；△；)"},
        { "location": "218/SEL"   , "narrator": "", "text": "声がないから怖くないよ"},
        { "location": "219/SEL"   , "narrator": "", "text": "あれれ、怖いの？"},
        { "location": "220/SEL"   , "narrator": "", "text": "時代劇を提案しよう"},
        { "location": "221/ACT"   , "narrator": "", "text": "声がないから怖くないよ"},
        { "location": "222/TALK"  , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "223/TALK"  , "narrator": "アーヤ", "text": "みやびは不気味って言ってた"},
        { "location": "224/TALK"  , "narrator": "アーヤ", "text": "私を怖がらせようとしただけ？"},
        { "location": "225/TALK"  , "narrator": "アーヤ", "text": "不安だよー！！"},
        { "location": "237/TALK"  , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "239/TALK"  , "narrator": "つばめ", "text": "アーヤさん、\nどうかしたんですか？"},
        { "location": "242/TALK"  , "narrator": "アーヤ", "text": "う、ううん、別に…。"},
        { "location": "245/TALK"  , "narrator": "アーヤ", "text": "でも、そうよね。\n古いし声も無いんだから、\nそんなに怖くないはずよ。"},
        { "location": "246/TALK"  , "narrator": "真幌", "text": "じゃあ、ホラー映画で\n決まりだな。"},
        { "location": "248/TALK"  , "narrator": "みやび", "text": "楽しみやな。"},
        { "location": "249/TALK"  , "narrator": "ガブリエラ", "text": "まあ、声の無いホラー映画\nなんて、たかが知れてる\nだろうけど。"},
        { "location": "252/TALK"  , "narrator": "真幌", "text": "ふふっ…甘いなギャヴィ。"},
        { "location": "255/TALK"  , "narrator": "真幌", "text": "サイレント映画のホラーは\nそんなに甘くないぞ。"},
        { "location": "256/TALK"  , "narrator": "真幌", "text": "体調不良はもちろん、\n失神する者まで出すものも\nあるからな。"},
        { "location": "258/TALK"  , "narrator": "ガブリエラ", "text": "そんなに怖いの！？"},
        { "location": "259/TALK"  , "narrator": "真幌", "text": "生半可な気持ちで挑むと\nおまえ達もそうなるぞ。\n覚悟しておけ。"},
        { "location": "260/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "264/TALK"  , "narrator": "アーヤ", "text": "目を瞑るだけで乗り切る\n自信、なくなってきた…。"},
        { "location": "265/ACT"   , "narrator": "", "text": "あれれ、怖いの？"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "怖いから助けてほしかったのに"},
        { "location": "268/TALK"  , "narrator": "アーヤ", "text": "もういい、バカ！"},
        { "location": "281/TALK"  , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "283/TALK"  , "narrator": "つばめ", "text": "アーヤさん、\nどうかしたんですか？"},
        { "location": "285/TALK"  , "narrator": "アーヤ", "text": "う、ううん、別に…。"},
        { "location": "286/TALK"  , "narrator": "真幌", "text": "じゃあ、ホラー映画で\n決まりだな。"},
        { "location": "288/TALK"  , "narrator": "みやび", "text": "楽しみやな。"},
        { "location": "290/TALK"  , "narrator": "ガブリエラ", "text": "まあ、声の無いホラー映画\nなんて、たかが知れてる\nだろうけど。"},
        { "location": "292/TALK"  , "narrator": "真幌", "text": "ふふっ…甘いなギャヴィ。"},
        { "location": "293/TALK"  , "narrator": "真幌", "text": "サイレント映画のホラーは\nそんなに甘くないぞ。"},
        { "location": "294/TALK"  , "narrator": "真幌", "text": "体調不良はもちろん、\n失神する者まで出すものも\nあるからな。"},
        { "location": "296/TALK"  , "narrator": "ガブリエラ", "text": "そ、そんなに怖いの！？"},
        { "location": "297/TALK"  , "narrator": "真幌", "text": "生半可な気持ちで挑むと\nおまえ達もそうなるぞ。\n覚悟しておけ。"},
        { "location": "298/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "302/TALK"  , "narrator": "アーヤ", "text": "目を瞑るだけで乗り切る\n自信、なくなってきた…。"},
        { "location": "303/ACT"   , "narrator": "", "text": "時代劇を提案しよう"},
        { "location": "305/TALK"  , "narrator": "アーヤ", "text": "最高！　その案頂くわ！"},
        { "location": "317/TALK"  , "narrator": "アーヤ", "text": "館長！"},
        { "location": "318/TALK"  , "narrator": "アーヤ", "text": "やっぱり私、時代劇が\n見たいです！"},
        { "location": "322/TALK"  , "narrator": "ガブリエラ", "text": "えっ、そんなのあるの？"},
        { "location": "323/TALK"  , "narrator": "真幌", "text": "チャンバラ映画か？\nそれなら有り余るほど\n所有しているが…。"},
        { "location": "326/TALK"  , "narrator": "ガブリエラ", "text": "や、やっぱりあたしも\n時代劇の方がいい！"},
        { "location": "327/TALK"  , "narrator": "真幌", "text": "よし、それじゃあ\nチャンバラ映画で\n決まりだ！"},
        { "location": "330/TALK"  , "narrator": "アーヤ", "text": "ほっ…。"},
        { "location": "332/TALK"  , "narrator": "ガブリエラ", "text": "サイレント映画で見る\n時代劇…。"},
        { "location": "333/TALK"  , "narrator": "ガブリエラ", "text": "どんな感じなんだろ？\n早く見てみたいわ。"},
        { "location": "335/ACT"   , "narrator": "", "text": "時代劇なんかは？"},
        { "location": "337/TALK"  , "narrator": "ガブリエラ", "text": "あら、時代劇まであるの？"},
        { "location": "338/TALK"  , "narrator": "ガブリエラ", "text": "それは一度見てみたいわ"},
        { "location": "349/TALK"  , "narrator": "ガブリエラ", "text": "まほ、時代劇はある？"},
        { "location": "351/TALK"  , "narrator": "真幌", "text": "当然だ。\n山ほどあるぞ。"},
        { "location": "352/TALK"  , "narrator": "ガブリエラ", "text": "だったら、あたしは\n時代劇がいいわ。"},
        { "location": "353/TALK"  , "narrator": "真幌", "text": "候補を増やしてどうする。\n三つの中から一つを選べと\n言ってるだろ？"},
        { "location": "356/TALK"  , "narrator": "つばめ", "text": "あ、じゃあわたしも\n時代劇に一票です。"},
        { "location": "358/TALK"  , "narrator": "真幌", "text": "ん？　そうか…では\n今夜の映画は時代劇に\n決まりだ。"},
        { "location": "360/TALK"  , "narrator": "真幌", "text": "ギャヴィ、最高に面白い\n映画を選んでやるから、\n楽しみにしていろ。"},
        { "location": "363/TALK"  , "narrator": "ガブリエラ", "text": "そんなに昔の時代劇を\n見るのって初めてだわ。"},
        { "location": "365/TALK"  , "narrator": "ガブリエラ", "text": "ふふっ、早く見たいな。"},
        { "location": "18/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月19日　6:11 PM</color>\nとある平日、神楽坂トライナリー劇場でのバイトの最中のこと。"},
        { "location": "376/DIALOG", "narrator": "Dialog_GEThimegoto_ch03", "text": "【饒舌なるサイレントムービー】"}
    ]
}
