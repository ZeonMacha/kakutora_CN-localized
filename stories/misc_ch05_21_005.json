    "entry":
    [
        { "location": "6883/SCENARIO", "narrator": "", "text": "アキバロードに花の散る"},
        { "location": "6910/TALK"    , "narrator": "神楽", "text": "アキバと言えば"},
        { "location": "6911/TALK"    , "narrator": "神楽", "text": "アキバ・ベン・ヨセフのことだと思うのだけれど"},
        { "location": "6913/SEL"     , "narrator": "", "text": "誰！？"},
        { "location": "6914/SEL"     , "narrator": "", "text": "いや知らないけど…"},
        { "location": "6915/SEL"     , "narrator": "", "text": "アキバの女王は神楽じゃないの？"},
        { "location": "6916/ACT"     , "narrator": "", "text": "誰！？"},
        { "location": "6917/TALK"    , "narrator": "神楽", "text": "アキバ・ベン・ヨセフ師"},
        { "location": "6918/ACT"     , "narrator": "", "text": "いや知らないけど…"},
        { "location": "6919/TALK"    , "narrator": "神楽", "text": "またまたご冗談を"},
        { "location": "6920/ACT"     , "narrator": "", "text": "アキバの女王は神楽じゃないの？"},
        { "location": "6922/TALK"    , "narrator": "神楽", "text": "うわ微妙ｗｗｗ"},
        { "location": "6923/TALK"    , "narrator": "神楽", "text": "うれしくないわーｗｗｗ"},
        { "location": "6924/TALK"    , "narrator": "神楽", "text": "でもうれしいかも？？？"},
        { "location": "6926/TALK"    , "narrator": "神楽", "text": "アキバ・ベン・ヨセフは"},
        { "location": "6927/TALK"    , "narrator": "神楽", "text": "ラビ・アキバとも呼ばれてるんだぴょん"},
        { "location": "6929/SEL"     , "narrator": "", "text": "だから誰！？"},
        { "location": "6930/SEL"     , "narrator": "", "text": "有名人なの？？？"},
        { "location": "6931/SEL"     , "narrator": "", "text": "すみません知りません"},
        { "location": "6932/ACT"     , "narrator": "", "text": "だから誰！？"},
        { "location": "6933/TALK"    , "narrator": "神楽", "text": "アキバ・ベン・ヨセフだってば"},
        { "location": "6934/ACT"     , "narrator": "", "text": "有名人なの？？？"},
        { "location": "6935/TALK"    , "narrator": "神楽", "text": "紀元二世紀頃は有名人だった"},
        { "location": "6936/ACT"     , "narrator": "", "text": "すみません知りません"},
        { "location": "6937/TALK"    , "narrator": "神楽", "text": "だよね！"},
        { "location": "6939/TALK"    , "narrator": "神楽", "text": "いや大昔の偉人ていうか宗教家？？？"},
        { "location": "6940/TALK"    , "narrator": "神楽", "text": "なんか某掲示板のネタ偉人みたいな名前だなーって思って聞いてみた"},
        { "location": "6943/SEL"     , "narrator": "", "text": "実在の人物だったか"},
        { "location": "6944/SEL"     , "narrator": "", "text": "そう言われましても"},
        { "location": "6945/SEL"     , "narrator": "", "text": "$me$は神楽にしか興味ない"},
        { "location": "6946/ACT"     , "narrator": "", "text": "実在の人物だったか"},
        { "location": "6947/TALK"    , "narrator": "神楽", "text": "そうぴょん"},
        { "location": "6948/ACT"     , "narrator": "", "text": "そう言われましても"},
        { "location": "6950/TALK"    , "narrator": "神楽", "text": "自分もそう思った★"},
        { "location": "6951/ACT"     , "narrator": "", "text": "$me$は神楽にしか興味ない"},
        { "location": "6953/TALK"    , "narrator": "神楽", "text": "またまたー"},
        { "location": "6954/TALK"    , "narrator": "神楽", "text": "でもそれって恋は盲目ってやつぴょん？"},
        { "location": "6955/TALK"    , "narrator": "神楽", "text": "ぴょんこ照れちゃうー！"},
        { "location": "6957/TALK"    , "narrator": "神楽", "text": "世の中には作り話より奇なる現実があるぴょん"},
        { "location": "6958/TALK"    , "narrator": "神楽", "text": "っていうお話でしたとさ。"}
    ]
}
