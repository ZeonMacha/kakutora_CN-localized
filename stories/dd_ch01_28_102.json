{
    "dir": "chap28/daydra/dd_ch01_28_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "28105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "それでも地球は丸い＜後編＞"
    },
    "entry":
    [
        { "location": "462/SCENARIO", "narrator": "", "text": "それでも地球は丸いから"},
        { "location": "486/TALK"    , "narrator": "つばめ", "text": "弱気じゃダメだよ。"},
        { "location": "487/TALK"    , "narrator": "つばめ", "text": "わたしは\n諦めないって\n決めたんだから。"},
        { "location": "488/TALK"    , "narrator": "つばめ", "text": "神楽ちゃんに\n生きててもらうこと。"},
        { "location": "489/TALK"    , "narrator": "つばめ", "text": "それに神楽ちゃんと\nずっと友達だって\n思ってるんだから。"},
        { "location": "491/TALK"    , "narrator": "つばめ", "text": "ねえ神楽ちゃん。"},
        { "location": "493/TALK"    , "narrator": "神楽", "text": "……。"},
        { "location": "495/TALK"    , "narrator": "つばめ", "text": "変に聞こえるかも\nしれないけど。"},
        { "location": "496/TALK"    , "narrator": "つばめ", "text": "わたしまた\n神楽ちゃんに\n会えてうれしいよ。"},
        { "location": "497/TALK"    , "narrator": "神楽", "text": "……。"},
        { "location": "498/TALK"    , "narrator": "つばめ", "text": "でね。髪飾りのこと\n憶えてる？"},
        { "location": "499/TALK"    , "narrator": "つばめ", "text": "わたしこの前\n神楽ちゃんの\n分を買ったの。"},
        { "location": "500/TALK"    , "narrator": "つばめ", "text": "自分の分はまだ\n買ってないんだ。"},
        { "location": "501/TALK"    , "narrator": "つばめ", "text": "だって神楽ちゃんが\n買ってくれるって\n言ってくれたから。"},
        { "location": "502/TALK"    , "narrator": "つばめ", "text": "ここを出たら\nまたあのお店に\n行ってみようよ。"},
        { "location": "503/TALK"    , "narrator": "つばめ", "text": "もしかしたら\nもう売り切れてるかも\nしれないけど……。"},
        { "location": "504/TALK"    , "narrator": "神楽", "text": "……何で？"},
        { "location": "505/TALK"    , "narrator": "つばめ", "text": "え？"},
        { "location": "508/TALK"    , "narrator": "神楽", "text": "……何でそんなこと\n言えるんですか？"},
        { "location": "509/TALK"    , "narrator": "神楽", "text": "なんで友達みたいに\n話すんですか？"},
        { "location": "510/TALK"    , "narrator": "つばめ", "text": "だって……\n友達だから……。"},
        { "location": "511/TALK"    , "narrator": "神楽", "text": "私はあなたを\n殺そうとしたんですよ？"},
        { "location": "512/TALK"    , "narrator": "神楽", "text": "そんな人間を\nなんで友達って\n言えるんですか？"},
        { "location": "514/TALK"    , "narrator": "つばめ", "text": "神楽ちゃんのこと\n好きだからだよ。"},
        { "location": "515/TALK"    , "narrator": "つばめ", "text": "だから――"},
        { "location": "516/TALK"    , "narrator": "神楽", "text": "なんでそんな嘘を\nつくんですか！"},
        { "location": "518/TALK"    , "narrator": "神楽", "text": "好きだから？\n友達だから？\nそんなわけないでしょう？"},
        { "location": "519/TALK"    , "narrator": "神楽", "text": "あなたは人に\n嫌われるのが\n怖いだけ。"},
        { "location": "520/TALK"    , "narrator": "神楽", "text": "私だけじゃなくて\n会った人全員に\n嫌われたくないだけ。"},
        { "location": "521/TALK"    , "narrator": "神楽", "text": "そんな人に\n友達だなんて\n言われても。"},
        { "location": "522/TALK"    , "narrator": "神楽", "text": "信用なんて\nできるわけ\nありません。"},
        { "location": "524/TALK"    , "narrator": "つばめ", "text": "……神楽ちゃん。"},
        { "location": "525/TALK"    , "narrator": "つばめ", "text": "わたし確かに\n嫌われるのは\nイヤだし怖いよ。"},
        { "location": "526/TALK"    , "narrator": "つばめ", "text": "みんなにも色々\n言われたりもしたよ。"},
        { "location": "527/TALK"    , "narrator": "つばめ", "text": "だけど神楽ちゃんが\nいなくなったら\nとても悲しいのは本当。"},
        { "location": "528/TALK"    , "narrator": "つばめ", "text": "それが自分のためって\nいうことなのかも\nしれないけど。"},
        { "location": "529/TALK"    , "narrator": "つばめ", "text": "神楽ちゃんが痛かったり\n悲しかったりしたら\nわたしも痛くて悲しい。"},
        { "location": "530/TALK"    , "narrator": "つばめ", "text": "悲しいんだよ……。"},
        { "location": "531/SEL"     , "narrator": "", "text": "$me$もつばめには悲しい思いしてほしくない"},
        { "location": "532/SEL"     , "narrator": "", "text": "そんな顔しないで"},
        { "location": "533/SEL"     , "narrator": "", "text": "それが友達だよ"},
        { "location": "534/SEL"     , "narrator": "", "text": "百合……"},
        { "location": "535/SEL"     , "narrator": "", "text": "卯月だってわかってるよ"},
        { "location": "536/ACT"     , "narrator": "", "text": "$me$もつばめには悲しい思いしてほしくない"},
        { "location": "537/ACT"     , "narrator": "", "text": "そんな顔しないで"},
        { "location": "538/ACT"     , "narrator": "", "text": "それが友達だよ"},
        { "location": "539/ACT"     , "narrator": "", "text": "百合……"},
        { "location": "540/ACT"     , "narrator": "", "text": "卯月だってわかってるよ"},
        { "location": "542/TALK"    , "narrator": "神楽", "text": "……あなたって人は……。"},
        { "location": "543/SEL"     , "narrator": "", "text": "おーい"},
        { "location": "544/SEL"     , "narrator": "", "text": "聞こえてないの？"},
        { "location": "545/SEL"     , "narrator": "", "text": "$me$はここだよー"},
        { "location": "546/ACT"     , "narrator": "", "text": "おーい"},
        { "location": "547/ACT"     , "narrator": "", "text": "聞こえてないの？"},
        { "location": "548/ACT"     , "narrator": "", "text": "$me$はここだよー"},
        { "location": "550/TALK"    , "narrator": "つばめ", "text": "…それに…。"},
        { "location": "551/TALK"    , "narrator": "つばめ", "text": "神楽ちゃんは\nわたしにひどいことが\nしたいわけじゃないよね。"},
        { "location": "552/TALK"    , "narrator": "つばめ", "text": "事情があって\nそういうことに\nなっただけだよね。"},
        { "location": "553/TALK"    , "narrator": "つばめ", "text": "だったら！"},
        { "location": "554/TALK"    , "narrator": "つばめ", "text": "そんなこと言い出した人\nやっつけようよ。"},
        { "location": "556/TALK"    , "narrator": "神楽", "text": "え？"},
        { "location": "557/TALK"    , "narrator": "つばめ", "text": "わたしと神楽ちゃんで\nやっつけちゃおうよ。\n悪い人を。"},
        { "location": "558/TALK"    , "narrator": "神楽", "text": "悪い人、って……。"},
        { "location": "559/TALK"    , "narrator": "つばめ", "text": "それが終わったら\nまず髪飾りを\n買いに行って。"},
        { "location": "560/TALK"    , "narrator": "つばめ", "text": "髪飾りつけて\nアキバに行こう。"},
        { "location": "562/TALK"    , "narrator": "つばめ", "text": "あっ、薄い本のお店は\nちょっと\n遠慮したいけど…。"},
        { "location": "563/TALK"    , "narrator": "神楽", "text": "あはは。\nなんですか、もう。"},
        { "location": "564/TALK"    , "narrator": "つばめ", "text": "え、えへ？"},
        { "location": "566/TALK"    , "narrator": "神楽", "text": "あーもう。"},
        { "location": "567/TALK"    , "narrator": "神楽", "text": "つばめさんと\n一緒にいると。"},
        { "location": "569/TALK"    , "narrator": "神楽", "text": "なんだか世界がとっても\nくだらないものだって\n思えてきます。"},
        { "location": "570/TALK"    , "narrator": "つばめ", "text": "えっ！？\nくだらなくなんて\nないよ！？"},
        { "location": "571/TALK"    , "narrator": "神楽", "text": "本当、そういうとこ。"},
        { "location": "572/TALK"    , "narrator": "つばめ", "text": "真面目な話してたのに？"},
        { "location": "574/TALK"    , "narrator": "神楽", "text": "そうです。\n真面目にくだらないと\n言っています。"},
        { "location": "575/TALK"    , "narrator": "つばめ", "text": "何言ってるか\nわかんないよー！"},
        { "location": "576/SEL"     , "narrator": "", "text": "$me$もつばめと話したいよ"},
        { "location": "577/SEL"     , "narrator": "", "text": "もしもーし"},
        { "location": "578/SEL"     , "narrator": "", "text": "つながらない！？"},
        { "location": "579/ACT"     , "narrator": "", "text": "$me$もつばめと話したいよ"},
        { "location": "580/ACT"     , "narrator": "", "text": "もしもーし"},
        { "location": "581/ACT"     , "narrator": "", "text": "つながらない！？"},
        { "location": "583/TALK"    , "narrator": "つばめ", "text": "でも、普通に話せる\nようになったし。"},
        { "location": "584/TALK"    , "narrator": "つばめ", "text": "仲直り、できたよね？"},
        { "location": "585/TALK"    , "narrator": "つばめ", "text": "よかった…。"},
        { "location": "586/SEL"     , "narrator": "", "text": "スマホ見て！"},
        { "location": "587/SEL"     , "narrator": "", "text": "つながってないの？？？"},
        { "location": "588/SEL"     , "narrator": "", "text": "何なんだよもう！"},
        { "location": "589/SEL"     , "narrator": "", "text": "話させて！"},
        { "location": "590/ACT"     , "narrator": "", "text": "スマホ見て！"},
        { "location": "591/ACT"     , "narrator": "", "text": "つながってないの？？？"},
        { "location": "592/ACT"     , "narrator": "", "text": "何なんだよもう！"},
        { "location": "593/ACT"     , "narrator": "", "text": "話させて！"},
        { "location": "606/DIALOG"  , "narrator": "Dialog_chapter_ch01", "text": "【23 エクセプション】"}
    ]
}
