        "title": "018 ココロスフィアストーリー【Lv06】",
        "sub_title": "チャプター９＜帰結＞"
    },
    "entry":
    [
        { "location": "54/SCENARIO", "narrator": "", "text": "壊されるココロ４"},
        { "location": "69/TALK"    , "narrator": "ガブリエラ", "text": "やったわ！\nガーディアンクランを\n倒せたっ！"},
        { "location": "71/TALK"    , "narrator": "ガブリエラ", "text": "これで後は\n本体をぶっ壊せば！"},
        { "location": "83/TALK"    , "narrator": "ガブリエラ", "text": "ひっ！！"},
        { "location": "84/TALK"    , "narrator": "ガブリエラ", "text": "あんた誰よ！"},
        { "location": "85/TALK"    , "narrator": "？？？", "text": "あたし　は　あなた"},
        { "location": "86/TALK"    , "narrator": "？？？", "text": "とらうま　に\nおびえる　あなた"},
        { "location": "87/TALK"    , "narrator": "ガブリエラ", "text": "……　…っ…"},
        { "location": "88/SEL"     , "narrator": "（選択肢）", "text": "ガブリエラ？？"},
        { "location": "89/ACT"     , "narrator": "", "text": "ガブリエラ？？"},
        { "location": "91/TALK"    , "narrator": "？？？", "text": "あたし　を\nけそうと　するの？"},
        { "location": "92/TALK"    , "narrator": "？？？", "text": "それが　なにを\nいみ　するか"},
        { "location": "93/TALK"    , "narrator": "？？？", "text": "いま\nおしえて　あげる"},
        { "location": "94/SEL"     , "narrator": "（選択肢）", "text": "去れ！！！"},
        { "location": "107/TALK"   , "narrator": "ガブリエラ", "text": "いやああああああああ\nああああああああああ\nあああああああっ！！"},
        { "location": "122/TALK"   , "narrator": "ガブリエラ", "text": "…うっ……\n…　ううっ…ぐすっ…"},
        { "location": "123/SEL"    , "narrator": "（選択肢）", "text": "大丈夫！？"},
        { "location": "124/ACT"    , "narrator": "", "text": "大丈夫！？"},
        { "location": "126/TALK"   , "narrator": "ガブリエラ", "text": "もう……っ…\nぐすっ…"},
        { "location": "127/TALK"   , "narrator": "ガブリエラ", "text": "……しにたい…　…"},
        { "location": "128/ACT"    , "narrator": "", "text": "去れ！！！"},
        { "location": "142/TALK"   , "narrator": "ガブリエラ", "text": "…っ……はぁ…\n……　…っ…はぁっ…"},
        { "location": "143/TALK"   , "narrator": "ガブリエラ", "text": "あんたが…っ……\n助けてくれたの…？"},
        { "location": "144/SEL"    , "narrator": "（選択肢）", "text": "多分"},
        { "location": "145/ACT"    , "narrator": "", "text": "多分"},
        { "location": "147/TALK"   , "narrator": "ガブリエラ", "text": "……ありがと…"},
        { "location": "148/SEL"    , "narrator": "（選択肢）", "text": "大丈夫？"},
        { "location": "149/ACT"    , "narrator": "", "text": "大丈夫？"},
        { "location": "151/TALK"   , "narrator": "ガブリエラ", "text": "うん……\nもう平気。"},
        { "location": "152/TALK"   , "narrator": "ガブリエラ", "text": "でも……"},
        { "location": "153/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりトラウマを\n自分で破壊するなんて\n無理なのかしら……"},
        { "location": "154/SEL"    , "narrator": "（選択肢）", "text": "まだ何か方法があるかもしれない"},
        { "location": "155/ACT"    , "narrator": "", "text": "まだ何か方法があるかもしれない"},
        { "location": "157/TALK"   , "narrator": "ガブリエラ", "text": "……うん。\nそうね。"},
        { "location": "158/TALK"   , "narrator": "ガブリエラ", "text": "でも、どうして\nあんたは、あたしに\n力を貸してくれるの？"},
        { "location": "159/SEL"    , "narrator": "（選択肢）", "text": "好きだから"},
        { "location": "160/SEL"    , "narrator": "（選択肢）", "text": "なんか気になる"},
        { "location": "161/ACT"    , "narrator": "", "text": "好きだから"},
        { "location": "163/TALK"   , "narrator": "ガブリエラ", "text": "ええっ！？\nちょっと何を急に\n言い出すのよ！"},
        { "location": "164/TALK"   , "narrator": "ガブリエラ", "text": "でも、ありがと。\n純粋に嬉しい。"},
        { "location": "165/TALK"   , "narrator": "ガブリエラ", "text": "と、とにかく\nこのままここにいても\n仕方ないわね。"},
        { "location": "166/TALK"   , "narrator": "ガブリエラ", "text": "あたしももっと\n強くならなくちゃ\nいけないと思うし――"},
        { "location": "167/TALK"   , "narrator": "ガブリエラ", "text": "また準備ができたら\n作戦を考えたいの。"},
        { "location": "168/TALK"   , "narrator": "ガブリエラ", "text": "その時はまた、\nよければ、その――"},
        { "location": "169/TALK"   , "narrator": "ガブリエラ", "text": "つ、つきあって\n欲しいかも……。"},
        { "location": "170/SEL"    , "narrator": "（選択肢）", "text": "もちろん"},
        { "location": "171/ACT"    , "narrator": "", "text": "もちろん"},
        { "location": "174/TALK"   , "narrator": "ガブリエラ", "text": "ありがとう。\nまたよろしくね。"},
        { "location": "175/ACT"    , "narrator": "", "text": "なんか気になる"},
        { "location": "176/TALK"   , "narrator": "ガブリエラ", "text": "そっか…。でも\n無理はしないで。"},
        { "location": "177/TALK"   , "narrator": "ガブリエラ", "text": "気が向いたら\nまたつき合ってよね。"}
    ]
}
