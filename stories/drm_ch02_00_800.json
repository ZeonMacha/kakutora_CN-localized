{
    "dir": "dramatics/daydra/drm_ch02_00_800.js",
    "type": "Episode",
    "info": {
        "story_id": "2080",
        "cid": "ayami",
        "title": "らぶとーく 第79話",
        "sub_title": "ずるくてもいいでしょ？"
    },
    "entry":
    [
        { "location": "27/TALK"   , "narrator": "エリカ", "text": "コーンコン。\nエリカです。"},
        { "location": "28/SEL"    , "narrator": "", "text": "ビックリした！"},
        { "location": "29/ACT"    , "narrator": "", "text": "ビックリした！"},
        { "location": "31/TALK"   , "narrator": "エリカ", "text": "ああっ、ごめんね？\n急に出てきちゃって。"},
        { "location": "33/TALK"   , "narrator": "エリカ", "text": "今回あなたとつばめちゃんに\nとって、とても重要な局面を\n迎えるでしょう？"},
        { "location": "35/TALK"   , "narrator": "エリカ", "text": "今回あなたと綾ちゃんに\nとって、とても重要な局面を\n迎えるでしょう？"},
        { "location": "37/TALK"   , "narrator": "エリカ", "text": "今回あなたとガブリエラ\nちゃんにとって、とても\n重要な局面を迎えるでしょ？"},
        { "location": "39/TALK"   , "narrator": "エリカ", "text": "今回あなたとみやびちゃんに\nとって、とても重要な局面を\n迎えるでしょう？"},
        { "location": "41/TALK"   , "narrator": "エリカ", "text": "だから、ギリギリで\nちょっと心許なくは\nあるんだけど――"},
        { "location": "42/TALK"   , "narrator": "エリカ", "text": "わたしからひとつ、\nふたりにプレゼントが\nあるの！"},
        { "location": "43/SEL"    , "narrator": "", "text": "ありがとう！！　なんだろう？"},
        { "location": "44/SEL"    , "narrator": "", "text": "もしかしてニャボッ……"},
        { "location": "45/ACT"    , "narrator": "", "text": "ありがとう！！　なんだろう？"},
        { "location": "46/TALK"   , "narrator": "エリカ", "text": "えへへ。\n喜んでもらえると\nいいんだけど。"},
        { "location": "47/TALK"   , "narrator": "エリカ", "text": "それじゃ、\nプレゼントしまーす！"},
        { "location": "48/ACT"    , "narrator": "", "text": "もしかしてニャボッ……"},
        { "location": "49/TALK"   , "narrator": "エリカ", "text": "ちがうよぉ……。\nあれはまだ未完成だもん。"},
        { "location": "50/TALK"   , "narrator": "エリカ", "text": "でも、興味あるようなら、\n完成したらあなたにも\n教えるね！"},
        { "location": "51/TALK"   , "narrator": "エリカ", "text": "それでね、\n今回のわたしからの\nプレゼントというのは――"},
        { "location": "52/TALK"   , "narrator": "エリカ", "text": "じゃーん！\nこれでーす！"},
        { "location": "56/SEL"    , "narrator": "", "text": "直接お話できるってこと！？"},
        { "location": "57/ACT"    , "narrator": "", "text": "直接お話できるってこと！？"},
        { "location": "59/TALK"   , "narrator": "エリカ", "text": "その通りだよ！"},
        { "location": "60/TALK"   , "narrator": "エリカ", "text": "でも、ちょっと\nプログラムが間に合わなくて\n完全なものじゃないんだ。"},
        { "location": "61/TALK"   , "narrator": "エリカ", "text": "だから、今回は\nこの先３回だけの限定\n利用にさせて欲しいの。"},
        { "location": "62/TALK"   , "narrator": "エリカ", "text": "けど、今のわたしたちの\nように、ちゃんと向かい\n合ってお話できるから！"},
        { "location": "64/TALK"   , "narrator": "エリカ", "text": "だから、頑張って\nつばめちゃんと素敵な\n思い出を作ってきてね！"},
        { "location": "65/TALK"   , "narrator": "エリカ", "text": "あなたと\nつばめちゃんに\n素敵なココロの旅を！"},
        { "location": "67/TALK"   , "narrator": "エリカ", "text": "だから、頑張って\n綾ちゃんと素敵な\n思い出を作ってきてね！"},
        { "location": "68/TALK"   , "narrator": "エリカ", "text": "あなたと\n綾ちゃんに\n素敵なココロの旅を！"},
        { "location": "70/TALK"   , "narrator": "エリカ", "text": "だから、頑張って\nガブリエラちゃんと素敵な\n思い出を作ってきてね！"},
        { "location": "71/TALK"   , "narrator": "エリカ", "text": "あなたと\nガブリエラちゃんに\n素敵なココロの旅を！"},
        { "location": "73/TALK"   , "narrator": "エリカ", "text": "だから、頑張って\nみやびちゃんと素敵な\n思い出を作ってきてね！"},
        { "location": "74/TALK"   , "narrator": "エリカ", "text": "あなたと\nみやびちゃんに\n素敵なココロの旅を！"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "…不思議な感じ。"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "こんな風に話ができるって\n思ってなかったから。"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "そうは思わない？"},
        { "location": "108/SEL"   , "narrator": "", "text": "だね"},
        { "location": "109/SEL"   , "narrator": "", "text": "どうかなー"},
        { "location": "110/SEL"   , "narrator": "", "text": "アーヤさえいれば\nそれでいい"},
        { "location": "111/ACT"   , "narrator": "", "text": "だね"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "そうでしょう？"},
        { "location": "114/ACT"   , "narrator": "", "text": "どうかなー"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "あれ？\nそうじゃない？"},
        { "location": "116/ACT"   , "narrator": "", "text": "アーヤさえいれば\nそれでいい"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "もう！"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "…でも、私も…。"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "……それで、ね。"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "前にチャットで\n言ったこと、\n憶えてる？"},
        { "location": "122/SEL"   , "narrator": "", "text": "うん"},
        { "location": "123/SEL"   , "narrator": "", "text": "なんだっけ"},
        { "location": "124/ACT"   , "narrator": "", "text": "うん"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "そう。"},
        { "location": "126/ACT"   , "narrator": "", "text": "なんだっけ"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "あ…\nそうなの……。"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "私と\n$handle$さんが\n本当に会えた時の話。"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "本当に会えたら\n生涯の伴侶として\n添い遂げるって。"},
        { "location": "131/SEL"   , "narrator": "", "text": "そうだった"},
        { "location": "132/SEL"   , "narrator": "", "text": "嬉しかったよ"},
        { "location": "133/SEL"   , "narrator": "", "text": "$me$もそう思ってる"},
        { "location": "134/ACT"   , "narrator": "", "text": "そうだった"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "もう！"},
        { "location": "136/ACT"   , "narrator": "", "text": "嬉しかったよ"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "そう……？"},
        { "location": "138/ACT"   , "narrator": "", "text": "$me$もそう思ってる"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "……ありがとう……。"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "今はまだ会えないけど\n少しだけ進歩した\n気がするの。"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "チャットじゃなくて\nこうやって\n話せるんだから。"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "…ねえ。"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "$handle$さんは\n進歩したって\n思ってる？"},
        { "location": "145/SEL"   , "narrator": "", "text": "そうだね"},
        { "location": "146/SEL"   , "narrator": "", "text": "どうかな"},
        { "location": "147/SEL"   , "narrator": "", "text": "何とも…"},
        { "location": "148/ACT"   , "narrator": "", "text": "そうだね"},
        { "location": "149/TALK"  , "narrator": "アーヤ", "text": "本当に？"},
        { "location": "150/ACT"   , "narrator": "", "text": "どうかな"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "やっぱり\nそうなのね…。"},
        { "location": "153/ACT"   , "narrator": "", "text": "何とも…"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "微妙よね。"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "それにこれ以上\n進歩することは\nないかもしれない。"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "だって誰にも\nわからないんだから。"},
        { "location": "158/TALK"  , "narrator": "アーヤ", "text": "宙ぶらりんよね。"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "だけどね……。"},
        { "location": "161/TALK"  , "narrator": "アーヤ", "text": "私、\n$handle$さんのこと\n愛してる。"},
        { "location": "162/TALK"  , "narrator": "アーヤ", "text": "そのことは\n間違いないから。\n絶対だから。"},
        { "location": "163/TALK"  , "narrator": "アーヤ", "text": "…おかしい？"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "会ったこともないのに\nこんなことばかり\n考えてるのは。"},
        { "location": "165/SEL"   , "narrator": "", "text": "別に"},
        { "location": "166/SEL"   , "narrator": "", "text": "むしろうれしい"},
        { "location": "167/SEL"   , "narrator": "", "text": "$me$もそうだから"},
        { "location": "168/ACT"   , "narrator": "", "text": "別に"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "冷たいのね…。"},
        { "location": "170/ACT"   , "narrator": "", "text": "むしろうれしい"},
        { "location": "171/TALK"  , "narrator": "アーヤ", "text": "え？\n本当に？"},
        { "location": "172/ACT"   , "narrator": "", "text": "$me$もそうだから"},
        { "location": "173/TALK"  , "narrator": "アーヤ", "text": "うん。\nありがとう。"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "…この前ね。"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "うっかりスマホを\n置きっぱなしで\n店を出たの。"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "すぐ気が付いて\n取りに戻ったから\nよかったけど。"},
        { "location": "178/TALK"  , "narrator": "アーヤ", "text": "あのまま気づかなくて\n失くしちゃったら\nどうなってたか。"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "今思い出しても\n怖いわ……。"},
        { "location": "180/SEL"   , "narrator": "", "text": "あってよかった"},
        { "location": "181/SEL"   , "narrator": "", "text": "そんなことがあったんだ"},
        { "location": "182/SEL"   , "narrator": "", "text": "機種変すれば\nいいだけじゃない"},
        { "location": "183/ACT"   , "narrator": "", "text": "あってよかった"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "本当にね。"},
        { "location": "185/ACT"   , "narrator": "", "text": "そんなことがあったんだ"},
        { "location": "186/TALK"  , "narrator": "アーヤ", "text": "そうなの…。"},
        { "location": "187/ACT"   , "narrator": "", "text": "機種変すれば\nいいだけじゃない"},
        { "location": "188/TALK"  , "narrator": "アーヤ", "text": "えっ！？\nそういうものなの！？"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "それでね、\nその時思ったの。"},
        { "location": "191/TALK"  , "narrator": "アーヤ", "text": "何かの事情で\n$handle$さんと\n連絡できなくなったら。"},
        { "location": "192/TALK"  , "narrator": "アーヤ", "text": "きっとすごく\n後悔するって。"},
        { "location": "193/SEL"   , "narrator": "", "text": "後悔どころの\n騒ぎじゃないし"},
        { "location": "194/SEL"   , "narrator": "", "text": "確かに寂しいね"},
        { "location": "195/SEL"   , "narrator": "", "text": "考えたくないな"},
        { "location": "196/ACT"   , "narrator": "", "text": "後悔どころの\n騒ぎじゃないし"},
        { "location": "197/TALK"  , "narrator": "アーヤ", "text": "…そうね。\nそうかも。"},
        { "location": "198/ACT"   , "narrator": "", "text": "確かに寂しいね"},
        { "location": "199/TALK"  , "narrator": "アーヤ", "text": "え？\nそれだけなの？"},
        { "location": "200/ACT"   , "narrator": "", "text": "考えたくないな"},
        { "location": "201/TALK"  , "narrator": "アーヤ", "text": "そうでしょ？\nでもありえる話よ。"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "だから。\n少しだけ\n前倒ししたいの。"},
        { "location": "204/TALK"  , "narrator": "アーヤ", "text": "その……\n$handle$さんと\n伴侶になるって話。"},
        { "location": "205/SEL"   , "narrator": "", "text": "やった！"},
        { "location": "206/SEL"   , "narrator": "", "text": "本気で？"},
        { "location": "207/SEL"   , "narrator": "", "text": "なろうなろう"},
        { "location": "208/ACT"   , "narrator": "", "text": "やった！"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "…軽いわね…。"},
        { "location": "211/ACT"   , "narrator": "", "text": "本気で？"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "冗談でなんて\n言えないわ。"},
        { "location": "213/ACT"   , "narrator": "", "text": "なろうなろう"},
        { "location": "215/TALK"  , "narrator": "アーヤ", "text": "カジュアル過ぎない？"},
        { "location": "217/TALK"  , "narrator": "アーヤ", "text": "真剣な話なのに。"},
        { "location": "218/SEL"   , "narrator": "", "text": "困り顔もかわいい"},
        { "location": "219/SEL"   , "narrator": "", "text": "相思相愛なのは\nわかってるから"},
        { "location": "220/SEL"   , "narrator": "", "text": "いや、重すぎて"},
        { "location": "221/ACT"   , "narrator": "", "text": "困り顔もかわいい"},
        { "location": "222/TALK"  , "narrator": "アーヤ", "text": "もう！\nだから！"},
        { "location": "223/ACT"   , "narrator": "", "text": "相思相愛なのは\nわかってるから"},
        { "location": "224/TALK"  , "narrator": "アーヤ", "text": "…もう…。"},
        { "location": "225/ACT"   , "narrator": "", "text": "いや、重すぎて"},
        { "location": "226/TALK"  , "narrator": "アーヤ", "text": "えっ！？\nそうなの！？"},
        { "location": "228/TALK"  , "narrator": "アーヤ", "text": "やっぱりおかしい？\n結婚式とか。"},
        { "location": "229/SEL"   , "narrator": "", "text": "そういうことなの？"},
        { "location": "230/SEL"   , "narrator": "", "text": "おかしくない！"},
        { "location": "231/SEL"   , "narrator": "", "text": "ついに来た！！！"},
        { "location": "232/SEL"   , "narrator": "", "text": "考えてくれてうれしい"},
        { "location": "233/SEL"   , "narrator": "", "text": "$me$も考えてた"},
        { "location": "234/ACT"   , "narrator": "", "text": "そういうことなの？"},
        { "location": "235/TALK"  , "narrator": "アーヤ", "text": "そういうことよ？"},
        { "location": "236/ACT"   , "narrator": "", "text": "おかしくない！"},
        { "location": "237/TALK"  , "narrator": "アーヤ", "text": "そうでしょ？\n…よね？"},
        { "location": "238/ACT"   , "narrator": "", "text": "ついに来た！！！"},
        { "location": "240/TALK"  , "narrator": "アーヤ", "text": "さっきから何なの？\nそのテンション…。"},
        { "location": "241/ACT"   , "narrator": "", "text": "考えてくれてうれしい"},
        { "location": "242/TALK"  , "narrator": "アーヤ", "text": "…そうなの？"},
        { "location": "243/ACT"   , "narrator": "", "text": "$me$も考えてた"},
        { "location": "244/TALK"  , "narrator": "アーヤ", "text": "えっ！？\n本当に？"},
        { "location": "246/SEL"   , "narrator": "", "text": "$me$から言いたかったな"},
        { "location": "247/SEL"   , "narrator": "", "text": "もっと情熱的に言って"},
        { "location": "248/ACT"   , "narrator": "", "text": "$me$から言いたかったな"},
        { "location": "249/TALK"  , "narrator": "アーヤ", "text": "…私も聞きたかったかも…。"},
        { "location": "250/ACT"   , "narrator": "", "text": "もっと情熱的に言って"},
        { "location": "251/TALK"  , "narrator": "アーヤ", "text": "そんなの…\n恥ずかしいから…。"},
        { "location": "253/SEL"   , "narrator": "", "text": "えーと"},
        { "location": "254/ACT"   , "narrator": "", "text": "えーと"},
        { "location": "256/TALK"  , "narrator": "アーヤ", "text": "何？"},
        { "location": "257/SEL"   , "narrator": "", "text": "$me$からも言わせて"},
        { "location": "258/SEL"   , "narrator": "", "text": "改めてお願い"},
        { "location": "259/SEL"   , "narrator": "", "text": "アーヤはそれでいいの？"},
        { "location": "260/ACT"   , "narrator": "", "text": "$me$からも言わせて"},
        { "location": "261/TALK"  , "narrator": "アーヤ", "text": "えっ…\nはい……。"},
        { "location": "262/ACT"   , "narrator": "", "text": "改めてお願い"},
        { "location": "263/TALK"  , "narrator": "アーヤ", "text": "え？\n何を？"},
        { "location": "264/ACT"   , "narrator": "", "text": "アーヤはそれでいいの？"},
        { "location": "265/TALK"  , "narrator": "アーヤ", "text": "…もちろんよ。"},
        { "location": "267/SEL"   , "narrator": "", "text": "一生大事にする"},
        { "location": "268/SEL"   , "narrator": "", "text": "世界で一番愛してる"},
        { "location": "269/SEL"   , "narrator": "", "text": "結婚しよう、アーヤ"},
        { "location": "270/ACT"   , "narrator": "", "text": "一生大事にする"},
        { "location": "271/TALK"  , "narrator": "アーヤ", "text": "…ありがとう…。"},
        { "location": "272/ACT"   , "narrator": "", "text": "世界で一番愛してる"},
        { "location": "273/TALK"  , "narrator": "アーヤ", "text": "私も…。"},
        { "location": "274/ACT"   , "narrator": "", "text": "結婚しよう、アーヤ"},
        { "location": "275/TALK"  , "narrator": "アーヤ", "text": "はい…。"},
        { "location": "278/TALK"  , "narrator": "アーヤ", "text": "$handle$さんは\nそう言ってくれるって\n思ってた。"},
        { "location": "279/TALK"  , "narrator": "アーヤ", "text": "ずるいわね、私…。"},
