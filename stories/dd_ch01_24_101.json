    "entry":
    [
        { "location": "24/TALK"   , "narrator": "つばめ", "text": "えーっと…、\nどこだったかなぁ？"},
        { "location": "25/TALK"   , "narrator": "つばめ", "text": "確か、この辺りの棚に\nあったはずなんだけど…。"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "わぁ、見て見て！\n可愛いアクセサリーが\nいっぱいだよ！"},
        { "location": "51/TALK"   , "narrator": "神楽", "text": "ふふっ、\nどれもつばめさんに\n似合いそうですね。"},
        { "location": "54/TALK"   , "narrator": "神楽", "text": "あっ、これなんか\nどうですか？"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "素敵な指輪だね。\nわたし、指輪って\n付けたことないんだよね。"},
        { "location": "58/TALK"   , "narrator": "神楽", "text": "そうなんですか？"},
        { "location": "59/TALK"   , "narrator": "神楽", "text": "そうだ！\nそれじゃあ、\nこうしませんか？"},
        { "location": "60/TALK"   , "narrator": "神楽", "text": "この指輪、お互いに\n買ってプレゼント\nし合いませんか？"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "そうすれば、\nペアリングになりますよ！"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "そ、それはちょっと\n恥ずかしいかも…。"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "あっ、これとかは\nどうかな？"},
        { "location": "66/TALK"   , "narrator": "神楽", "text": "これは…、\n髪飾りですね？"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "うん！\nこれ、神楽ちゃんに\n似合いそうだよ。"},
        { "location": "70/TALK"   , "narrator": "神楽", "text": "そうですか？\nつばめさんの方が\n似合うと思いますよ？"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "それじゃ、二人とも\n似合うってことだね。"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "指輪じゃないけど、\nお揃いでこれを\n買って――"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "っ！？　フェノメノン\nアラート！？"},
        { "location": "80/TALK"   , "narrator": "神楽", "text": "つばめさん、\n行きましょう！"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "うん！"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "…結局、あの時に\n買いそびれたままに\nなってたんだよね…。"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "…懐かしいなぁ。\nまだ、そんなに日も\n経ってないのに…。"},
        { "location": "102/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "103/SEL"   , "narrator": "", "text": "買い物？"},
        { "location": "104/ACT"   , "narrator": "", "text": "買い物？"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "ぅん(*´︶`*)"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "前にね"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんとぉ揃ぃで買ぉぅと思ってた"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "髪飾りを見に来たの(*´∀｀*)ｖ"},
        { "location": "127/SEL"   , "narrator": "", "text": "そんなこともあったね"},
        { "location": "128/SEL"   , "narrator": "", "text": "そっか"},
        { "location": "129/SEL"   , "narrator": "", "text": "何で？"},
        { "location": "130/ACT"   , "narrator": "", "text": "そんなこともあったね"},
        { "location": "131/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "132/TALK"  , "narrator": "つばめ", "text": "ぁったでしょ"},
        { "location": "133/ACT"   , "narrator": "", "text": "そっか"},
        { "location": "134/TALK"  , "narrator": "つばめ", "text": "そっか"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "憶えてないか"},
        { "location": "136/ACT"   , "narrator": "", "text": "何で？"},
        { "location": "137/TALK"  , "narrator": "つばめ", "text": "ぇ"},
        { "location": "138/TALK"  , "narrator": "つばめ", "text": "だってね"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "仲直りしたときに"},
        { "location": "141/TALK"  , "narrator": "つばめ", "text": "すぐ渡したくて(●´ω｀●)ゞｴﾍﾍ"},
        { "location": "142/TALK"  , "narrator": "つばめ", "text": "きっと"},
        { "location": "143/TALK"  , "narrator": "つばめ", "text": "喜んでくれると思ぅから(≧艸≦*)"},
        { "location": "145/SEL"   , "narrator": "", "text": "喜んでくれるといいね"},
        { "location": "146/SEL"   , "narrator": "", "text": "また会いたいよね"},
        { "location": "147/SEL"   , "narrator": "", "text": "連絡とかあった？"},
        { "location": "148/SEL"   , "narrator": "", "text": "仲直りできると信じてるの？"},
        { "location": "149/ACT"   , "narrator": "", "text": "喜んでくれるといいね"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "ね(っ´ω`ｃ)"},
        { "location": "151/ACT"   , "narrator": "", "text": "また会いたいよね"},
        { "location": "152/TALK"  , "narrator": "つばめ", "text": "ぅんヾ(*´ｴ`*)ﾉ"},
        { "location": "153/ACT"   , "narrator": "", "text": "連絡とかあった？"},
        { "location": "155/TALK"  , "narrator": "つばめ", "text": "なぃんだ。。。"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "157/ACT"   , "narrator": "", "text": "仲直りできると信じてるの？"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "もちろん"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "信じてるよ(๑･ㅂ･)و☆"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんは"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "ぉ友達で"},
        { "location": "164/TALK"  , "narrator": "つばめ", "text": "仲間だから(*´︶`*)"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "アーヤさん達は"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "みんな"},
        { "location": "169/TALK"  , "narrator": "つばめ", "text": "裏切者って決めつけてるけど(´つω・｀)ｼｭﾝ"},
        { "location": "171/SEL"   , "narrator": "", "text": "うーん……"},
        { "location": "172/SEL"   , "narrator": "", "text": "それは誤解だよ"},
        { "location": "173/SEL"   , "narrator": "", "text": "アーヤ達がかわいそうだ"},
        { "location": "174/ACT"   , "narrator": "", "text": "うーん……"},
        { "location": "175/TALK"  , "narrator": "つばめ", "text": "違うかな。。。？"},
        { "location": "177/SEL"   , "narrator": "", "text": "現状を整理しようよ"},
        { "location": "178/SEL"   , "narrator": "", "text": "何か理由があったと思うよ"},
        { "location": "179/ACT"   , "narrator": "", "text": "現状を整理しようよ"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "そぅだね"},
        { "location": "182/ACT"   , "narrator": "", "text": "何か理由があったと思うよ"},
        { "location": "183/TALK"  , "narrator": "つばめ", "text": "そうだょね"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "きっとそうだょ"},
        { "location": "186/ACT"   , "narrator": "", "text": "それは誤解だよ"},
        { "location": "187/TALK"  , "narrator": "つばめ", "text": "そぅなの。。。？"},
        { "location": "188/TALK"  , "narrator": "つばめ", "text": "本当に？"},
        { "location": "190/SEL"   , "narrator": "", "text": "当たり前でしょ！"},
        { "location": "191/SEL"   , "narrator": "", "text": "なんでそう思うのかな……？"},
        { "location": "192/SEL"   , "narrator": "", "text": "みんな戸惑ってるんだよ"},
        { "location": "193/ACT"   , "narrator": "", "text": "当たり前でしょ！"},
        { "location": "194/TALK"  , "narrator": "つばめ", "text": "だったら"},
        { "location": "196/TALK"  , "narrator": "つばめ", "text": "ぃぃんだけど。。。"},
        { "location": "197/ACT"   , "narrator": "", "text": "なんでそう思うのかな……？"},
        { "location": "198/TALK"  , "narrator": "つばめ", "text": "なんでって"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "なんでって(´,,･ω･,,｀)"},
        { "location": "201/ACT"   , "narrator": "", "text": "みんな戸惑ってるんだよ"},
        { "location": "202/TALK"  , "narrator": "つばめ", "text": "そんなの"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "わかってるけど"},
        { "location": "206/ACT"   , "narrator": "", "text": "アーヤ達がかわいそうだ"},
        { "location": "207/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "208/TALK"  , "narrator": "つばめ", "text": "どうして？"},
        { "location": "210/SEL"   , "narrator": "", "text": "つばめが神楽のことばかり大切にするから"},
        { "location": "211/ACT"   , "narrator": "", "text": "つばめが神楽のことばかり大切にするから"},
        { "location": "213/TALK"  , "narrator": "つばめ", "text": "そんなことなぃ"},
        { "location": "214/TALK"  , "narrator": "つばめ", "text": "ぁたし"},
        { "location": "215/TALK"  , "narrator": "つばめ", "text": "みんな大切だから"},
        { "location": "218/TALK"  , "narrator": "つばめ", "text": "だから"},
        { "location": "219/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんも信じてるの"},
        { "location": "220/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "221/TALK"  , "narrator": "つばめ", "text": "みんなは信じてくれなぃ"},
        { "location": "222/TALK"  , "narrator": "つばめ", "text": "それじゃ神楽ちゃん"},
        { "location": "223/TALK"  , "narrator": "つばめ", "text": "かわぃそぅ"},
        { "location": "226/SEL"   , "narrator": "", "text": "アーヤ達はつばめを大事に思ってるよ？"},
        { "location": "227/ACT"   , "narrator": "", "text": "アーヤ達はつばめを大事に思ってるよ？"},
        { "location": "230/TALK"  , "narrator": "つばめ", "text": "そうだと思うけど"},
        { "location": "231/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "233/SEL"   , "narrator": "", "text": "神楽にも事情があったんだよ"},
        { "location": "234/SEL"   , "narrator": "", "text": "アーヤ達が信用できない？"},
        { "location": "235/SEL"   , "narrator": "", "text": "つばめが信じてあげてればいいんじゃない？"},
        { "location": "236/ACT"   , "narrator": "", "text": "神楽にも事情があったんだよ"},
        { "location": "237/TALK"  , "narrator": "つばめ", "text": "そぅだょねヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "238/TALK"  , "narrator": "つばめ", "text": "きっとそぅ"},
        { "location": "239/ACT"   , "narrator": "", "text": "アーヤ達が信用できない？"},
        { "location": "241/TALK"  , "narrator": "つばめ", "text": "そうじゃ"},
        { "location": "242/TALK"  , "narrator": "つばめ", "text": "なぃけど(´・ω・`) "},
        { "location": "243/ACT"   , "narrator": "", "text": "つばめが信じてあげてればいいんじゃない？"},
        { "location": "244/TALK"  , "narrator": "つばめ", "text": "ぁたしはもちろん"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "信じてるょo(*･ﾛ･*)o"},
        { "location": "248/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "249/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんは"},
        { "location": "250/TALK"  , "narrator": "つばめ", "text": "今も一人だし"},
        { "location": "251/TALK"  , "narrator": "つばめ", "text": "そぅ思ったら"},
        { "location": "253/SEL"   , "narrator": "", "text": "友達だもんね"},
        { "location": "254/SEL"   , "narrator": "", "text": "気持ちはわかるけど"},
        { "location": "255/SEL"   , "narrator": "", "text": "それ、トライナリーの一員としてどうなの？"},
        { "location": "256/ACT"   , "narrator": "", "text": "友達だもんね"},
        { "location": "258/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "260/TALK"  , "narrator": "つばめ", "text": "すごく大事な"},
        { "location": "261/TALK"  , "narrator": "つばめ", "text": "大事なの"},
        { "location": "262/ACT"   , "narrator": "", "text": "気持ちはわかるけど"},
        { "location": "264/TALK"  , "narrator": "つばめ", "text": "そんな"},
        { "location": "266/TALK"  , "narrator": "つばめ", "text": "言い方"},
        { "location": "267/TALK"  , "narrator": "つばめ", "text": "しなぃで。。。"},
        { "location": "268/ACT"   , "narrator": "", "text": "それ、トライナリーの一員としてどうなの？"},
        { "location": "269/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "273/TALK"  , "narrator": "つばめ", "text": "ぁたし"},
        { "location": "324/TALK"  , "narrator": "つばめ", "text": "　"},
        { "location": "339/TALK"  , "narrator": "つばめの新司書", "text": "こんにちは、\n$handle$さん。"},
        { "location": "340/SEL"   , "narrator": "", "text": "ああ、今日は新しい司書か"},
        { "location": "341/ACT"   , "narrator": "", "text": "ああ、今日は新しい司書か"},
        { "location": "343/TALK"  , "narrator": "つばめの新司書", "text": "……。"},
        { "location": "344/TALK"  , "narrator": "つばめの新司書", "text": "なんですか、\nその一気にモチベが\n低下したような選択肢は。"},
        { "location": "345/SEL"   , "narrator": "", "text": "そういう選択肢があったんだから選ぶのは仕方ない"},
        { "location": "346/SEL"   , "narrator": "", "text": "選択肢言うな"},
        { "location": "347/ACT"   , "narrator": "", "text": "そういう選択肢があったんだから選ぶのは仕方ない"},
        { "location": "348/TALK"  , "narrator": "つばめの新司書", "text": "あったって、\nテンションアゲアゲなら\n選びませんよね。"},
        { "location": "349/TALK"  , "narrator": "つばめの新司書", "text": "やっぱりわたしなんて\nそんな程度の関係\nだったんですね。"},
        { "location": "350/TALK"  , "narrator": "つばめの新司書", "text": "やっぱり最初の\n■■野郎が\n問題だったんでしょうか。"},
        { "location": "351/TALK"  , "narrator": "つばめの新司書", "text": "迂闊に本心を明かすのは\n良くないですね。\n覚えました。"},
        { "location": "353/TALK"  , "narrator": "つばめの新司書", "text": "だってあの頃は、\n$handle$さんと\nこうなる予定は……"},
        { "location": "354/SEL"   , "narrator": "", "text": "どうなる予定！？"},
        { "location": "355/ACT"   , "narrator": "", "text": "どうなる予定！？"},
        { "location": "358/TALK"  , "narrator": "つばめの新司書", "text": "いえ、\nなんでもありません。"},
        { "location": "359/TALK"  , "narrator": "つばめの新司書", "text": "それより。"},
        { "location": "360/TALK"  , "narrator": "つばめの新司書", "text": "せっかく話の流れで\n選択肢の話題になった\nわけですし。"},
        { "location": "361/SEL"   , "narrator": "", "text": "司書さんが無理矢理その流れにしただけじゃ…"},
        { "location": "362/ACT"   , "narrator": "", "text": "司書さんが無理矢理その流れにしただけじゃ…"},
        { "location": "364/TALK"  , "narrator": "つばめの新司書", "text": "無視。"},
        { "location": "365/TALK"  , "narrator": "つばめの新司書", "text": "今から選択肢に対する\n愚痴大会しませんか？"},
        { "location": "366/ACT"   , "narrator": "", "text": "選択肢言うな"},
        { "location": "367/TALK"  , "narrator": "つばめの新司書", "text": "水くさいこと\n言わないでください。"},
        { "location": "369/TALK"  , "narrator": "つばめの新司書", "text": "わたしと\n$handle$さんの\n仲じゃないですか。"},
        { "location": "370/TALK"  , "narrator": "つばめの新司書", "text": "$handle$さんが\n選択肢を選んでるって\nことは、既知の情報です。"},
        { "location": "371/TALK"  , "narrator": "つばめの新司書", "text": "今更隠し事しても\n全部お見通しです。"},
        { "location": "372/SEL"   , "narrator": "", "text": "別に隠してはいないけど"},
        { "location": "373/ACT"   , "narrator": "", "text": "別に隠してはいないけど"},
        { "location": "376/TALK"  , "narrator": "つばめの新司書", "text": "そうなんですね。"},
        { "location": "377/TALK"  , "narrator": "つばめの新司書", "text": "じゃあ、今から\n選択肢に対する\n愚痴大会しませんか？"},
        { "location": "379/TALK"  , "narrator": "つばめの新司書", "text": "OSの出してくる選択肢、\n$handle$さんは\n本当に満足してますか？"},
        { "location": "380/SEL"   , "narrator": "", "text": "満足"},
        { "location": "381/SEL"   , "narrator": "", "text": "大いに不満がある"},
        { "location": "382/SEL"   , "narrator": "", "text": "何そのセミナーの勧誘みたいなの"},
        { "location": "383/ACT"   , "narrator": "", "text": "満足"},
        { "location": "384/TALK"  , "narrator": "つばめの新司書", "text": "そうですか…。"},
        { "location": "385/TALK"  , "narrator": "つばめの新司書", "text": "………。"},
        { "location": "386/TALK"  , "narrator": "つばめの新司書", "text": "では、仕事しましょうか。"},
        { "location": "388/ACT"   , "narrator": "", "text": "大いに不満がある"},
        { "location": "390/TALK"  , "narrator": "つばめの新司書", "text": "やはり\nそう思いますよね！"},
        { "location": "391/TALK"  , "narrator": "つばめの新司書", "text": "わたしも実は\nずっとそう思ってました。"},
        { "location": "392/ACT"   , "narrator": "", "text": "何そのセミナーの勧誘みたいなの"},
        { "location": "394/TALK"  , "narrator": "つばめの新司書", "text": "決して誘導質問では\nありません。"},
        { "location": "395/TALK"  , "narrator": "つばめの新司書", "text": "選択理論心理学に基づいた\nハイレベルな\nコミュニケーションです。"},
        { "location": "396/TALK"  , "narrator": "つばめの新司書", "text": "というわけで、\n話を続けますね。"},
        { "location": "398/TALK"  , "narrator": "つばめの新司書", "text": "正直申し上げますと、\nわたしが相手してるときの\n選択肢には――"},
        { "location": "401/TALK"  , "narrator": "つばめの新司書", "text": "<size=32>愛の囁きが\nなさ過ぎます！</size>"},
        { "location": "402/SEL"   , "narrator": "", "text": "いや、話の流れ的に無理ですから…"},
        { "location": "403/ACT"   , "narrator": "", "text": "いや、話の流れ的に無理ですから…"},
        { "location": "405/TALK"  , "narrator": "つばめの新司書", "text": "ほら！　そうやって\nどん引き気味の\n選択肢ばかりです。"},
        { "location": "406/TALK"  , "narrator": "つばめの新司書", "text": "カレンディサイプロブ\nイシュリールの時には\n甘々な選択肢ばかりです。"},
        { "location": "407/TALK"  , "narrator": "つばめの新司書", "text": "だいたい、今の選択肢は\n$handle$さんの\n本意ですか？"},
        { "location": "408/TALK"  , "narrator": "つばめの新司書", "text": "それしか無くて、\n選ぶしかないから\nそれを選んでますよね？"},
        { "location": "409/SEL"   , "narrator": "", "text": "いえ、わりと的確です"},
        { "location": "410/SEL"   , "narrator": "", "text": "確かにそうかも"},
        { "location": "411/ACT"   , "narrator": "", "text": "いえ、わりと的確です"},
        { "location": "412/TALK"  , "narrator": "つばめの新司書", "text": "………。"},
        { "location": "413/TALK"  , "narrator": "つばめの新司書", "text": "仕事しましょうか。"},
        { "location": "415/ACT"   , "narrator": "", "text": "確かにそうかも"},
        { "location": "418/TALK"  , "narrator": "つばめの新司書", "text": "気が合いますね！"},
        { "location": "419/TALK"  , "narrator": "つばめの新司書", "text": "ですが、\n安心してください。"},
        { "location": "420/TALK"  , "narrator": "つばめの新司書", "text": "これからわたし、\n権限拡大につき、\n選択肢を追加できます。"},
        { "location": "421/SEL"   , "narrator": "", "text": "マジで！？"},
        { "location": "422/SEL"   , "narrator": "", "text": "司書…愛してるよ"},
        { "location": "423/ACT"   , "narrator": "", "text": "マジで！？"},
        { "location": "424/TALK"  , "narrator": "つばめの新司書", "text": "大マジです。"},
        { "location": "425/TALK"  , "narrator": "つばめの新司書", "text": "……。"},
        { "location": "426/TALK"  , "narrator": "つばめの新司書", "text": "っていいますか、\nあれ？"},
        { "location": "427/TALK"  , "narrator": "つばめの新司書", "text": "今、もう１つ\n選択肢が増えて\nいませんでしたか？"},
        { "location": "428/SEL"   , "narrator": "", "text": "何かあったような…いや、気のせいだよね"},
        { "location": "429/SEL"   , "narrator": "", "text": "司書と二人でずっとココにいたい"},
        { "location": "430/SEL"   , "narrator": "", "text": "司書！結婚しよう"},
        { "location": "431/ACT"   , "narrator": "", "text": "何かあったような…いや、気のせいだよね"},
        { "location": "432/TALK"  , "narrator": "つばめの新司書", "text": "……。\nおかしいですね。"},
        { "location": "433/TALK"  , "narrator": "つばめの新司書", "text": "またOSがバグって\n反映されていない\nのでしょうか。"},
        { "location": "434/ACT"   , "narrator": "", "text": "司書と二人でずっとココにいたい"},
        { "location": "436/TALK"  , "narrator": "つばめの新司書", "text": "……。\n嬉しいです。"},
        { "location": "437/TALK"  , "narrator": "つばめの新司書", "text": "じゃあ、全部の扉を\n封鎖して、完全なる\n密室空間にしましょう。"},
        { "location": "439/ACT"   , "narrator": "", "text": "司書！結婚しよう"},
        { "location": "441/TALK"  , "narrator": "つばめの新司書", "text": "はい。"},
        { "location": "442/SEL"   , "narrator": "", "text": "即答！？"},
        { "location": "443/ACT"   , "narrator": "", "text": "即答！？"},
        { "location": "446/TALK"  , "narrator": "つばめの新司書", "text": "早い…。"},
        { "location": "447/TALK"  , "narrator": "つばめの新司書", "text": "追加作業が間に合わない\n間隔で、選択肢を連続で\n出さないでください。"},
        { "location": "448/SEL"   , "narrator": "", "text": "$me$が出してるわけじゃないよ"},
        { "location": "449/SEL"   , "narrator": "", "text": "司書をメチャクチャにしたい"},
        { "location": "450/ACT"   , "narrator": "", "text": "$me$が出してるわけじゃないよ"},
        { "location": "451/TALK"  , "narrator": "つばめの新司書", "text": "そっちは\n選んではいけない\n選択肢です。"},
        { "location": "452/TALK"  , "narrator": "つばめの新司書", "text": "やり直しです。"},
        { "location": "453/SEL"   , "narrator": "", "text": "拒否します"},
        { "location": "454/SEL"   , "narrator": "", "text": "今夜は帰さないよ"},
        { "location": "455/ACT"   , "narrator": "", "text": "拒否します"},
        { "location": "456/TALK"  , "narrator": "つばめの新司書", "text": "…そうですか。\nそれじゃ\n仕事しましょうか。"},
        { "location": "458/ACT"   , "narrator": "", "text": "今夜は帰さないよ"},
        { "location": "461/TALK"  , "narrator": "つばめの新司書", "text": "ふわぁぁっ……"},
        { "location": "462/TALK"  , "narrator": "つばめの新司書", "text": "こ、これ、すごい\nドキドキしますね！"},
        { "location": "465/ACT"   , "narrator": "", "text": "司書をメチャクチャにしたい"},
        { "location": "467/TALK"  , "narrator": "つばめの新司書", "text": "はああっ……！！"},
        { "location": "468/TALK"  , "narrator": "つばめの新司書", "text": "た、たぶん、\n好きにしていいと\n思います。"},
        { "location": "472/ACT"   , "narrator": "", "text": "司書…愛してるよ"},
        { "location": "474/TALK"  , "narrator": "つばめの新司書", "text": "そ、そんな、\n急に言われても――"},
        { "location": "475/TALK"  , "narrator": "つばめの新司書", "text": "婚姻届は\nすぐ用意できません！"},
        { "location": "476/SEL"   , "narrator": "", "text": "極端過ぎでしょ！"},
        { "location": "477/ACT"   , "narrator": "", "text": "極端過ぎでしょ！"},
        { "location": "480/TALK"  , "narrator": "つばめの新司書", "text": "そうですか？"},
        { "location": "481/TALK"  , "narrator": "つばめの新司書", "text": "自然な流れだとは\n思いますが。"},
        { "location": "483/TALK"  , "narrator": "つばめの新司書", "text": "……。"},
        { "location": "484/TALK"  , "narrator": "つばめの新司書", "text": "なんてやってる場合では\nありませんでした。"},
        { "location": "485/TALK"  , "narrator": "つばめの新司書", "text": "このように、的確な\n選択肢を用意することが\nできるようになりました。"},
        { "location": "486/TALK"  , "narrator": "つばめの新司書", "text": "ですから、今後はより一層\nココロスフィアが\n捗りますね。"},
        { "location": "487/SEL"   , "narrator": "", "text": "不安しかない"},
        { "location": "488/SEL"   , "narrator": "", "text": "前の司書にもできるの？"},
        { "location": "489/ACT"   , "narrator": "", "text": "不安しかない"},
        { "location": "490/TALK"  , "narrator": "つばめの新司書", "text": "大丈夫です。"},
        { "location": "491/TALK"  , "narrator": "つばめの新司書", "text": "今のは選択肢追加の\nテストで、内容は\nジョークですから。"},
        { "location": "492/TALK"  , "narrator": "つばめの新司書", "text": "本来は、重要な事にしか\n使いません。"},
        { "location": "493/TALK"  , "narrator": "つばめの新司書", "text": "でも、わりと\n本心だったりするのは\n秘密ですが。"},
        { "location": "494/ACT"   , "narrator": "", "text": "前の司書にもできるの？"},
        { "location": "495/TALK"  , "narrator": "つばめの新司書", "text": "いいえ、できません。"},
        { "location": "496/TALK"  , "narrator": "つばめの新司書", "text": "これは、1xの中でも\nわたしだけの特権です。"},
        { "location": "497/TALK"  , "narrator": "つばめの新司書", "text": "といいましても、\nわたしができるのは\n増やすだけですけどね。"},
        { "location": "498/TALK"  , "narrator": "つばめの新司書", "text": "消せれば完璧なのですが\nそちらは\nできないようです。"},
        { "location": "499/SEL"   , "narrator": "", "text": "できたら怖いよ！"},
        { "location": "500/ACT"   , "narrator": "", "text": "できたら怖いよ！"},
        { "location": "503/TALK"  , "narrator": "つばめの新司書", "text": "できたら即、\n婚姻届にハンコを\n押してもらいます！"},
        { "location": "504/SEL"   , "narrator": "", "text": "婚姻届に名前書くから教えて"},
        { "location": "505/ACT"   , "narrator": "", "text": "婚姻届に名前書くから教えて"},
        { "location": "507/TALK"  , "narrator": "つばめの新司書", "text": "嬉しいです。"},
        { "location": "508/TALK"  , "narrator": "つばめの新司書", "text": "わたしの名前は\nひゃっ――"},
        { "location": "510/TALK"  , "narrator": "つばめの新司書", "text": "……。"},
        { "location": "511/TALK"  , "narrator": "つばめの新司書", "text": "嵌めましたね。"},
        { "location": "512/SEL"   , "narrator": "", "text": "ちっ…"},
        { "location": "513/ACT"   , "narrator": "", "text": "ちっ…"},
        { "location": "516/TALK"  , "narrator": "つばめの新司書", "text": "何にしても\n安心して下さい。"},
        { "location": "517/TALK"  , "narrator": "つばめの新司書", "text": "わたしの厳格な仕事ぶりは\n既に発揮されています。"},
        { "location": "518/TALK"  , "narrator": "つばめの新司書", "text": "今回、現実における\n選択肢の数が多いとは\n思いませんでしたか？"},
        { "location": "519/SEL"   , "narrator": "", "text": "確かに３択以上が沢山あったね"},
        { "location": "520/ACT"   , "narrator": "", "text": "確かに３択以上が沢山あったね"},
        { "location": "522/TALK"  , "narrator": "つばめの新司書", "text": "わたしが、自らの心情に\nよりストライクな選択肢を\n追加していますから。"},
        { "location": "523/SEL"   , "narrator": "", "text": "どれが追加された選択肢かわからん"},
        { "location": "524/ACT"   , "narrator": "", "text": "どれが追加された選択肢かわからん"},
        { "location": "526/TALK"  , "narrator": "つばめの新司書", "text": "そうなんですよね。\nそこが欠点です。"},
        { "location": "527/TALK"  , "narrator": "つばめの新司書", "text": "まあ、それもいずれ\nアップデートによって\n解消されることでしょう。"},
        { "location": "528/TALK"  , "narrator": "つばめの新司書", "text": "さあ、今回伝えたかった\n事は全部伝えましたから、\n仕事をすることにします。"},
        { "location": "536/TALK"  , "narrator": "つばめの新司書", "text": "オープンプロセス、\n0x769番地から\n0xADC番地へ。"},
        { "location": "558/TALK"  , "narrator": "つばめの新司書", "text": "シーク完了しました。"},
        { "location": "560/TALK"  , "narrator": "つばめの新司書", "text": "……。"},
        { "location": "562/TALK"  , "narrator": "つばめの新司書", "text": "大いなる葛藤ですね。"},
        { "location": "563/TALK"  , "narrator": "つばめの新司書", "text": "神楽ちゃんを信じるか、\nそれともアーヤさん達を\n信じるか。"},
        { "location": "564/TALK"  , "narrator": "つばめの新司書", "text": "ですが――"},
        { "location": "565/TALK"  , "narrator": "つばめの新司書", "text": "これはどちらも\n間違いですね。"},
        { "location": "566/SEL"   , "narrator": "", "text": "どういうこと！？"},
        { "location": "567/ACT"   , "narrator": "", "text": "どういうこと！？"},
        { "location": "569/TALK"  , "narrator": "つばめの新司書", "text": "正解は、\n『どっちも信じる』"},
        { "location": "570/SEL"   , "narrator": "", "text": "無茶苦茶でしょ"},
        { "location": "571/ACT"   , "narrator": "", "text": "無茶苦茶でしょ"},
        { "location": "573/TALK"  , "narrator": "つばめの新司書", "text": "いえ。\nわたしにとっては、\nそれが一番自然です。"},
        { "location": "574/TALK"  , "narrator": "つばめの新司書", "text": "今ココロの中で発生して\nいる一番の問題は、どちら\nが正しいかではなく――"},
        { "location": "575/TALK"  , "narrator": "つばめの新司書", "text": "どちらかを選ばねば\nならないという\n強迫観念です。"},
        { "location": "576/TALK"  , "narrator": "つばめの新司書", "text": "正直、\n決められないですよ。\n新しい情報もナシには。"},
        { "location": "577/TALK"  , "narrator": "つばめの新司書", "text": "ここで大事なのは、\n焦って未来を壊して\nしまわないことです。"},
        { "location": "578/TALK"  , "narrator": "つばめの新司書", "text": "ですから、選択を必須と\nさせている強迫観念を\n駆除していただければと。"},
        { "location": "579/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "580/SEL"   , "narrator": "", "text": "愛するハニーの為に頑張るよ"},
        { "location": "581/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "582/TALK"  , "narrator": "つばめの新司書", "text": "……。"},
        { "location": "583/TALK"  , "narrator": "つばめの元司書", "text": "わたしと\n$handle$さんに\n素敵なココロの旅を。"},
        { "location": "584/ACT"   , "narrator": "", "text": "愛するハニーの為に頑張るよ"},
        { "location": "586/TALK"  , "narrator": "つばめの新司書", "text": "そ、そんなこと\n言われるなんて、\nサプライズすぎです。"},
        { "location": "587/TALK"  , "narrator": "つばめの新司書", "text": "いってらっしゃい\nダーリン。"},
        { "location": "22/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月3日　 5:17 PM</color>\nとある休日の夕方、都内の某雑貨屋にて"},
        { "location": "289/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "291/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "293/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "295/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "297/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
