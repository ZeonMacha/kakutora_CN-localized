    "entry":
    [
        { "location": "264/SCENARIO", "narrator": "", "text": "820_頑固者同士"},
        { "location": "289/TALK"    , "narrator": "ガブリエラ", "text": "つばめのお父さんは"},
        { "location": "290/TALK"    , "narrator": "ガブリエラ", "text": "やさしいひとなのね"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "きっと"},
        { "location": "293/SEL"     , "narrator": "", "text": "$handle$の方が優しいよ"},
        { "location": "294/SEL"     , "narrator": "", "text": "何かあったの？"},
        { "location": "295/ACT"     , "narrator": "", "text": "$handle$の方が優しいよ"},
        { "location": "296/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "297/ACT"     , "narrator": "", "text": "何かあったの？"},
        { "location": "298/TALK"    , "narrator": "ガブリエラ", "text": "昼間の話を憶えてないかしら"},
        { "location": "299/TALK"    , "narrator": "ガブリエラ", "text": "つばめのお父さんのこと"},
        { "location": "301/TALK"    , "narrator": "ガブリエラ", "text": "つばめのお父さんはつばめにしょっちゅう連絡してくるんですって"},
        { "location": "302/TALK"    , "narrator": "ガブリエラ", "text": "トライナリーに入る時に大喧嘩して、それを振り切って東京にいるのに"},
        { "location": "303/TALK"    , "narrator": "ガブリエラ", "text": "いいえ"},
        { "location": "305/TALK"    , "narrator": "ガブリエラ", "text": "東京にいるから、かしら？"},
        { "location": "306/TALK"    , "narrator": "ガブリエラ", "text": "その話を聞いて、なんだか"},
        { "location": "308/SEL"     , "narrator": "", "text": "寂しくなったのかな？"},
        { "location": "309/SEL"     , "narrator": "", "text": "うらやましかったのかな？"},
        { "location": "310/SEL"     , "narrator": "", "text": "$handle$じゃだめかな？"},
        { "location": "312/ACT"     , "narrator": "", "text": "寂しくなったのかな？"},
        { "location": "313/TALK"    , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "314/TALK"    , "narrator": "ガブリエラ", "text": "なのかしら"},
        { "location": "315/ACT"     , "narrator": "", "text": "うらやましかったのかな？"},
        { "location": "316/TALK"    , "narrator": "ガブリエラ", "text": "そういうこと"},
        { "location": "317/TALK"    , "narrator": "ガブリエラ", "text": "なのかしら"},
        { "location": "318/ACT"     , "narrator": "", "text": "$handle$じゃだめかな？"},
        { "location": "328/TALK"    , "narrator": "ガブリエラ", "text": "$handle$なんて"},
        { "location": "329/TALK"    , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "330/TALK"    , "narrator": "ガブリエラ", "text": "いてくれたら"},
        { "location": "331/TALK"    , "narrator": "ガブリエラ", "text": "うれしいけど//////////////////////////"},
        { "location": "333/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "334/TALK"    , "narrator": "ガブリエラ", "text": "うちの父親が近くにいたら大変よ"},
        { "location": "335/TALK"    , "narrator": "ガブリエラ", "text": "すっごい頑固な人なんだから"},
        { "location": "336/TALK"    , "narrator": "ガブリエラ", "text": "ありえないくらい！！！"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "338/TALK"    , "narrator": "ガブリエラ", "text": "$handle$とのことがばれたら大変よ"},
        { "location": "340/SEL"     , "narrator": "", "text": "どう大変なの"},
        { "location": "341/ACT"     , "narrator": "", "text": "どう大変なの"},
        { "location": "343/TALK"    , "narrator": "ガブリエラ", "text": "とにかく大反対されるに決まってるわ"},
        { "location": "344/TALK"    , "narrator": "ガブリエラ", "text": "$handle$はポーランド人じゃないし"},
        { "location": "345/TALK"    , "narrator": "ガブリエラ", "text": "ポーランド語だって話せないし"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "とにかくだめとしか言われないに決まっているわ"},
        { "location": "348/SEL"     , "narrator": "", "text": "なんとかしてよ"},
        { "location": "349/SEL"     , "narrator": "", "text": "なんとかするよ"},
        { "location": "350/ACT"     , "narrator": "", "text": "なんとかしてよ"},
        { "location": "351/TALK"    , "narrator": "ガブリエラ", "text": "するわ"},
        { "location": "352/TALK"    , "narrator": "ガブリエラ", "text": "するに決まってるわよ"},
        { "location": "353/TALK"    , "narrator": "ガブリエラ", "text": "$handle$とのことなんだから！"},
        { "location": "354/ACT"     , "narrator": "", "text": "なんとかするよ"},
        { "location": "355/TALK"    , "narrator": "ガブリエラ", "text": "$handle$にはなんとかできないわよ！"},
        { "location": "356/TALK"    , "narrator": "ガブリエラ", "text": "本当に頑固なんだから！"},
        { "location": "357/TALK"    , "narrator": "ガブリエラ", "text": "でもなんとかしなくちゃね"},
        { "location": "358/TALK"    , "narrator": "ガブリエラ", "text": "$handle$とのことなんだから！"},
        { "location": "361/SEL"     , "narrator": "", "text": "ありがとう"},
        { "location": "362/ACT"     , "narrator": "", "text": "ありがとう"},
        { "location": "364/TALK"    , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "366/SEL"     , "narrator": "", "text": "真剣に考えてくれてるんだね"},
        { "location": "367/ACT"     , "narrator": "", "text": "真剣に考えてくれてるんだね"},
        { "location": "369/TALK"    , "narrator": "ガブリエラ", "text": "あ"},
        { "location": "370/TALK"    , "narrator": "ガブリエラ", "text": "そんなの"},
        { "location": "372/TALK"    , "narrator": "ガブリエラ", "text": "あたりまえ"},
        { "location": "373/TALK"    , "narrator": "ガブリエラ", "text": "じゃない"},
        { "location": "376/SEL"     , "narrator": "", "text": "うれしいな"},
        { "location": "377/ACT"     , "narrator": "", "text": "うれしいな"},
        { "location": "379/TALK"    , "narrator": "ガブリエラ", "text": "うん/////////////////"},
        { "location": "381/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "382/TALK"    , "narrator": "ガブリエラ", "text": "うちの父親、本当に大変なんだから！！！！"},
        { "location": "383/TALK"    , "narrator": "ガブリエラ", "text": "あの"},
        { "location": "384/TALK"    , "narrator": "ガブリエラ", "text": "前に話したでしょう？"},
        { "location": "385/TALK"    , "narrator": "ガブリエラ", "text": "日本に来てから全然連絡してないし"},
        { "location": "386/TALK"    , "narrator": "ガブリエラ", "text": "向こうからも全然連絡ないんだから"},
        { "location": "388/SEL"     , "narrator": "", "text": "仲直りできるよ"},
        { "location": "389/SEL"     , "narrator": "", "text": "$handle$も手伝うよ"},
        { "location": "390/ACT"     , "narrator": "", "text": "仲直りできるよ"},
        { "location": "391/ACT"     , "narrator": "", "text": "$handle$も手伝うよ"},
        { "location": "393/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "395/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "399/TALK"    , "narrator": "ボイスメール", "text": "いつか手を繋いで"},
        { "location": "324/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "411/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【ガブリエラ】</color>のボイスメール\n<color=red>【いつか手を繋いで】</color>\nをゲットしました！"}
    ]
}
