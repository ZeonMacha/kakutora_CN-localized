    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "魔法少女になろうよ"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "…困ったわね。\nあの怪物、身体が\n恐ろしく固いわ。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "みたいやね…。\nアーヤの剣、\nぼろっぼろやし。"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "もう使えないわね…。\nギャヴィ、そっちは？"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "弾はまだあるけど、\nこっちの攻撃も\n全然効いてないわ。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "これじゃ、いくら\n撃っても弾の無駄よ。"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "だとすると…、\nうちら、どうするが？"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "どうするって、\nそれは…。"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "いや、考えるまでも\nないでしょ？"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "こんなの、\nどうしようも\nないわよ。"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "ギャヴィ！\nあなた、諦める\nつもりなの！？"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "だって、あの怪物には\nこっちの攻撃が\n全然効かないのよ？"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "そんな状況だってのに\nどうしろってのよ。"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "どうって、それは…。"},
        { "location": "87/TALK"   , "narrator": "透明真幌", "text": "解析の結果が出た。\nクリア条件を教える。"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "まほさん、\nナイスタイミングや！"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "それで、\nクリア条件は？"},
        { "location": "93/TALK"   , "narrator": "透明真幌", "text": "アップルティメルティと\nミルクティメルティーだ。"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "…は？"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "まほさん、\n何言うてるがです？"},
        { "location": "101/TALK"  , "narrator": "透明真幌", "text": "いや…私にもよくは\nわからんのだが……"},
        { "location": "102/TALK"  , "narrator": "透明真幌", "text": "その世界は、アニメの\n世界が元になっている\nようだ。"},
        { "location": "103/TALK"  , "narrator": "透明真幌", "text": "えーっと…魔法少女、\nトリプルメルティーズ？"},
        { "location": "104/TALK"  , "narrator": "透明真幌", "text": "…そういうことだ。"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "いや、そういうことと\n言われても、さっぱり\nですよ。"},
        { "location": "107/TALK"  , "narrator": "透明真幌", "text": "つまりだな、その\nスウィーティ―って奴には\n２人の仲間がいるらしい。"},
        { "location": "108/TALK"  , "narrator": "透明真幌", "text": "アップルティーと\nミルクティーという\nヤツがな。"},
        { "location": "109/TALK"  , "narrator": "透明真幌", "text": "なので、おまえ達が\nその二人になって、共に\n敵を倒すことになるな。"},
        { "location": "110/TALK"  , "narrator": "透明真幌", "text": "スウィーティ―って\nヤツと一緒に、\nその怪物を討て。"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "…まさか、それが\nクリア条件ですか？"},
        { "location": "112/TALK"  , "narrator": "透明真幌", "text": "そういうことだ。"},
        { "location": "113/TALK"  , "narrator": "透明真幌", "text": "そうすれば、こちらの\n攻撃も向こうへ通じる\nようになる。"},
        { "location": "114/TALK"  , "narrator": "透明真幌", "text": "必殺技で一撃で倒すことが\nできるとのことだ。"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "何よそれ！\n他に方法はないの！？"},
        { "location": "117/TALK"  , "narrator": "透明真幌", "text": "無いな。"},
        { "location": "118/TALK"  , "narrator": "透明真幌", "text": "とにかく、\n早急に事態の収束を\n頼んだぞ。"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "ちょっ！？\nまほ、まほってば！！"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "信じらんない！\n任務中なのに通信を\n切ったわ！！"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "これ以上通信したまま\nでも、文句を言われる\nだけぞね。"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "そうね。\nでも、この条件なら\n簡単に――"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "…で？\n誰がやるがよ？"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "私パス。\nアーヤとみやびで\nやりなさいよ。"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "グリーンティー\nメルティがいるなら\nえいんやけんど。"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "アップルティ―と\nミルクティ―はパスや。"},
        { "location": "136/TALK"  , "narrator": "アーヤ", "text": "グリーンティー\nなんているの？"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "知らんけんど、\nうちは緑茶好きやきね。"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "お茶の好みの話を\nしてるんじゃない\nでしょ！？"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "ほら、早く早く！\nどんどん被害が\n広がっちゃうわよ！？"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "うちの心にまで\n被害が及ぶのだけは\n避けたいちや。"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "ちゅうわけやき、\n二人に頼んだ！\n決定！"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "絶対イヤ！\nそんな恥ずかしいこと\nやりたくないわ。"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "アーヤもやりたくない\n思うてるが？"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "…そうね。\nまあ、やっぱり\n恥ずかしいし…。"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "じゃあ、どうすんの？\nつばめ達が来るまで\nこのまま放置？"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "それ、帰ったら\nまほさんにめっちゃ\n怒られるやろうね。"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "176/SEL"   , "narrator": "", "text": "ねえ、アーヤ"},
        { "location": "177/ACT"   , "narrator": "", "text": "ねえ、アーヤ"},
        { "location": "194/TALK"  , "narrator": "アーヤ", "text": "任務中(>_<)"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "手短に"},
        { "location": "197/SEL"   , "narrator": "", "text": "本当はやりたいと思ってない？"},
        { "location": "198/SEL"   , "narrator": "", "text": "誰かがやらないとダメなことだよ"},
        { "location": "199/ACT"   , "narrator": "", "text": "本当はやりたいと思ってない？"},
        { "location": "202/TALK"  , "narrator": "アーヤ", "text": "いや"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "まさか！"},
        { "location": "204/TALK"  , "narrator": "アーヤ", "text": "そんなわけないでしょ(--#)"},
        { "location": "205/TALK"  , "narrator": "アーヤ", "text": "っていうか"},
        { "location": "206/TALK"  , "narrator": "アーヤ", "text": "私の年齢だと"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "イタいだけ(T_T)"},
        { "location": "208/TALK"  , "narrator": "アーヤ", "text": "絶対ノいから！"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "無いから！(>_<)"},
        { "location": "210/ACT"   , "narrator": "", "text": "誰かがやらないとダメなことだよ"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "私がやるの？(￣Д￣ )"},
        { "location": "215/TALK"  , "narrator": "アーヤ", "text": "一番年上の私が？"},
        { "location": "217/TALK"  , "narrator": "アーヤ", "text": "そのキャラって何歳？"},
        { "location": "218/TALK"  , "narrator": "アーヤ", "text": "絶対成人じゃないでしょ？"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "なのに"},
        { "location": "220/TALK"  , "narrator": "アーヤ", "text": "私がやるの？( ・_・)σﾞ"},
        { "location": "223/TALK"  , "narrator": "アーヤ", "text": "恥ずかしいから(>_<)"},
        { "location": "224/TALK"  , "narrator": "アーヤ", "text": "みんな見てるし"},
        { "location": "239/TALK"  , "narrator": "透明真幌", "text": "何をやっている！\nクリア条件は伝えた\nだろう！"},
        { "location": "240/TALK"  , "narrator": "透明真幌", "text": "さっさとメルティーズに\nなってその化け物を倒せ！"},
        { "location": "243/TALK"  , "narrator": "ガブリエラ", "text": "簡単に言わないでよ！\n恥をかくのは\nこっちなのよ！？"},
        { "location": "246/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "290/TALK"  , "narrator": "アーヤ", "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。"},
        { "location": "291/SEL"   , "narrator": "", "text": "なんかゴキゲン？"},
        { "location": "292/ACT"   , "narrator": "", "text": "なんかゴキゲン？"},
        { "location": "294/TALK"  , "narrator": "アーヤ", "text": "貴方が来るのを\n待っていたのよ。"},
        { "location": "295/TALK"  , "narrator": "アーヤ", "text": "さあ、早く\nクランを倒して頂戴！"},
        { "location": "296/TALK"  , "narrator": "アーヤ", "text": "早く決断しないと、\n他の子に取られちゃう！"},
        { "location": "297/SEL"   , "narrator": "", "text": "メルティーズのこと？"},
        { "location": "298/ACT"   , "narrator": "", "text": "メルティーズのこと？"},
        { "location": "300/TALK"  , "narrator": "アーヤ", "text": "そうよ！"},
        { "location": "301/SEL"   , "narrator": "", "text": "やりたいの？"},
        { "location": "302/ACT"   , "narrator": "", "text": "やりたいの？"},
        { "location": "305/TALK"  , "narrator": "アーヤ", "text": "もちろんよ！"},
        { "location": "307/TALK"  , "narrator": "アーヤ", "text": "さあ、\nさっさと回すわよ！"},
        { "location": "308/SEL"   , "narrator": "", "text": "あ、はい"},
        { "location": "309/ACT"   , "narrator": "", "text": "あ、はい"},
        { "location": "316/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0x596番地から\n0x221番地へ。"},
        { "location": "331/TALK"  , "narrator": "アーヤ", "text": "シーク完了！"},
        { "location": "332/SEL"   , "narrator": "", "text": "そんなにメルティーズやりたかったなんて、意外……"},
        { "location": "333/SEL"   , "narrator": "", "text": "いつまでも少女の心を忘れないアーヤさんかわいい"},
        { "location": "334/ACT"   , "narrator": "", "text": "そんなにメルティーズやりたかったなんて、意外……"},
        { "location": "336/TALK"  , "narrator": "アーヤ", "text": "あー。貴方も\n「年甲斐も無く」とか\n「恥を知れ」とか――"},
        { "location": "337/TALK"  , "narrator": "アーヤ", "text": "「オバサンがやっても\n嬉しくない」とか\n思ってるんでしょ。"},
        { "location": "338/SEL"   , "narrator": "", "text": "はい"},
        { "location": "339/SEL"   , "narrator": "", "text": "そんなことないよ！"},
        { "location": "340/ACT"   , "narrator": "", "text": "はい"},
        { "location": "342/TALK"  , "narrator": "アーヤ", "text": "……そう。"},
        { "location": "343/TALK"  , "narrator": "アーヤ", "text": "いいわ。別に共感して\nくれなくても。\n仕事さえしてくれれば。"},
        { "location": "344/TALK"  , "narrator": "アーヤ", "text": "國政綾水にとって、\n素敵なココロの旅を。"},
        { "location": "346/ACT"   , "narrator": "", "text": "そんなことないよ！"},
        { "location": "347/TALK"  , "narrator": "アーヤ", "text": "……ほんとに？"},
        { "location": "348/SEL"   , "narrator": "", "text": "はい"},
        { "location": "349/ACT"   , "narrator": "", "text": "はい"},
        { "location": "352/TALK"  , "narrator": "アーヤ", "text": "よかった♪"},
        { "location": "354/ACT"   , "narrator": "", "text": "いつまでも少女の心を忘れないアーヤさんかわいい"},
        { "location": "356/TALK"  , "narrator": "アーヤ", "text": "ホントに\nそう思ってくれるの？\n嬉しい！"},
        { "location": "357/TALK"  , "narrator": "アーヤ", "text": "私、やっぱり\n貴方みたいな人と、\n一生連れ添いたいな。"},
        { "location": "359/TALK"  , "narrator": "アーヤ", "text": "魔法少女になるのは\n私の中でずっと\n憧れだったの！"},
        { "location": "360/TALK"  , "narrator": "アーヤ", "text": "可愛い服着て、\n可愛いポーズつけて、\nとっても可愛いでしょ？"},
        { "location": "361/TALK"  , "narrator": "アーヤ", "text": "でも私って、\n昔から正反対の躾を\n受けてきたから……"},
        { "location": "362/TALK"  , "narrator": "アーヤ", "text": "剣道やってたり、\n生徒会長だったり、\n身長も高かったり――"},
        { "location": "363/SEL"   , "narrator": "", "text": "胸が大きかったり"},
        { "location": "365/TALK"  , "narrator": "アーヤ", "text": "どっちかというと\n子供の頃からずっと\n体育会系女子だったのよ。"},
        { "location": "366/TALK"  , "narrator": "アーヤ", "text": "……ねえ。"},
        { "location": "370/ACT"   , "narrator": "", "text": "胸が大きかったり"},
        { "location": "374/TALK"  , "narrator": "アーヤ", "text": "そこ関係無いから。"},
        { "location": "375/SEL"   , "narrator": "", "text": "魔法少女は胸が小さくなくちゃ！"},
        { "location": "376/SEL"   , "narrator": "", "text": "魔法少女は胸が大きくなくちゃ！"},
        { "location": "377/SEL"   , "narrator": "", "text": "確かに関係ない"},
        { "location": "378/ACT"   , "narrator": "", "text": "魔法少女は胸が小さくなくちゃ！"},
        { "location": "379/TALK"  , "narrator": "アーヤ", "text": "……そ、そうなの？"},
        { "location": "380/TALK"  , "narrator": "アーヤ", "text": "生まれて初めて\nもっと小さければ…って\n思ったかも……。"},
        { "location": "381/ACT"   , "narrator": "", "text": "魔法少女は胸が大きくなくちゃ！"},
        { "location": "382/TALK"  , "narrator": "アーヤ", "text": "ほんと！？\n私、どうかしら。"},
        { "location": "383/SEL"   , "narrator": "", "text": "バッチリです！"},
        { "location": "384/SEL"   , "narrator": "", "text": "全然足りない！"},
        { "location": "385/ACT"   , "narrator": "", "text": "バッチリです！"},
        { "location": "387/TALK"  , "narrator": "アーヤ", "text": "良かった♪"},
        { "location": "388/TALK"  , "narrator": "アーヤ", "text": "貴方にそう言って\nもらえると、なんだか\nちょっと嬉しいかも。"},
        { "location": "389/ACT"   , "narrator": "", "text": "全然足りない！"},
        { "location": "390/TALK"  , "narrator": "アーヤ", "text": "ええっ！？\nそうなの！？"},
        { "location": "391/TALK"  , "narrator": "アーヤ", "text": "ていうことは、\nみやびくらいないと\nダメなのかしら……。"},
        { "location": "393/ACT"   , "narrator": "", "text": "確かに関係ない"},
        { "location": "394/TALK"  , "narrator": "アーヤ", "text": "……よね。"},
        { "location": "397/TALK"  , "narrator": "アーヤ", "text": "そんなわけだから、\n憧れてはいたけど、\nずっと封印してたの。"},
        { "location": "398/TALK"  , "narrator": "アーヤ", "text": "でも、いまここに、\n不可抗力的理由によって\nその夢が実現するのよ！"},
        { "location": "399/TALK"  , "narrator": "アーヤ", "text": "こんなチャンス\nまたとないわ！"},
        { "location": "400/SEL"   , "narrator": "", "text": "トライナリーのコスチュームはダメなの？"},
        { "location": "401/ACT"   , "narrator": "", "text": "トライナリーのコスチュームはダメなの？"},
        { "location": "403/TALK"  , "narrator": "アーヤ", "text": "うーん、あれは\nなんていうか……"},
        { "location": "404/TALK"  , "narrator": "アーヤ", "text": "可愛い……っていう\n感じじゃないわよね。"},
        { "location": "405/SEL"   , "narrator": "", "text": "嫌いなの？"},
        { "location": "406/ACT"   , "narrator": "", "text": "嫌いなの？"},
        { "location": "408/TALK"  , "narrator": "アーヤ", "text": "好きか嫌いかで言ったら\nまあ、嫌いじゃないけど。"},
        { "location": "409/TALK"  , "narrator": "アーヤ", "text": "もうちょっと露出が\n減るといいわよね……。"},
        { "location": "410/TALK"  , "narrator": "アーヤ", "text": "まあ、そんなわけで！\n貴方にはどうでもいい\nことかもしれないけど！"},
        { "location": "411/TALK"  , "narrator": "アーヤ", "text": "今回は私の夢のために\n一肌脱いでちょうだい！"},
        { "location": "412/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "413/SEL"   , "narrator": "", "text": "ぬぎぬぎ"},
        { "location": "414/SEL"   , "narrator": "", "text": "アーヤの心の中って平和だね～"},
        { "location": "415/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "416/TALK"  , "narrator": "アーヤ", "text": "ふふ、ありがと！"},
        { "location": "417/ACT"   , "narrator": "", "text": "ぬぎぬぎ"},
        { "location": "418/TALK"  , "narrator": "アーヤ", "text": "……うーん。"},
        { "location": "420/TALK"  , "narrator": "アーヤ", "text": "そういうの、嫌いじゃ\nないけど、今は\n脱力しちゃうからダメ。"},
        { "location": "421/ACT"   , "narrator": "", "text": "アーヤの心の中って平和だね～"},
        { "location": "422/TALK"  , "narrator": "アーヤ", "text": "え……？"},
        { "location": "424/TALK"  , "narrator": "アーヤ", "text": "…そ、おね！\nこんな悩み\nばっかりだものね。"},
        { "location": "425/TALK"  , "narrator": "アーヤ", "text": "いつもこんなことに\nつき合ってくれて\nありがと。"},
        { "location": "427/TALK"  , "narrator": "アーヤ", "text": "それじゃ、\n気合い入れていくわよ！"},
