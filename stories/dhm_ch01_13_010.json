        { "location": "7/SCENARIO", "narrator": "", "text": "018_バケーションじゃなくても"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "やっぱり行きたかったな"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "研修旅行(´つω・｀)ｼｭﾝ"},
        { "location": "35/SEL"    , "narrator": "", "text": "そんな面白くないよ？"},
        { "location": "36/SEL"    , "narrator": "", "text": "その間、何するの？"},
        { "location": "37/SEL"    , "narrator": "", "text": "どこに行きたかったの？"},
        { "location": "38/ACT"    , "narrator": "", "text": "そんな面白くないよ？"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "(´・ω・`) "},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "そういうのは行ったことがあるからぃぇるんだょ"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "ぁたし行けないのに(´,,･ω･,,｀)"},
        { "location": "43/TALK"   , "narrator": "つばめ", "text": "も"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "ねるね"},
        { "location": "45/ACT"    , "narrator": "", "text": "その間、何するの？"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "残る人は授業だって"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "遅れてるしちょうどぃぃかもだけど"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "超しょんぼりだょ(´,,･ω･,,｀)"},
        { "location": "49/ACT"    , "narrator": "", "text": "どこに行きたかったの？"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "清水寺！"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "あとは金閣寺とか"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "なんか"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "京都っぽぃでしょ(*´︶`*)"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "そぅぃぅところにみんなで回りたかったの"},
        { "location": "58/SEL"    , "narrator": "", "text": "また機会があるよ"},
        { "location": "59/SEL"    , "narrator": "", "text": "夏休みにでも誘ってみれば"},
        { "location": "60/ACT"    , "narrator": "", "text": "また機会があるよ"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "そうかな？"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "だったらぃぃな(*´︶`*)"},
        { "location": "64/ACT"    , "narrator": "", "text": "夏休みにでも誘ってみれば"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "ぇ"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "そぅぃぅのもありかもね"},
        { "location": "70/TALK"   , "narrator": "つばめ", "text": "ぃつかみんなとぃけるとぃぃな"}
