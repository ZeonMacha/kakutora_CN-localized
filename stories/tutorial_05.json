        "title": "HOME解説",
        "sub_title": "チュートリアル_HOME解説"
    },
    "entry":
    [
        { "location": "1552/SCENARIO", "narrator": "", "text": "チュートリアル_HOME解説"},
        { "location": "1562/TALK"    , "narrator": "千羽鶴", "text": "最後に重要な機能の\nおさらいをしておく。"},
        { "location": "1566/TALK"    , "narrator": "千羽鶴", "text": "彼女たちと交流する\nHOME画面の下には、\n６つボタンがある。"},
        { "location": "1567/TALK"    , "narrator": "千羽鶴", "text": "この６つのボタンが、\nすごく重要。\n今からそれを説明する。"},
        { "location": "1570/TALK"    , "narrator": "千羽鶴", "text": "このボタンは\n<color=green>【ストーリー】</color>ボタン。"},
        { "location": "1571/TALK"    , "narrator": "千羽鶴", "text": "記録映像を見つつ、\n彼女たちとふれ合って\nいく最も重要なもの。"},
        { "location": "1572/TALK"    , "narrator": "千羽鶴", "text": "もし貴方が世界の説明や\nバトルの説明を飛ばして\nきていたなら――"},
        { "location": "1573/TALK"    , "narrator": "千羽鶴", "text": "それらの説明も、\nこのボタンの中から\n見ることができる。"},
        { "location": "1576/TALK"    , "narrator": "千羽鶴", "text": "続いて\n<color=green>【ガチャ】</color>ボタン。"},
        { "location": "1577/TALK"    , "narrator": "千羽鶴", "text": "さっきのようにクランを\n手に入れるときに利用す\nる場所ね。"},
        { "location": "1578/TALK"    , "narrator": "千羽鶴", "text": "ジュエルが貯まったら\nまた利用してみて。"},
        { "location": "1581/TALK"    , "narrator": "千羽鶴", "text": "次が\n<color=green>【ショップ】</color>ボタン。"},
        { "location": "1582/TALK"    , "narrator": "千羽鶴", "text": "ゴキゲンポイント、\nクランポイントと\nアイテムを交換したり――"},
        { "location": "1583/TALK"    , "narrator": "千羽鶴", "text": "ジュエルなどを\n購入することができる。"},
        { "location": "1586/TALK"    , "narrator": "千羽鶴", "text": "そしてこれが\n<color=green>【クラン】</color>ボタン。"},
        { "location": "1587/TALK"    , "narrator": "千羽鶴", "text": "彼女の心を守る\nクランたちを強化、\n育成する大事な場所。"},
        { "location": "1588/TALK"    , "narrator": "千羽鶴", "text": "バトルでどのクランを\n使うかを決める、編成も\nここで行う。"},
        { "location": "1591/TALK"    , "narrator": "千羽鶴", "text": "そして最後が\n<color=green>【メニュー】</color>ボタン。"},
        { "location": "1592/TALK"    , "narrator": "千羽鶴", "text": "アイテム一覧やフレンド、\n環境設定など、様々な\n機能がある。"},
        { "location": "1597/TALK"    , "narrator": "千羽鶴", "text": "あ、それと。"},
        { "location": "1599/TALK"    , "narrator": "千羽鶴", "text": "<color=green>【メニュー】</color>ボタンに\n被るように右端にある、\n大きなリングが見える？"},
        { "location": "1600/TALK"    , "narrator": "千羽鶴", "text": "これは<color=green>【CHリング】</color>と\n言って、彼女たちの\nチャンネルを切り替える。"},
        { "location": "1601/TALK"    , "narrator": "千羽鶴", "text": "説明が終わったら早速\n上下に回して、４人の\n様子を見てみて欲しい。"}
    ]
}
