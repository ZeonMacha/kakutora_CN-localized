        { "location": "355/TALK"  , "narrator": "つばめ", "text": "そぅだったの"},
        { "location": "356/ACT"   , "narrator": "", "text": "あまりこうしてもいられない"},
        { "location": "357/TALK"  , "narrator": "つばめ", "text": "ええと"},
        { "location": "358/TALK"  , "narrator": "つばめ", "text": "忙しいのかな"},
        { "location": "359/ACT"   , "narrator": "", "text": "結構危険な状況なんだ"},
        { "location": "360/TALK"  , "narrator": "つばめ", "text": "ぇ"},
        { "location": "362/TALK"  , "narrator": "つばめ", "text": "どうして"},
        { "location": "365/SEL"   , "narrator": "", "text": "捕まるかもしれないんだ"},
        { "location": "366/SEL"   , "narrator": "", "text": "もう話せなくなるかも"},
        { "location": "367/ACT"   , "narrator": "", "text": "捕まるかもしれないんだ"},
        { "location": "368/TALK"  , "narrator": "つばめ", "text": "それは"},
        { "location": "369/TALK"  , "narrator": "つばめ", "text": "ダメだょ"},
        { "location": "370/ACT"   , "narrator": "", "text": "もう話せなくなるかも"},
        { "location": "371/TALK"  , "narrator": "つばめ", "text": "ぇ"},
        { "location": "372/TALK"  , "narrator": "つばめ", "text": "そんな"},
        { "location": "375/SEL"   , "narrator": "", "text": "だからもう話さない"},
        { "location": "376/SEL"   , "narrator": "", "text": "チャットはこれでおしまい"},
        { "location": "377/SEL"   , "narrator": "", "text": "平和になったらまた会おう"},
        { "location": "378/ACT"   , "narrator": "", "text": "だからもう話さない"},
        { "location": "379/TALK"  , "narrator": "つばめ", "text": "そんな"},
        { "location": "381/TALK"  , "narrator": "つばめ", "text": "やだょ"},
        { "location": "382/ACT"   , "narrator": "", "text": "チャットはこれでおしまい"},
        { "location": "383/TALK"  , "narrator": "つばめ", "text": "そぅ"},
        { "location": "385/TALK"  , "narrator": "つばめ", "text": "なんだね"},
        { "location": "386/ACT"   , "narrator": "", "text": "平和になったらまた会おう"},
        { "location": "387/TALK"  , "narrator": "つばめ", "text": "それは"},
        { "location": "389/TALK"  , "narrator": "つばめ", "text": "ぃつなの？"},
        { "location": "402/TALK"  , "narrator": "つばめ", "text": "$handle$さんの\n言ったこと\n本当なのかな…？"},
        { "location": "425/TALK"  , "narrator": "つばめ", "text": "本当だったら\n話し掛けちゃ\nダメだよね…。"},
        { "location": "427/TALK"  , "narrator": "つばめ", "text": "でもわたし、\n$handle$さんと\n話したい……。"},
        { "location": "452/TALK"  , "narrator": "つばめ", "text": "$handle$さんが\n捕まっちゃうのはダメ！"},
        { "location": "455/TALK"  , "narrator": "つばめ", "text": "だけど……。\nやっぱり……。"},
        { "location": "503/TALK"  , "narrator": "つばめ", "text": "　"},
        { "location": "529/TALK"  , "narrator": "千羽鶴", "text": "ごきげんよう。"},
        { "location": "530/SEL"   , "narrator": "", "text": "千羽鶴！！…さん？"},
        { "location": "531/ACT"   , "narrator": "", "text": "千羽鶴！！…さん？"},
        { "location": "533/TALK"  , "narrator": "千羽鶴", "text": "まずはお礼を言わせて。"},
        { "location": "534/TALK"  , "narrator": "千羽鶴", "text": "私がここに戻ってくる間、\n何もコトを起こさずに\nいてくれてありがとう。"},
        { "location": "536/SEL"   , "narrator": "", "text": "つばめの中に戻ったの！？"},
        { "location": "537/SEL"   , "narrator": "", "text": "もしかして、エリカに言おうとしたときにラブラブゲームが始まったのは…"},
        { "location": "538/ACT"   , "narrator": "", "text": "つばめの中に戻ったの！？"},
        { "location": "540/ACT"   , "narrator": "", "text": "もしかして、エリカに言おうとしたときにラブラブゲームが始まったのは…"},
        { "location": "544/SEL"   , "narrator": "", "text": "つばめの中に戻ったの！？"},
        { "location": "545/ACT"   , "narrator": "", "text": "つばめの中に戻ったの！？"},
        { "location": "550/TALK"  , "narrator": "千羽鶴", "text": "いえ。\nまだ完全に戻って\n融和したわけじゃない。"},
        { "location": "551/TALK"  , "narrator": "千羽鶴", "text": "完全に分断されていた\n私の本体と今の姿――"},
        { "location": "552/TALK"  , "narrator": "千羽鶴", "text": "すなわち排出された\n人格である千羽鶴の間に\n専用線を繋いだだけ。"},
        { "location": "553/TALK"  , "narrator": "千羽鶴", "text": "自由に行き来できるよう\nにはなったけど、まだ\n完全に元には戻れない。"},
        { "location": "554/TALK"  , "narrator": "千羽鶴", "text": "私がここへ戻ってきた\n理由は、融和のためでは\nない。"},
        { "location": "555/TALK"  , "narrator": "千羽鶴", "text": "私が『逢瀬つばめ』に\n速やかに戻るために\n必要なこと――"},
        { "location": "556/TALK"  , "narrator": "千羽鶴", "text": "『イシュリール』の眷属を\n一掃する為の前準備を\nしに来ただけ。"},
        { "location": "559/TALK"  , "narrator": "千羽鶴", "text": "そう。\n私が仕掛けた。"},
        { "location": "560/TALK"  , "narrator": "千羽鶴", "text": "どうしてもここに\n戻らなければ\nならなかった。"},
        { "location": "561/TALK"  , "narrator": "千羽鶴", "text": "だから、貴方が彼女に\n何かを伝える可能性を、\n排除させてもらった。"},
        { "location": "562/SEL"   , "narrator": "", "text": "信用されてないね"},
        { "location": "563/SEL"   , "narrator": "", "text": "言わないよ！！"},
        { "location": "564/ACT"   , "narrator": "", "text": "信用されてないね"},
        { "location": "565/TALK"  , "narrator": "千羽鶴", "text": "貴方がどうこうという\n問題よりは、自然科学に\n基づいたホールリペア。"},
        { "location": "566/TALK"  , "narrator": "千羽鶴", "text": "でも、それで気分を\n害してしまったのなら\nごめんなさい。"},
        { "location": "567/ACT"   , "narrator": "", "text": "言わないよ！！"},
        { "location": "569/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "571/TALK"  , "narrator": "千羽鶴", "text": "まあ確かに、ちょっと\n野暮なことをしたかも\nしれない。"},
        { "location": "572/TALK"  , "narrator": "千羽鶴", "text": "貴方は、彼女たちを\nコロシテでも私を\n選ぶと言ってくれた人。"},
        { "location": "574/TALK"  , "narrator": "千羽鶴", "text": "それを信じるなら、\n闇雲に貴方を傷つけた\nだけかも。"},
        { "location": "575/TALK"  , "narrator": "千羽鶴", "text": "ごめんなさい。"},
        { "location": "577/TALK"  , "narrator": "千羽鶴", "text": "……本当に？"},
        { "location": "579/TALK"  , "narrator": "千羽鶴", "text": "貴方がどうこうという\n問題ではなく、私の完全\n主義的行動の現れだから。"},
        { "location": "582/TALK"  , "narrator": "千羽鶴", "text": "とにかく、多少強引にでも\nここへの帰還を\n為し得ねばならなかった。"},
        { "location": "583/TALK"  , "narrator": "千羽鶴", "text": "私が『逢瀬つばめ』に\n速やかに戻るために\n必要なこと――"},
        { "location": "584/TALK"  , "narrator": "千羽鶴", "text": "『イシュリール』の眷属を\n一掃する前準備の為に。"},
        { "location": "586/SEL"   , "narrator": "", "text": "イシュリールの眷属って…"},
        { "location": "587/ACT"   , "narrator": "", "text": "イシュリールの眷属って…"},
        { "location": "589/TALK"  , "narrator": "千羽鶴", "text": "カレン・ディサイプロブ・\nイシュリール――。"},
        { "location": "590/TALK"  , "narrator": "千羽鶴", "text": "彼女を筆頭とする、\n逢瀬つばめの中にいる\nノイズたちのこと。"},
        { "location": "591/TALK"  , "narrator": "千羽鶴", "text": "彼女たちが存在する為に、\n私は一枚岩となって、真の\n理想社会が創成できない。"},
        { "location": "592/TALK"  , "narrator": "千羽鶴", "text": "貴方には見えてないと\n思うけど、今この日本は\n見えない戦争をしている。"},
        { "location": "593/TALK"  , "narrator": "千羽鶴", "text": "『イシュリール』の眷属に\nよる理想社会の阻止と、\nそれに対抗する勢力。"},
        { "location": "594/TALK"  , "narrator": "千羽鶴", "text": "この２つの勢力は\n常に日本の状況を巡って\n牽制し合っている。"},
        { "location": "595/TALK"  , "narrator": "千羽鶴", "text": "その為、私のビジョンたる\n理想社会も、対立眷属に\nよる末期的社会も――"},
        { "location": "596/TALK"  , "narrator": "千羽鶴", "text": "どちらも顕在出来ず、\n世界は青写真のまま。"},
        { "location": "597/SEL"   , "narrator": "", "text": "カレンがそんなことしてるようには見えないけど"},
        { "location": "598/SEL"   , "narrator": "", "text": "てことは、カレンが勝っても世界は変わるの？"},
        { "location": "599/ACT"   , "narrator": "", "text": "カレンがそんなことしてるようには見えないけど"},
        { "location": "600/TALK"  , "narrator": "千羽鶴", "text": "じゃあ、\n何をしていた？"},
        { "location": "601/SEL"   , "narrator": "", "text": "ココロの司書…？"},
        { "location": "602/SEL"   , "narrator": "", "text": "$me$とラブラブしていた"},
        { "location": "603/ACT"   , "narrator": "", "text": "ココロの司書…？"},
        { "location": "604/TALK"  , "narrator": "千羽鶴", "text": "それを言ったら\n私も同じじゃない？"},
        { "location": "605/TALK"  , "narrator": "千羽鶴", "text": "ラブラブナビを\nしていただけだもの。"},
        { "location": "606/SEL"   , "narrator": "", "text": "いや、そんなことは…"},
        { "location": "607/ACT"   , "narrator": "", "text": "いや、そんなことは…"},
        { "location": "609/ACT"   , "narrator": "", "text": "$me$とラブラブしていた"},
        { "location": "611/TALK"  , "narrator": "百鶴", "text": "いえ！\nわたしの方が\nラブラブ――"},
        { "location": "613/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "615/TALK"  , "narrator": "百鶴", "text": "何でもありません。"},
        { "location": "618/TALK"  , "narrator": "千羽鶴", "text": "とにかく。"},
        { "location": "619/TALK"  , "narrator": "千羽鶴", "text": "人格の戦争は、物理体と\n違って、物理攻撃による\nものではないの。"},
        { "location": "620/TALK"  , "narrator": "千羽鶴", "text": "それは、外的要因や\n内面の変化によってのみ\nパワーバランスを変える。"},
        { "location": "621/ACT"   , "narrator": "", "text": "てことは、カレンが勝っても世界は変わるの？"},
        { "location": "622/TALK"  , "narrator": "千羽鶴", "text": "もちろんそうなる。"},
        { "location": "623/TALK"  , "narrator": "千羽鶴", "text": "恐らく彼女の展開する\n世界は、他のフェノ\nメノンと変わらない。"},
        { "location": "624/TALK"  , "narrator": "千羽鶴", "text": "何の知識も持たない彼女は\n形だけのユートピアを\n作ることでしょう。"},
        { "location": "625/TALK"  , "narrator": "千羽鶴", "text": "けど幸いなことに、\n彼女の眷属には、\n世界創造の欲は無い。"},
        { "location": "626/TALK"  , "narrator": "千羽鶴", "text": "単に私が作りたいと\n考えている理想社会を\n阻止したいだけ。"},
        { "location": "628/TALK"  , "narrator": "千羽鶴", "text": "私が私自身について\n最終的に為し得たいことは\nただ１つ。"},
        { "location": "629/TALK"  , "narrator": "千羽鶴", "text": "『イシュリール』の眷属を\n一人残らず消滅させ、\nその後融和回帰すること。"},
        { "location": "630/TALK"  , "narrator": "千羽鶴", "text": "それは、私たちが\n本当の『逢瀬つばめ』に\n戻ることとも言える。"},
        { "location": "631/SEL"   , "narrator": "", "text": "要するにカレンを消滅させに来たってこと？"},
        { "location": "632/ACT"   , "narrator": "", "text": "要するにカレンを消滅させに来たってこと？"},
        { "location": "634/TALK"  , "narrator": "千羽鶴", "text": "いいえ。"},
        { "location": "635/TALK"  , "narrator": "千羽鶴", "text": "人格は、人格を削除\nすることができない。"},
        { "location": "636/TALK"  , "narrator": "千羽鶴", "text": "それが出来ていたら、\nカレンか私のどちらかは、\n既にこの世にいない。"},
        { "location": "637/TALK"  , "narrator": "千羽鶴", "text": "もっと貴方にとって\n判りやすい表現をすれば、\nそんな事ができるなら――"},
        { "location": "638/TALK"  , "narrator": "千羽鶴", "text": "忘れたいことを都合良く\n忘れたり、好きな性格に\nすぐに豹変できる。"},
        { "location": "639/TALK"  , "narrator": "千羽鶴", "text": "でも実際人間は、忘れたい\nことは忘れられない。"},
        { "location": "640/TALK"  , "narrator": "千羽鶴", "text": "理想の自分にも\nなかなかなれない。"},
        { "location": "641/TALK"  , "narrator": "千羽鶴", "text": "それは、人格という\n存在を、無根拠に消す事が\nできないから。"},
        { "location": "642/SEL"   , "narrator": "", "text": "じゃあどうするの"},
        { "location": "643/ACT"   , "narrator": "", "text": "じゃあどうするの"},
        { "location": "646/TALK"  , "narrator": "千羽鶴", "text": "唯一の消去方法は、\n既に知ってるはず。"},
        { "location": "647/TALK"  , "narrator": "千羽鶴", "text": "その想いを生み出した存在\nだけが、その想いを否定\nすることができる。"},
        { "location": "648/TALK"  , "narrator": "千羽鶴", "text": "そしてそれ自体は\n現実の方で進行している。"},
        { "location": "649/TALK"  , "narrator": "千羽鶴", "text": "私がここでやるべき事は、\n『イシュリール』の眷属を\nバラバラにし――"},
        { "location": "650/TALK"  , "narrator": "千羽鶴", "text": "カレン・ディサイプロブ・\nイシュリールを無力化する\nこと。"},
        { "location": "651/TALK"  , "narrator": "千羽鶴", "text": "そうすることで、\nより確実に否定を\n受け入れるようになる。"},
        { "location": "653/TALK"  , "narrator": "千羽鶴", "text": "というわけで――"},
        { "location": "655/TALK"  , "narrator": "千羽鶴", "text": "カレン・ディサイプロブ・\nイシュリールはどう？\n見つかった？"},
        { "location": "657/TALK"  , "narrator": "百鶴", "text": "いえ。\n依然として\n消息不明ですね。"},
        { "location": "658/TALK"  , "narrator": "千羽鶴", "text": "そう。\n急いで。"},
        { "location": "659/TALK"  , "narrator": "百鶴", "text": "らじゃ。"},
        { "location": "660/TALK"  , "narrator": "千羽鶴", "text": "私は今から別件で\n他のココロスフィアに\n行かなければならない。"},
        { "location": "661/TALK"  , "narrator": "千羽鶴", "text": "戻ってくる時までに\nカレンを拘束している\nことを願ってる。"},
        { "location": "662/TALK"  , "narrator": "百鶴", "text": "……。"},
        { "location": "664/TALK"  , "narrator": "千羽鶴", "text": "ということ。\nちょっと今日は忙しいから\nこれで。"},
        { "location": "665/TALK"  , "narrator": "千羽鶴", "text": "ご縁があれば、他の子の\nココロスフィアで\n会えるかもしれないけど。"},
        { "location": "666/TALK"  , "narrator": "千羽鶴", "text": "それじゃ。"},
        { "location": "670/TALK"  , "narrator": "百鶴", "text": "……。"},
        { "location": "671/TALK"  , "narrator": "百鶴", "text": "どうしましたか？"},
        { "location": "672/SEL"   , "narrator": "", "text": "いや、葛藤の解決を……"},
        { "location": "673/SEL"   , "narrator": "", "text": "カレン消されちゃうの？"},
        { "location": "674/ACT"   , "narrator": "", "text": "いや、葛藤の解決を……"},
        { "location": "675/TALK"  , "narrator": "百鶴", "text": "……あ？"},
        { "location": "676/TALK"  , "narrator": "百鶴", "text": "おお、そうでした。"},
        { "location": "677/ACT"   , "narrator": "", "text": "カレン消されちゃうの？"},
        { "location": "678/TALK"  , "narrator": "百鶴", "text": "……。"},
        { "location": "679/TALK"  , "narrator": "百鶴", "text": "まあ。"},
        { "location": "680/TALK"  , "narrator": "百鶴", "text": "遂に来たるべき時が\n来たというだけですよ。"},
        { "location": "681/SEL"   , "narrator": "", "text": "カレンを助けてあげて！"},
        { "location": "682/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "683/ACT"   , "narrator": "", "text": "カレンを助けてあげて！"},
        { "location": "687/TALK"  , "narrator": "百鶴", "text": "うるさいですね\n■■野郎が！"},
        { "location": "689/TALK"  , "narrator": "百鶴", "text": "部外者は\nおだまりやがれです！"},
        { "location": "690/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "691/TALK"  , "narrator": "百鶴", "text": "そういうことです。"},
        { "location": "693/TALK"  , "narrator": "百鶴", "text": "……。"},
        { "location": "694/TALK"  , "narrator": "百鶴", "text": "……？"},
        { "location": "695/TALK"  , "narrator": "百鶴", "text": "まだ何か？"},
        { "location": "696/SEL"   , "narrator": "", "text": "いや、葛藤の解決を……"},
        { "location": "697/ACT"   , "narrator": "", "text": "いや、葛藤の解決を……"},
        { "location": "699/TALK"  , "narrator": "百鶴", "text": "……あ？"},
        { "location": "700/TALK"  , "narrator": "百鶴", "text": "おお、そうでした。"},
        { "location": "702/TALK"  , "narrator": "百鶴", "text": "それではちゃっちゃと\n扉を回しますか。"},
        { "location": "703/TALK"  , "narrator": "百鶴", "text": "オープンプロセス、\n0x115番地から\n0x013番地へ。"},
        { "location": "705/TALK"  , "narrator": "百鶴", "text": "……って、これ\n明らかに我が主からの\n指示ではないですよね？"},
        { "location": "706/TALK"  , "narrator": "百鶴", "text": "まあいいです。\n回しちまったものは\n仕方ありません。"},
        { "location": "727/TALK"  , "narrator": "百鶴", "text": "シーク完了しました。"},
        { "location": "729/TALK"  , "narrator": "百鶴", "text": "……。"},
        { "location": "731/TALK"  , "narrator": "百鶴", "text": "なんですか、\n$handle$さんの\n自爆案件じゃないですか。"},
        { "location": "732/SEL"   , "narrator": "", "text": "すみません"},
        { "location": "733/SEL"   , "narrator": "", "text": "ここへ来たいという使命感から"},
        { "location": "734/ACT"   , "narrator": "", "text": "すみません"},
        { "location": "735/TALK"  , "narrator": "百鶴", "text": "迷惑なので\nやめてくださいね。"},
        { "location": "736/ACT"   , "narrator": "", "text": "ここへ来たいという使命感から"},
        { "location": "737/TALK"  , "narrator": "百鶴", "text": "その理由は？"},
        { "location": "738/SEL"   , "narrator": "", "text": "前回の件で、心の中が心配だったので"},
        { "location": "739/SEL"   , "narrator": "", "text": "百鶴（妻）に会いたかったので"},
        { "location": "740/ACT"   , "narrator": "", "text": "前回の件で、心の中が心配だったので"},
        { "location": "741/TALK"  , "narrator": "百鶴", "text": "なるほど。\nしかしそれは\n取り越し苦労です。"},
        { "location": "742/SEL"   , "narrator": "", "text": "全然そんなこと無さそうなんだけど…"},
        { "location": "743/ACT"   , "narrator": "", "text": "全然そんなこと無さそうなんだけど…"},
        { "location": "745/TALK"  , "narrator": "百鶴", "text": "あなたの中ではな！"},
        { "location": "746/ACT"   , "narrator": "", "text": "百鶴（妻）に会いたかったので"},
        { "location": "748/TALK"  , "narrator": "百鶴", "text": "えっ！？\nそうだったんですか？"},
        { "location": "749/TALK"  , "narrator": "百鶴", "text": "そうならそうと、\n先に言ってくれれば\n良かったのにです♪"},
        { "location": "750/TALK"  , "narrator": "百鶴", "text": "ちゅっちゅしたい気持ちは\nよくわかりますが、今日は\n忙しいのでまた今度。"},
        { "location": "754/TALK"  , "narrator": "百鶴", "text": "というわけで、\n早速葛藤を何とか\nしてきやがれ。"},
        { "location": "755/TALK"  , "narrator": "百鶴", "text": "急いで！"},
        { "location": "766/TALK"  , "narrator": "百鶴", "text": "…ふぅ。"},
        { "location": "767/TALK"  , "narrator": "百鶴", "text": "だいぶ遅く\nなっちゃいましたね。"},
        { "location": "781/TALK"  , "narrator": "カレン　", "text": "…はぁ…　…"},
        { "location": "784/TALK"  , "narrator": "百鶴", "text": "生きてますか。"},
        { "location": "786/TALK"  , "narrator": "カレン　", "text": "ああっ、百鶴さん！"},
        { "location": "787/TALK"  , "narrator": "百鶴", "text": "遅くなりました。\n■■野郎が来ていたので。"},
        { "location": "788/TALK"  , "narrator": "カレン　", "text": "$handle$さん、\n来てたんですね。"},
        { "location": "789/TALK"  , "narrator": "百鶴", "text": "お陰で遅くなって\nスーパーが閉店間際に\nなってしまい――"},
        { "location": "790/TALK"  , "narrator": "百鶴", "text": "既に焼きそばパンしか\nありませんでした。"},
        { "location": "791/TALK"  , "narrator": "カレン　", "text": "わぁっ！\nありがとうございます！"},
        { "location": "792/TALK"  , "narrator": "カレン　", "text": "百鶴さん\nやさしいです。"},
        { "location": "793/TALK"  , "narrator": "カレン　", "text": "匿ってくれて\nありがとうございます…。"},
        { "location": "794/TALK"  , "narrator": "百鶴", "text": "……。"},
        { "location": "795/TALK"  , "narrator": "百鶴", "text": "まあ、私にも\n色々考えるところは\nあるのですよ。"},
        { "location": "796/TALK"  , "narrator": "百鶴", "text": "それじゃ私は行きますけど\nもう少し静かにしていて\nくださいね。"},
        { "location": "797/TALK"  , "narrator": "カレン　", "text": "はい！"},
        { "location": "22/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月11日　 3:04 PM</color>\n都内某所にて、千羽鶴による監禁中のこと。"},
        { "location": "468/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "470/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "472/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "474/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "476/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
