{
    "dir": "dramatics/daydra/drm_ch02_00_260.js",
    "type": "Episode",
    "info": {
        "story_id": "2026",
        "cid": "ayami",
        "title": "らぶとーく 第26話",
        "sub_title": "通常運行"
    },
    "entry":
    [
        { "location": "168/SCENARIO", "narrator": "", "text": "通常運行"},
        { "location": "180/TALK"    , "narrator": "アーヤ", "text": "うーん…想像以上に\nガタが来てるわね…。"},
        { "location": "181/TALK"    , "narrator": "アーヤ", "text": "こりゃ、お店持ってって\n任せた方が早いかも…。"},
        { "location": "185/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと、アーヤ。"},
        { "location": "187/TALK"    , "narrator": "アーヤ", "text": "あら、ギャヴィじゃない。\nつばめも一緒なのね。"},
        { "location": "190/TALK"    , "narrator": "つばめ", "text": "わぁ、凄いです！\nバイクの整備をしてるん\nですか？"},
        { "location": "191/TALK"    , "narrator": "アーヤ", "text": "ええ、久しぶりにね。"},
        { "location": "193/TALK"    , "narrator": "ガブリエラ", "text": "どうでもいいけど、\n外で独り言はやめた方が\nいいわよ？"},
        { "location": "194/TALK"    , "narrator": "ガブリエラ", "text": "知らない人が見たら、\n変な人に思われるし。"},
        { "location": "196/TALK"    , "narrator": "アーヤ", "text": "私、独り言なんて\n言ってた？"},
        { "location": "197/TALK"    , "narrator": "ガブリエラ", "text": "ガタが来てるとか、\nお店持ってった方が\n早いとか、ね。"},
        { "location": "199/TALK"    , "narrator": "アーヤ", "text": "…気付かなかったわ。"},
        { "location": "202/TALK"    , "narrator": "つばめ", "text": "そんなにガタが来てるん\nですか？"},
        { "location": "203/TALK"    , "narrator": "つばめ", "text": "私には、凄くピカピカに\n見えますけど…。"},
        { "location": "206/TALK"    , "narrator": "アーヤ", "text": "中見の方がちょっとね。"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "ブレーキパッドは\n摩耗してるし、エンジン\nオイルは少ないし――"},
        { "location": "209/TALK"    , "narrator": "アーヤ", "text": "クラッチワイヤーも\nちょっと錆びてるし…。"},
        { "location": "212/TALK"    , "narrator": "ガブリエラ", "text": "どういうものかはさっぱり\nだけど、メンテナンスを\nサボッてたせいよね？"},
        { "location": "213/TALK"    , "narrator": "アーヤ", "text": "したくても、忙しくて\nできなかったのよ。"},
        { "location": "215/TALK"    , "narrator": "アーヤ", "text": "はぁ…まあ、次の休みに\nでもお店持って行くわ。"},
        { "location": "217/TALK"    , "narrator": "つばめ", "text": "ふーん…。"},
        { "location": "219/TALK"    , "narrator": "つばめ", "text": "バイクをお店に持って\n行く時って――"},
        { "location": "220/TALK"    , "narrator": "つばめ", "text": "お店まではバイクに\n乗って行くんですか？"},
        { "location": "222/TALK"    , "narrator": "アーヤ", "text": "ええ、そうよ。"},
        { "location": "223/TALK"    , "narrator": "つばめ", "text": "あの、その時、\nわたしも一緒に行って\nいいですか？"},
        { "location": "225/TALK"    , "narrator": "アーヤ", "text": "良いけど…つばめも\nバイクに興味出てきた？"},
        { "location": "226/TALK"    , "narrator": "つばめ", "text": "うーん…自分で乗るのは\n怖そうですけど――"},
        { "location": "227/TALK"    , "narrator": "つばめ", "text": "アーヤさんの後ろには、\n一度乗ってみたいなぁ、\nって思ってて…。"},
        { "location": "231/TALK"    , "narrator": "ガブリエラ", "text": "はぁ！？"},
        { "location": "233/TALK"    , "narrator": "つばめ", "text": "だって、バイクの後ろって\n乗ったことないんだもん。"},
        { "location": "234/TALK"    , "narrator": "アーヤ", "text": "あはは、まあ中々無いと\n思うわよ？"},
        { "location": "235/TALK"    , "narrator": "アーヤ", "text": "私も、後ろに乗ったことは\n一度もないし。"},
        { "location": "237/TALK"    , "narrator": "つばめ", "text": "だから、アーヤさんが\n良ければ、一度後ろに\n乗せてもらいたいんです。"},
        { "location": "239/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "241/TALK"    , "narrator": "ガブリエラ", "text": "止めた方が良いわよ。\nアーヤの後ろに乗るのは\nお勧めしないわ。"},
        { "location": "243/TALK"    , "narrator": "アーヤ", "text": "失礼ね。\nそこまでガタが来てる\nわけじゃないわ。"},
        { "location": "245/TALK"    , "narrator": "ガブリエラ", "text": "そうじゃなくて、\nつばめがアーヤの後ろに\n乗れると思う？"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "腕力もないし、アーヤの\n乱暴運転に耐えられなくて\nすっ飛ばされちゃうわ。"},
        { "location": "249/TALK"    , "narrator": "アーヤ", "text": "誰が乱暴よ？"},
        { "location": "251/TALK"    , "narrator": "つばめ", "text": "大丈夫だよ、ガブちゃん。\n乗る時はしっかりと\nアーヤさんに捕まるから。"},
        { "location": "253/TALK"    , "narrator": "ガブリエラ", "text": "人の忠告は聞きなさいよ。\nやめた方がいい、って\n言ってるでしょ？"},
        { "location": "255/TALK"    , "narrator": "つばめ", "text": "でも、前から乗ってみたい\nって思ってて…。"},
        { "location": "258/TALK"    , "narrator": "アーヤ", "text": "…何でかしら？"},
        { "location": "259/TALK"    , "narrator": "アーヤ", "text": "なんか、ギャヴィが執拗に\n乗せたがってないような\n感じがするけど…。"},
        { "location": "260/TALK"    , "narrator": "アーヤ", "text": "私的には別にどっちでも\nいいんだけど、どうしよう\nかしら…？"},
        { "location": "261/TALK"    , "narrator": "アーヤ", "text": "…聞いてみようかしら？"},
        { "location": "273/TALK"    , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "274/TALK"    , "narrator": "アーヤ", "text": "今っていい？"},
        { "location": "276/SEL"     , "narrator": "", "text": "大丈夫だよ"},
        { "location": "277/ACT"     , "narrator": "", "text": "大丈夫だよ"},
        { "location": "279/TALK"    , "narrator": "アーヤ", "text": "よかった(*^.^*)"},
        { "location": "280/TALK"    , "narrator": "アーヤ", "text": "つばめがね"},
        { "location": "281/TALK"    , "narrator": "アーヤ", "text": "バイクの後ろに乗りたがってるんだけど"},
        { "location": "282/TALK"    , "narrator": "アーヤ", "text": "ギャヴィがちょっと不機嫌になってるの(>_<)"},
        { "location": "283/TALK"    , "narrator": "アーヤ", "text": "どうしたらいいかしら？"},
        { "location": "286/SEL"     , "narrator": "", "text": "乗せるのはやめよう"},
        { "location": "287/ACT"     , "narrator": "", "text": "乗せるのはやめよう"},
        { "location": "289/TALK"    , "narrator": "アーヤ", "text": "じゃあ"},
        { "location": "291/TALK"    , "narrator": "アーヤ", "text": "断らないといけないわね（；￢＿￢）"},
        { "location": "293/SEL"     , "narrator": "", "text": "自分で免許を取れと言え"},
        { "location": "294/SEL"     , "narrator": "", "text": "後ろは事故の時危ないと言え"},
        { "location": "295/SEL"     , "narrator": "", "text": "その前に整備できるようにならないとねと言え"},
        { "location": "296/ACT"     , "narrator": "", "text": "自分で免許を取れと言え"},
        { "location": "297/TALK"    , "narrator": "アーヤ", "text": "それじゃ結局後ろに乗れないんだけど（；￢＿￢）"},
        { "location": "298/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "300/TALK"    , "narrator": "アーヤ", "text": "適当に理由は付けておくわ(；´Д｀)"},
        { "location": "311/TALK"    , "narrator": "アーヤ", "text": "…バイクに乗ってみたい、\nって思うなら、後ろじゃ\nなくて――"},
        { "location": "313/TALK"    , "narrator": "アーヤ", "text": "自分で免許を取って、\n運転した方がいいわ。"},
        { "location": "316/TALK"    , "narrator": "つばめ", "text": "わ、わたしが！？"},
        { "location": "317/TALK"    , "narrator": "アーヤ", "text": "ええ…っていうか、\n普通二輪だったら\nもう取れる年齢でしょ？"},
        { "location": "318/TALK"    , "narrator": "アーヤ", "text": "大型はまだ無理だけど、\nとりあえず取ってみたら？"},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "う、うーん…、\n取れるかなぁ？"},
        { "location": "322/TALK"    , "narrator": "アーヤ", "text": "平気よ。\n受験勉強に比べれば、\n試験も簡単だしね。"},
        { "location": "324/TALK"    , "narrator": "ガブリエラ", "text": "そっか…つばめはもう、\n免許が取れる年齢なの\nよね？"},
        { "location": "326/TALK"    , "narrator": "つばめ", "text": "う、うん、そうみたい…。\nわたし、もうそんな年齢に\nなってたんだね…。"},
        { "location": "328/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "330/TALK"    , "narrator": "ガブリエラ", "text": "なんか、負けた気がして\n超悔しいんだけど？"},
        { "location": "332/TALK"    , "narrator": "アーヤ", "text": "いや、そこは年齢なん\nだから仕方ないでしょ…。"},
        { "location": "333/ACT"     , "narrator": "", "text": "後ろは事故の時危ないと言え"},
        { "location": "334/TALK"    , "narrator": "アーヤ", "text": "なるほど"},
        { "location": "335/TALK"    , "narrator": "アーヤ", "text": "それなら諦めてもらえそうね(=^0^=)"},
        { "location": "347/TALK"    , "narrator": "アーヤ", "text": "…後ろに乗せるのは\n構わないんだけど――"},
        { "location": "349/TALK"    , "narrator": "アーヤ", "text": "事故の時危ないから、\nあまりお勧めはしないわ。"},
        { "location": "351/TALK"    , "narrator": "つばめ", "text": "えっ…そうなんですか？"},
        { "location": "353/TALK"    , "narrator": "ガブリエラ", "text": "そういえば、二人乗りで\n同乗者だけが死亡、って\nニュース――"},
        { "location": "354/TALK"    , "narrator": "ガブリエラ", "text": "時々見る気がするわ。"},
        { "location": "357/TALK"    , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "359/TALK"    , "narrator": "アーヤ", "text": "まあ、私も危険な運転を\nしたりするつもりはないん\nだけど――"},
        { "location": "360/TALK"    , "narrator": "アーヤ", "text": "バイクの状態も完全じゃ\nないから、今はちょっと\n不安かも…。"},
        { "location": "362/TALK"    , "narrator": "アーヤ", "text": "…どうする？"},
        { "location": "364/TALK"    , "narrator": "つばめ", "text": "…やっぱり、\nやめておきます。"},
        { "location": "366/TALK"    , "narrator": "ガブリエラ", "text": "うんうん、それがいいわ。"},
        { "location": "369/TALK"    , "narrator": "つばめ", "text": "…バイクって、\n思ってたより\n危ない乗り物なんですね。"},
        { "location": "371/TALK"    , "narrator": "アーヤ", "text": "…ちょっと、怖がらせ\n過ぎちゃったかしら？"},
        { "location": "372/ACT"     , "narrator": "", "text": "その前に整備できるようにならないとねと言え"},
        { "location": "373/TALK"    , "narrator": "アーヤ", "text": "それ、結構酷じゃない？(；´Д｀)"},
        { "location": "375/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "376/TALK"    , "narrator": "アーヤ", "text": "乗せない理由としては使えそうだけど"},
        { "location": "388/TALK"    , "narrator": "アーヤ", "text": "…バイクに乗りたいなら、\nまずはそれなりに準備が\n必要になるわ。"},
        { "location": "390/TALK"    , "narrator": "つばめ", "text": "準備、ですか？"},
        { "location": "391/TALK"    , "narrator": "アーヤ", "text": "ええ…まあ、簡単な\n整備くらいはできるように\nならないとね。"},
        { "location": "393/TALK"    , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "395/TALK"    , "narrator": "ガブリエラ", "text": "あ～…まあ、確かにねー。"},
        { "location": "397/TALK"    , "narrator": "ガブリエラ", "text": "乗り物に乗る以上は、\nそれの整備くらいは\n出来なきゃダメよね。"},
        { "location": "399/TALK"    , "narrator": "つばめ", "text": "…それって、車も？"},
        { "location": "402/TALK"    , "narrator": "ガブリエラ", "text": "く、車は別よ。\nあれは大勢で乗るための\n乗り物なんだし。"},
        { "location": "404/TALK"    , "narrator": "つばめ", "text": "そっか…。"},
        { "location": "406/TALK"    , "narrator": "つばめ", "text": "じゃあ、わたしにはまだ\n乗れなさそうかも…。"},
        { "location": "407/TALK"    , "narrator": "アーヤ", "text": "ふふっ…まあ、もし興味が\nあるんだったら――"},
        { "location": "408/TALK"    , "narrator": "アーヤ", "text": "つばめもバイクの免許、\n取った方がいいかもね。"}
    ]
}
