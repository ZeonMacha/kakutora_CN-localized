    "entry":
    [
        { "location": "514/SCENARIO", "narrator": "", "text": "すれ違い"},
        { "location": "539/TALK"    , "narrator": "つばめ", "text": "ぁたしどうしてみんなと違っちゃうんだろう？"},
        { "location": "540/TALK"    , "narrator": "つばめ", "text": "なんでみんな、ぁたしと違うことを言うんだろう？"},
        { "location": "541/TALK"    , "narrator": "つばめ", "text": "ぁたしは卯月さんのことが心配なの(´・ω・｀)"},
        { "location": "542/TALK"    , "narrator": "つばめ", "text": "だってあんなにがんばりやさんだったんだょ？"},
        { "location": "543/TALK"    , "narrator": "つばめ", "text": "来なくなったのは絶対理由がぁるはずだょ(´・ω・｀)"},
        { "location": "544/TALK"    , "narrator": "つばめ", "text": "なのにどうして、みんな卯月さんのこと悪く言うの？"},
        { "location": "546/TALK"    , "narrator": "つばめ", "text": "ぁたし、もう全然わかんなぃ・・・(´,,･ω･,,｀)"},
        { "location": "548/SEL"     , "narrator": "", "text": "よしよし"},
        { "location": "549/SEL"     , "narrator": "", "text": "大丈夫だよ"},
        { "location": "550/SEL"     , "narrator": "", "text": "昼間のことかな？"},
        { "location": "551/ACT"     , "narrator": "", "text": "よしよし"},
        { "location": "552/TALK"    , "narrator": "つばめ", "text": "ぁりがとぅヽ(；▽；)ノ"},
        { "location": "553/ACT"     , "narrator": "", "text": "大丈夫だよ"},
        { "location": "554/TALK"    , "narrator": "つばめ", "text": "だったらぃぃけど"},
        { "location": "555/TALK"    , "narrator": "つばめ", "text": "ほんとうにそうかな(´・ω・`) "},
        { "location": "556/ACT"     , "narrator": "", "text": "昼間のことかな？"},
        { "location": "557/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "558/TALK"    , "narrator": "つばめ", "text": "そうなの・・・(´,,･ω･,,｀)"},
        { "location": "560/TALK"    , "narrator": "つばめ", "text": "みんなひどいょね"},
        { "location": "562/TALK"    , "narrator": "つばめ", "text": "$handle$さんはどう思う？"},
        { "location": "564/SEL"     , "narrator": "", "text": "それぞれの考えがあるからね"},
        { "location": "565/SEL"     , "narrator": "", "text": "わかってもらいたいよね"},
        { "location": "566/ACT"     , "narrator": "", "text": "それぞれの考えがあるからね"},
        { "location": "567/TALK"    , "narrator": "つばめ", "text": "そうだね(´･ω･｀) "},
        { "location": "568/TALK"    , "narrator": "つばめ", "text": "それはわかるんだょ(´･ω･｀) "},
        { "location": "569/TALK"    , "narrator": "つばめ", "text": "でも・・・|д･´)"},
        { "location": "570/ACT"     , "narrator": "", "text": "わかってもらいたいよね"},
        { "location": "580/TALK"    , "narrator": "つばめ", "text": "そうなの！"},
        { "location": "581/TALK"    , "narrator": "つばめ", "text": "わかってもらぃたぃのヽ(；▽；)ノ！！"},
        { "location": "582/TALK"    , "narrator": "つばめ", "text": "卯月さんは悪い子なんかじゃなぃってこととか"},
        { "location": "583/TALK"    , "narrator": "つばめ", "text": "でも・・・|д･´)"},
        { "location": "584/TALK"    , "narrator": "つばめ", "text": "そうぃぅの、ぁたし伝えるのが下手で(´･ω･｀) "},
        { "location": "585/TALK"    , "narrator": "つばめ", "text": "$handle$さんはわかってくれるのにね_(┐「ε:)_"},
        { "location": "587/TALK"    , "narrator": "つばめ", "text": "$handle$さんはどうするの？"},
        { "location": "588/TALK"    , "narrator": "つばめ", "text": "こぅぃうとき"},
        { "location": "590/TALK"    , "narrator": "つばめ", "text": "なんだかみんなに気持ちが伝わらないなって時"},
        { "location": "592/SEL"     , "narrator": "", "text": "とりあえず寝る"},
        { "location": "593/SEL"     , "narrator": "", "text": "気持ちを整理する"},
        { "location": "594/SEL"     , "narrator": "", "text": "風呂に入る"},
        { "location": "595/ACT"     , "narrator": "", "text": "とりあえず寝る"},
        { "location": "596/TALK"    , "narrator": "つばめ", "text": "寝るの？"},
        { "location": "597/TALK"    , "narrator": "つばめ", "text": "そっかー(･Д･｀)"},
        { "location": "598/TALK"    , "narrator": "つばめ", "text": "それで気持ちを切り替えるのかな？？？？"},
        { "location": "599/TALK"    , "narrator": "つばめ", "text": "やってみよぅかな"},
        { "location": "600/TALK"    , "narrator": "つばめ", "text": "おゃすみなさぃ・・・ヾ(*´ｴ`*)ﾉ"},
        { "location": "601/ACT"     , "narrator": "", "text": "気持ちを整理する"},
        { "location": "602/TALK"    , "narrator": "つばめ", "text": "ぅーん"},
        { "location": "604/TALK"    , "narrator": "つばめ", "text": "ぐちゃぐちゃだから伝わらなぃのかな・・・(･Д･｀)"},
        { "location": "606/TALK"    , "narrator": "つばめ", "text": "何かに書いてまとめてみょぅかな(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "607/TALK"    , "narrator": "つばめ", "text": "やってみるね"},
        { "location": "608/TALK"    , "narrator": "つばめ", "text": "ありがとうヽ(〃´∀`〃)ﾉ"},
        { "location": "609/ACT"     , "narrator": "", "text": "風呂に入る"},
        { "location": "610/TALK"    , "narrator": "つばめ", "text": "おふろかぁ(･Д･｀)"},
        { "location": "611/TALK"    , "narrator": "つばめ", "text": "ちょっと頭をひやしたほうがぃぃのかな(●´ω｀●)ゞ"},
        { "location": "612/TALK"    , "narrator": "つばめ", "text": "テルマエに行ってこようかな"},
        { "location": "614/TALK"    , "narrator": "つばめ", "text": "じゃぁね(*´︶`*)"},
        { "location": "616/TALK"    , "narrator": "つばめ", "text": "ぁ"},
        { "location": "617/TALK"    , "narrator": "つばめ", "text": "その前に"},
        { "location": "618/TALK"    , "narrator": "つばめ", "text": "言っとくね"},
        { "location": "621/TALK"    , "narrator": "ボイスメール", "text": "触れられるなら"},
        { "location": "576/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>800pt.</b></color></size>\nアップしました！"},
