        "title": "らぶとーく  第28話",
        "sub_title": "チャンスをあげる"
    },
    "entry":
    [
        { "location": "157/SCENARIO", "narrator": "", "text": "チャンスをあげる"},
        { "location": "170/TALK"    , "narrator": "ガブリエラ", "text": "…あら？\nあそこにいるのって…。"},
        { "location": "171/TALK"    , "narrator": "ヒカル", "text": "…………。"},
        { "location": "172/TALK"    , "narrator": "ガブリエラ", "text": "ヒカルくんだ。\nこんなところで\n何してるのかしら？"},
        { "location": "173/TALK"    , "narrator": "ガブリエラ", "text": "時間を気にしてる？\n誰かと待ち合わせでも\nしてるのかしら？"},
        { "location": "174/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "187/TALK"    , "narrator": "ガブリエラ", "text": "$handle$、聞いてる？"},
        { "location": "189/SEL"     , "narrator": "", "text": "どうしたの？"},
        { "location": "190/ACT"     , "narrator": "", "text": "どうしたの？"},
        { "location": "192/TALK"    , "narrator": "ガブリエラ", "text": "チャンスをあげるわ"},
        { "location": "193/TALK"    , "narrator": "ガブリエラ", "text": "ヒカルくんと何を話せばいいのか"},
        { "location": "194/TALK"    , "narrator": "ガブリエラ", "text": "それを教えなさい"},
        { "location": "196/SEL"     , "narrator": "", "text": "男の人とは話せないでしょ？"},
        { "location": "197/ACT"     , "narrator": "", "text": "男の人とは話せないでしょ？"},
        { "location": "199/TALK"    , "narrator": "ガブリエラ", "text": "スマホで筆談するから平気よ！"},
        { "location": "200/TALK"    , "narrator": "ガブリエラ", "text": "いいから、早く話題！"},
        { "location": "202/SEL"     , "narrator": "", "text": "ポーランドの話"},
        { "location": "203/SEL"     , "narrator": "", "text": "勉強のこと"},
        { "location": "204/SEL"     , "narrator": "", "text": "好きな物を聞け"},
        { "location": "205/ACT"     , "narrator": "", "text": "ポーランドの話"},
        { "location": "206/TALK"    , "narrator": "ガブリエラ", "text": "なるほど"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "互いの共通点から攻めていく、ってことね"},
        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "少し見直したわ"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "えっと…まずは\nこっちに気付いて\nもらわないと…。"},
        { "location": "222/TALK"    , "narrator": "ガブリエラ", "text": "…ふ、服の裾引っ張る\nくらい…いいよね？"},
        { "location": "223/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "226/TALK"    , "narrator": "ヒカル", "text": "ん？"},
        { "location": "229/TALK"    , "narrator": "ヒカル", "text": "あれ？\nガブリエラさんじゃ\nないですか。"},
        { "location": "230/TALK"    , "narrator": "ヒカル", "text": "こんにちは。\nお買い物ですか？"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "えっと…そうです、と。"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "234/TALK"    , "narrator": "ヒカル", "text": "そうだったんですか。"},
        { "location": "235/TALK"    , "narrator": "ヒカル", "text": "僕は、友達とここで\n待ち合わせをしているん\nです。"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり…それじゃあ、\nそれまでは時間がある\nってことね。"},
        { "location": "239/TALK"    , "narrator": "ガブリエラ", "text": "えっと…ポーランドの\n好きなところって、\nどんなところですか？"},
        { "location": "241/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "242/TALK"    , "narrator": "ヒカル", "text": "えっと…そうですね…。"},
        { "location": "243/TALK"    , "narrator": "ヒカル", "text": "つまらない感想に\nなってしまうかも\nしれませんが――"},
        { "location": "244/TALK"    , "narrator": "ヒカル", "text": "綺麗なところ、\nでしょうか？"},
        { "location": "245/TALK"    , "narrator": "ガブリエラ", "text": "…綺麗なところって、\n例えば？"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "247/TALK"    , "narrator": "ヒカル", "text": "ワルシャワの街並みが\n大好きなんです。"},
        { "location": "248/TALK"    , "narrator": "ヒカル", "text": "あと、凄く素敵な教会が\nあって、そこが凄く\n気に入ってしまって…。"},
        { "location": "249/TALK"    , "narrator": "ガブリエラ", "text": "教会っていうと、\nもしかして！"},
        { "location": "250/TALK"    , "narrator": "ガブリエラ", "text": "聖十字架教会ですか、\nっと。"},
        { "location": "252/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "254/TALK"    , "narrator": "ヒカル", "text": "そう、そこです！\nガブリエラさんも\n知ってるんですか？"},
        { "location": "255/TALK"    , "narrator": "ガブリエラ", "text": "何度か行ったことが\nあります、っと。"},
        { "location": "256/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "257/TALK"    , "narrator": "ヒカル", "text": "そうだったんですか。"},
        { "location": "258/TALK"    , "narrator": "ヒカル", "text": "嬉しいなぁ。\nまさか、あの教会の話を\n日本でできるなんて。"},
        { "location": "259/TALK"    , "narrator": "ガブリエラ", "text": "やった！\n楽しんでくれたみたい。"},
        { "location": "262/TALK"    , "narrator": "ヒカル", "text": "…あ、いけない。\nそろそろ約束の時間だ。"},
        { "location": "263/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ、あたしも\nそろそろ行きます、\nっと。"},
        { "location": "264/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "265/TALK"    , "narrator": "ヒカル", "text": "はい。\nまた学校で。"},
        { "location": "269/TALK"    , "narrator": "ガブリエラ", "text": "ふぅ…ふふっ。"},
        { "location": "281/TALK"    , "narrator": "ガブリエラ", "text": "やったわ、大成功よ！"},
        { "location": "283/TALK"    , "narrator": "ガブリエラ", "text": "ヒカルくんと、また色々お話で来たわ"},
        { "location": "285/SEL"     , "narrator": "", "text": "よかったね"},
        { "location": "286/ACT"     , "narrator": "", "text": "よかったね"},
        { "location": "288/TALK"    , "narrator": "ガブリエラ", "text": "認めたくないけど、$handle$のアドバイスのおかげね"},
        { "location": "289/TALK"    , "narrator": "ガブリエラ", "text": "少しは役に立つじゃない"},
        { "location": "290/TALK"    , "narrator": "ガブリエラ", "text": "これからも頼むわよ"},
        { "location": "301/ACT"     , "narrator": "", "text": "勉強のこと"},
        { "location": "302/TALK"    , "narrator": "ガブリエラ", "text": "つまらないわね、何それ？"},
        { "location": "303/TALK"    , "narrator": "ガブリエラ", "text": "あ、でも"},
        { "location": "304/TALK"    , "narrator": "ガブリエラ", "text": "苦手な教科の話とかすれば、二人っきりで教えてくれたりするかしら？"},
        { "location": "316/TALK"    , "narrator": "ガブリエラ", "text": "…ふふっ。\nよし、それに決めた！"},
        { "location": "317/TALK"    , "narrator": "ガブリエラ", "text": "えっと…まずは\nこっちに気付いて\nもらわないと…。"},
        { "location": "319/TALK"    , "narrator": "ガブリエラ", "text": "…ふ、服の裾引っ張る\nくらい…いいよね？"},
        { "location": "320/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "323/TALK"    , "narrator": "ヒカル", "text": "ん？"},
        { "location": "325/TALK"    , "narrator": "ヒカル", "text": "あれ？\nガブリエラさんじゃ\nないですか。"},
        { "location": "326/TALK"    , "narrator": "ヒカル", "text": "こんにちは。\nお買い物ですか？"},
        { "location": "327/TALK"    , "narrator": "ガブリエラ", "text": "えっと…そうです、と。"},
        { "location": "328/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "329/TALK"    , "narrator": "ヒカル", "text": "そうだったんですか。"},
        { "location": "330/TALK"    , "narrator": "ヒカル", "text": "僕は、友達とここで\n待ち合わせをしているん\nです。"},
        { "location": "332/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり…それじゃあ、\nそれまでは時間がある\nってことね。"},
        { "location": "333/TALK"    , "narrator": "ガブリエラ", "text": "えっと…あたしは、\n参考書を見に来たん\nです、っと。"},
        { "location": "334/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "335/TALK"    , "narrator": "ヒカル", "text": "そうだったんですか。\n勉強熱心なんですね。"},
        { "location": "336/TALK"    , "narrator": "ヒカル", "text": "僕もガブリエラさんに\n負けないように、もっと\n勉強しないと…。"},
        { "location": "338/TALK"    , "narrator": "ガブリエラ", "text": "…そういえば、\nヒカルくんって苦手な\n教科とかあるのかしら？"},
        { "location": "339/TALK"    , "narrator": "ガブリエラ", "text": "えっと…苦手な教科って\nあるんですか、っと。"},
        { "location": "341/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "342/TALK"    , "narrator": "ヒカル", "text": "うーん…そうですね…。"},
        { "location": "343/TALK"    , "narrator": "ヒカル", "text": "国語…特に古文とかが\n苦手ですね。"},
        { "location": "345/TALK"    , "narrator": "ガブリエラ", "text": "あっ、それわかる！"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "レ点とか、未然形とか、\n色々あって難しいです\nよね、っと。"},
        { "location": "347/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "349/TALK"    , "narrator": "ヒカル", "text": "ガブリエラさんも\nそう思いますか？"},
        { "location": "350/TALK"    , "narrator": "ヒカル", "text": "本当、あれはどれだけ\n勉強しても、中々理解が\n出来なくて困ります…。"},
        { "location": "352/TALK"    , "narrator": "ガブリエラ", "text": "そっか…ヒカルくんも\n古文が苦手なんだ…。"},
        { "location": "353/TALK"    , "narrator": "ガブリエラ", "text": "ふふっ、共通点が\n見つかったわ。"},
        { "location": "354/TALK"    , "narrator": "ガブリエラ", "text": "良ければ、今度一緒に\n勉強しませんか？\nっと。"},
        { "location": "356/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "357/TALK"    , "narrator": "ヒカル", "text": "ええ、是非。"},
        { "location": "358/TALK"    , "narrator": "ヒカル", "text": "わからないところは、\nお互い助け合いながら\n勉強しましょう。"},
        { "location": "360/ACT"     , "narrator": "", "text": "好きな物を聞け"},
        { "location": "362/TALK"    , "narrator": "ガブリエラ", "text": "はぁ！？"},
        { "location": "363/TALK"    , "narrator": "ガブリエラ", "text": "好きって、つまり好きな人とか、タイプとか/////////"},
        { "location": "365/SEL"     , "narrator": "", "text": "食べ物とか動物とか"},
        { "location": "366/ACT"     , "narrator": "", "text": "食べ物とか動物とか"},
        { "location": "368/TALK"    , "narrator": "ガブリエラ", "text": "ああ"},
        { "location": "369/TALK"    , "narrator": "ガブリエラ", "text": "そういうことね"},
        { "location": "370/TALK"    , "narrator": "ガブリエラ", "text": "ビックリさせないでよ！"},
        { "location": "381/TALK"    , "narrator": "ガブリエラ", "text": "えっと…まずは\nこっちに気付いて\nもらわないと…。"},
        { "location": "383/TALK"    , "narrator": "ガブリエラ", "text": "…ふ、服の裾引っ張る\nくらい…いいよね？"},
        { "location": "384/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "387/TALK"    , "narrator": "ヒカル", "text": "ん？"},
        { "location": "389/TALK"    , "narrator": "ヒカル", "text": "あれ？\nガブリエラさんじゃ\nないですか。"},
        { "location": "390/TALK"    , "narrator": "ヒカル", "text": "こんにちは。\nお買い物ですか？"},
        { "location": "391/TALK"    , "narrator": "ガブリエラ", "text": "えっと…そうです、と。"},
        { "location": "392/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "393/TALK"    , "narrator": "ヒカル", "text": "そうだったんですか。"},
        { "location": "394/TALK"    , "narrator": "ヒカル", "text": "僕は、友達とここで\n待ち合わせをしているん\nです。"},
        { "location": "396/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり…それじゃあ、\nそれまでは時間がある\nってことね。"},
        { "location": "397/TALK"    , "narrator": "ガブリエラ", "text": "あの、唐突で驚くかも\nしれないけど――"},
        { "location": "398/TALK"    , "narrator": "ガブリエラ", "text": "好きな食べ物とか\n動物を教えてもらえま\nせんか、っと。"},
        { "location": "399/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "400/TALK"    , "narrator": "ヒカル", "text": "え？　食べ物と動物、\nですか？"},
        { "location": "401/TALK"    , "narrator": "ヒカル", "text": "うーん、そうですね…。"},
        { "location": "402/TALK"    , "narrator": "ヒカル", "text": "動物だったら、\n犬が好きですね。"},
        { "location": "403/TALK"    , "narrator": "ガブリエラ", "text": "犬かぁ…。\nチワワとかかしら？"},
        { "location": "404/TALK"    , "narrator": "ヒカル", "text": "大きくてふわふわした\n犬が大好きなんですよ。"},
        { "location": "406/TALK"    , "narrator": "ガブリエラ", "text": "えっ！？\nちょっとイメージと\n違うかも…。"},
        { "location": "407/TALK"    , "narrator": "ガブリエラ", "text": "ゴールデンレトリバー\nとかですか、っと。"},
        { "location": "408/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "410/TALK"    , "narrator": "ヒカル", "text": "レトリバーも大きくて\n好きですよ。"},
        { "location": "411/TALK"    , "narrator": "ヒカル", "text": "でも、一番好きなのは\nグレート・ピレニーズ\nという犬なんです。"},
        { "location": "412/TALK"    , "narrator": "ヒカル", "text": "…知ってますか？"},
        { "location": "414/TALK"    , "narrator": "ガブリエラ", "text": "凄く大きい犬、って\nいうのは知ってます、\nっと。"},
        { "location": "416/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "417/TALK"    , "narrator": "ヒカル", "text": "そうなんです。\n本当、凄く大きいん\nですよ。"},
        { "location": "419/TALK"    , "narrator": "ガブリエラ", "text": "…なんで、その犬が\n好きなんですか、っと。"},
        { "location": "421/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "424/TALK"    , "narrator": "ヒカル", "text": "そ、それはその…、\nみんなには秘密にして\nくださいね？"},
        { "location": "425/TALK"    , "narrator": "ヒカル", "text": "実は凄く小さい頃に、\n近所で飼われていた\nその犬の――"},
        { "location": "426/TALK"    , "narrator": "ヒカル", "text": "背中に乗せてもらった\nことがあって…。"},
        { "location": "428/TALK"    , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "430/TALK"    , "narrator": "ガブリエラ", "text": "何それ！？\n凄く可愛い！！"},
        { "location": "433/TALK"    , "narrator": "ヒカル", "text": "それからというもの、\nグレート・ピレニーズが\n大好きなんです。"},
        { "location": "434/TALK"    , "narrator": "ガブリエラ", "text": "…そっか。\nそんなことが\nあったんだ…。"},
        { "location": "435/TALK"    , "narrator": "ガブリエラ", "text": "また背中に乗れると\nいいですね、っと。"},
        { "location": "437/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "439/TALK"    , "narrator": "ヒカル", "text": "あはは、そうですね。"},
        { "location": "440/TALK"    , "narrator": "ヒカル", "text": "僕も、出来ればもう一度\n乗ってみたいです。"},
        { "location": "167/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　1:35 PM</color>\nとある休日の午後、神楽坂付近の町中にて。"}
    ]
}
