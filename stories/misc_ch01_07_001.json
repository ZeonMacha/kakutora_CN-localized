        { "location": "7/SCENARIO", "narrator": "", "text": "05-006_めまいの予感"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "フェノメノンの中"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "入ったことある？"},
        { "location": "36/SEL"    , "narrator": "", "text": "ないなあ"},
        { "location": "37/SEL"    , "narrator": "", "text": "いや、無理"},
        { "location": "38/SEL"    , "narrator": "", "text": "大丈夫だった？"},
        { "location": "39/ACT"    , "narrator": "", "text": "ないなあ"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "そっか"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "なぃんだね(*´︶`*)"},
        { "location": "43/ACT"    , "narrator": "", "text": "いや、無理"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "そぅなの(´ω｀*)"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "そぅかもね"},
        { "location": "46/ACT"    , "narrator": "", "text": "大丈夫だった？"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "ぁ"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "ぅん"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "大丈夫だょ"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "なんかね"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "大変だったんだ"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "ぁとね"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "ちょっと空気がね"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "変な感じだった"},
        { "location": "60/SEL"    , "narrator": "", "text": "変って？"},
        { "location": "61/SEL"    , "narrator": "", "text": "メンバーとの空気感？"},
        { "location": "62/SEL"    , "narrator": "", "text": "閉鎖空間だからじゃない"},
        { "location": "63/ACT"    , "narrator": "", "text": "変って？"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "何て言えばぃぃのかな"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "なんか重いってぃぅか"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "息苦しぃ？"},
        { "location": "68/ACT"    , "narrator": "", "text": "メンバーとの空気感？"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "ぇ"},
        { "location": "70/TALK"   , "narrator": "つばめ", "text": "そうぃぅことじゃなぃよ？"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "そぅぃぅことなのかな？"},
        { "location": "74/ACT"    , "narrator": "", "text": "閉鎖空間だからじゃない"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "ぁ"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "そぅぃぅことなのかな"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "なんか"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "違うのは"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "なんか"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "とにかく変な感じで"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "慣れるしかないんだよね"},
        { "location": "86/TALK"   , "narrator": "つばめ", "text": "きっと"},
        { "location": "88/SEL"    , "narrator": "", "text": "そうだね"},
        { "location": "89/SEL"    , "narrator": "", "text": "慣れなくてもいいんじゃない"},
        { "location": "90/SEL"    , "narrator": "", "text": "頑張って"},
        { "location": "91/ACT"    , "narrator": "", "text": "そうだね"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "そぅだょね(*´︶`*)"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "頑張らなきゃねヽ(･ω･ )ゝ☆"},
        { "location": "94/ACT"    , "narrator": "", "text": "慣れなくてもいいんじゃない"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "そぅなのかな"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "やっぱり"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "慣れた方がぃぃ気がする"},
        { "location": "99/ACT"    , "narrator": "", "text": "頑張って"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "頑張るね"}
    ]
