        "title": "らぶとーく  第36話",
        "sub_title": "失恋"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "失恋"},
        { "location": "18/TALK"   , "narrator": "ガブリエラ", "text": "…髪型ＯＫ。\n歯も磨いたし、\n服も汚れてないし――"},
        { "location": "19/TALK"   , "narrator": "ガブリエラ", "text": "うん、完璧！\n準備ＯＫ！"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "$handle$、おかしなところはないかしら？"},
        { "location": "34/SEL"    , "narrator": "", "text": "気合入ってるね"},
        { "location": "35/ACT"    , "narrator": "", "text": "気合入ってるね"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "気が付いた？"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "ヒカルくんがあたしに話があるみたいなの！"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "みんなに内緒で二人きりで"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "何の話だと思う？"},
        { "location": "43/SEL"    , "narrator": "", "text": "愛の告白"},
        { "location": "44/SEL"    , "narrator": "", "text": "先輩として忠告がある"},
        { "location": "45/SEL"    , "narrator": "", "text": "お金の相談"},
        { "location": "46/ACT"    , "narrator": "", "text": "愛の告白"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりそうよね/////////"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "みんなに内緒で二人きりで会いたいなんて"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "それ以外考えられないわ/////////"},
        { "location": "50/ACT"    , "narrator": "", "text": "先輩として忠告がある"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "なにそれ？"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "私、何も悪いことしてないわよ！？"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "心配になるようなこと言わないで！"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "そんなはずないんだから"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "…ないわよね？"},
        { "location": "57/ACT"    , "narrator": "", "text": "お金の相談"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "絶対にありえないと思うけど？"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "お金の相談をするような仲じゃないし"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "でも、もし本当にそうだったとしたら"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "どうしよう…"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "私もそんなに持ってないんだけど…"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "って、いけない！\nそろそろ行かないと。"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "ふふっ…楽しみだわ。"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "えっと…。"},
        { "location": "102/TALK"  , "narrator": "ヒカル", "text": "ガブリエラさん、\nこっちです。"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "っ！！"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "いた！\n本当に…。"},
        { "location": "107/TALK"  , "narrator": "ヒカル", "text": "突然呼び出してしまって\nすみません…。"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "あっ、携帯！"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "えっと…こちらこそ\n待たせてごめんなさい、\nっと。"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "116/TALK"  , "narrator": "ヒカル", "text": "いえ、僕が早く来過ぎた\nだけですから…。"},
        { "location": "118/TALK"  , "narrator": "ヒカル", "text": "とりあえず、\nまずは座って何か\n注文しちゃいましょう。"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "なんだか、ちょっと\n緊張して来たかも…。"},
        { "location": "131/TALK"  , "narrator": "ヒカル", "text": "…本当、すみません。\n放課後に呼び出したり\nしてしまって…。"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "これで六回目…。"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "ヒカルくん、さっきから\n謝ってばかり…。"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "これって…ヒカルくんも\n緊張してる証拠…よね？"},
        { "location": "137/TALK"  , "narrator": "ヒカル", "text": "…………。"},
        { "location": "139/TALK"  , "narrator": "ヒカル", "text": "本当、すみません。\n僕、さっきからずっと、\n謝ってばかりですね。"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "142/TALK"  , "narrator": "ヒカル", "text": "長引かせても、きっと\nどんどん言い難くなると\n思うので――"},
        { "location": "145/TALK"  , "narrator": "ヒカル", "text": "思い切って、言います！"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "き、来た！！\n告白！！"},
        { "location": "152/TALK"  , "narrator": "ヒカル", "text": "あ、あの…実は…。"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "154/TALK"  , "narrator": "ヒカル", "text": "ガブリエラさんに…\n相談したいことが\nありまして…。"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "…………？"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "そう、だん？"},
        { "location": "160/TALK"  , "narrator": "ヒカル", "text": "…あれ？\nガブリエラさん？"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "なんだ…告白じゃ\nなかったんだ…。"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "165/TALK"  , "narrator": "ヒカル", "text": "す、すみません！\n迷惑でしたよね…。"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "あっ！"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "違うんです！\nそうじゃなくて――"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "何で呼ばれたのかが\nわかって、安心した\nだけです、っと。"},
        { "location": "173/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "175/TALK"  , "narrator": "ヒカル", "text": "そうですか…。"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、現実なんて\nこんなもんよね。"},
        { "location": "178/TALK"  , "narrator": "ガブリエラ", "text": "…それで、相談って\nなんですか、っと。"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "183/TALK"  , "narrator": "ヒカル", "text": "はい…その、驚かないで\nくださいね。"},
        { "location": "184/TALK"  , "narrator": "ヒカル", "text": "実は…僕、その…。"},
        { "location": "185/TALK"  , "narrator": "ヒカル", "text": "ひなこさんのことが\n好きで…告白しようと\n考えていて…。"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "…………えっ？"},
        { "location": "188/TALK"  , "narrator": "ヒカル", "text": "お、驚きましたよね？\n急にこんなこと\n言われて…。"},
        { "location": "190/TALK"  , "narrator": "ヒカル", "text": "けど、その…こういう\nこと相談できるの――"},
        { "location": "191/TALK"  , "narrator": "ヒカル", "text": "ガブリエラさんしか\n思いつかなくて…。"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "200/TALK"  , "narrator": "ヒカル", "text": "ああ…実は僕、\nガブリエラさんの\nことは前から――"},
        { "location": "201/TALK"  , "narrator": "ヒカル", "text": "妹のような存在だと\n思っているので――"},
        { "location": "202/TALK"  , "narrator": "ヒカル", "text": "言い難い話も、\n言いやすいんです。"},
        { "location": "204/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "206/TALK"  , "narrator": "ヒカル", "text": "それでですね――"},
        { "location": "207/TALK"  , "narrator": "ヒカル", "text": "その、ひなこさんへの\n告白ですが――"},
        { "location": "208/TALK"  , "narrator": "ヒカル", "text": "そ、その…どんなことを\n言ったり、すればいいか\nわからなくて…。"},
        { "location": "209/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "211/TALK"  , "narrator": "ヒカル", "text": "…僕、どうすれば\n良いと思いますか？"},
        { "location": "212/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "213/TALK"  , "narrator": "ガブリエラ", "text": "ひなこは、みんなが\n思ってるよりも恋愛に\n対して奥手です。"},
        { "location": "214/TALK"  , "narrator": "ガブリエラ", "text": "だから、あまり強引に\nならないよう気を付けて\nください、っと。"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "218/TALK"  , "narrator": "ヒカル", "text": "…そう、ですか…。"},
        { "location": "220/TALK"  , "narrator": "ヒカル", "text": "…難しそうです。\n僕、こういうのって\n慣れてないから…。"},
        { "location": "222/TALK"  , "narrator": "ガブリエラ", "text": "っ！！"},
        { "location": "223/TALK"  , "narrator": "ガブリエラ", "text": "弱気になるな！！"},
        { "location": "224/TALK"  , "narrator": "ガブリエラ", "text": "っ！！"},
        { "location": "226/TALK"  , "narrator": "ヒカル", "text": "えっ？"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "そんな弱気の告白じゃ、\n誰だってＯＫして\nくれません！"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "もっと、自信持ってください！"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "230/TALK"  , "narrator": "ヒカル", "text": "…………。"},
        { "location": "232/TALK"  , "narrator": "ガブリエラ", "text": "大丈夫です。"},
        { "location": "233/TALK"  , "narrator": "ガブリエラ", "text": "ヒカルくんなら、\nきっと大丈夫だから。"},
        { "location": "234/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "236/TALK"  , "narrator": "ヒカル", "text": "…ありがとう\nございます。"},
        { "location": "237/TALK"  , "narrator": "ヒカル", "text": "やっぱり、\nガブリエラさんに\n相談して正解でした。"},
        { "location": "238/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "239/TALK"  , "narrator": "ガブリエラ", "text": "頑張ってくださいね。\nそれじゃあ…。"},
        { "location": "240/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "241/TALK"  , "narrator": "ヒカル", "text": "はい…また学校で。"},
        { "location": "243/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "244/SEL"   , "narrator": "", "text": "ガブリエラ、大丈夫？"},
        { "location": "245/ACT"   , "narrator": "", "text": "ガブリエラ、大丈夫？"},
        { "location": "250/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "251/SEL"   , "narrator": "", "text": "ガブリエラ！"},
        { "location": "252/ACT"   , "narrator": "", "text": "ガブリエラ！"},
        { "location": "258/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "16/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　 10:12 AM</color>\nとある休日、ガブリエラの部屋でのこと"}
    ]
}
