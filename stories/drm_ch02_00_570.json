        "title": "らぶとーく 第56話",
        "sub_title": "スキップ気分で"
    },
    "entry":
    [
        { "location": "151/SCENARIO", "narrator": "", "text": "スキップ気分で"},
        { "location": "164/TALK"    , "narrator": "ガブリエラ", "text": "そういえば――"},
        { "location": "165/TALK"    , "narrator": "ガブリエラ", "text": "今日は学校で、\n調理実習があったの。"},
        { "location": "167/TALK"    , "narrator": "アーヤ", "text": "へぇ…お魚でも焼いたの？"},
        { "location": "169/TALK"    , "narrator": "ガブリエラ", "text": "まさか。"},
        { "location": "171/TALK"    , "narrator": "ガブリエラ", "text": "これがもう、すっごい\n子供っぽくて退屈な\n内容だったのよ。"},
        { "location": "173/TALK"    , "narrator": "ガブリエラ", "text": "お米を炊くでしょ？\nそれとお味噌汁を\n作って――"},
        { "location": "174/TALK"    , "narrator": "ガブリエラ", "text": "おかずに野菜炒めを\n作るだけなんだもの。"},
        { "location": "177/TALK"    , "narrator": "みやび", "text": "ほほぅ…美味しそうやとは\n思うけんど――"},
        { "location": "178/TALK"    , "narrator": "みやび", "text": "簡単に作れる献立ばっか\nっちゅう感じやね。"},
        { "location": "179/TALK"    , "narrator": "ガブリエラ", "text": "でもね、みんな驚くほど\n料理が出来ないの。"},
        { "location": "180/TALK"    , "narrator": "ガブリエラ", "text": "野菜は上手く切れないし、\nみそ汁はグツグツ沸騰させ\nまくってるし――"},
        { "location": "182/TALK"    , "narrator": "ガブリエラ", "text": "米の研ぎ方も、水に浸して\nかき混ぜてるだけなの。"},
        { "location": "184/TALK"    , "narrator": "ガブリエラ", "text": "ジャッジャッて音しないと\n研いでることにならない\nじゃない、まったく…。"},
        { "location": "186/TALK"    , "narrator": "アーヤ", "text": "あはは…ギャヴィの\n気持ちはわからなくは\nないけど――"},
        { "location": "188/TALK"    , "narrator": "アーヤ", "text": "あんまり文句を言ったら\nかわいそうよ。"},
        { "location": "190/TALK"    , "narrator": "ガブリエラ", "text": "何よ？\nアーヤはみんなの\n味方するの？"},
        { "location": "191/TALK"    , "narrator": "アーヤ", "text": "だって、ギャヴィは\nみんなと違って、\n毎日自炊してるでしょ？"},
        { "location": "192/TALK"    , "narrator": "アーヤ", "text": "その時点で、みんなより\nずっと料理のテクニックは\n上なんだもの。"},
        { "location": "194/TALK"    , "narrator": "ガブリエラ", "text": "…うん…まあね…。"},
        { "location": "195/TALK"    , "narrator": "アーヤ", "text": "だから、ギャヴィには\n退屈な授業だったかも\nしれないけど――"},
        { "location": "196/TALK"    , "narrator": "アーヤ", "text": "その辺は上級者として、\nリードしてあげないと\nダメよ。"},
        { "location": "197/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "199/TALK"    , "narrator": "アーヤ", "text": "…どうかした？"},
        { "location": "201/TALK"    , "narrator": "ガブリエラ", "text": "アーヤさ、最近少し、\n優しくなったよね？"},
        { "location": "202/TALK"    , "narrator": "アーヤ", "text": "え？"},
        { "location": "203/TALK"    , "narrator": "ガブリエラ", "text": "だって、前までなら\nこんな話したら絶対――"},
        { "location": "205/TALK"    , "narrator": "みやび", "text": "授業は授業なんだから、\n文句を言うんじゃない。"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "…くらいのことは、\n間違いなく言うてたね。"},
        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "うん、絶対言ってた！"},
        { "location": "211/TALK"    , "narrator": "アーヤ", "text": "そ、そうかしら？"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "…悪い物でも食べた？"},
        { "location": "215/TALK"    , "narrator": "アーヤ", "text": "うーん…食べてないと\n思うけど…。"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "ほら、今だって！"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと前までなら、\nそんな物食べないわよ\n失礼ね、とか言ってたし。"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "…ははぁん、なるほど。"},
        { "location": "221/TALK"    , "narrator": "みやび", "text": "これが俗に言う、\n大人の余裕ゆうやつやね。"},
        { "location": "223/TALK"    , "narrator": "アーヤ", "text": "何言ってるのよ。\nそんなに年が離れてる\nわけじゃないでしょ？"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "でも、最近のアーヤからは\nそういうの感じるかも。"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "ほらな。\nうちの勘違いやないやろ？"},
        { "location": "229/TALK"    , "narrator": "アーヤ", "text": "そ、そっか…。\n自覚がなかったから、\nちょっと驚いたわ。"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "…ヤバいかも。"},
        { "location": "232/TALK"    , "narrator": "アーヤ", "text": "…そろそろ劇場開ける\n時間だから、ロビーの方に\n行ってるわ。"},
        { "location": "245/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "246/TALK"    , "narrator": "アーヤ", "text": "…ふふっ。"},
        { "location": "260/SEL"     , "narrator": "", "text": "どうかしたの？"},
        { "location": "261/ACT"     , "narrator": "", "text": "どうかしたの？"},
        { "location": "263/TALK"    , "narrator": "アーヤ", "text": "$handle$さん"},
        { "location": "265/TALK"    , "narrator": "アーヤ", "text": "聞いて(*^^*)"},
        { "location": "266/TALK"    , "narrator": "アーヤ", "text": "私ね"},
        { "location": "267/TALK"    , "narrator": "アーヤ", "text": "大人の余裕があるって言われたの(=^0^=)"},
        { "location": "268/TALK"    , "narrator": "アーヤ", "text": "$handle$さんもそう思う？"},
        { "location": "270/SEL"     , "narrator": "", "text": "思うよ"},
        { "location": "271/SEL"     , "narrator": "", "text": "どこが？"},
        { "location": "272/SEL"     , "narrator": "", "text": "$me$の方が大人だよ"},
        { "location": "273/ACT"     , "narrator": "", "text": "思うよ"},
        { "location": "274/TALK"    , "narrator": "アーヤ", "text": "本当？(￣Д￣ )"},
        { "location": "275/TALK"    , "narrator": "アーヤ", "text": "私"},
        { "location": "276/TALK"    , "narrator": "アーヤ", "text": "$handle$さんの前では"},
        { "location": "277/TALK"    , "narrator": "アーヤ", "text": "結構子供っぽいと思うけど？"},
        { "location": "278/TALK"    , "narrator": "アーヤ", "text": "ちゃんと私のこと見て言ってる？( ・_・)σﾞ"},
        { "location": "280/SEL"     , "narrator": "", "text": "言ってるよ"},
        { "location": "281/ACT"     , "narrator": "", "text": "言ってるよ"},
        { "location": "283/TALK"    , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "284/TALK"    , "narrator": "アーヤ", "text": "だとしたら"},
        { "location": "285/TALK"    , "narrator": "アーヤ", "text": "もっとちゃんと見てもらわないといけないわね(*^.^*)"},
        { "location": "286/ACT"     , "narrator": "", "text": "どこが？"},
        { "location": "288/TALK"    , "narrator": "アーヤ", "text": "どこがって"},
        { "location": "289/TALK"    , "narrator": "アーヤ", "text": "全部よ、全部(>_<)"},
        { "location": "290/TALK"    , "narrator": "アーヤ", "text": "$handle$さんは少し鈍感なところあるから"},
        { "location": "292/TALK"    , "narrator": "アーヤ", "text": "気付かなかった？"},
        { "location": "293/ACT"     , "narrator": "", "text": "$me$の方が大人だよ"},
        { "location": "294/TALK"    , "narrator": "アーヤ", "text": "それ聞いて気が付いたわ"},
        { "location": "295/TALK"    , "narrator": "アーヤ", "text": "本当の大人は"},
        { "location": "296/TALK"    , "narrator": "アーヤ", "text": "自分から大人って言い出さない、って(-ω-;)"},
        { "location": "297/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "298/TALK"    , "narrator": "アーヤ", "text": "$handle$さんのそういう子供っぽいところ"},
        { "location": "299/TALK"    , "narrator": "アーヤ", "text": "嫌いじゃないけど(*^^*)"},
        { "location": "301/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "303/TALK"    , "narrator": "アーヤ", "text": "私が大人っぽいって言われたのって"},
        { "location": "304/TALK"    , "narrator": "アーヤ", "text": "きっと"},
        { "location": "305/TALK"    , "narrator": "アーヤ", "text": "ううん"},
        { "location": "306/TALK"    , "narrator": "アーヤ", "text": "絶対"},
        { "location": "307/TALK"    , "narrator": "アーヤ", "text": "$handle$さんのおかげだと思う(*^^*)"},
        { "location": "309/TALK"    , "narrator": "アーヤ", "text": "みんなに優しくできるのは"},
        { "location": "310/TALK"    , "narrator": "アーヤ", "text": "貴方がいてくれるだろうな、って"},
        { "location": "311/TALK"    , "narrator": "アーヤ", "text": "そう思うの(*^o^*)"},
        { "location": "313/SEL"     , "narrator": "", "text": "アーヤは初めから優しかった"},
        { "location": "314/ACT"     , "narrator": "", "text": "アーヤは初めから優しかった"},
        { "location": "317/TALK"    , "narrator": "アーヤ", "text": "それなら"},
        { "location": "318/TALK"    , "narrator": "アーヤ", "text": "もっともっと優しくなれるように頑張る(￣∇￣*)ゞ"},
        { "location": "319/TALK"    , "narrator": "アーヤ", "text": "だから"},
        { "location": "320/TALK"    , "narrator": "アーヤ", "text": "これからも一緒にいてね"},
        { "location": "332/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "334/TALK"    , "narrator": "アーヤ", "text": "っ～～～～～～～～～！！"},
        { "location": "335/TALK"    , "narrator": "アーヤ", "text": "最後のは、ちょっとだけ\nやり過ぎたかも…。"},
        { "location": "163/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　 5:12 PM</color>\nとある平日の放課後、神楽坂トライナリー楽屋でのこと"}
    ]
}
