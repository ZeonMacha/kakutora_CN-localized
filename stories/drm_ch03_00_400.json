        "title": "らぶとーく  第40話",
        "sub_title": "うさぎの心"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "うさぎの心"},
        { "location": "25/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "ヒカルくん、告白は\nもうしたのかしら？"},
        { "location": "27/TALK"   , "narrator": "ガブリエラ", "text": "あれっきり話してない\nからわからないけど…。"},
        { "location": "29/TALK"   , "narrator": "ガブリエラ", "text": "…って、バカバカしい。\nあたしが気にするような\nことじゃないわ。"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "34/TALK"   , "narrator": "雛", "text": "あららー、本当に\n元気ないねー？"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "っ！？\nひ、ひなこ！？"},
        { "location": "39/TALK"   , "narrator": "雛", "text": "はろー、\nガブリエラちゃん。"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "…何の用事？"},
        { "location": "43/TALK"   , "narrator": "雛", "text": "うん、つばめちゃんから\n聞いたんだけど――"},
        { "location": "44/TALK"   , "narrator": "雛", "text": "最近、なーんか元気が\nないみたいだね？"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "…え？"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "気付いてない、って\nことは――"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "ヒカルくん、\nまだ告白してない、\nってこと？"},
        { "location": "51/TALK"   , "narrator": "雛", "text": "ガブリエラちゃんが\n元気ないなんて、\nちょっと心配でさー。"},
        { "location": "52/TALK"   , "narrator": "雛", "text": "余計なお世話かなー、\nって思ったけど、\n来ちゃいましたー。"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "…な、何よ。\n余計なお世話とか、\n今更じゃない。"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "他人の恋愛話には\n進んで首を突っ込む\nくせに…。"},
        { "location": "58/TALK"   , "narrator": "雛", "text": "あー、それ言われると\n何も言えないなー…。"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "ま、まあ、せっかく\n余計なお世話をしようと\n思って来たなら――"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "一つ、相談したい\nことがあるんだけど…。"},
        { "location": "65/TALK"   , "narrator": "雛", "text": "おっ、珍しい！\nガブリエラちゃんから\nそんなこと言うなんて。"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "…嫌ならいいんだけど？"},
        { "location": "67/TALK"   , "narrator": "雛", "text": "まさか！　そのために\n来たんだから――"},
        { "location": "68/TALK"   , "narrator": "雛", "text": "どんな相談でも\n乗るから、どーんと\n相談しちゃってよ！"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "人の気も知らないで…。"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "…最初に、これだけは\nはっきりさせておく\nけど――"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "ヒカルくんのことじゃ\nないから。\nそれだけは忘れないで。"},
        { "location": "75/TALK"   , "narrator": "雛", "text": "う、うん…。\nそれで？"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "…ある人に、あたしの\n気持ちを伝えたい、って\n思ってるの。"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "けど…自分の気持ちを\n相手に伝えるのって――"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "どうすればいいか\nわからなくて…。"},
        { "location": "80/TALK"   , "narrator": "雛", "text": "ふむふむ、なるほど…。"},
        { "location": "81/TALK"   , "narrator": "雛", "text": "相手がヒカルくんじゃ\nないっていうのが、\n少し驚きだけど――"},
        { "location": "84/TALK"   , "narrator": "雛", "text": "まあ、それなら答えは\n簡単だと思うなー。"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "は？　簡単？"},
        { "location": "87/TALK"   , "narrator": "雛", "text": "うん。\n伝えたい気持ちが\nあるんでしょ？"},
        { "location": "88/TALK"   , "narrator": "雛", "text": "だったら、そのまま\n伝えるのが一番じゃん。"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "だから、それができない\nから相談してるんじゃ\nない！"},
        { "location": "90/TALK"   , "narrator": "雛", "text": "そうは言うけどさー。"},
        { "location": "91/TALK"   , "narrator": "雛", "text": "気持ちって、結局のとこ\n言葉にしないと伝え\nられないもんだよ？"},
        { "location": "92/TALK"   , "narrator": "雛", "text": "あ、手紙にしたりする\n方法もあるけど――"},
        { "location": "93/TALK"   , "narrator": "雛", "text": "どっちにしろ、\nそのまま伝える以外に\nないんじゃないかなー？"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "そ、それはまあ、\nそうなんだけど…。"},
        { "location": "97/TALK"   , "narrator": "雛", "text": "ふふーん、あたしの\n答えは完璧だわ！"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "いや、だからそれが\nできないから相談して\nるんじゃない…。"},
        { "location": "101/TALK"  , "narrator": "雛", "text": "あなたが好きです。\n付き合ってください。\nチューしてください。"},
        { "location": "103/TALK"  , "narrator": "雛", "text": "って言えば完璧！！"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "い、言えるわけ\nないでしょ！！"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、最後の\nチューって何！？"},
        { "location": "108/TALK"  , "narrator": "雛", "text": "キスとか口づけとか\n接吻とか…そういうの？"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "いや、だからそういう\nことじゃなくて…。"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…なんか本当、\nひなこと話してると\n調子狂うわ…。"},
        { "location": "112/SEL"   , "narrator": "", "text": "おーい"},
        { "location": "113/ACT"   , "narrator": "", "text": "おーい"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "まったく、\nうるさいわね…。"},
        { "location": "120/TALK"  , "narrator": "雛", "text": "おっ、ＷＡＶＥ？"},
        { "location": "121/TALK"  , "narrator": "雛", "text": "もしかしてもしかして、\nそれが例の気持ちを\n伝えたい相手？"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "124/TALK"  , "narrator": "雛", "text": "やっぱり！"},
        { "location": "125/TALK"  , "narrator": "雛", "text": "いいから、早く返事して\nあげなよ！"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "べ、別にいいわよ！\nそんな重要なことでも\nないだろうし…。"},
        { "location": "127/TALK"  , "narrator": "雛", "text": "重要じゃなくても\n出なきゃダメ！"},
        { "location": "128/TALK"  , "narrator": "雛", "text": "相談してきたのは\nガブリエラちゃん\nなんだから――"},
        { "location": "129/TALK"  , "narrator": "雛", "text": "アドバイスには\n従わないとダメですー！"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "…今、ひなこに\n相談したのをスゴく\n後悔してるわ…。"},
        { "location": "132/TALK"  , "narrator": "雛", "text": "後悔してももう遅いよ。\nほら、返信返信。"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "なんのよう？"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "今忙しいんだけど？"},
        { "location": "148/SEL"   , "narrator": "", "text": "じゃあまた後でね"},
        { "location": "149/SEL"   , "narrator": "", "text": "こっちの方が忙しいんだけど"},
        { "location": "150/SEL"   , "narrator": "", "text": "何か手伝えることある？"},
        { "location": "151/ACT"   , "narrator": "", "text": "じゃあまた後でね"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "ん"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "またやっちゃった…。"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "もっと、$handle$と\n話したいことあった\nのに…。"},
        { "location": "168/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "…おまたせ。\nなんでもなかった\nみたい。"},
        { "location": "171/TALK"  , "narrator": "雛", "text": "ブーッ！！\nブッブー！！"},
        { "location": "172/TALK"  , "narrator": "雛", "text": "ガブリエラちゃん！\n今の返信は不正解！！\nマイナス１００点！！"},
        { "location": "174/TALK"  , "narrator": "ガブリエラ", "text": "な、何がよ！？\n別に変なこと書いたり\nしてないでしょ！？"},
        { "location": "175/TALK"  , "narrator": "雛", "text": "変なことどころか、\n何も書いてないじゃん！"},
        { "location": "176/TALK"  , "narrator": "雛", "text": "もっと押してかないと\nダメなんだって！"},
        { "location": "177/TALK"  , "narrator": "雛", "text": "じゃあまた後でね、\nに対して、ん、って――"},
        { "location": "178/TALK"  , "narrator": "雛", "text": "そこで会話終了じゃん！\nもっと伸ばして！！\n話題を振らなきゃ！！"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "そ、それはあたしが\nするようなことじゃ\nないわ！"},
        { "location": "183/TALK"  , "narrator": "雛", "text": "それだよ、それ！！"},
        { "location": "184/TALK"  , "narrator": "雛", "text": "ガブリエラちゃんの\nいけないところは――"},
        { "location": "185/TALK"  , "narrator": "雛", "text": "待ってるだけで、\n自分からは行動しない\nところだよ。"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "190/TALK"  , "narrator": "雛", "text": "待ってるだけの\nお姫様やってると――"},
        { "location": "191/TALK"  , "narrator": "雛", "text": "気付いたら他の人に\n取られて、取り残され\nちゃうよ？"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "…今の、結構グサッと\nきたわ。"},
        { "location": "197/TALK"  , "narrator": "雛", "text": "厳しいアドバイスも\n時には辞さない\n恋愛キューピッド――"},
        { "location": "198/TALK"  , "narrator": "雛", "text": "それがあたしの\nやり方だからねー。"},
        { "location": "199/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "201/TALK"  , "narrator": "雛", "text": "っと、いけない！\nそろそろ休み時間\n終わっちゃう！"},
        { "location": "202/TALK"  , "narrator": "雛", "text": "じゃあ、\nまた放課後にねー。"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "…はぁ。"},
        { "location": "206/TALK"  , "narrator": "ガブリエラ", "text": "…認めたくないけど、\n結構参考になったかも。"},
        { "location": "207/ACT"   , "narrator": "", "text": "こっちの方が忙しいんだけど"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "は？"},
        { "location": "209/TALK"  , "narrator": "ガブリエラ", "text": "なにそれ？"},
        { "location": "210/TALK"  , "narrator": "ガブリエラ", "text": "だったら連絡してこなければいいじゃない！"},
        { "location": "221/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "222/TALK"  , "narrator": "ガブリエラ", "text": "またやっちゃった…。"},
        { "location": "223/TALK"  , "narrator": "ガブリエラ", "text": "もっと、$handle$と\n話したいことあった\nのに…。"},
        { "location": "225/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "…おまたせ。\nなんでもなかった\nみたい。"},
        { "location": "228/TALK"  , "narrator": "雛", "text": "ブーッ！！\nブッブー！！"},
        { "location": "229/TALK"  , "narrator": "雛", "text": "ガブリエラちゃん！\n今の返信は不正解！！\nマイナス１００点！！"},
        { "location": "230/TALK"  , "narrator": "ガブリエラ", "text": "な、何がよ！？\n別に変なこと書いたり\nしてないでしょ！？"},
        { "location": "231/TALK"  , "narrator": "雛", "text": "いや、キレてたじゃん！\nその時点でもうダメの\n極致だから！"},
        { "location": "232/TALK"  , "narrator": "雛", "text": "相手が忙しいって\n言うなら――"},
        { "location": "234/TALK"  , "narrator": "雛", "text": "まぁ！　忙しいのに\n私のことを想って\n連絡くれたのね――"},
        { "location": "235/TALK"  , "narrator": "雛", "text": "嬉しいっ！！"},
        { "location": "237/TALK"  , "narrator": "雛", "text": "って、言わなきゃ！"},
        { "location": "240/TALK"  , "narrator": "ガブリエラ", "text": "あたしがそんなこと\n言うわけないでしょ！？"},
        { "location": "241/TALK"  , "narrator": "雛", "text": "それでも言わなきゃ\nいけないの！"},
        { "location": "242/TALK"  , "narrator": "雛", "text": "何であれ、ガブリエラ\nちゃんのことを想って\nくれてるんだから――"},
        { "location": "243/TALK"  , "narrator": "雛", "text": "ガブリエラちゃんも\nそれに応えてあげな\nいと――"},
        { "location": "244/TALK"  , "narrator": "雛", "text": "気持ちも何も、\n相手に伝わらないよ？"},
        { "location": "246/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "248/TALK"  , "narrator": "雛", "text": "っと、いけない！\nそろそろ休み時間\n終わっちゃう！"},
        { "location": "250/TALK"  , "narrator": "雛", "text": "じゃあ、\nまた放課後にねー。"},
        { "location": "256/TALK"  , "narrator": "ガブリエラ", "text": "…はぁ。"},
        { "location": "257/TALK"  , "narrator": "ガブリエラ", "text": "…認めたくないけど、\n結構参考になったかも。"},
        { "location": "258/ACT"   , "narrator": "", "text": "何か手伝えることある？"},
        { "location": "259/TALK"  , "narrator": "ガブリエラ", "text": "別にないから黙ってて"},
        { "location": "270/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "271/TALK"  , "narrator": "ガブリエラ", "text": "またやっちゃった…。"},
        { "location": "272/TALK"  , "narrator": "ガブリエラ", "text": "もっと、$handle$と\n話したいことあった\nのに…。"},
        { "location": "274/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "276/TALK"  , "narrator": "ガブリエラ", "text": "…おまたせ。\nなんでもなかった\nみたい。"},
        { "location": "277/TALK"  , "narrator": "雛", "text": "ブーッ！！\nブッブー！！"},
        { "location": "278/TALK"  , "narrator": "雛", "text": "ガブリエラちゃん！\n今の返信は不正解！！\nマイナス１００点！！"},
        { "location": "279/TALK"  , "narrator": "ガブリエラ", "text": "な、何がよ！？\n別に変なこと書いたり\nして…。"},
        { "location": "282/TALK"  , "narrator": "ガブリエラ", "text": "…ま、まあ、さすがに\nちょっとそっけなかった\nかもしれないけど…。"},
        { "location": "283/TALK"  , "narrator": "雛", "text": "そうじゃなくて！"},
        { "location": "284/TALK"  , "narrator": "雛", "text": "何か手伝えることある、\nって聞いてきたって\nことは――"},
        { "location": "285/TALK"  , "narrator": "雛", "text": "ガブリエラちゃんの\n力になりたい、って\nことだよ？"},
        { "location": "286/TALK"  , "narrator": "雛", "text": "別にないけど、\nその気持ちが嬉しい！"},
        { "location": "287/TALK"  , "narrator": "雛", "text": "って言わなきゃ！"},
        { "location": "290/TALK"  , "narrator": "ガブリエラ", "text": "ど、どうしてそこまで\n言わなきゃいけない\nのよ！？"},
        { "location": "291/TALK"  , "narrator": "雛", "text": "何か手伝うことない、\nって聞かれて、\n少しも嬉しくなかった？"},
        { "location": "294/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "295/TALK"  , "narrator": "雛", "text": "ほらね？"},
        { "location": "296/TALK"  , "narrator": "雛", "text": "気持ちを伝えたいなら、\n自分の気持ちに正直に\nならないと――"},
        { "location": "297/TALK"  , "narrator": "雛", "text": "いつまで経っても\n伝えられないよ？"},
        { "location": "299/TALK"  , "narrator": "雛", "text": "っと、いけない！\nそろそろ休み時間\n終わっちゃう！"},
        { "location": "301/TALK"  , "narrator": "雛", "text": "じゃあ、\nまた放課後にねー。"},
        { "location": "305/TALK"  , "narrator": "ガブリエラ", "text": "…はぁ。"},
        { "location": "306/TALK"  , "narrator": "ガブリエラ", "text": "…認めたくないけど、\n結構参考になったかも。"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　 0:21 PM</color>\nとある平日の昼休み、ガブリエラの教室にて"}
    ]
}
