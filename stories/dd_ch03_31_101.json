        "title": "002 メインストーリー",
        "sub_title": "兎穴の入り口で＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "兎穴の入り口で"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "さすがやねアーヤ。"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "あっさり音羽の\nココロデータ座標を\n手に入れるとは。"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "これとエリカさんの\nデータを突き合わせて\n解析する。"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "そうしたら壊れとる\n場所を特定して\n修復できるき。"},
        { "location": "36/TALK"   , "narrator": "真幌", "text": "…特定までどのくらい\nかかる見込みだ？"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "…ここのマシンの\n解析速度に\nよりますき。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "けんどそうは\nかかりません。"},
        { "location": "39/TALK"   , "narrator": "真幌", "text": "そうか。頼んだぞ。"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "エヴェレット脳科学研究所\nJapanSite…だっけ。\nこの施設。"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "松代にある\nアーヤのお姉さんの\n研究所。"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "ここに来た理由はひとつ。"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "アーヤが\n音羽の精神世界に\nダイブするため。"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "そして音羽を\n治すための情報を\n取り出すため。"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "その情報は\nみやびに渡った。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "アーヤがダイブする\n理由はもう\nなくなったはず。"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "なのにアーヤは\n目を覚まさない…。"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "ねえ$handle$"},
        { "location": "67/SEL"    , "narrator": "", "text": "相談ならいつでも聞くよ"},
        { "location": "68/SEL"    , "narrator": "", "text": "$me$だよ"},
        { "location": "69/SEL"    , "narrator": "", "text": "退屈なの？"},
        { "location": "70/ACT"    , "narrator": "", "text": "相談ならいつでも聞くよ"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "72/ACT"    , "narrator": "", "text": "$me$だよ"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "74/ACT"    , "narrator": "", "text": "退屈なの？"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "違うわよ"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "アーヤが変な機械で"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "眠ったまんま"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "目を覚まさないの"},
        { "location": "83/SEL"    , "narrator": "", "text": "変な機械ｗ"},
        { "location": "84/SEL"    , "narrator": "", "text": "そうみたいだね"},
        { "location": "85/ACT"    , "narrator": "", "text": "変な機械ｗ"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "何よ"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "そうじゃないの"},
        { "location": "88/ACT"    , "narrator": "", "text": "そうみたいだね"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよ"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "用事は済んだはずなのに"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "大丈夫かしら・・・"},
        { "location": "95/SEL"    , "narrator": "", "text": "迎えに行けば"},
        { "location": "96/SEL"    , "narrator": "", "text": "様子を見に行けば"},
        { "location": "97/SEL"    , "narrator": "", "text": "みやびにどうにかしてもらえ"},
        { "location": "98/ACT"    , "narrator": "", "text": "迎えに行けば"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "迎えに？"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "そんなことできるの？"},
        { "location": "101/ACT"   , "narrator": "", "text": "様子を見に行けば"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "え"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "どうやってよ"},
        { "location": "104/ACT"   , "narrator": "", "text": "みやびにどうにかしてもらえ"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "さすがのみやびにも"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "できないんじゃないかしら"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "……んー……。"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "ねえみやび。"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "どういた？"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "ダイブっていうのは\nやっぱりアーヤにしか\nできないの？"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "…どうなんですか\nまほさん。"},
        { "location": "128/TALK"  , "narrator": "真幌", "text": "…アーヤにしか\nできないのは\nサイクロトロンの起動。"},
        { "location": "129/TALK"  , "narrator": "真幌", "text": "サイクロトロンは\n今、正常に作動を\nしている。"},
        { "location": "130/TALK"  , "narrator": "真幌", "text": "だからダイブは\n誰でも可能だ。"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "…そうなのね。"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "じゃあ。\nあたしがダイブするのも\n可能ってことよね。"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "え？"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとアーヤを\n迎えに行こうと\n思うの。"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "…そんなことせんでも\nすぐに帰ってくるき。"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "ここでおとなしく\n待ちより。"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "アーヤの用事は\n済んだんじゃないの？"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "なのに目を覚まさない。\n迷ったりしてるんじゃ\nないの？"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "…最終的にこちらに\n戻って来れれば\nええだけぞね。"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "まだ内部を\n覗けるようには\nなっとらんき。"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "アーヤとガブちゃん\n二人をダイブさせる\nわけにはいかん。"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "やき、ガブちゃんは\nここで待っとき。"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "ガブちゃんが行く\nことはないぞね。"},
        { "location": "148/TALK"  , "narrator": "ガブリエラ", "text": "みやび！"},
        { "location": "149/SEL"   , "narrator": "", "text": "ピンチだね"},
        { "location": "150/ACT"   , "narrator": "", "text": "ピンチだね"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "みやびったら"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "ひどくない？"},
        { "location": "172/SEL"   , "narrator": "", "text": "真幌を味方につけろ"},
        { "location": "173/SEL"   , "narrator": "", "text": "アーヤと約束したと言え"},
        { "location": "174/SEL"   , "narrator": "", "text": "みやびは心配し過ぎとたきつけろ"},
        { "location": "175/ACT"   , "narrator": "", "text": "真幌を味方につけろ"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "それはいいわね"},
        { "location": "189/TALK"  , "narrator": "ガブリエラ", "text": "まほもアーヤが\n早く帰ってくる方が\nいいでしょう？"},
        { "location": "190/TALK"  , "narrator": "真幌", "text": "ああ。"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "だったらあたしを\nダイブさせた方が\nいいんじゃない？"},
        { "location": "192/TALK"  , "narrator": "真幌", "text": "そうだな。"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "まほさん！"},
        { "location": "194/ACT"   , "narrator": "", "text": "アーヤと約束したと言え"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "それなら"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "断れないわよね"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "あのね、みやび。"},
        { "location": "209/TALK"  , "narrator": "みやび", "text": "何ぞね。"},
        { "location": "210/TALK"  , "narrator": "ガブリエラ", "text": "アーヤと約束したの。\n遅い時は迎えに\n行くわねって。"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "だからあたしを\nダイブさせて。"},
        { "location": "212/ACT"   , "narrator": "", "text": "みやびは心配し過ぎとたきつけろ"},
        { "location": "213/TALK"  , "narrator": "ガブリエラ", "text": "そう言われると"},
        { "location": "214/TALK"  , "narrator": "ガブリエラ", "text": "引っ込みがつかなくなるかもね"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "みやびはあたしを\n心配しすぎ\nなんじゃない？"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "効率を考えたら\nあたしに行かせた方が\n早いと思うのよ。"},
        { "location": "228/TALK"  , "narrator": "みやび", "text": "…そうかも\nしれんけんど…。"},
        { "location": "230/TALK"  , "narrator": "真幌", "text": "…行かせてやれ。"},
        { "location": "231/TALK"  , "narrator": "ガブリエラ", "text": "ほら、まほだって\nそう言ってる。"},
        { "location": "232/TALK"  , "narrator": "真幌", "text": "時間がないんだ。"},
        { "location": "235/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "236/TALK"  , "narrator": "真幌", "text": "本当はわかって\nいるんだろう？"},
        { "location": "237/TALK"  , "narrator": "みやび", "text": "……。\nガブちゃん、\nトライコネクトするぞね。"},
        { "location": "238/TALK"  , "narrator": "ガブリエラ", "text": "みやび…！"},
        { "location": "239/TALK"  , "narrator": "みやび", "text": "まほさんは二台分\n生体モニターを\nお願いします。"},
        { "location": "240/TALK"  , "narrator": "みやび", "text": "うちは解析と同時に\n内部をモニターする\n方法を探ります。"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "ちゃんと帰って\n来るからね！"},
        { "location": "242/TALK"  , "narrator": "みやび", "text": "…当たり前ぞね。"},
        { "location": "244/TALK"  , "narrator": "ガブリエラ", "text": "もちろんよ！"},
        { "location": "245/TALK"  , "narrator": "みやび", "text": "ほら。\n準備できたら\n目を閉じる。"},
        { "location": "246/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "286/TALK"  , "narrator": "ガブリエラの元司書", "text": "待ってたわよ。"},
        { "location": "287/TALK"  , "narrator": "ガブリエラの元司書", "text": "今回こそ、リヴォルカの\n防衛を突破して、マークス\nマンまで辿り着くわよ！"},
        { "location": "288/SEL"   , "narrator": "", "text": "準備は大丈夫？"},
        { "location": "289/SEL"   , "narrator": "", "text": "ブヒィィィィ！！"},
        { "location": "290/ACT"   , "narrator": "", "text": "準備は大丈夫？"},
        { "location": "291/TALK"  , "narrator": "ガブリエラの元司書", "text": "もちろんよ。"},
        { "location": "292/ACT"   , "narrator": "", "text": "ブヒィィィィ！！"},
        { "location": "293/TALK"  , "narrator": "ガブリエラの元司書", "text": "まだいいから！"},
        { "location": "295/TALK"  , "narrator": "ガブリエラの元司書", "text": "それじゃ早速、\n作戦の説明をするわね。"},
        { "location": "296/TALK"  , "narrator": "ガブリエラの元司書", "text": "あたしがいつものように\n1xへの転送経路を作る。"},
        { "location": "297/TALK"  , "narrator": "ガブリエラの元司書", "text": "そして、あんただけ\nそれに乗って\n1xへ向かうの。"},
        { "location": "298/TALK"  , "narrator": "ガブリエラの元司書", "text": "あたしは別の1xアドレスに\n自分を転送させる。"},
        { "location": "299/TALK"  , "narrator": "ガブリエラの元司書", "text": "あんたが何をするか\n分からないけど、派手に\nやらかしてる間に――"},
        { "location": "300/TALK"  , "narrator": "ガブリエラの元司書", "text": "あたしがマークスマンの\nところまで到達して、\n状況を探ることにするわ。"},
        { "location": "301/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "302/SEL"   , "narrator": "", "text": "危険な事はしないでね？"},
        { "location": "303/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "304/TALK"  , "narrator": "ガブリエラの元司書", "text": "それじゃ、行くわよ。"},
        { "location": "305/ACT"   , "narrator": "", "text": "危険な事はしないでね？"},
        { "location": "307/TALK"  , "narrator": "ガブリエラの元司書", "text": "大丈夫よ。\n今回は、状況を確認する\nだけのつもりだから。"},
        { "location": "308/TALK"  , "narrator": "ガブリエラの元司書", "text": "でも、\n心配してくれてありがと。\n好きよ？"},
        { "location": "309/TALK"  , "narrator": "ガブリエラの元司書", "text": "それじゃ、行くわね。"},
        { "location": "311/TALK"  , "narrator": "ガブリエラの元司書", "text": "オープンプロセス、\n0xCCE番地から\nC3:4:153//1x0FF番地へ。"},
        { "location": "316/TALK"  , "narrator": "ガブリエラの元司書", "text": "スピードアップ。"},
        { "location": "320/TALK"  , "narrator": "ガブリエラの元司書", "text": "更に加速。"},
        { "location": "322/TALK"  , "narrator": "ガブリエラの元司書", "text": "それじゃ、\n宜しくお願いね。"},
        { "location": "324/TALK"  , "narrator": "ガブリエラの元司書", "text": "あたしの\n大切な人――"},
        { "location": "344/TALK"  , "narrator": "リヴォルカ", "text": "あら、誰かと思えば\n豚じゃない。"},
        { "location": "345/TALK"  , "narrator": "リヴォルカ", "text": "ここには豚は\n入って来れないの。\n知ってた？"},
        { "location": "346/SEL"   , "narrator": "", "text": "豚じゃないから入れるよね"},
        { "location": "347/SEL"   , "narrator": "", "text": "ブヒィィィィ！！（抱きつく）"},
        { "location": "348/ACT"   , "narrator": "", "text": "豚じゃないから入れるよね"},
        { "location": "349/TALK"  , "narrator": "リヴォルカ", "text": "あら失礼、\nごめんなさいね。"},
        { "location": "350/TALK"  , "narrator": "リヴォルカ", "text": "それじゃ、\nネズミかしら？\nそれともゴキブリ？"},
        { "location": "351/SEL"   , "narrator": "", "text": "いい加減にしませんか？"},
        { "location": "352/SEL"   , "narrator": "", "text": "ネズミで！"},
        { "location": "353/SEL"   , "narrator": "", "text": "ゴキブリで！"},
        { "location": "354/ACT"   , "narrator": "", "text": "いい加減にしませんか？"},
        { "location": "355/TALK"  , "narrator": "リヴォルカ", "text": "いい加減にして欲しいのは\nあたしの方。"},
        { "location": "356/TALK"  , "narrator": "リヴォルカ", "text": "勝手に人の心の奥底に\nズケズケと\n入り込んできて。"},
        { "location": "357/TALK"  , "narrator": "リヴォルカ", "text": "まあもちろん、\nそれを良しとする人格も\nいるはいるけど？"},
        { "location": "358/TALK"  , "narrator": "リヴォルカ", "text": "少なくともあたしはダメ。\n半径３ｍ以内には\n絶対近寄らないでよね。"},
        { "location": "359/ACT"   , "narrator": "", "text": "ネズミで！"},
        { "location": "360/TALK"  , "narrator": "リヴォルカ", "text": "うわ、マジで？\n自分からネズミ宣言する\nとか、どんだけ変態なの？"},
        { "location": "361/TALK"  , "narrator": "リヴォルカ", "text": "余計汚らわしいから\n半径１０ｍ以内に\n近づかないで！"},
        { "location": "362/ACT"   , "narrator": "", "text": "ゴキブリで！"},
        { "location": "363/TALK"  , "narrator": "リヴォルカ", "text": "うわぁぁっ！\n自分でゴキブリとか\n言っちゃう系？"},
        { "location": "364/TALK"  , "narrator": "リヴォルカ", "text": "信じられない。\nこっちに寄らないで！"},
        { "location": "366/SEL"   , "narrator": "", "text": "近づかなければ話してもいい？"},
        { "location": "367/ACT"   , "narrator": "", "text": "近づかなければ話してもいい？"},
        { "location": "369/TALK"  , "narrator": "リヴォルカ", "text": "ツバが飛ぶでしょ？\nその事も考えてよね。"},
        { "location": "370/SEL"   , "narrator": "", "text": "いや、OS越しなので…"},
        { "location": "371/ACT"   , "narrator": "", "text": "いや、OS越しなので…"},
        { "location": "373/TALK"  , "narrator": "リヴォルカ", "text": "あっ――"},
        { "location": "375/TALK"  , "narrator": "リヴォルカ", "text": "……っと！\nそ、そういうイメージが\nするだけで大迷惑なの！"},
        { "location": "376/SEL"   , "narrator": "", "text": "本当にガブリエラの人格？"},
        { "location": "377/ACT"   , "narrator": "", "text": "本当にガブリエラの人格？"},
        { "location": "380/TALK"  , "narrator": "リヴォルカ", "text": "あんた、悪いけど\nあたしって存在を\nなめすぎよ？"},
        { "location": "381/TALK"  , "narrator": "リヴォルカ", "text": "普段みんなと\n普通に話してるように\n見えるかもしれないけど―"},
        { "location": "382/TALK"  , "narrator": "リヴォルカ", "text": "正確には\n「話してやってる」\nだから。"},
        { "location": "384/SEL"   , "narrator": "", "text": "恋人の$me$でも？"},
        { "location": "385/ACT"   , "narrator": "", "text": "恋人の$me$でも？"},
        { "location": "388/TALK"  , "narrator": "リヴォルカ", "text": "も…もちろんよ。"},
        { "location": "389/TALK"  , "narrator": "リヴォルカ", "text": "本当は、あんたじゃ\nなくても良かったのよ？"},
        { "location": "390/TALK"  , "narrator": "リヴォルカ", "text": "仕方なく恋人になって\nあげたの。そこのところ\n勘違いしないでよね！"},
        { "location": "391/SEL"   , "narrator": "", "text": "なってくれてありがとう"},
        { "location": "392/SEL"   , "narrator": "", "text": "なら別れてもいいんだけど"},
        { "location": "393/ACT"   , "narrator": "", "text": "なってくれてありがとう"},
        { "location": "394/TALK"  , "narrator": "リヴォルカ", "text": "…！？"},
        { "location": "395/TALK"  , "narrator": "リヴォルカ", "text": "なっ……なんでお礼を\n言われなくちゃ\nならないわけ？"},
        { "location": "396/TALK"  , "narrator": "リヴォルカ", "text": "これはあたしが\n自分で決めた行為なの。\nその――"},
        { "location": "397/TALK"  , "narrator": "リヴォルカ", "text": "<size=16>恋人？</size>"},
        { "location": "398/TALK"  , "narrator": "リヴォルカ", "text": "になったのだって、\nこれっぽっちも、あんたの\n為なんかじゃないのよ？"},
        { "location": "400/TALK"  , "narrator": "リヴォルカ", "text": "そんなことすら\n判らないなんて、\n本当に頭悪いのね。"},
        { "location": "401/ACT"   , "narrator": "", "text": "なら別れてもいいんだけど"},
        { "location": "402/TALK"  , "narrator": "リヴォルカ", "text": "なっ……！？\n何を突然\n言い出すのかしら！"},
        { "location": "404/TALK"  , "narrator": "リヴォルカ", "text": "ふざけないで。\nあんたにあたしを指図\n出来ると思って！？"},
        { "location": "405/SEL"   , "narrator": "", "text": "指図なんてしてませんが…"},
        { "location": "406/ACT"   , "narrator": "", "text": "指図なんてしてませんが…"},
        { "location": "408/TALK"  , "narrator": "リヴォルカ", "text": "はぁ……\n本当に頭悪いわね！"},
        { "location": "410/TALK"  , "narrator": "リヴォルカ", "text": "あんたとあたしが\nその……"},
        { "location": "411/TALK"  , "narrator": "リヴォルカ", "text": "<size=16>恋人？</size>"},
        { "location": "412/TALK"  , "narrator": "リヴォルカ", "text": "になっちゃったのは、\nあたしが自己の責任に\nおいて決めたことなの。"},
        { "location": "413/TALK"  , "narrator": "リヴォルカ", "text": "別れるかどうかだって、\nあたしが自己の責任に\nおいて決めるわ。"},
        { "location": "414/TALK"  , "narrator": "リヴォルカ", "text": "そして、あんたにそんな\n高尚な権限は無いのよ！\nわかるかしら！？"},
        { "location": "415/SEL"   , "narrator": "", "text": "まあ、そういうことにしておこう"},
        { "location": "416/SEL"   , "narrator": "", "text": "かわいい！！"},
        { "location": "417/ACT"   , "narrator": "", "text": "まあ、そういうことにしておこう"},
        { "location": "418/TALK"  , "narrator": "リヴォルカ", "text": "ふん。本当に、\n上から目線でしか物言い\nできないのね。"},
        { "location": "419/TALK"  , "narrator": "リヴォルカ", "text": "立場の違い、\n判ってるのかしら？"},
        { "location": "421/ACT"   , "narrator": "", "text": "かわいい！！"},
        { "location": "424/TALK"  , "narrator": "リヴォルカ", "text": "うわっ、キモっ！！"},
        { "location": "425/TALK"  , "narrator": "リヴォルカ", "text": "こんなにコケ下ろされて\n可愛いとか、ちょっと\nおかしいんじゃない？"},
        { "location": "426/TALK"  , "narrator": "リヴォルカ", "text": "まあ、もう\n末期症状でしょうし、\n言っても無駄よね……。"},
        { "location": "430/TALK"  , "narrator": "リヴォルカ", "text": "いいこと？\nあたしは\nエリートなのよ。"},
        { "location": "431/TALK"  , "narrator": "リヴォルカ", "text": "ここが日本でなければ\n飛び級だって余裕だし、\n様々なスキルもある。"},
        { "location": "432/TALK"  , "narrator": "リヴォルカ", "text": "それに、父は政府高官と\n繋がりを持つ\n軍部のトップだし。"},
        { "location": "433/TALK"  , "narrator": "リヴォルカ", "text": "庶民とは\n住んでる世界が違うのよ。"},
        { "location": "434/TALK"  , "narrator": "リヴォルカ", "text": "そんなあたしが、みんなや\nあんたと普通に話してる\n事に感謝して欲しいわね。"},
        { "location": "435/SEL"   , "narrator": "", "text": "では、話させて頂いてもよいですか？"},
        { "location": "436/ACT"   , "narrator": "", "text": "では、話させて頂いてもよいですか？"},
        { "location": "438/TALK"  , "narrator": "リヴォルカ", "text": "特別に許すわ。\nただし２０文字以内で。"},
        { "location": "439/SEL"   , "narrator": "", "text": "マークスマンを進化させてるのは君？"},
        { "location": "440/SEL"   , "narrator": "", "text": "マークスマンが進化するとどうなる？"},
        { "location": "441/SEL"   , "narrator": "", "text": "リヴォルカたんはどうしてそんなに$me$にご褒美をくれるんですか？"},
        { "location": "442/ACT"   , "narrator": "", "text": "マークスマンを進化させてるのは君？"},
        { "location": "443/TALK"  , "narrator": "リヴォルカ", "text": "ええ、そうよ。\n進化の種を使ってね。"},
        { "location": "444/TALK"  , "narrator": "リヴォルカ", "text": "あたしのような\nエリートには、\n常に進化が必要なのよ。"},
        { "location": "445/SEL"   , "narrator": "", "text": "もしかして、千羽鶴が進化しろって言ったの？"},
        { "location": "446/ACT"   , "narrator": "", "text": "もしかして、千羽鶴が進化しろって言ったの？"},
        { "location": "448/TALK"  , "narrator": "リヴォルカ", "text": "あら、よく知ってるわね。"},
        { "location": "449/TALK"  , "narrator": "リヴォルカ", "text": "まあ、進化の準備を\n開始したのは、\nもうかなり前だけど。"},
        { "location": "450/TALK"  , "narrator": "リヴォルカ", "text": "ま、そんなところかしら。"},
        { "location": "451/ACT"   , "narrator": "", "text": "マークスマンが進化するとどうなる？"},
        { "location": "452/TALK"  , "narrator": "リヴォルカ", "text": "より超的な力を\n使う事ができるように\nなるのよ。"},
        { "location": "453/TALK"  , "narrator": "リヴォルカ", "text": "そうなれば、あんたなんて\n本気で豚以下の存在として\n扱われるわね。"},
        { "location": "454/ACT"   , "narrator": "", "text": "リヴォルカたんはどうしてそんなに$me$にご褒美をくれるんですか？"},
        { "location": "456/TALK"  , "narrator": "リヴォルカ", "text": "……えっと。\n何言ってるのか\n全然わからないんだけど。"},
        { "location": "457/TALK"  , "narrator": "リヴォルカ", "text": "まあ、豚の言う事だし\n理解出来なくて当然よね。"},
        { "location": "458/SEL"   , "narrator": "", "text": "ブヒィィィィ！！"},
        { "location": "459/ACT"   , "narrator": "", "text": "ブヒィィィィ！！"},
        { "location": "461/TALK"  , "narrator": "リヴォルカ", "text": "きゃああっ！"},
        { "location": "462/TALK"  , "narrator": "リヴォルカ", "text": "キモイから寄らないで！"},
        { "location": "464/ACT"   , "narrator": "", "text": "ブヒィィィィ！！（抱きつく）"},
        { "location": "468/TALK"  , "narrator": "リヴォルカ", "text": "きゃああああっ！！\n近寄らないで！！"},
        { "location": "473/TALK"  , "narrator": "リヴォルカ", "text": "はぁ…はぁ…　…"},
        { "location": "474/SEL"   , "narrator": "", "text": "おもったよりやわらかかったです"},
        { "location": "475/SEL"   , "narrator": "", "text": "ブヒィィィィ！！（抱きつく）"},
        { "location": "476/ACT"   , "narrator": "", "text": "おもったよりやわらかかったです"},
        { "location": "478/TALK"  , "narrator": "リヴォルカ", "text": "なっ――！！"},
        { "location": "479/TALK"  , "narrator": "リヴォルカ", "text": "こっ…こぉのぉぉぉ！！！"},
        { "location": "482/TALK"  , "narrator": "リヴォルカ", "text": "豚！！"},
        { "location": "485/TALK"  , "narrator": "リヴォルカ", "text": "<size=40>ゴミ！！！</size>"},
        { "location": "488/TALK"  , "narrator": "リヴォルカ", "text": "<size=50>ゴキブリ以下！！</size>"},
        { "location": "490/TALK"  , "narrator": "リヴォルカ", "text": "はぁ…はぁ…　…"},
        { "location": "491/SEL"   , "narrator": "", "text": "ありがとうございます！\nありがとうございます！"},
        { "location": "492/ACT"   , "narrator": "", "text": "ありがとうございます！\nありがとうございます！"},
        { "location": "494/TALK"  , "narrator": "リヴォルカ", "text": "……。"},
        { "location": "495/TALK"  , "narrator": "リヴォルカ", "text": "もういい。"},
        { "location": "496/TALK"  , "narrator": "リヴォルカ", "text": "あんたのこと、\n本気で軽蔑するわ。"},
        { "location": "497/ACT"   , "narrator": "", "text": "ブヒィィィィ！！（抱きつく）"},
        { "location": "508/TALK"  , "narrator": "リヴォルカ", "text": "な、なに！？\n今のは！"},
        { "location": "509/TALK"  , "narrator": "リヴォルカ", "text": "マークスマンの\n方からだわね……！"},
        { "location": "510/TALK"  , "narrator": "リヴォルカ", "text": "こんな豚に\n関わっていたせいで何か\n起きてたら、大失態だわ…"},
        { "location": "511/TALK"  , "narrator": "リヴォルカ", "text": "そんときは\n覚えてなさいよね！"},
        { "location": "535/TALK"  , "narrator": "ガブリエラの元司書　", "text": "落ち着いて！\n落ち着いてマークスマン！"},
        { "location": "536/TALK"  , "narrator": "マークスマン", "text": "私は今、進化のための\n眠りに就いていた。"},
        { "location": "537/TALK"  , "narrator": "マークスマン", "text": "それを起こせば\n気分も良くは\n無いでしょう？"},
        { "location": "539/TALK"  , "narrator": "リヴォルカ", "text": "ちょ、ちょっとあんた！\nなにやってるのよ！！"},
        { "location": "540/TALK"  , "narrator": "ガブリエラの元司書　", "text": "う、うるさいわね！\nだいたい、それは\nこっちのセリフだわよ！"},
        { "location": "541/TALK"  , "narrator": "ガブリエラの元司書　", "text": "あんた、マークスマンに\n何かしたでしょ！！"},
        { "location": "542/TALK"  , "narrator": "リヴォルカ", "text": "ええ、もちろん。\nあたしたちがもっと\n成長するためにね。"},
        { "location": "543/TALK"  , "narrator": "マークスマン", "text": "少し静かに\nしてくれないか？"},
        { "location": "544/TALK"  , "narrator": "マークスマン", "text": "今起こさずとも、\n私はもうすぐに覚醒する。"},
        { "location": "545/TALK"  , "narrator": "マークスマン", "text": "それまで眠らせて\nもらえないだろうか。"},
        { "location": "546/TALK"  , "narrator": "マークスマン", "text": "なあ、マルザンナよ。"},
        { "location": "547/SEL"   , "narrator": "", "text": "え？$me$？？"},
        { "location": "548/ACT"   , "narrator": "", "text": "え？$me$？？"},
        { "location": "549/TALK"  , "narrator": "ガブリエラの元司書　", "text": "…！！"},
        { "location": "551/TALK"  , "narrator": "リヴォルカ", "text": "……あんた。"},
        { "location": "552/TALK"  , "narrator": "ガブリエラの元司書　", "text": "……何よ。"},
        { "location": "553/TALK"  , "narrator": "リヴォルカ", "text": "もしかして、\nまだ言ってなかったの？"},
        { "location": "554/TALK"  , "narrator": "ガブリエラの元司書　", "text": "…べっ、\n別にいいじゃない！\nそんなの勝手でしょ！！"},
        { "location": "555/SEL"   , "narrator": "", "text": "え！？マルザンナってもしかして……"},
        { "location": "556/ACT"   , "narrator": "", "text": "え！？マルザンナってもしかして……"},
        { "location": "560/TALK"  , "narrator": "ガブリエラの元司書　", "text": "……そうよ。"},
        { "location": "561/TALK"  , "narrator": "マルザンナ　", "text": "あたしの名前は\nマルザンナ。"},
        { "location": "562/TALK"  , "narrator": "リヴォルカ", "text": "はぁ。呆れた。"},
        { "location": "563/TALK"  , "narrator": "リヴォルカ", "text": "あんた、あんだけ\nこの豚のこと好き好き\nラブラブ言っておいて――"},
        { "location": "564/TALK"  , "narrator": "リヴォルカ", "text": "名前教えて\nなかったってわけ！？\n意味分かんないんだけど！"},
        { "location": "566/TALK"  , "narrator": "マルザンナ　", "text": "あんたには\n関係無い！！"},
        { "location": "567/SEL"   , "narrator": "", "text": "いいよ、別に気にしてないし"},
        { "location": "568/SEL"   , "narrator": "", "text": "なんで教えてくれなかったの？"},
        { "location": "569/ACT"   , "narrator": "", "text": "いいよ、別に気にしてないし"},
        { "location": "571/TALK"  , "narrator": "マルザンナ　", "text": "…ありがと。"},
        { "location": "572/TALK"  , "narrator": "マルザンナ　", "text": "それと、ごめんね…\n今まで言えなくて……。"},
        { "location": "573/ACT"   , "narrator": "", "text": "なんで教えてくれなかったの？"},
        { "location": "576/TALK"  , "narrator": "マルザンナ　", "text": "え！？"},
        { "location": "577/TALK"  , "narrator": "マルザンナ　", "text": "えっと…それは……\n大した理由じゃないのよ？"},
        { "location": "578/TALK"  , "narrator": "マルザンナ　", "text": "あんたもマルザンナって\n呼ばれてたでしょ？"},
        { "location": "579/TALK"  , "narrator": "マルザンナ　", "text": "だから、その……\nなんか恥ずかしくて…"},
        { "location": "580/TALK"  , "narrator": "マルザンナ　", "text": "まるで、あたしがあんたの\nことを好きで、同じ名前\n名乗ってるみたいじゃん？"},
        { "location": "582/SEL"   , "narrator": "", "text": "同じ名前の方がおそろいで嬉しい"},
        { "location": "583/SEL"   , "narrator": "", "text": "マルザンナかわいい！"},
        { "location": "584/ACT"   , "narrator": "", "text": "同じ名前の方がおそろいで嬉しい"},
        { "location": "585/TALK"  , "narrator": "マルザンナ　", "text": "ええっ……\nそ、そうなの？"},
        { "location": "586/TALK"  , "narrator": "マルザンナ　", "text": "…ちょっと嬉しいかも。"},
        { "location": "587/ACT"   , "narrator": "", "text": "マルザンナかわいい！"},
        { "location": "588/TALK"  , "narrator": "マルザンナ　", "text": "え、ええっ？"},
        { "location": "589/TALK"  , "narrator": "マルザンナ　", "text": "やだ、こんなところで、\n恥ずかしいでしょ？"},
        { "location": "591/TALK"  , "narrator": "リヴォルカ", "text": "おいおいおい、\nちょっとあんたら。"},
        { "location": "592/TALK"  , "narrator": "リヴォルカ", "text": "マークスマンの前で\n遠慮なくいちゃつくの\nやめてくれない？"},
        { "location": "593/TALK"  , "narrator": "リヴォルカ", "text": "そういうのは\n豚舎でやって頂戴。"},
        { "location": "596/TALK"  , "narrator": "マルザンナ　", "text": "べっ！\n別にいちゃついてないし！"},
        { "location": "597/TALK"  , "narrator": "マルザンナ　", "text": "それより話を戻すけど！"},
        { "location": "598/TALK"  , "narrator": "マルザンナ　", "text": "マークスマン、\nこのままだと\n発症するんじゃないの！？"},
        { "location": "599/TALK"  , "narrator": "リヴォルカ", "text": "そうね。\nでも発症は決して\n悪いことじゃない。"},
        { "location": "600/TALK"  , "narrator": "リヴォルカ", "text": "劇的な成長を遂げる為に\n必要不可欠な事よ？"},
        { "location": "601/TALK"  , "narrator": "マルザンナ　", "text": "デタラメ言わないで！\n絶対に阻止するわ。"},
        { "location": "602/TALK"  , "narrator": "リヴォルカ", "text": "無理よ。\nマークスマンとあたしには\n敵うわけがない。"},
        { "location": "603/TALK"  , "narrator": "マルザンナ　", "text": "敵うわよ。"},
        { "location": "604/TALK"  , "narrator": "リヴォルカ", "text": "…ん？"},
        { "location": "605/TALK"  , "narrator": "マルザンナ　", "text": "$handle$、\nお願いがあるの。"},
        { "location": "606/SEL"   , "narrator": "", "text": "EXEC_DEVELOP::\nMARZANNA/."},
        { "location": "607/TALK"  , "narrator": "マルザンナ　", "text": "これを実行して。"},
        { "location": "608/TALK"  , "narrator": "リヴォルカ", "text": "……　…？"},
        { "location": "616/TALK"  , "narrator": "リヴォルカ", "text": "ちょっ……\nまさか、嘘でしょ！？"},
        { "location": "617/TALK"  , "narrator": "マルザンナ　", "text": "本気よ。\nでも……"},
        { "location": "623/TALK"  , "narrator": "マルザンナ　", "text": "これは出来れば\nしたくなかった。"},
        { "location": "624/TALK"  , "narrator": "マルザンナ　", "text": "だから、名前も\n言わずにいた。"},
        { "location": "630/TALK"  , "narrator": "マルザンナ　", "text": "ごめん、$handle$。\nもう、こうするしか\nないの。"},
        { "location": "631/TALK"  , "narrator": "マルザンナ　", "text": "マークスマンの発症を\n絶対に阻止しなくちゃ\nいけないから！"},
        { "location": "643/SEL"   , "narrator": "", "text": "え！？"},
        { "location": "644/ACT"   , "narrator": "", "text": "え！？"},
        { "location": "646/TALK"  , "narrator": "昇華マルザンナ", "text": "$handle$……\nビックリしたでしょう？"},
        { "location": "647/TALK"  , "narrator": "昇華マルザンナ", "text": "これがあたしの\n本当の姿なの――"},
        { "location": "29/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月9日　 5:33 PM</color>\n長野県松代、エリカのラボにて"},
        { "location": "248/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\nMODE : DI\nRESTART : SPHERE_MODE.\nMODE : EI\nSET_ADDR: 0xCCE\nRUN/."},
        { "location": "652/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)"}
    ]
}
