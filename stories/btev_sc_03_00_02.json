{
    "dir": "chap00/battle/btev_sc_03_00_02.js",
    "type": "",
    "info": {
        "story_id": "35",
        "cid": "",
        "title": "【EXストーリー】音無の花",
        "sub_title": "シンクロストーリー"
    },
    "entry":
    [
        { "location": "192/SCENARIO", "narrator": "", "text": "【結果】銀葉樹"},
        { "location": "208/TALK"    , "narrator": "つばめ", "text": "お疲れさまでした。"},
        { "location": "209/TALK"    , "narrator": "つばめ", "text": "$handle$さんが\n頑張ってくれたお陰で\n『コネクト』は完了です。"},
        { "location": "210/TALK"    , "narrator": "つばめ", "text": "これによって、銀葉樹\nちゃんのココロの中の\n抵抗は消えました。"},
        { "location": "211/TALK"    , "narrator": "つばめ", "text": "$handle$さんと\n繋がる準備ができた、\nということです。"},
        { "location": "212/SEL"     , "narrator": "（選択肢）", "text": "で、『シンクロ』ってわけ？"},
        { "location": "213/ACT"     , "narrator": "", "text": "で、『シンクロ』ってわけ？"},
        { "location": "215/TALK"    , "narrator": "つばめ", "text": "そうです！"},
        { "location": "216/TALK"    , "narrator": "つばめ", "text": "シンクロをすると、\n銀葉樹ちゃんの想いが\n流れ込みます。"},
        { "location": "217/TALK"    , "narrator": "つばめ", "text": "$handle$さんは、\nどうかそれを受け入れて\nあげてください。"},
        { "location": "218/TALK"    , "narrator": "つばめ", "text": "準備はいいですか？"},
        { "location": "219/SEL"     , "narrator": "（選択肢）", "text": "はい"},
        { "location": "220/SEL"     , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "221/ACT"     , "narrator": "", "text": "はい"},
        { "location": "222/TALK"    , "narrator": "つばめ", "text": "わかりました。\nそれではココロを\n繋げます。"},
        { "location": "223/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "225/TALK"    , "narrator": "つばめ", "text": "ええっ！\nそうなんですか？"},
        { "location": "226/TALK"    , "narrator": "つばめ", "text": "それでは一旦ここで\nお別れですね。"},
        { "location": "227/TALK"    , "narrator": "つばめ", "text": "準備ができたら\nまた来てくださいね。"},
        { "location": "235/TALK"    , "narrator": "つばめ", "text": "EXEC_SYNC_SPHERE/."},
        { "location": "248/DIALOG"  , "narrator": "", "text": "もしも次に生まれ変われるなら\n私は花に生まれ変わりたい――"},
        { "location": "255/DIALOG"  , "narrator": "", "text": "クランイラスト先読み"},
        { "location": "266/DIALOG"  , "narrator": "", "text": "相澤亜紀（あいざわあき）\n16歳。多摩ニュータウン在住。家族構成は両親と弟。\n\n幼い頃から内気な性格で、大団地に住むにはストレスが大きかった模様。自ら積極的に声を掛けることの無い彼女は、昔から友だちも少なかった。"},
        { "location": "267/DIALOG"  , "narrator": "", "text": "そんな亜紀が大切にしていたものは植物、そして綺麗な鉱石の結晶。彼女の部屋の内外には様々な植物や鉱石があり、植物の世話は彼女にとって最大の楽しみだったという。"},
        { "location": "268/DIALOG"  , "narrator": "", "text": "高校生になり、人見知りな亜紀もいよいよ恋をした。亜紀と同じく草木をこよなく愛する木訥な少年。お互い理解し合える相手が殆どいなかったことも相まって、二人はすぐに親しくなった。二人は特に宣言することもなく、しかし自然とつき合うようになり、二人にとって最高に幸せな時間が訪れた。"},
        { "location": "273/DIALOG"  , "narrator": "", "text": "だがその幸せは儚く終わりを告げることになった。家から少し離れた所にある山野。とある晴れた日、二人はトレッキングへと向かう。そしてそこで不幸にも不良グループが隠れ違法行為をしているところへ遭遇してしまった。すぐさま取り囲まれる二人。彼は果敢に亜紀を守るが勢い余った相手に殺されてしまう。"},
        { "location": "274/DIALOG"  , "narrator": "", "text": "亜紀もまた襲われかけた。相手は男5人。奇跡が起きるはずも無い。絶望に打ち震える亜紀。彼女は願った。この汚れた理不尽な世界に災いを。そして発症した。"},
        { "location": "279/DIALOG"  , "narrator": "", "text": "彼女が展開した世界は青木ヶ原のような世界。そこに囚われた人々は皆、疑心暗鬼となり、出会う人と裏切り裏切られ、誰もが孤立してしまう。"},
        { "location": "280/DIALOG"  , "narrator": "", "text": "亜紀のこのやるせない気持ちを、ただ皆に共感して欲しい、そんな想いが生み出した世界だった。"},
        { "location": "297/TALK"    , "narrator": "つばめ", "text": "どうでしたか？\n銀葉樹ちゃんの想いは。"},
        { "location": "298/SEL"     , "narrator": "（選択肢）", "text": "切ないね"},
        { "location": "299/SEL"     , "narrator": "（選択肢）", "text": "無口っ子萌える"},
        { "location": "300/SEL"     , "narrator": "（選択肢）", "text": "不良は返り討ちだ"},
        { "location": "301/ACT"     , "narrator": "", "text": "切ないね"},
        { "location": "302/TALK"    , "narrator": "つばめ", "text": "そうですよね。"},
        { "location": "303/TALK"    , "narrator": "つばめ", "text": "やっと自分の気持ちを\nわかってくれる人を\n見つけたのに。"},
        { "location": "304/TALK"    , "narrator": "つばめ", "text": "あっという間に\nその幸せが\n奪われて……。"},
        { "location": "305/ACT"     , "narrator": "", "text": "無口っ子萌える"},
        { "location": "306/TALK"    , "narrator": "つばめ", "text": "…あ。"},
        { "location": "307/TALK"    , "narrator": "つばめ", "text": "はい。"},
        { "location": "308/TALK"    , "narrator": "つばめ", "text": "そうですね。"},
        { "location": "309/ACT"     , "narrator": "", "text": "不良は返り討ちだ"},
        { "location": "310/TALK"    , "narrator": "つばめ", "text": "ええっ！"},
        { "location": "311/TALK"    , "narrator": "つばめ", "text": "暴力は\nいけません、\n暴力は！"},
        { "location": "316/TALK"    , "narrator": "つばめ", "text": "わたしは……。"},
        { "location": "317/TALK"    , "narrator": "つばめ", "text": "銀葉樹ちゃんの気持ち\nよくわかります。"},
        { "location": "318/TALK"    , "narrator": "つばめ", "text": "お友達を作るのが\n上手な人は同級生が\n怖くないんです。"},
        { "location": "319/TALK"    , "narrator": "つばめ", "text": "でも、わたしも\n銀葉樹ちゃんも\nそう思うのは難しくて。"},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "でも、銀葉樹ちゃんは\n言ってくれました。"},
        { "location": "322/TALK"    , "narrator": "つばめ", "text": "あなたはそれでも\n頑張ってる。\nだから私も頑張るって。"},
        { "location": "323/TALK"    , "narrator": "つばめ", "text": "そう言ってもらえて\nわたしはとても\n嬉しかったです。"},
        { "location": "324/SEL"     , "narrator": "（選択肢）", "text": "似たもの同士だったんだ"},
        { "location": "325/ACT"     , "narrator": "", "text": "似たもの同士だったんだ"},
        { "location": "327/TALK"    , "narrator": "つばめ", "text": "そういうこと\nなんでしょうね。"},
        { "location": "329/TALK"    , "narrator": "つばめ", "text": "クランの子も、人の子。\n一緒に戦うなら、自分が\n好きな子がいいんです。"},
        { "location": "330/TALK"    , "narrator": "つばめ", "text": "でも、他の子はまた別の\n理由で一緒に戦ってる子も\nいるんです。"},
        { "location": "331/TALK"    , "narrator": "つばめ", "text": "何にしても、そんな理由で\n銀葉樹ちゃんとわたしは\n繋がりました。"},
        { "location": "332/TALK"    , "narrator": "つばめ", "text": "…ここだけの話。"},
        { "location": "333/TALK"    , "narrator": "つばめ", "text": "ずっと銀葉樹ちゃんは\n誰もコネクト\nできなかったんですよ。"},
        { "location": "334/TALK"    , "narrator": "つばめ", "text": "だからわたし、\nちょっと自慢なんです。"},
        { "location": "335/TALK"    , "narrator": "つばめ", "text": "銀葉樹ちゃんが\nわたしを選んで\nくれたこと。"},
        { "location": "336/TALK"    , "narrator": "つばめ", "text": "銀葉樹ちゃんが\n頑張る気になって\nくれたこと。"},
        { "location": "337/TALK"    , "narrator": "つばめ", "text": "そして今日からは、\n$handle$さんとも\nつながったんです！"},
        { "location": "338/TALK"    , "narrator": "つばめ", "text": "……と、いうわけで、\nわたしと銀葉樹ちゃんの\nお話はこれでお終いです。"},
        { "location": "339/TALK"    , "narrator": "つばめ", "text": "下手な語りでしたけど、\n最後まで聞いてくれて\nありがとうございました。"},
        { "location": "340/SEL"     , "narrator": "（選択肢）", "text": "こちらこそ"},
        { "location": "341/SEL"     , "narrator": "（選択肢）", "text": "これからもがんばろうね"},
        { "location": "342/ACT"     , "narrator": "", "text": "こちらこそ"},
        { "location": "344/TALK"    , "narrator": "つばめ", "text": "ううん、こちらこそです！\nどうぞよろしく\nお願いします。"},
        { "location": "345/ACT"     , "narrator": "", "text": "これからもがんばろうね"},
        { "location": "347/TALK"    , "narrator": "つばめ", "text": "はい！\nよろしく\nお願いします！"},
        { "location": "350/TALK"    , "narrator": "つばめ", "text": "どうかこれからも\nわたしたちのサポートを\nしてくださいね。"}
    ]
}
