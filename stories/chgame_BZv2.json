    "entry":
    [
        { "location": "1686/SCENARIO", "narrator": "", "text": "BZエンディング"},
        { "location": "1696/TALK"    , "narrator": "千羽鶴", "text": "ラブラブRPGゲームでは\nここに来る事が\n目的だった。"},
        { "location": "1697/TALK"    , "narrator": "千羽鶴", "text": "ここには、非攻略対象から\n非を取り除くアイテムが\n厳かに眠っていた。"},
        { "location": "1698/SEL"     , "narrator": "", "text": "いや、床に転がってましたよね…？"},
        { "location": "1699/ACT"     , "narrator": "", "text": "いや、床に転がってましたよね…？"},
        { "location": "1701/TALK"    , "narrator": "千羽鶴", "text": "うるさい、黙れ。"},
        { "location": "1702/TALK"    , "narrator": "千羽鶴", "text": "ここでちーは、ひとつ\n貴方にカミングアウト\nしておくことがある。"},
        { "location": "1703/TALK"    , "narrator": "千羽鶴", "text": "ちょっと長くなるけど、\n最後まで聞いて欲しい。"},
        { "location": "1704/TALK"    , "narrator": "千羽鶴", "text": "私がこのラブラブRPG\nゲームを作ったのは、\n１つの覚悟からだった。"},
        { "location": "1705/TALK"    , "narrator": "千羽鶴", "text": "それは、いよいよ貴方との\n別れが来るであろうという\nものだった。"},
        { "location": "1706/TALK"    , "narrator": "千羽鶴", "text": "私は、自らの思想や\nそれに対する行動について\n熟考し、実行している。"},
        { "location": "1707/TALK"    , "narrator": "千羽鶴", "text": "だから、決して\n遊び半分ではないし、\n生半可でもない。"},
        { "location": "1708/TALK"    , "narrator": "千羽鶴", "text": "そして同時に、その思想は\n恐らく殆どの人には\n理解されないと思ってた。"},
        { "location": "1709/TALK"    , "narrator": "千羽鶴", "text": "それらがいよいよ明るみに\n出始めてきたこの頃、\n貴方との関係を悩んでた。"},
        { "location": "1710/TALK"    , "narrator": "千羽鶴", "text": "貴方は私の協力者であり、\n恩人でもある。"},
        { "location": "1711/TALK"    , "narrator": "千羽鶴", "text": "けれども――"},
        { "location": "1712/TALK"    , "narrator": "千羽鶴", "text": "いえ。だからこそ、\n貴方を失望させたく\nなかった。"},
        { "location": "1713/TALK"    , "narrator": "千羽鶴", "text": "総意大半において、私との\n関係性は、理想値よりも\n親密になっていた。"},
        { "location": "1714/TALK"    , "narrator": "千羽鶴", "text": "これでは真実を知れば\n知るほど、その後荒れる\n危険性が増すと思った。"},
        { "location": "1715/TALK"    , "narrator": "千羽鶴", "text": "だから、この辺りで\n一気に関係の正常化を\n図ろうとした。"},
        { "location": "1716/TALK"    , "narrator": "千羽鶴", "text": "正常な関係として\n私が描いていたのは、\nビジネスライクなそれ。"},
        { "location": "1717/TALK"    , "narrator": "千羽鶴", "text": "すなわち、共感は\nしてくれなくてもいい。\n理解だけしてくれれば――"},
        { "location": "1718/TALK"    , "narrator": "千羽鶴", "text": "貴方は貴方の世界に\n不利益を与えない程度に\n協力してくれればいい。"},
        { "location": "1719/TALK"    , "narrator": "千羽鶴", "text": "そういう、\n竹を割ったような\n関係にしたかった。"},
        { "location": "1720/TALK"    , "narrator": "千羽鶴", "text": "そうならなければ、\n近いうちに炎上し、\nそして全てが崩壊する――"},
        { "location": "1721/TALK"    , "narrator": "千羽鶴", "text": "そう思った私は、\nこのラブラブRPGゲームを\n作ることにした。"},
        { "location": "1722/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "1723/SEL"     , "narrator": "", "text": "最後で一気に意味が分からなくなりました＞＜"},
        { "location": "1724/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "1725/ACT"     , "narrator": "", "text": "最後で一気に意味が分からなくなりました＞＜"},
        { "location": "1726/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1728/TALK"    , "narrator": "千羽鶴", "text": "じゃあ、もっと\n単刀直入に言う。"},
        { "location": "1729/TALK"    , "narrator": "千羽鶴", "text": "貴方たちの総意の大半は、\n私が攻略対象であることを\n願い続けてきていた。"},
        { "location": "1730/TALK"    , "narrator": "千羽鶴", "text": "私にはそれが\n耐えられなかった。\nなぜなら――"},
        { "location": "1732/TALK"    , "narrator": "千羽鶴", "text": "恋愛ゲーム的攻略対象に\nなんてなったら、バッド\nエンドしかあり得ない。"},
        { "location": "1733/TALK"    , "narrator": "千羽鶴", "text": "それだけのことを\n私はするし、その時貴方は\nきっと傷つくから。"},
        { "location": "1735/TALK"    , "narrator": "千羽鶴", "text": "このゲームの攻略対象とは\nRPGとしての攻略対象。\nすなわち、敵のボス。"},
        { "location": "1736/TALK"    , "narrator": "千羽鶴", "text": "私の考えてた、私と貴方の\n理想的な立ち位置は、取引\nする勇者と魔王だった。"},
        { "location": "1737/TALK"    , "narrator": "千羽鶴", "text": "それくらいでなければ、\n関係は長続きしないから。"},
        { "location": "1738/TALK"    , "narrator": "千羽鶴", "text": "私は、ここから先の\n貴方と私の関係において\nそんなスタンスを願った。"},
        { "location": "1739/TALK"    , "narrator": "千羽鶴", "text": "いつまでも、\n良き世界の協力者で\nあって欲しいが為に。"},
        { "location": "1740/TALK"    , "narrator": "千羽鶴", "text": "そんなメッセージが、\nこのRPGゲームには\n込められていた。"},
        { "location": "1742/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1743/TALK"    , "narrator": "千羽鶴", "text": "まあ、実際\nビックリしたでしょう。"},
        { "location": "1744/TALK"    , "narrator": "千羽鶴", "text": "この直後の記録映像で、\n私はそれまで貴方に見せた\nことの無い顔を見せた。"},
        { "location": "1745/SEL"     , "narrator": "", "text": "千羽鶴は、とても怖かったんだね"},
        { "location": "1746/SEL"     , "narrator": "", "text": "確かに"},
        { "location": "1747/ACT"     , "narrator": "", "text": "千羽鶴は、とても怖かったんだね"},
        { "location": "1749/TALK"    , "narrator": "千羽鶴", "text": "……うん。"},
        { "location": "1750/TALK"    , "narrator": "千羽鶴", "text": "とても怖かった。"},
        { "location": "1751/ACT"     , "narrator": "", "text": "確かに"},
        { "location": "1754/TALK"    , "narrator": "千羽鶴", "text": "それでも、\n方針の転換は\nあり得なかった。"},
        { "location": "1755/TALK"    , "narrator": "千羽鶴", "text": "だから、いつ嫌われても\n大丈夫なように、\n色んな準備をしていた。"},
        { "location": "1756/TALK"    , "narrator": "千羽鶴", "text": "でも、できれば\n今までと同じ関係で\nいたかった。"},
        { "location": "1757/TALK"    , "narrator": "千羽鶴", "text": "そういった様々な葛藤が\n生み出したのが、この\nPRGゲームだったの。"},
        { "location": "1759/TALK"    , "narrator": "千羽鶴", "text": "私が言いたかったことは、\nこれで全部。"},
        { "location": "1760/TALK"    , "narrator": "千羽鶴", "text": "答えは聞かない。\n怖いから。"},
        { "location": "1761/TALK"    , "narrator": "千羽鶴", "text": "それに。"},
        { "location": "1763/TALK"    , "narrator": "千羽鶴", "text": "今も私と一緒にいてくれて\nいること自体が、答えに\nなってると思ってるから。"},
        { "location": "1767/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1769/TALK"    , "narrator": "千羽鶴", "text": "さて。"},
        { "location": "1770/TALK"    , "narrator": "千羽鶴", "text": "これで、コメンタリーは\n全部お終い。"},
        { "location": "1771/TALK"    , "narrator": "千羽鶴", "text": "引き続き、\n記録映像も\n見ていく？"}
    ]
}
