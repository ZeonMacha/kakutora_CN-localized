    [
        { "location": "7/SCENARIO", "narrator": "", "text": "500_感情対価"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "冷静に"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "論理的な話をしようぞ"},
        { "location": "35/SEL"    , "narrator": "", "text": "ロジカルに"},
        { "location": "36/SEL"    , "narrator": "", "text": "いつもクールだよ"},
        { "location": "37/SEL"    , "narrator": "", "text": "エモーショナルな方がいいよー"},
        { "location": "38/ACT"    , "narrator": "", "text": "ロジカルに"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "そう"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "人は思考する生き物だ"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "感情的にならず"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "論理的に行こう"},
        { "location": "43/ACT"    , "narrator": "", "text": "いつもクールだよ"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "そうじゃろうか"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "今後はその方向で"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "よろしく頼む"},
        { "location": "48/ACT"    , "narrator": "", "text": "エモーショナルな方がいいよー"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "英語で言えばいいというものではない"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "正確にはカタカナか"},
        { "location": "62/SEL"    , "narrator": "", "text": "なんで急にそんなこと言うの"},
        { "location": "63/ACT"    , "narrator": "", "text": "なんで急にそんなこと言うの"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "なんというか"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "どうしてもだ"},
        { "location": "68/SEL"    , "narrator": "", "text": "冷静じゃないよね"},
        { "location": "69/SEL"    , "narrator": "", "text": "論理的には見えないよ"},
        { "location": "70/ACT"    , "narrator": "", "text": "冷静じゃないよね"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "そんなことはない"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "いたって冷静だ"},
        { "location": "73/ACT"    , "narrator": "", "text": "論理的には見えないよ"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "論理的ではないのは"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "$handle$のほうだ"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "とにかく今後は"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "そっちで頼む"},
        { "location": "81/SEL"    , "narrator": "", "text": "この前のこと気にしてるの？"},
        { "location": "82/ACT"    , "narrator": "", "text": "この前のこと気にしてるの？"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "この前のことなど何もない"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "うちは常にリアルタイム性を重視する"},
        { "location": "87/SEL"    , "narrator": "", "text": "みやびとの将来ついて考えたいのに"},
        { "location": "88/SEL"    , "narrator": "", "text": "$me$と一緒に人生を歩もうよ"},
        { "location": "89/ACT"    , "narrator": "", "text": "みやびとの将来ついて考えたいのに"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "そんなこと言うな"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "すでに考えすぎとるわ"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "ばかちんが！"},
        { "location": "93/ACT"    , "narrator": "", "text": "$me$と一緒に人生を歩もうよ"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "そんな人生"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "考えすぎて沸騰する"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "うちが蒸発する！！"},
        { "location": "100/TALK"  , "narrator": "ボイスメール", "text": "ニャンコロジック"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "何もかもがご破算ぞね"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "全部忘れろ！"},
        { "location": "54/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "112/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【ニャンコロジック】</color>\nをゲットしました！"}
