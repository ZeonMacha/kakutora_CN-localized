{
    "dir": "chap02/battle/btev_ch00_02_00.js",
    "type": "",
    "info": {
        "story_id": "22000",
        "cid": "",
        "title": "000 ココロスフィア解説",
        "sub_title": "ココロの深淵へようこそ"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ココロスフィア導入アーヤ"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>DOOR-No. 000</size>\nCHIHARU\n\n<size=40>Kokoro.Initialize();</size>\n<size=25>～深層ココロスフィアの概念について～</size>"},
        { "location": "22/TALK"   , "narrator": "千羽鶴", "text": "ようこそ、\n國政綾水の\n深層世界へ。"},
        { "location": "24/TALK"   , "narrator": "千羽鶴", "text": "前にもしてるけど、\n深層世界についての説明、\nもう一度聞く？"},
        { "location": "25/SEL"    , "narrator": "（選択肢）", "text": "はい"},
        { "location": "26/SEL"    , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "27/ACT"    , "narrator": "", "text": "はい"},
        { "location": "28/TALK"   , "narrator": "千羽鶴", "text": "わかった。\nそれじゃもう一度、\n深層世界の話をする。"},
        { "location": "30/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "31/TALK"   , "narrator": "千羽鶴", "text": "そう、助かる。"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "さて。"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "改めて、\nここは國政綾水の\n深層世界。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "少しでも彼女を見ていれば\n分かると思うけど、彼女に\n悩みはとても多い。"},
        { "location": "50/TALK"   , "narrator": "千羽鶴", "text": "どうしてか分かる？"},
        { "location": "51/SEL"    , "narrator": "（選択肢）", "text": "リーダーだから"},
        { "location": "52/SEL"    , "narrator": "（選択肢）", "text": "えいかっこしいだから"},
        { "location": "53/SEL"    , "narrator": "（選択肢）", "text": "身長も年齢もみやびより上なのに胸はみやびの方が大きいから"},
        { "location": "54/ACT"    , "narrator": "", "text": "リーダーだから"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "確かにそれはある。"},
        { "location": "56/TALK"   , "narrator": "千羽鶴", "text": "でもそれは、どちらか\nといえば、深層心理からは\n少し遠いところにある。"},
        { "location": "57/ACT"    , "narrator": "", "text": "えいかっこしいだから"},
        { "location": "58/TALK"   , "narrator": "千羽鶴", "text": "なかなか鋭い。\n貴方はとても有能。"},
        { "location": "59/TALK"   , "narrator": "千羽鶴", "text": "いいこいいこ。"},
        { "location": "60/ACT"    , "narrator": "", "text": "身長も年齢もみやびより上なのに胸はみやびの方が大きいから"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "そう、それ！\nそれこそが彼女の悩み――"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "<color=red><size=30>なわけないから！</size></color>"},
        { "location": "65/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "66/TALK"   , "narrator": "千羽鶴", "text": "ん？　いや、\nそれもあったような……"},
        { "location": "67/TALK"   , "narrator": "千羽鶴", "text": "まあいいか。"},
        { "location": "68/TALK"   , "narrator": "千羽鶴", "text": "無いから。\nもっと真面目にやって。"},
        { "location": "69/TALK"   , "narrator": "千羽鶴", "text": "人の心の奥底へ触れる\n人として、ちょっとふざけ\nすぎ。真面目にやって。"},
        { "location": "71/TALK"   , "narrator": "千羽鶴", "text": "正解は、彼女の今までの\n環境が生み出した、\n自身のスタンスにある。"},
        { "location": "72/TALK"   , "narrator": "千羽鶴", "text": "それは、人に絶対弱い\nところを見せたくない、\n見せられないという想い。"},
        { "location": "73/TALK"   , "narrator": "千羽鶴", "text": "乱暴に言えば、\n人一倍、えいかっこしいで\n完璧主義なところ。"},
        { "location": "74/TALK"   , "narrator": "千羽鶴", "text": "もちろんそれは、彼女を\n良い結果に導くことも\n多々ある。"},
        { "location": "75/TALK"   , "narrator": "千羽鶴", "text": "ただ、\n当然デメリットもある。"},
        { "location": "76/TALK"   , "narrator": "千羽鶴", "text": "そんな風に、安定して\nいそうに見える彼女は、\n実はわりと不安定なの。"},
        { "location": "77/TALK"   , "narrator": "千羽鶴", "text": "とても支え甲斐が\nあると思わない？"},
        { "location": "78/SEL"    , "narrator": "（選択肢）", "text": "はい"},
        { "location": "79/SEL"    , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "80/SEL"    , "narrator": "（選択肢）", "text": "千羽鶴の方が興味ある"},
        { "location": "81/ACT"    , "narrator": "", "text": "はい"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "まあでも。"},
        { "location": "83/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "84/TALK"   , "narrator": "千羽鶴", "text": "そう。まあ確かに、\n実際に見てみたら、支え\n甲斐は無いかもしれない。"},
        { "location": "85/TALK"   , "narrator": "千羽鶴", "text": "それに。"},
        { "location": "86/ACT"    , "narrator": "", "text": "千羽鶴の方が興味ある"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "もうここでは\n何も出ませんよ。"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "そんなことより、\n國政綾水のココロを\n癒してあげて。"},
        { "location": "95/TALK"   , "narrator": "千羽鶴", "text": "……ほんとに。"},
        { "location": "96/TALK"   , "narrator": "千羽鶴", "text": "ホントにしつこい人。"},
        { "location": "97/TALK"   , "narrator": "千羽鶴", "text": "そんなに私の\n心の中を見たい？"},
        { "location": "98/SEL"    , "narrator": "（選択肢）", "text": "はい"},
        { "location": "99/SEL"    , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "100/ACT"   , "narrator": "", "text": "はい"},
        { "location": "101/TALK"  , "narrator": "千羽鶴", "text": "おぞましすぎて、\n現実に帰って来れなく\nなるかもしれないけど。"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "103/TALK"  , "narrator": "千羽鶴", "text": "まあ、それでもと言うなら\nいずれ何か見せられる日が\n来るかもしれない。"},
        { "location": "104/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "105/TALK"  , "narrator": "千羽鶴", "text": "それが正しい判断。\n私の中を覗いても、\nろくなことがないから。"},
        { "location": "107/TALK"  , "narrator": "千羽鶴", "text": "とにかく。\n貴方の実直すぎるアホに\n免じて、ご褒美あげる。"},
        { "location": "117/TALK"  , "narrator": "千羽鶴", "text": "何にしても今は、\n國政綾水のココロを\n癒してあげて。"},
        { "location": "121/TALK"  , "narrator": "千羽鶴", "text": "しつこいです。\nさっさと國政綾水の\nココロを癒してあげて。"},
        { "location": "125/TALK"  , "narrator": "千羽鶴", "text": "だから、私は\nチュートリアルキャラ。\nココロなんて存在しない。"},
        { "location": "126/TALK"  , "narrator": "千羽鶴", "text": "さっさと國政綾水の\nココロを癒してあげて。"},
        { "location": "130/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、私は単なる\nチュートリアルキャラ。\nココロなんて存在しない。"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "今は國政綾水の\nココロを癒すことに\n集中して。"},
        { "location": "136/TALK"  , "narrator": "千羽鶴", "text": "話を戻すけど。\n彼女の心の中は、決して\n安穏とはしていない。"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "関わってみると、\n割とむかつくことも\nあるかもしれないし。"},
        { "location": "139/TALK"  , "narrator": "千羽鶴", "text": "けど、彼女にとっては、\nそれさえも、魂がすり減る\nくらい考えた結果なの。"},
        { "location": "140/TALK"  , "narrator": "千羽鶴", "text": "だから是非、\n真摯に向かい合って\n支えてあげてほしい。"},
        { "location": "141/TALK"  , "narrator": "千羽鶴", "text": "貴方と國政綾水に、\n素晴らしきココロの旅を。"}
    ]
}
