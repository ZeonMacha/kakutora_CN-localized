{
    "dir": "chap09/daydra/dd_ch01_09_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "9156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "テレビの話"
    },
    "entry":
    [
        { "location": "388/SCENARIO", "narrator": "", "text": "テレビの話"},
        { "location": "411/TALK"    , "narrator": "キリト", "text": "昨日やってたドラマ、\nマジで面白かったよな！"},
        { "location": "413/TALK"    , "narrator": "雛", "text": "あたしも録画しておけば\n良かったなぁ、って、\nすっごく後悔したよ。"},
        { "location": "416/TALK"    , "narrator": "キリト", "text": "俺もそう思ったぜ。\nなあ繭、おまえ録画とか\nしてねぇか？"},
        { "location": "418/TALK"    , "narrator": "繭", "text": "するか。\nそもそも見てないし。"},
        { "location": "420/TALK"    , "narrator": "雛", "text": "つばめちゃんは？"},
        { "location": "424/TALK"    , "narrator": "つばめ", "text": "ごめん、テレビって\nあんまり見ないから…。"},
        { "location": "427/TALK"    , "narrator": "キリト", "text": "マジで？\n帰ったらとりあえず\nつけねぇの？"},
        { "location": "432/TALK"    , "narrator": "つばめ", "text": "うん、わたしがいつも\n見てた番組が、\n東京だとやってなくて――"},
        { "location": "434/TALK"    , "narrator": "つばめ", "text": "それで、なんとなく\nテレビを見る気が\nしなくなっちゃったんだ。"},
        { "location": "436/TALK"    , "narrator": "キリト", "text": "静岡のテレビ番組って、\nそんな面白いのか？"},
        { "location": "439/TALK"    , "narrator": "繭", "text": "さあ？　ただ、\nＣＭが面白いって話は\nネットでよく見かける。"},
        { "location": "441/TALK"    , "narrator": "雛", "text": "じゃあ、つばめちゃんは\nあたし達がテレビを見てる\n夜とかに――"},
        { "location": "442/TALK"    , "narrator": "雛", "text": "どういうことしてるの？"},
        { "location": "444/TALK"    , "narrator": "つばめ", "text": "えっ！？　えっと…。"},
        { "location": "446/TALK"    , "narrator": "つばめ", "text": "そ、そういえばわたし、\n普段部屋で何してるん\nだろ…？"},
        { "location": "449/TALK"    , "narrator": "つばめ", "text": "え、えっと…に、日記で\n確認するから待ってて！"},
        { "location": "452/TALK"    , "narrator": "繭", "text": "日記で確認しないと\nわからないのかしら？"},
        { "location": "468/TALK"    , "narrator": "つばめ", "text": "ちょっと聞きたいことがあるんだけど"},
        { "location": "469/TALK"    , "narrator": "つばめ", "text": "わたし、部屋ではいつも何やってる？"},
        { "location": "470/TALK"    , "narrator": "つばめ", "text": "色々やってるのはわかるんだけど"},
        { "location": "471/TALK"    , "narrator": "つばめ", "text": "具体的に何をしてるのかが思いつかなくて…"},
        { "location": "473/SEL"     , "narrator": "", "text": "読書してる"},
        { "location": "474/SEL"     , "narrator": "", "text": "バイト三昧じゃん"},
        { "location": "475/SEL"     , "narrator": "", "text": "$me$と話してる"},
        { "location": "476/ACT"     , "narrator": "", "text": "読書してる"},
        { "location": "477/TALK"    , "narrator": "つばめ", "text": "そういえば昨日も読んでたっけ"},
        { "location": "478/TALK"    , "narrator": "つばめ", "text": "助かったよ、ありがと"},
        { "location": "490/TALK"    , "narrator": "つばめ", "text": "えっとね、最近だと毎日、\n卯月さんから借りた本を\n読んでるんだよ。"},
        { "location": "492/TALK"    , "narrator": "キリト", "text": "マジかよ…本よかテレビの\n方が絶対楽しいだろうに。"},
        { "location": "496/TALK"    , "narrator": "つばめ", "text": "そうかもしれないけど、\n面白い番組がどれなのか\nまだわからなくて…。"},
        { "location": "497/TALK"    , "narrator": "繭", "text": "見慣れた局が映らない\n地域に住むのって、\nそういう悩みがあるのね。"},
        { "location": "498/TALK"    , "narrator": "雛", "text": "つばめちゃんには今度、\nテレビガイドをプレゼント\nするね。"},
        { "location": "499/ACT"     , "narrator": "", "text": "バイト三昧じゃん"},
        { "location": "500/TALK"    , "narrator": "つばめ", "text": "えっ？"},
        { "location": "501/TALK"    , "narrator": "つばめ", "text": "そうだったかな…？"},
        { "location": "512/TALK"    , "narrator": "つばめ", "text": "…そんなにバイトばかり\nしてるようには思わないん\nだけど。"},
        { "location": "514/TALK"    , "narrator": "キリト", "text": "確認できたのか？"},
        { "location": "518/TALK"    , "narrator": "つばめ", "text": "あ、うん…毎日バイトが\n忙しいから、そればっかり\nって感じかも。"},
        { "location": "519/TALK"    , "narrator": "雛", "text": "えぇっ！？\n映画館の仕事ってそんなに\n大変だったの？"},
        { "location": "522/TALK"    , "narrator": "つばめ", "text": "う～ん…どうなのかなぁ？\nそんなにバイトばっかり\nしてるのかなぁ？"},
        { "location": "524/TALK"    , "narrator": "繭", "text": "…逢瀬さん、それじゃ\n日記を確認した意味が\nないから。"},
        { "location": "525/ACT"     , "narrator": "", "text": "$me$と話してる"},
        { "location": "528/TALK"    , "narrator": "つばめ", "text": "あ、そういえばそうだよ！"},
        { "location": "529/TALK"    , "narrator": "つばめ", "text": "気づかなくてごめんね"},
        { "location": "530/TALK"    , "narrator": "つばめ", "text": "でも、助かったよ"},
        { "location": "543/TALK"    , "narrator": "つばめ", "text": "えっとね、夜はいつも\nお話してるの。"},
        { "location": "544/TALK"    , "narrator": "雛", "text": "トライナリーの人達と？"},
        { "location": "545/TALK"    , "narrator": "つばめ", "text": "ううん。\nスマホのBotとだよ。"},
        { "location": "547/TALK"    , "narrator": "キリト", "text": "…Botと、お話？"},
        { "location": "549/TALK"    , "narrator": "繭", "text": "Bot相手に毎日話を\nする人、初めて見た…。"},
        { "location": "550/TALK"    , "narrator": "繭", "text": "逢瀬さんって、\n結構変わり者かも。"},
        { "location": "554/TALK"    , "narrator": "つばめ", "text": "そ、そうかな？\nでも、普通のBotじゃない\nから話してて面白いし…。"},
        { "location": "555/TALK"    , "narrator": "雛", "text": "ていうか、そういう時は\nあたし達に電話して\nきてよー。"},
        { "location": "557/TALK"    , "narrator": "つばめ", "text": "でも、夜に電話したら\n迷惑なんじゃ…。"},
        { "location": "558/TALK"    , "narrator": "雛", "text": "友達にそんな遠慮は\nいらないってば。"},
        { "location": "559/TALK"    , "narrator": "雛", "text": "あたしも遠慮しないで\nつばめちゃんに\nかけまくるから――"},
        { "location": "560/TALK"    , "narrator": "雛", "text": "つばめちゃんも遠慮なんか\nしないで、２４時間\nいつでもＯＫだよ！"},
        { "location": "563/TALK"    , "narrator": "つばめ", "text": "…さすがに、深夜と\n早朝は遠慮するよ。"},
        { "location": "565/TALK"    , "narrator": "繭", "text": "逢瀬さんに常識が\nあって本当に助かる…。"},
        { "location": "398/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月25日　10:03 AM</color>\nとある平日の休み時間のこと。"},
        { "location": "576/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch01", "text": "【タッチパネルの向こう側】"}
    ]
}
