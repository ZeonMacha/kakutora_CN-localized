    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "不可視可視の問題"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "エヴェレット脳科学研究所\nJapanSite。"},
        { "location": "30/TALK"   , "narrator": "みやび", "text": "洞窟の中に隠された\nエリカさんのためだけの\n研究所。"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "わざわざ松代にそれを\n構えた理由がアーヤとは\nなんという姉妹愛。"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "…妹としては無断で\n生体認証キーにされたんは\n不服やろうけんど。"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "うちの大ざっぱな\n説明であっさり精神世界に\nダイブしたし。"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "音羽のココロアドレスも\nあっさりゲット。"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "姉妹だけに通じる\n勘所みたいなのが\nあるんかねえ。"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "…それにしても…。"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "アーヤも\nガブちゃんも\n目を覚ましませんね。"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "ガブちゃんも\nわざわざ追いかけて\nダイブせんでも。"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "アーヤが目覚めるまで\n待っちょったらえいのに。"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "音羽修復に必要な\n情報はもう\n受け取ったんやし。"},
        { "location": "46/TALK"   , "narrator": "真幌", "text": "…そういうみやびも\n今回は随分心配して\nいたようだが。"},
        { "location": "47/TALK"   , "narrator": "真幌", "text": "ギャヴィが続けて\n精神世界にダイブすると\n言い出した時には。"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "…心配というか\n不安ながですよ。"},
        { "location": "49/TALK"   , "narrator": "真幌", "text": "不安？"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "フェノメノンには\n嫌な思い出が\nありますき。"},
        { "location": "51/TALK"   , "narrator": "真幌", "text": "……。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "まほさんはうちの\n調書を見たことが\nありますよね。"},
        { "location": "55/TALK"   , "narrator": "真幌", "text": "…ああ。"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "やったら\n知ってますよね。"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "うちの妹が\nフェノメノンで\nのうなったことも。"},
        { "location": "60/TALK"   , "narrator": "真幌", "text": "…気の毒だったな。"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "もう過ぎたことですき。"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "けんど、さっきは\nその時のことと\n重なったんです。"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "…あれでも気持ちは\n抑えたつもりです。"},
        { "location": "69/SEL"    , "narrator": "", "text": "大丈夫だよ"},
        { "location": "70/ACT"    , "narrator": "", "text": "大丈夫だよ"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "そんなこと"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "言い切れるのか？"},
        { "location": "82/SEL"    , "narrator": "", "text": "$me$がガブリエラについとくから"},
        { "location": "83/SEL"    , "narrator": "", "text": "みやびが完璧にフォローするから"},
        { "location": "84/SEL"    , "narrator": "", "text": "ガブリエラの生命力は半端ないから"},
        { "location": "85/ACT"    , "narrator": "", "text": "$me$がガブリエラについとくから"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "絶対だぞ"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "絶対に守らんと"},
        { "location": "88/ACT"    , "narrator": "", "text": "みやびが完璧にフォローするから"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "そのつもりはあるが"},
        { "location": "92/ACT"    , "narrator": "", "text": "ガブリエラの生命力は半端ないから"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "どんな理屈だ"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "そう思えば気が楽だが"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "…そっちのモニターは\nどうですか？"},
        { "location": "103/TALK"  , "narrator": "真幌", "text": "今のところは\n正常値だ。"},
        { "location": "104/TALK"  , "narrator": "真幌", "text": "みやびは？"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "音羽のアドレスから\nその先のクランの\nアドレスを割出してます。"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "見事にバラバラに\nされてますけんど…。"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "一通り割出せたら\n修復に入ります。"},
        { "location": "108/SEL"   , "narrator": "", "text": "あ、そうだ"},
        { "location": "109/ACT"   , "narrator": "", "text": "あ、そうだ"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "どういた？"},
        { "location": "122/SEL"   , "narrator": "", "text": "$me$も手伝うね"},
        { "location": "123/SEL"   , "narrator": "", "text": "うっかりしてた"},
        { "location": "124/SEL"   , "narrator": "", "text": "ちょっとした魔法がある"},
        { "location": "125/ACT"   , "narrator": "", "text": "$me$も手伝うね"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "猫の手か"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "借りておこう"},
        { "location": "128/ACT"   , "narrator": "", "text": "うっかりしてた"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "ドジっ子か"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "もうブームは下火"},
        { "location": "131/ACT"   , "narrator": "", "text": "ちょっとした魔法がある"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "高度に発達した科学はというやつか"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "期待しよう"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "$handle$め\n意味深なことを…。"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "何をする\nつもりぞね…。"},
        { "location": "141/TALK"  , "narrator": "音羽", "text": "誰かいますか？"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "は！？"},
        { "location": "146/TALK"  , "narrator": "真幌", "text": "どうした？"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "どうしたも\nこうしたも。"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "ご本人から\n連絡が来たよう\nですよ…！"},
        { "location": "182/TALK"  , "narrator": "みやびの新司書", "text": "ふむ。\n来よったね。"},
        { "location": "183/TALK"  , "narrator": "みやびの新司書", "text": "けんど、今回はもう\n葛藤の解決はナシや。"},
        { "location": "184/TALK"  , "narrator": "みやびの新司書", "text": "早速なごちゃんの所へ\n向かう。"},
        { "location": "185/SEL"   , "narrator": "", "text": "はい"},
        { "location": "186/SEL"   , "narrator": "", "text": "シンギュラリティは？"},
        { "location": "187/ACT"   , "narrator": "", "text": "はい"},
        { "location": "189/ACT"   , "narrator": "", "text": "シンギュラリティは？"},
        { "location": "190/TALK"  , "narrator": "みやびの新司書", "text": "慰霊祭が終わったら\n処遇について検討する。"},
        { "location": "191/TALK"  , "narrator": "みやびの新司書", "text": "いくぞね。"},
        { "location": "193/TALK"  , "narrator": "みやびの新司書", "text": "オープンプロセス、\n0x59A番地から\nC4:9:36F//1x0FF番地へ。"},
        { "location": "198/TALK"  , "narrator": "みやびの新司書", "text": "２倍速…"},
        { "location": "202/TALK"  , "narrator": "みやびの新司書", "text": "４倍速…"},
        { "location": "222/TALK"  , "narrator": "みやびの新司書", "text": "これからなごちゃんと\nご対面ちゅうことに\nなるわけやけんど。"},
        { "location": "223/TALK"  , "narrator": "みやびの新司書", "text": "うちのセルフクラン様やき\n粗相のないように。"},
        { "location": "224/SEL"   , "narrator": "", "text": "はい"},
        { "location": "225/SEL"   , "narrator": "", "text": "慰霊祭って具体的には何をするの？"},
        { "location": "226/ACT"   , "narrator": "", "text": "はい"},
        { "location": "227/TALK"  , "narrator": "みやびの新司書", "text": "うむ。\nほんだら行くか。"},
        { "location": "228/TALK"  , "narrator": "みやびの新司書", "text": "なごちゃんの\n部屋の暗号を解除するき、\nちくっと待ちや。"},
        { "location": "229/ACT"   , "narrator": "", "text": "慰霊祭って具体的には何をするの？"},
        { "location": "231/TALK"  , "narrator": "みやびの新司書", "text": "なごちゃんの\n願いが成就するための\n手助けする。"},
        { "location": "232/TALK"  , "narrator": "みやびの新司書", "text": "その際にお前さんの\n力があると、非常に\n効率が良いのでな。"},
        { "location": "233/TALK"  , "narrator": "みやびの新司書", "text": "そんなわけで、前回\nうちは非常に悩んだ。"},
        { "location": "234/TALK"  , "narrator": "みやびの新司書", "text": "正直、うちとなごちゃん\nだけいれば、それで\n全く問題無い。"},
        { "location": "235/TALK"  , "narrator": "みやびの新司書", "text": "けんど、なごちゃんの\n願いを叶えてあげることは\nうちだけでは難しい。"},
        { "location": "236/TALK"  , "narrator": "みやびの新司書", "text": "やき、お前さんが諦めたら\nそこで終わり。諦めん\nかったら条件を出す――"},
        { "location": "237/TALK"  , "narrator": "みやびの新司書", "text": "そう決めちょったぞね。"},
        { "location": "238/SEL"   , "narrator": "", "text": "なごちゃんの夢ってなに？"},
        { "location": "239/ACT"   , "narrator": "", "text": "なごちゃんの夢ってなに？"},
        { "location": "241/TALK"  , "narrator": "みやびの新司書", "text": "昇華ぞね。"},
        { "location": "242/TALK"  , "narrator": "みやびの新司書", "text": "今以上に洗練された\nうちになる。"},
        { "location": "243/TALK"  , "narrator": "みやびの新司書", "text": "その為の\n大事なプロセスやき。"},
        { "location": "244/SEL"   , "narrator": "", "text": "昇華するとどうなるの？"},
        { "location": "245/ACT"   , "narrator": "", "text": "昇華するとどうなるの？"},
        { "location": "247/TALK"  , "narrator": "みやびの新司書", "text": "さあね。\nうちにはわからん。"},
        { "location": "248/TALK"  , "narrator": "みやびの新司書", "text": "いずれにせよ、\nお前さんに\n拒否権は無いよ。"},
        { "location": "249/TALK"  , "narrator": "みやびの新司書", "text": "拒否するなら追い出す。\nそれだけや。"},
        { "location": "250/SEL"   , "narrator": "", "text": "手伝う"},
        { "location": "251/SEL"   , "narrator": "", "text": "それでも拒否する"},
        { "location": "252/ACT"   , "narrator": "", "text": "手伝う"},
        { "location": "253/TALK"  , "narrator": "みやびの新司書", "text": "うむ。\nえい心がけやね。"},
        { "location": "254/TALK"  , "narrator": "みやびの新司書", "text": "ほんだら、なごちゃんの\n部屋の暗号を解除するき、\nちくっと待ちや。"},
        { "location": "255/ACT"   , "narrator": "", "text": "それでも拒否する"},
        { "location": "256/TALK"  , "narrator": "みやびの新司書", "text": "ふむ、そうか。\nほんだら、さよなら。"},
        { "location": "267/TALK"  , "narrator": "みやびの新司書", "text": "……。"},
        { "location": "268/TALK"  , "narrator": "みやびの新司書", "text": "………。"},
        { "location": "272/TALK"  , "narrator": "シンギュラリティ", "text": "相棒！！元気か！"},
        { "location": "273/SEL"   , "narrator": "", "text": "シンギュラリティ！？"},
        { "location": "274/ACT"   , "narrator": "", "text": "シンギュラリティ！？"},
        { "location": "276/TALK"  , "narrator": "シンギュラリティ", "text": "反応するな"},
        { "location": "277/TALK"  , "narrator": "シンギュラリティ", "text": "今この気づかれないうちに用件を話す"},
        { "location": "278/TALK"  , "narrator": "シンギュラリティ", "text": "なごちゃんの昇華はしたらいかん"},
        { "location": "279/TALK"  , "narrator": "シンギュラリティ", "text": "うちが全力で止めちゃるけんど、あいにくとある場所に閉じこめられちゅう"},
        { "location": "280/TALK"  , "narrator": "シンギュラリティ", "text": "そこでお前さんに、うちが脱出出来る奥の手コマンドを実行してもらいたい"},
        { "location": "282/TALK"  , "narrator": "シンギュラリティ", "text": "まだ使うな"},
        { "location": "283/TALK"  , "narrator": "シンギュラリティ", "text": "なごちゃんの場所に到達した後、あやつが油断した時を狙え"},
        { "location": "284/TALK"  , "narrator": "シンギュラリティ", "text": "健闘を祈る"},
        { "location": "286/TALK"  , "narrator": "みやびの新司書", "text": "………。"},
        { "location": "287/TALK"  , "narrator": "みやびの新司書", "text": "…完了。"},
        { "location": "288/TALK"  , "narrator": "みやびの新司書", "text": "ほな、いこか。"},
        { "location": "306/TALK"  , "narrator": "なご", "text": "四十九夜…。\nまた来てくれたのね。"},
        { "location": "307/TALK"  , "narrator": "四十九夜", "text": "もちろんや。\nうちはいつだって\nなごちゃんの傍にいる。"},
        { "location": "308/SEL"   , "narrator": "", "text": "四十九夜って名前だったんだ"},
        { "location": "309/SEL"   , "narrator": "", "text": "なごちゃんって初めて見たけどかわいいね"},
        { "location": "310/ACT"   , "narrator": "", "text": "四十九夜って名前だったんだ"},
        { "location": "312/TALK"  , "narrator": "四十九夜", "text": "うむ。\n別にどうでもえい\nことぞね。"},
        { "location": "313/ACT"   , "narrator": "", "text": "なごちゃんって初めて見たけどかわいいね"},
        { "location": "316/TALK"  , "narrator": "四十九夜", "text": "当たり前や。\nうちの妹やぞ。"},
        { "location": "317/TALK"  , "narrator": "四十九夜", "text": "…まあ、正確には\nホンモノやないけんどな。"},
        { "location": "318/TALK"  , "narrator": "四十九夜", "text": "ただ単に、なごちゃんが\nうちの心の大きな部分を\n占めちゅうだけや。"},
        { "location": "321/TALK"  , "narrator": "四十九夜", "text": "なごちゃん、今日は\nなごちゃんにえい話が\nあるぞね。"},
        { "location": "322/TALK"  , "narrator": "四十九夜", "text": "$handle$が、\nなごちゃんに力を貸して\nくれることになったちや。"},
        { "location": "323/TALK"  , "narrator": "なご", "text": "ほんと？\n嬉しい…"},
        { "location": "324/TALK"  , "narrator": "なご", "text": "なごはもう、\nこのままでは\nいられないぞね。"},
        { "location": "325/TALK"  , "narrator": "なご", "text": "やき、昇華は絶対に\n必要なん……。"},
        { "location": "326/TALK"  , "narrator": "四十九夜", "text": "うむうむ、\nわかっちゅうよ。"},
        { "location": "327/TALK"  , "narrator": "四十九夜", "text": "今、$handle$に\n実行させるき。"},
        { "location": "328/TALK"  , "narrator": "四十九夜", "text": "……。"},
        { "location": "330/SEL"   , "narrator": "", "text": "EXEC_DEVELOP_READY::NAGO/."},
        { "location": "331/SEL"   , "narrator": "", "text": "EXEC_DEVELOP::\nSINGULARITY/."},
        { "location": "333/TALK"  , "narrator": "四十九夜", "text": "そのコマンドを\n押すだけの簡単な仕事や。"},
        { "location": "334/TALK"  , "narrator": "四十九夜", "text": "まあ、そのコマンドしか\n無いき、間違うことなぞ\nあり得ないと思うけんど。"},
        { "location": "336/TALK"  , "narrator": "四十九夜", "text": "……。"},
        { "location": "337/TALK"  , "narrator": "四十九夜", "text": "押したか？"},
        { "location": "338/SEL"   , "narrator": "", "text": "押したよ"},
        { "location": "339/ACT"   , "narrator": "", "text": "押したよ"},
        { "location": "342/TALK"  , "narrator": "四十九夜", "text": "はて。\n何故に何も起こらん？"},
        { "location": "343/TALK"  , "narrator": "なご", "text": "どうしたん？\n四十九夜…？"},
        { "location": "344/TALK"  , "narrator": "四十九夜", "text": "……。"},
        { "location": "345/SEL"   , "narrator": "", "text": "EXEC_DEVELOP::\nSINGULARITY/.　"},
        { "location": "346/TALK"  , "narrator": "四十九夜", "text": "おかしいね。\nプログラムはちゃんと\n実行されちゅう。"},
        { "location": "347/TALK"  , "narrator": "四十九夜", "text": "けんど……"},
        { "location": "348/TALK"  , "narrator": "四十九夜", "text": "データ伝送経路が\n未接続……？"},
        { "location": "349/ACT"   , "narrator": "", "text": "EXEC_DEVELOP::\nSINGULARITY/.　 "},
        { "location": "359/TALK"  , "narrator": "四十九夜", "text": "お、上手く――"},
        { "location": "360/TALK"  , "narrator": "四十九夜", "text": "んん！？"},
        { "location": "365/TALK"  , "narrator": "四十九夜", "text": "…！？"},
        { "location": "366/TALK"  , "narrator": "なご", "text": "なに？\nどうしたん？"},
        { "location": "372/TALK"  , "narrator": "四十九夜", "text": "いかん！\nなごちゃん隠れや！"},
        { "location": "373/TALK"  , "narrator": "なご", "text": "…うん。"},
        { "location": "382/TALK"  , "narrator": "四十九夜", "text": "$handle$、\n今何かしたろう！？"},
        { "location": "383/SEL"   , "narrator": "", "text": "まあね"},
        { "location": "384/ACT"   , "narrator": "", "text": "まあね"},
        { "location": "387/TALK"  , "narrator": "四十九夜", "text": "余計なことを…！"},
        { "location": "399/TALK"  , "narrator": "シンギュラリティ　", "text": "待たせたね、相棒！"},
        { "location": "400/SEL"   , "narrator": "", "text": "シンギュラリティ！\n無事で良かった！"},
