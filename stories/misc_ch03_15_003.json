    "entry":
    [
        { "location": "185/SCENARIO", "narrator": "", "text": "024_それは棘のような"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "何でも持っている王様がいました"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "土地も宝石も、およそ人が羨むもので持っていないものはありません"},
        { "location": "212/TALK"    , "narrator": "ガブリエラ", "text": "でも王様の心には"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "ずっと棘のようなものが刺さっていたのです"},
        { "location": "215/SEL"     , "narrator": "", "text": "刺抜き貸そうか？"},
        { "location": "216/SEL"     , "narrator": "", "text": "新作だね"},
        { "location": "217/SEL"     , "narrator": "", "text": "寓意的"},
        { "location": "218/ACT"     , "narrator": "", "text": "刺抜き貸そうか？"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "比喩表現よ"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "わからないかしら"},
        { "location": "221/ACT"     , "narrator": "", "text": "新作だね"},
        { "location": "222/TALK"    , "narrator": "ガブリエラ", "text": "そうなの"},
        { "location": "223/TALK"    , "narrator": "ガブリエラ", "text": "なかなかいいと思っているのよ"},
        { "location": "226/ACT"     , "narrator": "", "text": "寓意的"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "あら///////////"},
        { "location": "229/TALK"    , "narrator": "ガブリエラ", "text": "素敵な感想をありがとうｖｖｖｖ"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "王様はどうして心がチクチクしてたのかしらね"},
        { "location": "235/SEL"     , "narrator": "", "text": "決めてなかったの？"},
        { "location": "236/SEL"     , "narrator": "", "text": "恋……かな"},
        { "location": "237/SEL"     , "narrator": "", "text": "良心の呵責を感じて"},
        { "location": "238/ACT"     , "narrator": "", "text": "決めてなかったの？"},
        { "location": "239/TALK"    , "narrator": "ガブリエラ", "text": "いいじゃないの"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "これから考えるのよ"},
        { "location": "241/TALK"    , "narrator": "ガブリエラ", "text": "そんなこともあるわよ"},
        { "location": "242/ACT"     , "narrator": "", "text": "恋……かな"},
        { "location": "243/TALK"    , "narrator": "ガブリエラ", "text": "それは素敵だけれど"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "王様よ？"},
        { "location": "245/TALK"    , "narrator": "ガブリエラ", "text": "お妃さまもお姫様ももういるはずよ？"},
        { "location": "246/ACT"     , "narrator": "", "text": "良心の呵責を感じて"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "248/TALK"    , "narrator": "ガブリエラ", "text": "悪い王様なのね"},
        { "location": "249/TALK"    , "narrator": "ガブリエラ", "text": "でも反省してるからいい王様なのかしら"},
        { "location": "251/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "252/TALK"    , "narrator": "ガブリエラ", "text": "あえて何でかを決めないままなのもいいかもしれないわ"},
        { "location": "253/TALK"    , "narrator": "ガブリエラ", "text": "その方が深いお話になりそうだし"}
    ]
}
