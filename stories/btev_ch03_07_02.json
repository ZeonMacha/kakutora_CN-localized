    "entry":
    [
        { "location": "508/SCENARIO", "narrator": "", "text": "オールニーズユー"},
        { "location": "521/TALK"    , "narrator": "アーヤ", "text": "まさか、私が\n負けるなんて…っ…"},
        { "location": "522/TALK"    , "narrator": "ガブリエラ", "text": "！？"},
        { "location": "529/TALK"    , "narrator": "ガブリエラ", "text": "えええっ！？\nあんたは、\nあたしだったの？"},
        { "location": "531/TALK"    , "narrator": "表層ガブリエラ", "text": "そうよ。\nあんたよりも建設的な\nあたし。"},
        { "location": "532/TALK"    , "narrator": "ガブリエラ", "text": "騙してたのね！？"},
        { "location": "533/TALK"    , "narrator": "表層ガブリエラ", "text": "人聞きが悪い。\nあたしは自分の道を\n正そうとしただけ。"},
        { "location": "535/TALK"    , "narrator": "表層ガブリエラ", "text": "自分の力が認められて\nいない環境にいたら、\nいずれ心が折れる。"},
        { "location": "536/TALK"    , "narrator": "表層ガブリエラ", "text": "そうなる前に、\n防護策をとっただけよ。"},
        { "location": "538/TALK"    , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "540/TALK"    , "narrator": "表層ガブリエラ", "text": "でもそれも\n叶わなかった。"},
        { "location": "541/TALK"    , "narrator": "表層ガブリエラ", "text": "願わくば、あたしの\n心が自分の想像以上に\n強靱でありますように。"},
        { "location": "551/TALK"    , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "563/TALK"    , "narrator": "ガブリエラ", "text": "……あたしはまだ\n日本でやりたい\nことがあるの。"},
        { "location": "565/TALK"    , "narrator": "ガブリエラ", "text": "今はまだ、\nポーランドには\n帰りたくない。"},
        { "location": "567/TALK"    , "narrator": "ガブリエラ", "text": "けど……\n自信もないの。"},
        { "location": "569/TALK"    , "narrator": "ガブリエラ", "text": "さっきまで思っていた\nトライナリーやめて\nやる！って感情――"},
        { "location": "570/TALK"    , "narrator": "ガブリエラ", "text": "それは消えて\n無くなったけど……。"},
        { "location": "571/TALK"    , "narrator": "ガブリエラ", "text": "正直、まだどうしたら\nいいかわからない。"},
        { "location": "572/TALK"    , "narrator": "ガブリエラ", "text": "あたし、これからも\nトライナリーで\nやっていけるのかしら。"},
        { "location": "573/SEL"     , "narrator": "（選択肢）", "text": "大丈夫だよ"},
        { "location": "574/SEL"     , "narrator": "（選択肢）", "text": "そんなに悩むこと？"},
        { "location": "575/ACT"     , "narrator": "", "text": "大丈夫だよ"},
        { "location": "576/TALK"    , "narrator": "ガブリエラ", "text": "そうかしら。"},
        { "location": "577/TALK"    , "narrator": "ガブリエラ", "text": "でも、アーヤはここ\n最近、あたしに裏方\nばかり頼んでくるの。"},
        { "location": "578/TALK"    , "narrator": "ガブリエラ", "text": "もっとあたしの価値を\nちゃんと見て\n欲しいのに。"},
        { "location": "579/ACT"     , "narrator": "", "text": "そんなに悩むこと？"},
        { "location": "580/TALK"    , "narrator": "ガブリエラ", "text": "悩むわよ！！"},
        { "location": "581/TALK"    , "narrator": "ガブリエラ", "text": "必要とされてない\n組織にいること以上の\n屈辱は無いわ！"},
        { "location": "582/SEL"     , "narrator": "（選択肢）", "text": "必要とされてるよ"},
        { "location": "583/SEL"     , "narrator": "（選択肢）", "text": "どうしてそう思うの？"},
        { "location": "584/ACT"     , "narrator": "", "text": "必要とされてるよ"},
        { "location": "585/TALK"    , "narrator": "ガブリエラ", "text": "ならどうしてアーヤは\nあたしにどうでもいい\n事ばかり任せるの？"},
        { "location": "586/ACT"     , "narrator": "", "text": "どうしてそう思うの？"},
        { "location": "587/TALK"    , "narrator": "ガブリエラ", "text": "アーヤがくだらない\nことばかり頼んでくる\nからよ。"},
        { "location": "589/TALK"    , "narrator": "ガブリエラ", "text": "あたしの力を認めて\nいたら、もっと違う\n事を頼むはずよ？"},
        { "location": "591/SEL"     , "narrator": "（選択肢）", "text": "華々しく活躍したいんだね"},
        { "location": "592/SEL"     , "narrator": "（選択肢）", "text": "やっぱりガブちゃんはまだ子供だなぁ"},
        { "location": "593/ACT"     , "narrator": "", "text": "華々しく活躍したいんだね"},
        { "location": "595/TALK"    , "narrator": "ガブリエラ", "text": "別にそういう\nわけじゃ……。"},
        { "location": "596/TALK"    , "narrator": "ガブリエラ", "text": "ただ、あたしは\nアーヤに認めて\nもらいたいだけ。"},
        { "location": "597/ACT"     , "narrator": "", "text": "やっぱりガブちゃんはまだ子供だなぁ"},
        { "location": "598/TALK"    , "narrator": "ガブリエラ", "text": "ちょっとそれ\nどういう意味よ！"},
        { "location": "599/SEL"     , "narrator": "（選択肢）", "text": "本当の格好良さは裏方にあるのさ"},
        { "location": "600/ACT"     , "narrator": "", "text": "本当の格好良さは裏方にあるのさ"},
        { "location": "602/TALK"    , "narrator": "ガブリエラ", "text": "そ、そうなの？"},
        { "location": "603/SEL"     , "narrator": "（選択肢）", "text": "大人にならないと分からないからね"},
        { "location": "604/ACT"     , "narrator": "", "text": "大人にならないと分からないからね"},
        { "location": "607/TALK"    , "narrator": "ガブリエラ", "text": "あ、あら。\nそんなことは\n分かってるのよ？"},
        { "location": "608/TALK"    , "narrator": "ガブリエラ", "text": "あたしが言いたいのは、\nアーヤがあたしを認め\nてくれないってことよ。"},
        { "location": "612/SEL"     , "narrator": "（選択肢）", "text": "アーヤに認めてもらいたいんだね"},
        { "location": "613/ACT"     , "narrator": "", "text": "アーヤに認めてもらいたいんだね"},
        { "location": "615/TALK"    , "narrator": "ガブリエラ", "text": "ど、どうして\nそういう結論に\nなるのよ！！"},
        { "location": "616/SEL"     , "narrator": "（選択肢）", "text": "それ以外の結論を導き出す方が難しいんだけど…"},
        { "location": "617/ACT"     , "narrator": "", "text": "それ以外の結論を導き出す方が難しいんだけど…"},
        { "location": "620/TALK"    , "narrator": "ガブリエラ", "text": "もういいわ。\n本当にデリカシーが\n無いんだから。"},
        { "location": "622/SEL"     , "narrator": "（選択肢）", "text": "アーヤはガブリエラを信頼してるよ"},
        { "location": "623/ACT"     , "narrator": "", "text": "アーヤはガブリエラを信頼してるよ"},
        { "location": "626/TALK"    , "narrator": "ガブリエラ", "text": "どうしてそう\n言い切れるの？"},
        { "location": "627/TALK"    , "narrator": "ガブリエラ", "text": "そんなの……\n分からないじゃない。"},
        { "location": "628/SEL"     , "narrator": "（選択肢）", "text": "言葉にするよう、アーヤに言っておく"},
        { "location": "629/ACT"     , "narrator": "", "text": "言葉にするよう、アーヤに言っておく"},
        { "location": "631/TALK"    , "narrator": "ガブリエラ", "text": "ほんと？"},
        { "location": "632/TALK"    , "narrator": "ガブリエラ", "text": "あ、でも……"},
        { "location": "633/TALK"    , "narrator": "ガブリエラ", "text": "無理矢理言わせる\nとかはやめてよね。"},
        { "location": "634/TALK"    , "narrator": "ガブリエラ", "text": "かえって傷つくから…。"},
        { "location": "635/SEL"     , "narrator": "（選択肢）", "text": "それはしないよ"},
        { "location": "636/ACT"     , "narrator": "", "text": "それはしないよ"},
        { "location": "638/TALK"    , "narrator": "ガブリエラ", "text": "ならいいけど。"},
        { "location": "639/SEL"     , "narrator": "（選択肢）", "text": "$me$も認めてるよ"},
        { "location": "640/ACT"     , "narrator": "", "text": "$me$も認めてるよ"},
        { "location": "642/TALK"    , "narrator": "ガブリエラ", "text": "…べつに\n$handle$は\nどうでもいいのよ…。"},
        { "location": "647/DIALOG"  , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "659/TALK"    , "narrator": "ガブリエラ", "text": "えっ…！？"},
        { "location": "661/TALK"    , "narrator": "ガブリエラ", "text": "撫でてくれたの？"},
        { "location": "662/SEL"     , "narrator": "（選択肢）", "text": "応援してるよ"},
        { "location": "663/ACT"     , "narrator": "", "text": "応援してるよ"},
        { "location": "665/TALK"    , "narrator": "ガブリエラ", "text": "……あ…"},
        { "location": "666/TALK"    , "narrator": "ガブリエラ", "text": "…ありがと。"},
        { "location": "667/TALK"    , "narrator": "ガブリエラ", "text": "嬉しいっていう\nわけじゃないけど――"},
        { "location": "668/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと\n落ち着いたかも…。"},
        { "location": "672/TALK"    , "narrator": "ガブリエラ", "text": "えっ…！？"},
        { "location": "673/SEL"     , "narrator": "（選択肢）", "text": "がんばれ！"},
        { "location": "674/ACT"     , "narrator": "", "text": "がんばれ！"},
        { "location": "676/TALK"    , "narrator": "ガブリエラ", "text": "……あ…"},
        { "location": "677/TALK"    , "narrator": "ガブリエラ", "text": "…ありがと。"},
        { "location": "678/TALK"    , "narrator": "ガブリエラ", "text": "嬉しいっていう\nわけじゃないけど――"},
        { "location": "679/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと\n落ち着いたかも…。"},
        { "location": "683/TALK"    , "narrator": "ガブリエラ", "text": "きゃああっ！"},
        { "location": "684/SEL"     , "narrator": "（選択肢）", "text": "応援してる（キラッ"},
        { "location": "685/ACT"     , "narrator": "", "text": "応援してる（キラッ"},
        { "location": "687/TALK"    , "narrator": "ガブリエラ", "text": "キラッ！\nじゃないでしょ！"},
        { "location": "688/TALK"    , "narrator": "ガブリエラ", "text": "普通頭撫でたり\nするものでしょ！？"},
        { "location": "689/TALK"    , "narrator": "ガブリエラ", "text": "ま、まあ、\n気持ちは……\n有り難いけど…。"},
        { "location": "690/TALK"    , "narrator": "ガブリエラ", "text": "で、でも！\n次は許さないから！"},
        { "location": "694/TALK"    , "narrator": "ガブリエラ", "text": "きゃああっ！"},
        { "location": "695/SEL"     , "narrator": "（選択肢）", "text": "がんばれっ（キラッ"},
        { "location": "696/ACT"     , "narrator": "", "text": "がんばれっ（キラッ"},
        { "location": "698/TALK"    , "narrator": "ガブリエラ", "text": "キラッ！\nじゃないでしょ！"},
        { "location": "699/TALK"    , "narrator": "ガブリエラ", "text": "普通頭撫でたり\nするものでしょ！？"},
        { "location": "700/TALK"    , "narrator": "ガブリエラ", "text": "ま、まあ、\n気持ちは……\n有り難いけど…。"},
        { "location": "701/TALK"    , "narrator": "ガブリエラ", "text": "で、でも！\n次は許さないから！"},
        { "location": "705/DIALOG"  , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "707/TALK"    , "narrator": "ガブリエラ", "text": "…っと、とにかく！"},
        { "location": "708/TALK"    , "narrator": "ガブリエラ", "text": "今回はあんたを\n信用して、かけてみる\nことにするわ。"},
        { "location": "711/TALK"    , "narrator": "ガブリエラ", "text": "本当にアーヤが\nあたしのことを\n必要としてるか――"},
        { "location": "712/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんと\n証明して頂戴よね？"},
        { "location": "713/SEL"     , "narrator": "（選択肢）", "text": "まかせとけ！"},
        { "location": "714/SEL"     , "narrator": "（選択肢）", "text": "でもどうしてそんなにアーヤに認められたいの？"},
        { "location": "715/ACT"     , "narrator": "", "text": "まかせとけ！"},
        { "location": "717/TALK"    , "narrator": "ガブリエラ", "text": "ほんとに、調子だけは\nいいんだから。"},
        { "location": "718/ACT"     , "narrator": "", "text": "でもどうしてそんなにアーヤに認められたいの？"},
        { "location": "721/TALK"    , "narrator": "ガブリエラ", "text": "どうして、って！\nそんなの……"},
        { "location": "722/TALK"    , "narrator": "ガブリエラ", "text": "……あら…\nどうして…かしら。"},
        { "location": "723/TALK"    , "narrator": "ガブリエラ", "text": "そういえば、なんで\nアーヤだけが\n気になるのか――"},
        { "location": "724/TALK"    , "narrator": "ガブリエラ", "text": "考えた事無かったわ。"},
        { "location": "725/SEL"     , "narrator": "（選択肢）", "text": "アーヤラヴだからだ"},
        { "location": "726/SEL"     , "narrator": "（選択肢）", "text": "過去に何かあった？"},
        { "location": "727/ACT"     , "narrator": "", "text": "アーヤラヴだからだ"},
        { "location": "728/TALK"    , "narrator": "ガブリエラ", "text": "ち！　違うわよ！"},
        { "location": "729/TALK"    , "narrator": "ガブリエラ", "text": "さあ、もうお話は\n終わったでしょ？"},
        { "location": "730/TALK"    , "narrator": "ガブリエラ", "text": "早く現実に戻って\nアーヤの気持ちを\n確認してきて！"},
        { "location": "731/ACT"     , "narrator": "", "text": "過去に何かあった？"},
        { "location": "732/TALK"    , "narrator": "ガブリエラ", "text": "うーん……\nわからない。"},
        { "location": "733/TALK"    , "narrator": "ガブリエラ", "text": "でもきっと、今の\nあたしではその\n本質は分からないかも。"},
        { "location": "734/TALK"    , "narrator": "ガブリエラ", "text": "ごめんなさい。"},
        { "location": "735/TALK"    , "narrator": "ガブリエラ", "text": "とにかく。"},
        { "location": "736/TALK"    , "narrator": "ガブリエラ", "text": "アーヤの本心の件は\nあんたに任せたから。"},
        { "location": "739/TALK"    , "narrator": "ガブリエラ", "text": "よろしく頼むわね。"}
