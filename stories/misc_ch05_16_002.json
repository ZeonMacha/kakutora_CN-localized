        { "location": "4838/SCENARIO", "narrator": "", "text": "花とアンティーク"},
        { "location": "4863/TALK"    , "narrator": "神楽", "text": "ウッドテイストの室内に花を飾って"},
        { "location": "4864/TALK"    , "narrator": "神楽", "text": "ナッツとフルーツのパウンドケーキにカモミールティー"},
        { "location": "4865/TALK"    , "narrator": "神楽", "text": "アンティークなワンピースで気だるい午後"},
        { "location": "4867/SEL"     , "narrator": "", "text": "$me$との愛の時間だね"},
        { "location": "4868/SEL"     , "narrator": "", "text": "なんかの撮影？"},
        { "location": "4869/SEL"     , "narrator": "", "text": "いいふいんきだね"},
        { "location": "4870/ACT"     , "narrator": "", "text": "$me$との愛の時間だね"},
        { "location": "4872/TALK"    , "narrator": "神楽", "text": "そう思ってくれてもいいかも"},
        { "location": "4874/TALK"    , "narrator": "神楽", "text": "パウンドケーキはどこのがいい？"},
        { "location": "4875/TALK"    , "narrator": "神楽", "text": "$handlek$のリクエストに応えるぴょん"},
        { "location": "4877/SEL"     , "narrator": "", "text": "神楽の手作り"},
        { "location": "4878/SEL"     , "narrator": "", "text": "デパ地下の"},
        { "location": "4879/SEL"     , "narrator": "", "text": "代官山のパティスリー"},
        { "location": "4880/ACT"     , "narrator": "", "text": "神楽の手作り"},
        { "location": "4881/TALK"    , "narrator": "神楽", "text": "それはないかな"},
        { "location": "4882/TALK"    , "narrator": "神楽", "text": "だってケーキとパンは本職の人が作った方が絶対おいしいから"},
        { "location": "4883/TALK"    , "narrator": "神楽", "text": "そういうわけだから諦めて☆彡"},
        { "location": "4884/ACT"     , "narrator": "", "text": "デパ地下の"},
        { "location": "4885/TALK"    , "narrator": "神楽", "text": "あーそういえばいいと思ってー"},
        { "location": "4886/TALK"    , "narrator": "神楽", "text": "でもそうしよっか♪"},
        { "location": "4887/ACT"     , "narrator": "", "text": "代官山のパティスリー"},
        { "location": "4888/TALK"    , "narrator": "神楽", "text": "微妙に乗り換えが面倒なところを言ってきた子ちゃん"},
        { "location": "4889/TALK"    , "narrator": "神楽", "text": "でもよさげなのがありそ"},
        { "location": "4890/TALK"    , "narrator": "神楽", "text": "じゃあ買ってきてー"},
        { "location": "4891/TALK"    , "narrator": "神楽", "text": "よろしくね"},
        { "location": "4893/ACT"     , "narrator": "", "text": "なんかの撮影？"},
        { "location": "4894/TALK"    , "narrator": "神楽", "text": "それもいいかも？"},
        { "location": "4895/TALK"    , "narrator": "神楽", "text": "でも何のかは謎のまま♪"},
        { "location": "4896/ACT"     , "narrator": "", "text": "いいふいんきだね"},
        { "location": "4897/TALK"    , "narrator": "神楽", "text": "ふんいきでしょ"},
        { "location": "4898/TALK"    , "narrator": "神楽", "text": "ふんいき！"},
        { "location": "4899/TALK"    , "narrator": "神楽", "text": "それともわざと？"},
        { "location": "4901/TALK"    , "narrator": "神楽", "text": "だったらいっか"}
