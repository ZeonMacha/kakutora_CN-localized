        "title": "らぶとーく  第59話",
        "sub_title": "わがままなんて言ってない"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "わがままなんて言ってない"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "うそ…何でないの？"},
        { "location": "25/TALK"   , "narrator": "ガブリエラ", "text": "確かにちゃんと\nしまったはずなのに…。"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "私の生徒手帳知らない？"},
        { "location": "40/SEL"    , "narrator": "", "text": "知らないけど、どうして？"},
        { "location": "41/ACT"    , "narrator": "", "text": "知らないけど、どうして？"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "今気が付いたらなかったの"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "朝はちゃんと持ってたのに"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "どこやっちゃったのかしら？"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…とりあえず、\nもう一度鞄の中を…。"},
        { "location": "59/TALK"   , "narrator": "男子高校生Ａ", "text": "ねえ、君。"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "64/TALK"   , "narrator": "男子高校生Ａ", "text": "君、ガブリエラさんで\n良いんだよね？"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "…だ、誰、この人？\n知らないんだけど…。"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "68/TALK"   , "narrator": "男子高校生Ａ", "text": "いや、そんなに\n警戒しなくても…。"},
        { "location": "70/TALK"   , "narrator": "男子高校生Ａ", "text": "ほら、この生徒手帳って\n君のだろ？"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "っ！！"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "あたしの生徒手帳！？\nどうしてこの人が…。"},
        { "location": "74/TALK"   , "narrator": "男子高校生Ａ", "text": "今朝登校した時、\n校門の前で拾ってさ。"},
        { "location": "75/TALK"   , "narrator": "男子高校生Ａ", "text": "すぐ届けたかったん\nだけど、中々中等部まで\n来れなくてね。"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "…そういえば、忘れ物\nした気がして――"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "校門の前で鞄の中を\n探ったような…。"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "そっか。\nあの時落としたんだ…。"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "84/TALK"   , "narrator": "男子高校生Ａ", "text": "え、えっと…。"},
        { "location": "86/TALK"   , "narrator": "男子高校生Ａ", "text": "な、中を見たりは\nしてないよ？"},
        { "location": "87/TALK"   , "narrator": "男子高校生Ａ", "text": "一ページ目の名前と\nクラスが書いてあるとこ\n以外見てないから…。"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "いや、別に見られても\n大したこと書いてないん\nだけど…。"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、\nお礼言わないと！"},
        { "location": "92/TALK"   , "narrator": "男子高校生Ａ", "text": "ほ、本当だから！\nてか、そんな睨まないで\nくれよ…。"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "95/TALK"   , "narrator": "男子高校生Ａ", "text": "あ、いや…ごめん！\nそれじゃ！！"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "あっ…。"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "…そんな…睨んでなんか\nいないのに…。"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "最低なことしちゃったかも"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "せっかく親切にしてくれた人なのに"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "お礼も言えなかったし"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "しかも"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "睨んでると思われたし"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "クラスの子達にもまた怖い子だって誤解されたと思う"},
        { "location": "122/SEL"   , "narrator": "", "text": "ドンマイ"},
        { "location": "123/ACT"   , "narrator": "", "text": "ドンマイ"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "ドンマイじゃない！"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "そもそも"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "$handle$が隣にいてくれないのが悪いのよ！"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "$handle$が隣にいたらこんな風にはならないのに"},
        { "location": "131/SEL"   , "narrator": "", "text": "スマイル、スマイル"},
        { "location": "132/SEL"   , "narrator": "", "text": "ごめんね、側にいられなくて"},
        { "location": "133/SEL"   , "narrator": "", "text": "かわいいから大丈夫だよ"},
        { "location": "134/ACT"   , "narrator": "", "text": "スマイル、スマイル"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "人の気も知らないで！"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "それが出来ないから困ってるのに！"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "$handle$がいてくれればいくらでも笑えるんだから"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "そう言うなら私のところに来てよ！"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "バカ！"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "や、八つ当たりじゃ\nないわよね？"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "そうよ。\nあいつが隣にいてくれ\nないのが悪いんだから！"},
        { "location": "155/ACT"   , "narrator": "", "text": "ごめんね、側にいられなくて"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "違うの"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "そうじゃなくて"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "私の方こそごめんなさい"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "$handle$が隣にいないのは悪いことだから"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "それは謝らないから！"},
        { "location": "174/ACT"   , "narrator": "", "text": "かわいいから大丈夫だよ"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "理由になってないから"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "そもそも"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "可愛いって言ってくれるの$handle$だけだから"},
        { "location": "178/TALK"  , "narrator": "ガブリエラ", "text": "まったく信用できないわ"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "っていうか"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "本当に可愛いって思ってるなら"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "私の隣に来なさいよ！"},
        { "location": "16/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　 0:25 PM</color>\nとある平日の昼休み、付属学園中等部ガブリエラの教室にて"}
    ]
}
