        "title": "らぶとーく  第68話",
        "sub_title": "身の程知らず"
    },
    "entry":
    [
        { "location": "167/SCENARIO", "narrator": "", "text": "身の程知らず"},
        { "location": "185/TALK"    , "narrator": "先生", "text": "ガブリエラさん。\nちょっといいかしら？"},
        { "location": "187/TALK"    , "narrator": "ガブリエラ", "text": "はい、何ですか？"},
        { "location": "188/TALK"    , "narrator": "先生", "text": "あなたの書いた詩、\n読ませてもらったわ。"},
        { "location": "189/TALK"    , "narrator": "ガブリエラ", "text": "ああ、授業で提出した\nやつですか？"},
        { "location": "190/TALK"    , "narrator": "先生", "text": "ええ。"},
        { "location": "191/TALK"    , "narrator": "先生", "text": "正直、凄く驚いたわ。"},
        { "location": "192/TALK"    , "narrator": "先生", "text": "今まで色んな生徒が\n書いた詩を見てきた\nけど――"},
        { "location": "193/TALK"    , "narrator": "先生", "text": "あんなに素晴らしい詩を\n読んだのは初めてだった\nから。"},
        { "location": "195/TALK"    , "narrator": "ガブリエラ", "text": "えっ…そ、そうですか？"},
        { "location": "196/TALK"    , "narrator": "先生", "text": "ええ、\n本当に良かったわ。"},
        { "location": "197/TALK"    , "narrator": "先生", "text": "あんなに素敵なのが\n読めるなら――"},
        { "location": "198/TALK"    , "narrator": "先生", "text": "次の宿題も、詩の作成に\nしちゃおうかしら？"},
        { "location": "201/TALK"    , "narrator": "ガブリエラ", "text": "そ、それはちょっと…\nあたしも詩を作るのに\n慣れてませんし…。"},
        { "location": "202/TALK"    , "narrator": "先生", "text": "ふふっ、冗談よ。"},
        { "location": "203/TALK"    , "narrator": "先生", "text": "とにかく、本当に\n素敵な詩だったわ。"},
        { "location": "204/TALK"    , "narrator": "先生", "text": "もし他にも書くことが\nあったら――"},
        { "location": "205/TALK"    , "narrator": "先生", "text": "その時は先生にも\n読ませてね。"},
        { "location": "207/SEL"     , "narrator": "", "text": "おーい"},
        { "location": "212/ACT"     , "narrator": "", "text": "おーい"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "聞いてたの？"},
        { "location": "222/SEL"     , "narrator": "", "text": "やったね"},
        { "location": "223/SEL"     , "narrator": "", "text": "褒め上手な先生だね"},
        { "location": "224/SEL"     , "narrator": "", "text": "もっと書いてみれば"},
        { "location": "225/ACT"     , "narrator": "", "text": "やったね"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "別に"},
        { "location": "227/TALK"    , "narrator": "ガブリエラ", "text": "日本語で詩が書けるなんて凄いってことでしょ？"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "喜ぶようなことじゃないわ"},
        { "location": "230/SEL"     , "narrator": "", "text": "そんな感じじゃなかったよ"},
        { "location": "231/ACT"     , "narrator": "", "text": "そんな感じじゃなかったよ"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "じゃあお世辞ね"},
        { "location": "234/TALK"    , "narrator": "ガブリエラ", "text": "そうとしか思えないわ"},
        { "location": "236/SEL"     , "narrator": "", "text": "素直になりなよ"},
        { "location": "237/ACT"     , "narrator": "", "text": "素直になりなよ"},
        { "location": "239/TALK"    , "narrator": "ガブリエラ", "text": "何よそれ？"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "私が素直じゃないって言うの！？"},
        { "location": "241/TALK"    , "narrator": "ガブリエラ", "text": "私はいつだって素直よ"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "$handle$だってわかってるでしょ？"},
        { "location": "244/SEL"     , "narrator": "", "text": "$me$は凄い嬉しいよ"},
        { "location": "245/ACT"     , "narrator": "", "text": "$me$は凄い嬉しいよ"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "そうなの？"},
        { "location": "248/TALK"    , "narrator": "ガブリエラ", "text": "そっか"},
        { "location": "249/TALK"    , "narrator": "ガブリエラ", "text": "$handle$は嬉しいって思ってくれるのね"},
        { "location": "250/TALK"    , "narrator": "ガブリエラ", "text": "それならまあ"},
        { "location": "251/TALK"    , "narrator": "ガブリエラ", "text": "私も少しくらいは嬉しいと思ってもいいわ"},
        { "location": "252/TALK"    , "narrator": "ガブリエラ", "text": "本当に少しだけね"},
        { "location": "253/ACT"     , "narrator": "", "text": "褒め上手な先生だね"},
        { "location": "254/TALK"    , "narrator": "ガブリエラ", "text": "何でそうなるのよ？"},
        { "location": "256/TALK"    , "narrator": "ガブリエラ", "text": "どう考えても私の詩に感動してたじゃない！"},
        { "location": "257/TALK"    , "narrator": "ガブリエラ", "text": "私の詩は本当に出来が良かったのよ"},
        { "location": "258/TALK"    , "narrator": "ガブリエラ", "text": "…多分"},
        { "location": "259/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "260/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、褒め上手なだけなのかしら？"},
        { "location": "262/SEL"     , "narrator": "", "text": "冗談だよ、もっと自信持って"},
        { "location": "263/ACT"     , "narrator": "", "text": "冗談だよ、もっと自信持って"},
        { "location": "265/TALK"    , "narrator": "ガブリエラ", "text": "$handle$は冗談のセンスがないわ"},
        { "location": "266/TALK"    , "narrator": "ガブリエラ", "text": "っていうかイジワル？"},
        { "location": "268/SEL"     , "narrator": "", "text": "ごめん"},
        { "location": "269/ACT"     , "narrator": "", "text": "ごめん"},
        { "location": "271/TALK"    , "narrator": "ガブリエラ", "text": "冗談よ"},
        { "location": "273/TALK"    , "narrator": "ガブリエラ", "text": "まあ、$handle$の言う通り"},
        { "location": "274/TALK"    , "narrator": "ガブリエラ", "text": "少し自信を持った方がいいかもしれないわね"},
        { "location": "275/ACT"     , "narrator": "", "text": "もっと書いてみれば"},
        { "location": "276/TALK"    , "narrator": "ガブリエラ", "text": "言われなくても書くわよ"},
        { "location": "277/TALK"    , "narrator": "ガブリエラ", "text": "詩は得意じゃないから"},
        { "location": "278/TALK"    , "narrator": "ガブリエラ", "text": "もっと勉強しようと思ってたし"},
        { "location": "280/SEL"     , "narrator": "", "text": "$me$も読んでみたいな"},
        { "location": "281/ACT"     , "narrator": "", "text": "$me$も読んでみたいな"},
        { "location": "283/TALK"    , "narrator": "ガブリエラ", "text": "調子いいんだから"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "勉強中だから見せられるようなものじゃないし"},
        { "location": "285/TALK"    , "narrator": "ガブリエラ", "text": "出来が悪いかもしれないわよ？"},
        { "location": "287/SEL"     , "narrator": "", "text": "ガブリエラなら大丈夫"},
        { "location": "288/ACT"     , "narrator": "", "text": "ガブリエラなら大丈夫"},
        { "location": "290/TALK"    , "narrator": "ガブリエラ", "text": "本当調子良過ぎだから"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "っていうかわざとらしいし"},
        { "location": "292/TALK"    , "narrator": "ガブリエラ", "text": "けど"},
        { "location": "294/TALK"    , "narrator": "ガブリエラ", "text": "そこまで期待されてるなら頑張るわ"},
        { "location": "300/TALK"    , "narrator": "ガブリエラ", "text": "…あたしの詩、\n良かったんだ…。"},
        { "location": "301/TALK"    , "narrator": "ガブリエラ", "text": "$handle$にも褒めて\nもらえたし…。"},
        { "location": "302/TALK"    , "narrator": "ガブリエラ", "text": "ふふっ…ちょっと\n本気で勉強して\nみようかしら？"},
        { "location": "174/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　 0:16 PM</color>\nとある平日の昼休み、付属学園食堂でのこと"}
    ]
}
