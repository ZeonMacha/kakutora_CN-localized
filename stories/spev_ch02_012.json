{
    "dir": "chap00/daydra/spev_ch02_012.js",
    "type": "",
    "info": {
        "story_id": "2012",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "星空ツーリング"
    },
    "entry":
    [
        { "location": "26/TALK" , "narrator": "透明アーヤ", "text": "やっぱり、空の散歩は\n夜が一番ね。"},
        { "location": "27/TALK" , "narrator": "透明アーヤ", "text": "月明かりが優しいし、\n見下ろす街の灯りも\n綺麗だし。"},
        { "location": "28/TALK" , "narrator": "透明アーヤ", "text": "$handle$も\nそう思うでしょ？"},
        { "location": "29/SEL"  , "narrator": "（選択肢）", "text": "ホウキに乗せてください"},
        { "location": "30/ACT"  , "narrator": "", "text": "ホウキに乗せてください"},
        { "location": "32/TALK" , "narrator": "透明アーヤ", "text": "残念だけど、このホウキは\n一人用なのよ。"},
        { "location": "33/TALK" , "narrator": "透明アーヤ", "text": "でも、私の魔法で\n浮かせてあげてるんだから\n問題ないでしょ？"},
        { "location": "34/SEL"  , "narrator": "（選択肢）", "text": "魔法で浮いてたのか…"},
        { "location": "35/SEL"  , "narrator": "（選択肢）", "text": "アーヤとくっつきたかった！"},
        { "location": "36/ACT"  , "narrator": "", "text": "魔法で浮いてたのか…"},
        { "location": "39/TALK" , "narrator": "透明アーヤ", "text": "今更！？"},
        { "location": "40/TALK" , "narrator": "透明アーヤ", "text": "今の今まで、\nどうやって浮いてると\n思ってたんだか…。"},
        { "location": "41/ACT"  , "narrator": "", "text": "アーヤとくっつきたかった！"},
        { "location": "43/TALK" , "narrator": "透明アーヤ", "text": "あ、あのね…。\n変なこと考えてるでしょ？"},
        { "location": "44/TALK" , "narrator": "透明アーヤ", "text": "これでも、ホウキで\n飛ぶのって集中力が\nいるの。"},
        { "location": "45/TALK" , "narrator": "透明アーヤ", "text": "だから二人乗りは\nちょっと無理ね。\n集中が乱れそうだし。"},
        { "location": "48/TALK" , "narrator": "透明アーヤ", "text": "それにしても、\n今日は風が気持ちいいわ。"},
        { "location": "49/TALK" , "narrator": "透明アーヤ", "text": "昨日は湿気がすごくて、\n戻ったときはびしょ濡れに\nなってたのよ。"},
        { "location": "50/TALK" , "narrator": "透明アーヤ", "text": "タイミングよく\nいい日に当たって\nよかったわね。"},
        { "location": "51/SEL"  , "narrator": "（選択肢）", "text": "悪天候の空も飛んでみたい"},
        { "location": "52/SEL"  , "narrator": "（選択肢）", "text": "アーヤと一緒なら天候は関係ない"},
        { "location": "53/ACT"  , "narrator": "", "text": "悪天候の空も飛んでみたい"},
        { "location": "55/TALK" , "narrator": "透明アーヤ", "text": "バカなこと言わないの。"},
        { "location": "56/TALK" , "narrator": "透明アーヤ", "text": "空を飛ぶ上で天候は\n一番気にかけないと\nいけないことなのよ？"},
        { "location": "57/TALK" , "narrator": "透明アーヤ", "text": "私も雨の日に飛んだら、\n雷に打たれて死にそうに\nなったことあったし…。"},
        { "location": "58/ACT"  , "narrator": "", "text": "アーヤと一緒なら天候は関係ない"},
        { "location": "60/TALK" , "narrator": "透明アーヤ", "text": "ふふっ、そう言って\nくれるのは嬉しいけど…。"},
        { "location": "61/TALK" , "narrator": "透明アーヤ", "text": "でも、せっかく飛ぶなら\nいい天気の方が\n気持ちよくていいわよ？"},
        { "location": "63/TALK" , "narrator": "透明アーヤ", "text": "それに、酷いときだと\n雷に打たれることも\nあるんだし…。"},
        { "location": "65/SEL"  , "narrator": "（選択肢）", "text": "打たれたことあるの？"},
        { "location": "66/ACT"  , "narrator": "", "text": "打たれたことあるの？"},
        { "location": "69/TALK" , "narrator": "透明アーヤ", "text": "そりゃね。\n魔女なら誰でも一度は\nあるんじゃないかしら？"},
        { "location": "70/TALK" , "narrator": "透明アーヤ", "text": "まあ、ホウキの周りに\n障壁張ってるから、\n打たれても平気だけど。"},
        { "location": "71/TALK" , "narrator": "透明アーヤ", "text": "…あ、いけない。\n$handle$に障壁\n張るの忘れてた。"},
        { "location": "72/SEL"  , "narrator": "（選択肢）", "text": "晴れてるから平気だよ"},
        { "location": "73/ACT"  , "narrator": "", "text": "晴れてるから平気だよ"},
        { "location": "76/TALK" , "narrator": "透明アーヤ", "text": "油断するのはよくないと\n思うけど？"},
        { "location": "77/TALK" , "narrator": "透明アーヤ", "text": "空飛んでるとね、\n本当色んな危険なことが\nあるんだから。"},
        { "location": "78/TALK" , "narrator": "透明アーヤ", "text": "地上から、未確認飛行物体\n扱いされて打たれることも\nあるし…。"},
        { "location": "79/TALK" , "narrator": "透明アーヤ", "text": "障害物もないから、\n居眠りしそうになることも\n結構あるし。"},
        { "location": "80/TALK" , "narrator": "透明アーヤ", "text": "…改めて思うと、\n空を飛ぶのって\n危険なことばかりだわ。"},
        { "location": "81/SEL"  , "narrator": "（選択肢）", "text": "それでも飛ぶんだ？"},
        { "location": "82/ACT"  , "narrator": "", "text": "それでも飛ぶんだ？"},
        { "location": "84/TALK" , "narrator": "透明アーヤ", "text": "そりゃそうよ。"},
        { "location": "85/TALK" , "narrator": "透明アーヤ", "text": "空飛ばない魔女なんて\n聞いたことないわ。"},
        { "location": "86/TALK" , "narrator": "透明アーヤ", "text": "それに、このホウキだって\nまだローン残ってるん\nだから…。"},
        { "location": "87/TALK" , "narrator": "透明アーヤ", "text": "…魔女用のホウキって、\nすっごく高いのよ？"},
        { "location": "90/TALK" , "narrator": "透明アーヤ", "text": "ま、それはそうと、\nそろそろ聞かせて\nもらえない？"},
        { "location": "91/TALK" , "narrator": "透明アーヤ", "text": "空を飛んでる気分は、\nどんな感じ？"},
        { "location": "92/SEL"  , "narrator": "（選択肢）", "text": "最高だよ"},
        { "location": "93/SEL"  , "narrator": "（選択肢）", "text": "ちょっと怖いかも"},
        { "location": "94/ACT"  , "narrator": "", "text": "最高だよ"},
        { "location": "95/TALK" , "narrator": "透明アーヤ", "text": "よかった…。"},
        { "location": "96/TALK" , "narrator": "透明アーヤ", "text": "喜んでもらえたなら、\n誘った甲斐があったわ。"},
        { "location": "97/TALK" , "narrator": "透明アーヤ", "text": "高いところ苦手だったら\nどうしようかと\n思ってたの。"},
        { "location": "98/ACT"  , "narrator": "", "text": "ちょっと怖いかも"},
        { "location": "99/TALK" , "narrator": "透明アーヤ", "text": "あはは、もしかして\n高所恐怖症？"},
        { "location": "100/TALK", "narrator": "透明アーヤ", "text": "大丈夫よ。\nそんな怖がらなくても\n落ちたりしないから。"},
        { "location": "102/TALK", "narrator": "透明アーヤ", "text": "さてと、せっかくだし、\nもう少し高度上げよう\nかしら？"},
        { "location": "103/TALK", "narrator": "透明アーヤ", "text": "思い切って、\n雲の上まで行きましょ。"},
        { "location": "112/TALK", "narrator": "透明アーヤ", "text": "きゃっ！？"},
        { "location": "117/TALK", "narrator": "透明アーヤ", "text": "あっ、いけない！"},
        { "location": "122/TALK", "narrator": "透明アーヤ", "text": "ふぅ…危なかった。\nごめんなさい、\n驚かせちゃった？"},
        { "location": "123/SEL" , "narrator": "（選択肢）", "text": "今のなに！？　どうしたの！？"},
        { "location": "124/ACT" , "narrator": "", "text": "今のなに！？　どうしたの！？"},
        { "location": "128/TALK", "narrator": "透明アーヤ", "text": "あ、あはは…突風に驚いて\n集中が切れちゃって…。"},
        { "location": "129/TALK", "narrator": "透明アーヤ", "text": "$handle$にかけた\n魔法が、ほんの一瞬だけ\n切れちゃったのよ。"},
        { "location": "130/TALK", "narrator": "透明アーヤ", "text": "でも、もう大丈夫。\nすぐにかけ直したから\n心配無用よ。"},
        { "location": "131/SEL" , "narrator": "（選択肢）", "text": "本当に大丈夫なの？"},
        { "location": "132/SEL" , "narrator": "（選択肢）", "text": "もう帰りたい…"},
        { "location": "133/ACT" , "narrator": "", "text": "本当に大丈夫なの？"},
        { "location": "134/TALK", "narrator": "透明アーヤ", "text": "だ、大丈夫よ！\n私を信じて。"},
        { "location": "135/ACT" , "narrator": "", "text": "もう帰りたい…"},
        { "location": "137/TALK", "narrator": "透明アーヤ", "text": "ご、ごめんなさい。\n怖かったわよね？"},
        { "location": "138/TALK", "narrator": "透明アーヤ", "text": "お詫びに、雲の上の\n綺麗な景色を見せるから、\nそれで許して。"},
        { "location": "141/TALK", "narrator": "透明アーヤ", "text": "それじゃ今度こそ、\n高度上げるわよ！"}
    ]
}
