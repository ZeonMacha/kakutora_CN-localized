{
    "dir": "chap00/daydra/spev_ch01_009.js",
    "type": "",
    "info": {
        "story_id": "1009",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "完成！つばめ城"
    },
    "entry":
    [
        { "location": "32/TALK" , "narrator": "透明つばめ", "text": "うーん…もう一本くらい\n塔を追加しようかな？"},
        { "location": "33/TALK" , "narrator": "透明つばめ", "text": "でも、あまり手を加えて\n途中で失敗したら\n困るし…。"},
        { "location": "34/TALK" , "narrator": "透明つばめ", "text": "うーん…。"},
        { "location": "35/SEL"  , "narrator": "（選択肢）", "text": "なにをやってるの？"},
        { "location": "36/ACT"  , "narrator": "", "text": "なにをやってるの？"},
        { "location": "38/TALK" , "narrator": "透明つばめ", "text": "あ、今ね、砂のお城を\n作ってるところなの！"},
        { "location": "39/TALK" , "narrator": "透明つばめ", "text": "わたしとしては、\nもう少し大きくしたいと\n思ってるんだけど…。"},
        { "location": "41/TALK" , "narrator": "透明つばめ", "text": "途中で失敗するのが\n怖くて…。"},
        { "location": "42/SEL"  , "narrator": "（選択肢）", "text": "精神世界だから心配無用！"},
        { "location": "43/SEL"  , "narrator": "（選択肢）", "text": "ここまで作れたんだから大丈夫"},
        { "location": "44/ACT"  , "narrator": "", "text": "精神世界だから心配無用！"},
        { "location": "45/TALK" , "narrator": "透明つばめ", "text": "そっか、精神世界だから\nやり直したいって思えば\n途中からやり直せるんだ？"},
        { "location": "46/TALK" , "narrator": "透明つばめ", "text": "ありがたくいけど…、\nそれってちょっと\n達成感なさそうだし…。"},
        { "location": "48/TALK" , "narrator": "透明つばめ", "text": "壊さないように\n頑張ってみるよ。"},
        { "location": "49/ACT"  , "narrator": "", "text": "ここまで作れたんだから大丈夫"},
        { "location": "51/TALK" , "narrator": "透明つばめ", "text": "そっか…ここまでは\n失敗せずに作れたん\nだし…。"},
        { "location": "52/TALK" , "narrator": "透明つばめ", "text": "あとちょっとくらい、\nどうにかなるよね！"},
        { "location": "54/TALK" , "narrator": "透明つばめ", "text": "それじゃあ、もう一本の\n塔は、この辺にして…。"},
        { "location": "55/TALK" , "narrator": "透明つばめ", "text": "そーっと、そーっと…。"},
        { "location": "56/TALK" , "narrator": "透明つばめ", "text": "よし、あとは指先で\n形を整えれば…。"},
        { "location": "58/TALK" , "narrator": "透明つばめ", "text": "で、できたーっ！！\n砂のお城、完成だよ！"},
        { "location": "59/SEL"  , "narrator": "（選択肢）", "text": "わーっ、完成おめでとう！"},
        { "location": "60/SEL"  , "narrator": "（選択肢）", "text": "つばめ城だね"},
        { "location": "61/ACT"  , "narrator": "", "text": "わーっ、完成おめでとう！"},
        { "location": "62/TALK" , "narrator": "透明つばめ", "text": "ありがとう！"},
        { "location": "63/TALK" , "narrator": "透明つばめ", "text": "えへへ、初めてだから\nちゃんとできるかなー\nって心配だったけど…。"},
        { "location": "64/TALK" , "narrator": "透明つばめ", "text": "思ってたよりも\nかっこいいのが\n作れたよ。"},
        { "location": "65/ACT"  , "narrator": "", "text": "つばめ城だね"},
        { "location": "68/TALK" , "narrator": "透明つばめ", "text": "えぇっ！！\nわたしの名前が付くの！？"},
        { "location": "69/SEL"  , "narrator": "（選択肢）", "text": "つばめの城だからね"},
        { "location": "70/SEL"  , "narrator": "（選択肢）", "text": "ガブリエラ城じゃ変でしょ？"},
        { "location": "71/ACT"  , "narrator": "", "text": "つばめの城だからね"},
        { "location": "73/TALK" , "narrator": "透明つばめ", "text": "そっか…。"},
        { "location": "74/TALK" , "narrator": "透明つばめ", "text": "えへへ、嬉しいけど、\nちょっとだけ\n照れくさいかも…。"},
        { "location": "75/ACT"  , "narrator": "", "text": "ガブリエラ城じゃ変でしょ？"},
        { "location": "76/TALK" , "narrator": "透明つばめ", "text": "そ、それは違うよ！\nわたしが作った\nお城なんだから…。"},
        { "location": "78/TALK" , "narrator": "透明つばめ", "text": "…そっか。\nじゃあやっぱり、\nこのお城はつばめ城だね。"},
        { "location": "81/TALK" , "narrator": "透明つばめ", "text": "でも、いいなぁ…。"},
        { "location": "82/TALK" , "narrator": "透明つばめ", "text": "これは砂のお城だけど、\n本当にこういう形の\nお城があって…。"},
        { "location": "83/TALK" , "narrator": "透明つばめ", "text": "そこにみんなで住めたら、\n楽しそうだなぁ…。"},
        { "location": "84/SEL"  , "narrator": "（選択肢）", "text": "それ、絶対楽しいヤツだ"},
        { "location": "85/SEL"  , "narrator": "（選択肢）", "text": "$me$も一緒に住みたいな"},
        { "location": "86/SEL"  , "narrator": "（選択肢）", "text": "そんなのダメだよ"},
        { "location": "87/ACT"  , "narrator": "", "text": "それ、絶対楽しいヤツだ"},
        { "location": "88/TALK" , "narrator": "透明つばめ", "text": "広いお城に\nみんなで住むんだよ？"},
        { "location": "89/TALK" , "narrator": "透明つばめ", "text": "絶対楽しいよね！"},
        { "location": "90/ACT"  , "narrator": "", "text": "$me$も一緒に住みたいな"},
        { "location": "91/TALK" , "narrator": "透明つばめ", "text": "それ、とってもいいよ！"},
        { "location": "92/TALK" , "narrator": "透明つばめ", "text": "わたしも、神楽ちゃん達\nだけじゃなくて――"},
        { "location": "93/TALK" , "narrator": "透明つばめ", "text": "$handle$さんも\n一緒だったら、\nとっても嬉しいな…。"},
        { "location": "94/ACT"  , "narrator": "", "text": "そんなのダメだよ"},
        { "location": "95/TALK" , "narrator": "透明つばめ", "text": "えっ、どうして？"},
        { "location": "96/SEL"  , "narrator": "（選択肢）", "text": "$me$とつばめで住むから"},
        { "location": "97/SEL"  , "narrator": "（選択肢）", "text": "つばめ一人の城だからだよ"},
        { "location": "98/ACT"  , "narrator": "", "text": "$me$とつばめで住むから"},
        { "location": "100/TALK", "narrator": "透明つばめ", "text": "ふふっ…、\n$handle$さんが\n一緒に住んでくれるの？"},
        { "location": "101/TALK", "narrator": "透明つばめ", "text": "それだったら、\nあたしも二人だけの方が\nいいかなー？"},
        { "location": "102/TALK", "narrator": "透明つばめ", "text": "もし本当にそうなったら、\nずーっと二人で色んな\nお話したり…。"},
        { "location": "103/TALK", "narrator": "透明つばめ", "text": "遊んだりできて\n楽しそうだよね！"},
        { "location": "104/ACT" , "narrator": "", "text": "つばめ一人の城だからだよ"},
        { "location": "107/TALK", "narrator": "透明つばめ", "text": "お、お城に一人で住むの、\n凄く寂しい気がするん\nだけど…。"},
        { "location": "109/TALK", "narrator": "透明つばめ", "text": "できれば、寮みたいに\nみんなと一緒に住めたら\n楽しそうだなー。"},
        { "location": "110/TALK", "narrator": "透明つばめ", "text": "ひなこちゃん達の\nお部屋も用意したりして、\nえへへ…。"},
        { "location": "117/TALK", "narrator": "透明ガブリエラ", "text": "ちょっと、つばめ！\nこんなところで\nなにして…。"},
        { "location": "118/TALK", "narrator": "透明ガブリエラ", "text": "…お城作ってたの？"},
        { "location": "119/TALK", "narrator": "透明つばめ", "text": "あ、うん！　どうかな？\n結構自信作なんだけど…。"},
        { "location": "120/TALK", "narrator": "透明アーヤ", "text": "へぇ、一人でこんなに\n大きいの作るなんて、\nすごいと思うわ。"},
        { "location": "121/TALK", "narrator": "透明つばめ", "text": "えへへ…。"},
        { "location": "122/TALK", "narrator": "透明アーヤ", "text": "でも…大事なこと\n忘れてない？"},
        { "location": "123/TALK", "narrator": "透明つばめ", "text": "大事なこと、ですか？\nあ、お城の旗とか！"},
        { "location": "124/TALK", "narrator": "透明ガブリエラ", "text": "じゃなくて、時間！\n全然気にしてなかったの？"},
        { "location": "127/TALK", "narrator": "透明つばめ", "text": "え…。"},
        { "location": "131/TALK", "narrator": "透明つばめ", "text": "ああーーーーーーっ！！\nきゅ、休憩時間、\nもう終わっちゃってる！？"},
        { "location": "132/TALK", "narrator": "透明アーヤ", "text": "とっくにね…。"},
        { "location": "133/TALK", "narrator": "透明アーヤ", "text": "訓練始められないって、\n館長怒ってるわよ？"},
        { "location": "136/TALK", "narrator": "透明つばめ", "text": "えぇっ！？"},
        { "location": "137/SEL" , "narrator": "（選択肢）", "text": "ここでも訓練やってるの！？"},
        { "location": "138/ACT" , "narrator": "", "text": "ここでも訓練やってるの！？"},
        { "location": "140/TALK", "narrator": "透明ガブリエラ", "text": "当然じゃない。"},
        { "location": "141/TALK", "narrator": "透明ガブリエラ", "text": "精神世界だろうと、\nまほの厳しさは\n変わらず、ってね。"},
        { "location": "143/TALK", "narrator": "透明つばめ", "text": "ど、どうしよう…。\nまほろさん、\nとっても怒ってましたか？"},
        { "location": "144/TALK", "narrator": "透明アーヤ", "text": "ちゃんと謝れば平気よ。\nほら、早く行きましょ。"},
        { "location": "145/TALK", "narrator": "透明つばめ", "text": "…わかりました。"},
        { "location": "147/TALK", "narrator": "透明つばめ", "text": "…お城、もうちょっと\n見てたかったなぁ…。"}
    ]
}
