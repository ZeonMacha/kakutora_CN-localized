        "title": "【EXストーリー】マジマジ魔法少女",
        "sub_title": "コネクトストーリー"
    },
    "entry":
    [
        { "location": "6/SCENARIO", "narrator": "", "text": "【導入】スウィーティメルティ♪"},
        { "location": "12/DIALOG" , "narrator": "", "text": "<size=40>CURAN STORY. 01</size>\nKAGURA UZUKI\n\n<size=45>二階堂める</size>\n<size=35>～夜空に浮かぶは猫の爪～</size>"},
        { "location": "28/TALK"   , "narrator": "神楽", "text": "お帰りなさい、\n$handle$さま。"},
        { "location": "29/TALK"   , "narrator": "神楽", "text": "ここは、私たち\nトライナリーと、\nクランたちとの交差点。"},
        { "location": "30/TALK"   , "narrator": "神楽", "text": "ココロとココロが\n出逢い、共鳴し、\nそして繋がりあう場所。"},
        { "location": "39/SEL"    , "narrator": "（選択肢）", "text": "概要説明を飛ばす"},
        { "location": "40/SEL"    , "narrator": "（選択肢）", "text": "もう一度聞く"},
        { "location": "41/ACT"    , "narrator": "", "text": "概要説明を飛ばす"},
        { "location": "42/TALK"   , "narrator": "神楽", "text": "というわけで、\n早速今回のクランを\n紹介しますね。"},
        { "location": "44/ACT"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "49/TALK"   , "narrator": "神楽", "text": "ここでは、普段私たちを\n助けてくれるサーバント\nクランを紹介いたします。"},
        { "location": "50/TALK"   , "narrator": "神楽", "text": "そして、貴方が直接\n彼女たちと繋がれるよう、\n手続きをいたします。"},
        { "location": "51/SEL"    , "narrator": "（選択肢）", "text": "ちょっと待って"},
        { "location": "52/ACT"    , "narrator": "", "text": "ちょっと待って"},
        { "location": "54/TALK"   , "narrator": "神楽", "text": "どうか\nなさいましたか。"},
        { "location": "55/SEL"    , "narrator": "（選択肢）", "text": "お帰りなさいって？"},
        { "location": "56/SEL"    , "narrator": "（選択肢）", "text": "来たことないんだけど、ここ"},
        { "location": "57/SEL"    , "narrator": "（選択肢）", "text": "どういう設定なの？"},
        { "location": "58/ACT"    , "narrator": "", "text": "お帰りなさいって？"},
        { "location": "59/TALK"   , "narrator": "神楽", "text": "挨拶ですが、\nどうかなさいましたか？"},
        { "location": "60/ACT"    , "narrator": "", "text": "来たことないんだけど、ここ"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "まさか\n憶えてらっしゃらない？"},
        { "location": "62/ACT"    , "narrator": "", "text": "どういう設定なの？"},
        { "location": "63/TALK"   , "narrator": "神楽", "text": "設定とは\n不思議なことを\nおっしゃいますね。"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "ここで私が\n$handle$さまに\n伝えたいことは。"},
        { "location": "66/TALK"   , "narrator": "神楽", "text": "クランとの【儀式】\nによって、貴方とココロを\n繋げられるということ。"},
        { "location": "67/TALK"   , "narrator": "神楽", "text": "ここまでは\nご理解いただけ\nましたか？"},
        { "location": "68/SEL"    , "narrator": "（選択肢）", "text": "それはわかったけど"},
        { "location": "69/SEL"    , "narrator": "（選択肢）", "text": "いや、そうじゃなくて"},
        { "location": "70/SEL"    , "narrator": "（選択肢）", "text": "もういいやそれで"},
        { "location": "71/ACT"    , "narrator": "", "text": "それはわかったけど"},
        { "location": "72/TALK"   , "narrator": "神楽", "text": "ならば何も\n問題はございませんね。"},
        { "location": "73/ACT"    , "narrator": "", "text": "いや、そうじゃなくて"},
        { "location": "74/TALK"   , "narrator": "神楽", "text": "何が違うのか\nわかりかねます。"},
        { "location": "75/ACT"    , "narrator": "", "text": "もういいやそれで"},
        { "location": "76/TALK"   , "narrator": "神楽", "text": "ご理解いただき\n感謝いたします。"},
        { "location": "78/TALK"   , "narrator": "神楽", "text": "ではお話を\n続けるとしましょう。"},
        { "location": "79/TALK"   , "narrator": "神楽", "text": "【儀式】には『コネクト』\nと『シンクロ』の２つが\nございます。"},
        { "location": "80/TALK"   , "narrator": "神楽", "text": "『コネクト』は、貴方と\nクランが物理的に繋がる\nための儀式となります。"},
        { "location": "81/TALK"   , "narrator": "神楽", "text": "バトルをして彼女と貴方の\n中にある抵抗勢力を\n無力できれば完了です。"},
        { "location": "82/TALK"   , "narrator": "神楽", "text": "次の『シンクロ』では、\nクランの過去を知り、\n共感していただきます。"},
        { "location": "83/TALK"   , "narrator": "神楽", "text": "クランの過去の\n物語をシェアすることで\n心を通わせるものです。"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "ここまで、\nご理解いただけ\nましたでしょうか？"},
        { "location": "86/TALK"   , "narrator": "神楽", "text": "もし、入るセクターを\n間違えたという場合\n退場も可能ですが。"},
        { "location": "87/SEL"    , "narrator": "（選択肢）", "text": "大丈夫、次に行って"},
        { "location": "88/SEL"    , "narrator": "（選択肢）", "text": "あ、退場する"},
        { "location": "89/SEL"    , "narrator": "（選択肢）", "text": "えーと、メイドなの？"},
        { "location": "90/ACT"    , "narrator": "", "text": "大丈夫、次に行って"},
        { "location": "91/TALK"   , "narrator": "神楽", "text": "承知いたしました。\nそれでは早速、今回の\nクランを紹介いたします。"},
        { "location": "92/ACT"    , "narrator": "", "text": "あ、退場する"},
        { "location": "93/TALK"   , "narrator": "神楽", "text": "残念ですがここで\nお別れですね。"},
        { "location": "95/TALK"   , "narrator": "神楽", "text": "お戻りになる日を\n心待ちに\nしております。"},
        { "location": "96/TALK"   , "narrator": "神楽", "text": "$handle$さまと\n私に、\n素敵なココロの旅を。"},
        { "location": "98/ACT"    , "narrator": "", "text": "えーと、メイドなの？"},
        { "location": "99/TALK"   , "narrator": "神楽", "text": "え？"},
        { "location": "101/TALK"  , "narrator": "神楽", "text": "改めて聞かれると\n困ってしまいますね。"},
        { "location": "102/TALK"  , "narrator": "神楽", "text": "お好きに解釈\nしていただいて\n構いません。"},
        { "location": "103/TALK"  , "narrator": "神楽", "text": "それでは今回の\nクランを紹介\nいたしますね。"},
        { "location": "112/TALK"  , "narrator": "神楽", "text": "オープンプロセス、\n0x191番地から\n0xFFF番地へ。"},
        { "location": "113/TALK"  , "narrator": "神楽", "text": "共通意識野を経由、\n外部スフィアへ接続。"},
        { "location": "114/TALK"  , "narrator": "神楽", "text": "EXEC_SEEK_SECTOR\n=>Link() EXT_SPHERE/."},
        { "location": "139/TALK"  , "narrator": "神楽", "text": "シーク完了\nいたしました。"},
        { "location": "140/TALK"  , "narrator": "神楽", "text": "さて――。"},
        { "location": "141/TALK"  , "narrator": "神楽", "text": "今回、貴方に紹介するクラ\nンは<color=red>【スウィーティー\nメルティ♪】</color>。"},
        { "location": "143/TALK"  , "narrator": "神楽", "text": "発症場所は\n目黒区自由が丘の\n自宅。"},
        { "location": "144/TALK"  , "narrator": "神楽", "text": "発症した人の名前は、\n二階堂める、７歳。\nまだほんの子供です。"},
        { "location": "145/TALK"  , "narrator": "神楽", "text": "ココロファイルナンバー\nE05-013-41によれば、\n今回の発症の原因は……"},
        { "location": "146/TALK"  , "narrator": "神楽", "text": "『母親の死。\nまたお母さんに\n会いたい』"},
        { "location": "147/TALK"  , "narrator": "神楽", "text": "『母親のいる\n天国へ行きたい。\nでもそれは叶わない』"},
        { "location": "148/TALK"  , "narrator": "神楽", "text": "『そんな相反する\n気持ちが魔女と\n魔法少女を生み出した』"},
        { "location": "149/TALK"  , "narrator": "神楽", "text": "――という\nことだったようです。"},
        { "location": "150/TALK"  , "narrator": "神楽", "text": "母が恋しいという\n気持ち。７歳なら\nなおさらでしょう。"},
        { "location": "151/TALK"  , "narrator": "神楽", "text": "私には痛いほど\nわかります。"},
        { "location": "152/SEL"   , "narrator": "（選択肢）", "text": "そうなんだ"},
        { "location": "153/SEL"   , "narrator": "（選択肢）", "text": "神楽が仕切ってるのって…"},
        { "location": "154/ACT"   , "narrator": "", "text": "そうなんだ"},
        { "location": "155/ACT"   , "narrator": "", "text": "神楽が仕切ってるのって…"},
        { "location": "157/TALK"  , "narrator": "神楽", "text": "さすがに\n$handle$さまは\n察しがいいですね。"},
        { "location": "158/TALK"  , "narrator": "神楽", "text": "このセクタでは、クランと\n一番相性がいい\nトライナリーが参ります。"},
        { "location": "159/TALK"  , "narrator": "神楽", "text": "つまり他のクランは\n他のメンバーが\n語るということですね。"},
        { "location": "160/TALK"  , "narrator": "神楽", "text": "それでは精神共有と\n参りましょうか。"},
        { "location": "161/SEL"   , "narrator": "（選択肢）", "text": "どうやるの？"},
        { "location": "162/ACT"   , "narrator": "", "text": "どうやるの？"},
        { "location": "164/TALK"  , "narrator": "神楽", "text": "おさらいしましょうか。\nまずは『コネクト』の\nプロセスを行います。"},
        { "location": "165/TALK"  , "narrator": "神楽", "text": "具体的には、\n彼女の抵抗する意志と\n戦うのです。"},
        { "location": "166/TALK"  , "narrator": "神楽", "text": "それが終われば、\n彼女は貴方に色々\n教えてくれるでしょう。"},
        { "location": "167/TALK"  , "narrator": "神楽", "text": "$handle$さまが\nそれを共有すれば、\n『シンクロ』完了です。"},
        { "location": "168/TALK"  , "narrator": "神楽", "text": "『コネクト』『シンクロ』\n両方完了することで、\n貴方と彼女は繋がれます。"},
        { "location": "169/SEL"   , "narrator": "（選択肢）", "text": "それでおしまい？"},
        { "location": "170/ACT"   , "narrator": "", "text": "それでおしまい？"},
        { "location": "172/TALK"  , "narrator": "神楽", "text": "ここからが\n始まりですよ！"},
        { "location": "173/TALK"  , "narrator": "神楽", "text": "$handle$さまは\nめるちゃんを使える\nようになるんです！"},
        { "location": "174/TALK"  , "narrator": "神楽", "text": "ですから、『シンクロ』\nまで完了できるように\n頑張ってください！"},
        { "location": "175/TALK"  , "narrator": "神楽", "text": "あ。"},
        { "location": "176/TALK"  , "narrator": "神楽", "text": "$handle$さまには\n頑張っていただきたく\n思っております。"},
        { "location": "177/TALK"  , "narrator": "神楽", "text": "それでは。\nめるちゃんの世界に\nアクセスいたします。"},
        { "location": "179/TALK"  , "narrator": "神楽", "text": "$handle$さまと\n私とめるちゃんに、\n素敵なココロの旅を！"}
    ]
}
