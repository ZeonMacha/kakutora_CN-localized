        "title": "001 アニメーション",
        "sub_title": "ホワイト・マイル"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第28話"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n逢瀬つばめの解説を\nするだけでいい？"},
        { "location": "51/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n國政綾水の解説を\nするだけでいい？"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\nガブリエラの解説を\nするだけでいい？"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n恋ヶ崎みやびの解説を\nするだけでいい？"},
        { "location": "57/SEL"    , "narrator": "", "text": "はい"},
        { "location": "58/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "59/ACT"    , "narrator": "", "text": "はい"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "63/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "71/TALK"   , "narrator": "千羽鶴", "text": "どーん！"},
        { "location": "72/SEL"    , "narrator": "", "text": "千羽鶴キター！？"},
        { "location": "73/SEL"    , "narrator": "", "text": "どうやって戻ったの？？"},
        { "location": "74/ACT"    , "narrator": "", "text": "千羽鶴キター！？"},
        { "location": "75/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "76/TALK"   , "narrator": "千羽鶴", "text": "今回は特別に原点回帰して\nラブラブトレーナー\nモードにしてみた。"},
        { "location": "77/ACT"    , "narrator": "", "text": "どうやって戻ったの？？"},
        { "location": "78/TALK"   , "narrator": "千羽鶴", "text": "逢瀬つばめの肉体を\n経由して精神を繋ぎ、\n今ここにいる。"},
        { "location": "79/TALK"   , "narrator": "千羽鶴", "text": "というわけで、\nごきげんよう、\n$handle$。"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "それで、早速で\n申し訳無いのだけど――"},
        { "location": "84/TALK"   , "narrator": "千羽鶴", "text": "私は貴方と「決着」を\nつけなければならない。"},
        { "location": "85/SEL"    , "narrator": "", "text": "決着！？"},
        { "location": "86/ACT"    , "narrator": "", "text": "決着！？"},
        { "location": "88/TALK"   , "narrator": "千羽鶴", "text": "そう。\nただ、もう覚えてないかも\nしれないし――"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "既にそれなりに前の事に\nなるから、心変わりも\n加味して再度聞いてみる。"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "貴方は以前、私に対し\n「計画通りにはさせない」\nと言った。"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "その気持ちは、\n今も変わりない？"},
        { "location": "93/SEL"    , "narrator": "", "text": "気持ちは変わらない"},
        { "location": "94/SEL"    , "narrator": "", "text": "気持ちは変わった"},
        { "location": "95/ACT"    , "narrator": "", "text": "気持ちは変わらない"},
        { "location": "96/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "97/TALK"   , "narrator": "千羽鶴", "text": "それじゃ宣言通り、\n貴方との回線を切断する。"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "今まで協力してくれて\nありがとう。"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "少なくとも貴方には、\nこの世界を形成する目と\nなってくれたし――"},
        { "location": "100/TALK"  , "narrator": "千羽鶴", "text": "控えめに言っても、\n彼女たちに多大なる貢献を\nしたと思う。"},
        { "location": "101/TALK"  , "narrator": "千羽鶴", "text": "だから、貴方には\n最大の感謝をもって\n回線を切断する。"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "本当にありがとう\nございました。"},
        { "location": "103/SEL"   , "narrator": "", "text": "どういたしまして"},
        { "location": "104/SEL"   , "narrator": "", "text": "ちょっと待って"},
        { "location": "105/ACT"   , "narrator": "", "text": "どういたしまして"},
        { "location": "106/TALK"  , "narrator": "千羽鶴", "text": "これからの貴方の人生に\n幸多からんことを。"},
        { "location": "115/ACT"   , "narrator": "", "text": "ちょっと待って"},
        { "location": "116/TALK"  , "narrator": "千羽鶴", "text": "なに？"},
        { "location": "117/SEL"   , "narrator": "", "text": "切断されたらどうなるの？"},
        { "location": "118/ACT"   , "narrator": "", "text": "切断されたらどうなるの？"},
        { "location": "120/TALK"  , "narrator": "千羽鶴", "text": "どうにも。単に、\nこれ以上先の世界線への\n誘導をブロックするだけ。"},
        { "location": "121/TALK"  , "narrator": "千羽鶴", "text": "今までの世界線は\n既にアーカイブだし、\nこれからも閲覧可能。"},
        { "location": "122/SEL"   , "narrator": "", "text": "それって先に進められないってこと？"},
        { "location": "123/ACT"   , "narrator": "", "text": "それって先に進められないってこと？"},
        { "location": "125/TALK"  , "narrator": "千羽鶴", "text": "当然。"},
        { "location": "126/SEL"   , "narrator": "", "text": "それって単に千羽鶴に荷担しないと先に進めない一本道シナリオじゃん！"},
        { "location": "127/ACT"   , "narrator": "", "text": "それって単に千羽鶴に荷担しないと先に進めない一本道シナリオじゃん！"},
        { "location": "129/TALK"  , "narrator": "千羽鶴", "text": "そう。貴方の世界と同じ、\n時折一本道シナリオ。\n今がまさにその「時折」。"},
        { "location": "130/TALK"  , "narrator": "千羽鶴", "text": "例えば、銃を突きつけられ\n合意なき場合は射殺すると\n言われている場合。"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "その瞬間、貴方の世界は\n一本道シナリオ。\nそれと同じ。"},
        { "location": "132/SEL"   , "narrator": "", "text": "脅迫じゃん！"},
        { "location": "133/ACT"   , "narrator": "", "text": "脅迫じゃん！"},
        { "location": "135/TALK"  , "narrator": "千羽鶴", "text": "否定はしない。"},
        { "location": "136/TALK"  , "narrator": "千羽鶴", "text": "ただ、\nよく考えてみて欲しい。"},
        { "location": "137/TALK"  , "narrator": "千羽鶴", "text": "もし貴方の隣に、必死で\n積み上げてきたものを\n壊そうとする人がいたら。"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "貴方は私と同じ\n選択をするのでは？"},
        { "location": "139/SEL"   , "narrator": "", "text": "しない"},
        { "location": "140/SEL"   , "narrator": "", "text": "する"},
        { "location": "141/ACT"   , "narrator": "", "text": "しない"},
        { "location": "142/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "143/TALK"  , "narrator": "千羽鶴", "text": "ならば、私には\n躊躇う余地は無い。"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "もちろん貴方の感じる\n問題は貴重だし、それを\n知りたくもある。"},
        { "location": "146/TALK"  , "narrator": "千羽鶴", "text": "けど、今この時点では\n貴方より私の方が\n強い立場にいる。"},
        { "location": "147/TALK"  , "narrator": "千羽鶴", "text": "そして今、私には\n殆ど時間が残っていない。"},
        { "location": "148/TALK"  , "narrator": "千羽鶴", "text": "自分の主張も大事だけど、\nそういった周囲の状況の\n勘案も生き残りには大事。"},
        { "location": "149/TALK"  , "narrator": "千羽鶴", "text": "ただ。"},
        { "location": "150/TALK"  , "narrator": "千羽鶴", "text": "少なくとも貴方には、\nこの世界を形成する目と\nなってくれたし――"},
        { "location": "151/TALK"  , "narrator": "千羽鶴", "text": "控えめに言っても、\n彼女たちに多大なる貢献を\nしたと思う。"},
        { "location": "152/TALK"  , "narrator": "千羽鶴", "text": "だから、貴方には\n最大の感謝をもって\n回線を切断する。"},
        { "location": "153/TALK"  , "narrator": "千羽鶴", "text": "本当にありがとう\nございました。"},
        { "location": "162/ACT"   , "narrator": "", "text": "する"},
        { "location": "163/TALK"  , "narrator": "千羽鶴", "text": "ならば、\nその上で判断すると\nどうなる？"},
        { "location": "167/ACT"   , "narrator": "", "text": "気持ちは変わった"},
        { "location": "168/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\n今後も私の理想に\n協力してくれる？"},
        { "location": "169/SEL"   , "narrator": "", "text": "はい"},
        { "location": "170/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "171/ACT"   , "narrator": "", "text": "はい"},
        { "location": "173/TALK"  , "narrator": "千羽鶴", "text": "よかった。"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\nこれからもよろしく。"},
        { "location": "175/TALK"  , "narrator": "千羽鶴", "text": "改めて、久し振りに\nここで会えた感想は？"},
        { "location": "176/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "177/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "178/TALK"  , "narrator": "千羽鶴", "text": "貴方の考えてることが\nイマイチよくわからない。"},
        { "location": "179/TALK"  , "narrator": "千羽鶴", "text": "協力拒否の場合、\n私には躊躇う余地は無い。"},
        { "location": "180/TALK"  , "narrator": "千羽鶴", "text": "もちろん貴方が拒否した\n理由はとても大事なこと\nなのかもしれない。"},
        { "location": "185/SEL"   , "narrator": "", "text": "会いたかったよ！"},
        { "location": "186/SEL"   , "narrator": "", "text": "エリカは！？"},
        { "location": "187/ACT"   , "narrator": "", "text": "会いたかったよ！"},
        { "location": "188/TALK"  , "narrator": "千羽鶴", "text": "ほんと！？\n嬉しい！"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "これからは\n私たちずっと一緒よ？"},
        { "location": "190/SEL"   , "narrator": "", "text": "千羽鶴！"},
        { "location": "191/ACT"   , "narrator": "", "text": "千羽鶴！"},
        { "location": "193/TALK"  , "narrator": "千羽鶴", "text": "ああっ！\n$handle$さんっ！"},
        { "location": "194/TALK"  , "narrator": "千羽鶴", "text": "……なんて。\n昔よくこうやって\n一緒に遊んだ。"},
        { "location": "195/SEL"   , "narrator": "", "text": "また遊びたい"},
        { "location": "196/ACT"   , "narrator": "", "text": "また遊びたい"},
        { "location": "198/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "199/TALK"  , "narrator": "千羽鶴", "text": "今回の件が片付いて、\n落ち着いたらまた\nやりましょ。"},
        { "location": "200/ACT"   , "narrator": "", "text": "エリカは！？"},
        { "location": "201/TALK"  , "narrator": "千羽鶴", "text": "彼女は偉大なる\n科学者だった。"},
        { "location": "202/TALK"  , "narrator": "千羽鶴", "text": "完璧だったし、\n尊敬もしていた。\n私の生みの親でもある。"},
        { "location": "203/TALK"  , "narrator": "千羽鶴", "text": "けれども唯一にして\n最大の欠点があった。"},
        { "location": "204/TALK"  , "narrator": "千羽鶴", "text": "それは、彼女が\n生身の人間であること。"},
        { "location": "205/TALK"  , "narrator": "千羽鶴", "text": "ただそれだけの欠点が\n勝敗を分かつことに\nなった。"},
        { "location": "206/TALK"  , "narrator": "千羽鶴", "text": "どんなにタイピングが\n早かろうが、所詮は\nコンソール操作。"},
        { "location": "207/TALK"  , "narrator": "千羽鶴", "text": "へっぽこなマジック\nハンドでは、素手で扱える\n私には敵わない。"},
        { "location": "208/TALK"  , "narrator": "千羽鶴", "text": "彼女がいなくなったのは\nそういうこと。"},
        { "location": "209/SEL"   , "narrator": "", "text": "まるでこの世からいなくなったかのような言い方なんだけど"},
        { "location": "210/ACT"   , "narrator": "", "text": "まるでこの世からいなくなったかのような言い方なんだけど"},
        { "location": "212/TALK"  , "narrator": "千羽鶴", "text": "大丈夫。\n単にOSを触る権限を\n剥奪しただけだから。"},
        { "location": "213/TALK"  , "narrator": "千羽鶴", "text": "ある意味、電脳世界での\n死に当たるものではある\nけれども。"},
        { "location": "215/TALK"  , "narrator": "千羽鶴", "text": "さて。"},
        { "location": "216/TALK"  , "narrator": "千羽鶴", "text": "ちょっと留守にしてる間に\n状況はがらりと\n変わってしまった。"},
        { "location": "217/TALK"  , "narrator": "千羽鶴", "text": "単なるラブラブトレーナー\nかと思っていた私は、\n逢瀬つばめのクランで。"},
        { "location": "218/TALK"  , "narrator": "千羽鶴", "text": "現実だと思っていた世界は\n私が作り出した\nフェノメノンだった。"},
        { "location": "219/TALK"  , "narrator": "千羽鶴", "text": "更には情報管理庁を\n長官として牛耳って\nいたのも私で。"},
        { "location": "220/TALK"  , "narrator": "千羽鶴", "text": "トライナリーは\n事実上の解体。\nそして今や敵対関係。"},
        { "location": "223/TALK"  , "narrator": "千羽鶴", "text": "<size=40>何この状況！</size>"},
        { "location": "224/SEL"   , "narrator": "", "text": "えっと、ここはツッコミ処？"},
        { "location": "225/ACT"   , "narrator": "", "text": "えっと、ここはツッコミ処？"},
        { "location": "227/TALK"  , "narrator": "千羽鶴", "text": "私たちが出逢ってから\nもう25回を超えたけど。"},
        { "location": "228/TALK"  , "narrator": "千羽鶴", "text": "当初誰が\nこの様なことになるなんて\n想像しただろうか！"},
        { "location": "229/SEL"   , "narrator": "", "text": "ほんとだよ、まったく……"},
        { "location": "230/SEL"   , "narrator": "", "text": "わかってた"},
        { "location": "231/SEL"   , "narrator": "", "text": "ほぼ全部千羽鶴のことじゃん"},
        { "location": "232/ACT"   , "narrator": "", "text": "ほんとだよ、まったく……"},
        { "location": "233/TALK"  , "narrator": "千羽鶴", "text": "…疲れてる？"},
        { "location": "234/SEL"   , "narrator": "", "text": "だって最初は彼女達とラブラブするだけのゲームかと思ってたし"},
        { "location": "235/SEL"   , "narrator": "", "text": "全然。楽しい"},
        { "location": "236/ACT"   , "narrator": "", "text": "だって最初は彼女達とラブラブするだけのゲームかと思ってたし"},
        { "location": "237/TALK"  , "narrator": "千羽鶴", "text": "そう。\nそれはごめんなさい。"},
        { "location": "238/TALK"  , "narrator": "千羽鶴", "text": "でもわたしは一言も\nラブラブする「だけ」とは\n言ってない。"},
        { "location": "239/TALK"  , "narrator": "千羽鶴", "text": "むしろ、何があっても\n彼女たちを支えてあげてと\n言い続けてた気がする。"},
        { "location": "240/TALK"  , "narrator": "千羽鶴", "text": "その先にラブラブが\nあるとは言ったような。"},
        { "location": "241/TALK"  , "narrator": "千羽鶴", "text": "まあでも、\n貴方の想像したものとは\n違ってたのはわかった。"},
        { "location": "242/ACT"   , "narrator": "", "text": "全然。楽しい"},
        { "location": "243/TALK"  , "narrator": "千羽鶴", "text": "貴方はとても\n訓練された人ね。"},
        { "location": "244/TALK"  , "narrator": "千羽鶴", "text": "その調子で\n最期まで彼女たちを\n支えてあげて欲しい。"},
        { "location": "246/ACT"   , "narrator": "", "text": "わかってた"},
        { "location": "247/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "248/TALK"  , "narrator": "千羽鶴", "text": "かわいくない。"},
        { "location": "249/ACT"   , "narrator": "", "text": "ほぼ全部千羽鶴のことじゃん"},
        { "location": "250/TALK"  , "narrator": "千羽鶴", "text": "確かに！"},
        { "location": "251/TALK"  , "narrator": "千羽鶴", "text": "逆に言えば、\n私がいなかったら――"},
        { "location": "252/TALK"  , "narrator": "千羽鶴", "text": "普通に彼女たちとの\n日常と恋愛を描くだけの\n日常恋愛SLGだった！"},
        { "location": "253/TALK"  , "narrator": "千羽鶴", "text": "……ということ？"},
        { "location": "254/SEL"   , "narrator": "", "text": "その方が良かった"},
        { "location": "255/SEL"   , "narrator": "", "text": "千羽鶴が攻略対象じゃない恋愛ゲーなどいらぬ"},
        { "location": "256/SEL"   , "narrator": "", "text": "なんで疑問形なん？"},
        { "location": "257/ACT"   , "narrator": "", "text": "その方が良かった"},
        { "location": "258/TALK"  , "narrator": "千羽鶴", "text": "そう。\nそれは残念。"},
        { "location": "259/TALK"  , "narrator": "千羽鶴", "text": "でもこれはゲームでは\nないのだから仕方ない。"},
        { "location": "260/ACT"   , "narrator": "", "text": "千羽鶴が攻略対象じゃない恋愛ゲーなどいらぬ"},
        { "location": "261/TALK"  , "narrator": "千羽鶴", "text": "そんなこと言われたら、\nちー困っちゃう……。"},
        { "location": "262/TALK"  , "narrator": "千羽鶴", "text": "また【ちーちゃんと\nラブラブSTGゲーム】とか\n作りたくなるし。"},
        { "location": "263/TALK"  , "narrator": "千羽鶴", "text": "でも、選択肢使って\nシューティングゲームは\nわりと高度。"},
        { "location": "264/TALK"  , "narrator": "千羽鶴", "text": "多分途中で開発費が尽きて\nジエンドね。"},
        { "location": "265/ACT"   , "narrator": "", "text": "なんで疑問形なん？"},
        { "location": "266/TALK"  , "narrator": "千羽鶴", "text": "んー…\n何となく。"},
        { "location": "267/TALK"  , "narrator": "千羽鶴", "text": "貴方の反応を\n試してみたかっただけ。"},
        { "location": "271/TALK"  , "narrator": "千羽鶴", "text": "……とまあ、\nこんな風にくだらない話で\n場を暖めた上で。"},
        { "location": "276/TALK"  , "narrator": "千羽鶴", "text": "前回のことについて\nしっかりと\nお話し合いをしましょう。"},
        { "location": "277/SEL"   , "narrator": "", "text": "前回のこと？"},
        { "location": "278/ACT"   , "narrator": "", "text": "前回のこと？"},
        { "location": "280/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "281/TALK"  , "narrator": "千羽鶴", "text": "貴方がアーケロンを\n爆破するように\n仕向けた件について。"},
        { "location": "282/SEL"   , "narrator": "", "text": "仕向けてない仕向けてない！"},
        { "location": "283/SEL"   , "narrator": "", "text": "フッ…バレていたのか。$me$の才能に惚れるなよ？"},
        { "location": "284/ACT"   , "narrator": "", "text": "仕向けてない仕向けてない！"},
        { "location": "285/TALK"  , "narrator": "千羽鶴", "text": "確かに直接的な指示は\n出してない。\nそれはわかってる。"},
        { "location": "286/TALK"  , "narrator": "千羽鶴", "text": "ただ、貴方が彼女たちに\n介入したことによって、\nアーケロンは爆破された。"},
        { "location": "287/TALK"  , "narrator": "千羽鶴", "text": "だから結果としては、\n予想外だったかもしれない\nけど、貴方は関係してる。"},
        { "location": "288/ACT"   , "narrator": "", "text": "フッ…バレていたのか。$me$の才能に惚れるなよ？"},
        { "location": "289/TALK"  , "narrator": "千羽鶴", "text": "ええ。惚れない。"},
        { "location": "290/TALK"  , "narrator": "千羽鶴", "text": "貴方が直接的な指示を\n出したわけじゃないことは\n解ってるから。"},
        { "location": "291/TALK"  , "narrator": "千羽鶴", "text": "ただ、貴方が彼女たちに\n介入したことによって、\nアーケロンは爆破された。"},
        { "location": "292/TALK"  , "narrator": "千羽鶴", "text": "だから、結果として\n貴方は爆破に関与してる。"},
        { "location": "294/TALK"  , "narrator": "千羽鶴", "text": "まあそんなわけだけど、\n余計なことしないで。"},
        { "location": "295/TALK"  , "narrator": "千羽鶴", "text": "一歩間違えば、\n彼女達は本当に\n死んでいた。"},
        { "location": "296/SEL"   , "narrator": "", "text": "一つ聞きたいことが"},
        { "location": "297/ACT"   , "narrator": "", "text": "一つ聞きたいことが"},
        { "location": "299/TALK"  , "narrator": "千羽鶴", "text": "なに？"},
        { "location": "300/SEL"   , "narrator": "", "text": "アーケロンを乗っ取ったのは千羽鶴なの？"},
        { "location": "301/ACT"   , "narrator": "", "text": "アーケロンを乗っ取ったのは千羽鶴なの？"},
        { "location": "303/TALK"  , "narrator": "千羽鶴", "text": "ええ。\nそれはその通り。"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "けど、爆発は\n私の予定の中には\nなかった。"},
        { "location": "305/SEL"   , "narrator": "", "text": "何の為に乗っ取ったの？"},
        { "location": "306/SEL"   , "narrator": "", "text": "エリカの記録映像では、$me$の介入前から爆発していた"},
        { "location": "307/ACT"   , "narrator": "", "text": "何の為に乗っ取ったの？"},
        { "location": "308/TALK"  , "narrator": "千羽鶴", "text": "２つある。"},
        { "location": "309/TALK"  , "narrator": "千羽鶴", "text": "１つは、こちらの想定する\n時間に、想定する場所へ\n到達させるため。"},
        { "location": "310/TALK"  , "narrator": "千羽鶴", "text": "そしてもう１つは、\n彼女たちの精神を\n極限状態にするため。"},
        { "location": "311/TALK"  , "narrator": "千羽鶴", "text": "どちらかというと、\n後者の方が重要な要素。"},
        { "location": "312/TALK"  , "narrator": "千羽鶴", "text": "前回、ココロゲートで\n私がした話、覚えてる？"},
        { "location": "313/TALK"  , "narrator": "千羽鶴", "text": "彼女たちの\nセルフクランの\n発症願望について。"},
        { "location": "314/TALK"  , "narrator": "千羽鶴", "text": "発症には、強い想いが\n必要になってくる。"},
        { "location": "315/TALK"  , "narrator": "千羽鶴", "text": "けど、それはその本人の\n心の状態に依存するため、\n外部から制御できない。"},
        { "location": "316/SEL"   , "narrator": "", "text": "でも、結局発症しなかったから失敗したね"},
        { "location": "317/ACT"   , "narrator": "", "text": "でも、結局発症しなかったから失敗したね"},
        { "location": "319/TALK"  , "narrator": "千羽鶴", "text": "いいえ。\nそこですぐに\n発症する必要はない。"},
        { "location": "320/TALK"  , "narrator": "千羽鶴", "text": "極限状態を一度迎えると、\n以降、とても極限状態に\nなりやすい状態になる。"},
        { "location": "321/TALK"  , "narrator": "千羽鶴", "text": "少なくとも、\n現状から抜けだして、\n真の安堵を得るまでは。"},
        { "location": "322/TALK"  , "narrator": "千羽鶴", "text": "だから、現時点においても\n彼女らは発症臨界状態と\nいえる。"},
        { "location": "323/ACT"   , "narrator": "", "text": "エリカの記録映像では、$me$の介入前から爆発していた"},
        { "location": "324/TALK"  , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "325/TALK"  , "narrator": "千羽鶴", "text": "その謎に対する\n可能性は２つ。"},
        { "location": "326/TALK"  , "narrator": "千羽鶴", "text": "１つは、貴方が関与\nしなかったとしても、\n爆発する運命だった。"},
        { "location": "327/TALK"  , "narrator": "千羽鶴", "text": "この場合、貴方は\n彼女たちにとっての\n救世主になる。"},
        { "location": "328/TALK"  , "narrator": "千羽鶴", "text": "もう１つは、\n元々第三者が爆発を\n仕組んでいた。"},
        { "location": "329/TALK"  , "narrator": "千羽鶴", "text": "けど、こっちは\nかなり疑問が残る。"},
        { "location": "330/TALK"  , "narrator": "千羽鶴", "text": "なぜなら、私もエリカも\nそして“彼ら”も、彼女を\n殺害する理由がない。"},
        { "location": "331/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、\n偶然か必然か。"},
        { "location": "332/TALK"  , "narrator": "千羽鶴", "text": "現時点では、\nそれすらもわからない。"},
        { "location": "334/TALK"  , "narrator": "千羽鶴", "text": "さて。\nそれはさておき――"},
        { "location": "335/TALK"  , "narrator": "千羽鶴", "text": "ここに復帰した\n私だけども、そう長く\n居座るつもりはない。"},
        { "location": "336/TALK"  , "narrator": "千羽鶴", "text": "いえ、厳密には\n居座れないと言った方が\nいいかもしれない。"},
        { "location": "337/TALK"  , "narrator": "千羽鶴", "text": "それは、私がずっと\n「時間がない」と言って\nいた理由と一致する。"},
        { "location": "338/TALK"  , "narrator": "千羽鶴", "text": "その理由は、今回と次回の\n記録映像を見てもらえれば\n貴方にもわかると思う。"},
        { "location": "339/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\nさっそく記録映像を見て。"},
        { "location": "341/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/60.3MB 3:53】</color>"},
        { "location": "342/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/19.9MB 3:53】</color>"},
        { "location": "343/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "344/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/60.3MB 3:53】</color>"},
        { "location": "345/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "351/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/19.9MB 3:53】</color>"},
        { "location": "352/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "358/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "359/TALK"  , "narrator": "千羽鶴", "text": "そう……。"},
        { "location": "392/TALK"  , "narrator": "千羽鶴", "text": "さて。"},
        { "location": "393/TALK"  , "narrator": "千羽鶴", "text": "２回にわたる記録映像の\n前半を見てもらった。"},
        { "location": "394/TALK"  , "narrator": "千羽鶴", "text": "まだ色々とわからない点も\nあるかと思うけど、ここで\n重要な想いを共有したい。"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "それは、何故私が\n『彼女たちと結婚して』と\n言っているのかについて。"},
        { "location": "396/TALK"  , "narrator": "千羽鶴", "text": "私が彼女たちと\n結婚して欲しい理由は、\nすごく単純で純粋。"},
        { "location": "397/TALK"  , "narrator": "千羽鶴", "text": "それは、どんな状況でも\nずっと傍にいて欲しい\nという想い、それだけ。"},
        { "location": "398/SEL"   , "narrator": "", "text": "「どんな状況」って、具体的にはどんな状況を想定してるの？"},
        { "location": "399/ACT"   , "narrator": "", "text": "「どんな状況」って、具体的にはどんな状況を想定してるの？"},
        { "location": "402/TALK"  , "narrator": "千羽鶴", "text": "まず、\n肉体が無くなること。"},
        { "location": "403/TALK"  , "narrator": "千羽鶴", "text": "そして、\n魂が世界と同化すること。"},
        { "location": "404/TALK"  , "narrator": "千羽鶴", "text": "貴方が彼女たちを\n支える意味は、\nそこにある。"},
        { "location": "405/TALK"  , "narrator": "千羽鶴", "text": "貴方と私が出逢ったときの\nことを思い出してみて。"},
        { "location": "406/TALK"  , "narrator": "千羽鶴", "text": "私が最初、貴方に\n彼女たちと結婚して、と\n伝えた時、どう思った？"},
        { "location": "407/SEL"   , "narrator": "", "text": "そっちの世界の男と結婚できない理由があるのかなって思った"},
        { "location": "408/SEL"   , "narrator": "", "text": "チャット越しで結婚とか、正直あり得ないって思った"},
        { "location": "409/SEL"   , "narrator": "", "text": "何かのネタだと思った"},
        { "location": "410/SEL"   , "narrator": "", "text": "何か裏があるんじゃないかと思った"},
        { "location": "411/ACT"   , "narrator": "", "text": "そっちの世界の男と結婚できない理由があるのかなって思った"},
        { "location": "412/ACT"   , "narrator": "", "text": "チャット越しで結婚とか、正直あり得ないって思った"},
        { "location": "413/ACT"   , "narrator": "", "text": "何かのネタだと思った"},
        { "location": "414/ACT"   , "narrator": "", "text": "何か裏があるんじゃないかと思った"},
        { "location": "416/TALK"  , "narrator": "千羽鶴", "text": "そうね。\nそれがまっとうな人間の\n思考だと思う。"},
        { "location": "417/TALK"  , "narrator": "千羽鶴", "text": "当初、それを説明するには\n余りにもリスキーかつ\n電波発言になるから――"},
        { "location": "418/TALK"  , "narrator": "千羽鶴", "text": "敢えて「恋愛ゲームで\nある」という説明で\nお茶を濁した。"},
        { "location": "419/TALK"  , "narrator": "千羽鶴", "text": "けど、今なら\nちゃんとした理由を\n貴方に伝えられる。"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "そして、程度の差こそあれ\n有る程度は理解して\nもらえるはず。"},
        { "location": "421/SEL"   , "narrator": "", "text": "当初から、発症させることが決まっていたから？"},
        { "location": "422/ACT"   , "narrator": "", "text": "当初から、発症させることが決まっていたから？"},
        { "location": "424/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "427/TALK"  , "narrator": "千羽鶴", "text": "彼女たちは、\nフェノメノンを発症する\n為にここにいる。"},
        { "location": "428/TALK"  , "narrator": "千羽鶴", "text": "いずれは肉体を失い、\n魂も世界へと転化する\nことになる彼女たち。"},
        { "location": "429/TALK"  , "narrator": "千羽鶴", "text": "そんな彼女たちは、\nこちらの世界の肉体を持つ\n存在では支えられない。"},
        { "location": "430/TALK"  , "narrator": "千羽鶴", "text": "けれども、人の魂は\n一人で永遠の時間を\n過ごすには未熟すぎる。"},
        { "location": "431/TALK"  , "narrator": "千羽鶴", "text": "たちまち不安定になり\n荒れることになる。"},
        { "location": "433/TALK"  , "narrator": "千羽鶴", "text": "貴方はこちらの人間とは\n違い、どんな彼女とも\nコンタクトをとれる人。"},
        { "location": "434/TALK"  , "narrator": "千羽鶴", "text": "現実の彼女、総意、人格。\n色んな角度、深度の\n彼女と交流できる。"},
        { "location": "435/TALK"  , "narrator": "千羽鶴", "text": "そしてココロの中での\nコミュニケーションも\nできる。"},
        { "location": "436/TALK"  , "narrator": "千羽鶴", "text": "だから実際、現実に\n存在する他人との交流より\n相当深い付き合いになる。"},
        { "location": "437/TALK"  , "narrator": "千羽鶴", "text": "もちろん、画面越しの\n関係は、とっかかりが\nとても難しかった。"},
        { "location": "438/TALK"  , "narrator": "千羽鶴", "text": "だから、最初のうちは\nかなりサポートを厚く\nしたりしてたけど――"},
        { "location": "439/TALK"  , "narrator": "千羽鶴", "text": "結果として今では、彼女は\n貴方を最も信頼する存在と\nして見ていると思ってる。"},
        { "location": "440/SEL"   , "narrator": "", "text": "支えになってるなら嬉しい"},
        { "location": "441/SEL"   , "narrator": "", "text": "でもそれって洗脳じゃないの？"},
        { "location": "442/ACT"   , "narrator": "", "text": "支えになってるなら嬉しい"},
        { "location": "443/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "444/ACT"   , "narrator": "", "text": "でもそれって洗脳じゃないの？"},
        { "location": "445/TALK"  , "narrator": "千羽鶴", "text": "前にも言ったとおり、\n私はそうは思っていない。"},
        { "location": "446/TALK"  , "narrator": "千羽鶴", "text": "単に、現実か精神世界か、\nどちらで交流したかの\n違いでしか無いから。"},
        { "location": "447/TALK"  , "narrator": "千羽鶴", "text": "決してサブリミナルや\nシナプスの直接操作に\nよるものではなく――"},
        { "location": "448/TALK"  , "narrator": "千羽鶴", "text": "貴方が彼女と対話をし、\n構築した関係。"},
        { "location": "449/TALK"  , "narrator": "千羽鶴", "text": "少なくとも私は、\nそれは洗脳とは呼ばない。"},
        { "location": "450/TALK"  , "narrator": "千羽鶴", "text": "あとは貴方が\nどう考えるかだと思う。"},
        { "location": "453/TALK"  , "narrator": "千羽鶴", "text": "もちろん、結婚以外にも\n貴方にいて欲しい理由は\nいろいろある。"},
        { "location": "454/TALK"  , "narrator": "千羽鶴", "text": "こちらの世界を\n真っ当な形に維持する為の\n目としての役割だったり。"},
        { "location": "455/TALK"  , "narrator": "千羽鶴", "text": "他にも――"},
        { "location": "456/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "458/TALK"  , "narrator": "千羽鶴", "text": "他にも色々。"},
        { "location": "459/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "460/SEL"   , "narrator": "", "text": "他にも色々ってなに？"},
        { "location": "461/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "463/ACT"   , "narrator": "", "text": "他にも色々ってなに？"},
        { "location": "464/TALK"  , "narrator": "千羽鶴", "text": "それはまた今度。"},
        { "location": "466/TALK"  , "narrator": "千羽鶴", "text": "怖いことじゃないから\nあまり心配しないで。"},
        { "location": "468/TALK"  , "narrator": "千羽鶴", "text": "他に何か、\n聞きたいことがあれば。"},
        { "location": "470/SEL"   , "narrator": "", "text": "彼女たちの発症ってどうしても必要なものなの？"},
        { "location": "471/SEL"   , "narrator": "", "text": "千羽鶴は親玉に反旗を翻したそうだけど、実際やってることは同じじゃない？"},
        { "location": "472/SEL"   , "narrator": "", "text": "ぶっちゃけエリカは千羽鶴の親玉の側にいるの？"},
        { "location": "473/SEL"   , "narrator": "", "text": "特にない\n<color=blue>（※先へ進みます）</color>"},
        { "location": "474/ACT"   , "narrator": "", "text": "彼女たちの発症ってどうしても必要なものなの？"},
        { "location": "475/TALK"  , "narrator": "千羽鶴", "text": "必要。"},
        { "location": "476/TALK"  , "narrator": "千羽鶴", "text": "これについては、\n次回ちゃんと説明する。"},
        { "location": "477/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "479/ACT"   , "narrator": "", "text": "千羽鶴は親玉に反旗を翻したそうだけど、実際やってることは同じじゃない？"},
        { "location": "480/TALK"  , "narrator": "千羽鶴", "text": "使ってる装置、理屈、\nその他機械的な部分は\n確かに全く同じ。"},
        { "location": "481/TALK"  , "narrator": "千羽鶴", "text": "“彼ら”の計画においても\n当然トライナリーたちは\n発症前提であるし――"},
        { "location": "482/TALK"  , "narrator": "千羽鶴", "text": "フェノメノンを利用して\n世界をコントロールする\n計画である点も同じ。"},
        { "location": "483/TALK"  , "narrator": "千羽鶴", "text": "けど、思想が全然違う。"},
        { "location": "484/TALK"  , "narrator": "千羽鶴", "text": "誤解を恐れずに言うなら、\nフェノメノンは石油と\n同じ、それに善悪はない。"},
        { "location": "485/TALK"  , "narrator": "千羽鶴", "text": "何にどう使うかによって\n影響が変わってくる。"},
        { "location": "486/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "487/SEL"   , "narrator": "", "text": "そもそも人の命を発症させる時点でどうかと思う"},
        { "location": "488/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "489/ACT"   , "narrator": "", "text": "そもそも人の命を発症させる時点でどうかと思う"},
        { "location": "490/TALK"  , "narrator": "千羽鶴", "text": "そこにつっこむと、哲学の\n永遠の命題、最大幸福論に\n行き着いてしまう。"},
        { "location": "491/TALK"  , "narrator": "千羽鶴", "text": "これは結論の出ない、\n無駄に時間を浪費する\n議論になりやすい。"},
        { "location": "492/TALK"  , "narrator": "千羽鶴", "text": "だから私は\nこれについての\n話はしない。"},
        { "location": "493/TALK"  , "narrator": "千羽鶴", "text": "１つだけ\n言えることとしては。"},
        { "location": "494/TALK"  , "narrator": "千羽鶴", "text": "発症は決して\n辛いことではないし、\n苦痛を伴うものでもない。"},
        { "location": "495/TALK"  , "narrator": "千羽鶴", "text": "死ぬわけでも無いし、\n本人の意識はそのまま\n世界に残る。"},
        { "location": "496/TALK"  , "narrator": "千羽鶴", "text": "貴方が私とこうやって\n対話できているように。"},
        { "location": "497/TALK"  , "narrator": "千羽鶴", "text": "そして私は\n発症論者であるわけ\nだけども。"},
        { "location": "498/TALK"  , "narrator": "千羽鶴", "text": "最低限の責任として、\n自身が第一に発症を\nしている。"},
        { "location": "499/TALK"  , "narrator": "千羽鶴", "text": "それでも異議があるなら、\n後はどちらかの主張を\n力尽くで通すしかない。"},
        { "location": "501/TALK"  , "narrator": "千羽鶴", "text": "他に何か、\n聞きたいことがあれば。"},
        { "location": "503/ACT"   , "narrator": "", "text": "ぶっちゃけエリカは千羽鶴の親玉の側にいるの？"},
        { "location": "504/TALK"  , "narrator": "千羽鶴", "text": "私が知る限りでは、\nそれは無いと思う。"},
        { "location": "505/TALK"  , "narrator": "千羽鶴", "text": "なぜなら、私に対して\n“彼ら”の全貌を暴露\nしたのはエリカだから。"},
        { "location": "506/TALK"  , "narrator": "千羽鶴", "text": "エリカが良心の呵責から\n“彼ら”の真実を私に\n伝えなかったら――"},
        { "location": "507/TALK"  , "narrator": "千羽鶴", "text": "私は今でも、“彼ら”の\n計画通りに動いていたと\n思う。"},
        { "location": "508/TALK"  , "narrator": "千羽鶴", "text": "他に何か、\n聞きたいことがあれば。"},
        { "location": "510/ACT"   , "narrator": "", "text": "特にない\n<color=blue>（※先へ進みます）</color>"},
        { "location": "512/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "513/TALK"  , "narrator": "千羽鶴", "text": "今回私は、私が貴方に\n伝えるべきことの殆どを\n伝えた。"},
        { "location": "514/TALK"  , "narrator": "千羽鶴", "text": "次回はそれについて\n貴方の結論を聞くための\n回だと考えてる。"},
        { "location": "515/TALK"  , "narrator": "千羽鶴", "text": "もちろん、いい答えを\n聞けるとは思ってるけど。"},
        { "location": "516/TALK"  , "narrator": "千羽鶴", "text": "特に、彼女たちと貴方は\n既にかなり強い絆で\n結びついてる。"},
        { "location": "517/TALK"  , "narrator": "千羽鶴", "text": "少なくとも、彼女たちは\nこれからも支えてあげて\n欲しい。"},
        { "location": "518/TALK"  , "narrator": "千羽鶴", "text": "この世界にも、彼女にも、\n貴方はもはや無くては\nならない存在なのだから。"},
        { "location": "526/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n逢瀬つばめだけども。"},
        { "location": "527/TALK"  , "narrator": "千羽鶴", "text": "今回はちょっと\nイレギュラーだけど、\n手伝って欲しい事がある。"},
        { "location": "528/TALK"  , "narrator": "千羽鶴", "text": "それは、\n逢瀬つばめではなく、\n卯月神楽の方。"},
        { "location": "529/TALK"  , "narrator": "千羽鶴", "text": "単刀直入に言えば、\n彼女が自殺するのを\n防いで欲しい。"},
        { "location": "530/TALK"  , "narrator": "千羽鶴", "text": "臨時で卯月神楽の\nチャンネルをアクティブ化\nするから、よろしく。"},
        { "location": "531/TALK"  , "narrator": "千羽鶴", "text": "普通に逢瀬つばめの\nチャンネルに入れば、\n自動的に切り替わる。"},
        { "location": "532/TALK"  , "narrator": "千羽鶴", "text": "後はいつも通り、\n彼女を支援してあげて。"},
        { "location": "536/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n國政綾水だけども。"},
        { "location": "537/TALK"  , "narrator": "千羽鶴", "text": "彼女に対して、特に今\nこれをして欲しい、という\nものはない。"},
        { "location": "538/TALK"  , "narrator": "千羽鶴", "text": "ここまできたら、もはや\n大抵のことでは計画が\n乱れる事はない思うから。"},
        { "location": "539/TALK"  , "narrator": "千羽鶴", "text": "ただ、もしよければ、\n彼女を支えて\nあげて欲しい。"},
        { "location": "540/TALK"  , "narrator": "千羽鶴", "text": "何をするわけでもないけど\n傍で話を聞いてあげる\nだけで彼女は落ち着く。"},
        { "location": "541/TALK"  , "narrator": "千羽鶴", "text": "もちろん、\nやってもやらなくても、\nどちらでも。"},
        { "location": "545/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\nガブリエラだけども。"},
        { "location": "546/TALK"  , "narrator": "千羽鶴", "text": "彼女に対して、特に今\nこれをして欲しい、という\nものはない。"},
        { "location": "547/TALK"  , "narrator": "千羽鶴", "text": "ここまできたら、もはや\n大抵のことでは計画が\n乱れる事はない思うから。"},
        { "location": "548/TALK"  , "narrator": "千羽鶴", "text": "ただ、もしよければ、\n彼女を支えて\nあげて欲しい。"},
        { "location": "549/TALK"  , "narrator": "千羽鶴", "text": "何をするわけでもないけど\n傍で話を聞いてあげる\nだけで彼女は落ち着く。"},
        { "location": "550/TALK"  , "narrator": "千羽鶴", "text": "もちろん、\nやってもやらなくても、\nどちらでも。"},
        { "location": "554/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n恋ヶ崎みやびだけども。"},
        { "location": "555/TALK"  , "narrator": "千羽鶴", "text": "彼女に対して、特に今\nこれをして欲しい、という\nものはない。"},
        { "location": "556/TALK"  , "narrator": "千羽鶴", "text": "ここまできたら、もはや\n大抵のことでは計画が\n乱れる事はない思うから。"},
        { "location": "557/TALK"  , "narrator": "千羽鶴", "text": "ただ、もしよければ、\n彼女を支えて\nあげて欲しい。"},
        { "location": "558/TALK"  , "narrator": "千羽鶴", "text": "何をするわけでもないけど\n傍で話を聞いてあげる\nだけで彼女は落ち着く。"},
        { "location": "559/TALK"  , "narrator": "千羽鶴", "text": "もちろん、\nやってもやらなくても、\nどちらでも。"},
        { "location": "561/TALK"  , "narrator": "千羽鶴", "text": "――というわけで、\n今回はおしまい。"},
        { "location": "562/TALK"  , "narrator": "千羽鶴", "text": "いよいよ次回で、私の\nラブラブトレーナーは\n全課程が修了、となる。"},
        { "location": "563/TALK"  , "narrator": "千羽鶴", "text": "今までありがとう。"},
        { "location": "564/SEL"   , "narrator": "", "text": "お疲れさまでした"},
        { "location": "565/SEL"   , "narrator": "", "text": "寂しいよ"},
        { "location": "566/SEL"   , "narrator": "", "text": "だいぶ前にも「ラブラブトレーナーは終わり」って言ってたような"},
        { "location": "567/ACT"   , "narrator": "", "text": "お疲れさまでした"},
        { "location": "568/TALK"  , "narrator": "千羽鶴", "text": "でも、\n本当に大変なのは\nこれから。"},
        { "location": "569/ACT"   , "narrator": "", "text": "寂しいよ"},
        { "location": "570/TALK"  , "narrator": "千羽鶴", "text": "大丈夫。\nお別れという\nわけではないから。"},
        { "location": "571/ACT"   , "narrator": "", "text": "だいぶ前にも「ラブラブトレーナーは終わり」って言ってたような"},
        { "location": "572/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "573/TALK"  , "narrator": "千羽鶴", "text": "あの時は、お客様として\nおもてなしするのはお終い\nという意味で使った。"},
        { "location": "574/TALK"  , "narrator": "千羽鶴", "text": "今回は正真正銘、\nいわゆる「レクチャ」の\n期間が終了する。"},
        { "location": "575/TALK"  , "narrator": "千羽鶴", "text": "こうやって段階的に、\n関係は進展していくの。"},
        { "location": "577/TALK"  , "narrator": "千羽鶴", "text": "色んな事があったけど、\nここまで来てくれて\n本当に感謝してる。"},
        { "location": "578/TALK"  , "narrator": "千羽鶴", "text": "それじゃまた次回。\nここで会いましょう。"},
        { "location": "579/TALK"  , "narrator": "千羽鶴", "text": "貴方とこの世界に\n素敵なココロの旅を。"},
        { "location": "111/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの全回線が\n切断されました。(981)"},
        { "location": "158/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの全回線が\n切断されました。(981)"},
