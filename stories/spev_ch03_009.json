    "info": {
        "story_id": "3009",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "水陸両用ガブちゃん"
    },
    "entry":
    [
        { "location": "35/TALK" , "narrator": "透明ガブリエラ", "text": "…想像してた以上に\n恥ずかしいんだけど？"},
        { "location": "36/TALK" , "narrator": "透明みやび", "text": "何言うてるが。\nめっちゃ可愛いぞね。"},
        { "location": "37/TALK" , "narrator": "透明アーヤ", "text": "ええ、とっても素敵よ、\nギャヴィ。"},
        { "location": "40/TALK" , "narrator": "透明ガブリエラ", "text": "嬉しくないから！\n中学生にもなって、\n浮き輪姿褒められても！"},
        { "location": "41/TALK" , "narrator": "透明みやび", "text": "いや、中学生とか\n関係ないと思うがよ？"},
        { "location": "42/TALK" , "narrator": "透明みやび", "text": "浮き輪は大人でも使う\n海やプールでの\n玩具やきね。"},
        { "location": "43/TALK" , "narrator": "透明アーヤ", "text": "そうよ。\n使わないなら、\n私が使おうかしら？"},
        { "location": "45/TALK" , "narrator": "透明ガブリエラ", "text": "えっ？　でもアーヤ、\n泳げなかったっけ？"},
        { "location": "47/TALK" , "narrator": "透明アーヤ", "text": "のんびり泳ぐなら、\nやっぱり浮き輪あった方が\n楽しいじゃない。"},
        { "location": "48/TALK" , "narrator": "透明アーヤ", "text": "小さな波を越えたり\nするの、楽しいし。"},
        { "location": "49/TALK" , "narrator": "透明みやび", "text": "あの、ユラ～ッ、って\n独特な感じは堪らんな。"},
        { "location": "50/TALK" , "narrator": "透明アーヤ", "text": "そういうこと。\nだから、使わないなら\n貸してもらえる？"},
        { "location": "51/SEL"  , "narrator": "（選択肢）", "text": "ガブリエラ専用です"},
        { "location": "52/ACT"  , "narrator": "", "text": "ガブリエラ専用です"},
        { "location": "54/TALK" , "narrator": "透明ガブリエラ", "text": "ちょ、$handle$！\nなに勝手なこと\n言ってるのよ！？"},
        { "location": "55/TALK" , "narrator": "透明アーヤ", "text": "そっか…。\nじゃ、私は向こうで\n肌でも焼こうかしら？"},
        { "location": "56/TALK" , "narrator": "透明みやび", "text": "ほほう、ならばうちは\nサンオイル塗り担当に\nなるとするぞね。"},
        { "location": "58/TALK" , "narrator": "透明アーヤ", "text": "…変な塗り方したら\n即クビよ？"},
        { "location": "63/TALK" , "narrator": "透明ガブリエラ", "text": "…もぅ！\n$handle$ってば\n勝手なこと言って！"},
        { "location": "64/TALK" , "narrator": "透明ガブリエラ", "text": "あんなにあたしが\n浮き輪を嫌がってたの、\nわからなかったの？"},
        { "location": "66/TALK" , "narrator": "透明ガブリエラ", "text": "こんなの使っても、\n全然面白くないわ。"},
        { "location": "67/SEL"  , "narrator": "（選択肢）", "text": "とっても可愛いよ？"},
        { "location": "68/SEL"  , "narrator": "（選択肢）", "text": "絶対楽しいよ"},
        { "location": "69/SEL"  , "narrator": "（選択肢）", "text": "とっても似合ってるのに？"},
        { "location": "70/ACT"  , "narrator": "", "text": "とっても可愛いよ？"},
        { "location": "72/TALK" , "narrator": "透明ガブリエラ", "text": "…ず、ズルいわ！"},
        { "location": "73/TALK" , "narrator": "透明ガブリエラ", "text": "$handle$に\nそう言われたら…、\n嫌って言えないじゃない。"},
        { "location": "74/TALK" , "narrator": "透明ガブリエラ", "text": "…でも、本当に\n可愛いって\n思ってくれてる？"},
        { "location": "75/SEL"  , "narrator": "（選択肢）", "text": "本当に思ってる"},
        { "location": "76/SEL"  , "narrator": "（選択肢）", "text": "可愛らしいよ"},
        { "location": "77/ACT"  , "narrator": "", "text": "本当に思ってる"},
        { "location": "79/TALK" , "narrator": "透明ガブリエラ", "text": "そう…。"},
        { "location": "80/TALK" , "narrator": "透明ガブリエラ", "text": "…なんか、ちょっとだけ\n嫌だって気持ち、\n薄れたかも…。"},
        { "location": "81/TALK" , "narrator": "透明ガブリエラ", "text": "…恥ずかしいのは、\nまだ残ってるけど。"},
        { "location": "82/ACT"  , "narrator": "", "text": "可愛らしいよ"},
        { "location": "85/TALK" , "narrator": "透明ガブリエラ", "text": "…なんでかしら？"},
        { "location": "86/TALK" , "narrator": "透明ガブリエラ", "text": "すっごい子供扱い\nされてるような気が\nするんだけど…？"},
        { "location": "87/TALK" , "narrator": "透明ガブリエラ", "text": "…ま、$handle$が\nそんなイジワルするはず\nないわよね。"},
        { "location": "89/ACT"  , "narrator": "", "text": "絶対楽しいよ"},
        { "location": "91/TALK" , "narrator": "透明ガブリエラ", "text": "…まあ、アーヤが言ってた\nみたいな遊び方は…。"},
        { "location": "92/TALK" , "narrator": "透明ガブリエラ", "text": "確かに浮き輪がないと\nできないことよね。"},
        { "location": "93/ACT"  , "narrator": "", "text": "とっても似合ってるのに？"},
        { "location": "95/TALK" , "narrator": "透明ガブリエラ", "text": "その似合ってるって\nなんなのよ？"},
        { "location": "96/TALK" , "narrator": "透明ガブリエラ", "text": "浮き輪が似合うって、\n子供扱いされてるような\n気持ちになるんだけど？"},
        { "location": "97/TALK" , "narrator": "透明ガブリエラ", "text": "…まさか、そういう\nことじゃないでしょうね？"},
        { "location": "98/SEL"  , "narrator": "（選択肢）", "text": "純粋に似合うと思っただけ"},
        { "location": "99/SEL"  , "narrator": "（選択肢）", "text": "…そんなわけないよ！"},
        { "location": "100/ACT" , "narrator": "", "text": "純粋に似合うと思っただけ"},
        { "location": "101/TALK", "narrator": "透明ガブリエラ", "text": "そ、そうだったの？"},
        { "location": "102/TALK", "narrator": "透明ガブリエラ", "text": "だとしたら…、ちょっと\n悪いこと言っちゃったかも\nしれないわね…。"},
        { "location": "103/SEL" , "narrator": "（選択肢）", "text": "キスしてくれたら許そう"},
        { "location": "104/SEL" , "narrator": "（選択肢）", "text": "信じてくれて嬉しい"},
        { "location": "105/ACT" , "narrator": "", "text": "キスしてくれたら許そう"},
        { "location": "107/TALK", "narrator": "透明ガブリエラ", "text": "は、はぁ！？"},
        { "location": "108/TALK", "narrator": "透明ガブリエラ", "text": "無理無理無理！\nそんなの無理だから！"},
        { "location": "109/TALK", "narrator": "透明ガブリエラ", "text": "ほら、アーヤたちだって\n向こうでこっち見てるし。"},
        { "location": "111/TALK", "narrator": "透明ガブリエラ", "text": "…二人っきりだったら、\n考えてあげなくも\nなかったけど…。"},
        { "location": "112/ACT" , "narrator": "", "text": "信じてくれて嬉しい"},
        { "location": "114/TALK", "narrator": "透明ガブリエラ", "text": "$handle$は\nあたしにウソついたり\nしないでしょ？"},
        { "location": "115/TALK", "narrator": "透明ガブリエラ", "text": "だから当然信じるわ。"},
        { "location": "117/TALK", "narrator": "透明ガブリエラ", "text": "…ウソだっていうのが\nわかったら、その時は\nお仕置きだけど。"},
        { "location": "119/ACT" , "narrator": "", "text": "…そんなわけないよ！"},
        { "location": "121/TALK", "narrator": "透明ガブリエラ", "text": "…すっごい\n怪しいんだけど？"},
        { "location": "122/TALK", "narrator": "透明ガブリエラ", "text": "でもまあ、あんまり\n$handle$を\n疑うのも悪いわね。"},
        { "location": "123/TALK", "narrator": "透明ガブリエラ", "text": "今回は信じてあげるわ。"},
        { "location": "127/TALK", "narrator": "透明ガブリエラ", "text": "…それじゃあ、\n今日は浮き輪を付けて\n海で遊ぶことにするわ。"},
        { "location": "128/TALK", "narrator": "透明ガブリエラ", "text": "アーヤ達もだけど、\n$handle$も、\n褒めてくれたし…。"},
        { "location": "129/SEL" , "narrator": "（選択肢）", "text": "おもいっきり楽しんでね"},
        { "location": "130/ACT" , "narrator": "", "text": "おもいっきり楽しんでね"},
        { "location": "132/TALK", "narrator": "透明ガブリエラ", "text": "そうね、遊ばないと\n勿体ないわ。"},
        { "location": "134/TALK", "narrator": "透明神楽", "text": "あ、つばめさん。\nガブちゃん達いましたよ。"},
        { "location": "135/TALK", "narrator": "透明つばめ", "text": "ガブちゃーん。\n一緒にビーチバレーして\n遊ぼー。"},
        { "location": "136/TALK", "narrator": "透明ガブリエラ", "text": "悪いけど、今日はちょっと\n沖まで泳ぐつもりなの。"},
        { "location": "137/TALK", "narrator": "透明神楽", "text": "そうなんですか…。\nって、まさかその浮き輪で\nですか？"},
        { "location": "138/TALK", "narrator": "透明ガブリエラ", "text": "そ、そうだけど…。"},
        { "location": "139/TALK", "narrator": "透明神楽", "text": "…ふふっ、その浮き輪、\nとってもガブちゃんに\n似合ってると思いますよ。"},
        { "location": "141/TALK", "narrator": "透明ガブリエラ", "text": "そ、そう…ありがと…。"},
        { "location": "142/SEL" , "narrator": "（選択肢）", "text": "ほら、みんな褒めてる"},
        { "location": "143/ACT" , "narrator": "", "text": "ほら、みんな褒めてる"},
        { "location": "145/TALK", "narrator": "透明ガブリエラ", "text": "…そうね。\nあたしの考え過ぎだった\nってことかしら？"},
        { "location": "146/TALK", "narrator": "透明つばめ", "text": "わたしも、その浮き輪\nとっても似合ってると\n思うよ。"},
        { "location": "149/TALK", "narrator": "透明つばめ", "text": "なんとなく、\n小学生の女の子っぽくて\n可愛いよね！"},
        { "location": "152/TALK", "narrator": "透明ガブリエラ", "text": "っ！？"},
        { "location": "153/TALK", "narrator": "透明神楽", "text": "ちょ、つばめさん！"},
        { "location": "154/TALK", "narrator": "透明つばめ", "text": "え？　なに、神楽ちゃん？"},
        { "location": "156/TALK", "narrator": "透明みやび", "text": "ぶふっ！！\nつ、つばめちゃんは\n流石やねぇ。"},
        { "location": "157/TALK", "narrator": "透明アーヤ", "text": "み、みやび！\nそんなこと言ったら…。"},
        { "location": "161/TALK", "narrator": "透明ガブリエラ", "text": "誰が小学生よ！！\n全員、ちょっとこっちに\n集まんなさーい！！"},
        { "location": "163/TALK", "narrator": "透明つばめ", "text": "ご、ごめんなさーい！"},
        { "location": "164/TALK", "narrator": "透明神楽", "text": "つばめさん、\n海へ逃げますよ！"},
        { "location": "165/TALK", "narrator": "透明みやび", "text": "アーヤ、\nうちらも行くぞね！"},
        { "location": "167/TALK", "narrator": "透明アーヤ", "text": "あ、ちょっと！\nまだオイル塗り途中\nなのに！"},
        { "location": "168/TALK", "narrator": "透明ガブリエラ", "text": "待てー、逃げるなー！"}
    ]
}
