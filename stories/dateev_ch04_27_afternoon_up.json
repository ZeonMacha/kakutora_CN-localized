        { "location": "119/TALK", "narrator": "みやび", "text": "フリーズか？"},
        { "location": "120/TALK", "narrator": "みやび", "text": "再起動か？"},
        { "location": "122/TALK", "narrator": "みやび", "text": "ダメダメやね"},
        { "location": "195/ACT" , "narrator": "", "text": "プレゼントあるよ"},
