    [
        { "location": "144/SCENARIO", "narrator": "", "text": "450_その気持ちは"},
        { "location": "169/TALK"    , "narrator": "ガブリエラ", "text": "$handle$は"},
        { "location": "170/TALK"    , "narrator": "ガブリエラ", "text": "使用人じゃないわ"},
        { "location": "171/TALK"    , "narrator": "ガブリエラ", "text": "違うかしら？"},
        { "location": "173/SEL"     , "narrator": "", "text": "違うね"},
        { "location": "174/SEL"     , "narrator": "", "text": "その方がいいの？"},
        { "location": "175/ACT"     , "narrator": "", "text": "違うね"},
        { "location": "176/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "177/TALK"    , "narrator": "ガブリエラ", "text": "私がそう言ったんだものね"},
        { "location": "178/ACT"     , "narrator": "", "text": "その方がいいの？"},
        { "location": "179/TALK"    , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "180/TALK"    , "narrator": "ガブリエラ", "text": "そうじゃないわ"},
        { "location": "181/TALK"    , "narrator": "ガブリエラ", "text": "そうじゃなくて"},
        { "location": "183/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ私たちって何なのかしら"},
        { "location": "185/SEL"     , "narrator": "", "text": "友達"},
        { "location": "186/SEL"     , "narrator": "", "text": "恋人"},
        { "location": "188/SEL"     , "narrator": "", "text": "兄妹"},
        { "location": "189/ACT"     , "narrator": "", "text": "友達"},
        { "location": "191/TALK"    , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "193/TALK"    , "narrator": "ガブリエラ", "text": "なの"},
        { "location": "195/TALK"    , "narrator": "ガブリエラ", "text": "かしらね・・・？"},
        { "location": "196/ACT"     , "narrator": "", "text": "恋人"},
        { "location": "206/TALK"    , "narrator": "ガブリエラ", "text": "すぐそうやって"},
        { "location": "207/TALK"    , "narrator": "ガブリエラ", "text": "気安く言うけど"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんとしたことは"},
        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "何でもない！"},
        { "location": "211/ACT"     , "narrator": "", "text": "兄妹"},
        { "location": "212/TALK"    , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "考えたことはなかったわ"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "・・・・・"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "考えなきゃいけないわよね"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "私たちのこと"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "違うかしら？"},
        { "location": "220/SEL"     , "narrator": "", "text": "そうだね"},
        { "location": "221/SEL"     , "narrator": "", "text": "別によくない？"},
        { "location": "222/ACT"     , "narrator": "", "text": "そうだね"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "ええと・・・"},
        { "location": "234/TALK"    , "narrator": "ガブリエラ", "text": "考えがまとまったら"},
        { "location": "235/TALK"    , "narrator": "ガブリエラ", "text": "聞いてくれる？"},
        { "location": "237/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "238/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "241/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "247/TALK"    , "narrator": "ボイスメール", "text": "いい結果なら信じるわ"},
        { "location": "265/ACT"     , "narrator": "", "text": "別によくない？"},
        { "location": "266/TALK"    , "narrator": "ガブリエラ", "text": "そんな言い方酷い"},
        { "location": "267/TALK"    , "narrator": "ガブリエラ", "text": "ばか！！！！！！！！！"},
        { "location": "202/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>900pt.</b></color></size>\nアップしました！"},
        { "location": "228/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>900pt.</b></color></size>\nアップしました！"},
