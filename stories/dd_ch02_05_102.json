{
    "dir": "chap05/daydra/dd_ch02_05_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "5205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "劇場の日常＜後編＞"
    },
    "entry":
    [
        { "location": "394/SCENARIO", "narrator": "", "text": "幽霊の出る指令本部"},
        { "location": "421/TALK"    , "narrator": "アーヤ", "text": "…私ってば、\n何悩んでるのかしら。"},
        { "location": "422/TALK"    , "narrator": "アーヤ", "text": "嫌われるかもとか、\nそんな理由で言葉に\n詰まるなんて――"},
        { "location": "423/TALK"    , "narrator": "アーヤ", "text": "リーダーとしても、\n先輩としても\n失格よね。"},
        { "location": "424/TALK"    , "narrator": "アーヤ", "text": "私は、自分が正しいと\n思ったことを貫く。"},
        { "location": "425/TALK"    , "narrator": "アーヤ", "text": "…うん、もう大丈夫。"},
        { "location": "429/TALK"    , "narrator": "アーヤ", "text": "ほら、二人とも！\n文句を言うのは\nそこまでよ。"},
        { "location": "434/TALK"    , "narrator": "アーヤ", "text": "もう時間だから、\nさっさと仕事始める！"},
        { "location": "435/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "436/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "439/TALK"    , "narrator": "みやび", "text": "…ま、そうやね。\nまほさんに怒られ\nたくないし。"},
        { "location": "441/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…わかった。\n働くわよ…。"},
        { "location": "442/TALK"    , "narrator": "アーヤ", "text": "そ、そう？\nわかってくれれば\nいいのよ。"},
        { "location": "446/TALK"    , "narrator": "アーヤ", "text": "…なんか、あっさり\n聞いてくれたわね？"},
        { "location": "448/TALK"    , "narrator": "アーヤ", "text": "やっぱり、ガツンと\n言うことも必要、って\nことかしら。"},
        { "location": "452/TALK"    , "narrator": "アーヤ", "text": "…心配し過ぎだった\nかしら。"},
        { "location": "453/TALK"    , "narrator": "アーヤ", "text": "悪い子達じゃないん\nだから、少しキツく\n言ったって――"},
        { "location": "455/TALK"    , "narrator": "アーヤ", "text": "正しいことなら\n嫌われたりなんて\nしないのに…。"},
        { "location": "461/TALK"    , "narrator": "アーヤ", "text": "それじゃ、急いで\n持ち場について。"},
        { "location": "462/TALK"    , "narrator": "みやび", "text": "あいあい。\n労働スタートぞね。"},
        { "location": "463/TALK"    , "narrator": "ガブリエラ", "text": "ま、仕事なんて\n言っても――"},
        { "location": "486/TALK"    , "narrator": "ガブリエラ", "text": "――いつも通り、\nお客なんてほとんど\n来やしないんだから。"},
        { "location": "487/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…退屈…。\nん？"},
        { "location": "491/TALK"    , "narrator": "女子高校生Ａ", "text": "ほら、急いで急いで！\n始まっちゃうよ。"},
        { "location": "493/TALK"    , "narrator": "男子高校生Ａ", "text": "そんな急がなくても\n平気だって。"},
        { "location": "495/TALK"    , "narrator": "ガブリエラ", "text": "えっ、お客！？"},
        { "location": "496/TALK"    , "narrator": "ガブリエラ", "text": "いらっしゃいませ。"},
        { "location": "498/TALK"    , "narrator": "女子高校生Ａ", "text": "チケット二枚と\nポップコーン\nください。"},
        { "location": "500/TALK"    , "narrator": "ガブリエラ", "text": "あ、はい。\nこちらになりますね。"},
        { "location": "502/TALK"    , "narrator": "女子高校生Ａ", "text": "ありがと。"},
        { "location": "504/TALK"    , "narrator": "ガブリエラ", "text": "…アーヤが強く言って\nくれて、助かったわ。"},
        { "location": "505/TALK"    , "narrator": "ガブリエラ", "text": "もし勝手に閉店してて\nクレームが来たら――"},
        { "location": "506/TALK"    , "narrator": "ガブリエラ", "text": "まほに大目玉くらう\nとこだったわ…。"},
        { "location": "508/TALK"    , "narrator": "男子高校生Ａ", "text": "ってか、超古い映画\nみたいだけど、\n面白いのか？"},
        { "location": "510/TALK"    , "narrator": "女子高校生Ａ", "text": "超名作中の名作よ！\nすっごい泣けるん\nだから！"},
        { "location": "512/TALK"    , "narrator": "女子高校生Ａ", "text": "ほら、早く行こ！"},
        { "location": "514/TALK"    , "narrator": "男子高校生Ａ", "text": "お、おい、\n引っ張んなって！"},
        { "location": "519/TALK"    , "narrator": "ガブリエラ", "text": "…あの二人、\n多分カップルよね？"},
        { "location": "521/TALK"    , "narrator": "ガブリエラ", "text": "いいなぁ…。\nあたしも、いつかは\nあんな風に…。"},
        { "location": "525/TALK"    , "narrator": "男子高校生Ｂ", "text": "すいません。\nチケット一枚とコーヒー、\nお願いします"},
        { "location": "528/TALK"    , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "529/TALK"    , "narrator": "男子高校生Ｂ", "text": "？"},
        { "location": "532/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "533/TALK"    , "narrator": "男子高校生Ｂ", "text": "あ、ああ、どうも…。"},
        { "location": "538/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "539/TALK"    , "narrator": "ガブリエラ", "text": "男の人とまともに\n喋れないんだし、\nカップルはムリね…。"},
        { "location": "541/TALK"    , "narrator": "ガブリエラ", "text": "…それにしても、\n相変わらずお客が\n少ないわね。"},
        { "location": "542/TALK"    , "narrator": "ガブリエラ", "text": "ただでさえ少ないのに\nフェノメノンが\n出現したら――"},
        { "location": "543/TALK"    , "narrator": "ガブリエラ", "text": "すぐに上映中止で\n指令室に切り替わるん\nだもの。"},
        { "location": "544/TALK"    , "narrator": "ガブリエラ", "text": "指令室兼用じゃ\nなかったら、\n今頃潰れてるわね…。"},
        { "location": "545/TALK"    , "narrator": "ガブリエラ", "text": "…暇だし、みやびの\nところにでも\n行ってみようかしら。"},
        { "location": "572/TALK"    , "narrator": "みやび", "text": "ふぅ…。\nまったく、忙しゅうて\n堪らんなぁ…。"},
        { "location": "575/TALK"    , "narrator": "ガブリエラ", "text": "…どの口が言うのよ？\nネットの記事見てる\nだけじゃない。"},
        { "location": "578/TALK"    , "narrator": "みやび", "text": "おお、ガブちゃん。\n別にさぼっちょる\nわけやないがよ？"},
        { "location": "580/TALK"    , "narrator": "みやび", "text": "フィルムをデータ\nベースに入れるだけの\n簡単な仕事は――"},
        { "location": "583/TALK"    , "narrator": "みやび", "text": "開始五分でミッション\nコンプリートや。"},
        { "location": "585/TALK"    , "narrator": "ガブリエラ", "text": "だから遊んでたの？\nアーヤに見つかったら\nどやされるわよ？"},
        { "location": "588/TALK"    , "narrator": "みやび", "text": "何言うてるが？\n本当は部屋に戻りたい\nところやけんど――"},
        { "location": "589/TALK"    , "narrator": "みやび", "text": "いなければならんき、\nこうして残っちょる\nがよ。"},
        { "location": "590/TALK"    , "narrator": "みやび", "text": "空いた時間に\n何しようと、\nうちの自由や。"},
        { "location": "591/TALK"    , "narrator": "ガブリエラ", "text": "…まあ、バイト終わり\nまでぼーっとしてる\nわけにもいかないか。"},
        { "location": "592/TALK"    , "narrator": "みやび", "text": "そういうことや。"},
        { "location": "594/TALK"    , "narrator": "みやび", "text": "…しっかし、戦闘後に\nフルタイムのバイト\nさせるなんて――"},
        { "location": "596/TALK"    , "narrator": "みやび", "text": "まほさんは鬼やね。"},
        { "location": "597/TALK"    , "narrator": "ガブリエラ", "text": "五分で終わらせた人の\nセリフじゃないわよ？"},
        { "location": "600/TALK"    , "narrator": "ガブリエラ", "text": "…でも、暇してるのは\nあたしだけじゃない\nみたいね。"},
        { "location": "603/TALK"    , "narrator": "みやび", "text": "なんや、ガブちゃんは\n暇つぶしを所望か？"},
        { "location": "606/TALK"    , "narrator": "みやび", "text": "それなら特別に、\n面白い物を\n見せちゃる。"},
        { "location": "610/TALK"    , "narrator": "みやび", "text": "実はこのＰＣ、本庁と\n繋がっちょって――"},
        { "location": "611/TALK"    , "narrator": "みやび", "text": "うちらにクランを\n送るサーバーとも\n繋がっちょるんよ。"},
        { "location": "612/TALK"    , "narrator": "ガブリエラ", "text": "え！？"},
        { "location": "614/TALK"    , "narrator": "みやび", "text": "つまり、このＰＣを\nちくっと弄れば――"},
        { "location": "615/TALK"    , "narrator": "みやび", "text": "クラン達とチャットで\n会話することも\n可能っちゅうことや！"},
        { "location": "617/TALK"    , "narrator": "ガブリエラ", "text": "いや、それマズいん\nじゃないの？"},
        { "location": "618/TALK"    , "narrator": "ガブリエラ", "text": "それに、劇場で映画\nやってる間って――"},
        { "location": "621/TALK"    , "narrator": "ガブリエラ", "text": "クラン達も寝てるから\n出てこれないはず\nだけど…。"},
        { "location": "623/TALK"    , "narrator": "みやび", "text": "まあ、出てこられたら\n大騒ぎになるきね。"},
        { "location": "624/TALK"    , "narrator": "みやび", "text": "けんど裏ではちゃんと\n繋がっちょるき、\n会話くらいは可能や。"},
        { "location": "629/TALK"    , "narrator": "みやび", "text": "よし、ガブちゃん。\nスマホのチャット画面\n開いてみぃ。"},
        { "location": "642/TALK"    , "narrator": "ガブリエラ", "text": "誰かいるの？"},
        { "location": "644/TALK"    , "narrator": "コルト", "text": "あれ！？"},
        { "location": "645/TALK"    , "narrator": "コルト", "text": "ギャヴィ姉さんッスか！？"},
        { "location": "646/TALK"    , "narrator": "ガブリエラ", "text": "コルト！？"},
        { "location": "647/TALK"    , "narrator": "ガブリエラ", "text": "スゴい！"},
        { "location": "648/TALK"    , "narrator": "ガブリエラ", "text": "まさか、こんな風に話せるなんて思わなかったわ"},
        { "location": "649/TALK"    , "narrator": "ガブリエラ", "text": "今って、スクリーンの中にいるのよね？"},
        { "location": "650/TALK"    , "narrator": "ガブリエラ", "text": "みんな、どんな感じでいるの？"},
        { "location": "652/TALK"    , "narrator": "コルト", "text": "みんな、のんびりしてるッス"},
        { "location": "653/TALK"    , "narrator": "コルト", "text": "ここが俺達の家ッスからね"},
        { "location": "654/TALK"    , "narrator": "ガブリエラ", "text": "そうなんだ？"},
        { "location": "655/TALK"    , "narrator": "コルト", "text": "それじゃ、引き続きバイト頑張ってください"},
        { "location": "666/TALK"    , "narrator": "ガブリエラ", "text": "…凄いわ！\n本当にコルトと\nチャットしちゃった！"},
        { "location": "668/TALK"    , "narrator": "みやび", "text": "驚くのはまだまだや。\n呼び出せるんは\nコルトだけやない。"},
        { "location": "669/TALK"    , "narrator": "みやび", "text": "例えば、こうすると\nとうちゃんが――"},
        { "location": "677/TALK"    , "narrator": "みやび", "text": "…………あかん。\nやってもうた。"},
        { "location": "679/TALK"    , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "697/TALK"    , "narrator": "アーヤ", "text": "ぐすっ…、\nう、ううっ…。"},
        { "location": "698/TALK"    , "narrator": "アーヤ", "text": "この映画、やばいわ。\nまさかこんなに泣ける\nなんて…。"},
        { "location": "701/TALK"    , "narrator": "アーヤ", "text": "……え？"},
        { "location": "703/TALK"    , "narrator": "アーヤ", "text": "えぇっ！？"},
        { "location": "719/TALK"    , "narrator": "とうちゃん", "text": "な、何だこりゃ！？\nまだ上映中じゃ\nねぇか！"},
        { "location": "720/TALK"    , "narrator": "男子高校生Ａ", "text": "は？　なんか急に\n３Ｄになったぞ？"},
        { "location": "721/TALK"    , "narrator": "女子高校生Ａ", "text": "うわぁ、カワイイ！\nでも、こんなシーン\nあったかしら？"},
        { "location": "737/TALK"    , "narrator": "アーヤ", "text": "な、何でとうちゃんが\n出てきて――"},
        { "location": "738/TALK"    , "narrator": "アーヤ", "text": "…まさか！！\nみやびが\n何かやったんじゃ！？"},
        { "location": "740/TALK"    , "narrator": "アーヤ", "text": "みやび！！\nどこなの、みやび！？"},
        { "location": "751/TALK"    , "narrator": "男子高校生Ｂ", "text": "へぇ、この映画館は\nグラス無しで３Ｄが\n楽しめるんだ…。"},
        { "location": "752/TALK"    , "narrator": "とうちゃん", "text": "は？　スリージー？\n何言ってやがんだ\nこいつ？"},
        { "location": "753/TALK"    , "narrator": "男子高校生Ｂ", "text": "えっ！？　俺の声に\n反応を…いやいや、\nまさか…。"},
        { "location": "754/TALK"    , "narrator": "とうちゃん", "text": "おいおい、どうなって\nやがんだばーろー！？\n誰か説明しろ！！"},
        { "location": "782/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、みやび！\nどうするのよこれ！？"},
        { "location": "783/TALK"    , "narrator": "みやび", "text": "…映画とは、現実とは\n違う夢の世界を見る\nための娯楽や。"},
        { "location": "784/TALK"    , "narrator": "みやび", "text": "お客達も、３Ｄ映画\nにしか思わんき、\nそう大事には――"},
        { "location": "789/TALK"    , "narrator": "アーヤ", "text": "ちょっと！\n何やってるの！？"},
        { "location": "792/TALK"    , "narrator": "みやび", "text": "…しもた。"},
        { "location": "825/TALK"    , "narrator": "真幌", "text": "おまえ等、一体何を\n考えているんだ！？"},
        { "location": "826/TALK"    , "narrator": "真幌", "text": "一歩間違えば、\nここが我々の指令室\nだというのが――"},
        { "location": "827/TALK"    , "narrator": "真幌", "text": "世間にバレていた\nかもしれないん\nだぞ！？"},
        { "location": "829/TALK"    , "narrator": "ガブリエラ", "text": "あ、あの…、あたしは\n関係ないんだけど…。"},
        { "location": "831/TALK"    , "narrator": "真幌", "text": "うるさい！\n止めなかったおまえも\n同罪だ！！"},
        { "location": "833/TALK"    , "narrator": "ガブリエラ", "text": "理不尽だわ…。"},
        { "location": "835/TALK"    , "narrator": "真幌", "text": "大体だな、本庁の\nＰＣに不正アクセス\nしただけでも――"},
        { "location": "836/TALK"    , "narrator": "真幌", "text": "本来なら懲役もんだ！\nわかっているのか！？"},
        { "location": "837/TALK"    , "narrator": "みやび", "text": "すみません。"},
        { "location": "839/TALK"    , "narrator": "みやび", "text": "けんど、本庁があんな\nザルセキュリティとは\n思わなくて…。"},
        { "location": "842/TALK"    , "narrator": "真幌", "text": "そのザルに、どれだけ\n予算が掛けられてるか\nわかってんのか！？"},
        { "location": "845/TALK"    , "narrator": "真幌", "text": "…いや、しかし簡単に\nハックされた本庁にも\n非はあるな。"},
        { "location": "846/TALK"    , "narrator": "真幌", "text": "それに、とりあえず\n大事にはならずに\nすんだようだし…。"},
        { "location": "849/TALK"    , "narrator": "アーヤ", "text": "お客さんが\n３人だけだったのも\n幸いでした。"},
        { "location": "850/TALK"    , "narrator": "アーヤ", "text": "幽霊が出た、という\nことにして――"},
        { "location": "851/TALK"    , "narrator": "アーヤ", "text": "謝罪と口止め料で\nどうにかなったので。"},
        { "location": "854/TALK"    , "narrator": "真幌", "text": "…まあ、それなら\n今回だけは大目に\nみてやるが――"},
        { "location": "857/TALK"    , "narrator": "真幌", "text": "今度やったら…、\n本気で殴るからな？"},
        { "location": "858/TALK"    , "narrator": "みやび", "text": "すみません！"},
        { "location": "859/TALK"    , "narrator": "ガブリエラ", "text": "ごめんなさい！"},
        { "location": "862/TALK"    , "narrator": "真幌", "text": "ったく…ただでさえ\n機密性を高めなければ\nならないのに…。"},
        { "location": "863/TALK"    , "narrator": "アーヤ", "text": "やっぱり、本庁には\n連絡するんですか？"},
        { "location": "865/TALK"    , "narrator": "真幌", "text": "当然だ。\nパスワードの変更は\nもちろん――"},
        { "location": "866/TALK"    , "narrator": "真幌", "text": "セキュリティの強化も\nしなければならなく\nなったからな。"},
        { "location": "867/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "870/TALK"    , "narrator": "真幌", "text": "とにかく、反省しろ。\nバカ者どもが…。"},
        { "location": "876/TALK"    , "narrator": "ガブリエラ", "text": "…まったく。\nみやびのせいで\n酷い目にあったわ。"},
        { "location": "877/TALK"    , "narrator": "みやび", "text": "ふむ…セキュリティを\n上げる事態にさせて\nしもうたか…。"},
        { "location": "879/TALK"    , "narrator": "アーヤ", "text": "もうお遊びができなく\nなるわね。\nそんなにブルー？"},
        { "location": "882/TALK"    , "narrator": "みやび", "text": "まさか。\nどちらかっちゅうと、\nレッドやね。"},
        { "location": "883/TALK"    , "narrator": "みやび", "text": "うちに対抗して\nセキュリティを上げる\nっちゅうことは――"},
        { "location": "884/TALK"    , "narrator": "みやび", "text": "うちへの挑戦状と\nみなして間違いなし！"},
        { "location": "886/TALK"    , "narrator": "ガブリエラ", "text": "大間違いよ！！"},
        { "location": "889/TALK"    , "narrator": "みやび", "text": "久しぶりに\n燃えてきたぞね！"},
        { "location": "893/TALK"    , "narrator": "みやび", "text": "セキュリティ破ったら\nまたガブちゃんに\n教えちゃるきね。"},
        { "location": "895/TALK"    , "narrator": "ガブリエラ", "text": "あたしを\n巻き込まないで！"},
        { "location": "898/TALK"    , "narrator": "アーヤ", "text": "はぁ…、一度本当に\n殴られないと\nダメみたいね…。"},
        { "location": "909/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【03 赤い髪の転校生】"}
    ]
}
