{
    "dir": "chap36/daydra/dd_ch04_36_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "36405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "ないはずの思い出＜後編＞"
    },
    "entry":
    [
        { "location": "497/SCENARIO", "narrator": "", "text": "わかること、わかったこと"},
        { "location": "517/TALK"    , "narrator": "みやび", "text": "…なごちゃん…。"},
        { "location": "518/TALK"    , "narrator": "みやび", "text": "なごちゃんはやっぱり\nフェノメノンで死んだや\nなかったぞね……。"},
        { "location": "519/SEL"     , "narrator": "", "text": "フェノメノン知ってるの？"},
        { "location": "520/SEL"     , "narrator": "", "text": "あれ？　さっきまでは…"},
        { "location": "521/SEL"     , "narrator": "", "text": "みやびはどういうみやびなの？"},
        { "location": "522/ACT"     , "narrator": "", "text": "フェノメノン知ってるの？"},
        { "location": "523/TALK"    , "narrator": "みやび", "text": "当然ちや。"},
        { "location": "524/ACT"     , "narrator": "", "text": "あれ？　さっきまでは…"},
        { "location": "525/TALK"    , "narrator": "みやび", "text": "どういた？"},
        { "location": "526/ACT"     , "narrator": "", "text": "みやびはどういうみやびなの？"},
        { "location": "527/TALK"    , "narrator": "みやび", "text": "どういうって\nいつも通りの\nみやびさんぞね。"},
        { "location": "529/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "530/TALK"    , "narrator": "みやび", "text": "フェノメノンを知らん\nうちと知っとるうちは\nどこで別れた？"},
        { "location": "531/SEL"     , "narrator": "", "text": "そこ最重要ポイント"},
        { "location": "532/SEL"     , "narrator": "", "text": "違う世界線のみやびってこと？"},
        { "location": "533/SEL"     , "narrator": "", "text": "実はみやびは双子？？？"},
        { "location": "534/ACT"     , "narrator": "", "text": "そこ最重要ポイント"},
        { "location": "535/TALK"    , "narrator": "みやび", "text": "…けんどわからん。"},
        { "location": "536/ACT"     , "narrator": "", "text": "違う世界線のみやびってこと？"},
        { "location": "537/TALK"    , "narrator": "みやび", "text": "そういうことに\nなるんかね。"},
        { "location": "538/ACT"     , "narrator": "", "text": "実はみやびは双子？？？"},
        { "location": "539/TALK"    , "narrator": "みやび", "text": "それは絶対にない。\n……はず。"},
        { "location": "541/TALK"    , "narrator": "みやび", "text": "それと。なごちゃんは\nたぶん死んどらん。"},
        { "location": "542/TALK"    , "narrator": "みやび", "text": "どこにおるんか……。\n知らんか？"},
        { "location": "543/SEL"     , "narrator": "", "text": "ごめん"},
        { "location": "544/SEL"     , "narrator": "", "text": "知らないんだ"},
        { "location": "545/SEL"     , "narrator": "", "text": "誰に聞けばいいかな"},
        { "location": "546/ACT"     , "narrator": "", "text": "ごめん"},
        { "location": "547/TALK"    , "narrator": "みやび", "text": "謝る必要はないけんど。"},
        { "location": "548/ACT"     , "narrator": "", "text": "知らないんだ"},
        { "location": "549/TALK"    , "narrator": "みやび", "text": "それは残念。"},
        { "location": "550/ACT"     , "narrator": "", "text": "誰に聞けばいいかな"},
        { "location": "551/TALK"    , "narrator": "みやび", "text": "うちが聞きたい。"},
        { "location": "553/TALK"    , "narrator": "みやび", "text": "使えんな。\nしかしそれでこそ\n$handle$。"},
        { "location": "555/TALK"    , "narrator": "みやび", "text": "うちはそんな相棒が\n意外と気にいっちゅう。"},
        { "location": "556/SEL"     , "narrator": "", "text": "それってラブ？"},
        { "location": "557/SEL"     , "narrator": "", "text": "みやびの方がかわいいよ"},
        { "location": "558/SEL"     , "narrator": "", "text": "デレいただきましたー！"},
        { "location": "559/ACT"     , "narrator": "", "text": "それってラブ？"},
        { "location": "560/TALK"    , "narrator": "みやび", "text": "…そう思ってくれても\nえいよ。"},
        { "location": "561/ACT"     , "narrator": "", "text": "みやびの方がかわいいよ"},
        { "location": "562/TALK"    , "narrator": "みやび", "text": "見た目の話とは\nちっくと違うき。"},
        { "location": "563/ACT"     , "narrator": "", "text": "デレいただきましたー！"},
        { "location": "564/TALK"    , "narrator": "みやび", "text": "そういう\n言い方をするなら\n返してもらうき。"},
        { "location": "566/SEL"     , "narrator": "", "text": "なごちゃんのことで"},
        { "location": "567/SEL"     , "narrator": "", "text": "これってヒントになるかな"},
        { "location": "568/SEL"     , "narrator": "", "text": "多分なんだけど"},
        { "location": "569/ACT"     , "narrator": "", "text": "なごちゃんのことで"},
        { "location": "570/TALK"    , "narrator": "みやび", "text": "何ぞあるんかね。"},
        { "location": "571/ACT"     , "narrator": "", "text": "これってヒントになるかな"},
        { "location": "572/TALK"    , "narrator": "みやび", "text": "まず聞いてみるちや。"},
        { "location": "573/ACT"     , "narrator": "", "text": "多分なんだけど"},
        { "location": "574/TALK"    , "narrator": "みやび", "text": "期待して聞こう。"},
        { "location": "576/SEL"     , "narrator": "", "text": "つばめとなごちゃんの症状が似てる"},
        { "location": "577/SEL"     , "narrator": "", "text": "なごちゃんはつばめより先に発症したんじゃないかな"},
        { "location": "578/ACT"     , "narrator": "", "text": "つばめとなごちゃんの症状が似てる"},
        { "location": "579/TALK"    , "narrator": "みやび", "text": "…なるほど。"},
        { "location": "580/ACT"     , "narrator": "", "text": "なごちゃんはつばめより先に発症したんじゃないかな"},
        { "location": "581/TALK"    , "narrator": "みやび", "text": "……。"},
        { "location": "583/TALK"    , "narrator": "みやび", "text": "ちうことは……。"},
        { "location": "586/TALK"    , "narrator": "みやび", "text": "ふむ……。\n確かに。"},
        { "location": "587/TALK"    , "narrator": "みやび", "text": "逢瀬つばめと\nなごちゃんは同じ\n病気やったかもしれん。"},
        { "location": "590/TALK"    , "narrator": "みやび", "text": "ちうことはなごちゃんは\nどこかでフェノメノンを\n展開ちょるとか…？"},
        { "location": "591/TALK"    , "narrator": "みやび", "text": "あるいはエンタングルに\n囚われちゅう…？"},
        { "location": "592/TALK"    , "narrator": "みやび", "text": "……けんど……。"},
        { "location": "593/TALK"    , "narrator": "みやび", "text": "うちがフェノム計画に\n加わった時は逢瀬つばめの\n名前しか見とらん。"},
        { "location": "594/TALK"    , "narrator": "みやび", "text": "これはどういうこと\n何やろうかね…？"},
        { "location": "595/SEL"     , "narrator": "", "text": "なごちゃんで既に実験済みで失敗してたとか？"},
        { "location": "596/SEL"     , "narrator": "", "text": "被検体毎に計画が進行してたんじゃない？"},
        { "location": "597/SEL"     , "narrator": "", "text": "別の役目があったんじゃない？"},
        { "location": "598/SEL"     , "narrator": "", "text": "エンタングルはなごちゃんに無関係"},
        { "location": "599/ACT"     , "narrator": "", "text": "なごちゃんで既に実験済みで失敗してたとか？"},
        { "location": "600/TALK"    , "narrator": "みやび", "text": "…やったら失敗例として\n内容が共有されとらんと\nおかしいき。"},
        { "location": "601/TALK"    , "narrator": "みやび", "text": "成功例より失敗例の\n分析の方が大事やきね。"},
        { "location": "602/TALK"    , "narrator": "みやび", "text": "仮に名前は非公開\nやったとしてもそんな\n話は聞いとらん。"},
        { "location": "603/ACT"     , "narrator": "", "text": "被検体毎に計画が進行してたんじゃない？"},
        { "location": "604/TALK"    , "narrator": "みやび", "text": "その可能性は十分に\nありえる。"},
        { "location": "605/TALK"    , "narrator": "みやび", "text": "けんど。その切れっ端も\nうちに掴めんことが\nありゆうかね？"},
        { "location": "606/ACT"     , "narrator": "", "text": "別の役目があったんじゃない？"},
        { "location": "607/TALK"    , "narrator": "みやび", "text": "別？"},
        { "location": "608/TALK"    , "narrator": "みやび", "text": "仮に別の役目が\nあったとして。\nそれは何ぞね？"},
        { "location": "609/TALK"    , "narrator": "みやび", "text": "…言うたちそもそも\n二人の力も把握できて\nおらんきね。"},
        { "location": "610/TALK"    , "narrator": "みやび", "text": "まずはそこからやね。"},
        { "location": "611/ACT"     , "narrator": "", "text": "エンタングルはなごちゃんに無関係"},
        { "location": "612/TALK"    , "narrator": "みやび", "text": "なるほど解決。"},
        { "location": "613/TALK"    , "narrator": "みやび", "text": "いやそんなわけが\nないろう。"},
        { "location": "614/TALK"    , "narrator": "みやび", "text": "相手は病院にも手が\n回せるほどの大がかりな\n組織。"},
        { "location": "615/TALK"    , "narrator": "みやび", "text": "仮に無関係やったら\nうちには存在すら\n掴めちょらん相手や。"},
        { "location": "617/TALK"    , "narrator": "みやび", "text": "そんなことは\nさすがに考えられん。"},
        { "location": "619/TALK"    , "narrator": "みやび", "text": "…なあお前さん。"},
        { "location": "620/TALK"    , "narrator": "みやび", "text": "今は情報が\n足りなさすぎる。"},
        { "location": "621/TALK"    , "narrator": "みやび", "text": "調査の手伝いを\nしてもろうても\nえいかね。"},
        { "location": "622/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "623/SEL"     , "narrator": "", "text": "$me$は協力しない"},
        { "location": "624/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "625/TALK"    , "narrator": "みやび", "text": "…ありがとう。\nご協力感謝する。"},
        { "location": "626/TALK"    , "narrator": "みやび", "text": "けんど。"},
        { "location": "627/TALK"    , "narrator": "みやび", "text": "$handle$の\n知っとるうちは\n今のうちと違うろう？"},
        { "location": "628/SEL"     , "narrator": "", "text": "それがどうしたの？"},
        { "location": "629/SEL"     , "narrator": "", "text": "みやびはみやびでしょ"},
        { "location": "630/SEL"     , "narrator": "", "text": "$me$が協力したいだけ"},
        { "location": "631/ACT"     , "narrator": "", "text": "それがどうしたの？"},
        { "location": "633/TALK"    , "narrator": "みやび", "text": "$handle$は\n気にならんかね？"},
        { "location": "634/ACT"     , "narrator": "", "text": "みやびはみやびでしょ"},
        { "location": "635/TALK"    , "narrator": "みやび", "text": "それはそうなんや\nけんど…。"},
        { "location": "636/ACT"     , "narrator": "", "text": "$me$が協力したいだけ"},
        { "location": "638/TALK"    , "narrator": "みやび", "text": "そのことには感謝しとる。"},
        { "location": "640/SEL"     , "narrator": "", "text": "どんなみやびでもみやびはみやび"},
        { "location": "641/SEL"     , "narrator": "", "text": "みやびの役に立ちたいんだ"},
        { "location": "642/SEL"     , "narrator": "", "text": "だって$me$はみやびの相棒でしょ"},
        { "location": "643/ACT"     , "narrator": "", "text": "どんなみやびでもみやびはみやび"},
        { "location": "644/TALK"    , "narrator": "みやび", "text": "どんなうちでも…。"},
        { "location": "645/ACT"     , "narrator": "", "text": "みやびの役に立ちたいんだ"},
        { "location": "646/TALK"    , "narrator": "みやび", "text": "…そうか…。"},
        { "location": "647/ACT"     , "narrator": "", "text": "だって$me$はみやびの相棒でしょ"},
        { "location": "648/TALK"    , "narrator": "みやび", "text": "そうやね。\n相棒やき。"},
        { "location": "650/TALK"    , "narrator": "みやび", "text": "………。"},
        { "location": "651/TALK"    , "narrator": "みやび", "text": "よし。"},
        { "location": "652/TALK"    , "narrator": "みやび", "text": "ほいたらチキチキ\n働いてもらうぞね、\n相棒。"},
        { "location": "653/TALK"    , "narrator": "みやび", "text": "つばめちゃんと\nなごちゃんのためにも。"},
        { "location": "654/SEL"     , "narrator": "", "text": "一番はみやびのためだよ"},
        { "location": "655/SEL"     , "narrator": "", "text": "つばめちゃんって言った"},
        { "location": "656/SEL"     , "narrator": "", "text": "$me$にどーんと任せて！"},
        { "location": "657/ACT"     , "narrator": "", "text": "一番はみやびのためだよ"},
        { "location": "658/TALK"    , "narrator": "みやび", "text": "よう言うた。"},
        { "location": "659/ACT"     , "narrator": "", "text": "つばめちゃんって言った"},
        { "location": "660/TALK"    , "narrator": "みやび", "text": "被検体でのうて\n仲間やきね、\nつばめちゃんは。"},
        { "location": "661/ACT"     , "narrator": "", "text": "$me$にどーんと任せて！"},
        { "location": "662/TALK"    , "narrator": "みやび", "text": "すぐ調子に乗るのが\n悪い癖やね、相棒の。"},
        { "location": "664/TALK"    , "narrator": "みやび", "text": "なごちゃんの真実に\n一歩近づけたのは\n相棒のおかげやき。"},
        { "location": "665/SEL"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "666/SEL"     , "narrator": "", "text": "その通り！！！！"},
        { "location": "667/SEL"     , "narrator": "", "text": "そうかなあ…"},
        { "location": "668/ACT"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "669/TALK"    , "narrator": "みやび", "text": "謙遜せんでもえいき。"},
        { "location": "670/ACT"     , "narrator": "", "text": "その通り！！！！"},
        { "location": "671/TALK"    , "narrator": "みやび", "text": "どんだけドヤ顔なんかね。\n…まあえいけんど。"},
        { "location": "672/ACT"     , "narrator": "", "text": "そうかなあ…"},
        { "location": "673/TALK"    , "narrator": "みやび", "text": "無自覚なんやねえ。"},
        { "location": "675/TALK"    , "narrator": "みやび", "text": "相棒が隣におると\n気持ちが違うき。"},
        { "location": "676/TALK"    , "narrator": "みやび", "text": "うちも全力で\nやるしかないねえ…！"},
        { "location": "677/ACT"     , "narrator": "", "text": "$me$は協力しない"},
        { "location": "678/TALK"    , "narrator": "みやび", "text": "………。"},
        { "location": "680/TALK"    , "narrator": "みやび", "text": "それも仕方ないろうね。"},
        { "location": "681/TALK"    , "narrator": "みやび", "text": "$handle$の知っとる\nうちは今話とるうちでは\nないんやろうし。"},
        { "location": "682/TALK"    , "narrator": "みやび", "text": "逆にうちは知らん\n$handle$なんやと\n確信できたし。"},
        { "location": "683/TALK"    , "narrator": "みやび", "text": "さようならやね。"},
        { "location": "689/TALK"    , "narrator": "みやび", "text": "おっ…！？"},
        { "location": "513/DIALOG"  , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "695/DIALOG"  , "narrator": "INFO", "text": "<color=red>【TRI-OS Information:0x7F】</color>\n\nココロアドレスの\nコンフリクトを解決しました。\n\n<color=blue>コンフリクトアドレス：\n0x948～0xFFC</color>\n\n再起動します。\n(022)"},
        { "location": "706/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【30 綾水たちの沈黙】"}
    ]
}
