        { "location": "236/SCENARIO", "narrator": "", "text": "350_恋の耐性"},
        { "location": "261/TALK"    , "narrator": "ガブリエラ", "text": "こ、こ、こ、こ、恋の"},
        { "location": "262/TALK"    , "narrator": "ガブリエラ", "text": "ウイルス感染♪"},
        { "location": "264/SEL"     , "narrator": "", "text": "ラップ？"},
        { "location": "265/SEL"     , "narrator": "", "text": "知らない曲だなあ"},
        { "location": "266/SEL"     , "narrator": "", "text": "新機軸の詩？"},
        { "location": "267/ACT"     , "narrator": "", "text": "ラップ？"},
        { "location": "268/TALK"    , "narrator": "ガブリエラ", "text": "ララララ恋のラップ現象♪"},
        { "location": "269/ACT"     , "narrator": "", "text": "知らない曲だなあ"},
        { "location": "270/TALK"    , "narrator": "ガブリエラ", "text": "私のオリジナルだもの♪"},
        { "location": "271/ACT"     , "narrator": "", "text": "新機軸の詩？"},
        { "location": "272/TALK"    , "narrator": "ガブリエラ", "text": "そうよ、よく、わかったわねv"},
        { "location": "275/TALK"    , "narrator": "ガブリエラ", "text": "あのね"},
        { "location": "276/TALK"    , "narrator": "ガブリエラ", "text": "雛と繭と一緒に「恋とウイルス感染」の話したわよね？"},
        { "location": "278/SEL"     , "narrator": "", "text": "したね"},
        { "location": "279/SEL"     , "narrator": "", "text": "したっけ？"},
        { "location": "280/ACT"     , "narrator": "", "text": "したね"},
        { "location": "281/TALK"    , "narrator": "ガブリエラ", "text": "したでしょう？"},
        { "location": "282/ACT"     , "narrator": "", "text": "したっけ？"},
        { "location": "283/TALK"    , "narrator": "ガブリエラ", "text": "したじゃないの"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "「恋とかけてウイルスとときます」って"},
        { "location": "286/TALK"    , "narrator": "ガブリエラ", "text": "それでね"},
        { "location": "287/TALK"    , "narrator": "ガブリエラ", "text": "思ったんだけど"},
        { "location": "288/TALK"    , "narrator": "ガブリエラ", "text": "きっと恋に対する耐性が一番高いのは私よね？"},
        { "location": "292/SEL"     , "narrator": "", "text": "えーと"},
        { "location": "293/SEL"     , "narrator": "", "text": "なんで？"},
        { "location": "294/SEL"     , "narrator": "", "text": "$handle$のおかげだね"},
        { "location": "295/ACT"     , "narrator": "", "text": "えーと"},
        { "location": "296/TALK"    , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "298/TALK"    , "narrator": "ガブリエラ", "text": "ご不満？"},
        { "location": "299/ACT"     , "narrator": "", "text": "なんで？"},
        { "location": "300/TALK"    , "narrator": "ガブリエラ", "text": "あらv"},
        { "location": "302/TALK"    , "narrator": "ガブリエラ", "text": "わからないのかしら？"},
        { "location": "303/ACT"     , "narrator": "", "text": "$handle$のおかげだね"},
        { "location": "313/TALK"    , "narrator": "ガブリエラ", "text": "そんなわけないでしょう？"},
        { "location": "314/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "315/TALK"    , "narrator": "ガブリエラ", "text": "答えを考えてくれたことには"},
        { "location": "316/TALK"    , "narrator": "ガブリエラ", "text": "感謝していてよ？"},
        { "location": "318/TALK"    , "narrator": "ガブリエラ", "text": "でね"},
        { "location": "319/TALK"    , "narrator": "ガブリエラ", "text": "みんなあんまり恋について慣れてなかったわ"},
        { "location": "320/TALK"    , "narrator": "ガブリエラ", "text": "でも私は好きな人だっているし"},
        { "location": "321/TALK"    , "narrator": "ガブリエラ", "text": "お付き合いするのも時間の問題って感じじゃないこと？"},
        { "location": "322/TALK"    , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "323/TALK"    , "narrator": "ガブリエラ", "text": "私が一番恋について知ってると思ったのよ"},
        { "location": "325/TALK"    , "narrator": "ガブリエラ", "text": "そうじゃなくて？"},
        { "location": "327/SEL"     , "narrator": "", "text": "うーん"},
        { "location": "328/SEL"     , "narrator": "", "text": "どうかなあ"},
        { "location": "329/SEL"     , "narrator": "", "text": "そういうことにしておくよ"},
        { "location": "330/ACT"     , "narrator": "", "text": "うーん"},
        { "location": "331/ACT"     , "narrator": "", "text": "どうかなあ"},
        { "location": "332/ACT"     , "narrator": "", "text": "そういうことにしておくよ"},
        { "location": "334/TALK"    , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "335/TALK"    , "narrator": "ガブリエラ", "text": "歯切れの悪いお返事ね"},
        { "location": "336/TALK"    , "narrator": "ガブリエラ", "text": "でもいいわ"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "オトナの私は許してあげるv"},
        { "location": "340/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "342/TALK"    , "narrator": "ガブリエラ", "text": "本当はね・・・"},
        { "location": "345/TALK"    , "narrator": "ボイスメール", "text": "ハレーション"},
