{
    "dir": "chap11/daydra/dd_ch05_11_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "11505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "独占禁止法？＜後編＞"
    },
    "entry":
    [
        { "location": "1635/TALK"  , "narrator": "神楽", "text": "…ただいま。"},
        { "location": "1636/TALK"  , "narrator": "神楽", "text": "はぁ…。"},
        { "location": "1638/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1650/TALK"  , "narrator": "神楽", "text": "ちょっと"},
        { "location": "1651/TALK"  , "narrator": "神楽", "text": "色々整理したいんです"},
        { "location": "1652/TALK"  , "narrator": "神楽", "text": "付き合ってもらえますか？"},
        { "location": "1654/SEL"   , "narrator": "", "text": "そのためにいるからね"},
        { "location": "1655/ACT"   , "narrator": "", "text": "そのためにいるからね"},
        { "location": "1660/TALK"  , "narrator": "神楽", "text": "まずは認めます"},
        { "location": "1661/TALK"  , "narrator": "神楽", "text": "ここ最近の私はつばめさんに対して"},
        { "location": "1662/TALK"  , "narrator": "神楽", "text": "悪くない印象を抱いています"},
        { "location": "1665/TALK"  , "narrator": "神楽", "text": "好意に近いかもしれません"},
        { "location": "1666/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "1667/TALK"  , "narrator": "神楽", "text": "それはこの日本を包むフェノメノンの中に存在するつばめさんです"},
        { "location": "1668/TALK"  , "narrator": "神楽", "text": "なので厳密には"},
        { "location": "1669/TALK"  , "narrator": "神楽", "text": "つばめさんを好きというわけではないんです"},
        { "location": "1671/SEL"   , "narrator": "", "text": "今のつばめは好きって認めるんだ？"},
        { "location": "1672/SEL"   , "narrator": "", "text": "自分に言い聞かせてる？"},
        { "location": "1673/ACT"   , "narrator": "", "text": "今のつばめは好きって認めるんだ？"},
        { "location": "1674/TALK"  , "narrator": "神楽", "text": "悪い印象を感じないだけです"},
        { "location": "1675/TALK"  , "narrator": "神楽", "text": "好きとは言ってません"},
        { "location": "1676/ACT"   , "narrator": "", "text": "自分に言い聞かせてる？"},
        { "location": "1678/TALK"  , "narrator": "神楽", "text": "決めつけるのはやめてください"},
        { "location": "1679/TALK"  , "narrator": "神楽", "text": "いい気分じゃないです"},
        { "location": "1681/TALK"  , "narrator": "神楽", "text": "とにかくそれで考えたんです"},
        { "location": "1682/TALK"  , "narrator": "神楽", "text": "繭が日本を包んでいる限り"},
        { "location": "1683/TALK"  , "narrator": "神楽", "text": "つばめさんは今のまま存在することができる"},
        { "location": "1684/TALK"  , "narrator": "神楽", "text": "だから"},
        { "location": "1685/TALK"  , "narrator": "神楽", "text": "繭を破壊せずにつばめさんを今のまま残す方法"},
        { "location": "1686/TALK"  , "narrator": "神楽", "text": "もしそんな方法があるなら"},
        { "location": "1688/SEL"   , "narrator": "", "text": "できるの！？"},
        { "location": "1689/ACT"   , "narrator": "", "text": "できるの！？"},
        { "location": "1692/TALK"  , "narrator": "神楽", "text": "ごめんなさい"},
        { "location": "1694/TALK"  , "narrator": "神楽", "text": "自分で言っておいてなんですけど"},
        { "location": "1695/TALK"  , "narrator": "神楽", "text": "無理な話でした"},
        { "location": "1696/TALK"  , "narrator": "神楽", "text": "つばめさんの心を破壊しない限り"},
        { "location": "1697/TALK"  , "narrator": "神楽", "text": "母を元に戻すことはできないですし"},
        { "location": "1698/TALK"  , "narrator": "神楽", "text": "それに今のつばめさんは音羽を壊した"},
        { "location": "1699/TALK"  , "narrator": "神楽", "text": "その事実がある以上"},
        { "location": "1700/TALK"  , "narrator": "神楽", "text": "ただのいい子とは思えません"},
        { "location": "1701/TALK"  , "narrator": "神楽", "text": "バカなことを言いました"},
        { "location": "1703/SEL"   , "narrator": "", "text": "つばめは本当にいい子だよ"},
        { "location": "1704/SEL"   , "narrator": "", "text": "つばめを壊そうとしてるのに？"},
        { "location": "1705/ACT"   , "narrator": "", "text": "つばめは本当にいい子だよ"},
        { "location": "1706/TALK"  , "narrator": "神楽", "text": "音羽を壊したのに？"},
        { "location": "1708/SEL"   , "narrator": "", "text": "本物のつばめのことだよ"},
        { "location": "1709/ACT"   , "narrator": "", "text": "本物のつばめのことだよ"},
        { "location": "1714/TALK"  , "narrator": "神楽", "text": "なんでそんなこと言うんですか？"},
        { "location": "1715/TALK"  , "narrator": "神楽", "text": "そうやって"},
        { "location": "1716/TALK"  , "narrator": "神楽", "text": "私の知らない情報を知ってるからって"},
        { "location": "1717/TALK"  , "narrator": "神楽", "text": "私を混乱させて！"},
        { "location": "1718/TALK"  , "narrator": "神楽", "text": "それなら言ってくださいよ"},
        { "location": "1719/TALK"  , "narrator": "神楽", "text": "今のこの状況下で"},
        { "location": "1720/TALK"  , "narrator": "神楽", "text": "何もかも丸く収まる最善の方法を！"},
        { "location": "1721/TALK"  , "narrator": "神楽", "text": "今すぐこの場で提示してくださいよ"},
        { "location": "1722/TALK"  , "narrator": "神楽", "text": "さあ早く！"},
        { "location": "1724/SEL"   , "narrator": "", "text": "全部つばめに話そう"},
        { "location": "1725/SEL"   , "narrator": "", "text": "お母さんを諦めるしかない"},
        { "location": "1726/SEL"   , "narrator": "", "text": "無理だよ"},
        { "location": "1727/ACT"   , "narrator": "", "text": "全部つばめに話そう"},
        { "location": "1728/TALK"  , "narrator": "神楽", "text": "なるほど！"},
        { "location": "1729/TALK"  , "narrator": "神楽", "text": "つばめさんのことだから私に協力してくれて"},
        { "location": "1730/TALK"  , "narrator": "神楽", "text": "一緒に繭を破壊しない方法を探してくれそうですね"},
        { "location": "1731/TALK"  , "narrator": "神楽", "text": "それで？"},
        { "location": "1732/TALK"  , "narrator": "神楽", "text": "このままじゃお母さんは元に戻りませんけど？"},
        { "location": "1733/TALK"  , "narrator": "神楽", "text": "もちろんなにか方法はあるんですよね？"},
        { "location": "1735/SEL"   , "narrator": "", "text": "その後で考えればいい"},
        { "location": "1736/SEL"   , "narrator": "", "text": "諦めるしかない"},
        { "location": "1737/ACT"   , "narrator": "", "text": "その後で考えればいい"},
        { "location": "1738/TALK"  , "narrator": "神楽", "text": "ふざけないでｙ"},
        { "location": "1739/TALK"  , "narrator": "神楽", "text": "私の一番ｈお母さんなのに"},
        { "location": "1740/TALK"  , "narrator": "神楽", "text": "なんで後回しにｓないといけにの！？"},
        { "location": "1741/TALK"  , "narrator": "神楽", "text": "ありえない"},
        { "location": "1742/TALK"  , "narrator": "神楽", "text": "ふざけｍんｎな"},
        { "location": "1743/ACT"   , "narrator": "", "text": "諦めるしかない"},
        { "location": "1746/TALK"  , "narrator": "神楽", "text": "ふざけないで"},
        { "location": "1758/TALK"  , "narrator": "神楽", "text": "…ちっ！！"},
        { "location": "1760/TALK"  , "narrator": "神楽", "text": "$handle$なら、\nなにかいい案を出して\nくれると思ってたのに…。"},
        { "location": "1762/TALK"  , "narrator": "神楽", "text": "期待して損した。\n時間の無駄だった。"},
        { "location": "1763/ACT"   , "narrator": "", "text": "お母さんを諦めるしかない"},
        { "location": "1765/ACT"   , "narrator": "", "text": "無理だよ"},
        { "location": "1767/TALK"  , "narrator": "神楽", "text": "だったら"},
        { "location": "1768/TALK"  , "narrator": "神楽", "text": "余計な口出ししないでください"},
        { "location": "1769/TALK"  , "narrator": "神楽", "text": "思わせぶりなことを言うだけ言って終わりとか"},
        { "location": "1770/TALK"  , "narrator": "神楽", "text": "迷惑なんです"},
        { "location": "1784/ACT"   , "narrator": "", "text": "つばめを壊そうとしてるのに？"},
        { "location": "1788/TALK"  , "narrator": "神楽", "text": "わかってます"},
        { "location": "1789/TALK"  , "narrator": "神楽", "text": "つばめさんを壊すためにここにいるのに"},
        { "location": "1790/TALK"  , "narrator": "神楽", "text": "自分は音羽を壊されて怒っている"},
        { "location": "1791/TALK"  , "narrator": "神楽", "text": "自分勝手ですよね"},
        { "location": "1792/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "1793/TALK"  , "narrator": "神楽", "text": "それでも音羽は親友なんです"},
        { "location": "1794/TALK"  , "narrator": "神楽", "text": "自分勝手だとしても"},
        { "location": "1795/TALK"  , "narrator": "神楽", "text": "親友を破壊されて平気ではいられません！"},
        { "location": "1797/SEL"   , "narrator": "", "text": "そもそも音羽はなんでドームにいたの？"},
        { "location": "1798/SEL"   , "narrator": "", "text": "ならもうなにも言わないよ"},
        { "location": "1799/ACT"   , "narrator": "", "text": "そもそも音羽はなんでドームにいたの？"},
        { "location": "1811/TALK"  , "narrator": "神楽", "text": "…わかってる。"},
        { "location": "1812/TALK"  , "narrator": "神楽", "text": "音羽があそこにいたのは、\n私が原因だって…。"},
        { "location": "1813/TALK"  , "narrator": "神楽", "text": "私が…音羽に任務のことを\n相談したから…。"},
        { "location": "1814/TALK"  , "narrator": "神楽", "text": "そんなことしなければ、\n今も音羽は…。"},
        { "location": "1815/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1816/TALK"  , "narrator": "神楽", "text": "ううん…それとこれとは、\n別の問題よね。"},
        { "location": "1817/TALK"  , "narrator": "神楽", "text": "例え音羽のことが\nなかったとしても…。"},
        { "location": "1818/TALK"  , "narrator": "神楽", "text": "つばめさんを破壊する\n任務に変わりはないん\nだから。"},
        { "location": "1820/TALK"  , "narrator": "神楽", "text": "…余計なことは\n考えたらダメ。"},
        { "location": "1821/TALK"  , "narrator": "神楽", "text": "私は…自分の任務の\nことだけを考えれば\nいいんだから…。"},
        { "location": "1822/ACT"   , "narrator": "", "text": "ならもうなにも言わないよ"},
        { "location": "1823/TALK"  , "narrator": "神楽", "text": "そうしてください"},
        { "location": "1824/TALK"  , "narrator": "神楽", "text": "こちらとしてもこれ以上心を乱されるのは"},
        { "location": "1825/TALK"  , "narrator": "神楽", "text": "本当に迷惑なんで"},
        { "location": "1836/TALK"  , "narrator": "神楽", "text": "…つばめさんは、\n私にとってはただの\n破壊対象でしかない。"},
        { "location": "1837/TALK"  , "narrator": "神楽", "text": "それだけでいい…。\nそう思ってればいいの。"},
        { "location": "1838/TALK"  , "narrator": "神楽", "text": "だから、そんな子を\n好きになったりは\nしない…。"},
        { "location": "1840/TALK"  , "narrator": "神楽", "text": "好きになったら、\nいけないんだから…。"},
        { "location": "1851/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【09 パーフェクトイエロー】"},
        { "location": "1863/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【09 パーフェクトイエロー】"}
    ]
}
