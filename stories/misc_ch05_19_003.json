    "entry":
    [
        { "location": "6264/SCENARIO", "narrator": "", "text": "羊を育てて"},
        { "location": "6291/TALK"    , "narrator": "神楽", "text": "羊ってさ"},
        { "location": "6292/TALK"    , "narrator": "神楽", "text": "数えるためだけに大量に育てられててかわいそうじゃない？"},
        { "location": "6294/SEL"     , "narrator": "", "text": "あれ実は一匹だけだから"},
        { "location": "6295/SEL"     , "narrator": "", "text": "いやその理屈はおかしい"},
        { "location": "6296/SEL"     , "narrator": "", "text": "羊肉おいしいよね"},
        { "location": "6297/ACT"     , "narrator": "", "text": "あれ実は一匹だけだから"},
        { "location": "6301/TALK"    , "narrator": "神楽", "text": "じゃあワンオペで数えられてるの？"},
        { "location": "6302/TALK"    , "narrator": "神楽", "text": "それって、、、大変じゃない？"},
        { "location": "6304/SEL"     , "narrator": "", "text": "そのための精鋭だから"},
        { "location": "6305/SEL"     , "narrator": "", "text": "そう、羊はいつか心を失い…"},
        { "location": "6306/SEL"     , "narrator": "", "text": "$me$のこと心配してくれてるの？"},
        { "location": "6307/ACT"     , "narrator": "", "text": "そのための精鋭だから"},
        { "location": "6308/TALK"    , "narrator": "神楽", "text": "選ばれし羊なのかー"},
        { "location": "6309/TALK"    , "narrator": "神楽", "text": "まさにストレイシープ"},
        { "location": "6310/ACT"     , "narrator": "", "text": "そう、羊はいつか心を失い…"},
        { "location": "6311/TALK"    , "narrator": "神楽", "text": "羊ー！！！"},
        { "location": "6312/TALK"    , "narrator": "神楽", "text": "目を覚ませ羊ー！！！"},
        { "location": "6313/ACT"     , "narrator": "", "text": "$me$のこと心配してくれてるの？"},
        { "location": "6315/TALK"    , "narrator": "神楽", "text": "えっ！？"},
        { "location": "6316/TALK"    , "narrator": "神楽", "text": "あの羊が$handlek$だったなんて、、、"},
        { "location": "6317/TALK"    , "narrator": "神楽", "text": "ぴょんこ全然気が付かなくて、、、"},
        { "location": "6320/SEL"     , "narrator": "", "text": "隠してたからね…"},
        { "location": "6321/SEL"     , "narrator": "", "text": "気にしなくていいんだよ"},
        { "location": "6322/SEL"     , "narrator": "", "text": "神楽のためなら平気だよ"},
        { "location": "6323/ACT"     , "narrator": "", "text": "隠してたからね…"},
        { "location": "6324/TALK"    , "narrator": "神楽", "text": "言ってくれればよかったのに、、、"},
        { "location": "6325/ACT"     , "narrator": "", "text": "気にしなくていいんだよ"},
        { "location": "6326/TALK"    , "narrator": "神楽", "text": "え、、でも、、、"},
        { "location": "6327/ACT"     , "narrator": "", "text": "神楽のためなら平気だよ"},
        { "location": "6328/TALK"    , "narrator": "神楽", "text": "やだ$handlek$ったら、、、"},
        { "location": "6330/TALK"    , "narrator": "神楽", "text": "羊の秘密を知ったぴょんこはひとつ大人になりました"},
        { "location": "6331/TALK"    , "narrator": "神楽", "text": "これからも見守っててねぴょんこのこと"},
        { "location": "6333/TALK"    , "narrator": "神楽", "text": "おやすみなさい"},
        { "location": "6335/ACT"     , "narrator": "", "text": "いやその理屈はおかしい"},
        { "location": "6336/TALK"    , "narrator": "神楽", "text": "そんなことはない"},
        { "location": "6337/ACT"     , "narrator": "", "text": "羊肉おいしいよね"},
        { "location": "6338/TALK"    , "narrator": "神楽", "text": "何その適当すぎる返し"}
    ]
}
