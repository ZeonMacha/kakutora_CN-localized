    [
        { "location": "234/SCENARIO", "narrator": "", "text": "018_ドロップ・シロップ・ドロップ"},
        { "location": "259/TALK"    , "narrator": "アーヤ", "text": "あまいものが好きよね"},
        { "location": "260/TALK"    , "narrator": "アーヤ", "text": "女の子は"},
        { "location": "262/SEL"     , "narrator": "", "text": "アーヤも女の子でしょ"},
        { "location": "263/SEL"     , "narrator": "", "text": "そうみたいだね"},
        { "location": "264/ACT"     , "narrator": "", "text": "アーヤも女の子でしょ"},
        { "location": "265/TALK"    , "narrator": "アーヤ", "text": "おんなのこ。。。"},
        { "location": "266/TALK"    , "narrator": "アーヤ", "text": "そうかもね"},
        { "location": "267/ACT"     , "narrator": "", "text": "そうみたいだね"},
        { "location": "268/TALK"    , "narrator": "アーヤ", "text": "そうなのよねー"},
        { "location": "270/TALK"    , "narrator": "アーヤ", "text": "嫌いじゃないけど"},
        { "location": "271/TALK"    , "narrator": "アーヤ", "text": "甘いもの"},
        { "location": "272/TALK"    , "narrator": "アーヤ", "text": "でもね"},
        { "location": "273/TALK"    , "narrator": "アーヤ", "text": "カフェではお茶だけでいいの"},
        { "location": "275/SEL"     , "narrator": "", "text": "せっかくなのに……"},
        { "location": "276/SEL"     , "narrator": "", "text": "日本茶専門のカフェってこと？"},
        { "location": "277/SEL"     , "narrator": "", "text": "それでいいと思うけど"},
        { "location": "278/ACT"     , "narrator": "", "text": "せっかくなのに……"},
        { "location": "279/TALK"    , "narrator": "アーヤ", "text": "注文することもあるわよ(--*;"},
        { "location": "280/TALK"    , "narrator": "アーヤ", "text": "でもいつも頼まなくてもいいじゃない（｀皿´ )"},
        { "location": "281/ACT"     , "narrator": "", "text": "日本茶専門のカフェってこと？"},
        { "location": "282/TALK"    , "narrator": "アーヤ", "text": "違うわよ"},
        { "location": "283/TALK"    , "narrator": "アーヤ", "text": "飲み物全般ってことよ"},
        { "location": "284/ACT"     , "narrator": "", "text": "それでいいと思うけど"},
        { "location": "286/TALK"    , "narrator": "アーヤ", "text": "そうよね(*^.^*)"},
        { "location": "287/TALK"    , "narrator": "アーヤ", "text": "好みの問題だもの"},
        { "location": "288/TALK"    , "narrator": "アーヤ", "text": "それでいいのよ！"},
        { "location": "291/TALK"    , "narrator": "アーヤ", "text": "でもね"},
        { "location": "292/TALK"    , "narrator": "アーヤ", "text": "飲み物だけだと"},
        { "location": "293/TALK"    , "narrator": "アーヤ", "text": "ペース配分がね"},
        { "location": "294/TALK"    , "narrator": "アーヤ", "text": "ちょっと困るのよ"},
        { "location": "295/TALK"    , "narrator": "アーヤ", "text": "みんなで行ったとき"},
        { "location": "298/SEL"     , "narrator": "", "text": "先に出れば"},
        { "location": "299/SEL"     , "narrator": "", "text": "会話を楽しめばいいよ"},
        { "location": "300/SEL"     , "narrator": "", "text": "そういうもの？"},
        { "location": "301/ACT"     , "narrator": "", "text": "先に出れば"},
        { "location": "302/TALK"    , "narrator": "アーヤ", "text": "そういうわけにはいかないのよ"},
        { "location": "303/TALK"    , "narrator": "アーヤ", "text": "もー(--#)"},
        { "location": "304/ACT"     , "narrator": "", "text": "会話を楽しめばいいよ"},
        { "location": "306/TALK"    , "narrator": "アーヤ", "text": "あら？"},
        { "location": "307/TALK"    , "narrator": "アーヤ", "text": "いいこというわね"},
        { "location": "308/TALK"    , "narrator": "アーヤ", "text": "確かにそうだったわ(*^o^*)"},
        { "location": "309/TALK"    , "narrator": "アーヤ", "text": "えらいえらい"},
        { "location": "310/ACT"     , "narrator": "", "text": "そういうもの？"},
        { "location": "311/TALK"    , "narrator": "アーヤ", "text": "そういうものなのよ"},
        { "location": "313/TALK"    , "narrator": "アーヤ", "text": "カフェが嫌いってわけじゃないしね"},
        { "location": "314/TALK"    , "narrator": "アーヤ", "text": "むしろ好きな方だし"},
        { "location": "315/TALK"    , "narrator": "アーヤ", "text": "気にしすぎないようにするわ"},
        { "location": "316/TALK"    , "narrator": "アーヤ", "text": "色々と"}
    ]
}
