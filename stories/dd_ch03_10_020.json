{
    "dir": "chap10/daydra/dd_ch03_10_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "10356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "レイティング"
    },
    "entry":
    [
        { "location": "206/SCENARIO", "narrator": "", "text": "レイティング"},
        { "location": "222/TALK"    , "narrator": "ガブリエラ", "text": "はぁ！？\nあの映画、映画館に\n見に行ったの！？"},
        { "location": "225/TALK"    , "narrator": "つばめ", "text": "はい。すっごく面白くて\n二回も見ちゃいました。"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "でも、あれって公開したの\n五年くらい前でしょ？"},
        { "location": "230/TALK"    , "narrator": "ガブリエラ", "text": "あんた小学生じゃない！\n高校生未満は見れない\nはずでしょ？"},
        { "location": "233/TALK"    , "narrator": "アーヤ", "text": "え？　特に年齢制限は\nなかったと思うけど…。"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "『クライシス・ジュピ\nター』は年齢制限付いて\nないぞね。"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "そんな…あたしの国じゃ\n高校生未満はダメって\nなってるのに…。"},
        { "location": "239/TALK"    , "narrator": "神楽", "text": "レイティングが\n違ったんですね。"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "日本では小学生でも\n見られるちや。"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "あ、あたしが、高校生に\nなるまでずっと我慢してる\n映画なのに…。"},
        { "location": "245/TALK"    , "narrator": "ガブリエラ", "text": "でも、日本のレイティング\nだと見ても良いのよね？"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "つまり、見ようと思えば\n今日にでも見ることが\nできるんじゃ…。"},
        { "location": "258/TALK"    , "narrator": "ガブリエラ", "text": "ねえ、マルザンナ"},
        { "location": "259/TALK"    , "narrator": "ガブリエラ", "text": "私の国では年齢制限のあった映画が"},
        { "location": "260/TALK"    , "narrator": "ガブリエラ", "text": "日本では年齢制限がなくて、誰でも見れるらしいの"},
        { "location": "262/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "263/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "265/TALK"    , "narrator": "ガブリエラ", "text": "だからね"},
        { "location": "266/TALK"    , "narrator": "ガブリエラ", "text": "今は日本にいるんだから"},
        { "location": "267/TALK"    , "narrator": "ガブリエラ", "text": "私も見て良いのかな、って…"},
        { "location": "269/SEL"     , "narrator": "", "text": "絶対に見た方が良い"},
        { "location": "270/SEL"     , "narrator": "", "text": "不良になっちゃうよ？"},
        { "location": "271/ACT"     , "narrator": "", "text": "絶対に見た方が良い"},
        { "location": "273/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナもそう思う？"},
        { "location": "274/TALK"    , "narrator": "ガブリエラ", "text": "よかった"},
        { "location": "275/TALK"    , "narrator": "ガブリエラ", "text": "あなたがそう言ってくれるなら、見てみようかしら"},
        { "location": "286/TALK"    , "narrator": "ガブリエラ", "text": "誰か、ＤＶＤ持ってる？"},
        { "location": "287/TALK"    , "narrator": "みやび", "text": "うちが持っとるき、\n寮に戻ったら貸すがよ。"},
        { "location": "290/TALK"    , "narrator": "神楽", "text": "良かったですね。\nポーランドにいたら、\nあと一年お預けでしたよ？"},
        { "location": "291/TALK"    , "narrator": "アーヤ", "text": "もうすぐ続編もやるみたい\nだし、その前に見られ\nそうで良かったわね。"},
        { "location": "292/TALK"    , "narrator": "ガブリエラ", "text": "贅沢を言うなら、もう少し\n早く知りたかったけど。"},
        { "location": "293/TALK"    , "narrator": "ガブリエラ", "text": "でも、思ってたより一年\n早く見られるなんて、\n凄く嬉しいわ。"},
        { "location": "295/TALK"    , "narrator": "ガブリエラ", "text": "それに、ちょっとだけ\n悪いことしてるみたいで\nドキドキもするし…。"},
        { "location": "296/TALK"    , "narrator": "ガブリエラ", "text": "早く夜にならないかしら？"},
        { "location": "314/ACT"     , "narrator": "", "text": "不良になっちゃうよ？"},
        { "location": "315/TALK"    , "narrator": "ガブリエラ", "text": "わ、私が不良に！？"},
        { "location": "316/TALK"    , "narrator": "ガブリエラ", "text": "そんなの絶対ダメよ！"},
        { "location": "318/TALK"    , "narrator": "ガブリエラ", "text": "私は不良とは縁遠い存在なんだから！"},
        { "location": "319/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、あと一年我慢するわ"},
        { "location": "320/TALK"    , "narrator": "ガブリエラ", "text": "止めてくれてありがとう、\nマルザンナ"},
        { "location": "331/TALK"    , "narrator": "みやび", "text": "見たいならうちのＤＶＤ\n貸すけんど、どうする？"},
        { "location": "332/TALK"    , "narrator": "ガブリエラ", "text": "…あと一年、我慢するわ。\nまだ不良にはなりたく\nないし。"},
        { "location": "333/TALK"    , "narrator": "アーヤ", "text": "不良にはならないって。\n日本は誰でも見られる\n映画なんだし――"},
        { "location": "334/TALK"    , "narrator": "アーヤ", "text": "内容だって、卑猥だったり\nグロテスクだったりする\nわけじゃないのよ？"},
        { "location": "336/TALK"    , "narrator": "つばめ", "text": "登場人物の台詞が、\nちょっとだけ汚かった\nですけど…。"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "いいんだってば。\n日本にいても、あたしは\nポーランド人なんだし。"},
        { "location": "338/TALK"    , "narrator": "ガブリエラ", "text": "自分の国のルールに\n従って、あと一年だけ\n我慢するわ。"},
        { "location": "340/TALK"    , "narrator": "アーヤ", "text": "もぉ、変なところで\nマジメなんだから。"},
        { "location": "342/TALK"    , "narrator": "ガブリエラ", "text": "…あたしだって、できれば\nすぐにでも見たいわよ！"},
        { "location": "343/TALK"    , "narrator": "ガブリエラ", "text": "でも、あたしは不良じゃ\nないんだし。\nもう少しの我慢よ！"},
        { "location": "219/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>6月14日　12:38 PM</color>\nとある昼休み、学食横の自販機コーナーにて。"},
        { "location": "308/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch03", "text": "【クライシス・クライシス】"}
    ]
}
