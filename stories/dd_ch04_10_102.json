{
    "dir": "chap10/daydra/dd_ch04_10_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "10405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "遊んでるわけやない＜後編＞"
    },
    "entry":
    [
        { "location": "534/SCENARIO", "narrator": "", "text": "遊んでるわけやない"},
        { "location": "550/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "552/TALK"    , "narrator": "みやび", "text": "しかし、まっこと\nふざけたサイトや。"},
        { "location": "553/TALK"    , "narrator": "みやび", "text": "けんど、適当に妄想\n吐き出しちょる\nようにも見えんし…。"},
        { "location": "554/TALK"    , "narrator": "みやび", "text": "ふむ…。"},
        { "location": "555/SEL"     , "narrator": "", "text": "興味あるなら調べてみれば？"},
        { "location": "556/ACT"     , "narrator": "", "text": "興味あるなら調べてみれば？"},
        { "location": "565/TALK"    , "narrator": "みやび", "text": "実家のマシンがあればな"},
        { "location": "566/TALK"    , "narrator": "みやび", "text": "今はムリや"},
        { "location": "567/SEL"     , "narrator": "", "text": "ルートみたいなのが書いてある"},
        { "location": "568/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "569/TALK"    , "narrator": "みやび", "text": "時間は掛かるけんど"},
        { "location": "570/TALK"    , "narrator": "みやび", "text": "部屋のマシンでやってみよう"},
        { "location": "572/TALK"    , "narrator": "みやび", "text": "何にせよ"},
        { "location": "573/TALK"    , "narrator": "みやび", "text": "ここでは無理や"},
        { "location": "574/TALK"    , "narrator": "みやび", "text": "続きは帰ってからな"},
        { "location": "577/ACT"     , "narrator": "", "text": "ルートみたいなのが書いてある"},
        { "location": "579/TALK"    , "narrator": "みやび", "text": "マジか！？"},
        { "location": "581/TALK"    , "narrator": "みやび", "text": "前言撤回、可能や"},
        { "location": "582/TALK"    , "narrator": "みやび", "text": "ルートの最後に書かれちょるアドレス"},
        { "location": "583/TALK"    , "narrator": "みやび", "text": "ポチッと貼りつけ頼む"},
        { "location": "585/SEL"     , "narrator": "", "text": "22145E34.rootnode.JPGO.554"},
        { "location": "588/TALK"    , "narrator": "みやび", "text": "よし"},
        { "location": "590/TALK"    , "narrator": "みやび", "text": "ＰＣで調べる"},
        { "location": "591/TALK"    , "narrator": "みやび", "text": "ちくっと待ちぃ"},
        { "location": "595/TALK"    , "narrator": "みやび", "text": "ＩＰは"},
        { "location": "596/TALK"    , "narrator": "みやび", "text": "『6E.5F.34.22.7C.46』"},
        { "location": "597/TALK"    , "narrator": "みやび", "text": "情報非公開は当然やけんど"},
        { "location": "598/TALK"    , "narrator": "みやび", "text": "このノード"},
        { "location": "599/TALK"    , "narrator": "みやび", "text": "『pppvpn-05sakura.biggate.41.3E.5』"},
        { "location": "600/TALK"    , "narrator": "みやび", "text": "これに見覚えがあるんよ"},
        { "location": "602/TALK"    , "narrator": "みやび", "text": "確認してくる"},
        { "location": "606/TALK"    , "narrator": "みやび", "text": "まさかとは思うが…。"},
        { "location": "612/TALK"    , "narrator": "みやび", "text": "ビンゴ！\nやはりそうやったか！"},
        { "location": "613/TALK"    , "narrator": "みやび", "text": "これ、間違いなく\n情報管理庁の中や。\nっちゅうことは――"},
        { "location": "614/TALK"    , "narrator": "みやび", "text": "この間、\nラビットアニマが\n陥落した――"},
        { "location": "615/TALK"    , "narrator": "みやび", "text": "あの先に繋がっちょる\n可能性もあるな。"},
        { "location": "621/TALK"    , "narrator": "みやび", "text": "…予想的中や！\nそうか、そういうこと\nやったか！"},
        { "location": "622/TALK"    , "narrator": "みやび", "text": "さっきのファンサイト\nだけやない。"},
        { "location": "623/TALK"    , "narrator": "みやび", "text": "他のファンサイトの\nアドレスまで、\n大量に出てきよった！"},
        { "location": "624/TALK"    , "narrator": "みやび", "text": "あはははは！\nマジか、今年ナンバー\nワンの爆笑大賞や！"},
        { "location": "628/TALK"    , "narrator": "みやび", "text": "素晴らしい"},
        { "location": "629/TALK"    , "narrator": "みやび", "text": "相棒のおかげで"},
        { "location": "630/TALK"    , "narrator": "みやび", "text": "面白い世界を開拓できた"},
        { "location": "631/TALK"    , "narrator": "みやび", "text": "礼を言うぞ"},
        { "location": "632/TALK"    , "narrator": "みやび", "text": "サンキュー、グラッチェ、グラシアス！"},
        { "location": "634/TALK"    , "narrator": "みやび", "text": "うちはしばらく"},
        { "location": "635/TALK"    , "narrator": "みやび", "text": "自分の世界にひたるき"},
        { "location": "636/TALK"    , "narrator": "みやび", "text": "またな"},
        { "location": "650/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【08 HANABI】"}
    ]
}
