    "entry":
    [
        { "location": "1952/SCENARIO", "narrator": "", "text": "説明サブ"},
        { "location": "1954/TALK"    , "narrator": "千羽鶴", "text": "ライフギャザーの\n停止により、思わず繭が\n吹き飛んだわけだけど。"},
        { "location": "1955/TALK"    , "narrator": "千羽鶴", "text": "私は冷静に考えて、\n日本を包む繭は元に戻す\nべきだと考えてる。"},
        { "location": "1956/TALK"    , "narrator": "千羽鶴", "text": "そしてその後、今は完全に\n切れてしまっている、\nリプレイス前の世界と――"},
        { "location": "1959/TALK"    , "narrator": "千羽鶴", "text": "この世界を再結合する！"},
        { "location": "1960/SEL"     , "narrator": "", "text": "そんなこと出来るの！？"},
        { "location": "1961/ACT"     , "narrator": "", "text": "そんなこと出来るの！？"},
        { "location": "1963/TALK"    , "narrator": "千羽鶴", "text": "理論上はできる。"},
        { "location": "1964/TALK"    , "narrator": "千羽鶴", "text": "具体的には――"},
        { "location": "1965/TALK"    , "narrator": "千羽鶴", "text": "現在、唯一完全に繋がって\nいるCH05、すなわち卯月\n神楽による発症の依頼。"},
        { "location": "1966/TALK"    , "narrator": "千羽鶴", "text": "その発症によって、\n世界をもとの状態に\n戻したら――"},
        { "location": "1967/TALK"    , "narrator": "千羽鶴", "text": "そのまま、現時点の\n時間軸と全く同じ状況を\n作り出すよう組み立てる。"},
        { "location": "1968/TALK"    , "narrator": "千羽鶴", "text": "その為に必要なのは、\n2x接続された\nトライナリー達の想い。"},
        { "location": "1969/TALK"    , "narrator": "千羽鶴", "text": "だから、私とエリカは、\n一時的に他の子たちに\n発症協力を要請し――"},
        { "location": "1970/TALK"    , "narrator": "千羽鶴", "text": "僅かな時間だけ\n世界になって欲しいと\n考えている。"},
        { "location": "1971/TALK"    , "narrator": "千羽鶴", "text": "すぐ後には、エリカが\n2E113にコピーして\n彼女らは収束する。"},
        { "location": "1972/SEL"     , "narrator": "", "text": "トライナリーたちや神楽は、発症から収束した後も元気でいられるの？"},
        { "location": "1973/SEL"     , "narrator": "", "text": "2E113って本当に安全なの？"},
        { "location": "1974/ACT"     , "narrator": "", "text": "トライナリーたちや神楽は、発症から収束した後も元気でいられるの？"},
        { "location": "1975/TALK"    , "narrator": "千羽鶴", "text": "もちろん、大丈夫。"},
        { "location": "1976/TALK"    , "narrator": "千羽鶴", "text": "ただし、その理由は、\n貴方がライフギャザーを\n掌握しているからだと――"},
        { "location": "1977/TALK"    , "narrator": "千羽鶴", "text": "そうでなければ、従来通り\n心に傷を負ってしまう事は\n把握しておいて欲しい。"},
        { "location": "1978/TALK"    , "narrator": "千羽鶴", "text": "今だからこそできる、\n世界からの完全なる復帰で\nあるということを。"},
        { "location": "1979/ACT"     , "narrator": "", "text": "2E113って本当に安全なの？"},
        { "location": "1980/TALK"    , "narrator": "千羽鶴", "text": "恐らくは。"},
        { "location": "1981/TALK"    , "narrator": "千羽鶴", "text": "基本的にはエリカが創って\nいるものだから、私はその\n細部まではわからない。"},
        { "location": "1982/TALK"    , "narrator": "千羽鶴", "text": "だから、詳細については\nエリカに直接聞いてみて\n欲しいのだけど――"},
        { "location": "1983/TALK"    , "narrator": "千羽鶴", "text": "少なくとも國政綾水の\nような身内もいるわけ\nだから、"},
        { "location": "1984/TALK"    , "narrator": "千羽鶴", "text": "信頼性の薄いものを\n提供したりはしないと\n思う。"},
        { "location": "1986/TALK"    , "narrator": "千羽鶴", "text": "というわけで。"},
        { "location": "1987/TALK"    , "narrator": "千羽鶴", "text": "貴方がそこの作戦に対して\nどのような考えを持ったか\nわからないけど。"},
        { "location": "1988/TALK"    , "narrator": "千羽鶴", "text": "もし、賛同してくれるなら\nこれから彼女たちと話を\nして協力を仰いで欲しい。"},
        { "location": "1989/TALK"    , "narrator": "千羽鶴", "text": "もちろん、\nこれは義務ではない。"},
        { "location": "1990/TALK"    , "narrator": "千羽鶴", "text": "だから、貴方がこの計画に\n賛同してくれるのならば、\nで構わない。"}
    ]
}
