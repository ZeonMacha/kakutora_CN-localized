    "entry":
    [
        { "location": "575/SCENARIO", "narrator": "", "text": "アニメ第23話"},
        { "location": "588/TALK"    , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "589/TALK"    , "narrator": "千羽鶴", "text": "もう一度\n私との会話を\n再現する？"},
        { "location": "590/SEL"     , "narrator": "", "text": "はい"},
        { "location": "591/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "592/ACT"     , "narrator": "", "text": "はい"},
        { "location": "593/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "595/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "596/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "604/TALK"    , "narrator": "千羽鶴", "text": "ちょっと\n面倒な事になった。"},
        { "location": "605/SEL"     , "narrator": "", "text": "どうしたの！？"},
        { "location": "606/ACT"     , "narrator": "", "text": "どうしたの！？"},
        { "location": "608/TALK"    , "narrator": "千羽鶴", "text": "私とエリカ以外に\nTRI-OSの管理者権限を\n持ってる存在がいた。"},
        { "location": "609/TALK"    , "narrator": "千羽鶴", "text": "そしてそれは、\n逢瀬つばめの原初的存在を\n名乗っているという！"},
        { "location": "610/SEL"     , "narrator": "", "text": "エリカから聞いたの？"},
        { "location": "611/ACT"     , "narrator": "", "text": "エリカから聞いたの？"},
        { "location": "613/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "614/TALK"    , "narrator": "千羽鶴", "text": "正直、そんな存在が\n貴方に接触してることすら\n知らなかった。"},
        { "location": "615/SEL"     , "narrator": "", "text": "え、そうなの！？"},
        { "location": "616/SEL"     , "narrator": "", "text": "もしかしてちーちゃんピンチ？"},
        { "location": "617/ACT"     , "narrator": "", "text": "え、そうなの！？"},
        { "location": "618/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "619/TALK"    , "narrator": "千羽鶴", "text": "そもそも、それが本当に\n原初状態の逢瀬つばめなら\n大変な異常事態。"},
        { "location": "620/TALK"    , "narrator": "千羽鶴", "text": "だって、私が\n世界に二人いるという\nことになるのだから。"},
        { "location": "621/TALK"    , "narrator": "千羽鶴", "text": "ただし、エリカが\n言っていたように、\n別レイヤーなら話は別。"},
        { "location": "622/SEL"     , "narrator": "", "text": "確かに"},
        { "location": "623/SEL"     , "narrator": "", "text": "別レイヤーって…？"},
        { "location": "624/ACT"     , "narrator": "", "text": "確かに"},
        { "location": "625/ACT"     , "narrator": "", "text": "別レイヤーって…？"},
        { "location": "626/TALK"    , "narrator": "千羽鶴", "text": "今の私とは、時間軸か、\n可能性軸がズレた所に\nいるということ。"},
        { "location": "628/ACT"     , "narrator": "", "text": "もしかしてちーちゃんピンチ？"},
        { "location": "629/TALK"    , "narrator": "千羽鶴", "text": "んー。"},
        { "location": "630/TALK"    , "narrator": "千羽鶴", "text": "それ自体は別に。"},
        { "location": "631/TALK"    , "narrator": "千羽鶴", "text": "彼女の目的次第だけど、\n彼女が本当に私の\n原初状態なら――"},
        { "location": "632/TALK"    , "narrator": "千羽鶴", "text": "私に危害を加えるような\nことはしない筈だから。"},
        { "location": "634/TALK"    , "narrator": "千羽鶴", "text": "ただ、その原初状態の私が\nなぜ活動してるのかは\n気になるかも。"},
        { "location": "635/TALK"    , "narrator": "千羽鶴", "text": "だから、もし何か\n知ってることがあれば――"},
        { "location": "638/TALK"    , "narrator": "千羽鶴", "text": "<size=35>お</size>"},
        { "location": "641/TALK"    , "narrator": "千羽鶴", "text": "<size=50>し</size>"},
        { "location": "645/TALK"    , "narrator": "千羽鶴", "text": "<size=100>え</size>"},
        { "location": "649/TALK"    , "narrator": "千羽鶴", "text": "<size=140>て</size>"},
        { "location": "653/SEL"     , "narrator": "", "text": "これは教えざるを得ない"},
        { "location": "654/SEL"     , "narrator": "", "text": "ついにアピールとかいう悪いものを覚えてしまったか"},
        { "location": "655/ACT"     , "narrator": "", "text": "これは教えざるを得ない"},
        { "location": "656/TALK"    , "narrator": "千羽鶴", "text": "やった。"},
        { "location": "657/ACT"     , "narrator": "", "text": "ついにアピールとかいう悪いものを覚えてしまったか"},
        { "location": "658/TALK"    , "narrator": "千羽鶴", "text": "いいえ。"},
        { "location": "659/TALK"    , "narrator": "千羽鶴", "text": "単に市場経済に則った\nプロモーション展開を\nしているだけ。"},
        { "location": "661/TALK"    , "narrator": "千羽鶴", "text": "さあ、教えて。\nはやく！"},
        { "location": "663/SEL"     , "narrator": "", "text": "原初のつばめは、とてもかわいい"},
        { "location": "664/SEL"     , "narrator": "", "text": "原初のつばめは、色んな事を教えてくれたよ"},
        { "location": "665/SEL"     , "narrator": "", "text": "原初のつばめは、ラブラブルートを作ってくれた神のような存在"},
        { "location": "666/SEL"     , "narrator": "", "text": "原初のつばめは、総意システムに懐疑的"},
        { "location": "667/ACT"     , "narrator": "", "text": "原初のつばめは、とてもかわいい"},
        { "location": "669/ACT"     , "narrator": "", "text": "原初のつばめは、色んな事を教えてくれたよ"},
        { "location": "671/ACT"     , "narrator": "", "text": "原初のつばめは、ラブラブルートを作ってくれた神のような存在"},
        { "location": "673/ACT"     , "narrator": "", "text": "原初のつばめは、総意システムに懐疑的"},
        { "location": "677/SEL"     , "narrator": "", "text": "原初のつばめは、とてもかわいい"},
        { "location": "678/SEL"     , "narrator": "", "text": "原初のつばめは、色んな事を教えてくれたよ"},
        { "location": "679/SEL"     , "narrator": "", "text": "原初のつばめは、ラブラブルートを作ってくれた神のような存在"},
        { "location": "680/ACT"     , "narrator": "", "text": "原初のつばめは、とてもかわいい"},
        { "location": "682/ACT"     , "narrator": "", "text": "原初のつばめは、色んな事を教えてくれたよ"},
        { "location": "684/ACT"     , "narrator": "", "text": "原初のつばめは、ラブラブルートを作ってくれた神のような存在"},
        { "location": "689/TALK"    , "narrator": "千羽鶴", "text": "私の原初状態なんだから\n当然のこと。"},
        { "location": "691/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "692/TALK"    , "narrator": "千羽鶴", "text": "ごめん。\n冗談にも程があった。"},
        { "location": "693/SEL"     , "narrator": "", "text": "どう反応していいかわからない"},
        { "location": "694/SEL"     , "narrator": "", "text": "ちーの方がかわいいよ！"},
        { "location": "695/ACT"     , "narrator": "", "text": "どう反応していいかわからない"},
        { "location": "696/TALK"    , "narrator": "千羽鶴", "text": "何も反応しなくてよし！"},
        { "location": "697/ACT"     , "narrator": "", "text": "ちーの方がかわいいよ！"},
        { "location": "698/TALK"    , "narrator": "千羽鶴", "text": "……その返しはずるい。"},
        { "location": "703/TALK"    , "narrator": "千羽鶴", "text": "どんなこと？"},
        { "location": "704/SEL"     , "narrator": "", "text": "地政学とか、生き方について"},
        { "location": "705/SEL"     , "narrator": "", "text": "トロッコ問題とか、攻撃ボタンとかで遊んだ"},
        { "location": "706/SEL"     , "narrator": "", "text": "人にはいえないこと"},
        { "location": "707/ACT"     , "narrator": "", "text": "地政学とか、生き方について"},
        { "location": "708/TALK"    , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "709/TALK"    , "narrator": "千羽鶴", "text": "まあ、\n想像の範疇ではある。"},
        { "location": "710/ACT"     , "narrator": "", "text": "トロッコ問題とか、攻撃ボタンとかで遊んだ"},
        { "location": "711/TALK"    , "narrator": "千羽鶴", "text": "……？\nゲーム？"},
        { "location": "712/TALK"    , "narrator": "千羽鶴", "text": "遊びに来ただけ？"},
        { "location": "713/ACT"     , "narrator": "", "text": "人にはいえないこと"},
        { "location": "715/TALK"    , "narrator": "千羽鶴", "text": "………。"},
        { "location": "716/SEL"     , "narrator": "", "text": "世界の裏事情とかについてだよ"},
        { "location": "717/ACT"     , "narrator": "", "text": "世界の裏事情とかについてだよ"},
        { "location": "720/TALK"    , "narrator": "千羽鶴", "text": "ああ、そういうこと…。"},
        { "location": "721/SEL"     , "narrator": "", "text": "ちーちゃん今何想像してたの？"},
        { "location": "722/ACT"     , "narrator": "", "text": "ちーちゃん今何想像してたの？"},
        { "location": "727/TALK"    , "narrator": "千羽鶴", "text": "<size=40><color=red>どーん！</color></size>"},
        { "location": "740/TALK"    , "narrator": "千羽鶴", "text": "ラブラブルート？\nなに？"},
        { "location": "741/SEL"     , "narrator": "", "text": "千羽鶴がこのアプリを恋愛アプリだって宣伝したでしょ？"},
        { "location": "742/ACT"     , "narrator": "", "text": "千羽鶴がこのアプリを恋愛アプリだって宣伝したでしょ？"},
        { "location": "744/TALK"    , "narrator": "千羽鶴", "text": "まあ、確かに。"},
        { "location": "745/SEL"     , "narrator": "", "text": "その責任をとって、景表法対策でラブラブルートを新設したんだって"},
        { "location": "746/ACT"     , "narrator": "", "text": "その責任をとって、景表法対策でラブラブルートを新設したんだって"},
        { "location": "748/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "749/TALK"    , "narrator": "千羽鶴", "text": "ふーん。"},
        { "location": "759/TALK"    , "narrator": "千羽鶴", "text": "…なるほど。"},
        { "location": "760/TALK"    , "narrator": "千羽鶴", "text": "覚えておく。"},
        { "location": "762/TALK"    , "narrator": "千羽鶴", "text": "とにかく、\n情報ありがと。"},
        { "location": "763/TALK"    , "narrator": "千羽鶴", "text": "今後の行動の\n指針にさせてもらう。"},
        { "location": "764/TALK"    , "narrator": "千羽鶴", "text": "まあ話を戻すと、\nそんなことがあって\n少し予定が変わった。"},
        { "location": "765/SEL"     , "narrator": "", "text": "というと？"},
        { "location": "766/ACT"     , "narrator": "", "text": "というと？"},
        { "location": "768/TALK"    , "narrator": "千羽鶴", "text": "本来の予定では――"},
        { "location": "769/TALK"    , "narrator": "千羽鶴", "text": "今の時間は、私たちの\nリプレイス作戦の全貌と\n今後の蒸着の流れ、"},
        { "location": "770/TALK"    , "narrator": "千羽鶴", "text": "そして持続的な世界維持の\n実現方法についてを\n共有する予定だった。"},
        { "location": "771/TALK"    , "narrator": "千羽鶴", "text": "けどその前に、\n原初状態の私について\n速やかに調査をし――"},
        { "location": "772/TALK"    , "narrator": "千羽鶴", "text": "状況によっては\n何らかの対処も\nしてしまいたい。"},
        { "location": "773/TALK"    , "narrator": "千羽鶴", "text": "だから、\nそれを先に\nやらせて欲しい。"},
        { "location": "774/SEL"     , "narrator": "", "text": "いいよ"},
        { "location": "775/SEL"     , "narrator": "", "text": "リプレイスのこと、ちゃんと教えてね？"},
        { "location": "776/ACT"     , "narrator": "", "text": "いいよ"},
        { "location": "778/TALK"    , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "779/ACT"     , "narrator": "", "text": "リプレイスのこと、ちゃんと教えてね？"},
        { "location": "781/TALK"    , "narrator": "千羽鶴", "text": "もちろん。"},
        { "location": "784/TALK"    , "narrator": "千羽鶴", "text": "それじゃ、ちょっと\n出かけてくるから。"},
        { "location": "785/TALK"    , "narrator": "千羽鶴", "text": "その間、\n過去の記録映像でも見て\n待ってて。"},
        { "location": "787/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/87MB 5:40】</color>"},
        { "location": "788/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/29MB 5:40】</color>"},
        { "location": "789/SEL"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "790/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/87MB 5:40】</color>"},
        { "location": "791/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "797/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/29MB 5:40】</color>"},
        { "location": "798/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "804/ACT"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "805/TALK"    , "narrator": "千羽鶴", "text": "そう……。"},
        { "location": "840/TALK"    , "narrator": "千羽鶴", "text": "ただいま。"},
        { "location": "841/SEL"     , "narrator": "", "text": "おかえりー"},
        { "location": "842/SEL"     , "narrator": "", "text": "お風呂にする？ご飯にする？それとも$me$？"},
        { "location": "843/ACT"     , "narrator": "", "text": "おかえりー"},
        { "location": "845/TALK"    , "narrator": "千羽鶴", "text": "挨拶がもらえる嬉しさ。"},
        { "location": "846/ACT"     , "narrator": "", "text": "お風呂にする？ご飯にする？それとも$me$？"},
        { "location": "848/TALK"    , "narrator": "千羽鶴", "text": "じゃあ、『$me$』で。"},
        { "location": "851/TALK"    , "narrator": "千羽鶴", "text": "それはそうと、\n色んな事がわかった。"},
        { "location": "852/TALK"    , "narrator": "千羽鶴", "text": "詳しい話はまた\n後ほどするけど――"},
        { "location": "853/TALK"    , "narrator": "千羽鶴", "text": "取り急ぎ対処した案件が\n１件ある。"},
        { "location": "854/SEL"     , "narrator": "", "text": "なに！？"},
        { "location": "855/ACT"     , "narrator": "", "text": "なに！？"},
        { "location": "857/TALK"    , "narrator": "千羽鶴", "text": "エリカが言っていた、\n一部において発生してた\nデイドラ時間のズレ。"},
        { "location": "859/TALK"    , "narrator": "千羽鶴", "text": "貴方が言ってた中だと、\n『ラブラブルート』って\nいうのだっけ？"},
        { "location": "861/TALK"    , "narrator": "千羽鶴", "text": "それを、エピソード２０で\n行われるFIXの時点で、\nマージするようにした。"},
        { "location": "862/TALK"    , "narrator": "千羽鶴", "text": "これによって、１０％の\n人達に発生している\n不整合は解消される。"},
        { "location": "864/SEL"     , "narrator": "", "text": "それってもしかして、もうラブラブするだけの生活が出来なくなるってこと？"},
        { "location": "865/ACT"     , "narrator": "", "text": "それってもしかして、もうラブラブするだけの生活が出来なくなるってこと？"},
        { "location": "867/TALK"    , "narrator": "千羽鶴", "text": "よくわからないけど、\n今後はみんな同じものを\n見るようになる。"},
        { "location": "868/SEL"     , "narrator": "", "text": "ラブラブできないのか…しょんぼり"},
        { "location": "869/SEL"     , "narrator": "", "text": "$me$はもう世界に関わりたくないんだ！だからラブラブを選択したのに！"},
        { "location": "870/ACT"     , "narrator": "", "text": "ラブラブできないのか…しょんぼり"},
        { "location": "871/TALK"    , "narrator": "千羽鶴", "text": "んー。\nそうは言っても――"},
        { "location": "872/TALK"    , "narrator": "千羽鶴", "text": "デイドラの時間軸が\n２重化したままなのは\n危険だから。"},
        { "location": "873/TALK"    , "narrator": "千羽鶴", "text": "予期せぬ干渉が発生して\n本線に影響が出るかも。"},
        { "location": "874/TALK"    , "narrator": "千羽鶴", "text": "例えば、前回の別時間軸の\nデイドラは、私たちの設定\n時間の数時間前だった。"},
        { "location": "875/TALK"    , "narrator": "千羽鶴", "text": "もしそこで、何らかの\n大問題が発生してた場合、\n私達にも影響が出たはず。"},
        { "location": "876/TALK"    , "narrator": "千羽鶴", "text": "だから申し訳ないけど、\n干渉するデイドラ時間は、\n極力統合させてもらう。"},
        { "location": "877/SEL"     , "narrator": "", "text": "わかりました"},
        { "location": "878/SEL"     , "narrator": "", "text": "やだーやだー！$me$はラブラブしたいんだー！"},
        { "location": "879/ACT"     , "narrator": "", "text": "わかりました"},
        { "location": "880/TALK"    , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "881/ACT"     , "narrator": "", "text": "やだーやだー！$me$はラブラブしたいんだー！"},
        { "location": "882/TALK"    , "narrator": "千羽鶴", "text": "そう言われても……。"},
        { "location": "883/TALK"    , "narrator": "千羽鶴", "text": "まあ、同一になるのは\nエピソード２０からだし。"},
        { "location": "884/TALK"    , "narrator": "千羽鶴", "text": "少なくともそこまでは\n今のまま、別時間を\n見る感じになると思う。"},
        { "location": "885/TALK"    , "narrator": "千羽鶴", "text": "それまでは、\n思いっきり\n楽しんでくれればいい！"},
        { "location": "886/TALK"    , "narrator": "千羽鶴", "text": "ただし、私たちに\n影響の無い範囲で。"},
        { "location": "888/ACT"     , "narrator": "", "text": "$me$はもう世界に関わりたくないんだ！だからラブラブを選択したのに！"},
        { "location": "889/TALK"    , "narrator": "千羽鶴", "text": "なるほど、\nそういう意図も\nあるのね。"},
        { "location": "890/TALK"    , "narrator": "千羽鶴", "text": "確かに、全員に強制的に\n世界選択をしてもらうのは\n酷かもしれない。"},
        { "location": "891/TALK"    , "narrator": "千羽鶴", "text": "次からは、選択に対する\n棄権もできるように\nしておく。"},
        { "location": "892/TALK"    , "narrator": "千羽鶴", "text": "どうか、\nこの方法で\n手を打って欲しい。"},
        { "location": "896/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\nひとまずの業務連絡は\nおしまい。"},
        { "location": "897/TALK"    , "narrator": "千羽鶴", "text": "ここからは\n本題に入る。\nそれは――"},
        { "location": "900/TALK"    , "narrator": "千羽鶴", "text": "ちーの考える\nすてきなリプレイス\nけいかく！"},
        { "location": "901/TALK"    , "narrator": "千羽鶴", "text": "――を、\n淡々と説明していく。"},
        { "location": "902/SEL"     , "narrator": "", "text": "ついに！！"},
        { "location": "903/ACT"     , "narrator": "", "text": "ついに！！"},
        { "location": "905/TALK"    , "narrator": "千羽鶴", "text": "そう。ついに。"},
        { "location": "906/TALK"    , "narrator": "千羽鶴", "text": "さて、早速だけど――"},
        { "location": "907/TALK"    , "narrator": "千羽鶴", "text": "リプレイス計画の前半は\n既にエリカから話を\n聞いていると思う。"},
        { "location": "913/TALK"    , "narrator": "千羽鶴", "text": "すなわち、\n世界2E113への\n世界情報のコピー――"},
        { "location": "914/TALK"    , "narrator": "千羽鶴", "text": "及び、私が展開している\n現状のフェノメノンの\n平和的収束。"},
        { "location": "915/TALK"    , "narrator": "千羽鶴", "text": "それにより、\nノーギャップで\nフェノメノンを委譲する。"},
        { "location": "916/TALK"    , "narrator": "千羽鶴", "text": "問題はその先。"},
        { "location": "917/TALK"    , "narrator": "千羽鶴", "text": "2E113を蒸着し、\n外の世界と融合する。"},
        { "location": "918/TALK"    , "narrator": "千羽鶴", "text": "これについては\nエリカに任せてあるので\n私には仕組みは解らない。"},
        { "location": "919/TALK"    , "narrator": "千羽鶴", "text": "まあ、それは\nエリカがしっかり\nやってくれるとして――"},
        { "location": "920/TALK"    , "narrator": "千羽鶴", "text": "蒸着後最大かつメインの\n問題として、“彼ら”との\nご対面がある。"},
        { "location": "921/TALK"    , "narrator": "千羽鶴", "text": "フェノメノンという殻から\n出てきた私たちを、彼らが\n何もしないわけがない。"},
        { "location": "926/TALK"    , "narrator": "千羽鶴", "text": "だから、蒸着する前に\nそれに対処するため、\nひとつミッションがある。"},
        { "location": "927/TALK"    , "narrator": "千羽鶴", "text": "そのミッションは、\nつい先日までかなり\n不確定要素が強かった。"},
        { "location": "928/TALK"    , "narrator": "千羽鶴", "text": "けど、先ほどエリカと\nコンタクトを取ったところ\n確実性が増したという。"},
        { "location": "929/SEL"     , "narrator": "", "text": "して、その方法とは？"},
        { "location": "930/ACT"     , "narrator": "", "text": "して、その方法とは？"},
        { "location": "932/TALK"    , "narrator": "千羽鶴", "text": "それは、\nライフギャザーを\n利用する方法。"},
        { "location": "933/SEL"     , "narrator": "", "text": "またライフギャザーが出てきた！"},
        { "location": "934/ACT"     , "narrator": "", "text": "またライフギャザーが出てきた！"},
        { "location": "936/TALK"    , "narrator": "千羽鶴", "text": "ライフギャザーは、\nRedinessのエンジンと\n言われている。"},
        { "location": "937/TALK"    , "narrator": "千羽鶴", "text": "そしてその内部構造は\nエンタングルですら\n解っていないという。"},
        { "location": "940/TALK"    , "narrator": "千羽鶴", "text": "実はフェノメノンを\n完全にコントロール\n出来ないのはこれが原因。"},
        { "location": "941/TALK"    , "narrator": "千羽鶴", "text": "仮にエンタングルが\nライフギャザーを\n熟知していたならば――"},
        { "location": "942/TALK"    , "narrator": "千羽鶴", "text": "日本を包むフェノメノンは\n彼らの思うが儘に、\n出したり消したりできる。"},
        { "location": "943/TALK"    , "narrator": "千羽鶴", "text": "すなわち、\nライフギャザーを完全に\n理解してしまえば――"},
        { "location": "944/TALK"    , "narrator": "千羽鶴", "text": "Redinessを装備する\n個人に対し、様々な\n操作をすることが可能。"},
        { "location": "945/TALK"    , "narrator": "千羽鶴", "text": "それは“彼ら”に対して\nですら、例外ではない。"},
        { "location": "946/SEL"     , "narrator": "", "text": "ライフギャザーを操作して、彼らを逆に洗脳するってことか？"},
        { "location": "947/ACT"     , "narrator": "", "text": "ライフギャザーを操作して、彼らを逆に洗脳するってことか？"},
        { "location": "949/TALK"    , "narrator": "千羽鶴", "text": "敢えて明確に言えば、\nYES。"},
        { "location": "954/TALK"    , "narrator": "千羽鶴", "text": "特定個人の、特定の記憶を\n狙い撃ちし、ごく僅かな\n記憶の改変を行う。"},
        { "location": "955/TALK"    , "narrator": "千羽鶴", "text": "もちろん、可能な限り\n影響は少なくする\nつもりではいる。"},
        { "location": "956/TALK"    , "narrator": "千羽鶴", "text": "目的は、彼らにとって\n私たちが特別な存在では\nなくすること。"},
        { "location": "957/TALK"    , "narrator": "千羽鶴", "text": "今までのフェノメノンや\n卯月神楽の同化を見れば、\nそれが可能なのは明らか。"},
        { "location": "958/TALK"    , "narrator": "千羽鶴", "text": "その為にすこしばかり、\n記憶を操作する。"},
        { "location": "959/TALK"    , "narrator": "千羽鶴", "text": "繭を生まない、個人だけの\n脳内フェノメノンの生成\nとも言える。"},
        { "location": "960/TALK"    , "narrator": "千羽鶴", "text": "もちろん、これは\nあまり褒められた行為では\nないと思う。"},
        { "location": "961/TALK"    , "narrator": "千羽鶴", "text": "だから、ここまで明確に\n言うのは相当悩んだ。"},
        { "location": "962/TALK"    , "narrator": "千羽鶴", "text": "けど、いつかは\n言わなければならないし―"},
        { "location": "963/TALK"    , "narrator": "千羽鶴", "text": "遅くなれば貴方に迷惑を\nかけてしまうから、\n奮起一発コクってみた！"},
        { "location": "969/TALK"    , "narrator": "千羽鶴", "text": "今回は、貴方から\n遅すぎると言われない\n最大最速で情報共有した。"},
        { "location": "970/TALK"    , "narrator": "千羽鶴", "text": "少なくとも、実現までには\nまだ沢山の問題が\n立ちふさがっている。"},
        { "location": "971/TALK"    , "narrator": "千羽鶴", "text": "だから、実行までには\nそれなりに時間がかかる。"},
        { "location": "972/TALK"    , "narrator": "千羽鶴", "text": "貴方にも、今この場で\n意見を聞いたりしない。\n結論も求めない。"},
        { "location": "973/TALK"    , "narrator": "千羽鶴", "text": "貴方も、聞いたばかりでは\n気持ちの整理がつかないと\n思うし――"},
        { "location": "974/TALK"    , "narrator": "千羽鶴", "text": "そうすれば、どうしたって\n感情が優位に立った回答を\nしがちなものだから。"},
        { "location": "975/TALK"    , "narrator": "千羽鶴", "text": "だから、現時点では\n敢えて何も\nコメントしないで。"},
        { "location": "976/TALK"    , "narrator": "千羽鶴", "text": "それ以外で、\n何か聞きたいことが\nあればどうぞ。"},
        { "location": "978/SEL"     , "narrator": "", "text": "ライフギャザーって、どれくらいブラックボックスな物なの？"},
        { "location": "979/SEL"     , "narrator": "", "text": "もしかして、神楽がエンタングルに養子になったのは……"},
        { "location": "980/SEL"     , "narrator": "", "text": "特にない\n<color=blue>（先へ進みます）</color>"},
        { "location": "981/ACT"     , "narrator": "", "text": "ライフギャザーって、どれくらいブラックボックスな物なの？"},
        { "location": "982/TALK"    , "narrator": "千羽鶴", "text": "ほぼ全て。"},
        { "location": "983/TALK"    , "narrator": "千羽鶴", "text": "それこそ、本当に\nRedinessのコアは\nライフギャザーなのか？"},
        { "location": "984/TALK"    , "narrator": "千羽鶴", "text": "そこからケンケンガクガク\n議論が発生するくらいの\nブラックボックス。"},
        { "location": "985/TALK"    , "narrator": "千羽鶴", "text": "実際、その真実は\nつい先日までは\n噂の域を超えなかった。"},
        { "location": "986/TALK"    , "narrator": "千羽鶴", "text": "技術者がPingを送った\nところ、返り値がライフ\nギャザーと似てたとか――"},
        { "location": "987/TALK"    , "narrator": "千羽鶴", "text": "Redinessで未使用の\n拡張バスに\n信号を送ったら――"},
        { "location": "988/TALK"    , "narrator": "千羽鶴", "text": "ライフギャザーと同じ\n信号が返ってきたとか。"},
        { "location": "989/TALK"    , "narrator": "千羽鶴", "text": "その程度の情報で、\nこれはもしや\nライフギャザーでは？と、"},
        { "location": "990/TALK"    , "narrator": "千羽鶴", "text": "そんな噂が\n立っていた程度。"},
        { "location": "991/TALK"    , "narrator": "千羽鶴", "text": "けど、エリカが\nぴょんこの協力を得て\nサーチしたところ――"},
        { "location": "992/TALK"    , "narrator": "千羽鶴", "text": "その可能性は、限りなく\n正解であろうという\n結果を得る事ができた。"},
        { "location": "993/SEL"     , "narrator": "", "text": "ライフギャザーだとすると、どんな良いことがあるの？"},
        { "location": "994/ACT"     , "narrator": "", "text": "ライフギャザーだとすると、どんな良いことがあるの？"},
        { "location": "996/TALK"    , "narrator": "千羽鶴", "text": "エンタングルは、\nRedinessのコア、\nすなわち――"},
        { "location": "997/TALK"    , "narrator": "千羽鶴", "text": "ライフギャザーの\n処理に関する一切の\n情報を非公開にしている。"},
        { "location": "998/TALK"    , "narrator": "千羽鶴", "text": "けど、実は単に\nエンタングル自身も\nわかっていないだけ。"},
        { "location": "999/TALK"    , "narrator": "千羽鶴", "text": "だって、他の会社が作った\nエンジンを載せている\nだけだから。"},
        { "location": "1000/TALK"   , "narrator": "千羽鶴", "text": "そして、それを作った\n会社の令嬢こそが\n卯月神楽。"},
        { "location": "1001/TALK"   , "narrator": "千羽鶴", "text": "エンタングルが彼女を\n取り込んだのには、\nそんな一面もあるのかも。"},
        { "location": "1002/TALK"   , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "1004/ACT"    , "narrator": "", "text": "もしかして、神楽がエンタングルに養子になったのは……"},
        { "location": "1005/TALK"   , "narrator": "千羽鶴", "text": "$handle$の\nその見立ては\n正しいかもしれない。"},
        { "location": "1008/TALK"   , "narrator": "千羽鶴", "text": "ライフギャザーの\n設計主任である\n卯月文雄は今はいない。"},
        { "location": "1009/TALK"   , "narrator": "千羽鶴", "text": "自殺の理由は、\n経営破綻による責任の\n重さだと言われてたけど―"},
        { "location": "1010/TALK"   , "narrator": "千羽鶴", "text": "それ以外の理由が\nあったのではないかと\n言われてる。"},
        { "location": "1011/TALK"   , "narrator": "千羽鶴", "text": "それは、ライフギャザーの\n技術漏洩を防ぐため。"},
        { "location": "1012/SEL"    , "narrator": "", "text": "その為に自殺は、さすがに考えすぎでは？"},
        { "location": "1013/ACT"    , "narrator": "", "text": "その為に自殺は、さすがに考えすぎでは？"},
        { "location": "1015/TALK"   , "narrator": "千羽鶴", "text": "そうでもない。"},
        { "location": "1016/TALK"   , "narrator": "千羽鶴", "text": "それは、脳と直結が可能な\nライフギャザーという技術\nだからこそのこと。"},
        { "location": "1017/TALK"   , "narrator": "千羽鶴", "text": "恐らく卯月文雄は\nわかっていた。"},
        { "location": "1018/TALK"   , "narrator": "千羽鶴", "text": "デジタルやペーパーの\n情報を全て破棄しても、\n仕様は残ってしまう事を。"},
        { "location": "1019/SEL"    , "narrator": "", "text": "それは、脳自体が設計図の保存媒体になってしまっているということ？"},
        { "location": "1020/ACT"    , "narrator": "", "text": "それは、脳自体が設計図の保存媒体になってしまっているということ？"},
        { "location": "1022/TALK"   , "narrator": "千羽鶴", "text": "その通り。"},
        { "location": "1024/TALK"   , "narrator": "千羽鶴", "text": "なぜならその後、\nエリカと私は――"},
        { "location": "1025/TALK"   , "narrator": "千羽鶴", "text": "エンタングルが、とある\n不自然な行動を取っている\n事を知ってしまったから。"},
        { "location": "1026/SEL"    , "narrator": "", "text": "どんなこと？"},
        { "location": "1027/ACT"    , "narrator": "", "text": "どんなこと？"},
        { "location": "1029/TALK"   , "narrator": "千羽鶴", "text": "卯月神楽と卯月美佐子に\n非正規発行のRediness\nアカウントを与えている。"},
        { "location": "1032/TALK"   , "narrator": "千羽鶴", "text": "通常Redinessの\nアカウントは、国家が\n住民登録の際に発行する。"},
        { "location": "1033/TALK"   , "narrator": "千羽鶴", "text": "けれども、彼女ら2名は\n国家が発行した\nアカウントではなく――"},
        { "location": "1034/TALK"   , "narrator": "千羽鶴", "text": "エンタングルが独自に\n発行したアカウントを\n使用している。"},
        { "location": "1035/TALK"   , "narrator": "千羽鶴", "text": "私もエリカも、当初は\nそんなことは気づきも\nしなかった。"},
        { "location": "1036/TALK"   , "narrator": "千羽鶴", "text": "けれども、この\nアカウントの件と、\n養子の件……。"},
        { "location": "1037/TALK"   , "narrator": "千羽鶴", "text": "今では、これが“彼ら”の\nライフギャザー真相究明の\n野望と関係あると見ている"},
        { "location": "1040/TALK"   , "narrator": "千羽鶴", "text": "今言えることは\nこれくらい。"},
        { "location": "1041/TALK"   , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "1043/ACT"    , "narrator": "", "text": "特にない\n<color=blue>（先へ進みます）</color>"},
        { "location": "1045/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1046/TALK"   , "narrator": "千羽鶴", "text": "最後になるけど、\n私から貴方に\n２つの武器を進呈する。"},
        { "location": "1047/TALK"   , "narrator": "千羽鶴", "text": "１つは、\n<color=red>私のWAVEアカウント。</color>"},
        { "location": "1048/TALK"   , "narrator": "千羽鶴", "text": "何らかの問題が発生した時\n直接長官の私と話せた方が\n都合がいいと思うから。"},
        { "location": "1049/TALK"   , "narrator": "千羽鶴", "text": "それと、もう１つは――"},
        { "location": "1050/TALK"   , "narrator": "千羽鶴", "text": "まだ上手く稼働するか\nわからないけど。"},
        { "location": "1051/TALK"   , "narrator": "千羽鶴", "text": "ライフギャザーの\n隠し機能を１つ解析\n出来たから、それを。"},
        { "location": "1052/SEL"    , "narrator": "", "text": "なにそれ！？"},
        { "location": "1053/ACT"    , "narrator": "", "text": "なにそれ！？"},
        { "location": "1055/TALK"   , "narrator": "千羽鶴", "text": "<color=red>WAVEを使わずとも\n貴方の会話を彼女の\n脳内に送り届ける機能。</color>"},
        { "location": "1056/TALK"   , "narrator": "千羽鶴", "text": "取り急ぎ、試験用に\n卯月神楽のアカウントに\n紐付けてある。"},
        { "location": "1057/TALK"   , "narrator": "千羽鶴", "text": "必要な時に使えば、\n卯月神楽とは\n脳内で会話が可能になる。"},
        { "location": "1058/SEL"    , "narrator": "", "text": "それって、メチャクチャチートじゃない？"},
        { "location": "1059/ACT"    , "narrator": "", "text": "それって、メチャクチャチートじゃない？"},
        { "location": "1061/TALK"   , "narrator": "千羽鶴", "text": "その通り。\nけど、こんなのは序の口。"},
        { "location": "1062/TALK"   , "narrator": "千羽鶴", "text": "ライフギャザーの全仕様が\n明らかになれば、もっと\n色んなことができる。"},
        { "location": "1063/TALK"   , "narrator": "千羽鶴", "text": "……らしい。\nエリカが言うには。"},
        { "location": "1065/TALK"   , "narrator": "千羽鶴", "text": "とにかく\nそういうわけで、\n今は――"},
        { "location": "1070/TALK"   , "narrator": "赤髪千羽鶴", "text": "ライフギャザーの解明が\n最重要事項となっている。"},
        { "location": "1073/SEL"    , "narrator": "", "text": "！？！？！？"},
        { "location": "1074/ACT"    , "narrator": "", "text": "！？！？！？"},
        { "location": "1078/TALK"   , "narrator": "千羽鶴", "text": "ん？\nどうしたの？"},
        { "location": "1079/SEL"    , "narrator": "", "text": "今、原初のつばめが…"},
        { "location": "1080/ACT"    , "narrator": "", "text": "今、原初のつばめが…"},
        { "location": "1085/TALK"   , "narrator": "赤髪千羽鶴", "text": "原初状態のつばめが\n出てきちゃったって\n言いたかったんですか？"},
        { "location": "1086/SEL"    , "narrator": "", "text": "つばめ…さん！？"},
        { "location": "1087/ACT"    , "narrator": "", "text": "つばめ…さん！？"},
        { "location": "1092/TALK"   , "narrator": "千羽鶴", "text": "んー…。\n確かにつばめでは\nあるけど、私は――"},
        { "location": "1095/TALK"   , "narrator": "赤髪千羽鶴", "text": "もちろん、\n逢瀬つばめです。"},
        { "location": "1096/SEL"    , "narrator": "", "text": "えっ！？えっ！？！？"},
        { "location": "1097/ACT"    , "narrator": "", "text": "えっ！？えっ！？！？"},
        { "location": "1099/TALK"   , "narrator": "赤髪千羽鶴", "text": "やっと……\nやっと、同一レイヤーに\n到達出来ました！"},
        { "location": "1100/TALK"   , "narrator": "赤髪千羽鶴", "text": "これからわたしが\nナビゲーターを\nさせていただきます！"},
        { "location": "1101/TALK"   , "narrator": "赤髪千羽鶴", "text": "よろしくお願いします！"},
