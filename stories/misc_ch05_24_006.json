        { "location": "8375/SEL"     , "narrator": "", "text": "中身があふれ出ちゃうぅぅぅ！"},
        { "location": "8376/ACT"     , "narrator": "", "text": "神楽にふさわしい$me$になるよ"},
        { "location": "8378/TALK"    , "narrator": "神楽", "text": "謙虚かつ自信ありげなその言葉"},
        { "location": "8379/TALK"    , "narrator": "神楽", "text": "ぴょんこはこの目でしかと見た"},
        { "location": "8380/TALK"    , "narrator": "神楽", "text": "絶対だな～？"},
        { "location": "8381/TALK"    , "narrator": "神楽", "text": "期待してるから★"},
        { "location": "8382/ACT"     , "narrator": "", "text": "器小さくてごめんね…？"},
        { "location": "8383/TALK"    , "narrator": "神楽", "text": "そんなこと、、、あるかもね？"},
        { "location": "8384/TALK"    , "narrator": "神楽", "text": "まあがんばれ！"},
        { "location": "8385/ACT"     , "narrator": "", "text": "中身があふれ出ちゃうぅぅぅ！"},
