        { "location": "8354/TALK"    , "narrator": "神楽", "text": "つい溢れてしまうものなーんだ？"},
        { "location": "8356/SEL"     , "narrator": "", "text": "風呂の湯"},
        { "location": "8357/SEL"     , "narrator": "", "text": "神楽への愛"},
