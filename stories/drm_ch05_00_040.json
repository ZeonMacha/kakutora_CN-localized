    [
        { "location": "564/SCENARIO", "narrator": "", "text": "晴れ晴れ天晴"},
        { "location": "589/TALK"    , "narrator": "神楽", "text": "あーあーあーあー！"},
        { "location": "590/TALK"    , "narrator": "神楽", "text": "ついに来てしまいます"},
        { "location": "591/TALK"    , "narrator": "神楽", "text": "トライナリー、ひいてはつばめさんと対面する時が"},
        { "location": "593/SEL"     , "narrator": "", "text": "楽しみだね"},
        { "location": "594/SEL"     , "narrator": "", "text": "大変そう"},
        { "location": "595/SEL"     , "narrator": "", "text": "応援するよ"},
        { "location": "596/ACT"     , "narrator": "", "text": "楽しみだね"},
        { "location": "597/TALK"    , "narrator": "神楽", "text": "そう思えればどんなにいいか"},
        { "location": "598/TALK"    , "narrator": "神楽", "text": "$handle$さんはわかりますか（暗黒微笑"},
        { "location": "599/ACT"     , "narrator": "", "text": "大変そう"},
        { "location": "601/TALK"    , "narrator": "神楽", "text": "大変なんですぴょん、、、"},
        { "location": "602/ACT"     , "narrator": "", "text": "応援するよ"},
        { "location": "603/TALK"    , "narrator": "神楽", "text": "$handle$さんﾔｻｼｰ、、、"},
        { "location": "605/TALK"    , "narrator": "神楽", "text": "ちょっとｳﾙｯときましたぴょん、、、"},
        { "location": "607/TALK"    , "narrator": "神楽", "text": "いっそ初対面で全部片がつけば楽だと思いませんか？？？"},
        { "location": "609/SEL"     , "narrator": "", "text": "確かにそうだけど"},
        { "location": "610/SEL"     , "narrator": "", "text": "それって契約違反じゃない？"},
        { "location": "611/SEL"     , "narrator": "", "text": "そうなるといいね"},
        { "location": "612/ACT"     , "narrator": "", "text": "確かにそうだけど"},
        { "location": "613/TALK"    , "narrator": "神楽", "text": "わかってますよーだ"},
        { "location": "614/TALK"    , "narrator": "神楽", "text": "そんなことできないってことは、、、"},
        { "location": "615/ACT"     , "narrator": "", "text": "それって契約違反じゃない？"},
        { "location": "616/TALK"    , "narrator": "神楽", "text": "知ってるし！！！"},
        { "location": "617/TALK"    , "narrator": "神楽", "text": "知ってますし！！！"},
        { "location": "618/ACT"     , "narrator": "", "text": "そうなるといいね"},
        { "location": "619/TALK"    , "narrator": "神楽", "text": "あーあーあーあー"},
        { "location": "620/TALK"    , "narrator": "神楽", "text": "なったらきっと、ぴょんこは白いのに消されるぴょん"},
        { "location": "622/TALK"    , "narrator": "神楽", "text": "でも"},
        { "location": "623/TALK"    , "narrator": "神楽", "text": "$handle$さんはぴょんこを見守ってくれますよね？"},
        { "location": "625/SEL"     , "narrator": "", "text": "当然でしょ"},
        { "location": "626/SEL"     , "narrator": "", "text": "いつでも見てるよ"},
        { "location": "627/SEL"     , "narrator": "", "text": "どういう心境の変化？？？"},
        { "location": "628/ACT"     , "narrator": "", "text": "当然でしょ"},
        { "location": "630/ACT"     , "narrator": "", "text": "いつでも見てるよ"},
        { "location": "632/ACT"     , "narrator": "", "text": "どういう心境の変化？？？"},
        { "location": "634/TALK"    , "narrator": "神楽", "text": "ぴょんこは$handle$さんのことやさしい人だって思ったから"},
        { "location": "635/TALK"    , "narrator": "神楽", "text": "やさしくして欲しいって思っただけですよ？？？"},
        { "location": "637/TALK"    , "narrator": "神楽", "text": "ぴょんこはこの世界で魔法に匹敵する能力を持った少女として"},
        { "location": "638/TALK"    , "narrator": "神楽", "text": "トライナリーに加わるわけです"},
        { "location": "639/TALK"    , "narrator": "神楽", "text": "そして魔法少女に必須なのがナビゲーター兼マスコットキャラなのです"},
        { "location": "641/SEL"     , "narrator": "", "text": "それが$me$って言いたいの？"},
        { "location": "642/SEL"     , "narrator": "", "text": "恋人ポジション希望なんだけどなー"},
        { "location": "643/SEL"     , "narrator": "", "text": "今はそれに甘んじるけど"},
        { "location": "644/ACT"     , "narrator": "", "text": "それが$me$って言いたいの？"},
        { "location": "645/TALK"    , "narrator": "神楽", "text": "ご不満ですか？"},
        { "location": "646/ACT"     , "narrator": "", "text": "恋人ポジション希望なんだけどなー"},
        { "location": "647/TALK"    , "narrator": "神楽", "text": "それはまたそのうちね♪"},
        { "location": "648/ACT"     , "narrator": "", "text": "今はそれに甘んじるけど"},
        { "location": "649/TALK"    , "narrator": "神楽", "text": "ふっふ～ん？"},
        { "location": "650/TALK"    , "narrator": "神楽", "text": "なにやら含んでますか？"},
        { "location": "654/TALK"    , "narrator": "神楽", "text": "ぴょんこテンション高く色々話してますけど"},
        { "location": "655/TALK"    , "narrator": "神楽", "text": "本当はもうドキドキなんですよ？？？"},
        { "location": "657/SEL"     , "narrator": "", "text": "知ってるし"},
        { "location": "658/SEL"     , "narrator": "", "text": "じゃあ深呼吸してみよう"},
        { "location": "659/SEL"     , "narrator": "", "text": "$me$にもドキドキしてほしいな～"},
        { "location": "660/ACT"     , "narrator": "", "text": "知ってるし"},
        { "location": "661/TALK"    , "narrator": "神楽", "text": "ですよねですよね"},
        { "location": "662/TALK"    , "narrator": "神楽", "text": "さすが$handle$さん♪"},
        { "location": "663/ACT"     , "narrator": "", "text": "じゃあ深呼吸してみよう"},
        { "location": "664/TALK"    , "narrator": "神楽", "text": "ｽｰﾊｰｽｰﾊｰ、、、"},
        { "location": "665/TALK"    , "narrator": "神楽", "text": "少し落ち着いたｶﾅ？"},
        { "location": "666/ACT"     , "narrator": "", "text": "$me$にもドキドキしてほしいな～"},
        { "location": "667/TALK"    , "narrator": "神楽", "text": "すぐそういうこと言うんですね♪"},
        { "location": "668/TALK"    , "narrator": "神楽", "text": "ﾄﾞｷﾄﾞｷさせてください～★"},
        { "location": "670/TALK"    , "narrator": "神楽", "text": "よろしくお願いしますね？"},
        { "location": "671/TALK"    , "narrator": "神楽", "text": "頼りにしてますから♪"}
