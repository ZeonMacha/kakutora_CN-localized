{
    "dir": "chap25/daydra/dd_ch03_25_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "25352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "襲撃前夜＜ガブリエラ編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "襲撃前夜～ガブリエラ編～"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "――というわけで、\n館長からいつ連絡が\n来るかわからない。"},
        { "location": "27/TALK"   , "narrator": "アーヤ", "text": "だから、今夜はみんな、\n劇場に泊まってもらうわ。"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "やっぱそうなるかぁ…。\nまあ、しゃあないな。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "それと、外部と連絡を\nする場合は、間違っても\nストの話はしないこと。"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "みんな、いい？"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "りょーかい。"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "わかりました…。"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "言うわけないでしょ？\n機密漏えいに\nなっちゃうし…。"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "うん…それじゃみんな、\nよろしくね。"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "…わたしたち、\nどうなっちゃうんだろ？"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "まったく、情けない声\n出して…頼りないわねぇ。"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "ガブちゃんは\n不安じゃないの？"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "不安に決まってるでしょ？"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "でも、不安だからって\n暗くなってても\n仕方ないじゃない。"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "まったく…、\nいつまで経っても\n新人気分なんだから…。"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "なにかあると、\nすぐに不安そうな\n顔して…。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "…大丈夫かしら？"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "…まさか、ひなこ達に\nストのこと\n話してるんじゃ…。"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "って、それはないか…。\nさすがに、今のは\nつばめに悪かったわ…。"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "あたしは…どうしよう？"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "気軽に連絡し合うような\n友達もいないし…。"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "…って、なんかあたし、\nすっごい寂しいこと\n思ってる？"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "71/SEL"    , "narrator": "", "text": "元気出して"},
        { "location": "72/ACT"    , "narrator": "", "text": "元気出して"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "心配しないで"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "私は平気よ"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "ただね"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "私には"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "気軽に連絡できる人がいない"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "そう思っただけなの"},
        { "location": "97/SEL"    , "narrator": "", "text": "$me$じゃダメ？"},
        { "location": "98/SEL"    , "narrator": "", "text": "雛達は？"},
        { "location": "99/SEL"    , "narrator": "", "text": "無理にすることないよ"},
        { "location": "100/ACT"   , "narrator": "", "text": "$me$じゃダメ？"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "ダメよ"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "だって$marzanna$とは"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "そんなことする必要ないででしょ？"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "いつも一緒なんだから"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "話しかけても"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "いつもと同じおしゃべりになるだけよ"},
        { "location": "109/SEL"   , "narrator": "", "text": "それじゃつまらないか"},
        { "location": "110/SEL"   , "narrator": "", "text": "おしゃべりも楽しいよ？"},
        { "location": "111/ACT"   , "narrator": "", "text": "それじゃつまらないか"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "言い方が悪いわ"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "つまらなくないから"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "わたしは"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$とのおしゃべり"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "とっても好きよ？"},
        { "location": "117/ACT"   , "narrator": "", "text": "おしゃべりも楽しいよ？"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "そうなんだけど"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "しばらく"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "外部との連絡が取れなくなるかもしれないのに"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "これからもずっと話せる"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$とばかりなのは"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "どうかと思って"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "でも思えば"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$はいつも"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "一緒にいてくれるわね"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "私の隣に"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "一緒にいるわけじゃないけど"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "スマホの向こうに"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "いつもいてくれる"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "注意してくれたり"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "話し相手になってくれたり"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "たまに"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "励ましてくれたり"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "私の執事が務まるのは"},
        { "location": "144/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$しかいないわ"},
        { "location": "146/SEL"   , "narrator": "", "text": "光栄です、お嬢様"},
        { "location": "147/SEL"   , "narrator": "", "text": "執事じゃなきゃダメ？"},
        { "location": "148/ACT"   , "narrator": "", "text": "光栄です、お嬢様"},
        { "location": "149/TALK"  , "narrator": "ガブリエラ", "text": "頼りになる$marzanna$"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "今後とも励むように"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "なんてね//////"},
        { "location": "153/ACT"   , "narrator": "", "text": "執事じゃなきゃダメ？"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "当然でしょう？"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$は私の執事"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "ずっとそうだったじゃない"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "それは多分"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "これからも"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "なんでもない"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "とにかく"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$は執事として"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "完璧ってこと"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "そういうわけだから"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "これからも執事としてのパーフェクトな仕事"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "期待してるわ"},
        { "location": "183/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "184/TALK"  , "narrator": "ガブリエラ", "text": "本当…$marzanna$には\n助けられてるわ…。"},
        { "location": "185/TALK"  , "narrator": "ガブリエラ", "text": "いつもそうだから、\n当たり前のように\n思ってたけど…。"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "とってもありがたい\nことよね…。"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "なんか、さっきまでの\n寂しい気持ち、\n消えちゃったな…。"},
        { "location": "189/TALK"  , "narrator": "ガブリエラ", "text": "今は、なんとなくだけど\n満足した気持ちになってる\nような…？"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり、あたしが\n一番連絡を取りたいと\n思ってる相手は――"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "$handle$、って\nことなのかしら…？"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "$handle$は"},
        { "location": "198/TALK"  , "narrator": "ガブリエラ", "text": "とっても大切で"},
        { "location": "199/TALK"  , "narrator": "ガブリエラ", "text": "特別な人よ"},
        { "location": "201/SEL"   , "narrator": "", "text": "光栄だよ"},
        { "location": "202/SEL"   , "narrator": "", "text": "ガブリエラも特別な存在だ"},
        { "location": "203/ACT"   , "narrator": "", "text": "光栄だよ"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "頼りになる$handle$"},
        { "location": "207/TALK"  , "narrator": "ガブリエラ", "text": "今後ともよろしくね//////"},
        { "location": "208/ACT"   , "narrator": "", "text": "ガブリエラも特別な存在だ"},
        { "location": "210/TALK"  , "narrator": "ガブリエラ", "text": "嬉しいけど"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "急にそんなこと言われたら"},
        { "location": "212/TALK"  , "narrator": "ガブリエラ", "text": "恥ずかしいわ////////"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "これからも"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "ずっと特別な$handle$でいてね"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "私も"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "$handle$の特別でいたいから"},
        { "location": "230/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "231/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、ちょっと…、\n恥ずかしいこと\n言い過ぎたかも…。"},
        { "location": "232/TALK"  , "narrator": "ガブリエラ", "text": "寂しい気持ちは\n消えたけど、\n顔が熱いし…。"},
        { "location": "234/TALK"  , "narrator": "ガブリエラ", "text": "この感じ、\n苦手なのに…。"},
        { "location": "235/TALK"  , "narrator": "ガブリエラ", "text": "…でも――"},
        { "location": "236/TALK"  , "narrator": "ガブリエラ", "text": "なんだか、\nとっても幸せかも…。"},
        { "location": "239/ACT"   , "narrator": "", "text": "雛達は？"},
        { "location": "240/TALK"  , "narrator": "ガブリエラ", "text": "ひなこたち？"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "話すのは楽しいけど"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "特に話すことないわ"},
        { "location": "243/TALK"  , "narrator": "ガブリエラ", "text": "ストのこと話せないのに"},
        { "location": "244/TALK"  , "narrator": "ガブリエラ", "text": "理由もなく"},
        { "location": "245/TALK"  , "narrator": "ガブリエラ", "text": "話がしたいなんて言ったら"},
        { "location": "246/TALK"  , "narrator": "ガブリエラ", "text": "それだけで怪しまれるわ"},
        { "location": "247/TALK"  , "narrator": "ガブリエラ", "text": "普段あたし"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "そういうことしないし"},
        { "location": "249/TALK"  , "narrator": "ガブリエラ", "text": "それに"},
        { "location": "250/TALK"  , "narrator": "ガブリエラ", "text": "向こうも結構鋭いから"},
        { "location": "253/TALK"  , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "254/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり送るべきじゃないわ"},
        { "location": "255/TALK"  , "narrator": "ガブリエラ", "text": "多分"},
        { "location": "256/TALK"  , "narrator": "ガブリエラ", "text": "ロクなことにならないし"},
        { "location": "258/SEL"   , "narrator": "", "text": "どういうこと？"},
        { "location": "259/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "262/TALK"  , "narrator": "ガブリエラ", "text": "そう思っただけよ"},
        { "location": "273/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "274/TALK"  , "narrator": "ガブリエラ", "text": "話したいけど、\nもしちょっとでも\n怪しいと思われたら…。"},
        { "location": "275/TALK"  , "narrator": "ガブリエラ", "text": "ひなこ達まで\n巻き込むことになるかも\nしれない…。"},
        { "location": "276/TALK"  , "narrator": "ガブリエラ", "text": "それだけは、\n絶対に避けないと。"},
        { "location": "277/TALK"  , "narrator": "ガブリエラ", "text": "あの子達は…、\n大切な友達なんだから…。"},
        { "location": "278/ACT"   , "narrator": "", "text": "無理にすることないよ"},
        { "location": "279/TALK"  , "narrator": "ガブリエラ", "text": "なんだかそれ"},
        { "location": "281/TALK"  , "narrator": "ガブリエラ", "text": "友達がいないんだから無理するなって"},
        { "location": "282/TALK"  , "narrator": "ガブリエラ", "text": "言われてる気になるわね"},
        { "location": "285/TALK"  , "narrator": "ガブリエラ", "text": "実際そうなんだけど"},
        { "location": "286/TALK"  , "narrator": "ガブリエラ", "text": "普段から"},
        { "location": "287/TALK"  , "narrator": "ガブリエラ", "text": "アーヤ達くらいにしか"},
        { "location": "288/TALK"  , "narrator": "ガブリエラ", "text": "ＷＡＶＥなんて送らないし"},
        { "location": "289/TALK"  , "narrator": "ガブリエラ", "text": "ひなこ達にも"},
        { "location": "290/TALK"  , "narrator": "ガブリエラ", "text": "用事がなきゃ送らないし"},
        { "location": "293/TALK"  , "narrator": "ガブリエラ", "text": "ストライキが終わって"},
        { "location": "294/TALK"  , "narrator": "ガブリエラ", "text": "今までの生活に"},
        { "location": "295/TALK"  , "narrator": "ガブリエラ", "text": "戻れたら"},
        { "location": "296/TALK"  , "narrator": "ガブリエラ", "text": "お友達作り"},
        { "location": "298/TALK"  , "narrator": "ガブリエラ", "text": "本気で頑張ろうかしら？"},
        { "location": "25/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月3日　 5:44 PM</color>\nストライキ開始当日、神楽坂トライナリー楽屋にて"}
    ]
}
