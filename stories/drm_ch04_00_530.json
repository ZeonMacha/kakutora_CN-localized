    "entry":
    [
        { "location": "160/SCENARIO", "narrator": "", "text": "450_相対性理論とは特殊相対性理論と一般相対性理論の総称である"},
        { "location": "185/TALK"    , "narrator": "みやび", "text": "知っておったか？"},
        { "location": "186/TALK"    , "narrator": "みやび", "text": "大正時代、相対とは"},
        { "location": "187/TALK"    , "narrator": "みやび", "text": "男女の仲を意味したことを"},
        { "location": "189/SEL"     , "narrator": "", "text": "相対……取引？"},
        { "location": "190/SEL"     , "narrator": "", "text": "今は平成だよ"},
        { "location": "191/SEL"     , "narrator": "", "text": "相対性理論の意味が違ってくるね"},
        { "location": "192/ACT"     , "narrator": "", "text": "相対……取引？"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "証券用語で攻めてくるとは"},
        { "location": "203/TALK"    , "narrator": "みやび", "text": "意外とやりおる"},
        { "location": "204/ACT"     , "narrator": "", "text": "今は平成だよ"},
        { "location": "205/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "明治は遠くなりにけり"},
        { "location": "208/ACT"     , "narrator": "", "text": "相対性理論の意味が違ってくるね"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "深読みするじゃろ"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "やっぱり"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "そういうわけで"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "相対の新しい意味を考えようと思うのだが"},
        { "location": "215/SEL"     , "narrator": "", "text": "「そうたい」なの「あいたい」なの"},
        { "location": "216/SEL"     , "narrator": "", "text": "いや、意味がわかりません"},
        { "location": "217/SEL"     , "narrator": "", "text": "また今度ね"},
        { "location": "218/ACT"     , "narrator": "", "text": "「そうたい」なの「あいたい」なの"},
        { "location": "228/TALK"    , "narrator": "みやび", "text": "あいたい"},
        { "location": "229/TALK"    , "narrator": "みやび", "text": "かな"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "会いたいし"},
        { "location": "232/SEL"     , "narrator": "", "text": "会いたいね"},
        { "location": "233/SEL"     , "narrator": "", "text": "今会ってるでしょ"},
        { "location": "234/ACT"     , "narrator": "", "text": "会いたいね"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "そうであろう"},
        { "location": "237/TALK"    , "narrator": "みやび", "text": "そうであろう"},
        { "location": "238/ACT"     , "narrator": "", "text": "今会ってるでしょ"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "んー"},
        { "location": "240/TALK"    , "narrator": "みやび", "text": "ディスプレイ越しだが"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "会ってるといえば会っているかもしれん"},
        { "location": "244/SEL"     , "narrator": "", "text": "そういえば"},
        { "location": "245/ACT"     , "narrator": "", "text": "そういえば"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "249/SEL"     , "narrator": "", "text": "なんで大正時代の話になったの"},
        { "location": "250/ACT"     , "narrator": "", "text": "なんで大正時代の話になったの"},
        { "location": "251/TALK"    , "narrator": "みやび", "text": "特に意味はない"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "あえて言うなら"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "古着の着物を見に行ったから？"},
        { "location": "256/SEL"     , "narrator": "", "text": "聞かれても"},
        { "location": "257/SEL"     , "narrator": "", "text": "いいのあった？"},
        { "location": "258/ACT"     , "narrator": "", "text": "聞かれても"},
        { "location": "259/TALK"    , "narrator": "みやび", "text": "そうかえ"},
        { "location": "260/ACT"     , "narrator": "", "text": "いいのあった？"},
        { "location": "261/TALK"    , "narrator": "みやび", "text": "いいなと思うのはあったが"},
        { "location": "262/TALK"    , "narrator": "みやび", "text": "丈が足りなんだ"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "無念"},
        { "location": "266/TALK"    , "narrator": "みやび", "text": "大正ロマンというが"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "考えてみればこの平成より短い期間だったわけで"},
        { "location": "269/SEL"     , "narrator": "", "text": "命短し恋せよ乙女、だよ"},
        { "location": "270/ACT"     , "narrator": "", "text": "命短し恋せよ乙女、だよ"},
        { "location": "271/TALK"    , "narrator": "みやび", "text": "ん？"},
        { "location": "274/SEL"     , "narrator": "", "text": "大正時代の歌謡曲"},
        { "location": "275/ACT"     , "narrator": "", "text": "大正時代の歌謡曲"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "そうであったか"},
        { "location": "279/SEL"     , "narrator": "", "text": "今度歌ってよ"},
        { "location": "280/ACT"     , "narrator": "", "text": "今度歌ってよ"},
        { "location": "281/TALK"    , "narrator": "みやび", "text": "うちは知らんぞね"},
        { "location": "282/TALK"    , "narrator": "みやび", "text": "その歌を"},
        { "location": "283/TALK"    , "narrator": "みやび", "text": "故に$handle$が歌え"},
        { "location": "285/TALK"    , "narrator": "みやび", "text": "うちのために"},
        { "location": "286/TALK"    , "narrator": "みやび", "text": "愛の歌なら聞いてやるぞね"},
        { "location": "288/ACT"     , "narrator": "", "text": "いや、意味がわかりません"},
        { "location": "289/TALK"    , "narrator": "みやび", "text": "全く"},
        { "location": "290/TALK"    , "narrator": "みやび", "text": "乙女心のわからんやつめ"},
        { "location": "291/ACT"     , "narrator": "", "text": "また今度ね"},
        { "location": "292/TALK"    , "narrator": "みやび", "text": "今度とか"},
        { "location": "293/TALK"    , "narrator": "みやび", "text": "そんなことでは困る"},
        { "location": "294/TALK"    , "narrator": "みやび", "text": "だが"},
        { "location": "295/TALK"    , "narrator": "みやび", "text": "今回は許す"},
        { "location": "296/TALK"    , "narrator": "みやび", "text": "特別に"},
        { "location": "298/TALK"    , "narrator": "みやび", "text": "取り急ぎ"},
        { "location": "299/TALK"    , "narrator": "みやび", "text": "うちの歌を聞け"},
        { "location": "302/TALK"    , "narrator": "ボイスメール", "text": "即興詩人"},
        { "location": "198/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "224/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "314/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【即興詩人】</color>\nをゲットしました！"}
    ]
}
