        "title": "002 チュートリアル　STEP 2",
        "sub_title": "ヒロイン紹介"
    },
    "entry":
    [
        { "location": "443/SCENARIO", "narrator": "", "text": "チュートリアル_ヒロイン紹介"},
        { "location": "462/TALK"    , "narrator": "千羽鶴", "text": "それじゃ早速、\n貴方のフィアンセとの\nご対面といきましょうか。"},
        { "location": "483/TALK"    , "narrator": "千羽鶴", "text": "彼女たちは皆、\nトライナリーとして\n世界を守る傍ら――"},
        { "location": "484/TALK"    , "narrator": "千羽鶴", "text": "勉強に、遊びに、そして\n恋に一生懸命な、\nごく普通の女の子。"},
        { "location": "486/TALK"    , "narrator": "千羽鶴", "text": "プロファイル０１、\n逢瀬つばめ\n１５歳、高校１年。"},
        { "location": "487/TALK"    , "narrator": "千羽鶴", "text": "いつも元気で天然系の\n前向き指向、まわりを\n笑顔にするのが得意。"},
        { "location": "488/TALK"    , "narrator": "千羽鶴", "text": "なかなか骨太な世間\n知らずのところがウザ\nカワイイ…かも。"},
        { "location": "489/TALK"    , "narrator": "千羽鶴", "text": "得意なことは……\n何かあったかしら。"},
        { "location": "491/TALK"    , "narrator": "千羽鶴", "text": "プロファイル０２、\n國政綾水（あやみ）\n２１歳、大学３年。"},
        { "location": "492/TALK"    , "narrator": "千羽鶴", "text": "４人の中で最年長の\nお姉さん的存在。"},
        { "location": "493/TALK"    , "narrator": "千羽鶴", "text": "結構なカタブツだけど、\n面倒見は良く、頼りに\nなる存在だと思う。"},
        { "location": "494/TALK"    , "narrator": "千羽鶴", "text": "剣道をたしなみ、その\n腕は世界選手権で優勝\nした程。"},
        { "location": "496/TALK"    , "narrator": "千羽鶴", "text": "プロファイル０３、\nガブリエラ\n１４歳、中学３年。"},
        { "location": "497/TALK"    , "narrator": "千羽鶴", "text": "４人中最年少の\nポーランドから来た\n留学生。"},
        { "location": "498/TALK"    , "narrator": "千羽鶴", "text": "いつもツンツンしてる\nけど、本当はメルヘンな\nものが大好き。"},
        { "location": "499/TALK"    , "narrator": "千羽鶴", "text": "銃の腕前は\n世界で通用するレベル。"},
        { "location": "501/TALK"    , "narrator": "千羽鶴", "text": "プロファイル０４、\n恋ヶ崎みやび\n１７歳、高校３年。"},
        { "location": "502/TALK"    , "narrator": "千羽鶴", "text": "いつも突拍子も無い\nことを言って、周囲を\n惑わせる不思議ちゃん。"},
        { "location": "503/TALK"    , "narrator": "千羽鶴", "text": "典型的な、\n『喋らなければ\n綺麗なお姉さん』ね。"},
        { "location": "504/TALK"    , "narrator": "千羽鶴", "text": "面倒くさがりでズボラ\nだけど、PCの腕は\nハッカークラス。"},
        { "location": "506/TALK"    , "narrator": "千羽鶴", "text": "以上、簡単な\n紹介だったけど、\nもっと知りたい？"},
        { "location": "507/SEL"     , "narrator": "", "text": "もちろん！"},
        { "location": "508/SEL"     , "narrator": "", "text": "いえ、もういいです"},
        { "location": "509/ACT"     , "narrator": "", "text": "もちろん！"},
        { "location": "510/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "511/TALK"    , "narrator": "千羽鶴", "text": "それじゃ、好きなだけ\n眺めて楽しんで。"},
        { "location": "512/TALK"    , "narrator": "千羽鶴", "text": "今だけ特別、お触りも\nOKにしてあるから。"},
        { "location": "514/SEL"     , "narrator": "", "text": "逢瀬つばめ"},
        { "location": "515/SEL"     , "narrator": "", "text": "國政綾水"},
        { "location": "516/SEL"     , "narrator": "", "text": "ガブリエラ"},
        { "location": "517/SEL"     , "narrator": "", "text": "恋ヶ崎みやび"},
        { "location": "518/SEL"     , "narrator": "", "text": "千羽鶴"},
        { "location": "519/SEL"     , "narrator": "", "text": "十分堪能した！"},
        { "location": "520/ACT"     , "narrator": "", "text": "逢瀬つばめ"},
        { "location": "522/TALK"    , "narrator": "つばめ", "text": "は、はじめまして！\n逢瀬ちゅ…つ、\nつばめです！"},
        { "location": "523/TALK"    , "narrator": "つばめ", "text": "何の取り柄もないけど\n宜しくお願いします！"},
        { "location": "530/SEL"     , "narrator": "", "text": "チャットでイチャイチャ体験"},
        { "location": "531/SEL"     , "narrator": "", "text": "おさわりする"},
        { "location": "532/SEL"     , "narrator": "", "text": "戻る"},
        { "location": "533/ACT"     , "narrator": "", "text": "チャットでイチャイチャ体験"},
        { "location": "546/ACT"     , "narrator": "", "text": "おさわりする"},
        { "location": "614/TALK"    , "narrator": "つばめ", "text": "えへへ。"},
        { "location": "616/TALK"    , "narrator": "つばめ", "text": "なんだか\nこそばゆいょ。"},
        { "location": "622/TALK"    , "narrator": "つばめ", "text": "うわっ！"},
        { "location": "624/TALK"    , "narrator": "つばめ", "text": "いたたっ！\n許してください！"},
        { "location": "630/TALK"    , "narrator": "つばめ", "text": "きゃあっ！"},
        { "location": "632/TALK"    , "narrator": "つばめ", "text": "もーっ！\nわたしが何も言わない\nからって！"},
        { "location": "638/TALK"    , "narrator": "つばめ", "text": "あははっ！\nなんか\nこそばゆいよう。"},
        { "location": "640/TALK"    , "narrator": "つばめ", "text": "ぷにぷにしてる？\n鍛えないとだめかなぁ。"},
        { "location": "646/TALK"    , "narrator": "つばめ", "text": "はああっ…"},
        { "location": "648/TALK"    , "narrator": "つばめ", "text": "へんなかんじ。"},
        { "location": "657/TALK"    , "narrator": "千羽鶴", "text": "はい、お終い。"},
        { "location": "659/ACT"     , "narrator": "", "text": "戻る"},
        { "location": "662/ACT"     , "narrator": "", "text": "國政綾水"},
        { "location": "664/TALK"    , "narrator": "アーヤ", "text": "はじめまして。\n國政綾水と申します。"},
        { "location": "665/TALK"    , "narrator": "アーヤ", "text": "貴方のサポート、\n楽しみにしてるわ。"},
        { "location": "672/SEL"     , "narrator": "", "text": "チャットでイチャイチャ体験"},
        { "location": "673/SEL"     , "narrator": "", "text": "おさわりする"},
        { "location": "674/SEL"     , "narrator": "", "text": "戻る"},
        { "location": "675/ACT"     , "narrator": "", "text": "チャットでイチャイチャ体験"},
        { "location": "688/ACT"     , "narrator": "", "text": "おさわりする"},
        { "location": "756/TALK"    , "narrator": "アーヤ", "text": "ふふっ。"},
        { "location": "758/TALK"    , "narrator": "アーヤ", "text": "ちょっと\n不思議な気分。"},
        { "location": "764/TALK"    , "narrator": "アーヤ", "text": "きゃっ！？"},
        { "location": "766/TALK"    , "narrator": "アーヤ", "text": "ちょ、ちょっと\n痛いってば！"},
        { "location": "772/TALK"    , "narrator": "アーヤ", "text": "もうっ。\n調子に乗らないの。"},
        { "location": "774/TALK"    , "narrator": "アーヤ", "text": "ダメだって！"},
        { "location": "780/TALK"    , "narrator": "アーヤ", "text": "もうっ！\nくすぐったいってば。"},
        { "location": "782/TALK"    , "narrator": "アーヤ", "text": "もしかして\nおなか出てる？"},
        { "location": "788/TALK"    , "narrator": "アーヤ", "text": "ふわっ！"},
        { "location": "790/TALK"    , "narrator": "アーヤ", "text": "なんか\n不思議な気持ち。"},
        { "location": "799/TALK"    , "narrator": "千羽鶴", "text": "はい、お終い。"},
        { "location": "801/ACT"     , "narrator": "", "text": "戻る"},
        { "location": "804/ACT"     , "narrator": "", "text": "ガブリエラ"},
        { "location": "806/TALK"    , "narrator": "ガブリエラ", "text": "ガブリエラよ。"},
        { "location": "807/TALK"    , "narrator": "ガブリエラ", "text": "ていうか、\nあんた誰？"},
        { "location": "814/SEL"     , "narrator": "", "text": "チャットでイチャイチャ体験"},
        { "location": "815/SEL"     , "narrator": "", "text": "おさわりする"},
        { "location": "816/SEL"     , "narrator": "", "text": "戻る"},
        { "location": "817/ACT"     , "narrator": "", "text": "チャットでイチャイチャ体験"},
        { "location": "830/ACT"     , "narrator": "", "text": "おさわりする"},
        { "location": "898/TALK"    , "narrator": "ガブリエラ", "text": "まあ、こういうのも\n悪くないわね。"},
        { "location": "900/TALK"    , "narrator": "ガブリエラ", "text": "もっとやって\nいいのよ？"},
        { "location": "906/TALK"    , "narrator": "ガブリエラ", "text": "きゃっ！\n突然なあに！？"},
        { "location": "908/TALK"    , "narrator": "ガブリエラ", "text": "いてっ！\nもうっ！\n許さないわよ！"},
        { "location": "914/TALK"    , "narrator": "ガブリエラ", "text": "きゃああっ！\n何て事するのかしら！"},
        { "location": "916/TALK"    , "narrator": "ガブリエラ", "text": "こらあっ！\n恥を知りなさい！"},
        { "location": "922/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、ちょっと\n何の真似！？"},
        { "location": "924/TALK"    , "narrator": "ガブリエラ", "text": "ああっ、もしかして\n肥ってるとか\n言いたいわけ！？"},
        { "location": "930/TALK"    , "narrator": "ガブリエラ", "text": "ちょっ、キモっ！\n変な感じっ！"},
        { "location": "932/TALK"    , "narrator": "ガブリエラ", "text": "べ、べつに気持ちよく\nなんてないんだから…"},
        { "location": "941/TALK"    , "narrator": "千羽鶴", "text": "はい、お終い。"},
        { "location": "943/ACT"     , "narrator": "", "text": "戻る"},
        { "location": "946/ACT"     , "narrator": "", "text": "恋ヶ崎みやび"},
        { "location": "948/TALK"    , "narrator": "みやび", "text": "ふむ。\n興味深い存在やね。"},
        { "location": "949/TALK"    , "narrator": "みやび", "text": "ちゅうか、\nあんた本当に\n人間なが？"},
        { "location": "956/SEL"     , "narrator": "", "text": "チャットでイチャイチャ体験"},
        { "location": "957/SEL"     , "narrator": "", "text": "おさわりする"},
        { "location": "958/SEL"     , "narrator": "", "text": "戻る"},
        { "location": "959/ACT"     , "narrator": "", "text": "チャットでイチャイチャ体験"},
        { "location": "972/ACT"     , "narrator": "", "text": "おさわりする"},
        { "location": "1040/TALK"   , "narrator": "みやび", "text": "なんぞ、\n頭に付いちょったが？"},
        { "location": "1042/TALK"   , "narrator": "みやび", "text": "霊体験のようで\n面白いぞね。"},
        { "location": "1048/TALK"   , "narrator": "みやび", "text": "…っと！\nいきなり何しゆう！"},
        { "location": "1050/TALK"   , "narrator": "みやび", "text": "むっ。\n不当な暴力ぞね。"},
        { "location": "1056/TALK"   , "narrator": "みやび", "text": "あー、まったく。\nまたろくでもないヤツ\nに絡まれたねぇ……"},
        { "location": "1058/TALK"   , "narrator": "みやび", "text": "所詮はあんたも\nオッパイ星人か。"},
        { "location": "1064/TALK"   , "narrator": "みやび", "text": "なかなかえい\nおなかじゃろ。"},
        { "location": "1066/TALK"   , "narrator": "みやび", "text": "これがいわゆる\nハラパンというヤツか。"},
        { "location": "1072/TALK"   , "narrator": "みやび", "text": "ちょっ！\nそこはいかんちや！"},
        { "location": "1074/TALK"   , "narrator": "みやび", "text": "うち、おなかは\nダメやき、堪忍してや。"},
        { "location": "1083/TALK"   , "narrator": "千羽鶴", "text": "はい、お終い。"},
        { "location": "1085/ACT"    , "narrator": "", "text": "戻る"},
        { "location": "1088/ACT"    , "narrator": "", "text": "千羽鶴"},
        { "location": "1090/TALK"   , "narrator": "千羽鶴", "text": "…は？"},
        { "location": "1091/TALK"   , "narrator": "千羽鶴", "text": "何やってるの？\n時間の無駄。\nすなわち人生の無駄。"},
        { "location": "1097/SEL"    , "narrator": "", "text": "おさわりする"},
        { "location": "1098/SEL"    , "narrator": "", "text": "戻る"},
        { "location": "1099/ACT"    , "narrator": "", "text": "おさわりする"},
        { "location": "1101/TALK"   , "narrator": "千羽鶴", "text": "却下。"},
        { "location": "1102/TALK"   , "narrator": "千羽鶴", "text": "私の話、ちゃんと\n聞いてた？"},
        { "location": "1103/TALK"   , "narrator": "千羽鶴", "text": "私は非攻略対象だと\n言っている。"},
        { "location": "1105/ACT"    , "narrator": "", "text": "戻る"},
        { "location": "1109/ACT"    , "narrator": "", "text": "十分堪能した！"},
        { "location": "1112/ACT"    , "narrator": "", "text": "いえ、もういいです"},
        { "location": "1113/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1125/TALK"   , "narrator": "千羽鶴", "text": "お気に入りの子はいた？"},
        { "location": "1126/SEL"    , "narrator": "", "text": "逢瀬つばめ"},
        { "location": "1127/SEL"    , "narrator": "", "text": "國政綾水"},
        { "location": "1128/SEL"    , "narrator": "", "text": "ガブリエラ"},
        { "location": "1129/SEL"    , "narrator": "", "text": "恋ヶ崎みやび"},
        { "location": "1130/SEL"    , "narrator": "", "text": "特にいなかった"},
        { "location": "1131/SEL"    , "narrator": "", "text": "千羽鶴"},
        { "location": "1132/ACT"    , "narrator": "", "text": "逢瀬つばめ"},
        { "location": "1144/TALK"   , "narrator": "千羽鶴", "text": "なるほど。\n確かに彼女にするには\nかわいいと思う。"},
        { "location": "1145/TALK"   , "narrator": "千羽鶴", "text": "ただし彼女は\n楽勝に見えて\n４人の中で最強。"},
        { "location": "1146/TALK"   , "narrator": "千羽鶴", "text": "がんばって。"},
        { "location": "1147/ACT"    , "narrator": "", "text": "國政綾水"},
        { "location": "1159/TALK"   , "narrator": "千羽鶴", "text": "なるほど。\n彼女はきっと\nいい奥さんになる。"},
        { "location": "1160/TALK"   , "narrator": "千羽鶴", "text": "それに、目一杯\n甘やかしてもらえるかも\nしれないものね。"},
        { "location": "1161/ACT"    , "narrator": "", "text": "ガブリエラ"},
        { "location": "1173/TALK"   , "narrator": "千羽鶴", "text": "なるほど。\nまあ、何もいわないで\nおいてあげる。"},
        { "location": "1174/TALK"   , "narrator": "千羽鶴", "text": "彼女は日常と\nプライベートの\nギャップがすごい。"},
        { "location": "1175/TALK"   , "narrator": "千羽鶴", "text": "いろいろと\n驚くこともあるかも。"},
        { "location": "1176/ACT"    , "narrator": "", "text": "恋ヶ崎みやび"},
        { "location": "1188/TALK"   , "narrator": "千羽鶴", "text": "なるほど。\n物好きね。"},
        { "location": "1189/TALK"   , "narrator": "千羽鶴", "text": "まあでも、人の好みは\n十人十色。"},
        { "location": "1190/TALK"   , "narrator": "千羽鶴", "text": "貴方に、鉄の仮面を\n脱がせるスキルが\nあることを祈ってる。"},
        { "location": "1191/ACT"    , "narrator": "", "text": "特にいなかった"},
        { "location": "1203/TALK"   , "narrator": "千羽鶴", "text": "そう。\nそれは残念。"},
        { "location": "1204/TALK"   , "narrator": "千羽鶴", "text": "でも、彼女たちの\n生活を見ていたら\n気が変わるかも。"},
        { "location": "1205/TALK"   , "narrator": "千羽鶴", "text": "最初のうちは、彼女\nたちの生活ドラマと\nして楽しめばいい。"},
        { "location": "1206/ACT"    , "narrator": "", "text": "千羽鶴"},
        { "location": "1219/TALK"   , "narrator": "千羽鶴", "text": "ああ……。\nやっちゃったのね。"},
        { "location": "1220/TALK"   , "narrator": "千羽鶴", "text": "再三言うけど、\n私は非攻略対象。"},
        { "location": "1221/TALK"   , "narrator": "千羽鶴", "text": "でも、あなたが今これを\n選んだことで、ヘンな\n所にフラグが立った。"},
        { "location": "1222/TALK"   , "narrator": "千羽鶴", "text": "OSのシステムに\nハマリやバグが\n出なければいいけど。"},
        { "location": "1224/TALK"   , "narrator": "千羽鶴", "text": "とにかく、あなたの\n好みは把握した。"},
        { "location": "1225/TALK"   , "narrator": "千羽鶴", "text": "早く彼女たちと\n今くらいの関係に\nなれるといいわね。"},
        { "location": "1226/SEL"    , "narrator": "", "text": "え？　それじゃ今のは…？"},
        { "location": "1227/SEL"    , "narrator": "", "text": "早く会いたい"},
        { "location": "1228/ACT"    , "narrator": "", "text": "え？　それじゃ今のは…？"},
        { "location": "1229/TALK"   , "narrator": "千羽鶴", "text": "今のは将来における\n１つの可能性からの\n前借り。"},
        { "location": "1230/TALK"   , "narrator": "千羽鶴", "text": "難しい話になるから\n深くは説明しないけど、\nとにかくそういうこと。"},
        { "location": "1231/ACT"    , "narrator": "", "text": "早く会いたい"},
        { "location": "527/DIALOG"  , "narrator": "Profile/Dialog_profile01", "text": "<b><color=#ff0044><size=40>逢瀬つばめ</size></color></b>\n<color=#ff0044><size=20>おうせつばめ</size></color>\n\n１５歳(高校１年)\n誕生日:2000.6.7\n\n静岡県出身。\n近年まで重い病気でずっと入院していたため世間知らず。\n元気で前向きで天然なムードメーカー。\n\n<b><color=orange>【好きなもの】</color></b>\nフレイメノウ、可愛い服、いちご、チーズクリーム鯛焼き\n\n<b><color=blue>【苦手なもの】</color></b>\n病院、薬、痛いこと\n"},
        { "location": "551/DIALOG"  , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "654/DIALOG"  , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "669/DIALOG"  , "narrator": "Profile/Dialog_profile02", "text": "<b><color=#2670DA><size=40>國政綾水</size>(アーヤ)</color></b>\n<color=#2670DA><size=20>くにまさあやみ</size></color>\n\n２１歳(大学３年)\n誕生日:1994.9.14\n\n長野県出身。\n実家がド田舎の山中にある神社ということもあり、都会に憧れを持つ。責任感が強く、意志が固いリーダー肌の少女。\n\n<b><color=orange>【好きなもの】</color></b>\n武士の心得、精神統一\n哲学、子供、都会\n\n<b><color=blue>【苦手なもの】</color></b>\nだらしない人\n"},
        { "location": "693/DIALOG"  , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "796/DIALOG"  , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "811/DIALOG"  , "narrator": "Profile/Dialog_profile03", "text": "<b><color=#00E676><size=40>ガブリエラ</size></color></b>\n<color=#00E676><size=20>がぶりえら</size></color>\n\n１４歳(中学３年)\n誕生日:2001.10.13\n\nポーランド共和国\nワルシャワ出身。\n交換留学生として日本に来ている。祖国は今第二次冷戦によって戦火の中。アーヤの剣道試合を見て日本に憧れを持った。\n\n<b><color=orange>【好きなもの】</color></b>\n\nたこ焼き、日本文化、銃、プラツキジェムニャチャーネ\n\n<b><color=blue>【苦手なもの】</color></b>\n後ろに立たれること"},
        { "location": "835/DIALOG"  , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "938/DIALOG"  , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "953/DIALOG"  , "narrator": "Profile/Dialog_profile04", "text": "<b><color=#C007FF><size=40>恋ヶ崎みやび</size></color></b>\n<color=#C007FF><size=20>こいがさきみやび</size></color>\n\n１７歳(高校３年)\n誕生日:1998.7.27\n\n高知県出身。\n高知の酒蔵の家の娘。PCスキルは世界レベルだが、言動が常に不思議ちゃん。要領よく生きることに命をかけており、大の面倒くさがりである。\n\n<b><color=orange>【好きなもの】</color></b>\n\n洋菓子、ＰＣ魔改造、温泉、一人で久里浜線に乗る\n\n<b><color=blue>【苦手なもの】</color></b>\n片付け\n"},
