{
    "dir": "chap05/battle/btev_ch01_05_02.js",
    "type": "",
    "info": {
        "story_id": "21006",
        "cid": "",
        "title": "006 ココロスフィアストーリー【Lv02】",
        "sub_title": "綺麗すぎる湖Ⅰ＜帰結＞"
    },
    "entry":
    [
        { "location": "149/SCENARIO", "narrator": "", "text": "綺麗すぎる湖２"},
        { "location": "158/TALK"    , "narrator": "潜在つばめ", "text": "凄い想いの力。"},
        { "location": "159/TALK"    , "narrator": "表層つばめ", "text": "そりゃそうだよ。\nわたし、本当は\n友達作りたいんだもん。"},
        { "location": "160/TALK"    , "narrator": "表層つばめ", "text": "ヒントになることなら\n知りたいの。"},
        { "location": "161/TALK"    , "narrator": "潜在つばめ", "text": "……。\nヒントだけで済むとは\n限らないよ。"},
        { "location": "162/TALK"    , "narrator": "表層つばめ", "text": "え？"},
        { "location": "163/TALK"    , "narrator": "潜在つばめ", "text": "まあいいよ。\n約束は約束だもんね。"},
        { "location": "164/TALK"    , "narrator": "潜在つばめ", "text": "それじゃ、見たい封印\n記憶を１つ、見せて\nあげる。"},
        { "location": "165/TALK"    , "narrator": "潜在つばめ", "text": "頭の中で、何を知り\nたいか強く想い\n描いてみて。"},
        { "location": "166/TALK"    , "narrator": "表層つばめ", "text": "う、うん。"},
        { "location": "191/DIALOG"  , "narrator": "", "text": "東京に来るちょっと前。\n\nこれは、わたしが高校に入学して、\n１０日目くらいにあった出来事。"},
        { "location": "192/TALK"    , "narrator": "女子高校生Ａ", "text": "へえ、そうなんだ！"},
        { "location": "193/TALK"    , "narrator": "女子高校生Ｂ", "text": "チョーウケルでしょ。\nつばめちゃんは？"},
        { "location": "194/TALK"    , "narrator": "つばめ", "text": "え？\nわ、わたし？"},
        { "location": "195/DIALOG"  , "narrator": "", "text": "席が近かったって理由だけど、\nようやくわたしにも、\nお話しできる友達ができた。\n\nその子たちとは、\n家の方向が近かったから、\n一緒に下校をしようって\nことになって――"},
        { "location": "196/TALK"    , "narrator": "つばめ", "text": "わたしは\nそういうのは特に――"},
        { "location": "197/TALK"    , "narrator": "女子高校生Ａ", "text": "あっ……"},
        { "location": "200/TALK"    , "narrator": "女子高校生Ａ", "text": "あああああっ！！"},
        { "location": "203/TALK"    , "narrator": "女子高校生Ｂ", "text": "なに！？\nどうしたの？"},
        { "location": "204/TALK"    , "narrator": "女子高校生Ａ", "text": "そこのため池に\nスマホ落とした……"},
        { "location": "205/TALK"    , "narrator": "つばめ", "text": "ええええっ！！"},
        { "location": "206/TALK"    , "narrator": "女子高校生Ｂ", "text": "ちょっ…\nそれ最悪じゃん？"},
        { "location": "229/TALK"    , "narrator": "女子高校生Ｂ", "text": "ああ、ダメだねこりゃ"},
        { "location": "230/TALK"    , "narrator": "女子高校生Ｂ", "text": "このため池、\nちょっと深いし、\nめっちゃ汚いし。"},
        { "location": "231/TALK"    , "narrator": "女子高校生Ａ", "text": "あーもう、\nマジブルー、、"},
        { "location": "232/TALK"    , "narrator": "女子高校生Ａ", "text": "……。"},
        { "location": "233/TALK"    , "narrator": "女子高校生Ｂ", "text": "………。"},
        { "location": "234/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "235/TALK"    , "narrator": "女子高校生Ａ", "text": "なんか生きる気力\nなくした……"},
        { "location": "239/TALK"    , "narrator": "つばめ", "text": "ええっ！"},
        { "location": "240/TALK"    , "narrator": "女子高校生Ａ", "text": "だれか１万円あげる\nから探してー……"},
        { "location": "247/TALK"    , "narrator": "女子高校生Ｂ", "text": "１万円？　無理無理！\n１０万だったら\nやるわ。"},
        { "location": "250/TALK"    , "narrator": "つばめ", "text": "……。"},
        { "location": "265/TALK"    , "narrator": "潜在つばめ", "text": "おしまい。"},
        { "location": "266/TALK"    , "narrator": "潜在つばめ", "text": "この時のこと、\n覚えてる？"},
        { "location": "267/TALK"    , "narrator": "表層つばめ", "text": "覚えてるよ。"},
        { "location": "268/TALK"    , "narrator": "表層つばめ", "text": "この次の日から、\nわたしとお話して\nくれなくなったんだ。"},
        { "location": "269/TALK"    , "narrator": "表層つばめ", "text": "でも、これだけじゃ\nやっぱり何も\nわからないよ。"},
        { "location": "272/TALK"    , "narrator": "表層つばめ", "text": "なんでわたし、\n嫌われちゃったの？"},
        { "location": "273/TALK"    , "narrator": "潜在つばめ", "text": "……。　　　　"},
        { "location": "274/TALK"    , "narrator": "潜在つばめ", "text": "それを知りたいなら、\nもっと心の奥に\nアプローチが必要だね。"},
        { "location": "275/TALK"    , "narrator": "潜在つばめ", "text": "もし本当に知りたい\nなら、更に深く心の\n奥へ潜る必要がある。"},
        { "location": "277/TALK"    , "narrator": "表層つばめ", "text": "心の……奥……"},
        { "location": "278/TALK"    , "narrator": "潜在つばめ", "text": "けど、最初に\n忠告しておくよ。"},
        { "location": "279/TALK"    , "narrator": "潜在つばめ", "text": "それは必ずしも\nあなたの心の助けには\nならないかも。"},
        { "location": "280/TALK"    , "narrator": "潜在つばめ", "text": "むしろ、余計に\nショックを受けて\n引っ込んじゃうかも。"},
        { "location": "281/TALK"    , "narrator": "表層つばめ", "text": "…っ。"},
        { "location": "282/TALK"    , "narrator": "潜在つばめ", "text": "その覚悟があるなら、\n深層意識に来て。"},
        { "location": "283/TALK"    , "narrator": "潜在つばめ", "text": "その時はまた、\n私と戦う事になるけど、\nその決意があるなら。"},
        { "location": "295/TALK"    , "narrator": "表層つばめ", "text": "……。"},
        { "location": "296/SEL"     , "narrator": "（選択肢）", "text": "行くよね？"},
        { "location": "297/ACT"     , "narrator": "", "text": "行くよね？"},
        { "location": "299/TALK"    , "narrator": "表層つばめ", "text": "……うん。\nもちろんだよ。"},
        { "location": "300/TALK"    , "narrator": "表層つばめ", "text": "自分のこと、\nもっとちゃんと\n知りたいもん。"}
    ]
}
