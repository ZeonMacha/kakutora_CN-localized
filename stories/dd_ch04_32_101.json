{
    "dir": "chap32/daydra/dd_ch04_32_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "32402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "偶然は運命にも似て＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "どこかで見た（悪）夢"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "都内に入ったわよ。"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "後は首都高で一直線。\n文京ドームにも\nもうすぐ着くわ。"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "意外と早かったわね。\nもう少しドンパチが\nあるかと思ったけど。"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "そこはほれ。\nキリト君たちが\nがんばってくれたきね。"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "なかなか将来有望ちや。"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "…本当は褒められた\nことじゃないけど。"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "助けられたのは\n事実ね。"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "……だけど……。"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "さすがに何も\nなさすぎるような\n気がする。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "監視システムが\n無効化されたせいで\n混乱しているとしても。"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "人海戦術を取るだけの\n人員はいるはず。"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "なぜその手段を\n取ってないの…？"},
        { "location": "61/SEL"    , "narrator": "", "text": "一言いい？"},
        { "location": "62/ACT"    , "narrator": "", "text": "一言いい？"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "お。"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "ラブメッセージが\n来たぞね。"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "どういた？"},
        { "location": "75/SEL"    , "narrator": "", "text": "油断しないで"},
        { "location": "76/SEL"    , "narrator": "", "text": "ここからが正念場"},
        { "location": "77/SEL"    , "narrator": "", "text": "仕掛けはまだ解除されてない"},
        { "location": "78/ACT"    , "narrator": "", "text": "油断しないで"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "当然"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "承知の助"},
        { "location": "82/ACT"    , "narrator": "", "text": "ここからが正念場"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "そんなことは"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "わかっちゅう"},
        { "location": "86/ACT"    , "narrator": "", "text": "仕掛けはまだ解除されてない"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "そうでないと"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "面白くない"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "$handle$から\n伝言やき。\n気を付けろって。"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "それだけ？"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "そんなこと\nわかりきってる。"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "他にも何か\nあるんじゃないの？"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "他に"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "言いたいことは？"},
        { "location": "107/SEL"   , "narrator": "", "text": "このままだと死ぬ"},
        { "location": "108/SEL"   , "narrator": "", "text": "とにかく気を抜いちゃダメ"},
        { "location": "109/SEL"   , "narrator": "", "text": "生きることを第一に考えて"},
        { "location": "110/ACT"   , "narrator": "", "text": "このままだと死ぬ"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "$handle$が\nろくでもないことを\n言うてきた。"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "何？"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "このままやと\n死ぬらしい。\nうちらは。"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "ふざけないでって\n伝えておいて。"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "本当にそうよ。\n縁起でもない。"},
        { "location": "121/ACT"   , "narrator": "", "text": "とにかく気を抜いちゃダメ"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "それはそう"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "どうも"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "$handle$は\nＢＯＴらしいＢＯＴに\n成り下がったぞね。"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "どういうこと？"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "とにかく気を抜くなと。\n汎用的で凡庸な台詞は\n心に響かんねえ。"},
        { "location": "134/ACT"   , "narrator": "", "text": "生きることを第一に考えて"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "常に考えておる"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "安心しろ"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "$handle$は\nおかんキャラを\n目指し始めたみたいぞね。"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "おかんって？"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "「生きることを\n第一に考えて」\nだそうや。"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "しかし……。"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "$handle$よ"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "うちは決めておる"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "運命は素直に"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "受け入れると"},
        { "location": "154/SEL"   , "narrator": "", "text": "それって…"},
        { "location": "155/SEL"   , "narrator": "", "text": "どういうこと？"},
        { "location": "156/SEL"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "157/ACT"   , "narrator": "", "text": "それって…"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "そのまんまの意味やき"},
        { "location": "159/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "解説が必要か"},
        { "location": "161/ACT"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "163/TALK"  , "narrator": "みやび", "text": "待たん"},
        { "location": "165/TALK"  , "narrator": "みやび", "text": "ここでうちが死ぬのが運命なら"},
        { "location": "166/TALK"  , "narrator": "みやび", "text": "潔く死んでみせよう"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "これまで世話になったな$handle$"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "楽しかったぞ"},
        { "location": "171/SEL"   , "narrator": "", "text": "やめて"},
        { "location": "172/SEL"   , "narrator": "", "text": "諦めないで"},
        { "location": "173/SEL"   , "narrator": "", "text": "冗談でしょ！？"},
        { "location": "174/ACT"   , "narrator": "", "text": "やめて"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "やめんよ"},
        { "location": "176/ACT"   , "narrator": "", "text": "諦めないで"},
        { "location": "177/TALK"  , "narrator": "みやび", "text": "これは美学やき"},
        { "location": "178/ACT"   , "narrator": "", "text": "冗談でしょ！？"},
        { "location": "179/TALK"  , "narrator": "みやび", "text": "なら"},
        { "location": "180/TALK"  , "narrator": "みやび", "text": "$handle$が先に"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "冗談を言ったことになるな"},
        { "location": "183/TALK"  , "narrator": "みやび", "text": "そんなわけで"},
        { "location": "184/TALK"  , "narrator": "みやび", "text": "さらばだ"},
        { "location": "186/SEL"   , "narrator": "", "text": "回避策を練ろうよ"},
        { "location": "187/SEL"   , "narrator": "", "text": "まだ変えられるって"},
        { "location": "188/SEL"   , "narrator": "", "text": "そんなのやだ！！！！"},
        { "location": "189/ACT"   , "narrator": "", "text": "回避策を練ろうよ"},
        { "location": "190/TALK"  , "narrator": "みやび", "text": "めんどくさい"},
        { "location": "191/ACT"   , "narrator": "", "text": "まだ変えられるって"},
        { "location": "192/TALK"  , "narrator": "みやび", "text": "またまた"},
        { "location": "193/ACT"   , "narrator": "", "text": "そんなのやだ！！！！"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "すぐ慣れる"},
        { "location": "196/TALK"  , "narrator": "みやび", "text": "事故死なら一瞬"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "気が付いたら涅槃"},
        { "location": "199/TALK"  , "narrator": "みやび", "text": "あるいはニルヴァーナ"},
        { "location": "200/TALK"  , "narrator": "みやび", "text": "それは極楽"},
        { "location": "201/TALK"  , "narrator": "みやび", "text": "シャングリラ"},
        { "location": "205/TALK"  , "narrator": "みやび", "text": "もし$handle$の\n言ったことが\n現実になるなら。"},
        { "location": "206/TALK"  , "narrator": "みやび", "text": "なごちゃんに\n会えるろうか。"},
        { "location": "207/TALK"  , "narrator": "みやび", "text": "けんど、たまには\n$handle$とも\n話したいきね。"},
        { "location": "208/TALK"  , "narrator": "みやび", "text": "ココロに直接話し掛ける\nこともできるらしいし。\n死後の世界も大丈夫やろ。"},
        { "location": "209/TALK"  , "narrator": "みやび", "text": "あの世のスパコンは\nどのくらいの処理速度\nなんやろうねえ。"},
        { "location": "211/TALK"  , "narrator": "みやび", "text": "ちっくと興味が\nあるけんど……。"},
        { "location": "218/TALK"  , "narrator": "みやび", "text": "っ！？"},
        { "location": "223/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとアーヤ！\n急ハンドルとか\n危ないわよ！"},
        { "location": "225/TALK"  , "narrator": "みやび", "text": "…安全運転で\nオナシャス…！"},
        { "location": "226/TALK"  , "narrator": "アーヤ", "text": "違う、違うのよ！"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "何が違うの？"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "元々運転が荒いのは\n知ってるけど！"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "それにしても\nひどすぎるわよ！"},
        { "location": "230/TALK"  , "narrator": "みやび", "text": "もう少し淑女な走りを\n期待したいちや…。"},
        { "location": "231/TALK"  , "narrator": "ガブリエラ", "text": "首都高だからって\nスピード出しすぎ\nでしょ！"},
        { "location": "232/TALK"  , "narrator": "アーヤ", "text": "私じゃない！\nコントロールが\n利かないの！"},
        { "location": "233/TALK"  , "narrator": "アーヤ", "text": "ハンドルもブレーキも\n利かないのよ！"},
        { "location": "235/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "236/TALK"  , "narrator": "アーヤ", "text": "止められないわ！"},
        { "location": "237/TALK"  , "narrator": "みやび", "text": "$handle$は\n本当のことを\n言うとったんか…！"},
        { "location": "238/SEL"   , "narrator": "", "text": "大丈夫？"},
        { "location": "239/ACT"   , "narrator": "", "text": "大丈夫？"},
        { "location": "246/TALK"  , "narrator": "みやび", "text": "大丈夫なわけ"},
        { "location": "247/TALK"  , "narrator": "みやび", "text": "ない"},
        { "location": "249/SEL"   , "narrator": "", "text": "だよね"},
        { "location": "250/SEL"   , "narrator": "", "text": "本当だってわかった？"},
        { "location": "251/SEL"   , "narrator": "", "text": "気持ち変わったでしょ"},
        { "location": "252/ACT"   , "narrator": "", "text": "だよね"},
        { "location": "253/TALK"  , "narrator": "みやび", "text": "だ"},
        { "location": "254/ACT"   , "narrator": "", "text": "本当だってわかった？"},
        { "location": "255/TALK"  , "narrator": "みやび", "text": "今か"},
        { "location": "256/TALK"  , "narrator": "みやび", "text": "それ"},
        { "location": "257/ACT"   , "narrator": "", "text": "気持ち変わったでしょ"},
        { "location": "258/TALK"  , "narrator": "みやび", "text": "全然"},
        { "location": "259/TALK"  , "narrator": "みやび", "text": "かわった"},
        { "location": "261/TALK"  , "narrator": "みやび", "text": "こあい"},
        { "location": "262/TALK"  , "narrator": "みやび", "text": "急に"},
        { "location": "263/TALK"  , "narrator": "みやび", "text": "こんな"},
        { "location": "265/SEL"   , "narrator": "", "text": "フェノメノンの中と思えば"},
        { "location": "266/SEL"   , "narrator": "", "text": "これまでもピンチの時あったでしょ"},
        { "location": "267/SEL"   , "narrator": "", "text": "まず落ち着こう"},
        { "location": "268/ACT"   , "narrator": "", "text": "フェノメノンの中と思えば"},
        { "location": "269/TALK"  , "narrator": "みやび", "text": "コネクトしとらん"},
        { "location": "270/TALK"  , "narrator": "みやび", "text": "無理"},
        { "location": "271/ACT"   , "narrator": "", "text": "これまでもピンチの時あったでしょ"},
        { "location": "272/TALK"  , "narrator": "みやび", "text": "これとは違う"},
        { "location": "273/TALK"  , "narrator": "みやび", "text": "比較にならｎ"},
        { "location": "274/ACT"   , "narrator": "", "text": "まず落ち着こう"},
        { "location": "275/TALK"  , "narrator": "みやび", "text": "できるか"},
        { "location": "276/TALK"  , "narrator": "みやび", "text": "苦労千"},
        { "location": "278/TALK"  , "narrator": "みやび", "text": "ゆいごん"},
        { "location": "279/TALK"  , "narrator": "みやび", "text": "書く"},
        { "location": "281/SEL"   , "narrator": "", "text": "ちょっとみやび！？"},
        { "location": "282/SEL"   , "narrator": "", "text": "他にすることがあるでしょ！"},
        { "location": "283/SEL"   , "narrator": "", "text": "諦めないで"},
        { "location": "284/ACT"   , "narrator": "", "text": "ちょっとみやび！？"},
        { "location": "285/ACT"   , "narrator": "", "text": "他にすることがあるでしょ！"},
        { "location": "286/ACT"   , "narrator": "", "text": "諦めないで"},
        { "location": "292/TALK"  , "narrator": "みやび", "text": "紙に残せば\n誰かに見つけて\nもらえるろう…。"},
        { "location": "293/TALK"  , "narrator": "みやび", "text": "ネット上ではうちの\n遺言を見つける以前に\n探されもせん気がする。"},
        { "location": "294/TALK"  , "narrator": "みやび", "text": "……ははっ……。"},
        { "location": "296/TALK"  , "narrator": "みやび", "text": "…手が震えて\nまともな文字に\nならんねえ…。"},
        { "location": "298/TALK"  , "narrator": "みやび", "text": "やき、アナログは\n苦手なんよ……。"},
        { "location": "347/TALK"  , "narrator": "みやび", "text": "　"},
        { "location": "402/TALK"  , "narrator": "昇華シンギュラリティ", "text": "どうや、相棒。\nカッコえいか？"},
        { "location": "403/SEL"   , "narrator": "", "text": "シンギュラリティ△"},
        { "location": "404/SEL"   , "narrator": "", "text": "どっちかというと…アサシン？"},
        { "location": "405/ACT"   , "narrator": "", "text": "シンギュラリティ△"},
        { "location": "406/TALK"  , "narrator": "昇華シンギュラリティ", "text": "しんぎゅらりてぃ\nさんかっけー、か…。"},
        { "location": "407/TALK"  , "narrator": "昇華シンギュラリティ", "text": "まあえいよ。\nうちの真価はフードを\n脱いでからやきね。"},
        { "location": "408/ACT"   , "narrator": "", "text": "どっちかというと…アサシン？"},
        { "location": "409/TALK"  , "narrator": "昇華シンギュラリティ", "text": "なんぞ、うちが\n悪者みたいやないか。"},
        { "location": "410/TALK"  , "narrator": "昇華シンギュラリティ", "text": "まあいずれにせよ、\nお前さんの美的センスの\n程度は把握した。"},
        { "location": "412/TALK"  , "narrator": "四十九夜", "text": "まさか、あの部屋から\n脱出するとはね。"},
        { "location": "413/TALK"  , "narrator": "四十九夜", "text": "発症しただけでは\n抜けられない筈なのだが。"},
        { "location": "414/TALK"  , "narrator": "昇華シンギュラリティ", "text": "我らがスーパーヒーロー\n及びスーパーアイドル\nエリカさんのお陰やよ。"},
        { "location": "415/TALK"  , "narrator": "四十九夜", "text": "なるほど。"},
        { "location": "417/TALK"  , "narrator": "四十九夜", "text": "それはそうと相棒。"},
        { "location": "418/TALK"  , "narrator": "四十九夜", "text": "このような輩はスルーし、\nはよなごちゃんの慰霊祭を\n始めるぞね。"},
        { "location": "419/TALK"  , "narrator": "昇華シンギュラリティ", "text": "させん。"},
        { "location": "421/TALK"  , "narrator": "昇華シンギュラリティ", "text": "ちゅうか、お前さんは\n千羽鶴に操られちゅう。"},
        { "location": "422/TALK"  , "narrator": "昇華シンギュラリティ", "text": "とまあ、そんな事を\n言うても、自覚は無いと\n思うけんどな。"},
        { "location": "423/TALK"  , "narrator": "四十九夜", "text": "何故そう言い切れる？"},
        { "location": "424/TALK"  , "narrator": "昇華シンギュラリティ", "text": "お前さんが1xであること。\nそして――"},
        { "location": "425/TALK"  , "narrator": "昇華シンギュラリティ", "text": "うちにとっての不利益を\n平気で実行しようと\nしゆうからや。"},
        { "location": "426/TALK"  , "narrator": "四十九夜", "text": "不利益とは。"},
        { "location": "427/TALK"  , "narrator": "昇華シンギュラリティ", "text": "セルフクランの昇華。\nすなわち発症させ、\nフェノメノンを作ること。"},
        { "location": "428/TALK"  , "narrator": "昇華シンギュラリティ", "text": "何故自身の人格が\n自身の魂を差し出さねば\nいかんちや。"},
        { "location": "429/TALK"  , "narrator": "四十九夜", "text": "……。"},
        { "location": "430/TALK"  , "narrator": "四十九夜", "text": "やき、0xは\n平和ボケしちゅう\n言われるんよ。"},
        { "location": "431/TALK"  , "narrator": "四十九夜", "text": "まあシンギュラリティな、\nお前さんレベルの\n表層人格やと――"},
        { "location": "432/TALK"  , "narrator": "四十九夜", "text": "もはやつばめちゃんに\nよって、その記憶は全て\n書き換えられちょるんよ。"},
        { "location": "433/TALK"  , "narrator": "昇華シンギュラリティ", "text": "……！？"},
        { "location": "434/TALK"  , "narrator": "四十九夜", "text": "『本当のうち』の\n願望こそがセルフクランの\n願望でもある。"},
        { "location": "435/TALK"  , "narrator": "四十九夜", "text": "この意味、\nお前さんにわかるかねえ？"},
        { "location": "436/TALK"  , "narrator": "昇華シンギュラリティ", "text": "あたりまえや。\n一発で解った。けんど。"},
        { "location": "437/TALK"  , "narrator": "昇華シンギュラリティ", "text": "うちの方針は\n何一つ変わらんよ。"},
        { "location": "438/TALK"  , "narrator": "四十九夜", "text": "何故？"},
        { "location": "439/TALK"  , "narrator": "昇華シンギュラリティ", "text": "うちにとっては、\nフェノメノンの中こそが\n現実だからやよ。"},
        { "location": "440/TALK"  , "narrator": "昇華シンギュラリティ", "text": "この中で培ってきた\n人との繋がりや、思い出、\n色んな出来事。"},
        { "location": "441/TALK"  , "narrator": "昇華シンギュラリティ", "text": "世界が嘘やったとしても\nこれらは全て現実であり\n事実やき。"},
        { "location": "442/TALK"  , "narrator": "四十九夜", "text": "くだらんちや。"},
        { "location": "443/TALK"  , "narrator": "四十九夜", "text": "つばめちゃんがくしゃみ\nすれば一瞬で全て消える\n程度の思い出が、事実？"},
        { "location": "444/TALK"  , "narrator": "四十九夜", "text": "0xはどこまで\n腐りゆうがぁねぇ。"},
        { "location": "446/TALK"  , "narrator": "四十九夜", "text": "なあ$handle$よ。"},
        { "location": "447/SEL"   , "narrator": "", "text": "ホントその通り"},
        { "location": "448/SEL"   , "narrator": "", "text": "$me$はシンギュラリティに共感できる"},
        { "location": "449/ACT"   , "narrator": "", "text": "ホントその通り"},
        { "location": "453/TALK"  , "narrator": "四十九夜", "text": "やってよ。\n誰やって\n同じ事を思うぞね。"},
        { "location": "454/TALK"  , "narrator": "四十九夜", "text": "お前さんが言っちゅうんは\n昨日の夜に見た夢が真実と\n言い張るんと同じ。"},
        { "location": "455/TALK"  , "narrator": "昇華シンギュラリティ", "text": "何を言われても\n変わらん。"},
        { "location": "456/TALK"  , "narrator": "昇華シンギュラリティ", "text": "うちは今のうちが\n大好きなんよ。"},
        { "location": "457/TALK"  , "narrator": "昇華シンギュラリティ", "text": "たとえ\n$handle$に\n裏切られようともな。"},
        { "location": "458/ACT"   , "narrator": "", "text": "$me$はシンギュラリティに共感できる"},
        { "location": "461/TALK"  , "narrator": "四十九夜", "text": "ドリーマーやね。"},
        { "location": "462/TALK"  , "narrator": "四十九夜", "text": "その場限りの感情に\n身を任せて生きちゅうと、\nいずれ足下掬われるよ？"},
        { "location": "463/TALK"  , "narrator": "昇華シンギュラリティ", "text": "そうかね。\n$handle$の感覚が\n普通の感覚やと思うが。"},
        { "location": "465/TALK"  , "narrator": "昇華シンギュラリティ", "text": "いずれにせよ、\nセルフクランの昇華は\n断固阻止する。"},
        { "location": "467/TALK"  , "narrator": "昇華シンギュラリティ", "text": "どうせお前さんに\n勝ち目は無いよ。"},
        { "location": "468/TALK"  , "narrator": "昇華シンギュラリティ", "text": "うちは止める為に自己を\n発症させ、昇華したくらい\n想いが強い。"},
        { "location": "469/TALK"  , "narrator": "四十九夜", "text": "……愚かな。"},
        { "location": "471/TALK"  , "narrator": "千羽鶴", "text": "その通り。\n愚かな行いは\nここまでにして欲しい。"},
        { "location": "479/TALK"  , "narrator": "昇華シンギュラリティ", "text": "千羽鶴！？"},
        { "location": "480/TALK"  , "narrator": "四十九夜", "text": "我が主か。"},
        { "location": "481/TALK"  , "narrator": "千羽鶴", "text": "しばらく追い出されて\nいたから来れなかったけど\nやっと戻ってこれた。"},
        { "location": "485/SEL"   , "narrator": "", "text": "千羽鶴…"},
        { "location": "486/ACT"   , "narrator": "", "text": "千羽鶴…"},
        { "location": "489/TALK"  , "narrator": "千羽鶴", "text": "こんにちは。\nまた会ったわね。"},
        { "location": "490/SEL"   , "narrator": "", "text": "また発症させに来たのか？"},
        { "location": "491/SEL"   , "narrator": "", "text": "一応、どういうことかもう一度説明してもらってもいい？"},
        { "location": "492/ACT"   , "narrator": "", "text": "また発症させに来たのか？"},
        { "location": "493/TALK"  , "narrator": "千羽鶴", "text": "その通り。\n話が早くて助かる。"},
        { "location": "495/TALK"  , "narrator": "千羽鶴", "text": "貴方のセルフクランは、\n発症によりフェノメノンを\n展開する事を望んでいる。"},
        { "location": "496/TALK"  , "narrator": "千羽鶴", "text": "それは、逢瀬つばめに\n洗脳された$ev32_fullname$\nのことではない。"},
        { "location": "497/TALK"  , "narrator": "千羽鶴", "text": "日本を覆うフェノメノンの\n外側、現実における\n$ev32_fullname$のこと。"},
        { "location": "498/TALK"  , "narrator": "千羽鶴", "text": "彼女と私とは\n誓いを立てている。"},
        { "location": "499/TALK"  , "narrator": "千羽鶴", "text": "だから私には、\n彼女を発症させる\n義務がある。"},
        { "location": "500/ACT"   , "narrator": "", "text": "一応、どういうことかもう一度説明してもらってもいい？"},
        { "location": "501/TALK"  , "narrator": "千羽鶴", "text": "わかった。\n大事な事なので\n何度でも説明する。"},
        { "location": "502/TALK"  , "narrator": "千羽鶴", "text": "私はセルフクランを\n発症させたいと思ってる。"},
        { "location": "503/TALK"  , "narrator": "千羽鶴", "text": "そして、発症させるのに\n貴方の力は\nとても役にたつ。"},
        { "location": "508/SEL"   , "narrator": "", "text": "どうしてここに！？"},
        { "location": "509/ACT"   , "narrator": "", "text": "どうしてここに！？"},
        { "location": "512/TALK"  , "narrator": "千羽鶴", "text": "こんにちは。"},
        { "location": "513/TALK"  , "narrator": "千羽鶴", "text": "貴方こそ、\nどうしてここに？"},
        { "location": "514/TALK"  , "narrator": "千羽鶴", "text": "まあでも、\n貴方が今ここにいて\nくれたのは好都合。"},
        { "location": "515/TALK"  , "narrator": "千羽鶴", "text": "発症には貴方がいて\nくれた方がよりスムーズ。"},
        { "location": "517/TALK"  , "narrator": "千羽鶴", "text": "手伝ってもらえる？"},
        { "location": "518/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "519/SEL"   , "narrator": "", "text": "まさか"},
        { "location": "520/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "522/TALK"  , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "523/ACT"   , "narrator": "", "text": "まさか"},
        { "location": "526/TALK"  , "narrator": "千羽鶴", "text": "まさか？"},
        { "location": "527/TALK"  , "narrator": "千羽鶴", "text": "まさか、\nそんなはずはない。"},
        { "location": "528/TALK"  , "narrator": "千羽鶴", "text": "貴方は確かに言った。\n『千羽鶴の為、彼女に\n犠牲になってもらう』と。"},
        { "location": "529/SEL"   , "narrator": "", "text": "言いましたね"},
        { "location": "530/SEL"   , "narrator": "", "text": "身に覚えがありません"},
        { "location": "531/ACT"   , "narrator": "", "text": "言いましたね"},
        { "location": "532/ACT"   , "narrator": "", "text": "身に覚えがありません"},
        { "location": "533/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "534/TALK"  , "narrator": "千羽鶴", "text": "ならばOSのシステムバグ\nということになる。"},
        { "location": "535/TALK"  , "narrator": "千羽鶴", "text": "OSの製造元に問い合わせて\n修正してもらったら？"},
        { "location": "538/TALK"  , "narrator": "千羽鶴", "text": "ちなみに、このツッコミは\n彼女を不幸にする事を肯定\nするものではない。"},
        { "location": "539/TALK"  , "narrator": "千羽鶴", "text": "発症に関しては、目先だけ\n見れば不幸を強いている\nように見えるかもだけど、"},
        { "location": "540/TALK"  , "narrator": "千羽鶴", "text": "彼女の本質的な\n見方をすれば、彼女の\n幸せに繋がること。"},
        { "location": "541/TALK"  , "narrator": "千羽鶴", "text": "問題はそこではなく。"},
        { "location": "542/TALK"  , "narrator": "千羽鶴", "text": "貴方が彼女を不幸にすると\n『思い込んだ』事に対して\n私の協力を拒んだこと。"},
        { "location": "543/TALK"  , "narrator": "千羽鶴", "text": "私を犠牲にしても彼女を\n護る、の方を選んだのなら\n全く問題無いのだけど。"},
        { "location": "544/TALK"  , "narrator": "千羽鶴", "text": "……まあ、\nこの事については、もう\nこれくらいにしておく。"},
        { "location": "545/TALK"  , "narrator": "千羽鶴", "text": "口頭質問だったし、\n貴方もさほど考えて回答\nしてないのでしょうし。"},
        { "location": "546/TALK"  , "narrator": "千羽鶴", "text": "そんなことより、\nセルフクランの発症の話。"},
        { "location": "547/TALK"  , "narrator": "千羽鶴", "text": "発症は彼女にとっては\n寧ろ幸せに繋がること。"},
        { "location": "550/TALK"  , "narrator": "千羽鶴", "text": "まあ、\n予想はしていた。"},
        { "location": "551/TALK"  , "narrator": "千羽鶴", "text": "確かに、イメージとして\n発症はかなり印象悪い。"},
        { "location": "552/TALK"  , "narrator": "千羽鶴", "text": "協力するのは殺人に手を\n貸すのと同じ、くらいの\n印象なんでしょう？"},
        { "location": "553/SEL"   , "narrator": "", "text": "実際そうでしょ"},
        { "location": "554/SEL"   , "narrator": "", "text": "そこまでは言ってない"},
        { "location": "555/ACT"   , "narrator": "", "text": "実際そうでしょ"},
        { "location": "556/TALK"  , "narrator": "千羽鶴", "text": "発症は殺人ではない。"},
        { "location": "557/TALK"  , "narrator": "千羽鶴", "text": "それは、量子学とケーキが\n同じものだと言うくらい\n意味が分からない。"},
        { "location": "558/ACT"   , "narrator": "", "text": "そこまでは言ってない"},
        { "location": "559/TALK"  , "narrator": "千羽鶴", "text": "そう？\nでも、いやなことだと\n思ったのでしょう？"},
        { "location": "561/TALK"  , "narrator": "千羽鶴", "text": "結論から言えば、\n発症は彼女を\n不幸にするものではない。"},
        { "location": "562/TALK"  , "narrator": "千羽鶴", "text": "目先だけを見れば\n不幸を強いているように\n見えるかもだけど――"},
        { "location": "563/TALK"  , "narrator": "千羽鶴", "text": "彼女の本質的な\n見方をすれば、彼女の\n幸せに繋がること。"},
        { "location": "567/SEL"   , "narrator": "", "text": "何故！？"},
        { "location": "568/ACT"   , "narrator": "", "text": "何故！？"},
        { "location": "570/TALK"  , "narrator": "千羽鶴", "text": "さっき\n$ev32_lib$が\n言ったとおり。"},
        { "location": "571/TALK"  , "narrator": "千羽鶴", "text": "セルフクランは発症による\nフェノメノン化を\n望んでいる――。"},
        { "location": "572/SEL"   , "narrator": "", "text": "いやいやいや、なぜそう言い切れる！？"},
        { "location": "573/ACT"   , "narrator": "", "text": "いやいやいや、なぜそう言い切れる！？"},
        { "location": "575/TALK"  , "narrator": "千羽鶴", "text": "彼女と私とは\n誓いを立てているから。"},
        { "location": "576/TALK"  , "narrator": "千羽鶴", "text": "忘れてない？\n今の日本が巨大な\nフェノメノンであること。"},
        { "location": "577/TALK"  , "narrator": "千羽鶴", "text": "そして、フェノメノンより\n前の$ev32_fullname$には\n別の人生があったことを。"},
        { "location": "578/SEL"   , "narrator": "", "text": "あ"},
        { "location": "579/ACT"   , "narrator": "", "text": "あ"},
        { "location": "584/TALK"  , "narrator": "四十九夜", "text": "――とまあ、\nそうゆうわけやね。"},
        { "location": "585/TALK"  , "narrator": "四十九夜", "text": "うちの勝手な妄想では\n無いことが分かったろう。"},
        { "location": "586/TALK"  , "narrator": "昇華シンギュラリティ", "text": "それがどうした。"},
        { "location": "587/TALK"  , "narrator": "昇華シンギュラリティ", "text": "うちの想いは\n絶対に変わらんよ。"},
        { "location": "588/TALK"  , "narrator": "昇華シンギュラリティ", "text": "四十九夜も千羽鶴も、\nまとめてうちのココロから\n追い出しちゃるきね。"},
        { "location": "590/SEL"   , "narrator": "", "text": "ダメだ落ち着け！\n千羽鶴に支配される！"},
        { "location": "591/ACT"   , "narrator": "", "text": "ダメだ落ち着け！\n千羽鶴に支配される！"},
        { "location": "593/TALK"  , "narrator": "昇華シンギュラリティ", "text": "どういうことぞね？"},
        { "location": "594/TALK"  , "narrator": "千羽鶴", "text": "もう遅い。"},
        { "location": "597/TALK"  , "narrator": "昇華シンギュラリティ", "text": "お前さんはもはや\nうちの敵やき、別に\n何も期待しちょらん。"},
        { "location": "598/TALK"  , "narrator": "昇華シンギュラリティ", "text": "けんど１つだけ\n頼みがある。\n絶対邪魔せんでくれ。"},
        { "location": "599/TALK"  , "narrator": "昇華シンギュラリティ", "text": "必ずや、\nセルフクランの発症を\n回避しちゃるきね。"},
        { "location": "601/TALK"  , "narrator": "昇華シンギュラリティ", "text": "相棒、頼む。\n力を貸してくれ。"},
        { "location": "602/TALK"  , "narrator": "昇華シンギュラリティ", "text": "セルフクラン発症阻止には\nお前さんの力が\n必要不可欠や。"},
        { "location": "603/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "604/SEL"   , "narrator": "", "text": "だが断る"},
        { "location": "605/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "608/TALK"  , "narrator": "昇華シンギュラリティ", "text": "ありがとう、相棒！"},
        { "location": "609/ACT"   , "narrator": "", "text": "だが断る"},
        { "location": "612/TALK"  , "narrator": "昇華シンギュラリティ", "text": "どうゆうことや！？\n裏切りか！？"},
        { "location": "615/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、\nそれは出来ないと思う。"},
        { "location": "616/TALK"  , "narrator": "昇華シンギュラリティ", "text": "なんぞ、既に観測済か？\nそんな事は無いろう。"},
        { "location": "617/TALK"  , "narrator": "千羽鶴", "text": "観測してなくても\n未来は確定してる。\nだって私が――"},
        { "location": "618/TALK"  , "narrator": "千羽鶴", "text": "貴方を破壊するから。"},
        { "location": "625/TALK"  , "narrator": "昇華シンギュラリティ", "text": "うっ……くっ…\nあああ……っ！"},
        { "location": "630/SEL"   , "narrator": "", "text": "シンギュラリティ！！"},
        { "location": "631/SEL"   , "narrator": "", "text": "やめろ千羽鶴！！"},
        { "location": "632/ACT"   , "narrator": "", "text": "シンギュラリティ！！"},
        { "location": "637/TALK"  , "narrator": "昇華シンギュラリティ", "text": "何か…がっ……\n心……侵蝕…っ……"},
        { "location": "642/TALK"  , "narrator": "昇華シンギュラリティ", "text": "侵蝕しちゅう…っ！！"},
        { "location": "643/ACT"   , "narrator": "", "text": "やめろ千羽鶴！！"},
        { "location": "644/TALK"  , "narrator": "千羽鶴", "text": "大丈夫。"},
        { "location": "646/TALK"  , "narrator": "千羽鶴", "text": "さっきと同じで、\n一時的に人格の変化を\n促してるだけ。"},
        { "location": "647/TALK"  , "narrator": "千羽鶴", "text": "事が終われば\n元に戻すから\n心配しないで。"},
        { "location": "649/TALK"  , "narrator": "千羽鶴", "text": "この子の心を\n一時的に、擬似的に\n変化させてるだけ。"},
        { "location": "650/TALK"  , "narrator": "千羽鶴", "text": "フェノメノンに洗脳された\n人と同じ状態を、人格に\n作り出してるだけだから。"},
        { "location": "651/TALK"  , "narrator": "千羽鶴", "text": "心配しないで。"},
        { "location": "658/TALK"  , "narrator": "昇華シンギュラリティ", "text": "頼む、相棒…っ！"},
        { "location": "663/TALK"  , "narrator": "昇華シンギュラリティ", "text": "うちを壊せ！"},
        { "location": "666/SEL"   , "narrator": "", "text": "出来るか！！"},
        { "location": "667/ACT"   , "narrator": "", "text": "出来るか！！"},
        { "location": "669/TALK"  , "narrator": "昇華シンギュラリティ", "text": "大丈夫やよ！！\nクランの…収束と…っ…\n同じことや…っ！！"},
        { "location": "675/TALK"  , "narrator": "昇華シンギュラリティ", "text": "これしきで\n死にはせんよ！\nはよぅ！！"},
        { "location": "46/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月11日　 5:12 PM</color>\n長野から東京へ戻る途中、アーケロン車内にて。"},
        { "location": "312/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
