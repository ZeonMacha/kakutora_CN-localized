        { "location": "94/SCENARIO", "narrator": "", "text": "032_路面電車"},
        { "location": "121/TALK"   , "narrator": "アーヤ", "text": "こっちに北ら"},
        { "location": "122/TALK"   , "narrator": "アーヤ", "text": "江ノ電に乗れるって思ってたけど"},
        { "location": "123/TALK"   , "narrator": "アーヤ", "text": "結構遠いのよね(>_<)"},
        { "location": "125/SEL"    , "narrator": "", "text": "来たら、だよね"},
        { "location": "126/SEL"    , "narrator": "", "text": "そうなの？"},
        { "location": "127/SEL"    , "narrator": "", "text": "ロマンがあるよね"},
        { "location": "128/ACT"    , "narrator": "", "text": "来たら、だよね"},
        { "location": "129/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "130/TALK"   , "narrator": "アーヤ", "text": "北らだわ"},
        { "location": "131/ACT"    , "narrator": "", "text": "そうなの？"},
        { "location": "132/TALK"   , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "134/TALK"   , "narrator": "アーヤ", "text": "一時間くらい？"},
        { "location": "135/ACT"    , "narrator": "", "text": "ロマンがあるよね"},
        { "location": "137/TALK"   , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "138/TALK"   , "narrator": "アーヤ", "text": "海沿いを走る路面電車"},
        { "location": "139/TALK"   , "narrator": "アーヤ", "text": "素敵だわ(*^o^*)"},
        { "location": "141/TALK"   , "narrator": "アーヤ", "text": "映画の舞台になってたりするわよね"},
        { "location": "142/TALK"   , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "144/TALK"   , "narrator": "アーヤ", "text": "おしゃれだし"},
        { "location": "146/SEL"    , "narrator": "", "text": "ミーハーだね"},
        { "location": "147/SEL"    , "narrator": "", "text": "雰囲気があるよね"},
        { "location": "148/SEL"    , "narrator": "", "text": "アーヤとデートしたいな"},
        { "location": "149/ACT"    , "narrator": "", "text": "ミーハーだね"},
        { "location": "150/TALK"   , "narrator": "アーヤ", "text": "別に(｀ヘ´) "},
        { "location": "151/TALK"   , "narrator": "アーヤ", "text": "いいじゃないの"},
        { "location": "152/TALK"   , "narrator": "アーヤ", "text": "それで"},
        { "location": "153/ACT"    , "narrator": "", "text": "雰囲気があるよね"},
        { "location": "154/TALK"   , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "155/TALK"   , "narrator": "アーヤ", "text": "いい幹事"},
        { "location": "156/TALK"   , "narrator": "アーヤ", "text": "感じ"},
        { "location": "157/TALK"   , "narrator": "アーヤ", "text": "今度の休みには行こうかな"},
        { "location": "158/ACT"    , "narrator": "", "text": "アーヤとデートしたいな"},
        { "location": "160/TALK"   , "narrator": "アーヤ", "text": "あらいいわね(*^.^*)"},
        { "location": "161/TALK"   , "narrator": "アーヤ", "text": "路面電車でデートとか"},
        { "location": "162/TALK"   , "narrator": "アーヤ", "text": "それだけで嬉しいわ"},
        { "location": "163/TALK"   , "narrator": "アーヤ", "text": "晴れてる日に行きましょう"}
