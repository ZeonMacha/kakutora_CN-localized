{
    "dir": "chap13/daydra/dd_ch03_13_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "13302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "チェイス？＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アーヤを追え"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "じゃあ駅まで\n乗せてって。"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "そんなに遠回りに\nならないでしょ？"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "構わないけど…、\nギャヴィもどこか\nお出かけなの？"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "ちょっとねー。"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "ふふっ…もしかして、\nデート？"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "ば、バカ！\nそんなわけない\nでしょ！？"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "一人で展示会に\n行くだけよ。"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "また日本画か何かの\n展示会？"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "そんなとこ。\nうっかりしてたけど、\n今日が最終日なのよ。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "ふふっ、ギャヴィって\nそういうの好きよね。"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "あら、何か文句でも？"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "ううん。\nなんて言えば\nいいのかしら？"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "見てるとね、本当に\n好きなのが伝わってきて、\nこっちまで楽しくなるの。"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "…そんなつもりは\nないんだけどね。"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "でも伝わってるの。"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "そういえば、そういう\n展示会って行ったこと\nなかったなぁ…。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "そんなに楽しそうに\n見えるなら、\n一緒に来る？"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "結構有名な絵もある\nみたいだから、\n退屈はしないはずよ。"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "うーん…興味は\nあるんだけど――"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "今日はごめん。\n私も外せない予定が\n入ってるのよ。"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "…ま、そうよね。\nさすがに今誘うのは\n無茶ぶりだったわ。"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "今度やった時は\n連れてってもらうわ。"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "ええ…ところで――"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "アーヤの外せない\n用事って、何なの？"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "えっ？"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "まさかとは思うけど、\nアーヤの方こそ\nデートだったりして。"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "あはは、ないない。\nデートじゃないわ。"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "じゃあ、何なの？"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "…ちょ、まさか\n本当に！！"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "デートじゃないから！\n小夜たちと勉強会の\n約束をしてるのよ。"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "たちってことは――"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "男の子は一人も\n来ないわよ？"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "ほっ…よかったぁ…。"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "あたしより先に\n彼氏作られたかと\n思って、焦ったわ。"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "…ギャヴィより\n私の方が早く作れると\n思うんだけど…。"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "…何よ？"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "あ、ううん。\n何でもないわ。"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "それより、\n早く行きましょ。"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "ん、よろしくね。"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "送ってくれて\nありがと。"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "どういたしまして。"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "それじゃ、\n気を付けてね。"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "…なんか怪しいわね。"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "勉強会って言ってた\nけど、その割には\nワクワクしてたし。"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、カレシは\nまず考えられない\nとして――"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "だとすると…、\nうーん…。"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "…尾行してみよう\nかしら？"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "って、さすがに\nそれはマズい気も\nするけど――"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "でも、気になるし…。"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "あら、$handle$。\nいらっしゃい。"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "今回もまた何か\n悩みが出ちゃったのね。"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x993番地から\n0xFEC番地へ。"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了っ♪"},
        { "location": "185/TALK"  , "narrator": "ガブリエラ", "text": "それで、\n今回のあたしの\n総意は……っと。"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "ああ、アーヤのことね。"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "アーヤの行き先が\n気になるみたい。"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、よろしく。"},
        { "location": "189/SEL"   , "narrator": "", "text": "任せといて！"},
        { "location": "190/SEL"   , "narrator": "", "text": "なんか投げやりじゃない？"},
        { "location": "191/ACT"   , "narrator": "", "text": "任せといて！"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "ありがと。\nとっても心強いわ。"},
        { "location": "193/ACT"   , "narrator": "", "text": "なんか投げやりじゃない？"},
        { "location": "194/TALK"  , "narrator": "ガブリエラ", "text": "え？\nそうかしら？\nいつもと同じだけど？"},
        { "location": "195/SEL"   , "narrator": "", "text": "つばめの時はめっちゃテンション高いのに"},
        { "location": "196/ACT"   , "narrator": "", "text": "つばめの時はめっちゃテンション高いのに"},
        { "location": "198/TALK"  , "narrator": "ガブリエラ", "text": "あぁ、だって\nつばめのことは\n別格だもの！"},
        { "location": "199/SEL"   , "narrator": "", "text": "もしかして、アーヤのことは好きじゃないの？"},
        { "location": "200/SEL"   , "narrator": "", "text": "もしかして、ツンデレ特有の照れ隠し？"},
        { "location": "201/ACT"   , "narrator": "", "text": "もしかして、アーヤのことは好きじゃないの？"},
        { "location": "202/TALK"  , "narrator": "ガブリエラ", "text": "え？\nそんなことないけど？"},
        { "location": "203/ACT"   , "narrator": "", "text": "もしかして、ツンデレ特有の照れ隠し？"},
        { "location": "204/TALK"  , "narrator": "ガブリエラ", "text": "あたしは\nツンデレじゃないわよ？"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "あ、ツンデレだから\nツンデレじゃないって\n言ってるんじゃないから。"},
        { "location": "206/TALK"  , "narrator": "ガブリエラ", "text": "あたしはツンデレ成分\nゼロの人格だし。"},
        { "location": "208/SEL"   , "narrator": "", "text": "じゃあなんでウキウキしたりしないの？"},
        { "location": "209/ACT"   , "narrator": "", "text": "じゃあなんでウキウキしたりしないの？"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "うーん、そうね。"},
        { "location": "213/TALK"  , "narrator": "ガブリエラ", "text": "アーヤに対しては\n色々複雑なのよ。"},
        { "location": "214/TALK"  , "narrator": "ガブリエラ", "text": "あたし自身、\n今の付き合い方で本当に\nいいのかわからないし。"},
        { "location": "215/SEL"   , "narrator": "", "text": "トライナリーメンバーとしての悩み？"},
        { "location": "216/SEL"   , "narrator": "", "text": "ひとりの女性としての悩み？"},
        { "location": "217/ACT"   , "narrator": "", "text": "トライナリーメンバーとしての悩み？"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "それもあるけど、\n今回はそれとは\nちょっと違うわね。"},
        { "location": "219/ACT"   , "narrator": "", "text": "ひとりの女性としての悩み？"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "あら、その言い方\nとっても素敵ね！\n大人の女って感じで。"},
        { "location": "221/TALK"  , "narrator": "ガブリエラ", "text": "でも、そういうのとは\nちょっと違うわね。"},
        { "location": "223/SEL"   , "narrator": "", "text": "教えて"},
        { "location": "224/ACT"   , "narrator": "", "text": "教えて"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "うーん、そうね。"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "アーヤの事は\n大好きなのよ。"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "でも、好きじゃない\n一面もある。"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "だって、今のアーヤは\n抜け殻だもの。"},
        { "location": "230/SEL"   , "narrator": "", "text": "どういう意味？"},
        { "location": "231/ACT"   , "narrator": "", "text": "どういう意味？"},
        { "location": "233/TALK"  , "narrator": "ガブリエラ", "text": "その言葉の通り、\n中身が無いってこと。"},
        { "location": "234/TALK"  , "narrator": "ガブリエラ", "text": "現実のあたしは、\nその事に気づいてるようで\n気づいてないんだけど。"},
        { "location": "235/TALK"  , "narrator": "ガブリエラ", "text": "もやっとしつつも、\n理由のわからない欲求に\nよって依存してるのよ。"},
        { "location": "236/TALK"  , "narrator": "ガブリエラ", "text": "このままだとあまり\nいいことにはならない\nような気もするけどね。"},
        { "location": "237/TALK"  , "narrator": "ガブリエラ", "text": "だから今は、色んなことを\nクリアにして、アーヤを\nもっと知るべきなのよ。"},
        { "location": "238/TALK"  , "narrator": "ガブリエラ", "text": "そういう意味でも、\n今回はアーヤの行動を\n追う必要があるわ。"},
        { "location": "240/TALK"  , "narrator": "ガブリエラ", "text": "というわけで、\nよろしくお願いね。"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！"},
        { "location": "30/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月21日　11:25 AM</color>\n休日の昼前、神楽坂トライナリー劇場前にて。"},
        { "location": "126/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"}
    ]
}
