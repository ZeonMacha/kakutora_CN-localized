{
    "dir": "chap05/daydra/dd_ch01_05_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "5152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "静岡から来た少女"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "静岡から来た少女"},
        { "location": "18/TALK"   , "narrator": "つばめ", "text": "…電車が来るまで、\nまだ時間ある。\nよかったぁ…。"},
        { "location": "19/TALK"   , "narrator": "つばめ", "text": "メノウちゃんに\n会うのが楽しみで――"},
        { "location": "20/TALK"   , "narrator": "つばめ", "text": "思ったより準備に\n時間掛かっちゃった。"},
        { "location": "21/TALK"   , "narrator": "つばめ", "text": "…でも、そっかぁ。"},
        { "location": "22/TALK"   , "narrator": "つばめ", "text": "もうすぐ、本物の\nメノウちゃんに\n会えるんだ…。"},
        { "location": "25/TALK"   , "narrator": "つばめ", "text": "…なんか、ドキドキ\nしてきちゃった。"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "メノウちゃんに\n会えるドキドキを\n抑えるのは――"},
        { "location": "27/TALK"   , "narrator": "つばめ", "text": "メノウちゃんの\n曲を聞くのが\n一番だよね。"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "えっと、どの曲に\nしようかなぁ…。"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "あ、お父さん…。\nやっと手紙に気付いて\nくれたんだ。"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "駅まで送っていくって\n言っただろ、って\n言うんだろうなぁ…。"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "…あはは、やっぱり。\nわかりやす過ぎだよ。"},
        { "location": "43/TALK"   , "narrator": "啓介", "text": "駅まで送っていくと、昨日言っただろ？"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "うん"},
        { "location": "46/TALK"   , "narrator": "啓介", "text": "なら、どうして一人で行ったんだ？"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "ワクワクし過ぎて"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "早起きしちゃったから"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "一人で落ち着きたくて"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "ごめんね"},
        { "location": "53/TALK"   , "narrator": "啓介", "text": "何かあったらどうするつもりだ？"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "駅に行くくらい"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "心配ないよ"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "置き手紙した通り"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "わたしは大丈夫だから"},
        { "location": "60/TALK"   , "narrator": "啓介", "text": "もう駅なのか？"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "うん"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "駅に入るところ"},
        { "location": "64/TALK"   , "narrator": "啓介", "text": "じゃあ、今から駅まで行くから"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "なんで！？"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "来なくて大丈夫だから"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "もうすぐ電車も来るし"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "間に合わないよ？"},
        { "location": "70/TALK"   , "narrator": "啓介", "text": "万が一電車に乗れなかった時はどうするつもりだ？"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "ないから！"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "っていうか、どんな状況！？"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "お父さん、心配し過ぎ！"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "わたしはそんな子供じゃないよ"},
        { "location": "76/TALK"   , "narrator": "啓介", "text": "しかし、新幹線に乗るのは初めてだろ？"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "ホームまで付いてくる気だったの！？"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "本当平気だから"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "大丈夫！"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "来たら怒るからね？"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "いってきます"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "…まったく！\nお父さんってば――"},
        { "location": "89/TALK"   , "narrator": "つばめ", "text": "今時小学生だって、\n一人で遠出したり\nするのに。"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "…もしかしてわたし、\n小学生よりも\n信用されてない？"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "ううん、お父さんが\n過保護なだけ。\n絶対にそう！"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "っていうか、\n今日はメノウちゃんの\nライブなんだから――"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "もっとテンション\n上げてかないと！"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "…メノウちゃん、\nわたしの方\n向いてくれるかな？"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "もしメノウちゃんと\n目が合ったら、\n感激だなぁ。"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "あ、でも大好きな\n曲の時にはちょっと\n危ないかも。"},
        { "location": "99/TALK"   , "narrator": "つばめ", "text": "感激し過ぎて、\n泣いちゃうかも\nしれないし…。"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "…でも、東京は\n初めてだから――"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "あんまり浮かれない\nように気を付け\nなくちゃ。"},
        { "location": "102/SEL"   , "narrator": "", "text": "$me$がいつでも３６５日つばめを護る！"},
        { "location": "103/SEL"   , "narrator": "", "text": "忘れ物はありませんか？"},
        { "location": "104/ACT"   , "narrator": "", "text": "$me$がいつでも３６５日つばめを護る！"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "ぁりがと"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "ぃつも一緒だし"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "頼りにしてます"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "じゃぁ"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "東京に着ぃたら"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "迷子にならなぃよぅに"},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "ナビとか"},
        { "location": "129/TALK"  , "narrator": "つばめ", "text": "置き忘れの監視とか"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "お願いね"},
        { "location": "141/ACT"   , "narrator": "", "text": "忘れ物はありませんか？"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "忘れ物はなぃよ"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "家を出る前に"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "全部確認したし"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "置き忘れは怖ぃから"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "監視よろしくお願ぃします"},
        { "location": "175/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "…財布、お金、\nスマホ、チケット、\n音楽プレイヤー。"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "うん、全部ある！"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "前もって忘れ物しない\nように、リストを\n作っといてよかった。"},
        { "location": "179/TALK"  , "narrator": "つばめ", "text": "これで安心して\nライブに行けるし――"},
        { "location": "180/TALK"  , "narrator": "つばめ", "text": "メノウちゃんに\nお土産も…。"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "182/TALK"  , "narrator": "つばめ", "text": "あーーーーーーっ！！"},
        { "location": "195/TALK"  , "narrator": "つばめ", "text": "どうしよう"},
        { "location": "196/TALK"  , "narrator": "つばめ", "text": "大切な物忘れちゃった！"},
        { "location": "197/TALK"  , "narrator": "つばめ", "text": "せっかく準備したのに！"},
        { "location": "199/SEL"   , "narrator": "", "text": "何を忘れたの？"},
        { "location": "200/ACT"   , "narrator": "", "text": "何を忘れたの？"},
        { "location": "203/TALK"  , "narrator": "つばめ", "text": "大切な物！"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "メノウちゃんに渡そうと思った"},
        { "location": "205/TALK"  , "narrator": "つばめ", "text": "大切なお土産"},
        { "location": "206/TALK"  , "narrator": "つばめ", "text": "忘れないように"},
        { "location": "207/TALK"  , "narrator": "つばめ", "text": "ベッドの上に置いたのに"},
        { "location": "208/TALK"  , "narrator": "つばめ", "text": "忘れてきちゃった"},
        { "location": "209/TALK"  , "narrator": "つばめ", "text": "どうしよう"},
        { "location": "211/SEL"   , "narrator": "", "text": "父に頼もう"},
        { "location": "212/SEL"   , "narrator": "", "text": "また買えば？"},
        { "location": "213/ACT"   , "narrator": "", "text": "父に頼もう"},
        { "location": "214/TALK"  , "narrator": "つばめ", "text": "ダメ！"},
        { "location": "215/TALK"  , "narrator": "つばめ", "text": "そんなことしたら"},
        { "location": "216/TALK"  , "narrator": "つばめ", "text": "ほれ見たことかって"},
        { "location": "217/TALK"  , "narrator": "つばめ", "text": "絶対調子に乗って勝ち誇るもん"},
        { "location": "219/TALK"  , "narrator": "つばめ", "text": "ああ見えてお父さん"},
        { "location": "220/TALK"  , "narrator": "つばめ", "text": "凄く子供っぽいから"},
        { "location": "221/TALK"  , "narrator": "つばめ", "text": "調子に乗ってる時のお父さん"},
        { "location": "222/TALK"  , "narrator": "つばめ", "text": "なんかムカつくんだ"},
        { "location": "224/SEL"   , "narrator": "", "text": "じゃあ、また買うしかないね"},
        { "location": "225/ACT"   , "narrator": "", "text": "じゃあ、また買うしかないね"},
        { "location": "229/TALK"  , "narrator": "つばめ", "text": "違うの"},
        { "location": "230/TALK"  , "narrator": "つばめ", "text": "一番大切なのは"},
        { "location": "231/TALK"  , "narrator": "つばめ", "text": "一緒に入れた手紙なの"},
        { "location": "232/TALK"  , "narrator": "つばめ", "text": "手紙は買えないよ"},
        { "location": "233/ACT"   , "narrator": "", "text": "また買えば？"},
        { "location": "236/TALK"  , "narrator": "つばめ", "text": "一生懸命考えて書いたのに"},
        { "location": "238/TALK"  , "narrator": "つばめ", "text": "もう"},
        { "location": "240/TALK"  , "narrator": "つばめ", "text": "帰ろうかな"},
        { "location": "242/SEL"   , "narrator": "", "text": "便箋と封筒とペン買えば電車の中で書ける"},
        { "location": "243/ACT"   , "narrator": "", "text": "便箋と封筒とペン買えば電車の中で書ける"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "そうだ"},
        { "location": "246/TALK"  , "narrator": "つばめ", "text": "それだよ！"},
        { "location": "247/TALK"  , "narrator": "つばめ", "text": "内容は全部覚えてるから"},
        { "location": "248/TALK"  , "narrator": "つばめ", "text": "東京に着くまでに書きなおせるし"},
        { "location": "249/TALK"  , "narrator": "つばめ", "text": "ありがとう！"},
        { "location": "250/TALK"  , "narrator": "つばめ", "text": "急いで買ってくる！"},
        { "location": "261/TALK"  , "narrator": "つばめ", "text": "…よかった。\nこれでメノウちゃんに\n手紙渡せる。"},
        { "location": "262/TALK"  , "narrator": "つばめ", "text": "スマホのコンピュー\nターって、頭いいん\nだなぁ。"},
        { "location": "264/TALK"  , "narrator": "つばめ", "text": "…お土産と便箋、\n早く買わなくちゃ！"},
        { "location": "276/TALK"  , "narrator": "つばめ", "text": "――そんな感じで、\nあの日の朝はすっごく\nドタバタでした…。"},
        { "location": "277/TALK"  , "narrator": "真幌", "text": "モグモグ…ふむ、\nなるほどな…。"},
        { "location": "279/TALK"  , "narrator": "真幌", "text": "で？　これがメノウに\n渡そうと思っていた\nお土産のお菓子か。"},
        { "location": "281/TALK"  , "narrator": "つばめ", "text": "はい！"},
        { "location": "282/TALK"  , "narrator": "つばめ", "text": "凄く美味しい\nお菓子なんで――"},
        { "location": "283/TALK"  , "narrator": "つばめ", "text": "メノウちゃんも\n喜んでくれるかな、\nって思ったんです。"},
        { "location": "284/TALK"  , "narrator": "つばめ", "text": "まあ、結局渡す\n暇ありませんでした\nけど…。"},
        { "location": "285/TALK"  , "narrator": "真幌", "text": "あの状況だったから、\nまあ、当然だな。"},
        { "location": "288/TALK"  , "narrator": "真幌", "text": "…それにしても、\nこれ美味いな。"},
        { "location": "290/TALK"  , "narrator": "つばめ", "text": "どんどん食べて\nください。"},
        { "location": "291/TALK"  , "narrator": "つばめ", "text": "わたし一人で食べたら\n体重がデブーン、って\nなっちゃいますし…。"},
        { "location": "293/TALK"  , "narrator": "真幌", "text": "大袈裟な奴だ。\nまったく太っていない\nというのに…。"},
        { "location": "294/TALK"  , "narrator": "真幌", "text": "しかし…もしこれを\nメノウに渡していたと\nしたら――"},
        { "location": "295/TALK"  , "narrator": "真幌", "text": "かなり驚かれていた\nだろうな。"},
        { "location": "297/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "299/TALK"  , "narrator": "真幌", "text": "いや、アーティスト\nへの土産に――"},
        { "location": "300/TALK"  , "narrator": "真幌", "text": "菓子２０個入りの\n大箱持ってくる奴は\n珍しいだろうからな。"},
        { "location": "302/TALK"  , "narrator": "つばめ", "text": "えぇっ！！\nそうなんですか！？"},
        { "location": "303/TALK"  , "narrator": "真幌", "text": "…いや、正確に\n言うなら、いない、\nだろうな。"},
        { "location": "304/TALK"  , "narrator": "つばめ", "text": "えぇーっ！？"},
        { "location": "305/TALK"  , "narrator": "真幌", "text": "本気だったのか！？"},
        { "location": "307/TALK"  , "narrator": "つばめ", "text": "は、はい…。\nこういうことするの\n初めてだから――"},
        { "location": "308/TALK"  , "narrator": "つばめ", "text": "勝手が\nわからなくて…。"},
        { "location": "311/TALK"  , "narrator": "真幌", "text": "ふむ…。"},
        { "location": "312/TALK"  , "narrator": "真幌", "text": "…逢瀬つばめ、か。"},
        { "location": "313/TALK"  , "narrator": "真幌", "text": "ドームであったことも\n考えて、正直警戒して\nいたんだが――"},
        { "location": "316/TALK"  , "narrator": "真幌", "text": "…ふふっ、\nおまえと話してると\n調子が狂う。"},
        { "location": "318/TALK"  , "narrator": "つばめ", "text": "はい？"},
        { "location": "320/TALK"  , "narrator": "真幌", "text": "逢瀬は面白い奴だ、\nということだ。"},
        { "location": "322/TALK"  , "narrator": "つばめ", "text": "…褒められてる、\nのかなぁ？"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月3日　10:22 AM</color>\nフレイメノウライブ当日、つばめの地元静岡県の某駅にて。"}
    ]
}
