{
    "dir": "dramatics/daydra/drm_ch02_00_770.js",
    "type": "Episode",
    "info": {
        "story_id": "2077",
        "cid": "ayami",
        "title": "らぶとーく 第76話",
        "sub_title": "びっくり箱"
    },
    "entry":
    [
        { "location": "122/SCENARIO", "narrator": "", "text": "びっくり箱"},
        { "location": "136/TALK"    , "narrator": "ガブリエラ", "text": "開いてるわよ。"},
        { "location": "143/TALK"    , "narrator": "アーヤ", "text": "ごめんね、こんな時間に。"},
        { "location": "144/TALK"    , "narrator": "ガブリエラ", "text": "ううん、気にしないで。"},
        { "location": "146/TALK"    , "narrator": "ガブリエラ", "text": "多分、そろそろ来る頃じゃ\nないかな、って思ってた\nところだし。"},
        { "location": "148/TALK"    , "narrator": "アーヤ", "text": "うっ…。"},
        { "location": "149/TALK"    , "narrator": "ガブリエラ", "text": "で？　どんな用事かしら？"},
        { "location": "150/TALK"    , "narrator": "アーヤ", "text": "…お礼を言いに来たのよ。"},
        { "location": "152/TALK"    , "narrator": "アーヤ", "text": "その、ほら…私の箱を、\n回収してくれたから…。"},
        { "location": "153/TALK"    , "narrator": "アーヤ", "text": "…ありがとう。\n本当、安心したわ。"},
        { "location": "154/TALK"    , "narrator": "ガブリエラ", "text": "…やっぱり、超大切な物\nだったんだ？"},
        { "location": "155/TALK"    , "narrator": "アーヤ", "text": "当然よ！"},
        { "location": "156/TALK"    , "narrator": "アーヤ", "text": "あの箱の中身、\nギャヴィも見たんでしょ？"},
        { "location": "158/TALK"    , "narrator": "ガブリエラ", "text": "手作りっぽい服とか、\n色んな物が入ってた\nけど――"},
        { "location": "159/TALK"    , "narrator": "ガブリエラ", "text": "男物っぽいデザインの物\nばかりだったわね。"},
        { "location": "161/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "163/TALK"    , "narrator": "ガブリエラ", "text": "ははぁん、なるほど…。"},
        { "location": "166/TALK"    , "narrator": "ガブリエラ", "text": "彼氏へのプレゼントが\n詰まった箱、ってわけ？"},
        { "location": "167/TALK"    , "narrator": "アーヤ", "text": "…そうよ。"},
        { "location": "168/TALK"    , "narrator": "ガブリエラ", "text": "へぇー、アーヤってば\nそんな彼氏箱とか\n作ったりするのね！？"},
        { "location": "171/TALK"    , "narrator": "アーヤ", "text": "ち、違うわ！\n彼氏箱じゃないから！"},
        { "location": "172/TALK"    , "narrator": "ガブリエラ", "text": "彼氏へのプレゼントを\n詰めた箱なんでしょ？\n彼氏箱じゃん"},
        { "location": "173/TALK"    , "narrator": "アーヤ", "text": "違うから！"},
        { "location": "174/TALK"    , "narrator": "アーヤ", "text": "あれは、あなた箱、\nっていうの！"},
        { "location": "176/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "177/TALK"    , "narrator": "ガブリエラ", "text": "あ、うん…わかった…。\nあなた箱ね…。"},
        { "location": "179/TALK"    , "narrator": "ガブリエラ", "text": "けど、そんな大切な物を、\n酔った勢いで捨てるのは\nどうなのよ？"},
        { "location": "182/TALK"    , "narrator": "アーヤ", "text": "わかってるわ。\nあの時は、どうかしてた\nのよ。"},
        { "location": "183/TALK"    , "narrator": "アーヤ", "text": "でも、色んなこと考えて\nたら、どうしても自分を\n抑えられなくて…。"},
        { "location": "185/TALK"    , "narrator": "ガブリエラ", "text": "キレちゃった、\nってわけね。"},
        { "location": "186/TALK"    , "narrator": "アーヤ", "text": "…恥ずかしながらね。"},
        { "location": "188/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…。\nアーヤってさ、普段は凄く\nお姉さんぶってるのに――"},
        { "location": "189/TALK"    , "narrator": "ガブリエラ", "text": "時々、そうやって\nキレることあるわよね？"},
        { "location": "191/TALK"    , "narrator": "アーヤ", "text": "え、ええ…そうね…。"},
        { "location": "192/TALK"    , "narrator": "ガブリエラ", "text": "正直、アーヤのそういう\nところって、あたしは\nかっこ悪くて嫌いよ。"},
        { "location": "193/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "194/TALK"    , "narrator": "ガブリエラ", "text": "…でもまあ――"},
        { "location": "195/TALK"    , "narrator": "ガブリエラ", "text": "アーヤの好きな人には、\nそういうところが可愛くて\n良いんだろうけどね。"},
        { "location": "196/TALK"    , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "198/TALK"    , "narrator": "アーヤ", "text": "そんな、まさか…。\nそれはないわよ。"},
        { "location": "200/TALK"    , "narrator": "ガブリエラ", "text": "あるって、絶対。"},
        { "location": "203/TALK"    , "narrator": "アーヤ", "text": "無いから、絶対。"},
        { "location": "204/TALK"    , "narrator": "ガブリエラ", "text": "もう！"},
        { "location": "205/TALK"    , "narrator": "ガブリエラ", "text": "だったら、今この場で\n聞いてみてよ。"},
        { "location": "207/TALK"    , "narrator": "アーヤ", "text": "はぁ！？\n無理よ、そんなの！\n絶対無理だから！"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "いいじゃん、ちょっと\n聞くくらいなんだし。"},
        { "location": "209/TALK"    , "narrator": "アーヤ", "text": "無理だってば！\nっていうか、それのどこが\n可愛いのよ？"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "いいから、今すぐ聞く！\n今日くらい、あたしの\n言うこと聞きなさいよ。"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "あたしはあなた箱を\n回収した、恩人なのよ？"},
        { "location": "213/TALK"    , "narrator": "アーヤ", "text": "そ、それはそうだけど…。"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "なら、今日は文句\n言わずにあたしの\n言うこと聞きなさい。"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "…さ、早く聞いて。"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "…もぅ、仕方ないわね。"},
        { "location": "222/TALK"    , "narrator": "アーヤ", "text": "本当に、そうなのかしら？"},
        { "location": "227/TALK"    , "narrator": "アーヤ", "text": "$handle$さん"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "聞きたいことがあるの( ・_・)σﾞ"},
        { "location": "230/SEL"     , "narrator": "", "text": "何でも聞いて"},
        { "location": "231/ACT"     , "narrator": "", "text": "何でも聞いて"},
        { "location": "233/TALK"    , "narrator": "アーヤ", "text": "うん"},
        { "location": "234/TALK"    , "narrator": "アーヤ", "text": "今回の件もそうなんだけど"},
        { "location": "235/TALK"    , "narrator": "アーヤ", "text": "私ね"},
        { "location": "236/TALK"    , "narrator": "アーヤ", "text": "時々キレることがあるの(-ω-;)"},
        { "location": "237/TALK"    , "narrator": "アーヤ", "text": "そういうところって"},
        { "location": "238/TALK"    , "narrator": "アーヤ", "text": "$handle$さんはどう思う？"},
        { "location": "239/TALK"    , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "240/TALK"    , "narrator": "アーヤ", "text": "どう考えても変よね？(; ;)"},
        { "location": "243/SEL"     , "narrator": "", "text": "可愛いから許す"},
        { "location": "244/SEL"     , "narrator": "", "text": "たまにはいいよね"},
        { "location": "245/SEL"     , "narrator": "", "text": "アーヤってだけで全部あり"},
        { "location": "246/ACT"     , "narrator": "", "text": "可愛いから許す"},
        { "location": "249/TALK"    , "narrator": "アーヤ", "text": "もー！"},
        { "location": "250/TALK"    , "narrator": "アーヤ", "text": "違うでしょ！？"},
        { "location": "251/TALK"    , "narrator": "アーヤ", "text": "そういうこと聞いてるんじゃないのに！(>_<)"},
        { "location": "255/ACT"     , "narrator": "", "text": "たまには良いよね"},
        { "location": "256/TALK"    , "narrator": "アーヤ", "text": "ありなの！？＼(◎o◎)／"},
        { "location": "258/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "259/TALK"    , "narrator": "アーヤ", "text": "もうやらないようにするわ"},
        { "location": "261/TALK"    , "narrator": "アーヤ", "text": "恥ずかしいし…(>_<)"},
        { "location": "262/ACT"     , "narrator": "", "text": "アーヤってだけで全部あり"},
        { "location": "264/TALK"    , "narrator": "アーヤ", "text": "いや"},
        { "location": "265/TALK"    , "narrator": "アーヤ", "text": "なんなのそれ！？"},
        { "location": "267/TALK"    , "narrator": "アーヤ", "text": "普通に可愛いって言われるより"},
        { "location": "268/TALK"    , "narrator": "アーヤ", "text": "数倍恥ずかしいんだけど！？(>_<)"},
        { "location": "270/SEL"     , "narrator": "", "text": "恥ずかしがらせてみた"},
        { "location": "271/ACT"     , "narrator": "", "text": "恥ずかしがらせてみた"},
        { "location": "274/TALK"    , "narrator": "アーヤ", "text": "バカ！"},
        { "location": "275/TALK"    , "narrator": "アーヤ", "text": "いつかお返しするから！"},
        { "location": "287/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "288/TALK"    , "narrator": "ガブリエラ", "text": "ふーん…。"},
        { "location": "290/TALK"    , "narrator": "アーヤ", "text": "な、なによ？\nそんなニヤニヤして…。"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "…顔、赤くなってる。\n相当嬉しいこと言われた\nみたいね。"},
        { "location": "292/TALK"    , "narrator": "アーヤ", "text": "っ！？"},
        { "location": "294/TALK"    , "narrator": "ガブリエラ", "text": "ふふっ、驚きだわ。\nアーヤがこんな反応\n見せる日が来るなんて。"},
        { "location": "295/TALK"    , "narrator": "ガブリエラ", "text": "恋は人を変える、って\nいうけど、本当ね。"},
        { "location": "298/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "299/TALK"    , "narrator": "ガブリエラ", "text": "あ、ごめん…。\nちょっとからかい過ぎた？"},
        { "location": "300/TALK"    , "narrator": "アーヤ", "text": "…ううん。\nそうじゃないの。"},
        { "location": "303/TALK"    , "narrator": "アーヤ", "text": "恋は人を変える、って\nいうの…私も何となく\nわかる気がしたから…。"},
        { "location": "304/TALK"    , "narrator": "ガブリエラ", "text": "…あのさ、改めて\nそういうこと言うの、\nやめてもらえる？"},
        { "location": "306/TALK"    , "narrator": "ガブリエラ", "text": "今度は、聞いてる\nこっちが恥ずかしく\nなってくるから…。"}
    ]
}
