    "entry":
    [
        { "location": "164/SCENARIO", "narrator": "", "text": "小さな一歩"},
        { "location": "187/TALK"    , "narrator": "先生", "text": "えー、このように、\n平方根とは２乗を\n逆にしたもので――"},
        { "location": "188/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "190/TALK"    , "narrator": "ガブリエラ", "text": "緊張して来たわ…。"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "$handle$、いる？"},
        { "location": "197/TALK"    , "narrator": "ガブリエラ", "text": "今、凄く緊張してるの"},
        { "location": "199/SEL"     , "narrator": "", "text": "どうかしたの？"},
        { "location": "200/ACT"     , "narrator": "", "text": "どうかしたの？"},
        { "location": "202/TALK"    , "narrator": "ガブリエラ", "text": "私ね"},
        { "location": "203/TALK"    , "narrator": "ガブリエラ", "text": "この授業中に"},
        { "location": "205/TALK"    , "narrator": "ガブリエラ", "text": "手を挙げてみようと思うの"},
        { "location": "207/SEL"     , "narrator": "", "text": "大丈夫なの？"},
        { "location": "208/ACT"     , "narrator": "", "text": "大丈夫なの？"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "平気に決まってるでしょ！"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "あ"},
        { "location": "212/TALK"    , "narrator": "ガブリエラ", "text": "ううん、平気じゃないかも"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "さっきまで平気だったけど"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "段々緊張してきて…"},
        { "location": "216/SEL"     , "narrator": "", "text": "無理しなくていいよ"},
        { "location": "217/SEL"     , "narrator": "", "text": "見ててあげるから"},
        { "location": "218/SEL"     , "narrator": "", "text": "応援してる"},
        { "location": "219/ACT"     , "narrator": "", "text": "無理しなくていいよ"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "無理じゃない！"},
        { "location": "221/TALK"    , "narrator": "ガブリエラ", "text": "私、決めたから！"},
        { "location": "222/ACT"     , "narrator": "", "text": "見ててあげるから"},
        { "location": "223/TALK"    , "narrator": "ガブリエラ", "text": "子供扱いしてない？"},
        { "location": "224/TALK"    , "narrator": "ガブリエラ", "text": "お父さんみたいな言い方しないで！"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "まったく…"},
        { "location": "226/ACT"     , "narrator": "", "text": "応援してる"},
        { "location": "227/TALK"    , "narrator": "ガブリエラ", "text": "ありがと"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "頑張るから！"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "…大丈夫。\nあたしにはできるわ。"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "小学生でもできる\nことなんだから、\nこれくらい…。"},
        { "location": "238/TALK"    , "narrator": "先生", "text": "では、簡単な問題を\n出しますね。"},
        { "location": "239/TALK"    , "narrator": "先生", "text": "１００の平方根は\nいくつになるか――"},
        { "location": "240/TALK"    , "narrator": "先生", "text": "わかる人はいますか？"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "っ！！"},
        { "location": "243/TALK"    , "narrator": "先生", "text": "じゃあ、えっと…。"},
        { "location": "247/TALK"    , "narrator": "先生", "text": "はい、大山さん。"},
        { "location": "248/TALK"    , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "249/TALK"    , "narrator": "女子高校生Ａ", "text": "えーっと…\n１００００ですか？"},
        { "location": "250/TALK"    , "narrator": "先生", "text": "それは２乗でしょう？\n平方根はその逆です。"},
        { "location": "251/TALK"    , "narrator": "女子高校生Ａ", "text": "あ、そっか…。"},
        { "location": "252/TALK"    , "narrator": "先生", "text": "えっと、それじゃあ…。"},
        { "location": "254/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "255/TALK"    , "narrator": "先生", "text": "…いないですか？\nでは、解説しながら\n答えを教えますね。"},
        { "location": "256/TALK"    , "narrator": "ガブリエラ", "text": "…まさか、他の人が\n当てられるなんて…。"},
        { "location": "257/TALK"    , "narrator": "ガブリエラ", "text": "何でこういう時に限って\n誰か手を上げるのよ！？"},
        { "location": "258/TALK"    , "narrator": "ガブリエラ", "text": "普段は誰もあげない\nくせに！！"},
        { "location": "259/SEL"     , "narrator": "", "text": "残念だったね"},
        { "location": "260/ACT"     , "narrator": "", "text": "残念だったね"},
        { "location": "272/TALK"    , "narrator": "ガブリエラ", "text": "最低よ"},
        { "location": "273/TALK"    , "narrator": "ガブリエラ", "text": "せっかく勇気を出して手を上げようとしたのに"},
        { "location": "274/TALK"    , "narrator": "ガブリエラ", "text": "先に他の人が当たるなんて"},
        { "location": "277/SEL"     , "narrator": "", "text": "それでも偉かったよ"},
        { "location": "278/ACT"     , "narrator": "", "text": "それでも偉かったよ"},
        { "location": "280/TALK"    , "narrator": "ガブリエラ", "text": "本当にそう思ってくれてる？"},
        { "location": "281/TALK"    , "narrator": "ガブリエラ", "text": "本当に頑張ったんだから"},
        { "location": "282/TALK"    , "narrator": "ガブリエラ", "text": "褒めてくれて"},
        { "location": "283/TALK"    , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "なんでもない"},
        { "location": "289/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "290/TALK"    , "narrator": "ガブリエラ", "text": "ありがと、$handle$。"},
        { "location": "173/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　 1:31 PM</color>\nとある平日、付属学園中等部ガブリエラの教室でのこと"}
    ]
}
