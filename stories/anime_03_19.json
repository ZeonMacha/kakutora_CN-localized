{
    "dir": "chap19/daydra/anime_03_19.js",
    "type": "MainStory",
    "info": {
        "story_id": "19301",
        "cid": "gabriella",
        "title": "001 アニメーション",
        "sub_title": "弾の数だけ抱きしめて"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第19話"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n逢瀬つばめの解説を\nするだけでいい？"},
        { "location": "51/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n國政綾水の解説を\nするだけでいい？"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\nガブリエラの解説を\nするだけでいい？"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n恋ヶ崎みやびの解説を\nするだけでいい？"},
        { "location": "57/SEL"    , "narrator": "", "text": "はい"},
        { "location": "58/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "59/ACT"    , "narrator": "", "text": "はい"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "63/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "69/TALK"   , "narrator": "千羽鶴", "text": "ようこそ、\n真実を知ろうとする\n旅人よ。"},
        { "location": "70/SEL"    , "narrator": "", "text": "挨拶が変わった！"},
        { "location": "71/SEL"    , "narrator": "", "text": "真実よりもっとラブラブしたい"},
        { "location": "72/SEL"    , "narrator": "", "text": "真実より千羽鶴とゴールしたい"},
        { "location": "73/ACT"    , "narrator": "", "text": "挨拶が変わった！"},
        { "location": "74/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "75/TALK"   , "narrator": "千羽鶴", "text": "フェイズが変わったから\n挨拶も変えてみた。"},
        { "location": "76/ACT"    , "narrator": "", "text": "真実よりもっとラブラブしたい"},
        { "location": "77/TALK"   , "narrator": "千羽鶴", "text": "じゃあ次回は、"},
        { "location": "78/TALK"   , "narrator": "千羽鶴", "text": "ようこそ、\nもっとラブラブしたい\n旅人よ。"},
        { "location": "79/TALK"   , "narrator": "千羽鶴", "text": "――にする。"},
        { "location": "81/ACT"    , "narrator": "", "text": "真実より千羽鶴とゴールしたい"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "それは大丈夫。\n心配しなくても\nゴールできるから。"},
        { "location": "84/TALK"   , "narrator": "千羽鶴", "text": "というわけで。\n早速だけど、前回の\n観測結果を報告する。"},
        { "location": "85/TALK"   , "narrator": "千羽鶴", "text": "貴方の世界の時間における\n17年7月11日10:18時点の\n観測結果としては――"},
        { "location": "86/TALK"   , "narrator": "千羽鶴", "text": "『彼女の為に世界を犠牲に\nする』が88.15331%。"},
        { "location": "87/TALK"   , "narrator": "千羽鶴", "text": "『世界の為に彼女を犠牲に\nする』が11.84669%。"},
        { "location": "88/TALK"   , "narrator": "千羽鶴", "text": "そして、"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "『彼女の為に千羽鶴を\n犠牲にする』との回答は\n73.65854%。"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "『千羽鶴の為に彼女を\n犠牲にする』との回答は\n26.34146%。"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "という結果が出た。\nさて……。"},
        { "location": "94/TALK"   , "narrator": "千羽鶴", "text": "貴方は最終的には、\n『彼女の為に世界を犠牲に\nする』及び――"},
        { "location": "97/TALK"   , "narrator": "千羽鶴", "text": "貴方は最終的には、\n『世界の為に彼女を犠牲に\nする』及び――"},
        { "location": "100/TALK"  , "narrator": "千羽鶴", "text": "貴方は\n無選択という選択を\n貫いたわけだけど。"},
        { "location": "103/TALK"  , "narrator": "千羽鶴", "text": "『彼女の為に千羽鶴を\n犠牲にする』を選択した\nわけだけど。"},
        { "location": "106/TALK"  , "narrator": "千羽鶴", "text": "『千羽鶴の為に彼女を\n犠牲にする』を選択した\nわけだけど。"},
        { "location": "110/TALK"  , "narrator": "千羽鶴", "text": "この結果について\nどう思う？"},
        { "location": "111/SEL"   , "narrator": "", "text": "思った通りだった"},
        { "location": "112/SEL"   , "narrator": "", "text": "想像出来ない結果だった"},
        { "location": "113/ACT"   , "narrator": "", "text": "思った通りだった"},
        { "location": "114/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "115/TALK"  , "narrator": "千羽鶴", "text": "ということは…"},
        { "location": "117/TALK"  , "narrator": "千羽鶴", "text": "貴方は結果を予測しつつも\n自分としては、個としては\n参加しなかった。"},
        { "location": "119/TALK"  , "narrator": "千羽鶴", "text": "貴方は自分が\nマジョリティであることを\n予測していた。"},
        { "location": "121/TALK"  , "narrator": "千羽鶴", "text": "貴方は自分が\nちょっとした異端である\nことを予測していた。"},
        { "location": "123/TALK"  , "narrator": "千羽鶴", "text": "貴方は自分が\nちょっとした異端である\nことを予測していた。"},
        { "location": "125/TALK"  , "narrator": "千羽鶴", "text": "貴方は自分が完全なる\nマイノリティであることを\n予測していた。"},
        { "location": "127/ACT"   , "narrator": "", "text": "想像出来ない結果だった"},
        { "location": "128/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "129/TALK"  , "narrator": "千羽鶴", "text": "ということは…"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "貴方は総意の動きが\n予測できず、自らの\n結論を出せなかった？"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "貴方は自分が\nマジョリティであることを\n自覚していなかった？"},
        { "location": "135/TALK"  , "narrator": "千羽鶴", "text": "貴方は自分が\nちょっとした異端である\nことを自覚できなかった？"},
        { "location": "137/TALK"  , "narrator": "千羽鶴", "text": "貴方は自分が\nちょっとした異端である\nことを自覚できなかった？"},
        { "location": "139/TALK"  , "narrator": "千羽鶴", "text": "貴方は自分が完全なる\nマイノリティであることを\n自覚していなかった？"},
        { "location": "143/TALK"  , "narrator": "千羽鶴", "text": "何にせよ、\n貴方はこの観測調査を\nボイコットした。"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "もちろんそれは、己の\n信念によるものであり、\nとても素晴らしいこと。"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "けど、私からすれば\n観測不能事象は、最も\n注意すべき存在になる。"},
        { "location": "146/TALK"  , "narrator": "千羽鶴", "text": "なぜなら、最後の最後まで\nどこに転がっていくのか\n全くわからないから。"},
        { "location": "148/TALK"  , "narrator": "千羽鶴", "text": "そんな貴方に私は、\nこの称号を\n与えたいと思う。"},
        { "location": "151/TALK"  , "narrator": "千羽鶴", "text": "<color=red><size=40>『不確定性原理ちゃん』</size></color>"},
        { "location": "156/TALK"  , "narrator": "千羽鶴", "text": "何にせよ、貴方が選んだ\n結果は、非常に多くの\n個体が選んだものだった。"},
        { "location": "157/TALK"  , "narrator": "千羽鶴", "text": "もちろん、貴方がこの\n結論を選んだことは、\n私には嬉しいこと。"},
        { "location": "158/TALK"  , "narrator": "千羽鶴", "text": "開始当初からずっと伝えて\nきていたビジョンを、共に\n創っている証だから。"},
        { "location": "160/TALK"  , "narrator": "千羽鶴", "text": "というわけで、貴方には\nこの称号を与えたい。"},
        { "location": "163/TALK"  , "narrator": "千羽鶴", "text": "<color=red><size=40>『心の友！』</size></color>"},
        { "location": "168/TALK"  , "narrator": "千羽鶴", "text": "そして貴方は、\nとても不思議な回答を\nした個体と言える。"},
        { "location": "169/TALK"  , "narrator": "千羽鶴", "text": "心理的に見て、彼女と世界\nでは世界、彼女と千羽鶴\nでは彼女を選ぶのは――"},
        { "location": "172/TALK"  , "narrator": "千羽鶴", "text": "<size=40>相当ヘン！</size>"},
        { "location": "173/TALK"  , "narrator": "千羽鶴", "text": "あ、もしくは、\nそこまで私のことが\n嫌いということ？"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、貴方の\n思考には大変興味がある。"},
        { "location": "176/TALK"  , "narrator": "千羽鶴", "text": "そんな貴方には、\nこの称号を送りつける。"},
        { "location": "179/TALK"  , "narrator": "千羽鶴", "text": "<color=red><size=40>『脳体サンプル候補』</size></color>"},
        { "location": "184/TALK"  , "narrator": "千羽鶴", "text": "そして貴方は、\nとても残酷な回答を\nしている。"},
        { "location": "185/TALK"  , "narrator": "千羽鶴", "text": "世界が千羽鶴に変わった\nだけで、守る対象が\n変わるということは。"},
        { "location": "186/TALK"  , "narrator": "千羽鶴", "text": "あなたの中で、それだけ\n彼女が軽いものなのか、\nそれとも私が重いのか。"},
        { "location": "187/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、トレーナー\nとしての力不足を\n自覚せざるを得ない。"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "というわけで、貴方には\nこの称号を背負わせる。"},
        { "location": "192/TALK"  , "narrator": "千羽鶴", "text": "<color=red><size=40>『千羽鶴泣かせ』</size></color>"},
        { "location": "197/TALK"  , "narrator": "千羽鶴", "text": "何にせよ、貴方が選んだ\n結果は、大勢のそれとは\n全く正反対だった。"},
        { "location": "198/TALK"  , "narrator": "千羽鶴", "text": "すなわち貴方は、\n生粋のマイノリティ\nということになる。"},
        { "location": "199/TALK"  , "narrator": "千羽鶴", "text": "けど決して\n悲観してはいけない。"},
        { "location": "200/TALK"  , "narrator": "千羽鶴", "text": "貴方の回答は\n世界にとっては大変重要。"},
        { "location": "201/TALK"  , "narrator": "千羽鶴", "text": "なぜならば、世界は\n貴方のような人を\n絶対的に欲しているから。"},
        { "location": "202/TALK"  , "narrator": "千羽鶴", "text": "貴方のような人がいて\n始めて世界は安定し、\nバランスを保てる。"},
        { "location": "204/TALK"  , "narrator": "千羽鶴", "text": "というわけで、貴方には\nこの称号を授ける。"},
        { "location": "207/TALK"  , "narrator": "千羽鶴", "text": "<color=red><size=40>『悲劇のバランサー』</size></color>"},
        { "location": "214/TALK"  , "narrator": "千羽鶴", "text": "とまあ、\n貴方個人について色々\nコメントはしたけども。"},
        { "location": "215/TALK"  , "narrator": "千羽鶴", "text": "正直、個としての結果に\n興味はない。"},
        { "location": "216/TALK"  , "narrator": "千羽鶴", "text": "ここで私から\n総体の結果に対して\n簡単にコメントをする。"},
        { "location": "217/TALK"  , "narrator": "千羽鶴", "text": "結果全体としては、\n少なくとも私と世界全体に\nとって悪い方向ではない。"},
        { "location": "218/TALK"  , "narrator": "千羽鶴", "text": "けど、当初想定していた\nよりも極端な結果になって\nいることは気になってる。"},
        { "location": "219/TALK"  , "narrator": "千羽鶴", "text": "世の中では、どのような\nこともバランスを欠いて\nしまえば狂気になる。"},
        { "location": "220/TALK"  , "narrator": "千羽鶴", "text": "それが例え、ポジティブな\nものであっても、正義と\n言われるものであっても。"},
        { "location": "221/TALK"  , "narrator": "千羽鶴", "text": "だから私の結論としては、\n当初よりも計画を早めて\n行かねばと考える。"},
        { "location": "222/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、\nこれは私の問題。"},
        { "location": "223/TALK"  , "narrator": "千羽鶴", "text": "今回はひとまず\nこの結果を元に\n今後について検討する。"},
        { "location": "224/TALK"  , "narrator": "千羽鶴", "text": "また貴方に協力を依頼する\nこともあるかもしれない\nけど、その時はよろしく。"},
        { "location": "225/TALK"  , "narrator": "千羽鶴", "text": "あ、あと一応忠告。"},
        { "location": "226/TALK"  , "narrator": "千羽鶴", "text": "１つ前に戻り、選択を\nし直せば、貴方への\n個として印象は変わる。"},
        { "location": "227/TALK"  , "narrator": "千羽鶴", "text": "けど、大勢としての\n今後への道筋が変わる\nことはない。"},
        { "location": "228/TALK"  , "narrator": "千羽鶴", "text": "そのことだけは、\n先に伝えておこうと思う。"},
        { "location": "229/TALK"  , "narrator": "千羽鶴", "text": "さて、何にしても\nお疲れさま。そして\nご協力ありがと。"},
        { "location": "230/TALK"  , "narrator": "千羽鶴", "text": "というわけで、お礼に\n次回は貴方に素敵なものを\nプレゼントしようと思う。"},
        { "location": "231/SEL"   , "narrator": "", "text": "なに！？"},
        { "location": "232/SEL"   , "narrator": "", "text": "もしかして……"},
        { "location": "233/ACT"   , "narrator": "", "text": "なに！？"},
        { "location": "234/ACT"   , "narrator": "", "text": "もしかして……"},
        { "location": "238/TALK"  , "narrator": "千羽鶴", "text": "次回！衝撃のガブリエラ\nミュージックビデオ回！\n略して――"},
        { "location": "242/SEL"   , "narrator": "", "text": "キター！！"},
        { "location": "243/SEL"   , "narrator": "", "text": "ガブちゃんは天使！"},
        { "location": "244/SEL"   , "narrator": "", "text": "前も言ったけど略す必要ある？"},
        { "location": "245/ACT"   , "narrator": "", "text": "キター！！"},
        { "location": "246/TALK"  , "narrator": "千羽鶴", "text": "喜んでもらえて何より。"},
        { "location": "247/ACT"   , "narrator": "", "text": "ガブちゃんは天使！"},
        { "location": "248/TALK"  , "narrator": "千羽鶴", "text": "…そ、そうね。"},
        { "location": "249/ACT"   , "narrator": "", "text": "前も言ったけど略す必要ある？"},
        { "location": "250/TALK"  , "narrator": "千羽鶴", "text": "黙れ。"},
        { "location": "258/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n好評につき第二回目、\nガブリエラを用意した。"},
        { "location": "259/TALK"  , "narrator": "千羽鶴", "text": "前回の國政綾水では\n色っぽさやアダルトさに\nスポットを当てたけど――"},
        { "location": "262/TALK"  , "narrator": "千羽鶴", "text": "今回は彼女らしい\n健康的な可愛さに\n焦点を当てている。"},
        { "location": "263/TALK"  , "narrator": "千羽鶴", "text": "そして今回も、BGMは\n彼女自身が歌っている。\nしかも――"},
        { "location": "270/TALK"  , "narrator": "千羽鶴", "text": "<color=red>歌詞の７割が\nポーランド語！</color>"},
        { "location": "271/SEL"   , "narrator": "", "text": "スゲー！！"},
        { "location": "272/SEL"   , "narrator": "", "text": "それ鬼でしょ"},
        { "location": "273/ACT"   , "narrator": "", "text": "スゲー！！"},
        { "location": "274/TALK"  , "narrator": "千羽鶴", "text": "そんな感じだから、普段\n殆ど聞けないポーランド語\nを堪能できる。"},
        { "location": "275/ACT"   , "narrator": "", "text": "それ鬼でしょ"},
        { "location": "276/TALK"  , "narrator": "千羽鶴", "text": "ポーランド人が\nポーランド語で歌うのが\nなぜ鬼なのか。"},
        { "location": "277/TALK"  , "narrator": "千羽鶴", "text": "よくわからない。"},
        { "location": "279/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、\n貴重な一本であることに\n間違いはない。"},
        { "location": "282/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n次回はガブリエラを\n十分堪能して欲しい。"},
        { "location": "283/TALK"  , "narrator": "千羽鶴", "text": "今回も同時開催で、\n彼女をより一層愛でられる\n企画もやるから。"},
        { "location": "284/TALK"  , "narrator": "千羽鶴", "text": "この殺伐としたTRI-OSに、\n颯爽と登場するMV回を\nどうぞお楽しみに。"},
        { "location": "285/SEL"   , "narrator": "", "text": "自分で言う？"},
        { "location": "286/ACT"   , "narrator": "", "text": "自分で言う？"},
        { "location": "288/TALK"  , "narrator": "千羽鶴", "text": "もちろん。"},
        { "location": "289/TALK"  , "narrator": "千羽鶴", "text": "さて、それでは\n今回の本編に\n進もうと思う。"},
        { "location": "290/TALK"  , "narrator": "千羽鶴", "text": "まずは\n記録映像を見て欲しい。"},
        { "location": "292/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/69MB 4:24】</color>"},
        { "location": "293/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/23MB 4:24】</color>"},
        { "location": "294/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "295/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/69MB 4:24】</color>"},
        { "location": "296/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "302/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/23MB 4:24】</color>"},
        { "location": "303/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "309/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "310/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "343/TALK"  , "narrator": "千羽鶴", "text": "――というわけで、\nとても楽しそうな\n海回だった。"},
        { "location": "344/TALK"  , "narrator": "千羽鶴", "text": "何かあれば。"},
        { "location": "346/SEL"   , "narrator": "", "text": "ライブで神楽が歌っていた歌のことを教えて！"},
        { "location": "347/SEL"   , "narrator": "", "text": "トライガジェットって太腿についていたの！？"},
        { "location": "348/SEL"   , "narrator": "", "text": "現実世界でもトライナリーとして戦えるの！？"},
        { "location": "349/SEL"   , "narrator": "", "text": "さりげなくNEWクランが登場してなかった？"},
        { "location": "350/SEL"   , "narrator": "", "text": "壁ドンキター！！"},
        { "location": "351/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "352/ACT"   , "narrator": "", "text": "ライブで神楽が歌っていた歌のことを教えて！"},
        { "location": "355/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽がライブで歌って\nいたのは、彼女の\nファーストアルバムの曲。"},
        { "location": "356/TALK"  , "narrator": "千羽鶴", "text": "アルバム名\n『Wishreal』、曲名は\n『第一章・エルカドール』"},
        { "location": "357/TALK"  , "narrator": "千羽鶴", "text": "Wishrealは\nイシュリールと\n読むらしい。"},
        { "location": "358/TALK"  , "narrator": "千羽鶴", "text": "彼女のアルバムには\n全てに物語がある。"},
        { "location": "359/TALK"  , "narrator": "千羽鶴", "text": "Wishrealの場合、重い病に\n冒された母を助けるべく\n魔法を探す少女の物語。"},
        { "location": "360/TALK"  , "narrator": "千羽鶴", "text": "全編を通して見ると\nわかるけど、かなり\nポジティブな作品。"},
        { "location": "361/SEL"   , "narrator": "", "text": "全部聴きたい！"},
        { "location": "362/SEL"   , "narrator": "", "text": "どこかで聞いたような設定"},
        { "location": "363/SEL"   , "narrator": "", "text": "ポジティブな作品の解説なのに、この背景絵を使うとか"},
        { "location": "364/ACT"   , "narrator": "", "text": "全部聴きたい！"},
        { "location": "365/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "366/TALK"  , "narrator": "千羽鶴", "text": "貴方たちの世界の総意が\nそれを望むなら、そっちで\nアルバム発売もあるかも。"},
        { "location": "367/TALK"  , "narrator": "千羽鶴", "text": "その時は物語も込みで、\n彼女の心理的なものを\n察するといいと思う。"},
        { "location": "368/ACT"   , "narrator": "", "text": "どこかで聞いたような設定"},
        { "location": "369/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "370/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽が描く物語は\n一定の法則を\n持っているように思える。"},
        { "location": "371/TALK"  , "narrator": "千羽鶴", "text": "あくまでこれは\n私見ではあるけど。"},
        { "location": "372/TALK"  , "narrator": "千羽鶴", "text": "けど、人は誰しも\nフラットにどんなお話でも\n描けるわけじゃない。"},
        { "location": "373/TALK"  , "narrator": "千羽鶴", "text": "それは主に幼少期の\n原体験が元になり、\n無意識に傾向が作られる。"},
        { "location": "374/TALK"  , "narrator": "千羽鶴", "text": "彼女にもそれが\n当てはまるだけ。"},
        { "location": "375/TALK"  , "narrator": "千羽鶴", "text": "ただ、ここ以外でも\n彼女の描いた物語を\n見たことがあるならば――"},
        { "location": "376/TALK"  , "narrator": "千羽鶴", "text": "それらを組み合わせる\nことで、彼女のココロの\n言葉が聞けるかも。"},
        { "location": "377/ACT"   , "narrator": "", "text": "ポジティブな作品の解説なのに、この背景絵を使うとか"},
        { "location": "378/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "379/TALK"  , "narrator": "千羽鶴", "text": "これはいわゆる一つの\n情報操作とも言える。"},
        { "location": "380/TALK"  , "narrator": "千羽鶴", "text": "さりげなく不自然なものを\n配置しておくことで、\n心の内側から作用させる。"},
        { "location": "381/TALK"  , "narrator": "千羽鶴", "text": "違和感はあっても、\n今回の様に問い合わせる\n先が無い場合。"},
        { "location": "382/TALK"  , "narrator": "千羽鶴", "text": "それが重大なことで\nなければ、いずれ興味は\nなくなっていく。"},
        { "location": "383/TALK"  , "narrator": "千羽鶴", "text": "しかしその時のイメージは\n後々までココロの中に\n刻まれる。"},
        { "location": "384/TALK"  , "narrator": "千羽鶴", "text": "だから、後で思い出した\nとき、無意識にその\nイメージに引っ張られる。"},
        { "location": "385/TALK"  , "narrator": "千羽鶴", "text": "情報操作とは、そうやって\n潜在意識に訴えかける\nことで行われる。"},
        { "location": "386/TALK"  , "narrator": "千羽鶴", "text": "今回はそれを伝える為に\n敢えて分かりやすい題材と\n回答の用意もした。"},
        { "location": "387/TALK"  , "narrator": "千羽鶴", "text": "でも日常には、\nそういったものが\n溢れている。"},
        { "location": "388/TALK"  , "narrator": "千羽鶴", "text": "注意して\n見てみるといいかも。"},
        { "location": "392/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "394/ACT"   , "narrator": "", "text": "トライガジェットって太腿についていたの！？"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "そこに気づくとは、\n貴方足フェチ？"},
        { "location": "398/TALK"  , "narrator": "千羽鶴", "text": "冗談はさておき。"},
        { "location": "399/TALK"  , "narrator": "千羽鶴", "text": "貴方の言う通り、\nトライガジェットは\n足に巻き付いてる。"},
        { "location": "400/TALK"  , "narrator": "千羽鶴", "text": "これはいわゆる\n電話やルーターでいう\nところの親機にあたる。"},
        { "location": "401/TALK"  , "narrator": "千羽鶴", "text": "これ自体に何か機能が\nあるわけではないけど――"},
        { "location": "402/TALK"  , "narrator": "千羽鶴", "text": "トライリンカや専用の\nスマホと連携し、\n様々な機能を与える。"},
        { "location": "403/SEL"   , "narrator": "", "text": "外すことはできないの？"},
        { "location": "404/ACT"   , "narrator": "", "text": "外すことはできないの？"},
        { "location": "406/TALK"  , "narrator": "千羽鶴", "text": "もちろんできる。"},
        { "location": "407/TALK"  , "narrator": "千羽鶴", "text": "けど、彼女たちは\nあまり外したがらない。"},
        { "location": "408/SEL"   , "narrator": "", "text": "なんで？"},
        { "location": "409/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "411/TALK"  , "narrator": "千羽鶴", "text": "そういう風に\nできてるから。"},
        { "location": "414/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "416/ACT"   , "narrator": "", "text": "現実世界でもトライナリーとして戦えるの！？"},
        { "location": "417/TALK"  , "narrator": "千羽鶴", "text": "驚く気持ちはよくわかる。"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "実際はといえば、\nシミュレーションモード\nとして機能させてる。"},
        { "location": "421/TALK"  , "narrator": "千羽鶴", "text": "トライガジェットは元々、\nフェノメノンという\n非現実空間に対する武器。"},
        { "location": "422/TALK"  , "narrator": "千羽鶴", "text": "その為、仮想的に\nフェノメノンに近い状態を\n作り出せばいい。"},
        { "location": "423/SEL"   , "narrator": "", "text": "そんなことできるの！？"},
        { "location": "424/ACT"   , "narrator": "", "text": "そんなことできるの！？"},
        { "location": "426/TALK"  , "narrator": "千羽鶴", "text": "あくまで「仮想的」に。\n例えるならば――"},
        { "location": "427/TALK"  , "narrator": "千羽鶴", "text": "本物の戦争と、\nVRのFPSとの差に近い。"},
        { "location": "428/TALK"  , "narrator": "千羽鶴", "text": "あ、一応説明すると、\nVRは仮想現実。\nバーチャルリアリティ。"},
        { "location": "429/TALK"  , "narrator": "千羽鶴", "text": "FPSは、自分視点による\n仮想空間系のゲーム。\n戦争がよく題材になる。"},
        { "location": "430/TALK"  , "narrator": "千羽鶴", "text": "すなわち、フェノメノンを\n再現しているのではなく、\nあくまで計算してるだけ。"},
        { "location": "431/TALK"  , "narrator": "千羽鶴", "text": "もっと端的に言えば、\nトライガジェットを使える\nゲームプログラム。"},
        { "location": "432/TALK"  , "narrator": "千羽鶴", "text": "これで理解できる？"},
        { "location": "435/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "437/ACT"   , "narrator": "", "text": "さりげなくNEWクランが登場してなかった？"},
        { "location": "438/TALK"  , "narrator": "千羽鶴", "text": "さすがね。\nほんの一瞬なのに\nよく気づいた。"},
        { "location": "441/TALK"  , "narrator": "千羽鶴", "text": "この子は新入りのクラン。\n名前は【クランネフェル】\nという。"},
        { "location": "442/TALK"  , "narrator": "千羽鶴", "text": "名前にクランって\n入ってるけど、特別な\n何かがあるわけではない。"},
        { "location": "443/TALK"  , "narrator": "千羽鶴", "text": "そして、元気ッ子ぽい\nけど、持っている想いは\nとても重い。"},
        { "location": "444/SEL"   , "narrator": "", "text": "シャキーン！"},
        { "location": "445/ACT"   , "narrator": "", "text": "シャキーン！"},
        { "location": "447/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "448/TALK"  , "narrator": "千羽鶴", "text": "別にダジャレを言った\nつもりはない。"},
        { "location": "449/TALK"  , "narrator": "千羽鶴", "text": "話を続ける。"},
        { "location": "450/TALK"  , "narrator": "千羽鶴", "text": "彼女は生まれつき心臓が\n弱い子が発症したクラン。"},
        { "location": "451/SEL"   , "narrator": "", "text": "まあよくある設定かな"},
        { "location": "452/SEL"   , "narrator": "", "text": "既に激重なんですけど"},
        { "location": "453/ACT"   , "narrator": "", "text": "まあよくある設定かな"},
        { "location": "454/TALK"  , "narrator": "千羽鶴", "text": "最後まで聞いて。"},
        { "location": "455/ACT"   , "narrator": "", "text": "既に激重なんですけど"},
        { "location": "456/TALK"  , "narrator": "千羽鶴", "text": "そうね。クランの中でも\n最もヘヴィかもしれない。"},
        { "location": "458/TALK"  , "narrator": "千羽鶴", "text": "彼女は心臓移植を待って\nいたんだけど、金持ちの\n息子に横取りされた。"},
        { "location": "459/TALK"  , "narrator": "千羽鶴", "text": "それがショックで彼女の\n母は、あまり笑わなく\nなってしまった。"},
        { "location": "460/TALK"  , "narrator": "千羽鶴", "text": "毎日ヘリポートに行き、\n来ないとわかっても心臓が\n到着するのを待つ母。"},
        { "location": "461/TALK"  , "narrator": "千羽鶴", "text": "そんな母を見て、彼女は\n自分の身体が弱いせい\nだと罪の意識に苛まれる。"},
        { "location": "462/TALK"  , "narrator": "千羽鶴", "text": "そして、子供らしい\n純粋な気持ちで発症した\n彼女のクランは――"},
        { "location": "463/TALK"  , "narrator": "千羽鶴", "text": "病院を廃墟にし、金持ちの\n息子を捕まえ、心臓を取り\n返すべく数々の罠を張る。"},
        { "location": "464/TALK"  , "narrator": "千羽鶴", "text": "でもそれは、男の子の\nことを恨んでいたから\nではなかった。"},
        { "location": "465/TALK"  , "narrator": "千羽鶴", "text": "全ては彼女の母に、\n笑顔になって欲しいが為。\nただそれだけ。"},
        { "location": "466/TALK"  , "narrator": "千羽鶴", "text": "純粋な子供の心故に、\nとても残酷な\nフェノメノンだった。"},
        { "location": "467/SEL"   , "narrator": "", "text": "　"},
        { "location": "468/SEL"   , "narrator": "", "text": "見たかった"},
        { "location": "469/ACT"   , "narrator": "", "text": "　"},
        { "location": "470/TALK"  , "narrator": "千羽鶴", "text": "言葉にならない？\nよくわかる。"},
        { "location": "471/ACT"   , "narrator": "", "text": "見たかった"},
        { "location": "472/TALK"  , "narrator": "千羽鶴", "text": "そう。\nそれは残念。"},
        { "location": "474/TALK"  , "narrator": "千羽鶴", "text": "このクラン戦については\n記録映像には残してない。"},
        { "location": "475/TALK"  , "narrator": "千羽鶴", "text": "理由は察して。"},
        { "location": "476/TALK"  , "narrator": "千羽鶴", "text": "まあ、いずれ別の場所で\nこの子の素性も明かされる\nことになると思う。"},
        { "location": "477/TALK"  , "narrator": "千羽鶴", "text": "興味がある人は、その時に\n見てみるといい。"},
        { "location": "480/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "482/ACT"   , "narrator": "", "text": "壁ドンキター！！"},
        { "location": "483/TALK"  , "narrator": "千羽鶴", "text": "壁ドン？"},
        { "location": "484/TALK"  , "narrator": "千羽鶴", "text": "……ああ。"},
        { "location": "487/TALK"  , "narrator": "千羽鶴", "text": "これのこと？"},
        { "location": "488/SEL"   , "narrator": "", "text": "そうです！"},
        { "location": "489/SEL"   , "narrator": "", "text": "$me$も神楽に壁ドンされたい"},
        { "location": "490/SEL"   , "narrator": "", "text": "$me$もつばめに壁ドンしたい"},
        { "location": "491/ACT"   , "narrator": "", "text": "そうです！"},
        { "location": "492/ACT"   , "narrator": "", "text": "$me$も神楽に壁ドンされたい"},
        { "location": "493/ACT"   , "narrator": "", "text": "$me$もつばめに壁ドンしたい"},
        { "location": "497/TALK"  , "narrator": "千羽鶴", "text": "壁"},
        { "location": "498/SEL"   , "narrator": "", "text": "ん？"},
        { "location": "499/ACT"   , "narrator": "", "text": "ん？"},
        { "location": "503/TALK"  , "narrator": "千羽鶴", "text": "<size=40><color=red>どーん！！</color></size>"},
        { "location": "504/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "506/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "508/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "515/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n逢瀬つばめだけど。"},
        { "location": "516/TALK"  , "narrator": "千羽鶴", "text": "今回は、彼女のとある\n一面を見て欲しい。"},
        { "location": "517/TALK"  , "narrator": "千羽鶴", "text": "どちらかというと、\n困っている彼女を助ける\nというよりは――"},
        { "location": "518/TALK"  , "narrator": "千羽鶴", "text": "彼女の考え方について、\n貴方がどう感じるかを\n体験して欲しいから。"},
        { "location": "519/TALK"  , "narrator": "千羽鶴", "text": "今更ではあるけど、\n彼女の思考は平均的な\nそれよりも偏ってる。"},
        { "location": "520/TALK"  , "narrator": "千羽鶴", "text": "それを貴方は共感できるか\nそれとも難しいのか。"},
        { "location": "521/TALK"  , "narrator": "千羽鶴", "text": "私はその答えが知りたい。"},
        { "location": "525/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n國政綾水だけど。"},
        { "location": "526/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラとの関係に\nおいて、貴方に見ておいて\n欲しいものがある。"},
        { "location": "527/TALK"  , "narrator": "千羽鶴", "text": "今回の案件は、\n彼女の悩みを解決する\nものではない。"},
        { "location": "528/TALK"  , "narrator": "千羽鶴", "text": "貴方が、國政綾水の\n行動について、共感\nできるか否かを見たい。"},
        { "location": "529/TALK"  , "narrator": "千羽鶴", "text": "だから、今回は彼女の\n好きなようにやらせて\nその結果を見て欲しい。"},
        { "location": "530/TALK"  , "narrator": "千羽鶴", "text": "私はその答えが知りたい。"},
        { "location": "534/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\nガブリエラだけど。"},
        { "location": "535/TALK"  , "narrator": "千羽鶴", "text": "彼女のアーヤに対する\n感情について、若干の\n軌道修正を依頼したい。"},
        { "location": "536/TALK"  , "narrator": "千羽鶴", "text": "彼女たちは\n互いに尊敬し合い、かつ\n互いに不満も抱いている。"},
        { "location": "537/TALK"  , "narrator": "千羽鶴", "text": "それはとても絶妙な\nバランスで\n成り立っているのだけど。"},
        { "location": "538/TALK"  , "narrator": "千羽鶴", "text": "今、ガブリエラの中で\nそのバランスが\n崩れかけている。"},
        { "location": "539/TALK"  , "narrator": "千羽鶴", "text": "今ここで崩れてしまうと\n近い未来において、彼女に\n悪い影響が出てしまう。"},
        { "location": "540/TALK"  , "narrator": "千羽鶴", "text": "だから貴方には、彼女の\n乱れた積み木の塔をそっと\nまっすぐにして欲しい。"},
        { "location": "544/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n恋ヶ崎みやびだけど。"},
        { "location": "545/TALK"  , "narrator": "千羽鶴", "text": "目的に忠実に、\n彼女の背中を\n押してあげて欲しい。"},
        { "location": "546/TALK"  , "narrator": "千羽鶴", "text": "その事自体は、特に\n説明する必要もない程\nシンプル。"},
        { "location": "547/TALK"  , "narrator": "千羽鶴", "text": "その時になれば、\n自ずと何をすればいいか\nわかるはず。"},
        { "location": "548/TALK"  , "narrator": "千羽鶴", "text": "ここで１つ――"},
        { "location": "549/TALK"  , "narrator": "千羽鶴", "text": "貴方のことを信頼した上で\nこの世界の摂理について\n少し触れてみる。"},
        { "location": "550/TALK"  , "narrator": "千羽鶴", "text": "今回彼女に促す決意は、\n私にとっては短期的には\n不利益に繋がるもの。"},
        { "location": "551/TALK"  , "narrator": "千羽鶴", "text": "けど、長期的に見た場合、\n彼女にこの行動を取らせる\nことは、とても大事。"},
        { "location": "552/TALK"  , "narrator": "千羽鶴", "text": "全ては計算によって\n導き出された結論。"},
        { "location": "553/TALK"  , "narrator": "千羽鶴", "text": "だから後に、今回の示唆を\n疑問に思うような日が\n来たときには……"},
        { "location": "554/TALK"  , "narrator": "千羽鶴", "text": "今の言葉を\n覚えておいて欲しい。"},
        { "location": "556/TALK"  , "narrator": "千羽鶴", "text": "それと――。"},
        { "location": "557/TALK"  , "narrator": "千羽鶴", "text": "もう気づいてるかも\nしれないけど。"},
        { "location": "558/TALK"  , "narrator": "千羽鶴", "text": "今回から私は、言葉を\nオブラートに包むことを\nやめている。"},
        { "location": "559/TALK"  , "narrator": "千羽鶴", "text": "それは、貴方に私が\nしたいことを、誤解なく\n伝えたいから。"},
        { "location": "560/TALK"  , "narrator": "千羽鶴", "text": "一応ここで改めて、私が\n貴方に協力を要請している\nことについて整理する。"},
        { "location": "561/TALK"  , "narrator": "千羽鶴", "text": "貴方に彼女たちへの\n介入をしてもらっている\n理由は色々あるけど――"},
        { "location": "562/TALK"  , "narrator": "千羽鶴", "text": "１つには、彼女たちや\n私における『最大幸福な\n未来の創造』がある。"},
        { "location": "563/TALK"  , "narrator": "千羽鶴", "text": "毎回無秩序に見える\n私の依頼は、全て\n計算によって行われる。"},
        { "location": "564/TALK"  , "narrator": "千羽鶴", "text": "そしてその宿敵とも\nいうべき事象が、\nバタフライエフェクト。"},
        { "location": "565/TALK"  , "narrator": "千羽鶴", "text": "未来というものは、\n少しの調整で大きく\n逸れてしまうもの。"},
        { "location": "566/TALK"  , "narrator": "千羽鶴", "text": "その為、各刻の分岐点に\nおいて適切に修正し、\n導く必要がある。"},
        { "location": "567/TALK"  , "narrator": "千羽鶴", "text": "私はそれについて、\n貴方に協力を求めている。"},
        { "location": "568/TALK"  , "narrator": "千羽鶴", "text": "けど、勘違いしないで\n欲しいのは、それは手段に\n過ぎず目的ではないこと。"},
        { "location": "569/TALK"  , "narrator": "千羽鶴", "text": "第一、それが目的なら\n私が貴方に――"},
        { "location": "573/TALK"  , "narrator": "千羽鶴", "text": "<size=30><color=red>ある少女たちと\n結婚して欲しい！</color></size>"},
        { "location": "575/TALK"  , "narrator": "千羽鶴", "text": "なんて言ったりする意味が\n全く以てわからなくなる。"},
        { "location": "576/TALK"  , "narrator": "千羽鶴", "text": "この事についてもまた、\nおいおい説明するつもり。"},
        { "location": "577/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\n長くなっちゃったけど、\n今回も彼女をよろしく。"},
        { "location": "578/TALK"  , "narrator": "千羽鶴", "text": "グッドラック。"},
        { "location": "257/DIALOG", "narrator": "Event/Dialog_EventPicWideNW", "text": "ガ ブ リ エ ラ (14) 、 禁 断 の グ ラ ビ ア デ ビ ュ ー 。"},
        { "location": "261/DIALOG", "narrator": "Event/Dialog_EventPicWideNW", "text": "ガ ブ リ エ ラ (14) 、 禁 断 の グ ラ ビ ア デ ビ ュ ー 。"},
