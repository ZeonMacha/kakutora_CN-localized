    [
        { "location": "7/SCENARIO", "narrator": "", "text": "560_帰り道"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "いつもの坂道を歩きながら"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "もしかしたら奇跡が起こるかもって"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "思ったりするのです"},
        { "location": "36/SEL"    , "narrator": "", "text": "その根拠は？"},
        { "location": "37/SEL"    , "narrator": "", "text": "奇跡って何？"},
        { "location": "38/ACT"    , "narrator": "", "text": "その根拠は？"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "奇跡なんだもの"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "根拠なんてないに決まっているわ"},
        { "location": "41/ACT"    , "narrator": "", "text": "奇跡って何？"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "奇跡"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "なんかじゃないかもしれないわ"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "だって貴方は"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "どこか別の世界にいるんだものね"},
        { "location": "49/SEL"    , "narrator": "", "text": "いるね"},
        { "location": "50/SEL"    , "narrator": "", "text": "いないかも"},
        { "location": "51/ACT"    , "narrator": "", "text": "いるね"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "いるのよね"},
        { "location": "54/ACT"    , "narrator": "", "text": "いないかも"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "そうやって私を脅かすのね"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "でもそんなの嘘だって知っていてよ？"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "だからね"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "ひょっとしたら"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "いつもの坂道で"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "$handle$に会うことがあるかもしれないって"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "思ったりするのよ"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "おかしいかしら？"},
        { "location": "65/SEL"    , "narrator": "", "text": "いつか会えるよ"},
        { "location": "66/SEL"    , "narrator": "", "text": "この前会ったよね"},
        { "location": "67/ACT"    , "narrator": "", "text": "いつか会えるよ"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "きっと"},
        { "location": "70/ACT"    , "narrator": "", "text": "この前会ったよね"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "嘘"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "嘘よね"},
        { "location": "76/SEL"    , "narrator": "", "text": "嘘だよ"},
        { "location": "77/SEL"    , "narrator": "", "text": "夢の中で会ったよね"},
        { "location": "78/ACT"    , "narrator": "", "text": "嘘だよ"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "もう！"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "びっくりさせないでちょうだい"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "私が気がつかないわけがないでしょう？"},
        { "location": "82/ACT"    , "narrator": "", "text": "夢の中で会ったよね"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "やだ"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "夢に見るほど私のこと・・・"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "もし町で私を見かけたとしても"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "絶対に"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "絶対に"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "絶対に声をかけないでちょうだいね"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "$handle$のこと"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "絶対に"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "見つけてみせるから"},
        { "location": "108/TALK"  , "narrator": "ボイスメール", "text": "いつかきっと、そしてずっと"},
        { "location": "88/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "120/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【ガブリエラ】</color>のボイスメール\n<color=red>【いつかきっと、そしてずっと】</color>\nをゲットしました！"}
    ]
