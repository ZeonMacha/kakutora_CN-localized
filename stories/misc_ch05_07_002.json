    "entry":
    [
        { "location": "1092/SCENARIO", "narrator": "", "text": "少女達の進化論"},
        { "location": "1117/TALK"    , "narrator": "神楽", "text": "なんかね？"},
        { "location": "1118/TALK"    , "narrator": "神楽", "text": "昔はアキバにはメイド以外の女子が存在しなかったそうですよ？"},
        { "location": "1120/SEL"     , "narrator": "", "text": "えっマジ！？"},
        { "location": "1121/SEL"     , "narrator": "", "text": "そんな昔の話でもないけど…"},
        { "location": "1122/SEL"     , "narrator": "", "text": "いい時代になってよかったね★"},
        { "location": "1123/ACT"     , "narrator": "", "text": "えっマジ！？"},
        { "location": "1124/TALK"    , "narrator": "神楽", "text": "マジの"},
        { "location": "1125/TALK"    , "narrator": "神楽", "text": "ガチの"},
        { "location": "1126/TALK"    , "narrator": "神楽", "text": "本気"},
        { "location": "1127/ACT"     , "narrator": "", "text": "そんな昔の話でもないけど…"},
        { "location": "1128/TALK"    , "narrator": "神楽", "text": "あ"},
        { "location": "1129/TALK"    , "narrator": "神楽", "text": "知ってるんだ$handlek$"},
        { "location": "1130/TALK"    , "narrator": "神楽", "text": "やべえな$handlek$"},
        { "location": "1131/ACT"     , "narrator": "", "text": "いい時代になってよかったね★"},
        { "location": "1133/TALK"    , "narrator": "神楽", "text": "本当そう、、、"},
        { "location": "1134/TALK"    , "narrator": "神楽", "text": "意味わからなさすぎなんですけど"},
        { "location": "1135/TALK"    , "narrator": "神楽", "text": "鎖国でもしてたのかなって"},
        { "location": "1137/TALK"    , "narrator": "神楽", "text": "まあそんな場所だったアキバも"},
        { "location": "1138/TALK"    , "narrator": "神楽", "text": "今ではクールジャパンの中心地"},
        { "location": "1139/TALK"    , "narrator": "神楽", "text": "渋谷のスクランブル交差点並みにセカイが注目してる"},
        { "location": "1141/SEL"     , "narrator": "", "text": "それはどうだろう…"},
        { "location": "1142/SEL"     , "narrator": "", "text": "$me$は常に神楽に注目してる"},
        { "location": "1143/SEL"     , "narrator": "", "text": "行かない人は行かない場所だよｗ"},
        { "location": "1144/ACT"     , "narrator": "", "text": "それはどうだろう…"},
        { "location": "1145/TALK"    , "narrator": "神楽", "text": "いやしてるし！！！"},
        { "location": "1146/TALK"    , "narrator": "神楽", "text": "否定するなし！！！"},
        { "location": "1147/ACT"     , "narrator": "", "text": "$me$は常に神楽に注目してる"},
        { "location": "1149/TALK"    , "narrator": "神楽", "text": "やだ（トゥンク…）"},
        { "location": "1151/TALK"    , "narrator": "神楽", "text": "ってなると思いましたか？"},
        { "location": "1152/TALK"    , "narrator": "神楽", "text": "なっちゃうんですよね、、、"},
        { "location": "1153/TALK"    , "narrator": "神楽", "text": "トゥンクって、、、"},
        { "location": "1154/ACT"     , "narrator": "", "text": "行かない人は行かない場所だよｗ"},
        { "location": "1155/TALK"    , "narrator": "神楽", "text": "確かに"},
        { "location": "1156/TALK"    , "narrator": "神楽", "text": "それは否定しないけど"},
        { "location": "1158/TALK"    , "narrator": "神楽", "text": "その頃のアキバは女子がメイド喫茶に行っても塩対応だったとかがっかりエピしかなくて"},
        { "location": "1159/TALK"    , "narrator": "神楽", "text": "いい時代になったなーって感想しか出てこなかった！"},
        { "location": "1160/TALK"    , "narrator": "神楽", "text": "あ～も～今でよかった～！"}
    ]
}
