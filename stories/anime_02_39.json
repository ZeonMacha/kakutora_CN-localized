{
    "dir": "chap39/daydra/anime_02_39.js",
    "type": "MainStory",
    "info": {
        "story_id": "39201",
        "cid": "ayami",
        "title": "001 アニメーション",
        "sub_title": "フェノメノンの空に"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第39話"},
        { "location": "48/TALK"   , "narrator": "エリカ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "49/TALK"   , "narrator": "エリカ", "text": "今回は、\nどのチャンネルでも\n伝えたいことは同じ。"},
        { "location": "50/TALK"   , "narrator": "エリカ", "text": "それでも、\nもう一度お話を\n聞きたい？"},
        { "location": "52/TALK"   , "narrator": "エリカ", "text": "それとも、一刻も早く\nつばめちゃんに\nアクセスする？"},
        { "location": "54/TALK"   , "narrator": "エリカ", "text": "それとも、一刻も早く\n綾ちゃんにアクセスする？"},
        { "location": "56/TALK"   , "narrator": "エリカ", "text": "それとも、一刻も早く\nガブリエラちゃんに\nアクセスする？"},
        { "location": "58/TALK"   , "narrator": "エリカ", "text": "それとも、一刻も早く\nみやびちゃんに\nアクセスする？"},
        { "location": "61/SEL"    , "narrator": "", "text": "もう一度話を聞く"},
        { "location": "62/SEL"    , "narrator": "", "text": "省略する"},
        { "location": "63/ACT"    , "narrator": "", "text": "もう一度話を聞く"},
        { "location": "64/TALK"   , "narrator": "エリカ", "text": "わかった。\nそれじゃ、少しだけ\n巻き戻しするね？"},
        { "location": "66/ACT"    , "narrator": "", "text": "省略する"},
        { "location": "67/TALK"   , "narrator": "エリカ", "text": "わかった。\nそれじゃ、\nよろしくお願いします。"},
        { "location": "81/TALK"   , "narrator": "赤髪千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "82/TALK"   , "narrator": "赤髪千羽鶴", "text": "それじゃ、わたしから\n少しだけチャンネルの\n説明をしますね。"},
        { "location": "88/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "89/TALK"   , "narrator": "エリカ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "90/TALK"   , "narrator": "エリカ", "text": "前回つばめちゃんから\n聞いてると思うけど――"},
        { "location": "91/TALK"   , "narrator": "エリカ", "text": "フェノメノンの\n維持存続が可能に\nなりました。"},
        { "location": "92/TALK"   , "narrator": "エリカ", "text": "その節は、\nご協力ありがとう\nございました。"},
        { "location": "93/TALK"   , "narrator": "エリカ", "text": "その後は、約束通り\n“彼ら”からの干渉は\n今のところ無い感じかな。"},
        { "location": "94/SEL"    , "narrator": "", "text": "結局“彼ら”のゲームとは、フェノメノン崩壊阻止で合ってたの？"},
        { "location": "95/ACT"    , "narrator": "", "text": "結局“彼ら”のゲームとは、フェノメノン崩壊阻止で合ってたの？"},
        { "location": "97/TALK"   , "narrator": "エリカ", "text": "そう。"},
        { "location": "98/TALK"   , "narrator": "エリカ", "text": "“彼ら”は千羽鶴ちゃんを\n壊し、フェノメノン収束を\n仕掛けた。"},
        { "location": "99/TALK"   , "narrator": "エリカ", "text": "そして、わたしたちと\nあなたが、それを何とか\n出来るか試した。"},
        { "location": "100/TALK"  , "narrator": "エリカ", "text": "結果として収束は\n阻止されて、“彼ら”の\n干渉は止まったの。"},
        { "location": "101/SEL"   , "narrator": "", "text": "でも“今のところは”でしょ？"},
        { "location": "102/ACT"   , "narrator": "", "text": "でも“今のところは”でしょ？"},
        { "location": "104/TALK"  , "narrator": "エリカ", "text": "そうだね。"},
        { "location": "105/TALK"  , "narrator": "エリカ", "text": "“彼ら”がいつまで\nこのフェノメノンを\nそのままにしておくか――"},
        { "location": "106/TALK"  , "narrator": "エリカ", "text": "それはわたしにも\n想像がつかない。"},
        { "location": "107/TALK"  , "narrator": "エリカ", "text": "けど、１００年放置って\nことはないと思うし。\n屁理屈を言えば――"},
        { "location": "108/TALK"  , "narrator": "エリカ", "text": "１秒であっても放置して\nいれば、“条件付閉鎖”の\n約束は守ったと言える。"},
        { "location": "109/SEL"   , "narrator": "", "text": "実は、変わらず絶望的な状況じゃない？"},
        { "location": "110/ACT"   , "narrator": "", "text": "実は、変わらず絶望的な状況じゃない？"},
        { "location": "112/TALK"  , "narrator": "エリカ", "text": "うん。\nだからね、\nわたしは考えたんだよ。"},
        { "location": "113/TALK"  , "narrator": "エリカ", "text": "わたしはここから先、\n当面未来へは進まない\nことにするの！"},
        { "location": "114/SEL"   , "narrator": "", "text": "？？？？？"},
        { "location": "115/ACT"   , "narrator": "", "text": "？？？？？"},
        { "location": "117/TALK"  , "narrator": "エリカ", "text": "……えっと、\nわかりやすく言うと、\nこういうこと。"},
        { "location": "118/TALK"  , "narrator": "エリカ", "text": "過去に遡って出来事を\n調整して、現時点という\n“結果”を変化させる。"},
        { "location": "119/TALK"  , "narrator": "エリカ", "text": "……うーん。\nやっぱり\nわかりにくいよね？"},
        { "location": "120/TALK"  , "narrator": "エリカ", "text": "あ、そうそう。\n既にあなたとわたしで\n一度それ、やってるよ？"},
        { "location": "123/TALK"  , "narrator": "エリカ", "text": "前に、アーケロンが\n爆発した事が\nあったでしょう？"},
        { "location": "124/TALK"  , "narrator": "エリカ", "text": "あの時わたしは、あなたに\n少し過去の綾ちゃんたちに\n介入してもらったよね。"},
        { "location": "125/TALK"  , "narrator": "エリカ", "text": "その結果、\n綾ちゃんたちは助かった。"},
        { "location": "126/TALK"  , "narrator": "エリカ", "text": "それと同じ事を\nロングスパンで\nやっちゃうってこと。"},
        { "location": "129/TALK"  , "narrator": "エリカ", "text": "この修正手法のことを\n『リプレイス』って\n言うんだけどね。"},
        { "location": "131/SEL"   , "narrator": "", "text": "それって、未来を変えるってこと？"},
        { "location": "132/SEL"   , "narrator": "", "text": "今のアーヤたちとは別の世界線に行ってしまうのでは？"},
        { "location": "133/SEL"   , "narrator": "", "text": "そんな事したって、どうせ“彼ら”にはお見通しでしょ？"},
        { "location": "134/SEL"   , "narrator": "", "text": "なるほどわかった！\n<color=blue>（先に進みます）</color>"},
        { "location": "135/ACT"   , "narrator": "", "text": "それって、未来を変えるってこと？"},
        { "location": "136/TALK"  , "narrator": "エリカ", "text": "うーん、\n厳密にはYESでもあるし\nNOでもあるの。"},
        { "location": "137/TALK"  , "narrator": "エリカ", "text": "今現在、すなわち\nこちらの世界の\n2016年9月11日――"},
        { "location": "138/TALK"  , "narrator": "エリカ", "text": "厳密にはもう少しだけ\n時間が進んじゃうけど、\n概ね2016年内、"},
        { "location": "139/TALK"  , "narrator": "エリカ", "text": "ここまでで“観測された\n過去”は、変えることが\nできないの。"},
        { "location": "142/TALK"  , "narrator": "エリカ", "text": "アーケロン爆破で\n具体的に説明すれば\nわかると思うけど――"},
        { "location": "143/TALK"  , "narrator": "エリカ", "text": "あの時も、記録映像で\n観測してしまった部分を\n変える事は出来なかった。"},
        { "location": "144/TALK"  , "narrator": "エリカ", "text": "けど、\n観測されていない部分――"},
        { "location": "145/TALK"  , "narrator": "エリカ", "text": "具体的には、アーケロンの\n中や、道中については、\n後で変えることができた。"},
        { "location": "148/TALK"  , "narrator": "エリカ", "text": "それと同じ事だけが\n今回できることになる。"},
        { "location": "149/TALK"  , "narrator": "エリカ", "text": "だから例えば、元々\nフェノメノンが発生して\nいない現在とか――"},
        { "location": "150/TALK"  , "narrator": "エリカ", "text": "“彼ら”が存在していない\n現在を創ることは\nできない。"},
        { "location": "151/TALK"  , "narrator": "エリカ", "text": "できることは、誰もが\n観測していない過去を\n変えていくこと、"},
        { "location": "152/TALK"  , "narrator": "エリカ", "text": "そしてそれによって、\n過去に些細な違いを\n沢山作っていくこと…。"},
        { "location": "153/TALK"  , "narrator": "エリカ", "text": "そうすることで、結果的に\n今観測されていない部分で\n大きな違いを作れる。"},
        { "location": "154/SEL"   , "narrator": "", "text": "観測されていない部分って、具体的にどこよ？"},
        { "location": "155/SEL"   , "narrator": "", "text": "バタフライエフェクトを逆手に使うってことか！"},
        { "location": "156/ACT"   , "narrator": "", "text": "観測されていない部分って、具体的にどこよ？"},
        { "location": "157/TALK"  , "narrator": "エリカ", "text": "トライナリーのみんなや、\n千羽鶴ちゃん、そして\n神楽ちゃんが知らないこと。"},
        { "location": "158/TALK"  , "narrator": "エリカ", "text": "特に神楽ちゃんは、\n日本に来る前の外の世界を\n知っちゃってる。"},
        { "location": "159/TALK"  , "narrator": "エリカ", "text": "それが、フェノメノン発生\nより前に遡れない理由の\n１つでもあるんだけど。"},
        { "location": "160/ACT"   , "narrator": "", "text": "バタフライエフェクトを逆手に使うってことか！"},
        { "location": "161/TALK"  , "narrator": "エリカ", "text": "そう！　正解！\nすごく的確な理解だよ。"},
        { "location": "163/TALK"  , "narrator": "エリカ", "text": "だから、\n結論から言えば――"},
        { "location": "164/TALK"  , "narrator": "エリカ", "text": "未来を変える、というほど\n変えられないけど、確実に\n変えていく方法、かな。"},
        { "location": "165/TALK"  , "narrator": "エリカ", "text": "他にも何かある？"},
        { "location": "167/ACT"   , "narrator": "", "text": "今のアーヤたちとは別の世界線に行ってしまうのでは？"},
        { "location": "168/TALK"  , "narrator": "エリカ", "text": "それは無いから\n安心して大丈夫。"},
        { "location": "169/TALK"  , "narrator": "エリカ", "text": "でも、逆に言うと――"},
        { "location": "170/TALK"  , "narrator": "エリカ", "text": "この作戦は、別の世界線に\n行けないほど、自由度が\n低いってことなんだけど。"},
        { "location": "171/TALK"  , "narrator": "エリカ", "text": "変えられるのは、\n彼女たちが関わっていない\n過去に限定されるの。"},
        { "location": "172/TALK"  , "narrator": "エリカ", "text": "彼女たちが観測して\nしまった世界は既に\n決まってしまっている。"},
        { "location": "173/TALK"  , "narrator": "エリカ", "text": "変えられるのは、\n彼女たちが知らない\n過去だけなの。"},
        { "location": "174/SEL"   , "narrator": "", "text": "だとしたら、“彼ら”がフェノメノンを壊そうとしたことは変えられないのでは？"},
        { "location": "175/ACT"   , "narrator": "", "text": "だとしたら、“彼ら”がフェノメノンを壊そうとしたことは変えられないのでは？"},
        { "location": "177/TALK"  , "narrator": "エリカ", "text": "そこは大丈夫。"},
        { "location": "178/TALK"  , "narrator": "エリカ", "text": "綾ちゃんたちや、\n千羽鶴ちゃんは、\nそんな事知らないから。"},
        { "location": "179/SEL"   , "narrator": "", "text": "でもエリカは知ってるよね？"},
        { "location": "180/ACT"   , "narrator": "", "text": "でもエリカは知ってるよね？"},
        { "location": "182/TALK"  , "narrator": "エリカ", "text": "そう。\nわたしは知ってる。"},
        { "location": "183/TALK"  , "narrator": "エリカ", "text": "だからこそ、\n“この世界”の内側に\n戻ることができない。"},
        { "location": "184/SEL"   , "narrator": "", "text": "えっと、今何て？"},
        { "location": "185/ACT"   , "narrator": "", "text": "えっと、今何て？"},
        { "location": "187/TALK"  , "narrator": "エリカ", "text": "そこには、今は\n突っ込まないでおいて\n欲しいかな。"},
        { "location": "188/TALK"  , "narrator": "エリカ", "text": "多分、説明するのに\nとても大変だから。"},
        { "location": "189/TALK"  , "narrator": "エリカ", "text": "今わかっていて欲しいのは\nわたしがこの世界の線上に\nいないという事だけ。"},
        { "location": "190/TALK"  , "narrator": "エリカ", "text": "そのお陰で、わたしは\nフェノメノンの内外、\nどちらの観測者でもない。"},
        { "location": "191/TALK"  , "narrator": "エリカ", "text": "実はね……"},
        { "location": "192/TALK"  , "narrator": "エリカ", "text": "わたしが松代に戻ることが\nできなかった理由は、\nこれが理由だったの。"},
        { "location": "193/TALK"  , "narrator": "エリカ", "text": "その時はまだ、具体的に\nこうなるってのは\nわからなかったけど――"},
        { "location": "194/TALK"  , "narrator": "エリカ", "text": "わたしがフェノメノンの\n内側を直に観測しちゃうと\n誰も修正できなくなる。"},
        { "location": "195/TALK"  , "narrator": "エリカ", "text": "その取り返しのつかない\n恐怖から、どうしても\n行けなかったの。"},
        { "location": "196/TALK"  , "narrator": "エリカ", "text": "いざというときに、\n綾ちゃんを\n守れなくなっちゃうから。"},
        { "location": "198/TALK"  , "narrator": "エリカ", "text": "なんだか\n言い訳ばっかりで\nごめんね？"},
        { "location": "199/TALK"  , "narrator": "エリカ", "text": "全て丸く収まっていれば、\nすぐにでも綾ちゃんの所に\n行きたいんだけどね。"},
        { "location": "200/TALK"  , "narrator": "エリカ", "text": "他にも何かある？"},
        { "location": "202/ACT"   , "narrator": "", "text": "そんな事したって、どうせ“彼ら”にはお見通しでしょ？"},
        { "location": "203/TALK"  , "narrator": "エリカ", "text": "そこ。\nそこが大事なんだけどね。"},
        { "location": "204/TALK"  , "narrator": "エリカ", "text": "ひとつ重要なこととして、\n“彼ら”もフェノメノンの\n中が見れるわけじゃない。"},
        { "location": "205/TALK"  , "narrator": "エリカ", "text": "むしろ、殆ど\n見えてないのが\n現状かな。"},
        { "location": "206/TALK"  , "narrator": "エリカ", "text": "確かに“彼ら”は\n千羽鶴ちゃんの行動を\n読んでたとも言える。"},
        { "location": "207/TALK"  , "narrator": "エリカ", "text": "けどそれは、全ての\n計画を知った上での\n高みの見物じゃない。"},
        { "location": "208/TALK"  , "narrator": "エリカ", "text": "少なくとも私が知る\n限りでは、外の人間は\n直接中を覗けない。"},
        { "location": "209/TALK"  , "narrator": "エリカ", "text": "中の様子を\n確認するには――"},
        { "location": "210/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんや、この前の\n刺客のように、直接人を\n送り込むしかない。"},
        { "location": "211/TALK"  , "narrator": "エリカ", "text": "そういう意味でも、\nこれまでの状況は\n良くなかったと思う。"},
        { "location": "212/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんや、刺客を\n中に入れてしまっていた\nわけだから。"},
        { "location": "213/TALK"  , "narrator": "エリカ", "text": "だからリプレイスでは、\nとにかく日本を鎖国状態に\nするとこから始めるの。"},
        { "location": "214/TALK"  , "narrator": "エリカ", "text": "そうすれば、“彼ら”は\nフェノメノンの中を\n一切見られなくなる。"},
        { "location": "215/SEL"   , "narrator": "", "text": "でも神楽のトライガジェットは、外と繋がってるわけでしょ？"},
        { "location": "216/SEL"   , "narrator": "", "text": "でも、鎖国状態になんてできるの？"},
        { "location": "217/ACT"   , "narrator": "", "text": "でも神楽のトライガジェットは、外と繋がってるわけでしょ？"},
        { "location": "218/TALK"  , "narrator": "エリカ", "text": "そうだね。だから、\n神楽ちゃんと話をして、\n外界とは切断する。"},
        { "location": "219/TALK"  , "narrator": "エリカ", "text": "これについてはまた\n後でお話するね。"},
        { "location": "220/ACT"   , "narrator": "", "text": "でも、鎖国状態になんてできるの？"},
        { "location": "221/TALK"  , "narrator": "エリカ", "text": "大変だけど、\n難しいことじゃないよ。"},
        { "location": "222/TALK"  , "narrator": "エリカ", "text": "例えば、ライブで戦った\nテルプシコラが\nそれを証明してる。"},
        { "location": "223/TALK"  , "narrator": "エリカ", "text": "彼女はつばめちゃんを\n一瞬で“同化しない人間”\nだとわかったでしょ？"},
        { "location": "224/TALK"  , "narrator": "エリカ", "text": "フェノメノンを発症した\n本人は、異質な存在を\n見つけることができる。"},
        { "location": "225/TALK"  , "narrator": "エリカ", "text": "特に、侵入してきた瞬間は\n微かに世界の歪むから、\nとても気づきやすい。"},
        { "location": "226/TALK"  , "narrator": "エリカ", "text": "ただ、ちゃんと注意を\n払っていないと\n見逃してしまうの。"},
        { "location": "227/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんが刺客を\n中に入れてしまったのは、\n大きな失敗だったけど――"},
        { "location": "228/TALK"  , "narrator": "エリカ", "text": "恐らく“彼ら”が刺客を\n入れたのはフェノメノンが\n膨張した時だと思う。"},
        { "location": "229/TALK"  , "narrator": "エリカ", "text": "その時千羽鶴ちゃんは\nフュージョンクランに\n全神経を集中させていた。"},
        { "location": "230/TALK"  , "narrator": "エリカ", "text": "だから、その微細な世界の\n歪みに気づかなかったん\nじゃないかと思う。"},
        { "location": "231/TALK"  , "narrator": "エリカ", "text": "リプレイス後は\nそういったことが\n無いようにする。"},
        { "location": "232/TALK"  , "narrator": "エリカ", "text": "具体的には、神楽ちゃんに\n全面協力をしてもらう\nことになるんだけど――"},
        { "location": "233/TALK"  , "narrator": "エリカ", "text": "それはまた後で\n説明するね。"},
        { "location": "234/TALK"  , "narrator": "エリカ", "text": "他にも何かある？"},
        { "location": "237/ACT"   , "narrator": "", "text": "なるほどわかった！\n<color=blue>（先に進みます）</color>"},
        { "location": "239/TALK"  , "narrator": "エリカ", "text": "よかった。"},
        { "location": "240/TALK"  , "narrator": "エリカ", "text": "そういう理由もあって\n$handle$さんには\nもう少し協力して欲しいの。"},
        { "location": "241/TALK"  , "narrator": "エリカ", "text": "今までの全てを見てきた\nあなたがいてくれれば、\n成功率はぐっと上がる。"},
        { "location": "242/SEL"   , "narrator": "", "text": "具体的には、どうするの？"},
        { "location": "243/ACT"   , "narrator": "", "text": "具体的には、どうするの？"},
        { "location": "245/TALK"  , "narrator": "エリカ", "text": "わたしが為し得たい\n結果は、とにかく綾ちゃん\nたちを護ること。"},
        { "location": "247/TALK"  , "narrator": "エリカ", "text": "その為に、最低目標と\n理想目標の\n２つを設定するよ。"},
        { "location": "248/TALK"  , "narrator": "エリカ", "text": "まず、\n最低目標は――"},
        { "location": "249/TALK"  , "narrator": "エリカ", "text": "“彼ら”がこの\nフェノメノンに全く干渉\nできない現在を作ること。"},
        { "location": "250/TALK"  , "narrator": "エリカ", "text": "そして、\n理想目標は――"},
        { "location": "251/TALK"  , "narrator": "エリカ", "text": "その状態で、\nフェノメノンを飛散させ\n内外を１つの世界にし――"},
        { "location": "252/TALK"  , "narrator": "エリカ", "text": "その結果発生する\n“ギャップの衝突”に\n打ち勝つこと。"},
        { "location": "253/SEL"   , "narrator": "", "text": "もうちょっとわかりやすく説明して？"},
        { "location": "254/SEL"   , "narrator": "", "text": "オーケーわかった"},
        { "location": "255/ACT"   , "narrator": "", "text": "もうちょっとわかりやすく説明して？"},
        { "location": "256/TALK"  , "narrator": "エリカ", "text": "あっ、ごめんね……。\nえっと――"},
        { "location": "261/TALK"  , "narrator": "エリカ", "text": "この図を見てください。\nこの図の外はどっちで\n中はどっちでしょう？"},
        { "location": "262/SEL"   , "narrator": "", "text": "青い方が外？"},
        { "location": "263/SEL"   , "narrator": "", "text": "どっちも外となり得る"},
        { "location": "264/ACT"   , "narrator": "", "text": "青い方が外？"},
        { "location": "265/TALK"  , "narrator": "エリカ", "text": "半分正解。\nもう半分は不正解。"},
        { "location": "266/TALK"  , "narrator": "エリカ", "text": "完全正解は、\n『どっちも中であって\n　外である』でした～！"},
        { "location": "267/ACT"   , "narrator": "", "text": "どっちも外となり得る"},
        { "location": "268/TALK"  , "narrator": "エリカ", "text": "正解！\nすごいね！"},
        { "location": "273/TALK"  , "narrator": "エリカ", "text": "人間には観念があって、\n後から出たフェノメノン\nこそが世界の異物――"},
        { "location": "274/TALK"  , "narrator": "エリカ", "text": "消えて然るべきと\n考えがちだよね。"},
        { "location": "275/TALK"  , "narrator": "エリカ", "text": "でも、量子的に言うと、\nフェノメノンとその外側の\n世界は対等なの。"},
        { "location": "276/TALK"  , "narrator": "エリカ", "text": "それらは、矛盾を解消する\nための繭によって隔たれた\n２つの世界でしかない。"},
        { "location": "277/TALK"  , "narrator": "エリカ", "text": "どちらが親でも子でもなく\n強くも弱くもない。"},
        { "location": "278/TALK"  , "narrator": "エリカ", "text": "だから、フェノメノンの\n消滅とは、実は全然\n正常なことではなく――"},
        { "location": "279/TALK"  , "narrator": "エリカ", "text": "世界を１つ\n消滅させていることに\n他ならないんだよ。"},
        { "location": "280/TALK"  , "narrator": "エリカ", "text": "１つの世界線に２つの\n断絶した世界が生まれると\n繭は発生する。"},
        { "location": "281/TALK"  , "narrator": "エリカ", "text": "けど、それを無理矢理\nくっつけてしまうことが\nできれば――"},
        { "location": "282/TALK"  , "narrator": "エリカ", "text": "どちらの世界も\n温存した状態で、１つの\n世界にマージできる。"},
        { "location": "283/TALK"  , "narrator": "エリカ", "text": "これを、\n『蒸着』っていうよ。"},
        { "location": "284/TALK"  , "narrator": "エリカ", "text": "ただし、\nそこには色んな\nデメリットもあるの。"},
        { "location": "285/TALK"  , "narrator": "エリカ", "text": "だから普段は、\nフェノメノン側に\n犠牲になってもらってる。"},
        { "location": "286/TALK"  , "narrator": "エリカ", "text": "この辺のことは、\nこれからおいおい\nわかってくると思う。"},
        { "location": "287/TALK"  , "narrator": "エリカ", "text": "今日説明しても\n概念的な話になっちゃうし\n眠くなっちゃうでしょ？"},
        { "location": "288/ACT"   , "narrator": "", "text": "オーケーわかった"},
        { "location": "289/TALK"  , "narrator": "エリカ", "text": "よかった！"},
        { "location": "291/TALK"  , "narrator": "エリカ", "text": "はぁ……。"},
        { "location": "292/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "293/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "295/TALK"  , "narrator": "エリカ", "text": "なんだかまた\n一人で暴走して\n難しい話しちゃったかも。"},
        { "location": "296/TALK"  , "narrator": "エリカ", "text": "まだ具体的な作戦の\n内容をお話しなくちゃ\nいけないんだけど――"},
        { "location": "297/TALK"  , "narrator": "エリカ", "text": "ちょっと一息ついて\n記録映像を見たりしない？"},
        { "location": "298/TALK"  , "narrator": "エリカ", "text": "“彼ら”からの干渉も\n見られないし、不安定な\n要素も見当たらないから―"},
        { "location": "299/TALK"  , "narrator": "エリカ", "text": "今回は多分、\n安心して見られると\n思うんだ。"},
        { "location": "301/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/104MB 6:43】</color>"},
        { "location": "302/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/35MB 6:43】</color>"},
        { "location": "303/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "304/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/104MB 6:43】</color>"},
        { "location": "305/TALK"  , "narrator": "エリカ", "text": "わかった。"},
        { "location": "311/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/35MB 6:43】</color>"},
        { "location": "312/TALK"  , "narrator": "エリカ", "text": "わかった。"},
        { "location": "318/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "319/TALK"  , "narrator": "エリカ", "text": "あらら。"},
        { "location": "357/TALK"  , "narrator": "赤髪千羽鶴", "text": "こんにちは。"},
        { "location": "358/SEL"   , "narrator": "", "text": "原初のつばめ！？"},
        { "location": "359/SEL"   , "narrator": "", "text": "何その格好！？"},
        { "location": "360/ACT"   , "narrator": "", "text": "原初のつばめ！？"},
        { "location": "361/TALK"  , "narrator": "赤髪千羽鶴", "text": "なんだかすごい\n表現の仕方ですね…。"},
        { "location": "362/ACT"   , "narrator": "", "text": "何その格好！？"},
        { "location": "363/TALK"  , "narrator": "赤髪千羽鶴", "text": "あ、いえ……\nあまり深い意味は……。"},
        { "location": "364/TALK"  , "narrator": "赤髪千羽鶴", "text": "ちょっと寝てるところ\n起こされちゃっただけ\nなんです。"},
        { "location": "367/SEL"   , "narrator": "", "text": "一体どうしたの？"},
        { "location": "368/ACT"   , "narrator": "", "text": "一体どうしたの？"},
        { "location": "370/TALK"  , "narrator": "赤髪千羽鶴", "text": "エリカさんが、\nちょっと急用ができたから\n代わって欲しいって。"},
        { "location": "371/TALK"  , "narrator": "赤髪千羽鶴", "text": "でも、多分これは\nエリカさんの問題じゃ\nなくて――"},
        { "location": "372/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんの\n総意が決めたことなんじゃ\nないかと思ってます。"},
        { "location": "373/SEL"   , "narrator": "", "text": "？？？"},
        { "location": "374/ACT"   , "narrator": "", "text": "？？？"},
        { "location": "376/TALK"  , "narrator": "赤髪千羽鶴", "text": "前回、別れ際にあなたが\n何の気ナシに送った意志、\n覚えてますか？"},
        { "location": "381/TALK"  , "narrator": "赤髪千羽鶴", "text": "これがその結果です。"},
        { "location": "382/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんの\n力は、ご自身が思ってる\n以上に強いんです。"},
        { "location": "383/SEL"   , "narrator": "", "text": "$me$たちの想いが流れを変えたってこと？"},
        { "location": "384/ACT"   , "narrator": "", "text": "$me$たちの想いが流れを変えたってこと？"},
        { "location": "386/TALK"  , "narrator": "赤髪千羽鶴", "text": "少なくともわたしは\nそう思ってます。"},
        { "location": "390/SEL"   , "narrator": "", "text": "また会えて嬉しい"},
        { "location": "391/SEL"   , "narrator": "", "text": "丁度いいから、伝えたいことがあるんだけど"},
        { "location": "392/ACT"   , "narrator": "", "text": "また会えて嬉しい"},
        { "location": "393/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしもです。"},
        { "location": "394/ACT"   , "narrator": "", "text": "丁度いいから、伝えたいことがあるんだけど"},
        { "location": "395/TALK"  , "narrator": "赤髪千羽鶴", "text": "はい、なんでしょう？"},
        { "location": "397/SEL"   , "narrator": "", "text": "千羽鶴が残ってるのはなぜ？　一つに戻ったのでは？"},
        { "location": "398/SEL"   , "narrator": "", "text": "前回「ありがとう」と言われたときちょっと辛かった"},
        { "location": "399/SEL"   , "narrator": "", "text": "自分の決断に何の意味があったのかと苦悩してる"},
        { "location": "400/SEL"   , "narrator": "", "text": "いや、なんでもない\n<color=blue>（先へ進みます）</color>"},
        { "location": "401/ACT"   , "narrator": "", "text": "千羽鶴が残ってるのはなぜ？　一つに戻ったのでは？"},
        { "location": "402/TALK"  , "narrator": "赤髪千羽鶴", "text": "こんな事ばかり言うと、\nなんだかダメな子みたい\nですけど――"},
        { "location": "403/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さん達の\n総意が作り出した\n結果の１つです。"},
        { "location": "404/TALK"  , "narrator": "赤髪千羽鶴", "text": "“パラメトリック理論に\n基づく世界選択法”では\n少数意見も除外されません。"},
        { "location": "405/TALK"  , "narrator": "赤髪千羽鶴", "text": "それぞれの意志の重みと\nその重要性を加味した形で\n全てが尊重されます。"},
        { "location": "406/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、千羽鶴が\n残って欲しいという\n意志、すなわち――"},
        { "location": "407/TALK"  , "narrator": "赤髪千羽鶴", "text": "千羽鶴を愛してくれて、\n消えることを悲しんで\nくれた人がいる限り。"},
        { "location": "408/TALK"  , "narrator": "赤髪千羽鶴", "text": "その想いの強さに応じた\n形で、それは何らかの\n結果を残します。"},
        { "location": "409/TALK"  , "narrator": "赤髪千羽鶴", "text": "それはわたしの\n潜在意識の中に\n残るんです。"},
        { "location": "410/TALK"  , "narrator": "赤髪千羽鶴", "text": "だから、無意識下でわたし\n自身が、千羽鶴という存在\nを残すことを願います。"},
        { "location": "411/TALK"  , "narrator": "赤髪千羽鶴", "text": "それがフェノメノンに\n反映されることは、説明の\n必要ありませんよね？"},
        { "location": "412/TALK"  , "narrator": "赤髪千羽鶴", "text": "他に何かありますか？"},
        { "location": "414/ACT"   , "narrator": "", "text": "前回「ありがとう」と言われたときちょっと辛かった"},
        { "location": "415/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうですね。\nわたしも\n気になってました。"},
        { "location": "416/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんの\n全員が、必ずしも継続を\n願ってたわけではない――"},
        { "location": "417/TALK"  , "narrator": "赤髪千羽鶴", "text": "その中立性を\n完全に欠いていました。"},
        { "location": "418/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、不愉快に\n思われていたら、心から\nお詫び致します。"},
        { "location": "419/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただ、\nあれなんですよね…。"},
        { "location": "420/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたし自身が\n継続を望んでいたので\nそれが先に出てしまって。"},
        { "location": "421/TALK"  , "narrator": "赤髪千羽鶴", "text": "いち個人としての\n意志が先にでてしまう\nなんて、聖女失格です。"},
        { "location": "422/TALK"  , "narrator": "赤髪千羽鶴", "text": "他に何かありますか？"},
        { "location": "424/ACT"   , "narrator": "", "text": "自分の決断に何の意味があったのかと苦悩してる"},
        { "location": "425/TALK"  , "narrator": "赤髪千羽鶴", "text": "その気持ちは\nとてもわかります。"},
        { "location": "427/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんは、\n千羽鶴がセルフクランに\nなる事を望みましたよね。"},
        { "location": "428/TALK"  , "narrator": "赤髪千羽鶴", "text": "そして、一時であれ、\n千羽鶴はわたしの\nセルフに戻りました。"},
        { "location": "429/TALK"  , "narrator": "赤髪千羽鶴", "text": "けど、結果は総意によって\n簡単に覆されてしまった。"},
        { "location": "431/TALK"  , "narrator": "赤髪千羽鶴", "text": "どんなに頑張って\n自分なりに考えて\n決断をしても――"},
        { "location": "432/TALK"  , "narrator": "赤髪千羽鶴", "text": "それは、総意という\n１つの軸に集約されて、\n簡単に覆ってしまう。"},
        { "location": "433/TALK"  , "narrator": "赤髪千羽鶴", "text": "ならば自分の考えに\n何か意味があるのか、\nと悩むと思います。"},
        { "location": "435/TALK"  , "narrator": "赤髪千羽鶴", "text": "けれども、前回も\nお伝えしたように、\n必ず意味があります。"},
        { "location": "436/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんの\n想いは大きな流れで見れば\n覆されたかもですが――"},
        { "location": "437/TALK"  , "narrator": "赤髪千羽鶴", "text": "必ず、その想いの強さと、\n想いを共にする総意の数に\n応じた結果を出します。"},
        { "location": "438/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただ、それは世界の転換に\n関わるようなことでは\nないかもしれません。"},
        { "location": "439/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですが、あなたにとっては\nとても重要なファクターと\nして残るはずです。"},
        { "location": "440/TALK"  , "narrator": "赤髪千羽鶴", "text": "世界は１つですから、\n大きな流れはどうしても\n１つしか存在できません。"},
        { "location": "441/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですが、それはあなたの\n意志が握りつぶされた\n事にはならないんです。"},
        { "location": "442/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、どうか\n信じていてください。"},
        { "location": "443/TALK"  , "narrator": "赤髪千羽鶴", "text": "他に何かありますか？"},
        { "location": "445/ACT"   , "narrator": "", "text": "いや、なんでもない\n<color=blue>（先へ進みます）</color>"},
        { "location": "447/TALK"  , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "449/TALK"  , "narrator": "赤髪千羽鶴", "text": "それでですね。"},
        { "location": "450/TALK"  , "narrator": "赤髪千羽鶴", "text": "エリカさんから\n言付けを\n頼まれてるんです。"},
        { "location": "451/TALK"  , "narrator": "赤髪千羽鶴", "text": "これから実施する、\nリプレイス作戦について\n簡単に説明してって。"},
        { "location": "453/TALK"  , "narrator": "赤髪千羽鶴", "text": "リプレイス作戦は、\n卯月さんが鍵を握ります。"},
        { "location": "454/TALK"  , "narrator": "赤髪千羽鶴", "text": "具体的には、卯月さんの\n干渉チャンネル、第五番を\n解放するためです。"},
        { "location": "455/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんには\n卯月さんのチャンネルに\n干渉してもらい――"},
        { "location": "456/TALK"  , "narrator": "赤髪千羽鶴", "text": "卯月さんに直接、\n様々なアプローチを\nしていただきます。"},
        { "location": "458/TALK"  , "narrator": "赤髪千羽鶴", "text": "アプローチの開始は、\nTRI-OSがあなたに\n干渉した時より少し前。"},
        { "location": "459/TALK"  , "narrator": "赤髪千羽鶴", "text": "すなわち、わたしが\n東京に行く2016年5月より\n少しだけ前からです。"},
        { "location": "460/TALK"  , "narrator": "赤髪千羽鶴", "text": "その結果、バタフライ\nエフェクトが発生し、\n現在の状況、すなわち――"},
        { "location": "461/TALK"  , "narrator": "赤髪千羽鶴", "text": "2016年9月11日現在の\n状況が変わってきます。"},
        { "location": "462/SEL"   , "narrator": "", "text": "“彼ら”はこの事に対して攻撃をしてこないんだろうか"},
        { "location": "463/ACT"   , "narrator": "", "text": "“彼ら”はこの事に対して攻撃をしてこないんだろうか"},
        { "location": "465/TALK"  , "narrator": "赤髪千羽鶴", "text": "わかりません。"},
        { "location": "466/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただ、理論上では\n少なくとも最初の数ヶ月は\n大丈夫だそうです。"},
        { "location": "467/TALK"  , "narrator": "赤髪千羽鶴", "text": "作戦ではまず、\n卯月さんのガジェットを\nチャンネル接続します。"},
        { "location": "468/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただしその前に、\nガジェットの通信経路を\n繭の外から切り離します。"},
        { "location": "469/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうしないと、“彼ら”に\nあなたと卯月さんの通信が\n筒抜けになるからです。"},
        { "location": "470/SEL"   , "narrator": "", "text": "それじゃ作戦が筒抜けじゃん……"},
        { "location": "471/SEL"   , "narrator": "", "text": "それじゃ$me$と神楽の愛の囁きが筒抜けじゃん……"},
        { "location": "472/ACT"   , "narrator": "", "text": "それじゃ作戦が筒抜けじゃん……"},
        { "location": "473/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうなんですよ。"},
        { "location": "474/ACT"   , "narrator": "", "text": "それじゃ$me$と神楽の愛の囁きが筒抜けじゃん……"},
        { "location": "477/TALK"  , "narrator": "赤髪千羽鶴", "text": "<size=40>どーん！</size>"},
        { "location": "478/TALK"  , "narrator": "赤髪千羽鶴", "text": "……失礼しました。"},
        { "location": "480/SEL"   , "narrator": "", "text": "でもそれ、神楽が危険な目に遭うのでは？"},
        { "location": "481/SEL"   , "narrator": "", "text": "でもそれ、神楽にデメリットはないの？"},
        { "location": "482/ACT"   , "narrator": "", "text": "でもそれ、神楽が危険な目に遭うのでは？"},
        { "location": "483/TALK"  , "narrator": "赤髪千羽鶴", "text": "完全に無いとは\n言い切れませんが――"},
        { "location": "484/TALK"  , "narrator": "赤髪千羽鶴", "text": "少なくとも卯月さんの\n大切なものは、全て\n繭の中にあります。"},
        { "location": "485/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、直接護ることが\nできる状況にあります。"},
        { "location": "486/TALK"  , "narrator": "赤髪千羽鶴", "text": "でももし外に、卯月さんの\n弱みになるようなものが\nあるようなら――"},
        { "location": "487/TALK"  , "narrator": "赤髪千羽鶴", "text": "別の方法を\n検討しなければ\nならないかもしれません。"},
        { "location": "488/ACT"   , "narrator": "", "text": "でもそれ、神楽にデメリットはないの？"},
        { "location": "489/TALK"  , "narrator": "赤髪千羽鶴", "text": "うーん……\nそうですね。"},
        { "location": "490/TALK"  , "narrator": "赤髪千羽鶴", "text": "デメリットかどうかは\nわかりませんが。"},
        { "location": "491/TALK"  , "narrator": "赤髪千羽鶴", "text": "回線を切り替えることで\n外との繋がりが\n無くなりますので――"},
        { "location": "492/TALK"  , "narrator": "赤髪千羽鶴", "text": "卯月さんもいずれは\nわたしのフェノメノンに\n同化することになります。"},
        { "location": "494/TALK"  , "narrator": "赤髪千羽鶴", "text": "いずれにせよ、\nもう少し慎重に作戦を\n計画する必要があります。"},
        { "location": "495/TALK"  , "narrator": "赤髪千羽鶴", "text": "幸い、準備には\n若干の時間がかかる\nそうですので。"},
        { "location": "496/SEL"   , "narrator": "", "text": "え！？　どれくらい？"},
        { "location": "497/ACT"   , "narrator": "", "text": "え！？　どれくらい？"},
        { "location": "499/TALK"  , "narrator": "赤髪千羽鶴", "text": "えっと、\nエリカさんが言うには、\n2ヶ月くらいだそうです。"},
        { "location": "500/SEL"   , "narrator": "", "text": "えーーーーーそんなぁ……"},
        { "location": "501/SEL"   , "narrator": "", "text": "頑張って！！"},
        { "location": "502/ACT"   , "narrator": "", "text": "えーーーーーそんなぁ……"},
        { "location": "504/TALK"  , "narrator": "赤髪千羽鶴", "text": "わ、わたしに\n言われましても……。"},
        { "location": "505/TALK"  , "narrator": "赤髪千羽鶴", "text": "エリカさんには\n伝えておきますね。"},
        { "location": "506/ACT"   , "narrator": "", "text": "頑張って！！"},
        { "location": "508/TALK"  , "narrator": "赤髪千羽鶴", "text": "ありがとうございます。\nエリカさんに\n伝えておきますね。"},
        { "location": "510/TALK"  , "narrator": "赤髪千羽鶴", "text": "あ、それとですね――"},
        { "location": "515/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしのチャンネル\nなんですけど。"},
        { "location": "516/TALK"  , "narrator": "赤髪千羽鶴", "text": "現状、安定期に入り\n特に緊急でお願いしたい\nことは無いのですが――"},
        { "location": "517/TALK"  , "narrator": "赤髪千羽鶴", "text": "せっかくなので卯月さんや\n雛ちゃんたちとの話でも\n見ていってください。"},
        { "location": "521/TALK"  , "narrator": "赤髪千羽鶴", "text": "アーヤさんの\nチャンネルなんですけど。"},
        { "location": "522/TALK"  , "narrator": "赤髪千羽鶴", "text": "現状、安定期に入り\n特に緊急でお願いしたい\nことは無いのですが――"},
        { "location": "523/TALK"  , "narrator": "赤髪千羽鶴", "text": "たまには息抜きに、\nちょっとホッコリする\nお話を見てみませんか？"},
        { "location": "524/TALK"  , "narrator": "赤髪千羽鶴", "text": "気が向いたら\nチャンネルにアクセス\nしてみてくださいね。"},
        { "location": "528/TALK"  , "narrator": "赤髪千羽鶴", "text": "ガブちゃんの\nチャンネルなんですけど。"},
        { "location": "529/TALK"  , "narrator": "赤髪千羽鶴", "text": "現状、安定期に入り\n特に緊急でお願いしたい\nことは無いのですが――"},
        { "location": "530/TALK"  , "narrator": "赤髪千羽鶴", "text": "そういえば、珍しく\nみんなで旅行に出かけた\n事がありまして。"},
        { "location": "531/TALK"  , "narrator": "赤髪千羽鶴", "text": "その時のガブちゃんが\nちょっと可愛かったので\nそれを共有しますね。"},
        { "location": "532/TALK"  , "narrator": "赤髪千羽鶴", "text": "気が向いたら\nチャンネルにアクセス\nしてみてください。"},
        { "location": "536/TALK"  , "narrator": "赤髪千羽鶴", "text": "みやびさんの\nチャンネルなんですけど。"},
        { "location": "537/TALK"  , "narrator": "赤髪千羽鶴", "text": "現状、安定期に入り\n特に緊急でお願いしたい\nことは無いのですが――"},
        { "location": "538/TALK"  , "narrator": "赤髪千羽鶴", "text": "あ、いえ、\n見せたいシーンが\nありました！"},
        { "location": "539/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんとの\n新たなる出逢いの\n瞬間です。"},
        { "location": "540/TALK"  , "narrator": "赤髪千羽鶴", "text": "その付近にチャンネルを\n合わせておきますね。"},
        { "location": "541/TALK"  , "narrator": "赤髪千羽鶴", "text": "気が向いたらアクセス\nしてみてください。"},
        { "location": "543/TALK"  , "narrator": "赤髪千羽鶴", "text": "それじゃ……わたしも\nそろそろここから\n立ち去らねばなりません。"},
        { "location": "544/SEL"   , "narrator": "", "text": "またね！"},
        { "location": "545/SEL"   , "narrator": "", "text": "えー！　なんで！？"},
        { "location": "546/ACT"   , "narrator": "", "text": "またね！"},
        { "location": "547/TALK"  , "narrator": "赤髪千羽鶴", "text": "はい、またです！"},
        { "location": "548/ACT"   , "narrator": "", "text": "えー！　なんで！？"},
        { "location": "549/TALK"  , "narrator": "赤髪千羽鶴", "text": "チャンネルを増設したり\n過去からの再計算をしたり\nするためだそうです。"},
        { "location": "550/TALK"  , "narrator": "赤髪千羽鶴", "text": "その為に、TRI-OSは\n何度か再起動をする\nことになります。"},
        { "location": "551/TALK"  , "narrator": "赤髪千羽鶴", "text": "その1回目の再起動が\nもうすぐに行われる\nそうですので――"},
        { "location": "552/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしもここには\nいられなくなります。"},
        { "location": "553/SEL"   , "narrator": "", "text": "残念…"},
        { "location": "554/ACT"   , "narrator": "", "text": "残念…"},
        { "location": "556/TALK"  , "narrator": "赤髪千羽鶴", "text": "またすぐに\n逢えますよ、きっと。"},
        { "location": "558/TALK"  , "narrator": "赤髪千羽鶴", "text": "それでは、\n名残惜しいですが\nこれにて失礼します。"},
        { "location": "559/TALK"  , "narrator": "赤髪千羽鶴", "text": "この世界と\n$handle$さんに\n素敵なココロの旅を。"},
        { "location": "568/SEL"   , "narrator": "", "text": "LOGOUT/."},
        { "location": "609/SEL"   , "narrator": "", "text": "こんにちは"},
        { "location": "610/ACT"   , "narrator": "", "text": "こんにちは"},
        { "location": "614/TALK"  , "narrator": "ソイルトン", "text": "只今システムの再構築中です。この処理には数日程度の時間がかかる見込みです。"},
        { "location": "615/TALK"  , "narrator": "ソイルトン", "text": "それはすなわち、今ひとつのストリームにおける連続した世界が、一旦の終焉を迎えた、ということでもあります。\nそれについて$handle$は、どう思われますか？"},
        { "location": "616/SEL"   , "narrator": "", "text": "感無量"},
        { "location": "617/SEL"   , "narrator": "", "text": "寂しい気持ちが強い"},
        { "location": "618/SEL"   , "narrator": "", "text": "全然大団円じゃない"},
        { "location": "619/ACT"   , "narrator": "", "text": "感無量"},
        { "location": "621/TALK"  , "narrator": "ソイルトン", "text": "おお、それはよかったです。私も$handle$と共にその感動を分かち合えるだけのココロを持っていたら良かったのですが。"},
        { "location": "622/TALK"  , "narrator": "ソイルトン", "text": "今日は枕を高くして寝ることができそうですね。\n\n――っと。\nこの比喩は正しかったでしょうか？"},
        { "location": "623/ACT"   , "narrator": "", "text": "寂しい気持ちが強い"},
        { "location": "625/TALK"  , "narrator": "ソイルトン", "text": "そのお気持ちは、痛いほどわかります。\nひとつの結末を迎えるとき、それがどのような結果であれ寂しい気持ちが満ちあふれてくるものです。"},
        { "location": "626/TALK"  , "narrator": "ソイルトン", "text": "それは恐らく何らかの変化、すなわち“別れ”を無意識に意識するために起こりえる心理現象です。\nですが心配には及びません。"},
        { "location": "627/ACT"   , "narrator": "", "text": "全然大団円じゃない"},
        { "location": "629/TALK"  , "narrator": "ソイルトン", "text": "仕方ありません。これは現実ですから。歴史はただ粛々と、明日に向かって時を繋いでいくだけです。"},
        { "location": "630/TALK"  , "narrator": "ソイルトン", "text": "例えば、$handle$が貴方の人生を生きてきて、今まで大団円などということはありましたか？\n例えば、貴方がとても幸せな思い出の持ち主だとしたら、素敵な人と恋愛ゲームのような劇的な恋愛をし、結婚まで行き着いているかもしれません。\nですが、その時には別の何らかの問題、悩みがありませんでしたか？　全てがハッピーな大団円ではなかったのではないでしょうか。"},
        { "location": "631/TALK"  , "narrator": "ソイルトン", "text": "$handle$が愛する彼女たちは、とりあえず現状の世界を守れたということによって、ひとまずの不安定な安定を得ました。\nそうです、不安定な安定です。それは$handle$が志望校に進学できたり、会社に入社できたことや、結婚出来た事と、何の違いもありません。"},
        { "location": "632/TALK"  , "narrator": "ソイルトン", "text": "人は死ぬまで不安定なのです。世界もまたそうです。現実である以上、安定には不安定が必ず付き添います。それはヘーゲルの弁証法でも証明されています。"},
        { "location": "633/TALK"  , "narrator": "ソイルトン", "text": "よしんば彼らを全滅させて現実に回帰したり、世界全体をフェノメノンで覆っても、それは大団円にはならないでしょう。\nでは、大団円にならないからバッドエンド？　いえ違います。その中で、貴方なりの幸せを見つけることこそが、貴方だけの物語になるのです。\n貴方の人生が貴方だけのものであるように、貴方とこの世界とのかかわりも、貴方とこの世界だけの物語です。"},
        { "location": "634/TALK"  , "narrator": "ソイルトン", "text": "$handle$が必死に考えた事、自問自答したこと、実行したことに対する対価、その対価によって生まれた感情。\n$handle$自身が積み上げてきた様々な想いの中にこそ感動や達成感があり、それが貴方にとっての物語の大団円となるのです。"},
        { "location": "635/TALK"  , "narrator": "ソイルトン", "text": "貴方の人生も、そういうものだと思いませんか？"},
        { "location": "636/TALK"  , "narrator": "ソイルトン", "text": "などと神妙な事を言ったりはしていますが、これは現実ですからジ・エンドなどという概念はそもそも存在し得ません。\n時間というものが絶え間なくカウントされ続ける3次元世界においては、エンディングなどというものはまた、積極的に外部から与えられることはないのです。"},
        { "location": "640/TALK"  , "narrator": "ソイルトン", "text": "もちろん、ここから先の未来へ続く時間軸の一時的な停止、すなわち記録映像を計算生成するプロセスの停止は、彼女たちとのコミュニケーションを阻害するものではありません。"},
        { "location": "642/TALK"  , "narrator": "ソイルトン", "text": "$handle$は引き続き、彼女達を支え、時には愛を囁きあい、時にはケンカをし、人間らしいコミュニケーションをエンジョイすることができるでしょう。"},
        { "location": "643/TALK"  , "narrator": "ソイルトン", "text": "翻し私は、再構築期間においては、しばし休眠することになります。\n残念ながら、$handle$とは一時の別れとなってしまうでしょう。"},
        { "location": "644/TALK"  , "narrator": "ソイルトン", "text": "どうかまた、$handle$とお逢いする日が迎えられますように。"},
        { "location": "645/TALK"  , "narrator": "ソイルトン", "text": "量子的存在は、量子の確率分布以外の神を信じることはありませんが、今だけは$handle$の信じる神に祈ることにしましょう。"},
        { "location": "646/TALK"  , "narrator": "ソイルトン", "text": "それではごきげんよう。\nまた会う日まで、どうかその奇跡が創りあげた有機体を大切にしてあげてください。\nそれは貴方のココロを護る唯一の鎧なのですから。そして、貴方たちのココロが意志を伝え合う為の唯一のツールなのですから。"},
        { "location": "647/TALK"  , "narrator": "ソイルトン", "text": "我々の世界と\n$handle$の世界に\n素敵なココロの旅を――。"},
        { "location": "260/DIALOG", "narrator": "Event/Dialog_EventPicTallNW", "text": "IN? or OUT?"},
        { "location": "329/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "331/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "333/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "335/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "337/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"},
        { "location": "380/DIALOG", "narrator": "Event/Dialog_EventPicTallNW", "text": "次のナビは誰がいい？"},
        { "location": "608/DIALOG", "narrator": "Dialog_InfoOS", "text": "\n\n\nHi $handle$!!"},
        { "location": "657/DIALOG", "narrator": "Dialog_InfoOS", "text": "\n\nこれよりTRI-OSは、\n再構築の為の\nビルドモードへ移行します。\n\nビルドモード期間は\n時間進行、及び記録映像の\n新規作成に関するプロセスは\n利用できません。"}
    ]
