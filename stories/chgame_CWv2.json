    "entry":
    [
        { "location": "1778/SCENARIO", "narrator": "", "text": "CWかぐら姫"},
        { "location": "1790/TALK"    , "narrator": "千羽鶴", "text": "ここには\n卯月神楽がいた。"},
        { "location": "1791/SEL"     , "narrator": "", "text": "確か、かぐら姫だっけｗ"},
        { "location": "1792/ACT"     , "narrator": "", "text": "確か、かぐら姫だっけｗ"},
        { "location": "1794/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1795/TALK"    , "narrator": "千羽鶴", "text": "月の姫であるかぐやと、\n卯月神楽を\nかけ合わせてみた。"},
        { "location": "1796/TALK"    , "narrator": "千羽鶴", "text": "我ながら\nナイスネーミングだと\n思う。"},
        { "location": "1797/TALK"    , "narrator": "千羽鶴", "text": "RPGゲームでの\n役割については、\n正直かなり悩んだ。"},
        { "location": "1798/TALK"    , "narrator": "千羽鶴", "text": "この時点で卯月神楽は\nまだ、貴方にとっては\n未知数な存在だったから。"},
        { "location": "1799/TALK"    , "narrator": "千羽鶴", "text": "結果として、ゴールまでの\n采配を決定づける、\n鍵として設定した。"},
        { "location": "1800/TALK"    , "narrator": "千羽鶴", "text": "彼女は２つのアイテムの\nうち、１つを貴方に\nプレゼントしてくれる。"},
        { "location": "1801/TALK"    , "narrator": "千羽鶴", "text": "そのアイテムはどちらも\nクリアには欠かせない\nものだった。"},
        { "location": "1802/TALK"    , "narrator": "千羽鶴", "text": "すなわちそれは、\n当時の私のミッションに\nおいても同様だった。"},
        { "location": "1803/TALK"    , "narrator": "千羽鶴", "text": "私にとって彼女は、\n必要不可欠な\n存在だったから。"},
        { "location": "1804/TALK"    , "narrator": "千羽鶴", "text": "そして――"},
        { "location": "1805/TALK"    , "narrator": "千羽鶴", "text": "性質は変われど、\nその点については、\n今もかわらない。"}
    ]
}
