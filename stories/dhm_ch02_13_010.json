        "title": "Extra007 ヒメゴトチャット",
        "sub_title": "ダイエットは明日から"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "020_ダイエットは明日から"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "たまにはいいわよね"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "そう"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "たまにだからいいのよ"},
        { "location": "36/SEL"    , "narrator": "", "text": "何がたまに？"},
        { "location": "37/SEL"    , "narrator": "", "text": "$me$はいつでもアーヤが好き"},
        { "location": "38/ACT"    , "narrator": "", "text": "何がたまに？"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "あれ"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "いなかったっけ"},
        { "location": "41/ACT"    , "narrator": "", "text": "$me$はいつでもアーヤが好き"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "あら(*^^*)"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "でも今の話とは関係ないわね"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "みんなとお茶して"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "ついでにラーメンも食べちゃったことよ"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "滅多にないことだものね"},
        { "location": "52/SEL"    , "narrator": "", "text": "さあ、体重計へどうぞ"},
        { "location": "53/SEL"    , "narrator": "", "text": "意外と食べるんだね？"},
        { "location": "54/SEL"    , "narrator": "", "text": "幸せそうだ"},
        { "location": "55/ACT"    , "narrator": "", "text": "さあ、体重計へどうぞ"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "もう"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "なんでそんなこと言うのかしら"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "乗らないから"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "今週は運動して"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "ライ数体重計に乗るわ"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "来週"},
        { "location": "63/ACT"    , "narrator": "", "text": "意外と食べるんだね？"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "そう？"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "これでも高校時代よりは減ったわよ"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "そう言えば"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "高校時代ってなんであんなに食べれたのかしら"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "不思議だわ"},
        { "location": "70/ACT"    , "narrator": "", "text": "幸せそうだ"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "おいしいものって幸せよね"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "みんなそうだと思うわ"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "カロリーさえ考えなきゃね"}
    ]
}
