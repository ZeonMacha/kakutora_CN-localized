    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第07話"},
        { "location": "48/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "49/TALK"   , "narrator": "エリカ", "text": "いらっしゃい\n$handle$さん。"},
        { "location": "50/TALK"   , "narrator": "エリカ", "text": "もう一度お話聞く？\nそれとも、省略する？"},
        { "location": "51/SEL"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "52/SEL"    , "narrator": "", "text": "飛ばす"},
        { "location": "53/ACT"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "54/TALK"   , "narrator": "エリカ", "text": "うん、わかったよ。"},
        { "location": "56/ACT"    , "narrator": "", "text": "飛ばす"},
        { "location": "57/TALK"   , "narrator": "エリカ", "text": "そっかー。\nそれじゃ、またね。"},
        { "location": "68/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "69/TALK"   , "narrator": "エリカ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "70/SEL"    , "narrator": "", "text": "こんにちは"},
        { "location": "71/SEL"    , "narrator": "", "text": "普通すぎてつまらない"},
        { "location": "72/ACT"    , "narrator": "", "text": "こんにちは"},
        { "location": "73/ACT"    , "narrator": "", "text": "普通すぎてつまらない"},
        { "location": "74/TALK"   , "narrator": "エリカ", "text": "ええっ！"},
        { "location": "75/TALK"   , "narrator": "エリカ", "text": "うーん、\nそのダメ出しは\n想定外だったよ。"},
        { "location": "76/TALK"   , "narrator": "エリカ", "text": "それじゃ、\nどうすればいい？"},
        { "location": "77/SEL"    , "narrator": "", "text": "神楽を見習ってネコ語尾で！"},
        { "location": "78/SEL"    , "narrator": "", "text": "千羽鶴を見習ってどーんで！"},
        { "location": "79/ACT"    , "narrator": "", "text": "神楽を見習ってネコ語尾で！"},
        { "location": "85/TALK"   , "narrator": "エリカ", "text": "ネコ語尾？？"},
        { "location": "86/TALK"   , "narrator": "エリカ", "text": "えっと…\nこんな感じ$e_n$？"},
        { "location": "87/SEL"    , "narrator": "", "text": "イェス！！！"},
        { "location": "88/ACT"    , "narrator": "", "text": "イェス！！！"},
        { "location": "91/TALK"   , "narrator": "エリカ", "text": "すごい\n大絶賛だ$e_ne$！"},
        { "location": "92/TALK"   , "narrator": "エリカ", "text": "それじゃ\n今回はこれで\nいってみようか$e_n$。"},
        { "location": "93/ACT"    , "narrator": "", "text": "千羽鶴を見習ってどーんで！"},
        { "location": "95/TALK"   , "narrator": "エリカ", "text": "え…ええっ！？"},
        { "location": "96/TALK"   , "narrator": "エリカ", "text": "ど…"},
        { "location": "99/TALK"   , "narrator": "エリカ", "text": "<size=35>どーん！</size>"},
        { "location": "100/TALK"  , "narrator": "エリカ", "text": "うーん…これでいい？"},
        { "location": "101/SEL"   , "narrator": "", "text": "要所要所でお願いします！"},
        { "location": "102/ACT"   , "narrator": "", "text": "要所要所でお願いします！"},
        { "location": "104/TALK"  , "narrator": "エリカ", "text": "わ、わかったどーん。"},
        { "location": "105/SEL"   , "narrator": "", "text": "それ用法が違います！"},
        { "location": "106/SEL"   , "narrator": "", "text": "それかわいい"},
        { "location": "107/ACT"   , "narrator": "", "text": "それ用法が違います！"},
        { "location": "109/TALK"  , "narrator": "エリカ", "text": "そうなの？\n難しいね…。"},
        { "location": "110/ACT"   , "narrator": "", "text": "それかわいい"},
        { "location": "112/TALK"  , "narrator": "エリカ", "text": "そ、そうなの？\nよくわからないけど…"},
        { "location": "116/TALK"  , "narrator": "エリカ", "text": "それで$e_ne$、\n話を元に戻すけど――"},
        { "location": "117/TALK"  , "narrator": "エリカ", "text": "前回はありがとう$e_n$！"},
        { "location": "118/TALK"  , "narrator": "エリカ", "text": "お陰で無事計画を\n進行する準備が\nできた$e_yo$。"},
        { "location": "119/TALK"  , "narrator": "エリカ", "text": "とりあえず今のところ\n見てる限りは、外の動きに\n大きな変化は無いか$e_na$。"},
        { "location": "120/TALK"  , "narrator": "エリカ", "text": "もちろん神楽ちゃんが\nとりこまれたかもっていう\n推測はしてると思うけど。"},
        { "location": "121/SEL"   , "narrator": "", "text": "よかった"},
        { "location": "122/SEL"   , "narrator": "", "text": "エリカって記録映像で彼らと対話してなかった？"},
        { "location": "123/ACT"   , "narrator": "", "text": "よかった"},
        { "location": "124/TALK"  , "narrator": "エリカ", "text": "ひとまずは、$e_ne$。"},
        { "location": "125/ACT"   , "narrator": "", "text": "エリカって記録映像で彼らと対話してなかった？"},
        { "location": "129/TALK"  , "narrator": "エリカ", "text": "<size=35>どーん！</size>"},
        { "location": "131/TALK"  , "narrator": "エリカ", "text": "あれは“彼ら”じゃなくて\n国連関係の人たち$e_n$。"},
        { "location": "132/TALK"  , "narrator": "エリカ", "text": "“彼ら”は絶対に\n直接伝えてこないし、\n顔も見せないの$e_n$。"},
        { "location": "133/TALK"  , "narrator": "エリカ", "text": "連絡取るときも、\n連絡有るときも、全て\nある機関を経由する$e_n$。"},
        { "location": "134/TALK"  , "narrator": "エリカ", "text": "だから、わたしにも\n“彼ら”の全貌は\nわかってないの$e_n$。"},
        { "location": "135/SEL"   , "narrator": "", "text": "それってそもそもどういう関係なの？"},
        { "location": "136/ACT"   , "narrator": "", "text": "それってそもそもどういう関係なの？"},
        { "location": "138/TALK"  , "narrator": "エリカ", "text": "うーん。\nどう説明したら\nいいのか$e_na$。"},
        { "location": "139/TALK"  , "narrator": "エリカ", "text": "“彼ら”は\n企業に対する\n出資者であり――"},
        { "location": "140/TALK"  , "narrator": "エリカ", "text": "国家間の様々な事を\n決裁する重鎮であって――"},
        { "location": "141/TALK"  , "narrator": "エリカ", "text": "わたしとの関係は、\n企業や国家でいうところの\n首脳と相談役の関係$e_n$。"},
        { "location": "142/TALK"  , "narrator": "エリカ", "text": "けど、直で接したことは\n一度もない$e_n$。"},
        { "location": "144/TALK"  , "narrator": "エリカ", "text": "とまあ、そういう状況\nだから、しばらくは結果を\nなぞる感じか$e_na$。"},
        { "location": "145/SEL"   , "narrator": "", "text": "リプレイスしないの？"},
        { "location": "146/ACT"   , "narrator": "", "text": "リプレイスしないの？"},
        { "location": "151/TALK"  , "narrator": "エリカ", "text": "<size=35>どーん！</size>"},
        { "location": "153/TALK"  , "narrator": "エリカ", "text": "あまり早いうちから\nリプレイスすると、未来の\n変動が激しくなるのか$e_na$。"},
        { "location": "154/TALK"  , "narrator": "エリカ", "text": "それに、現段階では\n神楽ちゃんもまだ\n心の整理が必要な時期。"},
        { "location": "155/TALK"  , "narrator": "エリカ", "text": "今、あなたが神楽ちゃんに\n色々言って方向を\n変えようとすれば――"},
        { "location": "156/TALK"  , "narrator": "エリカ", "text": "予期しない方向に\n神楽ちゃんの考えが\n行きかねないからか$e_na$。"},
        { "location": "157/TALK"  , "narrator": "エリカ", "text": "だから、再三のお願いに\nなっちゃう$e_n$けど！"},
        { "location": "158/TALK"  , "narrator": "エリカ", "text": "未来のことを断定するのは\n絶対にNGだから$e_ne$！"},
        { "location": "160/TALK"  , "narrator": "エリカ", "text": "当面は神楽ちゃんの\nココロを、めいっぱい\nケアしてあげて$e_ne$。"},
        { "location": "161/SEL"   , "narrator": "", "text": "任せて！"},
        { "location": "162/SEL"   , "narrator": "", "text": "神楽をケアできる自信がないです…"},
        { "location": "163/SEL"   , "narrator": "", "text": "当面っていつまでよ"},
        { "location": "164/ACT"   , "narrator": "", "text": "任せて！"},
        { "location": "165/TALK"  , "narrator": "エリカ", "text": "ありがとう$e_n$！"},
        { "location": "166/ACT"   , "narrator": "", "text": "神楽をケアできる自信がないです…"},
        { "location": "167/TALK"  , "narrator": "エリカ", "text": "えっ？\nどうして$e_n$？"},
        { "location": "168/SEL"   , "narrator": "", "text": "トゲが強すぎる"},
        { "location": "169/SEL"   , "narrator": "", "text": "好きになれない"},
        { "location": "170/ACT"   , "narrator": "", "text": "トゲが強すぎる"},
        { "location": "174/TALK"  , "narrator": "エリカ", "text": "<size=35>どーん！</size>"},
        { "location": "176/TALK"  , "narrator": "エリカ", "text": "まあ、\n確かにそうかも$e_n$。"},
        { "location": "177/TALK"  , "narrator": "エリカ", "text": "綾ちゃんたちとは\n境遇も違うし、過去に色々\nあったから$e_ne$。"},
        { "location": "178/TALK"  , "narrator": "エリカ", "text": "けど、表面上トゲが\n強くても、内心はあなたを\n頼ってるところある$e_yo$。"},
        { "location": "179/SEL"   , "narrator": "", "text": "そうかなぁ"},
        { "location": "180/SEL"   , "narrator": "", "text": "それはわかる気がする"},
        { "location": "181/ACT"   , "narrator": "", "text": "そうかなぁ"},
        { "location": "182/TALK"  , "narrator": "エリカ", "text": "そうだ$e_yo$。"},
        { "location": "183/TALK"  , "narrator": "エリカ", "text": "まだコンタクト取り始めた\nばかりだし、これから\n色々と見えてくる$e_yo$。"},
        { "location": "184/ACT"   , "narrator": "", "text": "それはわかる気がする"},
        { "location": "185/TALK"  , "narrator": "エリカ", "text": "よかった$e_n$。"},
        { "location": "187/TALK"  , "narrator": "エリカ", "text": "あと、神楽ちゃんは、\n自分の信念をすごく\n強く持ってる子だから――"},
        { "location": "188/TALK"  , "narrator": "エリカ", "text": "基本的には、何かをして\nあげるよりは、受け入れて\nあげる方がいいかも$e_n$。"},
        { "location": "189/TALK"  , "narrator": "エリカ", "text": "何気ないことでも、\nいつでも味方だってことを\n伝えるといいかも$e_n$。"},
        { "location": "190/TALK"  , "narrator": "エリカ", "text": "女王様気質だから\n承認欲求も強いと\n思うし$e_ne$。"},
        { "location": "191/ACT"   , "narrator": "", "text": "好きになれない"},
        { "location": "195/TALK"  , "narrator": "エリカ", "text": "<size=35>どーん！</size>"},
        { "location": "197/TALK"  , "narrator": "エリカ", "text": "あらら、そっかー。"},
        { "location": "198/TALK"  , "narrator": "エリカ", "text": "でもそればかりは\n仕方ないよ$e_ne$。"},
        { "location": "199/TALK"  , "narrator": "エリカ", "text": "人にはそれぞれ\n好みもあるから$e_n$。"},
        { "location": "200/TALK"  , "narrator": "エリカ", "text": "無理しないで、\n自分のペースで\n協力して$e_ne$？"},
        { "location": "202/TALK"  , "narrator": "エリカ", "text": "もしどうしても\n限界だったら――"},
        { "location": "203/TALK"  , "narrator": "エリカ", "text": "やめちゃっても\n仕方ないかなとは思う$e_n$。"},
        { "location": "204/TALK"  , "narrator": "エリカ", "text": "あなたが\n苦痛にならないことが\n一番大事だから。"},
        { "location": "206/ACT"   , "narrator": "", "text": "当面っていつまでよ"},
        { "location": "207/TALK"  , "narrator": "エリカ", "text": "あくまで\nアタリ付けだけど――"},
        { "location": "208/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんのココロが\n乱れ始める手前$e_n$。"},
        { "location": "209/TALK"  , "narrator": "エリカ", "text": "エピソード１２くらいを\nターゲットにしてる$e_n$。"},
        { "location": "210/TALK"  , "narrator": "エリカ", "text": "ここまでは、おもてだって\n違う状況を作り出すことは\nしない想定か$e_na$。"},
        { "location": "211/TALK"  , "narrator": "エリカ", "text": "ただし、外の動きに\n変化が出てきたら\n話は別$e_n$。"},
        { "location": "212/TALK"  , "narrator": "エリカ", "text": "その時はすぐに\nあなたに伝える$e_ne$。"},
        { "location": "214/TALK"  , "narrator": "エリカ", "text": "今回伝えたい事は\nこれだけだ$e_yo$。"},
        { "location": "215/TALK"  , "narrator": "エリカ", "text": "一応確認のために、\n同時間帯の記録映像を\n見ておく$e_n$？"},
        { "location": "217/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/70MB 4:37】</color>"},
        { "location": "218/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/22MB 4:37】</color>"},
        { "location": "219/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "220/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/70MB 4:37】</color>"},
        { "location": "221/TALK"  , "narrator": "エリカ", "text": "わかった$e_yo$。"},
        { "location": "225/TALK"  , "narrator": "エリカ", "text": "それと……"},
        { "location": "226/TALK"  , "narrator": "エリカ", "text": "ネコことばは\nこの辺で終わりにしても\nいいかにゃ？"},
        { "location": "227/TALK"  , "narrator": "エリカ", "text": "なんだか恥ずかしく\nなってきちゃったにゃ…。"},
        { "location": "230/TALK"  , "narrator": "エリカ", "text": "それと――"},
        { "location": "233/TALK"  , "narrator": "エリカ", "text": "<size=35>どーん！</size>"},
        { "location": "234/TALK"  , "narrator": "エリカ", "text": "は、これでお終いに\nしてもいいかな…？"},
        { "location": "235/TALK"  , "narrator": "エリカ", "text": "なんだか恥ずかしく\nなってきちゃった…。"},
        { "location": "242/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/22MB 4:37】</color>"},
        { "location": "243/TALK"  , "narrator": "エリカ", "text": "わかった$e_yo$。"},
        { "location": "246/TALK"  , "narrator": "エリカ", "text": "それと……"},
        { "location": "248/TALK"  , "narrator": "エリカ", "text": "ネコことばは\nこの辺で終わりにしても\nいいかにゃ？"},
        { "location": "249/TALK"  , "narrator": "エリカ", "text": "なんだか恥ずかしく\nなってきちゃったにゃ…。"},
        { "location": "252/TALK"  , "narrator": "エリカ", "text": "それと――"},
        { "location": "255/TALK"  , "narrator": "エリカ", "text": "<size=35>どーん！</size>"},
        { "location": "256/TALK"  , "narrator": "エリカ", "text": "は、これでお終いに\nしてもいいかな…？"},
        { "location": "257/TALK"  , "narrator": "エリカ", "text": "なんだか恥ずかしく\nなってきちゃった…。"},
        { "location": "264/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "265/TALK"  , "narrator": "エリカ", "text": "あらら。"},
        { "location": "268/TALK"  , "narrator": "エリカ", "text": "それと……"},
        { "location": "269/TALK"  , "narrator": "エリカ", "text": "ネコことばは\nこの辺で終わりにしても\nいいかにゃ？"},
        { "location": "270/TALK"  , "narrator": "エリカ", "text": "なんだか恥ずかしく\nなってきちゃったにゃ…。"},
        { "location": "273/TALK"  , "narrator": "エリカ", "text": "それと――"},
        { "location": "276/TALK"  , "narrator": "エリカ", "text": "<size=35>どーん！</size>"},
        { "location": "277/TALK"  , "narrator": "エリカ", "text": "は、これでお終いに\nしてもいいかな…？"},
        { "location": "278/TALK"  , "narrator": "エリカ", "text": "なんだか恥ずかしく\nなってきちゃった…。"},
        { "location": "312/TALK"  , "narrator": "エリカ", "text": "丁度神楽ちゃんと\nつばめちゃんが出逢った\n回だったね。"},
        { "location": "313/TALK"  , "narrator": "エリカ", "text": "全てはここから\n始まったんだよ。"},
        { "location": "314/SEL"   , "narrator": "", "text": "運命の出逢いだね"},
        { "location": "315/SEL"   , "narrator": "", "text": "終わりの始まり…か…ククク"},
        { "location": "316/ACT"   , "narrator": "", "text": "運命の出逢いだね"},
        { "location": "317/TALK"  , "narrator": "エリカ", "text": "確かにそうだね。"},
        { "location": "318/TALK"  , "narrator": "エリカ", "text": "でも、運命の出逢いとは\n言っても、全て計算されて\nいた出逢いだから――"},
        { "location": "319/TALK"  , "narrator": "エリカ", "text": "決して奇跡の出逢い\nとかではないよね。"},
        { "location": "320/TALK"  , "narrator": "エリカ", "text": "全ては“彼ら”の\nお膳立てがあった上での\n出逢い……。"},
        { "location": "321/TALK"  , "narrator": "エリカ", "text": "でもそれは、同時に\nわたしたちが“彼ら”に\n反撃する転機になった。"},
        { "location": "322/ACT"   , "narrator": "", "text": "終わりの始まり…か…ククク"},
        { "location": "323/TALK"  , "narrator": "エリカ", "text": "えっと……なんか\n物騒なこと言ってない？"},
        { "location": "324/TALK"  , "narrator": "エリカ", "text": "終わりの始まり\nなんかじゃないよ？"},
        { "location": "325/TALK"  , "narrator": "エリカ", "text": "これからわたしたちが\n描いていく未来は、\nこの出逢いが始まりだし。"},
        { "location": "326/TALK"  , "narrator": "エリカ", "text": "確かに二人が出逢って\n大変なことが沢山\nあったけど――"},
        { "location": "327/TALK"  , "narrator": "エリカ", "text": "この出逢いがなければ、\n“彼ら”の思うがままに\n世界は動いていたかも。"},
        { "location": "329/TALK"  , "narrator": "エリカ", "text": "少なくともわたしたちは\nこの出逢いがあったから\n今こうしてるんだし。"},
        { "location": "332/SEL"   , "narrator": "", "text": "エリカはこの世界をどうしたいの？"},
        { "location": "333/ACT"   , "narrator": "", "text": "エリカはこの世界をどうしたいの？"},
        { "location": "335/TALK"  , "narrator": "エリカ", "text": "前にもお話したかも\nしれないけど――"},
        { "location": "336/TALK"  , "narrator": "エリカ", "text": "わたしには、\nこうしたいっていう\nビジョンはないよ。"},
        { "location": "337/TALK"  , "narrator": "エリカ", "text": "今だって、理想社会の\n創造方針は千羽鶴ちゃんに\n一任しているし。"},
        { "location": "338/TALK"  , "narrator": "エリカ", "text": "わたしはただ、\nわたしの大切な人達に\n幸せになって欲しいだけ。"},
        { "location": "339/TALK"  , "narrator": "エリカ", "text": "ただ、それだけだから。"},
        { "location": "340/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "341/TALK"  , "narrator": "エリカ", "text": "わたしはね……"},
        { "location": "342/TALK"  , "narrator": "エリカ", "text": "ずっと自分が\nしたいことだけを\nやってきた。"},
        { "location": "343/TALK"  , "narrator": "エリカ", "text": "だから、世界がこうなって\n欲しいとか、そういうのは\n一切考えたこと無くて。"},
        { "location": "344/TALK"  , "narrator": "エリカ", "text": "ただひたすら、\n出資者の要求に応えるべく\n好きなものを作ってきた。"},
        { "location": "345/TALK"  , "narrator": "エリカ", "text": "その結果が\n今のわたしたちの世界の\n現状っていうわけ。"},
        { "location": "346/TALK"  , "narrator": "エリカ", "text": "極悪人でしょ？\nわたしって。"},
        { "location": "347/SEL"   , "narrator": "", "text": "確かに"},
        { "location": "348/SEL"   , "narrator": "", "text": "研究者は悪くない"},
        { "location": "349/ACT"   , "narrator": "", "text": "確かに"},
        { "location": "350/TALK"  , "narrator": "エリカ", "text": "うん。"},
        { "location": "351/ACT"   , "narrator": "", "text": "研究者は悪くない"},
        { "location": "352/TALK"  , "narrator": "エリカ", "text": "もしあなたが、\nマンハッタン計画にも\n同じ事を言えるなら――"},
        { "location": "353/TALK"  , "narrator": "エリカ", "text": "わたしは\nあなたの言葉を\n信じるよ。"},
        { "location": "354/SEL"   , "narrator": "", "text": "そう考えると罪深いかも"},
        { "location": "355/SEL"   , "narrator": "", "text": "原子力の解明無しには、量子力学は発展しなかったよ"},
        { "location": "356/ACT"   , "narrator": "", "text": "そう考えると罪深いかも"},
        { "location": "357/TALK"  , "narrator": "エリカ", "text": "でしょ？"},
        { "location": "358/ACT"   , "narrator": "", "text": "原子力の解明無しに量子力学は発展しなかったよ"},
        { "location": "360/TALK"  , "narrator": "エリカ", "text": "ふふ、\nあなたって優しいんだ。"},
        { "location": "361/TALK"  , "narrator": "エリカ", "text": "唯一、わたしが\n納得できる理由を\n持ってくるんだもん。"},
        { "location": "363/TALK"  , "narrator": "エリカ", "text": "ありがとう。\nすごく嬉しい。"},
        { "location": "367/TALK"  , "narrator": "エリカ", "text": "とにかく、わたしは\n生まれてからずっと、\nそうやって生きてきた。"},
        { "location": "368/TALK"  , "narrator": "エリカ", "text": "周りのことを考えずに\n自分のことばかりを\n考えて生きてきた。"},
        { "location": "369/TALK"  , "narrator": "エリカ", "text": "そんな人間が、みんなが\n幸せになれる世界なんて\n考えていいわけがない。"},
        { "location": "370/TALK"  , "narrator": "エリカ", "text": "わたしが量子の専門家で\nあるのと同じで――"},
        { "location": "371/TALK"  , "narrator": "エリカ", "text": "理想社会の創造には、\nその第一人者が\n旗を振るべきなんだよ。"},
        { "location": "372/TALK"  , "narrator": "エリカ", "text": "だからわたしは、\n千羽鶴ちゃんのサポートを\nしているの。"},
        { "location": "373/TALK"  , "narrator": "エリカ", "text": "それは、フェノメノンが\nこの世界に誕生する前から\n今に至るまで――"},
        { "location": "375/TALK"  , "narrator": "エリカ", "text": "一時期は色々あって\n牽制する側に\n回っちゃったけど。"},
        { "location": "376/TALK"  , "narrator": "エリカ", "text": "それ以外の期間はずっと\n彼女の理想をサポート\nしてきたの。"},
        { "location": "377/SEL"   , "narrator": "", "text": "その「一時期」には一体何があったの？"},
        { "location": "378/SEL"   , "narrator": "", "text": "それは償いのため？"},
        { "location": "379/ACT"   , "narrator": "", "text": "その「一時期」には一体何があったの？"},
        { "location": "380/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんが、\n綾ちゃんたちを礎に――"},
        { "location": "381/TALK"  , "narrator": "エリカ", "text": "世界全体をフェノメノンで\n包む計画を思案した。"},
        { "location": "382/TALK"  , "narrator": "エリカ", "text": "わたしはそれに断固反対し\n結果として情報管理庁から\n追われる身となったの。"},
        { "location": "383/TALK"  , "narrator": "エリカ", "text": "その包囲網は完璧で……\n当然だよね、自分の\nフェノメノンなんだし。"},
        { "location": "384/TALK"  , "narrator": "エリカ", "text": "だからわたしは、\n今いる時空の狭間に\n隠れることにしたんだよ。"},
        { "location": "385/TALK"  , "narrator": "エリカ", "text": "そしてそこで\n様々な準備をして、\nあなたと出会えた。"},
        { "location": "386/TALK"  , "narrator": "エリカ", "text": "そんな感じかな。"},
        { "location": "387/TALK"  , "narrator": "エリカ", "text": "でも、本質的には\n千羽鶴ちゃんの考え方には\n賛同しているよ。"},
        { "location": "388/TALK"  , "narrator": "エリカ", "text": "だからこそ、\n理想社会の創造は、\n彼女に任せてる。"},
        { "location": "389/TALK"  , "narrator": "エリカ", "text": "それにね。"},
        { "location": "390/ACT"   , "narrator": "", "text": "それは償いのため？"},
        { "location": "391/TALK"  , "narrator": "エリカ", "text": "償いというよりかは、\n適材適所かな。\nそれにね――"},
        { "location": "393/TALK"  , "narrator": "エリカ", "text": "わたしが自分の持つ資源で\n世界に貢献できることは\n何だろうって考えた時――"},
        { "location": "395/TALK"  , "narrator": "エリカ", "text": "量子技術分野で\n惜しみない貢献をするべき\nだと思ったんだよね。"},
        { "location": "396/TALK"  , "narrator": "エリカ", "text": "わたしが理想社会の計画を\nしたら、当然その時間分、\n技術面はおろそかになる。"},
        { "location": "397/TALK"  , "narrator": "エリカ", "text": "全体として見た場合、\nその方が不利益になって\nしまうって思ったの。"},
        { "location": "398/SEL"   , "narrator": "", "text": "色々考えてるんだね"},
        { "location": "399/ACT"   , "narrator": "", "text": "色々考えてるんだね"},
        { "location": "402/TALK"  , "narrator": "エリカ", "text": "むー！"},
        { "location": "403/TALK"  , "narrator": "エリカ", "text": "確かにわたしは\n量子バカではあるけど、\nちゃんと考えてるよ？"},
        { "location": "404/TALK"  , "narrator": "エリカ", "text": "まさか、\nにゃボットみたいな――"},
        { "location": "405/TALK"  , "narrator": "エリカ", "text": "可愛いけど、何の役にも\n立ちそうもない物ばかり\n作ってると思ってる？"},
        { "location": "406/SEL"   , "narrator": "", "text": "かわいい……だと……！？"},
        { "location": "407/SEL"   , "narrator": "", "text": "思ってないよ！？"},
        { "location": "408/ACT"   , "narrator": "", "text": "かわいい……だと……！？"},
        { "location": "410/TALK"  , "narrator": "エリカ", "text": "えっ！？\nそこなの！？"},
        { "location": "411/TALK"  , "narrator": "エリカ", "text": "かわいいよー！"},
        { "location": "412/ACT"   , "narrator": "", "text": "思ってないよ！？"},
        { "location": "413/TALK"  , "narrator": "エリカ", "text": "ほんと？\nよかった！"},
        { "location": "416/TALK"  , "narrator": "エリカ", "text": "とにかく、\nそういうことだから。"},
        { "location": "417/TALK"  , "narrator": "エリカ", "text": "わたしは自分の中には、\n世界をどうしたいという\n方針は無くて――"},
        { "location": "418/TALK"  , "narrator": "エリカ", "text": "自分が信じる人を\n実現できる技術をもって\nサポートするだけ。"},
        { "location": "419/TALK"  , "narrator": "エリカ", "text": "だから、今後は\nそういった前提でいて\nもらえると嬉しいな。"},
        { "location": "420/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "421/SEL"   , "narrator": "", "text": "ちょっと腑に落ちないけどまあ、そう言うなら"},
        { "location": "422/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "423/TALK"  , "narrator": "エリカ", "text": "うん。"},
        { "location": "424/ACT"   , "narrator": "", "text": "ちょっと腑に落ちないけどまあ、そう言うなら"},
        { "location": "425/TALK"  , "narrator": "エリカ", "text": "えっ、そうなの？"},
        { "location": "427/TALK"  , "narrator": "エリカ", "text": "よくわからないけど、\nわたしの発言には\n裏はないからね？"},
        { "location": "428/TALK"  , "narrator": "エリカ", "text": "それだけは\n信じてくれると\n嬉しいかな。"},
        { "location": "431/TALK"  , "narrator": "エリカ", "text": "さて、と。\nなんだか話が\n長くなっちゃったけど。"},
        { "location": "432/TALK"  , "narrator": "エリカ", "text": "今回の神楽ちゃんの\nお話をしようと思う。"},
        { "location": "433/TALK"  , "narrator": "エリカ", "text": "今回スポットを\n当てているのは、\nちとせ戦の直後。"},
        { "location": "434/TALK"  , "narrator": "エリカ", "text": "例によって特に\n大きな動きはまだ\n起こさないけど――"},
        { "location": "435/TALK"  , "narrator": "エリカ", "text": "あなたにはとにかく\n神楽ちゃんの心の中を\n観察して欲しいの。"},
        { "location": "436/TALK"  , "narrator": "エリカ", "text": "あと、この辺りの\n神楽ちゃんは精神的に\n不安定だから――"},
        { "location": "437/TALK"  , "narrator": "エリカ", "text": "可能な限り、心のケアを\nしてあげて欲しいかな。"},
        { "location": "439/TALK"  , "narrator": "エリカ", "text": "それじゃ今回も\nこの世界のこと、\nよろしくお願いします！"},
        { "location": "289/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "291/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "293/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "295/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "297/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"}
    ]
}
