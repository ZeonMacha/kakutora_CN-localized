    "entry":
    [
        { "location": "936/SCENARIO", "narrator": "", "text": "ひと組のたわわ"},
        { "location": "961/TALK"    , "narrator": "神楽", "text": "たわわってたくさんの果物が実ってることのはずなのに"},
        { "location": "962/TALK"    , "narrator": "神楽", "text": "現実は芳醇な果実がひと組だけなの"},
        { "location": "963/TALK"    , "narrator": "神楽", "text": "でもその果実は背徳感に満ちていて"},
        { "location": "964/TALK"    , "narrator": "神楽", "text": "たわわとしか表現のしようのない瑞々しさ"},
        { "location": "966/SEL"     , "narrator": "", "text": "えと…何の話？"},
        { "location": "967/SEL"     , "narrator": "", "text": "期待していいのかな"},
        { "location": "968/SEL"     , "narrator": "", "text": "フレッシュな神楽ってこと？"},
        { "location": "969/ACT"     , "narrator": "", "text": "えと…何の話？"},
        { "location": "970/TALK"    , "narrator": "神楽", "text": "ここだけの話"},
        { "location": "971/ACT"     , "narrator": "", "text": "期待していいのかな"},
        { "location": "972/TALK"    , "narrator": "神楽", "text": "もちろん！"},
        { "location": "973/ACT"     , "narrator": "", "text": "フレッシュな神楽ってこと？"},
        { "location": "975/TALK"    , "narrator": "神楽", "text": "残念ながら違う"},
        { "location": "976/TALK"    , "narrator": "神楽", "text": "でもぴょんこをフレッシュな"},
        { "location": "977/TALK"    , "narrator": "神楽", "text": "いややっぱり女子をフレッシュって表現ダサすぎた"},
        { "location": "978/TALK"    , "narrator": "神楽", "text": "けどまあ仕方ないから許す"},
        { "location": "980/TALK"    , "narrator": "神楽", "text": "たわわなのは"},
        { "location": "981/TALK"    , "narrator": "神楽", "text": "つばめさんの、、、"},
        { "location": "983/SEL"     , "narrator": "", "text": "(_ﾟ∀ﾟ)o彡゜おっぱい！おっぱい！"},
        { "location": "984/SEL"     , "narrator": "", "text": "失敗談かな？"},
        { "location": "985/SEL"     , "narrator": "", "text": "えっちょ…"},
        { "location": "986/ACT"     , "narrator": "", "text": "(_ﾟ∀ﾟ)o彡゜おっぱい！おっぱい！"},
        { "location": "988/TALK"    , "narrator": "神楽", "text": "直球すぎんだろ！"},
        { "location": "990/TALK"    , "narrator": "神楽", "text": "ぶっちゃけそれだけど"},
        { "location": "991/TALK"    , "narrator": "神楽", "text": "いやー話早くて助かるわー"},
        { "location": "992/TALK"    , "narrator": "神楽", "text": "$handlek$さすがー"},
        { "location": "993/ACT"     , "narrator": "", "text": "失敗談かな？"},
        { "location": "994/TALK"    , "narrator": "神楽", "text": "今回はそれじゃないんだなー"},
        { "location": "995/ACT"     , "narrator": "", "text": "えっちょ…"},
        { "location": "996/TALK"    , "narrator": "神楽", "text": "好きなくせに"},
        { "location": "998/TALK"    , "narrator": "神楽", "text": "そんでもってひと組しかないのにこれがまたたわわとしかたわわとしかたわわ！"},
        { "location": "999/TALK"    , "narrator": "神楽", "text": "銭湯で確認したところたわわでたゆんたゆんたわわわわわ！"},
        { "location": "1000/TALK"   , "narrator": "神楽", "text": "という憤りにも似た衝動をどこかに発散したかったのよねてへぺろ★"},
        { "location": "1002/TALK"   , "narrator": "神楽", "text": "この話を聞いて$handlek$が悶々することを期待しつつアデュー★"}
    ]
}
