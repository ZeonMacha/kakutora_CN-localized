    "entry":
    [
        { "location": "85/SCENARIO", "narrator": "", "text": "みんななんて言葉はね"},
        { "location": "112/TALK"   , "narrator": "ガブリエラ", "text": "私は私だわ"},
        { "location": "114/SEL"    , "narrator": "", "text": "そうだよね"},
        { "location": "115/SEL"    , "narrator": "", "text": "よう知らんけど"},
        { "location": "116/SEL"    , "narrator": "", "text": "何か言われたの？"},
        { "location": "117/ACT"    , "narrator": "", "text": "そうだよね"},
        { "location": "118/TALK"   , "narrator": "ガブリエラ", "text": "当たり前よね"},
        { "location": "119/ACT"    , "narrator": "", "text": "よう知らんけど"},
        { "location": "120/TALK"   , "narrator": "ガブリエラ", "text": "冷たいのね"},
        { "location": "121/ACT"    , "narrator": "", "text": "何か言われたの？"},
        { "location": "123/TALK"   , "narrator": "ガブリエラ", "text": "そういうわけじゃないのよ"},
        { "location": "125/TALK"   , "narrator": "ガブリエラ", "text": "心配かけてしまったわね"},
        { "location": "127/TALK"   , "narrator": "ガブリエラ", "text": "みんななんて言葉に"},
        { "location": "128/TALK"   , "narrator": "ガブリエラ", "text": "いちいち動揺するなんて"},
        { "location": "129/TALK"   , "narrator": "ガブリエラ", "text": "ばからしいわよ"},
        { "location": "131/SEL"    , "narrator": "", "text": "まあね"},
        { "location": "132/SEL"    , "narrator": "", "text": "そう言い出すこと自体が……"},
        { "location": "133/SEL"    , "narrator": "", "text": "ガブはガブでいいんだよ"},
        { "location": "134/ACT"    , "narrator": "", "text": "まあね"},
        { "location": "135/TALK"   , "narrator": "ガブリエラ", "text": "ね"},
        { "location": "136/ACT"    , "narrator": "", "text": "そう言い出すこと自体が……"},
        { "location": "137/TALK"   , "narrator": "ガブリエラ", "text": "何よ"},
        { "location": "138/ACT"    , "narrator": "", "text": "ガブはガブでいいんだよ"},
        { "location": "140/TALK"   , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "142/TALK"   , "narrator": "ガブリエラ", "text": "その通りだわ"},
        { "location": "144/TALK"   , "narrator": "ガブリエラ", "text": "私は私"},
        { "location": "145/TALK"   , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "146/TALK"   , "narrator": "ガブリエラ", "text": "そんなこと気にしてないんだから"}
    ]
}
