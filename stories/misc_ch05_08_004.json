        { "location": "1756/TALK"    , "narrator": "神楽", "text": "見★参★"},
        { "location": "1758/SEL"     , "narrator": "", "text": "ていうか誰？"},
        { "location": "1759/SEL"     , "narrator": "", "text": "姿を見せたなラブリーえんじぇる！"},
        { "location": "1760/SEL"     , "narrator": "", "text": "チラのあるなしで継続視聴を検討する"},
        { "location": "1761/ACT"     , "narrator": "", "text": "ていうか誰？"},
        { "location": "1762/TALK"    , "narrator": "神楽", "text": "知らないの？"},
        { "location": "1763/ACT"     , "narrator": "", "text": "姿を見せたなラブリーえんじぇる！"},
        { "location": "1765/TALK"    , "narrator": "神楽", "text": "ふはははははは！"},
        { "location": "1766/TALK"    , "narrator": "神楽", "text": "大悪党$handlek$め！"},
        { "location": "1767/TALK"    , "narrator": "神楽", "text": "成敗してくれるわ！"},
        { "location": "1768/TALK"    , "narrator": "神楽", "text": "ってこれじゃ全然ラブリーでもえんじぇるでもない"},
        { "location": "1770/TALK"    , "narrator": "神楽", "text": "なんでよ、、、"},
        { "location": "1771/ACT"     , "narrator": "", "text": "チラのあるなしで継続視聴を検討する"},
        { "location": "1772/TALK"    , "narrator": "神楽", "text": "うわさいあく"},
        { "location": "1773/TALK"    , "narrator": "神楽", "text": "キモ豚だった"},
        { "location": "1775/TALK"    , "narrator": "神楽", "text": "強制執行ラブリーえんじぇるは"},
        { "location": "1776/TALK"    , "narrator": "神楽", "text": "ぴょんこが今適当に考えた魔法少女ナリ☆彡"},
        { "location": "1778/SEL"     , "narrator": "", "text": "そうナリか"},
        { "location": "1779/SEL"     , "narrator": "", "text": "コンセプトぶれぶれじゃない？"},
        { "location": "1780/SEL"     , "narrator": "", "text": "チラは必須条件だから！"},
        { "location": "1781/ACT"     , "narrator": "", "text": "そうナリか"},
        { "location": "1782/TALK"    , "narrator": "神楽", "text": "そうナリよ"},
        { "location": "1784/TALK"    , "narrator": "神楽", "text": "よろしくね☆彡"},
        { "location": "1785/ACT"     , "narrator": "", "text": "コンセプトぶれぶれじゃない？"},
        { "location": "1786/TALK"    , "narrator": "神楽", "text": "そんなことはない"},
        { "location": "1787/TALK"    , "narrator": "神楽", "text": "深夜枠のアニメ好きには刺さるはずぴょん"},
        { "location": "1788/ACT"     , "narrator": "", "text": "チラは必須条件だから！"},
        { "location": "1789/TALK"    , "narrator": "神楽", "text": "こだわるね$handlek$"},
        { "location": "1790/TALK"    , "narrator": "神楽", "text": "そこまで言うならチラ部分の作画監督に任命してあげるぴょん"},
        { "location": "1792/TALK"    , "narrator": "神楽", "text": "ラブリーえんじぇるは何を強制執行するのか？"},
        { "location": "1793/TALK"    , "narrator": "神楽", "text": "そしてラブリーえんじぇるの行き着く先は？"},
        { "location": "1794/TALK"    , "narrator": "神楽", "text": "謎は謎のままこの話はおしまい。"},
