{
    "dir": "chap11/daydra/dd_ch01_11_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "11105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "親離れ子離れ＜後編＞"
    },
    "entry":
    [
        { "location": "579/SCENARIO", "narrator": "", "text": "親離れ子離れ"},
        { "location": "606/TALK"    , "narrator": "つばめ", "text": "ごめんなさい"},
        { "location": "607/TALK"    , "narrator": "つばめ", "text": "本当は"},
        { "location": "608/TALK"    , "narrator": "つばめ", "text": "帰れたの"},
        { "location": "609/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "610/TALK"    , "narrator": "つばめ", "text": "面倒くさくなっちゃって"},
        { "location": "612/SEL"     , "narrator": "", "text": "正直に言わなきゃ"},
        { "location": "613/ACT"     , "narrator": "", "text": "正直に言わなきゃ"},
        { "location": "615/TALK"    , "narrator": "つばめ", "text": "うん"},
        { "location": "616/TALK"    , "narrator": "つばめ", "text": "ちゃんと"},
        { "location": "617/TALK"    , "narrator": "つばめ", "text": "お父さんに話すよ"},
        { "location": "629/TALK"    , "narrator": "つばめ", "text": "はぁ…。"},
        { "location": "631/TALK"    , "narrator": "啓介", "text": "…話は終わったのか？"},
        { "location": "634/TALK"    , "narrator": "つばめ", "text": "えっ！？　あ、ああ、\nえっと…。"},
        { "location": "635/TALK"    , "narrator": "つばめ", "text": "いけない…。\nスマホ弄ってるの\n見られちゃった…。"},
        { "location": "637/TALK"    , "narrator": "啓介", "text": "…まあいい。\nこっちも、大体の話は\n終わったところだ。"},
        { "location": "638/TALK"    , "narrator": "真幌", "text": "逢瀬隊員。\n劇場の仕事は\nもういいので――"},
        { "location": "639/TALK"    , "narrator": "真幌", "text": "今日はお父上と\n帰宅しなさい。"},
        { "location": "641/TALK"    , "narrator": "つばめ", "text": "えっ！？\n帰宅って…。"},
        { "location": "642/TALK"    , "narrator": "真幌", "text": "もちろん、寮です。"},
        { "location": "643/TALK"    , "narrator": "つばめ", "text": "…わかりました。\n失礼します。"},
        { "location": "648/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "649/TALK"    , "narrator": "真幌", "text": "はぁぁぁぁぁぁ～…。"},
        { "location": "650/TALK"    , "narrator": "真幌", "text": "…一応の説得は\n出来たと思うが――"},
        { "location": "651/TALK"    , "narrator": "真幌", "text": "あのオヤジ…、\n大人しく帰って\nくれるだろうか？"},
        { "location": "670/TALK"    , "narrator": "つばめ", "text": "…そうだ。\n帰らなかったこと、\nちゃんと謝らなきゃ。"},
        { "location": "671/TALK"    , "narrator": "つばめ", "text": "でも…。"},
        { "location": "672/TALK"    , "narrator": "啓介", "text": "ふん…部屋は\nいいものが支給されて\nいるんだな。"},
        { "location": "673/TALK"    , "narrator": "つばめ", "text": "う、うん…。"},
        { "location": "674/TALK"    , "narrator": "つばめ", "text": "…正直に言ったら、\n怒られちゃう、かな？"},
        { "location": "675/SEL"     , "narrator": "", "text": "頑張れ！"},
        { "location": "676/ACT"     , "narrator": "", "text": "頑張れ！"},
        { "location": "693/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "694/TALK"    , "narrator": "つばめ", "text": "怖いよ"},
        { "location": "696/SEL"     , "narrator": "", "text": "$me$が付いてる"},
        { "location": "697/ACT"     , "narrator": "", "text": "$me$が付いてる"},
        { "location": "700/TALK"    , "narrator": "つばめ", "text": "ありがと"},
        { "location": "702/TALK"    , "narrator": "つばめ", "text": "わたし"},
        { "location": "703/TALK"    , "narrator": "つばめ", "text": "頑張ってみる！"},
        { "location": "715/TALK"    , "narrator": "つばめ", "text": "…あ、あの、\nお父さん…。"},
        { "location": "717/TALK"    , "narrator": "啓介", "text": "なんだ？"},
        { "location": "718/TALK"    , "narrator": "つばめ", "text": "わ、わたし…、\nわたしね――"},
        { "location": "719/TALK"    , "narrator": "つばめ", "text": "一つ、訂正しないと\nいけないことが\nあるんだけど…。"},
        { "location": "720/TALK"    , "narrator": "啓介", "text": "…言ってみろ。"},
        { "location": "721/TALK"    , "narrator": "つばめ", "text": "あの、帰らなかった\n理由なんだけど――"},
        { "location": "722/TALK"    , "narrator": "つばめ", "text": "別に、帰ろうと思えば\n普通に帰れたの。"},
        { "location": "723/TALK"    , "narrator": "つばめ", "text": "だけど、わたしが\nちょっとダメな\n感じで――"},
        { "location": "725/TALK"    , "narrator": "つばめ", "text": "先延ばしにしちゃった\nだけで…。"},
        { "location": "726/TALK"    , "narrator": "啓介", "text": "…そうか。"},
        { "location": "727/TALK"    , "narrator": "つばめ", "text": "う、うん…。\n怒らないの？"},
        { "location": "728/TALK"    , "narrator": "啓介", "text": "今更。"},
        { "location": "729/TALK"    , "narrator": "啓介", "text": "どうせそんなこと\nだろうと思っていた\nからな。"},
        { "location": "730/TALK"    , "narrator": "つばめ", "text": "えっ！？\n気付いてたの？"},
        { "location": "731/TALK"    , "narrator": "啓介", "text": "いつものこと\nだからな。"},
        { "location": "733/TALK"    , "narrator": "つばめ", "text": "あ、あはは…、\nそっかぁ…。"},
        { "location": "734/TALK"    , "narrator": "つばめ", "text": "…お父さんには、\n隠し事できないなぁ。"},
        { "location": "736/TALK"    , "narrator": "啓介", "text": "…それより――"},
        { "location": "737/TALK"    , "narrator": "啓介", "text": "こっちでは、\n上手くやってるのか？"},
        { "location": "739/TALK"    , "narrator": "つばめ", "text": "…うん。\nとっても楽しいよ。"},
        { "location": "740/TALK"    , "narrator": "つばめ", "text": "クラスにも、トライナ\nリーにも、お友達が\nできたし。"},
        { "location": "741/TALK"    , "narrator": "啓介", "text": "…………。"},
        { "location": "742/TALK"    , "narrator": "啓介", "text": "怪我したりは\nしてないんだろうな？"},
        { "location": "743/TALK"    , "narrator": "つばめ", "text": "うん、大丈夫。"},
        { "location": "744/TALK"    , "narrator": "つばめ", "text": "トライナリーに\nなると\n無敵なんだよ？"},
        { "location": "745/TALK"    , "narrator": "つばめ", "text": "変身すれば空だって\n飛べるし――"},
        { "location": "746/TALK"    , "narrator": "つばめ", "text": "鉄よりも硬くなったり\nできるの。"},
        { "location": "747/TALK"    , "narrator": "啓介", "text": "…………。"},
        { "location": "748/TALK"    , "narrator": "つばめ", "text": "…なんか、嬉しいな。"},
        { "location": "749/TALK"    , "narrator": "つばめ", "text": "お父さんが、こんなに\n色んなこと聞いてくる\nなんて…。"},
        { "location": "750/TALK"    , "narrator": "つばめ", "text": "…それだけ、\n心配させちゃってた\nってことだよね…。"},
        { "location": "751/TALK"    , "narrator": "つばめ", "text": "…あの、お父さん。\nお母さんは…どう？"},
        { "location": "752/TALK"    , "narrator": "啓介", "text": "…今月から名古屋の\n先進医療病院に\n変わったもんでな。"},
        { "location": "753/TALK"    , "narrator": "啓介", "text": "それから\nだいぶ楽に\nなったようだ。"},
        { "location": "754/TALK"    , "narrator": "つばめ", "text": "そっか…よかった。"},
        { "location": "755/TALK"    , "narrator": "啓介", "text": "おまえのこと、\n心配してたぞ。"},
        { "location": "756/TALK"    , "narrator": "啓介", "text": "東京で一人、\n不安にしてるんじゃ\nないか、ってな。"},
        { "location": "758/TALK"    , "narrator": "つばめ", "text": "…ごめんなさい。\nお母さんにも、\n心配かけちゃって。"},
        { "location": "760/TALK"    , "narrator": "啓介", "text": "…これからも、\nフェノメノン退治は\n続けるのか？"},
        { "location": "761/TALK"    , "narrator": "つばめ", "text": "続けるよ。"},
        { "location": "762/TALK"    , "narrator": "つばめ", "text": "わたしを必要として\nくれている人も\nいるし――"},
        { "location": "763/TALK"    , "narrator": "つばめ", "text": "わたしも、護りたい\n大切な人が\n沢山できたから。"},
        { "location": "764/TALK"    , "narrator": "つばめ", "text": "それに、ずっと病院に\nいたわたしを――"},
        { "location": "765/TALK"    , "narrator": "つばめ", "text": "沢山の借金して、\n先進医療を受けさせて\nもらったでしょ？"},
        { "location": "766/TALK"    , "narrator": "つばめ", "text": "そのおかげで、\nこんなに元気にして\nもらったんだから――"},
        { "location": "767/TALK"    , "narrator": "つばめ", "text": "今度は、わたしが\nみんなの喜ぶことを\nしたいんだ。"},
        { "location": "768/TALK"    , "narrator": "つばめ", "text": "それに、お母さんにも\n今の病院で治療受けて\nもらって――"},
        { "location": "769/TALK"    , "narrator": "つばめ", "text": "元気になってほしい\nから…トライナリーは\n続けるよ。"},
        { "location": "771/TALK"    , "narrator": "啓介", "text": "…………。"},
        { "location": "772/TALK"    , "narrator": "つばめ", "text": "心配しないで。\nわたしは\n大丈夫だから！"},
        { "location": "773/TALK"    , "narrator": "つばめ", "text": "わたしだって、\nもう子供じゃないん\nだから！"},
        { "location": "776/TALK"    , "narrator": "つばめ", "text": "バーン！"},
        { "location": "777/TALK"    , "narrator": "啓介", "text": "？"},
        { "location": "779/TALK"    , "narrator": "つばめ", "text": "ほら、胸だって\n結構あるんだから。\n知ってた？"},
        { "location": "781/TALK"    , "narrator": "啓介", "text": "…そういうところが\n子供なんだ。"},
        { "location": "784/TALK"    , "narrator": "つばめ", "text": "もぅ、ちょっとくらい\nドキドキしない？"},
        { "location": "785/TALK"    , "narrator": "啓介", "text": "するか。"},
        { "location": "787/TALK"    , "narrator": "つばめ", "text": "ちぇー、もういいよ。"},
        { "location": "788/TALK"    , "narrator": "啓介", "text": "…それより、\nそこに立ちなさい。"},
        { "location": "789/TALK"    , "narrator": "つばめ", "text": "え？　もしかして\n写真撮るの？"},
        { "location": "790/TALK"    , "narrator": "啓介", "text": "ああ、\n母さんに見せる。"},
        { "location": "791/TALK"    , "narrator": "つばめ", "text": "あ、うん…。\nこのままでいい？"},
        { "location": "792/TALK"    , "narrator": "啓介", "text": "ああ…写真はやめて\n動画にしよう。"},
        { "location": "793/TALK"    , "narrator": "つばめ", "text": "えぇっ！？\nちょっと、そんな！"},
        { "location": "810/TALK"    , "narrator": "つばめ", "text": "え、えっと…。"},
        { "location": "812/TALK"    , "narrator": "つばめ", "text": "お、お母さーん、\nつばめだよ。\n調子はどうかな？"},
        { "location": "813/TALK"    , "narrator": "つばめ", "text": "つばめは\n楽しくやってるよ。"},
        { "location": "814/TALK"    , "narrator": "つばめ", "text": "でも、全然帰れなくて\nごめんね。"},
        { "location": "816/TALK"    , "narrator": "つばめ", "text": "んと、こっちに来て\nいっぱいお友達も\nできました。"},
        { "location": "817/TALK"    , "narrator": "つばめ", "text": "任務は大変だけど、\n優しい先輩が護って\nくれるから――"},
        { "location": "818/TALK"    , "narrator": "つばめ", "text": "全然怖くないよ。"},
        { "location": "820/TALK"    , "narrator": "つばめ", "text": "あーっ…えっと、\n近いうちに\n絶対帰るから――"},
        { "location": "821/TALK"    , "narrator": "つばめ", "text": "もうちょっとだけ\n待っててね。"},
        { "location": "822/TALK"    , "narrator": "つばめ", "text": "あまり無理しちゃ\nダメだよ？"},
        { "location": "824/TALK"    , "narrator": "つばめ", "text": "それじゃ、ね。\nばいばーい。"},
        { "location": "841/TALK"    , "narrator": "啓介", "text": "…………。"},
        { "location": "842/TALK"    , "narrator": "つばめ", "text": "お母さん、\n喜んでくれるかな？"},
        { "location": "843/TALK"    , "narrator": "啓介", "text": "おまえが家に帰るのが\n一番喜ぶ。"},
        { "location": "845/TALK"    , "narrator": "つばめ", "text": "わ、わかってるよ…。"},
        { "location": "846/TALK"    , "narrator": "つばめ", "text": "…冗談抜きで、\n一度帰らないと\nいけないなぁ…。"},
        { "location": "847/TALK"    , "narrator": "つばめ", "text": "…それより、\n今日はこっちに\n泊まってくんでしょ？"},
        { "location": "848/TALK"    , "narrator": "つばめ", "text": "それなら、わたしの\nベッドを使って――"},
        { "location": "850/TALK"    , "narrator": "啓介", "text": "バカ言え、できるか。"},
        { "location": "851/TALK"    , "narrator": "啓介", "text": "近くに宿を取るから\n大丈夫だ。"},
        { "location": "853/TALK"    , "narrator": "つばめ", "text": "…そっか。"},
        { "location": "854/TALK"    , "narrator": "啓介", "text": "…ちゃんと\n戸締りをしろよ。"},
        { "location": "855/TALK"    , "narrator": "啓介", "text": "それと、父さんは\nまだ――"},
        { "location": "856/TALK"    , "narrator": "啓介", "text": "フェノメノン退治を\n認めたわけじゃ\nないからな。"},
        { "location": "857/TALK"    , "narrator": "つばめ", "text": "わかってる\nわかってる。"},
        { "location": "859/TALK"    , "narrator": "啓介", "text": "また連絡する。"},
        { "location": "861/TALK"    , "narrator": "つばめ", "text": "うん、バイバイ。\n来てくれて、\nありがとね。"},
        { "location": "867/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "879/TALK"    , "narrator": "つばめ", "text": "お父さん"},
        { "location": "881/TALK"    , "narrator": "つばめ", "text": "わたしがウソついてたの"},
        { "location": "882/TALK"    , "narrator": "つばめ", "text": "最初から知ってたね"},
        { "location": "884/SEL"     , "narrator": "", "text": "つばめのこと、理解してるんだよ"},
        { "location": "885/ACT"     , "narrator": "", "text": "つばめのこと、理解してるんだよ"},
        { "location": "887/TALK"    , "narrator": "つばめ", "text": "うん"},
        { "location": "888/TALK"    , "narrator": "つばめ", "text": "正直に言ってよかった"},
        { "location": "889/TALK"    , "narrator": "つばめ", "text": "それに"},
        { "location": "890/TALK"    , "narrator": "つばめ", "text": "あのままウソついてたら"},
        { "location": "891/TALK"    , "narrator": "つばめ", "text": "今頃"},
        { "location": "892/TALK"    , "narrator": "つばめ", "text": "きっとモヤモヤしてたと思うし"},
        { "location": "894/SEL"     , "narrator": "", "text": "言えてよかったね"},
        { "location": "895/ACT"     , "narrator": "", "text": "言えてよかったね"},
        { "location": "897/TALK"    , "narrator": "つばめ", "text": "うん"},
        { "location": "898/TALK"    , "narrator": "つばめ", "text": "$handle$さんが"},
        { "location": "899/TALK"    , "narrator": "つばめ", "text": "正直に話すきっかけをくれたから"},
        { "location": "900/TALK"    , "narrator": "つばめ", "text": "そのおかげだよ"},
        { "location": "901/TALK"    , "narrator": "つばめ", "text": "ありがと、$handle$さん"},
        { "location": "925/DIALOG"  , "narrator": "Dialog_chapter_ch01", "text": "【09 パーフェクトイエロー】"}
    ]
}
