        { "location": "144/SCENARIO", "narrator": "", "text": "480_泡と消える前に"},
        { "location": "169/TALK"    , "narrator": "ガブリエラ", "text": "$handle$さま\n伝えきれなかったから\nもう一度録ってみたの"},
        { "location": "170/TALK"    , "narrator": "ガブリエラ", "text": "聞いてくれるかしら？"},
        { "location": "172/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "173/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "175/TALK"    , "narrator": "ガブリエラ", "text": "よかった"},
        { "location": "177/TALK"    , "narrator": "ガブリエラ", "text": "送るわね"},
        { "location": "180/TALK"    , "narrator": "ボイスメール", "text": "その先のこと"},
        { "location": "200/TALK"    , "narrator": "ガブリエラ", "text": "ええと"},
        { "location": "201/TALK"    , "narrator": "ガブリエラ", "text": "何て言ったと思う？"},
        { "location": "202/TALK"    , "narrator": "ガブリエラ", "text": "聞く前に当ててみて"},
        { "location": "204/SEL"     , "narrator": "", "text": "お付き合いしましょう"},
        { "location": "205/SEL"     , "narrator": "", "text": "恋人同士になろう"},
        { "location": "206/ACT"     , "narrator": "", "text": "お付き合いしましょう"},
        { "location": "207/TALK"    , "narrator": "ガブリエラ", "text": "わかっちゃったかしら///////////////"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "どう"},
        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "思ってるの？"},
        { "location": "210/ACT"     , "narrator": "", "text": "恋人同士になろう"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "ええ//////////////////////////"},
        { "location": "212/TALK"    , "narrator": "ガブリエラ", "text": "そうなのよ///////////////"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "がんばったから////////////"},
        { "location": "215/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんと聞いてね////////////"},
        { "location": "192/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【ガブリエラ】</color>のボイスメール\n<color=red>【その先のこと】</color>\nをゲットしました！"}
