        { "location": "198/TALK"    , "narrator": "ガブリエラ", "text": "イメチェンしようと思うの"},
        { "location": "199/TALK"    , "narrator": "ガブリエラ", "text": "どんな髪型がいいかしら"},
        { "location": "201/SEL"     , "narrator": "", "text": "スキンヘッドはどう"},
        { "location": "202/SEL"     , "narrator": "", "text": "今のが似合ってるのに"},
        { "location": "203/SEL"     , "narrator": "", "text": "どんな髪型でもかわいいよ"},
        { "location": "204/ACT"     , "narrator": "", "text": "スキンヘッドはどう"},
        { "location": "205/TALK"    , "narrator": "ガブリエラ", "text": "まあ！"},
        { "location": "207/TALK"    , "narrator": "ガブリエラ", "text": "冗談にしてもひどいわ"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$ったら！！"},
        { "location": "209/ACT"     , "narrator": "", "text": "今のが似合ってるのに"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "212/ACT"     , "narrator": "", "text": "どんな髪型でもかわいいよ"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "いやだわ$marzanna$ったら/////////////"},
        { "location": "215/TALK"    , "narrator": "ガブリエラ", "text": "照れちゃうわｖｖｖｖｖｖ"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "もう//////////////"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "今の髪型も気に入ってはいるのよ"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "でも色々試してもいいかしらって思っているの"},
        { "location": "221/SEL"     , "narrator": "", "text": "いいんじゃない"},
        { "location": "222/SEL"     , "narrator": "", "text": "可能性に挑戦だ"},
        { "location": "223/SEL"     , "narrator": "", "text": "変えたら見せてね"},
        { "location": "224/ACT"     , "narrator": "", "text": "いいんじゃない"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと考えてみるわ"},
        { "location": "227/ACT"     , "narrator": "", "text": "可能性に挑戦だ"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "そんな大げさな話じゃないわよ？"},
        { "location": "229/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "230/TALK"    , "narrator": "ガブリエラ", "text": "そのくらいの気合で考えてもいいのかしらね"},
        { "location": "231/ACT"     , "narrator": "", "text": "変えたら見せてね"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "もちろんよ"},
