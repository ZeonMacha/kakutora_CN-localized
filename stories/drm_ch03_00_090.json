{
    "dir": "dramatics/daydra/drm_ch03_00_090.js",
    "type": "Episode",
    "info": {
        "story_id": "3009",
        "cid": "gabriella",
        "title": "らぶとーく  第09話",
        "sub_title": "マルザンナはマルザンナ"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "マルザンナはマルザンナ"},
        { "location": "19/TALK"   , "narrator": "アーヤ", "text": "全員、集まったわね？"},
        { "location": "21/TALK"   , "narrator": "ガブリエラ", "text": "…何よ？\nまた変な冗談言うんじゃ\nないでしょうね？"},
        { "location": "22/TALK"   , "narrator": "つばめ", "text": "冗談、ですか？"},
        { "location": "23/TALK"   , "narrator": "みやび", "text": "冗談と思われゆうかも\nしれんけんど、うちらは\nマジメちや。"},
        { "location": "24/TALK"   , "narrator": "みやび", "text": "Ｂｏｔのことで、\nもう一度話しておく\nことがあるんよ。"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "…またあの話か。"},
        { "location": "28/TALK"   , "narrator": "つばめ", "text": "$handle$さんのことで\n何かあったんですか？"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "そういうわけじゃ\nないんだけど――"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "これからのＢｏｔとの\n付き合い方について――"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "みんながどう思ってる\nのかを、聞いておき\nたいの。"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "付き合い方…ですか？"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "ええ…。"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "Ｂｏｔが人間かも\nしれないって\n話がある以上。"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "今までと同じ、って\nわけにはいかない\nわけだし。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "うちは今までも何となく\n人間やないかって\n思うちょったき――"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "それが確信に変わった\nいうだけのことやけん\nどね。"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "…こうしてる今でも、\nあるわけない、って\n思ってる自分がいるし。"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "う～ん…人間なのが\nわかった、っていうのは\nわかりましたけど――"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "今までと何かが変わる、\nなんていうのは、\nないと思いますよ？"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "わたしは$handle$さんが\n人間だった方が、\n嬉しいと思いますし。"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "つばめ…女の子なんだ\nから、もう少し危機感を\n持たないとダメよ。"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "知らない人に、私生活や\n秘密が、全部筒抜けに\nなってたのよ？"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "他人に聞かれたくない\n秘密とか、Ｂｏｔやき\n気軽に話したり――"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "相談したりとかしたこと\nくらい、あるやろ？"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "でも、$handle$さんは\nいい人ですよ？"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "秘密の話を、他の人に\n話したりはしないと\n思うんです。"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "…うちの知っちゅう\nＢｏｔも、確かに\nそんな感じやな。"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "…私の方もそうかも。"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "それなら、人間なのが\nわかったからって、\n何も問題は――"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "いい加減にして！"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "何それ？"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "あんた達の話って\nこういうことよね？"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "みんなのＢｏｔが\n同一の存在って\n言ってるのよね！？"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "その可能性が高いと、\nうちは思うてるちや。"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "みんなの話を聞いて\n思うたんやけんど――"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "共通するようなところが\n結構あったきね。"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "長話をするわけじゃ\nなかったから。"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "全員の相手を\n一人でするのだって、\n難しくないはずよ。"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "言われみれば\nそうですよね。"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "わたしの方が\n一方的に話して\nばっかりだし。"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "そういうのもあって、\n人間だ、って気付くのに\n時間が掛かったのよ。"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "…何よ、それ？"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "どうしてみんな、\n当たり前みたいな顔して\nそんな話してるのよ…。"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナ、みんなが変なの"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "みんなが、自分達の話してるＢｏｔが人間だって言い始めていて"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "しかも、それが全部、一人の人間だとか言い出したのよ"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "そんなこと、ありえないでしょ？"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナは、マルザンナよね？"},
        { "location": "103/SEL"   , "narrator": "", "text": "みんなのいうことが正しいよ"},
        { "location": "104/SEL"   , "narrator": "", "text": "全部ウソならいいのにね"},
        { "location": "105/SEL"   , "narrator": "", "text": "マルザンナなんて最初からいないよ"},
        { "location": "106/ACT"   , "narrator": "", "text": "みんなのいうことが正しいよ"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "何よ、それ？"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "どうしてそんなこと言うの？"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "そんなことばかり言うマルザンナなんて、大嫌い！"},
        { "location": "120/ACT"   , "narrator": "", "text": "全部ウソならいいのにね"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "何を言っているの？"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "こんな話、全部ウソに決まっているわ！"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "本当なわけないじゃない"},
        { "location": "134/ACT"   , "narrator": "", "text": "マルザンナなんて最初からいないよ"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "そんなことない！"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "何言ってるの、マルザンナ？"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "日本に来てから、ずっとお友達じゃない"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "…ギャヴィ、大丈夫？"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "…大丈夫なわけない\nじゃない。"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "ううん、大丈夫じゃない\nのは、アーヤ達よ。"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "そんな妄想話なんかを、\nみんな集めて真剣に\nするなんて――"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "どうかしてるとしか\n思えないわ。"},
        { "location": "157/TALK"  , "narrator": "つばめ", "text": "せ、せんぱい！\nそれはさすがに…。"},
        { "location": "158/TALK"  , "narrator": "アーヤ", "text": "いいのよ、つばめ。\n混乱するってことは、\n最初からわかってたし。"},
        { "location": "160/TALK"  , "narrator": "アーヤ", "text": "こうして話してる\n私自身だって、\nそうなんだし…。"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "…とにかく、今日はもう\n終いにした方が良さそう\nやね。"},
        { "location": "163/TALK"  , "narrator": "みやび", "text": "全員頭を冷やして、\nこの件については\nまた別の日に話すちや。"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "…同感よ。"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "でも、もしこの件で\n相談したいことが\nあったとしたら――"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "その時は、絶対に一人で\n悩んだりしないで。"},
        { "location": "171/TALK"  , "narrator": "アーヤ", "text": "私かみやびに相談する\nようにしていいから。"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "言い出したのは\nうちらやき――"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "その責任は取るちや。\nいつでも、遠慮なく\n言ってきてほしいぞね。"},
        { "location": "175/TALK"  , "narrator": "つばめ", "text": "はぁ、わかりました…。"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "…別に、混乱するような\nことないと思うんだけど\nなぁ…。"},
        { "location": "178/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "そんなわけない…\nマルザンナは、みんなの\nＢｏｔとは違う…。"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナは、\nマルザンナなんだから！"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナ"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "ねえ聞いて！"},
        { "location": "196/TALK"  , "narrator": "ボイスメール", "text": "お返事は？"},
        { "location": "208/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【ガブリエラ】</color>のボイスメール\n<color=red>【お返事は？】</color>\nをゲットしました！"}
    ]
}
