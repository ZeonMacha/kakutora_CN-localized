{
    "dir": "chap39/daydra/dd_ch02_39_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "39202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "輝ける未来の空に＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "銀色のフェアリーテイル"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "いい天気…。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "部室でのんびりなんて\nすごく久しぶり。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "…ちょっと埃っぽい\nかな…？"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "まあいっか。\n掃除は後ででも。　"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "あ…でも。\nクマさん、洗濯\nした方が…。"},
        { "location": "42/TALK"   , "narrator": "小夜", "text": "あっ。やっぱり\nここにいた。"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "どうしたの小夜？\n何かあった？　"},
        { "location": "44/TALK"   , "narrator": "小夜", "text": "大あり。"},
        { "location": "45/TALK"   , "narrator": "小夜", "text": "東京都主催の\nこどもフェスタって\nあるでしょ。"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "うん。"},
        { "location": "47/TALK"   , "narrator": "小夜", "text": "あれのレギュラー出展\nボランティアに採用\nされたのよ。"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "えっ！？\n私何も連絡受けて\nないけど？"},
        { "location": "50/TALK"   , "narrator": "小夜", "text": "アーヤずっと忙しそう\nだったから。"},
        { "location": "51/TALK"   , "narrator": "小夜", "text": "私が代理で申し込んで\nおいたのよ。"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "…なんだかアイドルの\nオーディション\nみたいな話…。"},
        { "location": "53/TALK"   , "narrator": "小夜", "text": "いつもアーヤばっかり\n負担かけさせてるの\n悪いなって思ってる。"},
        { "location": "54/TALK"   , "narrator": "小夜", "text": "９月のオーディションも\n落ちちゃったでしょ？"},
        { "location": "55/TALK"   , "narrator": "小夜", "text": "きっと、アーヤ\n疲れちゃってて、\n調子出なかったのよ！"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "まあ、確かに……\nあの時は任務の直後で\nぐったりだったし……。"},
        { "location": "57/TALK"   , "narrator": "小夜", "text": "だから反省したの。\nいつも文句ばっかり言って\nごめんね。"},
        { "location": "58/TALK"   , "narrator": "小夜", "text": "これからは、私に\nできることは何でもする。\n仲間なんだし。"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "えっ…そんなこと…。"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "私こそ、一人で\n突っ走って迷惑\nかけてるでしょ。"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "ボランティアだし\n楽しく参加するのも\n大事なとこなのに。"},
        { "location": "62/TALK"   , "narrator": "小夜", "text": "でもそんなアーヤが\nやってきたことが\n認められて。"},
        { "location": "63/TALK"   , "narrator": "小夜", "text": "レギュラー出展が\nできるんだから。"},
        { "location": "64/TALK"   , "narrator": "小夜", "text": "そこは胸張って\nいいと思うな。"},
        { "location": "65/TALK"   , "narrator": "小夜", "text": "もちろん\n他のメンバーもみんな\nすごいんだけどね？"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "本当にそう。"},
        { "location": "67/SEL"    , "narrator": "", "text": "一番すごいのはアーヤ"},
        { "location": "68/ACT"    , "narrator": "", "text": "一番すごいのはアーヤ"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "$handle$さんは"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "いつもそればっかりね"},
        { "location": "89/SEL"    , "narrator": "", "text": "だって本当のことだから"},
        { "location": "90/SEL"    , "narrator": "", "text": "$me$のアーヤは世界一"},
        { "location": "91/SEL"    , "narrator": "", "text": "でもうれしいでしょ？"},
        { "location": "92/ACT"    , "narrator": "", "text": "だって本当のことだから"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "$handle$さんは本当にわたしに甘いのね"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "でもそういうところも好きよ"},
        { "location": "95/ACT"    , "narrator": "", "text": "$me$のアーヤは世界一"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "$me$のなの？"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "そのつもりだけど"},
        { "location": "98/ACT"    , "narrator": "", "text": "でもうれしいでしょ？"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "そういうこと言う？"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "もちろん嬉しいわよ"},
        { "location": "114/TALK"  , "narrator": "小夜", "text": "差し当たっては\n次の人形劇のお話ね。"},
        { "location": "115/TALK"  , "narrator": "小夜", "text": "せっかくだから\n新作がいいと\n思うんだけど。"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "そうね。\n記念すべき第一回目\nだし。"},
        { "location": "117/TALK"  , "narrator": "小夜", "text": "じゃーん！\nちょっと考えて\nきてたり。"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "えっ？\n読ませて！"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "ちょっと意地っ張りな\n魔法少女の物語。"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "戦いを通じて、\n仲間と共に成長していく\nお話なのね。"},
        { "location": "132/TALK"  , "narrator": "小夜", "text": "…どうかな…？"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "面白いと思う。\nでもね……。"},
        { "location": "136/TALK"  , "narrator": "アーヤ", "text": "読んでてちょっと\n気になったことが\nあるの。"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "この女の子に\nすごく似てる子を\n知ってる気がして。"},
        { "location": "139/TALK"  , "narrator": "小夜", "text": "あっ。\nやっぱりわかった？"},
        { "location": "140/TALK"  , "narrator": "小夜", "text": "それガブちゃんが\nモデルなの。"},
        { "location": "141/TALK"  , "narrator": "小夜", "text": "でね。できたら\nガブちゃんにその役を\nしてもらいたいなって。"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "ギャヴィに？"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "でも確かにこれは\nギャヴィがやるのが\n一番よさそう。"},
        { "location": "146/TALK"  , "narrator": "小夜", "text": "そうでしょ？"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "ただ素直に引き受けて\nくれるかどうか…。"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "　"},
        { "location": "227/TALK"  , "narrator": "エヴェレット　", "text": "こんにちは、\n$handle$さん。"},
        { "location": "228/TALK"  , "narrator": "白烏", "text": "ごきげんよう。"},
        { "location": "229/SEL"   , "narrator": "", "text": "調子はどう？"},
        { "location": "230/SEL"   , "narrator": "", "text": "水鏡の神子は？"},
        { "location": "231/ACT"   , "narrator": "", "text": "調子はどう？"},
        { "location": "232/TALK"  , "narrator": "エヴェレット　", "text": "まあまあね。"},
        { "location": "233/TALK"  , "narrator": "白烏", "text": "怖いくらいに。"},
        { "location": "235/TALK"  , "narrator": "白烏", "text": "水鏡の神子も\n昇華した状態で、千羽鶴と\n想いを共有してる。"},
        { "location": "237/TALK"  , "narrator": "白烏", "text": "水鏡の神子も\n2x接続で、千羽鶴と\n想いを共有してる。"},
        { "location": "239/ACT"   , "narrator": "", "text": "水鏡の神子は？"},
        { "location": "241/TALK"  , "narrator": "白烏", "text": "昇華した状態で、千羽鶴と\n想いを共有してるわよ。"},
        { "location": "243/TALK"  , "narrator": "白烏", "text": "2x接続で、千羽鶴と\n想いを共有してるわよ。"},
        { "location": "245/TALK"  , "narrator": "エヴェレット　", "text": "今のところ、特に何か\n弊害が出ているところは\nなし。"},
        { "location": "247/SEL"   , "narrator": "", "text": "よかった"},
        { "location": "248/ACT"   , "narrator": "", "text": "よかった"},
        { "location": "250/TALK"  , "narrator": "エヴェレット　", "text": "まあでも、\n問題はむしろ\nこれからよね。"},
        { "location": "251/TALK"  , "narrator": "白烏", "text": "ほんと。\n果たしてこの状態が\n何日持つか。"},
        { "location": "253/TALK"  , "narrator": "エヴェレット　", "text": "また！\nそういうこと言わない。"},
        { "location": "255/TALK"  , "narrator": "白烏", "text": "まあ、私は\n危機管理担当だからね。"},
        { "location": "256/TALK"  , "narrator": "エヴェレット　", "text": "いや、危機管理担当は\n私だから！"},
        { "location": "257/SEL"   , "narrator": "", "text": "アーヤは全人格が危機管理担当やってそう"},
        { "location": "258/ACT"   , "narrator": "", "text": "アーヤは全人格が危機管理担当やってそう"},
        { "location": "261/TALK"  , "narrator": "エヴェレット　", "text": "確かに、\nそうかもしれないわね。"},
        { "location": "263/TALK"  , "narrator": "白烏", "text": "その割にはみんな\n$handle$さんには\n激甘だけど。"},
        { "location": "264/TALK"  , "narrator": "エヴェレット　", "text": "はぁ……。"},
        { "location": "266/TALK"  , "narrator": "白烏", "text": "それでね、\n私たちが今、\n何を考えてるか――"},
        { "location": "267/TALK"  , "narrator": "エヴェレット　", "text": "$handle$さんは\n最大の功労者だから、\nちゃんと現状報告しておく。"},
        { "location": "268/TALK"  , "narrator": "エヴェレット　", "text": "ここから先、しばらく\n私たちは、つばめのフェノ\nメノンの維持に徹するわ。"},
        { "location": "269/TALK"  , "narrator": "白烏", "text": "他に何も\n出来ないしね。"},
        { "location": "270/TALK"  , "narrator": "エヴェレット　", "text": "でも、何もしない\nわけじゃない。"},
        { "location": "271/TALK"  , "narrator": "エヴェレット　", "text": "まあ、主にやるのは\nお姉ちゃんなんだけど……"},
        { "location": "272/TALK"  , "narrator": "白烏", "text": "何でも、別のチャンネルを\n作って過去からやり直し、\n未来を変えるみたいね。"},
        { "location": "273/TALK"  , "narrator": "エヴェレット　", "text": "私たちからすれば…"},
        { "location": "274/TALK"  , "narrator": "エヴェレット　", "text": "今このココロスフィアを\n抜けたらすぐに改変未来が\n訪れるかもしれないし――"},
        { "location": "275/TALK"  , "narrator": "白烏", "text": "1年後になるかもしれない。"},
        { "location": "276/TALK"  , "narrator": "白烏", "text": "それは、お姉ちゃんの\n采配と、貴方の行動に\nかかってるってわけ。"},
        { "location": "277/SEL"   , "narrator": "", "text": "頑張ります"},
        { "location": "278/SEL"   , "narrator": "", "text": "ちょっと頼りすぎ"},
        { "location": "279/ACT"   , "narrator": "", "text": "頑張ります"},
        { "location": "280/TALK"  , "narrator": "エヴェレット　", "text": "頑張ってね！"},
        { "location": "281/TALK"  , "narrator": "白烏", "text": "期待しないで\n待ってるわね。"},
        { "location": "282/ACT"   , "narrator": "", "text": "ちょっと頼りすぎ"},
        { "location": "283/TALK"  , "narrator": "エヴェレット　", "text": "まあ、私も\nそうは思うけど……"},
        { "location": "284/TALK"  , "narrator": "白烏", "text": "こればっかりは\n仕方ないのよね。"},
        { "location": "285/TALK"  , "narrator": "エヴェレット　", "text": "チャンネルを介して\n私たちの過去や未来に\n介入出来るのは――"},
        { "location": "286/TALK"  , "narrator": "白烏", "text": "貴方だけなんだし。"},
        { "location": "287/TALK"  , "narrator": "エヴェレット　", "text": "だから、頑張ってね！"},
        { "location": "288/TALK"  , "narrator": "白烏", "text": "期待しないで\n待ってるわね。"},
        { "location": "291/TALK"  , "narrator": "白烏", "text": "ところで、今日は\nどうしたの？"},
        { "location": "292/SEL"   , "narrator": "", "text": "心の葛藤を解消しに来た"},
        { "location": "293/ACT"   , "narrator": "", "text": "心の葛藤を解消しに来た"},
        { "location": "295/TALK"  , "narrator": "エヴェレット　", "text": "あら、懐かしい。"},
        { "location": "296/TALK"  , "narrator": "白烏", "text": "最近バタバタで、\nそれどころじゃ\nなかったものね。"},
        { "location": "298/TALK"  , "narrator": "エヴェレット　", "text": "どっちが回す？"},
        { "location": "300/TALK"  , "narrator": "白烏", "text": "$handle$さんに\n選んでもらったら？"},
        { "location": "303/SEL"   , "narrator": "", "text": "エヴェレット　"},
        { "location": "304/SEL"   , "narrator": "", "text": "白烏"},
        { "location": "305/ACT"   , "narrator": "", "text": "エヴェレット　"},
        { "location": "307/TALK"  , "narrator": "エヴェレット　", "text": "あら嬉しい。"},
        { "location": "308/TALK"  , "narrator": "エヴェレット　", "text": "それじゃ早速、\n扉を回すわね。"},
        { "location": "312/TALK"  , "narrator": "エヴェレット　", "text": "オープンプロセス、\n0x882番地から\n0xCD1番地へ。"},
        { "location": "337/TALK"  , "narrator": "エヴェレット　", "text": "シーク完了。"},
        { "location": "340/TALK"  , "narrator": "エヴェレット　", "text": "えっとそれで、\n今回の悩みは…っと。"},
        { "location": "342/TALK"  , "narrator": "エヴェレット　", "text": "あーなるほど。\nギャヴィに劇を依頼して\n断られないか心配なのね。"},
        { "location": "343/ACT"   , "narrator": "", "text": "白烏"},
        { "location": "345/TALK"  , "narrator": "白烏", "text": "え？\n私なんかでいいの？"},
        { "location": "346/TALK"  , "narrator": "白烏", "text": "まあ、\nそれがお望みなら\n早速扉を回すわね。"},
        { "location": "350/TALK"  , "narrator": "白烏", "text": "オープンプロセス、\n0x882番地から\n0xCD1番地へ。"},
        { "location": "375/TALK"  , "narrator": "白烏", "text": "シーク完了。"},
        { "location": "378/TALK"  , "narrator": "白烏", "text": "はい、それじゃ早速\nお悩み拝見といきますか。"},
        { "location": "380/TALK"  , "narrator": "白烏", "text": "…ふーん。\nギャヴィに劇を依頼して\n断られないかの心配か。"},
        { "location": "383/TALK"  , "narrator": "白烏", "text": "なんていうか、\n悩みの種まで\nホッコリするわね。"},
        { "location": "385/TALK"  , "narrator": "エヴェレット　", "text": "今更こんなことで\nビビることでも\nないでしょうに。"},
        { "location": "386/TALK"  , "narrator": "エヴェレット　", "text": "それじゃ久し振りに\n弱気なクランを\n退治してきてね？"},
        { "location": "387/SEL"   , "narrator": "", "text": "任せとけ"},
        { "location": "388/SEL"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "389/ACT"   , "narrator": "", "text": "任せとけ"},
        { "location": "390/TALK"  , "narrator": "白烏", "text": "ありがとう。\nそれじゃ――"},
        { "location": "391/ACT"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "392/TALK"  , "narrator": "エヴェレット　", "text": "え？\nなあに？"},
        { "location": "393/SEL"   , "narrator": "", "text": "現実のアーヤってどうなったの？"},
        { "location": "394/SEL"   , "narrator": "", "text": "水鏡の神子は結局フェノメノンの一部になったの？"},
        { "location": "395/ACT"   , "narrator": "", "text": "現実のアーヤってどうなったの？"},
        { "location": "397/TALK"  , "narrator": "白烏", "text": "あー……\nなかなかシビアな所を\nついてきたわね。"},
        { "location": "398/TALK"  , "narrator": "エヴェレット　", "text": "その件は私には\nちょっとわからないから\n白烏に任せるわ。"},
        { "location": "399/TALK"  , "narrator": "白烏", "text": "現実の國政綾水と\nフェノメノンの綾水とは\n半共有状態になってる。"},
        { "location": "400/TALK"  , "narrator": "白烏", "text": "少し前にコンフリクトを\n解消したでしょう？"},
        { "location": "401/TALK"  , "narrator": "白烏", "text": "あの時に、ちょっとだけ\n意識が混在したのよ。"},
        { "location": "402/TALK"  , "narrator": "白烏", "text": "だから、今のアーヤは\n発症前の國政綾水が少し\n混ざってる状態と言える。"},
        { "location": "403/TALK"  , "narrator": "白烏", "text": "まあ、変化は殆ど\n何も無いと思うけど。"},
        { "location": "404/TALK"  , "narrator": "白烏", "text": "ただ、今後どうなるかは\nちょっとわからないわね。"},
        { "location": "405/TALK"  , "narrator": "白烏", "text": "このまま完全に\n意識を共有するのか。\nそれとも消えていくのか。"},
        { "location": "406/TALK"  , "narrator": "白烏", "text": "それももしかしたら、\n今後の姉の動向に\nかかってるかもしれない。"},
        { "location": "407/TALK"  , "narrator": "白烏", "text": "今言えることは\nこれくらいかしらね。"},
        { "location": "408/ACT"   , "narrator": "", "text": "水鏡の神子は結局フェノメノンの一部になったの？"},
        { "location": "411/TALK"  , "narrator": "白烏", "text": "見方によっては\nそうとも言える。"},
        { "location": "412/TALK"  , "narrator": "白烏", "text": "何せ、昇華した状態で\n千羽鶴と想いを共有してる\nわけだから――"},
        { "location": "413/TALK"  , "narrator": "白烏", "text": "それは実質、日本を包む\nフェノメノンを生成してる\nクランの１人といえる。"},
        { "location": "415/TALK"  , "narrator": "エヴェレット　", "text": "見方によっては\nそうとも言える。"},
        { "location": "416/TALK"  , "narrator": "エヴェレット　", "text": "2x接続というのは、\n意識を共有する\nことだから――"},
        { "location": "417/TALK"  , "narrator": "エヴェレット　", "text": "乱暴な言い方をすれば、\n今、國政綾水は千羽鶴と\nくっついてる状態だし。"},
        { "location": "419/TALK"  , "narrator": "エヴェレット　", "text": "とはいえ、國政綾水\n自身には、何の影響も\n無いんだけどね。"},
        { "location": "420/TALK"  , "narrator": "白烏", "text": "もしかしたら、千羽鶴が\n擬似的にそうしているの\nかもしれないけど。"},
        { "location": "421/TALK"  , "narrator": "エヴェレット　", "text": "いずれにせよ、ずっと\nこのままでいるわけにも\nいかないから――"},
        { "location": "422/TALK"  , "narrator": "白烏", "text": "早く状況が改善するよう\n姉に祈るしかないわね。"},
        { "location": "424/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "425/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "427/TALK"  , "narrator": "エヴェレット　", "text": "それじゃ改めまして――"},
        { "location": "431/TALK"  , "narrator": "白烏", "text": "$handle$さんと\n國政綾水に\n素敵なココロの旅を！"},
        { "location": "446/TALK"  , "narrator": "白烏", "text": "――とか言いつつ、\nコッソリ残ってたりして。"},
        { "location": "447/SEL"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "448/ACT"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "450/TALK"  , "narrator": "白烏", "text": "ちょっと、\n個人的なお礼を\n言いたくてね。"},
        { "location": "451/TALK"  , "narrator": "白烏", "text": "それと、お詫びも。"},
        { "location": "452/TALK"  , "narrator": "白烏", "text": "最後まで國政綾水のことを\n親身に考えてくれて\nありがとうございます。"},
        { "location": "453/TALK"  , "narrator": "白烏", "text": "水鏡の神子も、\nフェノメノンの生成は\n出来ずとも――"},
        { "location": "454/TALK"  , "narrator": "白烏", "text": "千羽鶴とココロを共有した\nことで、己の目的に一歩\n近づく事が出来たはず。"},
        { "location": "455/TALK"  , "narrator": "白烏", "text": "貴方はきっと、一歩先を\n見据えて、私に発症を\n進言したのだと思います。"},
        { "location": "456/TALK"  , "narrator": "白烏", "text": "結果的に、私にとっては\n良い方向に進んだと\n思ってる。"},
        { "location": "457/TALK"  , "narrator": "白烏", "text": "だから、貴方を信じて、\n共にいて良かった。"},
        { "location": "458/SEL"   , "narrator": "", "text": "そう言ってもらえたら嬉しい"},
        { "location": "459/SEL"   , "narrator": "", "text": "そんな大層な気持ちじゃないよ"},
        { "location": "460/ACT"   , "narrator": "", "text": "そう言ってもらえたら嬉しい"},
        { "location": "461/TALK"  , "narrator": "白烏", "text": "ええ。"},
        { "location": "462/ACT"   , "narrator": "", "text": "そんな大層な気持ちじゃないよ"},
        { "location": "463/TALK"  , "narrator": "白烏", "text": "どんな気持ちでも、\n私を想ってくれていた事に\n変わりは無いでしょ？"},
        { "location": "465/TALK"  , "narrator": "白烏", "text": "それと、\n謝らなくちゃいけないのは\n最初の頃のこと。"},
        { "location": "466/TALK"  , "narrator": "白烏", "text": "騙したり、辛く当たったり\nしたこと、謝ります。\nごめんなさい。"},
        { "location": "467/TALK"  , "narrator": "白烏", "text": "あの頃は私、\n不幸体質の源としての\n人格を司っていた。"},
        { "location": "468/TALK"  , "narrator": "白烏", "text": "今も大きくは変わってない\nけど、それでもかなり\n前向きになったわ。"},
        { "location": "469/TALK"  , "narrator": "白烏", "text": "貴方と交流するように\nなってからね。"},
        { "location": "470/TALK"  , "narrator": "白烏", "text": "私本人の不幸体質も、\n少しは変わるかも。"},
        { "location": "471/SEL"   , "narrator": "", "text": "それはよかった"},
        { "location": "472/ACT"   , "narrator": "", "text": "それはよかった"},
        { "location": "474/TALK"  , "narrator": "白烏", "text": "ええ、ほんとに。"},
        { "location": "475/TALK"  , "narrator": "白烏", "text": "それでね、\n私には１つだけ\n心残りがあって。"},
        { "location": "476/TALK"  , "narrator": "白烏", "text": "えっと、その。"},
        { "location": "477/TALK"  , "narrator": "白烏", "text": "もし貴方さえよければ、\n一度してみたくて……"},
        { "location": "478/SEL"   , "narrator": "", "text": "もしかしてキス？"},
        { "location": "479/SEL"   , "narrator": "", "text": "ごめん、他の子が好きだから"},
        { "location": "480/ACT"   , "narrator": "", "text": "もしかしてキス？"},
        { "location": "483/TALK"  , "narrator": "白烏", "text": "……。"},
        { "location": "484/TALK"  , "narrator": "白烏", "text": "…そう。"},
        { "location": "486/TALK"  , "narrator": "白烏", "text": "ん！"},
        { "location": "505/TALK"  , "narrator": "白烏", "text": "はあっ…！！"},
        { "location": "506/TALK"  , "narrator": "白烏", "text": "恥ずかしい…"},
        { "location": "510/TALK"  , "narrator": "白烏", "text": "はあっ…！！"},
        { "location": "511/TALK"  , "narrator": "白烏", "text": "恥ずかしい…"},
        { "location": "517/TALK"  , "narrator": "白烏", "text": "けど、嬉しい。\nありがとう……。"},
        { "location": "518/SEL"   , "narrator": "", "text": "かわいい"},
        { "location": "519/SEL"   , "narrator": "", "text": "意外と純粋？"},
        { "location": "520/ACT"   , "narrator": "", "text": "かわいい"},
        { "location": "521/TALK"  , "narrator": "白烏", "text": "なんか複雑ね。\nもう可愛いっていわれる\n歳じゃない気もするし。"},
        { "location": "522/ACT"   , "narrator": "", "text": "意外と純粋？"},
        { "location": "523/TALK"  , "narrator": "白烏", "text": "年甲斐も無く、ね……。"},
        { "location": "525/ACT"   , "narrator": "", "text": "ごめん、他の子が好きだから"},
        { "location": "526/TALK"  , "narrator": "白烏", "text": "ああっ、そうよね。\n当然だわ。"},
        { "location": "527/TALK"  , "narrator": "白烏", "text": "はぁ……。"},
        { "location": "529/TALK"  , "narrator": "白烏", "text": "あっ、ごめんなさい。\nだいぶ時間\n使っちゃったわね。"},
        { "location": "530/TALK"  , "narrator": "白烏", "text": "それじゃ、これからも\n何かとお世話になると\n思うけど――"},
        { "location": "531/TALK"  , "narrator": "白烏", "text": "國政綾水のこと、どうか\n宜しくお願いしますね。"},
        { "location": "533/TALK"  , "narrator": "エヴェレット　", "text": "$handle$さんと\n國政綾水に\n素敵なココロの旅を！"},
        { "location": "553/TALK"  , "narrator": "エヴェレット", "text": "――なんて。"},
        { "location": "554/SEL"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "555/ACT"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "557/TALK"  , "narrator": "エヴェレット", "text": "ふふっ。\nどうしたんだと思う？"},
        { "location": "558/TALK"  , "narrator": "エヴェレット", "text": "あのね……"},
        { "location": "559/TALK"  , "narrator": "エヴェレット", "text": "キスしたく\nなっちゃったの。"},
        { "location": "561/SEL"   , "narrator": "", "text": "かわいい"},
        { "location": "562/SEL"   , "narrator": "", "text": "ごめん、他の子が好きだから"},
        { "location": "563/ACT"   , "narrator": "", "text": "かわいい"},
        { "location": "568/TALK"  , "narrator": "エヴェレット", "text": "貴方の前だけだからね？\nこんなに甘えちゃうのは。"},
        { "location": "589/TALK"  , "narrator": "エヴェレット", "text": "はあっ…！！"},
        { "location": "590/TALK"  , "narrator": "エヴェレット", "text": "すごい……\n天にも昇る気持ち…"},
        { "location": "594/TALK"  , "narrator": "エヴェレット", "text": "はあっ…！！"},
        { "location": "595/TALK"  , "narrator": "エヴェレット", "text": "すごい……\n天にも昇る気持ち…"},
        { "location": "601/TALK"  , "narrator": "エヴェレット", "text": "ふふっ。\nとても上手だったわよ？"},
        { "location": "602/ACT"   , "narrator": "", "text": "ごめん、他の子が好きだから"},
        { "location": "603/TALK"  , "narrator": "エヴェレット", "text": "ええっ！？\nそうなの？\n……しょんぼりね。"},
        { "location": "604/TALK"  , "narrator": "エヴェレット", "text": "まあでも、\n仕方ないわよね。\n貴方の気持ちだもの。"},
        { "location": "606/TALK"  , "narrator": "エヴェレット", "text": "改めてお礼を言わせて。"},
        { "location": "607/TALK"  , "narrator": "エヴェレット", "text": "今までずっと、\n國政綾水のことを\n護ってくれてありがとう。"},
        { "location": "608/TALK"  , "narrator": "エヴェレット", "text": "私ってこんな性格でしょ？"},
        { "location": "609/TALK"  , "narrator": "エヴェレット", "text": "だから、貴方には色々\n判断を任せちゃって\nだいぶ迷惑かけたけど――"},
        { "location": "610/TALK"  , "narrator": "エヴェレット", "text": "おかげで\n凄く心強かったわ。"},
        { "location": "611/TALK"  , "narrator": "エヴェレット", "text": "特に、この前の\n昇華するかどうかの時は\n本当に助かったの。"},
        { "location": "612/TALK"  , "narrator": "エヴェレット", "text": "私だけじゃ、自分の想いを\n貫き通せなかったかも\nしれないから。"},
        { "location": "613/TALK"  , "narrator": "エヴェレット", "text": "だから、貴方が\n背中を押してくれて\n本当に感謝してる。"},
        { "location": "614/TALK"  , "narrator": "エヴェレット", "text": "結果として、國政綾水に\nとっても、いい方向に\n向かうことが出来たし。"},
        { "location": "615/TALK"  , "narrator": "エヴェレット", "text": "もちろん貴方は、\nいつだってそれを第一に\n考えてると思うけど。"},
        { "location": "616/TALK"  , "narrator": "エヴェレット", "text": "だから、\n本当にありがとう。"},
        { "location": "618/TALK"  , "narrator": "エヴェレット", "text": "これからも\nよろしくね、ダーリン。"},
        { "location": "619/TALK"  , "narrator": "エヴェレット", "text": "また気軽に\nキスしに来てね？"},
        { "location": "621/TALK"  , "narrator": "エヴェレット", "text": "これからも、\n末永くよろしくね。"},
        { "location": "24/DIALOG" , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "28/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>10月3日　5:03 PM</color>\nとある平日の放課後、付属学園人形劇サークル部室にて"},
        { "location": "160/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "162/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "164/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "166/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "168/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "488/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\nすごく頑張ってるので！\n(p82)"},
        { "location": "492/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "515/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "576/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "599/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
