        "title": "SideStory008 ストーリー",
        "sub_title": "FILE06.始動"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "東京編６話"},
        { "location": "22/DIALOG" , "narrator": "", "text": "<color=green>9月5日　 4:12 PM</color>\nとある平日の昼休み、付属学園屋上にて"},
        { "location": "23/TALK"   , "narrator": "ヒカル", "text": "…え？\n逢瀬さんの大切な人…、\nですか？"},
        { "location": "24/TALK"   , "narrator": "雛", "text": "そうなの！"},
        { "location": "25/TALK"   , "narrator": "雛", "text": "ほら、つばめちゃんって\nよく誰かとＷＡＶＥで\n話してるでしょ？"},
        { "location": "27/TALK"   , "narrator": "キリト", "text": "えっ？　あれって確か、\nＢｏｔとか\n言ってなかったか？"},
        { "location": "28/TALK"   , "narrator": "雛", "text": "それとは別なのかも。\nそれとも、恥ずかしくて\n言えなかったとか？"},
        { "location": "29/TALK"   , "narrator": "繭", "text": "…とにかく、その人と\n連絡を取ることに\n成功した、と？"},
        { "location": "32/TALK"   , "narrator": "雛", "text": "うん！\n事情を話したら、\n協力してくれるって！"},
        { "location": "34/TALK"   , "narrator": "ヒカル", "text": "…でも、その人って\nどんな人なんだろう？"},
        { "location": "35/TALK"   , "narrator": "ヒカル", "text": "特別攻撃隊の関係者に、\n思い当たる人って\nいたかな？"},
        { "location": "38/TALK"   , "narrator": "キリト", "text": "いや…そもそも逢瀬達と\n東雲教官以外は、\n誰もいないと思うぞ？"},
        { "location": "40/TALK"   , "narrator": "繭", "text": "…管理庁の内部にいる、\n協力者という可能性も\nありえる。"},
        { "location": "43/TALK"   , "narrator": "キリト", "text": "あ、なるほどな。"},
        { "location": "46/TALK"   , "narrator": "繭", "text": "…まあ、ほぼ確実に\n違うとは思うけど。"},
        { "location": "47/TALK"   , "narrator": "キリト", "text": "おまえなぁ…。\nでも、どうして違うと\n思うんだ？"},
        { "location": "49/TALK"   , "narrator": "繭", "text": "そんなスパイがいるなら、\n卯月神楽のスパイ行為は\n筒抜けだったはず。"},
        { "location": "52/TALK"   , "narrator": "繭", "text": "もし見抜けなかったなら、\nただのマヌケ。\nいても邪魔なだけよ。"},
        { "location": "53/TALK"   , "narrator": "キリト", "text": "…なるほどな。"},
        { "location": "56/TALK"   , "narrator": "雛", "text": "でも、つばめちゃんが\n信頼してる人なんだから、\nきっと頼りになるよー。"},
        { "location": "58/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "61/TALK"   , "narrator": "キリト", "text": "…で？　そいつと連絡が\n取れたからって、\nどうしろっていうんだ？"},
        { "location": "64/TALK"   , "narrator": "雛", "text": "…綾水様達は今、\n多分東京にはいないと\n思うんだけど…どう？"},
        { "location": "65/TALK"   , "narrator": "ヒカル", "text": "うん、確か都内を出た\nところまでは確認した、\nって聞いたから…。"},
        { "location": "66/TALK"   , "narrator": "キリト", "text": "そうだったな…。\nその後はわからねぇけど。"},
        { "location": "67/TALK"   , "narrator": "雛", "text": "つまりさ、今、東京で\n自由に動けるのは、\nあたし達だけだよね？"},
        { "location": "68/TALK"   , "narrator": "雛", "text": "だから、あたし達だけで\n行動を始める時だと\n思うんだよー。"},
        { "location": "69/TALK"   , "narrator": "繭", "text": "…ありえない。"},
        { "location": "72/TALK"   , "narrator": "雛", "text": "えーっ、どうしてー！？"},
        { "location": "74/TALK"   , "narrator": "繭", "text": "自殺行為。\n私達だけでどうにかなる\n相手じゃない。"},
        { "location": "75/TALK"   , "narrator": "雛", "text": "別に、戦おうなんて\n思ってないよー。"},
        { "location": "76/TALK"   , "narrator": "雛", "text": "ただ、東京にいない\n綾水様達の代わりに…。"},
        { "location": "77/TALK"   , "narrator": "雛", "text": "つばめちゃんの\n捕まってる場所を探す\nくらいはできるでしょ？"},
        { "location": "78/TALK"   , "narrator": "キリト", "text": "…………。"},
        { "location": "79/TALK"   , "narrator": "ヒカル", "text": "…………。"},
        { "location": "80/TALK"   , "narrator": "雛", "text": "ね！？"},
        { "location": "81/TALK"   , "narrator": "ヒカル", "text": "…ひなこさん。\n逢瀬さんを思う気持ちは、\nよくわかるよ。"},
        { "location": "82/TALK"   , "narrator": "ヒカル", "text": "けど、僕はその考えに\n賛成できない。"},
        { "location": "84/TALK"   , "narrator": "雛", "text": "な、なんで？"},
        { "location": "86/TALK"   , "narrator": "キリト", "text": "素人だからだよ。\n管理庁のヤツラに比べて、\n俺たち全員な。"},
        { "location": "87/TALK"   , "narrator": "雛", "text": "でも、キリト達は――"},
        { "location": "88/TALK"   , "narrator": "キリト", "text": "言ったろ？\n俺たちはまだ学生身分の\n候補生だ、って。"},
        { "location": "89/TALK"   , "narrator": "キリト", "text": "正規隊員のヤツラを\n相手にしたら、\n手も足も出ねぇって…。"},
        { "location": "90/TALK"   , "narrator": "ヒカル", "text": "さっき繭さんが自殺行為と\n言ってたけれど…、\n大げさじゃないよ。"},
        { "location": "91/TALK"   , "narrator": "ヒカル", "text": "今の僕達じゃ、\n万に一つの勝ち目もない。"},
        { "location": "92/TALK"   , "narrator": "雛", "text": "でも！\nこのまま何もしないで\nジッとしてるなんて…。"},
        { "location": "93/TALK"   , "narrator": "繭", "text": "…落ち着いて。"},
        { "location": "95/TALK"   , "narrator": "雛", "text": "落ち着けないよ！\nこうしてる間も、\nつばめちゃんは…。"},
        { "location": "96/TALK"   , "narrator": "繭", "text": "私達が無茶をして\nなにかあれば、\n逢瀬さんが悲しむわ。"},
        { "location": "97/TALK"   , "narrator": "繭", "text": "ひなこは、逢瀬さんに\nそんな想いをさせたいの？"},
        { "location": "100/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "101/TALK"  , "narrator": "キリト", "text": "…なあ、ひなこ。\n俺達だってさ、\n平気じゃないんだぜ？"},
        { "location": "102/TALK"  , "narrator": "キリト", "text": "今だって、管理庁を\n許せねぇって思ってる。"},
        { "location": "103/TALK"  , "narrator": "キリト", "text": "逢瀬を助けたいとも、\n綾水先輩達と連絡を\n取りたいともな…。"},
        { "location": "105/TALK"  , "narrator": "雛", "text": "…でも、何もしないの？"},
        { "location": "106/TALK"  , "narrator": "キリト", "text": "…できるのに、\nしないと思ってるのか？"},
        { "location": "108/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "109/TALK"  , "narrator": "ヒカル", "text": "…とりあえず、\n今日はこの辺にして\n帰りませんか？"},
        { "location": "110/TALK"  , "narrator": "ヒカル", "text": "僕達は、逢瀬さんが\n大切に思う人と連絡を\n取る方法がわかった。"},
        { "location": "111/TALK"  , "narrator": "ヒカル", "text": "それだけでも、\n今日僕達は一歩前進した。"},
        { "location": "112/TALK"  , "narrator": "ヒカル", "text": "…次に何をするかは、\n一度家に帰ってから\n考えようよ。"},
        { "location": "113/TALK"  , "narrator": "繭", "text": "賛成。"},
        { "location": "114/TALK"  , "narrator": "繭", "text": "このままじゃ、\n感情論のぶつけ合いに\nなりかねない。"},
        { "location": "116/TALK"  , "narrator": "キリト", "text": "…だな。"},
        { "location": "117/TALK"  , "narrator": "キリト", "text": "今日は解散して、\n別の案考えようぜ。"},
        { "location": "118/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "…みやびの解析、\nまだかかるのかしら？"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "私も、手伝えたら\nいいんだけど…。"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "…東京に戻れたら、\n私も少し勉強しよう\nかしら？"},
        { "location": "131/SEL"   , "narrator": "（選択肢）", "text": "東京のことを聞きたい？"},
        { "location": "132/ACT"   , "narrator": "", "text": "東京のことを聞きたい？"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "…また、日向さん達？"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "どういうこと？(￣Д￣ )"},
        { "location": "153/TALK"  , "narrator": "アーヤ", "text": "東京の方でなにかあったの？"},
        { "location": "155/SEL"   , "narrator": "（選択肢）", "text": "雛達が大変"},
        { "location": "156/SEL"   , "narrator": "（選択肢）", "text": "みんなのことで揉めてる"},
        { "location": "157/ACT"   , "narrator": "", "text": "雛達が大変"},
        { "location": "158/TALK"  , "narrator": "アーヤ", "text": "詳しく教えて"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "まさか"},
        { "location": "160/TALK"  , "narrator": "アーヤ", "text": "管理庁になにかされた？"},
        { "location": "162/SEL"   , "narrator": "（選択肢）", "text": "みんなのことで揉めてる　"},
        { "location": "163/ACT"   , "narrator": "", "text": "みんなのことで揉めてる"},
        { "location": "165/ACT"   , "narrator": "", "text": "みんなのことで揉めてる"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "それって"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "連絡取れないから？"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "だとしたら"},
        { "location": "171/TALK"  , "narrator": "アーヤ", "text": "対処出来ない(-.-;)"},
        { "location": "173/SEL"   , "narrator": "（選択肢）", "text": "つばめを助けようとしてる"},
        { "location": "174/SEL"   , "narrator": "（選択肢）", "text": "早く帰ってあげて"},
        { "location": "175/ACT"   , "narrator": "", "text": "つばめを助けようとしてる"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "多分平気だと思う"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "動こうにも"},
        { "location": "178/TALK"  , "narrator": "アーヤ", "text": "どうすればいいかわからないと思うし"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "私達だって"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "そうなんだから"},
        { "location": "181/ACT"   , "narrator": "", "text": "早く帰ってあげて"},
        { "location": "182/TALK"  , "narrator": "アーヤ", "text": "あの子達も心配だけど"},
        { "location": "183/TALK"  , "narrator": "アーヤ", "text": "まずは"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "私達自身のこれからのこと"},
        { "location": "185/TALK"  , "narrator": "アーヤ", "text": "それが第一"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "気にはなるけど"},
        { "location": "188/TALK"  , "narrator": "アーヤ", "text": "私達がどうするか"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "それを決めるのが先"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "優先順位は間違えられない"},
        { "location": "202/TALK"  , "narrator": "アーヤ", "text": "…ごめんなさい、みんな。"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "東京に戻ったら、\nちゃんと謝るから…。"}
    ]
}
