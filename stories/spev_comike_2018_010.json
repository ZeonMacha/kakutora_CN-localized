{
    "dir": "chap00/daydra/spev_comike_2018_010.js",
    "type": "",
    "info": {
        "story_id": "91071",
        "cid": "",
        "title": "がすとちゃんサマー大作戦♪",
        "sub_title": "作戦１：ココロの旅チャームへの旅"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "チャーム"},
        { "location": "18/TALK"   , "narrator": "ガブリエラ", "text": "さて、と…。"},
        { "location": "19/TALK"   , "narrator": "ガブリエラ", "text": "今日の仕事は\nこれで終わりかしらね。"},
        { "location": "20/TALK"   , "narrator": "ガブリエラ", "text": "この劇場は相変わらず\n閑古鳥が鳴いてるけど、\nこのままでいいのかしら？"},
        { "location": "23/TALK"   , "narrator": "アーヤ", "text": "あら、ギャヴィ。"},
        { "location": "24/TALK"   , "narrator": "アーヤ", "text": "そっちも終わったのね。\n今日もお疲れ様。"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "あいにくヒマすぎて\n全然疲れていないわよ。"},
        { "location": "27/TALK"   , "narrator": "ガブリエラ", "text": "アーヤもそうでしょ？"},
        { "location": "28/TALK"   , "narrator": "アーヤ", "text": "…まぁね。"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "それはそうと、\nみやびがもうすぐ\nここに来るって。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "このあいだ話した、\n私たちのチャームが\n出来上がったらしいから。"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "もう出来たの？"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "どんなシーンが\n選ばれたのかしら？"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "早く見たいわ。"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "お待たー。"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "お二人さん、\nちょうどいいところに\nお揃いで。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "つばめちゃんと\n卯月もおるかね？"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "あの二人は非番だから\n今日は居ないわ。"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "今ごろデートでも\nしてるんじゃない？"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "なるほど、\nならば仕方なし。"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "早速やけど、\n夏の一大イベントで\n大放出されるっちゅう──"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "うちらのチャームの\n試作品をお披露目ぞね！"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "まずはコレや！"},
        { "location": "54/DIALOG" , "narrator": "", "text": "逢瀬つばめ（15）\nロッカーに隠れる"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "あー、このシーン…"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "劇場に強行突入された日に\nつばめが隠れたっていう\nロッカーの場面ね。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "本人はピンチなんだけど、\nこのつばめは確かに\nとっても可愛い♪"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "私が現場で見たら\nお持ち帰りしちゃうかも。"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "そういうのは思っても\n口に出さなくていいわよ？"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "聞いてて恥ずかしいから。"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "あら、そう？"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "ギャヴィも\n同じポーズをしたら\nきっと可愛いと思うわよ？"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "えっ、と…"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "そういうことも\n面と向かって\n言わなくていいの！"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "はいはい。"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "おっ？"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "メロドラマ発生の予感！"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "『天才ハッカーは見た！\n静かなる劇場を揺るがす\n三人の女の愛憎劇──』"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "劇場三部作で\n映画化決定ぞね。"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "飛ばしすぎよ！"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "それはいいから、\n他のチャームも\n見せてくれる？"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "ほいな。"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "お次はコレや！"},
        { "location": "91/DIALOG" , "narrator": "", "text": "國政綾水（21）\n人形劇で上目遣い"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "わぁっ！"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "これはアレね、\nアーヤが秘密にしてた\n人形劇のシーンでしょ。"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "隠しているつもりは\nなかったけど…"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "ギャヴィに\n尾行されたから\nバレちゃったわね。"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "あれは尾行じゃないわよ。"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "アーヤがひとりで\nどこに行ってるのか\n心配になっただけだから。"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "人聞きの悪いこと\n言わないでくれるかしら。"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "でも、おかげで\nギャヴィにも人形劇を\n手伝ってもらえて──"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "とっても嬉しかったわ。"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "今もたまに\n付き合ってくれて\nありがとうね？"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "…まぁ、私も\n嫌いじゃないから\n別にいいけど。"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "アーヤはまっこと\n母性の塊やねぇ。"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "チャームの上目遣いも\n破壊力バツグンや。"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "それはちょっと\n自分で見ると\n恥ずかしいかな…。"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "ねぇ、ギャヴィの\nチャームもあるんでしょ？"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "それも見たいわ。"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "ほいさ！"},
        { "location": "123/DIALOG", "narrator": "", "text": "ガブちゃん（14）\nTuTu！ PaPa！"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "ジャジャーン！"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "まぁっ！"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "これはギャヴィが\n歌っているシーンね。"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "大半がポーランド語だから\nすぐには分からなかった\nけど──"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "歌詞も振り付けも\nとっても可愛かったわ。"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "…そう。"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "ありがと。"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "この二人は事あるごとに\nイチャついてくれよる…。"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "うちも心細いから\n$handle$でも\n呼んで対抗しようかね。"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "まぁ、ガブちゃんのMVは\n$handle$たちの\n世界で大人気のようやき。"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "このシーンが選ばれるんも\n必然やったのかもな。"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "好評なら嬉しいわ。"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "本当は、\n$handle$との\n思い出のシーンとか──"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "そういうのが選ばれても\nあたしは嬉しかったけど。"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "チャームを見るたびに\nあたしのことを思って\nもらえたら何よりだわ。"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "うふふ。"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "ギャヴィは\nそういうところが\nけっこう素直よね。"},
        { "location": "149/TALK"  , "narrator": "ガブリエラ", "text": "何よ！"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "チャームって\nそういうものでしょ？"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "うむ。"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "それを言うと、\nうちのチャームは\nまさに思い出ぞね。"},
        { "location": "160/DIALOG", "narrator": "", "text": "恋ヶ崎 みやび（？）\nなごちゃんと一緒"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "コレなんやが。"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "これは子供のころの\nみやびかしら？"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "みやびと一緒にいるのは\nもしかして…？"},
        { "location": "165/TALK"  , "narrator": "みやび", "text": "うちの妹の、\nなごちゃんや。"},
        { "location": "166/TALK"  , "narrator": "みやび", "text": "そういえば、\nなごちゃんの写真を\n見せたことは無かったね。"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "これがうちの妹や。\nまっこと可愛えろう？"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "可愛い！"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "確かに。\nお人形さんみたいね。"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "それな。"},
        { "location": "171/TALK"  , "narrator": "みやび", "text": "このシーンは確か…"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "なごちゃんに絵本を\n読み聞かせちょった時──"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "出てきた青ペンギンが\nあんまりにも気の抜けた\n顔をしちょったもんでな。"},
        { "location": "174/TALK"  , "narrator": "みやび", "text": "うちのツボにハマって\n笑いが止まらんかったら\nなごちゃんに怒られた。"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "みや、ちゃんと読みや！\n…ってな。"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "妹に怒られる姉…。"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "なんか、\nしっかりした\n妹さんみたいね。"},
        { "location": "178/TALK"  , "narrator": "みやび", "text": "そうやよ？"},
        { "location": "179/TALK"  , "narrator": "みやび", "text": "チャームのなごちゃんは\n８歳くらいの頃やけど…"},
        { "location": "180/TALK"  , "narrator": "みやび", "text": "今また会えたら\n凛とした美少女に\n成長しているはずや！"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "…まぁ、\nまた会えたらの\n話やけどな。"},
        { "location": "182/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "183/TALK"  , "narrator": "ガブリエラ", "text": "…えっと…。"},
        { "location": "184/TALK"  , "narrator": "みやび", "text": "おおっと。すまぬ、\n余計なことを言った。"},
        { "location": "185/TALK"  , "narrator": "みやび", "text": "確かにセンチメンタルな\n思い出やけど、こうして\n形になるんは嬉しいよ。"},
        { "location": "190/TALK"  , "narrator": "みやび", "text": "他にもたくさんのシーンが\nチャームの候補として\n挙がったらしくてな？"},
        { "location": "191/TALK"  , "narrator": "みやび", "text": "うちらのことを\n想うてくれちょる相棒には\nまっこと心から感謝ぞね。"},
        { "location": "193/TALK"  , "narrator": "アーヤ", "text": "そうね。"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "あたしも同じ。"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "それと、\n神楽のチャームは\nどうだったの？"},
        { "location": "197/TALK"  , "narrator": "みやび", "text": "うむ、それがな…。"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "本人が居たら\n聞こうと思ったんやが──"},
        { "location": "199/TALK"  , "narrator": "みやび", "text": "隊員服を着て\nこんなことを言いよる\n場面なんぞあったかいな？"},
        { "location": "206/DIALOG", "narrator": "", "text": "一方その頃、\nココロゲートでは──"},
        { "location": "243/TALK"  , "narrator": "百鶴", "text": "3、2、1…"},
        { "location": "245/TALK"  , "narrator": "百鶴", "text": "ジャジャーン！！"},
        { "location": "247/TALK"  , "narrator": "ぴょんこ", "text": "ぴょ～～～～ん！！"},
        { "location": "248/TALK"  , "narrator": "百鶴", "text": "特別企画！\nコタツを飛び出た\nひゃっちゃんと！"},
        { "location": "249/TALK"  , "narrator": "ぴょんこ", "text": "ルールを抜け出す\nぴょんこちゃんが！"},
        { "location": "250/TALK"  , "narrator": "百鶴", "text": "まさかの！"},
        { "location": "251/TALK"  , "narrator": "ぴょんこ", "text": "共演！"},
        { "location": "254/TALK"  , "narrator": "百鶴", "text": "出張ダイレクトアタック！"},
        { "location": "255/TALK"  , "narrator": "ぴょんこ", "text": "さぁさぁ\n盛り上がって\nまいりました～！"},
        { "location": "257/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さん\nラブラブパワー\nハレーショーーーーン♪♪"},
        { "location": "279/TALK"  , "narrator": "昇華ぴょんこ", "text": "ぴょ～～～～ん♪"},
        { "location": "281/TALK"  , "narrator": "百鶴", "text": "はい？"},
        { "location": "282/TALK"  , "narrator": "昇華ぴょんこ", "text": "えっ！？"},
        { "location": "283/TALK"  , "narrator": "百鶴", "text": "ちょっと\n待ってくださいよ？"},
        { "location": "284/TALK"  , "narrator": "百鶴", "text": "あなた、まさか\nここで昇華するんですか？"},
        { "location": "286/TALK"  , "narrator": "百鶴", "text": "バカですか？\nチョロすぎですか！？"},
        { "location": "287/TALK"  , "narrator": "昇華ぴょんこ", "text": "ぴょん？"},
        { "location": "288/TALK"  , "narrator": "百鶴", "text": "昇華した姿を\nそんな容易く\n見せるとか…"},
        { "location": "289/TALK"  , "narrator": "百鶴", "text": "さすがのわたしも\nドン引きですよ！！"},
        { "location": "290/TALK"  , "narrator": "昇華ぴょんこ", "text": "ぴょん！"},
        { "location": "291/TALK"  , "narrator": "昇華ぴょんこ", "text": "ちょっとした\n芸風ですぴょん♪"},
        { "location": "292/TALK"  , "narrator": "百鶴", "text": "まったく…わたしが\n自重させる側になるとは\n調子が狂いますね。"},
        { "location": "316/TALK"  , "narrator": "百鶴", "text": "と、いうわけで！"},
        { "location": "317/TALK"  , "narrator": "百鶴", "text": "今回は\nぴょんこさんのところに\nお邪魔してみましたよ。"},
        { "location": "318/TALK"  , "narrator": "ぴょんこ", "text": "お迎えしてみましたよっ！"},
        { "location": "319/TALK"  , "narrator": "ぴょんこ", "text": "いったい誰がこの邂逅を\n予想できたでしょうか？"},
        { "location": "320/TALK"  , "narrator": "ぴょんこ", "text": "それでは\nご用件を聞きましょう！"},
        { "location": "321/TALK"  , "narrator": "百鶴", "text": "ほかでもない、\nこのチャームです！"},
        { "location": "324/DIALOG", "narrator": "", "text": "ぴょんこ（司書）\nゾッコンLOVE！"},
        { "location": "326/TALK"  , "narrator": "ぴょんこ", "text": "ぴょ～～～～ん♪"},
        { "location": "328/TALK"  , "narrator": "百鶴", "text": "見事なチャーム化、\nおめでとうございます。"},
        { "location": "330/TALK"  , "narrator": "ぴょんこ", "text": "ありがとうございます♪"},
        { "location": "332/TALK"  , "narrator": "ぴょんこ", "text": "これがあれば、いつでも\n$handle$さんと\n一緒にいられますから──"},
        { "location": "333/TALK"  , "narrator": "ぴょんこ", "text": "万が一にでも\nお見逃しの無いよう\nご注意くださいねっ！"},
        { "location": "334/TALK"  , "narrator": "百鶴", "text": "8888888888！"},
        { "location": "336/TALK"  , "narrator": "ぴょんこ", "text": "…というか。"},
        { "location": "337/TALK"  , "narrator": "ぴょんこ", "text": "百鶴さんはわざわざ\n私のお祝いのために\n来てくれたんですか？"},
        { "location": "338/TALK"  , "narrator": "百鶴", "text": "よくぞ聞いてくれました。"},
        { "location": "342/TALK"  , "narrator": "百鶴", "text": "ここでもうひとつ、\nわたしのチャームも\n紹介したいと思います。"},
        { "location": "343/TALK"  , "narrator": "百鶴", "text": "コレです！"},
        { "location": "346/DIALOG", "narrator": "", "text": "ひゃっちゃん（司書）\nロッカーに隠れる"},
        { "location": "348/TALK"  , "narrator": "ぴょんこ", "text": "えっ、これは…。"},
        { "location": "349/TALK"  , "narrator": "ぴょんこ", "text": "現実のつばめさんの\nシーンではありませんか？"},
        { "location": "350/TALK"  , "narrator": "百鶴", "text": "何をおっしゃる\nぴょんこさん。"},
        { "location": "351/TALK"  , "narrator": "百鶴", "text": "わたしがロッカーに\n入ることは有り得ないと\n誰が決めたというのです。"},
        { "location": "352/TALK"  , "narrator": "百鶴", "text": "いざとなったら、\nわたしもロッカーの\n１つや２つ入りますよ！"},
        { "location": "353/TALK"  , "narrator": "ぴょんこ", "text": "なんとぉ！？"},
        { "location": "354/TALK"  , "narrator": "百鶴", "text": "ですからコレは、\n正真正銘わたしの\nチャームとも言えます。"},
        { "location": "358/TALK"  , "narrator": "ぴょんこ", "text": "その発想は\n無かったぴょん……。"},
        { "location": "359/TALK"  , "narrator": "百鶴", "text": "さらに言わせて\nいただきますと。"},
        { "location": "360/TALK"  , "narrator": "百鶴", "text": "ぴょんこさんの\nゾッコンLOVE！な\nチャームも──"},
        { "location": "361/TALK"  , "narrator": "百鶴", "text": "現実の卯月さんが\n言ってもおかしくない\nセリフでしょうから。"},
        { "location": "362/TALK"  , "narrator": "百鶴", "text": "これは実は、\n卯月神楽さん本人の\nチャームかもしれません。"},
        { "location": "363/TALK"  , "narrator": "ぴょんこ", "text": "なん…だと…？"},
        { "location": "364/TALK"  , "narrator": "百鶴", "text": "改めまして、\nおめでとうございまーす！"},
        { "location": "365/TALK"  , "narrator": "ぴょんこ", "text": "なんですか、それ！"},
        { "location": "366/TALK"  , "narrator": "ぴょんこ", "text": "祝ってくれるどころか\n蹴落としに来たんですか\n百鶴さんは！？"},
        { "location": "367/TALK"  , "narrator": "ぴょんこ", "text": "ステキな根性してますね！"},
        { "location": "368/TALK"  , "narrator": "百鶴", "text": "いえいえ、\n見くびらないでください。"},
        { "location": "369/TALK"  , "narrator": "百鶴", "text": "わたしはただ、\n解釈の可能性を\n提示したまでのこと。"},
        { "location": "370/TALK"  , "narrator": "百鶴", "text": "どう受け止めるかは\n$handle$さんが\n決めることです。"},
        { "location": "371/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん…それは確かに\nその通りぴょん…。"},
        { "location": "372/TALK"  , "narrator": "百鶴", "text": "…とまぁ、\n言いたいことを言ったら\n思い出しましたが。"},
        { "location": "373/TALK"  , "narrator": "百鶴", "text": "さらにもうひとつ、\nわたしの上司もチャームに\nなるんですよね。"},
        { "location": "374/TALK"  , "narrator": "百鶴", "text": "コレなんですけど。"},
        { "location": "377/DIALOG", "narrator": "", "text": "千羽鶴（非攻略対象？）\n素敵なココロの旅を。"},
        { "location": "379/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "380/TALK"  , "narrator": "百鶴", "text": "……。"},
        { "location": "381/TALK"  , "narrator": "ぴょんこ", "text": "…この頃は\nお互いに大変でしたよね。"},
        { "location": "382/TALK"  , "narrator": "百鶴", "text": "えぇ、瀬戸際でしたから。"},
        { "location": "383/TALK"  , "narrator": "百鶴", "text": "まぁ、このシーンは\nわたしたちの立場では\nコメントしにくいですね。"},
        { "location": "384/TALK"  , "narrator": "百鶴", "text": "本人がちょっと\n取り込み中なもので、\nこの辺で失礼します。"},
        { "location": "391/TALK"  , "narrator": "百鶴", "text": "いずれにしても──"},
        { "location": "392/TALK"  , "narrator": "百鶴", "text": "$handle$さんに\nわたしたちのチャームを\n手にしてもらえたら！"},
        { "location": "393/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこたちは\nとってもとっても\n嬉しいです！！"},
        { "location": "394/TALK"  , "narrator": "百鶴", "text": "これから先、\n冷房とコタツがますます\n欠かせない季節ですので！"},
        { "location": "395/TALK"  , "narrator": "ぴょんこ", "text": "夏のイベントに\nお越しの場合は、\nどうぞお体に気を付けて！"},
        { "location": "398/DIALOG", "narrator": "", "text": "素敵なココロの旅チャームの\n詳細情報を見ますか？"}
    ]
}
