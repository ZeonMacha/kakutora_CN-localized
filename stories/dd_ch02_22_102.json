{
    "dir": "chap22/daydra/dd_ch02_22_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "22205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "覚悟＜後編＞"
    },
    "entry":
    [
        { "location": "365/TALK"  , "narrator": "アーヤ", "text": "…嫌な予感から\n目を反らしても、\n何も解決しないわ。"},
        { "location": "366/TALK"  , "narrator": "アーヤ", "text": "館長が言ってるのは、\n任期のことよ。"},
        { "location": "368/TALK"  , "narrator": "アーヤ", "text": "多分…。"},
        { "location": "369/TALK"  , "narrator": "アーヤ", "text": "…館長が何をしようと\nしているのかは\nわかりません。"},
        { "location": "370/TALK"  , "narrator": "アーヤ", "text": "でも、命に関わるような\nことだけは、\n避けてくださいね？"},
        { "location": "371/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "372/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "373/TALK"  , "narrator": "真幌", "text": "ぷっ。"},
        { "location": "374/TALK"  , "narrator": "真幌", "text": "あはははは！\nおまえがそれを\n言うのか？"},
        { "location": "375/TALK"  , "narrator": "真幌", "text": "最前線で\n命を懸けて戦ってる\nおまえが言うか。"},
        { "location": "376/TALK"  , "narrator": "真幌", "text": "命に関わることは\n避けろって…。\n説得力がなさすぎる。"},
        { "location": "378/TALK"  , "narrator": "アーヤ", "text": "そ、そうかもしれ\nませんけど、\n本気で心配して…！"},
        { "location": "379/TALK"  , "narrator": "真幌", "text": "ああ、わかってる。\nわかってるよ。"},
        { "location": "380/TALK"  , "narrator": "真幌", "text": "だが、冗談を\nそこまで本気に\nするな。"},
        { "location": "381/TALK"  , "narrator": "真幌", "text": "こちらも反応に\n困ってしまうだろ？"},
        { "location": "383/TALK"  , "narrator": "アーヤ", "text": "えっ…と…。"},
        { "location": "384/TALK"  , "narrator": "真幌", "text": "そう簡単に死んで\nたまるか。"},
        { "location": "385/TALK"  , "narrator": "アーヤ", "text": "はぁ…もう…。"},
        { "location": "386/TALK"  , "narrator": "真幌", "text": "すまんすまん。"},
        { "location": "387/TALK"  , "narrator": "アーヤ", "text": "…けど、冗談で\n本当に安心しました。"},
        { "location": "388/TALK"  , "narrator": "アーヤ", "text": "もうこういう冗談は\nやめてくださいよ？"},
        { "location": "389/TALK"  , "narrator": "真幌", "text": "ああ、わかった。\n冗談はやめる。"},
        { "location": "390/TALK"  , "narrator": "真幌", "text": "その代わり。\n本音で、一つおまえに\n言っておく。"},
        { "location": "391/TALK"  , "narrator": "アーヤ", "text": "？"},
        { "location": "392/TALK"  , "narrator": "真幌", "text": "おまえにはもっと、\nデカくなってもらわ\nなければ困る…。"},
        { "location": "393/TALK"  , "narrator": "真幌", "text": "これが私の本音だ。"},
        { "location": "395/TALK"  , "narrator": "アーヤ", "text": "…デカく、ですか？"},
        { "location": "396/TALK"  , "narrator": "真幌", "text": "そう、デカくだ。"},
        { "location": "397/TALK"  , "narrator": "アーヤ", "text": "…なんか、さっきから\n抽象的な言い方ばかり\nしてくるわね。"},
        { "location": "398/TALK"  , "narrator": "アーヤ", "text": "どういう意味なの\nかしら？"},
        { "location": "399/TALK"  , "narrator": "アーヤ", "text": "まともに受け止めて\nいいのか…それとも、\n別の意味があるとか？"},
        { "location": "400/TALK"  , "narrator": "アーヤ", "text": "う～ん…。"},
        { "location": "401/SEL"   , "narrator": "", "text": "もっと頼れるリーダーになれ、ってことだ"},
        { "location": "402/SEL"   , "narrator": "", "text": "真幌の気持ちわかるなぁ"},
        { "location": "403/ACT"   , "narrator": "", "text": "もっと頼れるリーダーになれ、ってことだ"},
        { "location": "413/TALK"  , "narrator": "アーヤ", "text": "それ納得だわ(>_<)"},
        { "location": "414/TALK"  , "narrator": "アーヤ", "text": "館長と比べて"},
        { "location": "415/TALK"  , "narrator": "アーヤ", "text": "まだまだ半人前だし(-ω-;)"},
        { "location": "416/TALK"  , "narrator": "アーヤ", "text": "仲間のこと"},
        { "location": "417/TALK"  , "narrator": "アーヤ", "text": "最近ちゃんと見れてないし"},
        { "location": "418/TALK"  , "narrator": "アーヤ", "text": "反省しないと(ノД`)"},
        { "location": "423/TALK"  , "narrator": "アーヤ", "text": "…これからも、\nこれ以上に\n精進します。"},
        { "location": "424/TALK"  , "narrator": "アーヤ", "text": "みんなの手本として。\nリーダーとして。"},
        { "location": "426/TALK"  , "narrator": "真幌", "text": "…ん、期待してるぞ。"},
        { "location": "427/ACT"   , "narrator": "", "text": "真幌の気持ちわかる"},
        { "location": "437/TALK"  , "narrator": "アーヤ", "text": "どういうこと？(￣Д￣ )"},
        { "location": "440/SEL"   , "narrator": "", "text": "胸だよ、胸"},
        { "location": "441/ACT"   , "narrator": "", "text": "胸だよ、胸"},
        { "location": "444/TALK"  , "narrator": "アーヤ", "text": "胸？"},
        { "location": "445/TALK"  , "narrator": "アーヤ", "text": "ちょっとわからないんだけど（￣ー￣？）"},
        { "location": "447/SEL"   , "narrator": "", "text": "バストサイズの話だよ"},
        { "location": "448/ACT"   , "narrator": "", "text": "バストサイズの話だよ"},
        { "location": "450/TALK"  , "narrator": "アーヤ", "text": "何の話してるのよ（｀皿´ )"},
        { "location": "451/TALK"  , "narrator": "アーヤ", "text": "そんなわけないから！"},
        { "location": "452/TALK"  , "narrator": "アーヤ", "text": "話に繋がりないでしょ(｀ヘ´)"},
        { "location": "454/SEL"   , "narrator": "", "text": "落ち着け、相手は酔っ払いだ"},
        { "location": "455/ACT"   , "narrator": "", "text": "落ち着け、相手は酔っ払いだ"},
        { "location": "458/TALK"  , "narrator": "アーヤ", "text": "そういえば"},
        { "location": "459/TALK"  , "narrator": "アーヤ", "text": "前にも館長"},
        { "location": "460/TALK"  , "narrator": "アーヤ", "text": "飲みに行った時"},
        { "location": "461/TALK"  , "narrator": "アーヤ", "text": "下ネタ言ったことがあったわ(￣Д￣ )"},
        { "location": "464/TALK"  , "narrator": "アーヤ", "text": "まったく"},
        { "location": "465/TALK"  , "narrator": "アーヤ", "text": "これだから酔っ払いは(--#)"},
        { "location": "470/TALK"  , "narrator": "アーヤ", "text": "…残念ですけど、\n館長の期待には\nお答えできません。"},
        { "location": "472/TALK"  , "narrator": "真幌", "text": "…は？"},
        { "location": "473/TALK"  , "narrator": "アーヤ", "text": "無茶ですよ。\n私にデカくなれだ\nなんて。"},
        { "location": "474/TALK"  , "narrator": "アーヤ", "text": "十代ならまだしも、\n今から成長するわけ\nないじゃないですか。"},
        { "location": "475/TALK"  , "narrator": "真幌", "text": "おいおい…本気か？"},
        { "location": "476/TALK"  , "narrator": "真幌", "text": "おまえはみんなの\n手本になるリーダー\nなんだぞ？"},
        { "location": "477/TALK"  , "narrator": "真幌", "text": "そんな簡単に無理とか\n言うもんじゃないぞ。"},
        { "location": "478/TALK"  , "narrator": "アーヤ", "text": "館長が無茶なこと\n言うからですよ。"},
        { "location": "479/TALK"  , "narrator": "アーヤ", "text": "できないことを\nできるなんて、\n私には言えません。"},
        { "location": "480/TALK"  , "narrator": "アーヤ", "text": "それこそ、リーダー\nとして無責任だと\n思いませんか？"},
        { "location": "481/TALK"  , "narrator": "真幌", "text": "…本気で\n言ってるのか？"},
        { "location": "482/TALK"  , "narrator": "アーヤ", "text": "当然です。\n私の成長はもう、\n止まってますから。"},
        { "location": "483/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "484/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "485/TALK"  , "narrator": "真幌", "text": "ガッカリだよ…。\nアーヤには期待して\nいたんだが。"},
        { "location": "486/TALK"  , "narrator": "真幌", "text": "まさか、これ以上\n成長ができんと\n言われるとはな…。"},
        { "location": "487/TALK"  , "narrator": "アーヤ", "text": "そんな期待されても\n困りますから…。"},
        { "location": "488/TALK"  , "narrator": "アーヤ", "text": "第一、リーダーで\nあることと大きいことに\n関係はありますか？"},
        { "location": "489/TALK"  , "narrator": "真幌", "text": "そりゃおまえ、\n小さいリーダーとか\n頼りにならんだろ？"},
        { "location": "490/TALK"  , "narrator": "アーヤ", "text": "スレンダーな\nリーダーも\n素敵じゃないですか！"},
        { "location": "491/TALK"  , "narrator": "真幌", "text": "…スレンダー？"},
        { "location": "492/TALK"  , "narrator": "アーヤ", "text": "サイズだけなら私より\nみやびの方が適任って\nことになりますよ？"},
        { "location": "493/TALK"  , "narrator": "真幌", "text": "いや、おい…。"},
        { "location": "494/TALK"  , "narrator": "アーヤ", "text": "そういうこと\nなんですよね！？"},
        { "location": "495/TALK"  , "narrator": "真幌", "text": "ストップ！\n落ち着け、アーヤ。"},
        { "location": "496/TALK"  , "narrator": "真幌", "text": "おまえ、何の話を\nしてるんだ？"},
        { "location": "498/TALK"  , "narrator": "アーヤ", "text": "大小の話です！"},
        { "location": "500/TALK"  , "narrator": "アーヤ", "text": "大体スポーツ選手で\n大きい人なんて\nいませんから！"},
        { "location": "502/TALK"  , "narrator": "アーヤ", "text": "みやびだって\nサイズがないって\n嘆いてますし！"},
        { "location": "503/TALK"  , "narrator": "真幌", "text": "…あ、あぁっ！\nなるほど、\nそういうことか。"},
        { "location": "505/TALK"  , "narrator": "アーヤ", "text": "何がですか？"},
        { "location": "506/TALK"  , "narrator": "真幌", "text": "…私がデカくなって\nもらわなきゃ困ると\n言ったのは、な。"},
        { "location": "507/TALK"  , "narrator": "真幌", "text": "一人の戦士として\nデカくなってほしい、\nという意味だぞ？"},
        { "location": "508/TALK"  , "narrator": "アーヤ", "text": "…え？"},
        { "location": "509/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "512/TALK"  , "narrator": "アーヤ", "text": "…え、えぇっ！？"},
        { "location": "513/TALK"  , "narrator": "真幌", "text": "はぁ…まったく。\nなんちゅー勘違いだ。"},
        { "location": "514/TALK"  , "narrator": "アーヤ", "text": "だ、だって！\nなんか抽象的な\n言い方だったし！！"},
        { "location": "515/TALK"  , "narrator": "アーヤ", "text": "それに$handle$も\nそう言ってて…。"},
        { "location": "516/TALK"  , "narrator": "真幌", "text": "$handle$？\n知らんぞそんな奴。"},
        { "location": "518/TALK"  , "narrator": "アーヤ", "text": "うう…。"},
        { "location": "519/TALK"  , "narrator": "真幌", "text": "ははっ…。\nまあ、いいさ。"},
        { "location": "520/TALK"  , "narrator": "真幌", "text": "とりあえず、\n精進しろよ、半人前。"},
        { "location": "521/TALK"  , "narrator": "アーヤ", "text": "…はい、すみません。"},
        { "location": "533/DIALOG", "narrator": "Dialog_chapter_ch02", "text": "【18 ブラック・クラン】"}
    ]
}
