{
    "dir": "chap00/daydra/spev_ch01_020.js",
    "type": "",
    "info": {
        "story_id": "91001",
        "cid": "",
        "title": "ノベライズ記念",
        "sub_title": "サマープリズム"
    },
    "entry":
    [
        { "location": "25/DIALOG", "narrator": "", "text": "<color=green>本イベントは\n<color=red>2017年6月7日～7月5日</color>に\n配信されたものです。</color>\n\nイベント内で告知されている内容は配信当時のものとなっています。"},
        { "location": "28/TALK"  , "narrator": "透明つばめ", "text": "卯月さーん。\n貸してもらったラノベ、\nやっと読み終わったよー。"},
        { "location": "29/TALK"  , "narrator": "透明神楽", "text": "ふふっ、その様子だと\n楽しんでいただけた\nみたいですね。"},
        { "location": "30/TALK"  , "narrator": "透明つばめ", "text": "うん！\nとっても面白くて三回も\n読み直しちゃった。"},
        { "location": "32/TALK"  , "narrator": "透明ガブリエラ", "text": "へえ、そんな面白い\nラノベがあるんだ？"},
        { "location": "35/TALK"  , "narrator": "透明アーヤ", "text": "なんてタイトルの本なの？"},
        { "location": "38/TALK"  , "narrator": "透明つばめ", "text": "えーっとですね――"},
        { "location": "39/TALK"  , "narrator": "透明つばめ", "text": "<color=red>「拡張少女系トライナリー\n　～サマープリズム～」</color>\nって本なんです！"},
        { "location": "42/TALK"  , "narrator": "透明みやび", "text": "いや、つばめちゃん。\nそれうちらが出ちょる\n小説やん…。"},
        { "location": "45/TALK"  , "narrator": "透明つばめ", "text": "そうなんですよ。\nわたし、読んでて\nビックリしちゃいました。"},
        { "location": "46/TALK"  , "narrator": "透明つばめ", "text": "いつの間にわたし達のこと\n小説にしたんだろ…？"},
        { "location": "47/TALK"  , "narrator": "透明ガブリエラ", "text": "はぁ…、いくらなんでも\nあんた抜け過ぎよ…。"},
        { "location": "48/TALK"  , "narrator": "透明アーヤ", "text": "でも、自分たちの姿を\n小説で読むのは、\n少し恥ずかしかったわ。"},
        { "location": "49/TALK"  , "narrator": "透明みやび", "text": "アーヤも読んだが？"},
        { "location": "50/TALK"  , "narrator": "透明アーヤ", "text": "もちろん。\n最初の章は、\nつばめの話だったわね。"},
        { "location": "51/TALK"  , "narrator": "透明ガブリエラ", "text": "そうそう。\n確かあれよ、\nパジャマパーティー。"},
        { "location": "53/TALK"  , "narrator": "透明つばめ", "text": "うん。\n楽しかったよね！"},
        { "location": "55/TALK"  , "narrator": "透明ガブリエラ", "text": "何言ってんのよ。\nどんなものなのかも\n知らなかったくせに…。"},
        { "location": "56/TALK"  , "narrator": "透明みやび", "text": "いや～、さすがのうちも、\nあれには思考停止で\nツッコミが遅れたぞね。"},
        { "location": "57/TALK"  , "narrator": "透明アーヤ", "text": "まあ、楽しかったし、\n盛り上がったから\nいいけどね。"},
        { "location": "58/TALK"  , "narrator": "透明神楽", "text": "私も、本当に楽しい\n時間を過ごせました。"},
        { "location": "59/TALK"  , "narrator": "透明神楽", "text": "色とりどりのつばめさんの\n下着を見ることも\nできましたし。"},
        { "location": "61/TALK"  , "narrator": "透明神楽", "text": "何より、いいムードの中で\nつばめさんと私の唇が\n急接近して――"},
        { "location": "62/TALK"  , "narrator": "透明つばめ", "text": "ちょ、卯月さん！\n恥ずかしいから\nその話はしないで！"},
        { "location": "64/TALK"  , "narrator": "透明アーヤ", "text": "ふふふ…本当、二人は\n仲がいいわね。"},
        { "location": "65/TALK"  , "narrator": "透明神楽", "text": "何言ってるんですか。"},
        { "location": "66/TALK"  , "narrator": "透明神楽", "text": "仲の良さでいえば、\nアーヤさんとガブちゃんは\nもっと上じゃないですか。"},
        { "location": "67/TALK"  , "narrator": "透明アーヤ", "text": "えっ？"},
        { "location": "68/TALK"  , "narrator": "透明みやび", "text": "アーヤの章の話か。\nあれはうちも読んでて、\n真っ先に思うたがよ。"},
        { "location": "69/TALK"  , "narrator": "透明みやび", "text": "二人とももう結婚すれば\nえいのに、と…。"},
        { "location": "70/TALK"  , "narrator": "透明ガブリエラ", "text": "ななななな、\n何言いだすのよ！"},
        { "location": "71/TALK"  , "narrator": "透明神楽", "text": "的確だと思いますよ？\nずーっとイチャラブ\nしてたじゃないですか。"},
        { "location": "72/TALK"  , "narrator": "透明アーヤ", "text": "私には、みやびのせいで\n振り回されっぱなしだった\n話に感じたけど？"},
        { "location": "73/TALK"  , "narrator": "透明みやび", "text": "<size=35>國政綾水、結婚ス。</size>"},
        { "location": "76/TALK"  , "narrator": "透明アーヤ", "text": "ちょっと、みやび。\nまた勘違いされるから\nそういうこと言わないの。"},
        { "location": "79/TALK"  , "narrator": "透明つばめ", "text": "でも、アーヤさんの\nウエディングドレス姿、\nとっても素敵でした！"},
        { "location": "80/TALK"  , "narrator": "透明つばめ", "text": "あの写真、まだちゃんと\n保存してあるんですよ。"},
        { "location": "81/TALK"  , "narrator": "透明アーヤ", "text": "は、恥ずかしいから\n消してほしいんだけど…。"},
        { "location": "82/TALK"  , "narrator": "透明ガブリエラ", "text": "恥ずかしがること\nないでしょ？"},
        { "location": "83/TALK"  , "narrator": "透明ガブリエラ", "text": "とっても似合ってたし、\n綺麗だったんだから…。"},
        { "location": "84/TALK"  , "narrator": "透明アーヤ", "text": "そ、そうかしら？\nありがとう、ギャヴィ。"},
        { "location": "85/TALK"  , "narrator": "透明つばめ", "text": "…やっぱり、二人とも\nとっても仲良しですね。"},
        { "location": "86/TALK"  , "narrator": "透明つばめ", "text": "小説読んでた時も\n思ったけど、今、\n改めてそう感じたよ。"},
        { "location": "87/TALK"  , "narrator": "透明神楽", "text": "ラブラブレベルですよ。\nリアルキスシーンも\nあったわけですし。"},
        { "location": "89/TALK"  , "narrator": "透明ガブリエラ", "text": "ちょ、バカバカバカ！\nその言い方だと絶対\n誤解されるでしょ！？"},
        { "location": "91/TALK"  , "narrator": "透明みやび", "text": "大丈夫、つばめちゃんなら\nわかってくれるがよ。"},
        { "location": "92/TALK"  , "narrator": "透明ガブリエラ", "text": "いや、なんでつばめの\n名前が出てくるのよ？"},
        { "location": "93/TALK"  , "narrator": "透明みやび", "text": "だってガブちゃん、\nつばめちゃんに対しても\nラブラブやん。"},
        { "location": "94/TALK"  , "narrator": "透明神楽", "text": "そうですね…。\nガブちゃんの章、読んでて\nちょっと嫉妬しました。"},
        { "location": "95/TALK"  , "narrator": "透明神楽", "text": "私のつばめさんと、\nあんな楽しそうに\nデートするなんて！"},
        { "location": "96/TALK"  , "narrator": "透明ガブリエラ", "text": "どこがよ！？\nずーっとトラブル続きで\n大変だったんだから！"},
        { "location": "97/TALK"  , "narrator": "透明アーヤ", "text": "あら？　でも私には\n楽しかったって\n言ってたじゃない。"},
        { "location": "98/TALK"  , "narrator": "透明神楽", "text": "ちょ、それ言っちゃって\nいいんですか？\nネタバレなんじゃ…。"},
        { "location": "99/TALK"  , "narrator": "透明みやび", "text": "安心しぃ。\nネタバレになんぞならん。"},
        { "location": "100/TALK" , "narrator": "透明みやび", "text": "ずーっとデートを楽しむ\nガブちゃんの姿を愛でる\n話なんやきね。"},
        { "location": "101/TALK" , "narrator": "透明ガブリエラ", "text": "何であの内容で\nそう思えるのよ！"},
        { "location": "102/TALK" , "narrator": "透明ガブリエラ", "text": "ほら、つばめからも\n何か言いなさいよ。"},
        { "location": "103/TALK" , "narrator": "透明つばめ", "text": "う、うん、えっとぉ…。"},
        { "location": "104/TALK" , "narrator": "透明つばめ", "text": "あの時のガブちゃん…、\nとってもかっこよくて\n素敵だったよ。"},
        { "location": "105/TALK" , "narrator": "透明つばめ", "text": "私を抱きしめてくれた時、\n勇者様に見えたし…。"},
        { "location": "106/TALK" , "narrator": "透明みやび", "text": "<size=35>…ラブラブやね。</size>"},
        { "location": "107/TALK" , "narrator": "透明アーヤ", "text": "<size=35>ラブラブね。</size>"},
        { "location": "108/TALK" , "narrator": "透明神楽", "text": "<size=35>ラブラブですね。</size>"},
        { "location": "111/TALK" , "narrator": "透明ガブリエラ", "text": "<size=40>ラブラブ言うな！</size>"},
        { "location": "112/TALK" , "narrator": "透明神楽", "text": "とまあ、そんな話に続く\nみやびさんの話は、\n一風変わってましたね。"},
        { "location": "113/TALK" , "narrator": "透明神楽", "text": "ほとんどみやびさんの\n日記でしたし。"},
        { "location": "116/TALK" , "narrator": "透明みやび", "text": "うむ、うちの日記が\nそのまんまコピペ\nされちょった。"},
        { "location": "117/TALK" , "narrator": "透明みやび", "text": "著作権とプライバシーの\n侵害と訴えれば、\n慰謝料ゲット確実案件や。"},
        { "location": "120/TALK" , "narrator": "透明アーヤ", "text": "でも、もとはと言えば\nその日記を失くしたのが\n原因でしょ？"},
        { "location": "121/TALK" , "narrator": "透明アーヤ", "text": "しっかり管理してれば、\n小説の内容だって\n変わってたはずよ。"},
        { "location": "122/TALK" , "narrator": "透明みやび", "text": "うむ…そう言われると\n言い返せんな…。"},
        { "location": "123/TALK" , "narrator": "透明つばめ", "text": "あ、あの…もっと\n内容の話をした方が\nいいんじゃないですか？"},
        { "location": "124/TALK" , "narrator": "透明つばめ", "text": "今のままだと、失くした\n日記の内容を見るだけの\n話に思われちゃいます。"},
        { "location": "125/TALK" , "narrator": "透明みやび", "text": "うむ…そう言われると\n言い返せんな…。"},
        { "location": "126/TALK" , "narrator": "透明ガブリエラ", "text": "そこは返しなさいよ！\nせめて、見どころくらい\n言ったらどうなの？"},
        { "location": "127/TALK" , "narrator": "透明神楽", "text": "女の子の服を透かせる\nシステム、ＴＰＳＢＭは\n見どころです！"},
        { "location": "128/TALK" , "narrator": "透明みやび", "text": "目的が違う。\nＴＰＳＢＭにはちゃんと\n意味があるちや。"},
        { "location": "129/TALK" , "narrator": "透明つばめ", "text": "どんな意味でしたっけ？"},
        { "location": "132/TALK" , "narrator": "透明みやび", "text": "答えは本屋、もしくは\nＷｅｂ（電子書籍）で。"},
        { "location": "135/TALK" , "narrator": "透明アーヤ", "text": "それが言いたかった\nだけでしょ？"},
        { "location": "138/TALK" , "narrator": "透明神楽", "text": "そんな話が続き、\n小説のトリを飾るのは――"},
        { "location": "140/TALK" , "narrator": "透明つばめ", "text": "卯月さんの話だよね。"},
        { "location": "143/TALK" , "narrator": "透明神楽", "text": "というより、\n私達全員が主役の話、と\n言うべきだと思います。"},
        { "location": "144/TALK" , "narrator": "透明神楽", "text": "みんなで協力し、\nリレー小説を書くという\nお話ですからね。"},
        { "location": "145/TALK" , "narrator": "透明みやび", "text": "タイトルは「Lunatilia\n～月の塔の憂き姫君に\n贈る詩～」やったな。"},
        { "location": "146/TALK" , "narrator": "透明ガブリエラ", "text": "よく覚えてたわね？\nもしかして、\n結構楽しんでた？"},
        { "location": "147/TALK" , "narrator": "透明みやび", "text": "あれは…うちにとっての\n大傑作やった…。"},
        { "location": "148/TALK" , "narrator": "透明アーヤ", "text": "おかげでこっちは\n苦労したわ…。"},
        { "location": "149/TALK" , "narrator": "透明つばめ", "text": "わたしも、卯月さんの\nアドバイスがなかったら、\n続きを書けませんでした。"},
        { "location": "150/TALK" , "narrator": "透明アーヤ", "text": "でしょうね…。\nっていうか、あれって\n本当にアドバイスなの？"},
        { "location": "151/TALK" , "narrator": "透明神楽", "text": "アドバイスですよ。"},
        { "location": "152/TALK" , "narrator": "透明神楽", "text": "女の子が告白をした後、\n好きな人に何をするのか。"},
        { "location": "153/TALK" , "narrator": "透明神楽", "text": "それを、実体験で\n教えただけです。"},
        { "location": "154/TALK" , "narrator": "透明ガブリエラ", "text": "読んだ時から思ってたん\nだけど、卯月って、\nそういう経験あるの？"},
        { "location": "155/TALK" , "narrator": "透明神楽", "text": "ノーコメントです。\nミステリアスな方が\n妄想膨らむと思いますし。"},
        { "location": "156/TALK" , "narrator": "透明ガブリエラ", "text": "だと思ったわ。"},
        { "location": "157/TALK" , "narrator": "透明みやび", "text": "ま、とりあえず小説の\n紹介はこんなところやね。"},
        { "location": "158/SEL"  , "narrator": "（選択肢）", "text": "一番の見どころはどこなの？"},
        { "location": "159/ACT"  , "narrator": "", "text": "一番の見どころはどこなの？"},
        { "location": "162/TALK" , "narrator": "透明ガブリエラ", "text": "アーヤのウエディング\nドレス姿かしら？"},
        { "location": "165/TALK" , "narrator": "透明アーヤ", "text": "つばめとのデートを\n楽しむ、ギャヴィの\n可愛い姿だと思うけど？"},
        { "location": "168/TALK" , "narrator": "透明神楽", "text": "つばめさんが\n登場するシーン全てです！"},
        { "location": "171/TALK" , "narrator": "透明みやび", "text": "多過ぎや。\nつばめちゃんの\n登場回数結構多いし。"},
        { "location": "173/TALK" , "narrator": "透明つばめ", "text": "わたしは…う～ん…、\nどの話も好きだから、\n選べないなぁ…。"},
        { "location": "176/TALK" , "narrator": "透明アーヤ", "text": "じゃあ、見どころは\n$handle$本人に決めて\nもらう、ってことで。"},
        { "location": "177/TALK" , "narrator": "透明ガブリエラ", "text": "そうね。\nあたし達が決めるような\nことじゃないし。"},
        { "location": "178/TALK" , "narrator": "透明神楽", "text": "というわけで、\n<color=red>「拡張少女系トライナリー\n　～サマープリズム～」。</color>"},
        { "location": "179/TALK" , "narrator": "透明みやび", "text": "本は<color=red>絶賛発売中。</color>\n電子書籍は<color=blue>６月末に\n発売</color>ぞね。"},
        { "location": "180/TALK" , "narrator": "透明つばめ", "text": "$handle$さんに\n読んでもらえたら、\n嬉しいな…。"}
    ]
}
