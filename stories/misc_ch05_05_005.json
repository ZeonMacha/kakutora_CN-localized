        { "location": "376/SCENARIO", "narrator": "", "text": "はる×こい！"},
        { "location": "401/TALK"    , "narrator": "神楽", "text": "春とは恋の季節だとぴょんこは思うぴょん♪"},
        { "location": "403/SEL"     , "narrator": "", "text": "$me$との恋だよね"},
        { "location": "404/SEL"     , "narrator": "", "text": "春は出会いと別れの季節"},
        { "location": "405/SEL"     , "narrator": "", "text": "わかる気がする"},
        { "location": "406/ACT"     , "narrator": "", "text": "$me$との恋だよね"},
        { "location": "408/TALK"    , "narrator": "神楽", "text": "かもねかもねかもね？"},
        { "location": "409/TALK"    , "narrator": "神楽", "text": "だったらぴょんこたちラブラブね？"},
        { "location": "410/ACT"     , "narrator": "", "text": "春は出会いと別れの季節"},
        { "location": "411/TALK"    , "narrator": "神楽", "text": "別れもある"},
        { "location": "412/TALK"    , "narrator": "神楽", "text": "か"},
        { "location": "413/ACT"     , "narrator": "", "text": "わかる気がする"},
        { "location": "414/TALK"    , "narrator": "神楽", "text": "気だけなの？"},
        { "location": "416/TALK"    , "narrator": "神楽", "text": "実のところぴょんこはいつでも愛に満ちあふれているわけだけどね★彡"},
        { "location": "419/SEL"     , "narrator": "", "text": "その笑顔は暗黒微笑？"},
        { "location": "420/SEL"     , "narrator": "", "text": "$me$にも愛をちょうだい"},
        { "location": "421/SEL"     , "narrator": "", "text": "軽い愛だなあ"},
        { "location": "422/ACT"     , "narrator": "", "text": "その笑顔は暗黒微笑？"},
        { "location": "423/TALK"    , "narrator": "神楽", "text": "だぁくねすすまいりんぐ"},
        { "location": "424/TALK"    , "narrator": "神楽", "text": "それは美少女のみに許された笑み"},
        { "location": "425/ACT"     , "narrator": "", "text": "$me$にも愛をちょうだい"},
        { "location": "427/TALK"    , "narrator": "神楽", "text": "ひょっとして、、、気付いていないの？"},
        { "location": "428/TALK"    , "narrator": "神楽", "text": "全世界を包むぴょんこからの愛に、、、"},
        { "location": "429/TALK"    , "narrator": "神楽", "text": "その愛は大気圏を抜けて宇宙に到達しているのに、、、"},
        { "location": "432/ACT"     , "narrator": "", "text": "軽い愛だなあ"},
        { "location": "433/TALK"    , "narrator": "神楽", "text": "いいじゃない軽くて"},
        { "location": "434/TALK"    , "narrator": "神楽", "text": "重すぎる愛は時として人を殺すよ♪"},
        { "location": "436/TALK"    , "narrator": "神楽", "text": "恋ってばきゅんとしたり切なかったりで幸せだけど"},
        { "location": "437/TALK"    , "narrator": "神楽", "text": "どうせなら成就なんてしない方が楽しめるものかもしれないし"},
        { "location": "438/TALK"    , "narrator": "神楽", "text": "だったら余計、季節限定の方が楽しいでしょ？"},
        { "location": "439/TALK"    , "narrator": "神楽", "text": "だからこそ春は恋の季節なんだぴょん"}
