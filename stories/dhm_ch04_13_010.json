        "title": "Extra007 ヒメゴトチャット",
        "sub_title": "ハニーポッド、ハニートラップ"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "018_ハニーポッド、ハニートラップ"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "自分で言うがね"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "魅力的なお姉さまとして"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "純情な男子を揶揄うのは"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "たまらんね"},
        { "location": "37/SEL"    , "narrator": "", "text": "程々にしてね"},
        { "location": "38/SEL"    , "narrator": "", "text": "あれはやり過ぎ"},
        { "location": "39/SEL"    , "narrator": "", "text": "ちょっと嫉妬した"},
        { "location": "40/ACT"    , "narrator": "", "text": "程々にしてね"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "何を言い出すかと思えば"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "そんな言葉はこのみやびさんの辞書から削除済みだ"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "とはいえ"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "本気にさせんようには"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "しとるつもりだ"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "安心せい"},
        { "location": "48/ACT"    , "narrator": "", "text": "あれはやり過ぎ"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "そうか"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "ぬ"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "調子に乗り過ぎたか"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "ま"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "気にするな"},
        { "location": "54/ACT"    , "narrator": "", "text": "ちょっと嫉妬した"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "左様か"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "素直でよろしい"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "なあに相棒"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "チューくらいいつでも恵んでやろう"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "誰にでもこんなことは言わん"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "特別だぞ？"}
    ]
}
