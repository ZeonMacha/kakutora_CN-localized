{
    "dir": "chap13/daydra/dd_ch02_13_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "13256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "高カロリーな食事"
    },
    "entry":
    [
        { "location": "222/SCENARIO", "narrator": "", "text": "高カロリーな食事"},
        { "location": "237/TALK"    , "narrator": "つばめ", "text": "…ちょっと、食べ過ぎ\nちゃいましたね。"},
        { "location": "239/TALK"    , "narrator": "アーヤ", "text": "そうね…まさか、\nあんなに新メニューの\nケーキが――"},
        { "location": "240/TALK"    , "narrator": "アーヤ", "text": "出てるとは\n思わなかったわ。"},
        { "location": "241/TALK"    , "narrator": "つばめ", "text": "頑張ったけど、\n一日で制覇するのは\n無理でしたね…。"},
        { "location": "243/TALK"    , "narrator": "神楽", "text": "でも、凄く美味しくて\n大満足でした！"},
        { "location": "244/TALK"    , "narrator": "アーヤ", "text": "本当ね。"},
        { "location": "245/TALK"    , "narrator": "アーヤ", "text": "まあ、その分夕飯は\nカロリー抑えないと\nいけないけど…。"},
        { "location": "247/TALK"    , "narrator": "つばめ", "text": "野菜中心にした方が\n良さそうですね。"},
        { "location": "248/TALK"    , "narrator": "神楽", "text": "抜くくらいした方が\nいいかもしれませんよ？"},
        { "location": "250/TALK"    , "narrator": "つばめ", "text": "えーっ、それじゃあ\nお腹空いちゃうよぉ…。"},
        { "location": "253/TALK"    , "narrator": "アーヤ", "text": "ふふっ、食べたばかりで\n言うセリフじゃ――"},
        { "location": "254/TALK"    , "narrator": "アーヤ", "text": "…あっ。"},
        { "location": "257/TALK"    , "narrator": "つばめ", "text": "え？　…わぁ！"},
        { "location": "259/TALK"    , "narrator": "神楽", "text": "いい匂い…\nどこのお店でしょうか？"},
        { "location": "261/TALK"    , "narrator": "アーヤ", "text": "…夕飯時だからかしら？\nあちこちの店から\nしてくるわね。"},
        { "location": "263/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "265/TALK"    , "narrator": "つばめ", "text": "食べたばかりだけど…\nお腹鳴っちゃいそうです。"},
        { "location": "266/TALK"    , "narrator": "神楽", "text": "そうですね…。"},
        { "location": "268/TALK"    , "narrator": "神楽", "text": "で、でもダメです！"},
        { "location": "269/TALK"    , "narrator": "神楽", "text": "いい匂いのする料理は、\n大抵カロリーが高いと\n決まっています！"},
        { "location": "270/TALK"    , "narrator": "アーヤ", "text": "ケーキを食べた後だし、\nさすがにね…。"},
        { "location": "272/TALK"    , "narrator": "つばめ", "text": "そうですね。"},
        { "location": "273/TALK"    , "narrator": "つばめ", "text": "…凄く、美味しそう\nですけど。"},
        { "location": "274/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "276/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "278/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "280/TALK"    , "narrator": "アーヤ", "text": "…まあ、いつもって\nわけじゃないんだし――"},
        { "location": "282/TALK"    , "narrator": "アーヤ", "text": "たまにだったら、\nちょっと食べ過ぎても\n罰は当たらないかな？"},
        { "location": "284/TALK"    , "narrator": "神楽", "text": "アーヤさん、本気ですか？"},
        { "location": "285/TALK"    , "narrator": "アーヤ", "text": "私も、ちょっとだけ\nお腹空いてきちゃったし。"},
        { "location": "286/TALK"    , "narrator": "アーヤ", "text": "たまに食べ過ぎるくらい、\n罰は当たらないんじゃ\nないかしら？"},
        { "location": "288/TALK"    , "narrator": "つばめ", "text": "そうだよ卯月さん。\nたまになんだから\n平気だよ。"},
        { "location": "290/TALK"    , "narrator": "神楽", "text": "う～ん…。"},
        { "location": "291/TALK"    , "narrator": "神楽", "text": "…そうですね。\nたまにだったら、\n許されますよね？"},
        { "location": "292/TALK"    , "narrator": "アーヤ", "text": "決まりね。\n何か食べたい物はある？"},
        { "location": "294/TALK"    , "narrator": "つばめ", "text": "えぇっと…、\n豚カツがいいです！"},
        { "location": "296/TALK"    , "narrator": "神楽", "text": "美味しそうですけど、\nさすがにガッツリ過ぎじゃ\nないですか？"},
        { "location": "300/TALK"    , "narrator": "つばめ", "text": "卯月さんは何がいいの？"},
        { "location": "302/TALK"    , "narrator": "神楽", "text": "そうですね…。\nブイヤベースとかは\nどうですか？"},
        { "location": "303/TALK"    , "narrator": "つばめ", "text": "ブイヤベースって、\nお魚とか入ってる\nスープだっけ？"},
        { "location": "304/TALK"    , "narrator": "神楽", "text": "エビとか貝とかも\n入ってるんですよ。"},
        { "location": "306/TALK"    , "narrator": "アーヤ", "text": "…二人とも、意見が\n分かれてるみたい。"},
        { "location": "307/TALK"    , "narrator": "アーヤ", "text": "私はどうしようかしら？"},
        { "location": "309/TALK"    , "narrator": "アーヤ", "text": "何か食べに行きたいけど、\n特に食べたい、って\n思うものないし…。"},
        { "location": "322/TALK"    , "narrator": "アーヤ", "text": "ちょっと悩んでるの"},
        { "location": "323/TALK"    , "narrator": "アーヤ", "text": "夕飯に食べる料理で、"},
        { "location": "324/TALK"    , "narrator": "アーヤ", "text": "いい匂いがして、味の濃くて美味しい物といえば？"},
        { "location": "326/SEL"     , "narrator": "", "text": "焼肉だ！"},
        { "location": "327/SEL"     , "narrator": "", "text": "濃厚なラーメンでしょ"},
        { "location": "328/SEL"     , "narrator": "", "text": "イタリアンで行こう"},
        { "location": "329/ACT"     , "narrator": "", "text": "焼肉だ！"},
        { "location": "330/TALK"    , "narrator": "アーヤ", "text": "焼肉…そういえば最近食べてないかも"},
        { "location": "331/TALK"    , "narrator": "アーヤ", "text": "一人じゃないんだし、誘ってみようかしら？"},
        { "location": "343/TALK"    , "narrator": "アーヤ", "text": "それだったら、\n焼肉でも行っちゃう？"},
        { "location": "346/TALK"    , "narrator": "神楽", "text": "や、焼肉ですか？"},
        { "location": "347/TALK"    , "narrator": "アーヤ", "text": "前に大学の友達と行った\nお店があるんだけど――"},
        { "location": "348/TALK"    , "narrator": "アーヤ", "text": "凄く種類も多くて、\n美味しいの。"},
        { "location": "350/TALK"    , "narrator": "つばめ", "text": "近くにあるんですか？"},
        { "location": "351/TALK"    , "narrator": "アーヤ", "text": "そこの角を曲がった\nビルの三階よ。"},
        { "location": "352/TALK"    , "narrator": "アーヤ", "text": "どうする？\n他が良いなら焼肉じゃ\nなくてもいいけど。"},
        { "location": "353/TALK"    , "narrator": "神楽", "text": "…焼肉は美味しそうだと\n思いますけど――"},
        { "location": "354/TALK"    , "narrator": "神楽", "text": "今日は違う方が良いです。\n制服に臭いが付いちゃい\nますし…。"},
        { "location": "356/TALK"    , "narrator": "アーヤ", "text": "あっ！"},
        { "location": "357/TALK"    , "narrator": "アーヤ", "text": "そうだった…。\n二人とも学校の制服\nだったの忘れてたわ。"},
        { "location": "358/TALK"    , "narrator": "神楽", "text": "今からクリーニングに\n出しても、明日の朝には\n間に合いませんし――"},
        { "location": "359/TALK"    , "narrator": "神楽", "text": "かといって、焼肉臭い\n制服で学校に行くのも、\nちょっと…。"},
        { "location": "361/TALK"    , "narrator": "アーヤ", "text": "…ごめんなさい。\nうっかりしてたわ。"},
        { "location": "362/TALK"    , "narrator": "神楽", "text": "まあ、アーヤさんは\n普段私服ですから――"},
        { "location": "363/TALK"    , "narrator": "神楽", "text": "うっかりしちゃっても\n仕方ないと思いますよ。"},
        { "location": "365/TALK"    , "narrator": "つばめ", "text": "わたしも、匂いのこと\nまったく頭になかったよ。"},
        { "location": "367/TALK"    , "narrator": "つばめ", "text": "卯月さんがいなかったら、\n明日大変なことになってた\nかも…。"},
        { "location": "369/TALK"    , "narrator": "神楽", "text": "ダメですよ、つばめさん。\n女子力足りない、って\n思われちゃいますよ？"},
        { "location": "370/TALK"    , "narrator": "アーヤ", "text": "…でも、本当に何食べる？\n意見バラバラで決まり\nそうにないんだけど？"},
        { "location": "373/TALK"    , "narrator": "神楽", "text": "う～ん…つばめさんは\n豚カツ食べたいですか？"},
        { "location": "377/TALK"    , "narrator": "つばめ", "text": "う～ん…どうしても、って\nわけじゃないけど…。"},
        { "location": "378/TALK"    , "narrator": "神楽", "text": "私も、そこまで\nブイヤベースを食べたい\nわけじゃなくて…。"},
        { "location": "379/TALK"    , "narrator": "アーヤ", "text": "…それなら、今日は\nこのまま寮に戻る？"},
        { "location": "380/TALK"    , "narrator": "アーヤ", "text": "特に食べたい物も\nないなら、外食しても\n楽しくなさそうだし。"},
        { "location": "383/TALK"    , "narrator": "神楽", "text": "それが良さそうですね。\nつばめさんも、それで\nいいですか？"},
        { "location": "384/TALK"    , "narrator": "つばめ", "text": "うん…今日は料理をして、\n女子力を取り戻す努力を\nするよ…。"},
        { "location": "387/TALK"    , "narrator": "神楽", "text": "もぉ、さっき言ったのは\n冗談ですよ。"},
        { "location": "390/TALK"    , "narrator": "アーヤ", "text": "…むしろ、焼肉を提案した\n私の方が気にしないと\nいけないわね。"},
        { "location": "391/ACT"     , "narrator": "", "text": "濃厚なラーメンでしょ"},
        { "location": "393/TALK"    , "narrator": "アーヤ", "text": "いいわね、ラーメン！"},
        { "location": "394/TALK"    , "narrator": "アーヤ", "text": "みんなにも聞いてみるわ"},
        { "location": "407/TALK"    , "narrator": "アーヤ", "text": "それなら、ラーメンなんて\nどうかしら？"},
        { "location": "409/TALK"    , "narrator": "つばめ", "text": "ラーメンですか？"},
        { "location": "410/TALK"    , "narrator": "アーヤ", "text": "濃厚なラーメン、\n最近食べてないな、って\n思ってね。"},
        { "location": "412/TALK"    , "narrator": "神楽", "text": "濃厚なラーメン…。\nそれも素敵ですね！"},
        { "location": "413/TALK"    , "narrator": "神楽", "text": "どこか、\n美味しいお店が\nあるんですか？"},
        { "location": "414/TALK"    , "narrator": "アーヤ", "text": "ええ、すぐそこのお店が\nお勧めなんだけど――"},
        { "location": "415/TALK"    , "narrator": "アーヤ", "text": "どう、行ってみる？"},
        { "location": "418/TALK"    , "narrator": "つばめ", "text": "賛成です！\n卯月さん、行こうよ。"},
        { "location": "421/TALK"    , "narrator": "神楽", "text": "…そうですね！\nお二人がそう言うなら、\n是非行きましょう！"},
        { "location": "422/TALK"    , "narrator": "アーヤ", "text": "決まりね。\nそれじゃ、行きましょ。"},
        { "location": "428/TALK"    , "narrator": "神楽", "text": "ふぅ…ちょっと、\nお腹が重いです…。"},
        { "location": "430/TALK"    , "narrator": "つばめ", "text": "卯月さん、大丈夫？"},
        { "location": "431/TALK"    , "narrator": "神楽", "text": "あんなに味が濃くて、\n具の多いラーメン、\n初めて食べました…。"},
        { "location": "433/TALK"    , "narrator": "アーヤ", "text": "最後の方、必死になって\n食べてたのわかったわ。"},
        { "location": "434/TALK"    , "narrator": "アーヤ", "text": "それで、感想は？"},
        { "location": "436/TALK"    , "narrator": "神楽", "text": "はい！\n凄く美味しかったです！"},
        { "location": "437/TALK"    , "narrator": "神楽", "text": "…ただ、カロリーが\n凄く高そうだったのが、\n少し心配ですけど…。"},
        { "location": "438/TALK"    , "narrator": "アーヤ", "text": "感動が薄れることを\n考えるのは、野暮って\nものよ。"},
        { "location": "441/TALK"    , "narrator": "アーヤ", "text": "…私も、しばらくは\n体重計に乗るのが\n怖いけど。"},
        { "location": "458/ACT"     , "narrator": "", "text": "イタリアンで行こう"},
        { "location": "459/TALK"    , "narrator": "アーヤ", "text": "その言い方、凄く素敵ね"},
        { "location": "460/TALK"    , "narrator": "アーヤ", "text": "気に入ったわ(≧ω≦)"},
        { "location": "472/TALK"    , "narrator": "アーヤ", "text": "イタリアンとかは\nどうかしら？"},
        { "location": "474/TALK"    , "narrator": "神楽", "text": "イタリアン、ですか？"},
        { "location": "476/TALK"    , "narrator": "アーヤ", "text": "そう、イタリアン。\nみんなで食べられる、\n美味しいのがあるでしょ？"},
        { "location": "478/TALK"    , "narrator": "つばめ", "text": "イタリアンで、みんなで\n食べられるものって\nいうと…。"},
        { "location": "480/TALK"    , "narrator": "神楽", "text": "あっ、わかりました！"},
        { "location": "482/TALK"    , "narrator": "神楽", "text": "私も賛成です。\nイタリアンにしましょう。"},
        { "location": "483/TALK"    , "narrator": "アーヤ", "text": "卯月はわかったみたいね。"},
        { "location": "484/TALK"    , "narrator": "神楽", "text": "もちろんです。\nでも、凄いですね。"},
        { "location": "485/TALK"    , "narrator": "神楽", "text": "ケーキの後にあれを\n食べようって言うと、\n凄く罪悪感あるのに――"},
        { "location": "486/TALK"    , "narrator": "神楽", "text": "イタリアン、って\nぼかすと、少しだけ\n薄れる気がします。"},
        { "location": "487/TALK"    , "narrator": "アーヤ", "text": "そういうことよ。\nつばめも、それでいい？"},
        { "location": "489/TALK"    , "narrator": "つばめ", "text": "え、えっと…\nイタリアンっていうのは\nその――"},
        { "location": "492/TALK"    , "narrator": "つばめ", "text": "ピザのことですよね？"},
        { "location": "493/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "495/TALK"    , "narrator": "神楽", "text": "…ハッキリ言わないように\nしてたのに、おもいっきり\n言いましたね？"},
        { "location": "496/TALK"    , "narrator": "つばめ", "text": "えっ…あ、あぁっ！"},
        { "location": "498/TALK"    , "narrator": "つばめ", "text": "ごめんなさい！\n全然気づかなかったよぉ。"},
        { "location": "499/TALK"    , "narrator": "アーヤ", "text": "…まあ、どう取り繕っても\nピザ食べに行くのには\n変わらないんだし――"},
        { "location": "500/TALK"    , "narrator": "アーヤ", "text": "もう開き直って、\nピザ食べに行くわよ。"},
        { "location": "503/TALK"    , "narrator": "神楽", "text": "ふふっ、そうですね。\nもう今日はお腹いっぱい\n食べちゃいます！"},
        { "location": "504/TALK"    , "narrator": "つばめ", "text": "どんなピザがあるかな？\n楽しみだね！"},
        { "location": "234/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月10日　5:34 PM</color>\n初夏の週末、午後の神楽坂通り。"},
        { "location": "452/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch02", "text": "【ダイエットは明日から】"}
    ]
}
