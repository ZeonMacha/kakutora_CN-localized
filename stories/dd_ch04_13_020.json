{
    "dir": "chap13/daydra/dd_ch04_13_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "13456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "男子からかい系"
    },
    "entry":
    [
        { "location": "256/SCENARIO", "narrator": "", "text": "男子からかい系"},
        { "location": "272/TALK"    , "narrator": "キリト", "text": "あ～、クソッ！\n朝っぱらから気分悪ぃもん\n見ちまったぜ。"},
        { "location": "274/TALK"    , "narrator": "ヒカル", "text": "まあまあ、キリト。\nそう怒らずに。"},
        { "location": "279/TALK"    , "narrator": "みやび", "text": "朝っぱらから\n随分気が立っちゅうなぁ。"},
        { "location": "282/TALK"    , "narrator": "キリト", "text": "あっ、みやび先輩！\nおはよーっす。"},
        { "location": "284/TALK"    , "narrator": "ヒカル", "text": "おはようございます。\nすみません、朝から\n騒がしくて…。"},
        { "location": "285/TALK"    , "narrator": "みやび", "text": "何かあったがか？"},
        { "location": "286/TALK"    , "narrator": "キリト", "text": "いや…ちょっとした\nことっすけど――"},
        { "location": "287/TALK"    , "narrator": "キリト", "text": "さっき、手を繋いで\n登校してるカップルを\n見かけたんすよ。"},
        { "location": "288/TALK"    , "narrator": "みやび", "text": "あ～…それはウザいわ。"},
        { "location": "292/TALK"    , "narrator": "キリト", "text": "でしょ！？\n朝っぱらからイチャつくん\nじゃねぇ、って話っすよ！"},
        { "location": "294/TALK"    , "narrator": "ヒカル", "text": "妬んでるだけじゃ\nないですか。"},
        { "location": "296/TALK"    , "narrator": "みやび", "text": "…そういえば、\n二人はまだ彼女さん\nおらんが？"},
        { "location": "299/TALK"    , "narrator": "ヒカル", "text": "あはは…残念ながら、\nまだ交際の経験は\nありません。"},
        { "location": "302/TALK"    , "narrator": "キリト", "text": "…直球で聞いてくるの\n勘弁してくださいよ。"},
        { "location": "303/TALK"    , "narrator": "みやび", "text": "遠回しに聞くより、\nこっちの方がダメージ\n少ないと思うけんどな。"},
        { "location": "304/TALK"    , "narrator": "みやび", "text": "けんど、不思議な話やね。\n二人とも結構イケメンさん\nやと思うんやが…。"},
        { "location": "305/TALK"    , "narrator": "キリト", "text": "仕方ないじゃないっすか。\n出会いがないんだし…。"},
        { "location": "306/TALK"    , "narrator": "みやび", "text": "なんや？\n出会うための努力は\nしてるが？"},
        { "location": "308/TALK"    , "narrator": "キリト", "text": "そ、それは…。"},
        { "location": "310/TALK"    , "narrator": "みやび", "text": "…キリト君、\n女の子は桃太郎さんの\n桃やないき――"},
        { "location": "311/TALK"    , "narrator": "みやび", "text": "どんぶらこっこ\n会いに来たりはせんよ。"},
        { "location": "312/TALK"    , "narrator": "キリト", "text": "…………。"},
        { "location": "314/TALK"    , "narrator": "みやび", "text": "…男がそんなクヨクヨ\nするんもいかんよ。"},
        { "location": "315/TALK"    , "narrator": "みやび", "text": "本当に恋人さん欲しい\n思うてるなら、もっと\nグイグイ行かんとな。"},
        { "location": "317/TALK"    , "narrator": "キリト", "text": "…そう言われても、\nどうすりゃいいのか\nわかんねぇし…なぁ？"},
        { "location": "319/TALK"    , "narrator": "ヒカル", "text": "僕に振らないでください。"},
        { "location": "320/TALK"    , "narrator": "みやび", "text": "ひなこちゃん達と\n仲えいき、女子に不慣れ\nいうわけでもないのに…。"},
        { "location": "321/TALK"    , "narrator": "みやび", "text": "意外と可愛らしいとこ\nあるんやねぇ…ちっくと、\nイタズラしてみるちや。"},
        { "location": "322/TALK"    , "narrator": "みやび", "text": "わかった。\nじゃあ、うちで練習して\nみるちや。"},
        { "location": "326/TALK"    , "narrator": "キリト", "text": "は？　何のっすか？"},
        { "location": "327/TALK"    , "narrator": "みやび", "text": "女の子に声かけたり、\n口説いたりする練習や。"},
        { "location": "328/TALK"    , "narrator": "キリト", "text": "ちょ、えぇっ！？\nみやび先輩で！？"},
        { "location": "330/TALK"    , "narrator": "ヒカル", "text": "い、いや、みやび先輩。\n提案はありがたいですが、\nその…ちょっと…。"},
        { "location": "331/SEL"     , "narrator": "", "text": "純情な男子をからかうな"},
        { "location": "332/SEL"     , "narrator": "", "text": "教育してあげよう"},
        { "location": "335/TALK"    , "narrator": "みやび", "text": "うちじゃ物足りんが？"},
        { "location": "336/TALK"    , "narrator": "ヒカル", "text": "と、とんでもない！\nそうじゃなくてですね、\nその…。"},
        { "location": "337/TALK"    , "narrator": "キリト", "text": "う、嬉しいっすよ！\nマジ嬉しいっす！！"},
        { "location": "339/TALK"    , "narrator": "キリト", "text": "けど、覚悟っていうか、\nなんていうか…なあ？"},
        { "location": "341/TALK"    , "narrator": "ヒカル", "text": "一々僕に振らないで\nください！"},
        { "location": "342/TALK"    , "narrator": "みやび", "text": "ビックリするくらい\n初心な子達やねぇ…。"},
        { "location": "343/TALK"    , "narrator": "みやび", "text": "手取り足取り、うちが\n教えんといかんがか？"},
        { "location": "346/TALK"    , "narrator": "キリト", "text": "いっ、いいんすか！？"},
        { "location": "350/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "352/TALK"    , "narrator": "みやび", "text": "やっぱ面倒やき、\nここから先は\n自習にするちや。"},
        { "location": "354/TALK"    , "narrator": "キリト", "text": "うぇっ！？"},
        { "location": "356/TALK"    , "narrator": "キリト", "text": "いや、みやび先輩！\nここまで来てそれは\nマジでないっすよ！！"},
        { "location": "358/TALK"    , "narrator": "みやび", "text": "何でもかんでもうちに\n聞いたら、キリト君達の\nためにならんちや。"},
        { "location": "359/TALK"    , "narrator": "みやび", "text": "これも愛の鞭なんよ。\nわかってくれるな？"},
        { "location": "361/TALK"    , "narrator": "ヒカル", "text": "…まあ、わからなくは\nないですけど…。"},
        { "location": "364/TALK"    , "narrator": "キリト", "text": "おい、バカ！！\n何勝手なこと――"},
        { "location": "365/TALK"    , "narrator": "みやび", "text": "うん、わかってくれたなら\nうちも安心や。"},
        { "location": "367/TALK"    , "narrator": "みやび", "text": "じゃ、宿題頑張りや。"},
        { "location": "371/TALK"    , "narrator": "キリト", "text": "余計なこと言いやがって。\nあ～、くそぉ…。"},
        { "location": "373/TALK"    , "narrator": "ヒカル", "text": "いいじゃないですか…。\nどうせ僕たち、何も\nできませんでしたよ。"},
        { "location": "375/TALK"    , "narrator": "キリト", "text": "…だな。\nはは、かっこわりぃ…。"},
        { "location": "377/ACT"     , "narrator": "", "text": "純情な男子をからかうな"},
        { "location": "381/TALK"    , "narrator": "みやび", "text": "ん？　ちっくと待ちぃ。"},
        { "location": "397/TALK"    , "narrator": "みやび", "text": "なるほど"},
        { "location": "398/TALK"    , "narrator": "みやび", "text": "純情な男子からかって、不純な男子になったら困るきね"},
        { "location": "410/TALK"    , "narrator": "みやび", "text": "…話はしまいや。\nうちは教室行くちや。"},
        { "location": "412/TALK"    , "narrator": "キリト", "text": "は！？\nも、もういいんすか？"},
        { "location": "414/TALK"    , "narrator": "みやび", "text": "うん…相棒に怒られて\nしもうたきね。"},
        { "location": "415/TALK"    , "narrator": "みやび", "text": "純情な男子をからかうんは\nやめろ、ってな。"},
        { "location": "417/TALK"    , "narrator": "ヒカル", "text": "相棒？\nそれって…。"},
        { "location": "420/TALK"    , "narrator": "みやび", "text": "おっと、話はここまでや。\n女にはまっこと沢山の\n秘密があるんぞね～。"},
        { "location": "424/TALK"    , "narrator": "キリト", "text": "…なんかよくわかんねぇ\nけど、解放はされた\nみたいだな。"},
        { "location": "426/TALK"    , "narrator": "ヒカル", "text": "そうですね…。\nはぁ、まだ心臓が\nバクバクしてますよ。"},
        { "location": "429/TALK"    , "narrator": "キリト", "text": "朝からみやび先輩の\n色気たっぷりオーラは、\nちょっと毒だよな。"},
        { "location": "431/TALK"    , "narrator": "キリト", "text": "…けどよ、みやび先輩が\n言ってた相棒って、\n誰のことだ？"},
        { "location": "432/TALK"    , "narrator": "ヒカル", "text": "さあ？　少なくとも、\n逢瀬さん達の誰かでは\nなさそうですが…。"},
        { "location": "433/TALK"    , "narrator": "ヒカル", "text": "…彼氏、でしょうか？"},
        { "location": "437/TALK"    , "narrator": "キリト", "text": "ははは、まさかぁ！\nそりゃさすがにねぇだろ？"},
        { "location": "440/TALK"    , "narrator": "ヒカル", "text": "そ、そうですよね。\n考え過ぎでした。"},
        { "location": "441/TALK"    , "narrator": "キリト", "text": "…………。"},
        { "location": "442/TALK"    , "narrator": "ヒカル", "text": "…………。"},
        { "location": "443/TALK"    , "narrator": "キリト", "text": "…違うよな？"},
        { "location": "446/TALK"    , "narrator": "ヒカル", "text": "…そう願ってます。"},
        { "location": "447/ACT"     , "narrator": "", "text": "教育してあげよう"},
        { "location": "452/TALK"    , "narrator": "みやび", "text": "ん？　ちっくと待ちや。"},
        { "location": "470/TALK"    , "narrator": "みやび", "text": "相棒、おぬしも悪よのぅ？"},
        { "location": "471/TALK"    , "narrator": "みやび", "text": "純情男子をこれ以上からかえ言うんか？"},
        { "location": "472/TALK"    , "narrator": "みやび", "text": "まあ、止めんのやったら遠慮せず教育するちや"},
        { "location": "483/TALK"    , "narrator": "みやび", "text": "さて…何かしてこんと\n練習にならんよ？"},
        { "location": "485/TALK"    , "narrator": "キリト", "text": "いや、だから何すれば\nいいかわかんねぇし…。"},
        { "location": "488/TALK"    , "narrator": "みやび", "text": "甘い言葉かけるでも\nデートに誘うでも、\n何でもえいちや。"},
        { "location": "491/TALK"    , "narrator": "ヒカル", "text": "いきなりそんなの\n無理ですよ！"},
        { "location": "495/TALK"    , "narrator": "みやび", "text": "じゃあ、強引にチュー\nでもするがか？"},
        { "location": "500/TALK"    , "narrator": "キリト", "text": "ちゅ、チューッ！？\nそれって、その…き、\nキスってこと？"},
        { "location": "503/TALK"    , "narrator": "みやび", "text": "…二人とも、まっこと\nこういうことに耐性が\nないんやね。"},
        { "location": "504/TALK"    , "narrator": "みやび", "text": "もうえいき、ここは\n一発ブチュッとやって、\n耐性付けるちや。"},
        { "location": "506/TALK"    , "narrator": "ヒカル", "text": "本気ですか！？"},
        { "location": "507/TALK"    , "narrator": "みやび", "text": "ウソはつかん。\nほれ、どっちから\nするちや？"},
        { "location": "509/TALK"    , "narrator": "キリト", "text": "…い、いいのか？\nこれ、本当に良いのか？"},
        { "location": "511/TALK"    , "narrator": "ヒカル", "text": "ぼ、僕に聞かれても…\nでも、みやび先輩が\n言っているんですし…。"},
        { "location": "513/TALK"    , "narrator": "繭", "text": "おはようございます、\nみやび先輩。"},
        { "location": "517/TALK"    , "narrator": "キリト", "text": "うわぁっ！？"},
        { "location": "520/TALK"    , "narrator": "ヒカル", "text": "ま、繭さん！？"},
        { "location": "522/TALK"    , "narrator": "繭", "text": "朝からウザいやかましい。\n大声出すな。"},
        { "location": "523/TALK"    , "narrator": "繭", "text": "…ていうか、二人とも\n顔が赤い。\n何かあった？"},
        { "location": "525/TALK"    , "narrator": "キリト", "text": "べ、別に！！\nな、ヒカル！？"},
        { "location": "527/TALK"    , "narrator": "ヒカル", "text": "そ、そうですね。\nうん、何もありません\nでした。"},
        { "location": "528/TALK"    , "narrator": "キリト", "text": "じゃあ俺たち先に\n行くから、また後でな！"},
        { "location": "534/TALK"    , "narrator": "みやび", "text": "はぁ…朝から元気やねぇ。"},
        { "location": "536/TALK"    , "narrator": "繭", "text": "…あの二人、\n何かあったんですか？"},
        { "location": "539/TALK"    , "narrator": "みやび", "text": "ないない、何もないぞね。"},
        { "location": "540/TALK"    , "narrator": "みやび", "text": "ちっくと純情な男の子いう\nだけやき、心配するほどの\nことやないんよ。"},
        { "location": "269/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>6月27日　7:18 AM</color>\n初夏の朝、学園正門にて。"},
        { "location": "551/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch04", "text": "【ハニーポッド、ハニートラップ】"}
    ]
}
