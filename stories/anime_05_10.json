{
    "dir": "chap10/daydra/anime_05_10.js",
    "type": "MainStory",
    "info": {
        "story_id": "10501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "哀，ロボット"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第10話"},
        { "location": "20/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "21/TALK"   , "narrator": "エリカ", "text": "いらっしゃい\n$handle$さん。"},
        { "location": "22/TALK"   , "narrator": "エリカ", "text": "もう一度お話聞く？\nそれとも、省略する？"},
        { "location": "23/SEL"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "24/SEL"    , "narrator": "", "text": "飛ばす"},
        { "location": "25/ACT"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "26/TALK"   , "narrator": "エリカ", "text": "うん、わかったよ。"},
        { "location": "28/ACT"    , "narrator": "", "text": "飛ばす"},
        { "location": "29/TALK"   , "narrator": "エリカ", "text": "そっかー。\nそれじゃ、またね。"},
        { "location": "36/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "37/TALK"   , "narrator": "エリカ", "text": "また来てくれて\nありがとう。"},
        { "location": "38/TALK"   , "narrator": "エリカ", "text": "まず今の\n状況だけど――"},
        { "location": "39/TALK"   , "narrator": "エリカ", "text": "現状、取り立てて\n大きな動きはありません！"},
        { "location": "40/TALK"   , "narrator": "エリカ", "text": "“彼ら”もまだ\n不審なところを\n見つけられてないみたい。"},
        { "location": "41/SEL"    , "narrator": "", "text": "よかった"},
        { "location": "42/SEL"    , "narrator": "", "text": "ていうか、エリカって今、いつのどこにいるの？"},
        { "location": "43/ACT"    , "narrator": "", "text": "よかった"},
        { "location": "44/TALK"   , "narrator": "エリカ", "text": "うん！"},
        { "location": "45/ACT"    , "narrator": "", "text": "ていうか、エリカって今、いつのどこにいるの？"},
        { "location": "46/TALK"   , "narrator": "エリカ", "text": "え？\nどうして？"},
        { "location": "47/SEL"    , "narrator": "", "text": "“彼ら”との時間的関係ってどうなってるのかと思って"},
        { "location": "48/SEL"    , "narrator": "", "text": "愛する人がどこにいるのか知りたいのは当然のこと"},
        { "location": "49/ACT"    , "narrator": "", "text": "“彼ら”との時間的関係ってどうなってるのかと思って"},
        { "location": "50/TALK"   , "narrator": "エリカ", "text": "あー、なるほど。\n確かにそれは\n気になるかも。"},
        { "location": "51/ACT"    , "narrator": "", "text": "好きな人がどこにいるのか知りたいのは当然のこと"},
        { "location": "52/TALK"   , "narrator": "エリカ", "text": "あはは…ありがとう。"},
        { "location": "53/TALK"   , "narrator": "エリカ", "text": "でも、教えても\nここに来ることは\nできないと思うし……。"},
        { "location": "54/TALK"   , "narrator": "エリカ", "text": "いつかお互いが\n行き来出来るように\nなるといいよね。"},
        { "location": "56/TALK"   , "narrator": "エリカ", "text": "わたしが今いる場所は、\nつばめちゃんの日本でも\n2032年の世界でもない。"},
        { "location": "57/TALK"   , "narrator": "エリカ", "text": "わたしの居場所を\n正確に把握してるのは\nRedinessだけなの。"},
        { "location": "58/TALK"   , "narrator": "エリカ", "text": "時間軸でいえば、\n外の世界においては\n今は2032年。"},
        { "location": "59/TALK"   , "narrator": "エリカ", "text": "中の世界においては\n2016年の、TRI-OSが\n指し示す時間軸――"},
        { "location": "60/TALK"   , "narrator": "エリカ", "text": "すなわち、千羽鶴ちゃんが\n設定したエピソード\nポインタの時間軸にいる。"},
        { "location": "61/SEL"    , "narrator": "", "text": "てことは、第三の世界ってこと？？"},
        { "location": "62/SEL"    , "narrator": "", "text": "それもフェノメノンなの？"},
        { "location": "63/ACT"    , "narrator": "", "text": "てことは、第三の世界ってこと？？"},
        { "location": "64/TALK"   , "narrator": "エリカ", "text": "まあ、\n誤解を恐れずに言えば、\n概ねその通りかな。"},
        { "location": "65/ACT"    , "narrator": "", "text": "それもフェノメノンなの？"},
        { "location": "66/TALK"   , "narrator": "エリカ", "text": "うーん……\nそれは何とも\n言えないなぁ。"},
        { "location": "68/TALK"   , "narrator": "エリカ", "text": "あともう１つ、\n誤解しがちなことについて\n説明しておくと――"},
        { "location": "69/TALK"   , "narrator": "エリカ", "text": "今あなたが見ている\nこのわたしの姿と世界は\n仮想空間だからね？"},
        { "location": "70/TALK"   , "narrator": "エリカ", "text": "Redinessを介して接続\nされてる、量子サーバーの\n中だと思ってくれていい。"},
        { "location": "71/TALK"   , "narrator": "エリカ", "text": "わたしだけじゃなくて、\n千羽鶴ちゃんも同じだよ？"},
        { "location": "72/TALK"   , "narrator": "エリカ", "text": "わたしが今いる場所からは\n2032年の世界も16年の\n世界もあなたの世界も――"},
        { "location": "73/TALK"   , "narrator": "エリカ", "text": "全部同じ立ち位置にある。\nそれは、セカイアドレスの\n違う別世界同士。"},
        { "location": "74/TALK"   , "narrator": "エリカ", "text": "そういった別世界同士を\n繋いでるのがこの場所、\n量子サーバーなんだよ。"},
        { "location": "75/TALK"   , "narrator": "エリカ", "text": "千羽鶴ちゃんもわたしと\n同じで、とある１つの\n世界からここに繋いでる。"},
        { "location": "76/SEL"    , "narrator": "", "text": "要するに、量子サーバーが世界同士の中継所ってこと？"},
        { "location": "77/SEL"    , "narrator": "", "text": "てことは、千羽鶴とエリカの共演も夢じゃないと！"},
        { "location": "78/ACT"    , "narrator": "", "text": "要するに、量子サーバーが世界同士の中継所ってこと？"},
        { "location": "79/TALK"   , "narrator": "エリカ", "text": "まあ、だいたい\nそうだと思ってくれて\n大丈夫かな。"},
        { "location": "80/TALK"   , "narrator": "エリカ", "text": "うーん、もうちょっと\n厳密に言うと――"},
        { "location": "81/TALK"   , "narrator": "エリカ", "text": "違う世界に住むそれぞれの\n魂が、量子サーバーを\n経由して繋がってる…？"},
        { "location": "82/ACT"    , "narrator": "", "text": "てことは、千羽鶴とエリカの共演も夢じゃないと！"},
        { "location": "83/TALK"   , "narrator": "エリカ", "text": "うーん、残念だけど\nそれは素の状態では\n出来ないかな。"},
        { "location": "84/TALK"   , "narrator": "エリカ", "text": "このチャンネルは、\n個々の精神が直接アクセス\nしてるから。"},
        { "location": "85/TALK"   , "narrator": "エリカ", "text": "そういう意味では、\n今はわたしのココロが\n投影された状態であり――"},
        { "location": "86/TALK"   , "narrator": "エリカ", "text": "千羽鶴ちゃんがいる時は\n千羽鶴ちゃんのココロを\n投影した状態ってこと。"},
        { "location": "87/TALK"   , "narrator": "エリカ", "text": "まあ、例外的な見せ方は\nあって、それをやれば\n共演は実現可能だけど――"},
        { "location": "88/TALK"   , "narrator": "エリカ", "text": "その方法がどういうものか\n説明するのはちょっと\n難しいかも。"},
        { "location": "89/SEL"    , "narrator": "", "text": "じゃあ一度実演してみせてよ"},
        { "location": "90/ACT"    , "narrator": "", "text": "じゃあ一度実演してみせてよ"},
        { "location": "92/TALK"   , "narrator": "エリカ", "text": "ええっ！？"},
        { "location": "93/TALK"   , "narrator": "エリカ", "text": "うーん、簡単に言うけど\n簡単に出来ないから、\n普段一人なわけで……"},
        { "location": "94/TALK"   , "narrator": "エリカ", "text": "……まあ、今度\n一度くらいなら、実演して\n見せてもいいかなぁ。"},
        { "location": "95/TALK"   , "narrator": "エリカ", "text": "ちょっと\n考えてみるね。"},
        { "location": "97/TALK"   , "narrator": "エリカ", "text": "とまあ、\n説明長くなっちゃったけど\nだいたいそんな感じかな。"},
        { "location": "98/TALK"   , "narrator": "エリカ", "text": "ちょっと\n回りくどい言い方に\nなっちゃったけど――"},
        { "location": "99/TALK"   , "narrator": "エリカ", "text": "要はそれぞれみんな、\n別の世界から繋いでるって\nことが解ってもらえれば。"},
        { "location": "100/TALK"  , "narrator": "エリカ", "text": "特に、千羽鶴ちゃんが\nここに繋いでる世界は、\nあなたが良く知る世界だし。"},
        { "location": "101/TALK"  , "narrator": "エリカ", "text": "セカイアドレスで言えば\n2EF4Fという世界。"},
        { "location": "102/TALK"  , "narrator": "エリカ", "text": "そして\nわたしが繋いでる世界は、\nそことは別の可能性世界。"},
        { "location": "103/TALK"  , "narrator": "エリカ", "text": "セカイアドレスは2E113。\nちなみに、外の2032年は\n15F9Cって付けられてる。"},
        { "location": "104/SEL"   , "narrator": "", "text": "え"},
        { "location": "106/TALK"  , "narrator": "エリカ", "text": "それぞれの世界は\n別の可能性世界だけど――"},
        { "location": "107/TALK"  , "narrator": "エリカ", "text": "Redinessを使っている人\n同士は、量子サーバーを\n介して繋がっている。"},
        { "location": "110/TALK"  , "narrator": "エリカ", "text": "…と、そんな感じ。"},
        { "location": "111/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "112/SEL"   , "narrator": "", "text": "$me$の世界はどうやって繋がってるの？"},
        { "location": "113/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "114/ACT"   , "narrator": "", "text": "$me$の世界はどうやって繋がってるの？"},
        { "location": "115/TALK"  , "narrator": "エリカ", "text": "あなたの世界はちょっと\n特殊で、TRI-OSが\n接続管理してる。"},
        { "location": "116/TALK"  , "narrator": "エリカ", "text": "だから、接続方式は少し\n特殊で、セカイアドレスも\nわからないんだよね。"},
        { "location": "117/TALK"  , "narrator": "エリカ", "text": "TRI-OSが自動検索\nしたアドレスだから。"},
        { "location": "118/SEL"   , "narrator": "", "text": "ログを見るとかで解ったりしないの？"},
        { "location": "119/ACT"   , "narrator": "", "text": "ログを見るとかで解ったりしないの？"},
        { "location": "121/TALK"  , "narrator": "エリカ", "text": "そもそも15F9Cとかの\n16進数アドレスは、\nある意味後付なんだ。"},
        { "location": "122/TALK"  , "narrator": "エリカ", "text": "それはもちろんその世界の\n量子状態の一部から算出\nされた数字ではあるけど―"},
        { "location": "123/TALK"  , "narrator": "エリカ", "text": "あくまでTRI-OSの\n外部装置であるノイマン\nちゃんがつけた数値で。"},
        { "location": "124/SEL"   , "narrator": "", "text": "ノイマンちゃん？"},
        { "location": "125/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "126/ACT"   , "narrator": "", "text": "ノイマンちゃん？"},
        { "location": "127/TALK"  , "narrator": "エリカ", "text": "あっ、えっと、\nノイマン式計算機。"},
        { "location": "128/TALK"  , "narrator": "エリカ", "text": "いわゆる普通の\nコンピューターの\nことだよ。"},
        { "location": "129/TALK"  , "narrator": "エリカ", "text": "あなたが今使ってる\n端末もノイマン式計算機。"},
        { "location": "130/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "132/TALK"  , "narrator": "エリカ", "text": "だから、TRI-OSが\n自動検索で照準を合わせた\n世界のアドレスは――"},
        { "location": "133/TALK"  , "narrator": "エリカ", "text": "量子ビットによる変数に\n格納されてはいるけど、\n数値にはなってないの。"},
        { "location": "135/ACT"   , "narrator": "", "text": "え"},
        { "location": "136/TALK"  , "narrator": "エリカ", "text": "ん？"},
        { "location": "137/SEL"   , "narrator": "", "text": "2E113って、前に聞いたことがある！"},
        { "location": "138/ACT"   , "narrator": "", "text": "2E113って、前に聞いたことがある！"},
        { "location": "140/TALK"  , "narrator": "エリカ", "text": "え？\nそんなはずは……"},
        { "location": "141/TALK"  , "narrator": "エリカ", "text": "たまたま何かの\n数字と似てるだけとかじゃ\nないのかな？"},
        { "location": "142/SEL"   , "narrator": "", "text": "あー…それはあるかも"},
        { "location": "143/SEL"   , "narrator": "", "text": "それはない。みやびが言ってた"},
        { "location": "144/ACT"   , "narrator": "", "text": "あー…それはあるかも"},
        { "location": "145/TALK"  , "narrator": "エリカ", "text": "だよね。\nわたしだって、誰かに\n言うのは初めてだもん。"},
        { "location": "146/ACT"   , "narrator": "", "text": "それはない。みやびが言ってた"},
        { "location": "148/TALK"  , "narrator": "エリカ", "text": "みやびちゃんが？？"},
        { "location": "151/TALK"  , "narrator": "エリカ", "text": "うーん……"},
        { "location": "152/TALK"  , "narrator": "エリカ", "text": "なるほどね。\nそんなことがあったんだ。"},
        { "location": "153/TALK"  , "narrator": "エリカ", "text": "わたしにはちょっと\nこのログの意図は\nわからないけど――"},
        { "location": "154/TALK"  , "narrator": "エリカ", "text": "いまのところ、\nわたしの周りでは特に\nそんな動きは無いかな。"},
        { "location": "155/TALK"  , "narrator": "エリカ", "text": "それと一応、\n多分大丈夫だとは\n思うけど……"},
        { "location": "156/TALK"  , "narrator": "エリカ", "text": "これって、わたしが\n知っちゃって大丈夫な\n情報だったのかな。"},
        { "location": "157/SEL"   , "narrator": "", "text": "えっ"},
        { "location": "158/ACT"   , "narrator": "", "text": "えっ"},
        { "location": "160/TALK"  , "narrator": "エリカ", "text": "多分、わたしが知ってる\n前提で共有しようと\nしたんだと思うけど――"},
        { "location": "161/TALK"  , "narrator": "エリカ", "text": "わたしは知らなかったし、\n多分この世界の未来の\n情報に当たると思うんだ。"},
        { "location": "162/TALK"  , "narrator": "エリカ", "text": "だから、わたしが\n意図するしないに\nかかわらず――"},
        { "location": "163/TALK"  , "narrator": "エリカ", "text": "みやびちゃんの目指す\n未来に到達できる可能性が\n変わっちゃったかも。"},
        { "location": "164/SEL"   , "narrator": "", "text": "それって困難になったってこと？"},
        { "location": "165/SEL"   , "narrator": "", "text": "それってエリカがみやびの計画を邪魔するってこと？"},
        { "location": "166/ACT"   , "narrator": "", "text": "それって困難になったってこと？"},
        { "location": "167/TALK"  , "narrator": "エリカ", "text": "そうかもしれないし、\n逆に簡単になったかも\nしれない。"},
        { "location": "168/ACT"   , "narrator": "", "text": "それってエリカがみやびの計画を邪魔するってこと？"},
        { "location": "169/TALK"  , "narrator": "エリカ", "text": "違う違う！"},
        { "location": "170/TALK"  , "narrator": "エリカ", "text": "みやびちゃんが書いてる\nことが本当なら、\nわたしも協力するよ。"},
        { "location": "171/TALK"  , "narrator": "エリカ", "text": "ただ、そうやって意識的に\n介入することは、必ずしも\n良いことじゃない。"},
        { "location": "173/TALK"  , "narrator": "エリカ", "text": "良かれと思って\nやったことで、前より\n悪化したり――"},
        { "location": "174/TALK"  , "narrator": "エリカ", "text": "邪魔したらかえって\nあっさり実現されたり、\nそういう経験あるよね？"},
        { "location": "175/TALK"  , "narrator": "エリカ", "text": "未来を変えようとする時、\nその現象は更に極端に\n作用する。"},
        { "location": "176/TALK"  , "narrator": "エリカ", "text": "だから、みやびちゃんが\nある程度の確実性を持って\nあなたに教えたなら――"},
        { "location": "177/TALK"  , "narrator": "エリカ", "text": "わたしは聞かない方が\n実現度が高かったかも\nしれない。"},
        { "location": "178/TALK"  , "narrator": "エリカ", "text": "逆にまったく未知数なら、\nわたしが聞いたことは\n神のみぞ知る運試し。"},
        { "location": "179/SEL"   , "narrator": "", "text": "あああああ、失敗した…"},
        { "location": "180/ACT"   , "narrator": "", "text": "あああああ、失敗した…"},
        { "location": "182/TALK"  , "narrator": "エリカ", "text": "……まあ、いずれにしても\nあまり気にしない方が\nいいかもしれない。"},
        { "location": "183/TALK"  , "narrator": "エリカ", "text": "気にしても仕方ないし。"},
        { "location": "184/TALK"  , "narrator": "エリカ", "text": "わたしも、なるべく\n影響させないようにしつつ\n実現に向けて頑張るから！"},
        { "location": "185/SEL"   , "narrator": "", "text": "矛盾してない？"},
        { "location": "186/ACT"   , "narrator": "", "text": "矛盾してない？"},
        { "location": "188/TALK"  , "narrator": "エリカ", "text": "えへへ。\nそうかも……。"},
        { "location": "193/TALK"  , "narrator": "エリカ", "text": "さて。\nそれでね――"},
        { "location": "194/TALK"  , "narrator": "エリカ", "text": "今回はちょっと\n重い話をしなくちゃ\nいけないんだけど……。"},
        { "location": "195/TALK"  , "narrator": "エリカ", "text": "その前に、\n記録映像を見ない？"},
        { "location": "196/TALK"  , "narrator": "エリカ", "text": "もちろん、何も変更点は\n無いから、見なくても\n問題ないんだけど――"},
        { "location": "197/TALK"  , "narrator": "エリカ", "text": "ちょっとわたしの方が、\nココロの準備をしたくて。"},
        { "location": "199/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:57】</color>"},
        { "location": "200/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:57】</color>"},
        { "location": "201/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "202/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:57】</color>"},
        { "location": "203/TALK"  , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "209/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:57】</color>"},
        { "location": "210/TALK"  , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "216/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "217/TALK"  , "narrator": "エリカ", "text": "あらら。"},
        { "location": "250/TALK"  , "narrator": "エリカ", "text": "さて、それでね。\n神楽ちゃんに\n関してなんだけど――"},
        { "location": "251/TALK"  , "narrator": "エリカ", "text": "少し前に、ココロの容態が\n急激に変わってしまって。"},
        { "location": "252/SEL"   , "narrator": "", "text": "ココロゲートが壊れそうになってたことと関係ある？"},
        { "location": "253/ACT"   , "narrator": "", "text": "ココロゲートが壊れそうになってたことと関係ある？"},
        { "location": "255/TALK"  , "narrator": "エリカ", "text": "うん。\n関係ある。"},
        { "location": "256/TALK"  , "narrator": "エリカ", "text": "それで急だったけど、\n前回つばめちゃんに\nヘルプに入ってもらった。"},
        { "location": "257/TALK"  , "narrator": "エリカ", "text": "あなたに伝える暇がなくて\nビックリさせちゃって\nごめんね？"},
        { "location": "258/SEL"   , "narrator": "", "text": "一体何が起こってるの？"},
        { "location": "259/ACT"   , "narrator": "", "text": "一体何が起こってるの？"},
        { "location": "261/TALK"  , "narrator": "エリカ", "text": "前に神楽ちゃんの\nRedinessの経由を\n切り替えてもらったよね。"},
        { "location": "262/TALK"  , "narrator": "エリカ", "text": "つばめちゃんの\nフェノメノン経由に\nしてもらったんだけど――"},
        { "location": "263/TALK"  , "narrator": "エリカ", "text": "それが原因かどうかは\nまだわからないんだけど、\n同化現象が起こってるの。"},
        { "location": "264/TALK"  , "narrator": "エリカ", "text": "それによって外の記憶を\n徐々に失い、代わりに\n新しい記憶が入ってきて―"},
        { "location": "265/TALK"  , "narrator": "エリカ", "text": "外の記憶に裏付けられて\nいた彼女のココロが、\n崩壊しかけてる。"},
        { "location": "266/SEL"   , "narrator": "", "text": "えっ、それってフェノメノンの基本じゃなかったっけ？"},
        { "location": "267/SEL"   , "narrator": "", "text": "それって、エリカさんにとっても予想外のことなの？"},
        { "location": "268/ACT"   , "narrator": "", "text": "えっ、それってフェノメノンの基本じゃなかったっけ？"},
        { "location": "269/TALK"  , "narrator": "エリカ", "text": "うん。\n基本中の基本。\nというかね――"},
        { "location": "270/TALK"  , "narrator": "エリカ", "text": "予想外だったことは、\n同化現象そのものの\nことじゃないの。"},
        { "location": "271/ACT"   , "narrator": "", "text": "それって、エリカさんにとっても予想外のことなの？"},
        { "location": "272/TALK"  , "narrator": "エリカ", "text": "予想外だったことは、\nその同化現象そのものの\nことじゃないの。"},
        { "location": "274/TALK"  , "narrator": "エリカ", "text": "だってわたしは、\n同化現象が起きないように\n仕掛けをしていたから。"},
        { "location": "275/TALK"  , "narrator": "エリカ", "text": "あなたにもちょっと\n伝えたと思うけど――"},
        { "location": "276/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんのRedinessは\nつばめちゃん経由で外とも\n繋げたままになってる。"},
        { "location": "277/TALK"  , "narrator": "エリカ", "text": "それによって、\n同化現象を免れつつも、\n彼らを欺く作戦だった。"},
        { "location": "278/TALK"  , "narrator": "エリカ", "text": "けど、現状ではそれが\nうまく機能していない。\nもしくは――"},
        { "location": "279/SEL"   , "narrator": "", "text": "誰かに意図的に、外への回線を外されてる？"},
        { "location": "280/ACT"   , "narrator": "", "text": "誰かに意図的に、外への回線を外されてる？"},
        { "location": "282/TALK"  , "narrator": "エリカ", "text": "うん。\nその可能性は\n一定以上あると思う。"},
        { "location": "283/SEL"   , "narrator": "", "text": "実は“彼ら”に全部筒抜けなのでは？"},
        { "location": "284/SEL"   , "narrator": "", "text": "“彼ら”以外にそれを作為的にやってるヤツがいる？"},
        { "location": "285/ACT"   , "narrator": "", "text": "実は“彼ら”に全部筒抜けなのでは？"},
        { "location": "286/TALK"  , "narrator": "エリカ", "text": "ないない。\nそれはないよ。"},
        { "location": "287/TALK"  , "narrator": "エリカ", "text": "わたしがいる所からなら、\n“彼ら”の動向はかなり\n詳細に確認できる。"},
        { "location": "288/TALK"  , "narrator": "エリカ", "text": "少なくとも、\nリプレイス前からの\n反省点として――"},
        { "location": "289/TALK"  , "narrator": "エリカ", "text": "フェノメノンの内側への\n干渉は、どんな些細な事も\n見逃さないようにしてる。"},
        { "location": "290/TALK"  , "narrator": "エリカ", "text": "けれども、本当に\n何一つ不審な点は無いの。"},
        { "location": "291/TALK"  , "narrator": "エリカ", "text": "それに、“彼ら”の\n計画を考えると、同化は\n都合が悪い筈なんだよね。"},
        { "location": "292/TALK"  , "narrator": "エリカ", "text": "だから、彼らが意図的に\n同化を促進するような事を\nするとは思えない。"},
        { "location": "293/ACT"   , "narrator": "", "text": "“彼ら”以外にそれを作為的にやってるヤツがいる？"},
        { "location": "294/TALK"  , "narrator": "エリカ", "text": "うーん。\nその可能性も\nぬぐい去れないよね。"},
        { "location": "295/TALK"  , "narrator": "エリカ", "text": "でも、誰が？\n何の為に？\nどうやって……？"},
        { "location": "296/TALK"  , "narrator": "エリカ", "text": "わからないこと\nだらけだよ……。"},
        { "location": "298/TALK"  , "narrator": "エリカ", "text": "とにかくこのままだと、\n神楽ちゃんは近いうちに\n外のことを全部忘れる。"},
        { "location": "299/TALK"  , "narrator": "エリカ", "text": "そうなれば、未来の進行は\n無限に拡大してしまって、\n収拾つかなくなる。"},
        { "location": "300/TALK"  , "narrator": "エリカ", "text": "“彼ら”がどう動くか\nだけでなく、現実過去の\n千羽鶴ちゃんさえも……。"},
        { "location": "301/TALK"  , "narrator": "エリカ", "text": "わたしはこれから、\n同化が起こってしまった\n原因を突き止める。"},
        { "location": "302/TALK"  , "narrator": "エリカ", "text": "$handle$さんは、\n前回と同じように――"},
        { "location": "303/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんの心が\n崩壊しないように\nサポートお願いします。"},
        { "location": "304/SEL"   , "narrator": "", "text": "お互い頑張ろう！"},
        { "location": "305/SEL"   , "narrator": "", "text": "エリカって結構抜けてるところあるよね…"},
        { "location": "306/SEL"   , "narrator": "", "text": "わからないとか言ってるけど、本当は確信犯なんじゃないの？"},
        { "location": "307/ACT"   , "narrator": "", "text": "お互い頑張ろう！"},
        { "location": "309/TALK"  , "narrator": "エリカ", "text": "うん。\nありがとう……。"},
        { "location": "310/TALK"  , "narrator": "エリカ", "text": "わたし、\nいつも役に立たなくて\nごめんね？"},
        { "location": "311/SEL"   , "narrator": "", "text": "これは事故だよ。\nもっと自信持って！"},
        { "location": "312/SEL"   , "narrator": "", "text": "エリカはいつも頑張ってるよ"},
        { "location": "313/ACT"   , "narrator": "", "text": "これは事故だよ。\nもっと自信持って！"},
        { "location": "314/TALK"  , "narrator": "エリカ", "text": "う、うん。\nそうだよね。"},
        { "location": "315/TALK"  , "narrator": "エリカ", "text": "わたしが\n頑張らなくちゃ……"},
        { "location": "316/TALK"  , "narrator": "エリカ", "text": "わたしが……"},
        { "location": "317/ACT"   , "narrator": "", "text": "エリカはいつも頑張ってるよ"},
        { "location": "318/TALK"  , "narrator": "エリカ", "text": "……えへへ。\n嬉しい。"},
        { "location": "319/TALK"  , "narrator": "エリカ", "text": "そう言ってくれる人が\nいるって、いいね。"},
        { "location": "321/ACT"   , "narrator": "", "text": "エリカって結構抜けてるところあるよね…"},
        { "location": "323/TALK"  , "narrator": "エリカ", "text": "えへへ……\nそうだよね。"},
        { "location": "324/TALK"  , "narrator": "エリカ", "text": "ごめんね。わたしのせいで\nあなたにいっぱい迷惑\nかけちゃってるよね。"},
        { "location": "325/TALK"  , "narrator": "エリカ", "text": "もっと\n頑張るからね？"},
        { "location": "326/ACT"   , "narrator": "", "text": "わからないとか言ってるけど、本当は確信犯なんじゃないの？"},
        { "location": "328/TALK"  , "narrator": "エリカ", "text": "そんなことないよ！！"},
        { "location": "329/TALK"  , "narrator": "エリカ", "text": "どうしてわたしが\nそんなことをしなくちゃ\nいけないの！？"},
        { "location": "330/TALK"  , "narrator": "エリカ", "text": "どうして！？"},
        { "location": "331/SEL"   , "narrator": "", "text": "落ち着いて！！"},
        { "location": "332/ACT"   , "narrator": "", "text": "落ち着いて！！"},
        { "location": "334/TALK"  , "narrator": "エリカ", "text": "あっ……"},
        { "location": "335/TALK"  , "narrator": "エリカ", "text": "ご、ごめんなさい。"},
        { "location": "336/TALK"  , "narrator": "エリカ", "text": "そうだよね。\nあなたから見たら、\nそんなの解らないものね。"},
        { "location": "337/TALK"  , "narrator": "エリカ", "text": "うん。"},
