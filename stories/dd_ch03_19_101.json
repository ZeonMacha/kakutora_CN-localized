    "type": "MainStory",
    "info": {
        "story_id": "19302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "気にしすぎの戦＜前編＞"
    },
    "entry":
    [
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "ギャヴィ、二人の\n様子はどう？"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "狙撃から隠れようと\nしてるみたい。"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "でも、なってないわ。\nここからなら問題なく\n当てられるし。"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "はぁ…、やっぱり\nまだ経験が浅いわね。"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "どうする？\nもう撃って終わらせ\nちゃう？"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "今はいいわ。\nどう動くのか、\nちょっと興味あるし。"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "ふふっ、そうね…。"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "模擬戦とはいえ、\nアーヤと二人だけで\nコンビ組むなんて。"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "入隊した最初の頃\nみたい。"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "みやびやつばめ達が\n入ってからは\n減っちゃったもの。"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "久しぶりで\nなんかちょっと\nうれしい…。"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "あっ、動いた！\nギャヴィ！"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "…え？"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "牽制射撃！\nぼーっとしてないで！"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "あ、ご、ごめん！"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと、あんた達！\nふざけてるんじゃ\nないでしょうね！？"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "ま、真面目だよ！\n訓練だもん、\nふざけてやらないよ。"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "だったら、どうして\n一回もあたし達に\n勝てないのよ？"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "ガブちゃん達が\n強過ぎるんだよぉ…。"},
        { "location": "95/TALK"   , "narrator": "神楽", "text": "そうです。\nっていうか、\n狙撃はズルですよ！"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "ズルくないわよ。\nこれがあたしの\nスタイルなんだから。"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "そうね。\nそれに、つばめ。"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "実践では相手の\n攻撃方法は\n不明な時がある。"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "だけど、ギャヴィは\n撃ってくるって、\nわかってるでしょ？"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "情報は有効活用する。\nそれも訓練のうちよ。"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "そういうことよ。"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "…有効活用って、\n例えばどんなの\nですか？"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "弾丸が自分に向かって\n飛んでくるのは\nわかってるでしょ。"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "飛んできたところを\n弾き返す！"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "！？"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "…あ、あの…わたし\n素手なんですけど…。"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "じゃあ、ギリギリで\n避けながら距離を\n詰めるとかかしら？"},
        { "location": "115/TALK"  , "narrator": "神楽", "text": "…もう、人間技じゃ\nない気がします。"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "コネクトした状態なら\nできなくないわよ。"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "ガブちゃんも、\nそんなことできるの？"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "あたしだったら\n避けないで撃ち落とす\nけどね。"},
        { "location": "121/TALK"  , "narrator": "神楽", "text": "…歴戦の勇士感が\n凄いですね…。"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "…それ、年寄扱い\nされてるみたいで\n嫌なんだけど？"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "とりあえず、\n今日はこれくらいに\nしましょ。"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "えっ、いいんですか？\nまだこんなに早い\n時間なのに…。"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "館長からそうする\nように言われてるの。"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "だから、今日の訓練は\nここまで。\nあとは自由時間よ。"},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "やったー！"},
        { "location": "129/TALK"  , "narrator": "つばめ", "text": "それじゃ、\nひなこちゃん達と\n遊びに行こうかな？"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "あら？　向こうも\n今日はお休みなの？"},
        { "location": "131/TALK"  , "narrator": "神楽", "text": "そうみたいです。"},
        { "location": "132/TALK"  , "narrator": "神楽", "text": "だから、訓練が早めに\n終わったら遊びに行こう\nって話してたんです。"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "日向さん達って、\n確か合宿の前半に\n帰るんだったかしら？"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "そうなんです。"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "ガブちゃんもどう？\n一緒に遊び行こうよ。"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "パスするわ。\nのんびり体を\n休めたいし。"},
        { "location": "139/TALK"  , "narrator": "つばめ", "text": "そっか…。\nそれじゃ、わたし達は\nこれで。"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "お疲れさま。\n楽しんできてね。"},
        { "location": "144/TALK"  , "narrator": "神楽", "text": "お疲れさまでした。"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "…さてと。\n帰る前に片づけを\nしないと…。"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "手伝う？"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "すぐ終わるから\nいいわよ。"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "あっそ…。"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "…そういえばさ、\n明日の訓練も模擬戦\nやるんだっけ？"},
        { "location": "161/TALK"  , "narrator": "アーヤ", "text": "ええ、予定では\nそうなってるわ。"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "そっか…。"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "じゃあ、明日も\n一緒に組めるのね。"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "つばめ達を\n教育してあげないと\nいけなしね。"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "そうね…。\nもうちょっと、\n形にしたいし…。"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "ふふっ、楽しみね。"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "ん？　そうね。"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "…ん？　何？"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "…別に。"},
        { "location": "174/TALK"  , "narrator": "アーヤ", "text": "？　ならいいけど…。"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "まったくダメよね？"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "アーヤは"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "だけで済ませるんだもの"},
        { "location": "194/SEL"   , "narrator": "", "text": "何かお怒りで？"},
        { "location": "195/ACT"   , "narrator": "", "text": "何かお怒りで？"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "呆れてるだけ"},
        { "location": "198/TALK"  , "narrator": "ガブリエラ", "text": "怒ってはいないから"},
        { "location": "201/TALK"  , "narrator": "ガブリエラ", "text": "せっかく模擬戦で"},
        { "location": "202/TALK"  , "narrator": "ガブリエラ", "text": "久しぶりに"},
        { "location": "203/TALK"  , "narrator": "ガブリエラ", "text": "コンビを組んで戦ったのよ？"},
        { "location": "204/TALK"  , "narrator": "ガブリエラ", "text": "しかも"},
        { "location": "206/TALK"  , "narrator": "ガブリエラ", "text": "息ぴったりで"},
        { "location": "207/TALK"  , "narrator": "ガブリエラ", "text": "明日も"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "またコンビ組んで戦えるのに"},
        { "location": "209/TALK"  , "narrator": "ガブリエラ", "text": "あんまり喜んでくれないんだもの"},
        { "location": "210/TALK"  , "narrator": "ガブリエラ", "text": "面白くないわ"},
        { "location": "212/SEL"   , "narrator": "", "text": "アーヤは鈍感だから"},
        { "location": "213/ACT"   , "narrator": "", "text": "アーヤは鈍感だから"},
        { "location": "215/TALK"  , "narrator": "ガブリエラ", "text": "それはわかってるわよ"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "素っ気なさ過ぎると思うわ"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "もう少し喜んでくれてもいいはずなのに"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "なんか"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "テンション下がるわ"},
        { "location": "286/TALK"  , "narrator": "ガブリエラ", "text": "　"},
        { "location": "300/TALK"  , "narrator": "ガブリエラ", "text": "あ、$handle$！\nいらっしゃい！"},
        { "location": "301/SEL"   , "narrator": "", "text": "！？"},
        { "location": "302/ACT"   , "narrator": "", "text": "！？"},
        { "location": "304/TALK"  , "narrator": "ガブリエラ", "text": "今日も張り切って\n悩みを解決\nしちゃいましょ！"},
        { "location": "305/SEL"   , "narrator": "", "text": "な、なんかやばいことになってない！？"},
        { "location": "306/ACT"   , "narrator": "", "text": "な、なんかやばいことになってない！？"},
        { "location": "308/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？\nそれってもしかして……"},
        { "location": "309/TALK"  , "narrator": "ガブリエラ", "text": "この水着のこと！？"},
        { "location": "310/TALK"  , "narrator": "ガブリエラ", "text": "やっぱりちょっと\n子供っぽすぎるかしら……\nしょんぼり。"},
        { "location": "311/SEL"   , "narrator": "", "text": "いや、そうじゃなくてこの場所が"},
        { "location": "312/SEL"   , "narrator": "", "text": "確かにそれもやばい"},
        { "location": "313/SEL"   , "narrator": "", "text": "それはむしろ大歓迎"},
        { "location": "314/ACT"   , "narrator": "", "text": "いや、そうじゃなくてこの場所が"},
        { "location": "315/TALK"  , "narrator": "ガブリエラ", "text": "場所？"},
        { "location": "317/TALK"  , "narrator": "ガブリエラ", "text": "…？"},
        { "location": "319/TALK"  , "narrator": "ガブリエラ", "text": "……？"},
        { "location": "321/TALK"  , "narrator": "ガブリエラ", "text": "全然\n意味分からないんだけど。"},
        { "location": "322/ACT"   , "narrator": "", "text": "確かにそれもやばい"},
        { "location": "324/TALK"  , "narrator": "ガブリエラ", "text": "…！？！？"},
        { "location": "325/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、ちょっと？\nヤバイって\nどういうことかしら？"},
        { "location": "326/TALK"  , "narrator": "ガブリエラ", "text": "別にあたしはあんたに\n楽しんでもらう為に水着を\n選んでるんじゃないの。"},
        { "location": "327/TALK"  , "narrator": "ガブリエラ", "text": "そこんところ\n勘違いしないでよね！"},
        { "location": "328/TALK"  , "narrator": "ガブリエラ", "text": "思った通りだったわ…\nショック……。"},
        { "location": "329/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり思い切って\nビキニにするべき\nだったのよね……はぁ…"},
        { "location": "330/ACT"   , "narrator": "", "text": "それはむしろ大歓迎"},
        { "location": "332/TALK"  , "narrator": "ガブリエラ", "text": "え？\nそ、そうなの？"},
        { "location": "333/TALK"  , "narrator": "ガブリエラ", "text": "ていうか、大歓迎って\nどういうことかしら？\nちょっと引くわ……。"},
        { "location": "334/TALK"  , "narrator": "ガブリエラ", "text": "なんて…。"},
        { "location": "335/TALK"  , "narrator": "ガブリエラ", "text": "子供っぽいかしらと思って\n悩んだけど、これにして\nよかった♪"},
        { "location": "337/TALK"  , "narrator": "ガブリエラ", "text": "というわけで\n気を取り直して\n扉を回すわね。"},
        { "location": "338/SEL"   , "narrator": "", "text": "はい"},
        { "location": "339/SEL"   , "narrator": "", "text": "いやだから、すごくヤバそうなんだけど！"},
        { "location": "340/ACT"   , "narrator": "", "text": "はい"},
        { "location": "341/ACT"   , "narrator": "", "text": "いやだから、すごくヤバそうなんだけど！"},
        { "location": "342/TALK"  , "narrator": "ガブリエラ", "text": "何も違わないわよ！\nさっきから\nどうしちゃったの？"},
        { "location": "343/SEL"   , "narrator": "", "text": "周り怖すぎるんですけど"},
        { "location": "344/ACT"   , "narrator": "", "text": "周り怖すぎるんですけど"},
        { "location": "346/TALK"  , "narrator": "ガブリエラ", "text": "だから、\n何も変わってないってば。"},
        { "location": "347/TALK"  , "narrator": "ガブリエラ", "text": "$handle$だけ\n見てる世界が\n違うんじゃないの？"},
        { "location": "348/SEL"   , "narrator": "", "text": "いや、でも……"},
        { "location": "349/ACT"   , "narrator": "", "text": "いや、でも……"},
        { "location": "351/TALK"  , "narrator": "ガブリエラ", "text": "もうそういうのいいから。\nあたしアーヤと違って\n怖がりじゃないし。"},
        { "location": "353/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、いくわよ？"},
        { "location": "360/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x444番地から\n0x39A番地へ。"},
        { "location": "381/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了っ♪"},
        { "location": "386/TALK"  , "narrator": "ガブリエラ", "text": "で、今回は……と。"},
        { "location": "387/TALK"  , "narrator": "ガブリエラ", "text": "ああ、またアーヤの\nことなのね。"},
        { "location": "388/TALK"  , "narrator": "ガブリエラ", "text": "あたしってば、\nどうしてそんなにアーヤが\n好きなのかしらね。"},
        { "location": "389/SEL"   , "narrator": "", "text": "司書はどうしてそんなにアーヤに対して淡泊なの？"},
        { "location": "390/ACT"   , "narrator": "", "text": "司書はどうしてそんなにアーヤに対して淡泊なの？"},
        { "location": "392/TALK"  , "narrator": "ガブリエラ", "text": "野暮なこと聞くのね。"},
        { "location": "393/TALK"  , "narrator": "ガブリエラ", "text": "全てのあたしが\nアーヤのこと好きだったら\n大変なことになるわよ？"},
        { "location": "394/TALK"  , "narrator": "ガブリエラ", "text": "もしかすると、\n今頃アーヤのこと襲ってる\nかもしれないわね。"},
        { "location": "395/TALK"  , "narrator": "ガブリエラ", "text": "人はいろんな人格がいて、\nそれぞれが牽制しあって\nバランスを保ってる。"},
        { "location": "396/TALK"  , "narrator": "ガブリエラ", "text": "あたしみたいなアーヤ\n懐疑派がいるからこそ、\nバランスが保ててる。"},
        { "location": "397/TALK"  , "narrator": "ガブリエラ", "text": "対してつばめには、もっと\n積極的にアプローチしても\nいいかと思ってるけど！"},
        { "location": "398/SEL"   , "narrator": "", "text": "なるほど納得"},
        { "location": "399/SEL"   , "narrator": "", "text": "つばめは襲わないの？"},
        { "location": "400/ACT"   , "narrator": "", "text": "なるほど納得"},
        { "location": "401/TALK"  , "narrator": "ガブリエラ", "text": "そう、よかったわ。"},
        { "location": "402/ACT"   , "narrator": "", "text": "つばめは襲わないの？"},
        { "location": "404/TALK"  , "narrator": "ガブリエラ", "text": "つばめは襲うっていうより\n襲われたい方かしらね。"},
        { "location": "405/TALK"  , "narrator": "ガブリエラ", "text": "なんか考えるだけで\nゾクゾクしちゃう。"},
        { "location": "406/TALK"  , "narrator": "ガブリエラ", "text": "けど、真面目な話をすると\n多分そういうのってもっと\n深い所に何かあるのよね。"},
        { "location": "407/TALK"  , "narrator": "ガブリエラ", "text": "あたしには\nそれが何なのかは\nわからないけど。"},
        { "location": "409/TALK"  , "narrator": "ガブリエラ", "text": "まあ、何にしても\nアーヤについては最近、\n懐疑派が力をつけてる。"},
        { "location": "410/SEL"   , "narrator": "", "text": "そうなの！？"},
        { "location": "411/ACT"   , "narrator": "", "text": "そうなの！？"},
        { "location": "413/TALK"  , "narrator": "ガブリエラ", "text": "ええ。"},
        { "location": "414/TALK"  , "narrator": "ガブリエラ", "text": "あ、でも全然\n心配しなくても大丈夫よ？"},
        { "location": "415/TALK"  , "narrator": "ガブリエラ", "text": "ココロの中ではそんなこと\n日常茶飯事だし。"},
        { "location": "416/TALK"  , "narrator": "ガブリエラ", "text": "１日のうちでも\nめまぐるしく変わることも\nあるもの。"},
        { "location": "417/TALK"  , "narrator": "ガブリエラ", "text": "ただ、今回はちょっと\n大きめね。"},
        { "location": "418/TALK"  , "narrator": "ガブリエラ", "text": "このままアーヤがずっと\n淡泊なまんまだと、総意の\n傾向が変わってくるかも。"},
        { "location": "419/TALK"  , "narrator": "ガブリエラ", "text": "あたしは正直どうでも\nいいけど、総意はそれを\n望んでないから――"},
        { "location": "420/TALK"  , "narrator": "ガブリエラ", "text": "とりあえず応急措置として\n不満を持っているクランを\n倒してもらえるかしらね。"},
        { "location": "421/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "422/SEL"   , "narrator": "", "text": "司書ガブリエラもここから避難した方がいいよ"},
        { "location": "423/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "424/ACT"   , "narrator": "", "text": "司書ガブリエラもここから避難した方がいいよ"},
        { "location": "425/TALK"  , "narrator": "ガブリエラ", "text": "だからなんで？\nそんな必要ないから。"},
        { "location": "426/SEL"   , "narrator": "", "text": "本当にわからないの？"},
        { "location": "427/ACT"   , "narrator": "", "text": "本当にわからないの？"},
        { "location": "429/TALK"  , "narrator": "ガブリエラ", "text": "わからないわよ！\nもういいでしょ？"},
        { "location": "430/SEL"   , "narrator": "", "text": "ちゃんと調べた方がいいよ？"},
        { "location": "431/ACT"   , "narrator": "", "text": "ちゃんと調べた方がいいよ？"},
        { "location": "433/TALK"  , "narrator": "ガブリエラ", "text": "はいはい、\nわかったわかった。"},
        { "location": "434/TALK"  , "narrator": "ガブリエラ", "text": "あんたがクランを\n何とかしてくれてる間に\n調べておくから。"},
        { "location": "436/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ今回も\n張り切って行くわよ！"},
        { "location": "437/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！"},
        { "location": "28/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月18日　 2:36 PM</color>\n合宿二日目、午後の訓練でのこと"},
        { "location": "251/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "253/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "255/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "257/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "259/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
