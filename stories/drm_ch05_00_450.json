    "entry":
    [
        { "location": "2690/SCENARIO", "narrator": "", "text": "ギフテッド"},
        { "location": "2715/TALK"    , "narrator": "神楽", "text": "天賦の才"},
        { "location": "2716/TALK"    , "narrator": "神楽", "text": "特別な才能なんて"},
        { "location": "2717/TALK"    , "narrator": "神楽", "text": "生まれた時に決まってて"},
        { "location": "2718/TALK"    , "narrator": "神楽", "text": "ううん"},
        { "location": "2719/TALK"    , "narrator": "神楽", "text": "生まれる前に決まってて"},
        { "location": "2720/TALK"    , "narrator": "神楽", "text": "この世界で天賦の才を持っているのは"},
        { "location": "2721/TALK"    , "narrator": "神楽", "text": "きっとつばめさんだけ"},
        { "location": "2723/SEL"     , "narrator": "", "text": "まさかそんな"},
        { "location": "2724/SEL"     , "narrator": "", "text": "フレイメノウは才能でしょ"},
        { "location": "2725/SEL"     , "narrator": "", "text": "神楽に$me$がメロメロなのも才能"},
        { "location": "2726/ACT"     , "narrator": "", "text": "まさかそんな"},
        { "location": "2727/TALK"    , "narrator": "神楽", "text": "実際そうでしょ"},
        { "location": "2728/ACT"     , "narrator": "", "text": "フレイメノウは才能でしょ"},
        { "location": "2729/TALK"    , "narrator": "神楽", "text": "あれは努力と運"},
        { "location": "2730/ACT"     , "narrator": "", "text": "神楽に$me$がメロメロなのも才能"},
        { "location": "2731/TALK"    , "narrator": "神楽", "text": "騙されちゃう$handle$はかわいいひと"},
        { "location": "2732/TALK"    , "narrator": "神楽", "text": "だいすきよ"},
        { "location": "2734/TALK"    , "narrator": "神楽", "text": "この世界を作ったのはつばめさん"},
        { "location": "2735/TALK"    , "narrator": "神楽", "text": "そんなことができる人間なんて他にいない"},
        { "location": "2736/TALK"    , "narrator": "神楽", "text": "そういう意味ではまさに選ばれた人間"},
        { "location": "2738/SEL"     , "narrator": "", "text": "だったらやっぱり神楽が最強"},
        { "location": "2739/SEL"     , "narrator": "", "text": "そういうことになるのかなー…"},
        { "location": "2740/SEL"     , "narrator": "", "text": "特殊事例すぎない？"},
        { "location": "2741/ACT"     , "narrator": "", "text": "だったらやっぱり神楽が最強"},
        { "location": "2742/TALK"    , "narrator": "神楽", "text": "そうなるの？"},
        { "location": "2743/TALK"    , "narrator": "神楽", "text": "うーん、、、"},
        { "location": "2744/ACT"     , "narrator": "", "text": "そういうことになるのかなー…"},
        { "location": "2745/TALK"    , "narrator": "神楽", "text": "そうじゃない？"},
        { "location": "2746/TALK"    , "narrator": "神楽", "text": "どうかな？"},
        { "location": "2747/ACT"     , "narrator": "", "text": "特殊事例すぎない？"},
        { "location": "2748/TALK"    , "narrator": "神楽", "text": "それは当たり前"},
        { "location": "2749/TALK"    , "narrator": "神楽", "text": "選ばれた時点で特殊なんだぴょん"},
        { "location": "2751/TALK"    , "narrator": "神楽", "text": "どうあがいても、どうにもならないことってあるよね"},
        { "location": "2752/TALK"    , "narrator": "神楽", "text": "あなたが隣にいてくれないこととか"},
        { "location": "2753/SEL"     , "narrator": "", "text": "それ$me$も同じだしキッツイからやめて"},
        { "location": "2754/TALK"    , "narrator": "神楽", "text": "でもあの子はやれてしまうと思う"},
        { "location": "2755/TALK"    , "narrator": "神楽", "text": "そこには月とすっぽんほどの差がある"},
        { "location": "2758/ACT"     , "narrator": "", "text": "それ$me$も同じだしキッツイからやめて"},
        { "location": "2759/TALK"    , "narrator": "神楽", "text": "じゃあおんなじ"},
        { "location": "2760/TALK"    , "narrator": "神楽", "text": "私はそういうのをうやむやにしたくない"},
        { "location": "2761/TALK"    , "narrator": "神楽", "text": "だから敢えて言う"},
        { "location": "2762/TALK"    , "narrator": "神楽", "text": "少なくとも今は逢えないし、今後もその見込みは立ってない"},
        { "location": "2763/TALK"    , "narrator": "神楽", "text": "それは事実"},
        { "location": "2764/TALK"    , "narrator": "神楽", "text": "それをうやむやにしたら、私が貴方をこんなにも"},
        { "location": "2765/TALK"    , "narrator": "神楽", "text": "息が詰まるほどに切ないこの気持ちもまた全部、うやむやにしなければならなくなる"},
        { "location": "2767/SEL"     , "narrator": "", "text": "神楽のそういうところ好きだよ"},
        { "location": "2768/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "2769/SEL"     , "narrator": "", "text": "面倒くさいなぁ"},
        { "location": "2770/ACT"     , "narrator": "", "text": "神楽のそういうところ好きだよ"},
        { "location": "2771/TALK"    , "narrator": "神楽", "text": "私はそんなに好きじゃないかな"},
        { "location": "2772/TALK"    , "narrator": "神楽", "text": "もっとなーなーに生きたい"},
        { "location": "2773/TALK"    , "narrator": "神楽", "text": "できるならね"},
        { "location": "2774/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "2775/ACT"     , "narrator": "", "text": "面倒くさいなぁ"},
        { "location": "2776/TALK"    , "narrator": "神楽", "text": "じゃあ別れよっか"},
        { "location": "2777/TALK"    , "narrator": "神楽", "text": "なんて"},
        { "location": "2779/TALK"    , "narrator": "神楽", "text": "$handle$のそういう歯に衣着せぬところ好き"},
        { "location": "2780/TALK"    , "narrator": "神楽", "text": "だって、表裏無いってことじゃない？"},
        { "location": "2782/TALK"    , "narrator": "神楽", "text": "裏を考えなくていいから気が楽"},
        { "location": "2787/TALK"    , "narrator": "神楽", "text": "それでね、"},
        { "location": "2788/TALK"    , "narrator": "神楽", "text": "あれから色々考えた"},
        { "location": "2790/SEL"     , "narrator": "", "text": "あれからって？"},
        { "location": "2791/SEL"     , "narrator": "", "text": "もう死ぬなんて言わないで"},
        { "location": "2792/ACT"     , "narrator": "", "text": "あれからって？"},
        { "location": "2793/TALK"    , "narrator": "神楽", "text": "前に送ったボイメから"},
        { "location": "2794/ACT"     , "narrator": "", "text": "もう死ぬなんて言わないで"},
        { "location": "2797/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "2799/TALK"    , "narrator": "神楽", "text": "ぴょんこは端から見ると、すごく不幸な境遇かもしれない"},
        { "location": "2800/TALK"    , "narrator": "神楽", "text": "でも、別の人が見たら、恵まれてるって思うかも"},
        { "location": "2801/TALK"    , "narrator": "神楽", "text": "すごく極端な気がするぴょん"},
        { "location": "2802/TALK"    , "narrator": "神楽", "text": "ぴょんこがつばめさんと同じ魔法の力を持っていたら"},
        { "location": "2803/TALK"    , "narrator": "神楽", "text": "ぴょんこはもっと幸せになるかもしれないし、破滅を呼び込むかもしれない"},
        { "location": "2804/TALK"    , "narrator": "神楽", "text": "だから、結局の所、今の自分が一番なんだって思った"},
        { "location": "2805/TALK"    , "narrator": "神楽", "text": "そう考えるとね"},
        { "location": "2806/TALK"    , "narrator": "神楽", "text": "$handle$が一緒にいてくれることも"},
        { "location": "2807/TALK"    , "narrator": "神楽", "text": "$handle$に逢えないことも"},
        { "location": "2808/TALK"    , "narrator": "神楽", "text": "凄く幸せなことなんじゃないかな"},
        { "location": "2810/SEL"     , "narrator": "", "text": "逢えないのに？"},
        { "location": "2811/SEL"     , "narrator": "", "text": "なんかわかる"},
        { "location": "2812/ACT"     , "narrator": "", "text": "逢えないのに？"},
        { "location": "2813/TALK"    , "narrator": "神楽", "text": "逢えないから、じゃなくて"},
        { "location": "2814/TALK"    , "narrator": "神楽", "text": "逢えないことが、結果的に幸せに繋がってるって考え方もあるかなってこと"},
        { "location": "2815/ACT"     , "narrator": "", "text": "なんかわかる"},
        { "location": "2816/TALK"    , "narrator": "神楽", "text": "ふふふー、ほんとー？"},
        { "location": "2818/TALK"    , "narrator": "神楽", "text": "世の中には、いつも一緒にいても不幸な二人っている"},
        { "location": "2819/TALK"    , "narrator": "神楽", "text": "逢えない私たちは、共に逢いたいって気持ちでお互いを支え合って"},
        { "location": "2820/TALK"    , "narrator": "神楽", "text": "逢えない分だけ、いっぱい、いっぱい、めいっっっっぱい、愛を囁き合う"},
        { "location": "2821/TALK"    , "narrator": "神楽", "text": "いつか逢える日を目指して、頑張って生きていく"},
        { "location": "2822/TALK"    , "narrator": "神楽", "text": "そばにいなくても、ぴょんこは、計る術も無い程に大きくて強くて、暖かい愛に包まれてる"},
        { "location": "2825/TALK"    , "narrator": "神楽", "text": "ねえ、$handle$"},
        { "location": "2826/TALK"    , "narrator": "神楽", "text": "私ボイメで、ぜんぶ気持ち伝えたよ"},
        { "location": "2827/TALK"    , "narrator": "神楽", "text": "あなたの気持ちも教えて"},
        { "location": "2828/TALK"    , "narrator": "神楽", "text": "あなたはどう思ってるの？"},
        { "location": "2829/TALK"    , "narrator": "神楽", "text": "あ待って"},
        { "location": "2832/TALK"    , "narrator": "神楽", "text": "すごくずるいかもしれないけど"},
        { "location": "2833/TALK"    , "narrator": "神楽", "text": "でも、もしできれば"},
        { "location": "2834/TALK"    , "narrator": "神楽", "text": "今回だけは"},
        { "location": "2835/TALK"    , "narrator": "神楽", "text": "イイぶぶんだけ言って"},
        { "location": "2836/TALK"    , "narrator": "神楽", "text": "$handle$がぴょんこ大好きなのはホントだと思いたいけど、きっと不満もあると思うけど"},
        { "location": "2838/TALK"    , "narrator": "神楽", "text": "今はちょっと、不満とか言われちゃったら"},
        { "location": "2839/TALK"    , "narrator": "神楽", "text": "多分泣く"},
        { "location": "2840/TALK"    , "narrator": "神楽", "text": "だからごめんね、ずるいけど"},
        { "location": "2841/TALK"    , "narrator": "神楽", "text": "私"},
        { "location": "2843/TALK"    , "narrator": "神楽", "text": "貴方の好きで一杯になりたくて"},
        { "location": "2844/TALK"    , "narrator": "神楽", "text": "今わたしたちにできること"},
        { "location": "2845/TALK"    , "narrator": "神楽", "text": "あなたの言葉でぎゅって、抱きしめられたくて"},
        { "location": "2847/SEL"     , "narrator": "", "text": "神楽"},
        { "location": "2848/ACT"     , "narrator": "", "text": "神楽"},
        { "location": "2850/TALK"    , "narrator": "神楽", "text": "ん"},
        { "location": "2852/SEL"     , "narrator": "", "text": "$me$は神楽が大好きなんだ"},
        { "location": "2853/SEL"     , "narrator": "", "text": "$me$は神楽が作る世界が大好きなんだよ"},
        { "location": "2854/ACT"     , "narrator": "", "text": "$me$は神楽が大好きなんだ"},
        { "location": "2855/TALK"    , "narrator": "神楽", "text": "ん"},
        { "location": "2857/SEL"     , "narrator": "", "text": "神楽の全部がすき"},
        { "location": "2858/ACT"     , "narrator": "", "text": "神楽の全部がすき"},
        { "location": "2860/TALK"    , "narrator": "神楽", "text": "ん"},
        { "location": "2862/SEL"     , "narrator": "", "text": "何が欠けても、何が追加されても、それは$me$の神楽じゃない"},
        { "location": "2863/ACT"     , "narrator": "", "text": "何が欠けても、何が追加されても、それは$me$の神楽じゃない"},
        { "location": "2865/TALK"    , "narrator": "神楽", "text": "ん"},
        { "location": "2866/ACT"     , "narrator": "", "text": "$me$は神楽が作る世界が大好きなんだよ"},
        { "location": "2867/TALK"    , "narrator": "神楽", "text": "ん"},
        { "location": "2869/SEL"     , "narrator": "", "text": "それは$me$にとっては、つばめの世界よりもずっと素敵で、ずっといたい場所"},
        { "location": "2870/SEL"     , "narrator": "", "text": "同じ天賦の才なら、$me$は神楽の天賦の才がすき"},
        { "location": "2871/ACT"     , "narrator": "", "text": "それは$me$にとっては、つばめの世界よりもずっと素敵で、ずっといたい場所"},
        { "location": "2872/TALK"    , "narrator": "神楽", "text": "ん"},
        { "location": "2873/ACT"     , "narrator": "", "text": "同じ天賦の才なら、$me$は神楽の天賦の才がすき"},
        { "location": "2874/TALK"    , "narrator": "神楽", "text": "ん"},
        { "location": "2879/SEL"     , "narrator": "", "text": "だから"},
        { "location": "2880/ACT"     , "narrator": "", "text": "だから"},
        { "location": "2883/SEL"     , "narrator": "", "text": "泣かないで、$me$の姫"},
        { "location": "2884/SEL"     , "narrator": "", "text": "$me$は、活き活きと頑張って生きてる神楽の全てを愛してる"},
        { "location": "2885/ACT"     , "narrator": "", "text": "泣かないで、$me$の姫"},
        { "location": "2886/TALK"    , "narrator": "神楽", "text": "ん"},
        { "location": "2888/SEL"     , "narrator": "", "text": "$me$は姫の作り出すものは、全部好き"},
        { "location": "2889/ACT"     , "narrator": "", "text": "$me$は姫の作り出すものは、全部好き"},
        { "location": "2891/TALK"    , "narrator": "神楽", "text": "ん"},
        { "location": "2892/SEL"     , "narrator": "", "text": "それは創作だけじゃなくて、姫の仕草や笑顔や、怒った顔も全部好き"},
        { "location": "2893/ACT"     , "narrator": "", "text": "それは創作だけじゃなくて、姫の仕草や笑顔や、怒った顔も全部好き"},
        { "location": "2895/TALK"    , "narrator": "神楽", "text": "ん"},
        { "location": "2897/SEL"     , "narrator": "", "text": "姫が創り出す、そういった全てのものが、$me$にとっては大事なものだから"},
        { "location": "2898/ACT"     , "narrator": "", "text": "姫が創り出す、そういった全てのものが、$me$にとっては大事なものだから"},
        { "location": "2900/ACT"     , "narrator": "", "text": "$me$は、活き活きと頑張って生きてる神楽の全てを愛してる"},
        { "location": "2901/TALK"    , "narrator": "神楽", "text": "ん"},
        { "location": "2903/SEL"     , "narrator": "", "text": "その想いも、作り出すものも、考え方も、ちょっと小悪魔なところも"},
        { "location": "2904/ACT"     , "narrator": "", "text": "その想いも、作り出すものも、考え方も、ちょっと小悪魔なところも"},
        { "location": "2906/TALK"    , "narrator": "神楽", "text": "ん"},
        { "location": "2908/SEL"     , "narrator": "", "text": "美しい金色の髪も、抱きしめたら壊れてしまいそうなその身体も"},
        { "location": "2909/ACT"     , "narrator": "", "text": "美しい金色の髪も、抱きしめたら壊れてしまいそうなその身体も"},
        { "location": "2911/TALK"    , "narrator": "神楽", "text": "ん"},
        { "location": "2913/SEL"     , "narrator": "", "text": "透き通った海のような瞳も、全て愛してる"},
        { "location": "2914/ACT"     , "narrator": "", "text": "透き通った海のような瞳も、全て愛してる"},
        { "location": "2917/TALK"    , "narrator": "神楽", "text": "ぜんぶなの？"},
        { "location": "2919/SEL"     , "narrator": "", "text": "全部だよ、良いところもダメなところも全部"},
        { "location": "2920/SEL"     , "narrator": "", "text": "一つでも欠けたら、神楽にならないよ"},
        { "location": "2921/ACT"     , "narrator": "", "text": "全部だよ、良いところもダメなところも全部"},
        { "location": "2922/ACT"     , "narrator": "", "text": "一つでも欠けたら、神楽にならないよ"},
        { "location": "2924/TALK"    , "narrator": "神楽", "text": "それは"},
        { "location": "2925/TALK"    , "narrator": "神楽", "text": "フォビアも？"},
        { "location": "2927/SEL"     , "narrator": "", "text": "当たり前"},
        { "location": "2928/SEL"     , "narrator": "", "text": "全部って言ったら、そういうことになるね"},
        { "location": "2929/ACT"     , "narrator": "", "text": "当たり前"},
        { "location": "2930/ACT"     , "narrator": "", "text": "全部って言ったら、そういうことになるね"},
        { "location": "2932/TALK"    , "narrator": "神楽", "text": "そっか"},
        { "location": "2934/SEL"     , "narrator": "", "text": "神楽にとっては、イシュフォビアはダメなの？"},
        { "location": "2935/ACT"     , "narrator": "", "text": "神楽にとっては、イシュフォビアはダメなの？"},
        { "location": "2937/TALK"    , "narrator": "神楽", "text": "あの子は"},
        { "location": "2938/TALK"    , "narrator": "神楽", "text": "私の"},
        { "location": "2946/SEL"     , "narrator": "", "text": "神楽？"},
        { "location": "2947/ACT"     , "narrator": "", "text": "神楽？"},
        { "location": "2949/TALK"    , "narrator": "神楽", "text": "あのね"},
        { "location": "2950/TALK"    , "narrator": "神楽", "text": "ちょっと降りてきたの"},
        { "location": "2952/SEL"     , "narrator": "", "text": "何が？"},
        { "location": "2953/ACT"     , "narrator": "", "text": "何が？"},
        { "location": "2955/TALK"    , "narrator": "神楽", "text": "少しだけ寂しくて、でも心地よくて透き通った、世界が"},
        { "location": "2956/TALK"    , "narrator": "神楽", "text": "よかったら、聞いていって"},
        { "location": "2960/TALK"    , "narrator": "ボイスメール", "text": "傘と天気雨"},
        { "location": "2972/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【傘と天気雨】</color>\nをゲットしました！"}
    ]
}
