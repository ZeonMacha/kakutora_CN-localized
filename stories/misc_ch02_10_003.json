    "entry":
    [
        { "location": "156/SCENARIO", "narrator": "", "text": "00-00_半幅帯結び"},
        { "location": "181/TALK"    , "narrator": "アーヤ", "text": "袴は履き慣れてるからいいんだけど"},
        { "location": "182/TALK"    , "narrator": "アーヤ", "text": "帯結びがちょっと自信ないのよね"},
        { "location": "183/TALK"    , "narrator": "アーヤ", "text": "練習しなきゃだわ"},
        { "location": "185/SEL"     , "narrator": "", "text": "巫女装束萌えー"},
        { "location": "186/SEL"     , "narrator": "", "text": "剣道またするの"},
        { "location": "187/SEL"     , "narrator": "", "text": "わかった、浴衣だ"},
        { "location": "188/ACT"     , "narrator": "", "text": "巫女装束萌えー"},
        { "location": "189/TALK"    , "narrator": "アーヤ", "text": "いやいや(-ω-;)"},
        { "location": "190/TALK"    , "narrator": "アーヤ", "text": "違うから"},
        { "location": "191/ACT"     , "narrator": "", "text": "剣道またするの"},
        { "location": "192/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "193/TALK"    , "narrator": "アーヤ", "text": "そうじゃなくて"},
        { "location": "194/ACT"     , "narrator": "", "text": "わかった、浴衣だ"},
        { "location": "196/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "197/TALK"    , "narrator": "アーヤ", "text": "随分感がいいのね"},
        { "location": "198/TALK"    , "narrator": "アーヤ", "text": "勘がいいのね"},
        { "location": "199/TALK"    , "narrator": "アーヤ", "text": "ご名答"},
        { "location": "201/TALK"    , "narrator": "アーヤ", "text": "つばめとギャヴィの分の"},
        { "location": "202/TALK"    , "narrator": "アーヤ", "text": "浴衣を着付けてあげることになったのよ"},
        { "location": "203/TALK"    , "narrator": "アーヤ", "text": "帯は"},
        { "location": "204/TALK"    , "narrator": "アーヤ", "text": "みやびに任せればいいか"},
        { "location": "206/SEL"     , "narrator": "", "text": "がんばって覚えようよ"},
        { "location": "207/SEL"     , "narrator": "", "text": "それでいいんじゃない"},
        { "location": "208/SEL"     , "narrator": "", "text": "$me$も着付けて欲しいな"},
        { "location": "209/ACT"     , "narrator": "", "text": "がんばって覚えようよ"},
        { "location": "210/TALK"    , "narrator": "アーヤ", "text": "できればできた方がいいわよね"},
        { "location": "211/TALK"    , "narrator": "アーヤ", "text": "がんばろうかしら"},
        { "location": "212/ACT"     , "narrator": "", "text": "それでいいんじゃない"},
        { "location": "213/TALK"    , "narrator": "アーヤ", "text": "今回はそれでいいわよね"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "それが確実だし"},
        { "location": "215/ACT"     , "narrator": "", "text": "$me$も着付けて欲しいな"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "自分で切る気は元々ないのね"},
        { "location": "218/TALK"    , "narrator": "アーヤ", "text": "着る気は"},
        { "location": "220/TALK"    , "narrator": "アーヤ", "text": "小学生でもちゃんと一人で着れるわよ"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "222/TALK"    , "narrator": "アーヤ", "text": "一回ぐらいなら着付けてあげるわ"}
    ]
}
