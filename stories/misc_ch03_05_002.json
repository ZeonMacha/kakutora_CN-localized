        "title": "Extra009 ヒメゴトチャット",
        "sub_title": "あのこがこわいの"
    },
    "entry":
    [
        { "location": "130/SCENARIO", "narrator": "", "text": "002_あのこがこわいの"},
        { "location": "155/TALK"    , "narrator": "ガブリエラ", "text": "なんであんなことができるのかしら？"},
        { "location": "156/TALK"    , "narrator": "ガブリエラ", "text": "信じられないわ・・・"},
        { "location": "159/SEL"     , "narrator": "", "text": "何の話？"},
        { "location": "160/ACT"     , "narrator": "", "text": "何の話？"},
        { "location": "161/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナ"},
        { "location": "162/TALK"    , "narrator": "ガブリエラ", "text": "聞いてちょうだい"},
        { "location": "163/TALK"    , "narrator": "ガブリエラ", "text": "つばめのことなのよ"},
        { "location": "165/TALK"    , "narrator": "ガブリエラ", "text": "あのこ一度死んだはずなのに"},
        { "location": "166/TALK"    , "narrator": "ガブリエラ", "text": "今トライナリーのメンバーになってるの"},
        { "location": "167/TALK"    , "narrator": "ガブリエラ", "text": "なんでなの？"},
        { "location": "170/SEL"     , "narrator": "", "text": "気絶してただけじゃない？"},
        { "location": "171/SEL"     , "narrator": "", "text": "言ってることがよくわからないけど…"},
        { "location": "172/SEL"     , "narrator": "", "text": "ガブリエラはそれを確認したの？"},
        { "location": "173/ACT"     , "narrator": "", "text": "気絶してただけじゃない？"},
        { "location": "174/TALK"    , "narrator": "ガブリエラ", "text": "それはないわ"},
        { "location": "175/ACT"     , "narrator": "", "text": "言ってることがよくわからないけど…"},
        { "location": "176/TALK"    , "narrator": "ガブリエラ", "text": "そうよね・・・"},
        { "location": "177/ACT"     , "narrator": "", "text": "ガブリエラはそれを確認したの？"},
        { "location": "178/TALK"    , "narrator": "ガブリエラ", "text": "もちろんよ"},
        { "location": "180/TALK"    , "narrator": "ガブリエラ", "text": "絶対に人間なら死んでる状況だったの"},
        { "location": "181/TALK"    , "narrator": "ガブリエラ", "text": "なのにあのこは生き返ったのよ"},
        { "location": "182/TALK"    , "narrator": "ガブリエラ", "text": "それだけじゃなくて"},
        { "location": "183/TALK"    , "narrator": "ガブリエラ", "text": "あの場のフェノメノンも収束させたの"},
        { "location": "186/TALK"    , "narrator": "ガブリエラ", "text": "どっちも普通は絶対に無理なことなのよ？"},
        { "location": "189/SEL"     , "narrator": "", "text": "そうなのね"},
        { "location": "190/SEL"     , "narrator": "", "text": "悔しいの？"},
        { "location": "191/SEL"     , "narrator": "", "text": "ガブリエラはどうしたいの？"},
        { "location": "192/ACT"     , "narrator": "", "text": "そうなのね"},
        { "location": "193/TALK"    , "narrator": "ガブリエラ", "text": "そうなのよ・・・"},
        { "location": "194/ACT"     , "narrator": "", "text": "悔しいの？"},
        { "location": "195/TALK"    , "narrator": "ガブリエラ", "text": "違うわよ！"},
        { "location": "196/ACT"     , "narrator": "", "text": "ガブリエラはどうしたいの？"},
        { "location": "206/TALK"    , "narrator": "ガブリエラ", "text": "私？"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "そうだったわね"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "私がどうしたいかを考えなきゃいけないのよね・・・"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナに話してみてよかったわ"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "私、あのこがこわいのよ"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "まるで人間じゃないみたいだもの"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "でもね"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "いいこなの"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "こわいけど"},
        { "location": "221/SEL"     , "narrator": "", "text": "仲良くなれるといいね"},
        { "location": "222/SEL"     , "narrator": "", "text": "先輩として接すればいいよ"},
        { "location": "223/SEL"     , "narrator": "", "text": "$handle$の方がいいこだよ"},
        { "location": "224/ACT"     , "narrator": "", "text": "仲良くなれるといいね"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "なかよく・・・"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "なれるかしらね？"},
        { "location": "229/ACT"     , "narrator": "", "text": "先輩として接すればいいよ"},
        { "location": "230/TALK"    , "narrator": "ガブリエラ", "text": "先輩としてね"},
        { "location": "231/TALK"    , "narrator": "ガブリエラ", "text": "そうだわね"},
        { "location": "232/ACT"     , "narrator": "", "text": "$handle$の方がいいこだよ"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "また変な名前で自分のこと呼んで・・・"},
        { "location": "243/TALK"    , "narrator": "ガブリエラ", "text": "なんなのかしら、もう"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "もしつばめが変なことしたりしたら許さない"},
        { "location": "248/TALK"    , "narrator": "ガブリエラ", "text": "そのためにも私がちゃんとしなきゃいけないわ"},
        { "location": "249/TALK"    , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "250/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "251/TALK"    , "narrator": "ガブリエラ", "text": "その前にお話聞いてちょうだいね？"},
        { "location": "253/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "254/SEL"     , "narrator": "", "text": "当然"},
        { "location": "255/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "256/ACT"     , "narrator": "", "text": "当然"},
        { "location": "258/TALK"    , "narrator": "ガブリエラ", "text": "よかったわｖ"},
        { "location": "259/TALK"    , "narrator": "ガブリエラ", "text": "本当はやっぱりこわかったから"},
        { "location": "260/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "202/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "238/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
