    "entry":
    [
        { "location": "115/SCENARIO", "narrator": "", "text": "敵Ⅱ４"},
        { "location": "136/TALK"    , "narrator": "潜在みやび", "text": "相変わらず\n馬鹿力な想いやね。"},
        { "location": "137/TALK"    , "narrator": "表層みやび", "text": "クラン共を\nちぎっては投げ\nちぎっては投げ。"},
        { "location": "138/TALK"    , "narrator": "潜在みやび", "text": "毎回よう\n頑張っちょるなぁ。"},
        { "location": "139/TALK"    , "narrator": "表層みやび", "text": "その元気、\nいつまで続くかね。"},
        { "location": "141/TALK"    , "narrator": "潜在みやび", "text": "さて、と。\nほんだら、例によって\n例の如く――"},
        { "location": "143/TALK"    , "narrator": "表層みやび", "text": "敵対していた方の\n人格さんは消えるき。"},
        { "location": "144/TALK"    , "narrator": "潜在みやび", "text": "後はよろしく頼んだ。\nOR頼まれた。"},
        { "location": "145/TALK"    , "narrator": "表層みやび", "text": "頼んだOR頼まれた。"},
        { "location": "162/TALK"    , "narrator": "みやび", "text": "ふう。"},
        { "location": "163/SEL"     , "narrator": "（選択肢）", "text": "相変わらず徹底してるね"},
        { "location": "164/ACT"     , "narrator": "", "text": "相変わらず徹底してるね"},
        { "location": "166/TALK"    , "narrator": "みやび", "text": "うむ。\nハッカーたるもの\n身バレは最悪やきね。"},
        { "location": "167/TALK"    , "narrator": "みやび", "text": "とはいえ、もう\nお前さんにはそこまで\nせんでもえいか。"},
        { "location": "169/TALK"    , "narrator": "みやび", "text": "なあ$handle$。\n本当のところ、何が\n目的で近づいちょる？"},
        { "location": "170/TALK"    , "narrator": "みやび", "text": "ここまで拳で語り\n合ってきた仲や。"},
        { "location": "171/TALK"    , "narrator": "みやび", "text": "もう正直に教えて\nくれてもえいろう。"},
        { "location": "172/SEL"     , "narrator": "（選択肢）", "text": "みやびを助けたい"},
        { "location": "173/SEL"     , "narrator": "（選択肢）", "text": "みやびのことをもっと知りたい"},
        { "location": "174/SEL"     , "narrator": "（選択肢）", "text": "みやびを娶りたい"},
        { "location": "175/SEL"     , "narrator": "（選択肢）", "text": "フラグ立てるために仕方なく"},
        { "location": "176/ACT"     , "narrator": "", "text": "みやびを助けたい"},
        { "location": "177/TALK"    , "narrator": "みやび", "text": "前も聞いたけんど\nそれは本当かえ？"},
        { "location": "178/TALK"    , "narrator": "みやび", "text": "まあ、そこまで\n言うなら信じるぞね。"},
        { "location": "179/ACT"     , "narrator": "", "text": "みやびのことをもっと知りたい"},
        { "location": "180/TALK"    , "narrator": "みやび", "text": "知ってどうする？"},
        { "location": "181/TALK"    , "narrator": "みやび", "text": "やっぱりうちから\n何かを奪おうと\nしちょるが？"},
        { "location": "182/SEL"     , "narrator": "（選択肢）", "text": "なんでそんな警戒するの？"},
        { "location": "183/ACT"     , "narrator": "", "text": "なんでそんな警戒するの？"},
        { "location": "185/TALK"    , "narrator": "みやび", "text": "そういう性やきね。"},
        { "location": "186/TALK"    , "narrator": "みやび", "text": "まあえい。\n信じると決めたら\n信じるちや。"},
        { "location": "187/ACT"     , "narrator": "", "text": "みやびを娶りたい"},
        { "location": "188/TALK"    , "narrator": "みやび", "text": "ふむ。\nえい答えやね。"},
        { "location": "189/TALK"    , "narrator": "みやび", "text": "すなわちそれは、\n中の人がいる場合は\n好意的かつ――"},
        { "location": "190/TALK"    , "narrator": "みやび", "text": "現時点では物理的\n接触は不可能である\nということ。"},
        { "location": "191/TALK"    , "narrator": "みやび", "text": "逆にAIならば、\n単なるゴタクに\n過ぎん。"},
        { "location": "192/TALK"    , "narrator": "みやび", "text": "どちらにせよ、うちに\nとっては無害な存在っ\nちゅうことやきね。"},
        { "location": "193/ACT"     , "narrator": "", "text": "フラグ立てるために仕方なく"},
        { "location": "194/TALK"    , "narrator": "みやび", "text": "なるほどな。"},
        { "location": "195/TALK"    , "narrator": "みやび", "text": "ならば、割とどうでも\nいい存在ゆうこっちゃ\nな。お互いに。"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "それくらいがえいな。\n近いうちに、ここにも\n来なくなるじゃろ。"},
        { "location": "198/TALK"    , "narrator": "みやび", "text": "何にしても、今回の\nことは、うち全体に\nとって大きな変化や。"},
        { "location": "199/TALK"    , "narrator": "みやび", "text": "$handle$に\n対するスタンスに\n結論を出したわけやし。"},
        { "location": "200/TALK"    , "narrator": "みやび", "text": "現実のうちも、\nしばらくは大人しく\nつき合うじゃろ。"},
        { "location": "201/TALK"    , "narrator": "みやび", "text": "まあそんなわけで、\nせっかく和解した\nわけやし――"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "和解記念にひとつ\nちゅーでもしよか。"},
        { "location": "203/SEL"     , "narrator": "（選択肢）", "text": "是非！！"},
        { "location": "204/SEL"     , "narrator": "（選択肢）", "text": "遠慮します"},
        { "location": "205/ACT"     , "narrator": "", "text": "是非！！"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "うむ。\n素直が一番やきね。"},
        { "location": "224/TALK"    , "narrator": "みやび", "text": "さあ、はよう。"},
        { "location": "230/DIALOG"  , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "ふぁっ…"},
        { "location": "245/TALK"    , "narrator": "みやび", "text": "ふぁっ…"},
        { "location": "249/DIALOG"  , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "ふむ。\nえい『ちゅー』やった。"},
        { "location": "268/TALK"    , "narrator": "みやび", "text": "まあ、これも全て\n幻想でしかないの\nやけんどな。"},
        { "location": "269/SEL"     , "narrator": "（選択肢）", "text": "幻想？"},
        { "location": "270/ACT"     , "narrator": "", "text": "幻想？"},
        { "location": "272/TALK"    , "narrator": "みやび", "text": "当然や。\nここは精神世界。\n単なる妄想に過ぎん。"},
        { "location": "273/TALK"    , "narrator": "みやび", "text": "まあ、本気で\nうちに興味あるなら―"},
        { "location": "274/TALK"    , "narrator": "みやび", "text": "現実のうちと\n『ちゅー』できるよう\nがんばりや。"},
        { "location": "275/TALK"    , "narrator": "みやび", "text": "ここからが\n大変やきね。"},
        { "location": "276/ACT"     , "narrator": "", "text": "遠慮します"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "なに！？\n本気か！？"},
        { "location": "278/SEL"     , "narrator": "（選択肢）", "text": "裏が有りそう"},
        { "location": "279/ACT"     , "narrator": "", "text": "裏が有りそう"},
        { "location": "281/TALK"    , "narrator": "みやび", "text": "はぁ……\n可哀想なヤツやね。"},
        { "location": "282/TALK"    , "narrator": "みやび", "text": "きっと今まで\n世の中の全てを疑って\n生きてきたんやろな。"},
        { "location": "283/SEL"     , "narrator": "（選択肢）", "text": "みやび先輩にだけは言われたくないんですけど"},
        { "location": "284/ACT"     , "narrator": "", "text": "みやび先輩にだけは言われたくないんですけど"},
        { "location": "286/TALK"    , "narrator": "みやび", "text": "まあえいよ。"},
        { "location": "287/TALK"    , "narrator": "みやび", "text": "これが最初で最後の\nうちからのプレゼント\nやったけんど――"},
        { "location": "288/TALK"    , "narrator": "みやび", "text": "もらうもらわないは\nもらい手の自由やきね。"},
        { "location": "289/TALK"    , "narrator": "みやび", "text": "けんど、ここから先が\n本番ちや。"},
        { "location": "290/TALK"    , "narrator": "みやび", "text": "うちの深い所を見よう\nゆうなら、それなりに\n覚悟していきや。"}
    ]
}
