{
    "dir": "chap15/daydra/dd_ch02_15_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "15252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "電車通学"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "電車通学"},
        { "location": "18/TALK"   , "narrator": "つばめ", "text": "あれ？　アーヤさん。\n今日はバイクじゃないん\nですか？"},
        { "location": "21/TALK"   , "narrator": "アーヤ", "text": "来る時に雨が降りそう\nだったから、電車にしたん\nだけど――"},
        { "location": "22/TALK"   , "narrator": "アーヤ", "text": "見ての通り、今頃になって\n晴れてきちゃってね…。"},
        { "location": "23/TALK"   , "narrator": "つばめ", "text": "そうだったんですか…。"},
        { "location": "24/TALK"   , "narrator": "アーヤ", "text": "バイクで少しだけ\n遠回りして帰るのが\n好きなんだけど――"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "残念ながら、\n今日はお預けね。"},
        { "location": "28/TALK"   , "narrator": "つばめ", "text": "…アーヤさん、\n何だかガッカリしてる\nみたい。"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "…そうだ！\n今日の放課後って\n予定ありますか？"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "う～ん…早く帰って、\n少しでもバイクに\n乗ろうかと思ってるわ。"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "あの子、一日一回は\nエンジン掛けないと、\n機嫌悪くなっちゃうのよ。"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "あはは、かっこいいのに\nワガママさんなんですね。"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "もし予定がないなら、\n一緒に寄り道なんて\nどうかな――"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "って、思ったんですけど、\nそれじゃあ仕方ない\nですね。"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "つばめと？"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "はい。アーヤさんって、\nいつもバイクで大学に\n通ってますよね？"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "だから、たまには普通に\n寄り道して帰るのも\n楽しいんじゃないかな――"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "って、思ったんです。"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "う～ん…寄り道かぁ。"},
        { "location": "44/SEL"    , "narrator": "", "text": "まっすぐ帰ろう"},
        { "location": "45/SEL"    , "narrator": "", "text": "たまには良いと思うよ"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "でも、バイトの時間も\nあるから、遠くには\n行けないわよ？"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "帰り道にも、面白いお店は\n沢山あります。"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "そうだ！\nこの前も、素敵な雑貨屋を\n見つけちゃったんです。"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "北欧スタイルの雑貨や\n家具なんかが置いてある、\n素敵なお店なんですよ。"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "へぇ、そんな素敵な\nお店が近くにあるんだ？"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "大通りから一本奥に\n入ったところにある\nお店なんです。"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "そうなんだ…。\nじゃあ、帰りはそこに\n行ってみましょ。"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "やった！\nじゃあ、授業終わったら\nＷＡＶＥを送りますね。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "ええ、楽しみにしてるわ。"},
        { "location": "59/ACT"    , "narrator": "", "text": "まっすぐ帰ろう"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "…そうよね"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "バイトのことも考えると、今日はやめた方が良いかも"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "せっかくだけど、\n今日はやめておくわ。"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "バイトもあるから、\nあんまりゆっくりとして\nいられないだろうし。"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "せっかくお店を見て\n周るなら、時間のある日に\n行きたいわ。"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "そうですか…。"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "その代わりなんだけど、\n今日は私に付き合って\nもらえないかしら？"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "帰ったら近所をバイクで\n流そうと思うから――"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "よければ、一緒にどう？\nたまには後ろに誰か\n乗ってほしかったの。"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "わぁ、いいんですか？"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "もちろんよ。"},
        { "location": "103/TALK"  , "narrator": "つばめ", "text": "お付き合いします！\n楽しみです。"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "ふふっ、つばめも\nバイクの良さがわかって\nきたのかしら？"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "私も楽しみにしてるわ。\nそれじゃあ、放課後にね。"},
        { "location": "107/ACT"   , "narrator": "", "text": "たまには良いと思うよ"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "聞いてたの？"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "私もそう思ってたところよ"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "決まりね(*^-ﾟ)v"},
        { "location": "141/TALK"  , "narrator": "つばめ", "text": "ＷＡＶＥですか？"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "あ、ごめんなさい。\nちょっと友達からね…。"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "寄り道しながら帰るのも\n楽しそうね。\n今日は一緒に帰りましょ。"},
        { "location": "146/TALK"  , "narrator": "つばめ", "text": "本当ですか！？"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "ええ。"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "ただし、どこに行くかは\nつばめが決めてね。"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "えぇっ！！\nわ、わたしがですか！？"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "そりゃ、こういうのは\n誘った人が決めるもん\nでしょ？"},
        { "location": "153/TALK"  , "narrator": "アーヤ", "text": "それに私、寄り道なんて\n普段しないから――"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "どういうところに行けば\nいいのかわからないもの。"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "そういうわけで、\n放課後楽しみにしてるわ。"},
        { "location": "157/TALK"  , "narrator": "つばめ", "text": "えぇーっ！？"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "ど、どうしよう…。\nアーヤさんが楽しめる\nところ、行けるかなぁ？"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "こっちに来てから\nこういうの初めてだし――"},
        { "location": "160/TALK"  , "narrator": "アーヤ", "text": "私はどこでも構わないん\nだけどね。"},
        { "location": "16/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月4日　3:13 PM</color>\nとある平日の放課後、附属学園正門前にて。"}
    ]
}
