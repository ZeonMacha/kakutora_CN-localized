        "title": "Extra008 ヒメゴトチャット",
        "sub_title": "条件付きのリテラシー"
    },
    "entry":
    [
        { "location": "7898/SCENARIO", "narrator": "", "text": "条件付きのリテラシー"},
        { "location": "7925/TALK"    , "narrator": "神楽", "text": "例えばアキバ文化に詳しいということは"},
        { "location": "7926/TALK"    , "narrator": "神楽", "text": "他のサブカルチャーについて造詣が深いということになるわけではない"},
        { "location": "7928/SEL"     , "narrator": "", "text": "そりゃそうだ"},
        { "location": "7929/SEL"     , "narrator": "", "text": "めんどくさそうな話だ"},
        { "location": "7930/SEL"     , "narrator": "", "text": "神楽に詳しくなりたいな"},
        { "location": "7931/ACT"     , "narrator": "", "text": "そりゃそうだ"},
        { "location": "7932/TALK"    , "narrator": "神楽", "text": "そうなんだけどね"},
        { "location": "7933/ACT"     , "narrator": "", "text": "めんどくさそうな話だ"},
        { "location": "7934/TALK"    , "narrator": "神楽", "text": "そんなことないぴょん"},
        { "location": "7935/ACT"     , "narrator": "", "text": "神楽に詳しくなりたいな"},
        { "location": "7937/TALK"    , "narrator": "神楽", "text": "それはどうかなー？"},
        { "location": "7939/TALK"    , "narrator": "神楽", "text": "ぴょんこは謎多き女、、、"},
        { "location": "7940/TALK"    , "narrator": "神楽", "text": "ミステリアスガール、、、"},
        { "location": "7941/TALK"    , "narrator": "神楽", "text": "そして魔法少女、、、は微妙に違うか"},
        { "location": "7942/TALK"    , "narrator": "神楽", "text": "一応衣装は意識してるけどね☆彡"},
        { "location": "7944/TALK"    , "narrator": "神楽", "text": "一言でアキバカルチャーって言ってもその中身も交わらないよね"},
        { "location": "7945/TALK"    , "narrator": "神楽", "text": "地下アイドル好きとメイド好きは似て非なるものだし"},
        { "location": "7946/TALK"    , "narrator": "神楽", "text": "同人っていっても一次と二次でも全然違う文化だし"},
        { "location": "7947/TALK"    , "narrator": "神楽", "text": "知れば知るほど奥が深いぴょん♪"}
    ]
}
