        { "location": "93/SEL"    , "narrator": "", "text": "今度行こうよ"},
        { "location": "94/ACT"    , "narrator": "", "text": "そんなのがあるんだ"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "そぅなの"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "ぃぃでしょヾ(*´ｴ`*)ﾉ"},
        { "location": "97/ACT"    , "narrator": "", "text": "響きがすごいね"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "すごぃのかな？"},
        { "location": "99/TALK"   , "narrator": "つばめ", "text": "そんなこと思ったことなかったけど"},
