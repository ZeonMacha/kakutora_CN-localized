        "title": "Twitter Archive 008",
        "sub_title": "卯月画廊：うとうとお風呂"
    },
    "entry":
    [
        { "location": "149/TALK"  , "narrator": "透明みやび", "text": "きゃーえっちー。\n卯月がうちの入浴現場\n盗撮しよったー。"},
        { "location": "151/TALK"  , "narrator": "透明神楽", "text": "ちょ！？　みやびさん！\n誤解されるようなこと\n言わないでください！"},
        { "location": "152/TALK"  , "narrator": "透明みやび", "text": "いやー、卯月の絵は\n上手やき、つい写真と\n見間違うてしまったがよ。"},
        { "location": "154/TALK"  , "narrator": "透明みやび", "text": "とまあ、冗談はさておき。\n何故にうちの入浴中の\n絵をアップしたん？"},
        { "location": "155/TALK"  , "narrator": "透明神楽", "text": "それはですね、\nみやびさんが入浴剤を\n使ったからです。"},
        { "location": "156/TALK"  , "narrator": "透明みやび", "text": "？"},
        { "location": "157/TALK"  , "narrator": "透明神楽", "text": "あの入浴剤には、\n私の呪いがかけて\nあるんですよ。"},
        { "location": "158/TALK"  , "narrator": "透明みやび", "text": "ほほぅ、呪い？\n入浴シーンがネット公開\nされる呪いとかか？"},
        { "location": "159/TALK"  , "narrator": "透明神楽", "text": "近いけど、ハズレです。"},
        { "location": "162/TALK"  , "narrator": "透明神楽", "text": "あの入浴剤にかけられた\n呪いというのは、\n透視です！"},
        { "location": "164/TALK"  , "narrator": "透明みやび", "text": "透視？\n風呂場のか？"},
        { "location": "165/TALK"  , "narrator": "透明神楽", "text": "そんなの、呪いじゃ\nなくてもできるじゃ\nないですか。"},
        { "location": "167/TALK"  , "narrator": "透明神楽", "text": "私が透視するのは、\n使用者の妄想です。"},
        { "location": "168/TALK"  , "narrator": "透明神楽", "text": "そして、その透視した\n妄想を描いたものこそ、\nこの絵なんです。"},
        { "location": "169/TALK"  , "narrator": "透明みやび", "text": "…マジか。"},
        { "location": "170/TALK"  , "narrator": "透明神楽", "text": "大マジです。"},
        { "location": "171/TALK"  , "narrator": "透明みやび", "text": "うち、妄想じゃなくて\nまっこと風呂で爆睡してた\nんやけんど…。"},
        { "location": "172/TALK"  , "narrator": "透明神楽", "text": "…リアルでお風呂で\n寝るのは、ちょっと\n危ないと思いますよ？"},
        { "location": "174/TALK"  , "narrator": "透明みやび", "text": "溺れたとしたら、\nそれも卯月の呪いちや。"},
        { "location": "175/TALK"  , "narrator": "透明神楽", "text": "そんな呪いかけませんし、\nかけられません！"},
        { "location": "176/SEL"   , "narrator": "（選択肢）", "text": "お風呂で寝たら危ないよ！"},
        { "location": "177/ACT"   , "narrator": "", "text": "お風呂で寝たら危ないよ！"},
        { "location": "185/TALK"  , "narrator": "みやび", "text": "危険だが"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "気持ちいいのだ"},
        { "location": "188/TALK"  , "narrator": "みやび", "text": "故にやめられない"},
        { "location": "189/SEL"   , "narrator": "（選択肢）", "text": "わからなくもないけどね"},
        { "location": "190/SEL"   , "narrator": "（選択肢）", "text": "溺れないか心配だ"},
        { "location": "191/ACT"   , "narrator": "", "text": "わからなくもないけどね"},
        { "location": "192/TALK"  , "narrator": "みやび", "text": "さすがは相棒"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "もしや"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "経験あるな？"},
        { "location": "195/SEL"   , "narrator": "（選択肢）", "text": "バレたか"},
        { "location": "196/SEL"   , "narrator": "（選択肢）", "text": "ないよ"},
        { "location": "197/ACT"   , "narrator": "", "text": "バレたか"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "理解ある時点で"},
        { "location": "200/TALK"  , "narrator": "みやび", "text": "経験ありと感じた"},
        { "location": "201/TALK"  , "narrator": "みやび", "text": "同士よ！"},
        { "location": "202/ACT"   , "narrator": "", "text": "ないよ"},
        { "location": "203/TALK"  , "narrator": "みやび", "text": "ないのにわかるのか"},
        { "location": "204/TALK"  , "narrator": "みやび", "text": "理解力があるせいか"},
        { "location": "205/TALK"  , "narrator": "みやび", "text": "それとも"},
        { "location": "206/TALK"  , "narrator": "みやび", "text": "適当に言っただけなのか"},
        { "location": "207/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "208/TALK"  , "narrator": "みやび", "text": "どちらでも構わんが"},
        { "location": "210/ACT"   , "narrator": "", "text": "溺れないか心配だ"},
        { "location": "211/TALK"  , "narrator": "みやび", "text": "心配してくれるなら"},
        { "location": "212/TALK"  , "narrator": "みやび", "text": "見張りをやってほしいぞね"},
        { "location": "214/TALK"  , "narrator": "みやび", "text": "それなら"},
        { "location": "215/TALK"  , "narrator": "みやび", "text": "爆睡しても怖くない"},
        { "location": "216/SEL"   , "narrator": "（選択肢）", "text": "眠い時はシャワーにして"},
        { "location": "217/SEL"   , "narrator": "（選択肢）", "text": "胸ばかり目がいきそう…"},
        { "location": "218/ACT"   , "narrator": "", "text": "眠い時はシャワーにして"},
        { "location": "219/TALK"  , "narrator": "みやび", "text": "眠い時の風呂こそ"},
        { "location": "220/TALK"  , "narrator": "みやび", "text": "最高なのだがね"},
        { "location": "221/ACT"   , "narrator": "", "text": "胸ばかり目がいきそう…"},
        { "location": "222/TALK"  , "narrator": "みやび", "text": "顔を見てほしい"},
        { "location": "224/TALK"  , "narrator": "みやび", "text": "胸は浮くが"},
        { "location": "225/TALK"  , "narrator": "みやび", "text": "顔は沈むのだ"},
        { "location": "228/TALK"  , "narrator": "みやび", "text": "しかし"},
        { "location": "229/TALK"  , "narrator": "みやび", "text": "あの入浴剤は"},
        { "location": "230/TALK"  , "narrator": "みやび", "text": "とても気持ちよかった"},
        { "location": "231/TALK"  , "narrator": "みやび", "text": "また入れたいぞね"},
        { "location": "232/TALK"  , "narrator": "みやび", "text": "今日も入れるか"},
        { "location": "233/SEL"   , "narrator": "（選択肢）", "text": "また呪いで透視されるよ？"},
        { "location": "234/SEL"   , "narrator": "（選択肢）", "text": "また寝ちゃうよ？"},
        { "location": "235/ACT"   , "narrator": "", "text": "また呪いで透視されるよ？"},
        { "location": "236/TALK"  , "narrator": "みやび", "text": "それを期待している"},
        { "location": "238/TALK"  , "narrator": "みやび", "text": "今度はもっと"},
        { "location": "239/TALK"  , "narrator": "みやび", "text": "普段思うてる妄想"},
        { "location": "240/TALK"  , "narrator": "みやび", "text": "ちゃんと透視して描いてほしいのだ"},
        { "location": "241/SEL"   , "narrator": "（選択肢）", "text": "どんな妄想してるの？"},
        { "location": "242/ACT"   , "narrator": "", "text": "どんな妄想してるの？"},
        { "location": "244/TALK"  , "narrator": "みやび", "text": "トップシークレット"},
        { "location": "245/TALK"  , "narrator": "みやび", "text": "相棒に言うのは"},
        { "location": "246/TALK"  , "narrator": "みやび", "text": "照れるからな"},
        { "location": "247/ACT"   , "narrator": "", "text": "また寝ちゃうよ？"},
        { "location": "248/TALK"  , "narrator": "みやび", "text": "それもよかろう"},
        { "location": "249/TALK"  , "narrator": "みやび", "text": "風呂で寝ると"},
        { "location": "250/TALK"  , "narrator": "みやび", "text": "相棒も知ったのだし"},
        { "location": "251/TALK"  , "narrator": "みやび", "text": "もし寝ても"},
        { "location": "252/TALK"  , "narrator": "みやび", "text": "相棒が起こしてくれると期待している"},
        { "location": "254/TALK"  , "narrator": "みやび", "text": "とりあえず"},
        { "location": "256/TALK"  , "narrator": "みやび", "text": "今度呪いかける時は"},
        { "location": "257/TALK"  , "narrator": "みやび", "text": "透視ではなく"},
        { "location": "258/TALK"  , "narrator": "みやび", "text": "胸が小さくなる呪いを希望する"},
        { "location": "259/TALK"  , "narrator": "みやび", "text": "そう言っておくぞね"},
        { "location": "265/DIALOG", "narrator": "", "text": "このシナリオの元になっている\nTwitterの会話ログを見ますか？"}
    ]
}
