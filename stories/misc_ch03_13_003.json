        { "location": "178/SCENARIO", "narrator": "", "text": "021_満ちて欠ける気持ち"},
        { "location": "203/TALK"    , "narrator": "ガブリエラ", "text": "アーヤは結局"},
        { "location": "204/TALK"    , "narrator": "ガブリエラ", "text": "誰にでも優しいのよね"},
        { "location": "206/SEL"     , "narrator": "", "text": "そうかも"},
        { "location": "207/SEL"     , "narrator": "", "text": "やきもちだ"},
        { "location": "208/SEL"     , "narrator": "", "text": "ガブリエラのこと好きだと思うよ"},
        { "location": "209/ACT"     , "narrator": "", "text": "そうかも"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "211/ACT"     , "narrator": "", "text": "やきもちだ"},
        { "location": "212/TALK"    , "narrator": "ガブリエラ", "text": "何よ"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "やきもち妬いちゃ悪いのかしら？"},
        { "location": "214/ACT"     , "narrator": "", "text": "ガブリエラのこと好きだと思うよ"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "そうかしら？"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "私、時々すごく意地悪をしてしまうけど"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "好きでいてくれてるかしら？"},
        { "location": "221/TALK"    , "narrator": "ガブリエラ", "text": "アーヤは小さい子たちにとても人気だったわ"},
        { "location": "223/SEL"     , "narrator": "", "text": "そうだろうね"},
        { "location": "224/SEL"     , "narrator": "", "text": "いいことじゃない"},
        { "location": "225/SEL"     , "narrator": "", "text": "$me$の一番人気はガブリエラだから"},
        { "location": "226/ACT"     , "narrator": "", "text": "そうだろうね"},
        { "location": "227/TALK"    , "narrator": "ガブリエラ", "text": "ええ"},
        { "location": "228/ACT"     , "narrator": "", "text": "いいことじゃない"},
        { "location": "229/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "230/ACT"     , "narrator": "", "text": "$me$の一番人気はガブリエラだから"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "もう////////////////"},
        { "location": "234/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナったらｖｖｖｖｖ"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "それで思ってしまったの"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "私もアーヤにとってはただの小さい子なのかしらって"},
        { "location": "239/SEL"     , "narrator": "", "text": "どうかな"},
        { "location": "240/SEL"     , "narrator": "", "text": "そうかも"},
        { "location": "241/SEL"     , "narrator": "", "text": "聞いてみれば"},
        { "location": "242/ACT"     , "narrator": "", "text": "どうかな"},
        { "location": "243/TALK"    , "narrator": "ガブリエラ", "text": "そんなの"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "わからないわよね"},
        { "location": "245/ACT"     , "narrator": "", "text": "そうかも"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "そうなのかしら・・・"},
        { "location": "248/ACT"     , "narrator": "", "text": "聞いてみれば"},
        { "location": "249/TALK"    , "narrator": "ガブリエラ", "text": "そんなこと"},
        { "location": "251/TALK"    , "narrator": "ガブリエラ", "text": "聞けるわけないじゃない"},
        { "location": "252/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナの意地悪！"}
    ]
}
