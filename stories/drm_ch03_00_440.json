        { "location": "7/SCENARIO", "narrator": "", "text": "440_使用人から解放するわ"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "いるかしら？"},
        { "location": "35/SEL"    , "narrator": "", "text": "どうしたの"},
        { "location": "36/SEL"    , "narrator": "", "text": "本日の業務は終了しました"},
        { "location": "37/SEL"    , "narrator": "", "text": "いつもそばにいるよ"},
        { "location": "39/ACT"    , "narrator": "", "text": "どうしたの"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "41/ACT"    , "narrator": "", "text": "本日の業務は終了しました"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "いいから"},
        { "location": "43/ACT"    , "narrator": "", "text": "いつもそばにいるよ"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "当然よね"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "ええとね"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "お話しておきたいことがあったの"},
        { "location": "60/SEL"    , "narrator": "", "text": "何？"},
        { "location": "61/SEL"    , "narrator": "", "text": "聞きたくない"},
        { "location": "62/ACT"    , "narrator": "", "text": "何？"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "えっと・・・"},
        { "location": "64/ACT"    , "narrator": "", "text": "聞きたくない"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "そう・・・"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "でも聞いて欲しいの"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "真面目なお話よ"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "私、$handle$を使用人から解放するわ"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "今までありがとう"},
        { "location": "72/SEL"    , "narrator": "", "text": "どうして急に？"},
        { "location": "73/SEL"    , "narrator": "", "text": "お別れじゃないよね？"},
        { "location": "74/SEL"    , "narrator": "", "text": "これからは$handle$がご主人様！"},
        { "location": "75/ACT"    , "narrator": "", "text": "どうして急に？"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "急にじゃないわ"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "ずっと考えてたのよ"},
        { "location": "78/ACT"    , "narrator": "", "text": "お別れじゃないよね？"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "どうしてそんなこと聞くの？"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "$handle$はずっと私とお話してくれるんでしょう？"},
        { "location": "81/ACT"    , "narrator": "", "text": "これからは$handle$がご主人様！"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "どうしてそうなるのかしら！"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "真面目にお話して！！"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "私ね"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "$handle$のこと、キューピッドとか使用人とか"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "そんな風に言ってたけど"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりそんな風にしちゃいけないっておもって"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "それに"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "$handle$はそんなじゃなくても"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "私とお話してくれるでしょう？"},
        { "location": "94/SEL"    , "narrator": "", "text": "そうだね"},
        { "location": "95/ACT"    , "narrator": "", "text": "そうだね"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "だからよ"},
        { "location": "99/SEL"    , "narrator": "", "text": "じゃあこれからは友達だね"},
        { "location": "100/SEL"   , "narrator": "", "text": "じゃあこれからは恋人同士だね"},
        { "location": "101/ACT"   , "narrator": "", "text": "じゃあこれからは友達だね"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "友達"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "友達よね"},
        { "location": "107/ACT"   , "narrator": "", "text": "じゃあこれからは恋人同士だね"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "！！！！！！！！！！！！！！！！"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "すぐそうやって調子に乗るんだから！！！"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "もう"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "そういうのは"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "順番があるでしょ！！！"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "って"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "違う違う違う"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "違うんだからね！！！！！！！"},
