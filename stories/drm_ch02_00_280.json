        { "location": "7/SCENARIO", "narrator": "", "text": "200_ボーダーライン"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "みえるようでみえないわ"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "難しいわ(´o｀；"},
        { "location": "35/SEL"    , "narrator": "", "text": "チラリズム？"},
        { "location": "36/SEL"    , "narrator": "", "text": "何の話？"},
        { "location": "37/ACT"    , "narrator": "", "text": "チラリズム？"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "え(--*;"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "違うわよ(--*;"},
        { "location": "40/ACT"    , "narrator": "", "text": "何の話？"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "簡単だけど"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "微妙な話よ"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "人と人との関わり愛の栓"},
        { "location": "46/SEL"    , "narrator": "", "text": "えっと？"},
        { "location": "47/SEL"    , "narrator": "", "text": "ごめん、何？"},
        { "location": "48/SEL"    , "narrator": "", "text": "あーわかるー"},
        { "location": "49/ACT"    , "narrator": "", "text": "えっと？"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "うわ＼(◎o◎)／"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "間違った"},
        { "location": "53/ACT"    , "narrator": "", "text": "ごめん、何？"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "これじゃわからないわね"},
        { "location": "57/ACT"    , "narrator": "", "text": "あーわかるー"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "いやいやヽ(´o｀；"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "自分でも何言ってるかわからないわ"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "知り合いと友達とのボーダーラインって"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "どこにあるのかなって話"},
        { "location": "67/SEL"    , "narrator": "", "text": "それな"},
        { "location": "68/SEL"    , "narrator": "", "text": "難しいよね"},
        { "location": "69/SEL"    , "narrator": "", "text": "悩んでたりする？"},
        { "location": "71/ACT"    , "narrator": "", "text": "それな"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "そういう話を"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "したかったのよ"},
        { "location": "74/ACT"    , "narrator": "", "text": "難しいよね"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "そう"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "そうなのよー"},
        { "location": "77/ACT"    , "narrator": "", "text": "悩んでたりする？"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "うんまあ"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "ちょっとだけね(T_T)"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "聞いてくれる？"},
        { "location": "92/SEL"    , "narrator": "", "text": "もちろん"},
        { "location": "93/ACT"    , "narrator": "", "text": "もちろん"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "$handle$さんに言ってよかった(*^o^*)"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "何度も会っても友達って気がしない人もいるでしょ"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "逆のこともないわけじゃないけど"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "でね"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "お互い同じ感覚ならまだいいけど"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "そうじゃない時って"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "どうしたらって思うのよ（￣ー￣？）"},
        { "location": "106/SEL"   , "narrator": "", "text": "体当たりかな"},
        { "location": "107/SEL"   , "narrator": "", "text": "話し合い"},
        { "location": "108/SEL"   , "narrator": "", "text": "そういうこともあるよね"},
        { "location": "109/ACT"   , "narrator": "", "text": "体当たりかな"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "体当たり＼(◎o◎)／"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "いやだから"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "そういう距離じゃないのよ(-.-;)"},
        { "location": "113/ACT"   , "narrator": "", "text": "話し合い"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "そうね"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "だだ問題は"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "そこまでの距離じゃないってことかしら"},
        { "location": "117/ACT"   , "narrator": "", "text": "そういうこともあるよね"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "そうなの"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "あるわよねー"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "んー"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "そんな感じで"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "お悩みなのよ"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "聞いてくれてよかったわ"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "ありがとう"},
        { "location": "83/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>600pt.</b></color></size>\nアップしました！"}
