        { "location": "373/SCENARIO", "narrator": "", "text": "105_沈黙の嘘"},
        { "location": "398/SEL"     , "narrator": "", "text": "アーヤ？"},
        { "location": "399/SEL"     , "narrator": "", "text": "いるんでしょ？"},
        { "location": "400/ACT"     , "narrator": "", "text": "アーヤ？"},
        { "location": "402/TALK"    , "narrator": "アーヤ", "text": "呼んだ？"},
        { "location": "404/SEL"     , "narrator": "", "text": "呼んじゃダメだった？"},
        { "location": "405/SEL"     , "narrator": "", "text": "出直した方がいい？"},
        { "location": "406/ACT"     , "narrator": "", "text": "呼んじゃダメだった？"},
        { "location": "407/TALK"    , "narrator": "アーヤ", "text": "そういうわけじゃ"},
        { "location": "409/TALK"    , "narrator": "アーヤ", "text": "ないんだけど"},
        { "location": "411/ACT"     , "narrator": "", "text": "出直した方がいい？"},
        { "location": "412/TALK"    , "narrator": "アーヤ", "text": "うーんと"},
        { "location": "415/ACT"     , "narrator": "", "text": "いるんでしょ？"},
        { "location": "417/TALK"    , "narrator": "アーヤ", "text": "いるけど、、、"},
        { "location": "420/SEL"     , "narrator": "", "text": "話がしたいんだ"},
        { "location": "421/SEL"     , "narrator": "", "text": "最近冷たくない？"},
        { "location": "422/ACT"     , "narrator": "", "text": "話がしたいんだ"},
        { "location": "423/TALK"    , "narrator": "アーヤ", "text": "長くなる？"},
        { "location": "425/ACT"     , "narrator": "", "text": "最近冷たくない？"},
        { "location": "426/TALK"    , "narrator": "アーヤ", "text": "、、、、"},
        { "location": "429/SEL"     , "narrator": "", "text": "これまで通りじゃダメ？"},
        { "location": "430/SEL"     , "narrator": "", "text": "気にしすぎないで"},
        { "location": "431/ACT"     , "narrator": "", "text": "これまで通りじゃダメ？"},
        { "location": "433/TALK"    , "narrator": "アーヤ", "text": "そうしたいとは"},
        { "location": "435/TALK"    , "narrator": "アーヤ", "text": "思ってる"},
        { "location": "437/ACT"     , "narrator": "", "text": "気にしすぎないで"},
        { "location": "438/TALK"    , "narrator": "アーヤ", "text": "貴方はそうかもしれないけど"},
        { "location": "441/SEL"     , "narrator": "", "text": "そっか"},
        { "location": "442/SEL"     , "narrator": "", "text": "どうにもできなかったんだ"},
        { "location": "443/ACT"     , "narrator": "", "text": "そっか"},
        { "location": "444/TALK"    , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "445/TALK"    , "narrator": "アーヤ", "text": "ね"},
        { "location": "446/ACT"     , "narrator": "", "text": "どうにもできなかったんだ"},
        { "location": "456/TALK"    , "narrator": "アーヤ", "text": "それは、、、"},
        { "location": "457/TALK"    , "narrator": "アーヤ", "text": "いろいろ事情があったのよね"},
        { "location": "458/TALK"    , "narrator": "アーヤ", "text": "そこは"},
        { "location": "459/TALK"    , "narrator": "アーヤ", "text": "もう"},
        { "location": "460/TALK"    , "narrator": "アーヤ", "text": "仕方ないって思ってる"},
        { "location": "461/TALK"    , "narrator": "アーヤ", "text": "だから"},
        { "location": "462/TALK"    , "narrator": "アーヤ", "text": "それはいいの"},
        { "location": "463/TALK"    , "narrator": "アーヤ", "text": "いいんだけど"},
        { "location": "465/TALK"    , "narrator": "アーヤ", "text": "えっと、、、"},
        { "location": "466/TALK"    , "narrator": "アーヤ", "text": "レポートとかあって"},
        { "location": "467/TALK"    , "narrator": "アーヤ", "text": "忙しいから"},
        { "location": "468/TALK"    , "narrator": "アーヤ", "text": "またね！"},
        { "location": "471/TALK"    , "narrator": "アーヤ", "text": "いや"},
        { "location": "472/TALK"    , "narrator": "アーヤ", "text": "やっぱりちょっと"},
        { "location": "473/TALK"    , "narrator": "アーヤ", "text": "言葉が足りてなかった気がするから"},
        { "location": "474/TALK"    , "narrator": "アーヤ", "text": "補足しておくわね"},
        { "location": "477/TALK"    , "narrator": "ボイスメール", "text": "その、ね"},
        { "location": "452/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "489/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【その、ね】</color>\nをゲットしました！"}
    ]
