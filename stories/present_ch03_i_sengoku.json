        { "location": "362/TALK", "narrator": "ガブリエラ", "text": "知ってはいたけれど、戦国武将って沢山いるのね"},
        { "location": "364/TALK", "narrator": "ガブリエラ", "text": "あ、伊達政宗は知ってるわ"},
        { "location": "365/TALK", "narrator": "ガブリエラ", "text": "あと、上杉謙信もそうよね"},
        { "location": "366/TALK", "narrator": "ガブリエラ", "text": "それと、真田幸村！"},
        { "location": "369/SEL" , "narrator": "", "text": "有名どころばかりだね"},
        { "location": "370/ACT" , "narrator": "", "text": "有名どころばかりだね"},
        { "location": "373/TALK", "narrator": "ガブリエラ", "text": "仕方ないじゃない"},
        { "location": "374/TALK", "narrator": "ガブリエラ", "text": "私だって、戦国武将を調べたりはしてないんだから"},
        { "location": "375/TALK", "narrator": "ガブリエラ", "text": "有名どころ以外の名前は知らないわ"},
        { "location": "378/SEL" , "narrator": "", "text": "知ってる中では誰が好き？"},
        { "location": "379/ACT" , "narrator": "", "text": "知ってる中では誰が好き？"},
        { "location": "382/TALK", "narrator": "ガブリエラ", "text": "やっぱり、幸村かしら？"},
        { "location": "383/TALK", "narrator": "ガブリエラ", "text": "私が一番最初に知ったのが、幸村だし"},
        { "location": "384/TALK", "narrator": "ガブリエラ", "text": "そういえば、真田家ゆかりの地って、信州だったわね"},
        { "location": "385/TALK", "narrator": "ガブリエラ", "text": "今度、アーヤに案内してもらおうかしら？"}
