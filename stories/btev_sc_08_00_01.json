        "title": "【EXストーリー】友愛の復讐者",
        "sub_title": "コネクトストーリー"
    },
    "entry":
    [
        { "location": "356/SCENARIO", "narrator": "", "text": "【導入】ちとせ"},
        { "location": "362/DIALOG"  , "narrator": "", "text": "<size=40>CURAN STORY. 01</size>\nTSUBAME OHSE\n\n<size=45>赤城ちとせ</size>\n<size=35>～情報時代の犠牲者～</size>"},
        { "location": "384/TALK"    , "narrator": "つばめ", "text": "ようこそ\nいらっしゃいました、\n$handle$さん。"},
        { "location": "385/TALK"    , "narrator": "つばめ", "text": "ここは、私たち\nトライナリーと、\nクランたちとの交差点。"},
        { "location": "386/TALK"    , "narrator": "つばめ", "text": "ココロとココロが\n出逢い、共鳴し、\nそして繋がりあう場所。"},
        { "location": "388/SEL"     , "narrator": "（選択肢）", "text": "概要説明を飛ばす"},
        { "location": "389/SEL"     , "narrator": "（選択肢）", "text": "もう一度聞く"},
        { "location": "390/ACT"     , "narrator": "", "text": "概要説明を飛ばす"},
        { "location": "391/TALK"    , "narrator": "つばめ", "text": "それでは早速、今回の\nクランを紹介しますね。"},
        { "location": "393/ACT"     , "narrator": "", "text": "もう一度聞く"},
        { "location": "398/TALK"    , "narrator": "つばめ", "text": "ここでは、普段私たちを\n助けてくれるサーバント\nクランを紹介します。"},
        { "location": "399/TALK"    , "narrator": "つばめ", "text": "そして、貴方が直接\n彼女たちと繋がれる\nよう、手続きをします。"},
        { "location": "400/SEL"     , "narrator": "（選択肢）", "text": "直接繋がるって、クランと？"},
        { "location": "401/ACT"     , "narrator": "", "text": "直接繋がるって、クランと？"},
        { "location": "403/TALK"    , "narrator": "つばめ", "text": "はい、そうです。"},
        { "location": "404/TALK"    , "narrator": "つばめ", "text": "このセクターでは、\nクラン一人にスポットを\n当てて紹介します。"},
        { "location": "405/TALK"    , "narrator": "つばめ", "text": "そして彼女との【儀式】\nによって、貴方とココロを\n繋げます。"},
        { "location": "406/TALK"    , "narrator": "つばめ", "text": "【儀式】には『コネクト』\nと『シンクロ』の２つが\nあります。"},
        { "location": "408/TALK"    , "narrator": "つばめ", "text": "『コネクト』は、貴方と\nクランが物理的に繋がる\nための儀式。"},
        { "location": "409/TALK"    , "narrator": "つばめ", "text": "これは、バトルをする事で\n彼女と貴方の中にある、\n抵抗勢力を無力化します。"},
        { "location": "411/TALK"    , "narrator": "つばめ", "text": "次の『シンクロ』では、\nクランの過去を知り、\n共感していただきます。"},
        { "location": "412/TALK"    , "narrator": "つばめ", "text": "これは、クランの過去の\n物語をシェアすることで、\n心が通えるようにします。"},
        { "location": "414/TALK"    , "narrator": "つばめ", "text": "ここまで、\nわかりましたか？"},
        { "location": "415/TALK"    , "narrator": "つばめ", "text": "もし、入るセクターを\n間違えた、という方は\n今からでも退場できます。"},
        { "location": "416/SEL"     , "narrator": "（選択肢）", "text": "オッケー、先に進んで"},
        { "location": "417/SEL"     , "narrator": "（選択肢）", "text": "間違えたので退場します"},
        { "location": "418/SEL"     , "narrator": "（選択肢）", "text": "なんでそんなフォーマルな感じなの？"},
        { "location": "419/ACT"     , "narrator": "", "text": "オッケー、先に進んで"},
        { "location": "420/TALK"    , "narrator": "つばめ", "text": "承知しました。\nそれでは早速、今回の\nクランを紹介しますね。"},
        { "location": "421/ACT"     , "narrator": "", "text": "間違えたので退場します"},
        { "location": "422/TALK"    , "narrator": "つばめ", "text": "あれ、\nそうだったんですね。"},
        { "location": "423/TALK"    , "narrator": "つばめ", "text": "それじゃ、ここで\nさようならですね。"},
        { "location": "425/TALK"    , "narrator": "つばめ", "text": "また気が向いたら\n来てください。"},
        { "location": "426/TALK"    , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を。"},
        { "location": "428/ACT"     , "narrator": "", "text": "なんでそんなフォーマルな感じなの？"},
        { "location": "429/TALK"    , "narrator": "つばめ", "text": "え？\nえっと、そうですね…"},
        { "location": "431/TALK"    , "narrator": "つばめ", "text": "やはり、他人のココロを\n語るわけですから、\nヘラヘラできませんし。"},
        { "location": "432/TALK"    , "narrator": "つばめ", "text": "でもやっぱり、\nあまりいつものわたし\nらしくないですよね。"},
        { "location": "433/TALK"    , "narrator": "つばめ", "text": "ちょっと堅苦しいかも\nしれませんが、我慢して\nお付き合いください。"},
        { "location": "434/TALK"    , "narrator": "つばめ", "text": "それでは早速、今回の\nクランを紹介しますね。"},
        { "location": "443/TALK"    , "narrator": "つばめ", "text": "オープンプロセス、\n0x191番地から\n0xFFF番地へ。"},
        { "location": "444/TALK"    , "narrator": "つばめ", "text": "共通意識野を経由、\n外部スフィアへ接続。"},
        { "location": "445/TALK"    , "narrator": "つばめ", "text": "EXEC_SEEK_SECTOR\n=>Link() EXT_SPHERE/."},
        { "location": "470/TALK"    , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "471/TALK"    , "narrator": "つばめ", "text": "さて――。"},
        { "location": "473/TALK"    , "narrator": "つばめ", "text": "今回、貴方に\n紹介するクランは\n<color=red>【ちとせ】</color>。"},
        { "location": "475/TALK"    , "narrator": "つばめ", "text": "2016年5月9日発症。\n場所は東京都世田谷区\nにある高等学校。"},
        { "location": "476/TALK"    , "narrator": "つばめ", "text": "発症した人の名前は、\n赤城さやか、１７歳。\nみやびさんと同い年です。"},
        { "location": "477/TALK"    , "narrator": "つばめ", "text": "ココロファイルナンバー\nE01-012-88によれば、\n今回の発症の原因は……"},
        { "location": "478/TALK"    , "narrator": "つばめ", "text": "『SNSによるいじめが\n原因で、親友が自殺、\nそのショックで発症』"},
        { "location": "479/TALK"    , "narrator": "つばめ", "text": "『彼女の加害者、そして\n守らなかった人達に同じ\n気持ちを味わってもらう』"},
        { "location": "480/TALK"    , "narrator": "つばめ", "text": "『そして、みんな\nその辛い気持ちを抱えて\n自殺すればいい』"},
        { "location": "481/TALK"    , "narrator": "つばめ", "text": "――という\n想いのようです。"},
        { "location": "482/TALK"    , "narrator": "つばめ", "text": "わたしも過去に色々\nありましたから、共感\nできるところもあります。"},
        { "location": "483/TALK"    , "narrator": "つばめ", "text": "だからこそ、\nここにいるのですけど。"},
        { "location": "484/SEL"     , "narrator": "（選択肢）", "text": "関係あるんだ"},
        { "location": "485/SEL"     , "narrator": "（選択肢）", "text": "そういえば、つばめが仕切ってる理由って…"},
        { "location": "486/ACT"     , "narrator": "", "text": "関係あるんだ"},
        { "location": "487/ACT"     , "narrator": "", "text": "そういえば、つばめが仕切ってる理由って…"},
        { "location": "489/TALK"    , "narrator": "つばめ", "text": "そうです。"},
        { "location": "490/TALK"    , "narrator": "つばめ", "text": "このセクタでは、クランの\n子と一番相性がいい\nトライナリーが語ります。"},
        { "location": "491/TALK"    , "narrator": "つばめ", "text": "今回の「ちとせ」ちゃんは\nわたしが一番共感できた子\nということですね。"},
        { "location": "492/TALK"    , "narrator": "つばめ", "text": "ですから他のクランの子は\n他の人がやることに\nなると思います。"},
        { "location": "493/SEL"     , "narrator": "（選択肢）", "text": "ちとせの何に共感したの？"},
        { "location": "494/ACT"     , "narrator": "", "text": "ちとせの何に共感したの？"},
        { "location": "496/TALK"    , "narrator": "つばめ", "text": "えっと、\nそれはですね……。"},
        { "location": "497/TALK"    , "narrator": "つばめ", "text": "$handle$さんが、\nちとせちゃんと精神を\n共有できたらお話します。"},
        { "location": "498/TALK"    , "narrator": "つばめ", "text": "ですから、まずは\nちとせちゃんとの精神\n共有を頑張ってください。"},
        { "location": "499/SEL"     , "narrator": "（選択肢）", "text": "どうやって精神を共有するの？"},
        { "location": "500/ACT"     , "narrator": "", "text": "どうやって精神を共有するの？"},
        { "location": "502/TALK"    , "narrator": "つばめ", "text": "先ほどお伝えした通り、\nまずは『コネクト』の\nプロセスを行います。"},
        { "location": "503/TALK"    , "narrator": "つばめ", "text": "具体的には、\n彼女の抵抗する意志と\n戦うんです。"},
        { "location": "504/TALK"    , "narrator": "つばめ", "text": "それが終われば、\n彼女は貴方に色々\n教えてくれるでしょう。"},
        { "location": "505/TALK"    , "narrator": "つばめ", "text": "$handle$さんが\nそれを共有すれば、\n『シンクロ』完了です。"},
        { "location": "506/TALK"    , "narrator": "つばめ", "text": "『コネクト』『シンクロ』\n両方完了することで、\n貴方と彼女は繋がれます。"},
        { "location": "507/SEL"     , "narrator": "（選択肢）", "text": "そして【ちとせ】を使うことができるようになる、と"},
        { "location": "508/ACT"     , "narrator": "", "text": "そして【ちとせ】を使うことができるようになる、と"},
        { "location": "510/TALK"    , "narrator": "つばめ", "text": "そうです！\nその通りです！"},
        { "location": "511/TALK"    , "narrator": "つばめ", "text": "その時には、わたしの\nこともちょっとだけ\n教えますね。"},
        { "location": "512/TALK"    , "narrator": "つばめ", "text": "ですから、『シンクロ』\nまで完了できるように\n頑張ってください！"},
        { "location": "513/TALK"    , "narrator": "つばめ", "text": "それでは早速、\nちとせちゃんの世界に\nアクセスしますよ。"},
        { "location": "515/TALK"    , "narrator": "つばめ", "text": "$handle$さんと\nわたしとちとせちゃんに、\n素敵なココロの旅を！"}
    ]
}
