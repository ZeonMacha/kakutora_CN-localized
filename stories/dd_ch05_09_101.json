{
    "dir": "chap09/daydra/dd_ch05_09_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "9502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "乙女と悪女＜前編＞"
    },
    "entry":
    [
        { "location": "1516/TALK"  , "narrator": "神楽", "text": "さて、と…。"},
        { "location": "1517/TALK"  , "narrator": "雛", "text": "神楽ちゃーん。"},
        { "location": "1523/TALK"  , "narrator": "雛", "text": "神楽ちゃん。\nつばめちゃんだけど、\nもう帰っちゃった？"},
        { "location": "1525/TALK"  , "narrator": "神楽", "text": "あ、はい。\n今日はバイトがあるので、\n先に帰りました。"},
        { "location": "1526/TALK"  , "narrator": "雛", "text": "そっかぁ…。\n神楽ちゃんは？"},
        { "location": "1527/TALK"  , "narrator": "神楽", "text": "私は非番なので、\n今日はこのまま帰ります。"},
        { "location": "1528/TALK"  , "narrator": "雛", "text": "なにか予定あるの？"},
        { "location": "1529/TALK"  , "narrator": "神楽", "text": "いえ、まっすぐ家に帰る\nだけですけど…。"},
        { "location": "1532/TALK"  , "narrator": "雛", "text": "やったね。\nまゆちん！"},
        { "location": "1536/TALK"  , "narrator": "繭", "text": "なに？"},
        { "location": "1539/TALK"  , "narrator": "雛", "text": "神楽ちゃん、確保ー！！"},
        { "location": "1540/TALK"  , "narrator": "神楽", "text": "え？"},
        { "location": "1542/TALK"  , "narrator": "繭", "text": "はぁ…仕方ない。"},
        { "location": "1544/TALK"  , "narrator": "神楽", "text": "えぇーっ！？"},
        { "location": "1568/TALK"  , "narrator": "雛", "text": "――ってわけでね、\n電車はロマンの塊\nなんだよー。"},
        { "location": "1570/TALK"  , "narrator": "神楽", "text": "なるほど。\n普段なにも考えずに\n乗ってましたけど…。"},
        { "location": "1571/TALK"  , "narrator": "神楽", "text": "電車にも、色んなのが\nあるってことですね！"},
        { "location": "1572/TALK"  , "narrator": "雛", "text": "さっすが神楽ちゃん！\nちょっと話しただけ\nなのに、理解が早い！"},
        { "location": "1574/TALK"  , "narrator": "雛", "text": "まゆちんもさー、\nちょっとは神楽ちゃんを\n見習ってほしいよ。"},
        { "location": "1576/TALK"  , "narrator": "繭", "text": "無茶言うな。\n電車に興味は持てない。"},
        { "location": "1577/TALK"  , "narrator": "雛", "text": "もー、友達の趣味に\n興味を示すくらいの\n反応、できないかなー？"},
        { "location": "1579/TALK"  , "narrator": "神楽", "text": "繭さんの趣味は――"},
        { "location": "1581/TALK"  , "narrator": "神楽", "text": "って、愚問でした。\nＰＣですよね？"},
        { "location": "1583/TALK"  , "narrator": "雛", "text": "大雑把に言えばね。"},
        { "location": "1585/TALK"  , "narrator": "繭", "text": "…卯月さんの趣味は？"},
        { "location": "1587/TALK"  , "narrator": "雛", "text": "そそ、あたしもそれ\n聞きたかったんだよねー。"},
        { "location": "1589/TALK"  , "narrator": "神楽", "text": "うーん、ラノベとか\n絵を描くこととか、\nあとは…。"},
        { "location": "1590/TALK"  , "narrator": "雛", "text": "思ったよか多趣味！？\nっていうか、ラノベ！？"},
        { "location": "1592/TALK"  , "narrator": "神楽", "text": "はい！\nラノベ大好きなんです。"},
        { "location": "1593/TALK"  , "narrator": "繭", "text": "オンオフ派？"},
        { "location": "1595/TALK"  , "narrator": "神楽", "text": "どちらかというと\nダダマホの方が。"},
        { "location": "1596/TALK"  , "narrator": "繭", "text": "わかる。"},
        { "location": "1598/TALK"  , "narrator": "雛", "text": "待って、なんの話！？\nあたしにわかるように\n話して！"},
        { "location": "1600/TALK"  , "narrator": "神楽", "text": "ひなこさんは\nラノベって…。"},
        { "location": "1601/TALK"  , "narrator": "繭", "text": "こいつは時刻表を\n読むようなヤツだから。"},
        { "location": "1602/TALK"  , "narrator": "神楽", "text": "じゃあ、今度ひなこさんに\nオススメのラノベを\nお貸ししますね。"},
        { "location": "1604/TALK"  , "narrator": "雛", "text": "いいの？\nちょっと楽しみだよー。"},
        { "location": "1605/TALK"  , "narrator": "雛", "text": "でも、よかったー。\n神楽ちゃんが\n話しやすい子で。"},
        { "location": "1606/TALK"  , "narrator": "神楽", "text": "はい？"},
        { "location": "1607/TALK"  , "narrator": "繭", "text": "だって、フランスからの\n帰国子女なんでしょ？"},
        { "location": "1608/TALK"  , "narrator": "雛", "text": "しかもフランス行く前は\n桜花学園女子だって言うし。"},
        { "location": "1609/TALK"  , "narrator": "雛", "text": "リアルお嬢様と話すのって\n初めてだったからさ…。"},
        { "location": "1610/TALK"  , "narrator": "雛", "text": "転校してきたときは、\nすっごい緊張してたん\nだよねー。"},
        { "location": "1612/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1615/TALK"  , "narrator": "神楽", "text": "ふふっ、前の学校に\nいたときと話し方を\n変えて正解でした。"},
        { "location": "1616/TALK"  , "narrator": "雛", "text": "そうだったの？"},
        { "location": "1618/TALK"  , "narrator": "神楽", "text": "もちろんですよ。\n桜花学園女子は\nとっても厳しいんです。"},
        { "location": "1620/TALK"  , "narrator": "神楽", "text": "わたくし達生徒一人一人、\n気品あるレディに相応しい\n喋り方をしなければ…。"},
        { "location": "1621/TALK"  , "narrator": "神楽", "text": "すぐに指導対象になって、\n両親を呼ばれてしまうん\nですのよ？"},
        { "location": "1622/TALK"  , "narrator": "雛", "text": "お、おおー、\nなんか似合うかも…。"},
        { "location": "1624/TALK"  , "narrator": "神楽", "text": "ちょ、冗談ですから！"},
        { "location": "1625/TALK"  , "narrator": "繭", "text": "冗談なのはわかってる\nけど、意外と様になってて\n感動したわ。"},
        { "location": "1627/TALK"  , "narrator": "神楽", "text": "しないでください！\nツッコんでくれないと\n恥ずかしいですよぉ…。"},
        { "location": "1628/TALK"  , "narrator": "雛", "text": "あはは、照れてる\n神楽ちゃん、\nなんか可愛いかも。"},
        { "location": "1629/TALK"  , "narrator": "繭", "text": "お嬢様オーラがある人が\nやってはいけない冗談、\nということね。"},
        { "location": "1631/TALK"  , "narrator": "繭", "text": "…ところで、\n私は退散しても\nいいかしら？"},
        { "location": "1632/TALK"  , "narrator": "繭", "text": "そろそろ行かないと、\nバイトに間に合わないし。"},
        { "location": "1634/TALK"  , "narrator": "雛", "text": "じゃあ、今日はこれで\nお開きにしよっか。"},
        { "location": "1636/TALK"  , "narrator": "神楽", "text": "とっても楽しかったです。\n誘っていただいて\nありがとうございました。"},
        { "location": "1638/TALK"  , "narrator": "雛", "text": "こっちこそ\n楽しかったよー。"},
        { "location": "1640/TALK"  , "narrator": "繭", "text": "…そういえば、\n卯月さんは寮じゃ\nなかったんだっけ？"},
        { "location": "1641/TALK"  , "narrator": "神楽", "text": "はい、私は豊洲にある\nマンションで\n暮らしてるので…。"},
        { "location": "1643/TALK"  , "narrator": "雛", "text": "へー、\n意外と近いんだねー。"},
        { "location": "1644/TALK"  , "narrator": "雛", "text": "そうだ、今度おうちに\n遊び行ってもいいかなー？"},
        { "location": "1645/TALK"  , "narrator": "神楽", "text": "えっ…。"},
        { "location": "1646/TALK"  , "narrator": "雛", "text": "神楽ちゃんのお部屋が\nどんな感じなのか、\n興味あるんだー。"},
        { "location": "1648/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1649/TALK"  , "narrator": "神楽", "text": "ダメなんて言ったら、\n白けちゃうかな？"},
        { "location": "1650/TALK"  , "narrator": "神楽", "text": "でも、いいですよー、\nなんて言えるわけないし。"},
        { "location": "1652/TALK"  , "narrator": "神楽", "text": "…仕方ないか。\n断ろう…。"},
        { "location": "1701/TALK"  , "narrator": "ぴょんこ", "text": "　"},
        { "location": "1731/TALK"  , "narrator": "ぴょんこ", "text": "貴方の押しかけ女房\nぴょんこです♪"},
        { "location": "1732/SEL"   , "narrator": "", "text": "こ、こんにちは"},
        { "location": "1733/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "1734/ACT"   , "narrator": "", "text": "こ、こんにちは"},
        { "location": "1735/TALK"  , "narrator": "ぴょんこ", "text": "キョドってんなー。"},
        { "location": "1736/TALK"  , "narrator": "ぴょんこ", "text": "冗談だって\nわかって欲しいぴょん。"},
        { "location": "1737/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "1740/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪\nどうしましょうっ！"},
        { "location": "1741/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんの\n愛が重すぎるぴょん…♪"},
        { "location": "1743/SEL"   , "narrator": "", "text": "ゲートの色は元に戻ってるけど、大丈夫だったの？"},
        { "location": "1744/ACT"   , "narrator": "", "text": "ゲートの色は元に戻ってるけど、大丈夫だったの？"},
        { "location": "1746/TALK"  , "narrator": "ぴょんこ", "text": "はい！\nもちろんですよっ！"},
        { "location": "1747/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんが\n私のココロを\n落ち着かせてくれたから。"},
        { "location": "1748/TALK"  , "narrator": "ぴょんこ", "text": "それどころか、\n平常時の精神状態も\nかなり安定してますよっ。"},
        { "location": "1749/SEL"   , "narrator": "", "text": "何かあったっけ？"},
        { "location": "1750/ACT"   , "narrator": "", "text": "何かあったっけ？"},
        { "location": "1752/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこが前回、\nカミングアウトしたから\nかもしれないぴょん。"},
        { "location": "1753/SEL"   , "narrator": "", "text": "ぴょんこって、そんな影響力強いの！？"},
        { "location": "1754/ACT"   , "narrator": "", "text": "ぴょんこって、そんな影響力強いの！？"},
        { "location": "1756/TALK"  , "narrator": "ぴょんこ", "text": "言ってみただけぴょん。"},
        { "location": "1757/TALK"  , "narrator": "ぴょんこ", "text": "本当のところ、\n良く解らないんですよね。"},
        { "location": "1758/TALK"  , "narrator": "ぴょんこ", "text": "まあでもきっと、\nそのうち何か\nわかるぴょん。"},
        { "location": "1759/SEL"   , "narrator": "", "text": "適当すぎる…"},
        { "location": "1760/ACT"   , "narrator": "", "text": "適当すぎる…"},
        { "location": "1762/TALK"  , "narrator": "ぴょんこ", "text": "というわけで\n早速ですけど！"},
        { "location": "1763/TALK"  , "narrator": "ぴょんこ", "text": "今日は何して\n遊びますかっ？"},
        { "location": "1764/SEL"   , "narrator": "", "text": "ちゅーして遊ぶ"},
        { "location": "1765/SEL"   , "narrator": "", "text": "スピネルのこともうちょっと教えて"},
        { "location": "1766/SEL"   , "narrator": "", "text": "えっと…仕事は…？"},
        { "location": "1767/ACT"   , "narrator": "", "text": "ちゅーして遊ぶ"},
        { "location": "1770/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん。"},
        { "location": "1771/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんと\nぴょんこは既にジャンケン\n楽しみましたよね？"},
        { "location": "1772/TALK"  , "narrator": "ぴょんこ", "text": "これは、\n一生に一度きりの\n体験なんですよっ♪"},
        { "location": "1773/TALK"  , "narrator": "ぴょんこ", "text": "というわけで――"},
        { "location": "1776/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "1777/TALK"  , "narrator": "ぴょんこ", "text": "またしたいんですか～？"},
        { "location": "1778/TALK"  , "narrator": "ぴょんこ", "text": "もちろん何度でも\nばっちこーいですっ♪"},
        { "location": "1781/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "1782/TALK"  , "narrator": "ぴょんこ", "text": "それはそれで\n素敵なんですけどっ……"},
        { "location": "1783/TALK"  , "narrator": "ぴょんこ", "text": "せっかくですから、\nちょっとゲームでも\nしませんかっ？"},
        { "location": "1784/SEL"   , "narrator": "", "text": "どんな？"},
        { "location": "1785/ACT"   , "narrator": "", "text": "どんな？"},
        { "location": "1789/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\n今キスチケを$pyonko_kissticket$枚\n持ってますよね？"},
        { "location": "1790/TALK"  , "narrator": "ぴょんこ", "text": "今からぴょんこと\nジャンケンして勝ったら\n更に１枚進呈します♪"},
        { "location": "1791/TALK"  , "narrator": "ぴょんこ", "text": "ですけど、\n負けたら１枚没収です。"},
        { "location": "1795/TALK"  , "narrator": "ぴょんこ", "text": "ジャンケンですっ！"},
        { "location": "1796/TALK"  , "narrator": "ぴょんこ", "text": "まあ、ここで一発\nちゅーしても\nいいんですけど――"},
        { "location": "1797/TALK"  , "narrator": "ぴょんこ", "text": "ジャンケンして勝てば、\n更に素敵な【キスチケ】を\nゲットできますよっ！"},
        { "location": "1798/TALK"  , "narrator": "ぴょんこ", "text": "【キスチケ】は\n今回は使えませんが、\n３枚貯めると、なんと！"},
        { "location": "1799/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんの\nお好みの服を着て\nちゅーしちゃいます♪"},
        { "location": "1800/TALK"  , "narrator": "ぴょんこ", "text": "しかも、ちゅーそのものも\n超アップグレード\nされちゃいますよ！"},
        { "location": "1801/TALK"  , "narrator": "ぴょんこ", "text": "さあ、どうしますかっ？"},
        { "location": "1802/SEL"   , "narrator": "", "text": "今、ちゅーで結構です"},
        { "location": "1803/SEL"   , "narrator": "", "text": "キスチケください"},
        { "location": "1804/ACT"   , "narrator": "", "text": "今、ちゅーで結構です"},
        { "location": "1805/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん。"},
        { "location": "1806/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんって\nもしかして、現金以外は\n信用しないタイプですか？"},
        { "location": "1807/TALK"  , "narrator": "ぴょんこ", "text": "実はぴょんこ、\nそういう人が好きです！"},
        { "location": "1808/TALK"  , "narrator": "ぴょんこ", "text": "では、約束通り\nちゅーしちゃいますね♪"},
        { "location": "1809/TALK"  , "narrator": "ぴょんこ", "text": "でもでも、\nちょっとだけですからね？"},
        { "location": "1844/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "1847/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "1853/TALK"  , "narrator": "ぴょんこ", "text": "柔らかくて\n温かくて……\nとっても素敵でした♪"},
        { "location": "1855/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんって\nお上手なんですねっ！"},
        { "location": "1857/ACT"   , "narrator": "", "text": "キスチケください"},
        { "location": "1858/TALK"  , "narrator": "ぴょんこ", "text": "ですよねーっ！"},
        { "location": "1859/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは\nオトナの世界を知ってる\n素敵な方ですねっ！"},
        { "location": "1860/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ早速、\nジャンケンしましょう♪"},
        { "location": "1887/TALK"  , "narrator": "ぴょんこ", "text": "ふわぁっ！\n負けちゃいました…。"},
        { "location": "1888/TALK"  , "narrator": "ぴょんこ", "text": "約束通り、\nキスチケ１枚進呈ぴょん♪"},
        { "location": "1896/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの\n勝ちでーすっ♪"},
        { "location": "1897/TALK"  , "narrator": "ぴょんこ", "text": "約束通り、\nキスチケ１枚没収ぴょん♪"},
        { "location": "1902/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの\n勝ちでーすっ♪"},
        { "location": "1903/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\nプレゼントはナシ！！"},
        { "location": "1909/TALK"  , "narrator": "ぴょんこ", "text": "ふぅ……\nとっても楽しかったです♪"},
        { "location": "1910/TALK"  , "narrator": "ぴょんこ", "text": "また楽しいこと\nしましょうねっ！\nふふっ♪"},
        { "location": "1914/TALK"  , "narrator": "ぴょんこ", "text": "というわけで――"},
        { "location": "1915/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんを\nいじくり倒して\n満たされましたので！！"},
        { "location": "1917/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは今日も\n元気にお仕事したいと\n思いまーす♪"},
        { "location": "1918/ACT"   , "narrator": "", "text": "スピネルのこともうちょっと教えて"},
        { "location": "1921/TALK"  , "narrator": "ぴょんこ", "text": "もちろんですっ！\nばっちこーい！"},
        { "location": "1922/SEL"   , "narrator": "", "text": "スピネルは神楽のお母さんのクランだよね？"},
        { "location": "1923/ACT"   , "narrator": "", "text": "スピネルは神楽のお母さんのクランだよね？"},
        { "location": "1925/TALK"  , "narrator": "ぴょんこ", "text": "はいっ！\nみさみさのクランです♪"},
        { "location": "1926/SEL"   , "narrator": "", "text": "いつ誰がクランにしたの？"},
        { "location": "1927/ACT"   , "narrator": "", "text": "いつ誰がクランにしたの？"},
        { "location": "1929/TALK"  , "narrator": "ぴょんこ", "text": "結構前になりますけど、\n“彼ら”によって\nクラン化されました。"},
        { "location": "1930/TALK"  , "narrator": "ぴょんこ", "text": "彼らは、現実の私が\nつばめさんを壊す力を\n持てるよう、そして――"},
        { "location": "1931/TALK"  , "narrator": "ぴょんこ", "text": "作戦遂行の人質として、\nみさみさからクランを\n抽出したんです。"},
        { "location": "1932/TALK"  , "narrator": "ぴょんこ", "text": "知ってますか？"},
        { "location": "1933/TALK"  , "narrator": "ぴょんこ", "text": "トライナリーがクランを\n装備する際の相性において\n最強は親子関係です。"},
        { "location": "1934/TALK"  , "narrator": "ぴょんこ", "text": "理由は、言わずとも\nわかりますよね？"},
        { "location": "1935/TALK"  , "narrator": "ぴょんこ", "text": "とは言っても、冷え切った\n親子関係とかもありますし\n一概には言えませんけど。"},
        { "location": "1936/TALK"  , "narrator": "ぴょんこ", "text": "とにかく。"},
        { "location": "1937/TALK"  , "narrator": "ぴょんこ", "text": "みさみさは、自らの力で\n神楽を護れるならと、\n彼らとの契約を承諾。"},
        { "location": "1938/TALK"  , "narrator": "ぴょんこ", "text": "そしてクラン発症を\n自分から受け入れました。"},
        { "location": "1939/TALK"  , "narrator": "ぴょんこ", "text": "まあ、結果はご存知かと\n思いますけど――"},
        { "location": "1940/TALK"  , "narrator": "ぴょんこ", "text": "ある意味においては\n強力に護られ、一方では\n完膚なきまで破壊された。"},
        { "location": "1941/TALK"  , "narrator": "ぴょんこ", "text": "そしてスピネルは、\n彼らにしか処理できない\nよう鍵を掛けられました。"},
        { "location": "1942/TALK"  , "narrator": "ぴょんこ", "text": "それを、\n$handle$さんが\n解放してくれたんです♪"},
        { "location": "1943/TALK"  , "narrator": "ぴょんこ", "text": "まあ、解放とは言っても\n“彼ら”から千羽鶴に権限\n委譲されただけですけど。"},
        { "location": "1944/TALK"  , "narrator": "ぴょんこ", "text": "とはいえ、\nぴょんこはこれを\n悲観視していません。"},
        { "location": "1945/TALK"  , "narrator": "ぴょんこ", "text": "千羽鶴の方が、\n彼らより\n１００万倍マシですから！"},
        { "location": "1946/TALK"  , "narrator": "ぴょんこ", "text": "現実の私は千羽鶴を\n相当警戒してますけど、\nぴょんこは違っていて――"},
        { "location": "1947/TALK"  , "narrator": "ぴょんこ", "text": "そのギャップも、\nもしかすると現実の私が\n悩む原因かもしれません。"},
        { "location": "1948/SEL"   , "narrator": "", "text": "スピネルについてもっと知りたい"},
        { "location": "1949/SEL"   , "narrator": "", "text": "美佐子さんと神楽についてもっと知りたい"},
        { "location": "1950/ACT"   , "narrator": "", "text": "スピネルについてもっと知りたい"},
        { "location": "1951/TALK"  , "narrator": "ぴょんこ", "text": "はいはい♪"},
        { "location": "1955/TALK"  , "narrator": "ぴょんこ", "text": "スピネルは、\nみさみさが大好きだった\n宝石の名前です。"},
        { "location": "1956/TALK"  , "narrator": "ぴょんこ", "text": "正確には\nブラックスピネル。\n和名、尖晶石ですっ。"},
        { "location": "1957/TALK"  , "narrator": "ぴょんこ", "text": "かなり力を持っている\nパワーストーン\nなんですけど――"},
        { "location": "1958/TALK"  , "narrator": "ぴょんこ", "text": "その効能もあって、\n私の勝負時には必ず\n持たせてくれてました。"},
        { "location": "1959/TALK"  , "narrator": "ぴょんこ", "text": "受験の時も、\nオーディションの時も、\nライブの時も。"},
        { "location": "1960/TALK"  , "narrator": "ぴょんこ", "text": "スピネルの効能は\n“自己実現”ですから！"},
        { "location": "1961/TALK"  , "narrator": "ぴょんこ", "text": "クランとしてのスピネルも\n同じように、自己実現の\n想いを持っています。"},
        { "location": "1962/TALK"  , "narrator": "ぴょんこ", "text": "だから、コネクトしてる\n私は、更にプラス補正が\nかかるんですよね。"},
        { "location": "1963/TALK"  , "narrator": "ぴょんこ", "text": "想い描いた通りの\n未来を実現しやすく\nなるからです。"},
        { "location": "1964/TALK"  , "narrator": "ぴょんこ", "text": "まあ、諸刃の剣では\nあるんですけどね。"},
        { "location": "1965/TALK"  , "narrator": "ぴょんこ", "text": "ネガティブなビジョンも\n“自己実現”\nしちゃいますから。"},
        { "location": "1966/TALK"  , "narrator": "ぴょんこ", "text": "あと、戦闘時の最も強力な\nスキルは、意外かも\nしれませんが防御です。"},
        { "location": "1967/TALK"  , "narrator": "ぴょんこ", "text": "スピネルの大きな腕、\n何の現れか\nわかりますか？"},
        { "location": "1968/TALK"  , "narrator": "ぴょんこ", "text": "【赤ちゃんを抱きしめて\n護る、お母さんの想い】\nなんですよ♪"},
        { "location": "1969/TALK"  , "narrator": "ぴょんこ", "text": "ちょっとだけ\nイイハナシだと\n思いませんかっ？"},
        { "location": "1973/TALK"  , "narrator": "ぴょんこ", "text": "そんな感じでしょうか！"},
        { "location": "1974/ACT"   , "narrator": "", "text": "美佐子さんと神楽についてもっと知りたい"},
        { "location": "1975/TALK"  , "narrator": "ぴょんこ", "text": "はいはい♪"},
        { "location": "1980/TALK"  , "narrator": "ぴょんこ", "text": "紹介しま～す♪\n私の母、\n卯月美佐子ですっ！"},
        { "location": "1981/SEL"   , "narrator": "", "text": "綺麗な人だね"},
        { "location": "1982/SEL"   , "narrator": "", "text": "神楽はお母さん似だったんだね"},
        { "location": "1983/SEL"   , "narrator": "", "text": "え、めちゃ好みなんですけど！"},
        { "location": "1984/ACT"   , "narrator": "", "text": "綺麗な人だね"},
        { "location": "1985/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "1986/ACT"   , "narrator": "", "text": "神楽はお母さん似だったんだね"},
        { "location": "1987/TALK"  , "narrator": "ぴょんこ", "text": "ほんとですかっ！"},
        { "location": "1988/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこはずっと、母の\nように綺麗になりたいって\n思ってきたんで！"},
        { "location": "1989/TALK"  , "narrator": "ぴょんこ", "text": "とっても嬉しいです♪"},
        { "location": "1990/ACT"   , "narrator": "", "text": "え、めちゃ好みなんですけど！"},
        { "location": "1991/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん"},
        { "location": "1992/TALK"  , "narrator": "ぴょんこ", "text": "みさみさにジェラシー！！"},
        { "location": "1993/TALK"  , "narrator": "ぴょんこ", "text": "いや、いっそ\n$handle$さんを\n亡き者にしてしまえば……"},
        { "location": "1994/SEL"   , "narrator": "", "text": "ごめんなさい出来心です"},
        { "location": "1995/SEL"   , "narrator": "", "text": "ごめんなさい本気です"},
        { "location": "1996/ACT"   , "narrator": "", "text": "ごめんなさい出来心です"},
        { "location": "1997/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん。"},
        { "location": "1998/ACT"   , "narrator": "", "text": "ごめんなさい本気です"},
        { "location": "1999/TALK"  , "narrator": "ぴょんこ", "text": "そっかー、本気かー。"},
        { "location": "2000/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ仕方ないぴょん。"},
        { "location": "2001/TALK"  , "narrator": "ぴょんこ", "text": "みさみさは綺麗だし、\n悔しいけどわかる。"},
        { "location": "2002/TALK"  , "narrator": "ぴょんこ", "text": "それにしても、\n$handle$さんが\n年上スキーだったとは。"},
        { "location": "2003/TALK"  , "narrator": "ぴょんこ", "text": "思わぬところで\nカミングアウト\nしちゃいましたねっ！"},
        { "location": "2006/TALK"  , "narrator": "ぴょんこ", "text": "みさみさの趣味は、\n占いと恋愛相談と\nネットサーフでした♪"},
        { "location": "2007/TALK"  , "narrator": "ぴょんこ", "text": "わりとディープに\nネットでお悩み相談とか\nやってたりしていて。"},
        { "location": "2008/TALK"  , "narrator": "ぴょんこ", "text": "そういえば、ぴょんこの\nネットスラングの幾つかも\nみさみさ伝授でした。"},
        { "location": "2009/SEL"   , "narrator": "", "text": "えっ？\n美佐子さんって何歳？"},
        { "location": "2010/ACT"   , "narrator": "", "text": "えっ？\n美佐子さんって何歳？"},
        { "location": "2012/TALK"  , "narrator": "ぴょんこ", "text": "確か今年で\n３８歳ですよ？"},
        { "location": "2013/TALK"  , "narrator": "ぴょんこ", "text": "あ、あとですね！\nぴょんこの名付け親でも\nあるんです♪"},
        { "location": "2014/SEL"   , "narrator": "", "text": "マジか…"},
        { "location": "2015/ACT"   , "narrator": "", "text": "マジか…"},
        { "location": "2017/TALK"  , "narrator": "ぴょんこ", "text": "はい！\n私がすごく小さかった頃\nウサギが大好きで。"},
        { "location": "2018/TALK"  , "narrator": "ぴょんこ", "text": "いつも家の中で\nピョンピョン♪って\n跳ねてたんです。"},
        { "location": "2019/TALK"  , "narrator": "ぴょんこ", "text": "それを見たみさみさが、\nぴょんこちゃんって\n呼ぶようになって。"},
        { "location": "2020/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこも\nそれが気に入っちゃって。"},
        { "location": "2021/TALK"  , "narrator": "ぴょんこ", "text": "３年生くらいまで、母は\n気まぐれに、ぴょんこ\nちゃんって呼んでました。"},
        { "location": "2022/SEL"   , "narrator": "", "text": "そんな思い出があったんだね"},
        { "location": "2023/ACT"   , "narrator": "", "text": "そんな思い出があったんだね"},
        { "location": "2025/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "2029/TALK"  , "narrator": "ぴょんこ", "text": "とまあ、\nそんなところでしょうか！"},
        { "location": "2031/TALK"  , "narrator": "ぴょんこ", "text": "さて、色々お話して\n満たされましたので！！"},
        { "location": "2032/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは今日も\n元気にお仕事したいと\n思いまーす♪"},
        { "location": "2033/ACT"   , "narrator": "", "text": "えっと…仕事は…？"},
        { "location": "2034/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん。"},
        { "location": "2035/TALK"  , "narrator": "ぴょんこ", "text": "世の中休息が\n必要なときもあるぴょん。"},
        { "location": "2036/TALK"  , "narrator": "ぴょんこ", "text": "まあいいです。\n$handle$さんが\nそれをお望みなら。"},
        { "location": "2038/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\n扉をまわすぴょん。"},
        { "location": "2042/TALK"  , "narrator": "ぴょんこ", "text": "オープンプロセス、\n2xECA番地から\n2x11D番地へ。"},
        { "location": "2066/TALK"  , "narrator": "ぴょんこ", "text": "シーク完了ぴょん！"},
        { "location": "2067/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\n今回の心の葛藤は…？"},
        { "location": "2069/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "2070/TALK"  , "narrator": "ぴょんこ", "text": "まあ、\nこんなものですよねー。"},
        { "location": "2071/SEL"   , "narrator": "", "text": "どんなだった？"},
        { "location": "2072/ACT"   , "narrator": "", "text": "どんなだった？"},
        { "location": "2074/TALK"  , "narrator": "ぴょんこ", "text": "本邦初！"},
        { "location": "2075/TALK"  , "narrator": "ぴょんこ", "text": "とっても女の子らしい\n平和な悩みでした～♪"},
        { "location": "2076/TALK"  , "narrator": "ぴょんこ", "text": "あらすじ！"},
        { "location": "2077/TALK"  , "narrator": "ぴょんこ", "text": "秘密だらけの特務機関少女\nぴょんこは、悩んでいた！"},
        { "location": "2078/TALK"  , "narrator": "ぴょんこ", "text": "お友達に部屋を見られたら\n自分がスパイだって\nバレちゃいますっ！"},
        { "location": "2079/TALK"  , "narrator": "ぴょんこ", "text": "でも、部屋に招待して\n遊びたいお年頃…♪"},
        { "location": "2080/TALK"  , "narrator": "ぴょんこ", "text": "それに、\n断ったらお友達に\n嫌われちゃうかも……。"},
        { "location": "2081/TALK"  , "narrator": "ぴょんこ", "text": "そんなの、\nぴょんこはいやなのっ！"},
        { "location": "2082/TALK"  , "narrator": "ぴょんこ", "text": "なんとかして断らずに、\nかつ部屋にも入れずに、\n済ませられないかすぃら…"},
        { "location": "2083/SEL"   , "narrator": "", "text": "色々突っ込み処満載だけど把握はした"},
        { "location": "2084/SEL"   , "narrator": "", "text": "乙女の悩みだね"},
        { "location": "2085/SEL"   , "narrator": "", "text": "神楽でもそういう事、思うんだね"},
        { "location": "2086/ACT"   , "narrator": "", "text": "色々突っ込み処満載だけど把握はした"},
        { "location": "2087/TALK"  , "narrator": "ぴょんこ", "text": "把握さえしてくれれば\n他はどうでもいいです♪"},
        { "location": "2088/ACT"   , "narrator": "", "text": "乙女の悩みだね"},
        { "location": "2089/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは\n乙女ですよっ♪"},
        { "location": "2090/ACT"   , "narrator": "", "text": "神楽でもそういう事、思うんだね"},
        { "location": "2091/TALK"  , "narrator": "ぴょんこ", "text": "私をなんだと\n思ってたんですか？"},
        { "location": "2093/TALK"  , "narrator": "ぴょんこ", "text": "というわけでですね、\n$handle$さんに\nお願いしたいのは――"},
        { "location": "2094/TALK"  , "narrator": "ぴょんこ", "text": "現実の私が雛ちゃんたちを\nお断りしないように、心を\n落ち着かせてください！"},
        { "location": "2095/SEL"   , "narrator": "", "text": "えっ、でもそうすると家に上がられてしまうのでは…？"},
        { "location": "2096/ACT"   , "narrator": "", "text": "えっ、でもそうすると家に上がられてしまうのでは…？"},
        { "location": "2098/TALK"  , "narrator": "ぴょんこ", "text": "大丈夫ですよ。"},
        { "location": "2099/SEL"   , "narrator": "", "text": "お母さん、見られても大丈夫なの？"},
        { "location": "2100/ACT"   , "narrator": "", "text": "お母さん、見られても大丈夫なの？"},
        { "location": "2102/TALK"  , "narrator": "ぴょんこ", "text": "ああっ、さすがですね\n$handle$さん！\n痛いとこ突いてきます！"},
        { "location": "2104/TALK"  , "narrator": "ぴょんこ", "text": "まあ実際問題としては、\nバレないように部屋まで\n行ければいいんですよっ。"},
        { "location": "2106/TALK"  , "narrator": "ぴょんこ", "text": "現実の私が\nビビりなだけですぴょん。"},
        { "location": "2107/SEL"   , "narrator": "", "text": "部屋だって汚部屋だし、ほんとに入れちゃって大丈夫？？"},
        { "location": "2108/SEL"   , "narrator": "", "text": "でもやっぱり、$me$より先に誰かに神楽の部屋に入られるのはいや！"},
        { "location": "2109/ACT"   , "narrator": "", "text": "部屋だって汚部屋だし、ほんとに入れちゃって大丈夫？？"},
        { "location": "2110/TALK"  , "narrator": "ぴょんこ", "text": "何処の情報だよおい！"},
        { "location": "2111/TALK"  , "narrator": "ぴょんこ", "text": "失礼ですね！\n毎日家政婦さんが\n片付けてますからっ！"},
        { "location": "2112/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこを\n見くびらないでください。"},
        { "location": "2113/ACT"   , "narrator": "", "text": "でもやっぱり、$me$より先に誰かに神楽の部屋に入られるのはいや！"},
        { "location": "2115/TALK"  , "narrator": "ぴょんこ", "text": "ちょっ！！\nそれって！！！"},
        { "location": "2116/TALK"  , "narrator": "ぴょんこ", "text": "一生誰も入れさせない\nつもりですかっ！！"},
        { "location": "2117/SEL"   , "narrator": "", "text": "しゅん……"},
        { "location": "2118/ACT"   , "narrator": "", "text": "しゅん……"},
        { "location": "2120/TALK"  , "narrator": "ぴょんこ", "text": "あっ、やばっ！"},
        { "location": "2121/TALK"  , "narrator": "ぴょんこ", "text": "ブラックジョークが\n強烈すぎたぴょん！！"},
        { "location": "2123/TALK"  , "narrator": "ぴょんこ", "text": "大丈夫大丈夫！"},
        { "location": "2124/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんも\nいずれ私の部屋に\n来れるようになりますっ♪"},
        { "location": "2126/TALK"  , "narrator": "ぴょんこ", "text": "なりますっ♪\nなりますっ♪"},
        { "location": "2127/SEL"   , "narrator": "", "text": "うん"},
        { "location": "2128/ACT"   , "narrator": "", "text": "うん"},
        { "location": "2131/TALK"  , "narrator": "ぴょんこ", "text": "ふぅ……"},
        { "location": "2133/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\n今回も元気に心のメンテを\nしちゃってくださいね！"},
        { "location": "2134/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこと\n$handle$さんに\n素敵なココロの旅を♪"},
        { "location": "2150/TALK"  , "narrator": "ぴょんこ", "text": "な、なに！？"},
        { "location": "2151/SEL"   , "narrator": "", "text": "これは……"},
        { "location": "2152/ACT"   , "narrator": "", "text": "これは……"},
        { "location": "2154/TALK"  , "narrator": "ぴょんこ", "text": "もう１回っ！"},
        { "location": "2167/TALK"  , "narrator": "ぴょんこ", "text": "どういうこと！？"},
        { "location": "2170/TALK"  , "narrator": "ぴょんこ", "text": "きゃあああっ！！"},
        { "location": "2171/SEL"   , "narrator": "", "text": "ぴょんこ！！"},
        { "location": "2172/ACT"   , "narrator": "", "text": "ぴょんこ！！"},
        { "location": "2176/TALK"  , "narrator": "ぴょんこ", "text": "またっ…！！"},
        { "location": "2177/TALK"  , "narrator": "ぴょんこ", "text": "なにこれ！\nちょっ……！？\n聞いてないんですけど！"},
        { "location": "2178/SEL"   , "narrator": "", "text": "やっぱり前回から何かおかしくなってたんじゃ…"},
        { "location": "2179/ACT"   , "narrator": "", "text": "やっぱり前回から何かおかしくなってたんじゃ…"},
        { "location": "2181/TALK"  , "narrator": "つばめ", "text": "ぴょんこちゃん！！"},
        { "location": "2183/TALK"  , "narrator": "ぴょんこ", "text": "えっ！？"},
        { "location": "2192/TALK"  , "narrator": "ぴょんこ", "text": "つばめさんっ！？"},
        { "location": "2193/SEL"   , "narrator": "", "text": "つばめ！？なんでここに！"},
        { "location": "2194/ACT"   , "narrator": "", "text": "つばめ！？なんでここに！"},
        { "location": "2196/TALK"  , "narrator": "つばめ", "text": "話は後だよ！"},
        { "location": "2197/TALK"  , "narrator": "つばめ", "text": "急がないと神楽ちゃんの\nココロが、自分の生んだ\nクランに壊されちゃう！"},
        { "location": "2198/TALK"  , "narrator": "ぴょんこ", "text": "どういうことか\nちゃんと解るように\n説明してっ！"},
        { "location": "2202/TALK"  , "narrator": "ぴょんこ", "text": "きゃあっ！！"},
        { "location": "2203/TALK"  , "narrator": "つばめ", "text": "ちゃんとお話\nしてあげたいけど――"},
        { "location": "2204/TALK"  , "narrator": "つばめ", "text": "まずは今暴れてる\nクランの子たちを\n何とかしなくちゃ！"},
        { "location": "2205/TALK"  , "narrator": "つばめ", "text": "わたしも一緒に戦うから！\nはやくっ！"},
        { "location": "2206/SEL"   , "narrator": "", "text": "$me$も協力する。今はつばめに従おう"},
        { "location": "2207/ACT"   , "narrator": "", "text": "$me$も協力する。今はつばめに従おう"},
        { "location": "2212/TALK"  , "narrator": "ぴょんこ", "text": "わ、わかりましたっ。"},
        { "location": "2214/TALK"  , "narrator": "ぴょんこ", "text": "収束したら、ちゃんと\n何が起こってるのか\n教えてくださいね！"},
        { "location": "2215/TALK"  , "narrator": "つばめ", "text": "もちろんだよ！"},
        { "location": "2218/TALK"  , "narrator": "つばめ", "text": "いくよっ！！"},
        { "location": "1503/DIALOG", "narrator": "Dialog_EventData", "text": "<color=green>5月16日　4:02 PM</color>\nとある平日の放課後、付属学園高等部神楽の教室にて"},
        { "location": "1666/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1668/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1670/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1672/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1674/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1811/DIALOG", "narrator": "Dialog_Notice", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=red>\nOKボタンを押すと、この選択は確定します。プレイの有無にかかわらず、以後やり直しはできなくなります。\n</color>\n\nここでOKを押す前にアプリを終了（タスクキル）すれば、ギリギリキャンセル可能です。"},
        { "location": "1832/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "1851/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "1866/DIALOG", "narrator": "Dialog_Notice", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=red>\nOKボタンを押すと、この選択は確定します。プレイの有無にかかわらず、以後やり直しはできなくなります。\n</color>\n以降ジャンケン終了までの間、通信環境が悪い場所などでの継続はお薦めしません。\n\nここでOKを押す前にアプリを終了（タスクキル）すれば、ギリギリキャンセル可能です。"},
        { "location": "1890/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=green>【キスチケ】</color>を\n１枚ゲットしました！"},
        { "location": "1899/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=green>【キスチケ】</color>を\n１枚失いました…。"}
    ]
