        { "location": "7/SCENARIO", "narrator": "", "text": "670_遠くて近い約束"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "おぼえているかしら？"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "私がきっといつか"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "貴方を見つけてみせるって言ったこと"},
        { "location": "36/SEL"    , "narrator": "", "text": "そんなこともあったね"},
        { "location": "37/SEL"    , "narrator": "", "text": "あー、はい"},
        { "location": "38/SEL"    , "narrator": "", "text": "そうだっけ"},
        { "location": "39/ACT"    , "narrator": "", "text": "そんなこともあったね"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "憶えててくれたのね！"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "さすが$handle$だわvvvv"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "うれしい//////////////////"},
        { "location": "53/ACT"    , "narrator": "", "text": "あー、はい"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "気のないお返事ね！"},
        { "location": "55/ACT"    , "narrator": "", "text": "そうだっけ"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "ひどいわ"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "憶えてないのね・・・"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "それでね"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "絶対に私は見つけることができると信じてるわ"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "私、ちゃんと$handle$とお話しできるかしら"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "それがとても不安なの"},
        { "location": "66/SEL"    , "narrator": "", "text": "$handle$がリードするよ"},
        { "location": "67/SEL"    , "narrator": "", "text": "筆談でも大丈夫だよ"},
        { "location": "68/SEL"    , "narrator": "", "text": "ちゃんと話せるよ"},
        { "location": "69/ACT"    , "narrator": "", "text": "$handle$がリードするよ"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "やだ////////////////////////"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "なんだかカッコいいわ/////////////"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "王子様みたいねvvvvv"},
        { "location": "73/ACT"    , "narrator": "", "text": "筆談でも大丈夫だよ"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "できたら"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "ちゃんと目を見て自分の声でお話したいのよ？"},
        { "location": "78/ACT"    , "narrator": "", "text": "ちゃんと話せるよ"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "だと"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "いいな・・・"},
        { "location": "84/SEL"    , "narrator": "", "text": "じゃあひとつ、提案"},
        { "location": "85/ACT"    , "narrator": "", "text": "じゃあひとつ、提案"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "なあに？"},
        { "location": "88/SEL"    , "narrator": "", "text": "この前みたいに音声ファイルをもらえる？"},
        { "location": "89/ACT"    , "narrator": "", "text": "この前みたいに音声ファイルをもらえる？"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "音声ファイルを？"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "何もしないよりはいいわ"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "そうしたら実際会った時も"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "お話"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "できるかもしれないわよね？"},
        { "location": "99/SEL"    , "narrator": "", "text": "もちろん"},
        { "location": "100/SEL"   , "narrator": "", "text": "たぶんね"},
        { "location": "101/SEL"   , "narrator": "", "text": "気休めだけど"},
        { "location": "102/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "きっと"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "がんばるわ"},
        { "location": "107/ACT"   , "narrator": "", "text": "たぶんね"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "直接会うのとは違うかもしれないけど・・・"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "でも、少しは練習になるわよね"},
        { "location": "110/ACT"   , "narrator": "", "text": "気休めだけど"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "でもそんな言い方ないと思うわ・・・"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "じゃあ、これからいっぱい録音して送るようにするわね？"},
        { "location": "117/SEL"   , "narrator": "", "text": "待ってるね"},
        { "location": "118/ACT"   , "narrator": "", "text": "待ってるね"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "よろしくお願いします。"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "えっとね・・・"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "早速作ってみたの"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "聞いてちょうだい"},
        { "location": "128/TALK"  , "narrator": "ボイスメール", "text": "坂道で手を振って"},
