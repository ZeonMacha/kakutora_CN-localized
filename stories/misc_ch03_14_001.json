    [
        { "location": "7/SCENARIO", "narrator": "", "text": "000_コーンスープ"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "こっちでは何かあったら"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "コーンスープが出てくる気がするの"},
        { "location": "35/SEL"    , "narrator": "", "text": "そうなの？"},
        { "location": "36/SEL"    , "narrator": "", "text": "いや、意味わからん"},
        { "location": "37/SEL"    , "narrator": "", "text": "おもてなしの気持ちだから"},
        { "location": "38/ACT"    , "narrator": "", "text": "そうなの？"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "私の周りだけなのかしら？"},
        { "location": "40/ACT"    , "narrator": "", "text": "いや、意味わからん"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "どう説明すればいいのかしら"},
        { "location": "42/ACT"    , "narrator": "", "text": "おもてなしの気持ちだから"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "そうなのねｖｖｖｖｖ"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "って"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "本当なのかしら？"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "えっとね"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "日本だとスープっていえばコーンスープって感じがするのよね"},
        { "location": "52/SEL"    , "narrator": "", "text": "自販機でも売ってるしね"},
        { "location": "53/SEL"    , "narrator": "", "text": "コンソメとかもあるよ"},
        { "location": "54/SEL"    , "narrator": "", "text": "ガブの作ったスープが飲みたいな"},
        { "location": "55/ACT"    , "narrator": "", "text": "自販機でも売ってるしね"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "そういえば"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "売っているわね"},
        { "location": "58/ACT"    , "narrator": "", "text": "コンソメとかもあるよ"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "でも圧倒的にコーンスープ率が高いのよ"},
        { "location": "62/ACT"    , "narrator": "", "text": "ガブの作ったスープが飲みたいな"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "あらｖｖｖｖ"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナにだったら"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "いつでも作ってあげるわよｖｖｖｖ"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "コーンスープ"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "嫌いじゃないし"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "おいしいと思うんだけど"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "他のスープも飲みたいって思う時もあるのよ"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "あ"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "別に不満があるわけじゃないのよ"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "そこは誤解しないでちょうだいね"}
    ]
}
