        { "location": "3229/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "3231/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "3233/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "3239/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "3241/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "3243/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "3246/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "3247/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "3249/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "3250/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "3252/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "3253/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "3256/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "3257/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "3267/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "3268/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "3269/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "3271/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "3272/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "3273/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "3276/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "3277/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "3279/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "3282/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "3283/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "3285/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "3286/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "3287/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "3294/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "3295/TALK", "narrator": "神楽", "text": "ありえネー"}
    ]
}
