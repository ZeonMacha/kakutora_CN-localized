{
    "dir": "chap13/daydra/dd_ch02_13_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "13205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "子供の頃の憧れ＜後編＞"
    },
    "entry":
    [
        { "location": "441/SCENARIO", "narrator": "", "text": "魔法少女になろうよ"},
        { "location": "470/TALK"    , "narrator": "アーヤ", "text": "…やっぱり――"},
        { "location": "471/TALK"    , "narrator": "アーヤ", "text": "やってみたいかも。"},
        { "location": "472/TALK"    , "narrator": "アーヤ", "text": "こういう機会でも\nないと、こんなこと\n絶対できないし。"},
        { "location": "475/TALK"    , "narrator": "アーヤ", "text": "でも…。"},
        { "location": "476/TALK"    , "narrator": "ガブリエラ", "text": "ああもう！\nあの二人は\nいつ来るのよ！？"},
        { "location": "479/TALK"    , "narrator": "みやび", "text": "ガブちゃん、卯月達が\nやりたい言うとは\n限らんがよ？"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "そこは先輩命令よ。\nそれとも、みやびが\nやってくれるの？"},
        { "location": "483/TALK"    , "narrator": "みやび", "text": "後輩に花を持たせる\nことも大切やね。"},
        { "location": "484/TALK"    , "narrator": "ガブリエラ", "text": "そういうことよ。"},
        { "location": "486/TALK"    , "narrator": "アーヤ", "text": "…この空気で言うのは\n難しいかも。"},
        { "location": "487/SEL"     , "narrator": "", "text": "アーヤ、戦ってくれ！"},
        { "location": "488/SEL"     , "narrator": "", "text": "可愛いところ見せてくれ！"},
        { "location": "489/ACT"     , "narrator": "", "text": "アーヤ、戦ってくれ！"},
        { "location": "505/TALK"    , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "506/TALK"    , "narrator": "アーヤ", "text": "これは戦い(｀ヘ´)"},
        { "location": "507/TALK"    , "narrator": "アーヤ", "text": "恥ずかしいとか"},
        { "location": "508/TALK"    , "narrator": "アーヤ", "text": "考えるのがおかしいわね"},
        { "location": "509/TALK"    , "narrator": "アーヤ", "text": "後押しありがとう(^^"},
        { "location": "510/TALK"    , "narrator": "アーヤ", "text": "私"},
        { "location": "511/TALK"    , "narrator": "アーヤ", "text": "戦うわ！"},
        { "location": "512/ACT"     , "narrator": "", "text": "可愛いところ見せてくれ！"},
        { "location": "528/TALK"    , "narrator": "アーヤ", "text": "工ｴｴｪｪ(´д｀)ｪｪｴｴ工"},
        { "location": "529/TALK"    , "narrator": "アーヤ", "text": "そこは"},
        { "location": "530/TALK"    , "narrator": "アーヤ", "text": "かっこいいところ見せてくれ"},
        { "location": "531/TALK"    , "narrator": "アーヤ", "text": "とか"},
        { "location": "532/TALK"    , "narrator": "アーヤ", "text": "別の言い方あるでしょ！？(´o｀；"},
        { "location": "534/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "535/TALK"    , "narrator": "アーヤ", "text": "メルティは魔法少女みたいだし"},
        { "location": "537/TALK"    , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "538/TALK"    , "narrator": "アーヤ", "text": "可愛くやらないと(*^^*)"},
        { "location": "539/TALK"    , "narrator": "アーヤ", "text": "可愛くなるように"},
        { "location": "540/TALK"    , "narrator": "アーヤ", "text": "頑張るわ！(^ε^)-☆!!"},
        { "location": "552/TALK"    , "narrator": "アーヤ", "text": "…よし！"},
        { "location": "553/TALK"    , "narrator": "アーヤ", "text": "私、やるわ。"},
        { "location": "559/TALK"    , "narrator": "みやび", "text": "おっ！？"},
        { "location": "560/TALK"    , "narrator": "ガブリエラ", "text": "はぁ！？\nアーヤ、それ本気で\n言ってるわけ？"},
        { "location": "561/TALK"    , "narrator": "アーヤ", "text": "このまま放っておく\nわけにはいかないでしょ？"},
        { "location": "562/TALK"    , "narrator": "透明真幌", "text": "待て、アーヤ。\nおまえだけではダメだ。"},
        { "location": "563/TALK"    , "narrator": "透明真幌", "text": "ミルクティとアップル\nティの二人が揃わないと、\n条件は整わない。"},
        { "location": "566/TALK"    , "narrator": "みやび", "text": "…なんちゅう\n面倒くさい条件や。"},
        { "location": "568/TALK"    , "narrator": "ガブリエラ", "text": "ホントよね……。"},
        { "location": "570/TALK"    , "narrator": "アーヤ", "text": "聞いたでしょ？\n私一人じゃ無理なの。"},
        { "location": "571/TALK"    , "narrator": "アーヤ", "text": "だから、お願い！\n私と一緒に戦って！"},
        { "location": "572/TALK"    , "narrator": "ガブリエラ", "text": "そう言われても…。"},
        { "location": "573/TALK"    , "narrator": "アーヤ", "text": "お願い！"},
        { "location": "575/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "577/TALK"    , "narrator": "みやび", "text": "…どうするぞね？"},
        { "location": "579/TALK"    , "narrator": "ガブリエラ", "text": "どうするって…。"},
        { "location": "582/TALK"    , "narrator": "ガブリエラ", "text": "…わかった。\nわかったわよ。"},
        { "location": "584/TALK"    , "narrator": "ガブリエラ", "text": "あたしが一緒に\nやったげるから！\nそれでいいでしょ？"},
        { "location": "585/TALK"    , "narrator": "アーヤ", "text": "ほ、本当！？"},
        { "location": "587/TALK"    , "narrator": "みやび", "text": "ガブちゃん、\nまっことえいの？"},
        { "location": "588/TALK"    , "narrator": "ガブリエラ", "text": "必殺技で一撃でも、\n戦闘であることには\n違いないんだし――"},
        { "location": "589/TALK"    , "narrator": "ガブリエラ", "text": "それなら、みやびより\nあたしの方が\n適任でしょ？"},
        { "location": "591/TALK"    , "narrator": "アーヤ", "text": "ありがとう。\nやっぱりギャヴィは\n頼りになるわ。"},
        { "location": "592/TALK"    , "narrator": "ガブリエラ", "text": "こんな変なことで\n頼られても\n嬉しくないから！"},
        { "location": "593/TALK"    , "narrator": "ガブリエラ", "text": "もっと狙撃とか、\nそっち系で頼ってくれ\nればいいのに…。"},
        { "location": "594/TALK"    , "narrator": "アーヤ", "text": "そっちに関しては\nいつも頼りにしてるわよ。"},
        { "location": "595/TALK"    , "narrator": "アーヤ", "text": "だから、今回だけは\nお願いね。"},
        { "location": "596/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "598/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…わかったから、\nさっさと終わらせるわよ。"},
        { "location": "599/TALK"    , "narrator": "透明真幌", "text": "決まったか？\nでは、そっちに資料を\n一式送っておいた。"},
        { "location": "600/TALK"    , "narrator": "透明真幌", "text": "作戦開始前に、\nそれに目を通して\nおいてくれ。"},
        { "location": "601/TALK"    , "narrator": "ガブリエラ", "text": "資料？"},
        { "location": "602/TALK"    , "narrator": "透明真幌", "text": "メルティの決め台詞と\n技名に関する資料だ。"},
        { "location": "603/TALK"    , "narrator": "透明真幌", "text": "それに目を通し、\n正確に再現してくれ。"},
        { "location": "604/TALK"    , "narrator": "ガブリエラ", "text": "そこまでやらなきゃ\nいけないの！？"},
        { "location": "607/TALK"    , "narrator": "みやび", "text": "ガブちゃん、\nもう諦めぃ。"},
        { "location": "608/TALK"    , "narrator": "みやび", "text": "今更やめるなんて\n言える雰囲気やないぞね？"},
        { "location": "610/TALK"    , "narrator": "ガブリエラ", "text": "う、うぅぅ…。"},
        { "location": "612/TALK"    , "narrator": "アーヤ", "text": "それじゃ、\n配置につくわ。"},
        { "location": "613/TALK"    , "narrator": "アーヤ", "text": "頼りにしてるからね、\nギャヴィ。"},
        { "location": "615/TALK"    , "narrator": "ガブリエラ", "text": "こんなことで\n頼られても嬉しく\nないんだってば！"},
        { "location": "626/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【MV EXE_AYAMi】"}
    ]
}
