    "entry":
    [
        { "location": "624/TALK"  , "narrator": "つばめ", "text": "ごめんね"},
        { "location": "626/TALK"  , "narrator": "つばめ", "text": "ぁたし"},
        { "location": "627/TALK"  , "narrator": "つばめ", "text": "本当はわかってる"},
        { "location": "628/TALK"  , "narrator": "つばめ", "text": "アーヤさん達が言ってること"},
        { "location": "629/TALK"  , "narrator": "つばめ", "text": "間違ってないって"},
        { "location": "631/SEL"   , "narrator": "", "text": "無理しないで"},
        { "location": "632/SEL"   , "narrator": "", "text": "鵜呑みも危険かもよ"},
        { "location": "633/SEL"   , "narrator": "", "text": "正解は常にひとつ！"},
        { "location": "634/SEL"   , "narrator": "", "text": "人の数だけ真実があるんだって"},
        { "location": "635/SEL"   , "narrator": "", "text": "本当に？"},
        { "location": "636/ACT"   , "narrator": "", "text": "無理しないで"},
        { "location": "637/TALK"  , "narrator": "つばめ", "text": "変なの"},
        { "location": "638/TALK"  , "narrator": "つばめ", "text": "さっきと逆のこと言ってなぃ？"},
        { "location": "639/ACT"   , "narrator": "", "text": "鵜呑みも危険かもよ"},
        { "location": "640/TALK"  , "narrator": "つばめ", "text": "そっか"},
        { "location": "641/TALK"  , "narrator": "つばめ", "text": "それは気がつかなかったょ(*´︶`*)"},
        { "location": "642/ACT"   , "narrator": "", "text": "正解は常にひとつ！"},
        { "location": "643/TALK"  , "narrator": "つばめ", "text": "ぁ"},
        { "location": "644/TALK"  , "narrator": "つばめ", "text": "なんか探偵みたいだね(๑･ㅂ･)و☆"},
        { "location": "645/ACT"   , "narrator": "", "text": "人の数だけ真実があるんだって"},
        { "location": "646/TALK"  , "narrator": "つばめ", "text": "難しいこと言うね|д･)"},
        { "location": "647/ACT"   , "narrator": "", "text": "本当に？"},
        { "location": "648/TALK"  , "narrator": "つばめ", "text": "だって"},
        { "location": "649/TALK"  , "narrator": "つばめ", "text": "本当はわかってたもん"},
        { "location": "651/TALK"  , "narrator": "つばめ", "text": "それでね"},
        { "location": "652/TALK"  , "narrator": "つばめ", "text": "ぁたしのこと"},
        { "location": "653/TALK"  , "narrator": "つばめ", "text": "大切に思ってくれてるのも"},
        { "location": "654/TALK"  , "narrator": "つばめ", "text": "とっても嬉しぃ"},
        { "location": "657/TALK"  , "narrator": "つばめ", "text": "でもね"},
        { "location": "658/TALK"  , "narrator": "つばめ", "text": "ぁたしは神楽ちゃんのことも"},
        { "location": "659/TALK"  , "narrator": "つばめ", "text": "信じてる"},
        { "location": "660/TALK"  , "narrator": "つばめ", "text": "これだけは"},
        { "location": "661/TALK"  , "narrator": "つばめ", "text": "これからも変わらなぃよ"},
        { "location": "663/SEL"   , "narrator": "", "text": "それでいいの？"},
        { "location": "664/SEL"   , "narrator": "", "text": "そっか……"},
        { "location": "665/SEL"   , "narrator": "", "text": "だろうね"},
        { "location": "666/ACT"   , "narrator": "", "text": "それでいいの？"},
        { "location": "667/ACT"   , "narrator": "", "text": "そっか……"},
        { "location": "668/ACT"   , "narrator": "", "text": "だろうね"},
        { "location": "670/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "671/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんが"},
        { "location": "672/TALK"  , "narrator": "つばめ", "text": "あんなことをしたのは"},
        { "location": "673/TALK"  , "narrator": "つばめ", "text": "どうしようもなかったんだと思う"},
        { "location": "674/TALK"  , "narrator": "つばめ", "text": "でも信じたくて"},
        { "location": "675/TALK"  , "narrator": "つばめ", "text": "助けたくて"},
        { "location": "676/TALK"  , "narrator": "つばめ", "text": "そう思ってて"},
        { "location": "679/TALK"  , "narrator": "つばめ", "text": "自分でもわからなぃ"},
        { "location": "680/TALK"  , "narrator": "つばめ", "text": "こんなに神楽ちゃんのこと"},
        { "location": "681/TALK"  , "narrator": "つばめ", "text": "信じたいって思うのか"},
        { "location": "684/TALK"  , "narrator": "つばめ", "text": "何でかな？"},
        { "location": "687/TALK"  , "narrator": "つばめ", "text": "やっぱり"},
        { "location": "688/TALK"  , "narrator": "つばめ", "text": "メノウちゃんだから"},
        { "location": "689/TALK"  , "narrator": "つばめ", "text": "なのかな。。。"},
        { "location": "691/SEL"   , "narrator": "", "text": "それでもいいんじゃない"},
        { "location": "692/SEL"   , "narrator": "", "text": "そうかもしれないけど"},
        { "location": "693/SEL"   , "narrator": "", "text": "関係ないよ"},
        { "location": "694/SEL"   , "narrator": "", "text": "どうかな"},
        { "location": "695/ACT"   , "narrator": "", "text": "それでもいいんじゃない"},
        { "location": "696/ACT"   , "narrator": "", "text": "そうかもしれないけど"},
        { "location": "697/ACT"   , "narrator": "", "text": "関係ないよ"},
        { "location": "698/ACT"   , "narrator": "", "text": "どうかな"},
        { "location": "711/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "712/TALK"  , "narrator": "つばめ", "text": "ぁたし……。"},
        { "location": "713/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんと\nメノウちゃんは違う。"},
        { "location": "714/TALK"  , "narrator": "つばめ", "text": "そう思おうって\n決めたはずなのに…。"},
        { "location": "717/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "721/TALK"  , "narrator": "つばめ", "text": "あ、あった。\nこの髪飾りだ！"},
        { "location": "723/TALK"  , "narrator": "つばめ", "text": "よかった…。\nまだ、ちゃんと\n残ってたんだ…。"},
        { "location": "724/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "725/TALK"  , "narrator": "つばめ", "text": "買うのは、\n神楽ちゃんの分だけで\nいいよね。"},
        { "location": "726/TALK"  , "narrator": "つばめ", "text": "ぁたしのは、\n神楽ちゃんに買ってもらう\n約束なんだから。"},
        { "location": "727/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "739/TALK"  , "narrator": "つばめ", "text": "$handle$さん"},
        { "location": "740/TALK"  , "narrator": "つばめ", "text": "やっぱりぁたし"},
        { "location": "741/TALK"  , "narrator": "つばめ", "text": "メノウちゃんだから信じてるのかも"},
        { "location": "742/TALK"  , "narrator": "つばめ", "text": "だって"},
        { "location": "743/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんがメノウちゃんなのは本当だし"},
        { "location": "744/TALK"  , "narrator": "つばめ", "text": "メノウちゃんはぁたしの恩人だから"},
        { "location": "746/SEL"   , "narrator": "", "text": "だったら信じよう"},
        { "location": "747/SEL"   , "narrator": "", "text": "決めたんだね"},
        { "location": "748/SEL"   , "narrator": "", "text": "$me$のことも信じて！"},
        { "location": "749/SEL"   , "narrator": "", "text": "そのせいでみんなに迷惑かけても？"},
        { "location": "750/ACT"   , "narrator": "", "text": "だったら信じよう"},
        { "location": "751/TALK"  , "narrator": "つばめ", "text": "それしか"},
        { "location": "752/TALK"  , "narrator": "つばめ", "text": "なぃょね"},
        { "location": "753/ACT"   , "narrator": "", "text": "決めたんだね"},
        { "location": "754/TALK"  , "narrator": "つばめ", "text": "ぁたし"},
        { "location": "755/TALK"  , "narrator": "つばめ", "text": "決めた"},
        { "location": "756/ACT"   , "narrator": "", "text": "$me$のことも信じて！"},
        { "location": "757/TALK"  , "narrator": "つばめ", "text": "そんなの"},
        { "location": "758/TALK"  , "narrator": "つばめ", "text": "当たり前だから"},
        { "location": "759/ACT"   , "narrator": "", "text": "そのせいでみんなに迷惑かけても？"},
        { "location": "761/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "762/TALK"  , "narrator": "つばめ", "text": "それでも"},
        { "location": "764/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんを信じる"},
        { "location": "765/TALK"  , "narrator": "つばめ", "text": "それから"},
        { "location": "766/TALK"  , "narrator": "つばめ", "text": "また仲良くする"},
        { "location": "767/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんも"},
        { "location": "768/TALK"  , "narrator": "つばめ", "text": "アーヤさん達も"},
        { "location": "769/TALK"  , "narrator": "つばめ", "text": "みんな一緒に"},
        { "location": "772/TALK"  , "narrator": "つばめ", "text": "ぁたし"},
        { "location": "774/TALK"  , "narrator": "つばめ", "text": "甘ぃよね？"},
        { "location": "776/SEL"   , "narrator": "", "text": "その方がつばめらしいよ"},
        { "location": "777/SEL"   , "narrator": "", "text": "むしろベリーハードだと思うけど"},
        { "location": "778/SEL"   , "narrator": "", "text": "そういう考え方いいよね"},
        { "location": "779/SEL"   , "narrator": "", "text": "$me$もその中に入れてよ"},
        { "location": "780/SEL"   , "narrator": "", "text": "実現させるために頑張れ！"},
        { "location": "781/ACT"   , "narrator": "", "text": "その方がつばめらしいよ"},
        { "location": "782/TALK"  , "narrator": "つばめ", "text": "そぅかな。。。？"},
        { "location": "783/ACT"   , "narrator": "", "text": "むしろベリーハードだと思うけど"},
        { "location": "784/TALK"  , "narrator": "つばめ", "text": "そぅなの。。。？"},
        { "location": "785/ACT"   , "narrator": "", "text": "そういう考え方いいよね"},
        { "location": "786/TALK"  , "narrator": "つばめ", "text": "ほんと？"},
        { "location": "787/ACT"   , "narrator": "", "text": "$me$もその中に入れてよ"},
        { "location": "788/TALK"  , "narrator": "つばめ", "text": "入ってるょ"},
        { "location": "789/ACT"   , "narrator": "", "text": "実現させるために頑張れ！"},
        { "location": "790/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "793/TALK"  , "narrator": "つばめ", "text": "ぁたし頑張る"},
        { "location": "794/TALK"  , "narrator": "つばめ", "text": "みんなや"},
        { "location": "795/TALK"  , "narrator": "つばめ", "text": "$handle$さんに"},
        { "location": "796/TALK"  , "narrator": "つばめ", "text": "呆れられなぃよぅに"},
        { "location": "797/TALK"  , "narrator": "つばめ", "text": "ぁりがと"},
        { "location": "808/TALK"  , "narrator": "つばめ", "text": "ぁたしの分の髪飾り、\n絶対買ってね…、\n神楽ちゃん！"},
        { "location": "819/DIALOG", "narrator": "Dialog_chapter_ch01", "text": "【20 ２０１６】"}
    ]
