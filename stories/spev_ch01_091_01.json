{
    "dir": "chap00/daydra/spev_ch01_091_01.js",
    "type": "",
    "info": {
        "story_id": "91021",
        "cid": "",
        "title": "シャッツキステリンク",
        "sub_title": "神楽の大事な忘れもの"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "シャッツキステコラボ：神楽の大事な忘れもの"},
        { "location": "23/TALK"   , "narrator": "神楽", "text": "ハァ…最悪。"},
        { "location": "24/TALK"   , "narrator": "神楽", "text": "…あれは、私にとって\n大切なものなのに…。"},
        { "location": "26/TALK"   , "narrator": "神楽", "text": "…あら？"},
        { "location": "27/TALK"   , "narrator": "神楽", "text": "$handle$さん、\nいたんですか？"},
        { "location": "28/SEL"    , "narrator": "（選択肢）", "text": "何かあったの？"},
        { "location": "29/ACT"    , "narrator": "", "text": "何かあったの？"},
        { "location": "31/TALK"   , "narrator": "神楽", "text": "いえ…別に…。"},
        { "location": "32/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "34/TALK"   , "narrator": "神楽", "text": "あ、あの…もしかして、\n$handle$さんは\nご存知じゃないですか？"},
        { "location": "35/TALK"   , "narrator": "神楽", "text": "私と、つばめさんで\n撮ったプリが\nどこにあるのか…。"},
        { "location": "36/SEL"    , "narrator": "（選択肢）", "text": "いや、知らないよ"},
        { "location": "37/ACT"    , "narrator": "", "text": "いや、知らないよ"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "…そう、ですか。"},
        { "location": "41/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "42/SEL"    , "narrator": "（選択肢）", "text": "力になるよ"},
        { "location": "43/SEL"    , "narrator": "（選択肢）", "text": "また撮りに行けばいいよ"},
        { "location": "44/SEL"    , "narrator": "（選択肢）", "text": "次は無くさないようにね"},
        { "location": "45/ACT"    , "narrator": "", "text": "力になるよ"},
        { "location": "47/TALK"   , "narrator": "神楽", "text": "…ありがとうございます。"},
        { "location": "48/TALK"   , "narrator": "神楽", "text": "でも、もういいです。\nどうせ見つかりっこ\nないですし…。"},
        { "location": "49/SEL"    , "narrator": "（選択肢）", "text": "そっか…"},
        { "location": "50/SEL"    , "narrator": "（選択肢）", "text": "$me$は探すぞ"},
        { "location": "51/ACT"    , "narrator": "", "text": "そっか…"},
        { "location": "52/TALK"   , "narrator": "神楽", "text": "そうですよ…。"},
        { "location": "53/TALK"   , "narrator": "神楽", "text": "でも、お気持ちだけは\n受け取っておきますね。"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "はぁ…。"},
        { "location": "58/ACT"    , "narrator": "", "text": "$me$は探すぞ"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "…ごめんなさい。\nちょっと、嫌な子に\nなっていました…。"},
        { "location": "63/TALK"   , "narrator": "神楽", "text": "それじゃあ、\nお言葉に甘えて、\n手伝ってもらいますね。"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "実は、プリを\n失くした場所は\nわかっているんです。"},
        { "location": "66/TALK"   , "narrator": "神楽", "text": "でも…――"},
        { "location": "82/TALK"   , "narrator": "メイド", "text": "ようこそ\nおいでくださいました。"},
        { "location": "86/TALK"   , "narrator": "神楽", "text": "あ、あの、すみません！\nお尋ねしたいことが\nあるんですが…。"},
        { "location": "87/TALK"   , "narrator": "メイド", "text": "どうなさいましたか？"},
        { "location": "88/TALK"   , "narrator": "神楽", "text": "…私、先日このお店に\n来たときに、忘れ物を\nしてしまいまして…。"},
        { "location": "89/TALK"   , "narrator": "メイド", "text": "忘れ物…。"},
        { "location": "90/TALK"   , "narrator": "メイド", "text": "あ、もしかして、\nそれはプリでは\nないでしょうか？"},
        { "location": "91/TALK"   , "narrator": "神楽", "text": "そ、そうです！\nあるんですか？"},
        { "location": "92/TALK"   , "narrator": "メイド", "text": "はい。きっと取りに\nいらっしゃると思い、\n保管しておいたんです。"},
        { "location": "94/TALK"   , "narrator": "メイド", "text": "すぐにお持ちしますので、\n少々お待ちください。"},
        { "location": "95/TALK"   , "narrator": "神楽", "text": "ありがとうございます！"},
        { "location": "99/TALK"   , "narrator": "神楽", "text": "…よかった。"},
        { "location": "100/TALK"  , "narrator": "メイド", "text": "…あ、あら？"},
        { "location": "101/TALK"  , "narrator": "メイド", "text": "おかしいわ…。\n確かこの棚の上に…。"},
        { "location": "103/TALK"  , "narrator": "神楽", "text": "あ、あの…、\nどうかしたんですか？"},
        { "location": "104/TALK"  , "narrator": "メイド", "text": "いえ、それが\nどうしてか\n見当たらなくて…。"},
        { "location": "105/TALK"  , "narrator": "神楽", "text": "えぇっ！？"},
        { "location": "106/TALK"  , "narrator": "メイド", "text": "う～ん…。"},
        { "location": "110/TALK"  , "narrator": "メイド", "text": "申し訳ありません。\n確かに棚の上に置いた\nはずなんですが…。"},
        { "location": "111/TALK"  , "narrator": "神楽", "text": "そ、そうですか…。"},
        { "location": "112/TALK"  , "narrator": "メイド", "text": "はい…本当に\n申し訳ありません…。"},
        { "location": "113/TALK"  , "narrator": "神楽", "text": "い、いえ…元はといえば、\n忘れた私がいけないん\nですから…。"},
        { "location": "114/TALK"  , "narrator": "メイド", "text": "う～ん…。"},
        { "location": "115/TALK"  , "narrator": "メイド", "text": "やっぱり、何かちょっと\n最近おかしいですね……。"},
        { "location": "116/TALK"  , "narrator": "神楽", "text": "他にも何か\nあったんですか？"},
        { "location": "118/TALK"  , "narrator": "メイド", "text": "はい。\n実は、あの棚なんですが\n先日…。"},
        { "location": "132/TALK"  , "narrator": "メイド", "text": "あら？　旅人さまの\nお忘れ物かしら？"},
        { "location": "133/TALK"  , "narrator": "メイド", "text": "…あっ、この旅人さまは、\nいつも交流ノートを\n書いてくれるあの子ね。"},
        { "location": "134/TALK"  , "narrator": "メイド", "text": "お友達と一緒のプリを\n忘れてしまうなんて…、\nきっと困ってるわ。"},
        { "location": "135/TALK"  , "narrator": "メイド", "text": "…とりあえず、\n交流ノートの間に\n挟んで…。"},
        { "location": "137/TALK"  , "narrator": "メイド", "text": "…あら？\nこんな本、棚の上に\n置いてあったかしら？"},
        { "location": "138/TALK"  , "narrator": "メイド", "text": "元々あった本がないし…、\n誰か置き換えた…？"},
        { "location": "154/TALK"  , "narrator": "神楽", "text": "…どういうことですか？"},
        { "location": "155/TALK"  , "narrator": "メイド", "text": "わからないんです。"},
        { "location": "156/TALK"  , "narrator": "メイド", "text": "他の子に聞いても、\n誰も本を置き換えて\nいないと言っていて…。"},
        { "location": "157/TALK"  , "narrator": "メイド", "text": "今も、交流ノート自体は\nあったんですが…。"},
        { "location": "158/TALK"  , "narrator": "神楽", "text": "まさか、メイドさんの\n知らない交流ノート…、\nだったんですか？"},
        { "location": "159/TALK"  , "narrator": "メイド", "text": "…はい。"},
        { "location": "160/TALK"  , "narrator": "神楽", "text": "…確かに、不思議ですね。"},
        { "location": "162/TALK"  , "narrator": "神楽", "text": "無くなってるわけじゃ\nなくて、別の物に\n変わってるなんて…。"},
        { "location": "163/TALK"  , "narrator": "メイド", "text": "そうなんです…。"},
        { "location": "164/TALK"  , "narrator": "メイド", "text": "ですが、旅人さんの\nお忘れ物を紛失して\nしまったのは事実です。"},
        { "location": "166/TALK"  , "narrator": "メイド", "text": "わざわざ取りに来て\nいただいたのに、\n申し訳ありません…。"},
        { "location": "167/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "178/TALK"  , "narrator": "神楽", "text": "…ということが\nあったんです。"},
        { "location": "180/TALK"  , "narrator": "神楽", "text": "…元々あった物が消えて、\n別の物と入れ替わる。"},
        { "location": "181/TALK"  , "narrator": "神楽", "text": "これって、どういうこと\nだと思いますか？"},
        { "location": "182/SEL"   , "narrator": "（選択肢）", "text": "いや、さっぱりだ"},
        { "location": "183/SEL"   , "narrator": "（選択肢）", "text": "どこかの世界と繋がってひっくり返ってるとか"},
        { "location": "184/ACT"   , "narrator": "", "text": "いや、さっぱりだ"},
        { "location": "185/TALK"  , "narrator": "神楽", "text": "ですよね…。"},
        { "location": "186/TALK"  , "narrator": "神楽", "text": "…私も、色々と考えては\nみたんです。"},
        { "location": "187/TALK"  , "narrator": "神楽", "text": "もしかしたら、\nあの棚はどこかの世界と\n繋がってる、と。"},
        { "location": "188/TALK"  , "narrator": "神楽", "text": "そして、別の世界の\nその場所にあった物と、\n入れ替わっている。"},
        { "location": "189/TALK"  , "narrator": "神楽", "text": "…この可能性、\n意外とあると思うんです。"},
        { "location": "190/ACT"   , "narrator": "", "text": "どこかの世界と繋がってひっくり返ってるとか"},
        { "location": "191/TALK"  , "narrator": "神楽", "text": "…それ、私もちょっとだけ\n考えました。"},
        { "location": "192/TALK"  , "narrator": "神楽", "text": "あの場所は、もしかしたら\n別の世界と何らかの形で\n繋がってるのでは、と。"},
        { "location": "193/TALK"  , "narrator": "神楽", "text": "そして何かが干渉して、\nその場にある物同士が\n入れ替わっている…。"},
        { "location": "194/TALK"  , "narrator": "神楽", "text": "…$handle$さんも\nそう思ったなら、本当に\nそうなのかもしれません。"},
        { "location": "196/TALK"  , "narrator": "神楽", "text": "…そうだ！"},
        { "location": "197/TALK"  , "narrator": "神楽", "text": "貴方の世界に、\n『シャッツキステ』という\nお店はありますか？"},
        { "location": "198/TALK"  , "narrator": "神楽", "text": "もしあるなら、\n是非プリがあるか\n探してほしいんです。"},
        { "location": "200/TALK"  , "narrator": "神楽", "text": "もしお店があるなら、\n貴方の世界に紛れ込んだ\n可能性もありますので…。"},
        { "location": "201/SEL"   , "narrator": "（選択肢）", "text": "$me$が並行世界の住人って知ってるの？"},
        { "location": "202/ACT"   , "narrator": "", "text": "$me$が並行世界の住人って知ってるの？"},
        { "location": "205/TALK"  , "narrator": "神楽", "text": "…はい。\n実は、ずーっと前から\n知っていました…。"},
        { "location": "206/TALK"  , "narrator": "神楽", "text": "でも、何でそれを\n知っているかは秘密です。"},
        { "location": "207/TALK"  , "narrator": "神楽", "text": "こんなタイミングで、\n私の口から話すことは\nできませんので。"},
        { "location": "208/TALK"  , "narrator": "神楽", "text": "…でも、そろそろ秘密でも\nなんでもなくなってきそう\nですけど。"},
        { "location": "209/TALK"  , "narrator": "神楽", "text": "…とにかく、プリの件\nよろしくお願いしますね。"},
        { "location": "210/ACT"   , "narrator": "", "text": "また撮りに行けばいい"},
        { "location": "211/TALK"  , "narrator": "神楽", "text": "簡単に\n言わないでください！"},
        { "location": "212/TALK"  , "narrator": "神楽", "text": "また撮りになんて、\n行けるかどうか\nわからないんですから…。"},
        { "location": "213/SEL"   , "narrator": "（選択肢）", "text": "どういうこと？"},
        { "location": "214/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "217/TALK"  , "narrator": "神楽", "text": "…いえ、\n何でもありません。"},
        { "location": "218/TALK"  , "narrator": "神楽", "text": "知らないなら、いいです。\nありがとうございました。"},
        { "location": "221/ACT"   , "narrator": "", "text": "次は無くさないようにね"},
        { "location": "223/TALK"  , "narrator": "神楽", "text": "…そう、ですね。"},
        { "location": "224/TALK"  , "narrator": "神楽", "text": "もし…次があれば\nですけど…。"},
        { "location": "225/SEL"   , "narrator": "（選択肢）", "text": "どういうこと？"},
        { "location": "226/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "229/TALK"  , "narrator": "神楽", "text": "…いえ、\n何でもありません。"},
        { "location": "230/TALK"  , "narrator": "神楽", "text": "知らないならいいんです。\nありがとうございました。"}
    ]
}
