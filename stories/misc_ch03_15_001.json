    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "022_椅子取りゲーム"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "Muzyczne krzesłaって"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "日本にもあるのね"},
        { "location": "35/SEL"    , "narrator": "", "text": "ごめん、何？"},
        { "location": "36/SEL"    , "narrator": "", "text": "日本語でお願いします"},
        { "location": "37/ACT"    , "narrator": "", "text": "ごめん、何？"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "Muzyczne krzesłaが"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "何かってことね"},
        { "location": "41/ACT"    , "narrator": "", "text": "日本語でお願いします"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "わかったわ"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "Muzyczne krzesłaはね"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "椅子取りゲームのことよ"},
        { "location": "47/SEL"    , "narrator": "", "text": "懐かしい"},
        { "location": "48/SEL"    , "narrator": "", "text": "どうして急に？"},
        { "location": "49/SEL"    , "narrator": "", "text": "$me$の隣はガブの予約席"},
        { "location": "50/ACT"    , "narrator": "", "text": "懐かしい"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "遊んだことがあるのね"},
        { "location": "53/ACT"    , "narrator": "", "text": "どうして急に？"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "今日そのことを知ったからよ"},
        { "location": "55/ACT"    , "narrator": "", "text": "$me$の隣はガブの予約席"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "あらｖｖ"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "そういうのは恋人が言うものよｖｖｖ"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$ったら////////////////"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "私結構強かったのよね"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "もうこんな遊びは子供っぽいかしら？"},
        { "location": "66/SEL"    , "narrator": "", "text": "かもね"},
        { "location": "67/SEL"    , "narrator": "", "text": "遊ぼうって言ってみれば"},
        { "location": "68/SEL"    , "narrator": "", "text": "強いガブが見たいな"},
        { "location": "69/ACT"    , "narrator": "", "text": "かもね"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりそうなの"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "残念だわ"},
        { "location": "74/ACT"    , "narrator": "", "text": "遊ぼうって言ってみれば"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "どうかしら"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "遊びたいのかと言われると"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと微妙だわ"},
        { "location": "80/ACT"    , "narrator": "", "text": "強いガブが見たいな"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "そんなこと言って"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$ったら"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "ちゃんと見ててくれるのかしら？"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "だったら遊んでもいいわ"}
    ]
}
