        "title": "SideStory004 ストーリー",
        "sub_title": "FILE03.試行"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "東京編３話"},
        { "location": "19/DIALOG" , "narrator": "", "text": "<color=green>9月4日　 0:21 PM</color>\nとある日曜、某所にて。"},
        { "location": "20/TALK"   , "narrator": "キリト", "text": "はぁ…小夜さんに聞いても\nわからなかったな…。"},
        { "location": "22/TALK"   , "narrator": "キリト", "text": "もう、他に行き先知ってる\nような奴、いないだろ？"},
        { "location": "23/TALK"   , "narrator": "雛", "text": "うーん…綾水先輩の\n実家じゃないとしたら、\nみやび先輩の実家とかは？"},
        { "location": "25/TALK"   , "narrator": "繭", "text": "絶対に行ってない。"},
        { "location": "27/TALK"   , "narrator": "キリト", "text": "なんでわかるんだよ？"},
        { "location": "30/TALK"   , "narrator": "繭", "text": "みやび先輩の実家にある\nスパコン、操作された\n形跡なかったから。"},
        { "location": "31/TALK"   , "narrator": "繭", "text": "…さっき、\nアクセスして調べた。"},
        { "location": "35/TALK"   , "narrator": "キリト", "text": "なるほど。\nみやび先輩だったら\n絶対触ってるはずだよな。"},
        { "location": "36/TALK"   , "narrator": "ヒカル", "text": "ガブリエラさんの\n実家はポーランドだから\n除外して…。"},
        { "location": "37/TALK"   , "narrator": "キリト", "text": "じゃ、逢瀬の実家は？"},
        { "location": "39/TALK"   , "narrator": "ヒカル", "text": "逢瀬さんが捕まってるの\n家族にバレちゃうから、\n行かないと思うよ。"},
        { "location": "40/TALK"   , "narrator": "雛", "text": "…みんな、どこに\n行っちゃったのかな？"},
        { "location": "44/TALK"   , "narrator": "キリト", "text": "あっ。"},
        { "location": "45/TALK"   , "narrator": "繭", "text": "…緊張感のないヤツ。"},
        { "location": "47/TALK"   , "narrator": "キリト", "text": "あ、頭使うと\n腹が減るんだよ。"},
        { "location": "49/TALK"   , "narrator": "ヒカル", "text": "そういえば、\nちょっとお腹空いて\nきたよね？"},
        { "location": "50/TALK"   , "narrator": "キリト", "text": "だろ？"},
        { "location": "51/TALK"   , "narrator": "キリト", "text": "俺、ちょっとコンビニに\n買い出し行ってくる。"},
        { "location": "52/TALK"   , "narrator": "キリト", "text": "みんなはここで\nなにかいい案ないか\n考えててくれよ。"},
        { "location": "53/TALK"   , "narrator": "繭", "text": "サンドイッチとエクレア。\nホットのミルクティーで。"},
        { "location": "54/TALK"   , "narrator": "キリト", "text": "ＷＡＶＥの方に\n送ってくれよ。"},
        { "location": "55/TALK"   , "narrator": "キリト", "text": "じゃあ、ちょっと\n行ってくる。"},
        { "location": "68/TALK"   , "narrator": "キリト", "text": "…で？\nどうしてひなこまで\n来てるんだよ？"},
        { "location": "70/TALK"   , "narrator": "雛", "text": "ちょっと脳みそクリアに\nしたいなー、って\n思ってねー。"},
        { "location": "72/TALK"   , "narrator": "キリト", "text": "…そうだな。"},
        { "location": "73/TALK"   , "narrator": "キリト", "text": "適度な気分転換しなきゃ、\nいい案なんて\n浮かぶはずないし。"},
        { "location": "74/TALK"   , "narrator": "雛", "text": "そーゆーこと。"},
        { "location": "75/TALK"   , "narrator": "雛", "text": "…それに、ちょっと\nキリトに聞きたいことも\nあったし。"},
        { "location": "77/TALK"   , "narrator": "キリト", "text": "なんだ、\n聞きたいことって？"},
        { "location": "79/TALK"   , "narrator": "雛", "text": "連絡が取れなかった間の\nことだよ。"},
        { "location": "80/TALK"   , "narrator": "雛", "text": "何日も連絡もしないで、\nどこでなにやってたの？"},
        { "location": "81/TALK"   , "narrator": "キリト", "text": "なにしてたって…、\nほとんどなにもして\nなかったんだけどな…。"},
        { "location": "83/TALK"   , "narrator": "キリト", "text": "テレビもスマホも\nネットもない専用の\n官舎に呼ばれてさ。"},
        { "location": "84/TALK"   , "narrator": "キリト", "text": "出撃命令が下るまで\n部隊丸ごとただそこで\n待機せよ、だったし…。"},
        { "location": "86/TALK"   , "narrator": "キリト", "text": "だからまあ、ずーっと\n暇つぶしにヒカルと\n話してたなぁ…。"},
        { "location": "88/TALK"   , "narrator": "雛", "text": "…そうだったんだ。"},
        { "location": "90/TALK"   , "narrator": "キリト", "text": "せめてスマホがあれば\nマシだったんだけど…。"},
        { "location": "91/TALK"   , "narrator": "キリト", "text": "マジで暇と退屈で\n地獄みたいな数日間\nだったぜ…。"},
        { "location": "93/TALK"   , "narrator": "雛", "text": "もぅ、暇とか退屈とか\n言わないでよー。"},
        { "location": "94/TALK"   , "narrator": "雛", "text": "こっちは本当に\n心配してたんだからね？"},
        { "location": "96/TALK"   , "narrator": "キリト", "text": "冗談だって。\nわりぃわりぃ。"},
        { "location": "98/TALK"   , "narrator": "雛", "text": "まったく…。"},
        { "location": "99/TALK"   , "narrator": "キリト", "text": "…………。"},
        { "location": "100/TALK"  , "narrator": "キリト", "text": "しっかし、スゴイな…。\nヒカルの予想\n的中じゃねぇか…。"},
        { "location": "102/TALK"  , "narrator": "雛", "text": "なんの話？"},
        { "location": "103/TALK"  , "narrator": "キリト", "text": "待機任務中、\nずっとヒカルと話してた\nって言っただろ？"},
        { "location": "104/TALK"  , "narrator": "キリト", "text": "その時にあいつ、\n言ってたんだよ。"},
        { "location": "105/TALK"  , "narrator": "キリト", "text": "自分たちと連絡が\n取れなくなって…。"},
        { "location": "106/TALK"  , "narrator": "キリト", "text": "ひなこ達が心配してるに\n違いない、ってさ。"},
        { "location": "107/TALK"  , "narrator": "雛", "text": "ふーん…キリトは、\nそう思わなかったの？"},
        { "location": "108/TALK"  , "narrator": "キリト", "text": "たかが数日で心配なんか\nされない、って\n思ってたぞ？"},
        { "location": "109/TALK"  , "narrator": "雛", "text": "…キリトらしいというか、\nなんというか…。"},
        { "location": "110/TALK"  , "narrator": "キリト", "text": "けど、ヒカルはさ、\nひなこは絶対に\n心配してるはずだ、って。"},
        { "location": "111/TALK"  , "narrator": "キリト", "text": "だから、どうにかして\n外部と連絡取りたいって、\n言っててな…。"},
        { "location": "113/TALK"  , "narrator": "雛", "text": "そっかぁ…。"},
        { "location": "114/TALK"  , "narrator": "雛", "text": "やっぱり、ヒカル君は\nさすがだなぁ…。"},
        { "location": "115/TALK"  , "narrator": "雛", "text": "…それに比べて、\nキリトは相変わらずって\nいうか…。"},
        { "location": "116/TALK"  , "narrator": "キリト", "text": "相変わらずって…、\n数日で変わったり\nなんかしねぇよ。"},
        { "location": "117/TALK"  , "narrator": "雛", "text": "…そっか。"},
        { "location": "118/TALK"  , "narrator": "雛", "text": "よかった…。\nそれ聞いて、ちょっと\n安心したかもー。"},
        { "location": "119/TALK"  , "narrator": "キリト", "text": "なんでだ？"},
        { "location": "120/TALK"  , "narrator": "雛", "text": "キリトがキリトのままで\nいてくれてるからだよー。"},
        { "location": "121/TALK"  , "narrator": "キリト", "text": "そりゃそうだろ。\n俺がヒカルになったりする\nはずないんだからな。"},
        { "location": "122/TALK"  , "narrator": "雛", "text": "あたしの言ってること\n全然理解してないっぽい\nけど…。"},
        { "location": "123/TALK"  , "narrator": "雛", "text": "むしろそこに安心した。\nいいよ、キリト。\n最高だね！"},
        { "location": "124/TALK"  , "narrator": "キリト", "text": "褒められてる気が\n全然しねぇなぁ…。"},
        { "location": "126/TALK"  , "narrator": "キリト", "text": "…ん？"},
        { "location": "137/TALK"  , "narrator": "雛", "text": "どうしたの、キリト？"},
        { "location": "138/TALK"  , "narrator": "キリト", "text": "いや、これって…。"},
        { "location": "140/TALK"  , "narrator": "雛", "text": "？　掲示板じゃん。\nほら、地域のイベントの\nお知らせとか貼るやつ。"},
        { "location": "141/TALK"  , "narrator": "雛", "text": "これがどうかしたの？"},
        { "location": "142/TALK"  , "narrator": "キリト", "text": "…そうか。"},
        { "location": "143/TALK"  , "narrator": "キリト", "text": "これだ！\nこれなら、綾水先輩達と\n連絡取れるかもしれない！"},
        { "location": "145/TALK"  , "narrator": "雛", "text": "えっ！？"},
        { "location": "148/TALK"  , "narrator": "キリト", "text": "ちょっと待ってくれ。\n今、繭に連絡して\n頼むから…。"},
        { "location": "149/TALK"  , "narrator": "雛", "text": "どういうことなの？\nこんな掲示板で、\nどうやって…。"},
        { "location": "150/TALK"  , "narrator": "キリト", "text": "あるだろ？\nどこにいても見れる\n掲示板が…。"},
        { "location": "151/TALK"  , "narrator": "雛", "text": "？"},
        { "location": "153/TALK"  , "narrator": "キリト", "text": "劇場のホームページの\n掲示板だよ！"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "ひなこ達からのＷＡＶＥ、\n来なくなっちゃった…。"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "さすがに、\nもう諦めたのかしら？"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとだけ、\n寂しいけど…。"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "これで、いいのよね？"},
        { "location": "168/SEL"   , "narrator": "（選択肢）", "text": "$me$がいるから安心して"},
        { "location": "169/SEL"   , "narrator": "（選択肢）", "text": "ひなこ達に連絡できるかも"},
        { "location": "170/ACT"   , "narrator": "", "text": "$me$がいるから安心して"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "ダメよ$marzanna$"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "スマホは"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "使ったらいけないと言われてるから"},
        { "location": "189/TALK"  , "narrator": "ガブリエラ", "text": "電源切っておいたのに"},
        { "location": "191/SEL"   , "narrator": "（選択肢）", "text": "心配で我慢できなかった"},
        { "location": "192/SEL"   , "narrator": "（選択肢）", "text": "通信はしてないから平気"},
        { "location": "193/ACT"   , "narrator": "", "text": "心配で我慢できなかった"},
        { "location": "194/TALK"  , "narrator": "ガブリエラ", "text": "心配させちゃったかしら？"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "ごめんね"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "198/TALK"  , "narrator": "ガブリエラ", "text": "平気よ"},
        { "location": "199/ACT"   , "narrator": "", "text": "通信はしてないから平気"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "そういう問題じゃないわ"},
        { "location": "201/TALK"  , "narrator": "ガブリエラ", "text": "まったく"},
        { "location": "202/TALK"  , "narrator": "ガブリエラ", "text": "勝手なんだから"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "207/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$の声聞けて"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと元気出たわ"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "チャットで声って言うのは"},
        { "location": "212/TALK"  , "narrator": "ガブリエラ", "text": "変かもしれないけど//////"},
        { "location": "215/TALK"  , "narrator": "ガブリエラ", "text": "本当は私"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと参っちゃってたみたい"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "話しかけてもらえてよかった"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "みんなにはナイショよ？"},
        { "location": "221/SEL"   , "narrator": "（選択肢）", "text": "力になりたい"},
        { "location": "222/SEL"   , "narrator": "（選択肢）", "text": "秘密にしておくよ"},
        { "location": "223/ACT"   , "narrator": "", "text": "力になりたい"},
        { "location": "224/TALK"  , "narrator": "ガブリエラ", "text": "もう十分なってるわ"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "こうやって"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "私とお話してくれてるでしょ？"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "それで十分よ"},
        { "location": "229/ACT"   , "narrator": "", "text": "秘密にしておくよ"},
        { "location": "230/TALK"  , "narrator": "ガブリエラ", "text": "そうしておいて"},
        { "location": "231/TALK"  , "narrator": "ガブリエラ", "text": "アーヤ達に知られたら"},
        { "location": "232/TALK"  , "narrator": "ガブリエラ", "text": "大げさに心配されちゃうもの"},
        { "location": "235/TALK"  , "narrator": "ガブリエラ", "text": "本当"},
        { "location": "236/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$には"},
        { "location": "237/TALK"  , "narrator": "ガブリエラ", "text": "みんなに見せられない姿沢山見せちゃってる"},
        { "location": "240/TALK"  , "narrator": "ガブリエラ", "text": "信じてるからかしら？"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "絶対秘密にしてくれるって"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "243/TALK"  , "narrator": "ガブリエラ", "text": "安心しちゃうのかも"},
        { "location": "245/TALK"  , "narrator": "ガブリエラ", "text": "そろそろ"},
        { "location": "246/TALK"  , "narrator": "ガブリエラ", "text": "アーヤ達のところ戻らなきゃ"},
        { "location": "248/SEL"   , "narrator": "（選択肢）", "text": "言い忘れてた"},
        { "location": "249/ACT"   , "narrator": "", "text": "言い忘れてた"},
        { "location": "251/TALK"  , "narrator": "ガブリエラ", "text": "まだなにかあるの？"},
        { "location": "254/SEL"   , "narrator": "（選択肢）", "text": "劇場の掲示板を見て"},
        { "location": "255/ACT"   , "narrator": "", "text": "劇場の掲示板を見て"},
        { "location": "257/TALK"  , "narrator": "ガブリエラ", "text": "どうして？"},
        { "location": "259/TALK"  , "narrator": "ガブリエラ", "text": "見ればわかるのかしら？"},
        { "location": "260/TALK"  , "narrator": "ガブリエラ", "text": "それじゃあ"},
        { "location": "261/TALK"  , "narrator": "ガブリエラ", "text": "確認しておくわ"},
        { "location": "265/TALK"  , "narrator": "ガブリエラ", "text": "…何か面白い書き込みでも\nあるのかしら？"},
        { "location": "267/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "269/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "270/TALK"  , "narrator": "ガブリエラ", "text": "この書き込みって…、\nまさか！"},
        { "location": "273/TALK"  , "narrator": "ガブリエラ", "text": "…あ、アーヤ達に\n教えないと！"},
        { "location": "276/ACT"   , "narrator": "", "text": "ひなこ達に連絡できるかも"},
        { "location": "292/TALK"  , "narrator": "ガブリエラ", "text": "どういうこと？"},
        { "location": "293/TALK"  , "narrator": "ガブリエラ", "text": "トレースされないように"},
        { "location": "294/TALK"  , "narrator": "ガブリエラ", "text": "連絡する方法あるの？"}
    ]
}
