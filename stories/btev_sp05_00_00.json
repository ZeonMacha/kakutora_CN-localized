    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "夏は短しハジけよ乙女♪＜願望編＞"},
        { "location": "25/TALK"   , "narrator": "真幌", "text": "よし、みんな！\n今日はめいっぱい\n遊んでいいぞ！"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "えぇっ！？\n本当にいいんですか？"},
        { "location": "27/TALK"   , "narrator": "真幌", "text": "本当もなにも、\n海に来て遊ばないとか\n勿体ないだろう？"},
        { "location": "28/TALK"   , "narrator": "神楽", "text": "さすが真幌さんです！"},
        { "location": "29/TALK"   , "narrator": "神楽", "text": "それじゃつばめさん、\n今日は思いっきり\n遊んじゃいましょ！"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "うん！\nわたし、神楽ちゃんと\n遊びたかったんだ。"},
        { "location": "31/TALK"   , "narrator": "真幌", "text": "あまり遠くへ\n行くんじゃないぞー。"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "神楽ちゃん、\nいくよー！"},
        { "location": "46/TALK"   , "narrator": "神楽", "text": "はい、こっちも\n返します！"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "よーし、それじゃあ…。"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "たーっ！！"},
        { "location": "49/TALK"   , "narrator": "神楽", "text": "あ、あわわわわ！"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "ご、ごめん！\n大丈夫！？"},
        { "location": "51/TALK"   , "narrator": "神楽", "text": "はい。\nすぐ取ってきますね。"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "（…………。）"},
        { "location": "54/SEL"    , "narrator": "", "text": "仲がいいね"},
        { "location": "55/ACT"    , "narrator": "", "text": "仲がいいね"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "うん…。\nココロの中だからね。"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "現実だと、わたし達、\nまだギスギスしちゃって\nる"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "けど…。"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "だからかな？\nココロの中でだけでも、\n仲良くしてたいの。"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "現実から見たら、\nただの妄想でしか\nないけど…。"},
        { "location": "62/SEL"    , "narrator": "", "text": "空しいだけだと思う"},
        { "location": "63/SEL"    , "narrator": "", "text": "仲良い姿は見てて嬉しい"},
        { "location": "64/ACT"    , "narrator": "", "text": "空しいだけだと思う"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "そうかもしれないけど…。"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "でも、神楽ちゃんと\n一緒にいられないの、\nとっても辛くて…。"},
        { "location": "67/SEL"    , "narrator": "", "text": "僕がいるじゃないか"},
        { "location": "68/SEL"    , "narrator": "", "text": "僕はいらないんだ？"},
        { "location": "69/ACT"    , "narrator": "", "text": "僕がいるじゃないか"},
        { "location": "70/ACT"    , "narrator": "", "text": "僕はいらないんだ？"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "そうだけど…。"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "$handle$さんと\n神楽ちゃんは、\n別だから…。"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "ごめんね…。"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "もう少しだけ、\nこの時間を楽しませて。"},
        { "location": "76/ACT"    , "narrator": "", "text": "仲良い姿は見てて嬉しい"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "そう言ってもらえると、\nとっても嬉しい。"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "作り物の世界なのは\nわかってるけど…。"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "それでも、わたしも\nとっても楽しいし…。"},
        { "location": "80/SEL"    , "narrator": "", "text": "戻ってくるか心配"},
        { "location": "81/ACT"    , "narrator": "", "text": "戻ってくるか心配"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "大丈夫だよ。"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "やっぱりこの世界の\n神楽ちゃんは、\n本物じゃないし…。"},
        { "location": "86/TALK"   , "narrator": "神楽", "text": "つばめさーん！"},
        { "location": "88/TALK"   , "narrator": "神楽", "text": "お待たせしました！\nボール取ってきたんで、\n再開しましょう！"},
        { "location": "89/TALK"   , "narrator": "つばめ", "text": "…うん！"},
        { "location": "93/TALK"   , "narrator": "神楽", "text": "…沢山遊びましたね。\nとっても楽しかったです！"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "わたしも…、\n本当に楽しかった…。"},
        { "location": "95/TALK"   , "narrator": "神楽", "text": "ふふっ、よかった…。"},
        { "location": "96/TALK"   , "narrator": "神楽", "text": "それじゃあ、そろそろ\n家に戻りましょう。"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "（…………。）"},
        { "location": "98/TALK"   , "narrator": "神楽", "text": "つばめさん？"},
        { "location": "99/TALK"   , "narrator": "つばめ", "text": "…神楽ちゃん、\n先帰ってて。"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "わたし…、\n$handle$さんと、\nお話があるから…。"},
        { "location": "101/TALK"  , "narrator": "神楽", "text": "えっ！？\n二人きりでお話！？"},
        { "location": "102/TALK"  , "narrator": "神楽", "text": "まさか…愛の告白を\nしちゃうんですか！？"},
        { "location": "103/SEL"   , "narrator": "", "text": "イエス、神楽が好きです"},
        { "location": "104/SEL"   , "narrator": "", "text": "そうなんだ、大好きだよつばめ"},
        { "location": "105/ACT"   , "narrator": "", "text": "イエス、神楽が好きです"},
        { "location": "106/TALK"  , "narrator": "神楽", "text": "私にですか！？"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "ちょ、\n$handle$さん！"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "告白じゃなくて、\nちょっとお話があるだけ\nだから…。"},
        { "location": "109/TALK"  , "narrator": "神楽", "text": "ほっ、ビックリした…。\n$handle$さんは\n冗談が過ぎますよ。"},
        { "location": "110/TALK"  , "narrator": "神楽", "text": "…まあ、嬉しいな、とは\n思いましたけどね。"},
        { "location": "111/ACT"   , "narrator": "", "text": "そうなんだ、大好きだよつばめ"},
        { "location": "113/TALK"  , "narrator": "神楽", "text": "ふふっ、\nそれじゃあお先に。"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "もぉ…真面目な話を\nするんだから、\n冗談は言わないでよぉ…。"},
        { "location": "116/SEL"   , "narrator": "", "text": "ごめんね。それで、話って？"},
        { "location": "117/ACT"   , "narrator": "", "text": "ごめんね。それで、話って？"},
        { "location": "119/TALK"  , "narrator": "つばめ", "text": "うん…簡単なこと\nなんだけど…。"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "わたしにね、\n勇気が出るおまじないを\nしてほしいの。"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "だって、この世界は\nわたしが逃げるための\n妄想の世界でしょ？"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "現実の神楽ちゃんのこと、\n考えてると辛くなる\nからって…。"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "偽物の神楽ちゃんで、\n癒されるために\n作った世界…。"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "だから、この世界に\nこれ以上いたらいけない。"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "ちゃんと現実で、\n神楽ちゃんのこと、\n考えないといけないから。"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "だから…、\nお願いしていいかな？"},
        { "location": "127/SEL"   , "narrator": "", "text": "つばめが望むなら"},
        { "location": "128/ACT"   , "narrator": "", "text": "つばめが望むなら"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "うん、お願いします。"},
        { "location": "131/TALK"  , "narrator": "つばめ", "text": "今より、もっと心を\n強くするために！"}
    ]
}
