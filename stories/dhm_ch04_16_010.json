    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "024_女子力は戦闘力に相当するらしい"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "キラキラのゆるふわの乙女ぞね"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "即ち"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "それがみやびさん"},
        { "location": "36/SEL"    , "narrator": "", "text": "キャラ変わった？"},
        { "location": "37/SEL"    , "narrator": "", "text": "そうですね（棒読み）"},
        { "location": "38/SEL"    , "narrator": "", "text": "はい、体温計"},
        { "location": "39/ACT"    , "narrator": "", "text": "キャラ変わった？"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "ちょっと"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "頑張ってみた"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "これ以上はもう無理ぞね"},
        { "location": "45/ACT"    , "narrator": "", "text": "そうですね（棒読み）"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "そうですよ"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "んなわけない"},
        { "location": "48/ACT"    , "narrator": "", "text": "はい、体温計"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "熱などない！"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "いやなに"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "つばめちゃんたちがメイクは楽しいと"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "キラキラオーラを出しながら言うので"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "それにあやかろうとしただけぞね"},
        { "location": "56/SEL"    , "narrator": "", "text": "女子力足りないんじゃ…"},
        { "location": "57/SEL"    , "narrator": "", "text": "それを聞いて安心した"},
        { "location": "58/SEL"    , "narrator": "", "text": "みやびらしくてよい"},
        { "location": "59/ACT"    , "narrator": "", "text": "女子力足りないんじゃ…"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "女子力の定義から言えば"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "料理上手かつ"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "着付けもできるみやびさんはかなりの高偏差値"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "読めたぞ"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "パラメータが偏っておるのだな"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "納得した"},
        { "location": "68/ACT"    , "narrator": "", "text": "それを聞いて安心した"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "ふむ"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "化粧をする女子の気持ちがわからんと"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "$handle$は安心するのか"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "それは"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "こっちにしてみれば楽でいいぞね"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "さすが相棒"},
        { "location": "78/ACT"    , "narrator": "", "text": "みやびらしくてよい"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "ふむ"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "我は我なり"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "要はそういうことぞね"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "誉められた！！！！"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "って"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "呆れておるのか？"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "それは許さんぞ"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "$handle$め"}
    ]
}
