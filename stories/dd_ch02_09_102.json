        "title": "005 メインストーリー",
        "sub_title": "臆する季節＜後編＞"
    },
    "entry":
    [
        { "location": "297/SCENARIO", "narrator": "", "text": "臆する季節"},
        { "location": "313/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "316/TALK"    , "narrator": "小夜", "text": "じゃあさ、これは\nどうかしら？"},
        { "location": "317/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "318/TALK"    , "narrator": "小夜", "text": "アーヤ？"},
        { "location": "321/TALK"    , "narrator": "アーヤ", "text": "あっ、ごめん。\n何の話だっけ？"},
        { "location": "322/TALK"    , "narrator": "小夜", "text": "うん…\nさっき話してた子って――"},
        { "location": "323/TALK"    , "narrator": "小夜", "text": "もしかして、\nトライナリーの\nメンバー？"},
        { "location": "326/TALK"    , "narrator": "アーヤ", "text": "…話聞かれてたし、\n隠してもバレバレ\nよね。"},
        { "location": "329/TALK"    , "narrator": "アーヤ", "text": "はぁ…そうよ。\nでも、秘密だからね？"},
        { "location": "331/TALK"    , "narrator": "小夜", "text": "うわぁ、そうなんだ！"},
        { "location": "332/TALK"    , "narrator": "小夜", "text": "あの子って確か…、\n中等部の子よね？"},
        { "location": "334/TALK"    , "narrator": "アーヤ", "text": "知ってるの？"},
        { "location": "336/TALK"    , "narrator": "小夜", "text": "何度か見たけたこと\nある程度だけど――"},
        { "location": "338/TALK"    , "narrator": "小夜", "text": "超可愛いんだもの。\n一度見たら忘れられ\nないって。"},
        { "location": "339/TALK"    , "narrator": "アーヤ", "text": "あはは、確かに。\nギャヴィの可愛さは\n飛びぬけてるわね。"},
        { "location": "341/TALK"    , "narrator": "小夜", "text": "肌も白くて綺麗だし、\nお人形さんみたい。"},
        { "location": "343/TALK"    , "narrator": "小夜", "text": "ギュッてして、\nスリスリー、って\nしてみたいなぁ。"},
        { "location": "345/TALK"    , "narrator": "アーヤ", "text": "あ、あはは…。"},
        { "location": "347/TALK"    , "narrator": "アーヤ", "text": "そんなことしたら\n絶対に怒る――"},
        { "location": "348/TALK"    , "narrator": "アーヤ", "text": "ううん、多分驚いて\n固まるわね…。"},
        { "location": "351/TALK"    , "narrator": "小夜", "text": "…ねえ、アーヤ。\nお願い！"},
        { "location": "352/TALK"    , "narrator": "小夜", "text": "トライナリーの\nみんなを――"},
        { "location": "353/TALK"    , "narrator": "小夜", "text": "あたしに紹介して\nくれない？"},
        { "location": "357/TALK"    , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "359/TALK"    , "narrator": "小夜", "text": "だって、その子達って\nアーヤと一緒に戦う\n仲間なんでしょ？"},
        { "location": "360/TALK"    , "narrator": "小夜", "text": "なら、友達としては\n挨拶しときたいし――"},
        { "location": "361/TALK"    , "narrator": "小夜", "text": "ついでに、私も\n仲良くなりたいの。"},
        { "location": "362/TALK"    , "narrator": "小夜", "text": "ね、いいでしょ？"},
        { "location": "363/TALK"    , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "364/TALK"    , "narrator": "小夜", "text": "ダメかしら？"},
        { "location": "367/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "368/TALK"    , "narrator": "アーヤ", "text": "ううん、いいわよ。"},
        { "location": "370/TALK"    , "narrator": "小夜", "text": "え、本当！？"},
        { "location": "371/TALK"    , "narrator": "アーヤ", "text": "ええ、すぐには\n無理かもしれない\nけど――"},
        { "location": "372/TALK"    , "narrator": "アーヤ", "text": "みんなで食事にでも\n行きましょ。"},
        { "location": "373/TALK"    , "narrator": "小夜", "text": "やった！\n凄く楽しみ。"},
        { "location": "375/TALK"    , "narrator": "アーヤ", "text": "でも、さっき言ってた\nようなことしたら\nダメよ？"},
        { "location": "377/TALK"    , "narrator": "小夜", "text": "ギューとかスリスリ？\nさすがにあれは\n冗談よ。"},
        { "location": "378/TALK"    , "narrator": "小夜", "text": "でも、本当にいいの？\nアーヤ的に、\n迷惑だったりしない？"},
        { "location": "379/TALK"    , "narrator": "アーヤ", "text": "ん？"},
        { "location": "381/TALK"    , "narrator": "アーヤ", "text": "うん…迷惑っていう\nよりかは――"},
        { "location": "382/TALK"    , "narrator": "アーヤ", "text": "私も、紹介するのが\nちょっと楽しみかも。"},
        { "location": "383/TALK"    , "narrator": "小夜", "text": "そっか…。\nそれ聞いて安心した。"},
        { "location": "385/TALK"    , "narrator": "小夜", "text": "楽しみだなぁ。"},
        { "location": "388/TALK"    , "narrator": "アーヤ", "text": "ふふっ…。"},
        { "location": "400/TALK"    , "narrator": "アーヤ", "text": "何だか不思議（￣ー￣？）"},
        { "location": "401/TALK"    , "narrator": "アーヤ", "text": "まさか"},
        { "location": "402/TALK"    , "narrator": "アーヤ", "text": "小夜にみんなを紹介するのを"},
        { "location": "403/TALK"    , "narrator": "アーヤ", "text": "楽しみに感じるなんて(^^"},
        { "location": "405/TALK"    , "narrator": "アーヤ", "text": "今までの私なら"},
        { "location": "406/TALK"    , "narrator": "アーヤ", "text": "断ってたはずなのに"},
        { "location": "408/SEL"     , "narrator": "", "text": "$me$のおかげだからね"},
        { "location": "409/ACT"     , "narrator": "", "text": "$me$のおかげだからね"},
        { "location": "411/TALK"    , "narrator": "アーヤ", "text": "はい？(￣Д￣ )"},
        { "location": "413/TALK"    , "narrator": "アーヤ", "text": "どういうこと？（￣ー￣？）"},
        { "location": "415/SEL"     , "narrator": "", "text": "$me$がそう思えるようにした"},
        { "location": "416/ACT"     , "narrator": "", "text": "$me$がそう思えるようにした"},
        { "location": "419/TALK"    , "narrator": "アーヤ", "text": "ジョークかしら？(-ω-;)"},
        { "location": "420/TALK"    , "narrator": "アーヤ", "text": "そんなことできるわけないでしょ？"},
        { "location": "422/SEL"     , "narrator": "", "text": "本当なのに…"},
        { "location": "423/ACT"     , "narrator": "", "text": "本当なのに…"},
        { "location": "425/TALK"    , "narrator": "アーヤ", "text": "はいはい(^-^*)(･･*)(^-^*)(･･*)"},
        { "location": "426/TALK"    , "narrator": "アーヤ", "text": "じゃあ"},
        { "location": "427/TALK"    , "narrator": "アーヤ", "text": "そういうことにしてお礼を言っておくわ"},
        { "location": "428/TALK"    , "narrator": "アーヤ", "text": "ありがとう(^з^)―☆"},
        { "location": "451/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【07 愛，ロボット】"}
    ]
}
