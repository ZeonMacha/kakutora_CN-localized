{
    "dir": "chap00/daydra/spev_ch03_006.js",
    "type": "",
    "info": {
        "story_id": "3006",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "冷えすぎにご注意"
    },
    "entry":
    [
        { "location": "23/TALK" , "narrator": "透明ガブリエラ", "text": "はぁ～、やっぱり夏は\nかき氷よねー。"},
        { "location": "24/TALK" , "narrator": "透明神楽", "text": "ガブちゃん、\nお昼ご飯食べに来たの\n忘れたんですか？"},
        { "location": "25/TALK" , "narrator": "透明ガブリエラ", "text": "いいじゃない。\n海に来てる時くらい、\n好きなの食べたって。"},
        { "location": "27/TALK" , "narrator": "透明つばめ", "text": "わたしは焼きそばに\nしようかなー？"},
        { "location": "28/TALK" , "narrator": "透明神楽", "text": "海の家の焼きそばって、\nお祭りの時とは違う\n美味しさありますからね。"},
        { "location": "29/TALK" , "narrator": "透明ガブリエラ", "text": "なら、かき氷だって\nそうじゃない。"},
        { "location": "30/TALK" , "narrator": "透明神楽", "text": "そうですけど、\nご飯として食べるのは\n間違ってるような…。"},
        { "location": "31/TALK" , "narrator": "透明神楽", "text": "いくら食べても\nお腹膨れませんし。"},
        { "location": "33/TALK" , "narrator": "透明ガブリエラ", "text": "お腹減ってないから\nいいのよ。"},
        { "location": "34/TALK" , "narrator": "透明ガブリエラ", "text": "あたしのことはいいから、\nあんた達も食べたいもの\n食べればいいじゃない。"},
        { "location": "36/TALK" , "narrator": "透明神楽", "text": "もぅ…後でお腹減っても\n知りませんよ？"},
        { "location": "38/TALK" , "narrator": "透明ガブリエラ", "text": "まったく…海に来てるのに\nかき氷食べないなんて…。"},
        { "location": "40/TALK" , "narrator": "透明ガブリエラ", "text": "そうだ。\nマルザンナだったら\nどう言うかしら？"},
        { "location": "42/TALK" , "narrator": "ガブリエラ", "text": "ちょっといいかしら？"},
        { "location": "43/TALK" , "narrator": "ガブリエラ", "text": "海に来て食べるもの"},
        { "location": "44/TALK" , "narrator": "ガブリエラ", "text": "マルザンナなら"},
        { "location": "45/TALK" , "narrator": "ガブリエラ", "text": "まず何を思い浮かべる？"},
        { "location": "46/SEL"  , "narrator": "（選択肢）", "text": "焼きそばとかラーメン？"},
        { "location": "47/SEL"  , "narrator": "（選択肢）", "text": "かき氷かな"},
        { "location": "48/ACT"  , "narrator": "", "text": "焼きそばとかラーメン？"},
        { "location": "49/TALK" , "narrator": "ガブリエラ", "text": "マルザンナもそっちが好きなの？"},
        { "location": "51/TALK" , "narrator": "ガブリエラ", "text": "もちろん"},
        { "location": "52/TALK" , "narrator": "ガブリエラ", "text": "それも魅力的よ？"},
        { "location": "53/TALK" , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "54/TALK" , "narrator": "ガブリエラ", "text": "かき氷もいいと思わない？"},
        { "location": "55/ACT"  , "narrator": "", "text": "かき氷かな"},
        { "location": "56/TALK" , "narrator": "ガブリエラ", "text": "そう言ってくれると信じてたわ"},
        { "location": "57/TALK" , "narrator": "ガブリエラ", "text": "やっぱり海ではかき氷"},
        { "location": "58/TALK" , "narrator": "ガブリエラ", "text": "これが一番よね"},
        { "location": "60/TALK" , "narrator": "ガブリエラ", "text": "涼しい部屋で食べるんじゃなくて"},
        { "location": "61/TALK" , "narrator": "ガブリエラ", "text": "暑い太陽の下で"},
        { "location": "62/TALK" , "narrator": "ガブリエラ", "text": "溶けちゃう前に早く食べるの"},
        { "location": "63/TALK" , "narrator": "ガブリエラ", "text": "冷たさと甘さで"},
        { "location": "65/TALK" , "narrator": "ガブリエラ", "text": "キュッてするの"},
        { "location": "66/TALK" , "narrator": "ガブリエラ", "text": "最高よね？"},
        { "location": "67/SEL"  , "narrator": "（選択肢）", "text": "今のガブリエラが最高に可愛い"},
        { "location": "68/SEL"  , "narrator": "（選択肢）", "text": "うん、わかる気がする"},
        { "location": "69/ACT"  , "narrator": "", "text": "今のガブリエラが最高に可愛い"},
        { "location": "72/TALK" , "narrator": "ガブリエラ", "text": "かき氷の話をしているのよ？"},
        { "location": "74/TALK" , "narrator": "ガブリエラ", "text": "マルザンナは"},
        { "location": "75/TALK" , "narrator": "ガブリエラ", "text": "いつも私しか見ていないのね？"},
        { "location": "76/TALK" , "narrator": "ガブリエラ", "text": "あまりいいとは言えないわ"},
        { "location": "79/TALK" , "narrator": "ガブリエラ", "text": "だからって"},
        { "location": "80/TALK" , "narrator": "ガブリエラ", "text": "嫌ではないけど///////"},
        { "location": "81/ACT"  , "narrator": "", "text": "うん、わかる気がする"},
        { "location": "82/TALK" , "narrator": "ガブリエラ", "text": "わかってくれると思ってたわ"},
        { "location": "84/TALK" , "narrator": "ガブリエラ", "text": "マルザンナとも"},
        { "location": "85/TALK" , "narrator": "ガブリエラ", "text": "いつか一緒にかき氷食べたいわ"},
        { "location": "86/SEL"  , "narrator": "（選択肢）", "text": "その時はガブリエラのを一口もらう"},
        { "location": "87/SEL"  , "narrator": "（選択肢）", "text": "海で？　もちろん水着だよね？"},
        { "location": "88/ACT"  , "narrator": "", "text": "その時はガブリエラのを一口もらう"},
        { "location": "89/TALK" , "narrator": "ガブリエラ", "text": "一緒に食べれば"},
        { "location": "90/TALK" , "narrator": "ガブリエラ", "text": "二人で違う味頼めるものね"},
        { "location": "92/TALK" , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "93/TALK" , "narrator": "ガブリエラ", "text": "多分私"},
        { "location": "95/TALK" , "narrator": "ガブリエラ", "text": "三つくらい頼んじゃうと思うけど"},
        { "location": "96/ACT"  , "narrator": "", "text": "海で？　もちろん水着だよね？"},
        { "location": "99/TALK" , "narrator": "ガブリエラ", "text": "気のせい？"},
        { "location": "101/TALK", "narrator": "ガブリエラ", "text": "なんだか目的変わってる気がするんだけど"},
        { "location": "102/TALK", "narrator": "ガブリエラ", "text": "そんなことないわよね？"},
        { "location": "105/TALK", "narrator": "ガブリエラ", "text": "かき氷なくなっちゃう"},
        { "location": "106/TALK", "narrator": "ガブリエラ", "text": "次は"},
        { "location": "107/TALK", "narrator": "ガブリエラ", "text": "どの味にしようかしら？"},
        { "location": "108/SEL" , "narrator": "（選択肢）", "text": "そろそろ温かいもの食べよう"},
        { "location": "109/SEL" , "narrator": "（選択肢）", "text": "オーソドックスにイチゴとか？"},
        { "location": "110/ACT" , "narrator": "", "text": "そろそろ温かいものを食べよう"},
        { "location": "113/TALK", "narrator": "ガブリエラ", "text": "まだ平気よ"},
        { "location": "114/TALK", "narrator": "ガブリエラ", "text": "身体だって"},
        { "location": "115/TALK", "narrator": "ガブリエラ", "text": "全然冷えてないし"},
        { "location": "116/ACT" , "narrator": "", "text": "オーソドックスにイチゴとか？"},
        { "location": "119/TALK", "narrator": "ガブリエラ", "text": "一番シンプルね"},
        { "location": "120/TALK", "narrator": "ガブリエラ", "text": "でも"},
        { "location": "121/TALK", "narrator": "ガブリエラ", "text": "安心する甘さよね/////"},
        { "location": "122/TALK", "narrator": "ガブリエラ", "text": "つばめにも"},
        { "location": "123/TALK", "narrator": "ガブリエラ", "text": "一口上げようかしら？"},
        { "location": "125/TALK", "narrator": "ガブリエラ", "text": "それじゃ二杯目買ってくるわ"},
        { "location": "127/TALK", "narrator": "ガブリエラ", "text": "食べ終わったら"},
        { "location": "128/TALK", "narrator": "ガブリエラ", "text": "またお話しましょ"},
        { "location": "135/TALK", "narrator": "透明つばめ", "text": "美味しかったー。\nお腹いっぱいだよ。"},
        { "location": "137/TALK", "narrator": "透明神楽", "text": "ふふっ、つばめさんって、\nどこでも美味しそうに\n食べますよね？"},
        { "location": "138/TALK", "narrator": "透明つばめ", "text": "だって、本当にとっても\n美味しくて――"},
        { "location": "142/TALK", "narrator": "透明つばめ", "text": "って、ガブちゃん！\nまだかき氷食べてたの！？"},
        { "location": "143/TALK", "narrator": "透明ガブリエラ", "text": "…これで最後にするわよ。"},
        { "location": "144/TALK", "narrator": "透明神楽", "text": "ガブちゃん…もしかして、\nかき氷食べ過ぎて\n寒いんじゃ…。"},
        { "location": "145/TALK", "narrator": "透明ガブリエラ", "text": "きゅ、急に来たのよ…。\nこれ食べるまでは、\nそんなこと――"},
        { "location": "149/TALK", "narrator": "透明ガブリエラ", "text": "ッ！？"},
        { "location": "150/TALK", "narrator": "透明神楽", "text": "あっ！"},
        { "location": "151/TALK", "narrator": "透明ガブリエラ", "text": "うっ…くぅーっ！\nあ、頭に…、\n頭に、キーンッ、って…。"},
        { "location": "152/TALK", "narrator": "透明神楽", "text": "こんなに食べるまで\nなかったのが奇跡ですよ。"},
        { "location": "153/TALK", "narrator": "透明つばめ", "text": "わたし、温かいお茶\n買ってくるね。"},
        { "location": "154/TALK", "narrator": "透明神楽", "text": "もぅ、美味しいのは\nわかりますけど、\n限度を考えてくださいね？"},
        { "location": "156/TALK", "narrator": "透明ガブリエラ", "text": "うぅ…せ、説教は\n痛みが治まってからに\nしなさいよ…。"}
    ]
}
