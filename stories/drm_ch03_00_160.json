    "entry":
    [
        { "location": "354/SCENARIO", "narrator": "", "text": "160_ちゃんとして！"},
        { "location": "379/TALK"    , "narrator": "ガブリエラ", "text": "もうもうもうもうもうもう！！！！！！！"},
        { "location": "380/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんとして！ちゃんとして！ちゃんとして！"},
        { "location": "382/SEL"     , "narrator": "", "text": "何の話？"},
        { "location": "383/SEL"     , "narrator": "", "text": "ちゃんとしてるよ？"},
        { "location": "384/TALK"    , "narrator": "ガブリエラ", "text": "言ったじゃない！"},
        { "location": "385/TALK"    , "narrator": "ガブリエラ", "text": "ヒカルくんとのキューピッドになりなさいって！"},
        { "location": "386/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんとして！"},
        { "location": "387/TALK"    , "narrator": "ガブリエラ", "text": "全然ダメじゃない！"},
        { "location": "390/ACT"     , "narrator": "", "text": "何の話？"},
        { "location": "391/ACT"     , "narrator": "", "text": "ちゃんとしてるよ？"},
        { "location": "393/TALK"    , "narrator": "ガブリエラ", "text": "図書館で聞いたことよ！"},
        { "location": "394/TALK"    , "narrator": "ガブリエラ", "text": "ヒカルくんが喜ぶような話がしたいって言ったのに！"},
        { "location": "395/TALK"    , "narrator": "ガブリエラ", "text": "なんでちゃんと教えてくれないの？"},
        { "location": "397/SEL"     , "narrator": "", "text": "八つ当たりしないで"},
        { "location": "398/SEL"     , "narrator": "", "text": "ガブリエラが好きだから"},
        { "location": "399/SEL"     , "narrator": "", "text": "次は任せて"},
        { "location": "400/ACT"     , "narrator": "", "text": "八つ当たりしないで"},
        { "location": "401/TALK"    , "narrator": "ガブリエラ", "text": "やつあたりなんかじゃないわよ！"},
        { "location": "403/TALK"    , "narrator": "ガブリエラ", "text": "貴方がちゃんとしてないからじゃない！"},
        { "location": "404/ACT"     , "narrator": "", "text": "ガブリエラが好きだから"},
        { "location": "416/TALK"    , "narrator": "ガブリエラ", "text": "なにそれ？"},
        { "location": "418/TALK"    , "narrator": "ガブリエラ", "text": "好きなら余計ちゃんとしなさいよね！！！"},
        { "location": "419/TALK"    , "narrator": "ガブリエラ", "text": "意味がわからないわ？"},
        { "location": "420/ACT"     , "narrator": "", "text": "次は任せて"},
        { "location": "421/TALK"    , "narrator": "ガブリエラ", "text": "口だけは達者なのね"},
        { "location": "422/TALK"    , "narrator": "ガブリエラ", "text": "でもまあ、今回はいいわよ"},
        { "location": "423/TALK"    , "narrator": "ガブリエラ", "text": "少しは役に立ったし・・・"},
        { "location": "425/TALK"    , "narrator": "ガブリエラ", "text": "とにかく！"},
        { "location": "426/TALK"    , "narrator": "ガブリエラ", "text": "次はちゃんとしてちょうだいね！"},
        { "location": "427/TALK"    , "narrator": "ガブリエラ", "text": "どういうのがちゃんとしてるのかわからないみたいだから"},
        { "location": "428/TALK"    , "narrator": "ガブリエラ", "text": "メッセージを送るわ"},
        { "location": "429/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんと聞いて勉強しなさいね！"},
        { "location": "432/TALK"    , "narrator": "ボイスメール", "text": "キューピッドの心得"},
        { "location": "410/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "444/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【ガブリエラ】</color>のボイスメール\n<color=red>【キューピッドの心得】</color>\nをゲットしました！"}
    ]
}
