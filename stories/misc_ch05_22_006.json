        { "location": "7406/SCENARIO", "narrator": "", "text": "世界を変えるアニメを見ても世界は変わらない"},
        { "location": "7433/TALK"    , "narrator": "神楽", "text": "最近ちょっと異世界行きすぎじゃない？"},
        { "location": "7435/SEL"     , "narrator": "", "text": "え…行ってないよ？"},
        { "location": "7436/SEL"     , "narrator": "", "text": "もう二次元から戻りたくない"},
        { "location": "7437/SEL"     , "narrator": "", "text": "神楽に会いたくて探してるから"},
        { "location": "7438/SEL"     , "narrator": "", "text": "貴様、なぜそれを…！"},
        { "location": "7439/ACT"     , "narrator": "", "text": "え…行ってないよ？"},
        { "location": "7440/TALK"    , "narrator": "神楽", "text": "そうだと思ってた★"},
        { "location": "7441/ACT"     , "narrator": "", "text": "もう二次元から戻りたくない"},
        { "location": "7442/TALK"    , "narrator": "神楽", "text": "ヤバスｗｗｗｗｗ"},
        { "location": "7443/ACT"     , "narrator": "", "text": "神楽に会いたくて探してるから"},
        { "location": "7444/TALK"    , "narrator": "神楽", "text": "やだ、、、"},
        { "location": "7445/TALK"    , "narrator": "神楽", "text": "ぴょんこはいつでもここにいるよ？"},
        { "location": "7446/ACT"     , "narrator": "", "text": "貴様、なぜそれを…！"},
        { "location": "7448/TALK"    , "narrator": "神楽", "text": "知らぬわけがなかろう"},
        { "location": "7449/TALK"    , "narrator": "神楽", "text": "宿敵$handlek$の動向など全て知り尽くしておるわ！！！"},
        { "location": "7450/TALK"    , "narrator": "神楽", "text": "しかしそれにしても甘いことよ"},
        { "location": "7451/TALK"    , "narrator": "神楽", "text": "ぴょんこが付けてたことも気付いてないなんて★"},
        { "location": "7453/TALK"    , "narrator": "神楽", "text": "えっとねー"},
        { "location": "7454/TALK"    , "narrator": "神楽", "text": "異世界に行き過ぎなのはラノベとかアニメの話ぴょん"},
        { "location": "7456/SEL"     , "narrator": "", "text": "現実から逃げたい時ってあるでしょ"},
        { "location": "7457/SEL"     , "narrator": "", "text": "安易すぎるよねー"},
        { "location": "7458/SEL"     , "narrator": "", "text": "神楽に会えるなら異世界転生する"},
        { "location": "7459/ACT"     , "narrator": "", "text": "現実から逃げたい時ってあるでしょ"},
        { "location": "7460/TALK"    , "narrator": "神楽", "text": "あーねー"},
        { "location": "7462/TALK"    , "narrator": "神楽", "text": "言いたいことはわかるけどー"},
        { "location": "7463/ACT"     , "narrator": "", "text": "安易すぎるよねー"},
        { "location": "7464/TALK"    , "narrator": "神楽", "text": "それそれ"},
        { "location": "7465/ACT"     , "narrator": "", "text": "神楽に会えるなら異世界転生する"},
        { "location": "7467/TALK"    , "narrator": "神楽", "text": "やだ、、、$handlek$ったら、、、"},
        { "location": "7469/TALK"    , "narrator": "神楽", "text": "だったらまず$handlek$はトラックに轢かれないとダメぴょん♪"},
        { "location": "7470/TALK"    , "narrator": "神楽", "text": "楽しみに待ってるー！！！"},
        { "location": "7471/TALK"    , "narrator": "神楽", "text": "トラック！トラック！"},
        { "location": "7473/TALK"    , "narrator": "神楽", "text": "そうそう"},
        { "location": "7474/TALK"    , "narrator": "神楽", "text": "ぴょんこは異世界ものが嫌いなわけじゃないぴょん"},
        { "location": "7475/TALK"    , "narrator": "神楽", "text": "とりあえず転生させればいいんでしょって風潮が嫌いなだけぴょん"},
        { "location": "7476/TALK"    , "narrator": "神楽", "text": "誤解しないでね★"}
