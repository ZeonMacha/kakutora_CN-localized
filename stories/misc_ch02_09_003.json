        { "location": "213/SCENARIO", "narrator": "", "text": "012_やわらかな嘘"},
        { "location": "238/TALK"    , "narrator": "アーヤ", "text": "嘘は付いちゃいけません"},
        { "location": "239/TALK"    , "narrator": "アーヤ", "text": "泥棒の始まりです"},
        { "location": "241/TALK"    , "narrator": "アーヤ", "text": "なんて小さいころに教わったけど"},
        { "location": "242/TALK"    , "narrator": "アーヤ", "text": "泥棒なんかになってないしね"},
        { "location": "244/SEL"     , "narrator": "", "text": "アーヤって泥棒だったの"},
        { "location": "245/SEL"     , "narrator": "", "text": "真実を我に伝えたまえ"},
        { "location": "246/ACT"     , "narrator": "", "text": "アーヤって泥棒だったの"},
        { "location": "247/TALK"    , "narrator": "アーヤ", "text": "なんでそうなるの（；￢＿￢）"},
        { "location": "248/TALK"    , "narrator": "アーヤ", "text": "違うから"},
        { "location": "249/ACT"     , "narrator": "", "text": "真実を我に伝えたまえ"},
        { "location": "251/TALK"    , "narrator": "アーヤ", "text": "ええ(^^"},
        { "location": "252/TALK"    , "narrator": "アーヤ", "text": "伝えましてよ"},
        { "location": "254/TALK"    , "narrator": "アーヤ", "text": "なんかね"},
        { "location": "255/TALK"    , "narrator": "アーヤ", "text": "子供ってびっくりするほど大人の言うことを信じるのよね"},
        { "location": "256/TALK"    , "narrator": "アーヤ", "text": "だからちゃんとしなきゃねって思うの"},
        { "location": "257/TALK"    , "narrator": "アーヤ", "text": "だけど"},
        { "location": "258/TALK"    , "narrator": "アーヤ", "text": "辛すぎる真実より優しい嘘の方が有効な時もある。。。"},
        { "location": "261/TALK"    , "narrator": "アーヤ", "text": "よね(´o｀；"},
        { "location": "263/SEL"     , "narrator": "", "text": "アーヤには色々見えてるんだね"},
        { "location": "264/SEL"     , "narrator": "", "text": "それは欺瞞だ"},
        { "location": "265/SEL"     , "narrator": "", "text": "真実こそが真実"},
        { "location": "266/ACT"     , "narrator": "", "text": "アーヤには色々見えてるんだね"},
        { "location": "268/TALK"    , "narrator": "アーヤ", "text": "そうかな"},
        { "location": "271/TALK"    , "narrator": "アーヤ", "text": "だったらいいんだけど(^з^)-☆"},
        { "location": "272/ACT"     , "narrator": "", "text": "それは欺瞞だ"},
        { "location": "273/TALK"    , "narrator": "アーヤ", "text": "欺瞞で結構"},
        { "location": "274/ACT"     , "narrator": "", "text": "真実こそが真実"},
        { "location": "275/TALK"    , "narrator": "アーヤ", "text": "なんかかっこいい"},
        { "location": "276/TALK"    , "narrator": "アーヤ", "text": "けど(´o｀；"},
        { "location": "277/TALK"    , "narrator": "アーヤ", "text": "意味ない言葉だったねヾ(･･ )"},
        { "location": "279/TALK"    , "narrator": "アーヤ", "text": "そんな感じで"},
        { "location": "280/TALK"    , "narrator": "アーヤ", "text": "アーヤは悩めるお年頃なの★"},
