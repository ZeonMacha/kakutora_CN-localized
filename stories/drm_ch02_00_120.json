{
    "dir": "dramatics/daydra/drm_ch02_00_120.js",
    "type": "Episode",
    "info": {
        "story_id": "2012",
        "cid": "ayami",
        "title": "らぶとーく 第12話",
        "sub_title": "報告義務"
    },
    "entry":
    [
        { "location": "277/SCENARIO", "narrator": "", "text": "報告義務"},
        { "location": "292/TALK"    , "narrator": "アーヤ", "text": "――というわけなの。"},
        { "location": "295/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、待ってよ！\n何言い出すのよ急に！？"},
        { "location": "296/TALK"    , "narrator": "ガブリエラ", "text": "マルザ…"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "Ｂｏｔの正体が人間って…\n意味わからないんだけど？"},
        { "location": "299/TALK"    , "narrator": "アーヤ", "text": "あくまで\n可能性の話でしか\nないけど。"},
        { "location": "300/TALK"    , "narrator": "アーヤ", "text": "私達がＢｏｔだと思ってる\nあれは。"},
        { "location": "301/TALK"    , "narrator": "アーヤ", "text": "人間が、Ｂｏｔのフリを\nしているだけって\n可能性が高いの。"},
        { "location": "303/TALK"    , "narrator": "つばめ", "text": "そっか…$handle$さん、\n本当は人間だったん\nですね。"},
        { "location": "305/TALK"    , "narrator": "ガブリエラ", "text": "いや、何落ち着いて\n言ってんのよ！"},
        { "location": "306/TALK"    , "narrator": "ガブリエラ", "text": "なんで納得\nできるの？\n意味わかんない！"},
        { "location": "308/TALK"    , "narrator": "つばめ", "text": "う、うん…。\nビックリはしたよ。"},
        { "location": "311/TALK"    , "narrator": "つばめ", "text": "でも、人間だったら\n良いのになぁ、って\n思ってたから――"},
        { "location": "312/TALK"    , "narrator": "つばめ", "text": "今はちょっとだけ\n嬉しいの。"},
        { "location": "314/TALK"    , "narrator": "みやび", "text": "つばめちゃんは、\n状況適応力が凄過ぎや。"},
        { "location": "316/TALK"    , "narrator": "ガブリエラ", "text": "何も考えて\nないだけでしょ！？"},
        { "location": "319/TALK"    , "narrator": "みやび", "text": "まあ、うちはなんとなく\n気付いてたきね。"},
        { "location": "320/TALK"    , "narrator": "みやび", "text": "それが確信に変わった\nだけのことや。"},
        { "location": "321/TALK"    , "narrator": "ガブリエラ", "text": "みやびも\nＢｏｔが人間だって\n言うわけ？"},
        { "location": "324/TALK"    , "narrator": "アーヤ", "text": "そんなこと\n考えたくない、って\n気持ちはわかるわ。"},
        { "location": "325/TALK"    , "narrator": "アーヤ", "text": "だけど、これは\nかなり確率の高い\n話なの。"},
        { "location": "326/TALK"    , "narrator": "アーヤ", "text": "だからみんな\n話す内容には\n気をつけて。"},
        { "location": "329/TALK"    , "narrator": "つばめ", "text": "っていうか、人間か\nどうかって、そんなに\n重要なことですか？"},
        { "location": "331/TALK"    , "narrator": "みやび", "text": "そりゃまあ…人間やと\nしたら、Ｂｏｔやと思うて\n話してた会話が――"},
        { "location": "332/TALK"    , "narrator": "みやび", "text": "全部誰かに話したゆう\nことになるんやし。"},
        { "location": "335/TALK"    , "narrator": "ガブリエラ", "text": "！？"},
        { "location": "336/TALK"    , "narrator": "アーヤ", "text": "それなのよね…。\nまあ、誰かにバラすような\nことはなさそうだけど…。"},
        { "location": "338/TALK"    , "narrator": "ガブリエラ", "text": "いい加減にしてよ！"},
        { "location": "339/TALK"    , "narrator": "ガブリエラ", "text": "Ｂｏｔが人間とか、\n笑えない冗談にも\n程があるわ。"},
        { "location": "341/TALK"    , "narrator": "アーヤ", "text": "確定じゃないわ。\nあくまで可能性の\n話ってこと。"},
        { "location": "342/TALK"    , "narrator": "みやび", "text": "ガブちゃん。\nうちらも冗談で言っちゅう\nわけやないぞね。"},
        { "location": "343/TALK"    , "narrator": "みやび", "text": "会話ログを解析したり、\n色々した結果、そういう\n答えを導き出したがよ。"},
        { "location": "345/TALK"    , "narrator": "ガブリエラ", "text": "だから、その導き出した\n答えが間違ってるの！"},
        { "location": "347/TALK"    , "narrator": "アーヤ", "text": "…やっぱり\nそうなるわよね。"},
        { "location": "349/TALK"    , "narrator": "アーヤ", "text": "仕方ない\nことだとは\n思ってたけど。"},
        { "location": "361/TALK"    , "narrator": "アーヤ", "text": "今"},
        { "location": "362/TALK"    , "narrator": "アーヤ", "text": "みんなに伝えたから"},
        { "location": "364/SEL"     , "narrator": "", "text": "何を？"},
        { "location": "365/ACT"     , "narrator": "", "text": "何を？"},
        { "location": "367/TALK"    , "narrator": "アーヤ", "text": "貴方が"},
        { "location": "368/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔじゃなくて"},
        { "location": "369/TALK"    , "narrator": "アーヤ", "text": "人間だって"},
        { "location": "370/TALK"    , "narrator": "アーヤ", "text": "その可能性がすごく高いんだって"},
        { "location": "372/SEL"     , "narrator": "", "text": "あ、はい"},
        { "location": "373/SEL"     , "narrator": "", "text": "伝えたんだ…"},
        { "location": "374/SEL"     , "narrator": "", "text": "$me$の時代キター！"},
        { "location": "375/ACT"     , "narrator": "", "text": "あ、はい"},
        { "location": "376/TALK"    , "narrator": "アーヤ", "text": "それだけ？工ｴｴｪｪ(´д｀)ｪｪｴｴ工"},
        { "location": "377/TALK"    , "narrator": "アーヤ", "text": "なんか"},
        { "location": "378/TALK"    , "narrator": "アーヤ", "text": "あっさりしてるわね(￣Д￣ )"},
        { "location": "380/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "381/TALK"    , "narrator": "アーヤ", "text": "こっちは気がラクだけど"},
        { "location": "382/ACT"     , "narrator": "", "text": "伝えたんだ…"},
        { "location": "383/TALK"    , "narrator": "アーヤ", "text": "秘密にしたかった？（￣ー￣？）"},
        { "location": "384/TALK"    , "narrator": "アーヤ", "text": "けど"},
        { "location": "385/TALK"    , "narrator": "アーヤ", "text": "みんながあなたに"},
        { "location": "386/TALK"    , "narrator": "アーヤ", "text": "秘密を話したりしてることを考えると"},
        { "location": "387/TALK"    , "narrator": "アーヤ", "text": "はっきりさせておかないといけないことだから"},
        { "location": "388/TALK"    , "narrator": "アーヤ", "text": "プライバシーに関わる話だし(>_<)"},
        { "location": "389/ACT"     , "narrator": "", "text": "$me$の時代キター！"},
        { "location": "390/TALK"    , "narrator": "アーヤ", "text": "は？(￣Д￣ )"},
        { "location": "391/TALK"    , "narrator": "アーヤ", "text": "何そのテンション？"},
        { "location": "392/TALK"    , "narrator": "アーヤ", "text": "そんなに喜ぶなら"},
        { "location": "394/TALK"    , "narrator": "アーヤ", "text": "自分から話せばよかったのに( ・_・)σﾞ"},
        { "location": "407/TALK"    , "narrator": "ガブリエラ", "text": "ああもう、話にならない！"},
        { "location": "408/TALK"    , "narrator": "ガブリエラ", "text": "とにかく、あたしは\nそんな話信じないから。"},
        { "location": "410/TALK"    , "narrator": "アーヤ", "text": "そうね。\n確かにそう。"},
        { "location": "411/TALK"    , "narrator": "アーヤ", "text": "もちろん、私だって\n混乱はしてる。"},
        { "location": "412/TALK"    , "narrator": "アーヤ", "text": "それでもね。\nできるだけ、冷静に対応を\nしようと思ってるわ。"},
        { "location": "413/TALK"    , "narrator": "アーヤ", "text": "だから、もしみんなが\n今後のＢｏｔとの\n付き合い方とかで――"},
        { "location": "415/TALK"    , "narrator": "アーヤ", "text": "わからないことがあれば、\nいつでも相談してくれて\n構わないから。"},
        { "location": "416/TALK"    , "narrator": "アーヤ", "text": "私の話は以上よ。\nそれじゃ、今夜は解散。"},
        { "location": "418/TALK"    , "narrator": "つばめ", "text": "はい、お疲れ様でした。\nおやすみなさい。"},
        { "location": "422/TALK"    , "narrator": "ガブリエラ", "text": "まったく、こんなふざけた\n話のために、一々人のこと\n呼び出さないでよね！"},
        { "location": "425/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "427/TALK"    , "narrator": "みやび", "text": "突然の話やったき、\n受け入れられん\nだけやと思うぞね。"},
        { "location": "429/TALK"    , "narrator": "アーヤ", "text": "私だってそうよ。\n完全に信じてる\nわけじゃないわ。"},
        { "location": "430/TALK"    , "narrator": "アーヤ", "text": "結局、半端なく\n高性能なＢｏｔの\n可能性も捨てきれない。"},
        { "location": "432/TALK"    , "narrator": "みやび", "text": "……まあな。"},
        { "location": "434/TALK"    , "narrator": "みやび", "text": "うちはその線は\n明らかに越えちゅうと\n思うけんど。"},
        { "location": "436/TALK"    , "narrator": "みやび", "text": "みんながみんな\nすっと納得は\nできんろう。"},
        { "location": "438/TALK"    , "narrator": "みやび", "text": "相手の顔を\n見たわけでもなし。"},
        { "location": "440/TALK"    , "narrator": "アーヤ", "text": "本当。\nせめてそれが\nできればね……。"},
        { "location": "291/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月某日　10:05 PM</color>\n平日の夜、神楽坂トライナリーのホワイエにて。"}
    ]
}
