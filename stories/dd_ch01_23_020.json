{
    "dir": "chap23/daydra/dd_ch01_23_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "23156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "夏休みの宿題"
    },
    "entry":
    [
        { "location": "346/SCENARIO", "narrator": "", "text": "夏休みの宿題"},
        { "location": "359/TALK"    , "narrator": "つばめ", "text": "はぁ…やってもやっても\n全然終わらないよぉ…。"},
        { "location": "360/TALK"    , "narrator": "ガブリエラ", "text": "合宿の間、夏休みの宿題を\n全然やらなかったのは\nつばめでしょ？"},
        { "location": "361/TALK"    , "narrator": "ガブリエラ", "text": "自業自得よ。"},
        { "location": "362/TALK"    , "narrator": "つばめ", "text": "ううう、っていうか、\nガブちゃんは\nいつやってたの？"},
        { "location": "363/TALK"    , "narrator": "ガブリエラ", "text": "初日に終わらせたわ。\n残しといても面倒だし。"},
        { "location": "364/TALK"    , "narrator": "つばめ", "text": "…ガブちゃんって、\n本当凄いよね…。"},
        { "location": "366/TALK"    , "narrator": "ガブリエラ", "text": "当然のこと言ってないで、\n手と頭を動かしなさい。"},
        { "location": "368/TALK"    , "narrator": "つばめ", "text": "は、はい！\nえっと、次の問題は…。"},
        { "location": "370/TALK"    , "narrator": "ガブリエラ", "text": "あ、その前にこことここ、\n間違ってるから直して。"},
        { "location": "373/TALK"    , "narrator": "つばめ", "text": "うわーん！\n全然進まないよぉー！"},
        { "location": "380/TALK"    , "narrator": "つばめ", "text": "お、終わったぁ…。"},
        { "location": "381/TALK"    , "narrator": "ガブリエラ", "text": "はい、お疲れ。\nやればできるじゃない。"},
        { "location": "382/TALK"    , "narrator": "つばめ", "text": "え、えへへ…、\nガブちゃんのスパルタ\n指導のおかげだよ…。"},
        { "location": "383/TALK"    , "narrator": "つばめ", "text": "夕方になっちゃった…。\nごめんね、長い時間\n手伝ってもらって…。"},
        { "location": "384/TALK"    , "narrator": "ガブリエラ", "text": "べ、別にいいわよ。\nやることなかったんだし、\nただの暇つぶしよ。"},
        { "location": "385/TALK"    , "narrator": "つばめ", "text": "それでも、ありがと。\nやっぱりガブちゃんは\n頼りになるなぁ。"},
        { "location": "386/TALK"    , "narrator": "ガブリエラ", "text": "だから、別にいいって…。"},
        { "location": "387/TALK"    , "narrator": "つばめ", "text": "あ、そうだ！\nガブちゃん、もう少しだけ\n付き合ってもらえる？"},
        { "location": "388/TALK"    , "narrator": "つばめ", "text": "宿題手伝ってもらった\nお礼に、アイス奢るよ。"},
        { "location": "389/TALK"    , "narrator": "ガブリエラ", "text": "やった！\nそういうことなら\n喜んで付き合うわ。"},
        { "location": "391/TALK"    , "narrator": "つばめ", "text": "ふふっ、それじゃあ、\n買いに行こっか。"},
        { "location": "405/TALK"    , "narrator": "ガブリエラ", "text": "…合宿も、\nもうすぐ終わりね。"},
        { "location": "407/TALK"    , "narrator": "つばめ", "text": "そうだね…。\n何か、帰りたくないな…。"},
        { "location": "408/TALK"    , "narrator": "ガブリエラ", "text": "そうね…。\nみやびの家、\nとっても素敵だし…。"},
        { "location": "411/TALK"    , "narrator": "つばめ", "text": "ガブちゃん、\n本当にみやびさんの家が\n好きなんだね。"},
        { "location": "414/TALK"    , "narrator": "ガブリエラ", "text": "あんな立派な日本家屋が\n実家だなんて…、\nみやびは幸せ者よ。"},
        { "location": "417/TALK"    , "narrator": "ガブリエラ", "text": "…でもまあ、そろそろ\nベッドが恋しくなっても\nいるのよね。"},
        { "location": "418/TALK"    , "narrator": "つばめ", "text": "あはは…やっぱり、\nベッドに慣れてると\n布団は辛いよね…。"},
        { "location": "419/TALK"    , "narrator": "ガブリエラ", "text": "特に訓練でヘトヘトの\n身体にはね。"},
        { "location": "422/TALK"    , "narrator": "つばめ", "text": "うん…本当、毎日のように\n訓練だったから、\nビックリしたなぁ…。"},
        { "location": "423/TALK"    , "narrator": "ガブリエラ", "text": "もっとお出かけしたり、\n遊んだりしたかったわ。"},
        { "location": "424/TALK"    , "narrator": "つばめ", "text": "うん…ふふっ…。"},
        { "location": "428/TALK"    , "narrator": "ガブリエラ", "text": "？　何がおかしいのよ？"},
        { "location": "431/TALK"    , "narrator": "つばめ", "text": "うん…今は当たり前に\nなってるけど、覚えてる？"},
        { "location": "432/TALK"    , "narrator": "つばめ", "text": "少し前まで、ガブちゃんと\nお話ししながら歩くなんて\n考えられなかったから…。"},
        { "location": "433/TALK"    , "narrator": "ガブリエラ", "text": "うっ…。"},
        { "location": "434/TALK"    , "narrator": "つばめ", "text": "あの時のわたしは\n信じられないだろうなぁ。"},
        { "location": "435/TALK"    , "narrator": "つばめ", "text": "まさか、ガブちゃんと\nこんなに仲良くなって――"},
        { "location": "436/TALK"    , "narrator": "ガブリエラ", "text": "す、すとーっぷ！\nその頃の話はしなくて\nいいから！"},
        { "location": "437/TALK"    , "narrator": "つばめ", "text": "でも――"},
        { "location": "438/TALK"    , "narrator": "ガブリエラ", "text": "言うこと聞きなさいよ！"},
        { "location": "439/TALK"    , "narrator": "ガブリエラ", "text": "先輩の命令が聞けない\nっていうの？\nバカ新人！"},
        { "location": "440/TALK"    , "narrator": "つばめ", "text": "は、はい！\nごめんなさい、\nガブリエラせんぱい…！"},
        { "location": "441/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "442/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "445/TALK"    , "narrator": "ガブリエラ", "text": "ぷっ…新人って…。\nなんか、久しぶりに\n言ったわ。"},
        { "location": "448/TALK"    , "narrator": "つばめ", "text": "えへへ…わたしもつい、\nせんぱいって\n言っちゃいました。"},
        { "location": "451/TALK"    , "narrator": "ガブリエラ", "text": "せんぱいって呼ぶ方が\nしっくりくるなら、\n戻してもいいけど？"},
        { "location": "455/TALK"    , "narrator": "つばめ", "text": "ううん、ガブちゃんって\n呼ぶ方が好きだから、\nこのままがいいな。"},
        { "location": "456/TALK"    , "narrator": "ガブリエラ", "text": "ふーん…まあ、つばめが\n好きな方で構わないけど。"},
        { "location": "457/SEL"     , "narrator": "", "text": "イチャイチャタイム？"},
        { "location": "460/TALK"    , "narrator": "つばめ", "text": "えへへ…ガブちゃん。"},
        { "location": "462/TALK"    , "narrator": "ガブリエラ", "text": "な、なによ？"},
        { "location": "464/TALK"    , "narrator": "つばめ", "text": "ううん、呼んでみただけ。"},
        { "location": "465/TALK"    , "narrator": "ガブリエラ", "text": "あ、あのね…。"},
        { "location": "469/TALK"    , "narrator": "ガブリエラ", "text": "バカなことやってないで、\nさっさとアイス買いに\n行くわよ。"},
        { "location": "470/TALK"    , "narrator": "つばめ", "text": "うん…行こ、ガブちゃん。"},
        { "location": "473/ACT"     , "narrator": "", "text": "イチャイチャタイム？"},
        { "location": "487/TALK"    , "narrator": "つばめ", "text": "本当？(´,,･ω･,,｀)"},
        { "location": "488/TALK"    , "narrator": "つばめ", "text": "わたしとガブちゃん"},
        { "location": "489/TALK"    , "narrator": "つばめ", "text": "仲良しに見ぇる？o(*･ﾛ･*)o、"},
        { "location": "491/SEL"     , "narrator": "", "text": "ガブリエラに聞いてみよう"},
        { "location": "492/ACT"     , "narrator": "", "text": "ガブリエラに聞いてみよう"},
        { "location": "494/TALK"    , "narrator": "つばめ", "text": "そぅだねヽ(*´∀｀*)ﾉ"},
        { "location": "495/TALK"    , "narrator": "つばめ", "text": "直接ガブちゃんに"},
        { "location": "496/TALK"    , "narrator": "つばめ", "text": "聞いてみる(*≧∀≦*) "},
        { "location": "504/TALK"    , "narrator": "つばめ", "text": "ねえ、ガブちゃん。"},
        { "location": "508/TALK"    , "narrator": "ガブリエラ", "text": "ん？　どうかした？"},
        { "location": "509/TALK"    , "narrator": "つばめ", "text": "わたしたち、\n仲良しに見えるかな？"},
        { "location": "512/TALK"    , "narrator": "ガブリエラ", "text": "は、はぁ！？\nなによ急に…。"},
        { "location": "513/TALK"    , "narrator": "つばめ", "text": "他の人から見て、\nイチャイチャしてるように\n見えるみたいだから…。"},
        { "location": "514/TALK"    , "narrator": "ガブリエラ", "text": "イチャイチャ！？"},
        { "location": "515/TALK"    , "narrator": "ガブリエラ", "text": "いや、ないない！\n普通に歩いてるだけ\nでしょ！？"},
        { "location": "516/TALK"    , "narrator": "つばめ", "text": "そうかな？"},
        { "location": "517/TALK"    , "narrator": "ガブリエラ", "text": "そうでしょうが！"},
        { "location": "520/TALK"    , "narrator": "つばめ", "text": "そっかぁ…。"},
        { "location": "521/TALK"    , "narrator": "ガブリエラ", "text": "大体、そういうのは\n男の子と一緒にいる\nときに――"},
        { "location": "524/TALK"    , "narrator": "ガブリエラ", "text": "…はぁ。\nううん、やっぱいいわ。"},
        { "location": "525/TALK"    , "narrator": "つばめ", "text": "あ、あれ？\nどうして急にため息？"},
        { "location": "528/TALK"    , "narrator": "ガブリエラ", "text": "つばめは天然だから、\n何言っても無駄、って\n思ったのよ。"},
        { "location": "529/TALK"    , "narrator": "つばめ", "text": "て、天然って\n言わないでよぉ…。"},
        { "location": "530/SEL"     , "narrator": "", "text": "つばめのこと、理解してくれてるね"},
        { "location": "533/TALK"    , "narrator": "ガブリエラ", "text": "本当のことじゃん。\n入隊したときから\nずーっと治らないし。"},
        { "location": "535/TALK"    , "narrator": "つばめ", "text": "っていうか、わたしって\nそんなに天然なのかな？"},
        { "location": "536/TALK"    , "narrator": "ガブリエラ", "text": "みんなに聞いてみれば？\n口を揃えて天然って\n返されるだろうけど。"},
        { "location": "540/TALK"    , "narrator": "つばめ", "text": "うう…治ればいいん\nだけどなぁ…。"},
        { "location": "542/TALK"    , "narrator": "ガブリエラ", "text": "あはは、どうかしらね？"},
        { "location": "543/TALK"    , "narrator": "ガブリエラ", "text": "…ま、そのまんまでも\nあたしは嫌いじゃないん\nだけど…。"},
        { "location": "545/ACT"     , "narrator": "", "text": "つばめのこと、理解してくれてるね"},
        { "location": "559/TALK"    , "narrator": "つばめ", "text": "そぅぃぅことなの？(･Д･｀)"},
        { "location": "561/SEL"     , "narrator": "", "text": "受け入れてくれた証拠だよ"},
        { "location": "562/ACT"     , "narrator": "", "text": "受け入れてくれた証拠だよ"},
        { "location": "565/TALK"    , "narrator": "つばめ", "text": "そっか"},
        { "location": "566/TALK"    , "narrator": "つばめ", "text": "そぅだよね(≧ω≦)"},
        { "location": "567/TALK"    , "narrator": "つばめ", "text": "ぁりがとぅ、$handle$さん"},
        { "location": "574/TALK"    , "narrator": "つばめ", "text": "えへへ…。"},
        { "location": "579/TALK"    , "narrator": "ガブリエラ", "text": "…こ、今度はなによ？"},
        { "location": "580/TALK"    , "narrator": "つばめ", "text": "ガブちゃんに受け入れて\nもらえて、嬉しいなぁ、\nって…。"},
        { "location": "581/TALK"    , "narrator": "ガブリエラ", "text": "はい！？"},
        { "location": "584/TALK"    , "narrator": "つばめ", "text": "前は怒ってたけど、\n今は天然なの理解して、\n怒らないでくれたでしょ？"},
        { "location": "585/TALK"    , "narrator": "つばめ", "text": "それって、わたしのこと\n理解して、受け入れて\nくれた、ってことだよね。"},
        { "location": "587/TALK"    , "narrator": "ガブリエラ", "text": "ち、違うから！"},
        { "location": "589/TALK"    , "narrator": "ガブリエラ", "text": "そりゃ、確かに前より\nつばめのことは理解しては\nいるけど…。"},
        { "location": "592/TALK"    , "narrator": "ガブリエラ", "text": "でも、受け入れたとか、\nそういうのないから！"},
        { "location": "593/TALK"    , "narrator": "つばめ", "text": "そ、そうなの？"},
        { "location": "596/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、言い方！\nもうちょっとこう、\n普通の言い方ないわけ？"},
        { "location": "597/TALK"    , "narrator": "つばめ", "text": "普通…普通…。"},
        { "location": "598/TALK"    , "narrator": "つばめ", "text": "あっ、好きになって\nもらえた、とか？"},
        { "location": "599/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "600/TALK"    , "narrator": "つばめ", "text": "あ、あれ？"},
        { "location": "601/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…そういうセリフを\n平然と言えるとこも、\n天然だからこそよね…。"},
        { "location": "602/TALK"    , "narrator": "つばめ", "text": "ま、また天然って\n言ったぁ…。"},
        { "location": "603/TALK"    , "narrator": "ガブリエラ", "text": "ヘコむんじゃないの。\n悪口で言ってるわけじゃ\nないんだし…。"},
        { "location": "604/TALK"    , "narrator": "ガブリエラ", "text": "…恥ずかしがって言えない\nあたしには、ちょっとだけ\n羨ましいわ。"},
        { "location": "357/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月27日　 0:56 PM</color>\n合宿中、みやびの実家でのこと"}
    ]
}
