        "title": "Extra003 ヒメゴトチャット",
        "sub_title": "絶望という名の希望"
    },
    "entry":
    [
        { "location": "4359/SCENARIO", "narrator": "", "text": "絶望という名の希望"},
        { "location": "4384/TALK"    , "narrator": "神楽", "text": "昏い暗い井戸の底に閉じ込められていた少女は"},
        { "location": "4385/TALK"    , "narrator": "神楽", "text": "月の光ほど明るい光はないと思っていた"},
        { "location": "4386/TALK"    , "narrator": "神楽", "text": "井戸から出たその日まで"},
        { "location": "4388/SEL"     , "narrator": "", "text": "太陽は差さなかったわけ？"},
        { "location": "4389/SEL"     , "narrator": "", "text": "また何か受信してる？"},
        { "location": "4390/SEL"     , "narrator": "", "text": "井戸から出れてよかったね…"},
        { "location": "4391/ACT"     , "narrator": "", "text": "太陽は差さなかったわけ？"},
        { "location": "4392/TALK"    , "narrator": "神楽", "text": "そういうことになるのか"},
        { "location": "4394/TALK"    , "narrator": "神楽", "text": "まあいいや！"},
        { "location": "4395/ACT"     , "narrator": "", "text": "また何か受信してる？"},
        { "location": "4396/TALK"    , "narrator": "神楽", "text": "違うぴょん"},
        { "location": "4397/TALK"    , "narrator": "神楽", "text": "ぴょんこの内面から湧き出してるぴょん"},
        { "location": "4398/ACT"     , "narrator": "", "text": "井戸から出れてよかったね…"},
        { "location": "4400/TALK"    , "narrator": "神楽", "text": "そうかも"},
        { "location": "4401/TALK"    , "narrator": "神楽", "text": "$handlek$って優しいよね"},
        { "location": "4402/TALK"    , "narrator": "神楽", "text": "時々びっくりしてその後ほっこりするぴょん"},
        { "location": "4404/TALK"    , "narrator": "神楽", "text": "月の光しか知らなかった少女には日の光が眩しすぎて"},
        { "location": "4405/TALK"    , "narrator": "神楽", "text": "日中は目を閉じて過ごすことしかできなかった"},
        { "location": "4407/SEL"     , "narrator": "", "text": "そんなことってあるの？"},
        { "location": "4408/SEL"     , "narrator": "", "text": "日常生活できなくない？"},
        { "location": "4409/SEL"     , "narrator": "", "text": "徐々に慣れていけたのかな？"},
        { "location": "4410/ACT"     , "narrator": "", "text": "そんなことってあるの？"},
        { "location": "4411/TALK"    , "narrator": "神楽", "text": "あるってことに汁！"},
        { "location": "4412/ACT"     , "narrator": "", "text": "日常生活できなくない？"},
        { "location": "4413/TALK"    , "narrator": "神楽", "text": "できないんじゃない？"},
        { "location": "4414/ACT"     , "narrator": "", "text": "徐々に慣れていけたのかな？"},
        { "location": "4416/TALK"    , "narrator": "神楽", "text": "きっとそう"},
        { "location": "4417/TALK"    , "narrator": "神楽", "text": "少女のペースで生きていくしかないから"},
        { "location": "4419/TALK"    , "narrator": "神楽", "text": "それは誰にも強制できないし"},
        { "location": "4421/TALK"    , "narrator": "神楽", "text": "外の世界は時々とても冷たかったりしたけれど"},
        { "location": "4422/TALK"    , "narrator": "神楽", "text": "それでも少女は井戸に戻るという選択だけはしなかった"},
        { "location": "4423/TALK"    , "narrator": "神楽", "text": "その代わりにラジオを聴いて言葉を憶え、自分を説明する努力をした"},
        { "location": "4424/TALK"    , "narrator": "神楽", "text": "幸せかい？という問いにはまだはいと答えることができないけれど"},
        { "location": "4425/TALK"    , "narrator": "神楽", "text": "空に浮かぶのは月だけじゃないことを知れたことは、幸せの一片かもしれないと少女は思うのだった"}
    ]
}
