{
    "dir": "chap08/daydra/dd_ch01_08_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "8105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "大胆勝負～Case1～＜後編＞"
    },
    "entry":
    [
        { "location": "387/SCENARIO", "narrator": "", "text": "大胆勝負"},
        { "location": "408/TALK"    , "narrator": "つばめ", "text": "わたし、どうして\n卯月さんとなら――"},
        { "location": "409/TALK"    , "narrator": "つばめ", "text": "上手くやっていける、\nって思ったんだろ？"},
        { "location": "410/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "412/TALK"    , "narrator": "つばめ", "text": "う～ん……。"},
        { "location": "413/TALK"    , "narrator": "つばめ", "text": "…まあ、いっか。\nそのうちわかるかも\nしれないし。"},
        { "location": "414/TALK"    , "narrator": "神楽", "text": "じーっ……。"},
        { "location": "415/TALK"    , "narrator": "つばめ", "text": "って、卯月さん？\nどこ見てるの…？"},
        { "location": "416/TALK"    , "narrator": "神楽", "text": "うーん…やっぱり\n思った通りでした。"},
        { "location": "417/TALK"    , "narrator": "神楽", "text": "さっき触った時から、\nもしかして、と\n思ってたんです。"},
        { "location": "418/TALK"    , "narrator": "神楽", "text": "つばめさんって、\n結構胸ありますよね？"},
        { "location": "421/TALK"    , "narrator": "つばめ", "text": "む、胸！？"},
        { "location": "423/TALK"    , "narrator": "神楽", "text": "はい。\nあんなに柔らかいとは\n思わなかったから――"},
        { "location": "425/TALK"    , "narrator": "神楽", "text": "つい、たくさん\n揉んじゃいましたー。"},
        { "location": "428/TALK"    , "narrator": "つばめ", "text": "ひ、酷いよー！"},
        { "location": "430/TALK"    , "narrator": "神楽", "text": "ごめんなさい。\nでも、本当にとっても\n柔らかくて…。"},
        { "location": "432/TALK"    , "narrator": "神楽", "text": "というわけで、酷い\nついでに、もう一回\nだけお願いします！"},
        { "location": "436/TALK"    , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "437/SEL"     , "narrator": "", "text": "卯月さんならいいよ？　と恥ずかしそうに言え！"},
        { "location": "438/SEL"     , "narrator": "", "text": "それじゃあ、って胸を差し出せ"},
        { "location": "440/TALK"    , "narrator": "神楽", "text": "もう、さっきから\nえっ、とか、えぇっ、\nとかばかりですね？"},
        { "location": "442/TALK"    , "narrator": "神楽", "text": "ここは、卯月さんなら\nいいよ、って差し出す\nところですよ。"},
        { "location": "446/TALK"    , "narrator": "つばめ", "text": "む、ムリムリ！！\nそんなこと\n言えないよ！"},
        { "location": "448/TALK"    , "narrator": "神楽", "text": "はぁ…残念。\nお風呂でもっと触って\nおくべきでした…。"},
        { "location": "449/TALK"    , "narrator": "つばめ", "text": "もぅ、恥ずかしくて、\nまたのぼせちゃい\nそうだよ…。"},
        { "location": "451/ACT"     , "narrator": "", "text": "卯月さんならいいよ？　と恥ずかしそうに言え！"},
        { "location": "484/TALK"    , "narrator": "つばめ", "text": "恥ずかしそうにとか\n言われなくても――"},
        { "location": "485/TALK"    , "narrator": "つばめ", "text": "そんなこと言うの、\n恥ずかしそうにしか\n言えないよ…。"},
        { "location": "486/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "489/TALK"    , "narrator": "神楽", "text": "減るもんじゃないん\nですし、もう一回だけ\nお願いします！"},
        { "location": "490/TALK"    , "narrator": "つばめ", "text": "…わ、わかったよ。"},
        { "location": "491/TALK"    , "narrator": "神楽", "text": "え？"},
        { "location": "493/TALK"    , "narrator": "つばめ", "text": "卯月さんなら…、\nい、いい、よ…。"},
        { "location": "496/TALK"    , "narrator": "神楽", "text": "っ！？"},
        { "location": "498/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "499/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "500/TALK"    , "narrator": "つばめ", "text": "…？\n卯月さん？"},
        { "location": "503/TALK"    , "narrator": "神楽", "text": "…だ、ダメじゃない\nですか、つばめさん。"},
        { "location": "505/TALK"    , "narrator": "神楽", "text": "そこは、絶対に\n断らなくちゃ\nいけないところです！"},
        { "location": "509/TALK"    , "narrator": "つばめ", "text": "えぇぇぇぇぇっ！？\nな、なんで！？"},
        { "location": "510/TALK"    , "narrator": "つばめ", "text": "言ってること\nコロコロ変わり過ぎて\nわからないよ！"},
        { "location": "512/TALK"    , "narrator": "神楽", "text": "ダメなものは\nダメなんです！"},
        { "location": "514/TALK"    , "narrator": "神楽", "text": "っていうか、そんな\nこと言われたら――"},
        { "location": "516/TALK"    , "narrator": "神楽", "text": "私…本当に、\nダメな子になっちゃう\nじゃないですか…。"},
        { "location": "518/TALK"    , "narrator": "つばめ", "text": "どういうこと？\nどうして卯月さんが\nダメな子に――"},
        { "location": "520/TALK"    , "narrator": "神楽", "text": "もう、そんなこと\n言ったらダメですよ？"},
        { "location": "524/TALK"    , "narrator": "つばめ", "text": "あっ、卯月さん…。"},
        { "location": "525/TALK"    , "narrator": "つばめ", "text": "…行っちゃった。\nどういうことなん\nだろ？"},
        { "location": "526/TALK"    , "narrator": "つばめ", "text": "もしかしてわたし、\n変なこと言っちゃっ\nたのかな？"},
        { "location": "527/TALK"    , "narrator": "つばめ", "text": "…嫌われちゃって\nたら、イヤだな…。"},
        { "location": "529/TALK"    , "narrator": "つばめ", "text": "都会の子の会話って、\n難しいよぉ…。"},
        { "location": "530/ACT"     , "narrator": "", "text": "それじゃあ、って胸を差し出せ"},
        { "location": "563/TALK"    , "narrator": "つばめ", "text": "もしかして、女の子\n同士ならこれくらい\n普通なのかな？"},
        { "location": "564/TALK"    , "narrator": "つばめ", "text": "それなら、恥ずかし\nがってるのは\n変だよね。"},
        { "location": "567/TALK"    , "narrator": "つばめ", "text": "それじゃあ…。"},
        { "location": "570/TALK"    , "narrator": "神楽", "text": "えっ！？\nちょ、な、何やって\nるんですか！？"},
        { "location": "571/TALK"    , "narrator": "つばめ", "text": "え？　卯月さん、\nまた揉みたいって\n言うから――"},
        { "location": "572/TALK"    , "narrator": "つばめ", "text": "まあいいかな、って\n思って…。"},
        { "location": "574/TALK"    , "narrator": "神楽", "text": "いいかな！？"},
        { "location": "576/TALK"    , "narrator": "つばめ", "text": "うん。\nはい、どうぞ。"},
        { "location": "577/TALK"    , "narrator": "神楽", "text": "よ、よくないですよ！\nよくないに決まってる\nじゃないですか！？"},
        { "location": "578/TALK"    , "narrator": "神楽", "text": "それに、さっきは\nつばめさんも怒って\nたのに…。"},
        { "location": "580/TALK"    , "narrator": "つばめ", "text": "だって、さっきのは\n急だったんだもん。"},
        { "location": "583/TALK"    , "narrator": "つばめ", "text": "でも、今は心の準備\n出来てるから、\n大丈夫だよ。"},
        { "location": "585/TALK"    , "narrator": "神楽", "text": "こ、心の準備って…。"},
        { "location": "587/TALK"    , "narrator": "つばめ", "text": "えへへ…どうぞ、\n卯月さん。"},
        { "location": "589/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "591/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "593/TALK"    , "narrator": "つばめ", "text": "…？\n卯月さん、\nどうしたの？"},
        { "location": "595/TALK"    , "narrator": "神楽", "text": "…もー！！"},
        { "location": "597/TALK"    , "narrator": "神楽", "text": "つばめさんの、\nばかーーー！！"},
        { "location": "601/TALK"    , "narrator": "つばめ", "text": "あっ、卯月さん！？"},
        { "location": "602/TALK"    , "narrator": "つばめ", "text": "…行っちゃった。\nどうしたんだろう？"},
        { "location": "604/TALK"    , "narrator": "つばめ", "text": "…もしかして、\n何か間違ったこと\nしちゃったのかな？"},
        { "location": "605/TALK"    , "narrator": "つばめ", "text": "嫌われてないと\nいいんだけど…。"},
        { "location": "606/TALK"    , "narrator": "つばめ", "text": "…都会の子って、\n難しいなぁ…。"},
        { "location": "618/DIALOG"  , "narrator": "Dialog_chapter_ch01", "text": "【06 史上最愛の作戦】"}
    ]
}
