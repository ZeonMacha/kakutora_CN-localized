    "entry":
    [
        { "location": "2284/SCENARIO", "narrator": "", "text": "カゴの中の世界線"},
        { "location": "2309/TALK"    , "narrator": "神楽", "text": "鳥かごの中の世界はどれもこれも驚くほど似通っている"},
        { "location": "2310/TALK"    , "narrator": "神楽", "text": "他人から与えられる幸福が全て同じ形をしているように"},
        { "location": "2312/SEL"     , "narrator": "", "text": "$me$の愛はオンリーワンのオリジナル"},
        { "location": "2313/SEL"     , "narrator": "", "text": "厭世的だ"},
        { "location": "2314/SEL"     , "narrator": "", "text": "厨二病なの？"},
        { "location": "2315/ACT"     , "narrator": "", "text": "$me$の愛はオンリーワンのオリジナル"},
        { "location": "2317/TALK"    , "narrator": "神楽", "text": "そんな言葉すら他の誰かと同じ"},
        { "location": "2318/TALK"    , "narrator": "神楽", "text": "でも"},
        { "location": "2319/TALK"    , "narrator": "神楽", "text": "真実ならばそれで十分"},
        { "location": "2320/ACT"     , "narrator": "", "text": "厭世的だ"},
        { "location": "2321/TALK"    , "narrator": "神楽", "text": "芸術的でしょ"},
        { "location": "2322/ACT"     , "narrator": "", "text": "厨二病なの？"},
        { "location": "2323/TALK"    , "narrator": "神楽", "text": "正統派のね"},
        { "location": "2325/TALK"    , "narrator": "神楽", "text": "実際ね"},
        { "location": "2326/TALK"    , "narrator": "神楽", "text": "クリエイティブの世界で求められているのは安心感のある新しいものでしかないわけ"},
        { "location": "2327/TALK"    , "narrator": "神楽", "text": "真に新しいものって受け入れられないのよねー"},
        { "location": "2330/SEL"     , "narrator": "", "text": "そうかもね"},
        { "location": "2331/SEL"     , "narrator": "", "text": "そういうもんなんだ？"},
        { "location": "2332/SEL"     , "narrator": "", "text": "神楽はそれができる子だよ"},
        { "location": "2333/ACT"     , "narrator": "", "text": "そうかもね"},
        { "location": "2334/TALK"    , "narrator": "神楽", "text": "ですよ"},
        { "location": "2335/ACT"     , "narrator": "", "text": "そういうもんなんだ？"},
        { "location": "2336/TALK"    , "narrator": "神楽", "text": "そうだから"},
        { "location": "2337/ACT"     , "narrator": "", "text": "神楽はそれができる子だよ"},
        { "location": "2339/TALK"    , "narrator": "神楽", "text": "そりゃできなくはないけどー"},
        { "location": "2340/TALK"    , "narrator": "神楽", "text": "っていうかしてるけどー"},
        { "location": "2341/TALK"    , "narrator": "神楽", "text": "$handlek$は気づいてたんだ"},
        { "location": "2342/TALK"    , "narrator": "神楽", "text": "偉い偉い！"},
        { "location": "2344/TALK"    , "narrator": "神楽", "text": "それがいいとか悪いとかじゃなくてそういうものだっていうだけなんだけどね"}
    ]
}
