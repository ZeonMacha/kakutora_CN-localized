        { "location": "171/TALK"   , "narrator": "ガブリエラ", "text": "知らないわ"},
        { "location": "172/TALK"   , "narrator": "ガブリエラ", "text": "どうかしたの？"},
        { "location": "174/SEL"    , "narrator": "", "text": "昨日の夜から連絡が取れない"},
