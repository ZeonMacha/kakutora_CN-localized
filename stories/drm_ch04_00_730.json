        { "location": "177/TALK"   , "narrator": "ガブリエラ", "text": "連絡が取れない？"},
        { "location": "178/TALK"   , "narrator": "ガブリエラ", "text": "部屋の様子がわかるなら"},
        { "location": "179/TALK"   , "narrator": "ガブリエラ", "text": "荷物がなくなってないか教えて"},
        { "location": "181/SEL"    , "narrator": "", "text": "無くなってはいない"},
        { "location": "182/ACT"    , "narrator": "", "text": "無くなってはいない"},
        { "location": "184/TALK"   , "narrator": "ガブリエラ", "text": "なら平気よ"},
        { "location": "185/TALK"   , "narrator": "ガブリエラ", "text": "慌てなくても、そのうち帰って来るわ"},
        { "location": "191/TALK"   , "narrator": "ガブリエラ", "text": "…帰って来るわよね？"},
        { "location": "203/SEL"    , "narrator": "", "text": "みやびを知らない？"},
        { "location": "204/ACT"    , "narrator": "", "text": "みやびを知らない？"},
        { "location": "210/TALK"   , "narrator": "アーヤ", "text": "あ、ちょっとすいません。"},
        { "location": "226/TALK"   , "narrator": "アーヤ", "text": "知らないけど"},
        { "location": "227/TALK"   , "narrator": "アーヤ", "text": "部屋にいないの？"},
        { "location": "229/SEL"    , "narrator": "", "text": "昨日の夜から連絡が取れない"},
        { "location": "230/ACT"    , "narrator": "", "text": "昨日の夜から連絡が取れない"},
        { "location": "232/TALK"   , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "233/TALK"   , "narrator": "アーヤ", "text": "昨日の夜から行方不明ってこと！？"},
        { "location": "235/SEL"    , "narrator": "", "text": "だから心配してる"},
        { "location": "236/ACT"    , "narrator": "", "text": "だから心配してる"},
        { "location": "238/TALK"   , "narrator": "アーヤ", "text": "どうしよう…"},
        { "location": "239/TALK"   , "narrator": "アーヤ", "text": "あの子"},
        { "location": "240/TALK"   , "narrator": "アーヤ", "text": "危ないことを時々してたのは知ってるけど"},
        { "location": "241/TALK"   , "narrator": "アーヤ", "text": "まさかそれが原因？"},
        { "location": "242/TALK"   , "narrator": "アーヤ", "text": "$handle$さんは心当たりない？"},
        { "location": "244/SEL"    , "narrator": "", "text": "さっぱりだよ"},
        { "location": "245/ACT"    , "narrator": "", "text": "さっぱりだよ"},
        { "location": "247/TALK"   , "narrator": "アーヤ", "text": "わかった"},
        { "location": "248/TALK"   , "narrator": "アーヤ", "text": "私も探してみるわ"},
        { "location": "260/TALK"   , "narrator": "真幌", "text": "…何かあったのか？"},
        { "location": "262/TALK"   , "narrator": "アーヤ", "text": "大変です。\nみやびが、昨日の夜から\n行方がわかりません。"},
        { "location": "263/TALK"   , "narrator": "真幌", "text": "…なんだと？\nＷＡＶＥで連絡は\n取れないのか？"},
        { "location": "264/TALK"   , "narrator": "アーヤ", "text": "スマホを置いていった\nみたいなんです。"},
        { "location": "265/TALK"   , "narrator": "アーヤ", "text": "まったく、何考えてるのよ\nあの子ってば…。"},
        { "location": "266/TALK"   , "narrator": "真幌", "text": "部屋を改めて見るか。\n何か手がかりがあるかも\nしれんし。"},
        { "location": "267/TALK"   , "narrator": "アーヤ", "text": "…いえ、やめましょう。"},
        { "location": "268/TALK"   , "narrator": "アーヤ", "text": "あの子の部屋の惨状は、\n館長も知っていますよね？"},
        { "location": "269/TALK"   , "narrator": "真幌", "text": "…そうだな。\n仮にあったとしても\n気付かないか…。"},
        { "location": "270/TALK"   , "narrator": "真幌", "text": "よし、私は車で学校の方を\n周りながら、ネカフェを\n周ってみるとしよう。"},
        { "location": "271/TALK"   , "narrator": "アーヤ", "text": "私も、近所を探しながら\n秋葉原の方まで行って\nみます。"},
        { "location": "272/TALK"   , "narrator": "真幌", "text": "ああ、よろしく頼む。"},
        { "location": "273/TALK"   , "narrator": "アーヤ", "text": "みやび…いったい、\n何があったのかしら…？"},
