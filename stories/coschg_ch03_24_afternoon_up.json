    "entry":
    [
        { "location": "80/TALK" , "narrator": "プレイヤー", "text": "今日はいつもと違う雰囲気でコーデしてみませんか？"},
        { "location": "82/TALK" , "narrator": "プレイヤー", "text": "お姫様、お召し替えのお時間ですよ"},
        { "location": "84/TALK" , "narrator": "プレイヤー", "text": "違う服のガブリエラが見たいよ"},
        { "location": "90/TALK" , "narrator": "プレイヤー", "text": "やあ"},
        { "location": "92/TALK" , "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "94/TALK" , "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "97/TALK" , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "98/TALK" , "narrator": "ガブリエラ", "text": "なにかしらこれ"},
        { "location": "100/SEL" , "narrator": "", "text": "あなたの$handle$です"},
        { "location": "101/ACT" , "narrator": "", "text": "あなたの$handle$です"},
        { "location": "103/TALK", "narrator": "ガブリエラ", "text": "いや、わかるわよ"},
        { "location": "104/TALK", "narrator": "ガブリエラ", "text": "メンテのお知らせとかかしら？"},
        { "location": "106/SEL" , "narrator": "", "text": "気分転換に着替えてみませんか？"},
        { "location": "107/ACT" , "narrator": "", "text": "気分転換に着替えてみませんか？"},
        { "location": "117/TALK", "narrator": "ガブリエラ", "text": "え？　それって要するに着替えてってこと？"},
        { "location": "118/TALK", "narrator": "ガブリエラ", "text": "まあ、良いけど…どれにしようかしら？"},
        { "location": "120/TALK", "narrator": "ガブリエラ", "text": "うーん///"},
        { "location": "121/TALK", "narrator": "ガブリエラ", "text": "まあ、ちょっとだけなら…"},
        { "location": "124/SEL" , "narrator": "", "text": "コーデするよ"},
        { "location": "125/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "127/TALK", "narrator": "ガブリエラ", "text": "そうねぇ…"},
        { "location": "130/TALK", "narrator": "ガブリエラ", "text": "やっぱり、今のままで良いわ"},
        { "location": "132/ACT" , "narrator": "", "text": "コーデするよ"},
        { "location": "133/TALK", "narrator": "ガブリエラ", "text": "あらそう？"},
        { "location": "134/TALK", "narrator": "ガブリエラ", "text": "それじゃあ、お任せするわ"},
        { "location": "140/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "141/TALK", "narrator": "ガブリエラ", "text": "だったら着替えてほしいとか言わないで"}
    ]
}
