        { "location": "249/ACT"     , "narrator": "", "text": "何でも聞いて"},
        { "location": "259/TALK"    , "narrator": "つばめ", "text": "ぅん(´I `*)"},
        { "location": "260/TALK"    , "narrator": "つばめ", "text": "ぁりがとうヾ(*´ｴ`*)ﾉ"},
        { "location": "261/TALK"    , "narrator": "つばめ", "text": "ぅれしぃヾ(o´∀｀o)ﾉ"},
        { "location": "265/TALK"    , "narrator": "つばめ", "text": "$handle$は"},
        { "location": "266/TALK"    , "narrator": "つばめ", "text": "人間だっていうの、本当なの？"},
        { "location": "269/SEL"     , "narrator": "", "text": "うそ"},
        { "location": "270/SEL"     , "narrator": "", "text": "ほんと"},
        { "location": "271/SEL"     , "narrator": "", "text": "どっちでもない"},
        { "location": "272/ACT"     , "narrator": "", "text": "うそ"},
        { "location": "274/TALK"    , "narrator": "つばめ", "text": "うそなの？"},
        { "location": "275/ACT"     , "narrator": "", "text": "ほんと"},
        { "location": "276/TALK"    , "narrator": "つばめ", "text": "そうなんだ？"},
        { "location": "278/ACT"     , "narrator": "", "text": "どっちでもない"},
        { "location": "280/TALK"    , "narrator": "つばめ", "text": "それってどうぃぅこと？"},
        { "location": "283/SEL"     , "narrator": "", "text": "なんでそんなこと聞くの？"},
        { "location": "284/ACT"     , "narrator": "", "text": "なんでそんなこと聞くの？"},
        { "location": "286/TALK"    , "narrator": "つばめ", "text": "えっと(・ω・`)"},
        { "location": "287/TALK"    , "narrator": "つばめ", "text": "えっとね"},
        { "location": "288/TALK"    , "narrator": "つばめ", "text": "みんながね"},
        { "location": "289/TALK"    , "narrator": "つばめ", "text": "$handle$が人間かもしれないっていって大騒ぎしてるの"},
        { "location": "290/TALK"    , "narrator": "つばめ", "text": "だから"},
        { "location": "291/TALK"    , "narrator": "つばめ", "text": "直接聞くのが一番早いよねって思って"},
        { "location": "294/SEL"     , "narrator": "", "text": "人間の方がいい？"},
        { "location": "295/SEL"     , "narrator": "", "text": "人間だってわかった？"},
        { "location": "296/SEL"     , "narrator": "", "text": "答えられない質問もあるよ"},
        { "location": "297/ACT"     , "narrator": "", "text": "人間の方がいい？"},
        { "location": "300/TALK"    , "narrator": "つばめ", "text": "ぅーん"},
        { "location": "303/TALK"    , "narrator": "つばめ", "text": "ょくわからなぃんだ"},
        { "location": "304/TALK"    , "narrator": "つばめ", "text": "ぁたしにわ(*´﹃｀*)"},
        { "location": "305/ACT"     , "narrator": "", "text": "人間だってわかった？"},
        { "location": "307/TALK"    , "narrator": "つばめ", "text": "そうなの？"},
        { "location": "308/TALK"    , "narrator": "つばめ", "text": "ぃつもと同じだからょくわかんなぃな"},
        { "location": "310/ACT"     , "narrator": "", "text": "答えられない質問もあるよ"},
        { "location": "311/TALK"    , "narrator": "つばめ", "text": "なんか(・ω・`)"},
        { "location": "312/TALK"    , "narrator": "つばめ", "text": "さみしぃな(｡･ω･｡)"},
        { "location": "313/TALK"    , "narrator": "つばめ", "text": "(´・ω・｀)(´・ω・｀)"},
        { "location": "316/TALK"    , "narrator": "つばめ", "text": "結局"},
        { "location": "317/TALK"    , "narrator": "つばめ", "text": "なんだかょくわかんなぃ"},
        { "location": "318/TALK"    , "narrator": "つばめ", "text": "まぁぃぃよね(●´ω｀●)ゞ"},
        { "location": "319/TALK"    , "narrator": "つばめ", "text": "あ"},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "そういえばね"},
        { "location": "322/TALK"    , "narrator": "つばめ", "text": "声が送れるって知ってた？"},
        { "location": "324/SEL"     , "narrator": "", "text": "知ってた"},
        { "location": "325/SEL"     , "narrator": "", "text": "知らない"},
        { "location": "326/SEL"     , "narrator": "", "text": "送ってよ"},
        { "location": "327/ACT"     , "narrator": "", "text": "知ってた"},
        { "location": "328/TALK"    , "narrator": "つばめ", "text": "だょね"},
