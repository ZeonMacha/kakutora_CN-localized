{
    "dir": "chap10/daydra/dd_ch02_10_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "10256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ネットショッピング"
    },
    "entry":
    [
        { "location": "164/SCENARIO", "narrator": "", "text": "ネットショッピング"},
        { "location": "183/TALK"    , "narrator": "アーヤ", "text": "う～ん…。"},
        { "location": "185/TALK"    , "narrator": "みやび", "text": "スマホ見つめて何を\n唸っちゅうが？"},
        { "location": "187/TALK"    , "narrator": "アーヤ", "text": "うん…いつも服を買う\nサイトなんだけど、\n新作が上がってるのよ。"},
        { "location": "188/TALK"    , "narrator": "みやび", "text": "お買い物前の\nシンキングタイムか。"},
        { "location": "191/TALK"    , "narrator": "アーヤ", "text": "う～ん…でも、\n今回はやめておくわ。"},
        { "location": "195/TALK"    , "narrator": "アーヤ", "text": "今月は少し買い過ぎた\nから、節約しようって\n決めたの。"},
        { "location": "198/TALK"    , "narrator": "みやび", "text": "しっかり者のアーヤが\n買い過ぎとは…\n珍しい事もあるもんやね。"},
        { "location": "199/TALK"    , "narrator": "アーヤ", "text": "商品入れ替えとか、\n在庫処分セールが\nあちこちでやってたのよ。"},
        { "location": "200/TALK"    , "narrator": "アーヤ", "text": "欲しいと思ってた\n服や靴が、軒並み\n破格になってて…。"},
        { "location": "201/TALK"    , "narrator": "みやび", "text": "抑えられなくなった、\nいうわけか。"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "アーヤも女の子やね。"},
        { "location": "203/TALK"    , "narrator": "アーヤ", "text": "だって、どれも素敵で\n欲しかったんだもん。"},
        { "location": "205/TALK"    , "narrator": "アーヤ", "text": "でも、しばらくは\n本気で控えないと…。"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "買い過ぎた思うんなら、\nそれがえいね。"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "…Ｂｏｔにも\n言っておいた方が\nえいんやないがか？"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "もしもの時には\n止めてくれるかも\nしれんちや。"},
        { "location": "210/TALK"    , "narrator": "アーヤ", "text": "…そうね。\nちょっと言ってみる。"},
        { "location": "224/TALK"    , "narrator": "アーヤ", "text": "ちょっといい？"},
        { "location": "226/SEL"     , "narrator": "", "text": "買い過ぎたって？"},
        { "location": "227/ACT"     , "narrator": "", "text": "買い過ぎたって？"},
        { "location": "229/TALK"    , "narrator": "アーヤ", "text": "はい…(-ω-;)"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "だから、もしまた買い物しようとしてたら"},
        { "location": "231/TALK"    , "narrator": "アーヤ", "text": "止めてもらいたいの"},
        { "location": "233/SEL"     , "narrator": "", "text": "止めたら買わない？"},
        { "location": "234/SEL"     , "narrator": "", "text": "買いたい時が買い時だよ"},
        { "location": "235/SEL"     , "narrator": "", "text": "しばらく着るのを楽しもう"},
        { "location": "236/ACT"     , "narrator": "", "text": "止めたら買わない？"},
        { "location": "237/TALK"    , "narrator": "アーヤ", "text": "もちろん！"},
        { "location": "238/TALK"    , "narrator": "アーヤ", "text": "…多分"},
        { "location": "240/TALK"    , "narrator": "アーヤ", "text": "もし、凄く良いのがあったら"},
        { "location": "241/TALK"    , "narrator": "アーヤ", "text": "買っちゃうかも…"},
        { "location": "252/TALK"    , "narrator": "アーヤ", "text": "…私って、意志が弱いの\nかしら？"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "本当に弱い奴やったら、\n節約しようなんて\n思わんよ。"},
        { "location": "255/TALK"    , "narrator": "アーヤ", "text": "買う気が起きなくなる\n方法みたいなのって、\nないかしら？"},
        { "location": "256/TALK"    , "narrator": "みやび", "text": "…ショップのページを\n見んようにするいうんは\nどうちや？"},
        { "location": "257/TALK"    , "narrator": "みやび", "text": "見なきゃどんな服が\nあるかもわからんちや。"},
        { "location": "259/TALK"    , "narrator": "アーヤ", "text": "簡単そうに聞こえるけど、\nそれ、凄く難しいわね。"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "アーヤの意志が強いんは\nよーく知ってるちや。"},
        { "location": "262/TALK"    , "narrator": "みやび", "text": "大丈夫やと信じてるき。"},
        { "location": "266/TALK"    , "narrator": "アーヤ", "text": "…お気に入りから、\nショップのページを\n外しておくわ。"},
        { "location": "267/ACT"     , "narrator": "", "text": "買いたい時が買い時だよ"},
        { "location": "270/TALK"    , "narrator": "アーヤ", "text": "やっぱり、いいわ"},
        { "location": "281/TALK"    , "narrator": "みやび", "text": "止めてくれそうやったか？"},
        { "location": "283/TALK"    , "narrator": "アーヤ", "text": "無理だと思う。\n買いたい時が買い時、\nって言われたし…。"},
        { "location": "284/TALK"    , "narrator": "みやび", "text": "間違ってはおらんと\n思うけんど？"},
        { "location": "286/TALK"    , "narrator": "アーヤ", "text": "私が買い過ぎた原因って、\nそれを思ったからなの。"},
        { "location": "287/TALK"    , "narrator": "みやび", "text": "…それじゃ期待できんな。"},
        { "location": "288/TALK"    , "narrator": "みやび", "text": "けんど、アーヤでも\nそんなこと考えるんやね？"},
        { "location": "289/TALK"    , "narrator": "アーヤ", "text": "本当に欲しいと\n思ってた服だからよ。"},
        { "location": "290/TALK"    , "narrator": "みやび", "text": "なら、使い過ぎっちゅう\n後悔はあっても――"},
        { "location": "291/TALK"    , "narrator": "みやび", "text": "買ったことを\n後悔はしてないようやね。"},
        { "location": "292/TALK"    , "narrator": "アーヤ", "text": "…そのことに関しては、\n安く買えて嬉しい、って\n気持ちよ。"},
        { "location": "293/TALK"    , "narrator": "みやび", "text": "なら、とりあえずそれで\nえいと思うがよ。"},
        { "location": "295/TALK"    , "narrator": "みやび", "text": "それに、服なら腐るものや\nないし、無駄にもならん\nきね。"},
        { "location": "298/TALK"    , "narrator": "アーヤ", "text": "…そうね。"},
        { "location": "299/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "301/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "303/TALK"    , "narrator": "みやび", "text": "ちゃんと着るよな？"},
        { "location": "306/TALK"    , "narrator": "アーヤ", "text": "も、もちろん着るわ！\nそのために買ったん\nだから。"},
        { "location": "308/TALK"    , "narrator": "アーヤ", "text": "ただ…来シーズンまで\n着ないのが、何着か\n出るとは思うけど…。"},
        { "location": "310/TALK"    , "narrator": "みやび", "text": "…本当、腐らん物で\nよかったね。"},
        { "location": "328/ACT"     , "narrator": "", "text": "しばらく着るのを楽しもう"},
        { "location": "329/TALK"    , "narrator": "アーヤ", "text": "そういえば"},
        { "location": "330/TALK"    , "narrator": "アーヤ", "text": "まだ袋から出してない服もあったわ"},
        { "location": "331/TALK"    , "narrator": "アーヤ", "text": "こんな状態で増やしても、意味ないわよね(-ω-;)"},
        { "location": "343/TALK"    , "narrator": "アーヤ", "text": "…十分買ったんだし、\nしばらくは買った服を\n着て楽しむことにするわ。"},
        { "location": "344/TALK"    , "narrator": "みやび", "text": "それがえいと思うんよ。"},
        { "location": "346/TALK"    , "narrator": "アーヤ", "text": "うん。"},
        { "location": "347/TALK"    , "narrator": "アーヤ", "text": "それに、今持ってる服との\n組み合わせ方とかも――"},
        { "location": "348/TALK"    , "narrator": "アーヤ", "text": "色々試してみないと\nいけないしね。"},
        { "location": "350/TALK"    , "narrator": "みやび", "text": "そんなことまでせんと\nいかんのか。"},
        { "location": "351/TALK"    , "narrator": "みやび", "text": "オシャレいうんも、\n大変やね。"},
        { "location": "354/TALK"    , "narrator": "アーヤ", "text": "逆よ。"},
        { "location": "355/TALK"    , "narrator": "アーヤ", "text": "その時間が、\n一番楽しいんだから。"},
        { "location": "172/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>6月12日　5:59 PM</color>\nとある夕方、神楽坂トライナリー楽屋にて。"},
        { "location": "322/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch02", "text": "【おひとりさまファッションショー】"}
    ]
}
