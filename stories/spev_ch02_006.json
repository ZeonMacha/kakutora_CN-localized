        { "location": "95/ACT"  , "narrator": "", "text": "だからこそ一人になる時間も必要"},
        { "location": "98/TALK" , "narrator": "アーヤ", "text": "ありがとう(^^"},
        { "location": "100/TALK", "narrator": "アーヤ", "text": "肯定してもらえると"},
