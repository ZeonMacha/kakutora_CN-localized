        { "location": "88/SEL"  , "narrator": "（選択肢）", "text": "たまにはいいと思うよ"},
        { "location": "89/SEL"  , "narrator": "（選択肢）", "text": "ちょっと珍しいよね？"},
        { "location": "90/ACT"  , "narrator": "", "text": "たまにはいいと思うよ"},
        { "location": "91/TALK" , "narrator": "アーヤ", "text": "でも"},
        { "location": "92/TALK" , "narrator": "アーヤ", "text": "私は年長者だから(-ω-;)"},
        { "location": "93/SEL"  , "narrator": "（選択肢）", "text": "だからこそ一人になる時間も必要"},
