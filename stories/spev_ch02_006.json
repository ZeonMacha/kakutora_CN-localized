        { "location": "129/SEL" , "narrator": "（選択肢）", "text": "邪魔になってなくて安心した"},
        { "location": "130/SEL" , "narrator": "（選択肢）", "text": "今度はみんなで来ようね"},
        { "location": "131/ACT" , "narrator": "", "text": "邪魔になってなくて安心した"},
        { "location": "132/TALK", "narrator": "アーヤ", "text": "いつも話聞いてくれるし"},
        { "location": "133/TALK", "narrator": "アーヤ", "text": "助言もしてくれる"},
        { "location": "134/TALK", "narrator": "アーヤ", "text": "邪魔に思ったりしないから(^^"},
        { "location": "135/ACT" , "narrator": "", "text": "今度はみんなで来ようね"},
