        { "location": "76/TALK" , "narrator": "アーヤ", "text": "みんなは好きだけど"},
        { "location": "77/TALK" , "narrator": "アーヤ", "text": "ずっといると"},
        { "location": "78/TALK" , "narrator": "アーヤ", "text": "ちょっとだけね(｡-_-｡)"},
        { "location": "79/TALK" , "narrator": "アーヤ", "text": "プライベートがないし(;^_^A"},
        { "location": "82/TALK" , "narrator": "アーヤ", "text": "でも"},
