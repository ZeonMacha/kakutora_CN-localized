        { "location": "55/SEL"  , "narrator": "（選択肢）", "text": "内緒で出てきたの？"},
        { "location": "56/ACT"  , "narrator": "", "text": "内緒で出てきたの？"},
        { "location": "60/TALK" , "narrator": "アーヤ", "text": "そうなの(｡-_-｡)"},
        { "location": "62/TALK" , "narrator": "アーヤ", "text": "ずっとみんなと一緒だから"},
        { "location": "63/TALK" , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "64/TALK" , "narrator": "アーヤ", "text": "一人になりたくて(・・。)ゞ"},
        { "location": "65/SEL"  , "narrator": "（選択肢）", "text": "女の子の一人歩きは危険だよ"},
        { "location": "66/SEL"  , "narrator": "（選択肢）", "text": "みんなといるの疲れる？"},
        { "location": "67/ACT"  , "narrator": "", "text": "女の子の一人歩きは危険だよ"},
        { "location": "68/TALK" , "narrator": "アーヤ", "text": "心配してくれてるの？"},
        { "location": "69/TALK" , "narrator": "アーヤ", "text": "大丈夫よ(^^"},
        { "location": "70/TALK" , "narrator": "アーヤ", "text": "もしもの時には"},
