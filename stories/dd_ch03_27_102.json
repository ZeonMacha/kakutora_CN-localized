        "title": "005 メインストーリー",
        "sub_title": "今ここにある奇跡＜後編＞"
    },
    "entry":
    [
        { "location": "403/SCENARIO", "narrator": "", "text": "今ここにある奇跡のようなもの"},
        { "location": "424/TALK"    , "narrator": "ガブリエラ", "text": "アーヤの様子を\n見てくるわ。"},
        { "location": "426/TALK"    , "narrator": "みやび", "text": "ガブちゃんは\n落ち着いた？"},
        { "location": "427/TALK"    , "narrator": "ガブリエラ", "text": "…大丈夫よ。\nちょっと謝りたくて。"},
        { "location": "429/TALK"    , "narrator": "みやび", "text": "やったら\nいってらっしゃい。"},
        { "location": "430/TALK"    , "narrator": "ガブリエラ", "text": "…行ってきます。"},
        { "location": "451/TALK"    , "narrator": "ガブリエラ", "text": "ここにいたのね。"},
        { "location": "453/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ…。"},
        { "location": "456/TALK"    , "narrator": "ガブリエラ", "text": "…ええと…。"},
        { "location": "457/TALK"    , "narrator": "ガブリエラ", "text": "さっきはごめん。"},
        { "location": "459/TALK"    , "narrator": "ガブリエラ", "text": "あたしちょっと\n言い過ぎたわ。"},
        { "location": "460/TALK"    , "narrator": "アーヤ", "text": "ううん。\nいいのよ。"},
        { "location": "461/TALK"    , "narrator": "アーヤ", "text": "私こそ確かに\n大人げなかったわ。"},
        { "location": "462/TALK"    , "narrator": "アーヤ", "text": "なかなか整理が\n付けられないのよ\n自分の気持ちの。"},
        { "location": "463/TALK"    , "narrator": "アーヤ", "text": "姉がらみだとね。"},
        { "location": "464/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "465/TALK"    , "narrator": "アーヤ", "text": "ねえギャヴィ。\nバタフライエフェクトって\n知ってる？"},
        { "location": "466/TALK"    , "narrator": "ガブリエラ", "text": "確か映画のタイトルに\nあったわ。"},
        { "location": "468/TALK"    , "narrator": "アーヤ", "text": "そうね。"},
        { "location": "469/TALK"    , "narrator": "アーヤ", "text": "些細な出来事の変化で\n未来が変わるって\nＳＦ映画。"},
        { "location": "471/TALK"    , "narrator": "アーヤ", "text": "元々は気象学者の\n言葉だったらしいけど。"},
        { "location": "472/TALK"    , "narrator": "アーヤ", "text": "…今の状態ってまさに\nバタフライエフェクトだと\n思わない？"},
        { "location": "473/TALK"    , "narrator": "ガブリエラ", "text": "…確かにね。"},
        { "location": "474/TALK"    , "narrator": "ガブリエラ", "text": "あたしがアーヤの実家に\n行くことになるとか。"},
        { "location": "475/TALK"    , "narrator": "ガブリエラ", "text": "世界選手権でアーヤを\n見た時には考えも\nしなかったわ。"},
        { "location": "476/TALK"    , "narrator": "アーヤ", "text": "ね？"},
        { "location": "477/TALK"    , "narrator": "ガブリエラ", "text": "あたしにとっては\nそれは奇跡みたいな\nものだけど。"},
        { "location": "478/TALK"    , "narrator": "ガブリエラ", "text": "きっとつばめはメノウが\n神楽だったことが\n奇跡だったりするのよね。"},
        { "location": "479/TALK"    , "narrator": "アーヤ", "text": "…そうかもね。"},
        { "location": "481/TALK"    , "narrator": "アーヤ", "text": "私にとっては神社の娘に\n生まれて、いまここに\nいることが奇跡なのかも。"},
        { "location": "482/TALK"    , "narrator": "ガブリエラ", "text": "そうなの？"},
        { "location": "483/TALK"    , "narrator": "アーヤ", "text": "…おかしい？"},
        { "location": "484/SEL"     , "narrator": "", "text": "そのことで話がある"},
        { "location": "485/SEL"     , "narrator": "", "text": "ちゃんと話せるのかな"},
        { "location": "486/SEL"     , "narrator": "", "text": "バグは勘弁"},
        { "location": "487/SEL"     , "narrator": "", "text": "ガブリエラと$me$の出会いも奇跡"},
        { "location": "488/ACT"     , "narrator": "", "text": "そのことで話がある"},
        { "location": "506/TALK"    , "narrator": "ガブリエラ", "text": "何かしら"},
        { "location": "508/ACT"     , "narrator": "", "text": "ちゃんと話せるのかな"},
        { "location": "526/TALK"    , "narrator": "ガブリエラ", "text": "ええと？"},
        { "location": "528/TALK"    , "narrator": "ガブリエラ", "text": "いつだって"},
        { "location": "529/TALK"    , "narrator": "ガブリエラ", "text": "お話ししているでしょう？"},
        { "location": "531/ACT"     , "narrator": "", "text": "バグは勘弁"},
        { "location": "549/TALK"    , "narrator": "ガブリエラ", "text": "え"},
        { "location": "550/TALK"    , "narrator": "ガブリエラ", "text": "何を言ってるの"},
        { "location": "551/TALK"    , "narrator": "ガブリエラ", "text": "突然"},
        { "location": "553/ACT"     , "narrator": "", "text": "ガブリエラと$me$の出会いも奇跡"},
        { "location": "571/TALK"    , "narrator": "ガブリエラ", "text": "確かにｖｖｖ"},
        { "location": "573/TALK"    , "narrator": "ガブリエラ", "text": "そうかもしれないわ////////////"},
        { "location": "576/SEL"     , "narrator": "", "text": "正常っぽい？"},
        { "location": "577/SEL"     , "narrator": "", "text": "念には念を入れて"},
        { "location": "578/SEL"     , "narrator": "", "text": "要点だけ伝えれば大丈夫か"},
        { "location": "579/ACT"     , "narrator": "", "text": "正常っぽい？"},
        { "location": "580/TALK"    , "narrator": "ガブリエラ", "text": "何の話？"},
        { "location": "582/ACT"     , "narrator": "", "text": "念には念を入れて"},
        { "location": "583/TALK"    , "narrator": "ガブリエラ", "text": "何かあるのかしら？"},
        { "location": "585/ACT"     , "narrator": "", "text": "要点だけ伝えれば大丈夫か"},
        { "location": "586/TALK"    , "narrator": "ガブリエラ", "text": "ええと？"},
        { "location": "590/SEL"     , "narrator": "", "text": "実家でアーヤの話し相手になってあげて"},
        { "location": "591/ACT"     , "narrator": "", "text": "実家でアーヤの話し相手になってあげて"},
        { "location": "593/TALK"    , "narrator": "ガブリエラ", "text": "なんで急に"},
        { "location": "594/TALK"    , "narrator": "ガブリエラ", "text": "そんなこと言うの？"},
        { "location": "596/SEL"     , "narrator": "", "text": "今は言えない"},
        { "location": "597/SEL"     , "narrator": "", "text": "後でわかる"},
        { "location": "598/SEL"     , "narrator": "", "text": "ガブリエラにしかできないことだから"},
        { "location": "599/ACT"     , "narrator": "", "text": "今は言えない"},
        { "location": "600/TALK"    , "narrator": "ガブリエラ", "text": "何よそれ？"},
        { "location": "602/ACT"     , "narrator": "", "text": "後でわかる"},
        { "location": "603/TALK"    , "narrator": "ガブリエラ", "text": "なんで今じゃないの？"},
        { "location": "605/ACT"     , "narrator": "", "text": "ガブリエラにしかできないことだから"},
        { "location": "606/TALK"    , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "607/TALK"    , "narrator": "ガブリエラ", "text": "そうかもしれないけど"},
        { "location": "610/SEL"     , "narrator": "", "text": "<size=22>e38182e38284e381aee38182e381ade381a0e38191e381a9e38195e38195e38188e381a6e38182e38192e381a6</size>"},
        { "location": "613/TALK"    , "narrator": "ガブリエラ", "text": "え"},
        { "location": "614/TALK"    , "narrator": "ガブリエラ", "text": "何これ"},
        { "location": "615/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと！"},
        { "location": "627/TALK"    , "narrator": "ガブリエラ", "text": "文字化けかしら？\nそれとも入力ミス？\n変なの…。"},
        { "location": "628/TALK"    , "narrator": "アーヤ", "text": "とりあえず先を\n急ぎましょう。"},
        { "location": "629/TALK"    , "narrator": "ガブリエラ", "text": "そうね。"},
        { "location": "630/TALK"    , "narrator": "アーヤ", "text": "うちの実家、本当に\n山奥の田舎だから\nびっくりしないでね。"},
        { "location": "631/TALK"    , "narrator": "ガブリエラ", "text": "それは逆に楽しみかも。"},
        { "location": "632/TALK"    , "narrator": "アーヤ", "text": "本当に何もないからね。"},
        { "location": "634/TALK"    , "narrator": "ガブリエラ", "text": "そんなに\n強調しなくても…。"},
        { "location": "645/DIALOG"  , "narrator": "Dialog_chapter_ch03", "text": "【22 トークン・リング】"}
    ]
}
