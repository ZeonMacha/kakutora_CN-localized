        { "location": "441/TALK"    , "narrator": "神楽", "text": "つばめさんったら何を言っても信じるんですよ"},
        { "location": "442/TALK"    , "narrator": "神楽", "text": "かわいいですねっ♪"},
        { "location": "444/SEL"     , "narrator": "", "text": "何の話だっけ"},
