        { "location": "447/ACT"     , "narrator": "", "text": "何の話だっけ"},
        { "location": "448/TALK"    , "narrator": "神楽", "text": "神楽坂にはぴょんこのパワーが満ちてるって話です♪"},
        { "location": "449/ACT"     , "narrator": "", "text": "神楽の話がうまいから"},
        { "location": "451/TALK"    , "narrator": "神楽", "text": "そうでしょうか♪"},
        { "location": "452/TALK"    , "narrator": "神楽", "text": "ほめても何にも出ませんよっ★"},
        { "location": "453/ACT"     , "narrator": "", "text": "そこがつばめのいいところ"},
        { "location": "454/TALK"    , "narrator": "神楽", "text": "そうですね♪"},
        { "location": "455/TALK"    , "narrator": "神楽", "text": "確かに"},
        { "location": "457/TALK"    , "narrator": "神楽", "text": "つばめさんってきっと"},
        { "location": "458/TALK"    , "narrator": "神楽", "text": "ふんわり和やかに生きてきたんでしょうね"},
        { "location": "460/SEL"     , "narrator": "", "text": "そうかもね"},
        { "location": "461/SEL"     , "narrator": "", "text": "意外と苦労してるんだよ"},
        { "location": "462/SEL"     , "narrator": "", "text": "神楽の方が興味あるから"},
        { "location": "463/ACT"     , "narrator": "", "text": "そうかもね"},
        { "location": "464/TALK"    , "narrator": "神楽", "text": "そうですよね"},
        { "location": "465/TALK"    , "narrator": "神楽", "text": "違いますか？"},
        { "location": "466/ACT"     , "narrator": "", "text": "意外と苦労してるんだよ"},
        { "location": "467/TALK"    , "narrator": "神楽", "text": "そうでしょうか？"},
        { "location": "468/TALK"    , "narrator": "神楽", "text": "ぴょんこにはそうは思えないですけど"},
        { "location": "469/ACT"     , "narrator": "", "text": "神楽の方が興味あるから"},
        { "location": "470/TALK"    , "narrator": "神楽", "text": "ぴょんこのことが？"},
        { "location": "471/TALK"    , "narrator": "神楽", "text": "ぴょんこも$handle$さんに興味がありますよっ♪"},
        { "location": "472/TALK"    , "narrator": "神楽", "text": "気が合いますねっ♪"},
        { "location": "474/TALK"    , "narrator": "神楽", "text": "もし、、、もしですよ"},
        { "location": "475/TALK"    , "narrator": "神楽", "text": "つばめさんに世界のために犠牲になってって言ったら"},
        { "location": "477/TALK"    , "narrator": "神楽", "text": "どんな反応をすると思いますか？"},
        { "location": "478/TALK"    , "narrator": "神楽", "text": "そのことを信じると思いますか？"},
        { "location": "479/TALK"    , "narrator": "神楽", "text": "世界のために犠牲になると思いますか？"},
        { "location": "481/SEL"     , "narrator": "", "text": "さすがに信じないんじゃない？"},
        { "location": "482/SEL"     , "narrator": "", "text": "重い話題だね…"},
        { "location": "483/SEL"     , "narrator": "", "text": "犠牲になろうとすると思うよ"},
        { "location": "484/ACT"     , "narrator": "", "text": "さすがに信じないんじゃない？"},
        { "location": "485/TALK"    , "narrator": "神楽", "text": "そうですよね、、、"},
        { "location": "486/TALK"    , "narrator": "神楽", "text": "一介の女子高生に世界をどうこうする力があるなんて夢物語ですよね"},
        { "location": "487/ACT"     , "narrator": "", "text": "重い話題だね…"},
        { "location": "488/TALK"    , "narrator": "神楽", "text": "あくまでも仮定の話です"},
        { "location": "489/TALK"    , "narrator": "神楽", "text": "そんなに重く考えなくて大丈夫ですよっ♪"},
        { "location": "490/ACT"     , "narrator": "", "text": "犠牲になろうとすると思うよ"},
        { "location": "491/TALK"    , "narrator": "神楽", "text": "つばめさんってやっぱりそんな風に見えるんですね、、、"},
        { "location": "493/TALK"    , "narrator": "神楽", "text": "ぴょんこがもし世界のために犠牲になってって言われたら"},
        { "location": "494/TALK"    , "narrator": "神楽", "text": "断っちゃいます♪"},
        { "location": "495/TALK"    , "narrator": "神楽", "text": "別にこれって普通ですよね？"},
        { "location": "497/SEL"     , "narrator": "", "text": "全然普通"},
        { "location": "498/SEL"     , "narrator": "", "text": "もしそうなったら$me$を頼って"},
        { "location": "499/SEL"     , "narrator": "", "text": "神楽の一番いいって思う方法を取ればいい"},
        { "location": "500/ACT"     , "narrator": "", "text": "全然普通"},
        { "location": "501/TALK"    , "narrator": "神楽", "text": "ですよねですよね♪"},
        { "location": "503/TALK"    , "narrator": "神楽", "text": "あんしんしました～～～～"},
        { "location": "504/ACT"     , "narrator": "", "text": "もしそうなったら$me$を頼って"},
        { "location": "505/TALK"    , "narrator": "神楽", "text": "$handle$さんを？"},
        { "location": "506/TALK"    , "narrator": "神楽", "text": "頼りになりそうですねっ♪"},
        { "location": "507/TALK"    , "narrator": "神楽", "text": "その時はぜひぜひお願いします～～"},
        { "location": "508/TALK"    , "narrator": "神楽", "text": "やったね！"},
        { "location": "509/ACT"     , "narrator": "", "text": "神楽の一番いいって思う方法を取ればいい"},
        { "location": "510/TALK"    , "narrator": "神楽", "text": "ぴょんこの気持ちが最優先ってことですね★"},
        { "location": "511/TALK"    , "narrator": "神楽", "text": "そうします～～～"},
        { "location": "513/TALK"    , "narrator": "神楽", "text": "ぴょんこは自分をエゴイストだとは思いたくないんです"},
        { "location": "514/TALK"    , "narrator": "神楽", "text": "でもぴょんこの決めた行動がもし他人からそう言われることになったら"},
        { "location": "515/TALK"    , "narrator": "神楽", "text": "甘んじてそれを受けようと思っています"},
        { "location": "518/TALK"    , "narrator": "神楽", "text": "なんてヒロイックですね★"},
