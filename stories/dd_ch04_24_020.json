{
    "dir": "chap24/daydra/dd_ch04_24_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "24456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "偽りの平穏"
    },
    "entry":
    [
        { "location": "382/SCENARIO", "narrator": "", "text": "偽りの平穏"},
        { "location": "395/TALK"    , "narrator": "ガブリエラ", "text": "あーあ…何にも面白い\nテレビやってないわね…。"},
        { "location": "396/TALK"    , "narrator": "みやび", "text": "夕方はほとんどニュースが\n独占してるきね。"},
        { "location": "400/TALK"    , "narrator": "アーヤ", "text": "あら、ニュースだって\n面白いわよ。"},
        { "location": "401/TALK"    , "narrator": "アーヤ", "text": "暗いのばっかりじゃなくて、\n色んな特集もやってるし。"},
        { "location": "402/TALK"    , "narrator": "つばめ", "text": "あ、たい焼き特集する\nニュースがありますよ！"},
        { "location": "404/TALK"    , "narrator": "ガブリエラ", "text": "たい焼きって、\nそんなテレビで特集する\nようなものなの？"},
        { "location": "406/TALK"    , "narrator": "みやび", "text": "またなにか新しいのが\n出るんかもしれんぞね。"},
        { "location": "410/TALK"    , "narrator": "つばめ", "text": "見たいなぁ…。\nチャンネル変えて\nいいですか？"},
        { "location": "412/TALK"    , "narrator": "アーヤ", "text": "ええ、どうぞ。"},
        { "location": "414/TALK"    , "narrator": "つばめ", "text": "やった！\nそれじゃ…。"},
        { "location": "415/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "433/TALK"    , "narrator": "アーヤ", "text": "施錠よし、と。\nさ、みんな帰るわよ。"},
        { "location": "435/TALK"    , "narrator": "ガブリエラ", "text": "あ、みんな直帰？\nあたしはお風呂入ってから\n帰るから。"},
        { "location": "437/TALK"    , "narrator": "みやび", "text": "ガブちゃん、まっこと\nテルマエ好きやねぇ。"},
        { "location": "440/TALK"    , "narrator": "ガブリエラ", "text": "足伸ばせるのが好きなのよ。"},
        { "location": "441/TALK"    , "narrator": "つばめ", "text": "そういえば、\n最近忙しくて全然\n行ってませんでしたね。"},
        { "location": "442/TALK"    , "narrator": "アーヤ", "text": "言われてみると確かに…。"},
        { "location": "445/TALK"    , "narrator": "アーヤ", "text": "私も、今日はテルマエ\n寄ってこうかしら？"},
        { "location": "446/TALK"    , "narrator": "つばめ", "text": "じゃあ、みんなで\n行きましょう。"},
        { "location": "448/TALK"    , "narrator": "つばめ", "text": "みやびさんもいいですか？"},
        { "location": "450/TALK"    , "narrator": "つばめ", "text": "って、あれ？\nみやびさん？"},
        { "location": "451/TALK"    , "narrator": "みやび", "text": "先に入ってるぞねー。"},
        { "location": "453/TALK"    , "narrator": "つばめ", "text": "って、早っ！？\nいつの間に…。"},
        { "location": "456/TALK"    , "narrator": "ガブリエラ", "text": "もぅ、ほんとみやびって\nマイペースなんだから…。"},
        { "location": "458/TALK"    , "narrator": "アーヤ", "text": "私達も行きましょ。\n早くお湯に浸かりたいわ。"},
        { "location": "479/TALK"    , "narrator": "ガブリエラ", "text": "ふぅ…やっぱり一日の\n終わりは、お風呂が\n一番よねー。"},
        { "location": "481/TALK"    , "narrator": "アーヤ", "text": "一番若いのに、\nちょっと年寄臭いわよ？"},
        { "location": "483/TALK"    , "narrator": "ガブリエラ", "text": "う、うるさいわね。\nいいでしょ？"},
        { "location": "484/TALK"    , "narrator": "つばめ", "text": "扇風機、扇風機。"},
        { "location": "486/TALK"    , "narrator": "みやび", "text": "せっかく温まったのに、\nそれじゃ意味ないやろ？"},
        { "location": "489/TALK"    , "narrator": "つばめ", "text": "でも、このままじゃ\n汗が止まりませんよぉ…。"},
        { "location": "492/TALK"    , "narrator": "ガブリエラ", "text": "あたしも、ちょっと\n身体冷まさないと。"},
        { "location": "493/TALK"    , "narrator": "アーヤ", "text": "ギャヴィも扇風機使う？"},
        { "location": "495/TALK"    , "narrator": "ガブリエラ", "text": "ううん、あたしはもちろん、\n冷えたフルーツ牛乳を\n飲むわ。"},
        { "location": "497/TALK"    , "narrator": "つばめ", "text": "えっ！？　わ、わたしも\nそっちがいい！"},
        { "location": "498/TALK"    , "narrator": "ガブリエラ", "text": "ふふっ、お風呂上がりの\n牛乳って美味しいのよね。"},
        { "location": "500/TALK"    , "narrator": "ガブリエラ", "text": "アーヤもフルーツ？"},
        { "location": "502/TALK"    , "narrator": "アーヤ", "text": "ううん、コーヒー牛乳で。"},
        { "location": "504/TALK"    , "narrator": "つばめ", "text": "わたしもコーヒーで――"},
        { "location": "505/TALK"    , "narrator": "ガブリエラ", "text": "イチゴ牛乳あるけど？"},
        { "location": "506/TALK"    , "narrator": "つばめ", "text": "イチゴ牛乳にするよ。"},
        { "location": "507/TALK"    , "narrator": "ガブリエラ", "text": "本当、つばめって\nイチゴ好きよね。"},
        { "location": "508/TALK"    , "narrator": "つばめ", "text": "えへへ…。"},
        { "location": "510/TALK"    , "narrator": "みやび", "text": "うちは普通のでー。"},
        { "location": "512/TALK"    , "narrator": "ガブリエラ", "text": "あら？\n普通の売り切れみたい。"},
        { "location": "514/TALK"    , "narrator": "みやび", "text": "しょんぼりやね…。\nじゃ、フルーツでえいか。"},
        { "location": "516/TALK"    , "narrator": "ガブリエラ", "text": "仕方なさそうに\n言わないでよ。\nあたしは飲むんだから。"},
        { "location": "530/TALK"    , "narrator": "みやび", "text": "ただいま…今日も一日、\nお疲れさん、っと…。"},
        { "location": "532/TALK"    , "narrator": "みやび", "text": "ふぅ…。"},
        { "location": "533/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "534/TALK"    , "narrator": "みやび", "text": "なーんか、\n変な一日やったなぁ…。"},
        { "location": "535/TALK"    , "narrator": "みやび", "text": "まるで、今までと変わらん\n普通の日みたいやった。"},
        { "location": "536/TALK"    , "narrator": "みやび", "text": "…あれだけ話して、\n卯月の名前が一度も\n出てこんとは。"},
        { "location": "538/TALK"    , "narrator": "みやび", "text": "もう、今更話すことなんぞ\nないっちゅうことか？"},
        { "location": "539/TALK"    , "narrator": "みやび", "text": "それとも、揉めるんが\nイヤで敢えて避けた？"},
        { "location": "540/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "541/TALK"    , "narrator": "みやび", "text": "吹っ切れた…っちゅうのは\nありえんか…。"},
        { "location": "542/TALK"    , "narrator": "みやび", "text": "うちらならまだしも、\nつばめちゃんには\n絶対無理や。"},
        { "location": "543/TALK"    , "narrator": "みやび", "text": "アーヤとガブちゃんも、\nちくっともピリピリした\n感じせんかったし…。"},
        { "location": "544/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "545/TALK"    , "narrator": "みやび", "text": "わからん…。\nみんな、なに考えちゅうん\nやろか？"},
        { "location": "546/SEL"     , "narrator": "", "text": "みやびと同じだよ"},
        { "location": "548/TALK"    , "narrator": "みやび", "text": "もっとピリピリして、\n重い空気になるんが\n普通やないが？"},
        { "location": "549/TALK"    , "narrator": "みやび", "text": "なのに、どうしてみんな…。"},
        { "location": "553/TALK"    , "narrator": "みやび", "text": "…いや、違うな。\nうちがおかしいだけか。"},
        { "location": "554/TALK"    , "narrator": "みやび", "text": "裏切り者のことで、\nいつまでもうじうじ\n考える方が変なんやし…。"},
        { "location": "555/TALK"    , "narrator": "みやび", "text": "とにかく、ピリピリせんで\n普通の状態に戻れたんは、\nえいことや。"},
        { "location": "556/TALK"    , "narrator": "みやび", "text": "…多分、えいことや。"},
        { "location": "557/ACT"     , "narrator": "", "text": "みやびと同じだよ"},
        { "location": "560/TALK"    , "narrator": "みやび", "text": "ん…？"},
        { "location": "574/TALK"    , "narrator": "みやび", "text": "どういうことか"},
        { "location": "575/TALK"    , "narrator": "みやび", "text": "簡潔に説明せよ"},
        { "location": "577/SEL"     , "narrator": "", "text": "みやびと同じで悩んでるはず"},
        { "location": "578/ACT"     , "narrator": "", "text": "みやびと同じで悩んでるはず"},
        { "location": "580/TALK"    , "narrator": "みやび", "text": "変であろう？"},
        { "location": "581/TALK"    , "narrator": "みやび", "text": "ならば何故"},
        { "location": "583/TALK"    , "narrator": "みやび", "text": "誰も卯月の名前を出さなかった？"},
        { "location": "585/SEL"     , "narrator": "", "text": "出したくなかったんじゃない？"},
        { "location": "586/ACT"     , "narrator": "", "text": "出したくなかったんじゃない？"},
        { "location": "588/TALK"    , "narrator": "みやび", "text": "大切な部分が抜け過ぎている"},
        { "location": "589/TALK"    , "narrator": "みやび", "text": "理解できん"},
        { "location": "590/TALK"    , "narrator": "みやび", "text": "なぜか説明求む"},
        { "location": "592/SEL"     , "narrator": "", "text": "楽しい時間を壊したくなかった"},
        { "location": "593/ACT"     , "narrator": "", "text": "楽しい時間を壊したくなかった"},
        { "location": "596/TALK"    , "narrator": "みやび", "text": "なるほど"},
        { "location": "597/TALK"    , "narrator": "みやび", "text": "理解できなくはない"},
        { "location": "598/TALK"    , "narrator": "みやび", "text": "確かに"},
        { "location": "599/TALK"    , "narrator": "みやび", "text": "楽しかった"},
        { "location": "602/TALK"    , "narrator": "みやび", "text": "だがそれだけで"},
        { "location": "603/TALK"    , "narrator": "みやび", "text": "抑えられるものか？"},
        { "location": "604/TALK"    , "narrator": "みやび", "text": "卯月に対する"},
        { "location": "607/TALK"    , "narrator": "みやび", "text": "気持ちを"},
        { "location": "610/SEL"     , "narrator": "", "text": "暗いままじゃ気がめいるよ"},
        { "location": "611/ACT"     , "narrator": "", "text": "暗いままじゃ気がめいるよ"},
        { "location": "613/TALK"    , "narrator": "みやび", "text": "わからなくはない"},
        { "location": "614/TALK"    , "narrator": "みやび", "text": "気がめいれば"},
        { "location": "615/TALK"    , "narrator": "みやび", "text": "これから先の面倒ごと"},
        { "location": "616/TALK"    , "narrator": "みやび", "text": "確実に乗り越えられん"},
        { "location": "617/TALK"    , "narrator": "みやび", "text": "無理ゲー積みゲークソゲー状態"},
        { "location": "618/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "619/TALK"    , "narrator": "みやび", "text": "今もそうやけんど"},
        { "location": "622/TALK"    , "narrator": "みやび", "text": "みんなで話して"},
        { "location": "623/TALK"    , "narrator": "みやび", "text": "これからのことを決めた"},
        { "location": "624/TALK"    , "narrator": "みやび", "text": "つまり"},
        { "location": "625/TALK"    , "narrator": "みやび", "text": "ここから先は"},
        { "location": "626/TALK"    , "narrator": "みやび", "text": "個人で悩む時期ということか？"},
        { "location": "629/TALK"    , "narrator": "みやび", "text": "自信はないが"},
        { "location": "630/TALK"    , "narrator": "みやび", "text": "そうだと願う"},
        { "location": "641/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "642/TALK"    , "narrator": "みやび", "text": "アーヤにでも、ＷＡＶＥで\n確認しとくか…？"},
        { "location": "643/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "644/TALK"    , "narrator": "みやび", "text": "いや…そうやな。"},
        { "location": "645/TALK"    , "narrator": "みやび", "text": "みんな、\nきっと考えちょるはずや。"},
        { "location": "646/TALK"    , "narrator": "みやび", "text": "何故、誰も卯月の名を\n出さなかったのかを…。"},
        { "location": "647/TALK"    , "narrator": "みやび", "text": "…ま、うち自身も\n答えは出ちょらんけんどな。"},
        { "location": "648/TALK"    , "narrator": "みやび", "text": "はぁ…しっかし、\n久しぶりにみんなと\n普通に話せて楽し――"},
        { "location": "649/TALK"    , "narrator": "みやび", "text": "……あ。"},
        { "location": "650/TALK"    , "narrator": "みやび", "text": "…うちも、楽しい時間を\n壊したくない思うてた\n一人、っちゅうことか…。"},
        { "location": "652/TALK"    , "narrator": "みやび", "text": "…早く、普通に疑問を\n抱かんでえい日が\n来てほしいもんやなぁ…。"},
        { "location": "394/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月31日　 5:23 PM</color>\n夏休み最後の日、神楽坂トライナリー楽屋にて"}
    ]
}
