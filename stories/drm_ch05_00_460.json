    "entry":
    [
        { "location": "2995/SCENARIO", "narrator": "", "text": "壊しちゃった宝物"},
        { "location": "3020/TALK"    , "narrator": "神楽", "text": "ねえ覚えてる？"},
        { "location": "3021/TALK"    , "narrator": "神楽", "text": "ぴょんこがステージに立っている時は"},
        { "location": "3022/TALK"    , "narrator": "神楽", "text": "その時のキャラクターになりきってるって話"},
        { "location": "3025/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "3026/SEL"     , "narrator": "", "text": "なんとなく"},
        { "location": "3027/SEL"     , "narrator": "", "text": "そんな話あったっけ？？？"},
        { "location": "3028/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "3029/TALK"    , "narrator": "神楽", "text": "うんうん偉いぞ"},
        { "location": "3031/TALK"    , "narrator": "神楽", "text": "さすが$handle$♪"},
        { "location": "3032/ACT"     , "narrator": "", "text": "なんとなく"},
        { "location": "3034/TALK"    , "narrator": "神楽", "text": "まあいっか"},
        { "location": "3035/ACT"     , "narrator": "", "text": "そんな話あったっけ？？？"},
        { "location": "3036/TALK"    , "narrator": "神楽", "text": "してなかったっけ"},
        { "location": "3038/TALK"    , "narrator": "神楽", "text": "そっかそっかー"},
        { "location": "3049/TALK"    , "narrator": "神楽", "text": "衣装も髪型も目の色も全部変えて"},
        { "location": "3050/TALK"    , "narrator": "神楽", "text": "ぴょんこはその子になりきるぴょん"},
        { "location": "3052/SEL"     , "narrator": "", "text": "知ってる"},
        { "location": "3053/ACT"     , "narrator": "", "text": "知ってる"},
        { "location": "3055/TALK"    , "narrator": "神楽", "text": "この前ね"},
        { "location": "3056/TALK"    , "narrator": "神楽", "text": "$handle$が、私のこと、全部全部好きって言ってくれたでしょ"},
        { "location": "3058/SEL"     , "narrator": "", "text": "うん"},
        { "location": "3059/SEL"     , "narrator": "", "text": "「好き」じゃないよ、「愛してる」だよ！"},
        { "location": "3060/ACT"     , "narrator": "", "text": "うん"},
        { "location": "3061/ACT"     , "narrator": "", "text": "「好き」じゃないよ、「愛してる」だよ！"},
        { "location": "3063/TALK"    , "narrator": "神楽", "text": "ふふふ～～～"},
        { "location": "3064/TALK"    , "narrator": "神楽", "text": "ごめんね、そうだった"},
        { "location": "3066/TALK"    , "narrator": "神楽", "text": "私も、$handle$のこと、あ・い・し・て・る！"},
        { "location": "3068/TALK"    , "narrator": "神楽", "text": "それでね、フォビアのことで、私が質問したの覚えてる？"},
        { "location": "3070/SEL"     , "narrator": "", "text": "覚えてる"},
        { "location": "3071/ACT"     , "narrator": "", "text": "覚えてる"},
        { "location": "3073/TALK"    , "narrator": "神楽", "text": "あの後色々考えた"},
        { "location": "3074/TALK"    , "narrator": "神楽", "text": "ホントに色々考えて"},
        { "location": "3075/TALK"    , "narrator": "神楽", "text": "いっぱい泣いた"},
        { "location": "3077/SEL"     , "narrator": "", "text": "大丈夫？"},
        { "location": "3078/ACT"     , "narrator": "", "text": "大丈夫？"},
        { "location": "3080/TALK"    , "narrator": "神楽", "text": "$handle$にひとつ懺悔したいことがあるの"},
        { "location": "3081/TALK"    , "narrator": "神楽", "text": "その話を、今からしていい？"},
        { "location": "3083/SEL"     , "narrator": "", "text": "いいよ"},
        { "location": "3084/SEL"     , "narrator": "", "text": "ごめん、心の準備があるからまた今度でいい？"},
        { "location": "3085/ACT"     , "narrator": "", "text": "いいよ"},
        { "location": "3086/ACT"     , "narrator": "", "text": "ごめん、心の準備があるからまた今度でいい？"},
        { "location": "3087/TALK"    , "narrator": "神楽", "text": "いや、心の準備が必要なのはぴょんこの方であって"},
        { "location": "3088/TALK"    , "narrator": "神楽", "text": "でも、色々有ると思うから、準備できたらまた声かけてぴょん"},
        { "location": "3099/TALK"    , "narrator": "神楽", "text": "ありがとう"},
        { "location": "3100/TALK"    , "narrator": "神楽", "text": "ぴょんこがね、ママに虐待されてるでしょ"},
        { "location": "3101/TALK"    , "narrator": "神楽", "text": "あれね、ホントは因果応報なの"},
        { "location": "3102/TALK"    , "narrator": "神楽", "text": "だからね、$handle$に全部懺悔して、カルマの浄化をするの"},
        { "location": "3104/SEL"     , "narrator": "", "text": "あれって因果応報だったの！？"},
        { "location": "3105/SEL"     , "narrator": "", "text": "承知致しました。不肖$handle$、全て受けとめ浄化致す所存です"},
        { "location": "3106/ACT"     , "narrator": "", "text": "あれって因果応報だったの！？"},
        { "location": "3107/TALK"    , "narrator": "神楽", "text": "えっと"},
        { "location": "3108/TALK"    , "narrator": "神楽", "text": "なんて説明したらいいものか"},
        { "location": "3110/TALK"    , "narrator": "神楽", "text": "ちょっとドラマチックにしてみただけぴょん"},
        { "location": "3111/TALK"    , "narrator": "神楽", "text": "マジレスすると、ママの件は全然関係無いぴょん"},
        { "location": "3112/TALK"    , "narrator": "神楽", "text": "忘れて"},
        { "location": "3113/ACT"     , "narrator": "", "text": "承知致しました。不肖$handle$、全て受けとめ浄化致す所存です"},
        { "location": "3114/TALK"    , "narrator": "神楽", "text": "ぴょん！"},
        { "location": "3115/TALK"    , "narrator": "神楽", "text": "ありがとうございます、$handle$様"},
        { "location": "3119/TALK"    , "narrator": "神楽", "text": "私にとって創作とは、古事記でいうところの国産みと同じです"},
        { "location": "3120/TALK"    , "narrator": "神楽", "text": "どの子も、お腹を痛めて生んだ子だし、それぞれ個性があってかわいい"},
        { "location": "3122/SEL"     , "narrator": "", "text": "わかる"},
        { "location": "3123/SEL"     , "narrator": "", "text": "わかるようなわからないような"},
        { "location": "3124/SEL"     , "narrator": "", "text": "うーんわからん！"},
        { "location": "3125/ACT"     , "narrator": "", "text": "わかる"},
        { "location": "3126/TALK"    , "narrator": "神楽", "text": "よかった"},
        { "location": "3127/TALK"    , "narrator": "神楽", "text": "わかってくれて"},
        { "location": "3128/ACT"     , "narrator": "", "text": "わかるようなわからないような"},
        { "location": "3129/TALK"    , "narrator": "神楽", "text": "そっか"},
        { "location": "3130/TALK"    , "narrator": "神楽", "text": "そうかもしれないぴょん"},
        { "location": "3131/ACT"     , "narrator": "", "text": "うーんわからん！"},
        { "location": "3132/TALK"    , "narrator": "神楽", "text": "伝わんないぴょん、、、"},
        { "location": "3133/TALK"    , "narrator": "神楽", "text": "仕方ないけど"},
        { "location": "3135/TALK"    , "narrator": "神楽", "text": "なのに"},
        { "location": "3136/TALK"    , "narrator": "神楽", "text": "私は"},
        { "location": "3139/SEL"     , "narrator": "", "text": "無理しないで？"},
        { "location": "3140/SEL"     , "narrator": "", "text": "いつまでも待ってるから、落ち着いてお話して？"},
        { "location": "3141/ACT"     , "narrator": "", "text": "無理しないで？"},
        { "location": "3142/ACT"     , "narrator": "", "text": "いつまでも待ってるから、落ち着いてお話して？"},
        { "location": "3144/TALK"    , "narrator": "神楽", "text": "ありがとう"},
        { "location": "3145/TALK"    , "narrator": "神楽", "text": "私は、イシュフォビアという作品の事が嫌いでした"},
        { "location": "3146/TALK"    , "narrator": "神楽", "text": "ずっと恨んでた"},
        { "location": "3147/TALK"    , "narrator": "神楽", "text": "だってイシュフォビアは、私が作った作品じゃない"},
        { "location": "3148/TALK"    , "narrator": "神楽", "text": "アップサイドサウンズのPが方向性を決めて、"},
        { "location": "3149/TALK"    , "narrator": "神楽", "text": "ううん、もっともっと上からの命令で、こういうお話にしろという命令の下で作られた物語で"},
        { "location": "3150/TALK"    , "narrator": "神楽", "text": "あれは私が作りたいものじゃなかった"},
        { "location": "3151/TALK"    , "narrator": "神楽", "text": "だから私は、イシュフォビアを自分の作品だと思わないようにしていたし、唄うときも無心で唄うようにしていた"},
        { "location": "3152/TALK"    , "narrator": "神楽", "text": "でも"},
        { "location": "3155/TALK"    , "narrator": "神楽", "text": "やっぱだめだ"},
        { "location": "3156/TALK"    , "narrator": "神楽", "text": "これはちゃんと"},
        { "location": "3157/TALK"    , "narrator": "神楽", "text": "言葉でお話したいから"},
        { "location": "3158/TALK"    , "narrator": "神楽", "text": "どうか、聞いて下さい"},
        { "location": "3161/TALK"    , "narrator": "ボイスメール", "text": "秘密の箱をもう一度"},
        { "location": "3173/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【秘密の箱をもう一度】</color>\nをゲットしました！"}
    ]
}
