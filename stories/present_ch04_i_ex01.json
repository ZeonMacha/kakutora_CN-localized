    [
        { "location": "428/TALK", "narrator": "みやび", "text": "なんとマニアックなチョイス"},
        { "location": "430/TALK", "narrator": "みやび", "text": "この映画を選ぶとは"},
        { "location": "431/TALK", "narrator": "みやび", "text": "褒めてつかわそう"},
        { "location": "437/SEL" , "narrator": "", "text": "どこが好きなの？"},
        { "location": "438/ACT" , "narrator": "", "text": "どこが好きなの？"},
        { "location": "441/TALK", "narrator": "みやび", "text": "全部"},
        { "location": "442/TALK", "narrator": "みやび", "text": "というと話が終わるな"},
        { "location": "443/TALK", "narrator": "みやび", "text": "孤独の戦場はハッカー流儀に通じる部分があるためだ"},
        { "location": "448/SEL" , "narrator": "", "text": "なるほどね"},
        { "location": "449/ACT" , "narrator": "", "text": "なるほどね"},
        { "location": "452/TALK", "narrator": "みやび", "text": "ハッカーは孤独なもの"},
        { "location": "453/TALK", "narrator": "みやび", "text": "そして常に研鑽を積まねばならぬ"},
        { "location": "454/TALK", "narrator": "みやび", "text": "なんて言っておいて"},
        { "location": "455/TALK", "narrator": "みやび", "text": "実は初見ではよさがわからなんだことをここに告白する"},
        { "location": "459/SEL" , "narrator": "", "text": "そうだったんだ"},
        { "location": "460/ACT" , "narrator": "", "text": "そうだったんだ"},
        { "location": "463/TALK", "narrator": "みやび", "text": "まだまだかわいい中学生やったき"},
        { "location": "464/TALK", "narrator": "みやび", "text": "いまいちピンとこなんだ"},
        { "location": "465/TALK", "narrator": "みやび", "text": "しかし何かココロに残っていて"},
        { "location": "466/TALK", "narrator": "みやび", "text": "今となっては座右の映画ぞね"},
        { "location": "469/SEL" , "narrator": "", "text": "初めて聞いたそんな不思議な言葉"},
        { "location": "470/ACT" , "narrator": "", "text": "初めて聞いたそんな不思議な言葉"},
        { "location": "473/TALK", "narrator": "みやび", "text": "そのくらい人生に重要な映画ちうことやね"},
        { "location": "474/TALK", "narrator": "みやび", "text": "それを$handle$がチョイスしたことも重要"},
        { "location": "475/TALK", "narrator": "みやび", "text": "さすが相棒"}
    ]
