    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ルールじゃなくて法律なのよ"},
        { "location": "18/TALK"   , "narrator": "真幌", "text": "…ん？"},
        { "location": "21/TALK"   , "narrator": "アーヤ", "text": "あ、館長。\nお疲れ様です。"},
        { "location": "23/TALK"   , "narrator": "真幌", "text": "お疲れさん。\nこんな時間に外出か？"},
        { "location": "24/TALK"   , "narrator": "アーヤ", "text": "はい。\n大学に行った後で、\n新宿の方へ…。"},
        { "location": "25/TALK"   , "narrator": "真幌", "text": "ほう…。"},
        { "location": "26/TALK"   , "narrator": "真幌", "text": "バイクを置いていく\nところから察するに…。"},
        { "location": "28/TALK"   , "narrator": "アーヤ", "text": "ふふっ…館長には\nバレバレですね。"},
        { "location": "29/TALK"   , "narrator": "真幌", "text": "ふっ…、\n程々に楽しんでこいよ。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "はい。\nそれじゃ…。"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "…少し早かったかしら？"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "でも、遅れてみんなを\n待たせたら悪いし…。"},
        { "location": "41/SEL"    , "narrator": "", "text": "どこ行くの？"},
        { "location": "42/SEL"    , "narrator": "", "text": "今暇？"},
        { "location": "43/SEL"    , "narrator": "", "text": "秘密とかない？"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "…日付が変わる前に\n帰れるかしら？"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "ううん、帰らないと。"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "あんまり遅く帰ると、\nギャヴィ達に変な勘繰り\n入れられそうだし。"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "…ふふっ、楽しみだなぁ。"},
        { "location": "52/ACT"    , "narrator": "", "text": "どこ行くの？"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "あっ…。"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "$handle$さん！(*^o^*)"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "今から"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "ちょっと大学に行くの"},
        { "location": "75/SEL"    , "narrator": "", "text": "バイク通学しないの？"},
        { "location": "76/ACT"    , "narrator": "", "text": "バイク通学しないの？"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "今日はね"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "っていうか"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "電車通学の方が多いのよ？"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "大学の後"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "みんなで飲みに行くことも多いし"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "今も"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "大学で待ち合わせて飲みに行くところなの"},
        { "location": "86/SEL"    , "narrator": "", "text": "アーヤって、飲める方なの？"},
        { "location": "87/ACT"    , "narrator": "", "text": "アーヤって、飲める方なの？"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "わからない(｡-_-｡)"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "二杯以上飲まないようにしてるから"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "一度だけ一升瓶空けたことある(・・。)ゞ"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "初めて飲んだ時だったから"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "緊張して酔えなかったけど"},
        { "location": "97/SEL"    , "narrator": "", "text": "…イケる口なんだね"},
        { "location": "98/ACT"    , "narrator": "", "text": "…イケる口なんだね"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "全然よ"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "普通の時だったら絶対酔うと思うし(;^_^A"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "とにかく"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "そういうわけだから"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "話はまた帰ってからね"},
        { "location": "107/SEL"   , "narrator": "", "text": "しっかり楽しんできてね"},
        { "location": "108/ACT"   , "narrator": "", "text": "しっかり楽しんできてね"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "…やっぱり、早く帰ろう。"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "夜は$handle$さんと、\nゆっくり話したいし。"},
        { "location": "125/ACT"   , "narrator": "", "text": "今暇？"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "あっ…。"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "$handle$さん！(*^o^*)"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "暇じゃないんだけど、どうかした？"},
        { "location": "147/SEL"   , "narrator": "", "text": "アーヤと話したくて"},
        { "location": "148/ACT"   , "narrator": "", "text": "アーヤと話したくて"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "そうだったんだ"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "153/TALK"  , "narrator": "アーヤ", "text": "歩きスマホは危ないから(-.-;)"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "またこっちから連絡するわ"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "…素っ気なかったかしら？"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "…ううん。\nさすがに考え過ぎよね。"},
        { "location": "168/ACT"   , "narrator": "", "text": "秘密とかない？"},
        { "location": "172/TALK"  , "narrator": "アーヤ", "text": "あっ…。"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "え？"},
        { "location": "191/SEL"   , "narrator": "", "text": "いや、なんとなく…"},
        { "location": "192/ACT"   , "narrator": "", "text": "いや、なんとなく…"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "私ったら、何をそんなに\nムキになってるのよ…。"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "帰ったら謝らないと…。"},
