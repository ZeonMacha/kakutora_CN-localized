{
    "dir": "chap00/daydra/spev_ch03_003.js",
    "type": "",
    "info": {
        "story_id": "3003",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "屋台の食べ物"
    },
    "entry":
    [
        { "location": "23/TALK" , "narrator": "透明ガブリエラ", "text": "えへへ…やっぱり\n綿あめは食べないと\nねー。"},
        { "location": "25/TALK" , "narrator": "透明ガブリエラ", "text": "…そうだ。"},
        { "location": "27/TALK" , "narrator": "ガブリエラ", "text": "綿あめを買ったわ"},
        { "location": "28/TALK" , "narrator": "ガブリエラ", "text": "やっぱり、お祭りに来たらこれを食べないとね"},
        { "location": "31/TALK" , "narrator": "ガブリエラ", "text": "$handle$もそう思うでしょ？"},
        { "location": "34/TALK" , "narrator": "ガブリエラ", "text": "マルザンナもそう思うでしょ？"},
        { "location": "36/SEL"  , "narrator": "（選択肢）", "text": "ベタベタしてるからなぁ…"},
        { "location": "37/SEL"  , "narrator": "（選択肢）", "text": "綿あめ持ってる姿が可愛い"},
        { "location": "38/ACT"  , "narrator": "", "text": "ベタベタしてるからなぁ…"},
        { "location": "39/TALK" , "narrator": "ガブリエラ", "text": "あら、そんなこと気にしているの？"},
        { "location": "40/TALK" , "narrator": "ガブリエラ", "text": "レディの私はウェットティッシュくらい常備しているわ"},
        { "location": "41/SEL"  , "narrator": "（選択肢）", "text": "準備がいいね"},
        { "location": "42/SEL"  , "narrator": "（選択肢）", "text": "女子力高いな"},
        { "location": "43/ACT"  , "narrator": "", "text": "準備がいいね"},
        { "location": "44/TALK" , "narrator": "ガブリエラ", "text": "お祭りを楽しむためだもの"},
        { "location": "45/TALK" , "narrator": "ガブリエラ", "text": "準備は完璧よ"},
        { "location": "46/ACT"  , "narrator": "", "text": "女子力高いな"},
        { "location": "47/TALK" , "narrator": "ガブリエラ", "text": "これくらいで大げさよ"},
        { "location": "48/TALK" , "narrator": "ガブリエラ", "text": "まあでも"},
        { "location": "49/TALK" , "narrator": "ガブリエラ", "text": "新人やみやびは持ち歩いてなさそうだけど"},
        { "location": "50/TALK" , "narrator": "ガブリエラ", "text": "つまり"},
        { "location": "51/TALK" , "narrator": "ガブリエラ", "text": "あの二人より女子力は上なのは確かよね"},
        { "location": "56/TALK" , "narrator": "ガブリエラ", "text": "それより$handle$"},
        { "location": "58/TALK" , "narrator": "ガブリエラ", "text": "それよりマルザンナ"},
        { "location": "60/TALK" , "narrator": "ガブリエラ", "text": "何か言うことがない？"},
        { "location": "61/TALK" , "narrator": "ガブリエラ", "text": "今の私の姿を見て"},
        { "location": "62/TALK" , "narrator": "ガブリエラ", "text": "言い忘れてることは？"},
        { "location": "64/ACT"  , "narrator": "", "text": "綿あめ持ってる姿が可愛い"},
        { "location": "67/TALK" , "narrator": "ガブリエラ", "text": "変わった褒め方ね"},
        { "location": "68/TALK" , "narrator": "ガブリエラ", "text": "っていうか"},
        { "location": "69/TALK" , "narrator": "ガブリエラ", "text": "綿あめよりももっと"},
        { "location": "70/TALK" , "narrator": "ガブリエラ", "text": "褒めるところがあるでしょ？"},
        { "location": "75/SEL"  , "narrator": "（選択肢）", "text": "浴衣姿、可愛いよ"},
        { "location": "76/SEL"  , "narrator": "（選択肢）", "text": "浴衣だと大人っぽいね"},
        { "location": "77/ACT"  , "narrator": "", "text": "浴衣姿、可愛いよ"},
        { "location": "80/TALK" , "narrator": "ガブリエラ", "text": "なんとなくだけど"},
        { "location": "81/TALK" , "narrator": "ガブリエラ", "text": "子供っぽく見られてる感じがするわ"},
        { "location": "83/TALK" , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "85/TALK" , "narrator": "ガブリエラ", "text": "褒めてくれてはいるんだし"},
        { "location": "86/TALK" , "narrator": "ガブリエラ", "text": "許してあげるわ"},
        { "location": "87/ACT"  , "narrator": "", "text": "浴衣だと大人っぽいね"},
        { "location": "90/TALK" , "narrator": "ガブリエラ", "text": "本当？"},
        { "location": "91/TALK" , "narrator": "ガブリエラ", "text": "浴衣だと大人っぽく見えるなんて"},
        { "location": "92/TALK" , "narrator": "ガブリエラ", "text": "自分じゃ気づかなかったわ"},
        { "location": "93/TALK" , "narrator": "ガブリエラ", "text": "みんなも言ってくれなかったし"},
        { "location": "95/TALK" , "narrator": "ガブリエラ", "text": "みやびみたいに"},
        { "location": "97/TALK" , "narrator": "ガブリエラ", "text": "私も浴衣を着るようにしようかしら？"},
        { "location": "98/TALK" , "narrator": "ガブリエラ", "text": "普段からそう見られたいもの"},
        { "location": "100/SEL" , "narrator": "（選択肢）", "text": "ちょっと心配だな"},
        { "location": "101/ACT" , "narrator": "", "text": "ちょっと心配だな"},
        { "location": "103/TALK", "narrator": "ガブリエラ", "text": "あら、何が？"},
        { "location": "104/SEL" , "narrator": "（選択肢）", "text": "モテちゃいそうで心配"},
        { "location": "105/SEL" , "narrator": "（選択肢）", "text": "みやびみたいになりそう"},
        { "location": "106/ACT" , "narrator": "", "text": "モテちゃいそうで心配"},
        { "location": "109/TALK", "narrator": "ガブリエラ", "text": "なにそれ？"},
        { "location": "111/TALK", "narrator": "ガブリエラ", "text": "可愛らしい心配ね"},
        { "location": "112/TALK", "narrator": "ガブリエラ", "text": "もしかして妬いてる？"},
        { "location": "113/SEL" , "narrator": "（選択肢）", "text": "ノーコメントで"},
        { "location": "114/SEL" , "narrator": "（選択肢）", "text": "純粋に心配"},
        { "location": "115/ACT" , "narrator": "", "text": "ノーコメントで"},
        { "location": "117/TALK", "narrator": "ガブリエラ", "text": "$handle$って"},
        { "location": "119/TALK", "narrator": "ガブリエラ", "text": "マルザンナって"},
        { "location": "121/TALK", "narrator": "ガブリエラ", "text": "ヤキモチ焼きなのね"},
        { "location": "122/TALK", "narrator": "ガブリエラ", "text": "可愛いから嫌いじゃないけど"},
        { "location": "123/ACT" , "narrator": "", "text": "純粋に心配"},
        { "location": "125/TALK", "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "126/TALK", "narrator": "ガブリエラ", "text": "そうかもね"},
        { "location": "127/TALK", "narrator": "ガブリエラ", "text": "そうなったら困るかも"},
        { "location": "128/TALK", "narrator": "ガブリエラ", "text": "でも平気よ"},
        { "location": "130/TALK", "narrator": "ガブリエラ", "text": "だって"},
        { "location": "131/TALK", "narrator": "ガブリエラ", "text": "そんなことにはならないから"},
        { "location": "133/ACT" , "narrator": "", "text": "みやびみたいになりそう"},
        { "location": "134/TALK", "narrator": "ガブリエラ", "text": "それは"},
        { "location": "136/TALK", "narrator": "ガブリエラ", "text": "ちょっと困るかも"},
        { "location": "138/TALK", "narrator": "ガブリエラ", "text": "胸のサイズが似るならいいんだけど"},
        { "location": "141/TALK", "narrator": "ガブリエラ", "text": "今のなし！"},
        { "location": "142/TALK", "narrator": "ガブリエラ", "text": "忘れて//////"},
        { "location": "145/TALK", "narrator": "ガブリエラ", "text": "それじゃ"},
        { "location": "146/TALK", "narrator": "ガブリエラ", "text": "綿あめそろそろ食べるから"},
        { "location": "147/TALK", "narrator": "ガブリエラ", "text": "また後で"},
        { "location": "148/SEL" , "narrator": "（選択肢）", "text": "お祭り楽しんでね"},
        { "location": "149/SEL" , "narrator": "（選択肢）", "text": "あーん"},
        { "location": "150/ACT" , "narrator": "", "text": "お祭り楽しんでね"},
        { "location": "151/TALK", "narrator": "ガブリエラ", "text": "ありがと"},
        { "location": "152/ACT" , "narrator": "", "text": "あーん"},
        { "location": "155/TALK", "narrator": "ガブリエラ", "text": "はい、あーん"},
        { "location": "156/TALK", "narrator": "ガブリエラ", "text": "って、できないでしょ？"},
        { "location": "158/TALK", "narrator": "ガブリエラ", "text": "冗談が好きなのね"},
        { "location": "162/TALK", "narrator": "透明ガブリエラ", "text": "さてと…。"},
        { "location": "164/TALK", "narrator": "透明アーヤ", "text": "見つけた。\nこんなところに\n座ってたのね。"},
        { "location": "166/TALK", "narrator": "透明ガブリエラ", "text": "あ、うん。\nちょっと歩き疲れ\nちゃってね。"},
        { "location": "170/TALK", "narrator": "透明アーヤ", "text": "…そういえば、\nさっきは焼きそば\n食べてなかった？"},
        { "location": "171/TALK", "narrator": "透明ガブリエラ", "text": "そりゃね。\nお祭りに来たら\n食べなくちゃ。"},
        { "location": "172/TALK", "narrator": "透明アーヤ", "text": "お好み焼きと\nたこ焼きとかも\n食べてたわね？"},
        { "location": "173/TALK", "narrator": "透明ガブリエラ", "text": "かき氷とかも\n食べたわ。"},
        { "location": "174/TALK", "narrator": "透明アーヤ", "text": "…食べ過ぎじゃない？"},
        { "location": "176/TALK", "narrator": "透明ガブリエラ", "text": "屋台の食べ物は、\nお祭りじゃないと\n食べれないでしょ？"},
        { "location": "177/TALK", "narrator": "透明ガブリエラ", "text": "アーヤは\n食べないの？"},
        { "location": "178/TALK", "narrator": "透明アーヤ", "text": "私はもういいわ。\nとりあえず\n満足したし。"},
        { "location": "179/TALK", "narrator": "透明ガブリエラ", "text": "勿体ないわねぇ。\nせっかくの\nお祭りなんだし――"},
        { "location": "180/TALK", "narrator": "透明ガブリエラ", "text": "もっと食べれば\nいいのに。"},
        { "location": "181/TALK", "narrator": "透明アーヤ", "text": "うーん、\nそう言われても…。"},
        { "location": "182/TALK", "narrator": "透明アーヤ", "text": "あ、それじゃあ。"},
        { "location": "184/TALK", "narrator": "透明ガブリエラ", "text": "あっ！"},
        { "location": "192/TALK", "narrator": "透明アーヤ", "text": "んっ、\n甘くて美味しいわ。"},
        { "location": "194/TALK", "narrator": "透明ガブリエラ", "text": "ちょ、アーヤ！\n勝手に食べないでよ！"},
        { "location": "195/TALK", "narrator": "透明アーヤ", "text": "ふふっ、見てたら\n食べたくなっちゃった\nのよ。"},
        { "location": "196/TALK", "narrator": "透明アーヤ", "text": "それに、綿あめって\n丸々一つだと私には\n多過ぎるから。"},
        { "location": "197/TALK", "narrator": "透明ガブリエラ", "text": "もぅ…。"},
        { "location": "198/TALK", "narrator": "透明アーヤ", "text": "ごちそうさまでした。\nじゃあ、ちょっと\n屋台見てくるわ。"},
        { "location": "203/TALK", "narrator": "透明ガブリエラ", "text": "…………。"},
        { "location": "204/TALK", "narrator": "透明ガブリエラ", "text": "綿あめ食べた時の\nアーヤ…ちょっと、\n可愛かったかも…。"},
        { "location": "206/TALK", "narrator": "透明ガブリエラ", "text": "…もう一口くらい、\nあげてもよかった\nのに…。"}
    ]
}
