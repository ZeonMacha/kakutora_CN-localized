    "entry":
    [
        { "location": "284/SCENARIO", "narrator": "", "text": "霧の中の距離"},
        { "location": "294/TALK"    , "narrator": "真幌", "text": "…それにしても\n客が来ないな。"},
        { "location": "297/TALK"    , "narrator": "アーヤ", "text": "プログラム\n変えてみますか？"},
        { "location": "299/TALK"    , "narrator": "真幌", "text": "…正直、それで\n動員数が見込める\nわけではない。"},
        { "location": "300/TALK"    , "narrator": "真幌", "text": "特にうちみたいな\n形態の映画館は。"},
        { "location": "301/TALK"    , "narrator": "真幌", "text": "建物が好きな人が\n来るだけの場所に\nなっているからな。"},
        { "location": "302/TALK"    , "narrator": "真幌", "text": "それに、下手に\n人が来るようになると\n支障も出るしな。"},
        { "location": "304/TALK"    , "narrator": "アーヤ", "text": "…そうですよね。"},
        { "location": "305/TALK"    , "narrator": "真幌", "text": "ところで。"},
        { "location": "306/TALK"    , "narrator": "アーヤ", "text": "はい。"},
        { "location": "307/TALK"    , "narrator": "真幌", "text": "この前Ｂｏｔが\nどうとか言っていたのは\n解決したのか？"},
        { "location": "309/TALK"    , "narrator": "アーヤ", "text": "……ええ、まあ。"},
        { "location": "310/TALK"    , "narrator": "真幌", "text": "…………。\nならいいんだが。"},
        { "location": "311/TALK"    , "narrator": "真幌", "text": "他に困ったことは\nないか？"},
        { "location": "313/TALK"    , "narrator": "アーヤ", "text": "……。"},
        { "location": "315/TALK"    , "narrator": "アーヤ", "text": "……実は……。"},
        { "location": "317/TALK"    , "narrator": "アーヤ", "text": "人のちょっとした\n秘密を\n知ってしまって。"},
        { "location": "318/TALK"    , "narrator": "アーヤ", "text": "その後どうやって\n接すればいいのか\n悩んでるんです。"},
        { "location": "319/TALK"    , "narrator": "真幌", "text": "詳しく聞く…\nわけには\nいかないんだろうな。"},
        { "location": "320/TALK"    , "narrator": "真幌", "text": "そのことは\n相手は\n気づいているのか？"},
        { "location": "323/TALK"    , "narrator": "アーヤ", "text": "はい。そして\n今まで通りに\n接して欲しいと。"},
        { "location": "324/TALK"    , "narrator": "アーヤ", "text": "でも私には\nそれが難しくて。"},
        { "location": "325/TALK"    , "narrator": "真幌", "text": "なるほど…。"},
        { "location": "327/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "328/TALK"    , "narrator": "真幌", "text": "秘密を知ったのが\n故意か過失かは\n知らないが。"},
        { "location": "329/TALK"    , "narrator": "真幌", "text": "相手が今まで通りと\n言っているのなら。"},
        { "location": "330/TALK"    , "narrator": "真幌", "text": "それでいいんじゃ\nないか？"},
        { "location": "331/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "332/TALK"    , "narrator": "真幌", "text": "そう簡単には\nいかないか。"},
        { "location": "333/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "334/TALK"    , "narrator": "真幌", "text": "また仲良くできると\nいいな。"},
        { "location": "337/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "349/TALK"    , "narrator": "アーヤ", "text": "いる？"},
        { "location": "350/TALK"    , "narrator": "アーヤ", "text": "って"},
        { "location": "352/SEL"     , "narrator": "", "text": "いるよ！"},
        { "location": "353/SEL"     , "narrator": "", "text": "今日もかわいいね、アーヤ"},
        { "location": "354/SEL"     , "narrator": "", "text": "待ってました！"},
        { "location": "355/ACT"     , "narrator": "", "text": "いるよ！"},
        { "location": "356/TALK"    , "narrator": "アーヤ", "text": "なんなのかしら"},
        { "location": "357/TALK"    , "narrator": "アーヤ", "text": "そのテンション"},
        { "location": "358/ACT"     , "narrator": "", "text": "今日もかわいいね、アーヤ"},
        { "location": "359/TALK"    , "narrator": "アーヤ", "text": "本当に"},
        { "location": "360/TALK"    , "narrator": "アーヤ", "text": "いつも通りね"},
        { "location": "361/ACT"     , "narrator": "", "text": "待ってました！"},
        { "location": "362/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "363/TALK"    , "narrator": "アーヤ", "text": "待っててくれたの"},
        { "location": "365/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "366/TALK"    , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "367/TALK"    , "narrator": "アーヤ", "text": "今日はいいわ"},
        { "location": "370/SEL"     , "narrator": "", "text": "残念"},
        { "location": "371/SEL"     , "narrator": "", "text": "ずっと待ってるから"},
        { "location": "372/SEL"     , "narrator": "", "text": "$me$だって忙しいのに"},
        { "location": "373/ACT"     , "narrator": "", "text": "残念"},
        { "location": "374/TALK"    , "narrator": "アーヤ", "text": "考えが"},
        { "location": "375/TALK"    , "narrator": "アーヤ", "text": "まだ"},
        { "location": "376/TALK"    , "narrator": "アーヤ", "text": "まとまらないのよ"},
        { "location": "377/ACT"     , "narrator": "", "text": "ずっと待ってるから"},
        { "location": "378/TALK"    , "narrator": "アーヤ", "text": "、、、"},
        { "location": "379/TALK"    , "narrator": "アーヤ", "text": "そうなの"},
        { "location": "380/TALK"    , "narrator": "アーヤ", "text": "ううん"},
        { "location": "381/TALK"    , "narrator": "アーヤ", "text": "なんでもない"},
        { "location": "382/ACT"     , "narrator": "", "text": "$me$だって忙しいのに"},
        { "location": "383/TALK"    , "narrator": "アーヤ", "text": "それは"},
        { "location": "384/TALK"    , "narrator": "アーヤ", "text": "悪かったわ"},
        { "location": "385/TALK"    , "narrator": "アーヤ", "text": "ごめんね！"},
        { "location": "398/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "410/TALK"    , "narrator": "アーヤ", "text": "ちょっと質問"},
        { "location": "411/TALK"    , "narrator": "アーヤ", "text": "たいしたことじゃないけど"},
        { "location": "414/TALK"    , "narrator": "ボイスメール", "text": "気持ちヘクトパスカル"},
        { "location": "426/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【気持ちヘクトパスカル】</color>\nをゲットしました！"}
    ]
}
