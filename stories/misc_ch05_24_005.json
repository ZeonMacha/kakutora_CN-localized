    "entry":
    [
        { "location": "8256/SCENARIO", "narrator": "", "text": "野良メイドを拾ったんだがどう育てればいいのかわからない"},
        { "location": "8281/TALK"    , "narrator": "神楽", "text": "メイドには養殖メイドと野良メイドがいるわけだけど"},
        { "location": "8283/SEL"     , "narrator": "", "text": "またまた"},
        { "location": "8284/SEL"     , "narrator": "", "text": "知らなかった…"},
        { "location": "8285/SEL"     , "narrator": "", "text": "うちのメイドはオーダーメイド"},
        { "location": "8286/ACT"     , "narrator": "", "text": "またまた"},
        { "location": "8287/TALK"    , "narrator": "神楽", "text": "マジだから"},
        { "location": "8288/ACT"     , "narrator": "", "text": "知らなかった…"},
        { "location": "8289/TALK"    , "narrator": "神楽", "text": "常識なのに"},
        { "location": "8290/ACT"     , "narrator": "", "text": "うちのメイドはオーダーメイド"},
        { "location": "8292/TALK"    , "narrator": "神楽", "text": "オーダーメイドｗ"},
        { "location": "8294/TALK"    , "narrator": "神楽", "text": "だれうまｗｗｗｗｗ"},
        { "location": "8296/TALK"    , "narrator": "神楽", "text": "先日野良メイドと目が合ったら"},
        { "location": "8297/TALK"    , "narrator": "神楽", "text": "うちまでついてきたんだぴょん"},
        { "location": "8299/SEL"     , "narrator": "", "text": "拾ったの！？"},
        { "location": "8300/SEL"     , "narrator": "", "text": "お母さんに怒られるやつ！"},
        { "location": "8301/SEL"     , "narrator": "", "text": "$me$がまとめて面倒見るよ"},
        { "location": "8302/ACT"     , "narrator": "", "text": "拾ったの！？"},
        { "location": "8303/TALK"    , "narrator": "神楽", "text": "成り行きで？"},
        { "location": "8304/ACT"     , "narrator": "", "text": "お母さんに怒られるやつ！"},
        { "location": "8305/TALK"    , "narrator": "神楽", "text": "そうなのぴょん、、、"},
        { "location": "8306/TALK"    , "narrator": "神楽", "text": "元居たところに戻してきなさいって言われたぴょん、、、"},
        { "location": "8307/ACT"     , "narrator": "", "text": "$me$がまとめて面倒見るよ"},
        { "location": "8309/TALK"    , "narrator": "神楽", "text": "やだ$handlek$カコイイ！"},
        { "location": "8310/TALK"    , "narrator": "神楽", "text": "掘れちゃいそう"},
        { "location": "8311/TALK"    , "narrator": "神楽", "text": "いやさ"},
        { "location": "8312/TALK"    , "narrator": "神楽", "text": "惚れちゃいそう"},
        { "location": "8314/TALK"    , "narrator": "神楽", "text": "あっでもね"},
        { "location": "8315/TALK"    , "narrator": "神楽", "text": "最後にその野良メイドは野良として生きることを選んでぴょんこの腕から飛び出して行ったぴょん、、、"},
        { "location": "8317/TALK"    , "narrator": "神楽", "text": "おしまい。"}
    ]
}
