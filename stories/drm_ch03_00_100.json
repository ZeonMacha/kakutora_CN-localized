{
    "dir": "dramatics/daydra/drm_ch03_00_100.js",
    "type": "Episode",
    "info": {
        "story_id": "3010",
        "cid": "gabriella",
        "title": "らぶとーく  第10話",
        "sub_title": "見たくなかった真実"
    },
    "entry":
    [
        { "location": "234/SCENARIO", "narrator": "", "text": "見たくなかった真実"},
        { "location": "248/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "249/TALK"    , "narrator": "雛", "text": "珍しいねー。"},
        { "location": "250/TALK"    , "narrator": "雛", "text": "ガブリエラちゃんが、\nそんな思い悩んだ\n顔してるなんて。"},
        { "location": "251/TALK"    , "narrator": "ガブリエラ", "text": "…ちょっと、悩んでる\nことがあるのよ。"},
        { "location": "252/TALK"    , "narrator": "雛", "text": "ピピッと来た！！\n恋愛の悩みでしょ！？"},
        { "location": "253/TALK"    , "narrator": "ガブリエラ", "text": "…いや、全然違うし。"},
        { "location": "255/TALK"    , "narrator": "繭", "text": "変なの受信してるだけ。\nいつものことだから\n放っておいていい。"},
        { "location": "257/TALK"    , "narrator": "雛", "text": "高性能なだけですー！"},
        { "location": "258/TALK"    , "narrator": "繭", "text": "…まあ、聞くくらいは\nできるから。"},
        { "location": "259/TALK"    , "narrator": "雛", "text": "聞くって、何を？"},
        { "location": "260/TALK"    , "narrator": "繭", "text": "悩みの話でしょ？\nアドバイスは期待され\nても困るけど。"},
        { "location": "262/TALK"    , "narrator": "ガブリエラ", "text": "期待はしてないわ。\nどうしようもないこと、\nってのはわかって――"},
        { "location": "264/TALK"    , "narrator": "繭", "text": "あっ。"},
        { "location": "265/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "267/TALK"    , "narrator": "繭", "text": "…ごめんなさい。\n話の腰を折ったわ。"},
        { "location": "270/TALK"    , "narrator": "ガブリエラ", "text": "…別に良いわ。\nそれより、\n何かあったの？"},
        { "location": "272/TALK"    , "narrator": "繭", "text": "うん。今、カプドラを\nやっていたんだけど――"},
        { "location": "273/TALK"    , "narrator": "繭", "text": "Ｂｏｔアカウントを\n見つけたの。"},
        { "location": "276/TALK"    , "narrator": "ガブリエラ", "text": "…Ｂｏｔアカウント？"},
        { "location": "278/TALK"    , "narrator": "雛", "text": "どれどれ？"},
        { "location": "279/TALK"    , "narrator": "繭", "text": "こいつ。\nさっきフレンド登録した\nユーザーだけど――"},
        { "location": "280/TALK"    , "narrator": "繭", "text": "あとでブロックして\nおかないと。"},
        { "location": "282/TALK"    , "narrator": "ガブリエラ", "text": "…これ、本当にＢｏｔ？\nあたしには普通にしか\n見えないけど？"},
        { "location": "284/TALK"    , "narrator": "繭", "text": "明らかにＢｏｔ。\nまず、パターン化された\n行動しかしないでしょ。"},
        { "location": "285/TALK"    , "narrator": "繭", "text": "それにこっちの\nメッセージに対する\n返答も皆無。"},
        { "location": "286/TALK"    , "narrator": "繭", "text": "それに、反応速度が\n明らかに異常。"},
        { "location": "287/TALK"    , "narrator": "ガブリエラ", "text": "…パターン化された\n行動？"},
        { "location": "289/TALK"    , "narrator": "ガブリエラ", "text": "でも、マルザンナは\nＢｏｔなのに、そんなの\nないし…。"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "…じゃ、じゃあさ…\nその逆は？"},
        { "location": "293/TALK"    , "narrator": "繭", "text": "？"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "パターン化された行動を\nしないで、メッセージに\n返事をして来たら――"},
        { "location": "298/TALK"    , "narrator": "ガブリエラ", "text": "それは、人間…\nってことになるの？"},
        { "location": "299/TALK"    , "narrator": "繭", "text": "…大雑把に答えると、\nそういうことになる。"},
        { "location": "301/TALK"    , "narrator": "雛", "text": "超絶廃人ゲーマーという\n可能性はー？"},
        { "location": "302/TALK"    , "narrator": "繭", "text": "その割にレベルが低い。\nプレイスタイルも、\n単調過ぎ。"},
        { "location": "303/TALK"    , "narrator": "繭", "text": "廃人ゲーマーにしては\n明らかにおかしい。"},
        { "location": "305/TALK"    , "narrator": "ガブリエラ", "text": "だとすると…\nまさか、本当に…。"},
        { "location": "317/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナ！"},
        { "location": "318/TALK"    , "narrator": "ガブリエラ", "text": "あなた、まさか本当に人間なの？"},
        { "location": "320/SEL"     , "narrator": "", "text": "ずっとそう言っていたよ"},
        { "location": "321/SEL"     , "narrator": "", "text": "うん、そうなんだ"},
        { "location": "322/SEL"     , "narrator": "", "text": "認めたくなかっただけだよね？"},
        { "location": "323/ACT"     , "narrator": "", "text": "ずっとそう言っていたよ"},
        { "location": "324/TALK"    , "narrator": "ガブリエラ", "text": "確かにそうだけど"},
        { "location": "325/ACT"     , "narrator": "", "text": "うん、そうなんだ"},
        { "location": "326/TALK"    , "narrator": "ガブリエラ", "text": "そんな…"},
        { "location": "327/ACT"     , "narrator": "", "text": "認めたくなかっただけだよね？"},
        { "location": "328/TALK"    , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "329/TALK"    , "narrator": "ガブリエラ", "text": "そういう気持ちも確かにあったけど"},
        { "location": "331/TALK"    , "narrator": "ガブリエラ", "text": "でも、それならなんでマルザンナのふりをしていたの？"},
        { "location": "332/TALK"    , "narrator": "ガブリエラ", "text": "私がマルザンナって呼ぶたびに、違うって否定すればよかったのに"},
        { "location": "333/TALK"    , "narrator": "ガブリエラ", "text": "まさか！"},
        { "location": "334/TALK"    , "narrator": "ガブリエラ", "text": "貴方、マルザンナを乗っ取ったのね！？"},
        { "location": "336/SEL"     , "narrator": "", "text": "最初から$me$は$me$"},
        { "location": "337/ACT"     , "narrator": "", "text": "最初から$me$は$me$"},
        { "location": "339/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ、なんでマルザンナって名乗ってたのよ？"},
        { "location": "342/SEL"     , "narrator": "", "text": "ガブリエラが名付けてくれたから"},
        { "location": "343/ACT"     , "narrator": "", "text": "ガブリエラが名付けてくれたから"},
        { "location": "345/TALK"    , "narrator": "ガブリエラ", "text": "…なるほどね"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "とりあえず、今はそれで納得しておくわ"},
        { "location": "357/TALK"    , "narrator": "ガブリエラ", "text": "…確かに、マルザンナ\nって勝手に名付けたのは\nあたしだったわ。"},
        { "location": "358/TALK"    , "narrator": "ガブリエラ", "text": "けど…マルザンナが\n本当に人間だった\nなんて…。"},
        { "location": "360/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…やっぱり、\n人間なのよね…。"},
        { "location": "362/TALK"    , "narrator": "雛", "text": "…まゆちん。\nガブリエラちゃん、\nどうしちゃったのかな？"},
        { "location": "364/TALK"    , "narrator": "繭", "text": "放っておいて\nいいと思う。"},
        { "location": "365/TALK"    , "narrator": "繭", "text": "きっと、私達には\nわからない悩みが\nあるんだろうし…。"}
    ]
}
