    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "うそうその嘘"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "驚け相棒"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "卯月はスパイだったぞね"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "そしてうちは"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "それを見破った"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "天災ＪＫ"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "いやさ天才女子高生"},
        { "location": "41/SEL"    , "narrator": "", "text": "さすがはみやびだ"},
        { "location": "42/SEL"    , "narrator": "", "text": "あまり喜べない"},
        { "location": "43/SEL"    , "narrator": "", "text": "また一緒に来たかったね"},
        { "location": "44/ACT"    , "narrator": "", "text": "さすがはみやびだ"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "そうであろう"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "もっと褒めよ"},
        { "location": "49/SEL"    , "narrator": "", "text": "みやびに盛大な拍手を！"},
        { "location": "50/SEL"    , "narrator": "", "text": "さすが天才女子高生！"},
        { "location": "51/SEL"    , "narrator": "", "text": "灰色の脳細胞が銀色に輝いてる！"},
        { "location": "52/ACT"    , "narrator": "", "text": "みやびに盛大な拍手を！"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "ぱちぱちぱちぱち（真顔）"},
        { "location": "54/ACT"    , "narrator": "", "text": "さすが天才女子高生！"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "超高校生級と呼びたまえ"},
        { "location": "56/ACT"    , "narrator": "", "text": "灰色の脳細胞が銀色に輝いてる！"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "印刷色を特色に差し替えだ！"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "しかし褒められても"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "あんまりうれしゅうない"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "むしろもんやりだ"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "なんぞこれ"},
        { "location": "65/ACT"    , "narrator": "", "text": "あまり喜べない"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "喜ばんでもえい"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "卯月に関する事実を"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "受け止めればそれでいいのだ"},
        { "location": "69/ACT"    , "narrator": "", "text": "また一緒に来たかったね"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "ああ"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "それだ"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "きっとそれだ"},
        { "location": "76/SEL"    , "narrator": "", "text": "うん"},
        { "location": "77/SEL"    , "narrator": "", "text": "重すぎる事情があったんだろうね"},
        { "location": "78/SEL"    , "narrator": "", "text": "みやびは人がいいね"},
        { "location": "79/ACT"    , "narrator": "", "text": "うん"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "な"},
        { "location": "81/ACT"    , "narrator": "", "text": "重すぎる事情があったんだろうね"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "喪失感と共に"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "その重さを感じる"},
        { "location": "86/ACT"    , "narrator": "", "text": "みやびは人がいいね"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "そうかもしらん"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "でも"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "それならそれでえいと思うとる"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "裏切りにむかついていないわけではない"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "それに疑いきれんかったうちの甘さに腹も立てとる"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "しかしだ"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "卯月とまたここにという話"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "それもまた本心だったきね"}
    ]
}
