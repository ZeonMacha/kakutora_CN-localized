    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "39_不都合という都合"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "人にはいろんな都合があるのよ"},
        { "location": "36/SEL"    , "narrator": "", "text": "そうだろうね"},
        { "location": "37/SEL"    , "narrator": "", "text": "そんなの知らないし"},
        { "location": "38/SEL"    , "narrator": "", "text": "$me$はいつでもアーヤに合わせるよ"},
        { "location": "39/ACT"    , "narrator": "", "text": "そうだろうね"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "そうなのよね(-.-;)"},
        { "location": "41/ACT"    , "narrator": "", "text": "そんなの知らないし"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "冷たいわね(-ω-;)"},
        { "location": "43/ACT"    , "narrator": "", "text": "$me$はいつでもアーヤに合わせるよ"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "あら（￣ー￣？）"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "合わせてくれるの？"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "やさしいのね"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "ありがとう(=^0^=)"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "でね"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "相手の都合より"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "自分の都合よね？"},
        { "location": "63/SEL"    , "narrator": "", "text": "そこは折り合おうよ"},
        { "location": "64/SEL"    , "narrator": "", "text": "エゴイズムの極地だね"},
        { "location": "65/SEL"    , "narrator": "", "text": "時と場合によるかな"},
        { "location": "66/ACT"    , "narrator": "", "text": "そこは折り合おうよ"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "そうよね、、、"},
        { "location": "68/ACT"    , "narrator": "", "text": "エゴイズムの極地だね"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "そうかもしれないけど"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "でもね、、、"},
        { "location": "71/ACT"    , "narrator": "", "text": "時と場合によるかな"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "確かに"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "そうかもね、、、"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "告ごうって聞かないとわからないけど"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "あ"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "都合"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "聞かない方がいいこともあると思わない？"},
        { "location": "80/SEL"    , "narrator": "", "text": "うーん……"},
        { "location": "81/SEL"    , "narrator": "", "text": "何の話？"},
        { "location": "82/SEL"    , "narrator": "", "text": "もう少し詳しく"},
        { "location": "83/ACT"    , "narrator": "", "text": "うーん……"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "あれ"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "返答に困ること？"},
        { "location": "86/ACT"    , "narrator": "", "text": "何の話？"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "あ"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "これだけじゃわからないか"},
        { "location": "89/ACT"    , "narrator": "", "text": "もう少し詳しく"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "おおざっぱすぎるかもね"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "普通につきあってるつもりだったのに"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "それが本当は普通じゃなくて"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "すごくおかしいのかもって思うようになったのよ"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "だから"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "それは普通なのか普通じゃないかを"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "知りたいと思ってて"},
        { "location": "101/SEL"   , "narrator": "", "text": "やっぱりわからん"},
        { "location": "102/SEL"   , "narrator": "", "text": "普通じゃないとダメってこと？"},
        { "location": "103/ACT"   , "narrator": "", "text": "やっぱりわからん"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "あ"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "そう？"},
        { "location": "106/ACT"   , "narrator": "", "text": "普通じゃないとダメってこと？"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "うーん、、、"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "うまく言えないけど、、、"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "たぶん"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "私の考えてるおかしなことを"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "最初から説明されていたら"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "そんなにおかしいことでもなくて"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "ただ"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "今と全然違うことになっていたと思うの"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "って"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "なんとなくでも"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "伝わったかしら"},
        { "location": "126/SEL"   , "narrator": "", "text": "悩んでることはわかった"},
        { "location": "127/SEL"   , "narrator": "", "text": "伝わったような、伝わってないような"},
        { "location": "128/SEL"   , "narrator": "", "text": "ごめん、無理"},
        { "location": "129/ACT"   , "narrator": "", "text": "悩んでることはわかった"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "そうね"},
        { "location": "132/TALK"  , "narrator": "アーヤ", "text": "悩んでるの"},
        { "location": "133/ACT"   , "narrator": "", "text": "伝わったような、伝わってないような"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "そう"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "そういうものかもね"},
        { "location": "136/ACT"   , "narrator": "", "text": "ごめん、無理"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "、、、"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "仕方ないわ"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "それで"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "本当のことを知りたいと思ってるの"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "というか"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "はっきりさせたいって思ってるの"},
        { "location": "145/SEL"   , "narrator": "", "text": "そっとしといた方がいいこともあるよ"},
        { "location": "146/SEL"   , "narrator": "", "text": "そういうのよくわからないな"},
        { "location": "147/ACT"   , "narrator": "", "text": "そっとしといた方がいいこともあるよ"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "そうｋも"},
        { "location": "149/TALK"  , "narrator": "アーヤ", "text": "しれないけど"},
        { "location": "150/ACT"   , "narrator": "", "text": "そういうのよくわからないな"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "そうなのね"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "ただね"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "はっきりさせたら"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "私ちょっと"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "ううんだいぶ"},
        { "location": "158/TALK"  , "narrator": "アーヤ", "text": "辛いことになると思うの"},
        { "location": "161/SEL"   , "narrator": "", "text": "じゃあやめとけば"},
        { "location": "162/SEL"   , "narrator": "", "text": "そこまでして知りたいの？"},
        { "location": "164/ACT"   , "narrator": "", "text": "じゃあやめとけば"},
        { "location": "165/TALK"  , "narrator": "アーヤ", "text": "そうね"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "そのやり方が"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "正しいのかもしれないわ"},
        { "location": "168/ACT"   , "narrator": "", "text": "そこまでして知りたいの？"},
        { "location": "178/TALK"  , "narrator": "アーヤ", "text": "、、、"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "そうね"},
        { "location": "181/SEL"   , "narrator": "", "text": "だったらはっきりさせたら"},
        { "location": "182/SEL"   , "narrator": "", "text": "もう決まってるってことだよね"},
        { "location": "183/ACT"   , "narrator": "", "text": "だったらはっきりさせたら"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "185/TALK"  , "narrator": "アーヤ", "text": "それしかないか"},
        { "location": "186/ACT"   , "narrator": "", "text": "もう決まってるってことだよね"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "そうね"},
        { "location": "188/TALK"  , "narrator": "アーヤ", "text": "結局そういうこと"},
        { "location": "191/TALK"  , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "192/TALK"  , "narrator": "アーヤ", "text": "言っておかないといけないと思うから"},
        { "location": "193/TALK"  , "narrator": "アーヤ", "text": "送るわね"},
        { "location": "197/TALK"  , "narrator": "ボイスメール", "text": "くしゃみの理由"},
        { "location": "49/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "174/DIALOG", "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "209/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【くしゃみの理由】</color>\nをゲットしました！"}
    ]
