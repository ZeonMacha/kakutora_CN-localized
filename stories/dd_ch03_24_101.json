{
    "dir": "chap24/daydra/dd_ch03_24_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "24302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "貴方に焦がれる手紙＜前編＞"
    },
    "entry":
    [
        { "location": "22/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "23/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…最悪…。\n本当意味わかんない。"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "どうしてつばめは、\nあんな必死に神楽を\n庇おうとするの？"},
        { "location": "25/TALK"   , "narrator": "ガブリエラ", "text": "あんなに神楽から\n酷いことされたって\nいうのに…。"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "あれじゃまるで、\n神楽に対して怒ってる\nあたし達が悪いみたい…。"},
        { "location": "27/TALK"   , "narrator": "ガブリエラ", "text": "仲がいいにしても、\n度を超えてるわ。\n本当、理解できない…。"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "…誰よ、まったく。"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "…ああ、そうだった。\n終わったら教えるって\n言ったんだったわ。"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "えっと…。"},
        { "location": "57/TALK"   , "narrator": "雛", "text": "――そっかー。"},
        { "location": "58/TALK"   , "narrator": "雛", "text": "やっぱつばめちゃん、\n神楽ちゃんのこと\n庇ったんだ…。"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよ。\n本当、理解できないわ。"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "…っていうか、\nわざわざ来ること\nなかったのに。"},
        { "location": "63/TALK"   , "narrator": "雛", "text": "だってー、重要な話は\n直接の方がいいと\n思うしー。"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "66/TALK"   , "narrator": "繭", "text": "…聞いていい？"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "…答えられる\nことなら。"},
        { "location": "68/TALK"   , "narrator": "繭", "text": "逢瀬さん以外は、\n卯月さんへどう対応\nしようと考えてるの？"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "…そんなの\n敵として見るに\n決まってるでしょ？"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "向こうはこっちを\n本気で殺しにかかって\nきてるのよ？"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "そうする以外ないでしょ。"},
        { "location": "72/TALK"   , "narrator": "雛", "text": "…そうなっちゃう\nのかあ……。"},
        { "location": "74/TALK"   , "narrator": "繭", "text": "命がかかってる。\n甘いことは\n言ってられない。"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "そう、その通りよ。"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "これは命を懸けた\n戦いなの。"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "甘いこと言ってたら、\nこっちが殺されるわ。"},
        { "location": "80/TALK"   , "narrator": "雛", "text": "…ガブリエラちゃんは\n今度神楽ちゃんに会ったら\nその時は、やっぱり…。"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "撃つわ。\n迷わず、確実にね…。"},
        { "location": "84/TALK"   , "narrator": "雛", "text": "そっか…。"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "…なによ。\nあんたまで神楽と仲良く\nしろとか言うわけ？"},
        { "location": "87/TALK"   , "narrator": "雛", "text": "まさか！"},
        { "location": "88/TALK"   , "narrator": "雛", "text": "そりゃ、神楽ちゃんが\n敵って聞いてショックは\n受けたよ？"},
        { "location": "89/TALK"   , "narrator": "雛", "text": "けど、つばめちゃんに\nひどいことを\nしたんでしょ……？"},
        { "location": "91/TALK"   , "narrator": "繭", "text": "卯月神楽は敵。\nそれでいいと思う。"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "…そう。"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "うん…そうよ。\nこれが普通よ。"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "神楽はスパイで、\nつばめを殺そうと\nしたんだもの。"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "…あたし達は、\n間違ってないわ。"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "…そうよ。\n間違ってるのはつばめよ。"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "あんな目にあっても、\nまだ神楽のことを\n庇うなんて…。"},
        { "location": "102/TALK"  , "narrator": "雛", "text": "あはは…でもまあ、\nつばめちゃんらしくは\nあるよねー。"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "は？"},
        { "location": "107/TALK"  , "narrator": "雛", "text": "つばめちゃんなら、\n庇ったとしても\nおかしくはないよ。"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "はあ！？　何を\n言っているのよ！？"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "神楽はもう友達じゃ\nないし、\nむしろ敵なのよ？"},
        { "location": "110/TALK"  , "narrator": "雛", "text": "うん、そうだね。"},
        { "location": "111/TALK"  , "narrator": "雛", "text": "けど、つばめちゃんなら\n神楽ちゃんを庇っても、\n全然不思議に思えないよ。"},
        { "location": "113/TALK"  , "narrator": "繭", "text": "逢瀬さんが他人に対して、\n明確な敵意を見せる姿、\n想像つかない。"},
        { "location": "115/TALK"  , "narrator": "雛", "text": "そうそう。\nそういうこと。"},
        { "location": "117/TALK"  , "narrator": "雛", "text": "だから今回のことも、\nつばめちゃんらしいなぁ、\nくらいにしか思えないよ。"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "120/TALK"  , "narrator": "繭", "text": "…納得した？"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "し、してないわ！\nするわけないから！"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "…確かに、つばめなら\nそれが当たり前かも。"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "でも…そんなの\nやっぱりおかしい！"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "あんなに酷いこと\nされたのに、\nどうして信じられるの？"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "もっと…少しでも、\n怒ったり恨んだり\nしてもいいのに！"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "……もしかしたら\nわたしの知らない\n事情があるの…？"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "…ううん。\nだからって\n許されないわ……！"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "まったく…、\nどうして神楽の味方が\nできるんだか…。"},
        { "location": "134/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "…何よ？"},
        { "location": "140/TALK"  , "narrator": "雛", "text": "あ、ううん。\nなんか、ちょっと\nわからなくて…。"},
        { "location": "142/TALK"  , "narrator": "雛", "text": "ガブリエラちゃんは、\n何が一番許せないの？"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "何がって、それは…！"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "…………？"},
        { "location": "148/TALK"  , "narrator": "ガブリエラ", "text": "あれ…？\nあたしが一番許せない\nのって…。"},
        { "location": "150/TALK"  , "narrator": "繭", "text": "…自分たちを裏切り、\n逢瀬さんに酷いことを\nした卯月神楽？"},
        { "location": "151/TALK"  , "narrator": "繭", "text": "それとも、そんな\n卯月神楽を庇う、\n逢瀬さんに対してか。"},
        { "location": "152/TALK"  , "narrator": "繭", "text": "結局、どっちが\n一番許せないの？"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "あ、あたしは…。"},
        { "location": "203/TALK"  , "narrator": "ガブリエラ", "text": "　"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "よかった！\nちゃんとここに\n来てくれたわね！"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "マーカーが\n仕事してくれて\n良かったわ。"},
        { "location": "228/SEL"   , "narrator": "", "text": "大丈夫？\n何か大変なことされてない？"},
        { "location": "229/ACT"   , "narrator": "", "text": "大丈夫？\n何か大変なことされてない？"},
        { "location": "231/TALK"  , "narrator": "ガブリエラ", "text": "まだ大丈夫よ。"},
        { "location": "232/TALK"  , "narrator": "ガブリエラ", "text": "でももう、\n何が起きてもおかしくない\n状況だし急ぎましょ。"},
        { "location": "233/SEL"   , "narrator": "", "text": "どこへ行くの？"},
        { "location": "234/ACT"   , "narrator": "", "text": "どこへ行くの？"},
        { "location": "236/TALK"  , "narrator": "ガブリエラ", "text": "あたしの家。"},
        { "location": "237/SEL"   , "narrator": "", "text": "楽しみ"},
        { "location": "238/SEL"   , "narrator": "", "text": "お父様にご挨拶致します"},
        { "location": "239/ACT"   , "narrator": "", "text": "楽しみ"},
        { "location": "240/TALK"  , "narrator": "ガブリエラ", "text": "普通の家よ。"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "まあ確かに、\n日本の家とは\n全然違うけど。"},
        { "location": "242/ACT"   , "narrator": "", "text": "お父様にご挨拶致します"},
        { "location": "243/TALK"  , "narrator": "ガブリエラ", "text": "殺されるわよ？"},
        { "location": "245/TALK"  , "narrator": "ガブリエラ", "text": "それに、これから行く家は\n厳密にはあたしの生家とは\nちょっと違うの。"},
        { "location": "246/TALK"  , "narrator": "ガブリエラ", "text": "ココロの中でも\n大切なものが沢山詰まった\n場所…その象徴。"},
        { "location": "247/TALK"  , "narrator": "ガブリエラ", "text": "だから$handle$が\nもしうちに来たら、きっと\n全然違うって言うわね。"},
        { "location": "263/TALK"  , "narrator": "ガブリエラ", "text": "……な、なによこれ……。"},
        { "location": "264/SEL"   , "narrator": "", "text": "壊れてる"},
        { "location": "265/ACT"   , "narrator": "", "text": "壊れてる"},
        { "location": "267/TALK"  , "narrator": "ガブリエラ", "text": "誰かが壊した。\nあたしの封印の家を\n誰かが、壊した。"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "……一体誰が…\n何の目的で……"},
        { "location": "269/SEL"   , "narrator": "", "text": "何が封印されていたの？"},
        { "location": "270/ACT"   , "narrator": "", "text": "何が封印されていたの？"},
        { "location": "273/TALK"  , "narrator": "ガブリエラ", "text": "封印されているものを\nレディに聞くのは\nマナーが悪くてよ？"},
        { "location": "274/TALK"  , "narrator": "ガブリエラ", "text": "でも、１つは既に\nバレちゃってるけどね。"},
        { "location": "275/SEL"   , "narrator": "", "text": "本当に母親を殺してしまったの？"},
        { "location": "276/ACT"   , "narrator": "", "text": "本当に母親を殺してしまったの？"},
        { "location": "278/TALK"  , "narrator": "ガブリエラ", "text": "ええ、本当よ。\nあたしは、\n母を殺してしまった。"},
        { "location": "279/TALK"  , "narrator": "ガブリエラ", "text": "それは事故だったけど\nでも殺したことに\n変わりはない。"},
        { "location": "280/TALK"  , "narrator": "ガブリエラ", "text": "今でも現実のあたしは\nそれを受け入れられない。"},
        { "location": "281/TALK"  , "narrator": "ガブリエラ", "text": "だからこうして\n家の中に封印してあった。\nそれなのに……。"},
        { "location": "282/TALK"  , "narrator": "ガブリエラ", "text": "何とかしてこの家を\n修復しないと、いずれ\nあたしはおかしくなる。"},
        { "location": "283/TALK"  , "narrator": "ガブリエラ", "text": "受け入れられない現実を\n受け入れるには、まだ\nココロが未熟なのよ。"},
        { "location": "284/TALK"  , "narrator": "？？？", "text": "それはどうかしら。"},
        { "location": "286/TALK"  , "narrator": "ガブリエラ", "text": "…！？"},
        { "location": "290/SEL"   , "narrator": "", "text": "千羽鶴！？"},
        { "location": "291/ACT"   , "narrator": "", "text": "千羽鶴！？"},
        { "location": "295/TALK"  , "narrator": "？？？", "text": "あんたはあたしのココロを\n見くびってるのね。"},
        { "location": "298/TALK"  , "narrator": "？？？", "text": "あたしのこころはもう、\nこの事について十分\n受け入れられる。"},
        { "location": "299/TALK"  , "narrator": "？？？", "text": "だから、\n今こそ封印を解くべき。"},
        { "location": "300/TALK"  , "narrator": "ガブリエラ", "text": "無理よ！！"},
        { "location": "301/TALK"  , "narrator": "？？？", "text": "できるわ。\nあたしはもう\n一人じゃない。"},
        { "location": "302/TALK"  , "narrator": "？？？", "text": "前とは違う。\nみんなが支えてくれる。"},
        { "location": "303/TALK"  , "narrator": "ガブリエラ", "text": "そんなこと\nできっこないわ！"},
        { "location": "304/TALK"  , "narrator": "ガブリエラ", "text": "みんながいるから\n過去が変えられるの！？\nお母様が戻ってくるの？"},
        { "location": "305/TALK"  , "narrator": "ガブリエラ", "text": "慰めてくれるだけなんて\n屈辱以外何物でもないわ。\nまっぴらごめんよ！"},
        { "location": "306/TALK"  , "narrator": "千羽鶴", "text": "残念だけど。"},
        { "location": "307/TALK"  , "narrator": "ガブリエラ", "text": "そういえば、\nあんた誰よ。"},
        { "location": "308/TALK"  , "narrator": "千羽鶴", "text": "私は千羽鶴。\n貴方の…\nココロの司書の契約主。"},
        { "location": "309/TALK"  , "narrator": "ガブリエラ", "text": "あ、あんたが\nあたしの…契約主…！？"},
        { "location": "310/TALK"  , "narrator": "千羽鶴", "text": "そう。\nそして今をもって、\nその任を解く。"},
        { "location": "311/TALK"  , "narrator": "千羽鶴", "text": "今までお疲れさま。"},
        { "location": "312/TALK"  , "narrator": "ガブリエラ", "text": "はぁ！？\n何をいきなり\n言い出すわけ？"},
        { "location": "313/TALK"  , "narrator": "ガブリエラ", "text": "あたしにはまだ\n確認しなくちゃいけない\nことがあるの。"},
        { "location": "314/TALK"  , "narrator": "千羽鶴", "text": "それももう終わり。\n今の貴方に\nその権限はない。"},
        { "location": "315/TALK"  , "narrator": "ガブリエラ", "text": "ちょ！\nちょっとまっ――"},
        { "location": "357/TALK"  , "narrator": "千羽鶴", "text": "改めて。\nようこそ、ガブリエラの\nココロスフィアへ。"},
        { "location": "360/TALK"  , "narrator": "千羽鶴", "text": "國政綾水の\nココロゲートでも\n話をしたけども――"},
        { "location": "362/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラの\nココロゲートでも\n話をしたけども――"},
        { "location": "364/TALK"  , "narrator": "千羽鶴", "text": "恋ヶ崎みやびの\nココロゲートでも\n話をしたけども――"},
        { "location": "366/TALK"  , "narrator": "千羽鶴", "text": "次回から、\n彼女たちの心のメンテは\n私が直接やることにする。"},
        { "location": "367/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n今回だけはクランの\n消去を手伝って欲しい。"},
        { "location": "369/SEL"   , "narrator": "", "text": "なんで千羽鶴が！？"},
        { "location": "370/ACT"   , "narrator": "", "text": "なんで千羽鶴が！？"},
        { "location": "372/TALK"  , "narrator": "千羽鶴", "text": "前回のメンテナンスで\n権限拡大をしたから。"},
        { "location": "373/TALK"  , "narrator": "千羽鶴", "text": "これからは、\n私が直接ココロゲートを\n管理することにする。"},
        { "location": "374/SEL"   , "narrator": "", "text": "なにそれすごい"},
        { "location": "375/SEL"   , "narrator": "", "text": "なにそれやばい"},
        { "location": "376/ACT"   , "narrator": "", "text": "なにそれすごい"},
        { "location": "377/TALK"  , "narrator": "千羽鶴", "text": "本当は最初から\nこうしておく\nべきだった。"},
        { "location": "378/TALK"  , "narrator": "千羽鶴", "text": "だから、途中から\n方針転換をして\n準備はしていた。"},
        { "location": "379/TALK"  , "narrator": "千羽鶴", "text": "けど、OSの機能制限で\nなかなかできず。\nようやく前回実現した。"},
        { "location": "380/ACT"   , "narrator": "", "text": "なにそれやばい"},
        { "location": "381/TALK"  , "narrator": "千羽鶴", "text": "やばくなんかない。"},
        { "location": "382/TALK"  , "narrator": "千羽鶴", "text": "元々の想定では\n私が直接介入する\n予定だったんだから。"},
        { "location": "383/TALK"  , "narrator": "千羽鶴", "text": "けど、OSの機能制限で\nそれはできなかった。\nだから前回調整した。"},
        { "location": "385/SEL"   , "narrator": "", "text": "でも、チュートリアルでは$me$にしか出来ない役割だと…"},
        { "location": "386/ACT"   , "narrator": "", "text": "でも、チュートリアルでは$me$にしか出来ない役割だと…"},
        { "location": "388/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "389/SEL"   , "narrator": "", "text": "どうして、やろうと思えば自分でできたのに$me$にやらせたの？"},
        { "location": "390/ACT"   , "narrator": "", "text": "どうして、やろうと思えば自分でできたのに$me$にやらせたの？"},
        { "location": "392/TALK"  , "narrator": "千羽鶴", "text": "彼女の自由意志によって、\n理想的な世界を創造する\n道程を進んで欲しかった。"},
        { "location": "393/TALK"  , "narrator": "千羽鶴", "text": "私が介入するということは\n洗脳することと同義。"},
        { "location": "394/TALK"  , "narrator": "千羽鶴", "text": "私は貴方と違い、\n自身だけでクランを\n対処できない。"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "よって、私にできることは\nクランが出る前に\nココロを固めること――"},
        { "location": "396/TALK"  , "narrator": "千羽鶴", "text": "すなわち、\n洗脳することだけ。"},
        { "location": "397/TALK"  , "narrator": "千羽鶴", "text": "けど、それは極力\n避けたかった。"},
        { "location": "398/TALK"  , "narrator": "千羽鶴", "text": "だから、クランに介入\nできる貴方にお願いした。"},
        { "location": "399/TALK"  , "narrator": "千羽鶴", "text": "そうすれば、\n彼女の意志である\nココロの司書と協力し――"},
        { "location": "400/TALK"  , "narrator": "千羽鶴", "text": "彼女自らの意志として\n理想的な未来を\n歩むことができる。"},
        { "location": "401/TALK"  , "narrator": "千羽鶴", "text": "誤算だったのは、\n初代ココロの司書たち。"},
        { "location": "402/SEL"   , "narrator": "", "text": "そこを予測して動かなかったのは落ち度じゃない？"},
        { "location": "403/SEL"   , "narrator": "", "text": "どうして洗脳ではなく、自由意志を重視したの？"},
        { "location": "404/ACT"   , "narrator": "", "text": "そこを予測して動かなかったのは落ち度じゃない？"},
        { "location": "405/TALK"  , "narrator": "千羽鶴", "text": "人のココロを、\n全く介入せず予測するのは\n何より難しい計算。"},
        { "location": "406/TALK"  , "narrator": "千羽鶴", "text": "複数の人間の自由意志を\n保持しつつ、未来を予測\nするのは神業に近い。"},
        { "location": "407/TALK"  , "narrator": "千羽鶴", "text": "その為、上手くいかない\n場合の対応策も用意しつつ\n運用を試みている。"},
        { "location": "408/SEL"   , "narrator": "", "text": "もしかして、それが新しい司書？"},
        { "location": "409/ACT"   , "narrator": "", "text": "もしかして、それが新しい司書？"},
        { "location": "411/TALK"  , "narrator": "千羽鶴", "text": "そう。\nそれが第一の対応策。"},
        { "location": "412/TALK"  , "narrator": "千羽鶴", "text": "半分だけ彼女の意志を\n残した状態で、もう半分を\n意図的に動かせる存在――"},
        { "location": "413/TALK"  , "narrator": "千羽鶴", "text": "半人格による\nココロの制御。"},
        { "location": "414/TALK"  , "narrator": "千羽鶴", "text": "これは例えるなら\n心臓ペースメーカーに\n近い。"},
        { "location": "415/TALK"  , "narrator": "千羽鶴", "text": "免疫力に抵抗されず、\n人工的なシステムによって\n人をサポートする。"},
        { "location": "416/TALK"  , "narrator": "千羽鶴", "text": "そして、それでも\n難しいと判断した場合は、\n私が介入する予定だった。"},
        { "location": "417/TALK"  , "narrator": "千羽鶴", "text": "これは完全なる洗脳に\nなるから、代償が伴う。"},
        { "location": "418/TALK"  , "narrator": "千羽鶴", "text": "けど、それを加味しても\nやらねばならないときが\n来たらやるつもりだった。"},
        { "location": "419/ACT"   , "narrator": "", "text": "どうして洗脳ではなく、自由意志を重視したの？"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "洗脳による\n未来の創造では\n欠落するものがある。"},
        { "location": "421/TALK"  , "narrator": "千羽鶴", "text": "極力その欠落を\n抑えつつ未来を\n選択せねばならない。"},
        { "location": "422/SEL"   , "narrator": "", "text": "何が欠落するの？"},
        { "location": "423/ACT"   , "narrator": "", "text": "何が欠落するの？"},
        { "location": "425/TALK"  , "narrator": "千羽鶴", "text": "強い意志と精神力。"},
        { "location": "427/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、\n既に私自身が介入する\nことで決定した。"},
        { "location": "429/TALK"  , "narrator": "千羽鶴", "text": "だから、これによって\n貴方は、少しだけ重荷が\nおりることになる。"},
        { "location": "430/TALK"  , "narrator": "千羽鶴", "text": "これからは、ココロの中に\n方針を与える必要は\nなくなるから――"},
        { "location": "431/TALK"  , "narrator": "千羽鶴", "text": "思う存分、彼女と\nイチャイチャするだけで\nオッケー！"},
        { "location": "432/SEL"   , "narrator": "", "text": "やったー！"},
        { "location": "433/SEL"   , "narrator": "", "text": "えー"},
        { "location": "434/ACT"   , "narrator": "", "text": "やったー！"},
        { "location": "435/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n次回からはココロゲートに\n来なくてもいい。"},
        { "location": "436/ACT"   , "narrator": "", "text": "えー"},
        { "location": "437/TALK"  , "narrator": "千羽鶴", "text": "意外。"},
        { "location": "438/TALK"  , "narrator": "千羽鶴", "text": "そこで嫌がられるとは\n思ってもみなかった。"},
        { "location": "439/TALK"  , "narrator": "千羽鶴", "text": "ココロゲートと\nクランのデリートは\nかなり負担だったのでは。"},
        { "location": "440/SEL"   , "narrator": "", "text": "まあ、ね…"},
        { "location": "441/SEL"   , "narrator": "", "text": "いや、楽しかった"},
        { "location": "442/ACT"   , "narrator": "", "text": "まあ、ね…"},
        { "location": "443/TALK"  , "narrator": "千羽鶴", "text": "じゃあどうして\nえーなの？"},
        { "location": "444/ACT"   , "narrator": "", "text": "いや、楽しかった"},
        { "location": "445/TALK"  , "narrator": "千羽鶴", "text": "そうなのね。\nかわった人。"},
        { "location": "446/SEL"   , "narrator": "", "text": "司書たちとラブラブ中だったし"},
        { "location": "447/SEL"   , "narrator": "", "text": "バトル出来なくなるの辛い"},
        { "location": "448/SEL"   , "narrator": "", "text": "お話の核心が見られるから"},
        { "location": "449/SEL"   , "narrator": "", "text": "どっちかというと千羽鶴に任せるのが心配"},
        { "location": "450/ACT"   , "narrator": "", "text": "司書たちとラブラブ中だったし"},
        { "location": "451/TALK"  , "narrator": "千羽鶴", "text": "禁断の恋ね。\n誰とラブラブしたのか\n教えて。"},
        { "location": "452/SEL"   , "narrator": "", "text": "つばめの元司書"},
        { "location": "453/SEL"   , "narrator": "", "text": "つばめの新司書"},
        { "location": "454/SEL"   , "narrator": "", "text": "アーヤの元司書"},
        { "location": "455/SEL"   , "narrator": "", "text": "アーヤの新司書"},
        { "location": "456/SEL"   , "narrator": "", "text": "ガブリエラの司書"},
        { "location": "457/SEL"   , "narrator": "", "text": "みやびの元司書"},
        { "location": "458/SEL"   , "narrator": "", "text": "みやびの新司書"},
        { "location": "459/SEL"   , "narrator": "", "text": "冗談でした"},
        { "location": "460/ACT"   , "narrator": "", "text": "つばめの元司書"},
        { "location": "462/ACT"   , "narrator": "", "text": "つばめの新司書"},
        { "location": "464/ACT"   , "narrator": "", "text": "アーヤの元司書"},
        { "location": "466/ACT"   , "narrator": "", "text": "アーヤの新司書"},
        { "location": "468/ACT"   , "narrator": "", "text": "ガブリエラの司書"},
        { "location": "470/ACT"   , "narrator": "", "text": "みやびの元司書"},
        { "location": "472/ACT"   , "narrator": "", "text": "みやびの新司書"},
        { "location": "474/ACT"   , "narrator": "", "text": "冗談でした"},
        { "location": "477/TALK"  , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "478/ACT"   , "narrator": "", "text": "バトル出来なくなるの辛い"},
        { "location": "479/TALK"  , "narrator": "千羽鶴", "text": "それなら安心して。"},
        { "location": "480/TALK"  , "narrator": "千羽鶴", "text": "これからも要所要所で\n手伝ってもらうから。"},
        { "location": "481/ACT"   , "narrator": "", "text": "お話の核心が見られるから"},
        { "location": "482/TALK"  , "narrator": "千羽鶴", "text": "それなら安心して。"},
        { "location": "483/TALK"  , "narrator": "千羽鶴", "text": "私が毎回\n語ってあげるから。"},
        { "location": "484/ACT"   , "narrator": "", "text": "どっちかというと千羽鶴に任せるのが心配"},
        { "location": "485/TALK"  , "narrator": "千羽鶴", "text": "それって、私を\n信用できないってこと？"},
        { "location": "486/SEL"   , "narrator": "", "text": "イエス！"},
        { "location": "487/SEL"   , "narrator": "", "text": "そういうわけじゃないけど、"},
        { "location": "488/ACT"   , "narrator": "", "text": "イエス！"},
        { "location": "489/TALK"  , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "490/TALK"  , "narrator": "千羽鶴", "text": "それは残念。"},
        { "location": "491/ACT"   , "narrator": "", "text": "そういうわけじゃないけど、"},
        { "location": "492/TALK"  , "narrator": "千羽鶴", "text": "煮え切らない人。"},
        { "location": "497/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、\n貴方がどう思おうが\n状況はかわらない。"},
        { "location": "498/TALK"  , "narrator": "千羽鶴", "text": "今後貴方には、現実の\n彼女をめいっぱい\n支えてあげて欲しい。"},
        { "location": "499/TALK"  , "narrator": "千羽鶴", "text": "さて、そんな状況では\nあるのだけど――"},
        { "location": "500/TALK"  , "narrator": "千羽鶴", "text": "今回ばかりは\n貴方の力が必要だから\n協力して欲しい。"},
        { "location": "501/SEL"   , "narrator": "", "text": "あれ？$me$は必要ないのでは？"},
        { "location": "502/ACT"   , "narrator": "", "text": "あれ？$me$は必要ないのでは？"},
        { "location": "504/TALK"  , "narrator": "千羽鶴", "text": "今回だけは\nまだ不十分なところが\nあるから。"},
        { "location": "505/TALK"  , "narrator": "千羽鶴", "text": "前回の調整からあまり\n時間がなくて、完全な形\nでの対応ができなかった。"},
        { "location": "506/TALK"  , "narrator": "千羽鶴", "text": "次回からは全部\n私の手でやる。"},
        { "location": "508/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "509/SEL"   , "narrator": "", "text": "ガブリエラの司書は大丈夫なの！？"},
        { "location": "510/SEL"   , "narrator": "", "text": "どうして封印を解き放ったの！？"},
        { "location": "511/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "512/TALK"  , "narrator": "千羽鶴", "text": "よろしく。"},
        { "location": "513/ACT"   , "narrator": "", "text": "ガブリエラの司書は大丈夫なの！？"},
        { "location": "514/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、\n彼女はもう戻れない。"},
        { "location": "515/SEL"   , "narrator": "", "text": "どういうこと！？"},
        { "location": "516/ACT"   , "narrator": "", "text": "どういうこと！？"},
        { "location": "518/TALK"  , "narrator": "千羽鶴", "text": "彼女は1xにいた。\nけど、1xとの接続は\n先ほどをもって解除した。"},
        { "location": "519/TALK"  , "narrator": "千羽鶴", "text": "だから、彼女はここ――\nすなわち自らの世界には、\nもう戻ってこれない。"},
        { "location": "520/SEL"   , "narrator": "", "text": "わざとなの…？"},
        { "location": "521/ACT"   , "narrator": "", "text": "わざとなの…？"},
        { "location": "523/TALK"  , "narrator": "千羽鶴", "text": "計算ずくではある。"},
        { "location": "524/TALK"  , "narrator": "千羽鶴", "text": "今現在において、彼女は\n幸せな未来への道程に\nとって有益ではない。"},
        { "location": "525/SEL"   , "narrator": "", "text": "この前わざと、指示とは違うクランを倒させたから？"},
        { "location": "526/ACT"   , "narrator": "", "text": "この前わざと、指示とは違うクランを倒させたから？"},
        { "location": "528/TALK"  , "narrator": "千羽鶴", "text": "そうね。\nもとはといえば、\nそれが一番の発端。"},
        { "location": "529/TALK"  , "narrator": "千羽鶴", "text": "あの時発生した\nバタフライエフェクトで、\n転換を余儀なくされた。"},
        { "location": "530/TALK"  , "narrator": "千羽鶴", "text": "まあ、蝶が羽ばたいた\nことは、彼女だけが原因\nではないけど――"},
        { "location": "531/TALK"  , "narrator": "千羽鶴", "text": "最も重大な過ちを犯した\n一人であることには\n間違いない。"},
        { "location": "532/TALK"  , "narrator": "千羽鶴", "text": "もし彼女が発端でなければ\n司書解約だけの円満な\n結末だったとは思う。"},
        { "location": "533/TALK"  , "narrator": "千羽鶴", "text": "けど、彼女の存在は、\n先日の契約不履行からも\n分かる通り、害悪。"},
        { "location": "534/TALK"  , "narrator": "千羽鶴", "text": "だから、その点については\n理解して欲しい。"},
        { "location": "535/TALK"  , "narrator": "千羽鶴", "text": "さあ、それじゃ\nそろそろよろしく。"},
        { "location": "536/ACT"   , "narrator": "", "text": "どうして封印を解き放ったの！？"},
        { "location": "537/TALK"  , "narrator": "千羽鶴", "text": "彼女にとって\n必要なことだから。"},
        { "location": "538/SEL"   , "narrator": "", "text": "封印を解いたらココロが壊れておかしくなるってのは本当なの？"},
        { "location": "539/ACT"   , "narrator": "", "text": "封印を解いたらココロが壊れておかしくなるってのは本当なの？"},
        { "location": "541/TALK"  , "narrator": "千羽鶴", "text": "それは、\n彼女とあなた次第。"},
        { "location": "542/TALK"  , "narrator": "千羽鶴", "text": "何もしなければ、\n司書の言っていたとおり\nおかしくなる。"},
        { "location": "543/TALK"  , "narrator": "千羽鶴", "text": "貴方は唯一、\nそんな彼女を\n救うことができる。"},
        { "location": "544/TALK"  , "narrator": "千羽鶴", "text": "だから、\n救ってあげて欲しい。"},
        { "location": "545/SEL"   , "narrator": "", "text": "それって$me$が支えるの前提なの！？"},
        { "location": "546/ACT"   , "narrator": "", "text": "それって$me$が支えるの前提なの！？"},
        { "location": "548/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "549/TALK"  , "narrator": "千羽鶴", "text": "だってそれが、\n貴方の役割。\n最初からそう言ってる。"},
        { "location": "550/TALK"  , "narrator": "千羽鶴", "text": "さあ、それじゃ\nそろそろよろしく。"},
        { "location": "579/TALK"  , "narrator": "千羽鶴", "text": "貴方とこの世界に\n素敵なココロの旅を。"},
        { "location": "21/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月3日　 10:32 PM</color>\nとある休日の夜、都内某カフェにて"},
        { "location": "168/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "170/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "172/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "174/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "176/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
