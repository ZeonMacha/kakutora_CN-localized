    [
        { "location": "8/SCENARIO", "narrator": "", "text": "つばめの誕生日（復元）"},
        { "location": "20/TALK"   , "narrator": "つばめ", "text": "え！？\nなになに？"},
        { "location": "21/SEL"    , "narrator": "", "text": "お誕生日おめでとう！"},
        { "location": "22/ACT"    , "narrator": "", "text": "お誕生日おめでとう！"},
        { "location": "24/TALK"   , "narrator": "つばめ", "text": "ああっ、そっか！\n6月7日はわたしの……。"},
        { "location": "25/TALK"   , "narrator": "つばめ", "text": "ありがとう、$handle$\nさん。"},
        { "location": "26/SEL"    , "narrator": "", "text": "プレゼントあるよ"},
        { "location": "27/ACT"    , "narrator": "", "text": "プレゼントあるよ"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "えっ、ほんと？"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "わあっ！あけていいかな？"},
        { "location": "33/SEL"    , "narrator": "", "text": "もちろん！"},
        { "location": "34/ACT"    , "narrator": "", "text": "もちろん！"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "えへへ、なんだろう～。"},
        { "location": "45/DIALOG" , "narrator": "", "text": "つばめのコスチューム\n<size=40><color=red><b>メノウティー</b></color></size>\nをゲットしました！"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "わあっ！メノウちゃんの\nTシャツだぁっ！"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "これ、ライブ限定だった\nから、今はもう手に入ら\nないんだよね。"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "だから、すごい欲しかっ\nたんだけど諦めてたんだ。"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "すごく嬉しい！\n本当にありがとう！"},
        { "location": "57/DIALOG" , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "77/DIALOG" , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "えへへ。頭なでなでされ\nちゃった。"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "$handle$さんに誕生日\nお祝いしてもらえてホン\nトに嬉しいです。"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "これからも、ずっと一緒\nにいてね？"},
        { "location": "83/DIALOG" , "narrator": "", "text": "コスチューム\n<color=green>【メノウティー】</color>は、\n夜時間にパジャマとして\n着せることができます。"}
    ]
