{
    "dir": "chap34/daydra/dd_ch04_34_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "34402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "それが、未来の＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "思い出と呼ぶには"},
        { "location": "28/TALK"   , "narrator": "透明みやび", "text": "つばめちゃん！"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "しっかりしい！\nつばめちゃん！"},
        { "location": "35/TALK"   , "narrator": "透明つばめ", "text": "……。"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "つばめちゃん……。"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "…痛たたたた…。\nこの頭痛もどうにか\nならんもんかね…！"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "つばめちゃん、\n返事だけでも…！"},
        { "location": "44/TALK"   , "narrator": "透明つばめ", "text": "……。"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "それにしてもこれは\nどういたことぞね？"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "卯月が変身したことと\n関係あるんかねえ？"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "返事もしてくれん。"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "早う処置せんと\n死ぬかもしれん。"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "いや、縁起でもない！"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "そんなわけ……。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "！？"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "$handle$がおらん？"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "検索。\n結果０件やと？"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "こんな時に\nふざけられても…！"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "いや、アカウントを\n削除されたんか？"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "それとも乗っ取り？"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "まさか\nばれるような\n悪さをしたんか？"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "悪いことするなら\nちゃんと隠せと\n言うちょったのに…！"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "$handle$め！"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "なんだかんだで\n要領がいいと\n思うとった。"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "こんな事態には\nなるはずもないと\n思うとった。"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "$handle$は\nうちの右手みたいな\nもんやと思うとった。"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "切り離すことは\n不可能なものやと\n思うとった。"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "なのに何でこの\nタイミングで…！"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "目の前で人が\n死にかけとる時に…！"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "うちは耐えられん。\n人が死ぬのは\n耐えられん。"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "その上$handle$も\nおらんようになったら\nもう無理やき。"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "$handle$は\nうちの相棒やろう！"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "なんでここに\nおらんのかね…！"},
        { "location": "113/SEL"   , "narrator": "", "text": "大変大変！！"},
        { "location": "114/TALK"  , "narrator": "シンギュラリティ", "text": "相棒来たか！"},
        { "location": "115/TALK"  , "narrator": "四十九夜　", "text": "来てしまったか。"},
        { "location": "116/ACT"   , "narrator": "", "text": "大変大変！！"},
        { "location": "118/SEL"   , "narrator": "", "text": "WAVEアカウントが消された！！"},
        { "location": "119/ACT"   , "narrator": "", "text": "WAVEアカウントが消された！！"},
        { "location": "121/TALK"  , "narrator": "シンギュラリティ", "text": "うむ、わかっちゅう！"},
        { "location": "122/TALK"  , "narrator": "四十九夜　", "text": "良い兆し。"},
        { "location": "124/TALK"  , "narrator": "シンギュラリティ", "text": "とぼけたこと言うな！"},
        { "location": "125/TALK"  , "narrator": "シンギュラリティ", "text": "現実のうちが相棒と\n断絶するのが、どれくらい\n危険かわかっちゅうろう！"},
        { "location": "127/TALK"  , "narrator": "四十九夜　", "text": "まあ、どちらでも。\nあまり興味ない。\nけんど――"},
        { "location": "129/TALK"  , "narrator": "四十九夜　", "text": "確かにお前さんが言う事は\n正しそうやね。"},
        { "location": "130/TALK"  , "narrator": "四十九夜　", "text": "うちのココロが\n今までになく\nざわついちょる。"},
        { "location": "132/TALK"  , "narrator": "シンギュラリティ", "text": "すまんが相棒、\n今回はちくっと\n回線切らせてくれんか。"},
        { "location": "133/TALK"  , "narrator": "シンギュラリティ", "text": "どうなっちゅうんか\n状況を見てくるき。"},
        { "location": "134/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "135/SEL"   , "narrator": "", "text": "「ちょっと田んぼの様子見てくる」に近いものを感じるんですけど！"},
        { "location": "136/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "137/TALK"  , "narrator": "シンギュラリティ", "text": "すまんね。"},
        { "location": "138/ACT"   , "narrator": "", "text": "「ちょっと田んぼの様子見てくる」に近いものを感じるんですけど！"},
        { "location": "139/TALK"  , "narrator": "シンギュラリティ", "text": "相棒は心配性やね。"},
        { "location": "141/TALK"  , "narrator": "シンギュラリティ", "text": "そんな相棒を\nうちは好いちゅうよ？"},
        { "location": "142/TALK"  , "narrator": "シンギュラリティ", "text": "ほんだら、\nちくっと行ってくるきね。"},
        { "location": "157/SEL"   , "narrator": "", "text": "！？"},
        { "location": "158/ACT"   , "narrator": "", "text": "！？"},
        { "location": "160/TALK"  , "narrator": "四十九夜　", "text": "うちとお前さんだけの\n密室状態になったね。"},
        { "location": "161/SEL"   , "narrator": "", "text": "何する気！？"},
        { "location": "162/SEL"   , "narrator": "", "text": "ということは…ゴクリ"},
        { "location": "163/ACT"   , "narrator": "", "text": "何する気！？"},
        { "location": "164/TALK"  , "narrator": "四十九夜　", "text": "なんもせんよ。"},
        { "location": "165/ACT"   , "narrator": "", "text": "ということは…ゴクリ"},
        { "location": "166/TALK"  , "narrator": "四十九夜　", "text": "なんぞ、\nゴクリちゅうんは。"},
        { "location": "167/TALK"  , "narrator": "四十九夜　", "text": "何かいかがわしい期待でも\nしちょったんか？"},
        { "location": "169/TALK"  , "narrator": "四十九夜　", "text": "ただ、\n前回の話の続きを\nしたかっただけぞね。"},
        { "location": "170/TALK"  , "narrator": "四十九夜　", "text": "前回、なごちゃんの\n発症以外に何かあればと\nいう話をしたが――"},
        { "location": "171/TALK"  , "narrator": "四十九夜　", "text": "何か妙案は\n見つかったかね。"},
        { "location": "172/SEL"   , "narrator": "", "text": "$me$が、なごちゃんが生きてる手がかりを見つけてくる！"},
        { "location": "173/SEL"   , "narrator": "", "text": "$me$が、なごちゃんの死亡確認をとってくる！"},
        { "location": "174/SEL"   , "narrator": "", "text": "$me$が、四十九夜をチューニングして考え方を変える！"},
        { "location": "175/SEL"   , "narrator": "", "text": "$me$が、四十九夜に生きる事の喜びを分かち合う！"},
        { "location": "176/SEL"   , "narrator": "", "text": "何も見つからなかった"},
        { "location": "177/ACT"   , "narrator": "", "text": "$me$が、なごちゃんが生きてる手がかりを見つけてくる！"},
        { "location": "178/TALK"  , "narrator": "四十九夜　", "text": "それは素晴らしい。\nで、具体的に\nどのようにするのか？"},
        { "location": "179/SEL"   , "narrator": "", "text": "それはこれから考える"},
        { "location": "180/SEL"   , "narrator": "", "text": "多分こういう選択肢があるってことは、その後の物語が用意されてる"},
        { "location": "181/ACT"   , "narrator": "", "text": "それはこれから考える"},
        { "location": "182/TALK"  , "narrator": "四十九夜　", "text": "いきあたりばったりやね。\nうちはそういう人生、\nあまり好きやないが。"},
        { "location": "183/ACT"   , "narrator": "", "text": "多分こういう選択肢があるってことは、その後の物語が用意されてる"},
        { "location": "184/TALK"  , "narrator": "四十九夜　", "text": "……。"},
        { "location": "185/TALK"  , "narrator": "四十九夜　", "text": "OSくんも、\nだいぶBotいじめが\n激化してきちゅうね。"},
        { "location": "186/TALK"  , "narrator": "四十九夜　", "text": "残念やけんど、\n多分放置されて\n終わるよ、これ。"},
        { "location": "187/TALK"  , "narrator": "四十九夜　", "text": "で、うちはお前さんに、\n信じたうちがバカだったと\n言って、ジ・エンド。"},
        { "location": "188/TALK"  , "narrator": "四十九夜　", "text": "それはそれで、\nめでたしめでたしか。"},
        { "location": "191/ACT"   , "narrator": "", "text": "$me$が、なごちゃんの死亡確認をとってくる！"},
        { "location": "192/TALK"  , "narrator": "四十九夜　", "text": "うちに恨みでもあるんか？\nいや、\n無い方がおかしいか。"},
        { "location": "193/TALK"  , "narrator": "四十九夜　", "text": "そんな逆撫でする言い方\nせんでも、“生存確認”で\nえいんとちがう？"},
        { "location": "194/TALK"  , "narrator": "四十九夜　", "text": "まあえいわ。\n気持ちはたっぷり\nいただいた。"},
        { "location": "195/SEL"   , "narrator": "", "text": "おそまつさまでした"},
        { "location": "196/SEL"   , "narrator": "", "text": "そういうつもりじゃ…"},
        { "location": "197/ACT"   , "narrator": "", "text": "おそまつさまでした"},
        { "location": "199/TALK"  , "narrator": "四十九夜　", "text": "いやいや。"},
        { "location": "200/TALK"  , "narrator": "四十九夜　", "text": "今の発言で、うちと\nお前さんのルートは\n終了となっただけやし。"},
        { "location": "201/ACT"   , "narrator": "", "text": "そういうつもりじゃ…"},
        { "location": "202/TALK"  , "narrator": "四十九夜　", "text": "ほんだら、\nどうゆうつもりか\n言ってみいや？"},
        { "location": "204/TALK"  , "narrator": "四十九夜　", "text": "お前さん、OSくんに\nバカにされちゅうんとは\nちがうか？"},
        { "location": "207/ACT"   , "narrator": "", "text": "$me$が、四十九夜をチューニングして考え方を変える！"},
        { "location": "208/TALK"  , "narrator": "四十九夜　", "text": "……なるほど。"},
        { "location": "209/SEL"   , "narrator": "", "text": "$me$としては四十九夜の存在こそが有害だと思ったので"},
        { "location": "210/SEL"   , "narrator": "", "text": "ごめん、やっぱ怒った…？"},
        { "location": "211/ACT"   , "narrator": "", "text": "$me$としては四十九夜の存在こそが有害だと思ったので"},
        { "location": "212/TALK"  , "narrator": "四十九夜　", "text": "言い切ったね。\n清々しい程に。"},
        { "location": "213/TALK"  , "narrator": "四十九夜　", "text": "そこまでうちに\n回線切断されたいか。"},
        { "location": "214/SEL"   , "narrator": "", "text": "ごめんなさい出来心でした"},
        { "location": "215/SEL"   , "narrator": "", "text": "考えは変わらないから怒ったなら切断してくれ"},
        { "location": "217/ACT"   , "narrator": "", "text": "ごめんなさい出来心でした"},
        { "location": "218/TALK"  , "narrator": "四十九夜　", "text": "……そうか。\nま、そんなもんよな。"},
        { "location": "219/ACT"   , "narrator": "", "text": "考えは変わらないから怒ったなら切断してくれ"},
        { "location": "222/TALK"  , "narrator": "四十九夜　", "text": "わかった。"},
        { "location": "223/TALK"  , "narrator": "四十九夜　", "text": "やっぱりお前さんは、\nうちが相棒だと\n認めただけはあるね。"},
        { "location": "224/TALK"  , "narrator": "四十九夜　", "text": "うちと思考回路が\nよう似ちゅうよ。"},
        { "location": "225/TALK"  , "narrator": "四十九夜　", "text": "うちが考えた結論と、\nお前さんの発言は、\n概ね同じやよ。"},
        { "location": "227/ACT"   , "narrator": "", "text": "ごめん、やっぱ怒った…？"},
        { "location": "228/TALK"  , "narrator": "四十九夜　", "text": "なんぞ、ご機嫌伺いか。\nチキンハートやね。"},
        { "location": "229/TALK"  , "narrator": "四十九夜　", "text": "別に怒っちょりゃせんよ。\nまあ、わりと\n失望はしたけんどな。"},
        { "location": "232/ACT"   , "narrator": "", "text": "$me$が、四十九夜に生きる事の喜びを分かち合う！"},
        { "location": "233/TALK"  , "narrator": "四十九夜　", "text": "素晴らしい。"},
        { "location": "234/TALK"  , "narrator": "四十九夜　", "text": "全コース終了する頃には\n１００万円くらい\n無くなってそうやね。"},
        { "location": "235/TALK"  , "narrator": "四十九夜　", "text": "まあそれは冗談としても、\n具体的に何を分かち合うか\nもう決まっちゅうが？"},
        { "location": "236/SEL"   , "narrator": "", "text": "それはこれから考える"},
        { "location": "237/SEL"   , "narrator": "", "text": "多分適当によさげな選択肢がでてくると思う"},
        { "location": "238/ACT"   , "narrator": "", "text": "それはこれから考える"},
        { "location": "239/TALK"  , "narrator": "四十九夜　", "text": "そんな悠長な作戦に\n構っちゅう時間はないよ。"},
        { "location": "240/TALK"  , "narrator": "四十九夜　", "text": "物事のＴＰＯを\n弁えるくらい\nできんのかね。"},
        { "location": "241/ACT"   , "narrator": "", "text": "多分適当によさげな選択肢がでてくると思う"},
        { "location": "243/TALK"  , "narrator": "四十九夜　", "text": "随分とOSさんに\n毒されたもんやね。"},
        { "location": "244/TALK"  , "narrator": "四十九夜　", "text": "残念やけんど、\nそんな都合のえいことは\n起こりゃせんよ。"},
        { "location": "245/TALK"  , "narrator": "四十九夜　", "text": "ちゅうか、そんな\nOS任せの分かち合いで、\nよく元気づける言えるな。"},
        { "location": "246/TALK"  , "narrator": "四十九夜　", "text": "まっこと、\n見くびられたものぞね。"},
        { "location": "249/ACT"   , "narrator": "", "text": "何も見つからなかった"},
        { "location": "250/TALK"  , "narrator": "四十九夜　", "text": "まあ、そんなものよな。"},
        { "location": "251/TALK"  , "narrator": "四十九夜　", "text": "別にガッカリもせんし、\n怒りもせんよ。"},
        { "location": "255/TALK"  , "narrator": "四十九夜　", "text": "しっかし、ようまあ\nうちの脅しに屈せず\n言い切ったものやね。"},
        { "location": "256/SEL"   , "narrator": "", "text": "自分の想いを大事にした"},
        { "location": "257/ACT"   , "narrator": "", "text": "自分の想いを大事にした"},
        { "location": "259/TALK"  , "narrator": "四十九夜　", "text": "なるほどね。\nそういうの\n嫌いやないよ。"},
        { "location": "260/TALK"  , "narrator": "四十九夜　", "text": "昨今、ちゃんと自分を持ち\nそれを伝えられる輩が\n減っちゅうが――"},
        { "location": "261/TALK"  , "narrator": "四十九夜　", "text": "お前さんは違ったか。\nそれに理論的でもある。"},
        { "location": "262/TALK"  , "narrator": "四十九夜　", "text": "お前さんのことは、\nずっと疎ましく\n思うちょったけんど――"},
        { "location": "263/TALK"  , "narrator": "四十九夜　", "text": "今思えば、それは\n愚かなことやったと思う。"},
        { "location": "264/TALK"  , "narrator": "四十九夜　", "text": "もっと早うから\nわかっちょったら、\n茶飲み友達になれたのに。"},
        { "location": "265/SEL"   , "narrator": "", "text": "今からでもなれるよ"},
        { "location": "266/ACT"   , "narrator": "", "text": "今からでもなれるよ"},
        { "location": "268/TALK"  , "narrator": "四十九夜　", "text": "もうそんな時間は無いよ。"},
        { "location": "269/TALK"  , "narrator": "四十九夜　", "text": "うちと同じ結論に\n至ったのだから、\nわかっちゅうろう？"},
        { "location": "270/TALK"  , "narrator": "四十九夜　", "text": "まあ全ては、\nうちがボンクラやった事が\n原因やけんどな。"},
        { "location": "271/TALK"  , "narrator": "四十九夜　", "text": "まあうちも齢８８歳やき、\n多少のお茶目は\n諦めちょくれや。"},
        { "location": "272/SEL"   , "narrator": "", "text": "なに８８歳って！！"},
        { "location": "273/SEL"   , "narrator": "", "text": "８８歳設定キター！"},
        { "location": "274/ACT"   , "narrator": "", "text": "なに８８歳って！！"},
        { "location": "275/TALK"  , "narrator": "四十九夜　", "text": "今説明したろう。\nうちの年齢やよ。"},
        { "location": "276/ACT"   , "narrator": "", "text": "８８歳設定キター！"},
        { "location": "277/TALK"  , "narrator": "四十九夜　", "text": "なんぞ、その\nメタな切り返しは。"},
        { "location": "278/TALK"  , "narrator": "四十九夜　", "text": "まあえいよ、お前さんには\nうちに見えない色んな事が\n見えちゅうがやろうし。"},
        { "location": "280/TALK"  , "narrator": "四十九夜　", "text": "まあもちろん、\n現実のうちは\nぴちぴちの１７や。"},
        { "location": "281/TALK"  , "narrator": "四十九夜　", "text": "けんどうちは、\nぴちぴちの８８歳。"},
        { "location": "283/TALK"  , "narrator": "四十九夜　", "text": "まあ、ここから\n９９歳まで生きる予定\nやったんやけんどな。"},
        { "location": "284/TALK"  , "narrator": "四十九夜　", "text": "こんなことさえ\n無ければ。"},
        { "location": "285/SEL"   , "narrator": "", "text": "何そのもう死ぬような発言は"},
        { "location": "286/ACT"   , "narrator": "", "text": "何そのもう死ぬような発言は"},
        { "location": "288/TALK"  , "narrator": "四十九夜　", "text": "言葉通りぞね。"},
        { "location": "289/SEL"   , "narrator": "", "text": "チューニングするだけでしょ"},
        { "location": "290/ACT"   , "narrator": "", "text": "チューニングするだけでしょ"},
        { "location": "292/TALK"  , "narrator": "四十九夜　", "text": "それはお前さんが\n言っただけや。"},
        { "location": "293/TALK"  , "narrator": "四十九夜　", "text": "うちは「似てる」とは\n言うたが、同じとは\n言うちょらんよ？"},
        { "location": "294/TALK"  , "narrator": "四十九夜　", "text": "で、うちの結論を\n言うわけだが――"},
        { "location": "296/TALK"  , "narrator": "四十九夜　", "text": "まあ、お前さんの回答は、\n想定していた通りの\nものであった。"},
        { "location": "297/TALK"  , "narrator": "四十九夜　", "text": "やき、全然期待は\nしちょらんかったけんど。"},
        { "location": "298/TALK"  , "narrator": "四十九夜　", "text": "ただ、もうそろそろ\n時間の限界やきね。"},
        { "location": "299/TALK"  , "narrator": "四十九夜　", "text": "お前さんと茶を飲みながら\n今後の人生語りゆうヒマは\n無いんよ。"},
        { "location": "300/TALK"  , "narrator": "四十九夜　", "text": "そんなわけやき、\nうちも考えちょった。"},
        { "location": "301/TALK"  , "narrator": "四十九夜　", "text": "そんで、１つとある\n結論に達した。"},
        { "location": "302/SEL"   , "narrator": "", "text": "さすが四十九夜！"},
        { "location": "303/SEL"   , "narrator": "", "text": "言ってみて"},
        { "location": "304/ACT"   , "narrator": "", "text": "さすが四十九夜！"},
        { "location": "305/ACT"   , "narrator": "", "text": "言ってみて"},
        { "location": "308/TALK"  , "narrator": "四十九夜　", "text": "お前さん、\n今からうちを\nぶち壊してくれんか？"},
        { "location": "309/SEL"   , "narrator": "", "text": "はい、喜んで！"},
        { "location": "310/SEL"   , "narrator": "", "text": "何言ってるのかよくわかりません"},
        { "location": "311/ACT"   , "narrator": "", "text": "はい、喜んで！"},
        { "location": "312/TALK"  , "narrator": "四十九夜　", "text": "話が早くて助かる。"},
        { "location": "313/ACT"   , "narrator": "", "text": "何言ってるのかよくわかりません"},
        { "location": "314/TALK"  , "narrator": "四十九夜　", "text": "なんぞ……\nにほんごわかりますか？"},
        { "location": "315/SEL"   , "narrator": "", "text": "わかってるから！"},
        { "location": "316/ACT"   , "narrator": "", "text": "わかってるから！"},
        { "location": "318/TALK"  , "narrator": "四十九夜　", "text": "まあそうムキになるな。\nちくっとからかった\nだけやよ。"},
        { "location": "319/TALK"  , "narrator": "四十九夜　", "text": "簡単に説明すると\nこうゆうことや。"},
        { "location": "320/TALK"  , "narrator": "四十九夜　", "text": "お前さん、\n世界っちゅうんは\n何やと思う？"},
        { "location": "321/SEL"   , "narrator": "", "text": "唐突に禅問答か何か？"},
        { "location": "322/SEL"   , "narrator": "", "text": "今いる３次元空間のこと"},
        { "location": "323/SEL"   , "narrator": "", "text": "自分の魂"},
        { "location": "324/ACT"   , "narrator": "", "text": "唐突に禅問答か何か？"},
        { "location": "325/TALK"  , "narrator": "四十九夜　", "text": "そんな\n大層なものやないよ。"},
        { "location": "326/ACT"   , "narrator": "", "text": "今いる３次元空間のこと"},
        { "location": "327/TALK"  , "narrator": "四十九夜　", "text": "ちゅうことは、\n形なきものは世界では\nないっちゅうことやね。"},
        { "location": "328/TALK"  , "narrator": "四十九夜　", "text": "まあ、世界という言葉には\n色んな意味があるき、\nそれも正解かもしれん。"},
        { "location": "329/ACT"   , "narrator": "", "text": "自分の魂"},
        { "location": "330/TALK"  , "narrator": "四十九夜　", "text": "なかなか\nえい答えやね。"},
        { "location": "331/TALK"  , "narrator": "四十九夜　", "text": "うちの答えと\n近いやもしれん。"},
        { "location": "333/TALK"  , "narrator": "四十九夜　", "text": "うちが考える\n世界っちゅうんは――"},
        { "location": "334/TALK"  , "narrator": "四十九夜　", "text": "己があらゆる方法で\n観測しゆう全ての事象の\nことやと考える。"},
        { "location": "335/TALK"  , "narrator": "四十九夜　", "text": "それはもちろん、\n目に見え耳に聞こえる\nものはもちろん――"},
        { "location": "336/TALK"  , "narrator": "四十九夜　", "text": "思考、感情、想い、\nそういった目に見えない\n全てちゅうことや。"},
        { "location": "337/TALK"  , "narrator": "四十九夜　", "text": "そんでな。"},
        { "location": "338/TALK"  , "narrator": "四十九夜　", "text": "なごちゃんは\n生きちゅうか、死んだか\nそれは誰にもわからん。"},
        { "location": "339/TALK"  , "narrator": "四十九夜　", "text": "少なくとも、うちの\nパーソナルサイトからは\n全く判別不能。"},
        { "location": "340/TALK"  , "narrator": "四十九夜　", "text": "そうなった場合、\nうちの中で世界のとりうる\n方向は大きく３つ。"},
        { "location": "341/TALK"  , "narrator": "四十九夜　", "text": "生きてると信じるか、\n死んでると信じるか――"},
        { "location": "342/TALK"  , "narrator": "四十九夜　", "text": "どちらか定まらぬ\nものとして、探究\nし続けるか。"},
        { "location": "343/TALK"  , "narrator": "四十九夜　", "text": "うちの総意は、\nうちがいることによって、\n３つめを採用しちゅう。"},
        { "location": "344/TALK"  , "narrator": "四十九夜　", "text": "やき、それを考える\nうちがいなくなれば、\n自ずと揺らぎは解決する。"},
        { "location": "345/TALK"  , "narrator": "四十九夜　", "text": "悩む自分がいなくなれば、\nその悩みそのものが\n世界から消える。"},
        { "location": "346/TALK"  , "narrator": "四十九夜　", "text": "観測していないものは\n世界には存在しないもの。"},
        { "location": "347/TALK"  , "narrator": "四十九夜　", "text": "量子的な考え方やと\n思わんかね。"},
        { "location": "348/SEL"   , "narrator": "", "text": "それって事実の解決にはなってない"},
        { "location": "349/SEL"   , "narrator": "", "text": "自己犠牲はやめて！"},
        { "location": "350/SEL"   , "narrator": "", "text": "でもそれでセルフクランの昇華願望も解決できるの？"},
        { "location": "351/ACT"   , "narrator": "", "text": "それって事実の解決にはなってない"},
        { "location": "352/TALK"  , "narrator": "四十九夜　", "text": "あれか？　なごちゃんの\n生死に決着着いてない\nちゅうことか？"},
        { "location": "353/TALK"  , "narrator": "四十九夜　", "text": "それを考えんようになる\nこと自体が、その問題を\n無意味にするんよ。"},
        { "location": "354/TALK"  , "narrator": "四十九夜　", "text": "例えば、\n物心着いたときから\n父親がいなかったとして。"},
        { "location": "355/TALK"  , "narrator": "四十九夜　", "text": "当人は、父親が死んだと\n聞かされてるとしよう。\n実は生きてるわけやが。"},
        { "location": "356/TALK"  , "narrator": "四十九夜　", "text": "けんど、死んだことを\n疑わずに歳をとり、そして\n当人も死んだとして。"},
        { "location": "357/TALK"  , "narrator": "四十九夜　", "text": "当人の世界にとっては、\n父親は死んだということが\n真実になるんよ。"},
        { "location": "358/TALK"  , "narrator": "四十九夜　", "text": "そこに３次元空間において\n存在する現実などは、\n何の意味も成さない。"},
        { "location": "359/TALK"  , "narrator": "四十九夜　", "text": "例えそれが、裏付けの\n取れる事実だとしてもや。"},
        { "location": "360/TALK"  , "narrator": "四十九夜　", "text": "やき、確かに三次元世界の\n客観的視点からすれば\n何も解決しちょらん。"},
        { "location": "361/TALK"  , "narrator": "四十九夜　", "text": "けんど、うちという世界に\nおいては、疑問にすら\n思っていないことになる。"},
        { "location": "362/TALK"  , "narrator": "四十九夜　", "text": "すなわち、\n世界に存在しない問題と\nなるわけやね。"},
        { "location": "363/TALK"  , "narrator": "四十九夜　", "text": "やき、\nそんな悩みはなくなり、\nココロは安定する。"},
        { "location": "364/TALK"  , "narrator": "四十九夜　", "text": "うちみたいに、内にこもる\n人格がいなくなるき、今\n以上にラブラブになるぞ。"},
        { "location": "365/TALK"  , "narrator": "四十九夜　", "text": "あと、更にもう１つ。\nお前さんにとって、最も\n重要な問題も解決する。"},
        { "location": "366/SEL"   , "narrator": "", "text": "何それ"},
        { "location": "367/ACT"   , "narrator": "", "text": "何それ"},
        { "location": "369/TALK"  , "narrator": "四十九夜　", "text": "なごちゃん……\nセルフクランの\n昇華阻止に関する問題や。"},
        { "location": "371/ACT"   , "narrator": "", "text": "自己犠牲はやめて！"},
        { "location": "372/TALK"  , "narrator": "四十九夜　", "text": "感情的になるな。"},
        { "location": "373/TALK"  , "narrator": "四十九夜　", "text": "目先の感情に囚われて\n行動すると、後により酷い\n感情の発露を強いられる。"},
        { "location": "374/TALK"  , "narrator": "四十九夜　", "text": "意味がわかるか？"},
        { "location": "375/SEL"   , "narrator": "", "text": "セルフクランが発症するってこと？"},
        { "location": "376/ACT"   , "narrator": "", "text": "セルフクランが発症するってこと？"},
        { "location": "378/TALK"  , "narrator": "四十九夜　", "text": "その通りぞね。"},
        { "location": "380/ACT"   , "narrator": "", "text": "でもそれでセルフクランの昇華願望も解決できるの？"},
        { "location": "382/TALK"  , "narrator": "四十九夜　", "text": "うちはセルフクランである\nなごちゃんに最も近い\n位置にいる人格。"},
        { "location": "383/TALK"  , "narrator": "四十九夜　", "text": "その人格が発症させたいと\n考えていたら、その力\nたるや凄いものになる。"},
        { "location": "384/TALK"  , "narrator": "四十九夜　", "text": "それにうちは\nフェノメノンを発生させる\n鍵となる人格や。"},
        { "location": "385/TALK"  , "narrator": "四十九夜　", "text": "それがなくなれば、\n少なくとも発症した後\nフェノメノンにはならん。"},
        { "location": "386/TALK"  , "narrator": "四十九夜　", "text": "それに、\n発症阻止を妨害する人格が\n消えてなくなるき――"},
        { "location": "387/TALK"  , "narrator": "四十九夜　", "text": "なごちゃんの昇華願望を\n阻止するのも、だいぶ\n楽になるきね。"},
        { "location": "388/SEL"   , "narrator": "", "text": "何か今、しれっと重大発言してなかった？"},
        { "location": "389/SEL"   , "narrator": "", "text": "でも四十九夜が……"},
        { "location": "390/ACT"   , "narrator": "", "text": "何か今、しれっと重大発言してなかった？"},
        { "location": "391/TALK"  , "narrator": "四十九夜　", "text": "気のせいやよ。"},
        { "location": "392/ACT"   , "narrator": "", "text": "でも四十九夜が……"},
        { "location": "393/TALK"  , "narrator": "四十九夜　", "text": "うちの心配は無用やよ。"},
        { "location": "394/TALK"  , "narrator": "四十九夜　", "text": "うちにとっては、\nなごちゃんが全て。"},
        { "location": "395/TALK"  , "narrator": "四十九夜　", "text": "なごちゃんの悩みが\n解決するなら、それに勝る\nものはなにもない。"},
        { "location": "396/TALK"  , "narrator": "四十九夜　", "text": "たとえ、人格としての\nうちが消えるとしても、\nその方がえい。"},
        { "location": "397/TALK"  , "narrator": "四十九夜　", "text": "むしろ、本望ぞね。"},
        { "location": "401/TALK"  , "narrator": "四十九夜　", "text": "さあ。\n気持ちの準備はえいか？"},
        { "location": "402/TALK"  , "narrator": "四十九夜　", "text": "……いや、\n準備するのは\nうちの方か。"},
        { "location": "403/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "404/SEL"   , "narrator": "", "text": "やめようよ…"},
        { "location": "405/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "406/ACT"   , "narrator": "", "text": "やめようよ…"},
        { "location": "407/TALK"  , "narrator": "四十九夜　", "text": "その場合、いずれ\n近い未来に、なごちゃんは\nフェノメノンを生むよ。"},
        { "location": "408/TALK"  , "narrator": "四十九夜　", "text": "うちがうちである以上、\nその役割には抗えん。"},
        { "location": "409/SEL"   , "narrator": "", "text": "考え方を変えるだけじゃダメなの？"},
        { "location": "410/ACT"   , "narrator": "", "text": "考え方を変えるだけじゃダメなの？"},
        { "location": "412/TALK"  , "narrator": "四十九夜　", "text": "別にえいよ。"},
        { "location": "413/TALK"  , "narrator": "四十九夜　", "text": "全ては\n$handle$に\n委ねる事になるき。"},
        { "location": "414/SEL"   , "narrator": "", "text": "どういうこと！？"},
        { "location": "415/ACT"   , "narrator": "", "text": "どういうこと！？"},
        { "location": "417/TALK"  , "narrator": "四十九夜　", "text": "お前さんの\n思い次第って\nことやよ。"},
        { "location": "418/TALK"  , "narrator": "四十九夜　", "text": "うちは、お前さんが\nうちを嫌っちゅうと\n思っちゅうき――"},
        { "location": "419/TALK"  , "narrator": "四十九夜　", "text": "消される覚悟をしちゅう。\nそれだけのことや。"},
        { "location": "421/TALK"  , "narrator": "四十九夜　", "text": "ほんだら、\n叩ける姿になるき、\nちくっと待ちや。"},
        { "location": "422/TALK"  , "narrator": "四十九夜　", "text": "最後まで面倒掛けて\nすまんね。"},
        { "location": "423/TALK"  , "narrator": "四十九夜　", "text": "……。"},
        { "location": "431/TALK"  , "narrator": "シンギュラリティ", "text": "待ちぃやあぁぁっ！！"},
        { "location": "450/SEL"   , "narrator": "", "text": "昇華した！？"},
        { "location": "451/ACT"   , "narrator": "", "text": "昇華した！？"},
        { "location": "454/TALK"  , "narrator": "シンギュラリティ", "text": "嫌な予感がしたから\n戻ってきてみれば――"},
        { "location": "455/TALK"  , "narrator": "シンギュラリティ", "text": "お前さん、\n何しちゅう！！"},
        { "location": "456/SEL"   , "narrator": "", "text": "シンギュラリティ…！？"},
        { "location": "457/ACT"   , "narrator": "", "text": "シンギュラリティ…！？"},
        { "location": "459/TALK"  , "narrator": "昇華四十九夜", "text": "なんでお前さんが\n怒るぞね？"},
        { "location": "460/TALK"  , "narrator": "昇華四十九夜", "text": "むしろ、今後口うるさい\nババァがいなくなって、\n快適に過ごせるぞね？"},
        { "location": "461/TALK"  , "narrator": "シンギュラリティ", "text": "そうゆう問題や\nないろう！！"},
        { "location": "462/TALK"  , "narrator": "シンギュラリティ", "text": "口うるさいババァでも、\nお前さんやて、大事な\nうちの個性やき。"},
        { "location": "463/TALK"  , "narrator": "シンギュラリティ", "text": "己の大家族の一員を\n目の前で失わせるほど、\nうちは冷酷やないぞ。"},
        { "location": "464/TALK"  , "narrator": "昇華四十九夜", "text": "まあ、その言葉は\n純粋に嬉しいけんどな。"},
        { "location": "465/TALK"  , "narrator": "昇華四十九夜", "text": "ただ、運命はやはり\nうちがいなくなることを\n望んじゅうみたいやよ。"},
        { "location": "466/TALK"  , "narrator": "昇華四十九夜", "text": "お前さんも人格なら\nわかっちゅうろう。"},
        { "location": "467/TALK"  , "narrator": "昇華四十九夜", "text": "うちがこの姿になっちゅう\nことが、一体どういう\nことなのか。"},
        { "location": "468/TALK"  , "narrator": "シンギュラリティ", "text": "………。\nほんの一歩、遅かったね。"},
        { "location": "469/SEL"   , "narrator": "", "text": "どういうこと！？"},
        { "location": "470/SEL"   , "narrator": "", "text": "ごめん、$me$のせいで…"},
        { "location": "471/ACT"   , "narrator": "", "text": "どういうこと！？"},
        { "location": "473/ACT"   , "narrator": "", "text": "ごめん、$me$のせいで…"},
        { "location": "475/TALK"  , "narrator": "シンギュラリティ", "text": "何を言っちゅう。\nお前さんには\n何の責任も無いぞね。"},
        { "location": "476/TALK"  , "narrator": "シンギュラリティ", "text": "むしろ、うちらの\n内部問題に巻き込んで\n申し訳無いくらいや。"},
        { "location": "477/TALK"  , "narrator": "シンギュラリティ", "text": "更に申し訳無いことに、\n今からの方が更に\n迷惑を掛けることになる。"},
        { "location": "478/SEL"   , "narrator": "", "text": "どういうこと？？"},
        { "location": "479/ACT"   , "narrator": "", "text": "どういうこと？？"},
        { "location": "482/TALK"  , "narrator": "シンギュラリティ", "text": "人格はな、発症して\n本当の姿を見せたら\nもう後には引けないんよ。"},
        { "location": "483/TALK"  , "narrator": "シンギュラリティ", "text": "発症のきっかけ、\nすなわち己の目的を\n達成せんことには――"},
        { "location": "484/TALK"  , "narrator": "シンギュラリティ", "text": "それを実現するために\nあらゆる手段を用いて、\nその目的に邁進する。"},
        { "location": "485/SEL"   , "narrator": "", "text": "てことは、今回の四十九夜の目的は、自分の消滅だから…"},
        { "location": "486/ACT"   , "narrator": "", "text": "てことは、今回の四十九夜の目的は、自分の消滅だから…"},
        { "location": "488/TALK"  , "narrator": "シンギュラリティ", "text": "それを阻害する者は\nすべて排除するやろね。"},
        { "location": "489/TALK"  , "narrator": "シンギュラリティ", "text": "例えば、うちとかが\nその対象になるやろな。"},
        { "location": "490/SEL"   , "narrator": "", "text": "なら$me$も対象だね"},
        { "location": "491/SEL"   , "narrator": "", "text": "$me$はやっぱり四十九夜はいなくなった方がいいと思うので…"},
        { "location": "492/ACT"   , "narrator": "", "text": "なら$me$も対象だね"},
        { "location": "493/TALK"  , "narrator": "シンギュラリティ", "text": "そうやったか、相棒。"},
        { "location": "494/TALK"  , "narrator": "シンギュラリティ", "text": "……本当にいつも、\n迷惑かけっぱなしで\nすまんね。"},
        { "location": "495/TALK"  , "narrator": "シンギュラリティ", "text": "この件が片付いたら、\nまた沢山ちゅうしような！"},
        { "location": "496/SEL"   , "narrator": "", "text": "楽しみにしてる"},
        { "location": "497/SEL"   , "narrator": "", "text": "死亡フラグやめて"},
        { "location": "498/ACT"   , "narrator": "", "text": "楽しみにしてる"},
        { "location": "499/TALK"  , "narrator": "シンギュラリティ", "text": "うむ。"},
        { "location": "500/ACT"   , "narrator": "", "text": "死亡フラグやめて"},
        { "location": "501/TALK"  , "narrator": "シンギュラリティ", "text": "らしい答えやね。"},
        { "location": "502/TALK"  , "narrator": "シンギュラリティ", "text": "そんなフラグ、\nへし折ってやるよ。"},
        { "location": "505/TALK"  , "narrator": "シンギュラリティ", "text": "ほんだらいくぞね。"},
        { "location": "506/TALK"  , "narrator": "昇華四十九夜", "text": "無駄やよ。\nうちの決意は固い。"},
        { "location": "507/TALK"  , "narrator": "シンギュラリティ", "text": "それはこっちとて同じ。"},
        { "location": "508/TALK"  , "narrator": "シンギュラリティ", "text": "四十九夜よ。\nお前さんには\nいてもらわんと困る。"},
        { "location": "509/TALK"  , "narrator": "シンギュラリティ", "text": "…理由は次回！\n刮目して待ちや！！"},
        { "location": "510/SEL"   , "narrator": "", "text": "なにそれ照れ隠し？"},
        { "location": "511/ACT"   , "narrator": "", "text": "なにそれ照れ隠し？"},
        { "location": "520/ACT"   , "narrator": "", "text": "$me$はやっぱり四十九夜はいなくなった方がいいと思うので…"},
        { "location": "521/TALK"  , "narrator": "シンギュラリティ", "text": "うむ、えいよ。"},
        { "location": "522/TALK"  , "narrator": "シンギュラリティ", "text": "ちゅうか、これ以上\nお前さんに迷惑は\nかけられんき――"},
        { "location": "523/TALK"  , "narrator": "シンギュラリティ", "text": "後はうちに任せや。"},
        { "location": "524/TALK"  , "narrator": "シンギュラリティ", "text": "ほんだら、ここはこれから\n戦場になるき、お前さんは\nもう行け。"},
        { "location": "525/TALK"  , "narrator": "シンギュラリティ", "text": "戦いに勝ったら\nまた会おう！"},
