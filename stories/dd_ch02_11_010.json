        "title": "Extra002 プレミアムストーリー",
        "sub_title": "待ち受け"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "待ち受け"},
        { "location": "23/TALK"   , "narrator": "みやび", "text": "へぇ、つばめちゃんは\nやっぱりそれなんやね。"},
        { "location": "25/TALK"   , "narrator": "つばめ", "text": "はい！　メノウちゃんは\nわたしにとっての神様\nみたいな人ですから。"},
        { "location": "27/TALK"   , "narrator": "神楽", "text": "そ、それはちょっと、\n大袈裟のような…。"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "もっと一般受けするのに\nすればいいのに。"},
        { "location": "30/TALK"   , "narrator": "みやび", "text": "ガブちゃん、人のこと\n言えんき。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "何だか盛り上がってる\nみたいだけど、\n何を話してるの？"},
        { "location": "34/TALK"   , "narrator": "神楽", "text": "スマホの待ち受け画面を\n何にしているのか、\n見せ合ってたんです。"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "うちのはカプドラの\n期間限定配布された\n壁紙や。"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "わたしは、メノウちゃんの\n写真を画像にしてます。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "あたしは東京タワーを\n真下から撮った写真よ。"},
        { "location": "41/TALK"   , "narrator": "神楽", "text": "それで私が、大好きな\nラノベのキャラ絵です。"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "それ、二次絵じゃない。\n何で公式絵にしないの？"},
        { "location": "47/TALK"   , "narrator": "神楽", "text": "私はこの絵描きさんの\n絵が一番好きなんです。"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "いけない！\nこの話の流れだと…。"},
        { "location": "50/TALK"   , "narrator": "神楽", "text": "アーヤさんは何の壁紙に\nしてるんですか？"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "えっ！？\nえ、えっと…。"},
        { "location": "56/SEL"    , "narrator": "", "text": "端末壁紙変更：初期状態"},
        { "location": "57/SEL"    , "narrator": "", "text": "端末壁紙変更：アイドル"},
        { "location": "58/SEL"    , "narrator": "", "text": "端末壁紙変更：満月"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "どうしよう…今の壁紙を\n見られるのはマズイわ。"},
        { "location": "62/TALK"   , "narrator": "神楽", "text": "アーヤさん？"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "別に隠す必要ないでしょ？"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "か、隠してなんかないわ！\nただ、こういうのって\nちょっと恥ずかしくて…。"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "イヤらしい壁紙にでも\nしてるが？"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "そんなわけないでしょ！"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "なら、すっと出して\n見せるちや。"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "…こ、こうなったら！"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "んっ？"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "ちょ、なに！？\nいきなり写真撮って…。"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "ごめん、急にいいことを\n思いついちゃったの。"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "みんなが楽しそうに\n話し合ってる写真を、\n壁紙にさせてもらうわ。"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "…上手く逃げたわね。"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "なるほど、そういう\n逃げ方もあるんか…\n勉強になったがよ。"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "に、逃げてない！\n別に逃げたわけじゃ\nないわ。"},
        { "location": "89/TALK"   , "narrator": "神楽", "text": "アーヤさん、一体どんな\n待ち受けにしていたん\nでしょうか？"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "う～ん…ちょっとだけ\n気になるよね。"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "ただの風景写真よ。\n気にするほどでも\nないってば。"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "…見せたくない壁紙を\n使ってたって、\nバレバレよね。"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "でも――"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "みんなが写った写真って、\nまだ一枚も持ってなかった\nのよね。"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "ふふっ、偶然とはいえ、\n良い記念写真が\n手に入ったわ。"},
        { "location": "99/ACT"    , "narrator": "", "text": "端末壁紙変更：初期状態"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "…さすがにこれ以上\n隠すのは無理かも。"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "もういいわ！\n覚悟決めてやる！"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "わ、私のは、これよ！"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "…あれ？\nこの壁紙って確か…。"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "初期設定の壁紙じゃない。\nアーヤって壁紙変えない\nタイプなの？"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "…えっ？"},
        { "location": "116/TALK"  , "narrator": "神楽", "text": "バイクの写真にしてると\n思ったんだけどなぁ…。"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "あんま壁紙とか気にせん\nタイプなんやね。\n初めて知ったがよ。"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "え、ええ…まあね。"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "それよりガブちゃん。\nその東京タワーの写真、\n送ってもらえん？"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "いいわよ。\nあたしもカプドラの\n壁紙欲しかったし。"},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "あ、わたしも送って\n欲しいです！"},
        { "location": "131/TALK"  , "narrator": "アーヤ", "text": "まさか、これって…。"},
        { "location": "136/TALK"  , "narrator": "アーヤ", "text": "もしかして、壁紙変えてくれたの？"},
        { "location": "138/SEL"   , "narrator": "", "text": "変えられたみたい"},
        { "location": "139/ACT"   , "narrator": "", "text": "変えられたみたい"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "やっぱり！"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "気が利くわね(≧∇≦)b"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "これからは、見られて良い写真を壁紙に使うようにするわ"},
        { "location": "146/SEL"   , "narrator": "", "text": "何の壁紙だったの？"},
        { "location": "147/ACT"   , "narrator": "", "text": "何の壁紙だったの？"},
        { "location": "149/TALK"  , "narrator": "アーヤ", "text": "( *´艸`)"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "今は秘密よ"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "いつかは話すわ"},
        { "location": "163/ACT"   , "narrator": "", "text": "端末壁紙変更：アイドル"},
        { "location": "165/TALK"  , "narrator": "アーヤ", "text": "…さすがにこれ以上\n隠すのは無理かも。"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "もういいわ！\n覚悟決めてやる！"},
        { "location": "172/TALK"  , "narrator": "アーヤ", "text": "わ、私のは、これよ！"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "は、はぁ！？"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "この人達って確か、\nアイドルグループの\n『ジェネシス』ですよね？"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "…え？"},
        { "location": "182/TALK"  , "narrator": "みやび", "text": "こ、これはビックリした\nがよ。"},
        { "location": "183/TALK"  , "narrator": "みやび", "text": "まさかアーヤが、\n男性アイドルグループの\n壁紙を使っちゅうとは…。"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "え、えぇっ！？\nうそっ、なんで！？"},
        { "location": "188/TALK"  , "narrator": "神楽", "text": "アーヤさんがアイドルの\nファンだったなんて、\n初めて知りました。"},
        { "location": "191/TALK"  , "narrator": "みやび", "text": "それよりガブちゃん。\nその東京タワーの写真、\n送ってもらえん？"},
        { "location": "194/TALK"  , "narrator": "ガブリエラ", "text": "いいわよ。\nあたしもカプドラの\n壁紙欲しかったし。"},
        { "location": "197/TALK"  , "narrator": "つばめ", "text": "あ、わたしも送って\n欲しいです！"},
        { "location": "199/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "204/TALK"  , "narrator": "アーヤ", "text": "壁紙変えたのあなたでしょ！？"},
        { "location": "207/SEL"   , "narrator": "", "text": "困ってると思って"},
        { "location": "208/ACT"   , "narrator": "", "text": "困ってると思って"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "気持ちは嬉しいけど"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "もう少しマシな写真にしてくれればよかったのに"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "絶対みんな、私がアイドル好きって思っちゃってる(-ω-;)"},
        { "location": "214/SEL"   , "narrator": "", "text": "ごめん"},
        { "location": "215/ACT"   , "narrator": "", "text": "ごめん"},
        { "location": "217/TALK"  , "narrator": "アーヤ", "text": "…ううん、いいの"},
        { "location": "218/TALK"  , "narrator": "アーヤ", "text": "助けてくれたのはわかってるから"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "221/TALK"  , "narrator": "アーヤ", "text": "今度はせめて初期状態のに変えてほしいわ(TωT)"},
        { "location": "232/ACT"   , "narrator": "", "text": "端末壁紙変更：満月"},
        { "location": "233/TALK"  , "narrator": "アーヤ", "text": "…さすがにこれ以上\n隠すのは無理かも。"},
        { "location": "234/TALK"  , "narrator": "アーヤ", "text": "もういいわ！\n覚悟決めてやる！"},
        { "location": "240/TALK"  , "narrator": "アーヤ", "text": "わ、私のは、これよ！"},
        { "location": "241/TALK"  , "narrator": "みやび", "text": "…さすがはアーヤやね。\n待ち受け画面も\nオシャレさんや。"},
        { "location": "242/TALK"  , "narrator": "神楽", "text": "わぁ…綺麗な満月の\n写真ですね。"},
        { "location": "245/TALK"  , "narrator": "アーヤ", "text": "えっ、満月？"},
        { "location": "247/TALK"  , "narrator": "つばめ", "text": "こんなに大きくて綺麗な\n満月の写真、見たこと\nないです！"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "本当、綺麗ね…。\nその写真、ＷＡＶＥで\n送ってもらえる？"},
        { "location": "251/TALK"  , "narrator": "アーヤ", "text": "え、ええ、いいわよ。"},
        { "location": "253/TALK"  , "narrator": "みやび", "text": "なら、うちはガブちゃんの\n写真を送ってもらうちや。"},
        { "location": "259/TALK"  , "narrator": "つばめ", "text": "わたしもお願いします。"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "壁紙変えてくれたの、あなたでしょ？"},
        { "location": "269/SEL"   , "narrator": "", "text": "余計なことしたかな？"},
        { "location": "270/ACT"   , "narrator": "", "text": "余計なことしたかな？"},
        { "location": "272/TALK"  , "narrator": "アーヤ", "text": "ううん"},
        { "location": "274/TALK"  , "narrator": "アーヤ", "text": "ナイスサポート(≧∇≦)b"},
        { "location": "275/TALK"  , "narrator": "アーヤ", "text": "っていうか、壁紙変えれたんだ？"},
        { "location": "277/SEL"   , "narrator": "", "text": "出来るみたい"},
        { "location": "278/ACT"   , "narrator": "", "text": "出来るみたい"},
        { "location": "280/TALK"  , "narrator": "アーヤ", "text": "それじゃあ"},
        { "location": "281/TALK"  , "narrator": "アーヤ", "text": "また今日みたいなことがあった時は頼りにしてるわ"},
        { "location": "20/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月19日　1:18 PM</color>\nとある休日、神楽坂近くの公園にて。"}
    ]
}
