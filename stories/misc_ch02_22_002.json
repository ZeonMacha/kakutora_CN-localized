    [
        { "location": "87/SCENARIO", "narrator": "", "text": "わかっていたのかも"},
        { "location": "114/TALK"   , "narrator": "アーヤ", "text": "本当は全部"},
        { "location": "115/TALK"   , "narrator": "アーヤ", "text": "気が付いていたの"},
        { "location": "117/SEL"    , "narrator": "", "text": "何に？"},
        { "location": "118/SEL"    , "narrator": "", "text": "買い被りかなー"},
        { "location": "119/SEL"    , "narrator": "", "text": "$me$がアーヤを好きなことも？"},
        { "location": "120/ACT"    , "narrator": "", "text": "何に？"},
        { "location": "121/TALK"   , "narrator": "アーヤ", "text": "聞いてくれる？"},
        { "location": "122/ACT"    , "narrator": "", "text": "買い被りかなー"},
        { "location": "123/TALK"   , "narrator": "アーヤ", "text": "またもう"},
        { "location": "125/TALK"   , "narrator": "アーヤ", "text": "そんな言い方"},
        { "location": "126/ACT"    , "narrator": "", "text": "$me$がアーヤを好きなことも？"},
        { "location": "128/TALK"   , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "129/TALK"   , "narrator": "アーヤ", "text": "そんなことは"},
        { "location": "130/TALK"   , "narrator": "アーヤ", "text": "知っているわよ？"},
        { "location": "132/TALK"   , "narrator": "アーヤ", "text": "ある子が隠し事をしていたこと"},
        { "location": "134/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "135/TALK"   , "narrator": "アーヤ", "text": "それは"},
        { "location": "136/TALK"   , "narrator": "アーヤ", "text": "本当に"},
        { "location": "137/TALK"   , "narrator": "アーヤ", "text": "どうしようもなかった"},
        { "location": "138/TALK"   , "narrator": "アーヤ", "text": "ことかもしれないわ"},
        { "location": "140/SEL"    , "narrator": "", "text": "同情してるの？"},
        { "location": "141/SEL"    , "narrator": "", "text": "アーヤにも隠し事はあるでしょ"},
        { "location": "142/ACT"    , "narrator": "", "text": "同情してるの？"},
        { "location": "144/TALK"   , "narrator": "アーヤ", "text": "どうしてって考えることは"},
        { "location": "146/TALK"   , "narrator": "アーヤ", "text": "結局"},
        { "location": "147/TALK"   , "narrator": "アーヤ", "text": "同情なのかしら？"},
        { "location": "148/ACT"    , "narrator": "", "text": "アーヤにも隠し事はあるでしょ"},
        { "location": "149/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "150/TALK"   , "narrator": "アーヤ", "text": "あるわよ"},
        { "location": "151/TALK"   , "narrator": "アーヤ", "text": "あるに決まってる"},
        { "location": "153/TALK"   , "narrator": "アーヤ", "text": "わかってたって"},
        { "location": "154/TALK"   , "narrator": "アーヤ", "text": "思いたいだけなのかもしれないわ"},
        { "location": "155/TALK"   , "narrator": "アーヤ", "text": "私は結局ね"}
    ]
