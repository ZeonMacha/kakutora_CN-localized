{
    "dir": "chap34/daydra/dd_ch04_34_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "34405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "それが、未来の＜後編＞"
    },
    "entry":
    [
        { "location": "539/SCENARIO", "narrator": "", "text": "それが、未来の"},
        { "location": "554/TALK"    , "narrator": "みやび", "text": "…つばめちゃん…。"},
        { "location": "558/SEL"     , "narrator": "", "text": "$handle$参上"},
        { "location": "559/ACT"     , "narrator": "", "text": "$handle$参上"},
        { "location": "562/TALK"    , "narrator": "みやび", "text": "はっ！？"},
        { "location": "576/TALK"    , "narrator": "みやび", "text": "ふざけるな"},
        { "location": "577/TALK"    , "narrator": "みやび", "text": "主役気取りか"},
        { "location": "578/TALK"    , "narrator": "みやび", "text": "$handle$め"},
        { "location": "580/SEL"     , "narrator": "", "text": "何それ川柳？"},
        { "location": "581/SEL"     , "narrator": "", "text": "ごめん遅くなって"},
        { "location": "582/SEL"     , "narrator": "", "text": "$me$もあせったよ"},
        { "location": "583/ACT"     , "narrator": "", "text": "何それ川柳？"},
        { "location": "584/TALK"    , "narrator": "みやび", "text": "違うわ"},
        { "location": "585/TALK"    , "narrator": "みやび", "text": "ばかちんが"},
        { "location": "586/ACT"     , "narrator": "", "text": "ごめん遅くなって"},
        { "location": "587/TALK"    , "narrator": "みやび", "text": "遅すぎぞね"},
        { "location": "588/TALK"    , "narrator": "みやび", "text": "亀の呪いがかかったレベル"},
        { "location": "589/ACT"     , "narrator": "", "text": "$me$もあせったよ"},
        { "location": "590/TALK"    , "narrator": "みやび", "text": "一番焦ったのは"},
        { "location": "592/TALK"    , "narrator": "みやび", "text": "うちぞね"},
        { "location": "594/TALK"    , "narrator": "みやび", "text": "なごちゃんの話を"},
        { "location": "595/TALK"    , "narrator": "みやび", "text": "したばかりであろう"},
        { "location": "596/TALK"    , "narrator": "みやび", "text": "なごちゃんは"},
        { "location": "597/TALK"    , "narrator": "みやび", "text": "うちの目の前ではなかった"},
        { "location": "598/TALK"    , "narrator": "みやび", "text": "けんど"},
        { "location": "599/TALK"    , "narrator": "みやび", "text": "つばめちゃんは"},
        { "location": "600/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "601/TALK"    , "narrator": "みやび", "text": "そうではない"},
        { "location": "602/TALK"    , "narrator": "みやび", "text": "$handle$の話だ"},
        { "location": "603/TALK"    , "narrator": "みやび", "text": "$handle$は地べたに正座の刑"},
        { "location": "604/TALK"    , "narrator": "みやび", "text": "うちの説教を受けよ"},
        { "location": "606/SEL"     , "narrator": "", "text": "ごめんってば"},
        { "location": "607/SEL"     , "narrator": "", "text": "その元気があれば大丈夫"},
        { "location": "608/SEL"     , "narrator": "", "text": "わかりにくい甘え方だなー"},
        { "location": "609/ACT"     , "narrator": "", "text": "ごめんってば"},
        { "location": "610/TALK"    , "narrator": "みやび", "text": "許さん"},
        { "location": "611/ACT"     , "narrator": "", "text": "その元気があれば大丈夫"},
        { "location": "612/TALK"    , "narrator": "みやび", "text": "それはある"},
        { "location": "613/ACT"     , "narrator": "", "text": "わかりにくい甘え方だなー"},
        { "location": "614/TALK"    , "narrator": "みやび", "text": "デレさせろ"},
        { "location": "616/TALK"    , "narrator": "みやび", "text": "それとあれだ"},
        { "location": "617/TALK"    , "narrator": "みやび", "text": "今回の件を鑑み"},
        { "location": "618/TALK"    , "narrator": "みやび", "text": "うちは$handle$専用ツールを開発する"},
        { "location": "619/TALK"    , "narrator": "みやび", "text": "うち以外の何人たりとも"},
        { "location": "620/TALK"    , "narrator": "みやび", "text": "$handle$のアカウントをクラックできんようにする"},
        { "location": "621/TALK"    , "narrator": "みやび", "text": "うちの全精力をかけて"},
        { "location": "623/SEL"     , "narrator": "", "text": "ええと…ありがとう？"},
        { "location": "624/SEL"     , "narrator": "", "text": "さすがスーパーハッカ―"},
        { "location": "625/SEL"     , "narrator": "", "text": "$me$は既にみやびの配下"},
        { "location": "626/ACT"     , "narrator": "", "text": "ええと…ありがとう？"},
        { "location": "627/TALK"    , "narrator": "みやび", "text": "礼には及ばん"},
        { "location": "628/TALK"    , "narrator": "みやび", "text": "というか"},
        { "location": "629/TALK"    , "narrator": "みやび", "text": "いややっぱり"},
        { "location": "630/TALK"    , "narrator": "みやび", "text": "それでよい"},
        { "location": "631/ACT"     , "narrator": "", "text": "さすがスーパーハッカ―"},
        { "location": "632/TALK"    , "narrator": "みやび", "text": "当然だ"},
        { "location": "633/TALK"    , "narrator": "みやび", "text": "と言うとでも思ったか"},
        { "location": "634/TALK"    , "narrator": "みやび", "text": "環境は常にアップデートされる"},
        { "location": "635/TALK"    , "narrator": "みやび", "text": "一筋縄ではいかぬ"},
        { "location": "636/ACT"     , "narrator": "", "text": "$me$は既にみやびの配下"},
        { "location": "637/TALK"    , "narrator": "みやび", "text": "そういう説はある"},
        { "location": "638/TALK"    , "narrator": "みやび", "text": "しかしこれは"},
        { "location": "639/TALK"    , "narrator": "みやび", "text": "外部からのアタックの話"},
        { "location": "640/TALK"    , "narrator": "みやび", "text": "対策が必要"},
        { "location": "642/TALK"    , "narrator": "みやび", "text": "以上のことは"},
        { "location": "643/TALK"    , "narrator": "みやび", "text": "こちらの件が解決してからのこと"},
        { "location": "644/TALK"    , "narrator": "みやび", "text": "今はつばめちゃんを救いたい"},
        { "location": "645/TALK"    , "narrator": "みやび", "text": "全力で手伝え"},
        { "location": "657/TALK"    , "narrator": "みやび", "text": "もうあんな気持ちには\nなりとうない。"},
        { "location": "658/TALK"    , "narrator": "みやび", "text": "なごちゃんの時の\nあの気持ちはもう\n味わいとうない。"},
        { "location": "659/TALK"    , "narrator": "みやび", "text": "手術が成功したか\nどうかもわからんまま\n会えなくなるのは。"},
        { "location": "660/TALK"    , "narrator": "みやび", "text": "あ…？"},
        { "location": "661/TALK"    , "narrator": "みやび", "text": "…うちは自覚以上に\n取り乱しとるんか？"},
        { "location": "662/TALK"    , "narrator": "みやび", "text": "$handle$と\n一時的に話せんかった\nことが尾を引いたか？"},
        { "location": "663/TALK"    , "narrator": "みやび", "text": "体験もしとらん\n謎の記憶が\n頭をよぎるとは。"},
        { "location": "664/TALK"    , "narrator": "みやび", "text": "…いかんいかん。\n落ち着けうち。"},
        { "location": "665/TALK"    , "narrator": "みやび", "text": "$handle$もおる。\nつばめちゃんを\nどうにかする…！"},
        { "location": "557/DIALOG"  , "narrator": "Dialog_InfoOS", "text": "\n<color=red>\nApp::WAVE\nactivation succeed!!\n</color>\nライセンスの更新\nありがとうございました。\n素敵なWAVEライフを！\n"},
        { "location": "676/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【28 時計じかけのイチゴ】"}
    ]
}
