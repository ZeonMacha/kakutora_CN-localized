        "title": "002 メインストーリー",
        "sub_title": "小さな箱の中と外＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "小さな箱の中と外"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "はあ…。"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "いつまで\nここにいれば\nいいのかな……。"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "結構時間\n経っちゃったよね？"},
        { "location": "37/TALK"   , "narrator": "神楽", "text": "……。"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "ずっとここに\n閉じ込められたままって\nことはないよね？"},
        { "location": "39/TALK"   , "narrator": "神楽", "text": "……。"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "これから\nどうなるんだろうね。"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "…神楽ちゃん\nずっと下向いた\nまま……。"},
        { "location": "43/TALK"   , "narrator": "つばめ", "text": "わたし少し\nしゃべりすぎかな…？"},
        { "location": "45/TALK"   , "narrator": "神楽", "text": "……つばめさん。"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "え、はい！"},
        { "location": "47/TALK"   , "narrator": "神楽", "text": "つばめさんは\nこの後何が起こると\n思いますか？"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "…え、えと……。"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "そ、そうだね…。\nうーん……。"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "そうだ。\n$handle$さんに\n聞いてみよう。"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "$handle$さん"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "ぃる？"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "ぉーい"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "ぁれ"},
        { "location": "70/TALK"   , "narrator": "つばめ", "text": "忙しぃのかな"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "$handle$さん"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "$handle$さん"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "ぅーん"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "いないかな？"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "残念"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "またね"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "はあ…。"},
        { "location": "98/TALK"   , "narrator": "神楽", "text": "つながらない\nみたいですね。"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "あ、そうなのかな。"},
        { "location": "102/TALK"  , "narrator": "つばめ", "text": "忙しいだけかも\nしれないけど。"},
        { "location": "103/TALK"  , "narrator": "神楽", "text": "…異なる\n可能性セカイの存在。"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "え？　何？"},
        { "location": "106/TALK"  , "narrator": "神楽", "text": "いえ別に。\nそれより、つなげ方\n知ってますよ。"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "ほんと？"},
        { "location": "108/TALK"  , "narrator": "神楽", "text": "ですが、ひとつ\n覚悟してください。"},
        { "location": "109/TALK"  , "narrator": "神楽", "text": "繋げたら間違いなく\n気づかれます。"},
        { "location": "110/TALK"  , "narrator": "神楽", "text": "最悪、死期が早まるかも\nしれません。"},
        { "location": "111/TALK"  , "narrator": "神楽", "text": "それでも\n繋げたいですか？"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "え……。"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "でも、単に忙しくて\n出れないだけかも\nしれないし……。"},
        { "location": "115/TALK"  , "narrator": "神楽", "text": "…そう思うなら\nその方がいいですよ。"},
        { "location": "116/TALK"  , "narrator": "神楽", "text": "平和で平凡な\n幸せな世界に\n生きている方が。"},
        { "location": "118/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "166/TALK"  , "narrator": "つばめ", "text": "　"},
        { "location": "183/TALK"  , "narrator": "百鶴", "text": "只今戻りました。"},
        { "location": "184/SEL"   , "narrator": "", "text": "おかえり"},
        { "location": "185/SEL"   , "narrator": "", "text": "カレンは？"},
        { "location": "186/SEL"   , "narrator": "", "text": "嫁が帰ってきた"},
        { "location": "187/ACT"   , "narrator": "", "text": "おかえり"},
        { "location": "189/TALK"  , "narrator": "百鶴", "text": "寂しかったですか？"},
        { "location": "190/SEL"   , "narrator": "", "text": "寂しかった！"},
        { "location": "191/SEL"   , "narrator": "", "text": "全然"},
        { "location": "192/ACT"   , "narrator": "", "text": "寂しかった！"},
        { "location": "193/TALK"  , "narrator": "百鶴", "text": "知ってました。"},
        { "location": "194/TALK"  , "narrator": "百鶴", "text": "ですが、\n仕方なかったのです。\n外せない用事でしたので。"},
        { "location": "195/TALK"  , "narrator": "百鶴", "text": "淋しい思いを\nさせてしまいましたね。"},
        { "location": "196/ACT"   , "narrator": "", "text": "全然"},
        { "location": "197/TALK"  , "narrator": "百鶴", "text": "なんですって？"},
        { "location": "198/TALK"  , "narrator": "百鶴", "text": "電波障害でしょうか。\nもう一度聞いてみますね。"},
        { "location": "201/ACT"   , "narrator": "", "text": "カレンは？"},
        { "location": "203/TALK"  , "narrator": "百鶴", "text": "おおっ！"},
        { "location": "204/TALK"  , "narrator": "百鶴", "text": "今までに見たことがない\nエラーが出てしまった\nようです。"},
        { "location": "205/TALK"  , "narrator": "百鶴", "text": "$handle$さん、\n何かしましたか？"},
        { "location": "206/SEL"   , "narrator": "", "text": "カレンちゃんは来ないんですか？"},
        { "location": "207/SEL"   , "narrator": "", "text": "やったのは百鶴の方だよね？"},
        { "location": "208/ACT"   , "narrator": "", "text": "カレンちゃんは来ないんですか？"},
        { "location": "210/TALK"  , "narrator": "百鶴", "text": "ああっ！"},
        { "location": "211/TALK"  , "narrator": "百鶴", "text": "何て事をするんですか。\n私を犯罪者にする\nつもりですか？"},
        { "location": "212/SEL"   , "narrator": "", "text": "いいえまさか"},
        { "location": "213/SEL"   , "narrator": "", "text": "もう十分犯罪者だと思うけど"},
        { "location": "214/ACT"   , "narrator": "", "text": "いいえまさか"},
        { "location": "215/TALK"  , "narrator": "百鶴", "text": "ならば発言には\n十分気をつけて\nくださいね。"},
        { "location": "216/TALK"  , "narrator": "百鶴", "text": "その単語は\n放送禁止用語ですから。"},
        { "location": "217/ACT"   , "narrator": "", "text": "もう十分犯罪者だと思うけど"},
        { "location": "218/TALK"  , "narrator": "百鶴", "text": "それは聞き捨て\nなりませんね。"},
        { "location": "219/TALK"  , "narrator": "百鶴", "text": "理由を説明して下さい。"},
        { "location": "220/SEL"   , "narrator": "", "text": "カレンを洗脳しようとしたでしょ？"},
        { "location": "221/ACT"   , "narrator": "", "text": "カレンを洗脳しようとしたでしょ？"},
        { "location": "223/TALK"  , "narrator": "百鶴", "text": "人聞きの悪いことを\n言わないでください！"},
        { "location": "224/TALK"  , "narrator": "百鶴", "text": "わたしが彼女を洗脳したと\n言うのなら、学校教諭は\n全員洗脳者ですよ。"},
        { "location": "225/TALK"  , "narrator": "百鶴", "text": "わたしは彼女に、\nこの世界の素晴らしさを\n説いていただけですし。"},
        { "location": "226/TALK"  , "narrator": "百鶴", "text": "とにかく、その単語は\n放送禁止用語ですから。"},
        { "location": "228/ACT"   , "narrator": "", "text": "やったのは百鶴の方だよね？"},
        { "location": "229/TALK"  , "narrator": "百鶴", "text": "……さあ？"},
        { "location": "230/TALK"  , "narrator": "百鶴", "text": "とにかく、\nその単語は\n放送禁止用語です。"},
        { "location": "232/ACT"   , "narrator": "", "text": "嫁が帰ってきた"},
        { "location": "235/TALK"  , "narrator": "百鶴", "text": "……。"},
        { "location": "236/TALK"  , "narrator": "百鶴", "text": "………。"},
        { "location": "239/SEL"   , "narrator": "", "text": "おーい"},
        { "location": "240/ACT"   , "narrator": "", "text": "おーい"},
        { "location": "245/TALK"  , "narrator": "百鶴", "text": "はい。"},
        { "location": "246/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "247/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "249/TALK"  , "narrator": "百鶴", "text": "いえ、\n大した事ではありません。"},
        { "location": "251/TALK"  , "narrator": "百鶴", "text": "ただ、ちょっとだけ\nゴロゴロしてきた\nだけです。"},
        { "location": "253/SEL"   , "narrator": "", "text": "顔まっ赤にしてドキドキしながらゴロゴロする百鶴かわいい"},
        { "location": "254/SEL"   , "narrator": "", "text": "眠いの？"},
        { "location": "255/ACT"   , "narrator": "", "text": "顔まっ赤にしてドキドキしながらゴロゴロする百鶴かわいい"},
        { "location": "259/TALK"  , "narrator": "百鶴", "text": "<color=red><size=35>ダイレクト\nアタック！！</size></color>"},
        { "location": "260/TALK"  , "narrator": "百鶴", "text": "――ですか、\nそうですか。"},
        { "location": "261/TALK"  , "narrator": "百鶴", "text": "全然オッケーです！\nいいぞもっとやれ！"},
        { "location": "262/SEL"   , "narrator": "", "text": "おいおい"},
        { "location": "263/ACT"   , "narrator": "", "text": "おいおい"},
        { "location": "266/TALK"  , "narrator": "百鶴", "text": "いけません。\nかなり興奮して\nしまいました。"},
        { "location": "267/TALK"  , "narrator": "百鶴", "text": "わかってて悩殺セリフを\n飛ばす$handle$は\nひ・ど・い・や・つ♪"},
        { "location": "268/ACT"   , "narrator": "", "text": "眠いの？"},
        { "location": "271/TALK"  , "narrator": "百鶴", "text": "<size=35>朴！</size>"},
        { "location": "274/TALK"  , "narrator": "百鶴", "text": "<size=35>念！</size>"},
        { "location": "277/TALK"  , "narrator": "百鶴", "text": "<size=35>仁！</size>"},
        { "location": "278/TALK"  , "narrator": "百鶴", "text": "そうやってじらしプレイ\nする$handle$は、\nひ・ど・い・や・つ♪"},
        { "location": "280/TALK"  , "narrator": "百鶴", "text": "全然オッケーです！\nいいぞもっとやれ！"},
        { "location": "281/SEL"   , "narrator": "", "text": "おいおい"},
        { "location": "282/ACT"   , "narrator": "", "text": "おいおい"},
        { "location": "284/TALK"  , "narrator": "百鶴", "text": "いけません。\nかなり興奮して\nしまいました。"},
        { "location": "287/TALK"  , "narrator": "百鶴", "text": "さて、\n今回は――"},
        { "location": "288/SEL"   , "narrator": "", "text": "その前に聞きたいことがある"},
        { "location": "289/ACT"   , "narrator": "", "text": "その前に聞きたいことがある"},
        { "location": "291/TALK"  , "narrator": "百鶴", "text": "なんでしょう。"},
        { "location": "292/SEL"   , "narrator": "", "text": "百鶴って千羽鶴なの？"},
        { "location": "293/ACT"   , "narrator": "", "text": "百鶴って千羽鶴なの？"},
        { "location": "295/TALK"  , "narrator": "百鶴", "text": "……はい？"},
        { "location": "296/TALK"  , "narrator": "百鶴", "text": "意味が分かりません。"},
        { "location": "297/SEL"   , "narrator": "", "text": "千羽鶴がつばめから発症したクランだと知ったんだけど"},
        { "location": "298/ACT"   , "narrator": "", "text": "千羽鶴がつばめから発症したクランだと知ったんだけど"},
        { "location": "300/TALK"  , "narrator": "百鶴", "text": "ああ、なるほど。"},
        { "location": "301/TALK"  , "narrator": "百鶴", "text": "まあ、主がそこまで\n話してしまったのなら\nもういいでしょう。"},
        { "location": "302/TALK"  , "narrator": "百鶴", "text": "もし貴方が勘が良い人なら\nもう言わなくても解るかと\n思いますが――"},
        { "location": "303/TALK"  , "narrator": "百鶴", "text": "わたし＝千羽鶴\nではなく。"},
        { "location": "304/TALK"  , "narrator": "百鶴", "text": "千羽鶴と非常に近い\nポジションにいた、\n元つばめの人格です。"},
        { "location": "305/SEL"   , "narrator": "", "text": "前に「そうでし…す」って言ってたのって…"},
        { "location": "306/ACT"   , "narrator": "", "text": "前に「そうでし…す」って言ってたのって…"},
        { "location": "308/TALK"  , "narrator": "百鶴", "text": "あー、あれはですね、\nつい口が滑って\nしまうんですよね。"},
        { "location": "309/TALK"  , "narrator": "百鶴", "text": "わたし、\n根が正直者なんで。"},
        { "location": "310/TALK"  , "narrator": "百鶴", "text": "話を戻しますと。"},
        { "location": "311/TALK"  , "narrator": "百鶴", "text": "発症したクランはまさに\n幽体離脱のように、元の\n身体から抜け出ます。"},
        { "location": "312/TALK"  , "narrator": "百鶴", "text": "幽体離脱が、身体と\n心が完全に離脱するのに\n対し――"},
        { "location": "313/TALK"  , "narrator": "百鶴", "text": "発症の場合、一部の\n心だけが離脱します。"},
        { "location": "314/TALK"  , "narrator": "百鶴", "text": "それは主に、発症した\n人格とその周囲にいる\n人格たちです。"},
        { "location": "315/TALK"  , "narrator": "百鶴", "text": "そしてつばめの\n発症母体は千羽鶴です。"},
        { "location": "316/TALK"  , "narrator": "百鶴", "text": "わたしは千羽鶴の\n近隣人格ですから、\n千羽鶴と共に離脱。"},
        { "location": "317/TALK"  , "narrator": "百鶴", "text": "ですから私は、\nかつてつばめだった人格\nなんです。"},
        { "location": "318/SEL"   , "narrator": "", "text": "離脱したのにつばめの心にいるの？"},
        { "location": "319/SEL"   , "narrator": "", "text": "クランの割に千羽鶴って普通の格好してるよね"},
        { "location": "320/ACT"   , "narrator": "", "text": "離脱したのにつばめの心にいるの？"},
        { "location": "321/TALK"  , "narrator": "百鶴", "text": "これは誰でもそうですが、\n発症したとしても、完全に\n魂の緒は切れません。"},
        { "location": "322/TALK"  , "narrator": "百鶴", "text": "潜在意識野においては\nちゃんと繋がってます。"},
        { "location": "323/TALK"  , "narrator": "百鶴", "text": "ただ、顕在意識においては\n断絶している状態です。"},
        { "location": "324/SEL"   , "narrator": "", "text": "てことは、発症しても、まだ戻れる可能性があるってこと？"},
        { "location": "325/SEL"   , "narrator": "", "text": "もしかして1xって、発症したクラン側の精神世界ってこと？"},
        { "location": "326/ACT"   , "narrator": "", "text": "てことは、発症しても、まだ戻れる可能性があるってこと？"},
        { "location": "327/TALK"  , "narrator": "百鶴", "text": "もちろん戻れます。"},
        { "location": "328/TALK"  , "narrator": "百鶴", "text": "まあ、自然に戻るという\nことは無いですが。"},
        { "location": "330/ACT"   , "narrator": "", "text": "もしかして1xって、発症したクラン側の精神世界ってこと？"},
        { "location": "331/TALK"  , "narrator": "百鶴", "text": "ぶぶー。\n不正解です。"},
        { "location": "332/TALK"  , "narrator": "百鶴", "text": "1xはトライガジェットに\nよって拡張されたココロの\n世界のことです。"},
        { "location": "334/ACT"   , "narrator": "", "text": "クランの割に千羽鶴って普通の格好してるよね"},
        { "location": "335/TALK"  , "narrator": "百鶴", "text": "すごく偏見に満ちた\n感想ですね、それは。"},
        { "location": "336/TALK"  , "narrator": "百鶴", "text": "まあ確かに、\n貴方が見ているクランは\nヘンなのばっかりですし。"},
        { "location": "337/TALK"  , "narrator": "百鶴", "text": "そう思うのも\n仕方ないかもしれません。"},
        { "location": "338/TALK"  , "narrator": "百鶴", "text": "フェノメノン自体の\n非常識さと、クランの姿の\n非常識さは同じ理由です。"},
        { "location": "339/TALK"  , "narrator": "百鶴", "text": "すなわち、その発症者が\nどれだけ非常識な妄想を\n爆発させたか。"},
        { "location": "340/TALK"  , "narrator": "百鶴", "text": "翻し、我が主による発症は\n持続可能な世界の創造です\nから、常識的です。"},
        { "location": "341/TALK"  , "narrator": "百鶴", "text": "その演者の一人として\n存在するクラン当人もまた\n常識的なのは当然のこと。"},
        { "location": "342/TALK"  , "narrator": "百鶴", "text": "まあ考えてみてください。"},
        { "location": "343/TALK"  , "narrator": "百鶴", "text": "月９の恋愛ドラマに\n片腕ハサミに蒼白顔した、\n山高帽の男が出てきます？"},
        { "location": "344/TALK"  , "narrator": "百鶴", "text": "それだけのことですよ。"},
        { "location": "346/TALK"  , "narrator": "百鶴", "text": "そんな感じで、\nだいたいオッケーですか？"},
        { "location": "347/TALK"  , "narrator": "百鶴", "text": "しかし、主が自ら\nクランであることを\n明かす日が来るとは。"},
        { "location": "348/SEL"   , "narrator": "", "text": "ホントデスネ"},
        { "location": "349/SEL"   , "narrator": "", "text": "明かしたのはエリカさんだけどね"},
        { "location": "350/ACT"   , "narrator": "", "text": "ホントデスネ"},
        { "location": "351/TALK"  , "narrator": "百鶴", "text": "まあ、何か心境の変化が\nあっての事でしょう。"},
        { "location": "352/TALK"  , "narrator": "百鶴", "text": "わたしには\nわかりませんが。"},
        { "location": "353/ACT"   , "narrator": "", "text": "明かしたのはエリカさんだけどね"},
        { "location": "355/TALK"  , "narrator": "百鶴", "text": "がーん！！！"},
        { "location": "356/TALK"  , "narrator": "百鶴", "text": "それを先に言わないのは\n卑怯です！"},
        { "location": "357/SEL"   , "narrator": "", "text": "いや、百鶴が勝手に断定して話を進めたんじゃ"},
        { "location": "358/ACT"   , "narrator": "", "text": "いや、百鶴が勝手に断定して話を進めたんじゃ"},
        { "location": "360/TALK"  , "narrator": "百鶴", "text": "がーん！！！"},
        { "location": "361/TALK"  , "narrator": "百鶴", "text": "人の好意を\n逆手にとるなんて！"},
        { "location": "362/TALK"  , "narrator": "百鶴", "text": "$handle$さんは\n鬼ですか？\n悪魔ですか？"},
        { "location": "363/SEL"   , "narrator": "", "text": "ごめんね？"},
        { "location": "364/SEL"   , "narrator": "", "text": "百鶴の方が悪魔のような所業をやってるよね？"},
        { "location": "365/ACT"   , "narrator": "", "text": "ごめんね？"},
        { "location": "368/TALK"  , "narrator": "百鶴", "text": "……。"},
        { "location": "372/TALK"  , "narrator": "百鶴", "text": "というわけで。"},
        { "location": "373/SEL"   , "narrator": "", "text": "急に何処かへ行って、なにやってたの！？"},
        { "location": "374/ACT"   , "narrator": "", "text": "急に何処かへ行って、なにやってたの！？"},
        { "location": "376/TALK"  , "narrator": "百鶴", "text": "…ゴロゴロしてました。"},
        { "location": "377/SEL"   , "narrator": "", "text": "顔まっ赤にしてドキドキしながらゴロゴロする百鶴かわいい"},
        { "location": "378/SEL"   , "narrator": "", "text": "なに怠けてるの？"},
        { "location": "379/ACT"   , "narrator": "", "text": "顔まっ赤にしてドキドキしながらゴロゴロする百鶴かわいい"},
        { "location": "383/TALK"  , "narrator": "百鶴", "text": "<color=red><size=35>ダイレクト\nアタック！！</size></color>"},
        { "location": "384/TALK"  , "narrator": "百鶴", "text": "――ですか、\nそうですか。"},
        { "location": "385/TALK"  , "narrator": "百鶴", "text": "全然オッケーです！\nいいぞもっとやれ！"},
        { "location": "386/SEL"   , "narrator": "", "text": "$selwd29$"},
        { "location": "389/TALK"  , "narrator": "百鶴", "text": "いけません。\nかなり興奮して\nしまいました。"},
        { "location": "390/TALK"  , "narrator": "百鶴", "text": "わかってて悩殺セリフを\n飛ばす$handle$は\nひ・ど・い・や・つ♪"},
        { "location": "391/ACT"   , "narrator": "", "text": "なに怠けてるの？"},
        { "location": "395/TALK"  , "narrator": "百鶴", "text": "<size=35>朴！</size>"},
        { "location": "398/TALK"  , "narrator": "百鶴", "text": "<size=35>念！</size>"},
        { "location": "401/TALK"  , "narrator": "百鶴", "text": "<size=35>仁！</size>"},
        { "location": "402/TALK"  , "narrator": "百鶴", "text": "そうやってじらしプレイ\nする$handle$は、\nひ・ど・い・や・つ♪"},
        { "location": "403/TALK"  , "narrator": "百鶴", "text": "全然オッケーです！\nいいぞもっとやれ！"},
        { "location": "404/SEL"   , "narrator": "", "text": "$selwd29$"},
        { "location": "407/TALK"  , "narrator": "百鶴", "text": "いけません。\nかなり興奮して\nしまいました。"},
        { "location": "410/ACT"   , "narrator": "", "text": "百鶴の方が悪魔のような所業をやってるよね？"},
        { "location": "411/TALK"  , "narrator": "百鶴", "text": "…ふむ、なるほど。"},
        { "location": "412/TALK"  , "narrator": "百鶴", "text": "これがいわゆる\nブーメランという\nヤツですね。"},
        { "location": "413/SEL"   , "narrator": "", "text": "てことは、カレンを洗脳したことは認めるの？"},
        { "location": "414/ACT"   , "narrator": "", "text": "てことは、カレンを洗脳したことは認めるの？"},
        { "location": "416/TALK"  , "narrator": "百鶴", "text": "洗脳ではありません。\n再教育ですよ。"},
        { "location": "417/TALK"  , "narrator": "百鶴", "text": "予備校みたいなものです。\n本来なら、わたしがお金を\nもらってもおかしくない。"},
        { "location": "418/SEL"   , "narrator": "", "text": "どうしてアースタシアは思想犯なの？"},
        { "location": "419/ACT"   , "narrator": "", "text": "どうしてアースタシアは思想犯なの？"},
        { "location": "421/TALK"  , "narrator": "百鶴", "text": "あの歌がつばめのココロを\n汚染し、本来創造すべき\n世界が出来ていません。"},
        { "location": "422/TALK"  , "narrator": "百鶴", "text": "一刻も早く、\nココロの中から\n排除すべき存在です。"},
        { "location": "423/TALK"  , "narrator": "百鶴", "text": "――っと、だいぶ\n無駄話が過ぎて\nしまいました。"},
        { "location": "426/TALK"  , "narrator": "百鶴", "text": "さて、どういう理由にせよ\nわたしの主がクランである\nことがバレた以上――"},
        { "location": "427/TALK"  , "narrator": "百鶴", "text": "わたしがここにいる理由も\nお伝えしておく必要が\nあるでしょう。"},
        { "location": "428/TALK"  , "narrator": "百鶴", "text": "わたしの使命は、\nつばめを本来の正しい\n聖女の姿に戻すことです。"},
        { "location": "429/SEL"   , "narrator": "", "text": "聖女キタコレ！"},
        { "location": "430/ACT"   , "narrator": "", "text": "聖女キタコレ！"},
        { "location": "432/TALK"  , "narrator": "百鶴", "text": "そのためには、\nファンタジーのような\n希望を排除し――"},
        { "location": "433/TALK"  , "narrator": "百鶴", "text": "絶対的秩序を持った\n理想的な社会の創造に、\n全力で取りかかる、"},
        { "location": "434/TALK"  , "narrator": "百鶴", "text": "そんなひたむきなココロを\n取り戻す必要があります。"},
        { "location": "435/SEL"   , "narrator": "", "text": "それっていいことなの？"},
        { "location": "436/ACT"   , "narrator": "", "text": "それっていいことなの？"},
        { "location": "438/TALK"  , "narrator": "百鶴", "text": "愚問ですね。"},
        { "location": "439/TALK"  , "narrator": "百鶴", "text": "善し悪しとは、全てに\nおいて相対的な基準。"},
        { "location": "440/TALK"  , "narrator": "百鶴", "text": "それは人によって\n正解が変わります。"},
        { "location": "441/TALK"  , "narrator": "百鶴", "text": "大事なのは、それが\nこの世界の大多数にとって\nどれほど有益かです。"},
        { "location": "442/TALK"  , "narrator": "百鶴", "text": "その点に関しては、\n聖女としての使命には\n絶対的な自信があります。"},
        { "location": "443/SEL"   , "narrator": "", "text": "具体的にはどうしようとしてるの？"},
        { "location": "444/SEL"   , "narrator": "", "text": "$me$がそれに賛同できず、戦うことになったとしても？"},
        { "location": "445/ACT"   , "narrator": "", "text": "具体的にはどうしようとしてるの？"},
        { "location": "446/TALK"  , "narrator": "百鶴", "text": "わたしの知る限りのことを\n言えば――"},
        { "location": "447/TALK"  , "narrator": "百鶴", "text": "我が主の\nつばめへの回帰です。"},
        { "location": "448/ACT"   , "narrator": "", "text": "$me$がそれに賛同できず、戦うことになったとしても？"},
        { "location": "451/TALK"  , "narrator": "百鶴", "text": "それは、わたしとわたしの\n主である千羽鶴が二人して\n貴方を見つめ――"},
        { "location": "452/TALK"  , "narrator": "百鶴", "text": "目をウルウルさせながら\n「お・ね・が・い♪」と\n言っても変わりませんか？"},
        { "location": "453/SEL"   , "narrator": "", "text": "ああん、賛同しますっ！"},
        { "location": "454/SEL"   , "narrator": "", "text": "$me$を甘く見ない方がいい"},
        { "location": "455/ACT"   , "narrator": "", "text": "ああん、賛同しますっ！"},
        { "location": "457/TALK"  , "narrator": "百鶴", "text": "チョロ可愛いですね。"},
        { "location": "459/TALK"  , "narrator": "百鶴", "text": "そんな\n$handle$さんが\n大好きですよ？"},
        { "location": "460/ACT"   , "narrator": "", "text": "$me$を甘く見ない方がいい"},
        { "location": "463/TALK"  , "narrator": "百鶴", "text": "わたしをあまり\n怒らせない方が\nいいですよ。"},
        { "location": "466/TALK"  , "narrator": "百鶴", "text": "何にしても、です。"},
        { "location": "467/TALK"  , "narrator": "百鶴", "text": "$handle$さんは、\nわたしとひとつに交わって\n同じ理想に向かうべき！"},
        { "location": "468/TALK"  , "narrator": "百鶴", "text": "わたし、いまでこそ\nこんな貧相な身体を\n纏っていますが――"},
        { "location": "469/TALK"  , "narrator": "百鶴", "text": "実を言うと、\n脱いだら凄いんです！"},
        { "location": "470/SEL"   , "narrator": "", "text": "えっ！？"},
        { "location": "471/SEL"   , "narrator": "", "text": "今脱いで！！"},
        { "location": "472/ACT"   , "narrator": "", "text": "えっ！？"},
        { "location": "473/TALK"  , "narrator": "百鶴", "text": "…まあ、そんな日が\n来ないことを\n祈ってはいますが。"},
        { "location": "474/ACT"   , "narrator": "", "text": "今脱いで！！"},
        { "location": "475/TALK"  , "narrator": "百鶴", "text": "……死にますよ？"},
        { "location": "476/TALK"  , "narrator": "百鶴", "text": "できればその日が\n来ないことを、切に\n願っています。"},
        { "location": "478/TALK"  , "narrator": "百鶴", "text": "と。"},
        { "location": "479/TALK"  , "narrator": "百鶴", "text": "今回はこれくらい\nですかね。わたしがお伝え\nしたかったことは。"},
        { "location": "480/TALK"  , "narrator": "百鶴", "text": "それでは、\n$handle$さんと\nわたしに素敵な――"},
        { "location": "481/SEL"   , "narrator": "", "text": "待って待って！"},
        { "location": "482/ACT"   , "narrator": "", "text": "待って待って！"},
        { "location": "485/TALK"  , "narrator": "百鶴", "text": "プロポーズですか？"},
        { "location": "486/SEL"   , "narrator": "", "text": "まだココロの葛藤を処理してない！"},
        { "location": "487/SEL"   , "narrator": "", "text": "そうです！"},
        { "location": "488/ACT"   , "narrator": "", "text": "まだココロの葛藤を処理してない！"},
        { "location": "490/TALK"  , "narrator": "百鶴", "text": "主からのものでもないのに\n処理する必要は\nありません。"},
        { "location": "491/TALK"  , "narrator": "百鶴", "text": "寧ろ、バタフライ\nエフェクトが増大して\nしまいます。"},
        { "location": "492/TALK"  , "narrator": "百鶴", "text": "連絡が途絶えているなら\n取るべき行動は１つ。"},
        { "location": "493/TALK"  , "narrator": "百鶴", "text": "主が戻られるまで、\n何もしないこと。\nこれに尽きます。"},
        { "location": "494/SEL"   , "narrator": "", "text": "そうかー…"},
        { "location": "495/SEL"   , "narrator": "", "text": "じゃあ、$me$の願いなら聞いてくれる？"},
        { "location": "496/ACT"   , "narrator": "", "text": "そうかー…"},
        { "location": "498/TALK"  , "narrator": "百鶴", "text": "はい、そうです。"},
        { "location": "499/TALK"  , "narrator": "百鶴", "text": "というわけで、\n今日はこの辺で。"},
        { "location": "500/TALK"  , "narrator": "百鶴", "text": "何も無くても構いません\nので、またすぐにここへ\n来てくださいね。"},
        { "location": "501/TALK"  , "narrator": "百鶴", "text": "$handle$さんと\nわたしに、素敵な\nココロの旅を。"},
        { "location": "509/ACT"   , "narrator": "", "text": "じゃあ、$me$の願いなら聞いてくれる？"},
        { "location": "511/TALK"  , "narrator": "百鶴", "text": "どんな願いですか？"},
        { "location": "513/ACT"   , "narrator": "", "text": "そうです！"},
        { "location": "518/TALK"  , "narrator": "百鶴", "text": "ふぅ。"},
        { "location": "519/SEL"   , "narrator": "", "text": "長くなかった？"},
        { "location": "520/ACT"   , "narrator": "", "text": "長くなかった？"},
        { "location": "522/TALK"  , "narrator": "百鶴", "text": "だいぶ長時間\nゴロゴロしてましたので。"},
        { "location": "523/TALK"  , "narrator": "百鶴", "text": "さあ！\nでは早速結婚しましょう！"},
        { "location": "527/TALK"  , "narrator": "百鶴", "text": "結婚おめでとう\nわたしたち。"},
        { "location": "531/TALK"  , "narrator": "百鶴", "text": "というわけで、\nこの後は、二人で\n何をしましょうか？"},
        { "location": "532/SEL"   , "narrator": "", "text": "$me$の願いを聞いて欲しい"},
        { "location": "533/ACT"   , "narrator": "", "text": "$me$の願いを聞いて欲しい"},
        { "location": "535/TALK"  , "narrator": "百鶴", "text": "ええいいですとも。"},
        { "location": "538/TALK"  , "narrator": "百鶴", "text": "ごはんですか？"},
        { "location": "542/TALK"  , "narrator": "百鶴", "text": "おふろですか？"},
        { "location": "545/TALK"  , "narrator": "百鶴", "text": "わたしですか！？"},
        { "location": "547/SEL"   , "narrator": "", "text": "つばめが$me$と話をしたいと決意するようにして欲しい"},
        { "location": "548/SEL"   , "narrator": "", "text": "つばめ少しでも長生きするようにして欲しい"},
        { "location": "549/ACT"   , "narrator": "", "text": "つばめが$me$と話をしたいと決意するようにして欲しい"},
        { "location": "553/TALK"  , "narrator": "百鶴", "text": "なるほど。\nこれは前代未聞の\n依頼ですね。"},
        { "location": "554/TALK"  , "narrator": "百鶴", "text": "しかし、わたしの立場上、\nそういったことは……"},
        { "location": "555/SEL"   , "narrator": "", "text": "百鶴愛してる！"},
        { "location": "556/SEL"   , "narrator": "", "text": "百鶴にしか出来ないことなんだ！"},
        { "location": "557/ACT"   , "narrator": "", "text": "百鶴愛してる！"},
        { "location": "560/TALK"  , "narrator": "百鶴", "text": "任せてください！"},
        { "location": "561/ACT"   , "narrator": "", "text": "百鶴にしか出来ないことなんだ！"},
        { "location": "564/TALK"  , "narrator": "百鶴", "text": "そこまで言われたら\n仕方ないですね。"},
        { "location": "566/SEL"   , "narrator": "", "text": "え"},
        { "location": "567/ACT"   , "narrator": "", "text": "え"},
        { "location": "572/TALK"  , "narrator": "百鶴", "text": "オープンプロセス、\n0x4C2番地から\n0x9FF番地へ。"},
        { "location": "595/TALK"  , "narrator": "百鶴", "text": "シーク完了しました。"},
        { "location": "596/TALK"  , "narrator": "百鶴", "text": "それではどうぞ、\nいってらっしゃい。"},
        { "location": "597/TALK"  , "narrator": "百鶴", "text": "$handle$さんと\nわたしに、素敵な\nハネムーンを。"},
        { "location": "604/ACT"   , "narrator": "", "text": "つばめ少しでも長生きするようにして欲しい"},
        { "location": "606/TALK"  , "narrator": "百鶴", "text": "なるほど。"},
        { "location": "607/TALK"  , "narrator": "百鶴", "text": "しかしその場合、\n特に何もしないのが\n最善だと思うのですが。"},
        { "location": "608/TALK"  , "narrator": "百鶴", "text": "よって、今の状態から\n何かを動かす必要は\nありませんね。"},
        { "location": "609/TALK"  , "narrator": "百鶴", "text": "というわけで、\n今日はこの辺で。"},
        { "location": "610/TALK"  , "narrator": "百鶴", "text": "何も無くても構いません\nので、またすぐにここへ\n来てくださいね。"},
        { "location": "611/TALK"  , "narrator": "百鶴", "text": "$handle$さんと\nわたしに、素敵な\nココロの旅を。"},
        { "location": "32/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月5日　 10:54 AM</color>\nつばめが拘束されて３日目、監禁部屋でのこと"},
        { "location": "131/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "133/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "135/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "137/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "139/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "202/DIALOG", "narrator": "Dialog_Alert", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\n\nその単語は意味不明です。"},
        { "location": "209/DIALOG", "narrator": "Dialog_Alert", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\n\nその単語は法的に禁止されています。"}
    ]
