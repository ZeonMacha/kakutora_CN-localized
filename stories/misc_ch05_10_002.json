    "entry":
    [
        { "location": "2513/SCENARIO", "narrator": "", "text": "路上ロジック"},
        { "location": "2538/TALK"    , "narrator": "神楽", "text": "日暮れて看板の灯る坂道が都会的だとあの人が言った"},
        { "location": "2540/SEL"     , "narrator": "", "text": "アーヤ？"},
        { "location": "2541/SEL"     , "narrator": "", "text": "神楽坂？"},
        { "location": "2542/ACT"     , "narrator": "", "text": "アーヤ？"},
        { "location": "2543/TALK"    , "narrator": "神楽", "text": "当たり"},
        { "location": "2544/TALK"    , "narrator": "神楽", "text": "アーヤさんの育ったところって店どころか街灯もなかったみたいぴょん"},
        { "location": "2547/ACT"     , "narrator": "", "text": "神楽坂？"},
        { "location": "2548/TALK"    , "narrator": "神楽", "text": "そそ"},
        { "location": "2550/TALK"    , "narrator": "神楽", "text": "神楽坂って意外ときつい坂道なんだけどずっと店が続いてるから飽きずに歩ける感じ"},
        { "location": "2552/SEL"     , "narrator": "", "text": "$me$は神楽を退屈させない"},
        { "location": "2553/SEL"     , "narrator": "", "text": "行ってみたいなー"},
        { "location": "2554/SEL"     , "narrator": "", "text": "結構飽きるよ"},
        { "location": "2555/ACT"     , "narrator": "", "text": "$me$は神楽を退屈させない"},
        { "location": "2557/TALK"    , "narrator": "神楽", "text": "よく言った"},
        { "location": "2559/TALK"    , "narrator": "神楽", "text": "その自信ステキ"},
        { "location": "2560/TALK"    , "narrator": "神楽", "text": "約束は守ってね！"},
        { "location": "2561/ACT"     , "narrator": "", "text": "行ってみたいなー"},
        { "location": "2562/TALK"    , "narrator": "神楽", "text": "暇な時はいつでも来ればいいぴょん"},
        { "location": "2563/TALK"    , "narrator": "神楽", "text": "案内はしねーけど☆彡"},
        { "location": "2564/ACT"     , "narrator": "", "text": "結構飽きるよ"},
        { "location": "2565/TALK"    , "narrator": "神楽", "text": "足りてないのは$handlek$のセンスオブワンダーなり☆彡"},
        { "location": "2567/TALK"    , "narrator": "神楽", "text": "町としては古いしアレだけど"},
        { "location": "2568/TALK"    , "narrator": "神楽", "text": "人気あるのはわかるわ"},
        { "location": "2569/TALK"    , "narrator": "神楽", "text": "通好みっていうの？そういうやつ"},
        { "location": "2571/SEL"     , "narrator": "", "text": "その手の人が一番ミーハーだよねｗ"},
        { "location": "2572/SEL"     , "narrator": "", "text": "そうなんだ"},
        { "location": "2573/SEL"     , "narrator": "", "text": "$me$が神楽を好きなのと同じだね"},
        { "location": "2574/ACT"     , "narrator": "", "text": "その手の人が一番ミーハーだよねｗ"},
        { "location": "2575/TALK"    , "narrator": "神楽", "text": "ホントのこと言うなしｗｗｗ"},
        { "location": "2576/ACT"     , "narrator": "", "text": "そうなんだ"},
        { "location": "2577/TALK"    , "narrator": "神楽", "text": "左様ですことよ"},
        { "location": "2578/ACT"     , "narrator": "", "text": "$me$が神楽を好きなのと同じだね"},
        { "location": "2580/TALK"    , "narrator": "神楽", "text": "ぴょんこは通好みというよりは超メジャー指向！"},
        { "location": "2581/TALK"    , "narrator": "神楽", "text": "しかもミーハーも通も唸らせるフックをきちんと設定してあるぴょん！！！"},
        { "location": "2582/TALK"    , "narrator": "神楽", "text": "まーそこがぴょんこのいいとこですけど？"},
        { "location": "2585/TALK"    , "narrator": "神楽", "text": "個人的には表通りより横道を入ったところの隠れ家的なカフェを推したいところ"},
        { "location": "2586/TALK"    , "narrator": "神楽", "text": "でも人には教えないけどね☆彡"}
    ]
}
