    "entry":
    [
        { "location": "157/SCENARIO", "narrator": "", "text": "思ひでころころ"},
        { "location": "182/TALK"    , "narrator": "みやび", "text": "ガブちゃんは以外と詩人やき"},
        { "location": "183/TALK"    , "narrator": "みやび", "text": "どうもうちも影響を受けてしまう"},
        { "location": "185/SEL"     , "narrator": "", "text": "なにかあったの？"},
        { "location": "186/SEL"     , "narrator": "", "text": "みやびの前だと$handle$も詩人になるよ"},
        { "location": "187/ACT"     , "narrator": "", "text": "なにかあったの？"},
        { "location": "188/TALK"    , "narrator": "みやび", "text": "ガブちゃんの"},
        { "location": "189/TALK"    , "narrator": "みやび", "text": "乙女心に"},
        { "location": "190/TALK"    , "narrator": "みやび", "text": "あてられた"},
        { "location": "192/SEL"     , "narrator": "", "text": "心の俳句？"},
        { "location": "193/SEL"     , "narrator": "", "text": "川柳かな"},
        { "location": "194/SEL"     , "narrator": "", "text": "詩とはちょっと違うような"},
        { "location": "195/ACT"     , "narrator": "", "text": "心の俳句？"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "図らずも五七五"},
        { "location": "197/ACT"     , "narrator": "", "text": "川柳かな"},
        { "location": "198/TALK"    , "narrator": "みやび", "text": "うちはサラリーマンでも"},
        { "location": "199/TALK"    , "narrator": "みやび", "text": "ＯＬでもないぞね"},
        { "location": "200/ACT"     , "narrator": "", "text": "詩とはちょっと違うような"},
        { "location": "201/TALK"    , "narrator": "みやび", "text": "確かに"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "そうかも"},
        { "location": "204/ACT"     , "narrator": "", "text": "みやびの前だと$handle$も詩人になるよ"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "またそういうことを"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "そこまで言うなら"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "愛の詩をささやけ"},
        { "location": "217/TALK"    , "narrator": "みやび", "text": "ばかちんが"},
        { "location": "219/TALK"    , "narrator": "みやび", "text": "ガブちゃんは"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "夕暮れの街を歩くのが"},
        { "location": "221/TALK"    , "narrator": "みやび", "text": "とても好きなのだと言っておった"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "神楽坂の緩い坂道を"},
        { "location": "224/TALK"    , "narrator": "みやび", "text": "すれ違う人の話をなんとなく聞きながら歩くのが"},
        { "location": "226/SEL"     , "narrator": "", "text": "わかる気がする"},
        { "location": "227/SEL"     , "narrator": "", "text": "そういうもんかなー"},
        { "location": "228/SEL"     , "narrator": "", "text": "確かに詩人っぽい"},
        { "location": "229/ACT"     , "narrator": "", "text": "わかる気がする"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "そうであろう"},
        { "location": "232/ACT"     , "narrator": "", "text": "そういうもんかなー"},
        { "location": "233/TALK"    , "narrator": "みやび", "text": "ドライだの"},
        { "location": "236/ACT"     , "narrator": "", "text": "確かに詩人っぽい"},
        { "location": "237/TALK"    , "narrator": "みやび", "text": "そうなのだ"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "なんてこともない日常なんじゃがの"},
        { "location": "240/TALK"    , "narrator": "みやび", "text": "そういう隙間的なささやかなものに気づく幸せ"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "いいものだ、と思いつつ"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "少し気になるところもある"},
        { "location": "244/SEL"     , "narrator": "", "text": "何が？"},
        { "location": "245/SEL"     , "narrator": "", "text": "嫉妬じゃない？"},
        { "location": "246/ACT"     , "narrator": "", "text": "何が？"},
        { "location": "247/TALK"    , "narrator": "みやび", "text": "うちが悲観的すぎるのかもしれんが"},
        { "location": "248/ACT"     , "narrator": "", "text": "嫉妬じゃない？"},
        { "location": "249/TALK"    , "narrator": "みやび", "text": "そういう意見もあるろう"},
        { "location": "251/TALK"    , "narrator": "みやび", "text": "その幸せは"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "いつまでもあるものだろうか？"},
        { "location": "254/SEL"     , "narrator": "", "text": "あるでしょ"},
        { "location": "255/SEL"     , "narrator": "", "text": "なくなるかもー"},
        { "location": "256/SEL"     , "narrator": "", "text": "幸せって感じられなくなることはあるかも"},
        { "location": "257/ACT"     , "narrator": "", "text": "あるでしょ"},
        { "location": "258/TALK"    , "narrator": "みやび", "text": "なんとシンプルな答えであることか"},
        { "location": "259/ACT"     , "narrator": "", "text": "なくなるかもー"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "脅かすな"},
        { "location": "261/ACT"     , "narrator": "", "text": "幸せって感じられなくなることはあるかも"},
        { "location": "262/TALK"    , "narrator": "みやび", "text": "それを一番"},
        { "location": "263/TALK"    , "narrator": "みやび", "text": "懸念しておる"},
        { "location": "265/TALK"    , "narrator": "みやび", "text": "思い出はみな美しいという"},
        { "location": "266/TALK"    , "narrator": "みやび", "text": "が"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "そればかりでは現実に対処できないのでは"},
        { "location": "269/SEL"     , "narrator": "", "text": "考えすぎだよ"},
        { "location": "270/SEL"     , "narrator": "", "text": "みやびと$me$の思い出は永遠"},
        { "location": "271/ACT"     , "narrator": "", "text": "考えすぎだよ"},
        { "location": "272/TALK"    , "narrator": "みやび", "text": "なら"},
        { "location": "273/TALK"    , "narrator": "みやび", "text": "いい"},
        { "location": "274/ACT"     , "narrator": "", "text": "みやびと$me$の思い出は永遠"},
        { "location": "275/TALK"    , "narrator": "みやび", "text": "それはそれは"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "大きく出たの"},
        { "location": "279/TALK"    , "narrator": "みやび", "text": "なんて"},
        { "location": "280/TALK"    , "narrator": "みやび", "text": "うちもメロウになることがあるぞね"},
        { "location": "282/TALK"    , "narrator": "みやび", "text": "気にするな"},
        { "location": "210/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
    ]
}
