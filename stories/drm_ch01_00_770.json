        { "location": "104/SCENARIO", "narrator": "", "text": "どうだった？"},
        { "location": "129/TALK"    , "narrator": "つばめ", "text": "お父さんがね"},
        { "location": "130/TALK"    , "narrator": "つばめ", "text": "$handle$さんと話していいって"},
        { "location": "132/SEL"     , "narrator": "", "text": "知ってる"},
        { "location": "133/SEL"     , "narrator": "", "text": "よかった"},
        { "location": "134/SEL"     , "narrator": "", "text": "つばめのおかげだよ"},
        { "location": "135/ACT"     , "narrator": "", "text": "知ってる"},
        { "location": "136/TALK"    , "narrator": "つばめ", "text": "そっか"},
        { "location": "139/ACT"     , "narrator": "", "text": "よかった"},
        { "location": "140/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "141/ACT"     , "narrator": "", "text": "つばめのおかげだよ"},
        { "location": "151/TALK"    , "narrator": "つばめ", "text": "ぇ"},
        { "location": "153/TALK"    , "narrator": "つばめ", "text": "ぁたし"},
        { "location": "154/TALK"    , "narrator": "つばめ", "text": "何かした？"},
        { "location": "156/TALK"    , "narrator": "つばめ", "text": "でね"},
        { "location": "157/TALK"    , "narrator": "つばめ", "text": "お父さん変なこと言ったりしてなぃ？"},
        { "location": "158/TALK"    , "narrator": "つばめ", "text": "$handle$さんに"},
        { "location": "160/SEL"     , "narrator": "", "text": "別に"},
        { "location": "161/SEL"     , "narrator": "", "text": "気にしないで"},
        { "location": "162/SEL"     , "narrator": "", "text": "いいお父さんだね"},
        { "location": "163/ACT"     , "narrator": "", "text": "別に"},
        { "location": "164/TALK"    , "narrator": "つばめ", "text": "そぅ？"},
        { "location": "165/TALK"    , "narrator": "つばめ", "text": "だったらぃぃんだけど"},
        { "location": "166/ACT"     , "narrator": "", "text": "気にしないで"},
        { "location": "167/TALK"    , "narrator": "つばめ", "text": "ぅー"},
        { "location": "169/TALK"    , "narrator": "つばめ", "text": "ちょっと気になっちゃうょ"},
        { "location": "170/ACT"     , "narrator": "", "text": "いいお父さんだね"},
        { "location": "180/TALK"    , "narrator": "つばめ", "text": "そぅなの！"},
        { "location": "182/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "183/TALK"    , "narrator": "つばめ", "text": "過保護だょね"},
        { "location": "185/TALK"    , "narrator": "つばめ", "text": "ちょっとだけ"},
        { "location": "188/TALK"    , "narrator": "つばめ", "text": "お父さんって。。。"},
        { "location": "191/TALK"    , "narrator": "ボイスメール", "text": "怒っちゃダメかな"},
        { "location": "147/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
