        { "location": "1652/SCENARIO", "narrator": "", "text": "いつものこと"},
        { "location": "1677/TALK"    , "narrator": "神楽", "text": "あーもー電車とか乗りたくないー！"},
        { "location": "1679/SEL"     , "narrator": "", "text": "神楽はリムジンじゃないの？"},
        { "location": "1680/SEL"     , "narrator": "", "text": "もしかして痴漢……？"},
        { "location": "1681/SEL"     , "narrator": "", "text": "移動自体が面倒くさいよねー"},
        { "location": "1682/ACT"     , "narrator": "", "text": "神楽はリムジンじゃないの？"},
        { "location": "1684/TALK"    , "narrator": "神楽", "text": "まあそうなんだけどね！"},
        { "location": "1685/TALK"    , "narrator": "神楽", "text": "って"},
        { "location": "1686/TALK"    , "narrator": "神楽", "text": "そんなだったら電車乗らないしー"},
        { "location": "1687/ACT"     , "narrator": "", "text": "もしかして痴漢……？"},
        { "location": "1688/TALK"    , "narrator": "神楽", "text": "迷惑行為はやめて欲しいですね、、、"},
        { "location": "1689/ACT"     , "narrator": "", "text": "移動自体が面倒くさいよねー"},
        { "location": "1690/TALK"    , "narrator": "神楽", "text": "それはある"},
        { "location": "1692/TALK"    , "narrator": "神楽", "text": "ほんとある"},
        { "location": "1694/TALK"    , "narrator": "神楽", "text": "特に雨の日の電車嫌すぎて暴れ出すレベル"},
        { "location": "1696/SEL"     , "narrator": "", "text": "落ち着いて"},
        { "location": "1697/SEL"     , "narrator": "", "text": "雨の日は外出をやめよう"},
        { "location": "1698/SEL"     , "narrator": "", "text": "神楽のために貸切にするから！"},
        { "location": "1699/ACT"     , "narrator": "", "text": "落ち着いて"},
        { "location": "1700/TALK"    , "narrator": "神楽", "text": "落ち着いてないのかな？"},
        { "location": "1701/ACT"     , "narrator": "", "text": "雨の日は外出をやめよう"},
        { "location": "1702/TALK"    , "narrator": "神楽", "text": "ダヨネー"},
        { "location": "1703/TALK"    , "narrator": "神楽", "text": "それができたらどんなにいいか"},
        { "location": "1704/ACT"     , "narrator": "", "text": "神楽のために貸切にするから！"},
        { "location": "1706/TALK"    , "narrator": "神楽", "text": "やだ素敵"},
        { "location": "1708/TALK"    , "narrator": "神楽", "text": "それｲｲﾈ！"},
        { "location": "1709/TALK"    , "narrator": "神楽", "text": "楽しみにしてるね♪"},
        { "location": "1711/TALK"    , "narrator": "神楽", "text": "混んでなくてボックス席とかで移動じゃなくて旅行だったら全然いいんだけどね電車"},
        { "location": "1712/TALK"    , "narrator": "神楽", "text": "移動のための電車で雨降りはちょっと辛いかなって"},
        { "location": "1713/TALK"    , "narrator": "神楽", "text": "なんてね"},
        { "location": "1714/TALK"    , "narrator": "神楽", "text": "騒いだら気が済んだ"},
        { "location": "1716/TALK"    , "narrator": "神楽", "text": "じゃあね$handlek$"},
        { "location": "1717/TALK"    , "narrator": "神楽", "text": "いい夢を♪"}
    ]
