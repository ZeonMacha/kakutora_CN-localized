{
    "dir": "chap11/daydra/dd_ch02_11_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "11205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "その彼女嫉妬につき＜後編＞"
    },
    "entry":
    [
        { "location": "564/SCENARIO", "narrator": "", "text": "恋について"},
        { "location": "593/TALK"    , "narrator": "アーヤ", "text": "…そっか。"},
        { "location": "594/TALK"    , "narrator": "アーヤ", "text": "つばめが私と小夜に\n対しての態度が\n違うのは――"},
        { "location": "595/TALK"    , "narrator": "アーヤ", "text": "私にも原因が\nあったんだわ。"},
        { "location": "597/TALK"    , "narrator": "アーヤ", "text": "今まで、何となく\nつばめに対して――"},
        { "location": "598/TALK"    , "narrator": "アーヤ", "text": "一線引いた態度を\n取っちゃってたのは\n事実だし。"},
        { "location": "599/TALK"    , "narrator": "アーヤ", "text": "素直に接してる\n小夜に懐くのは、\n当然のことよね。"},
        { "location": "600/TALK"    , "narrator": "アーヤ", "text": "ふぅ…。"},
        { "location": "602/TALK"    , "narrator": "小夜", "text": "あれ？\nため息なんか吐いて、\nどうしたの？"},
        { "location": "604/TALK"    , "narrator": "アーヤ", "text": "あ、ううん。\n何でもない。"},
        { "location": "606/TALK"    , "narrator": "つばめ", "text": "アーヤさん、\nなんだか元気ない\nみたいです。"},
        { "location": "607/TALK"    , "narrator": "つばめ", "text": "もしかして、\n具合でも悪いんじゃ\nないですか？"},
        { "location": "610/TALK"    , "narrator": "アーヤ", "text": "ううん、本当に平気。"},
        { "location": "611/TALK"    , "narrator": "アーヤ", "text": "心配してくれて\nありがとう、つばめ。"},
        { "location": "613/TALK"    , "narrator": "ガブリエラ", "text": "えっ？"},
        { "location": "616/TALK"    , "narrator": "つばめ", "text": "あっ…い、いえ…。"},
        { "location": "617/TALK"    , "narrator": "アーヤ", "text": "…？　どうかしたの？"},
        { "location": "620/TALK"    , "narrator": "つばめ", "text": "いえ、その…大した\nことじゃないんです\nけど。"},
        { "location": "621/TALK"    , "narrator": "つばめ", "text": "アーヤさんに名前で\n呼ばれるの初めて\nだったから――"},
        { "location": "622/TALK"    , "narrator": "つばめ", "text": "ちょっとだけ\nビックリしちゃい\nました。"},
        { "location": "624/TALK"    , "narrator": "アーヤ", "text": "…え？"},
        { "location": "627/TALK"    , "narrator": "アーヤ", "text": "え！？\n今、私つばめって\n言った？"},
        { "location": "630/TALK"    , "narrator": "ガブリエラ", "text": "言ってたわ。"},
        { "location": "632/TALK"    , "narrator": "小夜", "text": "普通に言ってたよ。"},
        { "location": "633/TALK"    , "narrator": "アーヤ", "text": "えぇっ！？"},
        { "location": "634/TALK"    , "narrator": "アーヤ", "text": "ご、ごめんなさい、\n逢瀬さん。"},
        { "location": "636/TALK"    , "narrator": "つばめ", "text": "いえ、いいんです。\n呼ばれ方は別に\n気にしてませんから。"},
        { "location": "637/TALK"    , "narrator": "アーヤ", "text": "そ、そう？"},
        { "location": "638/TALK"    , "narrator": "つばめ", "text": "はい…。"},
        { "location": "640/TALK"    , "narrator": "つばめ", "text": "でも、名字よりも、\n名前で読んでもらった\n方が――"},
        { "location": "641/TALK"    , "narrator": "つばめ", "text": "何となくだけど\n嬉しい感じがします。"},
        { "location": "644/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "646/TALK"    , "narrator": "アーヤ", "text": "じゃ、じゃあ、\n私もこれからは――"},
        { "location": "647/TALK"    , "narrator": "アーヤ", "text": "つばめ、って呼ばせて\nもらおうかしら？"},
        { "location": "649/TALK"    , "narrator": "つばめ", "text": "…はい！\n嬉しいです、\nアーヤさん。"},
        { "location": "650/TALK"    , "narrator": "小夜", "text": "私も、つばめちゃんは\n名前で呼んだ方が\n絶対いいと思うよ。"},
        { "location": "651/TALK"    , "narrator": "小夜", "text": "つばめって名前、\n凄く素敵だし。"},
        { "location": "653/TALK"    , "narrator": "つばめ", "text": "そ、そうですか？\nえへへ…ありがとう\nございます。"},
        { "location": "656/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "659/TALK"    , "narrator": "ガブリエラ", "text": "何よ、つばめってば。\n小夜さんに懐いてたと\n思ったら――"},
        { "location": "660/TALK"    , "narrator": "ガブリエラ", "text": "今度は突然、アーヤと\n仲良くしだして…。"},
        { "location": "662/TALK"    , "narrator": "ガブリエラ", "text": "…ふふっ、\nいいこと考えた。"},
        { "location": "665/TALK"    , "narrator": "ガブリエラ", "text": "それじゃあ、つばめも\nアーヤを呼び捨てに\nすれば？"},
        { "location": "668/TALK"    , "narrator": "つばめ", "text": "えぇっ！？\nだ、ダメダメ、\nできないよぉ…。"},
        { "location": "669/TALK"    , "narrator": "ガブリエラ", "text": "何でよ？"},
        { "location": "670/TALK"    , "narrator": "つばめ", "text": "だって、アーヤさんは\n先輩だし…。"},
        { "location": "671/TALK"    , "narrator": "ガブリエラ", "text": "あたしもみやびも、\n普通にアーヤのこと\n呼び捨てなんだけど？"},
        { "location": "674/TALK"    , "narrator": "ガブリエラ", "text": "それに、アーヤだって\nそんなこと気にしない\nわよ…ね？"},
        { "location": "676/TALK"    , "narrator": "アーヤ", "text": "ふふっ、そうね。\n別に構わないわ。"},
        { "location": "678/TALK"    , "narrator": "つばめ", "text": "で、でも…。"},
        { "location": "681/TALK"    , "narrator": "ガブリエラ", "text": "一回だけさ、\n試しに呼んでみれば？"},
        { "location": "682/TALK"    , "narrator": "ガブリエラ", "text": "意外と呼びやすくて\n定着するかもしれない\nんだし。"},
        { "location": "683/TALK"    , "narrator": "アーヤ", "text": "そうね。\nそれいいかも。"},
        { "location": "685/TALK"    , "narrator": "つばめ", "text": "え、ちょ…、\n本気ですか？"},
        { "location": "686/TALK"    , "narrator": "小夜", "text": "あー、はいはい、\nそこまでー。"},
        { "location": "687/TALK"    , "narrator": "小夜", "text": "可愛いからからかい\nたくなる気持ち\nわかるけど――"},
        { "location": "688/TALK"    , "narrator": "小夜", "text": "やり過ぎると\n嫌われちゃうよ？"},
        { "location": "689/TALK"    , "narrator": "アーヤ", "text": "そ、そうね…。\nちょっと調子に\n乗っちゃったかしら？"},
        { "location": "691/TALK"    , "narrator": "ガブリエラ", "text": "まったく、つばめは\n堅苦しいんだから…。"},
        { "location": "693/TALK"    , "narrator": "つばめ", "text": "助かりました、\n小夜さん。"},
        { "location": "694/TALK"    , "narrator": "小夜", "text": "あはは、これくらい\n何てことないって。"},
        { "location": "695/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "707/TALK"    , "narrator": "アーヤ", "text": "何だか"},
        { "location": "708/TALK"    , "narrator": "アーヤ", "text": "この数分で"},
        { "location": "709/TALK"    , "narrator": "アーヤ", "text": "つばめとの距離"},
        { "location": "710/TALK"    , "narrator": "アーヤ", "text": "グッと縮まった気がする"},
        { "location": "712/SEL"     , "narrator": "", "text": "それはよかった"},
        { "location": "713/ACT"     , "narrator": "", "text": "それはよかった"},
        { "location": "715/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "717/TALK"    , "narrator": "アーヤ", "text": "ありがとう"},
        { "location": "718/TALK"    , "narrator": "アーヤ", "text": "多分"},
        { "location": "719/TALK"    , "narrator": "アーヤ", "text": "$handle$が何かしたんじゃないかなって"},
        { "location": "720/TALK"    , "narrator": "アーヤ", "text": "そう思ったから声かけたの"},
        { "location": "722/SEL"     , "narrator": "", "text": "ご想像にお任せします"},
        { "location": "723/ACT"     , "narrator": "", "text": "ご想像にお任せします"},
        { "location": "725/TALK"    , "narrator": "アーヤ", "text": "ええ"},
        { "location": "726/TALK"    , "narrator": "アーヤ", "text": "そうするわ"},
        { "location": "748/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【09 パーフェクトイエロー】"}
    ]
}
