        { "location": "151/TALK"    , "narrator": "ガブリエラ", "text": "素敵でしょう？"},
        { "location": "155/ACT"     , "narrator": "", "text": "キラキラしてる…"},
        { "location": "156/TALK"    , "narrator": "ガブリエラ", "text": "そうよｖ"},
        { "location": "157/TALK"    , "narrator": "ガブリエラ", "text": "キラキラしているの☆彡"},
        { "location": "158/ACT"     , "narrator": "", "text": "メッセージカードかな？"},
        { "location": "159/TALK"    , "narrator": "ガブリエラ", "text": "ええ、その通りよｖ"},
        { "location": "160/TALK"    , "narrator": "ガブリエラ", "text": "かわいいでしょう？"},
