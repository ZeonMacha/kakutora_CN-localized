        { "location": "164/TALK"    , "narrator": "ガブリエラ", "text": "そうなのよｖｖｖｖｖ"},
        { "location": "166/TALK"    , "narrator": "ガブリエラ", "text": "よくわかったわね//////////////////////////////"},
        { "location": "168/TALK"    , "narrator": "ガブリエラ", "text": "キラキラしてるインクのペンを使ってみたのvvvvvvvvvvvvvv"},
        { "location": "169/TALK"    , "narrator": "ガブリエラ", "text": "この色、限定色なんですって！"},
        { "location": "170/TALK"    , "narrator": "ガブリエラ", "text": "お店で見本のカードを作ってる人がいて、それがすごくかわいかったの！"},
        { "location": "171/TALK"    , "narrator": "ガブリエラ", "text": "だから私も買ってみたのよｖｖｖｖｖ"},
        { "location": "173/SEL"     , "narrator": "", "text": "そうなんだ"},
        { "location": "174/SEL"     , "narrator": "", "text": "無駄遣いはダメだよ"},
        { "location": "175/SEL"     , "narrator": "", "text": "よかったね"},
        { "location": "176/ACT"     , "narrator": "", "text": "そうなんだ"},
        { "location": "177/TALK"    , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "178/TALK"    , "narrator": "ガブリエラ", "text": "気のないお返事ね"},
        { "location": "179/ACT"     , "narrator": "", "text": "無駄遣いはダメだよ"},
        { "location": "180/TALK"    , "narrator": "ガブリエラ", "text": "なによ"},
        { "location": "181/TALK"    , "narrator": "ガブリエラ", "text": "必要な出費よ"},
        { "location": "182/ACT"     , "narrator": "", "text": "よかったね"},
        { "location": "183/TALK"    , "narrator": "ガブリエラ", "text": "ええ"},
        { "location": "184/TALK"    , "narrator": "ガブリエラ", "text": "素敵なものを手に入れたわｖｖｖｖｖ"},
        { "location": "186/TALK"    , "narrator": "ガブリエラ", "text": "これからはノートを取る時も使おうと思っているのｖｖｖｖ"},
        { "location": "187/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "188/TALK"    , "narrator": "ガブリエラ", "text": "授業に使うのはちょっともったいない気もするわ・・・"},
        { "location": "191/SEL"     , "narrator": "", "text": "やる気が出て良いよね"},
        { "location": "192/SEL"     , "narrator": "", "text": "だったらやめとけば"},
        { "location": "193/ACT"     , "narrator": "", "text": "やる気が出て良いよね"},
        { "location": "194/TALK"    , "narrator": "ガブリエラ", "text": "そうよねｖｖｖｖ"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "そうするわｖｖｖｖｖｖｖ"},
        { "location": "197/ACT"     , "narrator": "", "text": "だったらやめとけば"},
        { "location": "198/TALK"    , "narrator": "ガブリエラ", "text": "そうかしら・・・"},
        { "location": "199/TALK"    , "narrator": "ガブリエラ", "text": "うーん・・・"},
        { "location": "201/TALK"    , "narrator": "ガブリエラ", "text": "悩むわね・・・"},
        { "location": "203/TALK"    , "narrator": "ガブリエラ", "text": "あっ"},
        { "location": "204/TALK"    , "narrator": "ガブリエラ", "text": "言うのを忘れていたわ"},
