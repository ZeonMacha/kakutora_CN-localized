        "title": "Extra002 プレミアムストーリー",
        "sub_title": "パソコンについて"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "パソコンについて"},
        { "location": "26/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "27/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "…大人しい子や。"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "まほさんが手続きの\n準備しちょる間――"},
        { "location": "30/TALK"   , "narrator": "みやび", "text": "一人で待っちょる\n言うてたから、\n気を使うたんやが…。"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "うち、一緒におる\n必要なかったな。"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "まあ、話すような\nこともないんやし、\nまあえいか。"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "じーっ……。"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "じーっ……。"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "…はぁ。"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "…つばめちゃん、\n用事があるなら\nはっきり言いや。"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "それとも、\nうちに惚れちょるが？"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "ご、ごめんなさい！\nあの、惚れたわけじゃ\nないんです。"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "それは良かった。\nうちにもそういう\n趣味はないきね。"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "ですよねぇ……。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "…で？　何の用やが？"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "はい…みやびさん、\nキーボード打つの\n早いなぁ、って…。"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "わたし、パソコンは\n初心者だから――"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "みやびさんみたいに\n自在に操れる人に\n憧れてるんです！"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "自在に操れるっちゅう\nほどやないけんど。"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "つばめちゃんは普段、\nどんなことにＰＣを\n使っちゅう？"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "えっと…動画サイトを\n見たり、情報検索を\nしたりとか…。"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "…可愛らしい\n使い方やね。"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "まあ、入隊したら\nいくらでも教えちゃる\nがよ。"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "いいんですか？\nやったぁ！"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "うむ。\nうちに任せや。"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "さて、と…。"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "早速ＳＯＳ、すっと返事しいや"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "パソコン初心者には、何から教えるのがえいが？"},
        { "location": "83/SEL"    , "narrator": "", "text": "結局$me$に聞くの？"},
        { "location": "84/ACT"    , "narrator": "", "text": "結局$me$に聞くの？"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "当然や"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "うちとあんたはパートナーみたいなもんやきね"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "というわけやき、初心者には何から教えるべきやと思う？"},
        { "location": "90/SEL"    , "narrator": "", "text": "何をしたいのか聞こう"},
        { "location": "91/SEL"    , "narrator": "", "text": "Hello worldだよ"},
        { "location": "92/ACT"    , "narrator": "", "text": "何をしたいのか聞こう"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "確かに、それ聞かんと何も教えられんきね。"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "やけどつばめちゃん、ＰＣ使うて何したいんやか？"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "プログラム組みたいなんちゅうわけないやろうし…。"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "りょ。"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "つばめちゃんは、\nうちにＰＣ習って、\n何をしたいが？"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "はい？"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "何かやりたいことが\nあって、習いたいんや\nないんか？"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "え、えっと……。"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "まさか……\n使えたらかっこよさ\nそうやき…とか？"},
        { "location": "116/TALK"  , "narrator": "つばめ", "text": "…え、えへへ……\nすみません。"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "そうか…。\n悪いけんど、それやと\n何も教えられんちや。"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "せめて何をしたいかが\nわからんとね…。"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "そ、そうですか…。\nションボリです。"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "まあ、プログラムでも\nなんでも、やりたい\nものができたら―"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "その時はいつでも\n頼みに来てくれて\n構わんき。"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "今日みたいに暇なら、\nいつでも教えるちや。"},
        { "location": "125/ACT"   , "narrator": "", "text": "Hello worldだよ"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "渋っ！？　予想外過ぎちや！！"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "Hello worldなんて、もはや化石か都市伝説かと思っちょったき！"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "…けんどそれも、つばめちゃんには丁度えいかもしれん。"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "はぁ……。"},
        { "location": "143/TALK"  , "narrator": "つばめ", "text": "みやびさん、どうか\nしたんですか？"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "…感動しちゅうがよ。"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "まさかHello worldを\n薦められるとは、\n夢にも思わんかったき。"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "はろぉ、わーるど？\n外国の人とチャット\nするんですか？"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "…まあ、知らなくても\nしゃあないか。"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "Hello worldは、\n簡単なプログラムや。"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "初心者でも五分もあれば\n完成させられるんよ。"},
        { "location": "153/TALK"  , "narrator": "つばめ", "text": "本当ですか！？"},
        { "location": "154/TALK"  , "narrator": "つばめ", "text": "それ、教えてください！"},
        { "location": "155/TALK"  , "narrator": "みやび", "text": "えいけど…外国の人と\nチャットするソフトを\n作るわけやないがよ？"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "このプログラムは画面に\n「Hello world」と\n表示させるだけやき。"},
        { "location": "157/TALK"  , "narrator": "つばめ", "text": "え……それだけ、ですか？"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "最初はそんなもんちや。"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "まあ、これを機に本気で\nプログラムを勉強して\nいけば――"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "いずれは、外国の人と\nチャットするソフトも\n作れるようになる――"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "かもしれんね。"},
        { "location": "16/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月7日　10:19 AM</color>\nＧＷの午前中、神楽坂トライナリー劇場のホワイエにて。"}
    ]
}
