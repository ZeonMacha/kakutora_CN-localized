        { "location": "5097/SEL"     , "narrator": "", "text": "そういうの大好き"},
        { "location": "5098/SEL"     , "narrator": "", "text": "$me$は神楽を絶対ルールにするよ"},
        { "location": "5099/SEL"     , "narrator": "", "text": "その逆が地雷とか萎え"},
        { "location": "5100/ACT"     , "narrator": "", "text": "そういうの大好き"},
        { "location": "5101/TALK"    , "narrator": "神楽", "text": "だよねー！"},
        { "location": "5102/ACT"     , "narrator": "", "text": "$me$は神楽を絶対ルールにするよ"},
        { "location": "5104/TALK"    , "narrator": "神楽", "text": "わかったぴょん♪"},
        { "location": "5106/TALK"    , "narrator": "神楽", "text": "今後は$handlek$には色々無理ゲーなことを強要したりすることにするぴょん"},
