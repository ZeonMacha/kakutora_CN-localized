    "type": "",
    "info": {
        "story_id": "24015",
        "cid": "",
        "title": "015 ココロスフィアストーリー【Lv05】",
        "sub_title": "巧妙な罠＜帰結＞"
    },
    "entry":
    [
        { "location": "238/SCENARIO", "narrator": "", "text": "巧妙な罠"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "はぁ…。"},
        { "location": "251/TALK"    , "narrator": "みやび", "text": "毎度思うことや\nけんども――"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "自分と戦うっちゅう\nのは、不思議な\n感覚やね。"},
        { "location": "253/SEL"     , "narrator": "（選択肢）", "text": "それで、どうするか決まった？"},
        { "location": "254/ACT"     , "narrator": "", "text": "それで、どうするか決まった？"},
        { "location": "257/TALK"    , "narrator": "みやび", "text": "そうやなぁ…。"},
        { "location": "258/TALK"    , "narrator": "みやび", "text": "…正直なとこ、\n引っかかる所は\nまだまだあるちや。"},
        { "location": "259/TALK"    , "narrator": "みやび", "text": "けんど、そんな理由で\nいつまでも相手を\n疑っちょったら――"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "今のみんなみたいな、\n嫌な奴になりかねん。"},
        { "location": "262/TALK"    , "narrator": "つばめ", "text": "なんで…なんで誰も\n信じてくれないん\nですか！？"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "っと、話は後や。\n今はみんなを説得に\n行かんと…。"},
        { "location": "283/TALK"    , "narrator": "つばめ", "text": "そんなに疑うなら、\n寮の部屋を調べても\n構いません！"},
        { "location": "284/TALK"    , "narrator": "アーヤ", "text": "つばめ…私達に\nそんなことを\nさせないで。"},
        { "location": "285/TALK"    , "narrator": "アーヤ", "text": "こっちも、楽しくて\nこんなことしてる\nわけじゃないのよ？"},
        { "location": "286/TALK"    , "narrator": "つばめ", "text": "で、でも…だって！\n無実の証拠なんて\nそれくらいしか――"},
        { "location": "288/TALK"    , "narrator": "ガブリエラ", "text": "ていうか、劇場とか\n他のところに隠して\nるんじゃない？"},
        { "location": "290/TALK"    , "narrator": "神楽", "text": "まあ、中身を抜けば\n財布くらい、簡単に\n隠せますよね。"},
        { "location": "291/TALK"    , "narrator": "つばめ", "text": "…酷い。\nこれじゃ、何しても\n証明できないよ…。"},
        { "location": "296/TALK"    , "narrator": "みやび", "text": "全員、そこまでや。"},
        { "location": "297/TALK"    , "narrator": "神楽", "text": "みやびさん。"},
        { "location": "298/TALK"    , "narrator": "みやび", "text": "全員、とりあえず\n落ち着きぃ。"},
        { "location": "300/TALK"    , "narrator": "ガブリエラ", "text": "みやび、今は真面目な\n話をしてるんだから、\n邪魔しないで。"},
        { "location": "302/TALK"    , "narrator": "みやび", "text": "真面目も何も、\n話になっちょるように\n思えんかったけんど？"},
        { "location": "303/TALK"    , "narrator": "みやび", "text": "怪しいから言うて、\n一方的に疑うて\n責めてるだけやろ。"},
        { "location": "304/TALK"    , "narrator": "ガブリエラ", "text": "なっ！？べ、別に、\n責めてなんか…。"},
        { "location": "307/TALK"    , "narrator": "アーヤ", "text": "そうよ。\nただ、私達はつばめに\nお願いしてるの。"},
        { "location": "308/TALK"    , "narrator": "アーヤ", "text": "私達に、つばめを\n責めるようなことを\nさせないで、って。"},
        { "location": "309/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "313/TALK"    , "narrator": "みやび", "text": "それは、\nつばめちゃんが\n落とし物の財布を――"},
        { "location": "314/TALK"    , "narrator": "みやび", "text": "盗んでると仮定した\n場合やろ？"},
        { "location": "315/TALK"    , "narrator": "みやび", "text": "もしつばめちゃんは\n本当に何も知らん\nかったら――"},
        { "location": "316/TALK"    , "narrator": "みやび", "text": "どうすることも\nできんがよ。"},
        { "location": "319/TALK"    , "narrator": "神楽", "text": "で、でもみやびさん！\n状況証拠から見て\n間違いなく――"},
        { "location": "322/TALK"    , "narrator": "みやび", "text": "決定的証拠が出ない\n限り、間違いなく\nなんて言えんちや。"},
        { "location": "323/TALK"    , "narrator": "みやび", "text": "…つばめちゃん。\nつばめちゃんは、\n盗ってないんやろ？"},
        { "location": "325/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "327/TALK"    , "narrator": "みやび", "text": "…一方的に疑わんき、\n正直に言ぃ。"},
        { "location": "328/TALK"    , "narrator": "つばめ", "text": "…盗ってません。"},
        { "location": "331/TALK"    , "narrator": "みやび", "text": "うん…ちゅうことや。"},
        { "location": "332/TALK"    , "narrator": "みやび", "text": "これで持ち物検査や\n部屋を調べて――"},
        { "location": "333/TALK"    , "narrator": "みやび", "text": "まっこと何も出て\nこんかったら…、\nどうするつもりや？"},
        { "location": "335/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "337/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "339/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "340/TALK"    , "narrator": "みやび", "text": "怪しいゆうて\n疑う前に――"},
        { "location": "341/TALK"    , "narrator": "みやび", "text": "まずは、みんなで\n探すぞね。"},
        { "location": "342/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "345/TALK"    , "narrator": "アーヤ", "text": "ごめんなさい、\nつばめ。\n嫌な想いさせて…。"},
        { "location": "346/TALK"    , "narrator": "アーヤ", "text": "劇場でこんなことが\n起きたの初めてで、\n混乱しちゃって…。"},
        { "location": "348/TALK"    , "narrator": "つばめ", "text": "アーヤさん…。"},
        { "location": "350/TALK"    , "narrator": "ガブリエラ", "text": "…あ、あたしも、\nちょっと頭に熱が\n上ってたみたい。"},
        { "location": "352/TALK"    , "narrator": "ガブリエラ", "text": "…わ、悪かったわ。"},
        { "location": "353/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "356/TALK"    , "narrator": "神楽", "text": "…それじゃあ、\nとりあえずみんな、\nこれで仲直りですね。"},
        { "location": "357/TALK"    , "narrator": "みやび", "text": "つばめちゃんが\nそれでえい言うて\nくれるならな。"},
        { "location": "359/TALK"    , "narrator": "つばめ", "text": "わ、わたしは――"},
        { "location": "360/TALK"    , "narrator": "つばめ", "text": "みんなが、信じて\nくれるなら…。"},
        { "location": "362/TALK"    , "narrator": "みやび", "text": "…ん、ならこれで\nこの話はしまいや。"},
        { "location": "363/TALK"    , "narrator": "みやび", "text": "全員、勝手に消えた\n財布探しを始める\nがよ！"},
        { "location": "364/TALK"    , "narrator": "アーヤ", "text": "ええ…私はもう一度、\n売店を見てみるわ。"},
        { "location": "366/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ、あたしは\n廊下とか見てくる。"},
        { "location": "368/TALK"    , "narrator": "神楽", "text": "私は、万が一のことを\n考えて劇場の外を\n見てきますね。"},
        { "location": "384/TALK"    , "narrator": "みやび", "text": "…さてと、それじゃ\nうちは楽屋を――"},
        { "location": "385/TALK"    , "narrator": "つばめ", "text": "…ありがとう。"},
        { "location": "387/TALK"    , "narrator": "みやび", "text": "ん？"},
        { "location": "389/TALK"    , "narrator": "つばめ", "text": "ありがとう…、\nみやびさん。"},
        { "location": "391/TALK"    , "narrator": "つばめ", "text": "わたし…みんなに\n疑われて…悲しくて、\n辛くて…。"},
        { "location": "392/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "393/TALK"    , "narrator": "みやび", "text": "ほれ、泣いちょらんで\nすっと探し始めんと。"},
        { "location": "394/TALK"    , "narrator": "みやび", "text": "完全に疑い晴らす\nためにも、今はやる\nことやろうな。"},
        { "location": "396/TALK"    , "narrator": "つばめ", "text": "…はい！"}
    ]
}
