    "entry":
    [
        { "location": "2378/SCENARIO", "narrator": "", "text": "高潔な魂"},
        { "location": "2403/TALK"    , "narrator": "神楽", "text": "みやびさんちょっとやりにくいですね、、、"},
        { "location": "2404/TALK"    , "narrator": "神楽", "text": "ネットスラング詳しいですしリアルタイムにネット文化に接してるからなかなか強敵"},
        { "location": "2405/TALK"    , "narrator": "神楽", "text": "下手に使わない方がいいですね"},
        { "location": "2407/SEL"     , "narrator": "", "text": "むしろ積極的に使っていこう"},
        { "location": "2408/SEL"     , "narrator": "", "text": "そうかもね～"},
        { "location": "2409/SEL"     , "narrator": "", "text": "$me$が教えてあげる"},
        { "location": "2410/ACT"     , "narrator": "", "text": "むしろ積極的に使っていこう"},
        { "location": "2411/TALK"    , "narrator": "神楽", "text": "前向きですね～"},
        { "location": "2412/ACT"     , "narrator": "", "text": "そうかもね～"},
        { "location": "2413/TALK"    , "narrator": "神楽", "text": "やっぱりそうするべきなんでしょうか？？？"},
        { "location": "2414/TALK"    , "narrator": "神楽", "text": "う～ん、、、"},
        { "location": "2417/ACT"     , "narrator": "", "text": "$me$が教えてあげる"},
        { "location": "2418/TALK"    , "narrator": "神楽", "text": "$handle$さんがですか！？"},
        { "location": "2419/TALK"    , "narrator": "神楽", "text": "それは期待ですね♪"},
        { "location": "2420/TALK"    , "narrator": "神楽", "text": "$handle$先生～"},
        { "location": "2421/TALK"    , "narrator": "神楽", "text": "よろしくお願いしますねっ♪"},
        { "location": "2423/TALK"    , "narrator": "神楽", "text": "急に使うのをやめるのも却って怪しいですしね"},
        { "location": "2424/TALK"    , "narrator": "神楽", "text": "少しづつ減らしていくとかでやめるべきでしょうかね"},
        { "location": "2425/TALK"    , "narrator": "神楽", "text": "ん～"},
        { "location": "2427/SEL"     , "narrator": "", "text": "今まで通りでいいんじゃない"},
        { "location": "2428/SEL"     , "narrator": "", "text": "できたらもっと使って欲しいな～"},
        { "location": "2429/SEL"     , "narrator": "", "text": "やめちゃうこと自体が怪しいよ"},
        { "location": "2430/ACT"     , "narrator": "", "text": "今まで通りでいいんじゃない"},
        { "location": "2431/TALK"    , "narrator": "神楽", "text": "そうでしょうか？"},
        { "location": "2432/ACT"     , "narrator": "", "text": "できたらもっと使って欲しいな～"},
        { "location": "2433/TALK"    , "narrator": "神楽", "text": "$handle$さんはそっち派なんですか"},
        { "location": "2434/ACT"     , "narrator": "", "text": "やめちゃうこと自体が怪しいよ"},
        { "location": "2435/TALK"    , "narrator": "神楽", "text": "確かにそれもそうなんですよね～"},
        { "location": "2437/TALK"    , "narrator": "神楽", "text": "疑われるような真似はしたくないですし"},
        { "location": "2438/TALK"    , "narrator": "神楽", "text": "できればキャラの作り込みもしたいんですよ2016年のＪＫとして"},
        { "location": "2439/TALK"    , "narrator": "神楽", "text": "でもこれってバレた時は嘘つき扱いされちゃうんですかね、、、"},
        { "location": "2442/SEL"     , "narrator": "", "text": "それは仕方ないかも"},
        { "location": "2443/SEL"     , "narrator": "", "text": "バレなきゃいいんだよ"},
        { "location": "2444/SEL"     , "narrator": "", "text": "面白がってくれるといいよね"},
        { "location": "2445/ACT"     , "narrator": "", "text": "それは仕方ないかも"},
        { "location": "2446/TALK"    , "narrator": "神楽", "text": "まあ"},
        { "location": "2447/TALK"    , "narrator": "神楽", "text": "そうですよね"},
        { "location": "2448/ACT"     , "narrator": "", "text": "バレなきゃいいんだよ"},
        { "location": "2449/TALK"    , "narrator": "神楽", "text": "それができたら"},
        { "location": "2450/TALK"    , "narrator": "神楽", "text": "こんなに悩まないです"},
        { "location": "2451/ACT"     , "narrator": "", "text": "面白がってくれるといいよね"},
        { "location": "2452/TALK"    , "narrator": "神楽", "text": "うわ"},
        { "location": "2453/TALK"    , "narrator": "神楽", "text": "全力でポジティブすぎ"},
        { "location": "2456/SEL"     , "narrator": "", "text": "事情が事情だし責められたりしないよ"},
        { "location": "2457/SEL"     , "narrator": "", "text": "色々察してくれると思うよ"},
        { "location": "2458/SEL"     , "narrator": "", "text": "最後は丸く収まるはず"},
        { "location": "2459/ACT"     , "narrator": "", "text": "事情が事情だし責められたりしないよ"},
        { "location": "2462/TALK"    , "narrator": "神楽", "text": "そういう心配をしてるわけでもないんですけどね？"},
        { "location": "2463/ACT"     , "narrator": "", "text": "色々察してくれると思うよ"},
        { "location": "2466/TALK"    , "narrator": "神楽", "text": "それこそ女子力ってやつなんでしょうか"},
        { "location": "2467/ACT"     , "narrator": "", "text": "最後は丸く収まるはず"},
        { "location": "2470/TALK"    , "narrator": "神楽", "text": "はずって適当ですね～"},
        { "location": "2473/SEL"     , "narrator": "", "text": "神楽は被害者でもあるんだし"},
        { "location": "2474/SEL"     , "narrator": "", "text": "理由が理由だからありだよ"},
        { "location": "2475/SEL"     , "narrator": "", "text": "心配いらないから"},
        { "location": "2476/ACT"     , "narrator": "", "text": "神楽は被害者でもあるんだし"},
        { "location": "2477/TALK"    , "narrator": "神楽", "text": "そんなの言い訳にならないですよ"},
        { "location": "2478/ACT"     , "narrator": "", "text": "理由が理由だからありだよ"},
        { "location": "2479/TALK"    , "narrator": "神楽", "text": "そんなに図々しくなれないです"},
        { "location": "2480/ACT"     , "narrator": "", "text": "心配いらないから"},
        { "location": "2481/TALK"    , "narrator": "神楽", "text": "どこに根拠があるんですか"},
        { "location": "2483/TALK"    , "narrator": "神楽", "text": "私は嘘をつくつもりはないんです"},
        { "location": "2484/TALK"    , "narrator": "神楽", "text": "ただ言えないことがあるだけ"},
        { "location": "2485/TALK"    , "narrator": "神楽", "text": "なんてやっぱり詭弁"},
        { "location": "2486/TALK"    , "narrator": "神楽", "text": "それに少しは楽しみがないと辛すぎるのも本当"},
        { "location": "2489/SEL"     , "narrator": "", "text": "$me$じゃ支えにならないかな？"},
        { "location": "2490/SEL"     , "narrator": "", "text": "わかるよその気持ち"},
        { "location": "2491/SEL"     , "narrator": "", "text": "神楽が大変なのは知ってる"},
        { "location": "2492/ACT"     , "narrator": "", "text": "$me$じゃ支えにならないかな？"},
        { "location": "2494/TALK"    , "narrator": "神楽", "text": "なって欲しいですよ"},
        { "location": "2495/TALK"    , "narrator": "神楽", "text": "もちろん"},
        { "location": "2496/TALK"    , "narrator": "神楽", "text": "そんなの"},
        { "location": "2497/ACT"     , "narrator": "", "text": "わかるよその気持ち"},
        { "location": "2498/TALK"    , "narrator": "神楽", "text": "軽々しくわかるとか"},
        { "location": "2499/TALK"    , "narrator": "神楽", "text": "そういうの"},
        { "location": "2500/TALK"    , "narrator": "神楽", "text": "どうかと思いますけど"},
        { "location": "2501/ACT"     , "narrator": "", "text": "神楽が大変なのは知ってる"},
        { "location": "2502/TALK"    , "narrator": "神楽", "text": "当たり前ですよ"},
        { "location": "2503/TALK"    , "narrator": "神楽", "text": "ものすごく大変なんです"},
        { "location": "2504/TALK"    , "narrator": "神楽", "text": "私本当は"},
        { "location": "2506/TALK"    , "narrator": "神楽", "text": "なんてずいぶん話がずれちゃいました"},
        { "location": "2507/TALK"    , "narrator": "神楽", "text": "少し頭冷やします"},
        { "location": "2508/TALK"    , "narrator": "神楽", "text": "ｼｭﾙﾙﾙﾙﾙﾙ、、、"},
        { "location": "2511/TALK"    , "narrator": "ボイスメール", "text": "あの日の僕から、いつかの君へ"},
        { "location": "2523/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【あの日の僕から、いつかの君へ】</color>\nをゲットしました！"}
    ]
}
