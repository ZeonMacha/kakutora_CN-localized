    "entry":
    [
        { "location": "165/SCENARIO", "narrator": "", "text": "690_たかが紙切れ一枚と言おう"},
        { "location": "190/TALK"    , "narrator": "みやび", "text": "うちなりの"},
        { "location": "191/TALK"    , "narrator": "みやび", "text": "結論が出たぞね"},
        { "location": "192/TALK"    , "narrator": "みやび", "text": "添付ファイルを"},
        { "location": "193/TALK"    , "narrator": "みやび", "text": "確認せい"},
        { "location": "195/SEL"     , "narrator": "", "text": "まずはウィルスチェックだ"},
        { "location": "196/SEL"     , "narrator": "", "text": "何なのか説明して"},
        { "location": "197/ACT"     , "narrator": "", "text": "まずはウィルスチェックだ"},
        { "location": "198/TALK"    , "narrator": "みやび", "text": "安心せい"},
        { "location": "199/TALK"    , "narrator": "みやび", "text": "確認済みぞね"},
        { "location": "200/ACT"     , "narrator": "", "text": "何なのか説明して"},
        { "location": "201/TALK"    , "narrator": "みやび", "text": "それは"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "ファイルを確認すればわかる"},
        { "location": "204/TALK"    , "narrator": "みやび", "text": "$handle$は"},
        { "location": "205/TALK"    , "narrator": "みやび", "text": "うちがうちであればいいと言うたぞね"},
        { "location": "207/SEL"     , "narrator": "", "text": "言ったけど"},
        { "location": "208/SEL"     , "narrator": "", "text": "もうちょっと説明がほしい"},
        { "location": "209/SEL"     , "narrator": "", "text": "それ以上は望まない"},
        { "location": "210/ACT"     , "narrator": "", "text": "言ったけど"},
        { "location": "211/TALK"    , "narrator": "みやび", "text": "うちはそれでは"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "納得がいかんかったということぞね"},
        { "location": "213/ACT"     , "narrator": "", "text": "もうちょっと説明がほしい"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "だから"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "添付ファイルを見ればすべてわかるちや"},
        { "location": "216/ACT"     , "narrator": "", "text": "それ以上は望まない"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "$handle$はそれでもええろう"},
        { "location": "228/TALK"    , "narrator": "みやび", "text": "しかしうちはそれではいかんちや"},
        { "location": "229/TALK"    , "narrator": "みやび", "text": "納得できんかったぞね"},
        { "location": "232/SEL"     , "narrator": "", "text": "そうだったんだ"},
        { "location": "233/SEL"     , "narrator": "", "text": "ごめん"},
        { "location": "234/ACT"     , "narrator": "", "text": "そうだったんだ"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "わかったか"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "ばかちんめ"},
        { "location": "237/ACT"     , "narrator": "", "text": "ごめん"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "本当だ"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "$handle$め"},
        { "location": "243/TALK"    , "narrator": "ボイスメール", "text": "紙一枚の耐えられない重さ"},
        { "location": "222/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "255/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【紙一枚の耐えられない重さ】</color>\nをゲットしました！"}
    ]
}
