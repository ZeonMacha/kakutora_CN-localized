{
    "dir": "chap21/daydra/dd_ch01_21_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "21152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "楽しまなくちゃ"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "楽しまなくちゃ"},
        { "location": "21/TALK"   , "narrator": "つばめ", "text": "ふぅ…疲れたぁ…。"},
        { "location": "22/TALK"   , "narrator": "アーヤ", "text": "楽しんでるみたいね。"},
        { "location": "24/TALK"   , "narrator": "つばめ", "text": "はい！　海ってこんなに\n楽しいんですね。"},
        { "location": "25/TALK"   , "narrator": "ガブリエラ", "text": "まるで海を知らない人\nみたいな言い方ね。"},
        { "location": "28/TALK"   , "narrator": "つばめ", "text": "海くらい知ってるよ。"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "わたしの実家も、\n結構海から近いんだよ？"},
        { "location": "31/TALK"   , "narrator": "神楽", "text": "そういえば、\n静岡でしたよね？"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "なんだ、それじゃあ\n結構遊び慣れてるんだ？"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "見慣れてはいるけど、\n遊び慣れてはいないよ。"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "海を見に行くことは\nあっても、入ったことは\nなかったんじゃないかな？"},
        { "location": "36/TALK"   , "narrator": "神楽", "text": "一回も無いんですか！？"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "多分ね。\n波打ち際くらいまでなら\n入ったことあるけど…。"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "だから、今ちょっとだけ\n感動してるんだ。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "そっか…。\nそれじゃはしゃぐのも\n当然ね。"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "えっ、そんなに\nはしゃいでましたか？"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "ふふっ、凄く楽しそう\nだったわ。"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、自分で\n気づかなかったの？"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "え、えーっと…。"},
        { "location": "49/SEL"    , "narrator": "", "text": "楽しまないと勿体ない"},
        { "location": "50/SEL"    , "narrator": "", "text": "砂浜で遊ぼう"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "全然気づかなかったけど、\nわたし、そんなにはしゃい\nじゃってたんだ…。"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "ちょっと恥ずかしいかも。\n少し落ち着かないと。"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "…気付いてなかった\nみたいね。"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "え、えへへ…。\n楽しくて、つい…。"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "休憩はもういいかな、\nって思ったけど――"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "もう少し休んで、\nちょっと落ち着いてから\n遊ぼう…。"},
        { "location": "62/ACT"    , "narrator": "", "text": "楽しまないと勿体ない"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "そうだよね"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "せっかく海に来てるんだもん！"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "…気付いてなかった\nみたいね。"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "いいの、うんと楽しむって\n決めたから。"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "さてと、休憩おしまい！\nわたし、ちょっと沖の方\nまで泳いでくるね。"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "元気ねぇ。\nちょっとしか休憩して\nないのに…。"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "どうせなら、競争しない？"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "あ、それ楽しそう。\n卯月さんもどう？"},
        { "location": "102/TALK"  , "narrator": "神楽", "text": "私は遠慮します。\nもう少し休憩したいし…。"},
        { "location": "103/TALK"  , "narrator": "つばめ", "text": "そっか…。"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "先に行ってるわ。\n競争はもう始まってるん\nだから！"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "あっ、ガブちゃんズルい！"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "…本当、はしゃいでる\nわね。"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "はぁ、はぁ…。"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "よ、よかったぁ。\nやっと戻れたよ…。"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "はぁ、はぁ…。\nだ、誰のおかげで、\n戻って、来れたと――"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "お、思って…。"},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "む、無理しないで！"},
        { "location": "129/TALK"  , "narrator": "つばめ", "text": "ごめんね。\nわたしのせいで、\n無理させちゃって…。"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "まったくよ…。"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "調子に乗って、\n凄い沖の方まで\n泳いでおきながら――"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "戻るときのことを\n考えてなかったとか、\nありえないでしょ？"},
        { "location": "133/TALK"  , "narrator": "つばめ", "text": "そ、そうだよね。"},
        { "location": "134/TALK"  , "narrator": "つばめ", "text": "ガブちゃんが\n一緒にいてくれな\nかったら――"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "今頃、もっと沖まで\n流されてたよ。"},
        { "location": "137/TALK"  , "narrator": "つばめ", "text": "ありがと、\nガブちゃん。"},
        { "location": "138/TALK"  , "narrator": "つばめ", "text": "わたしのこと、\nずっと引っ張って\n泳いでくれて…。"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "べ、別にいいわよ。\nお礼言われるほどの\nことでもないし…。"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "それに、あの状況じゃ\n放っておけないわ。"},
        { "location": "143/TALK"  , "narrator": "つばめ", "text": "ガブちゃんは\n優しいね。"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "も、もういいってば！\nちょっと休むから、\n静かにしてて！"},
        { "location": "162/ACT"   , "narrator": "", "text": "砂浜で遊ぼう"},
        { "location": "182/TALK"  , "narrator": "つばめ", "text": "そういえば、やってみたかった遊びがあるの！"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "…気付いてなかった\nみたいね。"},
        { "location": "197/TALK"  , "narrator": "つばめ", "text": "そ、それよりガブちゃん。\nこの後って、まだ海に\n入る？"},
        { "location": "198/TALK"  , "narrator": "ガブリエラ", "text": "う～ん…どうかしら？\nもう十分遊んだ気も\nするし…。"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "もしよければ、\n砂のお城を作るの\n手伝ってほしいの。"},
        { "location": "201/TALK"  , "narrator": "ガブリエラ", "text": "砂の城って、どうやって\n作ればいいのかしら？"},
        { "location": "203/TALK"  , "narrator": "神楽", "text": "さあ？　私も作ったこと\n無いからわかりません\nけど――"},
        { "location": "204/TALK"  , "narrator": "神楽", "text": "簡単じゃないとは\n思いますよ？"},
        { "location": "206/TALK"  , "narrator": "ガブリエラ", "text": "つばめ、あんたそんなに\n砂の城作りたいの？"},
        { "location": "207/TALK"  , "narrator": "つばめ", "text": "わたし達の他には\n誰もいないんだよ？"},
        { "location": "208/TALK"  , "narrator": "つばめ", "text": "邪魔にならないように、\nとか気にしないで、\n大きいの作れそうだし。"},
        { "location": "210/TALK"  , "narrator": "ガブリエラ", "text": "なるほど…それは確かに\nチャンスよね…。"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "よし、決めた！\nあたしもお城作り手伝う！"},
        { "location": "214/TALK"  , "narrator": "つばめ", "text": "えっ、いいの！？"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "こんなチャンス、\n滅多にないもの。"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "神楽も手伝ってよ？\nどうせなら人数多い方が\n早く作れるし。"},
        { "location": "221/TALK"  , "narrator": "神楽", "text": "わかりました。"},
        { "location": "224/TALK"  , "narrator": "つばめ", "text": "よろしくね、卯月さん。"},
        { "location": "225/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "さっさと始めるわよ。\n暗くなるまえに、\nどうにか形にしたいし！"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "やった、完成－！"},
        { "location": "246/TALK"  , "narrator": "ガブリエラ", "text": "ふぅ…どうにか日没までに\n間に合ったわね。"},
        { "location": "247/TALK"  , "narrator": "ガブリエラ", "text": "…ちょっと、小ぢんまりと\nしたお城になっちゃった\nけど。"},
        { "location": "249/TALK"  , "narrator": "神楽", "text": "初心者なんだから、\nそれは仕方ないですよ。"},
        { "location": "250/TALK"  , "narrator": "つばめ", "text": "小さくてもいいの。\n三人で作った自慢の\nお城だもん。"},
        { "location": "254/TALK"  , "narrator": "真幌", "text": "おまえら、\nまだ遊んでるのか？"},
        { "location": "256/TALK"  , "narrator": "つばめ", "text": "あ、真幌さん。"},
        { "location": "257/TALK"  , "narrator": "真幌", "text": "遅くなると明日に\n疲れが残るぞ。\n暗くなる前に家に戻れ。"},
        { "location": "259/TALK"  , "narrator": "ガブリエラ", "text": "そんなことより、\nちょっとこれ見てよ！"},
        { "location": "260/TALK"  , "narrator": "真幌", "text": "ん…？\nこれは、砂の城か？"},
        { "location": "262/TALK"  , "narrator": "つばめ", "text": "はい。三人で力を合わせて\n作ったんです！"},
        { "location": "265/TALK"  , "narrator": "神楽", "text": "思ったより大変でした\nけど、楽しかったですね。"},
        { "location": "266/TALK"  , "narrator": "つばめ", "text": "うん！"},
        { "location": "267/TALK"  , "narrator": "真幌", "text": "…おまえら、まさかずっと\nこれを作ってたのか？"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "そうよ。\n中々砂が固まらなくて\n苦労したんだから。"},
        { "location": "269/TALK"  , "narrator": "真幌", "text": "それはわかるが――"},
        { "location": "270/TALK"  , "narrator": "真幌", "text": "年頃の女子中高生が、\n海に来て砂の城作りに\n夢中になるってのは――"},
        { "location": "271/TALK"  , "narrator": "真幌", "text": "正直、どうなんだ？"},
        { "location": "273/TALK"  , "narrator": "つばめ", "text": "えっ？"},
        { "location": "274/TALK"  , "narrator": "真幌", "text": "いや、まあおまえらが\n楽しかったというなら、\n別に良いんだがな。"},
        { "location": "275/TALK"  , "narrator": "真幌", "text": "ほら、とにかくもう戻れ。\n夕飯に遅れるぞ。"},
        { "location": "280/TALK"  , "narrator": "つばめ", "text": "…なんか、呆れられ\nちゃったかな？"},
        { "location": "281/TALK"  , "narrator": "神楽", "text": "仕方ないですよ。\n私も、つい夢中になって\nしまいましたけど――"},
        { "location": "282/TALK"  , "narrator": "神楽", "text": "どうして半日もかけて、\n砂のお城づくりしてたのか\nわからないですし…。"},
        { "location": "283/TALK"  , "narrator": "ガブリエラ", "text": "あたしも、正直一時間\nくらいでやめようかな、\nって思ってたのに。"},
        { "location": "286/TALK"  , "narrator": "つばめ", "text": "ご、ごめんね。\nわたしがお城作りたい、\nなんて言ったから…。"},
        { "location": "288/TALK"  , "narrator": "神楽", "text": "…いえ、良いんです。"},
        { "location": "289/TALK"  , "narrator": "神楽", "text": "それに、こういうのって\n初めてだったから、\n結構楽しかったです。"},
        { "location": "20/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月21日　 2:16 PM</color>\n合宿中、みやびの実家付近の砂浜でのこと"},
        { "location": "156/DIALOG", "narrator": "Dialog_GEThimegoto_ch01", "text": "【畳水練準4級】"}
    ]
}
