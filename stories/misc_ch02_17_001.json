        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "そういう港じゃないんだけど"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "通じなかったみたいね(;^_^A"},
        { "location": "47/ACT"    , "narrator": "", "text": "横浜とか神戸とかいいよね"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "そうなの"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "おしゃれだし"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "歴史もあるし"},
        { "location": "54/SEL"    , "narrator": "", "text": "また行こうね"},
        { "location": "55/SEL"    , "narrator": "", "text": "案内してよ"},
        { "location": "56/ACT"    , "narrator": "", "text": "また行こうね"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "またって"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "言ったことあるみたいじゃない"},
