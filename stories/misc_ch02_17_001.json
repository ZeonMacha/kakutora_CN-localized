        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "楽しいかもね"},
        { "location": "64/ACT"    , "narrator": "", "text": "案内してよ"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "私も詳しくないわよ"},
