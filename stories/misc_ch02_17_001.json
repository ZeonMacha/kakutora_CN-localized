        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "工ｴｴｪｪ(´д｀)ｪｪｴｴ工"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "そんなことないと思うわよ"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "ドラマとかで"},
