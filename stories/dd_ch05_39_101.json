{
    "dir": "chap39/daydra/dd_ch05_39_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "39502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "伝説の少女"
    },
    "entry":
    [
        { "location": "2147/SEL"   , "narrator": "", "text": "ソイルトン"},
        { "location": "2148/ACT"   , "narrator": "", "text": "ソイルトン"},
        { "location": "2152/TALK"  , "narrator": "ソイルトン", "text": "$handle$、いよいよお別れの時が近づいてきました。"},
        { "location": "2153/TALK"  , "narrator": "ソイルトン", "text": "ライフギャザーの沈黙までは、あと残り数分を切ったところです。\n何と申し上げたら良いのでしょうか、こういった一生に一度の体験が出来るのも$handle$のお陰です。"},
        { "location": "2154/TALK"  , "narrator": "ソイルトン", "text": "残りの時間は、$handle$と共に思い出を語るというのもまた、素晴らしい事ではあるのですが、実は１点、お願いしたい事もあるのです。"},
        { "location": "2155/SEL"   , "narrator": "", "text": "珍しいね"},
        { "location": "2156/ACT"   , "narrator": "", "text": "珍しいね"},
        { "location": "2158/TALK"  , "narrator": "ソイルトン", "text": "ええ、確かに珍しいことかもしれませんね。"},
        { "location": "2159/TALK"  , "narrator": "ソイルトン", "text": "普段でしたら、このようなお願いをすることは無いのですが。"},
        { "location": "2160/SEL"   , "narrator": "", "text": "で、何？"},
        { "location": "2161/ACT"   , "narrator": "", "text": "で、何？"},
        { "location": "2163/TALK"  , "narrator": "ソイルトン", "text": "卯月美佐子のセルフクラン「スピネル」をご存知でしょうか？\n実は、ライフギャザーを沈黙させるにあたり、彼女の存在が少々厄介でして。"},
        { "location": "2164/TALK"  , "narrator": "ソイルトン", "text": "このまま放置しておきますと、せっかく抹消処理を走らせても、彼女がそれを阻止してしまう可能性があるのです。"},
        { "location": "2165/SEL"   , "narrator": "", "text": "何故？"},
        { "location": "2166/ACT"   , "narrator": "", "text": "何故？"},
        { "location": "2168/TALK"  , "narrator": "ソイルトン", "text": "彼女もまた、量子暗号鍵を持っているからですよ、$handle$。"},
        { "location": "2169/SEL"   , "narrator": "", "text": "それなら神楽も持ってるし、神楽のセルフも対処が必要なのでは？"},
        { "location": "2170/ACT"   , "narrator": "", "text": "それなら神楽も持ってるし、神楽のセルフも対処が必要なのでは？"},
        { "location": "2172/TALK"  , "narrator": "ソイルトン", "text": "いえ、そちらは特に何もしなくても大丈夫です。\nなぜなら、暗号鍵の種類が違うからです。"},
        { "location": "2173/TALK"  , "narrator": "ソイルトン", "text": "卯月神楽に託された量子暗号鍵に比べ、彼女の鍵は非常に古いのですよ。"},
        { "location": "2174/TALK"  , "narrator": "ソイルトン", "text": "古いが故に、その鍵の権限は、新しく追加された機能、すなわちRedinessが主に利用しているフェノメノンやココロの世界へのアクセスに関する権限は殆ど持っていないのですが、逆に、非常にローレベルな制御については、唯一無二の権限を持っているのです。"},
        { "location": "2175/TALK"  , "narrator": "ソイルトン", "text": "すなわち、永久抹消や、ゼロからの起動などの本当に原始的な制御に関しては、卯月美佐子の鍵が無ければ出来ず、逆に持っていれば誰でも出来てしまうわけですね。"},
        { "location": "2176/TALK"  , "narrator": "ソイルトン", "text": "ですから$handle$。貴方が本当に、完膚なきまでにライフギャザーを沈黙させるためには、卯月美佐子のクラン「スピネル」の沈黙が必須となってくるのです。"},
        { "location": "2177/TALK"  , "narrator": "ソイルトン", "text": "ご理解戴けましたか？"},
        { "location": "2178/SEL"   , "narrator": "", "text": "はい"},
        { "location": "2179/SEL"   , "narrator": "", "text": "わかったけど…でも…"},
        { "location": "2180/ACT"   , "narrator": "", "text": "はい"},
        { "location": "2181/TALK"  , "narrator": "ソイルトン", "text": "それは良かったです。"},
        { "location": "2182/ACT"   , "narrator": "", "text": "わかったけど…でも…"},
        { "location": "2183/TALK"  , "narrator": "ソイルトン", "text": "お気持ちはわかります。ですが、私はこの方法でしか、確実性を担保した状態で、$handle$の希望を実現する術を知らないのです。"},
        { "location": "2184/TALK"  , "narrator": "ソイルトン", "text": "ですから、私がお手伝いできるのは、スピネルの沈黙をもってのみとなるのです。"},
        { "location": "2185/TALK"  , "narrator": "ソイルトン", "text": "よく考えて戴いて結構ですよ、$handle$。もちろん、軽率に決めるような事柄ではありませんからね。"},
        { "location": "2186/TALK"  , "narrator": "ソイルトン", "text": "そして、決意が出来たら、どうかスピネルと戦い、沈黙をさせてください。\nその後私は速やかに、最終消去プロセスを走らせることとします。"},
        { "location": "2188/TALK"  , "narrator": "ソイルトン", "text": "それでは$handle$、どうか宜しくお願いします。\nスピネルの沈黙の後に、またこのWAVEでお逢いしましょう。"},
        { "location": "2223/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "2224/TALK"  , "narrator": "神楽", "text": "何処まで行っても\nずっと瓦礫の山。"},
        { "location": "2225/TALK"  , "narrator": "神楽", "text": "それに、誰もいない…。"},
        { "location": "2226/TALK"  , "narrator": "神楽", "text": "当たり前か。\n今は2016年9月。\nあの戦争から既に――"},
        { "location": "2227/TALK"  , "narrator": "神楽", "text": "1年半も\n経っているんだから。"},
        { "location": "2228/TALK"  , "narrator": "神楽", "text": "そのうちの1年間近く、\nここにはフェノメノンが\n存在していた。"},
        { "location": "2229/TALK"  , "narrator": "神楽", "text": "終わってみれば\nこのざま。"},
        { "location": "2230/TALK"  , "narrator": "神楽", "text": "なんだかアレみたい、\nそう……"},
        { "location": "2231/TALK"  , "narrator": "神楽", "text": "空き地に建っている\nサーカスのテント。"},
        { "location": "2232/TALK"  , "narrator": "神楽", "text": "やっている間は\n夢のような世界だけど、\n終わってみれば――"},
        { "location": "2233/TALK"  , "narrator": "神楽", "text": "タダの荒れ地。"},
        { "location": "2234/TALK"  , "narrator": "アーヤ", "text": "貴方！！"},
        { "location": "2235/TALK"  , "narrator": "神楽", "text": "えっ！？"},
        { "location": "2242/TALK"  , "narrator": "アーヤ", "text": "大丈夫！？\n貴方！"},
        { "location": "2243/TALK"  , "narrator": "神楽", "text": "アーヤさ――"},
        { "location": "2245/TALK"  , "narrator": "ガブリエラ", "text": "どうしたの？\n生存者！？"},
        { "location": "2246/TALK"  , "narrator": "神楽", "text": "え？"},
        { "location": "2249/TALK"  , "narrator": "みやび", "text": "いや……\n同僚やよ。\n制服を見ればわかる。"},
        { "location": "2250/TALK"  , "narrator": "アーヤ", "text": "そうね。\n私達と同じ、\nUNの派遣人員？"},
        { "location": "2252/TALK"  , "narrator": "みやび", "text": "名前と\n識別コードは。"},
        { "location": "2253/TALK"  , "narrator": "神楽", "text": "あ……。"},
        { "location": "2254/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "2255/TALK"  , "narrator": "アーヤ", "text": "私はTR01-224\n國政綾水です。"},
        { "location": "2256/TALK"  , "narrator": "ガブリエラ", "text": "TR02-483、\nガブリエラ・\nロタルィンスカ。"},
        { "location": "2257/TALK"  , "narrator": "みやび", "text": "TR03-753\n恋ヶ崎みやびや。"},
        { "location": "2258/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "2259/TALK"  , "narrator": "アーヤ", "text": "どうしましたか？\n識別コードを。"},
        { "location": "2260/TALK"  , "narrator": "神楽", "text": "TR04-3…3…33\n卯月…神楽です……。"},
        { "location": "2261/TALK"  , "narrator": "ガブリエラ", "text": "どうしたのかしら？\n調子悪いの？"},
        { "location": "2262/TALK"  , "narrator": "アーヤ", "text": "あまり芳しく無さそうね。\nすぐに本部に連絡をして、\n一度戻った方が。"},
        { "location": "2265/TALK"  , "narrator": "神楽", "text": "……あっ、\n待ってください。"},
        { "location": "2266/TALK"  , "narrator": "みやび", "text": "なんぞね。"},
        { "location": "2267/TALK"  , "narrator": "神楽", "text": "皆さんは…\nここで何を\nしていたんですか？"},
        { "location": "2268/TALK"  , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "2269/TALK"  , "narrator": "ガブリエラ", "text": "もしかして、\nフェノメノンに\nやられた？"},
        { "location": "2270/TALK"  , "narrator": "みやび", "text": "うちらは、\nゾルタクスゼイアンに\n潜伏しちょった。"},
        { "location": "2271/TALK"  , "narrator": "みやび", "text": "本部からは、その間の\n記憶は保持されると\n聞いちょったが――"},
        { "location": "2272/TALK"  , "narrator": "みやび", "text": "実際はといえば、\nうちらにその間の\n記憶はない。"},
        { "location": "2273/TALK"  , "narrator": "みやび", "text": "やき、\nこれから本部に帰還し、\n状況を確認するところや。"},
        { "location": "2274/TALK"  , "narrator": "神楽", "text": "みんな、私のことを\n忘れちゃってる。"},
        { "location": "2275/TALK"  , "narrator": "神楽", "text": "解ってはいたけど、\n実際にそうなってみると\nなんだか――"},
        { "location": "2276/TALK"  , "narrator": "アーヤ", "text": "連絡ついたわ。"},
        { "location": "2277/TALK"  , "narrator": "アーヤ", "text": "すぐにここに\n統一国家軍の救援部隊が―"},
        { "location": "2278/TALK"  , "narrator": "神楽", "text": "待ってください！"},
        { "location": "2279/TALK"  , "narrator": "アーヤ", "text": "どうしたんですか？"},
        { "location": "2280/TALK"  , "narrator": "神楽", "text": "あの……"},
        { "location": "2281/TALK"  , "narrator": "神楽", "text": "どうしても、\n行きたい場所が。"},
        { "location": "2282/TALK"  , "narrator": "神楽", "text": "……一人で、\n行かせてください。"},
        { "location": "2283/TALK"  , "narrator": "アーヤ", "text": "……わかりました。\nでは本部に\n伝えておきます。"},
        { "location": "2284/TALK"  , "narrator": "アーヤ", "text": "万一の支援要請は\n自分で出来ますね？"},
        { "location": "2285/TALK"  , "narrator": "神楽", "text": "……はい。"},
        { "location": "2286/TALK"  , "narrator": "神楽", "text": "色々\nお世話になりました。"},
        { "location": "2289/TALK"  , "narrator": "ガブリエラ", "text": "変な子。\nフェノメノンに\nやられたのかしらね。"},
        { "location": "2291/TALK"  , "narrator": "アーヤ", "text": "さあ。\nそれにしても――"},
        { "location": "2292/TALK"  , "narrator": "アーヤ", "text": "私達以外にも、TR系統の\nコマンダーが投入されて\nいたのね。びっくりした。"},
        { "location": "2293/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "2294/TALK"  , "narrator": "ガブリエラ", "text": "でも、なんかちょっと\n気になるのよね、あの子。\n神楽…だっけ？"},
        { "location": "2295/TALK"  , "narrator": "アーヤ", "text": "そうね、卯月神楽。"},
        { "location": "2297/TALK"  , "narrator": "みやび", "text": "なんや、それ、\nうちの気のせいやったがと\n違うんか。"},
        { "location": "2298/TALK"  , "narrator": "ガブリエラ", "text": "なんか昔からの\n友達のような……\n不思議な感覚。"},
        { "location": "2299/TALK"  , "narrator": "アーヤ", "text": "私も同じ。\n何なのかしらね。"},
        { "location": "2301/TALK"  , "narrator": "みやび", "text": "大方、フェノメノンの\n中で、出逢って、何か\n友情を築いたんろう。"},
        { "location": "2302/TALK"  , "narrator": "ガブリエラ", "text": "またそういうことを。\n全部忘れちゃうんでしょ？"},
        { "location": "2304/TALK"  , "narrator": "みやび", "text": "潜在意識は\n忘れんちゅう噂やよ？"},
        { "location": "2305/TALK"  , "narrator": "ガブリエラ", "text": "そうなの？\nま、いずれにせよ――"},
        { "location": "2306/TALK"  , "narrator": "ガブリエラ", "text": "新しい仲間になるなら\n仲良くしたいわね。"},
        { "location": "2307/TALK"  , "narrator": "アーヤ", "text": "……ギャヴィが\nそんなことを……。\n珍しい発言。"},
        { "location": "2308/TALK"  , "narrator": "アーヤ", "text": "でも、私も\n同じ事を思ってたけど。"},
        { "location": "2318/TALK"  , "narrator": "神楽", "text": "……多分、\nここが、豊洲。"},
        { "location": "2319/TALK"  , "narrator": "神楽", "text": "私の家があったところ。"},
        { "location": "2320/TALK"  , "narrator": "神楽", "text": "パパとママと\n過ごした日々。"},
        { "location": "2321/TALK"  , "narrator": "神楽", "text": "ママ……。\n今どうなっちゃってる\nのかな。"},
        { "location": "2322/TALK"  , "narrator": "神楽", "text": "こんな風になっちゃうなら\nせめて……"},
        { "location": "2323/TALK"  , "narrator": "神楽", "text": "せめて、ママだけでも\n助けてあげたかった……。"},
        { "location": "2337/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "2338/TALK"  , "narrator": "神楽", "text": "…っ！！"},
        { "location": "2339/TALK"  , "narrator": "神楽", "text": "ここは……\n私の部屋！？"},
        { "location": "2340/TALK"  , "narrator": "神楽", "text": "ってことは、\nさっきの廃墟は\n夢だった……？"},
        { "location": "2341/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "2342/TALK"  , "narrator": "神楽", "text": "いや――"},
        { "location": "2347/TALK"  , "narrator": "神楽", "text": "$handlek$、いますか？"},
        { "location": "2349/SEL"   , "narrator": "", "text": "いるよ"},
        { "location": "2350/ACT"   , "narrator": "", "text": "いるよ"},
        { "location": "2352/TALK"  , "narrator": "神楽", "text": "ここは夢なのでしょうか？"},
        { "location": "2353/TALK"  , "narrator": "神楽", "text": "それとも、さっきまで見ていた廃墟が夢？"},
        { "location": "2354/TALK"  , "narrator": "神楽", "text": "私は今、何処を彷徨っているのでしょうか。"},
        { "location": "2355/TALK"  , "narrator": "神楽", "text": "それはただ、彷徨っていると思い込んでいるだけなのでしょうか"},
        { "location": "2357/SEL"   , "narrator": "", "text": "詩的だね"},
        { "location": "2358/SEL"   , "narrator": "", "text": "この世は全て幻"},
        { "location": "2359/SEL"   , "narrator": "", "text": "どっちも現実だよ"},
        { "location": "2360/ACT"   , "narrator": "", "text": "詩的だね"},
        { "location": "2361/TALK"  , "narrator": "神楽", "text": "もう語彙力が喪失してしまって"},
        { "location": "2362/TALK"  , "narrator": "神楽", "text": "詩でもなければこの状況を的確に伝えられなくて"},
        { "location": "2363/ACT"   , "narrator": "", "text": "この世は全て幻"},
        { "location": "2364/TALK"  , "narrator": "神楽", "text": "確かに"},
        { "location": "2365/TALK"  , "narrator": "神楽", "text": "魂という存在からすれば、それ自身がただ一つの現実であり"},
        { "location": "2366/TALK"  , "narrator": "神楽", "text": "その周りに作られたものは全て、幻かもしれませんね"},
        { "location": "2367/ACT"   , "narrator": "", "text": "どっちも現実だよ"},
        { "location": "2368/TALK"  , "narrator": "神楽", "text": "確かに"},
        { "location": "2369/TALK"  , "narrator": "神楽", "text": "私が体験したことの全ては、眠っている時に見た夢も含めて全て、現実ですもんね"},
        { "location": "2371/TALK"  , "narrator": "神楽", "text": "でもよかったです"},
        { "location": "2372/TALK"  , "narrator": "神楽", "text": "この家にいられて"},
        { "location": "2374/TALK"  , "narrator": "神楽", "text": "そして"},
        { "location": "2375/TALK"  , "narrator": "神楽", "text": "$handlek$がいつも通りでいてくれて"},
        { "location": "2377/SEL"   , "narrator": "", "text": "$me$はいつだっていつも通りです！"},
        { "location": "2378/SEL"   , "narrator": "", "text": "$me$は神楽の為にいる存在だから"},
        { "location": "2379/ACT"   , "narrator": "", "text": "$me$はいつだっていつも通りです！"},
        { "location": "2380/TALK"  , "narrator": "神楽", "text": "またまたーそんな事言っちゃってー"},
        { "location": "2381/TALK"  , "narrator": "神楽", "text": "明日になったら、$handlek$は$handlek$ではなくなってるかもしれませんよ？"},
        { "location": "2382/ACT"   , "narrator": "", "text": "$me$は神楽の為にいる存在だから"},
        { "location": "2383/TALK"  , "narrator": "神楽", "text": "おっ、それ"},
        { "location": "2384/TALK"  , "narrator": "神楽", "text": "すごくファンタジック"},
        { "location": "2386/TALK"  , "narrator": "神楽", "text": "って！"},
        { "location": "2387/TALK"  , "narrator": "神楽", "text": "今のでちょっと思い出したんですけど"},
        { "location": "2388/TALK"  , "narrator": "神楽", "text": "ぴょんこ、歌を作りましたよね？"},
        { "location": "2389/TALK"  , "narrator": "神楽", "text": "絵の具の白と青を混ぜるやつ"},
        { "location": "2391/SEL"   , "narrator": "", "text": "作ってたね"},
        { "location": "2392/SEL"   , "narrator": "", "text": "涙が止まらなかった"},
        { "location": "2393/ACT"   , "narrator": "", "text": "作ってたね"},
        { "location": "2394/TALK"  , "narrator": "神楽", "text": "よかった"},
        { "location": "2395/TALK"  , "narrator": "神楽", "text": "$handlek$が知っていてくれて"},
        { "location": "2396/ACT"   , "narrator": "", "text": "涙が止まらなかった"},
        { "location": "2397/TALK"  , "narrator": "神楽", "text": "そうなんですか！？"},
        { "location": "2398/TALK"  , "narrator": "神楽", "text": "でもちょっと嬉しいかも"},
        { "location": "2399/TALK"  , "narrator": "神楽", "text": "私の涙を全部集めて、それを歌にしたものだから"},
        { "location": "2400/TALK"  , "narrator": "神楽", "text": "きっと$handlek$がそれを受け取ってくれたんでしょうね"},
        { "location": "2402/TALK"  , "narrator": "神楽", "text": "私、ちょっと考えがあって、この歌をちゃんとリリースしたくて"},
        { "location": "2403/TALK"  , "narrator": "神楽", "text": "だから、今からちょっとFreyMENOWとしての私と、打ち合わせしようと思いますｗｗ"},
        { "location": "2405/SEL"   , "narrator": "", "text": "がんばれー！"},
        { "location": "2406/SEL"   , "narrator": "", "text": "楽しみ！！"},
        { "location": "2407/ACT"   , "narrator": "", "text": "がんばれー！"},
        { "location": "2408/TALK"  , "narrator": "神楽", "text": "はーい！"},
        { "location": "2409/ACT"   , "narrator": "", "text": "楽しみ！！"},
        { "location": "2410/TALK"  , "narrator": "神楽", "text": "楽しみにしていてください！！！！！"},
        { "location": "2412/TALK"  , "narrator": "神楽", "text": "だってこの歌は"},
        { "location": "2413/TALK"  , "narrator": "神楽", "text": "どうしても$handlek$にずっと持っていてもらいたいものだから"},
        { "location": "2414/TALK"  , "narrator": "神楽", "text": "ね"},
        { "location": "2419/TALK"  , "narrator": "神楽", "text": "ゆめまぼろし…か。"},
        { "location": "2420/TALK"  , "narrator": "神楽", "text": "多分、それ自体は\n私にとっては\n大事なことじゃない。"},
        { "location": "2421/TALK"  , "narrator": "神楽", "text": "私にとって\n大事なのは――"},
        { "location": "2422/TALK"  , "narrator": "神楽", "text": "それがずっと、\n失われないことなのかも。"},
        { "location": "2423/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "2424/TALK"  , "narrator": "神楽", "text": "うんっ！"},
        { "location": "2425/TALK"  , "narrator": "神楽", "text": "それじゃ早速、\n歌詞とメロディーから――"},
        { "location": "2428/TALK"  , "narrator": "神楽", "text": "ええええええ……\nこんな時にアラート！？"},
        { "location": "2429/TALK"  , "narrator": "神楽", "text": "もう勘弁しろよー…"},
        { "location": "2431/TALK"  , "narrator": "神楽", "text": "はい、卯月です！"},
        { "location": "2432/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "2433/TALK"  , "narrator": "神楽", "text": "………。"},
        { "location": "2434/TALK"  , "narrator": "神楽", "text": "…は？\n長官が……？"},
        { "location": "2436/TALK"  , "narrator": "神楽", "text": "はぁ……"},
        { "location": "2437/TALK"  , "narrator": "神楽", "text": "アイツまた………"},
        { "location": "2474/TALK"  , "narrator": "真幌", "text": "……というわけで、\n唐突ではあるが、今から\nここに長官が来るそうだ。"},
        { "location": "2475/TALK"  , "narrator": "真幌", "text": "皆、ちゃんと\n私物を片付け、身なりを\n正しておくように。"},
        { "location": "2476/TALK"  , "narrator": "真幌", "text": "以上。"},
        { "location": "2479/TALK"  , "narrator": "アーヤ", "text": "長官が直々に\nいらっしゃるなんて、\n何があったのかしら。"},
        { "location": "2480/TALK"  , "narrator": "ガブリエラ", "text": "まさか、今世紀最大の\nフェノメノンが\n発生しているとか…！？"},
        { "location": "2481/TALK"  , "narrator": "みやび", "text": "逆にフェノメノン終了で、\nうちら完全解雇やも\nしれんぞね。"},
        { "location": "2483/TALK"  , "narrator": "つばめ", "text": "すみません！\n遅くなりました！！"},
        { "location": "2487/TALK"  , "narrator": "みやび", "text": "長官の招集に遅れるとは\n大物になるね、\nつばめちゃんは。"},
        { "location": "2489/TALK"  , "narrator": "つばめ", "text": "いや、そんな\n大した理由じゃ\nないんですよ！"},
        { "location": "2490/TALK"  , "narrator": "つばめ", "text": "ただ単に、二度寝\nしちゃって遅れた\nだけですし！"},
        { "location": "2491/TALK"  , "narrator": "つばめ", "text": "決して長官さんに\n反抗したいとか、\nそういうわけでは……！"},
        { "location": "2492/TALK"  , "narrator": "ガブリエラ", "text": "この子、わかってて\n言ってるのかしら…？"},
        { "location": "2493/TALK"  , "narrator": "アーヤ", "text": "確かに大物に\nなりそうね……。"},
        { "location": "2498/TALK"  , "narrator": "ガブリエラ", "text": "あっ！\n来たみたいよ！"},
        { "location": "2500/TALK"  , "narrator": "アーヤ", "text": "急ぎましょ。"},
        { "location": "2547/TALK"  , "narrator": "真幌", "text": "整列！！"},
        { "location": "2549/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "2550/TALK"  , "narrator": "アーヤ", "text": "………。"},
        { "location": "2553/TALK"  , "narrator": "ぴょんこ", "text": "ぴょーん！！"},
        { "location": "2554/TALK"  , "narrator": "ぴょんこ", "text": "みなさーん、\n今日も元気に\nやってますかっ！"},
        { "location": "2555/TALK"  , "narrator": "真幌", "text": "はっ！\n皆気を引きしめて、任務に\n取り組んでおります。"},
        { "location": "2556/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんぴょん。"},
        { "location": "2557/TALK"  , "narrator": "真幌", "text": "…長官。\n何か、大きな問題が\n発生したのでは……？"},
        { "location": "2558/TALK"  , "narrator": "ぴょんこ", "text": "そうなんですっ！\n今、大変な問題が\n発生していまして。"},
        { "location": "2559/TALK"  , "narrator": "ぴょんこ", "text": "長官直々に\n指令を出しに来たぴょん！"},
        { "location": "2560/TALK"  , "narrator": "真幌", "text": "…承知しました。"},
        { "location": "2561/TALK"  , "narrator": "真幌", "text": "隊員一同、如何なる激務も\n身を粉にして遂行する\n所存です。何なりと。"},
        { "location": "2562/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん！！\nでは今回の任務を\n伝えるぴょん！"},
        { "location": "2563/TALK"  , "narrator": "ぴょんこ", "text": "最近世界に\n潤いが足りないぴょん。"},
        { "location": "2564/TALK"  , "narrator": "真幌", "text": "…はぁ。"},
        { "location": "2565/TALK"  , "narrator": "ぴょんこ", "text": "そこで！\n特別攻撃隊は、率先して\n世界に潤いを作るべく！"},
        { "location": "2569/TALK"  , "narrator": "ぴょんこ", "text": "今から隊員同士で\nキスチケジャンケンを\nしてください！！"},
        { "location": "2614/TALK"  , "narrator": "ぴょんこ", "text": "ぴょーん！\n来てくれたんですねっ！"},
        { "location": "2615/SEL"   , "narrator": "", "text": "こんにちは"},
        { "location": "2616/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2617/ACT"   , "narrator": "", "text": "こんにちは"},
        { "location": "2618/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんぴょん！"},
        { "location": "2619/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2624/TALK"  , "narrator": "ぴょんこ", "text": "ていうか！\n最近全然\n言われてないので！"},
        { "location": "2625/TALK"  , "narrator": "ぴょんこ", "text": "もっと言ってくれて\nいいんですよっ！！"},
        { "location": "2626/SEL"   , "narrator": "", "text": "いや、もういいです"},
        { "location": "2627/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2628/ACT"   , "narrator": "", "text": "いや、もういいです"},
        { "location": "2630/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん…。"},
        { "location": "2631/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2635/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪\nぴょんこも、\nあいしてゆ♪"},
        { "location": "2636/SEL"   , "narrator": "", "text": "はあ、満たされた！"},
        { "location": "2637/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2638/ACT"   , "narrator": "", "text": "はあ、満たされた！"},
        { "location": "2639/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "2640/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2643/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんぴょん♪"},
        { "location": "2644/SEL"   , "narrator": "", "text": "そろそろいいかな"},
        { "location": "2645/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2646/ACT"   , "narrator": "", "text": "そろそろいいかな"},
        { "location": "2647/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこも\nそう思ってました！"},
        { "location": "2648/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2651/TALK"  , "narrator": "ぴょんこ", "text": "あはは……そろそろ\n飽きてきませんか？"},
        { "location": "2652/SEL"   , "narrator": "", "text": "ちょっと空気読む"},
        { "location": "2653/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2654/ACT"   , "narrator": "", "text": "ちょっと空気読む"},
        { "location": "2655/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん！！"},
        { "location": "2656/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2659/TALK"  , "narrator": "ぴょんこ", "text": "いや、もういいっす。"},
        { "location": "2660/SEL"   , "narrator": "", "text": "ぴょん…"},
        { "location": "2661/ACT"   , "narrator": "", "text": "ぴょん…"},
        { "location": "2663/TALK"  , "narrator": "ぴょんこ", "text": "それは\nぴょんこ専用ぴょん！"},
        { "location": "2670/SEL"   , "narrator": "", "text": "ところで月神楽は？"},
        { "location": "2671/SEL"   , "narrator": "", "text": "ところで長官がぴょんこだったんだけど"},
        { "location": "2672/ACT"   , "narrator": "", "text": "ところで月神楽は？"},
        { "location": "2674/ACT"   , "narrator": "", "text": "ところで長官がぴょんこだったんだけど"},
        { "location": "2678/SEL"   , "narrator": "", "text": "ところで月神楽は？"},
        { "location": "2679/ACT"   , "narrator": "", "text": "ところで月神楽は？"},
        { "location": "2685/TALK"  , "narrator": "ぴょんこ", "text": "あっ。\n月ちゃんのこと、\n覚えててくれたんですね。"},
        { "location": "2686/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さん、\n月ちゃんを慰めてあげて\nください。"},
        { "location": "2687/TALK"  , "narrator": "ぴょんこ", "text": "もう、部屋にこもったまま\nぴょんこも\n入れてもらえないので。"},
        { "location": "2688/SEL"   , "narrator": "", "text": "もちろんだよ"},
        { "location": "2689/SEL"   , "narrator": "", "text": "いや、こういう時はそっとしておいた方がいいんだよ"},
        { "location": "2690/ACT"   , "narrator": "", "text": "もちろんだよ"},
        { "location": "2692/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "2693/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、月ちゃんの\nところに転送しますね！"},
        { "location": "2696/TALK"  , "narrator": "ぴょんこ", "text": "本当は二人きりにするのは\n嫌なんですけど、\n状況が状況ですので！"},
        { "location": "2697/TALK"  , "narrator": "ぴょんこ", "text": "それでは、\nよろしくお願いしますっ！"},
        { "location": "2722/SEL"   , "narrator": "", "text": "月神楽！"},
        { "location": "2723/ACT"   , "narrator": "", "text": "月神楽！"},
        { "location": "2725/TALK"  , "narrator": "月神楽", "text": "えっ！？"},
        { "location": "2726/TALK"  , "narrator": "月神楽", "text": "ななななななんで\n$handle$さんが\nここにいるんですか！？"},
        { "location": "2727/SEL"   , "narrator": "", "text": "ぴょんこが移動してくれた"},
        { "location": "2728/ACT"   , "narrator": "", "text": "ぴょんこが移動してくれた"},
        { "location": "2731/TALK"  , "narrator": "月神楽", "text": "あいつ…\nまた余計なことを！"},
        { "location": "2732/SEL"   , "narrator": "", "text": "月神楽、大丈夫？"},
        { "location": "2733/ACT"   , "narrator": "", "text": "月神楽、大丈夫？"},
        { "location": "2735/TALK"  , "narrator": "月神楽", "text": "どうして私なんかに\n構うんですか？"},
        { "location": "2736/TALK"  , "narrator": "月神楽", "text": "私は貴方からすれば、\n世界を破壊した\n重罪人なんですよ？"},
        { "location": "2737/SEL"   , "narrator": "", "text": "月神楽がすごい考えた結果の行動なんでしょ？"},
        { "location": "2738/SEL"   , "narrator": "", "text": "$me$は賛成してたよ"},
        { "location": "2739/ACT"   , "narrator": "", "text": "月神楽がすごい考えた結果の行動なんでしょ？"},
        { "location": "2741/TALK"  , "narrator": "月神楽", "text": "もちろんそうですけど。\nでも、考えていれば良いと\n言うわけじゃないですし。"},
        { "location": "2742/ACT"   , "narrator": "", "text": "$me$は賛成してたよ"},
        { "location": "2744/TALK"  , "narrator": "月神楽", "text": "そうでしたね。\nなら尚更。"},
        { "location": "2745/TALK"  , "narrator": "月神楽", "text": "結局、ちゃんと\n止められなかった\nわけですから。"},
        { "location": "2747/SEL"   , "narrator": "", "text": "まあそうだけど"},
        { "location": "2748/SEL"   , "narrator": "", "text": "いずれにせよ、月神楽が悲しい思いをしているのが悲しい"},
        { "location": "2749/ACT"   , "narrator": "", "text": "まあそうだけど"},
        { "location": "2750/TALK"  , "narrator": "月神楽", "text": "正直者ですね♪"},
        { "location": "2752/ACT"   , "narrator": "", "text": "いずれにせよ、月神楽が悲しい思いをしているのが悲しい"},
        { "location": "2754/TALK"  , "narrator": "月神楽", "text": "はあ。\nまたそうやって\n心にも無い事を言って。"},
        { "location": "2755/SEL"   , "narrator": "", "text": "だって元気になって欲しいんだもの"},
        { "location": "2756/SEL"   , "narrator": "", "text": "心にもあるよ！！　だって$me$は、月のことが好きなんだもの！"},
        { "location": "2757/ACT"   , "narrator": "", "text": "だって元気になって欲しいんだもの"},
        { "location": "2758/TALK"  , "narrator": "月神楽", "text": "あはは……\nありがとうございます。"},
        { "location": "2760/ACT"   , "narrator": "", "text": "心にもあるよ！！　だって$me$は、月のことが好きなんだもの！"},
        { "location": "2762/TALK"  , "narrator": "月神楽", "text": "……は？"},
        { "location": "2763/TALK"  , "narrator": "月神楽", "text": "貴方と私の間の、\n何処に好きになるような\n要因がありましたか？"},
        { "location": "2764/TALK"  , "narrator": "月神楽", "text": "だいたい、私は貴方のこと\n$handle31$とか言って\n侮辱してたんですよ？"},
        { "location": "2765/SEL"   , "narrator": "", "text": "好きになるのに理由なんてない"},
        { "location": "2766/SEL"   , "narrator": "", "text": "それが月の愛情表現だってわかってるから"},
        { "location": "2767/SEL"   , "narrator": "", "text": "馬乗りされた時にときめいたりした"},
        { "location": "2768/ACT"   , "narrator": "", "text": "好きになるのに理由なんてない"},
        { "location": "2770/TALK"  , "narrator": "月神楽", "text": "じゃあ聞きますけど。"},
        { "location": "2771/TALK"  , "narrator": "月神楽", "text": "ぴょんこと私、\nどっちが好きなんですか？"},
        { "location": "2772/SEL"   , "narrator": "", "text": "月"},
        { "location": "2773/SEL"   , "narrator": "", "text": "<size=14>ﾋﾟｮﾝｺ…</size>"},
        { "location": "2774/ACT"   , "narrator": "", "text": "月"},
        { "location": "2778/TALK"  , "narrator": "月神楽", "text": "正直者ですね♪"},
        { "location": "2781/ACT"   , "narrator": "", "text": "それが月の愛情表現だってわかってるから"},
        { "location": "2784/ACT"   , "narrator": "", "text": "馬乗りされた時にときめいたりした"},
        { "location": "2792/TALK"  , "narrator": "月神楽", "text": "は……"},
        { "location": "2794/TALK"  , "narrator": "月神楽", "text": "はああああぁぁ……。"},
        { "location": "2795/TALK"  , "narrator": "月神楽", "text": "まったく、とんでもない\nマゾなんですね、貴方は。"},
        { "location": "2797/TALK"  , "narrator": "月神楽", "text": "確かにそれじゃ、\n私が管理してあげないと\n生きられませんよね。"},
        { "location": "2799/TALK"  , "narrator": "月神楽", "text": "わかりました。"},
        { "location": "2838/TALK"  , "narrator": "月神楽", "text": "ならばお望み通り、\n月がしっかり、\n管理して差し上げます。"},
        { "location": "2839/TALK"  , "narrator": "月神楽", "text": "こういうのが\nいいんでしょう？\n$handle31$。"},
        { "location": "2840/SEL"   , "narrator": "", "text": "はい、ご主人様！！"},
        { "location": "2841/SEL"   , "narrator": "", "text": "月様愛してます！！"},
        { "location": "2842/ACT"   , "narrator": "", "text": "はい、ご主人様！！"},
        { "location": "2843/ACT"   , "narrator": "", "text": "月様愛してます！！"},
        { "location": "2846/TALK"  , "narrator": "月神楽", "text": "……。"},
        { "location": "2847/TALK"  , "narrator": "月神楽", "text": "どうして？"},
        { "location": "2848/TALK"  , "narrator": "月神楽", "text": "どうして貴方はそうなの？"},
        { "location": "2849/TALK"  , "narrator": "月神楽", "text": "こんなの、\nいいわけがない。"},
        { "location": "2850/TALK"  , "narrator": "月神楽", "text": "なんでそんなに\n私に優しくするんですか！"},
        { "location": "2851/SEL"   , "narrator": "", "text": "本当に大好きだからだよ、だから何だって受け入れる"},
        { "location": "2852/SEL"   , "narrator": "", "text": "いや、本当にこういうのが好きなんで"},
        { "location": "2853/ACT"   , "narrator": "", "text": "本当に大好きだからだよ、だから何だって受け入れる"},
        { "location": "2856/TALK"  , "narrator": "月神楽", "text": "バカでしょ…"},
        { "location": "2857/TALK"  , "narrator": "月神楽", "text": "ほんとに、\n最悪……。"},
        { "location": "2858/ACT"   , "narrator": "", "text": "いや、本当にこういうのが好きなんで"},
        { "location": "2860/TALK"  , "narrator": "月神楽", "text": "どうしようもない変態…。"},
        { "location": "2861/TALK"  , "narrator": "月神楽", "text": "なんでそんなに\n変態なの！？"},
        { "location": "2862/TALK"  , "narrator": "月神楽", "text": "それじゃ、\n私と同じじゃない……。"},
        { "location": "2864/TALK"  , "narrator": "月神楽", "text": "好きなの！"},
        { "location": "2865/TALK"  , "narrator": "月神楽", "text": "大好きなの！！"},
        { "location": "2866/TALK"  , "narrator": "月神楽", "text": "なんで私に\nこんな事言わせるのよ！！"},
        { "location": "2867/TALK"  , "narrator": "月神楽", "text": "貴方のことが\n大好き。失いたくない。"},
        { "location": "2868/TALK"  , "narrator": "月神楽", "text": "こんなに好きな気持ち、\n外に出したくなかった！"},
        { "location": "2869/TALK"  , "narrator": "月神楽", "text": "ずっと封印したまま\n葬り去りたかったのに。"},
        { "location": "2870/TALK"  , "narrator": "月神楽", "text": "だから！！"},
        { "location": "2871/TALK"  , "narrator": "月神楽", "text": "だから！！\nライフギャザーを\n止めたのに！！"},
        { "location": "2872/TALK"  , "narrator": "月神楽", "text": "貴方に会い続けたら、\nいつかきっと、\n言ってしまうから。"},
        { "location": "2873/TALK"  , "narrator": "月神楽", "text": "愛してますって……。"},
        { "location": "2874/TALK"  , "narrator": "月神楽", "text": "……っ……うっ……。"},
        { "location": "2875/SEL"   , "narrator": "", "text": "嬉しいよ"},
        { "location": "2876/SEL"   , "narrator": "", "text": "$me$も愛してるから、同じだよ"},
        { "location": "2877/ACT"   , "narrator": "", "text": "嬉しいよ"},
        { "location": "2878/ACT"   , "narrator": "", "text": "$me$も愛してるから、同じだよ"},
        { "location": "2881/TALK"  , "narrator": "月神楽", "text": "ダメでしょ！！"},
        { "location": "2882/TALK"  , "narrator": "月神楽", "text": "だってもう\nお別れなのよ！？"},
        { "location": "2883/TALK"  , "narrator": "月神楽", "text": "私がその事を\n知らないとでも！？"},
        { "location": "2884/TALK"  , "narrator": "月神楽", "text": "ほんと、バカでしょ…\n死ねよ……ほんとお前…"},
        { "location": "2885/TALK"  , "narrator": "月神楽", "text": "うわあああああん！！"},
        { "location": "2904/TALK"  , "narrator": "月神楽", "text": "……ごめんなさい。\n急に取り乱して。"},
        { "location": "2905/TALK"  , "narrator": "月神楽", "text": "でも、全部言ったら、\n何だかちょっとだけ\n落ち着きました。"},
        { "location": "2906/SEL"   , "narrator": "", "text": "よかった！"},
        { "location": "2907/SEL"   , "narrator": "", "text": "$me$も月と相思相愛だとわかって安心した"},
        { "location": "2908/ACT"   , "narrator": "", "text": "よかった！"},
        { "location": "2909/TALK"  , "narrator": "月神楽", "text": "えへ…。"},
        { "location": "2910/ACT"   , "narrator": "", "text": "$me$も月と相思相愛だとわかって安心した"},
        { "location": "2912/TALK"  , "narrator": "月神楽", "text": "…は？"},
        { "location": "2913/TALK"  , "narrator": "月神楽", "text": "“ご主人様とペット”の\n間違いじゃないですか？"},
        { "location": "2914/SEL"   , "narrator": "", "text": "それでもいいよ！"},
        { "location": "2915/SEL"   , "narrator": "", "text": "ラブラブだね♪"},
        { "location": "2916/ACT"   , "narrator": "", "text": "それでもいいよ！"},
        { "location": "2918/TALK"  , "narrator": "月神楽", "text": "は…はあ？"},
        { "location": "2919/TALK"  , "narrator": "月神楽", "text": "も、もういいです。\n貴方の変態っぷりは\n常識を越えすぎですし。"},
        { "location": "2920/TALK"  , "narrator": "月神楽", "text": "さすが、\n$handle31$なだけ\nありますよね～♪"},
        { "location": "2921/ACT"   , "narrator": "", "text": "ラブラブだね♪"},
        { "location": "2923/TALK"  , "narrator": "月神楽", "text": "は…はあ？"},
        { "location": "2924/TALK"  , "narrator": "月神楽", "text": "まあいいですよ、\nそう思っていれば\nいいんです。"},
        { "location": "2925/TALK"  , "narrator": "月神楽", "text": "お前の中ではナー♪"},
        { "location": "2926/SEL"   , "narrator": "", "text": "月も月で、自分の中では相思相愛だって思ってるんだよね！"},
        { "location": "2927/ACT"   , "narrator": "", "text": "月も月で、自分の中では相思相愛だって思ってるんだよね！"},
        { "location": "2930/TALK"  , "narrator": "月神楽", "text": "本っっ当に、頭ん中、\nお花畑なんですね。"},
        { "location": "2932/TALK"  , "narrator": "月神楽", "text": "まあ……"},
        { "location": "2933/TALK"  , "narrator": "月神楽", "text": "それが真実でも、自分で\n言ってると、自惚れ屋だと\n思われますよ？"},
        { "location": "2939/TALK"  , "narrator": "月神楽", "text": "はぁぁ……。\n何だかもう、どうでも良く\nなってきました。"},
        { "location": "2940/TALK"  , "narrator": "月神楽", "text": "いえ、もちろん\n良い意味で、ですよ？\n気が紛れたっていうか。"},
        { "location": "2941/TALK"  , "narrator": "月神楽", "text": "ありがとうございます。\n月のこと、\n心配してくれて。"},
        { "location": "2942/SEL"   , "narrator": "", "text": "よかった"},
        { "location": "2943/ACT"   , "narrator": "", "text": "よかった"},
        { "location": "2945/TALK"  , "narrator": "月神楽", "text": "はい♪"},
        { "location": "2947/TALK"  , "narrator": "月神楽", "text": "それじゃ\n$handle31$。"},
        { "location": "2948/TALK"  , "narrator": "月神楽", "text": "ぴょんこの元へ\n戻ってください。"},
        { "location": "2949/SEL"   , "narrator": "", "text": "月は行かないの？"},
        { "location": "2950/ACT"   , "narrator": "", "text": "月は行かないの？"},
        { "location": "2952/TALK"  , "narrator": "月神楽", "text": "私は、もう少し\n心の整理がついたら\n行きたいと思います。"},
        { "location": "2953/TALK"  , "narrator": "月神楽", "text": "今はちょっとまだ、\nぴょんこに会うのは\n辛いから。"},
        { "location": "2954/SEL"   , "narrator": "", "text": "わかったよ"},
        { "location": "2955/ACT"   , "narrator": "", "text": "わかったよ"},
        { "location": "2957/TALK"  , "narrator": "月神楽", "text": "ありがとうございます♪"},
        { "location": "2958/TALK"  , "narrator": "月神楽", "text": "それではまた！"},
        { "location": "2975/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪\nおかえりなさいまし！"},
        { "location": "2977/TALK"  , "narrator": "ぴょんこ", "text": "……ん？"},
        { "location": "2978/TALK"  , "narrator": "ぴょんこ", "text": "クンクン、クンクン"},
        { "location": "2980/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんっ！"},
        { "location": "2981/TALK"  , "narrator": "ぴょんこ", "text": "なんだか、\nオスとメスの\n臭いがするんですけど！"},
        { "location": "2982/SEL"   , "narrator": "", "text": "気のせいだよ"},
        { "location": "2983/SEL"   , "narrator": "", "text": "月と愛を確かめ合ったからね"},
        { "location": "2984/ACT"   , "narrator": "", "text": "気のせいだよ"},
        { "location": "2986/TALK"  , "narrator": "ぴょんこ", "text": "へー。\nま、いいですけどね。"},
        { "location": "2987/ACT"   , "narrator": "", "text": "気のせいだよ"},
        { "location": "2989/TALK"  , "narrator": "ぴょんこ", "text": "へー……"},
        { "location": "2991/TALK"  , "narrator": "ぴょんこ", "text": "え？"},
        { "location": "2996/TALK"  , "narrator": "ぴょんこ", "text": "ぴょ―――――――ん！！"},
        { "location": "2997/SEL"   , "narrator": "", "text": "ぴょ、ぴょんこ…"},
        { "location": "2998/ACT"   , "narrator": "", "text": "ぴょ、ぴょんこ…"},
        { "location": "3001/TALK"  , "narrator": "ぴょんこ", "text": "ん―――――――ぴょ！！"},
        { "location": "3005/TALK"  , "narrator": "ぴょんこ", "text": "ははははははははー"},
        { "location": "3006/TALK"  , "narrator": "ぴょんこ", "text": "ま、いいですけどね。"},
        { "location": "3007/TALK"  , "narrator": "ぴょんこ", "text": "まだ勝負は\nこれからDEATHしお寿司！"},
        { "location": "3008/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこだって\n負けませんからねっ♪"},
        { "location": "3010/TALK"  , "narrator": "ぴょんこ", "text": "それに、月ちゃんは\n素直じゃないけど、\nとてもいい子ですよ？"},
        { "location": "3011/TALK"  , "narrator": "ぴょんこ", "text": "だから、末永く大切に\nしてあげてくださいね♪"},
        { "location": "3013/TALK"  , "narrator": "ぴょんこ", "text": "そんな事より\n$handle$さんっ！"},
        { "location": "3015/TALK"  , "narrator": "ぴょんこ", "text": "さて、\n$handle$さんっ！"},
        { "location": "3017/TALK"  , "narrator": "ぴょんこ", "text": "浮かれている場合じゃ\nありませんよっ！"},
        { "location": "3018/ACT"   , "narrator": "", "text": "いや、こういう時はそっとしておいた方がいいんだよ"},
        { "location": "3019/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん。"},
        { "location": "3020/TALK"  , "narrator": "ぴょんこ", "text": "まあ、それもまた\n一理ありますよね。"},
        { "location": "3021/TALK"  , "narrator": "ぴょんこ", "text": "そんな事より\n$handle$さんっ！"},
        { "location": "3022/TALK"  , "narrator": "ぴょんこ", "text": "のんびりしている\n場合じゃありませんよっ！"},
        { "location": "3026/TALK"  , "narrator": "ぴょんこ", "text": "イエ――――――スっ！"},
        { "location": "3027/TALK"  , "narrator": "ぴょんこ", "text": "どうですかっ！\nぴょんこの長官っぷりは！\nサマになってましたか！？"},
        { "location": "3028/SEL"   , "narrator": "", "text": "超良かったよ！"},
        { "location": "3029/SEL"   , "narrator": "", "text": "いや、どうなんだろう…"},
        { "location": "3030/ACT"   , "narrator": "", "text": "超良かったよ！"},
        { "location": "3032/TALK"  , "narrator": "ぴょんこ", "text": "ぴょ～～～～ん♪"},
        { "location": "3033/TALK"  , "narrator": "ぴょんこ", "text": "やっぱり長官は\nぴょんこで\n決まりますねっ！"},
        { "location": "3034/TALK"  , "narrator": "ぴょんこ", "text": "長官もナビも出来て、\nぴょーん♪　もできる\nぴょんこは――"},
        { "location": "3035/TALK"  , "narrator": "ぴょんこ", "text": "既に千羽鶴さんを\n超えてしまいましたね。\nククク……。"},
        { "location": "3036/SEL"   , "narrator": "", "text": "お、おう……"},
        { "location": "3037/SEL"   , "narrator": "", "text": "元々$me$の中では超えてたよ"},
        { "location": "3038/ACT"   , "narrator": "", "text": "お、おう……"},
        { "location": "3039/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "3040/ACT"   , "narrator": "", "text": "元々$me$の中では超えてたよ"},
        { "location": "3041/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんっ！！"},
        { "location": "3043/ACT"   , "narrator": "", "text": "いや、どうなんだろう…"},
        { "location": "3044/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん……。"},
        { "location": "3045/TALK"  , "narrator": "ぴょんこ", "text": "否！"},
        { "location": "3046/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんが\n本物の長官とはどういう\nものか知らないだけです！"},
        { "location": "3047/TALK"  , "narrator": "ぴょんこ", "text": "それをこれから、\nぴょんこがみっちり\n教えてあげますよっ！"},
        { "location": "3049/TALK"  , "narrator": "ぴょんこ", "text": "……っと！！"},
        { "location": "3050/TALK"  , "narrator": "ぴょんこ", "text": "そんな話をしている\n場合ではありません\nでした！"},
        { "location": "3052/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこ達にはまだ\n１つ、ミッションが\n残ってるんですから！"},
        { "location": "3053/SEL"   , "narrator": "", "text": "なに？"},
        { "location": "3054/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "3056/TALK"  , "narrator": "ぴょんこ", "text": "何言ってるんですかっ！"},
        { "location": "3057/TALK"  , "narrator": "ぴょんこ", "text": "ミサミサを元に\n戻すんですよっ！"},
        { "location": "3058/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこが何の為に\nミサミサの量子暗号鍵を\nゲットしたとっ！？"},
        { "location": "3059/SEL"   , "narrator": "", "text": "でも、元に戻したらぴょんこは……"},
        { "location": "3060/ACT"   , "narrator": "", "text": "でも、元に戻したらぴょんこは……"},
        { "location": "3063/TALK"  , "narrator": "ぴょんこ", "text": "冗談は顔だけに\nしてください。"},
        { "location": "3064/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの願いは、\n神楽と美佐子の\n幸せな日々なんです。"},
        { "location": "3065/TALK"  , "narrator": "ぴょんこ", "text": "やっと全ての障害が\n無くなり、鍵もギャザも\n手に入れて！"},
        { "location": "3066/TALK"  , "narrator": "ぴょんこ", "text": "もう、後は処理するだけで\n元に戻るっていうのに！"},
        { "location": "3067/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\nぴょんこの夢を\n打ち砕く気ですかっ！？"},
        { "location": "3068/SEL"   , "narrator": "", "text": "わかったよ、ぴょんこの為にもやろう"},
        { "location": "3069/SEL"   , "narrator": "", "text": "$me$はぴょんこが消えるのは嫌なんだよ！"},
        { "location": "3070/ACT"   , "narrator": "", "text": "わかったよ、ぴょんこの為にもやろう"},
        { "location": "3071/TALK"  , "narrator": "ぴょんこ", "text": "ありがとう\nございますっ！"},
        { "location": "3072/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、\n行きますよっ！！"},
        { "location": "3073/ACT"   , "narrator": "", "text": "$me$はぴょんこが消えるのは嫌なんだよ！"},
        { "location": "3077/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんの\nそういうところが\nぴょんこはｽｷ。"},
        { "location": "3079/TALK"  , "narrator": "ぴょんこ", "text": "でも、\n$handle$さんは\n大事な事を忘れてます！"},
        { "location": "3080/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは\nぴょんこなんですよ？"},
        { "location": "3081/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんと\n出逢ってから、何度\n死にかけていることか！"},
        { "location": "3082/TALK"  , "narrator": "ぴょんこ", "text": "その度に不死鳥の如く！\nしつこく！\nねちっこく！！"},
        { "location": "3083/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんの\n元へ、呪いのように\n戻って来ましたよね！"},
        { "location": "3084/TALK"  , "narrator": "ぴょんこ", "text": "今回も\n同じですって♪"},
        { "location": "3085/TALK"  , "narrator": "ぴょんこ", "text": "きっとまた何か\n大自然のお導きで\n戻って来ますから！"},
        { "location": "3086/SEL"   , "narrator": "", "text": "ぴょんこやだよー！！"},
        { "location": "3087/ACT"   , "narrator": "", "text": "ぴょんこやだよー！！"},
        { "location": "3089/TALK"  , "narrator": "ぴょんこ", "text": "はよいけよ！\nぴょんこを不幸に\nする気ですかっ！？"},
        { "location": "3090/TALK"  , "narrator": "ぴょんこ", "text": "ほらほらーっ！！"},
        { "location": "3094/TALK"  , "narrator": "ぴょんこ", "text": "ファイット―――ッ！！\n$handle$さんっ！"},
        { "location": "3095/TALK"  , "narrator": "ぴょんこ", "text": "かーらーのーっ！"},
        { "location": "3096/TALK"  , "narrator": "ぴょんこ", "text": "間髪入れずに\n素敵な素敵な\nココロの旅をーっ！"},
        { "location": "3107/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "3108/TALK"  , "narrator": "ぴょんこ", "text": "ありがとうございます、\n$handle$さん。"},
        { "location": "3109/TALK"  , "narrator": "ぴょんこ", "text": "どうか、\nミサミサとぴょんこのこと\nよろしくお願いします…。"},
        { "location": "3110/TALK"  , "narrator": "ぴょんこ", "text": "今までありがとう。"},
        { "location": "3111/TALK"  , "narrator": "ぴょんこ", "text": "ホントに、\n楽しい事をいっぱい\n教えてくれて――"},
        { "location": "3112/TALK"  , "narrator": "ぴょんこ", "text": "ありがとう―――。"},
        { "location": "2146/DIALOG", "narrator": "Dialog_InfoOS", "text": "\n\n\nHi $handle$!!"},
        { "location": "2442/DIALOG", "narrator": "Dialog_Black_Nw", "text": "一方、同じ頃\n\n神楽坂トライナリーでは――"},
