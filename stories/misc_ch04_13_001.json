    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "019_偽善の伊達襟"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "ふむ"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "男性の着物には伊達襟はないものと考えていいようだ"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "よかったな"},
        { "location": "37/SEL"    , "narrator": "", "text": "あ、はい"},
        { "location": "38/SEL"    , "narrator": "", "text": "それはどうも"},
        { "location": "39/SEL"    , "narrator": "", "text": "っていうか伊達襟って何"},
        { "location": "40/ACT"    , "narrator": "", "text": "あ、はい"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "では"},
        { "location": "51/ACT"    , "narrator": "", "text": "それはどうも"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "そういうことぞね"},
        { "location": "62/ACT"    , "narrator": "", "text": "っていうか伊達襟って何"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "その向上心や素晴らしい"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "大変に"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "素晴らしい"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "着物のここの部分ぞね"},
        { "location": "72/SEL"    , "narrator": "", "text": "はあ"},
        { "location": "73/SEL"    , "narrator": "", "text": "なるほど！"},
        { "location": "74/ACT"    , "narrator": "", "text": "はあ"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "気のない返事"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "着物にはあまり興味がないか"},
        { "location": "78/ACT"    , "narrator": "", "text": "なるほど！"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "いやいや"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "これだけでは何もわからんちや"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "伊達というだけあって"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "見た目だけの襟ぞね"},
        { "location": "85/SEL"    , "narrator": "", "text": "ふーん"},
        { "location": "86/SEL"    , "narrator": "", "text": "そういうのもあるんだね"},
        { "location": "87/SEL"    , "narrator": "", "text": "$me$に関係あったりする？"},
        { "location": "88/ACT"    , "narrator": "", "text": "ふーん"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "それだけぞね"},
        { "location": "92/ACT"    , "narrator": "", "text": "そういうのもあるんだね"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "ある"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "けど関係なかったぞね"},
        { "location": "96/ACT"    , "narrator": "", "text": "$me$に関係あったりする？"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "あったりする"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "かも"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "と思ったが"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "やっぱりないな"}
    ]
}
