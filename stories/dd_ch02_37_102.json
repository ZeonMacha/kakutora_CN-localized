{
    "dir": "chap37/daydra/dd_ch02_37_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "37205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "新世界に近いもの＜後編＞"
    },
    "entry":
    [
        { "location": "649/TALK"  , "narrator": "アーヤ", "text": "……これでほぼ\n確定ってことよね……。"},
        { "location": "650/TALK"  , "narrator": "アーヤ", "text": "自分の運命は全部\n自分で決められるって\n思ってたのに。"},
        { "location": "651/TALK"  , "narrator": "アーヤ", "text": "…なんて。\nそんなわけないか。"},
        { "location": "653/SEL"   , "narrator": "", "text": "元気？"},
        { "location": "654/SEL"   , "narrator": "", "text": "少し話せる？"},
        { "location": "655/SEL"   , "narrator": "", "text": "$me$を恨んでる？"},
        { "location": "656/ACT"   , "narrator": "", "text": "元気？"},
        { "location": "658/TALK"  , "narrator": "アーヤ", "text": "…残念ながら\nあんまり元気には\nなれそうもないわ。"},
        { "location": "659/ACT"   , "narrator": "", "text": "少し話せる？"},
        { "location": "660/TALK"  , "narrator": "アーヤ", "text": "…大丈夫よ。"},
        { "location": "661/TALK"  , "narrator": "アーヤ", "text": "話すのも\n最後になるかも\nしれないしね。"},
        { "location": "662/ACT"   , "narrator": "", "text": "$me$を恨んでる？"},
        { "location": "663/TALK"  , "narrator": "アーヤ", "text": "……恨んでもいいの？"},
        { "location": "664/TALK"  , "narrator": "アーヤ", "text": "…なんてね。"},
        { "location": "667/SEL"   , "narrator": "", "text": "元気？"},
        { "location": "668/SEL"   , "narrator": "", "text": "少し話せる？"},
        { "location": "669/SEL"   , "narrator": "", "text": "$me$を恨んでる？"},
        { "location": "670/ACT"   , "narrator": "", "text": "元気？"},
        { "location": "671/TALK"  , "narrator": "アーヤ", "text": "…どうかしら。"},
        { "location": "672/TALK"  , "narrator": "アーヤ", "text": "それから\n少しだけ驚いてる。"},
        { "location": "673/ACT"   , "narrator": "", "text": "少し話せる？"},
        { "location": "674/TALK"  , "narrator": "アーヤ", "text": "…そうね。"},
        { "location": "675/TALK"  , "narrator": "アーヤ", "text": "私も話したいことが\nあるし。"},
        { "location": "676/ACT"   , "narrator": "", "text": "$me$を恨んでる？"},
        { "location": "677/TALK"  , "narrator": "アーヤ", "text": "…どうして？"},
        { "location": "678/TALK"  , "narrator": "アーヤ", "text": "$handle$さんの\n選択とは違う結果に\nなっても受け入れる。"},
        { "location": "680/TALK"  , "narrator": "アーヤ", "text": "まだ覚悟ができたとは\n言えないけど。"},
        { "location": "683/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと話すの\nこれが最後かもって\n最近ずっと思ってる。"},
        { "location": "684/TALK"  , "narrator": "アーヤ", "text": "その割には私いつも\nちゃんとしたこと\n言えてない。"},
        { "location": "685/TALK"  , "narrator": "アーヤ", "text": "だから改めて聞いて。"},
        { "location": "686/TALK"  , "narrator": "アーヤ", "text": "トライナリーの私は\n$handle$さんに\n助けられてばかりで。"},
        { "location": "687/TALK"  , "narrator": "アーヤ", "text": "一人だけ大学生で\nリーダーの役目を\nすることになって。"},
        { "location": "688/TALK"  , "narrator": "アーヤ", "text": "プレッシャーも\nすごかったし、\nみんな勝手だし。"},
        { "location": "689/TALK"  , "narrator": "アーヤ", "text": "弱音を吐ける相手は\n$handle$さんしか\nいなかった。"},
        { "location": "691/TALK"  , "narrator": "アーヤ", "text": "$handle$さんは\n色々アドバイス\nしてくれた。"},
        { "location": "692/TALK"  , "narrator": "アーヤ", "text": "その中で一番\nありがたかったのは。"},
        { "location": "693/TALK"  , "narrator": "アーヤ", "text": "私の立場を楽しむ\n方法を教えて\nくれたこと。"},
        { "location": "694/SEL"   , "narrator": "", "text": "そうだっけ？"},
        { "location": "695/SEL"   , "narrator": "", "text": "気付いてた？"},
        { "location": "696/SEL"   , "narrator": "", "text": "気を張ってばかりじゃね"},
        { "location": "697/ACT"   , "narrator": "", "text": "そうだっけ？"},
        { "location": "698/TALK"  , "narrator": "アーヤ", "text": "もしかして\n無自覚だったの？"},
        { "location": "699/ACT"   , "narrator": "", "text": "気付いてた？"},
        { "location": "700/TALK"  , "narrator": "アーヤ", "text": "もちろん。\n当たり前でしょ。"},
        { "location": "701/ACT"   , "narrator": "", "text": "気を張ってばかりじゃね"},
        { "location": "703/TALK"  , "narrator": "アーヤ", "text": "本当にそう。\n私だけじゃなくて\nみんな疲れちゃう。"},
        { "location": "705/TALK"  , "narrator": "アーヤ", "text": "ふざけたことばっかり\n言ってって思った\nこともあったけど。"},
        { "location": "706/TALK"  , "narrator": "アーヤ", "text": "チームを円滑に\nまとめるには\nユーモアが必要。"},
        { "location": "707/TALK"  , "narrator": "アーヤ", "text": "それに気付けたのは\n$handle$さんの\nおかげ。"},
        { "location": "708/TALK"  , "narrator": "アーヤ", "text": "私一人だったら\n絶対に気付けなかった。"},
        { "location": "709/TALK"  , "narrator": "アーヤ", "text": "だから本当に\nありがとう。"},
        { "location": "710/SEL"   , "narrator": "", "text": "アーヤにだけ特別だから"},
        { "location": "711/SEL"   , "narrator": "", "text": "別に普通だから"},
        { "location": "712/SEL"   , "narrator": "", "text": "気にしなくていいのに"},
        { "location": "713/ACT"   , "narrator": "", "text": "アーヤにだけ特別だから"},
        { "location": "714/TALK"  , "narrator": "アーヤ", "text": "私にだって\n$handle$さんは\n特別だから。"},
        { "location": "716/TALK"  , "narrator": "アーヤ", "text": "特別なんて\n言葉が霞むくらい\n別格だから。"},
        { "location": "717/ACT"   , "narrator": "", "text": "別に普通だから"},
        { "location": "718/TALK"  , "narrator": "アーヤ", "text": "そうなの…？"},
        { "location": "719/TALK"  , "narrator": "アーヤ", "text": "誰にでも優しいんだ、\n$handle$さんは。"},
        { "location": "720/ACT"   , "narrator": "", "text": "気にしなくていいのに"},
        { "location": "721/TALK"  , "narrator": "アーヤ", "text": "…たいしたことじゃ\nないのね。"},
        { "location": "723/TALK"  , "narrator": "アーヤ", "text": "$handle$さんに\nとっては。"},
        { "location": "725/TALK"  , "narrator": "アーヤ", "text": "………………………。"},
        { "location": "726/TALK"  , "narrator": "アーヤ", "text": "…今度こそ\n最後になるかも\nしれないもの…。"},
        { "location": "727/TALK"  , "narrator": "アーヤ", "text": "思い切って\n伝えておこう。"},
        { "location": "728/TALK"  , "narrator": "アーヤ", "text": "…変なこと言うなって\n思うかもしれないけど。"},
        { "location": "729/TALK"  , "narrator": "アーヤ", "text": "でも聞いて。\n私が今考えてること。"},
        { "location": "730/TALK"  , "narrator": "アーヤ", "text": "あなたはどっちの私が\nいなくなったとしても。"},
        { "location": "731/TALK"  , "narrator": "アーヤ", "text": "ううん、どっちの私も\nいなくなって魂だけに\nなったとしても。"},
        { "location": "733/TALK"  , "narrator": "アーヤ", "text": "ずっと、絶対、\n何があっても\n私の側にいてくれる。"},
        { "location": "734/TALK"  , "narrator": "アーヤ", "text": "私を支えてくれる。\n今それを確信したの。"},
        { "location": "735/TALK"  , "narrator": "アーヤ", "text": "…人は生きている時\n肉体に支配される。"},
        { "location": "736/TALK"  , "narrator": "アーヤ", "text": "だから純粋に魂と\n魂を交えることは\nできない。"},
        { "location": "737/TALK"  , "narrator": "アーヤ", "text": "…だけどあなたは違う。\n心に直接接してくれる。"},
        { "location": "738/TALK"  , "narrator": "アーヤ", "text": "$handle$さんとの\n魂と魂の交わりは\n他の人とは違う。"},
        { "location": "739/TALK"  , "narrator": "アーヤ", "text": "一人じゃないんだって\nそんな気持ちを\n与えてくれる。"},
        { "location": "740/TALK"  , "narrator": "アーヤ", "text": "そんなあなたが好き。"},
        { "location": "741/TALK"  , "narrator": "アーヤ", "text": "……ううん。\nそんな言葉じゃ\n全然足りない。"},
        { "location": "742/TALK"  , "narrator": "アーヤ", "text": "愛してる。"},
        { "location": "743/TALK"  , "narrator": "アーヤ", "text": "……違う。愛なんて\n言葉すら安っぽい。"},
        { "location": "744/TALK"  , "narrator": "アーヤ", "text": "もっと、この気持ちに\nあてはまる言葉……。"},
        { "location": "745/TALK"  , "narrator": "アーヤ", "text": "…満たされる？"},
        { "location": "746/TALK"  , "narrator": "アーヤ", "text": "ううん、違う。\nだってあなたは\n私の一部。"},
        { "location": "747/TALK"  , "narrator": "アーヤ", "text": "…やっぱり違う。\nだってこれじゃ\nあなたに失礼だもの。"},
        { "location": "748/TALK"  , "narrator": "アーヤ", "text": "私にとっての\n$handle$さんは\n世界と同じもの。"},
        { "location": "749/TALK"  , "narrator": "アーヤ", "text": "いつも側にいて\n見えなくてもわかる\nそんな存在。"},
        { "location": "750/TALK"  , "narrator": "アーヤ", "text": "私はいつも\n$handle$さんを\n感じてる。"},
        { "location": "751/TALK"  , "narrator": "アーヤ", "text": "私は$handle$さんに\n満たされてる。"},
        { "location": "752/TALK"  , "narrator": "アーヤ", "text": "私には\n$handle$さんが\n満ちている。"},
        { "location": "753/TALK"  , "narrator": "アーヤ", "text": "私のセカイには\nあなたが満ち溢れている。\n私のセカイ全ての場所に。"},
        { "location": "754/TALK"  , "narrator": "アーヤ", "text": "……ねえ。\nどうしよう。"},
        { "location": "755/TALK"  , "narrator": "アーヤ", "text": "こんな言葉じゃ\n言い表せない。"},
        { "location": "757/TALK"  , "narrator": "アーヤ", "text": "私の言葉じゃ\n稚拙すぎる。"},
        { "location": "758/TALK"  , "narrator": "アーヤ", "text": "…だけど感じて。\n私を感じて。"},
        { "location": "759/TALK"  , "narrator": "アーヤ", "text": "もっとうんと\n私の魂を感じて\nもらいたいの。"},
        { "location": "760/TALK"  , "narrator": "アーヤ", "text": "今の私の魂を。\nこの先の私の魂も。"},
        { "location": "763/SEL"   , "narrator": "", "text": "愛してる。ずっと一緒だから"},
        { "location": "764/SEL"   , "narrator": "", "text": "これからも共に支え合っていこう"},
        { "location": "765/SEL"   , "narrator": "", "text": "これからも頑張ってね"},
        { "location": "766/SEL"   , "narrator": "", "text": "役に立てて良かったよ"},
        { "location": "767/ACT"   , "narrator": "", "text": "愛してる。ずっと一緒だから"},
        { "location": "768/TALK"  , "narrator": "アーヤ", "text": "…現実世界の\n私の人格とでしょ？"},
        { "location": "770/TALK"  , "narrator": "アーヤ", "text": "自分自身のはずなのに\nなんだか妬ける…。"},
        { "location": "771/ACT"   , "narrator": "", "text": "これからも共に支え合っていこう"},
        { "location": "772/TALK"  , "narrator": "アーヤ", "text": "私じゃない私と？"},
        { "location": "773/TALK"  , "narrator": "アーヤ", "text": "変な気分。"},
        { "location": "774/ACT"   , "narrator": "", "text": "これからも頑張ってね"},
        { "location": "775/TALK"  , "narrator": "アーヤ", "text": "そうね。"},
        { "location": "776/TALK"  , "narrator": "アーヤ", "text": "私にはもう\n頑張りようも\nないかもしれないけど。"},
        { "location": "777/ACT"   , "narrator": "", "text": "役に立てて良かったよ"},
        { "location": "778/TALK"  , "narrator": "アーヤ", "text": "もう過去なのね。"},
        { "location": "779/TALK"  , "narrator": "アーヤ", "text": "$handle$さんには。"},
        { "location": "781/TALK"  , "narrator": "アーヤ", "text": "……どう転んでも\n私は私。"},
        { "location": "782/TALK"  , "narrator": "アーヤ", "text": "それは魂の真実。"},
        { "location": "783/TALK"  , "narrator": "アーヤ", "text": "フェノメノンの中で\n生きた私が\nいなくなったとしても。"},
        { "location": "784/TALK"  , "narrator": "アーヤ", "text": "私が私であることに\n変わりはない……。"},
        { "location": "786/SEL"   , "narrator": "", "text": "愛してる。ずっと一緒だから"},
        { "location": "787/SEL"   , "narrator": "", "text": "これからも共に支え合っていこう"},
        { "location": "788/SEL"   , "narrator": "", "text": "これからも頑張ってね"},
        { "location": "789/SEL"   , "narrator": "", "text": "役に立てて良かったよ"},
        { "location": "790/ACT"   , "narrator": "", "text": "愛してる。ずっと一緒だから"},
        { "location": "792/TALK"  , "narrator": "アーヤ", "text": "うん。\nそれだけは絶対だから。"},
        { "location": "793/TALK"  , "narrator": "アーヤ", "text": "$handle$さんが\nいない未来なんて\n考えられない。"},
        { "location": "794/TALK"  , "narrator": "アーヤ", "text": "$handle$さんは\n私にとって\n世界そのものだから。"},
        { "location": "795/ACT"   , "narrator": "", "text": "これからも共に支え合っていこう"},
        { "location": "796/TALK"  , "narrator": "アーヤ", "text": "そうね。\nそうして生きて\n行きましょう。"},
        { "location": "797/TALK"  , "narrator": "アーヤ", "text": "なんて。\n偉そうね私。"},
        { "location": "798/TALK"  , "narrator": "アーヤ", "text": "本当はそうじゃないと\n生きていけないのは\n私の方なのに。"},
        { "location": "799/ACT"   , "narrator": "", "text": "これからも頑張ってね"},
        { "location": "800/TALK"  , "narrator": "アーヤ", "text": "……。\nがんばるわ。\nもちろん。"},
        { "location": "801/TALK"  , "narrator": "アーヤ", "text": "でも。\n$handle$さんには\n他人事でしかないの？"},
        { "location": "802/ACT"   , "narrator": "", "text": "役に立てて良かったよ"},
        { "location": "803/TALK"  , "narrator": "アーヤ", "text": "これで終わりだって\nそう思ってる？"},
        { "location": "804/TALK"  , "narrator": "アーヤ", "text": "人生はまだ続くのに。"},
        { "location": "806/TALK"  , "narrator": "アーヤ", "text": "$handle$さんは\n私の意思のある世界を\n選択してくれた。"},
        { "location": "807/TALK"  , "narrator": "アーヤ", "text": "その選択を私は\n絶対に忘れない。"},
        { "location": "808/TALK"  , "narrator": "アーヤ", "text": "もし違う未来を\n歩まざるを\n得なくなっても。"},
        { "location": "809/TALK"  , "narrator": "アーヤ", "text": "$handle$さんの\n姿形を見失っても。\n魂は絶対に見失わない。"},
        { "location": "810/TALK"  , "narrator": "アーヤ", "text": "もし私が別の私の\n奥底で眠るだけの\n存在になっても。"},
        { "location": "811/TALK"  , "narrator": "アーヤ", "text": "$handle$さんの魂の\n記憶だけは手放さない。"},
        { "location": "812/TALK"  , "narrator": "アーヤ", "text": "それが私の決心。"},
        { "location": "815/TALK"  , "narrator": "アーヤ", "text": "$handle$さん。"},
        { "location": "816/TALK"  , "narrator": "アーヤ", "text": "私、どんな結末に\nなっても受け入れる。"},
        { "location": "818/TALK"  , "narrator": "アーヤ", "text": "一生懸命考えて\n出してくれた答え\nなんだから。"},
        { "location": "819/TALK"  , "narrator": "アーヤ", "text": "私が出会った全ての人の\n中で一番私のことを考えて\nくれた人の答えだから。"},
        { "location": "820/TALK"  , "narrator": "アーヤ", "text": "私はそれを受け入れる。"},
        { "location": "821/TALK"  , "narrator": "アーヤ", "text": "どんな姿になっても\n私は$handle$さんの\n側にいたいから。"},
        { "location": "822/TALK"  , "narrator": "アーヤ", "text": "何度言っても足りないけど\n本当にありがとう。\n感謝します。"},
        { "location": "823/TALK"  , "narrator": "アーヤ", "text": "気持ちに言葉が\n追いつかないけど。"},
        { "location": "824/TALK"  , "narrator": "アーヤ", "text": "愛してる。\n大好き。\nありがとう。"},
        { "location": "645/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "835/DIALOG", "narrator": "Dialog_chapter_ch02", "text": "【MV EXE_TSuBaMe】"}
    ]
}
