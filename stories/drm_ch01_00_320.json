{
    "dir": "dramatics/daydra/drm_ch01_00_320.js",
    "type": "Episode",
    "info": {
        "story_id": "1032",
        "cid": "tsubame",
        "title": "らぶとーく 第32話",
        "sub_title": "悪く言わないで"
    },
    "entry":
    [
        { "location": "146/SCENARIO", "narrator": "", "text": "悪く言わないで"},
        { "location": "159/TALK"    , "narrator": "ガブリエラ", "text": "はぁ！？\nまだ来てないの！？"},
        { "location": "161/TALK"    , "narrator": "つばめ", "text": "わっ！？\nな、何、どうしたの？"},
        { "location": "164/TALK"    , "narrator": "みやび", "text": "いや、今日のシフトは\n卯月も入ってるんや\nけんど――"},
        { "location": "165/TALK"    , "narrator": "みやび", "text": "まだ劇場に来とらんがよ。"},
        { "location": "166/TALK"    , "narrator": "つばめ", "text": "えっ…。"},
        { "location": "168/TALK"    , "narrator": "つばめ", "text": "お母さんのことで、\n何かあったのかな？"},
        { "location": "169/TALK"    , "narrator": "アーヤ", "text": "ＷＡＶＥにも反応が\n無いみたいだし…。"},
        { "location": "173/TALK"    , "narrator": "アーヤ", "text": "何かあったのかしら…。\nつばめは何か知ってる？"},
        { "location": "176/TALK"    , "narrator": "つばめ", "text": "え、えっと…。"},
        { "location": "178/TALK"    , "narrator": "つばめ", "text": "あ、ちょっと待って\nください！\n今、ＷＡＶＥが…。"},
        { "location": "192/TALK"    , "narrator": "つばめ", "text": "どぅしよぅ|ﾟДﾟ)))"},
        { "location": "193/TALK"    , "narrator": "つばめ", "text": "卯月さんのこと"},
        { "location": "194/TALK"    , "narrator": "つばめ", "text": "なんて説明すればぃぃかな？(；´Д｀)"},
        { "location": "196/SEL"     , "narrator": "", "text": "月に帰ったって言えば"},
        { "location": "197/SEL"     , "narrator": "", "text": "しらを切れ"},
        { "location": "198/SEL"     , "narrator": "", "text": "こっちが聞きたいって言えば"},
        { "location": "199/ACT"     , "narrator": "", "text": "月に帰ったって言えば"},
        { "location": "200/TALK"    , "narrator": "つばめ", "text": "それって冗談でしょ？"},
        { "location": "201/TALK"    , "narrator": "つばめ", "text": "冗談言ってぃぃ雰囲気じゃなぃよ(；´Д｀)"},
        { "location": "213/TALK"    , "narrator": "つばめ", "text": "え、えっと…。"},
        { "location": "216/TALK"    , "narrator": "つばめ", "text": "多分、体調を崩したとか\nだと思いますよ？"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "適当過ぎでしょ、それ。"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "まあ、しっかりした子\nだから、理由なくサボる\nことはないと思うし――"},
        { "location": "222/TALK"    , "narrator": "アーヤ", "text": "来るのを待ちましょう。"},
        { "location": "224/TALK"    , "narrator": "ガブリエラ", "text": "もういいわよ。"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "来ないようなヤツを\n待つ必要なんてないわ。"},
        { "location": "227/TALK"    , "narrator": "ガブリエラ", "text": "待ってる間にも、\nやらなきゃいけない\n仕事は沢山あるんだし。"},
        { "location": "229/TALK"    , "narrator": "つばめ", "text": "が、ガブちゃん。\nそんな言い方しなく\nても…。"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "…このまま来なかったら、\nどうする？"},
        { "location": "234/TALK"    , "narrator": "つばめ", "text": "え？"},
        { "location": "237/TALK"    , "narrator": "みやび", "text": "いや、卯月もスパイいう\n可能性、捨てきれんし…。"},
        { "location": "238/TALK"    , "narrator": "つばめ", "text": "やめてください！\n冗談でも、ちょっと\n酷過ぎます！"},
        { "location": "239/TALK"    , "narrator": "つばめ", "text": "卯月さんのこと、\n悪く言わないでください！"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "な、何ムキになってん\nのよ？"},
        { "location": "242/TALK"    , "narrator": "つばめ", "text": "だ、だって…。"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "…つばめちゃん。\n本当は卯月のこと、\n何か知ってるんやないが？"},
        { "location": "244/TALK"    , "narrator": "つばめ", "text": "っ！？"},
        { "location": "246/TALK"    , "narrator": "アーヤ", "text": "そうなの、つばめ？"},
        { "location": "248/TALK"    , "narrator": "つばめ", "text": "…し、知りません。\nわたしは、何も…。"},
        { "location": "249/TALK"    , "narrator": "みやび", "text": "…そうか。"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "まあ、何にせよ仕事は\n待ってくれんき――"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "すっと仕事始めるちや。"},
        { "location": "258/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…面倒くさい。\n勝手にサボられると\n本当迷惑よね…。"},
        { "location": "261/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "262/TALK"    , "narrator": "アーヤ", "text": "…ほら、元気出して。"},
        { "location": "263/TALK"    , "narrator": "アーヤ", "text": "卯月がいない分、\n私達が頑張らないと\nいけないんだから…ね？"},
        { "location": "265/TALK"    , "narrator": "つばめ", "text": "…はい。"},
        { "location": "266/ACT"     , "narrator": "", "text": "しらをきれ"},
        { "location": "267/TALK"    , "narrator": "つばめ", "text": "しらをきるもなにも"},
        { "location": "268/TALK"    , "narrator": "つばめ", "text": "わたしだってちゃんとした理由は知らなぃよ(´･ω･｀) "},
        { "location": "269/TALK"    , "narrator": "つばめ", "text": "おかぁさんのことかなとは思ったけど"},
        { "location": "270/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "271/TALK"    , "narrator": "つばめ", "text": "その話はしたくなぃし"},
        { "location": "282/TALK"    , "narrator": "つばめ", "text": "え、えっと…。"},
        { "location": "283/TALK"    , "narrator": "つばめ", "text": "多分、体調を崩したとか\nだと思いますよ？"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "適当過ぎでしょ、それ。"},
        { "location": "286/ACT"     , "narrator": "", "text": "こっちが聞きたいって言えば"},
        { "location": "287/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "288/TALK"    , "narrator": "つばめ", "text": "その通りだもんね"},
        { "location": "299/TALK"    , "narrator": "つばめ", "text": "卯月さんのことは、\nわたしの方が聞きたい\nくらいです。"},
        { "location": "300/TALK"    , "narrator": "ガブリエラ", "text": "つばめも知らないの？\n卯月とあんなに\n仲良いのに？"},
        { "location": "302/TALK"    , "narrator": "つばめ", "text": "…でも、全部知ってる\nわけじゃないから。"}
    ]
}
