{
    "dir": "chap00/daydra/spev_ch04_007.js",
    "type": "",
    "info": {
        "story_id": "4007",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "神楽ちゃんとゲーム"
    },
    "entry":
    [
        { "location": "29/TALK" , "narrator": "透明神楽", "text": "ちょ、みやびさん！\nなんでそっちの車、\nそんなに早いんですか！？"},
        { "location": "32/TALK" , "narrator": "透明みやび", "text": "なんでもなにも、\nうちは普通に走っちゅう\nだけやぞ？"},
        { "location": "35/TALK" , "narrator": "透明神楽", "text": "そんな…えぇっ！？\nどんどん加速してる！"},
        { "location": "36/TALK" , "narrator": "透明神楽", "text": "まさか、チートですか！？"},
        { "location": "37/TALK" , "narrator": "透明みやび", "text": "人聞きの悪い…。\nテクの問題や。"},
        { "location": "38/TALK" , "narrator": "透明みやび", "text": "曲がり角ではドリフト、\nできる限りインコース。"},
        { "location": "39/TALK" , "narrator": "透明みやび", "text": "それだけ意識しちょれば、\nこれくらい普通ちや。"},
        { "location": "41/TALK" , "narrator": "透明神楽", "text": "それにしたってちょっと\n早過ぎるような…。"},
        { "location": "42/TALK" , "narrator": "透明みやび", "text": "ふむ…ならば禁断の\n裏技を披露しよう。"},
        { "location": "43/TALK" , "narrator": "透明みやび", "text": "秘技、コースアウトからの\nショートカット！"},
        { "location": "47/TALK" , "narrator": "透明神楽", "text": "えぇーっ！？"},
        { "location": "48/TALK" , "narrator": "透明みやび", "text": "ふっ…うちの完勝や。"},
        { "location": "50/TALK" , "narrator": "透明神楽", "text": "ま、負けた…。\n結構やりこんだゲーム\nだったのに…。"},
        { "location": "52/TALK" , "narrator": "透明みやび", "text": "ふふふ…うちに対して\nゲームデートを求めたのが\n運の尽きやったな。"},
        { "location": "53/TALK" , "narrator": "透明みやび", "text": "どうする？\nリベンジはいくらでも\n受けるぞね？"},
        { "location": "55/TALK" , "narrator": "透明神楽", "text": "もう一回お願いします。"},
        { "location": "56/TALK" , "narrator": "透明神楽", "text": "スーパープレイ動画で\nやってた技で、\n次こそ勝ちます！"},
        { "location": "58/TALK" , "narrator": "透明みやび", "text": "ほほぅ…その自信、\nすぐに崩れんように\n気ぃつけた方がえいよ。"},
        { "location": "59/TALK" , "narrator": "透明神楽", "text": "その言葉、そのまま\nみやびさんに\nお返しします。"},
        { "location": "60/TALK" , "narrator": "透明神楽", "text": "さあ、行きますよ！"},
        { "location": "61/TALK" , "narrator": "透明みやび", "text": "スタートッ！"},
        { "location": "64/TALK" , "narrator": "透明みやび", "text": "おおっ！？\n確かに上手くなっちゅう。"},
        { "location": "65/TALK" , "narrator": "透明神楽", "text": "まだまだです。\n必殺――"},
        { "location": "66/TALK" , "narrator": "透明神楽", "text": "押し出し！！"},
        { "location": "70/TALK" , "narrator": "透明みやび", "text": "な、なにぃ！？"},
        { "location": "74/TALK" , "narrator": "透明神楽", "text": "やった、抜いた！"},
        { "location": "75/TALK" , "narrator": "透明みやび", "text": "卯月…とうとう手段を\n選ばなくなったか…。"},
        { "location": "76/TALK" , "narrator": "透明神楽", "text": "レースにクラッシュは\n付きものですよー。"},
        { "location": "78/TALK" , "narrator": "透明みやび", "text": "ならばもう一度、\nコースアウトからの\nショートカット！"},
        { "location": "81/TALK" , "narrator": "透明神楽", "text": "それこそ卑怯じゃ\nないですか！"},
        { "location": "83/TALK" , "narrator": "透明みやび", "text": "コースアウト判定が\n出る前に復帰しちゅうき、\nルール上問題なしぞね。"},
        { "location": "84/TALK" , "narrator": "透明みやび", "text": "さあ、このレースも\nうちがもらうぞね。"},
        { "location": "87/TALK" , "narrator": "透明神楽", "text": "そうはいきません。\n今度こそは絶対に――"},
        { "location": "93/TALK" , "narrator": "透明神楽", "text": "えっ！？"},
        { "location": "94/TALK" , "narrator": "透明みやび", "text": "ぬぁっ！？"},
        { "location": "96/TALK" , "narrator": "透明真幌", "text": "…みやび、卯月。\nなにをやっているんだ？"},
        { "location": "97/TALK" , "narrator": "透明神楽", "text": "ま、真幌さん！？"},
        { "location": "99/TALK" , "narrator": "透明みやび", "text": "なにするがですか！？\nってかなぜここに！？"},
        { "location": "100/TALK", "narrator": "透明真幌", "text": "…連絡も取れず、\n散々探させておいて\n何をしてる？"},
        { "location": "101/TALK", "narrator": "透明みやび", "text": "うちらはゲームデートを\n楽しんどる最中だったが\nですよ。"},
        { "location": "103/TALK", "narrator": "透明みやび", "text": "っていうか、どうして\nコンセント抜いたり\nしたんです？"},
        { "location": "104/TALK", "narrator": "透明神楽", "text": "そうですよ。\nせっかく、今度こそ\n私が勝ったのに…。"},
        { "location": "105/TALK", "narrator": "透明みやび", "text": "いや、うちの方が\nリードしちょったぞね。"},
        { "location": "106/TALK", "narrator": "透明神楽", "text": "でも私は加速してたから\nゴール直前で絶対に\n抜いてましたよ。"},
        { "location": "107/TALK", "narrator": "透明真幌", "text": "あのな…二人とも、\nいま何時か言ってみろ"},
        { "location": "108/TALK", "narrator": "透明みやび", "text": "１６時？　まだ日も暮れ\nとらんですけど？"},
        { "location": "109/TALK", "narrator": "透明神楽", "text": "それがどうか\nしたんですか？"},
        { "location": "110/TALK", "narrator": "透明真幌", "text": "うむ、そうだ。"},
        { "location": "111/TALK", "narrator": "透明真幌", "text": "で…おまえ達は今日\nこの時間、本当なら\nどこにいるはずだ？"},
        { "location": "113/TALK", "narrator": "透明神楽", "text": "…あっ！"},
        { "location": "115/TALK", "narrator": "透明神楽", "text": "そ、そうでした…。\n今日は劇場のシフトが\n入ってたんでした…。"},
        { "location": "118/TALK", "narrator": "透明みやび", "text": "あ、あれぇ？\nそう…やったが？"},
        { "location": "119/TALK", "narrator": "透明みやび", "text": "実はその…お休みを\n申請しとった、なんて\n落ちありません？"},
        { "location": "120/TALK", "narrator": "透明真幌", "text": "なぜ私がわざわざ\nお前たちを探したか――"},
        { "location": "121/TALK", "narrator": "透明真幌", "text": "賢いお前たちなら、\nこの意味が分かるよな？"},
        { "location": "122/TALK", "narrator": "透明みやび", "text": "…………<size=15>めっちゃ怒っとる</size>。"},
        { "location": "124/TALK", "narrator": "透明神楽", "text": "…………<size=15>あはは</size>。"},
        { "location": "125/TALK", "narrator": "透明真幌", "text": "デートは終わりだ。\n仕事に戻れ。"},
        { "location": "126/TALK", "narrator": "透明神楽", "text": "…わかりました。"},
        { "location": "127/TALK", "narrator": "透明みやび", "text": "はぁ…。\nつばめちゃんたちには\nアイスでもこうてくか。"}
    ]
}
