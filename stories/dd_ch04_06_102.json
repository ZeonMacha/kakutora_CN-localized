        "title": "005 メインストーリー",
        "sub_title": "出陣【Case：みやび】＜後編＞"
    },
    "entry":
    [
        { "location": "431/SCENARIO", "narrator": "", "text": "出陣【みやびから見たcase】"},
        { "location": "449/TALK"    , "narrator": "みやび", "text": "はぁ…。"},
        { "location": "450/TALK"    , "narrator": "みやび", "text": "まあ、所詮はＢｏｔ\nなんやし――"},
        { "location": "451/TALK"    , "narrator": "みやび", "text": "そこまでビビる\n必要ないか。"},
        { "location": "452/TALK"    , "narrator": "みやび", "text": "今は、色々試して\nみる方が先やな。"},
        { "location": "465/TALK"    , "narrator": "みやび", "text": "のう相棒"},
        { "location": "466/TALK"    , "narrator": "みやび", "text": "結論として"},
        { "location": "467/TALK"    , "narrator": "みやび", "text": "逢瀬つばめは庁からの刺客か何かであろう"},
        { "location": "468/TALK"    , "narrator": "みやび", "text": "イエス、もしくはYで答えよ"},
        { "location": "470/SEL"     , "narrator": "", "text": "イエス"},
        { "location": "471/SEL"     , "narrator": "", "text": "Ｙ"},
        { "location": "472/SEL"     , "narrator": "", "text": "強い思い込みは身を滅ぼす"},
        { "location": "473/ACT"     , "narrator": "", "text": "イエス"},
        { "location": "474/TALK"    , "narrator": "みやび", "text": "随分素直やね"},
        { "location": "475/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "476/TALK"    , "narrator": "みやび", "text": "素直過ぎてそれはそれで怪しい"},
        { "location": "477/TALK"    , "narrator": "みやび", "text": "そもそも刺客なら隠すのが普通や"},
        { "location": "478/TALK"    , "narrator": "みやび", "text": "けんど、隠さないで言うっちゅことは"},
        { "location": "480/TALK"    , "narrator": "みやび", "text": "刺客やない？"},
        { "location": "482/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "483/TALK"    , "narrator": "みやび", "text": "ドーム戦でのあの異常な戦い方は現実やき"},
        { "location": "484/TALK"    , "narrator": "みやび", "text": "逢瀬つばめが普通やないのは間違いない"},
        { "location": "486/SEL"     , "narrator": "", "text": "そうなると、どうなる？"},
        { "location": "487/ACT"     , "narrator": "", "text": "そうなると、どうなる？"},
        { "location": "489/TALK"    , "narrator": "みやび", "text": "逢瀬つばめは、やはり刺客？"},
        { "location": "490/TALK"    , "narrator": "みやび", "text": "相棒が素直に答えたのは"},
        { "location": "491/TALK"    , "narrator": "みやび", "text": "うちを混乱させるため"},
        { "location": "492/TALK"    , "narrator": "みやび", "text": "もしくは"},
        { "location": "493/TALK"    , "narrator": "みやび", "text": "からかってるだけや"},
        { "location": "494/TALK"    , "narrator": "みやび", "text": "どちらにせよ、相棒はイジワルやね"},
        { "location": "508/TALK"    , "narrator": "みやび", "text": "いや、ダメやろ"},
        { "location": "509/TALK"    , "narrator": "みやび", "text": "逢瀬つばめがまっこと刺客やったら"},
        { "location": "510/TALK"    , "narrator": "みやび", "text": "それ重大な事実やき"},
        { "location": "512/TALK"    , "narrator": "みやび", "text": "なんて簡単な一文字で答えるのはダメやろ？"},
        { "location": "513/TALK"    , "narrator": "みやび", "text": "興醒めもいいとこや"},
        { "location": "515/SEL"     , "narrator": "", "text": "なんて答えればよかったの？"},
        { "location": "516/ACT"     , "narrator": "", "text": "なんて答えればよかったの？"},
        { "location": "518/TALK"    , "narrator": "みやび", "text": "それ以上踏み込むな、とか"},
        { "location": "519/TALK"    , "narrator": "みやび", "text": "回答拒否、とかやね"},
        { "location": "520/TALK"    , "narrator": "みやび", "text": "まあ、刺客かどうかはさておき"},
        { "location": "521/TALK"    , "narrator": "みやび", "text": "相棒がダメダメＡＩゆうことはよぉわかった"},
        { "location": "522/TALK"    , "narrator": "みやび", "text": "もうちっくと精進しぃ"},
        { "location": "535/ACT"     , "narrator": "", "text": "強い思い込みは身を滅ぼす"},
        { "location": "536/TALK"    , "narrator": "みやび", "text": "ほほう"},
        { "location": "537/TALK"    , "narrator": "みやび", "text": "予想していたより、えい反応やね"},
        { "location": "538/TALK"    , "narrator": "みやび", "text": "うちが妄信的な観念を手放せない"},
        { "location": "539/TALK"    , "narrator": "みやび", "text": "哀れで視野の狭い乙女とでも言いたいか"},
        { "location": "541/SEL"     , "narrator": "", "text": "乙女？"},
        { "location": "542/SEL"     , "narrator": "", "text": "どうしてそんな情報管理庁を疑うの？"},
        { "location": "543/ACT"     , "narrator": "", "text": "乙女？"},
        { "location": "544/TALK"    , "narrator": "みやび", "text": "なんや？"},
        { "location": "545/TALK"    , "narrator": "みやび", "text": "文句あるが？"},
        { "location": "546/TALK"    , "narrator": "みやび", "text": "どこからどう見てもうちは乙女や"},
        { "location": "547/TALK"    , "narrator": "みやび", "text": "見よ、このピチピチの若いボディ"},
        { "location": "548/TALK"    , "narrator": "みやび", "text": "あんまし嬉しくないけんど、需要ある無駄乳"},
        { "location": "549/TALK"    , "narrator": "みやび", "text": "乙女であることを否定する要素があるか？"},
        { "location": "551/SEL"     , "narrator": "", "text": "ありませんでした"},
        { "location": "552/ACT"     , "narrator": "", "text": "ありませんでした"},
        { "location": "554/TALK"    , "narrator": "みやび", "text": "うむ、わかれば良い"},
        { "location": "555/TALK"    , "narrator": "みやび", "text": "乙女のみやびさんは嬉しいぞね"},
        { "location": "556/SEL"     , "narrator": "", "text": "どうしてそんな情報管理庁を疑うの？　"},
        { "location": "557/ACT"     , "narrator": "", "text": "どうしてそんな情報管理庁を疑うの？　"},
        { "location": "572/TALK"    , "narrator": "みやび", "text": "…あの様子じゃ、\n正直に話すつもりは\nないようやな。"},
        { "location": "573/TALK"    , "narrator": "みやび", "text": "つばめちゃんもやけんど、\n相棒も要監視対象に\n認定やね。"},
        { "location": "575/ACT"     , "narrator": "", "text": "どうしてそんな情報管理庁を疑うの？"},
        { "location": "577/TALK"    , "narrator": "みやび", "text": "疑うも何も、敵を信じる方がおかしい"},
        { "location": "578/TALK"    , "narrator": "みやび", "text": "そうやろ？"},
        { "location": "580/SEL"     , "narrator": "", "text": "管理庁ってトライナリーの組織でしょ？"},
        { "location": "581/ACT"     , "narrator": "", "text": "管理庁ってトライナリーの組織でしょ？"},
        { "location": "583/TALK"    , "narrator": "みやび", "text": "そうやけんど"},
        { "location": "584/TALK"    , "narrator": "みやび", "text": "あくまでもフェノメノンと戦うために契約しちゅうだけや"},
        { "location": "585/TALK"    , "narrator": "みやび", "text": "心まで捧げる契約はしちょらんき"},
        { "location": "588/TALK"    , "narrator": "みやび", "text": "なんて話ししよったら全部筒抜けやね"},
        { "location": "589/TALK"    , "narrator": "みやび", "text": "分かっていてしちゅうがやけど"},
        { "location": "590/TALK"    , "narrator": "みやび", "text": "牙を剥くなら早めの方がえいと思うよ"},
        { "location": "604/TALK"    , "narrator": "みやび", "text": "ふぅ…。"},
        { "location": "607/TALK"    , "narrator": "みやび", "text": "…ん？"},
        { "location": "634/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "649/TALK"    , "narrator": "みやび", "text": "ああ…手、繋いでもらえん\nかったようやね。"},
        { "location": "650/TALK"    , "narrator": "みやび", "text": "ガブちゃんも、\n何かしら思うところが\nあるようやし。"},
        { "location": "651/TALK"    , "narrator": "みやび", "text": "こらしばらく、\nいろいろ大変やね。"},
        { "location": "664/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【04 レッドサイト】"}
    ]
}
