{
    "dir": "chap18/daydra/anime_05_18.js",
    "type": "MainStory",
    "info": {
        "story_id": "18501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "神楽人間やめるってよ"
    },
    "entry":
    [
        { "location": "612/SCENARIO", "narrator": "", "text": "アニメ第18話"},
        { "location": "624/TALK"    , "narrator": "赤髪千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "625/TALK"    , "narrator": "赤髪千羽鶴", "text": "もう一度わたしと話を\nしていきますか？"},
        { "location": "626/SEL"     , "narrator": "", "text": "はい"},
        { "location": "627/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "628/ACT"     , "narrator": "", "text": "はい"},
        { "location": "629/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは……。"},
        { "location": "631/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "632/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれではこれで。"},
        { "location": "638/TALK"    , "narrator": "赤髪千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "640/TALK"    , "narrator": "赤髪千羽鶴", "text": "前回も、思考実験による\n訓練にご参加いただき、\nありがとうございました。"},
        { "location": "641/TALK"    , "narrator": "赤髪千羽鶴", "text": "２回連続でやると、\nさすがに疲れますよね。"},
        { "location": "642/SEL"     , "narrator": "", "text": "つらい…"},
        { "location": "643/SEL"     , "narrator": "", "text": "全然平気！"},
        { "location": "644/ACT"     , "narrator": "", "text": "つらい…"},
        { "location": "645/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかります！"},
        { "location": "646/TALK"    , "narrator": "赤髪千羽鶴", "text": "でもそれは、本気で\n取り組んでくれている\n証拠です。"},
        { "location": "647/TALK"    , "narrator": "赤髪千羽鶴", "text": "だから、最大の敬意を\n表したいと思います。"},
        { "location": "648/ACT"     , "narrator": "", "text": "全然平気！"},
        { "location": "649/TALK"    , "narrator": "赤髪千羽鶴", "text": "それは良かったです！"},
        { "location": "650/TALK"    , "narrator": "赤髪千羽鶴", "text": "思考実験の選択前にも、\nお気軽に、と書いておいて\nいましたし――"},
        { "location": "651/TALK"    , "narrator": "赤髪千羽鶴", "text": "恐らくそれを見て、\n安心して選択して\n下さったのでしょう。"},
        { "location": "652/TALK"    , "narrator": "赤髪千羽鶴", "text": "人間が成功率を高める為の\n最も効果的な要素は、\n精神の安定だそうですよ。"},
        { "location": "654/TALK"    , "narrator": "赤髪千羽鶴", "text": "というわけで、\n早速ですが、前回の結果を\n公表したいと思います。"},
        { "location": "655/TALK"    , "narrator": "赤髪千羽鶴", "text": "もちろんこれは、単なる\n結果の公開ですから――"},
        { "location": "656/TALK"    , "narrator": "赤髪千羽鶴", "text": "見なくても何も\n問題はありません。"},
        { "location": "657/SEL"     , "narrator": "", "text": "見る"},
        { "location": "658/SEL"     , "narrator": "", "text": "見ない"},
        { "location": "659/ACT"     , "narrator": "", "text": "見る"},
        { "location": "660/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "661/TALK"    , "narrator": "赤髪千羽鶴", "text": "前回の思考実験は――"},
        { "location": "662/TALK"    , "narrator": "赤髪千羽鶴", "text": "あなたの大切な人がいる\n世界を守るため、あなたは\n何を選択するか、でした。"},
        { "location": "663/TALK"    , "narrator": "赤髪千羽鶴", "text": "それではまず最初に、\n単純結果を公表します。"},
        { "location": "669/TALK"    , "narrator": "赤髪千羽鶴", "text": "大切な人を護る為に、\n攻撃ボタンを\n押すか否かの結果です。"},
        { "location": "670/TALK"    , "narrator": "赤髪千羽鶴", "text": "計測時刻は、対向時間に\nおける2018年3月16日、\n13:25現在となります。"},
        { "location": "671/TALK"    , "narrator": "赤髪千羽鶴", "text": "攻撃ボタンを押す、と\n答えた人は52.8%――"},
        { "location": "672/TALK"    , "narrator": "赤髪千羽鶴", "text": "押さなかった人は\n47.2％という結果でした。"},
        { "location": "676/SEL"     , "narrator": "", "text": "もっと押す人が多いと思ってた"},
        { "location": "677/SEL"     , "narrator": "", "text": "もっと押さない人が多いと思ってた"},
        { "location": "678/SEL"     , "narrator": "", "text": "予想通り"},
        { "location": "679/ACT"     , "narrator": "", "text": "もっと押す人が多いと思ってた"},
        { "location": "680/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうですね。\nわたしもそうかなと\n思ってました。"},
        { "location": "681/TALK"    , "narrator": "赤髪千羽鶴", "text": "いえ、むしろ私の\n個人的な予測としては――"},
        { "location": "682/ACT"     , "narrator": "", "text": "もっと押さない人が多いと思ってた"},
        { "location": "683/TALK"    , "narrator": "赤髪千羽鶴", "text": "なるほど。\nあなたのような人が\n世界に溢れていたら――"},
        { "location": "684/TALK"    , "narrator": "赤髪千羽鶴", "text": "世の中はもっと\n平和で住みやすいもの\nだったかもしれません。"},
        { "location": "685/TALK"    , "narrator": "赤髪千羽鶴", "text": "かくいう\nわたしはといえば――"},
        { "location": "686/ACT"     , "narrator": "", "text": "予想通り"},
        { "location": "687/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんは、\nとてもバランスが取れた\n方なんですね。"},
        { "location": "688/TALK"    , "narrator": "赤髪千羽鶴", "text": "かくいう\nわたしはといえば――"},
        { "location": "690/TALK"    , "narrator": "赤髪千羽鶴", "text": "7割近くの人が\n攻撃ボタンを押すのでは？\nと思っていた程です。"},
        { "location": "691/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、この結果を前に\nわたしは大いに\n反省せねばなりません。"},
        { "location": "692/TALK"    , "narrator": "赤髪千羽鶴", "text": "かくして、攻撃する人と\nしない人は、概ね\n半々という結果でした。"},
        { "location": "693/TALK"    , "narrator": "赤髪千羽鶴", "text": "要するに、攻撃ボタンを\n押した人の半分は、\n彼女に大負傷をさせ――"},
        { "location": "694/TALK"    , "narrator": "赤髪千羽鶴", "text": "ボタンを押さなかった人の\n半分は、この世界から\n消えた事になります。"},
        { "location": "696/TALK"    , "narrator": "赤髪千羽鶴", "text": "あなたは、最終的には\n『攻撃ボタンを押す』方を\n選択しました。"},
        { "location": "697/TALK"    , "narrator": "赤髪千羽鶴", "text": "もしこの結果を先\nに知っていたら、あなたの\n選択は変わってましたか？"},
        { "location": "698/SEL"     , "narrator": "", "text": "変わっていた"},
        { "location": "699/SEL"     , "narrator": "", "text": "変わっていない"},
        { "location": "700/ACT"     , "narrator": "", "text": "変わっていた"},
        { "location": "702/TALK"    , "narrator": "赤髪千羽鶴", "text": "なるほど。"},
        { "location": "703/TALK"    , "narrator": "赤髪千羽鶴", "text": "それは、予想以上に\nボタンを押す人が\n少なかったからですか？"},
        { "location": "704/TALK"    , "narrator": "赤髪千羽鶴", "text": "いずれにせよ、好意的に\n見れば、あなたの変更は\n賞賛に値するものです。"},
        { "location": "705/TALK"    , "narrator": "赤髪千羽鶴", "text": "他の全員が結果を見て\n押さない方に変えたなら。"},
        { "location": "706/TALK"    , "narrator": "赤髪千羽鶴", "text": "全ての世界は\n幸せなままに存続を\n許されるからです。"},
        { "location": "707/ACT"     , "narrator": "", "text": "変わっていない"},
        { "location": "709/TALK"    , "narrator": "赤髪千羽鶴", "text": "なるほど。"},
        { "location": "710/TALK"    , "narrator": "赤髪千羽鶴", "text": "その理由は、あなたの中に\n確固たる信念があったから\nなのか、それとも――"},
        { "location": "711/TALK"    , "narrator": "赤髪千羽鶴", "text": "仮に押さないという人が\n9割を超えていた場合は\n変わっていたのか。"},
        { "location": "712/TALK"    , "narrator": "赤髪千羽鶴", "text": "その答えは、\nあなたの中にだけ\nあればそれでよいです。"},
        { "location": "716/TALK"    , "narrator": "赤髪千羽鶴", "text": "あなたは、最終的には\n『攻撃ボタンを押さない』\n方を選択しました。"},
        { "location": "717/TALK"    , "narrator": "赤髪千羽鶴", "text": "もしこの結果を先\nに知っていたら、あなたの\n選択は変わってましたか？"},
        { "location": "718/SEL"     , "narrator": "", "text": "変わっていた"},
        { "location": "719/SEL"     , "narrator": "", "text": "変わっていない"},
        { "location": "720/ACT"     , "narrator": "", "text": "変わっていた"},
        { "location": "722/TALK"    , "narrator": "赤髪千羽鶴", "text": "なるほど。"},
        { "location": "723/TALK"    , "narrator": "赤髪千羽鶴", "text": "身の危険を感じた、\nということでしょうか？"},
        { "location": "724/TALK"    , "narrator": "赤髪千羽鶴", "text": "この回答の変更意志から\n分析するならば――"},
        { "location": "725/TALK"    , "narrator": "赤髪千羽鶴", "text": "世界はあなたが思う以上に\n優しくはなかった、という\n事なのかもしれません。"},
        { "location": "726/TALK"    , "narrator": "赤髪千羽鶴", "text": "もちろん、実際の世界が\n絶対的な優しさや厳しさを\n持つわけではありません。"},
        { "location": "727/TALK"    , "narrator": "赤髪千羽鶴", "text": "あくまで、あなたの主観に\nおいてはそうなのかも、\nというだけの話です。"},
        { "location": "728/TALK"    , "narrator": "赤髪千羽鶴", "text": "いずれにせよ、\nあなたの選択変更に\nよって――"},
        { "location": "729/TALK"    , "narrator": "赤髪千羽鶴", "text": "より多くの世界が\nこの世から消えることに\nなりました。"},
        { "location": "730/TALK"    , "narrator": "赤髪千羽鶴", "text": "責めているわけではなく、\n事実としてそうであると\nいうだけの話ですよ？"},
        { "location": "731/TALK"    , "narrator": "赤髪千羽鶴", "text": "もちろん、あなたの世界が\n消えなくなることの方が\n重要なわけですから。"},
        { "location": "732/ACT"     , "narrator": "", "text": "変わっていない"},
        { "location": "734/TALK"    , "narrator": "赤髪千羽鶴", "text": "なるほど。"},
        { "location": "735/TALK"    , "narrator": "赤髪千羽鶴", "text": "なおも貴方は\n世界を信じるという\nわけですね。"},
        { "location": "736/TALK"    , "narrator": "赤髪千羽鶴", "text": "とても慈愛に満ちた\n選択だと思います。"},
        { "location": "737/TALK"    , "narrator": "赤髪千羽鶴", "text": "それは、貴方にとっては\nどんな状況であろうとも―"},
        { "location": "738/TALK"    , "narrator": "赤髪千羽鶴", "text": "罪も無い人を消してしまう\nことは許されない、\nということでしょうか。"},
        { "location": "739/TALK"    , "narrator": "赤髪千羽鶴", "text": "それが例え、最愛の人の\n命と引き替えであっても。"},
        { "location": "740/TALK"    , "narrator": "赤髪千羽鶴", "text": "それとも、５０％あれば\n助かるのではないかという\n楽観測でしょうか。"},
        { "location": "743/SEL"     , "narrator": "", "text": "もしかして$me$のした選択、ディスられてる？"},
        { "location": "744/ACT"     , "narrator": "", "text": "もしかして$me$のした選択、ディスられてる？"},
        { "location": "746/TALK"    , "narrator": "赤髪千羽鶴", "text": "いえ！\n全然そんなつもりは。"},
        { "location": "747/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただわたしが\nお伝えしたかったのは――"},
        { "location": "748/TALK"    , "narrator": "赤髪千羽鶴", "text": "この問題には、個人という\n枠組みの中にはトゥルー\nエンドがないという事です"},
        { "location": "749/TALK"    , "narrator": "赤髪千羽鶴", "text": "その為に、敢えて\nデメリットを強調させて\nいただきました。"},
        { "location": "750/TALK"    , "narrator": "赤髪千羽鶴", "text": "トゥルーエンドが\n何かはわかりますよね。"},
        { "location": "751/TALK"    , "narrator": "赤髪千羽鶴", "text": "100人中100人が、\n攻撃ボタンを押さない\n選択をすることです。"},
        { "location": "752/TALK"    , "narrator": "赤髪千羽鶴", "text": "とはいえ、個々の人達が\n単独でこの答えを作り出す\nことはできません。"},
        { "location": "753/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、\nそうなってくると――"},
        { "location": "754/TALK"    , "narrator": "赤髪千羽鶴", "text": "ボタンを押した人も、\n押さなかった人も。"},
        { "location": "755/TALK"    , "narrator": "赤髪千羽鶴", "text": "それはどちらも\n正しい選択でもあり、\n後悔する選択でもある。"},
        { "location": "756/TALK"    , "narrator": "赤髪千羽鶴", "text": "選択する理由は、それぞれ\n違って当然ですし、\n皆間違っていません。"},
        { "location": "757/TALK"    , "narrator": "赤髪千羽鶴", "text": "強いて間違いが\nあるとするならば――"},
        { "location": "758/TALK"    , "narrator": "赤髪千羽鶴", "text": "その選択結果に対して、\n貴方自身が後悔したとき。\nそれだけでしょう。"},
        { "location": "759/TALK"    , "narrator": "赤髪千羽鶴", "text": "大事なのは、\n何故あなたがそちらを\n選択したか、なんです。"},
        { "location": "760/SEL"     , "narrator": "", "text": "確かにその通り"},
        { "location": "761/SEL"     , "narrator": "", "text": "てか、100人中100人にボタンを押させない事が出来る人がいれば解決じゃね？"},
        { "location": "762/ACT"     , "narrator": "", "text": "確かにその通り"},
        { "location": "763/ACT"     , "narrator": "", "text": "てか、100人中100人にボタンを押させない事が出来る人がいれば解決じゃね？"},
        { "location": "764/TALK"    , "narrator": "赤髪千羽鶴", "text": "あ。"},
        { "location": "765/TALK"    , "narrator": "赤髪千羽鶴", "text": "いいところに\n気がつきましたね。"},
        { "location": "766/TALK"    , "narrator": "赤髪千羽鶴", "text": "実はこれ、わたしたちの\n世界では既に実現可能な\n域に達してるんですよ。"},
        { "location": "767/SEL"     , "narrator": "", "text": "あっ！！"},
        { "location": "768/SEL"     , "narrator": "", "text": "えっ！？"},
        { "location": "769/ACT"     , "narrator": "", "text": "あっ！！"},
        { "location": "770/ACT"     , "narrator": "", "text": "えっ！？"},
        { "location": "772/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうです。\nRedinessです。"},
        { "location": "773/TALK"    , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "774/TALK"    , "narrator": "赤髪千羽鶴", "text": "――と、閑話休題でした。"},
        { "location": "775/TALK"    , "narrator": "赤髪千羽鶴", "text": "まあ、そういった\n余談はともかく！"},
        { "location": "776/TALK"    , "narrator": "赤髪千羽鶴", "text": "今回の思考実験の主題は、\nあなた自身がどう考えるか\n自分に問うことなんです。"},
        { "location": "777/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、貴方なりの\n選択に対する考えを\n明確にしてみて下さいね。"},
        { "location": "780/TALK"    , "narrator": "赤髪千羽鶴", "text": "さて。"},
        { "location": "781/TALK"    , "narrator": "赤髪千羽鶴", "text": "今回の結果発表には、\nオマケがあります。"},
        { "location": "782/TALK"    , "narrator": "赤髪千羽鶴", "text": "とても興味深い\nデータなので、是非\n見ていって下さい！"},
        { "location": "783/SEL"     , "narrator": "", "text": "なになに！？"},
        { "location": "784/SEL"     , "narrator": "", "text": "また心が折れるヤツ？"},
        { "location": "785/ACT"     , "narrator": "", "text": "なになに！？"},
        { "location": "786/TALK"    , "narrator": "赤髪千羽鶴", "text": "ふふっ。"},
        { "location": "787/ACT"     , "narrator": "", "text": "また心が折れるヤツ？"},
        { "location": "788/TALK"    , "narrator": "赤髪千羽鶴", "text": "ち、違いますよ！？"},
        { "location": "789/TALK"    , "narrator": "赤髪千羽鶴", "text": "本当に興味本位で\nまとめてみた、\n面白いデータなんです。"},
        { "location": "791/TALK"    , "narrator": "赤髪千羽鶴", "text": "それが何かと\nいいますと――"},
        { "location": "794/TALK"    , "narrator": "赤髪千羽鶴", "text": "<color=red><size=35>彼女別、\n押したか否か\n徹底比較！</size></color>"},
        { "location": "795/TALK"    , "narrator": "赤髪千羽鶴", "text": "です。"},
        { "location": "796/TALK"    , "narrator": "赤髪千羽鶴", "text": "世界にかかわっている\n皆さんでワイワイやる時の\n話の種にどうぞ。"},
        { "location": "797/TALK"    , "narrator": "赤髪千羽鶴", "text": "最初は、１人ずつ\n円グラフで発表しようと\n思ったのですが――"},
        { "location": "798/TALK"    , "narrator": "赤髪千羽鶴", "text": "もっとわかりやすい\nグラフを思いついたので\nそれを用意してみました！"},
        { "location": "803/TALK"    , "narrator": "赤髪千羽鶴", "text": "というわけで、\nそれがこちらです！"},
        { "location": "804/TALK"    , "narrator": "赤髪千羽鶴", "text": "これは、各彼女ごとに――"},
        { "location": "805/TALK"    , "narrator": "赤髪千羽鶴", "text": "攻撃ボタンを押した人の\n％から押してない人の％を\n引いた差分のグラフです。"},
        { "location": "806/TALK"    , "narrator": "赤髪千羽鶴", "text": "右へ大きく出ている程、\n攻撃ボタンを押した人の\n割合が高く。"},
        { "location": "807/TALK"    , "narrator": "赤髪千羽鶴", "text": "左へ大きく出ている程、\n攻撃ボタンを押していない\n人の割合が高い。"},
        { "location": "813/TALK"    , "narrator": "赤髪千羽鶴", "text": "こうすると、\n少し見やすくなるかも\nしれません。"},
        { "location": "814/TALK"    , "narrator": "赤髪千羽鶴", "text": "思いの外、支持する\nヒロインによって差がある\nのだと思いました！"},
        { "location": "815/TALK"    , "narrator": "赤髪千羽鶴", "text": "最も攻撃ボタンを\n押す率が高かったのが\n卯月さんを守りたい人。"},
        { "location": "816/TALK"    , "narrator": "赤髪千羽鶴", "text": "最も押さない率が\n高かったのが、\nエリカさんを守りたい人。"},
        { "location": "817/TALK"    , "narrator": "赤髪千羽鶴", "text": "これを見て、\nあなたはどう思いますか？"},
        { "location": "819/SEL"     , "narrator": "", "text": "すごくわかる！！"},
        { "location": "820/SEL"     , "narrator": "", "text": "意外だ！！"},
        { "location": "821/ACT"     , "narrator": "", "text": "すごくわかる！！"},
        { "location": "822/TALK"    , "narrator": "赤髪千羽鶴", "text": "なるほど。"},
        { "location": "823/ACT"     , "narrator": "", "text": "意外だ！！"},
        { "location": "824/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうですか。"},
        { "location": "828/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしなりに\n分析をしてみるなら――"},
        { "location": "829/TALK"    , "narrator": "赤髪千羽鶴", "text": "愛する人の好みと\n生き方のスタンスとには、\n相関関係がある。"},
        { "location": "830/TALK"    , "narrator": "赤髪千羽鶴", "text": "――といった\nところでしょうか！"},
        { "location": "831/TALK"    , "narrator": "赤髪千羽鶴", "text": "例えば、\n可愛いつばめさんや、\nエリカさん。"},
        { "location": "832/TALK"    , "narrator": "赤髪千羽鶴", "text": "彼女らは、恐らく\nボタンを押すことを\n嫌がるタイプでしょう。"},
        { "location": "833/TALK"    , "narrator": "赤髪千羽鶴", "text": "ふたりとも、他人を信じて\n行動するタイプですし、\nのんびりさんですから。"},
        { "location": "834/TALK"    , "narrator": "赤髪千羽鶴", "text": "彼女たちを愛する人たちは\n彼女たちが否定すると\n考えたのかもしれません。"},
        { "location": "835/TALK"    , "narrator": "赤髪千羽鶴", "text": "逆に、卯月さんの支持母体\nとなる人達は、圧倒的に\n攻撃を選択しています。"},
        { "location": "836/TALK"    , "narrator": "赤髪千羽鶴", "text": "これは、卯月さんの\n今置かれている状況と、\n彼女を守りたい気持ち――"},
        { "location": "837/TALK"    , "narrator": "赤髪千羽鶴", "text": "そういったものが、\n数値として出ているのかも\nしれません。"},
        { "location": "838/TALK"    , "narrator": "赤髪千羽鶴", "text": "もっと過激な回答を\nするのであれば。"},
        { "location": "839/TALK"    , "narrator": "赤髪千羽鶴", "text": "そういった、世界全体が\n敵であるような子を、\n自分が守ってみせると。"},
        { "location": "840/TALK"    , "narrator": "赤髪千羽鶴", "text": "そういった想いが\n強く表れている\n結果かもしれませんね。"},
        { "location": "841/TALK"    , "narrator": "赤髪千羽鶴", "text": "次に攻撃傾向が強いのが\n同ポイントで、\nみやびさんと千羽鶴。"},
        { "location": "842/TALK"    , "narrator": "赤髪千羽鶴", "text": "双方とも、非常に慎重で\n現実主義という点が\n近似傾向としてあります。"},
        { "location": "843/TALK"    , "narrator": "赤髪千羽鶴", "text": "そのスタンスに共感する\n方が、支持母体となって\nいるのかもしれません。"},
        { "location": "844/TALK"    , "narrator": "赤髪千羽鶴", "text": "アーヤさんと\nガブちゃんは、\n本当に平均的ですね。"},
        { "location": "845/TALK"    , "narrator": "赤髪千羽鶴", "text": "彼女らは、あまり\n世界情勢に対して偏った\nスタンスを持ちません。"},
        { "location": "846/TALK"    , "narrator": "赤髪千羽鶴", "text": "よくいえば\nケセラセラ。"},
        { "location": "847/TALK"    , "narrator": "赤髪千羽鶴", "text": "積極的に世界の深みに\n填まるタイプの子たちでも\nありませんから――"},
        { "location": "848/TALK"    , "narrator": "赤髪千羽鶴", "text": "そういったところが、\n現れているのかも\nしれません。"},
        { "location": "852/TALK"    , "narrator": "赤髪千羽鶴", "text": "以上、あくまで\nわたしの個人的分析付き、\nおまけデータでした。"},
        { "location": "853/TALK"    , "narrator": "赤髪千羽鶴", "text": "どうでしたか？"},
        { "location": "854/SEL"     , "narrator": "", "text": "面白かった！"},
        { "location": "855/SEL"     , "narrator": "", "text": "退屈だった"},
        { "location": "856/ACT"     , "narrator": "", "text": "面白かった！"},
        { "location": "857/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですよね。\nわたしも\n面白かったです。"},
        { "location": "858/ACT"     , "narrator": "", "text": "退屈だった"},
        { "location": "859/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうですか。\nそれは残念です。"},
        { "location": "861/TALK"    , "narrator": "赤髪千羽鶴", "text": "なんか、こういうのを\n見られる楽しみって――"},
        { "location": "862/TALK"    , "narrator": "赤髪千羽鶴", "text": "献血した後にもらえる\n血液検査結果のデータと\n似てますよね！"},
        { "location": "863/SEL"     , "narrator": "", "text": "わかる"},
        { "location": "864/SEL"     , "narrator": "", "text": "わからん"},
        { "location": "865/ACT"     , "narrator": "", "text": "わかる"},
        { "location": "866/TALK"    , "narrator": "赤髪千羽鶴", "text": "ふふ～。"},
        { "location": "867/ACT"     , "narrator": "", "text": "わからん"},
        { "location": "868/TALK"    , "narrator": "赤髪千羽鶴", "text": "あらら。"},
        { "location": "870/TALK"    , "narrator": "赤髪千羽鶴", "text": "というわけで、\n今回のお話は\nおしまいです。"},
        { "location": "871/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして、\n思考実験による訓練も、\n今回でお終いになります。"},
        { "location": "872/ACT"     , "narrator": "", "text": "見ない"},
        { "location": "873/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "874/TALK"    , "narrator": "赤髪千羽鶴", "text": "ちなみに、\n思考実験による訓練は、\n前回でお終いになります。"},
        { "location": "876/TALK"    , "narrator": "赤髪千羽鶴", "text": "千羽鶴の予定によれば――"},
        { "location": "877/TALK"    , "narrator": "赤髪千羽鶴", "text": "次回あたりから\nリプレイスが開始\nとのことですので。"},
        { "location": "878/TALK"    , "narrator": "赤髪千羽鶴", "text": "短い時間でしたが、\nありがとうございました。"},
        { "location": "879/TALK"    , "narrator": "赤髪千羽鶴", "text": "お陰様で、リプレイスの\n開始に向けた準備を\n整えられました。"},
        { "location": "880/SEL"     , "narrator": "", "text": "それはよかった"},
        { "location": "881/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "882/ACT"     , "narrator": "", "text": "それはよかった"},
        { "location": "883/TALK"    , "narrator": "赤髪千羽鶴", "text": "はい。"},
        { "location": "884/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "885/TALK"    , "narrator": "赤髪千羽鶴", "text": "？"},
        { "location": "888/TALK"    , "narrator": "赤髪千羽鶴", "text": "本日はちょっとだけ\n悲しいお知らせが\nあります！"},
        { "location": "889/SEL"     , "narrator": "", "text": "え、なに…？"},
        { "location": "890/ACT"     , "narrator": "", "text": "え、なに…？"},
        { "location": "892/TALK"    , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "893/TALK"    , "narrator": "赤髪千羽鶴", "text": "いえ！\n嬉しいお知らせもあるので\nきっと相殺です！"},
        { "location": "894/TALK"    , "narrator": "赤髪千羽鶴", "text": "どっちから\nお話しましょうか！"},
        { "location": "896/SEL"     , "narrator": "", "text": "悲しいお知らせ"},
        { "location": "897/SEL"     , "narrator": "", "text": "嬉しいお知らせ"},
        { "location": "898/ACT"     , "narrator": "", "text": "悲しいお知らせ"},
        { "location": "899/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "901/TALK"    , "narrator": "赤髪千羽鶴", "text": "悲しいお知らせと\nいうのは――"},
        { "location": "902/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしとのデートが\n今回で最後になる、\nというものです。"},
        { "location": "904/SEL"     , "narrator": "", "text": "ええっ！　寂しいよ…"},
        { "location": "905/SEL"     , "narrator": "", "text": "なんだそんなことか"},
        { "location": "906/ACT"     , "narrator": "", "text": "ええっ！　寂しいよ…"},
        { "location": "907/TALK"    , "narrator": "赤髪千羽鶴", "text": "ごめんなさい。\nいろいろやらなくちゃ\nいけないことがあって。"},
        { "location": "908/TALK"    , "narrator": "赤髪千羽鶴", "text": "でも、もしかしたら\nまた戻ってこれるかも\nしれません！"},
        { "location": "909/TALK"    , "narrator": "赤髪千羽鶴", "text": "なので、ひとまず\n数回だけ待っていて\nいただけないでしょうか！"},
        { "location": "910/ACT"     , "narrator": "", "text": "なんだそんなことか"},
        { "location": "911/TALK"    , "narrator": "赤髪千羽鶴", "text": "はい。\nそんなことです。"},
        { "location": "915/TALK"    , "narrator": "赤髪千羽鶴", "text": "そしてもう１つの方。"},
        { "location": "918/ACT"     , "narrator": "", "text": "嬉しいお知らせ"},
        { "location": "919/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "921/TALK"    , "narrator": "赤髪千羽鶴", "text": "嬉しいお知らせと\nいうのは――"},
        { "location": "922/TALK"    , "narrator": "赤髪千羽鶴", "text": "次回エピソード１５から\n海編がスタート\nしますよね！"},
        { "location": "923/TALK"    , "narrator": "赤髪千羽鶴", "text": "海と言えば一夏の思い出！\nそして、エピソード\n本編では――"},
        { "location": "924/TALK"    , "narrator": "赤髪千羽鶴", "text": "可愛いつばめたちとの\n追加特盛ラブラブタイムが\n幕を開けちゃいます！"},
        { "location": "925/SEL"     , "narrator": "", "text": "やったー！"},
        { "location": "926/SEL"     , "narrator": "", "text": "でも合宿期間って色々大変じゃなかったっけ？？"},
        { "location": "927/ACT"     , "narrator": "", "text": "やったー！"},
        { "location": "928/TALK"    , "narrator": "赤髪千羽鶴", "text": "やりましたねっ！"},
        { "location": "929/TALK"    , "narrator": "赤髪千羽鶴", "text": "思い返してみてください？"},
        { "location": "930/TALK"    , "narrator": "赤髪千羽鶴", "text": "彼女達と遊んだ日々。\n眩しい笑顔！"},
        { "location": "931/TALK"    , "narrator": "赤髪千羽鶴", "text": "可愛い水着！"},
        { "location": "932/TALK"    , "narrator": "赤髪千羽鶴", "text": "独り占めしたい！\nその瞳と唇！"},
        { "location": "933/TALK"    , "narrator": "赤髪千羽鶴", "text": "あなたにとっては\n二度目の夏になる、この\nエピソード１５からは――"},
        { "location": "934/TALK"    , "narrator": "赤髪千羽鶴", "text": "前回以上の濃厚ラブを\n楽しめるよう、\n切り取ってみました！"},
        { "location": "935/ACT"     , "narrator": "", "text": "でも合宿期間って色々大変じゃなかったっけ？？"},
        { "location": "936/TALK"    , "narrator": "赤髪千羽鶴", "text": "何言ってるんですか！\n$handle$さん！"},
        { "location": "937/TALK"    , "narrator": "赤髪千羽鶴", "text": "まあ確かに、\n色んな事件はありました。"},
        { "location": "938/TALK"    , "narrator": "赤髪千羽鶴", "text": "でもでも！\n真夏の合宿にハプニングは\nつきもの！"},
        { "location": "939/TALK"    , "narrator": "赤髪千羽鶴", "text": "それだけのことですよ。"},
        { "location": "941/TALK"    , "narrator": "赤髪千羽鶴", "text": "思い返してみてください？"},
        { "location": "942/TALK"    , "narrator": "赤髪千羽鶴", "text": "彼女達と遊んだ日々。\n眩しい笑顔！"},
        { "location": "943/TALK"    , "narrator": "赤髪千羽鶴", "text": "可愛い水着！"},
        { "location": "944/TALK"    , "narrator": "赤髪千羽鶴", "text": "独り占めしたい！\nその瞳と唇！"},
        { "location": "945/TALK"    , "narrator": "赤髪千羽鶴", "text": "人はショッキングなことが\nあると、どうしても意識が\n偏りがちです。"},
        { "location": "946/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですが実際、彼女達の\n合宿期間中における、\n事件の時間はとても短い。"},
        { "location": "947/TALK"    , "narrator": "赤髪千羽鶴", "text": "全8日間の合宿期間中、\n緊迫していたのは、\n最後の1日だけです。"},
        { "location": "948/TALK"    , "narrator": "赤髪千羽鶴", "text": "それ以外の7日間は、\n彼女達は皆、とても\n楽しんでいたわけです。"},
        { "location": "949/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして、あなたにとっては\n二度目の夏になる、この\nエピソード１５からは――"},
        { "location": "950/TALK"    , "narrator": "赤髪千羽鶴", "text": "前回以上の濃厚ラブを\n楽しめるよう、\n切り取ってみました！"},
        { "location": "952/TALK"    , "narrator": "赤髪千羽鶴", "text": "というわけで、\n次回以降、\nどうぞお楽しみに！"},
        { "location": "955/TALK"    , "narrator": "赤髪千羽鶴", "text": "そしてもう１つの方。"},
        { "location": "959/TALK"    , "narrator": "赤髪千羽鶴", "text": "…とまあ、\nそんな感じの２つの\nニュースでした。"},
        { "location": "960/TALK"    , "narrator": "赤髪千羽鶴", "text": "というわけで――"},
        { "location": "961/TALK"    , "narrator": "赤髪千羽鶴", "text": "次からわたしとは\nしばらくデートできなく\nなってしまいますので！"},
        { "location": "962/TALK"    , "narrator": "赤髪千羽鶴", "text": "今回はちょっと\n素敵な夜景でも\n見に行きませんか？"},
        { "location": "963/SEL"     , "narrator": "", "text": "レベルアップしてる！"},
        { "location": "964/SEL"     , "narrator": "", "text": "オトナ～～"},
        { "location": "965/ACT"     , "narrator": "", "text": "レベルアップしてる！"},
        { "location": "967/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんの\n為にと思って、日々色々\n勉強してるんですよ？"},
        { "location": "968/ACT"     , "narrator": "", "text": "オトナ～～"},
        { "location": "970/TALK"    , "narrator": "赤髪千羽鶴", "text": "うふふ♪"},
        { "location": "971/TALK"    , "narrator": "赤髪千羽鶴", "text": "嬉しいです♪"},
        { "location": "974/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでは早速、\n参りましょう！"},
        { "location": "975/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしたちの\nオトナのデートへ♪"},
        { "location": "987/TALK"    , "narrator": "赤髪千羽鶴", "text": "素敵な夜景だと\n思いませんか？"},
        { "location": "988/SEL"     , "narrator": "", "text": "綺麗だね"},
        { "location": "989/SEL"     , "narrator": "", "text": "つばめの方が素敵だよ"},
        { "location": "990/SEL"     , "narrator": "", "text": "都会は好きじゃない"},
        { "location": "991/ACT"     , "narrator": "", "text": "綺麗だね"},
        { "location": "992/TALK"    , "narrator": "赤髪千羽鶴", "text": "よかったです。\n気に入ってもらえて！"},
        { "location": "993/ACT"     , "narrator": "", "text": "つばめの方が素敵だよ"},
        { "location": "994/TALK"    , "narrator": "赤髪千羽鶴", "text": "えっ……"},
        { "location": "995/TALK"    , "narrator": "赤髪千羽鶴", "text": "ありがとうございます。"},
        { "location": "996/ACT"     , "narrator": "", "text": "都会は好きじゃない"},
        { "location": "998/TALK"    , "narrator": "赤髪千羽鶴", "text": "ああっ、\nそうだったんですね。\nごめんなさい……。"},
        { "location": "999/TALK"    , "narrator": "赤髪千羽鶴", "text": "最後のデートなのに、\nご満足いただけないものに\nなっちゃいましたね。"},
        { "location": "1001/TALK"   , "narrator": "赤髪千羽鶴", "text": "でも、もしよろしければ\n少しの間だけ、わたしと\nお付き合いくださいね。"},
        { "location": "1004/TALK"   , "narrator": "赤髪千羽鶴", "text": "あの…"},
        { "location": "1007/TALK"   , "narrator": "赤髪千羽鶴", "text": "好きです！"},
        { "location": "1008/SEL"    , "narrator": "", "text": "じゃあキスしよう！！"},
        { "location": "1009/SEL"    , "narrator": "", "text": "唐突過ぎ！！！"},
        { "location": "1010/ACT"    , "narrator": "", "text": "じゃあキスしよう！！"},
        { "location": "1021/SEL"    , "narrator": "", "text": "…あれ？"},
        { "location": "1022/ACT"    , "narrator": "", "text": "…あれ？"},
        { "location": "1026/TALK"   , "narrator": "赤髪千羽鶴", "text": "……すみません！\nやっぱりナシで！"},
        { "location": "1027/SEL"    , "narrator": "", "text": "ええっ！"},
        { "location": "1028/SEL"    , "narrator": "", "text": "無理しないで"},
        { "location": "1029/ACT"    , "narrator": "", "text": "ええっ！"},
        { "location": "1030/TALK"   , "narrator": "赤髪千羽鶴", "text": "ご、ごめんなさい。"},
        { "location": "1031/ACT"    , "narrator": "", "text": "無理しないで"},
        { "location": "1032/TALK"   , "narrator": "赤髪千羽鶴", "text": "ありがとうございます。"},
        { "location": "1034/TALK"   , "narrator": "赤髪千羽鶴", "text": "やっぱりいざとなると\n緊張しちゃって……"},
        { "location": "1035/TALK"   , "narrator": "赤髪千羽鶴", "text": "ごめんなさい……。"},
        { "location": "1036/SEL"    , "narrator": "", "text": "ゆっくり、できることからやっていけばいいよ"},
        { "location": "1037/SEL"    , "narrator": "", "text": "ていうか、そもそも$me$のこと本当に好きなの？"},
        { "location": "1038/ACT"    , "narrator": "", "text": "ゆっくり、できることからやっていけばいいよ"},
        { "location": "1040/TALK"   , "narrator": "赤髪千羽鶴", "text": "はい……。"},
        { "location": "1041/TALK"   , "narrator": "赤髪千羽鶴", "text": "ありがとうございます。"},
        { "location": "1043/ACT"    , "narrator": "", "text": "ていうか、そもそも$me$のこと本当に好きなの？"},
        { "location": "1044/TALK"   , "narrator": "赤髪千羽鶴", "text": "えっ…！？"},
        { "location": "1045/SEL"    , "narrator": "", "text": "今のは、怖くて拒絶したんじゃないの？"},
        { "location": "1046/ACT"    , "narrator": "", "text": "今のは、怖くて拒絶したんじゃないの？"},
        { "location": "1049/TALK"   , "narrator": "赤髪千羽鶴", "text": "それは……"},
        { "location": "1050/TALK"   , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "1052/TALK"   , "narrator": "赤髪千羽鶴", "text": "確かに、\nそうかもしれません。"},
        { "location": "1053/TALK"   , "narrator": "赤髪千羽鶴", "text": "けど、\n$handle$さんに\n満足してもらいたくて。"},
        { "location": "1054/TALK"   , "narrator": "赤髪千羽鶴", "text": "ダメでしたけど。"},
        { "location": "1055/SEL"    , "narrator": "", "text": "ダメじゃないよ"},
        { "location": "1056/SEL"    , "narrator": "", "text": "そういうのじゃないんだよ"},
        { "location": "1057/ACT"    , "narrator": "", "text": "ダメじゃないよ"},
        { "location": "1064/TALK"   , "narrator": "赤髪千羽鶴", "text": "そうでしょうか。"},
        { "location": "1065/TALK"   , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "1066/TALK"   , "narrator": "赤髪千羽鶴", "text": "でも、ありがとう\nございます！"},
        { "location": "1067/TALK"   , "narrator": "赤髪千羽鶴", "text": "あまり落ち込んでいても、\n$handle$さんに\n気を使わせちゃうし。"},
        { "location": "1068/TALK"   , "narrator": "赤髪千羽鶴", "text": "ちゃんと自分で勉強して、\n自分なりの答えを\n見つけ出します。"},
        { "location": "1069/TALK"   , "narrator": "赤髪千羽鶴", "text": "それと、この償いは、\n必ずどこかでしますから！"},
        { "location": "1070/ACT"    , "narrator": "", "text": "そういうのじゃないんだよ"},
        { "location": "1077/TALK"   , "narrator": "赤髪千羽鶴", "text": "えっ？\nそういうのじゃない？"},
        { "location": "1078/TALK"   , "narrator": "赤髪千羽鶴", "text": "意味が分かりません！"},
        { "location": "1079/TALK"   , "narrator": "赤髪千羽鶴", "text": "……って、\nごめんなさい。"},
        { "location": "1080/TALK"   , "narrator": "赤髪千羽鶴", "text": "そんなこと言われても、\n困っちゃいますよね。"},
        { "location": "1081/TALK"   , "narrator": "赤髪千羽鶴", "text": "今の言葉は\n忘れてください。"},
        { "location": "1082/TALK"   , "narrator": "赤髪千羽鶴", "text": "自分の責任ですし、\nもっとちゃんと\n勉強してきますから！"},
        { "location": "1088/ACT"    , "narrator": "", "text": "唐突過ぎ！！！"},
        { "location": "1090/TALK"   , "narrator": "赤髪千羽鶴", "text": "えっ！\nそうなんですか？"},
        { "location": "1091/TALK"   , "narrator": "赤髪千羽鶴", "text": "夜景＋男女＝キス\nの法則があると\n文献にありました！"},
        { "location": "1092/SEL"    , "narrator": "", "text": "その文献は信じるに値しないよ"},
        { "location": "1093/SEL"    , "narrator": "", "text": "守りたい、このつばめ"},
        { "location": "1094/ACT"    , "narrator": "", "text": "その文献は信じるに値しないよ"},
        { "location": "1095/TALK"   , "narrator": "赤髪千羽鶴", "text": "そうですか……\n残念です。"},
        { "location": "1096/ACT"    , "narrator": "", "text": "守りたい、このつばめ"},
        { "location": "1097/TALK"   , "narrator": "赤髪千羽鶴", "text": "$handle$さん…"},
        { "location": "1098/SEL"    , "narrator": "", "text": "キスをする"},
        { "location": "1099/SEL"    , "narrator": "", "text": "みつめる"},
        { "location": "1100/ACT"    , "narrator": "", "text": "キスをする"},
        { "location": "1102/ACT"    , "narrator": "", "text": "みつめる"},
        { "location": "1106/TALK"   , "narrator": "赤髪千羽鶴", "text": "そ、それじゃ少し\nお話でもしませんか？"},
        { "location": "1112/SEL"    , "narrator": "", "text": "流行の芸能人の話"},
        { "location": "1113/SEL"    , "narrator": "", "text": "流行の音楽の話"},
        { "location": "1114/SEL"    , "narrator": "", "text": "好きなテレビ番組の話"},
        { "location": "1115/SEL"    , "narrator": "", "text": "今年の夏物の流行は？"},
        { "location": "1116/ACT"    , "narrator": "", "text": "流行の芸能人の話"},
        { "location": "1118/TALK"   , "narrator": "赤髪千羽鶴", "text": "えっと、\nメノウちゃんの話ですか？"},
        { "location": "1119/TALK"   , "narrator": "赤髪千羽鶴", "text": "他の芸能人のことは\n良く知らなくて……。"},
        { "location": "1120/TALK"   , "narrator": "赤髪千羽鶴", "text": "あ、でもよく漫才やってる\n火気厳禁さんは、\n面白いと思います！"},
        { "location": "1121/SEL"    , "narrator": "", "text": "ごめん、わからない…"},
        { "location": "1122/ACT"    , "narrator": "", "text": "ごめん、わからない…"},
        { "location": "1124/TALK"   , "narrator": "赤髪千羽鶴", "text": "すみません……。"},
        { "location": "1127/ACT"    , "narrator": "", "text": "流行の音楽の話"},
        { "location": "1129/TALK"   , "narrator": "赤髪千羽鶴", "text": "えっと、\nメノウちゃんの音楽の\nことですよね！"},
        { "location": "1130/TALK"   , "narrator": "赤髪千羽鶴", "text": "今度新作をまた出す\nみたいなので、\n楽しみです！"},
        { "location": "1131/TALK"   , "narrator": "赤髪千羽鶴", "text": "あと、来年こそは、\nクリスマスイベントに\n行きたいです……。"},
        { "location": "1132/TALK"   , "narrator": "赤髪千羽鶴", "text": "あれ、ファンクラブ限定で\nしかも定員40名くらい\nなんですよね。"},
        { "location": "1133/TALK"   , "narrator": "赤髪千羽鶴", "text": "倍率50倍とか\n言われてるんですよ？"},
        { "location": "1134/SEL"    , "narrator": "", "text": "い、行けるといいね"},
        { "location": "1135/ACT"    , "narrator": "", "text": "い、行けるといいね"},
        { "location": "1137/TALK"   , "narrator": "赤髪千羽鶴", "text": "がんばります！"},
        { "location": "1140/ACT"    , "narrator": "", "text": "好きなテレビ番組の話"},
        { "location": "1142/TALK"   , "narrator": "赤髪千羽鶴", "text": "世界史の紐を解く\n特集番組とか好きですね。"},
        { "location": "1143/TALK"   , "narrator": "赤髪千羽鶴", "text": "あと、\nシュメール文明とか！"},
        { "location": "1144/SEL"    , "narrator": "", "text": "ドラマとか見ないの？"},
        { "location": "1145/SEL"    , "narrator": "", "text": "アニメとか見ないの？"},
        { "location": "1146/ACT"    , "narrator": "", "text": "ドラマとか見ないの？"},
        { "location": "1147/TALK"   , "narrator": "赤髪千羽鶴", "text": "見ません。"},
        { "location": "1148/TALK"   , "narrator": "赤髪千羽鶴", "text": "対人関係に\n疑問点が多すぎて、\n頭が疲れてしまうので。"},
        { "location": "1149/TALK"   , "narrator": "赤髪千羽鶴", "text": "そもそもそんなに嫌なら\n逢わなければ良いのに\nとか――"},
        { "location": "1150/TALK"   , "narrator": "赤髪千羽鶴", "text": "もっとしっかり第三者を\n擁する形で書面にまとめて\nおけば良いのに、とか。"},
        { "location": "1151/TALK"   , "narrator": "赤髪千羽鶴", "text": "ドラマの世界の人達は、\nそういうのに\n気づかないんでしょうか。"},
        { "location": "1152/SEL"    , "narrator": "", "text": "それじゃ恋愛ドラマにならないよ"},
        { "location": "1153/SEL"    , "narrator": "", "text": "いや、一周まわってそれウケると思うよ"},
        { "location": "1154/ACT"    , "narrator": "", "text": "それじゃ恋愛ドラマにならないよ"},
        { "location": "1155/TALK"   , "narrator": "赤髪千羽鶴", "text": "じゃあやっぱり\n見るのは\n遠慮しておきますね。"},
        { "location": "1156/ACT"    , "narrator": "", "text": "いや、一周まわってそれウケると思うよ"},
        { "location": "1157/TALK"   , "narrator": "赤髪千羽鶴", "text": "本当ですか！？"},
        { "location": "1158/TALK"   , "narrator": "赤髪千羽鶴", "text": "今度なにか\n考えてみたいです！"},
        { "location": "1160/ACT"    , "narrator": "", "text": "アニメとか見ないの？"},
        { "location": "1161/TALK"   , "narrator": "赤髪千羽鶴", "text": "あまり見ませんね。\n好きではあるんですけど。"},
        { "location": "1162/TALK"   , "narrator": "赤髪千羽鶴", "text": "現実が辛いときとか、\n凄く効果ありますよね！"},
        { "location": "1163/TALK"   , "narrator": "赤髪千羽鶴", "text": "でも、あまり見過ぎると\n目的と手段がひっくり\n返ってしまうので――"},
        { "location": "1164/TALK"   , "narrator": "赤髪千羽鶴", "text": "わたしは、どうしようも\nなくなってしまった時に\n見るようにしてます。"},
        { "location": "1165/TALK"   , "narrator": "赤髪千羽鶴", "text": "日常ほんわかものが\nとっても好きです。"},
        { "location": "1166/TALK"   , "narrator": "赤髪千羽鶴", "text": "もしくは、リアリティの\nある近未来政略ものとか、\nでしょうか！"},
        { "location": "1167/SEL"    , "narrator": "", "text": "極端すぎない？"},
        { "location": "1168/ACT"    , "narrator": "", "text": "極端すぎない？"},
        { "location": "1170/TALK"   , "narrator": "赤髪千羽鶴", "text": "えっ？\nそうですか？"},
        { "location": "1174/ACT"    , "narrator": "", "text": "今年の夏物の流行は？"},
        { "location": "1176/TALK"   , "narrator": "赤髪千羽鶴", "text": "夏物…ですか？"},
        { "location": "1177/TALK"   , "narrator": "赤髪千羽鶴", "text": "うーん、\nそうですね……。"},
        { "location": "1178/TALK"   , "narrator": "赤髪千羽鶴", "text": "梅でしょうか？"},
        { "location": "1179/SEL"    , "narrator": "", "text": "？？？"},
        { "location": "1180/ACT"    , "narrator": "", "text": "？？？"},
        { "location": "1182/TALK"   , "narrator": "赤髪千羽鶴", "text": "あ、いえ、どう考えても\n夏と言えばスイカが\n定番なイメージですが――"},
        { "location": "1183/TALK"   , "narrator": "赤髪千羽鶴", "text": "スイカはここ数年で\n出荷がずっと減ってるん\nですよ。"},
        { "location": "1184/TALK"   , "narrator": "赤髪千羽鶴", "text": "果物全体がそういう\n傾向にあるのですが――"},
        { "location": "1185/TALK"   , "narrator": "赤髪千羽鶴", "text": "サクランボと洋なしと、\nあと梅は近年では出荷が\n安定か増加傾向なんです。"},
        { "location": "1186/TALK"   , "narrator": "赤髪千羽鶴", "text": "まあ、もちろんそれでも\n通年で一番出回ってる\n果物はりんごですけどね。"},
        { "location": "1187/SEL"    , "narrator": "", "text": "へー、そうなんだ！"},
        { "location": "1188/ACT"    , "narrator": "", "text": "へー、そうなんだ！"},
        { "location": "1190/TALK"   , "narrator": "赤髪千羽鶴", "text": "だから、今年の夏物は\n梅が来るんじゃないかと！"},
        { "location": "1191/SEL"    , "narrator": "", "text": "ってちがーう！"},
        { "location": "1192/ACT"    , "narrator": "", "text": "ってちがーう！"},
        { "location": "1194/TALK"   , "narrator": "赤髪千羽鶴", "text": "え？"},
        { "location": "1195/SEL"    , "narrator": "", "text": "夏物といえばファッションの話です"},
        { "location": "1196/ACT"    , "narrator": "", "text": "夏物といえばファッションの話です"},
        { "location": "1198/TALK"   , "narrator": "赤髪千羽鶴", "text": "ああっ、\nそうだったんですか。\nすみません。"},
        { "location": "1199/TALK"   , "narrator": "赤髪千羽鶴", "text": "うーん、そうですね…。"},
        { "location": "1200/TALK"   , "narrator": "赤髪千羽鶴", "text": "半袖が流行るんじゃ\nないでしょうか。"},
        { "location": "1205/TALK"   , "narrator": "赤髪千羽鶴", "text": "なんか色んなお話をしても\n全然盛り上がりませんね。"},
        { "location": "1206/TALK"   , "narrator": "赤髪千羽鶴", "text": "これで最後だと\nいうのに……。"},
        { "location": "1207/SEL"    , "narrator": "", "text": "十分盛り上がってるよ"},
        { "location": "1208/SEL"    , "narrator": "", "text": "最後なんて、寂しいこと言わないで"},
        { "location": "1209/ACT"    , "narrator": "", "text": "十分盛り上がってるよ"},
        { "location": "1210/TALK"   , "narrator": "赤髪千羽鶴", "text": "ほんとですか？"},
        { "location": "1211/TALK"   , "narrator": "赤髪千羽鶴", "text": "それじゃ、そろそろ\nキスしてくれますか？"},
        { "location": "1212/SEL"    , "narrator": "", "text": "キスする"},
        { "location": "1213/SEL"    , "narrator": "", "text": "どうしてそんなにキスしたがってるの？"},
        { "location": "1214/ACT"    , "narrator": "", "text": "キスする"},
        { "location": "1216/ACT"    , "narrator": "", "text": "どうしてそんなにキスしたがってるの？"},
        { "location": "1217/TALK"   , "narrator": "赤髪千羽鶴", "text": "二人の最後に\n相応しいじゃないですか。"},
        { "location": "1218/SEL"    , "narrator": "", "text": "最後なんて、寂しいこと言わないで"},
        { "location": "1219/ACT"    , "narrator": "", "text": "最後なんて、寂しいこと言わないで"},
        { "location": "1223/ACT"    , "narrator": "", "text": "最後なんて、寂しいこと言わないで"},
        { "location": "1231/TALK"   , "narrator": "赤髪千羽鶴", "text": "寂しくなんて\nありませんよ。"},
        { "location": "1232/TALK"   , "narrator": "赤髪千羽鶴", "text": "思い出は永遠です。"},
        { "location": "1233/TALK"   , "narrator": "赤髪千羽鶴", "text": "それに――"},
        { "location": "1234/TALK"   , "narrator": "赤髪千羽鶴", "text": "別に逢えなくなる\nわけじゃありませんし。"},
        { "location": "1235/TALK"   , "narrator": "赤髪千羽鶴", "text": "でも、とにかく\n$handle$さんの\n意向はわかりました。"},
        { "location": "1236/TALK"   , "narrator": "赤髪千羽鶴", "text": "ちょっと残念ですけど、\nキスは諦めますね。"},
        { "location": "1250/TALK"   , "narrator": "赤髪千羽鶴", "text": "ふぅ、\nただいまっと。"},
        { "location": "1251/TALK"   , "narrator": "赤髪千羽鶴", "text": "せっかくいい雰囲気を\n作りましたけど、やっぱり\nわたしじゃだめですね。"},
        { "location": "1252/TALK"   , "narrator": "赤髪千羽鶴", "text": "こんなことでは、\n$handle$さんに\n満足してもらえません。"},
        { "location": "1253/SEL"    , "narrator": "", "text": "がんばって！"},
        { "location": "1254/SEL"    , "narrator": "", "text": "つばめ自身はどうなの？"},
        { "location": "1255/ACT"    , "narrator": "", "text": "がんばって！"},
        { "location": "1256/TALK"   , "narrator": "赤髪千羽鶴", "text": "はい！\n頑張ります！"},
        { "location": "1257/ACT"    , "narrator": "", "text": "つばめ自身はどうなの？"},
        { "location": "1258/TALK"   , "narrator": "赤髪千羽鶴", "text": "わたし…ですか？"},
        { "location": "1259/TALK"   , "narrator": "赤髪千羽鶴", "text": "だから、\n満足してもらえるように\nがんばります！"},
        { "location": "1260/SEL"    , "narrator": "", "text": "そうじゃなくて、つばめ自身の気持ちとか、満足感とか"},
        { "location": "1261/ACT"    , "narrator": "", "text": "そうじゃなくて、つばめ自身の気持ちとか、満足感とか"},
        { "location": "1263/TALK"   , "narrator": "赤髪千羽鶴", "text": "わたしは\n$handle$さんが\n満足なら満足です。"},
        { "location": "1265/TALK"   , "narrator": "赤髪千羽鶴", "text": "というわけで、\n今回は以上です。"},
        { "location": "1266/TALK"   , "narrator": "赤髪千羽鶴", "text": "今まで何度も\nデートにお付き合い下さり\nありがとうございました。"},
        { "location": "1267/TALK"   , "narrator": "赤髪千羽鶴", "text": "少しでも楽しんで\nもらえたなら嬉しいです。"},
        { "location": "1269/TALK"   , "narrator": "赤髪千羽鶴", "text": "さて、この後ですが――"},
        { "location": "1270/TALK"   , "narrator": "赤髪千羽鶴", "text": "前回と同じように\nこのセクションの記録\n映像を見ていきますか？"},
        { "location": "1271/TALK"   , "narrator": "赤髪千羽鶴", "text": "今のスタックポインタは\n記録映像でいえば\n2016年7月28日――"},
        { "location": "1272/TALK"   , "narrator": "赤髪千羽鶴", "text": "卯月さんが、大変な事に\nなってしまう日です……。"},
        { "location": "1274/SEL"    , "narrator": "", "text": "映像を見る\n<color=green>【高画質/57MB 3:32】</color>"},
        { "location": "1275/SEL"    , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/18MB 3:32】</color>"},
        { "location": "1276/SEL"    , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1277/ACT"    , "narrator": "", "text": "映像を見る\n<color=green>【高画質/57MB 3:32】</color>"},
        { "location": "1278/TALK"   , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは再生しましょう。"},
        { "location": "1284/ACT"    , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/18MB 3:32】</color>"},
        { "location": "1285/TALK"   , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは再生しましょう。"},
        { "location": "1291/ACT"    , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1292/TALK"   , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれではレポートを\nご覧下さい。"},
        { "location": "1325/TALK"   , "narrator": "赤髪千羽鶴", "text": "卯月さんのこのシーンは、\n何度見ても辛くなります。"},
        { "location": "1326/TALK"   , "narrator": "赤髪千羽鶴", "text": "早くこんな状況から\n救い出してあげたいって\n思ってしまいます。"},
        { "location": "1327/TALK"   , "narrator": "赤髪千羽鶴", "text": "それはそれで、\n傲慢な考え方な\nわけですが。"},
        { "location": "1329/TALK"   , "narrator": "赤髪千羽鶴", "text": "さて。\n今回はお知らせが\n１件あります。"},
        { "location": "1330/TALK"   , "narrator": "赤髪千羽鶴", "text": "次回、わたしが\nここであなたと\n話をするとき――"},
        { "location": "1331/TALK"   , "narrator": "赤髪千羽鶴", "text": "その時が、世界に関わるか\n彼女とラブラブするかの\nFIXをする時になります。"},
        { "location": "1332/TALK"   , "narrator": "赤髪千羽鶴", "text": "もちろん、その中でも\nこのタイミングという\n瞬間はお知らせします。"},
        { "location": "1333/TALK"   , "narrator": "赤髪千羽鶴", "text": "そしてそれは恐らく、\nエピソード１６に\nなると思います。"},
        { "location": "1334/TALK"   , "narrator": "赤髪千羽鶴", "text": "ですから、その瞬間までは\n自由に双方を試して\nみてください。"},
        { "location": "1335/TALK"   , "narrator": "赤髪千羽鶴", "text": "大事な事なので、\nなるべく早く\nお伝えしておきました。"},
        { "location": "1336/TALK"   , "narrator": "赤髪千羽鶴", "text": "それでは今回は\nこの辺で。"},
