        { "location": "7/SCENARIO", "narrator": "", "text": "570_公的な秘密ぞね"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "実はうちには"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "秘密があるぞね"},
        { "location": "35/SEL"    , "narrator": "", "text": "言ったら秘密にならないよ"},
        { "location": "38/ACT"    , "narrator": "", "text": "言ったら秘密にならないよ"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "二人きりの秘密というやつだ"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "わからんか"},
        { "location": "43/SEL"    , "narrator": "", "text": "わかった"},
        { "location": "44/SEL"    , "narrator": "", "text": "うれしいな"},
        { "location": "45/SEL"    , "narrator": "", "text": "全然わからん"},
