        { "location": "47/TALK"   , "narrator": "みやび", "text": "よしよし"},
        { "location": "50/ACT"    , "narrator": "", "text": "うれしいな"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "照れちゃう☆彡"},
        { "location": "54/ACT"    , "narrator": "", "text": "全然わからん"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "またまた"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "みやびさんは"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "じつはみやびさんではない"},
        { "location": "60/SEL"    , "narrator": "", "text": "意味がわかりません"},
        { "location": "61/SEL"    , "narrator": "", "text": "みやこさんとか？"},
        { "location": "62/SEL"    , "narrator": "", "text": "とんちなの？"},
        { "location": "63/ACT"    , "narrator": "", "text": "意味がわかりません"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "すぐわかる"},
        { "location": "65/ACT"    , "narrator": "", "text": "みやこさんとか？"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "惜しいが違う"},
        { "location": "67/ACT"    , "narrator": "", "text": "とんちなの？"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "真面目な話だ"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "戸籍上の名前は都美"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "これがうちの真名ぞね"},
        { "location": "73/SEL"    , "narrator": "", "text": "本当の名前ってことだね"},
        { "location": "74/SEL"    , "narrator": "", "text": "ええと……何かの呪術的な？"},
        { "location": "75/SEL"    , "narrator": "", "text": "教えてくれてありがとう"},
        { "location": "76/ACT"    , "narrator": "", "text": "本当の名前ってことだね"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "左様"},
        { "location": "78/ACT"    , "narrator": "", "text": "ええと……何かの呪術的な？"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "なんとなく"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "気分？"},
        { "location": "83/ACT"    , "narrator": "", "text": "教えてくれてありがとう"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "どういたしまして"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "元々は大したことではない"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "なんとなくひらがな表記をしていたら"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "なんとなく定着してしまっただけだ"},
        { "location": "90/SEL"    , "narrator": "", "text": "なるほど"},
        { "location": "91/SEL"    , "narrator": "", "text": "そういうこともあるか"},
        { "location": "92/SEL"    , "narrator": "", "text": "なんとなく訂正しそびれたと"},
        { "location": "93/ACT"    , "narrator": "", "text": "なるほど"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "それだけのことだ"},
        { "location": "95/ACT"    , "narrator": "", "text": "そういうこともあるか"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "まあな"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "実例がここにあるし"},
        { "location": "98/ACT"    , "narrator": "", "text": "なんとなく訂正しそびれたと"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "単純じゃろ"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "しかしこれが今となっては"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "成人女性がノーメイクで会社に行くほどの恥"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "うちの中ではそのくらいのものになってしまった"},
        { "location": "106/SEL"   , "narrator": "", "text": "わかるようなわからないような"},
        { "location": "107/SEL"   , "narrator": "", "text": "恥ずかしいことだってことは理解した"},
        { "location": "108/SEL"   , "narrator": "", "text": "二人だけの秘密にしておくね"},
        { "location": "109/ACT"   , "narrator": "", "text": "わかるようなわからないような"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "伝わっているのかいないのか"},
        { "location": "111/ACT"   , "narrator": "", "text": "恥ずかしいことだってことは理解した"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "素晴らしい"},
        { "location": "113/ACT"   , "narrator": "", "text": "二人だけの秘密にしておくね"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "甘美な響き"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "いい言葉だ"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "なおこれは"},
