{
    "dir": "chap37/daydra/anime_05_37.js",
    "type": "MainStory",
    "info": {
        "story_id": "37501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "量子たちの沈黙"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第37話"},
        { "location": "20/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "21/TALK"   , "narrator": "エリカ", "text": "いらっしゃい\n$handle$さん。"},
        { "location": "22/TALK"   , "narrator": "エリカ", "text": "もう一度お話聞く？\nそれとも、省略する？"},
        { "location": "23/SEL"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "24/SEL"    , "narrator": "", "text": "飛ばす"},
        { "location": "25/ACT"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "26/TALK"   , "narrator": "エリカ", "text": "うん、わかったよ。"},
        { "location": "28/ACT"    , "narrator": "", "text": "飛ばす"},
        { "location": "29/TALK"   , "narrator": "エリカ", "text": "そっかー。\nそれじゃ、またね。"},
        { "location": "35/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "36/TALK"   , "narrator": "エリカ", "text": "エリカです。"},
        { "location": "37/TALK"   , "narrator": "エリカ", "text": "やっと直接\nお話できるところまで\n回復してきたみたい。"},
        { "location": "38/SEL"    , "narrator": "", "text": "よかった"},
        { "location": "39/SEL"    , "narrator": "", "text": "そっちの世界は大丈夫？"},
        { "location": "40/ACT"    , "narrator": "", "text": "よかった"},
        { "location": "41/TALK"   , "narrator": "エリカ", "text": "うん。"},
        { "location": "42/ACT"    , "narrator": "", "text": "そっちの世界は大丈夫？"},
        { "location": "43/TALK"   , "narrator": "エリカ", "text": "うん、まあ、\nギリギリかな。"},
        { "location": "44/TALK"   , "narrator": "エリカ", "text": "ライフギャザーの停止に\nよって、つばめちゃんの\n世界が消えちゃって。"},
        { "location": "45/TALK"   , "narrator": "エリカ", "text": "今の日本は、\n戦争で荒廃した姿を\nさらけ出している。"},
        { "location": "46/TALK"   , "narrator": "エリカ", "text": "ただ、Redinessは、\n“彼ら”のものも含めて\n全てが停止してるから――"},
        { "location": "47/TALK"   , "narrator": "エリカ", "text": "今は全世界が相当な\n混乱状態になっていて。"},
        { "location": "48/TALK"   , "narrator": "エリカ", "text": "その関係上、日本に対する\n動きはそれほど活発では\nない、というところかな。"},
        { "location": "49/SEL"    , "narrator": "", "text": "めちゃくちゃやばそう"},
        { "location": "50/ACT"    , "narrator": "", "text": "めちゃくちゃやばそう"},
        { "location": "52/TALK"   , "narrator": "エリカ", "text": "そうだね。\nただ、救われてるのは――"},
        { "location": "53/TALK"   , "narrator": "エリカ", "text": "Redinessなど一部の\nシステム以外は、こっちも\nノイマン式だってこと。"},
        { "location": "54/TALK"   , "narrator": "エリカ", "text": "だから、交通システムは\n大丈夫だし、金融も再起\n不能ってわけじゃない。"},
        { "location": "55/TALK"   , "narrator": "エリカ", "text": "むしろ、Rediness以外は\n普通に動いていて。"},
        { "location": "56/TALK"   , "narrator": "エリカ", "text": "貴方の世界でいうなら、\nスマートフォンだけが\n使えなくなってる状態？"},
        { "location": "57/TALK"   , "narrator": "エリカ", "text": "実際、内部的にはもっと\n深刻だけど、ノイマン式が\n十分フォロー出来るから。"},
        { "location": "58/TALK"   , "narrator": "エリカ", "text": "そういった事を考えると、\nまだまだ量子一本で\nやるのは危険だよね。"},
        { "location": "59/TALK"   , "narrator": "エリカ", "text": "今のこっちの世界の\n量子技術は、\nまだ赤ちゃんレベルで。"},
        { "location": "60/TALK"   , "narrator": "エリカ", "text": "そういう意味では、今の\n世界支配層は、少し量子を\n過信しすぎていたのかも。"},
        { "location": "61/TALK"   , "narrator": "エリカ", "text": "わたしも\nその一人では\nあったんだけど。"},
        { "location": "62/TALK"   , "narrator": "エリカ", "text": "量子技術は、ノイマン式の\nような、全てが計算で\n完結できる技術じゃない。"},
        { "location": "63/TALK"   , "narrator": "エリカ", "text": "どこまでいっても、ううん\n突き詰めれば突き詰める程\n制御は難しくなる。"},
        { "location": "64/TALK"   , "narrator": "エリカ", "text": "それは、世界の根源と\n結びついている\n技術だからで。"},
        { "location": "65/TALK"   , "narrator": "エリカ", "text": "神に最も近い技術で。\nだからこそ私達は、量子を\n畏れなければならない。"},
        { "location": "66/TALK"   , "narrator": "エリカ", "text": "今回の結果は、間違い無く\nわたしの傲りが生んだ\n結果だから。"},
        { "location": "67/TALK"   , "narrator": "エリカ", "text": "最後まで、責任もって\n収束させるつもりだよ。"},
        { "location": "68/SEL"    , "narrator": "", "text": "エリカのせいじゃないよ"},
        { "location": "69/SEL"    , "narrator": "", "text": "いつだって世界の崩壊は科学者の傲りから始まるものなのだ"},
        { "location": "70/ACT"    , "narrator": "", "text": "エリカのせいじゃないよ"},
        { "location": "71/TALK"   , "narrator": "エリカ", "text": "ありがとう。\nでも、これはわたしの\n気持ちの問題だから。"},
        { "location": "72/ACT"    , "narrator": "", "text": "いつだって世界の崩壊は科学者の傲りから始まるものなのだ"},
        { "location": "73/TALK"   , "narrator": "エリカ", "text": "本当だね。"},
        { "location": "74/TALK"   , "narrator": "エリカ", "text": "蒸気機関も、\n核エネルギーも、\nそして、量子力学も。"},
        { "location": "75/TALK"   , "narrator": "エリカ", "text": "それは余りに危うすぎる\nバランスの上に\n成り立っていて。"},
        { "location": "76/TALK"   , "narrator": "エリカ", "text": "誰かが一歩間違えば、\n世界は存亡の危機に\n立たされる。"},
        { "location": "77/TALK"   , "narrator": "エリカ", "text": "常に歴史は\nそれを物語ってきた。"},
        { "location": "78/TALK"   , "narrator": "エリカ", "text": "わたしは、そこから学べず\n世界を壊す寸前まで\nやってしまったの。"},
        { "location": "79/TALK"   , "narrator": "エリカ", "text": "だから、それ自体が\n罪滅ぼしにはならないと\n思うけど――"},
        { "location": "80/TALK"   , "narrator": "エリカ", "text": "最後まで責任もって\n事態を収拾する\nつもりだよ。"},
        { "location": "83/TALK"   , "narrator": "エリカ", "text": "ところで――"},
        { "location": "85/TALK"   , "narrator": "エリカ", "text": "原初ちゃんの事だけど、\n$handle$さんは\nどう思ってる？"},
        { "location": "86/SEL"    , "narrator": "", "text": "彼女の考えているやり方で、世界に立ち向かって行くのが良いと思ってる"},
        { "location": "87/SEL"    , "narrator": "", "text": "正直、後悔してる"},
        { "location": "88/ACT"    , "narrator": "", "text": "彼女の考えているやり方で、世界に立ち向かって行くのが良いと思ってる"},
        { "location": "89/TALK"   , "narrator": "エリカ", "text": "そっか。\nそれも１つの答えだよね。"},
        { "location": "90/TALK"   , "narrator": "エリカ", "text": "原初ちゃんの方法は\nとても合理的だし、\n確実性が高いもんね。"},
        { "location": "91/TALK"   , "narrator": "エリカ", "text": "ただ、わたしはちょっと\n効率重視すぎる\n気がしていて――"},
        { "location": "92/TALK"   , "narrator": "エリカ", "text": "ちょっと心配してるんだ。"},
        { "location": "93/TALK"   , "narrator": "エリカ", "text": "もちろん、わたしたちの\n計画はすごく消極的で。"},
        { "location": "94/TALK"   , "narrator": "エリカ", "text": "“彼ら”が綾ちゃん達を\n攻撃したりしないように\n操作はするけど、"},
        { "location": "95/TALK"   , "narrator": "エリカ", "text": "世界の統治に関して\nどうするという方針が\n無いのはわかってる。"},
        { "location": "96/TALK"   , "narrator": "エリカ", "text": "ううん、むしろ\nやるのが怖いから\n敢えてやらないというか。"},
        { "location": "97/TALK"   , "narrator": "エリカ", "text": "もちろんそれは、わたしの\n真剣さが足りないだけなの\nかもしれないけど……。"},
        { "location": "98/TALK"   , "narrator": "エリカ", "text": "だから、あなたが\n原初ちゃんと共に\n歩むというのなら、"},
        { "location": "99/TALK"   , "narrator": "エリカ", "text": "わたしは、１つだけ\nお願いがあって。"},
        { "location": "100/TALK"  , "narrator": "エリカ", "text": "どうか、この世界を\n本当に自分の世界だと\n思って協力して欲しい。"},
        { "location": "101/TALK"  , "narrator": "エリカ", "text": "そうしてくれたなら、\nわたしは貴方の想いを\n信じて未来を託します。"},
        { "location": "102/ACT"   , "narrator": "", "text": "正直、後悔してる"},
        { "location": "103/TALK"  , "narrator": "エリカ", "text": "そっか。\nそういう事もあるよね。"},
        { "location": "104/TALK"  , "narrator": "エリカ", "text": "もしよければ、\n今からでもわたしの方法に\n協力してくれないかな。"},
        { "location": "105/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんの\nフェノメノンが\n展開すれば――"},
        { "location": "106/TALK"  , "narrator": "エリカ", "text": "いつものつばめちゃんも\n千羽鶴ちゃんも、\n戻ってくるし。"},
        { "location": "107/TALK"  , "narrator": "エリカ", "text": "それを2E113にコピーして\n蒸着してしまえば、"},
        { "location": "108/TALK"  , "narrator": "エリカ", "text": "もう二度と、\n消えていなくなることは\nなくなるから。"},
        { "location": "111/TALK"  , "narrator": "エリカ", "text": "前回、チャットで\n簡単に伝えた、総意に\n関するお話だけどね。"},
        { "location": "112/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんと\nお話して――"},
        { "location": "113/TALK"  , "narrator": "エリカ", "text": "しばらくは、収束のために\n総意を使うのはやめて\nみようって事になって。"},
        { "location": "114/SEL"   , "narrator": "", "text": "９５％の人が総意に肯定的だったのに、どうして！？"},
        { "location": "115/SEL"   , "narrator": "", "text": "それだと、もう日本のディテールを維持出来なくなってしまうのでは？"},
        { "location": "116/ACT"   , "narrator": "", "text": "９５％の人が総意に肯定的だったのに、どうして！？"},
        { "location": "117/TALK"  , "narrator": "エリカ", "text": "うん、そうなんだよね。"},
        { "location": "118/TALK"  , "narrator": "エリカ", "text": "二人で凄く考えたの。"},
        { "location": "119/TALK"  , "narrator": "エリカ", "text": "その結果、二人とも\n一致して思ったのは――"},
        { "location": "120/TALK"  , "narrator": "エリカ", "text": "$handle$さんの\n想いの力を\n信じてみようってことで。"},
        { "location": "121/ACT"   , "narrator": "", "text": "それだと、もう日本のディテールを維持出来なくなってしまうのでは？"},
        { "location": "122/TALK"  , "narrator": "エリカ", "text": "そうだね。"},
        { "location": "123/TALK"  , "narrator": "エリカ", "text": "世界が分散すれば、当然\n分散した世界１つ１つの\nディテールは緩くなる。"},
        { "location": "124/TALK"  , "narrator": "エリカ", "text": "中には、母数が相当小さく\nなってしまう世界も\n出てくると思うの。"},
        { "location": "125/TALK"  , "narrator": "エリカ", "text": "そういった世界は、\nちょっとおかしな世界に\nなっちゃうかもしれない。"},
        { "location": "126/TALK"  , "narrator": "エリカ", "text": "けど、それならそれで、\nそれも１つの結果なんじゃ\nないのかなって思って。"},
        { "location": "127/SEL"   , "narrator": "", "text": "そんなのでいいの！？"},
        { "location": "128/ACT"   , "narrator": "", "text": "そんなのでいいの！？"},
        { "location": "131/TALK"  , "narrator": "エリカ", "text": "わたしたちは、\n$handle$さんに\n力を借りてきたよね。"},
        { "location": "132/TALK"  , "narrator": "エリカ", "text": "でも、今思い返してみれば\n色んな選択を迫っていた\n割には――"},
        { "location": "133/TALK"  , "narrator": "エリカ", "text": "結果として、わたしたちの\n都合がいい世界を作る為に\n利用していただけだった。"},
        { "location": "134/SEL"   , "narrator": "", "text": "あー、気づいちゃったか"},
        { "location": "135/SEL"   , "narrator": "", "text": "そんな事無いから！"},
        { "location": "136/ACT"   , "narrator": "", "text": "あー、気づいちゃったか"},
        { "location": "137/TALK"  , "narrator": "エリカ", "text": "ごめんね、\nずっと気づかなくて。"},
        { "location": "138/ACT"   , "narrator": "", "text": "そんな事無いから！"},
        { "location": "139/TALK"  , "narrator": "エリカ", "text": "まあ、\n最後まで聞いてね。"},
        { "location": "141/TALK"  , "narrator": "エリカ", "text": "その一番の理由は、\n総意の力が削がれる事を\n恐れていたことで。"},
        { "location": "142/TALK"  , "narrator": "エリカ", "text": "そのせいで、あなたが\n本当にあなたとして、\n描きたいものを――"},
        { "location": "143/TALK"  , "narrator": "エリカ", "text": "わたしたちは、\n何一つ認めてこなかった\n気がするの。"},
        { "location": "144/TALK"  , "narrator": "エリカ", "text": "でも、結果として、\n世界は初期化に近い状況に\nなってしまった。"},
        { "location": "145/TALK"  , "narrator": "エリカ", "text": "だったら。"},
        { "location": "146/TALK"  , "narrator": "エリカ", "text": "せっかくだから、\nこの機会にやり方を\n変えてみたいと思ったの。"},
        { "location": "147/SEL"   , "narrator": "", "text": "どういう風に…？"},
        { "location": "148/ACT"   , "narrator": "", "text": "どういう風に…？"},
        { "location": "150/TALK"  , "narrator": "エリカ", "text": "$handle$さんが、\nこの世界や、大好きな\n彼女のために――"},
        { "location": "151/TALK"  , "narrator": "エリカ", "text": "思い描ける最大の幸せを\n願って、それを使って\n世界を描けるのなら。"},
        { "location": "152/TALK"  , "narrator": "エリカ", "text": "その世界こそ、\n本当の想いが詰まった\n世界になるだろうって。"},
        { "location": "153/TALK"  , "narrator": "エリカ", "text": "どうせゼロから\nやり直すなら、同じ事を\nやっても仕方ない。"},
        { "location": "154/TALK"  , "narrator": "エリカ", "text": "だから、思い切って、\n総意の力がバラバラに\nなったとしても。"},
        { "location": "155/TALK"  , "narrator": "エリカ", "text": "それぞれの、あなたの\n想い描く理想の形に近い\n未来を創ってみたい――"},
        { "location": "156/TALK"  , "narrator": "エリカ", "text": "そう思ったんだ。"},
        { "location": "157/SEL"   , "narrator": "", "text": "どうすればいいの？"},
        { "location": "158/ACT"   , "narrator": "", "text": "どうすればいいの？"},
        { "location": "160/TALK"  , "narrator": "エリカ", "text": "思った通りの\n選択をして欲しいの。"},
        { "location": "161/TALK"  , "narrator": "エリカ", "text": "もちろん、わたしは\nわたしで、理想や責任が\nあるから――"},
        { "location": "162/TALK"  , "narrator": "エリカ", "text": "必ずしも、あなたの選択に\n協力できるかは\nわからない。"},
        { "location": "163/TALK"  , "narrator": "エリカ", "text": "そしてそれは、\n千羽鶴ちゃんや原初ちゃん\nソイルトンや“彼ら”、"},
        { "location": "164/TALK"  , "narrator": "エリカ", "text": "トライナリーのみんな\nそれぞれが、それぞれの\n理想を持っていて。"},
        { "location": "165/TALK"  , "narrator": "エリカ", "text": "全ての人が、あなたの\n選択を全会一致で賛同する\nことはあり得ない。"},
        { "location": "166/TALK"  , "narrator": "エリカ", "text": "けど、それでも。"},
        { "location": "167/TALK"  , "narrator": "エリカ", "text": "貴方が大事にしている事を\nちゃんと、その選択に\n込めて欲しいんだ。"},
        { "location": "168/TALK"  , "narrator": "エリカ", "text": "もちろん、世界は分散し\n母数も減るから、ちょっと\n変な世界になるかもだし、"},
        { "location": "169/TALK"  , "narrator": "エリカ", "text": "そもそも貴方が、再び\n日本をフェノメノンで\n包みたくなければ――"},
        { "location": "170/TALK"  , "narrator": "エリカ", "text": "現実の荒廃した日本から\n再スタートするという\n未来だってある。"},
        { "location": "171/TALK"  , "narrator": "エリカ", "text": "けれども、そういった\nリスクを踏まえてでも。"},
        { "location": "172/TALK"  , "narrator": "エリカ", "text": "わたしと千羽鶴ちゃんは\n貴方の想いを信じることに\nしたの。"},
        { "location": "173/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんは、貴方を\n連れてきた張本人だけど。"},
        { "location": "174/TALK"  , "narrator": "エリカ", "text": "彼女が一番、貴方の想いを\n信じてくれている。"},
        { "location": "176/TALK"  , "narrator": "エリカ", "text": "だから、私達は\n全てのリミッターを\n解除した。"},
        { "location": "177/TALK"  , "narrator": "エリカ", "text": "ここから先、貴方がどんな\n選択をしようとも、未来へ\n進めるようになってる。"},
        { "location": "178/TALK"  , "narrator": "エリカ", "text": "もちろん、わたしや\n千羽鶴ちゃんは、自身を\n信じて邁進するから――"},
        { "location": "179/TALK"  , "narrator": "エリカ", "text": "貴方に「こうして欲しい」\nという事柄については、\n伝え続けるけれども。"},
        { "location": "180/TALK"  , "narrator": "エリカ", "text": "でも、それを全部\n否定しても、未来へ進める\nようにはしてある。"},
        { "location": "181/TALK"  , "narrator": "エリカ", "text": "だから、貴方は貴方の\n信じる道を進んで欲しい。"},
        { "location": "182/TALK"  , "narrator": "エリカ", "text": "その結果出来上がった\n未来は、きっととても\n素敵な世界になるから。"},
        { "location": "183/TALK"  , "narrator": "エリカ", "text": "宜しくお願いします。"},
        { "location": "184/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "185/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "187/TALK"  , "narrator": "エリカ", "text": "ありがとう。"},
        { "location": "188/TALK"  , "narrator": "エリカ", "text": "あと、もう１つ\nお願いがあって。"},
        { "location": "189/TALK"  , "narrator": "エリカ", "text": "貴方の想いの力を\nより一層強いものに\nするために――"},
        { "location": "190/TALK"  , "narrator": "エリカ", "text": "今までのとは違う、\n実験的な総意を\nとりたいと思うの。"},
        { "location": "191/TALK"  , "narrator": "エリカ", "text": "この総意をとる事が――"},
        { "location": "192/TALK"  , "narrator": "エリカ", "text": "あなた達の“総意”に\n対する９５％賛同の答え\nだと思ってもらえれば。"},
        { "location": "193/SEL"   , "narrator": "", "text": "どんな総意なの？"},
        { "location": "194/ACT"   , "narrator": "", "text": "どんな総意なの？"},
        { "location": "196/TALK"  , "narrator": "エリカ", "text": "それは、\n「想いの総意」。"},
        { "location": "197/TALK"  , "narrator": "エリカ", "text": "あなたがわたしたちの\n世界の未来として\n望む姿――"},
        { "location": "198/TALK"  , "narrator": "エリカ", "text": "それを、あなたの世界の\nSNSに、"},
        { "location": "199/TALK"  , "narrator": "エリカ", "text": "<color=green>#トライナリー\n未来への想い</color>\nというタグで書いて欲しい"},
        { "location": "200/TALK"  , "narrator": "エリカ", "text": "それは総意として、\nその想いの数や強さや、\n具体性、そして――"},
        { "location": "201/TALK"  , "narrator": "エリカ", "text": "実際に進んだ未来との\n相性なども影響しながら\n具現化していくと思う。"},
        { "location": "202/TALK"  , "narrator": "エリカ", "text": "本当に、あなたが\n幸せだと思う世界を。"},
        { "location": "203/TALK"  , "narrator": "エリカ", "text": "どんなことでもいいから\nSNSに書いて下さい。"},
        { "location": "204/TALK"  , "narrator": "エリカ", "text": "わたしたちの世界は、\nその想いで強くなれる。\n幸せな世界になれる。"},
        { "location": "205/SEL"   , "narrator": "", "text": "わかったよ"},
        { "location": "206/SEL"   , "narrator": "", "text": "どう書けばいいのかよくわからないんだけど"},
        { "location": "207/SEL"   , "narrator": "", "text": "それって危険では？悪意のある書き込みで不幸になったりしない？"},
        { "location": "208/ACT"   , "narrator": "", "text": "わかったよ"},
        { "location": "209/ACT"   , "narrator": "", "text": "どう書けばいいのかよくわからないんだけど"},
        { "location": "210/TALK"  , "narrator": "エリカ", "text": "そんなに構えなくても\nいいんだよ？"},
        { "location": "211/TALK"  , "narrator": "エリカ", "text": "たとえば――"},
        { "location": "212/TALK"  , "narrator": "エリカ", "text": "『つばめちゃんが\n神楽ちゃんとずっと仲良し\nでいられますように』とか"},
        { "location": "213/TALK"  , "narrator": "エリカ", "text": "『みやびちゃんが\n88歳まで幸せに生きられ\nますように』とか、"},
        { "location": "214/TALK"  , "narrator": "エリカ", "text": "『メノウちゃんが\n自分の創りたい歌を\n作れますように』とか。"},
        { "location": "215/TALK"  , "narrator": "エリカ", "text": "あ、そうだ、\nなんか、絵馬や七夕の\n短冊みたいな？"},
        { "location": "216/TALK"  , "narrator": "エリカ", "text": "そんな感じで\n良いと思うんだ。"},
        { "location": "217/TALK"  , "narrator": "エリカ", "text": "あなたの大切な人がずっと\n幸せでいられるように、\nその想いを書いてくれれば"},
        { "location": "218/TALK"  , "narrator": "エリカ", "text": "きっとその想いが、\nこの世界の未来に\n伝わっていくから。"},
        { "location": "219/ACT"   , "narrator": "", "text": "それって危険では？悪意のある書き込みで不幸になったりしない？"},
        { "location": "220/TALK"  , "narrator": "エリカ", "text": "今までずっと、\nわたしたちと共にいて、\n幸せを願ってくれた。"},
        { "location": "221/TALK"  , "narrator": "エリカ", "text": "そんなあなたの想いだから\nどんなことでも\n受け入れられるの。"},
        { "location": "223/TALK"  , "narrator": "エリカ", "text": "どうか、\n宜しくお願いします。"},
        { "location": "226/TALK"  , "narrator": "エリカ", "text": "というわけで。"},
        { "location": "228/TALK"  , "narrator": "エリカ", "text": "今回、わたしからは\n以上になります。"},
        { "location": "229/TALK"  , "narrator": "エリカ", "text": "既に世界線がCH01～04と\nズレちゃってるから、\n記録映像は見られないけど"},
        { "location": "230/TALK"  , "narrator": "エリカ", "text": "面倒かもしれないけど、\n飛ばして先に進んでね。"},
        { "location": "233/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/--MB -:--】</color>"},
        { "location": "234/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/--MB -:--】</color>"},
        { "location": "235/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "236/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/--MB -:--】</color>"},
        { "location": "244/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/--MB -:--】</color>"},
        { "location": "252/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "287/TALK"  , "narrator": "赤髪千羽鶴", "text": "というわけで。"},
        { "location": "288/SEL"   , "narrator": "", "text": "原ちゃん！"},
        { "location": "289/SEL"   , "narrator": "", "text": "どーんして！！"},
        { "location": "290/SEL"   , "narrator": "", "text": "恥じらいながらどーんして！"},
        { "location": "291/ACT"   , "narrator": "", "text": "原ちゃん！"},
        { "location": "292/TALK"  , "narrator": "赤髪千羽鶴", "text": "それは初めての\n呼ばれ方ですね！"},
        { "location": "293/ACT"   , "narrator": "", "text": "どーんして！！"},
        { "location": "296/TALK"  , "narrator": "赤髪千羽鶴", "text": "<size=40>どーん！</size>"},
        { "location": "297/TALK"  , "narrator": "赤髪千羽鶴", "text": "！？！？！？"},
        { "location": "298/TALK"  , "narrator": "赤髪千羽鶴", "text": "なんで！？\n条件反射？？"},
        { "location": "299/ACT"   , "narrator": "", "text": "恥じらいながらどーんして！"},
        { "location": "300/TALK"  , "narrator": "赤髪千羽鶴", "text": "どーん…。"},
        { "location": "301/TALK"  , "narrator": "赤髪千羽鶴", "text": "無理無理！\n無理です！"},
        { "location": "303/TALK"  , "narrator": "赤髪千羽鶴", "text": "恥じらいながらどーん\nするとか、恥ずかしすぎて\n出来ませんから！"},
        { "location": "304/SEL"   , "narrator": "", "text": "ていうか、ナチュラルにやってるし"},
        { "location": "305/ACT"   , "narrator": "", "text": "ていうか、ナチュラルにやってるし"},
        { "location": "309/TALK"  , "narrator": "赤髪千羽鶴", "text": "<size=40>どーん！</size>"},
        { "location": "311/TALK"  , "narrator": "赤髪千羽鶴", "text": "はめましたね。"},
        { "location": "313/TALK"  , "narrator": "赤髪千羽鶴", "text": "さて、早速ですが\n本題に入りたいと\n思います。"},
        { "location": "314/TALK"  , "narrator": "赤髪千羽鶴", "text": "既にご存知の通り、\nわたしの創った世界が\n吹き飛びました。"},
        { "location": "315/TALK"  , "narrator": "赤髪千羽鶴", "text": "すなわちどんな状態かと\n言いますと――"},
        { "location": "316/TALK"  , "narrator": "赤髪千羽鶴", "text": "今、現実世界の東京では\n瓦礫と化した本当の\n東京が出現しています。"},
        { "location": "317/SEL"   , "narrator": "", "text": "ということは、つばめも原初状態のつばめに戻ってるということ？"},
        { "location": "318/ACT"   , "narrator": "", "text": "ということは、つばめも原初状態のつばめに戻ってるということ？"},
        { "location": "320/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうです。"},
        { "location": "321/TALK"  , "narrator": "赤髪千羽鶴", "text": "なのに、今の日本は、\nやはりフェノメノンで\n覆われているんです。"},
        { "location": "322/TALK"  , "narrator": "赤髪千羽鶴", "text": "そのフェノメノンは\n2E113と呼ばれる、\nエリカさんのもの。"},
        { "location": "323/TALK"  , "narrator": "赤髪千羽鶴", "text": "なぜフェノメノンを\n展開しているのに外と\n同じ世界なのか？"},
        { "location": "324/TALK"  , "narrator": "赤髪千羽鶴", "text": "そもそも何故、\nフェノメノンを\n展開しているのか？"},
        { "location": "325/TALK"  , "narrator": "赤髪千羽鶴", "text": "正直、わたしには\nその意図は\nわかりかねます。"},
        { "location": "326/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただ、どのような状態に\nせよ、わたしがやるべき\n事は変わりませんが。"},
        { "location": "327/TALK"  , "narrator": "赤髪千羽鶴", "text": "そして、貴方にお願い\nしたいこともまた、\n変わりません。"},
        { "location": "328/SEL"   , "narrator": "", "text": "どんなこと？"},
        { "location": "329/ACT"   , "narrator": "", "text": "どんなこと？"},
        { "location": "331/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしと、右腕である\n貴方とで、ライフギャザー\nによる彼らの心の操作。"},
        { "location": "332/TALK"  , "narrator": "赤髪千羽鶴", "text": "そして、\n“彼ら”の統治方針を\n修正する。"},
        { "location": "333/TALK"  , "narrator": "赤髪千羽鶴", "text": "それだけです。"},
        { "location": "335/TALK"  , "narrator": "赤髪千羽鶴", "text": "そういえば、貴方は\n既に卯月さんの発症を\n開始していますね。"},
        { "location": "336/TALK"  , "narrator": "赤髪千羽鶴", "text": "それ自体は全く\n構わないのですが、\nその後については――"},
        { "location": "337/TALK"  , "narrator": "赤髪千羽鶴", "text": "エリカさんの言う\n“2E113へのコピー”は、\n断固阻止してください。"},
        { "location": "339/TALK"  , "narrator": "赤髪千羽鶴", "text": "そういえば、貴方は\nまだ卯月さんの発症を\nしていないんですね。"},
        { "location": "340/TALK"  , "narrator": "赤髪千羽鶴", "text": "色々お考えは\nあるかと思いますが――"},
        { "location": "341/TALK"  , "narrator": "赤髪千羽鶴", "text": "卯月さんの発症と\nフェノメノンの展開だけは\nよろしくお願いします。"},
        { "location": "343/SEL"   , "narrator": "", "text": "なんで？"},
        { "location": "344/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "346/TALK"  , "narrator": "赤髪千羽鶴", "text": "前にもお話しました通り、\n彼らにどのような思想を\n持たせるかについては――"},
        { "location": "347/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしと貴方で\n考えて、実行するという\n方針を考えています。"},
        { "location": "348/TALK"  , "narrator": "赤髪千羽鶴", "text": "その際には“わたし”が\nそこに存在する必要が\nありますよね？"},
        { "location": "349/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですが、卯月さんや\nトライナリーのみんな、\nそして――"},
        { "location": "350/TALK"  , "narrator": "赤髪千羽鶴", "text": "可愛いつばめによって\n描かれる世界には、\nわたしは存在しません。"},
        { "location": "351/TALK"  , "narrator": "赤髪千羽鶴", "text": "それが蒸着することで、\nわたしはその世界線から\n弾かれてしまいます。"},
        { "location": "352/SEL"   , "narrator": "", "text": "原初ちゃんがいない世界になってしまうということ？"},
        { "location": "353/ACT"   , "narrator": "", "text": "原初ちゃんがいない世界になってしまうということ？"},
        { "location": "355/TALK"  , "narrator": "赤髪千羽鶴", "text": "まさにその通り。"},
        { "location": "356/TALK"  , "narrator": "赤髪千羽鶴", "text": "解ってると思いますが、\nわたしは――"},
        { "location": "357/TALK"  , "narrator": "赤髪千羽鶴", "text": "千羽鶴の作ったフェノ\nメノンが収束し、一人の\n自分に戻った未来の自分。"},
        { "location": "358/TALK"  , "narrator": "赤髪千羽鶴", "text": "そこには、可愛いつばめも\n千羽鶴も存在しません。"},
        { "location": "359/TALK"  , "narrator": "赤髪千羽鶴", "text": "すなわち、どんなに\n頑張って世界を繋げようと\nしても――"},
        { "location": "360/TALK"  , "narrator": "赤髪千羽鶴", "text": "可愛いつばめ、千羽鶴と、\nわたしは絶対に同じ世界線\nには相容れないのです。"},
        { "location": "361/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、卯月さん主催の\nフェノメノンが完成し、\nそれが蒸着すれば――"},
        { "location": "362/TALK"  , "narrator": "赤髪千羽鶴", "text": "彼女たちの記憶には\n可愛いつばめと千羽鶴しか\nいませんから、"},
        { "location": "363/TALK"  , "narrator": "赤髪千羽鶴", "text": "当然わたしという\n存在は、その世界からは\n消えてしまう。"},
        { "location": "364/TALK"  , "narrator": "赤髪千羽鶴", "text": "貴方は、TRI-OSの仕様上\nその世界しか\n観測出来ませんから――"},
        { "location": "365/TALK"  , "narrator": "赤髪千羽鶴", "text": "必然的にわたしとは\n会えなくなり、共に世界を\n創る約束は果たせなくなる"},
        { "location": "366/TALK"  , "narrator": "赤髪千羽鶴", "text": "そういうことです。"},
        { "location": "367/SEL"   , "narrator": "", "text": "え？　それって、実は神楽のフェノメノン発症には反対ってこと？"},
        { "location": "368/ACT"   , "narrator": "", "text": "え？　それって、実は神楽のフェノメノン発症には反対ってこと？"},
        { "location": "370/TALK"  , "narrator": "赤髪千羽鶴", "text": "いえ。卯月さんの\nフェノメノン発症自体は\n“一時的には”必要です。"},
        { "location": "371/TALK"  , "narrator": "赤髪千羽鶴", "text": "何故かと申しますと――"},
        { "location": "372/TALK"  , "narrator": "赤髪千羽鶴", "text": "一旦は私のフェノメノンを\n復元し、記録映像を最後\nまで完遂しなければ、"},
        { "location": "373/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたし自身が\n存在しない存在に\nなってしまうからです。"},
        { "location": "374/SEL"   , "narrator": "", "text": "歴史が変わっちゃうってこと？"},
        { "location": "375/ACT"   , "narrator": "", "text": "歴史が変わっちゃうってこと？"},
        { "location": "377/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうです。"},
        { "location": "378/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしと、それに競合する\n可愛いつばめ＆千羽鶴は、\n別々の未来の存在です。"},
        { "location": "379/TALK"  , "narrator": "赤髪千羽鶴", "text": "が、EP31の記録映像までは\n同一の存在でした。"},
        { "location": "380/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、EP31までの\n記録映像を完遂しなければ\n私も彼女らも消えます。"},
        { "location": "381/TALK"  , "narrator": "赤髪千羽鶴", "text": "いえ、存在としては\n消えませんが、貴方の知る\nわたしたちでは無くなる。"},
        { "location": "382/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、現在完全に逸脱\nしている歴史を、記録映像\n通りに戻さねばなりません"},
        { "location": "383/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただし、先にもお伝えした\nとおり、それは一時的な\nものに留めます。"},
        { "location": "384/TALK"  , "narrator": "赤髪千羽鶴", "text": "そしていずれは、\n卯月さんのフェノメノンは\nそのまま収束させます。"},
        { "location": "385/SEL"   , "narrator": "", "text": "そうすると、以後は可愛いつばめと千羽鶴には、もう会えなくなるんだよね"},
        { "location": "386/SEL"   , "narrator": "", "text": "それって逆に言えば、2E113に蒸着さえしなければ、原初も存在できる？"},
        { "location": "387/ACT"   , "narrator": "", "text": "てことは、可愛いつばめと千羽鶴には、もう会えないってことか"},
        { "location": "388/TALK"  , "narrator": "赤髪千羽鶴", "text": "もちろん、そうなります。"},
        { "location": "389/TALK"  , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "390/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしも、貴方が今まで\nどれだけ彼女たちと\n深い絆を育んできたか、"},
        { "location": "391/TALK"  , "narrator": "赤髪千羽鶴", "text": "それなりに理解している\nつもりです。"},
        { "location": "392/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただ、わたしは、わたしの\n考える方法が、この世界を\n健全にする最善であると、"},
        { "location": "393/TALK"  , "narrator": "赤髪千羽鶴", "text": "そう考えていますし、\n貴方もそれに賛同して\nくれていると思いたい。"},
        { "location": "394/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、寂しいとは\n思いますが、そこは\n諦めて下さい。"},
        { "location": "395/SEL"   , "narrator": "", "text": "$me$は原初が好きだから、今のままでいい"},
        { "location": "396/SEL"   , "narrator": "", "text": "それは無理"},
        { "location": "397/ACT"   , "narrator": "", "text": "$me$は原初が好きだから、今のままでいい"},
        { "location": "399/TALK"  , "narrator": "赤髪千羽鶴", "text": "……え…？"},
        { "location": "400/TALK"  , "narrator": "赤髪千羽鶴", "text": "ほんとですか？"},
        { "location": "401/SEL"   , "narrator": "", "text": "$me$は原初が好き"},
        { "location": "402/ACT"   , "narrator": "", "text": "$me$は原初が好き"},
        { "location": "404/TALK"  , "narrator": "赤髪千羽鶴", "text": "いえ、そんな、\n感情が高ぶるような\n関係では無い筈です。"},
        { "location": "405/TALK"  , "narrator": "赤髪千羽鶴", "text": "ナイチンゲール症候群か\n何かではないでしょうか。"},
        { "location": "406/SEL"   , "narrator": "", "text": "そんなことない"},
        { "location": "407/ACT"   , "narrator": "", "text": "そんなことない"},
        { "location": "409/TALK"  , "narrator": "赤髪千羽鶴", "text": "どうして、\nそう言い切れるんですか！"},
        { "location": "410/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしは…\nわたしは…っ！"},
        { "location": "411/SEL"   , "narrator": "", "text": "$me$は原初が大好きだから、ずっと一緒にいるよ"},
        { "location": "412/ACT"   , "narrator": "", "text": "$me$は原初が大好きだから、ずっと一緒にいるよ"},
        { "location": "414/TALK"  , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "415/TALK"  , "narrator": "赤髪千羽鶴", "text": "…そう……ですか。"},
        { "location": "417/TALK"  , "narrator": "赤髪千羽鶴", "text": "そう…なんですね……。"},
        { "location": "418/TALK"  , "narrator": "赤髪千羽鶴", "text": "ありがとう…ございます。"},
        { "location": "419/TALK"  , "narrator": "赤髪千羽鶴", "text": "すごく――"},
        { "location": "420/TALK"  , "narrator": "赤髪千羽鶴", "text": "なんでしょうか、\nすごく、"},
        { "location": "421/TALK"  , "narrator": "赤髪千羽鶴", "text": "暖かくて。"},
        { "location": "422/TALK"  , "narrator": "赤髪千羽鶴", "text": "すごく、\nなんでしょうか…"},
        { "location": "423/TALK"  , "narrator": "赤髪千羽鶴", "text": "優しくて……"},
        { "location": "424/TALK"  , "narrator": "赤髪千羽鶴", "text": "なぜかわからない、\nごめんなさい。身体が\nいうコトをきかなくて……"},
        { "location": "425/TALK"  , "narrator": "赤髪千羽鶴", "text": "ごめんなさい……。\n涙が止まらない……。"},
        { "location": "426/SEL"   , "narrator": "", "text": "$me$はずっと、原初の隣にいるから"},
        { "location": "427/ACT"   , "narrator": "", "text": "$me$はずっと、原初の隣にいるから"},
        { "location": "429/TALK"  , "narrator": "赤髪千羽鶴", "text": "……ありがとう…\nございます……。"},
        { "location": "430/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたし…"},
        { "location": "431/TALK"  , "narrator": "赤髪千羽鶴", "text": "なんだかわからないけど、\n今、生まれて初めて\n安心してるというか……"},
        { "location": "432/TALK"  , "narrator": "赤髪千羽鶴", "text": "上手く説明できない\n気持ちなんです。\nごめんなさい……。"},
        { "location": "433/TALK"  , "narrator": "赤髪千羽鶴", "text": "こういうのって\n何て言うんでしょうか。"},
        { "location": "434/TALK"  , "narrator": "赤髪千羽鶴", "text": "そんなことも\nわたしは知らずに\n生きてきたんだなって。"},
        { "location": "435/TALK"  , "narrator": "赤髪千羽鶴", "text": "だから、\nありがとうございます…。"},
        { "location": "436/SEL"   , "narrator": "", "text": "一緒にがんばろう"},
        { "location": "437/ACT"   , "narrator": "", "text": "一緒にがんばろう"},
        { "location": "439/TALK"  , "narrator": "赤髪千羽鶴", "text": "……はい。"},
        { "location": "441/TALK"  , "narrator": "赤髪千羽鶴", "text": "よろしくお願いします。"},
        { "location": "442/ACT"   , "narrator": "", "text": "それは無理"},
        { "location": "444/TALK"  , "narrator": "赤髪千羽鶴", "text": "そのお気持ちは\nよくわかります。"},
        { "location": "445/TALK"  , "narrator": "赤髪千羽鶴", "text": "もちろん、その気持ちが\n抑えきれないくらいに\n大きいのであれば――"},
        { "location": "446/TALK"  , "narrator": "赤髪千羽鶴", "text": "その気持ちに従って\n行動した方が良いと\n思います。"},
        { "location": "447/TALK"  , "narrator": "赤髪千羽鶴", "text": "その時には、わたしとは\n真っ向から対立する事に\nなってしまいますが――"},
        { "location": "448/TALK"  , "narrator": "赤髪千羽鶴", "text": "それもまた、\nこの世界の摂理ですから。"},
        { "location": "449/TALK"  , "narrator": "赤髪千羽鶴", "text": "正直に\n言ってくださって\nありがとうございます。"},
        { "location": "451/ACT"   , "narrator": "", "text": "それって逆に言えば、2E113に蒸着さえしなければ、原初も存在できる？"},
        { "location": "453/TALK"  , "narrator": "赤髪千羽鶴", "text": "まあ、そうですね。"},
        { "location": "454/TALK"  , "narrator": "赤髪千羽鶴", "text": "フェノメノンが安定化、\nすなわち蒸着しないで\n存在している限りは――"},
        { "location": "455/TALK"  , "narrator": "赤髪千羽鶴", "text": "フェノメノンの内外は\n重ね合わせ状態です。"},
        { "location": "456/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしはこのように\n存在できますね。"},
        { "location": "457/SEL"   , "narrator": "", "text": "じゃあ、フェノメノンを永遠にそのままにして、共存し続けるのもアリ？"},
        { "location": "458/ACT"   , "narrator": "", "text": "じゃあ、フェノメノンを永遠にそのままにして、共存し続けるのもアリ？"},
        { "location": "460/TALK"  , "narrator": "赤髪千羽鶴", "text": "ナシではありませんが、\n不安定な世界はいずれ\nバランスを崩します。"},
        { "location": "461/TALK"  , "narrator": "赤髪千羽鶴", "text": "いずれはわたしか、\n可愛いつばめ＆千羽鶴の\nどちらかが消える運命かと"},
        { "location": "462/TALK"  , "narrator": "赤髪千羽鶴", "text": "まあ、ただ、確かに――"},
        { "location": "463/TALK"  , "narrator": "赤髪千羽鶴", "text": "世界が二重化し続ける\nということを抜きにすれば"},
        { "location": "464/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしと千羽鶴たちが\n両方存在し、“彼ら”の\n脅威は無効化できる――"},
        { "location": "465/TALK"  , "narrator": "赤髪千羽鶴", "text": "いいとこ取りみたいな\n結果にはなるかも\nしれませんね。"},
        { "location": "466/TALK"  , "narrator": "赤髪千羽鶴", "text": "もちろん、卯月さんの\n精神力が持てば、\nという前提ですが。"},
        { "location": "467/TALK"  , "narrator": "赤髪千羽鶴", "text": "彼女はわたしと違い\n普通の人間です。"},
        { "location": "468/TALK"  , "narrator": "赤髪千羽鶴", "text": "才能はずば抜けていますが\n松果体は人並みです。"},
        { "location": "469/TALK"  , "narrator": "赤髪千羽鶴", "text": "もちろん、途中で\nわたしがフェノメノンを\n肩代わりもできますが……"},
        { "location": "470/TALK"  , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "471/TALK"  , "narrator": "赤髪千羽鶴", "text": "いずれにせよ、もう１つ\n必ずついて回る問題が\nありますね。"},
        { "location": "472/SEL"   , "narrator": "", "text": "なに？？"},
        { "location": "473/ACT"   , "narrator": "", "text": "なに？？"},
        { "location": "475/TALK"  , "narrator": "赤髪千羽鶴", "text": "蒸着しない以上、\nそのフェノメノンは、\n貴方の世界に依存します。"},
        { "location": "476/TALK"  , "narrator": "赤髪千羽鶴", "text": "貴方の世界との接続が\n切れてしまったら――"},
        { "location": "477/TALK"  , "narrator": "赤髪千羽鶴", "text": "ディテールの維持は\n不可能になり、閉じるか\nトンデモ世界で継続するか"},
        { "location": "478/TALK"  , "narrator": "赤髪千羽鶴", "text": "いずれかの方法を\n取らざるを得なく\nなりますね。"},
        { "location": "479/TALK"  , "narrator": "赤髪千羽鶴", "text": "まあ、いずれにせよ、\nいいとこ取りは無理と\nいうことでしょうか。"},
        { "location": "480/TALK"  , "narrator": "赤髪千羽鶴", "text": "とはいえ、まずは\n歴史を記録映像に合致\nさせなければなりません。"},
        { "location": "481/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、ひとまずは\n卯月さんの発症について\nご協力お願いします。"},
        { "location": "483/SEL"   , "narrator": "", "text": "ところで、あまり聞きたくない事なんだけど"},
        { "location": "484/ACT"   , "narrator": "", "text": "ちなみに、あまり聞きたくない事なんだけど"},
        { "location": "486/TALK"  , "narrator": "赤髪千羽鶴", "text": "はい。"},
        { "location": "487/SEL"   , "narrator": "", "text": "記録映像を再現するってことは、千羽鶴は撃たれるよね？"},
        { "location": "488/ACT"   , "narrator": "", "text": "記録映像を再現するってことは、千羽鶴は撃たれるよね？"},
        { "location": "490/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうですね。"},
        { "location": "491/SEL"   , "narrator": "", "text": "誰が撃つの？"},
        { "location": "492/ACT"   , "narrator": "", "text": "誰が撃つの？"},
        { "location": "494/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしが撃ちます。"},
        { "location": "495/SEL"   , "narrator": "", "text": "自分で撃つの！？"},
        { "location": "496/ACT"   , "narrator": "", "text": "自分で撃つの！？"},
        { "location": "498/TALK"  , "narrator": "赤髪千羽鶴", "text": "はい。\n自分のことですから、\n自分でやります。"},
        { "location": "499/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただ、その時は少し\n貴方にも協力して\nいただくかもしれません。"},
        { "location": "500/TALK"  , "narrator": "赤髪千羽鶴", "text": "どうぞ、よろしく\nお願いします。"},
        { "location": "502/TALK"  , "narrator": "赤髪千羽鶴", "text": "さて。"},
        { "location": "503/TALK"  , "narrator": "赤髪千羽鶴", "text": "これでだいたい、\nわたしの想いは\n伝えきりました。"},
        { "location": "504/TALK"  , "narrator": "赤髪千羽鶴", "text": "貴方がこの話を聞いて\nどう思ったかは\nわたしにはわかりません。"},
        { "location": "505/TALK"  , "narrator": "赤髪千羽鶴", "text": "もう右腕は降りたいと\n思っているかも\nしれませんね。"},
        { "location": "506/TALK"  , "narrator": "赤髪千羽鶴", "text": "もしそうであれば、\n我慢せず、降りて\nいただいて構いません。"},
        { "location": "507/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただ、せっかく一時でも\n右腕になってくれて\nいたのですから――"},
        { "location": "508/TALK"  , "narrator": "赤髪千羽鶴", "text": "その権利を使って\nいかれては如何かと\n思っています。"},
        { "location": "509/TALK"  , "narrator": "赤髪千羽鶴", "text": "もちろん、これからも\n右腕でいてくださるなら\n是非権利行使して下さい。"},
        { "location": "510/SEL"   , "narrator": "", "text": "どうすればいいの？"},
        { "location": "511/ACT"   , "narrator": "", "text": "どうすればいいの？"},
        { "location": "513/TALK"  , "narrator": "赤髪千羽鶴", "text": "この世界を、どんな\n思想のもと、統治して\nいくのがよいのか――"},
        { "location": "514/TALK"  , "narrator": "赤髪千羽鶴", "text": "それを、\n貴方の世界のSNSに\n書いて欲しいのです。"},
        { "location": "515/TALK"  , "narrator": "赤髪千羽鶴", "text": "それこそが、あなたと共に\n“彼ら”の統治方針を\n修正する方法になります。"},
        { "location": "516/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしは、その記述から\n想いを読み取り、彼らの\nRedinessに流します。"},
        { "location": "517/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただ、場合によっては、\nその結果を貴方が見られる\nかどうかはわかりません。"},
        { "location": "518/TALK"  , "narrator": "赤髪千羽鶴", "text": "可愛いつばめたちと\n共にいることを\n選択するならば――"},
        { "location": "519/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしが存在する世界は\n別の軸に飛びますから、\n結果は見られませんよね。"},
        { "location": "520/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですが、貴方の想いは\n確かにわたしが受け取る\nことが出来るのです。"},
        { "location": "521/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、どうか\n宜しくお願いします。"},
        { "location": "522/TALK"  , "narrator": "赤髪千羽鶴", "text": "あなたの世界のSNSに――"},
        { "location": "523/TALK"  , "narrator": "赤髪千羽鶴", "text": "<color=green>#トライナリー理想の社会</color>\nというタグで書いて下さい"},
        { "location": "524/TALK"  , "narrator": "赤髪千羽鶴", "text": "どうか、\n宜しくお願いします。"},
        { "location": "527/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしがお伝えしたい\nことは、これで以上と\nなります。"},
        { "location": "528/TALK"  , "narrator": "赤髪千羽鶴", "text": "これからわたしは、\n自分の目標に向けて最善を\n尽くしていきますが――"},
        { "location": "529/TALK"  , "narrator": "赤髪千羽鶴", "text": "その隣に貴方が\n寄り添ってくれることを\n切に願っています。"},
        { "location": "530/TALK"  , "narrator": "赤髪千羽鶴", "text": "それでは、これで。"},
        { "location": "531/TALK"  , "narrator": "赤髪千羽鶴", "text": "貴方とわたしに、\n素敵なココロの旅を。"},
        { "location": "536/TALK"  , "narrator": "千羽鶴", "text": "というわけで。"},
        { "location": "537/SEL"   , "narrator": "", "text": "ちーちゃん！"},
        { "location": "538/SEL"   , "narrator": "", "text": "どーんして！！"},
        { "location": "539/SEL"   , "narrator": "", "text": "恥じらいながらどーんして！"},
        { "location": "540/ACT"   , "narrator": "", "text": "ちーちゃん！"},
        { "location": "541/TALK"  , "narrator": "千羽鶴", "text": "ごきげんよう。"},
        { "location": "542/ACT"   , "narrator": "", "text": "どーんして！！"},
        { "location": "545/TALK"  , "narrator": "千羽鶴", "text": "<size=40>どーん！</size>"},
        { "location": "546/TALK"  , "narrator": "千羽鶴", "text": "これで満足？\nさて――"},
        { "location": "547/ACT"   , "narrator": "", "text": "恥じらいながらどーんして！"},
        { "location": "548/TALK"  , "narrator": "千羽鶴", "text": "どーん…。"},
        { "location": "549/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "550/TALK"  , "narrator": "千羽鶴", "text": "何をさせたいのか\n意味がわからない。"},
        { "location": "551/SEL"   , "narrator": "", "text": "とか言いつつノリノリじゃん"},
        { "location": "552/ACT"   , "narrator": "", "text": "とか言いつつノリノリじゃん"},
        { "location": "556/TALK"  , "narrator": "千羽鶴", "text": "<size=40>どーん！</size>"},
        { "location": "557/TALK"  , "narrator": "千羽鶴", "text": "先へ進む。"},
        { "location": "559/TALK"  , "narrator": "千羽鶴", "text": "総意の総意についての\n話はエリカから聞いたと\n思うけど。"},
        { "location": "560/TALK"  , "narrator": "千羽鶴", "text": "私からも伝えたいのは、\nここから先、貴方が思う\n通りに選択して欲しい。"},
        { "location": "561/TALK"  , "narrator": "千羽鶴", "text": "その結果は、どれほど\n分散しようとも、総意に\n遮られることは無いから。"},
        { "location": "562/TALK"  , "narrator": "千羽鶴", "text": "貴方だけのやり方で、\n貴方の大切な人を\n幸せにして欲しい。"},
        { "location": "563/TALK"  , "narrator": "千羽鶴", "text": "と、まあ、\nそれはそれとして。"},
        { "location": "564/TALK"  , "narrator": "千羽鶴", "text": "私は私で、貴方にお願い\nしたい事があるから、\nその話をしようと思う。"},
        { "location": "565/TALK"  , "narrator": "千羽鶴", "text": "もちろん、私の話を聞いて\nその通りに動く必要は\nない。"},
        { "location": "566/TALK"  , "narrator": "千羽鶴", "text": "自分で言うのも何だけど。"},
        { "location": "567/TALK"  , "narrator": "千羽鶴", "text": "話を聞いて、\nそれが自分にとって\n必要かどうか――"},
        { "location": "568/TALK"  , "narrator": "千羽鶴", "text": "自分のビジョンに\nあってるかどうか。"},
        { "location": "569/TALK"  , "narrator": "千羽鶴", "text": "それを考えて、\n合っているなら協力して\nくれればいいし、"},
        { "location": "570/TALK"  , "narrator": "千羽鶴", "text": "合ってないなら\n無視しても構わない。"},
        { "location": "571/SEL"   , "narrator": "", "text": "はい"},
        { "location": "572/ACT"   , "narrator": "", "text": "はい"},
        { "location": "575/TALK"  , "narrator": "千羽鶴", "text": "ありがと。\nそれじゃ説明する。"},
        { "location": "577/TALK"  , "narrator": "千羽鶴", "text": "彼女たちとの対話は、\nアースタシアに\n依頼してあるから。"},
        { "location": "578/TALK"  , "narrator": "千羽鶴", "text": "話をしたり、\nよく考えたりしながら、\n貴方の道を突き進んで。"},
        { "location": "579/TALK"  , "narrator": "千羽鶴", "text": "恐らく、ここまでの\nチャンスはこれが最初で\n最後になる。"},
        { "location": "580/TALK"  , "narrator": "千羽鶴", "text": "どうか、貴方の\n正直な想いを、この選択に\nぶつけて欲しい。"},
        { "location": "581/TALK"  , "narrator": "千羽鶴", "text": "悔いのないように。"},
        { "location": "582/SEL"   , "narrator": "", "text": "ちなみに、あまり聞きたくない事なんだけど"},
        { "location": "583/ACT"   , "narrator": "", "text": "ちなみに、あまり聞きたくない事なんだけど"},
        { "location": "585/TALK"  , "narrator": "千羽鶴", "text": "なに？"},
        { "location": "586/SEL"   , "narrator": "", "text": "記録映像を再現するってことは、千羽鶴は撃たれるよね？"},
        { "location": "587/ACT"   , "narrator": "", "text": "記録映像を再現するってことは、千羽鶴は撃たれるよね？"},
        { "location": "589/TALK"  , "narrator": "千羽鶴", "text": "その通り。"},
        { "location": "590/SEL"   , "narrator": "", "text": "誰が撃つの？"},
        { "location": "591/ACT"   , "narrator": "", "text": "誰が撃つの？"},
        { "location": "593/TALK"  , "narrator": "千羽鶴", "text": "私とエリカの\n二人で当たる。"},
        { "location": "594/SEL"   , "narrator": "", "text": "自分で撃つの！？"},
        { "location": "595/ACT"   , "narrator": "", "text": "自分で撃つの！？"},
        { "location": "597/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "598/TALK"  , "narrator": "千羽鶴", "text": "自分の後始末は\n自分でする。\n当たり前のこと。"},
        { "location": "599/TALK"  , "narrator": "千羽鶴", "text": "それに、こればかりは\nもとの世界線に戻る為に\n必要な儀式だから。"},
        { "location": "600/TALK"  , "narrator": "千羽鶴", "text": "そうしなければ、今の私も\n一緒に無かったことに\nされてしまうし。"},
        { "location": "601/TALK"  , "narrator": "千羽鶴", "text": "だから、大丈夫。\n貴方は見守っていて。"},
        { "location": "602/TALK"  , "narrator": "千羽鶴", "text": "いよいよ本当の\n正念場に突入しつつ\nあるけど――"},
        { "location": "604/TALK"  , "narrator": "千羽鶴", "text": "ここまでつき合ってくれて\n本当にありがとう。"},
        { "location": "605/TALK"  , "narrator": "千羽鶴", "text": "貴方を最初に\nつかまえたとき、私は実は\n少し不安だった。"},
        { "location": "606/TALK"  , "narrator": "千羽鶴", "text": "けれども、今は\n幸運だったと思ってる。"},
        { "location": "607/TALK"  , "narrator": "千羽鶴", "text": "なぜならそれは、\n貴方だったから。"},
        { "location": "608/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\n後もう少しだけど、\n最後までよろしく。"},
        { "location": "609/TALK"  , "narrator": "千羽鶴", "text": "貴方と私に\n素敵なココロの旅を。"},
        { "location": "611/TALK"  , "narrator": "千羽鶴", "text": "貴方は卯月神楽を\n発症させたくないという\n意志を持っている。"},
        { "location": "614/TALK"  , "narrator": "千羽鶴", "text": "貴方は、日本は再度\n焼け野原からやり直すべき\nという考えを持っている。"},
        { "location": "617/TALK"  , "narrator": "千羽鶴", "text": "貴方は、ライフギャザーは\nこの世から抹消すべき\nという考えを持っている。"},
        { "location": "620/TALK"  , "narrator": "千羽鶴", "text": "貴方は、どういう理由か\n解らないけど、発症を\nさせたくないと思ってる。"},
        { "location": "621/TALK"  , "narrator": "千羽鶴", "text": "それ自体は、自分の中の\n信念に基づいての方針なら\n問題ないと思う。"},
        { "location": "623/TALK"  , "narrator": "千羽鶴", "text": "だから、自分に後悔がない\nように良く考えた上で、\nそれを実行すればいい。"},
        { "location": "624/TALK"  , "narrator": "千羽鶴", "text": "私は私で、自分の理想の\n為に最大限の努力はする\nけれども――"},
        { "location": "625/TALK"  , "narrator": "千羽鶴", "text": "貴方は貴方の最善を\n尽くせばいいから。"},
        { "location": "626/TALK"  , "narrator": "千羽鶴", "text": "けれども、貴方がもし、\n一時的な彼女の発症を\n容認してくれるなら。"},
        { "location": "627/TALK"  , "narrator": "千羽鶴", "text": "それだけのリスクを負う\n価値があると思えるなら、\n是非発症をお願いしたい。"},
        { "location": "628/SEL"   , "narrator": "", "text": "それは無いです"},
        { "location": "629/SEL"   , "narrator": "", "text": "詳しく教えてくれれば考える"},
        { "location": "630/ACT"   , "narrator": "", "text": "それは無いです"},
        { "location": "631/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "632/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\n私からのお話は\nこれでお終い。"},
        { "location": "633/TALK"  , "narrator": "千羽鶴", "text": "どうか、貴方の考える\n彼女たちの幸せに、信念を\n持って邁進して欲しい！"},
        { "location": "634/TALK"  , "narrator": "千羽鶴", "text": "健闘を祈ってる。"},
        { "location": "635/ACT"   , "narrator": "", "text": "詳しく教えてくれれば考える"},
        { "location": "636/TALK"  , "narrator": "千羽鶴", "text": "ありがと。\nそれじゃ、今から\n説明する。"},
        { "location": "638/TALK"  , "narrator": "千羽鶴", "text": "もし、賛同してもいいと\n言ってくれるのなら――"},
        { "location": "639/TALK"  , "narrator": "千羽鶴", "text": "CH05の発症ボタンを\n押したら、またここに\n戻って来て。"},
        { "location": "640/TALK"  , "narrator": "千羽鶴", "text": "私から１つだけ\n伝えたい事は。"},
        { "location": "641/TALK"  , "narrator": "千羽鶴", "text": "どのような選択をしても、\n貴方自身に悔いが残らない\nようにして欲しい。"},
        { "location": "642/TALK"  , "narrator": "千羽鶴", "text": "ただそれだけ。"},
        { "location": "643/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、よろしく。"},
        { "location": "225/DIALOG", "narrator": "INFO", "text": "只今より、パラメトリック理論に基づく世界選択法による総意モードに移行します。テーマは\n<color=green><size=32>【貴方のこの世界への想い】</size></color>\nです。\n<color=blue>\nこの総意は、貴方の世界のSNSにおいて「#トライナリー未来への想い」タグによって記述することで有効となります。\n\n尚、この総意は世界を収束させることはありません。貴方の想いが、それに準ずる何らかの形で世界に反映され、緩やかな世界選択が行われるものです。よって、必ずしも書き込まれた想いそのままの世界が展開されるわけではありません。\n</color>\n総意の収集期間は、2018年7月16日0時までとなります。\n"},
