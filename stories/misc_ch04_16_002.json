    "entry":
    [
        { "location": "108/SCENARIO", "narrator": "", "text": "05_000_本日もお日柄がよく"},
        { "location": "133/TALK"    , "narrator": "みやび", "text": "つまりは結婚式及び披露宴は"},
        { "location": "134/TALK"    , "narrator": "みやび", "text": "ゴールではなく"},
        { "location": "135/TALK"    , "narrator": "みやび", "text": "新しい門出なわけだが"},
        { "location": "137/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "138/SEL"     , "narrator": "", "text": "招待でもされたの？"},
        { "location": "139/SEL"     , "narrator": "", "text": "$me$との新しい門出に乾杯！"},
        { "location": "140/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "141/TALK"    , "narrator": "みやび", "text": "おや"},
        { "location": "142/TALK"    , "narrator": "みやび", "text": "知らんだかよ"},
        { "location": "143/ACT"     , "narrator": "", "text": "招待でもされたの？"},
        { "location": "144/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "145/TALK"    , "narrator": "みやび", "text": "そういうわけでもないが"},
        { "location": "146/ACT"     , "narrator": "", "text": "$me$との新しい門出に乾杯！"},
        { "location": "148/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "149/TALK"    , "narrator": "みやび", "text": "そんな話になるとは"},
        { "location": "150/TALK"    , "narrator": "みやび", "text": "思いもせんかったぞね"},
        { "location": "152/TALK"    , "narrator": "みやび", "text": "双方の同意が得られることなど"},
        { "location": "153/TALK"    , "narrator": "みやび", "text": "あるのだろうか"},
        { "location": "155/SEL"     , "narrator": "", "text": "ないと困るよね……？"},
        { "location": "156/SEL"     , "narrator": "", "text": "強引なのがいい時もある"},
        { "location": "157/SEL"     , "narrator": "", "text": "同意が得られるよう努力する"},
        { "location": "158/ACT"     , "narrator": "", "text": "ないと困るよね……？"},
        { "location": "159/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "160/TALK"    , "narrator": "みやび", "text": "それだけに"},
        { "location": "162/TALK"    , "narrator": "みやび", "text": "うちは困惑するぞね"},
        { "location": "163/TALK"    , "narrator": "みやび", "text": "重要課題ぞね"},
        { "location": "164/ACT"     , "narrator": "", "text": "強引なのがいい時もある"},
        { "location": "165/TALK"    , "narrator": "みやび", "text": "うわ"},
        { "location": "166/TALK"    , "narrator": "みやび", "text": "それはないわー"},
        { "location": "167/TALK"    , "narrator": "みやび", "text": "本気でないわー"},
        { "location": "168/ACT"     , "narrator": "", "text": "同意が得られるよう努力する"},
        { "location": "170/TALK"    , "narrator": "みやび", "text": "$handle$は"},
        { "location": "172/TALK"    , "narrator": "みやび", "text": "意外と"},
        { "location": "173/TALK"    , "narrator": "みやび", "text": "建設的な思考をするようだの"},
        { "location": "174/TALK"    , "narrator": "みやび", "text": "見直した"},
        { "location": "175/TALK"    , "narrator": "みやび", "text": "あ"},
        { "location": "176/TALK"    , "narrator": "みやび", "text": "少しだけな"}
    ]
}
