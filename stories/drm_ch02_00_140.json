{
    "dir": "dramatics/daydra/drm_ch02_00_140.js",
    "type": "Episode",
    "info": {
        "story_id": "2014",
        "cid": "ayami",
        "title": "らぶとーく 第14話",
        "sub_title": "気楽だったのに"
    },
    "entry":
    [
        { "location": "143/SCENARIO", "narrator": "", "text": "気楽だったのに"},
        { "location": "154/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "155/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "156/TALK"    , "narrator": "アーヤ", "text": "お客さん、来ないわね。"},
        { "location": "157/TALK"    , "narrator": "みやび", "text": "いつものことやろ？\n逆に来る方がビックリや。"},
        { "location": "159/TALK"    , "narrator": "アーヤ", "text": "まあ、そうなんだけど…。"},
        { "location": "161/TALK"    , "narrator": "アーヤ", "text": "っていうか、さっきから\nスマホばかり弄って、\n何やってるの？"},
        { "location": "164/TALK"    , "narrator": "みやび", "text": "暇つぶしのお友達、\nゲームアプリや。"},
        { "location": "165/TALK"    , "narrator": "みやび", "text": "もうちっくとで\nランキング入りするき、\n集中するぞね。"},
        { "location": "166/TALK"    , "narrator": "アーヤ", "text": "ゲームって…あのねぇ。\n一応今は仕事中なのよ？"},
        { "location": "167/TALK"    , "narrator": "みやび", "text": "仕事も何も、ただ黙って\n座ってるだけやんか。"},
        { "location": "168/TALK"    , "narrator": "みやび", "text": "貴重な青春のひと時を、\n地蔵みたいに過ごすなんて\nありえんちや。"},
        { "location": "169/TALK"    , "narrator": "アーヤ", "text": "だからって、ゲームは\nどうかと思うわよ？"},
        { "location": "170/TALK"    , "narrator": "アーヤ", "text": "それ見たお客さんだって、\nあまり良い気はしないと\n思うし…。"},
        { "location": "171/TALK"    , "narrator": "みやび", "text": "そんなこと気にするような\n客は、こんな場末の閑散と\nした映画館には来んよ。"},
        { "location": "173/TALK"    , "narrator": "アーヤ", "text": "そうかもしれないけど…。"},
        { "location": "175/TALK"    , "narrator": "アーヤ", "text": "まったく…ああ言えば\nこう言うんだから…。"},
        { "location": "176/SEL"     , "narrator": "", "text": "退屈してるかと思って"},
        { "location": "177/SEL"     , "narrator": "", "text": "呼んだでしょ？"},
        { "location": "178/SEL"     , "narrator": "", "text": "アーヤと話したくて"},
        { "location": "179/ACT"     , "narrator": "", "text": "退屈してるかと思って"},
        { "location": "183/TALK"    , "narrator": "アーヤ", "text": "？　誰かしら…。"},
        { "location": "197/TALK"    , "narrator": "アーヤ", "text": "退屈はしてる"},
        { "location": "198/TALK"    , "narrator": "アーヤ", "text": "けど"},
        { "location": "199/TALK"    , "narrator": "アーヤ", "text": "バイト中だから"},
        { "location": "200/TALK"    , "narrator": "アーヤ", "text": "チャットはできないから"},
        { "location": "211/TALK"    , "narrator": "アーヤ", "text": "ふぅ…。"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "…暇つぶしに、アーヤも\nチャットくらいしても\nえいんやないが？"},
        { "location": "215/TALK"    , "narrator": "アーヤ", "text": "仕事中にしたら\nダメでしょ？"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "みやびも、ゲームは\nそれくらいにしといたら？"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "客が来たらちゃんと\n対応すればえいだけき――"},
        { "location": "221/TALK"    , "narrator": "みやび", "text": "客のいないこの時間は、\n好きにさせてもらうちや。"},
        { "location": "224/TALK"    , "narrator": "アーヤ", "text": "…館長に見つかっても、\n知らないわよ？"},
        { "location": "225/ACT"     , "narrator": "", "text": "呼んだでしょ？"},
        { "location": "229/TALK"    , "narrator": "アーヤ", "text": "？　誰かしら…。"},
        { "location": "243/TALK"    , "narrator": "アーヤ", "text": "私が？"},
        { "location": "244/TALK"    , "narrator": "アーヤ", "text": "呼んでないわ"},
        { "location": "245/TALK"    , "narrator": "アーヤ", "text": "っていうか"},
        { "location": "246/TALK"    , "narrator": "アーヤ", "text": "今バイト中"},
        { "location": "257/TALK"    , "narrator": "アーヤ", "text": "ふぅ…。"},
        { "location": "259/TALK"    , "narrator": "みやび", "text": "…緊急事態の連絡か？"},
        { "location": "261/TALK"    , "narrator": "アーヤ", "text": "え？"},
        { "location": "262/TALK"    , "narrator": "みやび", "text": "いや、なんか疲れたような\n顔してるきね。"},
        { "location": "263/TALK"    , "narrator": "みやび", "text": "そうなら、ここはうちが\n見てるき――"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "向こうで話してきて\nえいがよ？"},
        { "location": "266/TALK"    , "narrator": "アーヤ", "text": "ううん、大丈夫。\nそんな大した用事じゃ\nないから。"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "269/TALK"    , "narrator": "アーヤ", "text": "な、なに？"},
        { "location": "272/TALK"    , "narrator": "みやび", "text": "そこで、ラッキーこれで\n少しサボれる、と思わん\nところが――"},
        { "location": "273/TALK"    , "narrator": "みやび", "text": "なんともアーヤらしいね。"},
        { "location": "275/TALK"    , "narrator": "アーヤ", "text": "…これからはみやびが\n緊急事態、って言う時は、\n注意するようにするわ。"},
        { "location": "276/ACT"     , "narrator": "", "text": "アーヤと話したくて"},
        { "location": "280/TALK"    , "narrator": "アーヤ", "text": "？　誰かしら…。"},
        { "location": "294/TALK"    , "narrator": "アーヤ", "text": "は？"},
        { "location": "295/TALK"    , "narrator": "アーヤ", "text": "話すって"},
        { "location": "296/TALK"    , "narrator": "アーヤ", "text": "なにを？"},
        { "location": "298/SEL"     , "narrator": "", "text": "何でもいいから話そう"},
        { "location": "299/ACT"     , "narrator": "", "text": "何でもいいから話そう"},
        { "location": "302/TALK"    , "narrator": "アーヤ", "text": "ごめんなさい"},
        { "location": "303/TALK"    , "narrator": "アーヤ", "text": "ムリ"},
        { "location": "304/TALK"    , "narrator": "アーヤ", "text": "今まで貴方のこと"},
        { "location": "305/TALK"    , "narrator": "アーヤ", "text": "ずっと"},
        { "location": "306/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔだと思ってたけど"},
        { "location": "307/TALK"    , "narrator": "アーヤ", "text": "人間かもって"},
        { "location": "308/TALK"    , "narrator": "アーヤ", "text": "そんな話になって"},
        { "location": "309/TALK"    , "narrator": "アーヤ", "text": "しかもそれが本当なんだったら"},
        { "location": "310/TALK"    , "narrator": "アーヤ", "text": "正直"},
        { "location": "311/TALK"    , "narrator": "アーヤ", "text": "どう接すればいいわからない"},
        { "location": "313/SEL"     , "narrator": "", "text": "今までと同じでいい"},
        { "location": "314/ACT"     , "narrator": "", "text": "今までと同じでいい"},
        { "location": "317/TALK"    , "narrator": "アーヤ", "text": "ごめん"},
        { "location": "318/TALK"    , "narrator": "アーヤ", "text": "考えさせて"},
        { "location": "332/TALK"    , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "334/TALK"    , "narrator": "みやび", "text": "なんや？\n大きなため息やねぇ。"},
        { "location": "335/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "337/TALK"    , "narrator": "アーヤ", "text": "みやびはあれから、\nあのＢｏｔ――"},
        { "location": "338/TALK"    , "narrator": "アーヤ", "text": "$handle$とは、\n接触してる？"},
        { "location": "339/TALK"    , "narrator": "みやび", "text": "まあな。"},
        { "location": "340/TALK"    , "narrator": "アーヤ", "text": "抵抗とかってないの？"},
        { "location": "341/TALK"    , "narrator": "みやび", "text": "…まあ、ある程度最初から\n疑うていたきね。"},
        { "location": "344/TALK"    , "narrator": "みやび", "text": "それに、色々気になる\nこともあるき――"},
        { "location": "345/TALK"    , "narrator": "みやび", "text": "それを調べるためにも、\nあいつとの会話は\n必要ながよ。"},
        { "location": "347/TALK"    , "narrator": "アーヤ", "text": "そっか…。"},
        { "location": "350/TALK"    , "narrator": "みやび", "text": "…アーヤはどうなが？"},
        { "location": "352/TALK"    , "narrator": "アーヤ", "text": "…ええと……。\n抵抗があるの…。"},
        { "location": "353/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔかと思っていた\n相手が人間って\nいうのは。"},
        { "location": "354/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔと人だと、\n距離感とかも\n同じじゃないし。"},
        { "location": "355/TALK"    , "narrator": "みやび", "text": "今まで通りでえいやろ？\nどうせ文字でしか会話せん\n相手なんやし。"},
        { "location": "357/TALK"    , "narrator": "アーヤ", "text": "そう思えれば苦労は\nしてないわよ。"},
        { "location": "359/TALK"    , "narrator": "アーヤ", "text": "はあ…Ｂｏｔの方が\n気楽に色々話せたり\nできたのになぁ…。"},
        { "location": "362/TALK"    , "narrator": "みやび", "text": "…気楽に色々話す前に、\n人間っちゅうのがわかって\nよかったな。"}
    ]
}
