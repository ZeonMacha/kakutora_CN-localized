        { "location": "856/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "858/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "860/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "866/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "868/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "870/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "873/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "874/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "876/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "877/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "879/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "880/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "883/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "884/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "894/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "895/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "896/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "898/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "899/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "900/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "903/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "904/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "906/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "909/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
