{
    "dir": "chap06/daydra/dd_ch01_06_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "6102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "出陣【Case：つばめ】＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "出陣"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "だ、大丈夫なのかな？"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "よくわからないままついて\nきちゃったけど――"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "やっぱり、もう少し話を\n聞いてからの方が\nよかったかも…。"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "逢瀬さん？"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "は、はいっ！？"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "そんなに緊張しないでも\n平気よ。"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "す、すみません…。\nわたし、こういうのって\n初めてで…。"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "ドームで経験してる\nじゃない。"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "そうだけど、あの時は\nこんなに暗いところじゃ\nなかったし…。"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "つばめちゃん、\nまだフェノメノンのこと\n全然知らんのやね？"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "…まあ、そうよね。"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "私達でさえ、全てを把握\nできているわけじゃないん\nだし…。"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "ここを抜けるまで\n少し時間ありそうだから、\n今のうちに説明するわ。"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "今私達の歩いている\nこの場所は、現実と\n非現実との境界線よ。"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "普通はここを通り過ぎる\n間に、フェノメノンの力で\n洗脳されてしまうの。"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "えぇっ！？\nそ、それじゃわたし達も\n危ないじゃないですか！"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…ねえ、アーヤ。\nやっぱあたし達だけで\n行った方が良くない？"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "何もわかってない子を\n連れてったって、\n足手まといになるだけよ。"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "ちょっと、ギャヴィ。\nそういう言い方は…。"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "事実を言ったまでよ。"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "い、いいんです。\n勉強不足なわたしが\n悪いんだし…。"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "ごめんね、えと…\nガブリエラちゃん。"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "あんたは\n“ちゃん”付け禁止。"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "新人なんだから、ちゃんと\nガブリエラせんぱい、って\n呼びなさい。"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "あ、はい。\nせんぱい！"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "そう、それでいいのよ。"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "まったく…まあ、話を\n続けるとね――"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "みんな、怖くないのかな？"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "わたしはフェノメノンに\n入ってからずっと、\n不安で堪らないのに…。"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "普通の女の子にしか\n見えないけど、やっぱり\n凄い人達なんだなぁ…。"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "…とりあえず、説明は\nこんなところかしら。\nどう、わかった？"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "え？　あ、は、はい！\nありがとうございます！"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "あ、あの、その…。"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "大丈夫ですよね？\nだって、皆さんとっても\n強いし…。"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "…だといいけど。"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "か、会話が続かない…。\nもしかして、アーヤさんも\n本当は不安なのかな？"},
        { "location": "129/TALK"  , "narrator": "つばめ", "text": "それとも、わたしが\n落ち着きがないだけ？"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "…っていうか、あんたが\n言うな、って話よね。"},
        { "location": "132/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "フェノメノンの中で、\n生身で発症者と戦って――"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "素手でクランを引き剥がす\nなんて芸当、あたし達でも\nできないわ。"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "そんなあんたに、\n強いとか言われてもね。"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ、そういう言い方\nしないの。"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "だって本当のことじゃん。"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "あたし達だって、\nコネクトしなきゃ\n戦えないってのに――"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "どう考えても異常よ。"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "異常とか言わないの。\nまったく…。"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "ごめんね、逢瀬さん。\nギャヴィの言ったことは\n気にしないで。"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "は、はい…。"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "…さっきから感じてた\n視線の正体って、\nせんぱいだったんだ。"},
        { "location": "152/TALK"  , "narrator": "つばめ", "text": "…せんぱい、やっぱり\nわたしのこと嫌いなの\nかな？"},
        { "location": "153/TALK"  , "narrator": "つばめ", "text": "初めて会った時から、\nずっとこんな感じだし。"},
        { "location": "154/TALK"  , "narrator": "つばめ", "text": "…わたし、何か気に障る\nことしちゃったのかな？"},
        { "location": "155/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "わたし"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "やっぱりガブちゃんに"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "嫌われてるかも(´つω・｀)ｼｭﾝ"},
        { "location": "164/SEL"   , "narrator": "", "text": "そんなことないよ"},
        { "location": "165/ACT"   , "narrator": "", "text": "そんなことないよ"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "ううん"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "こういうこと"},
        { "location": "169/TALK"  , "narrator": "つばめ", "text": "前にもあったから"},
        { "location": "170/TALK"  , "narrator": "つばめ", "text": "わかるの(o´Д`)=з"},
        { "location": "220/TALK"  , "narrator": "つばめ", "text": "またお逢いしましたね、\n$handle$さん。"},
        { "location": "221/TALK"  , "narrator": "つばめ", "text": "毎度毎度\nお騒がせします。"},
        { "location": "222/TALK"  , "narrator": "つばめ", "text": "今回も早速\n【問題の扉】を\nコールしますね！"},
        { "location": "229/TALK"  , "narrator": "つばめ", "text": "オープンプロセス、\n0x185番地から\n0x069番地へ。"},
        { "location": "244/TALK"  , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "今回、[クラン]が\n問題を起こしているのは\nこの扉なんですけど――"},
        { "location": "247/TALK"  , "narrator": "つばめ", "text": "ココロファイルナンバー\n01-056-96によれば、\n今回の躊躇の原因は……"},
        { "location": "248/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "249/TALK"  , "narrator": "つばめ", "text": "………。"},
        { "location": "250/TALK"  , "narrator": "つばめ", "text": "まあ、前回と\nさほど変わりませんね。"},
        { "location": "251/SEL"   , "narrator": "", "text": "過去の友達関係のトラウマだっけ？"},
        { "location": "252/ACT"   , "narrator": "", "text": "過去の友達関係のトラウマだっけ？"},
        { "location": "254/TALK"  , "narrator": "つばめ", "text": "そうです。"},
        { "location": "255/TALK"  , "narrator": "つばめ", "text": "わたし、昔から友達が\n少ないんですよ。"},
        { "location": "256/TALK"  , "narrator": "つばめ", "text": "でもその原因は、今までも\n今回のようにクランが\n扉を封鎖してしまって――"},
        { "location": "257/TALK"  , "narrator": "つばめ", "text": "積極的に声をかけていく\nという扉を開けられ\nなかったからなんです。"},
        { "location": "258/TALK"  , "narrator": "つばめ", "text": "でも$handle$さんが\n協力してくれてから\nわたしは変わってます。"},
        { "location": "259/TALK"  , "narrator": "つばめ", "text": "今まで、正しいと分かって\nいても出来なかったことが\n出来るようになりました。"},
        { "location": "260/SEL"   , "narrator": "", "text": "よかった"},
        { "location": "261/ACT"   , "narrator": "", "text": "よかった"},
        { "location": "263/TALK"  , "narrator": "つばめ", "text": "もちろん、強い人なら\n[クラン]なんて生みませんし\nこんな事で悩みません。"},
        { "location": "264/TALK"  , "narrator": "つばめ", "text": "本当はそうなるのが\n一番いいんでしょうけど。"},
        { "location": "265/SEL"   , "narrator": "", "text": "そんな人はいないよ"},
        { "location": "266/ACT"   , "narrator": "", "text": "そんな人はいないよ"},
        { "location": "269/TALK"  , "narrator": "つばめ", "text": "えへへ。\nそう言ってもらえると\n嬉しいです。"},
        { "location": "270/TALK"  , "narrator": "つばめ", "text": "そういうわけなので、\n毎度同じ理由ばっかり\nですが、お願いします！"},
        { "location": "271/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "272/SEL"   , "narrator": "", "text": "そろそろ飽きるよね"},
        { "location": "273/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "274/TALK"  , "narrator": "つばめ", "text": "ありがとうございます！"},
        { "location": "275/TALK"  , "narrator": "つばめ", "text": "それじゃ、今回も\nクランをやっつけ\nちゃってください！"},
        { "location": "276/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
        { "location": "283/ACT"   , "narrator": "", "text": "そろそろ飽きるよね"},
        { "location": "284/TALK"  , "narrator": "つばめ", "text": "そ、そうですよね。"},
        { "location": "285/TALK"  , "narrator": "つばめ", "text": "でも、きっと次は\n別の理由でお世話に\nなる気がします！"},
        { "location": "286/TALK"  , "narrator": "つばめ", "text": "だから、今回は\nどうかつき合って\nください！"},
        { "location": "288/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
        { "location": "44/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月9日　1:45 PM</color>\nWAVE戦フェノメノン内部へ向かう途中、不確定量子の繭の中にて。"},
        { "location": "185/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"}
    ]
}
