    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "028_ヌーベル・バーグ・カフェ"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "ピンクのクリームソーダって"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "見た目もいいわよね(*^.^*)"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "あれはまた食べたいわ"},
        { "location": "36/SEL"    , "narrator": "", "text": "今まで一番のハズレは？"},
        { "location": "37/SEL"    , "narrator": "", "text": "調べてから入ればいいのに"},
        { "location": "38/SEL"    , "narrator": "", "text": "普通の飲めなくなるかも"},
        { "location": "39/ACT"    , "narrator": "", "text": "今まで一番のハズレは？"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "あれは"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "忘れられないわ"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "商店街から須古氏はずれた"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "少し"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "はずれた"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "フレンチレトロな雰囲気のカフェ"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "そこのグリーンスムージー"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "ビタミンを取ろうとして選んだのが敗因ね"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "味は"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "うん"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "聞かないで"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "思い出しちゃったわ、、、"},
        { "location": "61/ACT"    , "narrator": "", "text": "調べてから入ればいいのに"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "そこまでｋいあい入れることじゃないわ"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "気合入れることじゃないわ"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "それに"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "冒険がしたくないってわけじゃないし"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "そういうことよ"},
        { "location": "67/ACT"    , "narrator": "", "text": "普通の飲めなくなるかも"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "いつも当たりならそうかもね"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "意外とそうじゃないのよね"}
    ]
}
