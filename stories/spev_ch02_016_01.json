    "entry":
    [
        { "location": "123/SCENARIO", "narrator": "", "text": "たったひとつのやおよろず"},
        { "location": "125/TALK"    , "narrator": "アーヤ", "text": "そうねえ"},
        { "location": "127/TALK"    , "narrator": "アーヤ", "text": "そうだ"},
        { "location": "128/TALK"    , "narrator": "アーヤ", "text": "六曜って知ってる？"},
        { "location": "129/TALK"    , "narrator": "アーヤ", "text": "あれ本来神社と全く関係ないのよね(>_<)"},
        { "location": "131/SEL"     , "narrator": "", "text": "そうだったんだ？"},
        { "location": "132/SEL"     , "narrator": "", "text": "ていうか、六曜って何？"},
        { "location": "133/SEL"     , "narrator": "", "text": "幕末辺りに成立したらしいね"},
        { "location": "134/ACT"     , "narrator": "", "text": "そうだったんだ？"},
        { "location": "135/TALK"    , "narrator": "アーヤ", "text": "普通の人は"},
        { "location": "136/TALK"    , "narrator": "アーヤ", "text": "やっぱり知らないもの"},
        { "location": "137/ACT"     , "narrator": "", "text": "ていうか、六曜って何？"},
        { "location": "138/TALK"    , "narrator": "アーヤ", "text": "大安とか仏滅とか"},
        { "location": "139/TALK"    , "narrator": "アーヤ", "text": "そういうやつのこと"},
        { "location": "140/ACT"     , "narrator": "", "text": "幕末辺りに成立したらしいね"},
        { "location": "141/TALK"    , "narrator": "アーヤ", "text": "そうそう"},
        { "location": "142/TALK"    , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "143/TALK"    , "narrator": "アーヤ", "text": "でもなんだかいつの間にか"},
        { "location": "144/TALK"    , "narrator": "アーヤ", "text": "神道の一部みたいに思われてたりして"},
        { "location": "145/TALK"    , "narrator": "アーヤ", "text": "なんでこうなっちゃったのかしらね？"},
        { "location": "147/TALK"    , "narrator": "アーヤ", "text": "気にする人も多いから"},
        { "location": "148/TALK"    , "narrator": "アーヤ", "text": "もちろんそういったことも"},
        { "location": "149/TALK"    , "narrator": "アーヤ", "text": "考慮するけどね"},
        { "location": "151/SEL"     , "narrator": "", "text": "商売だしね"},
        { "location": "152/SEL"     , "narrator": "", "text": "波風は立てたくないしね"},
        { "location": "153/SEL"     , "narrator": "", "text": "アーヤは大人だよね"},
        { "location": "154/ACT"     , "narrator": "", "text": "商売だしね"},
        { "location": "155/TALK"    , "narrator": "アーヤ", "text": "そうだけど"},
        { "location": "156/TALK"    , "narrator": "アーヤ", "text": "その言い方はちょっとね"},
        { "location": "157/ACT"     , "narrator": "", "text": "波風は立てたくないしね"},
        { "location": "158/TALK"    , "narrator": "アーヤ", "text": "そういうことなんだけど"},
        { "location": "159/TALK"    , "narrator": "アーヤ", "text": "もう少しね"},
        { "location": "160/ACT"     , "narrator": "", "text": "アーヤは大人だよね"},
        { "location": "161/TALK"    , "narrator": "アーヤ", "text": "実際子供のふりも"},
        { "location": "162/TALK"    , "narrator": "アーヤ", "text": "できない年だしね"},
        { "location": "164/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "165/TALK"    , "narrator": "アーヤ", "text": "少しは落ち着いて見られてるのかしら？"},
        { "location": "166/TALK"    , "narrator": "アーヤ", "text": "だったら"},
        { "location": "167/TALK"    , "narrator": "アーヤ", "text": "悪い気はしないわ"},
        { "location": "170/TALK"    , "narrator": "アーヤ", "text": "こういうのを"},
        { "location": "171/TALK"    , "narrator": "アーヤ", "text": "調べたりするの"},
        { "location": "172/TALK"    , "narrator": "アーヤ", "text": "実は意外と嫌いじゃないの"},
        { "location": "173/TALK"    , "narrator": "アーヤ", "text": "今度ちゃんと"},
        { "location": "174/TALK"    , "narrator": "アーヤ", "text": "調べてみようかな(￣Д￣ )"}
    ]
}
