    "entry":
    [
        { "location": "139/SCENARIO", "narrator": "", "text": "160_友だちなんにんいるのかな"},
        { "location": "164/TALK"    , "narrator": "みやび", "text": "遅いのー"},
        { "location": "165/TALK"    , "narrator": "つばめ", "text": "ごめんなさぃ(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "166/TALK"    , "narrator": "つばめ", "text": "レベル低くて"},
        { "location": "167/TALK"    , "narrator": "みやび", "text": "否カプドラ故に杞憂"},
        { "location": "168/TALK"    , "narrator": "繭", "text": "気にしないでって言ってるんだと思うよ？\n＞みやび先輩の発言"},
        { "location": "169/TALK"    , "narrator": "みやび", "text": "通訳が必要なことか？"},
        { "location": "170/TALK"    , "narrator": "つばめ", "text": "了解しましたヽ(･ω･ )ゝ✧"},
        { "location": "172/SEL"     , "narrator": "", "text": "お取込み中？"},
        { "location": "173/SEL"     , "narrator": "", "text": "出直すね"},
        { "location": "174/SEL"     , "narrator": "", "text": "何このカオス"},
        { "location": "175/TALK"    , "narrator": "繭", "text": "逢瀬さんにはちょっと解説してあげた方がいいかなって思います"},
        { "location": "176/TALK"    , "narrator": "みやび", "text": "言葉は的確かつ端的に"},
        { "location": "177/ACT"     , "narrator": "", "text": "お取込み中？"},
        { "location": "178/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "179/TALK"    , "narrator": "みやび", "text": "まったりだ"},
        { "location": "180/ACT"     , "narrator": "", "text": "出直すね"},
        { "location": "181/TALK"    , "narrator": "みやび", "text": "まあまあ"},
        { "location": "183/TALK"    , "narrator": "みやび", "text": "ゆるりとしていけ"},
        { "location": "184/ACT"     , "narrator": "", "text": "何このカオス"},
        { "location": "185/TALK"    , "narrator": "みやび", "text": "何を言う"},
        { "location": "186/TALK"    , "narrator": "みやび", "text": "女子だけ☆パラダイスだ"},
        { "location": "189/TALK"    , "narrator": "つばめ", "text": "こんばんゎ(*´︶`*)"},
        { "location": "190/TALK"    , "narrator": "繭", "text": "いらっしゃいませ"},
        { "location": "191/SEL"     , "narrator": "", "text": "こんばんは"},
        { "location": "192/SEL"     , "narrator": "", "text": "お邪魔します"},
        { "location": "193/SEL"     , "narrator": "", "text": "みやびとゆっくり話したいな"},
        { "location": "194/ACT"     , "narrator": "", "text": "こんばんは"},
        { "location": "195/TALK"    , "narrator": "みやび", "text": "よい返事じゃの"},
        { "location": "197/TALK"    , "narrator": "繭", "text": "$handle$さんと仲がいいんですね\n＞みやび先輩"},
        { "location": "198/TALK"    , "narrator": "つばめ", "text": "なんだか楽しぃねヽ(*´∀｀*)ﾉ"},
        { "location": "199/ACT"     , "narrator": "", "text": "お邪魔します"},
        { "location": "200/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "202/TALK"    , "narrator": "繭", "text": "ごゆっくり"},
        { "location": "203/TALK"    , "narrator": "つばめ", "text": "人が増えたょヽ(*´∀｀*)ﾉ"},
        { "location": "204/ACT"     , "narrator": "", "text": "みやびとゆっくり話したいな"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "なぬ"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "すればいいではないか"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "すれば"},
        { "location": "219/TALK"    , "narrator": "繭", "text": "じゃあ退出しましょうか？\n＞逢瀬さん"},
        { "location": "220/TALK"    , "narrator": "つばめ", "text": "ぁ"},
        { "location": "221/TALK"    , "narrator": "つばめ", "text": "そぅしたほうがぃぃんだょね"},
        { "location": "222/SEL"     , "narrator": "", "text": "いや、自分のが後から来たし"},
        { "location": "223/SEL"     , "narrator": "", "text": "いて欲しいかも"},
        { "location": "224/SEL"     , "narrator": "", "text": "隅っこでみんなを見ていたい"},
        { "location": "225/ACT"     , "narrator": "", "text": "いや、自分のが後から来たし"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "そうじゃの"},
        { "location": "228/TALK"    , "narrator": "つばめ", "text": "でもせっかく来てくれたのに"},
        { "location": "229/TALK"    , "narrator": "繭", "text": "そうですよね"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "ぬう"},
        { "location": "231/ACT"     , "narrator": "", "text": "いて欲しいかも"},
        { "location": "232/TALK"    , "narrator": "繭", "text": "本当ですか？"},
        { "location": "233/TALK"    , "narrator": "みやび", "text": "さびしんぼうか？"},
        { "location": "234/ACT"     , "narrator": "", "text": "隅っこでみんなを見ていたい"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "それはなんだ"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "座敷童子の真似か？"},
        { "location": "239/TALK"    , "narrator": "つばめ", "text": "和室じゃなぃですょ？"},
        { "location": "240/TALK"    , "narrator": "繭", "text": "え、そこ？"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "とはいえ"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "夜も遅いので"},
        { "location": "244/TALK"    , "narrator": "みやび", "text": "本日は解散ぞね"},
        { "location": "246/SEL"     , "narrator": "", "text": "遅かったかー"},
        { "location": "247/SEL"     , "narrator": "", "text": "残念"},
        { "location": "248/SEL"     , "narrator": "", "text": "また次回ね！"},
        { "location": "249/ACT"     , "narrator": "", "text": "遅かったかー"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "その通り"},
        { "location": "251/ACT"     , "narrator": "", "text": "残念"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "左様か"},
        { "location": "253/ACT"     , "narrator": "", "text": "また次回ね！"},
        { "location": "254/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "257/TALK"    , "narrator": "つばめ", "text": "じゃあまたねヾ(o´∀｀o)ﾉ"},
        { "location": "258/TALK"    , "narrator": "繭", "text": "おやすみなさい"},
        { "location": "259/TALK"    , "narrator": "みやび", "text": "それもこれも"},
        { "location": "261/TALK"    , "narrator": "みやび", "text": "$handle$が来るのが遅いからだ"},
        { "location": "262/TALK"    , "narrator": "みやび", "text": "お説教ぞね"},
        { "location": "265/TALK"    , "narrator": "ボイスメール", "text": "リアルタイムタイムライン"},
        { "location": "210/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>600pt.</b></color></size>\nアップしました！"},
        { "location": "277/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【リアルタイムタイムライン】</color>\nをゲットしました！"}
    ]
