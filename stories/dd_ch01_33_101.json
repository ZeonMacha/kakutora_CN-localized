    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "モノクログレーのいた世界"},
        { "location": "28/TALK"   , "narrator": "つばめ", "text": "痛い…！\n頭が痛い…！\nバラバラになりそう…！"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "$handle$さん\n助けて…！"},
        { "location": "31/SEL"    , "narrator": "", "text": "ここにいるよ"},
        { "location": "32/SEL"    , "narrator": "", "text": "大丈夫？"},
        { "location": "33/SEL"    , "narrator": "", "text": "助けてあげたい！"},
        { "location": "34/ACT"    , "narrator": "", "text": "ここにいるよ"},
        { "location": "35/ACT"    , "narrator": "", "text": "大丈夫？"},
        { "location": "36/ACT"    , "narrator": "", "text": "助けてあげたい！"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "苦しいよ…！\n痛い痛い痛い…！"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "$handle$さん\n$handle$さん…！"},
        { "location": "42/SEL"    , "narrator": "", "text": "辛いんだね…"},
        { "location": "43/SEL"    , "narrator": "", "text": "苦しそう…"},
        { "location": "44/SEL"    , "narrator": "", "text": "どうにかしてあげたい"},
        { "location": "45/ACT"    , "narrator": "", "text": "辛いんだね…"},
        { "location": "46/ACT"    , "narrator": "", "text": "苦しそう…"},
        { "location": "47/ACT"    , "narrator": "", "text": "どうにかしてあげたい"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "痛い痛い痛い\nいたいいたい\n痛い痛い痛い…！"},
        { "location": "52/SEL"    , "narrator": "", "text": "つばめ…？"},
        { "location": "53/SEL"    , "narrator": "", "text": "ひょっとして気付いてない？"},
        { "location": "54/SEL"    , "narrator": "", "text": "おーい…"},
        { "location": "55/ACT"    , "narrator": "", "text": "つばめ…？"},
        { "location": "56/ACT"    , "narrator": "", "text": "ひょっとして気付いてない？"},
        { "location": "57/ACT"    , "narrator": "", "text": "おーい…"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "う…うぁ……。"},
        { "location": "62/SEL"    , "narrator": "", "text": "見てられないよ"},
        { "location": "63/SEL"    , "narrator": "", "text": "千羽鶴のせい？"},
        { "location": "64/SEL"    , "narrator": "", "text": "神楽が悪いのかな…"},
        { "location": "65/ACT"    , "narrator": "", "text": "見てられないよ"},
        { "location": "66/ACT"    , "narrator": "", "text": "千羽鶴のせい？"},
        { "location": "67/ACT"    , "narrator": "", "text": "神楽が悪いのかな…"},
        { "location": "95/TALK"   , "narrator": "千羽鶴", "text": "どう。\n思い出の場所に\n来た気分は。"},
        { "location": "96/TALK"   , "narrator": "神楽", "text": "……。"},
        { "location": "97/TALK"   , "narrator": "千羽鶴", "text": "前回のライブから\n４ヶ月。"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "あの時あなたは\n逢瀬つばめを破壊\nしようとした。"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "いえ、破壊せねば\nならなかった。"},
        { "location": "100/TALK"  , "narrator": "千羽鶴", "text": "エンタングルと\nＡＥＺ統一国家からそう\n指示を受けていたから。"},
        { "location": "101/TALK"  , "narrator": "千羽鶴", "text": "だけど失敗した。\n如月音羽の介入のため。"},
        { "location": "104/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "105/TALK"  , "narrator": "千羽鶴", "text": "如月音羽が\nなぜ発症したか。\nその理由はわかる？"},
        { "location": "107/TALK"  , "narrator": "神楽", "text": "……それは……。"},
        { "location": "108/TALK"  , "narrator": "千羽鶴", "text": "私が発症させたから。"},
        { "location": "110/TALK"  , "narrator": "神楽", "text": "！"},
        { "location": "111/TALK"  , "narrator": "神楽", "text": "そんな……。\nそれじゃ、今までの\nフェノメノンは全部――"},
        { "location": "112/TALK"  , "narrator": "千羽鶴", "text": "それはない。必要に応じて\n私にもできる……。\nただそれだけ。"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "あなたの知っている\n逢瀬つばめは\nもうすぐ消える。"},
        { "location": "114/TALK"  , "narrator": "千羽鶴", "text": "そして私が\n逢瀬つばめになる。"},
        { "location": "115/TALK"  , "narrator": "千羽鶴", "text": "貴方の雇い主が\n貴方に伝えた\nイメージ通りの――"},
        { "location": "116/TALK"  , "narrator": "千羽鶴", "text": "冷酷で非道、\n人の心を持たない\n本物の逢瀬つばめに。"},
        { "location": "117/TALK"  , "narrator": "神楽", "text": "…そんなの\nつばめさんじゃ…！"},
        { "location": "118/TALK"  , "narrator": "神楽", "text": "本物のつばめさんは\nばかでお人よしで\n危なっかしくて…！"},
        { "location": "120/TALK"  , "narrator": "千羽鶴", "text": "そんな逢瀬つばめは\n認められない。少なくとも\n“彼ら”にとってには。"},
        { "location": "121/TALK"  , "narrator": "千羽鶴", "text": "そしてあなたも\n認められないまま\nこの世を去ることになる。"},
        { "location": "123/TALK"  , "narrator": "千羽鶴", "text": "でもそれは仕方ない。"},
        { "location": "124/TALK"  , "narrator": "千羽鶴", "text": "エンタングル・統一国家に\n課された使命を、全う\nできなかったのだから。"},
        { "location": "125/TALK"  , "narrator": "千羽鶴", "text": "諦めて、一之宮神楽。"},
        { "location": "126/TALK"  , "narrator": "神楽", "text": "…その名前で呼ぶな！"},
        { "location": "127/TALK"  , "narrator": "千羽鶴", "text": "なぜ。\n一之宮はあなたの\n父親のはず。"},
        { "location": "128/TALK"  , "narrator": "神楽", "text": "父親なんかじゃない！\nただのサイコパスだ！\n私のパパを殺した！"},
        { "location": "129/TALK"  , "narrator": "神楽", "text": "…私の父親は\nパパだけよ…！"},
        { "location": "130/TALK"  , "narrator": "千羽鶴", "text": "ふうん。"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "まあいい。\nあなたには最後にひとつ\n協力してもらう。"},
        { "location": "133/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "134/TALK"  , "narrator": "神楽", "text": "ひとつだけ教えて。"},
        { "location": "135/TALK"  , "narrator": "千羽鶴", "text": "何を。"},
        { "location": "136/TALK"  , "narrator": "神楽", "text": "なぜ３ヶ月も待たせたの。"},
        { "location": "137/TALK"  , "narrator": "神楽", "text": "つばめさんを壊すのを\n３ヶ月も待たせたの。"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "理由はみっつ。"},
        { "location": "139/TALK"  , "narrator": "千羽鶴", "text": "ひとつめ。"},
        { "location": "140/TALK"  , "narrator": "千羽鶴", "text": "クランのエネルギーを\n規定量以上にする\n必要があった。"},
        { "location": "141/TALK"  , "narrator": "千羽鶴", "text": "ふたつめ。"},
        { "location": "142/TALK"  , "narrator": "千羽鶴", "text": "あなたが逢瀬つばめに\n好意を抱くための\n時間が必要だった。"},
        { "location": "143/TALK"  , "narrator": "千羽鶴", "text": "みっつめ。"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめのココロの中に\n私が戻るための準備をする\n時間が必要だった。"},
        { "location": "146/TALK"  , "narrator": "神楽", "text": "なん…！\nどうして…！"},
        { "location": "147/TALK"  , "narrator": "千羽鶴", "text": "回答は以上。"},
        { "location": "148/TALK"  , "narrator": "神楽", "text": "ちょ…！"},
        { "location": "196/TALK"  , "narrator": "神楽", "text": "　"},
        { "location": "219/TALK"  , "narrator": "神楽の司書", "text": "ぴょんぴょん♪"},
        { "location": "220/TALK"  , "narrator": "神楽の司書", "text": "こんにちは、\n$handle$さん！"},
        { "location": "221/SEL"   , "narrator": "", "text": "神楽にも司書がいたの！？"},
        { "location": "222/ACT"   , "narrator": "", "text": "神楽にも司書がいたの！？"},
        { "location": "224/TALK"  , "narrator": "神楽の司書", "text": "何を言ってるんですか、\n当たり前ですぴょん。"},
        { "location": "225/TALK"  , "narrator": "神楽の司書", "text": "トライガジェットを普通に\n使う以上、司書の常駐は\n避けられないぴょん。"},
        { "location": "226/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\n私は卯月神楽の司書、\nぴょんこです♪"},
        { "location": "227/TALK"  , "narrator": "ぴょんこ", "text": "末永く\nよろしくぴょん♪"},
        { "location": "228/SEL"   , "narrator": "", "text": "名前明かすの早っ！！"},
        { "location": "229/SEL"   , "narrator": "", "text": "ココロの司書がぴょんこってｗｗｗ"},
        { "location": "230/ACT"   , "narrator": "", "text": "名前明かすの早っ！！"},
        { "location": "231/TALK"  , "narrator": "ぴょんこ", "text": "別に明かしたところで\n何も問題はないぴょん♪"},
        { "location": "232/TALK"  , "narrator": "ぴょんこ", "text": "ちなみに、何故名前を\n明かさないか、理由は\nどこかで聞いてるぴょん？"},
        { "location": "233/SEL"   , "narrator": "", "text": "聞いたような…"},
        { "location": "234/SEL"   , "narrator": "", "text": "そういえば聞いてないような…"},
        { "location": "235/ACT"   , "narrator": "", "text": "聞いたような…"},
        { "location": "236/TALK"  , "narrator": "ぴょんこ", "text": "なら\nいいですぴょん。"},
        { "location": "237/ACT"   , "narrator": "", "text": "そういえば聞いてないような…"},
        { "location": "238/TALK"  , "narrator": "ぴょんこ", "text": "なるほど。"},
        { "location": "239/TALK"  , "narrator": "ぴょんこ", "text": "司書に限らず、\n人格は本名とアドレスが\n一意になってるぴょん。"},
        { "location": "240/TALK"  , "narrator": "ぴょんこ", "text": "要するに、名前から\n居場所の特定がカンタンに\nできてしまうということ。"},
        { "location": "241/TALK"  , "narrator": "ぴょんこ", "text": "そうすると、その\nアドレスの情報を\n書き換えることができ――"},
        { "location": "242/TALK"  , "narrator": "ぴょんこ", "text": "なんと、その人格の\n性質を変えてしまうことが\nできるのぴょん♪"},
        { "location": "243/TALK"  , "narrator": "ぴょんこ", "text": "さて、問題です♪\nそういうのを漢字二文字で\n何ていいますぴょん？"},
        { "location": "244/SEL"   , "narrator": "", "text": "洗脳"},
        { "location": "245/SEL"   , "narrator": "", "text": "貧乳"},
        { "location": "246/ACT"   , "narrator": "", "text": "洗脳"},
        { "location": "247/TALK"  , "narrator": "ぴょんこ", "text": "正解で～～す♪"},
        { "location": "248/TALK"  , "narrator": "ぴょんこ", "text": "それは些細な書換から\n大規模な書換まで、\nおおよそ何でもでき――"},
        { "location": "249/TALK"  , "narrator": "ぴょんこ", "text": "果ては、発症させたり\nするのも自由自在！"},
        { "location": "250/TALK"  , "narrator": "ぴょんこ", "text": "ですから人格は、\n自分の名前をみだりに\n人に言わないぴょん♪"},
        { "location": "251/SEL"   , "narrator": "", "text": "じゃあ$me$に名前を教えてるのは…（どきどき"},
        { "location": "252/ACT"   , "narrator": "", "text": "じゃあ$me$に名前を教えてるのは…（どきどき"},
        { "location": "254/TALK"  , "narrator": "ぴょんこ", "text": "そうです♪\nお察しの通り♪"},
        { "location": "255/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんが\n無能だとわかってるから\nですぴょん！！"},
        { "location": "256/SEL"   , "narrator": "", "text": "ｽﾞｺｰ"},
        { "location": "257/SEL"   , "narrator": "", "text": "一つになりたいくらい愛してるからじゃないの！？"},
        { "location": "259/TALK"  , "narrator": "ぴょんこ", "text": "あらら？"},
        { "location": "260/TALK"  , "narrator": "ぴょんこ", "text": "どんな理由だと\n思ってたぴょん？"},
        { "location": "261/ACT"   , "narrator": "", "text": "一つになりたいくらい愛してるからじゃないの！？"},
        { "location": "262/TALK"  , "narrator": "ぴょんこ", "text": "うわ、キモっ！！"},
        { "location": "263/TALK"  , "narrator": "ぴょんこ", "text": "こっち見んな！"},
        { "location": "264/TALK"  , "narrator": "ぴょんこ", "text": "なんで初対面の相手に\nそういう事平気で\nいえるかなー。"},
        { "location": "265/TALK"  , "narrator": "ぴょんこ", "text": "もっとコミュニケーション\nスキル上げた方がいいよ？"},
        { "location": "267/ACT"   , "narrator": "", "text": "貧乳"},
        { "location": "278/ACT"   , "narrator": "", "text": "ココロの司書がぴょんこってｗｗｗ"},
        { "location": "279/TALK"  , "narrator": "ぴょんこ", "text": "は？"},
        { "location": "280/TALK"  , "narrator": "ぴょんこ", "text": "人の名前に\nケチつけられるほど\n偉いのかよ。"},
        { "location": "281/TALK"  , "narrator": "ぴょんこ", "text": "ていうか、\n$handle$ｗｗｗ\nマジなのその名前？"},
        { "location": "282/SEL"   , "narrator": "", "text": "すみません…"},
        { "location": "283/SEL"   , "narrator": "", "text": "うっせーな"},
        { "location": "284/ACT"   , "narrator": "", "text": "すみません…"},
        { "location": "285/TALK"  , "narrator": "ぴょんこ", "text": "わかってくれれば\nいいのですぴょん♪"},
        { "location": "286/ACT"   , "narrator": "", "text": "うっせーな"},
        { "location": "287/TALK"  , "narrator": "ぴょんこ", "text": "開き直るな！"},
        { "location": "288/TALK"  , "narrator": "ぴょんこ", "text": "なんか$handle$と\n上手くやっていける自信が\nなくなってきたぴょん…。"},
        { "location": "289/TALK"  , "narrator": "ぴょんこ", "text": "まあでも、これも\n何かの試練だと思って\n諦めるぴょん。"},
        { "location": "292/TALK"  , "narrator": "ぴょんこ", "text": "…とまあ、そんな話は\nおいておいて！"},
        { "location": "293/TALK"  , "narrator": "ぴょんこ", "text": "今回はどんなご用で\n来たのだぴょん？"},
        { "location": "294/SEL"   , "narrator": "", "text": "心の葛藤がある筈なんだけど"},
        { "location": "295/ACT"   , "narrator": "", "text": "心の葛藤がある筈なんだけど"},
        { "location": "297/TALK"  , "narrator": "ぴょんこ", "text": "あー…、\nそりゃそうですね。"},
        { "location": "299/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ早速、\n扉を回してみるぴょん\nゴーゴー♪"},
        { "location": "304/TALK"  , "narrator": "ぴょんこ", "text": "オープンプロセス、\n0x860番地から\n0xB4E番地へ。"},
        { "location": "326/TALK"  , "narrator": "ぴょんこ", "text": "シーク完了だぴょん♪"},
        { "location": "328/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ早速、\nぴょんこが悩みを\n解決するぴょん♪"},
        { "location": "329/SEL"   , "narrator": "", "text": "するのは$me$ですが"},
        { "location": "330/ACT"   , "narrator": "", "text": "するのは$me$ですが"},
        { "location": "332/TALK"  , "narrator": "ぴょんこ", "text": "細けぇことは\nいいんだよ。"},
        { "location": "333/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "334/TALK"  , "narrator": "ぴょんこ", "text": "あー、なるほど。\nそういうことですか。"},
        { "location": "335/SEL"   , "narrator": "", "text": "なんかこの軽やかな流れは久し振りな気がするわー"},
        { "location": "336/ACT"   , "narrator": "", "text": "なんかこの軽やかな流れは久し振りな気がするわー"},
        { "location": "338/TALK"  , "narrator": "ぴょんこ", "text": "そうなんですねー。"},
        { "location": "339/TALK"  , "narrator": "ぴょんこ", "text": "確かに最近皆さん、\n怒濤の濁流に呑まれて\nいますもんね♪"},
        { "location": "340/SEL"   , "narrator": "", "text": "で、どんなだった？"},
        { "location": "341/ACT"   , "narrator": "", "text": "で、どんなだった？"},
        { "location": "343/TALK"  , "narrator": "ぴょんこ", "text": "あー、えっとですね。"},
        { "location": "344/TALK"  , "narrator": "ぴょんこ", "text": "千羽鶴に支配されることで\n自分が自分で無くなるなら\nいっそのこと死のうかと。"},
        { "location": "345/SEL"   , "narrator": "", "text": "重っ！！"},
        { "location": "346/ACT"   , "narrator": "", "text": "重っ！！"},
        { "location": "348/TALK"  , "narrator": "ぴょんこ", "text": "まあ、つばめさんにも\n迷惑かけちゃいますしね。"},
        { "location": "349/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\n総意は死を選んでますので\nそっちでお願いします♪"},
        { "location": "350/TALK"  , "narrator": "ぴょんこ", "text": "私に舌を噛み切る\n勇気を与えてくださいね♪"},
        { "location": "351/SEL"   , "narrator": "", "text": "ちょっとまてい！！"},
        { "location": "352/ACT"   , "narrator": "", "text": "ちょっとまてい！！"},
        { "location": "354/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "355/SEL"   , "narrator": "", "text": "ぴょん？じゃねーよ"},
        { "location": "356/SEL"   , "narrator": "", "text": "死んだら全て終わっちゃうでしょうが！"},
        { "location": "357/ACT"   , "narrator": "", "text": "ぴょん？じゃねーよ"},
        { "location": "358/TALK"  , "narrator": "ぴょんこ", "text": "じゃあ……"},
        { "location": "359/TALK"  , "narrator": "ぴょんこ", "text": "…にゃん？"},
        { "location": "360/SEL"   , "narrator": "", "text": "先生とっても可愛いです！！"},
        { "location": "361/SEL"   , "narrator": "", "text": "いやそうじゃなくて！！"},
        { "location": "362/ACT"   , "narrator": "", "text": "先生とっても可愛いです！！"},
        { "location": "363/TALK"  , "narrator": "ぴょんこ", "text": "でも、にゃんが語尾だと、\n「ぴょんこ」じゃなくて、\n「にゃんこ」です…。"},
        { "location": "364/TALK"  , "narrator": "ぴょんこ", "text": "そんなの、\n没個性過ぎますっ！"},
        { "location": "365/SEL"   , "narrator": "", "text": "いや、それはもういいから"},
        { "location": "366/ACT"   , "narrator": "", "text": "いや、それはもういいから"},
        { "location": "368/TALK"  , "narrator": "ぴょんこ", "text": "はぁ！？\n$handle$が\n振ってきたんじゃん！"},
        { "location": "369/TALK"  , "narrator": "ぴょんこ", "text": "まあいいけど。"},
        { "location": "370/TALK"  , "narrator": "ぴょんこ", "text": "第一です。\nぴょんこは所詮\nタダの司書なんです。"},
        { "location": "371/TALK"  , "narrator": "ぴょんこ", "text": "結果に従う他\n無いんですよ。"},
        { "location": "372/ACT"   , "narrator": "", "text": "いやそうじゃなくて！！"},
        { "location": "373/TALK"  , "narrator": "ぴょんこ", "text": "とはいいましても、\n総意が望むことを実現する\nのが司書の役目ですし。"},
        { "location": "375/ACT"   , "narrator": "", "text": "死んだら全て終わっちゃうでしょうが！"},
        { "location": "376/TALK"  , "narrator": "ぴょんこ", "text": "焦らないで、\n私の可愛い\n異世界のお友達。"},
        { "location": "377/TALK"  , "narrator": "ぴょんこ", "text": "死は終焉ではありません。\nむしろ始まりなのです。"},
        { "location": "378/TALK"  , "narrator": "ぴょんこ", "text": "恐れないで、\n貴方の全てを委ねて……"},
        { "location": "379/SEL"   , "narrator": "", "text": "なんか怪しい上に全然救われてないんですが"},
        { "location": "380/ACT"   , "narrator": "", "text": "なんか怪しい上に全然救われてないんですが"},
        { "location": "382/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？\nそんなことはないと\n思うんですけど？"},
        { "location": "383/TALK"  , "narrator": "ぴょんこ", "text": "まあこの感覚は、\n$handle$さんには\n理解しがたいでしょうね。"},
        { "location": "384/TALK"  , "narrator": "ぴょんこ", "text": "ともあれ、\nぴょんこは所詮\nタダの司書。"},
        { "location": "385/TALK"  , "narrator": "ぴょんこ", "text": "どう足掻いても\n結局は結果に従う他\n無いんですよ。"},
        { "location": "387/TALK"  , "narrator": "ぴょんこ", "text": "それに、ぴょんこは\nいつだってひとりぼっち\nですから。"},
        { "location": "388/TALK"  , "narrator": "ぴょんこ", "text": "だから、\n己の選択こそが\n正義なんです♪"},
        { "location": "389/TALK"  , "narrator": "ぴょんこ", "text": "今までずっと、\nそうやって\n生きてきましたし。"},
        { "location": "390/TALK"  , "narrator": "ぴょんこ", "text": "自身の総意が\n決定する選択以上に\n正しいものはありません。"},
        { "location": "391/SEL"   , "narrator": "", "text": "これからは$me$が一緒にいるから"},
        { "location": "392/SEL"   , "narrator": "", "text": "$me$はその上を行く存在だから言うことを聞け"},
        { "location": "393/SEL"   , "narrator": "", "text": "それじゃ仕方ないね"},
        { "location": "394/ACT"   , "narrator": "", "text": "これからは$me$が一緒にいるから"},
        { "location": "396/TALK"  , "narrator": "ぴょんこ", "text": "出来もしないことを\n軽々しく言わないで\nくださいね♪"},
        { "location": "397/TALK"  , "narrator": "ぴょんこ", "text": "だいたい、\n貴方如きに\n何ができるぴょん。"},
        { "location": "398/ACT"   , "narrator": "", "text": "$me$はその上を行く存在だから言うことを聞け"},
        { "location": "399/TALK"  , "narrator": "ぴょんこ", "text": "偉そうに。\n貴方に何が出来るって\nいうのですぴょん？"},
        { "location": "400/ACT"   , "narrator": "", "text": "それじゃ仕方ないね"},
        { "location": "402/TALK"  , "narrator": "ぴょんこ", "text": "ですですっ♪"},
        { "location": "403/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\nクランをぶっ倒してきて\nくださいね♪"},
        { "location": "406/SEL"   , "narrator": "", "text": "チャンネルが出来たらずっと傍にいるから"},
        { "location": "407/SEL"   , "narrator": "", "text": "胸を大きくしてあげられる"},
        { "location": "408/ACT"   , "narrator": "", "text": "チャンネルが出来たらずっと傍にいるから"},
        { "location": "409/TALK"  , "narrator": "ぴょんこ", "text": "チャンネルなんて\nできませんよ。"},
        { "location": "410/TALK"  , "narrator": "ぴょんこ", "text": "だいたい、\n出来たところで\n何もできませんし。"},
        { "location": "411/TALK"  , "narrator": "ぴょんこ", "text": "チャンネルが出来れば\n歴史を変えられるなんて\n思わないでくださいね？"},
        { "location": "412/TALK"  , "narrator": "ぴょんこ", "text": "あれは、ごく一部の\n限られた存在だけに\n与えられた特権ですから。"},
        { "location": "413/SEL"   , "narrator": "", "text": "それでも、神楽を支えたい"},
        { "location": "414/SEL"   , "narrator": "", "text": "それじゃ仕方ないか"},
        { "location": "415/ACT"   , "narrator": "", "text": "それでも、神楽を支えたい"},
        { "location": "417/TALK"  , "narrator": "ぴょんこ", "text": "はあぁ……。"},
        { "location": "418/TALK"  , "narrator": "ぴょんこ", "text": "聞き分けのない\n人なんですね。\n$handle$って。"},
        { "location": "420/TALK"  , "narrator": "ぴょんこ", "text": "そんなに言われたら、\n無理だと解っていても\n期待してしまいます。"},
        { "location": "421/TALK"  , "narrator": "ぴょんこ", "text": "$handle$は\nぴょんこを苦しめている\n自覚を持ってください。"},
        { "location": "422/TALK"  , "narrator": "ぴょんこ", "text": "そこまで言ったからには\n必ずチャンネルを開始して\nアクセスしてくださいね。"},
        { "location": "423/TALK"  , "narrator": "ぴょんこ", "text": "嘘ついたら\n呪いますからね？\nいいですか？"},
        { "location": "424/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "425/SEL"   , "narrator": "", "text": "やっぱナシ"},
        { "location": "426/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "429/TALK"  , "narrator": "ぴょんこ", "text": "わかりましたぴょん。"},
        { "location": "430/TALK"  , "narrator": "ぴょんこ", "text": "それでは、今回は\n総意に内緒で\n方針を変えちゃいます♪"},
        { "location": "431/TALK"  , "narrator": "ぴょんこ", "text": "でも、本当に\n来てくださいね？"},
        { "location": "432/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこはずっと\n待ってますから。"},
        { "location": "434/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ再び、\n扉を回してゴーゴー♪"},
        { "location": "439/TALK"  , "narrator": "ぴょんこ", "text": "オープンプロセス、\n0xB4E番地から\n0xCEF番地へ。"},
        { "location": "461/TALK"  , "narrator": "ぴょんこ", "text": "シーク完了だぴょん♪"},
        { "location": "462/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、\nあとはよろしくぴょん。"},
        { "location": "463/TALK"  , "narrator": "ぴょんこ", "text": "卯月神楽と\n$handle$に\n素敵なココロの旅を！"},
        { "location": "475/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "476/TALK"  , "narrator": "ぴょんこ", "text": "本当に、\n楽しみにしてますね。"},
        { "location": "477/TALK"  , "narrator": "ぴょんこ", "text": "早く…来て……\n$handle$…。"},
        { "location": "480/ACT"   , "narrator": "", "text": "やっぱナシ"},
        { "location": "482/ACT"   , "narrator": "", "text": "それじゃ仕方ないか"},
        { "location": "485/TALK"  , "narrator": "ぴょんこ", "text": "ですですっ♪"},
        { "location": "486/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\nクランをぶっ倒してきて\nくださいね♪"},
        { "location": "487/ACT"   , "narrator": "", "text": "胸を大きくしてあげられる"},
        { "location": "489/TALK"  , "narrator": "ぴょんこ", "text": "んなこと\n望んでねーから！！"},
        { "location": "499/TALK"  , "narrator": "ぴょんこ", "text": "卯月神楽と\n$handle$に\n素敵なココロの旅を！"},
        { "location": "25/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月11日　 6:10 PM</color>\n文京ドーム突入時のこと"},
        { "location": "94/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月11日　 5:03 PM</color>\n記録映像より１時間ほど前、文京ドームにて。"},
        { "location": "161/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "163/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "165/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "167/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "169/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
