        { "location": "1129/TALK"  , "narrator": "つばめ", "text": "やっぱり無理！"},
        { "location": "1130/TALK"  , "narrator": "つばめ", "text": "無理だから！"},
        { "location": "1131/TALK"  , "narrator": "つばめ", "text": "ごめんなさい！"},
        { "location": "1133/TALK"  , "narrator": "つばめ", "text": "本当にごめんなさい！"},
        { "location": "1134/SEL"   , "narrator": "", "text": "え…そう…"},
