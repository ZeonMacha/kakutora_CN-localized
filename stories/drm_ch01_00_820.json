        { "location": "1208/TALK"  , "narrator": "透明つばめ", "text": "本当だね。"},
        { "location": "1209/ACT"   , "narrator": "", "text": "のんびりするのもいいよね"},
        { "location": "1210/TALK"  , "narrator": "透明つばめ", "text": "のんびり、か…。"},
        { "location": "1213/TALK"  , "narrator": "透明つばめ", "text": "$handle$さんは\nこうやってて\n幸せなのかな？"},
        { "location": "1214/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "1215/SEL"   , "narrator": "", "text": "わざわざ聞くの？"},
