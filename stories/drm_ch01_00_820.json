        { "location": "1137/ACT"   , "narrator": "", "text": "え…そう…"},
        { "location": "1138/TALK"  , "narrator": "つばめ", "text": "う、うん…。"},
        { "location": "1139/ACT"   , "narrator": "", "text": "じゃあ今度ね"},
        { "location": "1140/TALK"  , "narrator": "つばめ", "text": "え…と…。"},
        { "location": "1141/ACT"   , "narrator": "", "text": "期待しちゃった…"},
        { "location": "1142/TALK"  , "narrator": "つばめ", "text": "ごめんなさい！"},
        { "location": "1145/TALK"  , "narrator": "つばめ", "text": "景色もいいしって\n思ったんだけど\nやっぱり無理です。"},
        { "location": "1146/TALK"  , "narrator": "つばめ", "text": "言い出しておいて\nごめんね…？"},
        { "location": "1147/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "1148/SEL"   , "narrator": "", "text": "仕方ないなー"},
        { "location": "1149/SEL"   , "narrator": "", "text": "残念だけど"},
        { "location": "1150/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "1151/TALK"  , "narrator": "つばめ", "text": "ごめんね？"},
