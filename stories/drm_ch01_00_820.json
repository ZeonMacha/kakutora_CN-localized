        { "location": "1155/TALK"  , "narrator": "つばめ", "text": "そ、そうなの…？"},
        { "location": "1157/TALK"  , "narrator": "つばめ", "text": "変なこと言って\nごめんね？"},
        { "location": "1159/TALK"  , "narrator": "つばめ", "text": "びっくりしたよね？"},
