        { "location": "1217/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "1218/TALK"  , "narrator": "透明つばめ", "text": "…そっか。"},
        { "location": "1219/ACT"   , "narrator": "", "text": "わざわざ聞くの？"},
