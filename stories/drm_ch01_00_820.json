{
    "dir": "dramatics/daydra/drm_ch01_00_820.js",
    "type": "Episode",
    "info": {
        "story_id": "1082",
        "cid": "tsubame",
        "title": "らぶとーく 第83話",
        "sub_title": "世界中を花束にして"
    },
    "entry":
    [
        { "location": "770/TALK"   , "narrator": "つばめ", "text": "あー。\n肩凝っちゃったね。"},
        { "location": "771/TALK"   , "narrator": "つばめ", "text": "$handle$さんは\n疲れてない？\n大丈夫？"},
        { "location": "772/SEL"    , "narrator": "", "text": "平気だよ"},
        { "location": "773/SEL"    , "narrator": "", "text": "気疲れした…"},
        { "location": "774/SEL"    , "narrator": "", "text": "つばめの方が\n大変だったよね"},
        { "location": "775/ACT"    , "narrator": "", "text": "平気だよ"},
        { "location": "776/TALK"   , "narrator": "つばめ", "text": "だったら\nいいんだけど…。"},
        { "location": "777/ACT"    , "narrator": "", "text": "気疲れした…"},
        { "location": "778/TALK"   , "narrator": "つばめ", "text": "そうだよね。\nおつかれさま！"},
        { "location": "779/ACT"    , "narrator": "", "text": "つばめの方が\n大変だったよね"},
        { "location": "780/TALK"   , "narrator": "つばめ", "text": "え？\nそんなことないよ。"},
        { "location": "782/TALK"   , "narrator": "つばめ", "text": "でもね。\n天気もよかったし、\nお父さんも来てくれたし。"},
        { "location": "784/TALK"   , "narrator": "つばめ", "text": "わたしはすごく\n幸せだったな……。"},
        { "location": "785/SEL"    , "narrator": "", "text": "ならいいんだけど"},
        { "location": "786/SEL"    , "narrator": "", "text": "なんか、うん…"},
        { "location": "787/ACT"    , "narrator": "", "text": "ならいいんだけど"},
        { "location": "788/TALK"   , "narrator": "つばめ", "text": "$handle$さんは\n違うのかな？"},
        { "location": "789/ACT"    , "narrator": "", "text": "なんか、うん…"},
        { "location": "790/TALK"   , "narrator": "つばめ", "text": "あれ？\n元気ないね。"},
        { "location": "792/TALK"   , "narrator": "つばめ", "text": "……でも\nちょっとだけね。"},
        { "location": "793/TALK"   , "narrator": "つばめ", "text": "二人きりの方が\nいいかもって\n思ったりもしたよ。"},
        { "location": "794/SEL"    , "narrator": "", "text": "だよね！！！"},
        { "location": "795/SEL"    , "narrator": "", "text": "その言葉が\n聞きたかった"},
        { "location": "796/SEL"    , "narrator": "", "text": "親孝行はするべき"},
        { "location": "797/ACT"    , "narrator": "", "text": "だよね！！！"},
        { "location": "798/TALK"   , "narrator": "つばめ", "text": "そうだったんだ…。"},
        { "location": "799/ACT"    , "narrator": "", "text": "その言葉が\n聞きたかった"},
        { "location": "800/TALK"   , "narrator": "つばめ", "text": "あれ！？"},
        { "location": "801/ACT"    , "narrator": "", "text": "親孝行はするべき"},
        { "location": "802/TALK"   , "narrator": "つばめ", "text": "親孝行できたかな？\nだったらいいな。"},
        { "location": "804/TALK"   , "narrator": "つばめ", "text": "今も二人きりだけど。"},
        { "location": "805/TALK"   , "narrator": "つばめ", "text": "なんかこういうのじゃ\nなくて……。"},
        { "location": "806/SEL"    , "narrator": "", "text": "旅行でも行こうか"},
        { "location": "807/SEL"    , "narrator": "", "text": "ハネムーンしようよ"},
        { "location": "808/SEL"    , "narrator": "", "text": "愛の逃避行に出よう"},
        { "location": "809/ACT"    , "narrator": "", "text": "旅行でも行こうか"},
        { "location": "810/TALK"   , "narrator": "つばめ", "text": "あっ！\n行ってみたい！"},
        { "location": "811/ACT"    , "narrator": "", "text": "ハネムーンしようよ"},
        { "location": "812/TALK"   , "narrator": "つばめ", "text": "ハネムーン……。"},
        { "location": "813/TALK"   , "narrator": "つばめ", "text": "ちょっと照れちゃうね。"},
        { "location": "814/ACT"    , "narrator": "", "text": "愛の逃避行に出よう"},
        { "location": "815/TALK"   , "narrator": "つばめ", "text": "逃避行って\n格好いいね。"},
        { "location": "816/TALK"   , "narrator": "つばめ", "text": "でも別に反対とか\nされなかったし……。"},
        { "location": "818/TALK"   , "narrator": "つばめ", "text": "ちょっと\nその言い方は違うかも。"},
        { "location": "820/TALK"   , "narrator": "つばめ", "text": "どこかに出かけるの\nいいね。"},
        { "location": "821/TALK"   , "narrator": "つばめ", "text": "$handle$さんは\nどこに行きたい？"},
        { "location": "822/SEL"    , "narrator": "", "text": "つばめの行きたいとこ"},
        { "location": "823/SEL"    , "narrator": "", "text": "どこでもいいよ"},
        { "location": "824/SEL"    , "narrator": "", "text": "目的は二人きりに\nなれることだから"},
        { "location": "825/ACT"    , "narrator": "", "text": "つばめの行きたいとこ"},
        { "location": "826/TALK"   , "narrator": "つばめ", "text": "わたしのでいいの？"},
        { "location": "827/ACT"    , "narrator": "", "text": "どこでもいいよ"},
        { "location": "828/TALK"   , "narrator": "つばめ", "text": "そう言われると\n困っちゃうな。"},
        { "location": "829/ACT"    , "narrator": "", "text": "目的は二人きりに\nなれることだから"},
        { "location": "830/TALK"   , "narrator": "つばめ", "text": "え。\n照れるよー！？"},
        { "location": "832/TALK"   , "narrator": "つばめ", "text": "んーとね……。"},
        { "location": "833/TALK"   , "narrator": "つばめ", "text": "お花畑とか\n行ってみたいかも。"},
        { "location": "834/SEL"    , "narrator": "", "text": "花粉症とかないの？"},
        { "location": "835/SEL"    , "narrator": "", "text": "意外と少女趣味だね"},
        { "location": "836/SEL"    , "narrator": "", "text": "つばめに似合うよ"},
        { "location": "837/ACT"    , "narrator": "", "text": "花粉症とかないの？"},
        { "location": "838/TALK"   , "narrator": "つばめ", "text": "え……\nないかな……。"},
        { "location": "839/ACT"    , "narrator": "", "text": "意外と少女趣味だね"},
        { "location": "840/TALK"   , "narrator": "つばめ", "text": "意外とってひどい！"},
        { "location": "841/ACT"    , "narrator": "", "text": "つばめに似合うよ"},
        { "location": "842/TALK"   , "narrator": "つばめ", "text": "えへ。\nありがとう。"},
        { "location": "844/TALK"   , "narrator": "つばめ", "text": "お花畑って\nどんなイメージ？"},
        { "location": "845/SEL"    , "narrator": "", "text": "ヒマワリ畑とか？"},
        { "location": "846/SEL"    , "narrator": "", "text": "いちめんのなのはな"},
        { "location": "847/SEL"    , "narrator": "", "text": "レンゲソウとか"},
        { "location": "849/SEL"    , "narrator": "", "text": "うふふあははって感じ"},
        { "location": "850/SEL"    , "narrator": "", "text": "思いつかないなー"},
        { "location": "851/ACT"    , "narrator": "", "text": "ヒマワリ畑とか？"},
        { "location": "853/TALK"   , "narrator": "つばめ", "text": "映画みたいだね。"},
        { "location": "854/ACT"    , "narrator": "", "text": "いちめんのなのはな"},
        { "location": "855/TALK"   , "narrator": "つばめ", "text": "それ知ってる！"},
        { "location": "857/TALK"   , "narrator": "つばめ", "text": "何か国語の\n教科書に載ってた。"},
        { "location": "858/ACT"    , "narrator": "", "text": "レンゲソウとか"},
        { "location": "859/TALK"   , "narrator": "つばめ", "text": "小さい頃\n見たことあるよ。"},
        { "location": "863/ACT"    , "narrator": "", "text": "うふふあははって感じ"},
        { "location": "864/TALK"   , "narrator": "つばめ", "text": "…わかるような…。"},
        { "location": "865/TALK"   , "narrator": "つばめ", "text": "…わからないような…。"},
        { "location": "866/ACT"    , "narrator": "", "text": "思いつかないなー"},
        { "location": "867/TALK"   , "narrator": "つばめ", "text": "そっか…。"},
        { "location": "868/TALK"   , "narrator": "つばめ", "text": "ちょっとだけ残念。"},
        { "location": "870/TALK"   , "narrator": "つばめ", "text": "…実はね。\n行ってみたいところが\nあるんだ。"},
        { "location": "871/TALK"   , "narrator": "つばめ", "text": "前にニュースで見た\nコスモス畑。"},
        { "location": "872/SEL"    , "narrator": "", "text": "じゃあそこに行こう"},
        { "location": "873/SEL"    , "narrator": "", "text": "最初に言えばいいのにー"},
        { "location": "874/SEL"    , "narrator": "", "text": "楽しみだ"},
        { "location": "875/ACT"    , "narrator": "", "text": "じゃあそこに行こう"},
        { "location": "876/TALK"   , "narrator": "つばめ", "text": "それでいい？"},
        { "location": "877/ACT"    , "narrator": "", "text": "最初に言えばいいのにー"},
        { "location": "878/TALK"   , "narrator": "つばめ", "text": "$handle$さんが\n行きたいところに\n行きたいなって…。"},
        { "location": "879/ACT"    , "narrator": "", "text": "楽しみだ"},
        { "location": "880/TALK"   , "narrator": "つばめ", "text": "うん！\nわたしも！"},
        { "location": "882/TALK"   , "narrator": "つばめ", "text": "今の時期だったら\nちょうど満開だし。"},
        { "location": "895/TALK"   , "narrator": "つばめ", "text": "いい天気…。"},
        { "location": "896/TALK"   , "narrator": "つばめ", "text": "それに景色も\n変わってきたね。"},
        { "location": "898/TALK"   , "narrator": "つばめ", "text": "$handle$さん\n窓の外見える？"},
        { "location": "899/SEL"    , "narrator": "", "text": "見えるよ"},
        { "location": "900/SEL"    , "narrator": "", "text": "あんまり…"},
        { "location": "901/SEL"    , "narrator": "", "text": "つばめしか目に入らない"},
        { "location": "902/ACT"    , "narrator": "", "text": "見えるよ"},
        { "location": "903/TALK"   , "narrator": "つばめ", "text": "山が見えるよね。"},
        { "location": "904/ACT"    , "narrator": "", "text": "あんまり…"},
        { "location": "906/TALK"   , "narrator": "つばめ", "text": "そっか…。\n山が見えてきたよ。"},
        { "location": "907/ACT"    , "narrator": "", "text": "つばめしか目に入らない"},
        { "location": "908/TALK"   , "narrator": "つばめ", "text": "もう！"},
        { "location": "910/TALK"   , "narrator": "つばめ", "text": "でも\nありがと…。"},
        { "location": "914/TALK"   , "narrator": "つばめ", "text": "この山を越えたら\nコスモス畑だよ。"},
        { "location": "915/TALK"   , "narrator": "つばめ", "text": "一面のコスモスの花って\nすごいよね。"},
        { "location": "916/SEL"    , "narrator": "", "text": "そうだね"},
        { "location": "917/SEL"    , "narrator": "", "text": "どうかなー"},
        { "location": "918/SEL"    , "narrator": "", "text": "その先の洞窟に…"},
        { "location": "919/ACT"    , "narrator": "", "text": "そうだね"},
        { "location": "920/TALK"   , "narrator": "つばめ", "text": "楽しみ！"},
        { "location": "921/ACT"    , "narrator": "", "text": "どうかなー"},
        { "location": "922/TALK"   , "narrator": "つばめ", "text": "あれ？\nそんなことない？"},
        { "location": "923/ACT"    , "narrator": "", "text": "その先の洞窟に…"},
        { "location": "925/TALK"   , "narrator": "つばめ", "text": "え……。\n怖い話とかしないで？"},
        { "location": "927/TALK"   , "narrator": "つばめ", "text": "……ねえ。"},
        { "location": "928/TALK"   , "narrator": "つばめ", "text": "$handle$さんは\n誰かに話した？"},
        { "location": "929/SEL"    , "narrator": "", "text": "何を？"},
        { "location": "930/ACT"    , "narrator": "", "text": "何を？"},
        { "location": "932/TALK"   , "narrator": "つばめ", "text": "結婚のこと。"},
        { "location": "933/SEL"    , "narrator": "", "text": "話した"},
        { "location": "934/SEL"    , "narrator": "", "text": "話してない"},
        { "location": "935/SEL"    , "narrator": "", "text": "秘密"},
        { "location": "936/ACT"    , "narrator": "", "text": "話した"},
        { "location": "937/TALK"   , "narrator": "つばめ", "text": "え？\n誰に？"},
        { "location": "938/SEL"    , "narrator": "", "text": "友達"},
        { "location": "939/SEL"    , "narrator": "", "text": "それは言えない"},
        { "location": "940/SEL"    , "narrator": "", "text": "身内"},
        { "location": "941/ACT"    , "narrator": "", "text": "友達"},
        { "location": "942/TALK"   , "narrator": "つばめ", "text": "お友達に？"},
        { "location": "943/ACT"    , "narrator": "", "text": "それは言えない"},
        { "location": "944/TALK"   , "narrator": "つばめ", "text": "…そっか…。"},
        { "location": "945/ACT"    , "narrator": "", "text": "身内"},
        { "location": "946/TALK"   , "narrator": "つばめ", "text": "お父さんとか\n兄弟ってこと？"},
        { "location": "948/ACT"    , "narrator": "", "text": "話してない"},
        { "location": "951/TALK"   , "narrator": "つばめ", "text": "やっぱり\nそうだよね…。"},
        { "location": "952/ACT"    , "narrator": "", "text": "秘密"},
        { "location": "953/TALK"   , "narrator": "つばめ", "text": "…そうなの…？"},
        { "location": "954/SEL"    , "narrator": "", "text": "秘密があれば愛は継続する"},
        { "location": "955/SEL"    , "narrator": "", "text": "恥ずかしいから…"},
        { "location": "956/ACT"    , "narrator": "", "text": "秘密があれば愛は継続する"},
        { "location": "959/TALK"   , "narrator": "つばめ", "text": "なんか\n大人の意見だね。"},
        { "location": "960/ACT"    , "narrator": "", "text": "恥ずかしいから…"},
        { "location": "961/TALK"   , "narrator": "つばめ", "text": "そ、そうなの？\nじゃあしょうがないね。"},
        { "location": "966/TALK"   , "narrator": "つばめ", "text": "…あのね。"},
        { "location": "967/TALK"   , "narrator": "つばめ", "text": "お父さんは式に\n来てくれたけど。"},
        { "location": "968/TALK"   , "narrator": "つばめ", "text": "本当はどう\n思ってたのかなって。"},
        { "location": "969/SEL"    , "narrator": "", "text": "本人にしかわからないよ"},
        { "location": "970/SEL"    , "narrator": "", "text": "大事なのは$me$と\nつばめの気持ちでしょ"},
        { "location": "971/SEL"    , "narrator": "", "text": "来てくれたんだから\nそれで十分だと思う"},
        { "location": "972/ACT"    , "narrator": "", "text": "本人にしかわからないよ"},
        { "location": "974/TALK"   , "narrator": "つばめ", "text": "…そう、だね。"},
        { "location": "975/ACT"    , "narrator": "", "text": "大事なのは$me$と\nつばめの気持ちでしょ"},
        { "location": "976/TALK"   , "narrator": "つばめ", "text": "わたしと\n$handle$さんの\n気持ち…。"},
        { "location": "977/ACT"    , "narrator": "", "text": "来てくれたんだから\nそれで十分だと思う"},
        { "location": "978/TALK"   , "narrator": "つばめ", "text": "…うん…。"},
        { "location": "980/SEL"    , "narrator": "", "text": "不安かな？"},
        { "location": "981/SEL"    , "narrator": "", "text": "大事にするから"},
        { "location": "982/SEL"    , "narrator": "", "text": "わかってくれるよ"},
        { "location": "983/ACT"    , "narrator": "", "text": "不安かな？"},
        { "location": "985/TALK"   , "narrator": "つばめ", "text": "…不安っていうか…。"},
        { "location": "986/ACT"    , "narrator": "", "text": "大事にするから"},
        { "location": "988/TALK"   , "narrator": "つばめ", "text": "…ありがとう…。"},
        { "location": "989/ACT"    , "narrator": "", "text": "わかってくれるよ"},
        { "location": "991/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "994/TALK"   , "narrator": "つばめ", "text": "…ごめんね。"},
        { "location": "996/TALK"   , "narrator": "つばめ", "text": "せっかくの\nハネムーンなのに\n変なこと言って。"},
        { "location": "997/SEL"    , "narrator": "", "text": "気持ちはわかる"},
        { "location": "998/SEL"    , "narrator": "", "text": "この先は楽しい話をしよう"},
        { "location": "999/SEL"    , "narrator": "", "text": "何でも言って欲しい"},
        { "location": "1000/ACT"   , "narrator": "", "text": "気持ちはわかる"},
        { "location": "1002/TALK"  , "narrator": "つばめ", "text": "……。\n$handle$さんは\n優しいね…。"},
        { "location": "1003/ACT"   , "narrator": "", "text": "この先は楽しい話をしよう"},
        { "location": "1005/TALK"  , "narrator": "つばめ", "text": "うん。\nそうだね。"},
        { "location": "1006/ACT"   , "narrator": "", "text": "何でも言って欲しい"},
        { "location": "1008/TALK"  , "narrator": "つばめ", "text": "……。\nありがとう…。"},
        { "location": "1010/TALK"  , "narrator": "つばめ", "text": "あ！"},
        { "location": "1012/TALK"  , "narrator": "つばめ", "text": "駅に着いたよ！"},
        { "location": "1027/TALK"  , "narrator": "つばめ", "text": "テレビで見るより\n全然すごい……！"},
        { "location": "1028/TALK"  , "narrator": "つばめ", "text": "一面のコスモス…。"},
        { "location": "1029/TALK"  , "narrator": "つばめ", "text": "$handle$さん！"},
        { "location": "1030/SEL"   , "narrator": "", "text": "何？"},
        { "location": "1031/SEL"   , "narrator": "", "text": "そんな大声出さなくても"},
        { "location": "1032/ACT"   , "narrator": "", "text": "何？"},
        { "location": "1033/TALK"  , "narrator": "つばめ", "text": "えっとね…。"},
        { "location": "1034/ACT"   , "narrator": "", "text": "そんな大声出さなくても"},
        { "location": "1036/TALK"  , "narrator": "つばめ", "text": "あ\nそうだね。"},
        { "location": "1038/TALK"  , "narrator": "つばめ", "text": "えっと……。"},
        { "location": "1039/TALK"  , "narrator": "つばめ", "text": "どうしようかな…。"},
        { "location": "1040/SEL"   , "narrator": "", "text": "思いきって言ってみて"},
        { "location": "1041/SEL"   , "narrator": "", "text": "迷うならやめとけば"},
        { "location": "1042/SEL"   , "narrator": "", "text": "決心がついたら言って"},
        { "location": "1043/ACT"   , "narrator": "", "text": "思いきって言ってみて"},
        { "location": "1045/TALK"  , "narrator": "つばめ", "text": "えっと……。\nびっくりしないでね。"},
        { "location": "1046/ACT"   , "narrator": "", "text": "迷うならやめとけば"},
        { "location": "1048/TALK"  , "narrator": "つばめ", "text": "それはそれで\nちょっと…。"},
        { "location": "1049/ACT"   , "narrator": "", "text": "決心がついたら言って"},
        { "location": "1051/TALK"  , "narrator": "つばめ", "text": "う、うん…。"},
        { "location": "1053/TALK"  , "narrator": "つばめ", "text": "その……。"},
        { "location": "1054/TALK"  , "narrator": "つばめ", "text": "そのね……。"},
        { "location": "1055/SEL"   , "narrator": "", "text": "どうしたの"},
        { "location": "1056/SEL"   , "narrator": "", "text": "珍しいね"},
        { "location": "1057/SEL"   , "narrator": "", "text": "トイレかな？"},
        { "location": "1058/ACT"   , "narrator": "", "text": "どうしたの"},
        { "location": "1059/TALK"  , "narrator": "つばめ", "text": "えっと……。"},
        { "location": "1060/ACT"   , "narrator": "", "text": "珍しいね"},
        { "location": "1061/TALK"  , "narrator": "つばめ", "text": "そうかな……。"},
        { "location": "1062/ACT"   , "narrator": "", "text": "トイレかな？"},
        { "location": "1064/TALK"  , "narrator": "つばめ", "text": "違うよ！？\n違うからね！？"},
        { "location": "1066/TALK"  , "narrator": "つばめ", "text": "その、ね…。"},
        { "location": "1067/TALK"  , "narrator": "つばめ", "text": "わたしたち\n結婚したんだよね。"},
        { "location": "1068/TALK"  , "narrator": "つばめ", "text": "お父さんも\n来てくれたし。"},
        { "location": "1069/TALK"  , "narrator": "つばめ", "text": "でもちょっとだけ\n言えなかった\nことがあって。"},
        { "location": "1070/TALK"  , "narrator": "つばめ", "text": "えっとね…。"},
        { "location": "1071/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nキスしたい\nかなって…。"},
        { "location": "1072/SEL"   , "narrator": "", "text": "えっ"},
