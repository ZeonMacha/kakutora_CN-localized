        { "location": "1267/TALK"  , "narrator": "つばめ", "text": "やっぱり\n自分の部屋は\n落ち着くね。"},
        { "location": "1269/SEL"   , "narrator": "", "text": "話していい？"},
        { "location": "1270/ACT"   , "narrator": "", "text": "話していい？"},
