        { "location": "1180/TALK"  , "narrator": "つばめ", "text": "何話していいか\nわからなく\nなっちゃった…。"},
        { "location": "1181/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "1190/SEL"   , "narrator": "", "text": "おーい"},
