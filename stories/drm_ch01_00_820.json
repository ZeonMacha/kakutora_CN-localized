        { "location": "1074/SEL"   , "narrator": "", "text": "はい喜んで！！！"},
        { "location": "1075/ACT"   , "narrator": "", "text": "えっ"},
        { "location": "1076/TALK"  , "narrator": "つばめ", "text": "あっ！"},
        { "location": "1077/ACT"   , "narrator": "", "text": "つばめ！？"},
        { "location": "1078/TALK"  , "narrator": "つばめ", "text": "はい…。"},
        { "location": "1079/ACT"   , "narrator": "", "text": "はい喜んで！！！"},
        { "location": "1080/TALK"  , "narrator": "つばめ", "text": "えっえっ！？"},
        { "location": "1082/TALK"  , "narrator": "つばめ", "text": "…えと…\nちょっと言ってみた\nだけだから…。"},
        { "location": "1084/TALK"  , "narrator": "つばめ", "text": "それだけだから…。"},
        { "location": "1085/SEL"   , "narrator": "", "text": "いやそこは押し切ろう"},
        { "location": "1086/SEL"   , "narrator": "", "text": "すごく聞いたから！"},
        { "location": "1087/SEL"   , "narrator": "", "text": "…本当は嫌なの…？"},
        { "location": "1088/ACT"   , "narrator": "", "text": "いやそこは押し切ろう"},
        { "location": "1090/TALK"  , "narrator": "つばめ", "text": "えっ、と…。"},
        { "location": "1091/ACT"   , "narrator": "", "text": "すごく聞いたから！"},
        { "location": "1093/TALK"  , "narrator": "つばめ", "text": "そ、そんな…。"},
        { "location": "1094/ACT"   , "narrator": "", "text": "…本当は嫌なの…？"},
        { "location": "1096/TALK"  , "narrator": "つばめ", "text": "ううん！\n違うよ！"},
        { "location": "1098/SEL"   , "narrator": "", "text": "好きだよ"},
        { "location": "1099/SEL"   , "narrator": "", "text": "期待していい？"},
        { "location": "1100/SEL"   , "narrator": "", "text": "後悔はさせない"},
        { "location": "1101/ACT"   , "narrator": "", "text": "好きだよ"},
        { "location": "1102/TALK"  , "narrator": "つばめ", "text": "…わたしも…。"},
        { "location": "1103/ACT"   , "narrator": "", "text": "期待していい？"},
        { "location": "1104/TALK"  , "narrator": "つばめ", "text": "…え…\nえっと……。"},
        { "location": "1105/ACT"   , "narrator": "", "text": "後悔はさせない"},
        { "location": "1106/TALK"  , "narrator": "つばめ", "text": "…ずるいよ…\nそんな言い方…。"},
        { "location": "1108/TALK"  , "narrator": "つばめ", "text": "…なんかすごく\n恥ずかしいし…。"},
        { "location": "1109/SEL"   , "narrator": "", "text": "そこがいいんでしょ"},
        { "location": "1110/SEL"   , "narrator": "", "text": "$me$もだよ"},
        { "location": "1111/SEL"   , "narrator": "", "text": "どうしてもダメ？"},
        { "location": "1112/ACT"   , "narrator": "", "text": "そこがいいんでしょ"},
        { "location": "1113/TALK"  , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "1114/ACT"   , "narrator": "", "text": "$me$もだよ"},
        { "location": "1115/TALK"  , "narrator": "つばめ", "text": "そ、そうなの…？"},
