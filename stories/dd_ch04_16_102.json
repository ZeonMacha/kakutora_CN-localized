{
    "dir": "chap16/daydra/dd_ch04_16_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "16405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "大混乱の大根役者＜後編＞"
    },
    "entry":
    [
        { "location": "509/TALK"  , "narrator": "みやび", "text": "…アホらしい。\n何度もこんなことで\n悩むなんて…。"},
        { "location": "510/TALK"  , "narrator": "みやび", "text": "言うか…ウサギに、\nうちの正体…。"},
        { "location": "511/TALK"  , "narrator": "みやび", "text": "わざわざ言う必要\nなんぞないんやろう\nけんど――"},
        { "location": "512/TALK"  , "narrator": "みやび", "text": "ウサギを騙したまま\nっちゅうのは…、\n気分が悪いしな。"},
        { "location": "513/TALK"  , "narrator": "みやび", "text": "…ん、決まりや。"},
        { "location": "514/TALK"  , "narrator": "みやび", "text": "この作業が\n終わったら――"},
        { "location": "515/TALK"  , "narrator": "みやび", "text": "何もかも、\n全部話そう…。"},
        { "location": "516/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "518/TALK"  , "narrator": "みやび", "text": "なんか、気分が\nスッキリしたなぁ。"},
        { "location": "519/TALK"  , "narrator": "みやび", "text": "これで作業に\n集中できそうや！"},
        { "location": "537/TALK"  , "narrator": "繭", "text": "…？"},
        { "location": "538/TALK"  , "narrator": "繭", "text": "何かおかしい…。\nクイーンから来る\n指示が――"},
        { "location": "539/TALK"  , "narrator": "繭", "text": "全部、みやび先輩の\n作業を終えた後に\n来ている…。"},
        { "location": "540/TALK"  , "narrator": "繭", "text": "しかも、みやび先輩\nから来た作業の――"},
        { "location": "541/TALK"  , "narrator": "繭", "text": "次の段階のものが、\nまるで狙ったかの\nように…。"},
        { "location": "542/TALK"  , "narrator": "繭", "text": "…偶然？\nこんなに何度も、\nこの短時間に？"},
        { "location": "543/TALK"  , "narrator": "繭", "text": "でも、もしもこれが\n偶然じゃないと\nしたら――"},
        { "location": "544/TALK"  , "narrator": "繭", "text": "まさか…、\nクイーンの正体は、\nみやび先輩！？"},
        { "location": "545/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "546/TALK"  , "narrator": "繭", "text": "…みやび先輩からの\n指示も、さっきより\n格段に増えている。"},
        { "location": "547/TALK"  , "narrator": "繭", "text": "まるで、人手が一人\n増えたみたいに…。"},
        { "location": "548/TALK"  , "narrator": "繭", "text": "それも、クイーンが\n私に指示を出してきた\nタイミングで。"},
        { "location": "549/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "550/TALK"  , "narrator": "繭", "text": "ごめんなさい…。\nみやび先輩、試させて\nいただきます！"},
        { "location": "554/TALK"  , "narrator": "繭", "text": "…よし、クイーンから\n来た指示を実行！"},
        { "location": "555/TALK"  , "narrator": "繭", "text": "後はこの報告を、\nみやび先輩の方へ…。"},
        { "location": "556/TALK"  , "narrator": "繭", "text": "…木馬の侵入に成功\nいたしました、と。"},
        { "location": "561/TALK"  , "narrator": "繭", "text": "返事は…！？"},
        { "location": "562/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "563/TALK"  , "narrator": "繭", "text": "らじゃ、って…。\nみやび先輩…。"},
        { "location": "564/TALK"  , "narrator": "繭", "text": "正体バレた時の\nセリフにしては、\n間抜け過ぎですよ…。"},
        { "location": "565/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "566/TALK"  , "narrator": "繭", "text": "みやび先輩…、\nいえ、Ｆａｔａｌ\nＱｕｅｅｎ。"},
        { "location": "567/TALK"  , "narrator": "繭", "text": "フェノメノンが収束\nしたときを、どうぞ\nお楽しみに…。"},
        { "location": "578/DIALOG", "narrator": "Dialog_chapter_ch04", "text": "【13 電脳料理人】"}
    ]
}
