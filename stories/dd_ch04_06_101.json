    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "出陣【みやびから見たcase】"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "…今回の戦闘は、\nどんな感じになるん\nやろか？"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "面倒な相手じゃないと\nえいんやけんど…。"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "今私達の歩いている\nこの場所は、現実と\n非現実との境界線よ。"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "普通はここを通り過ぎる\n間に、フェノメノンの力で\n洗脳されてしまうの。"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "えぇっ！？\nそ、それじゃわたし達も\n危ないじゃないですか！"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…ねえ、アーヤ。\nやっぱあたし達だけで\n行った方が良くない？"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "何もわかってない子を\n連れてったって、\n足手まといになるだけよ。"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "ちょっと、ギャヴィ。\nそういう言い方は…。"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "事実を言ったまでよ。"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "い、いいんです。\n勉強不足なわたしが\n悪いんだし…。"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "ごめんね、えと…\nガブリエラちゃん。"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "あんたは\n“ちゃん”付け禁止。"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "…気まずいことに\nなっちょるなぁ。"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "こんな調子で、\n上手くいくんやろか？"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "戦闘の途中で\n仲間割れでも\n起こされたら――"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "堪ったもんやないな。"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "あの、せんぱい。"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "…何よ？"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "え、えっと…。"},
        { "location": "109/TALK"  , "narrator": "つばめ", "text": "…よかったら、\nわたしと手を繋いで\nもらえませんか？"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "は？　いや、何？\n急に何言い出すの？"},
        { "location": "154/TALK"  , "narrator": "つばめ", "text": "だ、だって、こんな\n不気味なところ\n歩いてると――"},
        { "location": "155/TALK"  , "narrator": "つばめ", "text": "何か不安な気持ちに\nなってくるじゃない\nですか。"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "だから、よかったら\n手を握ってもらえたら\n嬉しいなぁ、って…。"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "173/SEL"   , "narrator": "", "text": "助け舟出さないの？"},
        { "location": "174/ACT"   , "narrator": "", "text": "助け舟出さないの？"},
        { "location": "195/TALK"  , "narrator": "みやび", "text": "うちが"},
        { "location": "196/TALK"  , "narrator": "みやび", "text": "Ｂｏｔの指図に従う思うか？"},
        { "location": "208/TALK"  , "narrator": "みやび", "text": "…やはり、うちらを\nどこからか監視し\nちょるらしいな。"},
        { "location": "209/TALK"  , "narrator": "みやび", "text": "誰の差し金なのか…。"},
        { "location": "210/TALK"  , "narrator": "みやび", "text": "いや、もしかすると\n新手のフェノメノン、\nっちゅう可能性も…。"},
        { "location": "211/SEL"   , "narrator": "", "text": "みやびを助けたいだけだよ"},
        { "location": "212/SEL"   , "narrator": "", "text": "みやびが好きなだけだよ"},
        { "location": "213/ACT"   , "narrator": "", "text": "みやびを助けたいだけだよ"},
        { "location": "234/TALK"  , "narrator": "みやび", "text": "口の上手いＢｏｔやね"},
        { "location": "235/TALK"  , "narrator": "みやび", "text": "助けたいなら黙っちょれ"},
        { "location": "246/ACT"   , "narrator": "", "text": "みやびが好きなだけだよ"},
        { "location": "267/TALK"  , "narrator": "みやび", "text": "口の上手いＢｏｔやね"},
        { "location": "268/TALK"  , "narrator": "みやび", "text": "胸キュンはせんけんどな"},
        { "location": "323/TALK"  , "narrator": "みやび", "text": "……　…"},
        { "location": "337/TALK"  , "narrator": "みやび", "text": "ふわあっ！"},
        { "location": "341/TALK"  , "narrator": "みやび", "text": "ひやぁぁっ！"},
        { "location": "345/TALK"  , "narrator": "みやび", "text": "ふごあぁぁっ！"},
        { "location": "352/TALK"  , "narrator": "みやび", "text": "もうちっと、\n優しくしいや……。"},
        { "location": "353/SEL"   , "narrator": "", "text": "おはよう"},
        { "location": "354/ACT"   , "narrator": "", "text": "おはよう"},
        { "location": "358/TALK"  , "narrator": "みやび", "text": "しっかし、もはや\nたたき起こされることが\n挨拶になりつつあるね。"},
        { "location": "363/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n0x022番地から\n0x963番地へ。"},
        { "location": "378/TALK"  , "narrator": "みやび", "text": "完了。"},
        { "location": "380/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "381/TALK"  , "narrator": "みやび", "text": "………。"},
        { "location": "382/TALK"  , "narrator": "みやび", "text": "もしかして、\n今回も説明が必要か？"},
        { "location": "383/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "384/SEL"   , "narrator": "", "text": "いらない"},
        { "location": "385/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "386/TALK"  , "narrator": "みやび", "text": "まあ、わかっちゅうた\nけんど。面倒くさいね。"},
        { "location": "388/TALK"  , "narrator": "みやび", "text": "ええと、\nココロファイルナンバー\n04-004-82によると――"},
        { "location": "389/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "390/TALK"  , "narrator": "みやび", "text": "………。"},
        { "location": "391/TALK"  , "narrator": "みやび", "text": "またか。"},
        { "location": "392/TALK"  , "narrator": "みやび", "text": "っつーかな……。"},
        { "location": "393/TALK"  , "narrator": "みやび", "text": "これ、うちからわざわざ\n説明する必要、あるが？"},
        { "location": "394/TALK"  , "narrator": "みやび", "text": "『うちは、Botである\nお前さんを警戒しちゅう』\n（計20文字）"},
        { "location": "395/TALK"  , "narrator": "みやび", "text": "これだけや。\nたったこれだけの\nことやきね。"},
        { "location": "396/TALK"  , "narrator": "みやび", "text": "しかも、この20文字の\n回答以上のことを、\n現実で見たハズやよ？"},
        { "location": "397/SEL"   , "narrator": "", "text": "確かに"},
        { "location": "398/SEL"   , "narrator": "", "text": "司書のみやびと仲良くなりたかった"},
        { "location": "399/ACT"   , "narrator": "", "text": "確かに"},
        { "location": "400/TALK"  , "narrator": "みやび", "text": "まあえい。\nこれで今回の仕事は\n終わりやきね。"},
        { "location": "401/ACT"   , "narrator": "", "text": "司書のみやびと仲良くなりたかった"},
        { "location": "402/TALK"  , "narrator": "みやび", "text": "残念やけんど、\n口説くなら現実のうちを\n口説きいや。"},
        { "location": "404/TALK"  , "narrator": "みやび", "text": "さあ、さっさと\nクランを倒してきい。"},
        { "location": "405/TALK"  , "narrator": "みやび", "text": "そうせんとお前さん、\n本当にうちの世界に\n出禁になるぞね？"},
        { "location": "407/TALK"  , "narrator": "みやび", "text": "うちと$handle$に\nえいココロの旅を！"},
        { "location": "414/ACT"   , "narrator": "", "text": "いらない"},
        { "location": "415/TALK"  , "narrator": "みやび", "text": "エラいっ！！"},
        { "location": "416/TALK"  , "narrator": "みやび", "text": "うちの睡眠時間を\n15秒増やしてくれた\nお前さんは神や！"},
        { "location": "418/TALK"  , "narrator": "みやび", "text": "ほんだら、いてら！\nうちと$handle$に\nえいココロの旅を！"},
        { "location": "45/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月9日　1:45 PM</color>\nWAVE戦フェノメノン内部へ向かう途中、不確定量子の繭の中にて。"},
        { "location": "291/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "328/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "350/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
    ]
}
