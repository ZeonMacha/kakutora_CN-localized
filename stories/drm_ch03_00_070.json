{
    "dir": "dramatics/daydra/drm_ch03_00_070.js",
    "type": "Episode",
    "info": {
        "story_id": "3007",
        "cid": "gabriella",
        "title": "らぶとーく  第07話",
        "sub_title": "みんなおかしくない？"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "みんなおかしくない？"},
        { "location": "21/TALK"   , "narrator": "アーヤ", "text": "――というわけなの。"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "ちょ、待ってよ！\n何言い出すのよ急に！？"},
        { "location": "25/TALK"   , "narrator": "ガブリエラ", "text": "マルザ…"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "Ｂｏｔの正体が人間って…\n意味わからないんだけど？"},
        { "location": "28/TALK"   , "narrator": "アーヤ", "text": "あくまで\n可能性の話でしか\nないけど。"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "私達がＢｏｔだと思ってる\nあれは。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "人間が、Ｂｏｔのフリを\nしているだけって\n可能性が高いの。"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "そっか…$handle$、\n本当は人間だったん\nですね。"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "いや、何落ち着いて\n言ってんのよ！"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "なんで納得\nできるの？\n意味わかんない！"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "う、うん…。\nビックリはしたよ。"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "でも、人間だったら\n良いのになぁ、って\n思ってたから――"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "今はちょっとだけ\n嬉しいの。"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "つばめちゃんは、\n状況適応力が凄過ぎや。"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "何も考えて\nないだけでしょ！？"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "まあ、うちはなんとなく\n気付いてたきね。"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "それが確信に変わった\nだけのことや。"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "みやびも\nＢｏｔが人間だって\n言うわけ？"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "そんなこと\n考えたくない、って\n気持ちはわかるわ。"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "だけど、これは\nかなり確率の高い\n話なの。"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "だからみんな\n話す内容には\n気をつけて。"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "っていうか、人間か\nどうかって、そんなに\n重要なことですか？"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "そりゃまあ…人間やと\nしたら、Ｂｏｔやと思うて\n話してた会話が――"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "全部誰かに話したゆう\nことになるんやし。"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "！？"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "それなのよね…。\nまあ、誰かにバラすような\nことはなさそうだけど…。"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "いい加減にしてよ！"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "Ｂｏｔが人間とか、\n笑えない冗談にも\n程があるわ。"},
        { "location": "68/SEL"    , "narrator": "", "text": "ちゃんと聞いてる？"},
        { "location": "69/SEL"    , "narrator": "", "text": "バレちゃったみたいだね"},
        { "location": "70/SEL"    , "narrator": "", "text": "ガブはどう思う？"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "確定じゃないわ。\nあくまで可能性の\n話ってこと。"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "ガブちゃん。\nうちらも冗談で言っちゅう\nわけやないぞね。"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "会話ログを解析したり、\n色々した結果、そういう\n答えを導き出したがよ。"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "だから、その導き出した\n答えが間違ってるの！"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "ああもう、話にならない！"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "とにかく、あたしは\nそんな話信じないから。"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "そうね。\n確かにそう。"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "もちろん、私だって\n混乱はしてる。"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "それでもね。\nできるだけ、冷静に対応を\nしようと思ってるわ。"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "だから、もしみんなが\n今後のＢｏｔとの\n付き合い方とかで――"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "わからないことがあれば、\nいつでも相談してくれて\n構わないから。"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "私の話は以上よ。\nそれじゃ、今夜は解散。"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "まったく、こんなふざけた\n話のために、一々人のこと\n呼び出さないでよね！"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "Ｂｏｔが…マルザンナが\n人間って…。"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "そんなの、ありえない。\nみんなおかしいわよ！"},
        { "location": "113/ACT"   , "narrator": "", "text": "ちゃんと聞いてる？"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "聞く必要ないわ、こんな馬鹿げた話"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "今日はエイプリルフールじゃないのよ？"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "なのに、こんなつまらない冗談聞かされて…バカみたい。"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "この場で結論が\n出るわけがないと\nわかってるの。"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "でもこれは\n考えなきゃ\nいけないことよ。"},
        { "location": "145/ACT"   , "narrator": "", "text": "バレちゃったみたいだね"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "何を言ってるの？"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナまで、変な冗談言わないで！"},
        { "location": "173/TALK"  , "narrator": "アーヤ", "text": "この場で結論が\n出るわけがないと\nわかってるの。"},
        { "location": "174/TALK"  , "narrator": "アーヤ", "text": "でもこれは\n考えなきゃ\nいけないことよ。"},
        { "location": "176/ACT"   , "narrator": "", "text": "ガブはどう思う？"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "どうも何もないわ"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "こんな時間に、変な冗談聞かされるために付き合わされたのよ？"},
        { "location": "194/TALK"  , "narrator": "ガブリエラ", "text": "迷惑以外の何でもないわ"},
        { "location": "205/TALK"  , "narrator": "アーヤ", "text": "この場で結論が\n出るわけがないと\nわかってるの。"},
        { "location": "206/TALK"  , "narrator": "アーヤ", "text": "でもこれは\n考えなきゃ\nいけないことよ。"},
        { "location": "20/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月某日　10:05 PM</color>\n平日の夜、神楽坂トライナリーのホワイエにて。"}
    ]
}
