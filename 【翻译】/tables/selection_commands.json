            "narrator_zh": ""
        },
        {
            "location": "11700/param1",
            "narrator": "",
            "text": "故意の恋",
            "zh": "故意的恋",
            "narrator_zh": ""
        },
        {
            "location": "12414/param1",
            "narrator": "",
            "text": "キミと歩いてく",
            "zh": "和你一起走下去",
            "narrator_zh": ""
        },
        {
            "location": "12840/param1",
            "narrator": "",
            "text": "郷土料理ってほどでもないけど",
            "zh": "还算不上乡土菜",
            "narrator_zh": ""
        },
        {
            "location": "12915/param1",
            "narrator": "",
            "text": "サプライズをあなたに",
            "zh": "把惊喜给你",
            "narrator_zh": ""
        },
        {
            "location": "14042/param1",
            "narrator": "",
            "text": "それは哲学にも似て",
            "zh": "那也像哲学",
            "narrator_zh": ""
        },
        {
            "location": "14081/param1",
            "narrator": "",
            "text": "山の彼方の空遠く",
            "zh": "山的那边，天空遥远",
            "narrator_zh": ""
        },
        {
            "location": "14303/param1",
            "narrator": "",
            "text": "女子力は鍛えるものや否や",
            "zh": "女子力是否该锻炼",
            "narrator_zh": ""
        },
        {
            "location": "14828/param1",
            "narrator": "",
            "text": "その道が見える？",
            "zh": "看得见那条路吗？",
            "narrator_zh": ""
        },
        {
            "location": "15241/param1",
            "narrator": "",
            "text": "ハートのささやき",
            "zh": "心的低语",
            "narrator_zh": ""
        },
        {
            "location": "15959/param1",
            "narrator": "",
            "text": "ミツバチよりも小さな声で",
            "zh": "用比蜜蜂还小的声音",
            "narrator_zh": ""
        },
        {
            "location": "16473/param1",
