        },
        {
            "location": "3086/param1",
            "narrator": "",
            "text": "呪文を覚えたわたしだよ",
            "zh": "记住了咒语的我",
            "narrator_zh": ""
        },
        {
            "location": "3407/param1",
            "narrator": "",
            "text": "15歳はため息交じり",
            "zh": "十五岁夹着一声叹",
            "narrator_zh": ""
        },
        {
            "location": "3839/param1",
            "narrator": "",
            "text": "みんなでうた",
            "zh": "大家一起唱",
            "narrator_zh": ""
        },
        {
            "location": "4433/param1",
            "narrator": "",
            "text": "ステップ、ステップ",
            "zh": "步、步",
            "narrator_zh": ""
        },
        {
            "location": "4941/param1",
            "narrator": "",
            "text": "コイビトドウシ",
            "zh": "恋人们",
            "narrator_zh": ""
        },
        {
            "location": "5382/param1",
            "narrator": "",
            "text": "魔法と科学技術の法則",
            "zh": "魔法与科学技术的法则",
            "narrator_zh": ""
        },
        {
            "location": "5897/param1",
            "narrator": "",
            "text": "だから、は恋じゃない",
            "zh": "所以，那不是恋",
            "narrator_zh": ""
        },
        {
            "location": "6430/param1",
            "narrator": "",
            "text": "今日も月がきれい",
            "zh": "今天月亮也很好看",
            "narrator_zh": ""
        },
        {
            "location": "6938/param1",
            "narrator": "",
            "text": "触れられるなら",
            "zh": "如果能触到",
            "narrator_zh": ""
        },
        {
            "location": "7460/param1",
            "narrator": "",
            "text": "プース・カフェスタイル",
            "zh": "普斯·咖啡馆风格",
            "narrator_zh": ""
        },
        {
            "location": "8112/param1",
            "narrator": "",
            "text": "おやすみなさいのその前に",
            "zh": "在说晚安之前",
            "narrator_zh": ""
        },
        {
            "location": "8177/param1",
            "narrator": "",
            "text": "その目をふさいでも",
            "zh": "就算蒙上那双眼睛",
            "narrator_zh": ""
        },
        {
            "location": "8649/param1",
            "narrator": "",
            "text": "瓶覗きの空",
            "zh": "瓶窥色的天空",
            "narrator_zh": ""
        },
        {
            "location": "9212/param1",
            "narrator": "",
            "text": "うそだよね、うそでしょう？",
            "zh": "是骗我的吧，是骗我的吧？",
            "narrator_zh": ""
        },
        {
            "location": "10277/param1",
            "narrator": "",
            "text": "オンナノコは余裕",
            "zh": "女孩子从容得很",
            "narrator_zh": ""
        },
        {
            "location": "10817/param1",
            "narrator": "",
            "text": "わたしなりの幸せ論",
            "zh": "我自己的幸福论",
            "narrator_zh": ""
        },
        {
            "location": "11132/param1",
            "narrator": "",
            "text": "ほんとのはなし",
            "zh": "真心话",
            "narrator_zh": ""
        },
        {
            "location": "11133/param1",
            "narrator": "",
            "text": "おいしいものを二人で",
            "zh": "好吃的东西，两个人",
            "narrator_zh": ""
        },
        {
            "location": "11682/param1",
            "narrator": "",
            "text": "なんだかね、",
            "zh": "怎么说呢，",
            "narrator_zh": ""
        },
        {
            "location": "11694/tag1",
            "narrator": "",
            "text": "んー",
            "zh": "嗯—",
            "narrator_zh": ""
        },
        {
            "location": "12288/param1",
            "narrator": "",
            "text": "今の好き",
            "zh": "现在的喜欢",
            "narrator_zh": ""
        },
        {
            "location": "12824/param1",
            "narrator": "",
            "text": "梅干し入りのおかゆとか",
            "zh": "比如加了梅干的粥",
            "narrator_zh": ""
        },
        {
            "location": "12896/param1",
            "narrator": "",
            "text": "ふわふわなふわふわ",
            "zh": "软绵绵的软绵绵",
            "narrator_zh": ""
        },
        {
            "location": "14040/param1",
            "narrator": "",
            "text": "ミルクコーヒーは誰のもの",
            "zh": "牛奶咖啡是谁的",
            "narrator_zh": ""
        },
        {
            "location": "14061/param1",
            "narrator": "",
            "text": "おはようって、いつかは",
            "zh": "早安这句话，总有一天",
            "narrator_zh": ""
        },
        {
            "location": "14290/param1",
            "narrator": "",
            "text": "ゆびきりげんまん",
            "zh": "拉钩上吊",
            "narrator_zh": ""
        },
        {
            "location": "14808/param1",
            "narrator": "",
            "text": "宣言します",
            "zh": "我宣言",
            "narrator_zh": ""
        },
        {
            "location": "15212/param1",
            "narrator": "",
            "text": "まだ決まってないけど",
            "zh": "虽然还没决定",
            "narrator_zh": ""
        },
        {
            "location": "15939/param1",
            "narrator": "",
            "text": "また明日を毎日ね",
            "zh": "把明天见说成每一天",
            "narrator_zh": ""
        },
        {
            "location": "16446/param1",
            "narrator": "",
            "text": "怒っちゃダメかな",
            "zh": "生气是不可以的吗",
            "narrator_zh": ""
        },
        {
            "location": "16524/param1",
            "narrator": "",
            "text": "いつもかわいいことばかり",
            "zh": "净是些一直很可爱的事",
            "narrator_zh": ""
        },
        {
            "location": "1736/param1",
            "narrator": "",
            "text": "神楽坂をスキップで",
            "zh": "蹦跳着走过神乐坂",
            "narrator_zh": ""
        },
        {
            "location": "1839/param1",
            "narrator": "",
            "text": "むかしむかしあるところに",
            "zh": "很久很久以前，在某个地方",
            "narrator_zh": ""
        },
        {
            "location": "1946/param1",
            "narrator": "",
            "text": "くしゃみの理由",
            "zh": "打喷嚏的理由",
            "narrator_zh": ""
        },
        {
            "location": "2079/param1",
            "narrator": "",
            "text": "淑女による紳士協定",
            "zh": "淑女订立的绅士协定",
            "narrator_zh": ""
        },
        {
            "location": "3101/param1",
            "narrator": "",
            "text": "その、ね",
            "zh": "那个，呢",
            "narrator_zh": ""
        },
        {
            "location": "3425/param1",
            "narrator": "",
            "text": "らんらんの乱",
            "zh": "热闹的乱",
            "narrator_zh": ""
        },
        {
            "location": "3872/param1",
            "narrator": "",
            "text": "気持ちヘクトパスカル",
            "zh": "心情的百帕",
            "narrator_zh": ""
        },
        {
            "location": "4442/param1",
            "narrator": "",
            "text": "毒林檎姫林檎",
            "zh": "毒苹果公主苹果",
            "narrator_zh": ""
        },
        {
            "location": "4995/param1",
            "narrator": "",
            "text": "おひめさまには遅すぎる",
            "zh": "对小公主来说太晚了",
            "narrator_zh": ""
        },
        {
            "location": "5407/param1",
            "narrator": "",
            "text": "平行世界の世界線",
            "zh": "平行世界的世界线",
            "narrator_zh": ""
        },
        {
            "location": "5919/param1",
            "narrator": "",
            "text": "声が聞きたくて（なんて）",
            "zh": "想听见声音（什么的）",
            "narrator_zh": ""
        },
        {
            "location": "6462/param1",
            "narrator": "",
            "text": "約束と束縛",
            "zh": "约定与束缚",
            "narrator_zh": ""
        },
        {
            "location": "6965/param1",
            "narrator": "",
            "text": "それは、いつもと違うから",
            "zh": "因为那和往常不一样",
            "narrator_zh": ""
        },
        {
            "location": "7489/param1",
            "narrator": "",
            "text": "ありがとう",
            "zh": "谢谢",
            "narrator_zh": ""
        },
        {
            "location": "8124/param1",
            "narrator": "",
            "text": "風の匂い",
            "zh": "风的气味",
            "narrator_zh": ""
        },
        {
            "location": "8200/param1",
            "narrator": "",
            "text": "オトナ語検定",
            "zh": "大人语检定",
            "narrator_zh": ""
        },
        {
            "location": "8667/param1",
            "narrator": "",
            "text": "傍目八目",
            "zh": "傍目八目",
            "narrator_zh": ""
        },
        {
            "location": "9230/param1",
            "narrator": "",
            "text": "早い者勝ちってわけじゃないけど",
            "zh": "虽说不是先到先得",
            "narrator_zh": ""
        },
        {
            "location": "10296/param1",
            "narrator": "",
            "text": "朝も昼も夜も",
            "zh": "朝也昼也夜也",
            "narrator_zh": ""
        },
        {
            "location": "10831/param1",
            "narrator": "",
            "text": "熱冷ましにアイスクリーム",
            "zh": "用冰淇淋来退烧",
            "narrator_zh": ""
        },
        {
            "location": "11775/param1",
            "narrator": "",
