    "entry": [
        {
            "location": "1/skill",
            "narrator": "",
            "text": "適応力？？\n\n",
            "zh": "适应力？？\n\n",
            "narrator_zh": ""
        },
        {
            "location": "1/other",
            "narrator": "",
            "text": "\nいちご、フレイメノウ、\n可愛い服、鯛焼き\n\n病院、薬、痛いこと\n",
            "zh": "\n草莓、FreyMENOW、\n可爱的衣服、鲷鱼烧\n\n医院、药、疼的事\n",
            "narrator_zh": ""
        },
        {
            "location": "1/birthday",
            "narrator": "",
            "text": "2000年6月7日",
            "zh": "2000年6月7日",
            "narrator_zh": ""
        },
        {
            "location": "1/hobby",
            "narrator": "",
            "text": "今までずっと病院にいたから\n楽しい事をあまり知らない。\n",
            "zh": "因为一直住在医院里，\n不太知道什么好玩的事。\n",
            "narrator_zh": ""
        },
        {
            "location": "2/skill",
            "narrator": "",
            "text": "剣道、武士道（真剣も扱う）\n鍋料理を作る\n",
            "zh": "剑道、武士道（真剑也使得）\n做火锅\n",
            "narrator_zh": ""
        },
        {
            "location": "2/other",
            "narrator": "",
            "text": "\n武士の心得、精神統一\n哲学、子供、都会\n\nだらしない人\n",
            "zh": "\n武士的心得、精神统一\n哲学、小孩、都市\n\n邋遢的人\n",
            "narrator_zh": ""
        },
        {
            "location": "2/birthday",
            "narrator": "",
            "text": "1994年9月14日",
            "zh": "1994年9月14日",
            "narrator_zh": ""
        },
        {
            "location": "2/hobby",
            "narrator": "",
            "text": "ツーリング（バイク）\n一人旅、人形作り、洋裁\n",
            "zh": "骑车兜风（摩托）\n独自旅行、做娃娃、裁缝\n",
            "narrator_zh": ""
        },
        {
            "location": "3/skill",
            "narrator": "",
            "text": "射撃、スナイパー、ポーランド\n料理、香辛料を見分ける\n",
            "zh": "射击、狙击、波兰\n做菜、分辨香料\n",
            "narrator_zh": ""
        },
        {
            "location": "3/other",
            "narrator": "",
            "text": "\nたこ焼き、日本文化、銃\nプラツキジェムニャチャーネ\n\n後ろに立たれること\n",
            "zh": "\n章鱼烧、日本文化、枪\n波兰土豆饼\n\n被人站在背后\n",
            "narrator_zh": ""
        },
        {
            "location": "3/birthday",
            "narrator": "",
            "text": "2001年10月13日",
            "zh": "2001年10月13日",
            "narrator_zh": ""
        },
        {
            "location": "3/hobby",
            "narrator": "",
            "text": "日本らしいものを集めること\n日本のサブカルチャー\n",
            "zh": "收集日本味的东西\n日本的亚文化\n",
            "narrator_zh": ""
        },
        {
            "location": "4/skill",
            "narrator": "",
            "text": "プログラミング、人の気持ちを\n察する、懐石料理を作る\n",
            "zh": "编程、体察别人的\n心情、做怀石料理\n",
            "narrator_zh": ""
        },
        {
            "location": "4/other",
            "narrator": "",
            "text": "\n洋菓子、ＰＣ魔改造、温泉\n一人で久里浜線に乗る\n\n片付け\n",
            "zh": "\n西式点心、魔改电脑、温泉\n一个人坐久里滨线\n\n收拾东西\n",
            "narrator_zh": ""
        },
        {
            "location": "4/birthday",
            "narrator": "",
            "text": "1998年7月27日",
            "zh": "1998年7月27日",
            "narrator_zh": ""
        },
        {
            "location": "4/hobby",
            "narrator": "",
            "text": "ネトゲ、情報収集\nサーバー構築、侵入\n",
            "zh": "网游、收集情报\n搭建服务器、入侵\n",
            "narrator_zh": ""
        },
        {
            "location": "5/skill",
            "narrator": "",
            "text": "歌って踊れる\n役になりきれる\n",
            "zh": "能歌善舞\n能完全入戏\n",
            "narrator_zh": ""
        },
        {
            "location": "5/other",
            "narrator": "",
            "text": "\n和菓子、カフェ、魔法少女\n森ガール系のデザイン\n\n掃除、運命\n",
            "zh": "\n日式点心、咖啡厅、魔法少女\n森林女孩风的打扮\n\n打扫、命运\n",
            "narrator_zh": ""
        },
        {
            "location": "5/birthday",
            "narrator": "",
            "text": "2000年12月9日",
            "zh": "2000年12月9日",
            "narrator_zh": ""
        },
        {
            "location": "5/hobby",
            "narrator": "",
            "text": "ラノベ、アニメを見る\n（特に中二成分多めのもの）\n",
            "zh": "轻小说、看动画\n（尤其中二味重的）\n",
            "narrator_zh": ""
        }
    ]
}
