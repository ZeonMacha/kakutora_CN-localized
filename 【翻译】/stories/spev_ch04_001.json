{
    "dir": "chap00/daydra/spev_ch04_001.js",
    "type": "",
    "info": {
        "story_id": "4001",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "みやびの日常",
        "title_zh": "特别篇",
        "sub_title_zh": "雅的日常"
    },
    "entry": [
        {
            "location": "12/TALK",
            "narrator": "みやび",
            "text": "ひまー",
            "zh": "好闲——",
            "narrator_zh": "雅"
        },
        {
            "location": "13/TALK",
            "narrator": "みやび",
            "text": "ひまひまひままー",
            "zh": "闲闲闲死啦——",
            "narrator_zh": "雅"
        },
        {
            "location": "14/TALK",
            "narrator": "みやび",
            "text": "世の中つまらぬことだらけ",
            "zh": "这世上尽是无聊透顶的事",
            "narrator_zh": "雅"
        },
        {
            "location": "24/SEL",
            "narrator": "（選択肢）",
            "text": "それを人は平和という",
            "zh": "人们管这叫作和平",
            "narrator_zh": "（选项）"
        },
        {
            "location": "25/SEL",
            "narrator": "（選択肢）",
            "text": "なんて格好してるの！？",
            "zh": "你穿的这是什么打扮！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "26/ACT",
            "narrator": "",
            "text": "それを人は平和という",
            "zh": "人们管这叫作和平",
            "narrator_zh": ""
        },
        {
            "location": "27/TALK",
            "narrator": "みやび",
            "text": "なるほど納得",
            "zh": "原来如此，说得通",
            "narrator_zh": "雅"
        },
        {
            "location": "28/TALK",
            "narrator": "みやび",
            "text": "平和とは暇なこと",
            "zh": "和平就是清闲",
            "narrator_zh": "雅"
        },
        {
            "location": "29/TALK",
            "narrator": "みやび",
            "text": "そして行き過ぎた平和は人を堕落させる",
            "zh": "而过度的和平会让人堕落",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "みやび",
            "text": "由々しき事態である",
            "zh": "实乃事态严重",
            "narrator_zh": "雅"
        },
        {
            "location": "31/ACT",
            "narrator": "",
            "text": "なんて格好してるの！？",
            "zh": "你穿的这是什么打扮！？",
            "narrator_zh": ""
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "別に普通だが何か？",
            "zh": "明明很普通啊，怎么了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "部屋ではリラックススタイルがうちのジャスティス",
            "zh": "在房间里穿得放松才是我的正义",
            "narrator_zh": "雅"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "それが何か問題か？",
            "zh": "这有驷马问题咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "38/SEL",
            "narrator": "（選択肢）",
            "text": "色々見えそうなんだけど…",
            "zh": "感觉各种地方都要露出来了……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "39/SEL",
            "narrator": "（選択肢）",
            "text": "女の子がはしたない！",
            "zh": "女孩子家太不成体统了！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "40/SEL",
            "narrator": "（選択肢）",
            "text": "ちょっと身体を動かしてみて",
            "zh": "稍微动一下身子看看",
            "narrator_zh": "（选项）"
        },
        {
            "location": "41/ACT",
            "narrator": "",
            "text": "色々見えそうなんだけど…",
            "zh": "感觉各种地方都要露出来了……",
            "narrator_zh": ""
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "見えそうイコール見えないということ",
            "zh": "“好像要露出来”就等于“没露出来”",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "いくら部屋でも",
            "zh": "就算是在自己房间里",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "丸出し厳禁！",
            "zh": "也严禁彻底走光！",
            "narrator_zh": "雅"
        },
        {
            "location": "46/TALK",
            "narrator": "みやび",
            "text": "常識人のうち！",
            "zh": "我可是讲常识的人！",
            "narrator_zh": "雅"
        },
        {
            "location": "49/ACT",
            "narrator": "",
            "text": "女の子がはしたない！",
            "zh": "女孩子家太不成体统了！",
            "narrator_zh": ""
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "おまえが言うな案件発生",
            "zh": "触发“亏你说得出口”事件",
            "narrator_zh": "雅"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "お年頃の乙女の部屋を当然のように覗いている貴様が何を言う！？",
            "zh": "像逛自家一样光明正大偷窥花季少女房间的你，还有脸说这话！？",
            "narrator_zh": "雅"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "話しかけたのはうちだが",
            "zh": "虽然主动搭话的是我",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "乙女はワガママで気まぐれが許される生き物なのである",
            "zh": "少女可是被允许任性又善变的生物",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "故に悪いのはそっち",
            "zh": "所以错的是你那边",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "うちは無罪ではしたなくもない",
            "zh": "我无罪，也才没有不成体统",
            "narrator_zh": "雅"
        },
        {
            "location": "59/ACT",
            "narrator": "",
            "text": "ちょっと身体を動かしてみて",
            "zh": "稍微动一下身子看看",
            "narrator_zh": ""
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "よし",
            "zh": "好",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "では指をチャット終了ボタンの上へ動かしてみよう",
            "zh": "那我把手指移到结束聊天按钮上面去试试吧",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "しかしいつも思うのだが",
            "zh": "不过我老是在想",
            "narrator_zh": "雅"
        },
        {
            "location": "72/TALK",
            "narrator": "みやび",
            "text": "この体制でのタブレットは見難くて堪らん",
            "zh": "这姿势看平板电脑简直难看清得要命",
            "narrator_zh": "雅"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "うちの視界を邪魔するのは",
            "zh": "挡住我视线的",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "憎き二つの脂肪の塊",
            "zh": "正是这两团可恨的脂肪",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "ジャストな体制はないだろうか？",
            "zh": "就没有刚刚好的姿势了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "76/SEL",
            "narrator": "（選択肢）",
            "text": "足を開いてみるといいかも",
            "zh": "试着把腿张开说不定不错",
            "narrator_zh": "（选项）"
        },
        {
            "location": "77/SEL",
            "narrator": "（選択肢）",
            "text": "ていうか下着くらい付けようよ",
            "zh": "话说你起码穿上内衣啊",
            "narrator_zh": "（选项）"
        },
        {
            "location": "78/SEL",
            "narrator": "（選択肢）",
            "text": "こちらとしては良い景色",
            "zh": "对我这边来说倒是好风景",
            "narrator_zh": "（选项）"
        },
        {
            "location": "79/ACT",
            "narrator": "",
            "text": "足を開いてみるといいかも",
            "zh": "试着把腿张开说不定不错",
            "narrator_zh": ""
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "足を開くとどうなるか？",
            "zh": "把腿张开会怎样？",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "支えを失いタブレットが倒れる",
            "zh": "失去支撑，平板就会倒下去",
            "narrator_zh": "雅"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "相棒はバカか？",
            "zh": "搭档是笨蛋咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "万有引力を知らぬ星からやって来た宇宙人か？",
            "zh": "你是从不懂万有引力的星球来的外星人咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "86/ACT",
            "narrator": "",
            "text": "ていうか下着くらい付けようよ",
            "zh": "话说你起码穿上内衣啊",
            "narrator_zh": ""
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "女のリラックスというのは",
            "zh": "女人的放松这件事",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "肉体を下着から解放することから始まる",
            "zh": "正是从把肉体从内衣中解放出来开始的",
            "narrator_zh": "雅"
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "胸に跡が付くほど締め付ける金具入りのブラジャー",
            "zh": "把胸口勒出印子的带钢圈胸罩",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "腰回りに跡が付くほどゴムの強い脱ぐとクシャっとなるショーツ",
            "zh": "腰间松紧勒出印子、一脱就皱成一团的内裤",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "どっちも拘束具並みにうちを締め付けて苦しめる",
            "zh": "两个都像束缚具一样把我勒得难受",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "白い悪魔と呼ぼう",
            "zh": "就叫它们白色恶魔吧",
            "narrator_zh": "雅"
        },
        {
            "location": "95/TALK",
            "narrator": "みやび",
            "text": "日によっては黒やベージュや薄ピンクにも変化する",
            "zh": "看日子有时还会变成黑色、米色或者浅粉色",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "赤はない",
            "zh": "没得红色的",
            "narrator_zh": "雅"
        },
        {
            "location": "97/ACT",
            "narrator": "",
            "text": "こちらとしては良い景色",
            "zh": "对我这边来说倒是好风景",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "いい趣味やね",
            "zh": "好趣味咯",
            "narrator_zh": "雅"
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "うちのタブレットは最新故に",
            "zh": "因为我的平板是最新款",
            "narrator_zh": "雅"
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "背面を見てるだけでも幸せになるのはわかるぞね",
            "zh": "光看背面就能感到幸福，这点我懂咧",
            "narrator_zh": "雅"
        },
        {
            "location": "102/SEL",
            "narrator": "（選択肢）",
            "text": "そういうことじゃなくて",
            "zh": "不是那个意思",
            "narrator_zh": "（选项）"
        },
        {
            "location": "103/ACT",
            "narrator": "",
            "text": "そういうことじゃなくて",
            "zh": "不是那个意思",
            "narrator_zh": ""
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "相棒はタブレット背面フェチ",
            "zh": "搭档是平板背面控",
            "narrator_zh": "雅"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "脳内に保存済みやき",
            "zh": "我已经存进脑子里了啵",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "変更も上書き保存も不可能や",
            "zh": "没法修改也没法覆盖保存咯",
            "narrator_zh": "雅"
        },
        {
            "location": "111/TALK",
            "narrator": "みやび",
            "text": "さて暇つぶしも飽きた",
            "zh": "好了，消遣也腻了",
            "narrator_zh": "雅"
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "そろそろ食事にする",
            "zh": "差不多该吃饭了",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "つまりさらばである",
            "zh": "也就是说，就此别过",
            "narrator_zh": "雅"
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "とにかく今のうちは退屈モード",
            "zh": "总之现在的我正处于无聊模式",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "ネットという最大の友がうちを楽しませてくれん今",
            "zh": "在网络这个最大的朋友都逗不乐我的当下",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "みやび",
            "text": "頼りになるのは相棒だけや",
            "zh": "靠得住的就只有搭档了咯",
            "narrator_zh": "雅"
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "ヘルプミーミー",
            "zh": "Help me me",
            "narrator_zh": "雅"
        },
        {
            "location": "124/SEL",
            "narrator": "（選択肢）",
            "text": "ていうか、なんて格好してるんだ！？",
            "zh": "话说回来，你穿的这是什么打扮！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "125/SEL",
            "narrator": "（選択肢）",
            "text": "乙女よネット世界を捨て街へ出よう",
            "zh": "少女啊，抛弃网络世界走向街头吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "126/ACT",
            "narrator": "",
            "text": "ていうか、なんて格好してるんだ！？",
            "zh": "话说回来，你穿的这是什么打扮！？",
            "narrator_zh": ""
        },
        {
            "location": "128/ACT",
            "narrator": "",
            "text": "乙女よネット世界を捨て街へ出よう",
            "zh": "少女啊，抛弃网络世界走向街头吧",
            "narrator_zh": ""
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "街が来いとうちは言いたい",
            "zh": "我想说，让街自己过来吧",
            "narrator_zh": "雅"
        },
        {
            "location": "130/TALK",
            "narrator": "みやび",
            "text": "部屋にいながら街に出たい",
            "zh": "我想待在房间里就出门逛街",
            "narrator_zh": "雅"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "何故なら外出は面倒だから",
            "zh": "因为出门太麻烦了",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "となるともうあれや",
            "zh": "这么一来就只剩那个咯",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "うちはネトゲの街へ旅立とう",
            "zh": "我还是动身前往网游里的城镇吧",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "相棒を捨てネトゲの街へ旅立つぞね",
            "zh": "我要抛下搭档动身去网游里的城镇咧",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "さらば",
            "zh": "告辞",
            "narrator_zh": "雅"
        }
    ]
}
