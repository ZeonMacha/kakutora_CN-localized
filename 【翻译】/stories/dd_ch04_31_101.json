{
    "dir": "chap31/daydra/dd_ch04_31_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "31402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "不可視可視の問題＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "不可见与可见的问题＜前篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "不可視可視の問題",
            "zh": "不可见与可见的问题",
            "narrator_zh": ""
        },
        {
            "location": "29/TALK",
            "narrator": "みやび",
            "text": "エヴェレット脳科学研究所\nJapanSite。",
            "zh": "エヴェレット脳科学研究所\nJapanSite。",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "みやび",
            "text": "洞窟の中に隠された\nエリカさんのためだけの\n研究所。",
            "zh": "藏在洞窟里的\n只属于领火一人的\n研究所。",
            "narrator_zh": "雅"
        },
        {
            "location": "31/TALK",
            "narrator": "みやび",
            "text": "わざわざ松代にそれを\n構えた理由がアーヤとは\nなんという姉妹愛。",
            "zh": "特意在松代建起它的理由\n居然是绫水，\n这得是何等的姐妹情啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "…妹としては無断で\n生体認証キーにされたんは\n不服やろうけんど。",
            "zh": "…不过身为妹妹，\n没经同意就被当成\n生物认证钥匙，肯定不服吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "うちの大ざっぱな\n説明であっさり精神世界に\nダイブしたし。",
            "zh": "经我随便几句\n粗略说明，就爽快潜入\n精神世界了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "音羽のココロアドレスも\nあっさりゲット。",
            "zh": "音羽的心之地址\n也轻松到手了。",
            "narrator_zh": "雅"
        },
        {
            "location": "36/TALK",
            "narrator": "みやび",
            "text": "姉妹だけに通じる\n勘所みたいなのが\nあるんかねえ。",
            "zh": "难道姐妹之间\n真有什么\n心照不宣的窍门咩。",
            "narrator_zh": "雅"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "…それにしても…。",
            "zh": "…话说回来…。",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "みやび",
            "text": "アーヤも\nガブちゃんも\n目を覚ましませんね。",
            "zh": "绫水和\n加布都\n还没醒呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんも\nわざわざ追いかけて\nダイブせんでも。",
            "zh": "加布也\n用不着特意追过去\n潜入吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "アーヤが目覚めるまで\n待っちょったらえいのに。",
            "zh": "等绫水醒来\n不就好了嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "音羽修復に必要な\n情報はもう\n受け取ったんやし。",
            "zh": "修复音羽需要的\n信息都已经\n拿到手了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "46/TALK",
            "narrator": "真幌",
            "text": "…そういうみやびも\n今回は随分心配して\nいたようだが。",
            "zh": "…说这话的雅，\n这次倒是也\n相当担心的样子。",
            "narrator_zh": "真幌"
        },
        {
            "location": "47/TALK",
            "narrator": "真幌",
            "text": "ギャヴィが続けて\n精神世界にダイブすると\n言い出した時には。",
            "zh": "加维说\n要接连潜入精神世界的\n时候啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "48/TALK",
            "narrator": "みやび",
            "text": "…心配というか\n不安ながですよ。",
            "zh": "…与其说是担心，\n不如说是不安。",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "真幌",
            "text": "不安？",
            "zh": "不安？",
            "narrator_zh": "真幌"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "フェノメノンには\n嫌な思い出が\nありますき。",
            "zh": "关于PhenoMENON，\n我有过不愉快的\n回忆啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "51/TALK",
            "narrator": "真幌",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "まほさんはうちの\n調書を見たことが\nありますよね。",
            "zh": "真幌看过\n我的调查档案\n对吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "真幌",
            "text": "…ああ。",
            "zh": "…嗯。",
            "narrator_zh": "真幌"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "やったら\n知ってますよね。",
            "zh": "那就\n知道了吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "うちの妹が\nフェノメノンで\nのうなったことも。",
            "zh": "包括我妹妹\n死在PhenoMENON里的\n那件事。",
            "narrator_zh": "雅"
        },
        {
            "location": "60/TALK",
            "narrator": "真幌",
            "text": "…気の毒だったな。",
            "zh": "…那真是不幸。",
            "narrator_zh": "真幌"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "もう過ぎたことですき。",
            "zh": "都是过去的事了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "けんど、さっきは\nその時のことと\n重なったんです。",
            "zh": "但是刚才，\n和那时候的事\n重叠到一起了。",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "…あれでも気持ちは\n抑えたつもりです。",
            "zh": "…即便那样，\n我也自认忍住了。",
            "narrator_zh": "雅"
        },
        {
            "location": "69/SEL",
            "narrator": "",
            "text": "大丈夫だよ",
            "zh": "没事的哦",
            "narrator_zh": ""
        },
        {
            "location": "70/ACT",
            "narrator": "",
            "text": "大丈夫だよ",
            "zh": "没事的哦",
            "narrator_zh": ""
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "そんなこと",
            "zh": "那种话",
            "narrator_zh": "雅"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "言い切れるのか？",
            "zh": "能打包票咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "82/SEL",
            "narrator": "",
            "text": "$me$がガブリエラについとくから",
            "zh": "$me$会照看加布里埃拉的",
            "narrator_zh": ""
        },
        {
            "location": "83/SEL",
            "narrator": "",
            "text": "みやびが完璧にフォローするから",
            "zh": "雅会完美兜底的",
            "narrator_zh": ""
        },
        {
            "location": "84/SEL",
            "narrator": "",
            "text": "ガブリエラの生命力は半端ないから",
            "zh": "加布里埃拉的生命力可不是盖的",
            "narrator_zh": ""
        },
        {
            "location": "85/ACT",
            "narrator": "",
            "text": "$me$がガブリエラについとくから",
            "zh": "$me$会照看加布里埃拉的",
            "narrator_zh": ""
        },
        {
            "location": "86/TALK",
            "narrator": "みやび",
            "text": "絶対だぞ",
            "zh": "绝对的啵",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "絶対に守らんと",
            "zh": "绝对得护住她",
            "narrator_zh": "雅"
        },
        {
            "location": "88/ACT",
            "narrator": "",
            "text": "みやびが完璧にフォローするから",
            "zh": "雅会完美兜底的",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "そのつもりはあるが",
            "zh": "我倒是有这个打算",
            "narrator_zh": "雅"
        },
        {
            "location": "92/ACT",
            "narrator": "",
            "text": "ガブリエラの生命力は半端ないから",
            "zh": "加布里埃拉的生命力可不是盖的",
            "narrator_zh": ""
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "どんな理屈だ",
            "zh": "这算哪门子逻辑啊",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "そう思えば気が楽だが",
            "zh": "不过这么想倒是轻松",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "みやび",
            "text": "…そっちのモニターは\nどうですか？",
            "zh": "…那边的监视器\n怎么样了？",
            "narrator_zh": "雅"
        },
        {
            "location": "103/TALK",
            "narrator": "真幌",
            "text": "今のところは\n正常値だ。",
            "zh": "目前都是\n正常值。",
            "narrator_zh": "真幌"
        },
        {
            "location": "104/TALK",
            "narrator": "真幌",
            "text": "みやびは？",
            "zh": "雅呢？",
            "narrator_zh": "真幌"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "音羽のアドレスから\nその先のクランの\nアドレスを割出してます。",
            "zh": "我正从音羽的地址\n往下追查库兰的\n地址。",
            "narrator_zh": "雅"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "見事にバラバラに\nされてますけんど…。",
            "zh": "不过它们被拆得\n七零八落…。",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "一通り割出せたら\n修復に入ります。",
            "zh": "等大致追查完，\n就开始修复。",
            "narrator_zh": "雅"
        },
        {
            "location": "108/SEL",
            "narrator": "",
            "text": "あ、そうだ",
            "zh": "啊，对了",
            "narrator_zh": ""
        },
        {
            "location": "109/ACT",
            "narrator": "",
            "text": "あ、そうだ",
            "zh": "啊，对了",
            "narrator_zh": ""
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "どういた？",
            "zh": "怎么啦？",
            "narrator_zh": "雅"
        },
        {
            "location": "122/SEL",
            "narrator": "",
            "text": "$me$も手伝うね",
            "zh": "$me$也来帮忙",
            "narrator_zh": ""
        },
        {
            "location": "123/SEL",
            "narrator": "",
            "text": "うっかりしてた",
            "zh": "刚才走神了",
            "narrator_zh": ""
        },
        {
            "location": "124/SEL",
            "narrator": "",
            "text": "ちょっとした魔法がある",
            "zh": "我略懂一点魔法",
            "narrator_zh": ""
        },
        {
            "location": "125/ACT",
            "narrator": "",
            "text": "$me$も手伝うね",
            "zh": "$me$也来帮忙",
            "narrator_zh": ""
        },
        {
            "location": "126/TALK",
            "narrator": "みやび",
            "text": "猫の手か",
            "zh": "猫的手吗",
            "narrator_zh": "雅"
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "借りておこう",
            "zh": "那就借了",
            "narrator_zh": "雅"
        },
        {
            "location": "128/ACT",
            "narrator": "",
            "text": "うっかりしてた",
            "zh": "刚才走神了",
            "narrator_zh": ""
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "ドジっ子か",
            "zh": "冒失鬼吗",
            "narrator_zh": "雅"
        },
        {
            "location": "130/TALK",
            "narrator": "みやび",
            "text": "もうブームは下火",
            "zh": "这风潮早就过气了",
            "narrator_zh": "雅"
        },
        {
            "location": "131/ACT",
            "narrator": "",
            "text": "ちょっとした魔法がある",
            "zh": "我略懂一点魔法",
            "narrator_zh": ""
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "高度に発達した科学はというやつか",
            "zh": "所谓「高度发达的科学」就是这回事吗",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "期待しよう",
            "zh": "那就期待一下吧",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "$handle$め\n意味深なことを…。",
            "zh": "$handle$这家伙\n净说些意味深长的话…。",
            "narrator_zh": "雅"
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "何をする\nつもりぞね…。",
            "zh": "打算做什么\n咧…。",
            "narrator_zh": "雅"
        },
        {
            "location": "141/TALK",
            "narrator": "音羽",
            "text": "誰かいますか？",
            "zh": "有人吗？",
            "narrator_zh": "音羽"
        },
        {
            "location": "145/TALK",
            "narrator": "みやび",
            "text": "は！？",
            "zh": "哈！？",
            "narrator_zh": "雅"
        },
        {
            "location": "146/TALK",
            "narrator": "真幌",
            "text": "どうした？",
            "zh": "怎么了？",
            "narrator_zh": "真幌"
        },
        {
            "location": "147/TALK",
            "narrator": "みやび",
            "text": "どうしたも\nこうしたも。",
            "zh": "哪有什么\n怎么不怎么的。",
            "narrator_zh": "雅"
        },
        {
            "location": "150/TALK",
            "narrator": "みやび",
            "text": "ご本人から\n連絡が来たよう\nですよ…！",
            "zh": "本人那边\n似乎发来了\n联络…！",
            "narrator_zh": "雅"
        },
        {
            "location": "182/TALK",
            "narrator": "みやびの新司書",
            "text": "ふむ。\n来よったね。",
            "zh": "嗯。\n来了咯。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "183/TALK",
            "narrator": "みやびの新司書",
            "text": "けんど、今回はもう\n葛藤の解決はナシや。",
            "zh": "但是这次，\n纠葛的化解就免了。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "184/TALK",
            "narrator": "みやびの新司書",
            "text": "早速なごちゃんの所へ\n向かう。",
            "zh": "这就出发\n去七五的房间。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "185/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "好",
            "narrator_zh": ""
        },
        {
            "location": "186/SEL",
            "narrator": "",
            "text": "シンギュラリティは？",
            "zh": "奇点呢？",
            "narrator_zh": ""
        },
        {
            "location": "187/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "好",
            "narrator_zh": ""
        },
        {
            "location": "189/ACT",
            "narrator": "",
            "text": "シンギュラリティは？",
            "zh": "奇点呢？",
            "narrator_zh": ""
        },
        {
            "location": "190/TALK",
            "narrator": "みやびの新司書",
            "text": "慰霊祭が終わったら\n処遇について検討する。",
            "zh": "慰灵祭结束后\n再研究她的处置。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "191/TALK",
            "narrator": "みやびの新司書",
            "text": "いくぞね。",
            "zh": "走了咧。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "193/TALK",
            "narrator": "みやびの新司書",
            "text": "オープンプロセス、\n0x59A番地から\nC4:9:36F//1x0FF番地へ。",
            "zh": "开放进程，\n从0x59A地址\n跳到C4:9:36F//1x0FF地址。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "198/TALK",
            "narrator": "みやびの新司書",
            "text": "２倍速…",
            "zh": "２倍速…",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "202/TALK",
            "narrator": "みやびの新司書",
            "text": "４倍速…",
            "zh": "４倍速…",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "222/TALK",
            "narrator": "みやびの新司書",
            "text": "これからなごちゃんと\nご対面ちゅうことに\nなるわけやけんど。",
            "zh": "接下来呢，\n就要和七五\n见面了咯。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "223/TALK",
            "narrator": "みやびの新司書",
            "text": "うちのセルフクラン様やき\n粗相のないように。",
            "zh": "那可是我的自身库兰大人，\n可别失礼了啵。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "224/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "好",
            "narrator_zh": ""
        },
        {
            "location": "225/SEL",
            "narrator": "",
            "text": "慰霊祭って具体的には何をするの？",
            "zh": "慰灵祭具体都做些什么？",
            "narrator_zh": ""
        },
        {
            "location": "226/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "好",
            "narrator_zh": ""
        },
        {
            "location": "227/TALK",
            "narrator": "みやびの新司書",
            "text": "うむ。\nほんだら行くか。",
            "zh": "嗯。\n那就走吧。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "228/TALK",
            "narrator": "みやびの新司書",
            "text": "なごちゃんの\n部屋の暗号を解除するき、\nちくっと待ちや。",
            "zh": "我来解除七五\n房间的暗号，\n先等子。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "229/ACT",
            "narrator": "",
            "text": "慰霊祭って具体的には何をするの？",
            "zh": "慰灵祭具体都做些什么？",
            "narrator_zh": ""
        },
        {
            "location": "231/TALK",
            "narrator": "みやびの新司書",
            "text": "なごちゃんの\n願いが成就するための\n手助けする。",
            "zh": "为七五的\n愿望得以实现\n提供帮助。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "232/TALK",
            "narrator": "みやびの新司書",
            "text": "その際にお前さんの\n力があると、非常に\n効率が良いのでな。",
            "zh": "这当中若有你的力量，\n效率会\n非常高。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "233/TALK",
            "narrator": "みやびの新司書",
            "text": "そんなわけで、前回\nうちは非常に悩んだ。",
            "zh": "所以上一次，\n我非常苦恼。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "234/TALK",
            "narrator": "みやびの新司書",
            "text": "正直、うちとなごちゃん\nだけいれば、それで\n全く問題無い。",
            "zh": "说实话，只要有\n我和七五在，\n就完全没有问题。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "235/TALK",
            "narrator": "みやびの新司書",
            "text": "けんど、なごちゃんの\n願いを叶えてあげることは\nうちだけでは難しい。",
            "zh": "但是要帮七五\n实现愿望，\n光靠我很难办到。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "236/TALK",
            "narrator": "みやびの新司書",
            "text": "やき、お前さんが諦めたら\nそこで終わり。諦めん\nかったら条件を出す――",
            "zh": "所以你若放弃，\n就到此为止。不放弃的话，\n我就开出条件——",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "237/TALK",
            "narrator": "みやびの新司書",
            "text": "そう決めちょったぞね。",
            "zh": "本就是这么决定的咧。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "238/SEL",
            "narrator": "",
            "text": "なごちゃんの夢ってなに？",
            "zh": "七五的梦想是什么？",
            "narrator_zh": ""
        },
        {
            "location": "239/ACT",
            "narrator": "",
            "text": "なごちゃんの夢ってなに？",
            "zh": "七五的梦想是什么？",
            "narrator_zh": ""
        },
        {
            "location": "241/TALK",
            "narrator": "みやびの新司書",
            "text": "昇華ぞね。",
            "zh": "升华咧。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "242/TALK",
            "narrator": "みやびの新司書",
            "text": "今以上に洗練された\nうちになる。",
            "zh": "成为比现在\n更精炼的我。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "243/TALK",
            "narrator": "みやびの新司書",
            "text": "その為の\n大事なプロセスやき。",
            "zh": "是为此\n不可或缺的进程啵。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "244/SEL",
            "narrator": "",
            "text": "昇華するとどうなるの？",
            "zh": "升华之后会怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "245/ACT",
            "narrator": "",
            "text": "昇華するとどうなるの？",
            "zh": "升华之后会怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "247/TALK",
            "narrator": "みやびの新司書",
            "text": "さあね。\nうちにはわからん。",
            "zh": "谁知道呢。\n我不知道啊。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "248/TALK",
            "narrator": "みやびの新司書",
            "text": "いずれにせよ、\nお前さんに\n拒否権は無いよ。",
            "zh": "不管怎样，\n你没有\n否决权。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "249/TALK",
            "narrator": "みやびの新司書",
            "text": "拒否するなら追い出す。\nそれだけや。",
            "zh": "要拒绝就赶出去。\n仅此而已。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "250/SEL",
            "narrator": "",
            "text": "手伝う",
            "zh": "帮忙",
            "narrator_zh": ""
        },
        {
            "location": "251/SEL",
            "narrator": "",
            "text": "それでも拒否する",
            "zh": "即便如此还是拒绝",
            "narrator_zh": ""
        },
        {
            "location": "252/ACT",
            "narrator": "",
            "text": "手伝う",
            "zh": "帮忙",
            "narrator_zh": ""
        },
        {
            "location": "253/TALK",
            "narrator": "みやびの新司書",
            "text": "うむ。\nえい心がけやね。",
            "zh": "嗯。\n心性不错咯。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "254/TALK",
            "narrator": "みやびの新司書",
            "text": "ほんだら、なごちゃんの\n部屋の暗号を解除するき、\nちくっと待ちや。",
            "zh": "那就，我来解除七五\n房间的暗号，\n先等子。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "255/ACT",
            "narrator": "",
            "text": "それでも拒否する",
            "zh": "即便如此还是拒绝",
            "narrator_zh": ""
        },
        {
            "location": "256/TALK",
            "narrator": "みやびの新司書",
            "text": "ふむ、そうか。\nほんだら、さよなら。",
            "zh": "嗯，是嘛。\n那就，再见。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "267/TALK",
            "narrator": "みやびの新司書",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "268/TALK",
            "narrator": "みやびの新司書",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "272/TALK",
            "narrator": "シンギュラリティ",
            "text": "相棒！！元気か！",
            "zh": "搭档！！还好吗！",
            "narrator_zh": "奇点"
        },
        {
            "location": "273/SEL",
            "narrator": "",
            "text": "シンギュラリティ！？",
            "zh": "シンギュラリティ！？",
            "narrator_zh": ""
        },
        {
            "location": "274/ACT",
            "narrator": "",
            "text": "シンギュラリティ！？",
            "zh": "シンギュラリティ！？",
            "narrator_zh": ""
        },
        {
            "location": "276/TALK",
            "narrator": "シンギュラリティ",
            "text": "反応するな",
            "zh": "先别回应",
            "narrator_zh": "奇点"
        },
        {
            "location": "277/TALK",
            "narrator": "シンギュラリティ",
            "text": "今この気づかれないうちに用件を話す",
            "zh": "趁现在还没被察觉，先把正事说完",
            "narrator_zh": "奇点"
        },
        {
            "location": "278/TALK",
            "narrator": "シンギュラリティ",
            "text": "なごちゃんの昇華はしたらいかん",
            "zh": "七五的升华做不得",
            "narrator_zh": "奇点"
        },
        {
            "location": "279/TALK",
            "narrator": "シンギュラリティ",
            "text": "うちが全力で止めちゃるけんど、あいにくとある場所に閉じこめられちゅう",
            "zh": "我会全力去拦，可不巧我被关在某个地方出不去",
            "narrator_zh": "奇点"
        },
        {
            "location": "280/TALK",
            "narrator": "シンギュラリティ",
            "text": "そこでお前さんに、うちが脱出出来る奥の手コマンドを実行してもらいたい",
            "zh": "所以想请你执行那条让我脱困的绝招指令",
            "narrator_zh": "奇点"
        },
        {
            "location": "282/TALK",
            "narrator": "シンギュラリティ",
            "text": "まだ使うな",
            "zh": "先别用",
            "narrator_zh": "奇点"
        },
        {
            "location": "283/TALK",
            "narrator": "シンギュラリティ",
            "text": "なごちゃんの場所に到達した後、あやつが油断した時を狙え",
            "zh": "抵达七五那边后，趁那家伙大意时再动手",
            "narrator_zh": "奇点"
        },
        {
            "location": "284/TALK",
            "narrator": "シンギュラリティ",
            "text": "健闘を祈る",
            "zh": "祝你奋战顺利",
            "narrator_zh": "奇点"
        },
        {
            "location": "286/TALK",
            "narrator": "みやびの新司書",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "287/TALK",
            "narrator": "みやびの新司書",
            "text": "…完了。",
            "zh": "…完了。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "288/TALK",
            "narrator": "みやびの新司書",
            "text": "ほな、いこか。",
            "zh": "那就，走吧啵。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "306/TALK",
            "narrator": "なご",
            "text": "四十九夜…。\nまた来てくれたのね。",
            "zh": "四十九夜…。\n你又来看我了。",
            "narrator_zh": "七五"
        },
        {
            "location": "307/TALK",
            "narrator": "四十九夜",
            "text": "もちろんや。\nうちはいつだって\nなごちゃんの傍にいる。",
            "zh": "当然咯。\n我永远都\n陪在七五身边。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "308/SEL",
            "narrator": "",
            "text": "四十九夜って名前だったんだ",
            "zh": "原来你叫四十九夜啊",
            "narrator_zh": ""
        },
        {
            "location": "309/SEL",
            "narrator": "",
            "text": "なごちゃんって初めて見たけどかわいいね",
            "zh": "第一次见到七五，好可爱啊",
            "narrator_zh": ""
        },
        {
            "location": "310/ACT",
            "narrator": "",
            "text": "四十九夜って名前だったんだ",
            "zh": "原来你叫四十九夜啊",
            "narrator_zh": ""
        },
        {
            "location": "312/TALK",
            "narrator": "四十九夜",
            "text": "うむ。\n別にどうでもえい\nことぞね。",
            "zh": "嗯。\n名字什么的\n无所谓咧。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "313/ACT",
            "narrator": "",
            "text": "なごちゃんって初めて見たけどかわいいね",
            "zh": "第一次见到七五，好可爱啊",
            "narrator_zh": ""
        },
        {
            "location": "316/TALK",
            "narrator": "四十九夜",
            "text": "当たり前や。\nうちの妹やぞ。",
            "zh": "那是当然。\n这可是我妹妹啵。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "317/TALK",
            "narrator": "四十九夜",
            "text": "…まあ、正確には\nホンモノやないけんどな。",
            "zh": "…嘛，准确来说\n不是真的妹妹就是了。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "318/TALK",
            "narrator": "四十九夜",
            "text": "ただ単に、なごちゃんが\nうちの心の大きな部分を\n占めちゅうだけや。",
            "zh": "只不过是七五\n占了我心里\n很大一块而已。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "321/TALK",
            "narrator": "四十九夜",
            "text": "なごちゃん、今日は\nなごちゃんにえい話が\nあるぞね。",
            "zh": "七五，今天\n有件好事\n要告诉你咧。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "322/TALK",
            "narrator": "四十九夜",
            "text": "$handle$が、\nなごちゃんに力を貸して\nくれることになったちや。",
            "zh": "$handle$呢，\n决定帮七五一把\n了滴。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "323/TALK",
            "narrator": "なご",
            "text": "ほんと？\n嬉しい…",
            "zh": "真的？\n好高兴…",
            "narrator_zh": "七五"
        },
        {
            "location": "324/TALK",
            "narrator": "なご",
            "text": "なごはもう、\nこのままでは\nいられないぞね。",
            "zh": "七五已经，\n再这样下去\n就待不住了咧。",
            "narrator_zh": "七五"
        },
        {
            "location": "325/TALK",
            "narrator": "なご",
            "text": "やき、昇華は絶対に\n必要なん……。",
            "zh": "所以，升华\n是绝对必要的……",
            "narrator_zh": "七五"
        },
        {
            "location": "326/TALK",
            "narrator": "四十九夜",
            "text": "うむうむ、\nわかっちゅうよ。",
            "zh": "嗯嗯，\n懂的懂的。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "327/TALK",
            "narrator": "四十九夜",
            "text": "今、$handle$に\n実行させるき。",
            "zh": "这就让$handle$\n来执行啵。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "328/TALK",
            "narrator": "四十九夜",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "330/SEL",
            "narrator": "",
            "text": "EXEC_DEVELOP_READY::NAGO/.",
            "zh": "EXEC_DEVELOP_READY::NAGO/.",
            "narrator_zh": ""
        },
        {
            "location": "331/SEL",
            "narrator": "",
            "text": "EXEC_DEVELOP::\nSINGULARITY/.",
            "zh": "EXEC_DEVELOP::\nSINGULARITY/.",
            "narrator_zh": ""
        },
        {
            "location": "333/TALK",
            "narrator": "四十九夜",
            "text": "そのコマンドを\n押すだけの簡単な仕事や。",
            "zh": "只需按下那条指令，\n轻松的活儿。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "334/TALK",
            "narrator": "四十九夜",
            "text": "まあ、そのコマンドしか\n無いき、間違うことなぞ\nあり得ないと思うけんど。",
            "zh": "嘛，反正指令就那一条，\n想弄错都\n不可能咧。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "336/TALK",
            "narrator": "四十九夜",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "337/TALK",
            "narrator": "四十九夜",
            "text": "押したか？",
            "zh": "按了没？",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "338/SEL",
            "narrator": "",
            "text": "押したよ",
            "zh": "按了哦",
            "narrator_zh": ""
        },
        {
            "location": "339/ACT",
            "narrator": "",
            "text": "押したよ",
            "zh": "按了哦",
            "narrator_zh": ""
        },
        {
            "location": "342/TALK",
            "narrator": "四十九夜",
            "text": "はて。\n何故に何も起こらん？",
            "zh": "奇怪。\n怎么毫无动静？",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "343/TALK",
            "narrator": "なご",
            "text": "どうしたん？\n四十九夜…？",
            "zh": "怎么了？\n四十九夜…？",
            "narrator_zh": "七五"
        },
        {
            "location": "344/TALK",
            "narrator": "四十九夜",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "345/SEL",
            "narrator": "",
            "text": "EXEC_DEVELOP::\nSINGULARITY/.　",
            "zh": "EXEC_DEVELOP::\nSINGULARITY/.　",
            "narrator_zh": ""
        },
        {
            "location": "346/TALK",
            "narrator": "四十九夜",
            "text": "おかしいね。\nプログラムはちゃんと\n実行されちゅう。",
            "zh": "怪了啊。\n程序明明\n正常运行着。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "347/TALK",
            "narrator": "四十九夜",
            "text": "けんど……",
            "zh": "但是……",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "348/TALK",
            "narrator": "四十九夜",
            "text": "データ伝送経路が\n未接続……？",
            "zh": "数据传输路径\n未连接……？",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "349/ACT",
            "narrator": "",
            "text": "EXEC_DEVELOP::\nSINGULARITY/.　 ",
            "zh": "EXEC_DEVELOP::\nSINGULARITY/.　 ",
            "narrator_zh": ""
        },
        {
            "location": "359/TALK",
            "narrator": "四十九夜",
            "text": "お、上手く――",
            "zh": "哦，顺利——",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "360/TALK",
            "narrator": "四十九夜",
            "text": "んん！？",
            "zh": "嗯嗯！？",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "365/TALK",
            "narrator": "四十九夜",
            "text": "…！？",
            "zh": "…！？",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "366/TALK",
            "narrator": "なご",
            "text": "なに？\nどうしたん？",
            "zh": "怎么？\n出什么事了？",
            "narrator_zh": "七五"
        },
        {
            "location": "372/TALK",
            "narrator": "四十九夜",
            "text": "いかん！\nなごちゃん隠れや！",
            "zh": "不好！\n七五快躲起来！",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "373/TALK",
            "narrator": "なご",
            "text": "…うん。",
            "zh": "…嗯。",
            "narrator_zh": "七五"
        },
        {
            "location": "382/TALK",
            "narrator": "四十九夜",
            "text": "$handle$、\n今何かしたろう！？",
            "zh": "$handle$，\n你刚才做了什么吧！？",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "383/SEL",
            "narrator": "",
            "text": "まあね",
            "zh": "算是吧",
            "narrator_zh": ""
        },
        {
            "location": "384/ACT",
            "narrator": "",
            "text": "まあね",
            "zh": "算是吧",
            "narrator_zh": ""
        },
        {
            "location": "387/TALK",
            "narrator": "四十九夜",
            "text": "余計なことを…！",
            "zh": "多管闲事…！",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "399/TALK",
            "narrator": "シンギュラリティ　",
            "text": "待たせたね、相棒！",
            "zh": "让你久等了，搭档！",
            "narrator_zh": "奇点"
        },
        {
            "location": "400/SEL",
            "narrator": "",
            "text": "シンギュラリティ！\n無事で良かった！",
            "zh": "奇点！\n没事就好！",
            "narrator_zh": ""
        },
        {
            "location": "401/ACT",
            "narrator": "",
            "text": "シンギュラリティ！\n無事で良かった！",
            "zh": "奇点！\n没事就好！",
            "narrator_zh": ""
        },
        {
            "location": "403/TALK",
            "narrator": "四十九夜",
            "text": "…何故出てこれた。",
            "zh": "…你怎么出来的。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "404/TALK",
            "narrator": "シンギュラリティ　",
            "text": "答えはひとつ。\n判っちゅうはずや。",
            "zh": "答案只有一个。\n你本该明白的咯。",
            "narrator_zh": "奇点"
        },
        {
            "location": "405/TALK",
            "narrator": "四十九夜",
            "text": "まさか……\n人格のタガを\n外したのか！？",
            "zh": "难不成……\n你把人格的\n箍环给卸了！？",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "406/TALK",
            "narrator": "シンギュラリティ　",
            "text": "ご名答。\n相棒、ありがとな。",
            "zh": "答对了。\n搭档，谢啦。",
            "narrator_zh": "奇点"
        },
        {
            "location": "407/SEL",
            "narrator": "",
            "text": "なに？　どういうこと？",
            "zh": "什么？　怎么回事？",
            "narrator_zh": ""
        },
        {
            "location": "408/ACT",
            "narrator": "",
            "text": "なに？　どういうこと？",
            "zh": "什么？　怎么回事？",
            "narrator_zh": ""
        },
        {
            "location": "410/TALK",
            "narrator": "四十九夜",
            "text": "正気か！？\n自らタガを\n外させるなぞ……。",
            "zh": "你清醒吗！？\n居然主动让人卸掉\n人格的箍环……。",
            "narrator_zh": "四十九夜"
        },
        {
            "location": "411/TALK",
            "narrator": "シンギュラリティ　",
            "text": "その言葉を言う権利は\nお前さんにはないよ、\n四十九夜。",
            "zh": "说这话的权利，\n轮不到你，\n四十九夜。",
            "narrator_zh": "奇点"
        },
        {
            "location": "412/TALK",
            "narrator": "シンギュラリティ　",
            "text": "お前さんがなごちゃんに\n仕掛けてるのは、まさに\nそれと同じこと。",
            "zh": "你对七五下的手，\n正是\n一模一样的事。",
            "narrator_zh": "奇点"
        },
        {
            "location": "413/SEL",
            "narrator": "",
            "text": "だから、何なの！？",
            "zh": "所以，到底是什么！？",
            "narrator_zh": ""
        },
        {
            "location": "414/ACT",
            "narrator": "",
            "text": "だから、何なの！？",
            "zh": "所以，到底是什么！？",
            "narrator_zh": ""
        },
        {
            "location": "416/TALK",
            "narrator": "シンギュラリティ　",
            "text": "こうゆうことやよ！",
            "zh": "就是这么回事咯！",
            "narrator_zh": "奇点"
        },
        {
            "location": "425/SEL",
            "narrator": "",
            "text": "え！？",
            "zh": "诶！？",
            "narrator_zh": ""
        },
        {
            "location": "426/ACT",
            "narrator": "",
            "text": "え！？",
            "zh": "诶！？",
            "narrator_zh": ""
        },
        {
            "location": "428/TALK",
            "narrator": "昇華シンギュラリティ",
            "text": "どうや、相棒。\nカッコえいか？",
            "zh": "怎么样，搭档。\n帅不帅？",
            "narrator_zh": "升华奇点"
        },
