        "title": "SideStory010 ストーリー",
        "sub_title": "FILE08.責任",
        "title_zh": "SideStory010 剧情",
        "sub_title_zh": "FILE08.责任"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "東京編８話",
            "zh": "东京编８话",
            "narrator_zh": ""
        },
        {
            "location": "14/DIALOG",
            "narrator": "",
            "text": "<color=green>9月5日　 4:57 PM</color>\nとある平日の放課後、付属学園、図書室にて",
            "zh": "<color=green>9月5日　 4:57 PM</color>\n某个平日的放学后，附属学园，图书室",
            "narrator_zh": ""
        },
        {
            "location": "29/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "38/TALK",
            "narrator": "キリト",
            "text": "ふぁ～…、\nまだ帰んないのか？",
            "zh": "哈啊～……\n还不回去吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "40/TALK",
            "narrator": "繭",
            "text": "…気が向いたら帰る。\n帰りたいなら\n勝手に帰ればいい。",
            "zh": "……有心情再回去。\n想回去的话\n你自己回去就好。",
            "narrator_zh": "茧"
        },
        {
            "location": "41/TALK",
            "narrator": "キリト",
            "text": "冷たいこと言うなよ。\n一緒に帰ろうぜ？",
            "zh": "别说这么冷的话嘛。\n一起回去呗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "44/TALK",
            "narrator": "繭",
            "text": "…冷たいのは、\nキリトの方じゃない？",
            "zh": "……冷的那个，\n不是圣翔你吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "45/TALK",
            "narrator": "キリト",
            "text": "なんだよ、いきなり…。",
            "zh": "干嘛啊，突然……",
            "narrator_zh": "圣翔"
        },
        {
            "location": "46/TALK",
            "narrator": "繭",
            "text": "さっきの話。\nどうしてひなこに\n賛成しなかったの？",
            "zh": "刚才那件事。\n为什么不同意\n雏子？",
            "narrator_zh": "茧"
        },
        {
            "location": "47/TALK",
            "narrator": "繭",
            "text": "ひなこの性格からして、\n絶対にあのまま\n黙って引き下がらない。",
            "zh": "以雏子的性格来看，\n她绝对不肯\n就那样沉默退让。",
            "narrator_zh": "茧"
        },
        {
            "location": "48/TALK",
            "narrator": "繭",
            "text": "それがわからないほど、\n鈍くないはずだけど？",
            "zh": "你没那么迟钝，\n不至于看不出来吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "49/TALK",
            "narrator": "キリト",
            "text": "…まあな。",
            "zh": "……是吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "50/TALK",
            "narrator": "繭",
            "text": "…ひなこに、一人で\n行動させるつもり？",
            "zh": "……你打算让雏子\n一个人行动？",
            "narrator_zh": "茧"
        },
        {
            "location": "51/TALK",
            "narrator": "キリト",
            "text": "…そんなの、すぐには\n答えられねぇよ。",
            "zh": "……这种事，\n我没法马上回答啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "52/TALK",
            "narrator": "キリト",
            "text": "でも、本音を言えばさ、\n俺だってひなこに\n賛成したかったさ。",
            "zh": "不过说真心话，\n我也想赞成\n雏子的啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "53/TALK",
            "narrator": "キリト",
            "text": "逢瀬を助けることは\nできなくても…。",
            "zh": "就算帮不上\n逢濑……",
            "narrator_zh": "圣翔"
        },
        {
            "location": "54/TALK",
            "narrator": "キリト",
            "text": "綾水先輩達の助けになる\nようなことくらいは、\nあるかもしれないだろ？",
            "zh": "至少说不定有些事，\n能帮上\n绫水学姐她们吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "55/TALK",
            "narrator": "キリト",
            "text": "その方法だけでも\n見つけたいな、ってさ…。",
            "zh": "哪怕只是找到\n那样的办法也好……",
            "narrator_zh": "圣翔"
        },
        {
            "location": "56/TALK",
            "narrator": "繭",
            "text": "じゃあ、どうして\nひなこを手伝うって\n言わなかったの？",
            "zh": "那你为什么\n不说要帮\n雏子？",
            "narrator_zh": "茧"
        },
        {
            "location": "57/TALK",
            "narrator": "キリト",
            "text": "…もし俺がひなこを\n手伝うって言ったら、\nおまえはどうしてた？",
            "zh": "……如果我说\n要帮雏子，\n你会怎么做？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "58/TALK",
            "narrator": "繭",
            "text": "なにもしない。\n自殺行為には\n手を貸さない。",
            "zh": "什么都不做。\n自杀行为\n我不会帮。",
            "narrator_zh": "茧"
        },
        {
            "location": "59/TALK",
            "narrator": "キリト",
            "text": "なんて文句言いながら、\n絶対に手伝ってただろ？",
            "zh": "嘴上这么骂着，\n最后绝对还是会帮的吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "60/TALK",
            "narrator": "キリト",
            "text": "俺たちが劇場のバイトを\nするために、東雲教官に\n意見した時みたいにさ。",
            "zh": "就像我们为了\n在剧场打工、向东云\n教官提意见那次一样啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "61/TALK",
            "narrator": "繭",
            "text": "何をバカな…。",
            "zh": "说什么傻话……",
            "narrator_zh": "茧"
        },
        {
            "location": "62/TALK",
            "narrator": "繭",
            "text": "…待って。\n今の、どういうこと？",
            "zh": "……等下。\n刚才那话，什么意思？",
            "narrator_zh": "茧"
        },
        {
            "location": "63/TALK",
            "narrator": "キリト",
            "text": "は？",
            "zh": "哈？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "64/TALK",
            "narrator": "繭",
            "text": "キリトがひなこを\n手伝うって言わなかった\nことと…。",
            "zh": "圣翔不肯说要\n帮雏子\n这件事……",
            "narrator_zh": "茧"
        },
        {
            "location": "65/TALK",
            "narrator": "繭",
            "text": "私が手伝うかもしれない\nってこと…、\nなんの関係がある？",
            "zh": "和我可能会\n去帮忙……\n有什么关系？",
            "narrator_zh": "茧"
        },
        {
            "location": "66/TALK",
            "narrator": "キリト",
            "text": "…つまりさ。",
            "zh": "……就是说啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "67/TALK",
            "narrator": "キリト",
            "text": "俺は、繭を危険な目に\n合わせたくねぇ、って\nことだよ。",
            "zh": "我不想让茧\n置身危险，\n就是这么回事。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "68/TALK",
            "narrator": "繭",
            "text": "…………え？",
            "zh": "…………诶？",
            "narrator_zh": "茧"
        },
        {
            "location": "69/TALK",
            "narrator": "キリト",
            "text": "…わかるだろ？\n俺が言いたいこと…。",
            "zh": "……你懂的吧？\n我想说的……",
            "narrator_zh": "圣翔"
        },
        {
            "location": "70/TALK",
            "narrator": "繭",
            "text": "そ、それって…え！？\nまさか…。",
            "zh": "这、这是……诶！？\n难道……",
            "narrator_zh": "茧"
        },
        {
            "location": "71/TALK",
            "narrator": "キリト",
            "text": "…おまえはさ、\nどっちかっていうと\n頭脳派だろ？",
            "zh": "……你是那种，\n怎么说，偏头脑\n型的吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "72/TALK",
            "narrator": "キリト",
            "text": "小学生の頃から\n足だって超遅ぇし…。",
            "zh": "从小学生时候起，\n跑得就超慢……",
            "narrator_zh": "圣翔"
        },
        {
            "location": "73/TALK",
            "narrator": "キリト",
            "text": "だから、もしもの時\nすぐ捕まっちまいそうで\n心配なんだよ。",
            "zh": "所以万一出事，\n感觉你会立刻被抓，\n我很担心啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "74/TALK",
            "narrator": "繭",
            "text": "ふっ！",
            "zh": "噗！",
            "narrator_zh": "茧"
        },
        {
            "location": "80/TALK",
            "narrator": "キリト",
            "text": "イッテェー！！\nけ、蹴ることねぇだろ！？",
            "zh": "好痛！！\n用、用不着踢吧！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "81/TALK",
            "narrator": "繭",
            "text": "自業自得よ！",
            "zh": "自作自受！",
            "narrator_zh": "茧"
        },
        {
            "location": "82/TALK",
            "narrator": "繭",
            "text": "黙って聞いてれば、\n人のこと好き勝手\n言いまくって…。",
            "zh": "让你老实听着，\n就对人\n乱说一气……",
            "narrator_zh": "茧"
        },
        {
            "location": "83/TALK",
            "narrator": "キリト",
            "text": "はは、悪かったって。\n足が遅ぇってのは\n事実だけど言い過ぎた。",
            "zh": "哈哈，是我不对啦。\n说你跑得慢\n是事实，但说过头了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "84/TALK",
            "narrator": "繭",
            "text": "まだ言うか！！",
            "zh": "还敢说！！",
            "narrator_zh": "茧"
        },
        {
            "location": "85/TALK",
            "narrator": "キリト",
            "text": "でもさ、俺までひなこを\n手伝うって言ったら、\nマジで協力してただろ？",
            "zh": "不过啊，要是连我\n也说帮雏子，\n你真的会来帮忙吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "86/TALK",
            "narrator": "繭",
            "text": "そ、それは…。",
            "zh": "这、这个……",
            "narrator_zh": "茧"
        },
        {
            "location": "87/TALK",
            "narrator": "キリト",
            "text": "…真面目な話さ、\n俺、おまえの幼馴染\nなんだぜ？",
            "zh": "……认真说啊，\n我可是你的发小，\n知道吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "88/TALK",
            "narrator": "キリト",
            "text": "繭がなに考えて\nどう動くかくらい、\n簡単に予想できるさ。",
            "zh": "茧你在想什么、\n会怎么动，\n我轻易就能猜到。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "90/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "91/TALK",
            "narrator": "キリト",
            "text": "…おまえはさ、俺にとって\n一番古い友達なんだ。",
            "zh": "……对我来说，\n你是交情最深的老朋友。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "92/TALK",
            "narrator": "キリト",
            "text": "なのに、俺のワガママで\n危険な目に合わせるのは\n嫌なんだよ。",
            "zh": "所以让我用任性\n把你卷进危险，\n我可不干啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "94/TALK",
            "narrator": "繭",
            "text": "…私が、ひなこを手伝う\nっていう可能性は、\n考えなかったの？",
            "zh": "……我可能会\n去帮雏子这种\n可能性，你没想过？",
            "narrator_zh": "茧"
        },
        {
            "location": "95/TALK",
            "narrator": "キリト",
            "text": "ありえないな。",
            "zh": "不可能啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "96/TALK",
            "narrator": "キリト",
            "text": "ひなこ一人でできること\nなんて、たかが知れてる\nからな。",
            "zh": "雏子一个人能做的事，\n少得可怜\n啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "97/TALK",
            "narrator": "キリト",
            "text": "っていうか、なにすれば\nいいかもわからないと\n思うし…。",
            "zh": "再说，她多半\n也不知道\n该做什么……",
            "narrator_zh": "圣翔"
        },
        {
            "location": "98/TALK",
            "narrator": "キリト",
            "text": "放っておいた方が安全、\nって判断するんじゃね？",
            "zh": "你会判断放着不管\n比较安全吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "100/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "101/TALK",
            "narrator": "キリト",
            "text": "無言ってことは、\n正解だな。",
            "zh": "不说话就代表，\n我猜对了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "102/TALK",
            "narrator": "繭",
            "text": "…らしくない。",
            "zh": "……不像你。",
            "narrator_zh": "茧"
        },
        {
            "location": "103/TALK",
            "narrator": "キリト",
            "text": "は？",
            "zh": "哈？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "105/TALK",
            "narrator": "繭",
            "text": "今のがキリトの本音\nだったとしたら…、\nキリトらしくないわ。",
            "zh": "如果刚才那是\n圣翔的真心话……\n太不像你了。",
            "narrator_zh": "茧"
        },
        {
            "location": "106/TALK",
            "narrator": "繭",
            "text": "ひなこや逢瀬さん、\nみやび先輩達だって…。",
            "zh": "雏子也好、逢濑，\n雅学姐她们……",
            "narrator_zh": "茧"
        },
        {
            "location": "107/TALK",
            "narrator": "繭",
            "text": "キリトにとっては、\n大切な友達のはず\nなのに。",
            "zh": "对你来说，\n明明都该是\n重要的朋友。",
            "narrator_zh": "茧"
        },
        {
            "location": "108/TALK",
            "narrator": "繭",
            "text": "その人達のピンチを\n見過ごすなんて…、\nらしくなさ過ぎる…。",
            "zh": "却对她们的危机\n视而不见……\n太不像你了……",
            "narrator_zh": "茧"
        },
        {
            "location": "109/TALK",
            "narrator": "キリト",
            "text": "…そうか？",
            "zh": "……是吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "110/TALK",
            "narrator": "繭",
            "text": "そうよ…。\n本当は、何かしたいと\n思ってるんじゃない？",
            "zh": "是哦……\n其实你心里，\n也想做点什么吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "111/TALK",
            "narrator": "キリト",
            "text": "そりゃもちろん。",
            "zh": "那当然。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "112/TALK",
            "narrator": "繭",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "茧"
        },
        {
            "location": "113/TALK",
            "narrator": "キリト",
            "text": "ははっ、どうせ隠しても\n繭にはバレバレだろう\nからな。",
            "zh": "哈哈，反正就算藏，\n也会被茧\n看穿的。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "114/TALK",
            "narrator": "キリト",
            "text": "その通り…思ってるさ。\n逢瀬も綾水先輩達も\nひなこも助けたいって…。",
            "zh": "没错……我是这么想的。\n想救逢濑、绫水学姐\n她们，还有雏子……",
            "narrator_zh": "圣翔"
        },
        {
            "location": "115/TALK",
            "narrator": "キリト",
            "text": "…思ってるだけ、\nなんだけどな。",
            "zh": "……不过，\n也只是想想而已。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "116/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "121/TALK",
            "narrator": "キリト",
            "text": "ん、ちょい待ち。",
            "zh": "嗯，稍等。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "124/TALK",
            "narrator": "キリト",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "126/TALK",
            "narrator": "キリト",
            "text": "ワルい、ヒカルから\n呼び出しかかった。",
            "zh": "抱歉，光\n叫我过去了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "127/TALK",
            "narrator": "キリト",
            "text": "まだ残ってるだろ？\nちょっと行ってくるから、\n待っててくれな。",
            "zh": "你还会在这待着吧？\n我去去就来，\n等我一下啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "130/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "132/TALK",
            "narrator": "繭",
            "text": "これでいい…。\n誰も、危険な目には\n合わないんだから…。",
            "zh": "这样就好……。\n谁都不会\n陷入危险……",
            "narrator_zh": "茧"
        },
        {
            "location": "134/TALK",
            "narrator": "繭",
            "text": "なのに…、\nどうして迷うの？",
            "zh": "可是……\n为什么还在犹豫？",
            "narrator_zh": "茧"
        },
        {
            "location": "135/TALK",
            "narrator": "繭",
            "text": "キリトはこのまま、\nなにも行動せずに\nいるのが一番のはず…。",
            "zh": "圣翔就这样\n什么都不做，\n才该是最好的……",
            "narrator_zh": "茧"
        },
        {
            "location": "136/TALK",
            "narrator": "繭",
            "text": "でも…いずれきっと、\n今日のことを悔やんで\n苦しむ日が来るはず…。",
            "zh": "但是……将来总有一天，\n他一定会为今天的事\n后悔、痛苦……",
            "narrator_zh": "茧"
        },
        {
            "location": "137/TALK",
            "narrator": "繭",
            "text": "私の知ってるキリトなら、\n絶対に…。",
            "zh": "如果是我认识的\n那个圣翔，绝对会……",
            "narrator_zh": "茧"
        },
        {
            "location": "138/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "139/TALK",
            "narrator": "繭",
            "text": "わからない…。\nどうすることが\n正しいの？",
            "zh": "我不知道……\n怎么做\n才是对的？",
            "narrator_zh": "茧"
        },
        {
            "location": "151/TALK",
            "narrator": "みやび",
            "text": "はぁ…ことが済んだら、\n裏ロム携帯は取り上げに\nなるんやろうなぁ…。",
            "zh": "唉……等事情办完，\n这台作弊芯片手机多半\n要被收走咯……",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "みやび",
            "text": "苦労して手に入れた\nっちゅうに…、\nとほほ…。",
            "zh": "明明好不容易\n才弄到手……\n唉唉……",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "みやび",
            "text": "ん？　裏ロムの方に\nメール…うさぎか？",
            "zh": "嗯？作弊芯片那边\n有邮件……是兔子？",
            "narrator_zh": "雅"
        },
        {
            "location": "159/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "160/TALK",
            "narrator": "みやび",
            "text": "なんや、これ？",
            "zh": "驷马呀，这是？",
            "narrator_zh": "雅"
        },
        {
            "location": "161/TALK",
            "narrator": "みやび",
            "text": "慌ててる？\nあのうさぎが…？",
            "zh": "慌了？\n那只兔子……？",
            "narrator_zh": "雅"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "…どういうことや？",
            "zh": "……怎么回事咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "相棒",
            "zh": "搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "168/TALK",
            "narrator": "みやび",
            "text": "東京の様子はわかるか？",
            "zh": "东京那边的情况，你了解得到吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "170/SEL",
            "narrator": "（選択肢）",
            "text": "少しならね",
            "zh": "多少知道些",
            "narrator_zh": "（选项）"
        },
        {
            "location": "171/SEL",
            "narrator": "（選択肢）",
            "text": "どうかしたの？",
            "zh": "出什么事了？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "172/ACT",
            "narrator": "",
            "text": "少しならね",
            "zh": "多少知道些",
            "narrator_zh": ""
        },
        {
            "location": "173/ACT",
            "narrator": "",
            "text": "どうかしたの？",
            "zh": "出什么事了？",
            "narrator_zh": ""
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "うさぎからのメール",
            "zh": "兔子发来的邮件",
            "narrator_zh": "雅"
        },
        {
            "location": "176/TALK",
            "narrator": "みやび",
            "text": "内容が普通ではない",
            "zh": "内容很不寻常",
            "narrator_zh": "雅"
        },
        {
            "location": "177/TALK",
            "narrator": "みやび",
            "text": "『相談したいことがある。助けてほしい。自分では対処できない』",
            "zh": "『有事情想商量。希望得到帮助。自己应付不来』",
            "narrator_zh": "雅"
        },
        {
            "location": "178/TALK",
            "narrator": "みやび",
            "text": "いつものうさぎからは考えられぬ",
            "zh": "不是平时的兔子写得出的",
            "narrator_zh": "雅"
        },
        {
            "location": "179/TALK",
            "narrator": "みやび",
            "text": "切羽詰まった文章",
            "zh": "走投无路的文句",
            "narrator_zh": "雅"
        },
        {
            "location": "180/TALK",
            "narrator": "みやび",
            "text": "いつもならば",
            "zh": "换作平时",
            "narrator_zh": "雅"
        },
        {
            "location": "181/TALK",
            "narrator": "みやび",
            "text": "絶対に書かない",
            "zh": "绝对写不出来",
            "narrator_zh": "雅"
        },
        {
            "location": "183/SEL",
            "narrator": "（選択肢）",
            "text": "ちょっと落ち着いて",
            "zh": "先冷静一下",
            "narrator_zh": "（选项）"
        },
        {
            "location": "184/SEL",
            "narrator": "（選択肢）",
            "text": "無事なのは確かだ",
            "zh": "至少人是安全的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "185/ACT",
            "narrator": "",
            "text": "ちょっと落ち着いて",
            "zh": "先冷静一下",
            "narrator_zh": ""
        },
        {
            "location": "186/TALK",
            "narrator": "みやび",
            "text": "うちは冷静だ",
            "zh": "我很冷静。",
            "narrator_zh": "雅"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "冷静さを欠くなど",
            "zh": "失去冷静之类的，",
            "narrator_zh": "雅"
        },
        {
            "location": "188/TALK",
            "narrator": "みやび",
            "text": "愚行でしかない",
            "zh": "只会是蠢行。",
            "narrator_zh": "雅"
        },
        {
            "location": "189/TALK",
            "narrator": "みやび",
            "text": "なにが起きたのか",
            "zh": "到底出了什么事",
            "narrator_zh": "雅"
        },
        {
            "location": "190/ACT",
            "narrator": "",
            "text": "無事なのは確かだ",
            "zh": "至少人是安全的",
            "narrator_zh": ""
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "電話ではなくメール",
            "zh": "不是电话，是邮件。",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "相談という内容",
            "zh": "内容是商量事情。",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "この内容からして",
            "zh": "就这内容来看，",
            "narrator_zh": "雅"
        },
        {
            "location": "195/TALK",
            "narrator": "みやび",
            "text": "捕まったわけではないのだろう",
            "zh": "她应该没被抓走。",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "けんど",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "197/TALK",
            "narrator": "みやび",
            "text": "尋常ではないのは確かである",
            "zh": "非同寻常是确定的。",
            "narrator_zh": "雅"
        },
        {
            "location": "198/TALK",
            "narrator": "みやび",
            "text": "うさぎ達に何が起きたか",
            "zh": "兔子们到底出了什么事",
            "narrator_zh": "雅"
        },
        {
            "location": "200/TALK",
            "narrator": "みやび",
            "text": "それを知りたいのだ",
            "zh": "我想弄清这一点",
            "narrator_zh": "雅"
        },
        {
            "location": "202/SEL",
            "narrator": "（選択肢）",
            "text": "知って、なにができるの？",
            "zh": "知道了，又能怎样？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "203/SEL",
            "narrator": "（選択肢）",
            "text": "なら、電話してあげて",
            "zh": "那你倒是打电话啊",
            "narrator_zh": "（选项）"
        },
        {
            "location": "204/ACT",
            "narrator": "",
            "text": "知って、なにができるの？",
            "zh": "知道了，又能怎样？",
            "narrator_zh": ""
        },
        {
            "location": "206/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不。",
            "narrator_zh": "雅"
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "今は何もできぬ",
            "zh": "现在什么都做不了",
            "narrator_zh": "雅"
        },
        {
            "location": "209/TALK",
            "narrator": "みやび",
            "text": "連絡も出来なければ",
            "zh": "既无法联络，",
            "narrator_zh": "雅"
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "駆けつけることもできない",
            "zh": "也无法赶过去。",
            "narrator_zh": "雅"
        },
        {
            "location": "211/ACT",
            "narrator": "",
            "text": "なら、電話してあげて",
            "zh": "那你倒是打电话啊",
            "narrator_zh": ""
        },
        {
            "location": "212/TALK",
            "narrator": "みやび",
            "text": "それができないから聞いている！",
            "zh": "正因为做不到才问你！",
            "narrator_zh": "雅"
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不，",
            "narrator_zh": "雅"
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "そういうことか",
            "zh": "原来你是这个意思啊",
            "narrator_zh": "雅"
        },
        {
            "location": "217/TALK",
            "narrator": "みやび",
            "text": "今のうちは",
            "zh": "现在的我",
            "narrator_zh": "雅"
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "連絡も出来なければ",
            "zh": "既无法联络，",
            "narrator_zh": "雅"
        },
        {
            "location": "220/TALK",
            "narrator": "みやび",
            "text": "駆けつけることもできない",
            "zh": "也无法赶过去。",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "いかんな",
            "zh": "这样不行啊",
            "narrator_zh": "雅"
        },
        {
            "location": "224/TALK",
            "narrator": "みやび",
            "text": "慌てていたようだ",
            "zh": "我好像慌了神",
            "narrator_zh": "雅"
        },
        {
            "location": "225/TALK",
            "narrator": "みやび",
            "text": "愚行に走る危機一髪",
            "zh": "差点就要犯蠢咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "226/TALK",
            "narrator": "みやび",
            "text": "助かったぞ、相棒",
            "zh": "多亏了你，搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "228/SEL",
            "narrator": "（選択肢）",
            "text": "もう大丈夫なの？",
            "zh": "现在没事了吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "229/ACT",
            "narrator": "",
            "text": "もう大丈夫なの？",
            "zh": "现在没事了吗？",
            "narrator_zh": ""
        },
        {
            "location": "231/TALK",
            "narrator": "みやび",
            "text": "落ち着いた",
            "zh": "冷静下来了。",
            "narrator_zh": "雅"
        },
        {
            "location": "232/TALK",
            "narrator": "みやび",
            "text": "うちに今できることは",
            "zh": "现在我能做的，",
            "narrator_zh": "雅"
        },
        {
            "location": "233/TALK",
            "narrator": "みやび",
            "text": "データ解析",
            "zh": "就是数据解析。",
            "narrator_zh": "雅"
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "それに集中するしかない",
            "zh": "只能专注于它。",
            "narrator_zh": "雅"
        },
        {
            "location": "235/TALK",
            "narrator": "みやび",
            "text": "それ以外に",
            "zh": "除此之外，",
            "narrator_zh": "雅"
        },
        {
            "location": "236/TALK",
            "narrator": "みやび",
            "text": "うちにできることなどない",
            "zh": "我什么都做不了。",
            "narrator_zh": "雅"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "考えるまでもなかった",
            "zh": "本来根本不用想。",
            "narrator_zh": "雅"
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "…連絡取れない以上、\nうちには何もできん。",
            "zh": "……既然联系不上，\n我什么都做不了。",
            "narrator_zh": "雅"
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "ならば気にするだけ\n集中力乱れて、\n作業の妨げになるだけ。",
            "zh": "再挂心下去只会\n乱掉专注力，\n妨碍干活而已。",
            "narrator_zh": "雅"
        },
        {
            "location": "251/TALK",
            "narrator": "みやび",
            "text": "…考えんようにせんと。\nうちは、うさぎからの\nメールなんぞ見ていない。",
            "zh": "……得逼自己别去想。\n兔子发来的什么邮件，\n我可压根没看见。",
            "narrator_zh": "雅"
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "254/TALK",
            "narrator": "みやび",
            "text": "堪忍な、うさぎ…。\nけど、今のうちには\n何もできんがよ…。",
            "zh": "对不住了，兔子……。\n可是，现在的我\n什么都做不了咯……。",
            "narrator_zh": "雅"
        }
    ]
}
