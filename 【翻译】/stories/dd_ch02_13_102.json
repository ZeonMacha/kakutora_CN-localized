{
    "dir": "chap13/daydra/dd_ch02_13_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "13205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "子供の頃の憧れ＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "儿时的憧憬＜后篇＞"
    },
    "entry": [
        {
            "location": "441/SCENARIO",
            "narrator": "",
            "text": "魔法少女になろうよ",
            "zh": "一起来当魔法少女吧",
            "narrator_zh": ""
        },
        {
            "location": "470/TALK",
            "narrator": "アーヤ",
            "text": "…やっぱり――",
            "zh": "……果然——",
            "narrator_zh": "绫水"
        },
        {
            "location": "471/TALK",
            "narrator": "アーヤ",
            "text": "やってみたいかも。",
            "zh": "我还是想试试看呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "472/TALK",
            "narrator": "アーヤ",
            "text": "こういう機会でも\nないと、こんなこと\n絶対できないし。",
            "zh": "要不是趁着这种机会，\n这种事平时绝对\n不可能有机会做的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "475/TALK",
            "narrator": "アーヤ",
            "text": "でも…。",
            "zh": "可是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "476/TALK",
            "narrator": "ガブリエラ",
            "text": "ああもう！\nあの二人は\nいつ来るのよ！？",
            "zh": "啊——真是的！\n那两个人到底\n什么时候才来啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "479/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん、卯月達が\nやりたい言うとは\n限らんがよ？",
            "zh": "加布，卯月她们\n也不见得就会\n想当啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "そこは先輩命令よ。\nそれとも、みやびが\nやってくれるの？",
            "zh": "那可是前辈的命令。\n还是说，雅你\n愿意替她们上？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "483/TALK",
            "narrator": "みやび",
            "text": "後輩に花を持たせる\nことも大切やね。",
            "zh": "把风头让给后辈\n也很重要咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "484/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうことよ。",
            "zh": "就是这么回事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "486/TALK",
            "narrator": "アーヤ",
            "text": "…この空気で言うのは\n難しいかも。",
            "zh": "……在这种气氛下，\n恐怕很难开口说想当呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "487/SEL",
            "narrator": "",
            "text": "アーヤ、戦ってくれ！",
            "zh": "绫水，去战斗吧！",
            "narrator_zh": ""
        },
        {
            "location": "488/SEL",
            "narrator": "",
            "text": "可愛いところ見せてくれ！",
            "zh": "让我看看你可爱的一面吧！",
            "narrator_zh": ""
        },
        {
            "location": "489/ACT",
            "narrator": "",
            "text": "アーヤ、戦ってくれ！",
            "zh": "绫水，去战斗吧！",
            "narrator_zh": ""
        },
        {
            "location": "505/TALK",
            "narrator": "アーヤ",
            "text": "そうよ",
            "zh": "对啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "506/TALK",
            "narrator": "アーヤ",
            "text": "これは戦い(｀ヘ´)",
            "zh": "这是一场战斗(｀ヘ´)",
            "narrator_zh": "绫水"
        },
        {
            "location": "507/TALK",
            "narrator": "アーヤ",
            "text": "恥ずかしいとか",
            "zh": "去在意什么害不害羞的",
            "narrator_zh": "绫水"
        },
        {
            "location": "508/TALK",
            "narrator": "アーヤ",
            "text": "考えるのがおかしいわね",
            "zh": "本身就很奇怪吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "509/TALK",
            "narrator": "アーヤ",
            "text": "後押しありがとう(^^",
            "zh": "谢谢你的鼓励(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "510/TALK",
            "narrator": "アーヤ",
            "text": "私",
            "zh": "我",
            "narrator_zh": "绫水"
        },
        {
            "location": "511/TALK",
            "narrator": "アーヤ",
            "text": "戦うわ！",
            "zh": "要上了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "512/ACT",
            "narrator": "",
            "text": "可愛いところ見せてくれ！",
            "zh": "让我看看你可爱的一面吧！",
            "narrator_zh": ""
        },
        {
            "location": "528/TALK",
            "narrator": "アーヤ",
            "text": "工ｴｴｪｪ(´д｀)ｪｪｴｴ工",
            "zh": "工ｴｴｪｪ(´д｀)ｪｪｴｴ工",
            "narrator_zh": "绫水"
        },
        {
            "location": "529/TALK",
            "narrator": "アーヤ",
            "text": "そこは",
            "zh": "这种时候",
            "narrator_zh": "绫水"
        },
        {
            "location": "530/TALK",
            "narrator": "アーヤ",
            "text": "かっこいいところ見せてくれ",
            "zh": "应该说“让我看看你帅气的一面”",
            "narrator_zh": "绫水"
        },
        {
            "location": "531/TALK",
            "narrator": "アーヤ",
            "text": "とか",
            "zh": "之类的",
            "narrator_zh": "绫水"
        },
        {
            "location": "532/TALK",
            "narrator": "アーヤ",
            "text": "別の言い方あるでしょ！？(´o｀；",
            "zh": "有别的说法吧！？(´o｀；",
            "narrator_zh": "绫水"
        },
        {
            "location": "534/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "535/TALK",
            "narrator": "アーヤ",
            "text": "メルティは魔法少女みたいだし",
            "zh": "融化确实像魔法少女一样",
            "narrator_zh": "绫水"
        },
        {
            "location": "537/TALK",
            "narrator": "アーヤ",
            "text": "そうよね",
            "zh": "说得也是",
            "narrator_zh": "绫水"
        },
        {
            "location": "538/TALK",
            "narrator": "アーヤ",
            "text": "可愛くやらないと(*^^*)",
            "zh": "得表现得可爱一点才行(*^^*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "539/TALK",
            "narrator": "アーヤ",
            "text": "可愛くなるように",
            "zh": "为了能变得可爱",
            "narrator_zh": "绫水"
        },
        {
            "location": "540/TALK",
            "narrator": "アーヤ",
            "text": "頑張るわ！(^ε^)-☆!!",
            "zh": "我会加油的！(^ε^)-☆!!",
            "narrator_zh": "绫水"
        },
        {
            "location": "552/TALK",
            "narrator": "アーヤ",
            "text": "…よし！",
            "zh": "……好！",
            "narrator_zh": "绫水"
        },
        {
            "location": "553/TALK",
            "narrator": "アーヤ",
            "text": "私、やるわ。",
            "zh": "我来当。",
            "narrator_zh": "绫水"
        },
        {
            "location": "559/TALK",
            "narrator": "みやび",
            "text": "おっ！？",
            "zh": "哦！？",
            "narrator_zh": "雅"
        },
        {
            "location": "560/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ！？\nアーヤ、それ本気で\n言ってるわけ？",
            "zh": "哈啊！？\n绫水，你该不会是\n认真的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "561/TALK",
            "narrator": "アーヤ",
            "text": "このまま放っておく\nわけにはいかないでしょ？",
            "zh": "总不能就这么\n放着不管吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "562/TALK",
            "narrator": "透明真幌",
            "text": "待て、アーヤ。\nおまえだけではダメだ。",
            "zh": "等等，绫水。\n光你一个人可不行。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "563/TALK",
            "narrator": "透明真幌",
            "text": "ミルクティとアップル\nティの二人が揃わないと、\n条件は整わない。",
            "zh": "必须凑齐奶茶和\n苹果茶两个人，\n条件才能成立。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "566/TALK",
            "narrator": "みやび",
            "text": "…なんちゅう\n面倒くさい条件や。",
            "zh": "……真是么子\n麻烦透顶的条件咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "568/TALK",
            "narrator": "ガブリエラ",
            "text": "ホントよね……。",
            "zh": "就是说啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "570/TALK",
            "narrator": "アーヤ",
            "text": "聞いたでしょ？\n私一人じゃ無理なの。",
            "zh": "听到了吧？\n光我一个人是不行的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "571/TALK",
            "narrator": "アーヤ",
            "text": "だから、お願い！\n私と一緒に戦って！",
            "zh": "所以，拜托了！\n跟我一起战斗吧！",
            "narrator_zh": "绫水"
        },
        {
            "location": "572/TALK",
            "narrator": "ガブリエラ",
            "text": "そう言われても…。",
            "zh": "就算你这么说……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "573/TALK",
            "narrator": "アーヤ",
            "text": "お願い！",
            "zh": "拜托了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "575/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "577/TALK",
            "narrator": "みやび",
            "text": "…どうするぞね？",
            "zh": "……你打算怎么办啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "579/TALK",
            "narrator": "ガブリエラ",
            "text": "どうするって…。",
            "zh": "怎么办什么的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "582/TALK",
            "narrator": "ガブリエラ",
            "text": "…わかった。\nわかったわよ。",
            "zh": "……知道了。\n我知道了啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "584/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしが一緒に\nやったげるから！\nそれでいいでしょ？",
            "zh": "我陪你一起\n上就是了吧！\n这样行了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "585/TALK",
            "narrator": "アーヤ",
            "text": "ほ、本当！？",
            "zh": "真、真的吗！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "587/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん、\nまっことえいの？",
            "zh": "加布，\n真的要得？",
            "narrator_zh": "雅"
        },
        {
            "location": "588/TALK",
            "narrator": "ガブリエラ",
            "text": "必殺技で一撃でも、\n戦闘であることには\n違いないんだし――",
            "zh": "就算是用必杀技一击决胜，\n归根结底这也还是\n战斗吧——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "589/TALK",
            "narrator": "ガブリエラ",
            "text": "それなら、みやびより\nあたしの方が\n適任でしょ？",
            "zh": "既然如此，比起雅\n还是我来当\n更合适吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "591/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう。\nやっぱりギャヴィは\n頼りになるわ。",
            "zh": "谢谢你。\n果然加维\n最可靠了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "592/TALK",
            "narrator": "ガブリエラ",
            "text": "こんな変なことで\n頼られても\n嬉しくないから！",
            "zh": "在这种莫名其妙的事上\n被你依靠，我可一点都\n高兴不起来！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "593/TALK",
            "narrator": "ガブリエラ",
            "text": "もっと狙撃とか、\nそっち系で頼ってくれ\nればいいのに…。",
            "zh": "明明在狙击之类的事情上\n多依靠我一点\n就好了嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "594/TALK",
            "narrator": "アーヤ",
            "text": "そっちに関しては\nいつも頼りにしてるわよ。",
            "zh": "那些方面\n我一直都很依赖你哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "595/TALK",
            "narrator": "アーヤ",
            "text": "だから、今回だけは\nお願いね。",
            "zh": "所以，就这一次\n拜托你了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "596/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "598/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…わかったから、\nさっさと終わらせるわよ。",
            "zh": "哈啊……我知道了，\n赶紧搞定收工吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "599/TALK",
            "narrator": "透明真幌",
            "text": "決まったか？\nでは、そっちに資料を\n一式送っておいた。",
            "zh": "定下来了吗？\n那我把全套资料\n发到你们那边去了。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "600/TALK",
            "narrator": "透明真幌",
            "text": "作戦開始前に、\nそれに目を通して\nおいてくれ。",
            "zh": "作战开始前，\n先把那些内容\n看一遍。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "601/TALK",
            "narrator": "ガブリエラ",
            "text": "資料？",
            "zh": "资料？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "602/TALK",
            "narrator": "透明真幌",
            "text": "メルティの決め台詞と\n技名に関する資料だ。",
            "zh": "关于融化的招牌台词\n和招式名称的资料。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "603/TALK",
            "narrator": "透明真幌",
            "text": "それに目を通し、\n正確に再現してくれ。",
            "zh": "看清楚之后，\n给我分毫不差地还原出来。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "604/TALK",
            "narrator": "ガブリエラ",
            "text": "そこまでやらなきゃ\nいけないの！？",
            "zh": "居然还得做到\n那种地步吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "607/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん、\nもう諦めぃ。",
            "zh": "加布，\n你就认命吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "608/TALK",
            "narrator": "みやび",
            "text": "今更やめるなんて\n言える雰囲気やないぞね？",
            "zh": "事到如今，这气氛\n也容不得你说不干了啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "610/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うぅぅ…。",
            "zh": "呜、呜呜呜……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "612/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、\n配置につくわ。",
            "zh": "那么，\n准备就位吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "613/TALK",
            "narrator": "アーヤ",
            "text": "頼りにしてるからね、\nギャヴィ。",
            "zh": "就拜托你了，\n加维。",
            "narrator_zh": "绫水"
        },
        {
            "location": "615/TALK",
            "narrator": "ガブリエラ",
            "text": "こんなことで\n頼られても嬉しく\nないんだってば！",
            "zh": "都说了在这种事上被你依靠\n我根本高兴不起来\n啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "626/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【MV EXE_AYAMi】",
            "zh": "【MV EXE_AYAMi】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
