{
    "dir": "chap27/daydra/dd_ch04_27_010.js",
    "type": "",
    "info": {
        "story_id": "50005",
        "cid": "",
        "title": "SideStory005 ストーリー",
        "sub_title": "FILE04.辛抱",
        "title_zh": "SideStory005 剧情",
        "sub_title_zh": "FILE04.忍耐"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "東京編４話",
            "zh": "东京篇第4话",
            "narrator_zh": ""
        },
        {
            "location": "23/DIALOG",
            "narrator": "",
            "text": "<color=green>9月4日　 2:02 PM</color>\nストライキ中、長野県松代アーヤの実家にて",
            "zh": "<color=green>9月4日　 2:02 PM</color>\n罢工期间，长野县松代绫水的老家",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、これよ。\n劇場の掲示板の、\nこの書き込みを見て！",
            "zh": "喏，看这个。\n剧场留言板上的，\n这条帖子！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "27/TALK",
            "narrator": "アーヤ",
            "text": "投稿者は…電子ウサギ？\nウサギって、まさか…。",
            "zh": "发帖人是……电子兔？\n兔子，该不会……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "28/TALK",
            "narrator": "みやび",
            "text": "…ガブちゃん、\nなんて書きこんどるか\n読んでもらえん？",
            "zh": "……加布，\n上面写了些驷马，\n念给我听听得不得？",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "うん…えっと…。",
            "zh": "嗯……那个……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "劇場、\nとうとう閉鎖でしょうか？",
            "zh": "剧场，\n终于要关闭了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "売店で売ってる店員さん\n手作りのたこ焼きが\n美味しかったのに残念。",
            "zh": "小卖部店员\n手工做的章鱼烧\n明明那么好吃，好遗憾。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "もし店員さんが見てるなら\n連絡ください",
            "zh": "如果店员先生看到的话\n请联系我",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "…以上よ。\nこの書き込み、どう思う？",
            "zh": "……完了。\n这条帖子，你怎么看？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "…多分、うさぎ達本人が\n書き込んだものやろうね。",
            "zh": "……多半，是兔子她们\n本人发的帖咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "しかも、わかりやすい\n暗号散りばめちょるし…。",
            "zh": "而且，还埋了些\n一看就懂的暗号……。",
            "narrator_zh": "雅"
        },
        {
            "location": "39/TALK",
            "narrator": "ガブリエラ",
            "text": "管理庁のヤツラが繭達を\n語ってる可能性は？",
            "zh": "有没有可能是管理厅的家伙\n冒充茧她们？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "アーヤ",
            "text": "…多分無いわね。",
            "zh": "……多半没有。",
            "narrator_zh": "绫水"
        },
        {
            "location": "41/TALK",
            "narrator": "アーヤ",
            "text": "みやびが光月さんのことを\nうさぎって呼んでるのは\n聞かれたとしても…。",
            "zh": "就算雅管光月叫\n兔子这事\n被人听到了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "たこ焼きの話題までは、\n出してくると思わないし。",
            "zh": "但章鱼烧这种话题，\n他们不会知道的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "劇場の売店で、\nたこ焼きなんぞ\n売ったことないきね。",
            "zh": "剧场的小卖部，\n章鱼烧驷马的\n从来没卖过啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "それに、ガブちゃんが\nたこ焼き作りが得意なの\n知ってるのは極一部や。",
            "zh": "而且，知道加布\n拿手做章鱼烧的，\n只有极少数人。",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "間違いない。\nこれはうさぎ達本人の\n書き込み確定や。",
            "zh": "没错。\n这肯定是兔子她们\n本人的帖子。",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "アーヤ",
            "text": "…困ったわね。",
            "zh": "……伤脑筋了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "アーヤ",
            "text": "連絡しなければ、\nいずれ諦めると思って\nいたんだけど…。",
            "zh": "本以为只要不理，\n她们早晚\n会死心的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "どんどん違う方法を\n試しそうよね…。",
            "zh": "感觉她们会不停地\n换法子试下去呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "そうね…。\nあの子達の行動力、\n甘く見てたわ…。",
            "zh": "是呢……。\n那帮孩子的行动力，\n是我低估了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "そうやねぇ…。",
            "zh": "是啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "で、どうするが？\nなにか返信する？",
            "zh": "那，怎么办咧？\n要不要回点什么啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "59/TALK",
            "narrator": "アーヤ",
            "text": "…ううん。\nやめておきましょ。",
            "zh": "……不。\n还是算了吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "それって、巻き込みたく\nないって思ってるから？",
            "zh": "是因为不想\n把她们牵扯进来？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "だとしたら、\nもう手遅れじゃない？",
            "zh": "要是那样，\n不是已经晚了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "アーヤ",
            "text": "わかってる。",
            "zh": "我知道。",
            "narrator_zh": "绫水"
        },
        {
            "location": "66/TALK",
            "narrator": "アーヤ",
            "text": "それでも…返さなければ\nこれ以上の深入りは\nできないと思うの…。",
            "zh": "即便如此……只要不回应，\n我想她们就不会\n再深入下去了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "アーヤ",
            "text": "私達との連絡なしに、\n何かできるとは\n考えにくいし。",
            "zh": "没有我们的联络，\n她们也做不成\n什么事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "そうやろか？\n逆にもっと必死になって\n動く可能性もあるがよ？",
            "zh": "是咩？\n搞不好她们反而会\n拼了命地动起来啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "…かもしれないわ。",
            "zh": "……也许吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "…どっちにしろ、\n完全に止めることは\nできない、ってことね？",
            "zh": "……总之，\n是不可能完全阻止的，\n对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "でも…これ以上\n巻き込みたくない、って\n考えには…賛成かな。",
            "zh": "但是……不想再\n牵扯她们进来这个想法，\n我……倒是赞成。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "このままだと、取り返し\nつかないところまで\n踏み込んできそうだし…。",
            "zh": "再这样下去，她们怕是会\n一头踩进无可挽回的\n地方……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "アーヤ",
            "text": "…ごめんなさい。\n私も、この件に関しては\nはっきりと自信持てない。",
            "zh": "……对不起。\n这件事，我也\n没什么明确把握。",
            "narrator_zh": "绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "気にする必要ないぞね。",
            "zh": "没必要放在心上咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "冷たい言い方やけんど、\nあの子らはトライナリーの\nメンバーやないきね。",
            "zh": "话说得是冷了点，\n但那帮孩子不是\n三重奏的成员啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "あの子らのことまで、\nアーヤが責任持つ必要は\nまったくないちや。",
            "zh": "连她们的事都要\n你负责，完全\n没这个必要滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "ガブリエラ",
            "text": "…一旦さ、\nひなこ達のことは\n忘れた方がよくない？",
            "zh": "……要不，先把\n小雏她们的事\n放一放？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "今は自分たちのことで\n頭がいっぱいなのに…。",
            "zh": "现在光自己的事\n就已经焦头烂额了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "ひなこ達のことまで\n考えてたら、\nこっちが動けなくなるわ。",
            "zh": "连小雏她们都要\n惦记的话，\n我们自己就动不了了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "…そうね。\n一旦、日向さん達のことは\n忘れましょ。",
            "zh": "……是呢。\n日向她们的事，\n就先放一放吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "アーヤには反対される\n思うて、言わんかった\nけんど…。",
            "zh": "想着会被绫水反对，\n就没敢说，\n但是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "うさぎには…、\nRabbitAnimaに\nだけには伝えんと…。",
            "zh": "兔子她们那边……，\n只能让RabbitAnima\n知道才行……。",
            "narrator_zh": "雅"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "勝手に管理庁に\nサイバー攻撃せんとも\n限らんし…。",
            "zh": "谁知道她们会不会\n自说自话对管理厅\n发起网络攻击呢……。",
            "narrator_zh": "雅"
        },
        {
            "location": "109/TALK",
            "narrator": "みやび",
            "text": "…アーヤ、すまん。",
            "zh": "……绫水，没好意思。",
            "narrator_zh": "雅"
        },
        {
            "location": "119/TALK",
            "narrator": "ヒカル",
            "text": "…どう？\n掲示板、なにか返事は？",
            "zh": "……怎么样？\n留言板上有什么回复吗？",
            "narrator_zh": "光"
        },
        {
            "location": "120/TALK",
            "narrator": "繭",
            "text": "…来てない。",
            "zh": "……还没有。",
            "narrator_zh": "茧"
        },
        {
            "location": "122/TALK",
            "narrator": "ヒカル",
            "text": "そう…。\nいい考えだと思ったん\nだけど…。",
            "zh": "这样啊……。\n我还以为是个好主意\n来着……。",
            "narrator_zh": "光"
        },
        {
            "location": "124/TALK",
            "narrator": "繭",
            "text": "キリトにしては、\n珍しくさえた考えだと\n思う。",
            "zh": "对圣翔来说，\n这主意难得地\n清醒机灵。",
            "narrator_zh": "茧"
        },
        {
            "location": "125/TALK",
            "narrator": "繭",
            "text": "いつもなら、こんな方法\n絶対に思いつかない。",
            "zh": "换作平时，这种法子\n他绝对想不出来。",
            "narrator_zh": "茧"
        },
        {
            "location": "127/TALK",
            "narrator": "ヒカル",
            "text": "そ、そうかな？",
            "zh": "是、是这样吗？",
            "narrator_zh": "光"
        },
        {
            "location": "128/TALK",
            "narrator": "繭",
            "text": "間違いない。",
            "zh": "错不了。",
            "narrator_zh": "茧"
        },
        {
            "location": "129/TALK",
            "narrator": "繭",
            "text": "…まさか。",
            "zh": "……该不会。",
            "narrator_zh": "茧"
        },
        {
            "location": "130/TALK",
            "narrator": "繭",
            "text": "連絡の取れなかった\n数日の間に、\n脳改造されたとか？",
            "zh": "失联的那几天里，\n该不会被人\n改造了脑子吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "131/TALK",
            "narrator": "ヒカル",
            "text": "あはは、それはないよ。\nずっと一緒にいた僕が\n保証するよ。",
            "zh": "啊哈哈，那不可能。\n一直跟他在一起的我\n可以保证。",
            "narrator_zh": "光"
        },
        {
            "location": "132/TALK",
            "narrator": "繭",
            "text": "…本当に？",
            "zh": "……真的？",
            "narrator_zh": "茧"
        },
        {
            "location": "133/TALK",
            "narrator": "ヒカル",
            "text": "本当です。",
            "zh": "真的。",
            "narrator_zh": "光"
        },
        {
            "location": "134/TALK",
            "narrator": "ヒカル",
            "text": "脳改造どころか、\n出撃の命令が来るまで\nなにもなくて…。",
            "zh": "别说改造脑子了，\n出击命令来之前\n什么都没有……。",
            "narrator_zh": "光"
        },
        {
            "location": "135/TALK",
            "narrator": "ヒカル",
            "text": "暇過ぎて地獄だ、って\n辛過ぎる、って不満ばかり\n言ってたなぁ…。",
            "zh": "「闲得要死啦」\n「熬得难受啦」，\n他净说这些抱怨……。",
            "narrator_zh": "光"
        },
        {
            "location": "136/TALK",
            "narrator": "繭",
            "text": "…ふふっ。",
            "zh": "……呵呵。",
            "narrator_zh": "茧"
        },
        {
            "location": "137/TALK",
            "narrator": "繭",
            "text": "昔から、退屈するの\n嫌いだったから…。",
            "zh": "他从以前就\n最怕无聊来着……。",
            "narrator_zh": "茧"
        },
        {
            "location": "138/TALK",
            "narrator": "ヒカル",
            "text": "そうなの？",
            "zh": "是这样吗？",
            "narrator_zh": "光"
        },
        {
            "location": "140/TALK",
            "narrator": "繭",
            "text": "ええ。\n…成長してないわ。",
            "zh": "嗯。\n……一点没长进呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "141/TALK",
            "narrator": "ヒカル",
            "text": "…変わらない、って\n言ってあげればいいのに。",
            "zh": "……这种时候说\n「一点没变」不就好了。",
            "narrator_zh": "光"
        },
        {
            "location": "142/TALK",
            "narrator": "ヒカル",
            "text": "でも、そっか…繭さんと\nキリトって、幼馴染って\n言ってたっけ…。",
            "zh": "不过，说起来……\n茧和圣翔是\n青梅竹马来着……。",
            "narrator_zh": "光"
        },
        {
            "location": "143/TALK",
            "narrator": "ヒカル",
            "text": "他にも、子供の頃から\n変わってないところって\nあるの？",
            "zh": "除此之外，还有没有\n从小到大\n一直没变的地方？",
            "narrator_zh": "光"
        },
        {
            "location": "145/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "152/TALK",
            "narrator": "繭",
            "text": "…メール？\n今どき珍し――",
            "zh": "……邮件？\n这年头真稀罕――",
            "narrator_zh": "茧"
        },
        {
            "location": "154/TALK",
            "narrator": "繭",
            "text": "っ！？　これは…。",
            "zh": "唔！？　这是……。",
            "narrator_zh": "茧"
        },
        {
            "location": "156/TALK",
            "narrator": "ヒカル",
            "text": "誰からですか？",
            "zh": "是谁发来的？",
            "narrator_zh": "光"
        },
        {
            "location": "157/TALK",
            "narrator": "繭",
            "text": "…みやび先輩から。",
            "zh": "……是雅前辈。",
            "narrator_zh": "茧"
        },
        {
            "location": "158/TALK",
            "narrator": "ヒカル",
            "text": "ほ、本当に！？",
            "zh": "真、真的吗！？",
            "narrator_zh": "光"
        },
        {
            "location": "159/TALK",
            "narrator": "繭",
            "text": "アドレスは違うけど…、\n間違いない。",
            "zh": "地址虽然不同……，\n错不了。",
            "narrator_zh": "茧"
        },
        {
            "location": "160/TALK",
            "narrator": "ヒカル",
            "text": "…なんて、\n書いてあるんですか？",
            "zh": "……上面\n写了些什么？",
            "narrator_zh": "光"
        },
        {
            "location": "161/TALK",
            "narrator": "繭",
            "text": "…場所は言えないが無事。\n今はそれ以上言えない。",
            "zh": "……地点不能说，人平安。\n现在没法再多说。",
            "narrator_zh": "茧"
        },
        {
            "location": "162/TALK",
            "narrator": "繭",
            "text": "…これだけ。\n手掛かりになるような\nことは、書いてない…。",
            "zh": "……就这些。\n能当线索的内容，\n一个字都没写……。",
            "narrator_zh": "茧"
        },
        {
            "location": "163/TALK",
            "narrator": "ヒカル",
            "text": "…どうにかして\n聞きだすことはできない？",
            "zh": "……能不能想办法\n多问出点什么？",
            "narrator_zh": "光"
        },
        {
            "location": "164/TALK",
            "narrator": "繭",
            "text": "やってみるけど…、\n多分無駄だと思うわ…。",
            "zh": "我会试试……，\n但多半是白费劲……。",
            "narrator_zh": "茧"
        },
        {
            "location": "177/TALK",
            "narrator": "みやび",
            "text": "…やっぱり来たか。",
            "zh": "……果然来了啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "178/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "179/TALK",
            "narrator": "みやび",
            "text": "予想通りの返事やな。\nさすがはうさぎや。",
            "zh": "和预想一样的回复。\n不愧是兔子。",
            "narrator_zh": "雅"
        },
        {
            "location": "181/TALK",
            "narrator": "みやび",
            "text": "…けんど、さすがに\n危険やろうし…。",
            "zh": "……但是，说到底\n还是很危险……。",
            "narrator_zh": "雅"
        },
        {
            "location": "182/SEL",
            "narrator": "（選択肢）",
            "text": "なんて送られてきたの？",
            "zh": "对方发了什么过来？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "183/ACT",
            "narrator": "",
            "text": "なんて送られてきたの？",
            "zh": "对方发了什么过来？",
            "narrator_zh": ""
        },
        {
            "location": "191/TALK",
            "narrator": "みやび",
            "text": "手助けしたい",
            "zh": "想帮忙",
            "narrator_zh": "雅"
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "その一言である",
            "zh": "就这一句话",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "短くて明快でわかりやすい内容",
            "zh": "内容简短明快、一目了然",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "素晴らしい",
            "zh": "出色",
            "narrator_zh": "雅"
        },
        {
            "location": "196/SEL",
            "narrator": "（選択肢）",
            "text": "なんて返すつもり？",
            "zh": "打算回什么？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "197/ACT",
            "narrator": "",
            "text": "なんて返すつもり？",
            "zh": "打算回什么？",
            "narrator_zh": ""
        },
        {
            "location": "199/TALK",
            "narrator": "みやび",
            "text": "返さない",
            "zh": "不回",
            "narrator_zh": "雅"
        },
        {
            "location": "201/TALK",
            "narrator": "みやび",
            "text": "あくまでFatalQueenとして",
            "zh": "只是以FatalQueen的身份",
            "narrator_zh": "雅"
        },
        {
            "location": "202/TALK",
            "narrator": "みやび",
            "text": "RabbitAnimaに連絡をしたまで",
            "zh": "联系了RabbitAnima而已",
            "narrator_zh": "雅"
        },
        {
            "location": "203/TALK",
            "narrator": "みやび",
            "text": "これ以上の連絡は",
            "zh": "再多的联络",
            "narrator_zh": "雅"
        },
        {
            "location": "204/TALK",
            "narrator": "みやび",
            "text": "不要である",
            "zh": "没有必要",
            "narrator_zh": "雅"
        },
        {
            "location": "207/TALK",
            "narrator": "みやび",
            "text": "今の状況は",
            "zh": "现在的状况",
            "narrator_zh": "雅"
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "マジでヤバい",
            "zh": "是真的糟糕透顶",
            "narrator_zh": "雅"
        },
        {
            "location": "209/TALK",
            "narrator": "みやび",
            "text": "これ以上巻き込む気は",
            "zh": "再牵扯她们进来的念头",
            "narrator_zh": "雅"
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "毛頭ないぞね",
            "zh": "我半点都没有咧",
            "narrator_zh": "雅"
        },
        {
            "location": "212/SEL",
            "narrator": "（選択肢）",
            "text": "まだそんなこと言ってるの？",
            "zh": "都这时候了还说这个？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "213/SEL",
            "narrator": "（選択肢）",
            "text": "それでいいと思う",
            "zh": "我觉得这样就挺好",
            "narrator_zh": "（选项）"
        },
        {
            "location": "214/ACT",
            "narrator": "",
            "text": "まだそんなこと言ってるの？",
            "zh": "都这时候了还说这个？",
            "narrator_zh": ""
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "既に巻き込んでいる",
            "zh": "她们已经被牵扯进来了",
            "narrator_zh": "雅"
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "それは理解している",
            "zh": "这一点我明白",
            "narrator_zh": "雅"
        },
        {
            "location": "217/TALK",
            "narrator": "みやび",
            "text": "キリトくん達が",
            "zh": "圣翔他们",
            "narrator_zh": "雅"
        },
        {
            "location": "218/TALK",
            "narrator": "みやび",
            "text": "謹慎処分を食らったこと",
            "zh": "吃了禁闭处分的事",
            "narrator_zh": "雅"
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "アーヤから聞かされたのでな",
            "zh": "是绫水告诉我的",
            "narrator_zh": "雅"
        },
        {
            "location": "220/TALK",
            "narrator": "みやび",
            "text": "しかし",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "221/TALK",
            "narrator": "みやび",
            "text": "だとしても",
            "zh": "就算如此",
            "narrator_zh": "雅"
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "これ以上はいかん",
            "zh": "也不能再下去了",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "これ以上巻き込ませて",
            "zh": "再让她们卷进来",
            "narrator_zh": "雅"
        },
        {
            "location": "224/TALK",
            "narrator": "みやび",
            "text": "危険な目には合わせられんのだ",
            "zh": "遇上危险的事，我做不出来",
            "narrator_zh": "雅"
        },
        {
            "location": "225/ACT",
            "narrator": "",
            "text": "それでいいと思う",
            "zh": "我觉得这样就挺好",
            "narrator_zh": ""
        },
        {
            "location": "226/TALK",
            "narrator": "みやび",
            "text": "そう思うか？",
            "zh": "你是这么想的？",
            "narrator_zh": "雅"
        },
        {
            "location": "227/TALK",
            "narrator": "みやび",
            "text": "聞いて安心したぞね",
            "zh": "听你这么说我就安心了咧",
            "narrator_zh": "雅"
        },
        {
            "location": "228/TALK",
            "narrator": "みやび",
            "text": "助けを求めれば",
            "zh": "只要开口求救",
            "narrator_zh": "雅"
        },
        {
            "location": "229/TALK",
            "narrator": "みやび",
            "text": "うさぎ達のことだ",
            "zh": "照兔子她们的性子",
            "narrator_zh": "雅"
        },
        {
            "location": "230/TALK",
            "narrator": "みやび",
            "text": "必ず協力を申し出る",
            "zh": "肯定会主动来帮忙",
            "narrator_zh": "雅"
        },
        {
            "location": "231/TALK",
            "narrator": "みやび",
            "text": "命の危険も顧みずに",
            "zh": "连性命危险都不顾",
            "narrator_zh": "雅"
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "そんなこと",
            "zh": "这种事",
            "narrator_zh": "雅"
        },
        {
            "location": "235/TALK",
            "narrator": "みやび",
            "text": "させるわけにはいかないのだ",
            "zh": "我可不能容许",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "みやび",
            "text": "いかんな",
            "zh": "不行啊",
            "narrator_zh": "雅"
        },
        {
            "location": "240/TALK",
            "narrator": "みやび",
            "text": "これ以上話していると",
            "zh": "再继续说下去",
            "narrator_zh": "雅"
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "決意が揺らぐ",
            "zh": "决心就要动摇了",
            "narrator_zh": "雅"
        },
        {
            "location": "242/TALK",
            "narrator": "みやび",
            "text": "すまんが落ちるぞ",
            "zh": "没好意思，我先下了啵",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "255/TALK",
            "narrator": "みやび",
            "text": "気持ちは嬉しい…。\nまっこと嬉しいが…。",
            "zh": "这份心意让我高兴……。\n是打心底里高兴……。",
            "narrator_zh": "雅"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "気持ちだけは、\n確かに受け取ったぞね。",
            "zh": "这份心意，\n我确实收下了咧。",
            "narrator_zh": "雅"
        }
    ]
}
