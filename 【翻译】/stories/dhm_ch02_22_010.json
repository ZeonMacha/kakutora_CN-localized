        "title": "Extra003 ヒメゴトチャット",
        "sub_title": "うしろの正面だあれ？",
        "title_zh": "Extra003 秘语聊天",
        "sub_title_zh": "身后的正前方是谁呀？"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "うしろの正面だあれ？",
            "zh": "身后的正前方是谁呀？",
            "narrator_zh": ""
        },
        {
            "location": "34/TALK",
            "narrator": "アーヤ",
            "text": "さっきのひどくない？",
            "zh": "刚才那下也太狠了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "アーヤ",
            "text": "脅かすにも限度があるわよ",
            "zh": "吓人也要有个限度哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "36/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィだって私だって",
            "zh": "加维也好我也好",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "気絶するかと思ったわ",
            "zh": "差点都晕过去了",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/SEL",
            "narrator": "",
            "text": "まさか信じるとは…",
            "zh": "没想到你们真信了……",
            "narrator_zh": ""
        },
        {
            "location": "40/SEL",
            "narrator": "",
            "text": "ガブリエラを護ったね",
            "zh": "你护着加布里埃拉了呢",
            "narrator_zh": ""
        },
        {
            "location": "41/SEL",
            "narrator": "",
            "text": "ちょっとやり過ぎた？",
            "zh": "是不是玩过头了？",
            "narrator_zh": ""
        },
        {
            "location": "42/ACT",
            "narrator": "",
            "text": "まさか信じるとは…",
            "zh": "没想到你们真信了……",
            "narrator_zh": ""
        },
        {
            "location": "43/TALK",
            "narrator": "アーヤ",
            "text": "まさかじゃないわ",
            "zh": "哪是什么玩笑话",
            "narrator_zh": "绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "アーヤ",
            "text": "本当にそういうのを",
            "zh": "那种东西真的会",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/TALK",
            "narrator": "アーヤ",
            "text": "呼ぶこともあるのよ",
            "zh": "被叫过来的哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "冗談にしていいことじゃない",
            "zh": "这不是能拿来开玩笑的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "49/SEL",
            "narrator": "",
            "text": "えー…",
            "zh": "诶——…",
            "narrator_zh": ""
        },
        {
            "location": "50/SEL",
            "narrator": "",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": ""
        },
        {
            "location": "51/SEL",
            "narrator": "",
            "text": "アーヤってスピ系の人だったんだ",
            "zh": "原来绫水是灵修系的人啊",
            "narrator_zh": ""
        },
        {
            "location": "52/ACT",
            "narrator": "",
            "text": "えー…",
            "zh": "诶——…",
            "narrator_zh": ""
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "えーじゃないわ",
            "zh": "别光「诶——」啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "アーヤ",
            "text": "反省してね",
            "zh": "好好反省哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "55/ACT",
            "narrator": "",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": ""
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "今回はいいけど",
            "zh": "这次就算了",
            "narrator_zh": "绫水"
        },
        {
            "location": "57/TALK",
            "narrator": "アーヤ",
            "text": "二度としないでね",
            "zh": "下次别再这样了哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/ACT",
            "narrator": "",
            "text": "アーヤってスピ系の人だったんだ",
            "zh": "原来绫水是灵修系的人啊",
            "narrator_zh": ""
        },
        {
            "location": "59/TALK",
            "narrator": "アーヤ",
            "text": "言い方は何でもいいわ",
            "zh": "怎么叫都无所谓",
            "narrator_zh": "绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "アーヤ",
            "text": "とにかくこんなこと",
            "zh": "总之这种事",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "二度としちゃダメ",
            "zh": "绝对不能再做",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "アーヤ",
            "text": "ダメだからね！",
            "zh": "不许再犯了哦！",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/ACT",
            "narrator": "",
            "text": "ガブリエラを護ったね",
            "zh": "你护着加布里埃拉了呢",
            "narrator_zh": ""
        },
        {
            "location": "66/TALK",
            "narrator": "アーヤ",
            "text": "護ったっていうか",
            "zh": "要说保护嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "アーヤ",
            "text": "守られたっていうか",
            "zh": "倒不如说被保护了",
            "narrator_zh": "绫水"
        },
        {
            "location": "68/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィったら",
            "zh": "加维真是的",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "アーヤ",
            "text": "自分が怖いのに",
            "zh": "自己明明怕得要死",
            "narrator_zh": "绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "私の心配して",
            "zh": "还来担心我",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "アーヤ",
            "text": "怖かったのに",
            "zh": "明明很害怕",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "アーヤ",
            "text": "あれ見てたら",
            "zh": "但看着那样子",
            "narrator_zh": "绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィがかわいくて",
            "zh": "就觉得加维好可爱",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "アーヤ",
            "text": "なんだかうれしくなっちゃったわ",
            "zh": "莫名有点开心呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "76/ACT",
            "narrator": "",
            "text": "ちょっとやり過ぎた？",
            "zh": "是不是玩过头了？",
            "narrator_zh": ""
        },
        {
            "location": "77/TALK",
            "narrator": "アーヤ",
            "text": "ちょっとどころの",
            "zh": "哪是玩过头一点点的",
            "narrator_zh": "绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "騒ぎじゃないわよ！",
            "zh": "级别的问题哦！",
            "narrator_zh": "绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "81/TALK",
            "narrator": "アーヤ",
            "text": "みやびが怒るのも",
            "zh": "雅会发火",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "アーヤ",
            "text": "仕方ないわ",
            "zh": "也是没办法的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "この部屋に入っちゃダメって言われてたのに",
            "zh": "明明说了不许进那个房间",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "勝手に入ったんだもの",
            "zh": "还自作主张闯进去了",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "反省、、、",
