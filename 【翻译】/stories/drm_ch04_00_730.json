            "narrator_zh": ""
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "連絡が取れない？",
            "zh": "联系不上了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "178/TALK",
            "narrator": "ガブリエラ",
            "text": "部屋の様子がわかるなら",
            "zh": "要是能看清她房间的情况",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "荷物がなくなってないか教えて",
            "zh": "就告诉我她的东西有没有少",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "181/SEL",
            "narrator": "",
            "text": "無くなってはいない",
            "zh": "并没有消失",
            "narrator_zh": ""
        },
        {
            "location": "182/ACT",
            "narrator": "",
            "text": "無くなってはいない",
            "zh": "并没有消失",
            "narrator_zh": ""
        },
        {
            "location": "184/TALK",
            "narrator": "ガブリエラ",
            "text": "なら平気よ",
            "zh": "那就没事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "185/TALK",
            "narrator": "ガブリエラ",
            "text": "慌てなくても、そのうち帰って来るわ",
            "zh": "不用慌，她过阵子自己会回来的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "191/TALK",
            "narrator": "ガブリエラ",
            "text": "…帰って来るわよね？",
            "zh": "……她会回来的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/SEL",
            "narrator": "",
            "text": "みやびを知らない？",
            "zh": "你认识雅吗？",
            "narrator_zh": ""
        },
        {
            "location": "204/ACT",
            "narrator": "",
            "text": "みやびを知らない？",
            "zh": "你认识雅吗？",
            "narrator_zh": ""
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "あ、ちょっとすいません。",
            "zh": "啊，打扰一下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/TALK",
            "narrator": "アーヤ",
            "text": "知らないけど",
            "zh": "不知道",
            "narrator_zh": "绫水"
        },
        {
            "location": "227/TALK",
            "narrator": "アーヤ",
            "text": "部屋にいないの？",
            "zh": "不在房间里吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "229/SEL",
            "narrator": "",
            "text": "昨日の夜から連絡が取れない",
            "zh": "从昨晚开始就联系不上了",
            "narrator_zh": ""
        },
        {
            "location": "230/ACT",
            "narrator": "",
            "text": "昨日の夜から連絡が取れない",
            "zh": "从昨晚开始就联系不上了",
            "narrator_zh": ""
        },
        {
            "location": "232/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "233/TALK",
            "narrator": "アーヤ",
            "text": "昨日の夜から行方不明ってこと！？",
            "zh": "就是说从昨晚起就下落不明了！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "235/SEL",
            "narrator": "",
            "text": "だから心配してる",
            "zh": "所以我才担心",
            "narrator_zh": ""
        },
        {
            "location": "236/ACT",
            "narrator": "",
            "text": "だから心配してる",
            "zh": "所以我才担心",
            "narrator_zh": ""
        },
        {
            "location": "238/TALK",
            "narrator": "アーヤ",
            "text": "どうしよう…",
            "zh": "怎么办呀……",
            "narrator_zh": "绫水"
        },
        {
            "location": "239/TALK",
            "narrator": "アーヤ",
            "text": "あの子",
            "zh": "那孩子",
            "narrator_zh": "绫水"
        },
        {
            "location": "240/TALK",
            "narrator": "アーヤ",
            "text": "危ないことを時々してたのは知ってるけど",
            "zh": "虽然知道她时不时做些危险的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "241/TALK",
            "narrator": "アーヤ",
            "text": "まさかそれが原因？",
            "zh": "该不会是因为那个吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "242/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんは心当たりない？",
            "zh": "$handle$你有头绪吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "244/SEL",
            "narrator": "",
            "text": "さっぱりだよ",
            "zh": "完全摸不着头脑哦",
            "narrator_zh": ""
        },
        {
            "location": "245/ACT",
            "narrator": "",
            "text": "さっぱりだよ",
            "zh": "完全摸不着头脑哦",
            "narrator_zh": ""
        },
        {
            "location": "247/TALK",
            "narrator": "アーヤ",
            "text": "わかった",
            "zh": "知道了",
            "narrator_zh": "绫水"
        },
        {
            "location": "248/TALK",
            "narrator": "アーヤ",
            "text": "私も探してみるわ",
            "zh": "我也去找找看",
            "narrator_zh": "绫水"
        },
        {
            "location": "260/TALK",
            "narrator": "真幌",
            "text": "…何かあったのか？",
            "zh": "……出什么事了吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "262/TALK",
            "narrator": "アーヤ",
            "text": "大変です。\nみやびが、昨日の夜から\n行方がわかりません。",
            "zh": "大事不好。\n雅从昨晚开始\n就下落不明了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "263/TALK",
            "narrator": "真幌",
            "text": "…なんだと？\nＷＡＶＥで連絡は\n取れないのか？",
            "zh": "……什么？\n用WAVE都联系\n不上吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "264/TALK",
            "narrator": "アーヤ",
            "text": "スマホを置いていった\nみたいなんです。",
            "zh": "手机好像\n被她落下了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "265/TALK",
            "narrator": "アーヤ",
            "text": "まったく、何考えてるのよ\nあの子ってば…。",
            "zh": "真是的，那孩子\n到底在想什么呀……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "266/TALK",
            "narrator": "真幌",
            "text": "部屋を改めて見るか。\n何か手がかりがあるかも\nしれんし。",
            "zh": "再去看一遍她的房间。\n说不定能找到\n什么线索。",
            "narrator_zh": "真幌"
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "…いえ、やめましょう。",
            "zh": "……不，还是算了吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "268/TALK",
            "narrator": "アーヤ",
            "text": "あの子の部屋の惨状は、\n館長も知っていますよね？",
            "zh": "那孩子房间的惨状，\n馆长您也是知道的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "269/TALK",
            "narrator": "真幌",
            "text": "…そうだな。\n仮にあったとしても\n気付かないか…。",
            "zh": "……是啊。\n就算有什么\n也发现不了吧……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "270/TALK",
            "narrator": "真幌",
            "text": "よし、私は車で学校の方を\n周りながら、ネカフェを\n周ってみるとしよう。",
            "zh": "好，我开车绕学校\n那边转转，顺便把\n网吧也找一遍。",
            "narrator_zh": "真幌"
        },
        {
            "location": "271/TALK",
            "narrator": "アーヤ",
            "text": "私も、近所を探しながら\n秋葉原の方まで行って\nみます。",
            "zh": "我在附近找一找，\n然后往秋叶原那边\n走一趟。",
            "narrator_zh": "绫水"
        },
        {
            "location": "272/TALK",
            "narrator": "真幌",
            "text": "ああ、よろしく頼む。",
            "zh": "好，那就拜托了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "273/TALK",
            "narrator": "アーヤ",
            "text": "みやび…いったい、\n何があったのかしら…？",
            "zh": "雅……到底\n出了什么事呀……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "95/DIALOG",
