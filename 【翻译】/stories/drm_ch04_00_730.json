  {
   "location": "242/TALK",
   "narrator": "アーヤ",
   "text": "$handle$さんは心当たりない？",
   "zh": "$handle$你有头绪吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "244/SEL",
   "narrator": "",
   "text": "さっぱりだよ",
   "zh": "完全摸不着头脑哦",
   "narrator_zh": ""
  },
  {
   "location": "245/ACT",
   "narrator": "",
   "text": "さっぱりだよ",
   "zh": "完全摸不着头脑哦",
   "narrator_zh": ""
  },
  {
   "location": "247/TALK",
   "narrator": "アーヤ",
   "text": "わかった",
   "zh": "知道了",
   "narrator_zh": "绫水"
  },
  {
   "location": "248/TALK",
   "narrator": "アーヤ",
   "text": "私も探してみるわ"
  },
  {
   "location": "260/TALK",
   "narrator": "真幌",
   "text": "…何かあったのか？",
   "zh": "……出什么事了吗？",
   "narrator_zh": "真幌"
  },
  {
   "location": "262/TALK",
   "narrator": "アーヤ",
   "text": "大変です。\nみやびが、昨日の夜から\n行方がわかりません。"
  },
  {
   "location": "263/TALK",
   "narrator": "真幌",
   "text": "…なんだと？\nＷＡＶＥで連絡は\n取れないのか？",
   "zh": "……什么？\n用WAVE都联系\n不上吗？",
   "narrator_zh": "真幌"
  },
  {
   "location": "264/TALK",
   "narrator": "アーヤ",
   "text": "スマホを置いていった\nみたいなんです。"
  },
  {
   "location": "265/TALK",
   "narrator": "アーヤ",
   "text": "まったく、何考えてるのよ\nあの子ってば…。"
  },
  {
   "location": "266/TALK",
   "narrator": "真幌",
   "text": "部屋を改めて見るか。\n何か手がかりがあるかも\nしれんし。"
  },
  {
   "location": "267/TALK",
   "narrator": "アーヤ",
   "text": "…いえ、やめましょう。"
  },
  {
   "location": "268/TALK",
   "narrator": "アーヤ",
   "text": "あの子の部屋の惨状は、\n館長も知っていますよね？"
  },
  {
   "location": "269/TALK",
   "narrator": "真幌",
   "text": "…そうだな。\n仮にあったとしても\n気付かないか…。"
  },
  {
   "location": "270/TALK",
   "narrator": "真幌",
   "text": "よし、私は車で学校の方を\n周りながら、ネカフェを\n周ってみるとしよう。"
  },
  {
   "location": "271/TALK",
   "narrator": "アーヤ",
   "text": "私も、近所を探しながら\n秋葉原の方まで行って\nみます。"
  },
  {
   "location": "272/TALK",
   "narrator": "真幌",
   "text": "ああ、よろしく頼む。"
  },
  {
   "location": "273/TALK",
   "narrator": "アーヤ",
   "text": "みやび…いったい、\n何があったのかしら…？"
  },
