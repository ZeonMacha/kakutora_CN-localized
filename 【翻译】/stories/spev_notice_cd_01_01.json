{
    "dir": "chap00/daydra/spev_notice_cd_01_01.js",
    "type": "",
    "info": {
        "story_id": "91051",
        "cid": "",
        "title": "001 アフターストーリー",
        "sub_title": "神楽坂トライナリー",
        "title_zh": "001 后日谈",
        "sub_title_zh": "神乐坂三重奏"
    },
    "entry": [
        {
            "location": "18/DIALOG",
            "narrator": "",
            "text": "<color=green>某月某日　1:33 PM</color>\nとある休日、神楽坂トライナリー倉庫にて。",
            "zh": "<color=green>某月某日　1:33 PM</color>\n某休息日，在神乐坂三重奏的仓库。",
            "narrator_zh": ""
        },
        {
            "location": "19/TALK",
            "narrator": "真幌",
            "text": "うーん、おかしい…。\n確かこの辺りにしまって\nおいたはずなんだが…。",
            "zh": "唔，奇怪了……。\n我记得明明就收在\n这一带才对啊……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "22/TALK",
            "narrator": "つばめ",
            "text": "真幌さん、ちょっとは\n倉庫も整理しないと…。",
            "zh": "真幌，多少也得\n整理一下仓库才行呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "23/TALK",
            "narrator": "真幌",
            "text": "中々暇がなくてな。\nん？　この箱は…。",
            "zh": "一直抽不出空啊。\n嗯？　这个箱子是……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "27/TALK",
            "narrator": "真幌",
            "text": "これは…、懐かしい物が\n出てきたな。",
            "zh": "这可真是……，翻出了\n令人怀念的东西啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "28/TALK",
            "narrator": "つばめ",
            "text": "何が出てきたんですか？",
            "zh": "翻出什么来了呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "30/TALK",
            "narrator": "真幌",
            "text": "ああ…昔、うちの劇場で\n使ってた食器だ。",
            "zh": "哦……是以前我们剧场\n用过的餐具。",
            "narrator_zh": "真幌"
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "…食器？",
            "zh": "……餐具？",
            "narrator_zh": "燕"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "へぇ…まだ綺麗だけど、\nデザインがちょっと\n古くない？",
            "zh": "唔……虽然还挺干净的，\n但款式是不是\n有点老气了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "真幌",
            "text": "当然だ。\n私が生まれる前から\n使ってた物だからな。",
            "zh": "那当然。\n毕竟这可是从我出生前\n就在用的东西了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "こんなに沢山、\nカフェやっちょった\nわけでもなかろうに…。",
            "zh": "这么一大堆餐具，\n总不至于是以前真在\n开咖啡馆啵……。",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "真幌",
            "text": "やってたぞ。",
            "zh": "还真开过。",
            "narrator_zh": "真幌"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "はい？",
            "zh": "啊？",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "真幌",
            "text": "劇場のホワイエでな、\nちょっとしたカフェを\nやってた時期があるんだ。",
            "zh": "在剧场的门厅那块儿，\n以前有段时间开过\n一家小咖啡馆。",
            "narrator_zh": "真幌"
        },
        {
            "location": "60/TALK",
            "narrator": "アーヤ",
            "text": "そうだったんですか？\n初めて聞きました。",
            "zh": "还有过这种事吗？\n我还是头一次听说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "真幌",
            "text": "私が子供の時に営業を\nやめてしまったからな。",
            "zh": "因为在我还是孩子的时候\n就已经停业了嘛。",
            "narrator_zh": "真幌"
        },
        {
            "location": "63/TALK",
            "narrator": "真幌",
            "text": "これを見つけるまで、\n私もすっかり忘れていた。",
            "zh": "在翻出这东西之前，\n连我自己也忘得一干二净了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな楽しそうなこと\nしてたなんて…。\nなんで辞めちゃったのよ？",
            "zh": "居然办过听起来这么有意思\n的事啊……。\n干嘛停掉了嘛？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "真幌",
            "text": "知らんよ。\n私は子供だったからな。",
            "zh": "鬼知道。\n那时我还是个孩子嘛。",
            "narrator_zh": "真幌"
        },
        {
            "location": "66/TALK",
            "narrator": "真幌",
            "text": "まあ、もう使うことも\nないだろうし…。\n思い切って処分するか。",
            "zh": "算了，反正今后应该也\n用不上了……。\n干脆痛痛快快处理掉吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "68/TALK",
            "narrator": "つばめ",
            "text": "いいんですか？\nこれ、思い出の詰まった\n食器なんじゃ…。",
            "zh": "这样可以吗？\n这可是寄托着满满回忆的\n餐具吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "69/TALK",
            "narrator": "真幌",
            "text": "思い出はあるが、\nさすがに多すぎる。",
            "zh": "回忆归回忆，\n数量实在太多了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "70/TALK",
            "narrator": "真幌",
            "text": "第一、使わない物を\n取っておいても、\n仕方がないからな。",
            "zh": "再说，留着派不上用场的\n东西，也是白占地方\n嘛。",
            "narrator_zh": "真幌"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "勿体ないわね。\nそんなこと言わないで――",
            "zh": "多可惜呀。\n别这么说嘛——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "カフェの営業を\n再開すればいいじゃない。",
            "zh": "重新把咖啡馆\n开起来不就好了吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "真幌",
            "text": "…は？",
            "zh": "……啊？",
            "narrator_zh": "真幌"
        },
        {
            "location": "76/TALK",
            "narrator": "つばめ",
            "text": "わぁ、それ楽しそう！",
            "zh": "哇，那听起来好好玩！",
            "narrator_zh": "燕"
        },
        {
            "location": "78/TALK",
            "narrator": "真幌",
            "text": "おいおいおい、\n冗談だろ？",
            "zh": "喂喂喂，\n开玩笑的吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん、本気よ。\n劇場の仕事は退屈で、\n正直飽きてたとこだし…。",
            "zh": "才不是，我是认真的。\n剧场的活儿无聊死了，\n说实话我早就腻了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "真幌",
            "text": "…アーヤ、おまえからも\nなんとか言ってやって\nくれないか？",
            "zh": "……绫水，你也帮忙\n劝劝这家伙\n行不行？",
            "narrator_zh": "真幌"
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "え、えっと…。",
            "zh": "哎、那个……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "真幌",
            "text": "…おまえもギャヴィと\n同じ意見か？",
            "zh": "……你也跟加维\n一个想法吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "87/TALK",
            "narrator": "アーヤ",
            "text": "すみません…。",
            "zh": "不好意思……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "でも、ここ最近いろいろ\nありましたし",
            "zh": "不过，最近这段时间\n发生了这么多事",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "みんなで一緒に、\n何か今までと違うことを\nやるのもアリかなって。",
            "zh": "我觉得大家一起，\n尝试做点跟以往不同的事\n好像也挺不错的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "真幌",
            "text": "…なるほど。\nみやびは？",
            "zh": "……原来如此。\n雅呢？",
            "narrator_zh": "真幌"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "うちが言いたいことは、\nだいたいアーヤが言うて\nくれたき、あとは――",
            "zh": "我想说的话，\n绫水大概都替我\n讲完啵，剩下的——",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "カフェっちゅうことは\nケーキは必須やろ？",
            "zh": "既然是开咖啡馆，\n蛋糕肯定是少不了的啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "なら、うちは大賛成ちや。",
            "zh": "那我可是大赞成滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "95/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんは…。",
            "zh": "神乐她……。",
            "narrator_zh": "燕"
        },
        {
            "location": "97/TALK",
            "narrator": "つばめ",
            "text": "あれ？",
            "zh": "咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "116/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "117/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃん。",
            "zh": "神乐。",
            "narrator_zh": "燕"
        },
        {
            "location": "122/TALK",
            "narrator": "つばめ",
            "text": "どうしたの？\nこんな隅っこで…。",
            "zh": "怎么了呀？\n一个人待在角落里……。",
            "narrator_zh": "燕"
        },
        {
            "location": "124/TALK",
            "narrator": "神楽",
            "text": "あ、いえ別に…。",
            "zh": "啊，没什么……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "126/TALK",
            "narrator": "つばめ",
            "text": "ほら、神楽ちゃんも\nこっちに来て、\n一緒に話そうよ。",
            "zh": "来嘛，神乐也\n过来这边，\n大家一起聊呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "127/TALK",
            "narrator": "神楽",
            "text": "わ、私はいいです。\n皆さんで決めて\nいただければ――",
            "zh": "我、我就不用了。\n由你们大家来决定\n就好——",
            "narrator_zh": "神乐"
        },
        {
            "location": "128/TALK",
            "narrator": "つばめ",
            "text": "そんなのダメだよ。\nみんな一緒に決めないと\n面白くないし。",
            "zh": "那可不行哦。\n不大家一起决定的话\n就没意思了嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "129/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ちょっと、そこの二人。\n早くしなさいよ。",
            "zh": "喂，那边的两个。\n快点过来啦。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "130/TALK",
            "narrator": "つばめ",
            "text": "あ、はーい！\nほら神楽ちゃん、行こ。",
            "zh": "啊，来啦—！\n走吧神乐，过去咯。",
            "narrator_zh": "燕"
        },
        {
            "location": "132/TALK",
            "narrator": "神楽",
            "text": "わわっ、そんな強引に！",
            "zh": "哇哇，别这么硬拽呀！",
            "narrator_zh": "神乐"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "――で？\nつばめは勿論賛成よね？",
            "zh": "——所以呢？\n燕你当然是赞成的对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "153/TALK",
            "narrator": "つばめ",
            "text": "もちろんだよ！",
            "zh": "那当然啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "155/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "157/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、神楽。\nあんたはどうなのよ？",
            "zh": "喂，神乐。\n你觉得怎么样嘛？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "161/TALK",
            "narrator": "神楽",
            "text": "えっ？",
            "zh": "哎？",
            "narrator_zh": "神乐"
        },
        {
            "location": "164/TALK",
            "narrator": "神楽",
            "text": "あ、はい。\nとっても楽しそうだと\n思います。",
            "zh": "啊，是的。\n我觉得听起来\n非常有意思。",
            "narrator_zh": "神乐"
        },
        {
            "location": "166/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "でも、現実問題\nそう簡単にカフェ営業って\nできるのかしら？",
            "zh": "不过，话又说回来，\n开咖啡馆真能那么\n轻易就办起来吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "アーヤ",
            "text": "運営資金のことも\n考えないといけないし…。",
            "zh": "运营资金的事\n也得考虑进去才行……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "171/TALK",
            "narrator": "ガブリエラ",
            "text": "その辺はまほが出すに\n決まってるでしょ。",
            "zh": "那笔钱肯定由\n真幌来出吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "アーヤ",
            "text": "そんな無責任な…。",
            "zh": "这也太不负责任了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "175/TALK",
            "narrator": "真幌",
            "text": "ふむ…場所と食器は\n揃っているから\n問題ないとして。",
            "zh": "嗯……场地和餐具\n都是现成的，\n这方面没问题。",
            "narrator_zh": "真幌"
        },
        {
            "location": "176/TALK",
            "narrator": "真幌",
            "text": "あとは調理用の設備に\n材料費、インテリアと\nその他雑費諸々として…。",
            "zh": "剩下的就是烹饪设备、\n食材费、装潢布置还有\n其他杂七杂八的开销……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "178/TALK",
            "narrator": "真幌",
            "text": "…よし、わかった。\nそっちの方は私が\nどうにかしよう。",
            "zh": "……好，我知道了。\n那方面的资金就由我\n来想办法吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "180/TALK",
            "narrator": "アーヤ",
            "text": "本当ですか！？",
            "zh": "真的吗！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "181/TALK",
            "narrator": "みやび",
            "text": "まほさん、いつになく\n太っ腹やね。",
            "zh": "真幌，今天难得\n这么大方咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "真幌",
            "text": "…色々あったからな。",
            "zh": "……毕竟经历了这么多事嘛。",
            "narrator_zh": "真幌"
        },
        {
            "location": "185/TALK",
            "narrator": "真幌",
            "text": "みんなで協力して\n何かしようというのは、\nいいことだと思う。",
            "zh": "大家齐心协力\n一起去做成一件事，\n我觉得挺不错的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "189/TALK",
            "narrator": "ガブリエラ",
            "text": "やった！\nじゃあ、カフェをやるのは\nコレで決まりね！",
            "zh": "太棒了！\n那开咖啡馆这件事，\n就这样拍板定下来了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "みやび",
            "text": "それしか解決しちょらん\n言うた方が正しいと\n思うけんどな。",
            "zh": "不过要我说，\n说成目前也就只解决了\n那一桩才对咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "192/TALK",
            "narrator": "つばめ",
            "text": "食器もありますよね？",
            "zh": "而且餐具也有了对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "194/TALK",
            "narrator": "神楽",
            "text": "あ、でも…。",
            "zh": "啊，不过……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "ん？　どうかしたの？",
            "zh": "嗯？　怎么了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "神楽",
            "text": "あ、いえ…。\nなんでもありません…。",
            "zh": "啊，不……。\n没什么……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "199/TALK",
            "narrator": "ガブリエラ",
            "text": "言いかけてやめられたら\n気持ち悪いでしょ？\nハッキリ言いなさい！",
            "zh": "话说到一半又咽回去\n多让人心痒啊？\n给我痛痛快快讲清楚！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "201/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "202/TALK",
            "narrator": "神楽",
            "text": "この食器ですけど、\nこのまま使うのは\nどうかと思いますよ？",
            "zh": "就是这套餐具，\n就这么直接拿来用\n是不是不太妥当呀？",
            "narrator_zh": "神乐"
        },
        {
            "location": "204/TALK",
            "narrator": "つばめ",
            "text": "え、どうして？",
            "zh": "咦，为什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "206/TALK",
            "narrator": "神楽",
            "text": "デザインがちょっと、\n今風じゃないですよね？",
            "zh": "款式稍微有点，\n不太符合现在的审美吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "208/TALK",
            "narrator": "神楽",
            "text": "なので、\n今あるデザインを\n生かしつつ――",
            "zh": "所以我在想，\n能不能在保留现有设计\n特色的同时——",
            "narrator_zh": "神乐"
        },
        {
            "location": "210/TALK",
            "narrator": "神楽",
            "text": "リデザインするのは\nどうかな、と…。",
            "zh": "试着重新设计一下，\n不知道行不行……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "211/TALK",
            "narrator": "つばめ",
            "text": "それ、面白そうだよ！\nやってみたいな。",
            "zh": "那个，感觉好有意思哦！\n我想试试看呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "213/TALK",
            "narrator": "アーヤ",
            "text": "けど、それって簡単に\nできることなの？",
            "zh": "可是，那件事真有那么\n容易办到吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/TALK",
            "narrator": "神楽",
            "text": "もちろん、業者さんに\nお願いすることに\nなりますけど――",
            "zh": "当然了，到时候肯定\n得委托外面的厂商\n来定制才行——",
            "narrator_zh": "神乐"
        },
        {
            "location": "216/TALK",
            "narrator": "神楽",
            "text": "それが難しそうなら\n流して下さい……。",
            "zh": "要是觉得太麻烦的话\n就当没听见好了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "面白そうじゃない！",
            "zh": "不是蛮有意思的嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "219/TALK",
            "narrator": "真幌",
            "text": "まあ、まずは\n見積を見るところ\nからだな……。",
            "zh": "嘛，总之还是得\n先从看报价单\n开始吧……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "221/TALK",
            "narrator": "みやび",
            "text": "けんど、うちらのなかで\nデザインなんぞ出来るヤツ\nおるが？",
            "zh": "但是，我们几个里头\n有哪个人会搞设计\n这种东西咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "ガブリエラ",
            "text": "別に、難しいデザインを\n作るわけじゃないわ。",
            "zh": "又不是要做多么复杂的\n设计嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "例えば、そうね…。\nカフェのロゴを作るとか？",
            "zh": "打个比方，对了……。\n像是做个咖啡馆的标志？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/TALK",
            "narrator": "アーヤ",
            "text": "あ、それ好きかも。",
            "zh": "啊，那个我可能会喜欢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤなら絶対こういうの\n好きだと思ったわ。",
            "zh": "我就知道绫水\n肯定会喜欢这种的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "230/TALK",
            "narrator": "真幌",
            "text": "ああ、カフェのロゴか。\nそれなら既にあるんだが。",
            "zh": "哦，咖啡馆的标志吗。\n那个的话其实已经有了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "232/TALK",
            "narrator": "ガブリエラ",
            "text": "ええっ！？\nそうだったの！？",
            "zh": "哎哎！？\n还有这回事！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "真幌",
            "text": "ああ。\nまあ、厳密には劇場の\nロゴなんだがな。",
            "zh": "嗯。\n嘛，严格来说其实\n是剧场的标志就是了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "234/TALK",
            "narrator": "真幌",
            "text": "前にカフェをやってた時は\n同じロゴでやっていた\nそうだ。",
            "zh": "听说以前开咖啡馆的时候\n用的也就是同一个\n标志。",
            "narrator_zh": "真幌"
        },
        {
            "location": "237/TALK",
            "narrator": "つばめ",
            "text": "えっ！？\n劇場のロゴなんて\nあったんですか！？",
            "zh": "咦！？\n原来还有剧场的标志\n这种东西吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "239/TALK",
            "narrator": "真幌",
            "text": "ああ、そうか。\nまだ誰にも見せたこと\nなかったか。",
            "zh": "啊，对了。\n好像还没给你们谁\n看过吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "245/TALK",
            "narrator": "真幌",
            "text": "ほら、これだ。\n私が生まれる前から\n使われているモノだぞ。",
            "zh": "喏，就是这个。\n这可是从我出生前\n就在用的东西了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "248/TALK",
            "narrator": "アーヤ",
            "text": "見たことないですよ。\nだって、劇場のどこにも\nないじゃないですか…。",
            "zh": "完全没见过啊。\n毕竟剧场里哪个角落\n都没挂着嘛……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "250/TALK",
            "narrator": "ガブリエラ",
            "text": "へえ、昔からある\nロゴの割りには、\n結構いい感じね。",
            "zh": "唔，作为流传这么久的\n标志来说，\n感觉还蛮不错的嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "そうやねぇ。\nうちもこのデザインは\n嫌いやないぞね。",
            "zh": "是咯。\n这个设计我倒也\n不讨厌咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "254/TALK",
            "narrator": "みやび",
            "text": "けんど…ちくっと\n真ん中ら辺りが\n寂しいような…。",
            "zh": "但是……稍微觉得\n正中间那一带\n有点空落落滴……。",
            "narrator_zh": "雅"
        },
        {
            "location": "259/TALK",
            "narrator": "みやび",
            "text": "こんな感じで模様入れたら\nえい感じと思わん？",
            "zh": "像这样添上点花纹，\n不觉得蛮好看咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "261/TALK",
            "narrator": "つばめ",
            "text": "素敵ですね。\n急にかわいくなった\n感じがします！",
            "zh": "真漂亮呀。\n一下子就有种\n变可爱了的感觉！",
            "narrator_zh": "燕"
        },
        {
            "location": "262/TALK",
            "narrator": "みやび",
            "text": "まほさん。\nロゴに手を加えるんも\nダメですか？",
            "zh": "真幌。\n往标志上添点改动\n也不得咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "264/TALK",
            "narrator": "真幌",
            "text": "これくらいなら構わんよ。\n私も、完成が少し楽しみに\nなってきたからな。",
            "zh": "这点程度倒无所谓。\n毕竟连我也有点\n期待做出来的样子了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "それじゃあ、とりあえず\nロゴを作るところから\n始めましょ。",
            "zh": "那好，总之先从\n设计标志这一步\n开始吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "271/TALK",
            "narrator": "つばめ",
            "text": "わかりました！\nどんなのにしようかなぁ？",
            "zh": "明白！\n要做成什么样子的好呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "272/TALK",
            "narrator": "真幌",
            "text": "考えるのは\n帰ってからにしろ。",
            "zh": "要琢磨的话\n等回家再说。",
            "narrator_zh": "真幌"
        },
        {
            "location": "273/TALK",
            "narrator": "真幌",
            "text": "今日はもう遅い。\n話の続きは後日だな。",
            "zh": "今天已经不早了。\n后续的事改天再谈吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "275/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね。\nもうこんな時間だし…。",
            "zh": "说得也是。\n都已经这个点了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "277/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、今日のところは\n一度解散ね。",
            "zh": "那就这样，今天\n先到此解散吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "279/TALK",
            "narrator": "神楽",
            "text": "わかりました。\nそれじゃ皆さん、\nお疲れ様でした。",
            "zh": "我知道了。\n那么各位，\n辛苦啦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "285/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、ちょっと神楽！",
            "zh": "等、等等神乐！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "287/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。\nもう、何なのよあの子。",
            "zh": "唉……。\n真是的，那孩子是怎么回事嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/TALK",
            "narrator": "アーヤ",
            "text": "仕方ないわよ。\nあんなことがあった\nばかりだもの。",
            "zh": "这也是没办法的事。\n毕竟才刚发生过\n那样的事情啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "290/TALK",
            "narrator": "アーヤ",
            "text": "私が卯月でも、やっぱり\nちょっとまだ居づらいかも\nって思っちゃうかも。",
            "zh": "换作我是卯月，大概\n还是会觉得有点\n不好意思待下去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "292/TALK",
            "narrator": "つばめ",
            "text": "でも、みんな神楽ちゃんの\nことは、全然気にしない\nって言ってますし……。",
            "zh": "可是，大家明明都说了\n完全不介意神乐的\n事情了呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "294/TALK",
            "narrator": "みやび",
            "text": "うちらが気にせんゆうて、\nはいそうですかと\n受け入れられたら――",
            "zh": "就算我们嘴上说不在意，\n她要是真就“哦好嘞”地\n全盘接受了——",
            "narrator_zh": "雅"
        },
        {
            "location": "295/TALK",
            "narrator": "みやび",
            "text": "メンタル強すぎるにも\nほどがあるっちゅう話や。",
            "zh": "那这心理素质也未免\n强到没边了吧咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "297/TALK",
            "narrator": "つばめ",
            "text": "…真幌さん。\nなにかいい方法は\nありませんか？",
            "zh": "……真幌。\n没有什么好办法\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "299/TALK",
            "narrator": "真幌",
            "text": "ふむ…私は特に心配は\nしていないがな。",
            "zh": "嗯……我倒是\n没怎么担心。",
            "narrator_zh": "真幌"
        },
        {
            "location": "301/TALK",
            "narrator": "真幌",
            "text": "色々あったが、\n卯月は我々の元へ\n戻ってきてくれたんだ。",
            "zh": "虽说发生了很多事，\n但卯月还是回到了\n我们身边。",
            "narrator_zh": "真幌"
        },
        {
            "location": "302/TALK",
            "narrator": "真幌",
            "text": "なら、あとは時間が\n解決してくれる。\nそう思っているよ。",
            "zh": "既然如此，剩下的\n就交给时间去解决吧。\n我是这么想的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "317/TALK",
            "narrator": "神楽",
            "text": "ただいま…。",
            "zh": "我回来了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "319/TALK",
            "narrator": "神楽",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "331/TALK",
            "narrator": "神楽",
            "text": "つらい",
            "zh": "好难受",
            "narrator_zh": "神乐"
        },
        {
            "location": "332/TALK",
            "narrator": "神楽",
            "text": "ねえ、$handle$",
            "zh": "喂，$handle$",
            "narrator_zh": "神乐"
        },
        {
            "location": "333/TALK",
            "narrator": "神楽",
            "text": "肩揉んで",
            "zh": "帮我揉揉肩",
            "narrator_zh": "神乐"
        },
        {
            "location": "335/SEL",
            "narrator": "（選択肢）",
            "text": "ちょっと無理かも",
            "zh": "可能有点难办",
            "narrator_zh": "（选项）"
        },
        {
            "location": "336/SEL",
            "narrator": "（選択肢）",
            "text": "今は肩たたきチケット1枚で許して",
            "zh": "现在先拿1张捶肩券顶一下行吗",
            "narrator_zh": "（选项）"
        },
        {
            "location": "337/SEL",
            "narrator": "（選択肢）",
            "text": "胸の間違いでは…？",
            "zh": "该不会是想说胸……？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "338/ACT",
            "narrator": "",
            "text": "ちょっと無理かも",
            "zh": "可能有点难办",
            "narrator_zh": ""
        },
        {
            "location": "339/TALK",
            "narrator": "神楽",
            "text": "知ってた",
            "zh": "早就知道了",
            "narrator_zh": "神乐"
        },
        {
            "location": "340/TALK",
            "narrator": "神楽",
            "text": "けどつまんない答え",
            "zh": "不过真是个无聊的回答",
            "narrator_zh": "神乐"
        },
        {
            "location": "341/TALK",
            "narrator": "神楽",
            "text": "はーーーーーーー",
            "zh": "哈———————",
            "narrator_zh": "神乐"
        },
        {
            "location": "342/ACT",
            "narrator": "",
            "text": "今は肩たたきチケット1枚で許して",
            "zh": "现在先拿1张捶肩券顶一下行吗",
            "narrator_zh": ""
        },
        {
            "location": "343/TALK",
            "narrator": "神楽",
            "text": "１まいにつき１２時間分で！！",
            "zh": "每1张按12小时算！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "344/TALK",
            "narrator": "神楽",
            "text": "待ってるぴょん♪",
            "zh": "等着你pyon♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "345/ACT",
            "narrator": "",
            "text": "胸の間違いでは…？",
            "zh": "该不会是想说胸……？",
            "narrator_zh": ""
        },
        {
            "location": "346/TALK",
            "narrator": "神楽",
            "text": "おいクズ",
            "zh": "喂，人渣",
            "narrator_zh": "神乐"
        },
        {
            "location": "347/TALK",
            "narrator": "神楽",
            "text": "世の中にはTPOってもんがあるんだよ、クズ",
            "zh": "这世上可是讲究时间场合的啊，人渣",
            "narrator_zh": "神乐"
        },
        {
            "location": "348/TALK",
            "narrator": "神楽",
            "text": "私じゃなかったら殺されててもおかしくないからね？",
            "zh": "换作别人不是我，你被杀掉都不奇怪吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "351/SEL",
            "narrator": "（選択肢）",
            "text": "話は終わり？",
            "zh": "说完了吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "352/ACT",
            "narrator": "",
            "text": "話は終わり？",
            "zh": "说完了吗？",
            "narrator_zh": ""
        },
        {
            "location": "354/TALK",
            "narrator": "神楽",
            "text": "もしかして今忙しい？",
            "zh": "你该不会现在很忙吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "356/SEL",
            "narrator": "（選択肢）",
            "text": "ヒマ",
            "zh": "闲得很",
            "narrator_zh": "（选项）"
        },
        {
            "location": "357/SEL",
            "narrator": "（選択肢）",
            "text": "超忙しい",
            "zh": "超级忙",
            "narrator_zh": "（选项）"
        },
        {
            "location": "358/SEL",
            "narrator": "（選択肢）",
            "text": "神楽のためならいくらでも時間あけるよ",
            "zh": "为了神乐我随时都能腾出时间",
            "narrator_zh": "（选项）"
        },
        {
            "location": "359/ACT",
            "narrator": "",
            "text": "ヒマ",
            "zh": "闲得很",
            "narrator_zh": ""
        },
        {
            "location": "360/TALK",
            "narrator": "神楽",
            "text": "知ってた",
            "zh": "早就知道了",
            "narrator_zh": "神乐"
        },
        {
            "location": "361/TALK",
