        "title": "016 ココロスフィアストーリー【Lv06】",
        "sub_title": "チャプター９＜提起＞",
        "title_zh": "016 心灵领域故事【Lv06】",
        "sub_title_zh": "第9章＜提起＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "壊されるココロ３",
            "zh": "被弄坏的心3",
            "narrator_zh": ""
        },
        {
            "location": "14/DIALOG",
            "narrator": "",
            "text": "<size=40>DOOR-No. 502</size>\nGABRIELLA\n\n<size=45>壊されるココロ</size>\n<size=35>～暗黒世界～</size>",
            "zh": "<size=40>DOOR-No. 502</size>\n加布里埃拉\n\n<size=45>被弄坏的心</size>\n<size=35>～暗黑世界～</size>",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "来たわね。",
            "zh": "你来了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "27/SEL",
            "narrator": "（選択肢）",
            "text": "これが？",
            "zh": "这就是？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "28/ACT",
            "narrator": "",
            "text": "これが？",
            "zh": "这就是？",
            "narrator_zh": ""
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ。\nあたしのココロの中に\nある暗黒部分。",
            "zh": "对。\n我心里的\n暗黑部分。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "この中に何があるか\nもはやあたしにすら\n知る術は無いの。",
            "zh": "这里面藏着什么，\n现在连我自己\n也无从得知。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "もっとも知る気なんて\nサラサラ無いけど。",
            "zh": "虽说我也压根\n不想知道就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかく、一刻も早く\n片付けたいところ\nなんだけど……",
            "zh": "总之，真想一刻不耽搁地\n解决掉\n这里——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/SEL",
            "narrator": "（選択肢）",
            "text": "けど？",
            "zh": "可是？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "35/ACT",
            "narrator": "",
            "text": "けど？",
            "zh": "可是？",
            "narrator_zh": ""
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "こんな暗黒ですら\nそれを守るクランが\nいるの。",
            "zh": "哪怕是这样的黑暗，\n也有守护它的\n库兰在。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "ガブリエラ",
            "text": "まずはそいつらと\n戦わないと、\n手が出せない。",
            "zh": "要是不先打倒\n那些家伙，\n根本无从下手。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "39/TALK",
            "narrator": "ガブリエラ",
            "text": "準備はいい！？",
            "zh": "准备好了吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "40/SEL",
            "narrator": "（選択肢）",
            "text": "もちろん！",
            "zh": "当然！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "41/ACT",
            "narrator": "",
            "text": "もちろん！",
            "zh": "当然！",
            "narrator_zh": ""
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "pojmowanie.",
            "zh": "pojmowanie.",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ\n行くわよ！",
            "zh": "那就\n上吧！",
            "narrator_zh": "加布里埃拉"
        }
    ]
}
