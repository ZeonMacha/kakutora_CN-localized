{
    "dir": "chap00/daydra/spev_ch03_019.js",
    "type": "EventQuest",
    "info": {
        "story_id": "91014",
        "cid": "gabriella",
        "title": "【期間限定】誕生日イベント",
        "sub_title": "ガブリエラの誕生日",
        "title_zh": "【限时】生日活动",
        "sub_title_zh": "加布里埃拉的生日"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "ガブリエラの誕生日（復元）",
            "zh": "加布里埃拉的生日（复原）",
            "narrator_zh": ""
        },
        {
            "location": "20/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしたの？\nなにか用事？",
            "zh": "怎么了？\n有什么事吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "22/SEL",
            "narrator": "",
            "text": "お誕生日おめでとう！",
            "zh": "生日快乐！",
            "narrator_zh": ""
        },
        {
            "location": "23/ACT",
            "narrator": "",
            "text": "お誕生日おめでとう！",
            "zh": "生日快乐！",
            "narrator_zh": ""
        },
        {
            "location": "25/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ？",
            "zh": "诶？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あたしの誕生日、\n覚えてたの…？",
            "zh": "你、你记得\n我的生日啊……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "27/TALK",
            "narrator": "ガブリエラ",
            "text": "そっか…。\nふふっ、さすがは\nマルサンナね！",
            "zh": "这样啊……\n呵呵，不愧是\n玛尔赞娜呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "28/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの誕生日を\n忘れずに覚えてるなんて\n思わなかったわ。",
            "zh": "真没想到你\n一直没忘、\n还记着我的生日。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、えっと……\n一応、ありがと…。",
            "zh": "啊、那个……\n姑且，谢了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "30/SEL",
            "narrator": "",
            "text": "プレゼントもあるよ",
            "zh": "还有礼物哦",
            "narrator_zh": ""
        },
        {
            "location": "31/ACT",
            "narrator": "",
            "text": "プレゼントもあるよ",
            "zh": "还有礼物哦",
            "narrator_zh": ""
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "ぷ、プレゼントまで\n用意してくれてたの！？",
            "zh": "你、你连礼物\n都替我准备好了！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "これ、\n開けていいのよね？",
            "zh": "这个，\n我可以打开吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/SEL",
            "narrator": "",
            "text": "もちろんだよ",
            "zh": "当然可以",
            "narrator_zh": ""
        },
        {
            "location": "38/ACT",
            "narrator": "",
            "text": "もちろんだよ",
            "zh": "当然可以",
            "narrator_zh": ""
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そうよね。\nあたしへのプレゼント\nなんだし。",
            "zh": "也、也是呢。\n本来就是\n给我的礼物嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ、なにが\n入ってるのかしら？",
            "zh": "呵呵，里面到底\n装了什么呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "50/DIALOG",
            "narrator": "",
            "text": "ガブリエラのコスチューム\n<size=40><color=red><b>カプクラＴシャツ</b></color></size>\nをゲットしました！",
            "zh": "加布里埃拉的服装\n<size=40><color=red><b>卡普库拉T恤</b></color></size>\n拿到了！[?]",
            "narrator_zh": ""
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？\nこれって…。",
            "zh": "诶！？\n这个是……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "これ、ジオンちゃん？\nカプクラのジオンちゃん\nＴシャツよね！？",
            "zh": "这是，吉翁？\n卡普库拉的吉翁\nT恤对吧！？[?]",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "スゴいわ！\nあたし、この子が\n一番大好きなの。",
            "zh": "太厉害了！\n这孩子可是我\n最喜欢的一个。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "57/TALK",
            "narrator": "ガブリエラ",
            "text": "それに…こういう絵の\n描いてあるシャツ、\n前から欲しかったし。",
            "zh": "而且……印着这种\n图案的T恤，\n我早就很想要了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "だって、ザ・日本！\nって感じじゃない？",
            "zh": "因为，这不很有\n“The・日本！”的感觉吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "でも…自分で買いに\n行くのはちょっと、\n恥ずかしくて…。",
            "zh": "只是……自己去店里买\n总觉得有点\n不好意思……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか、こんな形で\n手に入れるとは\n思わなかったわ。",
            "zh": "真没想到，居然能\n以这种形式\n拿到手。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、誕生日プレゼント\nとしては、ムードに欠け\nる",
            "zh": "嘛，作为生日礼物\n来说，是缺了点\n气氛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "気がするけど…。",
            "zh": "的感觉就是了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "…ありがと、\nマルサンナ。\n大切にするわ。",
            "zh": "……谢谢，\n玛尔赞娜。\n我会好好珍惜的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "69/DIALOG",
            "narrator": "",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已连接。\n\n点击画面，向对方\n传达感觉吧。",
            "narrator_zh": ""
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "んっ！？",
            "zh": "嗯！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "きゅ、急だったから、\nちょっとドキッと\nしちゃったわ…。",
            "zh": "突、突然这样，\n吓得我心跳都\n漏了一拍……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/DIALOG",
            "narrator": "",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已断开。",
            "narrator_zh": ""
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "は、はいはい！\n触るのはここまで！",
            "zh": "好、好啦好啦！\n摸到这里为止！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "恥ずかしくって、\n暑くなって来ちゃった…。",
            "zh": "害羞得\n脸都发烫了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/SEL",
            "narrator": "",
            "text": "イヤだった？",
            "zh": "讨厌这样吗？",
            "narrator_zh": ""
        },
        {
            "location": "95/ACT",
            "narrator": "",
            "text": "イヤだった？",
            "zh": "讨厌这样吗？",
            "narrator_zh": ""
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなこと――",
            "zh": "才没有——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "…ば、バカ。\n本当にイヤだったら、\nとっくに怒ってるわよ。",
            "zh": "……笨、笨蛋。\n要是真讨厌的话，\n早就对你发火了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "それくらい、言わなくて\nも\nわかるでしょ？",
            "zh": "这点事，不用说\n你也\n懂的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "…マルサンナが\nくれたシャツ、\n大切に着るわ。",
            "zh": "……玛尔赞娜\n送我的T恤，\n我会好好珍惜着穿的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "101/TALK",
            "narrator": "ガブリエラ",
            "text": "本当、ありがとね…。\n祝ってもらえて、\nとっても嬉しかったわ。",
            "zh": "真的，谢谢你……\n能得到你的祝福，\n我非常开心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "今から来年の誕生日を\n楽しみにしてるわね、\nふふっ…。",
            "zh": "从现在开始我就\n期待起明年的生日了哦，\n呵呵……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/DIALOG",
            "narrator": "",
            "text": "コスチューム\n<color=green>【カプクラＴシャツ】</color>は、\n夜時間にパジャマとして\n着せることができます。",
            "zh": "服装\n<color=green>【卡普库拉T恤】</color>\n可以在夜晚时段当作睡衣\n穿上。[?]",
            "narrator_zh": ""
        }
    ]
}
