        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "これでいろいろ計画していたことが振り出しに戻りました。",
            "zh": "这样一来，之前计划的各种事情都回到起点了。",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "これは私にとって大変な痛手です。",
