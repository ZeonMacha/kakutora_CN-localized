        "title": "002 メインストーリー",
        "sub_title": "アーヤの午後＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "绫水的午后＜前篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "アーヤの午後",
            "zh": "绫水的午后",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "アーヤ",
            "text": "さてと、今日は午前で\n終わりだし――",
            "zh": "好了，今天上午\n就下课了——",
            "narrator_zh": "绫水"
        },
        {
            "location": "27/TALK",
            "narrator": "アーヤ",
            "text": "これからどうする？\n次の劇のことも\n話したいんだけど…。",
            "zh": "接下来有什么安排？\n我还想跟你聊聊\n下一场剧的事呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "小夜",
            "text": "ごっめーん！\n私、今日午後から\nバイト入ってるの。",
            "zh": "抱——歉！\n我今天下午\n排了打工呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "そっか…。\nじゃあ、話はまた\n今度ね。",
            "zh": "这样啊……。\n那这件事就\n下次再聊吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "小夜",
            "text": "だね。\nじゃ、また明日ね。",
            "zh": "嗯嗯。\n那就明天见啦。",
            "narrator_zh": "小夜"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "…じゃあ、買い物でも\n行こうかしら？",
            "zh": "……那我去逛逛街\n好了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "ん～、服を見に\n行くのはやめた方が\nいいかしら？",
            "zh": "唔～，还是别去看\n衣服了\n比较好吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "アーヤ",
            "text": "この前も買ったばかり\nなんだし…。",
            "zh": "前阵子才刚买过\n呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "55/TALK",
            "narrator": "アーヤ",
            "text": "でも、もしかしたら\n新作が出てるかも\nしれないわね。",
            "zh": "不过，说不定\n已经上新款了\n呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、見るだけなら\nタダなんだし、\n行ってみよう。",
            "zh": "……算了，光看不花钱，\n去看看\n吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "アーヤ",
            "text": "やだ、新作出てる！",
            "zh": "哎呀，真的上新款了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "このシャツ、この前\n買った白のパンツと\n合わせれば…。",
            "zh": "这件衬衫，要是和前几天\n买的那条白裤子\n搭在一起……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "アーヤ",
            "text": "って、ダメダメ。\n今日は見るだけって\n決めたんだから。",
            "zh": "不对，不行不行。\n今天说好了只是\n随便看看的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "ウェイトレス",
            "text": "そちら、本日入荷した\n新作ですよー。",
            "zh": "这件是今天刚到货的\n新款哦—。",
            "narrator_zh": "女服务员"
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "あ、はあ…。",
            "zh": "啊，是吗……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "ウェイトレス",
            "text": "上に羽織っても、\n直に着てもいい\nデザインになんです。",
            "zh": "这件不管是当外套披着，\n还是直接单穿都很好看的\n款式呢。",
            "narrator_zh": "女服务员"
        },
        {
            "location": "81/TALK",
            "narrator": "アーヤ",
            "text": "ですね…。\nとっても素敵だとは\n思うんですけど…。",
            "zh": "是啊……。\n我也觉得非常漂亮\n就是了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "82/TALK",
            "narrator": "ウェイトレス",
            "text": "よろしければ、\n試着だけでも\nどうですか？",
            "zh": "如果不介意的话，\n要不要先试穿\n看看呢？",
            "narrator_zh": "女服务员"
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "咦！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "試着なんかしたら、\n絶対に…。",
            "zh": "要是试穿了的话，\n绝对会……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "105/TALK",
            "narrator": "アーヤ",
            "text": "…結局、\n買っちゃった。",
            "zh": "……结果，\n还是买下来了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "106/TALK",
            "narrator": "アーヤ",
            "text": "今日は見るだけって\n決めてたのに…、\n意思が弱いなぁ…。",
            "zh": "明明决定好今天\n只看不买的……，\n意志真薄弱啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "107/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "108/TALK",
            "narrator": "アーヤ",
            "text": "まあ、いい買い物では\nあったかな？",
            "zh": "不过，也算是买了件\n好东西吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/TALK",
            "narrator": "店員",
            "text": "いらっしゃいませ。",
            "zh": "欢迎光临。",
            "narrator_zh": "店员"
        },
        {
            "location": "115/TALK",
            "narrator": "アーヤ",
            "text": "あ、こんにちは。",
            "zh": "啊，你好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "116/TALK",
            "narrator": "店員",
            "text": "何か、いいことでも\nあったようですね。",
            "zh": "看来您今天\n遇到什么好事了呢。",
            "narrator_zh": "店员"
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "ええ…ちょっと、\nいい買い物ができた\nので。",
            "zh": "嗯……因为稍微\n买到了些称心的\n东西。",
            "narrator_zh": "绫水"
        },
        {
            "location": "118/TALK",
            "narrator": "店員",
            "text": "そういうこと\nでしたか。",
            "zh": "原来是这样\n啊。",
            "narrator_zh": "店员"
        },
        {
            "location": "120/TALK",
            "narrator": "アーヤ",
            "text": "あはは…。",
            "zh": "啊哈哈……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "122/TALK",
            "narrator": "アーヤ",
            "text": "あ、注文だけど、\nバーニャカウダー\nお願いします。",
            "zh": "啊，点单的话，\n请给我来一份\n意式热沾酱蔬菜。",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "店員",
            "text": "かしこまりました。\n少々お待ちください。",
            "zh": "好的。\n请稍等片刻。",
            "narrator_zh": "店员"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "130/SEL",
            "narrator": "",
            "text": "結構楽しんでる？",
            "zh": "玩得挺开心？",
            "narrator_zh": ""
        },
        {
            "location": "131/ACT",
            "narrator": "",
            "text": "結構楽しんでる？",
            "zh": "玩得挺开心？",
            "narrator_zh": ""
        },
        {
            "location": "136/TALK",
            "narrator": "アーヤ",
            "text": "あら？",
            "zh": "哎呀？",
            "narrator_zh": "绫水"
        },
        {
            "location": "145/TALK",
            "narrator": "アーヤ",
            "text": "ええ(^^",
            "zh": "嗯(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "146/TALK",
            "narrator": "アーヤ",
            "text": "いい服も手に入れたし",
            "zh": "既买到了好看的衣服",
            "narrator_zh": "绫水"
        },
        {
            "location": "147/TALK",
            "narrator": "アーヤ",
            "text": "お気に入りのカフェにも来れたし",
            "zh": "又来到了喜欢的咖啡店",
            "narrator_zh": "绫水"
        },
        {
            "location": "148/TALK",
            "narrator": "アーヤ",
            "text": "最高の時間よ(*^o^*)",
            "zh": "简直是再棒不过的时光了(*^o^*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "151/SEL",
            "narrator": "",
            "text": "でも、一人で寂しくない？",
            "zh": "不过，一个人不会寂寞吗？",
            "narrator_zh": ""
        },
        {
            "location": "152/ACT",
            "narrator": "",
            "text": "でも、一人で寂しくない？",
            "zh": "不过，一个人不会寂寞吗？",
            "narrator_zh": ""
        },
        {
            "location": "154/TALK",
            "narrator": "アーヤ",
            "text": "全然（￣ー￣？）",
            "zh": "完全不会（￣ー￣？）",
            "narrator_zh": "绫水"
        },
        {
            "location": "155/TALK",
            "narrator": "アーヤ",
            "text": "寂しいと思ったことは一度もないわ(￣Д￣ )",
            "zh": "我一次都没有觉得寂寞过哦(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "156/TALK",
            "narrator": "アーヤ",
            "text": "一人の楽しみ方を心得てるだけよ",
            "zh": "我只是懂得怎么享受独处而已",
            "narrator_zh": "绫水"
        },
        {
            "location": "158/SEL",
            "narrator": "",
            "text": "なんか、ちょっとかっこいいかも",
            "zh": "总觉得，还有点帅呢",
            "narrator_zh": ""
        },
        {
            "location": "159/ACT",
            "narrator": "",
            "text": "なんか、ちょっとかっこいいかも",
            "zh": "总觉得，还有点帅呢",
            "narrator_zh": ""
        },
        {
            "location": "161/TALK",
            "narrator": "アーヤ",
            "text": "ありがと(￣∇￣*)ゞ",
            "zh": "谢谢(￣∇￣*)ゞ",
            "narrator_zh": "绫水"
        },
        {
            "location": "163/TALK",
            "narrator": "アーヤ",
            "text": "でも、一人でいるのが好きってわけじゃないから",
            "zh": "不过，我也不是特别喜欢一个人待着",
            "narrator_zh": "绫水"
        },
        {
            "location": "164/TALK",
            "narrator": "アーヤ",
            "text": "友達と一緒なのも好きだし(￣∇￣)",
            "zh": "跟朋友待在一起我也很喜欢呀(￣∇￣)",
            "narrator_zh": "绫水"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "まあ、本当は",
            "zh": "嘛，其实",
            "narrator_zh": "绫水"
        },
        {
            "location": "168/TALK",
            "narrator": "アーヤ",
            "text": "恋人と一緒の方が好きって言えれば",
            "zh": "要是能说“跟恋人在一起更喜欢”的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "アーヤ",
            "text": "もうちょっと大人っぽかったのかもしれないけど(｡-_-｡)",
            "zh": "或许会显得更成熟一点吧(｡-_-｡)",
            "narrator_zh": "绫水"
        },
        {
            "location": "171/SEL",
            "narrator": "",
            "text": "いないもんね",
            "zh": "毕竟没有嘛",
            "narrator_zh": ""
        },
        {
            "location": "172/ACT",
            "narrator": "",
            "text": "いないもんね",
            "zh": "毕竟没有嘛",
            "narrator_zh": ""
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "一々言わなくていいから(>_<)",
            "zh": "不用专门说出来啦(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "175/TALK",
            "narrator": "アーヤ",
            "text": "仕方ないのよ",
            "zh": "这也是没办法的事嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "176/TALK",
            "narrator": "アーヤ",
            "text": "好みのタイプの人がいないんだし(; ;)",
            "zh": "毕竟没有遇到合我心意类型的对象(; ;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "178/SEL",
            "narrator": "",
            "text": "アーヤのタイプって？",
            "zh": "绫水喜欢的类型是？",
            "narrator_zh": ""
        },
        {
            "location": "179/ACT",
            "narrator": "",
            "text": "アーヤのタイプって？",
            "zh": "绫水喜欢的类型是？",
            "narrator_zh": ""
        },
        {
            "location": "182/TALK",
            "narrator": "アーヤ",
            "text": "それは",
            "zh": "这个嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "184/TALK",
            "narrator": "アーヤ",
            "text": "うーん",
            "zh": "唔——",
            "narrator_zh": "绫水"
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。",
            "zh": "欢迎来到\n[心之扉]，\n$handle$。",
            "narrator_zh": "绫水"
        },
        {
            "location": "231/TALK",
            "narrator": "アーヤ",
            "text": "……って――",
            "zh": "……话虽如此——",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/TALK",
            "narrator": "アーヤ",
            "text": "今ってなにかココロの\n葛藤が起きるような\n出来事ってあったかしら。",
            "zh": "刚才有发生什么\n足以引起内心纠葛的\n事情吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "233/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんも、\nそんなこと聞かれたって\nわからないわよね。",
            "zh": "不过就算这么问\n$handle$，你大概也\n答不上来吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "234/TALK",
            "narrator": "アーヤ",
            "text": "わからないことは\n扉に聞くのが一番。",
            "zh": "搞不懂的事情，\n直接问门最省事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "236/TALK",
            "narrator": "アーヤ",
            "text": "早速扉をコールするわね。",
            "zh": "我这就来呼叫大门哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "241/TALK",
            "narrator": "アーヤ",
            "text": "オープンプロセス、\n0x271番地から\n0xC49番地へ。",
            "zh": "开放进程，\n从0x271号地址\n前往0xC49号地址。",
            "narrator_zh": "绫水"
        },
        {
            "location": "256/TALK",
            "narrator": "アーヤ",
            "text": "シーク完了。",
            "zh": "搜索完成。",
            "narrator_zh": "绫水"
        },
        {
            "location": "258/TALK",
            "narrator": "アーヤ",
            "text": "で？\n悩みの真相は……",
            "zh": "那么？\n烦恼的真相是……",
            "narrator_zh": "绫水"
        },
        {
            "location": "260/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "261/SEL",
            "narrator": "",
            "text": "え？",
            "zh": "咦？",
            "narrator_zh": ""
        },
        {
            "location": "262/ACT",
            "narrator": "",
            "text": "え？",
            "zh": "咦？",
            "narrator_zh": ""
        },
        {
            "location": "264/TALK",
            "narrator": "アーヤ",
            "text": "今回の葛藤の原因が\n貴方みたいなんだけど。",
            "zh": "这次内心纠葛的起因，\n好像就是你呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "265/SEL",
            "narrator": "",
            "text": "もしかして、好みのタイプを聞いたこと？",
            "zh": "难道说，是因为问了喜欢的类型？",
            "narrator_zh": ""
        },
        {
            "location": "266/ACT",
            "narrator": "",
            "text": "もしかして、好みのタイプを聞いたこと？",
            "zh": "难道说，是因为问了喜欢的类型？",
            "narrator_zh": ""
        },
        {
            "location": "268/TALK",
            "narrator": "アーヤ",
            "text": "そう。",
            "zh": "正是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "269/SEL",
            "narrator": "",
            "text": "クランが出るほど悩むことなの！？",
            "zh": "这算得上会冒出库兰的烦恼吗！？",
            "narrator_zh": ""
        },
        {
            "location": "270/ACT",
            "narrator": "",
            "text": "クランが出るほど悩むことなの！？",
            "zh": "这算得上会冒出库兰的烦恼吗！？",
            "narrator_zh": ""
        },
        {
            "location": "273/TALK",
            "narrator": "アーヤ",
            "text": "あー、そういうこと\n言っちゃうんだ。",
            "zh": "哎呀，你居然\n说出这种话啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "274/TALK",
            "narrator": "アーヤ",
            "text": "だいたいにおいて、\nあの聞き方はちょっと\nデリカシー無いと思うわ。",
            "zh": "说到底，我觉得\n你刚才那种问法\n有点欠缺分寸呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "275/TALK",
            "narrator": "アーヤ",
            "text": "例えBotであっても。",
            "zh": "就算对方是Bot也一样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "276/SEL",
            "narrator": "",
            "text": "変な例え",
            "zh": "奇怪的比喻",
            "narrator_zh": ""
        },
        {
            "location": "277/SEL",
            "narrator": "",
            "text": "まあ、そうだったかもね",
            "zh": "嘛，好像确实有点",
            "narrator_zh": ""
        },
        {
            "location": "278/ACT",
            "narrator": "",
            "text": "変な例え",
            "zh": "奇怪的比喻",
            "narrator_zh": ""
        },
        {
            "location": "280/TALK",
            "narrator": "アーヤ",
            "text": "どうして？",
            "zh": "为什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "281/SEL",
            "narrator": "",
            "text": "まるで、Botじゃないことをわかっていて合わせてるような言い方",
            "zh": "听起来就像明知道我不是Bot，却故意顺着话头说一样",
            "narrator_zh": ""
        },
        {
            "location": "282/ACT",
            "narrator": "",
            "text": "まるで、Botじゃないことをわかっていて合わせてるような言い方",
            "zh": "听起来就像明知道我不是Bot，却故意顺着话头说一样",
            "narrator_zh": ""
        },
        {
            "location": "285/TALK",
            "narrator": "アーヤ",
            "text": "実際、もう貴方がAIなんか\nじゃないってことは、\nみんなで話してるでしょ？",
            "zh": "事实上，你并不是什么\nAI这件事，大家私底下\n不也聊过吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "286/TALK",
            "narrator": "アーヤ",
            "text": "まあ現実の私はまだ\n否定的だけど……",
            "zh": "嘛，虽然现实里的我\n嘴上还在否认就是了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "287/TALK",
            "narrator": "アーヤ",
            "text": "だからといって、\nココロの中まで否定してる\nわけじゃないってことね。",
            "zh": "但这并不代表\n连内心深处也一起\n否定了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "290/TALK",
            "narrator": "アーヤ",
            "text": "あー、そうね。\nなかなか鋭いわね。",
            "zh": "啊，是啊。\n还挺敏锐的嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "291/TALK",
            "narrator": "アーヤ",
            "text": "現実の本人、そういう\n素振りは見せてないかも\nしれないけど――",
            "zh": "现实中的本人或许\n并没有表现出来\n就是了——",
            "narrator_zh": "绫水"
        },
        {
            "location": "292/TALK",
            "narrator": "アーヤ",
            "text": "貴方のこと、AIとかじゃ\nないってことは、ココロの\n中では薄々感づいてる。",
            "zh": "关于你并不是AI\n这件事，她内心深处\n其实隐约已经察觉到了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "293/TALK",
            "narrator": "アーヤ",
            "text": "けど、確証が持てないから\n今まで通り接してる\nっていうだけなのよ。",
            "zh": "只是因为没有确凿的证据，\n才姑且像以前一样\n相处罢了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "296/TALK",
            "narrator": "アーヤ",
            "text": "そういうわけだから、\nあんなこと聞かれたら\n意識しちゃうでしょ？",
            "zh": "正因如此，被你问起\n那种问题，她当然\n会在意的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "297/TALK",
            "narrator": "アーヤ",
            "text": "赤の他人でもない\n貴方なんだし。",
            "zh": "毕竟你对她来说，\n也不是什么不相干的陌生人呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "298/SEL",
            "narrator": "",
            "text": "意識しちゃうくらいの仲だって思っていていいの？",
            "zh": "那我可以认为我们已经是会互相在意的关系了吗？",
            "narrator_zh": ""
        },
        {
            "location": "299/ACT",
            "narrator": "",
            "text": "意識しちゃうくらいの仲だって思っていていいの？",
            "zh": "那我可以认为我们已经是会互相在意的关系了吗？",
            "narrator_zh": ""
        },
        {
            "location": "302/TALK",
            "narrator": "アーヤ",
            "text": "少なくとも、私の総意は\nそう思ってるわよ。",
            "zh": "至少，作为我内心的总体意志\n是这么认为的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "303/TALK",
            "narrator": "アーヤ",
            "text": "現実の自分は\n気づいてないと\n思うけど。",
            "zh": "虽然现实里的自己\n大概还没察觉到\n就是了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "304/ACT",
            "narrator": "",
            "text": "まあ、そうだったかもね",
            "zh": "嘛，好像确实有点",
            "narrator_zh": ""
        },
        {
            "location": "305/TALK",
            "narrator": "アーヤ",
            "text": "はい、反省しましたか？",
            "zh": "好啦，知道反省了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "307/TALK",
            "narrator": "アーヤ",
            "text": "それで本題に戻すとね。",
            "zh": "那么言归正传。",
            "narrator_zh": "绫水"
        },
        {
            "location": "308/TALK",
            "narrator": "アーヤ",
            "text": "今回のクランは、\n貴方に自分のタイプを\n言いたくなくて発生した。",
            "zh": "这次的库兰，是因为\n不想把自己的理想型\n告诉你而诞生的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "309/SEL",
            "narrator": "",
            "text": "$me$が嫌いなの？",
            "zh": "是因为讨厌$me$吗？",
            "narrator_zh": ""
        },
        {
            "location": "310/SEL",
            "narrator": "",
            "text": "$me$が好きだからだね",
            "zh": "是因为喜欢$me$对吧",
            "narrator_zh": ""
        },
        {
            "location": "311/ACT",
            "narrator": "",
            "text": "$me$が嫌いなの？",
            "zh": "是因为讨厌$me$吗？",
            "narrator_zh": ""
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "んー、逆かな。",
            "zh": "嗯——，恰恰相反吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "313/TALK",
            "narrator": "アーヤ",
            "text": "貴方がAIじゃなくて、\nかつ、貴方に嫌われたく\nない自分がいるのよ。",
            "zh": "正因为知道你不是AI，\n才更不想被你讨厌——\n心里存在着这样的自己呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "314/TALK",
            "narrator": "アーヤ",
            "text": "タイプを言うことで\nどん引きされたりしないか\n怖がってるのね。",
            "zh": "她在害怕说出自己喜欢的类型后，\n会不会把你吓到\n呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "315/TALK",
            "narrator": "アーヤ",
            "text": "全然心配いらないのにね。",
            "zh": "明明完全用不着担心的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "317/TALK",
            "narrator": "アーヤ",
            "text": "こんなに慎ましくて\n素敵な貴方なんだもの。",
            "zh": "毕竟你是如此谦逊\n又体贴的人嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "318/ACT",
            "narrator": "",
            "text": "$me$が好きだからだね",
            "zh": "是因为喜欢$me$对吧",
            "narrator_zh": ""
        },
        {
            "location": "320/TALK",
            "narrator": "アーヤ",
            "text": "こら。\n自惚れないの。",
            "zh": "喂。\n别太得意忘形了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "321/TALK",
            "narrator": "アーヤ",
            "text": "まあでも、\nそれが正解なのよね。",
            "zh": "不过嘛，\n你确实答对了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "322/TALK",
            "narrator": "アーヤ",
            "text": "貴方がAIじゃなくて、\nかつ、貴方に嫌われたく\nない自分がいるのよ。",
            "zh": "正因为知道你不是AI，\n才更不想被你讨厌——\n心里存在着这样的自己呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "323/TALK",
            "narrator": "アーヤ",
            "text": "タイプを言うことで\nどん引きされたりしないか\n怖がってるのね。",
            "zh": "她在害怕说出自己喜欢的类型后，\n会不会把你吓到\n呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "325/TALK",
            "narrator": "アーヤ",
            "text": "私の総意としては、\n言いたいって気持ちが\n強いみたい。",
            "zh": "不过从我的总体意志来看，\n其实想说出来的念头\n还蛮强烈的呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "326/TALK",
            "narrator": "アーヤ",
            "text": "私自身もビックリだわ。\nBotだった貴方を\nこんなに意識するなんて。",
            "zh": "连我自己都吓了一跳呢。\n居然会如此在意\n曾经还是Bot的你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "327/TALK",
            "narrator": "アーヤ",
            "text": "まさに、\n『現実は小説より奇なり』\nよね。",
            "zh": "这还真是，\n“现实比小说更离奇”\n呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "328/TALK",
            "narrator": "アーヤ",
            "text": "まあ、そんなわけで、\n私としてはクランを倒して\n欲しいんだけど……",
            "zh": "嘛，总而言之，\n我个人是希望你能\n打倒库兰的……",
            "narrator_zh": "绫水"
        },
        {
            "location": "329/TALK",
            "narrator": "アーヤ",
            "text": "今回は貴方のことでも\nあるし、どうするかは\n貴方にお任せするわ。",
            "zh": "不过这次也算是\n关乎你自己的事，要怎么做\n就交给你自己决定了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "331/TALK",
            "narrator": "アーヤ",
            "text": "扉は開けておくから\n気が向いたら入ってね。",
            "zh": "门我会为你敞开着，\n有兴趣的话就进来吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "332/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！",
            "zh": "祝愿$handle$与\n国政绫水，\n拥有一段美妙的心灵之旅！",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月7日　0:07 PM</color>\n午前の大学講義終了後、学園内の自販機コーナーにて。",
            "zh": "<color=green>7月7日　0:07 PM</color>\n上午的大学课程结束后，在学园内的自动贩卖机角。",
            "narrator_zh": "Dialog_EventData"
        },
        {
