    "type": "MainStory",
    "info": {
        "story_id": "28505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "史上最大の気苦労＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "史上最大的操心＜后篇＞"
    },
    "entry": [
        {
            "location": "1710/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "1711/TALK",
            "narrator": "神楽",
            "text": "繭さん？",
            "zh": "茧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1713/TALK",
            "narrator": "繭",
            "text": "…なに、この情報？",
            "zh": "……这是什么信息？",
            "narrator_zh": "茧"
        },
        {
            "location": "1716/TALK",
            "narrator": "雛",
            "text": "って、ヤバいーっ！！\nまゆちん、\n急いでセーブして！",
            "zh": "等等，不妙——！！\n小茧，\n赶快保存！",
            "narrator_zh": "雏"
        },
        {
            "location": "1717/TALK",
            "narrator": "雛",
            "text": "このままじゃ熱で\nチップが死んじゃう！",
            "zh": "再这样下去热量会\n把芯片弄死的！",
            "narrator_zh": "雏"
        },
        {
            "location": "1718/TALK",
            "narrator": "繭",
            "text": "なんとか冷まして！\nこれ、スゴい情報！",
            "zh": "想办法冷却！\n这个，是不得了的信息！",
            "narrator_zh": "茧"
        },
        {
            "location": "1719/TALK",
            "narrator": "雛",
            "text": "えぇっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "雏"
        },
        {
            "location": "1720/TALK",
            "narrator": "雛",
            "text": "こんなことなら、水冷に\nしとくんだったー…。",
            "zh": "早知道这样，\n就做成水冷了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "1722/TALK",
            "narrator": "神楽",
            "text": "あの、氷でよければ\n冷蔵庫に沢山――",
            "zh": "那个，如果冰就行的话\n冰箱里有很多——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1724/TALK",
            "narrator": "雛",
            "text": "すぐに氷嚢にして\n持ってきて！",
            "zh": "马上做成冰袋\n拿过来！",
            "narrator_zh": "雏"
        },
        {
            "location": "1725/TALK",
            "narrator": "神楽",
            "text": "は、はいっ！",
            "zh": "是、是的！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1729/TALK",
            "narrator": "繭",
            "text": "…こんな情報、\n想定外。\nすごい…なにこれ？",
            "zh": "……这种信息，\n完全没想到。\n厉害……这是什么？",
            "narrator_zh": "茧"
        },
        {
            "location": "1730/TALK",
            "narrator": "繭",
            "text": "こんな時に、\nみやび先輩が\nいてくれたら…。",
            "zh": "这种时候，\n要是雅前辈\n在就好了……。",
            "narrator_zh": "茧"
        },
        {
            "location": "1731/TALK",
            "narrator": "繭",
            "text": "…ちがう。\nちがうから、繭。",
            "zh": "……不对。\n不对啊，茧。",
            "narrator_zh": "茧"
        },
        {
            "location": "1732/TALK",
            "narrator": "繭",
            "text": "今は私が、\nみやび先輩を\n守る立場だから！",
            "zh": "现在是我\n站在保护\n雅前辈的立场上！",
            "narrator_zh": "茧"
        },
        {
            "location": "1733/TALK",
            "narrator": "繭",
            "text": "私が解析する。\n今まで、みやび先輩が\nやってきたように…。",
            "zh": "我来解析。\n像至今为止雅前辈\n做过的那样……。",
            "narrator_zh": "茧"
        },
        {
            "location": "1734/TALK",
            "narrator": "繭",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "茧"
        },
        {
            "location": "1735/TALK",
            "narrator": "繭",
            "text": "あともう少しで――",
            "zh": "再有一点点就——",
            "narrator_zh": "茧"
        },
        {
            "location": "1736/TALK",
            "narrator": "繭",
            "text": "っ！！\nやばっ！！",
            "zh": "！！\n糟了！！",
            "narrator_zh": "茧"
        },
        {
            "location": "1748/TALK",
            "narrator": "繭",
            "text": "……大丈夫。\n大丈夫だから。",
            "zh": "……没事。\n没事的。",
            "narrator_zh": "茧"
        },
        {
            "location": "1749/TALK",
            "narrator": "繭",
            "text": "何もない、\n何もない……\nきっと大丈夫……",
            "zh": "什么都没有，\n什么都没有……\n一定没事……",
            "narrator_zh": "茧"
        },
        {
            "location": "1776/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "1778/TALK",
            "narrator": "神楽",
            "text": "ひなこさん、\nチップの方は\nどうですか？",
            "zh": "雏，\n芯片那边\n怎么样了？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1779/TALK",
            "narrator": "雛",
            "text": "ギリギリセーフ。\nもう少し遅かったら\n溶けてたかも…。",
            "zh": "勉强安全。\n再晚一点\n可能就烧化了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "1780/TALK",
            "narrator": "雛",
            "text": "それで、まゆちん。\nどうだった？",
            "zh": "所以，小茧。\n怎么样？",
            "narrator_zh": "雏"
        },
        {
            "location": "1781/TALK",
            "narrator": "繭",
            "text": "…ダメだ。",
            "zh": "……不行。",
            "narrator_zh": "茧"
        },
        {
            "location": "1782/TALK",
            "narrator": "繭",
            "text": "私程度の力じゃ…。\nなにもわからない。",
            "zh": "以我这点本事……\n什么都看不出来。",
            "narrator_zh": "茧"
        },
        {
            "location": "1783/TALK",
            "narrator": "神楽",
            "text": "なにもって…、\n少しでもわかった\nことはないんですか？",
            "zh": "什么都……\n难道一点点\n都没弄明白吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1784/TALK",
            "narrator": "繭",
            "text": "とりあえず、実験用に\nSIMカードを1枚\n作ることができた。",
            "zh": "总之，实验用的\nSIM卡做出来了\n一张。",
            "narrator_zh": "茧"
        },
        {
            "location": "1785/TALK",
            "narrator": "繭",
            "text": "けれども…鍵。",
            "zh": "可是……钥匙。",
            "narrator_zh": "茧"
        },
        {
            "location": "1786/TALK",
            "narrator": "雛",
            "text": "カギ？",
            "zh": "钥匙？",
            "narrator_zh": "雏"
        },
        {
            "location": "1788/TALK",
            "narrator": "繭",
            "text": "アウターキーと、\nインナーキーという\n二つの鍵があって…。",
            "zh": "Outer Key和\nInner Key，\n有两把钥匙……。",
            "narrator_zh": "茧"
        },
        {
            "location": "1789/TALK",
            "narrator": "繭",
            "text": "それが無ければ\n起動は出来ないみたい。",
            "zh": "没有那个的话\n好像无法启动。",
            "narrator_zh": "茧"
        },
        {
            "location": "1790/TALK",
            "narrator": "繭",
            "text": "わかれば、恐らく\nトライガジェットの\nほぼ全ての情報と――",
            "zh": "要是弄明白，大概\nTri-Gadget的\n几乎全部信息，以及——",
            "narrator_zh": "茧"
        },
        {
            "location": "1791/TALK",
            "narrator": "繭",
            "text": "操作が出来るように\nなるはず。",
            "zh": "就能够\n操作了。",
            "narrator_zh": "茧"
        },
        {
            "location": "1792/TALK",
            "narrator": "神楽",
            "text": "じゃあ、その鍵を\n見つけ出せれば――",
            "zh": "那么，只要找到\n那把钥匙——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1793/TALK",
            "narrator": "繭",
            "text": "けど、その二つの\nキーは、絶望的に\n見つからない…。",
            "zh": "可是那两把\n钥匙，绝望地\n找不到……。",
            "narrator_zh": "茧"
        },
        {
            "location": "1794/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "1796/TALK",
            "narrator": "神楽",
            "text": "…万事休す、ですか？",
            "zh": "……万事休矣，吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1797/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "1798/SEL",
            "narrator": "",
            "text": "アウターキーは5ec41bf64dX_",
            "zh": "Outer Key是5ec41bf64dX_",
            "narrator_zh": ""
        },
        {
            "location": "1799/ACT",
            "narrator": "",
            "text": "アウターキーは5ec41bf64dX_",
            "zh": "Outer Key是5ec41bf64dX_",
            "narrator_zh": ""
        },
        {
            "location": "1807/TALK",
            "narrator": "神楽",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1808/TALK",
            "narrator": "繭",
            "text": "それと、ちょっとだけ\n気がかりなことがあった。\n二人とも聞いて――",
            "zh": "还有，有一件\n稍微在意的事。\n你们两个听好——",
            "narrator_zh": "茧"
        },
        {
            "location": "1809/TALK",
            "narrator": "神楽",
            "text": "えっ、これって！！",
            "zh": "诶，这个！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1810/TALK",
            "narrator": "雛",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": "雏"
        },
        {
            "location": "1812/TALK",
            "narrator": "神楽",
            "text": "…アウターキー、\nわかったかも\nしれません。",
            "zh": "……Outer Key，\n我也许\n知道了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1814/TALK",
            "narrator": "繭",
            "text": "！？　どういうこと？",
            "zh": "！？怎么回事？",
            "narrator_zh": "茧"
        },
        {
            "location": "1816/TALK",
            "narrator": "神楽",
            "text": "説明はＷＡＶＥで。\n招待するから\n入ってください。",
            "zh": "说明用WAVE。\n我来邀请，\n请进来。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1826/TALK",
            "narrator": "システム",
            "text": "繭さんが入室しました",
            "zh": "茧已入室",
            "narrator_zh": "系统"
        },
        {
            "location": "1827/TALK",
            "narrator": "システム",
            "text": "雛さんが入室しました",
            "zh": "雏已入室",
            "narrator_zh": "系统"
        },
        {
            "location": "1828/SEL",
            "narrator": "",
            "text": "ようこそ二人とも",
            "zh": "欢迎你们两位",
            "narrator_zh": ""
        },
        {
            "location": "1829/ACT",
            "narrator": "",
            "text": "ようこそ二人とも",
            "zh": "欢迎你们两位",
            "narrator_zh": ""
        },
        {
            "location": "1831/TALK",
            "narrator": "繭",
            "text": "この人がアウターキーを？",
            "zh": "这个人有Outer Key？",
            "narrator_zh": "茧"
        },
        {
            "location": "1832/TALK",
            "narrator": "神楽",
            "text": "そうですよ",
            "zh": "是的哦",
            "narrator_zh": "神乐"
        },
        {
            "location": "1834/TALK",
            "narrator": "雛",
            "text": "それって本物なの？",
            "zh": "那是真的吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "1836/SEL",
            "narrator": "",
            "text": "本物だよ",
            "zh": "是真的哦",
            "narrator_zh": ""
        },
        {
            "location": "1837/SEL",
            "narrator": "",
            "text": "入れてみればわかる",
            "zh": "放进去就知道了",
            "narrator_zh": ""
        },
        {
            "location": "1838/ACT",
            "narrator": "",
            "text": "本物だよ",
            "zh": "是真的哦",
            "narrator_zh": ""
        },
        {
            "location": "1839/TALK",
            "narrator": "神楽",
            "text": "この人は信じても大丈夫です",
            "zh": "这个人可以相信",
            "narrator_zh": "神乐"
        },
        {
            "location": "1841/TALK",
            "narrator": "雛",
            "text": "でも、どうやって知ったのかな？",
            "zh": "可是，她是怎么知道的呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "1842/TALK",
            "narrator": "繭",
            "text": "今はどうでもいい",
            "zh": "现在无所谓",
            "narrator_zh": "茧"
        },
        {
            "location": "1843/ACT",
            "narrator": "",
            "text": "入れてみればわかる",
            "zh": "放进去就知道了",
            "narrator_zh": ""
        },
        {
            "location": "1844/TALK",
            "narrator": "雛",
            "text": "不安煽ってるようにしか聞こえないよ！？",
            "zh": "听起来只像是在煽动不安哦！？",
            "narrator_zh": "雏"
        },
        {
            "location": "1845/TALK",
            "narrator": "神楽",
            "text": "この人は信じても大丈夫です",
            "zh": "这个人可以相信",
            "narrator_zh": "神乐"
        },
        {
            "location": "1847/TALK",
            "narrator": "神楽",
            "text": "ﾀﾌﾞﾝ、、、",
            "zh": "大概……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1849/TALK",
            "narrator": "繭",
            "text": "卯月さんが言うなら信じるけど",
            "zh": "卯月这么说的话我就信",
            "narrator_zh": "茧"
        },
        {
            "location": "1851/TALK",
            "narrator": "繭",
            "text": "インナーキーもわからなければ",
            "zh": "要是Inner Key也不知道",
            "narrator_zh": "茧"
        },
        {
            "location": "1852/TALK",
            "narrator": "繭",
            "text": "意味がない",
            "zh": "就没有意义",
            "narrator_zh": "茧"
        },
        {
            "location": "1853/SEL",
            "narrator": "",
            "text": "それは入れる必要がない",
            "zh": "那个不需要放进去",
            "narrator_zh": ""
        },
        {
            "location": "1854/ACT",
            "narrator": "",
            "text": "それは入れる必要がない",
            "zh": "那个不需要放进去",
            "narrator_zh": ""
        },
        {
            "location": "1856/TALK",
            "narrator": "繭",
            "text": "？",
            "zh": "？",
            "narrator_zh": "茧"
        },
        {
            "location": "1857/TALK",
            "narrator": "繭",
            "text": "アウターキーだけでいいと？",
            "zh": "只放Outer Key就行？",
            "narrator_zh": "茧"
        },
        {
            "location": "1858/SEL",
            "narrator": "",
            "text": "アウターキーだけ入れたらトライガジェットの全てを掌握できる",
            "zh": "只放进Outer Key就能掌握Tri-Gadget的全部",
            "narrator_zh": ""
        },
        {
            "location": "1859/ACT",
            "narrator": "",
            "text": "アウターキーだけ入れたらトライガジェットの全てを掌握できる",
            "zh": "只放进Outer Key就能掌握Tri-Gadget的全部",
            "narrator_zh": ""
        },
        {
            "location": "1861/TALK",
            "narrator": "雛",
            "text": "神楽ちゃん解説よろ",
            "zh": "神乐，解说拜托",
            "narrator_zh": "雏"
        },
        {
            "location": "1862/TALK",
            "narrator": "神楽",
            "text": "そう言われても",
            "zh": "你这么说也",
            "narrator_zh": "神乐"
        },
        {
            "location": "1863/TALK",
            "narrator": "神楽",
            "text": "私もイミフですし、、、",
            "zh": "我也完全搞不懂……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1865/SEL",
            "narrator": "",
            "text": "方法は、繭ならすぐわかるはず",
            "zh": "方法的话，茧应该马上就能明白",
            "narrator_zh": ""
        },
        {
            "location": "1866/ACT",
            "narrator": "",
            "text": "方法は、繭ならすぐわかるはず",
            "zh": "方法的话，茧应该马上就能明白",
            "narrator_zh": ""
        },
        {
            "location": "1868/TALK",
            "narrator": "雛",
            "text": "まゆちん解説よろ",
            "zh": "小茧，解说拜托",
            "narrator_zh": "雏"
        },
        {
            "location": "1869/TALK",
            "narrator": "繭",
            "text": "今はわからない",
            "zh": "现在还不明白",
            "narrator_zh": "茧"
        },
        {
            "location": "1870/TALK",
            "narrator": "繭",
            "text": "アウターキー入れたら",
            "zh": "放进Outer Key之后",
            "narrator_zh": "茧"
        },
        {
            "location": "1871/TALK",
            "narrator": "繭",
            "text": "わかるってことだと思う",
            "zh": "我想就会明白了",
            "narrator_zh": "茧"
        },
        {
            "location": "1872/SEL",
            "narrator": "",
            "text": "そういうこと",
            "zh": "就是这么回事",
            "narrator_zh": ""
        },
        {
            "location": "1873/ACT",
            "narrator": "",
            "text": "そういうこと",
            "zh": "就是这么回事",
            "narrator_zh": ""
        },
        {
            "location": "1875/TALK",
            "narrator": "繭",
            "text": "わかった",
            "zh": "知道了",
            "narrator_zh": "茧"
        },
        {
            "location": "1876/TALK",
            "narrator": "神楽",
            "text": "じゃああとは",
            "zh": "那么剩下的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1877/TALK",
            "narrator": "神楽",
            "text": "繭さんにお任せってことですね",
            "zh": "就交给茧了呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "1879/SEL",
            "narrator": "",
            "text": "雛にも一つお願いがある",
            "zh": "也有一件事想拜托雏",
            "narrator_zh": ""
        },
        {
            "location": "1880/ACT",
            "narrator": "",
            "text": "雛にも一つお願いがある",
            "zh": "也有一件事想拜托雏",
            "narrator_zh": ""
        },
        {
            "location": "1882/TALK",
            "narrator": "雛",
            "text": "あたし？",
            "zh": "我？",
            "narrator_zh": "雏"
        },
        {
            "location": "1883/TALK",
            "narrator": "雛",
            "text": "まゆちんみたいなことできないんだけど",
            "zh": "我可做不到小茧那种事",
            "narrator_zh": "雏"
        },
        {
            "location": "1884/SEL",
            "narrator": "",
            "text": "必要な機材を作って欲しい",
            "zh": "希望你做需要的器材",
            "narrator_zh": ""
        },
        {
            "location": "1885/ACT",
            "narrator": "",
            "text": "必要な機材を作って欲しい",
            "zh": "希望你做需要的器材",
            "narrator_zh": ""
        },
        {
            "location": "1887/TALK",
            "narrator": "雛",
            "text": "オーケーオーケーいくらでもつくるよー！！",
            "zh": "OK OK做多少都行哦！！",
            "narrator_zh": "雏"
        },
        {
            "location": "1888/TALK",
            "narrator": "雛",
            "text": "盛り上がって参りました！",
            "zh": "干劲上来了！",
            "narrator_zh": "雏"
        },
        {
            "location": "1890/SEL",
            "narrator": "",
            "text": "何を作るかはまた後で指示するから、まずはファイルを読んでおいて",
            "zh": "做什么之后再指示，先把文件读一读",
            "narrator_zh": ""
        },
        {
            "location": "1891/ACT",
            "narrator": "",
            "text": "何を作るかはまた後で指示するから、まずはファイルを読んでおいて",
            "zh": "做什么之后再指示，先把文件读一读",
            "narrator_zh": ""
        },
        {
            "location": "1893/TALK",
            "narrator": "雛",
            "text": "らじゃー！",
            "zh": "收到——！",
            "narrator_zh": "雏"
        },
        {
            "location": "1894/TALK",
            "narrator": "繭",
            "text": "わかりました",
            "zh": "明白了",
            "narrator_zh": "茧"
        },
        {
            "location": "1928/TALK",
            "narrator": "繭",
            "text": "…東雲教官……？",
            "zh": "……东云教官……？",
            "narrator_zh": "茧"
        },
        {
            "location": "1929/TALK",
            "narrator": "雛",
            "text": "教官？\n向こうから掛けて\nくるなんて珍しいね？",
            "zh": "教官？\n居然从那边打\n过来，真少见呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "1934/TALK",
            "narrator": "繭",
            "text": "……はい。",
            "zh": "……是。",
            "narrator_zh": "茧"
        },
        {
            "location": "1935/TALK",
            "narrator": "繭",
            "text": "………はい。",
            "zh": "………是。",
            "narrator_zh": "茧"
        },
        {
            "location": "1936/TALK",
            "narrator": "神楽",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1937/TALK",
            "narrator": "繭",
            "text": "わかりました。\n急ぎます。",
            "zh": "明白了。\n我尽快。",
            "narrator_zh": "茧"
        },
        {
            "location": "1940/TALK",
            "narrator": "雛",
            "text": "教官、なんだって？",
            "zh": "教官说什么了？",
            "narrator_zh": "雏"
        },
        {
            "location": "1942/TALK",
            "narrator": "繭",
            "text": "ごめん。",
            "zh": "对不起。",
            "narrator_zh": "茧"
        },
        {
            "location": "1943/TALK",
            "narrator": "繭",
            "text": "本当にごめん。",
            "zh": "真的对不起。",
            "narrator_zh": "茧"
        },
        {
            "location": "1944/TALK",
            "narrator": "神楽",
            "text": "どうしたんですか？",
            "zh": "怎么了？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1946/TALK",
            "narrator": "繭",
            "text": "さっき私、ヘマした。\nごめん！！",
            "zh": "刚才我搞砸了。\n对不起！！",
            "narrator_zh": "茧"
        },
        {
            "location": "1947/TALK",
            "narrator": "雛",
            "text": "え……それって……",
            "zh": "诶……那是……",
            "narrator_zh": "雏"
        },
        {
            "location": "1949/TALK",
            "narrator": "繭",
            "text": "すぐにここから\n逃げないとまずい！",
            "zh": "不马上从这里\n逃走就糟了！",
            "narrator_zh": "茧"
        },
        {
            "location": "1951/TALK",
            "narrator": "神楽",
            "text": "……っ。",
            "zh": "……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1952/TALK",
            "narrator": "神楽",
            "text": "わかりました。\nすぐに行きましょう！",
            "zh": "明白了。\n我们马上走！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1953/TALK",
            "narrator": "繭",
            "text": "卯月さん！",
            "zh": "卯月！",
            "narrator_zh": "茧"
        },
        {
            "location": "1954/TALK",
            "narrator": "神楽",
            "text": "はいっ！",
            "zh": "是的！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1955/TALK",
            "narrator": "繭",
            "text": "これを渡しておく。",
            "zh": "这个先交给你。",
            "narrator_zh": "茧"
        },
        {
            "location": "1956/TALK",
            "narrator": "神楽",
            "text": "SIM…カードですか？",
            "zh": "SIM……卡吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1957/TALK",
            "narrator": "繭",
            "text": "そう。\n中身については、\n走りながら話す。",
            "zh": "对。\n内容的话，\n边跑边说。",
            "narrator_zh": "茧"
        },
        {
            "location": "1958/TALK",
            "narrator": "繭",
            "text": "これだけでも\n渡しておけば、\n万一捕まってもきっと――",
            "zh": "哪怕只有这个\n交出去的话，\n万一被抓住也一定——",
            "narrator_zh": "茧"
        },
        {
            "location": "1959/TALK",
            "narrator": "雛",
            "text": "早く、早く！！",
            "zh": "快，快！！",
            "narrator_zh": "雏"
        },
        {
            "location": "1989/TALK",
            "narrator": "繭",
            "text": "…！！",
            "zh": "……！！",
            "narrator_zh": "茧"
        },
        {
            "location": "1990/TALK",
            "narrator": "雛",
            "text": "囲まれた！！",
            "zh": "被包围了！！",
            "narrator_zh": "雏"
        },
        {
            "location": "1991/TALK",
            "narrator": "神楽",
            "text": "遅かった……。",
            "zh": "来晚了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1992/TALK",
            "narrator": "千羽鶴",
            "text": "卯月神楽。\n光月繭。\n日向雛。",
            "zh": "卯月神乐。\n光月茧。\n日向雏。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1993/TALK",
            "narrator": "千羽鶴",
            "text": "情報管理庁特Aクラス\nサーバーへの不正アクセス\n及びハッキング容疑で――",
            "zh": "以非法访问\n情报管理厅特A级\n服务器及黑客嫌疑——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1994/TALK",
            "narrator": "千羽鶴",
            "text": "その身柄を\n拘束する。",
            "zh": "将其人身\n拘束。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1739/DIALOG",
            "narrator": "Dialog_Alert",
            "text": "<color=red>【TRI-OS Notice:0x99】</color>\nRedinessカーネルにおける一般保護領域1xFFFに例外が発生しました。\n\nTRI-OSを再起動します。\n(0xFF)",
            "zh": "<color=red>【TRI-OS Notice:0x99】</color>\nRediness内核的一般保护区域1xFFF发生了异常。\n\n将重新启动TRI-OS。\n(0xFF)",
            "narrator_zh": "Dialog_Alert"
        },
        {
            "location": "1747/DIALOG",
            "narrator": "INFO",
            "text": "<color=red>【TRI-OS Information:0x23】</color>\nTRI-OSは深刻な問題の解決に成功しました。量子接続フック1xFFFに新規アドレスを定義しました。\n\n今回の再起動による情報の欠落など障害の情報はありません。\n(0x00)",
            "zh": "<color=red>【TRI-OS Information:0x23】</color>\nTRI-OS已成功解决严重问题。已在量子连接钩子1xFFF定义新地址。\n\n没有因本次重启导致的信息缺失等故障信息。\n(0x00)",
            "narrator_zh": "INFO"
        },
        {
            "location": "2007/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【23 エクセプション】",
            "zh": "【23 例外】",
            "narrator_zh": "Dialog_chapter_ch05"
        },
        {
            "location": "2019/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【23 エクセプション】",
            "zh": "【23 例外】",
            "narrator_zh": "Dialog_chapter_ch05"
        }
    ]
}
