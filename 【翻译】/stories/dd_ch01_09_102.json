{
    "dir": "chap09/daydra/dd_ch01_09_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "9105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "激務日和＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "忙得正好＜后篇＞"
    },
    "entry": [
        {
            "location": "400/SCENARIO",
            "narrator": "",
            "text": "激務日和",
            "zh": "忙得正好",
            "narrator_zh": ""
        },
        {
            "location": "439/TALK",
            "narrator": "つばめ",
            "text": "ちょっと残念だけど",
            "zh": "有点可惜",
            "narrator_zh": "燕"
        },
        {
            "location": "440/TALK",
            "narrator": "つばめ",
            "text": "今日は",
            "zh": "今天",
            "narrator_zh": "燕"
        },
        {
            "location": "441/TALK",
            "narrator": "つばめ",
            "text": "もぅバィトに行くよ",
            "zh": "我去打工啦",
            "narrator_zh": "燕"
        },
        {
            "location": "452/TALK",
            "narrator": "つばめ",
            "text": "…わかりました。",
            "zh": "……知道了。",
            "narrator_zh": "燕"
        },
        {
            "location": "454/TALK",
            "narrator": "つばめ",
            "text": "そういうことだから、\nひなこちゃん。",
            "zh": "就是这样，\n雏。",
            "narrator_zh": "燕"
        },
        {
            "location": "455/TALK",
            "narrator": "つばめ",
            "text": "遊びに行くのは、\nまた今度でいいかな？",
            "zh": "去玩的事，\n下次再说可以吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "457/TALK",
            "narrator": "雛",
            "text": "えぇっ！？\nあ、いいけど、\nでも…。",
            "zh": "诶诶！？\n啊，可以是可以，\n可是……。",
            "narrator_zh": "雏"
        },
        {
            "location": "458/TALK",
            "narrator": "神楽",
            "text": "はぁ…つばめさんが\nそう言うなら――",
            "zh": "哈啊……燕\n都这么说了——",
            "narrator_zh": "神乐"
        },
        {
            "location": "459/TALK",
            "narrator": "神楽",
            "text": "私も行かないわけには\nいきませんね。",
            "zh": "那我也不能\n不去了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "462/TALK",
            "narrator": "つばめ",
            "text": "ごめんね。",
            "zh": "对不起呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "463/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、せんぱい。\n今日は色々教えて\nください！",
            "zh": "那么，前辈。\n今天请多\n教教我！",
            "narrator_zh": "燕"
        },
        {
            "location": "465/TALK",
            "narrator": "ガブリエラ",
            "text": "し、仕方ないわね。\nそれじゃ、さっさと\n行くわよ。",
            "zh": "没、没办法。\n那就赶紧\n走了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "467/TALK",
            "narrator": "つばめ",
            "text": "うん。\nみんな、また明日ね。",
            "zh": "嗯。\n大家，明天见呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "470/TALK",
            "narrator": "神楽",
            "text": "さようなら。",
            "zh": "再见。",
            "narrator_zh": "神乐"
        },
        {
            "location": "472/TALK",
            "narrator": "雛",
            "text": "あ、頑張ってねー！",
            "zh": "啊，加油哦——！",
            "narrator_zh": "雏"
        },
        {
            "location": "489/TALK",
            "narrator": "キリト",
            "text": "…行っちまったな。",
            "zh": "……走掉了啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "491/TALK",
            "narrator": "雛",
            "text": "うん…つばめちゃん、\n大丈夫かな？",
            "zh": "嗯……燕，\n不要紧吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "493/TALK",
            "narrator": "ヒカル",
            "text": "心配ですか？",
            "zh": "在担心吗？",
            "narrator_zh": "光"
        },
        {
            "location": "494/TALK",
            "narrator": "雛",
            "text": "そりゃそうだよー。\nもし私がつばめちゃん\nだったら――",
            "zh": "那当然呀——。\n要是我是燕\n的话——",
            "narrator_zh": "雏"
        },
        {
            "location": "495/TALK",
            "narrator": "雛",
            "text": "絶対怒ってケンカに\nなっちゃうもん。",
            "zh": "绝对会生气，\n吵起来的。",
            "narrator_zh": "雏"
        },
        {
            "location": "498/TALK",
            "narrator": "みやび",
            "text": "…あれでも、\nつばめちゃん達の\nこと――",
            "zh": "……那样也是，\n在为燕她们\n的事——",
            "narrator_zh": "雅"
        },
        {
            "location": "500/TALK",
            "narrator": "みやび",
            "text": "結構気に掛けての\n行動なんよ。",
            "zh": "挺放在心上的\n行动咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "502/TALK",
            "narrator": "雛",
            "text": "えーっ、そうなん\nですか？",
            "zh": "诶——，是\n这样吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "503/TALK",
            "narrator": "キリト",
            "text": "そんな風には\n見えなかったっす\nけど？",
            "zh": "完全\n看不出来\n啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "505/TALK",
            "narrator": "みやび",
            "text": "気に掛けてないん\nやったら――",
            "zh": "要是不放在心上\n的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "506/TALK",
            "narrator": "みやび",
            "text": "自分も２時間も早く\nバイトに行ったりは\nせんよ。",
            "zh": "自己也不会提前\n两个小时去\n打工咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "507/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんも、\n内心それに気付いて\nたき――",
            "zh": "燕心里也\n注意到了\n啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "509/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんを立てて\n言う通りにしたんや\nないかと思うがよ。",
            "zh": "是给加布留面子，\n才照她说的做的\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "510/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんは、\n相手を思いやれる\n優しい子やきね。",
            "zh": "燕是会为对方\n着想的温柔孩子\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "512/TALK",
            "narrator": "みやび",
            "text": "…ちくっと怖い時も\nあるけんど。",
            "zh": "……有时也有点\n吓人，但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "513/TALK",
            "narrator": "みやび",
            "text": "まあ、言うても\n出会うてからまだ\n一カ月程度やき――",
            "zh": "嘛，说到底\n认识了还不到\n一个月啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "515/TALK",
            "narrator": "みやび",
            "text": "うちの憶測満載や\nけんどな。",
            "zh": "我这边全是猜测，\n但是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "517/TALK",
            "narrator": "ヒカル",
            "text": "いえ…今の話、\nわかる気がします。",
            "zh": "不……刚才那些话，\n我觉得听得懂。",
            "narrator_zh": "光"
        },
        {
            "location": "519/TALK",
            "narrator": "雛",
            "text": "なるほどねー。\nガブリエラちゃんは\nツンデレだったかー。",
            "zh": "原来如此——。\n加布里埃拉\n是傲娇啊——。",
            "narrator_zh": "雏"
        },
        {
            "location": "520/TALK",
            "narrator": "キリト",
            "text": "リアルツンデレとか、\n初めて見たぜ。",
            "zh": "现实傲娇，\n还是第一次见。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "522/TALK",
            "narrator": "みやび",
            "text": "それ、ガブちゃんの\n前で言わんように\n気ぃつけてな。",
            "zh": "这话，可别在\n加布面前\n说咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "524/TALK",
            "narrator": "みやび",
            "text": "ところで…あんたら、\nつばめちゃん達の\nお友達かの？",
            "zh": "话说……你们，\n是燕她们的\n朋友咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "527/TALK",
            "narrator": "雛",
            "text": "いえす！",
            "zh": "Yes！",
            "narrator_zh": "雏"
        },
        {
            "location": "529/TALK",
            "narrator": "みやび",
            "text": "そうか…。\n男の子達に聞きたいん\nやけんど――",
            "zh": "这样啊……。\n有件事想问男生们，\n但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "530/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんと卯月、\nどっちが好み？",
            "zh": "燕和卯月，\n喜欢哪个？",
            "narrator_zh": "雅"
        },
        {
            "location": "532/TALK",
            "narrator": "ヒカル",
            "text": "えっ！？\nきゅ、急に何ですか？",
            "zh": "诶！？\n突、突然问什么？",
            "narrator_zh": "光"
        },
        {
            "location": "534/TALK",
            "narrator": "みやび",
            "text": "トライナリー新人\n人気コンテスト\nプログラムぞね。",
            "zh": "三重奏新人\n人气竞赛\n节目咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "539/TALK",
            "narrator": "キリト",
            "text": "いやー、俺としては\nみやび先輩の方が――",
            "zh": "这个嘛，要我说\n雅前辈更——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "543/TALK",
            "narrator": "繭",
            "text": "ふんっ！",
            "zh": "哼！",
            "narrator_zh": "茧"
        },
        {
            "location": "548/TALK",
            "narrator": "キリト",
            "text": "ぐはっ！？",
            "zh": "咕哈！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "551/TALK",
            "narrator": "みやび",
            "text": "…まあ、いずれ必要に\nなるかもしれんき――",
            "zh": "……嘛，迟早也许\n用得上啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "552/TALK",
            "narrator": "みやび",
            "text": "うちから二人の\n攻略法教えたるき、\nよう聞きいや。",
            "zh": "我来把两人的\n攻略法教给你，\n给我听好。",
            "narrator_zh": "雅"
        },
        {
            "location": "553/TALK",
            "narrator": "みやび",
            "text": "まず、つばめちゃん\nやけんど、あの子は\n簡単や。",
            "zh": "首先是燕，\n但是，那孩子\n简单咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "556/TALK",
            "narrator": "みやび",
            "text": "鷹が兎を襲うが如し！",
            "zh": "犹如老鹰扑兔子！",
            "narrator_zh": "雅"
        },
        {
            "location": "558/TALK",
            "narrator": "みやび",
            "text": "四の五の言われても\n無理やり押し倒し\nちゃれば――",
            "zh": "就算她说三道四，\n硬是推倒\n给你的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "559/TALK",
            "narrator": "みやび",
            "text": "嫌よ嫌よも好きの\nうちや。\nコロッと落ちるで。",
            "zh": "嘴上说不要\n也是喜欢咯。\n一下子就陷进去。",
            "narrator_zh": "雅"
        },
        {
            "location": "562/TALK",
            "narrator": "キリト",
            "text": "そ、それって、\nマジっすか！？",
            "zh": "那、那是\n真的吗！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "564/TALK",
            "narrator": "ヒカル",
            "text": "いや、無理やりって、\nそれ問題だと思います\nけど…。",
            "zh": "不对，硬来的话，\n我觉得这有问题\n……。",
            "narrator_zh": "光"
        },
        {
            "location": "567/TALK",
            "narrator": "みやび",
            "text": "逆に、卯月の場合は\nこじゃんと難しい。\nナイトメアモードや。",
            "zh": "反过来，卯月的话\n蛮难。\n噩梦模式咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "568/TALK",
            "narrator": "みやび",
            "text": "見た感じ、人当たり\n良さそうやけんど――",
            "zh": "看上去，好像\n很好相处，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "569/TALK",
            "narrator": "みやび",
            "text": "一枚、仮面を\n被っちょる。",
            "zh": "罩着一张\n面具。",
            "narrator_zh": "雅"
        },
        {
            "location": "571/TALK",
            "narrator": "雛",
            "text": "えっ、そうなん\nですか！？",
            "zh": "诶，是\n这样吗！？",
            "narrator_zh": "雏"
        },
        {
            "location": "573/TALK",
            "narrator": "みやび",
            "text": "うちの分析はよく\n当たると評判やき。",
            "zh": "我的分析经常命中，\n这可是有名的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "574/TALK",
            "narrator": "みやび",
            "text": "まあ、その仮面の\n裏側にある本性は、\nうちにも予測不能や。",
            "zh": "嘛，那张面具\n底下的本性，\n连我也预测不了。",
            "narrator_zh": "雅"
        },
        {
            "location": "577/TALK",
            "narrator": "みやび",
            "text": "やき、もしアタック\nするなら――",
            "zh": "啵，要是要攻击\n的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "578/TALK",
            "narrator": "みやび",
            "text": "そこも承知で\nかからんといかんよ。",
            "zh": "这一点也得\n知道了再上。",
            "narrator_zh": "雅"
        },
        {
            "location": "579/TALK",
            "narrator": "ヒカル",
            "text": "は、はあ…。",
            "zh": "哈、哈啊……。",
            "narrator_zh": "光"
        },
        {
            "location": "582/TALK",
            "narrator": "みやび",
            "text": "ほな、うちもそろそろ\n行くきね。",
            "zh": "那就，我也差不多\n该走了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "585/TALK",
            "narrator": "繭",
            "text": "…寧ろ、私には――",
            "zh": "……倒不如说，对我——",
            "narrator_zh": "茧"
        },
        {
            "location": "586/TALK",
            "narrator": "繭",
            "text": "みやび先輩の攻略法を\n教えて欲しいです。",
            "zh": "想请你教教\n雅前辈的攻略法。",
            "narrator_zh": "茧"
        },
        {
            "location": "589/TALK",
            "narrator": "キリト",
            "text": "えっ！？\nおまえ、何言っちゃ\nってんの？",
            "zh": "诶！？\n你在说\n什么？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "591/TALK",
            "narrator": "繭",
            "text": "は！？　何が！？",
            "zh": "哈！？什么！？",
            "narrator_zh": "茧"
        },
        {
            "location": "592/TALK",
            "narrator": "キリト",
            "text": "いや、今おまえ、\nみやび先輩の攻略法を\nなんとかって…。",
            "zh": "不，你刚才，\n雅前辈的攻略法\n什么的……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "594/TALK",
            "narrator": "繭",
            "text": "言ってません。",
            "zh": "我没说。",
            "narrator_zh": "茧"
        },
        {
            "location": "595/TALK",
            "narrator": "キリト",
            "text": "いや、言ってたって。\nなんかこう、乙女みた\nいな目をしてさあ。",
            "zh": "不，你说了。\n还用那种，少女\n一样的眼神。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "597/TALK",
            "narrator": "繭",
            "text": "言ってないって\n言ってるだろ。",
            "zh": "我说了没说\n就是没说。",
            "narrator_zh": "茧"
        },
        {
            "location": "601/TALK",
            "narrator": "雛",
            "text": "そんなことより！\nつばめちゃん、\n大丈夫かなぁ？",
            "zh": "比起那个！\n燕，\n不要紧吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "603/TALK",
            "narrator": "ヒカル",
            "text": "何か心配なことでも\nあるんですか？",
            "zh": "有什么担心的事\n吗？",
            "narrator_zh": "光"
        },
        {
            "location": "605/TALK",
            "narrator": "雛",
            "text": "もしかしたらだけど、\nつばめちゃんって――",
            "zh": "只是说不定，\n燕她——",
            "narrator_zh": "雏"
        },
        {
            "location": "606/TALK",
            "narrator": "雛",
            "text": "トライナリーの\nみんなに、イジメられ\nてるんじゃないかな？",
            "zh": "被三重奏的\n大家欺负了\n吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "609/TALK",
            "narrator": "キリト",
            "text": "う～ん…そうだなぁ。\nさっきのガブリエラの\n態度を見ると――",
            "zh": "嗯——……怎么说呢。\n看刚才加布里埃拉\n的态度——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "611/TALK",
            "narrator": "キリト",
            "text": "ありえねぇ、とは\n言えなそうだな。",
            "zh": "很难说\n完全没可能啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "613/TALK",
            "narrator": "雛",
            "text": "心配だなぁ。\nつばめちゃん、\n大丈夫かな？",
            "zh": "好担心呀。\n燕，\n不要紧吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "615/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "616/TALK",
            "narrator": "繭",
            "text": "みやび先輩達に、\nイジメられる\n逢瀬さん、か…。",
            "zh": "被雅前辈她们\n欺负的\n逢濑，吗……。",
            "narrator_zh": "茧"
        },
        {
            "location": "652/TALK",
            "narrator": "つばめ",
            "text": "ふぅ…こっちの床、\n拭き終わったよ。",
            "zh": "呼……这边的地板，\n擦完了呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "654/TALK",
            "narrator": "神楽",
            "text": "凄く綺麗になって\nますね。",
            "zh": "变得非常\n干净了呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "657/TALK",
            "narrator": "神楽",
            "text": "それに比べて、\n私の方は…痛っ！？",
            "zh": "比起这个，\n我这边……好痛！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "659/TALK",
            "narrator": "つばめ",
            "text": "どうしたの！？",
            "zh": "怎么了！？",
            "narrator_zh": "燕"
        },
        {
            "location": "661/TALK",
            "narrator": "神楽",
            "text": "て、手が、あかぎれで\n痛くて…。",
            "zh": "手、手皴了，\n好痛……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "662/TALK",
            "narrator": "つばめ",
            "text": "酷い…卯月さんは\nそっちで休んでて。",
            "zh": "好严重……卯月\n在那边休息。",
            "narrator_zh": "燕"
        },
        {
            "location": "663/TALK",
            "narrator": "つばめ",
            "text": "こっちは、わたしが\n綺麗に拭くから！",
            "zh": "这边，我来\n擦干净！",
            "narrator_zh": "燕"
        },
        {
            "location": "665/TALK",
            "narrator": "神楽",
            "text": "ありがとうござい\nます、つばめさん。",
            "zh": "谢谢，\n燕。",
            "narrator_zh": "神乐"
        },
        {
            "location": "666/TALK",
            "narrator": "つばめ",
            "text": "気にしないで。\n友達なんだから、\n困った時は――",
            "zh": "别在意。\n是朋友嘛，\n有困难的时候——",
            "narrator_zh": "燕"
        },
        {
            "location": "669/TALK",
            "narrator": "ガブリエラ",
            "text": "こらー、新人！\nいつまでダラダラ\n掃除してんのよ！？",
            "zh": "喂——，新人！\n打扫要磨蹭到\n什么时候！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "671/TALK",
            "narrator": "つばめ",
            "text": "ひっ！？\nが、ガブリエラ\nせんぱい！",
            "zh": "噫！？\n加、加布里埃拉\n前辈！",
            "narrator_zh": "燕"
        },
        {
            "location": "674/TALK",
            "narrator": "ガブリエラ",
            "text": "ん～？　こら、新人！\nあんたの方、全然\n拭けてないじゃない！",
            "zh": "嗯～？喂，新人！\n你那边，根本\n没擦干净嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "676/TALK",
            "narrator": "つばめ",
            "text": "あ、それはその、\n卯月さんが――",
            "zh": "啊，那个是，\n卯月她——",
            "narrator_zh": "燕"
        },
        {
            "location": "678/TALK",
            "narrator": "神楽",
            "text": "怒らないでください！",
            "zh": "请别生气！",
            "narrator_zh": "神乐"
        },
        {
            "location": "680/TALK",
            "narrator": "神楽",
            "text": "つばめさんは、\nちょっと手際が\n悪いだけなんです。",
            "zh": "燕只是\n手脚有点\n慢而已。",
            "narrator_zh": "神乐"
        },
        {
            "location": "683/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nち、違うよ！",
            "zh": "诶诶！？\n不、不是的！",
            "narrator_zh": "燕"
        },
        {
            "location": "685/TALK",
            "narrator": "つばめ",
            "text": "卯月さんのいる方が、\nわたしの拭いた\nところで――",
            "zh": "卯月那边，\n是我擦过的\n地方——",
            "narrator_zh": "燕"
        },
        {
            "location": "688/TALK",
            "narrator": "ガブリエラ",
            "text": "問答無用！\n立ちなさい。\n根性入れてあげるわ。",
            "zh": "没得商量！\n站起来。\n我来给你打打气。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "691/TALK",
            "narrator": "つばめ",
            "text": "はわわ！",
            "zh": "哈哇哇！",
            "narrator_zh": "燕"
        },
        {
            "location": "694/TALK",
            "narrator": "みやび",
            "text": "まあまあ、\nそれくらいに\nしてやり。",
            "zh": "好了好了，\n到此\n为止。",
            "narrator_zh": "雅"
        },
        {
            "location": "696/TALK",
            "narrator": "つばめ",
            "text": "み、みやび先輩！",
            "zh": "雅、雅前辈！",
            "narrator_zh": "燕"
        },
        {
            "location": "698/TALK",
            "narrator": "ガブリエラ",
            "text": "もう、また新人を\n甘やかして！",
            "zh": "真是的，又在\n娇惯新人！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "699/TALK",
            "narrator": "つばめ",
            "text": "みやび先輩…、\nありがとうござい\nます！",
            "zh": "雅前辈……，\n谢谢\n你！",
            "narrator_zh": "燕"
        },
        {
            "location": "701/TALK",
            "narrator": "みやび",
            "text": "それより、さっき服を\n畳んでおいて、って\n頼んだ件やけど――",
            "zh": "还有，刚才拜托\n把衣服叠好\n那件事——",
            "narrator_zh": "雅"
        },
        {
            "location": "703/TALK",
            "narrator": "みやび",
            "text": "畳み方、雑過ぎや\nせんか？",
            "zh": "叠法，是不是\n太潦草了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "706/TALK",
            "narrator": "つばめ",
            "text": "あ、畳むのは全部、\n卯月さんが――",
            "zh": "啊，叠的全部是\n卯月——",
            "narrator_zh": "燕"
        },
        {
            "location": "707/TALK",
            "narrator": "神楽",
            "text": "つばめさんが\n言ったんです！",
            "zh": "是燕\n说的！",
            "narrator_zh": "神乐"
        },
        {
            "location": "709/TALK",
            "narrator": "神楽",
            "text": "どうせ着るものを、\nわざわざ畳む必要\nなんてない、って！",
            "zh": "反正要穿的东西，\n没必要特意\n叠好，她说！",
            "narrator_zh": "神乐"
        },
        {
            "location": "713/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "715/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あんたねぇ…。\n洗濯もまともに\nできないの！？",
            "zh": "你、你啊……。\n洗衣都\n洗不好吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "717/TALK",
            "narrator": "みやび",
            "text": "はぁ…仕方ない。\nつばめちゃん、\nちくっと動かんで。",
            "zh": "哈啊……没办法。\n燕，\n稍微别动。",
            "narrator_zh": "雅"
        },
        {
            "location": "723/TALK",
            "narrator": "つばめ",
            "text": "え…あっ。\n顔、撫でないで…。",
            "zh": "诶……啊。\n脸，别摸……。",
            "narrator_zh": "燕"
        },
        {
            "location": "724/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんは\n超が付くレベルの\n問題児やき――",
            "zh": "燕是\n带「超」字级别的\n问题儿童啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "725/TALK",
            "narrator": "みやび",
            "text": "言葉だけじゃなくて、\n身体にも教えて\nやらんといかんね。",
            "zh": "不只是用嘴说，\n身体也得教\n才行。",
            "narrator_zh": "雅"
        },
        {
            "location": "728/TALK",
            "narrator": "つばめ",
            "text": "か、身体に！？\nあっ、みやびさん…。",
            "zh": "身、身体！？\n啊，雅……。",
            "narrator_zh": "燕"
        },
        {
            "location": "729/TALK",
            "narrator": "みやび",
            "text": "ほほぅ、思うてた\n以上にスベスベもち\nもちやな。",
            "zh": "呵呵，比我想的\n还要滑，还软\n乎乎咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "730/TALK",
            "narrator": "みやび",
            "text": "これは時間を掛けて、\nたっぷりレクチャー\nせんと勿体ないがよ。",
            "zh": "这个要花时间，\n不好好讲一讲\n就浪费了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "734/TALK",
            "narrator": "つばめ",
            "text": "だ、ダメです。\nそんな…。",
            "zh": "不、不行。\n那样……。",
            "narrator_zh": "燕"
        },
        {
            "location": "735/TALK",
            "narrator": "みやび",
            "text": "ほれ、うちに全てを\n任せるぞね…。",
            "zh": "来，全部交给\n我咧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "736/TALK",
            "narrator": "みやび",
            "text": "上、脱ごうか？",
            "zh": "上面，脱掉？",
            "narrator_zh": "雅"
        },
        {
            "location": "737/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "754/TALK",
            "narrator": "繭",
            "text": "違う！\nみやび先輩は、\nそんなことしない！",
            "zh": "不对！\n雅前辈\n不会做那种事！",
            "narrator_zh": "茧"
        },
        {
            "location": "756/TALK",
            "narrator": "ヒカル",
            "text": "えっ！？\n繭さん、どうしたん\nですか？",
            "zh": "诶！？\n茧，怎么了\n吗？",
            "narrator_zh": "光"
        },
        {
            "location": "759/TALK",
            "narrator": "繭",
            "text": "…何でもない。",
            "zh": "……没什么。",
            "narrator_zh": "茧"
        },
        {
            "location": "760/TALK",
            "narrator": "キリト",
            "text": "なんか、違うこと\n想像してたんじゃ\nねぇか？",
            "zh": "你是不是\n想成别的事\n了啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "761/TALK",
            "narrator": "雛",
            "text": "まあ、冗談はともかく\nとして――",
            "zh": "嘛，玩笑先\n放到一边——",
            "narrator_zh": "雏"
        },
        {
            "location": "762/TALK",
            "narrator": "雛",
            "text": "任務以外にバイトも\nあるなんて、特別\n攻撃隊も大変だね。",
            "zh": "任务之外还有打工，\n特别攻击队\n也真辛苦呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "764/TALK",
            "narrator": "ヒカル",
            "text": "そうですね。\n学校終わってからも\n仕事なんですから。",
            "zh": "是啊。\n放学之后\n也还有工作。",
            "narrator_zh": "光"
        },
        {
            "location": "765/TALK",
            "narrator": "雛",
            "text": "あたし達も、\n手伝えることあれば\nいいんだけどなぁ…。",
            "zh": "要是我们也\n能帮上什么忙\n就好了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "766/TALK",
            "narrator": "キリト",
            "text": "手伝うっつーか、\n俺もやりてぇよ。",
            "zh": "说是帮忙，\n我也想做啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "767/TALK",
            "narrator": "キリト",
            "text": "小遣いだけじゃ、\n中々欲しい物も\n買えねぇしなぁ…。",
            "zh": "光靠零花钱，\n想要的东西\n也不太买得起……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "769/TALK",
            "narrator": "雛",
            "text": "わかるわかる。\nやっぱバイトとか、\nしたいよねー。",
            "zh": "懂懂。\n果然还是想\n打工呀——。",
            "narrator_zh": "雏"
        },
        {
            "location": "770/TALK",
            "narrator": "雛",
            "text": "お小遣いだけだと、\n欲しい物も中々\n買えないし…。",
            "zh": "光靠零花钱，\n想要的东西\n也不太买得起……。",
            "narrator_zh": "雏"
        },
        {
            "location": "772/TALK",
            "narrator": "ヒカル",
            "text": "戦艦や鉄道の模型は、\n高い物が多いです\nからね。",
            "zh": "战舰和铁路的模型，\n贵的很多\n呀。",
            "narrator_zh": "光"
        },
        {
            "location": "774/TALK",
            "narrator": "キリト",
            "text": "っ！？\nな、何でわかるん\nだよ！？",
            "zh": "っ！？\n为、为什么\n你知道！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "776/TALK",
            "narrator": "雛",
            "text": "まさかヒカルくん、\n超能力使いなの！？",
            "zh": "难道光，\n是超能力者！？",
            "narrator_zh": "雏"
        },
        {
            "location": "779/TALK",
            "narrator": "ヒカル",
            "text": "あ、いえ、そういう\nことじゃなくて、\nえぇっと…。",
            "zh": "啊，不是，\n不是那个意思，\n那个……。",
            "narrator_zh": "光"
        },
        {
            "location": "782/TALK",
            "narrator": "繭",
            "text": "…ワンパターンって\n気付いてないのか。",
            "zh": "……没发现自己\n老是一个套路吗。",
            "narrator_zh": "茧"
        },
        {
            "location": "793/DIALOG",
            "narrator": "Dialog_chapter_ch01",
            "text": "【07 愛，ロボット】",
            "zh": "【07 爱，机器人】",
            "narrator_zh": "Dialog_chapter_ch01"
        }
    ]
}
