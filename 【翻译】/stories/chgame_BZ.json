    "entry": [
        {
            "location": "656/SCENARIO",
            "narrator": "",
            "text": "BZエンディング",
            "zh": "BZ结局",
            "narrator_zh": ""
        },
        {
            "location": "667/TALK",
            "narrator": "千羽鶴",
            "text": "ついにここまで\n辿り着いたのね。",
            "zh": "终于一路\n走到这里了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "669/TALK",
            "narrator": "千羽鶴",
            "text": "これも\n貴方の協力が\nあってこそ。",
            "zh": "这也全靠\n有你的\n协助。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "670/SEL",
            "narrator": "",
            "text": "異様に不気味なんですが",
            "zh": "这里异常地阴森，不过……",
            "narrator_zh": ""
        },
        {
            "location": "671/ACT",
            "narrator": "",
            "text": "異様に不気味なんですが",
            "zh": "这里异常地阴森，不过……",
            "narrator_zh": ""
        },
        {
            "location": "673/TALK",
            "narrator": "千羽鶴",
            "text": "大丈夫。\nラストダンジョンだし\nこんなもの。",
            "zh": "没事。\n最终迷宫嘛，\n都是这样。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "675/TALK",
            "narrator": "千羽鶴",
            "text": "あ！\nあそこに転がってるのは\nまさに宝玉！",
            "zh": "啊！\n那边滚着的，\n正是宝玉！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "676/SEL",
            "narrator": "",
            "text": "宝玉なのに\n転がってるんすか！",
            "zh": "明明是宝玉，\n居然会滚啊！",
            "narrator_zh": ""
        },
        {
            "location": "677/ACT",
            "narrator": "",
            "text": "宝玉なのに\n転がってるんすか！",
            "zh": "明明是宝玉，\n居然会滚啊！",
            "narrator_zh": ""
        },
        {
            "location": "680/TALK",
            "narrator": "千羽鶴",
            "text": "ゲットした。",
            "zh": "拿到了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "681/SEL",
            "narrator": "",
            "text": "早っ！",
            "zh": "好快！",
            "narrator_zh": ""
        },
        {
            "location": "682/ACT",
            "narrator": "",
            "text": "早っ！",
            "zh": "好快！",
            "narrator_zh": ""
        },
        {
            "location": "684/TALK",
            "narrator": "千羽鶴",
            "text": "こんなところに時間を\n使ってなんか\nいられないもの。",
            "zh": "可没工夫，\n把时间浪费在\n这种地方。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "685/TALK",
            "narrator": "千羽鶴",
            "text": "さあ、\n早速この宝玉で、私から\n「非」を取り除くの。",
            "zh": "来，\n马上用这块宝玉，\n把我身上的「非」除掉。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "686/TALK",
            "narrator": "千羽鶴",
            "text": "貴方も一緒に\n祈ってほしい。",
            "zh": "希望你也\n一起祈祷。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "687/TALK",
            "narrator": "千羽鶴",
            "text": "「非」よ！\n闇の彼方へと\n消えたまへ！！",
            "zh": "「非」啊！\n消失到黑暗的\n彼方去吧！！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "688/SEL",
            "narrator": "",
            "text": "一緒に祈る",
            "zh": "一起祈祷",
            "narrator_zh": ""
        },
        {
            "location": "689/ACT",
            "narrator": "",
            "text": "一緒に祈る",
            "zh": "一起祈祷",
            "narrator_zh": ""
        },
        {
            "location": "761/TALK",
            "narrator": "千羽鶴",
            "text": "やった……！",
            "zh": "成功了……！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "762/TALK",
            "narrator": "千羽鶴",
            "text": "私、ついにこれで\n『攻略対象』に\nなったのね。",
            "zh": "我，终于借此\n成为了\n『攻略对象』。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "763/SEL",
            "narrator": "",
            "text": "おめでとう！！",
            "zh": "恭喜！！",
            "narrator_zh": ""
        },
        {
            "location": "764/ACT",
            "narrator": "",
            "text": "おめでとう！！",
            "zh": "恭喜！！",
            "narrator_zh": ""
        },
        {
            "location": "766/TALK",
            "narrator": "千羽鶴",
            "text": "ありがとう。",
            "zh": "谢谢。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "767/SEL",
            "narrator": "",
            "text": "それじゃ早速、つき合ってください！",
            "zh": "那么马上，请和我交往吧！",
            "narrator_zh": ""
        },
        {
            "location": "768/ACT",
            "narrator": "",
            "text": "それじゃ早速、つき合ってください！",
            "zh": "那么马上，请和我交往吧！",
            "narrator_zh": ""
        },
        {
            "location": "771/TALK",
            "narrator": "千羽鶴",
            "text": "なんで？",
            "zh": "为什么？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "772/SEL",
            "narrator": "",
            "text": "だって、攻略対象でしょ？",
            "zh": "因为，是攻略对象吧？",
            "narrator_zh": ""
        },
        {
            "location": "773/ACT",
            "narrator": "",
            "text": "だって、攻略対象でしょ？",
            "zh": "因为，是攻略对象吧？",
            "narrator_zh": ""
        },
        {
            "location": "775/TALK",
            "narrator": "千羽鶴",
            "text": "意味がわからない。\nどうして攻略対象と\nつき合うの？",
            "zh": "不懂你的意思。\n为什么要和\n攻略对象交往？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "776/SEL",
            "narrator": "",
            "text": "え？？　そりゃ、攻略対象だから……",
            "zh": "诶？？　那当然，因为是攻略对象……",
            "narrator_zh": ""
        },
        {
            "location": "777/ACT",
            "narrator": "",
            "text": "え？？　そりゃ、攻略対象だから……",
            "zh": "诶？？　那当然，因为是攻略对象……",
            "narrator_zh": ""
        },
        {
            "location": "779/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "780/TALK",
            "narrator": "千羽鶴",
            "text": "このゲームの名前、\n覚えてる？",
            "zh": "这个游戏的名字，\n还记得吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "781/SEL",
            "narrator": "",
            "text": "『ちーちゃんとラブラブRPGゲーム！』ですよね？",
            "zh": "是『和小千甜甜蜜蜜RPG游戏！』吧？",
            "narrator_zh": ""
        },
        {
            "location": "782/ACT",
            "narrator": "",
            "text": "『ちーちゃんとラブラブRPGゲーム！』ですよね？",
            "zh": "是『和小千甜甜蜜蜜RPG游戏！』吧？",
            "narrator_zh": ""
        },
        {
            "location": "784/TALK",
            "narrator": "千羽鶴",
            "text": "そう。RPG。",
            "zh": "是的。RPG。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "785/TALK",
            "narrator": "千羽鶴",
            "text": "RPGで\n攻略対象といえば？",
            "zh": "在RPG里，\n说到攻略对象是？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "786/SEL",
            "narrator": "",
            "text": "攻略対象と…いえば…",
            "zh": "攻略对象……是指……",
            "narrator_zh": ""
        },
        {
            "location": "787/ACT",
            "narrator": "",
            "text": "攻略対象と…いえば…",
            "zh": "攻略对象……是指……",
            "narrator_zh": ""
        },
        {
            "location": "789/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "790/TALK",
            "narrator": "千羽鶴",
            "text": "あとは、記録映像が\n答えを教えてくれる。",
            "zh": "剩下的，就让录像\n告诉你答案。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "659/DIALOG",
            "narrator": "INFO",
            "text": "偉大なる宝玉の城に\n到着した！",
            "zh": "已抵达\n伟大的宝玉之城！",
            "narrator_zh": "INFO"
        },
