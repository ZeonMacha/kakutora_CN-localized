{
    "dir": "chap00/daydra/spev_ch04_003.js",
    "type": "",
    "info": {
        "story_id": "4003",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "美味しく食べるのが一番",
        "title_zh": "特别篇",
        "sub_title_zh": "好吃地吃下去最重要"
    },
    "entry": [
        {
            "location": "23/TALK",
            "narrator": "透明みやび",
            "text": "むぐむぐ…。\nしっかし不思議な\n話やねぇ。",
            "zh": "唔咕唔咕……\n不过真是不可思议\n的事咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "24/TALK",
            "narrator": "透明みやび",
            "text": "どうってことない\n味付けのこーんな\n食べ物も――",
            "zh": "就算是不知加了些什么\n调味料的这种\n普通小吃——",
            "narrator_zh": "透明雅"
        },
        {
            "location": "25/TALK",
            "narrator": "透明みやび",
            "text": "祭りで食べると\n不思議と美味しく\n感じられてしまう。",
            "zh": "只要在祭典上吃，\n就会不可思议地\n觉得特别美味。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "28/TALK",
            "narrator": "透明みやび",
            "text": "これはあれやね。\n一種の催眠状態に\nあるゆうことか？",
            "zh": "这就是那个咯。\n意思是人处于\n一种催眠状态咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "29/TALK",
            "narrator": "透明みやび",
            "text": "つまりお祭りは\nフェノメノンの中と\n似ていると結論する。",
            "zh": "也就是说，我得出结论：\n祭典跟PhenoMENON里面\n很相似。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "30/TALK",
            "narrator": "透明つばめ",
            "text": "なるほどぉ。\n言われてみると\nそんな感じしますね！",
            "zh": "原来如此呀。\n经你这么一说，\n好像确实有点那种感觉呢！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "32/TALK",
            "narrator": "透明みやび",
            "text": "…つばめちゃん、\nまっこと詐欺には\n気をつけてな。",
            "zh": "……燕，\n你以后真得\n小心被骗啊。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "34/TALK",
            "narrator": "透明つばめ",
            "text": "え？　それって\nどういう――",
            "zh": "诶？　你说的\n是什么——",
            "narrator_zh": "透明燕"
        },
        {
            "location": "36/TALK",
            "narrator": "透明つばめ",
            "text": "って、みやびさん！\n胸元が大変なことに\nなってます！",
            "zh": "不对，雅！\n你胸口那里\n大事不妙了呀！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "38/TALK",
            "narrator": "透明みやび",
            "text": "うむ、少し前に\nまた成長の兆しを\n見せよって――",
            "zh": "嗯，前阵子\n好像又露出了\n发育的兆头——",
            "narrator_zh": "透明雅"
        },
        {
            "location": "39/TALK",
            "narrator": "透明つばめ",
            "text": "違います！\n見えちゃいそう\nってことです！",
            "zh": "不是啦！\n是快要\n走光了的意思呀！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "41/TALK",
            "narrator": "透明つばめ",
            "text": "すみません、\n直しますね！",
            "zh": "不好意思，\n我帮你整理一下！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "45/TALK",
            "narrator": "透明みやび",
            "text": "んっ…すまんなぁ。\n手間かけさせて。",
            "zh": "唔……没好意思啊。\n还得麻烦你。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "47/TALK",
            "narrator": "透明みやび",
            "text": "美味いもん食べると、\n自然とずり落ちて\nくるがよ。",
            "zh": "一吃好吃的东西，\n领口自然就往下\n滑下来了啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "48/TALK",
            "narrator": "透明つばめ",
            "text": "…ちょっと、\n食べ過ぎな気が\nするんですけど…。",
            "zh": "……总觉得，\n你是不是吃太多\n了呀……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "49/TALK",
            "narrator": "透明みやび",
            "text": "美味いもんは\nたらふく食わんと\n勿体ないちや。",
            "zh": "好吃的东西\n不多吃个饱\n多可惜滴。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "50/TALK",
            "narrator": "透明つばめ",
            "text": "けど、体重増えちゃい\nますよ？",
            "zh": "可是，体重会\n涨起来的哦？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "51/TALK",
            "narrator": "透明みやび",
            "text": "確かに、食べれば\nおデブさんになる\nリスクはある。",
            "zh": "确实，吃东西\n是有变成\n胖子的风险。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "52/TALK",
            "narrator": "透明みやび",
            "text": "けんど、食べんと\n人は大きくなれん\nぞね。",
            "zh": "但是，不吃的话\n人是长不大\n的咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "53/TALK",
            "narrator": "透明つばめ",
            "text": "大きく、ですか？",
            "zh": "长大，是指？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "54/TALK",
            "narrator": "透明みやび",
            "text": "そうや。\nつばめちゃんは\nまだ成長期やき――",
            "zh": "对啊。\n燕还正是\n成长期啵——",
            "narrator_zh": "透明雅"
        },
        {
            "location": "56/TALK",
            "narrator": "透明みやび",
            "text": "しっかり食べんと\n大きくなれんよ。",
            "zh": "不好好吃东西\n可长不大哦。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "57/TALK",
            "narrator": "透明つばめ",
            "text": "…みやびさんは、\nいっぱい食べたから\n大きいんですね？",
            "zh": "……雅就是因为\n吃了很多，\n才这么大的呀？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "58/TALK",
            "narrator": "透明みやび",
            "text": "？　うちはそんなに\n食わんき、大きくは\nないやろ。",
            "zh": "？　我没吃\n那么多啵，不算\n多大咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "59/TALK",
            "narrator": "透明つばめ",
            "text": "大きいですよ！",
            "zh": "明明很大呀！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "62/TALK",
            "narrator": "透明みやび",
            "text": "？　そうかぁ？",
            "zh": "？　是咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "63/SEL",
            "narrator": "（選択肢）",
            "text": "何の話かわかってる？",
            "zh": "你明白她在说什么吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "64/ACT",
            "narrator": "",
            "text": "何の話か分かってる？",
            "zh": "你明白她在说什么吗？",
            "narrator_zh": ""
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "わからん",
            "zh": "没懂啊",
            "narrator_zh": "雅"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "わからんなぁ",
            "zh": "完全没懂啊",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "何のことをトークってるのか",
            "zh": "到底在聊驷马话题",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "どうぞうちに教えてプリーズ",
            "zh": "请好心告诉我Please",
            "narrator_zh": "雅"
        },
        {
            "location": "76/SEL",
            "narrator": "（選択肢）",
            "text": "態度のことだよ",
            "zh": "说的是态度啦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "77/SEL",
            "narrator": "（選択肢）",
            "text": "身長のことだよ",
            "zh": "说的是身高啦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "78/SEL",
            "narrator": "（選択肢）",
            "text": "胸のことだよ",
            "zh": "说的是胸啦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "79/ACT",
            "narrator": "",
            "text": "態度のことだよ",
            "zh": "说的是态度啦",
            "narrator_zh": ""
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "なるほどなるほど",
            "zh": "原来如此原来如此",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "そんなわけあるか！",
            "zh": "怎么可能啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "83/TALK",
            "narrator": "みやび",
            "text": "胸の話以外にあるわけない！",
            "zh": "除了聊胸还能有驷马别的！",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "ここぞとばかりに悪口を言うとは",
            "zh": "趁着这个节骨眼说我坏话",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "相棒はワルと見た",
            "zh": "看来搭档是个坏家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "88/ACT",
            "narrator": "",
            "text": "身長のことだよ",
            "zh": "说的是身高啦",
            "narrator_zh": ""
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんよりはデカいな",
            "zh": "确实比燕高大",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "しかし相棒は初心すぎる",
            "zh": "不过搭档也太纯情了",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんが言うてるのは",
            "zh": "燕在说的",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "胸の話であろう",
            "zh": "明明是胸的话题吧",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "胸、おっぱい、バスト、わかるか？",
            "zh": "胸、欧派、Bust，懂了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "95/ACT",
            "narrator": "",
            "text": "胸のことだよ",
            "zh": "说的是胸啦",
            "narrator_zh": ""
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "恥じらいもなくハッキリ言うとは",
            "zh": "居然毫不害羞地直说出来",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "嫌いではない",
            "zh": "倒也不讨厌",
            "narrator_zh": "雅"
        },
        {
            "location": "99/TALK",
            "narrator": "みやび",
            "text": "むしろ好感度アップアップ",
            "zh": "反而好感度一个劲扑腾着往上升",
            "narrator_zh": "雅"
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "溺れているわけではない",
            "zh": "并不是在溺水",
            "narrator_zh": "雅"
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんはアレか？",
            "zh": "燕她是那个吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "大きくなる方法知りたい？",
            "zh": "想知道变大的方法？",
            "narrator_zh": "雅"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "そう思うてえいのだろうか？",
            "zh": "这么理解得咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "だとすると",
            "zh": "果真如此的话",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "止めないといかんな",
            "zh": "那就非阻止不可了",
            "narrator_zh": "雅"
        },
        {
            "location": "109/SEL",
            "narrator": "（選択肢）",
            "text": "どうして？",
            "zh": "为什么？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "110/ACT",
            "narrator": "",
            "text": "どうして？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "胸は脂肪である",
            "zh": "胸就是脂肪",
            "narrator_zh": "雅"
        },
        {
            "location": "113/TALK",
            "narrator": "みやび",
            "text": "一般的に女性は脂肪がつくことを良しとしない",
            "zh": "一般来说女性都不希望长脂肪",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "肥満を嫌うからである",
            "zh": "因为讨厌发胖",
            "narrator_zh": "雅"
        },
        {
            "location": "115/TALK",
            "narrator": "みやび",
            "text": "故にうちには止める義務がある",
            "zh": "故此我有义务阻止她",
            "narrator_zh": "雅"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんの涙は見たくない！",
            "zh": "我可不想看到燕流眼泪！",
            "narrator_zh": "雅"
        },
        {
            "location": "118/TALK",
            "narrator": "みやび",
            "text": "↑（かっこえいと思うたなら拍手）",
            "zh": "↑（觉得帅气的话请鼓掌）",
            "narrator_zh": "雅"
        },
        {
            "location": "121/SEL",
            "narrator": "（選択肢）",
            "text": "胸はそれでいいの！",
            "zh": "胸那样不就挺好的嘛！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "122/SEL",
            "narrator": "（選択肢）",
            "text": "みやびのそういうところ好きだなぁ",
            "zh": "我就喜欢雅这一点啊",
            "narrator_zh": "（选项）"
        },
        {
            "location": "123/SEL",
            "narrator": "（選択肢）",
            "text": "パチパチパチ！！",
            "zh": "啪啪啪啪！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "124/ACT",
            "narrator": "",
            "text": "胸はそれでいいの！",
            "zh": "胸那样不就挺好的嘛！",
            "narrator_zh": ""
        },
        {
            "location": "125/TALK",
            "narrator": "みやび",
            "text": "かもしれん",
            "zh": "兴许吧",
            "narrator_zh": "雅"
        },
        {
            "location": "126/TALK",
            "narrator": "みやび",
            "text": "しかしちくっと考えてほしい",
            "zh": "但是请你稍微想想啵",
            "narrator_zh": "雅"
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "胸も贅肉も脂肪に違いはなく",
            "zh": "胸部也好赘肉也罢，本质都是脂肪",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "胸より腹やら腕やら足やら尻に付く",
            "zh": "比起长在胸上，更容易长到肚子胳膊腿和屁股上",
            "narrator_zh": "雅"
        },
        {
            "location": "129/SEL",
            "narrator": "（選択肢）",
            "text": "夢がないよ！",
            "zh": "太没梦想了！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "130/ACT",
            "narrator": "",
            "text": "夢がないよ！",
            "zh": "太没梦想了！",
            "narrator_zh": ""
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "リアルの話やき",
            "zh": "讲的是现实的事啵",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "ドリームに惑わされてはいかん",
            "zh": "可不能被美梦迷了眼",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "ＯＫ？",
            "zh": "ＯＫ？",
            "narrator_zh": "雅"
        },
        {
            "location": "135/ACT",
            "narrator": "",
            "text": "みやびのそういうところ好きだなぁ",
            "zh": "我就喜欢雅这一点啊",
            "narrator_zh": ""
        },
        {
            "location": "136/TALK",
            "narrator": "みやび",
            "text": "趣味悪っ！？",
            "zh": "品味真差！？",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "改善すべきと提案する",
            "zh": "建议你抓紧改正",
            "narrator_zh": "雅"
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "でないとうちのようなヘンテコ娘",
            "zh": "不过要不是这样，像我这种怪姑娘",
            "narrator_zh": "雅"
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "とっくに切り捨てられてたか",
            "zh": "早就被你抛弃了咯",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "そう考えると",
            "zh": "这么一想",
            "narrator_zh": "雅"
        },
        {
            "location": "143/TALK",
            "narrator": "みやび",
            "text": "趣味悪くてありがとう",
            "zh": "谢谢你的差品味",
            "narrator_zh": "雅"
        },
        {
            "location": "144/TALK",
            "narrator": "みやび",
            "text": "こう言うべきか？",
            "zh": "是该这么说咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "145/ACT",
            "narrator": "",
            "text": "パチパチパチ！！",
            "zh": "啪啪啪啪！！",
            "narrator_zh": ""
        },
        {
            "location": "146/TALK",
            "narrator": "みやび",
            "text": "盛大な拍手に感謝感激",
            "zh": "对盛大的掌声感激不尽",
            "narrator_zh": "雅"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "とはいえ",
            "zh": "话虽如此",
            "narrator_zh": "雅"
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "文字で拍手されても嬉しくはない",
            "zh": "光用文字鼓掌也高兴不起来",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "みやび",
            "text": "しっかし",
            "zh": "不过话说回来",
            "narrator_zh": "雅"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "女の胸は大きい方がえいものなのだろうか？",
            "zh": "女人的胸真是越大越好咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "154/TALK",
            "narrator": "みやび",
            "text": "趣味は人それぞれというが",
            "zh": "虽说喜好因人而异",
            "narrator_zh": "雅"
        },
        {
            "location": "155/TALK",
            "narrator": "みやび",
            "text": "相棒はその辺どうなが？",
            "zh": "搭档你在这方面怎么看咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "156/SEL",
            "narrator": "（選択肢）",
            "text": "大きい方が好きです",
            "zh": "我喜欢大的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "157/SEL",
            "narrator": "（選択肢）",
            "text": "ペッタンコ万歳！！",
            "zh": "平胸万岁！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "158/SEL",
            "narrator": "（選択肢）",
            "text": "あまり考えたことがない",
            "zh": "没怎么想过",
            "narrator_zh": "（选项）"
        },
        {
            "location": "159/ACT",
            "narrator": "",
            "text": "大きい方が好きです",
            "zh": "我喜欢大的",
            "narrator_zh": ""
        },
        {
            "location": "160/TALK",
            "narrator": "みやび",
            "text": "スケベな正直は良いスケベ",
            "zh": "色得坦诚倒算是个好色鬼",
            "narrator_zh": "雅"
        },
        {
            "location": "161/TALK",
            "narrator": "みやび",
            "text": "つまり相棒は良いスケベ",
            "zh": "也就是说搭档是个好色鬼",
            "narrator_zh": "雅"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "誇りに思ってえいよ",
            "zh": "值得自豪咯",
            "narrator_zh": "雅"
        },
        {
            "location": "163/TALK",
            "narrator": "みやび",
            "text": "少なくとも",
            "zh": "至少",
            "narrator_zh": "雅"
        },
        {
            "location": "164/TALK",
            "narrator": "みやび",
            "text": "うちは嫌いじゃない",
            "zh": "我并不讨厌",
            "narrator_zh": "雅"
        },
        {
            "location": "165/ACT",
            "narrator": "",
            "text": "ペッタンコ万歳！！",
            "zh": "平胸万岁！！",
            "narrator_zh": ""
        },
        {
            "location": "168/TALK",
            "narrator": "みやび",
            "text": "危険人物認定に十分な発言やね",
            "zh": "足够将你认定为危险人物的发言咯",
            "narrator_zh": "雅"
        },
        {
            "location": "169/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "170/TALK",
            "narrator": "みやび",
            "text": "うちもペッタンコに憧れはするが",
            "zh": "其实我也挺向往平胸就是了",
            "narrator_zh": "雅"
        },
        {
            "location": "171/ACT",
            "narrator": "",
            "text": "あまり考えたことがない",
            "zh": "没怎么想过",
            "narrator_zh": ""
        },
        {
            "location": "174/TALK",
            "narrator": "みやび",
            "text": "それはそれで不健全極まりないな",
            "zh": "那倒也是极度不健全啊",
            "narrator_zh": "雅"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "まあ興味は人それぞれ",
            "zh": "嘛，兴趣各不相同",
            "narrator_zh": "雅"
        },
        {
            "location": "176/TALK",
            "narrator": "みやび",
            "text": "胸やなくて尻に興味があるのかもしれんが",
            "zh": "说不定对胸没兴趣，偏偏对屁股有兴趣",
            "narrator_zh": "雅"
        },
        {
            "location": "177/TALK",
            "narrator": "みやび",
            "text": "いずれ詳しく聞きだすとしよう",
            "zh": "改天我再好好审问出来",
            "narrator_zh": "雅"
        },
        {
            "location": "179/TALK",
            "narrator": "みやび",
            "text": "では",
            "zh": "那么",
            "narrator_zh": "雅"
        },
        {
            "location": "180/TALK",
            "narrator": "みやび",
            "text": "たまには上品に別れの挨拶",
            "zh": "偶尔也优雅地道个别",
            "narrator_zh": "雅"
        },
        {
            "location": "182/TALK",
            "narrator": "みやび",
            "text": "ウフフごきげんよう",
            "zh": "唔呵呵，贵安",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "透明みやび",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "透明雅"
        },
        {
            "location": "186/TALK",
            "narrator": "透明みやび",
            "text": "まあ、つばめちゃんの\n気持ちもわかる\nけんど――",
            "zh": "嘛，燕的心情\n我也不是\n不懂，但是——",
            "narrator_zh": "透明雅"
        },
        {
            "location": "188/TALK",
            "narrator": "透明みやび",
            "text": "体重が増えるっちゅう\n心配は、増えてから\nすればえいがよ。",
            "zh": "担心体重\n会涨这种事，\n等涨了再说就得啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "189/TALK",
            "narrator": "透明みやび",
            "text": "今はお互い肥満体系や\nないんやし――",
            "zh": "现在我们俩又不是\n肥胖体型——",
            "narrator_zh": "透明雅"
        },
        {
            "location": "190/TALK",
            "narrator": "透明みやび",
            "text": "美味いもんを楽しく\n食わんと、勿体ない\nぞね。",
            "zh": "好吃的东西不趁兴\n多吃点，那可就\n太可惜咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "192/TALK",
            "narrator": "透明つばめ",
            "text": "…かっこいいけど、\nマネする勇気\nありませんよぉ…。",
            "zh": "……虽然好帅气，\n可我没勇气\n学你呀……",
            "narrator_zh": "透明燕"
        }
    ]
}
