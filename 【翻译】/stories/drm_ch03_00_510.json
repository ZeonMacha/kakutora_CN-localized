 "entry": [
  {
   "location": "528/SCENARIO",
   "narrator": "",
   "text": "530_甘い甘い木曜日"
  },
  {
   "location": "553/TALK",
   "narrator": "ガブリエラ",
   "text": "それは甘い甘い秘密を抱えた",
   "zh": "那是抱着甜甜秘密的",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "554/TALK",
   "narrator": "ガブリエラ",
   "text": "咲く前の花なのです"
  },
  {
   "location": "556/SEL",
   "narrator": "",
   "text": "それって何？",
   "zh": "那是什么？",
   "narrator_zh": ""
  },
  {
   "location": "557/TALK",
   "narrator": "ガブリエラ",
   "text": "甘い甘い秘密の中身は"
  },
  {
   "location": "558/TALK",
   "narrator": "ガブリエラ",
   "text": "バラのジャム"
  },
  {
   "location": "560/ACT",
   "narrator": "",
   "text": "それって何？",
   "zh": "那是什么？",
   "narrator_zh": ""
  },
  {
   "location": "566/SEL",
   "narrator": "",
   "text": "ごめん、何？",
   "zh": "抱歉，什么事？",
   "narrator_zh": ""
  },
  {
   "location": "567/SEL",
   "narrator": "",
   "text": "ああ、あれね",
   "zh": "啊，那个啊",
   "narrator_zh": ""
  },
  {
   "location": "568/ACT",
   "narrator": "",
   "text": "ごめん、何？",
   "zh": "抱歉，什么事？",
   "narrator_zh": ""
  },
  {
   "location": "569/TALK",
   "narrator": "ガブリエラ",
   "text": "わからないのかしら？",
   "zh": "你不知道吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "570/ACT",
   "narrator": "",
   "text": "ああ、あれね",
   "zh": "啊，那个啊",
   "narrator_zh": ""
  },
  {
   "location": "571/TALK",
   "narrator": "ガブリエラ",
   "text": "あら、ちゃんとわかってるのかしら？"
  },
  {
   "location": "573/TALK",
   "narrator": "ガブリエラ",
   "text": "脂の木曜日に食べる"
  },
  {
   "location": "574/TALK",
   "narrator": "ガブリエラ",
   "text": "ポンチキのことよ！？"
  },
  {
   "location": "576/SEL",
   "narrator": "",
   "text": "脂の木曜日って？",
   "zh": "脂肪星期四是什么？",
   "narrator_zh": ""
  },
  {
   "location": "577/SEL",
   "narrator": "",
   "text": "ポンチキって？",
   "zh": "波兰甜甜圈是什么？",
   "narrator_zh": ""
  },
  {
   "location": "578/ACT",
   "narrator": "",
   "text": "脂の木曜日って？",
   "zh": "脂肪星期四是什么？",
   "narrator_zh": ""
  },
  {
   "location": "579/TALK",
   "narrator": "ガブリエラ",
   "text": "そんなことも知らないのかしら？！",
   "zh": "那种事你都不知道吗！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "580/TALK",
   "narrator": "ガブリエラ",
   "text": "ポンチキを食べる日よ！"
  },
  {
   "location": "581/ACT",
   "narrator": "",
   "text": "ポンチキって？",
   "zh": "波兰甜甜圈是什么？",
   "narrator_zh": ""
  },
  {
   "location": "582/TALK",
   "narrator": "ガブリエラ",
   "text": "まあ！",
   "zh": "哎呀！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "583/TALK",
   "narrator": "ガブリエラ",
   "text": "脂の木曜日に食べるもののことも知らないなんて！"
  },
  {
   "location": "586/SEL",
   "narrator": "",
   "text": "えーと……",
   "zh": "那个……",
   "narrator_zh": ""
  },
  {
   "location": "587/SEL",
   "narrator": "",
   "text": "まあいいや……",
   "zh": "算了吧……",
   "narrator_zh": ""
  },
  {
   "location": "588/ACT",
   "narrator": "",
   "text": "えーと……",
   "zh": "那个……",
   "narrator_zh": ""
  },
  {
   "location": "589/ACT",
   "narrator": "",
   "text": "まあいいや……",
   "zh": "算了吧……",
   "narrator_zh": ""
  },
  {
   "location": "591/TALK",
   "narrator": "ガブリエラ",
   "text": "$handle$はどの中身が好きなのかしら？",
   "zh": "$handle$是喜欢哪一段呢？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "592/SEL",
   "narrator": "",
   "text": "えーと",
   "zh": "我想想。",
   "narrator_zh": ""
  },
  {
   "location": "593/TALK",
   "narrator": "ガブリエラ",
   "text": "やっぱりバラのジャムは外せないわよね"
  },
  {
   "location": "594/TALK",
   "narrator": "ガブリエラ",
   "text": "あとプルーンジャム！"
  },
  {
   "location": "596/TALK",
   "narrator": "ガブリエラ",
   "text": "日本だとイチゴジャムが手に入りやすいからそれも作るわね"
  },
  {
   "location": "598/ACT",
   "narrator": "",
   "text": "えーと",
   "zh": "我想想。",
   "narrator_zh": ""
  },
  {
   "location": "600/TALK",
   "narrator": "ガブリエラ",
   "text": "どうしたのかしら？",
   "zh": "怎么了呢？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "602/SEL",
   "narrator": "",
   "text": "結局何の話なの？",
   "zh": "到底在说什么事？",
   "narrator_zh": ""
  },
  {
   "location": "603/SEL",
   "narrator": "",
   "text": "$handle$のために作ってくれるってこと？",
   "zh": "是为$handle$做的？",
   "narrator_zh": ""
  },
  {
   "location": "604/ACT",
   "narrator": "",
   "text": "結局何の話なの？",
   "zh": "到底在说什么事？",
   "narrator_zh": ""
  },
  {
   "location": "605/TALK",
   "narrator": "ガブリエラ",
   "text": "なんでわからないのかしら？？",
   "zh": "为什么不明白呢？？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "606/TALK",
   "narrator": "ガブリエラ",
   "text": "脂の木曜日にはポンチキを食べないといけないのに"
  },
  {
   "location": "607/TALK",
   "narrator": "ガブリエラ",
   "text": "日本じゃ売っていないのよ"
  },
  {
   "location": "608/TALK",
   "narrator": "ガブリエラ",
   "text": "だから",
   "zh": "所以",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "609/TALK",
   "narrator": "ガブリエラ",
   "text": "貴方の分も私が作ってあげるって言っているのよ"
  },
  {
   "location": "610/ACT",
   "narrator": "",
   "text": "$handle$のために作ってくれるってこと？",
   "zh": "是为$handle$做的？",
   "narrator_zh": ""
  },
  {
   "location": "620/TALK",
   "narrator": "ガブリエラ",
   "text": "えっ",
   "zh": "诶",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "621/TALK",
   "narrator": "ガブリエラ",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "622/TALK",
   "narrator": "ガブリエラ",
   "text": "そうだけど・・・",
   "zh": "是这样，不过・・・",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "624/SEL",
   "narrator": "",
   "text": "ありがとう",
   "zh": "谢谢",
   "narrator_zh": ""
  },
  {
   "location": "625/ACT",
   "narrator": "",
   "text": "ありがとう",
   "zh": "谢谢",
   "narrator_zh": ""
  },
  {
   "location": "627/TALK",
   "narrator": "ガブリエラ",
   "text": "別に",
   "zh": "无所谓",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "628/TALK",
   "narrator": "ガブリエラ",
   "text": "お礼とかいいわよ",
   "zh": "道谢什么的不用了",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "629/TALK",
   "narrator": "ガブリエラ",
   "text": "日本じゃ売っていないから"
  },
  {
   "location": "630/TALK",
   "narrator": "ガブリエラ",
   "text": "作らなきゃいけないわっていうだけだから・・・"
  },
  {
   "location": "632/TALK",
   "narrator": "ガブリエラ",
   "text": "でも",
   "zh": "不过",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "633/TALK",
   "narrator": "ガブリエラ",
   "text": "それは",
   "zh": "这个",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "634/TALK",
   "narrator": "ガブリエラ",
   "text": "脂の木曜日は"
  },
  {
   "location": "635/TALK",
   "narrator": "ガブリエラ",
   "text": "ちゃんとしないといけないから",
   "zh": "因为必须好好做",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "636/TALK",
   "narrator": "ガブリエラ",
   "text": "それだけなんだからね！",
   "zh": "就这些而已哦！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "638/TALK",
   "narrator": "ガブリエラ",
   "text": "もう！",
   "zh": "真是！",
   "narrator_zh": "加布里埃拉"
  },
