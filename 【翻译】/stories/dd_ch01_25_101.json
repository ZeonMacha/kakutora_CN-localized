        },
        {
            "location": "420/SEL",
            "narrator": "",
            "text": "何か違うんでしょうか…",
            "zh": "有什么不同吗……",
            "narrator_zh": ""
        },
        {
            "location": "421/ACT",
            "narrator": "",
            "text": "何か違うんでしょうか…",
            "zh": "有什么不同吗……",
            "narrator_zh": ""
        },
        {
            "location": "423/TALK",
            "narrator": "カレン",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "卡莲"
        },
        {
            "location": "424/TALK",
            "narrator": "百鶴　",
            "text": "この違いが\nわからないなんて\nまだまだですね。",
            "zh": "这种差别\n都看不出来，\n你还差得远。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "425/SEL",
            "narrator": "",
            "text": "まだまだで結構です…",
            "zh": "差得远就差得远……",
            "narrator_zh": ""
        },
        {
            "location": "426/SEL",
            "narrator": "",
            "text": "それより今回退治するクランを教えてよ",
            "zh": "比起那个，告诉我这次要讨伐的库兰吧",
            "narrator_zh": ""
        },
        {
            "location": "427/ACT",
            "narrator": "",
            "text": "まだまだで結構です…",
            "zh": "差得远就差得远……",
            "narrator_zh": ""
        },
        {
            "location": "428/TALK",
            "narrator": "百鶴　",
            "text": "向上心がありませんね。",
            "zh": "没有上进心啊。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "429/SEL",
            "narrator": "",
            "text": "無くていいです…",
            "zh": "没有就没有……",
            "narrator_zh": ""
        },
        {
            "location": "430/ACT",
            "narrator": "",
            "text": "無くていいです…",
            "zh": "没有就没有……",
            "narrator_zh": ""
        },
        {
            "location": "432/TALK",
            "narrator": "カレン",
            "text": "そういえば、\n$handle$さんは\n今回はどうしたんですか？",
            "zh": "说起来，\n$handle$\n这次是怎么了？",
            "narrator_zh": "卡莲"
        },
        {
            "location": "433/SEL",
            "narrator": "",
            "text": "いつも通りクランを退治しに来たと思うんですが",
            "zh": "我是照旧来讨伐库兰的吧",
            "narrator_zh": ""
        },
        {
            "location": "434/ACT",
            "narrator": "",
            "text": "いつも通りクランを退治しに来たと思うんですが",
            "zh": "我是照旧来讨伐库兰的吧",
            "narrator_zh": ""
        },
        {
            "location": "436/TALK",
            "narrator": "カレン",
            "text": "あ、なるほどです。\nそりゃそうですよね…。",
            "zh": "啊，原来如此。\n那倒也是……。",
            "narrator_zh": "卡莲"
        },
        {
            "location": "437/ACT",
            "narrator": "",
            "text": "それより今回退治するクランを教えてよ",
            "zh": "比起那个，告诉我这次要讨伐的库兰吧",
            "narrator_zh": ""
        },
        {
            "location": "438/TALK",
            "narrator": "カレン",
            "text": "ああっ！\nそうですよね！\nごめんなさい…。",
            "zh": "啊啊！\n对哦！\n对不起……。",
            "narrator_zh": "卡莲"
        },
        {
            "location": "440/TALK",
            "narrator": "百鶴　",
            "text": "まったく、\nこれだから0xは……。",
            "zh": "真是的，\n所以说0x就是……。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "442/TALK",
            "narrator": "カレン",
            "text": "百鶴さんだって\n同じですよ！",
            "zh": "百鹤你不也\n一样吗！",
            "narrator_zh": "卡莲"
        },
        {
            "location": "443/TALK",
            "narrator": "百鶴　",
            "text": "刷り込まれるから\nあまり名前で\n呼ばないでください。",
            "zh": "会被刻进去的，\n别老用名字\n叫我。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "446/TALK",
            "narrator": "カレン",
            "text": "そ、それじゃ早速\n扉を回しますね！",
            "zh": "那、那就马上\n转动门吧！",
            "narrator_zh": "卡莲"
        },
        {
            "location": "457/TALK",
            "narrator": "カレン",
            "text": "オープンプロセ――",
            "zh": "开放进——",
            "narrator_zh": "卡莲"
        },
        {
            "location": "458/TALK",
            "narrator": "百鶴　",
            "text": "ダメです。今送られて\nきている情報は、契約主\nからのものではないです。",
            "zh": "不行。现在送过来的\n情报，不是契约主\n发来的。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "459/TALK",
            "narrator": "カレン",
            "text": "あ、あれ？",
            "zh": "啊，咦？",
            "narrator_zh": "卡莲"
        },
        {
            "location": "460/TALK",
            "narrator": "百鶴　",
            "text": "どうしたんですか？",
            "zh": "怎么了？",
            "narrator_zh": "百鹤"
        },
        {
            "location": "461/TALK",
            "narrator": "カレン",
            "text": "情報がありません…。",
            "zh": "没有情报……。",
            "narrator_zh": "卡莲"
        },
        {
            "location": "462/TALK",
            "narrator": "百鶴　",
            "text": "……なるほど。\n確かにありませんね。",
            "zh": "……原来如此。\n确实没有。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "463/TALK",
            "narrator": "カレン",
            "text": "これは\n困りましたね……。",
            "zh": "这可\n麻烦了……。",
            "narrator_zh": "卡莲"
        },
        {
            "location": "464/TALK",
            "narrator": "百鶴　",
            "text": "こんな時こそ、\n契約主の映し鏡である\nわたしが判断します。",
            "zh": "这种时候，\n就由作为契约主镜像的\n我来判断。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "465/TALK",
            "narrator": "百鶴　",
            "text": "0x501番地から\n0x021番地へ。",
            "zh": "从0x501地址\n到0x021地址。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "468/TALK",
            "narrator": "カレン",
            "text": "ちょ、ちょっと勝手に！\nしかも逆さまに\n回さないでください！",
            "zh": "等、等一下别擅自来！\n而且别\n倒着转！",
            "narrator_zh": "卡莲"
        },
        {
            "location": "471/TALK",
            "narrator": "百鶴　",
            "text": "情報が落ちてこなくても\nわたしにはソウルで\nわかりますから。",
            "zh": "就算情报不掉下来，\n我用灵魂\n也知道。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "474/TALK",
            "narrator": "カレン",
            "text": "やめてください！",
            "zh": "请停下来！",
            "narrator_zh": "卡莲"
        },
        {
            "location": "475/SEL",
            "narrator": "",
            "text": "ちょ、ちょっと待って！",
            "zh": "等、等一下！",
            "narrator_zh": ""
        },
        {
            "location": "476/ACT",
            "narrator": "",
            "text": "ちょ、ちょっと待って！",
            "zh": "等、等一下！",
            "narrator_zh": ""
        },
        {
            "location": "482/TALK",
            "narrator": "百鶴　",
            "text": "どうしましたか？",
            "zh": "怎么了？",
            "narrator_zh": "百鹤"
        },
        {
            "location": "483/SEL",
            "narrator": "",
            "text": "情報は謎のおねえさんが送るって言ってたから、来てないのはおかしい",
            "zh": "情报不是说由神秘的大姐姐送来吗，没来就奇怪了",
            "narrator_zh": ""
        },
        {
            "location": "484/ACT",
            "narrator": "",
            "text": "情報は謎のおねえさんが送るって言ってたから、来てないのはおかしい",
            "zh": "情报不是说由神秘的大姐姐送来吗，没来就奇怪了",
            "narrator_zh": ""
        },
        {
            "location": "486/TALK",
            "narrator": "百鶴　",
            "text": "なるほど、やはり我々の\n契約主からの情報では\nありませんでしたね。",
            "zh": "原来如此，果然不是\n我们的契约主\n发来的情报。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "487/TALK",
            "narrator": "カレン",
            "text": "で、でも、それが\n届いていないって\nことは――",
            "zh": "可、可是，那份\n没送到，\n就意味着——",
            "narrator_zh": "卡莲"
        },
        {
            "location": "496/TALK",
            "narrator": "カレン",
            "text": "え！？",
            "zh": "哎！？",
            "narrator_zh": "卡莲"
        },
        {
            "location": "497/TALK",
            "narrator": "百鶴　",
            "text": "え",
            "zh": "哎",
            "narrator_zh": "百鹤"
        },
