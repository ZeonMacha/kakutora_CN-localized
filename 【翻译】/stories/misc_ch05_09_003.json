            "text": "いやいやマジで",
            "zh": "不不，是真的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2183/TALK",
            "narrator": "神楽",
            "text": "本気も本気ですー！",
            "zh": "真心也是真心的——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2184/ACT",
            "narrator": "",
            "text": "フランス式だ",
            "zh": "是法式的",
            "narrator_zh": ""
        },
        {
            "location": "2186/TALK",
            "narrator": "神楽",
            "text": "そうそれ",
            "zh": "对，就是那个",
            "narrator_zh": "神乐"
        },
        {
            "location": "2187/TALK",
            "narrator": "神楽",
            "text": "向こうは乳児期以降は子供も寝室が別だからね",
            "zh": "那边在婴儿期之后，孩子的卧室也是分开的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2188/TALK",
            "narrator": "神楽",
            "text": "理解のある$handlek$に萌える",
            "zh": "对善解人意的$handlek$萌了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2189/ACT",
            "narrator": "",
            "text": "放置プレイか…",
            "zh": "是放置玩法吗……",
            "narrator_zh": ""
        },
        {
            "location": "2190/TALK",
            "narrator": "神楽",
            "text": "そんなわけないですしー！",
            "zh": "才没有那种事——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2192/TALK",
            "narrator": "神楽",
            "text": "そう言いつつも修学旅行とか林間学校とかにはぴょんこ興味津々",
            "zh": "话是这么说，修学旅行啊、林间学校啊，蹦子可是充满好奇",
            "narrator_zh": "神乐"
        },
        {
            "location": "2194/TALK",
            "narrator": "神楽",
            "text": "だってラノベの定番イベントだから！！！",
            "zh": "因为那是轻小说的定番活动啊！！！",
            "narrator_zh": "神乐"
