            "narrator_zh": "神乐"
        },
        {
            "location": "2175/TALK",
            "narrator": "神楽",
            "text": "親とも一緒に寝泊まりしてねーっつーの",
            "zh": "跟父母也没一起睡过哦",
            "narrator_zh": "神乐"
        },
        {
            "location": "2177/SEL",
            "narrator": "",
            "text": "さすがに盛りすぎ",
            "zh": "这也夸张过头了",
            "narrator_zh": ""
        },
        {
            "location": "2178/SEL",
            "narrator": "",
            "text": "フランス式だ",
            "zh": "是法式的",
            "narrator_zh": ""
        },
        {
            "location": "2179/SEL",
            "narrator": "",
            "text": "放置プレイか…",
            "zh": "是放置玩法吗……",
            "narrator_zh": ""
        },
        {
            "location": "2180/ACT",
            "narrator": "",
            "text": "さすがに盛りすぎ",
            "zh": "这也夸张过头了",
