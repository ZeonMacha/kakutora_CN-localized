            "narrator_zh": ""
        },
        {
            "location": "2170/TALK",
            "narrator": "神楽",
            "text": "そうなんだよねー",
            "zh": "就是说啊——",
            "narrator_zh": "神乐"
        },
        {
            "location": "2172/TALK",
            "narrator": "神楽",
            "text": "無理無理無理無理！！！！",
