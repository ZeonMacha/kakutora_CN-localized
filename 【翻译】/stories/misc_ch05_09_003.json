        },
        {
            "location": "2157/ACT",
            "narrator": "",
            "text": "雑魚寝も楽しいよ",
            "zh": "挤在一起睡也很开心哦",
            "narrator_zh": ""
        },
        {
            "location": "2158/TALK",
            "narrator": "神楽",
            "text": "話し合わなさすぎ",
            "zh": "也太不沟通了",
