        {
            "location": "362/TALK",
            "narrator": "ガブリエラ",
            "text": "知ってはいたけれど、戦国武将って沢山いるのね",
            "zh": "虽然早有耳闻，战国武将还真多啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "364/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、伊達政宗は知ってるわ",
            "zh": "啊，伊达政宗我是知道的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "365/TALK",
            "narrator": "ガブリエラ",
            "text": "あと、上杉謙信もそうよね",
            "zh": "还有，上杉谦信也是吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "366/TALK",
            "narrator": "ガブリエラ",
            "text": "それと、真田幸村！",
            "zh": "再加上，真田幸村！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "369/SEL",
            "narrator": "",
            "text": "有名どころばかりだね",
            "zh": "尽是有名的呢",
            "narrator_zh": ""
        },
        {
            "location": "370/ACT",
            "narrator": "",
            "text": "有名どころばかりだね",
            "zh": "尽是有名的呢",
            "narrator_zh": ""
        },
        {
            "location": "373/TALK",
            "narrator": "ガブリエラ",
            "text": "仕方ないじゃない",
            "zh": "这也没办法嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "374/TALK",
            "narrator": "ガブリエラ",
            "text": "私だって、戦国武将を調べたりはしてないんだから",
            "zh": "我又没有专门去查过战国武将",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "375/TALK",
            "narrator": "ガブリエラ",
            "text": "有名どころ以外の名前は知らないわ",
            "zh": "有名之外的我就不知道了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "378/SEL",
            "narrator": "",
            "text": "知ってる中では誰が好き？",
            "zh": "你知道的人里最喜欢谁？",
            "narrator_zh": ""
        },
        {
            "location": "379/ACT",
            "narrator": "",
            "text": "知ってる中では誰が好き？",
            "zh": "你知道的人里最喜欢谁？",
            "narrator_zh": ""
        },
        {
            "location": "382/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、幸村かしら？",
            "zh": "果然还是幸村吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "383/TALK",
            "narrator": "ガブリエラ",
            "text": "私が一番最初に知ったのが、幸村だし",
            "zh": "毕竟我最早知道的就是幸村",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "384/TALK",
            "narrator": "ガブリエラ",
            "text": "そういえば、真田家ゆかりの地って、信州だったわね",
            "zh": "说起来，跟真田家有渊源的地方是信州来着",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "385/TALK",
            "narrator": "ガブリエラ",
            "text": "今度、アーヤに案内してもらおうかしら？",
