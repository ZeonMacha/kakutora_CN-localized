            "narrator_zh": ""
        },
        {
            "location": "1249/SEL",
            "narrator": "",
            "text": "語尾をヘンな風にしたりする",
            "zh": "会把句尾弄得很怪",
            "narrator_zh": ""
        },
        {
            "location": "1250/ACT",
            "narrator": "",
            "text": "キャラを作ったりするよ",
            "zh": "会立个人设之类的",
            "narrator_zh": ""
        },
        {
            "location": "1251/TALK",
            "narrator": "神楽",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "神乐"
        },
        {
            "location": "1252/TALK",
            "narrator": "神楽",
            "text": "もしかして「にゃんにゃんはにゃんにゃんしちゃうにゃー」みたいなヤツですか？",
            "zh": "难道是「喵喵就要喵喵起来了喵」这种？",
