{
    "dir": "chap29/daydra/dd_ch02_29_010.js",
    "type": "",
    "info": {
        "story_id": "50013",
        "cid": "",
        "title": "SideStory013 ストーリー",
        "sub_title": "FILE10.整理",
        "title_zh": "SideStory013 剧情",
        "sub_title_zh": "FILE10.整理"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "東京編１０話",
            "zh": "东京篇 第10话",
            "narrator_zh": ""
        },
        {
            "location": "15/DIALOG",
            "narrator": "",
            "text": "<color=green>9月6日　 4:12 PM</color>\nとある平日の放課後、付属学園図書室でのこと",
            "zh": "<color=green>9月6日　 4:12 PM</color>\n某个工作日的放学后，于附属学园图书室",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "雛",
            "text": "…床下のＰＣ？",
            "zh": "……地板下的电脑？",
            "narrator_zh": "雏"
        },
        {
            "location": "26/TALK",
            "narrator": "繭",
            "text": "そう、劇場の床下に、\nみやび先輩が設置した\nサーバーが隠してあるの。",
            "zh": "没错，剧场的地板底下，\n藏着雅前辈设置的\n服务器哦。",
            "narrator_zh": "茧"
        },
        {
            "location": "27/TALK",
            "narrator": "繭",
            "text": "今は電源が落ちてるけど、\nもしもその電源を付ける\nことに成功すれば…。",
            "zh": "现在电源是关着的，\n但要是能成功把它的\n电源打开的话……。",
            "narrator_zh": "茧"
        },
        {
            "location": "28/TALK",
            "narrator": "繭",
            "text": "そこから、管理庁の\nシステムを攻撃する\nことができる。",
            "zh": "就能从那里，\n对管理厅的系统\n发动攻击。",
            "narrator_zh": "茧"
        },
        {
            "location": "29/TALK",
            "narrator": "雛",
            "text": "えぇっ！\nそんなことできるの！？",
            "zh": "哎哎！？\n还能做到这种事吗！？",
            "narrator_zh": "雏"
        },
        {
            "location": "30/TALK",
            "narrator": "繭",
            "text": "ええ…システムを狂わせる\nことができれば、管理庁も\n簡単に動けなくなるし…。",
            "zh": "嗯……要是能让系统\n陷入混乱的话，管理厅也\n就没法轻易行动了……。",
            "narrator_zh": "茧"
        },
        {
            "location": "31/TALK",
            "narrator": "繭",
            "text": "みやび先輩達も、\n動きやすくなるはず。",
            "zh": "雅前辈她们，\n应该也会更容易行动。",
            "narrator_zh": "茧"
        },
        {
            "location": "32/TALK",
            "narrator": "雛",
            "text": "スゴいよ！\nなにその秘密兵器！？",
            "zh": "好厉害！\n那是什么秘密武器呀！？",
            "narrator_zh": "雏"
        },
        {
            "location": "33/TALK",
            "narrator": "雛",
            "text": "それさえあれば、\nもう怖いもんなしだね！",
            "zh": "只要有那个在，\n就再也不用怕了呢！",
            "narrator_zh": "雏"
        },
        {
            "location": "34/TALK",
            "narrator": "繭",
            "text": "だから、問題はそれを\nするためのサーバーの\n電源落ちてて…。",
            "zh": "所以说，问题就在于\n用来做这件事的服务器\n现在断着电……。",
            "narrator_zh": "茧"
        },
        {
            "location": "35/TALK",
            "narrator": "雛",
            "text": "大丈夫だよー！\nそれくらいだったら、\nあたしとヒカルくんで――",
            "zh": "没关系啦——！\n这种程度的事，\n交给我和光——",
            "narrator_zh": "雏"
        },
        {
            "location": "42/TALK",
            "narrator": "雛",
            "text": "あれ…どうしたんだろ？",
            "zh": "哎……怎么回事呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "43/TALK",
            "narrator": "繭",
            "text": "？",
            "zh": "？",
            "narrator_zh": "茧"
        },
        {
            "location": "44/TALK",
            "narrator": "雛",
            "text": "ヒカルくんから…、\nカラオケボックスに集合、\nだって…。",
            "zh": "光发消息说……\n在卡拉OK包厢集合，\n来着……。",
            "narrator_zh": "雏"
        },
        {
            "location": "45/TALK",
            "narrator": "繭",
            "text": "早速作戦会議？",
            "zh": "这么快就要开作战会议了？",
            "narrator_zh": "茧"
        },
        {
            "location": "49/TALK",
            "narrator": "雛",
            "text": "…違うと思う。\nまゆちんも連れてきて、\nって言ってるし…。",
            "zh": "……我觉得不是。\n他还说把小茧也\n一起叫上……。",
            "narrator_zh": "雏"
        },
        {
            "location": "50/TALK",
            "narrator": "繭",
            "text": "…私が協力すること、\nヒカルはまだ知らないはず\nだけど？",
            "zh": "……我要帮忙这件事，\n光应该还不知道\n才对吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "51/TALK",
            "narrator": "雛",
            "text": "変だよね…。\nとにかく、行ってみよ。",
            "zh": "真奇怪呢……。\n总之，先过去看看吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "69/TALK",
            "narrator": "雛",
            "text": "ごめーん。\n遅くなっちゃったー。",
            "zh": "抱歉——。\n来晚了一点——。",
            "narrator_zh": "雏"
        },
        {
            "location": "72/TALK",
            "narrator": "繭",
            "text": "…何か用事？",
            "zh": "……有什么事吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "74/TALK",
            "narrator": "キリト",
            "text": "…おっす。",
            "zh": "……哟。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "75/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "76/TALK",
            "narrator": "繭",
            "text": "は？",
            "zh": "哈？",
            "narrator_zh": "茧"
        },
        {
            "location": "77/TALK",
            "narrator": "雛",
            "text": "ど、どうしてキリトまで\nいるの！？",
            "zh": "怎、怎么连圣翔\n都在这儿呀！？",
            "narrator_zh": "雏"
        },
        {
            "location": "79/TALK",
            "narrator": "ヒカル",
            "text": "あはは…説明しますから、\nとりあえず落ち着いて…。",
            "zh": "啊哈哈……我会解释的，\n总之先冷静下来……。",
            "narrator_zh": "光"
        },
        {
            "location": "80/TALK",
            "narrator": "雛",
            "text": "っていうか、二人とも\nボロボロになってない？",
            "zh": "话说回来，你们两个\n怎么搞得一身狼狈？",
            "narrator_zh": "雏"
        },
        {
            "location": "81/TALK",
            "narrator": "キリト",
            "text": "そりゃな…通常攻撃隊の\n武器保管庫に忍び込んで\n来たんだからな…。",
            "zh": "那当然啦……我们可是\n潜进了普通攻击队的\n武器库出来的啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "82/TALK",
            "narrator": "雛",
            "text": "えぇっ！？",
            "zh": "哎哎！？",
            "narrator_zh": "雏"
        },
        {
            "location": "83/TALK",
            "narrator": "ヒカル",
            "text": "危うくバレかけたけど、\nほら、この通り僕達の\n装備は持ち出せたよ。",
            "zh": "虽然差点就被发现了，\n但你看，我们还是顺利\n把我们的装备带出来了哦。",
            "narrator_zh": "光"
        },
        {
            "location": "84/TALK",
            "narrator": "キリト",
            "text": "なにするにせよ、\nそれ相応の装備は\n必要だと思ったからな。",
            "zh": "不管要做什么，\n我都觉得还是得带上\n相应的装备才行啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "88/TALK",
            "narrator": "繭",
            "text": "…どういうこと？\n説明して。",
            "zh": "……这是怎么回事？\n解释清楚。",
            "narrator_zh": "茧"
        },
        {
            "location": "89/TALK",
            "narrator": "キリト",
            "text": "そりゃこっちのセリフだ。\nおい、繭！",
            "zh": "这话该我问才对吧。\n喂，茧！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "90/TALK",
            "narrator": "キリト",
            "text": "おまえ、俺に内緒で\nひなこ達に協力しようと\nしただろ？",
            "zh": "你刚才是不是想瞒着我，\n去帮雏子她们的忙\n来着？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "93/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "94/TALK",
            "narrator": "キリト",
            "text": "やっぱりな。",
            "zh": "果然如此。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "97/TALK",
            "narrator": "繭",
            "text": "何も言ってない！",
            "zh": "我可什么都没说！",
            "narrator_zh": "茧"
        },
        {
            "location": "98/TALK",
            "narrator": "キリト",
            "text": "おまえの無言は\nイエスってことだろ？",
            "zh": "你一沉默不就是\n默认的意思嘛？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "99/TALK",
            "narrator": "キリト",
            "text": "昔っからそうだからな。",
            "zh": "打从以前起你就这样了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "101/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "102/TALK",
            "narrator": "キリト",
            "text": "てか、ひなこ。\nおまえもおまえだよ。",
            "zh": "话说回来，雏子。\n你也是的啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "103/TALK",
            "narrator": "キリト",
            "text": "繭が協力してくれることに\nなったって、どうして俺に\n一言もねぇんだ？",
            "zh": "茧都答应帮忙了，\n怎么连一句话\n都不告诉我啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "105/TALK",
            "narrator": "雛",
            "text": "そ、それは…。",
            "zh": "那、那是因为……。",
            "narrator_zh": "雏"
        },
        {
            "location": "106/TALK",
            "narrator": "キリト",
            "text": "はぁ…まさか、俺だけ\n仲間外れにされる日が\n来るとはなぁ…。",
            "zh": "唉……真没想到，\n有朝一日居然会只有我\n被排挤在外啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "108/TALK",
            "narrator": "雛",
            "text": "ち、違うよー！\n仲間外れにしようなんて\n思ってないからー！",
            "zh": "才、才不是呢——！\n我们根本没想过\n要排挤你啦——！",
            "narrator_zh": "雏"
        },
        {
            "location": "109/TALK",
            "narrator": "繭",
            "text": "…感心した私が\nバカだった。",
            "zh": "……我还佩服你来着，\n真是太蠢了。",
            "narrator_zh": "茧"
        },
        {
            "location": "110/TALK",
            "narrator": "キリト",
            "text": "は？",
            "zh": "哈？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "112/TALK",
            "narrator": "繭",
            "text": "初めてまともな判断を\nしたと思ったのに、\n結局はこうなるのね…。",
            "zh": "我还以为你总算做了一回\n像样的判断，\n结果还不是变成这样……。",
            "narrator_zh": "茧"
        },
        {
            "location": "113/TALK",
            "narrator": "キリト",
            "text": "…まあ、怒られるとは\n思ってたけどな。",
            "zh": "……嘛，我是早料到\n会被你骂的啦。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "114/TALK",
            "narrator": "キリト",
            "text": "でもさ、自分の気持ちに\n正直な今の方が、\n気持ちが軽いんだよ。",
            "zh": "不过啊，像现在这样\n坦率面对自己的心意，\n心里反而轻松多了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "115/TALK",
            "narrator": "キリト",
            "text": "やっぱ自分を抑え込むって\nストレス溜まるんだな。\nあははは！",
            "zh": "果然一直压抑自己\n会攒一肚子压力呢。\n啊哈哈哈哈！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "116/TALK",
            "narrator": "繭",
            "text": "…バカ。",
            "zh": "……笨蛋。",
            "narrator_zh": "茧"
        },
        {
            "location": "117/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "118/TALK",
            "narrator": "ヒカル",
            "text": "あ、えっと…。",
            "zh": "啊，那个……。",
            "narrator_zh": "光"
        },
        {
            "location": "119/TALK",
            "narrator": "ヒカル",
            "text": "とにかく！\nこれでまた、僕達は\n四人に戻ったわけだね。",
            "zh": "总之！\n这样一来，我们又\n变回四个人了呢。",
            "narrator_zh": "光"
        },
        {
            "location": "120/TALK",
            "narrator": "キリト",
            "text": "ああ、そうだな。",
            "zh": "嗯，是啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "121/TALK",
            "narrator": "繭",
            "text": "不本意ながら。",
            "zh": "虽然非我所愿。",
            "narrator_zh": "茧"
        },
        {
            "location": "122/TALK",
            "narrator": "雛",
            "text": "…さっきのあの話は、\nなんだったのかな？",
            "zh": "……刚才那番话，\n到底是怎么回事呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "123/TALK",
            "narrator": "ヒカル",
            "text": "みんな、それぞれ\n思うところがあった\nってことだよ。",
            "zh": "就是大家，\n各自都有自己的\n想法和考量啦。",
            "narrator_zh": "光"
        },
        {
            "location": "124/TALK",
            "narrator": "キリト",
            "text": "よーし、ここまで来たら\n最後まで四人一緒だぜ？",
            "zh": "好——既然都到这一步了，\n那四个人就一起干到最后吧！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "125/TALK",
            "narrator": "繭",
            "text": "ええ…こうなったら、\nとことんやってやるわ。",
            "zh": "嗯……事已至此，\n就陪你们奉陪到底吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "126/TALK",
            "narrator": "ヒカル",
            "text": "うん…頑張ろう！",
            "zh": "嗯……加油吧！",
            "narrator_zh": "光"
        },
        {
            "location": "127/TALK",
            "narrator": "雛",
            "text": "よーし、トライナリー\n応援団の力、みんなに\n見せつけてやろー！",
            "zh": "好——！让大家都见识一下，\n我们三重奏应援团的\n厉害吧——！",
            "narrator_zh": "雏"
        },
        {
            "location": "140/TALK",
            "narrator": "アーヤ",
            "text": "あ…。",
            "zh": "啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "144/TALK",
            "narrator": "真幌",
            "text": "…アーヤ、ＷＡＶＥか？",
            "zh": "……绫水，是WAVE吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "145/TALK",
            "narrator": "アーヤ",
            "text": "はい…日向さん達から\nですね…。",
            "zh": "是的……是日向她们\n发来的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "146/TALK",
            "narrator": "真幌",
            "text": "わかってると思うが、\n既読は付けないように\n気を付けろよ？",
            "zh": "我想你应该明白，\n注意千万别标成\n已读了啊？",
            "narrator_zh": "真幌"
        },
        {
            "location": "147/TALK",
            "narrator": "アーヤ",
            "text": "わかってますけど、\nとりあえず内容の\n確認しますね…。",
            "zh": "我知道的，\n不过我先确认一下\n消息内容吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "152/TALK",
            "narrator": "雛",
            "text": "綾水様",
            "zh": "绫水大人",
            "narrator_zh": "雏"
        },
        {
            "location": "153/TALK",
            "narrator": "雛",
            "text": "返信ないのはわかってますので期待してません",
            "zh": "我知道不会有回复所以没指望啦",
            "narrator_zh": "雏"
        },
        {
            "location": "154/TALK",
            "narrator": "雛",
            "text": "でも見てますよね？",
            "zh": "不过你肯定在看的对吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "155/TALK",
            "narrator": "雛",
            "text": "だから報告しまーす",
            "zh": "所以我就来汇报咯——",
            "narrator_zh": "雏"
        },
        {
            "location": "157/TALK",
            "narrator": "キリト",
            "text": "色々話し合った結果っすけど",
            "zh": "总之就是我们商量了好久的结果",
            "narrator_zh": "圣翔"
        },
        {
            "location": "158/TALK",
            "narrator": "キリト",
            "text": "俺たちは俺たちで勝手に動きますんで",
            "zh": "我们决定按照我们的想法自己行动了",
            "narrator_zh": "圣翔"
        },
        {
            "location": "159/TALK",
            "narrator": "ヒカル",
            "text": "綾水先輩達が東京にいない以上",
            "zh": "既然绫水前辈你们不在东京",
            "narrator_zh": "光"
        },
        {
            "location": "160/TALK",
            "narrator": "ヒカル",
            "text": "こっちで自由に動けるのは僕達だけですし",
            "zh": "这边能自由行动的也就只有我们了",
            "narrator_zh": "光"
        },
        {
            "location": "161/TALK",
            "narrator": "ヒカル",
            "text": "それに、止められてもいませんからね",
            "zh": "而且，你们也没有阻止我们呢",
            "narrator_zh": "光"
        },
        {
            "location": "162/TALK",
            "narrator": "繭",
            "text": "止められないということから考えて",
            "zh": "从没有阻止我们这一点来看",
            "narrator_zh": "茧"
        },
        {
            "location": "163/TALK",
            "narrator": "繭",
            "text": "皆さんになにかとんでもない事態が起きたと判断しました",
            "zh": "我们判断各位是遇到了什么不得了的状况",
            "narrator_zh": "茧"
        },
        {
            "location": "164/TALK",
            "narrator": "繭",
            "text": "例えば捕まったとか",
            "zh": "比如说被抓住了之类的",
            "narrator_zh": "茧"
        },
        {
            "location": "165/TALK",
            "narrator": "繭",
            "text": "そうなるともう綾水先輩達に期待はできません",
            "zh": "那样的话也就指望不上绫水前辈你们了",
            "narrator_zh": "茧"
        },
        {
            "location": "166/TALK",
            "narrator": "雛",
            "text": "まゆちん言い過ぎ！",
            "zh": "小茧你话太重了啦！",
            "narrator_zh": "雏"
        },
        {
            "location": "167/TALK",
            "narrator": "繭",
            "text": "返信も既読もないのはそういうこと",
            "zh": "既不回复也不已读就是这么回事",
            "narrator_zh": "茧"
        },
        {
            "location": "168/TALK",
            "narrator": "繭",
            "text": "なので我々は綾水先輩達トライナリーの皆様を救うために",
            "zh": "因此我们为了拯救绫水前辈等三重奏的各位",
            "narrator_zh": "茧"
        },
        {
            "location": "169/TALK",
            "narrator": "繭",
            "text": "行動することを決意しました",
            "zh": "决定采取行动",
            "narrator_zh": "茧"
        },
        {
            "location": "170/TALK",
            "narrator": "キリト",
            "text": "止めたければ連絡よろしくっす！",
            "zh": "想拦住我们的话请随时联系！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "は！？\nなに考えてるのよ\nあの子達！？",
            "zh": "哈！？\n那些孩子到底\n在想什么啊！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "175/TALK",
            "narrator": "真幌",
            "text": "なんだ、どうかしたのか？",
            "zh": "怎么了，出什么事了吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "179/TALK",
            "narrator": "アーヤ",
            "text": "日向さん達、\n私達を助けるために…。",
            "zh": "日向她们说，\n为了救我们……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "180/TALK",
            "narrator": "アーヤ",
            "text": "自分達で勝手に動くと\n言ってきました！",
            "zh": "要按照她们自己的想法\n擅自行动！",
            "narrator_zh": "绫水"
        },
        {
            "location": "181/TALK",
            "narrator": "真幌",
            "text": "なっ！？",
            "zh": "什么！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "182/TALK",
            "narrator": "真幌",
            "text": "バカな！！\nあいつら、死ぬ気か！？",
            "zh": "胡闹！！\n那帮家伙，是不想活了吗！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "183/TALK",
            "narrator": "アーヤ",
            "text": "館長、どうしたら…。\nやめるように\n連絡しますか？",
            "zh": "馆长，这该怎么办……。\n要联系她们\n叫她们住手吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "184/TALK",
            "narrator": "真幌",
            "text": "…いや、多分それは\n逆効果になる。",
            "zh": "……不，那样多半会\n适得其反。",
            "narrator_zh": "真幌"
        },
        {
            "location": "185/TALK",
            "narrator": "真幌",
            "text": "私達と連絡が取れたことで\n更にヤル気を出される\n可能性があるからな…。",
            "zh": "因为一旦能跟我们联系上，\n反而可能会让她们\n干劲更足……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "186/TALK",
            "narrator": "アーヤ",
            "text": "そうでしょうか？",
            "zh": "会这样吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "真幌",
            "text": "これでも、生徒の性格は\n把握しているつもりだ。",
            "zh": "再怎么说，学生的性格\n我自认还是摸得清的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "188/TALK",
            "narrator": "真幌",
            "text": "…あいつらがどう動こうと\nしているのかだけでも\nわかればいいのだが。",
            "zh": "……要是至少能知道\n那帮家伙打算怎么行动\n就好了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "190/TALK",
            "narrator": "アーヤ",
            "text": "…そうだ！",
            "zh": "……对了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと聞きたいことがあるの",
            "zh": "有点事想问你",
            "narrator_zh": "绫水"
        },
        {
            "location": "197/TALK",
            "narrator": "アーヤ",
            "text": "日向さん達の様子",
            "zh": "日向她们的情况",
            "narrator_zh": "绫水"
        },
        {
            "location": "198/TALK",
            "narrator": "アーヤ",
            "text": "なにかわからない？",
            "zh": "你那边知道些什么吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "200/SEL",
            "narrator": "（選択肢）",
            "text": "わかるけど教えない",
            "zh": "知道但我就不告诉你",
            "narrator_zh": "（选项）"
        },
        {
            "location": "201/SEL",
            "narrator": "（選択肢）",
            "text": "放っておいてあげたら？",
            "zh": "放着不管不就好了？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "202/SEL",
            "narrator": "（選択肢）",
            "text": "なんで？",
            "zh": "为什么？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "203/ACT",
            "narrator": "",
            "text": "わかるけど教えない",
            "zh": "知道但我就不告诉你",
            "narrator_zh": ""
        },
        {
            "location": "204/TALK",
            "narrator": "アーヤ",
            "text": "どうして！？",
            "zh": "为什么呀！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "205/ACT",
            "narrator": "",
            "text": "放っておいてあげたら？",
            "zh": "放着不管不就好了？",
            "narrator_zh": ""
        },
        {
            "location": "206/TALK",
            "narrator": "アーヤ",
            "text": "なんてことを言うの！？",
            "zh": "你怎么能说出这种话！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "207/ACT",
            "narrator": "",
            "text": "なんで？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "208/TALK",
            "narrator": "アーヤ",
            "text": "聞かなくてもわかるでしょ？",
            "zh": "还用问吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "209/TALK",
            "narrator": "アーヤ",
            "text": "日向さん達のしようとしてることが",
            "zh": "日向她们要做的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "危険なことだって",
            "zh": "可是很危险的啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "$handle$は",
            "zh": "$handle$难道",
            "narrator_zh": "绫水"
        },
        {
            "location": "213/TALK",
            "narrator": "アーヤ",
            "text": "日向さん達が心配じゃないの！？",
            "zh": "就不担心日向她们吗！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/SEL",
            "narrator": "（選択肢）",
            "text": "あの子達を甘く見過ぎだ",
            "zh": "你也太小看那些孩子了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "216/SEL",
            "narrator": "（選択肢）",
            "text": "アーヤ達だけでなにが出来る？",
            "zh": "光靠绫水你们又能做到什么？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "217/ACT",
            "narrator": "",
            "text": "あの子達を甘く見過ぎだ",
            "zh": "你也太小看那些孩子了",
            "narrator_zh": ""
        },
        {
            "location": "218/TALK",
            "narrator": "アーヤ",
            "text": "甘く見てるとか",
            "zh": "不是小不小看的问题",
            "narrator_zh": "绫水"
        },
        {
            "location": "219/TALK",
            "narrator": "アーヤ",
            "text": "そういう問題じゃない！",
            "zh": "重点不在这里！",
            "narrator_zh": "绫水"
        },
        {
            "location": "220/ACT",
            "narrator": "",
            "text": "アーヤ達だけでなにが出来る？",
            "zh": "光靠绫水你们又能做到什么？",
            "narrator_zh": ""
        },
        {
            "location": "221/TALK",
            "narrator": "アーヤ",
            "text": "それは",
            "zh": "那件事",
            "narrator_zh": "绫水"
        },
        {
            "location": "222/TALK",
            "narrator": "アーヤ",
            "text": "まだわからないけど",
            "zh": "虽然现在还说不准",
            "narrator_zh": "绫水"
        },
        {
            "location": "223/TALK",
            "narrator": "アーヤ",
            "text": "今話してることは",
            "zh": "但现在在说的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "224/TALK",
            "narrator": "アーヤ",
            "text": "そういう問題じゃないから！",
            "zh": "重点根本不在这里！",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/TALK",
            "narrator": "アーヤ",
            "text": "もういいわ",
            "zh": "算了，随你吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "227/TALK",
            "narrator": "アーヤ",
            "text": "珍しく",
            "zh": "真是难得",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "アーヤ",
            "text": "意見合わないみたいだし",
            "zh": "我们好像意见不合呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "241/TALK",
            "narrator": "アーヤ",
            "text": "…館長、どう思います？",
            "zh": "……馆长，你怎么看？",
            "narrator_zh": "绫水"
        },
        {
            "location": "243/TALK",
            "narrator": "真幌",
            "text": "…難しいところだ。",
            "zh": "……这确实很难办。",
            "narrator_zh": "真幌"
        },
        {
            "location": "244/TALK",
            "narrator": "真幌",
            "text": "正直、東京で動いてくれる\n人員がいるというのは、\nとても助かるのは事実だ。",
            "zh": "老实说，在东京那边\n有能帮上忙的人手，\n确实是帮了大忙。",
            "narrator_zh": "真幌"
        },
        {
            "location": "245/TALK",
            "narrator": "真幌",
            "text": "しかし…、容認することは\nできない。",
            "zh": "但是……，我不能\n默许她们这么做。",
            "narrator_zh": "真幌"
        },
        {
            "location": "246/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "247/SEL",
            "narrator": "（選択肢）",
            "text": "生徒を信じてやれ",
            "zh": "相信你的学生吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "248/ACT",
            "narrator": "",
            "text": "生徒を信じてやれ",
            "zh": "相信你的学生吧",
            "narrator_zh": ""
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "館長へのメッセージ",
            "zh": "发给馆长的消息",
            "narrator_zh": "绫水"
        },
        {
            "location": "268/TALK",
            "narrator": "アーヤ",
            "text": "伝えとくわ",
            "zh": "我会转达的",
            "narrator_zh": "绫水"
        },
        {
            "location": "273/TALK",
            "narrator": "アーヤ",
            "text": "…館長、これ。",
            "zh": "……馆长，你看这个。",
            "narrator_zh": "绫水"
        },
        {
            "location": "275/TALK",
            "narrator": "真幌",
            "text": "ん？",
            "zh": "嗯？",
            "narrator_zh": "真幌"
        },
        {
            "location": "276/TALK",
            "narrator": "真幌",
            "text": "…なるほど。",
            "zh": "……原来如此。",
            "narrator_zh": "真幌"
        },
        {
            "location": "277/TALK",
            "narrator": "真幌",
            "text": "こちらの気も知らないで、\n勝手なことを言うものだ。",
            "zh": "真是完全不懂这边的苦心，\n净说些不负责任的话。",
            "narrator_zh": "真幌"
        },
        {
            "location": "278/TALK",
            "narrator": "真幌",
            "text": "…生徒だからこそ、\n放っておけないと\nいうのに…。",
            "zh": "……明明正因为是学生，\n才更放不下心\n来啊……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "281/TALK",
            "narrator": "アーヤ",
            "text": "…館長。",
            "zh": "……馆长。",
            "narrator_zh": "绫水"
        },
        {
            "location": "283/TALK",
            "narrator": "真幌",
            "text": "遊びじゃないんだ…、\nなのに、あいつら…。",
            "zh": "这可不是闹着玩的啊……，\n可那帮家伙却……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "284/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        }
    ]
}
