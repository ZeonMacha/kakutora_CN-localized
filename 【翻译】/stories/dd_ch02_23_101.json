            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "59/SEL",
            "narrator": "",
            "text": "空気が重いね",
            "zh": "气氛好沉重啊",
            "narrator_zh": ""
        },
        {
            "location": "60/ACT",
            "narrator": "",
            "text": "空気が重いね",
            "zh": "气氛好沉重啊",
            "narrator_zh": ""
        },
        {
            "location": "75/TALK",
            "narrator": "アーヤ",
            "text": "仕方ない",
            "zh": "没办法",
            "narrator_zh": "绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "アーヤ",
            "text": "神楽がスパイで",
            "zh": "因为神乐是间谍",
            "narrator_zh": "绫水"
        },
        {
            "location": "77/TALK",
            "narrator": "アーヤ",
            "text": "私たちの敵だったから",
            "zh": "是我们的敌人",
            "narrator_zh": "绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "みんな",
            "zh": "大家",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "ショックが大きいのよ",
            "zh": "受到的打击太大了",
            "narrator_zh": "绫水"
        },
        {
            "location": "81/SEL",
            "narrator": "",
            "text": "アーヤは平気？",
            "zh": "绫水不要紧吗？",
            "narrator_zh": ""
        },
        {
            "location": "82/ACT",
            "narrator": "",
            "text": "アーヤは平気？",
            "zh": "绫水不要紧吗？",
            "narrator_zh": ""
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "私のことはいいから",
            "zh": "不用管我",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "今は",
            "zh": "现在",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "みんなをどうにかしなきゃ",
            "zh": "得先想办法安抚大家才行",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/SEL",
            "narrator": "",
            "text": "手伝おうか？",
            "zh": "要我帮忙吗？",
            "narrator_zh": ""
        },
        {
            "location": "89/SEL",
            "narrator": "",
            "text": "役に立てることはない？",
            "zh": "有什么我能帮上忙的吗？",
            "narrator_zh": ""
        },
        {
            "location": "90/SEL",
            "narrator": "",
            "text": "話なら聞けるよ",
            "zh": "想找人倾诉的话我随时听着哦",
            "narrator_zh": ""
        },
        {
            "location": "91/SEL",
            "narrator": "",
            "text": "一人で抱え込まないで",
            "zh": "别一个人扛着",
            "narrator_zh": ""
        },
        {
            "location": "92/ACT",
            "narrator": "",
            "text": "手伝おうか？",
            "zh": "要我帮忙吗？",
            "narrator_zh": ""
        },
        {
            "location": "93/ACT",
            "narrator": "",
            "text": "役に立てることはない？",
            "zh": "有什么我能帮上忙的吗？",
            "narrator_zh": ""
        },
        {
            "location": "94/ACT",
            "narrator": "",
            "text": "話なら聞けるよ",
            "zh": "想找人倾诉的话我随时听着哦",
            "narrator_zh": ""
        },
        {
            "location": "95/ACT",
            "narrator": "",
            "text": "一人で抱え込まないで",
            "zh": "别一个人扛着",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "アーヤ",
            "text": "大丈夫",
            "zh": "没事的",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/TALK",
            "narrator": "アーヤ",
            "text": "何とかするから",
            "zh": "我会想办法的",
            "narrator_zh": "绫水"
        },
        {
            "location": "100/TALK",
            "narrator": "アーヤ",
            "text": "心配しないで",
            "zh": "不用担心",
            "narrator_zh": "绫水"
        },
        {
            "location": "111/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "113/TALK",
            "narrator": "アーヤ",
            "text": "そうだ。\n確か今日って…。",
            "zh": "对了。\n我记得今天好像是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "…で？\nどうして横須賀で\n降りたのよ？",
            "zh": "……所以呢？\n为什么要在横须贺\n下车呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "155/TALK",
            "narrator": "アーヤ",
            "text": "あら、知らないの？",
            "zh": "哎呀，你不知道吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "156/TALK",
            "narrator": "アーヤ",
            "text": "今日はあの有名な、\n横須賀花火大会の\n日なのよ？",
            "zh": "今天可是那个很有名的\n横须贺烟花大会\n的日子哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "157/TALK",
            "narrator": "ガブリエラ",
            "text": "…で？",
            "zh": "……然后呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "158/TALK",
            "narrator": "アーヤ",
            "text": "ノリが悪いわね…。",
            "zh": "真不捧场呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "159/TALK",
            "narrator": "アーヤ",
            "text": "つまり、今日は\nおもいきって遊ぼう、\nってことよ。",
            "zh": "也就是说，今天\n要痛痛快快地玩一场，\n就是这个意思。",
            "narrator_zh": "绫水"
        },
        {
            "location": "161/TALK",
            "narrator": "ガブリエラ",
            "text": "…正気？\n昨日の夜のこと\n忘れたの！？",
            "zh": "……你清醒吗？\n难道把昨晚发生的事\n都忘了吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "遊ぶ気になんて\nなれるわけないでしょ！",
            "zh": "怎么可能还有心情\n去玩呀！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "164/TALK",
            "narrator": "アーヤ",
            "text": "…じゃあ、何？\nまっすぐ劇場に帰る？",
            "zh": "……那不然呢？\n直接回剧场吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "当然よ。\nまずは帰る。",
            "zh": "那当然了。\n首先得回去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "166/TALK",
            "narrator": "ガブリエラ",
            "text": "それから――",
            "zh": "然后再——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "何もできないわよ。",
            "zh": "什么也做不了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "168/TALK",
            "narrator": "アーヤ",
            "text": "私たちは、管理庁の\n判断がないと動けない\n立場なんだから。",
            "zh": "我们本来就是没有管理厅\n的决断就无法行动的\n立场嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "アーヤ",
            "text": "それに…劇場に戻って\n何をするつもり？",
            "zh": "而且……回到剧场\n又打算做什么呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "170/TALK",
            "narrator": "アーヤ",
            "text": "卯月を探しに行く？\nどこにいるか\nわかってるの？",
            "zh": "去找卯月吗？\n你知道她现在\n在哪里吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "171/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "…まあ、バカ正直に\n自宅に帰っちょる\nわけないきね。",
            "zh": "……嘛，她也不可能\n傻乎乎地直接\n回自己家去嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "175/TALK",
            "narrator": "ガブリエラ",
            "text": "わかってるわよ！\nそんなの…。",
            "zh": "这种事我当然知道！\n不用你说……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "176/TALK",
            "narrator": "アーヤ",
            "text": "…なら、急いで\n帰ったところで\n意味ないでしょ？",
            "zh": "……既然如此，急着\n赶回去也没有\n任何意义吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "177/TALK",
            "narrator": "アーヤ",
            "text": "今日は館長も、\n管理庁の判断を仰ぎに\n行ってるし。",
            "zh": "今天馆长也去\n向管理厅\n请示判断了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "178/TALK",
            "narrator": "アーヤ",
            "text": "多分、夜までは\n戻らないはずよ。",
            "zh": "大概到晚上之前\n都不会回来的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "179/TALK",
            "narrator": "アーヤ",
            "text": "だから、今日は\n気分転換の日にした方が\nいいと思うの。",
            "zh": "所以，我觉得今天\n还是当作转换心情的日子\n比较好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "181/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "183/TALK",
            "narrator": "みやび",
            "text": "…それはあれか？\nリーダーとしての\n命令なが？",
            "zh": "……这算是那个吗？\n作为队长的\n命令喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "185/TALK",
            "narrator": "アーヤ",
            "text": "まさか。\n命令じゃなくて提案よ。",
            "zh": "怎么可能。\n不是命令，只是提议哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "アーヤ",
            "text": "というわけだから、\n私は今日一日、\nおもいっきり遊ぶわ。",
            "zh": "话就说到这儿，\n我今天一整天\n都要痛快玩个够了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "189/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ達も、\nあとは好きにして\nいいから…じゃあね。",
            "zh": "加维你们几个，\n接下来也各自随意吧……\n那待会儿见。",
            "narrator_zh": "绫水"
        },
        {
            "location": "200/TALK",
            "narrator": "ガブリエラ",
            "text": "…ふんっ。",
            "zh": "……哼。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "204/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "219/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "222/TALK",
            "narrator": "アーヤ",
            "text": "あ、小夜。\nこっちこっち。",
            "zh": "啊，小夜。\n这边这边。",
            "narrator_zh": "绫水"
        },
        {
            "location": "225/TALK",
            "narrator": "小夜",
            "text": "おまたせー。\nごめんね、\n結構待った感じ？",
            "zh": "久等啦—。\n抱歉呀，\n等了挺久了吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "226/TALK",
            "narrator": "アーヤ",
            "text": "ううん、\n私も今来たところよ。",
            "zh": "没有，\n我也刚到一会儿哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "227/TALK",
            "narrator": "アーヤ",
            "text": "っていうか、\n急にこんなとこに\n呼び出してごめんね？",
            "zh": "话说回来，\n突然把你叫到这种地方来\n真不好意思啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "小夜",
            "text": "気にしないで。\nちょうど暇してたし。",
            "zh": "别在意。\n反正我刚好闲着呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "229/TALK",
            "narrator": "小夜",
            "text": "それに、横須賀って\n初めてだから、\nちょっと楽しみなんだー。",
            "zh": "而且我还是第一次来\n横须贺，\n心里正期待着呢—。",
            "narrator_zh": "小夜"
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "そうだったの？",
            "zh": "原来是这样啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/TALK",
            "narrator": "小夜",
            "text": "そうなのよ。",
            "zh": "是啊。",
            "narrator_zh": "小夜"
        },
        {
            "location": "234/TALK",
            "narrator": "小夜",
            "text": "でも、まさかこんな\n戦艦があるとは\n思わなかったわ。",
            "zh": "不过，真没想到这儿\n居然停着这么一艘\n战舰呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "236/TALK",
            "narrator": "小夜",
            "text": "あれ、本物？",
            "zh": "那个，是真的吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "237/TALK",
            "narrator": "アーヤ",
            "text": "ええ。\n今は戦艦としての\n機能を失ってるけど。",
            "zh": "嗯。\n虽然现在已经失去作为\n战舰的机能了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "238/TALK",
            "narrator": "アーヤ",
            "text": "日露戦争で\n連合艦隊を務めて。",
            "zh": "在日俄战争中\n担任过联合舰队旗舰，",
            "narrator_zh": "绫水"
        },
        {
            "location": "239/TALK",
            "narrator": "アーヤ",
            "text": "東郷平八郎も\n座乗した、本物の\n戦艦三笠よ。",
            "zh": "东乡平八郎也曾\n乘坐在上面的，正牌的\n战舰三笠哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "241/TALK",
            "narrator": "小夜",
            "text": "詳し過ぎだから！\nえ？　もしかして\n戦艦オタだったとか？",
            "zh": "你也太门清了吧！\n哎？　难不成你以前\n其实是个战舰宅？",
            "narrator_zh": "小夜"
        },
        {
            "location": "243/TALK",
            "narrator": "アーヤ",
            "text": "初めてここに来た時、\n案内してくれた後輩に\n教えてもらったのよ。",
            "zh": "第一次来这里的时候，\n是带我参观的后辈\n讲给我听的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "244/TALK",
            "narrator": "小夜",
            "text": "…濃いなぁ、その後輩。",
            "zh": "……好硬核啊，你那位后辈。",
            "narrator_zh": "小夜"
        },
        {
            "location": "245/TALK",
            "narrator": "アーヤ",
            "text": "あはは…そうね…。",
            "zh": "啊哈哈……是啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "246/TALK",
            "narrator": "小夜",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "小夜"
        },
        {
            "location": "247/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "248/TALK",
            "narrator": "小夜",
            "text": "…そういえばさ、\nあたしお昼ご飯\nまだなんだよね。",
            "zh": "……话说回来，\n我午饭还\n没吃呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "249/TALK",
            "narrator": "アーヤ",
            "text": "私もまだだから、\nどこかでランチに\nしよっか。",
            "zh": "我也还没吃，\n那找个地方吃午饭\n怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "250/TALK",
            "narrator": "小夜",
            "text": "そうね。\n横須賀って何が\n美味しいのかしら？",
            "zh": "好呀。\n来横须贺吃什么\n比较好吃呢？",
            "narrator_zh": "小夜"
        },
        {
            "location": "252/TALK",
            "narrator": "アーヤ",
            "text": "横須賀といえば、\nやっぱりアレでしょ？",
            "zh": "说到横须贺，\n那当然还是那个吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "273/TALK",
            "narrator": "小夜",
            "text": "あ～、辛かったけど、\n凄く美味しかったぁ。",
            "zh": "啊～，虽然有点辣，\n但超级好吃啊。",
            "narrator_zh": "小夜"
        },
        {
            "location": "274/TALK",
            "narrator": "アーヤ",
            "text": "水入れたから、飲んでね。",
            "zh": "我给你倒了水，喝吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "275/TALK",
            "narrator": "小夜",
            "text": "ありがと。",
            "zh": "谢啦。",
            "narrator_zh": "小夜"
        },
        {
            "location": "276/TALK",
            "narrator": "小夜",
            "text": "う～ん…、ダイエット中\nなんだけど、おかわり\nしちゃおうかなぁ？",
            "zh": "唔～……，虽然在减肥\n来着，不过要不要\n再来一碗呢？",
            "narrator_zh": "小夜"
        },
        {
            "location": "278/TALK",
            "narrator": "アーヤ",
            "text": "…なんか、今日は\n一段とテンションが\n高いわね？",
            "zh": "……总觉得你今天\n情绪比平时\n高涨不少嘛？",
            "narrator_zh": "绫水"
        },
        {
            "location": "279/TALK",
            "narrator": "小夜",
            "text": "初横須賀だもの。\nテンションくらい\n上がるわよ。",
            "zh": "毕竟是头一次来横须贺嘛。\n兴奋一点也\n很正常吧。",
            "narrator_zh": "小夜"
        },
        {
            "location": "280/TALK",
            "narrator": "小夜",
            "text": "アーヤだって、\nこんな感じだったん\nじゃないの？",
            "zh": "绫水你第一次来的时候，\n不也是这样\n的吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "281/TALK",
            "narrator": "アーヤ",
            "text": "違うと思うけど…、\nうーん、客観的には\nそうだったのかしら？",
            "zh": "我觉得应该不是……，\n唔，不过客观来看\n难道也是那样吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "282/TALK",
            "narrator": "小夜",
            "text": "えっ！？",
            "zh": "哎！？",
            "narrator_zh": "小夜"
        },
        {
            "location": "283/TALK",
            "narrator": "アーヤ",
            "text": "…なんてね。\n冗談よ。",
            "zh": "……骗你的啦。\n开玩笑的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "284/TALK",
            "narrator": "小夜",
            "text": "あはは、だと思った。",
            "zh": "啊哈哈，我就知道。",
            "narrator_zh": "小夜"
        },
        {
            "location": "285/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…。",
            "zh": "呵呵……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "286/TALK",
            "narrator": "小夜",
            "text": "…で？　ちょっとは\n気分転換できた？",
            "zh": "……那么？　多少\n散了散心吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "287/TALK",
            "narrator": "アーヤ",
            "text": "…やっぱり、\n気づいてたんだ？",
            "zh": "……果然，\n被你看出来了啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "288/TALK",
            "narrator": "小夜",
            "text": "わかりやす過ぎだから。",
            "zh": "因为你太好懂了嘛。",
            "narrator_zh": "小夜"
        },
        {
            "location": "289/TALK",
            "narrator": "小夜",
            "text": "アーヤってさ、\n隠し事のできない\n性格なのよ？",
            "zh": "绫水你呀，\n本来就是藏不住心事的\n性格好吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "291/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "292/TALK",
            "narrator": "小夜",
            "text": "…何かあったの？\n言えないことなら、\n無理に聞かないけど。",
            "zh": "……出什么事了？\n要是不能说的事，\n我也不勉强问你。",
            "narrator_zh": "小夜"
        },
        {
            "location": "293/TALK",
            "narrator": "アーヤ",
            "text": "…お仕事のことよ。",
            "zh": "……是工作上的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "295/TALK",
            "narrator": "アーヤ",
            "text": "…卯月が私たちを\n裏切ったわ。",
            "zh": "……卯月她\n背叛了我们。",
            "narrator_zh": "绫水"
        },
        {
            "location": "296/TALK",
            "narrator": "小夜",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "小夜"
        },
        {
            "location": "297/TALK",
            "narrator": "アーヤ",
            "text": "ううん、正確には\n裏切ったんじゃないの\nかもしれない。",
            "zh": "不，准确来说，\n也许算不上\n背叛吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "299/TALK",
            "narrator": "アーヤ",
            "text": "だって、元々管理庁が\n送り込んできたスパイ\nだったんだから…。",
            "zh": "因为，她本来就是管理厅\n派过来的\n间谍啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "302/TALK",
            "narrator": "小夜",
            "text": "…それって、いつのこと？",
            "zh": "……那是什么时候的事？",
            "narrator_zh": "小夜"
        },
        {
            "location": "304/TALK",
            "narrator": "アーヤ",
            "text": "昨日の夜よ。",
            "zh": "昨天晚上。",
            "narrator_zh": "绫水"
        },
        {
            "location": "306/TALK",
            "narrator": "アーヤ",
            "text": "だから、みんな\nショック受けてて\n空気が重くてね…。",
            "zh": "所以，大家\n都受到了打击，\n气氛沉重得很……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "307/TALK",
            "narrator": "アーヤ",
            "text": "それで気分転換に、\n横須賀に行こう、って\n提案したの。",
            "zh": "我才想着干脆去横须贺\n转换一下心情，\n才这么提议的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "308/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、到着早々\nみんなバラバラに\nなったけど。",
            "zh": "……虽说一到这儿，\n大家就各自\n散开了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "309/TALK",
            "narrator": "小夜",
            "text": "いいんじゃない？\n一人で考えることも\n大切だと思うし。",
            "zh": "这样不也挺好？\n一个人静下来想想\n也很重要呀。",
            "narrator_zh": "小夜"
        },
        {
            "location": "310/TALK",
            "narrator": "小夜",
            "text": "それに…仲間だから\n相談できないことも\nあると思うし。",
            "zh": "而且……正因为是同伴，\n有些事反而\n不好商量吧。",
            "narrator_zh": "小夜"
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "313/TALK",
            "narrator": "小夜",
            "text": "これからどうするの？\nまさか神楽ちゃんと\n戦うつもり？",
            "zh": "接下来你打算怎么办？\n该不会真的要和神乐\n打起来吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "314/TALK",
            "narrator": "アーヤ",
            "text": "…そのつもりよ。",
            "zh": "……我是这么打算的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "315/TALK",
            "narrator": "アーヤ",
            "text": "管理庁の命令だとしても、\n卯月がつばめを殺そうと\nしたのは事実だもの。",
            "zh": "就算那是管理厅的命令，\n卯月企图杀害燕\n也是不争的事实。",
            "narrator_zh": "绫水"
        },
        {
            "location": "316/TALK",
            "narrator": "アーヤ",
            "text": "そんな子相手に、\n容赦してやれるほど\n甘くはないわ。",
            "zh": "面对这样的家伙，\n我可没有天真到\n还能手下留情。",
            "narrator_zh": "绫水"
        },
        {
            "location": "317/TALK",
            "narrator": "小夜",
            "text": "そうかな？",
            "zh": "真的吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "319/TALK",
            "narrator": "アーヤ",
            "text": "そうよ。\n当然でしょ？",
            "zh": "当然。\n这不是理所当然的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "320/TALK",
            "narrator": "アーヤ",
            "text": "…それに、少し前に、\n卯月のことをきつく\n叱ったことがあるの。",
            "zh": "……而且，不久之前，\n我还曾经狠狠地\n训斥过卯月一次。",
            "narrator_zh": "绫水"
        },
        {
            "location": "321/TALK",
            "narrator": "アーヤ",
            "text": "戦闘に集中しないで、\nみんなを危険な目に\n合わせたから…。",
            "zh": "因为她在战斗时不集中精神，\n把大家都置入了\n危险之中……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "322/TALK",
            "narrator": "小夜",
            "text": "うん…。",
            "zh": "嗯……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "324/TALK",
            "narrator": "アーヤ",
            "text": "でも、実はその時、\n卯月の家がフェノメノンに\n巻き込まれてたの。",
            "zh": "可其实那时候，\n卯月家正好被卷进了\nPhenoMENON里。",
            "narrator_zh": "绫水"
        },
        {
            "location": "325/TALK",
            "narrator": "アーヤ",
            "text": "だからあの時、卯月は\n集中できなかったの\nかもしれない…。",
            "zh": "所以当时卯月才会\n没法集中精神\n吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "326/TALK",
            "narrator": "アーヤ",
            "text": "そう思ったから、\n卯月を叱ったことを\n凄く後悔したのに…。",
            "zh": "我原本一想到这里，\n还为自己训斥了卯月\n而感到非常后悔……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "328/TALK",
            "narrator": "アーヤ",
            "text": "…きっと、あれも作戦の\n一つだったんだと思う。",
            "zh": "……恐怕，那也是她计划中的\n一环吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "329/TALK",
            "narrator": "アーヤ",
            "text": "本当…無駄に後悔とか\n同情しちゃったわ。",
            "zh": "真是……白白去后悔、\n白白去同情她了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "330/TALK",
            "narrator": "小夜",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "小夜"
        },
        {
            "location": "332/TALK",
            "narrator": "アーヤ",
            "text": "あ…ごめん。\n嫌な話しちゃって。",
            "zh": "啊……抱歉。\n尽说些让人不愉快的话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "333/TALK",
            "narrator": "小夜",
            "text": "ううん…でも、\n神楽ちゃんにも\n理由があったんじゃない？",
            "zh": "没事……不过，\n神乐她是不是也有\n什么苦衷呢？",
            "narrator_zh": "小夜"
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "行動には何かしらの\n理由があるものでしょ？",
            "zh": "任何行动背后，\n多少都会有理由的吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "335/TALK",
            "narrator": "アーヤ",
            "text": "でも、理由があれば\n何しても許される\nわけじゃないわ。",
            "zh": "但是，不能说有理由，\n就做什么都可以\n被原谅吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "336/TALK",
            "narrator": "アーヤ",
            "text": "ましてや、無抵抗の\n人間を殺そうとする\nなんて…許せない。",
            "zh": "更何况，对毫无反抗能力的\n普通人下杀手什么的……\n绝不能原谅。",
            "narrator_zh": "绫水"
        },
        {
            "location": "337/TALK",
            "narrator": "アーヤ",
            "text": "…だから、今度卯月が\n私たちの前に現れたら、\n絶対に容赦しない。",
            "zh": "……所以，下次卯月再\n出现在我们面前时，\n我绝对不会手下留情。",
            "narrator_zh": "绫水"
        },
        {
            "location": "338/TALK",
            "narrator": "アーヤ",
            "text": "こっちも、殺す気で\n迎え撃ってやるわ。",
            "zh": "我这边，也会抱着杀意\n去迎击她。",
            "narrator_zh": "绫水"
        },
        {
            "location": "339/TALK",
            "narrator": "小夜",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "小夜"
        },
        {
            "location": "340/TALK",
            "narrator": "小夜",
            "text": "本当に…、\nそれでいいの？",
            "zh": "真的……，\n那样就好吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "341/TALK",
            "narrator": "小夜",
            "text": "確かに、アーヤ達を\n裏切ったのかも\nしれないよ？",
            "zh": "确实，她也许真的\n背叛了绫水你们\n没错啦？",
            "narrator_zh": "小夜"
        },
        {
            "location": "342/TALK",
            "narrator": "小夜",
            "text": "けど、ずっと一緒に\n戦ってきたんでしょ？",
            "zh": "可你们一直都是一起\n并肩战斗过来的吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "343/TALK",
            "narrator": "小夜",
            "text": "なのにそんな…。\n本当にそんなこと\nできるの？",
            "zh": "既然这样……。\n你真的能下得了\n那种手吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "344/TALK",
            "narrator": "アーヤ",
            "text": "…もちろんよ。",
            "zh": "……那是当然。",
            "narrator_zh": "绫水"
        },
        {
            "location": "347/TALK",
            "narrator": "アーヤ",
            "text": "私に、迷いは――",
            "zh": "我，没有迷茫——",
            "narrator_zh": "绫水"
        },
        {
            "location": "411/TALK",
            "narrator": "アーヤ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "绫水"
        },
        {
            "location": "427/TALK",
            "narrator": "アーヤの新司書",
            "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。",
            "zh": "欢迎来到\n[心之扉]。\n$handle$。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "428/TALK",
            "narrator": "アーヤの新司書",
            "text": "いよいよ試練の時が\nやってきたみたいね。",
            "zh": "看来终于到了\n考验的时刻了呢。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "429/TALK",
            "narrator": "アーヤの新司書",
            "text": "今回は慎重に\n対応した方がよさそう。",
            "zh": "这一次似乎必须\n谨慎应对才行。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "430/TALK",
            "narrator": "アーヤの新司書",
            "text": "まずは\n扉を回してみるわね。",
            "zh": "我先试着\n转动一下门扉吧。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "435/TALK",
            "narrator": "アーヤの新司書",
            "text": "オープンプロセス、\n0x556番地から\n0x192番地へ。",
            "zh": "开放进程，\n从0x556号地址\n前往0x192号地址。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "457/TALK",
            "narrator": "アーヤの新司書",
            "text": "シーク完了。",
            "zh": "搜索完成。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "460/TALK",
            "narrator": "アーヤの新司書",
            "text": "今回は……",
            "zh": "这一次……",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "462/TALK",
            "narrator": "アーヤの新司書",
            "text": "だいぶ暴走してるわね。",
            "zh": "暴走得相当厉害呢。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "463/TALK",
            "narrator": "アーヤの新司書",
            "text": "ここで止めておかないと\n後で後悔する。",
            "zh": "不在这里拦住她的话，\n事后一定会后悔的。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "464/TALK",
            "narrator": "アーヤの新司書",
            "text": "私は自分が思ってる以上に\n卯月のことを大事に\n思ってるみたいなの。",
            "zh": "我比自己以为的\n还要更加看重\n卯月这个人。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "465/TALK",
            "narrator": "アーヤの新司書",
            "text": "だから、迷いはないと\n言ってしまうことで、\n後に自己嫌悪に陥る。",
            "zh": "所以，一旦嘴硬说出\n没有迷茫这种话，\n之后就会陷入自我厌恶。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "466/TALK",
            "narrator": "アーヤの新司書",
            "text": "精神的に\nちょっと面倒なことに\nなってしまうのよ。",
            "zh": "精神上\n会变得有点\n麻烦呢。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "467/TALK",
            "narrator": "アーヤの新司書",
            "text": "小夜に言ったことで意地も\n出て、後にも引けなくなり\n精神的にも破綻しちゃう。",
            "zh": "在跟小夜放完狠话之后，\n更会为了面子赌气、退无可退，\n导致精神彻底崩溃。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "468/TALK",
            "narrator": "アーヤの新司書",
            "text": "だからここは、\n思い止まらせなければ\nならない。",
            "zh": "所以在这里，\n必须让她打消念头\n才行。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "469/SEL",
            "narrator": "",
            "text": "オーケー",
            "zh": "OK",
            "narrator_zh": ""
        },
        {
            "location": "470/SEL",
            "narrator": "",
            "text": "聞こえはいいけど…",
            "zh": "听起来倒是挺好听的……",
            "narrator_zh": ""
        },
        {
            "location": "471/ACT",
            "narrator": "",
            "text": "オーケー",
            "zh": "OK",
            "narrator_zh": ""
        },
        {
            "location": "472/TALK",
            "narrator": "アーヤの新司書",
            "text": "それじゃ\nいくわよ。",
            "zh": "那么\n开始吧。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "473/ACT",
            "narrator": "",
            "text": "聞こえはいいけど…",
            "zh": "听起来倒是挺好听的……",
            "narrator_zh": ""
        },
        {
            "location": "474/TALK",
            "narrator": "アーヤの新司書",
            "text": "え？\nなに？",
            "zh": "哎？\n怎么了？",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "475/SEL",
            "narrator": "",
            "text": "それって単なる事なかれ主義じゃない？",
            "zh": "这不单纯就是多一事不如少一事的和稀泥吗？",
            "narrator_zh": ""
        },
        {
            "location": "476/SEL",
            "narrator": "",
            "text": "神楽に危害を与えないようにするための精神操作だったりしない？",
            "zh": "该不会是为了不让神乐受到伤害而进行的某种精神操纵吧？",
            "narrator_zh": ""
        },
        {
            "location": "477/ACT",
            "narrator": "",
            "text": "単なる事なかれ主義じゃない？",
            "zh": "单纯就是多一事不如少一事的和稀泥吗？",
            "narrator_zh": ""
        },
        {
            "location": "478/TALK",
            "narrator": "アーヤの新司書",
            "text": "なるほど。まあ、\nそうかもしれないわね。",
            "zh": "原来如此。嘛，\n说不定确实是这样呢。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "479/TALK",
            "narrator": "アーヤの新司書",
            "text": "実際、何事もないのが\n一番なんだし。",
            "zh": "实际上，平安无事\n才是最好的嘛。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "480/TALK",
            "narrator": "アーヤの新司書",
            "text": "それじゃ、行くわね。",
            "zh": "那么，开始吧。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "481/ACT",
            "narrator": "",
            "text": "神楽に危害を与えないようにするための精神操作だったりしない？",
            "zh": "该不会是为了不让神乐受到伤害而进行的某种精神操纵吧？",
            "narrator_zh": ""
        },
        {
            "location": "483/TALK",
            "narrator": "アーヤの新司書",
            "text": "え？\nなにそれ？",
            "zh": "哎？\n什么意思？",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "484/TALK",
            "narrator": "アーヤの新司書",
            "text": "言ってる意味が\nよくわからないんだけど。",
            "zh": "我不太明白\n你在说什么。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "485/SEL",
            "narrator": "",
            "text": "神楽は情報管理庁のスパイなんでしょ？",
            "zh": "神乐是情报管理厅的间谍吧？",
            "narrator_zh": ""
        },
        {
            "location": "486/ACT",
            "narrator": "",
            "text": "神楽は情報管理庁のスパイなんでしょ？",
            "zh": "神乐是情报管理厅的间谍吧？",
            "narrator_zh": ""
        },
        {
            "location": "488/TALK",
            "narrator": "アーヤの新司書",
            "text": "その線が\n濃厚になってるわね。",
            "zh": "目前来看\n这个可能性很高呢。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "489/SEL",
            "narrator": "",
            "text": "契約主って情報管理庁でしょ？",
            "zh": "契约主就是情报管理厅吧？",
            "narrator_zh": ""
        },
        {
            "location": "490/ACT",
            "narrator": "",
            "text": "契約主って情報管理庁でしょ？",
            "zh": "契约主就是情报管理厅吧？",
            "narrator_zh": ""
        },
        {
            "location": "492/TALK",
            "narrator": "アーヤの新司書",
            "text": "それは私には\nわからないわ。",
            "zh": "这个我可\n不知道哦。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "493/SEL",
            "narrator": "",
            "text": "もしそうなら、送られてくる情報は管理庁に都合の良いものにされてない？",
            "zh": "如果是这样，送过来的情报岂不是都被篡改成对管理厅有利的了吗？",
            "narrator_zh": ""
        },
        {
            "location": "494/ACT",
            "narrator": "",
            "text": "もしそうなら、送られてくる情報は管理庁に都合の良いものにされてない？",
            "zh": "如果是这样，送过来的情报岂不是都被篡改成对管理厅有利的了吗？",
            "narrator_zh": ""
        },
        {
            "location": "496/TALK",
            "narrator": "アーヤの新司書",
            "text": "いやいやいや、",
            "zh": "不不不，",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "497/TALK",
            "narrator": "アーヤの新司書",
            "text": "そもそも前提として\n契約主が管理庁だって\n思い込むのはどうかと。",
            "zh": "首先作为前提，\n擅自认定契约主就是管理厅，\n这想法未免太武断了吧。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "498/TALK",
            "narrator": "アーヤの新司書",
            "text": "仮に本当にそうだったと\nしても、私自身の想いも\n同じだもの。",
            "zh": "就算退一步讲真是那样，\n我自己的想法\n也是一样的。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "499/TALK",
            "narrator": "アーヤの新司書",
            "text": "可能な限り、卯月を信じ\nたいし、無駄に危害を\n与えたくはないの。",
            "zh": "只要还有一丝可能，\n我都想相信卯月，\n不想白白伤害她。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "500/TALK",
            "narrator": "アーヤの新司書",
            "text": "だから、自己判断でも\n結論は変わらないわ。",
            "zh": "所以，就算凭我自己的判断，\n结论也不会改变哦。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "501/TALK",
            "narrator": "アーヤの新司書",
            "text": "そういう陰謀論みたいなの\nここではやめて\nくれないかしら？",
            "zh": "这种阴谋论一样的话，\n能请你在这里\n打住吗？",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "502/SEL",
            "narrator": "",
            "text": "何でもかんでも陰謀論で片付けると身を滅ぼすよ",
            "zh": "动不动就把所有事都当成阴谋论打发掉可是会自取灭亡的哦",
            "narrator_zh": ""
        },
        {
            "location": "503/SEL",
            "narrator": "",
            "text": "本当に知らないね？\n本当だね？",
            "zh": "你真的不知道吗？\n说真的？",
            "narrator_zh": ""
        },
        {
            "location": "504/ACT",
            "narrator": "",
            "text": "何でもかんでも陰謀論で片付けると身を滅ぼすよ",
            "zh": "动不动就把所有事都当成阴谋论打发掉可是会自取灭亡的哦",
            "narrator_zh": ""
        },
        {
            "location": "505/TALK",
            "narrator": "アーヤの新司書",
            "text": "はいはい。\n肝に免じておくわね。",
            "zh": "好好好。\n我会铭记于心的。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "506/TALK",
            "narrator": "アーヤの新司書",
            "text": "それじゃ、\nそろそろ行くわよ。",
            "zh": "那么，\n差不多该开始了。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "507/ACT",
            "narrator": "",
            "text": "本当に知らないね？\n本当だね？",
            "zh": "你真的不知道吗？\n说真的？",
            "narrator_zh": ""
        },
        {
            "location": "508/TALK",
            "narrator": "アーヤの新司書",
            "text": "しつこいわね。\nどうして私がそこまで\n疑われないといけないの。",
            "zh": "真够执着的呢。\n为什么我非得被你\n怀疑到这种地步不可。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "509/SEL",
            "narrator": "",
            "text": "1xは嘘をつくらしいから",
            "zh": "因为听说1x会说谎",
            "narrator_zh": ""
        },
        {
            "location": "510/ACT",
            "narrator": "",
            "text": "1xは嘘をつくらしいから",
            "zh": "因为听说1x会说谎",
            "narrator_zh": ""
        },
        {
            "location": "512/TALK",
            "narrator": "アーヤの新司書",
            "text": "すぐそうやって\n話を逆手に取る。",
            "zh": "动不动就拿别人说过的话\n来反将一军。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "513/TALK",
            "narrator": "アーヤの新司書",
            "text": "嘘をつかない存在なんて、\n人間でも人格でもいない\nって話をしたのよ。",
            "zh": "我当时只是说\n这世上无论人类还是人格，\n没有不说谎的存在而已。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "514/TALK",
            "narrator": "アーヤの新司書",
            "text": "そんなこと言われるなら\n貴方の言う事も一切\n信用できないわね。",
            "zh": "既然你都这么说了，\n那你所说的话\n我也一概无法信任了呢。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "516/TALK",
            "narrator": "アーヤの新司書",
            "text": "まあいいわ。\nそんなこと言ってても\n何も解決しないし。",
            "zh": "算了，无所谓。\n再怎么扯这些\n也解决不了任何问题。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "517/TALK",
            "narrator": "アーヤの新司書",
            "text": "貴方が今一番やらなくちゃ\nならないことは、クランを\n倒すこと。",
            "zh": "你现在最该做的事，\n就是去打倒\n库兰。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "518/TALK",
            "narrator": "アーヤの新司書",
            "text": "契約主から送られてくる\n解決方法の指示通りにね。",
            "zh": "乖乖照着契约主送来的\n解决方法的指示去做。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "519/SEL",
            "narrator": "",
            "text": "はいはい",
            "zh": "好好好",
            "narrator_zh": ""
        },
        {
            "location": "520/SEL",
            "narrator": "",
            "text": "拒否します",
            "zh": "我拒绝",
            "narrator_zh": ""
        },
        {
            "location": "521/ACT",
            "narrator": "",
            "text": "はいはい",
            "zh": "好好好",
            "narrator_zh": ""
        },
        {
            "location": "522/TALK",
            "narrator": "アーヤの新司書",
            "text": "返事は１回。",
            "zh": "回答说一次就行。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "523/TALK",
            "narrator": "アーヤの新司書",
            "text": "それじゃ、行くわよ。",
            "zh": "那么，开始吧。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "524/ACT",
            "narrator": "",
            "text": "拒否します",
            "zh": "我拒绝",
            "narrator_zh": ""
        },
        {
            "location": "525/TALK",
            "narrator": "アーヤの新司書",
            "text": "あら、そうですか。",
            "zh": "哎呀，是吗。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "526/TALK",
            "narrator": "アーヤの新司書",
            "text": "それならそれで\n仕方ないわね。\n強制はできないし。",
            "zh": "那既然这样\n也没办法呢。\n毕竟我也没法强迫你。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "527/TALK",
            "narrator": "アーヤの新司書",
            "text": "それに貴方が拒否しても、\n貴方以外の沢山の存在が\nやってくれる。",
            "zh": "而且就算你拒绝，\n除了你之外还有无数存在\n会替你去做的。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "528/TALK",
            "narrator": "アーヤの新司書",
            "text": "多少精度が落ちるけど、\n大勢に影響はないわ。",
            "zh": "虽说精度会稍微下降一点，\n但对大局没有任何影响。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "529/TALK",
            "narrator": "アーヤの新司書",
            "text": "それが人間社会。",
            "zh": "这就是所谓的人类社会。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "530/TALK",
            "narrator": "アーヤの新司書",
            "text": "個人でできる事なんて\nたかが知れてる。",
            "zh": "单靠个人能做到的事\n微不足道。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "531/TALK",
            "narrator": "アーヤの新司書",
            "text": "殆どの人たちは、\n何も考えずに情報を\n鵜呑みにしてしまう。",
            "zh": "绝大多数人，\n都会不加思考地\n全盘接受情报。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "532/TALK",
            "narrator": "アーヤの新司書",
            "text": "だからいつだって真実とは\n関係なしに、異変を訴えた\n方が残酷な目に遭う。",
            "zh": "所以无论何时，无关真相如何，\n出来诉说异样的人\n反而会落得凄惨的下场。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "533/TALK",
            "narrator": "アーヤの新司書",
            "text": "本心を言えば、\n$handle$さんには\nそうなって欲しくない。",
            "zh": "说句真心话，\n我并不希望$handle$\n落到那种地步。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "534/TALK",
            "narrator": "アーヤの新司書",
            "text": "だから、何も考えず\n情報に従って\nクランを倒して欲しいの。",
            "zh": "所以，我希望你什么都别想，\n照着情报去把\n库兰打倒。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "535/SEL",
            "narrator": "",
            "text": "長いものには巻かれなさいってこと？",
            "zh": "意思是让我胳膊拧不过大腿乖乖听话咯？",
            "narrator_zh": ""
        },
        {
            "location": "536/ACT",
            "narrator": "",
            "text": "長いものには巻かれなさいってこと？",
            "zh": "意思是让我胳膊拧不过大腿乖乖听话咯？",
            "narrator_zh": ""
        },
        {
            "location": "538/TALK",
            "narrator": "アーヤの新司書",
            "text": "まあ、\n誤解を恐れずに言うなら、\nそういうことね。",
            "zh": "嘛，\n如果不怕被误解的话，\n确实就是这么回事。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "539/TALK",
            "narrator": "アーヤの新司書",
            "text": "もう貴方は、\n私にとって\n大切な人だから。",
            "zh": "因为你\n已经是我\n非常重要的人了。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "540/TALK",
            "narrator": "アーヤの新司書",
            "text": "無駄な反抗をして、\n辛い目に遭って\n欲しくないのよ。",
            "zh": "我不想看到你做无谓的反抗，\n结果让自己\n吃苦头啊。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "541/TALK",
            "narrator": "アーヤの新司書",
            "text": "でも、最終的に\n決めるのは貴方だから。",
            "zh": "不过，最终做决定的\n还是你自己。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "542/TALK",
            "narrator": "アーヤの新司書",
            "text": "一応、扉は\n開けておくわね。",
            "zh": "姑且，门我还是\n给你开着哦。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "546/TALK",
            "narrator": "アーヤの新司書",
            "text": "$handle$と\n國政綾水にとって、\n素敵なココロの旅を。",
            "zh": "$handle$与\n国政绫水，\n祝你们有一段美妙的心灵之旅。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "39/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月30日　 2:20 PM</color>\n合宿終了の日、帰りの電車内でのこと",
