{
    "dir": "chap00/daydra/spev_notice_cd_01_02.js",
    "type": "",
    "info": {
        "story_id": "91052",
        "cid": "",
        "title": "002 アフターストーリー",
        "sub_title": "ホワイエにカップ１つ",
        "title_zh": "002 后日谈",
        "sub_title_zh": "门厅里的一只杯子"
    },
    "entry": [
        {
            "location": "471/DIALOG",
            "narrator": "",
            "text": "<color=green>某月某日　3:12 PM</color>\nとある休日、神楽坂トライナリー楽屋にて。",
            "zh": "<color=green>某月某日　3:12 PM</color>\n某休息日，在神乐坂三重奏的后台。",
            "narrator_zh": ""
        },
        {
            "location": "472/TALK",
            "narrator": "アーヤ",
            "text": "――まあ、必要な分担は\nこんなところかしら？",
            "zh": "——嗯，需要分担的岗位\n大概就是这些了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "473/TALK",
            "narrator": "つばめ",
            "text": "えっと、料理準備担当、\n飲み物担当、接客担当――",
            "zh": "那个，餐点准备担当、\n饮品担当、接待担当——",
            "narrator_zh": "燕"
        },
        {
            "location": "474/TALK",
            "narrator": "つばめ",
            "text": "それにインテリア担当と、\nイベント担当？",
            "zh": "还有装潢担当和\n活动担当对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "476/TALK",
            "narrator": "アーヤ",
            "text": "せっかく劇場でカフェを\nやるんだもの。",
            "zh": "难得要在剧场里\n开一家咖啡馆嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "478/TALK",
            "narrator": "アーヤ",
            "text": "他ではできないような\nイベントを開催しないと\n勿体ないでしょ？",
            "zh": "不办点别的地方办不到的\n特别活动，\n岂不是太浪费了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "480/TALK",
            "narrator": "つばめ",
            "text": "なるほどー。",
            "zh": "原来如此——。",
            "narrator_zh": "燕"
        },
        {
            "location": "482/TALK",
            "narrator": "ガブリエラ",
            "text": "質問なんだけど、\n料理と飲み物って\n一緒じゃダメなの？",
            "zh": "问个问题哦，\n餐点和饮品\n合在一起不行吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "484/TALK",
            "narrator": "アーヤ",
            "text": "カフェである以上は\n飲み物にも凝りたいわ。",
            "zh": "既然要开咖啡馆，\n饮品方面我也想讲究一下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "485/TALK",
            "narrator": "アーヤ",
            "text": "紅茶の種類はもちろん\nだけど、コーヒーも\nラテとかやりたいし。",
            "zh": "红茶的种类自不用说，\n咖啡我也想做拿铁\n之类的呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "487/TALK",
            "narrator": "神楽",
            "text": "ラテアートとかですか？",
            "zh": "比方说咖啡拉花之类的吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "488/TALK",
            "narrator": "アーヤ",
            "text": "あ、それいいわね！",
            "zh": "啊，那个主意不错哦！",
            "narrator_zh": "绫水"
        },
        {
            "location": "490/TALK",
            "narrator": "つばめ",
            "text": "えっ、アーヤさん\nできるんですか！？",
            "zh": "咦，绫水\n你会弄这个吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "492/TALK",
            "narrator": "アーヤ",
            "text": "の、飲んだことはあるん\nだけれど、自分で描くのは\nちょっと…。",
            "zh": "喝、喝倒是喝过，\n可要我自己画的话\n就有点……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "494/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、この中だと\nもう確実に決まりっちゅう\nのがあるな。",
            "zh": "话说回来，这几个里头\n有一个差不多已经\n铁定敲定了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "497/TALK",
            "narrator": "ガブリエラ",
            "text": "どれのこと？",
            "zh": "你说哪个？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "499/TALK",
            "narrator": "みやび",
            "text": "イベント担当や。",
            "zh": "活动担当咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "500/TALK",
            "narrator": "みやび",
            "text": "これはもう卯月しか\nおらんやろうね。",
            "zh": "这除了卯月\n肯定没别人咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "502/TALK",
            "narrator": "神楽",
            "text": "…え？",
            "zh": "……哎？",
            "narrator_zh": "神乐"
        },
        {
            "location": "504/TALK",
            "narrator": "つばめ",
            "text": "あ、なるほど！\nイベントなら神楽ちゃんが\n一番詳しいですよね！",
            "zh": "啊，说得也是！\n说到活动的话，肯定还是\n神乐最了解啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "506/TALK",
            "narrator": "みやび",
            "text": "そういうことや。\nちゅーわけやき、\n頼むぞね。",
            "zh": "就是这么回事。\n所以呀，\n就拜托你咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "508/TALK",
            "narrator": "神楽",
            "text": "えぇーっ！？\nそんなの無理ですよ！",
            "zh": "哎哎——！？\n这种事我办不到啦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "510/TALK",
            "narrator": "アーヤ",
            "text": "あら？　でも自分でも\nイベントの企画したこと\nあるんでしょ？",
            "zh": "哦？　可你以前自己\n不也策划过活动\n吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "513/TALK",
            "narrator": "つばめ",
            "text": "はい！　その時の\nイベント、ＤＶＤで\n見ましたけど…。",
            "zh": "嗯！　那次的活动\n我在DVD里\n看过了……",
            "narrator_zh": "燕"
        },
        {
            "location": "514/TALK",
            "narrator": "つばめ",
            "text": "とってもスゴかったです！",
            "zh": "真是超级厉害呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "516/TALK",
            "narrator": "神楽",
            "text": "で、でも、カフェの\nイベントとは違うから…。",
            "zh": "可、可是，那跟咖啡馆\n办的活动不一样呀……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "518/TALK",
            "narrator": "ガブリエラ",
            "text": "カフェの経営なんて、\nここにいる全員が\n初めてなんだから…。",
            "zh": "经营咖啡馆这种事，\n在场所有人还都是\n头一回经历呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "519/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな理由却下よ。\nはい、イベント担当は\n神楽に決定！",
            "zh": "那种借口驳回。\n好，活动担当就决定\n交给神乐了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "521/TALK",
            "narrator": "神楽",
            "text": "えぇーっ！？",
            "zh": "哎哎——！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "523/TALK",
            "narrator": "みやび",
            "text": "ついでに、この話し合いの\n進行役も任せるぞね。",
            "zh": "顺便，今天这场讨论的\n主持也一并交给你咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "525/TALK",
            "narrator": "神楽",
            "text": "いや、それこそ\nどうして私なんですか！？",
            "zh": "不是，凭什么连这个\n都要交给我啊！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "526/TALK",
            "narrator": "みやび",
            "text": "担当が決まった卯月が\nやった方が、スムーズに\n進むやろ。",
            "zh": "让已经定下分工的卯月\n来主持，推进起来才更\n顺畅嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "528/TALK",
            "narrator": "アーヤ",
            "text": "私もみやびに賛成。\nそういうわけだから、\n進行役はお願いね。",
            "zh": "我也赞成雅的说法。\n既然如此，主持就\n拜托你了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "529/TALK",
            "narrator": "神楽",
            "text": "…ほ、本気ですか？",
            "zh": "……你们、认真的吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "530/TALK",
            "narrator": "アーヤ",
            "text": "本気よ。",
            "zh": "认真的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "531/TALK",
            "narrator": "みやび",
            "text": "マジや。",
            "zh": "认真滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "532/TALK",
            "narrator": "ガブリエラ",
            "text": "頑張んなさい。",
            "zh": "加油干吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "533/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃん、がんばれー！",
            "zh": "神乐，加油呀——！",
            "narrator_zh": "燕"
        },
        {
            "location": "536/TALK",
            "narrator": "神楽",
            "text": "…もう、みなさんちょっと\n強引すぎますよ…。",
            "zh": "……真是的，大家未免也\n太强硬了吧……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "539/TALK",
            "narrator": "神楽",
            "text": "でも、任せたからには、\n進行役の話はちゃんと\n聞いてくださいね。",
            "zh": "不过，既然把重任交给了我，\n那我这个主持说的话，\n大家可要好好听进去哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "540/TALK",
            "narrator": "みやび",
            "text": "あいあい、従うぞね。",
            "zh": "收到收到，听你指挥咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "542/TALK",
            "narrator": "神楽",
            "text": "…じゃあ、まずは\nカフェのメインである、\n飲み物から決めましょう。",
            "zh": "……那么，首先就从\n咖啡馆的重头戏——\n饮品开始定吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "544/TALK",
            "narrator": "ガブリエラ",
            "text": "さっきの話の続きね。\nで、誰かやりたい人は\nいないの？",
            "zh": "接回刚才的话题呢。\n那么，有人想主动\n接手吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "546/TALK",
            "narrator": "神楽",
            "text": "あの、私はこの担当は\nみやびさんが適任かと\n思うんです。",
            "zh": "那个，我觉得这项分工\n由雅来担任再合适不过\n了吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "549/TALK",
            "narrator": "みやび",
            "text": "…うち、コーヒーは\nあんまし飲まんけんど？",
            "zh": "……我平时咖啡\n喝得倒不多，但是？",
            "narrator_zh": "雅"
        },
        {
            "location": "550/TALK",
            "narrator": "神楽",
            "text": "種類によっては\nちょっとだけ手を入れる\n必要がありますけど…。",
            "zh": "根据种类不同，虽然\n可能稍微需要多费点\n手脚……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "551/TALK",
            "narrator": "神楽",
            "text": "基本的にマシンが\n抽出してくれるので、\n大丈夫ですよ。",
            "zh": "但基本上靠咖啡机就能\n萃取出来，\n所以完全没问题的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "553/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃあ、みやびが\n担当する必要って\nないんじゃない？",
            "zh": "那这么说来，岂不是\n没必要非让雅\n来负责了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "554/TALK",
            "narrator": "神楽",
            "text": "いえ…もし本当に\nラテアートをするような\nことになるのであれば…。",
            "zh": "不……如果真的要\n做咖啡拉花之类的\n饮品的话……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "555/TALK",
            "narrator": "神楽",
            "text": "複雑で、手の込んだ\n和食を作れる器用さが\n活きると思うんですよ。",
            "zh": "能做出精致讲究日式料理的\n那份心灵手巧，我觉得\n正好能派上用场哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "559/TALK",
            "narrator": "みやび",
            "text": "ふむ…そう言われると、\nなんとなく挑戦しようっ\nちゅう気持ちになるぞね。",
            "zh": "唔……听你这么一夸，\n莫名还真有点想挑战一下\n的意思了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "561/TALK",
            "narrator": "神楽",
            "text": "それじゃあ…。",
            "zh": "这么说……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "564/TALK",
            "narrator": "みやび",
            "text": "うむ、飲み物担当\n引き受けたぞね。",
            "zh": "嗯，饮品担当\n我接下咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "566/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、みやびは\n料理担当の方が\nいいんじゃないかしら？",
            "zh": "不过，雅去当\n餐点担当不是\n更好吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "568/TALK",
            "narrator": "神楽",
            "text": "いえ、料理担当は\nアーヤさんに\nお願いしたいと思います。",
            "zh": "不，餐点担当我想\n拜托绫水来\n负责。",
            "narrator_zh": "神乐"
        },
        {
            "location": "570/TALK",
            "narrator": "アーヤ",
            "text": "わ、私？",
            "zh": "我、我吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "572/TALK",
            "narrator": "神楽",
            "text": "アーヤさん、カフェの\nメニューにはとっても\n詳しいですよね？",
            "zh": "绫水不是对咖啡馆的\n餐点菜单非常\n熟悉吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "573/TALK",
            "narrator": "神楽",
            "text": "趣味で色んなカフェに\n行ってますし。",
            "zh": "毕竟平时爱好就是\n去逛各种各样的咖啡馆嘛。",
            "narrator_zh": "神乐"
        },
        {
            "location": "576/TALK",
            "narrator": "アーヤ",
            "text": "そうだけど、\nそれと作るのは\n別だと思うわ。",
            "zh": "话是这么说，\n但吃过和自己做\n完全是两码事吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "578/TALK",
            "narrator": "神楽",
            "text": "難しい料理を出すんじゃ\nありません。",
            "zh": "又不是要端出多难做的\n高级菜肴。",
            "narrator_zh": "神乐"
        },
        {
            "location": "579/TALK",
            "narrator": "神楽",
            "text": "アーヤさんだけでなく、\n私たちの誰でも簡単に\n作れるような…。",
            "zh": "只要不止绫水，\n连我们当中谁来动手\n都能轻松做出来……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "580/TALK",
            "narrator": "神楽",
            "text": "そんなお手軽メニューを\n考えてほしいんです。",
            "zh": "希望你帮忙构思的，\n就是那样的简捷菜单呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "582/TALK",
            "narrator": "つばめ",
            "text": "そっか…わたし達全員が\n作れるようなのじゃないと\nダメなんだよね？",
            "zh": "原来如此……如果不是我们\n所有人都能做的菜式，\n确实不行对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "584/TALK",
            "narrator": "神楽",
            "text": "はい。実際に開店したら、\n一人で厨房を任せるなんて\nまず不可能ですから。",
            "zh": "是的。真到开店之后，\n把厨房丢给一个人扛\n基本是不可能的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "585/TALK",
            "narrator": "神楽",
            "text": "もちろん、みやびさんの\n飲み物に関しても\nそれは同じですけど。",
            "zh": "当然了，雅那边的\n饮品制作也是一样的\n道理。",
            "narrator_zh": "神乐"
        },
        {
            "location": "587/TALK",
            "narrator": "アーヤ",
            "text": "なるほどね。\n簡単で美味しいのだと\nすると、うーん…。",
            "zh": "原来如此。\n要既简单又好吃的话，\n嗯……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "589/TALK",
            "narrator": "アーヤ",
            "text": "…わかったわ。\n一度、試作メニューを\n作ってみる。",
            "zh": "……我知道了。\n我先试着做一份\n试作菜单看看。",
            "narrator_zh": "绫水"
        },
        {
            "location": "592/TALK",
            "narrator": "神楽",
            "text": "それじゃあ、料理担当は\nこれで決まりですね。",
            "zh": "好，那么餐点担当\n就这样敲定了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "594/TALK",
            "narrator": "つばめ",
            "text": "す、すごいね。\nもう二つ決まっちゃった。",
            "zh": "好、好厉害呀。\n转眼就定下两个了。",
            "narrator_zh": "燕"
        },
        {
            "location": "596/TALK",
            "narrator": "神楽",
            "text": "三つ目はインテリア担当\nですけど、これは…。",
            "zh": "第三个是装潢担当，\n这一项的话……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "598/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、それあたしが\nやってみたいんだけど。",
            "zh": "啊，这个我想\n试着做做看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "600/TALK",
            "narrator": "つばめ",
            "text": "え？　どうして？",
            "zh": "咦？　为什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "602/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、インテリアを\nこだわってみたいな、\nって思ってるの。",
            "zh": "因为我一直想\n在室内装潢上好好\n讲究一番嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "604/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、つばめが\nイヤじゃなければ…。",
            "zh": "所以，如果燕你不讨厌\n的话……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "605/TALK",
            "narrator": "ガブリエラ",
            "text": "接客担当をつばめに\nやってもらいたいん\nだけど…。",
            "zh": "我希望接待担当\n能由燕来\n负责……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "607/TALK",
            "narrator": "つばめ",
            "text": "全然イヤじゃないよ！",
            "zh": "我完全不讨厌呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "608/TALK",
            "narrator": "つばめ",
            "text": "自分じゃ決められなかった\nから、そう言ってもらえて\n助かっちゃった。",
            "zh": "我本来自己都下不定\n主意，你这么帮我选好\n反而帮大忙啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "610/TALK",
            "narrator": "アーヤ",
            "text": "ってことは…、\nとりあえず役割分担は\nコレで決まりね。",
            "zh": "也就是说……，\n总之角色分工\n就这样定下来了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "612/TALK",
            "narrator": "みやび",
            "text": "随分トントン拍子に\n進みゆうなぁ。",
            "zh": "推进得还真是\n顺风顺水咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "613/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんスゴいよ。\nあっという間に色んなこと\n決めちゃうなんて。",
            "zh": "神乐好厉害呀。\n三两下就把这么多事\n全敲定了。",
            "narrator_zh": "燕"
        },
        {
            "location": "615/TALK",
            "narrator": "神楽",
            "text": "皆さんの得意なモノを\n知っていたおかげですよ。",
            "zh": "这都是多亏了我清楚\n各位各自擅长什么呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "616/TALK",
            "narrator": "神楽",
            "text": "…そういえば、\n皆さんロゴの方は\n完成したんですか？",
            "zh": "……说起来，\n大家的标志都已经\n画好了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "618/TALK",
            "narrator": "つばめ",
            "text": "い、一応…。\n神楽ちゃんは？",
            "zh": "算、算是吧……。\n神乐呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "619/TALK",
            "narrator": "神楽",
            "text": "じゃあ、まずは私から\nお見せしますね。",
            "zh": "那，首先就由我来\n展示一下吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "626/TALK",
            "narrator": "神楽",
            "text": "これなんですけど、\nどうでしょうか？",
            "zh": "就是这个，\n大家觉得怎么样？",
            "narrator_zh": "神乐"
        },
        {
            "location": "629/TALK",
            "narrator": "アーヤ",
            "text": "えぇっ！？",
            "zh": "哎哎！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "631/TALK",
            "narrator": "神楽",
            "text": "あっ…もしかして、\n変でしたか？",
            "zh": "啊……难道说，\n看起来很奇怪吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "634/TALK",
            "narrator": "アーヤ",
            "text": "あ、ううん。\nそうじゃないの。",
            "zh": "啊，不是的。\n不是那个意思。",
            "narrator_zh": "绫水"
        },
        {
            "location": "635/TALK",
            "narrator": "アーヤ",
            "text": "まさか、卯月も色を\n付けてくるとは\n思わなくて…。",
            "zh": "我只是没想到，\n连卯月你也会给它\n加上颜色……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "640/TALK",
            "narrator": "アーヤ",
            "text": "コレが私のよ。",
            "zh": "这就是我的作品哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "642/TALK",
            "narrator": "神楽",
            "text": "アーヤさんも\nロゴに色を付けたん\nですか？",
            "zh": "绫水你也\n给标志涂上\n颜色了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "644/TALK",
            "narrator": "アーヤ",
            "text": "真ん中のロゴ描いたら、\n色を入れた方が\n栄えると思って…。",
            "zh": "画好正中间的标志后，\n总觉得涂上颜色会\n更出彩……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "648/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤが風車で、\n神楽が銀杏…。",
            "zh": "绫水画的是风车，\n神乐是银杏……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "650/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱり、みんな\n和風な感じにしたのね。",
            "zh": "……果然，大家都\n做成了日式风呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "652/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、ギャヴィも？",
            "zh": "这么说，加维也是？",
            "narrator_zh": "绫水"
        },
        {
            "location": "654/TALK",
            "narrator": "ガブリエラ",
            "text": "まあね。\nあたしのは、ほら…。",
            "zh": "算吧。\n我画的嘛，你看……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "659/TALK",
            "narrator": "つばめ",
            "text": "あっ、鶴だ！",
            "zh": "啊，是鹤！",
            "narrator_zh": "燕"
        },
        {
            "location": "661/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふん、どう？\n風流な感じがすると\n思わない？",
            "zh": "哼哼，怎么样？\n是不是很有\n风雅的感觉？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "663/TALK",
            "narrator": "つばめ",
            "text": "うん、すっごい感じるよ！\n風流だね！！",
            "zh": "嗯，超级有感觉哦！\n好风雅呀！！",
            "narrator_zh": "燕"
        },
        {
            "location": "665/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん、\n風流がどんなもんか\nわかってないやろ…？",
            "zh": "燕，\n你其实不懂“风雅”\n是驷马东西吧……？",
            "narrator_zh": "雅"
        },
        {
            "location": "668/TALK",
            "narrator": "神楽",
            "text": "そういえば、みやびさんは\nこの前描いたのが\n完成形ですか？",
            "zh": "说起来，雅你\n之前画的那一版\n就是最终稿了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "670/TALK",
            "narrator": "みやび",
            "text": "…いや、さすがにあれじゃ\n寂しすぎる思うてな。",
            "zh": "……不是，后来还是觉得\n原先那样太单调了嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "676/TALK",
            "narrator": "みやび",
            "text": "色を塗ってみたがよ。",
            "zh": "就试着涂了点颜色咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "678/TALK",
            "narrator": "ガブリエラ",
            "text": "うわっ、紫超綺麗！！",
            "zh": "哇，紫色超级好看！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "680/TALK",
            "narrator": "みやび",
            "text": "見ようによっては\n毒沼色やけんどな。",
            "zh": "不过换个角度看，\n也有点像毒沼色咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "682/TALK",
            "narrator": "ガブリエラ",
            "text": "それ、お客さんの前では\n絶対言わないでよ？",
            "zh": "这句话，在客人面前\n可千万别说出口啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "686/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、\n最後はわたしだね。",
            "zh": "那么，\n最后一个就是我啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "691/TALK",
            "narrator": "つばめ",
            "text": "紅葉なんですけど…、\nどうかな？",
            "zh": "我画的是红叶……，\n怎么样呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "693/TALK",
            "narrator": "アーヤ",
            "text": "とっても素敵よ。\n色も紅葉とピッタリだし。",
            "zh": "非常好看哦。\n配色也和红叶很搭。",
            "narrator_zh": "绫水"
        },
        {
            "location": "695/TALK",
            "narrator": "神楽",
            "text": "私もそう思います。\nいいロゴですね。",
            "zh": "我也这么觉得。\n是很棒的标志呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "697/TALK",
            "narrator": "つばめ",
            "text": "えへへ…。",
            "zh": "嘿嘿嘿……。",
            "narrator_zh": "燕"
        },
        {
            "location": "698/TALK",
            "narrator": "つばめ",
            "text": "でも、みんなロゴの色が\n違ってよかったよね。",
            "zh": "不过，大家的标志颜色\n全都错开了真好呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "700/TALK",
            "narrator": "ガブリエラ",
            "text": "それにしても、\nビックリよね。",
            "zh": "话又说回来，\n还真是让人惊讶。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "701/TALK",
            "narrator": "ガブリエラ",
            "text": "打ち合わせしたわけじゃ\nないのに、みんな色が\n被らなかったなんて…。",
            "zh": "明明事先也没商量过，\n大家挑的颜色居然\n一个都没撞上……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "704/TALK",
            "narrator": "アーヤ",
            "text": "好みがバラバラだったのが\n幸いしたわね。",
            "zh": "多亏了大家的喜好\n各不相同呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "707/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、あとは\nこのロゴを食器に\n印刷すれば完成？",
            "zh": "那，接下来只要把\n这些标志印到餐具上\n就大功告成了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "709/TALK",
            "narrator": "神楽",
            "text": "つばめさん。\n重要なことを\n忘れてますよ。",
            "zh": "燕。\n你漏掉了\n一件重要的事哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "710/TALK",
            "narrator": "神楽",
            "text": "誰のロゴを、どの食器に\n印刷するのかを\n決めるのが先です。",
            "zh": "得先决定好要把谁的标志\n印在哪一种餐具上\n才行。",
            "narrator_zh": "神乐"
        },
        {
            "location": "712/TALK",
            "narrator": "つばめ",
            "text": "あ、そっか。",
            "zh": "啊，说得也是。",
            "narrator_zh": "燕"
        },
        {
            "location": "714/TALK",
            "narrator": "みやび",
            "text": "なんや、みんな希望の\n食器があるんかね？",
            "zh": "怎么，大家各自都\n有中意的餐具咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "715/TALK",
            "narrator": "アーヤ",
            "text": "ん～…あるにはあるけど、\nまだ一つに絞り込めて\nないのよね…。",
            "zh": "嗯～……有倒是有，\n不过一时还定不下\n具体选哪一个……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "717/TALK",
            "narrator": "ガブリエラ",
            "text": "食器は今日じゃなくても\nいいんじゃない？",
            "zh": "餐具的事不用今天\n就定下来也行吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "718/TALK",
            "narrator": "ガブリエラ",
            "text": "それぞれの担当を決めて、\nロゴまで作ったんだし。",
            "zh": "毕竟各自的负责项目\n已经分好，连标志也做出来了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "719/TALK",
            "narrator": "ガブリエラ",
            "text": "第一、開店する日だって\nまだ決まってないん\nだから…。",
            "zh": "再说了，开店的日子\n都还没定下来\n呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "720/TALK",
            "narrator": "ガブリエラ",
            "text": "開店に向けての準備を\nしながら決めてけば\nいいと思うけど？",
            "zh": "一边做着开店的准备，\n一边慢慢定下来\n不就好了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "722/TALK",
            "narrator": "みやび",
            "text": "まあ、一日で全部決めても\n面白くないきね。",
            "zh": "嘛，一天之内就把事情\n全拍板定完也没意思啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "723/TALK",
            "narrator": "みやび",
            "text": "それに、いくつか候補が\nある子もおるようやし、\nそれでえいと思うよ。",
            "zh": "而且看样子也有人\n手里捏着好几个备选，\n那样就蛮好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "725/TALK",
            "narrator": "神楽",
            "text": "じゃあ、食器を決めるのは\nまた後日にしましょう。",
            "zh": "那，决定餐具这件事\n就放到改天再议吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "726/TALK",
            "narrator": "神楽",
            "text": "各自、自分の担当箇所の\n準備を進めつつ…。",
            "zh": "大家各自先推进\n自己负责部分的准备……",
            "narrator_zh": "神乐"
        },
        {
            "location": "727/TALK",
            "narrator": "神楽",
            "text": "どの食器にするかを\n決めるということで。",
            "zh": "顺便也考虑好要选\n哪一款餐具。",
            "narrator_zh": "神乐"
        },
        {
            "location": "729/TALK",
            "narrator": "アーヤ",
            "text": "それでいいと思うわ。",
            "zh": "我觉得这样挺好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "731/TALK",
            "narrator": "みやび",
            "text": "ん、文句なしや。",
            "zh": "嗯，没意见咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "732/TALK",
            "narrator": "神楽",
            "text": "では、皆さん。\n担当箇所の準備、\nよろしくお願いしますね。",
            "zh": "那么，各位。\n各自负责的准备工作，\n就拜托大家咯。",
            "narrator_zh": "神乐"
        },
        {
            "location": "734/TALK",
            "narrator": "つばめ",
            "text": "うん、がんばるよ！",
            "zh": "嗯，我会加油的！",
            "narrator_zh": "燕"
        },
        {
            "location": "736/TALK",
            "narrator": "アーヤ",
            "text": "あ、そうだ。\nついでにもう一つ、\nお願いがあるんだけど…。",
            "zh": "啊，对了。\n顺便还有一件事\n想拜托你……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "738/TALK",
            "narrator": "神楽",
            "text": "はい、なんですか？",
            "zh": "好的，什么事？",
            "narrator_zh": "神乐"
        },
        {
            "location": "740/TALK",
            "narrator": "アーヤ",
            "text": "開店までの話なんだけど、\nそれまで全員を仕切る\n役割を――",
            "zh": "其实是在开店之前的这段期间，\n负责统筹大家所有人\n的职务——",
            "narrator_zh": "绫水"
        },
        {
            "location": "755/TALK",
            "narrator": "神楽",
            "text": "ただいま…。",
            "zh": "我回来了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "757/TALK",
            "narrator": "神楽",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "769/TALK",
            "narrator": "神楽",
            "text": "もぅﾏﾁﾞ無理。ﾘｽｶしょ",
            "zh": "真的顶不住了。割腕算了",
            "narrator_zh": "神乐"
        },
        {
            "location": "771/SEL",
            "narrator": "（選択肢）",
            "text": "気にしすぎじゃね？",
            "zh": "是不是想太多了？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "772/SEL",
            "narrator": "（選択肢）",
            "text": "みんなほんとに神楽のこと好きだと思うよ？",
            "zh": "我觉得大家是真的喜欢神乐哦？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "773/SEL",
            "narrator": "（選択肢）",
            "text": "じゃあ、一緒にしょ？",
            "zh": "那，一起去？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "774/ACT",
            "narrator": "",
            "text": "気にしすぎじゃね？",
            "zh": "是不是想太多了？",
            "narrator_zh": ""
        },
        {
            "location": "775/TALK",
            "narrator": "神楽",
            "text": "神視点か",
            "zh": "上帝视角吗",
            "narrator_zh": "神乐"
        },
        {
            "location": "776/TALK",
            "narrator": "神楽",
            "text": "まあ、他人事だとそうなりますよねー",
