    "info": {
        "story_id": "1002",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "父の心配",
        "title_zh": "特别篇",
        "sub_title_zh": "父亲的担心"
    },
    "entry": [
        {
            "location": "25/TALK",
            "narrator": "透明つばめ",
            "text": "あ、はーい！\n今出ますよー。",
            "zh": "啊，来啦！\n我这就出来哦。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "32/TALK",
            "narrator": "透明つばめ",
            "text": "もしもし？",
            "zh": "喂？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "33/TALK",
            "narrator": "透明啓介",
            "text": "…もしもしじゃない\nだろう？",
            "zh": "……这哪是\n接电话的样子？",
            "narrator_zh": "透明启介"
        },
        {
            "location": "35/TALK",
            "narrator": "透明つばめ",
            "text": "お父さん。\nこんな時間に\nどうしたの？",
            "zh": "爸爸。\n这么晚了，\n怎么了？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "36/TALK",
            "narrator": "透明啓介",
            "text": "おまえの方から電話が\n全然来ないから、\n俺の方からかけたんだ。",
            "zh": "你那边电话\n完全不打来，\n我就打过来了。",
            "narrator_zh": "透明启介"
        },
        {
            "location": "37/TALK",
            "narrator": "透明つばめ",
            "text": "いけない！\nまた電話するの\nサボッちゃってた…。",
            "zh": "糟糕！\n又偷懒\n没打电话……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "40/TALK",
            "narrator": "透明つばめ",
            "text": "えと…ごめんね。\nちょっと、ドタバタ\nしちゃってて…。",
            "zh": "那个……对不起。\n有点手忙脚乱的，\n没顾上……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "41/TALK",
            "narrator": "透明啓介",
            "text": "…引っ越し作業が\n大変なのか？",
            "zh": "……是搬家\n太忙了吗？",
            "narrator_zh": "透明启介"
        },
        {
            "location": "42/TALK",
            "narrator": "透明つばめ",
            "text": "ううん、そうじゃ\nなくて…。",
            "zh": "不是，不是\n那样……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "43/TALK",
            "narrator": "透明啓介",
            "text": "なら、学校で\n何かトラブルでも\nあったのか？",
            "zh": "那就是学校里\n出了什么麻烦\n吗？",
            "narrator_zh": "透明启介"
        },
        {
            "location": "45/TALK",
            "narrator": "透明つばめ",
            "text": "そうじゃないよ。\nもぉ、お父さん\n心配し過ぎ！",
            "zh": "不是那样啦。\n真是的，爸爸\n担心过头了！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "47/TALK",
            "narrator": "透明つばめ",
            "text": "つばめは元気で\nやってるから\n平気だよ。",
            "zh": "燕过得好好的，\n所以\n没事的。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "48/TALK",
            "narrator": "透明啓介",
            "text": "…じゃあ、どうして\n電話をしなかった？",
            "zh": "……那为什么\n不打电话？",
            "narrator_zh": "透明启介"
        },
        {
            "location": "51/TALK",
            "narrator": "透明つばめ",
            "text": "えっ！？\nそれは――",
            "zh": "诶！？\n那个——",
            "narrator_zh": "透明燕"
        },
        {
            "location": "52/TALK",
            "narrator": "透明つばめ",
            "text": "クシュンッ！！",
            "zh": "阿嚏！！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "53/TALK",
            "narrator": "透明啓介",
            "text": "どうした、風邪か？",
            "zh": "怎么了，感冒了？",
            "narrator_zh": "透明启介"
        },
        {
            "location": "54/TALK",
            "narrator": "透明つばめ",
            "text": "あ、ううん…。\n何でもないよー。",
            "zh": "啊，不是……\n什么事都没有哦。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "55/TALK",
            "narrator": "透明啓介",
            "text": "そうか…。",
            "zh": "是吗……",
            "narrator_zh": "透明启介"
        },
        {
            "location": "56/TALK",
            "narrator": "透明啓介",
            "text": "それで？\nどうして電話をして\nこなかったんだ？",
            "zh": "所以呢？\n为什么电话\n都不打来？",
            "narrator_zh": "透明启介"
        },
        {
            "location": "57/TALK",
            "narrator": "透明つばめ",
            "text": "え、えっと…。",
            "zh": "那、那个……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "61/TALK",
            "narrator": "透明啓介",
            "text": "――とにかく、\nそういうことだ。",
            "zh": "——总之，\n就是这么回事。",
            "narrator_zh": "透明启介"
        },
        {
            "location": "62/TALK",
            "narrator": "透明啓介",
            "text": "わかったら、\n電話くらいは\n毎日……",
            "zh": "知道了的话，\n电话这种事\n每天……",
            "narrator_zh": "透明启介"
        },
        {
            "location": "63/TALK",
            "narrator": "透明啓介",
            "text": "いや、数日に一度は\nつばめの方から\nかけてきなさい。",
            "zh": "不，隔几天\n也要由燕这边\n打过来。",
            "narrator_zh": "透明启介"
        },
        {
            "location": "65/TALK",
            "narrator": "透明つばめ",
            "text": "はい…。\nごめんなさい…。",
            "zh": "好……\n对不起……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "66/TALK",
            "narrator": "透明啓介",
            "text": "…わかったなら、\nもういい。",
            "zh": "……知道了的话，\n就行了。",
            "narrator_zh": "透明启介"
        },
        {
            "location": "67/TALK",
            "narrator": "透明啓介",
            "text": "明日も学校だろう？\n暖かくして\n早く寝るように。",
            "zh": "明天还有课吧？\n穿暖和点，\n早点睡。",
            "narrator_zh": "透明启介"
        },
        {
            "location": "69/TALK",
            "narrator": "透明つばめ",
            "text": "うん…おやすみ、\nお父さん。",
            "zh": "嗯……晚安，\n爸爸。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "75/TALK",
            "narrator": "透明つばめ",
            "text": "はぁ…。",
            "zh": "唉……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "ぉ父さん",
            "zh": "爸爸",
            "narrator_zh": "燕"
        },
        {
            "location": "80/TALK",
            "narrator": "つばめ",
            "text": "電話長過ぎーヾ(｡>﹏<｡)ﾉﾞ",
            "zh": "电话太长了呀ヾ(｡>﹏<｡)ﾉﾞ",
            "narrator_zh": "燕"
        },
        {
            "location": "81/TALK",
            "narrator": "つばめ",
            "text": "身体冷ぇちゃった(o´Д`)=з",
            "zh": "身体都凉了(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "82/SEL",
            "narrator": "（選択肢）",
            "text": "どんな話だったの？",
