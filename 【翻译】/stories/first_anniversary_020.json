{
    "dir": "chap00/daydra/first_anniversary_020.js",
    "type": "",
    "info": {
        "story_id": "11802",
        "cid": "",
        "title": "祝・１周年記念",
        "sub_title": "祝・１周年記念＜第２話＞",
        "title_zh": "祝・1周年纪念",
        "sub_title_zh": "祝・1周年纪念＜第2话＞"
    },
    "entry": [
        {
            "location": "245/TALK",
            "narrator": "みやび",
            "text": "はー。\nそんなことが\nあったんかね。",
            "zh": "哈——。\n居然还有\n这种事咩。",
            "narrator_zh": "雅"
        },
        {
            "location": "246/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなのよ。\n本当につばめは！",
            "zh": "就是说啊。\n燕她真是的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/TALK",
            "narrator": "アーヤ",
            "text": "まあまあ。\n天真爛漫なのよ\nあの子は。",
            "zh": "好了好了。\n那孩子呀\n就是天真烂漫。",
            "narrator_zh": "绫水"
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと！\nアーヤだって\n反対派だったでしょ！",
            "zh": "等一下！\n绫水你不也\n是反对派嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "250/TALK",
            "narrator": "アーヤ",
            "text": "それは、まあ……。",
            "zh": "那，算是吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "251/TALK",
            "narrator": "みやび",
            "text": "けんど、あれよね。\n確かにうちら\n世話になっちゅうき。",
            "zh": "但是，是这样咯。\n确实我们\n都受着照顾啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "$handle$と\n来たいちう気持ちは\nわからんでもない。",
            "zh": "想和$handle$一起来\n的心情，\n也不是没懂。",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、多少はね？",
            "zh": "……嘛，多少有啦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "記念日っぽい\n雰囲気にも\nなりそうだし。",
            "zh": "而且感觉\n也会有\n纪念日的气氛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "258/TALK",
            "narrator": "ガブリエラ",
            "text": "思い出も\n作りたいし。",
            "zh": "也想\n留点回忆嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "260/TALK",
            "narrator": "ガブリエラ",
            "text": "楽しそうだし。",
            "zh": "感觉会很好玩嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "265/TALK",
            "narrator": "アーヤ",
            "text": "わかるわよ私も。",
            "zh": "我也懂的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんは\n大事な人だし。",
            "zh": "$handle$是\n很重要的人嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "269/TALK",
            "narrator": "アーヤ",
            "text": "あんまり隠し事も\nしたくないし。",
            "zh": "太多的事情\n也不想瞒嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "271/TALK",
            "narrator": "アーヤ",
            "text": "せっかく遠くに\n行くんだし。",
            "zh": "难得去一趟\n远方嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "276/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうみやびは\nどうなのよ？",
            "zh": "那雅你\n又怎么想？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "278/TALK",
            "narrator": "みやび",
            "text": "行ってもえいかと\n思うとる。",
            "zh": "去了也好\n我是这么想滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "280/TALK",
            "narrator": "みやび",
            "text": "相棒とは\n離れられん\n間柄やき。",
            "zh": "和搭档\n已经是分不开的\n关系啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "282/TALK",
            "narrator": "みやび",
            "text": "おらんと少し\n寂しいし。",
            "zh": "不在的话\n有点寂寞嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "284/TALK",
            "narrator": "みやび",
            "text": "洒落もわかるし。",
            "zh": "玩笑也接得住嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "289/TALK",
            "narrator": "みやび",
            "text": "って感じかねえ。",
            "zh": "大概就是这样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "307/TALK",
            "narrator": "つばめ",
            "text": "いいところだね\n秩父。",
            "zh": "秩父真是\n个好地方呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "308/TALK",
            "narrator": "神楽",
            "text": "そうですか？",
            "zh": "是这样吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "309/TALK",
            "narrator": "神楽",
            "text": "激しくオススメした\n甲斐がありました。",
            "zh": "这么卖力地推荐\n总算没白费。",
            "narrator_zh": "神乐"
        },
        {
            "location": "310/TALK",
            "narrator": "つばめ",
            "text": "……ふう。",
            "zh": "……呼。",
            "narrator_zh": "燕"
        },
        {
            "location": "311/TALK",
            "narrator": "神楽",
            "text": "何ですか？",
            "zh": "怎么了？",
            "narrator_zh": "神乐"
        },
        {
            "location": "312/TALK",
            "narrator": "つばめ",
            "text": "ううん。\n$handle$さんと\n来たかったなって。",
            "zh": "没事。\n就是想\n和$handle$一起来嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "313/TALK",
            "narrator": "つばめ",
            "text": "あっ！\n神楽ちゃんと来れて\nうれしいんだよ！？",
            "zh": "啊！\n能和神乐一起来\n我也很开心哦！？",
            "narrator_zh": "燕"
        },
        {
            "location": "314/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんにガブちゃん\nみやびさんもいるし。",
            "zh": "绫水呀加布\n还有雅也都在嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "316/TALK",
            "narrator": "神楽",
            "text": "そんな気を使わなくて\n大丈夫ですよ。",
            "zh": "不用这么费心\n没关系的哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "317/TALK",
            "narrator": "神楽",
            "text": "…でもちょっと\n聞きたいですね。",
            "zh": "……不过\n我确实有点想听。",
            "narrator_zh": "神乐"
        },
        {
            "location": "318/TALK",
            "narrator": "神楽",
            "text": "つばめさんにとって\n$handle$さんが\nどんな存在なのか。",
            "zh": "对燕来说\n$handle$是\n什么样的存在。",
            "narrator_zh": "神乐"
        },
        {
            "location": "320/TALK",
            "narrator": "つばめ",
            "text": "…うーん…。",
            "zh": "…唔…。",
            "narrator_zh": "燕"
        },
        {
            "location": "322/TALK",
            "narrator": "つばめ",
            "text": "すっごくすっごく\n大事な人！",
            "zh": "超级超级\n重要的人！",
            "narrator_zh": "燕"
        },
        {
            "location": "324/TALK",
            "narrator": "つばめ",
            "text": "色々おしゃべりできる\n恋人？",
            "zh": "什么都能聊的\n恋人？",
            "narrator_zh": "燕"
        },
        {
            "location": "326/TALK",
            "narrator": "つばめ",
            "text": "不思議なお友達？",
            "zh": "不可思议的好朋友？",
            "narrator_zh": "燕"
        },
        {
            "location": "328/TALK",
            "narrator": "つばめ",
            "text": "不思議なお友達？",
            "zh": "不可思议的好朋友？",
            "narrator_zh": "燕"
        },
        {
            "location": "332/TALK",
            "narrator": "つばめ",
            "text": "って感じかなあ。",
            "zh": "大概就这种感觉吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "333/TALK",
            "narrator": "神楽",
            "text": "…そうなんですね。",
            "zh": "……是这样啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "334/TALK",
            "narrator": "つばめ",
            "text": "あっ！",
            "zh": "啊！",
            "narrator_zh": "燕"
        },
        {
            "location": "335/TALK",
            "narrator": "つばめ",
            "text": "忘れ物してた！\n先に行ってて！",
            "zh": "我落了东西！\n你们先过去！",
            "narrator_zh": "燕"
        },
        {
            "location": "376/TALK",
            "narrator": "神楽",
            "text": "みなさんもう\n入ってたんですね。",
            "zh": "大家已经\n都进去了呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "378/TALK",
            "narrator": "みやび",
            "text": "おお、ちょうど\nええところに。",
            "zh": "哦哦，来得\n正是时候啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "379/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\n卯月の意見も\n聞きたいわ。",
            "zh": "是啊。\n也想听听\n卯月的意见。",
            "narrator_zh": "绫水"
        },
        {
            "location": "380/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ。\n$handle$のこと\nどう思ってる？",
            "zh": "呐。\n你对$handle$\n是怎么想的？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "381/TALK",
            "narrator": "神楽",
            "text": "私がですか？",
            "zh": "是问我吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "383/TALK",
            "narrator": "神楽",
            "text": "いるだけで心が\n温かくなる人です。",
            "zh": "光是待在身边\n心里就变暖的人。",
            "narrator_zh": "神乐"
        },
        {
            "location": "385/TALK",
            "narrator": "神楽",
            "text": "いないと寂しくて\n仕方ない人…ですね。",
            "zh": "不在就寂寞得\n受不了的人…吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "387/TALK",
            "narrator": "神楽",
            "text": "話しやすい面白い人…\nですかね。",
            "zh": "聊得来的有趣的人…\n大概吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "389/TALK",
            "narrator": "神楽",
            "text": "暇な時にお話とか\nしてくれる人…\nですかね。",
            "zh": "有空时会陪我\n聊聊天的人…\n大概吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "392/TALK",
            "narrator": "神楽",
            "text": "でも偶然ですね。\nさっきつばめさんとも\nそんな話をしてたんです。",
            "zh": "不过真巧。\n刚才和燕\n也聊到这个话题呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "393/TALK",
            "narrator": "みやび",
            "text": "それは、あれよ。",
            "zh": "那个，是这么回事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "なんだかんだで\n全員$handle$の\n世話になっちゅうき。",
            "zh": "说来说去\n大家都在\n受$handle$照顾啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "397/TALK",
            "narrator": "アーヤ",
            "text": "そうよね。",
            "zh": "是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "398/TALK",
            "narrator": "アーヤ",
            "text": "お礼とかしてみる？\nちょっと改まって。",
            "zh": "要不要道个谢？\n稍微正式一点。",
            "narrator_zh": "绫水"
        },
        {
            "location": "399/TALK",
            "narrator": "ガブリエラ",
            "text": "たまにはいいかも。",
            "zh": "偶尔来一次也许不错。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "400/TALK",
            "narrator": "神楽",
            "text": "じゃあ私がみんなの\nイラストを\n描きましょうか。",
            "zh": "那不如由我\n给大家\n画幅插画吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "401/TALK",
            "narrator": "神楽",
            "text": "それにメッセージを\nつけてプレゼント。",
            "zh": "再配上留言\n当作礼物。",
            "narrator_zh": "神乐"
        },
        {
            "location": "402/TALK",
            "narrator": "みやび",
            "text": "えいねえ。",
            "zh": "蛮好滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "404/TALK",
            "narrator": "アーヤ",
            "text": "世界に一つだけの\nプレゼントに\nなるわね。",
            "zh": "这会是\n世界上仅此一份的\n礼物了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "406/TALK",
            "narrator": "ガブリエラ",
            "text": "かわいく描いてよね！",
            "zh": "要画得可爱一点哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "407/TALK",
            "narrator": "神楽",
            "text": "もちろんです！",
            "zh": "当然！",
            "narrator_zh": "神乐"
        },
        {
            "location": "409/TALK",
            "narrator": "神楽",
            "text": "しかもお色気も\n盛り込みますよー。",
            "zh": "而且还要\n加点性感进去哦——。",
            "narrator_zh": "神乐"
        },
        {
            "location": "412/TALK",
            "narrator": "ガブリエラ",
            "text": "は？",
            "zh": "哈？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "413/TALK",
            "narrator": "神楽",
            "text": "全員で温泉。\n当然ですよね。",
            "zh": "全员一起泡温泉。\n这是当然的吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "415/TALK",
            "narrator": "みやび",
            "text": "いや、それはちょっと…。",
            "zh": "不，那个有点…。",
            "narrator_zh": "雅"
        },
        {
            "location": "417/TALK",
            "narrator": "アーヤ",
            "text": "ダメよそんなの！\nありえない！",
            "zh": "那样不行！\n不可能的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "419/TALK",
            "narrator": "ガブリエラ",
            "text": "無理無理無理無理！\n絶対阻止！",
            "zh": "不行不行不行不行！\n绝对阻止！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "423/DIALOG",
            "narrator": "",
            "text": "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n　　　　　　To be continued !",
            "zh": "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n　　　　　　To be continued !",
            "narrator_zh": ""
        }
    ]
}
