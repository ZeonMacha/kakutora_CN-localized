{
    "dir": "chap22/daydra/dd_ch02_22_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "22256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "古いバス停",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "老旧的公交站"
    },
    "entry": [
        {
            "location": "487/SCENARIO",
            "narrator": "",
            "text": "古いバス停",
            "zh": "老旧的公交站",
            "narrator_zh": ""
        },
        {
            "location": "514/TALK",
            "narrator": "透明神楽",
            "text": "どうですか？\n雨宿りできそうな\nところ、ありましたか？",
            "zh": "怎么样？\n有找到能躲雨的\n地方吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "517/TALK",
            "narrator": "透明つばめ",
            "text": "ダメ、何もないよ…。",
            "zh": "不行，什么都没有呀……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "519/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ああもう！！\nこれだから夏は嫌いよ！",
            "zh": "啊真是的！！\n我就讨厌夏天这点！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "523/TALK",
            "narrator": "透明アーヤ",
            "text": "夕立に文句言っても\n仕方ないでしょ？",
            "zh": "跟夏天的阵雨抱怨\n也没用吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "527/TALK",
            "narrator": "透明アーヤ",
            "text": "…このままじゃ、\nずぶ濡れで帰ることに\nなりそうね…。",
            "zh": "……再这样下去，\n怕是要淋成落汤鸡\n回去了呢……。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "530/TALK",
            "narrator": "透明神楽",
            "text": "…あっ！",
            "zh": "……啊！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "532/TALK",
            "narrator": "透明神楽",
            "text": "見つけました！\nあそこなら雨宿り\nできそうです！",
            "zh": "找到了！\n那里的话应该能\n躲雨！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "536/TALK",
            "narrator": "透明アーヤ",
            "text": "っ！？　ちょ、それって\nまさか、あそこにある\n古い小屋のこと？",
            "zh": "唔！？　等、你说的\n该不会是，那边那座\n破旧的小屋吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "539/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ドアも開いてるみたい。\nみんな、急ぐわよ！",
            "zh": "门好像也开着。\n大家快走吧！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "541/TALK",
            "narrator": "透明アーヤ",
            "text": "あ、でもあそこは…",
            "zh": "啊，可是那里……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "557/TALK",
            "narrator": "透明アーヤ",
            "text": "ま、待って！！",
            "zh": "等、等等！！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "575/TALK",
            "narrator": "つばめ",
            "text": "ふぅ…どうにか雨宿り\nできそうだねー。",
            "zh": "呼……总算能在这儿\n躲一下雨了呢——。",
            "narrator_zh": "燕"
        },
        {
            "location": "576/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね。",
            "zh": "是啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "580/TALK",
            "narrator": "ガブリエラ",
            "text": "それより、ここって\nバス停だったのね？",
            "zh": "话说回来，这里原来\n是个公交站啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "584/TALK",
            "narrator": "神楽",
            "text": "みたいですね。\nでも、もう使われては\nいないみたいですけど。",
            "zh": "好像是的呢。\n不过，看起来已经\n废弃很久了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "586/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "590/TALK",
            "narrator": "つばめ",
            "text": "きゃっ！？\nか、雷鳴ってるよぉ…。",
            "zh": "呀！？\n打、打雷了呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "594/TALK",
            "narrator": "神楽",
            "text": "通り雨だと思うけど、\nしばらくはやみそうに\nないですね。",
            "zh": "虽然是阵雨，\n不过一时半会儿\n好像停不了呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "597/TALK",
            "narrator": "ガブリエラ",
            "text": "…早く帰りたい。\n全身濡れて寒いし…。",
            "zh": "……好想快点回去。\n浑身湿透好冷……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "598/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "601/TALK",
            "narrator": "つばめ",
            "text": "あの、アーヤさん、\n大丈夫ですか？",
            "zh": "那个，绫水，\n你没事吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "605/TALK",
            "narrator": "つばめ",
            "text": "さっきからずっと\n黙ったままですけど？",
            "zh": "你从刚才起就一直\n沉默不语的？",
            "narrator_zh": "燕"
        },
        {
            "location": "608/TALK",
            "narrator": "アーヤ",
            "text": "え、ええ、大丈夫。\n平気よ…。",
            "zh": "嗯、嗯，没事。\n我没关系的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "611/TALK",
            "narrator": "アーヤ",
            "text": "…こんなボロボロで\n薄暗いバス停なのに、\nみんな怖くないのかしら？",
            "zh": "……这么破破烂烂又\n阴暗的公交站，\n大家都不害怕吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "614/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…まあ、慌てても\nどうなるわけじゃないし、\nやむのを待つしかないか。",
            "zh": "哈啊……嘛，着急也\n解决不了问题，\n只能等雨停了啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "616/TALK",
            "narrator": "つばめ",
            "text": "う、うん…くしゅんっ！",
            "zh": "嗯、嗯……阿嚏！",
            "narrator_zh": "燕"
        },
        {
            "location": "619/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "620/TALK",
            "narrator": "神楽",
            "text": "つばめさん、濡れて身体が\n冷えちゃったんですね。",
            "zh": "燕，淋湿之后身体\n凉下来了呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "621/TALK",
            "narrator": "神楽",
            "text": "こっちで一緒に\n温まりましょう！",
            "zh": "来这边一起\n取暖吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "624/TALK",
            "narrator": "つばめ",
            "text": "カイロでも持ってるの？",
            "zh": "你有带暖宝宝吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "625/TALK",
            "narrator": "神楽",
            "text": "ぎゅっと抱きしめ合えば、\n二人とも体温でぽかぽか\nです！",
            "zh": "只要紧紧抱在一起，\n两个人的体温就会\n变得暖呼呼的了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "627/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nは、恥ずかしいよぉ…。",
            "zh": "诶诶！？\n好、好害羞呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "630/TALK",
            "narrator": "ガブリエラ",
            "text": "それ聞かされてる\nこっちが恥ずかしいわよ。",
            "zh": "在旁边听着这话的\n我才觉得害羞好吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "633/TALK",
            "narrator": "神楽",
            "text": "ガブちゃんも良ければ\n一緒にどうですか？",
            "zh": "加布要是愿意的话\n也一起来怎么样？",
            "narrator_zh": "神乐"
        },
        {
            "location": "636/TALK",
            "narrator": "ガブリエラ",
            "text": "遠慮するわ。\nバス停の中見てる方が\n楽しいし。",
            "zh": "我就不必了。\n看看公交站里面\n还更有意思。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "639/TALK",
            "narrator": "アーヤ",
            "text": "た、楽しいって…。",
            "zh": "还、还更有意思……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "642/TALK",
            "narrator": "ガブリエラ",
            "text": "…まさかアーヤ、\n怖がってない？",
            "zh": "……绫水，你该不会\n在害怕吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "643/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "646/TALK",
            "narrator": "神楽",
            "text": "ここ、ホラー映画とかに\n出てきそうな雰囲気あり\nますから――",
            "zh": "这里确实有点像\n恐怖片里会出现的\n那种氛围——",
            "narrator_zh": "神乐"
        },
        {
            "location": "649/TALK",
            "narrator": "神楽",
            "text": "アーヤさんには\nちょっと怖いかも\nしれませんね。",
            "zh": "对绫水来说，\n可能确实有点\n吓人呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "651/TALK",
            "narrator": "アーヤ",
            "text": "べ、別に怖がってないし！\n勝手に決めつけないで。",
            "zh": "我、我才没有害怕！\n别擅自下定论。",
            "narrator_zh": "绫水"
        },
        {
            "location": "653/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん…\nまあ、別に良いけど。",
            "zh": "哼嗯……\n算了，随你便吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "655/TALK",
            "narrator": "神楽",
            "text": "ほら、つばめさん。\nこんなに身体が\n冷え切ってますよ？",
            "zh": "来，燕。\n身体都凉透了\n不是吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "657/TALK",
            "narrator": "つばめ",
            "text": "か、神楽ちゃんこそ…\nあっ、腕くすぐったい。",
            "zh": "神、神乐也是……\n啊，手臂好痒呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "659/TALK",
            "narrator": "神楽",
            "text": "我慢してください。\n風邪ひかないように\n温めてるんですから…。",
            "zh": "请忍耐一下。\n我这是为了不让你着凉，\n在帮你暖身子呢……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "662/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "674/TALK",
            "narrator": "アーヤ",
            "text": "早く帰りたい(; ;)",
            "zh": "好想快点回去(; ;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "676/SEL",
            "narrator": "",
            "text": "みんな、帰る気なさそう",
            "zh": "大家好像都不打算回去",
            "narrator_zh": ""
        },
        {
            "location": "677/ACT",
            "narrator": "",
            "text": "みんな、帰る気なさそう",
            "zh": "大家好像都不打算回去",
            "narrator_zh": ""
        },
        {
            "location": "679/TALK",
            "narrator": "アーヤ",
            "text": "そうなの",
            "zh": "是啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "680/TALK",
            "narrator": "アーヤ",
            "text": "こんな薄暗いバス停なのに、みんな平気みたい",
            "zh": "明明是这么阴暗的公交站，大家却好像完全不在意",
            "narrator_zh": "绫水"
        },
        {
            "location": "682/SEL",
            "narrator": "",
            "text": "不気味じゃないのかな？",
            "zh": "不觉得阴森吗？",
            "narrator_zh": ""
        },
        {
            "location": "683/SEL",
            "narrator": "",
            "text": "ダッシュで帰ろう",
            "zh": "一口气冲回去吧",
            "narrator_zh": ""
        },
        {
            "location": "684/ACT",
            "narrator": "",
            "text": "不気味じゃないのかな？",
            "zh": "不觉得阴森吗？",
            "narrator_zh": ""
        },
        {
            "location": "686/TALK",
            "narrator": "アーヤ",
            "text": "わからないけど、怖がってるのは私だけみたい",
            "zh": "不知道，但害怕的好像只有我一个",
            "narrator_zh": "绫水"
        },
        {
            "location": "687/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "而且",
            "narrator_zh": "绫水"
        },
        {
            "location": "689/TALK",
            "narrator": "アーヤ",
            "text": "さっきから、背中に変な視線感じる気がするし|ﾟДﾟ)))",
            "zh": "总觉得从刚才开始，背后就有股奇怪的视线|ﾟДﾟ)))",
            "narrator_zh": "绫水"
        },
        {
            "location": "690/TALK",
            "narrator": "アーヤ",
            "text": "本当、早く帰りたい…",
            "zh": "真的，好想快点回去……",
            "narrator_zh": "绫水"
        },
        {
            "location": "703/TALK",
            "narrator": "アーヤ",
            "text": "…気のせいだって\nわかってるけど――",
            "zh": "……虽然知道只是\n心理作用——",
            "narrator_zh": "绫水"
        },
        {
            "location": "704/TALK",
            "narrator": "アーヤ",
            "text": "こういう雰囲気のところに\nいると、どうしても背後が\n気になるわ…。",
            "zh": "但待在这种氛围的地方，\n果然还是会很在意\n背后啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "707/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん…時刻表を見た\n感じだと――",
            "zh": "嗯……看时刻表的\n感觉——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "708/TALK",
            "narrator": "ガブリエラ",
            "text": "昭和六十二年までは、\n間違いなく使われてた\nみたい…。",
            "zh": "直到昭和六十二年，\n这里都确实还在\n使用呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "714/TALK",
            "narrator": "つばめ",
            "text": "凄い昔だね。",
            "zh": "好久以前了呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "716/TALK",
            "narrator": "ガブリエラ",
            "text": "そこからずっと放置\nされてるのかしら？",
            "zh": "从那以后就一直\n荒废在这里了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "719/TALK",
            "narrator": "ガブリエラ",
            "text": "…あら？",
            "zh": "……哎呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "725/TALK",
            "narrator": "ガブリエラ",
            "text": "ここにあるのって…。",
            "zh": "这里的这个是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "727/TALK",
            "narrator": "アーヤ",
            "text": "こういう時って、\n確か振り向くと幽霊に\n憑りつかれるって――",
            "zh": "这种时候，\n好像听说一回头就会\n被幽灵附身——",
            "narrator_zh": "绫水"
        },
        {
            "location": "731/TALK",
            "narrator": "ガブリエラ",
            "text": "やった、ラッキー！",
            "zh": "太好了，真走运！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "735/TALK",
            "narrator": "アーヤ",
            "text": "っ！？　ひあぁっ！！",
            "zh": "唔！？　噫呀啊！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "737/TALK",
            "narrator": "ガブリエラ",
            "text": "きゃぁっ！？\nな、なになに！？",
            "zh": "呀啊！？\n怎、怎么了怎么了！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "740/TALK",
            "narrator": "神楽",
            "text": "ど、どうしました！？",
            "zh": "发、发生什么事了！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "744/TALK",
            "narrator": "アーヤ",
            "text": "あっ…あ、あれ？\nギャヴィ？",
            "zh": "啊……诶、咦？\n加维？",
            "narrator_zh": "绫水"
        },
        {
            "location": "747/TALK",
            "narrator": "ガブリエラ",
            "text": "何なのよ、もう！\n急に大声出して、\nビックリしたじゃない！",
            "zh": "干什么呀，真是的！\n突然大叫一声，\n吓死我了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "748/TALK",
            "narrator": "アーヤ",
            "text": "び、ビックリしたのは\nこっちよ！",
            "zh": "被、被吓到的是\n我才对吧！",
            "narrator_zh": "绫水"
        },
        {
            "location": "749/TALK",
            "narrator": "アーヤ",
            "text": "後ろから大声で\n驚かしたくせに！",
            "zh": "明明是你突然在后面\n大喊吓人的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "750/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなことしないわよ。",
            "zh": "我才没干那种事呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "751/TALK",
            "narrator": "ガブリエラ",
            "text": "傘を見つけたから、\nそれでラッキーって\n言っただけだし。",
            "zh": "我是因为找到了雨伞，\n才顺口说了句真走运\n而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "752/TALK",
            "narrator": "アーヤ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "756/TALK",
            "narrator": "つばめ",
            "text": "あっ、本当だ！\n二本もあったんだ？",
            "zh": "啊，真的呀！\n竟然还有两把呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "758/TALK",
            "narrator": "神楽",
            "text": "結構古くて汚れてます\nけど、使えるんですか？",
            "zh": "虽然又旧又脏，\n不过还能用吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "761/TALK",
            "narrator": "ガブリエラ",
            "text": "うん、大丈夫そうよ。",
            "zh": "嗯，看起来没问题。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "762/TALK",
            "narrator": "ガブリエラ",
            "text": "二本あるから、\n相合傘すれば濡れずに\n帰れるわね。",
            "zh": "这里有两把，\n共撑一把伞的话就能\n不被淋湿回去了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "763/TALK",
            "narrator": "アーヤ",
            "text": "や、やったわギャヴィ！\nこれで帰れる！",
            "zh": "太、太好了加维！\n这下能回去了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "766/TALK",
            "narrator": "ガブリエラ",
            "text": "うん！",
            "zh": "嗯！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "767/TALK",
            "narrator": "ガブリエラ",
            "text": "って…アーヤ、やっぱり\n怖かったんでしょ？",
            "zh": "不对……绫水，你果然\n刚才很害怕吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "770/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "771/TALK",
            "narrator": "ガブリエラ",
            "text": "とうとうバス停まで\n怖がって…次は何？\n電車の駅が怖くなるの？",
            "zh": "居然连公交站都\n怕成这样……下一个是什么？\n连电车站也要怕了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "773/TALK",
            "narrator": "アーヤ",
            "text": "…今回は、何も言い返せ\nないわね。",
            "zh": "……这一次，我确实\n无话可说了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "774/ACT",
            "narrator": "",
            "text": "ダッシュで帰ろう",
            "zh": "一口气冲回去吧",
            "narrator_zh": ""
        },
        {
            "location": "775/TALK",
            "narrator": "アーヤ",
            "text": "それはちょっと、嫌かも",
            "zh": "这个嘛，我有点不太想",
            "narrator_zh": "绫水"
        },
        {
            "location": "776/TALK",
            "narrator": "アーヤ",
            "text": "もう濡れてはいるけど、傘無しで雨の中走るのは嫌よ",
            "zh": "虽然已经湿了，但没伞还要在雨里跑实在太讨厌了",
            "narrator_zh": "绫水"
        },
        {
            "location": "777/TALK",
            "narrator": "アーヤ",
            "text": "多分、みんなもそう言うと思う",
            "zh": "我想，大家应该也会这么说的",
            "narrator_zh": "绫水"
        },
        {
            "location": "788/TALK",
            "narrator": "アーヤ",
            "text": "…走って帰るのは、\n最終手段よね？",
            "zh": "……跑回去，\n算是下下策了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "793/TALK",
            "narrator": "つばめ",
            "text": "そうですね…。\n今は、やんでくれるのを\n待ちたいです。",
            "zh": "是啊……。\n现在，我还是想等雨\n停下来再说。",
            "narrator_zh": "燕"
        },
        {
            "location": "795/TALK",
            "narrator": "神楽",
            "text": "私、濡れるのって\nそんな好きじゃないから、\n出来れば避けたいです…。",
            "zh": "我不太喜欢被雨淋，\n能避免的话\n还是想尽量避免……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "796/TALK",
            "narrator": "神楽",
            "text": "タクシーでも通って\nくれればいいのに…。",
            "zh": "要是能有辆出租车\n路过就好了呢……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "799/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ、もしかして\n走って帰りたいとか\n思ってる？",
            "zh": "绫水，你该不会\n在想着要跑回去\n吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "803/TALK",
            "narrator": "アーヤ",
            "text": "うーん…まあ、今ももう\nずぶ濡れだけど――",
            "zh": "嗯……嘛，虽然现在\n也已经湿透了——",
            "narrator_zh": "绫水"
        },
        {
            "location": "804/TALK",
            "narrator": "アーヤ",
            "text": "この雨の中を走るのは、\nちょっと嫌かも…。",
            "zh": "在这种雨里跑回去，\n还是有点讨厌啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "807/TALK",
            "narrator": "アーヤ",
            "text": "まあ、ずっとここに\nいるのも同じくらい\n嫌だけど…。",
            "zh": "虽然，一直待在这里\n也差不多一样\n讨厌就是了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "809/TALK",
            "narrator": "神楽",
            "text": "とにかく、しばらくは\n様子見ですね。",
            "zh": "总之，先观察一下\n情况再说吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "812/TALK",
            "narrator": "アーヤ",
            "text": "…そうね。",
            "zh": "……也是呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "815/TALK",
            "narrator": "アーヤ",
            "text": "奥は怖いし、なるべく\n入口の近くにいよう…。",
            "zh": "里面怪吓人的，还是\n尽量待在入口附近吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "818/TALK",
            "narrator": "ガブリエラ",
            "text": "…それにしても、\n本当にボロボロね。",
            "zh": "……话说回来，\n这里真是破得厉害呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "821/TALK",
            "narrator": "ガブリエラ",
            "text": "うわっ！？\nここ、雨漏りしてるし。",
            "zh": "呜哇！？\n这里还漏雨了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "823/TALK",
            "narrator": "ガブリエラ",
            "text": "…あら？",
            "zh": "……哎呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "828/TALK",
            "narrator": "つばめ",
            "text": "何か見つけたの？",
            "zh": "发现什么了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "831/TALK",
            "narrator": "ガブリエラ",
            "text": "やった、ラッキー！\n傘があったわ！",
            "zh": "太好了，真走运！\n这里有雨伞！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "834/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "836/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、見て！\n古くて汚れてはいるけど、\nまだ使えそうよ。",
            "zh": "喏，你看！\n虽然又旧又脏，\n但好像还能用。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "838/TALK",
            "narrator": "神楽",
            "text": "誰かが捨てていった\nみたいですね…。",
            "zh": "好像是谁丢在\n这里的呢……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "841/TALK",
            "narrator": "つばめ",
            "text": "あ、ガブちゃん！\nそっちにもう一本\nあるよ！",
            "zh": "啊，加布！\n那边还有\n一把呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "843/TALK",
            "narrator": "ガブリエラ",
            "text": "やったわ！\nこれで相合傘すれば、\n濡れずに帰れるわね。",
            "zh": "太好了！\n这样共撑一把伞的话，\n就能不被淋湿回去了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "844/TALK",
            "narrator": "アーヤ",
            "text": "…その傘、\nどこにあったの？",
            "zh": "……那些伞，\n原本放在哪儿的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "847/TALK",
            "narrator": "ガブリエラ",
            "text": "どこって、ここよ。\nアーヤのすぐ後ろに\n立てかけてあったわ。",
            "zh": "哪儿？就在这里啊。\n就靠在绫水的\n正后方立着呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "848/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤが影になってて、\n見えなかったみたい。",
            "zh": "大概是被绫水的影子\n挡住了，所以没看到吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "849/TALK",
            "narrator": "アーヤ",
            "text": "そ、そうだったんだ…。\n全然気づかなかったわ。",
            "zh": "原、原来如此……。\n我完全没注意到。",
            "narrator_zh": "绫水"
        },
        {
            "location": "850/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、変なところで\n抜けてるんだから…。",
            "zh": "真是的，老在一些\n奇怪的地方犯迷糊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "853/TALK",
            "narrator": "神楽",
            "text": "あの、とりあえず\n傘も手に入れたこと\nですし――",
            "zh": "那个，总之\n伞也已经拿到手了\n——",
            "narrator_zh": "神乐"
        },
        {
            "location": "854/TALK",
            "narrator": "神楽",
            "text": "早く帰りませんか？\nお風呂で温まらないと、\n風邪引いちゃいます。",
            "zh": "我们快点回去吧？\n不泡个澡暖暖身子，\n可是会感冒的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "857/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね。\nはい、あんた達の傘。",
            "zh": "也是呢。\n来，这是你们的伞。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "860/TALK",
            "narrator": "つばめ",
            "text": "ありがと、ガブちゃん。",
            "zh": "谢谢，加布。",
            "narrator_zh": "燕"
        },
        {
            "location": "863/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、行くわよアーヤ。",
            "zh": "走吧，绫水。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "866/TALK",
            "narrator": "アーヤ",
            "text": "え、ええ…。",
            "zh": "嗯、嗯……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "870/TALK",
            "narrator": "アーヤ",
            "text": "…ちょっと振り向けば、\nすぐに見つかったはず\nなのに…。",
            "zh": "……明明只要稍微回个头，\n马上就能找到的\n东西……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "872/TALK",
            "narrator": "アーヤ",
            "text": "私って、少し怖がり\n過ぎるのかしら？",
            "zh": "我是不是，真的有点\n太胆小了呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "512/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月26日　 3:56 PM</color>\n合宿中、とある雨の日のこと",
            "zh": "<color=green>8月26日　 3:56 PM</color>\n集训期间，某个雨天发生的事",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
