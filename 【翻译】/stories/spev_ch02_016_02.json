    "entry": [
        {
            "location": "178/SCENARIO",
            "narrator": "",
            "text": "チュアブル錠",
            "zh": "咀嚼片",
            "narrator_zh": ""
        },
        {
            "location": "180/TALK",
            "narrator": "アーヤ",
            "text": "ありがと",
            "zh": "谢谢",
            "narrator_zh": "绫水"
        },
        {
            "location": "181/TALK",
            "narrator": "アーヤ",
            "text": "でもだいじょうぶ！",
            "zh": "不过没关系！",
            "narrator_zh": "绫水"
        },
        {
            "location": "182/TALK",
            "narrator": "アーヤ",
            "text": "実はあやみには最終手段",
            "zh": "其实绫水还有最终手段",
            "narrator_zh": "绫水"
        },
        {
            "location": "183/TALK",
            "narrator": "アーヤ",
            "text": "オレンジ味の",
            "zh": "橙子味的",
            "narrator_zh": "绫水"
        },
        {
            "location": "184/TALK",
            "narrator": "アーヤ",
            "text": "カルシウム剤があるのよ！",
            "zh": "钙片哦！",
            "narrator_zh": "绫水"
        },
        {
            "location": "186/SEL",
            "narrator": "",
            "text": "へー",
            "zh": "哦——",
            "narrator_zh": ""
        },
        {
            "location": "187/SEL",
            "narrator": "",
            "text": "イライラしてるの？",
            "zh": "你很烦躁吗？",
            "narrator_zh": ""
        },
        {
            "location": "188/SEL",
            "narrator": "",
            "text": "あれおいしいよね",
            "zh": "那个挺好吃的吧",
            "narrator_zh": ""
        },
        {
            "location": "189/ACT",
            "narrator": "",
            "text": "へー",
            "zh": "哦——",
            "narrator_zh": ""
        },
        {
            "location": "190/TALK",
            "narrator": "アーヤ",
            "text": "あんまりそういうのは",
            "zh": "看来你对这种东西",
            "narrator_zh": "绫水"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "興味ないみたいね",
            "zh": "不太感兴趣呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/ACT",
            "narrator": "",
            "text": "イライラしてるの？",
            "zh": "你很烦躁吗？",
            "narrator_zh": ""
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "イライラといえば",
            "zh": "要说烦躁",
            "narrator_zh": "绫水"
        },
        {
            "location": "194/TALK",
            "narrator": "アーヤ",
            "text": "イライラかな",
            "zh": "大概确实有点烦躁吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "195/ACT",
            "narrator": "",
            "text": "あれおいしいよね",
            "zh": "那个挺好吃的吧",
            "narrator_zh": ""
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "あ",
            "zh": "啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "197/TALK",
            "narrator": "アーヤ",
            "text": "結構そういうの詳しい？",
            "zh": "你对这种还挺懂的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "198/TALK",
            "narrator": "アーヤ",
            "text": "美味しいから試してみて",
            "zh": "挺好吃的，可以试试看",
            "narrator_zh": "绫水"
        },
        {
            "location": "200/TALK",
            "narrator": "アーヤ",
            "text": "なんて言えばいいかな",
            "zh": "该怎么说呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "201/TALK",
            "narrator": "アーヤ",
            "text": "体力をつけるとか",
            "zh": "像是锻炼体力啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "202/TALK",
            "narrator": "アーヤ",
            "text": "きちんとご飯食べるとか",
            "zh": "好好吃饭啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "203/TALK",
            "narrator": "アーヤ",
            "text": "ゆっくりお風呂に入るとか",
            "zh": "慢慢泡个澡啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/TALK",
            "narrator": "アーヤ",
            "text": "そういうのも大事なんだけど",
            "zh": "这些固然也很重要",
            "narrator_zh": "绫水"
        },
        {
            "location": "205/TALK",
            "narrator": "アーヤ",
            "text": "もう少しだけ",
            "zh": "但我还是会想要再多一点",
            "narrator_zh": "绫水"
        },
        {
            "location": "206/TALK",
            "narrator": "アーヤ",
            "text": "おまじない？みたいなものが欲しいなって",
            "zh": "像是护身咒语？那样的东西",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/SEL",
            "narrator": "",
            "text": "カルシウムって強そうだもんね",
            "zh": "毕竟钙听起来就很强嘛",
            "narrator_zh": ""
        },
        {
            "location": "209/SEL",
            "narrator": "",
            "text": "自分のところの御守りとかは？",
            "zh": "你们自己家的护身符呢？",
            "narrator_zh": ""
        },
        {
            "location": "210/SEL",
            "narrator": "",
            "text": "$me$が魔法をかけてあげる",
            "zh": "由$me$来给你施魔法吧",
            "narrator_zh": ""
        },
        {
            "location": "211/ACT",
            "narrator": "",
            "text": "カルシウムって強そうだもんね",
            "zh": "毕竟钙听起来就很强嘛",
            "narrator_zh": ""
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "そうなのよ",
            "zh": "是啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "213/TALK",
            "narrator": "アーヤ",
            "text": "強くならなきゃ",
            "zh": "必须得变得",
            "narrator_zh": "绫水"
        },
        {
            "location": "214/TALK",
            "narrator": "アーヤ",
            "text": "いけないから",
            "zh": "更强才行",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/ACT",
            "narrator": "",
            "text": "自分のところの御守りとかは？",
            "zh": "你们自己家的护身符呢？",
            "narrator_zh": ""
        },
        {
            "location": "216/TALK",
            "narrator": "アーヤ",
            "text": "自分で使うのは",
            "zh": "拿来自用的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "217/TALK",
            "narrator": "アーヤ",
            "text": "やっぱりね",
            "zh": "果然还是有点那个嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "218/ACT",
            "narrator": "",
            "text": "$me$が魔法をかけてあげる",
            "zh": "由$me$来给你施魔法吧",
            "narrator_zh": ""
        },
        {
            "location": "219/TALK",
            "narrator": "アーヤ",
            "text": "あら",
            "zh": "哎呀",
            "narrator_zh": "绫水"
        },
        {
            "location": "220/TALK",
            "narrator": "アーヤ",
            "text": "お願いするわ",
            "zh": "那就拜托你了",
            "narrator_zh": "绫水"
        },
        {
            "location": "221/TALK",
            "narrator": "アーヤ",
            "text": "素敵な魔法を",
            "zh": "施个美妙的魔法吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "223/TALK",
            "narrator": "アーヤ",
            "text": "強さが欲しいわ",
            "zh": "我想要力量",
            "narrator_zh": "绫水"
        },
        {
            "location": "224/TALK",
            "narrator": "アーヤ",
            "text": "それから優しさもね",
            "zh": "还有温柔也是",
            "narrator_zh": "绫水"
        },
        {
            "location": "225/TALK",
            "narrator": "アーヤ",
            "text": "そうしないと",
            "zh": "不然的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/TALK",
            "narrator": "アーヤ",
            "text": "みんなを守れないもの",
            "zh": "就没法保护大家了嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "アーヤ",
            "text": "よし！",
            "zh": "好！",
            "narrator_zh": "绫水"
        },
        {
            "location": "229/TALK",
            "narrator": "アーヤ",
            "text": "明日も買ってこよっと",
            "zh": "明天再去买吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "オレンジ味のカルシウム(*^^*)",
            "zh": "橙子味钙片(*^^*)",
            "narrator_zh": "绫水"
        }
    ]
}
