   "text": "ぉ父さんのこと？",
   "zh": "爸爸的事？",
   "narrator_zh": "燕"
  },
  {
   "location": "369/TALK",
   "narrator": "つばめ",
   "text": "ぅん",
   "zh": "嗯",
   "narrator_zh": "燕"
  },
  {
   "location": "371/TALK",
   "narrator": "つばめ",
   "text": "まぁね",
   "zh": "嘛，是啊",
   "narrator_zh": "燕"
  },
  {
   "location": "372/TALK",
   "narrator": "つばめ",
   "text": "本当よかったよ",
   "zh": "真的太好了",
   "narrator_zh": "燕"
  },
  {
   "location": "373/ACT",
   "narrator": "",
   "text": "あのお父さんが…信じられない",
   "zh": "那个爸爸……难以置信",
   "narrator_zh": ""
  },
  {
   "location": "374/TALK",
   "narrator": "つばめ",
   "text": "信じられなぃ？",
   "zh": "难以置信？",
   "narrator_zh": "燕"
  },
  {
   "location": "376/TALK",
   "narrator": "つばめ",
   "text": "そぅだよね(o´Д`)=з",
   "zh": "也是(o´Д`)=з",
   "narrator_zh": "燕"
  },
  {
   "location": "377/TALK",
   "narrator": "つばめ",
   "text": "でも",
   "zh": "可是",
   "narrator_zh": "燕"
  },
  {
   "location": "378/TALK",
   "narrator": "つばめ",
   "text": "本当だよ",
   "zh": "是真的",
   "narrator_zh": "燕"
  },
  {
   "location": "379/TALK",
   "narrator": "つばめ",
   "text": "本当に許してもらったの",
   "zh": "真的被允许了",
   "narrator_zh": "燕"
  },
  {
   "location": "381/TALK",
   "narrator": "つばめ",
   "text": "だから",
   "zh": "所以",
   "narrator_zh": "燕"
  },
  {
   "location": "382/TALK",
   "narrator": "つばめ",
   "text": "大丈夫だよ",
   "zh": "没关系哦",
   "narrator_zh": "燕"
  },
  {
   "location": "384/SEL",
   "narrator": "",
   "text": "何だか元気がないみたい",
   "zh": "总觉得没什么精神",
   "narrator_zh": ""
  },
  {
   "location": "385/ACT",
   "narrator": "",
   "text": "何だか元気がないみたい",
   "zh": "总觉得没什么精神",
   "narrator_zh": ""
  },
  {
   "location": "388/TALK",
   "narrator": "つばめ",
   "text": "ぅぅん",
   "zh": "唔唔",
   "narrator_zh": "燕"
  },
  {
   "location": "389/TALK",
   "narrator": "つばめ",
   "text": "そんなことなぃよ",
   "zh": "没有那种事",
   "narrator_zh": "燕"
  },
  {
   "location": "390/TALK",
   "narrator": "つばめ",
   "text": "わたし",
   "zh": "我",
   "narrator_zh": "燕"
  },
  {
   "location": "392/TALK",
   "narrator": "つばめ",
   "text": "平気だから",
   "zh": "不要紧",
   "narrator_zh": "燕"
  },
  {
   "location": "441/TALK",
   "narrator": "つばめ",
   "text": "ようこそ\n[ココロゲート]へ。",
   "zh": "欢迎来到\n[心之扉]。",
   "narrator_zh": "燕"
  },
  {
   "location": "442/TALK",
   "narrator": "つばめ",
   "text": "早速【問題の扉】を\nコールしましょうか。",
   "zh": "这就来呼叫\n【问题之扉】吧。",
   "narrator_zh": "燕"
  },
  {
   "location": "449/TALK",
   "narrator": "つばめ",
   "text": "オープンプロセス、\n0x22D番地から\n0x8A3番地へ。",
   "zh": "开放进程，\n从0x22D地址\n到0x8A3地址。",
   "narrator_zh": "燕"
  },
  {
   "location": "464/TALK",
   "narrator": "つばめ",
   "text": "シーク完了しました。",
   "zh": "搜索完成。",
   "narrator_zh": "燕"
  },
  {
   "location": "466/TALK",
   "narrator": "つばめ",
   "text": "さて、今回は……",
   "zh": "那么，这次是……",
   "narrator_zh": "燕"
  },
  {
   "location": "468/TALK",
   "narrator": "つばめ",
   "text": "あー、なるほど。",
   "zh": "啊，原来如此。",
   "narrator_zh": "燕"
  },
  {
   "location": "469/SEL",
   "narrator": "",
   "text": "何となく分かってるけど",
   "zh": "虽然隐约明白",
   "narrator_zh": ""
  },
  {
   "location": "470/ACT",
   "narrator": "",
   "text": "何となく分かってるけど",
   "zh": "虽然隐约明白",
   "narrator_zh": ""
  },
  {
   "location": "473/TALK",
   "narrator": "つばめ",
   "text": "やっぱりですか。",
   "zh": "果然是这样。",
   "narrator_zh": "燕"
  },
  {
   "location": "474/TALK",
   "narrator": "つばめ",
   "text": "ココロファイルナンバー\n01-221-21によれば、\n今回の原因はですね――",
   "zh": "根据心之档案编号\n01-221-21，\n这次的原因是——",
   "narrator_zh": "燕"
  },
  {
   "location": "475/TALK",
   "narrator": "つばめ",
   "text": "『父親と和解できてない\nけど、気まずくて連絡を\n取ることもできない』",
   "zh": "『和父亲还没和解，\n可是太尴尬，连联系\n都做不到』",
   "narrator_zh": "燕"
  },
  {
   "location": "476/TALK",
   "narrator": "つばめ",
   "text": "……です。",
   "zh": "……就是这样。",
   "narrator_zh": "燕"
  },
  {
   "location": "478/TALK",
   "narrator": "つばめ",
   "text": "ですがこれはもう、\n和解する以外に\n道はありませんよね。",
   "zh": "不过这件事，\n除了和解以外\n没有别的路吧。",
   "narrator_zh": "燕"
  },
  {
   "location": "479/SEL",
   "narrator": "",
   "text": "確かに",
   "zh": "确实",
   "narrator_zh": ""
  },
  {
   "location": "480/ACT",
   "narrator": "",
   "text": "確かに",
   "zh": "确实",
   "narrator_zh": ""
  },
  {
   "location": "482/TALK",
   "narrator": "つばめ",
   "text": "度胸が足りないんですよ、\nわたし。度胸が！",
   "zh": "是胆量不够，\n我。胆量！",
   "narrator_zh": "燕"
  },
  {
   "location": "483/TALK",
   "narrator": "つばめ",
   "text": "$handle$さんっ！\n[クラン]を倒して、\nわたしに度胸をください！",
   "zh": "$handle$！\n打倒[库兰]，\n把胆量给我！",
   "narrator_zh": "燕"
  },
  {
   "location": "484/TALK",
   "narrator": "つばめ",
   "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！",
   "zh": "献给$handle$和\n我的，\n美妙的心灵之旅！",
   "narrator_zh": "燕"
  },
  {
   "location": "33/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>5月6日　10:13 AM</color>\nFreyMENOWライブの2日後、寮「とらいあんぐる」201号室にて。",
   "zh": "<color=green>5月6日　10:13 AM</color>\nFreyMENOW演出的两天后，宿舍“三角”201号室。",
   "narrator_zh": "Dialog_EventData"
  },
  {
   "location": "84/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "数日前のこと。",
   "zh": "几天前的事。",
   "narrator_zh": "Dialog_EventData"
  },
  {
   "location": "406/DIALOG",
   "narrator": "BattleInit/Dialog_BATTLE_ch01",
   "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n",
   "zh": "<color=black><size=50><b>逢濑燕的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解逢濑燕心中的挣扎。\n\n\n\n",
   "narrator_zh": "BattleInit/Dialog_BATTLE_ch01"
