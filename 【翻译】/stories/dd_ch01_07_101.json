  "title": "002 メインストーリー",
  "sub_title": "決意を伝える決意＜前編＞",
  "title_zh": "002 主线剧情",
  "sub_title_zh": "传达决心的决心＜前篇＞"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "決意を伝える決意",
   "zh": "传达决心的决心",
   "narrator_zh": ""
  },
  {
   "location": "35/TALK",
   "narrator": "アーヤ",
   "text": "ここは、私達トライ\nナリー専用に造られた\n建物なの。",
   "zh": "这里，是为我们\n三重奏专门建造的\n建筑。",
   "narrator_zh": "绫水"
  },
  {
   "location": "37/TALK",
   "narrator": "アーヤ",
   "text": "だから、私達以外の\n民間人は、誰一人\n住んでいないわ。",
   "zh": "所以，除了我们，\n平民一个\n都没有住。",
   "narrator_zh": "绫水"
  },
  {
   "location": "39/TALK",
   "narrator": "つばめ",
   "text": "こんなに広くて\n綺麗なのにですか？",
   "zh": "这么宽、这么漂亮，\n却是这样吗？",
   "narrator_zh": "燕"
  },
  {
   "location": "40/TALK",
   "narrator": "アーヤ",
   "text": "人員が増えるのを\n期待してるのかも\nしれないわね。",
   "zh": "也许是在期待\n人员会增加\n吧。",
   "narrator_zh": "绫水"
  },
  {
   "location": "41/TALK",
   "narrator": "アーヤ",
   "text": "あ、逢瀬さんの部屋は\n階段を上がってすぐの\n２０１号室ね。",
   "zh": "啊，逢濑的房间是\n上了楼梯马上的\n201号室。",
   "narrator_zh": "绫水"
  },
  {
   "location": "42/TALK",
   "narrator": "アーヤ",
   "text": "空き部屋を挟んで、\n２０３がみやびの\n部屋になるわ。",
   "zh": "隔着空房间，\n203是雅的\n房间。",
   "narrator_zh": "绫水"
  },
  {
   "location": "43/TALK",
   "narrator": "アーヤ",
   "text": "私は一階の１０２で、\nギャヴィが１０１よ。",
   "zh": "我在一楼102，\n加维是101。",
   "narrator_zh": "绫水"
  },
  {
   "location": "44/TALK",
   "narrator": "つばめ",
   "text": "わたしの部屋の下が\nせんぱいの部屋なん\nですか！？",
   "zh": "我房间下面\n就是前辈的房间\n吗！？",
   "narrator_zh": "燕"
  },
  {
   "location": "47/TALK",
   "narrator": "つばめ",
   "text": "…怒られないように\n気を付けないと。",
   "zh": "……得小心\n别惹她生气。",
   "narrator_zh": "燕"
  },
  {
   "location": "48/TALK",
   "narrator": "アーヤ",
   "text": "ふふっ、そんなに\n心配しなくても\n平気よ。",
   "zh": "呵呵，不用\n那么担心\n也没关系。",
   "narrator_zh": "绫水"
  },
  {
   "location": "49/TALK",
   "narrator": "アーヤ",
   "text": "とまあ、実家住まいの\n卯月以外は――",
   "zh": "嘛，除了住在家里的\n卯月神乐以外——",
   "narrator_zh": "绫水"
  },
  {
   "location": "50/TALK",
   "narrator": "アーヤ",
   "text": "全員この寮で暮らし\nてることになるわ。",
   "zh": "其他人都会住在\n这栋宿舍里。",
   "narrator_zh": "绫水"
  },
  {
   "location": "52/TALK",
   "narrator": "アーヤ",
   "text": "あと、館長からも\n説明は受けてると\n思うけど――",
   "zh": "另外，馆长应该\n也跟你说明过\n才对——",
   "narrator_zh": "绫水"
  },
  {
   "location": "54/TALK",
   "narrator": "アーヤ",
   "text": "寮の経費は管理庁が\n全額落としてくれる\nから、安心してね。",
   "zh": "宿舍的费用由管理厅\n全额负担，\n放心。",
   "narrator_zh": "绫水"
  },
  {
   "location": "56/TALK",
   "narrator": "つばめ",
   "text": "わかりました。",
   "zh": "我知道了。",
   "narrator_zh": "燕"
  },
  {
   "location": "58/TALK",
   "narrator": "アーヤ",
   "text": "説明は以上よ。\n他にわからない\nことはない？",
   "zh": "说明到这里。\n还有不明白的\n吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "59/TALK",
   "narrator": "つばめ",
   "text": "はい、大丈夫です。",
   "zh": "是的，没问题。",
   "narrator_zh": "燕"
  },
  {
   "location": "61/TALK",
   "narrator": "つばめ",
   "text": "今日からここで\n暮らすんだ…。\n楽しみだなぁ。",
   "zh": "从今天起要住在这里\n了……\n好期待呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "62/TALK",
   "narrator": "アーヤ",
   "text": "一人暮らしだもの。\n浮かれる気持ちも\nわかるけど――",
   "zh": "毕竟是一个人住。\n兴奋的心情\n我懂，不过——",
   "narrator_zh": "绫水"
  },
  {
   "location": "64/TALK",
   "narrator": "アーヤ",
   "text": "でも、本当に\nわかってるのかしら？",
   "zh": "可是，真的\n明白了吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "65/TALK",
   "narrator": "アーヤ",
   "text": "ここで暮らすって\nいうことは――",
   "zh": "住在这里，\n意味着——",
   "narrator_zh": "绫水"
  },
  {
   "location": "67/TALK",
   "narrator": "アーヤ",
   "text": "命がけの戦闘に\n身を置くという\nことなのに…。",
   "zh": "是要把自己放进\n拼命的战斗里，\n可是……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "69/TALK",
   "narrator": "つばめ",
   "text": "…あの、アーヤさん？\nどうかしたんですか？",
   "zh": "……那个，绫水？\n怎么了？",
   "narrator_zh": "燕"
  },
  {
   "location": "71/TALK",
   "narrator": "アーヤ",
   "text": "…そういえば、\nまだ聞いてなかった\nわね。",
   "zh": "……说起来，\n我还没\n问过。",
   "narrator_zh": "绫水"
  },
  {
   "location": "72/TALK",
   "narrator": "アーヤ",
   "text": "逢瀬さんは、どうして\nトライナリーに\n志願したの？",
   "zh": "逢濑，为什么\n志愿加入\n三重奏？",
   "narrator_zh": "绫水"
  },
  {
   "location": "75/TALK",
   "narrator": "つばめ",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "燕"
  },
  {
   "location": "77/TALK",
   "narrator": "つばめ",
   "text": "えっと…\nそれはですね…。",
   "zh": "那个……\n是这样的……。",
   "narrator_zh": "燕"
  },
  {
   "location": "97/TALK",
   "narrator": "つばめ",
   "text": "ふぅ…。",
   "zh": "呼……。",
   "narrator_zh": "燕"
  },
  {
   "location": "98/TALK",
   "narrator": "つばめ",
   "text": "特別攻撃隊、か…。\nどうしたらいいん\nだろう？",
   "zh": "特别攻击队，吗……\n我该怎么办\n才好？",
   "narrator_zh": "燕"
  },
  {
   "location": "99/TALK",
   "narrator": "つばめ",
   "text": "たったの一晩じゃ、\nどうするかなんて\n答えられないよ。",
   "zh": "只有一个晚上，\n要怎么办，\n答不上来呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "100/TALK",
   "narrator": "つばめ",
   "text": "お母さんのことも\n心配だし……やっぱり\n帰らないと……。",
   "zh": "妈妈的事也\n让人担心……果然\n还是得回去……。",
   "narrator_zh": "燕"
  },
  {
   "location": "101/TALK",
   "narrator": "つばめ",
   "text": "でも、\n今日の東雲さん……",
   "zh": "可是，\n今天的东云……",
   "narrator_zh": "燕"
  },
  {
   "location": "103/TALK",
   "narrator": "つばめ",
   "text": "何事も無く帰れる気が\nしないよぅ……",
   "zh": "总觉得没法\n平安回去哦……",
   "narrator_zh": "燕"
  },
  {
   "location": "105/TALK",
   "narrator": "つばめ",
   "text": "はぁ…。東京に来て、\nまさかこんなことに\nなるなんて…。",
   "zh": "哈啊……来了东京，\n没想到会变成\n这样……。",
   "narrator_zh": "燕"
  },
  {
   "location": "106/TALK",
   "narrator": "つばめ",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "燕"
  },
  {
   "location": "107/TALK",
   "narrator": "つばめ",
   "text": "…っ！！　そうだ！\nそういえば、東京に\n行くのを勧めたのって…",
   "zh": "……！！　对了！\n说起来，劝我去东京的\n人是……",
   "narrator_zh": "燕"
  },
  {
   "location": "119/TALK",
   "narrator": "つばめ",
   "text": "こんばんは(*´︶`*)",
   "zh": "晚上好(*´︶`*)",
   "narrator_zh": "燕"
  },
  {
   "location": "120/TALK",
   "narrator": "つばめ",
   "text": "変なこと聞くかもしれなぃけど",
   "zh": "也许会问个奇怪的问题",
   "narrator_zh": "燕"
  },
  {
   "location": "121/TALK",
   "narrator": "つばめ",
   "text": "東京に行くの勧めた時から",
   "zh": "从劝我去东京的时候起",
   "narrator_zh": "燕"
  },
  {
   "location": "122/TALK",
   "narrator": "つばめ",
   "text": "トライナリーに誘われるって",
   "zh": "会被邀请进三重奏",
   "narrator_zh": "燕"
  },
  {
   "location": "123/TALK",
   "narrator": "つばめ",
   "text": "わかってたの？(｡･ω･｡)",
   "zh": "你就知道了吗？(｡･ω･｡)",
   "narrator_zh": "燕"
  },
  {
   "location": "125/SEL",
   "narrator": "",
   "text": "黙っててごめん",
   "zh": "瞒着你，对不起",
   "narrator_zh": ""
  },
  {
   "location": "126/ACT",
   "narrator": "",
   "text": "黙っててごめん",
   "zh": "瞒着你，对不起",
   "narrator_zh": ""
  },
  {
   "location": "128/TALK",
   "narrator": "つばめ",
   "text": "そっか(´･ω･｀) ",
   "zh": "这样啊(´･ω･｀) ",
   "narrator_zh": "燕"
  },
  {
   "location": "129/TALK",
   "narrator": "つばめ",
   "text": "やっぱり知ってたんだ？",
   "zh": "果然你知道？",
   "narrator_zh": "燕"
  },
  {
   "location": "131/SEL",
   "narrator": "",
   "text": "悩んでるの？",
   "zh": "在烦恼吗？",
   "narrator_zh": ""
  },
  {
   "location": "132/ACT",
   "narrator": "",
   "text": "悩んでるの？",
   "zh": "在烦恼吗？",
   "narrator_zh": ""
  },
  {
   "location": "134/TALK",
   "narrator": "つばめ",
   "text": "ぅん",
   "zh": "嗯",
   "narrator_zh": "燕"
  },
  {
   "location": "135/TALK",
   "narrator": "つばめ",
   "text": "メノゥちゃんが酷ぃ目にぁってた時",
   "zh": "MENOW遭遇那么惨的时候",
   "narrator_zh": "燕"
  },
  {
   "location": "136/TALK",
   "narrator": "つばめ",
   "text": "わたし",
   "zh": "我",
   "narrator_zh": "燕"
  },
  {
   "location": "137/TALK",
   "narrator": "つばめ",
   "text": "助けられなかった(´つω・｀)ｼｭﾝ",
   "zh": "没能帮上(´つω・｀)ｼｭﾝ",
   "narrator_zh": "燕"
  },
  {
   "location": "138/TALK",
   "narrator": "つばめ",
   "text": "けど",
   "zh": "可是",
   "narrator_zh": "燕"
  },
  {
   "location": "139/TALK",
   "narrator": "つばめ",
   "text": "トラィナリーに入隊すれば",
   "zh": "加入三重奏的话",
   "narrator_zh": "燕"
  },
  {
   "location": "140/TALK",
   "narrator": "つばめ",
   "text": "助けることのできる力を手に入れられるんだよね？(๑･ㅂ･)و☆",
   "zh": "就能得到能去帮忙的力量吧？(๑･ㅂ･)و☆",
   "narrator_zh": "燕"
  },
  {
   "location": "142/SEL",
   "narrator": "",
   "text": "心は決まってるんだ？",
   "zh": "心意已经定了吗？",
   "narrator_zh": ""
  },
  {
   "location": "143/ACT",
   "narrator": "",
   "text": "心は決まってるんだ？",
   "zh": "心意已经定了吗？",
   "narrator_zh": ""
  },
  {
   "location": "145/TALK",
   "narrator": "つばめ",
   "text": "決まってるよぅな",
   "zh": "好像定了哦",
   "narrator_zh": "燕"
  },
  {
   "location": "146/TALK",
   "narrator": "つばめ",
   "text": "決まってなぃよぅな(o´Д`)=з",
   "zh": "又好像没定(o´Д`)=з",
   "narrator_zh": "燕"
  },
  {
   "location": "147/TALK",
   "narrator": "つばめ",
   "text": "でも",
   "zh": "可是",
   "narrator_zh": "燕"
  },
  {
   "location": "148/TALK",
   "narrator": "つばめ",
   "text": "やりたぃって気持ちは",
   "zh": "想做的心情",
   "narrator_zh": "燕"
  },
  {
   "location": "149/TALK",
   "narrator": "つばめ",
   "text": "すごぃぁるょ！！",
   "zh": "非常强烈哦！！",
   "narrator_zh": "燕"
  },
  {
   "location": "150/TALK",
   "narrator": "つばめ",
   "text": "わたしは今までずっと入院してて",
   "zh": "我直到现在一直住院",
   "narrator_zh": "燕"
  },
  {
   "location": "151/TALK",
   "narrator": "つばめ",
   "text": "メノゥちゃんの歌にずっと支ぇられてきたの(*´︶`*)",
   "zh": "一直被MENOW的歌支撑着(*´︶`*)",
   "narrator_zh": "燕"
  },
  {
   "location": "152/TALK",
   "narrator": "つばめ",
   "text": "トラィナリーに入隊すれば",
   "zh": "加入三重奏的话",
   "narrator_zh": "燕"
  },
  {
   "location": "153/TALK",
   "narrator": "つばめ",
   "text": "今度はわたしが支ぇることができる(≧ω≦)",
   "zh": "这次就能由我来支撑(≧ω≦)",
   "narrator_zh": "燕"
  },
  {
   "location": "154/TALK",
   "narrator": "つばめ",
   "text": "またメノゥちゃんが危なぃ目にぁっても",
   "zh": "就算MENOW再遇到危险",
   "narrator_zh": "燕"
  },
  {
   "location": "155/TALK",
   "narrator": "つばめ",
   "text": "助けてぁげられる⊂('ω'⊂ )))Σ≡=─",
   "zh": "我也能去帮她⊂('ω'⊂ )))Σ≡=─",
   "narrator_zh": "燕"
  },
  {
   "location": "156/TALK",
   "narrator": "つばめ",
   "text": "でも",
   "zh": "可是",
   "narrator_zh": "燕"
  },
  {
   "location": "157/TALK",
   "narrator": "つばめ",
   "text": "東京にぃることになっちゃったら",
   "zh": "要是得留在东京",
   "narrator_zh": "燕"
  },
  {
   "location": "158/TALK",
   "narrator": "つばめ",
   "text": "ぉ母さんのそばにぃられなくなっちゃぅ",
   "zh": "就不能待在妈妈身边了",
   "narrator_zh": "燕"
  },
  {
   "location": "161/SEL",
   "narrator": "",
   "text": "そこは心配しなくても大丈夫",
   "zh": "那一点不用担心",
   "narrator_zh": ""
  },
  {
   "location": "162/ACT",
   "narrator": "",
   "text": "そこは心配しなくても大丈夫",
   "zh": "那一点不用担心",
   "narrator_zh": ""
  },
  {
   "location": "164/TALK",
   "narrator": "つばめ",
   "text": "ぇっ！？(ﾟ△ﾟ;ﾉ)ﾉ",
   "zh": "诶！？(ﾟ△ﾟ;ﾉ)ﾉ",
   "narrator_zh": "燕"
  },
  {
   "location": "165/TALK",
   "narrator": "つばめ",
   "text": "どぅして？？？(´ｪ｀；)三(；´ｪ｀)",
   "zh": "为什么？？？(´ｪ｀；)三(；´ｪ｀)",
   "narrator_zh": "燕"
  },
  {
   "location": "167/SEL",
   "narrator": "",
   "text": "直感だよ",
   "zh": "是直觉",
   "narrator_zh": ""
  },
  {
   "location": "168/SEL",
   "narrator": "",
   "text": "$me$は全てを知る者だから",
