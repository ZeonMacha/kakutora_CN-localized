  },
  {
   "location": "170/ACT",
   "narrator": "",
   "text": "直感だよ",
   "zh": "是直觉",
   "narrator_zh": ""
  },
  {
   "location": "171/TALK",
   "narrator": "つばめ",
   "text": "そぅなんだ",
   "zh": "是这样啊",
   "narrator_zh": "燕"
  },
  {
   "location": "172/ACT",
   "narrator": "",
   "text": "$me$は全てを知る者だから",
   "zh": "因为$me$是知晓一切的人",
   "narrator_zh": ""
  },
  {
   "location": "173/TALK",
   "narrator": "つばめ",
   "text": "すごぃね！",
   "zh": "好厉害！",
   "narrator_zh": "燕"
  },
  {
   "location": "175/TALK",
   "narrator": "つばめ",
   "text": "でもそぅだよね",
   "zh": "不过也是",
   "narrator_zh": "燕"
  },
  {
   "location": "176/TALK",
   "narrator": "つばめ",
   "text": "わたしがトライナリーになることだって",
   "zh": "就连我成为三重奏",
   "narrator_zh": "燕"
  },
  {
   "location": "177/TALK",
   "narrator": "つばめ",
   "text": "知ってたんだし",
   "zh": "你也知道",
   "narrator_zh": "燕"
  },
  {
   "location": "178/ACT",
