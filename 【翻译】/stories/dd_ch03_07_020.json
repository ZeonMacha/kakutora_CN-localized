{
    "dir": "chap07/daydra/dd_ch03_07_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "7356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "美術の授業",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "美术课"
    },
    "entry": [
        {
            "location": "320/SCENARIO",
            "narrator": "",
            "text": "美術の授業",
            "zh": "美术课",
            "narrator_zh": ""
        },
        {
            "location": "332/TALK",
            "narrator": "ガブリエラ",
            "text": "う～ん…。",
            "zh": "唔～……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "335/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、何してるの？",
            "zh": "加维，你在干嘛？",
            "narrator_zh": "绫水"
        },
        {
            "location": "336/TALK",
            "narrator": "ガブリエラ",
            "text": "見ればわかるでしょ？\n美術の授業中よ。",
            "zh": "这还用问吗？\n正在上美术课啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "337/TALK",
            "narrator": "アーヤ",
            "text": "あ、そうだったんだ。\n邪魔しちゃって\nごめん――",
            "zh": "啊，是这样啊。\n打扰到你了，\n抱歉——",
            "narrator_zh": "绫水"
        },
        {
            "location": "339/TALK",
            "narrator": "アーヤ",
            "text": "って、何その絵！？\n凄く上手いじゃない！",
            "zh": "不对，那幅画是怎么回事！？\n画得也太好了吧！",
            "narrator_zh": "绫水"
        },
        {
            "location": "340/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィにこんな\n特技があるなんて\n知らなかったわ。",
            "zh": "我都不知道加维还有\n这么厉害的\n特长呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "343/TALK",
            "narrator": "ガブリエラ",
            "text": "べ、別に、特技って程じゃ\nないけど…。",
            "zh": "也、也算不上什么\n特长啦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "344/TALK",
            "narrator": "アーヤ",
            "text": "謙遜する必要ないでしょ？\nそれだけ描けるんだし。",
            "zh": "用不着谦虚吧？\n都能画成这样了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "346/TALK",
            "narrator": "ガブリエラ",
            "text": "…下書きはね。",
            "zh": "……线稿的话确实还行啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "348/TALK",
            "narrator": "ガブリエラ",
            "text": "けど、絵具で色を塗るのが\n凄く苦手なのよ…。",
            "zh": "但是，我特别不擅长\n用颜料上色啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "349/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしても求めてる色が、\n作れないから――",
            "zh": "怎么都调不出\n我想要的颜色——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "350/TALK",
            "narrator": "ガブリエラ",
            "text": "毎回微妙に違和感のある\n絵になっちゃって…。",
            "zh": "每次画出来都带着\n说不出的违和感……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "351/TALK",
            "narrator": "アーヤ",
            "text": "あ～…まあ、わからない\nでもないわ。",
            "zh": "啊～……嘛，我也不是\n不能理解。",
            "narrator_zh": "绫水"
        },
        {
            "location": "352/TALK",
            "narrator": "アーヤ",
            "text": "私も、同じような経験\nしたことあるし…。",
            "zh": "我自己也有过\n类似的经历……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "354/TALK",
            "narrator": "ガブリエラ",
            "text": "あー、もうっ！",
            "zh": "啊——真是的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "355/TALK",
            "narrator": "ガブリエラ",
            "text": "空の色はもう少し\n薄い青じゃなきゃ\nダメなのに！",
            "zh": "天空的颜色明明\n必须再浅蓝一点\n才行的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "358/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…ヤル気失せるわ…。",
            "zh": "唉……都没干劲了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "359/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、別に見たままの\n色にしなくてもいいんじゃ\nない？",
            "zh": "……嘛，其实也不用\n非得画成眼睛看到的\n颜色吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "360/TALK",
            "narrator": "アーヤ",
            "text": "絵は写真じゃないん\nだから、少し違った方が\n味が出るわよ。",
            "zh": "画又不是照片，\n稍微有点区别\n才更有味道嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "362/TALK",
            "narrator": "ガブリエラ",
            "text": "…そういうもの？",
            "zh": "……是这样吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "365/TALK",
            "narrator": "アーヤ",
            "text": "ま、まあ、私も詳しい\nわけじゃないから、\n断言はできないけど…。",
            "zh": "嘛、嘛，我也不算\n很懂行，\n不能把话说死……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "368/TALK",
            "narrator": "アーヤ",
            "text": "でも、有名な画家の絵とか\n見てると、凄い色使い\nしてるのがあるじゃない。",
            "zh": "不过，你看那些著名画家的\n画作，不也有用色\n很大胆的嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "369/TALK",
            "narrator": "アーヤ",
            "text": "空が黄色だったり、\n色んな色が混ざって\nたり…。",
            "zh": "天空是黄色的啦，\n各种颜色混在一起\n啦……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "370/TALK",
            "narrator": "ガブリエラ",
            "text": "…見たことはあるわ。",
            "zh": "……确实见过。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "371/TALK",
            "narrator": "アーヤ",
            "text": "だから、それと同じ感じで\n塗ってみたらどう？",
            "zh": "所以，照着那种感觉\n涂涂看怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "374/TALK",
            "narrator": "ガブリエラ",
            "text": "う～ん…。",
            "zh": "唔～……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "375/TALK",
            "narrator": "アーヤ",
            "text": "まあ、やり過ぎたら\n減点されると思うけど…。",
            "zh": "嘛，要是画过头了\n大概会被扣分就是了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "377/TALK",
            "narrator": "ガブリエラ",
            "text": "…難しそうだけど、\nちょっと楽しそうかも。",
            "zh": "……听起来挺难的，\n不过好像有点意思。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "379/TALK",
            "narrator": "ガブリエラ",
            "text": "わかった。\nその方向で描いてみるわ。",
            "zh": "我知道了。\n我往这个方向画画看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "380/TALK",
            "narrator": "アーヤ",
            "text": "よかった…。\nそれじゃ、頑張ってね。",
            "zh": "太好了……。\n那就加油吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "384/TALK",
            "narrator": "ガブリエラ",
            "text": "そっか…あたしが見たい\n空の色にしちゃっても\nいいのよね？",
            "zh": "原来如此……涂成我想看的\n天空颜色\n也可以对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "386/TALK",
            "narrator": "ガブリエラ",
            "text": "写真じゃないんだから、\nどんな色にだって\nできるんだもの。",
            "zh": "反正又不是照片，\n涂成什么颜色\n都可以嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "387/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうだ。\nマルザンナは\nどう思うかしら？",
            "zh": "……对了。\n玛尔赞娜\n怎么想呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "399/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナ、空は何色だと思う？",
            "zh": "玛尔赞娜，你觉得天空是什么颜色的？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "401/SEL",
            "narrator": "",
            "text": "昼間は青、夜は黒",
            "zh": "白天是蓝色，晚上是黑色",
            "narrator_zh": ""
        },
        {
            "location": "402/ACT",
            "narrator": "",
            "text": "昼間は青、夜は黒",
            "zh": "白天是蓝色，晚上是黑色",
            "narrator_zh": ""
        },
        {
            "location": "404/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ、普通に見たらそうよね？",
            "zh": "呵呵，正常来看是这样没错吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "405/TALK",
            "narrator": "ガブリエラ",
            "text": "けど、私はこう思うの",
            "zh": "不过，我是这么想的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "406/TALK",
            "narrator": "ガブリエラ",
            "text": "もしも空が色んな色に輝いていたとしたら、凄く素敵だと思わない？",
            "zh": "如果天空闪耀着各种各样的色彩，你不觉得非常美妙吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "407/TALK",
            "narrator": "ガブリエラ",
            "text": "それを絵にしようと思うんだけど、あなたはどう思う？",
            "zh": "我想把它画成画，你觉得怎么样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "409/SEL",
            "narrator": "",
            "text": "いや、空は青でしょ？",
            "zh": "不，天空就是蓝色的吧？",
            "narrator_zh": ""
        },
        {
            "location": "410/SEL",
            "narrator": "",
            "text": "オーロラみたいで素敵だ",
            "zh": "像极光一样好美",
            "narrator_zh": ""
        },
        {
            "location": "411/SEL",
            "narrator": "",
            "text": "太陽に顔も描こう",
            "zh": "给太阳也画上脸吧",
            "narrator_zh": ""
        },
        {
            "location": "412/ACT",
            "narrator": "",
            "text": "いや、空は青でしょ？",
            "zh": "不，天空就是蓝色的吧？",
            "narrator_zh": ""
        },
        {
            "location": "413/TALK",
            "narrator": "ガブリエラ",
            "text": "確かにその通りだけど…",
            "zh": "确实是这样没错啦……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "414/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナって、夢がないのね",
            "zh": "玛尔赞娜你真是缺乏梦想呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "426/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…せっかく楽しい\n気持ちだったのに、\n一気に冷めちゃったわ。",
            "zh": "唉……好不容易才有点\n兴致的，\n一下子全凉了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "427/TALK",
            "narrator": "ガブリエラ",
            "text": "…もういいや。\nこの青塗って、さっさと\n終わらせちゃお…。",
            "zh": "……算了。\n就涂这个蓝色，赶紧\n画完交差吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "428/ACT",
            "narrator": "",
            "text": "オーロラみたいで素敵だ",
            "zh": "像极光一样好美",
            "narrator_zh": ""
        },
        {
            "location": "430/TALK",
            "narrator": "ガブリエラ",
            "text": "素晴らしい例えだわ、マルザンナ",
            "zh": "绝妙的比喻啊，玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "431/TALK",
            "narrator": "ガブリエラ",
            "text": "空全体をオーロラみたいな美しい色にしてみるわ",
            "zh": "我就试着把整片天空涂成极光那样美丽的色彩",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "442/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ、なんだか楽しく\nなってきたかも。",
            "zh": "呵呵，总觉得开始\n变得有意思起来了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "444/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃあまずは青に\n紫、緑に赤、それと――",
            "zh": "那首先用蓝色加\n紫色，绿色加红色，还有——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "460/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ……。",
            "zh": "唉……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "463/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、大丈夫？",
            "zh": "加维，你没事吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "465/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ…大変なことに\nなっちゃったわ。",
            "zh": "绫水……出大事\n了啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "466/TALK",
            "narrator": "アーヤ",
            "text": "何かあったの？",
            "zh": "发生什么事了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "467/TALK",
            "narrator": "ガブリエラ",
            "text": "美術の時間に描いた絵の\nことなんだけど…。",
            "zh": "就是美术课上\n画的那幅画……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "468/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤのアドバイスを\n聞いて、本物と違う色で\n描いてみたら――",
            "zh": "我听了绫水的建议，\n试着用和实物不同的颜色\n去画——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "469/TALK",
            "narrator": "ガブリエラ",
            "text": "先生、物凄く気に入った\nらしくて…。",
            "zh": "结果老师似乎\n非常中意……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "471/TALK",
            "narrator": "アーヤ",
            "text": "あら、それなら\n良かったじゃない。",
            "zh": "哎呀，那不是\n挺好的嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "473/TALK",
            "narrator": "ガブリエラ",
            "text": "良くない！",
            "zh": "一点都不好！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "474/TALK",
            "narrator": "ガブリエラ",
            "text": "この絵は素晴らしいから、\nって、絵のコンクールに\n出すことになったのよ？",
            "zh": "老师说着“这幅画太棒了”，\n就决定要拿去参加\n绘画比赛了哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "476/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？\nどうしてそんなことに\nなっちゃったの！？",
            "zh": "咦！？\n怎么会变成\n那样啊！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "477/TALK",
            "narrator": "ガブリエラ",
            "text": "わからないわよ…。",
            "zh": "我哪知道啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "478/TALK",
            "narrator": "ガブリエラ",
            "text": "感性が素晴らしいとか、\nなんかそんなこと\n言ってた気がするけど――",
            "zh": "我记得他好像说了什么\n“感性非常出色”\n之类的话——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "479/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしには、さっぱり\n何が何だかわからな\nかったわ…。",
            "zh": "可我完全搞不懂\n到底是怎么一回事\n啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "480/TALK",
            "narrator": "アーヤ",
            "text": "そ、そう…。",
            "zh": "这、这样啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "481/TALK",
            "narrator": "アーヤ",
            "text": "でも、認められたって\n証拠なんだから、\n喜ぶべきことよ。",
            "zh": "不过，这也是画作\n得到认可的证明，\n应该高兴才对哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "482/TALK",
            "narrator": "ガブリエラ",
            "text": "…カラフルな空の絵が\n大勢に見られるのかと\n思うと――",
            "zh": "……一想到那幅五颜六色的\n天空画要被那么多人\n看到——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "484/TALK",
            "narrator": "ガブリエラ",
            "text": "素直に喜べないわ…。",
            "zh": "就实在高兴不起来啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "485/TALK",
            "narrator": "アーヤ",
            "text": "この子、どんな絵を\n描いたのかしら？",
            "zh": "这孩子，到底是画了\n一幅什么样的画啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "502/ACT",
            "narrator": "",
            "text": "太陽に顔も描こう",
            "zh": "给太阳也画上脸吧",
            "narrator_zh": ""
        },
        {
            "location": "503/TALK",
            "narrator": "ガブリエラ",
            "text": "それも素敵ね",
            "zh": "那也不错呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "504/TALK",
            "narrator": "ガブリエラ",
            "text": "どことなくモダンな感じの絵になりそうな予感がするわ",
            "zh": "总觉得有种能画成莫名摩登的画的预感",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "516/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ…なんだか楽しく\nなってきたかも。",
            "zh": "呵呵……总觉得开始\n变得有意思起来了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "517/TALK",
            "narrator": "ガブリエラ",
            "text": "時間もないし、\nさっさと始めないと！",
            "zh": "时间也不多了，\n得赶紧动笔才行！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "532/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ……。",
            "zh": "唉……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "535/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、大丈夫？",
            "zh": "加维，你没事吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "537/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ…はぁ…。",
            "zh": "绫水……唉……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "538/TALK",
            "narrator": "アーヤ",
            "text": "どうしたの？\nため息ばかり吐いて…。",
            "zh": "怎么了？\n一直在叹气……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "539/TALK",
            "narrator": "ガブリエラ",
            "text": "…美術で描いた絵よ。",
            "zh": "……还不是美术课画的画。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "542/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤの言う通りに\n描いたら、先生に\nドン引きされたわ。",
            "zh": "我照着绫水说的\n去画，结果被老师\n吓傻了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "544/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "咦！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "545/TALK",
            "narrator": "ガブリエラ",
            "text": "ガブリエラさんは、\n独特の感性を持っている\nのね、って――",
            "zh": "老师对我说，\n“加布里埃拉同学真是\n拥有独特的感性呢”——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "546/TALK",
            "narrator": "ガブリエラ",
            "text": "引きつった顔で\n言われたのよ。",
            "zh": "还是一脸僵硬地\n这么说的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "547/TALK",
            "narrator": "アーヤ",
            "text": "何を描いたの？\nただの風景画のどこで\nドン引きするのよ？",
            "zh": "你画了什么啊？\n普通的风景画有什么\n好吓傻的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "548/TALK",
            "narrator": "ガブリエラ",
            "text": "太陽に描いた顔が\nいけなかったみたい。",
            "zh": "好像是因为我在太阳上\n画了张脸。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "549/TALK",
            "narrator": "アーヤ",
            "text": "…ちょっと待って。",
            "zh": "……等一下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "550/TALK",
            "narrator": "アーヤ",
            "text": "ただの風景画に、\n顔のある太陽なんて\n必要ないじゃない。",
            "zh": "普通的风景画里，\n根本不需要长着脸的\n太阳吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "551/TALK",
            "narrator": "ガブリエラ",
            "text": "だって、アーヤが\n言ったんでしょ！？",
            "zh": "可是，不是绫水\n说的吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "552/TALK",
            "narrator": "ガブリエラ",
            "text": "写真じゃないんだから、\n見たまんまに描く必要は\nない、って…。",
            "zh": "说什么又不是照片，\n没必要照着看到的样子\n原封不动地画……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "553/TALK",
            "narrator": "アーヤ",
            "text": "だからって、太陽に顔を\n描くのは、明らかに\nやり過ぎでしょ？",
            "zh": "话虽如此，给太阳画上脸\n也明显太过头了\n吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "554/TALK",
            "narrator": "アーヤ",
            "text": "っていうか、やり過ぎに\n気を付けろとも、ちゃんと\n言ったのに…。",
            "zh": "话说回来，我明明也\n提醒过你别画过头\n了的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "556/TALK",
            "narrator": "ガブリエラ",
            "text": "提出した絵が返される\nことを考えると、\n恥ずかしくて堪らないわ。",
            "zh": "一想到交上去的画\n还要发回来，\n我就羞耻得受不了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "558/TALK",
            "narrator": "アーヤ",
            "text": "…描いてるときに\n気付きなさいよ。",
            "zh": "……画的时候就该\n意识到了吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "330/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月11日　1:21 PM</color>\nとある午後、美術の授業中のこと。",
            "zh": "<color=green>5月11日　1:21 PM</color>\n某个下午，美术课上发生的事。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "496/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch03",
            "text": "【新しい空】",
            "zh": "【崭新的天空】",
            "narrator_zh": "Dialog_GEThimegoto_ch03"
        }
    ]
}
