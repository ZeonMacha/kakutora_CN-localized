        },
        {
            "location": "3776/TALK",
            "narrator": "神楽",
            "text": "それがまずわかんない",
            "zh": "这点我首先就不懂",
            "narrator_zh": "神乐"
        },
        {
            "location": "3777/ACT",
            "narrator": "",
            "text": "代わりにやってあげれば？",
            "zh": "你替他们做不就好了？",
            "narrator_zh": ""
        },
        {
            "location": "3778/TALK",
            "narrator": "神楽",
            "text": "そういうことじゃなくて",
            "zh": "不是那个意思",
