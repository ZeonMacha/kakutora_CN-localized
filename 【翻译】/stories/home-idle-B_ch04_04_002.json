            "text": "みやびHOME画面・昼（手前に来てから）",
            "zh": "雅的HOME画面·白天（走到近前之后）",
            "narrator_zh": ""
        },
        {
            "location": "295/TALK",
            "narrator": "みやび",
            "text": "…ん？\n何かの知らせか？",
            "zh": "……嗯？\n是什么预兆咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "301/TALK",
            "narrator": "みやび",
            "text": "お迎えか？",
            "zh": "来接我走了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "305/TALK",
            "narrator": "みやび",
            "text": "気のせいか。",
            "zh": "是错觉咩。",
            "narrator_zh": "雅"
        },
        {
            "location": "309/TALK",
            "narrator": "みやび",
            "text": "誰かに\n呼ばれたような……",
            "zh": "好像有人\n在叫我……",
            "narrator_zh": "雅"
        },
        {
            "location": "313/TALK",
            "narrator": "みやび",
            "text": "なんぞ、\n気味悪いね。",
            "zh": "做驷马，\n怪发毛的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "315/TALK",
            "narrator": "みやび",
            "text": "透明人間さん\nいらっしゃいますか？",
            "zh": "透明人先生\n请问在吗？",
            "narrator_zh": "雅"
        }
    ]
}
