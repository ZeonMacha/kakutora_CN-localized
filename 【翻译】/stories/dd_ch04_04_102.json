   "zh": "那话以后再说",
   "narrator_zh": ""
  },
  {
   "location": "509/TALK",
   "narrator": "みやび",
   "text": "誤魔化すなや",
   "zh": "别糊弄",
   "narrator_zh": "雅"
  },
  {
   "location": "511/SEL",
   "narrator": "",
   "text": "まだ助かるかもしれないんだよ！",
   "zh": "也许还来得及救啊！",
   "narrator_zh": ""
  },
  {
   "location": "512/ACT",
   "narrator": "",
   "text": "まだ助かるかもしれないんだよ！",
   "zh": "也许还来得及救啊！",
   "narrator_zh": ""
  },
  {
   "location": "514/TALK",
   "narrator": "みやび",
   "text": "まだそんなこと言うてるが？",
   "zh": "还在说这种话？",
   "narrator_zh": "雅"
  },
  {
   "location": "516/SEL",
   "narrator": "",
   "text": "頑張ろうよ！",
   "zh": "一起加油啊！",
   "narrator_zh": ""
  },
  {
   "location": "517/ACT",
   "narrator": "",
   "text": "頑張ろうよ！",
   "zh": "一起加油啊！",
   "narrator_zh": ""
  },
  {
   "location": "519/TALK",
   "narrator": "みやび",
   "text": "軽いな",
   "zh": "说得轻巧",
   "narrator_zh": "雅"
  },
  {
   "location": "520/TALK",
   "narrator": "みやび",
   "text": "うちはな",
   "zh": "我啊",
   "narrator_zh": "雅"
  },
  {
   "location": "521/TALK",
   "narrator": "みやび",
   "text": "そういう話を軽々しく言うヤツは",
   "zh": "把这种话随口说出来的人",
   "narrator_zh": "雅"
  },
  {
   "location": "522/TALK",
   "narrator": "みやび",
   "text": "大嫌いなんや",
   "zh": "我最讨厌了",
   "narrator_zh": "雅"
  },
  {
   "location": "535/TALK",
   "narrator": "みやび",
   "text": "…腹立たしいヤツや。",
   "zh": "……真是个气人的家伙。",
   "narrator_zh": "雅"
  },
  {
   "location": "536/TALK",
   "narrator": "みやび",
   "text": "まさか、なごちゃんの\nことを知っちゅうとは…。",
   "zh": "……没想到，你居然知道\n七五的事……。",
   "narrator_zh": "雅"
  },
  {
   "location": "537/TALK",
   "narrator": "みやび",
   "text": "…やはり、うちを攪乱する\nために、管理庁が仕掛けて\nきた刺客か…？",
   "zh": "……果然，是为了搅乱我，\n管理厅派来的\n刺客吗……？",
   "narrator_zh": "雅"
  },
  {
   "location": "538/TALK",
   "narrator": "みやび",
   "text": "…いや、うちだけ\nピンポイントで狙われる\nようなこと――",
   "zh": "……不，会专门\n盯上我一个人\n这种事——",
   "narrator_zh": "雅"
  },
  {
   "location": "539/TALK",
   "narrator": "みやび",
   "text": "管理庁にした覚えないん\nやけんど…。",
   "zh": "我不记得对管理厅\n做过什么，不过……。",
   "narrator_zh": "雅"
  },
  {
   "location": "540/TALK",
   "narrator": "みやび",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "雅"
  },
  {
   "location": "541/TALK",
   "narrator": "みやび",
   "text": "やけんど――",
   "zh": "不过——",
   "narrator_zh": "雅"
  },
  {
   "location": "542/TALK",
   "narrator": "みやび",
   "text": "もしそうやとしたら、\nうちがやることは\n一つやね。",
   "zh": "如果真是这样，\n我要做的\n只有一件咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "543/TALK",
   "narrator": "みやび",
   "text": "徹底抗戦や！",
   "zh": "彻底抗战！",
   "narrator_zh": "雅"
  },
  {
   "location": "555/TALK",
   "narrator": "みやび",
   "text": "賭けをせんか？",
   "zh": "要不要打个赌喃？",
   "narrator_zh": "雅"
  },
  {
   "location": "557/SEL",
   "narrator": "",
   "text": "賭けの内容は？",
   "zh": "赌什么？",
   "narrator_zh": ""
  },
  {
   "location": "558/ACT",
   "narrator": "",
   "text": "賭けの内容は？",
   "zh": "赌什么？",
   "narrator_zh": ""
  },
  {
   "location": "560/TALK",
   "narrator": "みやび",
   "text": "うちらがこの戦いに勝ったら",
   "zh": "我们要是赢了这场",
   "narrator_zh": "雅"
  },
  {
   "location": "561/TALK",
   "narrator": "みやび",
   "text": "あんたのアカウントの秘密鍵をよこしや",
   "zh": "就把你账号的私钥交出来",
   "narrator_zh": "雅"
  },
  {
   "location": "562/TALK",
   "narrator": "みやび",
   "text": "この条件を飲むなら、戦いを継続しちゃる",
   "zh": "要是接受这个条件，我就给你把仗继续打下去",
   "narrator_zh": "雅"
  },
  {
   "location": "563/TALK",
   "narrator": "みやび",
   "text": "どうや？",
   "zh": "怎么样？",
   "narrator_zh": "雅"
  },
  {
   "location": "565/SEL",
   "narrator": "",
   "text": "もし負けたら？",
   "zh": "要是输了呢？",
   "narrator_zh": ""
  },
  {
   "location": "566/SEL",
   "narrator": "",
