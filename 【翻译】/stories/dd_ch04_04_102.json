  "cid": "miyabi",
  "title": "004 メインストーリー",
  "sub_title": "恋ヶ崎みやびという存在＜後編＞",
  "title_zh": "004 主线剧情",
  "sub_title_zh": "名为恋之崎雅的存在＜后篇＞"
 },
 "entry": [
  {
   "location": "397/SCENARIO",
   "narrator": "",
   "text": "恋ヶ崎みやびという存在",
   "zh": "名为恋之崎雅的存在",
   "narrator_zh": ""
  },
  {
   "location": "420/TALK",
   "narrator": "千羽鶴",
   "text": "現実世界へ\nおかえりなさい。",
   "zh": "欢迎回到\n现实世界。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "421/TALK",
   "narrator": "千羽鶴",
   "text": "貴方が彼女のココロの中で\n奮闘してくれたお陰で、\n彼女の心は安定した。",
   "zh": "多亏你在她的心中\n奋战，\n她的心稳定下来了。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "422/TALK",
   "narrator": "千羽鶴",
   "text": "あとは貴方から直接、\n彼女にアドバイスをして、\n背中を一押しするだけ。",
   "zh": "接下来只要你直接\n给她一点建议，\n在背后推她一把。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "423/TALK",
   "narrator": "千羽鶴",
   "text": "さて、\nその方法だけど。",
   "zh": "那么，\n说到方法。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "429/TALK",
   "narrator": "千羽鶴",
   "text": "WAVEというチャット\nツールのシステムを\n作ってみた。",
   "zh": "我做了一个\n叫WAVE的聊天\n工具系统。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "430/TALK",
   "narrator": "千羽鶴",
   "text": "あなたの世界にも、\n似たものがあるかも\nしれないけど。",
   "zh": "你的世界里，\n也许也有\n类似的东西。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "431/TALK",
   "narrator": "千羽鶴",
   "text": "そして、彼女のWAVEに\nあなたを登録して\nおいた。",
   "zh": "然后，我已经把你\n登记进她的WAVE\n了。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "432/SEL",
   "narrator": "",
   "text": "なるほど",
   "zh": "原来如此",
   "narrator_zh": ""
  },
  {
   "location": "433/ACT",
   "narrator": "",
   "text": "なるほど",
   "zh": "原来如此",
   "narrator_zh": ""
  },
  {
   "location": "435/TALK",
   "narrator": "千羽鶴",
   "text": "でも「bot」として\nだけど。",
   "zh": "不过是作为“bot”\n登记的。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "436/SEL",
   "narrator": "",
   "text": "なんでBot！？",
   "zh": "为什么是Bot！？",
   "narrator_zh": ""
  },
  {
   "location": "437/ACT",
   "narrator": "",
   "text": "なんでBot！？",
   "zh": "为什么是Bot！？",
   "narrator_zh": ""
  },
  {
   "location": "439/TALK",
   "narrator": "千羽鶴",
   "text": "いきなり知らない人が\nフレンド登録されて\nいたらまずいでしょう。",
   "zh": "要是突然有不认识的人\n被加为好友，\n不太好吧。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "440/SEL",
   "narrator": "",
   "text": "そんなところにリアリティを持たせなくても",
   "zh": "那种地方不必搞得那么真实",
   "narrator_zh": ""
  },
  {
   "location": "441/ACT",
   "narrator": "",
   "text": "そんなところにリアリティを持たせなくても",
   "zh": "那种地方不必搞得那么真实",
   "narrator_zh": ""
  },
  {
   "location": "443/TALK",
   "narrator": "千羽鶴",
   "text": "「あなた」は「あなた」\nなんだから。",
   "zh": "“你”就是“你”，\n就是这样。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "444/TALK",
   "narrator": "千羽鶴",
   "text": "幼馴染み設定とか、\nそんな都合のいい\nものはないから。",
   "zh": "青梅竹马之类\n那么方便的设定，\n是没有的。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "445/TALK",
   "narrator": "千羽鶴",
   "text": "そこはリアリティを\n持って欲しい。",
   "zh": "这一点，\n希望有真实感。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "446/TALK",
   "narrator": "千羽鶴",
   "text": "そういうわけだから、\n彼女からの抵抗は\nあまり無いはず。",
   "zh": "所以，\n她应该不会\n太抗拒。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "447/SEL",
   "narrator": "",
   "text": "でもBotじゃねえ…",
   "zh": "可是Bot啊……",
   "narrator_zh": ""
  },
  {
   "location": "448/ACT",
   "narrator": "",
   "text": "でもBotじゃねえ…",
   "zh": "可是Bot啊……",
   "narrator_zh": ""
  },
  {
   "location": "450/TALK",
   "narrator": "千羽鶴",
   "text": "私はあくまで\n自然な出逢いと機会を\n与えただけ。",
   "zh": "我只是给了\n一次自然的相遇\n和机会。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "451/TALK",
   "narrator": "千羽鶴",
   "text": "どう運用するかは\nあなたが決めていい。",
   "zh": "怎么用，\n由你来决定。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "452/TALK",
   "narrator": "千羽鶴",
   "text": "すぐに「bot」では\nないと伝えてもいいし、\nそのままでもいい。",
   "zh": "你可以马上说\n自己不是“bot”，\n也可以先这样。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "453/TALK",
   "narrator": "千羽鶴",
   "text": "そこはあなたの\nセンスに任せる。",
   "zh": "这一点\n交给你的品味。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "457/TALK",
   "narrator": "千羽鶴",
   "text": "さあ、彼女の新しい物語が\n始まろうとしている。",
   "zh": "好了，她的新故事\n就要开始了。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "458/TALK",
   "narrator": "千羽鶴",
   "text": "チャットツールWAVEを\n使って、彼女を支えて\nいってほしい。",
   "zh": "希望你用聊天工具WAVE，\n去支撑她\n走下去。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "470/TALK",
   "narrator": "みやび",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "雅"
  },
  {
   "location": "471/TALK",
   "narrator": "みやび",
   "text": "…なんや？",
   "zh": "……怎么了？",
   "narrator_zh": "雅"
  },
  {
   "location": "472/TALK",
   "narrator": "みやび",
   "text": "なんか急に\nつっかかりが取れた\nような……",
   "zh": "总觉得突然\n卡住的地方松开了\n似的……",
   "narrator_zh": "雅"
  },
  {
   "location": "473/SEL",
   "narrator": "",
   "text": "今回のやる気喪失、なごちゃんが関係してたりする？",
   "zh": "这次提不起劲，和七五有关系吗？",
   "narrator_zh": ""
  },
  {
   "location": "474/ACT",
   "narrator": "",
   "text": "今回のやる気喪失、なごちゃんが関係してたりする？",
   "zh": "这次提不起劲，和七五有关系吗？",
   "narrator_zh": ""
  },
  {
   "location": "478/TALK",
   "narrator": "みやび",
   "text": "はぁ…誰や、\nこんな時にWAVEなんぞ――",
   "zh": "唉……是谁啊，\n这种时候搞什么WAVE——",
   "narrator_zh": "雅"
  },
  {
   "location": "479/TALK",
   "narrator": "みやび",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "雅"
  },
  {
   "location": "484/TALK",
   "narrator": "みやび",
   "text": "っ！？",
   "zh": "唔！？",
   "narrator_zh": "雅"
  },
  {
   "location": "492/TALK",
   "narrator": "みやび",
   "text": "あんた、何者や？",
   "zh": "你，是什么人？",
   "narrator_zh": "雅"
  },
  {
   "location": "494/SEL",
   "narrator": "",
   "text": "botです",
   "zh": "我是bot",
   "narrator_zh": ""
  },
  {
   "location": "495/SEL",
   "narrator": "",
   "text": "みやびを助けに来た",
   "zh": "我是来帮雅的",
   "narrator_zh": ""
  },
  {
   "location": "496/ACT",
   "narrator": "",
   "text": "Botです",
   "zh": "我是Bot",
   "narrator_zh": ""
  },
  {
   "location": "498/TALK",
   "narrator": "みやび",
   "text": "確かにそう書いちゅうね",
   "zh": "上面确实这么写着",
   "narrator_zh": "雅"
  },
  {
   "location": "499/TALK",
   "narrator": "みやび",
   "text": "けんど",
   "zh": "不过",
   "narrator_zh": "雅"
  },
  {
   "location": "500/ACT",
   "narrator": "",
   "text": "みやびを助けに来た",
   "zh": "我是来帮雅的",
   "narrator_zh": ""
  },
  {
   "location": "501/TALK",
   "narrator": "みやび",
   "text": "は？",
   "zh": "哈？",
   "narrator_zh": "雅"
  },
  {
   "location": "502/TALK",
   "narrator": "みやび",
   "text": "画面にはBotと表示されちゅうけんどBotに助けられる筋合いはない、てゆうか",
   "zh": "屏幕上显示的是Bot，不过没有被Bot帮忙的道理，或者说",
   "narrator_zh": "雅"
  },
  {
   "location": "504/TALK",
   "narrator": "みやび",
   "text": "まっことＡＩなが？",
   "zh": "的确是ＡＩ喃？",
   "narrator_zh": "雅"
  },
  {
   "location": "506/SEL",
   "narrator": "",
   "text": "その話はあとだ",
