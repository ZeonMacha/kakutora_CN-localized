    "entry": [
        {
            "location": "468/SCENARIO",
            "narrator": "",
            "text": "TGSみやび",
            "zh": "TGS雅",
            "narrator_zh": ""
        },
        {
            "location": "488/TALK",
            "narrator": "みやび",
            "text": "デートに海、っちゅうのは\n定番過ぎると思わんか？",
            "zh": "约会去海边，\n是不是老套过头了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "489/TALK",
            "narrator": "みやび",
            "text": "いや、別に悪いとは\n言わんけんど。",
            "zh": "不，但是倒也没说\n它不好啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "490/TALK",
            "narrator": "みやび",
            "text": "相棒やったら、\nもっと面白い場所を\n選ぶと思うたんやが…。",
            "zh": "换作是搭档，\n我以为你会挑个\n更有趣的地方……",
            "narrator_zh": "雅"
        },
        {
            "location": "491/SEL",
            "narrator": "",
            "text": "気に入らなかった？",
            "zh": "你不满意吗？",
            "narrator_zh": ""
        },
        {
            "location": "492/SEL",
            "narrator": "",
            "text": "定番こそ王道とも言う",
            "zh": "老套才是王道",
            "narrator_zh": ""
        },
        {
            "location": "493/ACT",
            "narrator": "",
            "text": "気に入らなかった？",
            "zh": "你不满意吗？",
            "narrator_zh": ""
        },
        {
            "location": "494/TALK",
            "narrator": "みやび",
            "text": "なんや、気にしたが？",
            "zh": "怎么，你在意了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "495/TALK",
            "narrator": "みやび",
            "text": "冗談や、冗談。\n気に入らんわけやないき、\n気にせんでえい。",
            "zh": "开玩笑的，开玩笑。\n又不是不满意嘛，\n别放在心上就得。",
            "narrator_zh": "雅"
        },
        {
            "location": "496/TALK",
            "narrator": "みやび",
            "text": "まっこと気に入らん\n思うてたら、\n一緒に来たりせんぞね。",
            "zh": "要是真的蛮不满意，\n才不会\n一起来咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "497/ACT",
            "narrator": "",
            "text": "定番こそ王道とも言う",
            "zh": "老套才是王道",
            "narrator_zh": ""
        },
        {
            "location": "498/TALK",
            "narrator": "みやび",
            "text": "…なるほど、\n確かにそうかもしれん。",
            "zh": "……原来如此，\n确实有道理。",
            "narrator_zh": "雅"
        },
        {
            "location": "499/TALK",
            "narrator": "みやび",
            "text": "なんだかんだ言うても、\n王道に外れはないきね。",
            "zh": "说归说，\n王道总不会错的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "500/TALK",
            "narrator": "みやび",
            "text": "それに…うちとしても\n海デートと聞いて、\nテンション上がったし。",
            "zh": "再说……听到\n是海边约会，我这边\n也兴奋起来了嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "502/TALK",
            "narrator": "みやび",
            "text": "…その証拠に、ほれ、\nこの水着見てみぃ。",
            "zh": "……证据就是，喏，\n来看看这件泳装嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "503/TALK",
            "narrator": "みやび",
            "text": "なんとも…大胆っちゅうと\n聞こえはえいけんど、\nはしたないような…。",
            "zh": "怎么讲……说大胆\n算好听，但是\n总有点不检点……",
            "narrator_zh": "雅"
        },
        {
            "location": "504/TALK",
            "narrator": "みやび",
            "text": "露出しまくり水着なんぞ\n買うてしまったちや。",
            "zh": "居然买下了这种露得到处\n都是的泳装，真是滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "505/SEL",
            "narrator": "",
            "text": "どうしてこれを選んだの？",
            "zh": "为什么选这件？",
            "narrator_zh": ""
        },
        {
            "location": "506/ACT",
            "narrator": "",
            "text": "どうしてこれを選んだの？",
            "zh": "为什么选这件？",
            "narrator_zh": ""
        },
        {
            "location": "509/TALK",
            "narrator": "みやび",
            "text": "それは…。",
            "zh": "这个嘛……。",
            "narrator_zh": "雅"
        },
        {
            "location": "510/TALK",
            "narrator": "みやび",
            "text": "恋人の喜ぶ水着特集で、\nこれが一位やった、\nっちゅうだけの理由ちや。",
            "zh": "只是因为让恋人\n开心的泳装特辑里，\n这件排第一滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "511/TALK",
            "narrator": "みやび",
            "text": "つまり、その…。",
            "zh": "也就是说，那个……",
            "narrator_zh": "雅"
        },
        {
            "location": "512/TALK",
            "narrator": "みやび",
            "text": "…いや、言わせるな。\n少しは察せ、恋人よ。",
            "zh": "……不，别让我说。\n多少自己领会一下，恋人。",
            "narrator_zh": "雅"
        },
        {
            "location": "513/SEL",
            "narrator": "",
            "text": "すごく嬉しい、ありがとう",
            "zh": "非常高兴，谢谢你",
            "narrator_zh": ""
        },
        {
            "location": "514/SEL",
            "narrator": "",
            "text": "愛を感じる",
            "zh": "感受到爱了",
            "narrator_zh": ""
        },
        {
            "location": "515/ACT",
            "narrator": "",
            "text": "すごく嬉しい、ありがとう",
            "zh": "非常高兴，谢谢你",
            "narrator_zh": ""
        },
        {
            "location": "516/TALK",
            "narrator": "みやび",
            "text": "…そう言うてくれるなら、\n頑張って選んだ甲斐が\nあるゆうもんや。",
            "zh": "……你能这么说，\n用心挑选总算\n算有意义了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "517/ACT",
            "narrator": "",
            "text": "愛を感じる",
            "zh": "感受到爱了",
            "narrator_zh": ""
        },
        {
            "location": "518/TALK",
            "narrator": "みやび",
            "text": "あ、アホか！？",
            "zh": "啊、你傻啊！？",
            "narrator_zh": "雅"
        },
        {
            "location": "519/TALK",
            "narrator": "みやび",
            "text": "いや、そりゃ恋人やき、\n愛がないっちゅうわけや\nないけんど…。",
            "zh": "不，毕竟是恋人嘛，\n也不是说\n没有爱，但是……",
            "narrator_zh": "雅"
        },
        {
            "location": "520/TALK",
            "narrator": "みやび",
            "text": "…うちを、こんな風に\n慌てさせられるんは、\n相棒だけやぞ？",
            "zh": "……能把我弄得\n这么慌张的，\n只有搭档你一个啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "523/TALK",
            "narrator": "みやび",
            "text": "まあ、気に入ってくれた\nっちゅうなら…。",
            "zh": "嘛，既然你说\n喜欢的话……",
            "narrator_zh": "雅"
        },
        {
            "location": "524/TALK",
            "narrator": "みやび",
            "text": "ほれ、今のうちにしっかり\n目に焼き付けときぃ。",
            "zh": "喏，趁现在好好\n把这一幕刻在眼里。",
            "narrator_zh": "雅"
        },
        {
            "location": "525/TALK",
            "narrator": "みやび",
            "text": "喜んでもらえたんは\n嬉しいけんど、さすがに\n海以外では着んだろうし。",
            "zh": "你能喜欢\n我很开心，但是\n总不会在海以外穿吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "526/SEL",
            "narrator": "",
            "text": "ちょっとだけ、触ってもいい？",
            "zh": "可以稍微碰一下吗？",
            "narrator_zh": ""
        },
        {
            "location": "527/ACT",
            "narrator": "",
            "text": "ちょっとだけ、触ってもいい？",
            "zh": "可以稍微碰一下吗？",
            "narrator_zh": ""
        },
        {
            "location": "529/TALK",
            "narrator": "みやび",
            "text": "…欲張りな恋人やね。",
            "zh": "……真是贪心的恋人啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "530/TALK",
            "narrator": "みやび",
            "text": "まあ、えいやろ…。\nせっかく海に来てるん\nやきね。",
            "zh": "嘛，好啦……\n难得来一趟\n海边嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "531/TALK",
            "narrator": "みやび",
            "text": "ちくっと、開放的な\n気持ちになった思うて、\n特別に触らせちゃるぞね。",
            "zh": "想着难得稍微\n开放了一回，\n就特别给你摸咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "550/TALK",
            "narrator": "みやび",
            "text": "…こんなに\n薄着しちゅうのに、\n暑くなってきたがよ…。",
            "zh": "……明明\n穿得这么薄，\n却热起来了嘛……",
            "narrator_zh": "雅"
        },
        {
            "location": "552/TALK",
            "narrator": "みやび",
            "text": "…まあ、誰も見てないき、\n楽しむとするぞね。",
            "zh": "……嘛，反正没人看见啵，\n就好好享受咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "558/TALK",
            "narrator": "みやび",
            "text": "ふふん、柔らかいやろ？",
            "zh": "哼哼，很软吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "559/TALK",
            "narrator": "みやび",
            "text": "…わ、わかったなら、\n突然触るのはもうやめぃ。",
            "zh": "……知、知道了的话，\n就别再突然乱摸了。",
            "narrator_zh": "雅"
        },
        {
            "location": "561/TALK",
            "narrator": "みやび",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "562/TALK",
            "narrator": "みやび",
            "text": "いや…、そういうのは、\n褒められんがよ？",
            "zh": "不……这种话，\n可算不上夸我吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "568/TALK",
            "narrator": "みやび",
            "text": "…この水着やと、\n肌に直接触れられるき…、\nソワソワしてくるぞね。",
            "zh": "……这件泳装的话，\n会直接碰到肌肤啵，\n让人心慌起来咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "570/TALK",
            "narrator": "みやび",
            "text": "さ、触るだけやぞ？",
            "zh": "只、只是摸哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "571/TALK",
            "narrator": "みやび",
            "text": "それと、触れてるときに\n動かすんは禁止や…。",
            "zh": "还有，摸的时候\n不许乱动……",
            "narrator_zh": "雅"
        },
        {
            "location": "577/TALK",
            "narrator": "みやび",
            "text": "…こんなに\n薄着しちゅうのに、\n暑くなってきたがよ…。",
            "zh": "……明明\n穿得这么薄，\n却热起来了嘛……",
            "narrator_zh": "雅"
        },
        {
            "location": "579/TALK",
            "narrator": "みやび",
            "text": "なんや、水着のこと\n褒めてくれちゅうが？",
            "zh": "怎么，你是想夸\n这件泳装咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "585/TALK",
            "narrator": "みやび",
            "text": "…ゆ、揺らすのが\n好きなが？",
            "zh": "……你、你很喜欢\n晃它咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "587/TALK",
            "narrator": "みやび",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "588/TALK",
            "narrator": "みやび",
            "text": "いや…、そういうのは、\n褒められんがよ？",
            "zh": "不……这种话，\n可算不上夸我吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "594/TALK",
            "narrator": "みやび",
            "text": "…この水着やと、\n肌に直接触れられるき…、\nソワソワしてくるぞね。",
            "zh": "……这件泳装的话，\n会直接碰到肌肤啵，\n让人心慌起来咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "596/TALK",
            "narrator": "みやび",
            "text": "さ、触るだけやぞ？",
            "zh": "只、只是摸哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "597/TALK",
            "narrator": "みやび",
            "text": "それと、触れてるときに\n動かすんは禁止や…。",
            "zh": "还有，摸的时候\n不许乱动……",
            "narrator_zh": "雅"
        },
        {
            "location": "536/DIALOG",
            "narrator": "INFO",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已连接。\n\n请点击画面，向对方\n传达感觉吧。",
            "narrator_zh": "INFO"
        },
