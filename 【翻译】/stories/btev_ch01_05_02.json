{
    "dir": "chap05/battle/btev_ch01_05_02.js",
    "type": "",
    "info": {
        "story_id": "21006",
        "cid": "",
        "title": "006 ココロスフィアストーリー【Lv02】",
        "sub_title": "綺麗すぎる湖Ⅰ＜帰結＞",
        "title_zh": "006 心灵领域故事【Lv02】",
        "sub_title_zh": "漂亮过头的湖Ⅰ＜归结＞"
    },
    "entry": [
        {
            "location": "149/SCENARIO",
            "narrator": "",
            "text": "綺麗すぎる湖２",
            "zh": "漂亮过头的湖2",
            "narrator_zh": ""
        },
        {
            "location": "158/TALK",
            "narrator": "潜在つばめ",
            "text": "凄い想いの力。",
            "zh": "好强的心意。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "159/TALK",
            "narrator": "表層つばめ",
            "text": "そりゃそうだよ。\nわたし、本当は\n友達作りたいんだもん。",
            "zh": "那当然呀。\n我其实\n想交朋友。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "160/TALK",
            "narrator": "表層つばめ",
            "text": "ヒントになることなら\n知りたいの。",
            "zh": "只要是能当线索的，\n我都想知道。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "161/TALK",
            "narrator": "潜在つばめ",
            "text": "……。\nヒントだけで済むとは\n限らないよ。",
            "zh": "……。\n不一定只是\n线索就够了。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "162/TALK",
            "narrator": "表層つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "表层燕"
        },
        {
            "location": "163/TALK",
            "narrator": "潜在つばめ",
            "text": "まあいいよ。\n約束は約束だもんね。",
            "zh": "算了。\n约定就是约定呀。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "164/TALK",
            "narrator": "潜在つばめ",
            "text": "それじゃ、見たい封印\n記憶を１つ、見せて\nあげる。",
            "zh": "那么，你想看的封印\n记忆，我就给你看\n一份。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "165/TALK",
            "narrator": "潜在つばめ",
            "text": "頭の中で、何を知り\nたいか強く想い\n描いてみて。",
            "zh": "在脑子里，把你想\n知道的事用力\n想出来看看。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "166/TALK",
            "narrator": "表層つばめ",
            "text": "う、うん。",
            "zh": "嗯、嗯。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "191/DIALOG",
            "narrator": "",
            "text": "東京に来るちょっと前。\n\nこれは、わたしが高校に入学して、\n１０日目くらいにあった出来事。",
            "zh": "来东京的稍早之前。\n\n这是我上高中之后，\n大约第十天发生的事。",
            "narrator_zh": ""
        },
        {
            "location": "192/TALK",
            "narrator": "女子高校生Ａ",
            "text": "へえ、そうなんだ！",
            "zh": "诶，是这样呀！",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "193/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "チョーウケルでしょ。\nつばめちゃんは？",
            "zh": "超好笑对吧。\n燕呢？",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "194/TALK",
            "narrator": "つばめ",
            "text": "え？\nわ、わたし？",
            "zh": "诶？\n我、我吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "195/DIALOG",
            "narrator": "",
            "text": "席が近かったって理由だけど、\nようやくわたしにも、\nお話しできる友達ができた。\n\nその子たちとは、\n家の方向が近かったから、\n一緒に下校をしようって\nことになって――",
            "zh": "虽然只是因为座位近，\n我终于也有了\n能说话的朋友。\n\n和她们，\n因为回家方向近，\n就说好一起\n放学回家——",
            "narrator_zh": ""
        },
        {
            "location": "196/TALK",
            "narrator": "つばめ",
            "text": "わたしは\nそういうのは特に――",
            "zh": "我\n对那种事倒没什么——",
            "narrator_zh": "燕"
        },
        {
            "location": "197/TALK",
            "narrator": "女子高校生Ａ",
            "text": "あっ……",
            "zh": "啊……",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "200/TALK",
            "narrator": "女子高校生Ａ",
            "text": "あああああっ！！",
            "zh": "啊啊啊啊！！",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "203/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "なに！？\nどうしたの？",
            "zh": "什么！？\n怎么了？",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "204/TALK",
            "narrator": "女子高校生Ａ",
            "text": "そこのため池に\nスマホ落とした……",
            "zh": "手机掉进\n那边的池塘了……",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "205/TALK",
            "narrator": "つばめ",
            "text": "ええええっ！！",
            "zh": "诶诶诶诶！！",
            "narrator_zh": "燕"
        },
        {
            "location": "206/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "ちょっ…\nそれ最悪じゃん？",
            "zh": "等下……\n那不是最糟了吗？",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "229/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "ああ、ダメだねこりゃ",
            "zh": "啊，这下没救了",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "230/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "このため池、\nちょっと深いし、\nめっちゃ汚いし。",
            "zh": "这个池塘，\n又有点深，\n又脏得要命。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "231/TALK",
            "narrator": "女子高校生Ａ",
            "text": "あーもう、\nマジブルー、、",
            "zh": "啊啊真是的，\n心情彻底垮了，，",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "232/TALK",
            "narrator": "女子高校生Ａ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "233/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "234/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "235/TALK",
            "narrator": "女子高校生Ａ",
            "text": "なんか生きる気力\nなくした……",
            "zh": "感觉失去活下去的\n力气了……",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "239/TALK",
            "narrator": "つばめ",
            "text": "ええっ！",
            "zh": "诶诶！",
            "narrator_zh": "燕"
        },
        {
            "location": "240/TALK",
            "narrator": "女子高校生Ａ",
            "text": "だれか１万円あげる\nから探してー……",
            "zh": "谁去找的话\n我给一万日元……",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "247/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "１万円？　無理無理！\n１０万だったら\nやるわ。",
            "zh": "一万日元？　免谈免谈！\n十万的话\n我就去。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "250/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "265/TALK",
            "narrator": "潜在つばめ",
            "text": "おしまい。",
            "zh": "到此为止。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "266/TALK",
            "narrator": "潜在つばめ",
            "text": "この時のこと、\n覚えてる？",
            "zh": "那时候的事，\n你还记得吗？",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "267/TALK",
            "narrator": "表層つばめ",
            "text": "覚えてるよ。",
            "zh": "记得。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "268/TALK",
            "narrator": "表層つばめ",
            "text": "この次の日から、\nわたしとお話して\nくれなくなったんだ。",
            "zh": "从第二天起，\n她们就不跟我\n说话了。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "269/TALK",
            "narrator": "表層つばめ",
            "text": "でも、これだけじゃ\nやっぱり何も\nわからないよ。",
            "zh": "可是，只有这些，\n果然还是\n什么都不明白。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "272/TALK",
            "narrator": "表層つばめ",
            "text": "なんでわたし、\n嫌われちゃったの？",
            "zh": "为什么，\n我会被讨厌？",
            "narrator_zh": "表层燕"
        },
        {
            "location": "273/TALK",
            "narrator": "潜在つばめ",
            "text": "……。　　　　",
            "zh": "……。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "274/TALK",
            "narrator": "潜在つばめ",
            "text": "それを知りたいなら、\nもっと心の奥に\nアプローチが必要だね。",
            "zh": "要是想知道这个，\n就得再往心的更深处\n靠近才行。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "275/TALK",
            "narrator": "潜在つばめ",
            "text": "もし本当に知りたい\nなら、更に深く心の\n奥へ潜る必要がある。",
            "zh": "如果真的想知道，\n就得潜到\n心的更深处。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "277/TALK",
            "narrator": "表層つばめ",
            "text": "心の……奥……",
            "zh": "心的……深处……",
            "narrator_zh": "表层燕"
        },
        {
            "location": "278/TALK",
            "narrator": "潜在つばめ",
            "text": "けど、最初に\n忠告しておくよ。",
            "zh": "不过，我先\n警告你。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "279/TALK",
            "narrator": "潜在つばめ",
            "text": "それは必ずしも\nあなたの心の助けには\nならないかも。",
            "zh": "那不一定\n能帮到\n你的心。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "280/TALK",
            "narrator": "潜在つばめ",
            "text": "むしろ、余計に\nショックを受けて\n引っ込んじゃうかも。",
            "zh": "反倒可能\n受到更大的打击，\n缩回去。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "281/TALK",
            "narrator": "表層つばめ",
            "text": "…っ。",
            "zh": "……。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "282/TALK",
            "narrator": "潜在つばめ",
            "text": "その覚悟があるなら、\n深層意識に来て。",
            "zh": "你要是有这个觉悟，\n就来深层意识。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "283/TALK",
            "narrator": "潜在つばめ",
            "text": "その時はまた、\n私と戦う事になるけど、\nその決意があるなら。",
            "zh": "到时候，\n还得再和我战斗，\n如果你有这个决心的话。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "295/TALK",
            "narrator": "表層つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "296/SEL",
            "narrator": "（選択肢）",
            "text": "行くよね？",
            "zh": "会去的吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "297/ACT",
            "narrator": "",
            "text": "行くよね？",
            "zh": "会去的吧？",
            "narrator_zh": ""
        },
        {
            "location": "299/TALK",
            "narrator": "表層つばめ",
            "text": "……うん。\nもちろんだよ。",
            "zh": "……嗯。\n当然会。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "300/TALK",
            "narrator": "表層つばめ",
            "text": "自分のこと、\nもっとちゃんと\n知りたいもん。",
            "zh": "我自己的事，\n想更清楚地\n了解。",
            "narrator_zh": "表层燕"
        }
    ]
}
