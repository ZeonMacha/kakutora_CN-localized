{
    "dir": "chap00/daydra/spev_ch01_007.js",
    "type": "",
    "info": {
        "story_id": "1007",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "神楽ちゃんとお勉強",
        "title_zh": "特别篇",
        "sub_title_zh": "和神乐一起学习"
    },
    "entry": [
        {
            "location": "28/TALK",
            "narrator": "透明つばめ",
            "text": "うーん…この問題、\nどうやって解けば\nいいんだっけ…？",
            "zh": "嗯……这道题，\n该怎么解\n来着……？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "29/TALK",
            "narrator": "透明神楽",
            "text": "二次方程式を使えば\n簡単に解けますよ。\n中学で習いましたよね？",
            "zh": "用二次方程\n就能轻松解开。\n中学学过吧？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "30/TALK",
            "narrator": "透明つばめ",
            "text": "え、えっと…。",
            "zh": "那、那个……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "33/TALK",
            "narrator": "透明神楽",
            "text": "あ、あはは…、\nまさかつばめさん…、\n忘れちゃったんですか？",
            "zh": "啊、啊哈哈……\n难道燕……\n忘掉了吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "34/TALK",
            "narrator": "透明つばめ",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "透明燕"
        },
        {
            "location": "35/TALK",
            "narrator": "透明神楽",
            "text": "…あ、あれ？",
            "zh": "……咦、咦？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "39/TALK",
            "narrator": "透明つばめ",
            "text": "うわーん！！\n全然覚えてないよー！",
            "zh": "呜哇！！\n完全不记得了！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "41/TALK",
            "narrator": "透明神楽",
            "text": "えぇっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "42/TALK",
            "narrator": "透明つばめ",
            "text": "ど、どうしよう…。\nこの問題飛ばしても、\nどうにかなるかな？",
            "zh": "怎、怎么办……\n这题跳过去，\n也能过得去吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "43/TALK",
            "narrator": "透明神楽",
            "text": "いえ、これが解けないと\n来週の小テストは\n絶望的ですよ？",
            "zh": "不行，这题不会的话，\n下周的小测\n就没希望了哦？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "45/TALK",
            "narrator": "透明つばめ",
            "text": "ど、どうしよう…。\n中学の勉強から\nやり直さないとダメかな？",
            "zh": "怎、怎么办……\n得从中学的内容\n重新来吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "46/TALK",
            "narrator": "透明神楽",
            "text": "と、とにかく落ち着いて。\n泣き止んでください。",
            "zh": "总、总之先冷静。\n别哭了。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "47/TALK",
            "narrator": "透明つばめ",
            "text": "う、うん…。",
            "zh": "嗯、嗯……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "49/TALK",
            "narrator": "透明神楽",
            "text": "…ちょっと、復習して\n思い出した方がいいかも\nしれませんね。",
            "zh": "……也许得先复习，\n把内容想起来\n比较好。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "50/TALK",
            "narrator": "透明神楽",
            "text": "ここでつまずくと、\nこれから先でも\n絶対困りますし。",
            "zh": "卡在这里的话，\n以后也\n一定会为难。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "52/TALK",
            "narrator": "透明つばめ",
            "text": "…そうだよね。\nはぁ…。",
            "zh": "……说得也是。\n唉……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "53/TALK",
            "narrator": "透明神楽",
            "text": "…でも、失礼ですけど\nつばめさん。",
            "zh": "……不过，失礼了，\n燕。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "54/TALK",
            "narrator": "透明神楽",
            "text": "よくそれで、高校受験\n乗り切れましたね？",
            "zh": "就这样，高中入学考试\n你是怎么挺过来的？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "55/TALK",
            "narrator": "透明つばめ",
            "text": "うん…勉強もしたけど、\n運も強いのかも…。",
            "zh": "嗯……也学了，\n也许运气也很好……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "58/TALK",
            "narrator": "透明つばめ",
            "text": "やっぱり、\nほとんど独学で\n受験は無謀だったかな？",
            "zh": "果然，\n几乎全靠自学\n去考试，太莽撞了吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "59/TALK",
            "narrator": "透明神楽",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "61/TALK",
            "narrator": "透明つばめ",
            "text": "私…中学時代は\nずっと入院してたから…。",
            "zh": "我……中学的时候\n一直在住院……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "62/TALK",
            "narrator": "透明つばめ",
            "text": "学校に行けない間、\nずっと病院のベッドで\n勉強してたの。",
            "zh": "没法去学校的那段时间，\n一直在医院的床上\n学习。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "63/TALK",
            "narrator": "透明つばめ",
            "text": "みんなに勉強、\n置いていかれるの\n嫌だったから…。",
            "zh": "我不想\n被大家\n在学习上落下……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "65/TALK",
            "narrator": "透明神楽",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "66/TALK",
            "narrator": "透明つばめ",
            "text": "でも、やっぱり学校で\n先生に教わらないと、\n身に付かないよね。",
            "zh": "可是，果然不在学校里\n让老师教的话，\n就是学不会吧。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "67/TALK",
            "narrator": "透明つばめ",
            "text": "参考書とか読んでも、\nわからない問題は\nわからないままだったし。",
            "zh": "参考书看了，\n不懂的题\n还是不懂。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "68/TALK",
            "narrator": "透明神楽",
            "text": "…そうだったんですか。",
            "zh": "……是这样啊。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "69/TALK",
            "narrator": "透明つばめ",
            "text": "あ、あはは、言い訳だね。\nわたしがバカなのは\n事実なんだし…。",
            "zh": "啊、啊哈哈，找借口了。\n我笨是\n事实……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "70/TALK",
            "narrator": "透明神楽",
            "text": "…本当にバカな人は、\nみんなに置いていかれるの\n嫌がったり…。",
            "zh": "……真正笨的人，\n不会讨厌\n被大家落下……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "71/TALK",
            "narrator": "透明神楽",
            "text": "独学で勉強しようなんて\n思いませんよ。",
            "zh": "也不会想着\n自学。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "72/TALK",
            "narrator": "透明つばめ",
            "text": "そ、そうかなぁ？",
            "zh": "是、是吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "73/TALK",
            "narrator": "透明神楽",
            "text": "そうですよ。",
            "zh": "是的。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "74/TALK",
            "narrator": "透明神楽",
            "text": "つばめさんは、\n教えてくれる人が\nいなかったから…。",
            "zh": "燕是因为\n没有人教\n她……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "75/TALK",
            "narrator": "透明神楽",
            "text": "解き方をちゃんと\n理解できなかった\nだけです。",
            "zh": "才没能好好\n理解\n解法。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "77/TALK",
            "narrator": "透明神楽",
            "text": "だから、わらないところは\n私が全部教えます！",
            "zh": "所以，不会的地方\n我全部教你！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "78/TALK",
            "narrator": "透明つばめ",
            "text": "で、でも、神楽ちゃんに\n迷惑だし…。",
            "zh": "可、可是，会给神乐\n添麻烦……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "79/TALK",
            "narrator": "透明神楽",
            "text": "つばめさんと私の立場が\n逆だったら、迷惑って\n思うんですか？",
            "zh": "要是我和燕\n换个位置，你会觉得\n麻烦吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "80/TALK",
            "narrator": "透明つばめ",
            "text": "そ、そんなこと\nないけど…。",
            "zh": "那、那种事\n不会……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "81/TALK",
            "narrator": "透明神楽",
            "text": "じゃあ、迷惑だなんて\n言わないでください。",
            "zh": "那就别说\n麻烦。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "82/TALK",
            "narrator": "透明神楽",
            "text": "…もちろん、つばめさんが\n嫌だっていうなら、\n無理は言いませんけど。",
            "zh": "……当然，要是燕\n不愿意，\n我也不会勉强。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "83/TALK",
            "narrator": "透明つばめ",
            "text": "…ううん。",
            "zh": "……不会。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "85/TALK",
            "narrator": "透明つばめ",
            "text": "それじゃあ、\nわたしに勉強\n教えてくれる？",
            "zh": "那么，\n能教我\n学习吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "86/TALK",
            "narrator": "透明神楽",
            "text": "もちろんです。",
            "zh": "当然。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "88/TALK",
            "narrator": "透明つばめ",
            "text": "ありがとう、\n神楽ちゃん先生！",
            "zh": "谢谢你，\n神乐老师！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "90/TALK",
            "narrator": "透明神楽",
            "text": "それじゃあ、ちょっと\n復習で中学の問題から\n始めますね。",
            "zh": "那么，就从\n复习中学的题\n开始吧。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "91/TALK",
            "narrator": "透明つばめ",
            "text": "うん…でも、\n小テストまでに\n間に合うかなぁ？",
            "zh": "嗯……可是，\n小测之前\n来得及吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "93/TALK",
            "narrator": "透明神楽",
            "text": "ふふっ…つばめさん。",
            "zh": "呵呵……燕。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "94/TALK",
            "narrator": "透明神楽",
            "text": "教えるからには、\n小テストで満点取れる\nくらい…。",
            "zh": "既然要教，\n就要教到小测\n能拿满分……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "95/TALK",
            "narrator": "透明神楽",
            "text": "きっちり、教えますよ。",
            "zh": "我会好好教的。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "96/TALK",
            "narrator": "透明つばめ",
            "text": "ま、満点！？",
            "zh": "满、满分！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "97/TALK",
            "narrator": "透明神楽",
            "text": "勉強を教える以上、\n悪い点を取らせるわけには\nいきません。",
            "zh": "既然教了，\n就不能让你\n考砸。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "98/TALK",
            "narrator": "透明神楽",
            "text": "今日から放課後は、\n毎日勉強ですよ！",
            "zh": "从今天起，放学后\n每天都要学习哦！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "102/TALK",
            "narrator": "透明つばめ",
            "text": "うわーん！！\nそれはそれで辛いよー！",
            "zh": "呜哇！！\n那样也很辛苦呀！",
            "narrator_zh": "透明燕"
        }
    ]
}
