{
    "dir": "chap28/daydra/dd_ch01_28_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "28105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "それでも地球は丸い＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "即便如此地球仍是圆的＜后篇＞"
    },
    "entry": [
        {
            "location": "462/SCENARIO",
            "narrator": "",
            "text": "それでも地球は丸いから",
            "zh": "因为即便如此地球仍是圆的",
            "narrator_zh": ""
        },
        {
            "location": "486/TALK",
            "narrator": "つばめ",
            "text": "弱気じゃダメだよ。",
            "zh": "我可不能示弱呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "487/TALK",
            "narrator": "つばめ",
            "text": "わたしは\n諦めないって\n決めたんだから。",
            "zh": "因为我已经\n下定决心\n绝不放弃了嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "488/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんに\n生きててもらうこと。",
            "zh": "要让神乐\n好好活下去这件事。",
            "narrator_zh": "燕"
        },
        {
            "location": "489/TALK",
            "narrator": "つばめ",
            "text": "それに神楽ちゃんと\nずっと友達だって\n思ってるんだから。",
            "zh": "还有我觉得，我和神乐\n一直都会是\n好朋友呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "491/TALK",
            "narrator": "つばめ",
            "text": "ねえ神楽ちゃん。",
            "zh": "呐，神乐。",
            "narrator_zh": "燕"
        },
        {
            "location": "493/TALK",
            "narrator": "神楽",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "495/TALK",
            "narrator": "つばめ",
            "text": "変に聞こえるかも\nしれないけど。",
            "zh": "听上去也许\n有点奇怪，",
            "narrator_zh": "燕"
        },
        {
            "location": "496/TALK",
            "narrator": "つばめ",
            "text": "わたしまた\n神楽ちゃんに\n会えてうれしいよ。",
            "zh": "但能再次见到\n神乐，\n我真的很高兴呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "497/TALK",
            "narrator": "神楽",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "498/TALK",
            "narrator": "つばめ",
            "text": "でね。髪飾りのこと\n憶えてる？",
            "zh": "对了呀。发饰的事\n你还记得吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "499/TALK",
            "narrator": "つばめ",
            "text": "わたしこの前\n神楽ちゃんの\n分を買ったの。",
            "zh": "我前阵子\n把神乐的那份\n买下来了哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "500/TALK",
            "narrator": "つばめ",
            "text": "自分の分はまだ\n買ってないんだ。",
            "zh": "我自己的那份\n还没买呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "501/TALK",
            "narrator": "つばめ",
            "text": "だって神楽ちゃんが\n買ってくれるって\n言ってくれたから。",
            "zh": "因为神乐\n之前说过\n要买给我的嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "502/TALK",
            "narrator": "つばめ",
            "text": "ここを出たら\nまたあのお店に\n行ってみようよ。",
            "zh": "等从这里出去后，\n我们再去那家店\n看看吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "503/TALK",
            "narrator": "つばめ",
            "text": "もしかしたら\nもう売り切れてるかも\nしれないけど……。",
            "zh": "虽然说不定\n已经卖光了\n就是了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "504/TALK",
            "narrator": "神楽",
            "text": "……何で？",
            "zh": "……为什么？",
            "narrator_zh": "神乐"
        },
        {
            "location": "505/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "哎？",
            "narrator_zh": "燕"
        },
        {
            "location": "508/TALK",
            "narrator": "神楽",
            "text": "……何でそんなこと\n言えるんですか？",
            "zh": "……为什么你能说出\n这种话？",
            "narrator_zh": "神乐"
        },
        {
            "location": "509/TALK",
            "narrator": "神楽",
            "text": "なんで友達みたいに\n話すんですか？",
            "zh": "为什么要像朋友一样\n跟我说话？",
            "narrator_zh": "神乐"
        },
        {
            "location": "510/TALK",
            "narrator": "つばめ",
            "text": "だって……\n友達だから……。",
            "zh": "因为……\n我们是朋友嘛……。",
            "narrator_zh": "燕"
        },
        {
            "location": "511/TALK",
            "narrator": "神楽",
            "text": "私はあなたを\n殺そうとしたんですよ？",
            "zh": "我可是曾经\n想要杀了你的哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "512/TALK",
            "narrator": "神楽",
            "text": "そんな人間を\nなんで友達って\n言えるんですか？",
            "zh": "那样的人，\n你为什么还能\n说是朋友？",
            "narrator_zh": "神乐"
        },
        {
            "location": "514/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんのこと\n好きだからだよ。",
            "zh": "因为我喜欢\n神乐呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "515/TALK",
            "narrator": "つばめ",
            "text": "だから――",
            "zh": "所以——",
            "narrator_zh": "燕"
        },
        {
            "location": "516/TALK",
            "narrator": "神楽",
            "text": "なんでそんな嘘を\nつくんですか！",
            "zh": "为什么要撒\n这种谎！",
            "narrator_zh": "神乐"
        },
        {
            "location": "518/TALK",
            "narrator": "神楽",
            "text": "好きだから？\n友達だから？\nそんなわけないでしょう？",
            "zh": "因为喜欢？\n因为是朋友？\n怎么可能有那种事？",
            "narrator_zh": "神乐"
        },
        {
            "location": "519/TALK",
            "narrator": "神楽",
            "text": "あなたは人に\n嫌われるのが\n怖いだけ。",
            "zh": "你只是\n害怕被别人\n讨厌罢了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "520/TALK",
            "narrator": "神楽",
            "text": "私だけじゃなくて\n会った人全員に\n嫌われたくないだけ。",
            "zh": "不只是对我，\n对所有见过面的人，\n都只是不想被讨厌罢了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "521/TALK",
            "narrator": "神楽",
            "text": "そんな人に\n友達だなんて\n言われても。",
            "zh": "被那样的人\n口口声声叫做\n朋友。",
            "narrator_zh": "神乐"
        },
        {
            "location": "522/TALK",
            "narrator": "神楽",
            "text": "信用なんて\nできるわけ\nありません。",
            "zh": "叫我怎么可能\n相信得起来\n啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "524/TALK",
            "narrator": "つばめ",
            "text": "……神楽ちゃん。",
            "zh": "……神乐。",
            "narrator_zh": "燕"
        },
        {
            "location": "525/TALK",
            "narrator": "つばめ",
            "text": "わたし確かに\n嫌われるのは\nイヤだし怖いよ。",
            "zh": "我确实\n很讨厌也很害怕\n被人讨厌呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "526/TALK",
            "narrator": "つばめ",
            "text": "みんなにも色々\n言われたりもしたよ。",
            "zh": "大家以前也\n说过我不少回呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "527/TALK",
            "narrator": "つばめ",
            "text": "だけど神楽ちゃんが\nいなくなったら\nとても悲しいのは本当。",
            "zh": "可是，要是神乐\n不在了，我会很难过，\n这一点是真的。",
            "narrator_zh": "燕"
        },
        {
            "location": "528/TALK",
            "narrator": "つばめ",
            "text": "それが自分のためって\nいうことなのかも\nしれないけど。",
            "zh": "虽说这也许\n只是为了\n我自己着想，",
            "narrator_zh": "燕"
        },
        {
            "location": "529/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんが痛かったり\n悲しかったりしたら\nわたしも痛くて悲しい。",
            "zh": "但只要神乐疼了\n或是难过了，\n我也会疼、也会难过。",
            "narrator_zh": "燕"
        },
        {
            "location": "530/TALK",
            "narrator": "つばめ",
            "text": "悲しいんだよ……。",
            "zh": "真的会很难过的呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "531/SEL",
            "narrator": "",
            "text": "$me$もつばめには悲しい思いしてほしくない",
            "zh": "$me$也不想让燕这么难过",
            "narrator_zh": ""
        },
        {
            "location": "532/SEL",
            "narrator": "",
            "text": "そんな顔しないで",
            "zh": "别露出那种表情嘛",
            "narrator_zh": ""
        },
        {
            "location": "533/SEL",
            "narrator": "",
            "text": "それが友達だよ",
            "zh": "这就是朋友呀",
            "narrator_zh": ""
        },
        {
            "location": "534/SEL",
            "narrator": "",
            "text": "百合……",
            "zh": "百合……",
            "narrator_zh": ""
        },
        {
            "location": "535/SEL",
            "narrator": "",
            "text": "卯月だってわかってるよ",
            "zh": "卯月其实也明白的哦",
            "narrator_zh": ""
        },
        {
            "location": "536/ACT",
            "narrator": "",
            "text": "$me$もつばめには悲しい思いしてほしくない",
            "zh": "$me$也不想让燕这么难过",
            "narrator_zh": ""
        },
        {
            "location": "537/ACT",
            "narrator": "",
            "text": "そんな顔しないで",
            "zh": "别露出那种表情嘛",
            "narrator_zh": ""
        },
        {
            "location": "538/ACT",
            "narrator": "",
            "text": "それが友達だよ",
            "zh": "这就是朋友呀",
            "narrator_zh": ""
        },
        {
            "location": "539/ACT",
            "narrator": "",
            "text": "百合……",
            "zh": "百合……",
            "narrator_zh": ""
        },
        {
            "location": "540/ACT",
            "narrator": "",
            "text": "卯月だってわかってるよ",
            "zh": "卯月其实也明白的哦",
            "narrator_zh": ""
        },
        {
            "location": "542/TALK",
            "narrator": "神楽",
            "text": "……あなたって人は……。",
            "zh": "……你这个人真是……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "543/SEL",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "544/SEL",
            "narrator": "",
            "text": "聞こえてないの？",
            "zh": "没听见吗？",
            "narrator_zh": ""
        },
        {
            "location": "545/SEL",
            "narrator": "",
            "text": "$me$はここだよー",
            "zh": "$me$在这里呀——",
            "narrator_zh": ""
        },
        {
            "location": "546/ACT",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "547/ACT",
            "narrator": "",
            "text": "聞こえてないの？",
            "zh": "没听见吗？",
            "narrator_zh": ""
        },
        {
            "location": "548/ACT",
            "narrator": "",
            "text": "$me$はここだよー",
            "zh": "$me$在这里呀——",
            "narrator_zh": ""
        },
        {
            "location": "550/TALK",
            "narrator": "つばめ",
            "text": "…それに…。",
            "zh": "……而且……。",
            "narrator_zh": "燕"
        },
        {
            "location": "551/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんは\nわたしにひどいことが\nしたいわけじゃないよね。",
            "zh": "神乐你\n本来也不是想对我\n做过分的事对吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "552/TALK",
            "narrator": "つばめ",
            "text": "事情があって\nそういうことに\nなっただけだよね。",
            "zh": "只是因为有苦衷，\n才不得不\n变成那样对吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "553/TALK",
            "narrator": "つばめ",
            "text": "だったら！",
            "zh": "既然这样！",
            "narrator_zh": "燕"
        },
        {
            "location": "554/TALK",
            "narrator": "つばめ",
            "text": "そんなこと言い出した人\nやっつけようよ。",
            "zh": "我们就把说出那种话的人\n打倒吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "556/TALK",
            "narrator": "神楽",
            "text": "え？",
            "zh": "哎？",
            "narrator_zh": "神乐"
        },
        {
            "location": "557/TALK",
            "narrator": "つばめ",
            "text": "わたしと神楽ちゃんで\nやっつけちゃおうよ。\n悪い人を。",
            "zh": "我和神乐两个人一起\n把那个坏人\n打倒吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "558/TALK",
            "narrator": "神楽",
            "text": "悪い人、って……。",
            "zh": "坏人，是指……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "559/TALK",
            "narrator": "つばめ",
            "text": "それが終わったら\nまず髪飾りを\n買いに行って。",
            "zh": "等那件事结束了，\n我们先去买\n那个发饰。",
            "narrator_zh": "燕"
        },
        {
            "location": "560/TALK",
            "narrator": "つばめ",
            "text": "髪飾りつけて\nアキバに行こう。",
            "zh": "然后戴着发饰\n去秋叶原玩吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "562/TALK",
            "narrator": "つばめ",
            "text": "あっ、薄い本のお店は\nちょっと\n遠慮したいけど…。",
            "zh": "啊，卖同人志的店\n我稍微有点\n不好意思去就是了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "563/TALK",
            "narrator": "神楽",
            "text": "あはは。\nなんですか、もう。",
            "zh": "啊哈哈。\n这是什么话呀，真是的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "564/TALK",
            "narrator": "つばめ",
            "text": "え、えへ？",
            "zh": "哎、诶嘿？",
            "narrator_zh": "燕"
        },
        {
            "location": "566/TALK",
            "narrator": "神楽",
            "text": "あーもう。",
            "zh": "啊——真是的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "567/TALK",
            "narrator": "神楽",
            "text": "つばめさんと\n一緒にいると。",
            "zh": "一跟燕\n待在一起，",
            "narrator_zh": "神乐"
        },
        {
            "location": "569/TALK",
            "narrator": "神楽",
            "text": "なんだか世界がとっても\nくだらないものだって\n思えてきます。",
            "zh": "就总觉得这个世界\n似乎是个非常\n无聊的东西了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "570/TALK",
            "narrator": "つばめ",
            "text": "えっ！？\nくだらなくなんて\nないよ！？",
            "zh": "哎！？\n才不无聊\n呀！？",
            "narrator_zh": "燕"
        },
        {
            "location": "571/TALK",
            "narrator": "神楽",
            "text": "本当、そういうとこ。",
            "zh": "真是的，就是你这一点。",
            "narrator_zh": "神乐"
        },
        {
            "location": "572/TALK",
            "narrator": "つばめ",
            "text": "真面目な話してたのに？",
            "zh": "明明刚才还在说正经事呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "574/TALK",
            "narrator": "神楽",
            "text": "そうです。\n真面目にくだらないと\n言っています。",
            "zh": "是啊。\n我是在很正经地说\n它很无聊哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "575/TALK",
            "narrator": "つばめ",
            "text": "何言ってるか\nわかんないよー！",
            "zh": "完全听不懂\n你在说什么呀——！",
            "narrator_zh": "燕"
        },
        {
            "location": "576/SEL",
            "narrator": "",
            "text": "$me$もつばめと話したいよ",
            "zh": "$me$也想和燕说话呀",
            "narrator_zh": ""
        },
        {
            "location": "577/SEL",
            "narrator": "",
            "text": "もしもーし",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "578/SEL",
            "narrator": "",
            "text": "つながらない！？",
            "zh": "连不上吗！？",
            "narrator_zh": ""
        },
        {
            "location": "579/ACT",
            "narrator": "",
            "text": "$me$もつばめと話したいよ",
            "zh": "$me$也想和燕说话呀",
            "narrator_zh": ""
        },
        {
            "location": "580/ACT",
            "narrator": "",
            "text": "もしもーし",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "581/ACT",
            "narrator": "",
            "text": "つながらない！？",
            "zh": "连不上吗！？",
            "narrator_zh": ""
        },
        {
            "location": "583/TALK",
            "narrator": "つばめ",
            "text": "でも、普通に話せる\nようになったし。",
            "zh": "不过，能像这样\n正常聊天了。",
            "narrator_zh": "燕"
        },
        {
            "location": "584/TALK",
            "narrator": "つばめ",
            "text": "仲直り、できたよね？",
            "zh": "我们算和好了吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "585/TALK",
            "narrator": "つばめ",
            "text": "よかった…。",
            "zh": "太好了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "586/SEL",
            "narrator": "",
            "text": "スマホ見て！",
            "zh": "看手机呀！",
            "narrator_zh": ""
        },
        {
            "location": "587/SEL",
            "narrator": "",
            "text": "つながってないの？？？",
            "zh": "没有连上吗？？？",
            "narrator_zh": ""
