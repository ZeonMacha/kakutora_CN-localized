            "narrator_zh": ""
        },
        {
            "location": "172/DIALOG",
            "narrator": "",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
