            "narrator_zh": "高中生绫水"
        },
        {
            "location": "295/TALK",
            "narrator": "高校生アーヤ",
            "text": "$handle$$yobi$は\n即刻この場から\n出ていって！",
            "zh": "$handle$$yobi$，\n请你立刻从这里\n出去！",
            "narrator_zh": "高中生绫水"
