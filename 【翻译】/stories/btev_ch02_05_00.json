        {
            "location": "184/ACT",
            "narrator": "",
            "text": "$me$には素晴らしいこと",
            "zh": "对$me$来说可是天大的好事",
            "narrator_zh": ""
        },
        {
            "location": "186/TALK",
            "narrator": "高校生アーヤ",
            "text": "そう…なの？\nわかりました。",
            "zh": "是……这样吗？\n明白了。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "高校生アーヤ",
            "text": "なら、それは\n約束する。\nだから――",
            "zh": "既然如此，这件事\n我答应你。\n所以——",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "188/TALK",
            "narrator": "高校生アーヤ",
            "text": "國政綾水の心中の\n空気の乱れを\n共に正してください！",
            "zh": "请和我一起整顿\n国政绫水心中的\n紊乱风气吧！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "189/ACT",
            "narrator": "",
            "text": "お金ください",
            "zh": "请给我钱",
            "narrator_zh": ""
        },
        {
            "location": "197/TALK",
            "narrator": "高校生アーヤ",
            "text": "そう。\nならば私の方から\nお断りします。",
            "zh": "是吗。\n那我这边\n就谢绝了。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "198/TALK",
            "narrator": "高校生アーヤ",
            "text": "私が心に入れる存在\nだから、貴方のこと\n期待していたんだけど。",
            "zh": "正因为你是能进入我\n心灵的存在，我原本\n还挺期待你的。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "199/TALK",
            "narrator": "高校生アーヤ",
            "text": "私も落ちるところまで\n落ちてしまったのね…。",
            "zh": "看来连我自己\n也堕落到这种地步了呢……。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "200/TALK",
            "narrator": "高校生アーヤ",
            "text": "今すぐ出ていって！",
            "zh": "请你立刻出去！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "214/TALK",
            "narrator": "千羽鶴",
            "text": "あなた……\n心の中でお金を\n請求してどうするの？",
            "zh": "你呀……\n在别人心里开口要钱\n像什么样子？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "215/SEL",
            "narrator": "（選択肢）",
            "text": "さあ……",
            "zh": "也是……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "216/ACT",
            "narrator": "",
            "text": "さあ……",
            "zh": "也是……",
            "narrator_zh": ""
        },
        {
            "location": "218/TALK",
            "narrator": "千羽鶴",
            "text": "もう少し考えて\n行動したらどう？",
            "zh": "多少动动脑子\n再行动怎么样？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "219/TALK",
            "narrator": "千羽鶴",
            "text": "一応これでも私は\n貴方に期待してる。",
            "zh": "好歹我这样\n也是对你抱有期待的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "220/TALK",
            "narrator": "千羽鶴",
            "text": "あまり変な事して\n私をびっくり\nさせないでね。",
            "zh": "别总做些奇怪的事\n害我\n吓一跳。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "232/ACT",
            "narrator": "",
            "text": "やっぱ見返りはいらない",
            "zh": "还是不用回报了",
            "narrator_zh": ""
        },
        {
            "location": "239/TALK",
            "narrator": "高校生アーヤ",
            "text": "考え直して\nくれたんですね。\nありがとうございます。",
            "zh": "你肯回心转意了\n啊。\n非常感谢。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "240/TALK",
            "narrator": "高校生アーヤ",
            "text": "國政綾水の心中の\n空気の乱れを\n共に正しましょう！",
            "zh": "让我们一起整顿\n国政绫水心中的\n紊乱风气吧！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "254/TALK",
            "narrator": "潜在アーヤ",
            "text": "え！？\nちょっと……なに？\n高校の頃の私！？",
            "zh": "诶！？\n等一下……什么？\n高中时候的我！？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "257/TALK",
            "narrator": "高校生アーヤ",
            "text": "問答無用です！\n堕落しきった私を\n叩きつぶします！",
            "zh": "废话少说！\n我要把彻底堕落的我\n碾得粉碎！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "258/TALK",
            "narrator": "潜在アーヤ",
            "text": "な、何よ問答無用って！\n全然意味が\nわからないんだけど！",
            "zh": "什、什么叫废话少说啊！\n完全搞不懂\n你在说什么！",
            "narrator_zh": "潜在绫水"
