            "text": "返り討ちに\nしてあげる！",
            "zh": "我会把你们\n打得落花流水！",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "278/ACT",
            "narrator": "",
            "text": "ちょっと待って！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "280/TALK",
            "narrator": "高校生アーヤ",
            "text": "何なの！？",
            "zh": "怎么了！？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "281/SEL",
            "narrator": "（選択肢）",
            "text": "やっぱり協力するのやめます",
            "zh": "我还是不帮忙了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "282/SEL",
