            "narrator": "（選択肢）",
            "text": "だめですか？",
            "zh": "不行吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "179/ACT",
            "narrator": "",
            "text": "だめですか？",
            "zh": "不行吗？",
            "narrator_zh": ""
        },
        {
            "location": "181/TALK",
            "narrator": "高校生アーヤ",
            "text": "い、いえ。\nダメじゃないけど。",
            "zh": "不、不是。\n倒也不是不行。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "182/TALK",
            "narrator": "高校生アーヤ",
            "text": "私なんかとデートしても\n何もいいことなんて\nないわよ……？",
            "zh": "和我这种人约会，\n也不会有什么\n好事的哦……？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "183/SEL",
            "narrator": "（選択肢）",
            "text": "$me$には素晴らしいこと",
