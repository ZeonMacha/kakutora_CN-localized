        },
        {
            "location": "13/DIALOG",
            "narrator": "",
            "text": "<size=40>KOKORO-Lv. 02</size>\nAYAMI - KUNIMASA\n\n<size=45>ＪＫＡクーデター</size>\n<size=35>～過去からの反乱～</size>",
            "zh": "<size=40>KOKORO-Lv. 02</size>\n国政绫水\n\n<size=45>JKA政变</size>\n<size=35>～来自过去的反叛～</size>",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "高校生アーヤ",
            "text": "こんにちは。",
            "zh": "你好。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "24/SEL",
            "narrator": "（選択肢）",
            "text": "君は？",
            "zh": "你是？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "25/SEL",
            "narrator": "（選択肢）",
            "text": "高校時代のアーヤ？",
            "zh": "高中时代的绫水？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "26/ACT",
            "narrator": "",
            "text": "君は？",
            "zh": "你是？",
            "narrator_zh": ""
        },
        {
            "location": "27/TALK",
            "narrator": "高校生アーヤ",
            "text": "國政綾水。\n高校３年です。",
            "zh": "国政绫水。\n高中三年级。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "28/SEL",
            "narrator": "（選択肢）",
            "text": "回想か何かかな？",
            "zh": "是回忆之类的吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "29/SEL",
            "narrator": "（選択肢）",
            "text": "ちょｗｗ年サバ読みすぎてかわいい",
            "zh": "喂哈哈 虚报年龄也太可爱了吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "30/ACT",
            "narrator": "",
            "text": "回想か何かかな？",
            "zh": "是回忆之类的吗？",
            "narrator_zh": ""
        },
        {
            "location": "31/TALK",
            "narrator": "高校生アーヤ",
            "text": "その解釈でも\n問題ないかな。",
            "zh": "这么理解也\n没什么问题吧。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "高校生アーヤ",
            "text": "厳密には、過去から\n一貫して持っている\n信念。",
            "zh": "严格来说，是我从过去\n一路贯彻至今的\n信念。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "33/ACT",
            "narrator": "",
            "text": "ちょｗｗ年サバ読みすぎてかわいい",
            "zh": "喂哈哈 虚报年龄也太可爱了吧",
            "narrator_zh": ""
        },
        {
            "location": "39/DIALOG",
            "narrator": "",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": ""
        },
        {
            "location": "43/TALK",
            "narrator": "高校生アーヤ",
            "text": "サバ読んでるわけじゃ\nありませんっ！",
            "zh": "我才没有在\n虚报年龄！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "高校生アーヤ",
            "text": "私はココロの中では\n永遠の１７歳なの！",
            "zh": "我在心里可是\n永远的17岁！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "45/SEL",
            "narrator": "（選択肢）",
            "text": "アーヤさんマジメカワイイ！",
            "zh": "绫水认真起来好可爱！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "46/SEL",
            "narrator": "（選択肢）",
            "text": "どんびき！",
            "zh": "彻底无语！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "47/ACT",
            "narrator": "",
            "text": "アーヤさんマジメカワイイ！",
            "zh": "绫水认真起来好可爱！",
            "narrator_zh": ""
        },
        {
            "location": "53/DIALOG",
            "narrator": "",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": ""
        },
        {
            "location": "57/TALK",
            "narrator": "高校生アーヤ",
            "text": "今はそんなことを\n議論してる場合じゃ\nないのっ！",
            "zh": "现在可不是\n讨论那种事的\n时候！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "58/ACT",
            "narrator": "",
            "text": "どんびき！",
            "zh": "彻底无语！",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "高校生アーヤ",
            "text": "なんで？\n高校生が高校生と言う\nのはモラルに反すると？",
            "zh": "为什么？\n难道高中生自称高中生\n有违道德吗？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "高校生アーヤ",
            "text": "まあいいわ。\n今回はそういう話を\nしたいのではなく。",
            "zh": "算了。\n这次我并不是想\n聊这种事。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "66/ACT",
            "narrator": "",
            "text": "高校時代のアーヤ？",
            "zh": "高中时代的绫水？",
            "narrator_zh": ""
        },
        {
            "location": "67/TALK",
            "narrator": "高校生アーヤ",
            "text": "そう。どうして\nわかったの？",
            "zh": "是的。你是怎么\n看出来的？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "68/SEL",
            "narrator": "（選択肢）",
            "text": "前に回想で見た",
            "zh": "之前在回忆里见过",
            "narrator_zh": "（选项）"
        },
        {
            "location": "69/ACT",
            "narrator": "",
            "text": "前に回想で見た",
            "zh": "之前在回忆里见过",
            "narrator_zh": ""
        },
        {
            "location": "71/TALK",
            "narrator": "高校生アーヤ",
            "text": "そうだったのね。",
            "zh": "原来如此。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "高校生アーヤ",
            "text": "改めまして。\n私は國政綾水。\n高校３年です。",
            "zh": "重新自我介绍一下。\n我是国政绫水。\n高中三年级。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "高校生アーヤ",
            "text": "今回は――",
            "zh": "这次是——",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "高校生アーヤ",
            "text": "……っと。",
            "zh": "……唔。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "77/SEL",
            "narrator": "（選択肢）",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "78/ACT",
            "narrator": "",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": ""
        },
        {
            "location": "83/TALK",
            "narrator": "高校生アーヤ",
            "text": "あっと、ごめんなさい。\n貴方は男性ですか？\n女性ですか？",
            "zh": "啊，抱歉。\n请问你是男性，\n还是女性？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "84/SEL",
            "narrator": "（選択肢）",
            "text": "男です",
            "zh": "是男性",
            "narrator_zh": "（选项）"
        },
        {
            "location": "85/SEL",
            "narrator": "（選択肢）",
            "text": "女です",
            "zh": "是女性",
            "narrator_zh": "（选项）"
        },
        {
            "location": "86/ACT",
            "narrator": "",
            "text": "男です",
            "zh": "是男性",
            "narrator_zh": ""
        },
        {
            "location": "93/ACT",
            "narrator": "",
            "text": "女です",
            "zh": "是女性",
            "narrator_zh": ""
        },
        {
            "location": "102/TALK",
            "narrator": "高校生アーヤ",
            "text": "わかりました。\nそれじゃ、\n$handle$$yobi$で。",
            "zh": "明白了。\n那么，就叫\n$handle$$yobi$吧。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "高校生アーヤ",
            "text": "今回は\n$handle$$yobi$に\n頼みがあって来ました。",
            "zh": "这次我是\n有事想拜托\n$handle$$yobi$才来的。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "高校生アーヤ",
            "text": "単刀直入に\n相談するわ。",
            "zh": "我就开门见山地\n跟你商量了。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "105/TALK",
            "narrator": "高校生アーヤ",
            "text": "私のココロの中に\n堕落した私が\n生息しています。",
            "zh": "在我的心里，\n栖息着一个\n堕落的我。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "106/TALK",
            "narrator": "高校生アーヤ",
            "text": "それを、私と共に\n撲滅して欲しいの。",
            "zh": "我希望你能和我一起\n把她彻底扑灭。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "108/SEL",
            "narrator": "（選択肢）",
            "text": "協力します",
            "zh": "我帮忙",
            "narrator_zh": "（选项）"
        },
        {
            "location": "109/SEL",
            "narrator": "（選択肢）",
            "text": "撲滅！？こわい……",
            "zh": "扑灭！？好可怕……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "112/ACT",
            "narrator": "",
            "text": "協力します",
            "zh": "我帮忙",
            "narrator_zh": ""
        },
        {
            "location": "113/TALK",
            "narrator": "高校生アーヤ",
            "text": "ありがとう。",
            "zh": "谢谢。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "高校生アーヤ",
            "text": "國政綾水の心中の\n空気の乱れを\n共に正しましょう！",
            "zh": "让我们一起整顿\n国政绫水心中的\n紊乱风气吧！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "115/ACT",
            "narrator": "",
            "text": "撲滅！？こわい……",
            "zh": "扑灭！？好可怕……",
            "narrator_zh": ""
        },
        {
            "location": "117/TALK",
            "narrator": "高校生アーヤ",
            "text": "撲滅という言葉が\n怖い？",
            "zh": "扑灭这个词\n很可怕吗？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "118/TALK",
            "narrator": "高校生アーヤ",
            "text": "堕落したココロは\n伝染病や麻薬と\n同じものなの。",
            "zh": "堕落的心\n和传染病、麻药\n是一样的东西。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "119/TALK",
            "narrator": "高校生アーヤ",
            "text": "撲滅という言葉が\nぴったりかと\n思うんですけど。",
            "zh": "我觉得扑灭这个词\n再合适不过了\n啊。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "高校生アーヤ",
            "text": "だから、どうか撲滅に\nご協力お願いします。",
            "zh": "所以，还请务必协助\n完成这次扑灭。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "121/SEL",
            "narrator": "（選択肢）",
            "text": "協力します",
            "zh": "我帮忙",
            "narrator_zh": "（选项）"
        },
        {
            "location": "122/SEL",
            "narrator": "（選択肢）",
            "text": "$me$のメリットは？",
            "zh": "$me$有什么好处？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "123/ACT",
            "narrator": "",
