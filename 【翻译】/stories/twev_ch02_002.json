            "narrator": "",
            "text": "可愛くていいと思うよ",
            "zh": "我觉得可爱挺好的呀",
            "narrator_zh": ""
        },
        {
            "location": "241/TALK",
            "narrator": "アーヤ",
            "text": "恥ずかしいから",
