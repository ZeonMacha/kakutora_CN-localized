            "narrator_zh": "绫水"
        },
        {
            "location": "216/TALK",
            "narrator": "アーヤ",
            "text": "ぐっすり寝たから(￣∇￣)",
            "zh": "睡了个好觉嘛(￣∇￣)",
            "narrator_zh": "绫水"
        },
        {
            "location": "217/TALK",
            "narrator": "アーヤ",
            "text": "完全回復＼(^O^)／",
