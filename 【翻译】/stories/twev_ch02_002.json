        "title": "Twitter Archive 002",
        "sub_title": "卯月画廊：猫のようにねんねしよ？",
        "title_zh": "推特 存档 002",
        "sub_title_zh": "卯月画廊：像猫一样睡觉吧？"
    },
    "entry": [
        {
            "location": "163/TALK",
            "narrator": "透明アーヤ",
            "text": "…この絵、本当に昨日の\n私そっくりよ。",
            "zh": "……这幅画，真跟昨天\n的我一模一样哦。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "165/TALK",
            "narrator": "透明神楽",
            "text": "ふふっ、一昨日からずっと\nお休みなしで頑張って\nましたから。",
            "zh": "呵呵，因为从前天起\n就一直没休息\n在赶工呀。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "166/TALK",
            "narrator": "透明神楽",
            "text": "多分、ベッドに転がったら\nすぐ寝ちゃうと思いながら\n描いたんです。",
            "zh": "我是想着你大概\n一倒在床上\n就睡着了，才画出来的。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "167/TALK",
            "narrator": "透明アーヤ",
            "text": "卯月は、探偵とか\n向いてそうよね？",
            "zh": "卯月你呀，\n挺适合当侦探的吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "透明神楽",
            "text": "外見美少女、\n脳みそドローリ、\n名探偵ぴょんこ！！",
            "zh": "外表美少女，\n脑子融化中，\n名侦探蹦子！！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "171/TALK",
            "narrator": "透明アーヤ",
            "text": "？",
            "zh": "？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "172/TALK",
            "narrator": "透明神楽",
            "text": "いえ、\n気にしないでください。",
            "zh": "没什么，\n请不用在意。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "173/TALK",
            "narrator": "透明神楽",
            "text": "それより、ぐっすりと\n眠れましたか？",
            "zh": "比起这个，\n你睡得香吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "174/TALK",
            "narrator": "透明アーヤ",
            "text": "ええ、おかげさまでね。",
            "zh": "嗯，托你的福。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "176/TALK",
            "narrator": "透明アーヤ",
            "text": "卯月がこの絵と一緒に、\n安らぎの魔法をくれた\nからかもしれないわね。",
            "zh": "也许是卯月连这幅画\n一起，送了我\n安宁的魔法吧。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "177/TALK",
            "narrator": "透明神楽",
            "text": "そう言っていただけると、\n描いてよかった、って\n気持ちになれます。",
            "zh": "能听你这么说我\n就觉得这幅画\n画得真值。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "178/TALK",
            "narrator": "透明神楽",
            "text": "またアーヤさんの絵、\n描いていいですか？",
            "zh": "还可以再画\n绫水小姐的画吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "179/TALK",
            "narrator": "透明アーヤ",
            "text": "ええ、もちろん。\n私も楽しみにしてるわ。",
            "zh": "嗯，当然。\n我也很期待哦。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "181/TALK",
            "narrator": "透明神楽",
            "text": "やったぁ！",
            "zh": "太好了！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "182/TALK",
            "narrator": "透明アーヤ",
            "text": "ふふっ…。",
            "zh": "呵呵……。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "183/SEL",
            "narrator": "（選択肢）",
            "text": "そんなお疲れだったの？",
            "zh": "你那么累吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "184/ACT",
            "narrator": "",
            "text": "そんなお疲れだったの？",
            "zh": "你那么累吗？",
            "narrator_zh": ""
        },
        {
            "location": "189/TALK",
            "narrator": "透明アーヤ",
            "text": "誰からかしら…。",
            "zh": "谁发的呢……。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "ちょっとだけね(;^_^A",
            "zh": "就一点点哦(;^_^A",
            "narrator_zh": "绫水"
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "昨日まで",
            "zh": "到昨天为止",
            "narrator_zh": "绫水"
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "すごく忙しかったの(-ω-;)",
            "zh": "都忙得不行(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "197/SEL",
            "narrator": "（選択肢）",
            "text": "出撃あったの？",
            "zh": "有出击过吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "198/ACT",
            "narrator": "",
            "text": "出撃あったの？",
            "zh": "有出击过吗？",
            "narrator_zh": ""
        },
        {
            "location": "200/TALK",
            "narrator": "アーヤ",
            "text": "省庁向けレジュメ書いたり",
            "zh": "要给省厅写简历",
            "narrator_zh": "绫水"
        },
        {
            "location": "201/TALK",
            "narrator": "アーヤ",
            "text": "バイトやサークルのことやったり",
            "zh": "还要忙打工和社团的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "202/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "203/TALK",
            "narrator": "アーヤ",
            "text": "色々あったの(>_<)",
            "zh": "反正事情一堆(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/SEL",
            "narrator": "（選択肢）",
            "text": "全部やるべきことだよ",
            "zh": "都是该做的事呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "205/SEL",
            "narrator": "（選択肢）",
            "text": "そんなに！？　お疲れさま",
            "zh": "这么多！？辛苦了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "206/ACT",
            "narrator": "",
            "text": "全部やるべきことだよ",
            "zh": "都是该做的事呀",
            "narrator_zh": ""
        },
        {
            "location": "207/TALK",
            "narrator": "アーヤ",
            "text": "そうだけど",
            "zh": "话是这么说",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/TALK",
            "narrator": "アーヤ",
            "text": "省庁向けレジュメは",
            "zh": "可给省厅的简历",
            "narrator_zh": "绫水"
        },
        {
            "location": "209/TALK",
            "narrator": "アーヤ",
            "text": "館長の仕事(￣Д￣ )",
            "zh": "是馆长的工作呀(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "211/TALK",
            "narrator": "アーヤ",
            "text": "人使い荒過ぎるわ(ノД`)",
            "zh": "用人也太狠了吧(ノД`)",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/ACT",
            "narrator": "",
            "text": "そんなに！？　お疲れさま",
            "zh": "这么多！？辛苦了",
            "narrator_zh": ""
        },
        {
            "location": "213/TALK",
