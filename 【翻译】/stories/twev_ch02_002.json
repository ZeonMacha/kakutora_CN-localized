            "narrator_zh": "绫水"
        },
        {
            "location": "219/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "220/TALK",
            "narrator": "アーヤ",
            "text": "卯月のこの絵",
            "zh": "卯月这幅画",
            "narrator_zh": "绫水"
        },
        {
            "location": "221/TALK",
            "narrator": "アーヤ",
            "text": "本当すごい(>_<)",
            "zh": "真的很厉害(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "222/TALK",
            "narrator": "アーヤ",
            "text": "起きた時の格好と",
            "zh": "和醒来时的打扮",
            "narrator_zh": "绫水"
        },
        {
            "location": "223/TALK",
            "narrator": "アーヤ",
            "text": "完全一致＼(◎o◎)／",
            "zh": "完全一致＼(◎o◎)／",
            "narrator_zh": "绫水"
        },
        {
            "location": "224/SEL",
            "narrator": "（選択肢）",
            "text": "無防備すぎる",
            "zh": "太没有防备了吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "225/SEL",
            "narrator": "（選択肢）",
            "text": "枕抱きしめて寝るんだね？",
            "zh": "你是抱着枕头睡的吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "226/ACT",
            "narrator": "",
            "text": "無防備すぎる",
            "zh": "太没有防备了吧",
            "narrator_zh": ""
        },
        {
            "location": "227/TALK",
