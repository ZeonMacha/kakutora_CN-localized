            "text": "自室なんだから",
            "zh": "在自己房间里",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "アーヤ",
            "text": "無防備なのが当然(￣Д￣ )",
            "zh": "没防备是当然的(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "229/TALK",
            "narrator": "アーヤ",
            "text": "でもそう言われると",
            "zh": "可是被你这么一说",
            "narrator_zh": "绫水"
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "なんか",
            "zh": "忽然",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/TALK",
            "narrator": "アーヤ",
            "text": "恥ずかしい(・・。)ゞ",
            "zh": "就害羞起来(・・。)ゞ",
            "narrator_zh": "绫水"
        },
        {
            "location": "233/ACT",
            "narrator": "",
            "text": "枕抱きしめて寝るんだね",
