        },
        {
            "location": "237/SEL",
            "narrator": "（選択肢）",
            "text": "可愛くていいと思うよ",
            "zh": "我觉得可爱挺好的呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "238/SEL",
            "narrator": "（選択肢）",
            "text": "$me$だと思って抱きしめてた？",
            "zh": "是想着$me$才抱的吗？",
            "narrator_zh": "（选项）"
        },
        {
