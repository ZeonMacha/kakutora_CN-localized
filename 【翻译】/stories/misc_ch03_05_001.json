        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "ガブリエラ",
            "text": "きっとわかってくれるわ",
