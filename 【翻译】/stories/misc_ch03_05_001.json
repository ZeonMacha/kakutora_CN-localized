        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "あの子たち元気にしてるかしら？",
            "zh": "那些孩子还好吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "なんてことを私は",
            "zh": "我怎么会",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "マシュマロココアを飲みながら",
            "zh": "喝着棉花糖可可",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "思ったりするのです",
            "zh": "冒出这种念头",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/SEL",
            "narrator": "",
            "text": "あの子たちって？",
            "zh": "那些孩子是？",
            "narrator_zh": ""
        },
        {
            "location": "39/SEL",
            "narrator": "",
            "text": "この時期ココアって汗かかない？",
            "zh": "这个季节喝可可不会出汗吗？",
            "narrator_zh": ""
        },
        {
            "location": "40/SEL",
            "narrator": "",
            "text": "元気だといいよね",
            "zh": "还好就好了呀",
            "narrator_zh": ""
        },
        {
            "location": "41/ACT",
            "narrator": "",
            "text": "あの子たちって？",
            "zh": "那些孩子是？",
            "narrator_zh": ""
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナのお友達よ",
            "zh": "是玛尔赞娜的朋友哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "43/ACT",
            "narrator": "",
            "text": "この時期ココアって汗かかない？",
            "zh": "这个季节喝可可不会出汗吗？",
            "narrator_zh": ""
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあアイスココアにするわ",
            "zh": "那就换成冰可可",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/ACT",
            "narrator": "",
            "text": "元気だといいね",
            "zh": "还好就好了",
            "narrator_zh": ""
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "だったらいいわね",
            "zh": "那样就好",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "ワルシャワに置いてきたマルザンナのお友達のこと",
            "zh": "留在华沙的、玛尔赞娜的朋友们",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "聞きたいかしら？",
            "zh": "想听吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/SEL",
            "narrator": "",
            "text": "ガブが持ってたぬいぐみとか人形のこと？",
            "zh": "是加布以前的玩偶和人偶吗？",
            "narrator_zh": ""
        },
        {
            "location": "63/ACT",
            "narrator": "",
            "text": "ガブが持ってたぬいぐみとか人形のこと？",
            "zh": "是加布以前的玩偶和人偶吗？",
            "narrator_zh": ""
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "そういう言い方になるのね",
            "zh": "会变成那种说法啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナは会ったことないものね",
            "zh": "玛尔赞娜又没见过她们",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "69/TALK",
            "narrator": "ガブリエラ",
            "text": "仕方ないわよね・・・・",
            "zh": "也没办法呢・・・・",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/SEL",
            "narrator": "",
            "text": "なんかごめんね",
            "zh": "总觉得对不起",
            "narrator_zh": ""
        },
        {
            "location": "73/SEL",
            "narrator": "",
            "text": "そうだね…",
            "zh": "是啊…",
            "narrator_zh": ""
        },
        {
            "location": "74/SEL",
            "narrator": "",
            "text": "お友達の話を聞かせてくれる？",
            "zh": "能跟我讲讲朋友的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "75/ACT",
            "narrator": "",
            "text": "なんかごめんね",
            "zh": "总觉得对不起",
            "narrator_zh": ""
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん、構わないのよ？",
            "zh": "没有，没关系的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "突然だったものね・・・？",
            "zh": "因为太突然了嘛・・・？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/ACT",
            "narrator": "",
            "text": "そうだね…",
            "zh": "是啊…",
            "narrator_zh": ""
        },
        {
            "location": "81/TALK",
            "narrator": "ガブリエラ",
            "text": "そうだわよね・・・",
            "zh": "也是呢・・・",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "突然そんなこと言われてもそんな風になっちゃうわよね・・・",
            "zh": "突然被这么一说，也会变成那样吧・・・",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "85/ACT",
            "narrator": "",
            "text": "お友達の話を聞かせてくれる？",
            "zh": "能跟我讲讲朋友的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "聞いてくれるのかしら？",
            "zh": "愿意听吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "96/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナのお友達の話ｖ",
            "zh": "玛尔赞娜的朋友们的事ｖ",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "きっと仲良くなりたいって思うわよ？",
            "zh": "她们肯定会想和你做朋友的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "みんないいこたちばかりだもの！",
            "zh": "因为大家都是好孩子！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "101/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ",
            "zh": "啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "でもね、勘違いしないで？",
            "zh": "不过，可别误会哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "私が今一番大切に思っているのはマルザンナなの",
            "zh": "我现在最珍惜的是玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "あの子たちには悪いと思うけど・・・・",
