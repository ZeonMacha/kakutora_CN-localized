{
    "dir": "chap00/daydra/spev_comike_2018_010.js",
    "type": "",
    "info": {
        "story_id": "91071",
        "cid": "",
        "title": "がすとちゃんサマー大作戦♪",
        "sub_title": "作戦１：ココロの旅チャームへの旅",
        "title_zh": "GUST酱的夏日大作战♪",
        "sub_title_zh": "作战1：通往心之旅挂饰之旅"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "チャーム",
            "zh": "挂饰",
            "narrator_zh": ""
        },
        {
            "location": "18/TALK",
            "narrator": "ガブリエラ",
            "text": "さて、と…。",
            "zh": "好了，那么……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "19/TALK",
            "narrator": "ガブリエラ",
            "text": "今日の仕事は\nこれで終わりかしらね。",
            "zh": "今天的工作\n大概就到此为止了吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "20/TALK",
            "narrator": "ガブリエラ",
            "text": "この劇場は相変わらず\n閑古鳥が鳴いてるけど、\nこのままでいいのかしら？",
            "zh": "这座剧场还是一如既往地\n门可罗雀呢，\n一直这样真的好吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "23/TALK",
            "narrator": "アーヤ",
            "text": "あら、ギャヴィ。",
            "zh": "哎呀，加维。",
            "narrator_zh": "绫水"
        },
        {
            "location": "24/TALK",
            "narrator": "アーヤ",
            "text": "そっちも終わったのね。\n今日もお疲れ様。",
            "zh": "你那边也忙完了呢。\n今天也辛苦了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "あいにくヒマすぎて\n全然疲れていないわよ。",
            "zh": "偏偏闲得要命，\n一点儿都不累呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "27/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤもそうでしょ？",
            "zh": "绫水你不也一样吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "28/TALK",
            "narrator": "アーヤ",
            "text": "…まぁね。",
            "zh": "……算是吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "アーヤ",
            "text": "それはそうと、\nみやびがもうすぐ\nここに来るって。",
            "zh": "先不说这个，\n雅说她很快\n就要过来了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "30/TALK",
            "narrator": "アーヤ",
            "text": "このあいだ話した、\n私たちのチャームが\n出来上がったらしいから。",
            "zh": "前阵子提过的\n我们的挂饰，\n好像已经做好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "もう出来たの？",
            "zh": "已经做好了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "どんなシーンが\n選ばれたのかしら？",
            "zh": "究竟选了\n怎样的场景呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "早く見たいわ。",
            "zh": "好想快点看看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "みやび",
            "text": "お待たー。",
            "zh": "久等啦——。",
            "narrator_zh": "雅"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "お二人さん、\nちょうどいいところに\nお揃いで。",
            "zh": "你们俩，\n正好都在这儿\n凑齐了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんと\n卯月もおるかね？",
            "zh": "燕和\n卯月也在咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "アーヤ",
            "text": "あの二人は非番だから\n今日は居ないわ。",
            "zh": "那两个人今天休班，\n不在这里哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "今ごろデートでも\nしてるんじゃない？",
            "zh": "这会儿说不定正\n在哪里约会吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "なるほど、\nならば仕方なし。",
            "zh": "原来如此，\n那也没办法。",
            "narrator_zh": "雅"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "早速やけど、\n夏の一大イベントで\n大放出されるっちゅう──",
            "zh": "话不多说，\n听说要在夏季大型活动上\n大量推出的——",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "うちらのチャームの\n試作品をお披露目ぞね！",
            "zh": "我们的挂饰\n样品这就公开展示咧！",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "まずはコレや！",
            "zh": "先看这个啵！",
            "narrator_zh": "雅"
        },
        {
            "location": "54/DIALOG",
            "narrator": "",
            "text": "逢瀬つばめ（15）\nロッカーに隠れる",
            "zh": "逢濑燕（15）\n躲进储物柜",
            "narrator_zh": ""
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "あー、このシーン…",
            "zh": "啊——这一幕……",
            "narrator_zh": "绫水"
        },
        {
            "location": "57/TALK",
            "narrator": "ガブリエラ",
            "text": "劇場に強行突入された日に\nつばめが隠れたっていう\nロッカーの場面ね。",
            "zh": "就是剧场遭强行突入那天，\n燕躲进去的那个\n储物柜场景呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "本人はピンチなんだけど、\nこのつばめは確かに\nとっても可愛い♪",
            "zh": "虽然她本人当时很危急，\n不过这样的燕确实\n非常可爱呢♪",
            "narrator_zh": "绫水"
        },
        {
            "location": "59/TALK",
            "narrator": "アーヤ",
            "text": "私が現場で見たら\nお持ち帰りしちゃうかも。",
            "zh": "我要是在现场看到，\n说不定会想打包带回家呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうのは思っても\n口に出さなくていいわよ？",
            "zh": "这种话就算心里想想，\n也不用说出口好吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "聞いてて恥ずかしいから。",
            "zh": "听着好害臊的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "アーヤ",
            "text": "あら、そう？",
            "zh": "哎呀，是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "66/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィも\n同じポーズをしたら\nきっと可愛いと思うわよ？",
            "zh": "加维要是也摆出\n同样的姿势，\n我觉得肯定也很可爱哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "68/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、と…",
            "zh": "诶，那个……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "69/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうことも\n面と向かって\n言わなくていいの！",
            "zh": "这种话也\n不用当着面\n讲出来啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "アーヤ",
            "text": "はいはい。",
            "zh": "好好好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "おっ？",
            "zh": "哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "メロドラマ発生の予感！",
            "zh": "有狗血爱情大戏上演的预感咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "『天才ハッカーは見た！\n静かなる劇場を揺るがす\n三人の女の愛憎劇──』",
            "zh": "『天才黑客目击！\n撼动静谧剧场的\n三个女人爱恨情仇——』",
            "narrator_zh": "雅"
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "劇場三部作で\n映画化決定ぞね。",
            "zh": "决定拍成剧场版三部曲\n搬上银幕咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "飛ばしすぎよ！",
            "zh": "扯得太远了啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "アーヤ",
            "text": "それはいいから、\n他のチャームも\n見せてくれる？",
            "zh": "那个先别管了，\n其他的挂饰也\n拿给我们看看好吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "82/TALK",
            "narrator": "みやび",
            "text": "ほいな。",
            "zh": "来咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "お次はコレや！",
            "zh": "下一个是这个啵！",
            "narrator_zh": "雅"
        },
        {
            "location": "91/DIALOG",
            "narrator": "",
            "text": "國政綾水（21）\n人形劇で上目遣い",
            "zh": "国政绫水（21）\n人偶剧里抬眼仰望",
            "narrator_zh": ""
        },
        {
            "location": "93/TALK",
            "narrator": "アーヤ",
            "text": "わぁっ！",
            "zh": "哇啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "これはアレね、\nアーヤが秘密にしてた\n人形劇のシーンでしょ。",
            "zh": "这就是那个吧，\n绫水一直瞒着大家的\n人偶剧那一幕对吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "アーヤ",
            "text": "隠しているつもりは\nなかったけど…",
            "zh": "我倒没打算\n刻意隐瞒……",
            "narrator_zh": "绫水"
        },
        {
            "location": "96/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィに\n尾行されたから\nバレちゃったわね。",
            "zh": "结果被加维\n跟踪了一路，\n还是暴露了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "あれは尾行じゃないわよ。",
            "zh": "那才不是跟踪呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤがひとりで\nどこに行ってるのか\n心配になっただけだから。",
            "zh": "我只是担心绫水\n一个人跑去哪里了\n而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "人聞きの悪いこと\n言わないでくれるかしら。",
            "zh": "能别说得\n这么难听吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "でも、おかげで\nギャヴィにも人形劇を\n手伝ってもらえて──",
            "zh": "不过，托那个的福，\n加维也帮了我\n一起演人偶剧——",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "とっても嬉しかったわ。",
            "zh": "我真的很开心哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "今もたまに\n付き合ってくれて\nありがとうね？",
            "zh": "现在也时不时\n肯陪着我，\n谢谢你啦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "…まぁ、私も\n嫌いじゃないから\n別にいいけど。",
            "zh": "……嘛，其实我\n也不讨厌，\n倒也无所谓就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "アーヤはまっこと\n母性の塊やねぇ。",
            "zh": "绫水真是浑身上下\n满满都是母性咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "チャームの上目遣いも\n破壊力バツグンや。",
            "zh": "挂饰上这抬眼仰望的眼神\n杀伤力也绝了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "アーヤ",
            "text": "それはちょっと\n自分で見ると\n恥ずかしいかな…。",
            "zh": "这个嘛，\n自己看着还是\n有点害羞吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "113/TALK",
            "narrator": "アーヤ",
            "text": "ねぇ、ギャヴィの\nチャームもあるんでしょ？",
            "zh": "呐，加维的\n挂饰也有对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "アーヤ",
            "text": "それも見たいわ。",
            "zh": "我也想看看那个。",
            "narrator_zh": "绫水"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "ほいさ！",
            "zh": "来咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "123/DIALOG",
            "narrator": "",
            "text": "ガブちゃん（14）\nTuTu！ PaPa！",
            "zh": "加布（14）\nTuTu！ PaPa！",
            "narrator_zh": ""
        },
        {
            "location": "125/TALK",
            "narrator": "みやび",
            "text": "ジャジャーン！",
            "zh": "锵锵——！",
            "narrator_zh": "雅"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "まぁっ！",
            "zh": "哎呀！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "アーヤ",
            "text": "これはギャヴィが\n歌っているシーンね。",
            "zh": "这是加维\n唱歌的那一幕呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "アーヤ",
            "text": "大半がポーランド語だから\nすぐには分からなかった\nけど──",
            "zh": "因为大半是波兰语，\n一开始还没太听懂，\n不过——",
            "narrator_zh": "绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "アーヤ",
            "text": "歌詞も振り付けも\nとっても可愛かったわ。",
            "zh": "歌词和舞步\n都非常可爱呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "131/TALK",
            "narrator": "ガブリエラ",
            "text": "…そう。",
            "zh": "……是吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと。",
            "zh": "谢了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "この二人は事あるごとに\nイチャついてくれよる…。",
            "zh": "这两个人动不动就\n在这腻歪起来咧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "うちも心細いから\n$handle$でも\n呼んで対抗しようかね。",
            "zh": "我孤单得很，\n干脆把$handle$\n叫来跟你们较劲咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "まぁ、ガブちゃんのMVは\n$handle$たちの\n世界で大人気のようやき。",
            "zh": "不过嘛，加布的MV\n在$handle$他们的\n世界好像人气高得很啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "このシーンが選ばれるんも\n必然やったのかもな。",
            "zh": "会选上这一幕，\n说不定也是必然的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "好評なら嬉しいわ。",
            "zh": "风评好的话我就开心了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "141/TALK",
            "narrator": "ガブリエラ",
            "text": "本当は、\n$handle$との\n思い出のシーンとか──",
            "zh": "其实呢，\n像是和$handle$\n一起回忆的场景之类的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうのが選ばれても\nあたしは嬉しかったけど。",
            "zh": "要是能选上那种，\n我也会很高兴就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "チャームを見るたびに\nあたしのことを思って\nもらえたら何よりだわ。",
            "zh": "只要每当看到挂饰时\n能想起我，\n那就再好不过了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "144/TALK",
            "narrator": "アーヤ",
            "text": "うふふ。",
            "zh": "唔呵呵。",
            "narrator_zh": "绫水"
        },
        {
            "location": "148/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィは\nそういうところが\nけっこう素直よね。",
            "zh": "加维在\n这种地方\n还挺坦率的呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "149/TALK",
            "narrator": "ガブリエラ",
            "text": "何よ！",
            "zh": "干嘛啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "150/TALK",
            "narrator": "ガブリエラ",
            "text": "チャームって\nそういうものでしょ？",
            "zh": "挂饰本来不就是\n用来干这个的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "151/TALK",
            "narrator": "みやび",
            "text": "うむ。",
            "zh": "嗯哼。",
            "narrator_zh": "雅"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "それを言うと、\nうちのチャームは\nまさに思い出ぞね。",
            "zh": "要这么说的话，\n我的挂饰\n可真是实打实的回忆咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "160/DIALOG",
            "narrator": "",
            "text": "恋ヶ崎 みやび（？）\nなごちゃんと一緒",
            "zh": "恋之崎 雅（？）\n和七五在一起",
            "narrator_zh": ""
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "コレなんやが。",
            "zh": "就是这个啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "これは子供のころの\nみやびかしら？",
            "zh": "这是小时候的\n雅吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "164/TALK",
            "narrator": "アーヤ",
            "text": "みやびと一緒にいるのは\nもしかして…？",
            "zh": "和雅在一起的\n该不会是……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "165/TALK",
            "narrator": "みやび",
            "text": "うちの妹の、\nなごちゃんや。",
            "zh": "是我妹妹，\n七五咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "166/TALK",
            "narrator": "みやび",
            "text": "そういえば、\nなごちゃんの写真を\n見せたことは無かったね。",
            "zh": "说起来，\n我好像还没给你们\n看过七五的照片啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "これがうちの妹や。\nまっこと可愛えろう？",
            "zh": "这就是我妹妹咯。\n生得蛮可爱啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "168/TALK",
            "narrator": "アーヤ",
            "text": "可愛い！",
            "zh": "好可爱！",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "ガブリエラ",
            "text": "確かに。\nお人形さんみたいね。",
            "zh": "确实呢。\n跟洋娃娃似的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "170/TALK",
            "narrator": "みやび",
            "text": "それな。",
            "zh": "可不是嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "171/TALK",
            "narrator": "みやび",
            "text": "このシーンは確か…",
            "zh": "这一幕我记得是……",
            "narrator_zh": "雅"
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "なごちゃんに絵本を\n読み聞かせちょった時──",
            "zh": "在给七五\n念绘本的时候——",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "出てきた青ペンギンが\nあんまりにも気の抜けた\n顔をしちょったもんでな。",
            "zh": "里头出来的蓝企鹅\n长得实在是一副\n呆头呆脑的表情咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "みやび",
            "text": "うちのツボにハマって\n笑いが止まらんかったら\nなごちゃんに怒られた。",
            "zh": "一下戳中我笑点，\n笑得停不下来，\n结果被七五训了一顿咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "みや、ちゃんと読みや！\n…ってな。",
            "zh": "小雅，好好念呀！\n……她就这么说。",
            "narrator_zh": "雅"
        },
        {
            "location": "176/TALK",
            "narrator": "ガブリエラ",
            "text": "妹に怒られる姉…。",
            "zh": "被妹妹训斥的姐姐……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "177/TALK",
            "narrator": "アーヤ",
            "text": "なんか、\nしっかりした\n妹さんみたいね。",
            "zh": "总觉得，\n像是位很可靠的\n妹妹呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "178/TALK",
            "narrator": "みやび",
            "text": "そうやよ？",
            "zh": "就是咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "179/TALK",
            "narrator": "みやび",
            "text": "チャームのなごちゃんは\n８歳くらいの頃やけど…",
            "zh": "挂饰上的七五\n大概才8岁左右啵……",
            "narrator_zh": "雅"
        },
        {
            "location": "180/TALK",
            "narrator": "みやび",
            "text": "今また会えたら\n凛とした美少女に\n成長しているはずや！",
            "zh": "现在要是还能见上面，\n肯定已经长成\n英气又漂亮的美少女咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "181/TALK",
            "narrator": "みやび",
            "text": "…まぁ、\nまた会えたらの\n話やけどな。",
            "zh": "……嘛，\n那也得是还能再见面\n才说得上的话咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "182/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "183/TALK",
            "narrator": "ガブリエラ",
            "text": "…えっと…。",
            "zh": "……那个……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "みやび",
            "text": "おおっと。すまぬ、\n余計なことを言った。",
            "zh": "哎呀。没好意思，\n说了多余的话。",
            "narrator_zh": "雅"
        },
        {
            "location": "185/TALK",
            "narrator": "みやび",
            "text": "確かにセンチメンタルな\n思い出やけど、こうして\n形になるんは嬉しいよ。",
            "zh": "虽然确实是段\n感伤的回忆，不过能像这样\n做成实物还是蛮开心的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "190/TALK",
            "narrator": "みやび",
            "text": "他にもたくさんのシーンが\nチャームの候補として\n挙がったらしくてな？",
            "zh": "听说还有好多别的场景\n也进了挂饰的\n候选名单咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "191/TALK",
            "narrator": "みやび",
            "text": "うちらのことを\n想うてくれちょる相棒には\nまっこと心から感謝ぞね。",
            "zh": "对一直惦记着我们的搭档，\n我真是打从心底\n感激咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "そうね。",
            "zh": "是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしも同じ。",
            "zh": "我也是。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "それと、\n神楽のチャームは\nどうだったの？",
            "zh": "话说回来，\n神乐的挂饰\n怎么样了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/TALK",
            "narrator": "みやび",
            "text": "うむ、それがな…。",
            "zh": "嗯，那个嘛……。",
            "narrator_zh": "雅"
        },
        {
            "location": "198/TALK",
            "narrator": "みやび",
            "text": "本人が居たら\n聞こうと思ったんやが──",
            "zh": "本来想等她人在的时候\n当面问她的——",
            "narrator_zh": "雅"
        },
        {
            "location": "199/TALK",
            "narrator": "みやび",
            "text": "隊員服を着て\nこんなことを言いよる\n場面なんぞあったかいな？",
            "zh": "穿着队员服\n说这种话的场景，\n以前有过咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "206/DIALOG",
            "narrator": "",
            "text": "一方その頃、\nココロゲートでは──",
            "zh": "与此同时，\n在心之扉中——",
            "narrator_zh": ""
        },
        {
            "location": "243/TALK",
            "narrator": "百鶴",
            "text": "3、2、1…",
            "zh": "3、2、1……",
            "narrator_zh": "百鹤"
        },
        {
            "location": "245/TALK",
            "narrator": "百鶴",
            "text": "ジャジャーン！！",
            "zh": "锵锵——！！",
            "narrator_zh": "百鹤"
        },
        {
            "location": "247/TALK",
            "narrator": "ぴょんこ",
            "text": "ぴょ～～～～ん！！",
            "zh": "pyooooon！！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "248/TALK",
            "narrator": "百鶴",
            "text": "特別企画！\nコタツを飛び出た\nひゃっちゃんと！",
            "zh": "特别企划！\n从被炉里跳出来的\n小百！",
            "narrator_zh": "百鹤"
        },
        {
            "location": "249/TALK",
            "narrator": "ぴょんこ",
            "text": "ルールを抜け出す\nぴょんこちゃんが！",
            "zh": "与逃出规则之外的\n蹦子！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "250/TALK",
            "narrator": "百鶴",
            "text": "まさかの！",
            "zh": "居然破天荒地！",
            "narrator_zh": "百鹤"
        },
        {
            "location": "251/TALK",
            "narrator": "ぴょんこ",
            "text": "共演！",
            "zh": "同台共演！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "254/TALK",
            "narrator": "百鶴",
            "text": "出張ダイレクトアタック！",
            "zh": "出差直击！",
            "narrator_zh": "百鹤"
        },
        {
            "location": "255/TALK",
            "narrator": "ぴょんこ",
            "text": "さぁさぁ\n盛り上がって\nまいりました～！",
            "zh": "来来来，\n气氛已经\n炒热起来了哦～！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "257/TALK",
            "narrator": "ぴょんこ",
            "text": "$handle$さん\nラブラブパワー\nハレーショーーーーン♪♪",
            "zh": "$handle$\n爱爱力量\n光晕————♪♪",
            "narrator_zh": "蹦子"
        },
        {
            "location": "279/TALK",
            "narrator": "昇華ぴょんこ",
            "text": "ぴょ～～～～ん♪",
            "zh": "pyooooon♪",
            "narrator_zh": "升华蹦子"
        },
        {
            "location": "281/TALK",
            "narrator": "百鶴",
            "text": "はい？",
            "zh": "哈？",
            "narrator_zh": "百鹤"
        },
        {
            "location": "282/TALK",
            "narrator": "昇華ぴょんこ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "升华蹦子"
        },
        {
            "location": "283/TALK",
            "narrator": "百鶴",
            "text": "ちょっと\n待ってくださいよ？",
            "zh": "请稍微\n等一下好吗？",
            "narrator_zh": "百鹤"
        },
        {
            "location": "284/TALK",
            "narrator": "百鶴",
            "text": "あなた、まさか\nここで昇華するんですか？",
            "zh": "你该不会，\n打算在这里直接升华吧？",
            "narrator_zh": "百鹤"
        },
        {
            "location": "286/TALK",
            "narrator": "百鶴",
            "text": "バカですか？\nチョロすぎですか！？",
            "zh": "你是笨蛋吗？\n也太好攻略了吧！？",
            "narrator_zh": "百鹤"
        },
        {
            "location": "287/TALK",
            "narrator": "昇華ぴょんこ",
            "text": "ぴょん？",
            "zh": "pyon？",
            "narrator_zh": "升华蹦子"
        },
        {
            "location": "288/TALK",
            "narrator": "百鶴",
            "text": "昇華した姿を\nそんな容易く\n見せるとか…",
            "zh": "把升华后的姿态\n这么轻易地\n拿出来示人什么的……",
            "narrator_zh": "百鹤"
        },
        {
            "location": "289/TALK",
            "narrator": "百鶴",
            "text": "さすがのわたしも\nドン引きですよ！！",
            "zh": "连我都\n看傻眼了啊！！",
            "narrator_zh": "百鹤"
        },
        {
            "location": "290/TALK",
            "narrator": "昇華ぴょんこ",
            "text": "ぴょん！",
            "zh": "pyon！",
            "narrator_zh": "升华蹦子"
        },
        {
            "location": "291/TALK",
            "narrator": "昇華ぴょんこ",
            "text": "ちょっとした\n芸風ですぴょん♪",
            "zh": "这只是小小的\n表演风格啦pyon♪",
            "narrator_zh": "升华蹦子"
        },
        {
            "location": "292/TALK",
            "narrator": "百鶴",
            "text": "まったく…わたしが\n自重させる側になるとは\n調子が狂いますね。",
            "zh": "真是的……居然轮到我来当\n劝人克制的一方，\n节奏全被带乱了啊。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "316/TALK",
            "narrator": "百鶴",
            "text": "と、いうわけで！",
            "zh": "总、总之就是这样！",
            "narrator_zh": "百鹤"
        },
        {
            "location": "317/TALK",
            "narrator": "百鶴",
            "text": "今回は\nぴょんこさんのところに\nお邪魔してみましたよ。",
            "zh": "这一回我试着\n来蹦子这边\n打扰一下了哦。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "318/TALK",
            "narrator": "ぴょんこ",
            "text": "お迎えしてみましたよっ！",
            "zh": "试着把你迎进来了哦！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "319/TALK",
            "narrator": "ぴょんこ",
            "text": "いったい誰がこの邂逅を\n予想できたでしょうか？",
            "zh": "究竟有谁能够预料到\n这场邂逅呢？",
            "narrator_zh": "蹦子"
        },
        {
            "location": "320/TALK",
            "narrator": "ぴょんこ",
            "text": "それでは\nご用件を聞きましょう！",
            "zh": "那么\n请说明来意吧！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "321/TALK",
            "narrator": "百鶴",
            "text": "ほかでもない、\nこのチャームです！",
            "zh": "不是别的，\n正是这个挂饰！",
            "narrator_zh": "百鹤"
        },
        {
            "location": "324/DIALOG",
            "narrator": "",
            "text": "ぴょんこ（司書）\nゾッコンLOVE！",
            "zh": "蹦子（司书）\n死心塌地LOVE！",
            "narrator_zh": ""
        },
        {
            "location": "326/TALK",
            "narrator": "ぴょんこ",
            "text": "ぴょ～～～～ん♪",
            "zh": "pyooooon♪",
            "narrator_zh": "蹦子"
        },
        {
            "location": "328/TALK",
            "narrator": "百鶴",
            "text": "見事なチャーム化、\nおめでとうございます。",
            "zh": "成功做成挂饰啦，\n恭喜恭喜。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "330/TALK",
            "narrator": "ぴょんこ",
            "text": "ありがとうございます♪",
            "zh": "谢谢你♪",
            "narrator_zh": "蹦子"
        },
        {
            "location": "332/TALK",
            "narrator": "ぴょんこ",
            "text": "これがあれば、いつでも\n$handle$さんと\n一緒にいられますから──",
            "zh": "只要有了这个，随时都能\n和$handle$\n待在一起——",
            "narrator_zh": "蹦子"
        },
        {
            "location": "333/TALK",
            "narrator": "ぴょんこ",
            "text": "万が一にでも\nお見逃しの無いよう\nご注意くださいねっ！",
            "zh": "哪怕万分之一，\n也请注意千万别\n错过了哦！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "334/TALK",
            "narrator": "百鶴",
            "text": "8888888888！",
            "zh": "8888888888！",
            "narrator_zh": "百鹤"
        },
        {
            "location": "336/TALK",
            "narrator": "ぴょんこ",
            "text": "…というか。",
            "zh": "……话说回来。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "337/TALK",
            "narrator": "ぴょんこ",
            "text": "百鶴さんはわざわざ\n私のお祝いのために\n来てくれたんですか？",
            "zh": "百鹤你难道是特意\n为了给我祝贺\n才专程跑来的吗？",
            "narrator_zh": "蹦子"
        },
        {
            "location": "338/TALK",
            "narrator": "百鶴",
            "text": "よくぞ聞いてくれました。",
            "zh": "问得好。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "342/TALK",
            "narrator": "百鶴",
            "text": "ここでもうひとつ、\nわたしのチャームも\n紹介したいと思います。",
            "zh": "在这里，我还想再\n介绍一下我的挂饰\n才对。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "343/TALK",
            "narrator": "百鶴",
            "text": "コレです！",
            "zh": "就是这个！",
            "narrator_zh": "百鹤"
        },
        {
            "location": "346/DIALOG",
            "narrator": "",
            "text": "ひゃっちゃん（司書）\nロッカーに隠れる",
            "zh": "小百（司书）\n躲进储物柜",
            "narrator_zh": ""
        },
        {
            "location": "348/TALK",
            "narrator": "ぴょんこ",
            "text": "えっ、これは…。",
            "zh": "诶，这个是……。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "349/TALK",
            "narrator": "ぴょんこ",
            "text": "現実のつばめさんの\nシーンではありませんか？",
            "zh": "这难道不是现实里\n燕那一幕吗？",
            "narrator_zh": "蹦子"
        },
        {
            "location": "350/TALK",
            "narrator": "百鶴",
            "text": "何をおっしゃる\nぴょんこさん。",
            "zh": "你在说什么呢\n蹦子。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "351/TALK",
            "narrator": "百鶴",
            "text": "わたしがロッカーに\n入ることは有り得ないと\n誰が決めたというのです。",
            "zh": "是谁规定我绝对不可能\n钻进储物柜\n里的呢。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "352/TALK",
            "narrator": "百鶴",
            "text": "いざとなったら、\nわたしもロッカーの\n１つや２つ入りますよ！",
            "zh": "真到了紧要关头，\n哪怕是一个两个储物柜\n我照样钻给你看哦！",
            "narrator_zh": "百鹤"
        },
        {
            "location": "353/TALK",
            "narrator": "ぴょんこ",
            "text": "なんとぉ！？",
            "zh": "什么！？",
            "narrator_zh": "蹦子"
        },
        {
            "location": "354/TALK",
            "narrator": "百鶴",
            "text": "ですからコレは、\n正真正銘わたしの\nチャームとも言えます。",
            "zh": "所以说这个，\n也可以算作货真价实的\n我的挂饰了。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "358/TALK",
            "narrator": "ぴょんこ",
            "text": "その発想は\n無かったぴょん……。",
            "zh": "完全没想到还能\n这么解释pyon……。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "359/TALK",
            "narrator": "百鶴",
            "text": "さらに言わせて\nいただきますと。",
            "zh": "而且容我再多\n补充一句的话。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "360/TALK",
            "narrator": "百鶴",
            "text": "ぴょんこさんの\nゾッコンLOVE！な\nチャームも──",
            "zh": "蹦子你的那个\n死心塌地LOVE！的\n挂饰其实也——",
            "narrator_zh": "百鹤"
        },
        {
            "location": "361/TALK",
            "narrator": "百鶴",
            "text": "現実の卯月さんが\n言ってもおかしくない\nセリフでしょうから。",
            "zh": "是就算现实中的卯月\n说出来也毫不奇怪的\n台词吧。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "362/TALK",
            "narrator": "百鶴",
            "text": "これは実は、\n卯月神楽さん本人の\nチャームかもしれません。",
            "zh": "所以那个说不定，\n其实是卯月神乐本人的\n挂饰哦。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "363/TALK",
            "narrator": "ぴょんこ",
            "text": "なん…だと…？",
            "zh": "怎……么会……？",
            "narrator_zh": "蹦子"
        },
        {
            "location": "364/TALK",
            "narrator": "百鶴",
            "text": "改めまして、\nおめでとうございまーす！",
            "zh": "再次向你致以\n诚挚的祝贺——！",
            "narrator_zh": "百鹤"
        },
        {
            "location": "365/TALK",
            "narrator": "ぴょんこ",
            "text": "なんですか、それ！",
            "zh": "那算什么啊！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "366/TALK",
            "narrator": "ぴょんこ",
            "text": "祝ってくれるどころか\n蹴落としに来たんですか\n百鶴さんは！？",
            "zh": "你这哪是来祝贺，\n分明是跑来拆台的吧\n百鹤！？",
            "narrator_zh": "蹦子"
        },
        {
            "location": "367/TALK",
            "narrator": "ぴょんこ",
            "text": "ステキな根性してますね！",
            "zh": "真是有够“棒”的心肠呢！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "368/TALK",
            "narrator": "百鶴",
            "text": "いえいえ、\n見くびらないでください。",
            "zh": "哪里哪里，\n请别小看我呀。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "369/TALK",
            "narrator": "百鶴",
            "text": "わたしはただ、\n解釈の可能性を\n提示したまでのこと。",
            "zh": "我只不过是，\n把一种解读的可能性\n摆出来罢了。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "370/TALK",
            "narrator": "百鶴",
            "text": "どう受け止めるかは\n$handle$さんが\n決めることです。",
            "zh": "至于究竟怎么理解，\n那是由$handle$\n自己决定的事。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "371/TALK",
            "narrator": "ぴょんこ",
            "text": "ぴょん…それは確かに\nその通りぴょん…。",
            "zh": "pyon……这倒确实\n很有道理pyon……。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "372/TALK",
            "narrator": "百鶴",
            "text": "…とまぁ、\n言いたいことを言ったら\n思い出しましたが。",
            "zh": "……不过嘛，\n把想说的说完之后\n我倒是想起来了。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "373/TALK",
            "narrator": "百鶴",
            "text": "さらにもうひとつ、\nわたしの上司もチャームに\nなるんですよね。",
            "zh": "除此之外还有一款，\n我的上司也要做成\n挂饰呢。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "374/TALK",
            "narrator": "百鶴",
            "text": "コレなんですけど。",
            "zh": "就是这一款。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "377/DIALOG",
            "narrator": "",
            "text": "千羽鶴（非攻略対象？）\n素敵なココロの旅を。",
            "zh": "千羽鹤（非攻略对象？）\n祝你有个美妙的心灵之旅。",
            "narrator_zh": ""
        },
        {
            "location": "379/TALK",
            "narrator": "ぴょんこ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "380/TALK",
            "narrator": "百鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "381/TALK",
            "narrator": "ぴょんこ",
            "text": "…この頃は\nお互いに大変でしたよね。",
            "zh": "……那段时期\n咱们彼此都挺不容易的呢。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "382/TALK",
            "narrator": "百鶴",
            "text": "えぇ、瀬戸際でしたから。",
            "zh": "是啊，当时可谓千钧一发嘛。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "383/TALK",
            "narrator": "百鶴",
            "text": "まぁ、このシーンは\nわたしたちの立場では\nコメントしにくいですね。",
            "zh": "嘛，这一幕的话，\n站在我们的立场上\n也不太好评价呢。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "384/TALK",
            "narrator": "百鶴",
            "text": "本人がちょっと\n取り込み中なもので、\nこの辺で失礼します。",
            "zh": "那位本人现在\n正好有点脱不开身，\n我们就先到此为止吧。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "391/TALK",
            "narrator": "百鶴",
            "text": "いずれにしても──",
            "zh": "不管怎样——",
            "narrator_zh": "百鹤"
        },
        {
            "location": "392/TALK",
            "narrator": "百鶴",
            "text": "$handle$さんに\nわたしたちのチャームを\n手にしてもらえたら！",
            "zh": "如果$handle$\n能把我们的挂饰\n拿在手里的话！",
            "narrator_zh": "百鹤"
        },
        {
            "location": "393/TALK",
            "narrator": "ぴょんこ",
            "text": "ぴょんこたちは\nとってもとっても\n嬉しいです！！",
            "zh": "蹦子我们会\n非常非常\n开心的！！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "394/TALK",
            "narrator": "百鶴",
            "text": "これから先、\n冷房とコタツがますます\n欠かせない季節ですので！",
            "zh": "毕竟接下来，\n正是空调和被炉越来越\n少不了的季节嘛！",
            "narrator_zh": "百鹤"
        },
        {
            "location": "395/TALK",
            "narrator": "ぴょんこ",
            "text": "夏のイベントに\nお越しの場合は、\nどうぞお体に気を付けて！",
            "zh": "如果要来参加\n夏季活动的话，\n请务必注意身体哦！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "398/DIALOG",
            "narrator": "",
            "text": "素敵なココロの旅チャームの\n詳細情報を見ますか？",
            "zh": "要查看“美妙的心之旅”挂饰的\n详细信息吗？",
            "narrator_zh": ""
        }
    ]
