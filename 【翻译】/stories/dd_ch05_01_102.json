{
    "dir": "chap01/daydra/dd_ch05_01_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "1504",
        "cid": "kagura",
        "title": "004 メインストーリー",
        "sub_title": "世界線歳差＜後編＞",
        "title_zh": "004 主线剧情",
        "sub_title_zh": "世界线岁差＜后篇＞"
    },
    "entry": [
        {
            "location": "709/TALK",
            "narrator": "神楽",
            "text": "はぁ……\n疲れた。",
            "zh": "哈啊……\n好累。",
            "narrator_zh": "神乐"
        },
        {
            "location": "715/TALK",
            "narrator": "神楽",
            "text": "…音羽から？",
            "zh": "……音羽来的？",
            "narrator_zh": "神乐"
        },
        {
            "location": "720/TALK",
            "narrator": "音羽",
            "text": "今日はありがとう、久し振りに会えて嬉しかった",
            "zh": "今天谢谢你，好久没见，很开心",
            "narrator_zh": "音羽"
        },
        {
            "location": "723/TALK",
            "narrator": "神楽",
            "text": "また遊びに行くから",
            "zh": "我还会再去玩的",
            "narrator_zh": "神乐"
        },
        {
            "location": "724/TALK",
            "narrator": "神楽",
            "text": "絶対にライブには来ないでね",
            "zh": "绝对不要来看演出哦",
            "narrator_zh": "神乐"
        },
        {
            "location": "726/TALK",
            "narrator": "音羽",
            "text": "わかってる",
            "zh": "我知道",
            "narrator_zh": "音羽"
        },
        {
            "location": "728/TALK",
            "narrator": "音羽",
            "text": "ねえ、神楽",
            "zh": "呐，神乐",
            "narrator_zh": "音羽"
        },
        {
            "location": "729/TALK",
            "narrator": "音羽",
            "text": "私にできることがあれば、なんでも言ってね",
            "zh": "有我能做的事，尽管说",
            "narrator_zh": "音羽"
        },
        {
            "location": "730/TALK",
            "narrator": "神楽",
            "text": "ありがとう",
            "zh": "谢谢",
            "narrator_zh": "神乐"
        },
        {
            "location": "732/TALK",
            "narrator": "音羽",
            "text": "それとね、神楽",
            "zh": "还有哦，神乐",
            "narrator_zh": "音羽"
        },
        {
            "location": "734/TALK",
            "narrator": "音羽",
            "text": "ずっと謝りたかったことがあるの",
            "zh": "有件事我一直想道歉",
            "narrator_zh": "音羽"
        },
        {
            "location": "735/TALK",
            "narrator": "神楽",
            "text": "なに？",
            "zh": "什么？",
            "narrator_zh": "神乐"
        },
        {
            "location": "737/TALK",
            "narrator": "音羽",
            "text": "本当は会ったときに言うべきだったんだろうけど",
            "zh": "其实见面的时候就该说的",
            "narrator_zh": "音羽"
        },
        {
            "location": "739/TALK",
            "narrator": "音羽",
            "text": "すごいドキドキするんだけど",
            "zh": "心跳得厉害",
            "narrator_zh": "音羽"
        },
        {
            "location": "741/TALK",
            "narrator": "音羽",
            "text": "でも、ずっとずっと後悔してたし",
            "zh": "可是，我一直一直在后悔",
            "narrator_zh": "音羽"
        },
        {
            "location": "742/TALK",
            "narrator": "音羽",
            "text": "ずっとごめんなさいって",
            "zh": "一直想说对不起",
            "narrator_zh": "音羽"
        },
        {
            "location": "743/TALK",
            "narrator": "音羽",
            "text": "思ってたことがあって",
            "zh": "有那样的事",
            "narrator_zh": "音羽"
        },
        {
            "location": "744/TALK",
            "narrator": "音羽",
            "text": "言いそびれちゃって",
            "zh": "没能说出口",
            "narrator_zh": "音羽"
        },
        {
            "location": "745/TALK",
            "narrator": "音羽",
            "text": "前に神楽が私を頼ってきたとき",
            "zh": "以前神乐来依靠我的时候",
            "narrator_zh": "音羽"
        },
        {
            "location": "746/TALK",
            "narrator": "音羽",
            "text": "私",
            "zh": "我",
            "narrator_zh": "音羽"
        },
        {
            "location": "748/TALK",
            "narrator": "音羽",
            "text": "ちょっとだけ優越感に浸ってた",
            "zh": "稍微沉浸在优越感里了",
            "narrator_zh": "音羽"
        },
        {
            "location": "750/TALK",
            "narrator": "音羽",
            "text": "でも、神楽が色々打ち明けてくれて",
            "zh": "可是，神乐跟我坦白了好多",
            "narrator_zh": "音羽"
        },
        {
            "location": "751/TALK",
            "narrator": "音羽",
            "text": "それを聞いて自分が嫌で仕方なくなって",
            "zh": "听了之后讨厌自己讨厌得不行",
            "narrator_zh": "音羽"
        },
        {
            "location": "752/TALK",
            "narrator": "音羽",
            "text": "それであの時以来合わせる顔も無くて",
            "zh": "所以从那以后都没脸见你",
            "narrator_zh": "音羽"
        },
        {
            "location": "753/TALK",
            "narrator": "音羽",
            "text": "そうこうしてるうちに、神楽はフランスにいっちゃって",
            "zh": "就这么着，神乐去了法国",
            "narrator_zh": "音羽"
        },
        {
            "location": "754/TALK",
            "narrator": "音羽",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "音羽"
        },
        {
            "location": "755/TALK",
            "narrator": "音羽",
            "text": "今回は絶対に神楽の力になりたい",
            "zh": "这次我绝对想帮上神乐",
            "narrator_zh": "音羽"
        },
        {
            "location": "756/TALK",
            "narrator": "音羽",
            "text": "何を言っても信じて貰えないかもだけど",
            "zh": "不管说什么你也许都不会信",
            "narrator_zh": "音羽"
        },
        {
            "location": "757/TALK",
            "narrator": "音羽",
            "text": "でもこの気持ちをどうしても伝えたくて",
            "zh": "可是这份心情我无论如何都想告诉你",
            "narrator_zh": "音羽"
        },
        {
            "location": "759/TALK",
            "narrator": "神楽",
            "text": "わかってる",
            "zh": "我知道",
            "narrator_zh": "神乐"
        },
        {
            "location": "760/TALK",
            "narrator": "神楽",
            "text": "ありがとう",
            "zh": "谢谢",
            "narrator_zh": "神乐"
        },
        {
            "location": "763/TALK",
            "narrator": "神楽",
            "text": "また辛くなったら遊びに行くね",
            "zh": "再难受的话，我还会去玩的",
            "narrator_zh": "神乐"
        },
        {
            "location": "776/TALK",
            "narrator": "神楽",
            "text": "…今のって、なに？",
            "zh": "……刚才那是，什么？",
            "narrator_zh": "神乐"
        },
        {
            "location": "777/TALK",
            "narrator": "神楽",
            "text": "まさか、私のことを\n動揺させるために…。",
            "zh": "难道，是为了\n动摇我……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "779/TALK",
            "narrator": "神楽",
            "text": "この世界が用意した\n筋書き、ってこと？",
            "zh": "是这个世界准备好的\n剧本，吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "791/TALK",
            "narrator": "神楽",
            "text": "この世界が用意した\n筋書き、ってこと？",
            "zh": "是这个世界准备好的\n剧本，吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "792/TALK",
            "narrator": "神楽",
            "text": "…酷すぎる。",
            "zh": "……太过分了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "794/TALK",
            "narrator": "神楽",
            "text": "私の親友に、こんなウソの\nシナリオと罪悪感を\n思い込ませるなんて…。",
            "zh": "居然让我的挚友，\n背上这种虚假的剧本\n和罪恶感……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "795/TALK",
            "narrator": "神楽",
            "text": "逢瀬つばめ…、\nどれだけ狡猾なの？",
            "zh": "逢濑燕……\n你到底有多狡猾？",
            "narrator_zh": "神乐"
        },
        {
            "location": "797/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "798/SEL",
            "narrator": "",
            "text": "つばめは狡猾なんかじゃないよ？",
            "zh": "燕才没有那么狡猾哦？",
            "narrator_zh": ""
        },
        {
            "location": "799/ACT",
            "narrator": "",
            "text": "つばめは狡猾なんかじゃないよ？",
            "zh": "燕才没有那么狡猾哦？",
            "narrator_zh": ""
        },
        {
            "location": "815/TALK",
            "narrator": "神楽",
            "text": "これは……",
            "zh": "这是……",
            "narrator_zh": "神乐"
        },
        {
            "location": "817/TALK",
            "narrator": "神楽",
            "text": "これが、ナビ？\n平行世界の…。",
            "zh": "这就是，领航？\n平行世界的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "818/TALK",
            "narrator": "神楽",
            "text": "確か、$handle$…\nだったっけ…？",
            "zh": "记得是，$handle$……\n来着……？",
            "narrator_zh": "神乐"
        },
        {
            "location": "824/TALK",
            "narrator": "神楽",
            "text": "はじめまして$handle$さん",
            "zh": "初次见面，$handle$",
            "narrator_zh": "神乐"
        },
        {
            "location": "826/TALK",
            "narrator": "神楽",
            "text": "$handle$さんは日本語で対話するんですね",
            "zh": "$handle$是用日语对话的呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "827/TALK",
            "narrator": "神楽",
            "text": "日本人なんですか？",
            "zh": "你是日本人吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "829/TALK",
            "narrator": "神楽",
            "text": "こことは違うどこか",
            "zh": "是和这里不同的某处",
            "narrator_zh": "神乐"
        },
        {
            "location": "830/TALK",
            "narrator": "神楽",
            "text": "遠い世界の",
            "zh": "遥远世界的",
            "narrator_zh": "神乐"
        },
        {
            "location": "832/SEL",
            "narrator": "",
            "text": "意外と近いかもしれないよ",
            "zh": "说不定意外地近哦",
            "narrator_zh": ""
        },
        {
            "location": "833/SEL",
            "narrator": "",
            "text": "アイアム日本人？",
            "zh": "I am日本人？",
            "narrator_zh": ""
        },
        {
            "location": "834/SEL",
            "narrator": "",
            "text": "よく知ってるね",
            "zh": "你还挺了解的",
            "narrator_zh": ""
        },
        {
            "location": "835/ACT",
            "narrator": "",
            "text": "意外と近いかもしれないよ",
            "zh": "说不定意外地近哦",
            "narrator_zh": ""
        },
        {
            "location": "836/TALK",
            "narrator": "神楽",
            "text": "近いんですか？",
            "zh": "近吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "837/TALK",
            "narrator": "神楽",
            "text": "でも世界が違う時点で遠いような気がしますけど",
            "zh": "可是世界都不同了，我觉得已经算远了",
            "narrator_zh": "神乐"
        },
        {
            "location": "838/TALK",
            "narrator": "神楽",
            "text": "そういうものじゃないんですか？",
            "zh": "不是这样吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "840/SEL",
            "narrator": "",
            "text": "実はよく知らないんだよね",
            "zh": "其实我也不是很清楚",
            "narrator_zh": ""
        },
        {
            "location": "841/ACT",
            "narrator": "",
            "text": "実はよく知らないんだよね",
            "zh": "其实我也不是很清楚",
            "narrator_zh": ""
        },
        {
            "location": "844/TALK",
            "narrator": "神楽",
            "text": "そうなんですか？",
            "zh": "是这样吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "845/ACT",
            "narrator": "",
            "text": "アイアム日本人？",
            "zh": "I am日本人？",
            "narrator_zh": ""
        },
        {
            "location": "846/TALK",
            "narrator": "神楽",
            "text": "質問してるのはこっちですけど",
            "zh": "问问题的是我这边哦",
            "narrator_zh": "神乐"
        },
        {
            "location": "847/TALK",
            "narrator": "神楽",
            "text": "色々とツッコミどころ満載ですよそれ？",
            "zh": "这可是槽点满满哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "848/ACT",
            "narrator": "",
            "text": "よく知ってるね",
            "zh": "你还挺了解的",
            "narrator_zh": ""
        },
        {
            "location": "849/TALK",
            "narrator": "神楽",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": "神乐"
        },
        {
            "location": "850/TALK",
            "narrator": "神楽",
            "text": "こちらも事前に教わっていますので",
            "zh": "这边也事先被告知过了",
            "narrator_zh": "神乐"
        },
        {
            "location": "852/SEL",
            "narrator": "",
            "text": "$me$のプライバシーはどこへ？",
            "zh": "$me$的隐私到哪去了？",
            "narrator_zh": ""
        },
        {
            "location": "853/SEL",
            "narrator": "",
            "text": "知ってくれてて嬉しい",
            "zh": "你知道我，我很开心",
            "narrator_zh": ""
        },
        {
            "location": "854/ACT",
            "narrator": "",
            "text": "$me$のプライバシーはどこへ？",
            "zh": "$me$的隐私到哪去了？",
            "narrator_zh": ""
        },
        {
            "location": "855/TALK",
            "narrator": "神楽",
            "text": "私に聞かれてもそれは困りますけど",
            "zh": "问我也挺为难的",
            "narrator_zh": "神乐"
        },
        {
            "location": "856/TALK",
            "narrator": "神楽",
            "text": "気にするほどじゃないと思いますよ？",
            "zh": "我觉得没必要那么在意哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "857/TALK",
            "narrator": "神楽",
            "text": "あなた個人の話は聞いてませんし",
            "zh": "我也没听说你个人的事",
            "narrator_zh": "神乐"
        },
        {
            "location": "858/ACT",
            "narrator": "",
            "text": "知ってくれてて嬉しい",
            "zh": "你知道我，我很开心",
            "narrator_zh": ""
        },
        {
            "location": "859/TALK",
            "narrator": "神楽",
            "text": "そうなんですか？",
            "zh": "是这样吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "860/TALK",
            "narrator": "神楽",
            "text": "よくわからないけど",
            "zh": "虽然不太明白",
            "narrator_zh": "神乐"
        },
        {
            "location": "861/TALK",
            "narrator": "神楽",
            "text": "喜んでもらえているならよかったです",
            "zh": "你能高兴就好",
            "narrator_zh": "神乐"
        },
        {
            "location": "864/TALK",
            "narrator": "神楽",
            "text": "とりあえぞこれから色々とお世話になると思うので",
            "zh": "总之之后会多有打扰",
            "narrator_zh": "神乐"
        },
        {
            "location": "865/TALK",
            "narrator": "神楽",
            "text": "よろしくお願いします",
            "zh": "请多关照",
            "narrator_zh": "神乐"
        },
        {
            "location": "867/SEL",
            "narrator": "",
            "text": "ＯＫ、任せろ！",
            "zh": "OK，交给我！",
            "narrator_zh": ""
        },
        {
            "location": "868/SEL",
            "narrator": "",
            "text": "大船に乗った気でいてくれ！",
            "zh": "你就放心好了！",
            "narrator_zh": ""
        },
        {
            "location": "869/ACT",
            "narrator": "",
            "text": "ＯＫ、任せろ！",
            "zh": "OK，交给我！",
            "narrator_zh": ""
        },
        {
            "location": "870/ACT",
            "narrator": "",
            "text": "大船に乗った気でいてくれ！",
            "zh": "你就放心好了！",
            "narrator_zh": ""
        },
        {
            "location": "873/TALK",
            "narrator": "神楽",
            "text": "あの、本当に、",
            "zh": "那个，真的，",
            "narrator_zh": "神乐"
        },
        {
            "location": "874/TALK",
            "narrator": "神楽",
            "text": "こことは違う世界の方ですか？",
            "zh": "你是和这里不同的世界的人吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "876/SEL",
            "narrator": "",
            "text": "そうだけど、どうして？",
            "zh": "是这样，为什么？",
            "narrator_zh": ""
        },
        {
            "location": "877/ACT",
            "narrator": "",
            "text": "そうだけど、どうして？",
            "zh": "是这样，为什么？",
            "narrator_zh": ""
        },
        {
            "location": "879/TALK",
            "narrator": "神楽",
            "text": "なんか",
            "zh": "总觉得",
            "narrator_zh": "神乐"
        },
        {
            "location": "880/TALK",
            "narrator": "神楽",
            "text": "想像していたのと違うというか",
            "zh": "和想象的不一样",
            "narrator_zh": "神乐"
        },
        {
            "location": "883/TALK",
            "narrator": "神楽",
            "text": "$handle$さんのことを教えてくれたのって",
            "zh": "告诉我$handle$的事的人",
            "narrator_zh": "神乐"
        },
        {
            "location": "884/TALK",
            "narrator": "神楽",
            "text": "私の上司に当たる人間や",
            "zh": "是相当于我上司的人，",
            "narrator_zh": "神乐"
        },
        {
            "location": "885/TALK",
            "narrator": "神楽",
            "text": "科学者と呼ばれる方々だったので",
            "zh": "还有被称作科学家的那些人，",
            "narrator_zh": "神乐"
        },
        {
            "location": "886/TALK",
            "narrator": "神楽",
            "text": "失礼ですが",
            "zh": "恕我失礼",
            "narrator_zh": "神乐"
        },
        {
            "location": "887/TALK",
            "narrator": "神楽",
            "text": "もっととても真面目でユーモアとか持ってない人を想像していました",
