{
    "dir": "dramatics/daydra/drm_ch04_00_442.js",
    "type": "Episode",
    "info": {
        "story_id": "4048",
        "cid": "miyabi",
        "title": "らぶとーく 第49話",
        "sub_title": "口止めとは生意気な（ガブリエラ）",
        "title_zh": "恋爱漫谈 第49话",
        "sub_title_zh": "封口还真是放肆（加布里埃拉）"
    },
    "entry": [
        {
            "location": "282/SCENARIO",
            "narrator": "",
            "text": "口止めとは生意気な（ガブリエラ）",
            "zh": "封口还真是放肆（加布里埃拉）",
            "narrator_zh": ""
        },
        {
            "location": "296/TALK",
            "narrator": "ガブリエラ",
            "text": "開いてるわよー。",
            "zh": "门开着哦——。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "299/TALK",
            "narrator": "みやび",
            "text": "お邪魔するぞね。",
            "zh": "打扰了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "300/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、どうかしたの？",
            "zh": "哎呀，怎么了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "301/TALK",
            "narrator": "みやび",
            "text": "ん…当直のことや。",
            "zh": "嗯……说的是值班咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "302/TALK",
            "narrator": "みやび",
            "text": "今度の当直、まさか\nガブちゃんが代わる\n言うとは思わなくて。",
            "zh": "这次的值班，我没想到\n加布居然会说\n要替我来换。",
            "narrator_zh": "雅"
        },
        {
            "location": "304/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、そういう\n気分だったのよ。",
            "zh": "……嘛，就是那种\n心情罢了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "307/TALK",
            "narrator": "みやび",
            "text": "実は、その日はどうしても\n外せん用事があってな。",
            "zh": "其实那天，我有个\n无论如何都推不掉的事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "308/TALK",
            "narrator": "みやび",
            "text": "正直、どうしようか\n悩んでたちや。",
            "zh": "老实说，我也一直\n在纠结滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "311/TALK",
            "narrator": "みやび",
            "text": "やき、ガブちゃんが\n代わる言うてくれて、\nまっこと助かった。",
            "zh": "所以啵，加布肯替我\n来换班，\n真算帮了大忙。",
            "narrator_zh": "雅"
        },
        {
            "location": "312/TALK",
            "narrator": "みやび",
            "text": "ありがとな。",
            "zh": "谢啦。",
            "narrator_zh": "雅"
        },
        {
            "location": "315/TALK",
            "narrator": "ガブリエラ",
            "text": "べ、別に、そんな\nお礼言われるほどの\nことじゃないし…。",
            "zh": "才、才不是什么\n值得道谢的\n事呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "316/TALK",
            "narrator": "みやび",
            "text": "いや、礼くらい言わせて\nもらえんと、うちの気が\nすまん。",
            "zh": "不，至少让我\n道个谢嘛，不然\n我心里过不去。",
            "narrator_zh": "雅"
        },
        {
            "location": "318/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "320/TALK",
            "narrator": "ガブリエラ",
            "text": "それなら、もう一人\nお礼を言うべき人が\nいるわね。",
            "zh": "那样的话，还有一个人\n该道谢呢。\n",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "321/TALK",
            "narrator": "みやび",
            "text": "…もう一人？",
            "zh": "…还有一个？",
            "narrator_zh": "雅"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "本当は口止めされて\nたんだけど、\n言っちゃうわ。",
            "zh": "其实我是被人\n封了口的，\n但我还是要说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびが当直の日に、\n凄く大事な予定が\n重なってるから――",
            "zh": "雅值班的那天，\n有件非常重要的\n安排撞上了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "変わってやってくれ\nないか、って、\n頼まれたのよ。",
            "zh": "是她拜托我，\n问能不能\n替她换，就这样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "328/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "331/TALK",
            "narrator": "みやび",
            "text": "初耳や。\nそんなこと言われたが？",
            "zh": "头一回听说咯。\n还有人跟你这么讲过咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "332/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、言われたわ。",
            "zh": "嗯，是拜托过哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "334/TALK",
            "narrator": "みやび",
            "text": "そうか…。",
            "zh": "是吗……",
            "narrator_zh": "雅"
        },
        {
            "location": "335/TALK",
            "narrator": "みやび",
            "text": "なるほどな…。\n道理でタイミングが\n良過ぎるわけや。",
            "zh": "原来如此……。\n怪不得这时机\n巧得过分咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "338/TALK",
            "narrator": "ガブリエラ",
            "text": "…余計なことだった？",
            "zh": "……是多余的事吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "340/TALK",
            "narrator": "みやび",
            "text": "いや、そんなことは\nないぞね。",
            "zh": "不，没\n那么难啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "341/TALK",
            "narrator": "みやび",
            "text": "それより、当直の方は\nまっこと変わってもらって\nえいが？",
            "zh": "比起这个，值班那边\n真的能拜托你\n换一下好咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "344/TALK",
            "narrator": "ガブリエラ",
            "text": "変わると言った以上は、\n今更撤回しないわ。",
            "zh": "既然说了要换，\n事到如今不会反悔。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "345/TALK",
            "narrator": "みやび",
            "text": "そうか…。\n改めて、ありがとうな。",
            "zh": "这样啊……。\n再次谢谢你咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "354/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "361/TALK",
            "narrator": "みやび",
            "text": "おい",
            "zh": "喂",
            "narrator_zh": "雅"
        },
        {
            "location": "363/TALK",
            "narrator": "みやび",
            "text": "うちに内緒で勝手なことを",
            "zh": "瞒着我擅自乱来",
            "narrator_zh": "雅"
        },
        {
            "location": "364/TALK",
            "narrator": "みやび",
            "text": "余計なことするな！",
            "zh": "别多管闲事！",
            "narrator_zh": "雅"
        },
        {
            "location": "366/SEL",
            "narrator": "",
            "text": "もう決まったし",
            "zh": "都已经定好了",
            "narrator_zh": ""
        },
        {
            "location": "367/SEL",
            "narrator": "",
            "text": "サプライズ成功！",
            "zh": "惊喜成功！",
            "narrator_zh": ""
        },
        {
            "location": "368/SEL",
            "narrator": "",
            "text": "遠慮しないで",
            "zh": "别客气",
            "narrator_zh": ""
        },
        {
            "location": "369/ACT",
            "narrator": "",
            "text": "もう決まったし",
            "zh": "都已经定好了",
            "narrator_zh": ""
        },
        {
            "location": "370/TALK",
            "narrator": "みやび",
            "text": "勝手に決めよって",
            "zh": "就这么自作主张",
            "narrator_zh": "雅"
        },
        {
            "location": "371/TALK",
            "narrator": "みやび",
            "text": "ハッキリ言っておく",
            "zh": "我把话说清楚",
            "narrator_zh": "雅"
        },
        {
            "location": "372/TALK",
            "narrator": "みやび",
            "text": "こういうズルは好きやない",
            "zh": "这种取巧我不喜欢",
            "narrator_zh": "雅"
        },
        {
            "location": "373/TALK",
            "narrator": "みやび",
            "text": "礼は言わんぞ！",
            "zh": "我可不会道谢咧！",
            "narrator_zh": "雅"
        },
        {
            "location": "374/ACT",
            "narrator": "",
            "text": "サプライズ成功！",
            "zh": "惊喜成功！",
            "narrator_zh": ""
        },
        {
            "location": "375/TALK",
            "narrator": "みやび",
            "text": "そうやね",
            "zh": "是这样咯",
            "narrator_zh": "雅"
        },
        {
            "location": "376/TALK",
            "narrator": "みやび",
            "text": "ハッピーの付かない方",
            "zh": "不带Happy的那个",
            "narrator_zh": "雅"
        },
        {
            "location": "377/TALK",
            "narrator": "みやび",
            "text": "ただのサプライズ",
            "zh": "就是个惊喜嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "378/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "雅"
        },
        {
            "location": "379/TALK",
            "narrator": "みやび",
            "text": "限りなくバッドに近い",
            "zh": "无限接近Bad咯",
            "narrator_zh": "雅"
        },
        {
            "location": "380/ACT",
            "narrator": "",
            "text": "遠慮しないで",
            "zh": "别客气",
            "narrator_zh": ""
        },
        {
            "location": "381/TALK",
            "narrator": "みやび",
            "text": "おまえが言うな！",
            "zh": "轮不到你说！",
            "narrator_zh": "雅"
        },
        {
            "location": "382/TALK",
            "narrator": "みやび",
            "text": "それはガブちゃんのセリフや",
            "zh": "那是加布的台词咯",
            "narrator_zh": "雅"
        },
        {
            "location": "383/TALK",
            "narrator": "みやび",
            "text": "呆れるほどの図々しさやね",
            "zh": "脸皮厚得让人无语咯",
            "narrator_zh": "雅"
        },
        {
            "location": "386/SEL",
            "narrator": "",
            "text": "余計なことしてごめん…",
            "zh": "多此一举，抱歉……",
            "narrator_zh": ""
        },
        {
            "location": "387/ACT",
            "narrator": "",
            "text": "余計なことしてごめん…",
            "zh": "多此一举，抱歉……",
            "narrator_zh": ""
        },
        {
            "location": "390/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "391/TALK",
            "narrator": "みやび",
            "text": "当直がなくなって助かったのは事実や",
            "zh": "不用值班算我走运，这也是实话咯",
            "narrator_zh": "雅"
        },
        {
            "location": "392/TALK",
            "narrator": "みやび",
            "text": "実際困ってたのも事実",
            "zh": "实际上确实也很为难",
            "narrator_zh": "雅"
        },
        {
            "location": "393/TALK",
            "narrator": "みやび",
            "text": "そういうことだ",
            "zh": "就是这么回事",
            "narrator_zh": "雅"
        },
        {
            "location": "394/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "397/TALK",
            "narrator": "みやび",
            "text": "休みに罪はない",
            "zh": "休息又没有罪",
            "narrator_zh": "雅"
        },
        {
            "location": "398/TALK",
            "narrator": "みやび",
            "text": "遠慮なく使わせてもらうちや！",
            "zh": "那我就不客气地用滴！",
            "narrator_zh": "雅"
        },
        {
            "location": "291/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　 4:39 PM</color>\nとある平日、寮「とらいあんぐる」ガブリエラの部屋にて",
            "zh": "<color=green>某月某日　 4:39 PM</color>\n某个平日，宿舍「Tri-angle」加布里埃拉的房间里。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
