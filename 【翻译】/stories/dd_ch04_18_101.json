{
    "dir": "chap18/daydra/dd_ch04_18_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "18402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "WAREZ＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "WAREZ＜前篇＞"
    },
    "entry": [
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "ふぁ～…。",
            "zh": "呼啊～…。",
            "narrator_zh": "雅"
        },
        {
            "location": "36/TALK",
            "narrator": "みやび",
            "text": "最近寝不足やき、\nどうにも本調子が\n出んなぁ…。",
            "zh": "最近睡眠不足啵，\n怎么都打不起\n精神咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "まあ、とりあえず\n昼ご飯食わんと…。",
            "zh": "嘛，总之先\n把午饭吃了再说……。",
            "narrator_zh": "雅"
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "…また相棒か？\n今日はどんな用事――",
            "zh": "…又是搭档啊？\n今天是什么事——",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "…ウサギ！？",
            "zh": "…兔子！？",
            "narrator_zh": "雅"
        },
        {
            "location": "50/TALK",
            "narrator": "ラビットアニマ",
            "text": "クイーン",
            "zh": "女王",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "51/TALK",
            "narrator": "ラビットアニマ",
            "text": "申し訳ありませんが",
            "zh": "非常抱歉",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "52/TALK",
            "narrator": "ラビットアニマ",
            "text": "今すぐ場所を移動してください",
            "zh": "请您立刻转移位置",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "55/TALK",
            "narrator": "フェイタルクイーン",
            "text": "どういうことか説明を求める",
            "zh": "说明这是怎么回事",
            "narrator_zh": "致命女王"
        },
        {
            "location": "57/TALK",
            "narrator": "ラビットアニマ",
            "text": "人のいない場所へ移動してください",
            "zh": "请转移到没有人的场所",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "60/TALK",
            "narrator": "フェイタルクイーン",
            "text": "私の素性を知っているなら",
            "zh": "既然你知道我的来历",
            "narrator_zh": "致命女王"
        },
        {
            "location": "61/TALK",
            "narrator": "フェイタルクイーン",
            "text": "学生だということも",
            "zh": "连我是学生这件事",
            "narrator_zh": "致命女王"
        },
        {
            "location": "62/TALK",
            "narrator": "フェイタルクイーン",
            "text": "もう知っているのだろう？",
            "zh": "也早就知道了吧？",
            "narrator_zh": "致命女王"
        },
        {
            "location": "63/TALK",
            "narrator": "フェイタルクイーン",
            "text": "学校で人のいない場所など",
            "zh": "学校里没人的地方",
            "narrator_zh": "致命女王"
        },
        {
            "location": "64/TALK",
            "narrator": "フェイタルクイーン",
            "text": "校舎端のトイレくらいしか思いつかん",
            "zh": "我只想得出教学楼角落的厕所",
            "narrator_zh": "致命女王"
        },
        {
            "location": "67/TALK",
            "narrator": "ラビットアニマ",
            "text": "では",
            "zh": "那么",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "68/TALK",
            "narrator": "ラビットアニマ",
            "text": "屋上へ来てください",
            "zh": "请到天台来",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "69/TALK",
            "narrator": "ラビットアニマ",
            "text": "お待ちしてます",
            "zh": "恭候您。",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "…待ってる？\nウサギが…屋上で！？",
            "zh": "…等着？\n兔子……在天台！？",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "勢いよく飛び出しは\nしたけんど…、\n不用意過ぎたか？",
            "zh": "倒是气势十足地\n冲出来咯……，\n是不是太不小心了？",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "こっちの素性を\n知っちょった\n相手に…。",
            "zh": "对面是个知道\n我们底细的\n家伙……。",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "う～ん…。",
            "zh": "唔～…。",
            "narrator_zh": "雅"
        },
        {
            "location": "95/SEL",
            "narrator": "",
            "text": "会うの楽しみだね",
            "zh": "很期待见面呢",
            "narrator_zh": ""
        },
        {
            "location": "96/ACT",
            "narrator": "",
            "text": "会うの楽しみだね",
            "zh": "很期待见面呢",
            "narrator_zh": ""
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "能天気め",
            "zh": "没心没肺的家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "楽観し過ぎや",
            "zh": "乐观过头了咯",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "頭の中花畑とはまさにこのこと",
            "zh": "所谓脑子里开满花田，说的就是这种事",
            "narrator_zh": "雅"
        },
        {
            "location": "109/TALK",
            "narrator": "みやび",
            "text": "生徒なのか",
            "zh": "是学生吗",
            "narrator_zh": "雅"
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "教師なのか",
            "zh": "还是老师",
            "narrator_zh": "雅"
        },
        {
            "location": "111/TALK",
            "narrator": "みやび",
            "text": "もしかすると大学の方の人間かもしれん",
            "zh": "搞不好还是大学那边的人",
            "narrator_zh": "雅"
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "ともかく",
            "zh": "总而言之",
            "narrator_zh": "雅"
        },
        {
            "location": "113/TALK",
            "narrator": "みやび",
            "text": "こっちはテンパリ中だというのに",
            "zh": "我这边正慌得不行",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "呑気な奴め",
            "zh": "悠哉悠哉的家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "117/TALK",
            "narrator": "みやび",
            "text": "…やはり、気持ちが\n乱れちょるな。",
            "zh": "…果然，心情\n乱得很咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "118/TALK",
            "narrator": "みやび",
            "text": "ウサギに会えるんは\n嬉しい。",
            "zh": "能见到兔子，\n我挺高兴滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "119/TALK",
            "narrator": "みやび",
            "text": "けんど、\nどうにも怪しい感じが\n捨てきれん。",
            "zh": "但是，\n那股可疑的感觉\n怎么都甩不掉。",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "…屋上、行かん方が\nえいかもしれんな…。",
            "zh": "…天台，还是\n别去的好咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "185/TALK",
            "narrator": "みやび",
            "text": "　",
            "zh": "　",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "おお、相棒か。",
            "zh": "哦，是搭档啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "214/TALK",
            "narrator": "みやび",
            "text": "ぶはっ！！",
            "zh": "噗哈！！",
            "narrator_zh": "雅"
        },
        {
            "location": "217/TALK",
            "narrator": "みやび",
            "text": "もみっ！！",
            "zh": "揉啊！！",
            "narrator_zh": "雅"
        },
        {
            "location": "220/TALK",
            "narrator": "みやび",
            "text": "グホアァっ！",
            "zh": "咕嚯啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "224/TALK",
            "narrator": "みやび",
            "text": "なんぞ、\n今回は強烈やね！\nいつもの１０倍マシか？",
            "zh": "驷马，\n这次下手也太狠咯！\n比平时狠 10 倍咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "225/SEL",
            "narrator": "",
            "text": "屋上でボコられると聞いたので、予行演習をと思って",
            "zh": "听说你要在天台挨揍，就想着先来个彩排",
            "narrator_zh": ""
        },
        {
            "location": "226/ACT",
            "narrator": "",
            "text": "屋上でボコられると聞いたので、予行演習をと思って",
            "zh": "听说你要在天台挨揍，就想着先来个彩排",
            "narrator_zh": ""
        },
        {
            "location": "229/TALK",
            "narrator": "みやび",
            "text": "そんな予行演習\n必要ないぞね。",
            "zh": "那种彩排\n根本没必要咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "230/TALK",
            "narrator": "みやび",
            "text": "それより、今回はいよいよ\nつばめちゃんの元司書が\nいる場所へ向かう。",
            "zh": "比起这个，这次终于要\n动身去燕的\n前司书所在的地方咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "231/TALK",
            "narrator": "みやび",
            "text": "元司書ちゃんの\n正式な名も\nわかったしな。",
            "zh": "前司书的\n正式名字，\n也弄清楚了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "232/SEL",
            "narrator": "",
            "text": "それはよかった",
            "zh": "那太好了",
            "narrator_zh": ""
        },
        {
            "location": "233/SEL",
            "narrator": "",
            "text": "え？なんだったの！？",
            "zh": "诶？叫什么来着！？",
            "narrator_zh": ""
        },
        {
            "location": "234/ACT",
            "narrator": "",
            "text": "それはよかった",
            "zh": "那太好了",
            "narrator_zh": ""
        },
        {
            "location": "235/TALK",
            "narrator": "みやび",
            "text": "うむ。",
            "zh": "嗯。",
            "narrator_zh": "雅"
        },
        {
            "location": "236/TALK",
            "narrator": "みやび",
            "text": "まあ、うちのサーチ能力に\nかかれば、こんなこと\nくらい楽勝やき……",
            "zh": "嘛，只要靠我的\n搜索能力，这点事\n简直轻松取胜啵……",
            "narrator_zh": "雅"
        },
        {
            "location": "237/TALK",
            "narrator": "みやび",
            "text": "と言えればえいんやけんど\n今回はさすがにちっくと\n骨が折れたちや。",
            "zh": "要是能这么说就对了咯，\n但这次说实话还是\n费了点功夫滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "238/ACT",
            "narrator": "",
            "text": "え？なんだったの！？",
            "zh": "诶？叫什么来着！？",
            "narrator_zh": ""
        },
        {
            "location": "239/TALK",
            "narrator": "みやび",
            "text": "教えんよ。",
            "zh": "不告诉你咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "240/TALK",
            "narrator": "みやび",
            "text": "ココロの司書に限らず\n人格が本当の名前を\n教えるゆうんは――",
            "zh": "不光是心之司书，\n人格愿意把真名\n说出口，就等于——",
            "narrator_zh": "雅"
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "その存在に自分の全てを\n捧げることと同義やき。",
            "zh": "把自己的一切\n都献给那个存在，是一个意思啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "ちゅうわけで、\n覚悟はえいか？",
            "zh": "所以说，\n做好觉悟了没？",
            "narrator_zh": "雅"
        },
        {
            "location": "244/SEL",
            "narrator": "",
            "text": "望むところ",
            "zh": "求之不得",
            "narrator_zh": ""
        },
        {
            "location": "245/SEL",
            "narrator": "",
            "text": "ちょっと怖い",
            "zh": "有点害怕",
            "narrator_zh": ""
        },
        {
            "location": "246/ACT",
            "narrator": "",
            "text": "望むところ",
            "zh": "求之不得",
            "narrator_zh": ""
        },
        {
            "location": "247/TALK",
            "narrator": "みやび",
            "text": "えい度胸や。",
            "zh": "胆子不错嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "248/ACT",
            "narrator": "",
            "text": "ちょっと怖い",
            "zh": "有点害怕",
            "narrator_zh": ""
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "まあ、それが\n一般ピーポーな感覚や。\n気にするな。",
            "zh": "嘛，那正是\n一般人该有的感觉。\n别在意。",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "オープンプロセス、\n0x889番地から\nC1:2:28E//1x0FF番地へ。",
            "zh": "开放进程，\n从 0x889 号地址\n转到 C1:2:28E//1x0FF 号地址。",
            "narrator_zh": "雅"
        },
        {
            "location": "258/TALK",
            "narrator": "みやび",
            "text": "倍速、２倍。",
            "zh": "倍速，2 倍。",
            "narrator_zh": "雅"
        },
        {
            "location": "262/TALK",
            "narrator": "みやび",
            "text": "更に倍。ドン。",
            "zh": "再翻一倍。咚。",
            "narrator_zh": "雅"
        },
        {
            "location": "288/TALK",
            "narrator": "みやび",
            "text": "完了。",
            "zh": "完成。",
            "narrator_zh": "雅"
        },
        {
            "location": "290/TALK",
            "narrator": "つばめ",
            "text": "…え？",
            "zh": "…诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "291/TALK",
            "narrator": "つばめ",
            "text": "ああっ！\nあなたたちはっ！？",
            "zh": "啊！\n你们是——！？",
            "narrator_zh": "燕"
        },
        {
            "location": "293/SEL",
            "narrator": "",
            "text": "無事だったんだね！",
            "zh": "你没事太好了！",
            "narrator_zh": ""
        },
        {
            "location": "294/ACT",
            "narrator": "",
            "text": "無事だったんだね！",
            "zh": "你没事太好了！",
            "narrator_zh": ""
        },
        {
            "location": "297/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんっ！\nどうしてここに！？",
            "zh": "$handle$！\n你怎么会在这里！？",
            "narrator_zh": "燕"
        },
        {
            "location": "298/TALK",
            "narrator": "みやび",
            "text": "うちがお前さんの本名から\nココロスフィアをサーチ\nして見つけたんよ。",
            "zh": "我是从你的本名\n搜索心灵领域\n才找到这里的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "299/SEL",
            "narrator": "",
            "text": "ここは？",
            "zh": "这里是？",
            "narrator_zh": ""
        },
        {
            "location": "300/SEL",
            "narrator": "",
            "text": "会いたかったよ！",
            "zh": "我好想见你！",
            "narrator_zh": ""
        },
        {
            "location": "301/ACT",
            "narrator": "",
            "text": "ここは？",
            "zh": "这里是？",
            "narrator_zh": ""
        },
        {
            "location": "302/TALK",
            "narrator": "つばめ",
            "text": "ここがどこかは\n答えられません。",
            "zh": "这里是哪里，\n我不能回答。",
            "narrator_zh": "燕"
        },
        {
            "location": "303/TALK",
            "narrator": "つばめ",
            "text": "わたし、ずっと\n監視されてますから。",
            "zh": "因为我一直\n被监视着。",
            "narrator_zh": "燕"
        },
        {
            "location": "304/TALK",
            "narrator": "つばめ",
            "text": "そんなことより、\nここに来たらダメですよ！",
            "zh": "比起这个，\n你们不该来这里！",
            "narrator_zh": "燕"
        },
        {
            "location": "305/ACT",
            "narrator": "",
            "text": "会いたかったよ！",
            "zh": "我好想见你！",
            "narrator_zh": ""
        },
        {
            "location": "306/TALK",
            "narrator": "つばめ",
            "text": "ええええっ！\nそ、そうなんですか？",
            "zh": "诶诶诶诶！\n真、真的是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "307/TALK",
            "narrator": "つばめ",
            "text": "あの、その……\nとっ……",
            "zh": "那个，那个……\n特……",
            "narrator_zh": "燕"
        },
        {
            "location": "308/TALK",
            "narrator": "つばめ",
            "text": "とっても嬉しいです…っ。",
            "zh": "特别地高兴……。",
            "narrator_zh": "燕"
        },
        {
            "location": "309/TALK",
            "narrator": "つばめ",
            "text": "わたしも、\nとってもとっても\n逢いたかったですっ！",
            "zh": "我也，\n特别特别\n想见到你！",
            "narrator_zh": "燕"
        },
        {
            "location": "311/TALK",
            "narrator": "みやび",
            "text": "……あの、一応、うち\nいるんやけんど。",
            "zh": "……那个，我人\n还在这边咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "312/SEL",
            "narrator": "",
            "text": "あーごめん",
            "zh": "啊——抱歉",
            "narrator_zh": ""
        },
        {
            "location": "313/SEL",
            "narrator": "",
            "text": "妬いてる？",
            "zh": "你吃醋了？",
            "narrator_zh": ""
        },
        {
            "location": "314/ACT",
            "narrator": "",
            "text": "あーごめん",
            "zh": "啊——抱歉",
            "narrator_zh": ""
        },
        {
            "location": "315/TALK",
            "narrator": "みやび",
            "text": "まったく。\n社長の前でいちゃつくとは\nなっとらんね。",
            "zh": "真是的。\n在社长面前腻歪成这样，\n成何体统。",
            "narrator_zh": "雅"
        },
        {
            "location": "316/ACT",
            "narrator": "",
            "text": "妬いてる？",
            "zh": "你吃醋了？",
            "narrator_zh": ""
        },
        {
            "location": "317/TALK",
            "narrator": "みやび",
            "text": "……頭、沸いちゅうが？",
            "zh": "……脑袋，进水了咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "320/TALK",
            "narrator": "つばめ",
            "text": "って！\nそんなことやってる\n場合じゃないんです！",
            "zh": "我说！\n现在不是做这种事的\n时候啊！",
            "narrator_zh": "燕"
        },
        {
            "location": "324/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんじゃ\nないですか。\nどうもお久し振りです！",
            "zh": "$handle$，\n这不是嘛。\n好久不见！[?]",
            "narrator_zh": "燕"
        },
        {
            "location": "325/SEL",
            "narrator": "",
            "text": "ここは？",
            "zh": "这里是？",
            "narrator_zh": ""
        },
        {
            "location": "326/ACT",
            "narrator": "",
            "text": "ここは？",
            "zh": "这里是？",
            "narrator_zh": ""
        },
        {
            "location": "328/TALK",
            "narrator": "つばめ",
            "text": "ここがどこかは\n答えられません。",
            "zh": "这里是哪里，\n我不能回答。",
            "narrator_zh": "燕"
        },
        {
            "location": "329/TALK",
            "narrator": "つばめ",
            "text": "わたし、ずっと\n監視されてますから。",
            "zh": "因为我一直\n被监视着。",
            "narrator_zh": "燕"
        },
        {
            "location": "330/TALK",
            "narrator": "つばめ",
            "text": "そんなことより、\nここに来たらダメですよ！",
            "zh": "比起这个，\n你们不该来这里！",
            "narrator_zh": "燕"
        },
        {
            "location": "333/TALK",
            "narrator": "つばめ",
            "text": "早くここから\n逃げてください！",
            "zh": "快点从这里\n逃走吧！",
            "narrator_zh": "燕"
        },
        {
            "location": "335/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん、\n一体何が起こっちゅう？",
            "zh": "燕，\n这里到底发生什么了？",
            "narrator_zh": "雅"
        },
        {
            "location": "336/TALK",
            "narrator": "つばめ",
            "text": "そんな話してるヒマ\nありませんから！",
            "zh": "没闲工夫\n说这些啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "337/SEL",
            "narrator": "",
            "text": "なら一緒に逃げよう！",
            "zh": "那就一起逃吧！",
            "narrator_zh": ""
        },
        {
            "location": "338/ACT",
            "narrator": "",
            "text": "なら一緒に逃げよう！",
            "zh": "那就一起逃吧！",
            "narrator_zh": ""
        },
        {
            "location": "341/TALK",
            "narrator": "つばめ",
            "text": "無理ですよ！\nわたしは今、\n再教育中の身なんです！",
            "zh": "不行的！\n我现在\n正在接受再教育！",
            "narrator_zh": "燕"
        },
        {
            "location": "342/TALK",
            "narrator": "つばめ",
            "text": "一挙一動が\n監視されてます！",
            "zh": "一举一动\n都被监视着！",
            "narrator_zh": "燕"
        },
        {
            "location": "343/TALK",
            "narrator": "つばめ",
            "text": "多分もう\nこっちに――",
            "zh": "多半已经\n往这边——",
            "narrator_zh": "燕"
        },
        {
            "location": "375/TALK",
            "narrator": "みやび",
            "text": "…なんや…こいつ。",
            "zh": "…驷马啊……这家伙。",
            "narrator_zh": "雅"
        },
        {
            "location": "376/TALK",
            "narrator": "つばめ",
            "text": "教官さんです……。",
            "zh": "是教官……。",
            "narrator_zh": "燕"
        },
        {
            "location": "377/TALK",
            "narrator": "みやび",
            "text": "なんやて…？",
            "zh": "驷马……？",
            "narrator_zh": "雅"
        },
        {
            "location": "378/TALK",
            "narrator": "？？？",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "？？？"
        },
        {
            "location": "379/TALK",
            "narrator": "？？？",
            "text": "サーチ完了。\nC4:7:000 ――",
            "zh": "搜索完成。\nC4:7:000 ――",
            "narrator_zh": "？？？"
        },
        {
            "location": "380/TALK",
            "narrator": "みやび",
            "text": "なっ！！\nそれ、うちの……\nそんな馬鹿な！？",
            "zh": "什！！\n那个是我的……\n怎么可能！？",
            "narrator_zh": "雅"
        },
        {
            "location": "381/TALK",
            "narrator": "みやび",
            "text": "くっそ…\n迂闊やったか。",
            "zh": "可恶……\n是我大意了吗。",
            "narrator_zh": "雅"
        },
        {
            "location": "382/TALK",
            "narrator": "みやび",
            "text": "相棒…。\nうちのゆうことを\nよく聞きや。",
            "zh": "搭档……。\n把我的话\n好好听清楚。",
            "narrator_zh": "雅"
        },
        {
            "location": "384/SEL",
            "narrator": "",
            "text": "おい！そこの黒いの！！",
            "zh": "喂！那边那个黑色的！！",
            "narrator_zh": ""
        },
        {
            "location": "385/TALK",
            "narrator": "みやび",
            "text": "今からお前さんを\nうちのスフィアに戻す。",
            "zh": "现在就把你\n送回我的领域。",
            "narrator_zh": "雅"
        },
        {
            "location": "394/TALK",
            "narrator": "みやび",
            "text": "それと、今から言うこと\nだけは、絶対に覚えとけ。\n絶対に忘れるな。",
            "zh": "还有，就接下来这句话，\n给我死死记住。\n绝对不许忘。",
            "narrator_zh": "雅"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "カレンディサイプロブ\nイシュリールシンギュ\nラリティー！",
            "zh": "カレンディサイプロブ\nイシュリールシンギュ\nラリティー！[?]",
            "narrator_zh": "雅"
        },
        {
            "location": "396/TALK",
            "narrator": "みやび",
            "text": "うちと\nつばめちゃんからの\nラブコールや。",
            "zh": "是我和\n燕两个人的\n爱的呼唤咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "397/TALK",
            "narrator": "みやび",
            "text": "あとはよろしく\n頼んだで。",
            "zh": "剩下的事就\n拜托你了。",
            "narrator_zh": "雅"
        },
        {
            "location": "399/TALK",
            "narrator": "つばめ",
            "text": "$handle$さん、\nどうかご無事で！",
            "zh": "$handle$，\n千万要平安无事！",
            "narrator_zh": "燕"
        },
        {
            "location": "400/SEL",
            "narrator": "",
            "text": "ちょっと待って！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "401/ACT",
            "narrator": "",
            "text": "ちょっと待って！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "404/ACT",
            "narrator": "",
            "text": "おい！そこの黒いの！！",
            "zh": "喂！那边那个黑色的！！",
            "narrator_zh": ""
        },
        {
            "location": "408/TALK",
            "narrator": "みやび",
            "text": "ドあほ！！\n黙って聞け！！",
            "zh": "大笨蛋！！\n闭嘴给我听着！！",
            "narrator_zh": "雅"
        },
        {
            "location": "409/TALK",
            "narrator": "みやび",
            "text": "カレンディサイプロブ\nイシュリールシンギュ\nラリティー！",
            "zh": "カレンディサイプロブ\nイシュリールシンギュ\nラリティー！[?]",
