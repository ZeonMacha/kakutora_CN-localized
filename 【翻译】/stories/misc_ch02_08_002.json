        {
            "location": "230/SEL",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "231/SEL",
            "narrator": "",
            "text": "アーヤはその兆候はないの？",
