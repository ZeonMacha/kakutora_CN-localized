{
    "dir": "chap11/daydra/dd_ch05_11_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "11502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "独占禁止法？＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "反垄断法？＜前篇＞"
    },
    "entry": [
        {
            "location": "1018/TALK",
            "narrator": "つばめ",
            "text": "――そういうわけで、\n週末はひなこちゃん達と\nおでかけするの。",
            "zh": "——所以说，\n周末要和小雏她们\n一起出去。",
            "narrator_zh": "燕"
        },
        {
            "location": "1020/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん…、\n神楽も一緒なの？",
            "zh": "哼……，\n神乐也一起吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1022/TALK",
            "narrator": "神楽",
            "text": "いえ、その日は私、\n用事があって…。",
            "zh": "不，那天我\n有事……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1023/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんの予定は？",
            "zh": "加布的安排呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "1024/TALK",
            "narrator": "神楽",
            "text": "ちょ、つばめさん。\nそんな風に呼んだら――",
            "zh": "等、燕。\n那样叫的话——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1025/TALK",
            "narrator": "ガブリエラ",
            "text": "部屋でゆっくりする\n予定だけど…。",
            "zh": "打算在房间里\n慢慢待着就是了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1026/TALK",
            "narrator": "神楽",
            "text": "…え？",
            "zh": "……诶？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1028/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、ガブちゃんも\n一緒に行こうよ。",
            "zh": "那就，加布也\n一起去吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "1029/TALK",
            "narrator": "ガブリエラ",
            "text": "い、いいわよ。\nあたしが行ったって\n仕方ないし…。",
            "zh": "行、行啊。\n我去了\n也没用……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1030/TALK",
            "narrator": "つばめ",
            "text": "そんなことないよ。\nみんなも絶対喜ぶと\n思うから！",
            "zh": "没那回事呀。\n大家也绝对会高兴的\n我觉得！",
            "narrator_zh": "燕"
        },
        {
            "location": "1033/TALK",
            "narrator": "ガブリエラ",
            "text": "…し、仕方ないわね。\nそこまで言うなら、\n付き合ってあげるわ。",
            "zh": "……没、没办法。\n你都说到这份上了，\n我就陪你去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1035/TALK",
            "narrator": "つばめ",
            "text": "やったぁー！",
            "zh": "太好了——！",
            "narrator_zh": "燕"
        },
        {
            "location": "1037/TALK",
            "narrator": "神楽",
            "text": "…なんか、二人の仲が\nよくなってるような…？",
            "zh": "……总觉得，两个人的关系\n变好了似的……？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1039/TALK",
            "narrator": "神楽",
            "text": "…って、そんなの私には\n関係ないわね。",
            "zh": "……话说，那种事跟我\n没关系吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1078/TALK",
            "narrator": "みやび",
            "text": "ふぃ～、労働の後の\n風呂は極上ちや…。",
            "zh": "呼——，干完活之后的\n澡算顶级滴……。",
            "narrator_zh": "雅"
        },
        {
            "location": "1081/TALK",
            "narrator": "ガブリエラ",
            "text": "年寄りみたいなこと\n言わないでよ。",
            "zh": "别说得像个\n老人家。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1084/TALK",
            "narrator": "みやび",
            "text": "なに言うちょるが。\nうちはガブちゃんより\n年寄りぞね。",
            "zh": "你在讲什么咧。\n我比加布\n年纪大咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "1086/TALK",
            "narrator": "アーヤ",
            "text": "私の隣で年寄り年寄り\n言わないでもらえる？",
            "zh": "能不能别在我旁边\n一个劲儿老人家啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1093/TALK",
            "narrator": "神楽",
            "text": "…あれ？\n皆さんも来てたんですか？",
            "zh": "……咦？\n大家也来了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1096/TALK",
            "narrator": "アーヤ",
            "text": "あら、お疲れ様。\n卯月の方も\n終わったみたいね。",
            "zh": "哎呀，辛苦了。\n卯月这边\n也结束了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1097/TALK",
            "narrator": "みやび",
            "text": "残業お疲れさん。",
            "zh": "加班辛苦了。",
            "narrator_zh": "雅"
        },
        {
            "location": "1100/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、神楽もさっさと\n身体洗っちゃいなさいよ。\n風邪引くわよ？",
            "zh": "好了，神乐你也赶紧\n把身体洗了。\n会感冒的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1102/TALK",
            "narrator": "神楽",
            "text": "あ、はい。",
            "zh": "啊，好的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1119/TALK",
            "narrator": "みやび",
            "text": "…そういえば、\n気になっちゅうことが\nあるんやけんど。",
            "zh": "……说起来，\n有件事我在意着，\n但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "1121/TALK",
            "narrator": "アーヤ",
            "text": "なにかあったの？",
            "zh": "出什么事了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1123/TALK",
            "narrator": "みやび",
            "text": "うむ…ガブちゃん。\nつばめちゃんと\nなにかあったが？",
            "zh": "嗯……加布。\n和燕\n是不是出了什么事咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "1127/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1129/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、どうして？",
            "zh": "诶，为什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1131/TALK",
            "narrator": "みやび",
            "text": "今日、学校で二人が\n話しちょったのを\n見たんやけんど…。",
            "zh": "今天在学校，\n看到你们两个在讲话，\n但是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "1132/TALK",
            "narrator": "みやび",
            "text": "数日前までに比べて、\n仲良しさんになっちょる\nように見えたがよ。",
            "zh": "比起几天前，\n看起来变得\n要好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "1134/TALK",
            "narrator": "アーヤ",
            "text": "あら、そうなの？",
            "zh": "哎呀，是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1138/TALK",
            "narrator": "ガブリエラ",
            "text": "べ、別に…。\nなんにもなかったから。",
            "zh": "没、没什么……。\n什么都没发生。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1139/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1140/TALK",
            "narrator": "みやび",
            "text": "ふふん、\nまあ、そういうことに\nしておくぞね。",
            "zh": "哼哼，\n嘛，就当成\n是这么回事咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "1143/TALK",
            "narrator": "ガブリエラ",
            "text": "な、なによそれ？\n信じなさいって！",
            "zh": "什、什么啊那是？\n叫你相信啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1147/TALK",
            "narrator": "神楽",
            "text": "えー、それならちゃんと\n教えてくださいよー。",
            "zh": "诶——，那样的话就好好\n告诉我嘛。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1148/TALK",
            "narrator": "神楽",
            "text": "今日のガブちゃんと\nつばめさん、\nとっても仲良しで…。",
            "zh": "今天的加布和\n燕，\n关系非常好……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1149/TALK",
            "narrator": "神楽",
            "text": "私もずーっと\n気になってたんです。",
            "zh": "我也一直\n很在意。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1153/TALK",
            "narrator": "ガブリエラ",
            "text": "だ、だから仲良しに\nなったわけじゃ…。",
            "zh": "所、所以并不是\n变成要好了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1154/TALK",
            "narrator": "神楽",
            "text": "じゃあ、\n何があったんですか？",
            "zh": "那么，\n发生什么了？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1157/TALK",
            "narrator": "ガブリエラ",
            "text": "うっ…もぉ、神楽は\nつばめのことになると\nしつこいんだから…。",
            "zh": "唔……真是的，神乐\n一碰到燕的事\n就纠缠不休……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1159/TALK",
            "narrator": "ガブリエラ",
            "text": "…っていうか、\n別につばめのことは\n嫌ってたわけじゃないわ。",
            "zh": "……话说，\n我又不是\n讨厌燕。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1160/TALK",
            "narrator": "アーヤ",
            "text": "え、そうだったの？",
            "zh": "诶，是这样吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1162/TALK",
            "narrator": "ガブリエラ",
            "text": "だって、嫌う理由なんて\nないじゃない。",
            "zh": "因为，根本没有\n讨厌的理由吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1163/TALK",
            "narrator": "ガブリエラ",
            "text": "なんか、いつも色んな事に\n一生懸命で…。",
            "zh": "就是，不管什么事\n她总是很拼命……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1164/TALK",
            "narrator": "ガブリエラ",
            "text": "特に、他人の幸せのため\nとかになると、\n特に張り切るでしょ？",
            "zh": "尤其一到为了别人的幸福\n之类的时候，\n就特别起劲吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1165/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、元が天然だから、\n勘違いと空回りも\nつきものだけど…。",
            "zh": "……嘛，本来就是天然，\n误会和空转\n也是常有的事……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1166/TALK",
            "narrator": "みやび",
            "text": "夏祭りの時の\nガブちゃんにしたの\nみたいなか？",
            "zh": "像夏日祭的时候\n对加布做的那种\n咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "1168/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そうだけど…、\nその話はもう忘れて！",
            "zh": "是、是那样……，\n那件事快忘掉！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1169/TALK",
            "narrator": "神楽",
            "text": "…嫌いじゃなかった、\nっていうのは\nわかりましたけど…。",
            "zh": "……说并不讨厌，\n这点我明白了\n就是了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1170/TALK",
            "narrator": "神楽",
            "text": "距離を開けるのを\nやめたのは、\nどうしてなんですか？",
            "zh": "不再保持距离，\n又是为什么\n呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1172/TALK",
            "narrator": "ガブリエラ",
            "text": "…バカみたいに\n思えたのよ。",
            "zh": "……觉得那样的自己\n很傻。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1173/TALK",
            "narrator": "ガブリエラ",
            "text": "普通に一生懸命で\nいい子ちゃんな\nつばめに対して…。",
            "zh": "对着普通地拼命、\n又是个好孩子的\n燕……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1174/TALK",
            "narrator": "ガブリエラ",
            "text": "いつまでもあんな態度を\n取ってる自分がね。",
            "zh": "自己却一直摆出\n那种态度。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1175/TALK",
            "narrator": "神楽",
            "text": "…そうだったんですか。",
            "zh": "……是这样啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1177/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、よかった。\nギャヴィとつばめが\n仲良くなってくれて。",
            "zh": "呵呵，太好了。\n加维和燕\n能变得要好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1179/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、だから別に\n仲良くなったわけじゃ…。",
            "zh": "不，所以并不是\n变得要好了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1180/TALK",
            "narrator": "神楽",
            "text": "でも、つばめさんも\nとっても嬉しそうでした。",
            "zh": "可是，燕也\n看起来非常高兴。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1182/TALK",
            "narrator": "神楽",
            "text": "見てる私も\n嬉しかったです。",
            "zh": "看着的我\n也很高兴。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1183/TALK",
            "narrator": "みやび",
            "text": "少人数のチームやきね。\n仲良しさんでいるんが\n一番ぞね。",
            "zh": "人少的队伍啵。\n关系好着\n才是最好咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "1184/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、それについては\n否定しないけど。",
            "zh": "……嘛，这一点\n我不否认。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1186/TALK",
            "narrator": "神楽",
            "text": "…本当、よかった。",
            "zh": "……真的，太好了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1187/TALK",
            "narrator": "神楽",
            "text": "…あれ？",
            "zh": "……咦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1188/TALK",
            "narrator": "アーヤ",
            "text": "どうかした？",
            "zh": "怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1190/TALK",
            "narrator": "神楽",
            "text": "あ、いえ…。",
            "zh": "啊，没什么……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1194/TALK",
            "narrator": "神楽",
            "text": "今…私、喜んでた…？",
            "zh": "刚才……我，在高兴……？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1195/TALK",
            "narrator": "神楽",
            "text": "つばめさんとガブちゃんが\n仲良くなったの…。",
            "zh": "燕和加布\n变得要好了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1196/TALK",
            "narrator": "神楽",
            "text": "演技じゃなくて、\n本当に喜んでた…。",
            "zh": "不是在演戏，\n是真的在高兴……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1198/TALK",
            "narrator": "神楽",
            "text": "っ！！",
            "zh": "唔！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1199/TALK",
            "narrator": "神楽",
            "text": "なに考えてるの！？\nつばめさんは、\n音羽を壊したのよ？",
            "zh": "你在想什么！？\n燕，\n可是毁掉了音羽啊？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1201/TALK",
            "narrator": "神楽",
            "text": "だから、絶対に好きに\nなったりしたら\nいけないのに…。",
            "zh": "所以，绝对不能\n喜欢上\n才对……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1250/TALK",
            "narrator": "ぴょんこ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1291/TALK",
            "narrator": "ぴょんこ",
            "text": "ぴょんこです♪",
            "zh": "我是蹦子♪",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1293/TALK",
            "narrator": "アーヤ",
            "text": "こんにちは。",
            "zh": "你好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1294/SEL",
            "narrator": "",
            "text": "前回は…大丈夫そうだね",
            "zh": "上次的话……看起来没事呢",
            "narrator_zh": ""
        },
        {
            "location": "1295/SEL",
            "narrator": "",
            "text": "落ち着いたところで、アーヤに聞きたいことがある",
            "zh": "安定下来了，有事想问绫水",
            "narrator_zh": ""
        },
        {
            "location": "1296/ACT",
            "narrator": "",
            "text": "前回は…大丈夫そうだね",
            "zh": "上次的话……看起来没事呢",
            "narrator_zh": ""
        },
