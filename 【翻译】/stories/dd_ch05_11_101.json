            "location": "1470/TALK",
            "narrator": "ぴょんこ",
            "text": "それじゃ早速――",
            "zh": "那就马上——",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1472/ACT",
            "narrator": "",
            "text": "やらない",
            "zh": "不来",
            "narrator_zh": ""
        },
        {
            "location": "1474/ACT",
            "narrator": "",
            "text": "キスチケってなに？",
            "zh": "接吻券是什么？",
            "narrator_zh": ""
        },
        {
            "location": "1475/TALK",
            "narrator": "ぴょんこ",
            "text": "３枚集めると、\nぴょんこと素敵なキスが\nできるチケットです♪",
            "zh": "集齐3张，\n就能和蹦子来一次\n美妙的接吻哦♪",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1476/TALK",
            "narrator": "ぴょんこ",
            "text": "ジャンケンして\n$handle$さんが\n勝ったら進呈しますけど…",
            "zh": "猜拳的话，\n$handle$\n赢了我就赠送……",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1477/TALK",
            "narrator": "ぴょんこ",
            "text": "逆に負けたら、\n一枚没収しますっ！",
            "zh": "反过来要是输了，\n就没收一张！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1478/TALK",
            "narrator": "ぴょんこ",
            "text": "ジャンケンは\n1回しかできませんから、\n一発勝負ですよっ♪",
            "zh": "猜拳\n只能进行1次，\n是一发定胜负哦♪",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1479/TALK",
            "narrator": "ぴょんこ",
            "text": "さあっ。\nやりますか？\nやりませんかっ！",
            "zh": "来吧。\n要做吗？\n不做吗！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1480/SEL",
            "narrator": "",
            "text": "やる",
            "zh": "来",
            "narrator_zh": ""
        },
        {
            "location": "1481/SEL",
            "narrator": "",
            "text": "やらない",
            "zh": "不来",
            "narrator_zh": ""
        },
        {
            "location": "1482/ACT",
            "narrator": "",
            "text": "やる",
            "zh": "来",
            "narrator_zh": ""
        },
        {
            "location": "1484/ACT",
            "narrator": "",
            "text": "やらない",
            "zh": "不来",
            "narrator_zh": ""
        },
        {
            "location": "1501/TALK",
            "narrator": "ぴょんこ",
            "text": "きたっ！！",
            "zh": "来了！！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1502/SEL",
            "narrator": "",
            "text": "来たね",
            "zh": "来了呢",
            "narrator_zh": ""
        },
        {
            "location": "1503/ACT",
            "narrator": "",
            "text": "来たね",
            "zh": "来了呢",
            "narrator_zh": ""
        },
        {
            "location": "1506/TALK",
            "narrator": "ぴょんこ",
            "text": "はぁ……",
            "zh": "哈啊……",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1507/TALK",
            "narrator": "ぴょんこ",
            "text": "せっかくの\nちゅータイムだったのに\n残念でしたね。",
            "zh": "明明是难得的\n亲亲时间，\n真可惜呢。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1508/TALK",
            "narrator": "ぴょんこ",
            "text": "落ち着いたときに\nじっくりやりましょうね。",
            "zh": "等安定下来\n再慢慢来吧。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1510/TALK",
            "narrator": "ぴょんこ",
            "text": "はぁ、これで今回も\n二人だけの時間は\nおしまいですね…。",
            "zh": "哈啊，这样这次也是，\n只有两个人的时间\n到此为止了……。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1514/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと、ぴょんこ！",
            "zh": "等等，蹦子！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1524/TALK",
            "narrator": "ぴょんこ",
            "text": "ガブちゃん！",
            "zh": "加布！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1525/TALK",
            "narrator": "ガブリエラ",
            "text": "何モタモタしてるのよ。\nさっさとクランを\n倒しにいくわよ！",
            "zh": "磨蹭什么呢。\n赶紧去打倒\n库兰啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1526/TALK",
            "narrator": "ぴょんこ",
            "text": "あっ、えっと、\nそれがまだ扉を\n回してなくて……",
            "zh": "啊，那个，\n还没把扉\n转起来……",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1527/TALK",
            "narrator": "ガブリエラ",
            "text": "はあっ！？",
            "zh": "哈啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1528/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたたち、\n今まで何やってたのよ。",
            "zh": "你们，\n到现在到底在干什么啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1529/SEL",
            "narrator": "",
            "text": "ごめん",
            "zh": "对不起",
            "narrator_zh": ""
        },
        {
            "location": "1530/SEL",
            "narrator": "",
            "text": "ちょっと楽しいことを…",
            "zh": "做了点开心的事……",
            "narrator_zh": ""
        },
        {
            "location": "1531/ACT",
            "narrator": "",
            "text": "ごめん",
            "zh": "对不起",
            "narrator_zh": ""
        },
        {
            "location": "1533/TALK",
            "narrator": "ガブリエラ",
            "text": "謝るくらいなら\n準備しておきなさいよ。\n生き残る気あんの！？",
            "zh": "要道歉的话\n就先准备好啊。\n还想活着吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1534/TALK",
            "narrator": "ぴょんこ",
            "text": "もちろんですっ！",
            "zh": "当然想！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1535/ACT",
            "narrator": "",
            "text": "ちょっと楽しいことを…",
            "zh": "做了点开心的事……",
            "narrator_zh": ""
        },
        {
            "location": "1539/TALK",
            "narrator": "ガブリエラ",
            "text": "はあっ！？\nな、なによ、\nたのしいことって……",
            "zh": "哈啊！？\n什、什么啊，\n开心的事是……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1541/TALK",
            "narrator": "ぴょんこ",
            "text": "$handle$さんってば\nガブちゃんにその言い方は\n刺激が強すぎですよっ！",
            "zh": "$handle$对\n加布用那种说法，\n刺激太强了哦！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1543/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1545/TALK",
            "narrator": "ガブリエラ",
            "text": "二人していっぺん\nラグナロクにでも\n行ってくればいいのよ……",
            "zh": "你们两个干脆\n一起去拉格纳罗克\n算了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1548/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら！\n早く扉を回して！",
            "zh": "好了！\n快点把扉转起来！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1550/TALK",
            "narrator": "ぴょんこ",
            "text": "は、はいっ！",
            "zh": "是、是的！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1553/TALK",
            "narrator": "ぴょんこ",
            "text": "オープンプロセス、\n2x99F番地から\n2xACD番地へ。",
            "zh": "开放进程，\n从2x99F地址\n到2xACD地址。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1578/TALK",
            "narrator": "ぴょんこ",
            "text": "シーク完了。",
            "zh": "搜索完成。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1580/TALK",
            "narrator": "ぴょんこ",
            "text": "今回の悩みは…と……",
            "zh": "这次的烦恼是……那么……",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1582/TALK",
            "narrator": "ぴょんこ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1583/TALK",
            "narrator": "ぴょんこ",
            "text": "音羽を壊した\nつばめさんへの\n憎しみと――",
            "zh": "对毁掉音羽的\n燕的\n憎恨——",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1584/TALK",
            "narrator": "ぴょんこ",
            "text": "普段のかわいい\nつばめさんへの愛情が\n二律背反を起こしてます。",
            "zh": "和对平时可爱的\n燕的爱意，\n正在发生二律背反。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1585/SEL",
            "narrator": "",
            "text": "今回のは強い葛藤なの？",
            "zh": "这次的挣扎很强吗？",
            "narrator_zh": ""
        },
        {
            "location": "1586/ACT",
            "narrator": "",
            "text": "今回のは強い葛藤なの？",
            "zh": "这次的挣扎很强吗？",
            "narrator_zh": ""
        },
        {
            "location": "1589/TALK",
            "narrator": "ぴょんこ",
            "text": "かなり強いと思います！",
            "zh": "我觉得相当强！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1590/TALK",
            "narrator": "ぴょんこ",
            "text": "早くクランを倒して\n心を落ち着かせないと！",
            "zh": "得快点打倒库兰，\n让心安定下来！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1591/TALK",
            "narrator": "ガブリエラ",
            "text": "なかなか強そうね。\n腕が鳴るわ。",
            "zh": "看起来挺强的。\n手都痒了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1593/TALK",
            "narrator": "ぴょんこ",
            "text": "すみません、\nご迷惑お掛けしちゃって。",
            "zh": "对不起，\n给你添麻烦了。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1594/TALK",
            "narrator": "ガブリエラ",
            "text": "もう…何言ってるのよ。\nあたしが自分で\nここに来てるんだから。",
            "zh": "真是……你在说什么。\n是我自己\n来这里的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1596/TALK",
            "narrator": "ガブリエラ",
            "text": "……その。",
            "zh": "……那个。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1597/TALK",
            "narrator": "ガブリエラ",
            "text": "友達でしょ？",
            "zh": "是朋友吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1598/TALK",
            "narrator": "ぴょんこ",
            "text": "…！！",
            "zh": "……！！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1599/TALK",
            "narrator": "ぴょんこ",
            "text": "はいっ！",
            "zh": "是的！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1602/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、いくわよ！",
            "zh": "那就，走了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1604/TALK",
            "narrator": "ぴょんこ",
            "text": "$handle$さんも、\nよろしくお願いしますっ！",
            "zh": "$handle$也，\n请多关照！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1605/TALK",
            "narrator": "ぴょんこ",
            "text": "ガブちゃんとぴょんこと\n$handle$さんに、\n素敵なココロの旅をっ！",
            "zh": "愿加布和蹦子\n与$handle$，\n有一段美妙的心灵之旅！",
            "narrator_zh": "蹦子"
        },
        {
