            "narrator": "INFO",
            "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=green>【キスチケ】</color>を\n１枚ゲットしました！",
            "zh": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=green>【接吻券】</color>拿到了\n1张！",
            "narrator_zh": "INFO"
        },
        {
            "location": "1453/DIALOG",
            "narrator": "INFO",
