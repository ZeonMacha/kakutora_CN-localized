{
    "dir": "chap06/daydra/dd_ch03_06_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "6305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "出陣【Case：ガブリエラ】＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "出阵【Case：加布里埃拉】＜后篇＞"
    },
    "entry": [
        {
            "location": "267/SCENARIO",
            "narrator": "",
            "text": "出陣【ギャヴィから見たCase】",
            "zh": "出阵【从加维看到的Case】",
            "narrator_zh": ""
        },
        {
            "location": "296/TALK",
            "narrator": "ガブリエラ",
            "text": "…この手を握れば、\n仲直りできる…かな？",
            "zh": "……握住这只手，\n就能和好……吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "297/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "309/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "312/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対に嫌。\n子供じゃあるまいし。",
            "zh": "绝对不要。\n我又不是小孩子。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "313/TALK",
            "narrator": "つばめ",
            "text": "そ、そうですか…。",
            "zh": "是、是吗……。",
            "narrator_zh": "燕"
        },
        {
            "location": "315/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、そんなに\nイジワル言わないの。",
            "zh": "加维，别那么\n刻薄。",
            "narrator_zh": "绫水"
        },
        {
            "location": "318/TALK",
            "narrator": "ガブリエラ",
            "text": "な、なによ？\nまた新人の味方するわけ？",
            "zh": "什、什么？\n又要帮新人？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "319/TALK",
            "narrator": "アーヤ",
            "text": "新人だと思うなら、\n手くらい繋いであげても\nいいんじゃない？",
            "zh": "既然觉得是新人，\n牵个手\n也没关系吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "322/TALK",
            "narrator": "ガブリエラ",
            "text": "むっ…。",
            "zh": "呣……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "323/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりダメよ。",
            "zh": "果然还是不行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対に気を許したらダメ。\n自分の直感を信じなくちゃ。",
            "zh": "绝对不能放松警惕。\n必须相信自己的直觉。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "327/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり嫌よ。",
            "zh": "果然还是讨厌。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "328/TALK",
            "narrator": "ガブリエラ",
            "text": "フェノメノンの中で、\nわざわざリスクを冒すような\nことしたくないし。",
            "zh": "在PhenoMENON里，\n我不想特意去\n冒那种风险。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "330/TALK",
            "narrator": "つばめ",
            "text": "…？\nリスク……って…？",
            "zh": "……？\n风险……是……？",
            "narrator_zh": "燕"
        },
        {
            "location": "331/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "343/TALK",
            "narrator": "ガブリエラ",
            "text": "私って嫌な子かも",
            "zh": "我也许是个讨厌的孩子",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "344/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナもそう思う？",
            "zh": "玛尔赞娜也这么想？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "346/SEL",
            "narrator": "",
            "text": "そんなことないよ",
            "zh": "没有那种事",
            "narrator_zh": ""
        },
        {
            "location": "347/ACT",
            "narrator": "",
            "text": "そんなことないよ",
            "zh": "没有那种事",
            "narrator_zh": ""
        },
        {
            "location": "349/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう",
            "zh": "谢谢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "350/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、そんなことあるわ",
            "zh": "可是，就是有那种事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "351/TALK",
            "narrator": "ガブリエラ",
            "text": "多分つばめは、怖いからだけじゃなくて",
            "zh": "大概燕不只是因为害怕",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "352/TALK",
            "narrator": "ガブリエラ",
            "text": "私のことを気遣って、言ってくれてるんだと思う",
            "zh": "也是在关心我，才这么说的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "353/TALK",
            "narrator": "ガブリエラ",
            "text": "突っぱねた対応しちゃってるし",
            "zh": "我却一直拒绝",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "355/SEL",
            "narrator": "",
            "text": "つばめのことが嫌いなの？",
            "zh": "讨厌燕吗？",
            "narrator_zh": ""
        },
        {
            "location": "356/ACT",
            "narrator": "",
            "text": "つばめのことが嫌いなの？",
            "zh": "讨厌燕吗？",
            "narrator_zh": ""
        },
        {
            "location": "358/TALK",
            "narrator": "ガブリエラ",
            "text": "そうじゃないの",
            "zh": "不是那样",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "359/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめのことは嫌いじゃないの",
            "zh": "我并不讨厌燕",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "360/TALK",
            "narrator": "ガブリエラ",
            "text": "けど",
            "zh": "可是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "361/TALK",
            "narrator": "ガブリエラ",
            "text": "凄く怖いの",
            "zh": "非常害怕",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "362/TALK",
            "narrator": "ガブリエラ",
            "text": "あのドームでの戦いの時に見せたあの雰囲気",
            "zh": "穹顶那场战斗时她露出的那种气氛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "363/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、あの目",
            "zh": "还有，那双眼睛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "364/TALK",
            "narrator": "ガブリエラ",
            "text": "ポーランドにいた頃に何度か見たことがあるの",
            "zh": "在波兰的时候我见过几次",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "365/TALK",
            "narrator": "ガブリエラ",
            "text": "あの目は",
            "zh": "那双眼睛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "367/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、何でもない",
            "zh": "果然，没什么",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "368/TALK",
            "narrator": "ガブリエラ",
            "text": "今はフェノメノンのことに集中しなくちゃ",
            "zh": "现在必须集中在PhenoMENON上",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "369/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "370/TALK",
            "narrator": "ガブリエラ",
            "text": "また後でお話聞いてね",
            "zh": "之后再听我说哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "415/TALK",
            "narrator": "アーヤ",
            "text": "…そろそろ出口ね。",
            "zh": "……快到出口了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "416/TALK",
            "narrator": "アーヤ",
            "text": "各自、準備はいい？\n行くわよ！",
            "zh": "各自，准备好了吗？\n出发！",
            "narrator_zh": "绫水"
        },
        {
            "location": "427/DIALOG",
            "narrator": "Dialog_chapter_ch03",
            "text": "【04 レッドサイト】",
            "zh": "【04 赤红视线】",
            "narrator_zh": "Dialog_chapter_ch03"
        }
    ]
}
