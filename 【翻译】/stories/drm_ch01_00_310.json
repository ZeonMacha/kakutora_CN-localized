            "narrator_zh": "燕"
        },
        {
            "location": "121/TALK",
            "narrator": "つばめ",
            "text": "そうだね",
            "zh": "是呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "122/TALK",
            "narrator": "つばめ",
            "text": "そうしてみるヽ(･ω･ )ゝ",
