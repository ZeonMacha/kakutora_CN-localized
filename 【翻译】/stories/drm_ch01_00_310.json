    "info": {
        "story_id": "1031",
        "cid": "tsubame",
        "title": "らぶとーく 第31話",
        "sub_title": "答えがあるなら",
        "title_zh": "恋爱漫谈 第31话",
        "sub_title_zh": "若是有答案"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "答えがあるなら",
            "zh": "若是有答案",
            "narrator_zh": ""
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "相談に乗って欲しいです(´つω・｀)",
            "zh": "想请你帮我出出主意(´つω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "33/TALK",
            "narrator": "つばめ",
            "text": "ぁたしのすごく大事なお友達に嫌われたかもしれません。(＠´,,・ω・,,｀＠)\nでもぁたしは、とてもその子のことが心配なんです。",
            "zh": "我好像被我非常重要的朋友讨厌了。(＠´,,・ω・,,｀＠)\n可我真的非常担心那孩子。",
            "narrator_zh": "燕"
        },
        {
            "location": "34/TALK",
            "narrator": "つばめ",
            "text": "元気を出してもらうにはどうすればいいのかなヽ(；▽；)ノ？",
            "zh": "该怎么做才能让她打起精神来呀ヽ(；▽；)ノ？",
            "narrator_zh": "燕"
        },
        {
            "location": "36/SEL",
            "narrator": "",
            "text": "もう少し詳しく話して",
            "zh": "再多说点细节",
            "narrator_zh": ""
        },
        {
            "location": "37/TALK",
            "narrator": "つばめ",
            "text": "最後に会った時はその子はすごく怒ってた",
            "zh": "最后一次见面的时候，那孩子非常生气",
            "narrator_zh": "燕"
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "でもそれは、ぁたしにじゃないような気もするの",
            "zh": "不过那感觉不像是对我",
            "narrator_zh": "燕"
        },
        {
            "location": "40/TALK",
            "narrator": "つばめ",
            "text": "でもそんな風にぁたしが思いたいだけじゃないのかなっても思ってるの",
            "zh": "不过我总觉得，也许只是我自己想这么想而已",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "どっちなのかな",
            "zh": "是哪边呢",
            "narrator_zh": "燕"
        },
        {
            "location": "43/ACT",
            "narrator": "",
            "text": "もう少し詳しく話して",
            "zh": "再多说点细节",
            "narrator_zh": ""
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "ぇっと",
            "zh": "那个",
            "narrator_zh": "燕"
        },
        {
            "location": "49/TALK",
            "narrator": "つばめ",
            "text": "その子のこと？",
            "zh": "那孩子的事？",
            "narrator_zh": "燕"
        },
        {
            "location": "51/SEL",
            "narrator": "",
            "text": "その子が怒る前に何があったの？",
            "zh": "那孩子发火之前出了什么事？",
            "narrator_zh": ""
        },
        {
            "location": "52/SEL",
            "narrator": "",
            "text": "誰の話をしているの？",
            "zh": "你在说谁的事？",
            "narrator_zh": ""
        },
        {
            "location": "53/ACT",
            "narrator": "",
            "text": "その子が怒る前に何があったの？",
            "zh": "那孩子发火之前出了什么事？",
            "narrator_zh": ""
        },
        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "トライナリーに来なくなったの",
            "zh": "她不来三重奏了",
            "narrator_zh": "燕"
        },
        {
            "location": "56/TALK",
            "narrator": "つばめ",
            "text": "だからぁたし、卯月さんのおうちに迎えに行ったの",
            "zh": "所以我去卯月家接人了",
            "narrator_zh": "燕"
        },
        {
            "location": "57/ACT",
            "narrator": "",
            "text": "誰の話をしているの？",
            "zh": "你在说谁的事？",
            "narrator_zh": ""
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "卯月さん",
            "zh": "卯月",
            "narrator_zh": "燕"
        },
        {
            "location": "60/TALK",
            "narrator": "つばめ",
            "text": "卯月さん、トライナリーに来なくなったから",
            "zh": "因为卯月不来三重奏了",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "だからぁたし、卯月さんのおうちに迎えに行ったの",
            "zh": "所以我去卯月家接人了",
            "narrator_zh": "燕"
        },
        {
            "location": "63/TALK",
            "narrator": "つばめ",
            "text": "でもおかあさんがちょっと変だったの(´・ω・｀)",
            "zh": "不过妈妈有点奇怪(´·ω·`)",
            "narrator_zh": "燕"
        },
        {
            "location": "64/TALK",
            "narrator": "つばめ",
            "text": "その話はしないでって言われたから気にしないようにしたけど",
            "zh": "你叫我别在意那件事，我就没在意，可是",
            "narrator_zh": "燕"
        },
        {
            "location": "65/TALK",
            "narrator": "つばめ",
            "text": "やっぱりちょっとおかしぃ・・・",
            "zh": "果然还是有点奇怪……",
            "narrator_zh": "燕"
        },
        {
            "location": "68/SEL",
            "narrator": "",
            "text": "指摘すればよかったのに",
            "zh": "你早该指出来了",
            "narrator_zh": ""
        },
        {
            "location": "69/SEL",
            "narrator": "",
            "text": "触れられたくないことってあるよ",
            "zh": "有些事确实不想被人碰",
            "narrator_zh": ""
        },
        {
            "location": "70/ACT",
            "narrator": "",
            "text": "指摘すればよかったのに",
            "zh": "你早该指出来了",
            "narrator_zh": ""
        },
        {
            "location": "71/TALK",
            "narrator": "つばめ",
            "text": "それは・・・",
            "zh": "那个……",
            "narrator_zh": "燕"
        },
        {
            "location": "72/TALK",
            "narrator": "つばめ",
            "text": "触れちゃいけないことだって",
            "zh": "不能去碰触的事",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "つばめ",
            "text": "ぁたしにだってわかるよヾ(｡>﹏<｡)ﾉﾞ",
            "zh": "连我也是懂的呀ヾ(｡>﹏<｡)ﾉﾞ",
            "narrator_zh": "燕"
        },
        {
            "location": "74/ACT",
            "narrator": "",
            "text": "触れられたくないことってあるよ",
            "zh": "有些事确实不想被人碰",
            "narrator_zh": ""
        },
        {
            "location": "75/TALK",
            "narrator": "つばめ",
            "text": "うん・・・",
            "zh": "嗯……",
            "narrator_zh": "燕"
        },
        {
            "location": "76/TALK",
            "narrator": "つばめ",
            "text": "そうなんだけど・・・",
            "zh": "是这样，不过・・・",
            "narrator_zh": "燕"
        },
        {
            "location": "77/TALK",
            "narrator": "つばめ",
            "text": "ゃっぱりょくなかったよね(´・ω・｀)",
            "zh": "果然那样不太好对吧(´・ω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "それで",
            "zh": "所以",
            "narrator_zh": "燕"
        },
        {
            "location": "80/TALK",
            "narrator": "つばめ",
            "text": "ぁたしは卯月さんが隠したかったこととか知っちゃったのかもしれなぃんだ",
            "zh": "我大概是不小心知道了卯月想隐瞒的事吧",
            "narrator_zh": "燕"
        },
        {
            "location": "81/TALK",
            "narrator": "つばめ",
            "text": "それがダメなのかもしれないし",
            "zh": "那也许不行吧",
            "narrator_zh": "燕"
        },
        {
            "location": "82/TALK",
            "narrator": "つばめ",
            "text": "ぁたしのことが単純に嫌いなのかもしれなぃなって思ってるのヽ(；▽；)ノ",
            "zh": "我在想，也许她单纯就是讨厌我吧ヽ(；▽；)ノ",
            "narrator_zh": "燕"
        },
        {
            "location": "84/SEL",
            "narrator": "",
            "text": "嫌いなのかもね",
            "zh": "也许是讨厌吧",
            "narrator_zh": ""
        },
        {
            "location": "85/SEL",
            "narrator": "",
            "text": "そんなことないよ",
            "zh": "不会有那种事哦",
            "narrator_zh": ""
        },
        {
            "location": "86/SEL",
            "narrator": "",
            "text": "落ち着くまで待ってあげよう",
            "zh": "等她冷静下来吧",
            "narrator_zh": ""
        },
        {
            "location": "87/TALK",
            "narrator": "つばめ",
            "text": "そぅ思うと",
            "zh": "这么一想",
            "narrator_zh": "燕"
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "なんか",
            "zh": "总觉得",
            "narrator_zh": "燕"
        },
        {
            "location": "89/TALK",
            "narrator": "つばめ",
            "text": "すごく",
            "zh": "非常",
            "narrator_zh": "燕"
        },
        {
            "location": "91/TALK",
            "narrator": "つばめ",
            "text": "辛ぃの",
            "zh": "难受",
            "narrator_zh": "燕"
        },
        {
            "location": "92/ACT",
            "narrator": "",
            "text": "嫌いなのかもね",
            "zh": "也许是讨厌吧",
            "narrator_zh": ""
        },
        {
            "location": "94/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "燕"
        },
        {
            "location": "95/TALK",
            "narrator": "つばめ",
            "text": "しかたないのかもね(´つω・｀)",
            "zh": "这也是没办法的事吧(´つω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "96/ACT",
            "narrator": "",
            "text": "そんなことないよ",
            "zh": "不会有那种事哦",
            "narrator_zh": ""
        },
        {
            "location": "97/TALK",
            "narrator": "つばめ",
            "text": "だったら",
            "zh": "那样的话",
            "narrator_zh": "燕"
        },
        {
            "location": "98/TALK",
            "narrator": "つばめ",
            "text": "ぃぃよね(´･ω･｀) ",
            "zh": "这样就好吧(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "99/ACT",
            "narrator": "",
            "text": "落ち着くまで待ってあげよう",
            "zh": "等她冷静下来吧",
            "narrator_zh": ""
        },
        {
            "location": "109/TALK",
            "narrator": "つばめ",
            "text": "待ってあげるの・・・？",
            "zh": "要等她吗……？",
            "narrator_zh": "燕"
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "そうしたら",
            "zh": "那样的话",
            "narrator_zh": "燕"
        },
        {
            "location": "111/TALK",
            "narrator": "つばめ",
            "text": "また",
            "zh": "偏偏",
            "narrator_zh": "燕"
        },
        {
            "location": "112/TALK",
            "narrator": "つばめ",
            "text": "話してくれるかな・・・？",
            "zh": "还会跟我说话吗……？",
