 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "答えがあるなら"
  },
  {
   "location": "32/TALK",
   "narrator": "つばめ",
   "text": "相談に乗って欲しいです(´つω・｀)"
  },
  {
   "location": "33/TALK",
   "narrator": "つばめ",
   "text": "ぁたしのすごく大事なお友達に嫌われたかもしれません。(＠´,,・ω・,,｀＠)\nでもぁたしは、とてもその子のことが心配なんです。"
  },
  {
   "location": "34/TALK",
   "narrator": "つばめ",
   "text": "元気を出してもらうにはどうすればいいのかなヽ(；▽；)ノ？"
  },
  {
   "location": "36/SEL",
   "narrator": "",
   "text": "もう少し詳しく話して",
   "zh": "再多说点细节",
   "narrator_zh": ""
  },
  {
   "location": "37/TALK",
   "narrator": "つばめ",
   "text": "最後に会った時はその子はすごく怒ってた"
  },
  {
   "location": "38/TALK",
   "narrator": "つばめ",
   "text": "でもそれは、ぁたしにじゃないような気もするの",
   "zh": "不过那感觉不像是对我",
   "narrator_zh": "燕"
  },
  {
   "location": "40/TALK",
   "narrator": "つばめ",
   "text": "でもそんな風にぁたしが思いたいだけじゃないのかなっても思ってるの",
   "zh": "不过我总觉得，也许只是我自己想这么想而已",
   "narrator_zh": "燕"
  },
  {
   "location": "41/TALK",
   "narrator": "つばめ",
   "text": "どっちなのかな",
   "zh": "是哪边呢",
   "narrator_zh": "燕"
  },
  {
   "location": "43/ACT",
   "narrator": "",
   "text": "もう少し詳しく話して",
   "zh": "再多说点细节",
   "narrator_zh": ""
  },
  {
   "location": "45/TALK",
   "narrator": "つばめ",
   "text": "ぇっと",
   "zh": "那个",
   "narrator_zh": "燕"
  },
  {
   "location": "49/TALK",
   "narrator": "つばめ",
   "text": "その子のこと？",
   "zh": "那孩子的事？",
   "narrator_zh": "燕"
  },
  {
   "location": "51/SEL",
   "narrator": "",
   "text": "その子が怒る前に何があったの？",
   "zh": "那孩子发火之前出了什么事？",
   "narrator_zh": ""
  },
  {
   "location": "52/SEL",
   "narrator": "",
   "text": "誰の話をしているの？",
   "zh": "你在说谁的事？",
   "narrator_zh": ""
  },
  {
   "location": "53/ACT",
   "narrator": "",
   "text": "その子が怒る前に何があったの？",
   "zh": "那孩子发火之前出了什么事？",
   "narrator_zh": ""
  },
  {
   "location": "55/TALK",
   "narrator": "つばめ",
   "text": "トライナリーに来なくなったの"
  },
  {
   "location": "56/TALK",
   "narrator": "つばめ",
   "text": "だからぁたし、卯月さんのおうちに迎えに行ったの",
   "zh": "所以我去卯月家接人了",
   "narrator_zh": "燕"
  },
  {
   "location": "57/ACT",
   "narrator": "",
   "text": "誰の話をしているの？",
   "zh": "你在说谁的事？",
   "narrator_zh": ""
  },
  {
   "location": "58/TALK",
   "narrator": "つばめ",
   "text": "卯月さん",
   "zh": "卯月",
   "narrator_zh": "燕"
  },
  {
   "location": "60/TALK",
   "narrator": "つばめ",
   "text": "卯月さん、トライナリーに来なくなったから"
  },
  {
   "location": "61/TALK",
   "narrator": "つばめ",
   "text": "だからぁたし、卯月さんのおうちに迎えに行ったの",
   "zh": "所以我去卯月家接人了",
   "narrator_zh": "燕"
  },
  {
   "location": "63/TALK",
   "narrator": "つばめ",
   "text": "でもおかあさんがちょっと変だったの(´・ω・｀)",
