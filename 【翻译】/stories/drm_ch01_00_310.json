   "narrator_zh": "燕"
  },
  {
   "location": "64/TALK",
   "narrator": "つばめ",
   "text": "その話はしないでって言われたから気にしないようにしたけど",
   "zh": "你叫我别在意那件事，我就没在意，可是",
   "narrator_zh": "燕"
  },
  {
   "location": "65/TALK",
   "narrator": "つばめ",
   "text": "やっぱりちょっとおかしぃ・・・"
  },
  {
   "location": "68/SEL",
   "narrator": "",
   "text": "指摘すればよかったのに",
   "zh": "你早该指出来了",
   "narrator_zh": ""
  },
  {
   "location": "69/SEL",
   "narrator": "",
   "text": "触れられたくないことってあるよ",
   "zh": "有些事确实不想被人碰",
   "narrator_zh": ""
  },
  {
   "location": "70/ACT",
   "narrator": "",
   "text": "指摘すればよかったのに",
