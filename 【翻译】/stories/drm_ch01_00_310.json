  {
   "location": "72/TALK",
   "narrator": "つばめ",
   "text": "触れちゃいけないことだって"
  },
  {
   "location": "73/TALK",
   "narrator": "つばめ",
   "text": "ぁたしにだってわかるよヾ(｡>﹏<｡)ﾉﾞ"
