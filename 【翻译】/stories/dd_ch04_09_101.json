{
    "dir": "chap09/daydra/dd_ch04_09_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "9402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "コイガサキの日常＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "恋之崎的日常＜前篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "コイガサキの日常",
            "zh": "恋之崎的日常",
            "narrator_zh": ""
        },
        {
            "location": "30/TALK",
            "narrator": "みやび",
            "text": "ん…んんっ…。",
            "zh": "嗯……嗯嗯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "31/TALK",
            "narrator": "みやび",
            "text": "くぁ～…。\nもう朝かぁ…。",
            "zh": "咕哇～……。\n已经早上了啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "おはよう。\nとても暖かい。",
            "zh": "早上好。\n好暖和。",
            "narrator_zh": "雅"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "36/TALK",
            "narrator": "みやび",
            "text": "二度寝こそこの世の\n至福。",
            "zh": "回笼觉才是这个\n世界的至福。",
            "narrator_zh": "雅"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "準備しよ。",
            "zh": "准备吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "ふぅ…さっぱりや。",
            "zh": "呼……清爽多了。",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "…と、早く着替えんと\n遅刻してまう。",
            "zh": "……再不赶紧换衣服\n就要迟到了。",
            "narrator_zh": "雅"
        },
        {
            "location": "60/SEL",
            "narrator": "",
            "text": "二度寝しないの？",
            "zh": "不再睡个回笼觉吗？",
            "narrator_zh": ""
        },
        {
            "location": "61/ACT",
            "narrator": "",
            "text": "二度寝しないの？",
            "zh": "不再睡个回笼觉吗？",
            "narrator_zh": ""
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "…なんや？\nこんな朝っぱらから。",
            "zh": "……怎么啦？\n一大早的。",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "今日は気が向かんのだ",
            "zh": "今天没那个心情",
            "narrator_zh": "雅"
        },
        {
            "location": "86/TALK",
            "narrator": "みやび",
            "text": "故にやめた",
            "zh": "所以就不睡了",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "それだけや",
            "zh": "就这些",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "以上",
            "zh": "以上",
            "narrator_zh": "雅"
        },
        {
            "location": "99/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "こいつ、どこまで\n見ちょるが？",
            "zh": "这家伙，到底盯到\n哪一步了嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "…いや、うちが\nＷＡＶＥに出るから\nいかんのか。",
            "zh": "……不对，难道是因为\n我上了ＷＡＶＥ\n才不行的吗。",
            "narrator_zh": "雅"
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "なら、無視すれば\n見られることはない、\nっちゅうことか？",
            "zh": "那样的话，只要无视\n就不会被看到，\n是这个意思咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "104/SEL",
            "narrator": "",
            "text": "色んなとこから見てるけどね",
            "zh": "我从各种地方看着呢",
            "narrator_zh": ""
        },
        {
            "location": "105/ACT",
            "narrator": "",
            "text": "色んなとこから見てるけどね",
            "zh": "我从各种地方看着呢",
            "narrator_zh": ""
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "無視や無視。",
            "zh": "无视，无视。",
            "narrator_zh": "雅"
        },
        {
            "location": "109/TALK",
            "narrator": "みやび",
            "text": "すぅー…はぁー…。",
            "zh": "吸——……呼——……。",
            "narrator_zh": "雅"
        },
        {
            "location": "111/TALK",
            "narrator": "みやび",
            "text": "…よし、外向け\nみやびさんモード\n発動や。",
            "zh": "……好，对外用的\n雅小姐模式\n启动咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "今日も頑張るか…。",
            "zh": "今天也努力一下吧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "…今日は混んじゅう\nみたいやね。",
            "zh": "……今天好像人多得\n很咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "あんましやかましい\nとこで食べるんは\n気が引けるき――",
            "zh": "在太吵闹的地方\n吃个饭总觉得\n有点不自在——",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "外でちゃちゃっと\nすませてくるか。",
            "zh": "到外面快点\n解决掉好了。",
            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "…いや、今からじゃ\n午後の授業に\n間に合わんな…。",
            "zh": "……不行，现在出发\n下午的课就要\n来不及了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "…どうしたものか？",
            "zh": "……怎么办才好？",
            "narrator_zh": "雅"
        },
        {
            "location": "138/SEL",
            "narrator": "",
            "text": "いつもならサボるのに",
            "zh": "换作平时你可是会翘课的",
            "narrator_zh": ""
        },
        {
            "location": "139/ACT",
            "narrator": "",
            "text": "いつもならサボるのに",
            "zh": "换作平时你可是会翘课的",
            "narrator_zh": ""
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "…ちっ。",
            "zh": "……啧。",
            "narrator_zh": "雅"
        },
        {
            "location": "155/TALK",
            "narrator": "みやび",
            "text": "休み過ぎるとどうなるかわかるか？",
            "zh": "知道旷课太多会怎么样吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "みやび",
            "text": "来年も高校三年生をすることになるちや",
            "zh": "明年就得再当一年高中三年级生了滴",
            "narrator_zh": "雅"
        },
        {
            "location": "157/TALK",
            "narrator": "みやび",
            "text": "留年、ダブり、クラスメイトが先輩に",
            "zh": "留级、蹲班、同学变成前辈",
            "narrator_zh": "雅"
        },
        {
            "location": "158/TALK",
            "narrator": "みやび",
            "text": "笑えん",
            "zh": "笑不出来",
            "narrator_zh": "雅"
        },
        {
            "location": "169/TALK",
            "narrator": "みやび",
            "text": "…しゃあない。\n腹ペコで授業受ける\nよりかはマシやき――",
            "zh": "……没法子。\n总比饿着肚子上课\n要好些啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "170/TALK",
            "narrator": "みやび",
            "text": "ここで済ますか…。",
            "zh": "就在这里解决吗……。",
            "narrator_zh": "雅"
        },
        {
            "location": "171/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "【本日の設定】",
            "zh": "【今日的设定】",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "こいがさ子ちゃん：\n病弱で年中おなか\nいたい。",
            "zh": "小恋恋子：\n病弱，一年到头\n肚子疼。",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "みやび",
            "text": "あいたたたた。\nきょうもおなか\nいたいよう。",
            "zh": "哎哟哟哟哟。\n今天肚子也\n好痛呀。",
            "narrator_zh": "雅"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "だから学校には\n午後から行くよう。",
            "zh": "所以我都是下午\n才去学校的呀。",
            "narrator_zh": "雅"
        },
        {
            "location": "176/TALK",
            "narrator": "みやび",
            "text": "…さて、\n何食うかなぁ？",
            "zh": "……那么，\n吃点什么好呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "191/TALK",
            "narrator": "みやび",
            "text": "ん～…。\n次は美術の授業か。",
            "zh": "嗯～……。\n下一节是美术课啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "美術っちゅうんは、\nどうにも性に\n合わんなぁ。",
            "zh": "美术这门课，\n怎么都跟我\n不对付啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "それなりに才能のない\n人間には、苦痛以外の\n何でもない時間や…。",
            "zh": "对没什么才能的人，\n这段时间除了\n痛苦什么都不是……",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "いっそのこと、また\nお腹痛くして\n早退でも……",
            "zh": "干脆再闹个肚子痛\n提前回家\n算了……",
            "narrator_zh": "雅"
        },
        {
            "location": "195/TALK",
            "narrator": "みやび",
            "text": "……いや。",
            "zh": "……不行。",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "そういうわけにも\nいかんかね……。",
            "zh": "那样做还是\n不行的吧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "198/TALK",
            "narrator": "みやび",
            "text": "美術ちゅうことは…\nアレやもんなぁ。",
            "zh": "美术课的话……\n果然就是那个啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "242/TALK",
            "narrator": "みやび",
            "text": "む。誰かと思えば\n$handle$か。",
            "zh": "唔。我还当是谁，\n原来是$handle$啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "255/TALK",
            "narrator": "みやび",
            "text": "いたっ！",
            "zh": "好痛！",
            "narrator_zh": "雅"
        },
        {
            "location": "258/TALK",
            "narrator": "みやび",
            "text": "ふわっ！",
            "zh": "哇啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "261/TALK",
            "narrator": "みやび",
            "text": "ひいっ！",
            "zh": "噫！",
            "narrator_zh": "雅"
        },
        {
            "location": "268/TALK",
            "narrator": "みやび",
            "text": "馬鹿者！\nうちは起きちゅう！",
            "zh": "笨蛋！\n我是醒着的咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "269/SEL",
            "narrator": "",
            "text": "前回の仕返しです",
            "zh": "这是上次的报复",
            "narrator_zh": ""
        },
        {
            "location": "270/SEL",
            "narrator": "",
            "text": "あるえぇ？　起きてたの？",
            "zh": "啊咧？　原来你醒着？",
            "narrator_zh": ""
        },
        {
            "location": "271/ACT",
            "narrator": "",
            "text": "前回の仕返しです",
            "zh": "这是上次的报复",
            "narrator_zh": ""
        },
        {
            "location": "273/TALK",
            "narrator": "みやび",
            "text": "くっ、小癪な。\n悔しい！\nでも反論できんっ！",
            "zh": "可恶，真敢说啊。\n好气！\n但我没法反驳！",
            "narrator_zh": "雅"
        },
        {
            "location": "274/ACT",
            "narrator": "",
            "text": "あるえぇ？　起きてたの？",
            "zh": "啊咧？　原来你醒着？",
            "narrator_zh": ""
        },
        {
            "location": "276/TALK",
            "narrator": "みやび",
            "text": "お前さんは\nいじめっ子か！",
            "zh": "你这家伙是\n小恶霸吗！",
            "narrator_zh": "雅"
        },
        {
            "location": "277/TALK",
            "narrator": "みやび",
            "text": "うちはいじめには\nちくっとトラウマがあるき\n気いつけや。",
            "zh": "我对被人欺负这种事\n有点心理阴影的啵，\n你给我当心点。",
            "narrator_zh": "雅"
        },
        {
            "location": "282/TALK",
            "narrator": "みやび",
            "text": "まあ、何にしてもや。\nお前さんがここにいる\nちゅうんは、アレやろ？",
            "zh": "嘛，不管怎么说。\n你会出现在这里，\n就是说那个，是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "283/TALK",
            "narrator": "みやび",
            "text": "またうちの中に葛藤が\n発生しちゅうがやろ？",
            "zh": "我内心又产生\n新的挣扎了，是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "284/SEL",
            "narrator": "",
            "text": "その通り",
            "zh": "正是如此",
            "narrator_zh": ""
        },
        {
            "location": "285/ACT",
            "narrator": "",
            "text": "その通り",
            "zh": "正是如此",
            "narrator_zh": ""
        },
        {
            "location": "288/TALK",
            "narrator": "みやび",
            "text": "まったく、お前さんが\n来るときはいつも仕事や。",
            "zh": "真是的，你每次来\n都准是来干活的。",
            "narrator_zh": "雅"
        },
        {
            "location": "289/TALK",
            "narrator": "みやび",
            "text": "たまには葛藤が発生\nしちょらん時に、ゆっくり\n遊びにきいや。",
            "zh": "偶尔也挑个没产生\n挣扎的时候，慢悠悠\n过来玩咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "294/TALK",
            "narrator": "みやび",
            "text": "オープンプロセス、\n0x815番地から\n0x2CC番地へ。",
            "zh": "开放进程，\n从0x815地址\n到0x2CC地址。",
            "narrator_zh": "雅"
        },
        {
            "location": "309/TALK",
            "narrator": "みやび",
            "text": "完了。",
            "zh": "完成。",
            "narrator_zh": "雅"
        },
        {
            "location": "311/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "313/TALK",
            "narrator": "みやび",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "雅"
        },
        {
            "location": "315/TALK",
            "narrator": "みやび",
            "text": "なっ…！？",
            "zh": "什……！？",
            "narrator_zh": "雅"
        },
        {
            "location": "316/TALK",
            "narrator": "みやび",
            "text": "なんやって！？\n今回のこれ、本当に\nうちのことなんか？",
            "zh": "这是驷马！？\n这次的这个，真的是\n在说我吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "317/TALK",
            "narrator": "みやび",
            "text": "まさかうちに、\nこんなココロが\nあろうとは。",
            "zh": "没想到我身上，\n居然会有\n这样的心灵。",
            "narrator_zh": "雅"
        },
        {
            "location": "318/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "319/SEL",
            "narrator": "",
            "text": "何があったの？",
            "zh": "发生什么事了？",
            "narrator_zh": ""
        },
        {
            "location": "320/ACT",
            "narrator": "",
            "text": "何があったの？",
            "zh": "发生什么事了？",
            "narrator_zh": ""
        },
        {
            "location": "322/TALK",
            "narrator": "みやび",
            "text": "秘密や。\nほれ、すっとクランを\n倒して来い。",
            "zh": "是秘密。\n来，快点去把库兰\n打倒咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "323/SEL",
            "narrator": "",
            "text": "教えてくれたらすっと倒す",
            "zh": "你告诉我的话我就快点去打倒",
            "narrator_zh": ""
        },
        {
            "location": "324/ACT",
            "narrator": "",
            "text": "教えてくれたらすっと倒す",
            "zh": "你告诉我的话我就快点去打倒",
            "narrator_zh": ""
        },
        {
            "location": "326/TALK",
            "narrator": "みやび",
            "text": "なんとゆう\n鬼畜な取引や！",
            "zh": "这是何等\n鬼畜的交易啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "328/TALK",
            "narrator": "みやび",
            "text": "貴様本当に人間か！？",
            "zh": "你这家伙真是人类吗！？",
            "narrator_zh": "雅"
        },
        {
            "location": "329/SEL",
            "narrator": "",
            "text": "どう考えても普通だと思うけど",
            "zh": "不管怎么想都觉得这很普通",
            "narrator_zh": ""
        },
        {
            "location": "330/ACT",
            "narrator": "",
            "text": "どう考えても普通だと思うけど",
            "zh": "不管怎么想都觉得这很普通",
            "narrator_zh": ""
        },
        {
            "location": "332/TALK",
            "narrator": "みやび",
            "text": "ぐぬぬ。\nああ言えばこうゆう。",
            "zh": "咕嗯嗯。\n我说一句你顶一句。",
            "narrator_zh": "雅"
        },
        {
            "location": "333/TALK",
            "narrator": "みやび",
            "text": "わかったぞね。\n今回ばかりは、\n背に腹は替えられん。",
            "zh": "懂了咧。\n就这一回，\n实在顾不得那么多了。",
            "narrator_zh": "雅"
        },
        {
            "location": "334/TALK",
            "narrator": "みやび",
            "text": "ココロファイルナンバー\n04-886-39には、\nこう記されちょった。",
            "zh": "心之档案编号\n04-886-39里，\n是这样记着的。",
            "narrator_zh": "雅"
        },
        {
            "location": "335/TALK",
            "narrator": "みやび",
            "text": "今、現実のうちは、\n授業をサボりたくて\nたまらん。",
            "zh": "现在，现实中的我，\n想翘课想得\n不得了。",
            "narrator_zh": "雅"
        },
        {
            "location": "336/TALK",
            "narrator": "みやび",
            "text": "けんど、１つだけ\n心残りがある。",
            "zh": "但是，还有\n一件事放不下。",
            "narrator_zh": "雅"
        },
        {
            "location": "337/TALK",
            "narrator": "みやび",
            "text": "いつも美術や体育で\nペアを組んじょる子が\nおるがやけんどな。",
            "zh": "有个女生，在美术和\n体育课上总是\n跟我配对。",
            "narrator_zh": "雅"
        },
        {
            "location": "338/TALK",
            "narrator": "みやび",
            "text": "その子は、うちがいないと\nいつも独りぼっちなんよ。",
            "zh": "那孩子只要我不在，\n就总是孤零零一个。",
            "narrator_zh": "雅"
        },
        {
            "location": "339/TALK",
            "narrator": "みやび",
            "text": "確か今日の授業は\nペアになって写生やった\n気がしてるわけやが。",
            "zh": "我记得今天的课\n好像是两人一组\n写生来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "340/TALK",
            "narrator": "みやび",
            "text": "そうでなかったら\n出るだけ損やろ。",
            "zh": "要不是那样的话，\n去了就纯亏了。",
            "narrator_zh": "雅"
        },
        {
            "location": "341/TALK",
            "narrator": "みやび",
            "text": "それに、あれや。",
            "zh": "还有啊，那个。",
            "narrator_zh": "雅"
        },
        {
            "location": "342/TALK",
            "narrator": "みやび",
            "text": "……その。",
            "zh": "……那个。",
            "narrator_zh": "雅"
        },
        {
            "location": "344/TALK",
            "narrator": "みやび",
            "text": "ちと、気恥ずかしいきね。",
            "zh": "有点，难为情啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "345/SEL",
            "narrator": "",
            "text": "やっぱりみやびは優しいね",
            "zh": "雅果然很温柔",
            "narrator_zh": ""
        },
        {
            "location": "346/ACT",
            "narrator": "",
            "text": "やっぱりみやびは優しいね",
            "zh": "雅果然很温柔",
            "narrator_zh": ""
        },
        {
            "location": "348/TALK",
            "narrator": "みやび",
            "text": "そうゆうわけや\nないけんど、ぼっちの\n辛さはよう知っちゅうき。",
            "zh": "虽然不是那么回事，\n但落单的苦头\n我是懂得很的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "349/TALK",
            "narrator": "みやび",
            "text": "独りにしたら\nちと可哀想やと思うてな。",
            "zh": "让她一个人待着，\n总觉得有点可怜。",
            "narrator_zh": "雅"
        },
        {
            "location": "350/TALK",
            "narrator": "みやび",
            "text": "ま、そんな感じや。",
            "zh": "嘛，就是这么回事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "けんど今、うちは\nサボる方に傾いちゅう。",
            "zh": "但是现在的我，\n还是往翘课那边偏。",
            "narrator_zh": "雅"
        },
        {
            "location": "352/TALK",
            "narrator": "みやび",
            "text": "クランが疼いちょるきね。",
            "zh": "库兰正疼着啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "353/SEL",
            "narrator": "",
            "text": "優しいみやびが見たいから倒してくる",
            "zh": "我想看到温柔的雅，所以去打倒它",
            "narrator_zh": ""
        },
        {
            "location": "354/ACT",
            "narrator": "",
            "text": "優しいみやびが見たいから倒してくる",
            "zh": "我想看到温柔的雅，所以去打倒它",
            "narrator_zh": ""
        },
        {
            "location": "356/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "358/TALK",
            "narrator": "みやび",
            "text": "勝手にしいや。",
            "zh": "随你便咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "359/TALK",
            "narrator": "みやび",
            "text": "なにはともあれ、\nうちと$handle$に\nえいココロの旅を。",
            "zh": "不管怎么说，\n献给我和$handle$的\n美妙的心灵之旅。",
            "narrator_zh": "雅"
        },
