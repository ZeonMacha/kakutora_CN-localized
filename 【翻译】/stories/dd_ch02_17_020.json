    },
    "entry": [
        {
            "location": "285/SCENARIO",
            "narrator": "",
            "text": "勉強疲れ",
            "zh": "学习疲惫",
            "narrator_zh": ""
        },
        {
            "location": "300/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "301/TALK",
            "narrator": "アーヤ",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "302/TALK",
            "narrator": "アーヤ",
            "text": "…ダメだわ。\n今日は全然講義の内容が\n頭に入らない…。",
            "zh": "……不行啊。\n今天讲课的内容\n完全听不进去……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "315/TALK",
            "narrator": "アーヤ",
            "text": "今日はもう、講義受けたくない気分",
            "zh": "今天已经不想听课了",
            "narrator_zh": "绫水"
        },
        {
            "location": "317/SEL",
            "narrator": "",
            "text": "だらしないよ",
            "zh": "太松懈了吧",
            "narrator_zh": ""
        },
        {
            "location": "318/SEL",
            "narrator": "",
            "text": "珍しいね？",
            "zh": "真少见呢？",
            "narrator_zh": ""
        },
        {
            "location": "319/ACT",
            "narrator": "",
            "text": "だらしないよ",
            "zh": "太松懈了吧",
            "narrator_zh": ""
        },
        {
            "location": "320/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさい…",
            "zh": "对不起……",
            "narrator_zh": "绫水"
        },
        {
            "location": "321/TALK",
            "narrator": "アーヤ",
            "text": "だらけちゃダメよね？",
            "zh": "果然不能偷懒对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "322/TALK",
            "narrator": "アーヤ",
            "text": "頑張る(>_<)",
            "zh": "我会加油的(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "…しっかりしないと、\nダメよね。",
            "zh": "……不打起精神来\n可不行呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "頑張らないと…。",
            "zh": "得加油才行……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "336/TALK",
            "narrator": "アーヤ",
            "text": "…はぁ。",
            "zh": "……哈啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "338/ACT",
            "narrator": "",
            "text": "珍しいね？",
            "zh": "真少见呢？",
            "narrator_zh": ""
        },
        {
            "location": "339/TALK",
            "narrator": "アーヤ",
            "text": "多分、ストレスが溜まってるからだと思うの",
            "zh": "大概是因为压力积攒太多了吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "340/TALK",
            "narrator": "アーヤ",
            "text": "愚痴っちゃうけど、いい？",
            "zh": "我要发牢骚了哦，可以吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "343/SEL",
            "narrator": "",
            "text": "話して",
            "zh": "说吧",
            "narrator_zh": ""
        },
        {
            "location": "344/ACT",
            "narrator": "",
            "text": "話して",
            "zh": "说吧",
            "narrator_zh": ""
        },
        {
            "location": "346/TALK",
            "narrator": "アーヤ",
            "text": "少し前なんだけど、バイクで日帰り温泉旅行に行く予定だったの",
            "zh": "是前阵子的事了，我本来计划骑摩托去当天往返的温泉旅行",
            "narrator_zh": "绫水"
        },
        {
            "location": "347/TALK",
            "narrator": "アーヤ",
            "text": "けど、その日にフェノメノンが出て、計画が潰れちゃって…",
            "zh": "结果那天出现了PhenoMENON，计划就泡汤了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "348/TALK",
            "narrator": "アーヤ",
            "text": "まあ、つまりお休みが欲しいな、ってこと",
            "zh": "嘛，总之就是好想要个假期啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "350/SEL",
            "narrator": "",
            "text": "今日はもうサボッちゃえ",
            "zh": "今天干脆翘课吧",
            "narrator_zh": ""
        },
        {
            "location": "351/SEL",
            "narrator": "",
            "text": "仕事なんだから仕方ないよ",
            "zh": "这也是工作，没办法呀",
            "narrator_zh": ""
        },
        {
            "location": "352/ACT",
            "narrator": "",
            "text": "今日はもうサボッちゃえ",
            "zh": "今天干脆翘课吧",
            "narrator_zh": ""
        },
        {
            "location": "353/TALK",
            "narrator": "アーヤ",
            "text": "そういうわけにもいかないわ",
            "zh": "那可不行啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "354/TALK",
            "narrator": "アーヤ",
            "text": "サボッたのみんなにバレたら、絶対色々言われるだろうし…",
            "zh": "要是翘课的事被大家发现了，肯定会被说三道四的……",
            "narrator_zh": "绫水"
        },
        {
            "location": "355/TALK",
            "narrator": "アーヤ",
            "text": "愚痴聞いてもらっただけで十分よ、ありがと",
            "zh": "能听我发发牢骚就足够了，谢谢",
            "narrator_zh": "绫水"
        },
        {
            "location": "367/TALK",
            "narrator": "アーヤ",
            "text": "…頑張らないと。",
            "zh": "……得加油才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "369/TALK",
            "narrator": "アーヤ",
            "text": "…はぁ。",
            "zh": "……哈啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "383/TALK",
            "narrator": "つばめ",
            "text": "――っていうことが\nあったんですよ。",
            "zh": "——就是发生了\n这么一件事哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "384/TALK",
            "narrator": "つばめ",
            "text": "その時、ひなこちゃんが\nキリトくん達に…。",
            "zh": "那时候，雏子对\n圣翔他们……。",
            "narrator_zh": "燕"
        },
        {
            "location": "385/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "386/TALK",
            "narrator": "つばめ",
            "text": "…アーヤさん？",
            "zh": "……绫水？",
            "narrator_zh": "燕"
        },
        {
            "location": "389/TALK",
            "narrator": "アーヤ",
            "text": "えっ？",
            "zh": "哎？",
            "narrator_zh": "绫水"
        },
        {
            "location": "390/TALK",
            "narrator": "つばめ",
            "text": "えっと、ずっと話を\nしてたんですけど…。",
            "zh": "那个，我一直在\n说话来着……。",
            "narrator_zh": "燕"
        },
        {
            "location": "391/TALK",
            "narrator": "アーヤ",
            "text": "あっ、ごめんごめん。\n少しぼーっとしちゃってた\nみたい…。",
            "zh": "啊，抱歉抱歉。\n好像稍微有点\n走神了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "392/TALK",
            "narrator": "つばめ",
            "text": "…どこか、具合でも\n悪いんですか？",
            "zh": "……是不是哪里\n不舒服呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "394/TALK",
            "narrator": "アーヤ",
            "text": "ううん、そうじゃないの。\n本当にぼーっとしちゃった\nだけよ。",
            "zh": "没有，不是那样的。\n真的只是稍微\n走神了而已。",
            "narrator_zh": "绫水"
        },
        {
            "location": "395/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "396/TALK",
            "narrator": "アーヤ",
            "text": "ほら、冷めちゃうから\n早く食べちゃいましょ。",
            "zh": "好啦，菜要凉了，\n快点吃吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "397/TALK",
            "narrator": "つばめ",
            "text": "は、はい。",
            "zh": "好、好的。",
            "narrator_zh": "燕"
        },
        {
            "location": "398/TALK",
            "narrator": "つばめ",
            "text": "…やっぱり、具合悪そうに\n見えるんだけどなぁ？",
            "zh": "……可是，看起来还是\n很不舒服的样子呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "405/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん、何だか元気がないみたいなの",
            "zh": "绫水好像很没精神的样子",
            "narrator_zh": "燕"
        },
        {
            "location": "407/TALK",
            "narrator": "つばめ",
            "text": "何があったか、$handle$さんは知ってる？",
            "zh": "$handle$知道发生了什么事吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "409/SEL",
            "narrator": "",
            "text": "休みが欲しいみたい",
            "zh": "她好像想要休息",
            "narrator_zh": ""
        },
        {
            "location": "410/SEL",
            "narrator": "",
            "text": "超お腹が減ってるみたい",
            "zh": "她好像饿坏了",
            "narrator_zh": ""
        },
        {
            "location": "411/ACT",
            "narrator": "",
            "text": "休みが欲しいみたい",
            "zh": "她好像想要休息",
            "narrator_zh": ""
        },
        {
            "location": "412/TALK",
            "narrator": "つばめ",
            "text": "あっ、思い出した！",
            "zh": "啊，我想起来了！",
            "narrator_zh": "燕"
        },
        {
            "location": "413/TALK",
            "narrator": "つばめ",
            "text": "この前のアーヤさんのお休み、フェノメノンのせいで潰れちゃったんだった…",
            "zh": "上次绫水的休息日，就是因为PhenoMENON泡汤了……",
            "narrator_zh": "燕"
        },
        {
            "location": "414/TALK",
            "narrator": "つばめ",
            "text": "そっか…ありがと",
            "zh": "这样啊……谢谢",
            "narrator_zh": "燕"
        },
        {
            "location": "421/TALK",
            "narrator": "つばめ",
            "text": "あの日って、温泉旅行に\n行くとか言ってたし――",
            "zh": "那天她还说过\n要去温泉旅行来着——",
            "narrator_zh": "燕"
        },
        {
            "location": "422/TALK",
            "narrator": "つばめ",
            "text": "元気ないの、当然だよ。",
            "zh": "会没精神，也是理所当然的呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "423/TALK",
            "narrator": "つばめ",
            "text": "…アーヤさんが今度、\n大学もバイトもお休みの\n日って、いつでしたっけ？",
            "zh": "……绫水下次\n大学和打工都休息的\n日子，是什么时候来着？",
            "narrator_zh": "燕"
        },
        {
            "location": "425/TALK",
            "narrator": "アーヤ",
            "text": "しばらくないわ。\nどっちかは必ず予定に\n入っちゃってて…。",
            "zh": "一时半会儿没有。\n这两样里总有一样\n排了日程……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "426/TALK",
            "narrator": "つばめ",
            "text": "大学がお休みの日は\nいつですか？",
            "zh": "那大学放假的日子\n是什么时候呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "427/TALK",
            "narrator": "アーヤ",
            "text": "えっと…明後日が確か\nそうだったかしら？",
            "zh": "那个……好像\n后天就是吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "428/TALK",
            "narrator": "つばめ",
            "text": "丁度良かったです。\nわたし、その日はバイトが\nお休みなんで――",
            "zh": "正好呢。\n我那天打工\n休息——",
            "narrator_zh": "燕"
        },
        {
            "location": "429/TALK",
            "narrator": "つばめ",
            "text": "よかったらわたしの\nシフトと変わりませんか？",
            "zh": "如果不介意的话，\n要不要和我换个班？",
            "narrator_zh": "燕"
        },
        {
            "location": "430/TALK",
            "narrator": "アーヤ",
            "text": "…もしかして、\n気を使ってくれてる？",
            "zh": "……难道说，\n你在顾虑我吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "433/TALK",
            "narrator": "つばめ",
            "text": "えっ？　えっと…。",
            "zh": "哎？　那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "435/TALK",
            "narrator": "アーヤ",
            "text": "ありがと…\nでも、気持ちだけで\n十分よ。",
            "zh": "谢谢……\n不过，心意我领了\n这就够了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "438/TALK",
            "narrator": "つばめ",
            "text": "で、でも、この前の\nお休みはフェノメノンの\nせいで潰れちゃったし――",
            "zh": "可、可是，上次的\n休息日也因为PhenoMENON\n泡汤了嘛——",
            "narrator_zh": "燕"
        },
        {
            "location": "439/TALK",
            "narrator": "つばめ",
            "text": "それに、凄く疲れてる\nでしょう？",
            "zh": "而且，你也很累了\n不是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "440/TALK",
            "narrator": "つばめ",
            "text": "リーダーのアーヤさんは、\n常にベストな状態でいて\nもらわないと困りますよ。",
            "zh": "作为队长的绫水，\n必须一直保持在最佳状态\n才行呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "441/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "442/TALK",
            "narrator": "つばめ",
            "text": "…えっと、ちょっと\n生意気でしたか？",
            "zh": "……那个，我是不是\n有点太狂妄了？",
            "narrator_zh": "燕"
        },
        {
            "location": "443/TALK",
            "narrator": "アーヤ",
            "text": "…ううん。\nつばめの言う通りよ。",
            "zh": "……没有。\n燕说得对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "444/TALK",
            "narrator": "アーヤ",
            "text": "それじゃあ、お言葉に\n甘えてシフトを交換して\nもらっていいかしら？",
            "zh": "那我就恭敬不如从命，\n跟你换一下班\n可以吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "445/TALK",
            "narrator": "つばめ",
            "text": "もちろんです。",
            "zh": "当然可以。",
            "narrator_zh": "燕"
        },
        {
            "location": "447/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…それじゃあ、\nこの前行けなかった\n温泉旅行――",
            "zh": "呵呵……那，\n上次没去成的\n温泉旅行——",
            "narrator_zh": "绫水"
        },
        {
            "location": "448/TALK",
            "narrator": "アーヤ",
            "text": "もう一度計画して\nみようかしら？",
            "zh": "要不再重新计划\n一次呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "450/TALK",
            "narrator": "つばめ",
            "text": "…よかった。\n喜んでもらえて。",
            "zh": "……太好了。\n能让你开心起来。",
            "narrator_zh": "燕"
        },
        {
            "location": "468/ACT",
            "narrator": "",
            "text": "超お腹が減ってるみたい",
            "zh": "她好像饿坏了",
            "narrator_zh": ""
        },
        {
            "location": "469/TALK",
            "narrator": "つばめ",
            "text": "そうだったんだ…",
            "zh": "原来是这样呀……",
            "narrator_zh": "燕"
        },
        {
            "location": "470/TALK",
            "narrator": "つばめ",
            "text": "わかった、ありがと",
            "zh": "我知道了，谢谢",
            "narrator_zh": "燕"
        },
        {
            "location": "477/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん。\nご飯、美味しいですね。",
            "zh": "绫水。\n饭菜很好吃呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "479/TALK",
            "narrator": "アーヤ",
            "text": "え？　ええ、そうね。",
            "zh": "哎？　嗯，是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "480/TALK",
            "narrator": "つばめ",
            "text": "わたしの唐揚げ、\n一つあげます。",
            "zh": "我的炸鸡块，\n分你一块哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "481/TALK",
            "narrator": "アーヤ",
            "text": "え？　あ、うん…\nよくわからないけど、\nありがと…。",
            "zh": "哎？　啊，嗯……\n虽然不太明白，\n谢谢了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "482/TALK",
            "narrator": "つばめ",
            "text": "…………？",
            "zh": "…………？",
            "narrator_zh": "燕"
        },
        {
            "location": "483/TALK",
            "narrator": "つばめ",
            "text": "あ、あれ？\nなんか、全然美味しそうに\n食べてないような…。",
            "zh": "哎、哎呀？\n总觉得，吃起来\n完全不香的样子……。",
            "narrator_zh": "燕"
        },
        {
            "location": "485/TALK",
            "narrator": "つばめ",
            "text": "…もしかして、\nお腹が減ってるわけじゃ\nないのかな？",
            "zh": "……难道说，\n并不是因为肚子饿\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "486/TALK",
            "narrator": "つばめ",
            "text": "あ、あの、アーヤさ――",
            "zh": "那、那个，绫——",
            "narrator_zh": "燕"
        },
        {
            "location": "487/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、食べ終わったから\nお先に。",
            "zh": "那我吃完了，\n先走一步。",
            "narrator_zh": "绫水"
        },
        {
            "location": "491/TALK",
            "narrator": "つばめ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "493/TALK",
            "narrator": "つばめ",
            "text": "…行っちゃった。",
            "zh": "……走掉了。",
            "narrator_zh": "燕"
        },
        {
            "location": "495/TALK",
            "narrator": "つばめ",
            "text": "…元気がなかった理由、\n結局わからなかった\nなぁ…。",
            "zh": "……没精神的原因，\n到头来还是没弄明白\n呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "496/TALK",
            "narrator": "つばめ",
            "text": "…心配だなぁ。",
            "zh": "……好担心呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "498/ACT",
            "narrator": "",
            "text": "仕事なんだから仕方ないよ",
            "zh": "这也是工作，没办法呀",
            "narrator_zh": ""
        },
        {
            "location": "499/TALK",
            "narrator": "アーヤ",
            "text": "…そうよね",
            "zh": "……是啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "500/TALK",
            "narrator": "アーヤ",
            "text": "ありがと、ちょっと吹っ切れたわ",
            "zh": "谢谢，感觉稍微想开一点了",
            "narrator_zh": "绫水"
        },
        {
            "location": "511/TALK",
            "narrator": "アーヤ",
            "text": "…しっかりしないと、\nダメよね。",
            "zh": "……不打起精神来\n可不行呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "512/TALK",
            "narrator": "アーヤ",
            "text": "頑張らないと…。",
            "zh": "得加油才行……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "514/TALK",
            "narrator": "アーヤ",
            "text": "…はぁ。",
            "zh": "……哈啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "292/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月19日　1:32 PM</color>\nとある平日の休み時間、附属学園アーヤの教室にて。",
            "zh": "<color=green>7月19日　1:32 PM</color>\n某个工作日的课间休息，在附属学园绫水的教室。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "461/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch02",
            "text": "【サヴォタージュ】",
            "zh": "【怠工】",
            "narrator_zh": "Dialog_GEThimegoto_ch02"
        }
    ]
