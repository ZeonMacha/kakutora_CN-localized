{
 "dir": "dramatics/daydra/drm_ch04_00_441.js",
 "type": "Episode",
 "info": {
  "story_id": "4047",
  "cid": "miyabi",
  "title": "らぶとーく 第48話",
  "sub_title": "口止めとは生意気な（アーヤ）"
 },
 "entry": [
  {
   "location": "144/SCENARIO",
   "narrator": "",
   "text": "口止めとは生意気な（アーヤ）"
  },
  {
   "location": "159/TALK",
   "narrator": "アーヤ",
   "text": "どうぞー。",
   "zh": "请吧——。",
   "narrator_zh": "绫水"
  },
  {
   "location": "162/TALK",
   "narrator": "みやび",
   "text": "お邪魔するぞね。",
   "zh": "打扰了咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "163/TALK",
   "narrator": "アーヤ",
   "text": "あらみやび、\nどうかしたの？"
  },
  {
   "location": "164/TALK",
   "narrator": "みやび",
   "text": "ん…当直のことや。",
   "zh": "嗯……说的是值班咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "165/TALK",
   "narrator": "みやび",
   "text": "今度の当直、まさか\nアーヤが代わる\n言うとは思わなくて。"
  },
  {
   "location": "167/TALK",
   "narrator": "アーヤ",
   "text": "ああ、そのことね。"
  },
  {
   "location": "170/TALK",
   "narrator": "みやび",
   "text": "実は、その日はどうしても\n外せん用事があってな。",
   "zh": "其实那天，我有个\n无论如何都推不掉的事咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "171/TALK",
   "narrator": "みやび",
   "text": "正直、どうしようか\n悩んでたちや。",
   "zh": "老实说，我也一直\n在纠结啵。",
   "narrator_zh": "雅"
  },
  {
   "location": "174/TALK",
   "narrator": "みやび",
   "text": "やき、アーヤが\n代わる言うてくれて、\nまっこと助かった。"
  },
  {
   "location": "175/TALK",
   "narrator": "みやび",
   "text": "ありがとな。",
   "zh": "谢啦。",
   "narrator_zh": "雅"
  },
  {
   "location": "176/TALK",
   "narrator": "アーヤ",
   "text": "どういたしまして。",
   "zh": "不客气。",
   "narrator_zh": "绫水"
  },
  {
   "location": "179/TALK",
   "narrator": "アーヤ",
   "text": "けど、改まってお礼を\n言いに来なくても\n良かったのに。",
   "zh": "可是，你其实不用\n特地过来\n道谢的。",
   "narrator_zh": "绫水"
  },
  {
   "location": "180/TALK",
   "narrator": "みやび",
   "text": "いや、それやと\nうちの気がすまん。"
  },
  {
   "location": "181/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "183/TALK",
   "narrator": "アーヤ",
   "text": "ダメね。\nやっぱり内緒には\nできないわ。"
  },
  {
   "location": "184/TALK",
   "narrator": "みやび",
   "text": "…何のことや？",
   "zh": "……什么事嘛？",
   "narrator_zh": "雅"
  },
  {
   "location": "187/TALK",
   "narrator": "アーヤ",
   "text": "実はね、今回の当直を\n代わったのって――"
  },
  {
   "location": "188/TALK",
   "narrator": "アーヤ",
   "text": "$handle$さんに\n頼まれたからなのよ。",
   "zh": "因为是$handle$\n拜托我的。",
   "narrator_zh": "绫水"
  },
  {
   "location": "189/TALK",
   "narrator": "みやび",
   "text": "は？",
   "zh": "啊？",
   "narrator_zh": "雅"
  },
  {
   "location": "190/TALK",
   "narrator": "アーヤ",
   "text": "その日は、どうしても\nみやびさんに外せない\n用事があるんだ、って…。",
   "zh": "那天雅小姐有件\n无论如何都推不开的\n事，她这么说……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "191/TALK",
   "narrator": "みやび",
   "text": "…………。"
  },
  {
   "location": "194/TALK",
   "narrator": "みやび",
   "text": "初耳や。\nそんなこと言われたが？",
   "zh": "头一回听说咯。\n还有人跟你这么讲过？",
   "narrator_zh": "雅"
  },
  {
   "location": "195/TALK",
   "narrator": "アーヤ",
   "text": "ええ…。",
   "zh": "嗯……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "197/TALK",
   "narrator": "みやび",
   "text": "そうか…。",
   "zh": "是吗……",
   "narrator_zh": "雅"
  },
  {
   "location": "198/TALK",
   "narrator": "みやび",
   "text": "なるほどな…。\n道理でタイミングが\n良過ぎるわけや。",
   "zh": "原来如此……。\n怪不得这时机\n巧得过分咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "201/TALK",
   "narrator": "アーヤ",
   "text": "…余計だったかしら？",
   "zh": "……是我多事了吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "203/TALK",
   "narrator": "みやび",
   "text": "いや、そんなことは\nないぞね。",
   "zh": "不，没\n那么难啵。",
   "narrator_zh": "雅"
  },
  {
   "location": "204/TALK",
   "narrator": "みやび",
   "text": "それより、当直の方は\nまっこと変わってもらって\nえいが？",
   "zh": "比起这个，值班那边\n能跟我好好\n换一下不？",
   "narrator_zh": "雅"
  },
  {
   "location": "207/TALK",
   "narrator": "アーヤ",
   "text": "ええ、もちろん。",
   "zh": "嗯，当然。",
   "narrator_zh": "绫水"
  },
  {
   "location": "208/TALK",
   "narrator": "みやび",
   "text": "そうか…。\n改めて、ありがとうな。",
   "zh": "这样啊……。\n我说，谢谢你咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "218/TALK",
   "narrator": "みやび",
   "text": "…………。"
  },
  {
   "location": "225/TALK",
   "narrator": "みやび",
   "text": "おい",
   "zh": "喂",
   "narrator_zh": "雅"
  },
  {
   "location": "227/TALK",
   "narrator": "みやび",
   "text": "うちに内緒で勝手なことを",
   "zh": "瞒着我擅自乱来",
   "narrator_zh": "雅"
  },
  {
   "location": "228/TALK",
   "narrator": "みやび",
   "text": "余計なことするな！",
   "zh": "别多管闲事！",
   "narrator_zh": "雅"
  },
  {
   "location": "230/SEL",
   "narrator": "",
   "text": "もう決まったし",
   "zh": "都已经定好了",
   "narrator_zh": ""
  },
  {
   "location": "231/SEL",
   "narrator": "",
   "text": "サプライズ成功！",
   "zh": "惊喜成功！",
   "narrator_zh": ""
  },
  {
   "location": "232/SEL",
   "narrator": "",
   "text": "遠慮しないで",
   "zh": "别客气",
   "narrator_zh": ""
  },
  {
   "location": "233/ACT",
   "narrator": "",
   "text": "もう決まったし",
   "zh": "都已经定好了",
   "narrator_zh": ""
  },
  {
   "location": "234/TALK",
   "narrator": "みやび",
   "text": "勝手に決めよって",
   "zh": "就这么自作主张",
   "narrator_zh": "雅"
  },
  {
   "location": "235/TALK",
   "narrator": "みやび",
   "text": "ハッキリ言っておく",
   "zh": "我把话说清楚",
   "narrator_zh": "雅"
  },
  {
   "location": "236/TALK",
   "narrator": "みやび",
   "text": "こういうズルは好きやない",
   "zh": "这种取巧我不喜欢",
   "narrator_zh": "雅"
  },
  {
   "location": "237/TALK",
   "narrator": "みやび",
   "text": "礼は言わんぞ！",
   "zh": "我可不会道谢咯！",
   "narrator_zh": "雅"
  },
  {
   "location": "238/ACT",
   "narrator": "",
   "text": "サプライズ成功！",
   "zh": "惊喜成功！",
   "narrator_zh": ""
  },
  {
   "location": "239/TALK",
   "narrator": "みやび",
   "text": "そうやね",
   "zh": "是这样咯",
   "narrator_zh": "雅"
  },
  {
   "location": "240/TALK",
   "narrator": "みやび",
   "text": "ハッピーの付かない方",
   "zh": "不带Happy的那个",
   "narrator_zh": "雅"
  },
  {
   "location": "241/TALK",
   "narrator": "みやび",
   "text": "ただのサプライズ",
   "zh": "就是个惊喜嘛",
   "narrator_zh": "雅"
  },
  {
   "location": "242/TALK",
   "narrator": "みやび",
   "text": "いや",
   "zh": "不对",
   "narrator_zh": "雅"
  },
  {
   "location": "243/TALK",
   "narrator": "みやび",
   "text": "限りなくバッドに近い",
   "zh": "无限接近Bad咯",
   "narrator_zh": "雅"
  },
  {
   "location": "244/ACT",
   "narrator": "",
   "text": "遠慮しないで",
   "zh": "别客气",
   "narrator_zh": ""
  },
  {
   "location": "245/TALK",
   "narrator": "みやび",
   "text": "おまえが言うな！",
   "zh": "轮不到你说！",
   "narrator_zh": "雅"
  },
  {
   "location": "246/TALK",
   "narrator": "みやび",
   "text": "それはアーヤのセリフや",
   "zh": "那是绫水的台词咯",
   "narrator_zh": "雅"
  },
  {
   "location": "247/TALK",
   "narrator": "みやび",
   "text": "呆れるほどの図々しさやね",
   "zh": "脸皮厚得让人无语咯",
   "narrator_zh": "雅"
  },
  {
   "location": "250/SEL",
   "narrator": "",
   "text": "余計なことしてごめん…",
   "zh": "多此一举，抱歉……",
   "narrator_zh": ""
  },
  {
   "location": "251/ACT",
   "narrator": "",
   "text": "余計なことしてごめん…",
   "zh": "多此一举，抱歉……",
   "narrator_zh": ""
  },
  {
   "location": "254/TALK",
   "narrator": "みやび",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "255/TALK",
   "narrator": "みやび",
   "text": "当直がなくなって助かったのは事実や",
   "zh": "不用值班算我走运，这也是实话咯",
   "narrator_zh": "雅"
  },
  {
   "location": "256/TALK",
   "narrator": "みやび",
   "text": "実際困ってたのも事実",
   "zh": "实际上确实也很为难",
   "narrator_zh": "雅"
  },
  {
   "location": "257/TALK",
   "narrator": "みやび",
   "text": "そういうことだ",
   "zh": "就是这么回事",
   "narrator_zh": "雅"
  },
  {
   "location": "258/TALK",
   "narrator": "みやび",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "260/TALK",
   "narrator": "みやび",
   "text": "休みに罪はない",
   "zh": "休息又没有罪",
   "narrator_zh": "雅"
  },
  {
   "location": "261/TALK",
   "narrator": "みやび",
   "text": "遠慮なく使わせてもらうちや！",
   "zh": "那我就不客气地用咯！",
   "narrator_zh": "雅"
  },
  {
   "location": "154/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>某月某日　 5:40 PM</color>\nとある平日、寮「とらいあんぐる」アーヤの部屋にて"
  }
 ]
}
