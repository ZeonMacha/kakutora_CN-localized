        {
            "location": "172/TALK",
            "narrator": "透明アーヤ",
            "text": "…今度、二人だけで\nいられるような場所に\n行ったときにでも…。",
            "zh": "……下次，去一个\n能两个人待着的地方\n的时候……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "174/TALK",
            "narrator": "透明アーヤ",
            "text": "ゆっくりデートしましょ。",
            "zh": "我们慢慢约会吧。",
            "narrator_zh": "透明绫水"
