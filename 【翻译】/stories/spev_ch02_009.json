{
    "dir": "chap00/daydra/spev_ch02_009.js",
    "type": "",
    "info": {
        "story_id": "2009",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "海辺の大決戦",
        "title_zh": "特别篇",
        "sub_title_zh": "海边大决战"
    },
    "entry": [
        {
            "location": "32/TALK",
            "narrator": "透明アーヤ",
            "text": "ほら、みんな。\n早く行くわよ。",
            "zh": "来，大家。\n快点走了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "透明つばめ",
            "text": "あ、アーヤさん、\n早過ぎますよぉ。",
            "zh": "啊，绫水，\n太快了呀。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "35/TALK",
            "narrator": "透明神楽",
            "text": "アーヤさんが\nこんなにはしゃいでる姿、\n初めて見ました。",
            "zh": "绫水\n这么兴奋的样子，\n我还是第一次见。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "36/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そんなに\n海が好きだったの？",
            "zh": "这么\n喜欢海吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "透明アーヤ",
            "text": "嫌いじゃないわ。",
            "zh": "也不讨厌。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "透明アーヤ",
            "text": "でも、他の人がまったく\nいない砂浜なのよ？\n楽しくならない？",
            "zh": "可是，沙滩上\n完全没有别人吧？\n不觉得开心吗？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "透明ガブリエラ",
            "text": "それにしたって、\nちょっとはしゃぎ過ぎだと\n思うけど…。",
            "zh": "即便如此，\n也兴奋得有点过头了，\n我觉得……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "透明ガブリエラ",
            "text": "$handle$は\nどう思う？",
            "zh": "$handle$\n怎么想？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "41/SEL",
            "narrator": "（選択肢）",
            "text": "はしゃいでると思う",
            "zh": "觉得太兴奋了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "42/SEL",
            "narrator": "（選択肢）",
            "text": "$me$も一緒に遊びたいよ",
            "zh": "$me$也想一起玩",
            "narrator_zh": "（选项）"
        },
        {
            "location": "43/ACT",
            "narrator": "",
            "text": "はしゃいでると思う",
            "zh": "觉得太兴奋了",
            "narrator_zh": ""
        },
        {
            "location": "46/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ほら、見なさいよ。\n$handle$にまで\n言われてるわよ？",
            "zh": "你看。\n连$handle$\n都这么说了？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "透明アーヤ",
            "text": "まったく…、\n$handle$まで\nそんなこと言って…。",
            "zh": "真是的……\n连$handle$\n也说这种话……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "48/ACT",
            "narrator": "",
            "text": "$me$も一緒に遊びたいよ",
            "zh": "$me$也想一起玩",
            "narrator_zh": ""
        },
        {
            "location": "50/TALK",
            "narrator": "透明アーヤ",
            "text": "一緒に遊べたら、\n私も楽しいんだけど…。",
            "zh": "要是能一起玩，\n我也会很开心……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "51/TALK",
            "narrator": "透明神楽",
            "text": "$handle$さんと\n遊べたら、\n何がしたいですか？",
            "zh": "要是能和$handle$\n一起玩，\n想做什么？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "53/TALK",
            "narrator": "透明アーヤ",
            "text": "うーん…考えてみると、\nこれをして遊びたい、\nってものはないかも。",
            "zh": "嗯……仔细一想，\n并没有特别\n想玩的。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "透明アーヤ",
            "text": "でも、静かなところで\nのんびりしながら、\n色々話をしたいわ。",
            "zh": "不过，想在安静的地方\n悠闲地待着，\n聊很多话。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "56/TALK",
            "narrator": "透明ガブリエラ",
            "text": "な、なにそれ？\n二人きりでなんて\n認めないから！",
            "zh": "什、什么？\n两个人独处这种事\n我可不答应！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "透明アーヤ",
            "text": "いや、別にギャヴィに\n認めてもらう必要は\nないんだけど…。",
            "zh": "不，也不是\n需要加维\n答应……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "透明アーヤ",
            "text": "大体、今日は訓練の無い、\n自由に遊べる日なのよ？",
            "zh": "再说，今天没有训练，\n是可以自由玩的日子吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "透明アーヤ",
            "text": "訓練は訓練、遊びは遊び。\nメリハリを付けるのは\n大切なことよ。",
            "zh": "训练是训练，玩是玩。\n分清界限\n很重要。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "63/SEL",
            "narrator": "（選択肢）",
            "text": "さすがアーヤ、いいこと言う",
            "zh": "不愧是绫水，说得真好",
            "narrator_zh": "（选项）"
        },
        {
            "location": "64/SEL",
            "narrator": "（選択肢）",
            "text": "ならデートしようよ",
            "zh": "那我们去约会吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "65/ACT",
            "narrator": "",
            "text": "さすがアーヤ、いいこと言う",
            "zh": "不愧是绫水，说得真好",
            "narrator_zh": ""
        },
        {
            "location": "67/TALK",
            "narrator": "透明アーヤ",
            "text": "$handle$も\nそう思うでしょ？",
            "zh": "$handle$也\n这么想吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "68/TALK",
            "narrator": "透明アーヤ",
            "text": "そういうわけだから…。",
            "zh": "就是这么回事……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "69/ACT",
            "narrator": "",
            "text": "ならデートしようよ",
            "zh": "那我们去约会吧",
            "narrator_zh": ""
        },
        {
            "location": "72/TALK",
            "narrator": "透明アーヤ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "透明神楽",
            "text": "あらら…、\n$handle$さんって\n大胆なんですね。",
            "zh": "哎呀……\n$handle$\n还真大胆。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "74/TALK",
            "narrator": "透明アーヤ",
            "text": "ちょ、ちょっと、\n$handle$！\nみんなの前よ…？",
            "zh": "等、等一下，\n$handle$！\n大家都在呢……？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "75/SEL",
            "narrator": "（選択肢）",
            "text": "だって、せっかくのお休みだし…",
            "zh": "因为难得放假……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "76/SEL",
            "narrator": "（選択肢）",
            "text": "$me$よりみんなが大切？",
            "zh": "比起$me$，大家更重要？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "77/ACT",
            "narrator": "",
            "text": "だって、せっかくのお休みだし",
            "zh": "因为难得放假……",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "透明アーヤ",
            "text": "でも、それにしたって\nいきなり過ぎだし…。",
            "zh": "可是，即便如此\n也太突然了……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "透明アーヤ",
            "text": "それに、誘ってくれるなら\n水着になる前だったら\nよかったのに…。",
            "zh": "而且，要邀请的话\n在换上泳衣之前\n就好了……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "透明つばめ",
            "text": "ここでデートすれば\nいいんじゃないですか？",
            "zh": "在这里约会\n不就行了吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "81/TALK",
            "narrator": "透明アーヤ",
            "text": "む、無理無理！\nみんな見てるでしょ！？",
            "zh": "不、不行不行！\n大家都看着吧！？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "82/TALK",
            "narrator": "透明神楽",
            "text": "じゃあ、私たちは\n退散した方がいいんじゃ\nないですか？",
            "zh": "那么，我们\n先避开比较好\n吧？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "84/TALK",
            "narrator": "透明神楽",
            "text": "私たちがいたら、\nデートの邪魔になって\nしまいそうですし。",
            "zh": "我们在的话，\n好像会妨碍\n约会。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "85/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そうねぇ…。\n$handle$は\nどうしてほしい？",
            "zh": "是啊……\n$handle$\n希望我们怎么做？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "86/SEL",
            "narrator": "（選択肢）",
            "text": "そうしてもらえたら最高",
            "zh": "能那样就最好了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "87/SEL",
            "narrator": "（選択肢）",
            "text": "いや、見せびらかしたい！",
            "zh": "不，我想炫耀！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "88/ACT",
            "narrator": "",
            "text": "そうしてもらえたら最高",
            "zh": "能那样就最好了",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "透明アーヤ",
            "text": "ま、まあ、確かにそれは\n最高かもしれないけど…。",
            "zh": "不、不过，那确实\n也许是最好的……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "91/TALK",
            "narrator": "透明アーヤ",
            "text": "でも、やっぱり今日は\nデート無し！！",
            "zh": "可是，今天果然\n不约会！！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "透明アーヤ",
            "text": "なんか、行き当たり\nばったりな感じだし。",
            "zh": "总觉得有点\n太临时起意了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "93/TALK",
            "narrator": "透明アーヤ",
            "text": "ちゃんと計画立てた\nデートじゃないと、\nロマンチックじゃないわ。",
            "zh": "不事先计划好的\n约会，\n就不浪漫。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "透明つばめ",
            "text": "ろ、ロマンチック…？",
            "zh": "浪、浪漫……？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "95/TALK",
            "narrator": "透明神楽",
            "text": "あ、アーヤさんって、\nそういうの期待する人\nだったんですね…？",
            "zh": "啊，绫水\n原来是会期待那种事\n的人……？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "97/TALK",
            "narrator": "透明ガブリエラ",
            "text": "普段はそんなの\n全く気にしないような\n性格なのに。",
            "zh": "平时明明是\n完全不在意那种事\n的性格。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "透明アーヤ",
            "text": "そ、そんなことより！",
            "zh": "那、那先别管这个！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "99/ACT",
            "narrator": "",
            "text": "いや、見せびらかしたい！",
            "zh": "不，我想炫耀！",
            "narrator_zh": ""
        },
        {
            "location": "100/TALK",
            "narrator": "透明アーヤ",
            "text": "私とのデートを見世物に\nしようとしないで！",
            "zh": "不要把和我的约会\n当成表演！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "101/TALK",
            "narrator": "透明ガブリエラ",
            "text": "怒られて当然ね。",
            "zh": "被骂也是当然的。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "透明つばめ",
            "text": "でも、アーヤさん達が\nどんなデートをするのか、\n見てみたかったなぁ…。",
            "zh": "可是，绫水她们\n会是什么样的约会，\n我还挺想看的……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "103/TALK",
            "narrator": "透明アーヤ",
            "text": "そんなことより！",
            "zh": "先别管这个！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "105/ACT",
            "narrator": "",
            "text": "$me$よりみんなが大切？",
            "zh": "比起$me$，大家更重要？",
            "narrator_zh": ""
        },
        {
            "location": "106/TALK",
            "narrator": "透明ガブリエラ",
            "text": "それはあんたが言っちゃ\nダメでしょ！？",
            "zh": "这种话可轮不到\n你来说吧！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "透明アーヤ",
            "text": "う～ん…みんなと\n$handle$は\n違うから…。",
            "zh": "嗯……大家和\n$handle$\n不一样……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "109/TALK",
            "narrator": "透明アーヤ",
            "text": "ちょっと、どっちの方が\n大切かは決められないわ。",
            "zh": "哪一边更重要，\n我决定不了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "110/TALK",
            "narrator": "透明アーヤ",
            "text": "でも…。",
            "zh": "可是……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "111/TALK",
            "narrator": "透明神楽",
            "text": "…でも？",
            "zh": "……可是？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "113/TALK",
            "narrator": "透明アーヤ",
            "text": "…ふふっ、なんでもない。",
            "zh": "……呵呵，没什么。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "透明つばめ",
            "text": "アーヤさん、\n$handle$さんを\n見て赤くなってるような？",
            "zh": "绫水，\n看着$handle$\n好像脸红了？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "115/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…もしかして、あたし達に\n見せつけてない？",
            "zh": "……难道，是在向我们\n炫耀？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "透明アーヤ",
            "text": "ち、違うから！\nそれより…。",
            "zh": "不、不是！\n先别管这个……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "119/TALK",
            "narrator": "透明アーヤ",
            "text": "こんなことしてても\n時間を無駄にしてる\nだけなんだし…。",
            "zh": "一直这样\n只是在浪费时间\n而已……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "122/TALK",
            "narrator": "透明アーヤ",
            "text": "せっかくの海を\n楽しむとしましょ。\nそれっ！",
            "zh": "难得的海，\n好好享受吧。\n来！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "透明神楽",
            "text": "きゃっ！？",
            "zh": "呀！？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "129/TALK",
            "narrator": "透明つばめ",
            "text": "冷たっ！？",
            "zh": "好冰！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "131/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ちょ、アーヤ！\nやったわね！？",
            "zh": "等、绫水！\n是你干的吧！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "透明神楽",
            "text": "つばめさん、\nこっちも応戦しましょう！",
            "zh": "燕，\n我们也反击吧！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "133/TALK",
            "narrator": "透明つばめ",
            "text": "うん。\nえーいっ！",
            "zh": "嗯。\n嘿！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "138/TALK",
            "narrator": "透明アーヤ",
            "text": "冷たっ！？",
            "zh": "好冰！？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "139/TALK",
            "narrator": "透明神楽",
            "text": "参ったって言うまで\nやめません！",
            "zh": "不说到认输\n我就不停！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "140/TALK",
            "narrator": "透明神楽",
            "text": "つばめさんも、\n手を止めないでください。",
            "zh": "燕也请\n别停下手里的动作。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "142/TALK",
            "narrator": "透明つばめ",
            "text": "早く参ったって言わないと\nびしょ濡れになっちゃい\nますよ。",
            "zh": "不快点说认输的话\n可就要湿透\n了。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "146/TALK",
            "narrator": "透明アーヤ",
            "text": "ぎゃ、ギャヴィ！\nお願い、助けて！",
            "zh": "加、加维！\n拜托，帮帮我！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "148/TALK",
            "narrator": "透明ガブリエラ",
            "text": "はぁ…仕方ないわね。",
            "zh": "唉……真没办法。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "149/TALK",
            "narrator": "透明神楽",
            "text": "ちょ、ガブちゃん！\nアーヤさん側に\nつくんですか？",
            "zh": "等、加布！\n你要站到绫水\n那边吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "150/TALK",
            "narrator": "透明ガブリエラ",
            "text": "当然。\n先輩チームの実力、\n見せてやるわ！",
            "zh": "当然。\n前辈组的实力，\n给你们看看！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "透明つばめ",
            "text": "きゃーっ！！\nが、ガブちゃん、\n激し過ぎるよーっ！！",
            "zh": "呀啊——！！\n加、加布，\n也太猛了呀——！！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "155/TALK",
            "narrator": "透明ガブリエラ",
            "text": "アーヤ、\n一気に攻めるわよ！",
            "zh": "绫水，\n一口气进攻！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "157/TALK",
            "narrator": "透明アーヤ",
            "text": "了解、それーっ！！",
            "zh": "知道了，上——！！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "161/TALK",
            "narrator": "透明神楽",
            "text": "わ、わかりました！\n降参、参りました！\n私達の負けですーっ！",
            "zh": "我、我知道了！\n认输，我服了！\n是我们输了——！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "163/TALK",
            "narrator": "透明つばめ",
            "text": "うーっ、入ったばかりで\nびしょ濡れだよぉ…。",
            "zh": "呜……刚下海\n就湿透了呀……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "164/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あはは、先輩組に\n勝とうだなんて\n十年早いわ。",
            "zh": "啊哈哈，想赢\n前辈组，\n还早十年。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "透明アーヤ",
            "text": "ふふっ…。",
            "zh": "呵呵……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "166/SEL",
            "narrator": "（選択肢）",
            "text": "お休み楽しんでね",
            "zh": "好好享受假期吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "167/ACT",
            "narrator": "",
            "text": "お休み楽しんでね",
            "zh": "好好享受假期吧",
            "narrator_zh": ""
        },
        {
            "location": "170/TALK",
            "narrator": "透明アーヤ",
            "text": "うん…。\nでも、ごめんなさい。",
            "zh": "嗯……\n不过，对不起。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "171/TALK",
            "narrator": "透明アーヤ",
            "text": "$handle$のこと\nもっと相手してあげられ\nなくて…。",
            "zh": "没能好好地\n陪$handle$，\n对不起……",
            "narrator_zh": "透明绫水"
