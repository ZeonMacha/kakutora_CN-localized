{
    "dir": "chap13/daydra/dd_ch04_13_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "13405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "穴へは飛び込むべきか＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "该不该往洞里跳＜后篇＞"
    },
    "entry": [
        {
            "location": "319/SCENARIO",
            "narrator": "",
            "text": "うさぎと女王",
            "zh": "兔子与女王",
            "narrator_zh": ""
        },
        {
            "location": "331/TALK",
            "narrator": "みやび",
            "text": "…いや、さすがに\n回数減らすんは問題やな。",
            "zh": "…不，减少来往\n终归是个问题咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "332/TALK",
            "narrator": "みやび",
            "text": "作業に支障が出る\n恐れもあるし。",
            "zh": "而且也恐怕\n会妨碍干活。",
            "narrator_zh": "雅"
        },
        {
            "location": "333/TALK",
            "narrator": "みやび",
            "text": "…まあ、うちらは\n今くらいの距離が一番\nえいかもしれんね…。",
            "zh": "…嘛，我们啊，\n保持现在这种距离\n说不定才是最好咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "337/TALK",
            "narrator": "みやび",
            "text": "ん…なんや？",
            "zh": "嗯…驷马事？",
            "narrator_zh": "雅"
        },
        {
            "location": "342/TALK",
            "narrator": "ラビットアニマ",
            "text": "申し訳ありません",
            "zh": "非常抱歉",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "343/TALK",
            "narrator": "ラビットアニマ",
            "text": "先ほど伝え忘れていましたが",
            "zh": "刚才忘记告知了",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "344/TALK",
            "narrator": "ラビットアニマ",
            "text": "こちらでも解析したデータがありました",
            "zh": "我们这边也有已解析的数据",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "347/TALK",
            "narrator": "フェイタルクイーン",
            "text": "ご苦労",
            "zh": "辛苦了",
            "narrator_zh": "致命女王"
        },
        {
            "location": "348/TALK",
            "narrator": "フェイタルクイーン",
            "text": "ファイルはいつもの場所によろしく",
            "zh": "文件放到老地方",
            "narrator_zh": "致命女王"
        },
        {
            "location": "350/TALK",
            "narrator": "ラビットアニマ",
            "text": "承知しました",
            "zh": "遵命",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "352/TALK",
            "narrator": "ラビットアニマ",
            "text": "アップしましたので、後程確認を",
            "zh": "已上传，请稍后确认",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "354/TALK",
            "narrator": "フェイタルクイーン",
            "text": "了解",
            "zh": "了解",
            "narrator_zh": "致命女王"
        },
        {
            "location": "356/TALK",
            "narrator": "ラビットアニマ",
            "text": "それでは",
            "zh": "那么",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "358/TALK",
            "narrator": "フェイタルクイーン",
            "text": "いや待て",
            "zh": "不，等等",
            "narrator_zh": "致命女王"
        },
        {
            "location": "361/TALK",
            "narrator": "ラビットアニマ",
            "text": "他に何か？",
            "zh": "还有什么事？",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "365/TALK",
            "narrator": "フェイタルクイーン",
            "text": "いや",
            "zh": "不",
            "narrator_zh": "致命女王"
        },
        {
            "location": "366/TALK",
            "narrator": "フェイタルクイーン",
            "text": "大したことではないが",
            "zh": "不是什么大事",
            "narrator_zh": "致命女王"
        },
        {
            "location": "368/TALK",
            "narrator": "フェイタルクイーン",
            "text": "ふと思ってな",
            "zh": "只是忽然想到",
            "narrator_zh": "致命女王"
        },
        {
            "location": "369/TALK",
            "narrator": "フェイタルクイーン",
            "text": "うさぎとも",
            "zh": "和兔子也",
            "narrator_zh": "致命女王"
        },
        {
            "location": "370/TALK",
            "narrator": "フェイタルクイーン",
            "text": "大分長い付き合いになったなと",
            "zh": "算相处很久了啊",
            "narrator_zh": "致命女王"
        },
        {
            "location": "373/TALK",
            "narrator": "ラビットアニマ",
            "text": "そうですね",
            "zh": "是啊",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "375/TALK",
            "narrator": "ラビットアニマ",
            "text": "突然どうしたのですか？",
            "zh": "怎么突然说这个？",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "377/TALK",
            "narrator": "フェイタルクイーン",
            "text": "いや",
            "zh": "没什么",
            "narrator_zh": "致命女王"
        },
        {
            "location": "379/TALK",
            "narrator": "フェイタルクイーン",
            "text": "私のしている行為は大袈裟でなく",
            "zh": "我在做的事毫不夸张地说",
            "narrator_zh": "致命女王"
        },
        {
            "location": "380/TALK",
            "narrator": "フェイタルクイーン",
            "text": "かなり危険なものだ",
            "zh": "相当危险",
            "narrator_zh": "致命女王"
        },
        {
            "location": "381/TALK",
            "narrator": "フェイタルクイーン",
            "text": "国に対する反逆行為と言っても過言ではない",
            "zh": "说成是对国家的反逆行为也不为过",
            "narrator_zh": "致命女王"
        },
        {
            "location": "383/TALK",
            "narrator": "フェイタルクイーン",
            "text": "なのに",
            "zh": "可即便如此",
            "narrator_zh": "致命女王"
        },
        {
            "location": "384/TALK",
            "narrator": "フェイタルクイーン",
            "text": "君は文句ひとつ言わず協力してくれている",
            "zh": "你还是一句怨言都没有地协助着我",
            "narrator_zh": "致命女王"
        },
        {
            "location": "388/TALK",
            "narrator": "フェイタルクイーン",
            "text": "感謝する",
            "zh": "多谢了",
            "narrator_zh": "致命女王"
        },
        {
            "location": "389/TALK",
            "narrator": "フェイタルクイーン",
            "text": "これからも頼りにしていいだろうか？",
            "zh": "今后也可以继续信赖你吧？",
            "narrator_zh": "致命女王"
        },
        {
            "location": "392/TALK",
            "narrator": "ラビットアニマ",
            "text": "愚問です",
            "zh": "多此一问",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "393/TALK",
            "narrator": "システム",
            "text": "『RabbitAnimaが退出しました』",
            "zh": "『RabbitAnima已退出』",
            "narrator_zh": "系统"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "397/TALK",
            "narrator": "みやび",
            "text": "ははっ…、\n愚問と来たかぁ…。",
            "zh": "哈哈…，\n竟然回我多此一问啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "402/TALK",
            "narrator": "みやび",
            "text": "らしくないことをするとどうなるか？",
            "zh": "做不像自己的事会怎么样？",
            "narrator_zh": "雅"
        },
        {
            "location": "403/TALK",
            "narrator": "みやび",
            "text": "答えは簡単",
            "zh": "答案很简单",
            "narrator_zh": "雅"
        },
        {
            "location": "404/TALK",
            "narrator": "みやび",
            "text": "顔が熱くなる",
            "zh": "脸会发烫",
            "narrator_zh": "雅"
        },
        {
            "location": "407/SEL",
            "narrator": "",
            "text": "照れてる、ってことね？",
            "zh": "也就是说，是害羞了？",
            "narrator_zh": ""
        },
        {
            "location": "408/ACT",
            "narrator": "",
            "text": "照れてる、ってことね？",
            "zh": "也就是说，是害羞了？",
            "narrator_zh": ""
        },
        {
            "location": "411/TALK",
            "narrator": "みやび",
            "text": "簡単に言えばそうなる",
            "zh": "简单来说就是那样",
            "narrator_zh": "雅"
        },
        {
            "location": "412/TALK",
            "narrator": "みやび",
            "text": "しかし",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "413/TALK",
            "narrator": "みやび",
            "text": "まっことうちらしくない",
            "zh": "真是，太不像我们了",
            "narrator_zh": "雅"
        },
        {
            "location": "414/TALK",
            "narrator": "みやび",
            "text": "ウサギも今頃",
            "zh": "兔子现在这个点",
            "narrator_zh": "雅"
        },
        {
            "location": "415/TALK",
            "narrator": "みやび",
            "text": "クイーン壊れた",
            "zh": "Queen坏掉了",
            "narrator_zh": "雅"
        },
        {
            "location": "416/TALK",
            "narrator": "みやび",
            "text": "とか思うてるに違いない",
            "zh": "肯定正这么想着",
            "narrator_zh": "雅"
        },
        {
            "location": "418/SEL",
            "narrator": "",
            "text": "でも、気持ちを伝えるのは大切",
            "zh": "但是，传达心意很重要",
            "narrator_zh": ""
        },
        {
            "location": "419/ACT",
            "narrator": "",
            "text": "でも、気持ちを伝えるのは大切",
            "zh": "但是，传达心意很重要",
            "narrator_zh": ""
        },
        {
            "location": "423/TALK",
            "narrator": "みやび",
            "text": "反論の余地なし",
            "zh": "毫无反驳余地",
            "narrator_zh": "雅"
        },
        {
            "location": "424/TALK",
            "narrator": "みやび",
            "text": "うちもそう思う",
            "zh": "我也这么想",
            "narrator_zh": "雅"
        },
        {
            "location": "425/TALK",
            "narrator": "みやび",
            "text": "言うてよかった",
            "zh": "说出来真是太好了",
            "narrator_zh": "雅"
        },
        {
            "location": "427/TALK",
            "narrator": "みやび",
            "text": "らしくないことも",
            "zh": "不像自己的事，",
            "narrator_zh": "雅"
        },
        {
            "location": "428/TALK",
            "narrator": "みやび",
            "text": "たまには良しとしよう",
            "zh": "偶尔也放过吧",
            "narrator_zh": "雅"
        },
        {
            "location": "433/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "434/TALK",
            "narrator": "みやび",
            "text": "さっきの会話ログ、\n保存しとくか…。",
            "zh": "刚才的对话日志，\n保存下来吧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "445/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【MV EXE_AYAMi】",
            "zh": "【MV EXE_AYAMi】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
}
