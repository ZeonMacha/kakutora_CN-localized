{
    "dir": "chap27/daydra/dd_ch05_27_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "27505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "その先への妥結点＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "通往前方的妥协点＜后篇＞[?]"
    },
    "entry": [
        {
            "location": "2530/TALK",
            "narrator": "神楽",
            "text": "…もう、しつこい。",
            "zh": "……真是的，没完没了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2556/TALK",
            "narrator": "神楽",
            "text": "はい――",
            "zh": "来了——",
            "narrator_zh": "神乐"
        },
        {
            "location": "2558/TALK",
            "narrator": "神楽",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2562/TALK",
            "narrator": "繭",
            "text": "…こんにちは。",
            "zh": "……你好。",
            "narrator_zh": "茧"
        },
        {
            "location": "2563/TALK",
            "narrator": "雛",
            "text": "久しぶりだね…。",
            "zh": "好久不见呢……。",
            "narrator_zh": "雏"
        },
        {
            "location": "2564/TALK",
            "narrator": "神楽",
            "text": "…どうして？\n家の場所、\n教えてないのに…。",
            "zh": "……为什么？\n家里的地址，\n我明明没告诉过你们……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2565/TALK",
            "narrator": "繭",
            "text": "東雲教官から\n教えてもらった。",
            "zh": "是东云教官\n告诉我的。",
            "narrator_zh": "茧"
        },
        {
            "location": "2568/TALK",
            "narrator": "神楽",
            "text": "…あの人は、\n人の個人情報を\n勝手に…。",
            "zh": "……那个人，\n擅自把别人的\n个人信息……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2569/TALK",
            "narrator": "神楽",
            "text": "あとで抗議するべき\nかもしれませんね。",
            "zh": "回头也许该去\n抗议一下了呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2570/TALK",
            "narrator": "繭",
            "text": "勝手にどうぞ。\n自分のしたことを\n棚に上げられればね。",
            "zh": "请便。\n只要你还能不提\n自己干过的事的话。",
            "narrator_zh": "茧"
        },
        {
            "location": "2572/TALK",
            "narrator": "神楽",
            "text": "…私がなにをしたか、\n知ってるんですね。",
            "zh": "……我干过什么，\n你们已经知道了啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2573/TALK",
            "narrator": "雛",
            "text": "全部聞いたよ。\nほんと、ビックリ\nしたんだから…。",
            "zh": "全听说了哦。\n真是的，可把我们\n吓了一跳……。",
            "narrator_zh": "雏"
        },
        {
            "location": "2574/TALK",
            "narrator": "神楽",
            "text": "…それで？\nＷＡＶＥじゃ\n話せないことですか？",
            "zh": "……所以呢？\n是在WAVE上\n不能说的事吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2575/TALK",
            "narrator": "繭",
            "text": "監視されてるでしょ？\n会話を覗き見される\nなんてごめんだもの。",
            "zh": "不是被监视着吗？\n对话被人偷窥什么的，\n我可受不了。",
            "narrator_zh": "茧"
        },
        {
            "location": "2576/TALK",
            "narrator": "繭",
            "text": "だから、直接来た…。\n上がっても？",
            "zh": "所以，直接过来了……。\n能进去吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "2577/TALK",
            "narrator": "神楽",
            "text": "ダメ！！",
            "zh": "不行！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2580/TALK",
            "narrator": "神楽",
            "text": "家の中は…。\n話なら、外で…。",
            "zh": "家里不行……。\n要谈的话，去外面……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2607/TALK",
            "narrator": "神楽",
            "text": "…それで？\nどうしてうちに\n来たんですか？",
            "zh": "……所以呢？\n你们为什么\n来我家？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2608/TALK",
            "narrator": "繭",
            "text": "卯月さんになにが\nあったのか…。\n教官から全部聞いた。",
            "zh": "卯月身上发生过\n什么事……。\n从教官那里全听说了。",
            "narrator_zh": "茧"
        },
        {
            "location": "2609/TALK",
            "narrator": "繭",
            "text": "正直、あなたが\n裏切ったと聞いた時は\n許せなかったけど…。",
            "zh": "老实说，听说你\n背叛的时候，\n我原谅不了你……。",
            "narrator_zh": "茧"
        },
        {
            "location": "2610/TALK",
            "narrator": "繭",
            "text": "事情を知ったから、\n許すわ。",
            "zh": "不过既然知道了原委，\n我原谅你了。",
            "narrator_zh": "茧"
        },
        {
            "location": "2611/TALK",
            "narrator": "神楽",
            "text": "…は？\nなんですか、それ？",
            "zh": "……哈？\n那是什么话？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2612/TALK",
            "narrator": "神楽",
            "text": "私がいつ許しを\n請いましたか？",
            "zh": "我什么时候\n请求过你的原谅？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2613/TALK",
            "narrator": "繭",
            "text": "…言い方が悪かった。\n今のは忘れて。",
            "zh": "……是我说得不好。\n刚才的话忘了吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "2614/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "2615/TALK",
            "narrator": "神楽",
            "text": "…なんですか、\nひなこさん？",
            "zh": "……怎么了，\n雏？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2616/TALK",
            "narrator": "雛",
            "text": "いや、ちょっとね。\n今の神楽ちゃん、\n新鮮だなー、って。",
            "zh": "没，就是觉得啊。\n刚才那样的神乐，\n挺新鲜的——。",
            "narrator_zh": "雏"
        },
        {
            "location": "2617/TALK",
            "narrator": "繭",
            "text": "同感。\nそんな風に怒るの、\n初めて見たから。",
            "zh": "同感。\n你那样生气的样子，\n还是第一次见到。",
            "narrator_zh": "茧"
        },
        {
            "location": "2618/TALK",
            "narrator": "繭",
            "text": "…あなたも、\n人間ってことね。\n安心した。",
            "zh": "……原来你也是\n人啊。\n我放心了。",
            "narrator_zh": "茧"
        },
        {
            "location": "2621/TALK",
            "narrator": "神楽",
            "text": "に、人間って…。\nなんですかそれ…。",
            "zh": "什、什么叫人啊……。\n那是什么意思……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2622/TALK",
            "narrator": "繭",
            "text": "思ったことを\n言っただけ。\n気にしないで。",
            "zh": "只是想到什么\n说什么而已。\n别在意。",
            "narrator_zh": "茧"
        },
        {
            "location": "2623/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2624/TALK",
            "narrator": "神楽",
            "text": "でも…なんでだろ？",
            "zh": "可是……为什么呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2626/TALK",
            "narrator": "神楽",
            "text": "ちょっとだけ、\n気持ちがラクに\nなったような…。",
            "zh": "总觉得心情\n稍微轻松了\n一点点……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2629/TALK",
            "narrator": "神楽",
            "text": "…そ、それで？\n私になんの用なん\nですか？",
            "zh": "……那、那么？\n你们找我有\n什么事？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2630/TALK",
            "narrator": "繭",
            "text": "ちょっとした\nお願いだけど――",
            "zh": "有一件小事想\n拜托你——",
            "narrator_zh": "茧"
        },
        {
            "location": "2632/TALK",
            "narrator": "雛",
            "text": "神楽ちゃんの\nガジェット、\nちょっと貸してー。",
            "zh": "神乐的\nGadget，\n稍微借我一下——。",
            "narrator_zh": "雏"
        },
        {
            "location": "2633/TALK",
            "narrator": "神楽",
            "text": "は？",
            "zh": "哈？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2642/TALK",
            "narrator": "雛",
            "text": "それじゃ遠慮なく、\nフトモモを拝借っと！",
            "zh": "那我就不客气，\n借用一下大腿啦！",
            "narrator_zh": "雏"
        },
        {
            "location": "2643/TALK",
            "narrator": "神楽",
            "text": "あ、ちょっと\nひなこさん！！\nなにしてるんですか！",
            "zh": "啊，等一下\n雏！！\n你在干什么啊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2646/TALK",
            "narrator": "雛",
            "text": "取れないみたいだから\nそのまま配線するしか\nないでしょ？",
            "zh": "好像摘不下来，\n那不就只能这样直接\n接线了吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "2651/TALK",
            "narrator": "神楽",
            "text": "待ってください！\nちゃんと理由を\n説明してください！",
            "zh": "等一下！\n先好好把理由\n解释清楚啊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2652/TALK",
            "narrator": "繭",
            "text": "情報管理庁の\n内部情報を\n調べていたら…。",
            "zh": "我们在调查\n情报管理厅的\n内部信息时……。",
            "narrator_zh": "茧"
        },
        {
            "location": "2653/TALK",
            "narrator": "繭",
            "text": "ちょっと見過ごせない\nことがあって。",
            "zh": "发现了一件\n无法坐视不管的事。",
            "narrator_zh": "茧"
        },
        {
            "location": "2654/TALK",
            "narrator": "神楽",
            "text": "…というと？",
            "zh": "……是指什么？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2655/TALK",
            "narrator": "繭",
            "text": "トライナリーの情報を\n見つけたの。",
            "zh": "我找到了\n三重奏的情报。",
            "narrator_zh": "茧"
        },
        {
            "location": "2656/TALK",
            "narrator": "神楽",
            "text": "管理庁なんだから、\nあって当然だと\n思いますけど？",
            "zh": "毕竟是管理厅，\n有那些情报不是\n理所当然的吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2657/TALK",
            "narrator": "繭",
            "text": "逢瀬さん達の\nガジェットとの\nI/Oも見つけた。",
            "zh": "我还找到了与逢濑她们\nGadget之间的\nI/O记录。",
            "narrator_zh": "茧"
        },
        {
            "location": "2658/TALK",
            "narrator": "繭",
            "text": "どうやったのかは\nわからないけど…。",
            "zh": "虽然不知道\n是怎么做到的……。",
            "narrator_zh": "茧"
        },
        {
            "location": "2659/TALK",
            "narrator": "繭",
            "text": "ただ、その中に\n卯月さんのだけは\n無かった…。",
            "zh": "只是，那里面\n唯独没有\n卯月的……。",
            "narrator_zh": "茧"
        },
        {
            "location": "2662/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2663/TALK",
            "narrator": "繭",
            "text": "ヒントは多分、\nそこにあるはず。",
            "zh": "线索大概\n就在那里。",
            "narrator_zh": "茧"
        },
        {
            "location": "2664/TALK",
            "narrator": "繭",
            "text": "だから、サーバー側に\n何も無いのなら…。",
            "zh": "所以，既然服务器端\n什么都没有……。",
            "narrator_zh": "茧"
        },
        {
            "location": "2665/TALK",
            "narrator": "繭",
            "text": "クライアントを\n調べるというのが\n鉄則。",
            "zh": "去调查客户端\n才是\n铁律。",
            "narrator_zh": "茧"
        },
        {
            "location": "2666/TALK",
            "narrator": "繭",
            "text": "だから、触らせて\nもらいに来た。",
            "zh": "所以，我才过来\n借来查一下。",
            "narrator_zh": "茧"
        },
        {
            "location": "2667/TALK",
            "narrator": "雛",
            "text": "そーゆーわけだから、\nちょっと失礼ー。",
            "zh": "就是这么回事，\n稍微失礼一下——。",
            "narrator_zh": "雏"
        },
        {
            "location": "2669/TALK",
            "narrator": "神楽",
            "text": "そ、それなら、\n私が自分で\n配線しますから――",
            "zh": "那、那样的话，\n我自己来\n接线就行了——",
            "narrator_zh": "神乐"
        },
        {
            "location": "2670/TALK",
            "narrator": "雛",
            "text": "神楽ちゃん、\n動かない！！",
            "zh": "神乐，\n别动！！",
            "narrator_zh": "雏"
        },
        {
            "location": "2672/TALK",
            "narrator": "神楽",
            "text": "は、はい…。",
            "zh": "是、是的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2677/TALK",
            "narrator": "雛",
            "text": "えーっと…。",
            "zh": "嗯——……。",
            "narrator_zh": "雏"
        },
        {
            "location": "2679/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2680/TALK",
            "narrator": "雛",
            "text": "あれ？\n神楽ちゃん、\nどうかした？",
            "zh": "咦？\n神乐，\n怎么了吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "2682/TALK",
            "narrator": "神楽",
            "text": "い、いえ…。\nまだですか？",
            "zh": "没、没有……。\n还没好吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2683/TALK",
            "narrator": "雛",
            "text": "もーちょいだよー。",
            "zh": "再等一下哦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "2688/TALK",
            "narrator": "神楽",
            "text": "…配線が、\n太ももに当たって\nくすぐったい…。",
            "zh": "……电线碰到\n大腿上\n好痒……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2689/TALK",
            "narrator": "雛",
            "text": "ん、できたよー。\n後はまゆちん、\nよろしくー。",
            "zh": "嗯，接好了——。\n剩下就拜托小茧\n啦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "2690/TALK",
            "narrator": "繭",
            "text": "…問題ない。\nちゃんと繋がってる。",
            "zh": "……没问题。\n好好连上了。",
            "narrator_zh": "茧"
        },
        {
            "location": "2691/TALK",
            "narrator": "繭",
            "text": "データを取る間、\nそのまま動かないで。",
            "zh": "读取数据的期间，\n就这样别动。",
            "narrator_zh": "茧"
        },
        {
            "location": "2693/TALK",
            "narrator": "神楽",
            "text": "…わかりました。",
            "zh": "……知道了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2694/TALK",
            "narrator": "神楽",
            "text": "…っていうか、\nこれ絶対パンツ\n丸見えじゃない？",
            "zh": "……话说回来，\n这样子内裤绝对\n被看光了吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2695/TALK",
            "narrator": "神楽",
            "text": "こんなことなら、\n丈の長いスカート\n履いてくるんだった。",
            "zh": "早知道这样，\n就该穿条长一点的\n裙子过来的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2696/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2697/TALK",
            "narrator": "雛",
            "text": "これ…すごいね。",
            "zh": "这个……好厉害呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "2698/TALK",
            "narrator": "繭",
            "text": "ええ…驚いた。",
            "zh": "嗯……真让人吃惊。",
            "narrator_zh": "茧"
        },
        {
            "location": "2701/TALK",
            "narrator": "神楽",
            "text": "な、なにかデータが\n取れたんですか？",
            "zh": "读、读取到什么\n数据了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2702/TALK",
            "narrator": "雛",
            "text": "うん…真っ黒。",
            "zh": "嗯……一片漆黑。",
            "narrator_zh": "雏"
        },
        {
            "location": "2703/TALK",
            "narrator": "神楽",
            "text": "黒？",
            "zh": "黑？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2705/TALK",
            "narrator": "雛",
            "text": "神楽ちゃん、\n黒パンツなんだね。\n大人だなー。",
            "zh": "神乐，你穿的是\n黑内裤呢。\n好成熟啊——。",
            "narrator_zh": "雏"
        },
        {
            "location": "2707/TALK",
            "narrator": "神楽",
            "text": "は！？",
            "zh": "哈！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2708/TALK",
            "narrator": "繭",
            "text": "さすがはお嬢様。\nこれを履いてるなんて\nお目が高い。",
            "zh": "不愧是大小姐。\n居然穿这条，\n好眼力。",
            "narrator_zh": "茧"
        },
        {
            "location": "2709/TALK",
            "narrator": "神楽",
            "text": "ま、繭さんまで！",
            "zh": "连、连茧也这样！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2710/TALK",
            "narrator": "雛",
            "text": "おおっ、まゆちんも\nそう思う！？",
            "zh": "哦哦，小茧也\n这么觉得！？",
            "narrator_zh": "雏"
        },
        {
            "location": "2711/TALK",
            "narrator": "繭",
            "text": "これ、フランスの\nウン・プティッテ・フィル\nミニヨンでしょ。",
            "zh": "这是法国的\nUne Petite Fille\nMignonne吧。[?]",
            "narrator_zh": "茧"
        },
        {
            "location": "2714/TALK",
            "narrator": "神楽",
            "text": "ちょっ！\nうそ、なんで！？",
            "zh": "等下！\n不会吧，你怎么知道！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2715/TALK",
            "narrator": "雛",
            "text": "へー、おフランス製！？",
            "zh": "嘿——，法国正宗货！？",
            "narrator_zh": "雏"
        },
        {
            "location": "2716/TALK",
            "narrator": "繭",
            "text": "俗な安物じゃない、\n本気のゴシック系\nブランドね。",
            "zh": "不是俗气的便宜货，\n是认真的哥特系\n品牌呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "2717/TALK",
            "narrator": "繭",
            "text": "そのショーツを\n持ってるなんて…、\nマニアック過ぎる。",
            "zh": "居然连这条内裤\n都有……，\n太发烧友了吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "2718/TALK",
            "narrator": "神楽",
            "text": "うわあああああ、\n恥ずかしすぎるん\nですけどこれ！",
            "zh": "呜哇啊啊啊啊，\n这也太\n羞耻了吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2719/TALK",
            "narrator": "雛",
            "text": "っていうか、\nまゆちんは\nなんで知ってるの？",
            "zh": "说起来，\n小茧你\n怎么会知道的？",
            "narrator_zh": "雏"
        },
        {
            "location": "2720/TALK",
            "narrator": "繭",
            "text": "そ、それは…。",
            "zh": "那、那是因为……。",
            "narrator_zh": "茧"
        },
        {
            "location": "2721/TALK",
            "narrator": "繭",
            "text": "私も…、いくつか\n持ってるから…。",
            "zh": "我也……有\n好几条……。",
            "narrator_zh": "茧"
        },
        {
            "location": "2722/TALK",
            "narrator": "神楽",
            "text": "え！？",
            "zh": "诶！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2723/TALK",
            "narrator": "神楽",
            "text": "繭さんも\n持ってるんですか！？",
            "zh": "茧也\n有吗！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2724/TALK",
            "narrator": "繭",
            "text": "デザイン、\n生地の肌触り、\nどちらも極上。",
            "zh": "设计、\n布料的触感，\n全都是极品。",
            "narrator_zh": "茧"
        },
        {
            "location": "2725/TALK",
            "narrator": "神楽",
            "text": "フィット感も\nいいですよね。",
            "zh": "贴身感也\n很好对吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2726/TALK",
            "narrator": "繭",
            "text": "履いてるのを忘れる\n軽いフィット感…、\nクセになるわ。",
            "zh": "轻盈贴身到让人\n忘了自己穿着……，\n会上瘾的。",
            "narrator_zh": "茧"
        },
        {
            "location": "2727/TALK",
            "narrator": "雛",
            "text": "そんなにいいんだー？\nあたしも履いてみよう\nかなー？",
            "zh": "有那么好啊——？\n要不我也买来\n穿穿看——？",
            "narrator_zh": "雏"
        },
        {
            "location": "2728/TALK",
            "narrator": "繭",
            "text": "ひなこには\n似合わない。",
            "zh": "不适合\n雏。",
            "narrator_zh": "茧"
        },
        {
            "location": "2729/TALK",
            "narrator": "神楽",
            "text": "ひなこさんには\n合わないかも…。",
            "zh": "也许不太适合\n雏……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2730/TALK",
            "narrator": "雛",
            "text": "ちょ！？\n二人ともヒドい！！",
            "zh": "喂！？\n你们两个太过分了！！",
            "narrator_zh": "雏"
        },
        {
            "location": "2731/TALK",
            "narrator": "繭",
            "text": "ふふっ…。",
            "zh": "呵呵……。",
            "narrator_zh": "茧"
        },
        {
            "location": "2732/TALK",
            "narrator": "神楽",
            "text": "ふふっ…。",
            "zh": "呵呵……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2737/TALK",
            "narrator": "繭",
            "text": "データが\n取れたみたい。",
            "zh": "数据好像\n读取完了。",
            "narrator_zh": "茧"
        },
        {
            "location": "2738/TALK",
            "narrator": "雛",
            "text": "どう？\nちゃんと取れてる？",
            "zh": "怎么样？\n好好读出来了吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "2740/TALK",
            "narrator": "繭",
            "text": "今確認する。",
            "zh": "现在确认。",
            "narrator_zh": "茧"
        },
        {
            "location": "2754/TALK",
            "narrator": "繭",
            "text": "…ッ！？\nこれは…。",
            "zh": "……！？\n这是……。",
            "narrator_zh": "茧"
        },
        {
            "location": "2755/TALK",
            "narrator": "雛",
            "text": "ど、どうしたの？\nなにかヤバいこと\n書いてあった？",
            "zh": "怎、怎么了？\n上面写了什么\n不得了的东西吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "2756/TALK",
            "narrator": "繭",
            "text": "…日付が、\n２０３２年って…。",
            "zh": "……日期写着，\n２０３２年……。",
            "narrator_zh": "茧"
        },
        {
            "location": "2758/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2759/TALK",
            "narrator": "雛",
            "text": "設定が狂ってる…、\nなんて、ないよね？",
            "zh": "设置乱掉了……，\n不会吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "2760/TALK",
            "narrator": "繭",
            "text": "ありえない…。\nだとすると…。",
            "zh": "不可能……。\n如果是这样的话……。",
            "narrator_zh": "茧"
        },
        {
            "location": "2761/TALK",
            "narrator": "繭",
            "text": "卯月さん。\nなにか心当たりが\nあるんじゃない？",
            "zh": "卯月。\n你应该知道\n些什么吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "2762/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2764/TALK",
            "narrator": "雛",
            "text": "神楽ちゃん！\n知ってるなら教えて！",
            "zh": "神乐！\n知道的话就告诉我们！",
            "narrator_zh": "雏"
        },
        {
            "location": "2765/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2766/TALK",
            "narrator": "神楽",
            "text": "わかり、ました…。",
            "zh": "我、知道了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2768/TALK",
            "narrator": "神楽",
            "text": "私も…これ以上、\nひなこさん達に…。",
            "zh": "我也……不想再对\n雏你们……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2769/TALK",
            "narrator": "神楽",
            "text": "ウソはつきたく\nありません。",
            "zh": "继续\n撒谎了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2772/TALK",
            "narrator": "神楽",
            "text": "本当のことを\nお話しします。",
            "zh": "我会把真相\n告诉你们。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2773/TALK",
            "narrator": "神楽",
            "text": "私は――",
            "zh": "我——",
            "narrator_zh": "神乐"
        },
        {
            "location": "2783/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【22 トークン・リング】",
            "zh": "【22 令牌环】",
            "narrator_zh": "Dialog_chapter_ch05"
        },
        {
            "location": "2795/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【22 トークン・リング】",
            "zh": "【22 令牌环】",
            "narrator_zh": "Dialog_chapter_ch05"
        }
    ]
}
