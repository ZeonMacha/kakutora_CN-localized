{
    "dir": "chap07/daydra/dd_ch02_07_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "7252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "真幌との会話",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "与真幌的对话"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "真幌との会話",
            "zh": "和真幌的对话",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "真幌",
            "text": "アーヤ、\nバイトの後は暇か？",
            "zh": "绫水，\n打工之后有空吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "25/TALK",
            "narrator": "アーヤ",
            "text": "ええ、まあ…。",
            "zh": "嗯，算是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "26/TALK",
            "narrator": "真幌",
            "text": "そうか。\nなら、仕事が終わったら\n一杯どうだ？",
            "zh": "是吗。\n那，工作结束后\n喝一杯怎么样？",
            "narrator_zh": "真幌"
        },
        {
            "location": "27/TALK",
            "narrator": "アーヤ",
            "text": "お酒ですか？",
            "zh": "酒吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "28/TALK",
            "narrator": "真幌",
            "text": "まさか、下戸だなんて\n言わんだろうな？",
            "zh": "不会说自己\n不能喝吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "30/TALK",
            "narrator": "アーヤ",
            "text": "普通に飲めますけど、\nいつ出動がかかるか\nわからないですし…。",
            "zh": "普通能喝，\n可不知道什么时候\n会出动……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "真幌",
            "text": "硬いことを言うな。\n私が良いと言っているん\nだからな。",
            "zh": "别说那么死板的话。\n是我说可以的，\n就行了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "…それが一番問題な\n気もするんだけど。",
            "zh": "……我觉得那才是\n最大的问题。",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "真幌",
            "text": "たまにはいいだろう。\nおまえはうちで唯一、\n酒の飲める年齢なんだ。",
            "zh": "偶尔一次没关系吧。\n你是这里唯一\n到了能喝酒的年纪。",
            "narrator_zh": "真幌"
        },
        {
            "location": "34/TALK",
            "narrator": "真幌",
            "text": "それに、私もたまには\n誰かと飲みたい日が\nあってな。",
            "zh": "而且，我偶尔也有\n想和谁一起喝的\n日子。",
            "narrator_zh": "真幌"
        },
        {
            "location": "35/TALK",
            "narrator": "アーヤ",
            "text": "う～ん…確かにお酒に\n付き合えるのは私しか\nいないけど…。",
            "zh": "唔——嗯……确实能陪着\n喝酒的只有我\n……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "どうしよう",
            "zh": "怎么办",
            "narrator_zh": "绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "アーヤ",
            "text": "館長にお酒に誘われちゃったの",
            "zh": "被馆长邀请去喝酒了",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "アーヤ",
            "text": "何だか誰かと飲みたい気分みたい",
            "zh": "好像是想和谁喝的心情",
            "narrator_zh": "绫水"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "アーヤ",
            "text": "出動がかかるかもしれないから",
            "zh": "也许会出动",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと不安かも…(-ω-;)",
            "zh": "有点不安……(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "55/SEL",
            "narrator": "",
            "text": "付き合ってあげなよ",
            "zh": "就陪他吧",
            "narrator_zh": ""
        },
        {
            "location": "56/SEL",
            "narrator": "",
            "text": "面倒そうだし断ろう",
            "zh": "看起来麻烦，拒绝吧",
            "narrator_zh": ""
        },
        {
            "location": "57/SEL",
            "narrator": "",
            "text": "アーヤは飲まなければいい",
            "zh": "绫水不喝就好",
            "narrator_zh": ""
        },
        {
            "location": "58/ACT",
            "narrator": "",
            "text": "付き合ってあげなよ",
            "zh": "就陪他吧",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "…そうしようかな？",
            "zh": "……就这么办？",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "アーヤ",
            "text": "それじゃあ",
            "zh": "那就",
            "narrator_zh": "绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "飲み過ぎには気をつけて",
            "zh": "注意别喝太多",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "楽しんできます(≧∇≦)b",
            "zh": "我去享受一下(≧∇≦)b",
            "narrator_zh": "绫水"
        },
        {
            "location": "77/TALK",
            "narrator": "アーヤ",
            "text": "わかりました。\nお付き合いします。",
            "zh": "知道了。\n我陪你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "真幌",
            "text": "おお、本当か！",
            "zh": "哦，真的吗！",
            "narrator_zh": "真幌"
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "ただし、私は二杯以上は\n飲みませんよ？",
            "zh": "不过，我不会喝\n两杯以上哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "真幌",
            "text": "構わん、酔い潰すのが\n目的ではないからな。",
            "zh": "没关系，目的不是\n把人灌倒。",
            "narrator_zh": "真幌"
        },
        {
            "location": "81/TALK",
            "narrator": "真幌",
            "text": "店は私に任せろ。\nいい店を\n知っているんだ。",
            "zh": "店交给我。\n我知道一家\n好店。",
            "narrator_zh": "真幌"
        },
        {
            "location": "82/TALK",
            "narrator": "アーヤ",
            "text": "館長も飲み過ぎないで\nくださいね。",
            "zh": "馆长也别喝太多\n哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "真幌",
            "text": "心配するな。\n私はそう簡単に\n酔い潰れはせん！",
            "zh": "不用担心。\n我不会那么容易\n喝倒！",
            "narrator_zh": "真幌"
        },
        {
            "location": "84/TALK",
            "narrator": "真幌",
            "text": "それに、\nせっかくアーヤと\n飲めるんだからな。",
            "zh": "而且，\n难得能和绫水\n喝。",
            "narrator_zh": "真幌"
        },
        {
            "location": "85/TALK",
            "narrator": "真幌",
            "text": "ガキどもは抜きにして、\n大人同士ゆっくりと\n語り合おうじゃないか。",
            "zh": "把那些小孩撇开，\n大人之间慢慢\n聊聊吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "87/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、そうですね。",
            "zh": "呵呵，是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "凄く喜んでるみたい…\nこれからも、たまには\nこういうのも良いかも。",
            "zh": "看起来很高兴……\n以后偶尔这样，\n也许也不错。",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/ACT",
            "narrator": "",
            "text": "面倒そうだし断ろう",
            "zh": "看起来麻烦，拒绝吧",
            "narrator_zh": ""
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "そうね",
            "zh": "说得对",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "館長には申し訳ないけど、それがいいかも",
            "zh": "对馆长不好意思，也许这样比较好",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "せっかくの\nお誘いですが、\n私は遠慮します。",
            "zh": "难得的\n邀请，\n我还是拒绝。",
            "narrator_zh": "绫水"
        },
        {
            "location": "105/TALK",
            "narrator": "真幌",
            "text": "なんだと！？",
            "zh": "什么！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "106/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、\nいつ出動がかかるか\nわかりませんし。",
            "zh": "果然，\n不知道什么时候\n会出动。",
            "narrator_zh": "绫水"
        },
        {
            "location": "107/TALK",
            "narrator": "真幌",
            "text": "別に酔い潰すつもりは\nないんだぞ？",
            "zh": "我又没打算\n把你灌倒？",
            "narrator_zh": "真幌"
        },
        {
            "location": "108/TALK",
            "narrator": "アーヤ",
            "text": "わかってますけど、\n緊急事態に備えるのも\nリーダーの仕事なので。",
            "zh": "我知道，\n为紧急情况做准备\n也是队长的工作。",
            "narrator_zh": "绫水"
        },
        {
            "location": "109/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "112/TALK",
            "narrator": "真幌",
            "text": "つまらんヤツだ…。\nなら、私は一人で\n飲んでくるとしよう。",
            "zh": "真无聊的家伙……。\n那我一个人\n去喝了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "115/TALK",
            "narrator": "アーヤ",
            "text": "…ちょっと、\nかわいそうなこと\nしちゃったかな？",
            "zh": "……是不是，\n做得有点\n可怜了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "116/ACT",
            "narrator": "",
            "text": "アーヤは飲まなければいい",
            "zh": "绫水不喝就好",
            "narrator_zh": ""
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "それがいいかも",
            "zh": "也许这样比较好",
            "narrator_zh": "绫水"
        },
        {
            "location": "118/TALK",
            "narrator": "アーヤ",
            "text": "飲むのは館長に任せて",
            "zh": "喝酒交给馆长",
            "narrator_zh": "绫水"
        },
        {
            "location": "119/TALK",
            "narrator": "アーヤ",
            "text": "私はジュースにするわ",
            "zh": "我喝果汁",
            "narrator_zh": "绫水"
        },
        {
            "location": "131/TALK",
            "narrator": "アーヤ",
            "text": "せっかくの\nお誘いですし、\nお供します。",
            "zh": "难得的\n邀请，\n我陪着去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "132/TALK",
            "narrator": "真幌",
            "text": "おおっ、\n行ってくれるか！",
            "zh": "哦，\n你肯去吗！",
            "narrator_zh": "真幌"
        },
        {
            "location": "133/TALK",
            "narrator": "アーヤ",
            "text": "はい、お店はどこに\nしますか？",
            "zh": "是，店去\n哪里？",
            "narrator_zh": "绫水"
        },
        {
            "location": "134/TALK",
            "narrator": "真幌",
            "text": "店のことは心配するな。\n私のお薦めの店に\n連れて行ってやる。",
            "zh": "店不用担心。\n我带你去\n我推荐的店。",
            "narrator_zh": "真幌"
        },
        {
            "location": "135/TALK",
            "narrator": "真幌",
            "text": "あそこは魚介類が\n美味くてなぁ…。",
            "zh": "那里的海鲜\n很好吃……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "136/TALK",
            "narrator": "アーヤ",
            "text": "それは楽しみです。",
            "zh": "那我很期待。",
            "narrator_zh": "绫水"
        },
        {
            "location": "137/TALK",
            "narrator": "真幌",
            "text": "それに、中々良い酒も\n揃ってるからな。",
            "zh": "而且，酒也\n备得不错。",
            "narrator_zh": "真幌"
        },
        {
            "location": "138/TALK",
            "narrator": "真幌",
            "text": "…最初の一杯くらいは\n付き合ってもらうぞ？",
            "zh": "……第一杯\n你得陪我？",
            "narrator_zh": "真幌"
        },
        {
            "location": "139/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "140/TALK",
            "narrator": "真幌",
            "text": "ジュースや\n茶だけなんて\n許さんからな。",
            "zh": "只喝果汁\n或者茶，\n我可不答应。",
            "narrator_zh": "真幌"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "お見通しでしたか…。",
            "zh": "被看穿了吗……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "145/TALK",
            "narrator": "アーヤ",
            "text": "この人には、まだまだ\n敵わないなぁ…。",
            "zh": "这个人，我还是\n赢不了啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "15/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月7日　6:44 PM</color>\nＧＷ期間、神楽坂トライナリーでのバイトの最中のこと。",
            "zh": "<color=green>5月7日　6:44 PM</color>\n黄金周期间，神乐坂三重奏打工的时候。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
