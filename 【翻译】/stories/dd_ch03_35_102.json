    },
    "entry": [
        {
            "location": "717/SCENARIO",
            "narrator": "",
            "text": "任務を続行せよ",
            "zh": "继续执行任务",
            "narrator_zh": ""
        },
        {
            "location": "737/TALK",
            "narrator": "ガブリエラ",
            "text": "宇宙…？\nなんで……。",
            "zh": "宇宙……？\n为什么……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "740/TALK",
            "narrator": "ガブリエラ",
            "text": "知らないあたしの\n記憶が……！？",
            "zh": "我不认识的自己的\n记忆……！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "741/TALK",
            "narrator": "ガブリエラ",
            "text": "これがフェノメノンの\n中のあたし…！？",
            "zh": "这就是PhenoMENON\n里面的我……！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "742/TALK",
            "narrator": "ガブリエラ",
            "text": "……このままじゃまずい。",
            "zh": "……这样下去不妙。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "743/TALK",
            "narrator": "ガブリエラ",
            "text": "一刻も早く\n逢瀬つばめのセカイを\n蒸着させないと…！",
            "zh": "必须一刻也不耽搁地\n让逢濑燕的世界\n完成蒸着才行……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "744/SEL",
            "narrator": "",
            "text": "大丈夫？",
            "zh": "不要紧吗？",
            "narrator_zh": ""
        },
        {
            "location": "745/SEL",
            "narrator": "",
            "text": "どうなってるの？",
            "zh": "怎么回事？",
            "narrator_zh": ""
        },
        {
            "location": "746/SEL",
            "narrator": "",
            "text": "落ち着こう",
            "zh": "冷静点",
            "narrator_zh": ""
        },
        {
            "location": "747/ACT",
            "narrator": "",
            "text": "大丈夫？",
            "zh": "不要紧吗？",
            "narrator_zh": ""
        },
        {
            "location": "748/TALK",
            "narrator": "ガブリエラ",
            "text": "あまりよくはないわ。",
            "zh": "情况不太乐观。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "749/ACT",
            "narrator": "",
            "text": "どうなってるの？",
            "zh": "怎么回事？",
            "narrator_zh": ""
        },
        {
            "location": "750/TALK",
            "narrator": "ガブリエラ",
            "text": "わからないけど。",
            "zh": "我也不清楚。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "751/ACT",
            "narrator": "",
            "text": "落ち着こう",
            "zh": "冷静点",
            "narrator_zh": ""
        },
        {
            "location": "752/TALK",
            "narrator": "ガブリエラ",
            "text": "落ち着いてるわ。",
            "zh": "我很冷静。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "754/TALK",
            "narrator": "ガブリエラ",
            "text": "それよりあなた\n早く協力して。",
            "zh": "比起那个，你\n快点来帮忙。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "755/TALK",
            "narrator": "ガブリエラ",
            "text": "今かなりまずい事態に\nなってるの。",
            "zh": "现在情况\n相当不妙。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "756/SEL",
            "narrator": "",
            "text": "そんなこと言われても",
            "zh": "就算你这么说",
            "narrator_zh": ""
        },
        {
            "location": "757/SEL",
            "narrator": "",
            "text": "こっちも大変なんだ",
            "zh": "我这边也很麻烦啊",
            "narrator_zh": ""
        },
        {
            "location": "758/SEL",
            "narrator": "",
            "text": "どうすればいいのかな？",
            "zh": "该怎么做才好呢？",
            "narrator_zh": ""
        },
        {
            "location": "759/ACT",
            "narrator": "",
            "text": "そんなこと言われても",
            "zh": "就算你这么说",
            "narrator_zh": ""
        },
        {
            "location": "760/TALK",
            "narrator": "ガブリエラ",
            "text": "計画通りに進めないと\n大変なことになるわ。",
            "zh": "不按计划推进的话\n会出大事的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "761/ACT",
            "narrator": "",
            "text": "こっちも大変なんだ",
            "zh": "我这边也很麻烦啊",
            "narrator_zh": ""
        },
        {
            "location": "762/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなの後回しで\nいいわよ。",
            "zh": "那种事往后放\n就行了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "763/ACT",
            "narrator": "",
            "text": "どうすればいいのかな？",
            "zh": "该怎么做才好呢？",
            "narrator_zh": ""
        },
        {
            "location": "764/TALK",
            "narrator": "ガブリエラ",
            "text": "依頼主から\n聞いてないの？",
            "zh": "你没从委托人那里\n听说吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "779/TALK",
            "narrator": "ガブリエラ",
            "text": "何これ！？",
            "zh": "这是什么！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "781/TALK",
            "narrator": "ガブリエラ",
            "text": "どうなってるの？\n説明して！",
            "zh": "怎么回事？\n快解释清楚！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "782/SEL",
            "narrator": "",
            "text": "$me$じゃない",
            "zh": "不是$me$干的",
            "narrator_zh": ""
        },
        {
            "location": "783/SEL",
            "narrator": "",
            "text": "$me$にもわからない",
            "zh": "$me$也不知道",
            "narrator_zh": ""
        },
        {
            "location": "784/SEL",
            "narrator": "",
            "text": "心当たりはないの？",
            "zh": "你没有头绪吗？",
            "narrator_zh": ""
        },
        {
            "location": "785/ACT",
            "narrator": "",
            "text": "$me$じゃない",
            "zh": "不是$me$干的",
            "narrator_zh": ""
        },
        {
            "location": "786/TALK",
            "narrator": "ガブリエラ",
            "text": "それでもわかることとか\nあるんじゃないの？",
            "zh": "就算这样，总该有些\n能搞明白的事吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "787/ACT",
            "narrator": "",
            "text": "$me$にもわからない",
            "zh": "$me$也不知道",
            "narrator_zh": ""
        },
        {
            "location": "788/TALK",
            "narrator": "ガブリエラ",
            "text": "これは完全に\n任務遂行妨害よ！",
            "zh": "这完全就是\n妨碍执行任务！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "789/ACT",
            "narrator": "",
            "text": "心当たりはないの？",
            "zh": "你没有头绪吗？",
            "narrator_zh": ""
        },
        {
            "location": "790/TALK",
            "narrator": "ガブリエラ",
            "text": "あったら聞かないわ！",
            "zh": "要有的话我就不问了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "792/TALK",
            "narrator": "ガブリエラ",
            "text": "せめて回転を止めて！",
            "zh": "至少把旋转停下来！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "820/TALK",
            "narrator": "ガブリエラ",
            "text": "……え？",
            "zh": "……哎？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "821/TALK",
            "narrator": "ガブリエラ",
            "text": "ここって……。",
            "zh": "这里是……。",
            "narrator_zh": "加布里埃拉"
        },
