{
    "dir": "chap10/daydra/dd_ch04_10_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "10405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "遊んでるわけやない＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "可不是在玩＜后篇＞"
    },
    "entry": [
        {
            "location": "534/SCENARIO",
            "narrator": "",
            "text": "遊んでるわけやない",
            "zh": "可不是在玩",
            "narrator_zh": ""
        },
        {
            "location": "550/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "552/TALK",
            "narrator": "みやび",
            "text": "しかし、まっこと\nふざけたサイトや。",
            "zh": "不过，真是个\n蛮胡闹的网站咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "553/TALK",
            "narrator": "みやび",
            "text": "けんど、適当に妄想\n吐き出しちょる\nようにも見えんし…。",
            "zh": "但是，也不像\n是随口乱吐\n妄想的样子……。",
            "narrator_zh": "雅"
        },
        {
            "location": "554/TALK",
            "narrator": "みやび",
            "text": "ふむ…。",
            "zh": "唔……",
            "narrator_zh": "雅"
        },
        {
            "location": "555/SEL",
            "narrator": "",
            "text": "興味あるなら調べてみれば？",
            "zh": "有兴趣的话就去查查？",
            "narrator_zh": ""
        },
        {
            "location": "556/ACT",
            "narrator": "",
            "text": "興味あるなら調べてみれば？",
            "zh": "有兴趣的话就去查查？",
            "narrator_zh": ""
        },
        {
            "location": "565/TALK",
            "narrator": "みやび",
            "text": "実家のマシンがあればな",
            "zh": "要是有老家的机器就好了",
            "narrator_zh": "雅"
        },
        {
            "location": "566/TALK",
            "narrator": "みやび",
            "text": "今はムリや",
            "zh": "现在没戏咯",
            "narrator_zh": "雅"
        },
        {
            "location": "567/SEL",
            "narrator": "",
            "text": "ルートみたいなのが書いてある",
            "zh": "上面写着像是路径的东西",
            "narrator_zh": ""
        },
        {
            "location": "568/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "569/TALK",
            "narrator": "みやび",
            "text": "時間は掛かるけんど",
            "zh": "是要花时间，不过",
            "narrator_zh": "雅"
        },
        {
            "location": "570/TALK",
            "narrator": "みやび",
            "text": "部屋のマシンでやってみよう",
            "zh": "就用房间里的机器试试吧",
            "narrator_zh": "雅"
        },
        {
            "location": "572/TALK",
            "narrator": "みやび",
            "text": "何にせよ",
            "zh": "不管怎样",
            "narrator_zh": "雅"
        },
        {
            "location": "573/TALK",
            "narrator": "みやび",
            "text": "ここでは無理や",
            "zh": "在这里是搞不了咯",
            "narrator_zh": "雅"
        },
        {
            "location": "574/TALK",
            "narrator": "みやび",
            "text": "続きは帰ってからな",
            "zh": "剩下的回去再说咯",
            "narrator_zh": "雅"
        },
        {
            "location": "577/ACT",
            "narrator": "",
            "text": "ルートみたいなのが書いてある",
            "zh": "上面写着像是路径的东西",
            "narrator_zh": ""
        },
        {
            "location": "579/TALK",
            "narrator": "みやび",
            "text": "マジか！？",
            "zh": "真的假的！？",
            "narrator_zh": "雅"
        },
        {
            "location": "581/TALK",
            "narrator": "みやび",
            "text": "前言撤回、可能や",
            "zh": "收回前言，能搞咯",
            "narrator_zh": "雅"
        },
        {
            "location": "582/TALK",
            "narrator": "みやび",
            "text": "ルートの最後に書かれちょるアドレス",
            "zh": "路径最后写着的那个地址",
            "narrator_zh": "雅"
        },
        {
            "location": "583/TALK",
            "narrator": "みやび",
            "text": "ポチッと貼りつけ頼む",
            "zh": "麻烦点击粘贴一下咯",
            "narrator_zh": "雅"
        },
        {
            "location": "585/SEL",
            "narrator": "",
            "text": "22145E34.rootnode.JPGO.554",
            "zh": "22145E34.rootnode.JPGO.554",
            "narrator_zh": ""
        },
        {
            "location": "588/TALK",
            "narrator": "みやび",
            "text": "よし",
            "zh": "好",
            "narrator_zh": "雅"
        },
        {
            "location": "590/TALK",
            "narrator": "みやび",
            "text": "ＰＣで調べる",
            "zh": "用ＰＣ查",
            "narrator_zh": "雅"
        },
        {
            "location": "591/TALK",
            "narrator": "みやび",
            "text": "ちくっと待ちぃ",
            "zh": "等子哟",
            "narrator_zh": "雅"
        },
        {
            "location": "595/TALK",
            "narrator": "みやび",
            "text": "ＩＰは",
            "zh": "ＩＰ是",
            "narrator_zh": "雅"
        },
        {
            "location": "596/TALK",
            "narrator": "みやび",
            "text": "『6E.5F.34.22.7C.46』",
            "zh": "『6E.5F.34.22.7C.46』",
            "narrator_zh": "雅"
        },
        {
            "location": "597/TALK",
            "narrator": "みやび",
            "text": "情報非公開は当然やけんど",
            "zh": "信息不公开是当然的，不过",
            "narrator_zh": "雅"
        },
        {
            "location": "598/TALK",
            "narrator": "みやび",
            "text": "このノード",
            "zh": "这个节点",
            "narrator_zh": "雅"
        },
        {
            "location": "599/TALK",
            "narrator": "みやび",
            "text": "『pppvpn-05sakura.biggate.41.3E.5』",
            "zh": "『pppvpn-05sakura.biggate.41.3E.5』",
            "narrator_zh": "雅"
        },
        {
            "location": "600/TALK",
            "narrator": "みやび",
            "text": "これに見覚えがあるんよ",
            "zh": "这个我看着眼熟哦",
            "narrator_zh": "雅"
        },
        {
            "location": "602/TALK",
            "narrator": "みやび",
            "text": "確認してくる",
            "zh": "我去确认一下",
            "narrator_zh": "雅"
        },
        {
            "location": "606/TALK",
            "narrator": "みやび",
            "text": "まさかとは思うが…。",
            "zh": "虽然觉得不至于……。",
            "narrator_zh": "雅"
        },
        {
            "location": "612/TALK",
            "narrator": "みやび",
            "text": "ビンゴ！\nやはりそうやったか！",
            "zh": "宾果！\n果然是这样啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "613/TALK",
            "narrator": "みやび",
            "text": "これ、間違いなく\n情報管理庁の中や。\nっちゅうことは――",
            "zh": "这个，错不了，\n是情报管理厅的内部咯。\n也就是说——",
            "narrator_zh": "雅"
        },
        {
            "location": "614/TALK",
            "narrator": "みやび",
            "text": "この間、\nラビットアニマが\n陥落した――",
            "zh": "前阵子，\n兔之阿尼玛\n沦陷了——",
            "narrator_zh": "雅"
        },
        {
            "location": "615/TALK",
            "narrator": "みやび",
            "text": "あの先に繋がっちょる\n可能性もあるな。",
            "zh": "也有可能连着\n那更深处啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "621/TALK",
            "narrator": "みやび",
            "text": "…予想的中や！\nそうか、そういうこと\nやったか！",
            "zh": "……猜中了！\n原来如此，是这么\n回事啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "622/TALK",
            "narrator": "みやび",
            "text": "さっきのファンサイト\nだけやない。",
            "zh": "不光是刚才那个\n粉丝网站。",
            "narrator_zh": "雅"
        },
        {
            "location": "623/TALK",
            "narrator": "みやび",
            "text": "他のファンサイトの\nアドレスまで、\n大量に出てきよった！",
            "zh": "连其他粉丝网站的\n地址都\n大量冒出来了！",
            "narrator_zh": "雅"
        },
        {
            "location": "624/TALK",
            "narrator": "みやび",
            "text": "あはははは！\nマジか、今年ナンバー\nワンの爆笑大賞や！",
            "zh": "啊哈哈哈哈！\n真的假的，今年头号\n爆笑大奖就是它咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "628/TALK",
            "narrator": "みやび",
            "text": "素晴らしい",
            "zh": "太棒了",
            "narrator_zh": "雅"
        },
        {
            "location": "629/TALK",
            "narrator": "みやび",
            "text": "相棒のおかげで",
            "zh": "多亏了搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "630/TALK",
            "narrator": "みやび",
            "text": "面白い世界を開拓できた",
            "zh": "开拓了有趣的世界",
            "narrator_zh": "雅"
        },
        {
            "location": "631/TALK",
            "narrator": "みやび",
            "text": "礼を言うぞ",
            "zh": "这就道谢咧",
            "narrator_zh": "雅"
        },
        {
            "location": "632/TALK",
            "narrator": "みやび",
            "text": "サンキュー、グラッチェ、グラシアス！",
            "zh": "Thank you、Grazie、Gracias！",
            "narrator_zh": "雅"
        },
        {
            "location": "634/TALK",
            "narrator": "みやび",
            "text": "うちはしばらく",
            "zh": "我要暂时",
            "narrator_zh": "雅"
        },
        {
            "location": "635/TALK",
            "narrator": "みやび",
            "text": "自分の世界にひたるき",
            "zh": "沉到自己的世界里去啵",
            "narrator_zh": "雅"
        },
        {
            "location": "636/TALK",
            "narrator": "みやび",
            "text": "またな",
            "zh": "下次见咯",
            "narrator_zh": "雅"
        },
        {
            "location": "650/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【08 HANABI】",
            "zh": "【08 HANABI】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
}
