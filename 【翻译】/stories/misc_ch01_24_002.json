        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "$handle1$がぃるから元気だょ",
            "zh": "因为有$handle1$在，我很有精神呀",
            "narrator_zh": "燕"
        },
        {
            "location": "138/TALK",
            "narrator": "つばめ",
            "text": "こぅぃぅ時は",
            "zh": "这种时候",
            "narrator_zh": "燕"
        },
        {
            "location": "139/TALK",
            "narrator": "つばめ",
            "text": "魔法が使えればぃぃなって思っちゃぅ",
            "zh": "就会想要是能用魔法就好了",
            "narrator_zh": "燕"
        },
        {
            "location": "141/SEL",
            "narrator": "",
            "text": "あるよね",
            "zh": "是有这种时候呀",
            "narrator_zh": ""
        },
        {
            "location": "142/SEL",
            "narrator": "",
            "text": "残念だけど無理だよ",
            "zh": "很遗憾，做不到的哦",
            "narrator_zh": ""
        },
        {
            "location": "143/SEL",
            "narrator": "",
            "text": "$me$は魔法にかかりっぱなしだよ",
            "zh": "$me$一直中着魔法哦",
            "narrator_zh": ""
        },
        {
            "location": "144/ACT",
            "narrator": "",
            "text": "あるよね",
            "zh": "是有这种时候呀",
            "narrator_zh": ""
        },
        {
            "location": "145/TALK",
            "narrator": "つばめ",
            "text": "だょね",
            "zh": "对呀",
            "narrator_zh": "燕"
        },
        {
            "location": "146/TALK",
            "narrator": "つばめ",
            "text": "みんなそんな気持ちになることあるょね",
            "zh": "大家都会有这种心情呀",
            "narrator_zh": "燕"
        },
        {
            "location": "147/ACT",
            "narrator": "",
            "text": "残念だけど無理だよ",
            "zh": "很遗憾，做不到的哦",
            "narrator_zh": ""
        },
        {
            "location": "149/TALK",
            "narrator": "つばめ",
            "text": "知ってるけど",
            "zh": "我知道",
            "narrator_zh": "燕"
        },
        {
            "location": "151/TALK",
            "narrator": "つばめ",
            "text": "そんな気持ちなの",
            "zh": "可就是这种心情",
            "narrator_zh": "燕"
        },
        {
            "location": "152/ACT",
            "narrator": "",
            "text": "$me$は魔法にかかりっぱなしだよ",
            "zh": "$me$一直中着魔法哦",
