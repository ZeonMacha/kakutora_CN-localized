{
    "dir": "chap16/daydra/dd_ch01_16_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "16102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "誰でもない私だから＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "正因为我谁也不是＜前篇＞"
    },
    "entry": [
        {
            "location": "46/TALK",
            "narrator": "ガブリエラ",
            "text": "アプリゲームね…。",
            "zh": "手游啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "課金すれば\n強くなれたり\nしないのかしら。",
            "zh": "充了钱\n会不会\n变强。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "そうしたら\n今回は楽勝なのにね。",
            "zh": "那样的话\n这次就轻松取胜了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "あら、どうして？",
            "zh": "咦，为什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "だってこれは管理庁の\n任務なのよ。",
            "zh": "因为这是管理厅的\n任务呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "必要予算ってことで\n一億くらい課金して\nもらえばいいのよ。",
            "zh": "就当必要预算，\n让他们充个一亿\n左右就好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "一気に最強モードで\n瞬殺よ、瞬殺。",
            "zh": "直接最强模式\n秒掉，秒掉。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "つばめ",
            "text": "一億も使ったら\n真幌さんに怒られるん\nじゃないかな？",
            "zh": "花掉一亿的话，\n真幌会生气的\n吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "卯月さんも、\nそう思わない？",
            "zh": "卯月也\n这么觉得吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "60/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "卯月さん？",
            "zh": "卯月？",
            "narrator_zh": "燕"
        },
        {
            "location": "65/TALK",
            "narrator": "神楽",
            "text": "えっ！？　あ、はい。\nどうかしましたか？",
            "zh": "诶！？　啊，在。\n怎么了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "66/TALK",
            "narrator": "つばめ",
            "text": "あ、ううん…。\n大したことじゃないん\nだけど…。",
            "zh": "啊，没什么……。\n不是什么大事\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "67/TALK",
            "narrator": "つばめ",
            "text": "…大丈夫？\nちょっと元気がない\nみたいだけど…。",
            "zh": "……没事吗？\n看起来有点\n没精神……。",
            "narrator_zh": "燕"
        },
        {
            "location": "69/TALK",
            "narrator": "神楽",
            "text": "そ、そんなこと\nないですよ。",
            "zh": "没、没有\n那种事。",
            "narrator_zh": "神乐"
        },
        {
            "location": "70/TALK",
            "narrator": "神楽",
            "text": "ほら、いつも通り\n私は元気ですから…。",
            "zh": "你看，跟平时一样，\n我精神得很……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "71/TALK",
            "narrator": "つばめ",
            "text": "無理してない？\n何だか、全然元気に\n見えないんだけど…。",
            "zh": "没有在硬撑吧？\n总觉得，看起来\n一点都不精神……。",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "神楽",
            "text": "大丈夫です。\nつばめさんの\n思い過ごしですよ…。",
            "zh": "没关系。\n是燕\n想多了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "74/TALK",
            "narrator": "つばめ",
            "text": "…そう？\nそれならいいん\nだけど…。",
            "zh": "……是吗？\n那就好\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "76/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "…やっぱり、\nちょっと元気\nなさそう。",
            "zh": "……果然还是，\n有点\n没精神。",
            "narrator_zh": "燕"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "何かあったのかな？",
            "zh": "是发生什么了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "80/TALK",
            "narrator": "透明みやび",
            "text": "つばめちゃん、\n聞こえちゅう？",
            "zh": "燕，\n听得见不？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "82/TALK",
            "narrator": "つばめ",
            "text": "あ、はい。\n聞こえて――",
            "zh": "啊，是。\n听得见——",
            "narrator_zh": "燕"
        },
        {
            "location": "83/TALK",
            "narrator": "透明みやび",
            "text": "しっ！",
            "zh": "嘘！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "84/TALK",
            "narrator": "透明みやび",
            "text": "プライベート通信で\n話しかけてるき、\n返事はいらんがよ。",
            "zh": "我在用私人频道\n说话啵，\n不用回咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "85/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "透明みやび",
            "text": "今から話すことは、\n隊員の個人情報に\n関する話やき。",
            "zh": "接下来要说的，\n是队员的\n个人情况啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "87/TALK",
            "narrator": "透明みやび",
            "text": "今はまだ、みんなには\n秘密にしておきたい\nことなんよ。",
            "zh": "这阵还想\n先瞒着\n大家。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "…なんで、そんな話を\nわたしにするんだろ？",
            "zh": "……为什么，这种事\n要告诉我呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "89/TALK",
            "narrator": "透明みやび",
            "text": "えいか？",
            "zh": "要得吗？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "90/TALK",
            "narrator": "透明みやび",
            "text": "実は今回の\nフェノメノン。",
            "zh": "其实是这次的\nPhenoMENON。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "91/TALK",
            "narrator": "透明みやび",
            "text": "内部に、卯月の実家を\n巻き込んどるんよ。",
            "zh": "里头把卯月的娘家\n卷进去了。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "93/TALK",
            "narrator": "つばめ",
            "text": "っ！？",
            "zh": "……！？",
            "narrator_zh": "燕"
        },
        {
            "location": "96/TALK",
            "narrator": "透明みやび",
            "text": "ビックリさせて\nすまんね。",
            "zh": "吓到你了，\n对不住。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "97/TALK",
            "narrator": "透明みやび",
            "text": "個人情報に関わるき、\n誰にも言わん方がえい\nとも思うたんよ。",
            "zh": "牵扯到个人情况啵，\n我也觉得谁都别说\n要好些。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "98/TALK",
            "narrator": "透明みやび",
            "text": "けんど、それはそれで\n不安やったきね。",
            "zh": "不过，那样又\n放心不下啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "99/TALK",
            "narrator": "透明みやび",
            "text": "卯月と一番仲のいい、\nつばめちゃんにだけ\n話そうと思うたがよ。",
            "zh": "跟卯月最要好的\n燕，我想只\n告诉你咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "100/TALK",
            "narrator": "つばめ",
            "text": "そうだったんだ…。\nありがとう、\nみやびさん。",
            "zh": "原来是这样……。\n谢谢，\n雅。",
            "narrator_zh": "燕"
        },
        {
            "location": "101/TALK",
            "narrator": "つばめ",
            "text": "…帰ったら、\nちゃんとお礼\n言わないと。",
            "zh": "……回去之后，\n得好好\n道谢。",
            "narrator_zh": "燕"
        },
        {
            "location": "102/TALK",
            "narrator": "透明みやび",
            "text": "大丈夫だとは\n思うけんど、\n念には念や。",
            "zh": "应该\n没事，\n不过多留个心眼咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "103/TALK",
            "narrator": "透明みやび",
            "text": "卯月が無茶せんよう、\n監視頼むぞね。",
            "zh": "别让卯月乱来，\n看着她，拜托了啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "108/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "109/TALK",
            "narrator": "つばめ",
            "text": "そっか…だから\n卯月さん、いつもと\n様子が違うんだ…。",
            "zh": "这样啊……所以\n卯月才跟平时\n不一样……。",
            "narrator_zh": "燕"
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "実家がフェノメノンに\n巻き込まれてるん\nだもん。",
            "zh": "娘家被卷进\nPhenoMENON里\n了呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "111/TALK",
            "narrator": "つばめ",
            "text": "心配で、\nとっても辛いよね…。",
            "zh": "会担心，\n也很难受吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "113/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "115/TALK",
            "narrator": "つばめ",
            "text": "…知ってること、\n卯月さんにだけは\n話そうかな？",
            "zh": "……我知道的事，\n要不要只告诉\n卯月？",
            "narrator_zh": "燕"
        },
        {
            "location": "116/TALK",
            "narrator": "つばめ",
            "text": "卯月さんが元気ない\n理由、知ってるって。",
            "zh": "就说我知道\n卯月没精神的原因。",
            "narrator_zh": "燕"
        },
        {
            "location": "117/TALK",
            "narrator": "つばめ",
            "text": "一人で抱えないで。\n一緒に頑張ろう、\nって…。",
            "zh": "别一个人扛着。\n我们一起加油，\n这样……。",
            "narrator_zh": "燕"
        },
        {
            "location": "165/TALK",
            "narrator": "つばめ",
            "text": "　",
            "zh": "……",
            "narrator_zh": "燕"
        },
        {
            "location": "181/TALK",
            "narrator": "つばめ",
            "text": "こんにちは、\n$handle$さん。",
            "zh": "你好，\n$handle$。",
            "narrator_zh": "燕"
        },
        {
            "location": "182/SEL",
            "narrator": "",
            "text": "新しい人？",
            "zh": "新来的人？",
            "narrator_zh": ""
        },
        {
            "location": "183/ACT",
            "narrator": "",
            "text": "新しい人？",
            "zh": "新来的人？",
            "narrator_zh": ""
        },
        {
            "location": "185/TALK",
            "narrator": "つばめ",
            "text": "はい。\n先日より司書に任命された\n人格です。",
            "zh": "是的。\n是日前被任命为司书的\n人格。",
            "narrator_zh": "燕"
        },
        {
            "location": "186/TALK",
            "narrator": "つばめ",
            "text": "以後よろしくお願いします。",
            "zh": "以后请多关照。",
            "narrator_zh": "燕"
        },
        {
            "location": "187/SEL",
            "narrator": "",
            "text": "何て呼べばいい？",
            "zh": "该怎么称呼你？",
            "narrator_zh": ""
        },
        {
            "location": "188/SEL",
            "narrator": "",
            "text": "名前教えて",
            "zh": "告诉我名字",
            "narrator_zh": ""
        },
        {
            "location": "189/ACT",
            "narrator": "",
            "text": "何て呼べばいい？",
            "zh": "该怎么称呼你？",
            "narrator_zh": ""
        },
        {
            "location": "190/TALK",
            "narrator": "つばめ",
            "text": "普通に、\n逢瀬つばめの司書さん、で\nよくないですか？",
            "zh": "普通叫\n逢濑燕的司书，\n不就好了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "191/ACT",
            "narrator": "",
            "text": "名前教えて",
            "zh": "告诉我名字",
            "narrator_zh": ""
        },
        {
            "location": "192/TALK",
            "narrator": "つばめ",
            "text": "いきなりナンパですか？\n真剣さが足りませんね。",
            "zh": "一上来就搭讪吗？\n认真程度不够呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "194/TALK",
            "narrator": "つばめ",
            "text": "ちなみに\n先に釘を打っておきますが\n名前は教えられません。",
            "zh": "顺便\n先说在前面，\n名字不能告诉你。",
            "narrator_zh": "燕"
        },
        {
            "location": "195/SEL",
            "narrator": "",
            "text": "なんで？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "196/ACT",
            "narrator": "",
            "text": "なんで？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "198/TALK",
            "narrator": "つばめ",
            "text": "ああ、\n$handle$さんは\n知らないのですか。",
            "zh": "啊，\n$handle$\n不知道吗。",
            "narrator_zh": "燕"
        },
        {
            "location": "199/TALK",
            "narrator": "つばめ",
            "text": "人格が名前を教えることは\n全てをその相手に\n捧げる事と同義なんです。",
            "zh": "人格把名字告诉对方，\n就等于把一切\n献给对方。",
            "narrator_zh": "燕"
        },
        {
            "location": "200/TALK",
            "narrator": "つばめ",
            "text": "人格は人格同士ですら\nその名前を知りません。\nそして敢えて聞きません。",
            "zh": "人格之间，\n连彼此的名字都不知道。\n而且故意不去问。",
            "narrator_zh": "燕"
        },
        {
            "location": "201/TALK",
            "narrator": "つばめ",
            "text": "なぜなら――",
            "zh": "因为——",
            "narrator_zh": "燕"
        },
        {
            "location": "202/TALK",
            "narrator": "つばめ",
            "text": "いえ、こんな話は\nする必要ありませんね。",
            "zh": "不，这种事\n没必要说。",
            "narrator_zh": "燕"
        },
        {
            "location": "203/TALK",
            "narrator": "つばめ",
            "text": "早速仕事をしましょう。\nお互い。",
            "zh": "马上开工吧。\n你我都一样。",
            "narrator_zh": "燕"
        },
        {
            "location": "211/TALK",
            "narrator": "つばめ",
            "text": "オープンプロセス、\n0x230番地から\n0xC51番地へ。",
            "zh": "开放进程，\n从0x230地址\n到0xC51地址。",
            "narrator_zh": "燕"
        },
        {
            "location": "233/TALK",
            "narrator": "つばめ",
            "text": "シーク完了しました。",
            "zh": "搜索完成。",
            "narrator_zh": "燕"
        },
        {
            "location": "236/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "238/TALK",
            "narrator": "つばめ",
            "text": "……なるほど。",
            "zh": "……原来如此。",
            "narrator_zh": "燕"
        },
        {
            "location": "239/TALK",
            "narrator": "つばめ",
            "text": "卯月神楽の家が\n巻き込まれている件。",
            "zh": "卯月神乐的家\n被卷进去的事。",
            "narrator_zh": "燕"
        },
        {
            "location": "240/TALK",
            "narrator": "つばめ",
            "text": "絶対神楽本人には\n言ってはいけません。",
            "zh": "绝对不能\n告诉神乐本人。",
            "narrator_zh": "燕"
        },
        {
            "location": "241/TALK",
            "narrator": "つばめ",
            "text": "それを阻害する\nクランを破壊します。\nよいですか？",
            "zh": "会把妨碍这件事的\n库兰破坏掉。\n可以吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "242/SEL",
            "narrator": "",
            "text": "オッケー",
            "zh": "好",
            "narrator_zh": ""
        },
        {
            "location": "243/SEL",
            "narrator": "",
            "text": "えっと",
            "zh": "那个",
            "narrator_zh": ""
        },
        {
            "location": "244/ACT",
            "narrator": "",
            "text": "オッケー",
            "zh": "好",
            "narrator_zh": ""
        },
        {
            "location": "245/TALK",
            "narrator": "つばめ",
            "text": "ありがとうございます。\nそれではいきましょう。",
            "zh": "谢谢。\n那就出发吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "246/ACT",
            "narrator": "",
            "text": "えっと",
            "zh": "那个",
            "narrator_zh": ""
        },
        {
            "location": "248/TALK",
            "narrator": "つばめ",
            "text": "…？\nなんですか？",
            "zh": "……？\n怎么了？",
            "narrator_zh": "燕"
        },
