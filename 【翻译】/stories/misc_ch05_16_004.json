            "narrator_zh": ""
        },
        {
            "location": "5011/TALK",
            "narrator": "神楽",
            "text": "シャーロックホームズが着てるマントみたいなののついたコートの名前知ってる？",
            "zh": "夏洛克·福尔摩斯穿的那种带披风的外套，你知道名字吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "5013/SEL",
            "narrator": "",
            "text": "マントじゃないの？",
            "zh": "不是披风吗？",
            "narrator_zh": ""
        },
        {
            "location": "5014/SEL",
            "narrator": "",
            "text": "インバネスコートでしょ",
            "zh": "是因弗内斯外套吧",
            "narrator_zh": ""
        },
        {
            "location": "5015/SEL",
            "narrator": "",
            "text": "いや知らんし",
            "zh": "不，我不知道",
            "narrator_zh": ""
        },
        {
            "location": "5016/ACT",
            "narrator": "",
            "text": "マントじゃないの？",
            "zh": "不是披风吗？",
            "narrator_zh": ""
        },
        {
            "location": "5018/TALK",
            "narrator": "神楽",
            "text": "知らざあ言って聞かせやしょう",
            "zh": "不知道的话我就讲给你听",
            "narrator_zh": "神乐"
        },
        {
            "location": "5019/TALK",
            "narrator": "神楽",
            "text": "インバネスコートって言うんだぴょん",
            "zh": "叫做因弗内斯外套pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "5020/TALK",
            "narrator": "神楽",
            "text": "ひとつお利口になったね$handlek$",
            "zh": "$handlek$变聪明了一点呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "5021/ACT",
            "narrator": "",
            "text": "インバネスコートでしょ",
            "zh": "是因弗内斯外套吧",
            "narrator_zh": ""
        },
        {
            "location": "5022/TALK",
            "narrator": "神楽",
            "text": "あ",
            "zh": "啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "5023/TALK",
            "narrator": "神楽",
            "text": "知ってたの",
            "zh": "你知道啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "5025/TALK",
            "narrator": "神楽",
            "text": "つまらん",
            "zh": "真没劲",
            "narrator_zh": "神乐"
        },
        {
            "location": "5026/ACT",
            "narrator": "",
            "text": "いや知らんし",
            "zh": "不，我不知道",
            "narrator_zh": ""
        },
        {
            "location": "5027/TALK",
            "narrator": "神楽",
            "text": "冷たいなー",
            "zh": "好冷淡啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "5029/TALK",
            "narrator": "神楽",
            "text": "いやあれね？",
            "zh": "不，那个呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "5030/TALK",
            "narrator": "神楽",
            "text": "日本だと着物の時着るからさ？",
            "zh": "在日本是穿和服时穿的，所以？",
            "narrator_zh": "神乐"
        },
        {
            "location": "5031/TALK",
            "narrator": "神楽",
            "text": "みやびさんに聞いてみたわけ",
            "zh": "我就去问了雅",
            "narrator_zh": "神乐"
        },
        {
            "location": "5032/TALK",
            "narrator": "神楽",
            "text": "そしたら男性用しかないんだってさー",
            "zh": "结果说只有男用的",
            "narrator_zh": "神乐"
        },
        {
            "location": "5033/TALK",
            "narrator": "神楽",
            "text": "つまらんよー",
            "zh": "真没劲哦",
            "narrator_zh": "神乐"
        },
        {
            "location": "5035/SEL",
            "narrator": "",
            "text": "単に持っていないだけでは",
            "zh": "只是单纯没有而已吧",
            "narrator_zh": ""
        },
        {
            "location": "5036/SEL",
            "narrator": "",
            "text": "神楽着付けとかできたっけ？",
            "zh": "神乐会穿和服吗？",
            "narrator_zh": ""
        },
        {
            "location": "5037/SEL",
            "narrator": "",
            "text": "じゃあ$me$が作ってあげる",
            "zh": "那$me$来做给你",
            "narrator_zh": ""
        },
        {
            "location": "5038/ACT",
            "narrator": "",
            "text": "単に持っていないだけでは",
            "zh": "只是单纯没有而已吧",
            "narrator_zh": ""
        },
        {
            "location": "5039/TALK",
            "narrator": "神楽",
            "text": "そう思って探したぴょん",
            "zh": "我也这么想，去找了pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "5040/TALK",
            "narrator": "神楽",
            "text": "本当にそうだったぴょん",
            "zh": "真的是那样pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "5042/TALK",
            "narrator": "神楽",
            "text": "子供用とかだったらあるんだけどね",
            "zh": "儿童用的话倒是有",
            "narrator_zh": "神乐"
        },
        {
            "location": "5043/TALK",
            "narrator": "神楽",
            "text": "あとガチミリタリー正装とか",
            "zh": "还有正经军装正装之类的",
            "narrator_zh": "神乐"
        },
        {
            "location": "5044/TALK",
            "narrator": "神楽",
            "text": "そういうのは勘弁して",
            "zh": "那种就饶了我",
            "narrator_zh": "神乐"
        },
        {
            "location": "5045/TALK",
            "narrator": "神楽",
            "text": "がっかりぴょん、、、",
            "zh": "好失望pyon……",
            "narrator_zh": "神乐"
        },
        {
            "location": "5046/ACT",
            "narrator": "",
            "text": "神楽着付けとかできたっけ？",
            "zh": "神乐会穿和服吗？",
            "narrator_zh": ""
        },
        {
            "location": "5047/TALK",
            "narrator": "神楽",
            "text": "それは秘密",
            "zh": "那是秘密",
            "narrator_zh": "神乐"
        },
        {
            "location": "5048/TALK",
            "narrator": "神楽",
            "text": "人に着付けてもらってはおるって手もあるし",
            "zh": "也有让别人帮我穿上的办法",
            "narrator_zh": "神乐"
        },
        {
            "location": "5049/TALK",
            "narrator": "神楽",
            "text": "でも肝心のブツがないからお手上げぴょん",
            "zh": "可关键的东西没有，只好举手投降pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "5050/ACT",
            "narrator": "",
            "text": "じゃあ$me$が作ってあげる",
            "zh": "那$me$来做给你",
            "narrator_zh": ""
        },
        {
            "location": "5052/TALK",
            "narrator": "神楽",
            "text": "$handlek$ってテーラーの資格とかあるの？",
            "zh": "$handlek$有裁缝的资格吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "5053/TALK",
            "narrator": "神楽",
            "text": "ぴょんこはコスプレ衣装作成レベルじゃ満足できないんだからね！",
            "zh": "蹦子可不是角色扮演服装那个水平就能满足的！",
            "narrator_zh": "神乐"
        },
        {
            "location": "5054/TALK",
            "narrator": "神楽",
            "text": "でもそれだったらうんとデコラティブでかわいいやつを作ってもらっちゃおうかなー",
            "zh": "不过要是那样，就让你做个特别装饰、特别可爱的吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "5056/TALK",
            "narrator": "神楽",
            "text": "楽しみにしとく♪",
            "zh": "我期待着♪",
            "narrator_zh": "神乐"
        }
    ]
