{
    "dir": "chap19/daydra/dd_ch04_19_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "19456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "家族写真",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "全家福"
    },
    "entry": [
        {
            "location": "175/SCENARIO",
            "narrator": "",
            "text": "家族写真",
            "zh": "全家福",
            "narrator_zh": ""
        },
        {
            "location": "185/TALK",
            "narrator": "みやび",
            "text": "…ははっ、懐かしいな。",
            "zh": "……哈哈，真怀念啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "186/TALK",
            "narrator": "みやび",
            "text": "まさか、昔のアルバムが\n出てくるとは…。",
            "zh": "没想到，以前的相册\n会翻出来……。",
            "narrator_zh": "雅"
        },
        {
            "location": "188/TALK",
            "narrator": "みやび",
            "text": "…これ、うちか？\nでっかい口開けて\n大笑いしてるが…。",
            "zh": "……这个，是我？\n把嘴张得老大\n哈哈大笑的那个……。",
            "narrator_zh": "雅"
        },
        {
            "location": "190/TALK",
            "narrator": "みやび",
            "text": "こっちのは、初めて\n料理した時の写真やね。",
            "zh": "这张是第一次\n下厨时的照片咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "191/TALK",
            "narrator": "みやび",
            "text": "…焦げ焦げの魚と、\n明らかに色の薄い味噌汁\nやなぁ…。",
            "zh": "……烤焦的鱼，\n还有明显颜色偏淡的\n味噌汤……。",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "もうちっくと上手に\nできてた思うてた\nけんど――",
            "zh": "本来还以为\n做得能再好点的，\n但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "195/TALK",
            "narrator": "みやび",
            "text": "思い出補正やったか…。",
            "zh": "原来是回忆滤镜啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "…しっかし、懐かしい\n気持ちもあるけんど、\n何となく、恥ずかしいな。",
            "zh": "……话说，虽然\n也有点怀念，\n但是总觉得，好害羞啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "197/SEL",
            "narrator": "",
            "text": "見たい見たい！",
            "zh": "想看想看！",
            "narrator_zh": ""
        },
        {
            "location": "199/TALK",
            "narrator": "みやび",
            "text": "今の自分とはかけ離れた\n姿やからか？",
            "zh": "是因为和现在的我\n差太远了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "201/TALK",
            "narrator": "みやび",
            "text": "…うわっ、こっちのは\n初めて逆上がりした時の\n写真や！",
            "zh": "……哇，这张是\n第一次翻上单杠时的\n照片！",
            "narrator_zh": "雅"
        },
        {
            "location": "202/TALK",
            "narrator": "みやび",
            "text": "…これ、本当にうちか？",
            "zh": "……这真的是我？",
            "narrator_zh": "雅"
        },
        {
            "location": "205/TALK",
            "narrator": "みやび",
            "text": "…こっちは、家族写真か。",
            "zh": "……这张，是全家福啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "206/TALK",
            "narrator": "みやび",
            "text": "ははっ、二人とも\n若いなぁ…。",
            "zh": "哈哈，两个人\n都好年轻啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "207/TALK",
            "narrator": "みやび",
            "text": "……あっ。",
            "zh": "……啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "…なごちゃん。",
            "zh": "……七五。",
            "narrator_zh": "雅"
        },
        {
            "location": "222/TALK",
            "narrator": "つばめ",
            "text": "みやびさーん、\nどこですかー？",
            "zh": "雅——\n你在哪里——？",
            "narrator_zh": "燕"
        },
        {
            "location": "225/TALK",
            "narrator": "神楽",
            "text": "部屋の方には\nいませんでした。",
            "zh": "房间那边\n没有看到人。",
            "narrator_zh": "神乐"
        },
        {
            "location": "226/TALK",
            "narrator": "つばめ",
            "text": "こっちもだよ。",
            "zh": "这边也没有哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "227/TALK",
            "narrator": "つばめ",
            "text": "どこに行ったんだろう？\nもうすぐ夕飯なのに…。",
            "zh": "她去哪儿了呢？\n马上就要吃晚饭了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "228/TALK",
            "narrator": "神楽",
            "text": "もしかして、散歩にでも\n行ったんじゃないですか？",
            "zh": "会不会，是出门\n散步去了？",
            "narrator_zh": "神乐"
        },
        {
            "location": "229/TALK",
            "narrator": "つばめ",
            "text": "そうかも。\nわたし、ＷＡＶＥ\n送ってみるよ。",
            "zh": "有可能哦。\n我来发个\nＷＡＶＥ问问吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "230/TALK",
            "narrator": "神楽",
            "text": "はい、お願いし――",
            "zh": "好，那就麻烦——",
            "narrator_zh": "神乐"
        },
        {
            "location": "231/TALK",
            "narrator": "神楽",
            "text": "あっ、みやびさん！",
            "zh": "啊，雅！",
            "narrator_zh": "神乐"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "…なんや？\nさっきから何度も何度も\n呼びまくって…。",
            "zh": "……怎么啦？\n从刚才就一遍\n又一遍喊个不停……。",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "神楽",
            "text": "みやびさん…\nどこにいたんですか？",
            "zh": "雅……\n你刚才去哪里了？",
            "narrator_zh": "神乐"
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "…手洗いや。",
            "zh": "……去洗手间了。",
            "narrator_zh": "雅"
        },
        {
            "location": "244/TALK",
            "narrator": "つばめ",
            "text": "えっ？　でも、奥にある\n木戸の部屋から出てきた\nような…。",
            "zh": "诶？　可是，你好像是\n从最里面那扇\n木门的房间出来的……",
            "narrator_zh": "燕"
        },
        {
            "location": "247/TALK",
            "narrator": "みやび",
            "text": "それで、何の用や？",
            "zh": "所以咧，找我有事？",
            "narrator_zh": "雅"
        },
        {
            "location": "248/TALK",
            "narrator": "つばめ",
            "text": "あ、はい…。\nもうすぐお夕飯の\n時間ですよ？",
            "zh": "啊，是……。\n马上就到\n晚饭时间了哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "…もうそんな時間か。\nありがとな、二人とも。",
            "zh": "……已经到那个时间了啊。\n谢了啊，你们两个。",
            "narrator_zh": "雅"
        },
        {
            "location": "250/TALK",
            "narrator": "神楽",
            "text": "…どうかしたんですか？\n何だか、いつもより\n元気ないみたいです。",
            "zh": "……你怎么了吗？\n感觉比起平时\n没什么精神。",
            "narrator_zh": "神乐"
        },
        {
            "location": "251/TALK",
            "narrator": "神楽",
            "text": "それに、目の下も\n腫れてますし…。",
            "zh": "而且，眼睛下面\n也肿着……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "…大したことやない。",
            "zh": "……没什么大不了的。",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "うち、潮風が苦手でな。\n薬を飲まんと、すぐに目が\nこうなるがよ。",
            "zh": "我啊，吹不得海风。\n不吃药的话，眼睛\n马上就会变成这样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "254/TALK",
            "narrator": "つばめ",
            "text": "そうだったんですか？\nじゃあ、すぐに薬を\n飲まなきゃ…。",
            "zh": "原来是这样吗？\n那得赶紧\n把药吃了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "255/TALK",
            "narrator": "みやび",
            "text": "さっき飲んだき、\nもう平気や。",
            "zh": "刚才已经吃过了啵，\n没事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "…ほれ、夕飯やろ？\nわかったから、\n先に行きぃ。",
            "zh": "……喏，晚饭时间到了啵？\n我知道啦，\n你们先去咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "257/TALK",
            "narrator": "神楽",
            "text": "わかりました…。\nつばめさん、\n行きましょう。",
            "zh": "我知道了……。\n燕，\n我们走吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "260/TALK",
            "narrator": "つばめ",
            "text": "あ、うん…。",
            "zh": "啊，嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "263/SEL",
            "narrator": "",
            "text": "みやび、平気？",
            "zh": "雅，你没事吧？",
            "narrator_zh": ""
        },
        {
            "location": "264/SEL",
            "narrator": "",
            "text": "さっきの写真が原因？",
            "zh": "是因为刚才的照片？",
            "narrator_zh": ""
        },
        {
            "location": "265/SEL",
            "narrator": "",
            "text": "ご飯食べて元気出して",
            "zh": "吃个饭打起精神来",
            "narrator_zh": ""
        },
        {
            "location": "269/TALK",
            "narrator": "みやび",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "雅"
        },
        {
            "location": "270/TALK",
            "narrator": "みやび",
            "text": "…誤魔化せたか？\nまったく、こんな時に\nタイミングが悪い…。",
            "zh": "……糊弄过去了吗？\n真是的，偏偏\n挑这种时候，时机真差……。",
            "narrator_zh": "雅"
        },
        {
            "location": "274/TALK",
            "narrator": "みやび",
            "text": "…顔洗って、\n夕飯にするか。",
            "zh": "……洗把脸，\n去吃晚饭吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "275/TALK",
            "narrator": "みやび",
            "text": "これ以上待たせると、\nまた誰か来るかも\nしれんし…。",
            "zh": "再让她们等下去，\n说不定又有谁\n要过来了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "277/ACT",
            "narrator": "",
            "text": "みやび、平気？",
            "zh": "雅，你没事吧？",
            "narrator_zh": ""
        },
        {
            "location": "295/TALK",
            "narrator": "みやび",
            "text": "さっきつばめちゃんにも、平気言うたの聞いてなかったが？",
            "zh": "刚才我对燕也说过没事，你不是听见咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "296/TALK",
            "narrator": "みやび",
            "text": "同じこと、二度も言わせんなや",
            "zh": "别让我把同一句话讲两遍啊",
            "narrator_zh": "雅"
        },
        {
            "location": "308/ACT",
            "narrator": "",
            "text": "さっきの写真が原因？",
            "zh": "是因为刚才的照片？",
            "narrator_zh": ""
        },
        {
            "location": "326/TALK",
            "narrator": "みやび",
            "text": "潮風言うたの、聞いてなかったが？",
            "zh": "我说过海风的事，你不是听见咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "327/TALK",
            "narrator": "みやび",
            "text": "相棒の考え過ぎや",
            "zh": "是搭档你想太多咯",
            "narrator_zh": "雅"
        },
        {
            "location": "339/ACT",
            "narrator": "",
            "text": "ご飯食べて元気出して",
            "zh": "吃个饭打起精神来",
            "narrator_zh": ""
        },
        {
            "location": "358/TALK",
            "narrator": "みやび",
            "text": "気を利かせてるのか天然なのかはわからんけんど",
            "zh": "分不清她是体贴还是天然，但是",
            "narrator_zh": "雅"
        },
        {
            "location": "359/TALK",
            "narrator": "みやび",
            "text": "今はその反応がありがたいちや",
            "zh": "现在这种反应真是帮了忙滴",
            "narrator_zh": "雅"
        },
        {
            "location": "375/ACT",
            "narrator": "",
            "text": "見たい見たい！",
            "zh": "想看想看！",
            "narrator_zh": ""
        },
        {
            "location": "393/TALK",
            "narrator": "みやび",
            "text": "相棒、すまんけんど、今はちょっと黙っときぃ",
            "zh": "搭档，没好意思，现在你先别吭声",
            "narrator_zh": "雅"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "久しぶりに思い出に浸って楽しんどる最中やき",
            "zh": "我正难得沉浸在回忆里头啵",
            "narrator_zh": "雅"
        },
        {
            "location": "396/TALK",
            "narrator": "みやび",
            "text": "すまんけんど、電源切っとくな",
            "zh": "没好意思，电源就先关着吧",
            "narrator_zh": "雅"
        },
        {
            "location": "183/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月17日　 7:15 PM</color>\n合宿初日の夜、みやびの部屋にて",
            "zh": "<color=green>8月17日　 7:15 PM</color>\n合宿第一天的夜晚，雅的房间",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
