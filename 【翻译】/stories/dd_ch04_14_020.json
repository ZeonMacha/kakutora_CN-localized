{
    "dir": "chap14/daydra/dd_ch04_14_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "14456",
        "cid": "miyabi",
        "title": "Extra005 プレミアムストーリー",
        "sub_title": "國政綾水と逝くPC",
        "title_zh": "Extra005 额外剧情",
        "sub_title_zh": "与国政绫水一同逝去的PC"
    },
    "entry": [
        {
            "location": "470/SCENARIO",
            "narrator": "",
            "text": "アーヤＭＶ回２",
            "zh": "绫水ＭＶ第２回",
            "narrator_zh": ""
        },
        {
            "location": "481/TALK",
            "narrator": "アーヤ",
            "text": "さて、と。\n夕飯も終わったし――",
            "zh": "那么，\n晚饭也吃完了——",
            "narrator_zh": "绫水"
        },
        {
            "location": "482/TALK",
            "narrator": "アーヤ",
            "text": "次の劇の台本でも\n読み直そうかしら？",
            "zh": "要不要把下一出戏的剧本\n再读一遍呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "485/TALK",
            "narrator": "透明みやび",
            "text": "うわああああああああ\nああああああああああ\nああああああああ！！",
            "zh": "呜哇啊啊啊啊啊啊啊\n啊啊啊啊啊啊啊啊啊\n啊啊啊啊！！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "489/TALK",
            "narrator": "アーヤ",
            "text": "っ！？\nこの声、みやび！？",
            "zh": "唔！？\n这声音，是雅！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "503/TALK",
            "narrator": "つばめ",
            "text": "みやびさん！\nどうしたんですか！？\nみやびさん！！",
            "zh": "雅！\n怎么了吗！？\n雅！！",
            "narrator_zh": "燕"
        },
        {
            "location": "509/TALK",
            "narrator": "アーヤ",
            "text": "つばめ！",
            "zh": "燕！",
            "narrator_zh": "绫水"
        },
        {
            "location": "511/TALK",
            "narrator": "つばめ",
            "text": "あ、アーヤさん！\nみやびさんが…。",
            "zh": "啊，绫水！\n雅她……。",
            "narrator_zh": "燕"
        },
        {
            "location": "512/TALK",
            "narrator": "アーヤ",
            "text": "わかってる。\n返事はないの？",
            "zh": "知道了。\n她没有回应吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "514/TALK",
            "narrator": "つばめ",
            "text": "はい。\nみやびさん、\nみやびさん！",
            "zh": "是的。\n雅，\n雅！",
            "narrator_zh": "燕"
        },
        {
            "location": "521/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと、さっきの\n声ってみやびよね？\n何かあったの？",
            "zh": "喂，刚才那\n声音是雅吧？\n出什么事了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "522/TALK",
            "narrator": "アーヤ",
            "text": "わからないわ。\n返事もないし…。",
            "zh": "不知道。\n也没有回应……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "523/TALK",
            "narrator": "つばめ",
            "text": "みやびさーん！！",
            "zh": "雅——！！",
            "narrator_zh": "燕"
        },
        {
            "location": "537/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "538/TALK",
            "narrator": "みやび",
            "text": "終わった…。\nさらば、相棒よ…。",
            "zh": "结束了……。\n永别了，搭档……。",
            "narrator_zh": "雅"
        },
        {
            "location": "550/TALK",
            "narrator": "みやび",
            "text": "相棒",
            "zh": "搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "551/TALK",
            "narrator": "みやび",
            "text": "死去なう",
            "zh": "现在死去了",
            "narrator_zh": "雅"
        },
        {
            "location": "553/SEL",
            "narrator": "",
            "text": "生きてるよ！？",
            "zh": "你还活着！？",
            "narrator_zh": ""
        },
        {
            "location": "554/ACT",
            "narrator": "",
            "text": "生きてるよ！？",
            "zh": "你还活着！？",
            "narrator_zh": ""
        },
        {
            "location": "556/TALK",
            "narrator": "みやび",
            "text": "相棒ゆうても",
            "zh": "虽说是搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "557/TALK",
            "narrator": "みやび",
            "text": "うちのＰＣの方や",
            "zh": "说的是我的ＰＣ咯",
            "narrator_zh": "雅"
        },
        {
            "location": "558/TALK",
            "narrator": "みやび",
            "text": "たった今",
            "zh": "就在刚才",
            "narrator_zh": "雅"
        },
        {
            "location": "559/TALK",
            "narrator": "みやび",
            "text": "逝ってしまわれた",
            "zh": "逝去了",
            "narrator_zh": "雅"
        },
        {
            "location": "560/TALK",
            "narrator": "みやび",
            "text": "雲の向こう",
            "zh": "到云的那边",
            "narrator_zh": "雅"
        },
        {
            "location": "561/TALK",
            "narrator": "みやび",
            "text": "機械の天国へ",
            "zh": "机械的天国去了",
            "narrator_zh": "雅"
        },
        {
            "location": "562/TALK",
            "narrator": "みやび",
            "text": "煙りとともに",
            "zh": "伴着青烟",
            "narrator_zh": "雅"
        },
        {
            "location": "564/SEL",
            "narrator": "",
            "text": "修理不能っぽい？",
            "zh": "看着修不好了？",
            "narrator_zh": ""
        },
        {
            "location": "565/ACT",
            "narrator": "",
            "text": "修理不能っぽい？",
            "zh": "看着修不好了？",
            "narrator_zh": ""
        },
        {
            "location": "567/TALK",
            "narrator": "みやび",
            "text": "焦げ臭さマックス",
            "zh": "焦味满格",
            "narrator_zh": "雅"
        },
        {
            "location": "568/TALK",
            "narrator": "みやび",
            "text": "無理やね",
            "zh": "没救咯",
            "narrator_zh": "雅"
        },
        {
            "location": "570/TALK",
            "narrator": "みやび",
            "text": "ちゅうか",
            "zh": "话说",
            "narrator_zh": "雅"
        },
        {
            "location": "572/TALK",
            "narrator": "みやび",
            "text": "ドアうるさいき",
            "zh": "门口吵死了啵",
            "narrator_zh": "雅"
        },
        {
            "location": "573/TALK",
            "narrator": "みやび",
            "text": "相棒から連絡よろ",
            "zh": "要说话就找搭档传话哦",
            "narrator_zh": "雅"
        },
        {
            "location": "576/SEL",
            "narrator": "",
            "text": "声掛けないの？",
            "zh": "不出声吗？",
            "narrator_zh": ""
        },
        {
            "location": "577/ACT",
            "narrator": "",
            "text": "声掛けないの？",
            "zh": "不出声吗？",
            "narrator_zh": ""
        },
        {
            "location": "579/TALK",
            "narrator": "みやび",
            "text": "気力なし",
            "zh": "没力气",
            "narrator_zh": "雅"
        },
        {
            "location": "580/TALK",
            "narrator": "みやび",
            "text": "大切な物を失った人の気持ち",
            "zh": "体会一下失去重要之物的人的心情",
            "narrator_zh": "雅"
        },
        {
            "location": "581/TALK",
            "narrator": "みやび",
            "text": "察せよ",
            "zh": "用心体会！",
            "narrator_zh": "雅"
        },
        {
            "location": "592/TALK",
            "narrator": "みやび",
            "text": "…バックアップは\n取っちょるけんど――",
            "zh": "…备份是有做着的，\n但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "593/TALK",
            "narrator": "みやび",
            "text": "やはり、精神に\nドカンと大ダメージ\nくるなぁ…。",
            "zh": "果然，精神上\n还是被狠狠轰了个\n大洞啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "595/TALK",
            "narrator": "みやび",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "雅"
        },
        {
            "location": "610/TALK",
            "narrator": "つばめ",
            "text": "みやびさん！！\n大丈夫ですか！？\n何があったんですか！",
            "zh": "雅！！\n你没事吧！？\n发生什么了！",
            "narrator_zh": "燕"
        },
        {
            "location": "612/TALK",
            "narrator": "ガブリエラ",
            "text": "…ねえ、これって\nヤバいんじゃない？",
            "zh": "……我说，这样\n是不是不妙？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "614/TALK",
            "narrator": "アーヤ",
            "text": "そうね…。\n部屋で倒れてたり\nしたら大変だし。",
            "zh": "是啊……。\n要是倒在房间里\n就糟了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "617/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "619/TALK",
            "narrator": "アーヤ",
            "text": "館長に連絡するわ。",
            "zh": "我联系馆长。",
            "narrator_zh": "绫水"
        },
        {
            "location": "621/SEL",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "622/ACT",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "628/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさい",
            "zh": "不好意思",
            "narrator_zh": "绫水"
        },
        {
            "location": "629/TALK",
            "narrator": "アーヤ",
            "text": "今は話せないから",
            "zh": "现在不方便说话",
            "narrator_zh": "绫水"
        },
        {
            "location": "631/SEL",
            "narrator": "",
            "text": "みやびは無事だよ",
            "zh": "雅没事的哦",
            "narrator_zh": ""
        },
        {
            "location": "632/SEL",
            "narrator": "",
            "text": "みやびが死んじゃう！！",
            "zh": "雅要死了！！",
            "narrator_zh": ""
        },
        {
            "location": "633/ACT",
            "narrator": "",
            "text": "みやびは無事だよ",
            "zh": "雅没事的哦",
            "narrator_zh": ""
        },
        {
            "location": "634/TALK",
            "narrator": "アーヤ",
            "text": "そうなの？工ｴｴｪｪ(´д｀)ｪｪｴｴ工",
            "zh": "是吗？工ｴｴｪｪ(´д｀)ｪｪｴｴ工",
            "narrator_zh": "绫水"
        },
        {
            "location": "635/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ",
            "zh": "那",
            "narrator_zh": "绫水"
        },
        {
            "location": "636/TALK",
            "narrator": "アーヤ",
            "text": "さっきの声はなに？",
            "zh": "刚才那声音是什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "638/SEL",
            "narrator": "",
            "text": "ＰＣが壊れて、今は放心状態",
            "zh": "ＰＣ坏了，现在是发呆状态",
            "narrator_zh": ""
        },
        {
            "location": "639/ACT",
            "narrator": "",
            "text": "ＰＣが壊れて、今は放心状態",
            "zh": "ＰＣ坏了，现在是发呆状态",
            "narrator_zh": ""
        },
        {
            "location": "643/TALK",
            "narrator": "アーヤ",
            "text": "ああ",
            "zh": "啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "644/TALK",
            "narrator": "アーヤ",
            "text": "そういうこと",
            "zh": "是这么回事",
            "narrator_zh": "绫水"
        },
        {
            "location": "645/TALK",
            "narrator": "アーヤ",
            "text": "なんか",
            "zh": "总觉得",
            "narrator_zh": "绫水"
        },
        {
            "location": "647/TALK",
            "narrator": "アーヤ",
            "text": "納得だわ(-.-;)",
            "zh": "能理解了(-.-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "659/TALK",
            "narrator": "アーヤ",
            "text": "…二人とも。\nみやびは無事みたい。",
            "zh": "…你们两个。\n雅好像没事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "661/TALK",
            "narrator": "ガブリエラ",
            "text": "どう考えても\n無事っぽくない\n声だったけど？",
            "zh": "可不管怎么想，\n都不像没事的人\n发出的声音吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "662/TALK",
            "narrator": "アーヤ",
            "text": "なんか、みやびの\nＰＣが壊れちゃった\nみたいなの。",
            "zh": "好像是雅的\nＰＣ\n坏了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "663/TALK",
            "narrator": "アーヤ",
            "text": "さっきの声は\nそれが原因らしいわ。",
            "zh": "刚才那声音\n好像就是这个原因。",
            "narrator_zh": "绫水"
        },
        {
            "location": "665/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、みやびさんは\n無事なんですね？",
            "zh": "那，雅是\n平安无事的吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "667/TALK",
            "narrator": "アーヤ",
            "text": "ショックは受けてる\nみたいだけどね。",
            "zh": "虽然人像是受了\n不小的打击。",
            "narrator_zh": "绫水"
        },
        {
            "location": "669/TALK",
            "narrator": "ガブリエラ",
            "text": "何よそれ！？\n人騒がせなん\nだから…。",
            "zh": "什么啊这是！？\n真会折腾人\n……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "670/TALK",
            "narrator": "つばめ",
            "text": "で、でも、無事で\nよかったよ。",
            "zh": "可、可是，没事\n就好。",
            "narrator_zh": "燕"
        },
        {
            "location": "672/TALK",
            "narrator": "ガブリエラ",
            "text": "バカバカしい…。\n部屋戻るわ。",
            "zh": "真无聊……。\n我回房间了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "675/TALK",
            "narrator": "つばめ",
            "text": "あ、ガブちゃん！",
            "zh": "啊，加布！",
            "narrator_zh": "燕"
        },
        {
            "location": "676/TALK",
            "narrator": "つばめ",
            "text": "…みやびさん、\n本当に大丈夫なん\nですか？",
            "zh": "…雅真的\n没事\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "677/TALK",
            "narrator": "アーヤ",
            "text": "ん～、多分ね。",
            "zh": "嗯～，大概吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "679/TALK",
            "narrator": "アーヤ",
            "text": "とにかく、つばめも\n部屋に戻って。",
            "zh": "总之，燕也\n回房间去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "680/TALK",
            "narrator": "つばめ",
            "text": "わかりました。\nそれじゃあ…。",
            "zh": "知道了。\n那……。",
            "narrator_zh": "燕"
        },
        {
            "location": "685/TALK",
            "narrator": "アーヤ",
            "text": "…まったく、\n人騒がせなん\nだから…。",
            "zh": "…真是的，\n净折腾人\n……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "697/TALK",
            "narrator": "アーヤ",
            "text": "確認するけど",
            "zh": "跟你确认一下",
            "narrator_zh": "绫水"
        },
        {
            "location": "698/TALK",
            "narrator": "アーヤ",
            "text": "本当にみやびは大丈夫？",
            "zh": "雅真的没事？",
            "narrator_zh": "绫水"
        },
        {
            "location": "700/SEL",
            "narrator": "",
            "text": "ショック受けてるから、大丈夫じゃないかも",
            "zh": "受了打击，可能不算没事",
            "narrator_zh": ""
        },
        {
            "location": "701/ACT",
            "narrator": "",
            "text": "ショック受けてるから、大丈夫じゃないかも",
            "zh": "受了打击，可能不算没事",
            "narrator_zh": ""
        },
        {
            "location": "703/TALK",
            "narrator": "アーヤ",
            "text": "そう",
            "zh": "是嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "704/TALK",
            "narrator": "アーヤ",
            "text": "まったく",
            "zh": "真是的",
            "narrator_zh": "绫水"
        },
        {
            "location": "705/TALK",
            "narrator": "アーヤ",
            "text": "大袈裟過ぎるわ(｀ヘ´)",
            "zh": "太夸张了(｀ヘ´)",
            "narrator_zh": "绫水"
        },
        {
            "location": "707/TALK",
            "narrator": "アーヤ",
            "text": "何台もＰＣ持ってるのに",
            "zh": "明明有好多台ＰＣ",
            "narrator_zh": "绫水"
        },
        {
            "location": "708/TALK",
            "narrator": "アーヤ",
            "text": "一台壊れたくらいで",
            "zh": "才坏了一台而已",
            "narrator_zh": "绫水"
        },
        {
            "location": "709/TALK",
            "narrator": "アーヤ",
            "text": "困ったものね(-ω-;)",
            "zh": "真拿她没办法(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "711/SEL",
            "narrator": "",
            "text": "アーヤにとってのバイクみたいなもの",
            "zh": "对绫水来说就像摩托一样的东西",
            "narrator_zh": ""
        },
        {
            "location": "712/ACT",
            "narrator": "",
            "text": "アーヤにとってのバイクみたいなもの",
            "zh": "对绫水来说就像摩托一样的东西",
            "narrator_zh": ""
        },
        {
            "location": "715/TALK",
            "narrator": "アーヤ",
            "text": "前言撤回するわ",
            "zh": "我收回前言",
            "narrator_zh": "绫水"
        },
        {
            "location": "716/TALK",
            "narrator": "アーヤ",
            "text": "それ",
            "zh": "这个",
            "narrator_zh": "绫水"
        },
        {
            "location": "717/TALK",
            "narrator": "アーヤ",
            "text": "凄いショックよ(；´Д｀)",
            "zh": "那是超大的打击(；´Д｀)",
            "narrator_zh": "绫水"
        },
        {
            "location": "718/TALK",
            "narrator": "アーヤ",
            "text": "落ち込んで当然よね",
            "zh": "消沉也是当然的",
            "narrator_zh": "绫水"
        },
        {
            "location": "719/TALK",
            "narrator": "アーヤ",
            "text": "ううん",
            "zh": "不",
            "narrator_zh": "绫水"
        },
        {
            "location": "720/TALK",
            "narrator": "アーヤ",
            "text": "大泣きしてもいいレベルよ(; ;)",
            "zh": "嚎啕大哭都不为过的程度哦(; ;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "731/TALK",
            "narrator": "アーヤ",
            "text": "…今日は、\nそっとしておいた方が\nよさそうね。",
            "zh": "…今天，\n还是别去打扰她\n比较好吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "732/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "734/TALK",
            "narrator": "アーヤ",
            "text": "でも、それは少し\n薄情かしら…？",
            "zh": "可是，那样\n是不是有点薄情……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "744/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "746/TALK",
            "narrator": "みやび",
            "text": "…いかん。\n立ち直れん…。",
            "zh": "…不行。\n振作不起来……。",
            "narrator_zh": "雅"
        },
        {
            "location": "747/TALK",
            "narrator": "みやび",
            "text": "マジ、ショックが\nデカすぎて…。",
            "zh": "真的，打击\n太大了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "751/TALK",
            "narrator": "みやび",
            "text": "…相棒か？",
            "zh": "…是搭档吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "763/TALK",
            "narrator": "アーヤ",
            "text": "みやび",
            "zh": "雅",
            "narrator_zh": "绫水"
        },
        {
            "location": "764/TALK",
            "narrator": "アーヤ",
            "text": "平気？",
            "zh": "没事吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "768/TALK",
            "narrator": "アーヤ",
            "text": "そう",
            "zh": "是嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "769/TALK",
            "narrator": "アーヤ",
            "text": "気の済むまで",
            "zh": "直到你消气为止",
            "narrator_zh": "绫水"
        },
        {
            "location": "770/TALK",
            "narrator": "アーヤ",
            "text": "暴れていいし",
            "zh": "尽管撒野也没关系",
            "narrator_zh": "绫水"
        },
        {
            "location": "771/TALK",
            "narrator": "アーヤ",
            "text": "泣いてもいいから",
            "zh": "哭出来也没关系",
            "narrator_zh": "绫水"
        },
        {
            "location": "772/TALK",
            "narrator": "アーヤ",
            "text": "落ち着いたら",
            "zh": "等冷静下来",
            "narrator_zh": "绫水"
        },
        {
            "location": "773/TALK",
            "narrator": "アーヤ",
            "text": "部屋にきて",
            "zh": "来我房间",
            "narrator_zh": "绫水"
        },
        {
            "location": "774/TALK",
            "narrator": "アーヤ",
            "text": "ご飯くらい作るから(^^",
            "zh": "饭我起码会给你做的(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "786/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "788/TALK",
            "narrator": "みやび",
            "text": "…アホやねぇ。",
            "zh": "…真是个笨蛋咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "790/TALK",
            "narrator": "みやび",
            "text": "こんな精密機械\nだらけの部屋で――",
            "zh": "在这种满是\n精密仪器的房间里——",
            "narrator_zh": "雅"
        },
        {
            "location": "791/TALK",
            "narrator": "みやび",
            "text": "暴れられるわけ、\nないやないか…。\nぐすっ、うっ…。",
            "zh": "怎么可能撒得起来\n野啊……。\n抽噎、呜……。",
            "narrator_zh": "雅"
        },
        {
            "location": "792/ACT",
            "narrator": "",
            "text": "みやびが死んじゃう！！",
            "zh": "雅要死了！！",
            "narrator_zh": ""
        },
        {
            "location": "793/TALK",
            "narrator": "アーヤ",
            "text": "死んじゃう！？",
            "zh": "要死了！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "795/TALK",
            "narrator": "アーヤ",
            "text": "何で！？",
            "zh": "为什么！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "807/TALK",
            "narrator": "アーヤ",
            "text": "みやび！？\nみやび、返事して！！\nみやびってば！！",
            "zh": "雅！？\n雅，回话！！\n雅你倒是说话啊！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "814/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、アーヤ！？\nどうしたのよ急に！！",
            "zh": "等、绫水！？\n你怎么突然！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "816/TALK",
            "narrator": "アーヤ",
            "text": "わからないけど、\nみやび、死んじゃう\nかもしれないのよ！",
            "zh": "我也不知道，但\n雅可能会\n死掉啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "818/TALK",
            "narrator": "ガブリエラ",
            "text": "えぇっ！？",
            "zh": "诶！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "819/TALK",
            "narrator": "つばめ",
            "text": "そ、そんな…。\nみやびさん！！\nみやびさん！！",
            "zh": "不、不会吧……。\n雅！！\n雅！！",
            "narrator_zh": "燕"
        },
        {
            "location": "825/TALK",
            "narrator": "アーヤ",
            "text": "みやび！！\n死んじゃダメよ！！\n聞こえてる！？",
            "zh": "雅！！\n你不能死！！\n听得到吗！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "826/TALK",
            "narrator": "アーヤ",
            "text": "すぐ開けるから、\n死なないで！！",
            "zh": "马上就开门了，\n你不能死！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "828/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん！\n合鍵とかって\nないんですか？",
            "zh": "绫水！\n有没有备用\n钥匙什么的？",
            "narrator_zh": "燕"
        },
        {
            "location": "830/TALK",
            "narrator": "アーヤ",
            "text": "館長が持ってるから、\n劇場に行かないと…。",
            "zh": "在馆长那里，\n得去剧场一趟……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "833/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ、緊急事態よ！\nこうなったら――",
            "zh": "绫水，紧急事态！\n事到如今——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "834/TALK",
            "narrator": "ガブリエラ",
            "text": "ドアをぶち破るしか\nないわ！",
            "zh": "只有把门撞开\n一条路了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "836/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "838/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびが死ぬかも\nしれないのよ！？",
            "zh": "雅可是可能会\n死掉的！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "839/TALK",
            "narrator": "ガブリエラ",
            "text": "人命に比べたら\nドア一枚くらい\nなによ！？",
            "zh": "跟人命比起来，\n一扇门算个\n什么！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "841/TALK",
            "narrator": "アーヤ",
            "text": "…そうね。",
            "zh": "…是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "842/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィは\nドアを壊せそうな物を\n探して――",
            "zh": "加维去找\n能砸开门的\n东西——",
            "narrator_zh": "绫水"
        },
        {
            "location": "843/TALK",
            "narrator": "アーヤ",
            "text": "つばめは館長から\n合鍵を貰ってきて。",
            "zh": "燕去馆长那里\n拿备用钥匙。",
            "narrator_zh": "绫水"
        },
        {
            "location": "845/TALK",
            "narrator": "つばめ",
            "text": "は、はい！",
            "zh": "是、是！",
            "narrator_zh": "燕"
        },
        {
            "location": "847/TALK",
            "narrator": "ガブリエラ",
            "text": "わかったわ。",
            "zh": "知道了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "848/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、急いで――",
            "zh": "那就快去——",
            "narrator_zh": "绫水"
        },
        {
            "location": "854/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "856/TALK",
            "narrator": "アーヤ",
            "text": "み、みやび！？",
            "zh": "雅、雅！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "858/TALK",
            "narrator": "つばめ",
            "text": "みやびさん！！\n大丈夫ですか！？",
            "zh": "雅！！\n你没事吧！？",
            "narrator_zh": "燕"
        },
        {
            "location": "861/TALK",
            "narrator": "みやび",
            "text": "…あんたら、\n人の部屋の前で\n何を騒いどるが？",
            "zh": "…你们几个，\n在我房间门口\n吵驷马咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "863/TALK",
            "narrator": "ガブリエラ",
            "text": "あんた、平気なの？\n死にそうなんじゃ…。",
            "zh": "你没事吗？\n不是要死了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "865/TALK",
            "narrator": "みやび",
            "text": "…うちが？",
            "zh": "…我？",
            "narrator_zh": "雅"
        },
        {
            "location": "867/TALK",
            "narrator": "みやび",
            "text": "この通り、ピンピン\nしちゅうがよ。",
            "zh": "看好了，正\n活蹦乱跳着咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "868/TALK",
            "narrator": "つばめ",
            "text": "そ、そうですか？\n元気ないように\n見えますけど…。",
            "zh": "是、是吗？\n看着很没精神\n的样子……。",
            "narrator_zh": "燕"
        },
        {
            "location": "871/TALK",
            "narrator": "みやび",
            "text": "…相棒がな。",
            "zh": "…搭档它啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "873/TALK",
            "narrator": "みやび",
            "text": "大切な相棒が…、\n死んでしもうてな…。",
            "zh": "重要的搭档……，\n死掉了啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "874/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ…死んだ？",
            "zh": "诶……死了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "877/TALK",
            "narrator": "みやび",
            "text": "うむ…まあ、\nそういうわけや。",
            "zh": "嗯…嘛，\n就是这么回事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "878/TALK",
            "narrator": "みやび",
            "text": "やき、うちのハートは\n今、喪中ながよ。",
            "zh": "所以啵，我的心\n现在正服丧中咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "882/TALK",
            "narrator": "みやび",
            "text": "悪いけんど、\nそっとしといて\nもらえんか？",
            "zh": "没好意思，但是\n能让我一个人\n静静吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "883/TALK",
            "narrator": "アーヤ",
            "text": "そ、そっか…。\nわかったわ。",
            "zh": "是、是嘛……。\n我知道了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "885/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、相棒ってのが\n誰かは知らない\nけど――",
            "zh": "嘛，虽然不知道\n你说的搭档\n是谁——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "886/TALK",
            "narrator": "ガブリエラ",
            "text": "元気出しなさいよ？",
            "zh": "你也打起点精神来嘛？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "887/TALK",
            "narrator": "つばめ",
            "text": "何かあったら、\nいつでも声かけて\nくださいね！",
            "zh": "有什么事的话，\n随时都可以\n叫我哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "890/TALK",
            "narrator": "みやび",
            "text": "ん…じゃあ。",
            "zh": "嗯…那就这样。",
            "narrator_zh": "雅"
        },
        {
            "location": "905/TALK",
            "narrator": "みやび",
            "text": "…はぁ。",
            "zh": "…唉。",
            "narrator_zh": "雅"
        },
        {
            "location": "917/TALK",
            "narrator": "みやび",
            "text": "おい相棒",
            "zh": "喂，搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "918/TALK",
            "narrator": "みやび",
            "text": "どんなデマ流しよった？",
            "zh": "你散播了驷马谣言？",
            "narrator_zh": "雅"
        },
        {
            "location": "920/SEL",
            "narrator": "",
            "text": "みやびが死んじゃう、って",
            "zh": "说雅要死了",
            "narrator_zh": ""
        },
        {
            "location": "921/ACT",
            "narrator": "",
            "text": "みやびが死んじゃう、って",
            "zh": "说雅要死了",
            "narrator_zh": ""
        },
        {
            "location": "923/TALK",
            "narrator": "みやび",
            "text": "なぜそんなことを！？",
            "zh": "为什么要干那种事！？",
            "narrator_zh": "雅"
        },
        {
            "location": "924/TALK",
            "narrator": "みやび",
            "text": "そんなこと言うたらどうなるか",
            "zh": "说那种话会有什么后果",
            "narrator_zh": "雅"
        },
        {
            "location": "925/TALK",
            "narrator": "みやび",
            "text": "察せなかったが？",
            "zh": "没想到后果吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "926/TALK",
            "narrator": "みやび",
            "text": "ちゅうか",
            "zh": "话说",
            "narrator_zh": "雅"
        },
        {
            "location": "927/TALK",
            "narrator": "みやび",
            "text": "うちの気持ちも察せてなかった？",
            "zh": "我的心情你也没体察到？",
            "narrator_zh": "雅"
        },
        {
            "location": "928/TALK",
            "narrator": "みやび",
            "text": "やはり",
            "zh": "果然",
            "narrator_zh": "雅"
        },
        {
            "location": "930/TALK",
            "narrator": "みやび",
            "text": "人は言葉を交わさんとわかりあえん",
            "zh": "人不交谈就无法相互理解",
            "narrator_zh": "雅"
        },
        {
            "location": "931/TALK",
            "narrator": "みやび",
            "text": "そういうことなのかもしれん",
            "zh": "说的或许就是这么回事",
            "narrator_zh": "雅"
        },
        {
            "location": "932/TALK",
            "narrator": "みやび",
            "text": "悲しい発見をした夏の夜",
            "zh": "有了悲伤发现的夏夜",
            "narrator_zh": "雅"
        },
        {
            "location": "933/TALK",
            "narrator": "みやび",
            "text": "Ｂｙみやび",
            "zh": "Ｂｙ雅",
            "narrator_zh": "雅"
        },
        {
            "location": "944/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "945/TALK",
            "narrator": "みやび",
            "text": "怒ったからか？\nびみょ～にやけんど、\n気持ち軽くなったな。",
            "zh": "是因为发了火吗？\n虽然微妙～地，\n心情轻快了点咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "947/TALK",
            "narrator": "みやび",
            "text": "…新しいＰＣでも、\nのんびり組むか…。",
            "zh": "…要不慢悠悠\n组装台新ＰＣ吧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "480/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月28日　7:48 PM</color>\nとある平日の夜、寮「とらいあんぐる」アーヤの部屋。",
            "zh": "<color=green>6月28日　7:48 PM</color>\n某个平常的夜晚，宿舍“三角”绫水的房间。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
