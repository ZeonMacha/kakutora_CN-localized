            "narrator_zh": ""
        },
        {
            "location": "765/TALK",
            "narrator": "つばめ",
            "text": "そうだよね",
            "zh": "是啊",
            "narrator_zh": "燕"
        },
        {
            "location": "766/TALK",
            "narrator": "つばめ",
            "text": "わたしもいやだよ",
