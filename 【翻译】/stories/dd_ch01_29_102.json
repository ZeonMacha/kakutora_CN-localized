    "entry": [
        {
            "location": "625/SCENARIO",
            "narrator": "",
            "text": "細い糸をつなげてみたら",
            "zh": "试着把细线接上的话",
            "narrator_zh": ""
        },
        {
            "location": "649/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "650/TALK",
            "narrator": "つばめ",
            "text": "はぁ…\nやっぱり無理かも。",
            "zh": "唉……\n果然还是不行吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "651/TALK",
            "narrator": "つばめ",
            "text": "通信が筒抜けになったら、\n神楽ちゃんにも迷惑\nかけちゃうかもだし……。",
            "zh": "要是通信被听光了，\n也许还会给神乐\n添麻烦……",
            "narrator_zh": "燕"
        },
        {
            "location": "652/TALK",
            "narrator": "つばめ",
            "text": "大人しくしていた方が\nいいよね…。",
            "zh": "还是安安静静\n待着比较好吧……",
            "narrator_zh": "燕"
        },
        {
            "location": "653/TALK",
            "narrator": "神楽",
            "text": "どうしますか？\nつばめさん。",
            "zh": "怎么办？\n燕。",
            "narrator_zh": "神乐"
        },
        {
            "location": "654/TALK",
            "narrator": "つばめ",
            "text": "あっ…えっと……",
            "zh": "啊……那个……",
            "narrator_zh": "燕"
        },
        {
            "location": "655/TALK",
            "narrator": "つばめ",
            "text": "やっぱり大人しく\nしていることにするよ。",
            "zh": "果然还是\n安安静静地待着。",
            "narrator_zh": "燕"
        },
        {
            "location": "656/TALK",
            "narrator": "神楽",
            "text": "……そうですか。",
            "zh": "……这样啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "657/TALK",
            "narrator": "神楽",
            "text": "そうですね。\nその方が無難かも\nしれません。",
            "zh": "是啊。\n那样也许\n更稳妥。",
            "narrator_zh": "神乐"
        },
        {
            "location": "658/TALK",
            "narrator": "神楽",
            "text": "もしかしたら、通信した\n瞬間に、射殺されちゃって\nいたかもしれませんしね。",
            "zh": "说不定，在连上的\n那一瞬间，就已经\n被射杀了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "659/TALK",
            "narrator": "つばめ",
            "text": "ええええっ！！\nそそそそんな……！",
            "zh": "诶诶诶诶！！\n怎、怎么会……！",
            "narrator_zh": "燕"
        },
        {
            "location": "660/TALK",
            "narrator": "神楽",
            "text": "妄想ですよ。\nただ、あらゆる可能性の\n１つだとは思いますけど。",
            "zh": "是想象。\n不过，我认为这是\n各种可能性之一。",
            "narrator_zh": "神乐"
        },
        {
            "location": "661/TALK",
            "narrator": "つばめ",
            "text": "なんだぁ……。",
            "zh": "什么啊……",
            "narrator_zh": "燕"
        },
        {
            "location": "682/TALK",
            "narrator": "つばめ",
            "text": "決めた。",
            "zh": "决定了。",
            "narrator_zh": "燕"
        },
        {
            "location": "683/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんの言うこと\n試すことにする。",
            "zh": "神乐说的，\n我要试试。",
            "narrator_zh": "燕"
        },
        {
            "location": "684/TALK",
            "narrator": "つばめ",
            "text": "お願いします。\n繋げてください。",
            "zh": "拜托了。\n请帮我连上。",
            "narrator_zh": "燕"
        },
        {
            "location": "685/TALK",
            "narrator": "神楽",
            "text": "…いいんですか？",
            "zh": "……可以吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "686/TALK",
            "narrator": "つばめ",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "687/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんがそこまで\n言うんだから\n本当なんでしょ？",
            "zh": "神乐都\n说到这份上了，\n是真的吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "688/TALK",
            "narrator": "つばめ",
            "text": "だったらわたし\n$handle$さんと\nお話ししときたい。",
            "zh": "那样的话我\n想和$handle$\n说上话。",
            "narrator_zh": "燕"
        },
        {
            "location": "689/TALK",
            "narrator": "つばめ",
            "text": "お話しできないまま\n死んじゃうのは\nイヤだから。",
            "zh": "还没说上话\n就死掉，\n我不愿意。",
            "narrator_zh": "燕"
        },
        {
            "location": "692/TALK",
            "narrator": "神楽",
            "text": "そう、ですか……。",
            "zh": "这样，吗……",
            "narrator_zh": "神乐"
        },
        {
            "location": "693/TALK",
            "narrator": "つばめ",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "696/TALK",
            "narrator": "神楽",
            "text": "…ではひとつ交換条件。",
            "zh": "……那就一个交换条件。",
            "narrator_zh": "神乐"
        },
        {
            "location": "697/TALK",
            "narrator": "神楽",
            "text": "話し終わったら\n切らないでそのまま\nスマホを貸してください。",
            "zh": "说完之后\n别挂断，把手机\n借给我。",
            "narrator_zh": "神乐"
        },
        {
            "location": "698/TALK",
            "narrator": "つばめ",
            "text": "わかった。",
            "zh": "知道了。",
            "narrator_zh": "燕"
        },
        {
            "location": "709/TALK",
            "narrator": "神楽",
            "text": "……。\n完了です。",
            "zh": "……。\n连上了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "717/TALK",
            "narrator": "つばめ",
            "text": "$handle$さん？",
            "zh": "$handle$？",
            "narrator_zh": "燕"
        },
        {
            "location": "719/SEL",
            "narrator": "",
            "text": "やっと繋がった！",
            "zh": "终于连上了！",
            "narrator_zh": ""
        },
        {
            "location": "720/SEL",
            "narrator": "",
            "text": "ずっとメッセージ送ってたのに",
            "zh": "我一直在发消息",
            "narrator_zh": ""
        },
        {
            "location": "721/SEL",
            "narrator": "",
            "text": "つばめは大丈夫？",
            "zh": "燕没事吧？",
            "narrator_zh": ""
        },
        {
            "location": "722/ACT",
            "narrator": "",
            "text": "やっと繋がった！",
            "zh": "终于连上了！",
            "narrator_zh": ""
        },
        {
            "location": "723/TALK",
            "narrator": "つばめ",
            "text": "え",
            "zh": "诶",
            "narrator_zh": "燕"
        },
        {
            "location": "724/TALK",
            "narrator": "つばめ",
            "text": "やっぱりそうなの",
            "zh": "果然是这样啊",
            "narrator_zh": "燕"
        },
        {
            "location": "725/ACT",
            "narrator": "",
            "text": "ずっとメッセージ送ってたのに",
            "zh": "我一直在发消息",
            "narrator_zh": ""
        },
        {
            "location": "726/TALK",
