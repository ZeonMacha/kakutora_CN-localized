            "location": "818/SEL",
            "narrator": "",
            "text": "卯月って電波なの？",
            "zh": "卯月是电波系的吗？",
            "narrator_zh": ""
        },
        {
            "location": "819/ACT",
            "narrator": "",
            "text": "何の話？",
            "zh": "在说什么？",
            "narrator_zh": ""
        },
        {
            "location": "821/TALK",
            "narrator": "つばめ",
            "text": "そのうちわかる話です",
            "zh": "迟早会明白的",
            "narrator_zh": "燕"
        },
        {
            "location": "822/ACT",
            "narrator": "",
            "text": "解説して",
            "zh": "解说一下",
            "narrator_zh": ""
        },
        {
            "location": "824/TALK",
            "narrator": "つばめ",
            "text": "まさか",
            "zh": "怎么会",
            "narrator_zh": "燕"
        },
        {
            "location": "825/TALK",
            "narrator": "つばめ",
            "text": "それは無理です",
            "zh": "那可做不到",
            "narrator_zh": "燕"
        },
        {
            "location": "826/ACT",
            "narrator": "",
            "text": "卯月って電波なの？",
            "zh": "卯月是电波系的吗？",
            "narrator_zh": ""
        },
        {
            "location": "828/TALK",
            "narrator": "つばめ",
            "text": "そう思うなら",
            "zh": "你要是这么想",
            "narrator_zh": "燕"
        },
        {
            "location": "829/TALK",
            "narrator": "つばめ",
            "text": "そうなんでしょうね",
            "zh": "那就当是这样吧",
            "narrator_zh": "燕"
        },
        {
            "location": "832/TALK",
            "narrator": "つばめ",
            "text": "通信終了",
            "zh": "通信结束",
            "narrator_zh": "燕"
        },
        {
            "location": "833/TALK",
            "narrator": "つばめ",
            "text": "切断します",
            "zh": "我切断了",
            "narrator_zh": "燕"
        },
        {
            "location": "846/TALK",
            "narrator": "つばめ",
            "text": "ありがとう\n神楽ちゃん。",
            "zh": "谢谢\n神乐。",
            "narrator_zh": "燕"
        },
        {
            "location": "848/TALK",
            "narrator": "神楽",
            "text": "いいえ。",
            "zh": "没什么。",
            "narrator_zh": "神乐"
        },
        {
            "location": "852/TALK",
            "narrator": "神楽",
            "text": "それより、\n先につばめさんに\n謝っておきますね。",
            "zh": "比起这个，\n我先向燕\n道歉。",
            "narrator_zh": "神乐"
        },
        {
            "location": "853/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "865/TALK",
            "narrator": "透明神楽",
            "text": "ごめんなさい。",
            "zh": "对不起。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "866/TALK",
            "narrator": "透明神楽",
            "text": "私はきっと、あなたを\n殺してしまう。",
            "zh": "我一定会\n杀掉你。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "868/TALK",
            "narrator": "透明神楽",
            "text": "正確には\n「殺させられてしまう」。",
            "zh": "准确地说，\n是「会被逼着去杀」。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "869/TALK",
            "narrator": "透明神楽",
            "text": "ごめんなさい。\nこれを止めることは\nできないんです。",
            "zh": "对不起。\n这件事\n我阻止不了。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "870/TALK",
            "narrator": "透明神楽",
            "text": "私がどう頑張っても\n止められないんです。",
            "zh": "无论我怎么努力，\n都阻止不了。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "871/TALK",
            "narrator": "透明つばめ",
            "text": "えと……。\n神楽…ちゃん…？",
            "zh": "那个……\n神乐……？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "872/TALK",
            "narrator": "透明神楽",
            "text": "おかしいことを\n言っているのは\nわかっています。",
            "zh": "我知道\n自己在说\n奇怪的话。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "873/TALK",
            "narrator": "透明神楽",
            "text": "本当にごめんなさい。",
            "zh": "真的对不起。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "874/TALK",
            "narrator": "透明神楽",
            "text": "だけど。",
            "zh": "但是。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "875/TALK",
            "narrator": "透明神楽",
            "text": "私はあなたのことが\n大好きです。",
            "zh": "我\n最喜欢你。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "876/TALK",
            "narrator": "透明神楽",
            "text": "つばめさんのことが\n大好きなんです。",
            "zh": "最喜欢\n燕了。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "877/TALK",
            "narrator": "透明つばめ",
            "text": "わたしも。",
            "zh": "我也是。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "878/TALK",
            "narrator": "透明つばめ",
            "text": "神楽ちゃんのことが\n大好きだよ。",
            "zh": "我最喜欢\n神乐啦。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "879/TALK",
            "narrator": "透明つばめ",
            "text": "だから――",
            "zh": "所以——",
            "narrator_zh": "透明燕"
        },
        {
            "location": "882/TALK",
            "narrator": "透明神楽",
            "text": "！",
            "zh": "！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "894/DIALOG",
            "narrator": "Dialog_chapter_ch01",
            "text": "【MV EXE_MiYABi】",
            "zh": "【MV EXE_MiYABi】",
            "narrator_zh": "Dialog_chapter_ch01"
        }
    ]
}
