            "narrator_zh": "燕"
        },
        {
            "location": "731/TALK",
            "narrator": "つばめ",
            "text": "一応ね",
            "zh": "算是啦",
            "narrator_zh": "燕"
        },
        {
            "location": "736/SEL",
            "narrator": "",
            "text": "大変みたいだけど",
            "zh": "看起来很严重",
            "narrator_zh": ""
        },
        {
            "location": "737/SEL",
            "narrator": "",
            "text": "話できてよかった",
            "zh": "能说上话太好了",
            "narrator_zh": ""
        },
        {
            "location": "738/SEL",
            "narrator": "",
            "text": "うれしくて泣きそう",
            "zh": "高兴得快哭了",
            "narrator_zh": ""
        },
        {
            "location": "739/ACT",
            "narrator": "",
            "text": "大変みたいだけど",
            "zh": "看起来很严重",
            "narrator_zh": ""
        },
        {
            "location": "740/TALK",
