{
    "dir": "chap19/daydra/dd_ch03_19_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "19302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "気にしすぎの戦＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "过于在意之战＜前篇＞"
    },
    "entry": [
        {
            "location": "30/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、二人の\n様子はどう？",
            "zh": "加维，她们俩\n那边什么情况？",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "狙撃から隠れようと\nしてるみたい。",
            "zh": "好像正试着躲避\n我的狙击呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、なってないわ。\nここからなら問題なく\n当てられるし。",
            "zh": "不过，完全不到家啊。\n从我这个位置打过去\n照样轻松命中。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…、やっぱり\nまだ経験が浅いわね。",
            "zh": "唉……，果然\n经验还是太浅了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "どうする？\nもう撃って終わらせ\nちゃう？",
            "zh": "怎么办？\n干脆现在开枪\n解决掉她们吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "アーヤ",
            "text": "今はいいわ。\nどう動くのか、\nちょっと興味あるし。",
            "zh": "先不用。\n我倒有点好奇，\n她们接下来会怎么行动。",
            "narrator_zh": "绫水"
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ、そうね…。",
            "zh": "呼呼，也是呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "模擬戦とはいえ、\nアーヤと二人だけで\nコンビ組むなんて。",
            "zh": "虽说是模拟战，\n能跟绫水单独两个人\n搭档作战什么的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "入隊した最初の頃\nみたい。",
            "zh": "简直就像刚入队\n那会儿一样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびやつばめ達が\n入ってからは\n減っちゃったもの。",
            "zh": "自从雅和燕她们\n加入之后，这种机会\n就少了很多嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "46/TALK",
            "narrator": "ガブリエラ",
            "text": "久しぶりで\nなんかちょっと\nうれしい…。",
            "zh": "久违地来这么一次，\n总觉得还有点\n小开心……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "49/TALK",
            "narrator": "アーヤ",
            "text": "あっ、動いた！\nギャヴィ！",
            "zh": "啊，动了！\n加维！",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "…え？",
            "zh": "……哎？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "牽制射撃！\nぼーっとしてないで！",
            "zh": "牵制射击！\n别发呆了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、ご、ごめん！",
            "zh": "啊，抱、抱歉！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと、あんた達！\nふざけてるんじゃ\nないでしょうね！？",
            "zh": "我说你们几个！\n该不会是在\n偷懒耍滑吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/TALK",
            "narrator": "つばめ",
            "text": "ま、真面目だよ！\n訓練だもん、\nふざけてやらないよ。",
            "zh": "我、我很认真的呀！\n这可是训练嘛，\n怎么会偷懒呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "だったら、どうして\n一回もあたし達に\n勝てないのよ？",
            "zh": "既然如此，那为什么\n你们连一次都\n赢不了我们啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん達が\n強過ぎるんだよぉ…。",
            "zh": "因为加布你们\n实在太强了呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "95/TALK",
            "narrator": "神楽",
            "text": "そうです。\nっていうか、\n狙撃はズルですよ！",
            "zh": "就是说啊。\n再说了，玩狙击\n根本就是犯规嘛！",
            "narrator_zh": "神乐"
        },
        {
            "location": "96/TALK",
            "narrator": "ガブリエラ",
            "text": "ズルくないわよ。\nこれがあたしの\nスタイルなんだから。",
            "zh": "哪里犯规了。\n这本来就是我的\n战斗风格嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\nそれに、つばめ。",
            "zh": "没错。\n而且，燕。",
            "narrator_zh": "绫水"
        },
        {
            "location": "100/TALK",
            "narrator": "アーヤ",
            "text": "実践では相手の\n攻撃方法は\n不明な時がある。",
            "zh": "实战中敌人的\n攻击方式往往是\n未知的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "101/TALK",
            "narrator": "アーヤ",
            "text": "だけど、ギャヴィは\n撃ってくるって、\nわかってるでしょ？",
            "zh": "但是在这里，你明知道\n加维会开枪狙击，\n对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "情報は有効活用する。\nそれも訓練のうちよ。",
            "zh": "有效利用已知情报，\n这也是训练的一环哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうことよ。",
            "zh": "就是这么回事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "つばめ",
            "text": "…有効活用って、\n例えばどんなの\nですか？",
            "zh": "……有效利用，\n具体是指什么样的\n做法呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "107/TALK",
            "narrator": "アーヤ",
            "text": "弾丸が自分に向かって\n飛んでくるのは\nわかってるでしょ。",
            "zh": "既然明知道子弹会\n朝自己这边飞过来，\n对吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "109/TALK",
            "narrator": "アーヤ",
            "text": "飛んできたところを\n弾き返す！",
            "zh": "那就趁它飞过来时\n直接弹回去！",
            "narrator_zh": "绫水"
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": "燕"
        },
        {
            "location": "112/TALK",
            "narrator": "つばめ",
            "text": "…あ、あの…わたし\n素手なんですけど…。",
            "zh": "……那、那个……我可是\n赤手空拳的呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "113/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、ギリギリで\n避けながら距離を\n詰めるとかかしら？",
            "zh": "那就，在千钧一发之际\n闪避开，同时一口气\n拉近距离怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "115/TALK",
            "narrator": "神楽",
            "text": "…もう、人間技じゃ\nない気がします。",
            "zh": "……感觉这已经不是\n人类能做到的技巧了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "116/TALK",
            "narrator": "アーヤ",
            "text": "コネクトした状態なら\nできなくないわよ。",
            "zh": "只要处于连接状态下，\n也不是做不到哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "117/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんも、\nそんなことできるの？",
            "zh": "加布你也能\n做到那种事吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしだったら\n避けないで撃ち落とす\nけどね。",
            "zh": "换成我的话，\n根本不用躲，直接开枪\n把子弹击落就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "121/TALK",
            "narrator": "神楽",
            "text": "…歴戦の勇士感が\n凄いですね…。",
            "zh": "……这股身经百战的\n老兵气场好惊人啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "…それ、年寄扱い\nされてるみたいで\n嫌なんだけど？",
            "zh": "……这话听着怎么像是\n在把我当老人家看待，\n真让人不爽呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "123/TALK",
            "narrator": "アーヤ",
            "text": "とりあえず、\n今日はこれくらいに\nしましょ。",
            "zh": "总之，\n今天的训练就先\n到这里吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "つばめ",
            "text": "えっ、いいんですか？\nまだこんなに早い\n時間なのに…。",
            "zh": "哎，可以吗？\n时间明明还\n这么早呢……。",
            "narrator_zh": "燕"
        },
        {
            "location": "125/TALK",
            "narrator": "アーヤ",
            "text": "館長からそうする\nように言われてるの。",
            "zh": "馆长特地吩咐过\n要这么安排的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "だから、今日の訓練は\nここまで。\nあとは自由時間よ。",
            "zh": "所以，今天的训练\n到此结束。\n接下来是自由时间。",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "つばめ",
            "text": "やったー！",
            "zh": "太好啦—！",
            "narrator_zh": "燕"
        },
        {
            "location": "129/TALK",
            "narrator": "つばめ",
            "text": "それじゃ、\nひなこちゃん達と\n遊びに行こうかな？",
            "zh": "那我就去找\n雏子她们\n一起玩吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "あら？　向こうも\n今日はお休みなの？",
            "zh": "哎呀？她们那边\n今天也休息吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "131/TALK",
            "narrator": "神楽",
            "text": "そうみたいです。",
            "zh": "好像是这样。",
            "narrator_zh": "神乐"
        },
        {
            "location": "132/TALK",
            "narrator": "神楽",
            "text": "だから、訓練が早めに\n終わったら遊びに行こう\nって話してたんです。",
            "zh": "所以之前就说好了，\n要是训练早早结束，\n就一起去玩来着。",
            "narrator_zh": "神乐"
        },
        {
            "location": "133/TALK",
            "narrator": "アーヤ",
            "text": "日向さん達って、\n確か合宿の前半に\n帰るんだったかしら？",
            "zh": "日向她们，\n记得是不是合宿前半程\n就要先回去了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "135/TALK",
            "narrator": "つばめ",
            "text": "そうなんです。",
            "zh": "是的呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんもどう？\n一緒に遊び行こうよ。",
            "zh": "加布你也一起来吗？\n大家一起去玩嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "パスするわ。\nのんびり体を\n休めたいし。",
            "zh": "我就不去了。\n我想悠闲地\n休息一下身体。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "つばめ",
            "text": "そっか…。\nそれじゃ、わたし達は\nこれで。",
            "zh": "这样啊……。\n那，我们就先\n走啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "141/TALK",
            "narrator": "アーヤ",
            "text": "お疲れさま。\n楽しんできてね。",
            "zh": "辛苦了。\n玩得开心哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "144/TALK",
            "narrator": "神楽",
            "text": "お疲れさまでした。",
            "zh": "辛苦了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "152/TALK",
            "narrator": "アーヤ",
            "text": "…さてと。\n帰る前に片づけを\nしないと…。",
            "zh": "……好了。\n回去之前得先把这边\n收拾一下……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "手伝う？",
            "zh": "要帮忙吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "155/TALK",
            "narrator": "アーヤ",
            "text": "すぐ終わるから\nいいわよ。",
            "zh": "很快就能弄完，\n不用麻烦了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "157/TALK",
            "narrator": "ガブリエラ",
            "text": "あっそ…。",
            "zh": "哦，这样啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "160/TALK",
            "narrator": "ガブリエラ",
            "text": "…そういえばさ、\n明日の訓練も模擬戦\nやるんだっけ？",
            "zh": "……说起来，\n明天的训练也是\n安排模拟战来着吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "161/TALK",
            "narrator": "アーヤ",
            "text": "ええ、予定では\nそうなってるわ。",
            "zh": "嗯，按计划是\n这么安排的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "そっか…。",
            "zh": "这样啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "164/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、明日も\n一緒に組めるのね。",
            "zh": "那明天我们\n也能继续搭档了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめ達を\n教育してあげないと\nいけなしね。",
            "zh": "不好好给燕她们\n上一课\n可不行呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "166/TALK",
            "narrator": "アーヤ",
            "text": "そうね…。\nもうちょっと、\n形にしたいし…。",
            "zh": "是啊……。\n也想让她们再稍微\n像点样子……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "167/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ、楽しみね。",
            "zh": "呼呼，真让人期待呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/TALK",
            "narrator": "アーヤ",
            "text": "ん？　そうね。",
            "zh": "嗯？是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "170/TALK",
            "narrator": "アーヤ",
            "text": "…ん？　何？",
            "zh": "……嗯？怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "171/TALK",
            "narrator": "ガブリエラ",
            "text": "…別に。",
            "zh": "……没什么。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "？　ならいいけど…。",
            "zh": "？那就好……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "176/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "まったくダメよね？",
            "zh": "真是完全不行对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤは",
            "zh": "绫水她啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "191/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "“是啊”",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "だけで済ませるんだもの",
            "zh": "光凭这一句话就把我打发了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "194/SEL",
            "narrator": "",
