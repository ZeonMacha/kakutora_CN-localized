    "entry": [
        {
            "location": "2690/SCENARIO",
            "narrator": "",
            "text": "ギフテッド",
            "zh": "天赋者",
            "narrator_zh": ""
        },
        {
            "location": "2715/TALK",
            "narrator": "神楽",
            "text": "天賦の才",
            "zh": "天赋之才",
            "narrator_zh": "神乐"
        },
        {
            "location": "2716/TALK",
            "narrator": "神楽",
            "text": "特別な才能なんて",
            "zh": "所谓的特别才能",
            "narrator_zh": "神乐"
        },
        {
            "location": "2717/TALK",
            "narrator": "神楽",
            "text": "生まれた時に決まってて",
            "zh": "在出生时就已经决定了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2718/TALK",
            "narrator": "神楽",
            "text": "ううん",
            "zh": "不是的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2719/TALK",
            "narrator": "神楽",
            "text": "生まれる前に決まってて",
            "zh": "是在出生前就已经决定了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2720/TALK",
            "narrator": "神楽",
            "text": "この世界で天賦の才を持っているのは",
            "zh": "在这个世界里拥有天赋之才的是",
            "narrator_zh": "神乐"
        },
        {
            "location": "2721/TALK",
            "narrator": "神楽",
            "text": "きっとつばめさんだけ",
            "zh": "一定只有燕",
            "narrator_zh": "神乐"
        },
        {
            "location": "2723/SEL",
            "narrator": "",
            "text": "まさかそんな",
            "zh": "怎么可能嘛",
            "narrator_zh": ""
        },
        {
            "location": "2724/SEL",
            "narrator": "",
            "text": "フレイメノウは才能でしょ",
            "zh": "FreyMENOW是靠才能的吧",
            "narrator_zh": ""
        },
        {
            "location": "2725/SEL",
            "narrator": "",
            "text": "神楽に$me$がメロメロなのも才能",
            "zh": "神乐把$me$迷得神魂颠倒也是种才能",
            "narrator_zh": ""
        },
        {
            "location": "2726/ACT",
            "narrator": "",
            "text": "まさかそんな",
            "zh": "怎么可能嘛",
            "narrator_zh": ""
        },
        {
            "location": "2727/TALK",
            "narrator": "神楽",
            "text": "実際そうでしょ",
            "zh": "实际上就是那样吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "2728/ACT",
            "narrator": "",
            "text": "フレイメノウは才能でしょ",
            "zh": "FreyMENOW是靠才能的吧",
            "narrator_zh": ""
        },
        {
            "location": "2729/TALK",
            "narrator": "神楽",
            "text": "あれは努力と運",
            "zh": "那个靠的是努力和运气",
            "narrator_zh": "神乐"
        },
        {
            "location": "2730/ACT",
            "narrator": "",
            "text": "神楽に$me$がメロメロなのも才能",
            "zh": "神乐把$me$迷得神魂颠倒也是种才能",
            "narrator_zh": ""
        },
        {
            "location": "2731/TALK",
            "narrator": "神楽",
            "text": "騙されちゃう$handle$はかわいいひと",
            "zh": "这么容易被骗的$handle$真是个可爱的人",
            "narrator_zh": "神乐"
        },
        {
            "location": "2732/TALK",
            "narrator": "神楽",
            "text": "だいすきよ",
            "zh": "最喜欢你了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2734/TALK",
            "narrator": "神楽",
            "text": "この世界を作ったのはつばめさん",
            "zh": "创造这个世界的是燕",
            "narrator_zh": "神乐"
        },
        {
            "location": "2735/TALK",
            "narrator": "神楽",
            "text": "そんなことができる人間なんて他にいない",
            "zh": "能做那种事的人没有第二个",
            "narrator_zh": "神乐"
        },
        {
            "location": "2736/TALK",
            "narrator": "神楽",
            "text": "そういう意味ではまさに選ばれた人間",
            "zh": "那个意义上，正是被选中的人",
            "narrator_zh": "神乐"
        },
        {
            "location": "2738/SEL",
            "narrator": "",
            "text": "だったらやっぱり神楽が最強",
            "zh": "那果然还是神乐最强",
            "narrator_zh": ""
        },
        {
            "location": "2739/SEL",
            "narrator": "",
            "text": "そういうことになるのかなー…",
            "zh": "会变成这样吗——…",
            "narrator_zh": ""
        },
        {
            "location": "2740/SEL",
            "narrator": "",
            "text": "特殊事例すぎない？",
            "zh": "是不是太特殊了点？",
            "narrator_zh": ""
        },
        {
            "location": "2741/ACT",
            "narrator": "",
            "text": "だったらやっぱり神楽が最強",
            "zh": "那果然还是神乐最强",
            "narrator_zh": ""
        },
        {
            "location": "2742/TALK",
            "narrator": "神楽",
            "text": "そうなるの？",
            "zh": "会变成那样吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2743/TALK",
            "narrator": "神楽",
            "text": "うーん、、、",
            "zh": "嗯……",
            "narrator_zh": "神乐"
        },
        {
            "location": "2744/ACT",
            "narrator": "",
            "text": "そういうことになるのかなー…",
            "zh": "会变成这样吗——…",
            "narrator_zh": ""
        },
        {
            "location": "2745/TALK",
            "narrator": "神楽",
            "text": "そうじゃない？",
            "zh": "不是吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2746/TALK",
            "narrator": "神楽",
            "text": "どうかな？",
            "zh": "怎么样？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2747/ACT",
            "narrator": "",
            "text": "特殊事例すぎない？",
            "zh": "是不是太特殊了点？",
            "narrator_zh": ""
        },
        {
            "location": "2748/TALK",
            "narrator": "神楽",
            "text": "それは当たり前",
            "zh": "那是理所当然",
            "narrator_zh": "神乐"
        },
        {
            "location": "2749/TALK",
            "narrator": "神楽",
            "text": "選ばれた時点で特殊なんだぴょん",
            "zh": "被选中的那一刻就已经很特殊了pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "2751/TALK",
            "narrator": "神楽",
            "text": "どうあがいても、どうにもならないことってあるよね",
            "zh": "不管怎么挣扎，总有些事是没办法的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2752/TALK",
            "narrator": "神楽",
            "text": "あなたが隣にいてくれないこととか",
            "zh": "比如你没办法陪在我身边之类的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2753/SEL",
            "narrator": "",
            "text": "それ$me$も同じだしキッツイからやめて",
            "zh": "那个$me$也一样，太扎心了，别说了",
            "narrator_zh": ""
        },
        {
            "location": "2754/TALK",
            "narrator": "神楽",
            "text": "でもあの子はやれてしまうと思う",
            "zh": "不过我觉得那孩子做得到",
            "narrator_zh": "神乐"
        },
        {
            "location": "2755/TALK",
            "narrator": "神楽",
            "text": "そこには月とすっぽんほどの差がある",
            "zh": "那里有天壤之别",
            "narrator_zh": "神乐"
        },
        {
            "location": "2758/ACT",
            "narrator": "",
            "text": "それ$me$も同じだしキッツイからやめて",
            "zh": "那个$me$也一样，太扎心了，别说了",
            "narrator_zh": ""
        },
        {
            "location": "2759/TALK",
            "narrator": "神楽",
            "text": "じゃあおんなじ",
            "zh": "那不就一样嘛",
            "narrator_zh": "神乐"
        },
        {
            "location": "2760/TALK",
            "narrator": "神楽",
            "text": "私はそういうのをうやむやにしたくない",
            "zh": "我不想把那种事含糊带过",
            "narrator_zh": "神乐"
        },
        {
            "location": "2761/TALK",
            "narrator": "神楽",
            "text": "だから敢えて言う",
            "zh": "所以我才特意说",
            "narrator_zh": "神乐"
        },
        {
            "location": "2762/TALK",
            "narrator": "神楽",
            "text": "少なくとも今は逢えないし、今後もその見込みは立ってない",
            "zh": "至少现在见不到，今后也看不到能见面的希望",
            "narrator_zh": "神乐"
        },
        {
            "location": "2763/TALK",
            "narrator": "神楽",
            "text": "それは事実",
            "zh": "那是事实",
            "narrator_zh": "神乐"
        },
        {
            "location": "2764/TALK",
            "narrator": "神楽",
            "text": "それをうやむやにしたら、私が貴方をこんなにも",
            "zh": "要是把那个含糊过去，我这么",
            "narrator_zh": "神乐"
        },
        {
            "location": "2765/TALK",
            "narrator": "神楽",
            "text": "息が詰まるほどに切ないこの気持ちもまた全部、うやむやにしなければならなくなる",
            "zh": "就连我这股痛苦到快喘不过气的思念，也全都得跟着一并含糊过去了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2767/SEL",
            "narrator": "",
            "text": "神楽のそういうところ好きだよ",
            "zh": "神乐这种地方，我喜欢",
            "narrator_zh": ""
        },
        {
            "location": "2768/SEL",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "2769/SEL",
            "narrator": "",
            "text": "面倒くさいなぁ",
            "zh": "真麻烦啊",
            "narrator_zh": ""
        },
        {
            "location": "2770/ACT",
            "narrator": "",
            "text": "神楽のそういうところ好きだよ",
            "zh": "神乐这种地方，我喜欢",
            "narrator_zh": ""
        },
        {
            "location": "2771/TALK",
            "narrator": "神楽",
            "text": "私はそんなに好きじゃないかな",
            "zh": "我自己倒没那么喜欢啦",
            "narrator_zh": "神乐"
        },
        {
            "location": "2772/TALK",
            "narrator": "神楽",
            "text": "もっとなーなーに生きたい",
            "zh": "真想活得更随随便便一点",
            "narrator_zh": "神乐"
        },
        {
            "location": "2773/TALK",
            "narrator": "神楽",
            "text": "できるならね",
            "zh": "要是能做到的话呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "2774/ACT",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "2775/ACT",
            "narrator": "",
            "text": "面倒くさいなぁ",
            "zh": "真麻烦啊",
            "narrator_zh": ""
        },
        {
            "location": "2776/TALK",
            "narrator": "神楽",
            "text": "じゃあ別れよっか",
            "zh": "那我们分手吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "2777/TALK",
            "narrator": "神楽",
            "text": "なんて",
            "zh": "之类的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2779/TALK",
            "narrator": "神楽",
            "text": "$handle$のそういう歯に衣着せぬところ好き",
            "zh": "我喜欢$handle$这种说话不绕弯的地方",
            "narrator_zh": "神乐"
        },
        {
            "location": "2780/TALK",
            "narrator": "神楽",
            "text": "だって、表裏無いってことじゃない？",
            "zh": "因为，那不就是表里如一吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2782/TALK",
            "narrator": "神楽",
            "text": "裏を考えなくていいから気が楽",
            "zh": "不用去猜背后有什么心思，感觉很轻松",
            "narrator_zh": "神乐"
        },
        {
            "location": "2787/TALK",
            "narrator": "神楽",
            "text": "それでね、",
            "zh": "然后呢，",
            "narrator_zh": "神乐"
        },
        {
            "location": "2788/TALK",
            "narrator": "神楽",
            "text": "あれから色々考えた",
            "zh": "从那之后我想了很多",
            "narrator_zh": "神乐"
        },
        {
            "location": "2790/SEL",
            "narrator": "",
            "text": "あれからって？",
            "zh": "你说从那之后？",
            "narrator_zh": ""
        },
        {
            "location": "2791/SEL",
            "narrator": "",
            "text": "もう死ぬなんて言わないで",
            "zh": "别说要死这种话",
            "narrator_zh": ""
        },
        {
            "location": "2792/ACT",
            "narrator": "",
            "text": "あれからって？",
            "zh": "你说从那之后？",
            "narrator_zh": ""
        },
        {
            "location": "2793/TALK",
            "narrator": "神楽",
            "text": "前に送ったボイメから",
            "zh": "从上次发给你的语音信箱那会儿起",
            "narrator_zh": "神乐"
        },
        {
            "location": "2794/ACT",
            "narrator": "",
            "text": "もう死ぬなんて言わないで",
            "zh": "别说要死这种话",
            "narrator_zh": ""
        },
        {
            "location": "2797/TALK",
            "narrator": "神楽",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "神乐"
        },
        {
            "location": "2799/TALK",
            "narrator": "神楽",
            "text": "ぴょんこは端から見ると、すごく不幸な境遇かもしれない",
            "zh": "从旁人眼里看来，蹦子的处境或许非常不幸",
            "narrator_zh": "神乐"
        },
        {
            "location": "2800/TALK",
            "narrator": "神楽",
            "text": "でも、別の人が見たら、恵まれてるって思うかも",
            "zh": "不过，别人看了也许会觉得我很幸福",
            "narrator_zh": "神乐"
        },
        {
            "location": "2801/TALK",
            "narrator": "神楽",
            "text": "すごく極端な気がするぴょん",
            "zh": "感觉真是非常极端pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "2802/TALK",
            "narrator": "神楽",
            "text": "ぴょんこがつばめさんと同じ魔法の力を持っていたら",
            "zh": "如果蹦子也拥有和燕一样的魔法力量",
            "narrator_zh": "神乐"
        },
        {
            "location": "2803/TALK",
            "narrator": "神楽",
            "text": "ぴょんこはもっと幸せになるかもしれないし、破滅を呼び込むかもしれない",
            "zh": "蹦子也许会变得更幸福，也说不定会招来毁灭",
            "narrator_zh": "神乐"
        },
        {
            "location": "2804/TALK",
            "narrator": "神楽",
            "text": "だから、結局の所、今の自分が一番なんだって思った",
            "zh": "所以，到头来，我觉得现在的自己最好",
            "narrator_zh": "神乐"
        },
        {
            "location": "2805/TALK",
            "narrator": "神楽",
            "text": "そう考えるとね",
            "zh": "这么一想呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "2806/TALK",
            "narrator": "神楽",
            "text": "$handle$が一緒にいてくれることも",
            "zh": "还有$handle$陪着我的时候",
            "narrator_zh": "神乐"
        },
        {
            "location": "2807/TALK",
            "narrator": "神楽",
            "text": "$handle$に逢えないことも",
            "zh": "见不到$handle$这件事",
            "narrator_zh": "神乐"
        },
        {
            "location": "2808/TALK",
            "narrator": "神楽",
            "text": "凄く幸せなことなんじゃないかな",
            "zh": "是不是一件非常幸福的事呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "2810/SEL",
            "narrator": "",
            "text": "逢えないのに？",
            "zh": "明明见不到面？",
            "narrator_zh": ""
        },
        {
            "location": "2811/SEL",
            "narrator": "",
            "text": "なんかわかる",
            "zh": "我好像懂",
            "narrator_zh": ""
        },
        {
            "location": "2812/ACT",
            "narrator": "",
            "text": "逢えないのに？",
            "zh": "明明见不到面？",
            "narrator_zh": ""
        },
        {
            "location": "2813/TALK",
            "narrator": "神楽",
            "text": "逢えないから、じゃなくて",
            "zh": "不是因为见不到面",
            "narrator_zh": "神乐"
        },
        {
            "location": "2814/TALK",
            "narrator": "神楽",
            "text": "逢えないことが、結果的に幸せに繋がってるって考え方もあるかなってこと",
            "zh": "而是觉得“正因为见不到面，结果反而通向了幸福”，也可以这样去想",
            "narrator_zh": "神乐"
        },
        {
            "location": "2815/ACT",
            "narrator": "",
            "text": "なんかわかる",
            "zh": "我好像懂",
            "narrator_zh": ""
        },
        {
            "location": "2816/TALK",
            "narrator": "神楽",
            "text": "ふふふー、ほんとー？",
            "zh": "呵呵呵——，真的吗——？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2818/TALK",
            "narrator": "神楽",
            "text": "世の中には、いつも一緒にいても不幸な二人っている",
            "zh": "这世上也有虽然总是待在一起却依然不幸的一对",
            "narrator_zh": "神乐"
        },
        {
            "location": "2819/TALK",
            "narrator": "神楽",
            "text": "逢えない私たちは、共に逢いたいって気持ちでお互いを支え合って",
            "zh": "无法相见的我们，怀着共同想见面的心情互相扶持",
            "narrator_zh": "神乐"
        },
        {
            "location": "2820/TALK",
            "narrator": "神楽",
            "text": "逢えない分だけ、いっぱい、いっぱい、めいっっっっぱい、愛を囁き合う",
            "zh": "正因为见不到，才要多多地、多多地、拼尽全力地互相倾诉爱语",
            "narrator_zh": "神乐"
        },
        {
            "location": "2821/TALK",
            "narrator": "神楽",
            "text": "いつか逢える日を目指して、頑張って生きていく",
            "zh": "以有朝一日能相见的那天为目标，努力活下去",
            "narrator_zh": "神乐"
        },
        {
            "location": "2822/TALK",
