{
    "dir": "chap00/daydra/spev_ch02_007.js",
    "type": "",
    "info": {
        "story_id": "2007",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "神楽ちゃんとお菓子作り",
        "title_zh": "特别篇",
        "sub_title_zh": "和神乐一起做点心"
    },
    "entry": [
        {
            "location": "32/TALK",
            "narrator": "透明アーヤ",
            "text": "…それにしても、\nまさかお菓子作りだった\nなんて。",
            "zh": "……话说回来，\n没想到竟然是\n做点心。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "透明神楽",
            "text": "はい？",
            "zh": "嗯？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "34/TALK",
            "narrator": "透明アーヤ",
            "text": "卯月、家デートがしたい\nって言ってたでしょ？",
            "zh": "卯月说想在家里约会，\n对吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "透明アーヤ",
            "text": "だから、何しようと\n思ってるのか\n不安だったのよ…。",
            "zh": "所以，她到底\n想做什么，\n我有点不安……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "36/TALK",
            "narrator": "透明神楽",
            "text": "アーヤさん…、\nわたしをどんな目で\n見ているんですか？",
            "zh": "绫水……\n你是用什么样的眼神\n在看我？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "37/TALK",
            "narrator": "透明アーヤ",
            "text": "ま、まあ、今は作業に\n集中しましょ。",
            "zh": "不、不过，现在先\n集中做事吧。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "透明アーヤ",
            "text": "次は何をすれば\nいいかしら？",
            "zh": "接下来该做什么\n呢？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "透明神楽",
            "text": "えっと…あれ？\n確かこの次は…。",
            "zh": "那个……咦？\n记得接下来是……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "41/TALK",
            "narrator": "透明神楽",
            "text": "レシピ確認しますから、\nちょっと休んでて\nください。",
            "zh": "我确认一下食谱，\n你先稍微\n休息一下。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "42/TALK",
            "narrator": "透明アーヤ",
            "text": "…卯月、このお菓子は\n作ったことあるって\n言ってなかった？",
            "zh": "……卯月，这个点心\n你不是说过\n做过吗？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "透明神楽",
            "text": "ありますけど、\nまだ三回目くらいしか\n作ったことなくて…。",
            "zh": "做过是做过，\n大概也才第三次\n做……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "45/TALK",
            "narrator": "透明神楽",
            "text": "アーヤさんの方は、\nお菓子作りって\n普段はしないんですか？",
            "zh": "绫水平时\n不做点心\n吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "46/TALK",
            "narrator": "透明アーヤ",
            "text": "しないわ。\n最後に作ったのは\n多分…調理実習かしら？",
            "zh": "不做。\n最后一次做，\n大概是……烹饪课吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "透明神楽",
            "text": "…もしかして、\nあんまり自分で作るの、\n興味ありませんでした？",
            "zh": "……难道，\n自己动手做，\n你不怎么感兴趣？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "48/TALK",
            "narrator": "透明アーヤ",
            "text": "ううん、\nそんなことないわ。",
            "zh": "不，\n没有那种事。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "透明アーヤ",
            "text": "自分でも作ってみたいと\n思ってはいたんだけど。",
            "zh": "我也想过\n自己试着做做。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "51/TALK",
            "narrator": "透明アーヤ",
            "text": "難しそうだったから、\nなんとなく避けてて…。",
            "zh": "看起来很难，\n就不知不觉避开了……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "透明神楽",
            "text": "そうだったんですか。",
            "zh": "是这样啊。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "53/TALK",
            "narrator": "透明アーヤ",
            "text": "ええ…だから今、\nとっても楽しませて\nもらってるわ。",
            "zh": "嗯……所以现在，\n我玩得\n非常开心。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "透明神楽",
            "text": "よかったぁ…。\nそれじゃあデート\n大成功ですね！",
            "zh": "太好了……\n那这次约会\n大成功了！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "55/TALK",
            "narrator": "透明アーヤ",
            "text": "このお菓子がちゃんと\n作れたらね…。\nそれで、レシピの方は？",
            "zh": "等这个点心\n好好做成了再说……\n那么，食谱那边呢？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "56/TALK",
            "narrator": "透明神楽",
            "text": "はい、確認しました。\n次は生クリームの\n泡立てですね。",
            "zh": "嗯，确认过了。\n接下来是打发\n鲜奶油。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "57/TALK",
            "narrator": "透明アーヤ",
            "text": "それなら、私がやるわ。",
            "zh": "那我来。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "透明神楽",
            "text": "え、大丈夫ですか？\n泡立てって、\n結構コツいりますけど…。",
            "zh": "诶，没问题吗？\n打发的话，\n还挺需要诀窍的……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "60/TALK",
            "narrator": "透明アーヤ",
            "text": "かき混ぜればいいのよね？\nそれくらいなら簡単よ。",
            "zh": "搅拌就行了吧？\n那种程度很简单。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "透明神楽",
            "text": "…わかりました。\nそれじゃお願いしますね。",
            "zh": "……知道了。\n那就拜托你了。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "62/TALK",
            "narrator": "透明アーヤ",
            "text": "じゃ、早速始めるわ。",
            "zh": "那，马上开始。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "透明アーヤ",
            "text": "あ、あら？\n意外と難しいかも…。",
            "zh": "啊、哎呀？\n可能意外地难……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "68/TALK",
            "narrator": "透明神楽",
            "text": "アーヤさん、泡だて器は\n軽く握ってください。",
            "zh": "绫水，打蛋器\n请轻轻握住。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "70/TALK",
            "narrator": "透明アーヤ",
            "text": "こ、こうかしら？",
            "zh": "是、是这样吗？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "透明神楽",
            "text": "そうです。\n少し泡が立つまで、\nかき回してください。",
            "zh": "对。\n请搅到\n稍微起泡。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "74/TALK",
            "narrator": "透明アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "透明神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "76/TALK",
            "narrator": "透明アーヤ",
            "text": "…意外と時間かかるのね。",
            "zh": "……意外地花时间。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "77/TALK",
            "narrator": "透明神楽",
            "text": "そうなんですよ…。\nお菓子作りって、\n意外と大変なんですよ？",
            "zh": "就是这样……\n做点心，\n意外地费事吧？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "78/TALK",
            "narrator": "透明神楽",
            "text": "…っていうか、\nまた力入れてませんか？",
            "zh": "……话说，\n你是不是又用力了？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "79/TALK",
            "narrator": "透明アーヤ",
            "text": "軽く握るっていうのが、\nどうも難しくて…。",
            "zh": "轻轻握住这件事，\n怎么说都很难……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "透明アーヤ",
            "text": "…ごめんなさい。\nちょっと私のやり方で\nかき混ぜるわ。",
            "zh": "……对不起。\n我用自己的方式\n搅一下。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "81/TALK",
            "narrator": "透明神楽",
            "text": "え？　ちょ、アーヤさん！\nボウル抱えながら\n強く混ぜたら！",
            "zh": "诶？等、绫水！\n抱着搅拌碗\n那么用力搅的话！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "87/TALK",
            "narrator": "透明アーヤ",
            "text": "うん、やっぱりこの方が\nやりやすいわ。",
            "zh": "嗯，果然这样\n更好做。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "透明神楽",
            "text": "あ、アーヤさん。\nちょっと作り方が\n豪快過ぎるような…。",
            "zh": "啊，绫水。\n做法好像有点\n太豪迈了……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "89/TALK",
            "narrator": "透明アーヤ",
            "text": "でも見て。\nちゃんと泡が立って\nきたわ。",
            "zh": "可是你看。\n好好起泡\n了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "透明アーヤ",
            "text": "このまま続ければ――",
            "zh": "再这样继续的话——",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "98/TALK",
            "narrator": "透明アーヤ",
            "text": "きゃあっ！？",
            "zh": "呀啊！？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "101/TALK",
            "narrator": "透明神楽",
            "text": "ああっ、やっぱり…。",
            "zh": "啊啊，果然……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "102/TALK",
            "narrator": "透明アーヤ",
            "text": "あちゃー…、顔も服も\nベタベタ…。",
            "zh": "哎呀……脸和衣服\n都黏糊糊的……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "透明神楽",
            "text": "そうですね…ふふっ。",
            "zh": "是啊……呵呵。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "105/TALK",
            "narrator": "透明アーヤ",
            "text": "ちょっと、卯月。\n笑わなくてもいいでしょ？",
            "zh": "等一下，卯月。\n不用笑吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "106/TALK",
            "narrator": "透明神楽",
            "text": "ふふっ、ごめんなさい…。",
            "zh": "呵呵，对不起……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "107/TALK",
            "narrator": "透明神楽",
            "text": "でも、アーヤさんが\nこんなに可愛らしい\n失敗するなんて…。",
            "zh": "可是，绫水\n会失败得这么可爱，\n真是……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "108/TALK",
            "narrator": "透明神楽",
            "text": "ちょっと意外だな、って\n思っちゃって。",
            "zh": "有点意外，\n我就想了。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "109/TALK",
            "narrator": "透明アーヤ",
            "text": "慣れてないんだから、\n仕方ないでしょ？",
            "zh": "我不熟练，\n也没办法吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "110/TALK",
            "narrator": "透明アーヤ",
            "text": "でも、今度こそは\n上手くやるわ。",
            "zh": "不过，这次一定\n会做好。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "111/TALK",
            "narrator": "透明神楽",
            "text": "そうですね。\nでもその前に…。",
            "zh": "是啊。\n不过在那之前……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "113/TALK",
            "narrator": "透明神楽",
            "text": "ボウルを置いて、\n力を抜いてからに\nしてくださいね？",
            "zh": "请先放下搅拌碗，\n把力气卸掉\n再来，好吗？",
            "narrator_zh": "透明神乐"
        }
    ]
}
