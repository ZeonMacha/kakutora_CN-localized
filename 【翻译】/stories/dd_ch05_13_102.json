{
    "dir": "chap13/daydra/dd_ch05_13_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "13505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "クリエイターズハイ＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "创作者的亢奋＜后篇＞"
    },
    "entry": [
        {
            "location": "919/TALK",
            "narrator": "神楽",
            "text": "…ううっ。",
            "zh": "……唔嗯。",
            "narrator_zh": "神乐"
        },
        {
            "location": "920/TALK",
            "narrator": "神楽",
            "text": "やっぱり、入ろう。\n一日の疲れは寝る前に\n落としておきたいし。",
            "zh": "还是，去洗个澡吧。\n一天的疲劳想在睡前\n先卸下来再说。",
            "narrator_zh": "神乐"
        },
        {
            "location": "941/TALK",
            "narrator": "神楽",
            "text": "ふぅ…サッパリしたぁ。",
            "zh": "呼……好清爽啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "943/TALK",
            "narrator": "神楽",
            "text": "眠いの我慢して、\n思い切って入ってきて\n正解だったみたい。",
            "zh": "忍着困意，\n下决心去洗一洗\n看来是对的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "944/TALK",
            "narrator": "神楽",
            "text": "…さて、と。",
            "zh": "……那么。",
            "narrator_zh": "神乐"
        },
        {
            "location": "956/TALK",
            "narrator": "神楽",
            "text": "先ほどは大変お見苦しい姿を見せたようで",
            "zh": "刚才似乎让你看到了非常失态的一面",
            "narrator_zh": "神乐"
        },
        {
            "location": "957/TALK",
            "narrator": "神楽",
            "text": "忘れていただけると嬉しいです",
            "zh": "要是能请你忘掉的话我会很开心的",
            "narrator_zh": "神乐"
        },
        {
            "location": "960/SEL",
            "narrator": "",
            "text": "深夜テンションのこと？",
            "zh": "指的是深夜亢奋那事？",
            "narrator_zh": ""
        },
        {
            "location": "961/SEL",
            "narrator": "",
            "text": "なんのことだかさっぱり",
            "zh": "完全不知道在说什么哦",
            "narrator_zh": ""
        },
        {
            "location": "962/ACT",
            "narrator": "",
            "text": "深夜テンションのこと？",
            "zh": "指的是深夜亢奋那事？",
            "narrator_zh": ""
        },
        {
            "location": "963/TALK",
            "narrator": "神楽",
            "text": "どうか忘れてくださいお願いします",
            "zh": "拜托请一定要忘掉求你了",
            "narrator_zh": "神乐"
        },
        {
            "location": "965/ACT",
            "narrator": "",
            "text": "なんのことだかさっぱり",
            "zh": "完全不知道在说什么哦",
            "narrator_zh": ""
        },
        {
            "location": "966/TALK",
            "narrator": "神楽",
            "text": "それならいいんです",
            "zh": "那就再好不过了",
            "narrator_zh": "神乐"
        },
        {
            "location": "967/TALK",
            "narrator": "神楽",
            "text": "どうか気にしないで下さい",
            "zh": "请千万别放在心上",
            "narrator_zh": "神乐"
        },
        {
            "location": "969/TALK",
            "narrator": "神楽",
            "text": "とりあえず",
            "zh": "总之",
            "narrator_zh": "神乐"
        },
        {
            "location": "970/TALK",
            "narrator": "神楽",
            "text": "メノウのお仕事の方は一段落付いて",
            "zh": "MENOW的工作这边总算告一段落了",
            "narrator_zh": "神乐"
        },
        {
            "location": "971/TALK",
            "narrator": "神楽",
            "text": "お風呂も入ったし",
            "zh": "澡也洗好了",
            "narrator_zh": "神乐"
        },
        {
            "location": "972/TALK",
            "narrator": "神楽",
            "text": "とても気分がいいんです",
            "zh": "心情非常舒畅",
            "narrator_zh": "神乐"
        },
        {
            "location": "974/SEL",
            "narrator": "",
            "text": "それはよかった",
            "zh": "那就太好了",
            "narrator_zh": ""
        },
        {
            "location": "975/ACT",
            "narrator": "",
            "text": "それはよかった",
            "zh": "那就太好了",
            "narrator_zh": ""
        },
        {
            "location": "977/TALK",
            "narrator": "神楽",
            "text": "なので",
            "zh": "所以呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "978/TALK",
            "narrator": "神楽",
            "text": "これから絵を描こうと思ってるんです",
            "zh": "我打算接下来开始画画",
            "narrator_zh": "神乐"
        },
        {
            "location": "980/SEL",
            "narrator": "",
            "text": "寝るんじゃなかったの！？",
            "zh": "你不是要去睡觉了吗！？",
            "narrator_zh": ""
        },
        {
            "location": "981/SEL",
            "narrator": "",
            "text": "目が覚めちゃった？",
            "zh": "彻底清醒过来了？",
            "narrator_zh": ""
        },
        {
            "location": "982/ACT",
            "narrator": "",
            "text": "寝るんじゃなかったの！？",
            "zh": "你不是要去睡觉了吗！？",
            "narrator_zh": ""
        },
        {
            "location": "983/TALK",
            "narrator": "神楽",
            "text": "そう思ってたんですが",
            "zh": "原本是这么想的",
            "narrator_zh": "神乐"
        },
        {
            "location": "984/TALK",
            "narrator": "神楽",
            "text": "お風呂入ったら目が覚めちゃって",
            "zh": "可一洗完澡就睡意全无了",
            "narrator_zh": "神乐"
        },
        {
            "location": "985/ACT",
            "narrator": "",
            "text": "目が覚めちゃった？",
            "zh": "彻底清醒过来了？",
            "narrator_zh": ""
        },
        {
            "location": "987/TALK",
            "narrator": "神楽",
            "text": "さすが$handle$さん",
            "zh": "不愧是$handle$",
            "narrator_zh": "神乐"
        },
        {
            "location": "988/TALK",
            "narrator": "神楽",
            "text": "理解が早くて助かります",
            "zh": "理解得这么快真是帮大忙了",
            "narrator_zh": "神乐"
        },
        {
            "location": "990/TALK",
            "narrator": "神楽",
            "text": "それに歌詞を書いたんだから",
            "zh": "再说刚写完了歌词",
            "narrator_zh": "神乐"
        },
        {
            "location": "991/TALK",
            "narrator": "神楽",
            "text": "次は絵を描く",
            "zh": "接下来就画画",
            "narrator_zh": "神乐"
        },
        {
            "location": "992/TALK",
            "narrator": "神楽",
            "text": "これって当然じゃないですか？",
            "zh": "这不是很理所当然的吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "993/TALK",
            "narrator": "神楽",
            "text": "私は普通だと思いますよ！",
            "zh": "我觉得挺正常的哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "996/SEL",
            "narrator": "",
            "text": "落ち着いて、寝ようよ",
            "zh": "冷静点，快去睡吧",
            "narrator_zh": ""
        },
        {
            "location": "997/SEL",
            "narrator": "",
            "text": "いいね、力作待ってるよ！",
            "zh": "好啊，等着你的大作哦！",
            "narrator_zh": ""
        },
        {
            "location": "998/ACT",
            "narrator": "",
            "text": "落ち着いて、寝ようよ",
            "zh": "冷静点，快去睡吧",
            "narrator_zh": ""
        },
        {
            "location": "1000/TALK",
            "narrator": "神楽",
            "text": "そうですね",
            "zh": "说得也是",
            "narrator_zh": "神乐"
        },
        {
            "location": "1001/TALK",
            "narrator": "神楽",
            "text": "また恥ずかしいところをお見せしてしまったようで",
            "zh": "好像又让你看到了丢脸的一面",
            "narrator_zh": "神乐"
        },
        {
            "location": "1003/TALK",
            "narrator": "神楽",
            "text": "大人しく寝ることにします",
            "zh": "我还是乖乖去睡觉吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "1004/TALK",
            "narrator": "神楽",
            "text": "遅くまでありがとうございました",
            "zh": "谢谢你陪我到这么晚",
            "narrator_zh": "神乐"
        },
        {
            "location": "1005/TALK",
            "narrator": "神楽",
            "text": "おやすみなさい",
            "zh": "晚安",
            "narrator_zh": "神乐"
        },
        {
            "location": "1017/TALK",
            "narrator": "神楽",
            "text": "ふぁ～…、言ってたら\n本当に眠くなってきた…。",
            "zh": "哈啊～……，一这么说\n真的困起来了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1018/TALK",
            "narrator": "神楽",
            "text": "早く寝よう…。",
            "zh": "快点睡吧……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1022/TALK",
            "narrator": "透明神楽",
            "text": "…なにか、忘れてるような\n気もするけど。",
            "zh": "……总觉得好像\n忘了什么事一样。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "1027/TALK",
            "narrator": "透明神楽",
            "text": "う、うぅ～ん…。",
            "zh": "唔、唔～嗯……。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "1028/TALK",
            "narrator": "透明神楽",
            "text": "ふぁ～…、\nこんな早くに…誰？",
            "zh": "哈啊～……，\n这么一大早……谁啊？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "1041/TALK",
            "narrator": "神楽",
            "text": "はい、もしもし卯月です。",
            "zh": "喂，你好，我是卯月。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1042/TALK",
            "narrator": "神楽",
            "text": "…ああ、どうも。\nお疲れ様です。",
            "zh": "……啊啊，你好。\n辛苦了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1043/TALK",
            "narrator": "神楽",
            "text": "送った歌詞の方は…はい？",
            "zh": "发过去的歌词那边……嗯？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1045/TALK",
            "narrator": "神楽",
            "text": "あっ！！！！",
            "zh": "啊！！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1047/TALK",
            "narrator": "神楽",
            "text": "ま、まさか！\n忘れてなんかいませんよ。",
            "zh": "怎、怎么可能！\n我才没有忘掉呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1048/TALK",
            "narrator": "神楽",
            "text": "今、サビのフレーズで\nちょっと悩んでた\nだけでして…。",
            "zh": "刚才只是在副歌的词句上\n稍微纠结了一下\n而已……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1049/TALK",
            "narrator": "神楽",
            "text": "は、はい、大丈夫です！\nはい、失礼します！！",
            "zh": "是、是的，没问题！\n好的，先挂了！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1054/TALK",
            "narrator": "神楽",
            "text": "…ど、どうしよう。\nとんでもない\nミスしちゃったかも…。",
            "zh": "……怎、怎么办。\n搞不好犯了个\n不得了的失误……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1067/SEL",
            "narrator": "",
            "text": "どうかしたの？",
            "zh": "怎么了吗？",
            "narrator_zh": ""
        },
        {
            "location": "1068/ACT",
            "narrator": "",
            "text": "どうかしたの？",
            "zh": "怎么了吗？",
            "narrator_zh": ""
        },
        {
            "location": "1085/TALK",
            "narrator": "神楽",
            "text": "うっかりです",
            "zh": "一时疏忽了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1086/TALK",
            "narrator": "神楽",
            "text": "作詞をしなければいけない曲が",
            "zh": "本来必须作词的歌",
            "narrator_zh": "神乐"
        },
        {
            "location": "1087/TALK",
            "narrator": "神楽",
            "text": "もう一つあったことをすっかり忘れてて",
            "zh": "还有另外一首的事我给彻底忘光了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1091/TALK",
            "narrator": "神楽",
            "text": "とにかく",
            "zh": "总之",
            "narrator_zh": "神乐"
        },
        {
            "location": "1092/TALK",
            "narrator": "神楽",
            "text": "やれるところまでは急いでやらないと",
            "zh": "能赶多少得赶快先写出来才行",
            "narrator_zh": "神乐"
        },
        {
            "location": "1093/TALK",
            "narrator": "神楽",
            "text": "色んな人に迷惑かけちゃいますし",
            "zh": "不然会给好多人添麻烦的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1096/SEL",
            "narrator": "",
            "text": "神楽ならできる！！",
            "zh": "神乐的话肯定做得到的！！",
            "narrator_zh": ""
        },
        {
            "location": "1097/SEL",
            "narrator": "",
            "text": "メノウって、大変だね",
            "zh": "当MENOW还真是辛苦呢",
            "narrator_zh": ""
        },
        {
            "location": "1098/ACT",
            "narrator": "",
            "text": "神楽ならできる！！",
            "zh": "神乐的话肯定做得到的！！",
            "narrator_zh": ""
        },
        {
            "location": "1099/TALK",
            "narrator": "神楽",
            "text": "ありがとうございます",
            "zh": "谢谢你",
            "narrator_zh": "神乐"
        },
        {
            "location": "1100/TALK",
            "narrator": "神楽",
            "text": "それじゃあまたあとで！",
            "zh": "那就回头再聊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1101/ACT",
            "narrator": "",
            "text": "メノウって、大変だね",
            "zh": "当MENOW还真是辛苦呢",
            "narrator_zh": ""
        },
        {
            "location": "1102/TALK",
            "narrator": "神楽",
            "text": "大変ですよー",
            "zh": "很辛苦的哦——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1104/TALK",
            "narrator": "神楽",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "神乐"
        },
        {
            "location": "1105/TALK",
            "narrator": "神楽",
            "text": "とっても楽しいお仕事なんです",
            "zh": "也是一份非常开心的工作",
            "narrator_zh": "神乐"
        },
        {
            "location": "1118/TALK",
            "narrator": "神楽",
            "text": "ふぅ…悩んでても\n仕方ないし…。",
            "zh": "呼……光发愁也没用\n啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1119/TALK",
            "narrator": "神楽",
            "text": "早くやっちゃわないと！",
            "zh": "得快点动手才行！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1120/ACT",
            "narrator": "",
            "text": "いいね、力作待ってるよ！",
            "zh": "好啊，等着你的大作哦！",
            "narrator_zh": ""
        },
        {
            "location": "1122/TALK",
            "narrator": "神楽",
            "text": "任せてください！",
            "zh": "交给我吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1123/TALK",
            "narrator": "神楽",
            "text": "カラー絵描いちゃいますから！！",
            "zh": "我这就来画彩图哦！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1134/TALK",
            "narrator": "神楽",
            "text": "…よーし、\nすごいの描いてみせるん\nだから！！",
            "zh": "……好——，\n我一定要画出一张\n超棒的出来！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1152/TALK",
            "narrator": "神楽",
            "text": "ふぁ～…。",
            "zh": "哈啊～……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1153/TALK",
            "narrator": "神楽",
            "text": "空が明るくなってきた…。\nさすがに、そろそろ\n限界ね…。",
            "zh": "天色都亮起来了……。\n果然，差不多\n到极限了吧……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1154/TALK",
            "narrator": "神楽",
            "text": "結局、半分くらいしか\n描けなかったけど…。",
            "zh": "结果，只画了\n一半左右……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1155/TALK",
            "narrator": "神楽",
            "text": "まあ、残りは今夜にでも\n描けば――",
            "zh": "算了，剩下的今晚再\n画吧——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1159/TALK",
            "narrator": "神楽",
            "text": "もぉ、こんな早くに\n誰かしら…？",
            "zh": "真是的，这么一大早\n会是谁呀……？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1174/TALK",
            "narrator": "神楽",
            "text": "はい、もしもし卯月です。",
            "zh": "喂，你好，我是卯月。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1175/TALK",
            "narrator": "神楽",
            "text": "…ああ、どうも。\nお疲れ様です。",
            "zh": "……啊啊，你好。\n辛苦了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1176/TALK",
            "narrator": "神楽",
            "text": "送った歌詞の方は…はい？",
            "zh": "发过去的歌词那边……嗯？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1178/TALK",
            "narrator": "神楽",
            "text": "あっ！！！！",
            "zh": "啊！！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1179/TALK",
            "narrator": "神楽",
            "text": "ま、まさか！\n忘れてなんかいませんよ。",
            "zh": "怎、怎么可能！\n我才没有忘掉呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1180/TALK",
            "narrator": "神楽",
            "text": "今、サビのフレーズで\nちょっと悩んでた\nだけでして…。",
            "zh": "刚才只是在副歌的词句上\n稍微纠结了一下\n而已……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1181/TALK",
            "narrator": "神楽",
            "text": "は、はい、大丈夫です！\nはい、失礼します！！",
            "zh": "是、是的，没问题！\n好的，先挂了！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1186/TALK",
            "narrator": "神楽",
            "text": "…ど、どうしよう。\nとんでもない\nミスしちゃったかも…。",
            "zh": "……怎、怎么办。\n搞不好犯了个\n不得了的失误……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1187/SEL",
            "narrator": "",
            "text": "どうかしたの？",
            "zh": "怎么了吗？",
            "narrator_zh": ""
        },
        {
            "location": "1188/ACT",
            "narrator": "",
            "text": "どうかしたの？",
            "zh": "怎么了吗？",
            "narrator_zh": ""
        },
        {
            "location": "1205/TALK",
            "narrator": "神楽",
            "text": "うっかりです",
            "zh": "一时疏忽了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1206/TALK",
            "narrator": "神楽",
            "text": "作詞をしなければいけない曲が",
            "zh": "本来必须作词的歌",
            "narrator_zh": "神乐"
        },
        {
            "location": "1207/TALK",
            "narrator": "神楽",
            "text": "もう一つあったことをすっかり忘れてて",
            "zh": "还有另外一首的事我给彻底忘光了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1210/TALK",
            "narrator": "神楽",
            "text": "とにかく",
            "zh": "总之",
            "narrator_zh": "神乐"
        },
        {
            "location": "1211/TALK",
            "narrator": "神楽",
            "text": "やれるところまでは急いでやらないと",
            "zh": "能赶多少得赶快先写出来才行",
            "narrator_zh": "神乐"
        },
        {
            "location": "1212/TALK",
            "narrator": "神楽",
            "text": "色んな人に迷惑かけちゃいますし",
            "zh": "不然会给好多人添麻烦的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1215/SEL",
            "narrator": "",
            "text": "神楽ならできる！！",
            "zh": "神乐的话肯定做得到的！！",
            "narrator_zh": ""
        },
        {
            "location": "1216/SEL",
            "narrator": "",
            "text": "メノウって、大変だね",
            "zh": "当MENOW还真是辛苦呢",
            "narrator_zh": ""
        },
        {
            "location": "1217/ACT",
            "narrator": "",
            "text": "神楽ならできる！！",
            "zh": "神乐的话肯定做得到的！！",
            "narrator_zh": ""
        },
        {
            "location": "1218/TALK",
            "narrator": "神楽",
            "text": "ありがとうございます",
            "zh": "谢谢你",
            "narrator_zh": "神乐"
        },
        {
            "location": "1220/TALK",
            "narrator": "神楽",
            "text": "それじゃあまたあとで！",
            "zh": "那就回头再聊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1221/ACT",
            "narrator": "",
            "text": "メノウって、大変だね",
            "zh": "当MENOW还真是辛苦呢",
            "narrator_zh": ""
        },
        {
            "location": "1222/TALK",
            "narrator": "神楽",
            "text": "大変ですよー",
            "zh": "很辛苦的哦——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1224/TALK",
            "narrator": "神楽",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "神乐"
        },
        {
            "location": "1225/TALK",
            "narrator": "神楽",
            "text": "とっても楽しいお仕事なんです",
            "zh": "也是一份非常开心的工作",
            "narrator_zh": "神乐"
        },
        {
            "location": "1238/TALK",
            "narrator": "神楽",
            "text": "ふぅ…悩んでても\n仕方ないし…。",
            "zh": "呼……光发愁也没用\n啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1239/TALK",
            "narrator": "神楽",
            "text": "早くやっちゃわないと！",
            "zh": "得快点动手才行！",
            "narrator_zh": "神乐"
        },
        {
