        },
        {
            "location": "490/TALK",
            "narrator": "神楽",
            "text": "ない",
            "zh": "没有",
            "narrator_zh": "神乐"
        },
        {
            "location": "492/TALK",
            "narrator": "神楽",
            "text": "ところで純粋に疑問なんだけど",
            "zh": "话说，我纯粹有个疑问",
            "narrator_zh": "神乐"
        },
        {
            "location": "493/TALK",
            "narrator": "神楽",
            "text": "生まれた時から愛を受け続けてきた人間と、全く与えられなかった人間",
            "zh": "从出生起就一直被爱着的人，和完全没被给过爱的人",
            "narrator_zh": "神乐"
        },
        {
            "location": "494/TALK",
            "narrator": "神楽",
            "text": "人からの愛を受け止めることができるのは圧倒的に前者なのはどうしてなんだろう",
            "zh": "为什么能接住人的爱的，压倒性地是前者呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "495/TALK",
            "narrator": "神楽",
            "text": "後者の方がどう考えても絶対量が不足しているはずなのにね",
            "zh": "后者无论怎么想，绝对量都该不够才对",
            "narrator_zh": "神乐"
        },
        {
            "location": "497/SEL",
            "narrator": "",
            "text": "慣れてないんだよ",
            "zh": "是还不习惯",
            "narrator_zh": ""
        },
        {
            "location": "498/SEL",
            "narrator": "",
            "text": "身につまされるな、、、",
            "zh": "说到我心坎上了……",
            "narrator_zh": ""
        },
        {
            "location": "499/SEL",
            "narrator": "",
            "text": "本当はわかってて聞いてるでしょ",
            "zh": "你其实懂，才故意问的吧",
            "narrator_zh": ""
        },
        {
            "location": "500/ACT",
            "narrator": "",
            "text": "慣れてないんだよ",
            "zh": "是还不习惯",
            "narrator_zh": ""
        },
        {
            "location": "501/TALK",
            "narrator": "神楽",
            "text": "愛にも練度と訓練が必要",
            "zh": "爱也需要熟练和训练",
            "narrator_zh": "神乐"
        },
        {
            "location": "503/TALK",
            "narrator": "神楽",
            "text": "世知辛い",
            "zh": "世道艰难",
            "narrator_zh": "神乐"
        },
        {
            "location": "504/ACT",
            "narrator": "",
            "text": "身につまされるな、、、",
            "zh": "说到我心坎上了……",
            "narrator_zh": ""
        },
        {
            "location": "505/TALK",
            "narrator": "神楽",
            "text": "$handlek$にはぴょんこがいるぴょん",
            "zh": "$handlek$有蹦子在pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "506/TALK",
            "narrator": "神楽",
            "text": "でしょ？",
            "zh": "对吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "507/ACT",
            "narrator": "",
            "text": "本当はわかってて聞いてるでしょ",
            "zh": "你其实懂，才故意问的吧",
            "narrator_zh": ""
        },
        {
            "location": "509/TALK",
            "narrator": "神楽",
            "text": "まあそうだけど",
            "zh": "嘛，是这样",
            "narrator_zh": "神乐"
        },
        {
            "location": "510/TALK",
            "narrator": "神楽",
            "text": "$handlek$との共通認識を作っておきたいわけですしー",
            "zh": "我想先和$handlek$建立共同认识嘛",
            "narrator_zh": "神乐"
        },
        {
            "location": "511/TALK",
            "narrator": "神楽",
            "text": "そういうのもひとつの愛の証",
            "zh": "这也是爱的证明之一",
            "narrator_zh": "神乐"
        },
        {
            "location": "512/TALK",
            "narrator": "神楽",
            "text": "違う？",
            "zh": "不对吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "514/TALK",
            "narrator": "神楽",
            "text": "そう考えてゆくと",
            "zh": "这么想下去",
            "narrator_zh": "神乐"
        },
        {
            "location": "515/TALK",
            "narrator": "神楽",
            "text": "セカイの中心で愛を叫んだりできるのは元々愛を知っているか",
            "zh": "能在世界中心喊出爱的人，要么本来就懂得爱",
            "narrator_zh": "神乐"
        },
        {
            "location": "516/TALK",
            "narrator": "神楽",
            "text": "あるいは別の何かを愛だと錯覚しているかのどちらか",
            "zh": "要么就是把别的什么错当成了爱",
            "narrator_zh": "神乐"
        },
        {
            "location": "517/TALK",
            "narrator": "神楽",
            "text": "どちらが幸せなのかは",
            "zh": "哪一边更幸福",
            "narrator_zh": "神乐"
        },
        {
            "location": "518/TALK",
            "narrator": "神楽",
            "text": "神のみぞ知る",
            "zh": "只有神知道",
