{
    "dir": "dramatics/daydra/drm_ch04_00_060.js",
    "type": "Episode",
    "info": {
        "story_id": "4006",
        "cid": "miyabi",
        "title": "らぶとーく 第06話",
        "sub_title": "テストシナリオ実行完了",
        "title_zh": "恋爱漫谈 第06话",
        "sub_title_zh": "测试剧本执行完毕"
    },
    "entry": [
        {
            "location": "374/SCENARIO",
            "narrator": "",
            "text": "テストシナリオ実行完了",
            "zh": "测试剧本执行完毕",
            "narrator_zh": ""
        },
        {
            "location": "396/TALK",
            "narrator": "みやび",
            "text": "ん～…。",
            "zh": "唔～……。",
            "narrator_zh": "雅"
        },
        {
            "location": "397/TALK",
            "narrator": "アーヤ",
            "text": "…どうかしら？",
            "zh": "……怎么样呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "398/TALK",
            "narrator": "みやび",
            "text": "そうやねぇ…。",
            "zh": "是咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "399/TALK",
            "narrator": "みやび",
            "text": "アーヤから渡された\nこの会話ログを\n見る限り――",
            "zh": "单从绫水交给我的\n这份对话记录\n来看——",
            "narrator_zh": "雅"
        },
        {
            "location": "400/TALK",
            "narrator": "みやび",
            "text": "多分やけんど、\n答えが出たちや。",
            "zh": "虽然只是大概，\n答案已经出来滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "403/TALK",
            "narrator": "アーヤ",
            "text": "えっ、もう！？",
            "zh": "欸，这就！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "404/TALK",
            "narrator": "みやび",
            "text": "やはり、データが倍だと\n解析もラクちや。",
            "zh": "果然，数据翻倍的话\n解析也轻松滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "405/TALK",
            "narrator": "みやび",
            "text": "Ｂｏｔめ…やはりそういう\nことやったか。",
            "zh": "好个Bot……果然\n是这么回事啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "406/SEL",
            "narrator": "",
            "text": "何してるの？",
            "zh": "你在做什么？",
            "narrator_zh": ""
        },
        {
            "location": "407/SEL",
            "narrator": "",
            "text": "遊ぼうよ",
            "zh": "一起玩吧",
            "narrator_zh": ""
        },
        {
            "location": "408/SEL",
            "narrator": "",
            "text": "お腹空いたんだけど",
            "zh": "我肚子饿了",
            "narrator_zh": ""
        },
        {
            "location": "409/ACT",
            "narrator": "",
            "text": "何してるの？",
            "zh": "你在做什么？",
            "narrator_zh": ""
        },
        {
            "location": "414/TALK",
            "narrator": "アーヤ",
            "text": "…まさか。",
            "zh": "……不会吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "415/TALK",
            "narrator": "みやび",
            "text": "…ヤツや。",
            "zh": "……是那家伙咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "429/TALK",
            "narrator": "みやび",
            "text": "何でもない",
            "zh": "没什么",
            "narrator_zh": "雅"
        },
        {
            "location": "430/TALK",
            "narrator": "みやび",
            "text": "ただの女子会や",
            "zh": "只是女生聚会",
            "narrator_zh": "雅"
        },
        {
            "location": "431/TALK",
            "narrator": "みやび",
            "text": "チケットなしは入場お断りぞね",
            "zh": "没票的谢绝入场咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "444/TALK",
            "narrator": "アーヤ",
            "text": "…Ｂｏｔは何だって？",
            "zh": "…Bot说了什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "447/TALK",
            "narrator": "みやび",
            "text": "何してるのか、やって。",
            "zh": "说的是「你在干什么」。",
            "narrator_zh": "雅"
        },
        {
            "location": "450/TALK",
            "narrator": "みやび",
            "text": "どうやら、うちらが\nＢｏｔのこと調べてるん、\n気付かれてたようやね。",
            "zh": "看来我们\n在查Bot的事\n被发现了嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "453/TALK",
            "narrator": "アーヤ",
            "text": "それって、監視！？",
            "zh": "那是监视！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "454/TALK",
            "narrator": "みやび",
            "text": "やとしたら、話しかけて\nくるゆうんは変や。",
            "zh": "要是那样，还主动来\n搭话就奇怪了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "455/TALK",
            "narrator": "みやび",
            "text": "目的はさっぱりやけんど、\nそういうことじゃないとは\n思うちや。",
            "zh": "目的虽然完全\n摸不透，但不觉得\n是冲这个来的滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "456/TALK",
            "narrator": "みやび",
            "text": "何にせよ――",
            "zh": "总之——",
            "narrator_zh": "雅"
        },
        {
            "location": "457/ACT",
            "narrator": "",
            "text": "遊ぼうよ",
            "zh": "一起玩吧",
            "narrator_zh": ""
        },
        {
            "location": "462/TALK",
            "narrator": "アーヤ",
            "text": "…まさか。",
            "zh": "……不会吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "463/TALK",
            "narrator": "みやび",
            "text": "…ヤツや。",
            "zh": "……是那家伙咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "477/TALK",
            "narrator": "みやび",
            "text": "今忙しい",
            "zh": "现在正忙",
            "narrator_zh": "雅"
        },
        {
            "location": "478/TALK",
            "narrator": "みやび",
            "text": "あとで気の済むまで遊んでやるぞね",
            "zh": "回头再陪它玩到尽兴咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "491/TALK",
            "narrator": "アーヤ",
            "text": "…Ｂｏｔは何だって？",
            "zh": "…Bot说了什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "494/TALK",
            "narrator": "みやび",
            "text": "遊ぼうよ、やって。",
            "zh": "说的是「来玩嘛」。",
            "narrator_zh": "雅"
        },
        {
            "location": "497/TALK",
            "narrator": "みやび",
            "text": "このタイミングで\n話しかけてくるゆうんは、\nタイミング良過ぎやろ？",
            "zh": "在这个时机\n来跟我说话，\n这时机也太好了，是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "500/TALK",
            "narrator": "アーヤ",
            "text": "私もそう思うわ。",
            "zh": "我也这么觉得。",
            "narrator_zh": "绫水"
        },
        {
            "location": "501/TALK",
            "narrator": "アーヤ",
            "text": "っていうことは、\nやっぱり…。",
            "zh": "也就是说，\n果然……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "502/ACT",
            "narrator": "",
            "text": "お腹空いたんだけど",
            "zh": "我肚子饿了",
            "narrator_zh": ""
        },
        {
            "location": "507/TALK",
            "narrator": "アーヤ",
            "text": "…まさか。",
            "zh": "……不会吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "508/TALK",
            "narrator": "みやび",
            "text": "…ヤツや。",
            "zh": "……是那家伙咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "522/TALK",
            "narrator": "みやび",
            "text": "腹ペコ？",
            "zh": "肚子饿了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "523/TALK",
            "narrator": "みやび",
            "text": "戸棚にドーナツがあるぞね",
            "zh": "柜子里有甜甜圈咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "524/TALK",
            "narrator": "みやび",
            "text": "食べたければニュイと足を生やして取って来ぃ",
            "zh": "想吃的话，就嗖地长出脚来去拿咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "537/TALK",
            "narrator": "みやび",
            "text": "…あいつ、\nわけわからんな。",
            "zh": "……那家伙，\n完全不懂啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "540/TALK",
            "narrator": "アーヤ",
            "text": "何て言ってたの？",
            "zh": "它说什么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "543/TALK",
            "narrator": "みやび",
            "text": "お腹空いた言うてた。",
            "zh": "它说肚子饿了。",
            "narrator_zh": "雅"
        },
        {
            "location": "546/TALK",
            "narrator": "みやび",
            "text": "変な話やね。\n充電１００％のはず\nやのに…。",
            "zh": "怪事咯。\n明明该是\n100%满电的……。",
            "narrator_zh": "雅"
        },
        {
            "location": "548/TALK",
            "narrator": "アーヤ",
            "text": "Ｂｏｔの定期会話機能\nみたいなものかしら？",
            "zh": "是像Bot的定时会话\n功能之类的东西吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "549/TALK",
            "narrator": "みやび",
            "text": "ありえなくはないけんど、\n今までの会話ログの\n内容から考えて――",
            "zh": "虽然也不是不可能，\n但从至今为止的\n对话记录内容来看——",
            "narrator_zh": "雅"
        },
        {
            "location": "552/TALK",
            "narrator": "みやび",
            "text": "Ｂｏｔは人間やと、\nうちは断言するぞね。",
            "zh": "Bot是人类，\n我敢断言咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "553/TALK",
            "narrator": "アーヤ",
            "text": "やっぱりね…。",
            "zh": "果然呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "554/TALK",
            "narrator": "みやび",
            "text": "Ｂｏｔ特有の、意味不明な\n返答がないのが決め手や。",
            "zh": "没有Bot特有的那种\n莫名回复，就是铁证咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "555/TALK",
            "narrator": "みやび",
            "text": "まあ、うちの知らない\nところで――",
            "zh": "嘛，要是在\n我不知道的地方——",
            "narrator_zh": "雅"
        },
        {
            "location": "556/TALK",
            "narrator": "みやび",
            "text": "超高性能なＢｏｔが\n作られてたっちゅうなら\n話は別やけんどね。",
            "zh": "要是有人造出了\n超高性能的Bot，\n那就另当别论，但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "558/TALK",
            "narrator": "アーヤ",
            "text": "その可能性は？",
            "zh": "那种可能性呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "560/TALK",
            "narrator": "みやび",
            "text": "まずありえんちや。",
            "zh": "基本不可能滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "561/TALK",
            "narrator": "みやび",
            "text": "そんな高性能なＡＩを、\nただのＢｏｔとしてしか\n使わないなんて――",
            "zh": "把那么高性能的AI，\n只当作普通的Bot\n来用——",
            "narrator_zh": "雅"
        },
        {
            "location": "562/TALK",
            "narrator": "みやび",
            "text": "無駄でしかないぞね。",
            "zh": "那样纯粹是浪费咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "565/TALK",
            "narrator": "アーヤ",
            "text": "…そうなんだろう\nけど……。",
            "zh": "……话是这么说\n没错……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "567/TALK",
            "narrator": "みやび",
            "text": "そういうことや。",
            "zh": "就是这么回事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "569/TALK",
            "narrator": "みやび",
            "text": "…で？\nこの後はどうするが？",
            "zh": "……然后？\n接下来怎么办咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "572/TALK",
            "narrator": "アーヤ",
            "text": "とりあえず、みんなに\n報告しないとね。",
            "zh": "总之，得跟大家\n报告呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "574/TALK",
            "narrator": "アーヤ",
            "text": "プライバシーにも\n関わってくる問題だし…。",
            "zh": "这还牵涉到\n隐私问题……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "575/TALK",
            "narrator": "みやび",
            "text": "…まあ、なあ……。",
            "zh": "……嘛，是啊……。",
            "narrator_zh": "雅"
        }
    ]
}
