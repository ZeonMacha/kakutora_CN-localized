{
 "dir": "dramatics/daydra/drm_ch04_00_060.js",
 "type": "Episode",
 "info": {
  "story_id": "4006",
  "cid": "miyabi",
  "title": "らぶとーく 第06話",
  "sub_title": "テストシナリオ実行完了"
 },
 "entry": [
  {
   "location": "374/SCENARIO",
   "narrator": "",
   "text": "テストシナリオ実行完了"
  },
  {
   "location": "396/TALK",
   "narrator": "みやび",
   "text": "ん～…。"
  },
  {
   "location": "397/TALK",
   "narrator": "アーヤ",
   "text": "…どうかしら？",
   "zh": "……怎么样呢？",
   "narrator_zh": "绫水"
  },
  {
   "location": "398/TALK",
   "narrator": "みやび",
   "text": "そうやねぇ…。",
   "zh": "是啊……。",
   "narrator_zh": "雅"
  },
  {
   "location": "399/TALK",
   "narrator": "みやび",
   "text": "アーヤから渡された\nこの会話ログを\n見る限り――"
  },
  {
   "location": "400/TALK",
   "narrator": "みやび",
   "text": "多分やけんど、\n答えが出たちや。"
  },
  {
   "location": "403/TALK",
   "narrator": "アーヤ",
   "text": "えっ、もう！？"
  },
  {
   "location": "404/TALK",
   "narrator": "みやび",
   "text": "やはり、データが倍だと\n解析もラクちや。"
  },
  {
   "location": "405/TALK",
   "narrator": "みやび",
   "text": "Ｂｏｔめ…やはりそういう\nことやったか。"
  },
  {
   "location": "406/SEL",
   "narrator": "",
   "text": "何してるの？",
   "zh": "你在做什么？",
   "narrator_zh": ""
  },
  {
   "location": "407/SEL",
   "narrator": "",
   "text": "遊ぼうよ",
   "zh": "一起玩吧",
   "narrator_zh": ""
  },
  {
   "location": "408/SEL",
   "narrator": "",
   "text": "お腹空いたんだけど",
   "zh": "我肚子饿了",
   "narrator_zh": ""
  },
  {
   "location": "409/ACT",
   "narrator": "",
   "text": "何してるの？",
   "zh": "你在做什么？",
   "narrator_zh": ""
  },
  {
   "location": "414/TALK",
   "narrator": "アーヤ",
   "text": "…まさか。",
   "zh": "……不会吧。",
   "narrator_zh": "绫水"
  },
  {
   "location": "415/TALK",
   "narrator": "みやび",
   "text": "…ヤツや。",
   "zh": "……是那家伙咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "429/TALK",
   "narrator": "みやび",
   "text": "何でもない"
  },
  {
   "location": "430/TALK",
   "narrator": "みやび",
   "text": "ただの女子会や",
   "zh": "只是女生聚会",
   "narrator_zh": "雅"
  },
  {
   "location": "431/TALK",
   "narrator": "みやび",
   "text": "チケットなしは入場お断りぞね"
  },
  {
   "location": "444/TALK",
   "narrator": "アーヤ",
   "text": "…Ｂｏｔは何だって？",
   "zh": "…Bot说了什么？",
   "narrator_zh": "绫水"
  },
  {
   "location": "447/TALK",
   "narrator": "みやび",
   "text": "何してるのか、やって。"
  },
  {
   "location": "450/TALK",
   "narrator": "みやび",
   "text": "どうやら、うちらが\nＢｏｔのこと調べてるん、\n気付かれてたようやね。",
   "zh": "看来我们\n在查Bot的事\n被发现了嘛。",
   "narrator_zh": "雅"
  },
  {
   "location": "453/TALK",
   "narrator": "アーヤ",
   "text": "それって、監視！？",
   "zh": "那是监视！？",
   "narrator_zh": "绫水"
  },
  {
   "location": "454/TALK",
   "narrator": "みやび",
   "text": "やとしたら、話しかけて\nくるゆうんは変や。"
  },
  {
   "location": "455/TALK",
   "narrator": "みやび",
   "text": "目的はさっぱりやけんど、\nそういうことじゃないとは\n思うちや。"
  },
  {
   "location": "456/TALK",
   "narrator": "みやび",
   "text": "何にせよ――"
  },
  {
   "location": "457/ACT",
   "narrator": "",
   "text": "遊ぼうよ",
   "zh": "一起玩吧",
   "narrator_zh": ""
  },
  {
   "location": "462/TALK",
   "narrator": "アーヤ",
   "text": "…まさか。",
   "zh": "……不会吧。",
   "narrator_zh": "绫水"
  },
  {
   "location": "463/TALK",
   "narrator": "みやび",
   "text": "…ヤツや。",
   "zh": "……是那家伙咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "477/TALK",
   "narrator": "みやび",
   "text": "今忙しい",
   "zh": "现在正忙",
   "narrator_zh": "雅"
  },
  {
   "location": "478/TALK",
   "narrator": "みやび",
   "text": "あとで気の済むまで遊んでやるぞね"
  },
  {
   "location": "491/TALK",
   "narrator": "アーヤ",
   "text": "…Ｂｏｔは何だって？",
   "zh": "…Bot说了什么？",
   "narrator_zh": "绫水"
  },
  {
   "location": "494/TALK",
   "narrator": "みやび",
   "text": "遊ぼうよ、やって。"
  },
  {
   "location": "497/TALK",
   "narrator": "みやび",
   "text": "このタイミングで\n話しかけてくるゆうんは、\nタイミング良過ぎやろ？",
   "zh": "在这个时机\n来跟我说话，这时机\n也太好了吧？",
   "narrator_zh": "雅"
  },
  {
   "location": "500/TALK",
   "narrator": "アーヤ",
   "text": "私もそう思うわ。"
  },
  {
   "location": "501/TALK",
   "narrator": "アーヤ",
   "text": "っていうことは、\nやっぱり…。",
   "zh": "也就是说，\n果然……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "502/ACT",
   "narrator": "",
   "text": "お腹空いたんだけど",
   "zh": "我肚子饿了",
   "narrator_zh": ""
  },
  {
   "location": "507/TALK",
   "narrator": "アーヤ",
   "text": "…まさか。",
   "zh": "……不会吧。",
   "narrator_zh": "绫水"
  },
  {
   "location": "508/TALK",
   "narrator": "みやび",
   "text": "…ヤツや。",
   "zh": "……是那家伙咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "522/TALK",
   "narrator": "みやび",
   "text": "腹ペコ？"
  },
  {
   "location": "523/TALK",
   "narrator": "みやび",
   "text": "戸棚にドーナツがあるぞね"
  },
  {
   "location": "524/TALK",
   "narrator": "みやび",
   "text": "食べたければニュイと足を生やして取って来ぃ"
  },
  {
   "location": "537/TALK",
   "narrator": "みやび",
   "text": "…あいつ、\nわけわからんな。"
  },
  {
   "location": "540/TALK",
   "narrator": "アーヤ",
   "text": "何て言ってたの？"
  },
  {
   "location": "543/TALK",
   "narrator": "みやび",
   "text": "お腹空いた言うてた。",
   "zh": "你说肚子饿了。",
   "narrator_zh": "雅"
  },
  {
   "location": "546/TALK",
   "narrator": "みやび",
   "text": "変な話やね。\n充電１００％のはず\nやのに…。"
  },
  {
   "location": "548/TALK",
   "narrator": "アーヤ",
   "text": "Ｂｏｔの定期会話機能\nみたいなものかしら？"
  },
  {
   "location": "549/TALK",
   "narrator": "みやび",
   "text": "ありえなくはないけんど、\n今までの会話ログの\n内容から考えて――"
  },
  {
   "location": "552/TALK",
   "narrator": "みやび",
   "text": "Ｂｏｔは人間やと、\nうちは断言するぞね。"
  },
  {
   "location": "553/TALK",
   "narrator": "アーヤ",
   "text": "やっぱりね…。"
  },
  {
   "location": "554/TALK",
   "narrator": "みやび",
   "text": "Ｂｏｔ特有の、意味不明な\n返答がないのが決め手や。"
  },
  {
   "location": "555/TALK",
   "narrator": "みやび",
   "text": "まあ、うちの知らない\nところで――"
  },
  {
   "location": "556/TALK",
   "narrator": "みやび",
   "text": "超高性能なＢｏｔが\n作られてたっちゅうなら\n話は別やけんどね。"
  },
  {
   "location": "558/TALK",
   "narrator": "アーヤ",
   "text": "その可能性は？",
   "zh": "那种可能性呢？",
   "narrator_zh": "绫水"
  },
  {
   "location": "560/TALK",
   "narrator": "みやび",
   "text": "まずありえんちや。"
  },
  {
   "location": "561/TALK",
   "narrator": "みやび",
   "text": "そんな高性能なＡＩを、\nただのＢｏｔとしてしか\n使わないなんて――",
   "zh": "把那么高性能的AI，\n只当作普通的Bot\n来用——",
   "narrator_zh": "雅"
  },
  {
   "location": "562/TALK",
   "narrator": "みやび",
   "text": "無駄でしかないぞね。"
  },
  {
   "location": "565/TALK",
   "narrator": "アーヤ",
   "text": "…そうなんだろう\nけど……。"
  },
  {
   "location": "567/TALK",
   "narrator": "みやび",
   "text": "そういうことや。",
   "zh": "就是这么回事咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "569/TALK",
   "narrator": "みやび",
   "text": "…で？\nこの後はどうするが？",
   "zh": "……然后？\n接下来搞哪样啵？",
   "narrator_zh": "雅"
  },
  {
   "location": "572/TALK",
   "narrator": "アーヤ",
   "text": "とりあえず、みんなに\n報告しないとね。",
   "zh": "总之，得跟大家\n报告呢。",
   "narrator_zh": "绫水"
  },
  {
   "location": "574/TALK",
   "narrator": "アーヤ",
   "text": "プライバシーにも\n関わってくる問題だし…。"
  },
  {
   "location": "575/TALK",
   "narrator": "みやび",
   "text": "…まあ、なあ……。",
   "zh": "……嘛，是啊……。",
   "narrator_zh": "雅"
  }
 ]
}
