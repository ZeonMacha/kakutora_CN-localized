    },
    "entry": [
        {
            "location": "160/SCENARIO",
            "narrator": "",
            "text": "040_故郷の風",
            "zh": "040_故乡的风",
            "narrator_zh": ""
        },
        {
            "location": "186/TALK",
            "narrator": "ガブリエラ",
            "text": "ふるさとは遠きにありて思ふもの",
            "zh": "故乡是远方才思念的东西",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "187/TALK",
            "narrator": "ガブリエラ",
            "text": "そして悲しくうたふもの",
            "zh": "然后悲伤歌唱的东西",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "189/SEL",
            "narrator": "",
            "text": "宿題でも出たの？",
            "zh": "留作业了？",
            "narrator_zh": ""
        },
        {
            "location": "190/SEL",
            "narrator": "",
            "text": "ホームシックなのかな",
            "zh": "是思乡了吗",
            "narrator_zh": ""
        },
        {
            "location": "191/SEL",
            "narrator": "",
            "text": "遠きみやこにかへらばや",
            "zh": "真想回到那远方的故乡啊",
            "narrator_zh": ""
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "こんな平仮名の使い方してたら読みにくくて仕方がないわよね",
            "zh": "这么用平假名的话，读起来难受得不行吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラ",
            "text": "旧仮名遣いって言うらしいけど",
            "zh": "听说这叫旧假名写法",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "206/ACT",
            "narrator": "",
            "text": "宿題でも出たの？",
            "zh": "留作业了？",
            "narrator_zh": ""
        },
        {
            "location": "207/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナったら・・・",
            "zh": "玛尔赞娜真是的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうわけじゃないわ",
            "zh": "不是那么回事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "210/TALK",
            "narrator": "ガブリエラ",
            "text": "少しだけこういう気分なだけなの",
            "zh": "只是有一点点这种心情而已",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "211/ACT",
            "narrator": "",
            "text": "ホームシックなのかな",
            "zh": "是思乡了吗",
            "narrator_zh": ""
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナにはなんでもわかっちゃうのね",
            "zh": "玛尔赞娜什么都懂呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/TALK",
            "narrator": "ガブリエラ",
            "text": "でも平気よ、ここにはマルザンナがいるものね",
            "zh": "不过没事，这里有马尔赞娜呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "224/ACT",
            "narrator": "",
            "text": "遠きみやこにかへらばや",
            "zh": "真想回到那远方的故乡啊",
            "narrator_zh": ""
        },
        {
            "location": "225/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナも知ってるのね",
            "zh": "玛尔赞娜也知道呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "それにしてもこの人、故郷と都のどっちにいるのかしら？",
            "zh": "不过话说回来，这个人到底在故乡还是在京城呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "不思議よね",
            "zh": "真不可思议呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしても、って言って、いっぱい喧嘩して、やっと日本に来たのに",
            "zh": "明明说了无论如何都要，吵了很多架，好不容易才来到日本",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "230/TALK",
            "narrator": "ガブリエラ",
            "text": "朝起きたらワルシャワじゃないことに気がついてがっかりするなんて",
            "zh": "早上醒来发现不是华沙，居然会失望",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "231/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなこと・・・",
            "zh": "那种事……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "232/TALK",
            "narrator": "ガブリエラ",
            "text": "向こうにいるときには・・・",
            "zh": "在那边的时候……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "ガブリエラ",
            "text": "考えもしなかったのに・・・",
            "zh": "想都没想过……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "236/SEL",
            "narrator": "",
            "text": "元気出して",
            "zh": "打起精神",
            "narrator_zh": ""
        },
        {
            "location": "237/SEL",
            "narrator": "",
            "text": "日本には$handle$がいるよ",
            "zh": "日本有$handle$在哦",
            "narrator_zh": ""
        },
        {
            "location": "239/ACT",
            "narrator": "",
            "text": "元気出して",
            "zh": "打起精神",
            "narrator_zh": ""
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "・・・うん・・・",
            "zh": "……嗯……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "そうだわね・・・",
            "zh": "是啊・・・",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "がんばんなきゃ、だね・・・",
            "zh": "不努力不行呢……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/ACT",
            "narrator": "",
            "text": "日本には$handle$がいるよ",
            "zh": "日本有$handle$在哦",
            "narrator_zh": ""
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "もう！",
            "zh": "真是！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナったら、冗談ばっかり",
            "zh": "玛尔赞娜真是的，净开玩笑",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$なんて名前、どこから思いついたのかしら？",
            "zh": "$handle$这名字，你是从哪想出来的？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "257/TALK",
            "narrator": "ガブリエラ",
            "text": "でも少し元気が出たわ",
            "zh": "不过稍微有点精神了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "259/TALK",
            "narrator": "ガブリエラ",
            "text": "今日はもう寝るわね",
            "zh": "今天就先睡了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "261/SEL",
            "narrator": "",
            "text": "おやすみなさい",
            "zh": "晚安",
            "narrator_zh": ""
        },
        {
