{
    "dir": "chap08/daydra/dd_ch03_08_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "8305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "大胆勝負～Case2～＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "大胆对决～Case2～＜后篇＞"
    },
    "entry": [
        {
            "location": "173/SCENARIO",
            "narrator": "",
            "text": "大胆勝負～Case2～",
            "zh": "大胆对决～Case2～",
            "narrator_zh": ""
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "…そっか。",
            "zh": "……这样啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "最近、アーヤと\n二人きりで話すこと\nなかったから――",
            "zh": "最近都没怎么和绫水\n单独两个人\n说过话——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "それでこんな気持ちに\nなったのかも。",
            "zh": "所以才会变成\n这种心情吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "ガブリエラ",
            "text": "…久しぶりに\n二人きりになれたん\nだから――",
            "zh": "……难得今天\n能变成只有\n两个人独处——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "199/TALK",
            "narrator": "ガブリエラ",
            "text": "何か話しておくべき\nだったかしら？",
            "zh": "是不是该跟她说点\n什么比较好呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "201/TALK",
            "narrator": "ガブリエラ",
            "text": "いやいや、だから\n話すようなこと\nないんだってば。",
            "zh": "不不不，都说了\n根本没什么\n好聊的啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "202/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "204/SEL",
            "narrator": "",
            "text": "今日の戦いっぷりどうだった？と聞いてみろ",
            "zh": "试着问她“我今天打得怎么样？”",
            "narrator_zh": ""
        },
        {
            "location": "205/SEL",
            "narrator": "",
            "text": "見つめて「好き」とだけ言え",
            "zh": "盯着她只说一句“喜欢”",
            "narrator_zh": ""
        },
        {
            "location": "206/ACT",
            "narrator": "",
            "text": "今日の戦いっぷりどうだった？と聞いてみろ",
            "zh": "试着问她“我今天打得怎么样？”",
            "narrator_zh": ""
        },
        {
            "location": "225/TALK",
            "narrator": "ガブリエラ",
            "text": "嫌よ",
            "zh": "才不要",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなこと、自分から聞けないわ",
            "zh": "这种事，哪能由我自己主动去问啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "第一、そういうのってリーダーのアーヤから言ってくるべきじゃない？",
            "zh": "再说了，这种话不是应该由身为队长的绫水主动来说吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "230/SEL",
            "narrator": "",
            "text": "そういうところ、可愛くないよ",
            "zh": "你这点可真不可爱呢",
            "narrator_zh": ""
        },
        {
            "location": "231/ACT",
            "narrator": "",
            "text": "そういうところ、可愛くないよ",
            "zh": "你这点可真不可爱呢",
            "narrator_zh": ""
        },
        {
            "location": "233/TALK",
            "narrator": "ガブリエラ",
            "text": "可愛くない！？",
            "zh": "不可爱！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "そう",
            "zh": "是哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "235/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね",
            "zh": "是这样呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナの言う通りよね",
            "zh": "玛尔赞娜说得没错呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "反省するわ",
            "zh": "我会反省的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、やっぱり自分から聞くなんて、恥ずかしいわ",
            "zh": "可是，果然由自己开口问什么的，太让人害羞了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "240/SEL",
            "narrator": "",
            "text": "ただの質問だし、考え過ぎだよ",
            "zh": "只是个普通的问题而已，你想太多啦",
            "narrator_zh": ""
        },
        {
            "location": "241/ACT",
            "narrator": "",
            "text": "ただの質問だし、考え過ぎだよ",
            "zh": "只是个普通的问题而已，你想太多啦",
            "narrator_zh": ""
        },
        {
            "location": "243/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "ただの質問よね？",
            "zh": "只是个普通的问题对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう、マルザンナ",
            "zh": "谢谢你，玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "246/TALK",
            "narrator": "ガブリエラ",
            "text": "私、頑張って聞いてみるわ",
            "zh": "我会鼓起勇气去问问看的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "258/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "261/TALK",
            "narrator": "アーヤ",
            "text": "あら、まだいたの？\n早く服着ないと\n湯冷めするわよ？",
            "zh": "哎呀，你还在呢？\n不快点把衣服穿上\n会着凉的哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "263/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うん…。",
            "zh": "嗯、嗯……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "アーヤ",
            "text": "…？\nそれじゃ、また明日。",
            "zh": "……？\n那，明天见啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "267/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、アーヤ！",
            "zh": "绫、绫水！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "269/TALK",
            "narrator": "ガブリエラ",
            "text": "あの、今日の戦闘の\nことなんだけど…、\nあたし、どうだった？",
            "zh": "那个，关于今天战斗\n的事……，\n我表现得怎么样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "271/TALK",
            "narrator": "アーヤ",
            "text": "そうね…。\n大活躍してたと\n思うわ。",
            "zh": "让我想想……。\n我觉得你表现得\n非常活跃哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "273/TALK",
            "narrator": "ガブリエラ",
            "text": "う、ウソ！\nそんな活躍なんか\nしてないわ。",
            "zh": "骗、骗人！\n我哪有那么\n活跃啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "276/TALK",
            "narrator": "アーヤ",
            "text": "してたじゃない。\n忘れたの？",
            "zh": "明明就有嘛。\n你忘了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "277/TALK",
            "narrator": "アーヤ",
            "text": "おとり作戦の時に、\n一発で仕留めてくれた\nでしょ？",
            "zh": "诱饵作战的时候，\n不是一枪就\n解决掉了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "278/TALK",
            "narrator": "アーヤ",
            "text": "もし、あの時に\nもっと時間をかけて\nたとしたら――",
            "zh": "如果那个时候\n再多拖延一点\n时间的话——",
            "narrator_zh": "绫水"
        },
        {
            "location": "279/TALK",
            "narrator": "アーヤ",
            "text": "バリアが持たなくて、\nみやび達は無事じゃ\nすまなかったわ。",
            "zh": "屏障肯定撑不住，\n雅她们也就\n危险了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "280/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "281/TALK",
            "narrator": "アーヤ",
            "text": "あの二人が無事だった\nのは、ギャヴィの\nおかげよ。",
            "zh": "那两个人能平安无事，\n可全靠加维\n你呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "283/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう。",
            "zh": "谢谢你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "287/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、ぅ…。",
            "zh": "啊、唔……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/TALK",
            "narrator": "ガブリエラ",
            "text": "べ、別に！\nあんなの、活躍でも\nなんでもないし！",
            "zh": "才、才没有！\n那种程度，根本算不上\n什么活跃啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "290/TALK",
            "narrator": "ガブリエラ",
            "text": "大体、あんな簡単なの\n外すわけないん\nだから――",
            "zh": "再说了，那么简单的目标\n我怎么可能\n打偏嘛——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "褒められても、\n全然嬉しくないわ！",
            "zh": "就算被你夸奖，\n我也一点都不高兴！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "295/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、だと思った。",
            "zh": "呵呵，就知道你会这么说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "296/TALK",
            "narrator": "アーヤ",
            "text": "これからも、\n頼りにしてるからね。",
            "zh": "今后也要\n多多仰仗你咯。",
            "narrator_zh": "绫水"
        },
        {
            "location": "297/TALK",
            "narrator": "ガブリエラ",
            "text": "…………っ！",
            "zh": "…………唔！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "300/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ、待って！\n最後にもう一つ！",
            "zh": "啊，等一下！\n最后还有一件事！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "302/TALK",
            "narrator": "アーヤ",
            "text": "何かしら？",
            "zh": "什么事？",
            "narrator_zh": "绫水"
        },
        {
            "location": "303/TALK",
            "narrator": "ガブリエラ",
            "text": "頼りにしてるって\nことは――",
            "zh": "你说仰仗我，\n意思就是——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "304/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤにとって、\nあたしは必要…って\nこと？",
            "zh": "对绫水来说，\n我是必需的……\n这个意思吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "306/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "哎！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "308/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "310/TALK",
            "narrator": "アーヤ",
            "text": "今更聞く！？\nそんなの当然でしょ。",
            "zh": "都到这时候了还问！？\n那不是理所当然的吗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "二人だけの時から、\nずっと一緒にやって\nきたんだもの。",
            "zh": "从只有我们两个人的时候起，\n就一直并肩作战\n走到今天的呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "313/TALK",
            "narrator": "アーヤ",
            "text": "安心して背中を\n任せられるのは、\nあなただけよ。",
            "zh": "能让我放心把后背\n托付出去的，\n只有你一个人哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "316/TALK",
            "narrator": "ガブリエラ",
            "text": "…そっか。",
            "zh": "……这样啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "318/TALK",
            "narrator": "アーヤ",
            "text": "で？　そんなことが\n聞きたかったの？",
            "zh": "怎么？你就想听\n这种话吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "319/TALK",
            "narrator": "ガブリエラ",
            "text": "か、確認よ、確認！",
            "zh": "是、是确认啦，确认！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "320/TALK",
            "narrator": "ガブリエラ",
            "text": "最近、あたしのこと\n過小評価してるみたい\nだったから…。",
            "zh": "因为你最近\n好像一直在低估我的\n实力嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "321/TALK",
            "narrator": "アーヤ",
            "text": "そんなことないから。\nほら、ギャヴィも早く\n部屋に戻りなさい。",
            "zh": "才没有那回事呢。\n好啦，加维也快点\n回房间吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ…。",
            "zh": "呼呼……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "327/TALK",
            "narrator": "ガブリエラ",
            "text": "やった…やった！！",
            "zh": "太好了……太好了！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "328/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤの背中、\nあたしに任せられる\nって！！",
            "zh": "她说绫水的后背，\n可以放心地\n托付给我呢！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "329/TALK",
            "narrator": "ガブリエラ",
            "text": "最高の気分だわ。\nさっきまでの嫌な\n気分がウソみたい！",
            "zh": "心情简直棒透了。\n刚才那股烦闷的劲儿\n就像做梦一样！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "330/TALK",
            "narrator": "ガブリエラ",
            "text": "今夜はいい夢が\n見られそう。\n早く帰ろ。",
            "zh": "今晚感觉能做个\n好梦呢。\n快点回去吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "338/TALK",
            "narrator": "ガブリエラ",
            "text": "…服を着るのが\n先だったわ。",
            "zh": "……得先把衣服\n穿上才行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "339/ACT",
            "narrator": "",
            "text": "見つめて「好き」とだけ言え",
            "zh": "盯着她只说一句“喜欢”",
            "narrator_zh": ""
        },
        {
            "location": "358/TALK",
            "narrator": "ガブリエラ",
            "text": "何を言っているの！？",
            "zh": "你在胡说什么呢！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "360/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナ、もしかしておかしくなっちゃったの？",
            "zh": "玛尔赞娜，你该不会是脑子坏掉了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "362/SEL",
            "narrator": "",
            "text": "ガブリエラのためを思って言っているのです",
            "zh": "我也是为了加布里埃拉好才这么说的",
            "narrator_zh": ""
        },
        {
            "location": "363/ACT",
            "narrator": "",
            "text": "ガブリエラのためを思って言っているのです",
            "zh": "我也是为了加布里埃拉好才这么说的",
            "narrator_zh": ""
        },
        {
            "location": "365/TALK",
            "narrator": "ガブリエラ",
            "text": "どこが？",
            "zh": "哪里好了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "366/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、どこかおかしくなったようにしか思えないんだけれど？",
            "zh": "果然怎么看都像是哪根筋搭错了好吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "368/SEL",
            "narrator": "",
            "text": "私が誰か、忘れてしまったのですか？",
            "zh": "你难道已经忘记我是谁了吗？",
            "narrator_zh": ""
        },
        {
            "location": "369/ACT",
            "narrator": "",
            "text": "私が誰か、忘れてしまったのですか？",
            "zh": "你难道已经忘记我是谁了吗？",
            "narrator_zh": ""
        },
        {
            "location": "371/TALK",
            "narrator": "ガブリエラ",
            "text": "忘れてないわ",
            "zh": "才没忘呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "372/TALK",
            "narrator": "ガブリエラ",
            "text": "忘れてないけれど、意味がわからないのよ",
            "zh": "虽然没忘，可你这话完全莫名其妙啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "374/SEL",
            "narrator": "",
            "text": "言いたくないのなら、構いませんが？",
            "zh": "你要是不想说，那就算了吧？",
            "narrator_zh": ""
        },
        {
            "location": "375/ACT",
            "narrator": "",
            "text": "言いたくないのなら、構いませんが？",
            "zh": "你要是不想说，那就算了吧？",
            "narrator_zh": ""
        },
        {
            "location": "377/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと待って",
            "zh": "等一下",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "378/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナは、それを言ったらどうなるかがわかっているんでしょう？",
            "zh": "玛尔赞娜，你肯定知道说出口之后会怎么样对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "379/TALK",
            "narrator": "ガブリエラ",
            "text": "なら、その結果を教えてちょうだい",
            "zh": "既然这样，就把结果告诉我嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "381/SEL",
            "narrator": "",
            "text": "神託は、素晴らしい未来の示唆しかできない",
            "zh": "神谕只能启示美好的未来",
            "narrator_zh": ""
        },
        {
            "location": "382/ACT",
            "narrator": "",
            "text": "神託は、素晴らしい未来の示唆しかできない",
            "zh": "神谕只能启示美好的未来",
            "narrator_zh": ""
        },
        {
            "location": "384/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとくらい教えてくれてもいいじゃない！",
            "zh": "稍微透露一点不也没什么关系嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "385/TALK",
            "narrator": "ガブリエラ",
            "text": "お願いよ、マルザンナ！",
            "zh": "拜托了，玛尔赞娜！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "387/SEL",
            "narrator": "",
            "text": "信じる者は救われる。では、検討を祈る",
            "zh": "信者得救。那么，祝你好运",
            "narrator_zh": ""
        },
        {
            "location": "388/ACT",
            "narrator": "",
            "text": "信じる者は救われる。では、検討を祈る",
            "zh": "信者得救。那么，祝你好运",
            "narrator_zh": ""
        },
        {
            "location": "390/TALK",
            "narrator": "ガブリエラ",
            "text": "待ってマルz",
            "zh": "等等玛尔z",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "394/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、ウソでしょ！？\n強制終了するなんて！",
            "zh": "喂、不是吧！？\n居然直接强制下线了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "399/TALK",
            "narrator": "ガブリエラ",
            "text": "どどどどうしよう。\n好きだなんて、\nそんなこと――",
            "zh": "怎怎怎怎么办啊。\n说什么喜欢什么的，\n那种话——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "400/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、そりゃまあ\n好きだけど、でも\n直接伝えるなんて…。",
            "zh": "唔，虽说喜欢\n确实是喜欢啦，可要我\n当面说出口什么的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "401/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、いい結果に\nなるから言われたの\nかもしれないし…。",
            "zh": "不过，说不定真的是因为\n会有好结果\n才让我这么说的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "404/TALK",
            "narrator": "アーヤ",
            "text": "あら、まだいたの？\n早く服着ないと\n湯冷めするわよ？",
            "zh": "哎呀，你还在呢？\n不快点把衣服穿上\n会着凉的哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "407/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、アーヤ！",
            "zh": "绫、绫水！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "409/TALK",
            "narrator": "アーヤ",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "411/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うん…。\nあの…あたし…。",
            "zh": "嗯、嗯……。\n那个……我……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "413/TALK",
            "narrator": "アーヤ",
            "text": "……？",
            "zh": "……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "414/SEL",
            "narrator": "",
            "text": "早く言いなさい",
            "zh": "快点说呀",
            "narrator_zh": ""
        },
        {
            "location": "416/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、ね…？\nあ、あああ、アーヤの\nことが…。",
            "zh": "我、我呢……？\n对、对对对、对绫水\n她……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "417/TALK",
            "narrator": "アーヤ",
            "text": "私？\n私がどうしたの？",
            "zh": "我？\n我怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "418/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "419/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "424/TALK",
            "narrator": "ガブリエラ",
            "text": "い、言えないわよ！！\nマルザンナのバカー！",
            "zh": "说、说不出口啦！！\n玛尔赞娜大笨蛋——！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "426/TALK",
            "narrator": "アーヤ",
            "text": "は、はぁ！？\nマルザンナって誰！？",
            "zh": "哈、哈啊！？\n玛尔赞娜是谁啊！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "429/TALK",
            "narrator": "アーヤ",
            "text": "って、ギャヴィ！！\n服！！　バスタオルで\n外に出る気！？",
            "zh": "不对，加维！！\n衣服！！你打算就围条\n浴巾跑出去吗！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "431/ACT",
            "narrator": "",
            "text": "早く言いなさい",
            "zh": "快点说呀",
            "narrator_zh": ""
        },
        {
            "location": "436/TALK",
            "narrator": "ガブリエラ",
            "text": "もう！\nわかってるわよ！",
            "zh": "真是的！\n我知道啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "437/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対これ催促だわ。\n他人事だと思って…！",
            "zh": "这绝对是在催我吧。\n真会站着说话不腰疼……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "438/TALK",
            "narrator": "アーヤ",
            "text": "…それで、話って？",
            "zh": "……所以，你想说什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "440/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あああ、あの！\nあの、ね――",
            "zh": "那、那那那、那个！\n那个，呢——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "442/TALK",
            "narrator": "ガブリエラ",
            "text": "…………す、好き。",
            "zh": "…………喜、喜欢你。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "443/TALK",
            "narrator": "アーヤ",
            "text": "ん？　そう。\n私もギャヴィのこと\n好きよ。",
            "zh": "嗯？这样啊。\n我也喜欢\n加维哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "448/TALK",
            "narrator": "ガブリエラ",
            "text": "……へ？",
            "zh": "……哎？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "451/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ。\nいつも頑張ってくれて\nありがとう。",
            "zh": "呵呵。\n谢谢你平时一直\n这么努力。",
            "narrator_zh": "绫水"
        },
        {
            "location": "452/TALK",
            "narrator": "ガブリエラ",
            "text": "…が、頑張る？",
            "zh": "……努、努力？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "453/TALK",
            "narrator": "ガブリエラ",
            "text": "え？　何これ？\nどういうこと？",
            "zh": "哎？怎么回事？\n这是什么情况？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "454/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤもあたしのこと\n好きって…。",
            "zh": "绫水也说\n喜欢我什么的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "455/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、頑張って\nくれてって…っ！？",
            "zh": "话说回来，什么叫\n这么努力啊……！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "456/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか、普段から\nラブアタック\n頑張ってたの――",
            "zh": "难道说，我平时一直在\n努力发起\n爱的进攻的事——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "457/TALK",
            "narrator": "ガブリエラ",
            "text": "バレバレだった！？",
            "zh": "早就暴露了吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "460/TALK",
            "narrator": "ガブリエラ",
            "text": "ち、違うから！！\n頑張ってアタック\nなんかしてないわ！",
            "zh": "才、才不是那样！！\n我才没有努力\n发起什么进攻呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "463/TALK",
            "narrator": "アーヤ",
            "text": "そうなの？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "464/TALK",
            "narrator": "アーヤ",
            "text": "いつも、ここぞという\nところでアタックして\nくれてるから――",
            "zh": "因为你总是在最关键的\n时候果断发起进攻\n嘛——",
            "narrator_zh": "绫水"
        },
        {
            "location": "465/TALK",
            "narrator": "アーヤ",
            "text": "正直、惚れちゃう時も\nあるくらいなん\nだけど。",
            "zh": "说实话，有时帅得\n连我都要被迷住了\n呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "467/TALK",
            "narrator": "ガブリエラ",
            "text": "…え、えぇっ！？",
            "zh": "……哎、哎哎！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "469/TALK",
            "narrator": "ガブリエラ",
            "text": "な、何、この展開！？\n急過ぎて、何が何だか\nわからないんだけど？",
            "zh": "什、什么呀这展开！？\n也太突然了，搞得我都\n一头雾水了啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "470/TALK",
            "narrator": "ガブリエラ",
            "text": "でもこれ、超急接近\nしてるってことよね？",
            "zh": "不过这样岂不是说明，\n我们正超急速拉近距离中？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "472/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、アーヤも\n好きってことは…、\n両想い！？",
            "zh": "话说，绫水也说\n喜欢我的话……，\n岂不是两情相悦！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "474/TALK",
            "narrator": "ガブリエラ",
            "text": "ああああ、あの、\nアーヤ！\nあたし――",
            "zh": "那那那那、那个，\n绫水！\n我——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "477/TALK",
            "narrator": "アーヤ",
            "text": "今日の戦闘の時も\n凄かったわ。",
            "zh": "今天的战斗也是\n超级厉害呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "478/TALK",
            "narrator": "アーヤ",
            "text": "あのおとり作戦の時の\n一撃必殺アタック、\n惚れ惚れしちゃった。",
            "zh": "诱饵作战时那记\n一击必杀的进攻，\n真是让人看得入迷。",
            "narrator_zh": "绫水"
        },
        {
            "location": "480/TALK",
            "narrator": "ガブリエラ",
            "text": "…は？　戦闘？",
            "zh": "……哈？战斗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "481/TALK",
            "narrator": "アーヤ",
            "text": "あの時のギャヴィの\n一撃がなかったら――",
            "zh": "要是没有那时加维的\n那一击——",
            "narrator_zh": "绫水"
        },
        {
            "location": "482/TALK",
            "narrator": "アーヤ",
            "text": "みやび達、\n無事じゃいられ\nなかったはずよ。",
            "zh": "雅她们\n肯定没法\n平安无事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "483/TALK",
            "narrator": "ガブリエラ",
            "text": "……は！？",
            "zh": "……哈！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "486/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、まさか…、\nもしかして今までの\n話って――",
            "zh": "难、难道说……，\n该不会刚才说的\n全都是——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "488/TALK",
            "narrator": "ガブリエラ",
            "text": "全部、戦闘のことだと\n思われてた！？",
            "zh": "被她当成是在说\n战斗的事了！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "490/TALK",
            "narrator": "ガブリエラ",
            "text": "バカバカバカ！！\nあたしのバカ！！\n最低な早とちりよ！！",
            "zh": "笨蛋笨蛋笨蛋！！\n我这个大笨蛋！！\n简直是最差劲的自作多情！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "492/TALK",
            "narrator": "アーヤ",
            "text": "流石ね、ギャヴィ。\nかっこよかったわ。",
            "zh": "真不愧是加维。\n帅呆了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "495/TALK",
            "narrator": "ガブリエラ",
            "text": "と、ととと、当然よ！\nていうかあんなの、\n全然普通だし！",
            "zh": "那、那那那、那当然了！\n再说了那种程度，\n根本是小菜一碟啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "499/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、そうよね。\nこれからも、\n期待してるわ。",
            "zh": "呵呵，就是嘛。\n今后也\n很期待你的表现哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "502/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "503/TALK",
            "narrator": "ガブリエラ",
            "text": "バトル以外の\nアタックも――",
            "zh": "战斗以外的\n进攻，也——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "505/TALK",
            "narrator": "ガブリエラ",
            "text": "たまには\n見て欲しいのに…。\nアーヤの、ばか…。",
            "zh": "希望你偶尔能\n留意一下啊……。\n绫水这个，大笨蛋……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "517/DIALOG",
            "narrator": "Dialog_chapter_ch03",
            "text": "【06 史上最愛の作戦】",
            "zh": "【06 史上最爱的作战】",
            "narrator_zh": "Dialog_chapter_ch03"
        }
    ]
}
