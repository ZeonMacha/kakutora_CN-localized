{
    "dir": "chap04/battle/btev_ch04_04_01.js",
    "type": "Other",
    "info": {
        "story_id": "60431",
        "cid": "miyabi",
        "title": "敵Ⅰ＜葛藤＞",
        "sub_title": "バトル中盤",
        "title_zh": "敌人Ⅰ＜纠葛＞",
        "sub_title_zh": "战斗中段"
    },
    "entry": [
        {
            "location": "203/SCENARIO",
            "narrator": "",
            "text": "バトル中盤",
            "zh": "战斗中段",
            "narrator_zh": ""
        },
        {
            "location": "212/TALK",
            "narrator": "潜在みやび",
            "text": "ふむ……\nやはりコイツが味方に\nついた方が勝ったか。",
            "zh": "唔……\n果然是这家伙\n入伙那边赢了咩。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "213/TALK",
            "narrator": "表層みやび",
            "text": "当然の結果やね。",
            "zh": "理所当然的结果咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "214/SEL",
            "narrator": "",
            "text": "$me$と戦ったのはどっちなの？",
            "zh": "和$me$战斗的是哪一个？",
            "narrator_zh": ""
        },
        {
            "location": "215/ACT",
            "narrator": "",
            "text": "$me$と戦ったのはどっちなの？",
            "zh": "和$me$战斗的是哪一个？",
            "narrator_zh": ""
        },
        {
            "location": "217/TALK",
            "narrator": "潜在みやび",
            "text": "それを言っちゃあ\nお終いやき。",
            "zh": "这话一说出来\n可就完蛋啵。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "218/TALK",
            "narrator": "表層みやび",
            "text": "ああ、おしまいや、\nおしまいや！",
            "zh": "啊，完蛋了，\n完蛋了！",
            "narrator_zh": "表层雅"
        },
        {
            "location": "219/TALK",
            "narrator": "潜在みやび",
            "text": "忘れないでくりゃあ。\n$handle$さんよお。",
            "zh": "可别忘了啊，\n$handle$。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "220/TALK",
            "narrator": "表層みやび",
            "text": "確かにうちとコイツ、\nどちらかはアンタの\n戦友だが――",
            "zh": "确实我和这家伙里，\n有一个是你的\n战友，但是——",
            "narrator_zh": "表层雅"
        },
        {
            "location": "221/TALK",
            "narrator": "潜在みやび",
            "text": "その上位レイヤーには\n二人の敵という\nステータスがあるきね。",
            "zh": "在更上层里，\n可是挂着“两人的敌人”\n这个状态啵。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "222/TALK",
            "narrator": "表層みやび",
            "text": "すなわち四捨五入\nすると、あんたは\n敵ってこっちゃね。",
            "zh": "换言之四舍五入\n一下，你就是\n敌人咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "223/SEL",
            "narrator": "",
            "text": "なんで$me$がみやびの敵なの？？",
            "zh": "为什么$me$是雅的敌人啊？？",
            "narrator_zh": ""
        },
        {
            "location": "224/ACT",
            "narrator": "",
            "text": "なんで$me$がみやびの敵なの？？",
            "zh": "为什么$me$是雅的敌人啊？？",
            "narrator_zh": ""
        },
        {
            "location": "226/TALK",
            "narrator": "表層みやび",
            "text": "自分の胸に\n聞いてみいや。",
            "zh": "问问你自己的\n心咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "227/TALK",
            "narrator": "潜在みやび",
            "text": "すまんがうちは、\nそんなステレオタイプ\nな質問に引っかかり――",
            "zh": "没好意思，我可不是\n会中这种刻板套路\n问题的圈套——",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "228/TALK",
            "narrator": "表層みやび",
            "text": "突然説明口調で真相を\n解説し出すような大根\nライターキャラやない。",
            "zh": "然后突然开启说明腔\n解说真相的那种\n三流写手笔下角色。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "229/TALK",
            "narrator": "潜在みやび",
            "text": "さあ、\nもう十分休んだぞね。",
            "zh": "来吧，\n歇得够久了咧。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "230/TALK",
            "narrator": "表層みやび",
            "text": "うむ。\n後半戦、行くちや！",
            "zh": "嗯。\n下半场，上滴！",
            "narrator_zh": "表层雅"
        }
    ]
}
