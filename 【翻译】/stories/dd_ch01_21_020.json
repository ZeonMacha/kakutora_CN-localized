{
    "dir": "chap21/daydra/dd_ch01_21_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "21156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "お肌ヒリヒリ",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "皮肤火辣辣"
    },
    "entry": [
        {
            "location": "295/SCENARIO",
            "narrator": "",
            "text": "お肌ヒリヒリ",
            "zh": "皮肤火辣辣",
            "narrator_zh": ""
        },
        {
            "location": "310/TALK",
            "narrator": "ガブリエラ",
            "text": "イタタタ…。",
            "zh": "痛痛痛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "313/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん、どうしたの？",
            "zh": "加布，怎么了？",
            "narrator_zh": "燕"
        },
        {
            "location": "316/TALK",
            "narrator": "ガブリエラ",
            "text": "ん～…お風呂入ってたら、\n背中がヒリヒリ痛くなって\nきちゃって…。",
            "zh": "嗯～……洗澡的时候，\n背开始火辣辣地\n疼起来了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "317/TALK",
            "narrator": "みやび",
            "text": "ちゃんと日焼け止めが\n塗れてなかったんやない？",
            "zh": "防晒是不是\n没涂好咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "318/TALK",
            "narrator": "つばめ",
            "text": "そういえば、ガブちゃん\n自分で塗ってなかった？",
            "zh": "说起来，加布\n是自己涂的吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "319/TALK",
            "narrator": "ガブリエラ",
            "text": "うっ…見てたの？",
            "zh": "呜……你看到了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "321/TALK",
            "narrator": "みやび",
            "text": "そりゃ塗れなくて当然や。\n横着せんで誰かに塗って\nもらうべきやったね。",
            "zh": "那涂不到也正常咯。\n别图省事，该让人\n帮你涂才对咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "へ、平気よ。\n身体は柔らかい方\nなんだし。",
            "zh": "我、没事的。\n身子还算\n柔韧的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "みやび",
            "text": "限度はあると思うけんど？",
            "zh": "总有个限度，但是？",
            "narrator_zh": "雅"
        },
        {
            "location": "327/TALK",
            "narrator": "ガブリエラ",
            "text": "塗る量が少なかった\nだけよ。",
            "zh": "只是涂得少了\n而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "328/TALK",
            "narrator": "つばめ",
            "text": "…あ、軟膏塗るなら\n手伝うよ。",
            "zh": "……啊，要涂药膏的话\n我来帮忙呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "331/TALK",
            "narrator": "ガブリエラ",
            "text": "いいってば。\n身体は柔らかいって…\nふんっ！　言ったでしょ？",
            "zh": "说了不用。\n身子很柔韧……\n哼！　我说过了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "332/TALK",
            "narrator": "みやび",
            "text": "…いや、全然届いて\nないちや。",
            "zh": "……不，完全\n没碰到滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "333/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん、さすがに\n無理あると思うよ？",
            "zh": "加布，这实在\n有点勉强哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "334/TALK",
            "narrator": "ガブリエラ",
            "text": "だ、大丈夫だってば！\nも、もうちょっと…\nんっ、ふんっ！",
            "zh": "没、没事的啦！\n再、再一下……\n嗯，哼！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "335/TALK",
            "narrator": "みやび",
            "text": "見てられんよ。\nほれ、軟膏貸しぃ。",
            "zh": "看不下去了。\n来，药膏拿来。",
            "narrator_zh": "雅"
        },
        {
            "location": "337/TALK",
            "narrator": "ガブリエラ",
            "text": "だ、だからいいってば！",
            "zh": "所以说不用啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "338/TALK",
            "narrator": "みやび",
            "text": "意固地になっても\nしゃぁないやろ？",
            "zh": "死撑着也\n没用咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "339/TALK",
            "narrator": "みやび",
            "text": "それとも、うちじゃ\n嫌なが？",
            "zh": "还是说，我来\n你不愿意咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "341/TALK",
            "narrator": "ガブリエラ",
            "text": "だ、だから…ああもうっ！",
            "zh": "所以说……啊真是！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "344/TALK",
            "narrator": "ガブリエラ",
            "text": "苦手なのよ…。\n背中、触られると\nムズムズしちゃって…。",
            "zh": "我受不了这个……。\n背被碰到\n就会发痒……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "345/TALK",
            "narrator": "みやび",
            "text": "…ガブちゃん、\n背中が敏感さんなんやね。",
            "zh": "……加布，\n背这么敏感咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "347/TALK",
            "narrator": "ガブリエラ",
            "text": "…わざと恥ずかしがらせ\nようとしてない？",
            "zh": "……该不是故意\n想羞我吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "348/TALK",
            "narrator": "つばめ",
            "text": "でも、このままじゃ\n痛いの中々治らないよ？",
            "zh": "可是这样下去\n疼会一直不好呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "351/TALK",
            "narrator": "ガブリエラ",
            "text": "だから頑張ってるん\nじゃない。\nもう邪魔しないで。",
            "zh": "所以我才在\n努力啊。\n别再妨碍了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "352/TALK",
            "narrator": "みやび",
            "text": "…こりゃ、明日まで\n痛み持ち越すことに\nなりそうやね。",
            "zh": "……这样下去，痛要\n拖到明天\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "355/TALK",
            "narrator": "つばめ",
            "text": "う～ん…。",
            "zh": "嗯～……。",
            "narrator_zh": "燕"
        },
        {
            "location": "367/TALK",
            "narrator": "つばめ",
            "text": "アドバイスが欲しいの",
            "zh": "想听听你的建议",
            "narrator_zh": "燕"
        },
        {
            "location": "368/TALK",
            "narrator": "つばめ",
            "text": "背中が敏感な人に、上手く軟膏を塗る方法ってないかな？",
            "zh": "背很敏感的人，有没有办法能把药膏涂好？",
            "narrator_zh": "燕"
        },
        {
            "location": "370/SEL",
            "narrator": "",
            "text": "コットンを使ったら？",
            "zh": "用化妆棉试试？",
            "narrator_zh": ""
        },
        {
            "location": "371/SEL",
            "narrator": "",
            "text": "ささっと終わらせよう",
            "zh": "赶紧涂完了事",
            "narrator_zh": ""
        },
        {
            "location": "372/SEL",
            "narrator": "",
            "text": "指先でそーっと塗ればいい",
            "zh": "用指尖轻轻涂就好",
            "narrator_zh": ""
        },
        {
            "location": "373/ACT",
            "narrator": "",
            "text": "コットンを使ったら？",
            "zh": "用化妆棉试试？",
            "narrator_zh": ""
        },
        {
            "location": "374/TALK",
            "narrator": "つばめ",
            "text": "あ、それいいアイデアだよ！",
            "zh": "啊，这个主意好！",
            "narrator_zh": "燕"
        },
        {
            "location": "375/TALK",
            "narrator": "つばめ",
            "text": "早速言ってみるね",
            "zh": "我这就去说哦",
            "narrator_zh": "燕"
        },
        {
            "location": "388/TALK",
            "narrator": "つばめ",
            "text": "ねえ、ガブちゃん。\nそれならコットンで\n塗るのはどうかな？",
            "zh": "呐，加布。\n那用化妆棉\n来涂怎么样？",
            "narrator_zh": "燕"
        },
        {
            "location": "390/TALK",
            "narrator": "ガブリエラ",
            "text": "コットン？",
            "zh": "化妆棉？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "392/TALK",
            "narrator": "みやび",
            "text": "なるほど、指やないき、\nそこまでくすぐったくは\nなさそうやね。",
            "zh": "原来如此，不是手指啵，\n应该没那么\n痒咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "393/TALK",
            "narrator": "つばめ",
            "text": "どうかな、ガブちゃん？",
            "zh": "怎么样，加布？",
            "narrator_zh": "燕"
        },
        {
            "location": "394/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね…\nそれなら平気かも。",
            "zh": "这样啊……\n那也许没事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "395/TALK",
            "narrator": "ガブリエラ",
            "text": "コットンならそこに\nあるから、\n早速やってみて。",
            "zh": "化妆棉的话那里\n就有，\n马上试试吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "399/TALK",
            "narrator": "つばめ",
            "text": "うん…。",
            "zh": "嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "405/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、始めるね。",
            "zh": "那，开始啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "408/TALK",
            "narrator": "ガブリエラ",
            "text": "服はまくらないで！\n擦れて痛いから…。",
            "zh": "衣服别卷起来！\n蹭到会疼……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "409/TALK",
            "narrator": "つばめ",
            "text": "いいよ。\nそれじゃ、塗るねー。",
            "zh": "好呀。\n那就，涂啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "414/TALK",
            "narrator": "ガブリエラ",
            "text": "うん………んっ！",
            "zh": "嗯……嗯！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "415/TALK",
            "narrator": "つばめ",
            "text": "あっ、ダメだった？",
            "zh": "啊，不行吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "417/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん、平気。\nちょっと軟膏が冷たかった\nだけだから…。",
            "zh": "不，没事。\n只是药膏有点\n凉……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "418/TALK",
            "narrator": "つばめ",
            "text": "それじゃ、続けるね。",
            "zh": "那就，继续啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "420/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "421/TALK",
            "narrator": "みやび",
            "text": "どんな感じや？",
            "zh": "感觉如何咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "423/TALK",
            "narrator": "ガブリエラ",
            "text": "うん…これならいいわ。",
            "zh": "嗯……这样可以。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "424/TALK",
            "narrator": "ガブリエラ",
            "text": "くすぐったくないし、\nでもヒリヒリするところに\nしっかり塗れてるし――",
            "zh": "也不痒，\n火辣辣的地方\n也涂到了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "425/TALK",
            "narrator": "ガブリエラ",
            "text": "結構気持ちいいかも。",
            "zh": "还挺舒服的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "426/TALK",
            "narrator": "つばめ",
            "text": "よかった…。",
            "zh": "太好了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "427/TALK",
            "narrator": "つばめ",
            "text": "今度海に行くときは、\n日焼け止めもこうやって\n塗ってあげるね。",
            "zh": "下次去海边的时候，\n防晒也这样\n帮你涂呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "429/TALK",
            "narrator": "ガブリエラ",
            "text": "助かるわ…。\nあー、これ、結構\n気持ちいい…。",
            "zh": "帮大忙了……。\n啊——这个，挺\n舒服的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "430/ACT",
            "narrator": "",
            "text": "ささっと終わらせよう",
            "zh": "赶紧涂完了事",
            "narrator_zh": ""
        },
        {
            "location": "431/TALK",
            "narrator": "つばめ",
            "text": "ささっと塗って終わらせれば、平気かな？",
            "zh": "赶紧涂完的话，就没事了吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "432/TALK",
            "narrator": "つばめ",
            "text": "ちょっと聞いてみる",
            "zh": "我去问一下",
            "narrator_zh": "燕"
        },
        {
            "location": "445/TALK",
            "narrator": "つばめ",
            "text": "じゃあさ、あんまり\nくすぐったくならない\nように――",
            "zh": "那么呀，为了别\n太痒\n——",
            "narrator_zh": "燕"
        },
        {
            "location": "446/TALK",
            "narrator": "つばめ",
            "text": "ささっと塗って終わらせる\nっていうのはどうかな？",
            "zh": "赶紧涂完就结束\n怎么样？",
            "narrator_zh": "燕"
        },
        {
            "location": "449/TALK",
            "narrator": "ガブリエラ",
            "text": "ささっとって、\nどれくらいささっと？",
            "zh": "赶紧是\n有多赶紧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "450/TALK",
            "narrator": "つばめ",
            "text": "手のひらに軟膏塗って、\nそれでさっと背中を\n一撫でするよ。",
            "zh": "药膏涂在手心，\n然后在背上\n轻轻抚一下呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "451/TALK",
            "narrator": "みやび",
            "text": "手の平ならマシな方やと\n思うけんど？",
            "zh": "用手掌的话好一点，\n但是？",
            "narrator_zh": "雅"
        },
        {
            "location": "452/TALK",
            "narrator": "みやび",
            "text": "早く治すためにも、\nその方がえいと思うがよ。",
            "zh": "要快点好起来，\n那样才好咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "453/TALK",
            "narrator": "ガブリエラ",
            "text": "…わかったわ。\nでも、本当にささっと\n終わらせてよ？",
            "zh": "……知道了。\n不过，真的要赶紧\n结束哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "458/TALK",
            "narrator": "つばめ",
            "text": "うん、約束するよ。",
            "zh": "嗯，我保证。",
            "narrator_zh": "燕"
        },
        {
            "location": "466/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、始めるね。",
            "zh": "那，开始啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "469/TALK",
            "narrator": "ガブリエラ",
            "text": "服はまくらないで！\n擦れて痛いから…。",
            "zh": "衣服别卷起来！\n蹭到会疼……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "471/TALK",
            "narrator": "つばめ",
            "text": "いいよ。\nそれじゃ、塗るねー。",
            "zh": "好呀。\n那就，涂啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "474/TALK",
            "narrator": "ガブリエラ",
            "text": "超適当でいいから。\n本当、すぐ終わらせてよ？",
            "zh": "随便涂涂就行。\n真的，马上结束哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "475/TALK",
            "narrator": "つばめ",
            "text": "うん…行きまーす。",
            "zh": "嗯……涂啦——。",
            "narrator_zh": "燕"
        },
        {
            "location": "477/TALK",
            "narrator": "ガブリエラ",
            "text": "うんっ…ひぁっ！？",
            "zh": "嗯……呀！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "478/TALK",
            "narrator": "つばめ",
            "text": "大丈夫？\nすぐ終わるからね。",
            "zh": "没事吧？\n马上就好啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "しゃ、喋ってないで、\n早く塗って！",
            "zh": "别、别说话，\n快点涂！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "482/TALK",
            "narrator": "つばめ",
            "text": "もう終わるよ…。",
            "zh": "马上好了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "483/TALK",
            "narrator": "つばめ",
            "text": "はい、おしまい。",
            "zh": "好，涂完了。",
            "narrator_zh": "燕"
        },
        {
            "location": "486/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぅ…ちゃんと塗れた？",
            "zh": "呼……涂好了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "487/TALK",
            "narrator": "つばめ",
            "text": "さっ、とだけどね。",
            "zh": "就、一下下哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "488/TALK",
            "narrator": "つばめ",
            "text": "心配だから、\nもう一回くらい\n塗った方が――",
            "zh": "我有点不放心，\n再涂一次\n比较好——",
            "narrator_zh": "燕"
        },
        {
            "location": "490/TALK",
            "narrator": "ガブリエラ",
            "text": "い、いいから！\nもう触らないで！",
            "zh": "不、不用了！\n别再碰了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "493/TALK",
            "narrator": "ガブリエラ",
            "text": "とりあえず塗れてるなら\nそれでいいから。\n助かったわ、ありがと。",
            "zh": "反正涂上了\n就行。\n帮大忙了，谢谢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "494/TALK",
            "narrator": "つばめ",
            "text": "う、うん…。",
            "zh": "嗯、嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "495/TALK",
            "narrator": "みやび",
            "text": "ちょっと警戒し過ぎや\nないが？",
            "zh": "是不是有点\n太警惕了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "498/TALK",
            "narrator": "ガブリエラ",
            "text": "仕方ないでしょ？\n本当に苦手なんだから…。",
            "zh": "那有什么办法？\n我真的很怕这个……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "501/TALK",
            "narrator": "ガブリエラ",
            "text": "…それに、これ以上\n触られたら、また声が\n出ちゃいそうだし。",
            "zh": "……而且，再被碰的话，\n好像又要\n叫出声了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "503/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、自分で塗る\n方法を探さないと\nダメね…。",
            "zh": "果然，还是得自己\n找办法涂\n才行……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "504/ACT",
            "narrator": "",
            "text": "指先でそーっと塗ればいい",
            "zh": "用指尖轻轻涂就好",
            "narrator_zh": ""
        },
        {
            "location": "506/TALK",
            "narrator": "つばめ",
            "text": "そーっと塗れば、大丈夫なの？",
            "zh": "轻轻涂的话，就没事了？",
            "narrator_zh": "燕"
        },
        {
            "location": "507/TALK",
            "narrator": "つばめ",
            "text": "わかった、出来る限り優しくやってみるね",
            "zh": "知道了，我会尽量轻轻地来哦",
            "narrator_zh": "燕"
        },
        {
            "location": "519/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん、やっぱり\nわたしが塗るよ。",
            "zh": "加布，还是\n我来涂呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "520/TALK",
            "narrator": "つばめ",
            "text": "なるべくくすぐったく\nならないように塗るから、\nそれなら大丈夫でしょ？",
            "zh": "我会尽量涂得\n不痒的，\n这样总可以了吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "523/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "526/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、みやびがやるよりは\n安心できそうね。",
            "zh": "嘛，比起雅来做\n还比较放心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "527/TALK",
            "narrator": "みやび",
            "text": "本人の前で言うことか？",
            "zh": "当着本人的面说？",
            "narrator_zh": "雅"
        },
        {
            "location": "530/TALK",
            "narrator": "ガブリエラ",
            "text": "だって、絶対わざと\nくすぐったりしそう\nだし。",
            "zh": "因为你绝对会\n故意挠痒\n的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "532/TALK",
            "narrator": "みやび",
            "text": "やりはするけんど、\nちっくとだけやぞ？",
            "zh": "会做是会做，但是\n就等子一下咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "534/TALK",
            "narrator": "ガブリエラ",
            "text": "多い少ないの\n問題じゃない！",
            "zh": "这不是多和少\n的问题！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "536/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当、冗談抜きで\n背中弱いから、頼むわよ？",
            "zh": "……说真的，不开玩笑，\n我的背很弱，拜托了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "540/TALK",
            "narrator": "つばめ",
            "text": "うん…。",
            "zh": "嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "545/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、始めるね。",
            "zh": "那，开始啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "548/TALK",
            "narrator": "ガブリエラ",
            "text": "服はまくらないで！\n擦れて痛いから…。",
            "zh": "衣服别卷起来！\n蹭到会疼……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "549/TALK",
            "narrator": "つばめ",
            "text": "いいよ。\nそれじゃ、始めるね。",
            "zh": "好呀。\n那就，开始啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "551/TALK",
            "narrator": "つばめ",
            "text": "えっと、軟膏を指先に\n付けて、そーっと\n塗っていけば…。",
            "zh": "那个，药膏沾在指尖，\n然后轻轻地\n涂上去……。",
            "narrator_zh": "燕"
        },
        {
            "location": "555/TALK",
            "narrator": "ガブリエラ",
            "text": "っひ！？　ひゃぅんっ！",
            "zh": "噫！？　呀嗯！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "556/TALK",
            "narrator": "みやび",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": "雅"
        },
        {
            "location": "561/TALK",
            "narrator": "ガブリエラ",
            "text": "ば、バカー！！\nなんて塗り方してんのよ？",
            "zh": "笨、笨蛋！！\n你这是什么涂法？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "564/TALK",
            "narrator": "つばめ",
            "text": "あ、あれ？\nくすぐったかった？",
            "zh": "咦、咦？\n很痒吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "565/TALK",
            "narrator": "ガブリエラ",
            "text": "聞くな！",
            "zh": "别问！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "568/TALK",
            "narrator": "ガブリエラ",
            "text": "ああ、もぉ！\nすっごい恥ずかしい声\n出ちゃったし…。",
            "zh": "啊，真是的！\n发出了超级\n丢人的声音……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "569/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん。\nあれは狙ったが？",
            "zh": "燕。\n刚才是故意的咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "573/TALK",
            "narrator": "つばめ",
            "text": "あの、何の話をしてるのか\nさっぱりなんですけど…。",
            "zh": "那个，你们在说什么\n我完全没听懂……。",
            "narrator_zh": "燕"
        },
        {
            "location": "577/TALK",
            "narrator": "ガブリエラ",
            "text": "敏感って言ってるのに、\nどうして指先なんかで\n塗るのよ！？",
            "zh": "都说很敏感了，\n为什么要用指尖\n来涂啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "581/TALK",
            "narrator": "ガブリエラ",
            "text": "ううっ、なんかまだ\n背中にムズムズした\n感じがする…。",
            "zh": "呜呜，总觉得背上\n还有痒痒的\n感觉……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "584/TALK",
            "narrator": "つばめ",
            "text": "…よくわからないけど、\nゆっくり塗るのって\n失敗だったみたい。",
            "zh": "……虽然不太明白，\n慢慢涂\n好像失败了。",
            "narrator_zh": "燕"
        },
        {
            "location": "586/TALK",
            "narrator": "つばめ",
            "text": "ごめんね、ガブちゃん。\nわたしの塗り方が\n下手で…。",
            "zh": "对不起，加布。\n是我涂得\n太差了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "589/TALK",
            "narrator": "ガブリエラ",
            "text": "もぉ、つばめのバカ！",
            "zh": "真是的，燕这个笨蛋！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "591/TALK",
            "narrator": "ガブリエラ",
            "text": "悪気がないのはわかってる\nけど、もう少し考えて\nやってよ…。",
            "zh": "我知道你没有恶意，\n不过能不能\n稍微想一下再做……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "592/TALK",
            "narrator": "みやび",
            "text": "しっかし、ガブちゃんも\nあんなに色っぽい声が\n出せるお年頃なんやね？",
            "zh": "不过，加布也到了\n能发出那么娇媚的声音\n的年纪咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "594/TALK",
            "narrator": "みやび",
            "text": "うち、ちっくと\n感動したがよ。",
            "zh": "我等子\n感动了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "595/TALK",
            "narrator": "ガブリエラ",
            "text": "言わないでってば！\n本当、恥ずかしいのに…。",
            "zh": "别说了啦！\n真的，很丢人的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "307/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月21日　 10:12 PM</color>\n合宿中、みやびの実家でのこと",
            "zh": "<color=green>8月21日　 10:12 PM</color>\n合宿期间，在雅的老家",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
