            "narrator_zh": ""
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "その黒い森の中には",
            "zh": "在那座黑森林里",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "ガブリエラ",
            "text": "雪よりも輝く毛並みを持つ",
            "zh": "有着比雪还亮的毛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "267/TALK",
            "narrator": "ガブリエラ",
            "text": "白銀の狼が住んでいました",
            "zh": "住着一只银白的狼",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "ただ一匹で住んでいました",
            "zh": "只住着它一只",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "278/SEL",
            "narrator": "",
            "text": "狼って群れで生活するんだよ",
            "zh": "狼是成群生活的",
            "narrator_zh": ""
        },
        {
            "location": "279/SEL",
            "narrator": "",
            "text": "新作だね",
            "zh": "新编的吧",
            "narrator_zh": ""
        },
        {
            "location": "280/SEL",
            "narrator": "",
            "text": "その狼は$me$？",
            "zh": "那只狼是$me$？",
            "narrator_zh": ""
        },
        {
            "location": "286/ACT",
            "narrator": "",
            "text": "狼って群れで生活するんだよ",
            "zh": "狼是成群生活的",
            "narrator_zh": ""
        },
        {
            "location": "287/TALK",
            "narrator": "ガブリエラ",
            "text": "お話だから",
            "zh": "这是在讲故事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "288/TALK",
            "narrator": "ガブリエラ",
            "text": "これでいいのよ",
            "zh": "这样就可以",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/ACT",
            "narrator": "",
            "text": "新作だね",
            "zh": "新编的吧",
            "narrator_zh": ""
        },
        {
            "location": "290/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなの",
            "zh": "对",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "新しい話を思いついたの",
            "zh": "我想到一个新故事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "292/ACT",
            "narrator": "",
            "text": "その狼は$me$？",
            "zh": "那只狼是$me$？",
            "narrator_zh": ""
        },
        {
            "location": "305/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり/////////////////////////",
            "zh": "果然/////////////////////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "306/TALK",
            "narrator": "ガブリエラ",
            "text": "わかっちゃったかしらvvvvvvvvvvvvvv",
            "zh": "被你看出来了吗vvvvvvvvvvvvvv",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "307/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなのよ///////////////////////////////////",
            "zh": "就是这样///////////////////////////////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "312/TALK",
            "narrator": "ガブリエラ",
            "text": "その狼は",
            "zh": "那只狼",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "313/TALK",
            "narrator": "ガブリエラ",
            "text": "ある時娘を見かけました",
            "zh": "有一次看见了一个女孩",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "314/TALK",
            "narrator": "ガブリエラ",
            "text": "森の奥の花咲く場所にやってきた",
            "zh": "她来到森林深处花开的地方",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "315/TALK",
            "narrator": "ガブリエラ",
            "text": "一人の娘を",
            "zh": "一个独自的女孩",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "317/SEL",
            "narrator": "",
            "text": "それがガブリエラ？",
            "zh": "那就是加布里埃拉？",
            "narrator_zh": ""
        },
        {
            "location": "318/SEL",
            "narrator": "",
            "text": "逃げてー娘逃げてー",
            "zh": "快跑，女孩，快跑",
            "narrator_zh": ""
        },
        {
            "location": "319/ACT",
            "narrator": "",
            "text": "それがガブリエラ？",
            "zh": "那就是加布里埃拉？",
            "narrator_zh": ""
        },
        {
            "location": "322/TALK",
            "narrator": "ガブリエラ",
            "text": "もちろんよ//////////////",
            "zh": "当然//////////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "323/ACT",
            "narrator": "",
            "text": "逃げてー娘逃げてー",
            "zh": "快跑，女孩，快跑",
            "narrator_zh": ""
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "そういう話じゃないのよ",
            "zh": "不是那种故事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "ガブリエラ",
            "text": "もう！",
            "zh": "真是！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "327/TALK",
            "narrator": "ガブリエラ",
            "text": "狼と娘は",
            "zh": "狼和女孩",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "330/TALK",
            "narrator": "ガブリエラ",
            "text": "一目見た時に恋に落ち",
            "zh": "看第一眼就爱上了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "331/TALK",
            "narrator": "ガブリエラ",
            "text": "末永く幸せに",
            "zh": "从此长久地幸福",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "332/TALK",
            "narrator": "ガブリエラ",
            "text": "とても幸せに暮らしました",
            "zh": "生活得非常幸福",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "334/TALK",
            "narrator": "ガブリエラ",
            "text": "これは私と$handle$の",
            "zh": "这是我和$handle$的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "335/TALK",
            "narrator": "ガブリエラ",
            "text": "恋の物語",
            "zh": "恋爱故事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "283/DIALOG",
            "narrator": "Tutorial/Dialog_Tutorial_Candy",
            "text": "彼女たちとの会話では\n<color=red>【ココロキャンディ】</color>という\nものを消費して先へ進む。\n\n足りない場合、ジュエルで買うか、\nバトル等で貯めてからストーリーを\n再挑戦することになるから注意。\n\n<color=green>今回だけは使っても減らないから、\n好きな選択肢を選んでみて。</color>",
            "zh": "和她们聊天时，\n会消耗<color=red>【心之糖果】</color>，\n才能继续往下。\n\n不够的话，就用珠宝买，\n或者靠战斗之类攒够，\n再重打这段剧情。注意。\n\n<color=green>只有这一次，用了也不会减少，\n挑你想选的就行。</color>",
            "narrator_zh": "Tutorial/Dialog_Tutorial_Candy"
        },
        {
            "location": "302/DIALOG",
            "narrator": "Tutorial/Dialog_Tutorial_Love2",
            "text": "<color=red>【親密度】</color>を沢山貯めると\n彼女との関係性が変化していく。\n\n<color=green>【友達】</color>になり<color=orange>【恋人】</color>になり…\n更にその先まで発展するかも。\n頑張ってハートを集めて欲しい。\n\n集めたハートは<color=red>【PROFILE】</color>で\n確認できるわ。",
            "zh": "<color=red>【亲密度】</color>攒得多了，\n和她的关系就会变化。\n\n会变成<color=green>【朋友】</color>，再变成<color=orange>【恋人】</color>……\n也许还能再往前走。\n好好把爱心攒起来吧。\n\n攒下的爱心，在<color=red>【PROFILE】</color>\n里就能看到。",
            "narrator_zh": "Tutorial/Dialog_Tutorial_Love2"
        },
        {
            "location": "310/DIALOG",
            "narrator": "Tutorial/Dialog_Tutorial_Camera",
            "text": "そうそう、ひとつお得情報。\n<color=red>カメラボタンを押すことで、\n彼女を見守る視点を変えられる。</color>\n\n今回はお試しでカメラを５つ\n用意しておいた。\n実際には<color=green>ゴキゲンポイント</color>で\n交換して増やしていくことに\nなるから、今のうちにいっぱい\n堪能しておくといいと思う。",
            "zh": "对了，告诉你一件有用的。\n<color=red>按下相机按钮，\n就能换一个看着她的视角。</color>\n\n这次试用，准备了5个\n相机。\n实际上要用<color=green>心情点数</color>\n来兑换，再慢慢增加。\n所以趁现在，\n多看个够就好。",
            "narrator_zh": "Tutorial/Dialog_Tutorial_Camera"
        }
    ]
}
