  {
   "location": "48/ACT",
   "narrator": "",
   "text": "エモーショナルな方がいいよー",
   "zh": "还是感性一点好——",
   "narrator_zh": ""
  },
  {
   "location": "58/TALK",
   "narrator": "みやび",
   "text": "英語で言えばいいというものではない"
  },
  {
   "location": "60/TALK",
   "narrator": "みやび",
   "text": "正確にはカタカナか"
  },
  {
   "location": "62/SEL",
   "narrator": "",
   "text": "なんで急にそんなこと言うの",
   "zh": "怎么突然说这种话",
