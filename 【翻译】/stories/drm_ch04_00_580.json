   "zh": "讲点逻辑",
   "narrator_zh": ""
  },
  {
   "location": "39/TALK",
   "narrator": "みやび",
   "text": "そう",
   "zh": "对",
   "narrator_zh": "雅"
  },
  {
   "location": "40/TALK",
   "narrator": "みやび",
   "text": "人は思考する生き物だ"
  },
  {
   "location": "41/TALK",
   "narrator": "みやび",
   "text": "感情的にならず"
  },
  {
   "location": "42/TALK",
   "narrator": "みやび",
   "text": "論理的に行こう"
  },
  {
   "location": "43/ACT",
   "narrator": "",
   "text": "いつもクールだよ",
   "zh": "一直都这么冷静哦",
   "narrator_zh": ""
  },
  {
   "location": "44/TALK",
   "narrator": "みやび",
   "text": "そうじゃろうか",
   "zh": "会是这样嘛",
   "narrator_zh": "雅"
  },
  {
   "location": "45/TALK",
   "narrator": "みやび",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "46/TALK",
   "narrator": "みやび",
   "text": "今後はその方向で"
  },
  {
   "location": "47/TALK",
   "narrator": "みやび",
   "text": "よろしく頼む",
   "zh": "拜托了",
