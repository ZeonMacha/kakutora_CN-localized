    "entry": [
        {
            "location": "2724/SCENARIO",
            "narrator": "",
            "text": "もう無理だから",
            "zh": "因为已经不行了",
            "narrator_zh": ""
        },
        {
            "location": "2734/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃん……。",
            "zh": "神乐酱……",
            "narrator_zh": "燕"
        },
        {
            "location": "2735/TALK",
            "narrator": "つばめ",
            "text": "あれは本当に\n神楽ちゃんの\nお母さんなの…？",
            "zh": "那个人真的是\n神乐的\n妈妈吗……？",
            "narrator_zh": "燕"
        },
        {
            "location": "2736/TALK",
            "narrator": "つばめ",
            "text": "本当のお母さんが\nあんなことをするの？",
            "zh": "亲生妈妈\n会做出那种事吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "2737/TALK",
            "narrator": "つばめ",
            "text": "…怖い………。\nなんで\nあんなこと……。",
            "zh": "……好可怕………。\n为什么\n会那样……。",
            "narrator_zh": "燕"
        },
        {
            "location": "2738/TALK",
            "narrator": "つばめ",
            "text": "…わたしに\nできることは\nないのかな……。",
            "zh": "……我能做的事\n是不是\n根本就没有呢……。",
            "narrator_zh": "燕"
        },
        {
            "location": "2740/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃん……。",
            "zh": "神乐酱……",
            "narrator_zh": "燕"
        },
        {
            "location": "2752/TALK",
            "narrator": "神楽",
            "text": "……痛い……。",
            "zh": "……好痛……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2753/TALK",
            "narrator": "神楽",
            "text": "切れたところ\n冷やさないと\n腫れちゃう…。",
            "zh": "划破的地方\n得冷敷一下，\n不然会肿的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2754/TALK",
            "narrator": "神楽",
            "text": "……でも\nもうちょっと\nだけ……。",
            "zh": "……不过\n再稍微\n歇一下……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2755/SEL",
            "narrator": "",
            "text": "大丈夫？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "2756/ACT",
            "narrator": "",
            "text": "大丈夫？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "2765/TALK",
            "narrator": "神楽",
            "text": "そう見える？",
            "zh": "看起来像吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2767/SEL",
            "narrator": "",
            "text": "ごめん",
            "zh": "抱歉",
            "narrator_zh": ""
        },
        {
            "location": "2768/SEL",
            "narrator": "",
            "text": "他になんて言っていいかわからなくて",
            "zh": "我不知道还能说什么",
            "narrator_zh": ""
        },
        {
            "location": "2769/SEL",
            "narrator": "",
            "text": "できれば$me$が代わってあげたい",
            "zh": "能换的话$me$真想跟你换",
            "narrator_zh": ""
        },
        {
            "location": "2770/ACT",
            "narrator": "",
            "text": "ごめん",
            "zh": "抱歉",
            "narrator_zh": ""
        },
        {
            "location": "2771/TALK",
            "narrator": "神楽",
            "text": "謝るくらいなら",
            "zh": "要是只会道歉的话",
            "narrator_zh": "神乐"
        },
        {
            "location": "2772/TALK",
            "narrator": "神楽",
            "text": "最初から言わないで",
            "zh": "一开始就别说了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2773/ACT",
            "narrator": "",
            "text": "他になんて言っていいかわからなくて",
            "zh": "我不知道还能说什么",
            "narrator_zh": ""
        },
        {
            "location": "2774/TALK",
            "narrator": "神楽",
            "text": "そうでしょうね",
            "zh": "应该是吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "2775/TALK",
            "narrator": "神楽",
            "text": "自分じゃないですから",
            "zh": "因为不是你自己的事嘛",
            "narrator_zh": "神乐"
        },
        {
            "location": "2776/ACT",
            "narrator": "",
            "text": "できれば$me$が代わってあげたい",
            "zh": "能换的话$me$真想跟你换",
            "narrator_zh": ""
        },
        {
            "location": "2777/TALK",
            "narrator": "神楽",
            "text": "そんなのできるわけないのに",
            "zh": "明明不可能做那种事",
            "narrator_zh": "神乐"
        },
        {
            "location": "2778/TALK",
            "narrator": "神楽",
            "text": "なんでそんなこと言うの",
            "zh": "为什么说那种话",
            "narrator_zh": "神乐"
        },
        {
            "location": "2784/TALK",
            "narrator": "神楽",
            "text": "…つばめさんは\nもう帰って\nくれたかな…。",
            "zh": "……燕\n应该已经\n回去了吧……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2785/TALK",
            "narrator": "神楽",
            "text": "帰り道\n迷ってないと\nいいけど…。",
            "zh": "回去路上\n没迷路\n就好了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2786/TALK",
            "narrator": "神楽",
            "text": "…どうでもいいか…。",
            "zh": "……算了，随便吧……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2787/SEL",
            "narrator": "",
            "text": "少し話せる？",
            "zh": "能聊几句吗？",
            "narrator_zh": ""
        },
        {
            "location": "2788/ACT",
            "narrator": "",
            "text": "少し話せる？",
            "zh": "能聊几句吗？",
            "narrator_zh": ""
        },
        {
            "location": "2797/TALK",
            "narrator": "神楽",
            "text": "ええ",
            "zh": "嗯",
            "narrator_zh": "神乐"
        },
        {
            "location": "2798/TALK",
            "narrator": "神楽",
            "text": "どうぞ",
            "zh": "请",
            "narrator_zh": "神乐"
        },
        {
            "location": "2800/SEL",
            "narrator": "",
            "text": "まず手当てをしよう",
            "zh": "先处理伤口吧",
            "narrator_zh": ""
        },
        {
            "location": "2801/SEL",
            "narrator": "",
            "text": "まだ痛いよね？",
            "zh": "还疼吧？",
            "narrator_zh": ""
        },
        {
            "location": "2802/SEL",
            "narrator": "",
            "text": "$me$にできることはないかな",
            "zh": "$me$有没有能做的事呢",
            "narrator_zh": ""
        },
        {
            "location": "2803/ACT",
            "narrator": "",
            "text": "まず手当てをしよう",
            "zh": "先处理伤口吧",
            "narrator_zh": ""
        },
        {
            "location": "2804/TALK",
            "narrator": "神楽",
            "text": "体が動いたらね",
            "zh": "等身子动得了再说吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "2805/ACT",
            "narrator": "",
            "text": "まだ痛いよね？",
            "zh": "还疼吧？",
            "narrator_zh": ""
        },
        {
            "location": "2806/TALK",
            "narrator": "神楽",
            "text": "笑えるくらい痛い",
            "zh": "痛得都要笑出来了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2807/ACT",
            "narrator": "",
            "text": "$me$にできることはないかな",
            "zh": "$me$有没有能做的事呢",
            "narrator_zh": ""
        },
        {
            "location": "2808/TALK",
            "narrator": "神楽",
            "text": "ないでしょ",
            "zh": "没有吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "2812/SEL",
            "narrator": "",
            "text": "泣いてもいいんだよ",
            "zh": "哭出来也没关系哦",
            "narrator_zh": ""
        },
        {
            "location": "2813/SEL",
            "narrator": "",
            "text": "お大事に",
            "zh": "保重",
            "narrator_zh": ""
        },
        {
            "location": "2814/SEL",
            "narrator": "",
            "text": "$me$がいるからね",
            "zh": "有$me$在嘛",
            "narrator_zh": ""
        },
        {
            "location": "2815/ACT",
            "narrator": "",
            "text": "泣いてもいいんだよ",
            "zh": "哭出来也没关系哦",
            "narrator_zh": ""
        },
        {
            "location": "2816/TALK",
            "narrator": "神楽",
            "text": "そんな気力もないです",
            "zh": "连那种力气都没有",
            "narrator_zh": "神乐"
        },
        {
            "location": "2821/ACT",
            "narrator": "",
            "text": "お大事に",
            "zh": "保重",
            "narrator_zh": ""
        },
        {
            "location": "2822/TALK",
            "narrator": "神楽",
            "text": "そうしますね",
            "zh": "我这就去做",
            "narrator_zh": "神乐"
        },
        {
            "location": "2827/ACT",
            "narrator": "",
            "text": "$me$がいるからね",
            "zh": "有$me$在嘛",
            "narrator_zh": ""
        },
        {
            "location": "2830/TALK",
            "narrator": "神楽",
            "text": "ああ",
            "zh": "啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "2831/TALK",
            "narrator": "神楽",
            "text": "いますね",
            "zh": "你在呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "2832/TALK",
            "narrator": "神楽",
            "text": "いつもあなたは",
            "zh": "你总是",
            "narrator_zh": "神乐"
        },
        {
            "location": "2833/TALK",
            "narrator": "神楽",
            "text": "私のことを監視してるんですか？",
            "zh": "是在监视我吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2836/SEL",
            "narrator": "",
            "text": "そんなつもりは…",
            "zh": "我没那个意思……",
            "narrator_zh": ""
        },
        {
            "location": "2837/SEL",
            "narrator": "",
            "text": "神楽が心配だからだよ",
            "zh": "是因为担心神乐哦",
            "narrator_zh": ""
        },
        {
            "location": "2838/SEL",
            "narrator": "",
            "text": "いちゃダメかな？",
            "zh": "黏在一起不行吗？",
            "narrator_zh": ""
        },
        {
            "location": "2839/ACT",
            "narrator": "",
            "text": "そんなつもりは…",
            "zh": "我没那个意思……",
            "narrator_zh": ""
        },
        {
            "location": "2840/TALK",
            "narrator": "神楽",
            "text": "じゃあなんでいるんですか？",
            "zh": "那你为什么会在这里？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2841/ACT",
            "narrator": "",
            "text": "神楽が心配だからだよ",
            "zh": "是因为担心神乐哦",
            "narrator_zh": ""
        },
        {
            "location": "2842/TALK",
            "narrator": "神楽",
            "text": "心配とかよく言えたものですね",
            "zh": "“担心”这种话你倒说得出口呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "2843/ACT",
            "narrator": "",
            "text": "いちゃダメかな？",
            "zh": "黏在一起不行吗？",
            "narrator_zh": ""
        },
        {
            "location": "2846/TALK",
            "narrator": "神楽",
            "text": "いいとかダメとかそういうんじゃないです",
            "zh": "不是行不行的问题",
            "narrator_zh": "神乐"
        },
        {
            "location": "2848/TALK",
            "narrator": "神楽",
            "text": "いる理由がわからないって言ってるんです",
            "zh": "我是说我不明白你在这里的理由",
            "narrator_zh": "神乐"
        },
        {
            "location": "2849/TALK",
            "narrator": "神楽",
            "text": "いる必要なんてないじゃないですか",
            "zh": "你根本没有必要在这里不是吗",
            "narrator_zh": "神乐"
        },
        {
            "location": "2851/SEL",
            "narrator": "",
            "text": "そんなことないって思いたい",
            "zh": "我倒是希望不是那样",
            "narrator_zh": ""
        },
        {
            "location": "2852/SEL",
            "narrator": "",
            "text": "神楽を好きだからじゃダメかな",
            "zh": "因为喜欢神乐就不行吗",
            "narrator_zh": ""
        },
        {
            "location": "2853/SEL",
            "narrator": "",
            "text": "心配するのはおかしいこと？",
            "zh": "担心是什么奇怪的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "2854/ACT",
            "narrator": "",
            "text": "そんなことないって思いたい",
            "zh": "我倒是希望不是那样",
            "narrator_zh": ""
        },
        {
            "location": "2855/TALK",
            "narrator": "神楽",
            "text": "じゃあそう思っててください",
            "zh": "那就请你继续那么想吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "2856/ACT",
            "narrator": "",
            "text": "神楽を好きだからじゃダメかな",
            "zh": "因为喜欢神乐就不行吗",
            "narrator_zh": ""
        },
        {
            "location": "2857/TALK",
            "narrator": "神楽",
            "text": "そんなの理由にならないですよ",
            "zh": "那种不能当理由",
            "narrator_zh": "神乐"
        },
        {
            "location": "2858/ACT",
            "narrator": "",
            "text": "心配するのはおかしいこと？",
            "zh": "担心是什么奇怪的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "2859/TALK",
            "narrator": "神楽",
            "text": "おかしいです",
            "zh": "好奇怪",
            "narrator_zh": "神乐"
        },
        {
            "location": "2860/TALK",
            "narrator": "神楽",
            "text": "絶対におかしいです",
            "zh": "绝对很奇怪",
            "narrator_zh": "神乐"
        },
        {
            "location": "2863/SEL",
            "narrator": "",
            "text": "自分をもっと大事にして",
            "zh": "要更珍惜自己一点",
            "narrator_zh": ""
        },
        {
            "location": "2864/SEL",
            "narrator": "",
            "text": "神楽がいい子なのは知ってるから",
            "zh": "因为我知道神乐是好孩子",
            "narrator_zh": ""
        },
        {
            "location": "2865/SEL",
            "narrator": "",
            "text": "今日はもう休んで",
            "zh": "今天早点休息吧",
            "narrator_zh": ""
        },
        {
            "location": "2866/ACT",
            "narrator": "",
            "text": "自分をもっと大事にして",
            "zh": "要更珍惜自己一点",
            "narrator_zh": ""
        },
        {
            "location": "2867/ACT",
            "narrator": "",
            "text": "神楽がいい子なのは知ってるから",
            "zh": "因为我知道神乐是好孩子",
            "narrator_zh": ""
        },
        {
            "location": "2868/ACT",
            "narrator": "",
            "text": "今日はもう休んで",
            "zh": "今天早点休息吧",
            "narrator_zh": ""
        },
        {
            "location": "2876/TALK",
            "narrator": "神楽",
            "text": "…何これ…。",
            "zh": "……这什么啊……。",
            "narrator_zh": "神乐"
