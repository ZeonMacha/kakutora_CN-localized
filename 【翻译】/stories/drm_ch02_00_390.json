{
 "dir": "dramatics/daydra/drm_ch02_00_390.js",
 "type": "Episode",
 "info": {
  "story_id": "2039",
  "cid": "ayami",
  "title": "らぶとーく 第39話",
  "sub_title": "雨降って"
 },
 "entry": [
  {
   "location": "305/SCENARIO",
   "narrator": "",
   "text": "雨降って"
  },
  {
   "location": "317/TALK",
   "narrator": "アーヤ",
   "text": "んー…もう少し丸い方が\n可愛いかしら？"
  },
  {
   "location": "321/TALK",
   "narrator": "アーヤ",
   "text": "はーい。\n開いてるわよー。"
  },
  {
   "location": "326/TALK",
   "narrator": "ガブリエラ",
   "text": "遅くにごめん。\n寝てた？"
  },
  {
   "location": "328/TALK",
   "narrator": "アーヤ",
   "text": "ううん、もうしばらくは\n起きてるつもりだったわ。"
  },
  {
   "location": "329/TALK",
   "narrator": "ガブリエラ",
   "text": "そう…編み物中？",
   "zh": "这样……在织毛线？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "330/TALK",
   "narrator": "アーヤ",
   "text": "うん…まあね…。"
  },
  {
   "location": "331/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "333/TALK",
   "narrator": "アーヤ",
   "text": "それより、用事は？",
   "zh": "比起那个，有什么事？",
   "narrator_zh": "绫水"
  },
  {
   "location": "335/TALK",
   "narrator": "ガブリエラ",
   "text": "あっ、うん…。\nルーズリーフが切れて、\n宿題が出来なくて…。"
  },
  {
   "location": "336/TALK",
   "narrator": "アーヤ",
   "text": "それなら机の上よ。\n少し多めに持って行って\nいいから。",
   "zh": "那些在桌上。\n多拿一些\n没关系。",
   "narrator_zh": "绫水"
  },
  {
   "location": "339/TALK",
   "narrator": "ガブリエラ",
   "text": "…ありがと。",
   "zh": "……谢谢。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "341/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "342/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "343/TALK",
   "narrator": "アーヤ",
   "text": "…ぬいぐるみよ。",
   "zh": "……是毛绒玩具哦。",
   "narrator_zh": "绫水"
  },
  {
   "location": "344/TALK",
   "narrator": "アーヤ",
   "text": "ボランティアで使う\nぬいぐるみを作ってるの。"
  },
  {
   "location": "346/TALK",
   "narrator": "ガブリエラ",
   "text": "やっぱりね。\nそれって犬かしら？"
  },
  {
   "location": "347/TALK",
   "narrator": "アーヤ",
   "text": "犬の大工さん。\n森一番の大工さん、って\n設定なの。"
  },
  {
   "location": "349/TALK",
   "narrator": "ガブリエラ",
   "text": "相変わらず、子供向けの\n話をやるみたいね。"
  },
  {
   "location": "351/TALK",
   "narrator": "アーヤ",
   "text": "幼稚園で見せる劇だもの。\n当然でしょ？"
  },
  {
   "location": "352/TALK",
   "narrator": "ガブリエラ",
   "text": "そりゃそうよね。",
   "zh": "那当然是啊。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "353/TALK",
   "narrator": "ガブリエラ",
   "text": "…続けることにしたんだ？",
   "zh": "……你决定继续下去了吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "354/TALK",
   "narrator": "アーヤ",
   "text": "…うん。\n色々あったけど、\nそういうことになったわ。"
  },
  {
   "location": "355/TALK",
   "narrator": "アーヤ",
   "text": "心配かけたわね。"
  },
  {
   "location": "357/TALK",
   "narrator": "ガブリエラ",
   "text": "べ、別に？\nそんなのしてないし。"
  },
  {
   "location": "358/TALK",
   "narrator": "ガブリエラ",
   "text": "…っていうか、それなら\n今度の劇はあたしにも\n見せなさいよ。"
  },
  {
   "location": "360/TALK",
   "narrator": "アーヤ",
   "text": "ついでに出演してくれる\nなら、考えてもいいわ。",
   "zh": "要是顺便\n能出演，我可以考虑。",
   "narrator_zh": "绫水"
  },
  {
   "location": "362/TALK",
   "narrator": "ガブリエラ",
   "text": "それはもうお断りよ！",
   "zh": "那个我已经拒绝了！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "363/TALK",
   "narrator": "ガブリエラ",
   "text": "それじゃ、戻るわ。\nルーズリーフありがとね。",
   "zh": "那么，我回去了。\n谢谢你的活页纸。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "366/TALK",
   "narrator": "アーヤ",
   "text": "…そうだ。\n$handle$さんにも\n報告しておかないと。"
  },
  {
   "location": "378/TALK",
   "narrator": "アーヤ",
   "text": "$handle$さん",
   "zh": "$handle$",
   "narrator_zh": "绫水"
  },
  {
   "location": "380/TALK",
   "narrator": "アーヤ",
   "text": "報告しておきたいことがあるの(*^o^*)"
  },
  {
   "location": "381/TALK",
   "narrator": "アーヤ",
   "text": "私達"
  },
  {
   "location": "382/TALK",
   "narrator": "アーヤ",
   "text": "ボランティアを続けることになったの＼(^O^)／"
  },
  {
   "location": "384/SEL",
   "narrator": "",
   "text": "本当に！？",
   "zh": "真的！？",
   "narrator_zh": ""
  },
  {
   "location": "385/ACT",
   "narrator": "",
   "text": "本当に！？",
   "zh": "真的！？",
   "narrator_zh": ""
  },
  {
   "location": "388/TALK",
   "narrator": "アーヤ",
   "text": "$handle$さんの助言のおかげよ(^ε^)-☆!!",
   "zh": "多亏$handle$的建议(^ε^)-☆!!",
   "narrator_zh": "绫水"
  },
  {
   "location": "389/TALK",
   "narrator": "アーヤ",
   "text": "みんなとしっかり話して"
  },
  {
   "location": "390/TALK",
   "narrator": "アーヤ",
   "text": "どうするか考えたら",
   "zh": "要是想怎么办的话",
   "narrator_zh": "绫水"
  },
  {
   "location": "391/TALK",
   "narrator": "アーヤ",
   "text": "みんな続けたいって言ってくれて"
  },
  {
   "location": "392/TALK",
   "narrator": "アーヤ",
   "text": "それなら",
   "zh": "那样的话",
   "narrator_zh": "绫水"
  },
  {
   "location": "393/TALK",
   "narrator": "アーヤ",
   "text": "続けなくちゃ勿体ない！(>_<)"
  },
  {
   "location": "394/TALK",
   "narrator": "アーヤ",
   "text": "って決まったの",
   "zh": "就这么定了",
   "narrator_zh": "绫水"
  },
  {
   "location": "396/SEL",
   "narrator": "",
   "text": "よかったね",
   "zh": "那就好",
   "narrator_zh": ""
  },
  {
   "location": "397/SEL",
   "narrator": "",
   "text": "心配してた",
   "zh": "我一直很担心",
   "narrator_zh": ""
  },
  {
   "location": "398/SEL",
   "narrator": "",
   "text": "$me$のおかけだよね！",
   "zh": "都多亏了$me$呢！",
   "narrator_zh": ""
  },
  {
   "location": "399/ACT",
   "narrator": "",
   "text": "よかったね",
   "zh": "那就好",
   "narrator_zh": ""
  },
  {
   "location": "401/TALK",
   "narrator": "アーヤ",
   "text": "雨降って地固まる",
   "zh": "雨过天晴",
   "narrator_zh": "绫水"
  },
  {
   "location": "403/TALK",
   "narrator": "アーヤ",
   "text": "ってやつね(^^",
   "zh": "是那回事呢(^^",
   "narrator_zh": "绫水"
  },
  {
   "location": "404/ACT",
   "narrator": "",
   "text": "心配してた",
   "zh": "我一直很担心",
   "narrator_zh": ""
  },
  {
   "location": "405/TALK",
   "narrator": "アーヤ",
   "text": "心配かけちゃってた？"
  },
  {
   "location": "406/TALK",
   "narrator": "アーヤ",
   "text": "ごめんなさいm(_ _)m",
   "zh": "对不起m(_ _)m",
   "narrator_zh": "绫水"
  },
  {
   "location": "407/TALK",
   "narrator": "アーヤ",
   "text": "でも",
   "zh": "不过",
   "narrator_zh": "绫水"
  },
  {
   "location": "408/TALK",
   "narrator": "アーヤ",
   "text": "もう平気よ"
  },
  {
   "location": "409/ACT",
   "narrator": "",
   "text": "$me$のおかけだよね！",
   "zh": "都多亏了$me$呢！",
   "narrator_zh": ""
  },
  {
   "location": "412/TALK",
   "narrator": "アーヤ",
   "text": "そう無邪気に言えるって凄いわね",
   "zh": "能说得这么天真，真厉害",
   "narrator_zh": "绫水"
  },
  {
   "location": "413/TALK",
   "narrator": "アーヤ",
   "text": "でも、実際そうだから",
   "zh": "不过，实际上就是这样",
   "narrator_zh": "绫水"
  },
  {
   "location": "416/TALK",
   "narrator": "アーヤ",
   "text": "詳しい話はまた今度"
  },
  {
   "location": "417/TALK",
   "narrator": "アーヤ",
   "text": "ちょっと急ぎの作業中だから",
   "zh": "我正在赶一点急活",
   "narrator_zh": "绫水"
  },
  {
   "location": "418/TALK",
   "narrator": "アーヤ",
   "text": "今夜中に完成させたいの(>_<)"
  },
  {
   "location": "420/SEL",
   "narrator": "",
   "text": "頑張ってね",
   "zh": "加油哦",
   "narrator_zh": ""
  },
  {
   "location": "421/ACT",
   "narrator": "",
   "text": "頑張ってね",
   "zh": "加油哦",
   "narrator_zh": ""
  },
  {
   "location": "424/TALK",
   "narrator": "アーヤ",
   "text": "でも",
   "zh": "不过",
   "narrator_zh": "绫水"
  },
  {
   "location": "425/TALK",
   "narrator": "アーヤ",
   "text": "一言だけ"
  },
  {
   "location": "428/TALK",
   "narrator": "ボイスメール",
   "text": "ありがとう",
   "zh": "谢谢",
   "narrator_zh": "语音信箱"
  },
  {
   "location": "456/TALK",
   "narrator": "アーヤ",
   "text": "ふぅ…。",
   "zh": "呼……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "457/TALK",
   "narrator": "アーヤ",
   "text": "…よし、頑張ろ！",
   "zh": "……好，加油！",
   "narrator_zh": "绫水"
  },
  {
   "location": "315/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>某月某日　10:55 PM</color>\nとある平日の夜、寮「とらいあんぐる」アーヤの部屋にて"
  },
  {
   "location": "440/DIALOG",
   "narrator": "Dialog_GETVoice",
   "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【ありがとう】</color>\nをゲットしました！"
  }
 ]
}
