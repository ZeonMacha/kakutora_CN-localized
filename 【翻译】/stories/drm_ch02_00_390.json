{
    "dir": "dramatics/daydra/drm_ch02_00_390.js",
    "type": "Episode",
    "info": {
        "story_id": "2039",
        "cid": "ayami",
        "title": "らぶとーく 第39話",
        "sub_title": "雨降って",
        "title_zh": "恋爱漫谈 第39话",
        "sub_title_zh": "下了雨"
    },
    "entry": [
        {
            "location": "305/SCENARIO",
            "narrator": "",
            "text": "雨降って",
            "zh": "下了雨",
            "narrator_zh": ""
        },
        {
            "location": "317/TALK",
            "narrator": "アーヤ",
            "text": "んー…もう少し丸い方が\n可愛いかしら？",
            "zh": "嗯……再圆一点\n会更可爱吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "321/TALK",
            "narrator": "アーヤ",
            "text": "はーい。\n開いてるわよー。",
            "zh": "来了。\n开着哦——",
            "narrator_zh": "绫水"
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "遅くにごめん。\n寝てた？",
            "zh": "这么晚抱歉。\n睡了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "328/TALK",
            "narrator": "アーヤ",
            "text": "ううん、もうしばらくは\n起きてるつもりだったわ。",
            "zh": "没有，我还打算\n再醒一会儿。",
            "narrator_zh": "绫水"
        },
        {
            "location": "329/TALK",
            "narrator": "ガブリエラ",
            "text": "そう…編み物中？",
            "zh": "这样……在织毛线？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "330/TALK",
            "narrator": "アーヤ",
            "text": "うん…まあね…。",
            "zh": "嗯……算是吧……",
            "narrator_zh": "绫水"
        },
        {
            "location": "331/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "それより、用事は？",
            "zh": "比起那个，有什么事？",
            "narrator_zh": "绫水"
        },
        {
            "location": "335/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ、うん…。\nルーズリーフが切れて、\n宿題が出来なくて…。",
            "zh": "啊，嗯……\n活页纸用完了，\n作业写不了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "336/TALK",
            "narrator": "アーヤ",
            "text": "それなら机の上よ。\n少し多めに持って行って\nいいから。",
            "zh": "那些在桌上。\n多拿一些\n没关系。",
            "narrator_zh": "绫水"
        },
        {
            "location": "339/TALK",
            "narrator": "ガブリエラ",
            "text": "…ありがと。",
            "zh": "……谢谢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "341/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "342/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "343/TALK",
            "narrator": "アーヤ",
            "text": "…ぬいぐるみよ。",
            "zh": "……是毛绒玩具哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "344/TALK",
            "narrator": "アーヤ",
            "text": "ボランティアで使う\nぬいぐるみを作ってるの。",
            "zh": "志愿者要用的\n布偶，我在做。",
            "narrator_zh": "绫水"
        },
        {
            "location": "346/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりね。\nそれって犬かしら？",
            "zh": "果然。\n那是狗吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "347/TALK",
            "narrator": "アーヤ",
            "text": "犬の大工さん。\n森一番の大工さん、って\n設定なの。",
            "zh": "狗木匠。\n森林第一的木匠，\n是这样的设定。",
            "narrator_zh": "绫水"
        },
        {
            "location": "349/TALK",
            "narrator": "ガブリエラ",
            "text": "相変わらず、子供向けの\n話をやるみたいね。",
            "zh": "还是老样子，要演\n给小孩看的故事呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "351/TALK",
            "narrator": "アーヤ",
            "text": "幼稚園で見せる劇だもの。\n当然でしょ？",
            "zh": "是在幼儿园演的剧。\n当然吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "352/TALK",
            "narrator": "ガブリエラ",
            "text": "そりゃそうよね。",
            "zh": "那当然是啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "353/TALK",
            "narrator": "ガブリエラ",
            "text": "…続けることにしたんだ？",
            "zh": "……你决定继续下去了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "354/TALK",
            "narrator": "アーヤ",
            "text": "…うん。\n色々あったけど、\nそういうことになったわ。",
            "zh": "……嗯。\n发生了不少事，\n结果还是决定继续了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "355/TALK",
            "narrator": "アーヤ",
            "text": "心配かけたわね。",
            "zh": "让你担心了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "357/TALK",
            "narrator": "ガブリエラ",
            "text": "べ、別に？\nそんなのしてないし。",
            "zh": "才、才没有？\n我没担心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "358/TALK",
            "narrator": "ガブリエラ",
            "text": "…っていうか、それなら\n今度の劇はあたしにも\n見せなさいよ。",
            "zh": "……说起来，那样的话\n下次的剧也给我\n看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "360/TALK",
            "narrator": "アーヤ",
            "text": "ついでに出演してくれる\nなら、考えてもいいわ。",
            "zh": "要是顺便\n能出演，我可以考虑。",
            "narrator_zh": "绫水"
        },
        {
            "location": "362/TALK",
            "narrator": "ガブリエラ",
            "text": "それはもうお断りよ！",
            "zh": "那个我已经拒绝了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "363/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、戻るわ。\nルーズリーフありがとね。",
            "zh": "那么，我回去了。\n谢谢你的活页纸。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "366/TALK",
            "narrator": "アーヤ",
            "text": "…そうだ。\n$handle$さんにも\n報告しておかないと。",
            "zh": "……对了。\n也得向$handle$\n报告一下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "378/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さん",
            "zh": "$handle$",
            "narrator_zh": "绫水"
        },
        {
            "location": "380/TALK",
            "narrator": "アーヤ",
            "text": "報告しておきたいことがあるの(*^o^*)",
            "zh": "有件事想报告(*^o^*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "381/TALK",
            "narrator": "アーヤ",
            "text": "私達",
            "zh": "我们",
            "narrator_zh": "绫水"
        },
        {
            "location": "382/TALK",
            "narrator": "アーヤ",
            "text": "ボランティアを続けることになったの＼(^O^)／",
            "zh": "决定把志愿者继续下去＼(^O^)／",
            "narrator_zh": "绫水"
        },
        {
            "location": "384/SEL",
            "narrator": "",
            "text": "本当に！？",
            "zh": "真的！？",
            "narrator_zh": ""
        },
        {
            "location": "385/ACT",
            "narrator": "",
            "text": "本当に！？",
            "zh": "真的！？",
            "narrator_zh": ""
        },
        {
            "location": "388/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんの助言のおかげよ(^ε^)-☆!!",
            "zh": "多亏$handle$的建议(^ε^)-☆!!",
            "narrator_zh": "绫水"
        },
        {
            "location": "389/TALK",
            "narrator": "アーヤ",
            "text": "みんなとしっかり話して",
            "zh": "和大家好好谈过了",
            "narrator_zh": "绫水"
        },
        {
            "location": "390/TALK",
            "narrator": "アーヤ",
            "text": "どうするか考えたら",
            "zh": "要是想怎么办的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "391/TALK",
            "narrator": "アーヤ",
            "text": "みんな続けたいって言ってくれて",
            "zh": "大家都说想继续",
            "narrator_zh": "绫水"
        },
        {
            "location": "392/TALK",
            "narrator": "アーヤ",
            "text": "それなら",
            "zh": "那样的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "393/TALK",
            "narrator": "アーヤ",
            "text": "続けなくちゃ勿体ない！(>_<)",
            "zh": "不继续就太可惜了！(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "394/TALK",
            "narrator": "アーヤ",
            "text": "って決まったの",
            "zh": "就这么定了",
            "narrator_zh": "绫水"
        },
        {
            "location": "396/SEL",
            "narrator": "",
            "text": "よかったね",
            "zh": "那就好",
            "narrator_zh": ""
        },
        {
            "location": "397/SEL",
            "narrator": "",
            "text": "心配してた",
            "zh": "我一直很担心",
            "narrator_zh": ""
        },
        {
            "location": "398/SEL",
            "narrator": "",
            "text": "$me$のおかけだよね！",
            "zh": "都多亏了$me$呢！",
            "narrator_zh": ""
        },
        {
            "location": "399/ACT",
            "narrator": "",
            "text": "よかったね",
            "zh": "那就好",
            "narrator_zh": ""
        },
        {
            "location": "401/TALK",
            "narrator": "アーヤ",
            "text": "雨降って地固まる",
            "zh": "雨过天晴",
            "narrator_zh": "绫水"
        },
        {
            "location": "403/TALK",
            "narrator": "アーヤ",
            "text": "ってやつね(^^",
            "zh": "是那回事呢(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "404/ACT",
            "narrator": "",
            "text": "心配してた",
            "zh": "我一直很担心",
            "narrator_zh": ""
        },
        {
            "location": "405/TALK",
            "narrator": "アーヤ",
            "text": "心配かけちゃってた？",
            "zh": "我让你担心了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "406/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさいm(_ _)m",
            "zh": "对不起m(_ _)m",
            "narrator_zh": "绫水"
        },
        {
            "location": "407/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "408/TALK",
            "narrator": "アーヤ",
            "text": "もう平気よ",
            "zh": "已经没事了",
            "narrator_zh": "绫水"
        },
        {
            "location": "409/ACT",
            "narrator": "",
            "text": "$me$のおかけだよね！",
            "zh": "都多亏了$me$呢！",
            "narrator_zh": ""
        },
        {
            "location": "412/TALK",
            "narrator": "アーヤ",
            "text": "そう無邪気に言えるって凄いわね",
            "zh": "能说得这么天真，真厉害",
            "narrator_zh": "绫水"
        },
        {
            "location": "413/TALK",
            "narrator": "アーヤ",
            "text": "でも、実際そうだから",
            "zh": "不过，实际上就是这样",
            "narrator_zh": "绫水"
        },
        {
            "location": "416/TALK",
            "narrator": "アーヤ",
            "text": "詳しい話はまた今度",
            "zh": "详细的下次再说",
            "narrator_zh": "绫水"
        },
        {
            "location": "417/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと急ぎの作業中だから",
            "zh": "我正在赶一点急活",
            "narrator_zh": "绫水"
        },
        {
            "location": "418/TALK",
            "narrator": "アーヤ",
            "text": "今夜中に完成させたいの(>_<)",
            "zh": "想在今晚做完(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "420/SEL",
            "narrator": "",
            "text": "頑張ってね",
            "zh": "加油哦",
            "narrator_zh": ""
        },
        {
            "location": "421/ACT",
            "narrator": "",
            "text": "頑張ってね",
            "zh": "加油哦",
            "narrator_zh": ""
        },
        {
            "location": "424/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "425/TALK",
            "narrator": "アーヤ",
            "text": "一言だけ",
            "zh": "只说一句",
            "narrator_zh": "绫水"
        },
        {
            "location": "428/TALK",
            "narrator": "ボイスメール",
            "text": "ありがとう",
            "zh": "谢谢",
            "narrator_zh": "语音信箱"
        },
        {
            "location": "456/TALK",
            "narrator": "アーヤ",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "457/TALK",
            "narrator": "アーヤ",
            "text": "…よし、頑張ろ！",
            "zh": "……好，加油！",
            "narrator_zh": "绫水"
        },
        {
            "location": "315/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　10:55 PM</color>\nとある平日の夜、寮「とらいあんぐる」アーヤの部屋にて",
            "zh": "<color=green>某月某日　10:55 PM</color>\n某个平日的夜里，宿舍「Tri-angle」绫水的房间",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "440/DIALOG",
            "narrator": "Dialog_GETVoice",
            "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【ありがとう】</color>\nをゲットしました！",
            "zh": "<color=green>【绫水】</color>的语音信箱\n<color=red>【谢谢】</color>\n已入手！",
