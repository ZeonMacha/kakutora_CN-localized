{
    "dir": "chap17/daydra/dd_ch01_17_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "17156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "みやびの弁当",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "雅的便当"
    },
    "entry": [
        {
            "location": "288/SCENARIO",
            "narrator": "",
            "text": "みやびの弁当",
            "zh": "雅的便当",
            "narrator_zh": ""
        },
        {
            "location": "308/TALK",
            "narrator": "つばめ",
            "text": "あれ？\n今日ってみんな\nお弁当なんだ？",
            "zh": "咦？\n今天大家都是\n便当吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "309/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、今日はわたし、\n一人学食かぁ…。",
            "zh": "那今天我就\n一个人去食堂了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "311/TALK",
            "narrator": "雛",
            "text": "水臭いなぁ。\nあたし達も行くよ。",
            "zh": "见外啦。\n我们也去。",
            "narrator_zh": "雏"
        },
        {
            "location": "312/TALK",
            "narrator": "キリト",
            "text": "ああ。\n弁当はどこでだって\n食えるからな。",
            "zh": "啊。\n便当在哪\n都能吃。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "314/TALK",
            "narrator": "つばめ",
            "text": "嬉しいけど、\n多分混んでると\n思うから――",
            "zh": "我是很高兴，\n不过大概\n会很挤——",
            "narrator_zh": "燕"
        },
        {
            "location": "315/TALK",
            "narrator": "つばめ",
            "text": "わたしだけ行って、\nささっと食べてくるよ。",
            "zh": "我一个人去，\n赶紧吃完就回来。",
            "narrator_zh": "燕"
        },
        {
            "location": "318/TALK",
            "narrator": "つばめ",
            "text": "みんなはゆっくり\n教室で食べてて。",
            "zh": "你们就在教室\n慢慢吃。",
            "narrator_zh": "燕"
        },
        {
            "location": "331/TALK",
            "narrator": "みやび",
            "text": "…失敗した。",
            "zh": "……搞砸了。",
            "narrator_zh": "雅"
        },
        {
            "location": "332/TALK",
            "narrator": "みやび",
            "text": "これくらい余裕やと\n思うたんやけんど…。",
            "zh": "以为这点量\n还有余，不过……。",
            "narrator_zh": "雅"
        },
        {
            "location": "344/TALK",
            "narrator": "みやび",
            "text": "お腹パンパンちや",
            "zh": "肚子撑得鼓鼓的咯",
            "narrator_zh": "雅"
        },
        {
            "location": "346/SEL",
            "narrator": "",
            "text": "よかったね",
            "zh": "那就好",
            "narrator_zh": ""
        },
        {
            "location": "347/ACT",
            "narrator": "",
            "text": "よかったね",
            "zh": "那就好",
            "narrator_zh": ""
        },
        {
            "location": "349/TALK",
            "narrator": "みやび",
            "text": "あんまし良くないんよ",
            "zh": "不太好",
            "narrator_zh": "雅"
        },
        {
            "location": "350/TALK",
            "narrator": "みやび",
            "text": "今日は弁当持って来たんやけんど",
            "zh": "今天带了便当，不过",
            "narrator_zh": "雅"
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "急に、購買のパンが食べたくなったがよ",
            "zh": "突然想吃小卖部的面包咯",
            "narrator_zh": "雅"
        },
        {
            "location": "352/TALK",
            "narrator": "みやび",
            "text": "やき、パンを買って食べたんやけんど…",
            "zh": "所以嘛，买了面包吃了，不过……",
            "narrator_zh": "雅"
        },
        {
            "location": "353/TALK",
            "narrator": "みやび",
            "text": "あとはわかるな？",
            "zh": "后面你懂吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "355/SEL",
            "narrator": "",
            "text": "弁当入らなくなった？",
            "zh": "便当吃不下了？",
            "narrator_zh": ""
        },
        {
            "location": "356/ACT",
            "narrator": "",
            "text": "弁当入らなくなった？",
            "zh": "便当吃不下了？",
            "narrator_zh": ""
        },
        {
            "location": "358/TALK",
            "narrator": "みやび",
            "text": "正解や",
            "zh": "答对咯",
            "narrator_zh": "雅"
        },
        {
            "location": "359/TALK",
            "narrator": "みやび",
            "text": "賞品はこの哀れな弁当一つ、と言いたいところやけんど",
            "zh": "奖品就是这份可怜的便当，本想这么说，不过",
            "narrator_zh": "雅"
        },
        {
            "location": "360/TALK",
            "narrator": "みやび",
            "text": "相棒じゃ食べれんき、自動的に辞退やね",
            "zh": "搭档吃不了啵，自动弃权咯",
            "narrator_zh": "雅"
        },
        {
            "location": "361/TALK",
            "narrator": "みやび",
            "text": "…無駄になってしまうけんど、諦めるしかないがか？",
            "zh": "……会浪费掉，不过也只能放弃了？",
            "narrator_zh": "雅"
        },
        {
            "location": "364/SEL",
            "narrator": "",
            "text": "明日から気を付けよう",
            "zh": "从明天开始注意",
            "narrator_zh": ""
        },
        {
            "location": "365/SEL",
            "narrator": "",
            "text": "つばめにあげよう",
            "zh": "给燕吧",
            "narrator_zh": ""
        },
        {
            "location": "366/ACT",
            "narrator": "",
            "text": "明日から気を付けよう",
            "zh": "从明天开始注意",
            "narrator_zh": ""
        },
        {
            "location": "367/TALK",
            "narrator": "みやび",
            "text": "食べ物無駄にするんは、罰当たりちや",
            "zh": "浪费食物是要遭报应的咯",
            "narrator_zh": "雅"
        },
        {
            "location": "368/TALK",
            "narrator": "みやび",
            "text": "素直に反省して、二度とせんようにするがよ",
            "zh": "好好反省，以后不再这样咯",
            "narrator_zh": "雅"
        },
        {
            "location": "381/ACT",
            "narrator": "",
            "text": "つばめにあげよう",
            "zh": "给燕吧",
            "narrator_zh": ""
        },
        {
            "location": "383/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん、うちの料理美味しい言うてくれるきね",
            "zh": "燕老说我做的菜好吃啵",
            "narrator_zh": "雅"
        },
        {
            "location": "384/TALK",
            "narrator": "みやび",
            "text": "そうするちや",
            "zh": "就这么办咯",
            "narrator_zh": "雅"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "…けんど、つばめちゃんも\n弁当持ってきちゅうかも\nしれんな。",
            "zh": "……不过，燕\n也许也带着便当\n来了。",
            "narrator_zh": "雅"
        },
        {
            "location": "396/TALK",
            "narrator": "みやび",
            "text": "変に気を使わせるんも\n悪いし…。",
            "zh": "让她多心\n也不好……。",
            "narrator_zh": "雅"
        },
        {
            "location": "397/SEL",
            "narrator": "",
            "text": "大丈夫、心配ない",
            "zh": "没事，不用担心",
            "narrator_zh": ""
        },
        {
            "location": "398/ACT",
            "narrator": "",
            "text": "大丈夫、心配ない",
            "zh": "没事，不用担心",
            "narrator_zh": ""
        },
        {
            "location": "415/TALK",
            "narrator": "みやび",
            "text": "相棒、何か知っちゅうな？",
            "zh": "搭档，你知道些什么吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "417/TALK",
            "narrator": "みやび",
            "text": "まあえいよ",
            "zh": "算了，要得",
            "narrator_zh": "雅"
        },
        {
            "location": "418/TALK",
            "narrator": "みやび",
            "text": "そうまで言うなら、信じて持ってくちや",
            "zh": "你都这么说了，我就信你，带过去咯",
            "narrator_zh": "雅"
        },
        {
            "location": "442/TALK",
            "narrator": "みやび",
            "text": "…そういうわけやき、\n押し付けるみたいで\n申し訳ないんやけんど――",
            "zh": "……就是这么回事啵，\n像是硬塞给你，\n真不好意思，不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "443/TALK",
            "narrator": "みやび",
            "text": "よければこの弁当、\n貰うてくれんか？",
            "zh": "要是行的话，这份便当，\n你收下喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "445/TALK",
            "narrator": "つばめ",
            "text": "い、いいんですか！？\n本当にいただいちゃって。",
            "zh": "可、可以吗！？\n真的可以收下。",
            "narrator_zh": "燕"
        },
        {
            "location": "446/TALK",
            "narrator": "みやび",
            "text": "そうしてもらえると\nうちも助かるがよ。",
            "zh": "你肯收下，\n我也轻松咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "447/TALK",
            "narrator": "つばめ",
            "text": "みやびさん…\nありがとうございます！",
            "zh": "雅……\n谢谢！",
            "narrator_zh": "燕"
        },
        {
            "location": "448/TALK",
            "narrator": "つばめ",
            "text": "今日、お弁当持って\nこなかったこと、\n凄く後悔してたんです。",
            "zh": "今天没带便当，\n我后悔得\n不得了。",
            "narrator_zh": "燕"
        },
        {
            "location": "449/TALK",
            "narrator": "みやび",
            "text": "…何かあったがか？",
            "zh": "……出什么事了喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "451/TALK",
            "narrator": "つばめ",
            "text": "はい…今日はわたしだけ\nお弁当持ってきてなかった\nから――",
            "zh": "是……今天只有我\n没带\n便当——",
            "narrator_zh": "燕"
        },
        {
            "location": "452/TALK",
            "narrator": "つばめ",
            "text": "一人で学食に行こうと\n思ってたんです。",
            "zh": "本来想\n一个人去食堂。",
            "narrator_zh": "燕"
        },
        {
            "location": "453/TALK",
            "narrator": "みやび",
            "text": "…そういうことやったか。",
            "zh": "……原来是这样。",
            "narrator_zh": "雅"
        },
        {
            "location": "456/TALK",
            "narrator": "みやび",
            "text": "相棒、このこと知ってて、\nつばめちゃんにあげよう\n言うたんやな。",
            "zh": "搭档，你知道这件事，\n才说给燕\n是吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "458/TALK",
            "narrator": "つばめ",
            "text": "みやびさんのお弁当が\nあれば、みんなと一緒に\n食べられます。",
            "zh": "有雅的便当，\n就能跟大家\n一起吃了。",
            "narrator_zh": "燕"
        },
        {
            "location": "460/TALK",
            "narrator": "つばめ",
            "text": "ありがとうございます、\nみやびさん。",
            "zh": "谢谢，\n雅。",
            "narrator_zh": "燕"
        },
        {
            "location": "463/TALK",
            "narrator": "みやび",
            "text": "気にせんでえいき、\n早くみんなのところ\n行くぞね。",
            "zh": "别放在心上啵，\n赶紧去\n大家那儿啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "464/TALK",
            "narrator": "つばめ",
            "text": "わかりました。\nお弁当箱は帰ったら\n返しますね。",
            "zh": "知道了。\n便当盒回去\n再还你。",
            "narrator_zh": "燕"
        },
        {
            "location": "468/TALK",
            "narrator": "みやび",
            "text": "…まあ、相棒のおかげで\n弁当が無駄にならんで\nすんだんやし――",
            "zh": "……嘛，托搭档的福，\n便当才没有\n白费——",
            "narrator_zh": "雅"
        },
        {
            "location": "470/TALK",
            "narrator": "みやび",
            "text": "それで良しとするか。",
            "zh": "那就这样算了。",
            "narrator_zh": "雅"
        },
        {
            "location": "298/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月20日　0:05 PM</color>\nとある平日の昼休み、附属学園つばめの教室にて。",
            "zh": "<color=green>7月20日　0:05 PM</color>\n某个工作日的午休，在附属学园燕的教室。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
