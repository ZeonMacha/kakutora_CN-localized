        },
        {
            "location": "760/TALK",
            "narrator": "みやび",
            "text": "できるが",
            "zh": "倒是会啦",
            "narrator_zh": "雅"
        },
        {
            "location": "761/ACT",
            "narrator": "",
            "text": "コード書こう",
            "zh": "写代码吧",
            "narrator_zh": ""
        },
        {
            "location": "763/TALK",
            "narrator": "みやび",
            "text": "原初のコード",
            "zh": "原初的代码",
            "narrator_zh": "雅"
        },
        {
            "location": "764/TALK",
            "narrator": "みやび",
            "text": "美しき",
            "zh": "美得很啊",
            "narrator_zh": "雅"
        },
        {
            "location": "765/ACT",
            "narrator": "",
            "text": "みやびの得意技を使おう",
            "zh": "用雅的拿手绝活吧",
            "narrator_zh": ""
        },
        {
            "location": "766/TALK",
            "narrator": "みやび",
            "text": "ハッキング",
            "zh": "ハッキング",
            "narrator_zh": "雅"
        },
        {
            "location": "767/TALK",
            "narrator": "みやび",
            "text": "する気か",
            "zh": "打算动手吗",
            "narrator_zh": "雅"
        },
        {
            "location": "768/TALK",
            "narrator": "みやび",
            "text": "今まさに",
            "zh": "就在此刻",
            "narrator_zh": "雅"
        },
        {
            "location": "774/TALK",
            "narrator": "みやび",
            "text": "$handle$は\n一体何を……。",
            "zh": "$handle$到底\n在做什么……。",
            "narrator_zh": "雅"
        },
        {
            "location": "778/TALK",
            "narrator": "アーヤ",
            "text": "トライコネクト！\nこれを脱出の手段に\n使えないかしら？",
            "zh": "Tri-Connect！\n能不能把这个用作\n逃生的手段？",
            "narrator_zh": "绫水"
        },
        {
            "location": "779/TALK",
            "narrator": "ガブリエラ",
            "text": "え？\nそんなことできるの？",
            "zh": "诶？\n那种事做得到吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "780/TALK",
            "narrator": "みやび",
            "text": "…確かに。\n今ならできるね。",
            "zh": "…确实。\n现在的话能做到。",
            "narrator_zh": "雅"
        },
        {
            "location": "781/TALK",
            "narrator": "みやび",
            "text": "音羽用にシステムを\n改造したき。",
            "zh": "为了音羽改过\n系统了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "782/TALK",
            "narrator": "みやび",
            "text": "けんど、それだけ\nやったら敵の目を\n欺けんかもしれん。",
            "zh": "但是只靠这个，\n说不定骗不过\n敌人的眼睛。",
            "narrator_zh": "雅"
        },
        {
            "location": "783/TALK",
            "narrator": "ガブリエラ",
            "text": "それなら脱出ポッドを\n使うのはどう？",
            "zh": "那用逃生舱\n怎么样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "785/TALK",
            "narrator": "アーヤ",
            "text": "…いい手ね。私達が\n乗ってると思わせれば\nいいんじゃない。",
            "zh": "…好主意。只要让\n他们以为我们\n还在里面就行了吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "786/TALK",
            "narrator": "みやび",
            "text": "さすがに爆発は\nさせられんかね。",
            "zh": "要让它爆炸，\n还是做不到的吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "788/TALK",
            "narrator": "ガブリエラ",
            "text": "ポッドを？",
            "zh": "让逃生舱？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "789/TALK",
            "narrator": "みやび",
            "text": "ただ射出された\nだけやったら\nすぐに鹵獲されるき。",
            "zh": "光是弹射出去，\n很快就会\n被缴获的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "791/TALK",
            "narrator": "みやび",
            "text": "爆発できるなら\n現場の混乱も狙えるし。",
            "zh": "要是能爆炸，\n还能顺带搅乱现场。",
            "narrator_zh": "雅"
        },
        {
            "location": "792/TALK",
            "narrator": "アーヤ",
            "text": "救命のためのものだから\nそう簡単には\n壊せないわ。",
            "zh": "那是救命用的东西，\n没那么容易\n弄坏的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "794/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね。でも\nそう見せかけることは\n可能よ。",
            "zh": "是啊。但是\n装出那个样子\n是可能的哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "795/TALK",
            "narrator": "ガブリエラ",
            "text": "積み込んだ武器の中に\n発煙手榴弾がある。\nこれを使えばいいわ。",
            "zh": "装进去的武器里有\n发烟手榴弹。\n用这个就行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "797/TALK",
            "narrator": "みやび",
            "text": "煙はどのくらい\n広がるもんなんかね？",
            "zh": "烟能扩散到\n多大范围啊？",
            "narrator_zh": "雅"
        },
        {
            "location": "799/TALK",
            "narrator": "ガブリエラ",
            "text": "ここにあるものを\n全部ポッドに\nぶち込んだなら。",
            "zh": "如果把这里的\n东西全塞进\n逃生舱的话。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "800/TALK",
            "narrator": "ガブリエラ",
            "text": "ざっと１００ｍと\nいったところかしら。",
            "zh": "大概能铺开\n１００ｍ左右吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "801/TALK",
            "narrator": "アーヤ",
            "text": "そんなに！？",
            "zh": "那么大！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "802/TALK",
            "narrator": "みやび",
            "text": "派手やねえ。\n気に入った。",
            "zh": "够夸张的咯。\n我喜欢。",
            "narrator_zh": "雅"
        },
        {
            "location": "804/TALK",
            "narrator": "みやび",
            "text": "じゃ、うちは起爆用の\nリモコンでも\n作ろうかね。",
            "zh": "那我就来做\n个起爆用的\n遥控器吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "807/TALK",
            "narrator": "ガブリエラ",
            "text": "発煙手榴弾の\n設置は任せて。",
            "zh": "发烟手榴弹的\n布置交给我。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "808/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ私は\nトライコネクトの\n確認をしておくわね。",
            "zh": "那我去确认\nTri-Connect\n的情况哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "840/TALK",
            "narrator": "ガブリエラ",
            "text": "みやび、準備は\nどうなのよ？",
            "zh": "雅，准备得\n怎么样了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "843/TALK",
            "narrator": "みやび",
            "text": "脱出ポッドの\n射出準備ならとっくに\nできちゅうき。",
            "zh": "逃生舱的弹射准备\n早就\n弄好了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "844/TALK",
            "narrator": "みやび",
            "text": "それより二人は\nコネクトこじゃんと\nせんといかんよ。",
            "zh": "比起那个，你们俩\n得先好好\n把连接做上才行哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "846/TALK",
            "narrator": "アーヤ",
            "text": "もちろんよ。",
            "zh": "那是当然。",
            "narrator_zh": "绫水"
        },
        {
            "location": "847/TALK",
            "narrator": "ガブリエラ",
            "text": "当たり前でしょ。",
            "zh": "那还用说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "848/TALK",
            "narrator": "アーヤ",
            "text": "それよりやっぱり\nスピードを落とす気は\nないみたいよ。",
            "zh": "比起这个，看来\n对方还是\n没打算减速哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "849/TALK",
            "narrator": "アーヤ",
            "text": "このまま文京ドームに\n突っ込ませる気\n満々ね。",
            "zh": "摆明了是想让它\n就这么冲进\n文京穹顶。",
            "narrator_zh": "绫水"
        },
        {
            "location": "850/TALK",
            "narrator": "みやび",
            "text": "脱出のタイミングは\nさっきの打ち合わせ\n通りに頼むちや。",
            "zh": "逃生的时机，\n就按刚才商量好的\n办，拜托了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "852/TALK",
            "narrator": "みやび",
            "text": "おっと、いかん。\nこっちを\n忘れちょったがよ。",
            "zh": "哎呀，不行。\n差点把这个\n给忘了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "864/TALK",
            "narrator": "みやび",
            "text": "生存および奪還作戦",
            "zh": "生存与夺还作战",
            "narrator_zh": "雅"
        },
        {
            "location": "865/TALK",
            "narrator": "みやび",
            "text": "これより決行",
            "zh": "即刻执行",
            "narrator_zh": "雅"
        },
        {
            "location": "866/TALK",
            "narrator": "みやび",
            "text": "うちへの助言感謝する",
            "zh": "感谢你给我的建议",
            "narrator_zh": "雅"
        },
        {
            "location": "867/TALK",
            "narrator": "みやび",
            "text": "最愛を込めて",
            "zh": "满怀至爱",
            "narrator_zh": "雅"
        },
        {
            "location": "869/SEL",
            "narrator": "",
            "text": "成功するよ",
            "zh": "会成功的",
            "narrator_zh": ""
        },
        {
            "location": "870/SEL",
            "narrator": "",
            "text": "生きて！",
            "zh": "要活下去！",
            "narrator_zh": ""
        },
        {
            "location": "871/SEL",
            "narrator": "",
            "text": "死ぬ気でやってみよう",
            "zh": "豁出命去干吧",
            "narrator_zh": ""
        },
        {
            "location": "872/ACT",
            "narrator": "",
            "text": "成功するよ",
            "zh": "会成功的",
            "narrator_zh": ""
        },
        {
            "location": "873/TALK",
            "narrator": "みやび",
            "text": "失敗したら",
            "zh": "失败了",
            "narrator_zh": "雅"
        },
        {
            "location": "874/TALK",
            "narrator": "みやび",
            "text": "あの世で会おうぞ",
            "zh": "就在阴间碰头吧",
            "narrator_zh": "雅"
        },
        {
            "location": "875/TALK",
            "narrator": "みやび",
            "text": "アドレスを取得せよ",
            "zh": "地址记得搞到手啊",
            "narrator_zh": "雅"
        },
        {
            "location": "876/ACT",
            "narrator": "",
            "text": "生きて！",
            "zh": "要活下去！",
            "narrator_zh": ""
        },
        {
            "location": "877/TALK",
            "narrator": "みやび",
            "text": "たとえ死んでも",
            "zh": "就算死了",
            "narrator_zh": "雅"
        },
        {
            "location": "878/TALK",
            "narrator": "みやび",
            "text": "相棒はうちの相棒ぞね",
            "zh": "搭档也是我的搭档咧",
            "narrator_zh": "雅"
        },
        {
            "location": "879/TALK",
            "narrator": "みやび",
            "text": "それは永久不滅",
            "zh": "这一点永久不灭",
            "narrator_zh": "雅"
        },
        {
            "location": "880/ACT",
            "narrator": "",
            "text": "死ぬ気でやってみよう",
            "zh": "豁出命去干吧",
            "narrator_zh": ""
        },
        {
            "location": "881/TALK",
            "narrator": "みやび",
            "text": "本末転倒になったら",
            "zh": "要是本末倒置了",
            "narrator_zh": "雅"
        },
        {
            "location": "882/TALK",
            "narrator": "みやび",
            "text": "どうするつもりか",
            "zh": "你打算怎么办",
            "narrator_zh": "雅"
        },
        {
            "location": "883/TALK",
            "narrator": "みやび",
            "text": "ばかちんが",
            "zh": "笨蛋啊你",
            "narrator_zh": "雅"
        },
        {
            "location": "896/TALK",
            "narrator": "みやび",
            "text": "…ＧＰＳ脱出目標まで\n１００ｍ。",
            "zh": "…ＧＰＳ距逃生目标\n还有１００ｍ。",
            "narrator_zh": "雅"
        },
        {
            "location": "897/TALK",
            "narrator": "みやび",
            "text": "５０ｍ。",
            "zh": "５０ｍ。",
            "narrator_zh": "雅"
        },
        {
            "location": "898/TALK",
            "narrator": "みやび",
            "text": "３０ｍ。",
            "zh": "３０ｍ。",
            "narrator_zh": "雅"
        },
        {
            "location": "899/TALK",
            "narrator": "みやび",
            "text": "２０ｍ。",
            "zh": "２０ｍ。",
            "narrator_zh": "雅"
        },
        {
            "location": "900/TALK",
            "narrator": "みやび",
            "text": "１０ｍ。",
            "zh": "１０ｍ。",
            "narrator_zh": "雅"
        },
        {
            "location": "901/TALK",
            "narrator": "みやび",
            "text": "$handle$に\n最大の感謝を。",
            "zh": "向$handle$\n致以最大的感谢。",
            "narrator_zh": "雅"
        },
