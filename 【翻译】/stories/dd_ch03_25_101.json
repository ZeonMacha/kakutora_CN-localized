        },
        {
            "location": "178/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に？",
            "zh": "真的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "179/ACT",
            "narrator": "",
            "text": "心配なら探しに行こう",
            "zh": "担心的话就去找找看吧",
