        "title": "002 メインストーリー",
        "sub_title": "少女の顔をした戦争＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "少女面孔的战争＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "少女の顔をした戦争",
            "zh": "少女面孔的战争",
            "narrator_zh": ""
        },
        {
            "location": "29/TALK",
            "narrator": "ガブリエラ",
            "text": "…さすがに\nこれだけあると\n重いわね。",
            "zh": "……毕竟有\n这么多东西，\n好重啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "そうね。それにしても\n館長もどういう伝手で\n手に入れたのかしら。",
            "zh": "是啊。不过话说回来，\n馆长究竟是通过什么门路\n搞到这些东西的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "そう簡単に\n対人用の武器なんて\n入手できないはずなのに。",
            "zh": "按理说，\n对人用的武器哪有\n那么容易弄到手啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "…対人用の武器なんて\n言葉をアーヤの口から\n聞くことになるなんて。",
            "zh": "……居然会从\n绫水嘴里听到\n对人用武器这种词。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "それを自分が\n使うことになるかも\nしれないなんて。",
            "zh": "甚至连我自己\n都有可能\n得去使用它……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "……怖い……。",
            "zh": "……好可怕……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "アーヤ",
            "text": "さっさと積み込んで\nしまいましょう。",
            "zh": "我们赶紧搬上去\n装好吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィが\n手伝ってくれて\n助かるわ。",
            "zh": "有加维\n来帮忙真是\n帮大忙了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うん…。",
            "zh": "嗯、嗯……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "アーヤ",
            "text": "さてと。",
            "zh": "好啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "念のため武器庫を\n見てくるわ。",
            "zh": "以防万一，我去\n看看武器库的情况。",
            "narrator_zh": "绫水"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あたしも…。",
            "zh": "啊、我也……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "アーヤ",
            "text": "大丈夫よ。\n重かったでしょ？\nちょっと休んでて。",
            "zh": "没关系。\n刚才挺沉的吧？\n你先稍微休息一下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "68/TALK",
            "narrator": "アーヤ",
            "text": "それと。\nもし何かあったら\nすぐに知らせて。",
            "zh": "还有。\n要是发生什么事，\n立刻通知我。",
            "narrator_zh": "绫水"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "ここがふさがれたら\n全てがおしまい\nなんだから。",
            "zh": "要是这里\n被堵住了，\n可就全完了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "あ…。",
            "zh": "啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "じゃあね。\nすぐに戻るわ。",
            "zh": "那我去了。\n马上就回来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし…\nあたしだけが\n戦場育ちだから。",
            "zh": "我……\n因为只有我是在\n战场上长大的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "みんなは実戦の\n経験なんてないから。",
            "zh": "大家又都没有\n任何实战经验。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "いざとなったらあたしが\n一番役に立つって\n思ってたのに。",
            "zh": "我本来还以为，\n真到关键时刻，\n最能派上用场的人会是我呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "さっきから震えが\n止まらない……。",
            "zh": "可从刚才起，\n身体就一直抖个不停……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ$marzanna$",
            "zh": "喂$marzanna$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "いるかしら？",
            "zh": "你在吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/SEL",
            "narrator": "",
            "text": "いつでも！",
            "zh": "随时都在！",
            "narrator_zh": ""
        },
        {
            "location": "95/SEL",
            "narrator": "",
            "text": "一応ね",
            "zh": "算是吧",
            "narrator_zh": ""
        },
        {
            "location": "96/SEL",
            "narrator": "",
            "text": "大変そうじゃない？",
            "zh": "看起来很辛苦啊？",
            "narrator_zh": ""
        },
        {
            "location": "97/ACT",
            "narrator": "",
            "text": "いつでも！",
            "zh": "随时都在！",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "是嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね",
            "zh": "也是呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "101/ACT",
            "narrator": "",
            "text": "一応ね",
            "zh": "算是吧",
            "narrator_zh": ""
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "あら",
            "zh": "哎呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "つれないお返事ね",
            "zh": "真是个冷淡的回答呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/ACT",
            "narrator": "",
            "text": "大変そうじゃない？",
            "zh": "看起来很辛苦啊？",
            "narrator_zh": ""
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "確かに",
            "zh": "确实",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "ガブリエラ",
            "text": "大変は",
            "zh": "辛苦是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "大変よ",
            "zh": "挺辛苦的哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "ガブリエラ",
            "text": "えっと",
            "zh": "那个",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "別に",
            "zh": "其实也",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "用はなかったの",
            "zh": "没什么特别的事啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあね",
            "zh": "先这样吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/SEL",
            "narrator": "",
            "text": "バイバイ",
            "zh": "拜拜",
            "narrator_zh": ""
        },
        {
            "location": "116/SEL",
            "narrator": "",
            "text": "いつでも呼んで",
            "zh": "随时叫我哦",
            "narrator_zh": ""
        },
        {
            "location": "117/SEL",
            "narrator": "",
            "text": "もっと話そうよ",
            "zh": "多聊聊嘛",
            "narrator_zh": ""
        },
        {
            "location": "118/ACT",
            "narrator": "",
            "text": "バイバイ",
            "zh": "拜拜",
            "narrator_zh": ""
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "またね",
            "zh": "待会儿见",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/ACT",
            "narrator": "",
            "text": "いつでも呼んで",
            "zh": "随时叫我哦",
            "narrator_zh": ""
        },
        {
            "location": "121/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ",
            "zh": "嗯",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "そうするわ",
            "zh": "我会叫你的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "123/ACT",
            "narrator": "",
            "text": "もっと話そうよ",
            "zh": "多聊聊嘛",
            "narrator_zh": ""
        },
        {
            "location": "124/TALK",
            "narrator": "ガブリエラ",
            "text": "今はちょっとね",
            "zh": "现在稍微有点不太方便",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "ＷＡＶＥしたら\n少し落ち着けた\nような…。",
            "zh": "在ＷＡＶＥ上聊过之后，\n好像稍微冷静下来\n一点了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/TALK",
            "narrator": "ガブリエラ",
            "text": "…それにしても…。",
            "zh": "……不过话说回来……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤはすごく\n落ち着いてる\nみたいに見えるわ。",
            "zh": "绫水看起来\n好像非常冷静\n的样子呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "まるでワルシャワの\n剣道世界選手権の時\nみたいに。",
            "zh": "简直就像在华沙的\n剑道世锦赛那时候\n一样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "決勝戦のアーヤ、\n明鏡止水って言葉\nそのものだった。",
            "zh": "决赛时的绫水，\n简直就是明镜止水这个词\n本身的写照。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "141/TALK",
            "narrator": "ガブリエラ",
            "text": "静かに決勝戦に\n備えてたアーヤ。",
            "zh": "静静地为决赛\n做着准备的绫水。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "あの時と同じ\n空気を感じる…。",
            "zh": "总觉得现在的她和那时\n有着同样的氛围……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "144/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたし\n怖がりすぎかしら…。",
            "zh": "……是我\n太胆小了吗……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "156/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ$marzanna$",
            "zh": "喂$marzanna$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "158/SEL",
            "narrator": "",
            "text": "はいはい",
            "zh": "在的在的",
            "narrator_zh": ""
        },
        {
            "location": "159/SEL",
            "narrator": "",
            "text": "今度はどうしたの？",
            "zh": "这次怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "160/SEL",
            "narrator": "",
            "text": "いっぱい話そうよ！",
            "zh": "聊个痛快吧！",
            "narrator_zh": ""
        },
        {
            "location": "161/ACT",
            "narrator": "",
            "text": "はいはい",
            "zh": "在的在的",
            "narrator_zh": ""
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "いてくれてよかったわ",
            "zh": "你在真是太好了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/ACT",
            "narrator": "",
            "text": "今度はどうしたの？",
            "zh": "这次怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "164/TALK",
            "narrator": "ガブリエラ",
            "text": "ええとね",
            "zh": "那个呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/ACT",
            "narrator": "",
            "text": "いっぱい話そうよ！",
            "zh": "聊个痛快吧！",
            "narrator_zh": ""
        },
        {
            "location": "166/TALK",
            "narrator": "ガブリエラ",
            "text": "それはできないけど",
            "zh": "那倒是不行啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ",
            "zh": "绫水",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "169/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと遅くないかしら",
            "zh": "是不是有点太慢了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "170/TALK",
            "narrator": "ガブリエラ",
            "text": "戻ってくるの",
            "zh": "怎么还不回来",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "172/SEL",
            "narrator": "",
            "text": "信じて待とう",
            "zh": "相信她等等看吧",
            "narrator_zh": ""
        },
        {
            "location": "173/SEL",
            "narrator": "",
            "text": "気のせいだよ",
            "zh": "是你多心了吧",
            "narrator_zh": ""
        },
        {
            "location": "174/SEL",
            "narrator": "",
            "text": "焦りすぎだと思う",
            "zh": "我觉得你太心急了",
            "narrator_zh": ""
        },
        {
            "location": "175/ACT",
            "narrator": "",
            "text": "ヤバイと思う。探しに行って！",
            "zh": "我觉得大事不妙了。快去找她！",
