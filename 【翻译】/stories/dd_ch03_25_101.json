        },
        {
            "location": "180/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "说的也是呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "183/SEL",
            "narrator": "",
            "text": "そんなこと言ってない",
            "zh": "我没这么说过啊",
            "narrator_zh": ""
        },
        {
            "location": "184/SEL",
            "narrator": "",
            "text": "どうしてこうなったの",
            "zh": "为什么会变成这样",
            "narrator_zh": ""
        },
        {
            "location": "185/SEL",
            "narrator": "",
            "text": "ここにいてって言われたでしょ",
