            "narrator_zh": ""
        },
        {
            "location": "4567/SEL",
            "narrator": "",
            "text": "それでこそ神楽！",
            "zh": "这才是神乐！",
            "narrator_zh": ""
        },
        {
            "location": "4568/SEL",
            "narrator": "",
            "text": "カノンの力が世界に満ちる…",
            "zh": "卡农的力量充满世界……",
            "narrator_zh": ""
        },
        {
            "location": "4569/ACT",
            "narrator": "",
            "text": "クレイジーだなヒャッハー！",
