        },
        {
            "location": "284/SEL",
            "narrator": "",
            "text": "いると思ったけど……",
            "zh": "我还以为有……",
            "narrator_zh": ""
        },
        {
            "location": "285/SEL",
            "narrator": "",
            "text": "そういうことにしておくね",
            "zh": "就当是这么回事吧",
            "narrator_zh": ""
        },
        {
            "location": "286/ACT",
            "narrator": "",
            "text": "ウソはよくないよ",
            "zh": "说谎可不好",
            "narrator_zh": ""
        },
        {
            "location": "287/TALK",
            "narrator": "アーヤ",
            "text": "嘘なんかないわよ",
