{
    "dir": "chap07/daydra/dd_ch02_07_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "7202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "それぞれの入隊＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "各自的入队＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "それぞれの入隊",
            "zh": "各自的入队",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "真幌",
            "text": "さてと…来月から上映する\n映画は何にするか…。",
            "zh": "那么……下个月要放的\n电影定什么好……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "25/TALK",
            "narrator": "真幌",
            "text": "前回がホラーだったから、\n次はコメディかＳＦにでも\nするべきか？",
            "zh": "上次是恐怖片，\n下次改喜剧或者SF\n怎么样？",
            "narrator_zh": "真幌"
        },
        {
            "location": "26/TALK",
            "narrator": "真幌",
            "text": "それともキワモノ系の\nカルト的人気がある物に\nするべきか…。",
            "zh": "或者选有邪典人气的\n偏门片子\n……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "30/TALK",
            "narrator": "アーヤ",
            "text": "館長！！",
            "zh": "馆长！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "真幌",
            "text": "うわっ！？\nど、どうしたアーヤ。\nそんなに慌てて…？",
            "zh": "哇！？\n怎、怎么了绫水。\n这么慌……？",
            "narrator_zh": "真幌"
        },
        {
            "location": "34/TALK",
            "narrator": "アーヤ",
            "text": "どうしたじゃありません！",
            "zh": "还怎么了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "アーヤ",
            "text": "逢瀬さんが特別攻撃隊に\n入る手続きをしたって\nいうのは、本当ですか！？",
            "zh": "逢濑办了特别攻击队的\n入队手续，\n是真的吗！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "36/TALK",
            "narrator": "真幌",
            "text": "ああ、そのことか。",
            "zh": "啊，那件事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "37/TALK",
            "narrator": "真幌",
            "text": "逢瀬の特別攻撃隊への\n入隊手続きは――",
            "zh": "逢濑加入特别攻击队的\n手续——",
            "narrator_zh": "真幌"
        },
        {
            "location": "38/TALK",
            "narrator": "真幌",
            "text": "本日一二〇〇時に、\n問題なく受理された。",
            "zh": "今天12:00，\n顺利受理了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "39/TALK",
            "narrator": "真幌",
            "text": "これであいつも、立派な\nうちの隊員というわけだ。",
            "zh": "这样一来，她也是\n我们正式的队员了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "40/TALK",
            "narrator": "アーヤ",
            "text": "そんな…。",
            "zh": "怎么会……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "41/TALK",
            "narrator": "真幌",
            "text": "何だ、不満か？",
            "zh": "怎么，不满意？",
            "narrator_zh": "真幌"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "不満です。",
            "zh": "不满意。",
            "narrator_zh": "绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "アーヤ",
            "text": "大体、逢瀬さんと会ったのは\nつい先日のことじゃない\nですか。",
            "zh": "本来，和逢濑见面\n不就是前几天的\n事吗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "アーヤ",
            "text": "それなのに、いきなり\n入隊だなんて…。",
            "zh": "可是突然就\n入队了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/TALK",
            "narrator": "アーヤ",
            "text": "いくら何でも早過ぎます！",
            "zh": "不管怎么说都太快了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "こんなことばかりして\nいると、いつか面倒な\nことになりますよ？",
            "zh": "净做这种事，\n总有一天会惹出\n麻烦的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "真幌",
            "text": "手続きは正式だった。\n必要書類も一式揃って\nいたし――",
            "zh": "手续是正式的。\n必要文件也齐了\n——",
            "narrator_zh": "真幌"
        },
        {
            "location": "48/TALK",
            "narrator": "真幌",
            "text": "保護者からの許可も、\nちゃんと得ている。",
            "zh": "监护人的许可，\n也正经拿到了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "49/TALK",
            "narrator": "アーヤ",
            "text": "そんな！",
            "zh": "怎么会！",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "真幌",
            "text": "もちろん、逢瀬本人も\n入隊する気でいるの\nだからな。",
            "zh": "当然，逢濑本人\n也打算\n入队。",
            "narrator_zh": "真幌"
        },
        {
            "location": "52/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "アーヤ",
            "text": "いったい、逢瀬さんに\n何を言ったんですか？",
            "zh": "到底，对逢濑\n说了什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "55/TALK",
            "narrator": "真幌",
            "text": "…そうだな。",
            "zh": "……这个嘛。",
            "narrator_zh": "真幌"
        },
        {
            "location": "56/TALK",
            "narrator": "真幌",
            "text": "おまえはみんなを引っ張る\nリーダーなのだし\n話しておくとしよう。",
            "zh": "你是带着大家的\n队长，\n还是告诉你吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "57/TALK",
            "narrator": "真幌",
            "text": "昨日のことだ。\n私は入隊の話をするため、\n逢瀬を呼び出し――",
            "zh": "是昨天的事。\n我为了谈入队，\n把逢濑叫了出来——",
            "narrator_zh": "真幌"
        },
        {
            "location": "75/TALK",
            "narrator": "つばめ",
            "text": "わ、わたしが、\n特別攻撃隊の\n隊員ですか！？",
            "zh": "我、我，\n是特别攻击队的\n队员吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "76/TALK",
            "narrator": "真幌",
            "text": "ああ、そうだ。",
            "zh": "啊，是的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "77/TALK",
            "narrator": "つばめ",
            "text": "で、でもわたし、\n皆さんと違います。",
            "zh": "可、可是我，\n和大家不一样。",
            "narrator_zh": "燕"
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "戦いの訓練とか\n受けてないし、\n力もありません。",
            "zh": "没受过战斗训练，\n也没有\n力量。",
            "narrator_zh": "燕"
        },
        {
            "location": "79/TALK",
            "narrator": "真幌",
            "text": "それなら平気だ。",
            "zh": "那就没关系。",
            "narrator_zh": "真幌"
        },
        {
            "location": "80/TALK",
            "narrator": "真幌",
            "text": "おまえの太ももにある、\nトライガジェットを\n使うことで――",
            "zh": "用你大腿上的\nTri-Gadget\n——",
            "narrator_zh": "真幌"
        },
        {
            "location": "81/TALK",
            "narrator": "真幌",
            "text": "コネクトし、戦うための\n力を得ることができる。",
            "zh": "连接之后，就能得到\n战斗的力量。",
            "narrator_zh": "真幌"
        },
        {
            "location": "82/TALK",
            "narrator": "真幌",
            "text": "…これは、誰にでも\nできることではない。",
            "zh": "……这不是谁都\n做得到的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "83/TALK",
            "narrator": "真幌",
            "text": "トライガジェットを持つ、\nごく一部の――",
            "zh": "只有持有Tri-Gadget的\n极少数人——",
            "narrator_zh": "真幌"
        },
        {
            "location": "84/TALK",
            "narrator": "真幌",
            "text": "選ばれた人間にしか\nできないことだ。",
            "zh": "被选中的人\n才做得到。",
            "narrator_zh": "真幌"
        },
        {
            "location": "85/TALK",
            "narrator": "つばめ",
            "text": "わたしが…\n選ばれた人間？",
            "zh": "我是……\n被选中的人？",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "真幌",
            "text": "そうだ。\nそしてその選ばれた\n人間は、私の知る限り――",
            "zh": "是的。\n而那些被选中的人，\n就我所知——",
            "narrator_zh": "真幌"
        },
        {
            "location": "87/TALK",
            "narrator": "真幌",
            "text": "おまえを含めて、\n世界に数えるほどしか\n存在しない。",
            "zh": "算上你，\n全世界也只有\n数得过来的几个。",
            "narrator_zh": "真幌"
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "89/TALK",
            "narrator": "真幌",
            "text": "強制はしない。\n入隊するもしないも、\nそれは逢瀬の自由だ。",
            "zh": "我不强迫。\n入不入队，\n是逢濑的自由。",
            "narrator_zh": "真幌"
        },
        {
            "location": "90/TALK",
            "narrator": "つばめ",
            "text": "…いいんですか？",
            "zh": "……可以吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "91/TALK",
            "narrator": "真幌",
            "text": "ああ…。",
            "zh": "啊……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "92/TALK",
            "narrator": "真幌",
            "text": "だがな、逢瀬。\nこれだけは覚えておけ。",
            "zh": "不过，逢濑。\n这件事记住。",
            "narrator_zh": "真幌"
        },
        {
            "location": "93/TALK",
            "narrator": "真幌",
            "text": "私達特別攻撃隊の\nバックにいるのは、\n情報管理庁――",
            "zh": "我们特别攻击队\n背后是\n情报管理厅——",
            "narrator_zh": "真幌"
        },
        {
            "location": "94/TALK",
            "narrator": "真幌",
            "text": "つまり、国が付いて\nいるということをな。",
            "zh": "也就是说，国家\n站在后面。",
            "narrator_zh": "真幌"
        },
        {
            "location": "95/TALK",
            "narrator": "つばめ",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": "燕"
        },
        {
            "location": "96/TALK",
            "narrator": "真幌",
            "text": "はぁ…遠回しに言っても\nわからんタイプか…。",
            "zh": "哈啊……绕着说\n也听不懂的类型吗……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "97/TALK",
            "narrator": "真幌",
            "text": "つまり、こうして私が\n話しているのは、国からの\n強い要請ということだ。",
            "zh": "就是说，我现在\n跟你谈，是国家的\n强烈请求。",
            "narrator_zh": "真幌"
        },
        {
            "location": "98/TALK",
            "narrator": "真幌",
            "text": "逢瀬にはその要請を\n受ける自由も、断る自由も\n保証されてはいる。",
            "zh": "逢濑有接受的自由，\n也有拒绝的\n自由。",
            "narrator_zh": "真幌"
        },
        {
            "location": "99/TALK",
            "narrator": "真幌",
            "text": "そして、もし受けると\nいうのであれば、\nそれ相応の報酬が出る。",
            "zh": "而且，如果接受，\n会有相应的\n报酬。",
            "narrator_zh": "真幌"
        },
        {
            "location": "100/TALK",
            "narrator": "つばめ",
            "text": "それって、お金ですか？",
            "zh": "那是，钱吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "101/TALK",
            "narrator": "真幌",
            "text": "金に限った話ではない。\n物でも、してほしいこと\nでも――",
            "zh": "不只是钱。\n东西也好，想让人做的事\n也好——",
            "narrator_zh": "真幌"
        },
        {
            "location": "102/TALK",
            "narrator": "真幌",
            "text": "それなりのワガママは\n聞いてもらえるという\nことだ。",
            "zh": "相当任性的要求，\n也会被听\n进去。",
            "narrator_zh": "真幌"
        },
        {
            "location": "103/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "104/TALK",
            "narrator": "真幌",
            "text": "だが、要請を\n断る場合は――",
            "zh": "不过，如果拒绝\n请求——",
            "narrator_zh": "真幌"
        },
        {
            "location": "105/TALK",
            "narrator": "真幌",
            "text": "庁はあらゆる手段で\nお前を説得しに\nかかるはずだ。",
            "zh": "厅会用一切手段\n来说服\n你。",
            "narrator_zh": "真幌"
        },
        {
            "location": "106/TALK",
            "narrator": "真幌",
            "text": "恐らく、相当\n粘り強くな。",
            "zh": "大概会非常\n缠人。",
            "narrator_zh": "真幌"
        },
        {
            "location": "107/TALK",
            "narrator": "つばめ",
            "text": "どうしてそこまで……",
            "zh": "为什么要做到这种地步……",
            "narrator_zh": "燕"
        },
        {
            "location": "108/TALK",
            "narrator": "真幌",
            "text": "政府は、フェノメノンと\n戦える人材を、一人でも\n多く欲しいと望んでいる。",
            "zh": "政府希望，能和PhenoMENON\n战斗的人，哪怕\n多一个也好。",
            "narrator_zh": "真幌"
        },
        {
            "location": "109/TALK",
            "narrator": "真幌",
            "text": "先日の戦いで、\nその逼迫した状況は\n理解出来ただろう？",
            "zh": "前几天的战斗，\n那种紧迫，\n你明白了吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "111/TALK",
            "narrator": "真幌",
            "text": "まあ、今すぐ返事をしろ\nとは言わん。",
            "zh": "嘛，也不是叫你\n马上回答。",
            "narrator_zh": "真幌"
        },
        {
            "location": "112/TALK",
            "narrator": "真幌",
            "text": "宿は手配しておいたから、\n今夜は一人で、\nゆっくりと考えろ。",
            "zh": "住处已经安排好了，\n今晚一个人，\n慢慢想。",
            "narrator_zh": "真幌"
        },
        {
            "location": "113/TALK",
            "narrator": "つばめ",
            "text": "…わかりました。",
            "zh": "……知道了。",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "真幌",
            "text": "よし…じゃあ、宿まで\n送ろう。",
            "zh": "好……那，我送你\n到住处。",
            "narrator_zh": "真幌"
        },
        {
            "location": "115/TALK",
            "narrator": "つばめ",
            "text": "あの、真幌さん。\nもう少しここにいちゃ\nダメですか？",
            "zh": "那个，真幌。\n再在这里待一会儿\n不行吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "117/TALK",
            "narrator": "つばめ",
            "text": "少し、頭の中を\n整理したくて…。",
            "zh": "想稍微，\n整理一下脑子……。",
            "narrator_zh": "燕"
        },
        {
            "location": "118/TALK",
            "narrator": "真幌",
            "text": "ああ、それは構わん。",
            "zh": "啊，那没关系。",
            "narrator_zh": "真幌"
        },
        {
            "location": "119/TALK",
            "narrator": "真幌",
            "text": "私は劇場の方の様子を\n見てくるから、用があれば\nそっちへ来てくれ。",
            "zh": "我去看看剧场那边，\n有事就\n过来找我。",
            "narrator_zh": "真幌"
        },
        {
            "location": "120/TALK",
            "narrator": "つばめ",
            "text": "わかりました。\nありがとうございます。",
            "zh": "知道了。\n谢谢。",
            "narrator_zh": "燕"
        },
        {
            "location": "138/TALK",
            "narrator": "真幌",
            "text": "いかん、結構時間が\n経ってしまった。",
            "zh": "不好，时间\n过了不少。",
            "narrator_zh": "真幌"
        },
        {
            "location": "139/TALK",
            "narrator": "真幌",
            "text": "逢瀬はまだいるかな？\n先に宿へ帰ったんじゃ――",
            "zh": "逢濑还在吗？\n不会先回住处了——",
            "narrator_zh": "真幌"
        },
        {
            "location": "140/TALK",
            "narrator": "つばめ",
            "text": "――うん――じゃなくて\n――そう、決めたの――",
            "zh": "——嗯——不对\n——对，我决定了——",
            "narrator_zh": "燕"
        },
        {
            "location": "141/TALK",
            "narrator": "真幌",
            "text": "…ん？\n電話中か？",
            "zh": "……嗯？\n在打电话？",
            "narrator_zh": "真幌"
        },
        {
            "location": "159/TALK",
            "narrator": "つばめ",
            "text": "心配なのはわかってるよ、\nお父さん。",
            "zh": "你担心我知道的，\n爸爸。",
            "narrator_zh": "燕"
        },
        {
            "location": "160/TALK",
            "narrator": "つばめ",
            "text": "けど…決めたの。",
            "zh": "可是……我决定了。",
            "narrator_zh": "燕"
        },
        {
            "location": "161/TALK",
            "narrator": "つばめ",
            "text": "わたし、東京で\nフェノメノンと\n戦う、って…。",
            "zh": "我要在东京\n和PhenoMENON\n战斗……。",
            "narrator_zh": "燕"
        },
        {
            "location": "162/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "163/TALK",
            "narrator": "つばめ",
            "text": "ううん、違うよ。",
            "zh": "不，不是的。",
            "narrator_zh": "燕"
        },
        {
            "location": "164/TALK",
            "narrator": "つばめ",
            "text": "決めたのは、わたし。",
            "zh": "决定的人，是我。",
            "narrator_zh": "燕"
        },
        {
            "location": "165/TALK",
            "narrator": "つばめ",
            "text": "わたしが、わたしの意思で\n戦うって決めたの。",
            "zh": "是我自己\n决定要战斗的。",
            "narrator_zh": "燕"
        },
        {
            "location": "166/TALK",
            "narrator": "つばめ",
            "text": "だから、お父さんが\n怒る気持ちはわかる\nけど――",
            "zh": "所以，爸爸\n生气的心情我明白\n——",
            "narrator_zh": "燕"
        },
        {
            "location": "168/TALK",
            "narrator": "つばめ",
            "text": "ごめんなさい！",
            "zh": "对不起！",
            "narrator_zh": "燕"
        },
        {
            "location": "173/TALK",
            "narrator": "つばめ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "174/TALK",
            "narrator": "真幌",
            "text": "いいのか？\n父上にあんなことを\n言ってしまって。",
            "zh": "这样好吗？\n对父亲说了\n那种话。",
            "narrator_zh": "真幌"
        },
        {
            "location": "177/TALK",
            "narrator": "つばめ",
            "text": "…良くはなかったかも\nしれないです。",
            "zh": "……也许\n不好。",
            "narrator_zh": "燕"
        },
        {
            "location": "178/TALK",
            "narrator": "つばめ",
            "text": "お父さん、凄く怒って\nましたから…。",
            "zh": "爸爸，非常生气\n了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "180/TALK",
            "narrator": "つばめ",
            "text": "…でも、わたしは\n戦いたいんです！",
            "zh": "……可是，我\n想战斗！",
            "narrator_zh": "燕"
        },
        {
            "location": "181/TALK",
            "narrator": "つばめ",
            "text": "ドームでフェノメノンに\n巻き込まれた時に、\n思ったんです。",
            "zh": "被卷进穹顶的PhenoMENON\n的时候，\n我这么想了。",
            "narrator_zh": "燕"
        },
        {
            "location": "183/TALK",
            "narrator": "つばめ",
            "text": "メノウちゃんを――",
            "zh": "MENOW——",
            "narrator_zh": "燕"
        },
        {
            "location": "184/TALK",
            "narrator": "つばめ",
            "text": "みんなを…大切な人を\n護れる力が欲しい、って。",
            "zh": "大家……重要的人，\n我想要能保护他们的力量。",
            "narrator_zh": "燕"
        },
        {
            "location": "185/TALK",
            "narrator": "つばめ",
            "text": "わたしには、その力が\nあるんですよね？",
            "zh": "我有那种力量，\n对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "186/TALK",
            "narrator": "つばめ",
            "text": "だったら、やります。",
            "zh": "那就做。",
            "narrator_zh": "燕"
        },
        {
            "location": "187/TALK",
            "narrator": "つばめ",
            "text": "わたししかできない、\n選ばれた人にしかできない\nことなら――",
            "zh": "只有我能做、\n只有被选中的人能做的事\n——",
            "narrator_zh": "燕"
        },
        {
            "location": "188/TALK",
            "narrator": "つばめ",
            "text": "やらせてください！",
            "zh": "请让我做！",
            "narrator_zh": "燕"
        },
        {
            "location": "189/TALK",
            "narrator": "真幌",
            "text": "…意思は固いようだな。",
            "zh": "……意志很坚定啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "190/TALK",
            "narrator": "真幌",
            "text": "よし、父上の説得は\nこちらに任せておけ。",
            "zh": "好，说服你父亲\n交给这边。",
            "narrator_zh": "真幌"
        },
        {
            "location": "191/TALK",
            "narrator": "真幌",
            "text": "各省庁の官僚から、\n直接説得してもらえるよう\n手配しておく。",
            "zh": "我会安排各省厅的官员\n直接来\n说服。",
            "narrator_zh": "真幌"
        },
        {
            "location": "192/TALK",
            "narrator": "つばめ",
            "text": "そ、それじゃあ！",
            "zh": "那、那样的话！",
            "narrator_zh": "燕"
        },
        {
            "location": "193/TALK",
            "narrator": "真幌",
            "text": "逢瀬つばめ！！",
            "zh": "逢濑燕！！",
            "narrator_zh": "真幌"
        },
        {
            "location": "194/TALK",
            "narrator": "真幌",
            "text": "総務省情報管理庁管轄、\n拡張現実特殊戦略隊群――",
            "zh": "总务省情报管理厅管辖，\n扩张现实特殊战略队群——",
            "narrator_zh": "真幌"
        },
        {
            "location": "195/TALK",
            "narrator": "真幌",
            "text": "首都防衛団、特別攻撃隊 \n隊長、東雲真幌の権限に\nおいて――",
            "zh": "首都防卫团，特别攻击队\n队长，东云真幌的权限\n——",
            "narrator_zh": "真幌"
        },
        {
            "location": "196/TALK",
            "narrator": "真幌",
            "text": "現時刻より、\n特別攻撃隊への入隊を\n許可する。",
            "zh": "自现在起，\n批准加入\n特别攻击队。",
            "narrator_zh": "真幌"
        },
        {
            "location": "197/TALK",
            "narrator": "つばめ",
            "text": "は、はい！",
            "zh": "是、是！",
            "narrator_zh": "燕"
        },
        {
            "location": "198/TALK",
            "narrator": "真幌",
            "text": "……なんてな。",
            "zh": "……开玩笑的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "200/TALK",
            "narrator": "つばめ",
            "text": "へ？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "201/TALK",
            "narrator": "真幌",
            "text": "いや、単なる一兵卒の\n私如きが、辞令など\n出す事は出来んよ。",
            "zh": "不，我这种小兵，\n可发不出\n任命。",
            "narrator_zh": "真幌"
        },
        {
            "location": "202/TALK",
            "narrator": "真幌",
            "text": "ちょっとした冗談というか、\n景気づけだな。",
            "zh": "算是个玩笑，\n也是打打气。",
            "narrator_zh": "真幌"
        },
        {
            "location": "204/TALK",
            "narrator": "つばめ",
            "text": "あはは、\nそうだったんですね。",
            "zh": "啊哈哈，\n是这样啊。",
            "narrator_zh": "燕"
        },
        {
            "location": "205/TALK",
            "narrator": "真幌",
            "text": "よし、それじゃ\nこれから庁に行って、\n正式に手続きをする。",
            "zh": "好，那就\n现在去厅里，\n正式办手续。",
            "narrator_zh": "真幌"
        },
        {
            "location": "206/TALK",
            "narrator": "真幌",
            "text": "面倒だがそれがお役所だ。",
            "zh": "麻烦，可官厅就是这样。",
            "narrator_zh": "真幌"
        },
        {
            "location": "207/TALK",
            "narrator": "つばめ",
            "text": "はい！",
            "zh": "是！",
            "narrator_zh": "燕"
        },
        {
            "location": "208/TALK",
            "narrator": "真幌",
            "text": "…よろしくな、逢瀬。\n期待しているぞ。",
            "zh": "……多多关照，逢濑。\n我期待着。",
            "narrator_zh": "真幌"
        },
        {
            "location": "209/TALK",
            "narrator": "つばめ",
            "text": "よろしくお願いします！",
            "zh": "请多关照！",
            "narrator_zh": "燕"
        },
        {
            "location": "224/TALK",
            "narrator": "真幌",
            "text": "…とまあ、そういう\nことがあったわけだ。",
            "zh": "……嘛，就是\n这么回事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "225/TALK",
            "narrator": "アーヤ",
            "text": "…庁が粘り強く説得して\nくるとか――",
            "zh": "……厅会缠着说服\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/TALK",
            "narrator": "アーヤ",
            "text": "それって、少し脅迫が\n入ってませんか？",
            "zh": "那不是掺了一点\n威胁吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "227/TALK",
            "narrator": "真幌",
            "text": "勘違いするな。\n私がそれをするわけじゃ\nないのだからな。",
            "zh": "别误会。\n做那种事的\n不是我。",
            "narrator_zh": "真幌"
        },
        {
            "location": "228/TALK",
            "narrator": "真幌",
            "text": "私はただ、経験から\n逢瀬に忠告をしたまでの\nことだ。",
            "zh": "我只是凭经验，\n提醒了逢濑\n而已。",
            "narrator_zh": "真幌"
        },
        {
            "location": "229/TALK",
            "narrator": "アーヤ",
            "text": "忠告、ですか？",
            "zh": "提个醒，吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "230/TALK",
            "narrator": "真幌",
            "text": "そうだ。",
            "zh": "是的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "231/TALK",
            "narrator": "真幌",
            "text": "忘れたのか？\n自分が政府の予算を、\nどれだけ使ったのかを。",
            "zh": "忘了吗？\n你用了政府多少\n预算。",
            "narrator_zh": "真幌"
        },
        {
            "location": "232/TALK",
            "narrator": "アーヤ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "233/TALK",
            "narrator": "真幌",
            "text": "私は今でも、昨日のことの\nように覚えているぞ。",
            "zh": "我到现在还记得，\n像昨天的事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "234/TALK",
            "narrator": "真幌",
            "text": "偶然フェノメノンに\n巻き込まれたおまえが――",
            "zh": "偶然被卷进PhenoMENON的\n你——",
            "narrator_zh": "真幌"
        },
        {
            "location": "235/TALK",
            "narrator": "真幌",
            "text": "持ち前の剣道スキルと\n勘だけでクランを撃退\nしてしまったことを。",
            "zh": "只靠原来的剑道技术和\n直觉，就把库兰\n打退了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "236/TALK",
            "narrator": "真幌",
            "text": "…政府に目を付けられて、\nスカウトされたのも、\nそれがきっかけだったな。",
            "zh": "……被政府盯上、\n被招揽，\n也是从那开始的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "238/TALK",
            "narrator": "アーヤ",
            "text": "そ、その話はやめて\nください！",
            "zh": "那、那件事别\n说了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "239/TALK",
            "narrator": "真幌",
            "text": "向こう見ずな正義感に\n満ちたあの笑顔で、\nこう言ったよな？",
            "zh": "凭着一股莽撞的正义感，\n你笑着\n这么说的吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "240/TALK",
            "narrator": "真幌",
            "text": "任せてください！\nってな。",
            "zh": "交给我！\n之类的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "241/TALK",
            "narrator": "アーヤ",
            "text": "普通に返事しただけじゃ\nないですか！",
            "zh": "我只是正常回答\n而已！",
            "narrator_zh": "绫水"
        },
        {
            "location": "242/TALK",
            "narrator": "真幌",
            "text": "なのに…まさか実家から\n猛反対されて、閉じ込め\nられるとはなぁ…。",
            "zh": "可是……没想到老家\n强烈反对，把你\n关起来了……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "244/TALK",
            "narrator": "アーヤ",
            "text": "うっ…。",
            "zh": "唔……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "245/TALK",
            "narrator": "真幌",
            "text": "まあ、親からしてみれば\nそうしたくなる気持ちも\nわからんでもないがな。",
            "zh": "嘛，从父母来看，\n会那样做的心情\n也不是不能理解。",
            "narrator_zh": "真幌"
        },
        {
            "location": "246/TALK",
            "narrator": "真幌",
            "text": "普通の生活を送っていた\n自分の娘が、突然戦地へ\n赴くと言い出したんだ。",
            "zh": "一直过着普通生活的\n女儿，突然说要\n去战场。",
            "narrator_zh": "真幌"
        },
        {
            "location": "247/TALK",
            "narrator": "真幌",
            "text": "親として、娘を止めるのは\n普通のことだ。",
            "zh": "作为父母，拦住女儿\n是普通的事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "248/TALK",
            "narrator": "アーヤ",
            "text": "…あの時は、ご迷惑を\nおかけしました。",
            "zh": "……那时候，给你们\n添麻烦了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "249/TALK",
            "narrator": "真幌",
            "text": "…まあ、タイミングも\n悪かった。",
            "zh": "……嘛，时机也\n不好。",
            "narrator_zh": "真幌"
        },
        {
            "location": "250/TALK",
            "narrator": "真幌",
            "text": "まさかその直後に、\nまたフェノメノンが\n発生するとはなぁ…。",
            "zh": "没想到紧接着，\n又发生了\nPhenoMENON……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "251/TALK",
            "narrator": "アーヤ",
            "text": "私も、ニュースで知って\n驚きました。",
            "zh": "我也是从新闻里\n知道的，吓了一跳。",
            "narrator_zh": "绫水"
        },
        {
            "location": "252/TALK",
            "narrator": "アーヤ",
            "text": "…もう少し遅かったら、\nやっぱり…。",
            "zh": "……要是再晚一点，\n果然……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "253/TALK",
            "narrator": "真幌",
            "text": "ああ…閉じ込められた\n人間を見捨てなければ\nならなかった…。",
            "zh": "啊……被关起来的人，\n就不得不\n抛弃了……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "254/TALK",
            "narrator": "真幌",
            "text": "だが、政府としても\nこれ以上そんな方法での\n解決は避けたかった。",
            "zh": "不过，政府也不想\n再用那种方法\n解决。",
            "narrator_zh": "真幌"
        },
        {
            "location": "255/TALK",
            "narrator": "真幌",
            "text": "そんな中で見つけたのが、\nおまえという希望だった。",
            "zh": "在那种情况下找到的，\n就是你这个希望。",
            "narrator_zh": "真幌"
        },
        {
            "location": "256/TALK",
            "narrator": "アーヤ",
            "text": "その結果が…あれですか。",
            "zh": "结果就是……那个吗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "257/TALK",
            "narrator": "真幌",
            "text": "ああ…政府要人、軍、\nそれと、おまえの実家が\n神社だから――",
            "zh": "啊……政府要人、军队，\n再加上你老家是\n神社——",
            "narrator_zh": "真幌"
        },
        {
            "location": "258/TALK",
            "narrator": "真幌",
            "text": "本庁までも巻き込んで、\nおまえの家に押しかける\nことになったんだ。",
            "zh": "连本厅都卷进去，\n涌到你家\n去了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "259/TALK",
            "narrator": "真幌",
            "text": "…まあ、それだけ政府も、\nなりふり構っちゃいられ\nない状況だったんだよ。",
            "zh": "……嘛，政府也已经\n顾不上体面\n了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "260/TALK",
            "narrator": "アーヤ",
            "text": "ええ、わかってます。",
            "zh": "嗯，我明白。",
            "narrator_zh": "绫水"
        },
        {
            "location": "261/TALK",
            "narrator": "アーヤ",
            "text": "でも、今回は……",
            "zh": "可是，这次……",
            "narrator_zh": "绫水"
        },
        {
            "location": "262/TALK",
            "narrator": "真幌",
            "text": "まあ、だがなぁ……、\nそんな中でも絶対に\n遵守しているのが――",
            "zh": "嘛，不过啊……，\n即便如此也绝对\n遵守的是——",
            "narrator_zh": "真幌"
        },
        {
            "location": "263/TALK",
            "narrator": "真幌",
            "text": "本人の意思だ。",
            "zh": "本人的意愿。",
            "narrator_zh": "真幌"
        },
        {
            "location": "264/TALK",
            "narrator": "アーヤ",
            "text": "あ……",
            "zh": "啊……",
            "narrator_zh": "绫水"
        },
        {
            "location": "265/TALK",
            "narrator": "真幌",
            "text": "逢瀬は、やりたいという\n意思が、初めからあった。",
            "zh": "逢濑想做的意愿，\n从一开始就有。",
            "narrator_zh": "真幌"
        },
        {
            "location": "266/TALK",
            "narrator": "真幌",
            "text": "それも、こちらが\n思っていたよりも、\n確固たる意志がな。",
            "zh": "而且比这边想的，\n还要\n坚定。",
            "narrator_zh": "真幌"
        },
        {
            "location": "267/TALK",
            "narrator": "真幌",
            "text": "だから、あれは脅迫など\nではないよ。",
            "zh": "所以，那不是\n威胁。",
            "narrator_zh": "真幌"
        },
        {
            "location": "268/TALK",
            "narrator": "真幌",
            "text": "その意思を貫けるように、\n背中を押しただけだ。",
            "zh": "只是推了她一把，\n让她能贯彻意愿。",
            "narrator_zh": "真幌"
        },
        {
            "location": "269/TALK",
            "narrator": "真幌",
            "text": "まあ、何であれ――",
            "zh": "嘛，不管怎样——",
            "narrator_zh": "真幌"
        },
        {
            "location": "270/TALK",
            "narrator": "真幌",
            "text": "おまえの時より\n穏便に終わったのは、\n間違いないな。",
            "zh": "比你那时候\n结束得更平稳，\n这点没错。",
            "narrator_zh": "真幌"
        },
        {
            "location": "272/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "273/TALK",
            "narrator": "真幌",
            "text": "…そういえば、\nおまえの時は――",
            "zh": "……这么说，\n你那时候——",
            "narrator_zh": "真幌"
        },
        {
            "location": "274/TALK",
            "narrator": "真幌",
            "text": "あいつにも色々と\n動いてもらったん\nだったな。",
            "zh": "也让那家伙\n在背后\n动了不少。",
            "narrator_zh": "真幌"
        },
        {
            "location": "276/TALK",
            "narrator": "アーヤ",
            "text": "誰のことですか？",
            "zh": "谁？",
            "narrator_zh": "绫水"
        },
        {
            "location": "277/TALK",
            "narrator": "真幌",
            "text": "エリカだよ。",
            "zh": "领火。",
            "narrator_zh": "真幌"
        },
        {
            "location": "278/TALK",
            "narrator": "真幌",
            "text": "あいつが裏で色々と\n手を回してくれな\nかったら――",
            "zh": "要不是那家伙在背后\n转了不少\n关系——",
            "narrator_zh": "真幌"
        },
        {
            "location": "279/TALK",
            "narrator": "真幌",
            "text": "今頃は\nどうなってたか…。",
            "zh": "现在会变成\n什么样……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "280/TALK",
            "narrator": "アーヤ",
            "text": "やめてください！\nあの人の話は！",
            "zh": "别说了！\n那个人的事！",
            "narrator_zh": "绫水"
        },
        {
            "location": "281/TALK",
            "narrator": "アーヤ",
            "text": "管理庁からスカウト\nされた時から――",
            "zh": "从被管理厅招揽\n的时候起——",
            "narrator_zh": "绫水"
        },
        {
            "location": "282/TALK",
            "narrator": "アーヤ",
            "text": "私は東京に出ようと\n思っていたんです。",
            "zh": "我就想去\n东京。",
            "narrator_zh": "绫水"
        },
        {
            "location": "284/TALK",
            "narrator": "アーヤ",
            "text": "姉は関係ありません！",
            "zh": "和姐姐没关系！",
            "narrator_zh": "绫水"
        },
        {
            "location": "285/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "286/TALK",
            "narrator": "アーヤ",
            "text": "…仕事があるので。\n失礼します。",
            "zh": "……还有工作。\n我先告辞。",
            "narrator_zh": "绫水"
        },
        {
            "location": "290/TALK",
            "narrator": "真幌",
            "text": "やれやれ…。\n姉妹の確執は尚続く、\nか…。",
            "zh": "哎呀呀……。\n姐妹的芥蒂还在继续，\n吗……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "304/TALK",
            "narrator": "アーヤ",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "305/TALK",
            "narrator": "アーヤ",
            "text": "…まったく。\n私が姉のことを\nどう思ってるのか――",
            "zh": "……真是的。\n我怎么看姐姐\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "306/TALK",
            "narrator": "アーヤ",
            "text": "館長は知ってる\nはずなのに…。",
            "zh": "馆长应该\n知道的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "307/SEL",
            "narrator": "",
            "text": "驚いたよ",
            "zh": "吓了一跳",
            "narrator_zh": ""
        },
        {
            "location": "308/ACT",
            "narrator": "",
            "text": "驚いたよ",
            "zh": "吓了一跳",
            "narrator_zh": ""
        },
        {
            "location": "328/TALK",
            "narrator": "アーヤ",
            "text": "どうかしたの？",
            "zh": "怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "329/TALK",
            "narrator": "アーヤ",
            "text": "何か",
            "zh": "什么",
            "narrator_zh": "绫水"
        },
        {
            "location": "330/TALK",
            "narrator": "アーヤ",
            "text": "驚くようなことあった？（￣ー￣？）",
            "zh": "有什么好吃惊的？（￣ー￣？）",
            "narrator_zh": "绫水"
        },
        {
            "location": "332/SEL",
            "narrator": "",
            "text": "お姉さんのこと、本当に嫌いなんだね",
            "zh": "你是真的讨厌姐姐啊",
            "narrator_zh": ""
        },
        {
            "location": "333/ACT",
            "narrator": "",
            "text": "お姉さんのこと、本当に嫌いなんだね",
            "zh": "你是真的讨厌姐姐啊",
            "narrator_zh": ""
        },
        {
            "location": "337/TALK",
            "narrator": "アーヤ",
            "text": "ああ",
            "zh": "啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "338/TALK",
            "narrator": "アーヤ",
            "text": "やっとわかった？(￣Д￣ )",
            "zh": "终于明白了？(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "340/SEL",
            "narrator": "",
            "text": "どうしてなの？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "341/ACT",
            "narrator": "",
            "text": "どうしてなの？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "345/TALK",
            "narrator": "アーヤ",
            "text": "ノーコメント",
            "zh": "无可奉告",
            "narrator_zh": "绫水"
        },
        {
            "location": "347/SEL",
            "narrator": "",
            "text": "教えてほしい",
            "zh": "想让你告诉我",
            "narrator_zh": ""
        },
        {
            "location": "348/ACT",
            "narrator": "",
            "text": "教えてほしい",
            "zh": "想让你告诉我",
            "narrator_zh": ""
        },
        {
            "location": "361/TALK",
            "narrator": "アーヤ",
            "text": "…なんなのよ、\nまったく。",
            "zh": "……什么嘛，\n真是的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "362/TALK",
            "narrator": "アーヤ",
            "text": "あのＢｏｔ、どうして\n姉のこと詮索して\nくるのかしら？",
            "zh": "那个Bot，为什么\n要追问\n姐姐的事？",
            "narrator_zh": "绫水"
        },
        {
            "location": "365/TALK",
            "narrator": "アーヤ",
            "text": "…面倒くさい。\nアンインストール\nできればいいのに…。",
            "zh": "……真麻烦。\n要是能卸载\n就好了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "412/TALK",
            "narrator": "アーヤ",
            "text": "もしかして今回は、\n聞くまでもない？",
            "zh": "这次，也许\n不用问也知道？",
            "narrator_zh": "绫水"
        },
        {
            "location": "413/SEL",
            "narrator": "",
            "text": "アンインストールされそう",
            "zh": "好像要被卸载了",
            "narrator_zh": ""
        },
        {
            "location": "414/ACT",
            "narrator": "",
            "text": "アンインストールされそう",
            "zh": "好像要被卸载了",
            "narrator_zh": ""
        },
        {
            "location": "417/TALK",
            "narrator": "アーヤ",
            "text": "ふふ、そうみたいね。",
            "zh": "呵呵，好像是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "418/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと姉のこと、\n聞き過ぎちゃったかも。",
            "zh": "姐姐的事，\n可能问得有点多。",
            "narrator_zh": "绫水"
        },
        {
            "location": "419/TALK",
            "narrator": "アーヤ",
            "text": "何にせよ、\n扉をコールするわね。",
            "zh": "总之，\n我来呼叫门。",
            "narrator_zh": "绫水"
        },
        {
            "location": "426/TALK",
            "narrator": "アーヤ",
            "text": "オープンプロセス、\n0x44D番地から\n0x603番地へ。",
            "zh": "开放进程，\n从0x44D地址\n到0x603地址。",
            "narrator_zh": "绫水"
        },
        {
            "location": "441/TALK",
            "narrator": "アーヤ",
            "text": "シーク完了。",
            "zh": "搜索完成。",
            "narrator_zh": "绫水"
        },
        {
            "location": "443/TALK",
            "narrator": "アーヤ",
            "text": "姉のことは、私にとって\n相当センシティブな\n話題なのよね。",
            "zh": "姐姐的事，对我来说\n是相当敏感的\n话题。",
            "narrator_zh": "绫水"
        },
        {
            "location": "445/TALK",
            "narrator": "アーヤ",
            "text": "…。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "446/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "448/TALK",
            "narrator": "アーヤ",
            "text": "確かに、貴方のこと\n消そうと思ってるみたい。",
            "zh": "确实，好像想把\n你删掉。",
            "narrator_zh": "绫水"
        },
        {
            "location": "449/TALK",
            "narrator": "アーヤ",
            "text": "それも、割と本気で。",
            "zh": "而且，还挺认真。",
            "narrator_zh": "绫水"
        },
        {
            "location": "450/SEL",
            "narrator": "",
            "text": "どうすればいい？",
            "zh": "该怎么办？",
            "narrator_zh": ""
        },
        {
            "location": "451/ACT",
            "narrator": "",
            "text": "どうすればいい？",
            "zh": "该怎么办？",
            "narrator_zh": ""
        },
        {
            "location": "453/TALK",
            "narrator": "アーヤ",
            "text": "まずは私に、冷静に\nなってもらわないとね。",
            "zh": "首先得让我\n冷静下来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "454/TALK",
            "narrator": "アーヤ",
            "text": "それについては、\n恐らくこの扉の[クラン]を\n倒す事で可能ね。",
            "zh": "这件事，\n大概打倒这扇门的[库兰]\n就能办到。",
            "narrator_zh": "绫水"
        },
        {
            "location": "455/TALK",
            "narrator": "アーヤ",
            "text": "そして次に――",
            "zh": "然后——",
            "narrator_zh": "绫水"
        },
        {
            "location": "456/TALK",
            "narrator": "アーヤ",
            "text": "貴方が現実に戻ったら、\nもう姉の話はしないと\n伝える事かしらね。",
            "zh": "你回到现实之后，\n告诉她别再谈\n姐姐的事，如何。",
            "narrator_zh": "绫水"
        },
        {
            "location": "457/TALK",
            "narrator": "アーヤ",
            "text": "まあ、あくまで私の\n案だから、実際どうする\nかは貴方が決めてね？",
            "zh": "嘛，只是我的\n提议，实际怎么办\n由你决定？",
            "narrator_zh": "绫水"
        },
        {
            "location": "458/TALK",
            "narrator": "アーヤ",
            "text": "それじゃまずは、この\n怒りの源になっている\nクランを倒してくれる？",
            "zh": "那就先，把成为\n这股怒气源头的\n库兰打倒，好吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "459/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "好",
            "narrator_zh": ""
        },
        {
            "location": "460/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "不要",
            "narrator_zh": ""
        },
        {
            "location": "461/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "好",
            "narrator_zh": ""
        },
        {
            "location": "463/TALK",
            "narrator": "アーヤ",
            "text": "ありがと。",
            "zh": "谢谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "464/TALK",
            "narrator": "アーヤ",
            "text": "私も、貴方が縁を\n切られないように\nアプローチしてみるわね。",
            "zh": "我也会试着靠近，\n免得你被\n切断缘分。",
            "narrator_zh": "绫水"
        },
        {
            "location": "465/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！",
            "zh": "献给$handle$和\n国政绫水的，\n美妙的心灵之旅！",
            "narrator_zh": "绫水"
        },
        {
            "location": "472/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不要",
            "narrator_zh": ""
        },
        {
            "location": "473/TALK",
            "narrator": "アーヤ",
            "text": "あらそう。",
            "zh": "哎呀，这样啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "474/TALK",
            "narrator": "アーヤ",
            "text": "今回の件は、できる限り\n早く対処した方が\nよさそうだけど。",
            "zh": "这次的事，还是\n尽快处理\n比较好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "475/TALK",
            "narrator": "アーヤ",
            "text": "気が向いたらいつでも\nクランを退治しに来てね。",
            "zh": "有心情的时候，\n随时来消灭库兰。",
            "narrator_zh": "绫水"
        },
        {
            "location": "476/TALK",
            "narrator": "アーヤ",
            "text": "扉はずっと\n開けておくから。",
            "zh": "门我会一直\n开着。",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月5日　3:31 PM</color>\nゴールデンウィーク最終日、\n神楽坂トライナリー劇場ホワイエにて。",
            "zh": "<color=green>5月5日　3:31 PM</color>\n黄金周最后一天，\n神乐坂三重奏剧场门厅。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "377/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch02",
            "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>国政绫水的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解国政绫水心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch02"
        }
    ]
}
