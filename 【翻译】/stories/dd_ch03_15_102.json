    "type": "MainStory",
    "info": {
        "story_id": "15305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "話せない理由＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "无法开口的理由＜后篇＞"
    },
    "entry": [
        {
            "location": "730/TALK",
            "narrator": "ガブリエラ",
            "text": "正直に話すわ、$marzanna$",
            "zh": "我老实告诉你吧，$marzanna$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "731/TALK",
            "narrator": "ガブリエラ",
            "text": "あなたの言う通りよ",
            "zh": "就像你说的那样",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "733/TALK",
            "narrator": "ガブリエラ",
            "text": "私",
            "zh": "我",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "734/TALK",
            "narrator": "ガブリエラ",
            "text": "心因性の失声症なの",
            "zh": "得了心因性失声症",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "735/TALK",
            "narrator": "ガブリエラ",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "736/TALK",
            "narrator": "ガブリエラ",
            "text": "話せなくて",
            "zh": "才没法开口说话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "738/SEL",
            "narrator": "",
            "text": "男の子とだけ話せないの？",
            "zh": "只跟男孩子没法说话吗？",
            "narrator_zh": ""
        },
        {
            "location": "739/ACT",
            "narrator": "",
            "text": "男の子とだけ話せないの？",
            "zh": "只跟男孩子没法说话吗？",
            "narrator_zh": ""
        },
        {
            "location": "741/TALK",
            "narrator": "ガブリエラ",
            "text": "子供は平気よ",
            "zh": "小孩子的话没问题哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "742/TALK",
            "narrator": "ガブリエラ",
            "text": "この前も保育園で普通に話せたし",
            "zh": "前几天在幼儿园也正常说话了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "743/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "但是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "744/TALK",
            "narrator": "ガブリエラ",
            "text": "ある程度の年齢から上の男の人が相手だと",
            "zh": "只要对方是达到一定年龄以上的男性",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "745/TALK",
            "narrator": "ガブリエラ",
            "text": "話せなくなってしまうの",
            "zh": "我就会发不出声音来",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "748/TALK",
            "narrator": "ガブリエラ",
            "text": "怖いわけじゃないし",
            "zh": "既不是觉得害怕",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "749/TALK",
            "narrator": "ガブリエラ",
            "text": "話したいと思ってはいるのよ？",
            "zh": "我也还是想说话的呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "750/TALK",
            "narrator": "ガブリエラ",
            "text": "けれど",
            "zh": "可是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "751/TALK",
            "narrator": "ガブリエラ",
            "text": "頑張っても全然声が出なくて",
            "zh": "再怎么努力也完全发不出声音",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "752/TALK",
            "narrator": "ガブリエラ",
            "text": "治そうとも思ったけど",
            "zh": "我也想过要治好它",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "753/TALK",
            "narrator": "ガブリエラ",
            "text": "精神的なものだから",
            "zh": "但毕竟是精神层面的原因",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "754/TALK",
            "narrator": "ガブリエラ",
            "text": "薬でどうにかなるようなものじゃないし",
            "zh": "也不是吃药就能解决的嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "756/SEL",
            "narrator": "",
            "text": "そういうことだったのか",
            "zh": "原来是这么一回事啊",
            "narrator_zh": ""
        },
        {
            "location": "757/ACT",
            "narrator": "",
            "text": "そういうことだったのか",
            "zh": "原来是这么一回事啊",
            "narrator_zh": ""
        },
        {
            "location": "759/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなの",
            "zh": "就是这样",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "760/TALK",
            "narrator": "ガブリエラ",
            "text": "でもそのせいで話せないから",
            "zh": "可偏偏因为这样没法开口说话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "761/TALK",
            "narrator": "ガブリエラ",
            "text": "みんなに男性恐怖症と間違われて",
            "zh": "老被大家误以为是男性恐惧症",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "765/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$は間違えないで",
            "zh": "$marzanna$可别搞错了哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "766/TALK",
            "narrator": "ガブリエラ",
            "text": "ちゃんと理解してくれてるのね",
            "zh": "你有好好理解我的苦衷呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "767/TALK",
            "narrator": "ガブリエラ",
            "text": "とっても嬉しいわ////",
            "zh": "我真的好开心////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "772/SEL",
            "narrator": "",
            "text": "今の状況を何とかしないと",
            "zh": "得先把眼下的局面应付过去才行",
            "narrator_zh": ""
        },
        {
            "location": "773/ACT",
            "narrator": "",
            "text": "今の状況を何とかしないと",
            "zh": "得先把眼下的局面应付过去才行",
            "narrator_zh": ""
        },
        {
            "location": "775/TALK",
            "narrator": "ガブリエラ",
            "text": "そうだったわ",
            "zh": "说得也是呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "777/TALK",
            "narrator": "ガブリエラ",
            "text": "協力してもらえる？",
            "zh": "你能帮帮我吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "779/SEL",
            "narrator": "",
            "text": "$me$が代わりに答える",
            "zh": "由$me$来替你回答",
            "narrator_zh": ""
        },
        {
            "location": "780/ACT",
            "narrator": "",
            "text": "$me$が代わりに答える",
            "zh": "由$me$来替你回答",
            "narrator_zh": ""
        },
        {
            "location": "782/TALK",
            "narrator": "ガブリエラ",
            "text": "頼りにしてるわ",
            "zh": "就靠你了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "793/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当、頼りにしてる\nからね、$marzanna$。",
            "zh": "……真的，全靠你\n了哦，$marzanna$。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "794/SEL",
            "narrator": "",
            "text": "端末操作：アラーム",
            "zh": "终端操作：闹钟",
            "narrator_zh": ""
        },
        {
            "location": "795/ACT",
            "narrator": "",
            "text": "端末操作：アラーム",
            "zh": "终端操作：闹钟",
            "narrator_zh": ""
        },
        {
            "location": "802/TALK",
            "narrator": "キリト",
            "text": "うわっ！？\nビックリしたぁ…。",
            "zh": "呜哇！？\n吓我一跳……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "805/TALK",
            "narrator": "ヒカル",
            "text": "電話…いや、アラーム\nかな？",
            "zh": "电话……不对，\n是闹钟吗？",
            "narrator_zh": "光"
        },
        {
            "location": "806/TALK",
            "narrator": "ガブリエラ",
            "text": "こっち向いてくれた。\nよーし！",
            "zh": "他们看过来啦。\n好——！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "811/SEL",
            "narrator": "",
            "text": "喋れないのには理由がある",
            "zh": "说不出话是有原因的",
            "narrator_zh": ""
        },
        {
            "location": "812/ACT",
            "narrator": "",
            "text": "喋れないのには理由がある",
            "zh": "说不出话是有原因的",
            "narrator_zh": ""
        },
        {
            "location": "815/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "817/TALK",
            "narrator": "ヒカル",
            "text": "えっと…、喋れない\nのには理由がある…？",
            "zh": "那个……、说不出话\n是有原因的……？",
            "narrator_zh": "光"
        },
        {
            "location": "818/TALK",
            "narrator": "ヒカル",
            "text": "やっぱり…、そういう\nことだったんですね。",
            "zh": "果然……、是这么\n一回事啊。",
            "narrator_zh": "光"
        },
        {
            "location": "819/TALK",
            "narrator": "キリト",
            "text": "いや、納得するには\n早いだろ？",
            "zh": "不对，这就直接\n接受也太快了吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "820/TALK",
            "narrator": "キリト",
            "text": "その理由ってのは\n何なんだ？",
            "zh": "那个原因到底\n是什么啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "823/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "824/TALK",
            "narrator": "ガブリエラ",
            "text": "本当、遠慮なく\n聞いてくるん\nだから…。",
            "zh": "真是的，问起来\n还真是一点都不\n客气啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "825/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、嫌いじゃない\nけどね…。",
            "zh": "不过，倒也不讨厌\n就是了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "826/SEL",
            "narrator": "",
            "text": "声に呪いが掛かってるから",
            "zh": "因为声音被下了诅咒",
            "narrator_zh": ""
        },
        {
            "location": "827/SEL",
            "narrator": "",
            "text": "美声過ぎて男を魅了するから",
            "zh": "因为声音太好听会魅惑男人",
            "narrator_zh": ""
        },
        {
            "location": "828/SEL",
            "narrator": "",
            "text": "今は待ってほしい",
            "zh": "现在还请先等等",
            "narrator_zh": ""
        },
        {
            "location": "829/ACT",
            "narrator": "",
            "text": "声に呪いが掛かってるから",
            "zh": "因为声音被下了诅咒",
            "narrator_zh": ""
        },
        {
            "location": "833/TALK",
            "narrator": "ガブリエラ",
            "text": "…は？",
            "zh": "……哈？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "834/TALK",
            "narrator": "キリト",
            "text": "…の、呪い？",
            "zh": "……诅、诅咒？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "836/TALK",
            "narrator": "ヒカル",
            "text": "え、えっと…。",
            "zh": "那、那个……。",
            "narrator_zh": "光"
        },
        {
            "location": "838/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、$marzanna$！？\n何言おうとしてるの！？",
            "zh": "等、$marzanna$！？\n你打算说什么啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "840/TALK",
            "narrator": "キリト",
            "text": "あー、の、呪いかぁ…。\n男と話せなくなる的な\nヤツか？",
            "zh": "啊—，诅、诅咒啊……。\n就是那种没法跟男人\n说话的诅咒吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "841/TALK",
            "narrator": "ガブリエラ",
            "text": "ど、どうするのよ\n$marzanna$！",
            "zh": "这、这下怎么办呀\n$marzanna$！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "842/SEL",
            "narrator": "",
            "text": "私と話した男は三日後に死んでしまう",
            "zh": "跟我说过话的男人三天后就会死掉",
            "narrator_zh": ""
        },
        {
            "location": "843/ACT",
            "narrator": "",
            "text": "私と話した男は三日後に死んでしまう",
            "zh": "跟我说过话的男人三天后就会死掉",
            "narrator_zh": ""
        },
        {
            "location": "845/TALK",
            "narrator": "ガブリエラ",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "846/TALK",
            "narrator": "キリト",
            "text": "ぶふっ！！",
            "zh": "噗嗤！！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "847/TALK",
            "narrator": "ヒカル",
            "text": "お、思った以上に\n強力な呪いですね…。",
            "zh": "比、比想象中\n还要强力的诅咒呢……。",
            "narrator_zh": "光"
        },
        {
            "location": "849/TALK",
            "narrator": "キリト",
            "text": "呪いってかこれもう、\n即死系魔法だろ…。",
            "zh": "与其说是诅咒，\n这根本是即死系魔法了吧……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "851/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$ッ！！\nどうするのよこの状況！？",
            "zh": "$marzanna$！！\n这局面你要怎么收场啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "852/TALK",
            "narrator": "キリト",
            "text": "…まあ、言えない理由が\nあるのはわかったけど、\nこれは逆効果だと思うぞ？",
            "zh": "……嘛，虽然知道你有\n不便说出口的苦衷，\n但这招只会起反效果吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "853/TALK",
            "narrator": "ヒカル",
            "text": "うん…この理由だと、\nちょっとだけ\n気になっちゃうよね。",
            "zh": "嗯……给这个理由的话，\n反而会让人\n有点在意呢。",
            "narrator_zh": "光"
        },
        {
            "location": "854/TALK",
            "narrator": "キリト",
            "text": "呪いは大げさにしても、\n何かしらありそうな気が\nしてくるよな。",
            "zh": "就算诅咒是夸张了点，\n反而更让人觉得背后\n肯定有什么隐情啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "855/TALK",
            "narrator": "キリト",
            "text": "…ガブリエラ。\n一言でいいから、\n何か言ってもらえるか？",
            "zh": "……加布里埃拉。\n哪怕只说一句话也好，\n能开口说句什么吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "857/TALK",
            "narrator": "ガブリエラ",
            "text": "逆効果になってる\nじゃない！！",
            "zh": "这不是完全起\n反效果了吗！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "858/TALK",
            "narrator": "ヒカル",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "光"
        },
        {
            "location": "860/TALK",
            "narrator": "ヒカル",
            "text": "…あ、キリト。\n教官に倉庫整理を\n頼まれてたでしょ？",
            "zh": "……啊，圣翔。\n教官之前不是拜托我们\n整理仓库来着吗？",
            "narrator_zh": "光"
        },
        {
            "location": "861/TALK",
            "narrator": "ヒカル",
            "text": "お客さんもいないし、\n今のうちにやった方が\nいいんじゃない？",
            "zh": "现在也没有客人，\n趁这会儿先去干完\n岂不是更好？",
            "narrator_zh": "光"
        },
        {
            "location": "864/TALK",
            "narrator": "キリト",
            "text": "ん…そうだな。\n忘れて説教食らう方が、\n呪いより怖いし。",
            "zh": "嗯……说得也是。\n要是忘了被训一顿，\n那可比诅咒可怕多了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "865/TALK",
            "narrator": "ヒカル",
            "text": "そういうわけだから\nガブリエラさん、\nあとはお願いします。",
            "zh": "事情就是这样，\n加布里埃拉，\n这边就拜托你了。",
            "narrator_zh": "光"
        },
        {
            "location": "876/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "877/TALK",
            "narrator": "ガブリエラ",
            "text": "さて、と。",
            "zh": "好了，那么。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "891/TALK",
            "narrator": "ガブリエラ",
            "text": "どうして適当なことを言うの？",
            "zh": "你为什么要胡说八道啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "892/TALK",
            "narrator": "ガブリエラ",
            "text": "原因は心因性失声症だって自分で言ったでしょう？",
            "zh": "我明明都自己说了原因就是心因性失声症吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "893/TALK",
            "narrator": "ガブリエラ",
            "text": "なのに",
            "zh": "结果",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "894/TALK",
            "narrator": "ガブリエラ",
            "text": "呪いって何！？",
            "zh": "什么诅咒啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "895/TALK",
            "narrator": "ガブリエラ",
            "text": "これじゃただの妄想癖のある女の子じゃない！",
            "zh": "这样我不就成了一个有妄想症的女生了吗！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "896/TALK",
            "narrator": "ガブリエラ",
            "text": "これからどんな顔して二人に会えばいいのよ？",
            "zh": "以后我还有什么脸去见他们俩啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "897/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$のバカ！",
            "zh": "$marzanna$这个大笨蛋！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "908/ACT",
            "narrator": "",
            "text": "美声過ぎて男を魅了するから",
            "zh": "因为声音太好听会魅惑男人",
            "narrator_zh": ""
        },
        {
            "location": "910/TALK",
            "narrator": "ガブリエラ",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "911/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$！？\n何言ってるのよー！",
            "zh": "$marzanna$！？\n你在胡说什么呀—！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "914/TALK",
            "narrator": "キリト",
            "text": "…いや、うん。",
            "zh": "……不是，嗯。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "915/TALK",
            "narrator": "キリト",
            "text": "まあ、ガブリエラの\n声って、確かに綺麗\nだったよな？",
            "zh": "嘛，加布里埃拉的\n声音，确实是\n挺好听的吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "916/TALK",
            "narrator": "ヒカル",
            "text": "うん、僕もそう思う。",
            "zh": "嗯，我也这么觉得。",
            "narrator_zh": "光"
        },
        {
            "location": "917/TALK",
            "narrator": "キリト",
            "text": "けどなぁ…さすがに\nこれは言い過ぎじゃ\nねぇかぁ？",
            "zh": "不过吧……这未免\n也太夸张过头了\n点吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "919/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "921/TALK",
            "narrator": "キリト",
            "text": "まあ、あれだ。\n声だけじゃ魅了するには\n足りないな。",
            "zh": "嘛，怎么说呢。\n光靠声音还不足以\n魅惑男人吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "922/TALK",
            "narrator": "キリト",
            "text": "でも、もうちっと胸が\n大きくなったら、\nマジでそうなんじゃね？",
            "zh": "不过，要是胸部再\n大那么一点点的话，\n说不定真能行哦？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "923/TALK",
            "narrator": "ガブリエラ",
            "text": "む、胸！？",
            "zh": "胸、胸部！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "926/TALK",
            "narrator": "ヒカル",
            "text": "ちょ！？　キリト、\n女の子にそういうこと\n言うのは――",
            "zh": "喂！？　圣翔，\n对女孩子说这种话\n也太——",
            "narrator_zh": "光"
        },
        {
            "location": "928/TALK",
            "narrator": "キリト",
            "text": "いや、男を魅了する\nためには必要だと\n思うぞ？",
            "zh": "不是，想要魅惑男人\n的话这确实很必要\n吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "930/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "932/TALK",
            "narrator": "ヒカル",
            "text": "え、えっと…。",
            "zh": "那、那个……。",
            "narrator_zh": "光"
        },
        {
            "location": "933/TALK",
            "narrator": "ヒカル",
            "text": "そうだ！\n倉庫整理、今のうちに\nやっちゃおうよ。",
            "zh": "对了！\n仓库整理，咱们趁现在\n赶紧去干了吧。",
            "narrator_zh": "光"
        },
        {
            "location": "934/TALK",
            "narrator": "キリト",
            "text": "別に今じゃなくても\nいいだろ。",
            "zh": "倒也不用非得\n现在去吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "935/TALK",
            "narrator": "ヒカル",
            "text": "忘れて東雲教官に\n怒られるよりは\nいいと思うけど？",
            "zh": "总比忘了被东云\n教官骂一顿要\n强得多吧？",
            "narrator_zh": "光"
        },
        {
            "location": "936/TALK",
            "narrator": "ヒカル",
            "text": "そういうわけだから\nガブリエラさん、\nあとはお願いします。",
            "zh": "事情就是这样，\n加布里埃拉，\n这边就拜托你了。",
            "narrator_zh": "光"
        },
        {
            "location": "937/TALK",
            "narrator": "キリト",
            "text": "はぁ…仕方ねぇなぁ。",
            "zh": "唉……真拿你没办法。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "948/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "949/TALK",
            "narrator": "ガブリエラ",
            "text": "さて、と。",
            "zh": "好了，那么。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "961/TALK",
            "narrator": "ガブリエラ",
            "text": "弁解があれば聞いてあげるわ",
            "zh": "有什么辩解的话我姑且听听看吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "964/SEL",
            "narrator": "",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": ""
        },
        {
            "location": "965/ACT",
            "narrator": "",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": ""
        },
        {
            "location": "967/TALK",
            "narrator": "ガブリエラ",
            "text": "さすがに",
            "zh": "真没想到",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "968/TALK",
            "narrator": "ガブリエラ",
            "text": "いきなり謝られるとは思わなかったわ",
            "zh": "你会一上来就直接道歉呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "969/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか",
            "zh": "话说回来",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "970/TALK",
            "narrator": "ガブリエラ",
            "text": "この件でふざけるのは本当やめて！",
            "zh": "在这件事上真别跟我开玩笑！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "971/TALK",
            "narrator": "ガブリエラ",
            "text": "ヒカルくん達とまともに喋れないこと",
            "zh": "没法跟光他们好好说话这件事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "972/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に辛いと思ってるんだから",
            "zh": "我心里真的很难受的呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "974/SEL",
            "narrator": "",
            "text": "ふざけ過ぎた、ごめん",
            "zh": "玩笑开过头了，抱歉",
            "narrator_zh": ""
        },
        {
            "location": "975/ACT",
            "narrator": "",
            "text": "ふざけ過ぎた、ごめん",
            "zh": "玩笑开过头了，抱歉",
            "narrator_zh": ""
        },
        {
            "location": "978/TALK",
            "narrator": "ガブリエラ",
            "text": "もういいけど",
            "zh": "算了算了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "979/TALK",
            "narrator": "ガブリエラ",
            "text": "今回だけよ？",
            "zh": "下不为例哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "990/ACT",
            "narrator": "",
            "text": "今は待ってほしい",
            "zh": "现在还请先等等",
            "narrator_zh": ""
        },
        {
            "location": "992/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "994/TALK",
            "narrator": "キリト",
            "text": "今は、待ってほしい？",
            "zh": "现在，还请先等等？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "996/TALK",
            "narrator": "ヒカル",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "光"
        },
        {
            "location": "998/TALK",
            "narrator": "キリト",
            "text": "よくわからないけど、\nマジで今はダメなのか？",
            "zh": "虽然不太懂，\n但真的现在不行吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "1000/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1001/TALK",
            "narrator": "キリト",
            "text": "…マジみてぇだな。",
            "zh": "……看来是真的啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "1002/TALK",
            "narrator": "ヒカル",
            "text": "でも、待ってほしいって\n言ってもらえたのは\nよかったよ。",
            "zh": "不过，能听她说一句\n请等等，就已经\n很不错了哦。",
            "narrator_zh": "光"
        },
        {
            "location": "1003/TALK",
            "narrator": "ヒカル",
            "text": "それって、いつかは\n話せる日が来る、って\nことだと思うし。",
            "zh": "因为那也意味着，\n总有一天会迎来\n能够说话的那天吧。",
            "narrator_zh": "光"
        },
        {
            "location": "1004/TALK",
            "narrator": "ヒカル",
            "text": "でしょ？\nガブリエラさん。",
            "zh": "对吧？\n加布里埃拉。",
            "narrator_zh": "光"
        },
        {
            "location": "1006/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1007/TALK",
            "narrator": "ヒカル",
            "text": "ね？　それがわかった\nだけでも、今はいいん\nじゃないかな？",
            "zh": "是吧？　光是知道\n这一点，现在不就\n够了吗？",
            "narrator_zh": "光"
        },
        {
            "location": "1008/TALK",
            "narrator": "キリト",
            "text": "…そうだな。",
            "zh": "……说得也是。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "1009/TALK",
            "narrator": "キリト",
            "text": "あんまし女の子\n急かすのも\nかっこ悪ぃもんな。",
            "zh": "老是催促女孩子\n也挺没风度的\n嘛。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "1010/TALK",
            "narrator": "ヒカル",
            "text": "だね。",
            "zh": "就是嘛。",
            "narrator_zh": "光"
        },
        {
            "location": "1011/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1012/TALK",
            "narrator": "ガブリエラ",
            "text": "よかった…。\n納得してくれた\nみたい。",
            "zh": "太好了……。\n他们好像\n接受了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1014/TALK",
            "narrator": "ヒカル",
            "text": "それよりキリト、\n東雲教官に倉庫整理\n頼まれてたでしょ？",
            "zh": "话说圣翔，\n东云教官不是拜托我们\n去整理仓库来着吗？",
            "narrator_zh": "光"
        },
        {
            "location": "1015/TALK",
            "narrator": "ヒカル",
            "text": "お客さんもいないし、\n今のうちにやった方が\nいいんじゃない？",
            "zh": "现在也没有客人，\n趁这会儿先去干完\n岂不是更好？",
            "narrator_zh": "光"
        },
        {
            "location": "1016/TALK",
            "narrator": "キリト",
            "text": "そうだな。\n忘れたりしたら\n超怒られそうだし。",
            "zh": "说得也是。\n要是忘了之类的\n肯定会被骂惨。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "1017/TALK",
            "narrator": "ヒカル",
            "text": "ガブリエラさん。\nすみませんが、\nあとは任せますね。",
            "zh": "加布里埃拉。\n不好意思，\n这边就交给你了。",
            "narrator_zh": "光"
        },
        {
            "location": "1028/TALK",
            "narrator": "ガブリエラ",
            "text": "よかった…。\n理由があるのだけは\nわかってもらえて…。",
            "zh": "太好了……。\n至少让他们明白了\n我是有原因的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1040/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$、どうもありがとう",
            "zh": "$marzanna$，真是太谢谢你了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1041/TALK",
            "narrator": "ガブリエラ",
            "text": "上手く私の気持ち",
            "zh": "你很顺利地把我的心情",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1042/TALK",
            "narrator": "ガブリエラ",
            "text": "二人に伝えてくれたわね",
            "zh": "传达给他们俩了呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1044/SEL",
            "narrator": "",
            "text": "理由を話すのは任せたよ",
            "zh": "讲出理由的事就交给你自己了",
            "narrator_zh": ""
        },
        {
            "location": "1045/ACT",
            "narrator": "",
            "text": "理由を話すのは任せたよ",
            "zh": "讲出理由的事就交给你自己了",
            "narrator_zh": ""
        },
        {
            "location": "1047/TALK",
            "narrator": "ガブリエラ",
            "text": "わかってるわ",
            "zh": "我知道的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1048/TALK",
            "narrator": "ガブリエラ",
            "text": "そこまで$marzanna$に任せられないわ",
            "zh": "那种事总不能全推给$marzanna$嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1049/TALK",
            "narrator": "ガブリエラ",
            "text": "それは私が",
            "zh": "那可是我",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1050/TALK",
            "narrator": "ガブリエラ",
            "text": "自分の言葉で伝えないといけないことだものね",
            "zh": "必须用自己的话语亲口传达的事情呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1053/TALK",
            "narrator": "ガブリエラ",
            "text": "そのときはもちろん",
            "zh": "到了那个时候",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1054/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$も側で見守ってくれるわよね？",
            "zh": "$marzanna$当然也会在旁边守望着我吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1056/SEL",
            "narrator": "",
            "text": "もちろんだよ",
            "zh": "那当然了",
            "narrator_zh": ""
        },
        {
            "location": "1057/ACT",
            "narrator": "",
            "text": "もちろんだよ",
            "zh": "那当然了",
            "narrator_zh": ""
        },
        {
            "location": "1059/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう",
            "zh": "谢谢你",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1060/TALK",
            "narrator": "ガブリエラ",
            "text": "それを聞けて安心したわ",
            "zh": "听到你这么说我就放心了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1073/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1074/TALK",
            "narrator": "ガブリエラ",
            "text": "…ヒカルくんにも、\n結構気を使わせ\nちゃったなぁ。",
            "zh": "……光他也，\n替我费了不少\n心思呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1075/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、ちゃんと理由を\n話せてないあたしの\nことを――",
            "zh": "明明我连理由都\n没能好好说出口，\n他却——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1076/TALK",
            "narrator": "ガブリエラ",
            "text": "何も聞かずに\nフォローしてくれる\nなんて…。",
            "zh": "什么也不多问，\n就那样替我\n解围……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1077/TALK",
            "narrator": "ガブリエラ",
            "text": "…ヒカルくんって、\nいい人よね…。",
            "zh": "……光，真是个\n好人呀……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1078/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1079/TALK",
            "narrator": "ガブリエラ",
            "text": "い、いけない！\nつい声に\n出しちゃった！",
            "zh": "糟、糟糕！\n一不小心就\n说出口了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1081/TALK",
            "narrator": "ガブリエラ",
            "text": "もぅ、何やってんの\nかしら、あたし…。",
