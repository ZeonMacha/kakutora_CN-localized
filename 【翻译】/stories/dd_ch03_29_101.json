{
    "dir": "chap29/daydra/dd_ch03_29_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "29302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "かしこみかしこみ＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "诚惶诚恐＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "かしこみかしこみ",
            "zh": "诚惶诚恐",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "……うーん……。",
            "zh": "……唔嗯……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "25/TALK",
            "narrator": "ガブリエラ",
            "text": "…変な時間に\n目が覚めちゃったわ…。",
            "zh": "……居然在这种奇怪的时间\n醒过来了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "…今何時かしら…。",
            "zh": "……现在几点了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "27/TALK",
            "narrator": "ガブリエラ",
            "text": "二時？　夜中の！？",
            "zh": "两点？　半夜两点！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "透明みやび",
            "text": "くー…。くー…。",
            "zh": "呼……呼……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "よく寝てられるわね\nみやびったら。",
            "zh": "真亏她还能睡得这么香，\n雅这家伙。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "この世界が\nフェノメノンだって\nわかったのに…。",
            "zh": "明明都已经知道\n这个世界是PhenoMENON了\n说……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "…？\n何かしら？",
            "zh": "……？\n什么声音？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "57/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ？",
            "zh": "绫水？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ？",
            "zh": "加维？",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "アーヤ",
            "text": "起こしちゃった？\nごめんね。",
            "zh": "把你吵醒了吗？\n不好意思。",
            "narrator_zh": "绫水"
        },
        {
            "location": "69/TALK",
            "narrator": "ガブリエラ",
            "text": "それはいいんだけど…。\n何してるの？",
            "zh": "那倒是无所谓……。\n你在干什么呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "アーヤ",
            "text": "禊ぎ。",
            "zh": "行禊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "本来は神様に\n誓いを立てる前に\nするものだけど。",
            "zh": "本来是在向神明\n立下誓言之前\n做的仪式。",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "アーヤ",
            "text": "今は自分自身に\n活を入れるために\nしているの。",
            "zh": "不过现在我是为了\n给自己打打气、振作精神\n才做的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "アーヤ",
            "text": "なんだか\n落ち着かなくて。",
            "zh": "总觉得有点\n静不下心来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ。",
            "zh": "我说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "それあたしも\nやっていい？\nしてもいいこと？",
            "zh": "那个我也能\n一起做吗？\n是可以做的事吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "アーヤ",
            "text": "…大歓迎よ。",
            "zh": "……非常欢迎哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "浴衣とはまたちょっと\n違うのね…。",
            "zh": "跟浴衣又稍微\n有点不一样呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/SEL",
            "narrator": "",
            "text": "萌える！",
            "zh": "太萌了！",
            "narrator_zh": ""
        },
        {
            "location": "111/SEL",
            "narrator": "",
            "text": "気合い入れてこ！",
            "zh": "打起精神上吧！",
            "narrator_zh": ""
        },
        {
            "location": "112/ACT",
            "narrator": "",
            "text": "萌える！",
            "zh": "太萌了！",
            "narrator_zh": ""
        },
        {
            "location": "128/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうのは",
            "zh": "那种话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "今はいいから",
            "zh": "现在就免了吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "130/ACT",
            "narrator": "",
            "text": "気合い入れてこ！",
            "zh": "打起精神上吧！",
            "narrator_zh": ""
        },
        {
            "location": "146/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "说得对",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "147/TALK",
            "narrator": "ガブリエラ",
            "text": "そうするわ",
            "zh": "我会的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "160/TALK",
            "narrator": "アーヤ",
            "text": "冷たいから\n気をつけてね。",
            "zh": "水很凉，\n小心点哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "161/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うん。",
            "zh": "嗯、嗯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/TALK",
            "narrator": "ガブリエラ",
            "text": "…予想以上に冷たい…！",
            "zh": "……比想象中还要冰……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "169/TALK",
            "narrator": "ガブリエラ",
            "text": "…でもアーヤは平気な\n顔をしてるわ……。　",
            "zh": "……可是绫水却一副\n若无其事的表情……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "170/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしだって…！　",
            "zh": "……我可也不能输……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "175/TALK",
            "narrator": "アーヤ",
            "text": "…どう？",
            "zh": "……怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんだか少し\n気持ちがすっきりした\n気がするわ。",
            "zh": "……总觉得心里\n稍微清爽了一点\n呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "180/TALK",
            "narrator": "アーヤ",
            "text": "そう。\nならよかった。",
            "zh": "是吗。\n那就好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "181/TALK",
            "narrator": "みやび",
            "text": "どこに行ったか\n思うたら。",
            "zh": "我还寻思你们\n跑哪儿去了。",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "みやび",
            "text": "こんなところに\nおったぞね。",
            "zh": "原来跑这儿\n来了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "186/TALK",
            "narrator": "アーヤ",
            "text": "みやびも\n起こしちゃった？",
            "zh": "把雅也\n吵醒了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "というより\n寝付けんかったぞね。",
            "zh": "倒不如说\n根本睡不着啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "188/TALK",
            "narrator": "みやび",
            "text": "うちは繊細やき。",
            "zh": "我这个人很纤细啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "191/TALK",
            "narrator": "ガブリエラ",
            "text": "さっきいびきかいて\n寝てたわよね？",
            "zh": "刚才明明还在打着呼噜\n大睡特睡吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "みやび",
            "text": "気のせいやき。",
            "zh": "你的错觉啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "フェノメノンの中で\n爆睡できるほどの\n度胸はないぞね。",
            "zh": "在PhenoMENON里面\n还能呼呼大睡，\n我可没那胆量啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "198/TALK",
            "narrator": "ガブリエラ",
            "text": "……ここって\nつばめの作った\n世界なのよね。",
            "zh": "……这里，\n是燕创造出来的\n世界对吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "201/TALK",
            "narrator": "アーヤ",
            "text": "姉の言葉を\n信じるならね。",
            "zh": "如果相信\n姐姐的话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "203/TALK",
            "narrator": "ガブリエラ",
            "text": "だったら。\n本当のあたしたちって\nどんななのかしら。",
            "zh": "既然如此。\n那真正的我们，\n到底是什么样子的呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "みやび",
            "text": "今とは似ても似つかん\n姿かもわからんねえ。",
            "zh": "说不定跟现在完全是\n八竿子打不着的模样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "207/TALK",
            "narrator": "ガブリエラ",
            "text": "ビデオの中の\nあたしたちは今と\n同じだったでしょ？",
            "zh": "录像里面的\n我们不是跟现在\n一模一样吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "あれは認知のゆがみで\nそう見えるだけかも\nわからんき。",
            "zh": "那说不定只是认知扭曲\n才让我们看起来\n那样而已啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "210/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと！\n怖くなるようなこと\n言わないでよ！",
            "zh": "喂！\n别说这种\n吓人的话啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "258/TALK",
            "narrator": "ガブリエラ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "273/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "きたわね！",
            "zh": "你来啦！",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "274/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "この前はごめんなさいね。\nあたしの変態人格が\nヘンなこと言っちゃって。",
            "zh": "上次真是对不住啊。\n我的变态人格\n说了些奇怪的话。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "275/SEL",
            "narrator": "",
            "text": "ガブリエラの中には高慢が潜んでいるんだね",
            "zh": "原来加布里埃拉的内心潜藏着傲慢啊",
            "narrator_zh": ""
        },
        {
            "location": "276/SEL",
            "narrator": "",
            "text": "ブヒィィィィ！！",
            "zh": "噗咿咿咿咿！！",
            "narrator_zh": ""
        },
        {
            "location": "277/ACT",
            "narrator": "",
            "text": "ガブリエラの中には高慢が潜んでいるんだね",
            "zh": "原来加布里埃拉的内心潜藏着傲慢啊",
            "narrator_zh": ""
        },
        {
            "location": "278/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "そうみたい。\nあたしには\n理解できないけど。",
            "zh": "好像是呢。\n虽然我完全\n无法理解就是了。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "279/ACT",
            "narrator": "",
            "text": "ブヒィィィィ！！",
            "zh": "噗咿咿咿咿！！",
            "narrator_zh": ""
        },
        {
            "location": "281/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "も、もしかしてあんた、\n本気でアイツの豚に\nなるつもり！？",
            "zh": "难、难道说你，\n是认真的打算\n去当那家伙的猪吗！？",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "282/SEL",
            "narrator": "",
            "text": "冗談です！",
            "zh": "开玩笑的！",
            "narrator_zh": ""
        },
        {
            "location": "283/SEL",
            "narrator": "",
            "text": "本気です！",
            "zh": "我是认真的！",
            "narrator_zh": ""
        },
        {
            "location": "284/ACT",
            "narrator": "",
            "text": "冗談です！",
            "zh": "开玩笑的！",
            "narrator_zh": ""
        },
        {
            "location": "285/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "はぁ…。\nもう、びっくり\nさせないでよね……。",
            "zh": "哈啊……。\n真是的，别吓我\n好不好……。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "286/ACT",
            "narrator": "",
            "text": "本気です！",
            "zh": "我是认真的！",
            "narrator_zh": ""
        },
        {
            "location": "288/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "……っ。",
            "zh": "……唔。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "289/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "も、もしかして、\nああいうのが好みだったり\nするのかしら？",
            "zh": "难、难道说，\n你其实比较喜欢\n那一种类型吗？",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "292/SEL",
            "narrator": "",
            "text": "冗談です！！",
            "zh": "开玩笑的啦！！",
            "narrator_zh": ""
        },
        {
            "location": "293/SEL",
            "narrator": "",
            "text": "そうです！！",
            "zh": "没错！！",
            "narrator_zh": ""
        },
        {
            "location": "294/ACT",
            "narrator": "",
            "text": "冗談です！！",
            "zh": "开玩笑的啦！！",
            "narrator_zh": ""
        },
        {
            "location": "296/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "はぁ…。\nもう、びっくり\nさせないでよね……。",
            "zh": "哈啊……。\n真是的，别吓我\n好不好……。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "297/ACT",
            "narrator": "",
            "text": "そうです！！",
            "zh": "没错！！",
            "narrator_zh": ""
        },
        {
            "location": "299/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "そ、そうなのね……。",
            "zh": "这、这样啊……。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "300/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "301/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "わ、わかったわ。\nいいわよ。",
            "zh": "我、我知道了。\n好吧。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "302/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "それじゃ、今日から\nあたしがあんたを\nかっ……",
            "zh": "那就从今天起，\n由我来把你\n养……",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "303/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "かかか飼って\nあげるんだから！\nこ、こここの豚！！",
            "zh": "养、养养养起来\n好啦！\n你、你你这头猪！！",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "304/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "……ちゃん。",
            "zh": "……酱。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "305/SEL",
            "narrator": "",
            "text": "ブヒィィィィィィィィィィィィィィィィィィィィィィィィ！！",
            "zh": "噗咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿！！",
            "narrator_zh": ""
        },
        {
            "location": "306/SEL",
            "narrator": "",
            "text": "そういうのじゃないんだ！もっと激しく罵ってくれ！！",
            "zh": "不是那种感觉啦！再狠狠地骂我吧！！",
            "narrator_zh": ""
        },
        {
            "location": "307/ACT",
            "narrator": "",
            "text": "ブヒィィィィィィィィィィィィィィィィィィィィィィィィ！！",
            "zh": "噗咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿咿！！",
            "narrator_zh": ""
        },
        {
            "location": "310/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "きゃぁぁぁっ！\n落ち着いて落ち着いて！",
            "zh": "呀啊啊啊！\n冷静点冷静点！",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "311/ACT",
            "narrator": "",
            "text": "そういうのじゃないんだ！もっと激しく罵ってくれ！！",
            "zh": "不是那种感觉啦！再狠狠地骂我吧！！",
            "narrator_zh": ""
        },
        {
            "location": "314/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "えええええっ！？\n今ので精一杯よ！",
            "zh": "诶诶诶诶诶！？\n刚才那样已经是我的极限了啦！",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "316/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "やっぱりあたしには\n無理だわね。\nそういうのは……。",
            "zh": "果然我还是\n做不来啊。\n那种事……。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "317/SEL",
            "narrator": "",
            "text": "君は今まで通りの方法で$me$を愛してくれればそれでいい（キリッ",
            "zh": "你只要用一直以来的方式爱着$me$就够了（严肃脸",
            "narrator_zh": ""
        },
        {
            "location": "318/SEL",
            "narrator": "",
            "text": "リヴォルカにメロメロになりそう",
            "zh": "感觉快要被莉沃尔卡迷得神魂颠倒了",
            "narrator_zh": ""
        },
        {
            "location": "319/ACT",
            "narrator": "",
            "text": "君は今まで通りの方法で$me$を愛してくれればそれでいい（キリッ",
            "zh": "你只要用一直以来的方式爱着$me$就够了（严肃脸",
            "narrator_zh": ""
        },
        {
            "location": "321/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "今更そんなキリッと\nされても、全然かっこよく\nないわよ、豚。",
            "zh": "事到如今摆出那种严肃脸，\n也一点都不帅气\n好吗，猪。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "322/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "ああっ！！",
            "zh": "啊啊！！",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "323/ACT",
            "narrator": "",
            "text": "リヴォルカにメロメロになりそう",
            "zh": "感觉快要被莉沃尔卡迷得神魂颠倒了",
            "narrator_zh": ""
        },
        {
            "location": "325/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "はぁぁぁ……\nもういいわ。",
            "zh": "哈啊啊啊……\n算了随便你。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "そんなに豚になりたいなら\n好きにすればいいのよ。",
            "zh": "这么想当猪的话，\n你就随自己的便吧。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "327/SEL",
            "narrator": "",
            "text": "だって、司書さん名前教えてくれないし",
            "zh": "因为司书小姐你又不肯告诉我名字嘛",
            "narrator_zh": ""
        },
        {
            "location": "328/ACT",
            "narrator": "",
            "text": "だって、司書さん名前教えてくれないし",
            "zh": "因为司书小姐你又不肯告诉我名字嘛",
            "narrator_zh": ""
        },
        {
            "location": "331/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "え！？\nえ、えっと、それは……",
            "zh": "诶！？\n那、那个，这件事……",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "333/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "だ、ダメよ……\nそれはまだ、心の準備が。",
            "zh": "不、不行啦……\n那个我还、还没做好心理准备。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "338/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "――って！\nそんなこと話してる\n場合じゃなかったわ！",
            "zh": "——不对！\n现在可不是\n闲聊这种事的时候！",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "339/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "前回リヴォルカが、\nマークスマンは進化の\n準備に入ったって…。",
            "zh": "上次莉沃尔卡不是说，\n神射手已经进入\n进化的准备阶段了吗……。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "340/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "あの後、\nその言葉の意味を\n色々考えてみたのよ。",
            "zh": "那之后，\n我试着反复琢磨了\n那句话的意思。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "341/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "そしたら１つ、\nかなり不安な可能性が\n浮かび上がってきて……。",
            "zh": "结果想到了一个，\n非常令人不安的\n可能性……。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "342/SEL",
            "narrator": "",
            "text": "どんなこと？",
            "zh": "什么可能性？",
            "narrator_zh": ""
        },
        {
            "location": "343/ACT",
            "narrator": "",
            "text": "どんなこと？",
            "zh": "什么可能性？",
            "narrator_zh": ""
        },
        {
            "location": "345/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "人格の進化っていうのは、\nあまり使わない\n言葉なんだけど――",
            "zh": "人格的进化这个说法，\n平时其实不太会用，\n不过——",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "346/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "人が困難を乗り越えて成長\nするときや、逆にトラウマ\nを作ってしまうとき。",
            "zh": "人在跨越困难获得成长\n的时候，或者反过来\n留下心理创伤的时候。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "347/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "そういう時には、必ず\n人格に変化が発生する。",
            "zh": "在这种时候，人格\n必定会发生某种变化。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "348/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "「人格の変化」なんて\n言い方、すごく生易しい\nけど、率直に言うと…",
            "zh": "说成“人格的变化”\n未免太轻描淡写了，\n坦白讲就是……",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "349/SEL",
            "narrator": "",
            "text": "クランの発症？",
            "zh": "库兰的发病？",
            "narrator_zh": ""
        },
        {
            "location": "350/ACT",
            "narrator": "",
            "text": "クランの発症？",
            "zh": "库兰的发病？",
            "narrator_zh": ""
        },
        {
            "location": "352/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "……そう。",
            "zh": "……没错。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "353/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "人格は、何かを乗り越え\nようとするときや、衝撃を\n受けた時、クラン化する。",
            "zh": "人格在试图跨越什么、\n或者受到强烈冲击的时候，\n就会库兰化。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "354/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "それは、自分の持つ力を\n１２０％発揮して、その\n事象に対抗する為。",
            "zh": "那是为了将自身拥有的力量\n发挥到１２０％，\n去对抗那件事态。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "355/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "そしてそれを達成した\nクランは、ほとぼりが\n冷めると元の人格に戻る。",
            "zh": "然后达成目标后的库兰，\n等风波平息下来，\n就会变回原本的人格。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "356/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "だから、リヴォルカの\n言っていた「進化」の\n心当たりとしては――",
            "zh": "所以，莉沃尔卡\n所说的“进化”，\n我能想到的可能就是——",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "357/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "マークスマンの発症を\n意味している可能性が\n高いの。",
            "zh": "很有可能是指\n神射手的发病\n呢。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "358/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "けど、セルフクランは\nほとんど発症することは\nないのよ。",
            "zh": "但是，自身库兰\n几乎是不可能\n发病的哦。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "359/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "そして、\nセルフクランの発症は、\n相当なリスクを伴うわ。",
            "zh": "而且，\n自身库兰的发病，\n伴随着相当大的风险。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "360/SEL",
            "narrator": "",
            "text": "フェノメノンを生み出してしまうから？",
            "zh": "因为会产生PhenoMENON吗？",
            "narrator_zh": ""
        },
        {
            "location": "361/ACT",
            "narrator": "",
            "text": "フェノメノンを生み出してしまうから？",
            "zh": "因为会产生PhenoMENON吗？",
            "narrator_zh": ""
        },
        {
            "location": "363/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "うーん、\n確かにそれも\nそうなんだけど。",
            "zh": "嗯——，\n确实那也是原因之一，\n不过。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "364/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "それは、外的な力によって\n無理矢理作られている\nものだから例外として。",
            "zh": "那个毕竟是靠外力\n强行制造出来的东西，\n姑且算作例外。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "365/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "セルフクランの発症は、\n全人格否定、もしくは\n悟りを開くレベルの事。",
            "zh": "自身库兰的发病，\n是全人格否定，\n或者达到大彻大悟级别的程度。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "366/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "そんなことが起こったら、\nあたしはあたしじゃ\nなくなっちゃうのよ。",
            "zh": "要是发生那种事，\n我就再也不是\n我自己了哦。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "367/SEL",
            "narrator": "",
            "text": "ヤバイね",
            "zh": "那很糟啊",
            "narrator_zh": ""
        },
        {
            "location": "368/SEL",
            "narrator": "",
            "text": "リヴォルカはそれを狙ってるってこと？",
            "zh": "也就是说莉沃尔卡瞄准的就是这个？",
            "narrator_zh": ""
        },
        {
            "location": "369/ACT",
            "narrator": "",
            "text": "ヤバイね",
            "zh": "那很糟啊",
            "narrator_zh": ""
        },
        {
            "location": "370/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "この仮説が\n当たってたらの話よ？",
            "zh": "前提是这个假说\n成立的话哦？",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "371/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "できればハズレていて\n欲しいけど……。",
            "zh": "真希望只是我\n猜错了……。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "372/ACT",
            "narrator": "",
            "text": "リヴォルカはそれを狙ってるってこと？",
            "zh": "也就是说莉沃尔卡瞄准的就是这个？",
            "narrator_zh": ""
        },
        {
            "location": "373/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "わからないわ。",
            "zh": "我也不知道。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "374/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "でも、この前の\n話しぶりだと、肯定的な\n感じはしたわね。",
            "zh": "不过，从她上次\n说话的口吻来看，\n感觉上是持肯定态度的呢。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "375/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "まあそもそも、\n進化＝発症を意味するかは\nわからないんだけど……。",
            "zh": "虽说首先，\n进化是否等于发病\n也还不确定就是了……。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "377/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "けど、１つ言えることは、\nもうノンビリしてる時間は\n本当に無いってこと。",
            "zh": "但有一点可以肯定，\n我们已经真的没有\n悠闲度日的时间了。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "378/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "すぐにでも殴り込みを\nかけに行かなくちゃ！！",
            "zh": "必须马上就杀过去\n打她们个措手不及才行！！",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "379/SEL",
            "narrator": "",
            "text": "よし、行こう！",
            "zh": "好，出发吧！",
            "narrator_zh": ""
        },
        {
            "location": "380/SEL",
            "narrator": "",
            "text": "待て待て、返り討ちに遭ったら余計ヤバイから！",
            "zh": "等等等等，要是被反杀的话只会更糟吧！",
            "narrator_zh": ""
        },
        {
            "location": "381/ACT",
            "narrator": "",
            "text": "よし、行こう！",
            "zh": "好，出发吧！",
            "narrator_zh": ""
        },
        {
            "location": "382/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "ええ、そうね！",
            "zh": "嗯，说得对！",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "383/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "でも、そのまま行っても\n良い結果を生まないような\n気もするわね……。",
            "zh": "不过，就这样直接去的话，\n感觉也讨不到\n什么好果子吃呢……。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "384/ACT",
            "narrator": "",
            "text": "待て待て、返り討ちに遭ったら余計ヤバイから！",
            "zh": "等等等等，要是被反杀的话只会更糟吧！",
            "narrator_zh": ""
        },
        {
            "location": "385/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "あーもう！\nそれじゃ、\nどうすればいいのよ！",
            "zh": "啊—真是的！\n那你说，\n该怎么办才好嘛！",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "387/SEL",
            "narrator": "",
            "text": "作戦を考えよう",
            "zh": "想想作战计划吧",
            "narrator_zh": ""
        },
        {
            "location": "388/ACT",
            "narrator": "",
            "text": "作戦を考えよう",
            "zh": "想想作战计划吧",
            "narrator_zh": ""
        },
        {
            "location": "390/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "そ、そうね。\n何かいい作戦を……",
            "zh": "说、说得也是。\n得想个好主意……",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "391/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "…うーん……。",
            "zh": "……唔嗯……。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "392/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "$handle$は、\n何か妙案あるかしら。",
            "zh": "$handle$，\n你有什么妙计吗。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "393/SEL",
            "narrator": "",
            "text": "囮作戦",
            "zh": "诱饵作战",
            "narrator_zh": ""
        },
        {
            "location": "394/SEL",
            "narrator": "",
            "text": "ブヒブヒ作戦",
            "zh": "噗咿噗咿作战",
            "narrator_zh": ""
        },
        {
            "location": "395/ACT",
            "narrator": "",
            "text": "囮作戦",
            "zh": "诱饵作战",
            "narrator_zh": ""
        },
        {
            "location": "396/TALK",
            "narrator": "ガブリエラの元司書",
