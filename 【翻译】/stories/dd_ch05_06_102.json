{
    "dir": "chap06/daydra/dd_ch05_06_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "6505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "戦略的サボタージュ＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "战略怠工＜后篇＞"
    },
    "entry": [
        {
            "location": "2770/SEL",
            "narrator": "",
            "text": "まだ不安？",
            "zh": "还不安？",
            "narrator_zh": ""
        },
        {
            "location": "2771/ACT",
            "narrator": "",
            "text": "まだ不安？",
            "zh": "还不安？",
            "narrator_zh": ""
        },
        {
            "location": "2773/TALK",
            "narrator": "神楽",
            "text": "まだ？",
            "zh": "还？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2774/TALK",
            "narrator": "神楽",
            "text": "今不安って話をしてるのに",
            "zh": "现在正说着不安",
            "narrator_zh": "神乐"
        },
        {
            "location": "2775/TALK",
            "narrator": "神楽",
            "text": "変わらず不安でいっぱいですよ",
            "zh": "不安还是满满的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2778/TALK",
            "narrator": "神楽",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "神乐"
        },
        {
            "location": "2780/TALK",
            "narrator": "神楽",
            "text": "やります",
            "zh": "我会做",
            "narrator_zh": "神乐"
        },
        {
            "location": "2781/TALK",
            "narrator": "神楽",
            "text": "それが私に与えられた任務で",
            "zh": "那是交给我的任务",
            "narrator_zh": "神乐"
        },
        {
            "location": "2782/TALK",
            "narrator": "神楽",
            "text": "私自身のためにも",
            "zh": "也是为了我自己",
            "narrator_zh": "神乐"
        },
        {
            "location": "2783/TALK",
            "narrator": "神楽",
            "text": "やらなければならないこと",
            "zh": "必须做的事",
            "narrator_zh": "神乐"
        },
        {
            "location": "2784/TALK",
            "narrator": "神楽",
            "text": "なのです",
            "zh": "就是这样",
            "narrator_zh": "神乐"
        },
        {
            "location": "2785/TALK",
            "narrator": "神楽",
            "text": "それに先延ばしにしたところで",
            "zh": "而且就算拖下去",
            "narrator_zh": "神乐"
        },
        {
            "location": "2786/TALK",
            "narrator": "神楽",
            "text": "今日中に会うのは避けられません",
            "zh": "今天之内见面也躲不掉",
            "narrator_zh": "神乐"
        },
        {
            "location": "2787/TALK",
            "narrator": "神楽",
            "text": "ならば少しでも早く会って",
            "zh": "那就尽早见面",
            "narrator_zh": "神乐"
        },
        {
            "location": "2788/TALK",
            "narrator": "神楽",
            "text": "逢瀬つばめに慣れた方がいい",
            "zh": "习惯逢濑燕比较好",
            "narrator_zh": "神乐"
        },
        {
            "location": "2789/TALK",
            "narrator": "神楽",
            "text": "そう判断したわけで",
            "zh": "我是这么判断的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2791/SEL",
            "narrator": "",
            "text": "神楽は強いね",
            "zh": "神乐很强呢",
            "narrator_zh": ""
        },
        {
            "location": "2792/SEL",
            "narrator": "",
            "text": "警戒しすぎだよ",
            "zh": "你太警戒了",
            "narrator_zh": ""
        },
        {
            "location": "2793/SEL",
            "narrator": "",
            "text": "つばめはいい子だよ",
            "zh": "燕是个好孩子",
            "narrator_zh": ""
        },
        {
            "location": "2794/ACT",
            "narrator": "",
            "text": "神楽は強いね",
            "zh": "神乐很强呢",
            "narrator_zh": ""
        },
        {
            "location": "2795/TALK",
            "narrator": "神楽",
            "text": "そう見えます？",
            "zh": "看起来是这样吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2797/TALK",
            "narrator": "神楽",
            "text": "でもまだまだです",
            "zh": "可是还差得远",
            "narrator_zh": "神乐"
        },
        {
            "location": "2798/TALK",
            "narrator": "神楽",
            "text": "本当に強いなら",
            "zh": "要是真的强",
            "narrator_zh": "神乐"
        },
        {
            "location": "2799/TALK",
            "narrator": "神楽",
            "text": "こんなウジウジしなかったし",
            "zh": "就不会这么磨蹭了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2800/ACT",
            "narrator": "",
            "text": "警戒しすぎだよ",
            "zh": "你太警戒了",
            "narrator_zh": ""
        },
        {
            "location": "2801/TALK",
            "narrator": "神楽",
            "text": "油断して失敗する",
            "zh": "大意了然后失败",
            "narrator_zh": "神乐"
        },
        {
            "location": "2802/TALK",
            "narrator": "神楽",
            "text": "なんてことになるよりはマシ",
            "zh": "总比变成那样强",
            "narrator_zh": "神乐"
        },
        {
            "location": "2803/TALK",
            "narrator": "神楽",
            "text": "そう思ってるだけですよ",
            "zh": "我只是这么想",
            "narrator_zh": "神乐"
        },
        {
            "location": "2804/ACT",
            "narrator": "",
            "text": "つばめはいい子だよ",
            "zh": "燕是个好孩子",
            "narrator_zh": ""
        },
        {
            "location": "2805/TALK",
            "narrator": "神楽",
            "text": "はい？",
            "zh": "什么？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2806/TALK",
            "narrator": "神楽",
            "text": "いやこの流れで突然なにを言い出すのかと思えば",
            "zh": "不是，这个话题突然说出什么来了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2808/TALK",
            "narrator": "神楽",
            "text": "ドームでの彼女のことを見ればわかると思うけど？",
            "zh": "看过穹顶里的她就明白了吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2810/SEL",
            "narrator": "",
            "text": "神楽を助けようとしてた",
            "zh": "她是想帮神乐",
            "narrator_zh": ""
        },
        {
            "location": "2811/SEL",
            "narrator": "",
            "text": "正当防衛だと思うけど？",
            "zh": "我觉得是正当防卫？",
            "narrator_zh": ""
        },
        {
            "location": "2812/ACT",
            "narrator": "",
            "text": "神楽を助けようとしてた",
            "zh": "她是想帮神乐",
            "narrator_zh": ""
        },
        {
            "location": "2814/TALK",
            "narrator": "神楽",
            "text": "それは",
            "zh": "那是",
            "narrator_zh": "神乐"
        },
        {
            "location": "2815/TALK",
            "narrator": "神楽",
            "text": "多分メノウだからであって",
            "zh": "大概因为是MENOW",
            "narrator_zh": "神乐"
        },
        {
            "location": "2816/TALK",
            "narrator": "神楽",
            "text": "自分が好きなアーティストだから",
            "zh": "因为是自己喜欢的艺人",
            "narrator_zh": "神乐"
        },
        {
            "location": "2817/ACT",
            "narrator": "",
            "text": "正当防衛だと思うけど？",
            "zh": "我觉得是正当防卫？",
            "narrator_zh": ""
        },
        {
            "location": "2819/TALK",
            "narrator": "神楽",
            "text": "だとしたら",
            "zh": "要是那样",
            "narrator_zh": "神乐"
        },
        {
            "location": "2820/TALK",
            "narrator": "神楽",
            "text": "彼女の冷徹さは恐るべきモノですよ",
            "zh": "她的冷彻就可怕了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2821/TALK",
            "narrator": "神楽",
            "text": "あんなすぐに終わらせられる力を持っていながら",
            "zh": "明明拥有能那么快结束的力量",
            "narrator_zh": "神乐"
        },
        {
            "location": "2822/TALK",
            "narrator": "神楽",
            "text": "あれだけ状況を長引かせたのだから",
            "zh": "却把状况拖了那么久",
            "narrator_zh": "神乐"
        },
        {
            "location": "2825/TALK",
            "narrator": "神楽",
            "text": "本当",
            "zh": "真的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2826/TALK",
            "narrator": "神楽",
            "text": "遊んでいたのかもしれませんね",
            "zh": "也许是在玩吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "2828/SEL",
            "narrator": "",
            "text": "違っても、神楽はつばめを壊せる？",
            "zh": "就算不是，神乐也能毁掉燕？",
            "narrator_zh": ""
        },
        {
            "location": "2829/ACT",
            "narrator": "",
            "text": "違っても、神楽はつばめを壊せる？",
            "zh": "就算不是，神乐也能毁掉燕？",
            "narrator_zh": ""
        },
        {
            "location": "2832/TALK",
            "narrator": "神楽",
            "text": "やめて",
            "zh": "别说了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2833/TALK",
            "narrator": "神楽",
            "text": "やっと不安を押さえ込んだのに",
            "zh": "好不容易把不安压下去了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2836/TALK",
            "narrator": "神楽",
            "text": "考えさせないで",
            "zh": "别让我想",
            "narrator_zh": "神乐"
        },
        {
            "location": "2837/TALK",
            "narrator": "神楽",
            "text": "そんな",
            "zh": "那种",
            "narrator_zh": "神乐"
        },
        {
            "location": "2838/TALK",
            "narrator": "神楽",
            "text": "絶対にあってほしくないことを",
            "zh": "绝对不希望发生的事",
            "narrator_zh": "神乐"
        },
        {
            "location": "2849/TALK",
            "narrator": "神楽",
            "text": "…逢瀬つばめが、\n私の思っているような\n子じゃないなんて――",
            "zh": "……逢濑燕要是\n不是我以为的\n那种孩子——",
            "narrator_zh": "神乐"
        },
        {
            "location": "2852/TALK",
            "narrator": "神楽",
            "text": "ダメ、そんな余計なことを\n今考えたら…。",
            "zh": "不行，现在要是想\n这种多余的事……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2853/TALK",
            "narrator": "神楽",
            "text": "事実がどうあれ、\nやらないわけには\nいかないんだから…。",
            "zh": "不管事实如何，\n不能不做\n啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2856/TALK",
            "narrator": "神楽",
            "text": "とはいえ問題はまだあって",
            "zh": "话虽如此问题还在",
            "narrator_zh": "神乐"
        },
        {
            "location": "2857/TALK",
            "narrator": "神楽",
            "text": "どうやって近づくべきか？",
            "zh": "该怎么接近？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2858/TALK",
            "narrator": "神楽",
            "text": "やはり時間をかけて",
            "zh": "果然还是花时间",
            "narrator_zh": "神乐"
        },
        {
            "location": "2859/TALK",
            "narrator": "神楽",
            "text": "一歩ずつ近づいていくべき？",
            "zh": "一步一步接近？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2860/TALK",
            "narrator": "神楽",
            "text": "それとも",
            "zh": "还是说",
            "narrator_zh": "神乐"
        },
        {
            "location": "2861/TALK",
            "narrator": "神楽",
            "text": "いきなり超フレンドリーモードとか？",
            "zh": "突然超级友善模式之类？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2862/SEL",
            "narrator": "",
            "text": "普通で大丈夫だよ",
            "zh": "普通就行哦",
            "narrator_zh": ""
        },
        {
            "location": "2863/ACT",
            "narrator": "",
            "text": "普通で大丈夫だよ",
            "zh": "普通就行哦",
            "narrator_zh": ""
        },
        {
            "location": "2865/TALK",
            "narrator": "神楽",
            "text": "普通って",
            "zh": "普通是",
            "narrator_zh": "神乐"
        },
        {
            "location": "2868/TALK",
            "narrator": "神楽",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "神乐"
        },
        {
            "location": "2869/TALK",
            "narrator": "神楽",
            "text": "参考にさせていただきます",
            "zh": "我会拿来参考",
            "narrator_zh": "神乐"
        },
        {
            "location": "2870/TALK",
            "narrator": "神楽",
            "text": "それじゃあそろそろ",
            "zh": "那就差不多",
            "narrator_zh": "神乐"
        },
        {
            "location": "2871/TALK",
            "narrator": "神楽",
            "text": "迎えが来るんで",
            "zh": "接应要来了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2872/TALK",
            "narrator": "神楽",
            "text": "一度落ちますね",
            "zh": "我先下了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2883/TALK",
            "narrator": "神楽",
            "text": "…まったく。",
            "zh": "……真是的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2885/TALK",
            "narrator": "神楽",
            "text": "普通ってなによ？\n説明下手にもほどがある、\nってものよ。",
            "zh": "普通是什么？\n说明也太差了，\n简直了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2886/TALK",
            "narrator": "神楽",
            "text": "まさか、他人事だと\n思われてる…とか？",
            "zh": "该不会，被当成\n别人的事了……之类？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2887/TALK",
            "narrator": "神楽",
            "text": "…まあ、私以外には\n関係ない話よね。",
            "zh": "……嘛，除了我\n也没关系吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2889/TALK",
            "narrator": "神楽",
            "text": "ふぅ…気持ち、切り替えて\nいかなきゃ…。",
            "zh": "呼……心情，得切换\n过去……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2890/TALK",
            "narrator": "神楽",
            "text": "私の目的――",
            "zh": "我的目的——",
            "narrator_zh": "神乐"
        },
        {
            "location": "2891/TALK",
            "narrator": "神楽",
            "text": "逢瀬つばめの、\n心を、破壊するまでは…。",
            "zh": "直到毁掉\n逢濑燕的心……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2901/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【04 レッドサイト】",
            "zh": "【04 赤红视线】",
            "narrator_zh": "Dialog_chapter_ch05"
        },
        {
            "location": "2912/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【04 レッドサイト】",
            "zh": "【04 赤红视线】",
            "narrator_zh": "Dialog_chapter_ch05"
        }
    ]
}
