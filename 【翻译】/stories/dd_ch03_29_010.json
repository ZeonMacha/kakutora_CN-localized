{
    "dir": "chap29/daydra/dd_ch03_29_010.js",
    "type": "",
    "info": {
        "story_id": "50014",
        "cid": "",
        "title": "SideStory014 ストーリー",
        "sub_title": "FILE11.決行",
        "title_zh": "SideStory014 剧情",
        "sub_title_zh": "FILE11.决行"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "東京編１１話",
            "zh": "东京篇 第11话",
            "narrator_zh": ""
        },
        {
            "location": "17/DIALOG",
            "narrator": "",
            "text": "<color=green>9月6日　 6:38 PM</color>\nカラオケボックスでの相談後、神楽坂トライナリー前にて",
            "zh": "<color=green>9月6日　 6:38 PM</color>\n在KTV包厢商量之后，于神乐坂三重奏剧场前",
            "narrator_zh": ""
        },
        {
            "location": "18/TALK",
            "narrator": "ヒカル",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "光"
        },
        {
            "location": "19/TALK",
            "narrator": "ヒカル",
            "text": "なるほど…、大体だけど\nわかってきたかも…。",
            "zh": "原来如此……大概情况\n我好像摸清楚了……。",
            "narrator_zh": "光"
        },
        {
            "location": "20/TALK",
            "narrator": "雛",
            "text": "ヒカルくん。",
            "zh": "光。",
            "narrator_zh": "雏"
        },
        {
            "location": "23/TALK",
            "narrator": "雛",
            "text": "お疲れさま。\n差し入れ持ってきたよ。",
            "zh": "辛苦了。\n我带了慰问品过来哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "25/TALK",
            "narrator": "ヒカル",
            "text": "ありがとう。\n喉乾いてたから助かるよ。",
            "zh": "谢谢。\n正好口渴了，帮大忙了。",
            "narrator_zh": "光"
        },
        {
            "location": "26/TALK",
            "narrator": "雛",
            "text": "…それで、どう？",
            "zh": "……怎么样，情况如何？",
            "narrator_zh": "雏"
        },
        {
            "location": "27/TALK",
            "narrator": "ヒカル",
            "text": "うん…劇場の警備は、\n予想以上の人数が\n動員されてたよ。",
            "zh": "嗯……剧场的警备，\n动员的人数\n比预想的还要多啊。",
            "narrator_zh": "光"
        },
        {
            "location": "28/TALK",
            "narrator": "雛",
            "text": "じゃあ、侵入するのは\n無理ってこと？",
            "zh": "那也就是说，\n没办法潜入进去了？",
            "narrator_zh": "雏"
        },
        {
            "location": "29/TALK",
            "narrator": "ヒカル",
            "text": "いや…ちょっと作戦は\n考えてあるけど…。",
            "zh": "不……我倒是\n想到了一点作战计划……。",
            "narrator_zh": "光"
        },
        {
            "location": "30/TALK",
            "narrator": "ヒカル",
            "text": "教えるのは、もう少し\n考えてからにするよ。",
            "zh": "不过具体内容，\n等我再多考虑一下再告诉你。",
            "narrator_zh": "光"
        },
        {
            "location": "31/TALK",
            "narrator": "ヒカル",
            "text": "できる限り安全な方法で\n侵入したいし。",
            "zh": "毕竟我也想用\n尽可能安全的方法潜入进去。",
            "narrator_zh": "光"
        },
        {
            "location": "32/TALK",
            "narrator": "雛",
            "text": "わかった。\n期待してるよー。",
            "zh": "好。\n我很期待哦—。",
            "narrator_zh": "雏"
        },
        {
            "location": "33/TALK",
            "narrator": "雛",
            "text": "…でも、本当にあの時、\nあたし一人だったら\nヤバかったんだねー？",
            "zh": "……不过，当时如果\n只有我一个人的话，\n真的会很糟吧—？",
            "narrator_zh": "雏"
        },
        {
            "location": "34/TALK",
            "narrator": "雛",
            "text": "ありがと、ヒカルくん。\nあたしを止めてくれて…。",
            "zh": "谢谢你，光。\n当时拦住了我……。",
            "narrator_zh": "雏"
        },
        {
            "location": "35/TALK",
            "narrator": "雛",
            "text": "もしヒカルくんが、\nあの時あたしのことを\n止めてくれなかったら…。",
            "zh": "如果光你在那个时候\n没有拦住我\n的话……。",
            "narrator_zh": "雏"
        },
        {
            "location": "36/TALK",
            "narrator": "雛",
            "text": "今更だけど、考えると\n少し怖くなってくるよー。",
            "zh": "虽然现在才后怕，但想想\n还是觉得有点可怕呢—。",
            "narrator_zh": "雏"
        },
        {
            "location": "37/TALK",
            "narrator": "ヒカル",
            "text": "いえ、そんな…。\n友達として当然のことを\nしたまでだから…。",
            "zh": "不，没什么……。\n作为朋友，这只是\n理所应当的事而已……。",
            "narrator_zh": "光"
        },
        {
            "location": "38/TALK",
            "narrator": "雛",
            "text": "それだけじゃないの。",
            "zh": "不止是这样。",
            "narrator_zh": "雏"
        },
        {
            "location": "40/TALK",
            "narrator": "雛",
            "text": "あたし、ヒカルくんには\n謝らなきゃいけないこと\nあるから…。",
            "zh": "其实我还有件事，\n必须向光你\n道歉才行……。",
            "narrator_zh": "雏"
        },
        {
            "location": "41/TALK",
            "narrator": "ヒカル",
            "text": "…謝ること？",
            "zh": "……道歉的事？",
            "narrator_zh": "光"
        },
        {
            "location": "43/TALK",
            "narrator": "雛",
            "text": "…ヒカルくんに、\n無理に手伝わせちゃった\nこと…。",
            "zh": "……硬是拉着光你\n来帮忙\n这件事……。",
            "narrator_zh": "雏"
        },
        {
            "location": "44/TALK",
            "narrator": "雛",
            "text": "ヒカルくんも、本当は\nつばめちゃんを助けたい、\nって言ってたけど…。",
            "zh": "虽然光你也说过，\n心里其实很想\n救燕……。",
            "narrator_zh": "雏"
        },
        {
            "location": "45/TALK",
            "narrator": "雛",
            "text": "最初は断ってたよね？",
            "zh": "但一开始你是拒绝了的吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "46/TALK",
            "narrator": "ヒカル",
            "text": "ええ、まあ…はい…。",
            "zh": "嗯、那个……是的……。",
            "narrator_zh": "光"
        },
        {
            "location": "47/TALK",
            "narrator": "雛",
            "text": "その考えが変わったの、\nあたしのせいだよね。",
            "zh": "你会改变主意，\n都是因为我吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "49/TALK",
            "narrator": "雛",
            "text": "あたしが、一人だけで\n動くなんて言ったから…。",
            "zh": "因为我说什么哪怕只有一个人\n也要行动……。",
            "narrator_zh": "雏"
        },
        {
            "location": "50/TALK",
            "narrator": "雛",
            "text": "ヒカルくんに、手伝う\nって言わせちゃって…。\n本当、ごめんなさい…。",
            "zh": "结果害得光你\n不得不说要来帮忙……。\n真的，对不起……。",
            "narrator_zh": "雏"
        },
        {
            "location": "51/TALK",
            "narrator": "ヒカル",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "光"
        },
        {
            "location": "52/TALK",
            "narrator": "ヒカル",
            "text": "お礼を言われるのは\n嬉しいんだけど…。",
            "zh": "被你道谢我是\n挺开心的……。",
            "narrator_zh": "光"
        },
        {
            "location": "53/TALK",
            "narrator": "ヒカル",
            "text": "謝られるのは、\nちょっと複雑かも…。",
            "zh": "不过被你道歉，\n心情就有点复杂了……。",
            "narrator_zh": "光"
        },
        {
            "location": "55/TALK",
            "narrator": "雛",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "雏"
        },
        {
            "location": "56/TALK",
            "narrator": "ヒカル",
            "text": "…確かに、協力することに\nなったきっかけは、\nひなこさんだよ。",
            "zh": "……确实，让我决定\n帮忙的契机，\n是雏子你没错。",
            "narrator_zh": "光"
        },
        {
            "location": "57/TALK",
            "narrator": "ヒカル",
            "text": "けど、おかげで僕は、\n自分の気持ちに正直に\n行動することができた。",
            "zh": "但多亏了你，我才能\n顺从自己真实的心情\n采取行动。",
            "narrator_zh": "光"
        },
        {
            "location": "58/TALK",
            "narrator": "ヒカル",
            "text": "そのことを、僕は本当に\n嬉しく思ってるんだ。",
            "zh": "关于这一点，我打心底里\n感到很开心。",
            "narrator_zh": "光"
        },
        {
            "location": "59/TALK",
            "narrator": "ヒカル",
            "text": "それに、僕はひなこさんを\n本気で止めようとは、\n思ってなかったし…。",
            "zh": "而且，我也并不是\n真的打算强行\n阻止雏子你……。",
            "narrator_zh": "光"
        },
        {
            "location": "60/TALK",
            "narrator": "雛",
            "text": "…そうだったの？",
            "zh": "……是这样吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "61/TALK",
            "narrator": "ヒカル",
            "text": "ひなこさんだったら、\n絶対に一人でもやると\n思ってたんだ。",
            "zh": "我觉得如果是雏子你的话，\n就算只有一个人\n也绝对会去做的。",
            "narrator_zh": "光"
        },
        {
            "location": "62/TALK",
            "narrator": "ヒカル",
            "text": "そしたら、予想的中。",
            "zh": "结果，还真被我猜中了。",
            "narrator_zh": "光"
        },
        {
            "location": "63/TALK",
            "narrator": "ヒカル",
            "text": "そんなひなこさんを見て、\n本当に羨ましくなって…。",
            "zh": "看着那样的雏子你，\n我真的觉得好羡慕……。",
            "narrator_zh": "光"
        },
        {
            "location": "64/TALK",
            "narrator": "ヒカル",
            "text": "ひなこさんの\n手助けをしたい、\nって思ったから…。",
            "zh": "因为心里想着\n想要助雏子你\n一臂之力……。",
            "narrator_zh": "光"
        },
        {
            "location": "65/TALK",
            "narrator": "ヒカル",
            "text": "僕はこうして、\n自分の気持ちに正直に\n動けるようになったんだ。",
            "zh": "我才能够像这样，\n坦诚地顺从自己的心意\n行动起来。",
            "narrator_zh": "光"
        },
        {
            "location": "66/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "67/TALK",
            "narrator": "ヒカル",
            "text": "仕方なくとか、嫌々とか、\n自分にウソをついて、\n協力してるんじゃないよ。",
            "zh": "我并不是迫不得已、\n也不是勉为其难地欺骗自己\n才来帮忙的。",
            "narrator_zh": "光"
        },
        {
            "location": "68/TALK",
            "narrator": "ヒカル",
            "text": "本当に、こうすることが\n僕にとっても一番だ、って\n思えたから…。",
            "zh": "我是真的觉得，\n这样做对我自己而言\n也是最好的选择……。",
            "narrator_zh": "光"
        },
        {
            "location": "69/TALK",
            "narrator": "ヒカル",
            "text": "ひなこさんに、\n協力しようと思った。\nそれだけだよ。",
            "zh": "所以才决定\n助雏子你一臂之力。\n仅此而已。",
            "narrator_zh": "光"
        },
        {
            "location": "70/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "71/TALK",
            "narrator": "雛",
            "text": "ヒカルくんって、\nそういうことを\n自然に言えて…。",
            "zh": "光你啊，\n能把这种话\n说得这么自然……。",
            "narrator_zh": "雏"
        },
        {
            "location": "72/TALK",
            "narrator": "雛",
            "text": "大人っていうか、\n紳士的っていうか…、\nスゴイ人だよねー。",
            "zh": "该说成熟呢，\n还是说很有绅士风度呢……\n真是个厉害的人呀—。",
            "narrator_zh": "雏"
        },
        {
            "location": "73/TALK",
            "narrator": "ヒカル",
            "text": "…そっか。\nじゃあ、もう一つの理由は\n言わなくて正解だったよ。",
            "zh": "……这样啊。\n看来另一个理由\n没说出口是对的。",
            "narrator_zh": "光"
        },
        {
            "location": "74/TALK",
            "narrator": "雛",
            "text": "他にも何かあったの？",
            "zh": "还有别的理由吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "75/TALK",
            "narrator": "ヒカル",
            "text": "…みんなが断ったのに、\n僕だけが手伝うって\n言ったら…。",
            "zh": "……大家都拒绝了，\n只有我一个人\n站出来说要帮忙的话……。",
            "narrator_zh": "光"
        },
        {
            "location": "76/TALK",
            "narrator": "ヒカル",
            "text": "ちょっと、かっこいいとこ\n見せられるかなぁ…、\nとか、思ったり…。",
            "zh": "或许还能稍微\n展现出帅气的一面呢……\n之类的想法……。",
            "narrator_zh": "光"
        },
        {
            "location": "77/TALK",
            "narrator": "雛",
            "text": "えぇっ！？\nヒカルくんでも\nそんなこと思うの！？",
            "zh": "诶诶！？\n连光你也会\n想这种事吗！？",
            "narrator_zh": "雏"
        },
        {
            "location": "78/TALK",
            "narrator": "ヒカル",
            "text": "あ、ありますよ。\nっていうか、\n普通に考えてますよ？",
            "zh": "会、会有的啦。\n倒不如说，\n平时就会这么想吧？",
            "narrator_zh": "光"
        },
        {
            "location": "79/TALK",
            "narrator": "雛",
            "text": "へぇー、そうなんだー。",
            "zh": "嘿—，原来如此呀—。",
            "narrator_zh": "雏"
        },
        {
            "location": "80/TALK",
            "narrator": "雛",
            "text": "ヒカルくんでも、\nかっこつけたくなったり\nするんだねー。",
            "zh": "就算是光，\n也会有想耍帅的时候\n呢—。",
            "narrator_zh": "雏"
        },
        {
            "location": "82/TALK",
            "narrator": "ヒカル",
            "text": "…うん、まあね。",
            "zh": "……嗯，算是吧。",
            "narrator_zh": "光"
        },
        {
            "location": "83/TALK",
            "narrator": "ヒカル",
            "text": "…ある人の前でだけはね。",
            "zh": "……不过也只限在某个人的面前就是了。",
            "narrator_zh": "光"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "…多分、ひなこよね？",
            "zh": "……多半是雏子吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱり。",
            "zh": "……果然。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤのところに\n長文送ってきたって\n言ってたから…。",
            "zh": "因为听说她给绫水那边\n发了一大段长消息\n过来……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "なにか来るとは\n思ってたけど…。",
            "zh": "我就在想她肯定\n也会发点什么来……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "雛",
            "text": "こちら東京のひなこ",
            "zh": "这里是东京的雏子",
            "narrator_zh": "雏"
        },
        {
            "location": "110/TALK",
            "narrator": "雛",
            "text": "あたしとヒカルくんは今",
            "zh": "我和光现在",
            "narrator_zh": "雏"
        },
        {
            "location": "112/TALK",
            "narrator": "雛",
            "text": "劇場の近くにいまーす！",
            "zh": "就在剧场附近哦—！",
            "narrator_zh": "雏"
        },
        {
            "location": "113/TALK",
            "narrator": "雛",
            "text": "劇場への侵入方法捜索なう！",
            "zh": "正在寻找潜入剧场的方法！",
            "narrator_zh": "雏"
        },
        {
            "location": "114/TALK",
            "narrator": "雛",
            "text": "警備すごいよー",
            "zh": "警备好严密呀—",
            "narrator_zh": "雏"
        },
        {
            "location": "115/TALK",
            "narrator": "雛",
            "text": "でも",
            "zh": "但是",
            "narrator_zh": "雏"
        },
        {
            "location": "116/TALK",
            "narrator": "雛",
            "text": "絶対中に入ってみせるよ",
            "zh": "我绝对会想办法进去的",
            "narrator_zh": "雏"
        },
        {
            "location": "117/TALK",
            "narrator": "雛",
            "text": "ターゲットは床下のＰＣなり！！",
            "zh": "目标是地板下的电脑哦！！",
            "narrator_zh": "雏"
        },
        {
            "location": "119/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん",
            "zh": "加布里埃拉",
            "narrator_zh": "雏"
        },
        {
            "location": "120/TALK",
            "narrator": "雛",
            "text": "そっちも大変な想いしてると思うけど",
            "zh": "我想你们那边也经历着很辛苦的事",
            "narrator_zh": "雏"
        },
        {
            "location": "121/TALK",
            "narrator": "雛",
            "text": "応援してるよ！",
            "zh": "但我会支持你们的！",
            "narrator_zh": "雏"
        },
        {
            "location": "122/TALK",
            "narrator": "雛",
            "text": "頑張ってね！",
            "zh": "加油哦！",
            "narrator_zh": "雏"
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "…信じられない。",
            "zh": "……真不敢相信。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "135/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に…ひなこ達も\n動いてくれてるんだ…。",
            "zh": "真的……连雏子她们\n也开始行动起来了啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめや、あたし達の\n手助けをするために…。",
