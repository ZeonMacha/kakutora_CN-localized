            "narrator_zh": ""
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "人が親切になるのは",
            "zh": "人变得热心",
            "narrator_zh": "雅"
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "どういう時だろうな",
            "zh": "是在什么时候呢",
            "narrator_zh": "雅"
        },
        {
            "location": "142/SEL",
            "narrator": "",
            "text": "幸せな時",
            "zh": "幸福的时候",
            "narrator_zh": ""
        },
        {
            "location": "143/SEL",
            "narrator": "",
            "text": "修業中",
            "zh": "修行中",
            "narrator_zh": ""
        },
        {
            "location": "144/SEL",
            "narrator": "",
            "text": "恋してる時",
            "zh": "恋爱的时候",
            "narrator_zh": ""
        },
        {
            "location": "145/ACT",
            "narrator": "",
            "text": "幸せな時",
            "zh": "幸福的时候",
            "narrator_zh": ""
        },
        {
            "location": "146/TALK",
            "narrator": "みやび",
            "text": "幸せか",
            "zh": "幸福啊",
            "narrator_zh": "雅"
        },
        {
            "location": "147/TALK",
            "narrator": "みやび",
            "text": "ふむ",
            "zh": "唔",
            "narrator_zh": "雅"
        },
        {
            "location": "148/ACT",
            "narrator": "",
            "text": "修業中",
            "zh": "修行中",
            "narrator_zh": ""
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "それも",
            "zh": "这倒也",
            "narrator_zh": "雅"
        },
        {
            "location": "150/TALK",
            "narrator": "みやび",
            "text": "一理ある",
            "zh": "有一番道理",
            "narrator_zh": "雅"
        },
        {
            "location": "151/ACT",
            "narrator": "",
            "text": "恋してる時",
            "zh": "恋爱的时候",
            "narrator_zh": ""
        },
        {
            "location": "152/TALK",
            "narrator": "みやび",
            "text": "恋とは",
            "zh": "所谓恋爱",
            "narrator_zh": "雅"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "どういうことだ？",
            "zh": "是怎么一回事？",
            "narrator_zh": "雅"
        },
        {
            "location": "155/TALK",
            "narrator": "みやび",
            "text": "まあなんだ",
            "zh": "是这样的",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "みやび",
            "text": "まほさんが妙にうちに親切だったちや",
            "zh": "真幌对我出奇地热情滴",
            "narrator_zh": "雅"
        },
        {
            "location": "157/TALK",
            "narrator": "みやび",
            "text": "なんでだと思う？",
            "zh": "你猜是为驷马？",
            "narrator_zh": "雅"
        },
        {
            "location": "160/SEL",
            "narrator": "",
            "text": "就職の話、聞かれてたよ",
            "zh": "她在问你就职的事哦",
            "narrator_zh": ""
        },
        {
            "location": "161/SEL",
            "narrator": "",
            "text": "何か仕事を任されるのかも",
            "zh": "说不定会有什么工作交给你",
            "narrator_zh": ""
        },
        {
            "location": "162/SEL",
            "narrator": "",
            "text": "アプローチされてるんだよ",
            "zh": "你这是被人追求了哦",
            "narrator_zh": ""
        },
        {
            "location": "163/ACT",
            "narrator": "",
            "text": "就職の話、聞かれてたよ",
            "zh": "她在问你就职的事哦",
            "narrator_zh": ""
        },
        {
            "location": "164/TALK",
            "narrator": "みやび",
            "text": "理解した",
            "zh": "了解",
            "narrator_zh": "雅"
        },
        {
            "location": "165/TALK",
            "narrator": "みやび",
            "text": "まあ今のところは",
            "zh": "嘛，眼下来说",
            "narrator_zh": "雅"
        },
        {
            "location": "166/TALK",
            "narrator": "みやび",
            "text": "やぶさかではない",
            "zh": "并不排斥",
            "narrator_zh": "雅"
        },
        {
            "location": "171/TALK",
            "narrator": "みやび",
            "text": "しかし",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "別の選択肢を取ることにした場合",
            "zh": "可要是选了别的选项",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "面倒そうじゃの",
            "zh": "怕是麻烦得很咧",
            "narrator_zh": "雅"
        },
        {
            "location": "176/ACT",
            "narrator": "",
            "text": "何か仕事を任されるのかも",
            "zh": "说不定会有什么工作交给你",
            "narrator_zh": ""
        },
        {
            "location": "177/TALK",
            "narrator": "みやび",
            "text": "大人の交渉術というやつか",
            "zh": "这就是所谓大人的交涉术吗",
            "narrator_zh": "雅"
        },
        {
            "location": "178/TALK",
            "narrator": "みやび",
            "text": "その策略には乗らん！",
            "zh": "我才不上这策略的当！",
            "narrator_zh": "雅"
        },
        {
            "location": "179/TALK",
            "narrator": "みやび",
            "text": "ということで",
            "zh": "所以呢",
            "narrator_zh": "雅"
        },
        {
            "location": "180/TALK",
            "narrator": "みやび",
            "text": "協力せよ、相棒",
            "zh": "给我协助，搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "181/TALK",
            "narrator": "みやび",
            "text": "シゴトはせぬ",
            "zh": "活儿是不干的",
            "narrator_zh": "雅"
        },
        {
            "location": "182/TALK",
            "narrator": "みやび",
            "text": "仕事はせぬぞ！",
            "zh": "工作是不做的啵！",
            "narrator_zh": "雅"
        },
        {
            "location": "183/ACT",
            "narrator": "",
            "text": "アプローチされてるんだよ",
            "zh": "你这是被人追求了哦",
            "narrator_zh": ""
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "ぬ",
            "zh": "唔？",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "何的アプローチぞね？",
            "zh": "是驷马式的追求咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "197/SEL",
            "narrator": "",
            "text": "恋",
            "zh": "恋爱",
            "narrator_zh": ""
        },
        {
            "location": "198/SEL",
            "narrator": "",
            "text": "ラブ",
            "zh": "Love",
            "narrator_zh": ""
        },
        {
            "location": "199/SEL",
            "narrator": "",
            "text": "百合",
            "zh": "百合",
            "narrator_zh": ""
        },
        {
            "location": "200/ACT",
            "narrator": "",
            "text": "恋",
            "zh": "恋爱",
            "narrator_zh": ""
        },
        {
            "location": "202/TALK",
            "narrator": "みやび",
            "text": "恋だとう？",
            "zh": "恋爱？你说的是这个？",
            "narrator_zh": "雅"
        },
        {
            "location": "203/ACT",
            "narrator": "",
            "text": "ラブ",
            "zh": "Love",
            "narrator_zh": ""
        },
        {
            "location": "205/TALK",
            "narrator": "みやび",
            "text": "ラブかよ！",
            "zh": "Love什么啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "206/ACT",
            "narrator": "",
            "text": "百合",
            "zh": "百合",
            "narrator_zh": ""
        },
        {
            "location": "207/TALK",
            "narrator": "みやび",
            "text": "隠語表現まで使うとは",
            "zh": "居然连隐语都使上了",
            "narrator_zh": "雅"
        },
        {
            "location": "209/TALK",
            "narrator": "みやび",
            "text": "年の差がありすぎるのではないか",
            "zh": "这年龄差是不是太大了",
            "narrator_zh": "雅"
        },
        {
            "location": "212/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "雅"
        },
        {
            "location": "213/TALK",
            "narrator": "みやび",
            "text": "そういうことではなく",
            "zh": "不是那个意思",
            "narrator_zh": "雅"
        },
        {
            "location": "214/TALK",
            "narrator": "みやび",
            "text": "貴殿の冗談はちっくと笑えん",
            "zh": "你的笑话一点也不好笑",
            "narrator_zh": "雅"
        },
        {
            "location": "216/SEL",
            "narrator": "",
            "text": "本気",
            "zh": "认真的",
            "narrator_zh": ""
        },
        {
            "location": "217/SEL",
            "narrator": "",
            "text": "ガチ",
            "zh": "来真的",
            "narrator_zh": ""
        },
        {
            "location": "218/ACT",
            "narrator": "",
            "text": "本気",
            "zh": "认真的",
            "narrator_zh": ""
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "いやいやいやいや",
            "zh": "不不不不",
            "narrator_zh": "雅"
        },
        {
            "location": "220/TALK",
            "narrator": "みやび",
            "text": "ないわー",
            "zh": "才没有呢——",
            "narrator_zh": "雅"
        },
        {
            "location": "221/ACT",
            "narrator": "",
            "text": "ガチ",
            "zh": "来真的",
            "narrator_zh": ""
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "またまた",
            "zh": "又来了",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
