            "narrator_zh": "雅"
        },
        {
            "location": "309/TALK",
            "narrator": "みやび",
            "text": "うちの家族からのメールも負けとらんぞ",
            "zh": "我家里来的邮件也不输咧",
            "narrator_zh": "雅"
        },
        {
            "location": "312/SEL",
            "narrator": "",
            "text": "面白メールが来るの？",
            "zh": "会来有趣的邮件？",
