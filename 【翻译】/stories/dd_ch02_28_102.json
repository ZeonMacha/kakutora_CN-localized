{
    "dir": "chap28/daydra/dd_ch02_28_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "28205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "兄弟姉妹の世界線＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "兄弟姐妹的世界线＜后篇＞"
    },
    "entry": [
        {
            "location": "465/SCENARIO",
            "narrator": "",
            "text": "兄弟姉妹の世界線",
            "zh": "兄弟姐妹的世界线",
            "narrator_zh": ""
        },
        {
            "location": "487/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "488/TALK",
            "narrator": "みやび",
            "text": "確認できたかね？",
            "zh": "确认好了没喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "491/TALK",
            "narrator": "アーヤ",
            "text": "ええ。\nありがとう。",
            "zh": "嗯。\n谢谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "492/TALK",
            "narrator": "みやび",
            "text": "私的な内容やと\n最初気付かんかったき\n読んでしもうた。",
            "zh": "一开始没察觉到\n是私人信件嘛，\n就顺手看掉了。",
            "narrator_zh": "雅"
        },
        {
            "location": "493/TALK",
            "narrator": "みやび",
            "text": "すまんかったぞね。",
            "zh": "实在对不住啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "494/TALK",
            "narrator": "アーヤ",
            "text": "ああ。\nいいのよそれは。\n気にしないで。",
            "zh": "啊。\n那倒没什么。\n别放在心上。",
            "narrator_zh": "绫水"
        },
        {
            "location": "495/TALK",
            "narrator": "アーヤ",
            "text": "…それより…。",
            "zh": "……话说回来……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "496/TALK",
            "narrator": "アーヤ",
            "text": "もしみやびが妹\nだったら。姉はきっと\n楽しかったでしょうね。",
            "zh": "如果雅是妹妹\n的话。姐姐一定会\n很开心吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "497/TALK",
            "narrator": "みやび",
            "text": "うちがエリカさんの\n妹だったら？",
            "zh": "要是我成了领火的\n妹妹？",
            "narrator_zh": "雅"
        },
        {
            "location": "498/TALK",
            "narrator": "アーヤ",
            "text": "そう。",
            "zh": "是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "499/TALK",
            "narrator": "アーヤ",
            "text": "話も合うし、教えがいも\nあるだろうし。\nみやびも楽しいでしょ？",
            "zh": "既聊得来，教起来\n肯定也很有成就感。\n雅也会觉得开心吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "501/TALK",
            "narrator": "みやび",
            "text": "エリカさんが姉やったら\nうちはハッカーには\nなってないぞね。",
            "zh": "要是领火做我姐姐，\n我大概不会变成\n黑客啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "502/TALK",
            "narrator": "みやび",
            "text": "やき、楽しくは\nないろうねえ。",
            "zh": "所以嘛，应该也\n不会觉得开心咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "503/TALK",
            "narrator": "アーヤ",
            "text": "え？",
            "zh": "哎？",
            "narrator_zh": "绫水"
        },
        {
            "location": "504/TALK",
            "narrator": "みやび",
            "text": "プロゲーマーか\n天才美人棋士にでも\nなってたろうね。",
            "zh": "大概会变成职业玩家\n或者天才美人棋手\n之类的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "507/TALK",
            "narrator": "アーヤ",
            "text": "天才美人棋士、って…。",
            "zh": "天才美人棋手，什么的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "509/TALK",
            "narrator": "みやび",
            "text": "ああ。\n将棋打ちの棋士ぞね。",
            "zh": "啊。\n就是下将棋的棋手啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "512/TALK",
            "narrator": "アーヤ",
            "text": "ええと\nそこじゃなくて…。",
            "zh": "那个\n重点不是那个……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "513/SEL",
            "narrator": "",
            "text": "自分で美人って言う？",
            "zh": "会自己说自己是美人吗？",
            "narrator_zh": ""
        },
        {
            "location": "514/SEL",
            "narrator": "",
            "text": "自分のこと天才とか言う？",
            "zh": "会自己说自己是天才吗？",
            "narrator_zh": ""
        },
        {
            "location": "515/ACT",
            "narrator": "",
            "text": "自分で美人って言う？",
            "zh": "会自己说自己是美人吗？",
            "narrator_zh": ""
        },
        {
            "location": "531/TALK",
            "narrator": "アーヤ",
            "text": "それがみやびの",
            "zh": "那就是雅",
            "narrator_zh": "绫水"
        },
        {
            "location": "532/TALK",
            "narrator": "アーヤ",
            "text": "みやびたる所以よ",
            "zh": "之所以是雅的地方哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "533/ACT",
            "narrator": "",
            "text": "自分のこと天才とか言う？",
            "zh": "会自己说自己是天才吗？",
            "narrator_zh": ""
        },
        {
            "location": "549/TALK",
            "narrator": "アーヤ",
            "text": "実際天才だから",
            "zh": "毕竟她确实是天才",
            "narrator_zh": "绫水"
        },
        {
            "location": "550/TALK",
            "narrator": "アーヤ",
            "text": "仕方ないわ",
            "zh": "也没办法",
            "narrator_zh": "绫水"
        },
        {
            "location": "552/TALK",
            "narrator": "アーヤ",
            "text": "でも対応に困るわ、、、",
            "zh": "不过真让人不知该怎么接话……",
            "narrator_zh": "绫水"
        },
        {
            "location": "554/SEL",
            "narrator": "",
            "text": "ビシッと突っ込んでよ！",
            "zh": "干脆利落地吐槽她啊！",
            "narrator_zh": ""
        },
        {
            "location": "555/SEL",
            "narrator": "",
            "text": "まあみやびらしいけど",
            "zh": "嘛，确实很像雅的风格",
            "narrator_zh": ""
        },
        {
            "location": "556/ACT",
            "narrator": "",
            "text": "ビシッと突っ込んでよ！",
            "zh": "干脆利落地吐槽她啊！",
            "narrator_zh": ""
        },
        {
            "location": "557/TALK",
            "narrator": "アーヤ",
            "text": "いちいち言うのも",
            "zh": "每次都要较真吐槽",
            "narrator_zh": "绫水"
        },
        {
            "location": "558/TALK",
            "narrator": "アーヤ",
            "text": "ばからしい気もするわ",
            "zh": "总觉得也有点傻气了",
            "narrator_zh": "绫水"
        },
        {
            "location": "559/ACT",
            "narrator": "",
            "text": "まあみやびらしいけど",
            "zh": "嘛，确实很像雅的风格",
            "narrator_zh": ""
        },
        {
            "location": "560/TALK",
            "narrator": "アーヤ",
            "text": "本当そうよね",
            "zh": "真的就是这样",
            "narrator_zh": "绫水"
        },
        {
            "location": "561/TALK",
            "narrator": "アーヤ",
            "text": "不思議ちゃんなのよ",
            "zh": "真是个不可思议的孩子",
            "narrator_zh": "绫水"
        },
        {
            "location": "573/TALK",
            "narrator": "みやび",
            "text": "エリカさんは本物の\n天才やき。",
            "zh": "因为领火是货真价实的\n天才嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "574/TALK",
            "narrator": "みやび",
            "text": "超えられん身内の\n後ろ姿を見続けるのには\n耐えられん。",
            "zh": "一直看着那个\n永远无法超越的亲人背影，\n我可受不了。",
            "narrator_zh": "雅"
        },
        {
            "location": "577/TALK",
            "narrator": "アーヤ",
            "text": "…そういうもの？",
            "zh": "……是这样吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "578/TALK",
            "narrator": "みやび",
            "text": "アーヤはどうなが？\nもしアーヤの方が\nお姉さんやったら？",
            "zh": "那绫水你呢？\n要是换作绫水你\n当姐姐的话？",
            "narrator_zh": "雅"
        },
        {
            "location": "579/TALK",
            "narrator": "アーヤ",
            "text": "私が姉だったら…。",
            "zh": "如果我是姐姐……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "581/TALK",
            "narrator": "アーヤ",
            "text": "多分エリカには\n文句ばっかり\n言ってたと思う。",
            "zh": "大概只会整天对领火\n不停地\n挑刺抱怨吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "582/TALK",
            "narrator": "アーヤ",
            "text": "とにかく普通にして\n普通にしてって\n強制してた気がする。",
            "zh": "感觉会一直强迫她\n“总之给我像个普通人\n像个普通人”。",
            "narrator_zh": "绫水"
        },
        {
            "location": "583/TALK",
            "narrator": "アーヤ",
            "text": "そのせいで余計\n変人になりそう。",
            "zh": "说不定反而会把她\n逼得更像个怪人。",
            "narrator_zh": "绫水"
        },
        {
            "location": "584/TALK",
            "narrator": "アーヤ",
            "text": "ってことは今の方が\nましかもね。",
            "zh": "这么一想，还是现在\n这样更好吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "585/TALK",
            "narrator": "アーヤ",
            "text": "ずれてはいるけど\n姉っぽいことを\nしてみたりするし…。",
            "zh": "虽然有点跑偏，\n但她也会试着做点\n像姐姐一样的事……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "586/TALK",
            "narrator": "みやび",
            "text": "長女にはお手本が\nないきね。",
            "zh": "毕竟当大姐的\n没得人可以当榜样嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "588/TALK",
            "narrator": "みやび",
            "text": "どうしてもそうなって\nしまうぞね。",
            "zh": "总会不知不觉\n变成那样啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "589/TALK",
            "narrator": "アーヤ",
            "text": "…そうなのかも。",
            "zh": "……也许真是那样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "590/TALK",
            "narrator": "みやび",
            "text": "しかもエリカさんは\n普通の思考回路では\nないしねえ。",
            "zh": "而且领火的\n脑回路本来就\n跟普通人不一样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "591/TALK",
            "narrator": "みやび",
            "text": "アーヤが困惑するような\n愛情表現をして\nしまうんやろねえ。",
            "zh": "所以才会做出那种\n让绫水你犯难的\n示爱方式咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "592/TALK",
            "narrator": "アーヤ",
            "text": "そうなのかもね。",
            "zh": "或许吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "593/TALK",
            "narrator": "アーヤ",
            "text": "…やっぱりみやびは\nどんな環境でも\nハッカーになる気がする。",
            "zh": "……不过我还是觉得，\n雅无论在什么环境下，\n大概都会成为黑客。",
            "narrator_zh": "绫水"
        },
        {
            "location": "594/TALK",
            "narrator": "アーヤ",
            "text": "なんて、ありえない\n可能性の話をしても\n仕方ないけど。",
            "zh": "算了，聊这种\n不可能的假设，\n也没什么意义。",
            "narrator_zh": "绫水"
        },
        {
            "location": "595/TALK",
            "narrator": "みやび",
            "text": "別の視点から物事を\n見る手段としては\n有効だと思うちや。",
            "zh": "作为换个角度看事情的\n办法，我觉得还是\n蛮有用的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "596/TALK",
            "narrator": "アーヤ",
            "text": "…そうね。",
            "zh": "……说的也是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "608/TALK",
            "narrator": "アーヤ",
            "text": "さっきのファイル",
            "zh": "刚才那个文件",
            "narrator_zh": "绫水"
        },
        {
            "location": "609/TALK",
            "narrator": "アーヤ",
            "text": "姉からの私信だったわ",
            "zh": "是姐姐写给我的私信",
            "narrator_zh": "绫水"
        },
        {
            "location": "610/TALK",
            "narrator": "アーヤ",
            "text": "あの人なりに",
            "zh": "她好像也在用她自己的方式",
            "narrator_zh": "绫水"
        },
        {
            "location": "611/TALK",
            "narrator": "アーヤ",
            "text": "私のこと気にしてくれてるみたい",
            "zh": "关心着我呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "612/TALK",
            "narrator": "アーヤ",
            "text": "理解はしにくいけど",
            "zh": "虽然很难理解就是了",
            "narrator_zh": "绫水"
        },
        {
            "location": "614/SEL",
            "narrator": "",
            "text": "それでもうれしいでしょ",
            "zh": "即便如此还是很开心吧",
            "narrator_zh": ""
        },
        {
            "location": "615/SEL",
            "narrator": "",
            "text": "色々あるんだね",
            "zh": "真是各有各的难处呢",
            "narrator_zh": ""
        },
        {
            "location": "616/SEL",
            "narrator": "",
            "text": "アーヤこそ素直になりなよ",
            "zh": "绫水你也坦率一点嘛",
            "narrator_zh": ""
        },
        {
            "location": "617/ACT",
            "narrator": "",
            "text": "それでもうれしいでしょ",
            "zh": "即便如此还是很开心吧",
            "narrator_zh": ""
        },
        {
            "location": "618/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "619/TALK",
            "narrator": "アーヤ",
            "text": "少しはね",
            "zh": "有一点吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "620/ACT",
            "narrator": "",
            "text": "色々あるんだね",
            "zh": "真是各有各的难处呢",
            "narrator_zh": ""
        },
        {
            "location": "621/TALK",
            "narrator": "アーヤ",
            "text": "そりゃ",
            "zh": "那当然",
            "narrator_zh": "绫水"
        },
        {
            "location": "622/TALK",
            "narrator": "アーヤ",
            "text": "あるわよ",
            "zh": "肯定有啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "623/ACT",
            "narrator": "",
            "text": "アーヤこそ素直になりなよ",
            "zh": "绫水你也坦率一点嘛",
            "narrator_zh": ""
        },
        {
            "location": "624/TALK",
            "narrator": "アーヤ",
            "text": "何よ",
            "zh": "什么呀",
            "narrator_zh": "绫水"
        },
        {
            "location": "625/TALK",
            "narrator": "アーヤ",
            "text": "もー！",
            "zh": "真是的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "637/TALK",
            "narrator": "アーヤ",
            "text": "色んなことが無事に\n片づいたら\n会えるから。",
            "zh": "等各种事情都顺利\n解决之后，\n就能见面了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "638/TALK",
            "narrator": "アーヤ",
            "text": "その時はもう少し\n優しくしよう。",
            "zh": "到那个时候，我就\n稍微温柔一点吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "640/TALK",
            "narrator": "アーヤ",
            "text": "…かなり努力が\n必要そうだけど…。",
            "zh": "……虽然感觉需要\n相当大的努力就是了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "651/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【23 エクセプション】",
            "zh": "【23 异常】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
