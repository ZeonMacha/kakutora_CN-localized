        {
            "location": "428/TALK",
            "narrator": "みやび",
            "text": "なんとマニアックなチョイス",
            "zh": "多么冷门的选择",
            "narrator_zh": "雅"
        },
        {
            "location": "430/TALK",
            "narrator": "みやび",
            "text": "この映画を選ぶとは",
            "zh": "竟然会选这部电影",
            "narrator_zh": "雅"
        },
        {
            "location": "431/TALK",
            "narrator": "みやび",
            "text": "褒めてつかわそう",
            "zh": "就褒奖你一下吧",
            "narrator_zh": "雅"
        },
        {
            "location": "437/SEL",
            "narrator": "",
            "text": "どこが好きなの？",
            "zh": "你喜欢它哪里？",
            "narrator_zh": ""
        },
        {
            "location": "438/ACT",
            "narrator": "",
            "text": "どこが好きなの？",
            "zh": "你喜欢它哪里？",
            "narrator_zh": ""
        },
        {
            "location": "441/TALK",
            "narrator": "みやび",
            "text": "全部",
            "zh": "全部",
            "narrator_zh": "雅"
        },
        {
            "location": "442/TALK",
            "narrator": "みやび",
            "text": "というと話が終わるな",
            "zh": "这么说的话就聊不下去了咧",
            "narrator_zh": "雅"
        },
        {
            "location": "443/TALK",
            "narrator": "みやび",
            "text": "孤独の戦場はハッカー流儀に通じる部分があるためだ",
            "zh": "因为《孤独的战场》和黑客的做派有相通之处",
            "narrator_zh": "雅"
        },
        {
            "location": "448/SEL",
            "narrator": "",
            "text": "なるほどね",
            "zh": "原来如此呢",
            "narrator_zh": ""
        },
        {
            "location": "449/ACT",
            "narrator": "",
            "text": "なるほどね",
            "zh": "原来如此呢",
            "narrator_zh": ""
        },
        {
            "location": "452/TALK",
            "narrator": "みやび",
            "text": "ハッカーは孤独なもの",
            "zh": "黑客是孤独的",
            "narrator_zh": "雅"
        },
        {
            "location": "453/TALK",
            "narrator": "みやび",
            "text": "そして常に研鑽を積まねばならぬ",
            "zh": "而且必须不断精进",
            "narrator_zh": "雅"
        },
        {
            "location": "454/TALK",
            "narrator": "みやび",
            "text": "なんて言っておいて",
            "zh": "说了这么一番大话",
            "narrator_zh": "雅"
        },
        {
            "location": "455/TALK",
            "narrator": "みやび",
            "text": "実は初見ではよさがわからなんだことをここに告白する",
            "zh": "其实第一遍根本没看出好在哪——在此坦白咯",
            "narrator_zh": "雅"
        },
        {
            "location": "459/SEL",
            "narrator": "",
            "text": "そうだったんだ",
            "zh": "是这样啊",
            "narrator_zh": ""
        },
        {
            "location": "460/ACT",
            "narrator": "",
            "text": "そうだったんだ",
            "zh": "是这样啊",
            "narrator_zh": ""
        },
        {
            "location": "463/TALK",
            "narrator": "みやび",
            "text": "まだまだかわいい中学生やったき",
            "zh": "那时候还是个挺可爱的中学生啵",
            "narrator_zh": "雅"
        },
        {
            "location": "464/TALK",
            "narrator": "みやび",
            "text": "いまいちピンとこなんだ",
            "zh": "一时半会没找到感觉",
            "narrator_zh": "雅"
        },
        {
            "location": "465/TALK",
            "narrator": "みやび",
            "text": "しかし何かココロに残っていて",
            "zh": "但有什么留在了心里",
            "narrator_zh": "雅"
        },
        {
            "location": "466/TALK",
            "narrator": "みやび",
            "text": "今となっては座右の映画ぞね",
            "zh": "如今已经是我的座右电影咧",
            "narrator_zh": "雅"
        },
        {
            "location": "469/SEL",
            "narrator": "",
            "text": "初めて聞いたそんな不思議な言葉",
            "zh": "还是头一回听到这么不可思议的说法",
            "narrator_zh": ""
        },
        {
            "location": "470/ACT",
            "narrator": "",
            "text": "初めて聞いたそんな不思議な言葉",
            "zh": "还是头一回听到这么不可思议的说法",
            "narrator_zh": ""
        },
        {
            "location": "473/TALK",
            "narrator": "みやび",
            "text": "そのくらい人生に重要な映画ちうことやね",
            "zh": "就是说这部电影重要到那个程度咯",
            "narrator_zh": "雅"
        },
        {
            "location": "474/TALK",
            "narrator": "みやび",
            "text": "それを$handle$がチョイスしたことも重要",
