{
    "dir": "chap08/battle/btev_ch02_08_02.js",
    "type": "",
    "info": {
        "story_id": "22015",
        "cid": "",
        "title": "015 ココロスフィアストーリー【Lv05】",
        "sub_title": "転落人生＜帰結＞",
        "title_zh": "015 心灵领域故事【Lv05】",
        "sub_title_zh": "坠落的人生＜归结＞"
    },
    "entry": [
        {
            "location": "640/SCENARIO",
            "narrator": "",
            "text": "転落人生",
            "zh": "坠落的人生",
            "narrator_zh": ""
        },
        {
            "location": "654/TALK",
            "narrator": "アーヤ",
            "text": "酷い……\n私の世界なのに…っ…",
            "zh": "好过分……\n明明是我的世界……！",
            "narrator_zh": "绫水"
        },
        {
            "location": "655/TALK",
            "narrator": "分身アーヤ",
            "text": "貴方の言い分もわかる。\nけど、もっと自信を\n持ってもいいと思う。",
            "zh": "你的想法我也理解。\n不过，我觉得你完全\n可以更自信一点。",
            "narrator_zh": "分身绫水"
        },
        {
            "location": "656/TALK",
            "narrator": "分身アーヤ",
            "text": "確かに卯月は強いし\n逢瀬さんだって謎の\n力を持ってる。",
            "zh": "卯月确实很强，\n逢濑也拥有\n神秘的力量。",
            "narrator_zh": "分身绫水"
        },
        {
            "location": "657/TALK",
            "narrator": "分身アーヤ",
            "text": "けど、私だって\nちゃんと戦えてるし――",
            "zh": "但是，我自己也\n一直在好好战斗——",
            "narrator_zh": "分身绫水"
        },
        {
            "location": "658/TALK",
            "narrator": "分身アーヤ",
            "text": "リーダーとして\nちゃんとやれてる。",
            "zh": "作为队长，\n也做得称职。",
            "narrator_zh": "分身绫水"
        },
        {
            "location": "660/TALK",
            "narrator": "アーヤ",
            "text": "…だといいけど。",
            "zh": "……但愿如此吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "661/TALK",
            "narrator": "アーヤ",
            "text": "私の不安が\n的中しなければ\nいいんだけどね。",
            "zh": "只要我的不安\n别应验\n就好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "665/TALK",
            "narrator": "アーヤ",
            "text": "特に最近の私は、\n全然なってない。",
            "zh": "特别是最近的我，\n简直不成样子。",
            "narrator_zh": "绫水"
        },
        {
            "location": "666/TALK",
            "narrator": "アーヤ",
            "text": "こんな体たらくじゃ\n後輩に追い抜かれるのも\n時間の問題よ……。",
            "zh": "就这副德行，\n被后辈赶超也只是\n时间问题吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "667/TALK",
            "narrator": "分身アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "分身绫水"
        },
        {
            "location": "668/TALK",
            "narrator": "アーヤ",
            "text": "高校の時の\n私を思い出して……。",
            "zh": "想想高中时的\n自己……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "682/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう、\n手伝ってくれて。",
            "zh": "谢谢你，\n肯来帮我。",
            "narrator_zh": "绫水"
        },
        {
            "location": "683/TALK",
            "narrator": "アーヤ",
            "text": "これで私も\n少しはポジティブに\n考えられるようになる。",
            "zh": "这样一来，我也总算\n能往积极的方面\n多想想了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "684/SEL",
            "narrator": "（選択肢）",
            "text": "よかった",
            "zh": "太好了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "685/SEL",
            "narrator": "（選択肢）",
            "text": "どうしてそんなに焦ってるの？",
            "zh": "为什么那么焦虑呀？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "686/ACT",
            "narrator": "",
            "text": "よかった",
            "zh": "太好了",
            "narrator_zh": ""
        },
        {
            "location": "687/TALK",
            "narrator": "アーヤ",
            "text": "ええ。",
            "zh": "嗯。",
            "narrator_zh": "绫水"
        },
        {
            "location": "688/ACT",
            "narrator": "",
            "text": "どうしてそんなに焦ってるの？",
            "zh": "为什么那么焦虑呀？",
            "narrator_zh": ""
        },
        {
            "location": "689/TALK",
            "narrator": "アーヤ",
            "text": "んー……",
            "zh": "唔——……",
            "narrator_zh": "绫水"
        },
        {
            "location": "690/TALK",
            "narrator": "アーヤ",
            "text": "どうしてかしらね。\n私は焦ってないし、\nわからないかも。",
            "zh": "为什么呢。\n我倒是没焦虑，\n所以不太清楚吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "691/SEL",
            "narrator": "（選択肢）",
            "text": "自分のことでしょ？",
            "zh": "那不是你自己吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "692/ACT",
            "narrator": "",
            "text": "自分のことでしょ？",
            "zh": "那不是你自己吗？",
            "narrator_zh": ""
        },
        {
            "location": "694/TALK",
            "narrator": "アーヤ",
            "text": "確かに私だけど、\nでもさっきの私と\n今の私は別の人格。",
            "zh": "确实都是我没错，\n不过刚才的我\n和现在的我是不同的人格。",
            "narrator_zh": "绫水"
        },
        {
            "location": "695/TALK",
            "narrator": "アーヤ",
            "text": "私にとっては、卯月も\n逢瀬さんもすごいけど\nそれはそれ。",
            "zh": "对我而言，卯月和\n逢濑固然厉害，\n但一码归一码。",
            "narrator_zh": "绫水"
        },
        {
            "location": "696/TALK",
            "narrator": "アーヤ",
            "text": "私は私で、ちゃんと\nリーダーとしての責務を\n全うするだけなの。",
            "zh": "我是我，只要好好\n尽到作为队长的职责\n就行了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "698/TALK",
            "narrator": "アーヤ",
            "text": "ああっ！\nいけない！",
            "zh": "啊啊！\n糟糕！",
            "narrator_zh": "绫水"
        },
        {
            "location": "699/TALK",
            "narrator": "アーヤ",
            "text": "私って今、長距離走の\n途中だったわよね？",
            "zh": "我现在，不是还在\n跑长跑途中吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "700/SEL",
            "narrator": "（選択肢）",
            "text": "そうだけど、まだやるの？",
            "zh": "是没错，还要继续跑吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "701/ACT",
            "narrator": "",
            "text": "そうだけど、まだやるの？",
            "zh": "是没错，还要继续跑吗？",
            "narrator_zh": ""
        },
        {
            "location": "703/TALK",
            "narrator": "アーヤ",
            "text": "もちろんよ。",
            "zh": "那当然了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "705/TALK",
            "narrator": "アーヤ",
            "text": "この世界をハッピー\nエンドで終わらせ\nなくちゃいけない。",
            "zh": "必须让这个世界\n迎来圆满结局\n才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "706/TALK",
            "narrator": "アーヤ",
            "text": "そうしないと、現実の\n私の気持ちが曇った\nままになっちゃうから。",
            "zh": "不然的话，现实中\n我的心情就会一直\n阴云密布的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "707/SEL",
            "narrator": "（選択肢）",
            "text": "その格好で？",
            "zh": "就穿这身吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "708/ACT",
            "narrator": "",
            "text": "その格好で？",
            "zh": "就穿这身吗？",
            "narrator_zh": ""
        },
        {
            "location": "710/TALK",
            "narrator": "アーヤ",
            "text": "まさか。\nちゃんと着替えるわよ。",
            "zh": "怎么可能。\n我会好好换衣服的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "711/SEL",
            "narrator": "（選択肢）",
            "text": "頑張って！",
            "zh": "加油！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "712/ACT",
            "narrator": "",
            "text": "頑張って！",
            "zh": "加油！",
            "narrator_zh": ""
        },
        {
            "location": "715/TALK",
            "narrator": "アーヤ",
            "text": "ええ。\nありがと！",
            "zh": "嗯。\n谢谢！",
            "narrator_zh": "绫水"
        },
        {
            "location": "734/TALK",
            "narrator": "透明アーヤ",
            "text": "だいぶ距離を\n開けられちゃったわね。",
            "zh": "被拉开\n好长一段距离了呢。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "736/TALK",
            "narrator": "透明アーヤ",
            "text": "でもこれくらいなら\nまだ大丈夫。",
            "zh": "不过这种程度的话，\n还来得及。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "737/TALK",
            "narrator": "透明アーヤ",
            "text": "逆転のチャンスは\n十分にあるわ。",
            "zh": "逆转的机会\n还大得很。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "738/SEL",
            "narrator": "（選択肢）",
            "text": "応援してるよ！",
            "zh": "我支持你！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "739/SEL",
            "narrator": "（選択肢）",
            "text": "さっきの格好のままで走って欲しかった",
            "zh": "真希望你就穿刚才那身跑啊",
            "narrator_zh": "（选项）"
        },
        {
            "location": "740/SEL",
            "narrator": "（選択肢）",
            "text": "$me$はアーヤのダイナミックな揺れに夢中です",
            "zh": "$me$正沉迷在绫水那充满动感的晃动里",
            "narrator_zh": "（选项）"
        },
        {
            "location": "741/ACT",
            "narrator": "",
            "text": "応援してるよ！",
            "zh": "我支持你！",
            "narrator_zh": ""
        },
        {
            "location": "745/TALK",
            "narrator": "透明アーヤ",
            "text": "ありがと！",
            "zh": "谢谢！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "747/TALK",
            "narrator": "透明アーヤ",
            "text": "$handle$が\n応援してくれると\nとても心強いわ。",
            "zh": "有$handle$\n给我加油，\n感觉心里踏实多了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "751/TALK",
            "narrator": "透明アーヤ",
            "text": "んーっ！\n頑張らなくちゃ！",
            "zh": "嗯——！\n得加油了！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "752/ACT",
            "narrator": "",
            "text": "さっきの格好のままで走って欲しかった",
            "zh": "真希望你就穿刚才那身跑啊",
            "narrator_zh": ""
        },
        {
            "location": "754/TALK",
            "narrator": "透明アーヤ",
            "text": "冗談やめて。\nお気に入りの服なのに\n汗だくになっちゃう。",
            "zh": "别开玩笑了。\n那可是我最喜欢的衣服，\n会全都汗透的。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "755/ACT",
            "narrator": "",
            "text": "$me$はアーヤのダイナミックな揺れに夢中です",
            "zh": "$me$正沉迷在绫水那充满动感的晃动里",
            "narrator_zh": ""
        },
        {
            "location": "758/TALK",
            "narrator": "透明アーヤ",
            "text": "はいはい。\n何の揺れのことかは\nわかりませんけど？",
            "zh": "好好好。\n虽然我不知道你说的是\n什么晃动就是了？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "760/TALK",
            "narrator": "透明アーヤ",
            "text": "高校生の時は、剣道\nするにも邪魔だし嫌\nだったけど――",
            "zh": "高中的时候，练剑道也\n碍事，我挺讨厌的\n来着——",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "761/TALK",
            "narrator": "透明アーヤ",
            "text": "今はオシャレし甲斐\nあるから、よかったと\n思ってる。",
            "zh": "现在打扮起来\n挺有讲究的，\n倒觉得这样也好。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "763/TALK",
            "narrator": "透明アーヤ",
            "text": "でもそう思ってるのは\nここだけの\n秘密だからね？",
            "zh": "不过我这么想的事，\n就只是你我之间的\n秘密哦？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "793/TALK",
            "narrator": "つばめ",
            "text": "はぁ…はぁ……\nつかれたー！",
            "zh": "哈啊……哈啊……\n累死了——！",
            "narrator_zh": "燕"
        },
        {
            "location": "794/TALK",
            "narrator": "神楽",
            "text": "アーヤちゃんの\n追い上げが凄くて\nビックリでした。",
            "zh": "绫水后面的\n追赶势头太猛，\n真吓了我一跳。",
            "narrator_zh": "神乐"
        },
        {
            "location": "795/TALK",
            "narrator": "つばめ",
            "text": "ホントだよー。",
            "zh": "就是呀——。",
            "narrator_zh": "燕"
        },
        {
            "location": "797/TALK",
            "narrator": "アーヤ",
            "text": "途中ちょっと\n気を抜いちゃったしね。",
            "zh": "谁让我中途稍微\n松懈了一点嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "798/TALK",
            "narrator": "アーヤ",
            "text": "最後くらいは\n本気だしておかないと。",
            "zh": "至少到最后，\n总得拿出点真本事吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "806/TALK",
            "narrator": "真幌",
            "text": "３人ほぼ同着１位で\nゴールとはな。",
            "zh": "三个人竟然几乎\n并列第一冲线啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "807/TALK",
            "narrator": "真幌",
            "text": "まあ、逢瀬は途中\n迷子になっていた\nわけだが……。",
            "zh": "虽说，逢濑中途\n还迷路了\n就是……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "808/TALK",
            "narrator": "つばめ",
            "text": "えへへ、\nごめんなさい…。",
            "zh": "诶嘿嘿，\n对不起……。",
            "narrator_zh": "燕"
        },
        {
            "location": "811/TALK",
            "narrator": "真幌",
            "text": "アーヤは後半の\n追い上げが凄くて\nびっくりしたぞ。",
            "zh": "绫水后半程\n追得太猛，\n我都吓了一跳。",
            "narrator_zh": "真幌"
        },
        {
            "location": "812/TALK",
            "narrator": "真幌",
            "text": "これからもその調子で\n頑張ってくれよ、\n生徒会長。",
            "zh": "今后也要保持这股劲头\n继续加油啊，\n学生会长。",
            "narrator_zh": "真幌"
        },
        {
            "location": "813/TALK",
            "narrator": "アーヤ",
            "text": "はいっ！",
            "zh": "是！",
            "narrator_zh": "绫水"
        },
        {
            "location": "816/TALK",
            "narrator": "アーヤ",
            "text": "ホントにありがと、\n$handle$！",
            "zh": "真的谢谢你，\n$handle$！",
            "narrator_zh": "绫水"
        },
        {
            "location": "817/SEL",
            "narrator": "（選択肢）",
            "text": "どういたしまして！",
            "zh": "不客气！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "818/ACT",
            "narrator": "",
            "text": "どういたしまして！",
            "zh": "不客气！",
            "narrator_zh": ""
        },
        {
            "location": "837/TALK",
            "narrator": "千羽鶴",
            "text": "お疲れさま。",
            "zh": "辛苦了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "838/TALK",
            "narrator": "千羽鶴",
            "text": "今回も華麗な\nココロ裁きだった。",
            "zh": "这次也是华丽的\n心的裁断。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "839/SEL",
            "narrator": "（選択肢）",
            "text": "どうも！",
            "zh": "谢啦！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "840/SEL",
            "narrator": "（選択肢）",
            "text": "うーん…",
            "zh": "嗯——……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "841/ACT",
            "narrator": "",
            "text": "どうも！",
            "zh": "谢啦！",
            "narrator_zh": ""
        },
        {
            "location": "842/TALK",
            "narrator": "千羽鶴",
            "text": "この調子で\n次もお願いね。",
            "zh": "就照这个势头，\n下次也拜托你了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "843/ACT",
            "narrator": "",
            "text": "うーん…",
            "zh": "嗯——……",
            "narrator_zh": ""
        },
        {
            "location": "844/TALK",
            "narrator": "千羽鶴",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "845/SEL",
            "narrator": "（選択肢）",
            "text": "警戒する心を消して良かったのかな",
            "zh": "把那份警戒之心消除掉真的好吗",
            "narrator_zh": "（选项）"
        },
        {
            "location": "846/SEL",
            "narrator": "（選択肢）",
            "text": "アーヤのダイナミック揺れをもっと見ていたかった",
            "zh": "真想再多看看绫水那充满动感的晃动呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "847/ACT",
            "narrator": "",
            "text": "警戒する心を消して良かったのかな",
            "zh": "把那份警戒之心消除掉真的好吗",
            "narrator_zh": ""
        },
        {
            "location": "848/TALK",
            "narrator": "千羽鶴",
            "text": "さあ？\nそれはわからない。",
            "zh": "谁知道？\n这个我说不准。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "849/TALK",
            "narrator": "千羽鶴",
            "text": "もしかしたら後で\nもっと酷いことに\nなるかも。",
            "zh": "说不定之后\n会变成更糟糕的\n状况。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "850/TALK",
            "narrator": "千羽鶴",
            "text": "でも、今の彼女が先へ\n進むには、この結果は\n悪くなかったと思う。",
            "zh": "不过，对于现在的她\n继续往前走而言，这个结果\n我觉得不算坏。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "851/TALK",
            "narrator": "千羽鶴",
            "text": "あくまで私見だけど。",
            "zh": "虽然纯属个人看法。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "852/SEL",
            "narrator": "（選択肢）",
            "text": "フォローありがとう",
            "zh": "谢谢你安慰我",
            "narrator_zh": "（选项）"
        },
        {
            "location": "853/ACT",
            "narrator": "",
            "text": "フォローありがとう",
            "zh": "谢谢你安慰我",
            "narrator_zh": ""
        },
        {
            "location": "855/TALK",
            "narrator": "千羽鶴",
            "text": "どういたしまして。",
            "zh": "不客气。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "856/ACT",
            "narrator": "",
            "text": "アーヤのダイナミック揺れをもっと見ていたかった",
            "zh": "真想再多看看绫水那充满动感的晃动呀",
            "narrator_zh": ""
        },
        {
            "location": "857/TALK",
            "narrator": "千羽鶴",
            "text": "もう一回このお話を\n見ればいいだけ。",
            "zh": "再把这段故事\n看一遍不就好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "858/TALK",
            "narrator": "千羽鶴",
            "text": "後悔する前に\n頭と指を使う。",
            "zh": "在后悔之前，\n多动动脑子和手指。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "859/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃまた。",
            "zh": "那就回见。",
            "narrator_zh": "千羽鹤"
        }
    ]
