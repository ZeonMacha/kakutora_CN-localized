{
    "dir": "chap08/daydra/dd_ch04_08_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "8452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "着付け教室",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "和服穿着教室"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "着付け教室",
            "zh": "和服穿着教室",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "着付け教室ぅ？\nみやびが教えてるの？",
            "zh": "和服穿着教室？\n是雅在教？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "みやび",
            "text": "うむ。",
            "zh": "嗯。",
            "narrator_zh": "雅"
        },
        {
            "location": "27/TALK",
            "narrator": "みやび",
            "text": "うち、私服が和服やき、\n最近学校でよく頼まれ\nるんよ。",
            "zh": "我的私服就是和服嘛，\n最近在学校老被\n拜托咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "28/TALK",
            "narrator": "みやび",
            "text": "やき、昼休みに希望者\n集めて教えちゅう。",
            "zh": "所以啵，午休时把\n想学的人聚起来教着。",
            "narrator_zh": "雅"
        },
        {
            "location": "29/TALK",
            "narrator": "ガブリエラ",
            "text": "ふ～ん、そうなんだ…。",
            "zh": "哦～，是这样啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "それで、みんなちゃんと\n覚えてくれてる？",
            "zh": "那，大家都有好好\n记住吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "みやび",
            "text": "ん～…まだしばらくは\n掛かりそうやね。",
            "zh": "唔～……看样子还得\n再花上一阵子咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "洋服と違って着るのに\n時間も掛かるし――",
            "zh": "跟洋装不同，光是穿\n就要花不少时间——",
            "narrator_zh": "雅"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "昼休みの時間も\n限られちゅうき――",
            "zh": "午休的时间也是\n有限度的啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "しばらくは続けんと\nいかんやろうね。",
            "zh": "看来这一阵子\n不得不继续下去咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "紐の結び方とか、\n一回じゃ覚えられなさ\nそう…。",
            "zh": "系带子的打法之类，\n感觉一次根本\n记不住……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "みやび",
            "text": "みんな苦労しちゅうよ。",
            "zh": "大家都在吃苦咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "…けんど、和服に興味ある\n言われたら協力せん\nわけにはいかんき――",
            "zh": "……但是，既然说了\n对和服有兴趣，\n就不能不帮啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "先生気分を\n楽しんじゅうきね。",
            "zh": "当老师的感觉，\n正享受着啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "いいんじゃない？",
            "zh": "不是挺好的嘛？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "和服って素敵だから、\nあたしも好きよ。",
            "zh": "和服很漂亮，\n我也喜欢哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんなら\nそう言うと思うちょった。",
            "zh": "加布的话，\n我料到会这么说啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "…ちゅうか。",
            "zh": "……说起来。",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "いや、気付いた\nことがあるんよ。\nちっくと待ちや。",
            "zh": "不，是有件事\n被我发现了咯。\n等子，别急。",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "相棒、今気づいたんやけんど",
            "zh": "搭档，我现在才发现咧",
            "narrator_zh": "雅"
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんが着物着たら、結構似合うと思わんちや？",
            "zh": "加布要是穿上和服，是不是会相当合适滴？",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "元が美少女やき、似合わんちゅうことはないと思うんよ",
            "zh": "底子是美少女嘛，我觉得不存在不合适的情况咯",
            "narrator_zh": "雅"
        },
        {
            "location": "73/SEL",
            "narrator": "",
            "text": "着付け教えてあげよう",
            "zh": "教她穿和服吧",
            "narrator_zh": ""
        },
        {
            "location": "74/SEL",
            "narrator": "",
            "text": "馬子にも衣装だ",
            "zh": "人靠衣装马靠鞍",
            "narrator_zh": ""
        },
        {
            "location": "75/SEL",
            "narrator": "",
            "text": "ガブちゃんには洋服だ！",
            "zh": "加布还是适合洋装！",
            "narrator_zh": ""
        },
        {
            "location": "76/ACT",
            "narrator": "",
            "text": "着付け教えてあげよう",
            "zh": "教她穿和服吧",
            "narrator_zh": ""
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "うん、そうするちや",
            "zh": "嗯，就这么办滴",
            "narrator_zh": "雅"
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "ついでにガブちゃんの和服姿も見れるしな",
            "zh": "顺便还能看到加布穿和服的样子呢",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんも着付け教室、\n来てみるが？",
            "zh": "加布要不要也来\n和服穿着教室试试？",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしはいいわ。",
            "zh": "我就不用了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "…珍しいなぁ。\nガブちゃんがこういうの\n断るなんて…。",
            "zh": "……真稀奇啊。\n加布居然会拒绝\n这种事……。",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、言ってなかった？\nあたし着付けなら\nできるのよ。",
            "zh": "哎呀，没说过吗？\n穿和服这种事\n我是会的哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "マジなが！？",
            "zh": "真的假的！？",
            "narrator_zh": "雅"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "マジって…本当よ。",
            "zh": "什么叫真的假的……是真的哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "和服って凄く綺麗だから、\n一人で着れるように\nなりたくて――",
            "zh": "和服特别漂亮，\n我想靠自己\n穿上它——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "日本に来る前に\n独学で勉強したのよ。",
            "zh": "来日本之前\n就自学过了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "そうやったか…。",
            "zh": "原来是这样啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ…それにほら、\n人に着せてもらうのって\nちょっと恥ずかしいし…。",
            "zh": "嗯……而且你看，\n让人帮忙穿什么的，\n有点难为情……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "偉いな、ガブちゃん。\nちっくと見直したがよ。",
            "zh": "了不起啊，加布。\n我有点重新看好你了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ…けど、やっぱり\n独学だから少し不安も\nあるの…。",
            "zh": "呵呵……不过，到底是\n自学，还是有点\n不安……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "そのうち、\n一度見てもらえる？",
            "zh": "之后，能不能\n请你帮我看一次？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "みやび",
            "text": "えいよ。\nガブちゃんのお手並み\n拝見するぞね。",
            "zh": "得。\n加布的手艺，\n我要好好领教咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "もう、プレッシャー\n掛けないでよ！",
            "zh": "真是的，别\n给我施加压力啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/ACT",
            "narrator": "",
            "text": "馬子にも衣装だ",
            "zh": "人靠衣装马靠鞍",
            "narrator_zh": ""
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "相棒、それはちっくと言い過ぎちや",
            "zh": "搭档，那话说得有点过头了滴",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "みやび",
            "text": "雰囲気は変わるやろうけんど、ガブちゃんは普通にしててもちゃんとしてるき",
            "zh": "气氛是会变，但是加布就算平常的样子也端端正正啵",
            "narrator_zh": "雅"
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "あんましそういうこと言うんは感心せんよ",
            "zh": "那种话少说，我不太欣赏哦",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "ガブリエラ",
            "text": "どうかした？",
            "zh": "怎么了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "何でもないちや…。\nしっかし、ガブちゃんが\n和服着るいうなら――",
            "zh": "没什么滴……。\n不过，既然加布要\n穿和服的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "うちが普段着てる\nミニの浴衣とかも\n似合いそうやね。",
            "zh": "我平常穿的那种\n短摆浴衣之类，\n感觉也会合适咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "144/TALK",
            "narrator": "ガブリエラ",
            "text": "あ～…\nみやびには悪いけど、\nあれは却下だわ。",
            "zh": "啊～……\n虽然对不住雅，\n那个否决了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "145/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、みやびに会うまで\nミニの浴衣があるなんて\n知らなかったから――",
            "zh": "在见到雅之前，\n我根本不知道还有\n短摆浴衣这种东西——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "146/TALK",
            "narrator": "ガブリエラ",
            "text": "浴衣イコール裾が長い、\nってイメージが強いのよ。",
            "zh": "浴衣就等于下摆很长，\n这个印象太深了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "147/TALK",
            "narrator": "みやび",
            "text": "わからんくはないな。\nうちも最初は同じこと\n考えちょったき。",
            "zh": "不是不能懂。\n我最初也是\n这么想着啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "けんど、一回着てみたら\n意外に着やすくてなぁ。",
            "zh": "但是，穿过一次之后\n意外地好穿得很呐。",
            "narrator_zh": "雅"
        },
        {
            "location": "150/TALK",
            "narrator": "ガブリエラ",
            "text": "う～ん…\nそうかもしれないけど…。",
            "zh": "唔～……\n也许是这样吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、あたしは\n普通のがいいわ。",
            "zh": "果然，我还是\n普通的好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "みやび",
            "text": "…一度くらい着てから\n言うてもらいたいんや\nけんどなぁ。",
            "zh": "……至少穿过一次\n再说这话\n才好呐。",
            "narrator_zh": "雅"
        },
        {
            "location": "153/ACT",
            "narrator": "",
            "text": "ガブちゃんは洋服だ！",
            "zh": "加布还是适合洋装！",
            "narrator_zh": ""
        },
        {
            "location": "155/TALK",
            "narrator": "みやび",
            "text": "…まあ、ガブちゃんは西洋人やし",
            "zh": "……嘛，加布是西洋人嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "みやび",
            "text": "そう思うんもわからんではない",
            "zh": "这么想也不是不能懂",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "…ガブちゃんの和服姿、\n想像できんしなぁ。",
            "zh": "……加布穿和服的样子，\n想象不出来啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "170/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびの前では\n着たことなかったっけ？",
            "zh": "在雅面前\n不是没穿过吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "171/TALK",
            "narrator": "ガブリエラ",
            "text": "一応、自分の浴衣は\n持ってるのよ？",
            "zh": "我自己的浴衣，\n还是有的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "そうやったが…\n浴衣かぁ…。",
            "zh": "原来是这样啊……\n浴衣啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "みやび",
            "text": "そういえば、前に浴衣着た\n美人の外国人さんを見たこと\nあったけんど……",
            "zh": "说起来，之前见过\n穿浴衣的外国美人\n来着……",
            "narrator_zh": "雅"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "あれは綺麗やったわぁ…。\n女のうちでも見惚れる\nほどやったき。",
            "zh": "那真是漂亮得很呐……。\n身为女的我都能\n看入迷啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふん、西洋人だって\n和服は似合うのよ。",
            "zh": "哼哼，西洋人穿和服\n也一样合适的哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "179/TALK",
            "narrator": "みやび",
            "text": "そうやね。",
            "zh": "是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "180/TALK",
            "narrator": "みやび",
            "text": "…ガブちゃんも、\nもうちっくと\n大人になって――",
            "zh": "……加布要是\n再成熟\n一点——",
            "narrator_zh": "雅"
        },
        {
            "location": "181/TALK",
            "narrator": "みやび",
            "text": "おしとやかになったら、\n和服の似合う美人に\nなりそうちや。",
            "zh": "变得端庄娴静的话，\n感觉会变成\n穿和服合适的美人滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "183/TALK",
            "narrator": "ガブリエラ",
            "text": "…褒められてるんだか\n貶されてるんだか、\nすっごい微妙なんだけど？",
            "zh": "……这是在夸我\n还是在贬我，\n超级微妙的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "みやび",
            "text": "冗談やって。\n今でも着てるとこ見たら、\nきっと似合う思うよ。",
            "zh": "开玩笑的咯。\n现在穿起来的样子，\n我觉得肯定合适哦。",
