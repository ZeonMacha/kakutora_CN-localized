        },
        {
            "location": "101/TALK",
            "narrator": "つばめ",
            "text": "ぅんぅん",
            "zh": "嗯嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "102/TALK",
            "narrator": "つばめ",
            "text": "絶対そう言ってくれるって思ってたょ",
