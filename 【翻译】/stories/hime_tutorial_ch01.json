        },
        {
            "location": "104/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんと",
            "zh": "和$handle$",
            "narrator_zh": "燕"
        },
        {
            "location": "105/TALK",
            "narrator": "つばめ",
            "text": "行きたぃんだ(´I `*)",
            "zh": "我想去(´I `*)",
            "narrator_zh": "燕"
        },
        {
            "location": "106/TALK",
            "narrator": "つばめ",
            "text": "二人きりで　←　ここ大事",
            "zh": "就两个人　←　这里很重要",
            "narrator_zh": "燕"
        },
        {
            "location": "107/TALK",
            "narrator": "つばめ",
            "text": "ヾ(*´ｴ`*)ﾉ ｲｯﾁｬｯﾀ",
            "zh": "ヾ(*´ｴ`*)ﾉ 说出来啦",
            "narrator_zh": "燕"
        },
        {
            "location": "58/DIALOG",
            "narrator": "Tutorial/Dialog_Tutorial_Candy",
            "text": "彼女たちとの会話では\n<color=red>【ココロキャンディ】</color>という\nものを消費して先へ進む。\n\n足りない場合、ジュエルで買うか、\nバトル等で貯めてからストーリーを\n再挑戦することになるから注意。\n\n<color=green>今回だけは使っても減らないから、\n好きな選択肢を選んでみて。</color>",
            "zh": "和她们聊天时，\n会消耗<color=red>【心之糖果】</color>，\n才能继续往下。\n\n不够的话，就用珠宝买，\n或者靠战斗之类攒够，\n再重打这段剧情。注意。\n\n<color=green>只有这一次，用了也不会减少，\n挑你想选的就行。</color>",
            "narrator_zh": "Tutorial/Dialog_Tutorial_Candy"
        },
        {
            "location": "75/DIALOG",
            "narrator": "Tutorial/Dialog_Tutorial_Love2",
            "text": "<color=red>【親密度】</color>を沢山貯めると\n彼女との関係性が変化していく。\n\n<color=green>【友達】</color>になり<color=orange>【恋人】</color>になり…\n更にその先まで発展するかも。\n頑張ってハートを集めて欲しい。\n\n集めたハートは<color=red>【PROFILE】</color>で\n確認できるわ。",
            "zh": "<color=red>【亲密度】</color>攒得多了，\n和她的关系就会变化。\n\n会变成<color=green>【朋友】</color>，再变成<color=orange>【恋人】</color>……\n也许还能再往前走。\n好好把爱心攒起来吧。\n\n攒下的爱心，在<color=red>【PROFILE】</color>\n里就能看到。",
            "narrator_zh": "Tutorial/Dialog_Tutorial_Love2"
        },
        {
            "location": "85/DIALOG",
            "narrator": "Tutorial/Dialog_Tutorial_Camera",
            "text": "そうそう、ひとつお得情報。\n<color=red>カメラボタンを押すことで、\n彼女を見守る視点を変えられる。</color>\n\n今回はお試しでカメラを５つ\n用意しておいた。\n実際には<color=green>ゴキゲンポイント</color>で\n交換して増やしていくことに\nなるから、今のうちにいっぱい\n堪能しておくといいと思う。",
            "zh": "对了，告诉你一件有用的。\n<color=red>按下相机按钮，\n就能换一个看着她的视角。</color>\n\n这次试用，准备了5个\n相机。\n实际上要用<color=green>心情点数</color>\n来兑换，再慢慢增加。\n所以趁现在，\n多看个够就好。",
            "narrator_zh": "Tutorial/Dialog_Tutorial_Camera"
        }
    ]
