        "sub_title_zh": "教程副篇"
    },
    "entry": [
        {
            "location": "5/SCENARIO",
            "narrator": "",
            "text": "チュートリアルサブ",
            "zh": "教程副篇",
            "narrator_zh": ""
        },
        {
            "location": "8/SEL",
            "narrator": "",
            "text": "深層世界って？",
            "zh": "深层世界是什么？",
            "narrator_zh": ""
        },
        {
            "location": "9/SEL",
            "narrator": "",
            "text": "ここもココロスフィア？",
            "zh": "这里也是心灵领域吗？",
            "narrator_zh": ""
        },
        {
            "location": "10/ACT",
            "narrator": "",
            "text": "深層世界って？",
            "zh": "深层世界是什么？",
            "narrator_zh": ""
        },
        {
            "location": "11/TALK",
            "narrator": "千羽鶴",
            "text": "その名の通り、心の深層に\nある、本人も気づいて\nいない意識の世界。",
            "zh": "顾名思义，就是位于\n心灵深处、连本人\n也没察觉到的意识世界。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "12/ACT",
            "narrator": "",
            "text": "ここもココロスフィア？",
            "zh": "这里也是心灵领域吗？",
            "narrator_zh": ""
        },
        {
            "location": "13/TALK",
            "narrator": "千羽鶴",
            "text": "そう。\nココロココモスフィア。",
            "zh": "是的。\n心领这里灵领域。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "15/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "16/TALK",
            "narrator": "千羽鶴",
            "text": "ココも[ココロスフィア]…。",
            "zh": "这里也是[心灵领域]……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "17/SEL",
            "narrator": "",
            "text": "もしかして噛んだ？",
            "zh": "你刚才是不是嘴瓢了？",
            "narrator_zh": ""
        },
        {
            "location": "18/ACT",
            "narrator": "",
            "text": "もしかして噛んだ？",
            "zh": "你刚才是不是嘴瓢了？",
            "narrator_zh": ""
        },
        {
            "location": "21/TALK",
            "narrator": "千羽鶴",
            "text": "……いいえ。",
            "zh": "……没有。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "22/SEL",
            "narrator": "",
            "text": "いやいやそんなことないでしょ",
            "zh": "不不，绝对没有嘴瓢吧",
            "narrator_zh": ""
        },
        {
            "location": "23/ACT",
            "narrator": "",
            "text": "いやいやそんなことないでしょ",
            "zh": "不不，绝对没有嘴瓢吧",
            "narrator_zh": ""
        },
        {
            "location": "25/TALK",
            "narrator": "千羽鶴",
            "text": "ちょっと韻を踏んだだけ。",
            "zh": "只是稍微押了个韵。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "26/TALK",
            "narrator": "千羽鶴",
            "text": "貴方にはその高度な\n洒落ッ気がわからないのね。",
            "zh": "你果然体会不到这种\n高级的文字幽默。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "27/SEL",
            "narrator": "",
            "text": "そうなんだ",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "28/SEL",
            "narrator": "",
            "text": "ココロココモちはるちゃんかわいい",
            "zh": "心领这里灵小千真可爱",
            "narrator_zh": ""
        },
        {
            "location": "29/ACT",
            "narrator": "",
            "text": "そうなんだ",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "30/TALK",
            "narrator": "千羽鶴",
            "text": "そうなの。",
            "zh": "就是这样。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "31/ACT",
            "narrator": "",
            "text": "ココロココモちはるちゃんかわいい",
            "zh": "心领这里灵小千真可爱",
            "narrator_zh": ""
        },
        {
            "location": "32/TALK",
            "narrator": "千羽鶴",
            "text": "うるさい！",
            "zh": "吵死了！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "33/TALK",
            "narrator": "千羽鶴",
            "text": "まったく、貴方のせいで\n本題が全然進まない。",
            "zh": "真是的，全拜你所赐，\n正题完全推进不下去。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "35/TALK",
            "narrator": "千羽鶴",
            "text": "とにかく、\nここは$fullname$の\n深層世界。",
            "zh": "总之，\n这里是$fullname$的\n深层世界。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "37/TALK",
            "narrator": "千羽鶴",
            "text": "この世界で見聞きする\nものは、そのすべてが\n彼女の真実。",
            "zh": "在这个世界里所见所闻\n的一切，全都是\n她的真实。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "38/TALK",
            "narrator": "千羽鶴",
            "text": "心の奥底は\n絶対に嘘をつかないから、\nそれだけは絶対言える。",
            "zh": "内心最深处绝对\n不会说谎，\n唯有这一点可以肯定。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "39/TALK",
            "narrator": "千羽鶴",
            "text": "けど、日々を生きる\n彼女たちには、それは\nわからない。",
            "zh": "不过，活在日常里的\n她们自己，并不知道\n这些事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "40/TALK",
            "narrator": "千羽鶴",
            "text": "もしくは、しらばっくれて\n嘘をつくかもしれない。",
            "zh": "又或者，说不定还会\n装傻撒谎。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "41/TALK",
            "narrator": "千羽鶴",
            "text": "だから、この世界で\n見聞きしたことに対し、\n彼女が否定したとしても―",
            "zh": "所以，对于你在这个世界\n所见所闻的一切，\n就算她矢口否认——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "42/TALK",
            "narrator": "千羽鶴",
            "text": "それは恥ずかしがってたり\nしてるだけだから、そこは\n暖かく見守ってあげて。",
            "zh": "那也只是因为她在害羞，\n这一点还请你\n温柔地守护着她吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "43/SEL",
            "narrator": "",
            "text": "でも、どうして$me$が深層世界を見られるようになってるの？",
            "zh": "可是，为什么$me$能看到深层世界呀？",
            "narrator_zh": ""
        },
        {
            "location": "44/ACT",
            "narrator": "",
            "text": "でも、どうして$me$が深層世界を見られるようになってるの？",
            "zh": "可是，为什么$me$能看到深层世界呀？",
            "narrator_zh": ""
        },
        {
            "location": "46/TALK",
            "narrator": "千羽鶴",
            "text": "前にも言ったとおり、\n貴方には彼女をより深く\n支えて欲しいから。",
            "zh": "就像我之前说过的，\n因为我希望你能更深入地\n支撑着她。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "47/TALK",
            "narrator": "千羽鶴",
            "text": "普段からも、貴方には\n彼女の心の中で、葛藤を\n駆逐してもらってる。",
            "zh": "平时我也一直在\n让你帮忙驱逐\n她心里的纠葛。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "48/TALK",
            "narrator": "千羽鶴",
            "text": "けど、やはり\nそれだけでは不十分。",
            "zh": "可是，果然\n光那样还不够。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "49/TALK",
            "narrator": "千羽鶴",
            "text": "例えるなら、風邪をひいた\n彼女に、熱冷ましの薬を\n与えているに過ぎない。",
            "zh": "打个比方，那不过是\n给感冒的她喂下\n退烧药而已。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "50/TALK",
            "narrator": "千羽鶴",
            "text": "炎症を対処的に改善してる\nだけで、決して根本的な\n解決にはなってないの。",
            "zh": "只是在对症缓解发炎，\n绝对算不上\n根本性的解决。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "51/TALK",
            "narrator": "千羽鶴",
            "text": "翻し、この深層世界では、\n彼女の悩み、葛藤、怯えの\n根本を解決できる。",
            "zh": "相对地，在这深层世界里，\n能够从根源上解决\n她的烦恼、纠葛与怯懦。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "52/TALK",
            "narrator": "千羽鶴",
            "text": "そして貴方は、この世界に\n入り、彼女の深層意識と\n対話することができるの。",
            "zh": "而你能够进入这个世界，\n去和她的深层意识\n直接对话。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "53/TALK",
            "narrator": "千羽鶴",
            "text": "ここまで、いい？",
            "zh": "讲到这里，明白吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "54/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "明白",
            "narrator_zh": ""
        },
        {
            "location": "55/SEL",
            "narrator": "",
            "text": "なんか大変そう",
            "zh": "总觉得好像很麻烦",
            "narrator_zh": ""
        },
        {
            "location": "56/SEL",
            "narrator": "",
            "text": "それって今度こそガチの洗脳では…",
            "zh": "那这次不会真成货真价实的洗脑了吧……",
            "narrator_zh": ""
        },
        {
            "location": "57/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "明白",
            "narrator_zh": ""
        },
        {
            "location": "58/TALK",
            "narrator": "千羽鶴",
            "text": "よかった。",
            "zh": "那就好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "59/ACT",
            "narrator": "",
            "text": "なんか大変そう",
            "zh": "总觉得好像很麻烦",
            "narrator_zh": ""
        },
        {
            "location": "60/TALK",
            "narrator": "千羽鶴",
            "text": "もちろん大変。",
            "zh": "当然麻烦。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "61/TALK",
            "narrator": "千羽鶴",
            "text": "ココロの中の彼女は、\n現実と違って容赦ない。",
            "zh": "心里的她，和现实\n不同，是不会手下留情的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "62/TALK",
            "narrator": "千羽鶴",
            "text": "遠慮もない。\n自制することもない。\n時として恥じらいもない。",
            "zh": "不会客气。\n也不会自制。\n有时候甚至毫无羞耻心。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "63/TALK",
            "narrator": "千羽鶴",
            "text": "だから、場合によっては\n貴方も何らかの精神的\n被害を被るかもしれない。",
            "zh": "所以，弄不好\n你也会受到某种\n精神上的伤害。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "64/SEL",
            "narrator": "",
            "text": "なにそれ怖い",
            "zh": "什么啊好可怕",
            "narrator_zh": ""
        },
        {
            "location": "65/SEL",
            "narrator": "",
            "text": "ご褒美戴きました！",
            "zh": "多谢赏赐奖励！",
            "narrator_zh": ""
        },
        {
            "location": "66/ACT",
            "narrator": "",
            "text": "なにそれ怖い",
            "zh": "什么啊好可怕",
            "narrator_zh": ""
        },
        {
            "location": "67/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。\n人の本心に関わるって\nそういうこと。",
            "zh": "是啊。\n触碰别人的本心\n就是这么一回事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "68/TALK",
            "narrator": "千羽鶴",
            "text": "だから、この世界に\n関わることを、私は\n強制はしない。",
            "zh": "所以，要不要牵涉进\n这个世界，我不会\n强迫你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "69/TALK",
            "narrator": "千羽鶴",
            "text": "やりたくなければ\nやらなくても大丈夫。",
            "zh": "如果不愿意的话，\n不做也没关系。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "70/TALK",
            "narrator": "千羽鶴",
            "text": "すぐに現実に戻って、\n普段の彼女と関わるのが\nいいと思う。",
            "zh": "立刻回到现实，\n和平时的她相处，\n我觉得也挺好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "71/ACT",
            "narrator": "",
            "text": "ご褒美戴きました！",
            "zh": "多谢赏赐奖励！",
            "narrator_zh": ""
        },
        {
            "location": "72/TALK",
            "narrator": "千羽鶴",
            "text": "あなた、ドエムッ子？",
            "zh": "你该不会是个抖M吧？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "73/TALK",
            "narrator": "千羽鶴",
            "text": "やーい、\n$handle$は\nドエムッ子ー。",
            "zh": "略略略，\n$handle$是\n个大抖M——。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "75/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "77/TALK",
            "narrator": "千羽鶴",
            "text": "気が済んだ。",
            "zh": "我心里痛快了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "79/ACT",
            "narrator": "",
            "text": "それって今度こそガチの洗脳では…",
            "zh": "那这次不会真成货真价实的洗脑了吧……",
            "narrator_zh": ""
        },
        {
            "location": "80/TALK",
            "narrator": "千羽鶴",
            "text": "んー",
            "zh": "嗯——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "81/TALK",
            "narrator": "千羽鶴",
            "text": "まあ、貴方がそう思うなら\nそうなんでしょう。",
            "zh": "嘛，既然你这么想，\n那大概就是那样吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "82/TALK",
            "narrator": "千羽鶴",
            "text": "だって、彼女の心の中で\n何をして、どうなりたいか\n決めるのは全部貴方だもの。",
            "zh": "毕竟，在她心里\n要做什么、想变成怎样，\n全都是由你决定的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "83/TALK",
            "narrator": "千羽鶴",
            "text": "私はこの\n深層世界へのダイブを\n強制するつもりはない。",
            "zh": "我并不打算\n强迫你潜入\n这个深层世界。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "84/TALK",
            "narrator": "千羽鶴",
            "text": "どう解釈しても洗脳にしか\nならない、それが嫌という\nなら、やらなくてもいい。",
            "zh": "不管怎么理解都只能算\n洗脑，如果讨厌那样的话，\n不做也没关系。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "85/TALK",
            "narrator": "千羽鶴",
            "text": "要は、\n貴方が心の中に入って\n彼女に何を与えたいか。",
            "zh": "关键在于，\n你进入她的内心之后，\n想给予她什么。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "86/TALK",
            "narrator": "千羽鶴",
            "text": "それ次第では、ガチな\n洗脳にもなるし、彼女の\n心の支えにもなる。",
            "zh": "全看这一点，它既能变成\n货真价实的洗脑，也能成为\n她的心灵支柱。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "87/TALK",
            "narrator": "千羽鶴",
            "text": "これが私の\n正直な回答ね。",
            "zh": "这就是我\n坦率的回答了。",
            "narrator_zh": "千羽鹤"
        }
    ]
}
