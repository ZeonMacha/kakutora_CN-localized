   "location": "588/TALK",
   "narrator": "つばめ",
   "text": "あれがちょっと\nココロ会議で\n問題になっちゃって……",
   "zh": "那件事在\n心之会议上\n出了点问题……",
   "narrator_zh": "燕"
  },
  {
   "location": "589/TALK",
   "narrator": "つばめ",
   "text": "ココロの司書を\n辞めることになりました。",
   "zh": "我要辞去\n心之司书了。",
   "narrator_zh": "燕"
  },
  {
   "location": "590/SEL",
   "narrator": "",
   "text": "更迭！？",
   "zh": "更迭！？",
   "narrator_zh": ""
  },
  {
   "location": "591/ACT",
   "narrator": "",
   "text": "更迭！？",
   "zh": "更迭！？",
   "narrator_zh": ""
  },
  {
   "location": "594/TALK",
   "narrator": "つばめ",
   "text": "ま、まあ\nそういうことに\nなりますかね。",
   "zh": "也、也就\n算是这么\n回事吧。",
   "narrator_zh": "燕"
  },
  {
   "location": "595/SEL",
   "narrator": "",
   "text": "嫌な予感はしてた",
   "zh": "我就有不好的预感",
   "narrator_zh": ""
  },
  {
   "location": "596/SEL",
   "narrator": "",
   "text": "…ごめんなさい。",
   "zh": "……对不起。",
   "narrator_zh": ""
  },
  {
   "location": "597/ACT",
   "narrator": "",
   "text": "嫌な予感はしてた",
   "zh": "我就有不好的预感",
   "narrator_zh": ""
  },
  {
   "location": "599/TALK",
   "narrator": "つばめ",
   "text": "まあ仕方ないですよ。\n自業自得です。",
   "zh": "这也没办法呀。\n是我自作自受。",
   "narrator_zh": "燕"
  },
  {
   "location": "600/ACT",
   "narrator": "",
   "text": "…ごめんなさい。",
   "zh": "……对不起。",
   "narrator_zh": ""
  },
  {
   "location": "601/TALK",
   "narrator": "つばめ",
   "text": "ええっ！\n$handle$さんは\n悪くないですよ？",
   "zh": "诶诶！\n$handle$\n没有错呀？",
   "narrator_zh": "燕"
  },
  {
   "location": "602/TALK",
   "narrator": "つばめ",
   "text": "全部わたしが\nお願いしたことですから。",
   "zh": "全是我\n拜托你做的。",
   "narrator_zh": "燕"
  },
  {
   "location": "604/SEL",
   "narrator": "",
   "text": "元気でね！",
   "zh": "多保重！",
   "narrator_zh": ""
  },
  {
   "location": "605/SEL",
   "narrator": "",
   "text": "もう会えないの？",
   "zh": "再也见不到了吗？",
   "narrator_zh": ""
  },
  {
   "location": "606/ACT",
   "narrator": "",
   "text": "元気でね！",
   "zh": "多保重！",
   "narrator_zh": ""
  },
  {
   "location": "607/TALK",
   "narrator": "つばめ",
   "text": "はい！\n$handle$さんも\nお元気で！",
   "zh": "好！\n$handle$也\n请多保重！",
   "narrator_zh": "燕"
  },
  {
   "location": "608/TALK",
   "narrator": "つばめ",
   "text": "これからも末永く\nわたしのことを\nお願いします！",
   "zh": "以后也请长久地\n关照我\n呀！",
   "narrator_zh": "燕"
  },
  {
   "location": "609/ACT",
   "narrator": "",
   "text": "もう会えないの？",
   "zh": "再也见不到了吗？",
   "narrator_zh": ""
  },
  {
   "location": "610/TALK",
   "narrator": "つばめ",
   "text": "どうでしょうか。",
   "zh": "这就不好说了。",
   "narrator_zh": "燕"
  },
  {
   "location": "611/TALK",
   "narrator": "つばめ",
   "text": "$handle$さんが\n今度もわたしのココロに\n関わるかどうかですよね。",
   "zh": "要看$handle$\n以后还管不管\n我的心。",
   "narrator_zh": "燕"
  },
  {
   "location": "612/TALK",
   "narrator": "つばめ",
   "text": "まあ、再会しても\nわたしだってわかるか\nどうかはわかりませんが。",
   "zh": "就算再见面，\n你认不认得出\n是我，也不好说。",
   "narrator_zh": "燕"
  },
  {
   "location": "613/SEL",
   "narrator": "",
   "text": "確かに見た目が同じだもんね",
   "zh": "外表确实一样呀",
   "narrator_zh": ""
  },
  {
   "location": "614/SEL",
   "narrator": "",
   "text": "人格には名前って無いの？",
   "zh": "人格没有名字吗？",
   "narrator_zh": ""
  },
  {
   "location": "615/ACT",
   "narrator": "",
   "text": "確かに見た目が同じだもんね",
   "zh": "外表确实一样呀",
   "narrator_zh": ""
  },
  {
   "location": "616/TALK",
   "narrator": "つばめ",
   "text": "そうですね。\n正気を保っていられる\nうちは、ですけど。",
   "zh": "是呀。\n在还能保持神智的\n时候，是这样。",
   "narrator_zh": "燕"
  },
  {
   "location": "617/ACT",
   "narrator": "",
   "text": "人格には名前って無いの？",
   "zh": "人格没有名字吗？",
   "narrator_zh": ""
  },
  {
   "location": "618/TALK",
   "narrator": "つばめ",
   "text": "んー、無いことは\n無いんですけど……",
   "zh": "嗯，也不是\n完全没有……",
   "narrator_zh": "燕"
  },
  {
   "location": "619/SEL",
   "narrator": "",
   "text": "名前教えて！",
   "zh": "告诉我名字！",
   "narrator_zh": ""
  },
  {
   "location": "620/ACT",
   "narrator": "",
   "text": "名前教えて！",
   "zh": "告诉我名字！",
   "narrator_zh": ""
  },
  {
   "location": "622/TALK",
   "narrator": "つばめ",
   "text": "ええっ！？\nな、なんだか\n恥ずかしいですね。",
   "zh": "诶诶！？\n总、总觉得\n有点害羞呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "623/TALK",
   "narrator": "つばめ",
   "text": "でも確かに、名刺も\nありませんし、せめて\n名前くらいは……。",
   "zh": "可是名片\n也没有，至少\n名字……。",
   "narrator_zh": "燕"
  },
  {
   "location": "625/TALK",
   "narrator": "つばめ",
   "text": "わたしの名前は\n『カレン』と申します。",
   "zh": "我的名字\n叫『卡莲』。",
   "narrator_zh": "燕"
  },
  {
   "location": "626/TALK",
   "narrator": "つばめ",
   "text": "本当はもっと長い名前\nなんですけど、普段使い\nするものではないので。",
   "zh": "其实还有更长的名字，\n不过不是平时\n用的。",
   "narrator_zh": "燕"
  },
  {
   "location": "627/TALK",
   "narrator": "つばめ",
   "text": "でも、お別れの時に\n名前を伝えるなんて、\nちょっと滑稽でしたね。",
   "zh": "可是，到了分别才\n告诉名字，\n有点滑稽呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "629/TALK",
   "narrator": "つばめ",
   "text": "もっと早くに\n伝えておけば\nよかったです。",
   "zh": "要是早点\n告诉你\n就好了。",
   "narrator_zh": "燕"
  },
  {
   "location": "633/TALK",
   "narrator": "つばめ",
   "text": "それじゃ、最後の\n司書の仕事をさせて\nいただきますね！",
   "zh": "那么，请让我做\n最后一次\n司书的工作！",
   "narrator_zh": "燕"
  },
  {
   "location": "635/TALK",
   "narrator": "つばめ",
   "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！",
   "zh": "献给$handle$和\n我的，\n美妙的心灵之旅！",
   "narrator_zh": "燕"
  },
  {
   "location": "646/TALK",
   "narrator": "つばめ",
   "text": "……。",
   "zh": "……。",
   "narrator_zh": "燕"
  },
  {
   "location": "647/TALK",
   "narrator": "つばめ",
   "text": "どうか、\nお元気で……。",
   "zh": "请一定，\n多保重……。",
   "narrator_zh": "燕"
  },
  {
