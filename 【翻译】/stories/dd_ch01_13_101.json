   "location": "423/TALK",
   "narrator": "つばめ",
   "text": "わたし、こう見えても、\nガードは堅いんです！",
   "zh": "我看着这样，\n防备可是很严的！",
   "narrator_zh": "燕"
  },
  {
   "location": "424/SEL",
   "narrator": "",
   "text": "お、おう……",
   "zh": "哦、哦……",
   "narrator_zh": ""
  },
  {
   "location": "425/ACT",
   "narrator": "",
   "text": "お、おう……",
   "zh": "哦、哦……",
   "narrator_zh": ""
  },
  {
   "location": "427/TALK",
   "narrator": "つばめ",
   "text": "？？",
   "zh": "？？",
   "narrator_zh": "燕"
  },
  {
   "location": "428/ACT",
   "narrator": "",
   "text": "…悪い虫がつかないように$me$が一生守らなければ！",
