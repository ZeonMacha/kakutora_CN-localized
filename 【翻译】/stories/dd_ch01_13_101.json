{
 "dir": "chap13/daydra/dd_ch01_13_101.js",
 "type": "MainStory",
 "info": {
  "story_id": "13102",
  "cid": "tsubame",
  "title": "002 メインストーリー",
  "sub_title": "魔法少女道＜前編＞",
  "title_zh": "002 主线剧情",
  "sub_title_zh": "魔法少女道＜前篇＞"
 },
 "entry": [
  {
   "location": "8/SCENARIO",
   "narrator": "",
   "text": "魔法少女道",
   "zh": "魔法少女道",
   "narrator_zh": ""
  },
  {
   "location": "43/TALK",
   "narrator": "つばめ",
   "text": "す、すみません！\n遅くなりました！",
   "zh": "对、对不起！\n我来晚了！",
   "narrator_zh": "燕"
  },
  {
   "location": "45/TALK",
   "narrator": "神楽",
   "text": "真幌さん、\n他の皆さんは？",
   "zh": "真幌，\n其他人都在哪？",
   "narrator_zh": "神乐"
  },
  {
   "location": "47/TALK",
   "narrator": "真幌",
   "text": "既に出発して、\nそろそろ現場に\n到着する頃だ。",
   "zh": "已经出发了，\n差不多该到\n现场了。",
   "narrator_zh": "真幌"
  },
  {
   "location": "48/TALK",
   "narrator": "真幌",
   "text": "表に迎えの車が\n来ているはずだ。",
   "zh": "外面应该有\n来接的车。",
   "narrator_zh": "真幌"
  },
  {
   "location": "49/TALK",
   "narrator": "真幌",
   "text": "二人とも、至急現場に\n向かってくれ。",
   "zh": "你们两个，马上\n赶去现场。",
   "narrator_zh": "真幌"
  },
  {
   "location": "51/TALK",
   "narrator": "つばめ",
   "text": "は、はい！",
   "zh": "是、是！",
   "narrator_zh": "燕"
  },
  {
   "location": "53/TALK",
   "narrator": "神楽",
   "text": "了解です！",
   "zh": "明白！",
   "narrator_zh": "神乐"
  },
  {
   "location": "85/TALK",
   "narrator": "つばめ",
   "text": "…アーヤさん達、\n大丈夫かな？",
   "zh": "……绫水她们，\n不要紧吧？",
   "narrator_zh": "燕"
  },
  {
   "location": "87/TALK",
   "narrator": "神楽",
   "text": "大丈夫ですよ。\n皆さん、とっても\n強いですから。",
   "zh": "不要紧的。\n大家都很\n强。",
   "narrator_zh": "神乐"
  },
  {
   "location": "89/TALK",
   "narrator": "神楽",
   "text": "心配なら、通信だけ\n繋げておきましょう。",
   "zh": "要是担心，就先把\n通讯连上吧。",
   "narrator_zh": "神乐"
  },
  {
   "location": "93/TALK",
   "narrator": "透明真幌",
   "text": "解析の結果が出た。\nクリア条件を教える。",
   "zh": "解析结果出来了。\n告诉你们通关条件。",
   "narrator_zh": "透明真幌"
  },
  {
   "location": "94/TALK",
   "narrator": "透明みやび",
   "text": "まほさん、\nナイスタイミングや！",
   "zh": "真幌，\n来得正好咯！",
   "narrator_zh": "透明雅"
  },
  {
   "location": "95/TALK",
   "narrator": "透明アーヤ",
   "text": "それで、\nクリア条件は？",
   "zh": "那么，\n通关条件是？",
   "narrator_zh": "透明绫水"
  },
  {
   "location": "96/TALK",
   "narrator": "透明真幌",
   "text": "アップルティメルティと\nミルクティメルティーだ。",
   "zh": "苹果茶融化和\n奶茶融化。",
   "narrator_zh": "透明真幌"
  },
  {
   "location": "98/TALK",
   "narrator": "つばめ",
   "text": "…メルティ？\n何のことかな？",
   "zh": "……融化？\n是什么意思呀？",
   "narrator_zh": "燕"
  },
  {
   "location": "100/TALK",
   "narrator": "神楽",
   "text": "ちょ、まさか！！",
   "zh": "等、难道！！",
   "narrator_zh": "神乐"
  },
  {
   "location": "101/TALK",
   "narrator": "透明真幌",
   "text": "その世界は、アニメの\n世界が元になっている\nようだ。",
   "zh": "那个世界，好像是\n以动画的世界\n为蓝本。",
   "narrator_zh": "透明真幌"
  },
  {
   "location": "102/TALK",
   "narrator": "透明真幌",
   "text": "えーっと…魔法少女、\nトリプルメルティーズ？",
   "zh": "那个……魔法少女，\n三重融化？",
   "narrator_zh": "透明真幌"
  },
  {
   "location": "103/TALK",
   "narrator": "透明真幌",
   "text": "…そういうことだ。",
   "zh": "……就是这么回事。",
   "narrator_zh": "透明真幌"
  },
  {
   "location": "104/TALK",
   "narrator": "神楽",
   "text": "あああっ！！\nやっぱり！！",
   "zh": "啊啊啊！！\n果然！！",
   "narrator_zh": "神乐"
  },
  {
   "location": "107/TALK",
   "narrator": "つばめ",
   "text": "ど、どうしたの\n卯月さん？",
   "zh": "怎、怎么了，\n卯月？",
   "narrator_zh": "燕"
  },
  {
   "location": "110/TALK",
   "narrator": "神楽",
   "text": "アニメです！\nトリプルメルティーズ\nですよ！",
   "zh": "是动画！\n是三重融化\n呀！",
   "narrator_zh": "神乐"
  },
  {
   "location": "111/TALK",
   "narrator": "神楽",
   "text": "つばめさんは\n知らないんですか？",
   "zh": "燕\n不知道吗？",
   "narrator_zh": "神乐"
  },
  {
   "location": "113/TALK",
   "narrator": "つばめ",
   "text": "う、うん…。\nそんなアニメが\nあるんだね？",
   "zh": "嗯、嗯……。\n还有这种动画\n呀？",
   "narrator_zh": "燕"
  },
  {
   "location": "115/TALK",
   "narrator": "つばめ",
   "text": "でも、それが今回の\nフェノメノンと、\nどんな関係が？",
   "zh": "不过，它和这次的\nPhenoMENON，\n有什么关系？",
   "narrator_zh": "燕"
  },
  {
   "location": "116/TALK",
   "narrator": "透明真幌",
   "text": "つまりだな、その\nスウィーティ―って奴には\n２人の仲間がいるらしい。",
   "zh": "就是说，那个\n叫甜甜的家伙，\n好像有两个伙伴。",
   "narrator_zh": "透明真幌"
  },
  {
   "location": "117/TALK",
   "narrator": "透明真幌",
   "text": "アップルティーと\nミルクティーという\nヤツがな。",
   "zh": "叫苹果茶和\n奶茶的\n那两个。",
   "narrator_zh": "透明真幌"
  },
  {
   "location": "118/TALK",
   "narrator": "透明真幌",
   "text": "なので、おまえ達が\nその二人になって、共に\n敵を倒すことになるな。",
   "zh": "所以，你们要\n变成那两个人，一起\n把敌人打倒。",
   "narrator_zh": "透明真幌"
  },
  {
   "location": "119/TALK",
   "narrator": "透明真幌",
   "text": "スウィーティ―って\nヤツと一緒に、\nその怪物を討て。",
   "zh": "和那个叫甜甜的\n家伙一起，\n讨伐那只怪物。",
   "narrator_zh": "透明真幌"
  },
  {
   "location": "120/TALK",
   "narrator": "透明アーヤ",
   "text": "…まさか、それが\nクリア条件ですか？",
   "zh": "……难道，这就是\n通关条件吗？",
   "narrator_zh": "透明绫水"
  },
  {
   "location": "121/TALK",
   "narrator": "透明真幌",
   "text": "そういうことだ。",
   "zh": "就是这么回事。",
   "narrator_zh": "透明真幌"
  },
  {
   "location": "123/TALK",
   "narrator": "神楽",
   "text": "やっぱり！",
   "zh": "果然！",
   "narrator_zh": "神乐"
  },
  {
   "location": "124/TALK",
   "narrator": "透明みやび",
   "text": "…で？\n誰がやるがよ？",
   "zh": "……然后？\n谁来做啵？",
   "narrator_zh": "透明雅"
  },
  {
   "location": "125/TALK",
   "narrator": "透明ガブリエラ",
   "text": "私パス。\nアーヤとみやびで\nやりなさいよ。",
   "zh": "我跳过。\n让绫水和雅\n去做。",
   "narrator_zh": "透明加布里埃拉"
  },
  {
   "location": "126/TALK",
   "narrator": "透明みやび",
   "text": "グリーンティー\nメルティがいるなら\nえいんやけんど。",
   "zh": "要是有绿茶\n融化，那倒要得，\n不过。",
   "narrator_zh": "透明雅"
  },
  {
   "location": "127/TALK",
   "narrator": "透明みやび",
   "text": "アップルティ―と\nミルクティ―はパスや。",
   "zh": "苹果茶和\n奶茶我就跳过咯。",
   "narrator_zh": "透明雅"
  },
  {
   "location": "128/TALK",
   "narrator": "透明アーヤ",
   "text": "グリーンティー\nなんているの？",
   "zh": "还有绿茶\n这种角色吗？",
   "narrator_zh": "透明绫水"
  },
  {
   "location": "129/TALK",
   "narrator": "透明みやび",
   "text": "知らんけんど、\nうちは緑茶好きやきね。",
   "zh": "不晓得，不过\n我喜欢绿茶啵。",
   "narrator_zh": "透明雅"
  },
  {
   "location": "130/TALK",
   "narrator": "透明ガブリエラ",
   "text": "お茶の好みの話を\nしてるんじゃない\nでしょ！？",
   "zh": "现在不是在聊\n喝茶的喜好\n吧！？",
   "narrator_zh": "透明加布里埃拉"
  },
  {
   "location": "131/TALK",
   "narrator": "つばめ",
   "text": "…な、なんか、\nすごい揉めてる\nみたいだね。",
   "zh": "……怎、怎么感觉，\n吵得很厉害\n呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "133/TALK",
   "narrator": "神楽",
   "text": "悔しいです。\n私とつばめさんが\nいれば――",
   "zh": "好不甘心。\n要是有我和燕\n在的话——",
   "narrator_zh": "神乐"
  },
  {
   "location": "134/TALK",
   "narrator": "神楽",
   "text": "今回はあっという間に\n収束できたのに…。",
   "zh": "这次一下子就能\n收敛了……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "136/TALK",
   "narrator": "つばめ",
   "text": "そうなのかなぁ？\nわたし、そのアニメ\n全然知らないんだけど…。",
   "zh": "是这样吗？\n那个动画，我\n完全不认识……。",
   "narrator_zh": "燕"
  },
  {
   "location": "138/TALK",
   "narrator": "神楽",
   "text": "大人気の王道\n魔法少女アニメ\nですよ！？",
   "zh": "是超有人气的正统\n魔法少女动画\n呀！？",
   "narrator_zh": "神乐"
  },
  {
   "location": "140/TALK",
   "narrator": "神楽",
   "text": "輝き流れる永遠の\nミード、ミルクティー\nメルティ！！",
   "zh": "闪耀流淌的永恒\n蜜酒，奶茶\n融化！！",
   "narrator_zh": "神乐"
  },
  {
   "location": "141/TALK",
   "narrator": "神楽",
   "text": "甘くて苦い禁断の\n果実、アップルティ―\nメルティ！！",
   "zh": "又甜又苦的\n禁果，苹果茶\n融化！！",
   "narrator_zh": "神乐"
  },
  {
   "location": "143/TALK",
   "narrator": "神楽",
   "text": "と、これが二人の\n決め台詞です。",
   "zh": "就是这两句，\n是她们的定场台词。",
   "narrator_zh": "神乐"
  },
  {
   "location": "146/TALK",
   "narrator": "つばめ",
   "text": "えぇっ！？",
   "zh": "诶诶！？",
   "narrator_zh": "燕"
  },
  {
   "location": "147/TALK",
   "narrator": "つばめ",
   "text": "じゃ、じゃあ、\nその二人になるって\nことは、その決め台詞も…",
   "zh": "那、那么，\n要变成那两个人，\n定场台词也要……",
   "narrator_zh": "燕"
  },
  {
   "location": "148/TALK",
   "narrator": "神楽",
   "text": "当然です！\n決め台詞ですから。",
   "zh": "当然！\n因为是定场台词。",
   "narrator_zh": "神乐"
  },
  {
   "location": "151/TALK",
   "narrator": "つばめ",
   "text": "で、でも、わたしも\nそれを言うのは\nちょっと…。",
   "zh": "可、可是，要我\n把那句话说出来，\n有点……。",
   "narrator_zh": "燕"
  },
  {
   "location": "152/TALK",
   "narrator": "神楽",
   "text": "大丈夫ですよ。\nつばめさんなら、\nきっとできます！",
   "zh": "不要紧的。\n燕的话，\n一定做得到！",
   "narrator_zh": "神乐"
  },
  {
   "location": "153/TALK",
   "narrator": "神楽",
   "text": "だから、\n一緒にメルティ\nやりましょう！",
   "zh": "所以，\n一起当融化\n吧！",
   "narrator_zh": "神乐"
  },
  {
   "location": "154/TALK",
   "narrator": "神楽",
   "text": "運転手さん、\n現場まで急いで\nください！",
   "zh": "司机，\n请赶紧开到\n现场！",
   "narrator_zh": "神乐"
  },
  {
   "location": "156/TALK",
   "narrator": "つばめ",
   "text": "め、メルティかぁ…。\n輝き流れる永遠の\nミード…。",
   "zh": "融、融化呀……。\n闪耀流淌的永恒\n蜜酒……。",
   "narrator_zh": "燕"
  },
  {
   "location": "158/TALK",
   "narrator": "つばめ",
   "text": "う～ん…。",
   "zh": "嗯……。",
   "narrator_zh": "燕"
  },
  {
   "location": "159/SEL",
   "narrator": "",
   "text": "やりたくないの？",
   "zh": "不想做吗？",
   "narrator_zh": ""
  },
  {
   "location": "160/ACT",
   "narrator": "",
   "text": "やりたくないの？",
   "zh": "不想做吗？",
   "narrator_zh": ""
  },
  {
   "location": "177/TALK",
   "narrator": "つばめ",
   "text": "ぅぅん",
   "zh": "嗯嗯",
   "narrator_zh": "燕"
  },
  {
   "location": "178/TALK",
   "narrator": "つばめ",
   "text": "そぅぃぅことじゃなぃの(･Д･｀)",
   "zh": "不是那样的呀(･Д･｀)",
   "narrator_zh": "燕"
  },
  {
   "location": "179/TALK",
   "narrator": "つばめ",
   "text": "でも",
   "zh": "可是",
   "narrator_zh": "燕"
  },
  {
   "location": "180/TALK",
   "narrator": "つばめ",
   "text": "恥ずかしぃ(/ω＼)",
   "zh": "好害羞(/ω＼)",
   "narrator_zh": "燕"
  },
  {
   "location": "182/TALK",
   "narrator": "つばめ",
   "text": "卯月さんの言ってたセリフ",
   "zh": "卯月说的那句台词",
   "narrator_zh": "燕"
  },
  {
   "location": "183/TALK",
   "narrator": "つばめ",
   "text": "実際に言ぅなんて(●ﾉωﾉ)",
   "zh": "真的要说出来(●ﾉωﾉ)",
   "narrator_zh": "燕"
  },
  {
   "location": "185/SEL",
   "narrator": "",
   "text": "やりたくないように聞こえる",
   "zh": "听起来像是不想做",
   "narrator_zh": ""
  },
  {
   "location": "186/ACT",
   "narrator": "",
   "text": "やりたくないように聞こえる",
   "zh": "听起来像是不想做",
   "narrator_zh": ""
  },
  {
   "location": "188/TALK",
   "narrator": "つばめ",
   "text": "本当にそぅじゃなぃの",
   "zh": "真的不是那样",
   "narrator_zh": "燕"
  },
  {
   "location": "189/TALK",
   "narrator": "つばめ",
   "text": "卯月さんとなら",
   "zh": "要是和卯月一起",
   "narrator_zh": "燕"
  },
  {
   "location": "190/TALK",
   "narrator": "つばめ",
   "text": "やってみたぃ気もするし(*´ω｀*)",
   "zh": "也有点想试试(*´ω｀*)",
   "narrator_zh": "燕"
  },
  {
   "location": "191/TALK",
   "narrator": "つばめ",
   "text": "でも",
   "zh": "可是",
   "narrator_zh": "燕"
  },
  {
   "location": "192/TALK",
   "narrator": "つばめ",
   "text": "どうしても恥ずかしくてヾ(｡>﹏<｡)ﾉﾞ",
   "zh": "怎么都觉得害羞ヾ(｡>﹏<｡)ﾉﾞ",
   "narrator_zh": "燕"
  },
  {
   "location": "193/TALK",
   "narrator": "つばめ",
   "text": "上手くやれる自信なぃし(o´Д`)=з",
   "zh": "也没信心能做好(o´Д`)=з",
   "narrator_zh": "燕"
  },
  {
   "location": "194/TALK",
   "narrator": "つばめ",
   "text": "ぅ～ん",
   "zh": "嗯——",
   "narrator_zh": "燕"
  },
  {
   "location": "240/TALK",
   "narrator": "つばめ",
   "text": "……。",
   "zh": "……。",
   "narrator_zh": "燕"
  },
  {
   "location": "241/SEL",
   "narrator": "",
   "text": "どうしたの？",
   "zh": "怎么了？",
   "narrator_zh": ""
  },
  {
   "location": "242/ACT",
   "narrator": "",
   "text": "どうしたの？",
   "zh": "怎么了？",
   "narrator_zh": ""
  },
  {
   "location": "246/TALK",
   "narrator": "つばめ",
   "text": "あ、いえ、\nなんでもないんです！",
   "zh": "啊，没有，\n什么事都没有！",
   "narrator_zh": "燕"
  },
  {
   "location": "247/SEL",
   "narrator": "",
   "text": "なんか、元気ない？",
   "zh": "怎么，没什么精神？",
   "narrator_zh": ""
  },
  {
   "location": "248/SEL",
   "narrator": "",
   "text": "有給休暇はどうだった？",
   "zh": "带薪假过得怎么样？",
   "narrator_zh": ""
  },
  {
   "location": "249/ACT",
   "narrator": "",
   "text": "なんか、元気ない？",
   "zh": "怎么，没什么精神？",
   "narrator_zh": ""
  },
  {
   "location": "251/TALK",
   "narrator": "つばめ",
   "text": "え？\nそんなことありませんよ？",
   "zh": "诶？\n没有那回事呀？",
