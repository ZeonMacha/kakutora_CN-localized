        "title": "らぶとーく 第56話",
        "sub_title": "それはないわ、やっぱりあるわ",
        "title_zh": "恋爱漫谈 第56话",
        "sub_title_zh": "那没有吧，果然还是有的"
    },
    "entry": [
        {
            "location": "156/SCENARIO",
            "narrator": "",
            "text": "それはないわ、やっぱりあるわ",
            "zh": "那没有吧，果然还是有的",
            "narrator_zh": ""
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "みやび",
            "text": "あそこのサーバーのセキュリティは甘い",
            "zh": "那边服务器的安全很松",
            "narrator_zh": "雅"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "抜け道がある",
            "zh": "有能钻的空子",
            "narrator_zh": "雅"
        },
        {
            "location": "177/TALK",
            "narrator": "ラビットアニマ",
            "text": "なんと！",
            "zh": "什么！",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "178/TALK",
            "narrator": "みやび",
            "text": "アドミンのパスは固いが",
            "zh": "管理员密码很硬，但",
            "narrator_zh": "雅"
        },
        {
            "location": "179/TALK",
            "narrator": "みやび",
            "text": "ユーザーアカウントにチョロいのがある",
            "zh": "用户账号里就有松垮的",
            "narrator_zh": "雅"
        },
        {
            "location": "181/TALK",
            "narrator": "ラビットアニマ",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "182/TALK",
            "narrator": "ラビットアニマ",
            "text": "そこを詳しく",
            "zh": "那里说详细点",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "183/TALK",
            "narrator": "みやび",
            "text": "そいつのログインパス",
            "zh": "那家伙的登录密码",
            "narrator_zh": "雅"
        },
        {
            "location": "188/TALK",
            "narrator": "ラビットアニマ",
            "text": "ど新人にＷＡＶＥスタンプ一つ",
            "zh": "给新人的一个WAVE表情",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "189/TALK",
            "narrator": "みやび",
            "text": "おめおめ",
            "zh": "哟哟",
            "narrator_zh": "雅"
        },
        {
            "location": "191/TALK",
            "narrator": "みやび",
            "text": "うちの使っちょらんスタンプを送ろう",
            "zh": "把我没在用的表情发过去吧",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "ラビットアニマ",
            "text": "光栄です",
            "zh": "不胜荣幸",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "それはそうと",
            "zh": "说起来",
            "narrator_zh": "雅"
        },
        {
            "location": "195/TALK",
            "narrator": "みやび",
            "text": "相棒は付いてきてるか？",
            "zh": "搭档跟上来咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "197/SEL",
            "narrator": "",
            "text": "聞いてるだけでいいよ",
            "zh": "你听着就好哦",
            "narrator_zh": ""
        },
        {
            "location": "198/SEL",
            "narrator": "",
            "text": "ついてってるし",
            "zh": "都跟来了",
            "narrator_zh": ""
        },
        {
            "location": "199/SEL",
            "narrator": "",
            "text": "あ、寝てた",
            "zh": "啊，睡着了",
            "narrator_zh": ""
        },
        {
            "location": "200/ACT",
            "narrator": "",
            "text": "聞いてるだけでいいよ",
            "zh": "你听着就好哦",
            "narrator_zh": ""
        },
        {
            "location": "201/TALK",
            "narrator": "みやび",
            "text": "何と弱気！？",
            "zh": "怎么这么没干劲！？",
            "narrator_zh": "雅"
        },
        {
            "location": "202/TALK",
            "narrator": "みやび",
            "text": "うちは悲しい！",
            "zh": "我好伤心啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "203/TALK",
            "narrator": "みやび",
            "text": "男ならもっと押し気味でいかんと！",
            "zh": "是男人的话就该更主动推进些啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "204/TALK",
            "narrator": "みやび",
            "text": "何言うても構わん",
            "zh": "随你说什么都行",
            "narrator_zh": "雅"
        },
        {
            "location": "205/TALK",
            "narrator": "みやび",
            "text": "話に食いつくのだ！",
            "zh": "给我咬住话头啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "206/TALK",
            "narrator": "みやび",
            "text": "その方がかっこいい！",
            "zh": "那样更帅！",
            "narrator_zh": "雅"
        },
        {
            "location": "207/TALK",
            "narrator": "みやび",
            "text": "うちが骨は拾うたる",
            "zh": "骨头我来给你捡",
            "narrator_zh": "雅"
        },
        {
            "location": "209/TALK",
            "narrator": "ラビットアニマ",
            "text": "フォローするということ？",
            "zh": "是指要跟上的意思吗？",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "うさぎナイスフォロー",
            "zh": "兔子好个跟进",
            "narrator_zh": "雅"
        },
        {
            "location": "212/TALK",
            "narrator": "ラビットアニマ",
            "text": "その気はなかったのに",
            "zh": "我本来没那个意思",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "213/TALK",
            "narrator": "みやび",
            "text": "よし",
            "zh": "好嘞",
            "narrator_zh": "雅"
        },
        {
            "location": "214/TALK",
            "narrator": "みやび",
            "text": "話を続けよう",
            "zh": "继续说下去吧",
            "narrator_zh": "雅"
        },
        {
            "location": "217/TALK",
            "narrator": "ラビットアニマ",
            "text": "いえ",
            "zh": "不是",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "218/TALK",
            "narrator": "ラビットアニマ",
            "text": "お邪魔みたいなので消えますね",
            "zh": "看来打扰到你了，那我消失了",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "219/TALK",
            "narrator": "システム",
            "text": "『ＲａｂｂｉｔＡｎｉｍａが退場しました』",
            "zh": "『ＲａｂｂｉｔＡｎｉｍａ退场了』",
            "narrator_zh": "系统"
        },
        {
            "location": "228/TALK",
            "narrator": "みやび",
            "text": "何や？\n用事でもあるが？",
            "zh": "怎么啦？\n是有事要办咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "230/TALK",
            "narrator": "繭",
            "text": "そうではないのですが…。",
            "zh": "并不是那样……。",
            "narrator_zh": "茧"
        },
        {
            "location": "231/TALK",
            "narrator": "みやび",
            "text": "…？",
            "zh": "…？",
            "narrator_zh": "雅"
        },
        {
            "location": "232/TALK",
            "narrator": "繭",
            "text": "ふふっ…ごちそうさま。\nお腹いっぱいです。",
            "zh": "嘿嘿……多谢款待。\n肚子饱饱的。",
            "narrator_zh": "茧"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "みやび",
            "text": "さすがはウサギ、\n感がえいなぁ…。",
            "zh": "不愧是兔子，\n直觉真好……。",
            "narrator_zh": "雅"
        },
        {
            "location": "240/ACT",
            "narrator": "",
            "text": "ついてってるし",
            "zh": "都跟来了",
            "narrator_zh": ""
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "さすがや",
            "zh": "不愧是你",
            "narrator_zh": "雅"
        },
        {
            "location": "242/TALK",
            "narrator": "みやび",
            "text": "なんて",
            "zh": "之类的",
            "narrator_zh": "雅"
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "そんなわけあるか！",
            "zh": "怎么可能有那种事！",
            "narrator_zh": "雅"
        },
        {
            "location": "245/TALK",
            "narrator": "みやび",
            "text": "全然聞いてなかったやろ？",
            "zh": "根本没在听，没是嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "247/SEL",
            "narrator": "",
            "text": "バレたか",
            "zh": "被发现了啊",
            "narrator_zh": ""
        },
        {
            "location": "248/ACT",
            "narrator": "",
            "text": "バレたか",
            "zh": "被发现了啊",
            "narrator_zh": ""
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "当然",
            "zh": "那当然",
            "narrator_zh": "雅"
        },
        {
            "location": "251/TALK",
            "narrator": "みやび",
            "text": "気配を感じなかった",
            "zh": "完全没感觉到气息",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "ラビットアニマ",
            "text": "あ",
            "zh": "啊",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "254/TALK",
            "narrator": "ラビットアニマ",
            "text": "こんにちは",
            "zh": "你好",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "255/TALK",
            "narrator": "ラビットアニマ",
            "text": "いたんですか",
            "zh": "原来你在吗？",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "ウサギも感じなかったようや",
            "zh": "兔子似乎也没感觉到咧",
            "narrator_zh": "雅"
        },
        {
            "location": "258/TALK",
            "narrator": "ラビットアニマ",
            "text": "そういうの感じたことないのですが",
            "zh": "我没感受过那种",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "259/TALK",
            "narrator": "みやび",
            "text": "うちも最近開眼した",
            "zh": "我也是最近才开窍",
            "narrator_zh": "雅"
        },
        {
            "location": "260/TALK",
            "narrator": "みやび",
            "text": "ただし",
            "zh": "不过",
            "narrator_zh": "雅"
        },
        {
            "location": "261/TALK",
            "narrator": "みやび",
            "text": "相棒限定",
            "zh": "仅限搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "264/TALK",
            "narrator": "ラビットアニマ",
            "text": "使い道が限られますね",
            "zh": "用处很有限呢",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "265/TALK",
            "narrator": "みやび",
            "text": "ありがたいか？",
            "zh": "觉得难得咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "267/SEL",
            "narrator": "",
            "text": "ありがたい",
            "zh": "真是感激",
            "narrator_zh": ""
        },
        {
            "location": "268/ACT",
            "narrator": "",
            "text": "ありがたい",
            "zh": "真是感激",
            "narrator_zh": ""
        },
        {
            "location": "270/TALK",
            "narrator": "みやび",
            "text": "よしよし",
            "zh": "好，好",
            "narrator_zh": "雅"
        },
        {
            "location": "271/TALK",
            "narrator": "みやび",
            "text": "素直な良い子やねぇ",
            "zh": "真是个坦率的好孩子咯",
            "narrator_zh": "雅"
        },
        {
            "location": "272/TALK",
            "narrator": "みやび",
            "text": "なでなでなでなで",
            "zh": "摸摸摸摸",
            "narrator_zh": "雅"
        },
        {
            "location": "274/TALK",
            "narrator": "ラビットアニマ",
            "text": "子犬を撫でてるように見える",
            "zh": "看起来就像在摸小狗呢",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "275/TALK",
            "narrator": "みやび",
            "text": "そんな感じ",
            "zh": "那种感觉",
            "narrator_zh": "雅"
        },
        {
            "location": "276/TALK",
            "narrator": "みやび",
            "text": "さて",
            "zh": "好了",
            "narrator_zh": "雅"
        },
        {
            "location": "277/TALK",
            "narrator": "みやび",
            "text": "話に戻るか",
            "zh": "回到正题吧",
            "narrator_zh": "雅"
        },
        {
            "location": "279/ACT",
            "narrator": "",
            "text": "あ、寝てた",
            "zh": "啊，睡着了",
            "narrator_zh": ""
        },
        {
            "location": "280/TALK",
            "narrator": "みやび",
            "text": "バカモノ！",
            "zh": "蠢货！",
            "narrator_zh": "雅"
        },
        {
            "location": "282/TALK",
            "narrator": "みやび",
            "text": "うちがいるゆうんに寝るとかありえん",
            "zh": "我明明还在讲话你却睡得着，不可能咧",
            "narrator_zh": "雅"
        },
        {
            "location": "283/TALK",
            "narrator": "みやび",
            "text": "独り言になってしまう",
            "zh": "都快变成自言自语了",
            "narrator_zh": "雅"
        },
        {
            "location": "285/TALK",
            "narrator": "ラビットアニマ",
            "text": "私のことをお忘れですか？",
            "zh": "你把我忘了吗？",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "292/TALK",
            "narrator": "ラビットアニマ",
            "text": "あ",
            "zh": "啊",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "293/TALK",
            "narrator": "ラビットアニマ",
            "text": "そこリアル言葉で謝るとは思いませんでした",
            "zh": "没想到会用那么现实的话道歉",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "294/TALK",
            "narrator": "みやび",
            "text": "存在忘れるとか失礼やきね",
            "zh": "把人家的存在都忘了，太失礼了啵",
            "narrator_zh": "雅"
        },
        {
            "location": "296/TALK",
            "narrator": "みやび",
            "text": "礼儀はちゃんとせんと",
            "zh": "礼数可得做周全才行",
            "narrator_zh": "雅"
        },
        {
            "location": "298/SEL",
            "narrator": "",
            "text": "みやびは偉い！",
            "zh": "雅真了不起！",
            "narrator_zh": ""
        },
        {
            "location": "299/ACT",
            "narrator": "",
            "text": "みやびは偉い！",
            "zh": "雅真了不起！",
            "narrator_zh": ""
        },
        {
            "location": "302/TALK",
            "narrator": "みやび",
            "text": "嬉しいな",
            "zh": "好开心",
            "narrator_zh": "雅"
        },
        {
            "location": "303/TALK",
            "narrator": "みやび",
            "text": "もっと褒めても構わんぞ",
            "zh": "再多夸几句也不碍事咯",
            "narrator_zh": "雅"
        },
        {
            "location": "304/TALK",
            "narrator": "みやび",
            "text": "むしろ褒めまくれ",
            "zh": "不如使劲夸",
            "narrator_zh": "雅"
        },
        {
            "location": "307/TALK",
            "narrator": "ラビットアニマ",
            "text": "何か出るんですか？",
            "zh": "会有什么奖励吗？",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "308/TALK",
            "narrator": "みやび",
            "text": "それはお楽しみ",
            "zh": "那个敬请期待",
            "narrator_zh": "雅"
        },
        {
            "location": "310/TALK",
            "narrator": "ラビットアニマ",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "311/TALK",
            "narrator": "ラビットアニマ",
            "text": "興味はあります",
            "zh": "兴趣是有的呢",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "312/TALK",
            "narrator": "みやび",
            "text": "見たいが？",
            "zh": "想看咩？",
            "narrator_zh": "雅"
        },
        {
