        "sub_title_zh": "甜品甜得不得了"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "004_スイーツの甘きことなし",
            "zh": "004_甜品甜得不得了",
            "narrator_zh": ""
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "サクサクほろほろサックサク―",
            "zh": "酥酥碎碎酥酥脆——",
            "narrator_zh": "雅"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "これがクッキーの信条なり",
            "zh": "此乃曲奇之信条",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "駄菓子菓子",
            "zh": "小零食小零食",
            "narrator_zh": "雅"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "自作クッキーは",
            "zh": "我自烤的曲奇",
            "narrator_zh": "雅"
        },
        {
            "location": "36/TALK",
            "narrator": "みやび",
            "text": "そこが大いに不足しておったのじゃよ",
            "zh": "就是这点大大不足咧",
            "narrator_zh": "雅"
        },
        {
            "location": "38/SEL",
            "narrator": "",
            "text": "不味かった、ってこと？",
            "zh": "是说很难吃？",
            "narrator_zh": ""
        },
        {
            "location": "39/SEL",
            "narrator": "",
            "text": "不味くないならいいじゃん",
            "zh": "不难吃不就好了嘛",
            "narrator_zh": ""
        },
        {
            "location": "40/SEL",
            "narrator": "",
            "text": "違うの作ったら？",
            "zh": "做点别的怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "41/ACT",
            "narrator": "",
            "text": "不味かった、ってこと？",
            "zh": "是说很难吃？",
            "narrator_zh": ""
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "まずいといえばまずい",
            "zh": "说难吃也确实难吃",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "雅"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "味自体はまずくはないが",
            "zh": "味道本身倒不算难吃",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "サクサクさくさくサックサク―",
            "zh": "酥酥脆脆咔嚓咔嚓——",
            "narrator_zh": "雅"
        },
        {
            "location": "46/TALK",
            "narrator": "みやび",
            "text": "そんな歯ごたえ的な何かが足りん",
            "zh": "就是缺了口感上的那一味",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "しかし確信が持てず、全部喰らってしまったのじゃよ",
            "zh": "但我又拿不准，索性全吃掉了咧",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "みやび",
            "text": "カロリー……",
            "zh": "热量……",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "消費カロリーが怖い！！！！！",
            "zh": "要消耗掉的热量好可怕！！！！！",
            "narrator_zh": "雅"
        },
        {
            "location": "50/ACT",
            "narrator": "",
            "text": "不味くないならいいじゃん",
            "zh": "不难吃不就好了嘛",
            "narrator_zh": ""
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "そういう説もあるな、相棒",
            "zh": "也有这么个说法啊，搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "しかしそれはうちの法律では違法である",
            "zh": "但这在我的法律里属于违法",
            "narrator_zh": "雅"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "すなわち罪！",
            "zh": "亦即有罪！",
            "narrator_zh": "雅"
        },
        {
            "location": "54/ACT",
            "narrator": "",
            "text": "違うの作ったら？",
            "zh": "做点别的怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "ふむ",
            "zh": "唔",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "建設的な意見",
            "zh": "挺有建设性",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "しかし",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "クッキーごときが攻略できずケーキなど作れようか？",
            "zh": "连区区曲奇都攻不下，蛋糕什么的做得了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不行",
            "narrator_zh": "雅"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "難易度を下げてプリンあたりにするか",
            "zh": "那就降低难度，做做布丁什么的吧",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "よし",
            "zh": "好",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "貴殿の意見を",
            "zh": "你的意见",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "前向きに検討しよう",
            "zh": "我会积极考虑的",
            "narrator_zh": "雅"
        }
    ]
}
