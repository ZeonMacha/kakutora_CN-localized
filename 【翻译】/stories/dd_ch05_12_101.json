        },
        {
            "location": "2160/SEL",
            "narrator": "",
            "text": "はい、すみません……",
            "zh": "是，对不起……",
            "narrator_zh": ""
        },
        {
            "location": "2161/SEL",
            "narrator": "",
            "text": "ごめんなさい",
            "zh": "非常抱歉",
            "narrator_zh": ""
        },
        {
            "location": "2162/ACT",
            "narrator": "",
            "text": "はい、すみません……",
            "zh": "是，对不起……",
            "narrator_zh": ""
        },
        {
            "location": "2163/ACT",
            "narrator": "",
            "text": "ごめんなさい",
            "zh": "非常抱歉",
            "narrator_zh": ""
        },
        {
            "location": "2165/TALK",
            "narrator": "ガブリエラ",
            "text": "今度やったら、\nもう別れるから。\nいい？",
            "zh": "下次再敢这样，\n就和你分手。\n听见没？",
            "narrator_zh": "加布里埃拉"
        },
        {
