            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2145/SEL",
            "narrator": "",
            "text": "え？　あ、ああ…",
            "zh": "诶？　啊、啊啊……",
            "narrator_zh": ""
        },
        {
            "location": "2146/SEL",
