            "zh": "你们两个没事吧？",
            "narrator_zh": ""
        },
        {
            "location": "2119/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ。\nあの程度のクラン、\nなんてことないわ。",
            "zh": "嗯。\n那种程度的库兰，\n根本不在话下。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2121/TALK",
            "narrator": "ぴょんこ",
            "text": "ガブちゃんのお陰で、\n今回も精神崩壊せずに\nいられました♪",
            "zh": "多亏了加布，\n这次也没精神崩溃\n撑过来了♪",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2123/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、ちょっと……\nその言い方はかなり\nクルものがあるんだけど。",
            "zh": "等、等等……\n你这说法听着\n挺让人发怵的啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2124/TALK",
            "narrator": "ぴょんこ",
            "text": "ぴょん？",
            "zh": "pyon？",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2125/ACT",
            "narrator": "",
            "text": "ぴょんこｽｷ",
            "zh": "喜欢蹦子",
            "narrator_zh": ""
        },
        {
            "location": "2128/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁっ！？",
            "zh": "哈啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2129/TALK",
            "narrator": "ぴょんこ",
            "text": "ええええっ！！",
            "zh": "诶诶诶诶！！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2130/TALK",
            "narrator": "ぴょんこ",
            "text": "ガブちゃんの――",
            "zh": "在加布的——",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2133/TALK",
            "narrator": "ぴょんこ",
            "text": "<size=35>目の前で！！</size>",
            "zh": "<size=35>正眼前！！</size>",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2136/TALK",
            "narrator": "ぴょんこ",
            "text": "<size=40>愛の囁き！？</size>",
            "zh": "<size=40>爱的低语！？</size>",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2138/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2141/TALK",
            "narrator": "ガブリエラ",
