{
    "dir": "chap12/daydra/dd_ch05_12_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "12502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "つばめさんを○したい？＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "想把燕○掉？＜前篇＞"
    },
    "entry": [
        {
            "location": "1910/TALK",
            "narrator": "神楽",
            "text": "さてと…つばめさん、\n帰りましょう。",
            "zh": "那么……燕，\n我们回去吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1913/TALK",
            "narrator": "つばめ",
            "text": "あ、ごめんね。\n今日はちょっと\n寄るところがあるの。",
            "zh": "啊，抱歉呀。\n今天还有点地方\n要去一趟。",
            "narrator_zh": "燕"
        },
        {
            "location": "1914/TALK",
            "narrator": "神楽",
            "text": "そうなんですか？",
            "zh": "这样啊？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1915/TALK",
            "narrator": "神楽",
            "text": "今日は劇場もお休みですし、\n私も付き合いますよ。",
            "zh": "今天剧场也休息，\n我也陪你一起去吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1916/TALK",
            "narrator": "つばめ",
            "text": "ううん、大丈夫だよ。\n付き合わせるのも悪いし…。",
            "zh": "嗯嗯，没关系的。\n让你陪我也挺过意不去的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1917/TALK",
            "narrator": "つばめ",
            "text": "それじゃ、また明日ね。",
            "zh": "那就，明天见啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "1921/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1922/TALK",
            "narrator": "神楽",
            "text": "怪しい…。\nどこに行くのかしら？",
            "zh": "好可疑……。\n她要去哪里呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1940/TALK",
            "narrator": "つばめ",
            "text": "えーっと、劇場の鍵は…。",
            "zh": "那个，剧场的钥匙……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1947/TALK",
            "narrator": "神楽",
            "text": "…用事って、劇場？",
            "zh": "……要办的事，就是来剧场？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1948/TALK",
            "narrator": "神楽",
            "text": "お休みの劇場に用事って、\nなんなのかしら？",
            "zh": "在休息日的剧场有事，\n到底是要干什么呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1964/TALK",
            "narrator": "神楽",
            "text": "…ん？",
            "zh": "……嗯？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1965/TALK",
            "narrator": "神楽",
            "text": "楽屋に忘れ物でも\n取りに来たのかと\n思ったのに…。",
            "zh": "我还以为她是来后台\n拿什么落下的\n东西呢……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1966/TALK",
            "narrator": "神楽",
            "text": "どこ行ったの？",
            "zh": "去哪儿了？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1980/TALK",
            "narrator": "神楽",
            "text": "…ここにもいない。",
            "zh": "……这里也不在。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1981/TALK",
            "narrator": "神楽",
            "text": "映写室や倉庫にいるとは\n思えないし…う～ん…。",
            "zh": "也不像会在放映室或\n仓库里……嗯～……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1982/TALK",
            "narrator": "神楽",
            "text": "…もうちょっと\n探してみよう。",
            "zh": "……再稍微\n找找看吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1984/TALK",
            "narrator": "神楽",
            "text": "他につばめさんが\n行きそうなところは…。",
            "zh": "其他燕\n可能会去的地方……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1985/TALK",
            "narrator": "神楽",
            "text": "…あっ。",
            "zh": "……啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1986/TALK",
            "narrator": "神楽",
            "text": "いた、つばめさん。\nあんなところでなにを――",
            "zh": "找到了，燕。\n她在那种地方干什么——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1987/TALK",
            "narrator": "神楽",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1998/TALK",
            "narrator": "神楽",
            "text": "音羽！！",
            "zh": "音羽！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1999/TALK",
            "narrator": "神楽",
            "text": "なんで？\nどうしてつばめさんが\n音羽の前にいるの？",
            "zh": "为什么？\n为什么燕会\n站在音羽面前？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2000/TALK",
            "narrator": "神楽",
            "text": "劇場に誰もいない日に、\n私にも内緒でコソコソと\n会いに来るなんて――",
            "zh": "特意挑剧场没人的日子，\n还瞒着我偷偷摸摸\n跑来见她什么的——",
            "narrator_zh": "神乐"
        },
        {
            "location": "2001/TALK",
            "narrator": "神楽",
            "text": "まさか！！",
            "zh": "难道说！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2013/TALK",
            "narrator": "神楽",
            "text": "っ！！",
            "zh": "唔！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2014/TALK",
            "narrator": "神楽",
            "text": "させない…。",
            "zh": "绝不让你得逞……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2015/TALK",
            "narrator": "神楽",
            "text": "これ以上、音羽のことを\n傷つけさせはしない！！",
            "zh": "绝不让你再继续\n伤害音羽！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2017/TALK",
            "narrator": "神楽",
            "text": "例え殺してでも、\n絶対に――！！",
            "zh": "哪怕杀了你，\n也绝对——！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2066/TALK",
            "narrator": "ぴょんこ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2106/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、\n$handle$。",
            "zh": "哎呀，\n$handle$。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2108/TALK",
            "narrator": "ぴょんこ",
            "text": "ぴょん♪",
            "zh": "pyon♪",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2110/SEL",
            "narrator": "",
            "text": "ふたりとも大丈夫だった？",
            "zh": "你们两个没事吧？",
            "narrator_zh": ""
        },
        {
            "location": "2111/ACT",
            "narrator": "",
            "text": "ふたりとも大丈夫だった？",
            "zh": "你们两个没事吧？",
            "narrator_zh": ""
        },
        {
            "location": "2115/SEL",
            "narrator": "",
            "text": "ふたりとも大丈夫だった？",
            "zh": "你们两个没事吧？",
            "narrator_zh": ""
        },
        {
            "location": "2116/SEL",
            "narrator": "",
            "text": "ぴょんこｽｷ",
            "zh": "喜欢蹦子",
