            "location": "2199/TALK",
            "narrator": "ガブリエラ",
            "text": "べっ、べつに、\n羨ましいとか、\nそういうのじゃないの！",
            "zh": "才、才没有\n羡慕之类的\n那种想法！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2200/TALK",
            "narrator": "ガブリエラ",
            "text": "日本人ならもうちょっと、\n奥ゆかしさとかそういう\n国民性を大事にしなさい！",
            "zh": "既然是日本人，就再多珍惜一点\n含蓄矜持之类的\n国民性啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2201/SEL",
            "narrator": "",
            "text": "はーい",
            "zh": "好——的",
            "narrator_zh": ""
        },
        {
            "location": "2202/SEL",
            "narrator": "",
            "text": "ワタシニホンジンデハアリマセン",
            "zh": "我·不·是·日·本·人",
            "narrator_zh": ""
        },
        {
            "location": "2203/ACT",
            "narrator": "",
            "text": "はーい",
            "zh": "好——的",
            "narrator_zh": ""
        },
        {
            "location": "2205/TALK",
            "narrator": "ガブリエラ",
            "text": "わ、わかればいいのよ。\nわかれば。",
            "zh": "知、知道就好。\n知道就好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2206/ACT",
            "narrator": "",
            "text": "ワタシニホンジンデハアリマセン",
            "zh": "我·不·是·日·本·人",
            "narrator_zh": ""
        },
        {
            "location": "2208/TALK",
            "narrator": "ぴょんこ",
            "text": "ええっ！！\nそうだったんですかっ！",
            "zh": "诶诶！！\n原来是这样吗！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2210/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしもちょっと\nびっくりしたわね。",
            "zh": "连我也稍微\n吓了一跳呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2230/TALK",
            "narrator": "ぴょんこ",
            "text": "ええっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2231/SEL",
            "narrator": "",
            "text": "早っ！",
            "zh": "好快！",
            "narrator_zh": ""
        },
        {
            "location": "2232/ACT",
            "narrator": "",
            "text": "早っ！",
            "zh": "好快！",
            "narrator_zh": ""
        },
        {
            "location": "2234/TALK",
            "narrator": "ガブリエラ",
            "text": "どういうこと…！？",
            "zh": "怎么回事……！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2235/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか、あたしが戦った\nタイミングが遅かったから\n崩壊が近づいてる……！？",
            "zh": "难道，是我战斗的\n时机太晚，\n导致崩溃逼近了……！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2240/TALK",
            "narrator": "ガブリエラ",
            "text": "きゃあっ！！",
            "zh": "呀啊！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2241/TALK",
            "narrator": "ぴょんこ",
            "text": "もしくは、\n葛藤がかなり強いのかも\nしれませんねっ！",
            "zh": "或者说，\n也有可能是挣扎\n相当强烈！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2243/SEL",
            "narrator": "",
            "text": "そういえば今回、ちょっと強そうだった",
            "zh": "说起来这次，看着是有点强",
            "narrator_zh": ""
        },
        {
            "location": "2244/ACT",
            "narrator": "",
            "text": "そういえば今回、ちょっと強そうだった",
            "zh": "说起来这次，看着是有点强",
            "narrator_zh": ""
        },
        {
            "location": "2249/TALK",
            "narrator": "ぴょんこ",
            "text": "回しますっ！",
            "zh": "我转了！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2250/TALK",
            "narrator": "ぴょんこ",
            "text": "オープンプロセス、\n2x118番地から\n2xFC1番地へ。",
            "zh": "开放进程，\n从2x118地址\n到2xFC1地址。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2276/TALK",
            "narrator": "ぴょんこ",
            "text": "シーク完了。",
            "zh": "搜索完成。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2280/TALK",
            "narrator": "ぴょんこ",
            "text": "今回の悩みはっ！！",
            "zh": "这次的烦恼是！！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2281/TALK",
            "narrator": "ぴょんこ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2282/TALK",
            "narrator": "ぴょんこ",
            "text": "いけない……。\n怒りと焦りで頭の中が\n真っ白になってる……",
            "zh": "糟了……。\n被愤怒和焦躁冲昏了头，\n脑子里一片空白……",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2285/TALK",
            "narrator": "ガブリエラ",
            "text": "早く対処しなくちゃ……",
            "zh": "得赶紧处理才行……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2289/TALK",
            "narrator": "ガブリエラ",
            "text": "あーもう、\nみやびはまだ\n来ないのかしら！",
            "zh": "啊真是的，\n雅怎么还\n不来啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2291/TALK",
            "narrator": "ぴょんこ",
            "text": "ガブちゃんが\nもう一度戦うことは\n出来ないんですかっ！",
            "zh": "加布不能\n再次出战\n了吗！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2293/TALK",
            "narrator": "ガブリエラ",
            "text": "できればそうしたいけど、\n今それをやるのは\n危険なのよ。",
            "zh": "可以的话我也想，\n但现在那样做\n很危险。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2294/SEL",
            "narrator": "",
            "text": "危険！？　神楽が？\nガブリエラが？",
            "zh": "危险！？　是神乐？\n还是加布里埃拉？",
            "narrator_zh": ""
        },
        {
            "location": "2295/ACT",
            "narrator": "",
            "text": "危険！？　神楽が？\nガブリエラが？",
            "zh": "危险！？　是神乐？\n还是加布里埃拉？",
            "narrator_zh": ""
        },
        {
            "location": "2298/TALK",
            "narrator": "ガブリエラ",
            "text": "主に神楽よ。",
            "zh": "主要是神乐。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2300/TALK",
            "narrator": "ガブリエラ",
            "text": "本来は、他人のココロの\n中でこんな風に好き勝手\nしたらダメなのよ。",
            "zh": "本来，在别人的心里\n像这样随心所欲\n是不行的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2301/TALK",
            "narrator": "ガブリエラ",
            "text": "一人の存在が長居したり、\nココロの中で大きな事を\n動かしたりするのは危険。",
            "zh": "同一个人久留，或者在\n别人的心里推动太大的变化，\n都是很危险的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2302/TALK",
            "narrator": "ガブリエラ",
            "text": "影響力が強すぎて、\nココロがそれを自分の\n意志だと錯覚しちゃうの。",
            "zh": "影响力太强的话，\n心会错以为那是\n它自己的意志。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2303/TALK",
            "narrator": "ガブリエラ",
            "text": "特に葛藤処理、要するに\nクランとのバトルへの\n介入は影響が大きいわ。",
            "zh": "特别是处理挣扎，也就是\n介入与库兰的战斗，\n影响很大。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2304/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、同じ人が\n長居をすると、それだけで\n意識が混濁して――",
            "zh": "所以，只要同一个人\n待得太久，光那样\n就会让意识变混浊——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2305/SEL",
            "narrator": "",
            "text": "洗脳みたいな感じになるってこと？",
            "zh": "也就是说会变成像洗脑一样？",
            "narrator_zh": ""
        },
        {
            "location": "2306/ACT",
            "narrator": "",
            "text": "洗脳みたいな感じになるってこと？",
            "zh": "也就是说会变成像洗脑一样？",
            "narrator_zh": ""
        },
        {
            "location": "2308/TALK",
            "narrator": "ガブリエラ",
            "text": "まさにその通りね。",
            "zh": "正是如此。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2309/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、あたしが\n二回連続で戦うことによる\n影響力はわりと大きいの。",
            "zh": "所以，由我\n连续战斗两次带来的\n影响力还是挺大的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2310/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、いざという時には\nあたしが戦った方がまだ\nマシだから――",
            "zh": "不过，真到万一的时候，\n由我出战总比崩溃\n要强得多——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2312/TALK",
            "narrator": "ガブリエラ",
            "text": "限界ギリギリまで\nここにいるわ。",
            "zh": "我会撑到极限\n都留在这里。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2314/TALK",
            "narrator": "ぴょんこ",
            "text": "ガブちゃん……\nありがとうございます！",
            "zh": "加布……\n谢谢你！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2315/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2316/TALK",
            "narrator": "ぴょんこ",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2317/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ、ぴょんこ。",
            "zh": "呐，蹦子。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2318/TALK",
            "narrator": "ぴょんこ",
            "text": "はい。",
            "zh": "在。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2319/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたって、\n神楽に対してどれくらい\n影響力があるの？",
            "zh": "你啊，\n对神乐能有\n多大的影响力？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2320/TALK",
            "narrator": "ぴょんこ",
            "text": "え？\nそうですね……",
            "zh": "诶？\n这个嘛……",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2321/TALK",
            "narrator": "ぴょんこ",
            "text": "今のところ、\n結構大きいと思います。",
            "zh": "目前来看，\n我觉得还挺大的。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2322/TALK",
            "narrator": "ガブリエラ",
            "text": "そう……。",
            "zh": "这样……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2323/TALK",
            "narrator": "ぴょんこ",
            "text": "…ぴょん？",
            "zh": "……pyon？",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2324/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、ううん。\nなんでもないの。",
            "zh": "啊，没事。\n没什么。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2325/SEL",
            "narrator": "",
            "text": "？？",
            "zh": "？？",
            "narrator_zh": ""
        },
        {
            "location": "2326/SEL",
            "narrator": "",
            "text": "溜め込むの良くないよー？",
            "zh": "憋在心里可不好哦——？",
            "narrator_zh": ""
        },
        {
            "location": "2327/ACT",
            "narrator": "",
            "text": "？？",
            "zh": "？？",
            "narrator_zh": ""
        },
        {
            "location": "2328/ACT",
            "narrator": "",
            "text": "溜め込むの良くないよー？",
            "zh": "憋在心里可不好哦——？",
            "narrator_zh": ""
        },
        {
            "location": "2329/TALK",
            "narrator": "ガブリエラ",
            "text": "いや……うーん……",
            "zh": "不……嗯……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2330/TALK",
            "narrator": "ガブリエラ",
            "text": "大したことじゃ\nないのよ。だから――",
            "zh": "不是什么\n大不了的事啦。所以——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2332/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2333/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽さ、この時期って\n一人で溜め込んでて\n大変だったじゃない。",
            "zh": "神乐她，在这个时期\n一直一个人憋着心事，\n很辛苦吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2334/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、そんなこと\n全然知らなくて、だいぶ\n冷たい態度取ったけど――",
            "zh": "我那时候什么\n都不知道，对她\n态度冷淡得要命——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2336/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、今は違うから。",
            "zh": "可是，现在不一样了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2337/TALK",
            "narrator": "ぴょんこ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2338/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、神楽のこと\n応援してるから。",
            "zh": "我一直\n支持着神乐呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2339/TALK",
            "narrator": "ガブリエラ",
            "text": "何があっても、\n絶対にその先には\n素敵な未来があるから。",
            "zh": "不管发生什么，\n前面一定会有\n美好的未来在等着她。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2340/TALK",
            "narrator": "ぴょんこ",
            "text": "ガブちゃん……",
            "zh": "加布……",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2341/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、\n精一杯頑張んなさいね。",
            "zh": "所以，\n要拼尽全力加油哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2342/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、それだけ！\nさあ、わかったらさっさと\n解決するわよ！",
            "zh": "就、就这些！\n好了，明白的话就赶紧\n把问题解决掉！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2343/TALK",
            "narrator": "ぴょんこ",
            "text": "はいっ！",
            "zh": "是！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2345/TALK",
            "narrator": "ガブリエラ",
            "text": "未来の事実とかは言えない\nけど、気持ちくらいは\n伝えてもいいわよね！",
            "zh": "未来的事实之类的不能说，\n不过这份心意\n总可以传达一下吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2346/SEL",
            "narrator": "",
            "text": "$me$が許す！",
            "zh": "$me$允许！",
            "narrator_zh": ""
        },
        {
            "location": "2347/SEL",
            "narrator": "",
            "text": "$me$に言われても…",
            "zh": "就算你问$me$……",
            "narrator_zh": ""
        },
        {
            "location": "2348/ACT",
            "narrator": "",
            "text": "$me$が許す！",
            "zh": "$me$允许！",
            "narrator_zh": ""
        },
        {
            "location": "2350/TALK",
            "narrator": "ガブリエラ",
            "text": "…よかった。",
            "zh": "……太好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2351/ACT",
            "narrator": "",
            "text": "$me$に言われても…",
            "zh": "就算你问$me$……",
            "narrator_zh": ""
        },
        {
            "location": "2353/TALK",
            "narrator": "ガブリエラ",
            "text": "もーっ！",
            "zh": "真是的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2354/TALK",
            "narrator": "ガブリエラ",
            "text": "そういう時は\n嘘でも「いい」って\n言って欲しいのよ……。",
            "zh": "这种时候\n就算是骗人的，我也希望你\n说一句“可以”啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2360/TALK",
            "narrator": "ぴょんこ",
            "text": "きゃあっ！！",
            "zh": "呀啊！！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2361/TALK",
            "narrator": "ガブリエラ",
            "text": "そろそろ限界みたいね。\nやっぱりあたしが\nやるしか――",
            "zh": "看来差不多到极限了。\n果然只能由我\n来上了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2367/TALK",
            "narrator": "みやび",
            "text": "すまんね、\nだいぶ待たせた。",
            "zh": "没好意思咯，\n让你们久等了。",
            "narrator_zh": "雅"
        },
        {
            "location": "2368/SEL",
            "narrator": "",
            "text": "みやび！！",
            "zh": "雅！！",
            "narrator_zh": ""
        },
        {
            "location": "2369/ACT",
            "narrator": "",
            "text": "みやび！！",
            "zh": "雅！！",
            "narrator_zh": ""
        },
        {
            "location": "2371/TALK",
            "narrator": "ガブリエラ",
            "text": "みやび！！\nあんたちょっと\n遅すぎだから！",
            "zh": "雅！！\n你来得\n也太慢了吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2372/TALK",
            "narrator": "みやび",
            "text": "そのようやね。",
            "zh": "好像是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "2374/TALK",
            "narrator": "みやび",
            "text": "ちくっと\n準備をしちょったき……",
            "zh": "刚才稍微在\n做着准备啵……",
            "narrator_zh": "雅"
        },
        {
            "location": "2375/TALK",
            "narrator": "みやび",
            "text": "ところでガブちゃん、\n波垢の交換は\n済んじゅう？",
            "zh": "话说加布，\nWAVE账号交换\n办妥了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "2377/TALK",
            "narrator": "ガブリエラ",
            "text": "ああっ！！\nまだだったわ！",
            "zh": "啊啊！！\n还没呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2380/TALK",
            "narrator": "ガブリエラ",
            "text": "ぴょんこ、\nアカウント交換いい？",
            "zh": "蹦子，\n交换下账号可以吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2382/TALK",
            "narrator": "ぴょんこ",
            "text": "あ、はいっ！",
            "zh": "啊，好的！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2385/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2386/TALK",
            "narrator": "ぴょんこ",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2387/SEL",
            "narrator": "",
            "text": "なんでみんなWAVEアカウント交換してるの？",
            "zh": "为什么大家都在交换WAVE账号？",
            "narrator_zh": ""
        },
        {
            "location": "2388/ACT",
            "narrator": "",
            "text": "なんでみんなWAVEアカウント交換してるの？",
            "zh": "为什么大家都在交换WAVE账号？",
            "narrator_zh": ""
        },
        {
            "location": "2390/TALK",
            "narrator": "みやび",
            "text": "波で繋がっちょれば、\n影響を与えずに互いが\n状況を把握できる。",
            "zh": "只要通过WAVE连着，\n就能在不造成影响的前提下\n掌握彼此的状况。",
            "narrator_zh": "雅"
        },
        {
            "location": "2391/TALK",
            "narrator": "みやび",
            "text": "まあ、リモートアクセス\nみたいなものやね。",
            "zh": "嘛，就像远程访问\n差不多的东西咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "2392/TALK",
            "narrator": "みやび",
            "text": "それと――",
            "zh": "还有就是——",
            "narrator_zh": "雅"
        },
        {
            "location": "2393/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "2394/TALK",
            "narrator": "みやび",
            "text": "いや、これはまだえいか。",
            "zh": "不，这个现在先算了。",
            "narrator_zh": "雅"
        },
        {
            "location": "2395/SEL",
            "narrator": "",
            "text": "？？？",
            "zh": "？？？",
            "narrator_zh": ""
        },
        {
            "location": "2396/ACT",
            "narrator": "",
            "text": "？？？",
            "zh": "？？？",
            "narrator_zh": ""
        },
        {
            "location": "2400/TALK",
            "narrator": "ガブリエラ",
            "text": "登録したわよ。",
            "zh": "添加好了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2402/TALK",
            "narrator": "ぴょんこ",
            "text": "こちらも完了しました♪",
            "zh": "我这边也完成了♪",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2404/TALK",
            "narrator": "みやび",
            "text": "うちも\nセットアップ完了や。",
            "zh": "我也\n设置完成了。",
            "narrator_zh": "雅"
        },
        {
            "location": "2405/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、\nあたしはこれで\n自分とこに戻るわね。",
            "zh": "那就，\n我这就回\n自己那边去咯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2407/TALK",
            "narrator": "ガブリエラ",
            "text": "素敵なココロの旅をー。",
            "zh": "祝你们心灵之旅愉快——。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "2410/SEL",
            "narrator": "",
            "text": "セットアップって？",
            "zh": "设置是什么？",
            "narrator_zh": ""
        },
        {
            "location": "2411/ACT",
            "narrator": "",
            "text": "セットアップって？",
            "zh": "设置是什么？",
            "narrator_zh": ""
        },
        {
            "location": "2414/TALK",
            "narrator": "みやび",
            "text": "うむ。\nセットアップやよ。",
            "zh": "嗯。\n就是设置咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "2415/TALK",
            "narrator": "ぴょんこ",
            "text": "何の…ですか？",
            "zh": "什么的……设置？",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2417/TALK",
            "narrator": "みやび",
            "text": "お前さんたちを\n量子サーバー経由で\n共通意識野、すなわち――",
            "zh": "把你们\n经由量子服务器送到\n共通意识野，也就是——",
            "narrator_zh": "雅"
        },
        {
            "location": "2418/TALK",
            "narrator": "みやび",
            "text": "アカシックレコードに\n送る。",
            "zh": "送去\n阿卡夏纪录。",
            "narrator_zh": "雅"
        },
        {
            "location": "2419/SEL",
            "narrator": "",
            "text": "アカシックレコード！？",
            "zh": "阿卡夏纪录！？",
            "narrator_zh": ""
        },
        {
            "location": "2420/ACT",
            "narrator": "",
            "text": "アカシックレコード！？",
            "zh": "阿卡夏纪录！？",
            "narrator_zh": ""
        },
        {
            "location": "2423/TALK",
            "narrator": "みやび",
            "text": "うむ。",
            "zh": "嗯。",
            "narrator_zh": "雅"
        },
        {
            "location": "2424/TALK",
            "narrator": "みやび",
            "text": "まあ、だがしかし。\nその前にな――",
            "zh": "嘛，不过话虽如此。\n在那之前呢——",
            "narrator_zh": "雅"
        },
        {
            "location": "2425/TALK",
            "narrator": "みやび",
            "text": "この惨状を\n何とかせんといかんね。",
            "zh": "得先把这副惨状\n想想办法才行咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "2427/TALK",
            "narrator": "みやび",
            "text": "詳しい説明は後や。\nぴょんこちゃん、\n準備はえいか？",
            "zh": "详细说明回头再讲。\n蹦子，\n准备好了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "2429/TALK",
            "narrator": "ぴょんこ",
            "text": "はいっ！",
            "zh": "准备好了！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "2431/TALK",
            "narrator": "みやび",
            "text": "ほんだらいくぞね。",
            "zh": "那就出发咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "2434/TALK",
            "narrator": "みやび",
            "text": "うちら３人に\n素敵なココロの旅を。",
            "zh": "祝我们3人\n有一段美妙的心灵之旅。",
            "narrator_zh": "雅"
        },
        {
            "location": "2456/TALK",
            "narrator": "エリカ",
            "text": "ストップ\nストップ\nストーップ！！",
            "zh": "停下\n停下\n停——下！！",
            "narrator_zh": "领火"
        },
        {
            "location": "2457/SEL",
            "narrator": "",
            "text": "エリカさん！？",
            "zh": "领火！？",
            "narrator_zh": ""
        },
        {
            "location": "2458/ACT",
            "narrator": "",
            "text": "エリカさん！？",
            "zh": "领火！？",
            "narrator_zh": ""
        },
        {
            "location": "2460/TALK",
            "narrator": "エリカ",
            "text": "ごめんね、\nほんとにごめん！",
            "zh": "对不起呀，\n真的对不起！",
            "narrator_zh": "领火"
        },
        {
            "location": "2461/TALK",
            "narrator": "エリカ",
            "text": "ほんとは全て、\nあなたの気持ちが赴く\nままにさせてあげたいの。",
            "zh": "其实本来我是想\n一切都顺着\n你的心意来的。",
            "narrator_zh": "领火"
        },
        {
            "location": "2462/TALK",
            "narrator": "エリカ",
            "text": "でも、今回の発言は\nあまりに未来に対する\n影響力が大きすぎて。",
            "zh": "可是，你这次的发言\n对未来的\n影响力实在太大了。",
            "narrator_zh": "领火"
        },
        {
            "location": "2463/TALK",
            "narrator": "エリカ",
            "text": "今後に大きな支障が\n出ちゃいそうだったから\n切断させてもらいました。",
            "zh": "眼看要给今后带来\n很大的阻碍，\n我就只好先切断了。",
            "narrator_zh": "领火"
        },
        {
            "location": "2464/SEL",
            "narrator": "",
            "text": "……ここは？",
            "zh": "……这里是？",
            "narrator_zh": ""
        },
        {
            "location": "2465/ACT",
            "narrator": "",
            "text": "……ここは？",
            "zh": "……这里是？",
            "narrator_zh": ""
        },
        {
            "location": "2467/TALK",
            "narrator": "エリカ",
            "text": "ブレークポイント。\nシステム領域だよ。",
            "zh": "断点。\n是系统领域哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "2468/TALK",
            "narrator": "エリカ",
            "text": "本当は乱用したら\nいけない機能なんだけど。",
            "zh": "这其实是个\n不能乱用的功能啦。",
            "narrator_zh": "领火"
        },
        {
            "location": "2469/TALK",
            "narrator": "エリカ",
            "text": "あなたの選択を\n軽視する行為でもあるし。",
            "zh": "毕竟这也算是\n轻视你选择的行为。",
            "narrator_zh": "领火"
        },
        {
            "location": "2470/TALK",
            "narrator": "エリカ",
            "text": "でも今回は、それくらいの\nことだったということは\n解って欲しいかな。",
            "zh": "不过希望你能明白，\n这次的事情\n就是有那么严重哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "2471/TALK",
            "narrator": "エリカ",
            "text": "本当にごめんね。\nスタックポインタを最初に\n戻させてもらうから。",
            "zh": "真的对不起呀。\n我会把栈指针\n退回到最开始哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "2472/TALK",
            "narrator": "エリカ",
            "text": "それじゃ、またね。",
            "zh": "那就，回头见啦。",
            "narrator_zh": "领火"
        },
        {
            "location": "1901/DIALOG",
            "narrator": "NOTICE",
            "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n",
            "zh": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n尚未选择必须选项。\n\n<color=green>『STORY27：新・神乐』</color>\n请在其中做出选择后\n再次访问。\n",
            "narrator_zh": "NOTICE"
        },
        {
            "location": "1905/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月26日　3:35 PM</color>\nとある平日の放課後、附属学園つばめの教室にて。",
            "zh": "<color=green>6月26日　3:35 PM</color>\n某个平日的放学后，在附属学园燕的教室里。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "2031/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch01",
            "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>逢濑燕的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解逢濑燕心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch01"
        },
        {
            "location": "2033/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch02",
            "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>国政绫水的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解国政绫水心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch02"
        },
        {
            "location": "2035/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch03",
            "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>加布里埃拉的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解加布里埃拉心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch03"
        },
        {
            "location": "2037/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch04",
            "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>恋之崎雅的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解恋之崎雅心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch04"
        },
        {
            "location": "2039/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch05",
            "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>卯月神乐的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解卯月神乐心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch05"
        },
        {
            "location": "2447/DIALOG",
            "narrator": "NOTICE",
            "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)",
            "zh": "<color=red>【TRI-OS Error:0x99】</color>\n与心灵领域的线路\n已切断。(981)",
            "narrator_zh": "NOTICE"
        }
    ]
}
