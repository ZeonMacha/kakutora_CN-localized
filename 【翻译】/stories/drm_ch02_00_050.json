{
 "dir": "dramatics/daydra/drm_ch02_00_050.js",
 "type": "Episode",
 "info": {
  "story_id": "2005",
  "cid": "ayami",
  "title": "らぶとーく 第05話",
  "sub_title": "考えたくないけど"
 },
 "entry": [
  {
   "location": "177/SCENARIO",
   "narrator": "",
   "text": "考えたくないけど"
  },
  {
   "location": "190/TALK",
   "narrator": "みやび",
   "text": "改めて話したいことって\n何ぞね。"
  },
  {
   "location": "191/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "193/TALK",
   "narrator": "みやび",
   "text": "どうしたが？",
   "zh": "怎么了……？",
   "narrator_zh": "雅"
  },
  {
   "location": "195/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "197/TALK",
   "narrator": "アーヤ",
   "text": "これから\nすごく変なことを\n言うかもしれない。",
   "zh": "接下来\n我可能会说些\n很奇怪的话。",
   "narrator_zh": "绫水"
  },
  {
   "location": "200/TALK",
   "narrator": "アーヤ",
   "text": "でもまじめに\n考えてほしいの。",
   "zh": "不过我希望你\n认真想一想。",
   "narrator_zh": "绫水"
  },
  {
   "location": "201/TALK",
   "narrator": "みやび",
   "text": "…………。"
  },
  {
   "location": "203/TALK",
   "narrator": "アーヤ",
   "text": "ううん。きっと、\n私よりみやびの方が\n先に気づいてる。",
   "zh": "不是。我想，\n雅一定比我\n更早察觉到了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "204/TALK",
   "narrator": "みやび",
   "text": "…………。"
  },
  {
   "location": "205/TALK",
   "narrator": "アーヤ",
   "text": "トライガジェットの\nＢｏｔについて。",
   "zh": "关于三重小装置的\nBot。",
   "narrator_zh": "绫水"
  },
  {
   "location": "208/TALK",
   "narrator": "アーヤ",
   "text": "前々から思ってたけど、\nそこらのＢｏｔよりも\nかなり性能良くない？"
  },
  {
   "location": "209/TALK",
   "narrator": "みやび",
   "text": "…………。"
  },
  {
   "location": "210/TALK",
   "narrator": "みやび",
   "text": "気づいたんやね。"
  },
  {
   "location": "212/TALK",
   "narrator": "みやび",
   "text": "まじめな話、\nかなりどころの話やない。"
  },
  {
   "location": "213/TALK",
   "narrator": "みやび",
   "text": "こんなインタラクティブに\n会話してくるんやき――",
   "zh": "居然能这么互动地\n跟我对话——",
   "narrator_zh": "雅"
  },
  {
   "location": "215/TALK",
   "narrator": "みやび",
   "text": "超高性能と言うても、\n過言やない。"
  },
  {
   "location": "218/TALK",
   "narrator": "アーヤ",
   "text": "やっぱり、そうなんだ？"
  },
  {
   "location": "220/TALK",
   "narrator": "アーヤ",
   "text": "実はかなり前に、\nうちの姉が言ってたのよ。"
  },
  {
   "location": "221/TALK",
   "narrator": "アーヤ",
   "text": "特定の単語に反応する\nＢｏｔを作るのは、\n比較的簡単だけど――"
  },
  {
   "location": "224/TALK",
   "narrator": "アーヤ",
   "text": "人間に見せかけるのは、\n凄く難しいことなんだ、\nって…。"
  },
  {
   "location": "225/TALK",
   "narrator": "みやび",
   "text": "機械と違うて、人間は\nマニュアル通りには\n動かんきね。"
  },
  {
   "location": "226/TALK",
   "narrator": "みやび",
   "text": "どんな会話を、いつどんな\nタイミングで振られるかが\nわからんき――",
   "zh": "不知道会聊什么、会在\n什么时候什么时机\n被抛出话题，所以——",
   "narrator_zh": "雅"
  },
  {
   "location": "228/TALK",
   "narrator": "みやび",
   "text": "臨機応変に対応できる\nＢｏｔを創るなんてのは、\n不可能に近いことながよ。"
  },
  {
   "location": "230/TALK",
   "narrator": "アーヤ",
   "text": "…ってことは、やっぱり\nこのＢｏｔって…。"
  },
  {
   "location": "231/TALK",
   "narrator": "みやび",
   "text": "恐ろしく高性能なＡＩ。"
  },
  {
   "location": "233/TALK",
   "narrator": "みやび",
   "text": "もしくは――"
  },
  {
   "location": "236/TALK",
   "narrator": "アーヤ",
   "text": "…人間？"
  },
  {
   "location": "237/TALK",
   "narrator": "みやび",
   "text": "…かもしれんね。"
  },
  {
   "location": "240/TALK",
   "narrator": "アーヤ",
   "text": "まさか…Ｂｏｔが人間だ\nなんて…。"
  },
  {
   "location": "242/TALK",
   "narrator": "みやび",
   "text": "まあ、確証はないき、\n絶対とは言えんけんど。"
  },
  {
   "location": "244/TALK",
   "narrator": "アーヤ",
   "text": "…ちょっと\n試してみていい？"
  },
  {
   "location": "246/TALK",
   "narrator": "みやび",
   "text": "そうやね。",
   "zh": "是咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "258/TALK",
   "narrator": "アーヤ",
   "text": "こんにちは",
   "zh": "你好",
   "narrator_zh": "绫水"
  },
  {
   "location": "260/SEL",
   "narrator": "",
   "text": "はい、こんにちは",
   "zh": "好，你好",
   "narrator_zh": ""
  },
  {
   "location": "261/SEL",
   "narrator": "",
   "text": "今日は挨拶から入るの？",
   "zh": "今天从打招呼开始？",
   "narrator_zh": ""
  },
  {
   "location": "262/ACT",
   "narrator": "",
   "text": "はい、こんにちは",
   "zh": "好，你好",
   "narrator_zh": ""
  },
  {
   "location": "263/TALK",
   "narrator": "アーヤ",
   "text": "元気？"
  },
  {
   "location": "265/SEL",
   "narrator": "",
   "text": "元気だよ",
   "zh": "我很好哦",
   "narrator_zh": ""
  },
  {
   "location": "266/SEL",
   "narrator": "",
   "text": "アーヤは元気？",
   "zh": "绫水还好吗？",
   "narrator_zh": ""
  },
  {
   "location": "267/ACT",
   "narrator": "",
   "text": "元気だよ",
   "zh": "我很好哦",
   "narrator_zh": ""
  },
  {
   "location": "268/TALK",
   "narrator": "アーヤ",
   "text": "そうなの",
   "zh": "对",
   "narrator_zh": "绫水"
  },
  {
   "location": "269/TALK",
   "narrator": "アーヤ",
   "text": "それはよかったわ",
   "zh": "那太好了",
   "narrator_zh": "绫水"
  },
  {
   "location": "270/ACT",
   "narrator": "",
   "text": "アーヤは元気？",
   "zh": "绫水还好吗？",
   "narrator_zh": ""
  },
  {
   "location": "271/TALK",
   "narrator": "アーヤ",
   "text": "おかげさまで",
   "zh": "多亏了你",
   "narrator_zh": "绫水"
  },
  {
   "location": "272/TALK",
   "narrator": "アーヤ",
   "text": "元気よ"
  },
  {
   "location": "274/ACT",
   "narrator": "",
   "text": "今日は挨拶から入るの？",
   "zh": "今天从打招呼开始？",
   "narrator_zh": ""
  },
  {
   "location": "275/TALK",
   "narrator": "アーヤ",
   "text": "そうね",
   "zh": "说得对",
   "narrator_zh": "绫水"
  },
  {
   "location": "276/SEL",
   "narrator": "",
   "text": "礼儀正しいね",
   "zh": "真有礼貌呢",
   "narrator_zh": ""
  },
  {
   "location": "277/SEL",
   "narrator": "",
   "text": "堅苦しいのは抜きにしようよ",
   "zh": "别那么拘束了",
   "narrator_zh": ""
  },
  {
   "location": "278/ACT",
   "narrator": "",
   "text": "礼儀正しいね",
   "zh": "真有礼貌呢",
   "narrator_zh": ""
  },
  {
   "location": "279/TALK",
   "narrator": "アーヤ",
   "text": "あら",
   "zh": "哦",
   "narrator_zh": "绫水"
  },
  {
   "location": "280/TALK",
   "narrator": "アーヤ",
   "text": "ありがとう",
   "zh": "谢谢",
   "narrator_zh": "绫水"
  },
  {
   "location": "281/ACT",
   "narrator": "",
   "text": "堅苦しいのは抜きにしようよ",
   "zh": "别那么拘束了",
   "narrator_zh": ""
  },
  {
   "location": "282/TALK",
   "narrator": "アーヤ",
   "text": "そう？",
   "zh": "是吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "283/TALK",
   "narrator": "アーヤ",
   "text": "礼儀も大事よ"
  },
  {
   "location": "286/TALK",
   "narrator": "アーヤ",
   "text": "ちょっと暇だったから",
   "zh": "因为有点闲",
   "narrator_zh": "绫水"
  },
  {
   "location": "287/TALK",
   "narrator": "アーヤ",
   "text": "話してみただけ"
  },
  {
   "location": "288/TALK",
   "narrator": "アーヤ",
   "text": "じゃあまたね",
   "zh": "那就下次见",
   "narrator_zh": "绫水"
  },
  {
   "location": "290/SEL",
   "narrator": "",
   "text": "またね",
   "zh": "下次见",
   "narrator_zh": ""
  },
  {
   "location": "291/SEL",
   "narrator": "",
   "text": "待ってるよ",
   "zh": "我等着你哦",
   "narrator_zh": ""
  },
  {
   "location": "292/SEL",
   "narrator": "",
   "text": "これだけはさみしいな",
   "zh": "只有这点让人寂寞啊",
   "narrator_zh": ""
  },
  {
   "location": "293/ACT",
   "narrator": "",
   "text": "またね",
   "zh": "下次见",
   "narrator_zh": ""
  },
  {
   "location": "294/TALK",
   "narrator": "アーヤ",
   "text": "バイバイ",
   "zh": "拜拜",
   "narrator_zh": "绫水"
  },
  {
   "location": "295/ACT",
   "narrator": "",
   "text": "待ってるよ",
   "zh": "我等着你哦",
   "narrator_zh": ""
  },
  {
   "location": "296/TALK",
   "narrator": "アーヤ",
   "text": "またね！",
   "zh": "再见！",
   "narrator_zh": "绫水"
  },
  {
   "location": "297/ACT",
   "narrator": "",
   "text": "これだけはさみしいな",
   "zh": "只有这点让人寂寞啊",
   "narrator_zh": ""
  },
  {
   "location": "298/TALK",
   "narrator": "アーヤ",
   "text": "今度ゆっくりね"
  },
  {
   "location": "311/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "314/TALK",
   "narrator": "アーヤ",
   "text": "どうだった？\n今の会話。",
   "zh": "刚才的对话\n怎么样？",
   "narrator_zh": "绫水"
  },
  {
   "location": "317/TALK",
   "narrator": "みやび",
   "text": "アーヤがＢｏｔな\n振る舞いをして\nどうする？"
  },
  {
   "location": "319/TALK",
   "narrator": "みやび",
   "text": "それじゃあ全然\n検証にならんぞね。",
   "zh": "那样根本\n算不上验证咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "320/TALK",
   "narrator": "みやび",
   "text": "定型から全く\nはみ出しとらん。"
  },
  {
   "location": "321/TALK",
   "narrator": "みやび",
   "text": "今の会話なら\nＢｏｔで十分\n対応できる。"
  },
  {
   "location": "323/TALK",
   "narrator": "アーヤ",
   "text": "う…。"
  },
  {
   "location": "325/TALK",
   "narrator": "アーヤ",
   "text": "…だって……。"
  },
  {
   "location": "326/TALK",
   "narrator": "みやび",
   "text": "本当ならアーヤの\n普段の会話ログが\n欲しいところちや。"
  },
  {
   "location": "327/TALK",
   "narrator": "みやび",
   "text": "けんど、プライバシー\nにも関わる。",
   "zh": "不过，这也涉及\n隐私。",
   "narrator_zh": "雅"
  },
  {
   "location": "329/TALK",
   "narrator": "みやび",
   "text": "やき、\n無理強いはせん。"
  },
  {
   "location": "331/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "332/TALK",
   "narrator": "みやび",
   "text": "それに、曖昧に\nしといた方が\nええんかもしれんぞね。",
   "zh": "而且，含糊一点\n也许\n更好咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "335/TALK",
   "narrator": "アーヤ",
   "text": "それは…。",
   "zh": "那个……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "336/TALK",
   "narrator": "みやび",
   "text": "こっちはこっちで\n独自に調べたり\nしてみようと思う。",
   "zh": "这边就这边，\n我打算自己\n独自查一查。",
   "narrator_zh": "雅"
  },
  {
   "location": "337/TALK",
   "narrator": "みやび",
   "text": "協力は大歓迎ぞね。\nいつでも来たらええ。"
  },
  {
   "location": "339/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "340/TALK",
   "narrator": "みやび",
   "text": "今日の話は\n終わりでえいかね？"
  },
  {
   "location": "342/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "346/TALK",
   "narrator": "アーヤ",
   "text": "そうね。\nありがとう。",
   "zh": "是啊。\n谢谢。",
   "narrator_zh": "绫水"
  },
  {
   "location": "188/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>5月某日　8:47 PM</color>\n平日の夜、みやびの部屋にて。"
  }
 ]
}
