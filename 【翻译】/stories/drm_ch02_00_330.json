            "narrator": "アーヤ",
            "text": "$handle$さん",
            "zh": "$handle$",
            "narrator_zh": "绫水"
        },
        {
            "location": "298/TALK",
            "narrator": "アーヤ",
            "text": "相談があるんだけど",
            "zh": "有件事想商量",
            "narrator_zh": "绫水"
        },
        {
            "location": "299/TALK",
            "narrator": "アーヤ",
            "text": "今って平気？ヾ(･･ )",
            "zh": "现在方便吗？ヾ(･･ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "301/SEL",
            "narrator": "",
            "text": "悩んでるみたいだね",
            "zh": "好像挺烦恼的",
            "narrator_zh": ""
        },
        {
            "location": "302/ACT",
            "narrator": "",
            "text": "悩んでるみたいだね",
            "zh": "好像挺烦恼的",
            "narrator_zh": ""
        },
        {
            "location": "304/TALK",
            "narrator": "アーヤ",
            "text": "見てたの？",
            "zh": "你看见了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "305/TALK",
            "narrator": "アーヤ",
            "text": "なんか恥ずかしい(*^^*)",
            "zh": "总觉得不好意思(*^^*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "306/TALK",
            "narrator": "アーヤ",
            "text": "あのね",
            "zh": "那个啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "307/TALK",
            "narrator": "アーヤ",
            "text": "今度ボランティアで着ていく服なんだけど",
            "zh": "是这次志愿者要穿的衣服",
            "narrator_zh": "绫水"
        },
        {
            "location": "308/TALK",
            "narrator": "アーヤ",
            "text": "どんなのにするか悩んでるの",
            "zh": "我在烦恼要什么样的",
            "narrator_zh": "绫水"
        },
        {
            "location": "309/TALK",
            "narrator": "アーヤ",
            "text": "動きやすさ優先か",
            "zh": "优先好活动",
            "narrator_zh": "绫水"
        },
        {
            "location": "310/TALK",
            "narrator": "アーヤ",
            "text": "アップリケとか付いた子供向けか",
            "zh": "还是带贴布、给小孩看的",
            "narrator_zh": "绫水"
        },
        {
            "location": "311/TALK",
            "narrator": "アーヤ",
            "text": "劇に合わせたヒラヒラ系か",
