            "narrator_zh": "绫水"
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "どうしたらいいと思う？（￣ー￣？）",
            "zh": "你觉得该怎么办？(￣▽￣？)",
            "narrator_zh": "绫水"
        },
        {
            "location": "314/SEL",
            "narrator": "",
            "text": "$me$がアドバイスしていいの？",
            "zh": "$me$可以给点建议吗？",
            "narrator_zh": ""
        },
        {
            "location": "315/ACT",
            "narrator": "",
            "text": "$me$がアドバイスしていいの？",
