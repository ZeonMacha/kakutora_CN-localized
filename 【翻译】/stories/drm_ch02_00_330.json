            "narrator": "",
            "text": "彼氏の役目",
            "zh": "男朋友的职责",
            "narrator_zh": ""
        },
        {
            "location": "280/TALK",
            "narrator": "アーヤ",
            "text": "うーん…、\nどれがいいかしら？",
            "zh": "嗯……\n选哪个好呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "281/TALK",
            "narrator": "アーヤ",
            "text": "これは前に着たし、\nこっちのは今回はちょっと\n合わない気がするし…。",
            "zh": "这件之前穿过，\n这件这次感觉\n不太合适……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "282/TALK",
            "narrator": "アーヤ",
            "text": "…作る？",
            "zh": "……做吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "283/TALK",
            "narrator": "アーヤ",
            "text": "いやいや、無理でしょ。\n今からじゃさすがに時間も\n足りないし…。",
            "zh": "不是不是，不行吧。\n现在开始时间\n也来不及……",
            "narrator_zh": "绫水"
