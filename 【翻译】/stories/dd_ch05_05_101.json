{
 "dir": "chap05/daydra/dd_ch05_05_101.js",
 "type": "MainStory",
 "info": {
  "story_id": "5502",
  "cid": "kagura",
  "title": "002 メインストーリー",
  "sub_title": "しろいこ＜前編＞",
  "title_zh": "002 主线剧情",
  "sub_title_zh": "白色的孩子＜前篇＞"
 },
 "entry": [
  {
   "location": "1367/TALK",
   "narrator": "？？？",
   "text": "――神楽さん。",
   "zh": "——神乐。",
   "narrator_zh": "？？？"
  },
  {
   "location": "1368/TALK",
   "narrator": "？？？",
   "text": "一之宮神楽さん。",
   "zh": "一之宫神乐。",
   "narrator_zh": "？？？"
  },
  {
   "location": "1369/TALK",
   "narrator": "神楽",
   "text": "…あなたは、誰？\nどうして私の名前を…？",
   "zh": "……你是，谁？\n为什么知道我的名字……？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1370/TALK",
   "narrator": "？？？",
   "text": "わたしは――",
   "zh": "我是——",
   "narrator_zh": "？？？"
  },
  {
   "location": "1371/TALK",
   "narrator": "？？？",
   "text": "逢瀬つばめ。",
   "zh": "逢濑燕。",
   "narrator_zh": "？？？"
  },
  {
   "location": "1373/TALK",
   "narrator": "神楽",
   "text": "ッ！？",
   "zh": "唔！？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1374/TALK",
   "narrator": "神楽",
   "text": "あなたが…あなたが、\n逢瀬つばめなんですか？",
   "zh": "你就是……你就是\n逢濑燕吗？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1375/TALK",
   "narrator": "？？？",
   "text": "そうですよ、\n一之宮神楽さん。",
   "zh": "是的，\n一之宫神乐。",
   "narrator_zh": "？？？"
  },
  {
   "location": "1376/TALK",
   "narrator": "神楽",
   "text": "あなたが…、\nあなたのせいで、\n私たちは…。",
   "zh": "都是你……\n都是因为你，\n我们才……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "1377/TALK",
   "narrator": "神楽",
   "text": "覚悟してください。\n私は、あなたを――",
   "zh": "做好觉悟。\n我要，把你——",
   "narrator_zh": "神乐"
  },
  {
   "location": "1378/TALK",
   "narrator": "？？？",
   "text": "壊そうというのですよね？\n愚かなことです。",
   "zh": "想毁掉我，对吧？\n真是愚蠢。",
   "narrator_zh": "？？？"
  },
  {
   "location": "1379/TALK",
   "narrator": "神楽",
   "text": "黙れ！！",
   "zh": "闭嘴！！",
   "narrator_zh": "神乐"
  },
  {
   "location": "1380/TALK",
   "narrator": "神楽",
   "text": "おまえがいなければ…っ！！\nおまえさえいなければ！！",
   "zh": "你要是不在……！！\n只要没有你！！",
   "narrator_zh": "神乐"
  },
  {
   "location": "1381/TALK",
   "narrator": "？？？",
   "text": "…ごめんなさい。",
   "zh": "……对不起。",
   "narrator_zh": "？？？"
  },
  {
   "location": "1383/TALK",
   "narrator": "？？？",
   "text": "あなたには、随分と\n辛い目にあわせて\nしまったようで…。",
   "zh": "好像让你\n吃了不少\n苦……。",
   "narrator_zh": "？？？"
  },
  {
   "location": "1384/TALK",
   "narrator": "神楽",
   "text": "ふざけるな！！\n謝って済むことじゃない！！",
   "zh": "少开玩笑！！\n道个歉就算了吗！！",
   "narrator_zh": "神乐"
  },
  {
   "location": "1386/TALK",
   "narrator": "？？？",
   "text": "わかってます。\n問題はあなたと…。",
   "zh": "我知道。\n问题在于你，还有……。",
   "narrator_zh": "？？？"
  },
  {
   "location": "1387/TALK",
   "narrator": "？？？",
   "text": "あなたの周りの人達に\n差をつけてしまった\nこと…。",
   "zh": "在你身边的人之间\n拉开了差距\n这件事……。",
   "narrator_zh": "？？？"
  },
  {
   "location": "1389/TALK",
   "narrator": "？？？",
   "text": "皆が平等に不幸なら、\nそれが不幸では\nなくなるから。",
   "zh": "如果大家都同样不幸，\n那就不再是\n不幸了。",
   "narrator_zh": "？？？"
  },
  {
   "location": "1390/TALK",
   "narrator": "神楽",
   "text": "は？　なにを言って――",
   "zh": "哈？　你在说什——",
   "narrator_zh": "神乐"
  },
  {
   "location": "1391/TALK",
   "narrator": "？？？",
   "text": "ですからお詫びに、\n貴方も壊してあげます。",
   "zh": "所以作为赔礼，\n也把你毁掉。",
   "narrator_zh": "？？？"
  },
  {
   "location": "1392/TALK",
   "narrator": "神楽",
   "text": "ッ！？",
   "zh": "唔！？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1393/TALK",
   "narrator": "？？？",
   "text": "あなたのお父さんや、\nお母さんと同じように！",
   "zh": "和你的父亲、\n母亲一样！",
   "narrator_zh": "？？？"
  },
  {
   "location": "1394/TALK",
   "narrator": "神楽",
   "text": "や――",
   "zh": "住——",
   "narrator_zh": "神乐"
  },
  {
   "location": "1395/TALK",
   "narrator": "神楽",
   "text": "やめてーーーーーっ！！！",
   "zh": "住手——————！！！",
   "narrator_zh": "神乐"
  },
  {
   "location": "1408/TALK",
   "narrator": "透明神楽",
   "text": "――っ！？",
   "zh": "——唔！？",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "1409/TALK",
   "narrator": "透明神楽",
   "text": "…あ、れ？",
   "zh": "……咦？",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "1413/TALK",
   "narrator": "透明神楽",
   "text": "…そっか。",
   "zh": "……是这样。",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "1415/TALK",
   "narrator": "透明神楽",
   "text": "私…、失敗したんだ…。",
   "zh": "我……失败了……。",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "1417/TALK",
   "narrator": "透明神楽",
   "text": "立てるかな……",
   "zh": "站得起来吗……",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "1418/TALK",
   "narrator": "透明神楽",
   "text": "――っと",
   "zh": "——嘿",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "1434/TALK",
   "narrator": "神楽",
   "text": "はぁ……\n酷い目にあった。",
   "zh": "哈啊……\n倒了大霉。",
   "narrator_zh": "神乐"
  },
  {
   "location": "1435/TALK",
   "narrator": "神楽",
   "text": "でも、確かにあの時、\n自分でフェノメノンを\n展開したはずなのに…。",
   "zh": "可是，那时候\n明明是我自己展开了\nPhenoMENON……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "1446/TALK",
   "narrator": "神楽",
   "text": "私がフェノメノンを\n展開した後で…。",
   "zh": "在我展开PhenoMENON\n之后……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "1447/TALK",
   "narrator": "神楽",
   "text": "誰かがまた、\n別のフェノメノンを\n展開したんだ。",
   "zh": "又有谁，\n展开了另一个\nPhenoMENON。",
   "narrator_zh": "神乐"
  },
  {
   "location": "1450/TALK",
   "narrator": "神楽",
   "text": "…最悪。\nタイミングが悪いなんて\nレベルじゃないわ…。",
   "zh": "……最糟。\n这已经不是\n时机不好的程度了……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "1452/TALK",
   "narrator": "神楽",
   "text": "そういえば…、\n私を助けようとしてくれた\nあの女の子…。",
   "zh": "说起来……\n那个想帮我的\n女孩子……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "1465/TALK",
   "narrator": "神楽",
   "text": "フェノメノンの中なのに、\n正気を保ってたような…？",
   "zh": "明明在PhenoMENON里，\n却好像保持着清醒……？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1466/TALK",
   "narrator": "神楽",
   "text": "それに最後――",
   "zh": "而且最后——",
   "narrator_zh": "神乐"
  },
  {
   "location": "1479/TALK",
   "narrator": "神楽",
   "text": "…あれも、この世界が\n用意したシナリオってこと？",
   "zh": "……那也是这个世界\n准备好的剧本吗？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1481/TALK",
   "narrator": "神楽",
   "text": "ダメ…。\nまだぼーっとしてて、\n頭が働かない…。",
   "zh": "不行……。\n还是昏沉沉的，\n脑子转不动……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "1482/TALK",
   "narrator": "神楽",
   "text": "少し寝た方がいいかも…。",
   "zh": "也许该睡一会儿……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "1485/TALK",
   "narrator": "神楽",
   "text": "でも、私…、\nこれからどうなるんだろう？",
   "zh": "可是，我……\n接下来会怎么样？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1486/TALK",
   "narrator": "神楽",
   "text": "それに、ママは…、\nどうなっちゃうんだろう？",
   "zh": "而且，妈妈……\n会变成什么样？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1496/TALK",
   "narrator": "神楽",
   "text": "え？",
   "zh": "诶？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1500/TALK",
   "narrator": "千羽鶴",
   "text": "…あら？\n起きてたのね。",
   "zh": "……哎呀？\n你醒着啊。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1501/TALK",
   "narrator": "神楽",
   "text": "…すみません。\nどちら様ですか？",
   "zh": "……不好意思。\n请问是哪位？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1502/TALK",
   "narrator": "千羽鶴",
   "text": "私は…、この世界で\nフェノメノンを対処する\n組織…。",
   "zh": "我是……在这个世界\n应对PhenoMENON的\n组织……。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1503/TALK",
   "narrator": "千羽鶴",
   "text": "情報管理庁に所属する\nエージェント。",
   "zh": "隶属情报管理厅的\n特工。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1504/TALK",
   "narrator": "神楽",
   "text": "管理庁…エージェント？",
   "zh": "管理厅……特工？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1505/TALK",
   "narrator": "千羽鶴",
   "text": "とりあえずは、\n「ちはる」と呼んで。",
   "zh": "眼下，\n就叫我“千春”。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1506/TALK",
   "narrator": "神楽",
   "text": "…はじめまして、\nちはるさん。",
   "zh": "……初次见面，\n千春。",
   "narrator_zh": "神乐"
  },
  {
   "location": "1507/TALK",
   "narrator": "千羽鶴",
   "text": "ええ…早速だけど、\n一之宮神楽。",
   "zh": "嗯……开门见山，\n一之宫神乐。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1509/TALK",
   "narrator": "神楽",
   "text": "えっ！？",
   "zh": "诶！？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1510/TALK",
   "narrator": "千羽鶴",
   "text": "あなたはＡＥＺ統一国家と\n多国籍企業群の\n密命を受けて…。",
   "zh": "你接受了AEZ统一国家\n和跨国企业群的\n密令……。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1511/TALK",
   "narrator": "千羽鶴",
   "text": "このゾルタクスゼイアンに\nやってきた。",
   "zh": "来到了这个\nZoltaxian。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1512/TALK",
   "narrator": "神楽",
   "text": "えっ！？\nはぁっ――！？　",
   "zh": "诶！？\n哈——！？　",
   "narrator_zh": "神乐"
  },
  {
   "location": "1513/TALK",
   "narrator": "神楽",
   "text": "な、なんで！？\nどうして――",
   "zh": "为、为什么！？\n怎么会——",
   "narrator_zh": "神乐"
  },
  {
   "location": "1514/TALK",
   "narrator": "神楽",
   "text": "何故…そのことを\n知ってるんですか……。",
   "zh": "为什么……这件事\n你会知道……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "1515/TALK",
   "narrator": "千羽鶴",
   "text": "けれども、\nその特務は失敗した…。",
   "zh": "然而，\n那项特务失败了……。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1516/TALK",
   "narrator": "神楽",
   "text": "…あなたは、\n何者なんですか？",
   "zh": "……你，\n到底是什么人？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1518/TALK",
   "narrator": "千羽鶴",
   "text": "そこは重要じゃない。",
   "zh": "那一点不重要。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1519/TALK",
   "narrator": "千羽鶴",
   "text": "私は、あまり回りくどい\n言い方や駆け引きが\n好きではない。",
   "zh": "我不太喜欢\n拐弯抹角的说法\n和交锋。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1520/TALK",
   "narrator": "千羽鶴",
   "text": "だから、あなたが\n知っていると思われる\n事柄。",
   "zh": "所以，你大概\n已经知道的\n那些事。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1521/TALK",
   "narrator": "千羽鶴",
   "text": "抱えていると思われる\n事情については\n全て割愛し…。",
   "zh": "你大概背负着的\n那些原委，\n全部省略……。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1522/TALK",
   "narrator": "千羽鶴",
   "text": "交渉から入ることにする。",
   "zh": "直接从谈判开始。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1523/TALK",
   "narrator": "神楽",
   "text": "…な、なんなの、\nこの人は？",
   "zh": "……这、这人\n是怎么回事？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1524/TALK",
   "narrator": "千羽鶴",
   "text": "一之宮神楽。\nあなたは『彼ら』の特命を\n全うできなかった。",
   "zh": "一之宫神乐。\n你没能完成\n『他们』的特命。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1525/TALK",
   "narrator": "千羽鶴",
   "text": "この後、リベンジできる\n可能性はないとは\n言わないけど…。",
   "zh": "之后，不是说\n没有翻盘的\n可能……。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1526/TALK",
   "narrator": "千羽鶴",
   "text": "かなり難しいと思う。",
   "zh": "我觉得相当难。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1527/TALK",
   "narrator": "神楽",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "神乐"
  },
  {
   "location": "1528/TALK",
   "narrator": "千羽鶴",
   "text": "だから私は、貴方にとって\n朗報となるであろう話を\n今からしたいと思う。",
   "zh": "所以我想现在说一件\n对你而言\n该是好消息的事。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1529/TALK",
   "narrator": "千羽鶴",
   "text": "一之宮神楽…。\n私と情報管理庁に\n協力して。",
   "zh": "一之宫神乐……。\n来协助我和\n情报管理厅。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1530/TALK",
   "narrator": "千羽鶴",
   "text": "そうすれば、あなたが\n欲しいものは全部、\n私がなんとかする。",
   "zh": "那样的话，你想要的\n一切，\n都由我来想办法。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1531/TALK",
   "narrator": "神楽",
   "text": "…なに言ってるの？\n私がほしいもの\n全部って…。",
   "zh": "……你在说什么？\n我想要的\n一切是指……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "1532/TALK",
   "narrator": "神楽",
   "text": "…例えば？\nあなたが私に、\nなにをしてくれるんですか？",
   "zh": "……比如？\n你能为我，\n做些什么？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1534/TALK",
   "narrator": "千羽鶴",
   "text": "あなたの母、卯月美佐子に\nクラン・スピネルを\n戻してあげることができる。",
   "zh": "我可以让你的母亲，卯月美佐子\n把库兰·尖晶石\n找回来。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1535/TALK",
   "narrator": "千羽鶴",
   "text": "そして、母子共に\nフランスへ帰国\nできるようにしてあげる。",
   "zh": "而且，让母女一起\n能够回到\n法国。",
   "narrator_zh": "千羽鹤"
  },
