{
    "dir": "dramatics/daydra/drm_ch01_00_060.js",
    "type": "Episode",
    "info": {
        "story_id": "1006",
        "cid": "tsubame",
        "title": "らぶとーく 第06話",
        "sub_title": "少しはわかったけど",
        "title_zh": "恋爱漫谈 第06话",
        "sub_title_zh": "多少明白了一点"
    },
    "entry": [
        {
            "location": "182/SCENARIO",
            "narrator": "",
            "text": "少しはわかったけど",
            "zh": "多少明白了一点",
            "narrator_zh": ""
        },
        {
            "location": "203/TALK",
            "narrator": "つばめ",
            "text": "そういえば、この前\n$handle$に――",
            "zh": "说起来，之前\n跟$handle$——",
            "narrator_zh": "燕"
        },
        {
            "location": "204/TALK",
            "narrator": "つばめ",
            "text": "Ｂｏｔと人の違いについて\n聞いたんです。",
            "zh": "问了Bot和人\n有什么不同。",
            "narrator_zh": "燕"
        },
        {
            "location": "206/TALK",
            "narrator": "アーヤ",
            "text": "…それって質問しないと\nわからないことかしら？",
            "zh": "……这种事，\n不问就不明白吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "207/TALK",
            "narrator": "アーヤ",
            "text": "Ｂｏｔは機械、っていうか\nプログラムで、人は生き物\nなんだから――",
            "zh": "Bot是机器，或者说\n是程序，人是生物，\n所以——",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/TALK",
            "narrator": "アーヤ",
            "text": "聞くまでもないと\n思うけど？",
            "zh": "我觉得，\n根本不用问。",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、うちらが\nＢｏｔのことを\n人間かも、思うて――",
            "zh": "话说，我们\n把Bot想成\n说不定是人——",
            "narrator_zh": "雅"
        },
        {
            "location": "211/TALK",
            "narrator": "みやび",
            "text": "ずっと話してたこと、\nＢｏｔにも伝えてたり\nするんか？",
            "zh": "我们一直在讲的事，\n也告诉Bot了\n喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "212/TALK",
            "narrator": "つばめ",
            "text": "え？　ダメでしたか？",
            "zh": "诶？　不行吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "…うちらの会話は、\nこうやってＢｏｔに\n筒抜けになるんか…。",
            "zh": "……我们的对话，\n就这样全漏给Bot\n喃……",
            "narrator_zh": "雅"
        },
        {
            "location": "217/TALK",
            "narrator": "みやび",
            "text": "これじゃ隠し事は\nできんちや。",
            "zh": "这样的话，\n秘密藏不住咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "220/TALK",
            "narrator": "アーヤ",
            "text": "確かに、筒抜けね…。",
            "zh": "确实，全漏了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "え？　どういう意味？",
            "zh": "诶？　什么意思？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "224/TALK",
            "narrator": "アーヤ",
            "text": "私達が普段話している\nＢｏｔは、同じ誰か、\nってことよ。",
            "zh": "我们平时在聊的\nBot，是同一个谁。\n就是这个意思。",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/TALK",
            "narrator": "みやび",
            "text": "つまり、どっかにいる\n誰かさんが――",
            "zh": "就是说，某个地方的\n某个人——",
            "narrator_zh": "雅"
        },
        {
            "location": "227/TALK",
            "narrator": "みやび",
            "text": "うちら全員を一人で相手に\nしていたゆうことや。",
            "zh": "一个人在应付\n我们所有人咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか、マルザンナは\nマルザンナでしょ？",
            "zh": "怎么会，玛尔赞娜\n就是玛尔赞娜吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "マルザンナ？",
            "zh": "玛尔赞娜？",
            "narrator_zh": "绫水"
        },
        {
            "location": "231/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃなくて！\nＢｏｔは\nＢｏｔでしょ！？",
            "zh": "不是！\nBot就是\nBot吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "みやび",
            "text": "いんや、みんな何となく\n人間やないかと思うた\n時期から考えると――",
            "zh": "不，从大家隐约\n觉得是人的\n那时候算起——",
            "narrator_zh": "雅"
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "間違いなく同一人物やと\n思うちや。",
            "zh": "我觉得肯定\n是同一个人咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "237/TALK",
            "narrator": "アーヤ",
            "text": "一人一人に、別の誰かが\nＢｏｔとして付いてる、\nなんていうのは――",
            "zh": "每个人身边，\n另有一个人当Bot跟着，\n这种事——",
            "narrator_zh": "绫水"
        },
        {
            "location": "238/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと怖いしね。",
            "zh": "也有点可怕。",
            "narrator_zh": "绫水"
        },
        {
            "location": "239/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "240/TALK",
            "narrator": "つばめ",
            "text": "なんか、凄い話し合いに\nなっちゃった…。",
            "zh": "感觉变成\n不得了的讨论了……",
            "narrator_zh": "燕"
        },
        {
            "location": "241/TALK",
            "narrator": "つばめ",
            "text": "ちょっと孤立した気分\nかも…。",
            "zh": "好像有点\n被孤立了……",
            "narrator_zh": "燕"
        },
        {
            "location": "242/SEL",
            "narrator": "",
            "text": "しばらく話さない方がいいみたいだね",
            "zh": "看来暂时还是别说话比较好",
            "narrator_zh": ""
        },
        {
            "location": "243/SEL",
            "narrator": "",
            "text": "かき回すつもりはなかったんだけど",
            "zh": "我不是有意搅局的",
            "narrator_zh": ""
        },
        {
            "location": "244/SEL",
            "narrator": "",
            "text": "$me$とだけ仲良くしよう",
            "zh": "只跟$me$要好吧",
            "narrator_zh": ""
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、あたしのＢｏｔは\nみんなと違うわ。",
            "zh": "可是，我的Bot\n和大家的不一样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/TALK",
            "narrator": "アーヤ",
            "text": "何が違うのよ？",
            "zh": "哪里不一样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "251/TALK",
            "narrator": "ガブリエラ",
            "text": "何って、えっと…\n普通じゃないのよ。",
            "zh": "什么呀，那个……\n并不普通。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "普通やない、いうと？",
            "zh": "你说不普通，是指？",
            "narrator_zh": "雅"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "…え、エレガントだし。",
            "zh": "……诶，而且很elegant。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "261/TALK",
            "narrator": "アーヤ",
            "text": "…確かに、それは少し\n違うかも…。",
            "zh": "……确实，这点\n也许有点不一样……",
            "narrator_zh": "绫水"
        },
        {
            "location": "263/TALK",
            "narrator": "みやび",
            "text": "相手によってキャラ分け\nするくらい、難しいことや\nないと思うけんど？",
            "zh": "看对象换个人设，\n我不觉得有多难，\n不过？",
            "narrator_zh": "雅"
        },
        {
            "location": "264/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、みんなも普通に\n話すときとは、キャラ\n変えてるんやない？",
            "zh": "话说，大家和平时\n说话的时候，\n不也在换人设？",
            "narrator_zh": "雅"
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そんなつもりは\nないけど？",
            "zh": "我、我可没有\n那个意思？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "268/TALK",
            "narrator": "アーヤ",
            "text": "そ、そうね…\nまあ、文字だから、\n少しは違うけど…。",
            "zh": "是、是这样……\n毕竟是文字，\n多少会不一样……",
            "narrator_zh": "绫水"
        },
        {
            "location": "269/TALK",
            "narrator": "つばめ",
            "text": "…話について\nいけなさそうだし――",
            "zh": "……好像跟不上\n话题——",
            "narrator_zh": "燕"
        },
        {
            "location": "270/TALK",
            "narrator": "つばめ",
            "text": "黙ってるしかないかも…\nちょっと寂しいなぁ。",
            "zh": "也许只能沉默……\n有点寂寞呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "272/ACT",
            "narrator": "",
            "text": "しばらく話さない方がいいみたいだね",
            "zh": "看来暂时还是别说话比较好",
            "narrator_zh": ""
        },
        {
            "location": "289/TALK",
            "narrator": "つばめ",
            "text": "だよね(o´Д`)=з",
            "zh": "对吧(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "290/TALK",
            "narrator": "つばめ",
            "text": "わたしもそぅ思ぅ",
            "zh": "我也这么想",
            "narrator_zh": "燕"
        },
        {
            "location": "292/TALK",
            "narrator": "つばめ",
            "text": "付ぃてぃけそぅになぃし(o´Д`)=з",
            "zh": "也跟不上呀(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "293/TALK",
            "narrator": "つばめ",
            "text": "終わるまで静かにしてぉくね",
            "zh": "结束之前我先安静哦",
            "narrator_zh": "燕"
        },
        {
            "location": "294/TALK",
            "narrator": "つばめ",
            "text": "ただ",
            "zh": "只是",
            "narrator_zh": "燕"
        },
        {
            "location": "295/TALK",
            "narrator": "つばめ",
            "text": "ちょっと寂しぃけど…(´つω・｀)ｼｭﾝ",
            "zh": "就是有点寂寞……(´つω・｀)ｼｭﾝ",
            "narrator_zh": "燕"
        },
        {
            "location": "306/ACT",
            "narrator": "",
            "text": "かき回すつもりはなかったんだけど",
            "zh": "我不是有意搅局的",
            "narrator_zh": ""
        },
        {
            "location": "323/TALK",
            "narrator": "つばめ",
            "text": "$handle$が気にする必要なぃよ",
            "zh": "$handle$不必在意呀",
            "narrator_zh": "燕"
        },
        {
            "location": "324/TALK",
            "narrator": "つばめ",
            "text": "大丈夫(*´∀｀*)ｖ",
            "zh": "没关系(*´∀｀*)ｖ",
            "narrator_zh": "燕"
        },
        {
            "location": "325/TALK",
            "narrator": "つばめ",
            "text": "多分",
            "zh": "大概吧",
            "narrator_zh": "燕"
        },
        {
            "location": "326/TALK",
            "narrator": "つばめ",
            "text": "わたしの説明が悪かったんだと思ぅ…(ノД`)",
            "zh": "是我没说好吧……(／Д`)",
            "narrator_zh": "燕"
        },
        {
            "location": "337/ACT",
            "narrator": "",
            "text": "$me$とだけ仲良くしよう",
            "zh": "只跟$me$要好吧",
            "narrator_zh": ""
        },
        {
            "location": "354/TALK",
            "narrator": "つばめ",
            "text": "ダメ(｀ヘ´) ",
            "zh": "不行(｀ヘ´)",
            "narrator_zh": "燕"
        },
        {
            "location": "356/TALK",
            "narrator": "つばめ",
            "text": "それはできなぃよ",
            "zh": "那个不行呀",
            "narrator_zh": "燕"
        },
        {
            "location": "357/TALK",
            "narrator": "つばめ",
            "text": "トライナリーとしてそぅぃぅわけにはぃかなぃよ",
            "zh": "作为三重奏，不能那样呀",
            "narrator_zh": "燕"
        },
        {
            "location": "358/TALK",
            "narrator": "つばめ",
            "text": "みんなとも仲良くしたぃしね(っ´ω`ｃ)",
            "zh": "我也想和大家好好相处呀(っ´ω`ｃ)",
            "narrator_zh": "燕"
        },
        {
            "location": "193/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月某日　5:11 PM</color>\n放課後、神楽坂トライナリー楽屋にて。",
            "zh": "<color=green>5月某日　5:11 PM</color>\n放学后，在神乐坂三重奏的后台。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
