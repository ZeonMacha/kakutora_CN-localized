{
    "dir": "chap15/daydra/dd_ch05_15_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "15502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "オンラインなのに＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "明明在线却＜前篇＞"
    },
    "entry": [
        {
            "location": "1338/TALK",
            "narrator": "神楽",
            "text": "さあ、つばめさん。\n今度はこのお店ですよ！",
            "zh": "来，燕。\n这次是这家店哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1339/TALK",
            "narrator": "つばめ",
            "text": "う、うん…。",
            "zh": "嗯、嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1344/TALK",
            "narrator": "神楽",
            "text": "どうしたんですか？\n怯えてるみたいですけど？",
            "zh": "怎么了？\n看起来有点害怕？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1346/TALK",
            "narrator": "つばめ",
            "text": "だ、だって、ここも\n薄い本のお店でしょ？",
            "zh": "因、因为，这里也是\n卖薄本的店吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "1348/TALK",
            "narrator": "神楽",
            "text": "もぉ、違いますよ。\n置いてある本を\nよく見てください。",
            "zh": "真是的，不是哦。\n请好好看看\n摆着的书。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1349/TALK",
            "narrator": "神楽",
            "text": "どれも近所の本屋さんで\n売ってる、普通の本です。",
            "zh": "哪本都是附近书店\n在卖的普通书。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1351/TALK",
            "narrator": "つばめ",
            "text": "…あ、本当だ。\n普通の本を売ってる\nお店もあったんだね。",
            "zh": "……啊，真的。\n也有卖普通书的\n店呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "1353/TALK",
            "narrator": "神楽",
            "text": "もちろんです。\n特にこのお店は\n種類が豊富で…。",
            "zh": "当然。\n尤其这家店\n种类很多……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1357/TALK",
            "narrator": "神楽",
            "text": "ここはラノベと漫画だけ\n置いてあるお店なんです！",
            "zh": "这里是只放轻小说和漫画的\n店哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1361/TALK",
            "narrator": "つばめ",
            "text": "す、すごい！！\nそんなお店あるんだね。",
            "zh": "好、好厉害！！\n还有这种店呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "1362/TALK",
            "narrator": "つばめ",
            "text": "でも…、こんなにあったら\nどれを読めばいいか\n迷っちゃうよ…。",
            "zh": "可是……这么多的话，\n该读哪本\n会犹豫呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1363/TALK",
            "narrator": "神楽",
            "text": "んっふっふ…、\n安心してください。",
            "zh": "唔呼呼……\n请放心。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1365/TALK",
            "narrator": "神楽",
            "text": "つばめさんが\n迷ったりしないために、\nこの私がいるんです！",
            "zh": "为了不让燕\n犹豫，\n我才会在这里！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1366/TALK",
            "narrator": "つばめ",
            "text": "そ、そっか…。\nちなみに、卯月さんの\nオススメはどれ？",
            "zh": "原、原来……。\n那卯月\n推荐哪一本？",
            "narrator_zh": "燕"
        },
        {
            "location": "1367/TALK",
            "narrator": "神楽",
            "text": "ダダマホです！！",
            "zh": "达达玛霍！！[?]",
            "narrator_zh": "神乐"
        },
        {
            "location": "1369/TALK",
            "narrator": "つばめ",
            "text": "だ、ダダダホ？",
            "zh": "达、达达达霍？",
            "narrator_zh": "燕"
        },
        {
            "location": "1370/TALK",
            "narrator": "神楽",
            "text": "ダダマホ！",
            "zh": "达达玛霍！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1371/TALK",
            "narrator": "神楽",
            "text": "妹がダダこねるから\n魔法学校落第しちゃった\nテヘペロの略です。",
            "zh": "是「妹妹一耍赖\n就从魔法学校落第的\n嘿嘿吐舌」的缩写。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1372/TALK",
            "narrator": "つばめ",
            "text": "…た、タイトル長すぎない？",
            "zh": "……标、标题会不会太长了？",
            "narrator_zh": "燕"
        },
        {
            "location": "1373/TALK",
            "narrator": "神楽",
            "text": "最近はこれがデフォですよ。",
            "zh": "最近这就是默认的了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1374/TALK",
            "narrator": "神楽",
            "text": "僕の魔王はオンラインなのに\nオフライン、みたいに。",
            "zh": "就像《我的魔王明明在线却\n离线》那样。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1375/TALK",
            "narrator": "つばめ",
            "text": "…略すと、ボクマオ？",
            "zh": "……缩写的话，是「我魔王」？",
            "narrator_zh": "燕"
        },
        {
            "location": "1376/TALK",
            "narrator": "神楽",
            "text": "オンオフです。",
            "zh": "是「在线离线」。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1378/TALK",
            "narrator": "神楽",
            "text": "でも、私はダダマホの方を\nオススメしますね。",
            "zh": "不过，我还是更推荐\n达达玛霍。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1379/TALK",
            "narrator": "神楽",
            "text": "なんと言っても、\n妹のサクラちゃんが\n本当に健気で尊くて――",
            "zh": "不管怎么说，\n妹妹樱\n真的又懂事，又太尊了——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1388/TALK",
            "narrator": "神楽",
            "text": "――と、あらすじだけ\n簡単に説明するなら、\nこんな内容なんです。",
            "zh": "——要是只把简介\n简单讲一讲，\n就是这样的内容。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1390/TALK",
            "narrator": "つばめ",
            "text": "す、すごいよ！\n卯月さんの説明、\nとってもわかりやすかった！",
            "zh": "好、好厉害哦！\n卯月的说明，\n非常好懂！",
            "narrator_zh": "燕"
        },
        {
            "location": "1391/TALK",
            "narrator": "神楽",
            "text": "大好きな作品ですからね。",
            "zh": "因为是我很喜欢的作品。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1392/TALK",
            "narrator": "神楽",
            "text": "ボロボロになって、\n買い直すくらいは\n読み直してますから。",
            "zh": "都读到破破烂烂，\n破了就再买一本\n重读。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1393/TALK",
            "narrator": "つばめ",
            "text": "楽しそうだなぁ…。\nわたし、それ買おうかな？",
            "zh": "好像很有意思……。\n我，要不要买下来呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "1394/TALK",
            "narrator": "神楽",
            "text": "いいんですか？\n他にも面白い作品は\nまだまだあるのに…。",
            "zh": "可以吗？\n有意思的作品\n还有好多……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1396/TALK",
            "narrator": "つばめ",
            "text": "えぇーっ！？",
            "zh": "诶诶——！？",
            "narrator_zh": "燕"
        },
        {
            "location": "1397/TALK",
            "narrator": "神楽",
            "text": "ふふっ…例えば、\nアップリアリアリスティック\nとかだと…。",
            "zh": "呵呵……比如说，\n超超写实[?]\n之类的话……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1398/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1399/TALK",
            "narrator": "つばめ",
            "text": "あれ？　卯月さん、\nどうかしたの？",
            "zh": "咦？　卯月，\n怎么了？",
            "narrator_zh": "燕"
        },
        {
            "location": "1400/TALK",
            "narrator": "神楽",
            "text": "あ、いえ…、別に…。",
            "zh": "啊，没有……没什么……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1402/TALK",
            "narrator": "神楽",
            "text": "いけない…つい目的を\n忘れて夢中になってたわ…。",
            "zh": "不行……不小心把目的\n忘了，还入迷了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1403/TALK",
            "narrator": "神楽",
            "text": "今日こうして秋葉原に\n来てるのは、つばめさんの\n素顔を探るためなのよ？",
            "zh": "今天这样来秋叶原，\n是为了探燕的\n真面目吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1405/TALK",
            "narrator": "神楽",
            "text": "その目的を忘れて、\n夢中でラノベの説明とか…、\nなにやってんだか…。",
            "zh": "把那个目的忘了，\n还拼命讲轻小说……\n我到底在干什么……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1407/TALK",
            "narrator": "神楽",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1408/TALK",
            "narrator": "つばめ",
            "text": "…卯月さん、大丈夫？",
            "zh": "……卯月，没事吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "1410/TALK",
            "narrator": "神楽",
            "text": "あ、はい…。\nちょっと、喋りすぎちゃった\nみたいです。",
            "zh": "啊，是的……。\n好像稍微\n说得太多了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1411/TALK",
            "narrator": "つばめ",
            "text": "そっか…。\n沢山ラノベのお話\nしてくれたもんね。",
            "zh": "这样啊……。\n因为你讲了好多\n轻小说的事呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "1412/TALK",
            "narrator": "つばめ",
            "text": "でも、そのおかげで\n興味沸いてきたよ。",
            "zh": "不过，多亏了这个，\n我也感兴趣了哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "1413/TALK",
            "narrator": "神楽",
            "text": "そうですか？\nほぼダダマホのことしか\n話してなかったのに…。",
            "zh": "是吗？\n几乎只讲了达达玛霍，\n别的都没怎么讲……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1414/TALK",
            "narrator": "つばめ",
            "text": "けど、その話をしてる\n卯月さん、とっても楽しそう\nだったから…。",
            "zh": "可是，讲这些的时候\n卯月看起来非常开心，\n所以……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1416/TALK",
            "narrator": "神楽",
            "text": "ご、ごめんなさい…。\n結局私が楽しんじゃって\nましたね…。",
            "zh": "对、对不起……。\n结果反倒是我自己\n乐在其中了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1417/TALK",
            "narrator": "つばめ",
            "text": "ううん、謝らないで。",
            "zh": "不用，别道歉。",
            "narrator_zh": "燕"
        },
        {
            "location": "1418/TALK",
            "narrator": "つばめ",
            "text": "楽しそうに話してる\n卯月さん、\nわたしは好きだな。",
            "zh": "讲得那么开心的\n卯月，\n我喜欢呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "1419/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1420/TALK",
            "narrator": "神楽",
            "text": "…私だって、\nつばめさんのことは――",
            "zh": "……就算是我，\n对燕也——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1435/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1436/TALK",
            "narrator": "神楽",
            "text": "またか…。",
            "zh": "又来了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1437/TALK",
            "narrator": "神楽",
            "text": "つばめさんに対して、\n少しでも好意的な気持ちを\n感じる度に…。",
            "zh": "每次对燕\n生出哪怕一点好意，\n就会……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1438/TALK",
            "narrator": "神楽",
            "text": "あの時のことを思い出して、\n無理矢理それを否定して\nばかり。",
            "zh": "想起那时候的事，\n硬是把那份心情\n否定掉。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1439/TALK",
            "narrator": "神楽",
            "text": "…私が、目の前にいる\nつばめさんに対して\n抱いてる感情への…。",
            "zh": "……对我，对眼前的\n燕所抱着的\n感情……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1440/TALK",
            "narrator": "神楽",
            "text": "言い訳みたいに。",
            "zh": "像是在找借口。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1442/TALK",
            "narrator": "神楽",
            "text": "…私、かっこ悪いな。",
            "zh": "……我真逊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1491/TALK",
            "narrator": "ぴょんこ",
            "text": "　",
            "zh": "……",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1520/TALK",
            "narrator": "ぴょんこ",
            "text": "久し振りに！",
            "zh": "好久不见地！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1523/TALK",
            "narrator": "ぴょんこ",
            "text": "ふたりっっっっっっっ",
            "zh": "两个人啊啊啊啊啊啊啊",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1526/TALK",
            "narrator": "ぴょんこ",
            "text": "きりっ！！",
            "zh": "独处！！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1528/SEL",
            "narrator": "",
            "text": "おちつけ！",
            "zh": "冷静！",
            "narrator_zh": ""
        },
        {
            "location": "1529/SEL",
            "narrator": "",
            "text": "ぴょんこｽｷ",
            "zh": "喜欢蹦子",
            "narrator_zh": ""
        },
        {
            "location": "1530/ACT",
            "narrator": "",
            "text": "おちつけ！",
            "zh": "冷静！",
            "narrator_zh": ""
        },
        {
            "location": "1531/TALK",
            "narrator": "ぴょんこ",
            "text": "十分落ち着いていますっ！",
            "zh": "已经非常冷静了！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1532/SEL",
            "narrator": "",
            "text": "ペッタンしないの？",
            "zh": "不啪嗒了吗？",
            "narrator_zh": ""
        },
        {
            "location": "1533/ACT",
            "narrator": "",
            "text": "ペッタンしないの？",
            "zh": "不啪嗒了吗？",
            "narrator_zh": ""
        },
        {
            "location": "1535/TALK",
            "narrator": "ぴょんこ",
            "text": "飽きましたっ！",
            "zh": "腻了！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1536/ACT",
            "narrator": "",
            "text": "ぴょんこｽｷ",
            "zh": "喜欢蹦子",
            "narrator_zh": ""
        },
        {
            "location": "1539/TALK",
            "narrator": "ぴょんこ",
            "text": "ぴょんこも\n$handle$さんが\n大好きですっっっ！！",
            "zh": "蹦子也\n最喜欢\n$handle$了！！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1540/TALK",
            "narrator": "ぴょんこ",
            "text": "両思いって\n素敵ですね♪",
            "zh": "两情相悦\n真好呀♪",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1542/TALK",
            "narrator": "ぴょんこ",
            "text": "ふぅ……",
            "zh": "呼……",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1545/TALK",
            "narrator": "ぴょんこ",
            "text": "というわけで！\nさてさて、\nここは一体どこでしょう！",
            "zh": "所以说！\n那么那么，\n这里到底是哪里！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1546/TALK",
            "narrator": "ぴょんこ",
            "text": "みやびさんの言うことが\n確かなら、ここは\n共通意識野だそうです。",
            "zh": "如果雅说的\n没错，这里\n好像是共通意识野。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1547/TALK",
            "narrator": "ぴょんこ",
            "text": "そんないつもと違う\nドキドキスポットに\n来ちゃったからには――",
            "zh": "既然来到了这种\n和平常不一样的\n心跳地点——",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1548/SEL",
            "narrator": "",
            "text": "からには…？",
            "zh": "既然来了……？",
            "narrator_zh": ""
        },
        {
            "location": "1549/ACT",
            "narrator": "",
            "text": "からには…？",
            "zh": "既然来了……？",
            "narrator_zh": ""
        },
        {
            "location": "1551/TALK",
            "narrator": "ぴょんこ",
