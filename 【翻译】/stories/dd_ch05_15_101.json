        },
        {
            "location": "1763/TALK",
            "narrator": "ぴょんこ",
            "text": "それより、葛藤を誰かに\n見られるのって、ちょっと\n恥ずかしいですねっ。",
            "zh": "比起那个，挣扎被人\n看见，有点\n害羞。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1764/TALK",
            "narrator": "つばめ",
            "text": "ああっ！\n安心して。葛藤の中身は\n全然見てないから！",
            "zh": "啊啊！\n放心。挣扎的内容\n我完全没看！",
            "narrator_zh": "燕"
        },
        {
            "location": "1765/TALK",
            "narrator": "ぴょんこ",
            "text": "いいんですよ…？\nつばめさんなら、\n全部見ていただいても♪",
            "zh": "没关系的……？\n如果是燕，\n全部看了也可以♪",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1766/TALK",
            "narrator": "つばめ",
            "text": "ええっ……！？\nそ、そうなの……？",
            "zh": "咦……！？\n是、是这样吗……？",
            "narrator_zh": "燕"
        },
        {
            "location": "1768/SEL",
            "narrator": "",
            "text": "$me$もいるよ",
            "zh": "$me$也在哦",
            "narrator_zh": ""
        },
        {
            "location": "1769/SEL",
            "narrator": "",
            "text": "よきかなよきかな",
            "zh": "善哉善哉",
            "narrator_zh": ""
        },
        {
            "location": "1770/ACT",
            "narrator": "",
            "text": "$me$もいるよ",
            "zh": "$me$也在哦",
            "narrator_zh": ""
        },
        {
            "location": "1771/ACT",
            "narrator": "",
            "text": "よきかなよきかな",
            "zh": "善哉善哉",
            "narrator_zh": ""
        },
        {
            "location": "1774/TALK",
            "narrator": "つばめ",
            "text": "あっ、\n$handle$さん、\nこんにちは！",
            "zh": "啊，\n$handle$，\n你好！",
            "narrator_zh": "燕"
        },
        {
            "location": "1776/TALK",
            "narrator": "ぴょんこ",
            "text": "そういえば、\nすっかり存在を\n忘れてました♪",
            "zh": "说起来，\n完全把你的存在\n给忘了♪",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1777/SEL",
            "narrator": "",
            "text": "酷くない？",
            "zh": "太过分了吧？",
            "narrator_zh": ""
        },
        {
            "location": "1778/SEL",
            "narrator": "",
            "text": "ぐすん",
            "zh": "呜呜",
            "narrator_zh": ""
        },
        {
            "location": "1779/ACT",
            "narrator": "",
            "text": "酷くない？",
            "zh": "太过分了吧？",
            "narrator_zh": ""
        },
        {
            "location": "1780/TALK",
            "narrator": "ぴょんこ",
            "text": "いやですね～。\n空気のように自然な仲って\nことですよ♪",
            "zh": "讨厌啦～。\n是说我们熟得\n像空气一样自然♪",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1781/ACT",
            "narrator": "",
            "text": "ぐすん",
            "zh": "呜呜",
            "narrator_zh": ""
        },
        {
            "location": "1783/TALK",
            "narrator": "ぴょんこ",
            "text": "はあっ！",
            "zh": "哈啊！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1785/TALK",
            "narrator": "ぴょんこ",
            "text": "なんかムラムラする！",
            "zh": "有点兴奋起来了！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1788/TALK",
            "narrator": "つばめ",
            "text": "ぴょんこちゃん、\n大丈夫！？\nなんか息が荒いけど……",
            "zh": "蹦子，\n没事吧！？\n呼吸好像有点急……",
            "narrator_zh": "燕"
        },
        {
            "location": "1791/TALK",
            "narrator": "ぴょんこ",
            "text": "あっ、はい！\n大丈夫ですよっ！",
            "zh": "啊，是的！\n没事的！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1793/SEL",
            "narrator": "",
            "text": "で、これからどうすれば？",
            "zh": "那接下来该怎么办？",
            "narrator_zh": ""
        },
        {
            "location": "1794/ACT",
            "narrator": "",
            "text": "で、これからどうすれば？",
            "zh": "那接下来该怎么办？",
            "narrator_zh": ""
        },
        {
            "location": "1797/TALK",
            "narrator": "つばめ",
            "text": "あっ、えっとね。",
            "zh": "啊，那个呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "1798/TALK",
            "narrator": "つばめ",
            "text": "外の世界と繋がるための\n細い橋が何処かにある\nはずなんだけど――",
            "zh": "应该有一座\n通往外面世界的\n细细的桥——",
            "narrator_zh": "燕"
        },
        {
            "location": "1799/TALK",
            "narrator": "つばめ",
            "text": "それが無くなってるか、\n壊されてるかっていう\n状況だと思うんだ。",
            "zh": "我想现在的情况是，\n它不见了，\n或者被弄坏了。",
            "narrator_zh": "燕"
        },
        {
            "location": "1800/TALK",
            "narrator": "つばめ",
            "text": "だからそれを見つけて、\n元通りにしなくちゃ。",
            "zh": "所以得找到它，\n恢复原样才行。",
            "narrator_zh": "燕"
        },
        {
            "location": "1806/TALK",
            "narrator": "ぴょんこ",
            "text": "あっ！",
            "zh": "啊！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1818/TALK",
            "narrator": "アーヤ",
            "text": "卯月、いる？",
            "zh": "卯月，在吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1820/TALK",
            "narrator": "ぴょんこ",
            "text": "いますよ～～",
            "zh": "在的～～",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1821/TALK",
            "narrator": "アーヤ",
            "text": "今どこ？",
            "zh": "现在在哪？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1822/TALK",
            "narrator": "ぴょんこ",
            "text": "共通意識野です♪",
            "zh": "共通意识野♪",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1823/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": "绫水"
        },
        {
            "location": "1824/TALK",
            "narrator": "アーヤ",
            "text": "ココロの葛藤でてるみたいだけど、処理しちゃって平気？",
            "zh": "好像出现了心的挣扎，处理掉没关系吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1825/TALK",
            "narrator": "ぴょんこ",
            "text": "助かります～～～っ！",
            "zh": "太感谢了～～～！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1826/TALK",
            "narrator": "ぴょんこ",
            "text": "アドレス教えますね♪",
            "zh": "我把地址告诉你♪",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1828/TALK",
            "narrator": "ぴょんこ",
            "text": "2x44D番地だそうです！",
            "zh": "听说是2x44D地址！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1829/TALK",
            "narrator": "アーヤ",
            "text": "わかったわ",
            "zh": "知道了",
            "narrator_zh": "绫水"
        },
        {
            "location": "1830/TALK",
            "narrator": "アーヤ",
            "text": "他のみんなと逢えた？",
            "zh": "和其他人见到了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1831/TALK",
            "narrator": "ぴょんこ",
            "text": "つばめさんとは逢えました！",
            "zh": "和燕见到了！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1832/TALK",
            "narrator": "アーヤ",
            "text": "他は？",
            "zh": "其他人呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1833/TALK",
            "narrator": "ぴょんこ",
            "text": "まだですね",
            "zh": "还没有",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1834/TALK",
            "narrator": "アーヤ",
            "text": "そう",
            "zh": "这样",
            "narrator_zh": "绫水"
        },
        {
            "location": "1835/TALK",
            "narrator": "アーヤ",
            "text": "わかった、それじゃこっちのことは心配しないで、同化の原因究明に集中してね",
            "zh": "知道了，这边不用担心，专心查同化的原因",
            "narrator_zh": "绫水"
        },
        {
            "location": "1836/TALK",
            "narrator": "ぴょんこ",
            "text": "は～い♪",
            "zh": "好～的♪",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1850/TALK",
            "narrator": "ぴょんこ",
            "text": "アーヤさんからでした。\nつばめさんによろしくと。",
            "zh": "是绫水发来的。\n让我向燕问好。",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1852/TALK",
            "narrator": "つばめ",
            "text": "あ、そっか。\n今回はアーヤさんが\n当番なんだ。",
            "zh": "啊，这样啊。\n这次是绫水\n值班呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "1853/SEL",
            "narrator": "",
            "text": "ガブリエラとみやびは？",
            "zh": "加布里埃拉和雅呢？",
            "narrator_zh": ""
        },
        {
            "location": "1854/ACT",
            "narrator": "",
            "text": "ガブリエラとみやびは？",
            "zh": "加布里埃拉和雅呢？",
            "narrator_zh": ""
        },
        {
            "location": "1857/TALK",
            "narrator": "つばめ",
            "text": "そういえば、\nまだ来てないね。",
            "zh": "说起来，\n还没来呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "1858/TALK",
            "narrator": "つばめ",
            "text": "どうしたんだろ。",
            "zh": "怎么回事呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "1860/TALK",
            "narrator": "？？？",
            "text": "残念だけど、\n二人が来ることは無い。",
            "zh": "很遗憾，\n那两个人不会来了。",
            "narrator_zh": "？？？"
        },
        {
            "location": "1862/TALK",
            "narrator": "つばめ",
            "text": "えっ！？",
            "zh": "咦！？",
            "narrator_zh": "燕"
        },
        {
            "location": "1864/TALK",
            "narrator": "ぴょんこ",
            "text": "誰ですかっ！",
            "zh": "你是谁！",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1879/TALK",
            "narrator": "ぴょんこ",
            "text": "な、なに！？",
            "zh": "什、什么！？",
            "narrator_zh": "蹦子"
        },
        {
            "location": "1880/TALK",
            "narrator": "？？？",
            "text": "卯月神楽は、\n逢瀬つばめの世界に\n同化した方がいい。",
            "zh": "卯月神乐，\n还是同化进\n逢濑燕的世界比较好。",
            "narrator_zh": "？？？"
        },
        {
            "location": "1881/TALK",
            "narrator": "？？？",
            "text": "外の世界の記憶を\n持っていても、\nただ苦しむだけ。",
            "zh": "就算留着外面世界的记忆，\n也只会\n痛苦而已。",
            "narrator_zh": "？？？"
        },
        {
            "location": "1883/TALK",
            "narrator": "つばめ",
            "text": "あなたが神楽ちゃんの、\n外の世界との接続を\n外したんですか！",
            "zh": "是你把神乐\n和外面世界的连接\n切断的吗！",
            "narrator_zh": "燕"
        },
        {
            "location": "1884/TALK",
            "narrator": "つばめ",
            "text": "元に戻してください！",
            "zh": "请把它恢复原样！",
            "narrator_zh": "燕"
        },
        {
            "location": "1885/TALK",
            "narrator": "？？？",
            "text": "……同化すれば\n全て丸く収まる。",
            "zh": "……只要同化，\n一切都会圆满。",
            "narrator_zh": "？？？"
        },
        {
            "location": "1886/SEL",
            "narrator": "",
            "text": "そんなわけないだろ！",
            "zh": "怎么可能！",
            "narrator_zh": ""
        },
        {
            "location": "1887/SEL",
            "narrator": "",
            "text": "$me$もそう思う",
            "zh": "$me$也这么想",
            "narrator_zh": ""
        },
        {
            "location": "1888/ACT",
            "narrator": "",
            "text": "そんなわけないだろ！",
            "zh": "怎么可能！",
            "narrator_zh": ""
        },
        {
            "location": "1891/ACT",
            "narrator": "",
            "text": "$me$もそう思う",
            "zh": "$me$也这么想",
            "narrator_zh": ""
        },
