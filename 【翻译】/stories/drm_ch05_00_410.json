   "text": "浜辺から"
  },
  {
   "location": "1828/TALK",
   "narrator": "神楽",
   "text": "…これで終わりに\nしたかったのに…。"
  },
  {
   "location": "1829/TALK",
   "narrator": "神楽",
   "text": "結局中途半端なままで\n作戦は失敗。"
  },
  {
   "location": "1830/TALK",
   "narrator": "神楽",
   "text": "私これから\nどうなるんだろう…？"
  },
  {
   "location": "1831/TALK",
   "narrator": "神楽",
   "text": "私これから\nどうすれば\nいいんだろう…？"
  },
  {
   "location": "1843/TALK",
   "narrator": "神楽",
   "text": "作戦は失敗した"
  },
  {
   "location": "1844/TALK",
   "narrator": "神楽",
   "text": "もう全部おしまい"
  },
  {
   "location": "1846/SEL",
   "narrator": "",
   "text": "ついに……",
   "zh": "终于……",
   "narrator_zh": ""
  },
  {
   "location": "1847/SEL",
   "narrator": "",
   "text": "$me$は神楽に着いていくから",
   "zh": "$me$会跟着神乐的",
   "narrator_zh": ""
  },
  {
   "location": "1848/SEL",
   "narrator": "",
   "text": "辛かったよね…",
   "zh": "很辛苦吧……",
   "narrator_zh": ""
  },
  {
   "location": "1849/ACT",
   "narrator": "",
   "text": "ついに……",
   "zh": "终于……",
   "narrator_zh": ""
  },
  {
   "location": "1850/TALK",
   "narrator": "神楽",
   "text": "もう",
   "zh": "真是的",
   "narrator_zh": "神乐"
  },
  {
   "location": "1852/TALK",
   "narrator": "神楽",
   "text": "どうしようもなくて",
   "zh": "没办法了",
   "narrator_zh": "神乐"
  },
  {
   "location": "1853/ACT",
   "narrator": "",
   "text": "$me$は神楽に着いていくから",
   "zh": "$me$会跟着神乐的",
   "narrator_zh": ""
  },
  {
   "location": "1854/TALK",
   "narrator": "神楽",
   "text": "うん",
   "zh": "嗯",
   "narrator_zh": "神乐"
  },
  {
   "location": "1855/TALK",
   "narrator": "神楽",
   "text": "でもなんで？",
   "zh": "可是为什么？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1856/ACT",
   "narrator": "",
   "text": "辛かったよね…",
   "zh": "很辛苦吧……",
   "narrator_zh": ""
  },
  {
   "location": "1857/TALK",
   "narrator": "神楽",
   "text": "それは",
   "zh": "这个",
   "narrator_zh": "神乐"
  },
  {
   "location": "1859/TALK",
   "narrator": "神楽",
   "text": "そうじゃないとおかしいよね",
   "zh": "不那样就很奇怪吧",
   "narrator_zh": "神乐"
  },
  {
   "location": "1861/TALK",
   "narrator": "神楽",
   "text": "じゃあね",
   "zh": "拜拜",
   "narrator_zh": "神乐"
  },
  {
   "location": "1872/TALK",
   "narrator": "神楽",
   "text": "ママ……。\n音羽……。\nごめんね……。"
  },
  {
   "location": "1873/SEL",
   "narrator": "",
   "text": "おーい",
   "zh": "喂——",
   "narrator_zh": ""
  },
  {
   "location": "1874/ACT",
   "narrator": "",
   "text": "おーい",
   "zh": "喂——",
   "narrator_zh": ""
  },
  {
   "location": "1893/SEL",
   "narrator": "",
   "text": "大丈夫…じゃないと思うけど",
   "zh": "我觉得……不算没事",
   "narrator_zh": ""
  },
  {
   "location": "1894/SEL",
   "narrator": "",
   "text": "どう言えばいいかわかんないけど",
   "zh": "不知道该怎么说",
   "narrator_zh": ""
  },
  {
   "location": "1895/SEL",
   "narrator": "",
   "text": "神楽は悪くないよ",
   "zh": "神乐没有错哦",
   "narrator_zh": ""
  },
  {
   "location": "1896/ACT",
   "narrator": "",
   "text": "大丈夫…じゃないと思うけど",
   "zh": "我觉得……不算没事",
   "narrator_zh": ""
  },
  {
   "location": "1897/TALK",
   "narrator": "神楽",
   "text": "まあね",
   "zh": "嘛",
   "narrator_zh": "神乐"
  },
  {
   "location": "1898/TALK",
   "narrator": "神楽",
   "text": "当たり前",
   "zh": "正常",
   "narrator_zh": "神乐"
  },
  {
   "location": "1899/ACT",
   "narrator": "",
   "text": "どう言えばいいかわかんないけど",
   "zh": "不知道该怎么说",
   "narrator_zh": ""
  },
  {
   "location": "1900/TALK",
   "narrator": "神楽",
   "text": "そうだろうね",
   "zh": "应该是吧",
   "narrator_zh": "神乐"
  },
  {
   "location": "1901/TALK",
   "narrator": "神楽",
   "text": "そんなもん",
   "zh": "就那点东西",
   "narrator_zh": "神乐"
  },
  {
   "location": "1902/ACT",
   "narrator": "",
   "text": "神楽は悪くないよ",
   "zh": "神乐没有错哦",
   "narrator_zh": ""
  },
  {
   "location": "1904/TALK",
   "narrator": "神楽",
   "text": "そんな嘘はやめて",
   "zh": "别撒那种谎",
   "narrator_zh": "神乐"
  },
  {
   "location": "1905/TALK",
   "narrator": "神楽",
   "text": "今は一番そういうのが辛い"
  },
  {
   "location": "1906/TALK",
   "narrator": "神楽",
   "text": "本気にしちゃうから"
  },
  {
   "location": "1908/SEL",
   "narrator": "",
   "text": "本当にそうなんだよ",
   "zh": "真的是这样哦",
   "narrator_zh": ""
  },
  {
   "location": "1909/SEL",
   "narrator": "",
   "text": "だって悪くないでしょ",
   "zh": "因为也没什么不好吧",
   "narrator_zh": ""
  },
  {
   "location": "1910/SEL",
   "narrator": "",
   "text": "神楽も被害者なんだから",
   "zh": "神乐也是受害者嘛",
   "narrator_zh": ""
  },
  {
   "location": "1911/ACT",
   "narrator": "",
   "text": "本当にそうなんだよ",
   "zh": "真的是这样哦",
   "narrator_zh": ""
  },
  {
   "location": "1912/TALK",
   "narrator": "神楽",
   "text": "だからやめて",
   "zh": "所以住手",
   "narrator_zh": "神乐"
  },
  {
   "location": "1914/TALK",
   "narrator": "神楽",
   "text": "そういうのは",
   "zh": "那种话",
   "narrator_zh": "神乐"
  },
  {
   "location": "1915/ACT",
   "narrator": "",
   "text": "だって悪くないでしょ",
   "zh": "因为也没什么不好吧",
   "narrator_zh": ""
  },
  {
   "location": "1916/TALK",
   "narrator": "神楽",
   "text": "そんなわけないし",
   "zh": "怎么可能嘛",
   "narrator_zh": "神乐"
  },
  {
   "location": "1917/TALK",
   "narrator": "神楽",
   "text": "適当言わないで"
  },
  {
   "location": "1918/ACT",
   "narrator": "",
   "text": "神楽も被害者なんだから",
   "zh": "神乐也是受害者嘛",
   "narrator_zh": ""
  },
  {
   "location": "1919/TALK",
   "narrator": "神楽",
   "text": "それとこれとは別問題",
   "zh": "那和这是两回事",
   "narrator_zh": "神乐"
  },
  {
   "location": "1933/TALK",
   "narrator": "神楽",
   "text": "つばめさん……\n大丈夫だったかな…？",
   "zh": "燕……\n没事吧……？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1934/TALK",
   "narrator": "神楽",
   "text": "…なんて私が\nそんなこと思うの\n変だけど……。",
   "zh": "……我竟然会\n想到这种事，\n虽然有点怪……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "1935/SEL",
   "narrator": "",
   "text": "神楽"
  },
  {
   "location": "1936/ACT",
   "narrator": "",
   "text": "神楽"
  },
  {
   "location": "1955/SEL",
   "narrator": "",
   "text": "あんまり自分を責めないで",
   "zh": "别太责怪自己",
   "narrator_zh": ""
  },
  {
   "location": "1956/SEL",
   "narrator": "",
   "text": "この先いいこともあるから",
   "zh": "往后也会有好事发生的",
   "narrator_zh": ""
  },
  {
   "location": "1957/SEL",
   "narrator": "",
   "text": "仕方ないことだったから",
   "zh": "因为那是没办法的事",
   "narrator_zh": ""
  },
  {
