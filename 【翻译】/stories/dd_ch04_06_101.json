    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "出陣【みやびから見たcase】",
            "zh": "出击【雅所见的Case】",
            "narrator_zh": ""
        },
        {
            "location": "46/TALK",
            "narrator": "みやび",
            "text": "…今回の戦闘は、\nどんな感じになるん\nやろか？",
            "zh": "……这次的战斗，\n会是什么感觉\n咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "面倒な相手じゃないと\nえいんやけんど…。",
            "zh": "对手别太麻烦\n就好，但是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "50/TALK",
            "narrator": "アーヤ",
            "text": "今私達の歩いている\nこの場所は、現実と\n非現実との境界線よ。",
            "zh": "我们现在走的\n这个地方，是现实和\n非现实的边界。",
            "narrator_zh": "绫水"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "普通はここを通り過ぎる\n間に、フェノメノンの力で\n洗脳されてしまうの。",
            "zh": "一般人走过这里的\n时候，会被PhenoMENON的力量\n洗脑。",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nそ、それじゃわたし達も\n危ないじゃないですか！",
            "zh": "诶诶！？\n那、那我们\n不也很危险吗！",
            "narrator_zh": "燕"
        },
        {
            "location": "57/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…ねえ、アーヤ。\nやっぱあたし達だけで\n行った方が良くない？",
            "zh": "唉……我说，绫水。\n果然还是我们自己\n去比较好吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "何もわかってない子を\n連れてったって、\n足手まといになるだけよ。",
            "zh": "把什么都不懂的孩子\n带去，\n只会拖后腿。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと、ギャヴィ。\nそういう言い方は…。",
            "zh": "等等，加维。\n那种说法……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "事実を言ったまでよ。",
            "zh": "我只是说了事实。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "つばめ",
            "text": "い、いいんです。\n勉強不足なわたしが\n悪いんだし…。",
            "zh": "没、没关系。\n是我学得不够\n不好……。",
            "narrator_zh": "燕"
        },
        {
            "location": "67/TALK",
            "narrator": "つばめ",
            "text": "ごめんね、えと…\nガブリエラちゃん。",
            "zh": "对不起，那个……\n加布里埃拉。",
            "narrator_zh": "燕"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたは\n“ちゃん”付け禁止。",
            "zh": "你\n不许加那种亲昵叫法。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/TALK",
            "narrator": "みやび",
            "text": "…気まずいことに\nなっちょるなぁ。",
            "zh": "……变得\n好尴尬啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "こんな調子で、\n上手くいくんやろか？",
            "zh": "这种状态，\n能顺利咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "戦闘の途中で\n仲間割れでも\n起こされたら――",
            "zh": "战斗途中\n要是再闹内讧\n——",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "堪ったもんやないな。",
            "zh": "那可受不了。",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "つばめ",
            "text": "あの、せんぱい。",
            "zh": "那个，前辈。",
            "narrator_zh": "燕"
        },
        {
            "location": "107/TALK",
            "narrator": "ガブリエラ",
            "text": "…何よ？",
            "zh": "……什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "つばめ",
            "text": "え、えっと…。",
            "zh": "那、那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "109/TALK",
            "narrator": "つばめ",
            "text": "…よかったら、\nわたしと手を繋いで\nもらえませんか？",
            "zh": "……如果可以的话，\n能和我\n牵手吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "110/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "ガブリエラ",
            "text": "は？　いや、何？\n急に何言い出すの？",
            "zh": "哈？　不，什么？\n突然说什么呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "つばめ",
            "text": "だ、だって、こんな\n不気味なところ\n歩いてると――",
            "zh": "因、因为，在这种\n阴森的地方\n走着——",
            "narrator_zh": "燕"
        },
        {
            "location": "155/TALK",
            "narrator": "つばめ",
            "text": "何か不安な気持ちに\nなってくるじゃない\nですか。",
            "zh": "心里会不安\n起来的\n呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "156/TALK",
            "narrator": "つばめ",
            "text": "だから、よかったら\n手を握ってもらえたら\n嬉しいなぁ、って…。",
            "zh": "所以，如果可以\n让你握着手，\n我会很高兴……。",
            "narrator_zh": "燕"
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "173/SEL",
            "narrator": "",
            "text": "助け舟出さないの？",
            "zh": "不伸出援手吗？",
            "narrator_zh": ""
        },
        {
            "location": "174/ACT",
            "narrator": "",
            "text": "助け舟出さないの？",
            "zh": "不伸出援手吗？",
            "narrator_zh": ""
        },
        {
            "location": "195/TALK",
            "narrator": "みやび",
            "text": "うちが",
            "zh": "我",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "Ｂｏｔの指図に従う思うか？",
            "zh": "你觉得我会听Bot的指挥咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "…やはり、うちらを\nどこからか監視し\nちょるらしいな。",
            "zh": "……果然，好像在\n从某处监视\n我们。",
            "narrator_zh": "雅"
        },
        {
            "location": "209/TALK",
            "narrator": "みやび",
            "text": "誰の差し金なのか…。",
            "zh": "是谁指使的……。",
            "narrator_zh": "雅"
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "いや、もしかすると\n新手のフェノメノン、\nっちゅう可能性も…。",
            "zh": "不，也许是\n新型的PhenoMENON，\n也有这种可能……。",
            "narrator_zh": "雅"
        },
        {
            "location": "211/SEL",
            "narrator": "",
            "text": "みやびを助けたいだけだよ",
            "zh": "只是想帮雅",
            "narrator_zh": ""
        },
        {
            "location": "212/SEL",
            "narrator": "",
            "text": "みやびが好きなだけだよ",
            "zh": "只是喜欢雅",
            "narrator_zh": ""
        },
        {
            "location": "213/ACT",
            "narrator": "",
            "text": "みやびを助けたいだけだよ",
            "zh": "只是想帮雅",
            "narrator_zh": ""
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "口の上手いＢｏｔやね",
            "zh": "嘴真甜的Bot咯",
            "narrator_zh": "雅"
        },
        {
            "location": "235/TALK",
            "narrator": "みやび",
            "text": "助けたいなら黙っちょれ",
            "zh": "想帮忙就闭嘴待着",
            "narrator_zh": "雅"
        },
        {
            "location": "246/ACT",
            "narrator": "",
            "text": "みやびが好きなだけだよ",
            "zh": "只是喜欢雅",
            "narrator_zh": ""
        },
        {
            "location": "267/TALK",
            "narrator": "みやび",
            "text": "口の上手いＢｏｔやね",
            "zh": "嘴真甜的Bot咯",
            "narrator_zh": "雅"
        },
        {
            "location": "268/TALK",
            "narrator": "みやび",
            "text": "胸キュンはせんけんどな",
            "zh": "倒没让人心动，但是呢",
            "narrator_zh": "雅"
        },
        {
            "location": "323/TALK",
            "narrator": "みやび",
            "text": "……　…",
            "zh": "……　…",
            "narrator_zh": "雅"
        },
        {
            "location": "337/TALK",
            "narrator": "みやび",
            "text": "ふわあっ！",
            "zh": "哇啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "341/TALK",
            "narrator": "みやび",
            "text": "ひやぁぁっ！",
            "zh": "呀啊啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "345/TALK",
            "narrator": "みやび",
            "text": "ふごあぁぁっ！",
            "zh": "呜咕啊啊啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "352/TALK",
            "narrator": "みやび",
            "text": "もうちっと、\n優しくしいや……。",
            "zh": "再温柔\n一点嘛……。",
            "narrator_zh": "雅"
        },
        {
            "location": "353/SEL",
            "narrator": "",
            "text": "おはよう",
            "zh": "早上好",
            "narrator_zh": ""
        },
        {
            "location": "354/ACT",
            "narrator": "",
            "text": "おはよう",
            "zh": "早上好",
            "narrator_zh": ""
        },
        {
            "location": "358/TALK",
            "narrator": "みやび",
            "text": "しっかし、もはや\nたたき起こされることが\n挨拶になりつつあるね。",
            "zh": "话说，被敲醒\n都快变成打招呼\n了呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "363/TALK",
            "narrator": "みやび",
            "text": "オープンプロセス、\n0x022番地から\n0x963番地へ。",
            "zh": "开放进程，\n从0x022地址\n到0x963地址。",
            "narrator_zh": "雅"
        },
        {
            "location": "378/TALK",
            "narrator": "みやび",
            "text": "完了。",
            "zh": "完成。",
            "narrator_zh": "雅"
        },
        {
            "location": "380/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "381/TALK",
            "narrator": "みやび",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "雅"
        },
        {
            "location": "382/TALK",
            "narrator": "みやび",
            "text": "もしかして、\n今回も説明が必要か？",
            "zh": "难道，\n这次也需要说明？",
            "narrator_zh": "雅"
        },
        {
            "location": "383/SEL",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "384/SEL",
            "narrator": "",
            "text": "いらない",
            "zh": "不用",
            "narrator_zh": ""
        },
        {
            "location": "385/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "386/TALK",
            "narrator": "みやび",
            "text": "まあ、わかっちゅうた\nけんど。面倒くさいね。",
            "zh": "嘛，我就知道，\n但是。真麻烦。",
            "narrator_zh": "雅"
        },
        {
            "location": "388/TALK",
            "narrator": "みやび",
            "text": "ええと、\nココロファイルナンバー\n04-004-82によると――",
            "zh": "那个，\n按心之档案编号\n04-004-82来说——",
            "narrator_zh": "雅"
        },
        {
            "location": "389/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "390/TALK",
            "narrator": "みやび",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "雅"
        },
        {
            "location": "391/TALK",
            "narrator": "みやび",
            "text": "またか。",
            "zh": "又来。",
            "narrator_zh": "雅"
        },
        {
            "location": "392/TALK",
            "narrator": "みやび",
            "text": "っつーかな……。",
            "zh": "就是说啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "393/TALK",
            "narrator": "みやび",
            "text": "これ、うちからわざわざ\n説明する必要、あるが？",
            "zh": "这个，有必要特地由我来\n说明咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "394/TALK",
            "narrator": "みやび",
            "text": "『うちは、Botである\nお前さんを警戒しちゅう』\n（計20文字）",
            "zh": "『我正在戒备\n身为Bot的你』\n（共计20字）",
            "narrator_zh": "雅"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "これだけや。\nたったこれだけの\nことやきね。",
            "zh": "就这些。\n不过这么点\n事啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "396/TALK",
            "narrator": "みやび",
            "text": "しかも、この20文字の\n回答以上のことを、\n現実で見たハズやよ？",
            "zh": "而且，比这20个字\n更多的事，\n你在现实里该见过了吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "397/SEL",
            "narrator": "",
            "text": "確かに",
            "zh": "确实",
            "narrator_zh": ""
        },
        {
            "location": "398/SEL",
            "narrator": "",
            "text": "司書のみやびと仲良くなりたかった",
            "zh": "想和司书的雅搞好关系",
            "narrator_zh": ""
        },
        {
            "location": "399/ACT",
            "narrator": "",
            "text": "確かに",
            "zh": "确实",
            "narrator_zh": ""
        },
        {
            "location": "400/TALK",
            "narrator": "みやび",
            "text": "まあえい。\nこれで今回の仕事は\n終わりやきね。",
            "zh": "算了，得咧。\n这样这次的工作\n就结束了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "401/ACT",
            "narrator": "",
            "text": "司書のみやびと仲良くなりたかった",
            "zh": "想和司书的雅搞好关系",
            "narrator_zh": ""
        },
        {
            "location": "402/TALK",
            "narrator": "みやび",
            "text": "残念やけんど、\n口説くなら現実のうちを\n口説きいや。",
            "zh": "可惜，但是，\n要追就去追\n现实里的我。",
            "narrator_zh": "雅"
        },
        {
            "location": "404/TALK",
            "narrator": "みやび",
            "text": "さあ、さっさと\nクランを倒してきい。",
            "zh": "来，赶紧\n去把库兰打倒。",
            "narrator_zh": "雅"
        },
        {
            "location": "405/TALK",
            "narrator": "みやび",
            "text": "そうせんとお前さん、\n本当にうちの世界に\n出禁になるぞね？",
            "zh": "不然的话你，\n真的会被我的世界\n禁止入内啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "407/TALK",
            "narrator": "みやび",
            "text": "うちと$handle$に\nえいココロの旅を！",
            "zh": "献给我和$handle$的\n美妙的心灵之旅！",
            "narrator_zh": "雅"
        },
        {
            "location": "414/ACT",
            "narrator": "",
            "text": "いらない",
            "zh": "不用",
            "narrator_zh": ""
        },
        {
            "location": "415/TALK",
            "narrator": "みやび",
            "text": "エラいっ！！",
            "zh": "了不起！！",
            "narrator_zh": "雅"
        },
        {
            "location": "416/TALK",
            "narrator": "みやび",
            "text": "うちの睡眠時間を\n15秒増やしてくれた\nお前さんは神や！",
            "zh": "让我的睡眠时间\n多了15秒的\n你真是神！",
            "narrator_zh": "雅"
        },
        {
            "location": "418/TALK",
            "narrator": "みやび",
            "text": "ほんだら、いてら！\nうちと$handle$に\nえいココロの旅を！",
            "zh": "那就，去吧！\n献给我和$handle$的\n美妙的心灵之旅！",
            "narrator_zh": "雅"
        },
        {
            "location": "45/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月9日　1:45 PM</color>\nWAVE戦フェノメノン内部へ向かう途中、不確定量子の繭の中にて。",
            "zh": "<color=green>5月9日　1:45 PM</color>\nWAVE战、前往PhenoMENON内部的途中，在不确定量子的茧之中。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "291/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch04",
            "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n",
