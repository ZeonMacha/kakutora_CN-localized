{
    "dir": "dramatics/daydra/drm_ch04_00_220.js",
    "type": "Episode",
    "info": {
        "story_id": "4022",
        "cid": "miyabi",
        "title": "らぶとーく 第22話",
        "sub_title": "ハリウッド映画ばりの（注：自己申告）",
        "title_zh": "恋爱漫谈 第22话",
        "sub_title_zh": "好莱坞电影级别的（注：自己申报）"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "ハリウッド映画ばりの（注：自己申告）",
            "zh": "好莱坞电影级别的（注：自己申报）",
            "narrator_zh": ""
        },
        {
            "location": "19/TALK",
            "narrator": "みやび",
            "text": "映画館のバイトは\n拘束時間が\n長く感じるきね。",
            "zh": "电影院的打工\n总觉得拘束时间\n格外长啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "20/TALK",
            "narrator": "みやび",
            "text": "楽しく過ごして\nみたいと常々\n思うとるんよ。",
            "zh": "我平时就\n一直想着\n要过得开心咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "21/TALK",
            "narrator": "みやび",
            "text": "ライブビューイングとか\nどうかいね。",
            "zh": "影院直播之类的\n怎么样啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "23/TALK",
            "narrator": "つばめ",
            "text": "楽しそうですね！",
            "zh": "好像很好玩呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "24/TALK",
            "narrator": "つばめ",
            "text": "メノウちゃんの\nライブとか\n観たいです！",
            "zh": "好想去看\nMENOW的演唱会\n什么的呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "25/TALK",
            "narrator": "みやび",
            "text": "ああ。\nそう言い出す\n気はしちょった。",
            "zh": "啊。\n我就料到\n你会这么说咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "26/TALK",
            "narrator": "繭",
            "text": "ライブ中継\nですか……。",
            "zh": "现场\n直播吗……。",
            "narrator_zh": "茧"
        },
        {
            "location": "28/TALK",
            "narrator": "繭",
            "text": "インターネット回線の\n方が手軽ではありますが。",
            "zh": "虽然用网络线路\n更省事些，",
            "narrator_zh": "茧"
        },
        {
            "location": "29/TALK",
            "narrator": "繭",
            "text": "専用回線を確保する\n方向ですか？",
            "zh": "还是说要确保\n专用线路吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "31/TALK",
            "narrator": "みやび",
            "text": "そこは考えどころ\nなんよねえ。",
            "zh": "那里正是要\n琢磨的地方咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "つばめ",
            "text": "え、えと……？",
            "zh": "那、那个……？",
            "narrator_zh": "燕"
        },
        {
            "location": "35/TALK",
            "narrator": "繭",
            "text": "帯域。セキュリティ。\n双方のエンコード形式…。",
            "zh": "带宽。安全性。\n双方的编码格式……。",
            "narrator_zh": "茧"
        },
        {
            "location": "36/TALK",
            "narrator": "つばめ",
            "text": "ま、まゆちん？",
            "zh": "小、小茧？",
            "narrator_zh": "燕"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "光月繭",
            "zh": "光月茧",
            "narrator_zh": "雅"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "通称まゆちん",
            "zh": "通称小茧",
            "narrator_zh": "雅"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "彼女はハッカーや否や？",
            "zh": "她是不是黑客？",
            "narrator_zh": "雅"
        },
        {
            "location": "53/SEL",
            "narrator": "",
            "text": "ハッカーだよ",
            "zh": "是黑客啊",
            "narrator_zh": ""
        },
        {
            "location": "54/SEL",
            "narrator": "",
            "text": "違うんじゃない",
            "zh": "应该不是吧",
            "narrator_zh": ""
        },
        {
            "location": "55/SEL",
            "narrator": "",
            "text": "みやびと話が合うんだね",
            "zh": "和雅很聊得来呢",
            "narrator_zh": ""
        },
        {
            "location": "56/ACT",
            "narrator": "",
            "text": "ハッカーだよ",
            "zh": "是黑客啊",
            "narrator_zh": ""
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "そうか",
            "zh": "这样哦",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "って",
            "zh": "话说",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "そうなのか？",
            "zh": "是这样咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "60/ACT",
            "narrator": "",
            "text": "違うんじゃない",
            "zh": "应该不是吧",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "それがわからんから",
            "zh": "就是因为没懂这个",
            "narrator_zh": "雅"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "聞いておるのだ",
            "zh": "才问你的啊",
            "narrator_zh": "雅"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "$handle$め",
            "zh": "$handle$这家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "64/ACT",
            "narrator": "",
            "text": "みやびと話が合うんだね",
            "zh": "和雅很聊得来呢",
            "narrator_zh": ""
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "それは肯定だ",
            "zh": "那是肯定",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "しかし",
            "zh": "可是",
            "narrator_zh": "雅"
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "そこではないのだ",
            "zh": "不是那里",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "専攻学科を考えると",
            "zh": "从她的专业来看",
            "narrator_zh": "雅"
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "不思議ではないのだが",
            "zh": "倒也不奇怪，不过",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "それにしても",
            "zh": "话说",
            "narrator_zh": "雅"
        },
        {
            "location": "73/SEL",
            "narrator": "",
            "text": "ちょっと悔しいな",
            "zh": "有点不甘心啊",
            "narrator_zh": ""
        },
        {
            "location": "74/ACT",
            "narrator": "",
            "text": "ちょっと悔しいな",
            "zh": "有点不甘心啊",
            "narrator_zh": ""
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "ぬ？",
            "zh": "唔？",
            "narrator_zh": "雅"
        },
        {
            "location": "78/SEL",
            "narrator": "",
            "text": "$me$より光月さんの方が気になるんでしょ",
            "zh": "比起$me$，你更在意光月吧",
            "narrator_zh": ""
        },
        {
            "location": "79/SEL",
            "narrator": "",
            "text": "みやびと盛り上がる話ができる子だから",
            "zh": "因为是能和雅聊得火热的女孩",
            "narrator_zh": ""
        },
        {
            "location": "80/SEL",
            "narrator": "",
            "text": "$handle$の方がみやびのこと好きなのに",
            "zh": "明明$handle$更喜欢雅",
            "narrator_zh": ""
        },
        {
            "location": "81/ACT",
            "narrator": "",
            "text": "$me$より光月さんの方が気になるんでしょ",
            "zh": "比起$me$，你更在意光月吧",
            "narrator_zh": ""
        },
        {
            "location": "82/TALK",
            "narrator": "みやび",
            "text": "お",
            "zh": "哦",
            "narrator_zh": "雅"
        },
        {
            "location": "83/TALK",
            "narrator": "みやび",
            "text": "嫉妬か？",
            "zh": "吃醋了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "いっちょまえじゃの",
            "zh": "还挺像模像样的嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "85/ACT",
            "narrator": "",
            "text": "みやびと盛り上がる話ができる子だから",
            "zh": "因为是能和雅聊得火热的女孩",
            "narrator_zh": ""
        },
        {
            "location": "86/TALK",
            "narrator": "みやび",
            "text": "それは",
            "zh": "这个",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "$handle$が努力すれば",
            "zh": "要是$handle$肯努力",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "なんとかなる話ぞね",
            "zh": "总会有办法的事咧",
            "narrator_zh": "雅"
        },
        {
            "location": "89/ACT",
            "narrator": "",
            "text": "$handle$の方がみやびのこと好きなのに",
            "zh": "明明$handle$更喜欢雅",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "好き嫌いか",
            "zh": "还讲喜欢讨厌咩",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "なんという",
            "zh": "怎么说呢",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "何なんだ？",
            "zh": "这算什么啊？",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "99/TALK",
            "narrator": "みやび",
            "text": "ここでは",
            "zh": "在这里嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "結論は出んぞね",
            "zh": "结论是出不来咧",
            "narrator_zh": "雅"
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "光月さん。",
            "zh": "光月。",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "繭",
            "text": "あ、はい！",
            "zh": "啊，在！",
            "narrator_zh": "茧"
        },
        {
            "location": "115/TALK",
            "narrator": "みやび",
            "text": "話に出してみたけんど、\n残念ながらうちに\n決定権はないぞね。",
            "zh": "话是提了，\n但是很遗憾，\n我没得决定权咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "117/TALK",
            "narrator": "繭",
            "text": "…そうなんですね…。",
            "zh": "…是这样啊…。",
            "narrator_zh": "茧"
        },
        {
            "location": "118/TALK",
            "narrator": "みやび",
            "text": "ただ、もし実現すると\nいう話になった時は\n相談させて欲しいちや。",
            "zh": "只是，要是真到了\n要实现的\n时候，希望你们跟我商量滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "120/TALK",
            "narrator": "繭",
            "text": "はい、ぜひ！",
            "zh": "好，求之不得！",
            "narrator_zh": "茧"
        },
        {
            "location": "121/TALK",
            "narrator": "つばめ",
            "text": "まゆちんはすごいんだね。\nみやびさんに相談\nされるなんて。",
            "zh": "小茧好厉害呀。\n雅居然会来\n找她商量。",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "つばめ",
            "text": "わたし、全然\n言ってることが\nわからなかったよ…。",
            "zh": "我呀，完全\n没听懂你们\n在讲什么……。",
            "narrator_zh": "燕"
        },
        {
            "location": "125/TALK",
            "narrator": "繭",
            "text": "逢瀬さんは\nそれでいいんだよ。",
            "zh": "逢濑\n这样就好哦。",
            "narrator_zh": "茧"
        },
        {
            "location": "127/TALK",
            "narrator": "つばめ",
            "text": "そ、そう、かな…？",
            "zh": "是、是这样吗……？",
            "narrator_zh": "燕"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "そうそう。\n適材適所ちう\nやつやねえ。",
            "zh": "对对。\n这就是所谓的\n适材适所咯。",
            "narrator_zh": "雅"
        }
    ]
}
