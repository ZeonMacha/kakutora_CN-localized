    "entry": [
        {
            "location": "1518/SCENARIO",
            "narrator": "",
            "text": "AX強い敵（死ぬ） アーヤ",
            "zh": "AX强敌（会死） 绫水",
            "narrator_zh": ""
        },
        {
            "location": "1530/TALK",
            "narrator": "千羽鶴",
            "text": "ここに何が出てきたか\n覚えてる人。",
            "zh": "还有人记得这里\n出过什么吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1531/SEL",
            "narrator": "",
            "text": "イカズゴケアーヤ",
            "zh": "剩女绫水",
            "narrator_zh": ""
        },
        {
            "location": "1532/SEL",
            "narrator": "",
            "text": "わかりません＞＜",
            "zh": "不记得＞＜",
            "narrator_zh": ""
        },
        {
            "location": "1533/ACT",
            "narrator": "",
            "text": "イカズゴケアーヤ",
            "zh": "剩女绫水",
            "narrator_zh": ""
        },
        {
            "location": "1534/TALK",
            "narrator": "千羽鶴",
            "text": "正解！",
            "zh": "答对了！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1535/ACT",
            "narrator": "",
            "text": "わかりません＞＜",
            "zh": "不记得＞＜",
            "narrator_zh": ""
        },
        {
            "location": "1536/TALK",
            "narrator": "千羽鶴",
            "text": "國政綾水に対して\nプラトニックなのね。",
            "zh": "原来你对国政绫水，\n是柏拉图式的呢。[?]",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1538/TALK",
            "narrator": "千羽鶴",
            "text": "もちろん、國政綾水の\nイカズゴケ設定は、\n本来の意味では無い。",
            "zh": "当然，把国政绫水\n设成『不嫁苔』，\n并不是用它的本义。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1539/TALK",
            "narrator": "千羽鶴",
            "text": "彼女の慎重すぎる性格と、\nそれに関連する\n姉との関係を描いたもの。",
            "zh": "它描绘的是她过分\n谨慎的性格，以及\n与之相关的姐妹关系。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1540/TALK",
            "narrator": "千羽鶴",
            "text": "慎重さは長所ではあるけど\n得られるチャンスを\n逃すリスクもある。",
            "zh": "谨慎虽然是长处，\n但也有错失\n到手机会的风险。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1541/TALK",
            "narrator": "千羽鶴",
            "text": "彼女はその傾向が\n顕著に見られるから、\nそれをキャラにしてみた。",
            "zh": "她身上这种倾向特别明显，\n所以我就干脆把它\n做成了角色设定。",
            "narrator_zh": "千羽鹤"
        }
    ]
}
