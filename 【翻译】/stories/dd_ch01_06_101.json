{
    "dir": "chap06/daydra/dd_ch01_06_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "6102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "出陣【Case：つばめ】＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "出击【Case：燕】＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "出陣",
            "zh": "出击",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "だ、大丈夫なのかな？",
            "zh": "没、没问题吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "49/TALK",
            "narrator": "つばめ",
            "text": "よくわからないままついて\nきちゃったけど――",
            "zh": "还没搞明白\n就跟着来了——",
            "narrator_zh": "燕"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、もう少し話を\n聞いてからの方が\nよかったかも…。",
            "zh": "果然，再多听一点\n再来，\n也许更好……。",
            "narrator_zh": "燕"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "逢瀬さん？",
            "zh": "逢濑？",
            "narrator_zh": "绫水"
        },
        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "は、はいっ！？",
            "zh": "是、是！？",
            "narrator_zh": "燕"
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "そんなに緊張しないでも\n平気よ。",
            "zh": "不用那么紧张\n也没关系。",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "す、すみません…。\nわたし、こういうのって\n初めてで…。",
            "zh": "对、对不起……\n我，这种事\n是第一次……。",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "ドームで経験してる\nじゃない。",
            "zh": "在穹顶不是\n经历过了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "つばめ",
            "text": "そうだけど、あの時は\nこんなに暗いところじゃ\nなかったし…。",
            "zh": "那是，可那时候\n没有这么暗\n的地方……。",
            "narrator_zh": "燕"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん、\nまだフェノメノンのこと\n全然知らんのやね？",
            "zh": "燕，\nPhenoMENON的事\n还完全不晓得咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、そうよね。",
            "zh": "……嘛，也是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "アーヤ",
            "text": "私達でさえ、全てを把握\nできているわけじゃないん\nだし…。",
            "zh": "就连我们，也不是\n全都掌握了\n……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "アーヤ",
            "text": "ここを抜けるまで\n少し時間ありそうだから、\n今のうちに説明するわ。",
            "zh": "离开这里之前\n好像还有点时间，\n趁现在说明吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "今私達の歩いている\nこの場所は、現実と\n非現実との境界線よ。",
            "zh": "我们现在走的\n这个地方，是现实和\n非现实的边界。",
            "narrator_zh": "绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "アーヤ",
            "text": "普通はここを通り過ぎる\n間に、フェノメノンの力で\n洗脳されてしまうの。",
            "zh": "普通人经过这里的\n时候，会被PhenoMENON的力量\n洗脑。",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nそ、それじゃわたし達も\n危ないじゃないですか！",
            "zh": "诶诶！？\n那、那我们不也\n很危险吗！",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…ねえ、アーヤ。\nやっぱあたし達だけで\n行った方が良くない？",
            "zh": "哈啊……我说，绫水。\n果然还是只有我们\n去比较好吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "何もわかってない子を\n連れてったって、\n足手まといになるだけよ。",
            "zh": "把什么都不懂的孩子\n带上，\n只会碍事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと、ギャヴィ。\nそういう言い方は…。",
            "zh": "等等，加维。\n那种说法……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "事実を言ったまでよ。",
            "zh": "我只是说了事实。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "つばめ",
            "text": "い、いいんです。\n勉強不足なわたしが\n悪いんだし…。",
            "zh": "没、没关系。\n是我学得不够，\n是我不好……。",
            "narrator_zh": "燕"
        },
        {
            "location": "96/TALK",
            "narrator": "つばめ",
            "text": "ごめんね、えと…\nガブリエラちゃん。",
            "zh": "对不起，那个……\n加布里埃拉。",
            "narrator_zh": "燕"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたは\n“ちゃん”付け禁止。",
            "zh": "你啊，\n不许叫得那么亲。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "新人なんだから、ちゃんと\nガブリエラせんぱい、って\n呼びなさい。",
            "zh": "你是新人，要好好\n叫加布里埃拉前辈，\n这样叫。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "101/TALK",
            "narrator": "つばめ",
            "text": "あ、はい。\nせんぱい！",
            "zh": "啊，好的。\n前辈！",
            "narrator_zh": "燕"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "そう、それでいいのよ。",
            "zh": "对，这样就行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "まったく…まあ、話を\n続けるとね――",
            "zh": "真是的……嘛，话\n继续说——",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "105/TALK",
            "narrator": "つばめ",
            "text": "みんな、怖くないのかな？",
            "zh": "大家，不害怕吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "106/TALK",
            "narrator": "つばめ",
            "text": "わたしはフェノメノンに\n入ってからずっと、\n不安で堪らないのに…。",
            "zh": "我从进入PhenoMENON\n开始就一直，\n不安得受不了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "107/TALK",
            "narrator": "つばめ",
            "text": "普通の女の子にしか\n見えないけど、やっぱり\n凄い人達なんだなぁ…。",
            "zh": "看起来只是普通女孩，\n果然\n都是很厉害的人呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "110/TALK",
            "narrator": "アーヤ",
            "text": "…とりあえず、説明は\nこんなところかしら。\nどう、わかった？",
            "zh": "……总之，说明\n就是这些了。\n怎么样，明白了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/TALK",
            "narrator": "つばめ",
            "text": "え？　あ、は、はい！\nありがとうございます！",
            "zh": "诶？　啊，是、是的！\n谢谢！",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "115/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "つばめ",
            "text": "あ、あの、その…。",
            "zh": "那、那个，这个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "122/TALK",
            "narrator": "つばめ",
            "text": "大丈夫ですよね？\nだって、皆さんとっても\n強いし…。",
            "zh": "没问题的吧？\n因为，大家都非常\n强……。",
            "narrator_zh": "燕"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "…だといいけど。",
            "zh": "……要是这样就好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "125/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "つばめ",
            "text": "か、会話が続かない…。\nもしかして、アーヤさんも\n本当は不安なのかな？",
            "zh": "话、话接不下去……\n难道，绫水其实\n也在不安吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "129/TALK",
            "narrator": "つばめ",
            "text": "それとも、わたしが\n落ち着きがないだけ？",
            "zh": "还是，只是我\n静不下来？",
            "narrator_zh": "燕"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "…っていうか、あんたが\n言うな、って話よね。",
            "zh": "……话说，这种话\n轮不到你来说吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "フェノメノンの中で、\n生身で発症者と戦って――",
            "zh": "在PhenoMENON里，\n以肉体和发病者战斗——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "134/TALK",
            "narrator": "ガブリエラ",
            "text": "素手でクランを引き剥がす\nなんて芸当、あたし達でも\nできないわ。",
            "zh": "徒手把库兰扯下来，\n这种本事，连我们\n都做不到。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "135/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなあんたに、\n強いとか言われてもね。",
            "zh": "对这样的你，\n说什么强不强。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、そういう言い方\nしないの。",
            "zh": "加维，别用\n那种说法。",
            "narrator_zh": "绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "だって本当のことじゃん。",
            "zh": "因为是真的啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "141/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし達だって、\nコネクトしなきゃ\n戦えないってのに――",
            "zh": "我们要是不\n连接，\n都打不了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "どう考えても異常よ。",
            "zh": "怎么想都不正常。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "アーヤ",
            "text": "異常とか言わないの。\nまったく…。",
            "zh": "不许说不正常。\n真是的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "146/TALK",
            "narrator": "アーヤ",
            "text": "ごめんね、逢瀬さん。\nギャヴィの言ったことは\n気にしないで。",
            "zh": "对不起，逢濑。\n加维说的话，\n别在意。",
            "narrator_zh": "绫水"
        },
        {
            "location": "147/TALK",
            "narrator": "つばめ",
            "text": "は、はい…。",
            "zh": "是、是的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "151/TALK",
            "narrator": "つばめ",
            "text": "…さっきから感じてた\n視線の正体って、\nせんぱいだったんだ。",
            "zh": "……从刚才就感觉到的\n视线，原来是\n前辈。",
            "narrator_zh": "燕"
        },
        {
            "location": "152/TALK",
            "narrator": "つばめ",
            "text": "…せんぱい、やっぱり\nわたしのこと嫌いなの\nかな？",
            "zh": "……前辈，果然\n讨厌我\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "153/TALK",
            "narrator": "つばめ",
            "text": "初めて会った時から、\nずっとこんな感じだし。",
            "zh": "从第一次见面起，\n就一直是这种感觉。",
            "narrator_zh": "燕"
        },
        {
            "location": "154/TALK",
            "narrator": "つばめ",
            "text": "…わたし、何か気に障る\nことしちゃったのかな？",
            "zh": "……我，是不是做了\n惹你不高兴的事？",
            "narrator_zh": "燕"
        },
        {
            "location": "155/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "160/TALK",
            "narrator": "つばめ",
            "text": "わたし",
            "zh": "我",
            "narrator_zh": "燕"
        },
        {
            "location": "161/TALK",
            "narrator": "つばめ",
            "text": "やっぱりガブちゃんに",
            "zh": "果然被加布",
            "narrator_zh": "燕"
        },
        {
            "location": "162/TALK",
            "narrator": "つばめ",
            "text": "嫌われてるかも(´つω・｀)ｼｭﾝ",
            "zh": "讨厌了吧(´つω・｀)ｼｭﾝ",
            "narrator_zh": "燕"
        },
        {
            "location": "164/SEL",
            "narrator": "",
            "text": "そんなことないよ",
            "zh": "不会有那种事哦",
            "narrator_zh": ""
        },
        {
            "location": "165/ACT",
            "narrator": "",
            "text": "そんなことないよ",
            "zh": "不会有那种事哦",
            "narrator_zh": ""
        },
        {
            "location": "167/TALK",
            "narrator": "つばめ",
            "text": "ううん",
            "zh": "不是的",
            "narrator_zh": "燕"
        },
        {
            "location": "168/TALK",
            "narrator": "つばめ",
            "text": "こういうこと",
            "zh": "这种事",
            "narrator_zh": "燕"
        },
        {
            "location": "169/TALK",
            "narrator": "つばめ",
            "text": "前にもあったから",
            "zh": "以前也有过",
            "narrator_zh": "燕"
        },
        {
            "location": "170/TALK",
            "narrator": "つばめ",
            "text": "わかるの(o´Д`)=з",
            "zh": "所以我知道(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "220/TALK",
            "narrator": "つばめ",
            "text": "またお逢いしましたね、\n$handle$さん。",
            "zh": "又见面了，\n$handle$。",
            "narrator_zh": "燕"
        },
        {
            "location": "221/TALK",
            "narrator": "つばめ",
            "text": "毎度毎度\nお騒がせします。",
            "zh": "每次都\n打扰你们。",
            "narrator_zh": "燕"
        },
        {
            "location": "222/TALK",
            "narrator": "つばめ",
            "text": "今回も早速\n【問題の扉】を\nコールしますね！",
            "zh": "这次也马上\n呼叫\n【问题之扉】！",
            "narrator_zh": "燕"
        },
        {
            "location": "229/TALK",
            "narrator": "つばめ",
            "text": "オープンプロセス、\n0x185番地から\n0x069番地へ。",
            "zh": "开放进程，\n从0x185地址\n到0x069地址。",
            "narrator_zh": "燕"
        },
        {
            "location": "244/TALK",
            "narrator": "つばめ",
            "text": "シーク完了しました。",
            "zh": "搜索完成。",
            "narrator_zh": "燕"
        },
        {
            "location": "245/TALK",
            "narrator": "つばめ",
            "text": "今回、[クラン]が\n問題を起こしているのは\nこの扉なんですけど――",
            "zh": "这次，[库兰]\n出问题的是\n这扇门——",
            "narrator_zh": "燕"
        },
        {
            "location": "247/TALK",
            "narrator": "つばめ",
            "text": "ココロファイルナンバー\n01-056-96によれば、\n今回の躊躇の原因は……",
            "zh": "根据心之档案编号\n01-056-96，\n这次犹豫的原因是……",
            "narrator_zh": "燕"
        },
        {
            "location": "248/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "249/TALK",
            "narrator": "つばめ",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "燕"
        },
        {
            "location": "250/TALK",
            "narrator": "つばめ",
            "text": "まあ、前回と\nさほど変わりませんね。",
            "zh": "嘛，和上次\n差不了多少。",
            "narrator_zh": "燕"
        },
        {
            "location": "251/SEL",
            "narrator": "",
            "text": "過去の友達関係のトラウマだっけ？",
            "zh": "是过去朋友关系的创伤吧？",
            "narrator_zh": ""
        },
        {
            "location": "252/ACT",
            "narrator": "",
            "text": "過去の友達関係のトラウマだっけ？",
            "zh": "是过去朋友关系的创伤吧？",
            "narrator_zh": ""
        },
        {
            "location": "254/TALK",
            "narrator": "つばめ",
            "text": "そうです。",
            "zh": "是的。",
            "narrator_zh": "燕"
        },
        {
            "location": "255/TALK",
            "narrator": "つばめ",
            "text": "わたし、昔から友達が\n少ないんですよ。",
            "zh": "我，从以前朋友就\n很少。",
            "narrator_zh": "燕"
        },
        {
            "location": "256/TALK",
            "narrator": "つばめ",
            "text": "でもその原因は、今までも\n今回のようにクランが\n扉を封鎖してしまって――",
            "zh": "可原因是，以前也像\n这次一样，库兰\n把扉封锁了——",
            "narrator_zh": "燕"
        },
        {
            "location": "257/TALK",
            "narrator": "つばめ",
            "text": "積極的に声をかけていく\nという扉を開けられ\nなかったからなんです。",
            "zh": "没法打开\n主动去打招呼\n的那扇门。",
            "narrator_zh": "燕"
        },
        {
            "location": "258/TALK",
            "narrator": "つばめ",
            "text": "でも$handle$さんが\n協力してくれてから\nわたしは変わってます。",
            "zh": "不过有$handle$\n帮忙之后，\n我已经变了。",
            "narrator_zh": "燕"
        },
        {
            "location": "259/TALK",
            "narrator": "つばめ",
            "text": "今まで、正しいと分かって\nいても出来なかったことが\n出来るようになりました。",
            "zh": "以前，明明知道正确\n也做不到的事，\n现在能做到了。",
            "narrator_zh": "燕"
        },
        {
            "location": "260/SEL",
            "narrator": "",
            "text": "よかった",
            "zh": "太好了",
            "narrator_zh": ""
        },
        {
            "location": "261/ACT",
            "narrator": "",
            "text": "よかった",
            "zh": "太好了",
            "narrator_zh": ""
        },
        {
            "location": "263/TALK",
            "narrator": "つばめ",
            "text": "もちろん、強い人なら\n[クラン]なんて生みませんし\nこんな事で悩みません。",
            "zh": "当然，要是强大的人，\n根本不会产生[库兰]，\n也不会为这种事烦恼。",
            "narrator_zh": "燕"
        },
        {
            "location": "264/TALK",
            "narrator": "つばめ",
            "text": "本当はそうなるのが\n一番いいんでしょうけど。",
            "zh": "其实变成那样\n才是最好的吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "265/SEL",
            "narrator": "",
            "text": "そんな人はいないよ",
            "zh": "没有那种人哦",
            "narrator_zh": ""
        },
        {
            "location": "266/ACT",
            "narrator": "",
            "text": "そんな人はいないよ",
            "zh": "没有那种人哦",
            "narrator_zh": ""
        },
        {
            "location": "269/TALK",
            "narrator": "つばめ",
            "text": "えへへ。\nそう言ってもらえると\n嬉しいです。",
            "zh": "诶嘿嘿。\n你这么说，\n我很高兴。",
            "narrator_zh": "燕"
        },
        {
            "location": "270/TALK",
            "narrator": "つばめ",
            "text": "そういうわけなので、\n毎度同じ理由ばっかり\nですが、お願いします！",
            "zh": "就是这样，\n每次都是同一个理由，\n不过还是拜托了！",
            "narrator_zh": "燕"
        },
        {
            "location": "271/SEL",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "272/SEL",
            "narrator": "",
            "text": "そろそろ飽きるよね",
            "zh": "差不多要腻了吧",
            "narrator_zh": ""
        },
        {
            "location": "273/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "274/TALK",
            "narrator": "つばめ",
            "text": "ありがとうございます！",
            "zh": "谢谢！",
            "narrator_zh": "燕"
        },
        {
            "location": "275/TALK",
            "narrator": "つばめ",
            "text": "それじゃ、今回も\nクランをやっつけ\nちゃってください！",
            "zh": "那么，这次也\n请把库兰\n解决掉！",
            "narrator_zh": "燕"
        },
        {
            "location": "276/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！",
            "zh": "献给$handle$和\n我的，\n美妙的心灵之旅！",
            "narrator_zh": "燕"
        },
        {
            "location": "283/ACT",
            "narrator": "",
            "text": "そろそろ飽きるよね",
            "zh": "差不多要腻了吧",
            "narrator_zh": ""
        },
        {
            "location": "284/TALK",
            "narrator": "つばめ",
            "text": "そ、そうですよね。",
            "zh": "是、是这样吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "285/TALK",
            "narrator": "つばめ",
            "text": "でも、きっと次は\n別の理由でお世話に\nなる気がします！",
            "zh": "不过，下次一定\n会因为别的理由\n再麻烦你！",
            "narrator_zh": "燕"
        },
        {
            "location": "286/TALK",
            "narrator": "つばめ",
            "text": "だから、今回は\nどうかつき合って\nください！",
            "zh": "所以，这次\n请再陪我\n一次！",
            "narrator_zh": "燕"
        },
        {
            "location": "288/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！",
            "zh": "献给$handle$和\n我的，\n美妙的心灵之旅！",
            "narrator_zh": "燕"
        },
        {
