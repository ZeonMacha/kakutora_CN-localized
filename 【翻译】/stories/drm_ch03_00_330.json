  },
  {
   "location": "190/TALK",
   "narrator": "ガブリエラ",
   "text": "そうなの？",
   "zh": "是吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "191/TALK",
   "narrator": "ガブリエラ",
   "text": "だったら雛の言うことがおかしいことになるわよ？",
   "zh": "那样的话雏说的话就不对了哦？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "193/TALK",
   "narrator": "ガブリエラ",
   "text": "あのね",
   "zh": "那个啊",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "194/TALK",
   "narrator": "ガブリエラ",
   "text": "雛がヒカルくんのことをいいやつだって言ったのよ"
  },
  {
   "location": "195/TALK",
   "narrator": "ガブリエラ",
   "text": "だからおすすめするって言ったのよ",
   "zh": "所以我说过推荐这个吧",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "196/TALK",
   "narrator": "ガブリエラ",
   "text": "でも",
