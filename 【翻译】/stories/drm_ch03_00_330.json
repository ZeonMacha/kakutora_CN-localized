   "text": "330_あいつはいいやつ",
   "zh": "330_那家伙是个好人",
   "narrator_zh": ""
  },
  {
   "location": "182/TALK",
   "narrator": "ガブリエラ",
   "text": "いいやつってどういう意味なのかしら？"
  },
  {
   "location": "184/SEL",
   "narrator": "",
   "text": "言葉通りの意味",
   "zh": "就是字面上的意思",
   "narrator_zh": ""
  },
  {
   "location": "185/SEL",
   "narrator": "",
   "text": "恋愛対象外って意味",
   "zh": "是指不是恋爱对象",
   "narrator_zh": ""
  },
  {
   "location": "186/ACT",
   "narrator": "",
   "text": "言葉通りの意味",
   "zh": "就是字面上的意思",
   "narrator_zh": ""
  },
  {
   "location": "187/TALK",
   "narrator": "ガブリエラ",
   "text": "その意味がわからないから聞いているのよ",
   "zh": "我就是因为不懂那个意思才问的",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "188/TALK",
   "narrator": "ガブリエラ",
   "text": "もう！",
   "zh": "真是！",
