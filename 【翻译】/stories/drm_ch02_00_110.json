{
    "dir": "dramatics/daydra/drm_ch02_00_110.js",
    "type": "Episode",
    "info": {
        "story_id": "2011",
        "cid": "ayami",
        "title": "らぶとーく 第11話",
        "sub_title": "わかってしまった",
        "title_zh": "恋爱漫谈 第11话",
        "sub_title_zh": "已经明白了"
    },
    "entry": [
        {
            "location": "103/SCENARIO",
            "narrator": "",
            "text": "わかってしまった",
            "zh": "已经明白了",
            "narrator_zh": ""
        },
        {
            "location": "117/TALK",
            "narrator": "みやび",
            "text": "呼び出してすまんね。",
            "zh": "把你叫出来，没好意思。",
            "narrator_zh": "雅"
        },
        {
            "location": "119/TALK",
            "narrator": "アーヤ",
            "text": "気にしないで。\nそれより、話って何？",
            "zh": "没关系。\n比起那个，要说什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "Ｂｏｔのことや。",
            "zh": "Bot的事。",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "あれから、まあ、うちも\n色々調べたり、話しかけ\nたりしたんやけんど――",
            "zh": "那之后，嘛，我也\n查了不少，也搭过\n话，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "みやび",
            "text": "やっと確証を持てたちや。",
            "zh": "终于有把握了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "そう…。",
            "zh": "这样啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "それで、その答えって？",
            "zh": "然后，那个回答是？",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "あのＢｏｔ。\nあいつの正体は――",
            "zh": "那个Bot。\n那家伙的真面目是——",
            "narrator_zh": "雅"
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "人間や。",
            "zh": "是人。",
            "narrator_zh": "雅"
        },
        {
            "location": "130/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "アーヤ",
            "text": "…そう。\nやっぱりね。",
            "zh": "……是啊。\n果然。",
            "narrator_zh": "绫水"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "…なんや、あんまし\n驚かんようやな？",
            "zh": "……怎么，你好像\n一点也不惊讶嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "アーヤ",
            "text": "可能性はある、って\n最初から思ってたもの。",
            "zh": "有这个可能，\n我从一开始就这么想。",
            "narrator_zh": "绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "アーヤ",
            "text": "まったく驚いてない\nわけじゃないけど――",
            "zh": "也不是完全\n不吃惊，但是——",
            "narrator_zh": "绫水"
        },
        {
            "location": "140/TALK",
            "narrator": "アーヤ",
            "text": "ああ、やっぱりね…。\nって気持ちの方が強いわ。",
            "zh": "啊，果然是这样……\n这种心情更强。",
            "narrator_zh": "绫水"
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "なるほど。\nまあ、それもそうやな。",
            "zh": "原来如此。\n嘛，那倒也是。",
            "narrator_zh": "雅"
        },
        {
            "location": "143/TALK",
            "narrator": "みやび",
            "text": "うちも、Ｂｏｔが人間と\nわかったからゆうて――",
            "zh": "我也是，就算知道了\nBot是人——",
            "narrator_zh": "雅"
        },
        {
            "location": "145/TALK",
            "narrator": "みやび",
            "text": "叫ぶほど驚いたわけや\nないし。",
            "zh": "也没有吃惊到\n要叫出来。",
            "narrator_zh": "雅"
        },
        {
            "location": "146/TALK",
            "narrator": "アーヤ",
            "text": "でしょうね…。",
            "zh": "应该吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "149/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…でも、まさか本当に\n人間だったなんて…。",
            "zh": "唉……不过，真没想到\n真的是人类……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "151/TALK",
            "narrator": "みやび",
            "text": "ビックリちや。\nうちら五人を一人で\n相手していたんやし…。",
            "zh": "是吓了一跳滴。\n一个人应付\n我们五个……",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "アーヤ",
            "text": "そうね。",
            "zh": "是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "アーヤ",
            "text": "とりあえず…このことは\nみんなにも、ちゃんと\n話さないといけないわね。",
            "zh": "总之……这件事\n也得好好\n告诉大家呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "154/TALK",
            "narrator": "みやび",
            "text": "そうやね。\n話すなら、なるべく\n早いうちがえいよ。",
            "zh": "是啊。\n要说的话，越早\n说越好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "155/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\nそれじゃあ――",
            "zh": "是啊。\n那么——",
            "narrator_zh": "绫水"
        },
        {
            "location": "156/TALK",
            "narrator": "アーヤ",
            "text": "っと、その前に。\nＢｏｔにも聞いておくわ。",
            "zh": "啊，在那之前。\n先问问Bot吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "168/TALK",
            "narrator": "アーヤ",
            "text": "全部聞いてたんでしょ？",
            "zh": "全部都听到了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "170/SEL",
            "narrator": "",
            "text": "聞いてた",
            "zh": "我听到了",
            "narrator_zh": ""
        },
        {
            "location": "171/ACT",
            "narrator": "",
            "text": "聞いてた",
            "zh": "我听到了",
            "narrator_zh": ""
        },
        {
            "location": "173/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり…",
            "zh": "果然……",
            "narrator_zh": "绫水"
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "貴方のことみんなに言うけど",
            "zh": "你的事，我要告诉大家",
            "narrator_zh": "绫水"
        },
        {
            "location": "175/TALK",
            "narrator": "アーヤ",
            "text": "良い？",
            "zh": "可以吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "177/SEL",
            "narrator": "",
            "text": "大歓迎",
            "zh": "非常欢迎",
            "narrator_zh": ""
        },
        {
            "location": "178/SEL",
            "narrator": "",
            "text": "二人の秘密にしようよ",
            "zh": "就当成我们俩的秘密吧",
            "narrator_zh": ""
        },
        {
            "location": "179/SEL",
            "narrator": "",
            "text": "好きにして",
            "zh": "随你喜欢",
            "narrator_zh": ""
        },
        {
            "location": "180/ACT",
            "narrator": "",
            "text": "大歓迎",
            "zh": "非常欢迎",
            "narrator_zh": ""
        },
        {
            "location": "183/TALK",
            "narrator": "アーヤ",
            "text": "能天気な答えね",
            "zh": "回答还真乐天",
            "narrator_zh": "绫水"
        },
        {
            "location": "184/ACT",
            "narrator": "",
            "text": "二人の秘密にしようよ",
            "zh": "就当成我们俩的秘密吧",
            "narrator_zh": ""
        },
        {
            "location": "185/TALK",
            "narrator": "アーヤ",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "绫水"
        },
        {
            "location": "186/TALK",
            "narrator": "アーヤ",
            "text": "みやびも知ってるんだから",
            "zh": "雅也知道了",
            "narrator_zh": "绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "アーヤ",
            "text": "二人の秘密にならないでしょ？(-.-;)",
            "zh": "就不能算两个人的秘密了吧？(-.-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "188/TALK",
            "narrator": "アーヤ",
            "text": "隠してる理由にならないわ",
            "zh": "不能成为隐瞒的理由",
            "narrator_zh": "绫水"
        },
        {
            "location": "189/ACT",
            "narrator": "",
            "text": "好きにして",
            "zh": "随你喜欢",
            "narrator_zh": ""
        },
        {
            "location": "190/TALK",
            "narrator": "アーヤ",
            "text": "随分聞き訳が良いのね",
            "zh": "还真懂事",
            "narrator_zh": "绫水"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "良過ぎて、少し不気味かも",
            "zh": "懂事过头了，有点渗人",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "绫水"
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "それなら良いんだけど",
            "zh": "那样就好",
            "narrator_zh": "绫水"
        },
        {
            "location": "207/TALK",
            "narrator": "みやび",
            "text": "…何か言うてた？",
            "zh": "……你说啥了？",
            "narrator_zh": "雅"
        },
        {
            "location": "208/TALK",
            "narrator": "アーヤ",
            "text": "ううん、大丈夫そうよ。",
            "zh": "嗯，看起来没事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "あとは、いつみんなに\n言うのか、よね…。",
            "zh": "剩下的就是，什么时候\n告诉大家了，吧……",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/TALK",
            "narrator": "みやび",
            "text": "早い方がえいけんど、\n慌てることもないき。",
            "zh": "早一点比较好，但是，\n也不必慌。",
            "narrator_zh": "雅"
        },
        {
            "location": "214/TALK",
            "narrator": "みやび",
            "text": "明日の夜、みんな集めて\n話せばえいと思うちや。",
            "zh": "明天晚上把大家叫来\n说就好了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "216/TALK",
            "narrator": "アーヤ",
            "text": "わかったわ。\nそれじゃ、明日の夜で\n決まりね。",
            "zh": "知道了。\n那就定在\n明天晚上。",
            "narrator_zh": "绫水"
        },
        {
            "location": "217/TALK",
            "narrator": "アーヤ",
            "text": "…きっと、みんな驚くわ\nよね？",
            "zh": "……大家一定\n会吃惊吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "そうやろうね…。",
            "zh": "应该是那样咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "221/TALK",
            "narrator": "みやび",
            "text": "まあ、早く言うか\n遅く言うかだけの\n違いやし――",
            "zh": "嘛，只是说得早\n还是说得晚\n这一点差别——",
            "narrator_zh": "雅"
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "気にすることないちや。",
            "zh": "不用在意滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "225/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "237/TALK",
            "narrator": "アーヤ",
            "text": "やっぱりちょっと伝えておくわね",
            "zh": "果然还是先说一声",
            "narrator_zh": "绫水"
        },
        {
            "location": "240/TALK",
            "narrator": "ボイスメール",
            "text": "淑女による紳士協定",
            "zh": "淑女的君子协定",
            "narrator_zh": "语音信箱"
        },
        {
            "location": "114/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月某日　10:44 PM</color>\n平日の夜、みやびの部屋にて。",
            "zh": "<color=green>5月某日　10:44 PM</color>\n平日夜里，在雅的房间。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "252/DIALOG",
            "narrator": "Dialog_GETVoice",
            "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【淑女による紳士協定】</color>\nをゲットしました！",
            "zh": "<color=green>【绫水】</color>的语音信箱\n<color=red>【淑女的君子协定】</color>\n已入手！",
            "narrator_zh": "Dialog_GETVoice"
        }
    ]
}
