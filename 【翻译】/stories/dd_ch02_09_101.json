{
    "dir": "chap09/daydra/dd_ch02_09_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "9202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "臆する季節＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "畏缩的季节＜前篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "臆する季節",
            "zh": "畏缩的季节",
            "narrator_zh": ""
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "んーっ！\nやっとお昼ね…。",
            "zh": "嗯——！\n终于到午休了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "今日は２講までで\n終わりだから――",
            "zh": "今天上完第2节课\n就结束了——",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "お昼は外で食べよう\nかしら？",
            "zh": "午饭要不要去外面\n吃呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ。",
            "zh": "绫水。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "アーヤ",
            "text": "ん？",
            "zh": "嗯？",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと聞きたい\nことがあるんだけど。",
            "zh": "有点事想问你\n一下。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "あら、ギャヴィ。\nどうかしたの？",
            "zh": "哎呀，加维。\n怎么了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "うん、前の休み時間に\nまほに聞かれたん\nだけど――",
            "zh": "嗯，刚才课间休息时\n真幌问我\n来着——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "今日のシフトって\n誰だったっけ？",
            "zh": "今天的排班\n轮到谁来着？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "えっと、確か…、\nつばめとみやびじゃ\nなかったかしら？",
            "zh": "那个，我记得……\n不是燕和雅\n吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "そっか…なんか、\nこの前出動した時の\n報告書を作るから――",
            "zh": "这样啊……好像是因为\n她要写前几天出动时的\n报告书——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "もう一度みんなから\n話を聞きたいみたい。",
            "zh": "似乎想再向大家\n了解一下情况。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "50/TALK",
            "narrator": "アーヤ",
            "text": "うーん、確か明後日は\n全員シフトに入ってる\nはずだけど――",
            "zh": "唔……我记得后天\n所有人应该都有\n排班才对——",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "アーヤ",
            "text": "急ぎなら、私から\nみんなにＷＡＶＥ\n送っとくわ。",
            "zh": "要是急着要的话，我来\n给大家发个WAVE\n吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "明後日だ、って\nまほに伝えておくわ。",
            "zh": "我会去跟真幌说\n是后天的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "シフトのない日に\n劇場行きたくない\nもの。",
            "zh": "没有排班的日子\n我可不想去剧场\n呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "アーヤ",
            "text": "でも――",
            "zh": "可是——",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "いいの！\nていうか、アーヤは\n真面目過ぎなのよ。",
            "zh": "行啦！\n话说回来，绫水你就是\n太认真过头了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "小夜",
            "text": "アーヤ。",
            "zh": "绫水。",
            "narrator_zh": "小夜"
        },
        {
            "location": "63/TALK",
            "narrator": "小夜",
            "text": "おつかれー。\n今、丁度ＷＡＶＥ\n送ろうかな、って――",
            "zh": "辛苦啦—。\n我刚才正想着要不要给你\n发个WAVE呢——",
            "narrator_zh": "小夜"
        },
        {
            "location": "65/TALK",
            "narrator": "小夜",
            "text": "…あら？",
            "zh": "……哎呀？",
            "narrator_zh": "小夜"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、どうも…。",
            "zh": "啊，你好……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "小夜",
            "text": "こんにちは。\nえっと…アーヤの\n知り合いかしら？",
            "zh": "你好。\n那个……是绫水的\n朋友吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "72/TALK",
            "narrator": "アーヤ",
            "text": "ええ、ちょっとね。",
            "zh": "嗯，算是吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "小夜",
            "text": "？",
            "zh": "？",
            "narrator_zh": "小夜"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、あたしは\nもう行くから――",
            "zh": "那我就先\n走了哦——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "くれぐれも、\nまほに余計なこと\n言ったらダメよ？",
            "zh": "千万记住，\n可不许在真幌面前\n说多余的话哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "アーヤ",
            "text": "あ、ちょっと！\n待ってギャヴィ…。",
            "zh": "啊，等一下！\n别走啊加维……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "アーヤ",
            "text": "…もう、\nいい加減なんだから。",
            "zh": "……真是的，\n太敷衍了吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "小夜",
            "text": "…邪魔しちゃった？",
            "zh": "……我打扰到你们了？",
            "narrator_zh": "小夜"
        },
        {
            "location": "87/TALK",
            "narrator": "アーヤ",
            "text": "あ、ううん。\nそんなことないわ。",
            "zh": "啊，没有。\n没那回事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "それより、用事が\nあるんじゃないの？",
            "zh": "不说这个，你不是\n找我有事吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "小夜",
            "text": "あ、そうだった。",
            "zh": "啊，对哦。",
            "narrator_zh": "小夜"
        },
        {
            "location": "90/TALK",
            "narrator": "小夜",
            "text": "アーヤさ、今日って\n３講取ってたっけ？",
            "zh": "绫水啊，你今天\n选了第3节课吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "ううん、今日は\n２講までよ。",
            "zh": "没有，今天就上到\n第2节课。",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "小夜",
            "text": "よかった。\n私も今日は２講で\n終わりだから――",
            "zh": "太好了。\n我今天也是第2节课\n就结束了——",
            "narrator_zh": "小夜"
        },
        {
            "location": "93/TALK",
            "narrator": "小夜",
            "text": "この後サークル棟\n行かない？",
            "zh": "待会儿要不要一起去\n社团楼？",
            "narrator_zh": "小夜"
        },
        {
            "location": "94/TALK",
            "narrator": "アーヤ",
            "text": "いいわよ。\n私も行こうと思ってた\nところだったし。",
            "zh": "好啊。\n我本来也正打算\n过去一趟呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "95/TALK",
            "narrator": "アーヤ",
            "text": "でも、その前に\nお昼を食べないとね。",
            "zh": "不过，在那之前\n得先吃午饭才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "96/TALK",
            "narrator": "小夜",
            "text": "じゃ、学食\n行きましょ。",
            "zh": "那，我们去\n食堂吧。",
            "narrator_zh": "小夜"
        },
        {
            "location": "97/TALK",
            "narrator": "アーヤ",
            "text": "えっ？　今日は外に\n食べに行くつもり\nだったんだけど…。",
            "zh": "哎？　我今天本来打算\n去外面吃的\n来着……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/TALK",
            "narrator": "小夜",
            "text": "折角リーズナブルな\n学食があるのに――",
            "zh": "难得有这么实惠的\n食堂在——",
            "narrator_zh": "小夜"
        },
        {
            "location": "100/TALK",
            "narrator": "小夜",
            "text": "行かないなんて\nもったいないでしょ。",
            "zh": "不去吃岂不是\n太浪费了吗。",
            "narrator_zh": "小夜"
        },
        {
            "location": "101/TALK",
            "narrator": "小夜",
            "text": "ほら、行こ行こ。",
            "zh": "好啦，走吧走吧。",
            "narrator_zh": "小夜"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "もぅ、仕方ないわね。",
            "zh": "真是的，拿你没办法。",
            "narrator_zh": "绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "小夜",
            "text": "いただきまーす！",
            "zh": "我开动啦—！",
            "narrator_zh": "小夜"
        },
        {
            "location": "122/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "小夜",
            "text": "どうかしたの？",
            "zh": "怎么了吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "128/TALK",
            "narrator": "アーヤ",
            "text": "…よく食べるなぁ、\nと思ってね。",
            "zh": "……只是觉得你真能吃啊，\n这么想而已。",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "スーパースペシャル\nって、運動部用の\nメニューよ？",
            "zh": "超级特惠套餐\n可是运动社团专用的\n菜单哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "131/TALK",
            "narrator": "小夜",
            "text": "毎日一生懸命だと、\nどうしたって\nお腹が減るのよ。",
            "zh": "每天都这么拼命努力的话，\n不管怎样肚子都会\n饿的嘛。",
            "narrator_zh": "小夜"
        },
        {
            "location": "133/TALK",
            "narrator": "小夜",
            "text": "ていうか、アーヤは\n食べな過ぎじゃない？",
            "zh": "话说回来，绫水你\n吃得也太少了吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "134/TALK",
            "narrator": "小夜",
            "text": "サラダだけじゃ\n身体持たないでしょ。",
            "zh": "光吃沙拉的话\n身体会吃不消的哦。",
            "narrator_zh": "小夜"
        },
        {
            "location": "135/TALK",
            "narrator": "アーヤ",
            "text": "小夜ほどじゃない\nけど、ちゃんと\nお肉も食べてるわ。",
            "zh": "虽然比不上小夜，\n但我也有好好\n吃肉的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "小夜",
            "text": "コスパいいなぁ。\nちょっと羨ましい\nかも。",
            "zh": "性价比真高啊。\n稍微有点羡慕\n呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "138/TALK",
            "narrator": "アーヤ",
            "text": "あ、あはは…。",
            "zh": "啊、啊哈哈……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "141/TALK",
            "narrator": "アーヤ",
            "text": "…そんな肉ばっかり\n食べてその体系を\n維持できてる――",
            "zh": "……光吃那么多肉\n还能维持\n那种身材的——",
            "narrator_zh": "绫水"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "小夜の方が羨ましいん\nだけど…。",
            "zh": "小夜才更让人羡慕\n好不好……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "145/TALK",
            "narrator": "小夜",
            "text": "…デザートにパフェも\n頼もうかしら？",
            "zh": "……饭后甜点要不要\n再点个芭菲呢？",
            "narrator_zh": "小夜"
        },
        {
            "location": "148/TALK",
            "narrator": "アーヤ",
            "text": "…小夜って、絶対に\n運動系サークルにも\n入ってるでしょ？",
            "zh": "……小夜你，绝对\n也加入了运动系社团\n对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "149/TALK",
            "narrator": "小夜",
            "text": "ないない。\n人形サークルだけで\n手いっぱいだって。",
            "zh": "没有没有。\n光是一个人偶社团\n就已经忙不过来了。",
            "narrator_zh": "小夜"
        },
        {
            "location": "151/TALK",
            "narrator": "小夜",
            "text": "…っていうか、\nアーヤの方は、\n最近忙しそうね？",
            "zh": "……话说回来，\n绫水你那边，\n最近好像很忙啊？",
            "narrator_zh": "小夜"
        },
        {
            "location": "154/TALK",
            "narrator": "アーヤ",
            "text": "…トライナリーの\nこと？",
            "zh": "……你是说三重奏的\n事吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "155/TALK",
            "narrator": "小夜",
            "text": "うん。\n最近、出撃がちょっと\n多くない？",
            "zh": "嗯。\n最近，出击是不是\n有点频繁了？",
            "narrator_zh": "小夜"
        },
        {
            "location": "156/TALK",
            "narrator": "アーヤ",
            "text": "うーん…まあ、\nぼちぼち、って\nとこかしら？",
            "zh": "唔……嘛，\n也就一般般吧，\n大概这种程度？",
            "narrator_zh": "绫水"
        },
        {
            "location": "157/TALK",
            "narrator": "小夜",
            "text": "命がけの出動が\nぼちぼちあるって、\n相当なもんよね…。",
            "zh": "赌上性命的出动\n居然都能说一般般，\n那已经相当不得了吧……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "159/TALK",
            "narrator": "小夜",
            "text": "でも、戦ってる時の\nアーヤって、凄いん\nだろうなぁ…。",
            "zh": "不过，战斗时候的\n绫水，一定很厉害\n吧……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "161/TALK",
            "narrator": "アーヤ",
            "text": "凄いっていうと？",
            "zh": "你说厉害是指？",
            "narrator_zh": "绫水"
        },
        {
            "location": "164/TALK",
            "narrator": "小夜",
            "text": "自慢の剣道スキルを\nフル活用して――",
            "zh": "把引以为傲的剑道技能\n发挥到极致——",
            "narrator_zh": "小夜"
        },
        {
            "location": "165/TALK",
            "narrator": "小夜",
            "text": "群がる敵をバッサ\nバッサ薙ぎ倒してるん\nでしょ？",
            "zh": "把蜂拥而上的敌人\n唰唰唰地全部放倒\n对吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "そこまで派手じゃ\nないかな？",
            "zh": "倒也没有那么\n夸张吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "小夜",
            "text": "あ、かっこいい\n名乗りとかもするの？",
            "zh": "啊，帅气的\n报上名号之类的也会做吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "171/TALK",
            "narrator": "アーヤ",
            "text": "しないって。\n特撮ヒーローじゃ\nあるまいし。",
            "zh": "不会做的啦。\n又不是\n特摄英雄。",
            "narrator_zh": "绫水"
        },
        {
            "location": "172/TALK",
            "narrator": "小夜",
            "text": "あはは、勿体ない。\n劇で鍛えたスキルを\n使うチャンスなのに。",
            "zh": "啊哈哈，真可惜。\n明明是用上话剧里练出来的\n技能的好机会呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "でも、名前って\n個人情報だし。",
            "zh": "而且，名字也算是\n个人信息啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "177/TALK",
            "narrator": "小夜",
            "text": "ドライ過ぎない？\nまあ、アーヤっぽくは\nあるけどさぁ…。",
            "zh": "也太冷淡了吧？\n嘛，确实很有绫水的\n风格就是了……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "178/TALK",
            "narrator": "小夜",
            "text": "じゃあ、必殺技の\n名前は？",
            "zh": "那，必杀技的\n名字呢？",
            "narrator_zh": "小夜"
        },
        {
            "location": "181/TALK",
            "narrator": "アーヤ",
            "text": "ないから。",
            "zh": "没有那种东西。",
            "narrator_zh": "绫水"
        },
        {
            "location": "183/TALK",
            "narrator": "小夜",
            "text": "ん～、じゃあ他の子の\n武器とか技は？",
            "zh": "唔～，那其他女孩子的\n武器或者招式呢？",
            "narrator_zh": "小夜"
        },
        {
            "location": "184/TALK",
            "narrator": "アーヤ",
            "text": "…色々、それぞれに\n得意分野があるわ。",
            "zh": "……各种各样，每个人\n都有自己擅长的领域哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "185/TALK",
            "narrator": "小夜",
            "text": "例えば？",
            "zh": "比如说？",
            "narrator_zh": "小夜"
        },
        {
            "location": "186/TALK",
            "narrator": "アーヤ",
            "text": "だから、色々よ。",
            "zh": "都说了，各种各样啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "小夜",
            "text": "そうやってはぐらか\nして、全然教えて\nくれないんだから…。",
            "zh": "总是这样打哈哈\n糊弄过去，完全不肯\n告诉我……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "188/TALK",
            "narrator": "アーヤ",
            "text": "仕方ないでしょ？\n秘密にするのが\n規則なんだから…。",
            "zh": "这也没办法吧？\n保密可是\n规定啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "189/TALK",
            "narrator": "小夜",
            "text": "うちの学生には\n該当しないじゃん。",
            "zh": "我们学校的学生\n又不适用那条规定嘛。",
            "narrator_zh": "小夜"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "それはそうだけど…。",
            "zh": "话虽如此……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/TALK",
            "narrator": "小夜",
            "text": "本当、アーヤってば\n堅いんだから…。",
            "zh": "真是的，绫水你\n未免太死板了……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "…そうかしら？",
            "zh": "……是这样吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "237/TALK",
            "narrator": "アーヤ",
            "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。",
            "zh": "欢迎来到\n[心之扉]，\n$handle$。",
            "narrator_zh": "绫水"
        },
        {
            "location": "238/TALK",
            "narrator": "アーヤ",
            "text": "今回も私を助けに\n来てくれたのね。\nいつもありがとう。",
            "zh": "这次你也特地来\n帮我了呢。\n一直很感谢你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "240/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ早速\n扉をコールするわね。",
            "zh": "那么我这就立刻\n呼叫大门哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "245/TALK",
            "narrator": "アーヤ",
            "text": "オープンプロセス、\n0x992番地から\n0x05F番地へ。",
            "zh": "开放进程，\n从0x992号地址\n前往0x05F号地址。",
            "narrator_zh": "绫水"
        },
        {
            "location": "260/TALK",
            "narrator": "アーヤ",
            "text": "シーク完了。",
            "zh": "搜索完成。",
            "narrator_zh": "绫水"
        },
        {
            "location": "262/TALK",
            "narrator": "アーヤ",
            "text": "えーっと、\n今回の停滞は……？",
            "zh": "那个——，\n这次的停滞是……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "264/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "265/TALK",
            "narrator": "アーヤ",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "266/TALK",
            "narrator": "アーヤ",
            "text": "なるほどね。\n心配性の私らしい停滞ね。",
            "zh": "原来如此。\n真是符合爱操心的我的停滞呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "今回のロックは、\n割とわかりやすい\n理由みたいよ。",
            "zh": "这次的锁定，\n理由似乎意外地\n好懂哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "268/TALK",
            "narrator": "アーヤ",
            "text": "小夜にリスクを追わせたく\nない気持ちと、信じたい\n気持ちのせめぎ合いね。",
            "zh": "不想让小夜承担风险的\n心情，和想要相信她的\n心情正在互相拉扯呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "270/TALK",
            "narrator": "アーヤ",
            "text": "でもやっぱり、アンパイを\n選んで、今回も何も喋る\nつもりはないみたい。",
            "zh": "不过到头来，她还是选了\n稳妥牌，这次似乎也\n什么都不打算说呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "271/TALK",
            "narrator": "アーヤ",
            "text": "本当はもっと\n色んな話をしたいって\n思ってるのにね。",
            "zh": "明明心里其实很想\n跟她聊更多\n各种各样的话题呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "272/TALK",
            "narrator": "アーヤ",
            "text": "自分で自分に枷を\nつけちゃって。",
            "zh": "自己给自己套上了\n枷锁。",
            "narrator_zh": "绫水"
        },
        {
            "location": "273/SEL",
            "narrator": "",
            "text": "アーヤらしいね",
            "zh": "很有绫水的风格呢",
            "narrator_zh": ""
        },
        {
            "location": "274/ACT",
            "narrator": "",
            "text": "アーヤらしいね",
            "zh": "很有绫水的风格呢",
            "narrator_zh": ""
        },
        {
            "location": "276/TALK",
            "narrator": "アーヤ",
            "text": "ふふ。ほんとね。",
            "zh": "呵呵。确实呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "277/TALK",
            "narrator": "アーヤ",
            "text": "でも、貴方が協力して\nくれれば、その枷を\n外すことができる。",
            "zh": "不过，只要有你\n帮忙，就能把那副\n枷锁解开。",
            "narrator_zh": "绫水"
        },
        {
            "location": "278/TALK",
            "narrator": "アーヤ",
            "text": "私が本当になりたい私に\n一歩近づけるのよ。",
            "zh": "就能朝着真正想要成为的\n那个自己，再靠近一步哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "279/TALK",
            "narrator": "アーヤ",
            "text": "だから、今回も\n宜しくお願いね。",
            "zh": "所以，这次也\n请你多多关照啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "280/SEL",
            "narrator": "",
            "text": "オーケー",
            "zh": "OK",
            "narrator_zh": ""
        },
        {
            "location": "281/ACT",
            "narrator": "",
            "text": "オーケー",
            "zh": "OK",
            "narrator_zh": ""
        },
        {
            "location": "284/TALK",
            "narrator": "アーヤ",
            "text": "ふふ、ありがと。",
            "zh": "呵呵，谢谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "285/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！",
            "zh": "祝愿$handle$与\n国政绫水，\n拥有一段美妙的心灵之旅！",
            "narrator_zh": "绫水"
        },
        {
            "location": "30/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月12日　12:06 PM</color>\nとある平日の昼休み、学園廊下にて。",
            "zh": "<color=green>5月12日　12:06 PM</color>\n某个平日的午休，在学园走廊上。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "205/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch02",
            "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>在国政绫水的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n在她的心中，\n正产生着巨大的纠葛。\n\n请潜入心灵领域\n化解国政绫水内心的纠葛。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch02"
        }
    ]
}
