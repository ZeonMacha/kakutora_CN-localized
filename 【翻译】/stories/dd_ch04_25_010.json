            "location": "272/TALK",
            "narrator": "みやび",
            "text": "まさかとは思うが",
            "zh": "按理不该多想",
            "narrator_zh": "雅"
        },
        {
            "location": "273/TALK",
            "narrator": "みやび",
            "text": "うさぎの話ばかりするから",
            "zh": "净聊兔子的事",
            "narrator_zh": "雅"
        },
        {
            "location": "274/TALK",
            "narrator": "みやび",
            "text": "嫉妬でもしたか？",
            "zh": "该不会是吃醋了啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "276/SEL",
            "narrator": "",
            "text": "嫉妬してた",
            "zh": "我吃醋了",
            "narrator_zh": ""
        },
        {
            "location": "277/SEL",
            "narrator": "",
            "text": "そういうわけじゃない",
            "zh": "不是那样的",
            "narrator_zh": ""
        },
        {
            "location": "278/ACT",
            "narrator": "",
            "text": "嫉妬してた",
            "zh": "我吃醋了",
            "narrator_zh": ""
        },
        {
            "location": "279/TALK",
            "narrator": "みやび",
            "text": "かわいいな",
            "zh": "真可爱啊",
            "narrator_zh": "雅"
        },
        {
            "location": "280/TALK",
            "narrator": "みやび",
            "text": "そんな一面があったか",
            "zh": "原来你还有这么一面啊",
            "narrator_zh": "雅"
        },
        {
            "location": "281/TALK",
            "narrator": "みやび",
            "text": "確かに",
            "zh": "确实，",
            "narrator_zh": "雅"
        },
        {
            "location": "282/TALK",
            "narrator": "みやび",
            "text": "うさぎのことは特別に思っている",
            "zh": "我把兔子当成特别的存在",
            "narrator_zh": "雅"
        },
        {
            "location": "283/TALK",
            "narrator": "みやび",
            "text": "同志であり",
            "zh": "既是同志",
            "narrator_zh": "雅"
        },
        {
            "location": "284/TALK",
            "narrator": "みやび",
            "text": "ある程度の本音を見せられる相手だからな",
            "zh": "也是能把几分真心交出去的对象",
            "narrator_zh": "雅"
        },
        {
            "location": "287/TALK",
            "narrator": "みやび",
            "text": "だが",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "288/TALK",
            "narrator": "みやび",
            "text": "一定のラインより先の本音は",
            "zh": "某条线往后的真心",
            "narrator_zh": "雅"
        },
        {
            "location": "289/TALK",
            "narrator": "みやび",
            "text": "うさぎにも見せない",
            "zh": "就连兔子我也不给看",
            "narrator_zh": "雅"
        },
        {
            "location": "290/TALK",
            "narrator": "みやび",
            "text": "それより先は",
            "zh": "再往里的部分",
            "narrator_zh": "雅"
        },
        {
            "location": "293/TALK",
            "narrator": "みやび",
            "text": "一人にしか見せん",
            "zh": "我只给一个人看",
            "narrator_zh": "雅"
        },
        {
            "location": "295/SEL",
            "narrator": "",
            "text": "それは誰？",
            "zh": "那个人是谁？",
            "narrator_zh": ""
        },
        {
            "location": "296/ACT",
            "narrator": "",
            "text": "それは誰？",
            "zh": "那个人是谁？",
            "narrator_zh": ""
        },
        {
            "location": "299/TALK",
            "narrator": "みやび",
            "text": "ノーコメント",
            "zh": "无可奉告",
            "narrator_zh": "雅"
        },
        {
            "location": "300/TALK",
            "narrator": "みやび",
            "text": "朴念仁には教えん",
            "zh": "才不会告诉木头人呢",
            "narrator_zh": "雅"
        },
        {
            "location": "301/ACT",
            "narrator": "",
            "text": "そういうわけじゃない",
            "zh": "不是那样的",
            "narrator_zh": ""
        },
        {
            "location": "302/TALK",
            "narrator": "みやび",
            "text": "本当だろうか？",
            "zh": "是咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "303/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "算了",
            "narrator_zh": "雅"
        },
        {
            "location": "304/TALK",
            "narrator": "みやび",
            "text": "相棒はうちのパートナーやし",
            "zh": "搭档嘛，本来就是我的搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "305/TALK",
            "narrator": "みやび",
            "text": "無闇に疑うのは失礼か",
            "zh": "随便怀疑就失礼了吧",
            "narrator_zh": "雅"
        },
        {
            "location": "306/TALK",
            "narrator": "みやび",
            "text": "よし",
            "zh": "好",
            "narrator_zh": "雅"
        },
        {
            "location": "307/TALK",
            "narrator": "みやび",
            "text": "ここは信じてやるぞね",
            "zh": "这回就信你一回咧",
            "narrator_zh": "雅"
        },
        {
            "location": "314/ACT",
            "narrator": "",
            "text": "あはは、まさか！",
            "zh": "啊哈哈，怎么可能！",
            "narrator_zh": ""
        },
        {
            "location": "315/TALK",
            "narrator": "みやび",
            "text": "さすがに考え過ぎか？",
            "zh": "果然是我想多了咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "316/TALK",
            "narrator": "みやび",
            "text": "うさぎが恋愛というのは",
            "zh": "兔子谈恋爱这种事",
            "narrator_zh": "雅"
        },
        {
            "location": "319/TALK",
            "narrator": "みやび",
            "text": "ちゅうか",
            "zh": "要我说",
            "narrator_zh": "雅"
        },
        {
            "location": "320/TALK",
            "narrator": "みやび",
            "text": "うちとしたことが",
            "zh": "我居然",
            "narrator_zh": "雅"
        },
        {
            "location": "321/TALK",
            "narrator": "みやび",
            "text": "一般ＪＫのような話をしてしまった",
            "zh": "说出了普通JK才会说的话",
            "narrator_zh": "雅"
        },
        {
            "location": "323/TALK",
            "narrator": "みやび",
            "text": "これは恥ずいぞ！？",
            "zh": "这也太羞人了咧！？",
            "narrator_zh": "雅"
        },
        {
            "location": "325/TALK",
            "narrator": "みやび",
            "text": "退却！！",
            "zh": "撤退！！",
            "narrator_zh": "雅"
