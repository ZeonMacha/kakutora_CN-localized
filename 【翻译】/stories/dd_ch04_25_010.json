{
    "dir": "chap25/daydra/dd_ch04_25_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "25452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "襲撃前夜＜みやび編＞",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "袭击前夜＜雅篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "襲撃前夜～みやび編～",
            "zh": "袭击前夜～雅篇～",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "――というわけで、\n館長からいつ連絡が\n来るかわからない。",
            "zh": "――就是这么回事，\n馆长什么时候来联络，\n谁也说不准。",
            "narrator_zh": "绫水"
        },
        {
            "location": "27/TALK",
            "narrator": "アーヤ",
            "text": "だから、今夜はみんな、\n劇場に泊まってもらうわ。",
            "zh": "所以，今晚大家\n就都住到剧场里了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "みやび",
            "text": "やっぱそうなるかぁ…。\nまあ、しゃあないな。",
            "zh": "果然要这样咯……。\n算了，没办法咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "アーヤ",
            "text": "それと、外部と連絡を\nする場合は、間違っても\nストの話はしないこと。",
            "zh": "还有，跟外界联络的时候，\n千万记住\n不能提罢工的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "みんな、いい？",
            "zh": "大家都清楚了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "りょーかい。",
            "zh": "收到～。",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "つばめ",
            "text": "わかりました…。",
            "zh": "我知道了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "言うわけないでしょ？\n機密漏えいに\nなっちゃうし…。",
            "zh": "怎么可能说出去？\n那可就成\n泄露机密了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "うん…それじゃみんな、\nよろしくね。",
            "zh": "嗯……那么大家，\n就麻烦各位了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "つばめ",
            "text": "…わたしたち、\nどうなっちゃうんだろ？",
            "zh": "……我们，\n会变成什么样呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、情けない声\n出して…頼りないわねぇ。",
            "zh": "真是的，发出这么没出息的\n声音……真靠不住呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんは\n不安じゃないの？",
            "zh": "加布\n就不担心吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "46/TALK",
            "narrator": "ガブリエラ",
            "text": "不安に決まってるでしょ？",
            "zh": "当然担心了啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、不安だからって\n暗くなってても\n仕方ないじゃない。",
            "zh": "但是，光因为担心\n就板着一张脸\n也没用呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "仕方ないことやけんど、\nみんなピリピリしちょって、\n居心地悪いがよ…。",
            "zh": "虽然说是没办法的事，但是\n大家都紧绷绷的，\n待着好不自在……。",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "こんなとこに一晩とか、\nストレスで胃が潰れかねん。",
            "zh": "在这种地方待上一晚，\n怕是要把胃都压出毛病来咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "ちくっと、気分転換でも\nしてくるか…。",
            "zh": "等子，我出去转转，\n换换心情……。",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "うち、向こうでちくっと\n考え事してるちや。",
            "zh": "我就在那边\n想点事情滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "ふむ…やはり客席の\n座り心地はなかなかやな。",
            "zh": "唔……观众席的座位，\n坐起来果然还是蛮舒服的嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "72/TALK",
            "narrator": "みやび",
            "text": "ここで座って寝るのも、\n悪くないかもしれん…。",
            "zh": "在这里坐着睡，\n说不定也不赖……。",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "…子守歌代わりに、\nつまらん映画でも\n流すか？",
            "zh": "……放部无聊的电影\n来当摇篮曲\n如何啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "…相棒か？",
            "zh": "……搭档？",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "いや…うさぎか。",
            "zh": "不对……是兔子啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "86/TALK",
            "narrator": "ラビットアニマ",
            "text": "今よろしいでしょうか？",
            "zh": "现在方便吗？",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "どうかしたのか？",
            "zh": "怎么了？",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "ラビットアニマ",
            "text": "夜分にすみません",
            "zh": "深夜打扰了",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "92/TALK",
            "narrator": "ラビットアニマ",
            "text": "先ほどひなこから連絡があったのですが",
            "zh": "刚才小雏那边来了联络",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "93/TALK",
            "narrator": "ラビットアニマ",
            "text": "逢瀬さんとの連絡が取れないようなのです",
            "zh": "好像联系不上逢濑了",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん？",
            "zh": "燕？",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "ラビットアニマ",
            "text": "はい",
            "zh": "是",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "97/TALK",
            "narrator": "ラビットアニマ",
            "text": "とても心配をしていて",
            "zh": "她非常担心",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "98/TALK",
            "narrator": "ラビットアニマ",
            "text": "私の方から聞いてほしいと頼まれたもので",
            "zh": "就托我来问一问",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "99/TALK",
            "narrator": "みやび",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "みやび",
            "text": "安心して良い",
            "zh": "可以放心",
            "narrator_zh": "雅"
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんならさっき",
            "zh": "燕的话，刚才",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "疲れたからもう寝る",
            "zh": "累了，要先睡了",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "そう言っていた",
            "zh": "她是这么说的",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "ラビットアニマ",
            "text": "そうでしたか",
            "zh": "这样啊",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "急用なら部屋に起こしに行くが？",
            "zh": "有急事的话，我去房间叫醒她？",
            "narrator_zh": "雅"
        },
        {
            "location": "110/TALK",
            "narrator": "ラビットアニマ",
            "text": "いえ",
            "zh": "不用",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "111/TALK",
            "narrator": "ラビットアニマ",
            "text": "逢瀬さんが無事ならばひなこも安心します",
            "zh": "只要逢濑平安无事，小雏也就安心了",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "それはよかった",
            "zh": "那就好",
            "narrator_zh": "雅"
        },
        {
            "location": "116/TALK",
            "narrator": "ラビットアニマ",
            "text": "すみません",
            "zh": "不好意思",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "117/TALK",
            "narrator": "ラビットアニマ",
            "text": "もう一つ聞いてほしいと言われていたのを",
            "zh": "还有一件事托我问你，",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "118/TALK",
            "narrator": "ラビットアニマ",
            "text": "忘れていました。",
            "zh": "我给忘了。",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "言ってみよ",
            "zh": "说来听听。",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "ラビットアニマ",
            "text": "キリトとヒカルの行方についてです",
            "zh": "是关于圣翔和光的下落",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "123/TALK",
            "narrator": "ラビットアニマ",
            "text": "通常攻撃隊の任務で呼び出されてから",
            "zh": "自从被普通攻击队召去执行任务",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "124/TALK",
            "narrator": "ラビットアニマ",
            "text": "何日も連絡が取れません",
            "zh": "好几天都联系不上了",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "126/TALK",
            "narrator": "ラビットアニマ",
            "text": "みやび先輩がなにか聞いていないか",
            "zh": "雅前辈有没有听说什么",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "127/TALK",
            "narrator": "ラビットアニマ",
            "text": "聞いてほしいと言われていました",
            "zh": "就托我来问问",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "すまんがわからない",
            "zh": "没好意思，我不知道",
            "narrator_zh": "雅"
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "うちらは通常攻撃隊の話は",
            "zh": "我们这边，普通攻击队的事",
            "narrator_zh": "雅"
        },
        {
            "location": "130/TALK",
            "narrator": "みやび",
            "text": "まったく入ってこなくてな",
            "zh": "完全一点消息都没有啊",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "ラビットアニマ",
            "text": "そうでしたか",
            "zh": "这样啊",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "だが",
            "zh": "不过",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "キリトくん達はまだ学生",
            "zh": "圣翔他们还只是学生",
            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "任務に駆り出されたとしても",
            "zh": "就算被征调去执行任务",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "みやび",
            "text": "一番危険な場所に",
            "zh": "被丢到最危险的地方",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "放り出される可能性は低いだろう",
            "zh": "的可能性应该很低吧",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "なので",
            "zh": "所以",
            "narrator_zh": "雅"
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "安心するよう伝えておくぞね",
            "zh": "就转告她可以放心咧",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "ラビットアニマ",
            "text": "ですがみやび先輩",
            "zh": "可是雅前辈",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "143/TALK",
            "narrator": "ラビットアニマ",
            "text": "最近の管理庁の行動は",
            "zh": "最近管理厅的行动",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "144/TALK",
            "narrator": "ラビットアニマ",
            "text": "どうにも予測できません",
            "zh": "实在没法预测",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "146/TALK",
            "narrator": "ラビットアニマ",
            "text": "もしかしたら",
            "zh": "说不定",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "147/TALK",
            "narrator": "ラビットアニマ",
            "text": "学生の隊員にも",
            "zh": "对学生队员",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "148/TALK",
            "narrator": "ラビットアニマ",
            "text": "危険な任務を任せている",
            "zh": "也把危险任务交了出去",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "149/TALK",
            "narrator": "ラビットアニマ",
            "text": "そういう可能性もあるのでは？",
            "zh": "也有这种可能不是吗？",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "151/TALK",
            "narrator": "ラビットアニマ",
            "text": "どう思いますか？",
            "zh": "你怎么看？",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "わからない",
            "zh": "不知道",
            "narrator_zh": "雅"
        },
        {
            "location": "154/TALK",
            "narrator": "みやび",
            "text": "しかし現状",
            "zh": "但目前",
            "narrator_zh": "雅"
        },
        {
            "location": "155/TALK",
            "narrator": "みやび",
            "text": "フェノメノンは出ていない",
            "zh": "PhenoMENON并没有出现",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "みやび",
            "text": "ならば",
            "zh": "那么",
            "narrator_zh": "雅"
        },
        {
            "location": "157/TALK",
            "narrator": "みやび",
            "text": "今のところは安心してもよいだろう",
            "zh": "眼下还是可以放心的吧",
            "narrator_zh": "雅"
        },
        {
            "location": "160/TALK",
            "narrator": "みやび",
            "text": "心配なのはわかるが",
            "zh": "担心我明白",
            "narrator_zh": "雅"
        },
        {
            "location": "161/TALK",
            "narrator": "みやび",
            "text": "冷静さを忘れてはいけない",
            "zh": "但不能忘了冷静",
            "narrator_zh": "雅"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "無用の心配は",
            "zh": "无谓的担心",
            "narrator_zh": "雅"
        },
        {
            "location": "163/TALK",
            "narrator": "みやび",
            "text": "己の判断を鈍らせることになる",
            "zh": "只会钝化自己的判断",
            "narrator_zh": "雅"
        },
        {
            "location": "166/TALK",
            "narrator": "ラビットアニマ",
            "text": "申し訳ありません",
            "zh": "非常抱歉",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "167/TALK",
            "narrator": "ラビットアニマ",
            "text": "ひなこには",
            "zh": "我会告诉小雏",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "168/TALK",
            "narrator": "ラビットアニマ",
            "text": "心配ないと伝えておきます",
            "zh": "让她不用担心",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "169/TALK",
            "narrator": "みやび",
            "text": "うむ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "170/TALK",
            "narrator": "みやび",
            "text": "またなにかあれば",
            "zh": "要是有别的事",
            "narrator_zh": "雅"
        },
        {
            "location": "171/TALK",
            "narrator": "みやび",
            "text": "いつでも連絡してくるがよい",
            "zh": "随时联络便是",
            "narrator_zh": "雅"
        },
        {
            "location": "182/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "183/TALK",
            "narrator": "みやび",
            "text": "ふむ…。",
            "zh": "唔……。",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "みやび",
            "text": "フォローはしといたけんど、\nつばめちゃん、ＷＡＶＥを\n返さんかったか…。",
            "zh": "关注是关注了，但是\n燕她\n没回ＷＡＶＥ啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "186/TALK",
            "narrator": "みやび",
            "text": "なにかしら、思うところが\nあるんやろうなぁ…。",
            "zh": "肯定是有什么\n想法咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "200/TALK",
            "narrator": "みやび",
            "text": "少し驚いたぞね",
            "zh": "是有点吃惊咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "202/SEL",
            "narrator": "",
            "text": "なにに驚いたの？",
            "zh": "吃惊什么？",
            "narrator_zh": ""
        },
        {
            "location": "203/SEL",
            "narrator": "",
            "text": "繭のこと？",
            "zh": "是茧的事？",
            "narrator_zh": ""
        },
        {
            "location": "204/ACT",
            "narrator": "",
            "text": "なにに驚いたの？",
            "zh": "吃惊什么？",
            "narrator_zh": ""
        },
        {
            "location": "205/TALK",
            "narrator": "みやび",
            "text": "うさぎのことだ",
            "zh": "是兔子的事",
            "narrator_zh": "雅"
        },
        {
            "location": "206/TALK",
            "narrator": "みやび",
            "text": "気づかなかったのか？",
            "zh": "你没发现吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "207/TALK",
            "narrator": "みやび",
            "text": "どうせ",
            "zh": "反正",
            "narrator_zh": "雅"
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "うちとの会話",
            "zh": "我和它的对话",
            "narrator_zh": "雅"
        },
        {
            "location": "209/TALK",
            "narrator": "みやび",
            "text": "見ていたのだろう？",
            "zh": "你都一直在看着吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "210/ACT",
            "narrator": "",
            "text": "繭のこと？",
            "zh": "是茧的事？",
            "narrator_zh": ""
        },
        {
            "location": "211/TALK",
            "narrator": "みやび",
            "text": "その通りだ",
            "zh": "没错",
            "narrator_zh": "雅"
        },
        {
            "location": "212/TALK",
            "narrator": "みやび",
            "text": "相棒も気づいたか？",
            "zh": "搭档也发现了？",
            "narrator_zh": "雅"
        },
        {
            "location": "214/TALK",
            "narrator": "みやび",
            "text": "うさぎはあの性格だが",
            "zh": "兔子虽然就那副性格",
            "narrator_zh": "雅"
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "かなり友達思いなのだ",
            "zh": "其实相当为朋友着想",
            "narrator_zh": "雅"
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "とはいえ",
            "zh": "话虽如此",
            "narrator_zh": "雅"
        },
        {
            "location": "218/TALK",
            "narrator": "みやび",
            "text": "キリトくんとヒカルくんのことを",
            "zh": "圣翔和光的事",
            "narrator_zh": "雅"
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "冷静さを失うほど",
            "zh": "居然让她担心到",
            "narrator_zh": "雅"
        },
        {
            "location": "220/TALK",
            "narrator": "みやび",
            "text": "心配しているとは",
            "zh": "失去冷静的地步",
            "narrator_zh": "雅"
        },
        {
            "location": "221/TALK",
            "narrator": "みやび",
            "text": "それくらい",
            "zh": "那就说明",
            "narrator_zh": "雅"
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "大切ということか",
            "zh": "他们有多重要啊",
            "narrator_zh": "雅"
        },
        {
            "location": "226/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不",
            "narrator_zh": "雅"
        },
        {
            "location": "227/TALK",
            "narrator": "みやび",
            "text": "まさかとは思うが",
            "zh": "虽然觉得不可能",
            "narrator_zh": "雅"
        },
        {
            "location": "229/TALK",
            "narrator": "みやび",
            "text": "大切なのは二人ではなく",
            "zh": "重要的不是两个人",
            "narrator_zh": "雅"
        },
        {
            "location": "230/TALK",
            "narrator": "みやび",
            "text": "どちらか片方か？",
            "zh": "而是其中一个？",
            "narrator_zh": "雅"
        },
        {
            "location": "232/SEL",
            "narrator": "",
            "text": "そうだと嬉しい？",
            "zh": "那样你会高兴？",
            "narrator_zh": ""
        },
        {
            "location": "233/SEL",
            "narrator": "",
            "text": "そうだと寂しい？",
            "zh": "那样你会寂寞？",
            "narrator_zh": ""
        },
        {
            "location": "234/SEL",
            "narrator": "",
            "text": "あはは、まさか！",
            "zh": "啊哈哈，怎么可能！",
            "narrator_zh": ""
        },
        {
            "location": "235/ACT",
            "narrator": "",
            "text": "そうだと嬉しい？",
            "zh": "那样你会高兴？",
            "narrator_zh": ""
        },
        {
            "location": "236/TALK",
            "narrator": "みやび",
            "text": "どうだろうか？",
            "zh": "谁知道呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "237/TALK",
            "narrator": "みやび",
            "text": "応援はする",
            "zh": "支持还是会支持的",
            "narrator_zh": "雅"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "しかし",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "みやび",
            "text": "所詮は他人の恋路",
            "zh": "终究是别人的恋爱",
            "narrator_zh": "雅"
        },
        {
            "location": "240/TALK",
            "narrator": "みやび",
            "text": "うちが喜ぶことではない",
            "zh": "轮不到我来高兴",
            "narrator_zh": "雅"
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "というか",
            "zh": "话说",
            "narrator_zh": "雅"
        },
        {
            "location": "244/TALK",
            "narrator": "みやび",
            "text": "うさぎが恋とか",
            "zh": "兔子谈恋爱什么的",
            "narrator_zh": "雅"
        },
        {
            "location": "245/TALK",
            "narrator": "みやび",
            "text": "リアリティ感じられんな",
            "zh": "实在感受不到啊",
            "narrator_zh": "雅"
        },
        {
            "location": "246/TALK",
            "narrator": "みやび",
            "text": "うちの勘違いやろうし",
            "zh": "多半是我搞错了咯",
            "narrator_zh": "雅"
        },
        {
            "location": "248/TALK",
            "narrator": "みやび",
            "text": "この話はここまでだ",
            "zh": "这个话题到此为止",
            "narrator_zh": "雅"
        },
        {
            "location": "249/ACT",
            "narrator": "",
            "text": "そうだと寂しい？",
            "zh": "那样你会寂寞？",
            "narrator_zh": ""
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "寂しいとは？",
            "zh": "寂寞是指？",
            "narrator_zh": "雅"
        },
        {
            "location": "252/SEL",
            "narrator": "",
            "text": "繭を取られちゃうから",
            "zh": "因为茧会被抢走呀",
            "narrator_zh": ""
        },
        {
            "location": "253/ACT",
            "narrator": "",
            "text": "繭を取られちゃうから",
            "zh": "因为茧会被抢走呀",
            "narrator_zh": ""
        },
        {
            "location": "255/TALK",
            "narrator": "みやび",
            "text": "取られるとか",
            "zh": "被抢走什么的",
            "narrator_zh": "雅"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "思うてないぞね",
            "zh": "我可没想过咧",
            "narrator_zh": "雅"
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "そもそもうちには",
            "zh": "再说了，在我这里",
            "narrator_zh": "雅"
        },
        {
            "location": "258/TALK",
            "narrator": "みやび",
            "text": "うさぎを独占しようという気持ちなど",
