            "narrator_zh": "雅"
        },
        {
            "location": "270/TALK",
            "narrator": "みやび",
            "text": "うさぎを取られるとうちが寂しくなる",
            "zh": "兔子被抢走的话，我会寂寞",
            "narrator_zh": "雅"
        },
        {
            "location": "271/TALK",
            "narrator": "みやび",
            "text": "何故そう思うた？",
            "zh": "为什么会这么想咩……。",
            "narrator_zh": "雅"
        },
