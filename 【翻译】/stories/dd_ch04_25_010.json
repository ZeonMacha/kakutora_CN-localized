            "location": "260/TALK",
            "narrator": "みやび",
            "text": "しかし",
            "zh": "不过",
            "narrator_zh": "雅"
        },
        {
            "location": "261/TALK",
            "narrator": "みやび",
            "text": "信頼と信用はしている",
            "zh": "信赖和信任还是有的",
            "narrator_zh": "雅"
        },
        {
            "location": "262/TALK",
            "narrator": "みやび",
            "text": "そして何があろうと",
            "zh": "而且不管发生什么",
            "narrator_zh": "雅"
        },
        {
            "location": "263/TALK",
            "narrator": "みやび",
            "text": "うちらは同士なのだ",
