{
    "dir": "chap12/daydra/dd_ch02_12_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "12252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "裁縫上手",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "擅长缝纫"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "裁縫上手",
            "zh": "擅长缝纫",
            "narrator_zh": ""
        },
        {
            "location": "21/TALK",
            "narrator": "アーヤ",
            "text": "つばめ、ちょっと待って。",
            "zh": "燕，等一下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/TALK",
            "narrator": "つばめ",
            "text": "え、なんですか？",
            "zh": "咦，怎么了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "24/TALK",
            "narrator": "アーヤ",
            "text": "ボタン、\n取れかかってるわ。",
            "zh": "纽扣，\n快掉了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "26/TALK",
            "narrator": "雛",
            "text": "あっ、ほんとだ。\n今にも取れちゃいそう\nだよ。",
            "zh": "啊，真的呢。\n感觉马上就要\n掉下来了。",
            "narrator_zh": "雏"
        },
        {
            "location": "28/TALK",
            "narrator": "アーヤ",
            "text": "直してあげるから、\nちょっと貸して。",
            "zh": "我帮你缝好，\n稍微给我一下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "ちゃんと直ってる？",
            "zh": "缝牢了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "わぁ、アーヤさん\n凄いです！！",
            "zh": "哇，绫水\n好厉害！！",
            "narrator_zh": "燕"
        },
        {
            "location": "44/TALK",
            "narrator": "雛",
            "text": "す、凄い…あっという間に\n直しちゃった…。",
            "zh": "好、好厉害……转眼间\n就缝好了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "大げさね。\nボタンを付けただけ\nなのに。",
            "zh": "太夸张了。\n明明只是钉了个\n纽扣而已。",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "雛",
            "text": "っていうか、綾水様って\n凄く裁縫がお上手なん\nですね！",
            "zh": "话说回来，绫水大人\n缝纫的手艺\n真是高超啊！",
            "narrator_zh": "雏"
        },
        {
            "location": "55/TALK",
            "narrator": "雛",
            "text": "なんだかミシンみたいに\n速くて正確だったから、\nビックリしました！",
            "zh": "简直像缝纫机一样\n又快又准，\n吓了我一跳！",
            "narrator_zh": "雏"
        },
        {
            "location": "57/TALK",
            "narrator": "アーヤ",
            "text": "褒め過ぎよ。",
            "zh": "夸过头了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "…でも、そんなふうに\n言ってもらえると\n嬉しいわ。",
            "zh": "……不过，听你们\n这么夸我，\n我还是很开心的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "凄くかっこよかったです！",
            "zh": "刚才真的好帅！",
            "narrator_zh": "燕"
        },
        {
            "location": "62/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、小さい頃から\nいっぱい練習してたん\nですか？",
            "zh": "果然从小时候起\n就练习过很多次\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "小さい頃はほとんど\nお裁縫なんてやらな\nかったわ。",
            "zh": "小时候几乎\n没怎么碰过\n针线活呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "大学に入ってからは、\n毎日のようにしてるけど。",
            "zh": "不过上了大学之后，\n倒是几乎每天都在缝。",
            "narrator_zh": "绫水"
        },
        {
            "location": "66/TALK",
            "narrator": "雛",
            "text": "ま、毎日！？\n一体何をそんなに\n縫ってるんですか？",
            "zh": "每、每天！？\n您到底在缝些\n什么呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "68/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "咦！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "69/SEL",
            "narrator": "",
            "text": "座布団とかのカバー",
            "zh": "坐垫之类的套子",
            "narrator_zh": ""
        },
        {
            "location": "70/SEL",
            "narrator": "",
            "text": "パッチワーク",
            "zh": "拼布",
            "narrator_zh": ""
        },
        {
            "location": "71/SEL",
            "narrator": "",
            "text": "人形作りって言っちゃえ",
            "zh": "直接说是在做人偶吧",
            "narrator_zh": ""
        },
        {
            "location": "76/TALK",
            "narrator": "アーヤ",
            "text": "どうしよう。\n人形サークルのことは\nみんなには秘密だから――",
            "zh": "怎么办。\n人偶社团的事\n我对大家是保密的——",
            "narrator_zh": "绫水"
        },
        {
            "location": "77/TALK",
            "narrator": "アーヤ",
            "text": "毎日人形を作ってる、\nなんて言えないし…。",
            "zh": "总不能说\n每天都在做人偶吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "82/TALK",
            "narrator": "アーヤ",
            "text": "えっと…ごめんなさい。\n毎日は言い過ぎたわ。",
            "zh": "那个……抱歉。\n说每天有点夸张了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "アーヤ",
            "text": "でも、古着とかを買うと\nたまに傷んだりしている\nことがあるでしょ？",
            "zh": "不过，买二手衣服什么的\n偶尔会有破损的\n地方对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "そういうのはよく手直し\nしてるからだと思うわ。",
            "zh": "大概是因为经常\n修补那些衣服吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "雛",
            "text": "なるほど…そういうこと\nだったんですね。",
            "zh": "原来如此……是这么\n一回事呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "87/TALK",
            "narrator": "つばめ",
            "text": "古着かぁ…わたしも今度、\n見に行ってみようかな？",
            "zh": "二手衣服呀……我也下次\n去逛逛看吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "掘り出し物が見つかると\nいいわね。",
            "zh": "祝你能淘到\n好东西哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "91/ACT",
            "narrator": "",
            "text": "座布団とかのカバー",
            "zh": "坐垫之类的套子",
            "narrator_zh": ""
        },
        {
            "location": "111/TALK",
            "narrator": "アーヤ",
            "text": "それでいくわ、ありがと！",
            "zh": "就用这个了，谢谢！",
            "narrator_zh": "绫水"
        },
        {
            "location": "123/TALK",
            "narrator": "アーヤ",
            "text": "えっと…座布団とか、\n枕とかのカバーを\n作ってるの。",
            "zh": "那个……我在做\n坐垫、枕头之类\n的套子。",
            "narrator_zh": "绫水"
        },
        {
            "location": "125/TALK",
            "narrator": "雛",
            "text": "えっ…座布団や枕の\nカバー…ですか？",
            "zh": "咦……坐垫和枕头的\n套子……吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "127/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん、そんなに\n毎日作らなきゃいけない\nほど――",
            "zh": "绫水，你家里有\n多到必须每天都做\n的程度——",
            "narrator_zh": "燕"
        },
        {
            "location": "128/TALK",
            "narrator": "つばめ",
            "text": "たくさん座布団や枕を\n持ってるんですか？",
            "zh": "那么多坐垫和\n枕头吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "咦！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "133/TALK",
            "narrator": "アーヤ",
            "text": "そ、そうよ、どう考えても\nおかしいわ！",
            "zh": "是、是啊，怎么想\n都很奇怪吧！",
            "narrator_zh": "绫水"
        },
        {
            "location": "134/TALK",
            "narrator": "アーヤ",
            "text": "毎日毎日座布団や枕の\nカバーを作ってるなんて。",
            "zh": "哪有人天天都在做\n坐垫和枕头套的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "137/TALK",
            "narrator": "雛",
            "text": "変わったご趣味ですね…。",
            "zh": "真是奇特的爱好呢……。",
            "narrator_zh": "雏"
        },
        {
            "location": "139/TALK",
            "narrator": "雛",
            "text": "あ、でも綾水様なら\nどんな趣味でも素敵だと\n思いますよ！",
            "zh": "啊，不过如果是绫水大人的话，\n不管什么爱好我都觉得\n很棒哦！",
            "narrator_zh": "雏"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "もっと考えてから\n言うべきだったわ…。",
            "zh": "真该多想一想\n再说出口的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/ACT",
            "narrator": "",
            "text": "パッチワーク",
            "zh": "拼布",
            "narrator_zh": ""
        },
        {
            "location": "151/TALK",
            "narrator": "アーヤ",
            "text": "ごめん、ちょっと待って。",
            "zh": "抱歉，等我一下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "165/TALK",
            "narrator": "アーヤ",
            "text": "素敵！",
            "zh": "太棒了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "166/TALK",
            "narrator": "アーヤ",
            "text": "とってもいいと思うわ",
            "zh": "我觉得这个主意很不错",
            "narrator_zh": "绫水"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "相談してよかった、ありがとヽ(*^^*)ノ",
            "zh": "找你商量真是太好了，谢谢ヽ(*^^*)ノ",
            "narrator_zh": "绫水"
        },
        {
            "location": "179/TALK",
            "narrator": "アーヤ",
            "text": "おまたせ。\nさっきの話の\n続きだけど――",
            "zh": "久等了。\n接着刚才的话题\n说——",
            "narrator_zh": "绫水"
        },
        {
            "location": "180/TALK",
            "narrator": "アーヤ",
            "text": "実は、毎日少しずつ\nパッチワークを作って\nるの。",
            "zh": "其实，我每天都在一点点\n做拼布\n呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "182/TALK",
            "narrator": "つばめ",
            "text": "それって、小さな布を\n縫い合わせて、一枚の\n布にするやつですよね？",
            "zh": "那个就是把小块布头\n缝合在一起，做成一整块\n布的手工对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "183/TALK",
            "narrator": "雛",
            "text": "わぁ、素敵です綾水様！",
            "zh": "哇，好棒呀绫水大人！",
            "narrator_zh": "雏"
        },
        {
            "location": "184/TALK",
            "narrator": "雛",
            "text": "凄くオシャレで、\nすっごくかっこいいです！",
            "zh": "好时尚，\n而且超级帅气！",
            "narrator_zh": "雏"
        },
        {
            "location": "185/TALK",
            "narrator": "アーヤ",
            "text": "そ、そう？",
            "zh": "是、是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "188/TALK",
            "narrator": "つばめ",
            "text": "わたしもそう思います！",
            "zh": "我也这么觉得！",
            "narrator_zh": "燕"
        },
        {
            "location": "189/TALK",
            "narrator": "雛",
            "text": "どんな作品なんだろ？\nよろしければ今度\n拝見させてください！",
            "zh": "会是什么样的作品呢？\n如果不介意的话，下次\n请务必让我参观一下！",
            "narrator_zh": "雏"
        },
        {
            "location": "190/TALK",
            "narrator": "アーヤ",
            "text": "え、ええ…わかったわ。",
            "zh": "嗯、嗯……我知道了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "本当はやったことも\nないんだけど――",
            "zh": "其实我以前连碰都\n没碰过——",
            "narrator_zh": "绫水"
        },
        {
            "location": "194/TALK",
            "narrator": "アーヤ",
            "text": "でも、ちょっと楽しそう\nだし、これを機に始めて\nみようかしら？",
            "zh": "不过，听起来还挺有意思的，\n干脆趁这个机会试着\n做做看吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "211/ACT",
            "narrator": "",
            "text": "人形作りって言っちゃえ",
            "zh": "直接说是在做人偶吧",
            "narrator_zh": ""
        },
        {
            "location": "218/TALK",
            "narrator": "アーヤ",
            "text": "あ、何かしら？\nメールみたいだから\nちょっと待って。",
            "zh": "啊，是什么呢？\n好像是消息，\n等我一下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/TALK",
            "narrator": "アーヤ",
            "text": "言えない！",
            "zh": "说不出口啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "233/TALK",
            "narrator": "アーヤ",
            "text": "それを隠したいから相談してるのに！",
            "zh": "就是想瞒住这件事才找你商量的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "234/TALK",
            "narrator": "アーヤ",
            "text": "もう自分で考える",
            "zh": "算了我自己想办法",
            "narrator_zh": "绫水"
        },
        {
            "location": "246/TALK",
            "narrator": "アーヤ",
            "text": "…とは言ったけど、\nなんて言おうかしら？",
            "zh": "……话虽这么说，\n该怎么圆过去呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "249/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、自分の服とか\n作ったりしてるのかな？",
            "zh": "难道说，是在自己\n做衣服穿吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "251/TALK",
            "narrator": "雛",
            "text": "う～ん…綾水様は服より、\nインテリアになりそうな\n物を作りそうだけど…。",
            "zh": "唔～……我觉得比起衣服，\n绫水大人更像是会做\n室内装饰品的样子……。",
            "narrator_zh": "雏"
        },
        {
            "location": "254/TALK",
            "narrator": "アーヤ",
            "text": "…もしかして、正直に\n言っても平気かも。",
            "zh": "……说不定，老实说出来\n也没什么关系。",
            "narrator_zh": "绫水"
        },
        {
            "location": "256/TALK",
            "narrator": "アーヤ",
            "text": "冗談だと思われて笑って\nおしまい、ってことに\nなってくれるんじゃ…。",
            "zh": "她们说不定会当成玩笑\n笑笑就过去\n了呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "257/TALK",
            "narrator": "アーヤ",
            "text": "…よし、言ってみよう！",
            "zh": "……好，试着说说看吧！",
            "narrator_zh": "绫水"
        },
        {
            "location": "259/TALK",
            "narrator": "アーヤ",
            "text": "私が毎日お裁縫をする\n理由は…。",
            "zh": "我每天做针线活的\n原因是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "263/TALK",
            "narrator": "つばめ",
            "text": "ワクワク！",
            "zh": "好期待！",
            "narrator_zh": "燕"
        },
        {
            "location": "265/TALK",
            "narrator": "アーヤ",
            "text": "えっと……。",
            "zh": "那个……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "267/TALK",
            "narrator": "雛",
            "text": "なんですかなんですか？",
            "zh": "是什么呀是什么呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "270/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "274/TALK",
            "narrator": "アーヤ",
            "text": "あっ、そろそろ講義の\n時間だから！\nそれじゃあ！",
            "zh": "啊，差不多到上课的\n时间了！\n我先走啦！",
            "narrator_zh": "绫水"
        },
        {
            "location": "280/TALK",
            "narrator": "つばめ",
            "text": "あ、アーヤさん！？",
            "zh": "啊，绫水！？",
            "narrator_zh": "燕"
        },
        {
            "location": "286/TALK",
            "narrator": "雛",
            "text": "綾水様、せめてヒントを！\n気になっちゃうからー！！",
            "zh": "绫水大人，至少给点提示嘛！\n让人好在意啊——！！",
            "narrator_zh": "雏"
        },
        {
            "location": "303/TALK",
            "narrator": "アーヤ",
            "text": "ごめん、二人とも！",
            "zh": "抱歉，你们俩！",
            "narrator_zh": "绫水"
        },
        {
            "location": "305/TALK",
            "narrator": "アーヤ",
            "text": "でも…やっぱり\n恥ずかしくて言えない！",
            "zh": "可是……我果然还是\n太害羞说不出口啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "18/DIALOG",
            "narrator": "Dialog_EventData",
