    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "襲撃前夜～アーヤ編～",
            "zh": "袭击前夜～绫水篇～",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "――というわけで、\n館長からいつ連絡が\n来るかわからない。",
            "zh": "——总之就是这样，\n不知道馆长什么时候\n才会联系过来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "27/TALK",
            "narrator": "アーヤ",
            "text": "だから、今夜はみんな、\n劇場に泊まってもらうわ。",
            "zh": "所以今晚大家\n都留在剧场过夜吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "みやび",
            "text": "やっぱそうなるかぁ…。\nまあ、しゃあないな。",
            "zh": "果然还是变成这样了啊……。\n嘛，也是没办法的事。",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "アーヤ",
            "text": "それと、外部と連絡を\nする場合は、間違っても\nストの話はしないこと。",
            "zh": "还有，如果和外界联系，\n千万注意\n别提罢工的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "みんな、いい？",
            "zh": "大家听明白了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "りょーかい。",
            "zh": "收到——。",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "つばめ",
            "text": "わかりました…。",
            "zh": "我知道了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "言うわけないでしょ？\n機密漏えいに\nなっちゃうし…。",
            "zh": "怎么可能说嘛？\n那不就成了\n泄露机密了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "うん…それじゃみんな、\nよろしくね。",
            "zh": "嗯……那大家，\n就拜托了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "…わたしたち、\nどうなっちゃうんだろ？",
            "zh": "……我们，\n接下来会变成怎样呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、情けない声\n出して…頼りないわねぇ。",
            "zh": "真是的，干嘛发出这么没出息的声音……\n太靠不住了吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんは\n不安じゃないの？",
            "zh": "加布\n你不觉得不安吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "不安に決まってるでしょ？",
            "zh": "怎么可能不不安嘛？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、不安だからって\n暗くなってても\n仕方ないじゃない。",
            "zh": "可是，就算因为不安\n垂头丧气的\n也于事无补吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、ギャヴィも\n不安みたいね…。",
            "zh": "看来加维\n果然也很不安呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "アーヤ",
            "text": "まあ、仕方ないか。",
            "zh": "嘛，也是难免的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "これからどうなるのかを\n考えれば、誰だって\n不安になると思うし…。",
            "zh": "一想到接下来会怎么样，\n任谁都会感到\n不安吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "アーヤ",
            "text": "館長からの次の連絡、\nいつになるのかしら？",
            "zh": "馆长的下一次联系，\n究竟什么时候才会来呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "もしもの時は指揮権を\n譲るって言ってたけど…。",
            "zh": "虽然说过万一有事\n就把指挥权交给我……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "自分たちの状況すら把握\nできていないのに…、\nどうすればいいんだか…。",
            "zh": "连我们自己的处境\n都还没掌握清楚……，\n这叫我该怎么办才好啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "59/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "うち、向こうでちくっと\n考え事してるちや。",
            "zh": "我先去那边\n想一哈事情咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "アーヤ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "アーヤ",
            "text": "いけない…。\n少しピリピリし過ぎた\nかも…。",
            "zh": "不好……。\n是不是稍微\n太神经紧绷了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "…みやび、嫌な気持ちに\nさせてしまったかしら？",
            "zh": "……雅，是不是让她\n心情不好了呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "アーヤ",
            "text": "…頭冷やさなくちゃ。",
            "zh": "……得冷静一下才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "アーヤ",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "もう真っ暗…。\nいつもだったら、\n寮にいる時間か…。",
            "zh": "天已经黑透了……。\n平时的话，\n这时候应该在宿舍吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "…明日は、小夜と一緒の\n講義があるんだった。",
            "zh": "……对了，明天还有和小夜\n一起上的课。",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "終わったらランチに行く\n約束してたけど…、\n確実に無理よね…。",
            "zh": "原本约好了下课后\n一起去吃午饭……，\n肯定去不成了吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "アーヤ",
            "text": "…多分、しばらくの間は。",
            "zh": "……大概，接下来一阵子都是这样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "…ああ、もう！",
            "zh": "……啊啊，真是的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "アーヤ",
            "text": "特別攻撃隊の仕事は、\nなにが起こるか\nわからない。",
            "zh": "特别攻击队的工作，\n谁也说不准\n会发生什么。",
            "narrator_zh": "绫水"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "覚悟はしてたけど…、\nこんなの想定外過ぎよ。",
            "zh": "虽然早有觉悟……，\n可这也太超出预想了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "私だって…本当はみんなと\n同じで不安がったり…。",
            "zh": "我其实也……和大家一样\n会觉得不安……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "アーヤ",
            "text": "慌てたり焦ったり、\n色々したいのに…！",
            "zh": "也会惊慌失措、手忙脚乱，\n什么情绪都会有啊……！",
            "narrator_zh": "绫水"
        },
        {
            "location": "95/SEL",
            "narrator": "",
            "text": "顔が険しいよ",
