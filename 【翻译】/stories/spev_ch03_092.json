{
    "dir": "chap00/daydra/spev_ch03_092.js",
    "type": "",
    "info": {
        "story_id": "91032",
        "cid": "",
        "title": "ぴょんこのサマー大作戦♪",
        "sub_title": "ぴょんこのサマー大作戦♪②【ガブリエラ編】",
        "title_zh": "蹦子的夏日大作战♪",
        "sub_title_zh": "蹦子的夏日大作战♪②【加布里埃拉篇】"
    },
    "entry": [
        {
            "location": "15/DIALOG",
            "narrator": "",
            "text": "<color=green>7月14日　3:43 PM</color>\nとある平日、神楽坂トライナリー劇場にて",
            "zh": "<color=green>7月14日　3:43 PM</color>\n某个平日，在神乐坂三重奏剧场",
            "narrator_zh": ""
        },
        {
            "location": "25/TALK",
            "narrator": "ガブリエラ",
            "text": "えーっと…。",
            "zh": "嗯——……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "〇月×日。\n今日もバイトは\n暇・暇・暇！",
            "zh": "〇月×日。\n今天的打工依然是\n闲・闲・闲！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "27/TALK",
            "narrator": "ガブリエラ",
            "text": "ラクなのはいいけど、\nとっても退屈で\n嫌になっちゃう。",
            "zh": "轻松倒是挺轻松，\n就是无聊得\n让人烦躁起来了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "28/TALK",
            "narrator": "ガブリエラ",
            "text": "お客さんもいないんだし、\nみんなでどこかに\n遊びに行きたいな。",
            "zh": "反正也没什么客人，\n真想大家一起\n去哪里玩一玩啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "ガブリエラ",
            "text": "例えば、遊園地とか！",
            "zh": "比如说，游乐园之类的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "期間限定のパレード、\nとっても可愛いから\n必見って、ネットで――",
            "zh": "听说限期举办的游行\n特别可爱，绝对不容错过，\n网上都在说——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "神楽",
            "text": "あ、ガブちゃん。\nお疲れさまです。",
            "zh": "啊，加布。\n辛苦了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "39/TALK",
            "narrator": "ガブリエラ",
            "text": "か、神楽！？",
            "zh": "神、神乐！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "46/TALK",
            "narrator": "神楽",
            "text": "ふふっ、またノート\n書いてたんですか？",
            "zh": "呵呵，你又在写\n笔记本了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "…い、いいでしょ？\n休憩時間なんだし…。",
            "zh": "……写、写写怎么了？\n反正现在是休息时间……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "49/TALK",
            "narrator": "神楽",
            "text": "別に悪いなんて\n言ってませんよ。",
            "zh": "我也没说这样\n不好呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "50/TALK",
            "narrator": "神楽",
            "text": "ただ、そろそろ何を\n書いてるのか教えて\nほしいなぁ、って…。",
            "zh": "只是觉得，差不多\n也该告诉我里面到底\n写了些什么了吧……",
            "narrator_zh": "神乐"
        },
        {
            "location": "51/TALK",
            "narrator": "ガブリエラ",
            "text": "だ、ダメよ！",
            "zh": "不、不行！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "これは秘密！\nあたしのプライバシー\nなんだから！",
            "zh": "这是秘密！\n这可是我的\n个人隐私！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "神楽",
            "text": "えーっ！\nそろそろ少しくらい\nいいじゃないですか。",
            "zh": "诶——！\n都这么久了，稍微看一点\n又没关系嘛。",
            "narrator_zh": "神乐"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "ぜ、絶対ダメ！",
            "zh": "绝、绝对不行！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "59/TALK",
            "narrator": "神楽",
            "text": "もぅ、ガブちゃんは\n本当に照れ屋さんですね。",
            "zh": "真是的，加布\n还真是爱害羞呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "60/TALK",
            "narrator": "神楽",
            "text": "それが日記であれ\n小説であれ、恥ずかしがる\nことないのに。",
            "zh": "不管是日记\n还是小说，明明都\n没什么好害羞的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "適当なこと言わないでよ。",
            "zh": "别瞎猜乱说啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽だって、\n書いたものを勝手に\n見られたら嫌でしょ？",
            "zh": "换作神乐你，自己写的东西\n要是被人擅自偷看，\n也会讨厌的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "神楽",
            "text": "んー、そうでしょうか？",
            "zh": "嗯——，会吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "65/TALK",
            "narrator": "神楽",
            "text": "私なんかは、たまに\nショートストーリーとか\n書きますけど――",
            "zh": "像我的话，偶尔也会写点\n小短篇故事\n之类的——",
            "narrator_zh": "神乐"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "…………ああ、\nそういえば。\nで？　それが？",
            "zh": "…………啊啊，\n说起来是有这回事。\n然后呢？那又怎样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "神楽",
            "text": "それを人に見られたって\n全然恥ずかしく\nありません！",
            "zh": "那种东西就算被人看了，\n我也一点都不觉得\n害羞哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "69/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、ちょっと待って！",
            "zh": "不对，等一下！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "人に見せる目的で書いてる\n物語と、秘密だらけの\n日記を一緒にしないでよ！",
            "zh": "别把本来就是为了给人看\n才写的故事，跟满是秘密的\n日记混为一谈啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "神楽",
            "text": "ちっ…",
            "zh": "啧……",
            "narrator_zh": "神乐"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "今、すごく悪い顔\nしてなかった！？",
            "zh": "你刚才，是不是摆出一副\n很坏的表情来着！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "神楽",
            "text": "いいえ？",
            "zh": "没有呀？",
            "narrator_zh": "神乐"
        },
        {
            "location": "79/TALK",
            "narrator": "神楽",
            "text": "でも物語って、\n実際書いてみると\nとっても楽しいですよね！",
            "zh": "不过写故事这件事，\n实际动手写起来\n真的特别有趣呢！",
            "narrator_zh": "神乐"
        },
        {
            "location": "80/TALK",
            "narrator": "神楽",
            "text": "頭の中で想像していた\n世界が文字で形になって\nいくのが見えるのって…。",
            "zh": "看着脑海里想象过的\n世界借由文字一点点\n成形的过程……",
            "narrator_zh": "神乐"
        },
        {
            "location": "81/TALK",
            "narrator": "神楽",
            "text": "そこに、どんな挿絵を\n添えると良いかなぁって\n考えるのも楽しいです。",
            "zh": "顺便琢磨着在里面\n配什么样的插画比较合适，\n也非常有意思呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "82/TALK",
            "narrator": "神楽",
            "text": "いつか、ちゃんと同……\nじゃなくて、本として\n出版してみたいですっ！",
            "zh": "总有一天，我想正经作为同……\n不对，作为书正式\n出版出来试试看！",
            "narrator_zh": "神乐"
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "本！？\nそれ本気！？",
            "zh": "出书！？\n你认真的！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "神楽",
            "text": "だって、ただ書いて\n終わりなんて、\n勿体ないじゃないですか。",
            "zh": "因为，光写完就这么\n放着不管，\n未免太可惜了嘛。",
            "narrator_zh": "神乐"
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱりあんたって\nただ者じゃないわね。",
            "zh": "……你果然\n不是一般人呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "神楽",
            "text": "ですから、ガブちゃんも\nそんなに隠してたら\n勿体ないですよ。",
            "zh": "所以说，加布也这么\n藏着掖着的话，\n太可惜了哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "88/TALK",
            "narrator": "神楽",
            "text": "恥ずかしがらずに、\n世間に大公開する気持ちで\nいきましょう！",
            "zh": "别再害羞了，\n抱着向全世界大公开的气势\n豁出去吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "きゃ、却下！\nあたしは絶対に\n見せないから…。",
            "zh": "驳、驳回！\n我绝对不会\n给人看的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "神楽",
            "text": "ちっ…",
            "zh": "啧……",
            "narrator_zh": "神乐"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、また！！",
            "zh": "你看，又来！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "だ、だいたい\nあたしの日記なんて\n全然面白くないから！",
            "zh": "而、而且再说了，\n我的日记什么的\n根本一点也不有趣！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "人に見せるために書いて\nるわけじゃないもの。",
            "zh": "原本就不是为了给别人看\n才写的嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "神楽",
            "text": "そうですか…。",
            "zh": "这样啊……",
            "narrator_zh": "神乐"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。\nわかってくれた？",
            "zh": "呼……\n你明白了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "神楽",
            "text": "…じゃあ、私にだけ\nこっそりっていうのは\nどうですか？",
            "zh": "……那，只悄悄给\n我一个人看的话\n怎么样呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "それも却下！",
            "zh": "那也驳回！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "神楽",
            "text": "じゃ、じゃあ、見せ合い\nっこならどうですか？",
            "zh": "那、那这样，我们互相\n交换着看怎么样？",
            "narrator_zh": "神乐"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "見せ合いっこって、\n神楽のは最終的に\n本にするんでしょ？",
            "zh": "还互相交换着看，\n神乐你的东西最后不都是\n要拿去出书的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "ガブリエラ",
            "text": "見せ合わなくても、\n完成したら\n簡単に見れるじゃない。",
            "zh": "就算现在不交换着看，\n等写完了之后\n还不是轻轻松松就能看到。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "神楽",
            "text": "そんなことないですよ！",
            "zh": "才没那种事呢！",
            "narrator_zh": "神乐"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "え？\nなんで？",
            "zh": "诶？\n为什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "神楽",
            "text": "え！？\nあ、えっと、\nそれはですね！",
            "zh": "诶！？\n啊、那个，\n这个嘛！",
            "narrator_zh": "神乐"
        },
        {
            "location": "112/TALK",
            "narrator": "神楽",
            "text": "まだ、全然ラフ中のラフ\nなので、完全に支離滅裂\n状態といいますか……。",
            "zh": "现在还完全处于\n草稿中的草稿阶段，\n该说是彻头彻尾的支离破碎吗……",
            "narrator_zh": "神乐"
        },
        {
            "location": "113/TALK",
            "narrator": "神楽",
            "text": "だから、これから\n大幅に書き直すことに\nなるんですよ！",
            "zh": "所以，接下来\n还得大幅度地\n重写一遍才行呢！",
            "narrator_zh": "神乐"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん…結構本格的に\n書いてるのね。",
            "zh": "嗯……看来写得\n还挺像模像样的嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "神楽",
            "text": "え、ええ…まあ…。",
            "zh": "嗯、嗯……算是吧……",
            "narrator_zh": "神乐"
        },
        {
            "location": "116/TALK",
            "narrator": "神楽",
            "text": "ガブちゃん！\n私たち、創作仲間じゃ\nありませんか。",
            "zh": "加布！\n我们不是\n创作同好嘛。",
            "narrator_zh": "神乐"
        },
        {
            "location": "117/TALK",
            "narrator": "神楽",
            "text": "だから、気にせず\nちょっとだけ\n見せてくださいっ！",
            "zh": "所以，请别介意，\n就给我稍微\n看一眼嘛！",
            "narrator_zh": "神乐"
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "しつこいわねぇ…。",
            "zh": "真是缠人呀……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/SEL",
            "narrator": "（選択肢）",
            "text": "見せ合いっこならよくない？",
            "zh": "互相交换着看不挺好的吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "121/SEL",
            "narrator": "（選択肢）",
            "text": "神楽のを見せてもらおう",
            "zh": "让神乐给你看她写的吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "122/SEL",
            "narrator": "（選択肢）",
            "text": "そんなに恥ずかしいの？",
            "zh": "有那么不好意思吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "123/ACT",
            "narrator": "",
            "text": "見せ合いっこならよくない？",
            "zh": "互相交换着看不挺好的吗？",
            "narrator_zh": ""
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "あのね$marzanna$",
            "zh": "听我说呀$marzanna$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "141/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしが書いてるの",
            "zh": "我写的这东西",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "小説じゃないの",
            "zh": "又不是小说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "日記よ？",
            "zh": "是日记好不好？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "145/SEL",
            "narrator": "（選択肢）",
            "text": "でも神楽の小説気にならない？",
            "zh": "不过你不好奇神乐的小说吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "146/ACT",
            "narrator": "",
            "text": "でも神楽の小説気にならない？",
            "zh": "不过你不好奇神乐的小说吗？",
            "narrator_zh": ""
        },
        {
            "location": "148/TALK",
            "narrator": "ガブリエラ",
            "text": "確かに",
            "zh": "确实",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "わかったわ",
            "zh": "好吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "ガブリエラ",
            "text": "少なくとも",
            "zh": "至少",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽のも見れるんだし",
            "zh": "我也能看到神乐写的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとはマシかも",
            "zh": "这么想想好像还能接受",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/TALK",
            "narrator": "ガブリエラ",
            "text": "…わかったわ。",
            "zh": "……我知道了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "169/TALK",
            "narrator": "神楽",
            "text": "見せてくれるんですか？",
            "zh": "你肯给我看了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "170/TALK",
            "narrator": "ガブリエラ",
            "text": "見せ合いっこならね。\nあたしだけ見せるのは\n嫌だし…。",
            "zh": "要是交换着看的话就成。\n光我单方面给人看\n我可不干……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "171/TALK",
            "narrator": "神楽",
            "text": "もちろんですよ。\nそれじゃ、せーの、で\nノートを交換しましょう。",
            "zh": "那当然没问题。\n那么，喊一二三，\n咱们一起交换笔记本吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "173/TALK",
            "narrator": "ガブリエラ",
            "text": "うん…じゃあ、いい？",
            "zh": "嗯……那，准备好了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "174/TALK",
            "narrator": "神楽",
            "text": "はい。\nせーのっ！！",
            "zh": "好的。\n一二三！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "176/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "177/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "…ちょっと。\n早くノート渡しなさいよ。",
            "zh": "……喂。\n快把笔记本递过来呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "180/TALK",
            "narrator": "神楽",
            "text": "が、ガブちゃんこそ。\nそんな強く握られたら、\n取れないじゃないですか。",
            "zh": "加、加布你才是。\n你攥得那么死，\n我根本抽不出来嘛。",
            "narrator_zh": "神乐"
        },
        {
            "location": "182/TALK",
            "narrator": "ガブリエラ",
            "text": "み、見せ合いっこって\n言ったでしょ！？\n早く渡しなさいよ！",
            "zh": "不、不是说好\n互相交换着看的吗！？\n快点递过来啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "183/TALK",
            "narrator": "神楽",
            "text": "なら、ガブちゃんだって\n渡してください！",
            "zh": "那加布你也先把\n你的递过来呀！",
            "narrator_zh": "神乐"
        },
        {
            "location": "184/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、まずは神楽から\n見せなさいよ。",
            "zh": "先、先从神乐你这边\n拿给我看啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "185/TALK",
            "narrator": "神楽",
            "text": "それじゃ見せ合いっこに\nならないじゃないですか！",
            "zh": "那样不就称不上\n互相交换着看了吗！",
            "narrator_zh": "神乐"
        },
        {
            "location": "186/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "187/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…、結局お互い、\n見せたくないってことね。",
            "zh": "唉……说到底，咱们俩\n谁都不想给对方看呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "神楽",
            "text": "…そうですね。",
            "zh": "……是这样呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "191/TALK",
            "narrator": "ガブリエラ",
            "text": "ていうか、神楽は\n本にして出すのが\n目標なんでしょ？",
            "zh": "话说回来，神乐你的\n目标不是把作品\n印成书出版吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "それなのに\n見せられないって、\nホントに大丈夫なの！？",
            "zh": "话都说到这份上了却还\n拿不出手给别人看，\n真的没问题吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/TALK",
            "narrator": "神楽",
            "text": "だ、だから、今のは\n書き直し前のバージョン\nなんです！",
            "zh": "所、所以我都说了，现在这版\n是重写之前的草稿\n版本啦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラ",
            "text": "はいはい…。",
            "zh": "好好好……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "どっちにしろ、\nお互い見せられない、\nってことね…。",
            "zh": "不管怎么说，\n反正就是谁都拿不出手\n给对方看嘛……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "神楽",
            "text": "はぁ…、\nガブちゃんのノート、\n見たかったなぁ…。",
            "zh": "唉……\n真想看看\n加布的笔记本啊……",
            "narrator_zh": "神乐"
        },
        {
            "location": "199/TALK",
            "narrator": "ガブリエラ",
            "text": "面白いことなんか\n書いてないってば。",
            "zh": "我都说了上面没写什么\n有意思的东西嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "200/ACT",
            "narrator": "",
            "text": "神楽のを見せてもらおう",
            "zh": "让神乐给你看她写的吧",
            "narrator_zh": ""
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽のだけ見せてもらうの？",
            "zh": "光看神乐写的那一份吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "さすがにそれ",
            "zh": "这再怎么说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "219/TALK",
            "narrator": "ガブリエラ",
            "text": "無理じゃない？",
            "zh": "也有点勉强吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "本人だって",
            "zh": "连她自己",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "221/TALK",
            "narrator": "ガブリエラ",
            "text": "積極的に見せる気なさそうだし",
            "zh": "看着也没多想主动拿给人看嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/SEL",
            "narrator": "（選択肢）",
            "text": "内容気にならないの？",
            "zh": "你不好奇里面写了什么吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "224/ACT",
            "narrator": "",
            "text": "内容気にならないの？",
            "zh": "你不好奇里面写了什么吗？",
            "narrator_zh": ""
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "気にはなるけど",
            "zh": "好奇是有点好奇",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ",
            "zh": "行吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "230/TALK",
            "narrator": "ガブリエラ",
            "text": "聞くだけ聞いてみるわ",
            "zh": "那我就先试着问一句好了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "231/TALK",
            "narrator": "ガブリエラ",
            "text": "もしもってこともあるし",
            "zh": "万一她真肯给看呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラ",
            "text": "…とりあえず、\n神楽の書いてる小説\n読ませてよ。",
            "zh": "……总之先让我看看\n神乐你正在写的\n小说呗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/TALK",
            "narrator": "神楽",
            "text": "じゃあ、ガブちゃんのも\n見せてもらえるんですか？",
            "zh": "那加布的笔记\n也能让我看看吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "250/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "251/TALK",
            "narrator": "神楽",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "神乐"
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、早く見せなさいよ。",
            "zh": "好啦，快点拿给我看呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/TALK",
            "narrator": "神楽",
            "text": "えっと…ガブちゃんのは\n見せてくれないんですか？",
            "zh": "那个……加布的那本\n不肯给我看吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "255/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのはいいから、\n神楽の読ませてよ。",
            "zh": "我的就免了，\n快让我看看神乐你写的啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "257/TALK",
            "narrator": "神楽",
            "text": "ちょ、嫌ですよ！\nどうして私だけ\nなんですか！？",
            "zh": "喂、我才不要呢！\n凭什么只看我\n一个人的啊！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "258/TALK",
            "narrator": "ガブリエラ",
            "text": "だって、神楽のはいずれ\n人に見せるんでしょ？",
            "zh": "因为神乐你的故事迟早\n也是要给别人看的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "259/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは別に、\n誰かに見せる目的で\n書いてるわけじゃないし。",
            "zh": "我可不是抱着\n给谁看的目的才\n写东西的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "261/TALK",
            "narrator": "神楽",
            "text": "で、でも、私だけ\n見せるのはちょっと…。",
            "zh": "可、可是，只让我一个人\n拿出来看有点……",
            "narrator_zh": "神乐"
        },
        {
            "location": "262/TALK",
            "narrator": "神楽",
            "text": "さっきも言いましたけど、\nまだ書き直す前の\nバージョンですし…。",
            "zh": "刚才我也说过了，\n这还只是重写之前的\n版本呢……",
            "narrator_zh": "神乐"
        },
        {
            "location": "263/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "264/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…、結局お互い、\n見せたくないってことね。",
            "zh": "唉……说到底，咱们俩\n谁都不想给对方看呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "神楽",
            "text": "…そうですね。",
            "zh": "……是这样呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "268/TALK",
            "narrator": "神楽",
            "text": "あーあ、ガブちゃんが\n何を書いてるのか、\n知りたかったなぁ…。",
            "zh": "啊——啊，真想知道\n加布到底在上面\n写了些什么呀……",
            "narrator_zh": "神乐"
        },
        {
            "location": "269/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのノートより、\n今は自分のお話のこと\n考えなさいよ。",
            "zh": "比起我的笔记本，\n你现在还是先多操心操心\n你自己的故事吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/ACT",
            "narrator": "",
            "text": "そんなに恥ずかしいの？",
            "zh": "有那么不好意思吗？",
            "narrator_zh": ""
        },
        {
            "location": "287/TALK",
            "narrator": "ガブリエラ",
            "text": "恥ずかしい以前の問題よ",
            "zh": "这根本不是害不害羞的问题好吗",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "288/TALK",
            "narrator": "ガブリエラ",
            "text": "普通日記は",
            "zh": "正常的日记本来",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/TALK",
            "narrator": "ガブリエラ",
            "text": "人に見せるものじゃないんだし",
            "zh": "就不是拿给别人看的东西嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "291/SEL",
            "narrator": "（選択肢）",
            "text": "ブログの延長みたいなもんだよ",
            "zh": "就当是博客的延伸嘛",
            "narrator_zh": "（选项）"
        },
        {
            "location": "292/ACT",
            "narrator": "",
            "text": "ブログの延長みたいなもんだよ",
            "zh": "就当是博客的延伸嘛",
            "narrator_zh": ""
        },
        {
            "location": "294/TALK",
            "narrator": "ガブリエラ",
            "text": "いや全然違うし！",
            "zh": "不对，完全不一样好吗！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "295/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり",
            "zh": "果然还是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "296/TALK",
            "narrator": "ガブリエラ",
            "text": "私のノートは見せられないわ",
            "zh": "我的笔记本不能给看",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "310/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱり、あたしのは\n見せられないわ。",
            "zh": "……果然，我的那本\n还是不能给你看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "312/TALK",
            "narrator": "神楽",
            "text": "えぇーっ…。",
            "zh": "诶——……",
            "narrator_zh": "神乐"
        },
        {
            "location": "313/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな残念そうに\nするほどのこと？",
            "zh": "用得着表现得\n这么遗憾吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "314/TALK",
            "narrator": "神楽",
            "text": "だって、もしかしたら\n参考になるかも、と\n思ってたのに…。",
            "zh": "因为，我还想着说不定\n能拿来当参考呢\n……",
            "narrator_zh": "神乐"
        },
        {
            "location": "316/TALK",
            "narrator": "ガブリエラ",
            "text": "参考って…もしかして、\nネタ詰まり？",
            "zh": "当参考……难道说，\n你卡文没灵感了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "317/TALK",
            "narrator": "神楽",
            "text": "し、仕方ないじゃない\nですか！",
            "zh": "这、这也是没办法的\n事嘛！",
            "narrator_zh": "神乐"
        },
        {
            "location": "318/TALK",
            "narrator": "神楽",
            "text": "いろんな乙女の心の\n引き出しを拝見したい\n気分なんです…。",
            "zh": "我现在就是很想\n拜见一下各种少女的\n内心小抽屉嘛……",
            "narrator_zh": "神乐"
        },
        {
            "location": "319/TALK",
            "narrator": "ガブリエラ",
            "text": "なるほど、それであたしの\nノートを見たがってた、\nってわけね。",
            "zh": "原来如此，怪不得你\n刚才一直想看我的\n笔记本呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "320/TALK",
            "narrator": "神楽",
            "text": "はい…という事情が\nあるわけなので。",
            "zh": "是的……出于这样那样的\n隐情呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "321/TALK",
            "narrator": "神楽",
            "text": "見せてくれますか？",
            "zh": "能给我看看吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "322/TALK",
            "narrator": "ガブリエラ",
            "text": "見せないってば。",
            "zh": "都说了不给看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "神楽",
            "text": "そんなぁ…。",
            "zh": "怎么这样……",
            "narrator_zh": "神乐"
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
