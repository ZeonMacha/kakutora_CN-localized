 "entry": [
  {
   "location": "525/SCENARIO",
   "narrator": "",
   "text": "新案・ご近所ミステリ"
  },
  {
   "location": "534/TALK",
   "narrator": "みやび",
   "text": "一見普段通りの\n夕方ぞね。"
  },
  {
   "location": "535/TALK",
   "narrator": "みやび",
   "text": "さて、と。"
  },
  {
   "location": "547/TALK",
   "narrator": "みやび",
   "text": "そろそろアーヤがここを通りかかるのだ",
   "zh": "差不多绫水该路过这里了",
   "narrator_zh": "雅"
  },
  {
   "location": "548/TALK",
   "narrator": "みやび",
   "text": "その前にはっきりさせねばならぬことがある",
   "zh": "在那之前有必须弄清的事",
   "narrator_zh": "雅"
  },
  {
   "location": "549/TALK",
   "narrator": "みやび",
   "text": "当然協力してもらう"
  },
  {
   "location": "551/SEL",
   "narrator": "",
   "text": "条件によるね",
   "zh": "看条件吧",
   "narrator_zh": ""
  },
  {
   "location": "552/SEL",
   "narrator": "",
   "text": "いや、こっちにも都合がある",
   "zh": "不行，我这边也有安排",
   "narrator_zh": ""
  },
  {
   "location": "553/ACT",
   "narrator": "",
   "text": "条件によるね",
   "zh": "看条件吧",
   "narrator_zh": ""
  },
  {
   "location": "554/TALK",
   "narrator": "みやび",
   "text": "絶対に協力せざるを得ない条件である"
  },
  {
   "location": "555/ACT",
   "narrator": "",
   "text": "いや、こっちにも都合がある",
   "zh": "不行，我这边也有安排",
   "narrator_zh": ""
  },
  {
   "location": "556/TALK",
   "narrator": "みやび",
   "text": "その都合が都合なのだ",
   "zh": "那份方便真是方便",
   "narrator_zh": "雅"
  },
  {
   "location": "557/TALK",
   "narrator": "みやび",
   "text": "こちらの",
   "zh": "这边的",
   "narrator_zh": "雅"
  },
  {
   "location": "559/TALK",
   "narrator": "みやび",
   "text": "アーヤに姉がいるのを"
  },
  {
   "location": "560/TALK",
   "narrator": "みやび",
   "text": "知っちょろう"
  },
  {
   "location": "562/SEL",
   "narrator": "",
   "text": "そうらしいけど"
  },
  {
   "location": "563/SEL",
   "narrator": "",
   "text": "詳しくは知らない",
   "zh": "我不太清楚细节",
   "narrator_zh": ""
  },
  {
   "location": "564/SEL",
   "narrator": "",
   "text": "初耳だ",
   "zh": "第一次听说",
   "narrator_zh": ""
  },
  {
   "location": "565/ACT",
   "narrator": "",
   "text": "そうらしいけど"
  },
  {
   "location": "566/TALK",
   "narrator": "みやび",
   "text": "いるのだ"
  },
  {
   "location": "567/ACT",
   "narrator": "",
   "text": "詳しくは知らない",
   "zh": "我不太清楚细节",
   "narrator_zh": ""
  },
  {
   "location": "568/TALK",
   "narrator": "みやび",
   "text": "今はそれでいい"
  },
  {
   "location": "569/ACT",
   "narrator": "",
   "text": "初耳だ",
   "zh": "第一次听说",
   "narrator_zh": ""
  },
  {
   "location": "570/TALK",
   "narrator": "みやび",
   "text": "これで知ることになったな",
   "zh": "这下算是知道了",
   "narrator_zh": "雅"
  },
  {
   "location": "572/TALK",
   "narrator": "みやび",
   "text": "そんなわけで",
   "zh": "所以啊",
   "narrator_zh": "雅"
  },
  {
   "location": "573/TALK",
   "narrator": "みやび",
   "text": "アーヤの姉について調べるのが貴殿の任務"
  },
  {
   "location": "574/TALK",
   "narrator": "みやび",
   "text": "ただし、アーヤには聞くなよ",
   "zh": "不过，别问绫水哦",
   "narrator_zh": "雅"
  },
  {
   "location": "575/TALK",
   "narrator": "みやび",
   "text": "朗報を期待する"
  },
  {
   "location": "588/TALK",
   "narrator": "みやび",
   "text": "ふう……。",
   "zh": "唉……。",
   "narrator_zh": "雅"
  },
  {
   "location": "591/TALK",
   "narrator": "アーヤ",
   "text": "みやび？",
   "zh": "雅？",
   "narrator_zh": "绫水"
  },
  {
   "location": "594/TALK",
   "narrator": "みやび",
   "text": "お。\nちょうどいいところに。",
   "zh": "哦。\n来得正好嘛。",
   "narrator_zh": "雅"
  },
  {
   "location": "595/TALK",
   "narrator": "アーヤ",
   "text": "ん？\nどうしたの？"
  },
  {
   "location": "596/TALK",
   "narrator": "みやび",
   "text": "今ちょっとした\n仕掛けをした\nところぞね。"
  },
  {
   "location": "597/TALK",
   "narrator": "アーヤ",
   "text": "仕掛けって？"
  },
  {
   "location": "598/TALK",
   "narrator": "みやび",
   "text": "Ｂｏｔの意図を\n探るための\n仕掛けぞね。"
  },
  {
   "location": "600/TALK",
   "narrator": "アーヤ",
   "text": "……。"
  },
  {
   "location": "602/TALK",
   "narrator": "みやび",
   "text": "うちにはやっぱり\n何の理由もないとは\n思えん。"
  },
  {
   "location": "604/TALK",
   "narrator": "みやび",
   "text": "トライナリーと\n接触しちゅうことには\n裏がある。"
  },
  {
   "location": "605/TALK",
   "narrator": "アーヤ",
   "text": "……ねえ\nみやび、あのね。"
  },
  {
   "location": "606/TALK",
   "narrator": "アーヤ",
   "text": "たまたまが\n重なっただけかも\nしれないでしょ。",
   "zh": "也许只是碰巧\n重合在一起\n而已吧。",
   "narrator_zh": "绫水"
  },
  {
   "location": "608/TALK",
   "narrator": "みやび",
   "text": "偶然？"
  },
  {
   "location": "609/TALK",
   "narrator": "アーヤ",
   "text": "そう。",
   "zh": "是的。",
   "narrator_zh": "绫水"
  },
  {
   "location": "610/TALK",
   "narrator": "みやび",
   "text": "……そんなことは\nないと思うぞね。"
  },
  {
   "location": "622/TALK",
   "narrator": "みやび",
   "text": "アーヤが出た"
  },
  {
   "location": "623/TALK",
   "narrator": "みやび",
   "text": "先ほどの件の進捗はいかに"
  },
  {
   "location": "626/SEL",
   "narrator": "",
   "text": "調べないよ",
   "zh": "我不查",
   "narrator_zh": ""
  },
  {
   "location": "629/ACT",
   "narrator": "",
   "text": "調べないよ",
   "zh": "我不查",
   "narrator_zh": ""
  },
  {
   "location": "630/TALK",
   "narrator": "みやび",
   "text": "なんでだ",
   "zh": "为什么",
   "narrator_zh": "雅"
  },
  {
   "location": "632/TALK",
   "narrator": "みやび",
   "text": "なぜ調査を進めぬ",
   "zh": "为什么不去调查",
   "narrator_zh": "雅"
  },
  {
   "location": "633/SEL",
   "narrator": "",
   "text": "みやびが本人に聞く方が早いし",
   "zh": "还是直接问雅本人比较快",
   "narrator_zh": ""
  },
  {
   "location": "634/SEL",
   "narrator": "",
   "text": "こそこそ調べるのはいい趣味じゃないし",
   "zh": "偷偷摸摸地查可不是什么好爱好",
   "narrator_zh": ""
  },
  {
   "location": "635/ACT",
   "narrator": "",
   "text": "みやびが本人に聞く方が早いし",
   "zh": "还是直接问雅本人比较快",
   "narrator_zh": ""
  },
  {
   "location": "636/TALK",
   "narrator": "みやび",
   "text": "それでは",
   "zh": "那么",
   "narrator_zh": "雅"
  },
  {
   "location": "637/TALK",
   "narrator": "みやび",
   "text": "情報に不備が出るのだ"
  },
  {
   "location": "638/ACT",
   "narrator": "",
   "text": "こそこそ調べるのはいい趣味じゃないし",
   "zh": "偷偷摸摸地查可不是什么好爱好",
   "narrator_zh": ""
  },
  {
   "location": "639/TALK",
   "narrator": "みやび",
   "text": "なんと",
   "zh": "岂料",
   "narrator_zh": "雅"
  },
  {
   "location": "641/TALK",
   "narrator": "みやび",
   "text": "常識的な発言"
  },
  {
   "location": "643/TALK",
   "narrator": "みやび",
   "text": "いいから",
   "zh": "行了",
   "narrator_zh": "雅"
  },
  {
   "location": "644/TALK",
   "narrator": "みやび",
   "text": "情報を渡すちや"
  },
  {
   "location": "646/SEL",
   "narrator": "",
   "text": "何も持ってないよ",
   "zh": "我什么都没带哦",
   "narrator_zh": ""
  },
  {
   "location": "647/SEL",
   "narrator": "",
   "text": "みやびの方が知ってるって",
   "zh": "雅比我更清楚",
   "narrator_zh": ""
  },
  {
   "location": "648/ACT",
   "narrator": "",
   "text": "何も持ってないよ",
   "zh": "我什么都没带哦",
   "narrator_zh": ""
  },
  {
   "location": "649/TALK",
   "narrator": "みやび",
   "text": "そんなわけなかろ",
   "zh": "不会有那种事吧",
   "narrator_zh": "雅"
  },
  {
   "location": "650/ACT",
   "narrator": "",
   "text": "みやびの方が知ってるって",
   "zh": "雅比我更清楚",
   "narrator_zh": ""
  },
  {
   "location": "651/TALK",
   "narrator": "みやび",
   "text": "またまた",
   "zh": "又来了",
   "narrator_zh": "雅"
  },
  {
   "location": "664/TALK",
   "narrator": "みやび",
   "text": "あいかわらず\n見事なとぼけぶり。"
  },
  {
   "location": "665/TALK",
   "narrator": "みやび",
   "text": "油断ならん。"
  },
  {
   "location": "667/TALK",
   "narrator": "アーヤ",
   "text": "…そういうの\nみやびらしく\nないような。"
  },
  {
   "location": "669/TALK",
   "narrator": "みやび",
   "text": "うちらしくない？\nどういうことぞね。"
  },
  {
   "location": "670/TALK",
   "narrator": "アーヤ",
   "text": "なんだか\n思い込みだけで\n動いてるみたい。",
   "zh": "总觉得\n只凭臆想在\n行动。",
   "narrator_zh": "绫水"
  },
  {
   "location": "671/TALK",
   "narrator": "アーヤ",
   "text": "人間なら\nスパイに違いないって\n決めつけてる感じ。"
  },
  {
   "location": "672/TALK",
   "narrator": "みやび",
   "text": "そういうアーヤは\nＢｏｔが人間だと\n納得しとらんろう。",
   "zh": "这样的绫水，\n大概还不肯接受\nBot是人类咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "673/TALK",
   "narrator": "みやび",
   "text": "そういう意味では\nアーヤも思い込み\nだけと言えるぞね。",
   "zh": "那个意义上，\n绫水也可以说是\n全凭臆想咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "676/TALK",
   "narrator": "アーヤ",
   "text": "…そうかも\nしれないわね……。"
  },
  {
   "location": "688/TALK",
   "narrator": "みやび",
   "text": "$handle$よ",
   "zh": "$handle$啊",
   "narrator_zh": "雅"
  },
  {
   "location": "690/SEL",
   "narrator": "",
   "text": "まだ何か？",
   "zh": "还有事？",
   "narrator_zh": ""
  },
  {
   "location": "691/SEL",
   "narrator": "",
   "text": "調べないったら",
   "zh": "我都说不查了",
   "narrator_zh": ""
  },
  {
   "location": "692/ACT",
   "narrator": "",
   "text": "まだ何か？",
   "zh": "还有事？",
   "narrator_zh": ""
  },
  {
   "location": "694/TALK",
   "narrator": "みやび",
   "text": "いや何も"
  },
  {
   "location": "695/ACT",
   "narrator": "",
   "text": "調べないったら",
   "zh": "我都说不查了",
   "narrator_zh": ""
  },
  {
   "location": "697/TALK",
   "narrator": "みやび",
   "text": "調べないんだな"
  },
  {
   "location": "709/TALK",
   "narrator": "みやび",
   "text": "……。"
  },
  {
   "location": "710/TALK",
   "narrator": "みやび",
   "text": "先入観だけで\n判断するのは\nうちらしゅうない。"
  },
  {
   "location": "711/TALK",
   "narrator": "みやび",
   "text": "仮説は必要や。"
  },
  {
   "location": "713/TALK",
   "narrator": "みやび",
   "text": "けんど、仮説は\nあくまで仮説\nでしかない。",
   "zh": "不过，假设终究\n只是假设\n而已。",
   "narrator_zh": "雅"
  },
  {
   "location": "714/TALK",
   "narrator": "みやび",
   "text": "と、いうことやね……。",
   "zh": "或、也就是说……。",
   "narrator_zh": "雅"
  }
 ]
