{
    "dir": "dramatics/daydra/drm_ch04_00_170.js",
    "type": "Episode",
    "info": {
        "story_id": "4017",
        "cid": "miyabi",
        "title": "らぶとーく 第17話",
        "sub_title": "新案・ご近所ミステリ",
        "title_zh": "恋爱漫谈 第17话",
        "sub_title_zh": "新案·邻里谜案"
    },
    "entry": [
        {
            "location": "525/SCENARIO",
            "narrator": "",
            "text": "新案・ご近所ミステリ",
            "zh": "新案·邻里谜案",
            "narrator_zh": ""
        },
        {
            "location": "534/TALK",
            "narrator": "みやび",
            "text": "一見普段通りの\n夕方ぞね。",
            "zh": "乍一看和平时\n一样的傍晚咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "535/TALK",
            "narrator": "みやび",
            "text": "さて、と。",
            "zh": "好了——",
            "narrator_zh": "雅"
        },
        {
            "location": "547/TALK",
            "narrator": "みやび",
            "text": "そろそろアーヤがここを通りかかるのだ",
            "zh": "差不多绫水该路过这里了",
            "narrator_zh": "雅"
        },
        {
            "location": "548/TALK",
            "narrator": "みやび",
            "text": "その前にはっきりさせねばならぬことがある",
            "zh": "在那之前有必须弄清的事",
            "narrator_zh": "雅"
        },
        {
            "location": "549/TALK",
            "narrator": "みやび",
            "text": "当然協力してもらう",
            "zh": "当然要你协助",
            "narrator_zh": "雅"
        },
        {
            "location": "551/SEL",
            "narrator": "",
            "text": "条件によるね",
            "zh": "看条件吧",
            "narrator_zh": ""
        },
        {
            "location": "552/SEL",
            "narrator": "",
            "text": "いや、こっちにも都合がある",
            "zh": "不行，我这边也有安排",
            "narrator_zh": ""
        },
        {
            "location": "553/ACT",
            "narrator": "",
            "text": "条件によるね",
            "zh": "看条件吧",
            "narrator_zh": ""
        },
        {
            "location": "554/TALK",
            "narrator": "みやび",
            "text": "絶対に協力せざるを得ない条件である",
            "zh": "这可是让你不得不协助的条件",
            "narrator_zh": "雅"
        },
        {
            "location": "555/ACT",
            "narrator": "",
            "text": "いや、こっちにも都合がある",
            "zh": "不行，我这边也有安排",
            "narrator_zh": ""
        },
        {
            "location": "556/TALK",
            "narrator": "みやび",
            "text": "その都合が都合なのだ",
            "zh": "那份方便真是方便",
            "narrator_zh": "雅"
        },
        {
            "location": "557/TALK",
            "narrator": "みやび",
            "text": "こちらの",
            "zh": "这边的",
            "narrator_zh": "雅"
        },
        {
            "location": "559/TALK",
            "narrator": "みやび",
            "text": "アーヤに姉がいるのを",
            "zh": "绫水有个姐姐这件事",
            "narrator_zh": "雅"
        },
        {
            "location": "560/TALK",
            "narrator": "みやび",
            "text": "知っちょろう",
            "zh": "你知道的吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "562/SEL",
            "narrator": "",
            "text": "そうらしいけど",
            "zh": "听说好像是这样",
            "narrator_zh": ""
        },
        {
            "location": "563/SEL",
            "narrator": "",
            "text": "詳しくは知らない",
            "zh": "我不太清楚细节",
            "narrator_zh": ""
        },
        {
            "location": "564/SEL",
            "narrator": "",
            "text": "初耳だ",
            "zh": "第一次听说",
            "narrator_zh": ""
        },
        {
            "location": "565/ACT",
            "narrator": "",
            "text": "そうらしいけど",
            "zh": "听说好像是这样",
            "narrator_zh": ""
        },
        {
            "location": "566/TALK",
            "narrator": "みやび",
            "text": "いるのだ",
            "zh": "是有的哦",
            "narrator_zh": "雅"
        },
        {
            "location": "567/ACT",
            "narrator": "",
            "text": "詳しくは知らない",
            "zh": "我不太清楚细节",
            "narrator_zh": ""
        },
        {
            "location": "568/TALK",
            "narrator": "みやび",
            "text": "今はそれでいい",
            "zh": "现在这样就好",
            "narrator_zh": "雅"
        },
        {
            "location": "569/ACT",
            "narrator": "",
            "text": "初耳だ",
            "zh": "第一次听说",
            "narrator_zh": ""
        },
        {
            "location": "570/TALK",
            "narrator": "みやび",
            "text": "これで知ることになったな",
            "zh": "这下算是知道了",
            "narrator_zh": "雅"
        },
        {
            "location": "572/TALK",
            "narrator": "みやび",
            "text": "そんなわけで",
            "zh": "所以啊",
            "narrator_zh": "雅"
        },
        {
            "location": "573/TALK",
            "narrator": "みやび",
            "text": "アーヤの姉について調べるのが貴殿の任務",
            "zh": "调查绫水姐姐的事，就是阁下的任务",
            "narrator_zh": "雅"
        },
        {
            "location": "574/TALK",
            "narrator": "みやび",
            "text": "ただし、アーヤには聞くなよ",
            "zh": "不过，别问绫水哦",
            "narrator_zh": "雅"
        },
        {
            "location": "575/TALK",
            "narrator": "みやび",
            "text": "朗報を期待する",
            "zh": "期待你的好消息",
            "narrator_zh": "雅"
        },
        {
            "location": "588/TALK",
            "narrator": "みやび",
            "text": "ふう……。",
            "zh": "唉……。",
            "narrator_zh": "雅"
        },
        {
            "location": "591/TALK",
            "narrator": "アーヤ",
            "text": "みやび？",
            "zh": "雅？",
            "narrator_zh": "绫水"
        },
        {
            "location": "594/TALK",
            "narrator": "みやび",
            "text": "お。\nちょうどいいところに。",
            "zh": "哦。\n来得正好嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "595/TALK",
            "narrator": "アーヤ",
            "text": "ん？\nどうしたの？",
            "zh": "嗯？\n怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "596/TALK",
            "narrator": "みやび",
            "text": "今ちょっとした\n仕掛けをした\nところぞね。",
            "zh": "我刚布置好一个\n小小的\n机关咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "597/TALK",
            "narrator": "アーヤ",
            "text": "仕掛けって？",
            "zh": "什么机关？",
            "narrator_zh": "绫水"
        },
        {
            "location": "598/TALK",
            "narrator": "みやび",
            "text": "Ｂｏｔの意図を\n探るための\n仕掛けぞね。",
            "zh": "用来探查\nBot意图的\n机关咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "600/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "602/TALK",
            "narrator": "みやび",
            "text": "うちにはやっぱり\n何の理由もないとは\n思えん。",
            "zh": "果然，我还是\n没法相信这一切\n毫无理由。",
            "narrator_zh": "雅"
        },
        {
            "location": "604/TALK",
            "narrator": "みやび",
            "text": "トライナリーと\n接触しちゅうことには\n裏がある。",
            "zh": "他跟三重奏\n一直接触，\n背后必有隐情。",
            "narrator_zh": "雅"
        },
        {
            "location": "605/TALK",
            "narrator": "アーヤ",
            "text": "……ねえ\nみやび、あのね。",
            "zh": "……我说\n雅啊，那个呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "606/TALK",
            "narrator": "アーヤ",
            "text": "たまたまが\n重なっただけかも\nしれないでしょ。",
            "zh": "也许只是碰巧\n重合在一起\n而已吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "608/TALK",
            "narrator": "みやび",
            "text": "偶然？",
            "zh": "巧合？",
            "narrator_zh": "雅"
        },
        {
            "location": "609/TALK",
            "narrator": "アーヤ",
            "text": "そう。",
            "zh": "是的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "610/TALK",
            "narrator": "みやび",
            "text": "……そんなことは\nないと思うぞね。",
            "zh": "……我不觉得\n是巧合咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "622/TALK",
            "narrator": "みやび",
            "text": "アーヤが出た",
            "zh": "绫水走了",
            "narrator_zh": "雅"
        },
        {
            "location": "623/TALK",
            "narrator": "みやび",
            "text": "先ほどの件の進捗はいかに",
            "zh": "先前那件事进展如何了？",
            "narrator_zh": "雅"
        },
        {
            "location": "626/SEL",
            "narrator": "",
            "text": "調べないよ",
            "zh": "我不查",
            "narrator_zh": ""
        },
        {
            "location": "629/ACT",
            "narrator": "",
            "text": "調べないよ",
            "zh": "我不查",
            "narrator_zh": ""
        },
        {
            "location": "630/TALK",
            "narrator": "みやび",
            "text": "なんでだ",
            "zh": "为什么",
            "narrator_zh": "雅"
        },
        {
            "location": "632/TALK",
            "narrator": "みやび",
            "text": "なぜ調査を進めぬ",
            "zh": "为什么不去调查",
            "narrator_zh": "雅"
        },
        {
            "location": "633/SEL",
            "narrator": "",
            "text": "みやびが本人に聞く方が早いし",
            "zh": "还是直接问雅本人比较快",
            "narrator_zh": ""
        },
        {
            "location": "634/SEL",
            "narrator": "",
            "text": "こそこそ調べるのはいい趣味じゃないし",
            "zh": "偷偷摸摸地查可不是什么好爱好",
            "narrator_zh": ""
        },
        {
            "location": "635/ACT",
            "narrator": "",
            "text": "みやびが本人に聞く方が早いし",
            "zh": "还是直接问雅本人比较快",
            "narrator_zh": ""
        },
        {
            "location": "636/TALK",
            "narrator": "みやび",
            "text": "それでは",
            "zh": "那么",
            "narrator_zh": "雅"
        },
        {
            "location": "637/TALK",
            "narrator": "みやび",
            "text": "情報に不備が出るのだ",
            "zh": "情报就会有缺漏",
            "narrator_zh": "雅"
        },
        {
            "location": "638/ACT",
            "narrator": "",
            "text": "こそこそ調べるのはいい趣味じゃないし",
            "zh": "偷偷摸摸地查可不是什么好爱好",
            "narrator_zh": ""
        },
        {
            "location": "639/TALK",
            "narrator": "みやび",
            "text": "なんと",
            "zh": "岂料",
            "narrator_zh": "雅"
        },
        {
            "location": "641/TALK",
            "narrator": "みやび",
            "text": "常識的な発言",
            "zh": "常识性的发言",
            "narrator_zh": "雅"
        },
        {
            "location": "643/TALK",
            "narrator": "みやび",
            "text": "いいから",
            "zh": "行了",
            "narrator_zh": "雅"
        },
        {
            "location": "644/TALK",
            "narrator": "みやび",
            "text": "情報を渡すちや",
            "zh": "这就把情报交给你滴",
            "narrator_zh": "雅"
        },
        {
            "location": "646/SEL",
            "narrator": "",
            "text": "何も持ってないよ",
            "zh": "我什么都没带哦",
            "narrator_zh": ""
        },
        {
            "location": "647/SEL",
            "narrator": "",
            "text": "みやびの方が知ってるって",
            "zh": "雅比我更清楚",
            "narrator_zh": ""
        },
        {
            "location": "648/ACT",
            "narrator": "",
            "text": "何も持ってないよ",
            "zh": "我什么都没带哦",
            "narrator_zh": ""
        },
        {
            "location": "649/TALK",
            "narrator": "みやび",
            "text": "そんなわけなかろ",
            "zh": "哪有那种事咯",
            "narrator_zh": "雅"
        },
        {
            "location": "650/ACT",
            "narrator": "",
            "text": "みやびの方が知ってるって",
            "zh": "雅比我更清楚",
            "narrator_zh": ""
        },
        {
            "location": "651/TALK",
            "narrator": "みやび",
            "text": "またまた",
            "zh": "又来了",
            "narrator_zh": "雅"
        },
        {
            "location": "664/TALK",
            "narrator": "みやび",
            "text": "あいかわらず\n見事なとぼけぶり。",
            "zh": "还是一如既往\n装傻装得漂亮。",
            "narrator_zh": "雅"
        },
        {
            "location": "665/TALK",
            "narrator": "みやび",
            "text": "油断ならん。",
            "zh": "不能大意。",
            "narrator_zh": "雅"
        },
        {
            "location": "667/TALK",
            "narrator": "アーヤ",
            "text": "…そういうの\nみやびらしく\nないような。",
            "zh": "……这样子\n不太像\n雅的作风。",
            "narrator_zh": "绫水"
        },
        {
            "location": "669/TALK",
            "narrator": "みやび",
            "text": "うちらしくない？\nどういうことぞね。",
            "zh": "不像我的作风？\n这话怎么说咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "670/TALK",
            "narrator": "アーヤ",
            "text": "なんだか\n思い込みだけで\n動いてるみたい。",
            "zh": "总觉得\n只凭臆想在\n行动。",
            "narrator_zh": "绫水"
        },
        {
            "location": "671/TALK",
            "narrator": "アーヤ",
            "text": "人間なら\nスパイに違いないって\n決めつけてる感じ。",
            "zh": "感觉你就是\n一口咬定是人类\n就一定是间谍。",
            "narrator_zh": "绫水"
        },
        {
            "location": "672/TALK",
            "narrator": "みやび",
            "text": "そういうアーヤは\nＢｏｔが人間だと\n納得しとらんろう。",
            "zh": "这样的绫水，\n大概还不肯接受\nBot是人类咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "673/TALK",
            "narrator": "みやび",
            "text": "そういう意味では\nアーヤも思い込み\nだけと言えるぞね。",
            "zh": "那个意义上，\n绫水也可以说是\n全凭臆想咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "676/TALK",
            "narrator": "アーヤ",
            "text": "…そうかも\nしれないわね……。",
            "zh": "……或许\n是这样吧……",
            "narrator_zh": "绫水"
        },
        {
            "location": "688/TALK",
            "narrator": "みやび",
            "text": "$handle$よ",
            "zh": "$handle$啊",
            "narrator_zh": "雅"
        },
        {
            "location": "690/SEL",
            "narrator": "",
            "text": "まだ何か？",
            "zh": "还有事？",
            "narrator_zh": ""
        },
        {
            "location": "691/SEL",
            "narrator": "",
            "text": "調べないったら",
            "zh": "我都说不查了",
            "narrator_zh": ""
        },
        {
            "location": "692/ACT",
            "narrator": "",
            "text": "まだ何か？",
            "zh": "还有事？",
            "narrator_zh": ""
        },
        {
            "location": "694/TALK",
            "narrator": "みやび",
            "text": "いや何も",
            "zh": "不，没什么",
            "narrator_zh": "雅"
        },
        {
            "location": "695/ACT",
            "narrator": "",
            "text": "調べないったら",
            "zh": "我都说不查了",
            "narrator_zh": ""
        },
        {
            "location": "697/TALK",
            "narrator": "みやび",
            "text": "調べないんだな",
            "zh": "真的不查啊",
            "narrator_zh": "雅"
        },
        {
            "location": "709/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "710/TALK",
            "narrator": "みやび",
            "text": "先入観だけで\n判断するのは\nうちらしゅうない。",
            "zh": "光凭先入之见\n就下判断，\n不是我们的作风。",
            "narrator_zh": "雅"
        },
        {
            "location": "711/TALK",
            "narrator": "みやび",
            "text": "仮説は必要や。",
            "zh": "假设是必要的。",
            "narrator_zh": "雅"
        },
        {
            "location": "713/TALK",
            "narrator": "みやび",
            "text": "けんど、仮説は\nあくまで仮説\nでしかない。",
            "zh": "但是，假设终究\n只是假设\n而已。",
            "narrator_zh": "雅"
        },
        {
            "location": "714/TALK",
            "narrator": "みやび",
            "text": "と、いうことやね……。",
            "zh": "——也就是这么回事咯……。",
            "narrator_zh": "雅"
        }
    ]
}
