{
    "dir": "chap12/daydra/dd_ch03_12_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "12352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "お好み焼きについて",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "关于御好烧"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "お好み焼きについて",
            "zh": "关于御好烧",
            "narrator_zh": ""
        },
        {
            "location": "21/TALK",
            "narrator": "つばめ",
            "text": "お好み焼き屋さん？\n学校の近くにあるなんて\n知らなかったよ。",
            "zh": "御好烧店？\n我都不知道学校附近还有\n这种店呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "23/TALK",
            "narrator": "ガブリエラ",
            "text": "…何だか、面白そうな\n話をしてるわね。",
            "zh": "……总觉得，你们在聊\n挺有意思的话题呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、この辺りに\nお好み焼き屋なんて\nあったかしら？",
            "zh": "不过，这附近\n有御好烧店\n吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "雛",
            "text": "一本路地に入らなくちゃ\nいけない店なんだ。\n穴場スポットってやつ。",
            "zh": "那家店得拐进一条\n小巷才找得到。\n算是个冷门好去处吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "27/TALK",
            "narrator": "雛",
            "text": "お店は小さいんだけど、\n凄く美味しいんだよ！",
            "zh": "店面虽然不大，\n但味道超级棒哦！",
            "narrator_zh": "雏"
        },
        {
            "location": "28/TALK",
            "narrator": "繭",
            "text": "広島風がオススメ。\n一度は食べるべき。",
            "zh": "推荐广岛风。\n至少得吃一次。",
            "narrator_zh": "茧"
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "あれは量が多いから\n苦手なのよねぇ…。",
            "zh": "那个分量太多了，\n我不太行呢……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "雛",
            "text": "ただ、自分で焼かなくちゃ\nいけないのがネックなん\nだよねぇ…。",
            "zh": "不过，得自己动手\n煎这一点有点\n劝退就是了……",
            "narrator_zh": "雏"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、そういう店なのね。\nうん、興味失せたわ。",
            "zh": "啊，是那种店啊。\n嗯，我没兴趣了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃんの気持ち、\nよくわかるよ。",
            "zh": "雏的心情，\n我很理解哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "自分で焼くと、どうしても\nひっくり返すのが綺麗に\nできないんだよね。",
            "zh": "自己煎的话，不管怎样\n都没法漂漂亮亮地\n翻面呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "40/TALK",
            "narrator": "繭",
            "text": "私の場合、鉄板の上が\nいつも惨状になるわ。",
            "zh": "换作我的话，铁板上\n每次都会变成惨剧。",
            "narrator_zh": "茧"
        },
        {
            "location": "41/TALK",
            "narrator": "雛",
            "text": "広島風まで自分達で\n焼かせる鬼畜仕様の\nお店だからねぇ。",
            "zh": "毕竟是连广岛风都要客人\n自己动手的魔鬼设定\n店铺嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "42/TALK",
            "narrator": "繭",
            "text": "あれが得意な人なんて、\n店員さん以外は滅多に\nいないと思う。",
            "zh": "能把那个煎好的人，\n除了店员以外应该\n很少见吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "う～ん…",
            "zh": "唔～嗯……",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "あっ、そうだ！",
            "zh": "啊，对了！",
            "narrator_zh": "燕"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんって、\nたこ焼きを焼くの\n得意だったよね？",
            "zh": "加布，你不是\n很擅长煎章鱼烧\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？　ええ、まあ…。",
            "zh": "哎！？　嗯、嗯算是吧……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、もしかしたら\nお好み焼きも上手に\n焼けるんじゃない？",
            "zh": "那说不定\n御好烧也能煎得\n很好哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "60/TALK",
            "narrator": "雛",
            "text": "おっ、意外な特技発覚！\nていうか、さすがは\nガブリエラちゃん！",
            "zh": "哦，发现意外的特长！\n话说回来，不愧是\n加布里埃拉！",
            "narrator_zh": "雏"
        },
        {
            "location": "62/TALK",
            "narrator": "繭",
            "text": "もし得意だとしたら、\nリスペクトに値するわ。",
            "zh": "要是真擅长的话，\n那可值得敬佩。",
            "narrator_zh": "茧"
        },
        {
            "location": "63/SEL",
            "narrator": "",
            "text": "期待に応えよう！",
            "zh": "回应大家的期待吧！",
            "narrator_zh": ""
        },
        {
            "location": "64/SEL",
            "narrator": "",
            "text": "知らないフリをしよう",
            "zh": "装作不知道吧",
            "narrator_zh": ""
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "ど、どうしよう…\n何だか凄く期待されてる\nみたい。",
            "zh": "怎、怎么办……\n总觉得大家好像对我有\n很大的期待。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "ガブリエラ",
            "text": "お好み焼きを\nひっくり返すの、\n私も苦手なのに…。",
            "zh": "御好烧\n翻面什么的，\n其实我也不擅长啊……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "69/TALK",
            "narrator": "つばめ",
            "text": "…ガブちゃん？",
            "zh": "……加布？",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "…わ、悪いけど、\nお好み焼きは遠慮するわ。",
            "zh": "……抱、抱歉，\n御好烧就算了吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、たこ焼きの方が\n好きだから…。",
            "zh": "我还是更喜欢\n章鱼烧嘛……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "雛",
            "text": "えーっ！？\nすっごく美味しい\nお店なんだよ！？",
            "zh": "哎——！？\n那家店真的\n超级好吃的说！？",
            "narrator_zh": "雏"
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "行こうよ、ガブちゃん！",
            "zh": "一起去嘛，加布！",
            "narrator_zh": "燕"
        },
        {
            "location": "81/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしはいいの！",
            "zh": "我就不用了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "でもたこ焼き屋に行く\n時には誘ってちょうだい。",
            "zh": "不过去吃章鱼烧店的时候\n记得叫上我哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "85/TALK",
            "narrator": "雛",
            "text": "はぁ…残念…。",
            "zh": "唉……真遗憾……",
            "narrator_zh": "雏"
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "自分でひっくり返さなくて\nいいお店なら、あたしも\n行きたかったな…。",
            "zh": "要是不用自己翻面的\n店，我本来也\n挺想去的呢……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/ACT",
            "narrator": "",
            "text": "期待に応えよう！",
            "zh": "回应大家的期待吧！",
            "narrator_zh": ""
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "期待を裏切って、空気を悪くできないわね",
            "zh": "总不能辜负大家的期待，把气氛搞僵呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "ガブリエラ",
            "text": "わかったわ、私、頑張ってみる！",
            "zh": "我知道了，我试试看！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、出来るわ。",
            "zh": "嗯，我能行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "ガブリエラ",
            "text": "大丈夫、これはウソじゃ\nないわ。",
            "zh": "没关系，这可不是\n撒谎哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "緊張はするし、ちょっと\n歪みはするけど、ちゃんと\nひっくり返せはするもの。",
            "zh": "虽然会紧张，稍微有点\n歪斜，但好歹还是能\n好好翻过来的嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "つばめ",
            "text": "やっぱり！\nさすがはガブちゃん！",
            "zh": "果然！\n不愧是加布！",
            "narrator_zh": "燕"
        },
        {
            "location": "128/TALK",
            "narrator": "雛",
            "text": "日本人のあたし達より\n凄い、ってところ、\n尊敬するよ。",
            "zh": "比我们这些日本人还\n厉害这一点，\n真让人佩服哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、まあ、日本好きとして\n最低限の嗜みよ。",
            "zh": "嘛、嘛，作为日本爱好者，\n这只是最起码的修养啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "繭",
            "text": "ガブリエラさんと\n呼んだ方が良い？",
            "zh": "是不是叫你\n加布里埃拉大师比较好？",
            "narrator_zh": "茧"
        },
        {
            "location": "135/TALK",
            "narrator": "ガブリエラ",
            "text": "大袈裟だってば。\nまったく、これくらいの\nことで…。",
            "zh": "太夸张了啦。\n真是的，就这点\n小事……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、本当に\n褒め過ぎで不安を感じる\nレベルなんだけど…。",
            "zh": "话说回来，你们真的\n夸得太过了，都快到\n让我感到不安的程度了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "138/TALK",
            "narrator": "雛",
            "text": "じゃあ、近いうちに\nみんなでお好み焼きを\n食べに行こ！",
            "zh": "那过几天，\n大家一起去吃\n御好烧吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "140/TALK",
            "narrator": "雛",
            "text": "ひっくり返し役は\nガブリエラちゃんに\nお願いする、ってことで！",
            "zh": "翻面担当就决定\n拜托加布里埃拉\n啦！",
            "narrator_zh": "雏"
        },
        {
            "location": "142/TALK",
            "narrator": "つばめ",
            "text": "賛成ー！\nガブちゃん頑張ってね！",
            "zh": "赞成——！\n加布加油哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "145/TALK",
            "narrator": "繭",
            "text": "広島風を上手く焼けたら、\n私のヒーローよ。",
            "zh": "要是能把广岛风煎好，\n你就是我的英雄了。",
            "narrator_zh": "茧"
        },
        {
            "location": "149/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "今夜から、秘密の特訓を\nしないとダメそうね…。",
            "zh": "看来从今晚起，不进行\n秘密特训是不行了呢……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/ACT",
            "narrator": "",
            "text": "知らないフリをしよう",
            "zh": "装作不知道吧",
            "narrator_zh": ""
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あら？\n誰かしら…？",
            "zh": "哎、哎呀？\n会是谁呢……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "172/TALK",
            "narrator": "ガブリエラ",
            "text": "たこ焼きを知っててお好み焼きを知らないなんて",
            "zh": "明明知道章鱼烧却不知道御好烧什么的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなの通用するの？",
            "zh": "那种借口行得通吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "174/TALK",
            "narrator": "ガブリエラ",
            "text": "…不安ではあるけど、ちょっと気になるわ",
            "zh": "……虽然有点不安，不过稍微有点在意呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "175/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナの言うとおりに言ってみるわ",
            "zh": "我就按玛尔赞娜说的试试看吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "え、えっと…根本的な\nところから聞くけど…。",
            "zh": "那、那个……我从最根本的\n地方问起啊……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "お好み焼きって、なに？",
            "zh": "御好烧，是什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "192/TALK",
            "narrator": "繭",
            "text": "…え？",
            "zh": "……哎？",
            "narrator_zh": "茧"
        },
        {
            "location": "195/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん、もしかして\nお好み焼き知らないの？",
            "zh": "加布，难道说你\n不知道御好烧吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "は、初めて聞くわ。\nどんな食べ物なのかしら？",
            "zh": "我、我第一次听说呢。\n那是什么样的食物呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "200/TALK",
            "narrator": "雛",
            "text": "たこ焼きは知ってるのに\nお好み焼きを知らない\nなんて、あるんだね。",
            "zh": "原来还有明明知道章鱼烧\n却不知道御好烧的\n情况啊。",
            "narrator_zh": "雏"
        },
        {
            "location": "202/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしもそれがすっごい\n疑問ではあるんだけど…。",
            "zh": "我自己也觉得这点\n非常可疑就是了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "繭",
            "text": "これは、焼けるか\nどうか以前の問題ね。",
            "zh": "这已经是能不能煎好\n之前的问题了呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "207/TALK",
            "narrator": "雛",
            "text": "そうだね…近いうちに、\nガブリエラちゃんを\nお店に連れて行かないと。",
            "zh": "是啊……得在近期\n带加布里埃拉\n去店里吃一次才行。",
            "narrator_zh": "雏"
        },
        {
            "location": "209/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？",
            "zh": "哎！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "210/TALK",
            "narrator": "雛",
            "text": "たこ焼きが好きなら、\nお好み焼きだって\n絶対気に入るよ。",
            "zh": "既然喜欢章鱼烧，\n那御好烧也\n绝对会喜欢的啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "211/TALK",
            "narrator": "雛",
            "text": "焼くのは難しいけど、\n凄く美味しいしね。",
            "zh": "虽然煎起来很难，\n但真的超级好吃哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "212/TALK",
            "narrator": "つばめ",
            "text": "お野菜とお肉いっぱいで、\n一枚でお腹いっぱいに\nなるんだよ。",
            "zh": "里面有好多蔬菜和肉，\n吃一张就能填饱\n肚子呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そう…わかったわ。\n近いうちに行きましょ。",
            "zh": "是、是吗……我知道了。\n过几天就一起去吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "215/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、お好み焼きも\n大好きだから楽しみだわ。",
            "zh": "我也很喜欢\n御好烧，真期待呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "217/TALK",
            "narrator": "雛",
            "text": "もちろん、そのときの\nひっくり返す係りは\nガブリエラちゃんね。",
            "zh": "当然，到时候\n负责翻面的\n就是加布里埃拉咯。",
            "narrator_zh": "雏"
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "な、なんで！？\nあたし、お好み焼きのこと\n知らないのに！",
            "zh": "为、为什么！？\n我明明连御好烧\n都不知道啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "221/TALK",
            "narrator": "雛",
            "text": "だからこそ、実際にやって\n難しさを知った方がいい\nでしょ？",
            "zh": "正因如此，才更应该\n实际动手体会一下\n它的难度吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "222/TALK",
            "narrator": "雛",
            "text": "本当に難しいから、\nビックリすると思うよ。",
            "zh": "因为真的很难，\n我想你肯定会大吃一惊哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "224/TALK",
            "narrator": "繭",
            "text": "何事も経験。\n経験するなら早い方が\nいいわ。",
            "zh": "凡事贵在体验。\n要体验还是趁早\n比较好。",
            "narrator_zh": "茧"
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "ひっくり返す時の緊張感が\n苦手なのに…。",
            "zh": "我最不擅长翻面时的\n那种紧张感了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、せっかく初体験だと\n思われてるんだし――",
            "zh": "不过，难得被大家当成\n初次体验——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "気楽にやってみよう\nかしら？",
            "zh": "干脆放轻松试试\n看好了？",
            "narrator_zh": "加布里埃拉"
        },
        {
