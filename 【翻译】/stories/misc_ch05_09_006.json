        "sub_title_zh": "老电影院·露天咖啡"
    },
    "entry": [
        {
            "location": "2356/SCENARIO",
            "narrator": "",
            "text": "オールドシネマ・オープンカフェ",
            "zh": "老电影院·露天咖啡",
            "narrator_zh": ""
        },
        {
            "location": "2381/TALK",
            "narrator": "神楽",
            "text": "名画座って言い方されると",
            "zh": "一说「名画座」这种叫法",
            "narrator_zh": "神乐"
        },
        {
            "location": "2382/TALK",
            "narrator": "神楽",
            "text": "モノクロ映画しかかからないような気がするんだけど",
            "zh": "就觉得好像只放黑白电影",
            "narrator_zh": "神乐"
        },
        {
            "location": "2384/SEL",
            "narrator": "",
            "text": "わかる！",
            "zh": "懂！",
            "narrator_zh": ""
        },
        {
            "location": "2385/SEL",
            "narrator": "",
            "text": "$me$は全米系娯楽大作しか観ないから",
            "zh": "$me$只看全美系娱乐大片",
            "narrator_zh": ""
        },
        {
            "location": "2386/SEL",
            "narrator": "",
            "text": "名画座って何？",
            "zh": "名画座是什么？",
            "narrator_zh": ""
        },
        {
            "location": "2387/ACT",
            "narrator": "",
            "text": "わかる！",
            "zh": "懂！",
            "narrator_zh": ""
        },
        {
            "location": "2389/TALK",
            "narrator": "神楽",
            "text": "でしょでしょ！",
            "zh": "对吧对吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2391/TALK",
            "narrator": "神楽",
            "text": "さすが$handlek$♪",
            "zh": "不愧是$handlek$♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "2392/TALK",
            "narrator": "神楽",
            "text": "雰囲気がそうなの！",
            "zh": "就是那种气氛！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2393/TALK",
            "narrator": "神楽",
            "text": "ひとつしかないスクリーンとか",
            "zh": "只有一块银幕之类的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2394/TALK",
            "narrator": "神楽",
            "text": "エントランスのちょっと暗い感じとかね",
            "zh": "还有入口那点暗暗的感觉",
            "narrator_zh": "神乐"
        },
        {
            "location": "2395/ACT",
            "narrator": "",
            "text": "$me$は全米系娯楽大作しか観ないから",
            "zh": "$me$只看全美系娱乐大片",
            "narrator_zh": ""
        },
        {
            "location": "2396/TALK",
            "narrator": "神楽",
            "text": "あーそういう楽しみ方ね",
            "zh": "啊，是那种享受方式呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "2398/TALK",
            "narrator": "神楽",
            "text": "それはそれで楽しいから全然あり",
            "zh": "那样也开心，完全可以",
            "narrator_zh": "神乐"
        },
        {
            "location": "2399/ACT",
            "narrator": "",
            "text": "名画座って何？",
            "zh": "名画座是什么？",
            "narrator_zh": ""
        },
        {
            "location": "2400/TALK",
            "narrator": "神楽",
            "text": "そこから？",
            "zh": "要从那里开始？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2401/TALK",
            "narrator": "神楽",
            "text": "映画館の種類",
            "zh": "电影院的种类",
            "narrator_zh": "神乐"
        },
        {
            "location": "2402/TALK",
            "narrator": "神楽",
            "text": "ロードショーじゃなくて旧作品だけをかける、、、上映する映画館のこと",
            "zh": "不是首轮，只放旧作品……上映的电影院",
            "narrator_zh": "神乐"
        },
        {
            "location": "2403/TALK",
            "narrator": "神楽",
            "text": "ネット配信が普及する前はそれなりにあったらしい",
            "zh": "在网络配信普及之前，好像还有不少",
            "narrator_zh": "神乐"
        },
        {
            "location": "2404/TALK",
            "narrator": "神楽",
            "text": "そんな時代、想像もつかないけど！",
            "zh": "那种时代，根本想象不到！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2406/TALK",
            "narrator": "神楽",
            "text": "神楽坂トライナリーは真幌さんの趣味でよく怪獣映画を上映してるんだけど",
            "zh": "神乐坂三重奏会因为真幌的爱好，经常放怪兽电影",
            "narrator_zh": "神乐"
        },
        {
            "location": "2407/TALK",
            "narrator": "神楽",
            "text": "怪獣映画て！",
            "zh": "怪兽电影诶！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2408/TALK",
            "narrator": "神楽",
            "text": "しかも特撮感バリバリ！",
            "zh": "而且特摄感满满！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2411/SEL",
            "narrator": "",
            "text": "好きなんでしょ？",
            "zh": "你喜欢的吧？",
            "narrator_zh": ""
        },
        {
            "location": "2412/SEL",
            "narrator": "",
            "text": "意外と詳しいと見た",
            "zh": "看起来意外地懂",
            "narrator_zh": ""
        },
        {
            "location": "2413/SEL",
            "narrator": "",
            "text": "神楽のために映画館を貸し切りにしよう",
            "zh": "为了神乐把电影院包下来吧",
            "narrator_zh": ""
        },
        {
            "location": "2414/ACT",
            "narrator": "",
            "text": "好きなんでしょ？",
            "zh": "你喜欢的吧？",
            "narrator_zh": ""
        },
        {
            "location": "2415/TALK",
            "narrator": "神楽",
            "text": "設定なんかがぶっ飛びまくってるところは意外と気に入ってる",
            "zh": "设定飞得到处都是的地方，我意外地喜欢",
            "narrator_zh": "神乐"
        },
        {
            "location": "2416/ACT",
            "narrator": "",
            "text": "意外と詳しいと見た",
            "zh": "看起来意外地懂",
            "narrator_zh": ""
        },
        {
            "location": "2417/TALK",
            "narrator": "神楽",
            "text": "そうでもないけど",
            "zh": "也没那么懂",
            "narrator_zh": "神乐"
        },
        {
            "location": "2418/ACT",
            "narrator": "",
            "text": "神楽のために映画館を貸し切りにしよう",
            "zh": "为了神乐把电影院包下来吧",
            "narrator_zh": ""
        },
        {
            "location": "2420/TALK",
            "narrator": "神楽",
            "text": "それは素敵な誘い",
            "zh": "那是很棒的邀请",
            "narrator_zh": "神乐"
        },
        {
            "location": "2422/TALK",
            "narrator": "神楽",
            "text": "その時は全米が恋した級の甘い甘いラブロマンスでお願いね！",
            "zh": "那时候请放全美都恋上了那个级别的、甜甜的爱情片哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2423/TALK",
            "narrator": "神楽",
            "text": "怪獣映画には燃えはあるけど萌えがないから",
            "zh": "怪兽电影有燃，可没有萌",
            "narrator_zh": "神乐"
        },
        {
            "location": "2424/TALK",
            "narrator": "神楽",
            "text": "いやしかし世の中には怪獣に萌える人種もいるからなー",
            "zh": "不过世上也有对怪兽萌的人种啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "2425/TALK",
            "narrator": "神楽",
            "text": "特殊過ぎんだろ！！！！",
            "zh": "也太特殊了吧！！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2427/TALK",
            "narrator": "神楽",
            "text": "全然知らない世界過ぎて面白いというよりは興味深いという意識で見るね、古い映画は",
            "zh": "旧电影我是这么看的：与其说有趣，不如说是完全不认识的世界，所以觉得耐人寻味",
            "narrator_zh": "神乐"
        },
        {
            "location": "2428/TALK",
            "narrator": "神楽",
            "text": "それもありでしょ",
            "zh": "这样也可以吧",
            "narrator_zh": "神乐"
        }
    ]
}
