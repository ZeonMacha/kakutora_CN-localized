 },
 "entry": [
  {
   "location": "418/SCENARIO",
   "narrator": "",
   "text": "初めてのデイドラ",
   "zh": "第一次每日剧场",
   "narrator_zh": ""
  },
  {
   "location": "439/TALK",
   "narrator": "千羽鶴",
   "text": "現実世界へ\nおかえりなさい。",
   "zh": "欢迎回到\n现实世界。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "440/TALK",
   "narrator": "千羽鶴",
   "text": "貴方が彼女のココロの中で\n奮闘してくれたお陰で、\n彼女の心は安定した。",
   "zh": "多亏你在她的心中\n奋战，\n她的心稳定下来了。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "441/TALK",
   "narrator": "千羽鶴",
   "text": "あとは貴方から直接、\n彼女にアドバイスをして、\n背中を一押しするだけ。",
   "zh": "接下来只要你直接\n给她出主意，\n在背后推她一把。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "442/TALK",
   "narrator": "千羽鶴",
   "text": "さて、\nその方法だけど。",
   "zh": "那么，\n说到方法。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "448/TALK",
   "narrator": "千羽鶴",
   "text": "WAVEというチャット\nツールのシステムを\n作ってみた。",
   "zh": "我做了个\n叫WAVE的聊天\n工具系统。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "449/TALK",
   "narrator": "千羽鶴",
   "text": "あなたの世界にも、\n似たものがあるかも\nしれないけど。",
   "zh": "你的世界里，\n也许也有\n类似的东西。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "450/TALK",
   "narrator": "千羽鶴",
   "text": "そして、彼女のWAVEに\nあなたを登録して\nおいた。",
   "zh": "然后，我已经把你\n登记进\n她的WAVE了。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "451/SEL",
   "narrator": "",
   "text": "なるほど",
   "zh": "原来如此",
   "narrator_zh": ""
  },
  {
   "location": "452/ACT",
   "narrator": "",
   "text": "なるほど",
   "zh": "原来如此",
   "narrator_zh": ""
  },
  {
   "location": "454/TALK",
   "narrator": "千羽鶴",
   "text": "でも「bot」として\nだけど。",
   "zh": "不过，是作为“bot”\n而已。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "455/SEL",
   "narrator": "",
   "text": "なんでBot！？",
   "zh": "为什么是Bot！？",
   "narrator_zh": ""
  },
  {
   "location": "456/ACT",
   "narrator": "",
   "text": "なんでBot！？",
   "zh": "为什么是Bot！？",
   "narrator_zh": ""
  },
  {
   "location": "458/TALK",
   "narrator": "千羽鶴",
   "text": "いきなり知らない人が\nフレンド登録されて\nいたらまずいでしょう。",
   "zh": "要是突然被\n不认识的人\n加为好友，不好吧。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "459/SEL",
   "narrator": "",
   "text": "そんなところにリアリティを持たせなくても",
   "zh": "那种地方不必追求真实感",
   "narrator_zh": ""
  },
  {
   "location": "460/ACT",
   "narrator": "",
   "text": "そんなところにリアリティを持たせなくても",
   "zh": "那种地方不必追求真实感",
   "narrator_zh": ""
  },
  {
   "location": "462/TALK",
   "narrator": "千羽鶴",
   "text": "「あなた」は「あなた」\nなんだから。",
   "zh": "“你”就是“你”，\n所以。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "463/TALK",
   "narrator": "千羽鶴",
   "text": "幼馴染み設定とか、\nそんな都合のいい\nものはないから。",
   "zh": "没有青梅竹马设定\n这种\n这么方便的东西。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "464/TALK",
   "narrator": "千羽鶴",
   "text": "そこはリアリティを\n持って欲しい。",
   "zh": "这里希望你\n带着真实感。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "465/TALK",
   "narrator": "千羽鶴",
   "text": "そういうわけだから、\n彼女からの抵抗は\nあまり無いはず。",
   "zh": "所以，\n她那边的抗拒\n应该不多。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "466/SEL",
   "narrator": "",
   "text": "でもBotじゃねえ…",
   "zh": "可是Bot也太……",
   "narrator_zh": ""
  },
  {
   "location": "467/ACT",
   "narrator": "",
   "text": "でもBotじゃねえ…",
   "zh": "可是Bot也太……",
   "narrator_zh": ""
  },
  {
   "location": "469/TALK",
   "narrator": "千羽鶴",
   "text": "私はあくまで\n自然な出逢いと機会を\n与えただけ。",
   "zh": "我不过是给了\n自然的相遇\n和机会。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "470/TALK",
   "narrator": "千羽鶴",
   "text": "どう運用するかは\nあなたが決めていい。",
   "zh": "怎么用，\n你自己决定就好。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "471/TALK",
   "narrator": "千羽鶴",
   "text": "すぐに「bot」では\nないと伝えてもいいし、\nそのままでもいい。",
   "zh": "可以马上告诉她\n自己不是“bot”，\n也可以就这样。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "472/TALK",
   "narrator": "千羽鶴",
   "text": "そこはあなたの\nセンスに任せる。",
   "zh": "那里就交给\n你的分寸。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "476/TALK",
   "narrator": "千羽鶴",
   "text": "さあ、彼女の新しい物語が\n始まろうとしている。",
   "zh": "来，她的新故事\n就要开始了。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "477/TALK",
   "narrator": "千羽鶴",
   "text": "チャットツールWAVEを\n使って、彼女を支えて\nいってほしい。",
   "zh": "希望你用聊天工具WAVE\n去支持她，\n陪她走下去。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "490/TALK",
   "narrator": "つばめ",
   "text": "はぁ……\nほんと、どうしよう。",
   "zh": "哈啊……\n真是的，怎么办呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "491/SEL",
   "narrator": "",
   "text": "こんばんは",
   "zh": "晚上好",
