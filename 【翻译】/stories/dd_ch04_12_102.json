{
    "dir": "chap12/daydra/dd_ch04_12_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "12405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "偶然の出会い＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "偶然的相遇＜后篇＞"
    },
    "entry": [
        {
            "location": "533/SCENARIO",
            "narrator": "",
            "text": "偶然の出会い",
            "zh": "偶然的相遇",
            "narrator_zh": ""
        },
        {
            "location": "555/TALK",
            "narrator": "みやび",
            "text": "…いや、やはり\nもうちくっと\n努力してみるか。",
            "zh": "……不，果然\n还是再多\n努力一下咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "556/TALK",
            "narrator": "みやび",
            "text": "成り行きとはいえ、\n座れ言うたんは\nうちなんやし――",
            "zh": "虽说是事出偶然，\n但叫人坐下的\n是我自己——",
            "narrator_zh": "雅"
        },
        {
            "location": "557/TALK",
            "narrator": "みやび",
            "text": "やれるだけ\nやっとかんとな。",
            "zh": "能做的\n就得做好才行。",
            "narrator_zh": "雅"
        },
        {
            "location": "564/TALK",
            "narrator": "みやび",
            "text": "ヘルプミー",
            "zh": "帮帮我",
            "narrator_zh": "雅"
        },
        {
            "location": "565/TALK",
            "narrator": "みやび",
            "text": "アドバイス頼む",
            "zh": "求建议",
            "narrator_zh": "雅"
        },
        {
            "location": "567/SEL",
            "narrator": "",
            "text": "繭とは何度か会ってるでしょ？",
            "zh": "茧不是见过几次吗？",
            "narrator_zh": ""
        },
        {
            "location": "568/ACT",
            "narrator": "",
            "text": "繭とは何度か会ってるでしょ？",
            "zh": "茧不是见过几次吗？",
            "narrator_zh": ""
        },
        {
            "location": "570/TALK",
            "narrator": "みやび",
            "text": "会ってはいるがまともに話したことはない",
            "zh": "人是见过，但没正经聊过",
            "narrator_zh": "雅"
        },
        {
            "location": "571/TALK",
            "narrator": "みやび",
            "text": "故にどんな子か知らん",
            "zh": "所以不知道那孩子什么性子",
            "narrator_zh": "雅"
        },
        {
            "location": "572/TALK",
            "narrator": "みやび",
            "text": "どうしたらえいのか？",
            "zh": "该怎么办才好咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "574/SEL",
            "narrator": "",
            "text": "何でもいいから、とにかく質問！",
            "zh": "什么都行，总之提问！",
            "narrator_zh": ""
        },
        {
            "location": "575/ACT",
            "narrator": "",
            "text": "何でもいいから、とにかく質問！",
            "zh": "什么都行，总之提问！",
            "narrator_zh": ""
        },
        {
            "location": "577/TALK",
            "narrator": "みやび",
            "text": "当たり障りないことしか言わんな",
            "zh": "净说些不痛不痒的话呢",
            "narrator_zh": "雅"
        },
        {
            "location": "578/TALK",
            "narrator": "みやび",
            "text": "まあえいけんど",
            "zh": "嘛，倒也行，不过",
            "narrator_zh": "雅"
        },
        {
            "location": "585/TALK",
            "narrator": "みやび",
            "text": "…質問ゆうても、\n何を聞けば――",
            "zh": "……说是提问，\n该问什么——",
            "narrator_zh": "雅"
        },
        {
            "location": "588/TALK",
            "narrator": "みやび",
            "text": "ん？　そういえば\n光月さん達――",
            "zh": "嗯？　说起来\n光月她们——",
            "narrator_zh": "雅"
        },
        {
            "location": "589/TALK",
            "narrator": "みやび",
            "text": "うちの劇場でバイト\nすることになったん\nやったっけ？",
            "zh": "要在我的剧场打工\n是这么一回事\n来着？",
            "narrator_zh": "雅"
        },
        {
            "location": "590/TALK",
            "narrator": "繭",
            "text": "はい。\n教官からの許可も\nいただけましたので。",
            "zh": "是的。\n教官那边的许可\n也已经拿到了。",
            "narrator_zh": "茧"
        },
        {
            "location": "593/TALK",
            "narrator": "みやび",
            "text": "そうか…。\nえーっと、\nなんやったっけ…。",
            "zh": "这样啊……。\n那个……\n叫什么来着……。",
            "narrator_zh": "雅"
        },
        {
            "location": "596/TALK",
            "narrator": "みやび",
            "text": "そう、確か\nトライナリー愚連隊\nやったな。",
            "zh": "对，记得\n是叫三重奏愚连队\n来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "597/TALK",
            "narrator": "繭",
            "text": "応援団です！！",
            "zh": "是应援团！！",
            "narrator_zh": "茧"
        },
        {
            "location": "598/TALK",
            "narrator": "繭",
            "text": "あ、いえ…正式には\n応援団という名称も\n違うのですが…。",
            "zh": "啊，不……正式来说，\n连应援团这个名称\n也不对……。",
            "narrator_zh": "茧"
        },
        {
            "location": "599/TALK",
            "narrator": "みやび",
            "text": "そうなが？",
            "zh": "是咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "600/TALK",
            "narrator": "繭",
            "text": "そうなのです。",
            "zh": "正是如此。",
            "narrator_zh": "茧"
        },
        {
            "location": "602/TALK",
            "narrator": "繭",
            "text": "その件では以前、\nみやび先輩に――",
            "zh": "那件事，之前\n对雅前辈——",
            "narrator_zh": "茧"
        },
        {
            "location": "603/TALK",
            "narrator": "繭",
            "text": "多大なご迷惑を\nおかけいたしました。",
            "zh": "给您添了\n很大的麻烦。",
            "narrator_zh": "茧"
        },
        {
            "location": "604/TALK",
            "narrator": "みやび",
            "text": "それって、うちに\nまほさんへ口添えして\nくれって――",
            "zh": "那是说，叫我\n跟真幌\n说情的那次——",
            "narrator_zh": "雅"
        },
        {
            "location": "606/TALK",
            "narrator": "みやび",
            "text": "頼み込んできた時の\nこと言うてる？",
            "zh": "是说你来拜托我\n时候的事？",
            "narrator_zh": "雅"
        },
        {
            "location": "607/TALK",
            "narrator": "繭",
            "text": "はい…。",
            "zh": "是……。",
            "narrator_zh": "茧"
        },
        {
            "location": "609/TALK",
            "narrator": "みやび",
            "text": "それやったら、\n別に迷惑なんぞ\n掛かっちょらんよ。",
            "zh": "那的话，\n压根没给我\n添什么麻烦咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "610/TALK",
            "narrator": "みやび",
            "text": "うちは何だかんだ\n理由付けて、\n断ったんやきね。",
            "zh": "我找了一堆理由，\n把她\n给回绝了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "611/TALK",
            "narrator": "繭",
            "text": "それは承知して\nいます。",
            "zh": "这个我是\n知道的。",
            "narrator_zh": "茧"
        },
        {
            "location": "613/TALK",
            "narrator": "繭",
            "text": "命の危険の話から\n始まり、拘束時間が\n長いわりに――",
            "zh": "从有生命危险讲起，\n还说拘束时间\n那么长却——",
            "narrator_zh": "茧"
        },
        {
            "location": "614/TALK",
            "narrator": "繭",
            "text": "時給が低く、\n遣り甲斐もないから\n勧められない。",
            "zh": "时薪又低，\n也没干头，\n所以才劝她别去。",
            "narrator_zh": "茧"
        },
        {
            "location": "616/TALK",
            "narrator": "繭",
            "text": "そう言ってましたね。",
            "zh": "当时你是这么说的。",
            "narrator_zh": "茧"
        },
        {
            "location": "617/TALK",
            "narrator": "みやび",
            "text": "あー…うん、確かに\n言うたけんどな、\n実はあれ――",
            "zh": "啊……嗯，确实\n说过咯，\n其实那番话——",
            "narrator_zh": "雅"
        },
        {
            "location": "618/TALK",
            "narrator": "繭",
            "text": "教官に口添えをする\nのが面倒だったための\nデタラメ、ですね？",
            "zh": "只是嫌帮教官\n传话麻烦\n才胡说的，对吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "620/TALK",
            "narrator": "みやび",
            "text": "…察しがえいね。\nばれんようにやった\nつもりやったけんど。",
            "zh": "……你领悟力算好了。\n本来想着做得\n不让人发现的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "621/TALK",
            "narrator": "繭",
            "text": "多分、私もノリ気では\nなかったからだと\n思います。",
            "zh": "大概也因为\n我自己本来\n就不太起劲吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "622/TALK",
            "narrator": "みやび",
            "text": "そうやったが？\nけんど、結局バイト\nしちょるやろ？",
            "zh": "是咩？\n但是，结果你\n不还是在打工嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "624/TALK",
            "narrator": "繭",
            "text": "…あいつらだけに\n任せておいたら――",
            "zh": "……要是全交给\n那帮家伙——",
            "narrator_zh": "茧"
        },
        {
            "location": "625/TALK",
            "narrator": "繭",
            "text": "皆さんにご迷惑を\nおかけすると\n思いましたので…。",
            "zh": "就想到会给大家\n添麻烦，\n所以……。",
            "narrator_zh": "茧"
        },
        {
            "location": "627/TALK",
            "narrator": "みやび",
            "text": "あはは…そこまで\n心配するほどやないと\n思うけんどね。",
            "zh": "啊哈哈……我觉得\n不至于担心到\n那个地步咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "628/TALK",
            "narrator": "みやび",
            "text": "…それが理由で、\n一緒にバイトしよう\n思うたが？",
            "zh": "……因为那个理由，\n就想着干脆\n一起打工了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "631/TALK",
            "narrator": "繭",
            "text": "いえ…実はその、\n大きな声では\n言えないのですが――",
            "zh": "不……其实这个，\n不太好大声\n说出来的——",
            "narrator_zh": "茧"
        },
        {
            "location": "633/TALK",
            "narrator": "繭",
            "text": "仕事を手伝うことで、\nトライナリーに\n関する――",
            "zh": "通过帮忙工作，\n说不定能接触到\n三重奏相关的——",
            "narrator_zh": "茧"
        },
        {
            "location": "634/TALK",
            "narrator": "繭",
            "text": "極秘情報などを知る\nことができるのでは、\nと思ったんです。",
            "zh": "绝密情报之类的\n东西，\n是这么想的。",
            "narrator_zh": "茧"
        },
        {
            "location": "635/TALK",
            "narrator": "みやび",
            "text": "表に出したらヤバい\n情報やけんどね。",
            "zh": "虽然是一摊出去\n就糟了的情报咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "637/TALK",
            "narrator": "繭",
            "text": "私個人の知的好奇心が\n満たせれば、それで\nいいのです。",
            "zh": "只要能满足\n我个人的求知欲，\n那就够了。",
            "narrator_zh": "茧"
        },
        {
            "location": "638/TALK",
            "narrator": "繭",
            "text": "他にも、指令室に\nあるような見たことも\nない機械に――",
            "zh": "还有，指令室里\n那些从没见过的\n机器——",
            "narrator_zh": "茧"
        },
        {
            "location": "639/TALK",
            "narrator": "繭",
            "text": "この手で触れることが\nできるかもしれない。",
            "zh": "说不定能用\n这双手摸到。",
            "narrator_zh": "茧"
        },
        {
            "location": "640/TALK",
            "narrator": "繭",
            "text": "…という、自分勝手な\n理由で協力しようと\n思ったわけです。",
            "zh": "……就是抱着\n这么自私的理由\n想来帮忙的。",
            "narrator_zh": "茧"
        },
        {
            "location": "641/TALK",
            "narrator": "みやび",
            "text": "あはは、\nなるほどそうかー。",
            "zh": "啊哈哈，\n原来是这样啊——。",
            "narrator_zh": "雅"
        },
        {
            "location": "643/TALK",
            "narrator": "みやび",
            "text": "光月さんは正直やね。\nそういう子、うちは\n嫌いやないちや。",
            "zh": "光月很坦率呢。\n这种孩子，我\n不讨厌滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "645/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "646/TALK",
            "narrator": "みやび",
            "text": "まあ、一応うちも\nトライナリーの隊員\nやきね。",
            "zh": "嘛，好歹我也是\n三重奏的队员\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "647/TALK",
            "narrator": "みやび",
            "text": "この件については、\n深く聞かんことに\nするぞね。",
            "zh": "这件事，\n我就决定\n不深究了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "649/TALK",
            "narrator": "繭",
            "text": "…ありがとうござい\nます。",
            "zh": "……非常\n感谢。",
            "narrator_zh": "茧"
        },
        {
            "location": "650/TALK",
            "narrator": "みやび",
            "text": "えいよえいよ。\nそれより、今の話を\n聞く限り――",
            "zh": "得啦得啦。\n比起这个，光从\n刚才这番话来听——",
            "narrator_zh": "雅"
        },
        {
            "location": "651/TALK",
            "narrator": "みやび",
            "text": "光月さんは\n機械好きなが？",
            "zh": "光月是\n喜欢机械的咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "652/TALK",
            "narrator": "繭",
            "text": "はい…主にＰＣに\n関してですが…。",
            "zh": "是……主要是\nＰＣ方面……。",
            "narrator_zh": "茧"
        },
        {
            "location": "653/TALK",
            "narrator": "みやび",
            "text": "ほう…自作派？",
            "zh": "哦……自己装机的？",
            "narrator_zh": "雅"
        },
        {
            "location": "654/TALK",
            "narrator": "繭",
            "text": "もちろんです。\n隅々まで自分に\n合わせたいので。",
            "zh": "当然。\n想让自己的\n方方面面都合心意。",
            "narrator_zh": "茧"
        },
        {
            "location": "655/TALK",
            "narrator": "繭",
            "text": "…みやび先輩は、\n魔改造なども\nしているようですね。",
            "zh": "……雅前辈好像\n还有做过\n魔改什么的。",
            "narrator_zh": "茧"
        },
        {
            "location": "657/TALK",
            "narrator": "みやび",
            "text": "…何故知っちょる？",
            "zh": "……你是怎么知道的咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "658/TALK",
            "narrator": "繭",
            "text": "前に、みやび先輩が\n使っている――",
            "zh": "之前，雅前辈\n在用的——",
            "narrator_zh": "茧"
        },
        {
            "location": "659/TALK",
            "narrator": "繭",
            "text": "ノートＰＣの画面が\n見えてしまいまして。",
            "zh": "笔记本的画面，\n不小心看到了。",
            "narrator_zh": "茧"
        },
        {
            "location": "660/TALK",
            "narrator": "繭",
            "text": "外見は数年前の\nマシンだという\nのに――",
            "zh": "明明外观是\n几年前的机器，\n却——",
            "narrator_zh": "茧"
        },
        {
            "location": "661/TALK",
            "narrator": "繭",
            "text": "ソフトの立ち上がり\n速度が早過ぎたように\n思ったのです。",
            "zh": "只是觉得软件的\n启动速度\n太快了点。",
            "narrator_zh": "茧"
        },
        {
            "location": "662/TALK",
            "narrator": "みやび",
            "text": "よぅ見ちょるなぁ…。\nそれはちくっと\nビックリや。",
            "zh": "观察得挺仔细嘛……。\n这倒让人\n有点吃惊滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "663/TALK",
            "narrator": "繭",
            "text": "覗き見してしまい、\n申し訳ありません。",
            "zh": "不小心偷看了，\n非常抱歉。",
            "narrator_zh": "茧"
        },
        {
            "location": "664/TALK",
            "narrator": "みやび",
            "text": "えいよえいよ。\n人前でする作業なんぞ\n大したもんやないき。",
            "zh": "没事没事。\n当人面做的活什么的\n不是什么大不了的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "665/TALK",
            "narrator": "みやび",
            "text": "しかし、そうかぁ…。\nそれだけで\n気付いたかぁ…。",
            "zh": "不过，这样啊……。\n光凭那个\n就注意到了啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "666/TALK",
            "narrator": "みやび",
            "text": "光月さん…思うたより\n話が合うっぽいな。",
            "zh": "光月……比想的\n还要聊得来呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "667/TALK",
            "narrator": "みやび",
            "text": "…もうちくっと、\n色々話してみるんも、\n楽しいかもしれん。",
            "zh": "……再多聊一点\n各种话题，\n说不定也挺有趣咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "668/TALK",
            "narrator": "みやび",
            "text": "…光月さんは\n魔改造せんが？",
            "zh": "……光月不做\n魔改的咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "669/TALK",
            "narrator": "繭",
            "text": "お恥ずかしながら、\nノートの魔改造は\n未経験でして…。",
            "zh": "说来惭愧，\n笔记本的魔改\n还没经历过……。",
            "narrator_zh": "茧"
        },
        {
            "location": "670/TALK",
            "narrator": "みやび",
            "text": "なんや、別にそう\n難しいことやない\nちや。",
            "zh": "什么嘛，那又不是\n多难的事情\n滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "671/TALK",
            "narrator": "みやび",
            "text": "例えば、うちの\n普段使いのマシン\nなんかはな――",
            "zh": "比如说，我\n日常用的那台机器\n什么的就——",
            "narrator_zh": "雅"
        },
        {
            "location": "672/TALK",
            "narrator": "繭",
            "text": "はい…なるほど…。\nですが、それだと\n中身総取り換えでは？",
            "zh": "是……原来如此……。\n但是那样的话，\n不就整个里面都换掉了？",
            "narrator_zh": "茧"
        },
        {
            "location": "674/TALK",
            "narrator": "みやび",
            "text": "あはは、そう見せ\nかけて実は――",
            "zh": "啊哈哈，看着像那样，\n其实是——",
            "narrator_zh": "雅"
        },
        {
            "location": "686/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【10 江戸川橋物語】",
            "zh": "【10 江户川桥物语】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
}
