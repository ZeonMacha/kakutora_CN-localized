        },
        {
            "location": "189/ACT",
            "narrator": "",
            "text": "まあね…",
            "zh": "是吧…",
            "narrator_zh": ""
        },
        {
            "location": "193/TALK",
            "narrator": "神楽",
            "text": "その受け答え、なんかオトナの匂いがする、、、",
            "zh": "这个回答，总感觉有大人的味道、、、",
            "narrator_zh": "神乐"
        },
        {
            "location": "195/TALK",
            "narrator": "神楽",
            "text": "オトナといえば",
