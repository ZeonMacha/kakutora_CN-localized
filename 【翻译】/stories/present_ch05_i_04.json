            "narrator_zh": "神乐"
        },
        {
            "location": "196/TALK",
            "narrator": "神楽",
            "text": "ぴょんこはバーでカクテルを嗜むのに憧れているんです",
            "zh": "蹦子一直憧憬着在酒吧里品味鸡尾酒",
            "narrator_zh": "神乐"
        },
        {
            "location": "197/TALK",
            "narrator": "神楽",
            "text": "まだまだコドモのウサギだから♪",
            "zh": "毕竟还是只小孩子气的兔子嘛♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "200/SEL",
            "narrator": "",
            "text": "連れて行ってあげるよ",
            "zh": "带你去哦",
            "narrator_zh": ""
        },
        {
            "location": "201/ACT",
            "narrator": "",
            "text": "連れて行ってあげるよ",
            "zh": "带你去哦",
            "narrator_zh": ""
        },
        {
