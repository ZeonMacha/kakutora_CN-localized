  {
   "location": "97/TALK",
   "narrator": "アーヤ",
   "text": "そうね",
   "zh": "说得对",
   "narrator_zh": "绫水"
  },
  {
   "location": "98/TALK",
   "narrator": "アーヤ",
   "text": "じゃあ",
   "zh": "那么",
   "narrator_zh": "绫水"
  },
  {
   "location": "105/TALK",
   "narrator": "ガブリエラ",
   "text": "…え？\nもう終わりなの？",
   "zh": "…诶？\n这就完了？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "106/TALK",
   "narrator": "アーヤ",
   "text": "ええ…大した用事じゃ\nなかったし。",
   "zh": "嗯……也不是\n什么要紧事。",
   "narrator_zh": "绫水"
  },
  {
   "location": "107/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "109/TALK",
   "narrator": "ガブリエラ",
   "text": "…やっぱり、\n落ち込んでるのかしら？",
   "zh": "…果然\n是在消沉吗？",
   "narrator_zh": "加布里埃拉"
  },
