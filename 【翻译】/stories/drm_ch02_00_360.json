   "text": "おーい",
   "zh": "喂——",
   "narrator_zh": ""
  },
  {
   "location": "78/TALK",
   "narrator": "ガブリエラ",
   "text": "…アーヤ。\n鳴ってるわよ。",
   "zh": "……绫水。\n在响哦。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "79/TALK",
   "narrator": "アーヤ",
   "text": "…わかってるわよ。",
   "zh": "……我知道了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "80/TALK",
   "narrator": "ガブリエラ",
   "text": "じゃあ取りなさいよ。\n止まらなくてうるさいし。",
   "zh": "那你接啊。\n响起来没完，吵死了。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "82/TALK",
   "narrator": "アーヤ",
   "text": "はぁ…。",
   "zh": "哈啊……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "91/TALK",
   "narrator": "アーヤ",
   "text": "なに？",
   "zh": "什么？",
   "narrator_zh": "绫水"
  },
  {
   "location": "92/TALK",
   "narrator": "アーヤ",
