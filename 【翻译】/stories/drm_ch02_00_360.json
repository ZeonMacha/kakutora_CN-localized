  "title": "らぶとーく 第36話",
  "sub_title": "サークルぐるぐる"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "サークルぐるぐる"
  },
  {
   "location": "18/TALK",
   "narrator": "ガブリエラ",
   "text": "…そういえば、\n次はいつなの？"
  },
  {
   "location": "20/TALK",
   "narrator": "アーヤ",
   "text": "？　何の話？"
  },
  {
   "location": "21/TALK",
   "narrator": "ガブリエラ",
   "text": "ボランティアよ。\nほら、アーヤの人形劇。"
  },
  {
   "location": "22/TALK",
   "narrator": "アーヤ",
   "text": "何？　もしかして、\nまた手伝ってくれるの\nかしら？"
  },
  {
   "location": "23/TALK",
   "narrator": "ガブリエラ",
   "text": "それはお断り。",
   "zh": "那个我拒绝。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "24/TALK",
   "narrator": "ガブリエラ",
   "text": "前はタダ働きさせられたん\nだから、次は観客として\n行くつもりよ。"
  },
  {
   "location": "25/TALK",
   "narrator": "アーヤ",
   "text": "園児に混ざってまで\n見る必要ないでしょ？"
  },
  {
   "location": "26/TALK",
   "narrator": "アーヤ",
   "text": "っていうか、そんなに\n興味あるの？",
   "zh": "话说，你就那么\n有兴趣？",
   "narrator_zh": "绫水"
  },
  {
   "location": "27/TALK",
   "narrator": "ガブリエラ",
   "text": "きょ、興味があるから、\nってわけじゃないわ。",
   "zh": "我、我可不是\n因为有兴趣哦。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "28/TALK",
   "narrator": "ガブリエラ",
   "text": "ただ、どんな感じの\n劇なのか、見てみようと\n思っただけよ。",
   "zh": "只是，我想看看\n是什么样的\n戏而已。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "29/TALK",
   "narrator": "アーヤ",
   "text": "…興味がある、ってこと\nじゃないの、それ？",
   "zh": "……那不就是说你有兴趣\n吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "30/TALK",
   "narrator": "ガブリエラ",
   "text": "とにかく、働いたんだから\n一回は見せてもらうわ。",
   "zh": "总之，既然工作了，\n总得让我看一次。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "31/TALK",
   "narrator": "ガブリエラ",
   "text": "だから、次の劇の予定を\n教えなさいよ。",
   "zh": "所以，把下一场戏的\n安排告诉我。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "33/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "35/TALK",
   "narrator": "ガブリエラ",
   "text": "何よ、言えないの？"
  },
  {
   "location": "36/TALK",
   "narrator": "アーヤ",
   "text": "…仕方ないでしょ。\n決まってないんだし。",
   "zh": "……没办法的吧。\n还没定下来呢。",
   "narrator_zh": "绫水"
  },
  {
   "location": "37/TALK",
   "narrator": "ガブリエラ",
   "text": "え？　そうなの？",
   "zh": "诶？　是吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "38/TALK",
   "narrator": "アーヤ",
   "text": "ええ…。",
   "zh": "嗯……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "40/TALK",
   "narrator": "アーヤ",
   "text": "もしかしたら、\nもうやらないかも\nしれないし…。"
  },
  {
   "location": "41/TALK",
   "narrator": "ガブリエラ",
   "text": "えっ！？\nど、どうしてよ？",
   "zh": "诶！？\n为、为什么啊？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "42/TALK",
   "narrator": "アーヤ",
   "text": "どうしても何も、\nわかるでしょ？",
   "zh": "什么无论如何，\n你懂的吧？",
   "narrator_zh": "绫水"
  },
  {
   "location": "43/TALK",
   "narrator": "アーヤ",
   "text": "ここ最近、トライナリーの\n仕事も忙しくなってきて、\n時間が取れないのよ。",
   "zh": "最近，三重奏的\n工作也忙起来了，\n抽不出时间。",
   "narrator_zh": "绫水"
  },
  {
   "location": "45/TALK",
   "narrator": "アーヤ",
   "text": "このままじゃ、せっかくの\n劇も中途半端なものに\nなっちゃうし――",
   "zh": "这样下去，难得的\n剧也会半途而废\n的——",
   "narrator_zh": "绫水"
  },
  {
   "location": "47/TALK",
   "narrator": "アーヤ",
   "text": "そうなるくらいなら、\nやめた方がいいかも、\nって考え中なのよ…。",
   "zh": "要是会变成那样，\n还是别干了比较好吧，\n我正在考虑……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "48/TALK",
   "narrator": "ガブリエラ",
   "text": "…そうなんだ。",
   "zh": "……是这样啊。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "49/TALK",
   "narrator": "アーヤ",
   "text": "…まあ、それだけが\n理由じゃないけど、\n色々あるのよ。",
   "zh": "……嘛，也不只是\n这个理由，\n各种事情都有啦。",
   "narrator_zh": "绫水"
  },
  {
   "location": "50/TALK",
   "narrator": "ガブリエラ",
   "text": "…ちょっと残念かも。"
  },
  {
   "location": "51/TALK",
   "narrator": "アーヤ",
   "text": "悪いわね。\nちゃんと見せてあげられ\nなくて。"
  },
  {
   "location": "52/TALK",
   "narrator": "ガブリエラ",
   "text": "それはいいんだけど、\nアーヤが…。",
   "zh": "那个是可以，\n不过绫水……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "53/TALK",
   "narrator": "アーヤ",
   "text": "？"
  },
  {
   "location": "54/TALK",
   "narrator": "ガブリエラ",
   "text": "…何でもない。",
   "zh": "……没什么。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "55/TALK",
   "narrator": "ガブリエラ",
   "text": "まあ、続けられそうなら\n続ければいいんじゃない？"
  },
  {
   "location": "56/TALK",
   "narrator": "アーヤ",
   "text": "…そうね。",
   "zh": "……也是。",
   "narrator_zh": "绫水"
  },
  {
   "location": "57/SEL",
   "narrator": "",
   "text": "忙しいんだね",
   "zh": "看来你很忙",
   "narrator_zh": ""
  },
  {
   "location": "58/SEL",
   "narrator": "",
   "text": "何かあったの？",
   "zh": "发生什么了？",
   "narrator_zh": ""
  },
  {
   "location": "59/SEL",
   "narrator": "",
   "text": "その分$me$と遊ぼうよ",
   "zh": "那你就多陪$me$玩嘛",
   "narrator_zh": ""
  },
  {
   "location": "60/ACT",
   "narrator": "",
   "text": "忙しいんだね",
   "zh": "看来你很忙",
   "narrator_zh": ""
  },
  {
   "location": "64/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
