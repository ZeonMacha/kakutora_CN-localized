   "narrator_zh": ""
  },
  {
   "location": "147/TALK",
   "narrator": "アーヤ",
   "text": "別に",
   "zh": "无所谓",
   "narrator_zh": "绫水"
  },
  {
   "location": "148/TALK",
   "narrator": "アーヤ",
   "text": "何もないわ"
  },
  {
   "location": "149/TALK",
   "narrator": "アーヤ",
   "text": "ギャヴィに言った通りよ"
  },
  {
   "location": "150/TALK",
   "narrator": "アーヤ",
   "text": "それだけだから",
   "zh": "就因为这样",
   "narrator_zh": "绫水"
  },
  {
   "location": "152/SEL",
   "narrator": "",
   "text": "彼氏じゃないと言えない？",
