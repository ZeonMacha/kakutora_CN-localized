   "narrator_zh": "绫水"
  },
  {
   "location": "170/TALK",
   "narrator": "ガブリエラ",
   "text": "…こんなに落ち込んでる\nアーヤ、初めて見たわ。"
  },
  {
   "location": "171/TALK",
   "narrator": "ガブリエラ",
