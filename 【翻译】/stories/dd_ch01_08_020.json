{
    "dir": "chap08/daydra/dd_ch01_08_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "8155",
        "cid": "tsubame",
        "title": "Extra005 プレミアムストーリー",
        "sub_title": "お疲れ真幌",
        "title_zh": "Extra005 额外剧情",
        "sub_title_zh": "辛苦了，真幌"
    },
    "entry": [
        {
            "location": "276/SCENARIO",
            "narrator": "",
            "text": "お疲れ真幌",
            "zh": "辛苦了，真幌",
            "narrator_zh": ""
        },
        {
            "location": "291/TALK",
            "narrator": "真幌",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "294/TALK",
            "narrator": "つばめ",
            "text": "真幌さん？",
            "zh": "真幌？",
            "narrator_zh": "燕"
        },
        {
            "location": "296/TALK",
            "narrator": "真幌",
            "text": "ん？　ああ、逢瀬か…。",
            "zh": "嗯？啊，是逢濑啊……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "297/TALK",
            "narrator": "つばめ",
            "text": "大丈夫ですか？\nなんだか、凄く疲れた\n顔してますけど…。",
            "zh": "你还好吗？\n总觉得脸色\n好累呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "298/TALK",
            "narrator": "真幌",
            "text": "ああ…少々やらなければ\nならないことが溜まって\nいてな。",
            "zh": "啊……有些不得不做的\n事情积下来\n了啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "299/TALK",
            "narrator": "真幌",
            "text": "特別攻撃隊の仕事以外に、\n学校と劇場の運営――",
            "zh": "特别攻击队的工作以外，\n学校和剧场的运营——",
            "narrator_zh": "真幌"
        },
        {
            "location": "301/TALK",
            "narrator": "真幌",
            "text": "やってできないことは\nないが…たまには疲れる\nこともあるさ。",
            "zh": "没有做不到的事\n……不过偶尔\n也会累。",
            "narrator_zh": "真幌"
        },
        {
            "location": "302/TALK",
            "narrator": "つばめ",
            "text": "…あ、ああっ！",
            "zh": "……啊、啊啊！",
            "narrator_zh": "燕"
        },
        {
            "location": "303/TALK",
            "narrator": "つばめ",
            "text": "そうですよね。\n真幌さんって、\n色んなお仕事してました！",
            "zh": "说得也是呀。\n真幌，\n做着好多工作！",
            "narrator_zh": "燕"
        },
        {
            "location": "305/TALK",
            "narrator": "真幌",
            "text": "人員不足でな。\n私がやるしかないん\nだよ。",
            "zh": "人手不够。\n只能由我来\n做了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "306/TALK",
            "narrator": "つばめ",
            "text": "でも、それを聞いて\n納得しました。",
            "zh": "不过，听你这么说\n我就明白了。",
            "narrator_zh": "燕"
        },
        {
            "location": "308/TALK",
            "narrator": "つばめ",
            "text": "真幌さんがいつも寝てる\nのって、疲れてるから\nだったんですね。",
            "zh": "真幌总是在睡觉，\n原来是因为累了\n呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "309/TALK",
            "narrator": "真幌",
            "text": "おい、まさか自堕落な\n女だと思っていたのか？",
            "zh": "喂，你该不会把我\n当成懒散的女人了吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "310/TALK",
            "narrator": "つばめ",
            "text": "ち、違います！\n寝るのが好きなのかな、\nって思ってたんです。",
            "zh": "不、不是的！\n我是想，会不会是\n喜欢睡觉呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "311/TALK",
            "narrator": "真幌",
            "text": "似たようなもんだ。\nまったく、おまえという\n奴は…。",
            "zh": "也差不多。\n真是的，你这个人\n啊……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "312/TALK",
            "narrator": "真幌",
            "text": "まあ、確かに昼寝は\n趣味と言っても過言では\nないのだが…。",
            "zh": "不过，午睡确实\n说是兴趣也不\n为过……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "313/TALK",
            "narrator": "つばめ",
            "text": "…変わった趣味だなぁ。",
            "zh": "……真是少见的兴趣呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "314/TALK",
            "narrator": "つばめ",
            "text": "毎日お疲れ様です。",
            "zh": "每天都辛苦了。",
            "narrator_zh": "燕"
        },
        {
            "location": "315/TALK",
            "narrator": "真幌",
            "text": "ああ…それはそうと――",
            "zh": "啊……说起来——",
            "narrator_zh": "真幌"
        },
        {
            "location": "316/TALK",
            "narrator": "真幌",
            "text": "このことは、みんなには\n秘密にしておいてもらえ\nないか？",
            "zh": "这件事，能不能\n帮我对大家\n保密？",
            "narrator_zh": "真幌"
        },
        {
            "location": "317/TALK",
            "narrator": "つばめ",
            "text": "えっと…真幌さんが\n疲れている、って\nことですか？",
            "zh": "那个……真幌\n很累，\n这件事吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "318/TALK",
            "narrator": "真幌",
            "text": "ああ…おまえ達には、\n弱った姿を見せないよう\n心掛けているんでな。",
            "zh": "啊……对你们，\n我尽量不露出\n虚弱的样子。",
            "narrator_zh": "真幌"
        },
        {
            "location": "319/TALK",
            "narrator": "真幌",
            "text": "だから、逢瀬も今見た\n私のことは忘れてほしい。",
            "zh": "所以，逢濑也把刚才看到的我\n忘掉吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "320/TALK",
            "narrator": "つばめ",
            "text": "そんな、気にするような\nことじゃないのに…。",
            "zh": "怎么会，这又不是\n需要在意的事……。",
            "narrator_zh": "燕"
        },
        {
            "location": "321/TALK",
            "narrator": "真幌",
            "text": "教師、雇い主、そして\n隊長としておまえ達の上に\n立つ大人としての――",
            "zh": "作为老师、雇主，还有\n队长，站在你们之上的\n大人——",
            "narrator_zh": "真幌"
        },
        {
            "location": "322/TALK",
            "narrator": "真幌",
            "text": "最低限のプライドだ。\nつまらなく思えるかも\nしれんがな。",
            "zh": "最起码的自尊。\n也许你会觉得\n很无聊吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "323/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "324/TALK",
            "narrator": "真幌",
            "text": "さてと、もう一仕事すると\nするか…。",
            "zh": "那么，再干一份活\n吧……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "326/TALK",
            "narrator": "つばめ",
            "text": "…真幌さん、凄いなぁ。",
            "zh": "……真幌，好厉害呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "327/TALK",
            "narrator": "つばめ",
            "text": "凄く疲れてるのに、\n凄く無理して頑張って…。",
            "zh": "明明很累，\n还那么勉强自己努力……。",
            "narrator_zh": "燕"
        },
        {
            "location": "329/TALK",
            "narrator": "つばめ",
            "text": "…ちょっとだけでも、\n何かしてあげたいな。",
            "zh": "……哪怕一点点，\n也想为你做点什么呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "331/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "345/TALK",
            "narrator": "つばめ",
            "text": "真幌さんの肩を揉んであげようかな、って思うの",
            "zh": "我想给真幌揉揉肩膀",
            "narrator_zh": "燕"
        },
        {
            "location": "347/TALK",
            "narrator": "つばめ",
            "text": "でも、真幌さんはわたし達に、あまり弱ったところ見せたくないんだって",
            "zh": "可是真幌说，不太想让我们看到她虚弱的样子",
            "narrator_zh": "燕"
        },
        {
            "location": "348/TALK",
            "narrator": "つばめ",
            "text": "それなのに肩揉みとかしても、喜ばれないかな？",
            "zh": "这样还去揉肩膀的话，她会不高兴吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "350/SEL",
            "narrator": "",
            "text": "そんなことない、喜ぶよ",
            "zh": "不会的，她会高兴的",
            "narrator_zh": ""
        },
        {
            "location": "351/SEL",
            "narrator": "",
            "text": "真幌も年だし、絶対喜ぶよ",
            "zh": "真幌也上年纪了，绝对会高兴的",
            "narrator_zh": ""
        },
        {
            "location": "352/SEL",
            "narrator": "",
            "text": "多分、喜ばないと思う",
            "zh": "我觉得大概不会高兴",
            "narrator_zh": ""
        },
        {
            "location": "353/ACT",
            "narrator": "",
            "text": "そんなことない、喜ぶよ",
            "zh": "不会的，她会高兴的",
            "narrator_zh": ""
        },
        {
            "location": "355/TALK",
            "narrator": "つばめ",
            "text": "わかった",
            "zh": "知道了",
            "narrator_zh": "燕"
        },
        {
            "location": "356/TALK",
            "narrator": "つばめ",
            "text": "ありがと、背中押してくれて",
            "zh": "谢谢，推了我一把",
            "narrator_zh": "燕"
        },
        {
            "location": "386/TALK",
            "narrator": "つばめ",
            "text": "あの、真幌さん。",
            "zh": "那个，真幌。",
            "narrator_zh": "燕"
        },
        {
            "location": "388/TALK",
            "narrator": "真幌",
            "text": "ん？　なんだ？",
            "zh": "嗯？什么事？",
            "narrator_zh": "真幌"
        },
        {
            "location": "389/TALK",
            "narrator": "つばめ",
            "text": "真幌さん、弱ってる姿は\n見せられない、って\n言いましたよね？",
            "zh": "真幌说过，虚弱的样子\n不能给人看，\n对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "390/TALK",
            "narrator": "つばめ",
            "text": "だから、少しでも\n疲れが取れるように、\n肩揉みさせてください。",
            "zh": "所以，为了能让疲劳\n稍微消一点，\n请让我揉揉肩膀。",
            "narrator_zh": "燕"
        },
        {
            "location": "391/TALK",
            "narrator": "真幌",
            "text": "…気持ちは嬉しいが、\nおまえも忘れろと\n言ったはずだが？",
            "zh": "……心意我很高兴，\n可我不是说过\n让你忘掉吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "392/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、終わったら\n忘れます。",
            "zh": "那我揉完\n就忘掉。",
            "narrator_zh": "燕"
        },
        {
            "location": "394/TALK",
            "narrator": "真幌",
            "text": "ははっ、言うように\nなったじゃないか。",
            "zh": "哈哈，嘴倒是\n变会说了嘛。",
            "narrator_zh": "真幌"
        },
        {
            "location": "395/TALK",
            "narrator": "真幌",
            "text": "…嬉しいよ、逢瀬。\nそれじゃあお願い\nするとしよう。",
            "zh": "……我很高兴，逢濑。\n那就拜托你\n了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "396/TALK",
            "narrator": "つばめ",
            "text": "任せてください。",
            "zh": "交给我吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "397/TALK",
            "narrator": "つばめ",
            "text": "肩揉みはお父さんで\n慣れてるんです！",
            "zh": "揉肩膀我给爸爸\n揉惯了！",
            "narrator_zh": "燕"
        },
        {
            "location": "398/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "399/TALK",
            "narrator": "真幌",
            "text": "もし…。",
            "zh": "假如……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "400/TALK",
            "narrator": "つばめ",
            "text": "はい？",
            "zh": "嗯？",
            "narrator_zh": "燕"
        },
        {
            "location": "401/TALK",
            "narrator": "真幌",
            "text": "もし、私に将来、\n娘が出来るようなことが\nあれば――",
            "zh": "假如，我将来\n能有个女儿\n的话——",
            "narrator_zh": "真幌"
        },
        {
            "location": "402/TALK",
            "narrator": "真幌",
            "text": "逢瀬のような優しい娘\nだと嬉しいんだがな…。",
            "zh": "要是能有个像逢濑这样温柔的女儿\n就好了……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "403/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "404/TALK",
            "narrator": "真幌",
            "text": "いや、なんでもない。\nただの妄想だ。\n忘れてくれ。",
            "zh": "不，没什么。\n只是胡思乱想。\n忘了吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "406/TALK",
            "narrator": "つばめ",
            "text": "えへへ…嬉しいから、\nそれは無理ですよー。",
            "zh": "诶嘿嘿……因为高兴，\n这个我可忘不掉哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "407/ACT",
            "narrator": "",
            "text": "真幌も年だし、絶対喜ぶ",
            "zh": "真幌也上年纪了，绝对会高兴",
            "narrator_zh": ""
        },
        {
            "location": "408/TALK",
            "narrator": "つばめ",
            "text": "…そうだよね",
            "zh": "……说得也是呀",
            "narrator_zh": "燕"
        },
        {
            "location": "409/TALK",
            "narrator": "つばめ",
            "text": "うん、決めたよ！",
            "zh": "嗯，决定了！",
            "narrator_zh": "燕"
        },
        {
            "location": "441/TALK",
            "narrator": "つばめ",
            "text": "あの、真幌さん。",
            "zh": "那个，真幌。",
            "narrator_zh": "燕"
        },
        {
            "location": "443/TALK",
            "narrator": "真幌",
            "text": "ん？　なんだ？",
            "zh": "嗯？什么事？",
            "narrator_zh": "真幌"
        },
        {
            "location": "444/TALK",
            "narrator": "つばめ",
            "text": "真幌さん、弱ってる姿は\n見せられない、って\n言いましたよね？",
            "zh": "真幌说过，虚弱的样子\n不能给人看，\n对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "445/TALK",
            "narrator": "つばめ",
            "text": "だから、少しでも\n疲れが取れるように、\n肩揉みさせてください。",
            "zh": "所以，为了能让疲劳\n稍微消一点，\n请让我揉揉肩膀。",
            "narrator_zh": "燕"
        },
        {
            "location": "446/TALK",
            "narrator": "真幌",
            "text": "…気持ちは嬉しいが、\nおまえも忘れろと\n言ったはずだが？",
            "zh": "……心意我很高兴，\n可我不是说过\n让你忘掉吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "448/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、終わったら\n忘れます。",
            "zh": "那我揉完\n就忘掉。",
            "narrator_zh": "燕"
        },
        {
            "location": "450/TALK",
            "narrator": "真幌",
            "text": "ははっ、言うように\nなったじゃないか。",
            "zh": "哈哈，嘴倒是\n变会说了嘛。",
            "narrator_zh": "真幌"
        },
        {
            "location": "451/TALK",
            "narrator": "つばめ",
            "text": "それに、真幌さんも\n年なんだから――",
            "zh": "而且，真幌也\n上年纪了——",
            "narrator_zh": "燕"
        },
        {
            "location": "452/TALK",
            "narrator": "つばめ",
            "text": "あまり無理し過ぎちゃ\nダメですよ。",
            "zh": "不要太勉强\n自己哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "455/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "457/TALK",
            "narrator": "つばめ",
            "text": "…真幌さん？",
            "zh": "……真幌？",
            "narrator_zh": "燕"
        },
        {
            "location": "459/TALK",
            "narrator": "真幌",
            "text": "なあ、逢瀬。\n一つ聞きたいんだが――",
            "zh": "呐，逢濑。\n有件事想问你——",
            "narrator_zh": "真幌"
        },
        {
            "location": "461/TALK",
            "narrator": "真幌",
            "text": "おまえ、私の年齢を\nいくつだと思っている？",
            "zh": "你觉得我\n几岁？",
            "narrator_zh": "真幌"
        },
        {
            "location": "462/TALK",
            "narrator": "つばめ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "463/TALK",
            "narrator": "つばめ",
            "text": "そ、そういえば、\n真幌さんって\n何歳なんだろ？",
            "zh": "那、说起来，\n真幌\n到底几岁呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "464/TALK",
            "narrator": "つばめ",
            "text": "年だし、って言われて、\n勝手にもういい年だと\n思っちゃってたけど――",
            "zh": "被说上了年纪，\n我就自作主张觉得\n已经不年轻了——",
            "narrator_zh": "燕"
        },
        {
            "location": "465/TALK",
            "narrator": "つばめ",
            "text": "二十代後半…いってたと\nしても三十代前半？",
            "zh": "二十多岁后半……就算再\n往上也就是三十出头？",
            "narrator_zh": "燕"
        },
        {
            "location": "467/TALK",
            "narrator": "真幌",
            "text": "どうした、逢瀬？\n私はそんなに難しい\n質問をしたか？",
            "zh": "怎么了，逢濑？\n我问了那么\n难的问题吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "468/TALK",
            "narrator": "つばめ",
            "text": "え、えーっとぉ…。",
            "zh": "诶、那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "470/TALK",
            "narrator": "つばめ",
            "text": "そ、そうだ！",
            "zh": "对、对了！",
            "narrator_zh": "燕"
        },
        {
            "location": "472/TALK",
            "narrator": "つばめ",
            "text": "一緒に、背中の\nマッサージも\nどうですか？",
            "zh": "要不要，后背\n也一起\n按摩呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "473/TALK",
            "narrator": "真幌",
            "text": "それはありがたい。\n頼むとしよう。",
            "zh": "那可帮大忙了。\n就拜托你了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "474/TALK",
            "narrator": "つばめ",
            "text": "はい、\n任せてください！",
            "zh": "好的，\n交给我吧！",
            "narrator_zh": "燕"
        },
        {
            "location": "476/TALK",
            "narrator": "真幌",
            "text": "ああ。",
            "zh": "啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "480/TALK",
            "narrator": "真幌",
            "text": "…それで？\n私をいくつだと\n思っているんだ？",
            "zh": "……然后呢？\n你觉得我\n几岁？",
            "narrator_zh": "真幌"
        },
        {
            "location": "482/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "483/TALK",
            "narrator": "真幌",
            "text": "言っておくが、\n質問に答えるまで\n逃がさんぞ？",
            "zh": "先说好，\n不回答这个问题\n我可不放你走。",
            "narrator_zh": "真幌"
        },
        {
            "location": "485/TALK",
            "narrator": "つばめ",
            "text": "…弱って見えたの、\n勘違いだったのかな？",
            "zh": "……看起来虚弱，\n是我看错了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "486/ACT",
            "narrator": "",
            "text": "多分、喜ばないと思う",
            "zh": "我觉得大概不会高兴",
            "narrator_zh": ""
        },
        {
            "location": "487/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、やめた方が良いかな？",
            "zh": "果然还是算了比较好吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "488/TALK",
            "narrator": "つばめ",
            "text": "弱った姿を見せたくない、って言ってるんだし…",
            "zh": "她都说不想让人看到虚弱的样子了……",
            "narrator_zh": "燕"
        },
        {
            "location": "500/TALK",
            "narrator": "つばめ",
            "text": "…じゃあ、そろそろ仕事に\n戻りますね。",
            "zh": "……那我这就回去\n工作了。",
            "narrator_zh": "燕"
        },
        {
            "location": "502/TALK",
            "narrator": "真幌",
            "text": "ああ、引き続き頼んだぞ。",
            "zh": "啊，接下来也拜托了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "503/TALK",
            "narrator": "つばめ",
            "text": "はい！",
            "zh": "好！",
            "narrator_zh": "燕"
        },
        {
            "location": "506/TALK",
            "narrator": "つばめ",
            "text": "真幌さんを見習って、\nわたしはわたしの仕事を\n頑張ろう！",
            "zh": "我要向真幌学习，\n做好我自己的\n工作！",
            "narrator_zh": "燕"
        },
        {
            "location": "284/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月15日　5:11 PM</color>\n転校して1週間後、神楽坂トライナリーのバイト中にて。",
            "zh": "<color=green>5月15日　5:11 PM</color>\n转学一周后，在神乐坂三重奏打工的时候。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
