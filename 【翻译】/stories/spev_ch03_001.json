{
    "dir": "chap00/daydra/spev_ch03_001.js",
    "type": "",
    "info": {
        "story_id": "3001",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "ガブリエラの日常",
        "title_zh": "特别篇",
        "sub_title_zh": "加布里埃拉的日常"
    },
    "entry": [
        {
            "location": "21/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ん～、これいいなぁ。",
            "zh": "嗯～，这个不错呀。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "22/TALK",
            "narrator": "透明ガブリエラ",
            "text": "でも、ちょっと\nお値段張るのが\n気になるかも…。",
            "zh": "不过，价格稍微\n有点贵，这点\n让人有点在意……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "23/TALK",
            "narrator": "透明ガブリエラ",
            "text": "端数の３００円が\nなければなぁ…。",
            "zh": "要是没有零头那300日元\n就好了……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "25/TALK",
            "narrator": "透明アーヤ",
            "text": "…真剣に見てるわね。",
            "zh": "……看得真认真。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "透明ガブリエラ",
            "text": "え…あ、アーヤ！？\nどうしてここに\nいるの！？",
            "zh": "诶……啊、绫水！？\n你怎么会\n在这里！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "30/TALK",
            "narrator": "透明アーヤ",
            "text": "ツーリングがてら、\nちょっと浅草見物でも\nしようと思ってね。",
            "zh": "出来骑车兜风，\n顺便想着来浅草\n逛逛看。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "透明アーヤ",
            "text": "まさか、ギャヴィに\n会えるとは思わな\nかったけど。",
            "zh": "倒没想到\n能在这里\n碰到加维。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そ、そうね…。\n浅草も広いし。",
            "zh": "是、是啊……\n浅草也挺大的嘛。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "透明アーヤ",
            "text": "うん…ところで――",
            "zh": "嗯……不过——",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "透明アーヤ",
            "text": "その手に持ってる\n変なこけし、何？",
            "zh": "你手里拿着的那个\n奇怪木芥子，是什么？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "透明ガブリエラ",
            "text": "どこが変なのよ？\nとっても可愛い\nでしょ？",
            "zh": "哪里奇怪了？\n明明特别可爱\n不是吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "透明アーヤ",
            "text": "でも、顔つきがその、\nちょっとスケベっぽい\nような…。",
            "zh": "可是，那张脸怎么说，\n总觉得有点\n色眯眯的……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "透明アーヤ",
            "text": "あ、ほらそっちの。\n女の子の顔してるのが\n可愛いと思うけど？",
            "zh": "啊，你看那边那个。\n长着女孩子脸蛋的，\n我觉得才可爱吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "41/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ここにあるこけし、\n全部女の子よ？",
            "zh": "这里的木芥子，\n全都是女孩子好吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "透明アーヤ",
            "text": "そっちのよ、ほら。\nおかっぱ頭で\n口紅が付いてる――",
            "zh": "是那边那个，你看。\n留着娃娃头\n还涂了口红的——",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "透明ガブリエラ",
            "text": "沢山あり過ぎて\nわからないから。",
            "zh": "摆了这么多，\n根本分不清你说哪个。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "透明ガブリエラ",
            "text": "っていうか、\nあたしの趣味の\n時間を邪魔しないで！",
            "zh": "再说了，\n别来打扰我\n享受爱好的时间！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "透明アーヤ",
            "text": "はいはい…。\nあ、私も向こうの\nお店見てくるわ。",
            "zh": "好好好……\n啊，我也去那边\n店里看看好了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "51/TALK",
            "narrator": "透明ガブリエラ",
            "text": "まったく…。",
            "zh": "真是的……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤはダメよね",
            "zh": "绫水真是没救了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "こけしの可愛さがわからないんだもの",
            "zh": "根本不懂木芥子的可爱之处嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "スケベっぽいだなんて失礼だわ",
            "zh": "居然说什么像色眯眯的，太失礼了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナはどう思う？",
            "zh": "玛尔赞娜觉得呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "57/SEL",
            "narrator": "（選択肢）",
            "text": "そういう顔のも実際あるよ",
            "zh": "其实还真有那种长相的哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "58/SEL",
            "narrator": "（選択肢）",
            "text": "それが可愛いんだよね",
            "zh": "就是那样才可爱嘛",
            "narrator_zh": "（选项）"
        },
        {
            "location": "59/SEL",
            "narrator": "（選択肢）",
            "text": "ガブリエラの顔の方が可愛い",
            "zh": "还是加布里埃拉的脸更可爱",
            "narrator_zh": "（选项）"
        },
        {
            "location": "60/ACT",
            "narrator": "",
            "text": "そういう顔のも実際あるよ",
            "zh": "其实还真有那种长相的哦",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "でもこれは違うわよ",
            "zh": "但这个不是好不好",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "見方によってはそう見えるかもしれないけれど",
            "zh": "虽然从某些角度看过去，说不定是有点像",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "これはそういうのとは違うのよ",
            "zh": "但这个和那种根本不一样",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "沢山こけしを見てきた私が言うんだから",
            "zh": "这可是看过无数木芥子的我说的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "間違いないわ",
            "zh": "绝对没错",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/ACT",
            "narrator": "",
            "text": "それが可愛いんだよね",
            "zh": "就是那样才可爱嘛",
            "narrator_zh": ""
        },
        {
            "location": "69/TALK",
            "narrator": "ガブリエラ",
            "text": "そう言ってくれると信じていたわ",
            "zh": "我就相信你会这么说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "色んな表情の子がいるのが魅力的なのよね",
            "zh": "有各种各样表情的孩子，这才是魅力所在嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "71/TALK",
            "narrator": "ガブリエラ",
            "text": "それがわかるなんて",
            "zh": "连这都能懂",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "さすがは私の使用人ね",
            "zh": "不愧是我的佣人",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/SEL",
            "narrator": "（選択肢）",
            "text": "お褒めに預かり光栄です",
            "zh": "承蒙夸奖，不胜荣幸",
            "narrator_zh": "（选项）"
        },
        {
            "location": "77/ACT",
            "narrator": "",
            "text": "お褒めに預かり光栄です",
            "zh": "承蒙夸奖，不胜荣幸",
            "narrator_zh": ""
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "うんうん、いいこいいこ",
            "zh": "嗯嗯，乖孩子乖孩子",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/ACT",
            "narrator": "",
            "text": "ガブリエラの顔の方が可愛い",
            "zh": "还是加布里埃拉的脸更可爱",
            "narrator_zh": ""
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "こけしの顔と比べられるのは",
            "zh": "拿来跟木芥子的脸比什么的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "さすがに反応に困るわね",
            "zh": "这实在让人不知道该怎么接话呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナは褒めるのが下手なのかしら？",
            "zh": "玛尔赞娜是不是不太会夸人啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "でも許してあげるわよ",
            "zh": "不过就原谅你好了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "気持ちだけは伝わったし",
            "zh": "毕竟你的心意我还是收到了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "でも何だかモヤモヤするわね",
            "zh": "不过总觉得心里有点膈应呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤがあんな変なこと言うから",
            "zh": "都怪绫水说出那种奇怪的话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな風に見えてきちゃった感じするわね",
            "zh": "害我都觉得好像越看越像了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん・・・",
            "zh": "唔——……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり買うのやめようかしら？",
            "zh": "要不还是别买了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/SEL",
            "narrator": "（選択肢）",
            "text": "気になってたなら買うべき",
            "zh": "既然在意就该买下来",
            "narrator_zh": "（选项）"
        },
        {
            "location": "99/SEL",
            "narrator": "（選択肢）",
            "text": "色んな顔の子がいた方が楽しい",
            "zh": "有各种长相的孩子才更有意思",
            "narrator_zh": "（选项）"
        },
        {
            "location": "100/SEL",
            "narrator": "（選択肢）",
            "text": "やめた方が良い気がするなぁ",
            "zh": "我感觉还是别买比较好呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "101/ACT",
            "narrator": "",
            "text": "気になったなら買うべき",
            "zh": "既然在意就该买下来",
            "narrator_zh": ""
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね",
            "zh": "说得也是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "決めたわマルザンナ",
            "zh": "我决定了，玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりこの子買ってくるわね",
            "zh": "果然我还是去把这孩子买下来吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/SEL",
            "narrator": "（選択肢）",
            "text": "それがいいと思うよ",
            "zh": "我觉得这样很好哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "107/ACT",
            "narrator": "",
            "text": "それがいいと思うよ",
            "zh": "我觉得这样很好哦",
            "narrator_zh": ""
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "そう思うわよね？",
            "zh": "你也这么觉得对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "それにもしそんな理由で買わなかったら",
            "zh": "而且要是因为那种理由不买的话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "この子が可哀そうだものね",
            "zh": "这孩子也太可怜了嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "背中を押してくれてありがと",
            "zh": "谢谢你推了我一把",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃあ買ってくるわね",
            "zh": "那我去买了哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/ACT",
            "narrator": "",
            "text": "色んな顔の子がいた方が楽しい",
            "zh": "有各种长相的孩子才更有意思",
            "narrator_zh": ""
        },
        {
            "location": "118/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなのよ！",
            "zh": "就是说啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "素晴らしいわマルザンナ！",
            "zh": "说得太好了，玛尔赞娜！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/TALK",
            "narrator": "ガブリエラ",
            "text": "こけしは色んな子がいるから、表情はその子の個性だと思うのよ",
            "zh": "正因为木芥子有各种各样的孩子，我觉得表情就是那孩子的个性哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "121/SEL",
            "narrator": "（選択肢）",
            "text": "同感だね",
            "zh": "我也有同感",
            "narrator_zh": "（选项）"
        },
        {
            "location": "122/ACT",
            "narrator": "",
            "text": "同感だね",
            "zh": "我也有同感",
            "narrator_zh": ""
        },
        {
            "location": "124/TALK",
            "narrator": "ガブリエラ",
            "text": "気が合って嬉しいわ",
            "zh": "能这么合拍真开心",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "それと",
            "zh": "还有",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "こけしのことを『子』って言ってくれたのも",
            "zh": "你把木芥子叫做“孩子”这一点也是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "私ね",
            "zh": "我呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "こけしってお人形と同じ感覚で見てるから",
            "zh": "平时看木芥子，都是用和看人偶一样的心情去看待的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "131/TALK",
            "narrator": "ガブリエラ",
            "text": "この子、とか、あの子、って言っちゃうのよ",
            "zh": "所以总会忍不住叫“这孩子”啊、“那孩子”啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、マルザンナにもそう言ってもらえたのが",
            "zh": "所以，连玛尔赞娜也能这么称呼它们",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと嬉しかったわ",
            "zh": "让我觉得有点开心",
            "narrator_zh": "加布里埃拉"
        },
        {
