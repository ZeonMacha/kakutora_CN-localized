{
    "dir": "chap00/daydra/spev_ch01_004.js",
    "type": "",
    "info": {
        "story_id": "1004",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "包んだのは愛情？",
        "title_zh": "特别篇",
        "sub_title_zh": "包进去的是爱？"
    },
    "entry": [
        {
            "location": "18/TALK",
            "narrator": "透明つばめ",
            "text": "お待たせー。\n出来立てアツアツだよー。",
            "zh": "让你久等啦。\n刚出锅，热乎乎的哦。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "19/SEL",
            "narrator": "（選択肢）",
            "text": "待ってました！",
            "zh": "等好久了！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "20/ACT",
            "narrator": "",
            "text": "待ってました！",
            "zh": "等好久了！",
            "narrator_zh": ""
        },
        {
            "location": "22/TALK",
            "narrator": "透明つばめ",
            "text": "ごめんね。\nお料理得意じゃないから、\n時間かかっちゃって…。",
            "zh": "对不起。\n我不擅长做饭，\n花了不少时间……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "23/TALK",
            "narrator": "透明つばめ",
            "text": "でも、レシピ通りに\n作れたはずだから、\nきっと美味しいよ。",
            "zh": "不过，应该是\n按菜谱做的，\n一定好吃。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "24/SEL",
            "narrator": "（選択肢）",
            "text": "なら安心だ",
            "zh": "那我就放心了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "25/SEL",
            "narrator": "（選択肢）",
            "text": "作ってもらえて嬉しいよ",
            "zh": "能吃到你做的，我很高兴",
            "narrator_zh": "（选项）"
        },
        {
            "location": "26/ACT",
            "narrator": "",
            "text": "なら安心だ",
            "zh": "那我就放心了",
            "narrator_zh": ""
        },
        {
            "location": "27/TALK",
            "narrator": "透明つばめ",
            "text": "誰でも簡単に作れて、\n失敗しないって\n書いてあったの。",
            "zh": "上面写着，\n谁都能轻松做，\n不会失败。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "28/TALK",
            "narrator": "透明つばめ",
            "text": "料理下手なわたしには\nありがたいレシピだよ。",
            "zh": "对我这种做饭很差的人，\n真是太好的菜谱。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "29/ACT",
            "narrator": "",
            "text": "作ってもらえて嬉しいよ",
            "zh": "能吃到你做的，我很高兴",
            "narrator_zh": ""
        },
        {
            "location": "30/TALK",
            "narrator": "透明つばめ",
            "text": "ありがとう。",
            "zh": "谢谢。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "31/TALK",
            "narrator": "透明つばめ",
            "text": "そう言ってもらえるなら、\n作ってよかったぁ。",
            "zh": "你这么说的话，\n做了真好。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "33/TALK",
            "narrator": "透明つばめ",
            "text": "じゃあ、温かいうちに\n食べて――",
            "zh": "那就趁热\n吃吧——",
            "narrator_zh": "透明燕"
        },
        {
            "location": "35/TALK",
            "narrator": "透明つばめ",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "透明燕"
        },
        {
            "location": "36/SEL",
            "narrator": "（選択肢）",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "37/ACT",
            "narrator": "",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "40/TALK",
            "narrator": "透明つばめ",
            "text": "あ、うん…。\nちょっと、思ったの。",
            "zh": "啊，嗯……\n我刚想了一下。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "42/TALK",
            "narrator": "透明つばめ",
            "text": "デート…なんだから、\nただ食べてもらうだけは、\nつまらないかな、って…。",
            "zh": "这是约会……\n只是让你吃，\n会不会太没意思……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "43/SEL",
            "narrator": "（選択肢）",
            "text": "そ、それはまさか…",
            "zh": "该、该不会是……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "44/ACT",
            "narrator": "",
            "text": "そ、それはまさか…",
            "zh": "该、该不会是……",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "透明つばめ",
            "text": "えへへ…わたしが\n食べさせてあげるね。",
            "zh": "诶嘿嘿……我\n喂你吃吧。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "48/TALK",
            "narrator": "透明つばめ",
            "text": "それじゃ…あーんして。",
            "zh": "那就……啊——。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "49/SEL",
            "narrator": "（選択肢）",
            "text": "あ、あーん！",
            "zh": "啊、啊——！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "50/SEL",
            "narrator": "（選択肢）",
            "text": "い、いや～ん！",
            "zh": "不、不要呀！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "51/ACT",
            "narrator": "",
            "text": "あ、あーん！",
            "zh": "啊、啊——！",
            "narrator_zh": ""
        },
        {
            "location": "53/TALK",
            "narrator": "透明つばめ",
            "text": "あっ、$handle$さん、\nもしかして照れてる？",
            "zh": "啊，$handle$，\n你该不会是在害羞？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "54/TALK",
            "narrator": "透明つばめ",
            "text": "ちょっと可愛いとこ\n見ちゃった…えへへ…。",
            "zh": "看到了一点点\n可爱的地方……诶嘿嘿……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "55/SEL",
            "narrator": "（選択肢）",
            "text": "は、早く食べさせて！",
            "zh": "快、快喂我！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "56/ACT",
            "narrator": "",
            "text": "は、早く食べさせて！",
            "zh": "快、快喂我！",
            "narrator_zh": ""
        },
        {
            "location": "58/TALK",
            "narrator": "透明つばめ",
            "text": "ふふっ、ごめんね。\nそれじゃもう一度、\nあーん…。",
            "zh": "呵呵，对不起。\n那就再来一次，\n啊——……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "60/ACT",
            "narrator": "",
            "text": "い、いや～ん！",
            "zh": "不、不要呀！",
            "narrator_zh": ""
        },
        {
            "location": "62/TALK",
            "narrator": "透明つばめ",
            "text": "わっ、ビックリしたぁ…。",
            "zh": "哇，吓我一跳……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "64/TALK",
            "narrator": "透明つばめ",
            "text": "もう、急にそういうこと\nしたらダメだよ。",
            "zh": "真是的，不能\n突然那样呀。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "65/SEL",
            "narrator": "（選択肢）",
            "text": "ごめん、照れちゃって",
            "zh": "对不起，我害羞了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "66/ACT",
            "narrator": "",
            "text": "ごめん、照れちゃって",
            "zh": "对不起，我害羞了",
            "narrator_zh": ""
        },
        {
            "location": "68/TALK",
            "narrator": "透明つばめ",
            "text": "えっ？　$handle$さんも\n照れたりするの？",
            "zh": "诶？　$handle$\n也会害羞吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "70/TALK",
            "narrator": "透明つばめ",
            "text": "ふふっ、そっかぁ…。\nちょっと珍しい姿\n見れたかも。",
            "zh": "呵呵，这样啊……\n也许看到了\n很少见的样子。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "71/TALK",
            "narrator": "透明つばめ",
            "text": "でも、わたしも\n恥ずかしいんだから、\nもうやっちゃダメだよ？",
            "zh": "可是我也很\n害羞的，\n不能再这样了哦？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "72/TALK",
            "narrator": "透明つばめ",
            "text": "それじゃ、もう一度…、\nあーん…。",
            "zh": "那就再来一次……\n啊——……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "80/TALK",
            "narrator": "透明つばめ",
            "text": "っと、あれ？",
            "zh": "咦，奇怪？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "81/TALK",
            "narrator": "透明つばめ",
            "text": "ごめんごめん。\nちょっと、口の場所\nズレちゃったね…。",
            "zh": "对不起对不起。\n嘴的位置\n有点偏了……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "82/TALK",
            "narrator": "透明つばめ",
            "text": "次は間違えないように、\nよーく狙ってー…。",
            "zh": "下次别再偏了，\n好好瞄准——……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "83/SEL",
            "narrator": "（選択肢）",
            "text": "も、もう少し優しく！",
            "zh": "再、再温柔一点！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "84/ACT",
            "narrator": "",
            "text": "も、もう少し優しく！",
            "zh": "再、再温柔一点！",
            "narrator_zh": ""
        },
        {
            "location": "86/TALK",
            "narrator": "透明つばめ",
            "text": "あああ、そ、そうだよね！",
            "zh": "啊啊啊，对、对哦！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "87/TALK",
            "narrator": "透明つばめ",
            "text": "ごめんなさい…。\nわたしも、ちょっと\n緊張してるかも…。",
            "zh": "对不起……\n我好像也有点\n紧张……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "90/TALK",
            "narrator": "透明つばめ",
            "text": "…あれ？",
            "zh": "……咦？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "92/TALK",
            "narrator": "透明つばめ",
            "text": "あぁっ！！\nごめんなさい、\n落としちゃった！",
            "zh": "啊啊！！\n对不起，\n掉下去了！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "93/TALK",
            "narrator": "透明つばめ",
            "text": "大丈夫？\n火傷とかしてない？",
            "zh": "没事吧？\n没烫伤吧？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "94/SEL",
            "narrator": "（選択肢）",
            "text": "平気だよ",
            "zh": "没事的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "95/SEL",
            "narrator": "（選択肢）",
            "text": "つばめは平気！？",
            "zh": "燕没事吧！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "96/ACT",
            "narrator": "",
            "text": "平気だよ",
            "zh": "没事的",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "透明つばめ",
            "text": "よかったぁ…。",
            "zh": "太好了……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "99/TALK",
            "narrator": "透明つばめ",
            "text": "ごめんね。\nわたし、ちょっと\n落ち着かないと…。",
            "zh": "对不起。\n我得稍微\n冷静一下……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "100/ACT",
            "narrator": "",
            "text": "つばめは平気！？",
            "zh": "燕没事吧！？",
            "narrator_zh": ""
        },
        {
            "location": "101/TALK",
            "narrator": "透明つばめ",
            "text": "う、うん。\nわたしは平気だよ。",
            "zh": "嗯、嗯。\n我没事的。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "102/TALK",
            "narrator": "透明つばめ",
            "text": "でも…ごめんなさい。\nあーん、もちゃんと\nできなくて…。",
            "zh": "可是……对不起。\n啊——也没能\n好好做到……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "103/SEL",
            "narrator": "（選択肢）",
            "text": "何度でも喜んで付き合うよ",
            "zh": "我很乐意陪你多少次",
            "narrator_zh": "（选项）"
        },
        {
            "location": "104/ACT",
            "narrator": "",
            "text": "何度でも喜んで付き合うよ",
            "zh": "我很乐意陪你多少次",
            "narrator_zh": ""
        },
        {
            "location": "106/TALK",
            "narrator": "透明つばめ",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "透明燕"
        },
        {
            "location": "107/TALK",
            "narrator": "透明つばめ",
            "text": "うん…。わたしも、\n$handle$さんのためなら、\n何度だってするよ。",
            "zh": "嗯……我也会，\n只要是为了$handle$，\n多少次都会做。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "110/TALK",
            "narrator": "透明つばめ",
            "text": "それじゃ、気を取り直して\nもう一回…。",
            "zh": "那就重新打起精神，\n再来一次……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "112/TALK",
            "narrator": "透明つばめ",
            "text": "あーん…。",
            "zh": "啊——……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "125/SEL",
            "narrator": "（選択肢）",
            "text": "こんなデートをしたいんだ！",
            "zh": "我想要这样的约会！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "126/ACT",
            "narrator": "",
            "text": "こんなデートをしたいんだ！",
            "zh": "我想要这样的约会！",
            "narrator_zh": ""
        },
        {
            "location": "128/TALK",
            "narrator": "つばめ",
            "text": "楽しそぅだね(≧ω≦)",
            "zh": "听起来很好玩呀(≧ω≦)",
            "narrator_zh": "燕"
        },
        {
            "location": "129/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "燕"
        },
        {
            "location": "130/TALK",
            "narrator": "つばめ",
            "text": "ぉ料理が心配かも(･Д･｀)",
            "zh": "做饭有点让人担心(･Д･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "132/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんは",
            "zh": "$handle$",
            "narrator_zh": "燕"
        },
        {
            "location": "133/TALK",
            "narrator": "つばめ",
            "text": "今の話のつづき",
            "zh": "刚才那件事的后续",
            "narrator_zh": "燕"
        },
        {
            "location": "134/TALK",
            "narrator": "つばめ",
            "text": "ぉ料理",
            "zh": "菜",
            "narrator_zh": "燕"
        },
        {
            "location": "135/TALK",
            "narrator": "つばめ",
            "text": "美味しくできたと思ぅ？(´･ω･｀) ",
            "zh": "你觉得好吃吗？(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "137/SEL",
            "narrator": "（選択肢）",
            "text": "もちろんだよ、期待してる",
            "zh": "当然啦，我很期待",
            "narrator_zh": "（选项）"
        },
        {
            "location": "138/SEL",
            "narrator": "（選択肢）",
            "text": "作ってくれることが嬉しい",
            "zh": "你愿意做，我就很高兴",
            "narrator_zh": "（选项）"
        },
        {
            "location": "139/ACT",
            "narrator": "",
            "text": "もちろんだよ、期待してる",
            "zh": "当然啦，我很期待",
            "narrator_zh": ""
        },
        {
            "location": "140/TALK",
            "narrator": "つばめ",
            "text": "期待されちゃってるヾ(｡>﹏<｡)ﾉﾞ",
            "zh": "被期待了ヾ(｡>﹏<｡)ﾉﾞ",
            "narrator_zh": "燕"
        },
        {
            "location": "141/TALK",
            "narrator": "つばめ",
            "text": "じゃぁ",
            "zh": "那",
            "narrator_zh": "燕"
        },
        {
            "location": "142/TALK",
            "narrator": "つばめ",
            "text": "本当のデートする日のために",
            "zh": "为了真正约会的那天",
            "narrator_zh": "燕"
        },
        {
            "location": "143/TALK",
            "narrator": "つばめ",
            "text": "練習してぉくね(๑･ㅂ･)و☆",
            "zh": "我会先练习的(๑･ㅂ･)و☆",
            "narrator_zh": "燕"
        },
        {
            "location": "144/ACT",
            "narrator": "",
            "text": "作ってくれることが嬉しい",
            "zh": "你愿意做，我就很高兴",
            "narrator_zh": ""
        },
        {
            "location": "145/TALK",
            "narrator": "つばめ",
            "text": "嬉しぃけど",
            "zh": "虽然高兴",
            "narrator_zh": "燕"
        },
        {
            "location": "147/TALK",
            "narrator": "つばめ",
            "text": "できれば",
            "zh": "可以的话",
            "narrator_zh": "燕"
        },
        {
            "location": "148/TALK",
            "narrator": "つばめ",
            "text": "美味しくできたと思ぅって",
            "zh": "还是想听你说",
            "narrator_zh": "燕"
        },
        {
            "location": "149/TALK",
            "narrator": "つばめ",
            "text": "言ってほしかったなぁ(o´Д`)=з",
            "zh": "觉得好吃呀(o´Д`)=з",
            "narrator_zh": "燕"
        }
    ]
}
