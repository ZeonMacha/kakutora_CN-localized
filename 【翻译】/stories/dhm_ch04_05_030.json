            "narrator_zh": "雅"
        },
        {
            "location": "270/SEL",
            "narrator": "",
            "text": "$me$、必要なかったね",
            "zh": "$me$，其实没必要吧",
            "narrator_zh": ""
        },
        {
            "location": "271/SEL",
            "narrator": "",
            "text": "あれでよかったの？",
            "zh": "那样真的好吗？",
            "narrator_zh": ""
        },
        {
            "location": "272/SEL",
            "narrator": "",
            "text": "どうしてチョコだったの？",
            "zh": "为什么是巧克力？",
            "narrator_zh": ""
        },
        {
            "location": "273/ACT",
            "narrator": "",
            "text": "$me$、必要なかったね",
            "zh": "$me$，其实没必要吧",
            "narrator_zh": ""
        },
        {
            "location": "283/TALK",
            "narrator": "みやび",
            "text": "何を言う",
            "zh": "说什么呢",
            "narrator_zh": "雅"
        },
        {
            "location": "285/TALK",
            "narrator": "みやび",
            "text": "$handle$がいなければガブちゃんに話しかけるのはミッション・インポッシブル",
            "zh": "没有$handle$的话，跟加布搭话就是“不可能的任务”",
            "narrator_zh": "雅"
        },
        {
            "location": "286/TALK",
            "narrator": "みやび",
            "text": "なんて",
            "zh": "什么的",
            "narrator_zh": "雅"
        },
        {
            "location": "287/TALK",
            "narrator": "みやび",
            "text": "それは言い過ぎだが",
            "zh": "这话讲过头了",
            "narrator_zh": "雅"
        },
        {
            "location": "288/TALK",
            "narrator": "みやび",
            "text": "心強かったのは事実だ",
            "zh": "但让人安心是事实",
            "narrator_zh": "雅"
        },
        {
            "location": "289/TALK",
            "narrator": "みやび",
            "text": "相棒よ",
            "zh": "搭档啊",
            "narrator_zh": "雅"
        },
        {
            "location": "290/ACT",
            "narrator": "",
            "text": "あれでよかったの？",
            "zh": "那样真的好吗？",
            "narrator_zh": ""
        },
        {
            "location": "291/TALK",
            "narrator": "みやび",
            "text": "当然だ",
            "zh": "当然",
            "narrator_zh": "雅"
        },
        {
            "location": "292/TALK",
            "narrator": "みやび",
            "text": "言いたくないことがある人間に無理にしゃべらせるなど",
            "zh": "硬逼着有难言之隐的人开口之类的事",
            "narrator_zh": "雅"
        },
        {
            "location": "293/TALK",
            "narrator": "みやび",
            "text": "道理に反する",
            "zh": "有违道理",
            "narrator_zh": "雅"
        },
        {
            "location": "294/TALK",
            "narrator": "みやび",
            "text": "しかしな",
            "zh": "不过啊",
            "narrator_zh": "雅"
        },
        {
            "location": "295/TALK",
            "narrator": "みやび",
            "text": "側に人がいるというのは心強い",
            "zh": "身边有人就是让人安心",
            "narrator_zh": "雅"
        },
        {
            "location": "296/TALK",
            "narrator": "みやび",
            "text": "機微を読め",
            "zh": "给我学会察言观色",
            "narrator_zh": "雅"
        },
        {
            "location": "297/ACT",
            "narrator": "",
            "text": "どうしてチョコだったの？",
            "zh": "为什么是巧克力？",
            "narrator_zh": ""
        },
        {
            "location": "298/TALK",
            "narrator": "みやび",
            "text": "糖度が高い",
            "zh": "糖度高",
            "narrator_zh": "雅"
        },
        {
            "location": "299/TALK",
            "narrator": "みやび",
            "text": "即ち",
            "zh": "也就是说",
            "narrator_zh": "雅"
        },
        {
            "location": "300/TALK",
            "narrator": "みやび",
            "text": "元気の素になる",
            "zh": "能变成活力的源泉",
            "narrator_zh": "雅"
        },
        {
            "location": "301/TALK",
            "narrator": "みやび",
            "text": "少なくともうちはそうぞね",
            "zh": "至少我是这样咧",
            "narrator_zh": "雅"
        },
        {
            "location": "302/TALK",
            "narrator": "みやび",
            "text": "女子を口説く気が少しでもあるなら",
            "zh": "只要还有一丁点想追女孩子的意思",
            "narrator_zh": "雅"
        },
        {
            "location": "303/TALK",
            "narrator": "みやび",
            "text": "知っておけ",
            "zh": "就给我记好了",
            "narrator_zh": "雅"
