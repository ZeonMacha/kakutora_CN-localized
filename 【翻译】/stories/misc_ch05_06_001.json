            "narrator_zh": ""
        },
        {
            "location": "580/TALK",
            "narrator": "神楽",
            "text": "何か引き気味？",
            "zh": "怎么，退缩了？",
            "narrator_zh": "神乐"
        },
        {
            "location": "581/ACT",
            "narrator": "",
            "text": "ぴょんこ先生一生付いていきます！",
            "zh": "蹦子老师，我跟你一辈子！",
            "narrator_zh": ""
        },
        {
            "location": "583/TALK",
            "narrator": "神楽",
            "text": "よしよし",
            "zh": "好了好了",
            "narrator_zh": "神乐"
        },
        {
            "location": "584/TALK",
            "narrator": "神楽",
            "text": "$handlek$はその身を一生ぴょんこに捧げると誓うのね♪",
            "zh": "$handlek$是发誓把这身子献给蹦子一辈子了呢♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "585/TALK",
            "narrator": "神楽",
            "text": "いいよー全然いいよー",
            "zh": "可以哦，完全可以哦",
            "narrator_zh": "神乐"
        },
        {
            "location": "586/ACT",
            "narrator": "",
            "text": "あざとすぎる気もするけど",
            "zh": "也有点太会了吧",
            "narrator_zh": ""
        },
        {
            "location": "587/TALK",
            "narrator": "神楽",
            "text": "そんなのあたりまえ",
            "zh": "那不是理所当然",
            "narrator_zh": "神乐"
        },
        {
            "location": "588/TALK",
            "narrator": "神楽",
            "text": "こちとら評価が欲しいんじゃ",
