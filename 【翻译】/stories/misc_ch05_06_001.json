            "narrator_zh": "神乐"
        },
        {
            "location": "590/TALK",
            "narrator": "神楽",
            "text": "そんなぴょんこ先生",
            "zh": "那种蹦子老师",
            "narrator_zh": "神乐"
        },
        {
            "location": "591/TALK",
            "narrator": "神楽",
            "text": "こう見えても覆面作家なのでイベントには不参加にならざるを得ない",
            "zh": "别看我这样，我是蒙面作家，活动只能不参加",
            "narrator_zh": "神乐"
        },
        {
            "location": "592/TALK",
            "narrator": "神楽",
            "text": "それだけが悩みの種",
            "zh": "只有这件事是烦恼的根源",
            "narrator_zh": "神乐"
        },
        {
            "location": "594/SEL",
            "narrator": "",
            "text": "この人本気だよ",
            "zh": "这人是认真的",
            "narrator_zh": ""
        },
        {
            "location": "595/SEL",
            "narrator": "",
            "text": "お、おう…",
            "zh": "哦、哦……",
            "narrator_zh": ""
        },
        {
            "location": "596/SEL",
            "narrator": "",
            "text": "代わりに売ってきてあげる",
            "zh": "我替你去卖",
            "narrator_zh": ""
        },
        {
            "location": "597/ACT",
            "narrator": "",
            "text": "この人本気だよ",
            "zh": "这人是认真的",
            "narrator_zh": ""
        },
        {
            "location": "598/TALK",
            "narrator": "神楽",
            "text": "ですよ？",
            "zh": "对吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "599/TALK",
            "narrator": "神楽",
            "text": "本気なんですからね！",
            "zh": "我是认真的啊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "600/ACT",
            "narrator": "",
            "text": "お、おう…",
            "zh": "哦、哦……",
            "narrator_zh": ""
        },
        {
            "location": "601/TALK",
            "narrator": "神楽",
            "text": "どうにも$handlek$にこの悩みが伝わらないのが残念すぎる",
            "zh": "这烦恼怎么也传不到$handlek$心里，太遗憾了",
            "narrator_zh": "神乐"
        },
        {
            "location": "604/ACT",
            "narrator": "",
            "text": "代わりに売ってきてあげる",
            "zh": "我替你去卖",
            "narrator_zh": ""
        },
        {
            "location": "605/TALK",
            "narrator": "神楽",
            "text": "なんですと！？",
