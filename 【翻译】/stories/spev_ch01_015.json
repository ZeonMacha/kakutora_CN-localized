        },
        {
            "location": "164/TALK",
            "narrator": "透明つばめ",
            "text": "ところでマリンちゃんは\nどんなチョコレートを\n作ったの？",
            "zh": "话说玛琳\n做了什么样的\n巧克力？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "165/TALK",
            "narrator": "透明マリン・ザ・リード",
            "text": "私はチョコクリームの\n入ったロールケーキを\n作ったわ。",
            "zh": "我做了夹着\n巧克力奶油的\n卷蛋糕。",
            "narrator_zh": "透明玛琳·泽·里德"
