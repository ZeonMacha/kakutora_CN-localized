    },
    "entry": [
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "む、むむむ…。\n難しいなぁ…。",
            "zh": "唔、唔唔唔……\n好难啊……",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "形をうまく整えるのが…\nなかなかできないよ…",
            "zh": "要把形状修好……\n怎么都做不好……",
            "narrator_zh": "燕"
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "わぁ…すごい形に\nなっちゃった…。",
            "zh": "哇……变成\n好厉害的形状了……",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "透明マリン・ザ・リード",
            "text": "いったん休憩に\nしましょう。",
            "zh": "先休息一下\n吧。",
            "narrator_zh": "透明玛琳·泽·里德"
        },
        {
            "location": "37/TALK",
            "narrator": "透明マリン・ザ・リード",
            "text": "少しずつやっていけば\n大丈夫よ。",
            "zh": "一点一点来\n就没问题。",
            "narrator_zh": "透明玛琳·泽·里德"
        },
        {
            "location": "42/TALK",
            "narrator": "つばめ",
            "text": "う、うん。\nそうするよ…。",
            "zh": "嗯、嗯。\n就这么办……",
            "narrator_zh": "燕"
        },
        {
            "location": "43/SEL",
            "narrator": "（選択肢）",
            "text": "頑張って！",
            "zh": "加油！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "44/SEL",
            "narrator": "（選択肢）",
            "text": "形は味に関係ないよ",
            "zh": "形状跟味道没关系",
            "narrator_zh": "（选项）"
        },
        {
            "location": "45/ACT",
            "narrator": "",
            "text": "頑張って！",
            "zh": "加油！",
            "narrator_zh": ""
        },
        {
            "location": "59/TALK",
            "narrator": "つばめ",
            "text": "ありがとう(´∀｀*)",
            "zh": "谢谢(´∀｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんに喜んでもらえるように頑張るょ",
            "zh": "我会加油，好让$handle$高兴",
            "narrator_zh": "燕"
        },
        {
            "location": "62/ACT",
            "narrator": "",
            "text": "形は味に関係ないよ",
            "zh": "形状跟味道没关系",
            "narrator_zh": ""
        },
        {
            "location": "76/TALK",
            "narrator": "つばめ",
            "text": "えっ",
            "zh": "诶",
            "narrator_zh": "燕"
        },
        {
            "location": "77/TALK",
            "narrator": "つばめ",
            "text": "そんなことないょ",
            "zh": "才没有呀",
            "narrator_zh": "燕"
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "形も可愛いほうがきっと美味しく感じるょ\n(｡･ω･｡)",
            "zh": "形状也可爱的话，一定吃起来更香\n(｡･ω･｡)",
            "narrator_zh": "燕"
        },
        {
            "location": "80/TALK",
            "narrator": "つばめ",
            "text": "それじゃぁ、休憩してから続きをやるね",
            "zh": "那就休息一下，再继续哦",
            "narrator_zh": "燕"
        },
        {
            "location": "82/TALK",
            "narrator": "つばめ",
            "text": "またあとでね\nヾ(｡>﹏<｡)ﾉﾞ",
            "zh": "待会儿见\nヾ(｡>﹏<｡)ﾉﾞ",
            "narrator_zh": "燕"
        },
        {
            "location": "93/TALK",
            "narrator": "つばめ",
            "text": "マリンちゃん、続きも\nよろしくお願いします！",
            "zh": "玛琳，后面也\n请多指教！",
            "narrator_zh": "燕"
        },
        {
            "location": "97/TALK",
            "narrator": "透明マリン・ザ・リード",
            "text": "ええ、それじゃあ\n頑張りましょうか。",
            "zh": "好，那我们\n加油吧。",
            "narrator_zh": "透明玛琳·泽·里德"
        },
        {
            "location": "110/TALK",
            "narrator": "透明つばめ",
            "text": "よし…と。",
            "zh": "好……了。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "113/TALK",
            "narrator": "透明つばめ",
            "text": "できたー！",
            "zh": "做好了——！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "114/TALK",
            "narrator": "透明マリン・ザ・リード",
            "text": "おめでとう！\nつばめちゃん！\nよく頑張ったね。",
            "zh": "恭喜！\n燕！\n你很努力了。",
            "narrator_zh": "透明玛琳·泽·里德"
        },
        {
            "location": "115/TALK",
            "narrator": "透明つばめ",
            "text": "ありがとう！\nマリンちゃんの\nおかげだよ！",
            "zh": "谢谢！\n都是玛琳的\n功劳！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "116/TALK",
            "narrator": "透明つばめ",
            "text": "マリンちゃんが丁寧に\n教えてくれるから――",
            "zh": "玛琳教得很仔细\n——",
            "narrator_zh": "透明燕"
        },
        {
            "location": "117/TALK",
            "narrator": "透明つばめ",
            "text": "最初は不安だったけど\n頑張れたんだ！",
            "zh": "一开始虽然不安，\n但我努力下来了！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "119/TALK",
            "narrator": "つばめ",
            "text": "みんなが作ってるのに比べたら",
            "zh": "跟大家做的比起来",
            "narrator_zh": "燕"
        },
        {
            "location": "120/TALK",
            "narrator": "つばめ",
            "text": "簡単なチョコだけど…",
            "zh": "只是简单的巧克力……",
            "narrator_zh": "燕"
        },
        {
            "location": "122/TALK",
            "narrator": "つばめ",
            "text": "マリンちゃんたちに手伝ってもらって作ったんだ（*'∀'人）",
            "zh": "是玛琳她们帮忙，我才做成的（*'∀'人）",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "つばめ",
            "text": "途中でお鍋がぶわーっってなってびっくりしたょ",
            "zh": "做到一半锅突然噗地冒起来，吓了我一跳",
            "narrator_zh": "燕"
        },
        {
            "location": "124/TALK",
            "narrator": "つばめ",
            "text": "卯月さんの冗談にもびっくりしちゃったヾ(｡>﹏<｡)ﾉﾞ",
            "zh": "卯月的玩笑也吓到我了ヾ(｡>﹏<｡)ﾉﾞ",
            "narrator_zh": "燕"
        },
        {
            "location": "125/SEL",
            "narrator": "（選択肢）",
            "text": "$me$も焦ったよ",
            "zh": "$me$也着急了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "126/SEL",
            "narrator": "（選択肢）",
            "text": "神楽の話を信じてはいけない",
            "zh": "神乐的话不能信",
            "narrator_zh": "（选项）"
        },
        {
            "location": "127/ACT",
            "narrator": "",
            "text": "$me$も焦ったよ",
            "zh": "$me$也着急了",
            "narrator_zh": ""
        },
        {
            "location": "128/TALK",
            "narrator": "つばめ",
            "text": "ゎたしが信じちゃったせいで心配かけちゃったかな",
            "zh": "是我相信了，让你担心了吗",
            "narrator_zh": "燕"
        },
        {
            "location": "129/TALK",
            "narrator": "つばめ",
            "text": "ごめんね(´つω・｀)ｼｭﾝ",
