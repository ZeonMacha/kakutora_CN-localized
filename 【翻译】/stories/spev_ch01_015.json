        },
        {
            "location": "138/SEL",
            "narrator": "（選択肢）",
            "text": "つばめのチョコにはつばめの良さがあるよ",
            "zh": "燕的巧克力有燕的好处",
            "narrator_zh": "（选项）"
        },
        {
            "location": "139/ACT",
            "narrator": "",
            "text": "もう１年後の話！？",
