{
    "dir": "chap22/daydra/dd_ch01_22_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "22105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "慟哭＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "恸哭＜后篇＞"
    },
    "entry": [
        {
            "location": "552/TALK",
            "narrator": "つばめ",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": "燕"
        },
        {
            "location": "553/TALK",
            "narrator": "つばめ",
            "text": "一人になんてできなぃo(*･ﾛ･*)o、",
            "zh": "还是没法放她一个人不管o(*･ﾛ･*)o、",
            "narrator_zh": "燕"
        },
        {
            "location": "554/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんは",
            "zh": "神乐她",
            "narrator_zh": "燕"
        },
        {
            "location": "555/TALK",
            "narrator": "つばめ",
            "text": "大事なぉ友達だもん(*´︶`*)",
            "zh": "是我很重要的朋友呀(*´︶`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "557/SEL",
            "narrator": "",
            "text": "つばめがそう言うならもう止めない",
            "zh": "燕都这么说的话我就不拦你了",
            "narrator_zh": ""
        },
        {
            "location": "558/ACT",
            "narrator": "",
            "text": "つばめがそう言うならもう止めない",
            "zh": "燕都这么说的话我就不拦你了",
            "narrator_zh": ""
        },
        {
            "location": "560/TALK",
            "narrator": "つばめ",
            "text": "ごめんね(´・ω・｀)",
            "zh": "对不起呀(´・ω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "561/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "燕"
        },
        {
            "location": "562/TALK",
            "narrator": "つばめ",
            "text": "わたしだけじゃ",
            "zh": "光靠我一个人",
            "narrator_zh": "燕"
        },
        {
            "location": "563/TALK",
            "narrator": "つばめ",
            "text": "どぅすればぃぃかわからなぃから(o´Д`)=з",
            "zh": "不知道该怎么办才好呀(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "564/TALK",
            "narrator": "つばめ",
            "text": "協力してほしぃの(●´人｀)",
            "zh": "想请你帮帮我(●´人｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "565/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんに",
            "zh": "对神乐",
            "narrator_zh": "燕"
        },
        {
            "location": "566/TALK",
            "narrator": "つばめ",
            "text": "なんて声かければぃぃかな？(･ｪ･^ )( ^･ｪ･)",
            "zh": "该怎么搭话才好呀？(･ｪ･^ )( ^･ｪ･)",
            "narrator_zh": "燕"
        },
        {
            "location": "568/SEL",
            "narrator": "",
            "text": "元気づけたいの？",
            "zh": "想给她打气吗？",
            "narrator_zh": ""
        },
        {
            "location": "569/ACT",
            "narrator": "",
            "text": "元気づけたいの？",
            "zh": "想给她打气吗？",
            "narrator_zh": ""
        },
        {
            "location": "571/TALK",
            "narrator": "つばめ",
            "text": "ぅん",
            "zh": "嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "572/TALK",
            "narrator": "つばめ",
            "text": "今より",
            "zh": "只要能比现在",
            "narrator_zh": "燕"
        },
        {
            "location": "573/TALK",
            "narrator": "つばめ",
            "text": "少しでもぃぃからo(*･ﾛ･*)o、",
            "zh": "好上哪怕一点点也好o(*･ﾛ･*)o、",
            "narrator_zh": "燕"
        },
        {
            "location": "575/TALK",
            "narrator": "つばめ",
            "text": "何とかしたぃの",
            "zh": "我想做点什么",
            "narrator_zh": "燕"
        },
        {
            "location": "577/SEL",
            "narrator": "",
            "text": "神楽が好きだと言おう",
            "zh": "就说喜欢神乐吧",
            "narrator_zh": ""
        },
        {
            "location": "578/SEL",
            "narrator": "",
            "text": "つばめの言葉で話してあげて",
            "zh": "用燕自己的话去跟她说吧",
            "narrator_zh": ""
        },
        {
            "location": "579/ACT",
            "narrator": "",
            "text": "神楽が好きだと言おう",
            "zh": "就说喜欢神乐吧",
            "narrator_zh": ""
        },
        {
            "location": "580/TALK",
            "narrator": "つばめ",
            "text": "わかった",
            "zh": "我知道了",
            "narrator_zh": "燕"
        },
        {
            "location": "581/TALK",
            "narrator": "つばめ",
            "text": "きっと",
            "zh": "她一定",
            "narrator_zh": "燕"
        },
        {
            "location": "582/TALK",
            "narrator": "つばめ",
            "text": "元気になってくれるよね？(*´ω｀*)",
            "zh": "会打起精神来的吧？(*´ω｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "596/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃん。\nわたし、ここにいたら\n邪魔かな？",
            "zh": "神乐。\n我待在这里，\n会不会打扰到你？",
            "narrator_zh": "燕"
        },
        {
            "location": "597/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "599/TALK",
            "narrator": "つばめ",
            "text": "…あのね、\n神楽ちゃん。",
            "zh": "……那个呀，\n神乐。",
            "narrator_zh": "燕"
        },
        {
            "location": "600/TALK",
            "narrator": "つばめ",
            "text": "わたし\n神楽ちゃんのこと、\n大好きだよ。",
            "zh": "我\n最喜欢\n神乐了呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "603/TALK",
            "narrator": "神楽",
            "text": "…えっ？",
            "zh": "……哎？",
            "narrator_zh": "神乐"
        },
        {
            "location": "604/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんは、\nわたしの大切で\n大好きなお友達だよ。",
            "zh": "神乐是我\n最重要、\n最喜欢的朋友呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "605/TALK",
            "narrator": "つばめ",
            "text": "だから、神楽ちゃんが\n悩んでたり、悲しんで\nほしくない。",
            "zh": "所以，我不希望\n神乐烦恼，\n也不希望你难过。",
            "narrator_zh": "燕"
        },
        {
            "location": "606/TALK",
            "narrator": "つばめ",
            "text": "もし…何か悩んでる\nことがあるなら\n話してほしいな。",
            "zh": "如果……有什么\n烦恼的事，\n真希望你能告诉我。",
            "narrator_zh": "燕"
        },
        {
            "location": "607/TALK",
            "narrator": "つばめ",
            "text": "わたしでよければ、\n力になるから…。",
            "zh": "要是不嫌弃我，\n我会帮你的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "608/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "609/TALK",
            "narrator": "つばめ",
            "text": "…神楽ちゃん。",
            "zh": "……神乐。",
            "narrator_zh": "燕"
        },
        {
            "location": "613/TALK",
            "narrator": "神楽",
            "text": "つばめさん…、\n私…！！",
            "zh": "燕……、\n我……！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "615/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "616/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "621/TALK",
            "narrator": "神楽",
            "text": "いえ…私のことは\n放っておいて\nください。",
            "zh": "不……请别\n管我的事\n了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "623/TALK",
            "narrator": "つばめ",
            "text": "で、でも、わたし…。",
            "zh": "可、可是，我……。",
            "narrator_zh": "燕"
        },
        {
            "location": "624/TALK",
            "narrator": "神楽",
            "text": "やめてください！",
            "zh": "请不要这样！",
            "narrator_zh": "神乐"
        },
        {
            "location": "625/TALK",
            "narrator": "神楽",
            "text": "私のこと、友達って\n言いましたよね？",
            "zh": "你刚刚说，我是\n你的朋友吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "626/TALK",
            "narrator": "神楽",
            "text": "大切で、大好きな\nお友達だって。",
            "zh": "说是重要、\n最喜欢的朋友。",
            "narrator_zh": "神乐"
        },
        {
            "location": "628/TALK",
            "narrator": "神楽",
            "text": "なら、これ以上\n私を苦しめないで\nください…。",
            "zh": "那就请不要\n再这样\n折磨我了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "629/TALK",
            "narrator": "つばめ",
            "text": "そ、そんな…。\nわたし、友達だから\n力になろうって――",
            "zh": "怎、怎么会……。\n我只是想说因为是朋友，\n才想帮上忙——",
            "narrator_zh": "燕"
        },
        {
            "location": "632/TALK",
            "narrator": "神楽",
            "text": "いい加減にして！！",
            "zh": "适可而止吧！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "634/TALK",
            "narrator": "神楽",
            "text": "友達だから…友達、\n友達って！",
            "zh": "因为是朋友……朋友、\n朋友个没完！",
            "narrator_zh": "神乐"
        },
        {
            "location": "635/TALK",
            "narrator": "神楽",
            "text": "友達って言葉を\n武器にして\n私を苦しめないで！",
            "zh": "别把朋友这个词\n当成武器\n来折磨我！",
            "narrator_zh": "神乐"
        },
        {
            "location": "640/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "642/TALK",
            "narrator": "つばめ",
            "text": "そんな…わたし、\nそんなつもりは…。",
            "zh": "怎么会……我，\n没那个意思……。",
            "narrator_zh": "燕"
        },
        {
            "location": "644/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "645/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃん、\nごめん…。\nわたし…ごめんね…。",
            "zh": "神乐，\n对不起……。\n我……对不起呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "646/ACT",
            "narrator": "",
            "text": "つばめの言葉で話してあげて",
            "zh": "用燕自己的话去跟她说吧",
            "narrator_zh": ""
        },
        {
            "location": "647/TALK",
            "narrator": "つばめ",
            "text": "そぅだね(´･ω･｀) ",
            "zh": "是呀(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "648/TALK",
            "narrator": "つばめ",
            "text": "わたしの言葉じゃなきゃ",
            "zh": "不是我自己的话",
            "narrator_zh": "燕"
        },
        {
            "location": "649/TALK",
            "narrator": "つばめ",
            "text": "意味なぃよねo(*･ﾛ･*)o、",
            "zh": "就没有意义了呀o(*･ﾛ･*)o、",
            "narrator_zh": "燕"
        },
        {
            "location": "661/TALK",
            "narrator": "つばめ",
            "text": "…$handle$さんに\n頼むのは、間違ってる\nよね。",
            "zh": "……去拜托$handle$，\n本身就是错的\n呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "662/TALK",
            "narrator": "つばめ",
            "text": "……神楽ちゃんを\n元気づけたいのは\nわたしなんだから。",
            "zh": "……想给神乐\n打气的人，\n是我自己嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "663/TALK",
            "narrator": "つばめ",
            "text": "人に聞かないで\nわたしの言葉で\n伝えないと…。",
            "zh": "不能去问别人，\n得用我自己的话\n传达才行……。",
            "narrator_zh": "燕"
        },
        {
            "location": "666/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "667/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "669/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "670/TALK",
            "narrator": "つばめ",
            "text": "…ごめんなさい。",
            "zh": "……对不起。",
            "narrator_zh": "燕"
        },
        {
            "location": "672/TALK",
            "narrator": "神楽",
            "text": "…え？",
            "zh": "……哎？",
            "narrator_zh": "神乐"
        },
        {
            "location": "673/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんが凄く\n悩んでるって、\nわかってるのにね。",
            "zh": "明明知道神乐\n在非常烦恼\n呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "675/TALK",
            "narrator": "つばめ",
            "text": "わたし、なんて\n声をかければいいか\nわからなくて…。",
            "zh": "我却不知道\n该怎么\n安慰你才好……。",
            "narrator_zh": "燕"
        },
        {
            "location": "676/TALK",
            "narrator": "つばめ",
            "text": "本当にごめん…。\n頼りないよね。",
            "zh": "真的对不起……。\n我太不可靠了吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "680/TALK",
            "narrator": "神楽",
            "text": "…謝らないで\nください。",
            "zh": "……请别\n道歉。",
            "narrator_zh": "神乐"
        },
        {
            "location": "681/TALK",
            "narrator": "神楽",
            "text": "むしろ、謝るのは\n私の方です。",
            "zh": "倒不如说，\n该道歉的是我才对。",
            "narrator_zh": "神乐"
        },
        {
            "location": "682/TALK",
            "narrator": "神楽",
            "text": "つばめさんまで\n変に悩ませることに\nなっちゃって…。",
            "zh": "害得连燕也\n莫名跟着烦恼起来\n……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "683/TALK",
            "narrator": "神楽",
            "text": "本当にごめんなさい。",
            "zh": "真的非常对不起。",
            "narrator_zh": "神乐"
        },
        {
            "location": "684/TALK",
            "narrator": "つばめ",
            "text": "そんな…。\n神楽ちゃんこそ\n謝ることじゃ…。",
            "zh": "怎么会……。\n神乐你才\n不用道歉呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "685/TALK",
            "narrator": "神楽",
            "text": "謝ることですよ。",
            "zh": "是该道歉的事哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "688/TALK",
            "narrator": "神楽",
            "text": "だって…どうしようも\nないことなのは\nわかってたのに…。",
            "zh": "因为……明明早就知道\n那是无可奈何\n的事……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "689/TALK",
            "narrator": "神楽",
            "text": "ずっと前から、\nわかってたのに…。",
            "zh": "从很久以前起，\n就知道了的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "691/TALK",
            "narrator": "つばめ",
            "text": "…どうしようもない\nことって…どういう\nことなの？",
            "zh": "……无可奈何的事\n……是指什么\n事呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "693/TALK",
            "narrator": "神楽",
            "text": "…いえ、いいんです。\n忘れてください。",
            "zh": "……不，没什么。\n请忘掉吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "695/TALK",
            "narrator": "つばめ",
            "text": "ううん、教えて。",
            "zh": "不要，告诉我。",
            "narrator_zh": "燕"
        },
        {
            "location": "696/TALK",
            "narrator": "つばめ",
            "text": "教えてくれれば、\nわたしも解決策を\n考えられるし。",
            "zh": "只要你告诉我，\n我也能一起\n想解决的办法呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "697/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "699/TALK",
            "narrator": "つばめ",
            "text": "一緒に考えれば、\nきっとどうにかなる\nと思うの。",
            "zh": "只要一起想办法，\n我觉得一定能\n解决的。",
            "narrator_zh": "燕"
        },
        {
            "location": "701/TALK",
            "narrator": "神楽",
            "text": "…なりませんよ。",
            "zh": "……解决不了的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "702/TALK",
            "narrator": "つばめ",
            "text": "でも……。",
            "zh": "可是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "705/TALK",
            "narrator": "神楽",
            "text": "いい加減にして\nください！",
            "zh": "请适可而止\n吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "707/TALK",
            "narrator": "つばめ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "燕"
        },
        {
            "location": "709/TALK",
            "narrator": "神楽",
            "text": "私の話を聞かないで、\n頭の中お花畑なこと\nばかり言って！",
            "zh": "根本不听我说话，\n尽说些脑子里开满花似的\n天真话！",
            "narrator_zh": "神乐"
        },
        {
            "location": "710/TALK",
            "narrator": "神楽",
            "text": "これ以上、\nイライラさせないで！",
            "zh": "不要再让我\n更烦躁了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "715/TALK",
            "narrator": "神楽",
            "text": "そういう無責任なこと\n言われるのが…、\n一番傷つくんです…！",
            "zh": "被别人说这种\n不负责任的话……，\n才是最伤人的……！",
            "narrator_zh": "神乐"
        },
        {
            "location": "721/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "723/TALK",
            "narrator": "つばめ",
            "text": "そんな…無責任に、\n言ったわけじゃ\nないのに…。",
            "zh": "怎么会……我并不是\n不负责任才这么\n说的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "724/TALK",
            "narrator": "つばめ",
            "text": "わたし…何を間違え\nちゃったんだろ…。",
            "zh": "我……到底是哪里\n弄错了呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "725/TALK",
            "narrator": "つばめ",
            "text": "何で、あんなに\n神楽ちゃんを怒らせ\nちゃったのかな…？",
            "zh": "为什么，会把神乐\n惹得那么\n生气呀……？",
            "narrator_zh": "燕"
        },
        {
            "location": "726/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "739/DIALOG",
            "narrator": "Dialog_chapter_ch01",
            "text": "【18 ブラック・クラン】",
            "zh": "【18 黑色库兰】",
            "narrator_zh": "Dialog_chapter_ch01"
        }
    ]
}
