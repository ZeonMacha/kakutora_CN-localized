    "entry": [
        {
            "location": "267/SCENARIO",
            "narrator": "",
            "text": "社会生活不適応少女",
            "zh": "无法适应社会生活的少女",
            "narrator_zh": ""
        },
        {
            "location": "285/TALK",
            "narrator": "つばめ",
            "text": "…………？",
            "zh": "…………？",
            "narrator_zh": "燕"
        },
        {
            "location": "286/TALK",
            "narrator": "つばめ",
            "text": "よかった…。\nちょっと、\n落ち着いたかも…。",
            "zh": "太好了……\n稍微，\n冷静一点了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "287/SEL",
            "narrator": "",
            "text": "ほら、答えないと",
            "zh": "喂，不回答不行哦",
            "narrator_zh": ""
        },
        {
            "location": "288/ACT",
            "narrator": "",
            "text": "ほら、答えないと",
            "zh": "喂，不回答不行哦",
            "narrator_zh": ""
        },
        {
            "location": "293/TALK",
            "narrator": "つばめ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "296/TALK",
            "narrator": "雛",
            "text": "あ、いいよいいよー。\nスマホ出て。",
            "zh": "啊，没事没事。\n把手机拿出来。",
            "narrator_zh": "雏"
        },
        {
            "location": "297/TALK",
            "narrator": "雛",
            "text": "特別攻撃隊の\n秘密命令かも\nしれないしねー。",
            "zh": "也许是特别攻击队的\n秘密命令，\n也说不定。",
            "narrator_zh": "雏"
        },
        {
            "location": "299/TALK",
            "narrator": "繭",
            "text": "…まだ、本人かどうか\nわからないんだけど？",
            "zh": "……还不知道\n是不是本人哦？",
            "narrator_zh": "茧"
        },
        {
            "location": "301/TALK",
            "narrator": "雛",
            "text": "絶対そうだって！\n間違いないよ。",
            "zh": "绝对就是！\n不会有错。",
            "narrator_zh": "雏"
        },
        {
            "location": "303/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "319/TALK",
            "narrator": "つばめ",
            "text": "わかってるけど",
            "zh": "我知道",
            "narrator_zh": "燕"
        },
        {
            "location": "320/TALK",
            "narrator": "つばめ",
            "text": "ちゃんと言えるかな？(´･ω･｀) ",
            "zh": "能好好说出来吗？(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "321/TALK",
            "narrator": "つばめ",
            "text": "失敗して",
            "zh": "搞砸了的话",
            "narrator_zh": "燕"
        },
        {
            "location": "322/TALK",
            "narrator": "つばめ",
            "text": "変な子に思われちゃうかも(´つω・｀)ｼｭﾝ",
            "zh": "可能会被当成奇怪的孩子(´つω・｀)ｼｭﾝ",
            "narrator_zh": "燕"
        },
        {
            "location": "324/SEL",
            "narrator": "",
            "text": "前の学校で友達作ってたじゃん",
            "zh": "以前的学校你也交到朋友了吧",
            "narrator_zh": ""
        },
        {
            "location": "325/SEL",
            "narrator": "",
            "text": "失敗したときのつばめとは違う",
            "zh": "和失败那时候的燕不一样",
            "narrator_zh": ""
        },
        {
            "location": "326/SEL",
            "narrator": "",
            "text": "とにかく、当たってみなくちゃアタリかハズレかわからない",
            "zh": "总之，不去试就不知道是成是败",
            "narrator_zh": ""
        },
        {
            "location": "327/ACT",
            "narrator": "",
            "text": "前の学校で友達作ってたじゃん",
            "zh": "以前的学校你也交到朋友了吧",
            "narrator_zh": ""
        },
        {
            "location": "328/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "燕"
        },
        {
            "location": "329/TALK",
            "narrator": "つばめ",
            "text": "あの時は",
            "zh": "那时候",
            "narrator_zh": "燕"
        },
        {
            "location": "331/TALK",
            "narrator": "つばめ",
            "text": "席が近かったから",
            "zh": "座位很近",
            "narrator_zh": "燕"
        },
        {
            "location": "332/TALK",
            "narrator": "つばめ",
            "text": "仲良くなれたんだし(o´Д`)=з",
            "zh": "才能变得要好(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "334/SEL",
            "narrator": "",
            "text": "今回は、声をかけられたのがきっかけ",
            "zh": "这次，是对方先开口",
            "narrator_zh": ""
        },
        {
            "location": "335/ACT",
            "narrator": "",
            "text": "今回は、声をかけられたのがきっかけ",
            "zh": "这次，是对方先开口",
            "narrator_zh": ""
        },
        {
            "location": "337/TALK",
            "narrator": "つばめ",
            "text": "そっか",
            "zh": "这样啊",
            "narrator_zh": "燕"
        },
        {
            "location": "338/TALK",
            "narrator": "つばめ",
            "text": "せっかくのきっかけだもん",
            "zh": "难得的契机",
            "narrator_zh": "燕"
        },
        {
            "location": "339/TALK",
            "narrator": "つばめ",
            "text": "無駄にしたら",
            "zh": "要是浪费了",
            "narrator_zh": "燕"
        },
        {
            "location": "340/TALK",
            "narrator": "つばめ",
            "text": "勿体ないよねo(*･ﾛ･*)o、",
            "zh": "就太可惜了o(*･ﾛ･*)o、",
            "narrator_zh": "燕"
        },
        {
            "location": "341/TALK",
            "narrator": "つばめ",
            "text": "ありがと",
            "zh": "谢谢",
            "narrator_zh": "燕"
        },
        {
            "location": "342/TALK",
            "narrator": "つばめ",
            "text": "頑張ってみる！(๑･ㅂ･)و☆",
            "zh": "我试试！(๑･ㅂ･)و☆",
            "narrator_zh": "燕"
        },
        {
            "location": "354/TALK",
            "narrator": "つばめ",
            "text": "…せっかく、声かけて\nくれたんだもん。",
            "zh": "……难得，对方先\n跟我说话了。",
            "narrator_zh": "燕"
        },
        {
            "location": "355/TALK",
            "narrator": "つばめ",
            "text": "わたしも、\n頑張らないと…。",
            "zh": "我也得\n加油才行……。",
            "narrator_zh": "燕"
        },
        {
            "location": "358/TALK",
            "narrator": "つばめ",
            "text": "…あの、\nお待たせしました。",
            "zh": "……那个，\n让你们久等了。",
            "narrator_zh": "燕"
        },
        {
            "location": "359/TALK",
            "narrator": "つばめ",
            "text": "わたし、今日から\n特別攻撃隊特科に\n転入になった――",
            "zh": "我，从今天起\n转入特别攻击队专科\n了——",
            "narrator_zh": "燕"
        },
        {
            "location": "360/TALK",
            "narrator": "つばめ",
            "text": "逢瀬つばめです。",
            "zh": "我是逢濑燕。",
            "narrator_zh": "燕"
        },
        {
            "location": "362/TALK",
            "narrator": "雛",
            "text": "つばめちゃんって\nいうんだ？",
            "zh": "叫燕\n吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "363/ACT",
            "narrator": "",
            "text": "失敗したときのつばめとは違う",
            "zh": "和失败那时候的燕不一样",
            "narrator_zh": ""
        },
        {
            "location": "364/TALK",
            "narrator": "つばめ",
            "text": "えっ！",
            "zh": "诶！",
            "narrator_zh": "燕"
        },
        {
            "location": "365/TALK",
            "narrator": "つばめ",
            "text": "何で知ってるの！？(ﾟ△ﾟ;ﾉ)ﾉ",
            "zh": "你怎么知道的！？(ﾟ△ﾟ;ﾉ)ﾉ",
            "narrator_zh": "燕"
        },
        {
            "location": "366/TALK",
            "narrator": "つばめ",
            "text": "っていうか",
            "zh": "话说",
            "narrator_zh": "燕"
        },
        {
            "location": "367/TALK",
            "narrator": "つばめ",
            "text": "何が違うかわからないよ…(o´Д`)=з",
            "zh": "我不知道哪里不一样……(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "369/SEL",
            "narrator": "",
            "text": "$me$がいる",
            "zh": "有$me$在",
            "narrator_zh": ""
        },
        {
            "location": "370/ACT",
            "narrator": "",
            "text": "$me$がいる",
            "zh": "有$me$在",
            "narrator_zh": ""
        },
        {
            "location": "372/TALK",
            "narrator": "つばめ",
            "text": "ありがと(*´ω｀*)",
            "zh": "谢谢(*´ω｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "373/TALK",
            "narrator": "つばめ",
            "text": "凄く心強い味方だね(*≧∀≦*) ",
            "zh": "真是让人安心的同伴(*≧∀≦*) ",
            "narrator_zh": "燕"
        },
        {
            "location": "374/TALK",
            "narrator": "つばめ",
            "text": "もう",
            "zh": "真是的",
            "narrator_zh": "燕"
        },
        {
            "location": "375/TALK",
            "narrator": "つばめ",
            "text": "平気だよ",
            "zh": "没关系了",
            "narrator_zh": "燕"
        },
        {
            "location": "387/TALK",
            "narrator": "つばめ",
            "text": "…すみません。\nお待たせしました。",
            "zh": "……对不起。\n让你们久等了。",
            "narrator_zh": "燕"
        },
        {
            "location": "388/TALK",
            "narrator": "つばめ",
            "text": "わたし、今日から\n特別攻撃隊特科に\n転入になった――",
            "zh": "我，从今天起\n转入特别攻击队专科\n了——",
            "narrator_zh": "燕"
        },
        {
            "location": "389/TALK",
            "narrator": "つばめ",
            "text": "逢瀬つばめです。",
            "zh": "我是逢濑燕。",
            "narrator_zh": "燕"
        },
        {
            "location": "391/TALK",
            "narrator": "雛",
            "text": "つばめちゃんって\nいうんだ？",
            "zh": "叫燕\n吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "392/ACT",
            "narrator": "",
            "text": "とにかく、当たってみなくちゃアタリかハズレかわからない",
            "zh": "总之，不去试就不知道是成是败",
            "narrator_zh": ""
        },
        {
            "location": "394/TALK",
            "narrator": "つばめ",
            "text": "当たってみなきゃって",
            "zh": "不去试的话",
            "narrator_zh": "燕"
        },
        {
            "location": "395/TALK",
            "narrator": "つばめ",
            "text": "それ",
            "zh": "这个",
            "narrator_zh": "燕"
        },
        {
            "location": "396/TALK",
            "narrator": "つばめ",
            "text": "ちょっと怖いかも(o´Д`)=з",
            "zh": "可能有点可怕(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "398/SEL",
            "narrator": "",
            "text": "つばめ、気合いだ！！",
            "zh": "燕，鼓起气势！！",
            "narrator_zh": ""
        },
        {
            "location": "399/ACT",
            "narrator": "",
            "text": "つばめ、気合いだ！！",
            "zh": "燕，鼓起气势！！",
            "narrator_zh": ""
        },
        {
            "location": "401/TALK",
            "narrator": "つばめ",
            "text": "はい！！",
            "zh": "是！！",
            "narrator_zh": "燕"
        },
        {
            "location": "412/TALK",
            "narrator": "つばめ",
            "text": "って、どうしよう！\n勢いでチャット\n閉じちゃった…。",
            "zh": "糟了，怎么办！\n一冲动把聊天\n关掉了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "413/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "414/TALK",
            "narrator": "繭",
            "text": "…………ハァ。",
            "zh": "…………哈啊。",
            "narrator_zh": "茧"
        },
        {
            "location": "415/TALK",
            "narrator": "つばめ",
            "text": "…よ、よーし。\n気合い、気合いっ！！",
            "zh": "……好、好。\n气势，气势！！",
            "narrator_zh": "燕"
        },
        {
            "location": "416/TALK",
            "narrator": "つばめ",
            "text": "あ、あの！！",
            "zh": "那、那个！！",
            "narrator_zh": "燕"
        },
        {
            "location": "417/TALK",
            "narrator": "つばめ",
            "text": "わたし、特別攻撃隊\n特科に転入します、\n逢瀬つばめです！！",
            "zh": "我要转入特别攻击队\n专科，\n我是逢濑燕！！",
            "narrator_zh": "燕"
        },
        {
            "location": "418/TALK",
            "narrator": "つばめ",
            "text": "よろしく\nお願いします！！",
            "zh": "请多\n关照！！",
            "narrator_zh": "燕"
        },
        {
            "location": "420/TALK",
            "narrator": "雛",
            "text": "あ、う、うん。\nつばめちゃんね。",
            "zh": "啊，嗯、嗯。\n是燕呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "422/TALK",
            "narrator": "つばめ",
            "text": "はい！\n逢瀬つばめです！！",
            "zh": "是的！\n我是逢濑燕！！",
            "narrator_zh": "燕"
        },
        {
            "location": "423/TALK",
            "narrator": "雛",
            "text": "大きな声だねー。\nちょっとビックリ\nしちゃったよ。",
            "zh": "声音好大。\n有点被\n吓到了。",
            "narrator_zh": "雏"
        },
        {
            "location": "426/TALK",
            "narrator": "つばめ",
            "text": "や、やっちゃったー！",
            "zh": "糟、搞砸了！",
            "narrator_zh": "燕"
        },
        {
            "location": "429/TALK",
            "narrator": "つばめ",
            "text": "す、すみません！\n驚かせたかった\nわけじゃなくて…。",
            "zh": "对、对不起！\n我不是想\n吓你们……。",
            "narrator_zh": "燕"
        },
        {
            "location": "431/TALK",
            "narrator": "雛",
            "text": "あはは、謝らないで\nいいよー。",
            "zh": "啊哈哈，不用道歉\n啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "432/TALK",
            "narrator": "雛",
            "text": "まあ、それは\nともかく――",
            "zh": "嘛，这个\n先不说——",
            "narrator_zh": "雏"
        },
        {
            "location": "434/TALK",
            "narrator": "雛",
            "text": "あたし、日向雛。",
            "zh": "我是日向雏。",
            "narrator_zh": "雏"
        },
        {
            "location": "435/TALK",
            "narrator": "雛",
            "text": "システム科の電気電算\nシステム専攻に在籍して\nるの。",
            "zh": "在系统科的电气电算\n系统专业\n就读。",
            "narrator_zh": "雏"
        },
        {
            "location": "437/TALK",
            "narrator": "雛",
            "text": "それでこっちが――",
            "zh": "然后这边是——",
            "narrator_zh": "雏"
        },
        {
            "location": "439/TALK",
            "narrator": "繭",
            "text": "光月繭。\nシステム科情報解析専攻。",
            "zh": "光月茧。\n系统科信息解析专业。",
            "narrator_zh": "茧"
        },
        {
            "location": "440/TALK",
            "narrator": "雛",
            "text": "あたし達、\n学科は違うけど――",
            "zh": "我们两个，\n学科不一样——",
            "narrator_zh": "雏"
        },
        {
            "location": "441/TALK",
            "narrator": "雛",
            "text": "普通授業はほとんど\n一緒に受けることに\nなるから――",
            "zh": "普通课几乎\n会一起上，\n所以——",
            "narrator_zh": "雏"
        },
        {
            "location": "442/TALK",
            "narrator": "雛",
            "text": "これからよろしくね。",
            "zh": "以后请多关照。",
            "narrator_zh": "雏"
        },
        {
            "location": "443/TALK",
            "narrator": "つばめ",
            "text": "あ、はい…。",
            "zh": "啊，好的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "444/TALK",
            "narrator": "つばめ",
            "text": "って、ほとんど一緒って\nことは、同じクラスって\nことですか？",
            "zh": "诶，几乎一起的话，\n就是同一个班\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "445/TALK",
            "narrator": "雛",
            "text": "ピンポーン！\n今日からクラスメイト\nなんだよー。",
            "zh": "答对啦！\n从今天起就是同班同学\n哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "446/TALK",
            "narrator": "つばめ",
            "text": "そうなんですか…。",
            "zh": "是这样啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "449/TALK",
            "narrator": "つばめ",
            "text": "なんか、凄いいきなりで\n驚いたけど――",
            "zh": "总觉得太突然，\n吓了一跳——",
            "narrator_zh": "燕"
        },
        {
            "location": "450/TALK",
            "narrator": "つばめ",
            "text": "悪い人達じゃなさそう、\nかな？",
            "zh": "应该不是坏人，\n吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "451/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "453/TALK",
            "narrator": "つばめ",
            "text": "こっちの…光月さんは、\nちょっと怖そうだけど…。",
            "zh": "这边的……光月，\n看起来有点可怕……。",
            "narrator_zh": "燕"
        },
        {
            "location": "454/TALK",
            "narrator": "雛",
            "text": "あはは、初めての人には\nちょっとまゆちんは\n怖いよねー。",
            "zh": "啊哈哈，对第一次见的人，\n小茧确实\n有点可怕。",
            "narrator_zh": "雏"
        },
        {
            "location": "455/TALK",
            "narrator": "雛",
            "text": "けど、平気だよ。\nこれで結構可愛いところ\nある子だから。",
            "zh": "不过，没关系。\n其实挺有\n可爱的地方。",
            "narrator_zh": "雏"
        },
        {
            "location": "456/TALK",
            "narrator": "雛",
            "text": "それに、つばめちゃんに\n声掛けたのも――",
            "zh": "而且，跟燕\n打招呼——",
            "narrator_zh": "雏"
        },
        {
            "location": "457/TALK",
            "narrator": "雛",
            "text": "まゆちんがどうしても\nつばめちゃんと話したい、\nって言ったからだし。",
            "zh": "也是因为小茧说\n无论如何都想和燕说话，\n才这样的。",
            "narrator_zh": "雏"
        },
        {
            "location": "460/TALK",
            "narrator": "つばめ",
            "text": "そうなんですか？",
            "zh": "是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "461/TALK",
            "narrator": "繭",
            "text": "言ってない。",
            "zh": "我没说。",
            "narrator_zh": "茧"
        },
        {
            "location": "464/TALK",
            "narrator": "雛",
            "text": "えぇっ！？\nさっき興味あるって\n言ったじゃん。",
            "zh": "诶诶！？\n你刚才不是说有兴趣\n吗。",
            "narrator_zh": "雏"
        },
        {
            "location": "466/TALK",
            "narrator": "繭",
            "text": "うるさい黙れ。",
            "zh": "吵死了，闭嘴。",
            "narrator_zh": "茧"
        },
        {
            "location": "472/TALK",
            "narrator": "つばめ",
            "text": "…や、やっぱり、\nちょっと怖いかも。",
            "zh": "……果、果然，\n有点可怕。",
            "narrator_zh": "燕"
        },
        {
            "location": "473/TALK",
            "narrator": "つばめ",
            "text": "もしかして、緊張して\nちゃんと話せてない\nから――",
            "zh": "难道因为太紧张，\n没能好好说话，\n所以——",
            "narrator_zh": "燕"
        },
        {
            "location": "475/TALK",
            "narrator": "つばめ",
            "text": "失礼なやつだ、って\n思われてるとか？",
            "zh": "就被当成\n没礼貌的人了？",
            "narrator_zh": "燕"
        },
        {
            "location": "477/TALK",
            "narrator": "雛",
            "text": "ほら、まゆちん。\nまたつばめちゃんが\n怖がってるって。",
            "zh": "你看，小茧。\n燕又\n害怕了。",
            "narrator_zh": "雏"
        },
        {
            "location": "478/TALK",
            "narrator": "雛",
            "text": "ごめんねー。\nでもまゆちんにとって、\nこれが平常運転だから。",
            "zh": "对不起啦。\n不过对小茧来说，\n这就是平时的样子。",
            "narrator_zh": "雏"
        },
        {
            "location": "480/TALK",
            "narrator": "雛",
            "text": "っていうか、これでも\nつばめちゃんのこと\n歓迎してるんだよ？",
            "zh": "话说，这样也是\n在欢迎燕\n哦？",
            "narrator_zh": "雏"
        },
        {
            "location": "484/TALK",
            "narrator": "つばめ",
            "text": "そうなんですか？",
            "zh": "是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "487/TALK",
            "narrator": "雛",
            "text": "そうなんだよ。\nねー？",
            "zh": "就是这样。\n对吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "488/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "491/TALK",
            "narrator": "雛",
            "text": "否定しないイコール肯定！\nこれがまゆちんスタイル！",
            "zh": "不否定就等于肯定！\n这就是小茧的风格！",
            "narrator_zh": "雏"
        },
        {
            "location": "493/TALK",
            "narrator": "繭",
            "text": "違うから。",
            "zh": "才不是。",
            "narrator_zh": "茧"
        },
        {
            "location": "494/TALK",
            "narrator": "つばめ",
            "text": "…ふふっ。",
            "zh": "……呵呵。",
            "narrator_zh": "燕"
        },
        {
            "location": "498/TALK",
            "narrator": "雛",
            "text": "あはは、やっと笑った。",
            "zh": "啊哈哈，终于笑了。",
            "narrator_zh": "雏"
        },
        {
            "location": "499/TALK",
            "narrator": "雛",
            "text": "ちょっとは緊張ほぐれた？",
            "zh": "紧张稍微解开一点了吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "500/TALK",
            "narrator": "つばめ",
            "text": "はい。\nありがとうございます。",
            "zh": "是的。\n谢谢。",
            "narrator_zh": "燕"
        },
        {
            "location": "501/TALK",
            "narrator": "雛",
            "text": "お礼はいいって。\nそれより――",
            "zh": "不用谢。\n比起这个——",
            "narrator_zh": "雏"
        },
        {
            "location": "503/TALK",
            "narrator": "珠緒先生",
            "text": "こらー！",
            "zh": "喂——！",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "506/TALK",
            "narrator": "雛",
            "text": "うわっ、たまちゃん先生？",
            "zh": "哇，小珠绪老师？",
            "narrator_zh": "雏"
        },
        {
            "location": "509/TALK",
            "narrator": "珠緒先生",
            "text": "逢瀬さん！\n急にいなくなったら\nダメでしょ？",
            "zh": "逢濑！\n突然消失\n可不行哦？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "513/TALK",
            "narrator": "つばめ",
            "text": "ああっ、そうだった！",
            "zh": "啊啊，对了！",
            "narrator_zh": "燕"
        },
        {
            "location": "517/TALK",
            "narrator": "つばめ",
            "text": "わたし、先生に学校の中を\n案内してもらってる\n途中だったんだ…。",
            "zh": "我正在让老师\n带我参观学校，\n走到一半……。",
            "narrator_zh": "燕"
        },
        {
            "location": "521/TALK",
            "narrator": "つばめ",
            "text": "ごめんなさい。\n急にいなくなって…。",
            "zh": "对不起。\n突然不见了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "522/TALK",
            "narrator": "雛",
            "text": "違うの、たまちゃん先生。",
            "zh": "不是的，小珠绪老师。",
            "narrator_zh": "雏"
        },
        {
            "location": "523/TALK",
            "narrator": "雛",
            "text": "あたしがつばめちゃんに\n挨拶したくて、強引に\n引き留めたの。",
            "zh": "是我想跟燕\n打招呼，硬把人\n留下了。",
            "narrator_zh": "雏"
        },
        {
            "location": "525/TALK",
            "narrator": "珠緒先生",
            "text": "朝のホームルームで\nちゃんと言ったでしょ？",
            "zh": "早上班会上\n不是说好了吗？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "526/TALK",
            "narrator": "珠緒先生",
            "text": "午後の授業の前に\n紹介する、って。",
            "zh": "下午上课前\n再介绍。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "527/TALK",
            "narrator": "雛",
            "text": "歩いてるの見えたから、\n早めに挨拶しておこう\nかなぁ、って…。",
            "zh": "看到你们在走，\n就想先打个招呼，\n所以……。",
            "narrator_zh": "雏"
        },
        {
            "location": "529/TALK",
            "narrator": "珠緒先生",
            "text": "だからって、人が案内を\nしている途中でするのは\nよくないわ。",
            "zh": "就算这样，在别人\n带路的时候这么做\n也不好。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "530/TALK",
            "narrator": "雛",
            "text": "いや、たまちゃん先生って\n小さいから――",
            "zh": "不是，小珠绪老师\n个子小——",
            "narrator_zh": "雏"
        },
        {
            "location": "531/TALK",
            "narrator": "雛",
            "text": "つばめちゃんの陰に\n完全に隠れてて…。",
            "zh": "完全藏在燕的\n影子里了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "533/TALK",
            "narrator": "珠緒先生",
            "text": "そ、そんなに\n小さくないです！",
            "zh": "我、我才没有\n那么小！",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "534/TALK",
            "narrator": "珠緒先生",
            "text": "それに、たまちゃん先生\nじゃなくて、珠緒先生と\n呼びなさい！",
            "zh": "而且，不要叫小珠绪老师，\n要叫\n珠绪老师！",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "535/TALK",
            "narrator": "雛",
            "text": "ごめんなさい、珠緒先生。\n小柄で可愛いです。",
            "zh": "对不起，珠绪老师。\n又小只又可爱。",
            "narrator_zh": "雏"
        },
        {
            "location": "536/TALK",
            "narrator": "珠緒先生",
            "text": "そこは言いなおさなくて\nいいの！",
            "zh": "那里不用\n改口！",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "538/TALK",
            "narrator": "つばめ",
            "text": "あ、えっと、その…。",
            "zh": "啊，那个，这个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "540/TALK",
            "narrator": "繭",
            "text": "…はぁ。",
            "zh": "……哈啊。",
            "narrator_zh": "茧"
        },
        {
            "location": "543/TALK",
            "narrator": "繭",
            "text": "珠緒先生。\nもし宜しければ――",
            "zh": "珠绪老师。\n如果方便的话——",
            "narrator_zh": "茧"
        },
        {
            "location": "544/TALK",
            "narrator": "繭",
            "text": "学校の案内は私達に\n任せていただけませんか？",
            "zh": "学校的向导，\n能交给我们吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "545/TALK",
            "narrator": "珠緒先生",
            "text": "えっ？",
            "zh": "诶？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "546/TALK",
            "narrator": "繭",
            "text": "転入手続きの書類は、\nもう終わっているん\nですよね？",
            "zh": "转入手续的文件，\n已经办完了\n吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "547/TALK",
            "narrator": "珠緒先生",
            "text": "え、ええ…。",
            "zh": "诶，是的……。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "548/TALK",
            "narrator": "繭",
            "text": "でしたら、ここからは\n私達にお任せください。",
            "zh": "那么，接下来\n请交给我们。",
            "narrator_zh": "茧"
        },
        {
            "location": "549/TALK",
            "narrator": "繭",
            "text": "先生も、色々とお忙しいと\n思いますし。",
            "zh": "老师也，我想\n还有很多事要忙。",
            "narrator_zh": "茧"
        },
        {
            "location": "550/TALK",
            "narrator": "珠緒先生",
            "text": "さすがは光月さん。\n学級委員なだけのこと\nあるわね。",
            "zh": "不愧是光月。\n到底是班委，\n不一样。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "552/TALK",
            "narrator": "雛",
            "text": "ふふん。",
            "zh": "哼哼。",
            "narrator_zh": "雏"
        },
        {
            "location": "554/TALK",
            "narrator": "つばめ",
            "text": "…な、何で日向さんが\n自慢気なんだろう？",
            "zh": "……为、为什么日向\n一脸骄傲？",
            "narrator_zh": "燕"
        },
        {
            "location": "556/TALK",
            "narrator": "珠緒先生",
            "text": "逢瀬さんも、\nそれで構わない？",
            "zh": "逢濑也，\n这样可以吗？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "559/TALK",
            "narrator": "つばめ",
            "text": "は、はい。\nわたしは構いません。",
            "zh": "是、是的。\n我没有问题。",
            "narrator_zh": "燕"
        },
        {
            "location": "561/TALK",
            "narrator": "珠緒先生",
            "text": "じゃあ、決まりね。\n光月さん、あとは\nよろしくね。",
            "zh": "那就这么定了。\n光月，后面\n拜托你了。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "562/TALK",
            "narrator": "繭",
            "text": "わかりました。",
            "zh": "我知道了。",
            "narrator_zh": "茧"
        },
        {
            "location": "566/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "569/TALK",
            "narrator": "つばめ",
            "text": "あ、あの…光月さん。\nありがとうございます。",
            "zh": "那、那个……光月。\n谢谢你。",
            "narrator_zh": "燕"
        },
        {
            "location": "572/TALK",
            "narrator": "繭",
            "text": "大丈夫。\n単なる点数稼ぎだから。",
            "zh": "没关系。\n只是在刷分而已。",
            "narrator_zh": "茧"
        },
        {
            "location": "573/TALK",
            "narrator": "繭",
            "text": "…案内するから、\n付いてきて。",
            "zh": "……我来带路，\n跟上来。",
            "narrator_zh": "茧"
        },
        {
            "location": "577/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "579/TALK",
            "narrator": "雛",
            "text": "大丈夫だよ、\nつばめちゃん。",
            "zh": "没关系的，\n燕。",
            "narrator_zh": "雏"
        },
        {
            "location": "580/TALK",
            "narrator": "雛",
            "text": "まゆちん、口と愛想は\n悪いけど、結構優しい子\nだからねー。",
            "zh": "小茧嘴和态度\n是差，其实挺温柔的\n哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "581/TALK",
            "narrator": "繭",
            "text": "早く。\n昼休み終わっちゃうから。",
            "zh": "快点。\n午休要结束了。",
            "narrator_zh": "茧"
        },
        {
            "location": "582/TALK",
            "narrator": "雛",
            "text": "ね？　ああ見えても、\n結構つばめちゃんのこと\n気に入ってるんだよ。",
            "zh": "对吧？　别看她这样，\n其实挺中意燕的\n哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "583/TALK",
            "narrator": "雛",
            "text": "だから大丈夫。\nほら、行こう！",
            "zh": "所以没关系。\n来，走吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "585/TALK",
            "narrator": "つばめ",
            "text": "…はい、日向さん。",
            "zh": "……好的，日向。",
            "narrator_zh": "燕"
        },
        {
            "location": "587/TALK",
            "narrator": "雛",
            "text": "っと、そうだそうだ。\nその前にー。",
            "zh": "啊，对了对了。\n在那之前。",
            "narrator_zh": "雏"
        },
        {
            "location": "588/TALK",
            "narrator": "雛",
            "text": "つばめちゃん！\n敬語とさん付けは、\n今後一切禁止！！",
            "zh": "燕！\n敬语和带尊称，\n今后一律禁止！！",
            "narrator_zh": "雏"
        },
        {
            "location": "590/TALK",
            "narrator": "つばめ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "591/TALK",
            "narrator": "雛",
            "text": "だってクラスメイトだよ？\n友達だよ？",
            "zh": "因为是同班同学啊？\n是朋友啊？",
            "narrator_zh": "雏"
        },
        {
            "location": "592/TALK",
            "narrator": "雛",
            "text": "そんな他人行儀じゃ\n楽しくないじゃん。",
            "zh": "那么见外\n就没意思了。",
            "narrator_zh": "雏"
        },
        {
            "location": "593/TALK",
            "narrator": "雛",
            "text": "だから、あたしのことは\nひなこ、って呼んでねー。",
            "zh": "所以，叫我\n小雏就好。",
            "narrator_zh": "雏"
        },
        {
            "location": "594/TALK",
            "narrator": "つばめ",
            "text": "…いいんですか？",
            "zh": "……可以吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "595/TALK",
            "narrator": "雛",
            "text": "敬語とさん付けは\n良くないんです。",
            "zh": "敬语和带尊称\n是不好的。",
            "narrator_zh": "雏"
        },
        {
            "location": "596/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "598/TALK",
            "narrator": "つばめ",
            "text": "うん…わかったよ。\nひ、ひなこ…ちゃん。",
            "zh": "嗯……我知道了。\n小、小雏……。",
            "narrator_zh": "燕"
        },
        {
            "location": "599/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "600/TALK",
            "narrator": "雛",
            "text": "うん、うんうん！！\nそれでオッケー！！",
            "zh": "嗯，嗯嗯！！\n这样就可以了！！",
            "narrator_zh": "雏"
        },
        {
            "location": "601/TALK",
            "narrator": "雛",
            "text": "ついでにまゆちんも、\nまゆちんで良いから。",
            "zh": "顺便小茧也是，\n叫小茧就行。",
            "narrator_zh": "雏"
        },
        {
            "location": "602/TALK",
            "narrator": "つばめ",
            "text": "か、勝手に良いの？",
            "zh": "可、可以自作主张吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "605/TALK",
            "narrator": "雛",
            "text": "ねー、まゆちーん！\nそれでいいでしょー？",
            "zh": "对吧，小茧！\n这样可以吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "606/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "608/TALK",
            "narrator": "つばめ",
            "text": "無言ってことは…。",
            "zh": "不说话的意思是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "610/TALK",
            "narrator": "つばめ",
            "text": "…ま、まゆちん！\nよろしくね。",
            "zh": "……小、小茧！\n请多关照。",
            "narrator_zh": "燕"
        },
        {
            "location": "611/TALK",
            "narrator": "繭",
            "text": "…ええ。",
            "zh": "……嗯。",
            "narrator_zh": "茧"
        },
        {
            "location": "612/TALK",
            "narrator": "雛",
            "text": "ふふっ",
            "zh": "呵呵",
            "narrator_zh": "雏"
        },
        {
            "location": "615/TALK",
            "narrator": "雛",
            "text": "それじゃ、時間ないし急ご！",
            "zh": "那就，没时间了快走！",
            "narrator_zh": "雏"
        },
        {
            "location": "616/TALK",
            "narrator": "つばめ",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "619/TALK",
            "narrator": "つばめ",
            "text": "明るくて元気な\nひなこちゃんと――",
            "zh": "又开朗又有精神的\n小雏——",
            "narrator_zh": "燕"
        },
        {
            "location": "620/TALK",
            "narrator": "つばめ",
            "text": "ちょっと怖いけど、\n優しいまゆちん。",
            "zh": "有点可怕，\n但很温柔的小茧。",
            "narrator_zh": "燕"
        },
        {
            "location": "621/TALK",
            "narrator": "つばめ",
            "text": "こんなにいい友達が\n出来るなんて、\n凄く嬉しい！",
            "zh": "能交到这么好的朋友，\n真的，\n太高兴了！",
            "narrator_zh": "燕"
        },
        {
            "location": "632/DIALOG",
            "narrator": "Dialog_chapter_ch01",
            "text": "【03 赤い髪の転校生】",
            "zh": "【03 红发的转学生】",
            "narrator_zh": "Dialog_chapter_ch01"
        }
    ]
}
