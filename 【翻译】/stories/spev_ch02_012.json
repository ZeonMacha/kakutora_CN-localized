{
    "dir": "chap00/daydra/spev_ch02_012.js",
    "type": "",
    "info": {
        "story_id": "2012",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "星空ツーリング",
        "title_zh": "特别篇",
        "sub_title_zh": "星空巡游"
    },
    "entry": [
        {
            "location": "26/TALK",
            "narrator": "透明アーヤ",
            "text": "やっぱり、空の散歩は\n夜が一番ね。",
            "zh": "果然，在空中散步\n还是夜里最好。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "27/TALK",
            "narrator": "透明アーヤ",
            "text": "月明かりが優しいし、\n見下ろす街の灯りも\n綺麗だし。",
            "zh": "月光很温柔，\n俯瞰的城镇灯火\n也很漂亮。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "28/TALK",
            "narrator": "透明アーヤ",
            "text": "$handle$も\nそう思うでしょ？",
            "zh": "$handle$也\n这么想吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "29/SEL",
            "narrator": "（選択肢）",
            "text": "ホウキに乗せてください",
            "zh": "请让我坐上扫帚",
            "narrator_zh": "（选项）"
        },
        {
            "location": "30/ACT",
            "narrator": "",
            "text": "ホウキに乗せてください",
            "zh": "请让我坐上扫帚",
            "narrator_zh": ""
        },
        {
            "location": "32/TALK",
            "narrator": "透明アーヤ",
            "text": "残念だけど、このホウキは\n一人用なのよ。",
            "zh": "可惜，这把扫帚\n是单人的。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "透明アーヤ",
            "text": "でも、私の魔法で\n浮かせてあげてるんだから\n問題ないでしょ？",
            "zh": "不过，是我用魔法\n让你浮着的，\n没问题吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "34/SEL",
            "narrator": "（選択肢）",
            "text": "魔法で浮いてたのか…",
            "zh": "原来是靠魔法浮着的……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "35/SEL",
            "narrator": "（選択肢）",
            "text": "アーヤとくっつきたかった！",
            "zh": "想和绫水贴在一起！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "36/ACT",
            "narrator": "",
            "text": "魔法で浮いてたのか…",
            "zh": "原来是靠魔法浮着的……",
            "narrator_zh": ""
        },
        {
            "location": "39/TALK",
            "narrator": "透明アーヤ",
            "text": "今更！？",
            "zh": "现在才说！？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "透明アーヤ",
            "text": "今の今まで、\nどうやって浮いてると\n思ってたんだか…。",
            "zh": "直到刚才，\n你以为是怎么\n浮着的……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "41/ACT",
            "narrator": "",
            "text": "アーヤとくっつきたかった！",
            "zh": "想和绫水贴在一起！",
            "narrator_zh": ""
        },
        {
            "location": "43/TALK",
            "narrator": "透明アーヤ",
            "text": "あ、あのね…。\n変なこと考えてるでしょ？",
            "zh": "啊、那个……\n你在想奇怪的事吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "透明アーヤ",
            "text": "これでも、ホウキで\n飛ぶのって集中力が\nいるの。",
            "zh": "即便如此，骑扫帚\n飞也是需要\n集中力的。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "45/TALK",
            "narrator": "透明アーヤ",
            "text": "だから二人乗りは\nちょっと無理ね。\n集中が乱れそうだし。",
            "zh": "所以双人\n有点不行。\n集中会被打乱。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "48/TALK",
            "narrator": "透明アーヤ",
            "text": "それにしても、\n今日は風が気持ちいいわ。",
            "zh": "话说回来，\n今天的风很舒服。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "透明アーヤ",
            "text": "昨日は湿気がすごくて、\n戻ったときはびしょ濡れに\nなってたのよ。",
            "zh": "昨天湿气很重，\n回来的时候\n全身湿透了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "透明アーヤ",
            "text": "タイミングよく\nいい日に当たって\nよかったわね。",
            "zh": "时机刚好\n碰上好天气，\n真是太好了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "51/SEL",
            "narrator": "（選択肢）",
            "text": "悪天候の空も飛んでみたい",
            "zh": "恶劣天气的天空也想飞飞看",
            "narrator_zh": "（选项）"
        },
        {
            "location": "52/SEL",
            "narrator": "（選択肢）",
            "text": "アーヤと一緒なら天候は関係ない",
            "zh": "和绫水在一起的话，天气无所谓",
            "narrator_zh": "（选项）"
        },
        {
            "location": "53/ACT",
            "narrator": "",
            "text": "悪天候の空も飛んでみたい",
            "zh": "恶劣天气的天空也想飞飞看",
            "narrator_zh": ""
        },
        {
            "location": "55/TALK",
            "narrator": "透明アーヤ",
            "text": "バカなこと言わないの。",
            "zh": "别说傻话。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "56/TALK",
            "narrator": "透明アーヤ",
            "text": "空を飛ぶ上で天候は\n一番気にかけないと\nいけないことなのよ？",
            "zh": "在天上飞，天气是\n最必须留意的\n事吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "57/TALK",
            "narrator": "透明アーヤ",
            "text": "私も雨の日に飛んだら、\n雷に打たれて死にそうに\nなったことあったし…。",
            "zh": "我也有过下雨天飞，\n被雷劈得\n差点死掉。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "58/ACT",
            "narrator": "",
            "text": "アーヤと一緒なら天候は関係ない",
            "zh": "和绫水在一起的话，天气无所谓",
            "narrator_zh": ""
        },
        {
            "location": "60/TALK",
            "narrator": "透明アーヤ",
            "text": "ふふっ、そう言って\nくれるのは嬉しいけど…。",
            "zh": "呵呵，你这么说\n我是高兴……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "透明アーヤ",
            "text": "でも、せっかく飛ぶなら\nいい天気の方が\n気持ちよくていいわよ？",
            "zh": "不过，既然要飞\n还是好天气\n更舒服吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "透明アーヤ",
            "text": "それに、酷いときだと\n雷に打たれることも\nあるんだし…。",
            "zh": "而且，严重的时候\n也会被雷劈\n……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "65/SEL",
            "narrator": "（選択肢）",
            "text": "打たれたことあるの？",
            "zh": "你被劈过吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "66/ACT",
            "narrator": "",
            "text": "打たれたことあるの？",
            "zh": "你被劈过吗？",
            "narrator_zh": ""
        },
        {
            "location": "69/TALK",
            "narrator": "透明アーヤ",
            "text": "そりゃね。\n魔女なら誰でも一度は\nあるんじゃないかしら？",
            "zh": "那当然。\n魔女的话，谁都有过\n一次吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "透明アーヤ",
            "text": "まあ、ホウキの周りに\n障壁張ってるから、\n打たれても平気だけど。",
            "zh": "不过，扫帚周围\n张着屏障，\n被劈到也没事。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "透明アーヤ",
            "text": "…あ、いけない。\n$handle$に障壁\n張るの忘れてた。",
            "zh": "……啊，糟了。\n给$handle$张屏障\n我忘了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "72/SEL",
            "narrator": "（選択肢）",
            "text": "晴れてるから平気だよ",
            "zh": "天晴着，没关系",
            "narrator_zh": "（选项）"
        },
        {
            "location": "73/ACT",
            "narrator": "",
            "text": "晴れてるから平気だよ",
            "zh": "天晴着，没关系",
            "narrator_zh": ""
        },
        {
            "location": "76/TALK",
            "narrator": "透明アーヤ",
            "text": "油断するのはよくないと\n思うけど？",
            "zh": "大意可不好，\n我觉得？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "77/TALK",
            "narrator": "透明アーヤ",
            "text": "空飛んでるとね、\n本当色んな危険なことが\nあるんだから。",
            "zh": "在天上飞的话，\n真的会有各种\n危险的事。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "透明アーヤ",
            "text": "地上から、未確認飛行物体\n扱いされて打たれることも\nあるし…。",
            "zh": "也会被地上当成\n不明飞行物\n打下来……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "透明アーヤ",
            "text": "障害物もないから、\n居眠りしそうになることも\n結構あるし。",
            "zh": "也没有障碍物，\n经常会\n犯困打瞌睡。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "透明アーヤ",
            "text": "…改めて思うと、\n空を飛ぶのって\n危険なことばかりだわ。",
            "zh": "……重新一想，\n在天上飞\n净是危险的事。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "81/SEL",
            "narrator": "（選択肢）",
            "text": "それでも飛ぶんだ？",
            "zh": "即便如此也要飞？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "82/ACT",
            "narrator": "",
            "text": "それでも飛ぶんだ？",
            "zh": "即便如此也要飞？",
            "narrator_zh": ""
        },
        {
            "location": "84/TALK",
            "narrator": "透明アーヤ",
            "text": "そりゃそうよ。",
            "zh": "那当然。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "透明アーヤ",
            "text": "空飛ばない魔女なんて\n聞いたことないわ。",
            "zh": "不飞天的魔女\n我可没听说过。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "透明アーヤ",
            "text": "それに、このホウキだって\nまだローン残ってるん\nだから…。",
            "zh": "而且，这把扫帚\n分期还没还完\n……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "透明アーヤ",
            "text": "…魔女用のホウキって、\nすっごく高いのよ？",
            "zh": "……魔女用的扫帚，\n非常贵吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "透明アーヤ",
            "text": "ま、それはそうと、\nそろそろ聞かせて\nもらえない？",
            "zh": "那个先不说，\n差不多可以告诉我\n了吗？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "91/TALK",
            "narrator": "透明アーヤ",
            "text": "空を飛んでる気分は、\nどんな感じ？",
            "zh": "在天上飞的感觉，\n是什么样？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "92/SEL",
            "narrator": "（選択肢）",
            "text": "最高だよ",
            "zh": "最好了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "93/SEL",
            "narrator": "（選択肢）",
            "text": "ちょっと怖いかも",
            "zh": "可能有点害怕",
            "narrator_zh": "（选项）"
        },
        {
            "location": "94/ACT",
            "narrator": "",
            "text": "最高だよ",
            "zh": "最好了",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "透明アーヤ",
            "text": "よかった…。",
            "zh": "太好了……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "96/TALK",
            "narrator": "透明アーヤ",
            "text": "喜んでもらえたなら、\n誘った甲斐があったわ。",
            "zh": "你能高兴的话，\n邀请就值得了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "97/TALK",
            "narrator": "透明アーヤ",
            "text": "高いところ苦手だったら\nどうしようかと\n思ってたの。",
            "zh": "要是你怕高\n该怎么办，\n我还想过。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "98/ACT",
            "narrator": "",
            "text": "ちょっと怖いかも",
            "zh": "可能有点害怕",
            "narrator_zh": ""
        },
        {
            "location": "99/TALK",
            "narrator": "透明アーヤ",
            "text": "あはは、もしかして\n高所恐怖症？",
            "zh": "啊哈哈，难道\n有恐高症？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "100/TALK",
            "narrator": "透明アーヤ",
            "text": "大丈夫よ。\nそんな怖がらなくても\n落ちたりしないから。",
            "zh": "没关系。\n不用那么怕，\n不会掉下去的。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "102/TALK",
            "narrator": "透明アーヤ",
            "text": "さてと、せっかくだし、\nもう少し高度上げよう\nかしら？",
            "zh": "那么，难得，\n再飞高一点\n好了？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "透明アーヤ",
            "text": "思い切って、\n雲の上まで行きましょ。",
            "zh": "干脆，\n飞到云上面去吧。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "112/TALK",
            "narrator": "透明アーヤ",
            "text": "きゃっ！？",
            "zh": "呀！？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "117/TALK",
            "narrator": "透明アーヤ",
            "text": "あっ、いけない！",
            "zh": "啊，糟了！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "122/TALK",
            "narrator": "透明アーヤ",
            "text": "ふぅ…危なかった。\nごめんなさい、\n驚かせちゃった？",
            "zh": "呼……好险。\n对不起，\n吓到你了？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "123/SEL",
            "narrator": "（選択肢）",
            "text": "今のなに！？　どうしたの！？",
            "zh": "刚才那是什么！？　怎么了！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "124/ACT",
            "narrator": "",
            "text": "今のなに！？　どうしたの！？",
            "zh": "刚才那是什么！？　怎么了！？",
            "narrator_zh": ""
        },
        {
            "location": "128/TALK",
            "narrator": "透明アーヤ",
            "text": "あ、あはは…突風に驚いて\n集中が切れちゃって…。",
            "zh": "啊、啊哈哈……被急风吓到，\n集中断了……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "透明アーヤ",
            "text": "$handle$にかけた\n魔法が、ほんの一瞬だけ\n切れちゃったのよ。",
            "zh": "给$handle$施的\n魔法，只有一瞬间\n断掉了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "透明アーヤ",
            "text": "でも、もう大丈夫。\nすぐにかけ直したから\n心配無用よ。",
            "zh": "不过，已经没事了。\n马上重新施上了，\n不用担心。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "131/SEL",
            "narrator": "（選択肢）",
            "text": "本当に大丈夫なの？",
            "zh": "真的没事吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "132/SEL",
            "narrator": "（選択肢）",
            "text": "もう帰りたい…",
            "zh": "想回去了……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "133/ACT",
            "narrator": "",
            "text": "本当に大丈夫なの？",
            "zh": "真的没事吗？",
            "narrator_zh": ""
        },
        {
            "location": "134/TALK",
            "narrator": "透明アーヤ",
            "text": "だ、大丈夫よ！\n私を信じて。",
            "zh": "没、没事！\n相信我。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "135/ACT",
            "narrator": "",
            "text": "もう帰りたい…",
            "zh": "想回去了……",
            "narrator_zh": ""
        },
        {
            "location": "137/TALK",
            "narrator": "透明アーヤ",
            "text": "ご、ごめんなさい。\n怖かったわよね？",
            "zh": "对、对不起。\n害怕了吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "透明アーヤ",
            "text": "お詫びに、雲の上の\n綺麗な景色を見せるから、\nそれで許して。",
            "zh": "作为道歉，我给你看\n云上的漂亮景色，\n就原谅我吧。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "141/TALK",
            "narrator": "透明アーヤ",
            "text": "それじゃ今度こそ、\n高度上げるわよ！",
            "zh": "那么这次一定，\n再飞高了！",
            "narrator_zh": "透明绫水"
        }
    ]
}
