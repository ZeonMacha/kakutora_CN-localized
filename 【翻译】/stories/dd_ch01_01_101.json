{
    "dir": "chap01/daydra/dd_ch01_01_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "1102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "逢瀬つばめという存在＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "名为逢濑燕的存在＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "導入",
            "zh": "开场",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "つばめ",
            "text": "タオルと歯ブラシと、\nあと……",
            "zh": "毛巾和牙刷，\n还有……",
            "narrator_zh": "燕"
        },
        {
            "location": "29/TALK",
            "narrator": "つばめ",
            "text": "東京の地図と、\nガイドと、アプリと、\n電車の乗り換え案内…",
            "zh": "东京的地图，\n旅游指南、应用，\n还有电车换乘查询……",
            "narrator_zh": "燕"
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "服は４着、\n下着は…\n５つもあればいいか。",
            "zh": "衣服四套，\n内衣……\n有五件就够了吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "33/TALK",
            "narrator": "つばめ",
            "text": "これで準備オッケー！\n…だよね。",
            "zh": "这样准备就好啦！\n……对吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "34/TALK",
            "narrator": "つばめ",
            "text": "はぁ……\nいよいよ明日かぁ。",
            "zh": "哈啊……\n明天终于到了呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "メノウちゃんの\nライブ！",
            "zh": "MENOW的\n演出！",
            "narrator_zh": "燕"
        },
        {
            "location": "37/TALK",
            "narrator": "つばめ",
            "text": "もうドキドキが\n止まらないよ。今日\nちゃんと寝れるかな。",
            "zh": "心跳已经\n停不下来啦。今天\n能好好睡着吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "44/TALK",
            "narrator": "つばめ",
            "text": "あ、お父さんだ！",
            "zh": "啊，是爸爸！",
            "narrator_zh": "燕"
        },
        {
            "location": "71/TALK",
            "narrator": "つばめ",
            "text": "おかえりなさい！",
            "zh": "欢迎回来！",
            "narrator_zh": "燕"
        },
        {
            "location": "78/TALK",
            "narrator": "啓介",
            "text": "ああ、ただいま。\n遅くなった。",
            "zh": "啊，我回来了。\n回来晚了。",
            "narrator_zh": "启介"
        },
        {
            "location": "79/TALK",
            "narrator": "啓介",
            "text": "ちゃんと飯は食ったか。\n何か変わったことは\n無いか？",
            "zh": "饭好好吃了吗？\n有没有发生\n什么事？",
            "narrator_zh": "启介"
        },
        {
            "location": "81/TALK",
            "narrator": "つばめ",
            "text": "大丈夫。\nわたしは何ともないよ。",
            "zh": "没事的。\n我什么事都没有哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "82/TALK",
            "narrator": "つばめ",
            "text": "それより、\nお母さんどうだった？",
            "zh": "比起这个，\n妈妈怎么样？",
            "narrator_zh": "燕"
        },
        {
            "location": "84/TALK",
            "narrator": "啓介",
            "text": "ん？\nああ……、まあ、\nいつも通りだ。",
            "zh": "嗯？\n啊……还好，\n和平时一样。",
            "narrator_zh": "启介"
        },
        {
            "location": "87/TALK",
            "narrator": "つばめ",
            "text": "もしかして、\nまた調子悪く\nなっちゃったの？",
            "zh": "难道说，\n又变得不舒服\n了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "89/TALK",
            "narrator": "啓介",
            "text": "いや、\nそんな事はない。\n大丈夫だ。",
            "zh": "不，\n没有那回事。\n不要紧。",
            "narrator_zh": "启介"
        },
        {
            "location": "90/TALK",
            "narrator": "つばめ",
            "text": "ウソだよ！　お父さん\nすぐ顔に出るもん。\n本当のこと言って。",
            "zh": "骗人呀！爸爸\n马上就写在脸上啦。\n说真话。",
            "narrator_zh": "燕"
        },
        {
            "location": "92/TALK",
            "narrator": "啓介",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "启介"
        },
        {
            "location": "93/TALK",
            "narrator": "啓介",
            "text": "…だいぶ\n痛むようでな。",
            "zh": "……似乎\n疼得挺厉害。",
            "narrator_zh": "启介"
        },
        {
            "location": "94/TALK",
            "narrator": "つばめ",
            "text": "え……",
            "zh": "诶……",
            "narrator_zh": "燕"
        },
        {
            "location": "96/TALK",
            "narrator": "啓介",
            "text": "いつもの発作だ。\n俺が付き添うから、\n何の心配もない。",
            "zh": "是平时那种发作。\n有我陪着，\n没什么可担心的。",
            "narrator_zh": "启介"
        },
        {
            "location": "97/TALK",
            "narrator": "つばめ",
            "text": "でも！",
            "zh": "可是！",
            "narrator_zh": "燕"
        },
        {
            "location": "98/TALK",
            "narrator": "啓介",
            "text": "お前、明日から\n東京だろう。\n今日は早く寝なさい。",
            "zh": "你明天起\n就要去东京了吧。\n今天早点睡。",
            "narrator_zh": "启介"
        },
        {
            "location": "102/TALK",
            "narrator": "つばめ",
            "text": "ああっ！\nちょっと、お父さん！",
            "zh": "啊啊！\n等一下，爸爸！",
            "narrator_zh": "燕"
        },
        {
            "location": "122/TALK",
            "narrator": "つばめ",
            "text": "お父さん。わたし、\n明日の東京行き\nやめるよ。",
            "zh": "爸爸。我\n明天不去\n东京啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "124/TALK",
            "narrator": "啓介",
            "text": "何を言ってる。\nずっと楽しみに\nしてたんだろ。",
            "zh": "你在说什么。\n你不是一直\n很期待吧。",
            "narrator_zh": "启介"
        },
        {
            "location": "125/TALK",
            "narrator": "つばめ",
            "text": "お母さんが調子悪い\nのに、東京になんて\n行けないよ。",
            "zh": "妈妈不舒服，\n这种时候怎么能\n去东京呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "127/TALK",
            "narrator": "啓介",
            "text": "だから心配するなと…",
            "zh": "所以说了别担心……",
            "narrator_zh": "启介"
        },
        {
            "location": "129/TALK",
            "narrator": "つばめ",
            "text": "そんなの無理だよ。",
            "zh": "那不可能呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "132/TALK",
            "narrator": "啓介",
            "text": "お前だって\nずっと頑張ってきた。",
            "zh": "你自己也\n一直很努力。",
            "narrator_zh": "启介"
        },
        {
            "location": "134/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "135/TALK",
            "narrator": "啓介",
            "text": "２年間ずっと、\n行きたくても頑張って\n我慢してきただろ。",
            "zh": "整整两年，\n想去也拼命\n忍下来了吧。",
            "narrator_zh": "启介"
        },
        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "……お父さん。",
            "zh": "……爸爸。",
            "narrator_zh": "燕"
        },
        {
            "location": "139/TALK",
            "narrator": "啓介",
            "text": "だから、行ってこい。\n明日は駅まで送ってやる。",
            "zh": "所以，去吧。\n明天我送你到车站。",
            "narrator_zh": "启介"
        },
        {
            "location": "141/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "159/TALK",
            "narrator": "つばめ",
            "text": "はぁ……\nそんなこと言われてもなぁ。",
            "zh": "哈啊……\n就算你这么说呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "160/TALK",
            "narrator": "つばめ",
            "text": "お母さん調子悪いのに\nわたし一人だけ\n楽しめないよ……",
            "zh": "妈妈不舒服，\n就我一个人\n开心不起来呀……",
            "narrator_zh": "燕"
        },
        {
            "location": "162/TALK",
            "narrator": "つばめ",
            "text": "はぁ……",
            "zh": "哈啊……",
            "narrator_zh": "燕"
        },
        {
            "location": "163/TALK",
            "narrator": "つばめ",
            "text": "やっぱり行くの\nやめようかなぁ……",
            "zh": "果然还是\n别去了吧……",
            "narrator_zh": "燕"
        },
        {
            "location": "208/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "217/TALK",
            "narrator": "千羽鶴",
            "text": "[ココロスフィア]の説明は\n前に私がしてると思うけど\nもう一度聞く？",
            "zh": "[心灵领域]的说明\n我想之前已经讲过了，\n要再听一次吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "218/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "要",
            "narrator_zh": ""
        },
        {
            "location": "219/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "不要",
            "narrator_zh": ""
        },
        {
            "location": "220/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "要",
            "narrator_zh": ""
        },
        {
            "location": "221/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "223/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不要",
            "narrator_zh": ""
        },
        {
            "location": "231/TALK",
            "narrator": "千羽鶴",
            "text": "ようこそ。",
            "zh": "欢迎。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "232/SEL",
            "narrator": "",
            "text": "ここは…精神世界？",
            "zh": "这里是……精神世界？",
            "narrator_zh": ""
        },
        {
            "location": "233/ACT",
            "narrator": "",
            "text": "ここは…精神世界？",
            "zh": "这里是……精神世界？",
            "narrator_zh": ""
        },
        {
            "location": "235/TALK",
            "narrator": "千羽鶴",
            "text": "そう。\nバトル説明で入ったのと\n同じ、精神世界。",
            "zh": "是的。\n和战斗说明里进去的\n是同一个精神世界。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "236/TALK",
            "narrator": "千羽鶴",
            "text": "ここは、後ろにいる\n彼女、逢瀬つばめの\n精神世界の入口――",
            "zh": "这里是，身后的\n她，逢濑燕的\n精神世界入口——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "237/TALK",
            "narrator": "千羽鶴",
            "text": "通称<color=red>【[ココロゲート]】</color>\nと呼ばれている場所。",
            "zh": "通称为<color=red>【[心之扉]】</color>\n的地方。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "238/TALK",
            "narrator": "千羽鶴",
            "text": "ここでは彼女は\nあなたと普通に\n対話できる。",
            "zh": "在这里，她可以\n和你正常地\n对话。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "239/TALK",
            "narrator": "千羽鶴",
            "text": "彼女の心に直接\n語りかけることで、\n心を動かすの。",
            "zh": "直接向她的心\n诉说，\n就能打动她。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "240/TALK",
            "narrator": "千羽鶴",
            "text": "早速、\n彼女に話しかけてみて。",
            "zh": "马上，\n试着和她说话。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "249/SEL",
            "narrator": "",
            "text": "やあ",
            "zh": "你好",
            "narrator_zh": ""
        },
        {
            "location": "250/ACT",
            "narrator": "",
            "text": "やあ",
            "zh": "你好",
            "narrator_zh": ""
        },
        {
            "location": "253/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "254/TALK",
            "narrator": "つばめ",
            "text": "あなた、誰ですか？",
            "zh": "请问你是谁？",
            "narrator_zh": "燕"
        },
        {
            "location": "255/SEL",
            "narrator": "",
            "text": "君の将来のフィアンセだよ",
            "zh": "我是你将来的费昂塞哦",
            "narrator_zh": ""
        },
        {
            "location": "256/SEL",
            "narrator": "",
            "text": "はじめまして、$handle$です",
            "zh": "初次见面，我是$handle$",
            "narrator_zh": ""
        },
        {
            "location": "257/SEL",
            "narrator": "",
            "text": "逢瀬つばめちゃん？",
            "zh": "逢濑燕？",
            "narrator_zh": ""
        },
        {
            "location": "258/ACT",
            "narrator": "",
            "text": "君の将来のフィアンセだよ",
            "zh": "我是你将来的费昂塞哦",
            "narrator_zh": ""
        },
        {
            "location": "260/TALK",
            "narrator": "つばめ",
            "text": "えっ！？　わたしの\nフィアンセ！？",
            "zh": "诶！？我的\n费昂塞！？",
            "narrator_zh": "燕"
        },
        {
            "location": "261/TALK",
            "narrator": "つばめ",
            "text": "あの……",
            "zh": "那个……",
            "narrator_zh": "燕"
        },
        {
            "location": "262/TALK",
            "narrator": "つばめ",
            "text": "それって、お菓子か\n何かでしたっけ？",
            "zh": "那个，是点心\n什么的来着？",
            "narrator_zh": "燕"
        },
        {
            "location": "263/SEL",
            "narrator": "",
            "text": "それはフィナンシェや！",
            "zh": "那是费南雪啦！杏仁小蛋糕那种。",
            "narrator_zh": ""
        },
        {
            "location": "264/ACT",
            "narrator": "",
            "text": "それはフィナンシェや！",
            "zh": "那是费南雪啦！杏仁小蛋糕那种。",
            "narrator_zh": ""
        },
        {
            "location": "266/TALK",
            "narrator": "つばめ",
            "text": "あ、そうでした！\nそれです！\nスッキリしました。",
            "zh": "啊，对了！\n就是那个！\n一下子清楚了。",
            "narrator_zh": "燕"
        },
        {
            "location": "276/TALK",
            "narrator": "つばめ",
            "text": "それでは\nフィナンシェさん。",
            "zh": "那么，\n费南雪。",
            "narrator_zh": "燕"
        },
        {
            "location": "277/SEL",
            "narrator": "",
            "text": "あ、はい…",
            "zh": "啊，是……",
            "narrator_zh": ""
        },
        {
            "location": "278/ACT",
            "narrator": "",
            "text": "あ、はい…",
            "zh": "啊，是……",
            "narrator_zh": ""
        },
        {
            "location": "280/ACT",
            "narrator": "",
            "text": "はじめまして、$handle$です",
            "zh": "初次见面，我是$handle$",
            "narrator_zh": ""
        },
        {
            "location": "281/TALK",
            "narrator": "つばめ",
            "text": "$handle$…さん？",
            "zh": "$handle$……？",
            "narrator_zh": "燕"
        },
        {
            "location": "282/ACT",
            "narrator": "",
            "text": "逢瀬つばめちゃん？",
            "zh": "逢濑燕？",
            "narrator_zh": ""
        },
        {
            "location": "283/TALK",
            "narrator": "つばめ",
            "text": "そうですね。\n厳密には……わたしは\nその一人格です。",
            "zh": "说得对。\n严格来说……我是\n其中的一个人格。",
            "narrator_zh": "燕"
        },
        {
            "location": "285/TALK",
            "narrator": "つばめ",
            "text": "わたしは逢瀬つばめの\nココロを管理する人格。",
            "zh": "我是管理逢濑燕\n内心的人格。",
            "narrator_zh": "燕"
        },
        {
            "location": "286/TALK",
            "narrator": "つばめ",
            "text": "ここ<color=red>【[ココロゲート]】</color>\nで、私の持つ想いや\n感情を管理してます。",
            "zh": "这里<color=red>【[心之扉]】</color>，\n我在管理自己的心意\n和情感。",
            "narrator_zh": "燕"
        },
        {
            "location": "287/TALK",
            "narrator": "つばめ",
            "text": "いわば、[ココロの司書]\nとでも言いましょうか。",
            "zh": "不妨说，就是\n[心之司书]吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "289/SEL",
            "narrator": "",
            "text": "なるほど！",
            "zh": "原来如此！",
            "narrator_zh": ""
        },
        {
            "location": "290/SEL",
            "narrator": "",
            "text": "もう知ってる",
            "zh": "已经知道了",
            "narrator_zh": ""
        },
        {
            "location": "291/ACT",
            "narrator": "",
            "text": "なるほど！",
            "zh": "原来如此！",
            "narrator_zh": ""
        },
        {
            "location": "293/ACT",
            "narrator": "",
            "text": "もう知ってる",
            "zh": "已经知道了",
            "narrator_zh": ""
        },
        {
            "location": "297/SEL",
            "narrator": "",
            "text": "なるほど！",
            "zh": "原来如此！",
            "narrator_zh": ""
        },
        {
            "location": "298/ACT",
            "narrator": "",
            "text": "なるほど！",
            "zh": "原来如此！",
            "narrator_zh": ""
        },
        {
            "location": "303/TALK",
            "narrator": "つばめ",
            "text": "あらら、\n既に経験済みでした。",
            "zh": "哎呀，\n原来已经体验过了。",
            "narrator_zh": "燕"
        },
        {
            "location": "304/TALK",
            "narrator": "つばめ",
            "text": "説明は\n飛ばしていきますね！",
            "zh": "说明就\n跳过啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "307/TALK",
            "narrator": "つばめ",
            "text": "つばめの喜怒哀楽、\n悩み、記憶等は全て\nここに繋がってます。",
            "zh": "燕的喜怒哀乐、\n烦恼、记忆等等，全部\n都连在这里。",
            "narrator_zh": "燕"
        },
        {
            "location": "308/TALK",
            "narrator": "つばめ",
            "text": "それらは１つずつ\n番号付きの部屋に\n収められています。",
            "zh": "它们一件一件\n收在带编号的\n房间里。",
            "narrator_zh": "燕"
        },
        {
            "location": "309/TALK",
            "narrator": "つばめ",
            "text": "通常、わたしが平常心で\nいる時は、それらの扉は\n必要に応じて開くんです。",
            "zh": "平时，我心平气和\n的时候，那些门\n会在需要时打开。",
            "narrator_zh": "燕"
        },
        {
            "location": "310/TALK",
            "narrator": "つばめ",
            "text": "ですが、今のように\n迷っている状態では、\n適切な扉が開きません。",
            "zh": "但是，像现在这样\n正在犹豫的时候，\n合适的门打不开。",
            "narrator_zh": "燕"
        },
        {
            "location": "311/TALK",
            "narrator": "つばめ",
            "text": "場合によっては、\n間違った扉が\n開いてしまう。",
            "zh": "有的时候，\n错误的门\n还会被打开。",
            "narrator_zh": "燕"
        },
        {
            "location": "312/SEL",
            "narrator": "",
            "text": "それは、選択をミスってしまうってこと？",
            "zh": "就是说，选择会出错，对吗？",
            "narrator_zh": ""
        },
        {
            "location": "313/ACT",
            "narrator": "",
            "text": "それは、選択をミスってしまうってこと？",
            "zh": "就是说，选择会出错，对吗？",
            "narrator_zh": ""
        },
        {
            "location": "315/TALK",
            "narrator": "つばめ",
            "text": "まさにその通りです！",
            "zh": "正是这样！",
            "narrator_zh": "燕"
        },
        {
            "location": "316/TALK",
            "narrator": "つばめ",
            "text": "わたしは司書ですから、\nどの扉がわたしにとって\n正しいか分かっています。",
            "zh": "因为我是司书，\n哪一扇门对我而言\n是对的，我知道。",
            "narrator_zh": "燕"
        },
        {
            "location": "317/TALK",
            "narrator": "つばめ",
            "text": "ですが、扉を開く力は\nわたしにはありません。",
            "zh": "但是，开门的力量\n我并没有。",
            "narrator_zh": "燕"
        },
        {
            "location": "318/TALK",
            "narrator": "つばめ",
            "text": "だから、\n$handle$さんに\n手伝って欲しいのです。",
            "zh": "所以，\n想请$handle$\n来帮帮我。",
            "narrator_zh": "燕"
        },
        {
            "location": "319/SEL",
            "narrator": "",
            "text": "どうやって？",
            "zh": "要怎么做？",
            "narrator_zh": ""
        },
        {
            "location": "320/ACT",
            "narrator": "",
            "text": "どうやって？",
            "zh": "要怎么做？",
            "narrator_zh": ""
        },
        {
            "location": "322/TALK",
            "narrator": "つばめ",
            "text": "正しい扉の選択を阻止する\n<color=red>【[クラン]】</color>という存在を\n倒すのを手伝ってください。",
            "zh": "会阻止选中正确门的\n<color=red>【[库兰]】</color>这个存在，\n请帮我把它打倒。",
            "narrator_zh": "燕"
        },
        {
            "location": "323/TALK",
            "narrator": "つばめ",
            "text": "<color=red>【[クラン]】</color>とは、わたしの\n不安や恐れが、あまりに\n大きくなってしまった物。",
            "zh": "<color=red>【[库兰]】</color>是我的\n不安和恐惧变得\n过于庞大后的东西。",
            "narrator_zh": "燕"
        },
        {
            "location": "324/TALK",
            "narrator": "つばめ",
            "text": "その<color=red>【[クラン]】</color>が\n正しい扉に入るのを\n妨害してしまうのです。",
            "zh": "那个<color=red>【[库兰]】</color>\n会妨碍进入\n正确的门。",
            "narrator_zh": "燕"
        },
        {
            "location": "325/TALK",
            "narrator": "つばめ",
            "text": "扉の前には、<color=red>【[クラン]】</color>を\n倒せず困ってるわたしが\nいます。",
            "zh": "门前，有打不倒<color=red>【[库兰]】</color>、\n正为此犯难的\n我。",
            "narrator_zh": "燕"
        },
        {
            "location": "326/TALK",
            "narrator": "つばめ",
            "text": "どうか、彼女に力を\n貸してあげてください！",
            "zh": "请一定，把力量\n借给她！",
            "narrator_zh": "燕"
        },
        {
            "location": "328/TALK",
            "narrator": "つばめ",
            "text": "やっていただけますか？",
            "zh": "可以拜托你吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "329/SEL",
            "narrator": "",
            "text": "オッケー",
            "zh": "好",
            "narrator_zh": ""
        },
        {
            "location": "330/SEL",
            "narrator": "",
            "text": "やだ",
            "zh": "不要",
            "narrator_zh": ""
        },
        {
            "location": "331/ACT",
            "narrator": "",
            "text": "オッケー",
            "zh": "好",
            "narrator_zh": ""
        },
        {
            "location": "332/TALK",
            "narrator": "つばめ",
            "text": "ありがとうございます！",
            "zh": "谢谢你！",
            "narrator_zh": "燕"
        },
        {
            "location": "333/ACT",
            "narrator": "",
            "text": "やだ",
            "zh": "不要",
            "narrator_zh": ""
        },
        {
            "location": "334/TALK",
            "narrator": "つばめ",
            "text": "ふえぇぇ…\nそれは困ります…っ。",
            "zh": "呜诶诶……\n那样我很难办啦……",
            "narrator_zh": "燕"
        },
        {
            "location": "339/TALK",
            "narrator": "つばめ",
            "text": "それじゃ早速、\n今回の<color=red>【適切な扉】</color>を\nコールします。",
            "zh": "那就马上，\n这次的<color=red>【合适的门】</color>\n我来呼叫。",
            "narrator_zh": "燕"
        },
        {
            "location": "347/TALK",
            "narrator": "つばめ",
            "text": "オープンプロセス、\n0x023番地から\n0x571番地へ。",
            "zh": "开放进程，\n从0x023地址\n到0x571地址。",
            "narrator_zh": "燕"
        },
        {
            "location": "362/TALK",
            "narrator": "つばめ",
            "text": "シーク完了しました。",
            "zh": "搜索完成。",
            "narrator_zh": "燕"
        },
        {
            "location": "363/TALK",
            "narrator": "つばめ",
            "text": "この扉に、今回の悩みの\n根源になっている\n<color=red>【[クラン]】</color>がいます。",
            "zh": "这扇门里，有着成为\n这次烦恼根源的\n<color=red>【[库兰]】</color>。",
            "narrator_zh": "燕"
        },
        {
            "location": "365/TALK",
            "narrator": "つばめ",
            "text": "今回の悩みは、母を置いて\n東京へ行くことの罪悪感。",
            "zh": "这次的烦恼，是抛下母亲\n去东京的罪恶感。",
            "narrator_zh": "燕"
        },
        {
            "location": "366/TALK",
            "narrator": "つばめ",
            "text": "ですが、その件はココロ\nファイルNo.01-332-55\nにて既に解決済みです。",
            "zh": "但是，这件事\n在心之档案No.01-332-55\n里已经解决了。",
            "narrator_zh": "燕"
        },
        {
            "location": "370/TALK",
            "narrator": "つばめ",
            "text": "ココロファイル\nNo.01-332-55には\nこう記されています。",
            "zh": "心之档案\nNo.01-332-55里\n是这样写的。",
            "narrator_zh": "燕"
        },
        {
            "location": "371/TALK",
            "narrator": "つばめ",
            "text": "『わたしが東京へ\nライブを見に行くことは、\n母と共に決めたこと』",
            "zh": "『我去东京\n看演出这件事，\n是和母亲一起决定的』",
            "narrator_zh": "燕"
        },
        {
            "location": "372/TALK",
            "narrator": "つばめ",
            "text": "『長い間入院していた\nわたしに、母が快気祝いと\nしてくれた旅行です』",
            "zh": "『长久住院的我，\n母亲把这趟旅行\n当作康复贺礼送给了我』",
            "narrator_zh": "燕"
        },
        {
            "location": "373/TALK",
            "narrator": "つばめ",
            "text": "『それをわたしの判断で\nとりやめたら、むしろ母は\nとても悲しみます』",
            "zh": "『要是我自己决定\n取消的话，母亲反而会\n非常伤心』",
            "narrator_zh": "燕"
        },
        {
            "location": "374/TALK",
            "narrator": "つばめ",
            "text": "『自分のせいで、と\n自責の念も生まれる\nでしょう』",
            "zh": "『“都怪自己”，\n这样的自责\n也会产生吧』",
            "narrator_zh": "燕"
        },
        {
            "location": "375/TALK",
            "narrator": "つばめ",
            "text": "『よって、最大幸福論から\n見れば、東京行きは決行\nするべきなのです』",
            "zh": "『因此，从最大幸福论\n来看，东京之行\n应当成行』",
            "narrator_zh": "燕"
        },
        {
            "location": "376/TALK",
            "narrator": "つばめ",
            "text": "以上。",
            "zh": "以上。",
            "narrator_zh": "燕"
        },
        {
            "location": "377/TALK",
            "narrator": "つばめ",
            "text": "わたしのココロに賛同し、\nその支援を\nしてくれますか？",
            "zh": "你愿意认同我的心，\n并来\n支援它吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "378/SEL",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "379/SEL",
            "narrator": "",
            "text": "本当にそれが正しいの？",
            "zh": "那样真的是对的吗？",
            "narrator_zh": ""
        },
        {
            "location": "380/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "382/TALK",
            "narrator": "つばめ",
            "text": "ありがとうございます！",
            "zh": "谢谢你！",
            "narrator_zh": "燕"
        },
        {
            "location": "383/TALK",
            "narrator": "つばめ",
            "text": "それじゃ、\n扉にアクセスしますよ？\n準備はいいですか？",
            "zh": "那么，\n要访问这扇门了哦？\n准备好了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "384/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！",
            "zh": "献给$handle$和\n我的，\n美妙心灵之旅！",
            "narrator_zh": "燕"
        },
        {
            "location": "391/ACT",
            "narrator": "",
            "text": "本当にそれが正しいの？",
            "zh": "那样真的是对的吗？",
            "narrator_zh": ""
        },
        {
            "location": "392/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんや\n他の人にとっては\nどうかわかりません。",
            "zh": "对$handle$也好，\n对其他人也好，\n我不知道对不对。",
            "narrator_zh": "燕"
        },
        {
            "location": "393/TALK",
            "narrator": "つばめ",
            "text": "ですが、少なくとも\nわたしの本音としては\nこれが一番なんです。",
            "zh": "但是，至少\n作为我的真心话，\n这是最好的。",
            "narrator_zh": "燕"
        },
        {
            "location": "394/TALK",
            "narrator": "つばめ",
            "text": "ですから、もしわたしの\n結論に賛成できない場合、\n協力しないのもアリです。",
            "zh": "所以，要是不能\n同意我的结论，\n不帮忙也可以。",
            "narrator_zh": "燕"
        },
        {
            "location": "395/TALK",
            "narrator": "つばめ",
            "text": "どうしますか？",
            "zh": "你要怎么办？",
            "narrator_zh": "燕"
        },
        {
            "location": "396/SEL",
            "narrator": "",
            "text": "協力する",
            "zh": "帮忙",
            "narrator_zh": ""
        },
        {
            "location": "397/SEL",
            "narrator": "",
            "text": "協力しない",
            "zh": "不帮忙",
            "narrator_zh": ""
        },
        {
            "location": "398/ACT",
            "narrator": "",
            "text": "協力する",
            "zh": "帮忙",
            "narrator_zh": ""
        },
        {
            "location": "400/ACT",
            "narrator": "",
            "text": "協力しない",
            "zh": "不帮忙",
            "narrator_zh": ""
        },
        {
            "location": "401/TALK",
            "narrator": "つばめ",
            "text": "わかりました。\n残念ですけど、\n仕方ないですよね。",
            "zh": "我知道了。\n虽然很遗憾，\n这也没办法呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "402/TALK",
            "narrator": "つばめ",
            "text": "一応、扉には\nアクセスできるように\nしておきます。",
            "zh": "总之，这扇门\n我会留着，\n让你能访问。",
            "narrator_zh": "燕"
        },
        {
            "location": "404/TALK",
            "narrator": "つばめ",
            "text": "気が向いたらいつでも\n手伝いに来てくださいね。",
            "zh": "你想帮忙的时候，\n请随时来哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "24/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月2日　8:49 PM</color>\n静岡・逢瀬邸\nリビングにて。",
            "zh": "<color=green>5月2日　8:49 PM</color>\n静冈・逢濑家\n在客厅。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "175/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch01",
            "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>逢濑燕的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解逢濑燕心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch01"
        },
        {
            "location": "272/DIALOG",
            "narrator": "Dialog_GETGokigen",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>500pt.</b></color></size>\n增加了！",
            "narrator_zh": "Dialog_GETGokigen"
        }
    ]
}
