{
    "dir": "chap11/daydra/dd_ch03_11_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "11302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "ガブちゃん先輩＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "加布前辈＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "ガブちゃん先輩",
            "zh": "加布前辈",
            "narrator_zh": ""
        },
        {
            "location": "29/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "せんぱい…、\nいるかな？",
            "zh": "前辈…、\n在吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "はーい？",
            "zh": "在哦—？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "あの、せんぱい？\nつばめです…。",
            "zh": "那个，前辈？\n我是燕…。",
            "narrator_zh": "燕"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "え？\nちょっと待ちなさい。",
            "zh": "咦？\n稍等一下。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "…何の用？\n今、忙しいんだけど。",
            "zh": "…找我有什么事？\n我现在正忙着呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "つばめ",
            "text": "ごめんなさい…。\nでも、どうしても\n言っておきたくて…。",
            "zh": "对不起…。\n不过，无论如何都想\n跟你说一声…。",
            "narrator_zh": "燕"
        },
        {
            "location": "57/TALK",
            "narrator": "ガブリエラ",
            "text": "？　何をよ？",
            "zh": "？　说什么呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "つばめ",
            "text": "う、うん…。\n迷惑かけちゃった\nから…。",
            "zh": "嗯、嗯…。\n因为给你添了麻烦\n嘛…。",
            "narrator_zh": "燕"
        },
        {
            "location": "63/TALK",
            "narrator": "つばめ",
            "text": "あ、昼間のことね。\nそれで…えっと…。",
            "zh": "啊，就是白天的事呀。\n那个…呃…。",
            "narrator_zh": "燕"
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "ああもう！\nハッキリ言いなさい\nよ！",
            "zh": "哎呀真是的！\n给我痛快点\n直说啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "つばめ",
            "text": "ご、ごめんなさい！",
            "zh": "对、对不起！",
            "narrator_zh": "燕"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、謝るのは\nいいから…。",
            "zh": "不是，道不道歉的\n就算了…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "…もしかして、\nまたちょっと落ち込み\nモード入ってる？",
            "zh": "…难道说，\n你又有点进入消沉\n模式了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…わかった。\nゆっくり聞くから、\n部屋入んなさい。",
            "zh": "哈啊…行了。\n我会好好听你说的，\n先进屋吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "つばめ",
            "text": "お邪魔します…。",
            "zh": "打扰了…。",
            "narrator_zh": "燕"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "はいはい。\nそれじゃ早速話を…。",
            "zh": "好好。\n那就赶紧说正事吧…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "つばめ",
            "text": "わぁ…。",
            "zh": "哇啊…。",
            "narrator_zh": "燕"
        },
        {
            "location": "106/TALK",
            "narrator": "つばめ",
            "text": "せんぱいの部屋って、\nこんな風になって\nたんだぁ。",
            "zh": "前辈的房间，\n原来是长这个\n样子呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、部屋のことは\nいいから…。",
            "zh": "不是，房间的事\n就不用提了…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "わたしの部屋とは\n全然違うよ。",
            "zh": "跟我的房间\n完全不一样呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "112/TALK",
            "narrator": "つばめ",
            "text": "そっかぁ…。\nこういう家具を置くと\n可愛くなるんだ…。",
            "zh": "这样啊…。\n摆上这种家具的话\n就会变得好可爱呀…。",
            "narrator_zh": "燕"
        },
        {
            "location": "115/TALK",
            "narrator": "ガブリエラ",
            "text": "な、何よそれ！\n子供っぽいって\n言いたいの！？",
            "zh": "什、什么意思啊！\n你是想说很孩子气\n吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "つばめ",
            "text": "ううん。\nすごく素敵だよ！",
            "zh": "不是啦。\n超级漂亮的哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "118/TALK",
            "narrator": "つばめ",
            "text": "何だか、お姫様の\nお部屋、って感じが\nしますね。",
            "zh": "总觉得，有种公主\n的房间一样的\n感觉呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "120/TALK",
            "narrator": "ガブリエラ",
            "text": "…らしくない、って\n思ってるでしょ？",
            "zh": "…你心里一定在想\n“真不像她的风格”，对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "121/TALK",
            "narrator": "つばめ",
            "text": "え？　何で？\nこんなに素敵な\n部屋なのに…。",
            "zh": "咦？　为什么？\n明明是这么漂亮的\n房间…。",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当、恥ずかしい\nことを平然と言うん\nだから…。",
            "zh": "…真是的，这么让人\n难为情的话居然面不改色\n就说出口了…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "…それで？\nあたし、今すごく\n忙しいんだけど？",
            "zh": "…然后呢？\n我现在可是非常\n忙的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "つばめ",
            "text": "あ、ごめんなさい…。\n話があって来たん\nだよね、えへへ…。",
            "zh": "啊，对不起…。\n我是来找你有事要说的\n对吧，嘿嘿…。",
            "narrator_zh": "燕"
        },
        {
            "location": "128/TALK",
            "narrator": "つばめ",
            "text": "あの…今日はわたし、\nせんぱいに迷惑\n掛けちゃったから――",
            "zh": "那个…今天我，\n给前辈添了\n麻烦——",
            "narrator_zh": "燕"
        },
        {
            "location": "130/TALK",
            "narrator": "つばめ",
            "text": "ちゃんと謝って\nおきたくて…。",
            "zh": "所以想好好地\n向你道个歉…。",
            "narrator_zh": "燕"
        },
        {
            "location": "131/TALK",
            "narrator": "ガブリエラ",
            "text": "…それって、\n縁日のこと？",
            "zh": "…你说的，\n是指庙会的事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "あれはもういいって\n言ったでしょ？",
            "zh": "那件事我不是说了\n已经没事了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "135/TALK",
            "narrator": "つばめ",
            "text": "でも、わたしの\n勘違いで無理やり\nヒカルくんと――",
            "zh": "可是，因为我的\n误会，硬是把你和\n光——",
            "narrator_zh": "燕"
        },
        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "二人きりにしちゃった\nから、嫌な気持ちに\nなったかも、って…。",
            "zh": "弄得只有你们俩独处，\n我想你心里可能会觉得\n不痛快…。",
            "narrator_zh": "燕"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、別にそんな\nことは――",
            "zh": "没有，倒也并不是\n那样——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "ない！――んだけど……",
            "zh": "才没有！——虽然是这么说……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "141/TALK",
            "narrator": "ガブリエラ",
            "text": "でも…何か引っかかる\nものがあるような…。",
            "zh": "可是…总觉得心里好像有\n哪里堵着点什么似的…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "何かしら？",
            "zh": "会是什么呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "144/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめにバレたく\nないから？",
            "zh": "因为不想被燕\n发现吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "145/TALK",
            "narrator": "ガブリエラ",
            "text": "…ううん、それもある\nだろうけど――",
            "zh": "…不，虽说也有那方面的\n原因吧——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "146/TALK",
            "narrator": "ガブリエラ",
            "text": "もっと別の、何かが\nある気が…。",
            "zh": "但总觉得还有别的、\n另外什么东西在…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "147/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "191/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、$handle$！\nいらっしゃい！",
            "zh": "啊，$handle$！\n欢迎光临！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/SEL",
            "narrator": "",
            "text": "ぶっちゃけガブリエラは本当にヒカルのことが好きなの？",
            "zh": "说实话，加布里埃拉真的喜欢光吗？",
            "narrator_zh": ""
        },
        {
            "location": "194/ACT",
            "narrator": "",
            "text": "ぶっちゃけガブリエラは本当にヒカルのことが好きなの？",
            "zh": "说实话，加布里埃拉真的喜欢光吗？",
            "narrator_zh": ""
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "ええっ！？\n来るなりいきなり\nどうしちゃったの？",
            "zh": "哎哎！？\n一上来怎么突然\n问这个呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/SEL",
            "narrator": "",
            "text": "本当の気持ちを知りたい",
            "zh": "我想知道真实的心意",
            "narrator_zh": ""
        },
        {
            "location": "198/ACT",
            "narrator": "",
            "text": "本当の気持ちを知りたい",
            "zh": "我想知道真实的心意",
            "narrator_zh": ""
        },
        {
            "location": "200/TALK",
            "narrator": "ガブリエラ",
            "text": "あー…\nってことは、少なからず、\nそういうことなのね。",
            "zh": "啊—…\n这么说来，多少还是\n那么回事吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "201/TALK",
            "narrator": "ガブリエラ",
            "text": "いいわ。\n本当の気持ちを\n教えてあげる。",
            "zh": "好呀。\n那我就把真实的心意\n告诉你吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "202/TALK",
            "narrator": "ガブリエラ",
            "text": "もちろん。\n本人は舞い上がっちゃって\nいるわね。",
            "zh": "当然了。\n她本人现在可是得意忘形、\n飘飘然得很呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/SEL",
            "narrator": "",
            "text": "応援してるよ！",
            "zh": "我支持你哦！",
            "narrator_zh": ""
        },
        {
            "location": "204/SEL",
            "narrator": "",
            "text": "$me$の立場が無いじゃん！",
            "zh": "那$me$岂不是没戏了！",
            "narrator_zh": ""
        },
        {
            "location": "205/SEL",
            "narrator": "",
            "text": "ガブリエラは$me$の嫁になるんだから他の男は許さん！",
            "zh": "加布里埃拉要当$me$的新娘，绝对不允许有其他男人！",
            "narrator_zh": ""
        },
        {
            "location": "206/ACT",
            "narrator": "",
            "text": "応援してるよ！",
            "zh": "我支持你哦！",
            "narrator_zh": ""
        },
        {
            "location": "208/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと！",
            "zh": "谢谢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "ガブリエラ",
            "text": "リアルのあたしにとっても\nきっといい経験になると\n思うから、応援してね。",
            "zh": "对现实中的我来说，\n这肯定也会是很棒的经历，\n要支持我哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "211/ACT",
            "narrator": "",
            "text": "$me$の立場が無いじゃん！",
            "zh": "那$me$岂不是没戏了！",
            "narrator_zh": ""
        },
        {
            "location": "213/TALK",
            "narrator": "ガブリエラ",
            "text": "なんで？\nそんなことないのに。",
            "zh": "为什么？\n才没有那种事呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん、そうね。\nぶっちゃけて\nカミングアウトすると――",
            "zh": "嗯—，我想想啊。\n如果坦白出柜……\n不对，坦白交代的话——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "215/ACT",
            "narrator": "",
            "text": "ガブリエラは$me$の嫁になるんだから他の男は許さん！",
            "zh": "加布里埃拉要当$me$的新娘，绝对不允许有其他男人！",
            "narrator_zh": ""
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？",
            "zh": "咦！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとなんだか\nココロがキューーーって\nなっちゃったかも。",
            "zh": "总觉得心里稍微\n怦——地揪了一下\n呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "219/TALK",
            "narrator": "ガブリエラ",
            "text": "でもね、\n１つカミングアウト\nしちゃうと――",
            "zh": "不过呀，\n要是老实交代\n一件事的话——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは\n$handle$の方が\n好きよ？",
            "zh": "我还是\n更喜欢\n$handle$哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/SEL",
            "narrator": "",
            "text": "どゆこと？",
            "zh": "什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "224/ACT",
            "narrator": "",
            "text": "どゆこと？",
            "zh": "什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "だって、いつも\nあたしのために\n頑張ってくれてるし。",
            "zh": "因为你总是\n为了我而\n这么努力嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/SEL",
            "narrator": "",
            "text": "現実の本人と司書って別人なの！？",
            "zh": "现实的本人和司书不是同一个人吗！？",
            "narrator_zh": ""
        },
        {
            "location": "229/ACT",
            "narrator": "",
            "text": "現実の本人と司書って別人なの！？",
            "zh": "现实的本人和司书不是同一个人吗！？",
            "narrator_zh": ""
        },
        {
            "location": "232/TALK",
            "narrator": "ガブリエラ",
            "text": "同一に\n決まってるじゃない。",
            "zh": "当然是\n同一个人啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/SEL",
            "narrator": "",
            "text": "じゃあ現実のガブリエラもホントは$me$が好きってこと？",
            "zh": "那现实的加布里埃拉其实也喜欢$me$咯？",
            "narrator_zh": ""
        },
        {
            "location": "234/ACT",
            "narrator": "",
            "text": "じゃあ現実のガブリエラもホントは$me$が好きってこと？",
            "zh": "那现实的加布里埃拉其实也喜欢$me$咯？",
            "narrator_zh": ""
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "いえ。\nヒカル君が好きよ？",
            "zh": "不。\n她喜欢的是光哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん、この感覚は\nちょっと難しいかも\nしれないわね。",
            "zh": "嗯—，这种感觉\n或许确实有点难以\n理解吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "239/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの中にいるいろんな\n人格は、それぞれ主張が\n違うのよ。",
            "zh": "在我体内的各种\n人格，各自的主张\n都是不一样的哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "こんな所で働いてる\nあたしだって、人格の\n１つには変わりない。",
            "zh": "像我这样在这种地方\n工作的司书，也同样只是\n众多人格中的一个。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "その総体としての存在が\n現実のあたしってわけ。",
            "zh": "而将这些全部统合在一起的存在，\n就是现实中的我啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、あたしとしては\n$handle$と\nラブラブしてみたいかな。",
            "zh": "所以，就我个人而言，\n倒是很想和$handle$\n腻歪谈场恋爱呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうわけで、\n応援してるから\nちゃんと超頑張ってよね！",
            "zh": "正因为如此，\n我可是很支持你的，\n要超级努力才行哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "244/SEL",
            "narrator": "",
            "text": "頑張る！",
            "zh": "我会加油的！",
            "narrator_zh": ""
        },
        {
            "location": "245/SEL",
            "narrator": "",
            "text": "司書はヒカルのことは好きじゃないの？",
            "zh": "司书不喜欢光吗？",
            "narrator_zh": ""
        },
        {
            "location": "246/ACT",
            "narrator": "",
            "text": "頑張る！",
            "zh": "我会加油的！",
            "narrator_zh": ""
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "そう！\nその意気よ！",
            "zh": "没错！\n就是这股干劲！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/ACT",
            "narrator": "",
            "text": "司書はヒカルのことは好きじゃないの？",
            "zh": "司书不喜欢光吗？",
            "narrator_zh": ""
        },
        {
            "location": "251/TALK",
            "narrator": "ガブリエラ",
            "text": "好きか嫌いかで言ったら、\n好きって感覚はわかる…\nくらいかしらね。",
            "zh": "要说喜欢还是讨厌，\n大概也就只是“能理解\n喜欢的感觉”…这种程度吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、司書としては\nいろいろ考えちゃう\nところがあるのよね。",
            "zh": "不过，作为司书，\n我也有很多需要思考\n的地方就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "それだけじゃなくて――",
            "zh": "不光是那个——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/TALK",
            "narrator": "ガブリエラ",
            "text": "なんで司書のあたしが\n$handle$に好意を\n寄せてるかも。",
            "zh": "还有为什么身为司书的我\n会对$handle$抱有\n好感这件事呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、それについては\nまた気が向いたら\nお話ししてあげるわ。",
            "zh": "嘛，关于这件事，\n等以后我心血来潮了\n再讲给你听吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "260/TALK",
            "narrator": "ガブリエラ",
            "text": "さて、それはそうと\n本題よ！　本題！！",
            "zh": "好了，闲话少说，\n进入正题吧！　正题！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "263/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし今、すごい興奮\nしてるのよ？",
            "zh": "我现在，可是非常\n兴奋的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "ついにこの時が\n来たんだわーって！",
            "zh": "想着“这一刻终于\n还是来了呢—”！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/SEL",
            "narrator": "",
            "text": "ヒカルとのこと？",
            "zh": "是和光的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "267/SEL",
            "narrator": "",
            "text": "つばめとのこと？",
            "zh": "是和燕的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "268/ACT",
            "narrator": "",
            "text": "ヒカルとのこと？",
            "zh": "是和光的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "269/TALK",
            "narrator": "ガブリエラ",
            "text": "違うわよ！\nつばめとのこと！",
            "zh": "不是啦！\n是和燕的事！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/ACT",
            "narrator": "",
            "text": "つばめとのこと？",
            "zh": "是和燕的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "271/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ！",
            "zh": "没错哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "273/TALK",
            "narrator": "ガブリエラ",
            "text": "今回だけは絶対に\nクランを倒さなくっちゃ\nだわよ！",
            "zh": "唯独这一次，绝对\n非得把库兰打倒\n不可呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "274/TALK",
            "narrator": "ガブリエラ",
            "text": "まずは急ぎ、\n扉をコールするわね。",
            "zh": "首先抓紧时间，\n呼叫门扉吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "281/TALK",
            "narrator": "ガブリエラ",
            "text": "オープンプロセス、\n0x58F番地から\n0x224番地へ。",
            "zh": "开放进程，\n从0x58F号地址前往\n0x224号地址。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "296/TALK",
            "narrator": "ガブリエラ",
            "text": "シーク完了っ♪",
            "zh": "搜索完成♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "297/TALK",
            "narrator": "ガブリエラ",
            "text": "さあ！\n頑張ってクランを\n倒してちょうだい！",
            "zh": "好啦！\n加油把库兰\n打倒吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "298/SEL",
            "narrator": "",
            "text": "ちょっとまって！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "299/ACT",
            "narrator": "",
            "text": "ちょっとまって！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "301/TALK",
            "narrator": "ガブリエラ",
            "text": "もうっ、何よ。\nじれったいわね。",
            "zh": "真是的，干嘛呀。\n真让人心急呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "302/SEL",
            "narrator": "",
            "text": "せめて説明だけでも聞かせて",
            "zh": "至少让我听完说明啊",
            "narrator_zh": ""
        },
        {
            "location": "303/ACT",
            "narrator": "",
            "text": "せめて説明だけでも聞かせて",
            "zh": "至少让我听完说明啊",
            "narrator_zh": ""
        },
        {
            "location": "305/TALK",
            "narrator": "ガブリエラ",
            "text": "え？",
            "zh": "咦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "306/TALK",
            "narrator": "ガブリエラ",
            "text": "ああっ！\nそういえば\nそうだったわね。",
            "zh": "啊啊！\n这么说来确实\n还没说明呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "307/TALK",
            "narrator": "ガブリエラ",
            "text": "今回のあたしの\nココロのもやもやは、\nズバリ！！",
            "zh": "我这次内心的\n郁结，\n说白了就是！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "308/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめに告白できない\n自分に対しての\n苛立ちなのよ！",
            "zh": "是对迟迟无法向燕\n告白的自己感到的\n焦躁哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "309/SEL",
            "narrator": "",
            "text": "仲直りの告白？",
            "zh": "和好的告白？",
            "narrator_zh": ""
        },
        {
            "location": "310/SEL",
            "narrator": "",
            "text": "もしかして百合展開！？",
            "zh": "难道说是百合展开！？",
            "narrator_zh": ""
        },
        {
            "location": "311/ACT",
            "narrator": "",
            "text": "仲直りの告白？",
            "zh": "和好的告白？",
            "narrator_zh": ""
        },
        {
            "location": "312/TALK",
            "narrator": "ガブリエラ",
            "text": "そう！\nそうなのよ！",
            "zh": "对！\n就是这样！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "313/ACT",
            "narrator": "",
            "text": "もしかして百合展開！？",
            "zh": "难道说是百合展开！？",
            "narrator_zh": ""
        },
        {
            "location": "314/TALK",
            "narrator": "ガブリエラ",
            "text": "ち、違うわよ！！",
            "zh": "才、才不是啦！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "315/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめとお友達になる\nための大事な告白よ！",
            "zh": "是为了和燕成为朋友\n的重要告白啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "316/TALK",
            "narrator": "ガブリエラ",
            "text": "前から言ってるでしょ？",
            "zh": "我以前不就说过了嘛？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "318/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしがずっとずっと\nずーっと望んでいた\nこの展開！",
            "zh": "我一直一直\n一直都在盼望着的\n这个展开！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "319/TALK",
            "narrator": "ガブリエラ",
            "text": "今まではずっと意地張って\nきたけど、ついに罪悪感が\n上回ったのね。",
            "zh": "虽然至今为止一直在逞强，\n但这次终于还是愧疚感\n占了上风呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "320/TALK",
            "narrator": "ガブリエラ",
            "text": "ここまで来れば\nあと一押し！",
            "zh": "既然都走到这一步了，\n只差最后推一把！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "321/TALK",
            "narrator": "ガブリエラ",
            "text": "言うことを阻止する、\nプライドの塊のような\nクランを倒すのよ！",
            "zh": "去打倒那个妨碍她说出口、\n简直就是自尊心化身的\n库兰吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "322/SEL",
            "narrator": "",
            "text": "ガッテン姉貴！",
            "zh": "收到，大姐头！",
            "narrator_zh": ""
        },
        {
            "location": "323/SEL",
            "narrator": "",
            "text": "ほのかな百合を期待！",
            "zh": "期待隐约的百合展开！",
            "narrator_zh": ""
        },
        {
            "location": "324/ACT",
            "narrator": "",
            "text": "ガッテン姉貴！",
            "zh": "收到，大姐头！",
            "narrator_zh": ""
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "な、なんか今日は\nやけにノリがいいわね。",
            "zh": "总、总觉得你今天\n情绪格外高涨呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "327/ACT",
            "narrator": "",
            "text": "ほのかな百合を期待！",
            "zh": "期待隐约的百合展开！",
            "narrator_zh": ""
        },
        {
            "location": "329/TALK",
            "narrator": "ガブリエラ",
            "text": "百合とか無いから！",
            "zh": "才没有百合那种东西呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "331/TALK",
            "narrator": "ガブリエラ",
            "text": "ほんと、\n“マルザンナ”は\n何を考えてるのかしら。",
            "zh": "真是的，\n“玛尔赞娜”到底\n在胡思乱想些什么呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "333/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、行くわよ！",
            "zh": "那我们这就出发吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "334/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！",
            "zh": "愿这趟旅程对我和\n$handle$来说，\n都是一场美妙的心灵之旅！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "27/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月5日　7:15 PM</color>\n七夕祭りの後、寮「とらいあんぐる」ガブリエラの部屋前にて。",
            "zh": "<color=green>6月5日　7:15 PM</color>\n七夕祭典之后，在宿舍“Tri-angle”加布里埃拉的房间门前。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "159/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch03",
            "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>在加布里埃拉的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n在她的心中，\n正产生巨大的纠葛。\n\n请潜入心灵领域\n化解加布里埃拉内心的纠葛吧。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch03"
        }
    ]
}
