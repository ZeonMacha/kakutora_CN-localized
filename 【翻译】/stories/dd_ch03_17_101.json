{
    "dir": "chap17/daydra/dd_ch03_17_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "17302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "マナーか娯楽か＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "礼仪还是娱乐＜前篇＞"
    },
    "entry": [
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…やっと、\n帰ってこれたわ。",
            "zh": "哈啊……总算\n回到这里了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "アーヤ",
            "text": "暗くなる前には\n帰れると思ったん\nだけどね。",
            "zh": "我原本还以为能在\n天黑之前回来\n呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、神楽が\n勝手なこと\nしてくれたから。",
            "zh": "真是的，都怪神乐\n在那边自作主张\n乱来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "でも、\n神楽ちゃんは…。",
            "zh": "可是，\n神乐她……。",
            "narrator_zh": "燕"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "ああ、はいはい。\nつばめは神楽の味方\nだったわね。",
            "zh": "啊啊，好好好。\n燕你向来都是站在\n神乐那边的嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "つばめ",
            "text": "そういうわけじゃ…。",
            "zh": "我也不是那个意思……。",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "敵のあたしは退散する\nから、好きなだけ\n言ってなさいよ。",
            "zh": "那我这个敌对派就先\n撤了，你爱怎么说就\n随便说去吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "アーヤ",
            "text": "…私も疲れたし、\n報告したら寮に\n戻るわ。",
            "zh": "……我也累了，\n汇报完就先回宿舍\n了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…まったく、\nやってらんないわ。",
            "zh": "哈啊……真是的，\n简直没法干了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "何よ、つばめったら。\nあんなに神楽のこと\n庇って…。",
            "zh": "搞什么嘛，燕也是。\n居然那么护着\n神乐……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "…つばめがメノウの\nファンなのは\n知ってる。",
            "zh": "……我知道燕是\nMENOW的粉丝\n啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "でもあたしは\nファンでもなんでも\nないんだから！",
            "zh": "可我既不是粉丝\n也不是什么别的关系\n啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしも、\nもう帰ろうかな？",
            "zh": "……算了，我也\n差不多回去了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "雛",
            "text": "あ～、疲れた。\nやっと終わったねー。",
            "zh": "啊～好累呀。\n总算是弄完了呢——",
            "narrator_zh": "雏"
        },
        {
            "location": "76/TALK",
            "narrator": "雛",
            "text": "…あれ？",
            "zh": "……咦？",
            "narrator_zh": "雏"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "ああ、いたんだ？",
            "zh": "啊，你们还在啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "79/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん！\n帰ってたの？\nおかえりー！",
            "zh": "加布里埃拉！\n你已经回来啦？\n欢迎回来——！",
            "narrator_zh": "雏"
        },
        {
            "location": "82/TALK",
            "narrator": "繭",
            "text": "…無事だった\nみたいね。",
            "zh": "……看样子\n平安无事呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、まあね。",
            "zh": "嗯，算是吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたし達の代わりに\n劇場のことやって\nくれてたの？",
            "zh": "……刚才都是你们\n替我们在打理\n剧场吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "85/TALK",
            "narrator": "雛",
            "text": "あたしだけねー。",
            "zh": "只有我一个人在弄啦——",
            "narrator_zh": "雏"
        },
        {
            "location": "86/TALK",
            "narrator": "繭",
            "text": "私はみやび先輩の\n手伝いをしてた。",
            "zh": "我刚才在给雅前辈\n帮忙。",
            "narrator_zh": "茧"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびの手伝いが\nできるなんて、\n凄いじゃない。",
            "zh": "能给雅帮上忙，\n那不是很厉害\n嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "繭",
            "text": "別に…簡単な手伝い\nしかしてないし…。",
            "zh": "也没什么……我只帮着\n做点简单的杂活而已……。",
            "narrator_zh": "茧"
        },
        {
            "location": "91/TALK",
            "narrator": "雛",
            "text": "それより、聞いたよ。",
            "zh": "先不说那个，我听说咯。",
            "narrator_zh": "雏"
        },
        {
            "location": "92/TALK",
            "narrator": "雛",
            "text": "今日のフェノメノン\nってアプリゲームが\n原因なんだって？",
            "zh": "听说今天的PhenoMENON\n是由一款手游引起的\n对吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあね…。",
            "zh": "……算是吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "雛",
            "text": "もしかして、この前の\nバグが原因だったり\nする？",
            "zh": "该不会，就是前几天\n那个BUG搞出来的\n事吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうよ。\nやっぱり、被害者が\n出てたみたいね。",
            "zh": "……没错。\n果然还是有人\n中招了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "96/TALK",
            "narrator": "雛",
            "text": "そうだったんだ…。",
            "zh": "果然是这样啊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "97/TALK",
            "narrator": "雛",
            "text": "あの後、すぐに報告\nしたのに。",
            "zh": "明明在那之后，\n就已经马上反馈了。",
            "narrator_zh": "雏"
        },
        {
            "location": "98/TALK",
            "narrator": "雛",
            "text": "すぐ対応して\nもらえてたら\n違ってたのかな。",
            "zh": "要是官方能立刻\n处理的话，是不是\n就不会这样了呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "100/TALK",
            "narrator": "繭",
            "text": "仕方ない部分は\nあるわ。",
            "zh": "这方面也有\n没办法的地方。",
            "narrator_zh": "茧"
        },
        {
            "location": "101/TALK",
            "narrator": "繭",
            "text": "報告即対応なんて\n神対応の域。",
            "zh": "收到反馈就立刻修复，\n那简直是神级客服的水平了。",
            "narrator_zh": "茧"
        },
        {
            "location": "102/TALK",
            "narrator": "繭",
            "text": "簡単にできる\nわけない。",
            "zh": "哪有那么容易\n做得到。",
            "narrator_zh": "茧"
        },
        {
            "location": "104/TALK",
            "narrator": "雛",
            "text": "そりゃそうだけど、\n結局それが原因で\n炎上しちゃったし。",
            "zh": "话是这么说啦，\n可结果还是因为那个\n在网上一片炎上嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "105/TALK",
            "narrator": "雛",
            "text": "おまけに、\n発症者まで出ちゃった\nわけでしょ？",
            "zh": "到头来，\n甚至还闹出发病者了\n不是吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "107/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうことよ。\nなんか、やりきれない\n気持ちになるわ…。",
            "zh": "就是这么回事啊。\n总觉得心里堵得慌，\n真不是滋味……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "繭",
            "text": "は？　何で？",
            "zh": "哈？　为什么？",
            "narrator_zh": "茧"
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "何でって、あたしが\nもっと真剣に対応する\nように言えば――",
            "zh": "什么为什么，要是我\n当时态度再强硬点\n催他们认真处理——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "繭",
            "text": "そんなことする\n必要ないし、\n気にする必要もない。",
            "zh": "根本没必要那么做，\n也没必要放在\n心上。",
            "narrator_zh": "茧"
        },
        {
            "location": "113/TALK",
            "narrator": "繭",
            "text": "責任があるのは\nバグを生んだ公式と、\n発症者自身だから。",
            "zh": "该负责任的，是做出\n这个BUG的官方，\n还有发病者自己。",
            "narrator_zh": "茧"
        },
        {
            "location": "115/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ？　発症者には\n責任ないでしょ？",
            "zh": "啊？　发病者有什么\n责任啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "繭",
            "text": "ある。",
            "zh": "有啊。",
            "narrator_zh": "茧"
        },
        {
            "location": "117/TALK",
            "narrator": "繭",
            "text": "あのゲームは\nプレイヤー同士が\nネット対戦できる。",
            "zh": "那款游戏是支持\n玩家之间进行\n网络对战的。",
            "narrator_zh": "茧"
        },
        {
            "location": "118/TALK",
            "narrator": "繭",
            "text": "そういうゲームには、\n即死レベルのバグが\n生じる危険性が伴う。",
            "zh": "这种游戏本来就伴随着\n出现即死级BUG的\n风险。",
            "narrator_zh": "茧"
        },
        {
            "location": "119/TALK",
            "narrator": "繭",
            "text": "その覚悟もなく\n遊んでた方にも\n責任はあるはず。",
            "zh": "连这点觉悟都没有\n就去玩的人，自己也\n一样脱不了干系。",
            "narrator_zh": "茧"
        },
        {
            "location": "121/TALK",
            "narrator": "ガブリエラ",
            "text": "…それはちょっと、\n酷じゃないかしら？",
            "zh": "……这种说法，未免\n有点太残酷了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、繭だって\n言ってたじゃない。",
            "zh": "而且，茧你自己\n不也说过吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "バグの存在を知ってる\nのは数十人くらいだ、\nって。",
            "zh": "知道这个BUG存在的，\n也就几十个人左右\n而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "繭",
            "text": "でも、その後すぐに\n炎上して、大勢が\n知ることになった。",
            "zh": "可那之后很快就在\n网上炎上了，大部分人\n都应该知道了才对。",
            "narrator_zh": "茧"
        },
        {
            "location": "126/TALK",
            "narrator": "繭",
            "text": "知ろうと思えば、\n簡単に知ることが\nできたということ。",
            "zh": "只要有心去查，\n明明轻轻松松就能\n知道这件事。",
            "narrator_zh": "茧"
        },
        {
            "location": "127/TALK",
            "narrator": "繭",
            "text": "なのにそのバグの\n被害にあった\nわけでしょ。",
            "zh": "结果还是踩进了\n那个BUG的坑里\n对吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "128/TALK",
            "narrator": "繭",
            "text": "それは\n情報のチェックを\n怠っていたってこと。",
            "zh": "那只能说明\n他们自己疏忽了\n情报收集。",
            "narrator_zh": "茧"
        },
        {
            "location": "129/TALK",
            "narrator": "雛",
            "text": "んー。\n責任って言い方は\nしっくりこないけど。",
            "zh": "唔——。\n虽然用“责任”这个词\n听着有点别扭。",
            "narrator_zh": "雏"
        },
        {
            "location": "130/TALK",
            "narrator": "雛",
            "text": "発症者になっちゃう\nくらい、熱を入れてた\nゲームなんでしょ？",
            "zh": "不过那不是热衷到\n甚至会因此发病的\n游戏吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "132/TALK",
            "narrator": "繭",
            "text": "それなのに情報の\nチェックしてないって\nいうのが不思議。",
            "zh": "既然这么上心，却连\n情报都不去查一下，\n确实让人搞不懂呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "134/TALK",
            "narrator": "繭",
            "text": "ウェブ情報を\n制覇する者は\nこの世を制する。",
            "zh": "掌握网络\n情报者，方能\n制霸天下。",
            "narrator_zh": "茧"
        },
        {
            "location": "135/TALK",
            "narrator": "繭",
            "text": "情弱はこの世から\n排除される。\nそれがネットの世界。",
            "zh": "信息闭塞的弱者会被世界\n淘汰。\n这就是网络的法则。",
            "narrator_zh": "茧"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、もしもあの時、\nあたしが運営会社に\n電話してたら…。",
            "zh": "可是，如果那个时候，\n我有给运营公司\n打个电话的话……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん、電話しても\nすぐにどうなるかは\nわからないか。",
            "zh": "不，就算打了电话，\n也不知道能不能\n立刻得到解决吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、すぐに\n対処して\nくれていたら。",
            "zh": "可要是他们真的\n马上就动手\n处理了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "発症せずに\nすんだ可能性は\nあるわけよね…。",
            "zh": "那不就有可能\n避免有人因此\n发病了嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "…今更そんなこと\n思ったって、後悔しか\nできないけど…。",
            "zh": "……虽然事到如今再想\n这些，也只会剩下\n满心懊悔罢了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、$handle$！\nいらっしゃい！",
            "zh": "啊，$handle$！\n欢迎光临！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "215/TALK",
            "narrator": "ガブリエラ",
            "text": "今日も元気に\n検索しちゃうわね！",
            "zh": "今天我也要元气满满地\n开始搜索咯！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/SEL",
            "narrator": "",
            "text": "いつも元気だね",
            "zh": "你一直都这么有精神呢",
            "narrator_zh": ""
        },
        {
            "location": "217/ACT",
            "narrator": "",
            "text": "いつも元気だね",
            "zh": "你一直都这么有精神呢",
            "narrator_zh": ""
        },
        {
            "location": "219/TALK",
            "narrator": "ガブリエラ",
            "text": "もちろんよ。",
            "zh": "那当然啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしが元気でいなければ\n現実のあたしも元気が\nなくなっちゃうもの。",
            "zh": "如果连我都没精神了，\n现实中的我也一样会\n跟着打不起精神来的嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "221/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ\n張り切っていくわよ。",
            "zh": "那么，\n我要干劲十足地上咯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "オープンプロセス、\n0x58F番地から\n0x224番地へ。",
            "zh": "开放进程，\n从0x58F号地址前往\n0x224号地址。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/TALK",
            "narrator": "ガブリエラ",
            "text": "シーク完了っ♪",
            "zh": "搜索完成♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "それで、\n今回のあたしの\n総意は……っと。",
            "zh": "那么，\n这次我的\n总意是……嗯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "……んー、なるほど。",
            "zh": "……嗯——原来如此。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、そうよねぇ。",
            "zh": "嘛，确实会这样呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "250/SEL",
            "narrator": "",
            "text": "何が？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "251/ACT",
            "narrator": "",
            "text": "何が？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "バグに気づいたけど運営に\n報告しなかった事を気に\nしてるあたしがいるのよ。",
            "zh": "因为我心里有个声音，\n一直在纠结“明明发现了BUG\n却没及时向运营报告”这件事哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$は\nどう思う？",
            "zh": "$handle$\n你怎么看？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/SEL",
            "narrator": "",
            "text": "報告すべきだと思う",
            "zh": "我觉得应该报告",
            "narrator_zh": ""
        },
        {
            "location": "256/SEL",
            "narrator": "",
            "text": "運営の責任なんだからしなくても悪くない",
            "zh": "那是运营的责任，不报告也没错",
            "narrator_zh": ""
        },
        {
            "location": "257/ACT",
            "narrator": "",
            "text": "報告すべきだと思う",
            "zh": "我觉得应该报告",
            "narrator_zh": ""
        },
        {
            "location": "258/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、すてきね！",
            "zh": "哎呀，真不错呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "259/TALK",
            "narrator": "ガブリエラ",
            "text": "でもそれは、自分にとって\nいいことがあるから？\nそれとも義務ってこと？",
            "zh": "不过你这么想，是因为\n报告了能给自己带来好处？\n还是觉得这是玩家的义务呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "260/SEL",
            "narrator": "",
            "text": "報告すれば快適に遊べるようになるよ",
            "zh": "报告了之后大家就能更舒心地玩了哦",
            "narrator_zh": ""
        },
        {
            "location": "261/SEL",
            "narrator": "",
            "text": "報告は義務だと思う",
            "zh": "我觉得报告是义务",
            "narrator_zh": ""
        },
        {
            "location": "262/ACT",
            "narrator": "",
            "text": "報告すれば快適に遊べるようになるよ",
            "zh": "报告了之后大家就能更舒心地玩了哦",
            "narrator_zh": ""
        },
        {
            "location": "263/TALK",
            "narrator": "ガブリエラ",
            "text": "確かにそうね。\n運営が頑張れば、だけど。",
            "zh": "确实是这样呢。\n前提是运营也肯努力才行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "264/TALK",
            "narrator": "ガブリエラ",
            "text": "でもそれと、今あたしが\n抱えている罪悪感は\n全然別物よね。",
            "zh": "不过那件事，和现在我\n心里背负的负罪感\n完全是两码事吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "265/ACT",
            "narrator": "",
            "text": "報告は義務だと思う",
            "zh": "我觉得报告是义务",
            "narrator_zh": ""
