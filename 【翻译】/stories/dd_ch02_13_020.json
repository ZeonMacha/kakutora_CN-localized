{
    "dir": "chap13/daydra/dd_ch02_13_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "13256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "高カロリーな食事",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "高热量的一餐"
    },
    "entry": [
        {
            "location": "222/SCENARIO",
            "narrator": "",
            "text": "高カロリーな食事",
            "zh": "高热量的一餐",
            "narrator_zh": ""
        },
        {
            "location": "237/TALK",
            "narrator": "つばめ",
            "text": "…ちょっと、食べ過ぎ\nちゃいましたね。",
            "zh": "……稍微，吃得\n有点太撑了呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "239/TALK",
            "narrator": "アーヤ",
            "text": "そうね…まさか、\nあんなに新メニューの\nケーキが――",
            "zh": "是啊……真没想到，\n居然推出了那么多\n新品蛋糕——",
            "narrator_zh": "绫水"
        },
        {
            "location": "240/TALK",
            "narrator": "アーヤ",
            "text": "出てるとは\n思わなかったわ。",
            "zh": "早知道会这样，\n真是失策。",
            "narrator_zh": "绫水"
        },
        {
            "location": "241/TALK",
            "narrator": "つばめ",
            "text": "頑張ったけど、\n一日で制覇するのは\n無理でしたね…。",
            "zh": "虽然很努力了，\n但一天之内全部制霸\n果然还是太勉强了呢……。",
            "narrator_zh": "燕"
        },
        {
            "location": "243/TALK",
            "narrator": "神楽",
            "text": "でも、凄く美味しくて\n大満足でした！",
            "zh": "不过，真的非常好吃，\n超满足！",
            "narrator_zh": "神乐"
        },
        {
            "location": "244/TALK",
            "narrator": "アーヤ",
            "text": "本当ね。",
            "zh": "确实呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "245/TALK",
            "narrator": "アーヤ",
            "text": "まあ、その分夕飯は\nカロリー抑えないと\nいけないけど…。",
            "zh": "不过相应地，晚饭\n不控制一下热量\n可不行呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "247/TALK",
            "narrator": "つばめ",
            "text": "野菜中心にした方が\n良さそうですね。",
            "zh": "吃些以蔬菜为主的\n好像比较好呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "248/TALK",
            "narrator": "神楽",
            "text": "抜くくらいした方が\nいいかもしれませんよ？",
            "zh": "干脆不吃晚饭，\n说不定会更好哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "250/TALK",
            "narrator": "つばめ",
            "text": "えーっ、それじゃあ\nお腹空いちゃうよぉ…。",
            "zh": "诶——那样的话\n肚子会饿的啦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "253/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、食べたばかりで\n言うセリフじゃ――",
            "zh": "呵呵，这可不像是\n刚吃完的人该说的话——",
            "narrator_zh": "绫水"
        },
        {
            "location": "254/TALK",
            "narrator": "アーヤ",
            "text": "…あっ。",
            "zh": "……啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "257/TALK",
            "narrator": "つばめ",
            "text": "え？　…わぁ！",
            "zh": "诶？　……哇啊！",
            "narrator_zh": "燕"
        },
        {
            "location": "259/TALK",
            "narrator": "神楽",
            "text": "いい匂い…\nどこのお店でしょうか？",
            "zh": "好香的味道……\n是哪家店飘出来的呀？",
            "narrator_zh": "神乐"
        },
        {
            "location": "261/TALK",
            "narrator": "アーヤ",
            "text": "…夕飯時だからかしら？\nあちこちの店から\nしてくるわね。",
            "zh": "……是因为到晚饭时间了吗？\n每家店里都飘出\n香味来了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "263/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "265/TALK",
            "narrator": "つばめ",
            "text": "食べたばかりだけど…\nお腹鳴っちゃいそうです。",
            "zh": "虽然刚吃完……\n但肚子好像都要叫了。",
            "narrator_zh": "燕"
        },
        {
            "location": "266/TALK",
            "narrator": "神楽",
            "text": "そうですね…。",
            "zh": "是啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "268/TALK",
            "narrator": "神楽",
            "text": "で、でもダメです！",
            "zh": "不、不过不行！",
            "narrator_zh": "神乐"
        },
        {
            "location": "269/TALK",
            "narrator": "神楽",
            "text": "いい匂いのする料理は、\n大抵カロリーが高いと\n決まっています！",
            "zh": "闻起来这么香的料理，\n十有八九热量都很高，\n这是铁律！",
            "narrator_zh": "神乐"
        },
        {
            "location": "270/TALK",
            "narrator": "アーヤ",
            "text": "ケーキを食べた後だし、\nさすがにね…。",
            "zh": "而且刚吃完蛋糕，\n果然还是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "272/TALK",
            "narrator": "つばめ",
            "text": "そうですね。",
            "zh": "说得也是。",
            "narrator_zh": "燕"
        },
        {
            "location": "273/TALK",
            "narrator": "つばめ",
            "text": "…凄く、美味しそう\nですけど。",
            "zh": "……虽然闻着，\n真的好香好诱人。",
            "narrator_zh": "燕"
        },
        {
            "location": "274/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "276/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "278/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "280/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、いつもって\nわけじゃないんだし――",
            "zh": "……嘛，反正也不是\n天天都这样——",
            "narrator_zh": "绫水"
        },
        {
            "location": "282/TALK",
            "narrator": "アーヤ",
            "text": "たまにだったら、\nちょっと食べ過ぎても\n罰は当たらないかな？",
            "zh": "偶尔一次的话，\n稍微吃多一点\n应该也不算犯罪吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "284/TALK",
            "narrator": "神楽",
            "text": "アーヤさん、本気ですか？",
            "zh": "绫水，你是认真的吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "285/TALK",
            "narrator": "アーヤ",
            "text": "私も、ちょっとだけ\nお腹空いてきちゃったし。",
            "zh": "我其实也有点\n饿起来了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "286/TALK",
            "narrator": "アーヤ",
            "text": "たまに食べ過ぎるくらい、\n罰は当たらないんじゃ\nないかしら？",
            "zh": "偶尔吃撑一回，\n应该也不至于\n遭报应吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "288/TALK",
            "narrator": "つばめ",
            "text": "そうだよ卯月さん。\nたまになんだから\n平気だよ。",
            "zh": "是呀卯月。\n就这一次而已，\n没关系的啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "290/TALK",
            "narrator": "神楽",
            "text": "う～ん…。",
            "zh": "唔～嗯……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "291/TALK",
            "narrator": "神楽",
            "text": "…そうですね。\nたまにだったら、\n許されますよね？",
            "zh": "……说得也是。\n如果只是偶尔一次的话，\n应该会被原谅的吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "292/TALK",
            "narrator": "アーヤ",
            "text": "決まりね。\n何か食べたい物はある？",
            "zh": "那就这么定了。\n你们有什么想吃的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "294/TALK",
            "narrator": "つばめ",
            "text": "えぇっと…、\n豚カツがいいです！",
            "zh": "嗯……那个，\n我想吃炸猪排！",
            "narrator_zh": "燕"
        },
        {
            "location": "296/TALK",
            "narrator": "神楽",
            "text": "美味しそうですけど、\nさすがにガッツリ過ぎじゃ\nないですか？",
            "zh": "听起来是很好吃啦，\n但刚吃完蛋糕就吃这个，\n是不是太重口了点？",
            "narrator_zh": "神乐"
        },
        {
            "location": "300/TALK",
            "narrator": "つばめ",
            "text": "卯月さんは何がいいの？",
            "zh": "那卯月想吃什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "302/TALK",
            "narrator": "神楽",
            "text": "そうですね…。\nブイヤベースとかは\nどうですか？",
            "zh": "我想想……。\n马赛鱼汤之类的\n怎么样？",
            "narrator_zh": "神乐"
        },
        {
            "location": "303/TALK",
            "narrator": "つばめ",
            "text": "ブイヤベースって、\nお魚とか入ってる\nスープだっけ？",
            "zh": "马赛鱼汤，\n就是放了鱼之类的\n那种汤对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "304/TALK",
            "narrator": "神楽",
            "text": "エビとか貝とかも\n入ってるんですよ。",
            "zh": "里面还放了虾和贝类\n之类的哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "306/TALK",
            "narrator": "アーヤ",
            "text": "…二人とも、意見が\n分かれてるみたい。",
            "zh": "……她们俩的意见，\n好像完全分歧了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "307/TALK",
            "narrator": "アーヤ",
            "text": "私はどうしようかしら？",
            "zh": "我该怎么办好呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "309/TALK",
            "narrator": "アーヤ",
            "text": "何か食べに行きたいけど、\n特に食べたい、って\n思うものないし…。",
            "zh": "虽然想找家店吃点东西，\n但真要说特别想吃什么，\n一时间也想不出来……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "322/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと悩んでるの",
            "zh": "稍微有点纠结",
            "narrator_zh": "绫水"
        },
        {
            "location": "323/TALK",
            "narrator": "アーヤ",
            "text": "夕飯に食べる料理で、",
            "zh": "要说晚饭吃的料理里，",
            "narrator_zh": "绫水"
        },
        {
            "location": "324/TALK",
            "narrator": "アーヤ",
            "text": "いい匂いがして、味の濃くて美味しい物といえば？",
            "zh": "闻着香、味道浓又好吃的东西，你会想到什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "326/SEL",
            "narrator": "",
            "text": "焼肉だ！",
            "zh": "那必须是烤肉！",
            "narrator_zh": ""
        },
        {
            "location": "327/SEL",
            "narrator": "",
            "text": "濃厚なラーメンでしょ",
            "zh": "重口味拉面吧",
            "narrator_zh": ""
        },
        {
            "location": "328/SEL",
            "narrator": "",
            "text": "イタリアンで行こう",
            "zh": "就吃意式料理吧",
            "narrator_zh": ""
        },
        {
            "location": "329/ACT",
            "narrator": "",
            "text": "焼肉だ！",
            "zh": "那必须是烤肉！",
            "narrator_zh": ""
        },
        {
            "location": "330/TALK",
            "narrator": "アーヤ",
            "text": "焼肉…そういえば最近食べてないかも",
            "zh": "烤肉……说起来最近好像确实没吃过",
            "narrator_zh": "绫水"
        },
        {
            "location": "331/TALK",
            "narrator": "アーヤ",
            "text": "一人じゃないんだし、誘ってみようかしら？",
            "zh": "反正又不是一个人吃，要不问问她们去不去吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "343/TALK",
            "narrator": "アーヤ",
            "text": "それだったら、\n焼肉でも行っちゃう？",
            "zh": "既然这样，\n要不干脆去吃烤肉？",
            "narrator_zh": "绫水"
        },
        {
            "location": "346/TALK",
            "narrator": "神楽",
            "text": "や、焼肉ですか？",
            "zh": "烤、烤肉吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "347/TALK",
            "narrator": "アーヤ",
            "text": "前に大学の友達と行った\nお店があるんだけど――",
            "zh": "以前跟大学朋友去过\n一家店——",
            "narrator_zh": "绫水"
        },
        {
            "location": "348/TALK",
            "narrator": "アーヤ",
            "text": "凄く種類も多くて、\n美味しいの。",
            "zh": "种类特别丰富，\n味道也很好哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "350/TALK",
            "narrator": "つばめ",
            "text": "近くにあるんですか？",
            "zh": "就在这附近吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "351/TALK",
            "narrator": "アーヤ",
            "text": "そこの角を曲がった\nビルの三階よ。",
            "zh": "前面拐角那栋楼的\n三楼就是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "352/TALK",
            "narrator": "アーヤ",
            "text": "どうする？\n他が良いなら焼肉じゃ\nなくてもいいけど。",
            "zh": "怎么样？\n要是想吃别的，\n不吃烤肉也行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "353/TALK",
            "narrator": "神楽",
            "text": "…焼肉は美味しそうだと\n思いますけど――",
            "zh": "……烤肉听起来是\n很诱人没错——",
            "narrator_zh": "神乐"
        },
        {
            "location": "354/TALK",
            "narrator": "神楽",
            "text": "今日は違う方が良いです。\n制服に臭いが付いちゃい\nますし…。",
            "zh": "不过今天还是换别的好了。\n制服上会沾满烤肉味的\n……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "356/TALK",
            "narrator": "アーヤ",
            "text": "あっ！",
            "zh": "啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "357/TALK",
            "narrator": "アーヤ",
            "text": "そうだった…。\n二人とも学校の制服\nだったの忘れてたわ。",
            "zh": "对哦……。\n我忘了她们俩穿的\n还是学校制服。",
            "narrator_zh": "绫水"
        },
        {
            "location": "358/TALK",
            "narrator": "神楽",
            "text": "今からクリーニングに\n出しても、明日の朝には\n間に合いませんし――",
            "zh": "现在送去干洗的话，\n明天早上肯定来不及\n拿——",
            "narrator_zh": "神乐"
        },
        {
            "location": "359/TALK",
            "narrator": "神楽",
            "text": "かといって、焼肉臭い\n制服で学校に行くのも、\nちょっと…。",
            "zh": "可要是穿着一身烤肉味的\n制服去上学，\n也有点……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "361/TALK",
            "narrator": "アーヤ",
            "text": "…ごめんなさい。\nうっかりしてたわ。",
            "zh": "……抱歉。\n是我一时疏忽了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "362/TALK",
            "narrator": "神楽",
            "text": "まあ、アーヤさんは\n普段私服ですから――",
            "zh": "嘛，绫水平时\n都是穿便服的——",
            "narrator_zh": "神乐"
        },
        {
            "location": "363/TALK",
            "narrator": "神楽",
            "text": "うっかりしちゃっても\n仕方ないと思いますよ。",
            "zh": "会没想到这点\n也是难免的啦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "365/TALK",
            "narrator": "つばめ",
            "text": "わたしも、匂いのこと\nまったく頭になかったよ。",
            "zh": "我也完全把气味的事\n抛到脑后了。",
            "narrator_zh": "燕"
        },
        {
            "location": "367/TALK",
            "narrator": "つばめ",
            "text": "卯月さんがいなかったら、\n明日大変なことになってた\nかも…。",
            "zh": "要是没有卯月提醒，\n明天说不定就大事不妙了\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "369/TALK",
            "narrator": "神楽",
            "text": "ダメですよ、つばめさん。\n女子力足りない、って\n思われちゃいますよ？",
            "zh": "这可不行哦，燕。\n会被人觉得\n女子力不够的哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "370/TALK",
            "narrator": "アーヤ",
            "text": "…でも、本当に何食べる？\n意見バラバラで決まり\nそうにないんだけど？",
            "zh": "……话虽如此，那到底吃什么？\n意见这么分散，\n感觉根本定不下来吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "373/TALK",
            "narrator": "神楽",
            "text": "う～ん…つばめさんは\n豚カツ食べたいですか？",
            "zh": "唔～嗯……燕，\n你很想吃炸猪排吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "377/TALK",
            "narrator": "つばめ",
            "text": "う～ん…どうしても、って\nわけじゃないけど…。",
            "zh": "唔～嗯……倒也不是\n非吃不可啦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "378/TALK",
            "narrator": "神楽",
            "text": "私も、そこまで\nブイヤベースを食べたい\nわけじゃなくて…。",
            "zh": "我其实也并不是\n那么非喝马赛鱼汤\n不可……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "379/TALK",
            "narrator": "アーヤ",
            "text": "…それなら、今日は\nこのまま寮に戻る？",
            "zh": "……既然这样，今天干脆\n直接回宿舍算了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "380/TALK",
            "narrator": "アーヤ",
            "text": "特に食べたい物も\nないなら、外食しても\n楽しくなさそうだし。",
            "zh": "既然没有特别想吃的，\n在外面吃好像也\n没什么意思。",
            "narrator_zh": "绫水"
        },
        {
            "location": "383/TALK",
            "narrator": "神楽",
            "text": "それが良さそうですね。\nつばめさんも、それで\nいいですか？",
            "zh": "这样挺好的。\n燕，你也\n觉得可以吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "384/TALK",
            "narrator": "つばめ",
            "text": "うん…今日は料理をして、\n女子力を取り戻す努力を\nするよ…。",
            "zh": "嗯……今天回去自己做饭，\n努力把女子力\n挽救回来……。",
            "narrator_zh": "燕"
        },
        {
            "location": "387/TALK",
            "narrator": "神楽",
            "text": "もぉ、さっき言ったのは\n冗談ですよ。",
            "zh": "真是的，刚才那话\n只是开玩笑啦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "390/TALK",
            "narrator": "アーヤ",
            "text": "…むしろ、焼肉を提案した\n私の方が気にしないと\nいけないわね。",
            "zh": "……真要说起来，提议吃烤肉的\n我才更应该\n在意才对吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "391/ACT",
            "narrator": "",
            "text": "濃厚なラーメンでしょ",
            "zh": "重口味拉面吧",
            "narrator_zh": ""
        },
        {
            "location": "393/TALK",
            "narrator": "アーヤ",
            "text": "いいわね、ラーメン！",
            "zh": "不错啊，拉面！",
            "narrator_zh": "绫水"
        },
        {
            "location": "394/TALK",
            "narrator": "アーヤ",
            "text": "みんなにも聞いてみるわ",
            "zh": "我问问大家去不去",
            "narrator_zh": "绫水"
        },
        {
            "location": "407/TALK",
            "narrator": "アーヤ",
            "text": "それなら、ラーメンなんて\nどうかしら？",
            "zh": "既然这样，吃拉面\n怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "409/TALK",
            "narrator": "つばめ",
            "text": "ラーメンですか？",
            "zh": "拉面吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "410/TALK",
            "narrator": "アーヤ",
            "text": "濃厚なラーメン、\n最近食べてないな、って\n思ってね。",
            "zh": "突然觉得，最近好久没吃\n浓汤重口味的拉面了\n呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "412/TALK",
            "narrator": "神楽",
            "text": "濃厚なラーメン…。\nそれも素敵ですね！",
            "zh": "重口味拉面……。\n这个主意也很不错呢！",
            "narrator_zh": "神乐"
        },
        {
            "location": "413/TALK",
            "narrator": "神楽",
            "text": "どこか、\n美味しいお店が\nあるんですか？",
            "zh": "这附近有什么\n好吃的店\n吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "414/TALK",
            "narrator": "アーヤ",
            "text": "ええ、すぐそこのお店が\nお勧めなんだけど――",
            "zh": "嗯，就在前面那家店\n我挺推荐的——",
            "narrator_zh": "绫水"
        },
        {
            "location": "415/TALK",
            "narrator": "アーヤ",
            "text": "どう、行ってみる？",
            "zh": "怎么样，去吃吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "418/TALK",
            "narrator": "つばめ",
            "text": "賛成です！\n卯月さん、行こうよ。",
            "zh": "赞成！\n卯月，走吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "421/TALK",
            "narrator": "神楽",
            "text": "…そうですね！\nお二人がそう言うなら、\n是非行きましょう！",
            "zh": "……好呀！\n既然你们俩都这么说了，\n那一定要去！",
            "narrator_zh": "神乐"
        },
        {
            "location": "422/TALK",
            "narrator": "アーヤ",
            "text": "決まりね。\nそれじゃ、行きましょ。",
            "zh": "就这么定了。\n那我们走吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "428/TALK",
            "narrator": "神楽",
            "text": "ふぅ…ちょっと、\nお腹が重いです…。",
            "zh": "呼……稍微，\n觉得胃里好沉……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "430/TALK",
            "narrator": "つばめ",
            "text": "卯月さん、大丈夫？",
            "zh": "卯月，还好吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "431/TALK",
            "narrator": "神楽",
            "text": "あんなに味が濃くて、\n具の多いラーメン、\n初めて食べました…。",
            "zh": "汤底这么浓、\n配料又这么足的拉面，\n我还是头一次吃……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "433/TALK",
            "narrator": "アーヤ",
            "text": "最後の方、必死になって\n食べてたのわかったわ。",
            "zh": "我看你吃到最后，\n简直是在拼命往嘴里塞呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "434/TALK",
            "narrator": "アーヤ",
            "text": "それで、感想は？",
            "zh": "所以，感想如何？",
            "narrator_zh": "绫水"
        },
        {
            "location": "436/TALK",
            "narrator": "神楽",
            "text": "はい！\n凄く美味しかったです！",
            "zh": "嗯！\n超级好吃！",
            "narrator_zh": "神乐"
        },
        {
            "location": "437/TALK",
            "narrator": "神楽",
            "text": "…ただ、カロリーが\n凄く高そうだったのが、\n少し心配ですけど…。",
            "zh": "……不过热量看起来\n高得吓人，\n稍微有点担心……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "438/TALK",
            "narrator": "アーヤ",
            "text": "感動が薄れることを\n考えるのは、野暮って\nものよ。",
            "zh": "光想着那些扫兴的事，\n可就太不解风情\n了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "441/TALK",
            "narrator": "アーヤ",
            "text": "…私も、しばらくは\n体重計に乗るのが\n怖いけど。",
            "zh": "……虽然我接下来一段日子，\n大概也不敢站上\n体重秤了就是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "458/ACT",
            "narrator": "",
            "text": "イタリアンで行こう",
            "zh": "就吃意式料理吧",
            "narrator_zh": ""
        },
        {
            "location": "459/TALK",
            "narrator": "アーヤ",
            "text": "その言い方、凄く素敵ね",
            "zh": "这个说法，太妙了",
            "narrator_zh": "绫水"
        },
        {
            "location": "460/TALK",
            "narrator": "アーヤ",
            "text": "気に入ったわ(≧ω≦)",
            "zh": "我喜欢(≧ω≦)",
            "narrator_zh": "绫水"
        },
        {
            "location": "472/TALK",
            "narrator": "アーヤ",
            "text": "イタリアンとかは\nどうかしら？",
            "zh": "意式料理之类的\n怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "474/TALK",
            "narrator": "神楽",
            "text": "イタリアン、ですか？",
            "zh": "意式料理，吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "476/TALK",
            "narrator": "アーヤ",
            "text": "そう、イタリアン。\nみんなで食べられる、\n美味しいのがあるでしょ？",
            "zh": "对，意式料理。\n不是有那种大家能一起\n分着吃的美食嘛？",
            "narrator_zh": "绫水"
        },
        {
            "location": "478/TALK",
            "narrator": "つばめ",
            "text": "イタリアンで、みんなで\n食べられるものって\nいうと…。",
            "zh": "意式料理里，大家能一起\n分着吃的东西\n是指……。",
            "narrator_zh": "燕"
        },
        {
            "location": "480/TALK",
            "narrator": "神楽",
            "text": "あっ、わかりました！",
            "zh": "啊，我懂了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "482/TALK",
            "narrator": "神楽",
            "text": "私も賛成です。\nイタリアンにしましょう。",
            "zh": "我也赞成。\n就吃意式料理吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "483/TALK",
            "narrator": "アーヤ",
            "text": "卯月はわかったみたいね。",
            "zh": "看来卯月已经心领神会了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "484/TALK",
            "narrator": "神楽",
            "text": "もちろんです。\nでも、凄いですね。",
            "zh": "那是当然。\n不过，真是厉害呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "485/TALK",
            "narrator": "神楽",
            "text": "ケーキの後にあれを\n食べようって言うと、\n凄く罪悪感あるのに――",
            "zh": "本来吃完蛋糕后\n再说要吃那个，\n罪恶感会特别重的——",
            "narrator_zh": "神乐"
        },
        {
            "location": "486/TALK",
            "narrator": "神楽",
            "text": "イタリアン、って\nぼかすと、少しだけ\n薄れる気がします。",
            "zh": "但模糊地说成「意式料理」，\n总觉得罪恶感一下子\n淡了不少呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "487/TALK",
            "narrator": "アーヤ",
            "text": "そういうことよ。\nつばめも、それでいい？",
            "zh": "就是这么回事。\n燕，你也没意见吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "489/TALK",
            "narrator": "つばめ",
            "text": "え、えっと…\nイタリアンっていうのは\nその――",
            "zh": "诶、诶多……\n意式料理是指\n那个——",
            "narrator_zh": "燕"
        },
        {
            "location": "492/TALK",
            "narrator": "つばめ",
            "text": "ピザのことですよね？",
            "zh": "披萨对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "493/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "495/TALK",
            "narrator": "神楽",
            "text": "…ハッキリ言わないように\nしてたのに、おもいっきり\n言いましたね？",
            "zh": "……我们明明特意不挑明，\n你居然就这么直接\n说出来了呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "496/TALK",
            "narrator": "つばめ",
            "text": "えっ…あ、あぁっ！",
            "zh": "诶……啊、啊啊！",
            "narrator_zh": "燕"
        },
        {
            "location": "498/TALK",
            "narrator": "つばめ",
            "text": "ごめんなさい！\n全然気づかなかったよぉ。",
            "zh": "对不起！\n我完全没反应过来啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "499/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、どう取り繕っても\nピザ食べに行くのには\n変わらないんだし――",
            "zh": "……嘛，反正不管怎么掩饰，\n要去吃披萨这件事\n本身都不会变——",
            "narrator_zh": "绫水"
        },
        {
            "location": "500/TALK",
            "narrator": "アーヤ",
            "text": "もう開き直って、\nピザ食べに行くわよ。",
            "zh": "干脆破罐子破摔，\n吃披萨去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "503/TALK",
            "narrator": "神楽",
            "text": "ふふっ、そうですね。\nもう今日はお腹いっぱい\n食べちゃいます！",
            "zh": "呵呵，说得也是。\n今天干脆吃到肚子\n撑满为止吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "504/TALK",
            "narrator": "つばめ",
            "text": "どんなピザがあるかな？\n楽しみだね！",
            "zh": "会有什么样的披萨呢？\n好期待呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "234/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月10日　5:34 PM</color>\n初夏の週末、午後の神楽坂通り。",
            "zh": "<color=green>7月10日　5:34 PM</color>\n初夏的周末，午后的神乐坂大街。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "452/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch02",
            "text": "【ダイエットは明日から】",
            "zh": "【减肥从明天开始】",
            "narrator_zh": "Dialog_GEThimegoto_ch02"
        }
    ]
}
