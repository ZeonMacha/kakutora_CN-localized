        "sub_title_zh": "敌人Ⅰ＜归结＞"
    },
    "entry": [
        {
            "location": "240/SCENARIO",
            "narrator": "",
            "text": "バトル終了",
            "zh": "战斗结束",
            "narrator_zh": ""
        },
        {
            "location": "250/TALK",
            "narrator": "潜在みやび",
            "text": "うっ……\nさすがにしんどいね。",
            "zh": "唔……\n果然有点吃不消咯。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "251/TALK",
            "narrator": "表層みやび",
            "text": "がんばりや。\nその演技もあと\n数ワードで終わりやき。",
            "zh": "加油啊。\n这出戏再演\n几个词就结束了啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "252/TALK",
            "narrator": "潜在みやび",
            "text": "うむ。",
            "zh": "嗯。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "253/TALK",
            "narrator": "表層みやび",
            "text": "正直、うちが負けたの\nも全部$handle$が\n参戦したからやき。",
            "zh": "老实说，我会输\n也全是因为$handle$\n参战了啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "254/TALK",
            "narrator": "表層みやび",
            "text": "あの時もっと真剣に\n追い出しておけばと\n後悔しちょるきね…。",
            "zh": "早知道那时候\n就认真把你赶出去，\n现在后悔着啵……。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "255/TALK",
            "narrator": "潜在みやび",
            "text": "負けたのは\nうちや。けんど――",
            "zh": "输掉的是\n我。但是——",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "256/TALK",
            "narrator": "表層みやび",
            "text": "うちら二人で見れば、\n二人とも戦いには\n勝ったよやね。",
            "zh": "从我们两个来看，\n两个人都赢了\n这场战斗咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "257/TALK",
            "narrator": "潜在みやび",
            "text": "うむ。",
            "zh": "嗯。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "258/TALK",
            "narrator": "表層みやび",
            "text": "もう思い残すことは\nないちや。",
            "zh": "已经没得\n遗憾滴。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "260/TALK",
            "narrator": "潜在みやび",
            "text": "うちもや。",
            "zh": "我也是。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "261/TALK",
            "narrator": "表層みやび",
            "text": "$handle$よ。\n希望を持ったであろう\n我らがみやびを――",
            "zh": "$handle$啊。\n那位大概已经怀抱希望的\n我们的雅——",
            "narrator_zh": "表层雅"
        },
        {
            "location": "262/TALK",
            "narrator": "潜在みやび",
            "text": "よろしく頼んだきね。",
            "zh": "就拜托你照看啵。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "272/TALK",
            "narrator": "表層みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "273/SEL",
            "narrator": "（選択肢）",
            "text": "あれ？　名前変えた！？",
            "zh": "咦？　改名字了！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "274/SEL",
            "narrator": "（選択肢）",
            "text": "あれ？　服着替えた！？",
            "zh": "咦？　换衣服了！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "275/SEL",
            "narrator": "（選択肢）",
            "text": "あれ？　フュージョンした！？",
            "zh": "咦？　融合了！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "276/ACT",
            "narrator": "",
            "text": "あれ？　名前変えた！？",
            "zh": "咦？　改名字了！？",
            "narrator_zh": ""
        },
        {
            "location": "277/TALK",
            "narrator": "表層みやび",
            "text": "さあね。",
            "zh": "谁知道呢。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "278/ACT",
            "narrator": "",
            "text": "あれ？　服着替えた！？",
            "zh": "咦？　换衣服了！？",
            "narrator_zh": ""
        },
        {
            "location": "279/TALK",
            "narrator": "表層みやび",
            "text": "さあね。",
            "zh": "谁知道呢。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "280/ACT",
            "narrator": "",
            "text": "あれ？　フュージョンした！？",
            "zh": "咦？　融合了！？",
            "narrator_zh": ""
        },
        {
            "location": "286/DIALOG",
            "narrator": "",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": ""
        },
        {
            "location": "290/TALK",
            "narrator": "表層みやび",
            "text": "失礼な。こう見えても\n一応うちは地球人や。\n戦闘民族やないぞね。",
            "zh": "真没礼貌。别看这样，\n好歹我也是地球人。\n才不是战斗民族咧。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "292/TALK",
            "narrator": "表層みやび",
            "text": "うちは正真正銘、\nアンタと共に闘って\n勝った方のうちや。",
            "zh": "我货真价实，\n是跟你一起并肩作战\n赢下来的那个我。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "293/TALK",
            "narrator": "表層みやび",
            "text": "まあ、一つだけ\n言えることは――",
            "zh": "嘛，唯独有一件事\n可以说的是——",
            "narrator_zh": "表层雅"
        },
        {
            "location": "294/TALK",
            "narrator": "表層みやび",
            "text": "アンタには何一つ、\nうちの真実は見せん\nっちゅうことやね。",
            "zh": "关于我的真相，\n一点都不会\n给你看咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "295/SEL",
            "narrator": "（選択肢）",
            "text": "それは酷い",
            "zh": "这也太过分了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "296/SEL",
            "narrator": "（選択肢）",
            "text": "現実のみやびが無気力から脱してくれればそれでいい",
            "zh": "只要现实里的雅能摆脱无精打采就行",
            "narrator_zh": "（选项）"
        },
        {
            "location": "297/ACT",
            "narrator": "",
            "text": "それは酷い",
            "zh": "这也太过分了",
            "narrator_zh": ""
        },
        {
            "location": "298/TALK",
            "narrator": "表層みやび",
            "text": "うむ。\nまっこと酷いよや。",
            "zh": "嗯。\n真是蛮过分咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "299/ACT",
            "narrator": "",
            "text": "現実のみやびが無気力から脱してくれればそれでいい",
            "zh": "只要现实里的雅能摆脱无精打采就行",
            "narrator_zh": ""
        },
        {
            "location": "305/DIALOG",
            "narrator": "",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": ""
        },
        {
            "location": "309/TALK",
            "narrator": "表層みやび",
            "text": "ふむ。\nまっことオメデタイ\n頭をしちょるね。",
            "zh": "唔。\n脑子真是\n蛮天真咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "311/TALK",
            "narrator": "表層みやび",
            "text": "$handle$、\n気づいちょるか？",
            "zh": "$handle$，\n你察觉没？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "312/TALK",
            "narrator": "表層みやび",
            "text": "あんたはうちが\nどっちのみやびか\n分かっちょらんき――",
            "zh": "你根本分不清\n我是哪一边的\n雅啵——",
            "narrator_zh": "表层雅"
        },
        {
            "location": "313/TALK",
            "narrator": "表層みやび",
            "text": "もしかしたらバトル前\nに入れ替わった頑固系\nうちかもしれんがよ？",
            "zh": "说不定我才是战前\n调包过来的顽固系\n那个我咯？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "314/TALK",
            "narrator": "表層みやび",
            "text": "もしそうやったら――",
            "zh": "要是那样的话——",
            "narrator_zh": "表层雅"
        },
        {
            "location": "315/TALK",
            "narrator": "表層みやび",
            "text": "現実のうちには\n今後もアンタの期待する\n変化は起こらない。",
            "zh": "现实里的我，\n今后也不会发生\n你期待的变化。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "316/TALK",
            "narrator": "表層みやび",
            "text": "まさに“一矢報いる”\nってヤツや。",
            "zh": "这就叫“回敬一箭”\n咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "317/SEL",
            "narrator": "（選択肢）",
            "text": "なんでそこまで$me$を嫌うの？",
            "zh": "为什么要这么讨厌$me$？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "318/ACT",
            "narrator": "",
            "text": "なんでそこまで$me$を嫌うの？",
            "zh": "为什么要这么讨厌$me$？",
            "narrator_zh": ""
        },
        {
            "location": "320/TALK",
            "narrator": "表層みやび",
            "text": "別に嫌っちゅう\nわけやないき。",
            "zh": "倒也不是\n讨厌你啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "321/TALK",
            "narrator": "表層みやび",
            "text": "ただ単に、\n「敵」っちゅうだけや。",
            "zh": "只是单纯把你\n当“敌人”而已。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "322/TALK",
            "narrator": "表層みやび",
            "text": "やき、安心しいや。",
            "zh": "所以，放心咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "324/TALK",
            "narrator": "表層みやび",
            "text": "まあ、あんたが\nうちを詮索したり――",
            "zh": "嘛，只要你\n不来刺探我——",
            "narrator_zh": "表层雅"
        },
        {
            "location": "325/SEL",
            "narrator": "（選択肢）",
            "text": "みやび！うしろうしろ！！",
            "zh": "雅！后面后面！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "326/TALK",
            "narrator": "表層みやび",
            "text": "ココロクラッキング\nして、うちのヒミツを\n盗んだりせんなら――",
            "zh": "只要不来搞心灵骇入\n偷窥我的秘密\n的话——",
            "narrator_zh": "表层雅"
        },
        {
            "location": "327/TALK",
            "narrator": "表層みやび",
            "text": "「敵」とはいえ、\n茶飲み友達くらいの\n感覚でつきあえるきね。",
            "zh": "虽说是“敌人”，\n当成个喝茶聊天的好友\n相处倒还行啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "328/ACT",
            "narrator": "",
            "text": "みやび！うしろうしろ！！",
            "zh": "雅！后面后面！！",
            "narrator_zh": ""
        },
        {
            "location": "331/TALK",
            "narrator": "表層みやび",
            "text": "なんや、うしろって…",
            "zh": "做驷马，后面怎么……",
            "narrator_zh": "表层雅"
        },
        {
            "location": "335/TALK",
            "narrator": "表層みやび",
            "text": "なっ……！？",
            "zh": "啥……！？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "336/TALK",
            "narrator": "？？？",
            "text": "ねえ、みやー。\nその人、\nみやの敵なの？",
            "zh": "呐，小雅——。\n那个人，\n是小雅的敌人吗？",
            "narrator_zh": "？？？"
        },
        {
            "location": "337/TALK",
            "narrator": "表層みやび",
            "text": "ちょ！\nなごちゃ……",
            "zh": "等下！\n七五……",
            "narrator_zh": "表层雅"
        },
        {
            "location": "339/TALK",
            "narrator": "表層みやび",
            "text": "今出てきよったら\nいかんちや！",
            "zh": "现在出来\n可不行滴！",
            "narrator_zh": "表层雅"
        },
        {
            "location": "340/TALK",
            "narrator": "？？？",
            "text": "でも、みやの敵なら\nなごがあいつを\nやっつけるから",
            "zh": "可是，如果是小雅的敌人，\n七五去把那家伙\n收拾掉",
            "narrator_zh": "？？？"
        },
        {
            "location": "341/TALK",
            "narrator": "表層みやび",
            "text": "えいから…、\n敵いうてもまだ何も\nされちょらんき。",
            "zh": "行了……，\n虽说是敌人，人家也还\n什么都没做啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "342/SEL",
            "narrator": "（選択肢）",
            "text": "どなたですか？",
            "zh": "请问是哪位？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "343/SEL",
            "narrator": "（選択肢）",
            "text": "初めまして！なごちゃん！",
            "zh": "初次见面！七五！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "344/ACT",
            "narrator": "",
            "text": "どなたですか？",
            "zh": "请问是哪位？",
            "narrator_zh": ""
        },
        {
            "location": "347/TALK",
            "narrator": "表層みやび",
            "text": "あんたには\n関係ないき！",
            "zh": "跟你\n没关系啵！",
            "narrator_zh": "表层雅"
        },
        {
            "location": "348/TALK",
            "narrator": "表層みやび",
            "text": "もう用は済んじょるろ、\nはよ現実に戻りや！",
            "zh": "事都办完了吧，\n快回现实去！",
            "narrator_zh": "表层雅"
        },
        {
            "location": "350/TALK",
            "narrator": "？？？",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "？？？"
        },
        {
            "location": "358/TALK",
            "narrator": "表層みやび",
            "text": "なごちゃん！\nいかんよ！！",
            "zh": "七五！\n不行哦！！",
            "narrator_zh": "表层雅"
        },
        {
            "location": "359/ACT",
            "narrator": "",
            "text": "初めまして！なごちゃん！",
            "zh": "初次见面！七五！",
            "narrator_zh": ""
        },
        {
            "location": "362/TALK",
            "narrator": "表層みやび",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "364/TALK",
            "narrator": "？？？",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "？？？"
        },
        {
            "location": "372/TALK",
            "narrator": "表層みやび",
            "text": "なごちゃん！\nいかんよ！！",
            "zh": "七五！\n不行哦！！",
            "narrator_zh": "表层雅"
        },
        {
            "location": "373/TALK",
            "narrator": "表層みやび",
            "text": "あんたももう\n用は済んじょるろ！\nはよ現実に戻りや！",
            "zh": "你也是，事都\n办完了吧！\n快回现实去！",
            "narrator_zh": "表层雅"
        },
        {
            "location": "376/TALK",
            "narrator": "？？？",
            "text": "こんどまた\nみやに手ぇ出したら――",
            "zh": "下次再敢\n对小雅出手的话——",
            "narrator_zh": "？？？"
        },
        {
            "location": "395/TALK",
            "narrator": "千羽鶴",
            "text": "さて。",
            "zh": "那么。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "396/SEL",
            "narrator": "（選択肢）",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "397/ACT",
            "narrator": "",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": ""
        },
        {
            "location": "399/TALK",
            "narrator": "千羽鶴",
            "text": "？",
            "zh": "？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "400/TALK",
            "narrator": "千羽鶴",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "401/SEL",
            "narrator": "（選択肢）",
            "text": "なんかすごいものを見た",
            "zh": "总觉得看到了了不得的东西",
            "narrator_zh": "（选项）"
        },
        {
            "location": "402/SEL",
            "narrator": "（選択肢）",
            "text": "えーん、ちーちゃん助けて(;_;)",
            "zh": "呜哇——，小千救命(;_;)",
            "narrator_zh": "（选项）"
        },
        {
            "location": "403/ACT",
            "narrator": "",
            "text": "なんかすごいものを見た",
            "zh": "总觉得看到了了不得的东西",
            "narrator_zh": ""
        },
        {
            "location": "405/TALK",
            "narrator": "千羽鶴",
            "text": "そう。",
            "zh": "是吗。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "406/ACT",
            "narrator": "",
            "text": "えーん、ちーちゃん助けて(;_;)",
            "zh": "呜哇——，小千救命(;_;)",
            "narrator_zh": ""
        },
        {
            "location": "412/DIALOG",
            "narrator": "",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>500pt.</b></color></size>\n增加了！",
            "narrator_zh": ""
        },
        {
            "location": "416/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "417/TALK",
            "narrator": "千羽鶴",
            "text": "はーい、よしよし。\n怖かったでちゅね。",
            "zh": "好——，乖乖乖。\n吓坏了对不对呀。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "419/TALK",
            "narrator": "千羽鶴",
            "text": "…これでいい？",
            "zh": "……这样可以了吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "420/SEL",
            "narrator": "（選択肢）",
            "text": "えー",
            "zh": "诶——",
            "narrator_zh": "（选项）"
        },
        {
            "location": "421/SEL",
            "narrator": "（選択肢）",
            "text": "ありがとうございます！",
            "zh": "非常感谢！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "422/SEL",
            "narrator": "（選択肢）",
            "text": "もっとやって！！",
            "zh": "请再来一次！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "423/ACT",
            "narrator": "",
            "text": "えー",
            "zh": "诶——",
            "narrator_zh": ""
        },
        {
            "location": "425/TALK",
            "narrator": "千羽鶴",
            "text": "不満なのね。\n良く解らない人。",
            "zh": "你不满啊。\n真是搞不懂的人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "427/ACT",
            "narrator": "",
            "text": "ありがとうございます！",
            "zh": "非常感谢！",
            "narrator_zh": ""
        },
        {
            "location": "428/TALK",
            "narrator": "千羽鶴",
            "text": "どういたしまして。",
            "zh": "不客气。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "430/ACT",
            "narrator": "",
            "text": "もっとやって！！",
            "zh": "请再来一次！！",
            "narrator_zh": ""
        },
        {
            "location": "436/DIALOG",
            "narrator": "",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>1000pt.</b></color></size>\n增加了！",
            "narrator_zh": ""
        },
        {
            "location": "440/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。\nあなたのプレイ傾向は\n把握した。",
            "zh": "原来如此。\n你的游玩倾向，\n我已经掌握了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "444/TALK",
            "narrator": "千羽鶴",
            "text": "まあ。\n人の心の中に入れば\n普通にあること。",
            "zh": "嘛。\n进了别人的心里，\n这种事很常见。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "445/TALK",
            "narrator": "千羽鶴",
            "text": "あなたが何を見たかは\nわからないけど、多分\nまだ序の口だと思う。",
            "zh": "虽然不知道你\n看到了什么，不过\n大概还只是个开头。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "446/TALK",
            "narrator": "千羽鶴",
            "text": "それくらいに、\n人の心は複雑で無情、\nそして残酷なもの。",
            "zh": "人心就是这么\n复杂、无情，\n而又残酷的东西。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "447/TALK",
            "narrator": "千羽鶴",
            "text": "覚えておくといいわ。",
            "zh": "记住这点比较好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "472/TALK",
            "narrator": "千羽鶴",
            "text": "おめでとう。",
            "zh": "恭喜你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "473/TALK",
            "narrator": "千羽鶴",
            "text": "あなたは彼女の\nココロの迷いを解消し、\n一歩前進させた。",
            "zh": "你解开了她\n心里的迷茫，\n让她往前走了一步。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "474/SEL",
            "narrator": "（選択肢）",
            "text": "えっへん",
            "zh": "嘿嘿",
            "narrator_zh": "（选项）"
        },
        {
            "location": "475/SEL",
            "narrator": "（選択肢）",
            "text": "あまり実感ない",
            "zh": "没什么实感",
            "narrator_zh": "（选项）"
        },
        {
            "location": "476/SEL",
            "narrator": "（選択肢）",
            "text": "本当にこれで良かったのだろうか",
            "zh": "这样真的好吗",
            "narrator_zh": "（选项）"
        },
        {
            "location": "477/ACT",
            "narrator": "",
            "text": "えっへん",
            "zh": "嘿嘿",
            "narrator_zh": ""
        },
        {
            "location": "478/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。\n今回ばかりは\n誇っていいと思う。",
            "zh": "是的。\n只有这一次，\n可以觉得骄傲。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "479/ACT",
            "narrator": "",
            "text": "あまり実感ない",
            "zh": "没什么实感",
            "narrator_zh": ""
        },
        {
            "location": "480/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。\nそう思うかも知れない。\nでも――",
            "zh": "是的。\n也许会这么想。\n但是——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "481/ACT",
            "narrator": "",
            "text": "本当にこれで良かったのだろうか",
            "zh": "这样真的好吗",
            "narrator_zh": ""
        },
        {
            "location": "483/TALK",
            "narrator": "千羽鶴",
            "text": "選択に絶対的な\n正解なんて最初から\n存在しない。",
            "zh": "选择从一开始\n就不存在绝对的\n正确答案。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "485/TALK",
            "narrator": "千羽鶴",
            "text": "汚い言い方をすれば、\n利己的な選択をし、\n結果が伴えば正解。",
            "zh": "说得难听一点，\n做出利己的选择，\n只要有了结果就是正确。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "486/TALK",
            "narrator": "千羽鶴",
            "text": "それは申し訳無いけど\n今はあなたも知らない\n私の思惑も含めて。",
            "zh": "这话很抱歉，\n其中也包括你现在还不知道的\n我的盘算。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "487/TALK",
            "narrator": "千羽鶴",
            "text": "一般的にも、ダメな\n選択をしたと思ったら\n物事が好転したり――",
            "zh": "一般说来，也会有\n觉得做了糟糕的选择，\n事情却好转的情况——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "488/TALK",
            "narrator": "千羽鶴",
            "text": "逆に順当な選択をした\nつもりが、後悔する\n結果になったりもする。",
            "zh": "反过来，本以为\n做了稳妥的选择，\n结果却会后悔。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "489/TALK",
            "narrator": "千羽鶴",
            "text": "大事なのは\n「自分はどうしたいか」",
            "zh": "重要的是\n“自己想怎样”",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "490/TALK",
            "narrator": "千羽鶴",
            "text": "周囲のノイズを遮断し\n自分で決めること。",
            "zh": "隔绝周围的噪音，\n由自己来决定。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "491/TALK",
            "narrator": "千羽鶴",
            "text": "私があなたにお願い\nしたいのは、あくまで\nそのサポートなの。",
            "zh": "我想请你做的，\n归根结底是\n这份支持。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "493/TALK",
            "narrator": "千羽鶴",
            "text": "人のココロを動かす\nには、いつも大きな\n力が必要とは限らない。",
            "zh": "打动人的心，\n并不总是需要\n很大的力量。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "494/TALK",
            "narrator": "千羽鶴",
            "text": "些細なきっかけを\n与えるだけで、整理が\nつくこともある。",
            "zh": "有时只给一个\n细小的契机，\n心里就能理清。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "495/TALK",
            "narrator": "千羽鶴",
            "text": "そうやって、逃げずに\n決めて、それを実行\nすることは――",
            "zh": "像这样，不逃避地\n做出决定，再去实行\n——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "496/TALK",
            "narrator": "千羽鶴",
            "text": "次第にココロを\n強くすることに繋がる。",
            "zh": "会渐渐让心\n变得坚强。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "497/SEL",
            "narrator": "（選択肢）",
            "text": "よくわからない",
            "zh": "不太明白",
            "narrator_zh": "（选项）"
        },
        {
            "location": "498/ACT",
            "narrator": "",
            "text": "よくわからない",
            "zh": "不太明白",
            "narrator_zh": ""
        },
        {
            "location": "500/TALK",
            "narrator": "千羽鶴",
            "text": "一気に理解は\n出来ないと思う。",
            "zh": "我想你没法\n一下子就理解。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "501/TALK",
            "narrator": "千羽鶴",
            "text": "とにかくあなたには、\nこれからもずっと、\n今回の様に――",
            "zh": "总之，希望你\n今后也一直，\n像这次这样——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "502/TALK",
            "narrator": "千羽鶴",
            "text": "彼女のココロの成長を\n支援してあげて欲しい。",
            "zh": "去支持她的心\n成长。",
            "narrator_zh": "千羽鹤"
        }
    ]
}
