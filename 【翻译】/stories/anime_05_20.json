    },
    "entry": [
        {
            "location": "534/SCENARIO",
            "narrator": "",
            "text": "アニメ第21話",
            "zh": "动画第21话",
            "narrator_zh": ""
        },
        {
            "location": "547/TALK",
            "narrator": "千羽鶴",
            "text": "ごきげんよう、\n$handle$。",
            "zh": "贵安，\n$handle$。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "548/TALK",
            "narrator": "千羽鶴",
            "text": "もう一度\n私との会話を\n再現する？",
            "zh": "要再重现一次\n和我的\n对话吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "549/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "550/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "否",
            "narrator_zh": ""
        },
        {
            "location": "551/SEL",
            "narrator": "",
            "text": "にゃボットの解説だけ聞く",
            "zh": "只听喵Bot的解说",
            "narrator_zh": ""
        },
        {
            "location": "552/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "553/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "我知道了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "555/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "否",
            "narrator_zh": ""
        },
        {
            "location": "556/TALK",
            "narrator": "千羽鶴",
            "text": "そう。",
            "zh": "是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "558/ACT",
            "narrator": "",
            "text": "にゃボットの解説だけ聞く",
            "zh": "只听喵Bot的解说",
            "narrator_zh": ""
        },
        {
            "location": "559/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "我知道了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "567/TALK",
            "narrator": "千羽鶴",
            "text": "今回もまた、特に\n重要な話はない\nゲームセクションだけど…",
            "zh": "这次也一样，虽说是\n没什么重要内容的\n游戏单元……",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "569/TALK",
            "narrator": "千羽鶴",
            "text": "聞くだけ野暮だった。",
            "zh": "问了也白问。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "570/TALK",
            "narrator": "千羽鶴",
            "text": "貴方は前回も\nクイズをやって\nにゃボットを貰ってる。",
            "zh": "你上次也\n做了猜谜\n拿到了喵Bot。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "571/TALK",
            "narrator": "千羽鶴",
            "text": "今回も是非\n楽しんでいって。",
            "zh": "这次也请务必\n玩得开心。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "573/TALK",
            "narrator": "千羽鶴",
            "text": "やっていく？",
            "zh": "要参加吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "574/SEL",
            "narrator": "",
            "text": "帰ります",
            "zh": "回去了",
            "narrator_zh": ""
        },
        {
            "location": "575/SEL",
            "narrator": "",
            "text": "やっていく",
            "zh": "要参加",
            "narrator_zh": ""
        },
        {
            "location": "576/ACT",
            "narrator": "",
            "text": "帰ります",
            "zh": "回去了",
            "narrator_zh": ""
        },
        {
            "location": "577/TALK",
            "narrator": "千羽鶴",
            "text": "そう。",
            "zh": "是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "578/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃ、また。",
            "zh": "那么，回头见。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "580/ACT",
            "narrator": "",
            "text": "やっていく",
            "zh": "要参加",
            "narrator_zh": ""
        },
        {
            "location": "581/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "我知道了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "582/TALK",
            "narrator": "千羽鶴",
            "text": "今回は、トライナリーの\n5人も参加するから、\n是非楽しんでいって。",
            "zh": "这次，三重奏的\n5个人也会参加，\n请务必玩得开心。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "583/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃ――",
            "zh": "那么——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "590/TALK",
            "narrator": "千羽鶴",
            "text": "<size=40>どーん！</size>",
            "zh": "<size=40>咚！</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "591/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\n今回もまた特別回！",
            "zh": "于是，\n这次也是特别回！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "592/SEL",
            "narrator": "",
            "text": "千羽鶴キター",
            "zh": "千羽鹤登场啦",
            "narrator_zh": ""
        },
        {
            "location": "593/SEL",
            "narrator": "",
            "text": "今回は何やるの？",
            "zh": "这次要干嘛？",
            "narrator_zh": ""
        },
        {
            "location": "594/ACT",
            "narrator": "",
            "text": "千羽鶴キター",
            "zh": "千羽鹤登场啦",
            "narrator_zh": ""
        },
        {
            "location": "595/ACT",
            "narrator": "",
            "text": "今回は何やるの？",
            "zh": "这次要干嘛？",
            "narrator_zh": ""
        },
        {
            "location": "601/TALK",
            "narrator": "千羽鶴",
            "text": "<size=35><color=red>トライナリーと\nじゃんけん大会！</color></size>",
            "zh": "<size=35><color=red>和三重奏的\n猜拳大会！</color></size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "602/SEL",
            "narrator": "",
            "text": "ドンドンパフパフ！",
            "zh": "咚咚啪啪！",
            "narrator_zh": ""
        },
        {
            "location": "603/SEL",
            "narrator": "",
            "text": "名前が直球すぎじゃね？",
            "zh": "这名字是不是太直球了点？",
            "narrator_zh": ""
        },
        {
            "location": "604/SEL",
            "narrator": "",
            "text": "そんな事やってる暇あんの？",
            "zh": "还有闲工夫搞这种事吗？",
            "narrator_zh": ""
        },
        {
            "location": "605/ACT",
            "narrator": "",
            "text": "ドンドンパフパフ！",
            "zh": "咚咚啪啪！",
            "narrator_zh": ""
        },
        {
            "location": "607/ACT",
            "narrator": "",
            "text": "名前が直球すぎじゃね？",
            "zh": "这名字是不是太直球了点？",
            "narrator_zh": ""
        },
        {
            "location": "608/TALK",
            "narrator": "千羽鶴",
            "text": "黙れ。",
            "zh": "闭嘴。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "609/ACT",
            "narrator": "",
            "text": "そんな事やってる暇あんの？",
            "zh": "还有闲工夫搞这种事吗？",
            "narrator_zh": ""
        },
        {
            "location": "610/TALK",
            "narrator": "千羽鶴",
            "text": "今回はMV回。\nMV回はTRI-OSが\nガベコレする時間。",
            "zh": "这次是MV回。\nMV回是TRI-OS\n进行GC的时间。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "611/SEL",
            "narrator": "",
            "text": "それ前も聞いた",
            "zh": "这个上次听过了",
            "narrator_zh": ""
        },
        {
            "location": "612/SEL",
            "narrator": "",
            "text": "ガベコレってなに？",
            "zh": "GC是什么？",
            "narrator_zh": ""
        },
        {
            "location": "613/ACT",
            "narrator": "",
            "text": "それ前も聞いた",
            "zh": "这个上次听过了",
            "narrator_zh": ""
        },
        {
            "location": "614/TALK",
            "narrator": "千羽鶴",
            "text": "知ってる。",
            "zh": "我知道。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "615/ACT",
            "narrator": "",
            "text": "ガベコレってなに？",
            "zh": "GC是什么？",
            "narrator_zh": ""
        },
        {
            "location": "616/TALK",
            "narrator": "千羽鶴",
            "text": "ガベージコレクション。\nシステムの最適化と\nゴミ捨てをする時間。",
            "zh": "垃圾回收（Garbage Collection）。\n进行系统优化和\n清理垃圾的时间。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "618/TALK",
            "narrator": "千羽鶴",
            "text": "だから、ろくに何の機能も\n動かないし、未来に対して\nアプローチもできない。",
            "zh": "所以，几乎什么功能都\n运行不了，也无法对未来\n采取任何行动。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "622/TALK",
            "narrator": "千羽鶴",
            "text": "<color=red><size=40>遊ぶが大吉！</size></color>",
            "zh": "<color=red><size=40>玩乐即大吉！</size></color>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "623/TALK",
            "narrator": "千羽鶴",
            "text": "人生ゆとりもまた\n必要だと思う。",
            "zh": "我觉得人生也需要\n一点余裕。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "624/TALK",
            "narrator": "千羽鶴",
            "text": "楽しい事をやって\n笑うだけで、寿命が\n延びると言われてる！",
            "zh": "据说光是做开心的事\n笑一笑，就能\n延长寿命！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "625/SEL",
            "narrator": "",
            "text": "うむ、確かに",
            "zh": "嗯，确实如此",
            "narrator_zh": ""
        },
        {
            "location": "626/SEL",
            "narrator": "",
            "text": "いや、このアプリが一番辛いのですが",
            "zh": "不，明明这个应用才是最折磨人的",
            "narrator_zh": ""
        },
        {
            "location": "627/ACT",
            "narrator": "",
            "text": "うむ、確かに",
            "zh": "嗯，确实如此",
            "narrator_zh": ""
        },
        {
            "location": "628/ACT",
            "narrator": "",
            "text": "いや、このアプリが一番辛いのですが",
            "zh": "不，明明这个应用才是最折磨人的",
            "narrator_zh": ""
        },
        {
            "location": "630/TALK",
            "narrator": "千羽鶴",
            "text": "揚げ足とりめ。",
            "zh": "少挑刺。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "633/TALK",
            "narrator": "千羽鶴",
            "text": "ぷぷい。",
            "zh": "噗噗伊。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "634/TALK",
            "narrator": "千羽鶴",
            "text": "そこは空気読んで\n同意するところだから。",
            "zh": "那种地方就该读懂空气\n顺着同意才对。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "641/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\n早速だけどルールと賞品の\n説明をする。",
            "zh": "于是，\n事不宜迟，我来说明一下\n规则和奖品。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "642/TALK",
            "narrator": "千羽鶴",
            "text": "貴方は最初、ジャンケン用\nジャンコインを５枚、\n持っている。",
            "zh": "你一开始拥有\n5枚猜拳专用的\n猜拳币。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "643/TALK",
            "narrator": "千羽鶴",
            "text": "原則として、\n勝てばコインが増えて、\n負ければ減る。",
            "zh": "原则上，\n赢了硬币就会增加，\n输了就会减少。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "644/TALK",
            "narrator": "千羽鶴",
            "text": "そして\n10枚ゲットすれば――",
            "zh": "只要集齐\n10枚——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "653/TALK",
            "narrator": "千羽鶴",
            "text": "鬼才國政領火博士制作、\n多足ロボットにゃボットが\n育てられる連載型クラン！",
            "zh": "鬼才国政领火博士制作、\n可以养育多足机器人喵Bot的\n连载型库兰！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "654/TALK",
            "narrator": "千羽鶴",
            "text": "<color=green>定期刊クラン誌\n『にゃぼにゃすティー』\n第二巻</color>をプレゼント！",
            "zh": "就送你<color=green>定期刊库兰志\n『喵博尼亚斯蒂』\n第二卷</color>！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "658/SEL",
            "narrator": "",
            "text": "にゃボット２個目キター！",
            "zh": "第2只喵Bot来啦！",
            "narrator_zh": ""
        },
        {
            "location": "659/SEL",
            "narrator": "",
            "text": "にゃボットってなに？",
            "zh": "喵Bot是什么？",
            "narrator_zh": ""
        },
        {
            "location": "660/ACT",
            "narrator": "",
            "text": "にゃボット２個目キター！",
            "zh": "第2只喵Bot来啦！",
            "narrator_zh": ""
        },
        {
            "location": "661/TALK",
            "narrator": "千羽鶴",
            "text": "そう、２個目来た。\nこれで１凸。",
            "zh": "是的，第2只来了。\n这样就1破了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "662/TALK",
            "narrator": "千羽鶴",
            "text": "にゃぼにゃすティーには\n１巻につき１体の\nにゃボットがついてくる。",
            "zh": "喵博尼亚斯蒂每1卷\n都会附赠1只\n喵Bot。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "663/TALK",
            "narrator": "千羽鶴",
            "text": "全5巻にわたるその全てを\nコンプリートすれば、\n４凸にゃボットになる！",
            "zh": "全5卷全部\n集齐的话，\n就能变成4破喵Bot！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "664/TALK",
            "narrator": "千羽鶴",
            "text": "だから今回も頑張って\nジャンケンコインを\n１０枚貯めてゲットして。",
            "zh": "所以这次也请加油\n攒够10枚猜拳币\n把它拿到手。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "665/ACT",
            "narrator": "",
            "text": "にゃボットってなに？",
            "zh": "喵Bot是什么？",
            "narrator_zh": ""
        },
        {
            "location": "666/TALK",
            "narrator": "千羽鶴",
            "text": "にゃボットは\n國政領火が制作した\nネコ型ロボット。",
            "zh": "喵Bot是\n国政领火制作的\n猫型机器人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "667/TALK",
            "narrator": "千羽鶴",
            "text": "特徴は、\n足が８本あること。",
            "zh": "特征是\n有8条腿。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "668/TALK",
            "narrator": "千羽鶴",
            "text": "本人曰く――",
            "zh": "据本人所说——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "669/TALK",
            "narrator": "千羽鶴",
            "text": "『最も画期的かつ実用的で\n可愛さもギュッと詰まった\n多目的クモ型にゃボット』",
            "zh": "『最具划时代意义且实用，\n又把可爱浓缩其中的\n多用途蜘蛛型喵Bot』",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "670/TALK",
            "narrator": "千羽鶴",
            "text": "……とのこと。",
            "zh": "……她是这么说的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "671/TALK",
            "narrator": "千羽鶴",
            "text": "制作に至る経緯は、\n実妹である國政綾水に\nプレゼントする為だとか。",
            "zh": "至于制作缘由，似乎是\n为了送给亲妹妹\n国政绫水当礼物。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "672/TALK",
            "narrator": "千羽鶴",
            "text": "國政綾水の\nココロスフィアを見ると、\nエピソードが見られる。",
            "zh": "看国政绫水的\n心灵领域，就能看到\n相关剧集。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "673/TALK",
            "narrator": "千羽鶴",
            "text": "というわけだから、\nにゃボット目指しコイン\n１０個獲得してみて！",
            "zh": "总而言之，\n以喵Bot为目标，试着\n赢取10个硬币吧！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "675/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\n早速ジャンケンを\nしたいと思う。",
            "zh": "那么，\n这就立刻开始\n猜拳吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "677/TALK",
            "narrator": "千羽鶴",
            "text": "対戦相手は、\nトライナリーの５人。",
            "zh": "对战对手是\n三重奏的5人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "678/TALK",
            "narrator": "千羽鶴",
            "text": "卯月神楽を除く４人は、\n勝てば１コインゲット、\n負ければ１コイン没収。",
            "zh": "除卯月神乐外的4人，\n赢了得1枚硬币，\n输了没收1枚硬币。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "679/TALK",
            "narrator": "千羽鶴",
            "text": "卯月神楽だけは、\n勝てば２コインゲット、\n負ければ２コイン没収。",
            "zh": "只有卯月神乐，\n赢了得2枚硬币，\n输了没收2枚硬币。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "680/TALK",
            "narrator": "千羽鶴",
            "text": "ポイントは、\nそれぞれの子によって\n微妙に癖があるという点。",
            "zh": "关键在于，\n每个女孩都有各自\n微妙的习惯。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "681/TALK",
            "narrator": "千羽鶴",
            "text": "それを見つけ出せたら、\n簡単に１０コイン\nゲットできるかも。",
            "zh": "要是能看穿这一点，\n说不定就能轻松赢到\n10枚硬币。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "682/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、是非\n彼女たちの癖を見つけて\n勝ち抜いて欲しい！",
            "zh": "所以，请务必\n找出她们的习惯，\n一路赢下去！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "683/TALK",
            "narrator": "千羽鶴",
            "text": "それでは！\nゲームスタート！",
            "zh": "那么！\n游戏开始！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "710/SEL",
            "narrator": "",
            "text": "つばめと戦う",
            "zh": "和燕对战",
            "narrator_zh": ""
        },
        {
            "location": "711/SEL",
            "narrator": "",
            "text": "アーヤと戦う",
            "zh": "和绫水对战",
            "narrator_zh": ""
        },
        {
            "location": "712/SEL",
            "narrator": "",
            "text": "ガブリエラと戦う",
            "zh": "和加布里埃拉对战",
            "narrator_zh": ""
        },
        {
            "location": "713/SEL",
            "narrator": "",
            "text": "みやびと戦う",
            "zh": "和雅对战",
            "narrator_zh": ""
        },
        {
            "location": "714/SEL",
            "narrator": "",
            "text": "神楽と戦う",
            "zh": "和神乐对战",
            "narrator_zh": ""
        },
        {
            "location": "715/SEL",
            "narrator": "",
            "text": "棄権する",
            "zh": "弃权",
            "narrator_zh": ""
        },
        {
            "location": "716/ACT",
            "narrator": "",
            "text": "つばめと戦う",
            "zh": "和燕对战",
            "narrator_zh": ""
        },
        {
            "location": "721/TALK",
            "narrator": "つばめ",
            "text": "ああっ……。\n負けちゃったね。",
            "zh": "啊啊……。\n输掉啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "724/TALK",
            "narrator": "つばめ",
            "text": "わぁい！\n勝ったぁ！！",
            "zh": "哇啊！\n赢了！！",
            "narrator_zh": "燕"
        },
        {
            "location": "729/ACT",
            "narrator": "",
            "text": "アーヤと戦う",
            "zh": "和绫水对战",
            "narrator_zh": ""
        },
        {
            "location": "734/TALK",
            "narrator": "アーヤ",
            "text": "あらら、\n負けちゃったわね。",
            "zh": "哎呀，\n输掉了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "737/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、\n私の勝ちね。",
            "zh": "呵呵，\n是我赢了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "742/ACT",
            "narrator": "",
            "text": "ガブリエラと戦う",
            "zh": "和加布里埃拉对战",
            "narrator_zh": ""
        },
        {
            "location": "747/TALK",
            "narrator": "ガブリエラ",
            "text": "ええっ！\n負けちゃったの！？",
            "zh": "哎哎！\n我竟然输了！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "750/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、こんなものよね！",
            "zh": "嘛，也就这样啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "755/ACT",
            "narrator": "",
            "text": "みやびと戦う",
            "zh": "和雅对战",
            "narrator_zh": ""
        },
        {
            "location": "760/TALK",
            "narrator": "みやび",
            "text": "ふむ、負けか。\n勝負事には\n弱いきね。",
            "zh": "唔，输了咩。\n猜拳这种胜负事\n我就是不擅长啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "763/TALK",
            "narrator": "みやび",
            "text": "うちに勝とうなぞ\n８８年早いわ。",
            "zh": "想赢过我\n还早了88年咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "768/ACT",
            "narrator": "",
            "text": "神楽と戦う",
            "zh": "和神乐对战",
            "narrator_zh": ""
        },
        {
            "location": "773/TALK",
            "narrator": "神楽",
            "text": "ふわぁっ！\n負けちゃいました…。",
            "zh": "呼哇！\n输掉了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "776/TALK",
            "narrator": "神楽",
            "text": "ぴょんこの\n勝ちでーすっ♪",
            "zh": "是蹦子\n赢啦——♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "781/ACT",
            "narrator": "",
            "text": "棄権する",
            "zh": "弃权",
            "narrator_zh": ""
        },
        {
            "location": "804/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\n残念ながら貴方は\n負けてしまった！",
            "zh": "于是，\n很遗憾，你\n输掉了！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "805/TALK",
            "narrator": "千羽鶴",
            "text": "すなわち、\nゲームオーバー！",
            "zh": "也就是说，\nGAME OVER！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "806/TALK",
            "narrator": "千羽鶴",
            "text": "でも安心して。\nこのジャンケンは\n何度でも挑戦できる。",
            "zh": "不过放心。\n这个猜拳可以\n无限次挑战。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "807/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\nまたの挑戦を\nお待ちしてるから。",
            "zh": "所以，\n期待你下次的\n挑战。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "808/TALK",
            "narrator": "千羽鶴",
            "text": "ばいばい。",
            "zh": "拜拜。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "832/TALK",
            "narrator": "千羽鶴",
            "text": "おめでとう！\n$handle$。",
            "zh": "恭喜！\n$handle$。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "833/TALK",
            "narrator": "千羽鶴",
            "text": "貴方は見事、トライナリー\nジャンケンで、コイン\n１０枚を勝ち取った！",
            "zh": "你出色地在三重奏\n猜拳中，赢得了\n10枚硬币！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "834/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\n約束通りにゃボットを\n進呈するけど――",
            "zh": "那么，\n按约定把喵Bot\n送给你，不过——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "835/TALK",
            "narrator": "千羽鶴",
            "text": "その前にCM。",
            "zh": "在那之前先插播CM。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "837/SEL",
            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/36MB 2:22】</color>",
            "zh": "观看影像\n<color=green>【高画质/36MB 2:22】</color>",
            "narrator_zh": ""
        },
        {
            "location": "838/SEL",
            "narrator": "",
            "text": "映像を見る\n<color=green>【標準画質/13MB 2:22】</color>",
            "zh": "观看影像\n<color=green>【标准画质/13MB 2:22】</color>",
            "narrator_zh": ""
        },
        {
            "location": "839/SEL",
            "narrator": "",
            "text": "映像をスキップする",
            "zh": "跳过影像",
            "narrator_zh": ""
        },
        {
            "location": "840/ACT",
            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/36MB 2:22】</color>",
            "zh": "观看影像\n<color=green>【高画质/36MB 2:22】</color>",
            "narrator_zh": ""
        },
        {
            "location": "841/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "我知道了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "847/ACT",
            "narrator": "",
            "text": "映像を見る\n<color=green>【標準画質/13MB 2:22】</color>",
            "zh": "观看影像\n<color=green>【标准画质/13MB 2:22】</color>",
            "narrator_zh": ""
        },
        {
            "location": "848/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "我知道了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "854/ACT",
            "narrator": "",
            "text": "映像をスキップする",
            "zh": "跳过影像",
            "narrator_zh": ""
        },
        {
            "location": "855/TALK",
            "narrator": "千羽鶴",
            "text": "そう……。",
            "zh": "是的……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "868/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで！",
            "zh": "于是！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "871/TALK",
            "narrator": "千羽鶴",
            "text": "賞品授与式を\n執り行います！",
            "zh": "现在举行\n奖品颁奖仪式！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "873/TALK",
            "narrator": "千羽鶴",
            "text": "尚、賞品の授与は前回と\n同じく、國政領火博士\nからとなります。",
            "zh": "另外，奖品颁发和上次\n一样，由国政领火博士\n负责。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "875/TALK",
            "narrator": "千羽鶴",
            "text": "尚、賞品の授与は、\n世界的に著名な\n量子研究家であり――",
            "zh": "那么，颁奖仪式就交由\n世界闻名的\n量子研究家——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "876/TALK",
            "narrator": "千羽鶴",
            "text": "にゃボットの生みの親でも\nある、國政領火博士に\nお願いしたいと思います。",
            "zh": "同时也是喵Bot生母的\n国政领火博士\n来主持。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "893/TALK",
            "narrator": "エリカ",
            "text": "コーンコン。\nみなさんこんにちは、\n國政領火です！",
            "zh": "空——空。\n大家好，\n我是国政领火！",
            "narrator_zh": "领火"
        },
        {
            "location": "899/TALK",
            "narrator": "エリカ",
            "text": "連載クラン\nにゃぼにゃすティー！\nゲットおめでとう！",
            "zh": "恭喜你拿到\n连载库兰\n喵博尼亚斯蒂！",
            "narrator_zh": "领火"
        },
        {
            "location": "900/TALK",
            "narrator": "エリカ",
            "text": "これからもジャンジャン\nプレゼントしていく\n予定だから――",
            "zh": "今后也预定会\n接二连三地送出\n奖品——",
            "narrator_zh": "领火"
        },
        {
            "location": "901/TALK",
            "narrator": "エリカ",
            "text": "頑張って集めてね！",
            "zh": "要加油收集哦！",
            "narrator_zh": "领火"
        },
        {
            "location": "906/TALK",
            "narrator": "エリカ",
            "text": "というわけで、前回も\nゲットしていたから\nわかると思うけど――",
            "zh": "于是，因为上次你也\n拿到过了，应该知道\n怎么回事——",
            "narrator_zh": "领火"
        },
        {
            "location": "907/TALK",
            "narrator": "エリカ",
            "text": "只今より\n“本誌”部分を\n始めまーす！",
            "zh": "现在起\n“本刊”部分\n开始啦——！",
            "narrator_zh": "领火"
        },
        {
            "location": "909/TALK",
            "narrator": "エリカ",
            "text": "というわけで、\nこのコーナーが\n何なのかというと――",
            "zh": "话说回来，\n这个栏目究竟是\n干什么的呢——",
            "narrator_zh": "领火"
        },
        {
            "location": "910/TALK",
            "narrator": "エリカ",
            "text": "実は、連載クラン\nにゃぼにゃすティー！の\n本誌に当たる部分なの。",
            "zh": "其实呀，这里就是\n连载库兰 喵博尼亚斯蒂！\n的“本刊”部分哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "911/SEL",
            "narrator": "",
            "text": "というと？",
            "zh": "也就是说？",
            "narrator_zh": ""
        },
        {
            "location": "912/ACT",
            "narrator": "",
            "text": "というと？",
            "zh": "也就是说？",
            "narrator_zh": ""
        },
        {
            "location": "914/TALK",
            "narrator": "エリカ",
            "text": "要するに！",
            "zh": "简而言之！",
            "narrator_zh": "领火"
        },
        {
            "location": "915/TALK",
            "narrator": "エリカ",
            "text": "にゃぼにゃすティー！\nバンドルのクラン、\nにゃボットについて――",
            "zh": "就是对喵博尼亚斯蒂！\n捆绑的库兰\n喵Bot进行——",
            "narrator_zh": "领火"
        },
        {
            "location": "916/TALK",
            "narrator": "エリカ",
            "text": "解説しちゃう\nコーナーなんです！",
            "zh": "大解说的\n栏目啦！",
            "narrator_zh": "领火"
        },
        {
            "location": "918/SEL",
            "narrator": "",
            "text": "わーい！",
            "zh": "好耶——！",
            "narrator_zh": ""
        },
        {
            "location": "919/SEL",
            "narrator": "",
            "text": "結構です",
            "zh": "不用了",
            "narrator_zh": ""
        },
        {
            "location": "920/ACT",
            "narrator": "",
            "text": "わーい！",
            "zh": "好耶——！",
            "narrator_zh": ""
        },
        {
            "location": "921/TALK",
            "narrator": "エリカ",
            "text": "うんうん。\nわかるよ、その気持ち！",
            "zh": "嗯嗯。\n我懂哦，那种心情！",
            "narrator_zh": "领火"
        },
        {
            "location": "922/TALK",
            "narrator": "エリカ",
            "text": "やっぱりこれ系には\n解説冊子がなくちゃ\n片手落ちだもんね！",
            "zh": "果然这种东西要是\n没有解说手册的话，\n就不算完整了嘛！",
            "narrator_zh": "领火"
        },
        {
            "location": "923/TALK",
            "narrator": "エリカ",
            "text": "それじゃ早速、\n聞きたいコンテンツを\n選択してね！",
            "zh": "那么快点\n选择你想听的\n内容吧！",
            "narrator_zh": "领火"
        },
        {
            "location": "925/SEL",
            "narrator": "",
            "text": "こだわりポイント",
            "zh": "讲究的亮点",
            "narrator_zh": ""
        },
        {
            "location": "926/SEL",
            "narrator": "",
            "text": "開発秘話",
            "zh": "开发秘闻",
            "narrator_zh": ""
        },
        {
            "location": "927/SEL",
            "narrator": "",
            "text": "もういいです…",
            "zh": "已经够了……",
            "narrator_zh": ""
        },
        {
            "location": "928/ACT",
            "narrator": "",
            "text": "こだわりポイント",
            "zh": "讲究的亮点",
            "narrator_zh": ""
        },
        {
            "location": "929/TALK",
            "narrator": "エリカ",
            "text": "ズバリ！\n足の数です！",
            "zh": "直截了当！\n就是腿的数量！",
            "narrator_zh": "领火"
        },
        {
            "location": "930/TALK",
            "narrator": "エリカ",
            "text": "にゃボットは８本足、\nすなわち多脚であることに\n意義があります！",
            "zh": "喵Bot拥有8条腿，\n也就是“多足”，这一点\n才是最有意义的！",
            "narrator_zh": "领火"
        },
        {
            "location": "931/TALK",
            "narrator": "エリカ",
            "text": "それはどういうことかと\n申しますと！",
            "zh": "至于为什么\n这么说呢！",
            "narrator_zh": "领火"
        },
        {
            "location": "932/TALK",
            "narrator": "エリカ",
            "text": "多脚ほど安定性と経済性、\n実用性を兼ね備えた\n移動方式はありません！",
            "zh": "没有任何移动方式能像\n多足一样兼具稳定性、\n经济性与实用性！",
            "narrator_zh": "领火"
        },
        {
            "location": "933/TALK",
            "narrator": "エリカ",
            "text": "例えば車輪の場合、\n速度は出ますが、少しの\n凹凸する問題になります。",
            "zh": "比方说车轮，\n虽然速度快，但哪怕一点\n凹凸不平都会成问题。",
            "narrator_zh": "领火"
        },
        {
            "location": "934/TALK",
            "narrator": "エリカ",
            "text": "二足歩行は安定性に乏しく\n少しの衝撃で倒れて\nしまいます。",
            "zh": "二足步行稳定性不足，\n稍微受点冲击就会\n摔倒。",
            "narrator_zh": "领火"
        },
        {
            "location": "935/TALK",
            "narrator": "エリカ",
            "text": "それに比べ、多脚は\n倒れることも殆ど無く、\n二足以上の速度が出せる。",
            "zh": "相比之下，多足几乎\n不会摔倒，还能跑出\n超越二足的速度。",
            "narrator_zh": "领火"
        },
        {
            "location": "936/TALK",
            "narrator": "エリカ",
            "text": "尚、車輪でさえ転倒する\n可能性はありますが――",
            "zh": "而且就连车轮也存在\n翻倒的可能性——",
            "narrator_zh": "领火"
        },
        {
            "location": "937/TALK",
            "narrator": "エリカ",
            "text": "万一転倒した場合、\n多脚と違い、車輪は\n起き上がることが不可能。",
            "zh": "万一翻倒了，\n与多足不同，车轮是\n不可能自己站起来的。",
            "narrator_zh": "领火"
        },
        {
            "location": "938/TALK",
            "narrator": "エリカ",
            "text": "多脚はその足の自由度を\n生かし、また8本という\n可能性の多さから――",
            "zh": "多足能发挥腿部的自由度，\n再加上8条腿所带来的\n丰富可能性——",
            "narrator_zh": "领火"
        },
        {
            "location": "939/TALK",
            "narrator": "エリカ",
            "text": "プログラムにコツは\n必要ですが、確実に自分で\n起き上がる事が可能です！",
            "zh": "虽然程序上需要点诀窍，\n但绝对能够自己\n站起来！",
            "narrator_zh": "领火"
        },
        {
            "location": "940/TALK",
            "narrator": "エリカ",
            "text": "このように、多脚は\n全ての移動手法に勝る\n素晴らしい手法で！",
            "zh": "像这样，多足是\n胜过一切移动方式的\n绝佳方式！",
            "narrator_zh": "领火"
        },
        {
            "location": "941/TALK",
            "narrator": "エリカ",
            "text": "それを考えると、生命の\n大半が４足以上の多脚で\nあることにも納得です！",
            "zh": "这么一想，绝大多数生命\n都是4足以上的多足，\n也就理所当然啦！",
            "narrator_zh": "领火"
        },
        {
            "location": "942/TALK",
            "narrator": "エリカ",
            "text": "尚、多脚と勝負できる\n可能性があるものとしては\nキャタピラがありますが。",
            "zh": "顺便一提，能与多足\n一较高下的可能性之选，\n还有履带。",
            "narrator_zh": "领火"
        },
        {
            "location": "943/TALK",
            "narrator": "エリカ",
            "text": "確かにフレキシブルさでは\n車輪よりも上を行き、\n凸凹も得意ではあります。",
            "zh": "诚然在灵活性上\n胜过车轮，\n也擅长应付凹凸地形。",
            "narrator_zh": "领火"
        },
        {
            "location": "944/TALK",
            "narrator": "エリカ",
            "text": "しかし、やはりあれは\n車輪の仲間であり！",
            "zh": "但归根结底，那还是\n车轮的同类！",
            "narrator_zh": "领火"
        },
        {
            "location": "945/TALK",
            "narrator": "エリカ",
            "text": "転倒時などの\nフレキシブルな対応は\n期待できません。",
            "zh": "翻倒等情况下的\n灵活应对，是没法\n指望它的。",
            "narrator_zh": "领火"
        },
        {
            "location": "946/TALK",
            "narrator": "エリカ",
            "text": "よって、多脚こそが\n大自然から授かった\n最高の足であると！",
            "zh": "因此，多足才是\n大自然赐予我们的\n最棒的腿脚！",
            "narrator_zh": "领火"
        },
        {
            "location": "947/TALK",
            "narrator": "エリカ",
            "text": "わたしは信じて\n止まないのです！",
            "zh": "对此我深信不疑，\n绝不动摇！",
            "narrator_zh": "领火"
        },
        {
            "location": "948/TALK",
            "narrator": "エリカ",
            "text": "尚、多脚の唯一とも言える\n短所として、スピードを\n出せない事がありますが―",
            "zh": "另外，多足唯一称得上\n短板的就是提不起速度，\n但——",
            "narrator_zh": "领火"
        },
        {
            "location": "949/TALK",
            "narrator": "エリカ",
            "text": "特殊な足の動きを\nすることで！",
            "zh": "通过采用特殊的\n腿部动作！",
            "narrator_zh": "领火"
        },
        {
            "location": "950/TALK",
            "narrator": "エリカ",
            "text": "にゃボットは、時速\n３０キロまで出す事が\nできるようになりました！",
            "zh": "喵Bot已经能够\n跑到时速30公里\n了哦！",
            "narrator_zh": "领火"
        },
        {
            "location": "951/TALK",
            "narrator": "エリカ",
            "text": "以上がわたしの、\nにゃボットへのこだわり\nポイントになります！",
            "zh": "以上就是我对\n喵Bot讲究的亮点\n啦！",
            "narrator_zh": "领火"
        },
        {
            "location": "954/ACT",
            "narrator": "",
            "text": "開発秘話",
            "zh": "开发秘闻",
            "narrator_zh": ""
        },
        {
            "location": "955/TALK",
            "narrator": "エリカ",
            "text": "にゃボットには\n量子AIが内蔵されて\nいるのですが――",
            "zh": "喵Bot里面\n内置了量子AI\n——",
            "narrator_zh": "领火"
        },
        {
            "location": "956/TALK",
            "narrator": "エリカ",
            "text": "これがこの前、\nビックリするような事件を\n起こしました！",
            "zh": "前几天，\n它闹出了一件吓死人的\n大事件！",
            "narrator_zh": "领火"
        },
        {
            "location": "957/TALK",
            "narrator": "エリカ",
            "text": "にゃボットの量子AIには、\n綾ちゃんに懐くように\n特別な学習があって。",
            "zh": "我在喵Bot的量子AI里\n设置了特别的学习程序，\n让它亲近小绫。",
            "narrator_zh": "领火"
        },
        {
            "location": "958/TALK",
            "narrator": "エリカ",
            "text": "綾ちゃんに危害をもたらす\nような言葉やアクションを\n見かけたら即反応！",
            "zh": "只要看到会对小绫\n造成危害的言论或举动，\n就会立刻做出反应！",
            "narrator_zh": "领火"
        },
        {
            "location": "959/TALK",
            "narrator": "エリカ",
            "text": "という風に\n設計してあるのですが。",
            "zh": "我原本是这么\n设计的啦。",
            "narrator_zh": "领火"
        },
        {
            "location": "960/TALK",
            "narrator": "エリカ",
            "text": "先日工房で、訓練用に\n綾ちゃんの写真をプリント\nしたものを捨てたら――",
            "zh": "前几天在工房里，我把\n训练用打印出来的小绫\n照片扔掉的时候——",
            "narrator_zh": "领火"
        },
        {
            "location": "961/TALK",
            "narrator": "エリカ",
            "text": "わたしが\n消されかけました！",
            "zh": "我差点\n被它消灭了！",
            "narrator_zh": "领火"
        },
        {
            "location": "962/TALK",
            "narrator": "エリカ",
            "text": "その時は尻尾レーザーの\n出力テストをしていたん\nですけど。",
            "zh": "那时候刚好在做\n尾巴激光的\n输出测试嘛。",
            "narrator_zh": "领火"
        },
        {
            "location": "963/TALK",
            "narrator": "エリカ",
            "text": "うっかりそれを忘れて、\n学習訓練後に電源を切る\nのも忘れていて。",
            "zh": "一不小心忘了那茬，\n训练结束后也忘了\n关电源。",
            "narrator_zh": "领火"
        },
        {
            "location": "964/TALK",
            "narrator": "エリカ",
            "text": "そのままプリントを\nビリビリしてたら、\n後ろからチュンって！",
            "zh": "就那样把打印照片\n哗啦哗啦撕掉的时候，\n背后突然“啾”地一声！",
            "narrator_zh": "领火"
        },
        {
            "location": "965/TALK",
            "narrator": "エリカ",
            "text": "ロボット三原則は\nちゃんと学習して\nいるのですが――",
            "zh": "虽然机器人三定律\n它也好好学习过了\n——",
            "narrator_zh": "领火"
        },
        {
            "location": "966/TALK",
            "narrator": "エリカ",
            "text": "それ故に、\n綾ちゃんを護るのと、\nロボット三原則を守る…。",
            "zh": "正因如此，\n守护小绫，\n和遵守机器人三定律……。",
            "narrator_zh": "领火"
        },
        {
            "location": "967/TALK",
            "narrator": "エリカ",
            "text": "この二律背反に、\nにゃボットは悩み、そして\n軽く撃ったのでしょう。",
            "zh": "在这个二律背反之间，\n喵Bot纠结了一番，然后\n轻轻地射了一记吧。",
            "narrator_zh": "领火"
        },
        {
            "location": "968/TALK",
            "narrator": "エリカ",
            "text": "出力は暖まる程度で。\nだから、消されかけた、\nというのは大げさですが！",
            "zh": "输出功率也就暖暖身的程度。\n所以说差点被消灭\n确实有点夸张啦！",
            "narrator_zh": "领火"
        },
        {
            "location": "969/TALK",
            "narrator": "エリカ",
            "text": "にゃボットがわたしに、\n警告していたのは\n間違い無いです！",
            "zh": "但喵Bot是在向我\n发出警告，这一点\n绝对没错！",
            "narrator_zh": "领火"
        },
        {
            "location": "970/TALK",
            "narrator": "エリカ",
            "text": "ロボットにも愛という\n感情を与える事ができると\n確信した出来事でした！",
            "zh": "这让我确信，哪怕是\n机器人，也是能够被赋予\n“爱”这种感情的！",
            "narrator_zh": "领火"
        },
        {
            "location": "973/ACT",
            "narrator": "",
            "text": "もういいです…",
            "zh": "已经够了……",
            "narrator_zh": ""
        },
        {
            "location": "974/TALK",
            "narrator": "エリカ",
            "text": "うん。\nわかったよ。",
            "zh": "嗯。\n我知道啦。",
            "narrator_zh": "领火"
        },
        {
            "location": "976/TALK",
            "narrator": "エリカ",
            "text": "他にも聞きたいことが\nあれば、いつでも\n質問してね。",
            "zh": "还有其他想听的，\n随时都可以\n问我哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "977/ACT",
            "narrator": "",
            "text": "結構です",
            "zh": "不用了",
            "narrator_zh": ""
        },
        {
            "location": "978/TALK",
            "narrator": "エリカ",
            "text": "あらら…。",
            "zh": "哎呀呀……。",
            "narrator_zh": "领火"
        },
        {
            "location": "979/TALK",
            "narrator": "エリカ",
            "text": "聞きたいことが\nあれば、いつでも\n質問してね。",
            "zh": "有想听的内容，\n随时都可以\n问我哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "981/TALK",
            "narrator": "エリカ",
            "text": "話せることは\nお話するから。",
            "zh": "能说的事情\n我都会告诉你的。",
            "narrator_zh": "领火"
        },
        {
            "location": "982/TALK",
            "narrator": "エリカ",
            "text": "それじゃ、改めまして。\n今回はにゃボットの\nゲットおめでとう！",
            "zh": "那，重新祝贺你。\n恭喜这次拿到了\n喵Bot！",
            "narrator_zh": "领火"
        },
        {
            "location": "983/TALK",
            "narrator": "エリカ",
            "text": "色んな場面で活用して、\n可愛がってあげてね！",
            "zh": "在各种场合用上它，\n好好疼爱它哦！",
            "narrator_zh": "领火"
        },
        {
            "location": "984/TALK",
            "narrator": "エリカ",
            "text": "それじゃ、またね！",
            "zh": "那，下次见咯！",
            "narrator_zh": "领火"
        },
        {
            "location": "986/SEL",
            "narrator": "",
            "text": "はーい",
            "zh": "好——",
            "narrator_zh": ""
        },
        {
            "location": "987/SEL",
            "narrator": "",
            "text": "ちょっと待って、リプレイスについて聞きたいことが",
            "zh": "等一下，关于替换我有件事想问",
            "narrator_zh": ""
        },
        {
            "location": "988/ACT",
            "narrator": "",
            "text": "はーい",
            "zh": "好——",
            "narrator_zh": ""
        },
        {
            "location": "989/ACT",
            "narrator": "",
            "text": "ちょっと待って、リプレイスについて聞きたいことが",
            "zh": "等一下，关于替换我有件事想问",
            "narrator_zh": ""
        },
        {
            "location": "990/TALK",
            "narrator": "エリカ",
            "text": "え？\nどうしたの？",
            "zh": "哎？\n怎么了？",
            "narrator_zh": "领火"
        },
        {
            "location": "991/SEL",
            "narrator": "",
            "text": "前回のエピソードに千羽鶴も出てこなかったし、それっぽい選択肢も無かった",
            "zh": "上一回剧集里千羽鹤也没出场，也没有那种感觉的选项啊",
            "narrator_zh": ""
        },
        {
            "location": "992/ACT",
            "narrator": "",
            "text": "前回のエピソードに千羽鶴も出てこなかったし、それっぽい選択肢も無かった",
            "zh": "上一回剧集里千羽鹤也没出场，也没有那种感觉的选项啊",
            "narrator_zh": ""
        },
        {
            "location": "994/TALK",
            "narrator": "エリカ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "领火"
        },
        {
            "location": "995/TALK",
            "narrator": "エリカ",
            "text": "えっ？\nそうなの？",
            "zh": "哎？\n是这样吗？",
            "narrator_zh": "领火"
        },
        {
            "location": "996/TALK",
            "narrator": "エリカ",
            "text": "そんな筈は\nないんだけど……",
            "zh": "不应该啊\n……",
            "narrator_zh": "领火"
        },
        {
            "location": "997/TALK",
            "narrator": "エリカ",
            "text": "ちょっとチューニングが\nズレてるかもしれないから\n見ておくね。",
            "zh": "可能是调谐稍微\n有点偏移了，\n我去看看哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "998/TALK",
            "narrator": "エリカ",
            "text": "教えてくれて\nありがとう。",
            "zh": "谢谢你\n告诉我呀。",
            "narrator_zh": "领火"
        },
        {
            "location": "1009/TALK",
            "narrator": "千羽鶴",
            "text": "……おかえり。",
            "zh": "……欢迎回来。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1010/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\n今回のジャンケン大会は\nこれでお終い。",
            "zh": "于是，\n这次的猜拳大会就\n到此为止。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1011/TALK",
            "narrator": "千羽鶴",
            "text": "次回はまた\n次のMV回になる。",
            "zh": "下次会在\n下一个MV回再见。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1012/TALK",
            "narrator": "千羽鶴",
            "text": "お楽しみに。",
            "zh": "敬请期待。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "704/DIALOG",
            "narrator": "Dialog_chiharupoint",
            "text": "あなたは現在、\n<size=40><color=red>$jancoin$ジャンコイン</color></size>\n所有しています。",
            "zh": "你现在\n拥有<size=40><color=red>$jancoin$枚猜拳币</color></size>\n。",
            "narrator_zh": "Dialog_chiharupoint"
        },
        {
            "location": "782/DIALOG",
            "narrator": "YES_NO",
            "text": "試合を棄権しますか？\n\n「Yes」を押すと、\nこのゲームから抜けます。\n\n「No」を押すと、\nジャンケンに戻ります。\n",
            "zh": "要弃权退出比赛吗？\n\n按下「Yes」，\n将退出此游戏。\n\n按下「No」，\n将返回猜拳。\n",
            "narrator_zh": "YES_NO"
        }
    ]
}
