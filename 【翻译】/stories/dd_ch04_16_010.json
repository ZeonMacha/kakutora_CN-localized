{
    "dir": "chap16/daydra/dd_ch04_16_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "16452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "新しい美容院",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "新的美容院"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "新しい美容院",
            "zh": "新的美容院",
            "narrator_zh": ""
        },
        {
            "location": "28/TALK",
            "narrator": "雛",
            "text": "あっ、しまった！\n美容院の予約入れるの\n忘れてた！",
            "zh": "啊，糟了！\n我忘了预约\n美容院了！",
            "narrator_zh": "雏"
        },
        {
            "location": "31/TALK",
            "narrator": "キリト",
            "text": "ふ～ん、美容院って\n予約するもんなのか。",
            "zh": "哦～，原来美容院\n还得预约啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "34/TALK",
            "narrator": "雛",
            "text": "基本的にはそうだよ。",
            "zh": "一般是这样哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "35/TALK",
            "narrator": "雛",
            "text": "特に今回は、新しくできる\nところに行こうと思ってる\nから――",
            "zh": "尤其这次，我想去一家\n新开的店，\n所以——",
            "narrator_zh": "雏"
        },
        {
            "location": "36/TALK",
            "narrator": "雛",
            "text": "飛び込みで行っても、\n受け付けてもらえないと\n思うし。",
            "zh": "就算直接上门，\n估计人家也不会\n接待的。",
            "narrator_zh": "雏"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "新しい美容院ができるの？",
            "zh": "有新开的美容院吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "42/TALK",
            "narrator": "雛",
            "text": "うん、来週からだけど、\n予約はもう始まってるよ。",
            "zh": "嗯，虽然下周才开业，\n不过预约已经开始了哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "それなら、わたしも\n予約しようかな？",
            "zh": "那样的话，我要不要\n也预约一下呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "46/TALK",
            "narrator": "つばめ",
            "text": "東京に来てから、\nまだ一度も美容院\n行ってないの。",
            "zh": "来东京以后，\n我还一次都没去过\n美容院呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "言われてみれば、\nつばめちゃんの髪、\nちっくと傷んじょるね。",
            "zh": "被你这么一说，\n燕的头发\n确实有点伤咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "…っちゅうか、うちも\n人のこと言えんけんど。",
            "zh": "……说起来，我自己\n也没资格说人，但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "雛",
            "text": "あ～…じっくり見ると\nちょっと傷んでますねー。",
            "zh": "啊～……仔细一看，\n确实有点伤呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "うちも、最近はまったく\n行けんかったきね。",
            "zh": "我最近也是，\n完全没能去成啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "雛",
            "text": "一緒に予約しますか？",
            "zh": "要一起预约吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "うちは行きつけの\n美容院でえいよ。",
            "zh": "我去常去的那家\n就得咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "62/TALK",
            "narrator": "キリト",
            "text": "てか、みやび先輩も\n美容院行くんですか！？",
            "zh": "话说，雅前辈也会\n去美容院！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "…キリト君、\nうちも一応生物学的には\n女ぞね？",
            "zh": "……圣翔，\n好歹从生物学上讲\n我也是女的咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "67/TALK",
            "narrator": "キリト",
            "text": "いや、オカッパ頭だから、\n床屋でスパッとやって\nもらうのかな、と…。",
            "zh": "不是，你那锅盖头，\n我还以为你会去理发店\n咔嚓一下……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "69/TALK",
            "narrator": "雛",
            "text": "お、オカッパって…\nボブって言いなよ。",
            "zh": "什、什么锅盖头……\n要叫波波头啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "72/TALK",
            "narrator": "キリト",
            "text": "誰だそれ？",
            "zh": "波波是谁？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "76/TALK",
            "narrator": "つばめ",
            "text": "ボブヘアーのことだよ。",
            "zh": "是说波波头啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "まあ、男の子にとっては\nわからんかもしれん\nけんど――",
            "zh": "嘛，对男孩子来说\n可能没懂，\n但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "この髪、結構手が\n掛かっちょるがよ？",
            "zh": "这头发，打理起来\n可是很费工夫的咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "83/TALK",
            "narrator": "キリト",
            "text": "…女の髪って、難しいな。",
            "zh": "……女人的头发，真难搞啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "勉強しといた方がえいよ。",
            "zh": "最好还是先学一学得咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "…けんど、よくよく\n見るとまっこと\n傷んじゅうね。",
            "zh": "……但是，仔细\n一看，还真是\n伤着了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "88/SEL",
            "narrator": "",
            "text": "綺麗に見えるのに",
            "zh": "明明看起来很漂亮啊",
            "narrator_zh": ""
        },
        {
            "location": "89/SEL",
            "narrator": "",
            "text": "自分ではケアしないの？",
            "zh": "自己不做护理吗？",
            "narrator_zh": ""
        },
        {
            "location": "93/TALK",
            "narrator": "キリト",
            "text": "別に傷んでなんか\nいねぇけどなぁ…。",
            "zh": "可我看根本没伤\n到哪去啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "95/TALK",
            "narrator": "雛",
            "text": "キリト、女の子の髪って\nじっくり見たことある？",
            "zh": "圣翔，你仔细看过\n女生的头发吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "98/TALK",
            "narrator": "キリト",
            "text": "いや、ねぇけど…。",
            "zh": "没，没看过……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "99/TALK",
            "narrator": "雛",
            "text": "だよねー。\nまあ、あるって言ったら\nちょっと気持ち悪いけど。",
            "zh": "我就说嘛。\n不过你要是说看过，\n那还真有点恶心。",
            "narrator_zh": "雏"
        },
        {
            "location": "104/TALK",
            "narrator": "つばめ",
            "text": "毎日ケアしても、\nどうしても傷んじゃうん\nだよね…。",
            "zh": "就算每天护理，\n头发还是免不了\n会伤的呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "そうやね。",
            "zh": "是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "109/TALK",
            "narrator": "みやび",
            "text": "シャンプー、リンス、\nコンディショナー、\nトリートメント――",
            "zh": "洗发水、润丝精、\n护发素、\n发膜——",
            "narrator_zh": "雅"
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "色々使ってケアしても、\n結局傷んで美容院に\n行くことになるちや。",
            "zh": "用各种东西护理，\n到最后还是会伤、\n还是得跑美容院滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "112/TALK",
            "narrator": "雛",
            "text": "わかりますわかります。\nどんなに気を付けても、\n枝毛とか見つかるし…。",
            "zh": "懂的我懂的。\n不管多小心，\n还是会发现分叉……。",
            "narrator_zh": "雏"
        },
        {
            "location": "115/TALK",
            "narrator": "つばめ",
            "text": "うっ…昨日一本見つけて\n切るの忘れてた…。",
            "zh": "呜……昨天发现一根，\n结果忘了剪……。",
            "narrator_zh": "燕"
        },
        {
            "location": "117/TALK",
            "narrator": "みやび",
            "text": "うちはもう、切るのすら\n諦めちゅうよ。",
            "zh": "我已经是连剪\n都放弃咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "119/TALK",
            "narrator": "キリト",
            "text": "…三人とも、マジで\nそんなに傷んでるのか？",
            "zh": "……你们三个，真的\n伤得那么厉害吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "120/TALK",
            "narrator": "雛",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "雏"
        },
        {
            "location": "121/TALK",
            "narrator": "つばめ",
            "text": "悲しいくらいにね…。",
            "zh": "伤到让人难过呢……。",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "早く美容院行きたいちや。",
            "zh": "好想快点去美容院滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "124/TALK",
            "narrator": "キリト",
            "text": "…俺には普通にしか\n見えねぇんだけどなぁ。",
            "zh": "……可我看就是\n普通头发啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "126/ACT",
            "narrator": "",
            "text": "綺麗に見えるのに",
            "zh": "明明看起来很漂亮啊",
            "narrator_zh": ""
        },
        {
            "location": "150/TALK",
            "narrator": "みやび",
            "text": "そう見えるんやったら嬉しいけんど",
            "zh": "能那么看我是挺高兴，但是",
            "narrator_zh": "雅"
        },
        {
            "location": "151/TALK",
            "narrator": "みやび",
            "text": "なら、あんまし髪の毛凝視せんでな",
            "zh": "那就别老盯着我的头发看啦",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "みやび",
            "text": "一応、うちも女の端くれやき",
            "zh": "好歹我也算是个女孩子嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "傷んだ髪見られるんは恥ずかしいちや",
            "zh": "伤掉的头发被人看到很难为情滴",
            "narrator_zh": "雅"
        },
        {
            "location": "168/TALK",
            "narrator": "つばめ",
            "text": "みやびさん、\n顔が赤いですけど\n大丈夫ですか？",
            "zh": "雅，\n你脸好红，\n没事吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "170/TALK",
            "narrator": "みやび",
            "text": "ん？　何でもないき、\n心配せんでえい。",
            "zh": "嗯？没什么啵，\n不用担心就行。",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "みやび",
            "text": "…相棒のアホ！",
            "zh": "……笨蛋搭档！",
            "narrator_zh": "雅"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "余計なこと言うき、\n顔に出たやんか。",
            "zh": "谁叫你多嘴啵，\n害我全写在脸上了。",
            "narrator_zh": "雅"
        },
        {
            "location": "179/TALK",
            "narrator": "みやび",
            "text": "…うち、帰りにそのまま\n美容院行ってくるぞね。",
            "zh": "……我回去的时候\n就顺路去美容院咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "181/TALK",
            "narrator": "つばめ",
            "text": "わかりました…。",
            "zh": "我知道了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "184/TALK",
            "narrator": "つばめ",
            "text": "…どうしたんだろう？\nなんか、恥ずかしがってる\n感じに見えるけど…？",
            "zh": "……她这是怎么了？\n总感觉像是在害羞\n的样子……？",
            "narrator_zh": "燕"
        },
        {
            "location": "186/TALK",
            "narrator": "雛",
            "text": "わからないよー。\nだってそんな話、\nちっともしてなかったし。",
            "zh": "我也不知道呀。\n毕竟那种话题，\n我们完全没聊过嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "190/TALK",
            "narrator": "キリト",
            "text": "…でも、\nちょっと可愛いよな？",
            "zh": "……不过，\n还挺可爱的吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "192/TALK",
            "narrator": "つばめ",
            "text": "うん…こんなみやびさん、\n初めて見たよ。",
            "zh": "嗯……这样的雅，\n我还是第一次见哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "194/TALK",
            "narrator": "雛",
            "text": "…まゆちんが見たら、\nどんな反応したかなぁ？",
            "zh": "……要是小茧看到了，\n会有什么反应呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "195/ACT",
            "narrator": "",
            "text": "自分でケアしないの？",
            "zh": "自己不做护理吗？",
            "narrator_zh": ""
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "しちょるわ",
            "zh": "在做着咯",
            "narrator_zh": "雅"
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "っちゅうか、毎日結構頑張ってるちや",
            "zh": "说起来，我每天可是挺卖力护理滴",
            "narrator_zh": "雅"
        },
        {
            "location": "217/TALK",
            "narrator": "みやび",
            "text": "けんど、毛先とかはどうしても傷むがよ",
            "zh": "但是发梢什么的，怎么护都免不了伤咯",
            "narrator_zh": "雅"
        },
        {
            "location": "229/TALK",
            "narrator": "みやび",
            "text": "…まっこと不思議やね。",
            "zh": "……真蛮不可思议的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "230/TALK",
            "narrator": "みやび",
            "text": "必死にケアしちゅうに、\nすぐ傷むんやき…。",
            "zh": "拼命护理着，\n偏偏一下子就伤啵……。",
            "narrator_zh": "雅"
        },
        {
            "location": "233/TALK",
            "narrator": "キリト",
            "text": "…てか、マジでそんな\n髪って傷むのか？",
            "zh": "……话说，头发真的\n会伤成那样吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "234/TALK",
            "narrator": "雛",
            "text": "傷むよー。\nだからケア用品とか\n沢山使うんじゃん。",
            "zh": "会伤的呀。\n所以才要用一大堆\n护理用品嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "235/TALK",
            "narrator": "キリト",
            "text": "なのに、傷むのか？",
            "zh": "结果还是会伤吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "237/TALK",
            "narrator": "つばめ",
            "text": "うん。\n少しは傷むまでの\n時間は稼げるけどね。",
            "zh": "嗯。\n多少能把伤掉的时间\n往后拖一点吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "239/TALK",
            "narrator": "みやび",
            "text": "うち、毛先の色が\nちっくと茶色っぽくも\nなってきちゅうよ。",
            "zh": "我的发梢颜色，\n也开始有点\n偏茶色了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "241/TALK",
            "narrator": "雛",
            "text": "あっ、本当だ！\n急いで予約した方が\nいいですよー。",
            "zh": "啊，真的！\n最好赶紧\n预约起来呀！",
            "narrator_zh": "雏"
        },
        {
            "location": "244/TALK",
            "narrator": "キリト",
            "text": "…全然傷んでるように\n見えねぇんだけどなぁ？",
            "zh": "……可我完全看不出\n哪里伤啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "17/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月18日　10:04 AM</color>\nとある平日の休み時間、つばめの教室にて。",
            "zh": "<color=green>7月18日　10:04 AM</color>\n某个工作日的休息时间，燕的教室里。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
