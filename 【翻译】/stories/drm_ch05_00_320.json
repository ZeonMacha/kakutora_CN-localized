 "entry": [
  {
   "location": "644/SCENARIO",
   "narrator": "",
   "text": "報道関係者各位"
  },
  {
   "location": "657/TALK",
   "narrator": "神楽",
   "text": "「情報管理庁\n　フェノメノン概況」"
  },
  {
   "location": "658/TALK",
   "narrator": "神楽",
   "text": "「現在フェノメノンに関する\n　緊急告知はありません」"
  },
  {
   "location": "659/TALK",
   "narrator": "神楽",
   "text": "「皆様の日頃のご理解、\n　ご協力に感謝いたします」"
  },
  {
   "location": "661/TALK",
   "narrator": "神楽",
   "text": "…ふうん…。",
   "zh": "……哼嗯……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "667/TALK",
   "narrator": "神楽",
   "text": "フェノメノンがこのまま発生しなくなったりしないかな？"
  },
  {
   "location": "668/TALK",
   "narrator": "神楽",
   "text": "どう思う？",
   "zh": "你觉得呢？",
   "narrator_zh": "神乐"
  },
  {
   "location": "670/SEL",
   "narrator": "",
   "text": "それはないんじゃないかな…",
   "zh": "那应该不会吧……",
   "narrator_zh": ""
  },
  {
   "location": "671/SEL",
   "narrator": "",
   "text": "そう思いたい気持ちはわかる"
  },
  {
   "location": "672/SEL",
   "narrator": "",
   "text": "どうだろう",
   "zh": "怎么说呢",
   "narrator_zh": ""
  },
  {
   "location": "673/ACT",
   "narrator": "",
   "text": "それはないんじゃないかな…",
   "zh": "那应该不会吧……",
   "narrator_zh": ""
  },
  {
   "location": "675/TALK",
   "narrator": "神楽",
   "text": "知ってたぴょん"
  },
  {
   "location": "678/ACT",
   "narrator": "",
   "text": "そう思いたい気持ちはわかる"
  },
  {
   "location": "679/TALK",
   "narrator": "神楽",
   "text": "そうでしょ",
   "zh": "对吧。",
   "narrator_zh": "神乐"
  },
  {
   "location": "680/TALK",
   "narrator": "神楽",
   "text": "ﾊｧｧｧｧ、、、、"
  },
  {
   "location": "683/ACT",
   "narrator": "",
   "text": "どうだろう",
   "zh": "怎么说呢",
   "narrator_zh": ""
  },
  {
   "location": "684/TALK",
   "narrator": "神楽",
   "text": "優柔不断！"
  },
  {
   "location": "685/TALK",
   "narrator": "神楽",
   "text": "ﾑｩｩｩｩ、、、"
  },
  {
   "location": "693/TALK",
   "narrator": "神楽",
   "text": "この世界は\nフェノメノンが\n発生するのが当たり前。",
   "zh": "这个世界里\n发生PhenoMENON\n是理所当然的。",
   "narrator_zh": "神乐"
  },
  {
   "location": "694/TALK",
   "narrator": "神楽",
   "text": "そういう前提で\n動いてる。",
   "zh": "是建立在那种前提上\n行动的。",
   "narrator_zh": "神乐"
  },
  {
   "location": "695/TALK",
   "narrator": "神楽",
   "text": "それを受け入れて\n日常生活を\n送ってる。",
   "zh": "接受那个，\n过着\n日常生活。",
   "narrator_zh": "神乐"
  },
  {
   "location": "696/SEL",
   "narrator": "",
   "text": "神楽"
  },
  {
   "location": "698/TALK",
   "narrator": "神楽",
   "text": "この状況に\n慣れてしまってるのは\n時間が経ったせい？",
   "zh": "会习惯这种状况，\n是因为\n时间久了？",
   "narrator_zh": "神乐"
  },
  {
   "location": "699/TALK",
   "narrator": "神楽",
   "text": "それとも……。",
   "zh": "还是说……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "701/ACT",
   "narrator": "",
   "text": "神楽"
  },
  {
   "location": "712/TALK",
   "narrator": "神楽",
   "text": "はいはい",
   "zh": "好好好",
   "narrator_zh": "神乐"
  },
  {
   "location": "713/TALK",
   "narrator": "神楽",
   "text": "ぴょんこだけど"
  },
  {
   "location": "715/SEL",
   "narrator": "",
   "text": "難しいこと考えてる？",
   "zh": "你在想难办的事？",
   "narrator_zh": ""
  },
  {
   "location": "716/SEL",
   "narrator": "",
   "text": "あんまり思い詰めないで",
   "zh": "别想太多",
   "narrator_zh": ""
  },
  {
   "location": "717/SEL",
   "narrator": "",
   "text": "$me$と楽しい話をしようよ",
   "zh": "跟$me$聊点开心的事吧",
   "narrator_zh": ""
  },
  {
   "location": "718/ACT",
   "narrator": "",
   "text": "難しいこと考えてる？",
   "zh": "你在想难办的事？",
   "narrator_zh": ""
  },
  {
   "location": "719/TALK",
   "narrator": "神楽",
   "text": "そういうわけじゃないぴょん",
   "zh": "不是那么回事pyon",
   "narrator_zh": "神乐"
  },
  {
   "location": "720/ACT",
   "narrator": "",
   "text": "あんまり思い詰めないで",
   "zh": "别想太多",
   "narrator_zh": ""
  },
  {
   "location": "721/TALK",
   "narrator": "神楽",
   "text": "そう見えた？"
  },
  {
   "location": "722/ACT",
   "narrator": "",
