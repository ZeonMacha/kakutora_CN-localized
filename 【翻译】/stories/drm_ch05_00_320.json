    "entry": [
        {
            "location": "644/SCENARIO",
            "narrator": "",
            "text": "報道関係者各位",
            "zh": "各位媒体关系者",
            "narrator_zh": ""
        },
        {
            "location": "657/TALK",
            "narrator": "神楽",
            "text": "「情報管理庁\n　フェノメノン概況」",
            "zh": "“情报管理厅\n　PhenoMENON概况”",
            "narrator_zh": "神乐"
        },
        {
            "location": "658/TALK",
            "narrator": "神楽",
            "text": "「現在フェノメノンに関する\n　緊急告知はありません」",
            "zh": "“目前关于PhenoMENON\n　暂无紧急公告”",
            "narrator_zh": "神乐"
        },
        {
            "location": "659/TALK",
            "narrator": "神楽",
            "text": "「皆様の日頃のご理解、\n　ご協力に感謝いたします」",
            "zh": "“感谢各位平日里的\n　理解与配合”",
            "narrator_zh": "神乐"
        },
        {
            "location": "661/TALK",
            "narrator": "神楽",
            "text": "…ふうん…。",
            "zh": "……哼嗯……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "667/TALK",
            "narrator": "神楽",
            "text": "フェノメノンがこのまま発生しなくなったりしないかな？",
            "zh": "PhenoMENON会不会就这样不再发生了呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "668/TALK",
            "narrator": "神楽",
            "text": "どう思う？",
            "zh": "你觉得呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "670/SEL",
            "narrator": "",
            "text": "それはないんじゃないかな…",
            "zh": "那应该不会吧……",
            "narrator_zh": ""
        },
        {
            "location": "671/SEL",
            "narrator": "",
            "text": "そう思いたい気持ちはわかる",
            "zh": "我能理解你想这么期待的心情",
            "narrator_zh": ""
        },
        {
            "location": "672/SEL",
            "narrator": "",
            "text": "どうだろう",
            "zh": "怎么说呢",
            "narrator_zh": ""
        },
        {
            "location": "673/ACT",
            "narrator": "",
            "text": "それはないんじゃないかな…",
            "zh": "那应该不会吧……",
            "narrator_zh": ""
        },
        {
            "location": "675/TALK",
            "narrator": "神楽",
            "text": "知ってたぴょん",
            "zh": "早知道了pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "678/ACT",
            "narrator": "",
            "text": "そう思いたい気持ちはわかる",
            "zh": "我能理解你想这么期待的心情",
            "narrator_zh": ""
        },
        {
            "location": "679/TALK",
            "narrator": "神楽",
            "text": "そうでしょ",
            "zh": "对吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "680/TALK",
            "narrator": "神楽",
            "text": "ﾊｧｧｧｧ、、、、",
            "zh": "唉————……",
            "narrator_zh": "神乐"
        },
        {
            "location": "683/ACT",
            "narrator": "",
            "text": "どうだろう",
            "zh": "怎么说呢",
            "narrator_zh": ""
        },
        {
            "location": "684/TALK",
            "narrator": "神楽",
            "text": "優柔不断！",
            "zh": "优柔寡断！",
            "narrator_zh": "神乐"
        },
        {
            "location": "685/TALK",
            "narrator": "神楽",
            "text": "ﾑｩｩｩｩ、、、",
            "zh": "唔唔唔唔、、、",
            "narrator_zh": "神乐"
        },
        {
            "location": "693/TALK",
            "narrator": "神楽",
            "text": "この世界は\nフェノメノンが\n発生するのが当たり前。",
            "zh": "这个世界里\n发生PhenoMENON\n是理所当然的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "694/TALK",
            "narrator": "神楽",
            "text": "そういう前提で\n動いてる。",
            "zh": "是建立在那种前提上\n行动的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "695/TALK",
            "narrator": "神楽",
            "text": "それを受け入れて\n日常生活を\n送ってる。",
            "zh": "接受那个，\n过着\n日常生活。",
            "narrator_zh": "神乐"
        },
        {
            "location": "696/SEL",
            "narrator": "",
            "text": "神楽",
            "zh": "神乐",
            "narrator_zh": ""
        },
        {
            "location": "698/TALK",
            "narrator": "神楽",
            "text": "この状況に\n慣れてしまってるのは\n時間が経ったせい？",
            "zh": "会习惯这种状况，\n是因为\n时间久了？",
            "narrator_zh": "神乐"
        },
        {
            "location": "699/TALK",
            "narrator": "神楽",
            "text": "それとも……。",
            "zh": "还是说……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "701/ACT",
            "narrator": "",
            "text": "神楽",
            "zh": "神乐",
            "narrator_zh": ""
        },
        {
            "location": "712/TALK",
            "narrator": "神楽",
            "text": "はいはい",
