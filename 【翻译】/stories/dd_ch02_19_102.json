{
    "dir": "chap19/daydra/dd_ch02_19_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "19205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "気にしすぎの湯＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "过度介怀之汤＜后篇＞"
    },
    "entry": [
        {
            "location": "467/TALK",
            "narrator": "アーヤ",
            "text": "…でも、やっぱり\n仲直りした方が\nいいかも。",
            "zh": "……不过，果然还是\n和好比较好\n吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "468/TALK",
            "narrator": "アーヤ",
            "text": "私がギャヴィ達の話を\n聞いてなかったのは\n事実なんだし。",
            "zh": "我刚才没听加维她们说话\n这也是\n事实嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "469/TALK",
            "narrator": "アーヤ",
            "text": "それに…三人で\n気持ちよくお風呂にも\n入りたいし。",
            "zh": "而且……我也想\n三个人开开心心地\n一起泡个澡。",
            "narrator_zh": "绫水"
        },
        {
            "location": "471/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、卯月の件は\n正直不安ではあるけど。",
            "zh": "……嘛，卯月那件事\n老实说确实还是让人放心不下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "473/TALK",
            "narrator": "アーヤ",
            "text": "でも、ギャヴィ達が\n一緒なんだから\n大丈夫よね。",
            "zh": "不过，有加维她们\n一起在嘛，\n应该没问题的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "474/TALK",
            "narrator": "みやび",
            "text": "お？　なんやなんや？\nうちら信頼されちょる\nっちゅうことか？",
            "zh": "哦？搞么子搞么子？\n你是说我们\n很受你信赖咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "475/TALK",
            "narrator": "アーヤ",
            "text": "当然でしょ？",
            "zh": "那当然吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "476/TALK",
            "narrator": "アーヤ",
            "text": "つばめ達が入隊する\nまではずっと三人で\n頑張ってきたんだし。",
            "zh": "在燕她们入队之前\n一直都是我们三个人\n一起努力过来的嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "477/TALK",
            "narrator": "アーヤ",
            "text": "それに、今回の件は\n私だけで手に負えない\nもの。",
            "zh": "而且，这次的事\n光靠我一个人\n可应付不来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "478/TALK",
            "narrator": "アーヤ",
            "text": "二人にも手伝って\nもらわなきゃ。",
            "zh": "也得请你们俩\n搭把手才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "479/TALK",
            "narrator": "アーヤ",
            "text": "だから、その時は\nお願いしていい？",
            "zh": "所以，到时候\n能拜托你们吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "480/TALK",
            "narrator": "みやび",
            "text": "まあ、これも先輩\nとしての仕事の一つ\nやきね。",
            "zh": "嘛，这也算是\n作为前辈的工作之一\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "482/TALK",
            "narrator": "アーヤ",
            "text": "ありがと。",
            "zh": "谢谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "483/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィは？",
            "zh": "加维呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "485/TALK",
            "narrator": "ガブリエラ",
            "text": "…一応あたし、\n最年少なんだけど？",
            "zh": "……好歹我才是\n年纪最小的那个好吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "486/TALK",
            "narrator": "アーヤ",
            "text": "最年少だったら\n頼りにならないの？",
            "zh": "年纪最小\n就靠不住了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "487/TALK",
            "narrator": "アーヤ",
            "text": "そんなことないでしょ？\nだから\n信頼してるのよ。",
            "zh": "才没有这回事吧？\n所以我才\n信赖你呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "488/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "489/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、まあ…、\nそうまで言うなら\n仕方ないわね。",
            "zh": "好、好吧……，\n你都说到这份上了\n那也没办法咯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "490/TALK",
            "narrator": "ガブリエラ",
            "text": "正直、すっっっごく\n面倒よ。\nそれは間違いない。",
            "zh": "老实说，真——的\n麻烦死了。\n这点毫无疑问。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "491/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、困ったときは\nちゃんとフォローして\nあげるわ。",
            "zh": "不过，真遇上麻烦时\n我会好好替你\n兜底的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "493/TALK",
            "narrator": "アーヤ",
            "text": "ありがと…。\nおかげで、ちょっと\n気が軽くなったわ。",
            "zh": "谢谢……。\n托你们的福，稍微\n轻松了点。",
            "narrator_zh": "绫水"
        },
        {
            "location": "494/TALK",
            "narrator": "みやび",
            "text": "礼はハワイ旅行か\n最新型のタブレットで\nよろしく。",
            "zh": "谢礼的话就来趟夏威夷旅行\n或者最新款平板电脑\n麻烦了。",
            "narrator_zh": "雅"
        },
        {
            "location": "496/TALK",
            "narrator": "アーヤ",
            "text": "両方とも無理だから、\n心を込めて背中を\n流させてもらうわ。",
            "zh": "两样都办不到，\n就让我诚心诚意地\n替你们搓搓背吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "497/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？\nい、いいわよ。\n別にそんなこと…。",
            "zh": "哎！？\n不、不用了啦。\n不用特意做这种事……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "498/TALK",
            "narrator": "みやび",
            "text": "おっ、それもえいな。\nそれじゃ遠慮なく\n頼むとするがよ。",
            "zh": "哦，那也蛮好啵。\n那我就不客气\n拜托你咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "499/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、本気！？",
            "zh": "等、认真的！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "500/TALK",
            "narrator": "みやび",
            "text": "人の親切は素直に\n受けるもんや。",
            "zh": "别人的好意就该\n坦然收下嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "501/TALK",
            "narrator": "みやび",
            "text": "ほれ、早く脱ぎぃ。\nちんたらしゆうと、\nうちが脱がすぞね？",
            "zh": "喂，快点脱咯。\n再磨磨蹭蹭的，\n我就动手扒了啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "503/TALK",
            "narrator": "ガブリエラ",
            "text": "わ、わかったわよ！\nもう…。",
            "zh": "知、知道了啦！\n真是的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "530/TALK",
            "narrator": "アーヤ",
            "text": "さっぱりしたわぁ…。",
            "zh": "好清爽呀……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "531/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、訓練の後の\nお風呂って、最高ね。",
            "zh": "果然，训练之后\n泡个澡，真是太棒了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "532/TALK",
            "narrator": "みやび",
            "text": "うむ…ちっくと\nうとうとしてしもうた\nがよ。",
            "zh": "嗯……刚才一哈\n迷迷糊糊打起盹\n来了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "533/TALK",
            "narrator": "アーヤ",
            "text": "実際、何度かお湯に\n顔浸かって、慌てて\n起きてたわね。",
            "zh": "实际上，你脸都往水里\n栽了好几次，又慌慌张张\n抬起来呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "535/TALK",
            "narrator": "みやび",
            "text": "一回、鼻にお湯入って\n最悪だったぞね。",
            "zh": "有一次水都呛进鼻子里了\n倒霉得很啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "536/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうかさー、\nそんな大きな浮き輪\n二つもあるじゃない！",
            "zh": "话说回来啊——，\n你身上不是带着那么大的\n两个游泳圈吗！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "537/TALK",
            "narrator": "ガブリエラ",
            "text": "それでどうして\n溺れそうに\nなるのよ？",
            "zh": "怎么还会\n差点淹着\n啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "538/TALK",
            "narrator": "みやび",
            "text": "浮き輪として使う\n目的で付いとるわけや\nないきね。",
            "zh": "长在身上又不是为了\n拿来当游泳圈用的\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "540/TALK",
            "narrator": "アーヤ",
            "text": "もう、バカなこと\n言ってるんじゃ\nないの。",
            "zh": "真是的，别净说\n些傻话\n了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "541/SEL",
            "narrator": "",
            "text": "背中、ちゃんと流してあげた？",
            "zh": "背，好好帮她们搓了吗？",
            "narrator_zh": ""
        },
        {
            "location": "542/SEL",
            "narrator": "",
            "text": "随分労ったみたいだね",
            "zh": "看来好好慰劳了一番呢",
            "narrator_zh": ""
        },
        {
            "location": "543/ACT",
            "narrator": "",
            "text": "背中、ちゃんと流してあげた？",
            "zh": "背，好好帮她们搓了吗？",
            "narrator_zh": ""
        },
        {
            "location": "560/TALK",
            "narrator": "アーヤ",
            "text": "もちろん(^^",
            "zh": "当然了(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "562/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "563/TALK",
            "narrator": "アーヤ",
            "text": "お返しって言われて",
            "zh": "她们说是作为回礼",
            "narrator_zh": "绫水"
        },
        {
            "location": "564/TALK",
            "narrator": "アーヤ",
            "text": "私も流してもらった(*^^*)",
            "zh": "我也让她们帮我搓了(*^^*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "565/TALK",
            "narrator": "アーヤ",
            "text": "気持ちよかったわ(￣∇￣)",
            "zh": "好舒服呀(￣∇￣)",
            "narrator_zh": "绫水"
        },
        {
            "location": "567/SEL",
            "narrator": "",
            "text": "$me$も見たかった",
            "zh": "$me$也想看",
            "narrator_zh": ""
        },
        {
            "location": "568/SEL",
            "narrator": "",
            "text": "明日は今日以上に頑張れるね",
            "zh": "明天就能比今天更加油了呢",
            "narrator_zh": ""
        },
        {
            "location": "569/ACT",
            "narrator": "",
            "text": "$me$も見たかった",
            "zh": "$me$也想看",
            "narrator_zh": ""
        },
        {
            "location": "571/TALK",
            "narrator": "アーヤ",
            "text": "浴場にスマホ持ち込めないし(-ω-;)",
            "zh": "澡堂里又带不进手机(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "572/TALK",
            "narrator": "アーヤ",
            "text": "っていうか",
            "zh": "话说回来",
            "narrator_zh": "绫水"
        },
        {
            "location": "573/TALK",
            "narrator": "アーヤ",
            "text": "エッチなこと言わないの（｀皿´ )",
            "zh": "别说色色的事（｀皿´ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "576/TALK",
            "narrator": "アーヤ",
            "text": "バカ",
            "zh": "笨蛋",
            "narrator_zh": "绫水"
        },
        {
            "location": "577/ACT",
            "narrator": "",
            "text": "明日は今日以上に頑張れるね",
            "zh": "明天就能比今天更加油了呢",
            "narrator_zh": ""
        },
        {
            "location": "578/TALK",
            "narrator": "アーヤ",
            "text": "そうね(^^",
            "zh": "是啊(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "579/TALK",
            "narrator": "アーヤ",
            "text": "二人から",
            "zh": "从她们俩那里",
            "narrator_zh": "绫水"
        },
        {
            "location": "580/TALK",
            "narrator": "アーヤ",
            "text": "やる気もらったんだし(>_<)",
            "zh": "收获了满满干劲呢(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "581/TALK",
            "narrator": "アーヤ",
            "text": "明日が楽しみ(=^0^=)",
            "zh": "好期待明天(=^0^=)",
            "narrator_zh": "绫水"
        },
        {
            "location": "583/ACT",
            "narrator": "",
            "text": "随分労ったみたいだね",
            "zh": "看来好好慰劳了一番呢",
            "narrator_zh": ""
        },
        {
            "location": "600/TALK",
            "narrator": "アーヤ",
            "text": "そのつもりよ(^^",
            "zh": "我就是这么打算的(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "602/TALK",
            "narrator": "アーヤ",
            "text": "卯月がメノウってわかってから",
            "zh": "自从知道卯月就是MENOW之后",
            "narrator_zh": "绫水"
        },
        {
            "location": "603/TALK",
            "narrator": "アーヤ",
            "text": "他の子のこと",
            "zh": "对其他孩子的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "604/TALK",
            "narrator": "アーヤ",
            "text": "なんとなく",
            "zh": "总觉得有点",
            "narrator_zh": "绫水"
        },
        {
            "location": "605/TALK",
            "narrator": "アーヤ",
            "text": "疎かにしちゃってたし(・・。)ゞ",
            "zh": "给疏忽了呢(・・。)ゞ",
            "narrator_zh": "绫水"
        },
        {
            "location": "606/TALK",
            "narrator": "アーヤ",
            "text": "二人のこと",
            "zh": "我是打心底里",
            "narrator_zh": "绫水"
        },
        {
            "location": "607/TALK",
            "narrator": "アーヤ",
            "text": "ちゃんと信頼してるって",
            "zh": "信任着她们俩的",
            "narrator_zh": "绫水"
        },
        {
            "location": "608/TALK",
            "narrator": "アーヤ",
            "text": "伝わったかしら(>_<)",
            "zh": "不知道有没有传达到呢(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "610/SEL",
            "narrator": "",
            "text": "背中流すのって関係あったの？",
            "zh": "搓背和这有什么关系吗？",
            "narrator_zh": ""
        },
        {
            "location": "611/ACT",
            "narrator": "",
            "text": "背中流すのって関係あったの？",
            "zh": "搓背和这有什么关系吗？",
            "narrator_zh": ""
        },
        {
            "location": "614/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "615/TALK",
            "narrator": "アーヤ",
            "text": "あれよ",
            "zh": "那个嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "618/TALK",
            "narrator": "アーヤ",
            "text": "謝罪と反省の気持ち(｡-_-｡)",
            "zh": "就是赔礼和反省的心意(｡-_-｡)",
            "narrator_zh": "绫水"
        },
        {
            "location": "620/TALK",
            "narrator": "アーヤ",
            "text": "頼りにしてますって",
            "zh": "把“我很依赖你们”的心意",
            "narrator_zh": "绫水"
        },
        {
            "location": "621/TALK",
            "narrator": "アーヤ",
            "text": "行動で示してみた",
            "zh": "试着用行动表达了一下",
            "narrator_zh": "绫水"
        },
        {
            "location": "622/TALK",
            "narrator": "アーヤ",
            "text": "わかった？( ・_・)σﾞ",
            "zh": "明白了吗？( ・_・)σﾞ",
            "narrator_zh": "绫水"
        },
        {
            "location": "644/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【MV EXE_GARBiELa】",
            "zh": "【MV EXE_GARBiELa】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
