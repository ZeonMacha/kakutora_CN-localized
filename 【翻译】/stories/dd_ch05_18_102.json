{
    "dir": "chap18/daydra/dd_ch05_18_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "18505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "トップヲタか友達か＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "头号死忠粉还是朋友＜后篇＞[?]"
    },
    "entry": [
        {
            "location": "3459/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "3460/TALK",
            "narrator": "神楽",
            "text": "…$handle$さんの、\n言う通りなのかも。",
            "zh": "……也许真像\n$handle$说的那样。",
            "narrator_zh": "神乐"
        },
        {
            "location": "3461/TALK",
            "narrator": "神楽",
            "text": "私もママもつばめさんも、\nみんなが幸せになるための\n方法なんて…。",
            "zh": "什么让我、妈妈还有燕\n大家都能幸福的\n方法……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "3462/TALK",
            "narrator": "神楽",
            "text": "考えたって、\n見つかるはずない。",
            "zh": "想破脑袋，\n也不可能找得到。",
            "narrator_zh": "神乐"
        },
        {
            "location": "3463/TALK",
            "narrator": "神楽",
            "text": "なのに、それ以外は\n絶対に受け入れないと\n思って、止まってる。",
            "zh": "可我却想着\n除此之外绝对不接受，\n一直在原地踏步。",
            "narrator_zh": "神乐"
        },
        {
            "location": "3465/TALK",
            "narrator": "神楽",
            "text": "これじゃ、なにもする気が\nないって言われるのも、\n当然よね…。",
            "zh": "这样的话，被说什么也不打算做，\n也是理所当然\n的吧……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "3478/TALK",
            "narrator": "神楽",
            "text": "さっきは、ごめんなさい",
            "zh": "刚才的事，对不起",
            "narrator_zh": "神乐"
        },
        {
            "location": "3481/TALK",
            "narrator": "神楽",
            "text": "$handle$さんの言うとおりでした",
            "zh": "$handle$说得对",
            "narrator_zh": "神乐"
        },
        {
            "location": "3482/TALK",
            "narrator": "神楽",
            "text": "私",
            "zh": "我",
            "narrator_zh": "神乐"
        },
        {
            "location": "3483/TALK",
            "narrator": "神楽",
            "text": "頑固です",
            "zh": "就是很固执",
            "narrator_zh": "神乐"
        },
        {
            "location": "3486/TALK",
            "narrator": "神楽",
            "text": "そのせいでなにもできず",
            "zh": "正因为这样，什么都做不了",
            "narrator_zh": "神乐"
        },
        {
            "location": "3487/TALK",
            "narrator": "神楽",
            "text": "立ち止まってるというのに",
            "zh": "明明一直停在原地",
            "narrator_zh": "神乐"
        },
        {
            "location": "3488/TALK",
            "narrator": "神楽",
            "text": "結局動こうとしない",
            "zh": "结果却还是不肯迈出一步",
            "narrator_zh": "神乐"
        },
        {
            "location": "3491/TALK",
            "narrator": "神楽",
            "text": "なにか、ないんですか？",
            "zh": "难道就真的没有吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "3492/TALK",
            "narrator": "神楽",
            "text": "私もママもつばめさんも",
            "zh": "无论是让我、妈妈还是燕",
            "narrator_zh": "神乐"
        },
        {
            "location": "3493/TALK",
            "narrator": "神楽",
            "text": "幸せな結末を迎える方法は",
            "zh": "都能迎来幸福结局的方法",
            "narrator_zh": "神乐"
        },
        {
            "location": "3496/TALK",
            "narrator": "神楽",
            "text": "本当はなにか",
            "zh": "其实是不是还",
            "narrator_zh": "神乐"
        },
        {
            "location": "3497/TALK",
            "narrator": "神楽",
            "text": "方法が残されているんじゃないですか？",
            "zh": "留有什么别的办法呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "3499/SEL",
            "narrator": "",
            "text": "そんな都合のいい答えはない",
            "zh": "没有那种顺心如意的答案",
            "narrator_zh": ""
        },
        {
            "location": "3500/ACT",
            "narrator": "",
            "text": "そんな都合のいい答えはない",
            "zh": "没有那种顺心如意的答案",
            "narrator_zh": ""
        },
        {
            "location": "3503/TALK",
            "narrator": "神楽",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": "神乐"
        },
        {
            "location": "3504/TALK",
            "narrator": "神楽",
            "text": "そうですよね",
            "zh": "是这样呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "3505/TALK",
            "narrator": "神楽",
            "text": "ありがとうございます",
            "zh": "谢谢你",
            "narrator_zh": "神乐"
        },
        {
            "location": "3507/TALK",
            "narrator": "神楽",
            "text": "ハッキリ言ってくれて",
            "zh": "能这么直截了当地告诉我",
            "narrator_zh": "神乐"
        },
        {
            "location": "3510/TALK",
            "narrator": "神楽",
            "text": "自分でもわかってたのに",
            "zh": "明明我自己也明白",
            "narrator_zh": "神乐"
        },
        {
            "location": "3511/TALK",
            "narrator": "神楽",
            "text": "認められなくて",
            "zh": "却始终不肯承认",
            "narrator_zh": "神乐"
        },
        {
            "location": "3512/TALK",
            "narrator": "神楽",
            "text": "ずっとモヤモヤしてて",
            "zh": "心里一直郁结着",
            "narrator_zh": "神乐"
        },
        {
            "location": "3515/TALK",
            "narrator": "神楽",
            "text": "でも、今ので吹っ切れました",
            "zh": "不过，刚才那番话让我一下子想通了",
            "narrator_zh": "神乐"
        },
        {
            "location": "3516/TALK",
            "narrator": "神楽",
            "text": "私に残された選択肢は限られていて",
            "zh": "留给我的选项本来就有限",
            "narrator_zh": "神乐"
        },
        {
            "location": "3517/TALK",
            "narrator": "神楽",
            "text": "どんなに辛くて、イヤだったとしても",
            "zh": "不管有多痛苦、有多不情愿",
            "narrator_zh": "神乐"
        },
        {
            "location": "3518/TALK",
            "narrator": "神楽",
            "text": "その中から選ばなければならない",
            "zh": "我都必须从里面做出选择",
            "narrator_zh": "神乐"
        },
        {
            "location": "3521/TALK",
            "narrator": "神楽",
            "text": "覚悟を決めました",
            "zh": "我已经下定决心了",
            "narrator_zh": "神乐"
        },
        {
            "location": "3522/TALK",
            "narrator": "神楽",
            "text": "もう、無駄な希望にはすがりません",
            "zh": "不会再抓着无用的希望不放了",
            "narrator_zh": "神乐"
        },
        {
            "location": "3523/TALK",
            "narrator": "神楽",
            "text": "どんな辛い選択でも",
            "zh": "再痛苦的选择",
            "narrator_zh": "神乐"
        },
        {
            "location": "3524/TALK",
            "narrator": "神楽",
            "text": "選びます",
            "zh": "我都会选下去",
            "narrator_zh": "神乐"
        },
        {
            "location": "3525/TALK",
            "narrator": "神楽",
            "text": "そのせいで",
            "zh": "就算会因此",
            "narrator_zh": "神乐"
        },
        {
            "location": "3526/TALK",
            "narrator": "神楽",
            "text": "誰かが不幸になるとしても",
            "zh": "让谁变得不幸",
            "narrator_zh": "神乐"
        },
        {
            "location": "3528/SEL",
            "narrator": "",
            "text": "つばめ優先で頼むよ",
            "zh": "拜托优先考虑燕吧",
            "narrator_zh": ""
        },
        {
            "location": "3529/SEL",
            "narrator": "",
            "text": "神楽の選択を尊重するよ",
            "zh": "我会尊重神乐的选择",
            "narrator_zh": ""
        },
        {
            "location": "3530/SEL",
            "narrator": "",
            "text": "現状維持じゃダメなの？",
            "zh": "维持现状不行吗？",
            "narrator_zh": ""
        },
        {
            "location": "3531/ACT",
            "narrator": "",
            "text": "つばめ優先で頼むよ",
            "zh": "拜托优先考虑燕吧",
            "narrator_zh": ""
        },
        {
            "location": "3533/TALK",
            "narrator": "神楽",
            "text": "ああ",
            "zh": "啊啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "3534/TALK",
            "narrator": "神楽",
            "text": "そういうこと",
            "zh": "原来是这样",
            "narrator_zh": "神乐"
        },
        {
            "location": "3535/TALK",
            "narrator": "神楽",
            "text": "結局$handle$さんは",
            "zh": "到头来$handle$",
            "narrator_zh": "神乐"
        },
        {
            "location": "3536/TALK",
            "narrator": "神楽",
            "text": "つばめさんの味方ってわけですか",
            "zh": "还是站在燕那边的啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "3539/TALK",
            "narrator": "神楽",
            "text": "私のことを想って、厳しい言葉をかけてくれたんじゃないんですね",
            "zh": "原来你并不是为了我好，才对我说那些严厉的话的呀",
            "narrator_zh": "神乐"
        },
        {
            "location": "3540/TALK",
            "narrator": "神楽",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "神乐"
        },
        {
            "location": "3541/TALK",
            "narrator": "神楽",
            "text": "所詮裏切り者の小娘を、大切に想うはずありませんよね",
            "zh": "归根结底，怎么可能会把一个背叛者的小丫头放在心上呢，对吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "3542/TALK",
            "narrator": "神楽",
            "text": "私がバカでした",
            "zh": "是我太蠢了",
            "narrator_zh": "神乐"
        },
        {
            "location": "3554/ACT",
            "narrator": "",
            "text": "神楽の選択を尊重するよ",
            "zh": "我会尊重神乐的选择",
            "narrator_zh": ""
        },
        {
            "location": "3555/TALK",
            "narrator": "神楽",
            "text": "とっても嬉しいです",
            "zh": "我非常开心",
            "narrator_zh": "神乐"
        },
        {
            "location": "3559/TALK",
            "narrator": "神楽",
            "text": "今だから話しますけど",
            "zh": "事到如今我才说",
            "narrator_zh": "神乐"
        },
        {
            "location": "3560/TALK",
            "narrator": "神楽",
            "text": "最初は私、$handle$さんのこと",
            "zh": "一开始我一直觉得$handle$",
            "narrator_zh": "神乐"
        },
        {
            "location": "3561/TALK",
            "narrator": "神楽",
            "text": "とっても胡散臭い人だと思ってました",
            "zh": "是个非常可疑的人",
            "narrator_zh": "神乐"
        },
        {
            "location": "3562/TALK",
            "narrator": "神楽",
            "text": "けど今は",
            "zh": "但现在",
            "narrator_zh": "神乐"
        },
        {
            "location": "3563/TALK",
            "narrator": "神楽",
            "text": "とっても心強い存在です",
            "zh": "你是让我感到非常安心的存在",
            "narrator_zh": "神乐"
        },
        {
            "location": "3564/TALK",
            "narrator": "神楽",
            "text": "だって$handle$さんは",
            "zh": "因为$handle$",
            "narrator_zh": "神乐"
        },
        {
            "location": "3565/TALK",
            "narrator": "神楽",
            "text": "私が本音を出して話せる、唯一の人だから",
            "zh": "是我唯一能够吐露真心话的人",
            "narrator_zh": "神乐"
        },
        {
            "location": "3568/TALK",
            "narrator": "神楽",
            "text": "これからの私は",
            "zh": "接下来的我",
            "narrator_zh": "神乐"
        },
        {
            "location": "3569/TALK",
            "narrator": "神楽",
            "text": "今よりももっと、辛い想いをすることになると思う",
            "zh": "我想会比现在承受更多、更痛苦的煎熬",
            "narrator_zh": "神乐"
        },
        {
            "location": "3570/TALK",
            "narrator": "神楽",
            "text": "心が押しつぶされそうになったり",
            "zh": "心也许会快要被压垮",
            "narrator_zh": "神乐"
        },
        {
            "location": "3571/TALK",
            "narrator": "神楽",
            "text": "逃げだそうとしたくなることもあるかも",
            "zh": "说不定也会有想要逃走的时候",
            "narrator_zh": "神乐"
        },
        {
            "location": "3572/TALK",
            "narrator": "神楽",
            "text": "そうなったときは",
            "zh": "真到了那个时候",
            "narrator_zh": "神乐"
        },
        {
            "location": "3573/TALK",
            "narrator": "神楽",
            "text": "$handle$さんのこと、頼りにしていい？",
            "zh": "我可以依靠$handle$吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "3576/SEL",
            "narrator": "",
            "text": "もちろんだよ",
            "zh": "当然了",
            "narrator_zh": ""
        },
        {
            "location": "3577/SEL",
            "narrator": "",
            "text": "どんとこい！！",
            "zh": "尽管来吧！！",
            "narrator_zh": ""
        },
        {
            "location": "3578/ACT",
            "narrator": "",
            "text": "もちろんだよ",
            "zh": "当然了",
            "narrator_zh": ""
        },
        {
            "location": "3580/TALK",
            "narrator": "神楽",
            "text": "優しい人",
            "zh": "真是个温柔的人",
            "narrator_zh": "神乐"
        },
        {
            "location": "3581/TALK",
            "narrator": "神楽",
            "text": "本当に、ありがとう",
            "zh": "真的，谢谢你",
            "narrator_zh": "神乐"
        },
        {
            "location": "3582/TALK",
            "narrator": "神楽",
            "text": "私、頑張りますね",
            "zh": "我会加油的",
            "narrator_zh": "神乐"
        },
        {
            "location": "3583/ACT",
            "narrator": "",
            "text": "どんとこい！！",
            "zh": "尽管来吧！！",
            "narrator_zh": ""
        },
        {
            "location": "3584/TALK",
            "narrator": "神楽",
            "text": "力強い返事ですね",
            "zh": "真是有底气的回答",
            "narrator_zh": "神乐"
        },
        {
            "location": "3585/TALK",
            "narrator": "神楽",
            "text": "頼りにしてます",
            "zh": "那我就依靠你了",
            "narrator_zh": "神乐"
        },
        {
            "location": "3597/TALK",
            "narrator": "神楽",
            "text": "…嬉しい。",
            "zh": "……好开心。",
            "narrator_zh": "神乐"
        },
        {
            "location": "3598/TALK",
            "narrator": "神楽",
            "text": "胸の内をさらけ出せる\n相手がいるって…。",
            "zh": "有个能敞开心扉\n倾诉的对象……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "3600/TALK",
            "narrator": "神楽",
            "text": "こんなにも心強いこと\nなのね…。",
            "zh": "原来是这么让人\n安心的事啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "3601/TALK",
            "narrator": "神楽",
            "text": "…でも。",
            "zh": "……可是。",
            "narrator_zh": "神乐"
        },
        {
            "location": "3602/TALK",
            "narrator": "神楽",
            "text": "私は、どんな選択を――",
            "zh": "我究竟会做出什么选择——",
            "narrator_zh": "神乐"
        },
        {
            "location": "3603/TALK",
            "narrator": "神楽",
            "text": "ママと、つばめさん…、\nどっちを選ぶんだろう？",
            "zh": "妈妈和燕……\n我到底会选哪一边呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "3605/ACT",
            "narrator": "",
            "text": "現状維持じゃダメなの？",
            "zh": "维持现状不行吗？",
            "narrator_zh": ""
        },
        {
            "location": "3606/TALK",
            "narrator": "神楽",
            "text": "はぁ！？",
            "zh": "哈！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "3607/TALK",
            "narrator": "神楽",
            "text": "現状維持じゃ",
            "zh": "维持现状的话",
            "narrator_zh": "神乐"
        },
        {
            "location": "3608/TALK",
            "narrator": "神楽",
            "text": "今までとなにも変わらないじゃないですか！",
            "zh": "不就和至今为止没有任何区别了吗！",
            "narrator_zh": "神乐"
        },
        {
            "location": "3609/TALK",
            "narrator": "神楽",
            "text": "それがイヤだから",
            "zh": "正是因为讨厌那样",
            "narrator_zh": "神乐"
        },
        {
            "location": "3610/TALK",
            "narrator": "神楽",
            "text": "行動すると決めたのに",
            "zh": "我才决定采取行动的",
            "narrator_zh": "神乐"
        },
        {
            "location": "3613/TALK",
            "narrator": "神楽",
            "text": "$handle$さんがなにを考えているのか、わかりません",
            "zh": "真搞不懂$handle$在想什么",
            "narrator_zh": "神乐"
        },
        {
            "location": "3614/TALK",
            "narrator": "神楽",
            "text": "ガッカリしました",
            "zh": "真是令人失望",
            "narrator_zh": "神乐"
        },
        {
            "location": "3635/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【15 弾の数だけ抱きしめて】",
            "zh": "【15 有多少发子弹，就拥抱多少次】",
            "narrator_zh": "Dialog_chapter_ch05"
        },
        {
            "location": "3647/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【15 弾の数だけ抱きしめて】",
            "zh": "【15 有多少发子弹，就拥抱多少次】",
            "narrator_zh": "Dialog_chapter_ch05"
        }
    ]
}
