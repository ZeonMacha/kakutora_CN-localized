{
    "dir": "chap00/daydra/spev_ch01_091_03.js",
    "type": "",
    "info": {
        "story_id": "91023",
        "cid": "",
        "title": "シャッツキステリンク",
        "sub_title": "忘れもの見つけたよ！",
        "title_zh": "宝箱链接",
        "sub_title_zh": "找到遗落的东西啦！"
    },
    "entry": [
        {
            "location": "688/SCENARIO",
            "narrator": "",
            "text": "報告イベント",
            "zh": "汇报活动",
            "narrator_zh": ""
        },
        {
            "location": "711/DIALOG",
            "narrator": "",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已连接。\n\n请点击画面，向对方\n传达感觉吧。",
            "narrator_zh": ""
        },
        {
            "location": "744/TALK",
            "narrator": "神楽",
            "text": "はぁ…。",
            "zh": "唉……",
            "narrator_zh": "神乐"
        },
        {
            "location": "749/TALK",
            "narrator": "神楽",
            "text": "最近ほんとにダメです、\n私……。",
            "zh": "最近我真的不行，\n我……",
            "narrator_zh": "神乐"
        },
        {
            "location": "754/TALK",
            "narrator": "神楽",
            "text": "ションボリです……。",
            "zh": "垂头丧气的……",
            "narrator_zh": "神乐"
        },
        {
            "location": "759/TALK",
            "narrator": "神楽",
            "text": "奇跡的に見つかったり、\nしないですよね……。",
            "zh": "不会奇迹般地\n找到的吧……",
            "narrator_zh": "神乐"
        },
        {
            "location": "764/TALK",
            "narrator": "神楽",
            "text": "……。",
            "zh": "……",
            "narrator_zh": "神乐"
        },
        {
            "location": "783/TALK",
            "narrator": "神楽",
            "text": "きゃっ！？",
            "zh": "呀！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "788/TALK",
            "narrator": "神楽",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "793/TALK",
            "narrator": "神楽",
            "text": "はわっ！",
            "zh": "哈哇！",
            "narrator_zh": "神乐"
        },
        {
            "location": "796/DIALOG",
            "narrator": "",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已断开。",
            "narrator_zh": ""
        },
        {
            "location": "797/TALK",
            "narrator": "神楽",
            "text": "貴方は確か――！！",
            "zh": "你一定是——！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "798/SEL",
            "narrator": "（選択肢）",
            "text": "プリ見つけたよ",
            "zh": "大头贴找到了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "799/ACT",
            "narrator": "",
            "text": "プリ見つけたよ",
            "zh": "大头贴找到了",
            "narrator_zh": ""
        },
        {
            "location": "802/TALK",
            "narrator": "神楽",
            "text": "えぇっ！\n本当に見つけて\nくれたんですか！？",
            "zh": "诶诶！\n真的找到了\n吗！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "803/TALK",
            "narrator": "神楽",
            "text": "よかった…。\nもう、見つからないと\n思ってました…。",
            "zh": "太好了……\n我还以为\n再也找不到了……",
            "narrator_zh": "神乐"
        },
        {
            "location": "804/SEL",
            "narrator": "（選択肢）",
            "text": "そんなに大切だったんだ？",
            "zh": "有那么重要吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "805/ACT",
            "narrator": "",
            "text": "そんなに大切だったんだ？",
            "zh": "有那么重要吗？",
            "narrator_zh": ""
        },
        {
            "location": "807/TALK",
            "narrator": "神楽",
            "text": "…はい。",
            "zh": "……是的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "808/TALK",
            "narrator": "神楽",
            "text": "このプリは…、\n私には、本当に特別で、\n大切なものなんです。",
            "zh": "这张大头贴……\n对我来说，真的很特别，\n很重要。",
            "narrator_zh": "神乐"
        },
        {
            "location": "809/TALK",
            "narrator": "神楽",
            "text": "このプリがあるから、\n私は今も、つばめさんの\nことを…。",
            "zh": "因为有这张大头贴，\n我现在也还能把燕\n当成……",
            "narrator_zh": "神乐"
        },
        {
            "location": "810/SEL",
            "narrator": "（選択肢）",
            "text": "つばめを、なに？",
            "zh": "把燕当成什么？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "811/ACT",
            "narrator": "",
            "text": "つばめを、なに？",
            "zh": "把燕当成什么？",
            "narrator_zh": ""
        },
        {
            "location": "813/TALK",
            "narrator": "神楽",
            "text": "…友達だと、\n思えているんです。",
            "zh": "……当成\n朋友。",
            "narrator_zh": "神乐"
        },
        {
            "location": "814/TALK",
            "narrator": "神楽",
            "text": "もしこれが無かったら、\nきっと私は、今頃…。",
            "zh": "要是没有这个，\n我现在一定……",
            "narrator_zh": "神乐"
        },
        {
            "location": "815/SEL",
            "narrator": "（選択肢）",
            "text": "なんか不穏だね",
            "zh": "有点不祥啊",
            "narrator_zh": "（选项）"
        },
        {
            "location": "816/ACT",
            "narrator": "",
            "text": "なんか不穏だね",
            "zh": "有点不祥啊",
            "narrator_zh": ""
        },
        {
            "location": "818/TALK",
            "narrator": "神楽",
            "text": "…ごめんなさい。\n変な話しちゃって。",
            "zh": "……对不起。\n说了奇怪的话。",
            "narrator_zh": "神乐"
        },
        {
            "location": "819/TALK",
            "narrator": "神楽",
            "text": "とにかく、これは私と\nつばめさんの絆で、\n大切なものってことです。",
            "zh": "总之，这是我和\n燕的纽带，\n很重要的东西。",
            "narrator_zh": "神乐"
        },
        {
            "location": "820/SEL",
            "narrator": "（選択肢）",
            "text": "見つかってよかった",
            "zh": "找到了就好",
            "narrator_zh": "（选项）"
        },
        {
            "location": "821/SEL",
            "narrator": "（選択肢）",
            "text": "早く繋がりたいよ！",
            "zh": "想快点连上！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "822/ACT",
            "narrator": "",
            "text": "見つかってよかった",
            "zh": "找到了就好",
            "narrator_zh": ""
        },
        {
            "location": "823/TALK",
            "narrator": "神楽",
            "text": "私も、見つけていただけて\n本当に嬉しいです。",
            "zh": "我也是，能被你找到，\n真的很高兴。",
            "narrator_zh": "神乐"
        },
        {
            "location": "824/TALK",
            "narrator": "神楽",
            "text": "何と感謝すれば\nよいのやら…。",
            "zh": "该怎么感谢\n才好……",
            "narrator_zh": "神乐"
        },
        {
            "location": "825/SEL",
            "narrator": "（選択肢）",
            "text": "神楽が喜んでるならＯＫ",
            "zh": "神乐高兴就行",
            "narrator_zh": "（选项）"
        },
        {
            "location": "826/SEL",
            "narrator": "（選択肢）",
            "text": "デート一回でいいよ",
            "zh": "约会一次就好",
            "narrator_zh": "（选项）"
        },
        {
            "location": "827/ACT",
            "narrator": "",
            "text": "神楽が喜んでるならＯＫ",
            "zh": "神乐高兴就行",
            "narrator_zh": ""
        },
        {
            "location": "829/TALK",
            "narrator": "神楽",
            "text": "ふふっ、\n紳士さんですね。",
            "zh": "呵呵，\n你真是个绅士。",
            "narrator_zh": "神乐"
        },
        {
            "location": "830/ACT",
            "narrator": "",
            "text": "デート一回でいいよ",
            "zh": "约会一次就好",
            "narrator_zh": ""
        },
        {
            "location": "831/TALK",
            "narrator": "神楽",
            "text": "気持ちは、\nとても嬉しいです。",
            "zh": "这份心意，\n我很高兴。",
            "narrator_zh": "神乐"
        },
        {
            "location": "833/TALK",
            "narrator": "神楽",
            "text": "でも…これから先も、\nそう思ってもらえるか\nどうか…。",
            "zh": "可是……以后\n你还会不会\n这么想……",
            "narrator_zh": "神乐"
        },
        {
            "location": "834/SEL",
            "narrator": "（選択肢）",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "835/ACT",
            "narrator": "",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "838/TALK",
            "narrator": "神楽",
            "text": "あ、いえ！\nなんでもありません…。",
            "zh": "啊，不！\n没什么……",
            "narrator_zh": "神乐"
        },
        {
            "location": "839/TALK",
            "narrator": "神楽",
            "text": "では、機会があれば、\n一緒にデートしましょう。",
            "zh": "那么，有机会的话，\n一起约会吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "841/TALK",
            "narrator": "神楽",
            "text": "その時はもちろん、\nシャッツキステで。",
            "zh": "到时候当然是\n在宝箱。",
            "narrator_zh": "神乐"
        },
        {
            "location": "843/ACT",
            "narrator": "",
            "text": "早く繋がりたいよ！",
            "zh": "想快点连上！",
            "narrator_zh": ""
        },
        {
            "location": "844/TALK",
            "narrator": "神楽",
            "text": "ふふ。\n私も同じ事を\n思ってますよ？",
            "zh": "呵呵。\n我也是这么\n想的哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "845/TALK",
            "narrator": "神楽",
            "text": "あなたは、みんなを支えて\nくれている素敵な人です。",
            "zh": "你是支撑着大家的\n很好的人。",
            "narrator_zh": "神乐"
        },
        {
            "location": "846/TALK",
            "narrator": "神楽",
            "text": "それに、今日は私も\n助けてもらっちゃったし。",
            "zh": "而且，今天我也\n被你帮了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "847/TALK",
            "narrator": "神楽",
            "text": "貴方のことを、みんなが\n好きになるの、少しだけ\nわかった気がします。",
            "zh": "大家会喜欢你，\n我好像有一点\n明白了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "848/TALK",
            "narrator": "神楽",
            "text": "…もし、これから先も\n私のことを見限らないで\nくれるなら。",
            "zh": "……要是以后\n也不放弃我\n的话。",
            "narrator_zh": "神乐"
        },
        {
            "location": "849/TALK",
            "narrator": "神楽",
            "text": "私も…今よりもっと、\n仲良くしたいです。",
            "zh": "我也……想比现在\n更要好。",
            "narrator_zh": "神乐"
        },
        {
            "location": "851/TALK",
            "narrator": "神楽",
            "text": "何にしても、今回は\nありがとうございました！",
            "zh": "不管怎样，这次\n谢谢你！",
            "narrator_zh": "神乐"
        },
        {
            "location": "852/TALK",
            "narrator": "神楽",
            "text": "お店まで足を運ぶの、\n大変じゃありません\nでしたか？",
            "zh": "特意跑到店里，\n不辛苦\n吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "853/SEL",
            "narrator": "（選択肢）",
            "text": "全然平気！",
            "zh": "完全没事！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "854/SEL",
            "narrator": "（選択肢）",
            "text": "ちょっと遠かった",
            "zh": "有点远",
            "narrator_zh": "（选项）"
        },
        {
            "location": "855/SEL",
            "narrator": "（選択肢）",
            "text": "それより、プリはどうすればいい？",
            "zh": "比起那个，大头贴怎么办？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "856/ACT",
            "narrator": "",
            "text": "全然平気！",
            "zh": "完全没事！",
            "narrator_zh": ""
        },
        {
            "location": "857/TALK",
            "narrator": "神楽",
            "text": "ふふ、安心しました♪",
            "zh": "呵呵，那我就放心了♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "858/TALK",
            "narrator": "神楽",
            "text": "あと、せっかく見つけて\nくれたのに、こんな事を\n言うのも何ですが――",
            "zh": "还有，你好不容易找到了，\n我说这种话\n也很那个——",
            "narrator_zh": "神乐"
        },
        {
            "location": "859/ACT",
            "narrator": "",
            "text": "ちょっと遠かった",
            "zh": "有点远",
            "narrator_zh": ""
        },
        {
            "location": "860/TALK",
            "narrator": "神楽",
            "text": "大変！\nそこまでして探しに\n来てくれたんですね。",
            "zh": "不得了！\n你做到这个地步\n来找了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "861/TALK",
            "narrator": "神楽",
            "text": "本当に\nありがとうございます！",
            "zh": "真的\n谢谢你！",
            "narrator_zh": "神乐"
        },
        {
            "location": "862/TALK",
            "narrator": "神楽",
            "text": "あと、せっかく見つけて\nくれたのに、こんな事を\n言うのも何ですが――",
            "zh": "还有，你好不容易找到了，\n我说这种话\n也很那个——",
            "narrator_zh": "神乐"
        },
        {
            "location": "863/ACT",
            "narrator": "",
            "text": "それより、プリはどうすればいい？",
            "zh": "比起那个，大头贴怎么办？",
            "narrator_zh": ""
        },
        {
            "location": "864/TALK",
            "narrator": "神楽",
            "text": "あ、はい。\nそのことなんですけど。",
            "zh": "啊，好的。\n就是这件事。",
            "narrator_zh": "神乐"
        },
        {
            "location": "865/TALK",
            "narrator": "神楽",
            "text": "せっかく見つけて\nくれたのに、こんな事を\n言うのもなんですが――",
            "zh": "你好不容易找到了，\n我说这种话\n也很那个——",
            "narrator_zh": "神乐"
        },
        {
            "location": "867/TALK",
            "narrator": "神楽",
            "text": "そのプリは\n貴方に差し上げます。",
            "zh": "那张大头贴\n送给你。",
            "narrator_zh": "神乐"
        },
        {
            "location": "868/TALK",
            "narrator": "神楽",
            "text": "私が持っていても、\nいつか……。",
            "zh": "我拿着的话，\n总有一天……",
            "narrator_zh": "神乐"
        },
        {
            "location": "869/TALK",
            "narrator": "神楽",
            "text": "いつか無くしちゃいそう\nですから。えへへ。",
            "zh": "总有一天会弄丢的。\n诶嘿嘿。",
            "narrator_zh": "神乐"
        },
        {
            "location": "870/TALK",
            "narrator": "神楽",
            "text": "私、お掃除苦手なんです！",
            "zh": "我打扫很不擅长！",
            "narrator_zh": "神乐"
        },
        {
            "location": "871/SEL",
            "narrator": "（選択肢）",
            "text": "ドヤ顔で言う？",
            "zh": "用得意脸说吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "872/ACT",
            "narrator": "",
            "text": "ドヤ顔で言う？",
            "zh": "用得意脸说吗？",
            "narrator_zh": ""
        },
        {
            "location": "874/TALK",
            "narrator": "神楽",
            "text": "っと、ごめんなさい。\nついつい長話を\nしちゃいましたね。",
            "zh": "啊，对不起。\n不知不觉\n说了很久。",
            "narrator_zh": "神乐"
        },
        {
            "location": "876/TALK",
            "narrator": "神楽",
            "text": "それでは、\nまたお逢いできる日まで。",
            "zh": "那么，\n直到我们再见面的那天。",
            "narrator_zh": "神乐"
        },
        {
            "location": "877/TALK",
            "narrator": "神楽",
            "text": "貴方と私に、\n素敵なココロの旅を！",
            "zh": "给你和我，\n一段美好的心之旅！",
            "narrator_zh": "神乐"
        },
        {
            "location": "880/DIALOG",
            "narrator": "",
            "text": "<color=green>【TRI-OS Plug-in:SYSTEM】</color>\n\n<color=red>回線が切断されました。</color>\n\nこのままお店の方に\nお戻しください。\n\nTRI-OS異世界間通信サービスの\nご利用、ありがとうございました。",
            "zh": "<color=green>【TRI-OS Plug-in:SYSTEM】</color>\n\n<color=red>线路已切断。</color>\n\n请就这样\n返回店内。\n\n感谢使用\nTRI-OS异世界间通信服务。",
            "narrator_zh": ""
        }
    ]
}
