{
    "dir": "chap36/daydra/dd_ch01_36_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "36105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "聖女＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "圣女＜后篇＞"
    },
    "entry": [
        {
            "location": "556/TALK",
            "narrator": "聖女つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "559/TALK",
            "narrator": "真幌",
            "text": "どうだ、調子は。",
            "zh": "怎么样，状况如何。",
            "narrator_zh": "真幌"
        },
        {
            "location": "562/TALK",
            "narrator": "真幌",
            "text": "検査の結果――",
            "zh": "检查结果——",
            "narrator_zh": "真幌"
        },
        {
            "location": "563/TALK",
            "narrator": "聖女つばめ",
            "text": "もういいよ、\n一人にして。",
            "zh": "够了，\n让我一个人待着。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "564/TALK",
            "narrator": "聖女つばめ",
            "text": "どうせわたし、もうすぐ\n死んじゃうんでしょ？",
            "zh": "反正我，马上\n就要死了吧？",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "565/TALK",
            "narrator": "聖女つばめ",
            "text": "だからもう、\n一人にして。",
            "zh": "所以，\n让我一个人待着。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "566/TALK",
            "narrator": "真幌",
            "text": "バカなことを言うな。",
            "zh": "别说傻话。",
            "narrator_zh": "真幌"
        },
        {
            "location": "568/TALK",
            "narrator": "聖女つばめ",
            "text": "だってこんな、\nわたしだけ…！",
            "zh": "可是这样，\n只有我……！",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "584/TALK",
            "narrator": "聖女つばめ",
            "text": "…今日は\n天気がいいね…。",
            "zh": "……今天\n天气真好啊。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "586/TALK",
            "narrator": "真幌",
            "text": "どうだ、調子は。",
            "zh": "怎么样，状况如何。",
            "narrator_zh": "真幌"
        },
        {
            "location": "590/TALK",
            "narrator": "聖女つばめ",
            "text": "…今は平気です。",
            "zh": "……现在没事。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "591/TALK",
            "narrator": "真幌",
            "text": "…そうか。\nなら少しやるか。",
            "zh": "……是吗。\n那稍微做一点吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "592/TALK",
            "narrator": "聖女つばめ",
            "text": "はい。先生。",
            "zh": "是。老师。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "610/TALK",
            "narrator": "真幌",
            "text": "人にはそれぞれ、\n正しいと思っている\nことがある。",
            "zh": "人各自，\n都有自己认为\n正确的事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "611/TALK",
            "narrator": "真幌",
            "text": "人が争っている場合、\nそのどちらかだけが\n悪いことはあまりない。",
            "zh": "人起了争执的时候，\n很少只有\n其中一方是错的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "612/TALK",
            "narrator": "真幌",
            "text": "特に国対国の場合は。",
            "zh": "尤其是国对国的时候。",
            "narrator_zh": "真幌"
        },
        {
            "location": "613/TALK",
            "narrator": "真幌",
            "text": "これに関わる場合、\n心構えが必要だ。",
            "zh": "要介入这件事，\n就需要心理准备。",
            "narrator_zh": "真幌"
        },
        {
            "location": "614/TALK",
            "narrator": "真幌",
            "text": "そのために\n何をすればいいか\nわかるか。",
            "zh": "为此\n该做什么，\n你知道吗。",
            "narrator_zh": "真幌"
        },
        {
            "location": "615/TALK",
            "narrator": "聖女つばめ",
            "text": "え…えっと…。",
            "zh": "呃……那个……。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "616/TALK",
            "narrator": "聖女つばめ",
            "text": "……すみません……。",
            "zh": "……对不起……。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "617/TALK",
            "narrator": "真幌",
            "text": "最低限、\n必ずすべきこと。",
            "zh": "最低限度，\n必须做的事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "618/TALK",
            "narrator": "真幌",
            "text": "それは双方の状況を\n自分で調べること。",
            "zh": "就是亲自去调查\n双方的状况。",
            "narrator_zh": "真幌"
        },
        {
            "location": "619/TALK",
            "narrator": "真幌",
            "text": "決して偏ってはならない。\n片方に情を寄せても\nいけない。",
            "zh": "绝不能偏颇。\n也不能对一方\n倾注私情。",
            "narrator_zh": "真幌"
        },
        {
            "location": "620/TALK",
            "narrator": "真幌",
            "text": "情は優しさではない。",
            "zh": "私情不是温柔。",
            "narrator_zh": "真幌"
        },
        {
            "location": "621/TALK",
            "narrator": "聖女つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "622/TALK",
            "narrator": "真幌",
            "text": "…誤解するな。\n優しさを捨てろと\n言っているわけではない。",
            "zh": "……别误会。\n我不是叫你\n丢掉温柔。",
            "narrator_zh": "真幌"
        },
        {
            "location": "623/TALK",
            "narrator": "聖女つばめ",
            "text": "あ、はい！",
            "zh": "啊，是！",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "624/TALK",
            "narrator": "真幌",
            "text": "話を戻そう。",
            "zh": "话拉回来。",
            "narrator_zh": "真幌"
        },
        {
            "location": "625/TALK",
            "narrator": "真幌",
            "text": "対立するどちらにも良い\n結果を出そうとする場合\n公平さが必要だ。",
            "zh": "想让对立的双方\n都得到好结果时，\n需要公平。",
            "narrator_zh": "真幌"
        },
        {
            "location": "626/TALK",
            "narrator": "真幌",
            "text": "どちらか一方に\n情をかければ公平さを\n失ってしまう。",
            "zh": "若对其中一方\n倾注私情，\n就会失去公平。",
            "narrator_zh": "真幌"
        },
        {
            "location": "627/TALK",
            "narrator": "真幌",
            "text": "そうすれば新たなる\n対立の火種になる。\n…わかるな？",
            "zh": "那样就会成为\n新的对立火种。\n……懂了吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "628/TALK",
            "narrator": "聖女つばめ",
            "text": "はい…！",
            "zh": "是……！",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "637/TALK",
            "narrator": "真幌",
            "text": "ヘーゲルの弁証法を\n知っているか？",
            "zh": "你知道\n黑格尔的辩证法吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "638/TALK",
            "narrator": "聖女つばめ",
            "text": "へーげる、の、\nべんしょうほう？",
            "zh": "黑……格尔的，\n辩经法？",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "639/TALK",
            "narrator": "聖女つばめ",
            "text": "何かを壊して\n弁償する時に\n使うものですか？",
            "zh": "是弄坏了什么，\n要赔偿的时候\n用的东西吗？",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "640/TALK",
            "narrator": "真幌",
            "text": "ぶは。",
            "zh": "噗。",
            "narrator_zh": "真幌"
        },
        {
            "location": "641/TALK",
            "narrator": "聖女つばめ",
            "text": "えっえっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "642/TALK",
            "narrator": "真幌",
            "text": "説明しようか。",
            "zh": "我来说明吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "643/TALK",
            "narrator": "真幌",
            "text": "物事を正しいと\n思っている側に立ち、\nそれを正とする。",
            "zh": "站在认为事情\n正确的那一侧，\n把它当作正。",
            "narrator_zh": "真幌"
        },
        {
            "location": "644/TALK",
            "narrator": "真幌",
            "text": "正とされる側と、\nその反とされる側とは\n思想が対立している。",
            "zh": "被当作正的一侧，\n和被当作反的一侧，\n思想是对立的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "645/TALK",
            "narrator": "真幌",
            "text": "しかし正とされる側の\n内部にも矛盾が\n含まれている。",
            "zh": "然而被当作正的一侧\n内部，也包含着\n矛盾。",
            "narrator_zh": "真幌"
        },
        {
            "location": "646/TALK",
            "narrator": "真幌",
            "text": "そして正の中の矛盾が反、\nすなわち対立組織を産む。",
            "zh": "然后正之中的矛盾生出反，\n也就是对立的组织。",
            "narrator_zh": "真幌"
        },
        {
            "location": "647/TALK",
            "narrator": "真幌",
            "text": "……ここまでは\nわかるな？",
            "zh": "……到这里，\n懂了吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "648/TALK",
            "narrator": "聖女つばめ",
            "text": "…うーん…どっちに\nついても完璧はないって\nことですか？",
            "zh": "……嗯……是说无论\n站哪一边，都没有完美，\n吗？",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "649/TALK",
            "narrator": "真幌",
            "text": "…いったんそれで\nよしとしよう。\nでは続きだ。",
            "zh": "……先姑且\n算你对了。\n那么继续。",
            "narrator_zh": "真幌"
        },
        {
            "location": "650/TALK",
            "narrator": "真幌",
            "text": "どんなに完璧に\n見えるものにも\n矛盾はある。",
            "zh": "无论看起来\n多么完美的东西，\n都有矛盾。",
            "narrator_zh": "真幌"
        },
        {
            "location": "651/TALK",
            "narrator": "真幌",
            "text": "その矛盾は反組織を\n産み出すが、単にそれを\n潰すのでは意味がない。",
            "zh": "那矛盾会生出反组织，\n但仅仅把它压垮，\n没有意义。",
            "narrator_zh": "真幌"
        },
        {
            "location": "652/TALK",
            "narrator": "真幌",
            "text": "なぜかわかるな？",
            "zh": "知道为什么吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "653/TALK",
            "narrator": "聖女つばめ",
            "text": "……根本の問題が\n解決されていないから、\n…ですよね…？",
            "zh": "……因为根本的问题\n没有解决，\n……所以吧……？",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "654/TALK",
            "narrator": "真幌",
            "text": "よしよし。",
            "zh": "好，好。",
            "narrator_zh": "真幌"
        },
        {
            "location": "655/TALK",
            "narrator": "真幌",
            "text": "ではどうする？",
            "zh": "那要怎么办？",
            "narrator_zh": "真幌"
        },
        {
            "location": "656/TALK",
            "narrator": "聖女つばめ",
            "text": "えっ！？\nどうしよう…。",
            "zh": "诶！？\n怎么办……。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "657/TALK",
            "narrator": "聖女つばめ",
            "text": "…どうすれば\nいいですか…？",
            "zh": "……该怎么办\n才好……？",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "658/TALK",
            "narrator": "真幌",
            "text": "正と反を徹底的に\n洗い出す。\nそして矛盾を突き止める。",
            "zh": "把正和反\n彻底梳理出来。\n然后找准矛盾。",
            "narrator_zh": "真幌"
        },
        {
            "location": "659/TALK",
            "narrator": "真幌",
            "text": "そうして至る解が合。\nそれがアウフヘーベンだ。",
            "zh": "这样达到的解答就是合。\n那就是扬弃。",
            "narrator_zh": "真幌"
        },
        {
            "location": "660/TALK",
            "narrator": "聖女つばめ",
            "text": "アウフヘーベン…。",
            "zh": "扬弃……。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "661/TALK",
            "narrator": "真幌",
            "text": "以上が\nヘーゲルの弁証法だ。\nどうだ、理解できたか？",
            "zh": "以上就是\n黑格尔的辩证法。\n怎么样，理解了吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "662/TALK",
            "narrator": "聖女つばめ",
            "text": "…ちょっと\n難しいです…。",
            "zh": "……有一点\n难……。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "663/TALK",
            "narrator": "真幌",
            "text": "確かにいきなりは\n難しいだろうな。",
            "zh": "一下子\n确实很难吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "664/TALK",
            "narrator": "聖女つばめ",
            "text": "はい……。",
            "zh": "是……。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "665/TALK",
            "narrator": "聖女つばめ",
            "text": "だから息抜きに\n音楽聞いても\nいいですか？",
            "zh": "所以能当作休息，\n让我听\n音乐吗？",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "666/TALK",
            "narrator": "真幌",
            "text": "調子がいいな。\n…病院には内緒だぞ。",
            "zh": "精神不错啊。\n……对医院保密哦。",
            "narrator_zh": "真幌"
        },
        {
            "location": "667/TALK",
            "narrator": "聖女つばめ",
            "text": "もちろんです！",
            "zh": "当然！",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "668/TALK",
            "narrator": "聖女つばめ",
            "text": "…どうしてここの人たちは\nわたしに何もさせて\nくれないんでしょう。",
            "zh": "……为什么这里的人\n什么都不让\n我做啊。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "669/TALK",
            "narrator": "真幌",
            "text": "…さあな。",
            "zh": "……谁知道。",
            "narrator_zh": "真幌"
        },
        {
            "location": "670/TALK",
            "narrator": "真幌",
            "text": "だがそれも逢瀬を\n大事に思っての\nことなんだろう。",
            "zh": "不过那也是\n因为把逢濑\n当回事吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "671/TALK",
            "narrator": "聖女つばめ",
            "text": "だったら音楽くらい\n自由に聞かせて\nくれても……。",
            "zh": "那样的话，至少音乐\n让我自由听\n也好啊……。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "672/TALK",
            "narrator": "真幌",
            "text": "それだよ。",
            "zh": "就是这个。",
            "narrator_zh": "真幌"
        },
        {
            "location": "673/TALK",
            "narrator": "聖女つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "674/TALK",
            "narrator": "真幌",
            "text": "ヘーゲルの弁証法の\n実例だ。",
            "zh": "黑格尔辩证法的\n实例。",
            "narrator_zh": "真幌"
        },
        {
            "location": "675/TALK",
            "narrator": "真幌",
            "text": "逢瀬が大事だから\n禁止事項を作る病院。",
            "zh": "因为逢濑重要，\n所以制定禁止事项的医院。",
            "narrator_zh": "真幌"
        },
        {
            "location": "676/TALK",
            "narrator": "真幌",
            "text": "大事だと言うなら\n音楽ぐらい好きにと\n不満を募らせる逢瀬。",
            "zh": "既然说重要，\n那至少让我喜欢听音乐——\n不满就堆积起来的逢濑。",
            "narrator_zh": "真幌"
        },
        {
            "location": "677/TALK",
            "narrator": "真幌",
            "text": "それぞれの理由を\n突き詰めていけば\n解と合に至る。",
            "zh": "把各自的理由\n追究下去，\n就会到达解答与合。",
            "narrator_zh": "真幌"
        },
        {
            "location": "678/TALK",
            "narrator": "真幌",
            "text": "そして\nアウフヘーベンたる\n「私」を生み出す。",
            "zh": "然后\n诞生作为扬弃的\n「我」。",
            "narrator_zh": "真幌"
        },
        {
            "location": "679/TALK",
            "narrator": "真幌",
            "text": "どうだ？",
            "zh": "怎么样？",
            "narrator_zh": "真幌"
        },
        {
            "location": "680/TALK",
            "narrator": "聖女つばめ",
            "text": "…どうだ、と\n言われても……。",
            "zh": "……你问怎么样，\n我也……。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "681/TALK",
            "narrator": "聖女つばめ",
            "text": "……わたしにはよく\nわからないです……。",
            "zh": "……我不太\n明白……。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "682/TALK",
            "narrator": "真幌",
            "text": "…そうか。\n今は難しいかも\nしれないな。",
            "zh": "……是吗。\n现在也许\n还难。",
            "narrator_zh": "真幌"
        },
        {
            "location": "683/TALK",
            "narrator": "真幌",
            "text": "だがこの先、きっと…。",
            "zh": "不过今后，一定……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "684/TALK",
            "narrator": "聖女つばめ",
            "text": "先生？",
            "zh": "老师？",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "685/TALK",
            "narrator": "真幌",
            "text": "いや、こちらの話だ。\n逢瀬はさっさと\n音楽を聴け。",
            "zh": "不，我自己的事。\n逢濑快去\n听音乐。",
            "narrator_zh": "真幌"
        },
        {
            "location": "686/TALK",
            "narrator": "聖女つばめ",
            "text": "えー。\nそんな言い方しなくても\nいいじゃないですかー。",
            "zh": "诶——。\n用不着那样\n说话吧——。",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "687/TALK",
            "narrator": "真幌",
            "text": "じゃあやめるか？",
            "zh": "那不做了？",
            "narrator_zh": "真幌"
        },
        {
            "location": "688/TALK",
            "narrator": "聖女つばめ",
            "text": "えっ！\nそれはいやです！\n聴かせてください！",
            "zh": "诶！\n那不行！\n请让我听！",
            "narrator_zh": "圣女燕"
        },
        {
            "location": "689/TALK",
            "narrator": "真幌",
            "text": "ははは。",
            "zh": "哈哈哈。",
            "narrator_zh": "真幌"
        },
        {
            "location": "549/DIALOG",
            "narrator": "NOTICE",
            "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n",
            "zh": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n尚未选择必须选项。\n\n<color=green>『STORY27：新·神乐』</color>\n请在其中做出选择后\n再次访问。\n",
            "narrator_zh": "NOTICE"
        },
        {
            "location": "553/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "数年前。\n静岡・某病院。",
            "zh": "数年以前。\n静冈·某医院。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "570/DIALOG",
            "narrator": "Dialog_Black",
            "text": "わたしの頭痛の原因は\nレディネスのインプラントにあるらしい。",
            "zh": "我头痛的原因，\n好像在于Readiness的植入。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "571/DIALOG",
            "narrator": "Dialog_Black",
            "text": "特異体質なので専門病院に、とだけ言われて\n知らない病院に連れて来られた。\nそれ以上の説明はなかった。",
            "zh": "只说因为特异体质要去专门医院，\n就被带到了不认识的医院。\n没有更多的说明。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "572/DIALOG",
            "narrator": "Dialog_Black",
            "text": "こちらからは家族に連絡を\n取ることすらできない。\nもっともできたとしても、\n所在地すらわからない。",
            "zh": "从这边甚至\n不能联系家人。\n就算能联系，\n连所在地都不知道。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "573/DIALOG",
            "narrator": "Dialog_Black",
            "text": "インプラント直後は\nそうでもなかった頭痛は、\n年を追うごとにひどくなっている。",
            "zh": "刚植入时\n还没这么厉害的头痛，\n一年年严重起来。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "594/DIALOG",
            "narrator": "Dialog_Black",
            "text": "東雲先生はわたしに\n勉強を教えてくれる先生。",
            "zh": "东云老师是\n教我学习的老师。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "595/DIALOG",
            "narrator": "Dialog_Black",
            "text": "ずっと入院している\nわたしのために来てくれている。",
            "zh": "是为了一直住院的\n我而来的。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "596/DIALOG",
            "narrator": "Dialog_Black",
            "text": "東雲先生はいつも優しかった。",
            "zh": "东云老师一直都很温柔。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "597/DIALOG",
            "narrator": "Dialog_Black",
            "text": "だけど、時折見せる真剣な表情は\nゾッとするほど冷たかった。",
            "zh": "可是，他偶尔露出的认真表情，\n冷得让人发怵。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "598/DIALOG",
            "narrator": "Dialog_Black",
            "text": "それから、勉強以外のことも\nたくさん教えてくれた。",
            "zh": "然后，学习以外的事\n也教了我很多。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "599/DIALOG",
            "narrator": "Dialog_Black",
            "text": "世界で生きていくために\n必要なこと、世の中の楽しいこと、\nそれから歌。",
            "zh": "在世上活下去需要的事，\n世上有趣的事，\n还有歌。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "600/DIALOG",
            "narrator": "Dialog_Black",
            "text": "勉強以外のことは全部、松果体肥大に\n悪影響があるとして医師から\n禁止されていたけれど。",
            "zh": "学习以外的事全都被禁止了，\n理由是对松果体肥大\n有不良影响。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "631/DIALOG",
            "narrator": "Dialog_Black",
            "text": "東雲先生が一番大事にしていたのは、\n自分自身の頭で考えること。",
            "zh": "东云老师最重视的，\n是用自己的头脑去思考。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "632/DIALOG",
            "narrator": "Dialog_Black",
            "text": "そのための知識であり教養である、と\n繰り返し教えられた。",
            "zh": "知识与教养是为了这个，\n他反复这样教导。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "633/DIALOG",
            "narrator": "Dialog_Black",
            "text": "――それは医師から禁止されている\n思想だったけれど。",
            "zh": "——虽然那是\n被医生禁止的思想。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "691/DIALOG",
            "narrator": "Dialog_Black",
            "text": "アウフヘーベンたる「わたし」。",
            "zh": "作为扬弃的「我」。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "692/DIALOG",
            "narrator": "Dialog_Black",
            "text": "多国籍企業群は、\nわたしという「反」を生み出した。\n「反」はまた、統一国家による矛盾だった。",
            "zh": "跨国企业群，\n生出了我这个「反」。\n「反」同时也是统一国家造成的矛盾。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "693/DIALOG",
            "narrator": "Dialog_Black",
            "text": "反は解を得て合に至る。",
            "zh": "反得到解答，到达合。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "694/DIALOG",
            "narrator": "Dialog_Black",
            "text": "いずれ多国籍国家は、\n弁証法によるアウフヘーベンによって\nわたしを再吸収するだろう。",
            "zh": "迟早，跨国国家会\n借由辩证法的扬弃，\n重新把我吸收回去吧。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "695/DIALOG",
            "narrator": "Dialog_Black",
            "text": "聖女であり、同時に\n聖女になり損ねた矛盾したわたしを。",
            "zh": "既是圣女，同时又\n没能成为圣女的、矛盾的我。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "707/DIALOG",
            "narrator": "Dialog_chapter_ch01",
            "text": "【30 綾水たちの沈黙】",
            "zh": "【30 绫水们的沉默】",
            "narrator_zh": "Dialog_chapter_ch01"
        }
    ]
}
