        },
        {
            "location": "53/ACT",
            "narrator": "",
            "text": "ええと？",
            "zh": "呃？",
            "narrator_zh": ""
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "何かしら？",
            "zh": "什么呀？",
            "narrator_zh": "加布里埃拉"
