        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ・・・",
            "zh": "嗯……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめ・・・新人のことなんだけど",
