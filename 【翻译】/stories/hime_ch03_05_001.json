            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "私、冷たくしてしまったのよ",
            "zh": "我对她太冷淡了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "ガブリエラ",
            "text": "あのこの言葉が嬉しくて",
            "zh": "那孩子的话让我高兴",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "46/TALK",
            "narrator": "ガブリエラ",
            "text": "とても嬉しかったから",
            "zh": "因为太高兴了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "とても冷たい言葉で返事をしてしまったの",
