    "entry": [
        {
            "location": "1635/TALK",
            "narrator": "神楽",
            "text": "…ただいま。",
            "zh": "……我回来了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1636/TALK",
            "narrator": "神楽",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1638/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1650/TALK",
            "narrator": "神楽",
            "text": "ちょっと",
            "zh": "那个",
            "narrator_zh": "神乐"
        },
        {
            "location": "1651/TALK",
            "narrator": "神楽",
            "text": "色々整理したいんです",
            "zh": "我想把各种思绪整理一下",
            "narrator_zh": "神乐"
        },
        {
            "location": "1652/TALK",
            "narrator": "神楽",
            "text": "付き合ってもらえますか？",
            "zh": "能陪我聊聊吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1654/SEL",
            "narrator": "",
            "text": "そのためにいるからね",
            "zh": "我就是为此才在的嘛",
            "narrator_zh": ""
        },
        {
            "location": "1655/ACT",
            "narrator": "",
            "text": "そのためにいるからね",
            "zh": "我就是为此才在的嘛",
            "narrator_zh": ""
        },
        {
            "location": "1660/TALK",
            "narrator": "神楽",
            "text": "まずは認めます",
            "zh": "首先我承认",
            "narrator_zh": "神乐"
        },
        {
            "location": "1661/TALK",
            "narrator": "神楽",
            "text": "ここ最近の私はつばめさんに対して",
            "zh": "最近这段时间的我对燕",
            "narrator_zh": "神乐"
        },
        {
            "location": "1662/TALK",
            "narrator": "神楽",
            "text": "悪くない印象を抱いています",
            "zh": "抱着不坏的印象",
            "narrator_zh": "神乐"
        },
        {
            "location": "1665/TALK",
            "narrator": "神楽",
            "text": "好意に近いかもしれません",
            "zh": "说不定已经接近好感了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1666/TALK",
            "narrator": "神楽",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "神乐"
        },
        {
            "location": "1667/TALK",
            "narrator": "神楽",
            "text": "それはこの日本を包むフェノメノンの中に存在するつばめさんです",
            "zh": "那也是存在于包裹着日本的PhenoMENON之中的燕",
            "narrator_zh": "神乐"
        },
        {
            "location": "1668/TALK",
            "narrator": "神楽",
            "text": "なので厳密には",
            "zh": "所以严格来说",
            "narrator_zh": "神乐"
        },
        {
            "location": "1669/TALK",
            "narrator": "神楽",
            "text": "つばめさんを好きというわけではないんです",
            "zh": "并不是说我喜欢燕",
            "narrator_zh": "神乐"
        },
        {
            "location": "1671/SEL",
            "narrator": "",
            "text": "今のつばめは好きって認めるんだ？",
            "zh": "也就是说你承认喜欢现在的燕咯？",
            "narrator_zh": ""
        },
        {
            "location": "1672/SEL",
            "narrator": "",
            "text": "自分に言い聞かせてる？",
            "zh": "你在说服自己吗？",
            "narrator_zh": ""
        },
        {
            "location": "1673/ACT",
            "narrator": "",
            "text": "今のつばめは好きって認めるんだ？",
            "zh": "也就是说你承认喜欢现在的燕咯？",
            "narrator_zh": ""
        },
        {
            "location": "1674/TALK",
            "narrator": "神楽",
            "text": "悪い印象を感じないだけです",
            "zh": "只是不觉得她给人印象坏而已",
            "narrator_zh": "神乐"
        },
        {
            "location": "1675/TALK",
            "narrator": "神楽",
            "text": "好きとは言ってません",
            "zh": "我没说过喜欢",
            "narrator_zh": "神乐"
        },
        {
            "location": "1676/ACT",
            "narrator": "",
            "text": "自分に言い聞かせてる？",
            "zh": "你在说服自己吗？",
            "narrator_zh": ""
        },
        {
            "location": "1678/TALK",
            "narrator": "神楽",
            "text": "決めつけるのはやめてください",
            "zh": "请不要擅自下定论",
            "narrator_zh": "神乐"
        },
        {
            "location": "1679/TALK",
            "narrator": "神楽",
            "text": "いい気分じゃないです",
            "zh": "让人心情很不愉快",
            "narrator_zh": "神乐"
        },
        {
            "location": "1681/TALK",
            "narrator": "神楽",
            "text": "とにかくそれで考えたんです",
            "zh": "总之，于是我思考了一下",
            "narrator_zh": "神乐"
        },
        {
            "location": "1682/TALK",
            "narrator": "神楽",
            "text": "繭が日本を包んでいる限り",
            "zh": "只要茧还包裹着日本",
            "narrator_zh": "神乐"
        },
        {
            "location": "1683/TALK",
            "narrator": "神楽",
            "text": "つばめさんは今のまま存在することができる",
            "zh": "燕就能保持现在的样子存在下去",
            "narrator_zh": "神乐"
        },
        {
            "location": "1684/TALK",
            "narrator": "神楽",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "神乐"
        },
        {
            "location": "1685/TALK",
            "narrator": "神楽",
            "text": "繭を破壊せずにつばめさんを今のまま残す方法",
            "zh": "不破坏茧、也能让燕保持现状……的方法",
            "narrator_zh": "神乐"
        },
        {
            "location": "1686/TALK",
            "narrator": "神楽",
            "text": "もしそんな方法があるなら",
            "zh": "如果真有那样的方法的话",
            "narrator_zh": "神乐"
        },
        {
            "location": "1688/SEL",
            "narrator": "",
            "text": "できるの！？",
            "zh": "做得到吗！？",
            "narrator_zh": ""
        },
        {
            "location": "1689/ACT",
            "narrator": "",
            "text": "できるの！？",
            "zh": "做得到吗！？",
            "narrator_zh": ""
        },
        {
            "location": "1692/TALK",
            "narrator": "神楽",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": "神乐"
        },
        {
            "location": "1694/TALK",
            "narrator": "神楽",
            "text": "自分で言っておいてなんですけど",
            "zh": "虽说这话是我自己提出来的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1695/TALK",
            "narrator": "神楽",
            "text": "無理な話でした",
            "zh": "果然是不可能的事",
            "narrator_zh": "神乐"
        },
        {
            "location": "1696/TALK",
            "narrator": "神楽",
            "text": "つばめさんの心を破壊しない限り",
            "zh": "只要不破坏燕的心",
            "narrator_zh": "神乐"
        },
        {
            "location": "1697/TALK",
            "narrator": "神楽",
            "text": "母を元に戻すことはできないですし",
            "zh": "母亲就无法恢复原状，而且",
            "narrator_zh": "神乐"
        },
        {
            "location": "1698/TALK",
            "narrator": "神楽",
            "text": "それに今のつばめさんは音羽を壊した",
            "zh": "再说现在的燕毁掉了音羽",
            "narrator_zh": "神乐"
        },
        {
            "location": "1699/TALK",
            "narrator": "神楽",
            "text": "その事実がある以上",
            "zh": "只要这个事实还在",
            "narrator_zh": "神乐"
        },
        {
            "location": "1700/TALK",
            "narrator": "神楽",
            "text": "ただのいい子とは思えません",
            "zh": "我就没法把她单纯当成一个好孩子",
            "narrator_zh": "神乐"
        },
        {
            "location": "1701/TALK",
            "narrator": "神楽",
            "text": "バカなことを言いました",
            "zh": "是我说了蠢话",
            "narrator_zh": "神乐"
        },
        {
            "location": "1703/SEL",
            "narrator": "",
            "text": "つばめは本当にいい子だよ",
            "zh": "燕真的是个好孩子哦",
            "narrator_zh": ""
        },
        {
            "location": "1704/SEL",
            "narrator": "",
            "text": "つばめを壊そうとしてるのに？",
            "zh": "你明明正打算毁掉燕？",
            "narrator_zh": ""
        },
        {
            "location": "1705/ACT",
            "narrator": "",
            "text": "つばめは本当にいい子だよ",
            "zh": "燕真的是个好孩子哦",
            "narrator_zh": ""
        },
        {
            "location": "1706/TALK",
            "narrator": "神楽",
            "text": "音羽を壊したのに？",
            "zh": "就算她毁掉了音羽也是吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1708/SEL",
            "narrator": "",
            "text": "本物のつばめのことだよ",
            "zh": "我说的是真正的燕哦",
            "narrator_zh": ""
        },
        {
            "location": "1709/ACT",
            "narrator": "",
            "text": "本物のつばめのことだよ",
            "zh": "我说的是真正的燕哦",
            "narrator_zh": ""
        },
        {
            "location": "1714/TALK",
            "narrator": "神楽",
            "text": "なんでそんなこと言うんですか？",
            "zh": "你为什么要说那种话？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1715/TALK",
            "narrator": "神楽",
            "text": "そうやって",
