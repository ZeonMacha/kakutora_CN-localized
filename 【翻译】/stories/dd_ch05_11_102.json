            "location": "1794/TALK",
            "narrator": "神楽",
            "text": "自分勝手だとしても",
            "zh": "就算自私也好",
            "narrator_zh": "神乐"
        },
        {
            "location": "1795/TALK",
            "narrator": "神楽",
            "text": "親友を破壊されて平気ではいられません！",
            "zh": "挚友被破坏了，我不可能无动于衷！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1797/SEL",
            "narrator": "",
            "text": "そもそも音羽はなんでドームにいたの？",
            "zh": "说到底，音羽为什么会在穹顶里？",
            "narrator_zh": ""
        },
        {
            "location": "1798/SEL",
            "narrator": "",
            "text": "ならもうなにも言わないよ",
            "zh": "那就什么都不说了哦",
            "narrator_zh": ""
        },
        {
            "location": "1799/ACT",
            "narrator": "",
            "text": "そもそも音羽はなんでドームにいたの？",
            "zh": "说到底，音羽为什么会在穹顶里？",
            "narrator_zh": ""
        },
        {
            "location": "1811/TALK",
            "narrator": "神楽",
            "text": "…わかってる。",
            "zh": "……我知道。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1812/TALK",
            "narrator": "神楽",
            "text": "音羽があそこにいたのは、\n私が原因だって…。",
            "zh": "音羽会在那里，\n原因在我……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1813/TALK",
            "narrator": "神楽",
            "text": "私が…音羽に任務のことを\n相談したから…。",
            "zh": "因为我……把任务的事\n跟音羽商量了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1814/TALK",
            "narrator": "神楽",
            "text": "そんなことしなければ、\n今も音羽は…。",
            "zh": "要是不做那种事，\n现在音羽也……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1815/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1816/TALK",
            "narrator": "神楽",
            "text": "ううん…それとこれとは、\n別の問題よね。",
            "zh": "不对……那件事和这件事，\n是两码事吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1817/TALK",
            "narrator": "神楽",
            "text": "例え音羽のことが\nなかったとしても…。",
            "zh": "就算没有音羽\n那件事……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1818/TALK",
            "narrator": "神楽",
            "text": "つばめさんを破壊する\n任務に変わりはないん\nだから。",
            "zh": "要破坏燕的\n任务也不会\n改变。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1820/TALK",
            "narrator": "神楽",
            "text": "…余計なことは\n考えたらダメ。",
            "zh": "……不能去想\n多余的事。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1821/TALK",
            "narrator": "神楽",
            "text": "私は…自分の任務の\nことだけを考えれば\nいいんだから…。",
            "zh": "我……只要想着\n自己的任务\n就好了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1822/ACT",
            "narrator": "",
            "text": "ならもうなにも言わないよ",
            "zh": "那就什么都不说了哦",
            "narrator_zh": ""
        },
        {
            "location": "1823/TALK",
            "narrator": "神楽",
            "text": "そうしてください",
            "zh": "请务必这样",
            "narrator_zh": "神乐"
        },
        {
            "location": "1824/TALK",
            "narrator": "神楽",
            "text": "こちらとしてもこれ以上心を乱されるのは",
            "zh": "我这边要是再被扰乱心神",
            "narrator_zh": "神乐"
        },
        {
            "location": "1825/TALK",
            "narrator": "神楽",
            "text": "本当に迷惑なんで",
            "zh": "实在太困扰了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1836/TALK",
            "narrator": "神楽",
            "text": "…つばめさんは、\n私にとってはただの\n破壊対象でしかない。",
            "zh": "……燕，\n对我来说只不过是\n破坏对象而已。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1837/TALK",
            "narrator": "神楽",
            "text": "それだけでいい…。\nそう思ってればいいの。",
            "zh": "那样就够了……。\n只要这么想就行了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1838/TALK",
            "narrator": "神楽",
            "text": "だから、そんな子を\n好きになったりは\nしない…。",
            "zh": "所以，那种孩子\n我是不会\n喜欢上的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1840/TALK",
            "narrator": "神楽",
            "text": "好きになったら、\nいけないんだから…。",
            "zh": "因为绝对不能\n喜欢上她啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1851/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【09 パーフェクトイエロー】",
            "zh": "【09 完美之黄】",
            "narrator_zh": "Dialog_chapter_ch05"
        },
        {
            "location": "1863/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【09 パーフェクトイエロー】",
            "zh": "【09 完美之黄】",
            "narrator_zh": "Dialog_chapter_ch05"
        }
    ]
}
