{
    "dir": "chap07/daydra/dd_ch03_07_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "7305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "リーダーに望むものは＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "对队长所期望的是＜后篇＞"
    },
    "entry": [
        {
            "location": "289/SCENARIO",
            "narrator": "",
            "text": "リーダーに望むものは",
            "zh": "对队长所期望的是",
            "narrator_zh": ""
        },
        {
            "location": "306/TALK",
            "narrator": "アーヤ",
            "text": "…大丈夫かしら？\n気が立ってるような\n声だったけど。",
            "zh": "……没问题吧？\n刚才她声音听起来\n好像有点焦躁。",
            "narrator_zh": "绫水"
        },
        {
            "location": "307/SEL",
            "narrator": "",
            "text": "ガブリエラが不満ダラダラだからフォローして",
            "zh": "加布里埃拉满肚子怨言，去安抚一下她",
            "narrator_zh": ""
        },
        {
            "location": "308/ACT",
            "narrator": "",
            "text": "ガブリエラが不満ダラダラだからフォローして",
            "zh": "加布里埃拉满肚子怨言，去安抚一下她",
            "narrator_zh": ""
        },
        {
            "location": "327/TALK",
            "narrator": "アーヤ",
            "text": "え！？",
            "zh": "咦！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "329/TALK",
            "narrator": "アーヤ",
            "text": "どうして！？",
            "zh": "为什么！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "330/TALK",
            "narrator": "アーヤ",
            "text": "作戦に不満があったのかしら？",
            "zh": "是对作战有什么不满吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "332/SEL",
            "narrator": "",
            "text": "言葉が足りない",
            "zh": "话没说到位",
            "narrator_zh": ""
        },
        {
            "location": "333/ACT",
            "narrator": "",
            "text": "言葉が足りない",
            "zh": "话没说到位",
            "narrator_zh": ""
        },
        {
            "location": "335/TALK",
            "narrator": "アーヤ",
            "text": "作戦はちゃんと伝えたでしょ？",
            "zh": "作战我已经好好传达给她了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "336/TALK",
            "narrator": "アーヤ",
            "text": "あれ以上",
            "zh": "除此之外",
            "narrator_zh": "绫水"
        },
        {
            "location": "337/TALK",
            "narrator": "アーヤ",
            "text": "何も言うことないわ",
            "zh": "没什么好说的了啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "339/SEL",
            "narrator": "",
            "text": "アーヤに頼ってもらいたんだよ",
            "zh": "她是想被绫水依赖啊",
            "narrator_zh": ""
        },
        {
            "location": "340/ACT",
            "narrator": "",
            "text": "アーヤに頼ってもらいたんだよ",
            "zh": "她是想被绫水依赖啊",
            "narrator_zh": ""
        },
        {
            "location": "342/TALK",
            "narrator": "アーヤ",
            "text": "頼ってる！",
            "zh": "我有依赖她啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "343/TALK",
            "narrator": "アーヤ",
            "text": "いつも",
            "zh": "一直都是",
            "narrator_zh": "绫水"
        },
        {
            "location": "344/TALK",
            "narrator": "アーヤ",
            "text": "一番信頼してるし",
            "zh": "我最信任她了",
            "narrator_zh": "绫水"
        },
        {
            "location": "346/SEL",
            "narrator": "",
            "text": "それ本人に言おう",
            "zh": "把那句话告诉她本人吧",
            "narrator_zh": ""
        },
        {
            "location": "347/ACT",
            "narrator": "",
            "text": "それ本人に言おう",
            "zh": "把那句话告诉她本人吧",
            "narrator_zh": ""
        },
        {
            "location": "349/TALK",
            "narrator": "アーヤ",
            "text": "何で！？",
            "zh": "为什么！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "350/TALK",
            "narrator": "アーヤ",
            "text": "恥ずかしいし",
            "zh": "怪不好意思的",
            "narrator_zh": "绫水"
        },
        {
            "location": "352/TALK",
            "narrator": "アーヤ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "绫水"
        },
        {
            "location": "354/TALK",
            "narrator": "アーヤ",
            "text": "そういうの得意じゃない",
            "zh": "我也不擅长这种事",
            "narrator_zh": "绫水"
        },
        {
            "location": "356/SEL",
            "narrator": "",
            "text": "リーダーなんでしょ？",
            "zh": "你不是队长吗？",
            "narrator_zh": ""
        },
        {
            "location": "357/ACT",
            "narrator": "",
            "text": "リーダーなんでしょ？",
            "zh": "你不是队长吗？",
            "narrator_zh": ""
        },
        {
            "location": "360/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "361/TALK",
            "narrator": "アーヤ",
            "text": "作戦成功が第一だし",
            "zh": "作战成功确实是第一位的",
            "narrator_zh": "绫水"
        },
        {
            "location": "362/TALK",
            "narrator": "アーヤ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "绫水"
        },
        {
            "location": "363/TALK",
            "narrator": "アーヤ",
            "text": "言葉にしなきゃ",
            "zh": "不说出口的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "364/TALK",
            "narrator": "アーヤ",
            "text": "伝わらないわね",
            "zh": "确实没法传达给对方呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "375/TALK",
            "narrator": "アーヤ",
            "text": "…どう伝えたら\nいいのかしら？",
            "zh": "……该怎么说\n才好呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "380/TALK",
            "narrator": "アーヤ",
            "text": "…ギャヴィ。\n一つ言い忘れてた。",
            "zh": "……加维。\n有件事我忘说了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "381/TALK",
            "narrator": "透明ガブリエラ",
            "text": "もう、なによ！？\nこっちは集中してるん\nだから！",
            "zh": "真是的，什么事啊！？\n我这边正集中精神\n呢！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "383/TALK",
            "narrator": "アーヤ",
            "text": "今回の作戦の成功は、\nギャヴィの肩に\n掛かってるわ。",
            "zh": "这次作战的成败，\n全都系在加维\n肩上了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "384/TALK",
            "narrator": "透明ガブリエラ",
            "text": "でしょうね。\n銃はあたしだけしか\n使えないものね？",
            "zh": "那是自然。\n毕竟能用枪的\n只有我一个嘛？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "385/TALK",
            "narrator": "アーヤ",
            "text": "銃が使えるから\n頼んだんじゃないわ。",
            "zh": "我不是因为你会用枪\n才拜托你的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "388/TALK",
            "narrator": "アーヤ",
            "text": "こんな重要な役目を\n任せられるのは――",
            "zh": "能把这么重要的任务\n托付出去的——",
            "narrator_zh": "绫水"
        },
        {
            "location": "389/TALK",
            "narrator": "アーヤ",
            "text": "一番信頼してる\nギャヴィしかいない\nって思ったからよ。",
            "zh": "我想来想去，只有\n我最信任的加维\n能胜任。",
            "narrator_zh": "绫水"
        },
        {
            "location": "390/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "393/TALK",
            "narrator": "アーヤ",
            "text": "…もう一度聞くけど、\nできる？",
            "zh": "……我再问一次，\n能做到吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "394/TALK",
            "narrator": "透明ガブリエラ",
            "text": "当然！\n任せておきなさい！",
            "zh": "当然！\n交给我吧！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "397/TALK",
            "narrator": "アーヤ",
            "text": "…ありがとう。",
            "zh": "……谢谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "402/TALK",
            "narrator": "アーヤ",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "414/TALK",
            "narrator": "アーヤ",
            "text": "これでいい？",
            "zh": "这样就行了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "416/SEL",
            "narrator": "",
            "text": "上出来",
            "zh": "干得漂亮",
            "narrator_zh": ""
        },
        {
            "location": "417/ACT",
            "narrator": "",
            "text": "上出来",
            "zh": "干得漂亮",
            "narrator_zh": ""
        },
        {
            "location": "419/TALK",
            "narrator": "アーヤ",
            "text": "そうかしら？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "422/SEL",
            "narrator": "",
            "text": "ギャヴィは素敵な結果を出すよ",
            "zh": "加维会交出漂亮的战果的",
            "narrator_zh": ""
        },
        {
            "location": "423/ACT",
            "narrator": "",
            "text": "ギャヴィは素敵な結果を出すよ",
            "zh": "加维会交出漂亮的战果的",
            "narrator_zh": ""
        },
        {
            "location": "425/TALK",
            "narrator": "アーヤ",
            "text": "そう",
            "zh": "是吗",
            "narrator_zh": "绫水"
        },
        {
            "location": "426/TALK",
            "narrator": "アーヤ",
            "text": "それなら",
            "zh": "那样的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "427/TALK",
            "narrator": "アーヤ",
            "text": "私も最大限尽くさないと",
            "zh": "我也必须全力以赴才行",
            "narrator_zh": "绫水"
        },
        {
            "location": "428/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ",
            "zh": "那么",
            "narrator_zh": "绫水"
        },
        {
            "location": "430/SEL",
            "narrator": "",
            "text": "待って、もう一つ",
            "zh": "等一下，还有一件事",
            "narrator_zh": ""
        },
        {
            "location": "431/ACT",
            "narrator": "",
            "text": "待って、もう一つ",
            "zh": "等一下，还有一件事",
            "narrator_zh": ""
        },
        {
            "location": "433/TALK",
            "narrator": "アーヤ",
            "text": "なに？",
            "zh": "什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "435/SEL",
            "narrator": "",
            "text": "凄く素敵だったよ、リーダーとして",
            "zh": "作为队长，刚刚非常棒哦",
            "narrator_zh": ""
        },
        {
            "location": "436/ACT",
            "narrator": "",
            "text": "凄く素敵だったよ、リーダーとして",
            "zh": "作为队长，刚刚非常棒哦",
            "narrator_zh": ""
        },
        {
            "location": "439/TALK",
            "narrator": "アーヤ",
            "text": "そう？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "440/TALK",
            "narrator": "アーヤ",
            "text": "よくわからないけど",
            "zh": "虽然不太明白",
            "narrator_zh": "绫水"
        },
        {
            "location": "443/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう",
            "zh": "谢谢",
            "narrator_zh": "绫水"
        },
        {
            "location": "455/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "457/TALK",
            "narrator": "アーヤ",
            "text": "よし、私も頑張ろう！",
            "zh": "好，我也要加油！",
            "narrator_zh": "绫水"
        },
        {
            "location": "468/DIALOG",
            "narrator": "Dialog_chapter_ch03",
            "text": "【05 金色の髪のカグラ】",
            "zh": "【05 金发的神乐】",
            "narrator_zh": "Dialog_chapter_ch03"
        }
    ]
}
