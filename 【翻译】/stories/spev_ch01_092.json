{
    "dir": "chap00/daydra/spev_ch01_092.js",
    "type": "",
    "info": {
        "story_id": "91034",
        "cid": "",
        "title": "ぴょんこのサマー大作戦♪",
        "sub_title": "ぴょんこのサマー大作戦♪④【つばめ編】",
        "title_zh": "蹦子的夏日大作战♪",
        "sub_title_zh": "蹦子的夏日大作战♪④【燕篇】"
    },
    "entry": [
        {
            "location": "19/DIALOG",
            "narrator": "",
            "text": "<color=green>7月23日　2:16 PM</color>\nとある休日の午後、都内某カフェにて。",
            "zh": "<color=green>7月23日　2:16 PM</color>\n某个假日的下午，都内某家咖啡店。",
            "narrator_zh": ""
        },
        {
            "location": "20/TALK",
            "narrator": "神楽",
            "text": "…最後の一本は、\n…から初めて、最後は…。",
            "zh": "……最后一格，\n从……开始，最后是……",
            "narrator_zh": "神乐"
        },
        {
            "location": "22/TALK",
            "narrator": "神楽",
            "text": "…………ふぅ。",
            "zh": "…………呼。",
            "narrator_zh": "神乐"
        },
        {
            "location": "24/TALK",
            "narrator": "神楽",
            "text": "よし…ネームだけど、\nとりあえず全部完成！",
            "zh": "好……分镜的话，\n总之全部完成了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "26/TALK",
            "narrator": "神楽",
            "text": "…途中、何度もネタに\n詰まって諦めかけて\nしまいましたけど。",
            "zh": "……中途好几次\n卡在点子上，\n差点放弃。",
            "narrator_zh": "神乐"
        },
        {
            "location": "27/TALK",
            "narrator": "神楽",
            "text": "でも、皆さんを観察して\nネタ集めしたおかげで、\nどうにか完成しました！",
            "zh": "不过，多亏观察大家\n收集了点子，\n总算完成了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "28/TALK",
            "narrator": "神楽",
            "text": "あとは家に帰ってから、\nＰＣで清書すれば…。",
            "zh": "之后回家，\n用电脑誊清就行……",
            "narrator_zh": "神乐"
        },
        {
            "location": "29/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "神乐"
        },
        {
            "location": "30/TALK",
            "narrator": "神楽",
            "text": "ふふっ…でも、\nまさか本当に\n描き切れるなんて…。",
            "zh": "呵呵……可是，\n没想到真的\n能画完……",
            "narrator_zh": "神乐"
        },
        {
            "location": "31/TALK",
            "narrator": "神楽",
            "text": "これなら、この次の\nイベントでは\nストーリー漫画も――",
            "zh": "这样的话，下次的\n活动里\n故事漫画也能——",
            "narrator_zh": "神乐"
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "あれ？",
            "zh": "咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "卯月さーん。",
            "zh": "卯月——。",
            "narrator_zh": "燕"
        },
        {
            "location": "37/TALK",
            "narrator": "神楽",
            "text": "えっ、つばめさん！？",
            "zh": "诶，燕！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "38/TALK",
            "narrator": "神楽",
            "text": "な、なんでこんな時に！？",
            "zh": "为、为什么偏偏这时候！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "43/TALK",
            "narrator": "つばめ",
            "text": "奇遇だね。\n卯月さんも\nお茶しに来てたの？",
            "zh": "好巧呀。\n卯月也是\n来喝茶的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "45/TALK",
            "narrator": "神楽",
            "text": "あ、えと…はい…。",
            "zh": "啊，那个……是的……",
            "narrator_zh": "神乐"
        },
        {
            "location": "46/TALK",
            "narrator": "つばめ",
            "text": "そうなんだ？\nここ、一緒に\n座ってもいい？",
            "zh": "是吗？\n这里，可以\n一起坐吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "神楽",
            "text": "あ、はい。\nもちろん――",
            "zh": "啊，好的。\n当然——",
            "narrator_zh": "神乐"
        },
        {
            "location": "49/TALK",
            "narrator": "神楽",
            "text": "って、いけない！\nノート隠さなきゃ！",
            "zh": "不对，糟了！\n得把笔记本藏起来！",
            "narrator_zh": "神乐"
        },
        {
            "location": "56/TALK",
            "narrator": "つばめ",
            "text": "あれ？\n今のノートって…。",
            "zh": "咦？\n刚才的笔记本……",
            "narrator_zh": "燕"
        },
        {
            "location": "57/TALK",
            "narrator": "神楽",
            "text": "さあ、どうぞ！\n早く座ってください！",
            "zh": "来，请坐！\n快坐下！",
            "narrator_zh": "神乐"
        },
        {
            "location": "59/TALK",
            "narrator": "つばめ",
            "text": "あ、うん…。",
            "zh": "啊，嗯……",
            "narrator_zh": "燕"
        },
        {
            "location": "72/TALK",
            "narrator": "つばめ",
            "text": "ごめんね。\nのんびりしてるところ\n邪魔しちゃったみたいで。",
            "zh": "对不起。\n你正悠闲着，\n好像被我打扰了。",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "神楽",
            "text": "いえ、そんなこと\nないですよ。",
            "zh": "不，没有\n那种事。",
            "narrator_zh": "神乐"
        },
        {
            "location": "74/TALK",
            "narrator": "神楽",
            "text": "つばめさんと一緒の\nティータイムなんて、\nむしろご褒美です！",
            "zh": "能和燕一起\n喝茶，\n反而是奖励！",
            "narrator_zh": "神乐"
        },
        {
            "location": "75/TALK",
            "narrator": "つばめ",
            "text": "ふふっ、卯月さんって\nいっつも面白いこと\n言うよね。",
            "zh": "呵呵，卯月\n总是说些\n有趣的话。",
            "narrator_zh": "燕"
        },
        {
            "location": "76/TALK",
            "narrator": "神楽",
            "text": "あはは…。",
            "zh": "啊哈哈……",
            "narrator_zh": "神乐"
        },
        {
            "location": "77/TALK",
            "narrator": "つばめ",
            "text": "ところで、さっき見てた\nノートだけど、\nあれって…。",
            "zh": "说起来，刚才看的\n笔记本，\n那个是……",
            "narrator_zh": "燕"
        },
        {
            "location": "78/TALK",
            "narrator": "神楽",
            "text": "ふ、復習です！",
            "zh": "复、复习！",
            "narrator_zh": "神乐"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "復習？",
            "zh": "复习？",
            "narrator_zh": "燕"
        },
        {
            "location": "80/TALK",
            "narrator": "神楽",
            "text": "そうなんです。\nこの前の授業の内容が\n難しかったので…。",
            "zh": "是的。\n上次课的内容\n很难……",
            "narrator_zh": "神乐"
        },
        {
            "location": "81/TALK",
            "narrator": "神楽",
            "text": "だから、お茶しながら\n見直そうかな、って\n思ってたんです。",
            "zh": "所以想边喝茶\n边再看\n一遍。",
            "narrator_zh": "神乐"
        },
        {
            "location": "82/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、あのノートは\n学校のノートだったの？",
            "zh": "那么，那本笔记本\n是学校的笔记本吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "84/TALK",
            "narrator": "神楽",
            "text": "そうです！\n普通の大学ノート\nだったでしょう？",
            "zh": "是的！\n就是普通的横格笔记本\n吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "85/TALK",
            "narrator": "つばめ",
            "text": "そうだったけど…。",
            "zh": "是那样……",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "つばめ",
            "text": "チラッとだけど、\n漫画が描いてあるように\n見えたんだけど…。",
            "zh": "虽然只瞥了一眼，\n看起来像画着\n漫画……",
            "narrator_zh": "燕"
        },
        {
            "location": "87/TALK",
            "narrator": "神楽",
            "text": "本当、授業が難しいと\n大変ですよね。",
            "zh": "真的，课一难\n就辛苦了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "う、うん…。",
            "zh": "嗯、嗯……",
            "narrator_zh": "燕"
        },
        {
            "location": "89/TALK",
            "narrator": "神楽",
            "text": "ネーム…もしかして\n見られたかも？",
            "zh": "分镜……难道\n被看见了？",
            "narrator_zh": "神乐"
        },
        {
            "location": "90/TALK",
            "narrator": "神楽",
            "text": "でも、全然聞いてこない\nってことは、見られて\nない可能性もありますね。",
            "zh": "可是，完全不问的话，\n也有可能\n没被看见。",
            "narrator_zh": "神乐"
        },
        {
            "location": "91/TALK",
            "narrator": "神楽",
            "text": "…うん、そうです…。\n絶対見られてないはず！",
            "zh": "……嗯，对……\n绝对没被看见！",
            "narrator_zh": "神乐"
        },
        {
            "location": "92/TALK",
            "narrator": "神楽",
            "text": "だって、見られないように\nすぐしまったんだし…。",
            "zh": "因为，为了不被看见\n我马上收起来了……",
            "narrator_zh": "神乐"
        },
        {
            "location": "93/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "燕"
        },
        {
            "location": "95/TALK",
            "narrator": "つばめ",
            "text": "もしかして、\n本当に勘違いなのかな？",
            "zh": "难道，\n真的是我看错了？",
            "narrator_zh": "燕"
        },
        {
            "location": "96/SEL",
            "narrator": "（選択肢）",
            "text": "ぴょんこ先生って言ってみよう",
            "zh": "试着叫一声蹦子老师",
            "narrator_zh": "（选项）"
        },
        {
            "location": "97/SEL",
            "narrator": "（選択肢）",
            "text": "神楽の薄い本",
            "zh": "神乐的薄本",
            "narrator_zh": "（选项）"
        },
        {
            "location": "98/SEL",
            "narrator": "（選択肢）",
            "text": "お絵かきの趣味はまだ秘密？",
            "zh": "画画的爱好还是秘密？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "99/ACT",
            "narrator": "",
            "text": "ぴょんこ先生って言ってみよう",
            "zh": "试着叫一声蹦子老师",
            "narrator_zh": ""
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "ぴょんこ先生？(´･ω･｀) ",
            "zh": "蹦子老师？(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "111/TALK",
            "narrator": "つばめ",
            "text": "なんで？(･Д･｀)",
            "zh": "为什么？(･Д･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "113/SEL",
            "narrator": "（選択肢）",
            "text": "神楽の反応見ればわかるはず",
            "zh": "看神乐的反应就知道了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "114/ACT",
            "narrator": "",
            "text": "神楽の反応見ればわかるはず",
            "zh": "看神乐的反应就知道了",
            "narrator_zh": ""
        },
        {
            "location": "116/TALK",
            "narrator": "つばめ",
            "text": "よくわからなぃけど",
            "zh": "我不太明白",
            "narrator_zh": "燕"
        },
        {
            "location": "117/TALK",
            "narrator": "つばめ",
            "text": "言ぅ通りにするね",
            "zh": "就照你说的做哦",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "つばめ",
            "text": "えっと…。",
            "zh": "那个……",
            "narrator_zh": "燕"
        },
        {
            "location": "124/TALK",
            "narrator": "つばめ",
            "text": "ぴょんこ先生！",
            "zh": "蹦子老师！",
            "narrator_zh": "燕"
        },
        {
            "location": "126/TALK",
            "narrator": "神楽",
            "text": "…………？",
            "zh": "…………？",
            "narrator_zh": "神乐"
        },
        {
            "location": "127/TALK",
            "narrator": "神楽",
            "text": "どうしたんですか？\n急に変なこと言って…。",
            "zh": "怎么了？\n突然说奇怪的话……",
            "narrator_zh": "神乐"
        },
        {
            "location": "129/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "131/TALK",
            "narrator": "つばめ",
            "text": "あ、ううん。\nなんでもないよ…。",
            "zh": "啊，不是。\n没什么……",
            "narrator_zh": "燕"
        },
        {
            "location": "132/TALK",
            "narrator": "つばめ",
            "text": "一応言ったけど…、\nどういうことなのかな？",
            "zh": "我是说了……\n这是什么意思呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "134/TALK",
            "narrator": "つばめ",
            "text": "$handle$さん、\n卯月さんのどんな反応を\n見たかったんだろ？",
            "zh": "$handle$，\n想看卯月的\n什么反应呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "135/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "神乐"
        },
        {
            "location": "137/TALK",
            "narrator": "神楽",
            "text": "よかった…。\nバレてないみたい。",
            "zh": "太好了……\n好像没被发现。",
            "narrator_zh": "神乐"
        },
        {
            "location": "138/TALK",
            "narrator": "神楽",
            "text": "スマホを弄ってたから、\nもしやと思って\n警戒しといてよかった…。",
            "zh": "你在摆弄手机，\n我有所提防，\n提防对了……",
            "narrator_zh": "神乐"
        },
        {
            "location": "139/ACT",
            "narrator": "",
            "text": "神楽の薄い本",
            "zh": "神乐的薄本",
            "narrator_zh": ""
        },
        {
            "location": "150/TALK",
            "narrator": "つばめ",
            "text": "薄ぃ本？",
            "zh": "薄本？",
            "narrator_zh": "燕"
        },
        {
            "location": "152/TALK",
            "narrator": "つばめ",
            "text": "なにそれ？(･Д･｀)",
            "zh": "那是什么？(･Д･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "154/SEL",
            "narrator": "（選択肢）",
            "text": "神楽に聞いてみて",
            "zh": "去问神乐看看",
            "narrator_zh": "（选项）"
        },
        {
            "location": "155/ACT",
            "narrator": "",
            "text": "神楽に聞いてみて",
            "zh": "去问神乐看看",
            "narrator_zh": ""
        },
        {
            "location": "157/TALK",
            "narrator": "つばめ",
            "text": "わかった",
            "zh": "知道了",
            "narrator_zh": "燕"
        },
        {
            "location": "158/TALK",
            "narrator": "つばめ",
            "text": "聞ぃてみるね",
            "zh": "我去问问哦",
            "narrator_zh": "燕"
        },
        {
            "location": "163/TALK",
            "narrator": "つばめ",
            "text": "あの、卯月さん。",
            "zh": "那个，卯月。",
            "narrator_zh": "燕"
        },
        {
            "location": "164/TALK",
            "narrator": "つばめ",
            "text": "薄ぃ本、って\nどんな本かな？",
            "zh": "薄本，\n是什么样的书呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "166/TALK",
            "narrator": "神楽",
            "text": "同人誌のことですね。\nつばめさんも、\n聞いたことありませんか？",
            "zh": "是同人志。\n燕也\n没听说过吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "167/TALK",
            "narrator": "神楽",
            "text": "自分で描いた作品を、\n自費で印刷して\n本にしたものです。",
            "zh": "把自己画的作品\n自费印刷\n做成的书。",
            "narrator_zh": "神乐"
        },
        {
            "location": "168/TALK",
            "narrator": "つばめ",
            "text": "あ、テレビで\n見たことある！",
            "zh": "啊，我在电视上\n见过！",
            "narrator_zh": "燕"
        },
        {
            "location": "169/TALK",
            "narrator": "つばめ",
            "text": "確か、有明で大きい\nイベントやるんだよね？",
            "zh": "记得是在有明\n办很大的活动吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "170/TALK",
            "narrator": "神楽",
            "text": "その通りです。",
            "zh": "正是如此。",
            "narrator_zh": "神乐"
        },
        {
            "location": "171/TALK",
            "narrator": "神楽",
            "text": "…で、それがどうか\nしたんですか？",
            "zh": "……所以，\n怎么了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "172/TALK",
            "narrator": "つばめ",
            "text": "え！？　あ、えっと…。",
            "zh": "诶！？　啊，那个……",
            "narrator_zh": "燕"
        },
        {
            "location": "173/TALK",
            "narrator": "つばめ",
            "text": "…聞いてみただけ、かな？",
            "zh": "……只是问问，吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "175/TALK",
            "narrator": "神楽",
            "text": "ふふっ、変なつばめさん。\n急にそんなこと\n聞いてくるなんて。",
            "zh": "呵呵，奇怪的燕。\n突然问\n这种事。",
            "narrator_zh": "神乐"
        },
        {
            "location": "176/TALK",
            "narrator": "つばめ",
            "text": "あ、あはは…そうだよね。",
            "zh": "啊、啊哈哈……说得也是。",
            "narrator_zh": "燕"
        },
        {
            "location": "177/TALK",
            "narrator": "つばめ",
            "text": "…$handle$さん、\nなんでこんなこと\n聞けって言ったのかな？",
            "zh": "……$handle$，\n为什么让我问\n这种事呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "178/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "神乐"
        },
        {
            "location": "179/TALK",
            "narrator": "神楽",
            "text": "ちょっと驚いたけど、\n多分バレてないとは…\n思いたいです…。",
            "zh": "虽然有点吃惊，\n我想大概\n没被发现……",
            "narrator_zh": "神乐"
        },
        {
            "location": "181/TALK",
            "narrator": "神楽",
            "text": "まさか、あのノートから\n同人誌を作ろうとしてる\nなんて思わないでしょう。",
            "zh": "总不会想到，\n我打算用那本笔记\n做同人志吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "182/ACT",
            "narrator": "",
            "text": "お絵かきの趣味はまだ秘密？",
            "zh": "画画的爱好还是秘密？",
            "narrator_zh": ""
        },
        {
            "location": "194/TALK",
            "narrator": "つばめ",
            "text": "ぉ絵かきの趣味？(･Д･｀)",
            "zh": "画画的爱好？(･Д･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "195/TALK",
            "narrator": "つばめ",
            "text": "卯月さん",
            "zh": "卯月",
            "narrator_zh": "燕"
        },
        {
            "location": "196/TALK",
            "narrator": "つばめ",
            "text": "絵を描くのが趣味なの？(・ω・`)",
            "zh": "画画是爱好吗？(・ω・`)",
            "narrator_zh": "燕"
        },
        {
            "location": "198/SEL",
            "narrator": "（選択肢）",
            "text": "聞いてみればわかるよ",
            "zh": "问一问就知道了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "199/ACT",
            "narrator": "",
            "text": "聞いてみればわかるよ",
            "zh": "问一问就知道了",
            "narrator_zh": ""
        },
        {
            "location": "201/TALK",
            "narrator": "つばめ",
            "text": "わかった",
            "zh": "知道了",
            "narrator_zh": "燕"
        },
        {
            "location": "202/TALK",
            "narrator": "つばめ",
            "text": "ちょっと聞ぃてみる(*´︶`*)",
            "zh": "我去问一下(*´︶`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "208/TALK",
            "narrator": "つばめ",
            "text": "…あの、卯月さん。\nちょっと聞きたいことが\nあるんだけど。",
            "zh": "……那个，卯月。\n有件事\n想问你。",
            "narrator_zh": "燕"
        },
        {
            "location": "210/TALK",
            "narrator": "神楽",
            "text": "なんでしょう？",
            "zh": "什么事？",
            "narrator_zh": "神乐"
        },
        {
            "location": "211/TALK",
            "narrator": "つばめ",
            "text": "うん…卯月さんの\n趣味って、\nもしかして――",
            "zh": "嗯……卯月的\n爱好，\n难道是——",
            "narrator_zh": "燕"
        },
        {
            "location": "212/TALK",
            "narrator": "神楽",
            "text": "ラノベを読むことです。",
            "zh": "是读轻小说。",
            "narrator_zh": "神乐"
        },
        {
            "location": "214/TALK",
            "narrator": "つばめ",
            "text": "えっ？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "215/TALK",
            "narrator": "神楽",
            "text": "忘れちゃったんですか？",
            "zh": "你忘了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "216/TALK",
            "narrator": "神楽",
            "text": "私がラノベ好きなの、\n前に電車の中で\n話したじゃないですか。",
            "zh": "我喜欢轻小说，\n以前在电车上\n说过的吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "217/TALK",
            "narrator": "つばめ",
            "text": "あ…そっか。\nそういえば言ってたよね？",
            "zh": "啊……对哦。\n说起来是说过吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "218/TALK",
            "narrator": "神楽",
            "text": "ふふっ、思い出してくれて\nよかったです。",
            "zh": "呵呵，你想起来了\n就好。",
            "narrator_zh": "神乐"
        },
        {
            "location": "219/TALK",
            "narrator": "つばめ",
            "text": "あはは…。",
            "zh": "啊哈哈……",
            "narrator_zh": "燕"
        },
        {
            "location": "220/TALK",
            "narrator": "つばめ",
            "text": "…じゃあ、どうして\n$handle$さんは\nあんなこと言ったのかな？",
            "zh": "……那么，为什么\n$handle$\n会说那种话呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "221/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "神乐"
        },
        {
            "location": "222/TALK",
            "narrator": "神楽",
            "text": "まさか、趣味の話題から\n探ろうしてくるとは\n思わなかったわ。",
            "zh": "没想到会从爱好\n这个话题\n来试探。",
            "narrator_zh": "神乐"
        },
        {
            "location": "223/TALK",
            "narrator": "神楽",
            "text": "スマホを弄ってたから\n一応警戒してたけど…、\n正解だったみたい。",
            "zh": "你在摆弄手机，\n我有所提防……\n看来是对的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "226/TALK",
            "narrator": "つばめ",
            "text": "あ、そういえば、\n明日だよね？",
            "zh": "啊，说起来，\n是明天吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "227/TALK",
            "narrator": "神楽",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "神乐"
        },
        {
            "location": "229/TALK",
            "narrator": "つばめ",
            "text": "卯月さん、\n忘れちゃったの？",
            "zh": "卯月，\n你忘了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "231/TALK",
            "narrator": "つばめ",
            "text": "わたしに秋葉原を\n案内してくれる、って\n約束のことだよ。",
            "zh": "说好带我\n去秋叶原逛的\n那件事。",
            "narrator_zh": "燕"
        },
        {
            "location": "233/TALK",
            "narrator": "神楽",
            "text": "あ、ああ、はい！\n大丈夫です、\n覚えてますよ。",
            "zh": "啊、啊啊，是的！\n没事，\n我记得。",
            "narrator_zh": "神乐"
        },
        {
            "location": "234/TALK",
            "narrator": "神楽",
            "text": "私もとっても楽しみに\nしてましたからね。",
            "zh": "我也很\n期待。",
            "narrator_zh": "神乐"
        },
        {
            "location": "235/TALK",
            "narrator": "つばめ",
            "text": "えへへ、どんなお店に\n連れてってもらえるのか、\nとっても楽しみだよ。",
            "zh": "诶嘿嘿，会带我去\n什么样的店，\n我非常期待。",
            "narrator_zh": "燕"
        },
        {
            "location": "236/TALK",
            "narrator": "神楽",
            "text": "ふふっ…私もです。",
            "zh": "呵呵……我也是。",
            "narrator_zh": "神乐"
        },
        {
            "location": "237/TALK",
            "narrator": "神楽",
            "text": "案内したお店で、\nつばめさんがどんな\n反応をするのか…。",
            "zh": "在我带路的店里，\n燕会是\n什么反应……",
            "narrator_zh": "神乐"
        },
        {
            "location": "238/TALK",
            "narrator": "神楽",
            "text": "想像するだけで、\nワクワクしてきます！",
            "zh": "光是想象，\n就兴奋起来了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "239/TALK",
            "narrator": "つばめ",
            "text": "…普通のお店だよね？",
            "zh": "……是普通的店吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "240/TALK",
            "narrator": "神楽",
            "text": "はい。合法的に営業を\nしている、普通のお店に\n案内しますからね。",
            "zh": "是的。我会带你去\n合法营业的\n普通店。",
            "narrator_zh": "神乐"
        },
        {
            "location": "242/TALK",
            "narrator": "つばめ",
            "text": "そういう意味の普通か\nどうか聞いたわけじゃ\nないのにぃ…。",
            "zh": "我问的又不是\n那种意思的普通\n呀……",
            "narrator_zh": "燕"
        }
    ]
}
