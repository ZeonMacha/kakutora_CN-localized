{
    "dir": "chap16/daydra/dd_ch02_16_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "16256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "写真の無いメニュー",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "没有照片的菜单"
    },
    "entry": [
        {
            "location": "345/SCENARIO",
            "narrator": "",
            "text": "写真の無いメニュー",
            "zh": "没有照片的菜单",
            "narrator_zh": ""
        },
        {
            "location": "359/TALK",
            "narrator": "アーヤ",
            "text": "う～ん…。",
            "zh": "唔～嗯……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "361/TALK",
            "narrator": "みやび",
            "text": "どうかしたが？",
            "zh": "怎么了喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "363/TALK",
            "narrator": "アーヤ",
            "text": "ここのカフェだけど、\nいきなり入ったのは\n間違いだったみたい…。",
            "zh": "这家咖啡馆，\n二话不说就进来\n看来是个错误……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "364/TALK",
            "narrator": "みやび",
            "text": "気に入らないところでも\nあるんか？",
            "zh": "是有么子不满意的\n地方喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "365/TALK",
            "narrator": "みやび",
            "text": "うちには問題があるとは\n思えんけんど？",
            "zh": "我倒不觉得有么子\n问题啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "366/TALK",
            "narrator": "アーヤ",
            "text": "メニューを見て。\n写真が載ってないでしょ？",
            "zh": "你看菜单。\n上面没有附照片吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "367/TALK",
            "narrator": "アーヤ",
            "text": "こういうカフェはね、\n普通のメニューに見える\nけど――",
            "zh": "这种咖啡馆呢，\n虽然菜单看着\n很普通――",
            "narrator_zh": "绫水"
        },
        {
            "location": "368/TALK",
            "narrator": "アーヤ",
            "text": "注文すると、店独自の\nアレンジがされた物が\n出てくることがあるのよ。",
            "zh": "但点单之后，有时会\n端出经过店家独自\n改良的东西哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "370/TALK",
            "narrator": "みやび",
            "text": "…ゲテモノか？",
            "zh": "……黑暗料理吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "371/TALK",
            "narrator": "アーヤ",
            "text": "そこまで酷くはないわ。\n基本的に美味しくは\nあるんだけど――",
            "zh": "倒也没那么夸张。\n基本上还是\n挺好吃的，不过――",
            "narrator_zh": "绫水"
        },
        {
            "location": "372/TALK",
            "narrator": "アーヤ",
            "text": "求めてた味とは違うから、\nどうしてもガッカリ\nしちゃうの…。",
            "zh": "和原本期待的味道不一样，\n难免还是会\n感到失望……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "373/TALK",
            "narrator": "みやび",
            "text": "そんなこともあるんか…。\nさすが、カフェについて\n詳しいんやね。",
            "zh": "还有这种事喃……。\n不愧是你，对咖啡馆\n蛮了解咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "374/TALK",
            "narrator": "アーヤ",
            "text": "そういうわけだから、\n注文が決まったら教えて。",
            "zh": "就是这么回事，所以\n你决定好点什么了告诉我。",
            "narrator_zh": "绫水"
        },
        {
            "location": "375/TALK",
            "narrator": "アーヤ",
            "text": "一度店員さんに\n確認するから…。",
            "zh": "我先找店员\n确认一下……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "376/TALK",
            "narrator": "みやび",
            "text": "いや、その必要は\nないちや。",
            "zh": "不用，没得那个\n必要咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "377/TALK",
            "narrator": "みやび",
            "text": "ちょっと面白そうやき、\n今日は確認を取らんで\n注文してみんか？",
            "zh": "听起来蛮有意思啵，\n今天不找店员确认，\n直接点点看喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "378/TALK",
            "narrator": "アーヤ",
            "text": "何でそんなことしなきゃ\nならないのよ？",
            "zh": "为什么非得\n这么做不可啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "379/TALK",
            "narrator": "みやび",
            "text": "ロシアンルーレット\nみたいで楽しいと\n思わん？",
            "zh": "不觉得像俄罗斯轮盘\n一样蛮好玩的\n吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "380/TALK",
            "narrator": "みやび",
            "text": "何が出てくるかわからん\n注文なんて、どこでも\nできることやないし。",
            "zh": "不晓得会端出么子来的\n点单，可不是哪儿都能\n体验到的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "381/TALK",
            "narrator": "アーヤ",
            "text": "…そんな風に思ったこと、\n一度もなかったわ。",
            "zh": "……我从来没这么\n想过呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "382/TALK",
            "narrator": "みやび",
            "text": "元のより美味しい物が\n出てこんとも言えんの\nやし――",
            "zh": "说不定还会端出比原版\n更好吃的来\n啵――",
            "narrator_zh": "雅"
        },
        {
            "location": "384/TALK",
            "narrator": "みやび",
            "text": "新しい出会いを求めて\n冒険するんも、えいこと\nやと思うんよ。",
            "zh": "去寻找新的邂逅，\n冒险一哈也是蛮好的事\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "385/TALK",
            "narrator": "アーヤ",
            "text": "…そうね。\nそういう楽しみも、\nカフェならではだし――",
            "zh": "……也是呢。\n这种乐趣也只有\n咖啡馆才体验得到――",
            "narrator_zh": "绫水"
        },
        {
            "location": "386/TALK",
            "narrator": "アーヤ",
            "text": "今日は聞かないで\n注文してみようかしら？",
            "zh": "今天就不提前打听，\n直接点单试试看好了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "389/TALK",
            "narrator": "みやび",
            "text": "それがえいよ。\nさてと、うちは何を\n注文しよう…。",
            "zh": "这样才对啵。\n好了，我要点么子\n好呢……。",
            "narrator_zh": "雅"
        },
        {
            "location": "390/TALK",
            "narrator": "アーヤ",
            "text": "…私は、何にしよう\nかしら？",
            "zh": "……那我点什么\n好呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "393/TALK",
            "narrator": "アーヤ",
            "text": "注文するとは言ったけど、\nいざするとなると、\nやっぱり勇気がいるわね。",
            "zh": "话是说直接点单，\n可真到要选的时候，\n果然还是需要勇气的呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "394/TALK",
            "narrator": "アーヤ",
            "text": "…どうしよう。\nどれを選べばいいか\nわからなくなってきたわ。",
            "zh": "……怎么办。\n变得越来越不晓得\n该选哪个好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "403/TALK",
            "narrator": "アーヤ",
            "text": "相談があるの",
            "zh": "有事想找你商量",
            "narrator_zh": "绫水"
        },
        {
            "location": "404/TALK",
            "narrator": "アーヤ",
            "text": "今、メニューに写真の無いカフェで、何を注文すればいいか悩んでるんだけど",
            "zh": "现在在一家菜单没照片的咖啡馆里，正纠结该点什么好呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "405/TALK",
            "narrator": "アーヤ",
            "text": "どれにしたらいいと思う？",
            "zh": "你觉得点哪个好？",
            "narrator_zh": "绫水"
        },
        {
            "location": "407/SEL",
            "narrator": "",
            "text": "クリームソーダにしよう",
            "zh": "点奶油苏打吧",
            "narrator_zh": ""
        },
        {
            "location": "408/SEL",
            "narrator": "",
            "text": "ホットケーキかな？",
            "zh": "松饼怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "409/SEL",
            "narrator": "",
            "text": "パスタ系は？",
            "zh": "意面之类的呢？",
            "narrator_zh": ""
        },
        {
            "location": "410/ACT",
            "narrator": "",
            "text": "クリームソーダにしよう",
            "zh": "点奶油苏打吧",
            "narrator_zh": ""
        },
        {
            "location": "411/TALK",
            "narrator": "アーヤ",
            "text": "クリームソーダね",
            "zh": "奶油苏打啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "412/TALK",
            "narrator": "アーヤ",
            "text": "ちょっとドキドキするけど、それにしてみるわ",
            "zh": "虽然有点忐忑，就点那个试试吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "418/TALK",
            "narrator": "アーヤ",
            "text": "決めた。\n私はクリームソーダを\n注文するわ。",
            "zh": "决定了。\n我要点一份\n奶油苏打。",
            "narrator_zh": "绫水"
        },
        {
            "location": "421/TALK",
            "narrator": "みやび",
            "text": "無難過ぎてつまらんな。",
            "zh": "太稳妥了没意思嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "422/TALK",
            "narrator": "アーヤ",
            "text": "そんなことないわ。",
            "zh": "才没那回事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "423/TALK",
            "narrator": "アーヤ",
            "text": "上に載ってるアイスが\nバニラじゃないかも\nしれないし――",
            "zh": "上面放的冰淇淋\n说不定不是\n香草味的――",
            "narrator_zh": "绫水"
        },
        {
            "location": "424/TALK",
            "narrator": "アーヤ",
            "text": "ソフトクリームが\n乗ってる可能性も\nあるでしょ？",
            "zh": "也有可能放的是\n软冰淇淋\n对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "425/TALK",
            "narrator": "みやび",
            "text": "ソフトクリームの載った\nクリームソーダは、\n珍しくないと思うけんど？",
            "zh": "上面放软冰淇淋的\n奶油苏打，我倒觉得\n不算稀奇咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "427/TALK",
            "narrator": "アーヤ",
            "text": "私、あれって苦手なの。\n全身がキンと冷えて…。",
            "zh": "我其实不太擅长吃那个。\n感觉浑身都会被冰得发凉……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "428/TALK",
            "narrator": "みやび",
            "text": "なるほど…。\nじゃあ、店員さん呼んで\nえいか？",
            "zh": "原来如此……。\n那，可以叫店员过来\n了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "429/TALK",
            "narrator": "アーヤ",
            "text": "ええ、お願い。",
            "zh": "嗯，麻烦你了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "431/TALK",
            "narrator": "アーヤ",
            "text": "…さてと、どういうのが\n出てくるやら…。",
            "zh": "……好了，究竟会\n端出什么样的来呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "438/TALK",
            "narrator": "ウェイトレス",
            "text": "注文の品は以上ですね？\nどうぞ、ごゆっくり…。",
            "zh": "您点的餐品齐了对吧？\n请慢用……。",
            "narrator_zh": "女服务员"
        },
        {
            "location": "441/TALK",
            "narrator": "アーヤ",
            "text": "…こう来たかぁ。",
            "zh": "……居然是这招啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "442/TALK",
            "narrator": "みやび",
            "text": "メロンソーダやない\nクリームソーダって、\n初めて見たぞね。",
            "zh": "不是哈密瓜苏打的\n奶油苏打，我还是\n头一回见啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "443/TALK",
            "narrator": "みやび",
            "text": "薄く赤いみたいやけんど、\nそれ、何のソーダなが？",
            "zh": "看起来带点浅红色啵，\n那是什么苏打水喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "444/TALK",
            "narrator": "アーヤ",
            "text": "う～ん…香りからすると、\nイチゴじゃないかしら？",
            "zh": "唔～嗯……从香气来看，\n莫非是草莓味的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "445/TALK",
            "narrator": "アーヤ",
            "text": "アイスはバニラアイス\nみたいだけど…。",
            "zh": "冰淇淋倒是普通的\n香草冰淇淋……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "446/TALK",
            "narrator": "みやび",
            "text": "まあ、許容範囲では\nありそうやね。",
            "zh": "嘛，看起来倒是在\n能接受的范围里咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "447/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\nとりあえず一口…。",
            "zh": "是啊。\n总之先尝一口……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "448/TALK",
            "narrator": "アーヤ",
            "text": "……あれ？",
            "zh": "……咦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "449/TALK",
            "narrator": "アーヤ",
            "text": "これ、美味しいかも。",
            "zh": "这个，还挺好喝的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "450/TALK",
            "narrator": "みやび",
            "text": "おっ、当たりやったか？",
            "zh": "哦，中大奖了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "451/TALK",
            "narrator": "アーヤ",
            "text": "ええ、ちょっと自分でも\nビックリだけど、\n凄く美味しいわ。",
            "zh": "嗯，连我自己都有点\n惊讶，不过真的\n非常好喝。",
            "narrator_zh": "绫水"
        },
        {
            "location": "452/TALK",
            "narrator": "アーヤ",
            "text": "ほら、みやびも一口\n飲んでみて。",
            "zh": "来，雅你也喝一口\n试试。",
            "narrator_zh": "绫水"
        },
        {
            "location": "453/TALK",
            "narrator": "みやび",
            "text": "ん……。",
            "zh": "嗯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "455/TALK",
            "narrator": "みやび",
            "text": "おぉっ！？\nこれは絶品ぞね！",
            "zh": "哦哦！？\n这个绝对是极品啵！",
            "narrator_zh": "雅"
        },
        {
            "location": "456/TALK",
            "narrator": "アーヤ",
            "text": "ね？　ビックリでしょ？",
            "zh": "对吧？　很惊讶吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "457/TALK",
            "narrator": "アーヤ",
            "text": "クリームソーダは\nメロンソーダ以外は\n絶対無いと思ったけど――",
            "zh": "我本来还以为\n奶油苏打除了哈密瓜苏打\n绝对没有别的呢――",
            "narrator_zh": "绫水"
        },
        {
            "location": "458/TALK",
            "narrator": "アーヤ",
            "text": "これは新たな発見ね。\nまた飲みに来ないと。",
            "zh": "这可真是新发现呢。\n下次还得再来喝。",
            "narrator_zh": "绫水"
        },
        {
            "location": "459/TALK",
            "narrator": "みやび",
            "text": "うちの言うた通り、\n冒険して正解やったね。",
            "zh": "跟我说的一样，\n冒险一次真是对咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "460/TALK",
            "narrator": "アーヤ",
            "text": "ええ。",
            "zh": "嗯。",
            "narrator_zh": "绫水"
        },
        {
            "location": "461/TALK",
            "narrator": "アーヤ",
            "text": "…ところで、冒険しろと\n言ったあなたは何を\n食べてるのかしら？",
            "zh": "……话说回来，叫我\n去冒险的你，自己\n正在吃什么呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "462/TALK",
            "narrator": "みやび",
            "text": "ん？　ハムとチーズの\nサンドイッチやけんど？",
            "zh": "嗯？　火腿芝士\n三明治咯，怎么了？",
            "narrator_zh": "雅"
        },
        {
            "location": "464/TALK",
            "narrator": "アーヤ",
            "text": "…冒険しなさいよ。",
            "zh": "……你也给我去冒险啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "481/ACT",
            "narrator": "",
            "text": "ホットケーキかな？",
            "zh": "松饼怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "482/TALK",
            "narrator": "アーヤ",
            "text": "いいわね、それ",
            "zh": "那个不错呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "483/TALK",
            "narrator": "アーヤ",
            "text": "安心して注文できそう",
            "zh": "感觉可以放心地去点",
            "narrator_zh": "绫水"
        },
        {
            "location": "487/TALK",
            "narrator": "アーヤ",
            "text": "私、ホットケーキと\n紅茶にするわ。",
            "zh": "我点一份松饼\n和红茶吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "489/TALK",
            "narrator": "みやび",
            "text": "なるほど、それはえい\n考えやね。",
            "zh": "原来如此，这主意\n蛮好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "491/TALK",
            "narrator": "みやび",
            "text": "ホットケーキなら、\nちっくとアレンジ入っても\nまず間違いはないき。",
            "zh": "松饼的话，就算\n稍微加一哈改良，\n基本也不会出错啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "492/TALK",
            "narrator": "アーヤ",
            "text": "そういうこと。\nみやびも決まったなら、\n注文するわよ？",
            "zh": "正是如此。\n雅你也决定好了的话，\n我这就点单咯？",
            "narrator_zh": "绫水"
        },
        {
            "location": "497/TALK",
            "narrator": "ウェイトレス",
            "text": "注文の品は以上ですね？\nどうぞ、ごゆっくり…。",
            "zh": "您点的餐品齐了对吧？\n请慢用……。",
            "narrator_zh": "女服务员"
        },
        {
            "location": "499/TALK",
            "narrator": "みやび",
            "text": "…甘そうやね。",
            "zh": "……看起来蛮甜咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "500/TALK",
            "narrator": "アーヤ",
            "text": "チョコアイスの載った\nホットケーキは、\n初めて見たわ。",
            "zh": "放了巧克力冰淇淋的\n松饼，我还是\n头一回见呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "501/TALK",
            "narrator": "アーヤ",
            "text": "普通はメープルシロップか\nチョコソース辺りだと\n思うし…。",
            "zh": "一般不都是配枫糖浆\n或者巧克力酱\n之类的嘛……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "502/TALK",
            "narrator": "みやび",
            "text": "けんど、そんなに\n驚いてはいないようやね？",
            "zh": "不过，你好像没怎么\n吃惊咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "503/TALK",
            "narrator": "アーヤ",
            "text": "チョコソースの代わりに\nチョコアイスが載ってると\n思えば、普通でしょ？",
            "zh": "就当成用巧克力冰淇淋\n代替巧克力酱的话，\n也算挺正常的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "504/TALK",
            "narrator": "アーヤ",
            "text": "あむっ…。",
            "zh": "啊呜……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "505/TALK",
            "narrator": "アーヤ",
            "text": "…うん、美味しいわ。\nこれなら平気よ。",
            "zh": "……嗯，挺好吃的。\n这样的话完全没问题哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "507/TALK",
            "narrator": "みやび",
            "text": "大当たりではないけんど、\n大ハズレでもない、って\nところやね。",
            "zh": "虽说不算大中特奖，\n但也算不上踩大雷，\n差不多这样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "508/TALK",
            "narrator": "アーヤ",
            "text": "そんな感じね。\nでも、結構美味しいから\n嫌いじゃないわ。",
            "zh": "差不多那种感觉吧。\n不过还蛮好吃的，\n我并不讨厌。",
            "narrator_zh": "绫水"
        },
        {
            "location": "509/TALK",
            "narrator": "アーヤ",
            "text": "って、話してる間に\nアイス溶けちゃう。\n早く食べないと。",
            "zh": "哎呀，说话间\n冰淇淋要化了。\n得赶紧吃才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "513/TALK",
            "narrator": "アーヤ",
            "text": "…ごちそうさま。",
            "zh": "……我吃好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "514/TALK",
            "narrator": "みやび",
            "text": "綺麗に食べきったのに、\n不満そうな顔やな。",
            "zh": "明明吃得干干净净，\n却一脸不满的样子嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "515/TALK",
            "narrator": "みやび",
            "text": "やっぱり、不味かったん？",
            "zh": "果然，不好吃吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "517/TALK",
            "narrator": "アーヤ",
            "text": "ううん、けして不味くは\nなかったわ。",
            "zh": "不是，倒绝对谈不上\n难吃。",
            "narrator_zh": "绫水"
        },
        {
            "location": "518/TALK",
            "narrator": "アーヤ",
            "text": "不味くはなかったけど…\n私、ホットケーキを\n注文したわよね？",
            "zh": "是不难吃没错……\n可我点的不是\n松饼吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "519/TALK",
            "narrator": "みやび",
            "text": "うん、ホットケーキやね。",
            "zh": "嗯，是松饼咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "520/TALK",
            "narrator": "アーヤ",
            "text": "けど、ベタ甘なチョコの\n味が強すぎて――",
            "zh": "但是，腻甜的巧克力\n味道太重了――",
            "narrator_zh": "绫水"
        },
        {
            "location": "521/TALK",
            "narrator": "アーヤ",
            "text": "ホットケーキそのものの、\n優しい甘さが感じられ\nなかったの…。",
            "zh": "松饼本身那种\n柔和的甜味根本\n尝不出来……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "522/TALK",
            "narrator": "みやび",
            "text": "あ～…それは致命的な\n欠点やね。",
            "zh": "啊～……那确实是致命的\n缺点咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "523/TALK",
            "narrator": "みやび",
            "text": "ホットケーキは、\nあのほんのりふわっと\nした甘さがないと――",
            "zh": "松饼要是没得\n那种松软又淡淡的\n甜味――",
            "narrator_zh": "雅"
        },
        {
            "location": "524/TALK",
            "narrator": "みやび",
            "text": "食べた気にならんちや。",
            "zh": "总觉得像没吃一样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "525/TALK",
            "narrator": "アーヤ",
            "text": "うんと甘い物が食べたい、\nって時にはいいけど――",
            "zh": "很想吃超级甜的东西时\n倒是不错――",
            "narrator_zh": "绫水"
        },
        {
            "location": "526/TALK",
            "narrator": "アーヤ",
            "text": "ホットケーキを求めて\n注文すると、ガッカリな\n結果になるわね。",
            "zh": "要是冲着松饼来的，\n点这个就会落得\n失望的下场呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "527/TALK",
            "narrator": "みやび",
            "text": "まあ、それがわかった\nだけでも、得たものは\nあったやんか。",
            "zh": "嘛，光凭弄明白这一点，\n也算有所收获了\n嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "528/TALK",
            "narrator": "アーヤ",
            "text": "そうね…。",
            "zh": "是啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "529/TALK",
            "narrator": "アーヤ",
            "text": "…ところで、冒険しろと\n言ったあなたは何を\n飲んでいるのかしら？",
            "zh": "……话说回来，叫我\n去冒险的你，自己\n正在喝什么呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "530/TALK",
            "narrator": "みやび",
            "text": "コーンスープちや。\nあー、優しい甘さと\n温かさが最高やねぇ。",
            "zh": "玉米浓汤咯。\n啊——温和的甜味\n加上暖意，简直绝了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "532/TALK",
            "narrator": "アーヤ",
            "text": "…冒険しなさいよ。",
            "zh": "……你也给我去冒险啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "533/ACT",
            "narrator": "",
            "text": "パスタ系は？",
            "zh": "意面之类的呢？",
            "narrator_zh": ""
        },
        {
            "location": "534/TALK",
            "narrator": "アーヤ",
            "text": "…まさか、それが来るとは思わなかったわ",
            "zh": "……真没想到你会选那个",
            "narrator_zh": "绫水"
        },
        {
            "location": "535/TALK",
            "narrator": "アーヤ",
            "text": "出来れば避けたいかも、って思ってたけど…",
            "zh": "我本来还想着尽量避开比较好呢……",
            "narrator_zh": "绫水"
        },
        {
            "location": "536/TALK",
            "narrator": "アーヤ",
            "text": "でも、冒険も必要よね",
            "zh": "不过，冒险也是很有必要的呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "540/TALK",
            "narrator": "アーヤ",
            "text": "…私、パスタにしようと\n思うんだけど。",
            "zh": "……我打算点\n意面。",
            "narrator_zh": "绫水"
        },
        {
            "location": "542/TALK",
            "narrator": "みやび",
            "text": "悪いことは言わん。\nそれはやめた方がえい。",
            "zh": "听我一句劝。\n还是别点那个比较好。",
            "narrator_zh": "雅"
        },
        {
            "location": "543/TALK",
            "narrator": "みやび",
            "text": "パスタ系のアレンジは、\n爆弾になる可能性も\n十分あり得るき――",
            "zh": "意面类的改良，\n完全有可能变成\n一颗雷啵――",
            "narrator_zh": "雅"
        },
        {
            "location": "544/TALK",
            "narrator": "みやび",
            "text": "無難にデザート辺りを\n攻めた方がえいよ。",
            "zh": "还是稳妥点去点\n甜品之类的比较好。",
            "narrator_zh": "雅"
        },
        {
            "location": "545/TALK",
            "narrator": "アーヤ",
            "text": "それはわかってるけど、\n今日は冒険してみよう\nかな、って思うの。",
            "zh": "道理我是懂，但今天\n我想稍微冒险\n试试看。",
            "narrator_zh": "绫水"
        },
        {
            "location": "546/TALK",
            "narrator": "アーヤ",
            "text": "みやびの言う通り、素敵な\n出会いがあるかもしれない\nでしょ？",
            "zh": "就像雅说的，说不定\n会有很棒的邂逅\n对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "547/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "548/TALK",
            "narrator": "みやび",
            "text": "わかった…なら、うちも\n一緒に注文するんよ。",
            "zh": "知道了……那我也\n陪你一起点咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "549/TALK",
            "narrator": "アーヤ",
            "text": "みやびまで付き合うこと\nないのに。",
            "zh": "雅不用特地陪我\n一起的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "550/TALK",
            "narrator": "みやび",
            "text": "言い出しっぺはうちや。\nそのうちが逃げるわけには\nいかんちや。",
            "zh": "提议的是我。\n我怎么能自己先\n溜了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "551/TALK",
            "narrator": "みやび",
            "text": "アーヤはどれにするか\n決めたが？",
            "zh": "绫水你决定好\n点哪个了喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "552/TALK",
            "narrator": "アーヤ",
            "text": "カルボナーラ。\nパスタの中では\n結構好きなのよ。",
            "zh": "奶油培根意面。\n在意面里我还是\n挺喜欢这个的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "553/TALK",
            "narrator": "みやび",
            "text": "それやったら、\nうちはイカスミパスタに\nしてみるぞね。",
            "zh": "那样的话，\n我就试试墨鱼汁\n意面啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "554/TALK",
            "narrator": "みやび",
            "text": "…本当にえいが？\n注文したら後戻りは\nできんがよ？",
            "zh": "……真的要得吗？\n点了单可就没法\n反悔了啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "555/TALK",
            "narrator": "アーヤ",
            "text": "覚悟が鈍るから、\n早く注文しましょ。",
            "zh": "免得决心动摇，\n快点下单吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "558/TALK",
            "narrator": "みやび",
            "text": "わかった…。\nすみません、\n注文お願いします。",
            "zh": "知道了……。\n不好意思，\n麻烦点单。",
            "narrator_zh": "雅"
        },
        {
            "location": "559/TALK",
            "narrator": "アーヤ",
            "text": "…どうか、ゲテモノだけは\n出てこないでください！",
            "zh": "……请千万不要端出\n黑暗料理来啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "567/TALK",
            "narrator": "アーヤ",
            "text": "…ごちそうさまでした。",
            "zh": "……多谢款待。",
            "narrator_zh": "绫水"
        },
        {
            "location": "568/TALK",
            "narrator": "みやび",
            "text": "…ごちそうさま。",
            "zh": "……我吃好了。",
            "narrator_zh": "雅"
        },
        {
            "location": "569/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "570/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "571/TALK",
            "narrator": "アーヤ",
            "text": "…アレンジされた物が\n出てくるって、勝手に\n思った私達も悪いけど――",
            "zh": "……虽说自顾自以为\n一定会端出改良版\n是我们不对――",
            "narrator_zh": "绫水"
        },
        {
            "location": "573/TALK",
            "narrator": "アーヤ",
            "text": "普通だったわね。",
            "zh": "真是普通呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "574/TALK",
            "narrator": "みやび",
            "text": "うん、ビックリするくらい\n普通のパスタやったね。",
            "zh": "嗯，普通到让人\n吃惊的意面咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "575/TALK",
            "narrator": "みやび",
            "text": "どんなアレンジがされ\nちゅうか楽しみに\nしちょったがに――",
            "zh": "本来还期待着\n会做么子改良\n呢――",
            "narrator_zh": "雅"
        },
        {
            "location": "576/TALK",
            "narrator": "みやび",
            "text": "まっこと普通のが\n出てくるとは…。",
            "zh": "谁晓得端出来的\n竟是这么普通的货色……。",
            "narrator_zh": "雅"
        },
        {
            "location": "577/TALK",
            "narrator": "アーヤ",
            "text": "味も、不味くはないけど\n美味しくもない、普通な\n感じだったしね。",
            "zh": "味道也是说不上难吃\n但也说不上好吃，\n很普通的感觉呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "578/TALK",
            "narrator": "アーヤ",
            "text": "普通じゃないところって、\nもしかして値段くらい？",
            "zh": "唯一不普通的地方，\n难道就是价格了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "579/TALK",
            "narrator": "みやび",
            "text": "この味で千円札一枚じゃ\n足りないいうんは、\n納得できんわ。",
            "zh": "这味道一张千元钞\n还不够付，\n真叫人不服气啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "580/TALK",
            "narrator": "みやび",
            "text": "駅前にある、ワンコインで\n食べられるファミレスの\nパスタの方が――",
            "zh": "车站前那家硬币一枚\n就能吃到的家庭餐厅\n意面――",
            "narrator_zh": "雅"
        },
        {
            "location": "581/TALK",
            "narrator": "みやび",
            "text": "間違いなく美味いな。",
            "zh": "绝对要好吃得多嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "582/TALK",
            "narrator": "アーヤ",
            "text": "同感…多分、この店に\n来るのは、今日が最初で\n最後ね。",
            "zh": "同感……大概，来这家店\n今天就是第一次\n也是最后一次了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "357/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月18日　3:53 PM</color>\nとある平日の放課後、某カフェにて。",
            "zh": "<color=green>7月18日　3:53 PM</color>\n某天平日放学后，在某家咖啡馆内。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "475/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch02",
            "text": "【ヌーベル・バーグ・カフェ】",
            "zh": "【新浪潮咖啡馆】",
            "narrator_zh": "Dialog_GEThimegoto_ch02"
        }
    ]
}
