    "entry": [
        {
            "location": "914/SCENARIO",
            "narrator": "",
            "text": "チート",
            "zh": "作弊",
            "narrator_zh": ""
        },
        {
            "location": "924/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "925/TALK",
            "narrator": "千羽鶴",
            "text": "あなたに全てを\n説明する理由はない。",
            "zh": "我没有理由向你\n解释全部。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "926/TALK",
            "narrator": "千羽鶴",
            "text": "でも計画を伝える\nことによって\n効率化できるなら。",
            "zh": "不过如果能通过\n告知计划\n来提高效率的话。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "927/TALK",
            "narrator": "千羽鶴",
            "text": "そう思って説明を\nしていただけ。",
            "zh": "我只是这么想着\n说明的而已。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "928/TALK",
            "narrator": "千羽鶴",
            "text": "…でもそれは逆効果\nだったみたい。",
            "zh": "……但似乎那是\n适得其反了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "929/TALK",
            "narrator": "千羽鶴",
            "text": "それが私の結論。",
            "zh": "那就是我的结论。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "931/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "932/TALK",
            "narrator": "千羽鶴",
            "text": "自覚はある？",
            "zh": "你有自觉吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "933/SEL",
            "narrator": "",
            "text": "神楽？",
            "zh": "神乐？",
            "narrator_zh": ""
        },
        {
            "location": "934/ACT",
            "narrator": "",
            "text": "神楽？",
            "zh": "神乐？",
            "narrator_zh": ""
        },
        {
            "location": "938/TALK",
            "narrator": "千羽鶴",
            "text": "…お友達から\n連絡が入った\nみたいだけど。",
            "zh": "……你朋友那边\n好像发来\n消息了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "940/TALK",
            "narrator": "神楽",
            "text": "何でもない。",
            "zh": "没什么。",
            "narrator_zh": "神乐"
        },
        {
            "location": "941/TALK",
            "narrator": "千羽鶴",
            "text": "ああそう。\nならいいけど。",
            "zh": "哦，是吗。\n那就算了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "942/SEL",
            "narrator": "",
            "text": "何か…大丈夫？",
            "zh": "怎么……没事吧？",
            "narrator_zh": ""
        },
        {
            "location": "943/ACT",
            "narrator": "",
            "text": "何か…大丈夫？",
            "zh": "怎么……没事吧？",
            "narrator_zh": ""
        },
        {
            "location": "961/TALK",
            "narrator": "神楽",
            "text": "大丈夫",
            "zh": "没事",
            "narrator_zh": "神乐"
        },
        {
            "location": "962/TALK",
            "narrator": "神楽",
            "text": "心配しないで",
            "zh": "别担心",
            "narrator_zh": "神乐"
        },
        {
            "location": "964/SEL",
            "narrator": "",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": ""
        },
        {
            "location": "965/SEL",
            "narrator": "",
            "text": "うん、ごめんね",
            "zh": "嗯，对不起",
            "narrator_zh": ""
        },
        {
            "location": "966/SEL",
            "narrator": "",
            "text": "心配だな…",
            "zh": "有点担心……",
            "narrator_zh": ""
        },
        {
            "location": "967/ACT",
            "narrator": "",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": ""
        },
        {
            "location": "968/ACT",
            "narrator": "",
            "text": "うん、ごめんね",
            "zh": "嗯，对不起",
            "narrator_zh": ""
        },
        {
            "location": "969/ACT",
            "narrator": "",
            "text": "心配だな…",
            "zh": "有点担心……",
            "narrator_zh": ""
        },
        {
            "location": "981/TALK",
            "narrator": "千羽鶴",
            "text": "そのおもちゃで\n遊べるのも\nあと少し。",
            "zh": "能玩那个玩具，\n也只剩下\n一点时间了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "982/TALK",
            "narrator": "千羽鶴",
            "text": "それまでは好きに\nすればいい。",
            "zh": "在那之前就\n随你喜欢。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "983/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "984/TALK",
            "narrator": "千羽鶴",
            "text": "ああ、そうだ。",
            "zh": "啊，是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "985/TALK",
            "narrator": "千羽鶴",
            "text": "歌については\n練習する必要はない。",
            "zh": "关于歌的事，\n不需要练习。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "986/TALK",
            "narrator": "千羽鶴",
            "text": "こちらで全て\n整えておく。",
            "zh": "这边我会全部\n准备好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "987/TALK",
            "narrator": "千羽鶴",
            "text": "じゃあ。",
            "zh": "再见。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "994/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1007/TALK",
            "narrator": "神楽",
            "text": "ごめんねお待たせ",
            "zh": "抱歉，让你等了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1009/TALK",
            "narrator": "神楽",
            "text": "もうＷＡＶＥしても大丈夫ぴょん♪",
            "zh": "现在可以放心聊WAVE了pyon♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "1011/SEL",
            "narrator": "",
            "text": "いや…えっと…",
            "zh": "那个……嗯……",
            "narrator_zh": ""
        },
        {
            "location": "1012/SEL",
            "narrator": "",
            "text": "待ってたは待ってたけど…",
            "zh": "等是等过了……",
            "narrator_zh": ""
        },
        {
            "location": "1013/SEL",
            "narrator": "",
            "text": "本当に大丈夫？？？",
            "zh": "真的没事吗？？？",
            "narrator_zh": ""
        },
        {
            "location": "1014/ACT",
            "narrator": "",
            "text": "いや…えっと…",
            "zh": "那个……嗯……",
            "narrator_zh": ""
        },
        {
            "location": "1015/TALK",
            "narrator": "神楽",
            "text": "困ってる？",
            "zh": "很困扰吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1017/ACT",
            "narrator": "",
            "text": "待ってたは待ってたけど…",
            "zh": "等是等过了……",
            "narrator_zh": ""
        },
        {
            "location": "1020/ACT",
            "narrator": "",
            "text": "本当に大丈夫？？？",
            "zh": "真的没事吗？？？",
            "narrator_zh": ""
        },
        {
            "location": "1021/TALK",
            "narrator": "神楽",
            "text": "どう思う？？？",
            "zh": "你怎么想？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1022/TALK",
            "narrator": "神楽",
            "text": "ねえどう思う？？？",
            "zh": "喂你怎么想？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1025/TALK",
            "narrator": "神楽",
            "text": "一言で言うと崖っぷち？？？",
            "zh": "一句话形容就是悬崖边？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1026/TALK",
            "narrator": "神楽",
            "text": "ぴょんこの美貌や明晰な頭脳やアーティストとしての才能を持ってしても回避できない崖！！！",
            "zh": "哪怕靠蹦子的美貌、清晰头脑和身为艺人的才能都避不开的悬崖！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1028/SEL",
            "narrator": "",
            "text": "だよね…",
            "zh": "是啊……",
            "narrator_zh": ""
        },
        {
            "location": "1029/SEL",
            "narrator": "",
            "text": "どうにかしたいんだけど…",
            "zh": "我想想办法，可是……",
            "narrator_zh": ""
        },
        {
            "location": "1030/SEL",
            "narrator": "",
            "text": "頑張りすぎないで",
            "zh": "别太拼了",
            "narrator_zh": ""
        },
        {
            "location": "1031/ACT",
            "narrator": "",
            "text": "だよね…",
            "zh": "是啊……",
            "narrator_zh": ""
        },
        {
            "location": "1032/TALK",
            "narrator": "神楽",
            "text": "だよ！！！！",
            "zh": "是啊！！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1033/TALK",
            "narrator": "神楽",
            "text": "どうすんだよ！！！",
            "zh": "你打算怎么办啊！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1035/ACT",
            "narrator": "",
            "text": "どうにかしたいんだけど…",
            "zh": "我想想办法，可是……",
            "narrator_zh": ""
        },
        {
            "location": "1036/TALK",
            "narrator": "神楽",
            "text": "どうにかしろ！！！",
            "zh": "想办法啊！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1037/TALK",
            "narrator": "神楽",
            "text": "今すぐだ！！！",
            "zh": "现在立刻！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1039/ACT",
            "narrator": "",
            "text": "頑張りすぎないで",
            "zh": "别太拼了",
            "narrator_zh": ""
        },
        {
            "location": "1040/TALK",
            "narrator": "神楽",
            "text": "立ち止まったら",
            "zh": "要是停下来的话",
            "narrator_zh": "神乐"
        },
        {
            "location": "1041/TALK",
            "narrator": "神楽",
            "text": "もう動けなくなるぴょん！！！",
            "zh": "就再也动不了了pyon！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1044/TALK",
            "narrator": "神楽",
            "text": "いやﾏｼﾞﾃﾞﾏｼﾞﾃﾞ",
            "zh": "不是，真的真的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1045/TALK",
            "narrator": "神楽",
            "text": "どうしてくれようってやつ！",
            "zh": "该怎么补偿我啊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1047/SEL",
            "narrator": "",
            "text": "わかる",
            "zh": "我懂",
            "narrator_zh": ""
        },
        {
            "location": "1048/SEL",
            "narrator": "",
            "text": "ごめんね…",
            "zh": "对不起……",
            "narrator_zh": ""
        },
        {
            "location": "1049/SEL",
            "narrator": "",
            "text": "どうにかしたいな",
            "zh": "真希望能想出办法",
            "narrator_zh": ""
        },
        {
            "location": "1050/ACT",
            "narrator": "",
            "text": "わかる",
            "zh": "我懂",
            "narrator_zh": ""
        },
        {
            "location": "1051/TALK",
            "narrator": "神楽",
            "text": "ホントに！？",
            "zh": "真的吗！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1053/TALK",
            "narrator": "神楽",
            "text": "わかってくれるぴょん！？",
            "zh": "你懂我pyon！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1055/ACT",
            "narrator": "",
            "text": "ごめんね…",
            "zh": "对不起……",
            "narrator_zh": ""
        },
        {
            "location": "1056/TALK",
            "narrator": "神楽",
            "text": "あーあーあーあー",
            "zh": "啊啊啊啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "1057/TALK",
            "narrator": "神楽",
            "text": "いいってそういうのは",
            "zh": "不用了，那种话",
            "narrator_zh": "神乐"
        },
        {
            "location": "1059/ACT",
            "narrator": "",
            "text": "どうにかしたいな",
            "zh": "真希望能想出办法",
            "narrator_zh": ""
        },
        {
            "location": "1060/TALK",
            "narrator": "神楽",
            "text": "どうにかしてー",
            "zh": "想想办法啊——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1061/TALK",
            "narrator": "神楽",
            "text": "本当にどうにかしてー",
            "zh": "求你真的想想办法啊——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1065/TALK",
            "narrator": "神楽",
            "text": "ぶっちゃけ",
            "zh": "说实在的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1066/TALK",
            "narrator": "神楽",
            "text": "ずっとこんな状態だったわけですー",
            "zh": "我一直都是这种状态过来的——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1067/TALK",
            "narrator": "神楽",
            "text": "ありえないでしょ！",
            "zh": "太离谱了吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1068/TALK",
            "narrator": "神楽",
            "text": "ほんとありえないでしょ！！！！",
            "zh": "真的太离谱了吧！！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1070/SEL",
            "narrator": "",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": ""
        },
        {
            "location": "1071/SEL",
            "narrator": "",
            "text": "何と言っていいか",
            "zh": "该怎么说好呢",
            "narrator_zh": ""
        },
        {
            "location": "1072/SEL",
            "narrator": "",
            "text": "よしよし",
            "zh": "好，好",
            "narrator_zh": ""
        },
        {
            "location": "1073/ACT",
            "narrator": "",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": ""
        },
        {
            "location": "1074/TALK",
            "narrator": "神楽",
            "text": "やっぱりだー",
            "zh": "果然啊——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1075/TALK",
            "narrator": "神楽",
            "text": "ありえないー",
            "zh": "太离谱了——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1077/ACT",
            "narrator": "",
            "text": "何と言っていいか",
            "zh": "该怎么说好呢",
            "narrator_zh": ""
        },
        {
            "location": "1078/TALK",
            "narrator": "神楽",
            "text": "言葉もないって",
            "zh": "简直无言以对",
            "narrator_zh": "神乐"
        },
        {
            "location": "1079/TALK",
            "narrator": "神楽",
            "text": "やべーまじやべー",
            "zh": "糟糕，真的糟糕",
            "narrator_zh": "神乐"
        },
        {
            "location": "1081/ACT",
            "narrator": "",
            "text": "よしよし",
            "zh": "好，好",
            "narrator_zh": ""
        },
        {
            "location": "1082/TALK",
            "narrator": "神楽",
            "text": "あああああああ",
            "zh": "啊啊啊啊啊啊啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "1083/TALK",
            "narrator": "神楽",
            "text": "もっともっともっとー！！！",
            "zh": "再多点再多点再多点——！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1086/TALK",
            "narrator": "神楽",
            "text": "なんて言ってても",
            "zh": "就算那么说",
            "narrator_zh": "神乐"
        },
        {
            "location": "1087/TALK",
            "narrator": "神楽",
            "text": "仕方ないし",
            "zh": "也于事无补",
            "narrator_zh": "神乐"
        },
        {
            "location": "1088/TALK",
            "narrator": "神楽",
            "text": "どうにもならないし",
            "zh": "也没办法",
            "narrator_zh": "神乐"
        },
        {
            "location": "1089/TALK",
            "narrator": "神楽",
            "text": "はーあーあーあーあー",
