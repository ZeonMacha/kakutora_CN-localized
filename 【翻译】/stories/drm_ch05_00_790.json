 "entry": [
  {
   "location": "249/SCENARIO",
   "narrator": "",
   "text": "約束のできる場所"
  },
  {
   "location": "259/TALK",
   "narrator": "神楽",
   "text": "……いい天気に\nなってよかった……。"
  },
  {
   "location": "260/TALK",
   "narrator": "神楽",
   "text": "……ちょっと暑い\nくらいかな。"
  },
  {
   "location": "261/TALK",
   "narrator": "神楽",
   "text": "途中で日焼け止め\n塗り直した方が\nいいかも？"
  },
  {
   "location": "262/TALK",
   "narrator": "神楽",
   "text": "変な焼け方したら\nみっともないし……。"
  },
  {
   "location": "264/SEL",
   "narrator": "",
   "text": "ここどこ？",
   "zh": "这里是哪里？",
   "narrator_zh": ""
  },
  {
   "location": "265/SEL",
   "narrator": "",
   "text": "着いたのかな？",
   "zh": "到了吗？",
   "narrator_zh": ""
  },
  {
   "location": "266/SEL",
   "narrator": "",
   "text": "神楽はいつでもかわいいよ",
   "zh": "神乐一直都很可爱哦",
   "narrator_zh": ""
  },
  {
   "location": "267/ACT",
   "narrator": "",
   "text": "ここどこ？",
   "zh": "这里是哪里？",
   "narrator_zh": ""
  },
  {
   "location": "269/TALK",
   "narrator": "神楽",
   "text": "江ノ島駅。"
  },
  {
   "location": "270/ACT",
   "narrator": "",
   "text": "着いたのかな？",
   "zh": "到了吗？",
   "narrator_zh": ""
  },
  {
   "location": "272/TALK",
   "narrator": "神楽",
   "text": "そうだよー。",
   "zh": "是啊——。",
   "narrator_zh": "神乐"
  },
  {
   "location": "273/ACT",
   "narrator": "",
   "text": "神楽はいつでもかわいいよ",
   "zh": "神乐一直都很可爱哦",
   "narrator_zh": ""
  },
  {
   "location": "274/TALK",
   "narrator": "神楽",
   "text": "どうしたの急に？",
   "zh": "怎么突然这样？",
   "narrator_zh": "神乐"
  },
  {
   "location": "276/TALK",
   "narrator": "神楽",
   "text": "そんなの知ってるけど。\n……ありがと。",
   "zh": "那种事我知道。\n……谢了。",
   "narrator_zh": "神乐"
  },
  {
   "location": "279/TALK",
   "narrator": "神楽",
   "text": "あの山の方向に\n進むから。"
  },
  {
   "location": "281/TALK",
   "narrator": "神楽",
   "text": "……意外と歩く\nみたいだけど。"
  },
  {
   "location": "282/SEL",
   "narrator": "",
   "text": "山じゃなくて\n島でしょ？",
   "zh": "不是山，\n是岛吧？",
   "narrator_zh": ""
  },
  {
   "location": "283/SEL",
   "narrator": "",
   "text": "アイ、マム！",
   "zh": "遵命，妈妈！",
   "narrator_zh": ""
  },
  {
   "location": "284/SEL",
   "narrator": "",
   "text": "弁天橋を渡ったら\n江ノ島だね",
   "zh": "过了弁天桥\n就是江之岛了",
   "narrator_zh": ""
  },
  {
   "location": "285/ACT",
   "narrator": "",
   "text": "山じゃなくて\n島でしょ？",
   "zh": "不是山，\n是岛吧？",
   "narrator_zh": ""
  },
  {
   "location": "287/TALK",
   "narrator": "神楽",
   "text": "えー？",
   "zh": "诶——？",
   "narrator_zh": "神乐"
  },
  {
   "location": "288/TALK",
   "narrator": "神楽",
   "text": "山みたいになってる\n島でしょ？"
  },
  {
   "location": "289/ACT",
   "narrator": "",
   "text": "アイ、マム！",
   "zh": "遵命，妈妈！",
   "narrator_zh": ""
  },
  {
   "location": "290/TALK",
   "narrator": "神楽",
   "text": "軍隊か！"
  },
  {
   "location": "291/TALK",
   "narrator": "神楽",
   "text": "今日はもっとこう\nゆるふわな感じで\n行きたいな。"
  },
  {
   "location": "292/ACT",
   "narrator": "",
   "text": "弁天橋を渡ったら\n江ノ島だね",
   "zh": "过了弁天桥\n就是江之岛了",
   "narrator_zh": ""
  },
  {
   "location": "293/TALK",
   "narrator": "神楽",
   "text": "そうそう。",
   "zh": "对对。",
   "narrator_zh": "神乐"
  },
  {
   "location": "294/TALK",
   "narrator": "神楽",
   "text": "この辺詳しいんだ？",
   "zh": "你对这一带很熟吗？",
   "narrator_zh": "神乐"
  },
  {
   "location": "301/TALK",
   "narrator": "神楽",
   "text": "この橋の下、\n砂地だけど。",
   "zh": "这座桥下面，\n虽然是沙地。",
   "narrator_zh": "神乐"
  },
  {
   "location": "302/TALK",
   "narrator": "神楽",
   "text": "ここって川なの？\nいやもう海なの？",
   "zh": "这里到底是河？\n不对，已经是海了？",
   "narrator_zh": "神乐"
  },
  {
   "location": "303/TALK",
   "narrator": "神楽",
   "text": "なんだか不思議な感じ。",
   "zh": "总觉得很奇妙。",
   "narrator_zh": "神乐"
  },
  {
   "location": "304/SEL",
   "narrator": "",
   "text": "吃水域ってやつでしょ",
   "zh": "就是所谓的水土不服吧",
   "narrator_zh": ""
  },
  {
   "location": "305/SEL",
   "narrator": "",
   "text": "水飲めばわかるよ！",
   "zh": "喝点水就明白了！",
   "narrator_zh": ""
  },
  {
   "location": "306/SEL",
   "narrator": "",
   "text": "謎は謎のままが美しい",
   "zh": "谜就保持谜的样子才美",
   "narrator_zh": ""
  },
  {
   "location": "307/ACT",
   "narrator": "",
   "text": "吃水域ってやつでしょ",
   "zh": "就是所谓的水土不服吧",
   "narrator_zh": ""
  },
  {
   "location": "308/TALK",
   "narrator": "神楽",
   "text": "なるほどー。",
   "zh": "原来如此——。",
   "narrator_zh": "神乐"
  },
  {
   "location": "310/TALK",
   "narrator": "神楽",
   "text": "で？\n川なの？\n海なの？",
   "zh": "那？\n是河？\n是海？",
   "narrator_zh": "神乐"
  },
  {
   "location": "311/ACT",
   "narrator": "",
   "text": "水飲めばわかるよ！",
   "zh": "喝点水就明白了！",
   "narrator_zh": ""
  },
  {
   "location": "312/TALK",
   "narrator": "神楽",
   "text": "確かにそうかも。",
   "zh": "确实可能是这样。",
   "narrator_zh": "神乐"
  },
  {
   "location": "314/TALK",
   "narrator": "神楽",
   "text": "じゃあ飲んでみて\n$handle$。"
  },
  {
   "location": "315/ACT",
   "narrator": "",
   "text": "謎は謎のままが美しい",
   "zh": "谜就保持谜的样子才美",
   "narrator_zh": ""
  },
  {
   "location": "316/TALK",
   "narrator": "神楽",
   "text": "そうかもしれない……。",
   "zh": "也许是这样……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "318/TALK",
   "narrator": "神楽",
   "text": "いやそんなに含んだ\n話じゃないけど。"
  },
  {
   "location": "325/TALK",
   "narrator": "神楽",
   "text": "この先に神社があって、\nそこに鳥居があるんだけど\nその鳥居は赤くない。",
   "zh": "前面有座神社，\n那里有鸟居，\n但是那鸟居不是红色的。",
   "narrator_zh": "神乐"
  },
  {
   "location": "326/TALK",
   "narrator": "神楽",
   "text": "鳥居が赤くないって\n珍しい気がする。"
  },
  {
   "location": "327/SEL",
   "narrator": "",
   "text": "石の鳥居だと赤くないよ",
   "zh": "石头鸟居的话不是红的",
   "narrator_zh": ""
  },
  {
   "location": "328/SEL",
   "narrator": "",
   "text": "それは作られたイメージ",
   "zh": "那只是被造出来的形象",
   "narrator_zh": ""
  },
  {
   "location": "329/SEL",
   "narrator": "",
   "text": "確かにそうかも",
   "zh": "确实可能这样",
   "narrator_zh": ""
  },
  {
   "location": "330/ACT",
   "narrator": "",
   "text": "石の鳥居だと赤くないよ",
   "zh": "石头鸟居的话不是红的",
   "narrator_zh": ""
  },
  {
   "location": "331/TALK",
   "narrator": "神楽",
   "text": "そういうのもあるの？",
   "zh": "还有那种？",
   "narrator_zh": "神乐"
  },
  {
   "location": "332/ACT",
   "narrator": "",
   "text": "それは作られたイメージ",
   "zh": "那只是被造出来的形象",
   "narrator_zh": ""
  },
  {
   "location": "333/TALK",
   "narrator": "神楽",
   "text": "うーん？\nそうなの？"
  },
  {
   "location": "334/ACT",
   "narrator": "",
   "text": "確かにそうかも",
   "zh": "确实可能这样",
   "narrator_zh": ""
  },
  {
   "location": "335/TALK",
   "narrator": "神楽",
   "text": "でしょでしょ。\n不思議な感じ。",
   "zh": "对吧对吧。\n奇妙的感觉。",
   "narrator_zh": "神乐"
  },
  {
   "location": "338/TALK",
   "narrator": "神楽",
   "text": "……。\nねえ$handle$。"
  },
  {
   "location": "340/TALK",
   "narrator": "神楽",
   "text": "赤い鳥居と\n赤くない鳥居の\n比率を求める方法は？"
  },
  {
   "location": "341/SEL",
   "narrator": "",
   "text": "本当に知りたいの？",
   "zh": "你真的想知道？",
   "narrator_zh": ""
  },
  {
   "location": "342/SEL",
   "narrator": "",
   "text": "無茶言うなー",
   "zh": "别提过分的要求——",
   "narrator_zh": ""
  },
  {
   "location": "343/SEL",
   "narrator": "",
   "text": "まず鳥居の定義からだ",
   "zh": "先来定义一下什么是鸟居",
   "narrator_zh": ""
  },
  {
   "location": "344/ACT",
   "narrator": "",
   "text": "本当に知りたいの？",
   "zh": "你真的想知道？",
   "narrator_zh": ""
  },
  {
   "location": "345/TALK",
   "narrator": "神楽",
   "text": "知りたいわけじゃ\nないんだけど。"
  },
  {
   "location": "346/ACT",
   "narrator": "",
   "text": "無茶言うなー",
   "zh": "别提过分的要求——",
   "narrator_zh": ""
  },
  {
   "location": "347/TALK",
   "narrator": "神楽",
   "text": "そうなのかなー？",
   "zh": "是这样吗——？",
   "narrator_zh": "神乐"
  },
  {
   "location": "348/ACT",
   "narrator": "",
   "text": "まず鳥居の定義からだ",
   "zh": "先来定义一下什么是鸟居",
   "narrator_zh": ""
  },
  {
   "location": "349/TALK",
   "narrator": "神楽",
   "text": "うわガチ勢来た。"
  },
  {
   "location": "351/TALK",
   "narrator": "神楽",
   "text": "パパだったら\nそんなこと\n言い出しそうだなって。"
  },
  {
   "location": "352/SEL",
   "narrator": "",
   "text": "えと……何で？",
   "zh": "那个……为什么？",
   "narrator_zh": ""
  },
  {
   "location": "353/SEL",
   "narrator": "",
   "text": "そういう感じの人なんだ",
   "zh": "原来是那种感觉的人",
   "narrator_zh": ""
  },
  {
   "location": "354/SEL",
   "narrator": "",
   "text": "楽しそうだね",
   "zh": "看起来很开心",
   "narrator_zh": ""
  },
  {
   "location": "355/ACT",
   "narrator": "",
   "text": "えと……何で？",
   "zh": "那个……为什么？",
   "narrator_zh": ""
  },
  {
   "location": "357/TALK",
   "narrator": "神楽",
   "text": "私の方が聞きたいん\nだけど。"
  },
  {
   "location": "358/TALK",
   "narrator": "神楽",
   "text": "そういう人だからって\n答えるしかないの。",
   "zh": "只能回答，因为\n他就是那种人。",
   "narrator_zh": "神乐"
  },
  {
   "location": "359/ACT",
   "narrator": "",
   "text": "そういう感じの人なんだ",
   "zh": "原来是那种感觉的人",
   "narrator_zh": ""
  },
  {
   "location": "360/TALK",
   "narrator": "神楽",
   "text": "そーそー！",
   "zh": "对对！",
   "narrator_zh": "神乐"
  },
  {
   "location": "362/TALK",
   "narrator": "神楽",
   "text": "そういう人なのー！",
   "zh": "他就是那种人！",
   "narrator_zh": "神乐"
  },
  {
   "location": "363/ACT",
   "narrator": "",
   "text": "楽しそうだね",
   "zh": "看起来很开心",
   "narrator_zh": ""
  },
  {
   "location": "365/TALK",
   "narrator": "神楽",
   "text": "えええ？"
  },
  {
   "location": "366/TALK",
   "narrator": "神楽",
   "text": "$handle$\nパパと気が合いそう。",
   "zh": "$handle$\n好像跟爸爸合得来。",
   "narrator_zh": "神乐"
  },
  {
   "location": "368/TALK",
   "narrator": "神楽",
   "text": "パパってさ、\nそういう話ばっかり\n振って来たんだ。"
  },
  {
   "location": "369/TALK",
   "narrator": "神楽",
   "text": "答えに辿り着くまでの\n過程を考えるのが\n楽しいだろとか言って。"
  },
  {
   "location": "370/SEL",
   "narrator": "",
   "text": "神楽は楽しくないの？",
   "zh": "神乐不开心吗？",
   "narrator_zh": ""
  },
  {
   "location": "371/SEL",
   "narrator": "",
   "text": "うーん…",
   "zh": "嗯——",
   "narrator_zh": ""
  },
  {
   "location": "372/SEL",
   "narrator": "",
   "text": "一人で楽しそうな人だね",
   "zh": "是个一个人也很开心的人呢",
   "narrator_zh": ""
  },
  {
   "location": "373/ACT",
   "narrator": "",
   "text": "神楽は楽しくないの？",
   "zh": "神乐不开心吗？",
   "narrator_zh": ""
  },
  {
   "location": "375/TALK",
   "narrator": "神楽",
   "text": "楽しいと思う？"
  },
  {
   "location": "376/ACT",
   "narrator": "",
   "text": "うーん…",
   "zh": "嗯——",
   "narrator_zh": ""
  },
  {
   "location": "378/TALK",
   "narrator": "神楽",
   "text": "ちょっとどうかなって\n感じでしょ。",
   "zh": "就是觉得有点\n那个的样子吧。",
   "narrator_zh": "神乐"
  },
  {
   "location": "379/ACT",
   "narrator": "",
   "text": "一人で楽しそうな人だね",
   "zh": "是个一个人也很开心的人呢",
   "narrator_zh": ""
  },
  {
   "location": "380/TALK",
   "narrator": "神楽",
   "text": "まあ……\nそうかもね。"
  },
  {
   "location": "382/TALK",
   "narrator": "神楽",
   "text": "私が困ってたら\n模範解答とか\n説明しだしたりして。"
  },
  {
   "location": "383/TALK",
   "narrator": "神楽",
   "text": "前提知識は\nどのレベルかとか\n聞いてきたり。"
  },
  {
   "location": "384/TALK",
   "narrator": "神楽",
   "text": "そうじゃないって。",
   "zh": "不是那样啦。",
   "narrator_zh": "神乐"
  },
  {
   "location": "385/TALK",
   "narrator": "神楽",
   "text": "そんなの年頃の女子が\n面白く思うわけが\nないでしょって。",
   "zh": "那种事正是花季少女\n不可能觉得\n有趣的吧。",
   "narrator_zh": "神乐"
  },
  {
   "location": "386/SEL",
   "narrator": "",
   "text": "確かにね",
   "zh": "确实呢",
   "narrator_zh": ""
  },
  {
   "location": "387/SEL",
   "narrator": "",
   "text": "面白そうだけど…？",
   "zh": "好像挺有意思，不过……？",
   "narrator_zh": ""
  },
  {
   "location": "388/SEL",
   "narrator": "",
   "text": "お父さんのこと好きだったんだね",
   "zh": "原来你喜欢爸爸啊",
   "narrator_zh": ""
  },
  {
   "location": "389/ACT",
   "narrator": "",
   "text": "確かにね",
   "zh": "确实呢",
   "narrator_zh": ""
  },
  {
   "location": "390/TALK",
   "narrator": "神楽",
   "text": "そういうの\nわかんない人だった。",
   "zh": "他是那种\n不懂这种事的人。",
   "narrator_zh": "神乐"
  },
  {
   "location": "391/ACT",
   "narrator": "",
   "text": "面白そうだけど…？",
   "zh": "好像挺有意思，不过……？",
   "narrator_zh": ""
  },
  {
   "location": "392/TALK",
   "narrator": "神楽",
   "text": "$handle$は\nパパと同じカテゴリの\n生き物だったんだね…。",
   "zh": "原来$handle$是\n跟我爸同一类的\n生物啊……",
   "narrator_zh": "神乐"
  },
  {
   "location": "393/ACT",
   "narrator": "",
   "text": "お父さんのこと好きだったんだね",
   "zh": "原来你喜欢爸爸啊",
   "narrator_zh": ""
  },
  {
   "location": "394/TALK",
   "narrator": "神楽",
   "text": "……うん。\n大好きだった。"
  },
  {
   "location": "396/TALK",
   "narrator": "神楽",
   "text": "父親としては\nちょっとずれた人\nだったと思う。"
  },
  {
   "location": "397/TALK",
   "narrator": "神楽",
   "text": "でもそれも含めて\n私のパパだし。",
   "zh": "不过那也算是\n我爸爸。",
   "narrator_zh": "神乐"
  },
  {
   "location": "398/TALK",
   "narrator": "神楽",
   "text": "仕事に関しては\nスゴイ人なんだって\n思ってた。"
  },
  {
   "location": "399/TALK",
   "narrator": "神楽",
   "text": "だから尊敬してた。",
   "zh": "所以我才尊敬他。",
   "narrator_zh": "神乐"
  },
  {
