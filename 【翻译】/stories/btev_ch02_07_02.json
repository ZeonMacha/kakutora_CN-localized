        {
            "location": "425/TALK",
            "narrator": "アーヤ",
            "text": "ふわっ！",
            "zh": "呼哇！",
            "narrator_zh": "绫水"
        },
        {
            "location": "427/TALK",
            "narrator": "アーヤ",
            "text": "なんか\n不思議な気持ち。",
            "zh": "总觉得\n心情很奇妙。",
            "narrator_zh": "绫水"
        },
        {
            "location": "433/DIALOG",
            "narrator": "",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。",
