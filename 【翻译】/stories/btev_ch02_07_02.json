{
    "dir": "chap07/battle/btev_ch02_07_02.js",
    "type": "",
    "info": {
        "story_id": "22012",
        "cid": "",
        "title": "012 ココロスフィアストーリー【Lv04】",
        "sub_title": "姉妹の隔絶Ⅱ＜帰結＞",
        "title_zh": "012 心灵领域故事【Lv04】",
        "sub_title_zh": "姐妹间的隔阂Ⅱ＜归结＞"
    },
    "entry": [
        {
            "location": "62/SCENARIO",
            "narrator": "",
            "text": "姉妹の隔絶・後編２",
            "zh": "姐妹间的隔阂·后篇2",
            "narrator_zh": ""
        },
        {
            "location": "71/TALK",
            "narrator": "表層アーヤ",
            "text": "どうして……？\nなぜそこまで…",
            "zh": "为什么……？\n为什么要做到这种地步……",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "潜在アーヤ",
            "text": "もうそれくらいに\n嫌気がさしてるって\nことよ。",
            "zh": "就是已经\n厌烦到那种程度了\n嘛。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "潜在アーヤ",
            "text": "$handle$さんも\n同意してるから\n力を貸してくれてる。",
            "zh": "$handle$\n也赞同我，\n才会借给我力量。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "表層アーヤ",
            "text": "同意…ね。\nちょっと卑怯なんじゃ\nないかしら？",
            "zh": "赞同……啊。\n你不觉得\n有点卑鄙吗？",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "潜在アーヤ",
            "text": "…何が？",
            "zh": "……什么？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "77/TALK",
            "narrator": "表層アーヤ",
            "text": "姉と私たちの関係\n伝えてはいたけど、\n全部じゃないわよね。",
            "zh": "姐姐和我们的关系，\n你虽然讲了，\n但并不是全部吧。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "表層アーヤ",
            "text": "貴方が今伝えてある\nは、前提程度でしか\nない。",
            "zh": "你刚才说出来的，\n也不过是\n前提程度罢了。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "表層アーヤ",
            "text": "私たちが本当に姉に\n裏切られたと思ってる\n所は話してない。",
            "zh": "我们真正觉得\n被姐姐背叛的部分，\n你还没说呢。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "潜在アーヤ",
            "text": "話したところで\n変わらないわよ。",
            "zh": "就算说了，\n也不会改变什么哦。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "81/TALK",
            "narrator": "表層アーヤ",
            "text": "どうかしら。",
            "zh": "那可难说。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "82/TALK",
            "narrator": "表層アーヤ",
            "text": "まあいいわ。\n私はもうここに存在\nすることはできない。",
            "zh": "算了。\n我已经无法\n继续留在这里了。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "表層アーヤ",
            "text": "これ以上貴方と\nやりあうことは\nできないけど――",
            "zh": "虽然没法再和\n你交手下去了\n——",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "表層アーヤ",
            "text": "もし$handle$に\n良心があれば代わりに\n問い詰めるでしょう。",
            "zh": "如果$handle$\n还有良心的话，应该会\n替我追问到底吧。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "潜在アーヤ",
            "text": "…っ。",
            "zh": "……唔。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "表層アーヤ",
            "text": "それじゃグッド\nラック。私とは\n息が合わない私さん。",
            "zh": "那就祝你好运吧，\n和我合不来的\n“我”小姐。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "98/TALK",
            "narrator": "潜在アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "107/SEL",
            "narrator": "（選択肢）",
            "text": "で、どういうこと？",
            "zh": "所以，是怎么回事？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "108/SEL",
            "narrator": "（選択肢）",
            "text": "何も言わなくていいよ",
            "zh": "什么都不用说哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "109/ACT",
            "narrator": "",
            "text": "で、どういうこと？",
            "zh": "所以，是怎么回事？",
            "narrator_zh": ""
        },
        {
            "location": "110/TALK",
            "narrator": "潜在アーヤ",
            "text": "はぁ、わかったわよ。\n教える。",
            "zh": "哈啊，我知道了。\n告诉你就是。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "111/ACT",
            "narrator": "",
            "text": "何も言わなくていいよ",
            "zh": "什么都不用说哦",
            "narrator_zh": ""
        },
        {
            "location": "113/TALK",
            "narrator": "潜在アーヤ",
            "text": "ふふ、ありがと。\n貴方は優しいのね。",
            "zh": "呵呵，谢谢。\n你真温柔啊。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "潜在アーヤ",
            "text": "でも、本当に重要だと\n思う時は、ちゃんと\n言っていいのよ？",
            "zh": "不过，觉得真的很重要的\n时候，其实可以\n直说出来的哦？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "116/TALK",
            "narrator": "潜在アーヤ",
            "text": "私自身も、フェアじゃ\nなかったってちょっと\n反省してるし。",
            "zh": "我自己也觉得\n刚才那样不太公平，\n有点在反省呢。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "潜在アーヤ",
            "text": "一つ前のレベル０３で\nしたお話には、続きが\nあるのよ。",
            "zh": "上一个等级03\n讲过的故事，\n还有后续哦。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "潜在アーヤ",
            "text": "今からそれを\n話すわ。",
            "zh": "现在我就\n把它讲给你听。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "136/DIALOG",
            "narrator": "",
            "text": "高校も３年になり、\n私も進路を考えなければ\nならない時期が来た。",
            "zh": "到了高三，\n我也迎来了不得不考虑\n今后出路的时候。",
            "narrator_zh": ""
        },
        {
            "location": "137/DIALOG",
            "narrator": "",
            "text": "当時、剣道の全国大会で優勝し、\n世界選手権ジュニア部門の\n最有力候補になっていた私は\n東京や大阪といった所にある\n幾つかの大学から\nオファーがかかっていたの。",
            "zh": "当时，我在剑道全国大赛中夺冠，\n成了世界锦标赛青少年组\n最有力的夺冠热门，\n好几所位于东京和大阪的\n大学都向我\n发出了招揽邀请。",
            "narrator_zh": ""
        },
        {
            "location": "138/DIALOG",
            "narrator": "",
            "text": "家のことは心配だったけど\n姉も実家に隠っていたし、\n大学くらいは\n遠いところで一人暮らししても\n大丈夫だろう、なんて思っていた。",
            "zh": "虽然很担心家里，\n但姐姐也一直宅在老家，\n我还想着至少上大学时\n去远一点的地方独居，\n应该没问题吧。",
            "narrator_zh": ""
        },
        {
            "location": "139/DIALOG",
            "narrator": "",
            "text": "けど――",
            "zh": "可是——",
            "narrator_zh": ""
        },
        {
            "location": "142/TALK",
            "narrator": "高校生アーヤ",
            "text": "あれ？",
            "zh": "咦？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "高校生アーヤ",
            "text": "お姉ちゃんは？",
            "zh": "姐姐呢？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "145/DIALOG",
            "narrator": "",
            "text": "ある日、高校から帰ると\n姉はいなかった。\n\n姉の部屋の荷物も\n全部無くなっていた。",
            "zh": "有一天，从高中回到家时，\n姐姐不在了。\n\n姐姐房间里的行李\n也全都清空了。",
            "narrator_zh": ""
        },
        {
            "location": "146/DIALOG",
            "narrator": "",
            "text": "母が言うには、\n『すごい研究所から\nオファーがかかったから\nフランスへ行く』\nって――",
            "zh": "听妈妈说，\n“因为有很厉害的研究所\n发来了邀请，\n所以去法国了”\n——",
            "narrator_zh": ""
        },
        {
            "location": "148/TALK",
            "narrator": "高校生アーヤ",
            "text": "……なにそれ。",
            "zh": "……那算什么。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "149/TALK",
            "narrator": "高校生アーヤ",
            "text": "最低…",
            "zh": "真过分……",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "150/TALK",
            "narrator": "高校生アーヤ",
            "text": "……最低よ…　…",
            "zh": "……太过分了……",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "151/DIALOG",
            "narrator": "",
            "text": "私、そんなこと\n一言も\n教えてもらってないよ――",
            "zh": "这种事，她连一句\n都没对我\n说过呀——",
            "narrator_zh": ""
        },
        {
            "location": "154/DIALOG",
            "narrator": "",
            "text": "バカ姉。",
            "zh": "笨蛋姐姐。",
            "narrator_zh": ""
        },
        {
            "location": "173/DIALOG",
            "narrator": "",
            "text": "その後私は\n何日もかけて考えて、\n結果として\n長野に残ることにした。",
            "zh": "那之后，我\n想了好多天，\n结果还是决定\n留在长野。",
            "narrator_zh": ""
        },
        {
            "location": "174/DIALOG",
            "narrator": "",
            "text": "ずっと信州の山中に住んでいた私は、\nやはり年頃ってこともあって、\n東京の大学に行けることを\n内心凄くわくわくしてたんだけどね。",
            "zh": "一直住在信州深山里的我，\n毕竟也正值那个年纪，\n一想到能去东京读大学，\n其实心里兴奋得不得了呢。",
            "narrator_zh": ""
        },
        {
            "location": "176/SEL",
            "narrator": "（選択肢）",
            "text": "そこまでしなくても良かったのでは？",
            "zh": "其实不用做到那种地步吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "177/SEL",
            "narrator": "（選択肢）",
            "text": "大変だったんだね。",
            "zh": "当时一定很辛苦吧。",
            "narrator_zh": "（选项）"
        },
        {
            "location": "178/ACT",
            "narrator": "",
            "text": "そこまでしなくても良かったのでは？",
            "zh": "其实不用做到那种地步吧？",
            "narrator_zh": ""
        },
        {
            "location": "182/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\nまあ普通の家なら\nそうかもしれない。",
            "zh": "是呀。\n嗯，如果是普通家庭，\n或许是那样吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "183/TALK",
            "narrator": "アーヤ",
            "text": "でもうちは両親ともに\n高齢で、結構仕事も\nハードだったし――",
            "zh": "不过我家父母年纪都大了，\n工作也\n相当繁重——",
            "narrator_zh": "绫水"
        },
        {
            "location": "184/ACT",
            "narrator": "",
            "text": "大変だったんだね。",
            "zh": "当时一定很辛苦吧。",
            "narrator_zh": ""
        },
        {
            "location": "188/TALK",
            "narrator": "アーヤ",
            "text": "ありがと。\nあの時は本当に、精神\n的に大変だったわ。",
            "zh": "谢谢。\n那时候，心理上的确\n挺煎熬的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "189/TALK",
            "narrator": "アーヤ",
            "text": "うちは両親ともに\n高齢で、結構仕事も\nハードだったし――",
            "zh": "我家父母年纪都大了，\n工作也\n相当繁重——",
            "narrator_zh": "绫水"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "家も山の上にあるから\n私も姉もいない状態で\n生きていけるか心配で。",
            "zh": "家又建在山上，\n要是连我和姐姐都不在，\n真担心他们怎么生活。",
            "narrator_zh": "绫水"
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "とまあ、\nこんな経緯よ。",
            "zh": "嗯，事情的经过\n大致就是这样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "211/TALK",
            "narrator": "アーヤ",
            "text": "これでだいたい、\n全部お話した。",
            "zh": "到这里，\n差不多全告诉你了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/SEL",
            "narrator": "（選択肢）",
            "text": "東京行きを断念したのが辛かったんだね。",
            "zh": "放弃去东京让你很难受吧。",
            "narrator_zh": "（选项）"
        },
        {
            "location": "213/SEL",
            "narrator": "（選択肢）",
            "text": "お姉さんが何も言わずに行ってしまったのが辛かったんだね。",
            "zh": "姐姐什么都没说就走了让你很难受吧。",
            "narrator_zh": "（选项）"
        },
        {
            "location": "214/ACT",
            "narrator": "",
            "text": "東京行きを断念したのが辛かったんだね。",
            "zh": "放弃去东京让你很难受吧。",
            "narrator_zh": ""
        },
        {
            "location": "215/TALK",
            "narrator": "アーヤ",
            "text": "そうね。",
            "zh": "是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "216/TALK",
            "narrator": "アーヤ",
            "text": "なんで姉ばっかり自由\nに生きて、私ばかり…\nって思ってた。",
            "zh": "凭什么只有姐姐能自由\n自在地活，偏偏我要……\n我当时就是这么想的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "217/TALK",
            "narrator": "アーヤ",
            "text": "でもそれは、\n私が自分で決めて\nやってることだもの。",
            "zh": "不过那也是\n我自己决定\n要做的事嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "218/SEL",
            "narrator": "（選択肢）",
            "text": "責任感あるんだね",
            "zh": "你很有责任感呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "219/ACT",
            "narrator": "",
            "text": "責任感あるんだね",
            "zh": "你很有责任感呢",
            "narrator_zh": ""
        },
        {
            "location": "221/TALK",
            "narrator": "アーヤ",
            "text": "どうかしらね。",
            "zh": "谁知道呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "222/TALK",
            "narrator": "アーヤ",
            "text": "何だかんだで、\n事情はあれ、結局\n今は東京にいるし。",
            "zh": "说到底，虽然各有缘由，\n结果我现在不也\n还是待在东京了嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "223/TALK",
            "narrator": "アーヤ",
            "text": "案外\nチャランポランよ？",
            "zh": "没准我意外地\n很不靠谱哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "224/ACT",
            "narrator": "",
            "text": "お姉さんが何も言わずに行ってしまったのが辛かったんだね。",
            "zh": "姐姐什么都没说就走了让你很难受吧。",
            "narrator_zh": ""
        },
        {
            "location": "225/TALK",
            "narrator": "アーヤ",
            "text": "それはない！",
            "zh": "才没有这回事！",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/TALK",
            "narrator": "アーヤ",
            "text": "寧ろいなくなって\n胸をなで下ろしたわ。",
            "zh": "倒不如说她走了，\n我还松了口气呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "227/SEL",
            "narrator": "（選択肢）",
            "text": "じゃあなんで、いなくなったとき泣いてたの？",
            "zh": "那她走的时候，你为什么在哭呀？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "228/ACT",
            "narrator": "",
            "text": "じゃあなんで、いなくなったとき泣いてたの？",
            "zh": "那她走的时候，你为什么在哭呀？",
            "narrator_zh": ""
        },
        {
            "location": "231/TALK",
            "narrator": "アーヤ",
            "text": "え！？",
            "zh": "诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/TALK",
            "narrator": "アーヤ",
            "text": "あれは…",
            "zh": "那是……",
            "narrator_zh": "绫水"
        },
        {
            "location": "233/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "234/TALK",
            "narrator": "アーヤ",
            "text": "…あまりに腹が立って\n泣けてきちゃっただけ。",
            "zh": "……只是实在太气人了，\n气得掉眼泪而已。",
            "narrator_zh": "绫水"
        },
        {
            "location": "236/TALK",
            "narrator": "アーヤ",
            "text": "さあ、この話は\nもうおしまい！",
            "zh": "好，这个话题\n到此为止！",
            "narrator_zh": "绫水"
        },
        {
            "location": "237/TALK",
            "narrator": "アーヤ",
            "text": "とにかく私は\nもうそんな過去のこと\n引きずりたくないの。",
            "zh": "总之，我已经\n不想再被那种过去的事\n拖着走了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "238/TALK",
            "narrator": "アーヤ",
            "text": "それより今は、\n姉と話して事情を\n聞きたい。",
            "zh": "比起那个，我现在\n想和姐姐谈谈，\n问清楚缘由。",
            "narrator_zh": "绫水"
        },
        {
            "location": "239/TALK",
            "narrator": "アーヤ",
            "text": "いろんなことを\n全部――",
            "zh": "把各种各样的事，\n全都——",
            "narrator_zh": "绫水"
        },
        {
            "location": "240/TALK",
            "narrator": "アーヤ",
            "text": "だから反対派が弱まっ\nて、現実の私が軟化す\nるまで戦い続けるわ。",
            "zh": "所以我会继续战斗，\n直到反对派变弱、\n现实里的我态度软化为止。",
            "narrator_zh": "绫水"
        },
        {
            "location": "241/TALK",
            "narrator": "アーヤ",
            "text": "だから、これからも\nよろしくね。",
            "zh": "所以，今后也\n请多指教了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "243/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、\nまた逢えるのを\n楽しみにしてるわ。",
            "zh": "那么，\n期待着与你\n再次相见哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "252/SEL",
            "narrator": "（選択肢）",
            "text": "ちょっと待った！",
            "zh": "等一下！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "253/ACT",
            "narrator": "",
            "text": "ちょっと待った！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "264/TALK",
            "narrator": "アーヤ",
            "text": "え？？",
            "zh": "诶？？",
            "narrator_zh": "绫水"
        },
        {
            "location": "265/SEL",
            "narrator": "（選択肢）",
            "text": "デートは！？",
            "zh": "约会呢！？",
