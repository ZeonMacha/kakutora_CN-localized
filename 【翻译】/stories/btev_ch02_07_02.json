        },
        {
            "location": "405/TALK",
            "narrator": "アーヤ",
            "text": "もうっ。\n調子に乗らないの。",
            "zh": "真是的。\n别得意忘形呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "407/TALK",
            "narrator": "アーヤ",
            "text": "ダメだって！",
            "zh": "说不行啦！",
            "narrator_zh": "绫水"
        },
        {
            "location": "415/TALK",
            "narrator": "アーヤ",
            "text": "もうっ！\nくすぐったいってば。",
            "zh": "真是的！\n好痒的啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "417/TALK",
            "narrator": "アーヤ",
            "text": "もしかして\nおなか出てる？",
            "zh": "难道说\n小肚子鼓起来了？",
