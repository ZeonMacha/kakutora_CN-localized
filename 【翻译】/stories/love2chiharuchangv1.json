    "entry": [
        {
            "location": "506/SCENARIO",
            "narrator": "",
            "text": "千羽鶴恋愛ゲーム",
            "zh": "千羽鹤恋爱游戏",
            "narrator_zh": ""
        },
        {
            "location": "526/TALK",
            "narrator": "千羽鶴",
            "text": "ここは、必ず恋が\n成就するといわれている、\n伝説の草原。",
            "zh": "这里，据说恋爱\n一定会成真，\n是传说中的草原。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "527/SEL",
            "narrator": "",
            "text": "キャベツ畑じゃ…",
            "zh": "这是卷心菜地吧……",
            "narrator_zh": ""
        },
        {
            "location": "528/ACT",
            "narrator": "",
            "text": "キャベツ畑じゃ…",
            "zh": "这是卷心菜地吧……",
            "narrator_zh": ""
        },
        {
            "location": "530/TALK",
            "narrator": "千羽鶴",
            "text": "予算の都合。\n脳内で補完して。",
            "zh": "预算问题。\n在脑子里补上。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "531/TALK",
            "narrator": "千羽鶴",
            "text": "そこには今日も、\n素敵な恋を求めて\nカップルが集う――",
            "zh": "今天那里也一样，\n为了美好的恋爱，\n情侣们聚在一起——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "532/SEL",
            "narrator": "",
            "text": "なんで千羽鶴がナレーションを…",
            "zh": "为什么旁白是千羽鹤……",
            "narrator_zh": ""
        },
        {
            "location": "533/ACT",
            "narrator": "",
            "text": "なんで千羽鶴がナレーションを…",
            "zh": "为什么旁白是千羽鹤……",
            "narrator_zh": ""
        },
        {
            "location": "535/TALK",
            "narrator": "千羽鶴",
            "text": "私は千羽鶴じゃない。\nナレーション・チー。",
            "zh": "我不是千羽鹤。\n我是旁白小千。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "536/SEL",
            "narrator": "",
            "text": "あ、はい…",
            "zh": "啊，好……",
            "narrator_zh": ""
        },
        {
            "location": "537/ACT",
            "narrator": "",
            "text": "あ、はい…",
            "zh": "啊，好……",
            "narrator_zh": ""
        },
        {
            "location": "539/TALK",
            "narrator": "千羽鶴",
            "text": "――これは、そんな\n素敵な地での、１つの\n恋の物語。",
            "zh": "——这是，在那样\n美好的地方，一个\n恋爱故事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "541/TALK",
            "narrator": "千羽鶴",
            "text": "あっ、あなたは！",
            "zh": "啊，是你！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "542/TALK",
            "narrator": "千羽鶴",
            "text": "好きです！\nつき合ってください！",
            "zh": "我喜欢你！\n请和我交往！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "543/SEL",
            "narrator": "",
            "text": "喜んで！",
            "zh": "我愿意！",
            "narrator_zh": ""
        },
        {
            "location": "544/SEL",
            "narrator": "",
            "text": "早っ！",
            "zh": "太早了！",
            "narrator_zh": ""
        },
        {
            "location": "545/SEL",
            "narrator": "",
            "text": "恋愛ゲーは段取りが重要ですよ",
            "zh": "恋爱游戏很讲究步骤的",
            "narrator_zh": ""
        },
        {
            "location": "546/ACT",
            "narrator": "",
            "text": "喜んで！",
            "zh": "我愿意！",
            "narrator_zh": ""
        },
        {
            "location": "548/TALK",
            "narrator": "千羽鶴",
            "text": "早すぎ！\n嫌いよ！",
            "zh": "太早了！\n讨厌！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "549/TALK",
            "narrator": "千羽鶴",
            "text": "ゲームオーバー。",
            "zh": "游戏结束。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "550/SEL",
            "narrator": "",
            "text": "えええええ……",
            "zh": "诶诶诶诶……",
            "narrator_zh": ""
        },
        {
            "location": "551/ACT",
            "narrator": "",
            "text": "えええええ……",
            "zh": "诶诶诶诶……",
            "narrator_zh": ""
        },
        {
            "location": "554/ACT",
            "narrator": "",
            "text": "早っ！",
            "zh": "太早了！",
            "narrator_zh": ""
        },
        {
            "location": "556/TALK",
            "narrator": "千羽鶴",
            "text": "だって！\nもう貴方無しでは\n生きていけないもの！",
            "zh": "因为！\n没有你的话，\n我已经活不下去了！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "557/SEL",
            "narrator": "",
            "text": "$me$もだよ、千羽鶴！",
            "zh": "$me$也是，千羽鹤！",
            "narrator_zh": ""
        },
        {
            "location": "558/SEL",
            "narrator": "",
            "text": "ダメだ！$me$がいなくても一人で生きていくんだ千羽鶴。",
            "zh": "不行！就算没有$me$，千羽鹤也要一个人活下去。",
            "narrator_zh": ""
        },
        {
            "location": "559/ACT",
            "narrator": "",
            "text": "$me$もだよ、千羽鶴！",
            "zh": "$me$也是，千羽鹤！",
            "narrator_zh": ""
        },
        {
            "location": "561/TALK",
            "narrator": "千羽鶴",
            "text": "嬉しい！\n$handle$…。",
            "zh": "好开心！\n$handle$……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "562/TALK",
            "narrator": "千羽鶴",
            "text": "じゃあ、これからも毎日\nこのアプリを起動して\nくれるわね？",
            "zh": "那你以后每天\n都会打开这个应用\n吧？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "563/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "好",
            "narrator_zh": ""
        },
        {
            "location": "564/SEL",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "565/SEL",
            "narrator": "",
            "text": "イエス！",
            "zh": "Yes！",
            "narrator_zh": ""
        },
        {
            "location": "566/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "好",
            "narrator_zh": ""
        },
        {
            "location": "567/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "568/ACT",
            "narrator": "",
            "text": "イエス！",
            "zh": "Yes！",
            "narrator_zh": ""
        },
        {
            "location": "570/TALK",
            "narrator": "千羽鶴",
            "text": "よかった。\nめでたしめでたし。",
            "zh": "太好了。\n从此幸福快乐。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "571/TALK",
            "narrator": "千羽鶴",
            "text": "おしまい。",
            "zh": "完。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "572/SEL",
            "narrator": "",
            "text": "千羽鶴と恋人になれたの？",
            "zh": "和千羽鹤成为恋人了吗？",
            "narrator_zh": ""
        },
        {
            "location": "573/ACT",
            "narrator": "",
            "text": "千羽鶴と恋人になれたの？",
            "zh": "和千羽鹤成为恋人了吗？",
            "narrator_zh": ""
        },
        {
            "location": "575/TALK",
            "narrator": "千羽鶴",
            "text": "いいえ。",
            "zh": "没有。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "576/TALK",
            "narrator": "千羽鶴",
            "text": "貴方がアプリを毎日起動\nするって約束してくれた\nからハッピーエンド。",
            "zh": "因为你答应\n每天打开这个应用，\n所以是好结局。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "577/TALK",
            "narrator": "千羽鶴",
            "text": "これぞWIN-WIN。",
            "zh": "这才叫WIN-WIN。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "578/SEL",
            "narrator": "",
            "text": "いやいやいや、選択の余地なかったし",
            "zh": "不不不不，根本没得选",
            "narrator_zh": ""
        },
        {
            "location": "579/ACT",
            "narrator": "",
            "text": "いやいやいや、選択の余地なかったし",
            "zh": "不不不不，根本没得选",
            "narrator_zh": ""
        },
        {
            "location": "581/TALK",
            "narrator": "千羽鶴",
            "text": "ちゃんと三択\n用意してるし。",
            "zh": "三个选项\n我准备好了的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "582/SEL",
            "narrator": "",
            "text": "全部同じじゃん",
            "zh": "不都一样吗",
            "narrator_zh": ""
        },
        {
            "location": "583/ACT",
            "narrator": "",
            "text": "全部同じじゃん",
            "zh": "不都一样吗",
            "narrator_zh": ""
        },
        {
            "location": "585/TALK",
            "narrator": "千羽鶴",
            "text": "微妙なニュアンスが\n違うから、気分によって\n選択できる。",
            "zh": "语气有细微差别，\n可以按心情\n来选。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "586/TALK",
            "narrator": "千羽鶴",
            "text": "とにかくハッピーエンドは\nハッピーエンドだから。\nおしまい。",
            "zh": "总之好结局\n就是好结局。\n完。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "588/ACT",
            "narrator": "",
            "text": "ダメだ！$me$がいなくても一人で生きていくんだ千羽鶴。",
            "zh": "不行！就算没有$me$，千羽鹤也要一个人活下去。",
            "narrator_zh": ""
        },
        {
            "location": "589/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "590/SEL",
            "narrator": "",
            "text": "は？",
            "zh": "啊？",
            "narrator_zh": ""
        },
        {
            "location": "591/ACT",
            "narrator": "",
            "text": "は？",
            "zh": "啊？",
            "narrator_zh": ""
        },
        {
            "location": "593/TALK",
            "narrator": "千羽鶴",
            "text": "ゲームオーバー。",
            "zh": "游戏结束。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "596/ACT",
            "narrator": "",
            "text": "恋愛ゲーは段取りが重要ですよ",
            "zh": "恋爱游戏很讲究步骤的",
            "narrator_zh": ""
        },
        {
            "location": "597/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "599/TALK",
            "narrator": "千羽鶴",
            "text": "ちょっとお花を\n摘みに行ってくるわ♪",
            "zh": "我去摘朵花，\n马上回来♪",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "602/TALK",
            "narrator": "千羽鶴",
            "text": "$handle$よ。\n私はこの世界を司る神。",
            "zh": "$handle$。\n我是主宰这个世界的神。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "603/SEL",
            "narrator": "",
            "text": "何やってるんすか、千羽鶴さん…",
            "zh": "你在干什么啊，千羽鹤……",
            "narrator_zh": ""
        },
        {
            "location": "604/ACT",
            "narrator": "",
            "text": "何やってるんすか、千羽鶴さん…",
            "zh": "你在干什么啊，千羽鹤……",
            "narrator_zh": ""
        },
        {
            "location": "606/TALK",
            "narrator": "千羽鶴",
            "text": "千羽鶴ではありません。\n私は神。",
            "zh": "不是千羽鹤。\n我是神。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "607/TALK",
            "narrator": "千羽鶴",
            "text": "貴方はこの世界の摂理に\n文句をつけました。",
            "zh": "你对这个世界的法则\n提出了异议。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "608/TALK",
            "narrator": "千羽鶴",
            "text": "文句をつけるからには\n貴方の主張を述べなさい。\n20文字以内で。",
            "zh": "既然有异议，\n就说出你的主张。\n二十个字以内。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "609/SEL",
            "narrator": "",
            "text": "いきなり告白されても感情移入できません",
            "zh": "突然告白，代入不进去",
            "narrator_zh": ""
        },
        {
            "location": "610/SEL",
            "narrator": "",
            "text": "もっと千羽鶴さんの可愛い所見たりデートしたりしたいです",
            "zh": "还想多看看千羽鹤那些可爱的样子，也想和她一起去约会",
            "narrator_zh": ""
        },
        {
            "location": "611/ACT",
            "narrator": "",
            "text": "いきなり告白されても感情移入できません",
            "zh": "突然告白，代入不进去",
            "narrator_zh": ""
        },
        {
            "location": "612/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。\n$handle$の\n言い分はわかりました。",
            "zh": "原来如此。\n$handle$的\n说法我明白了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "613/TALK",
            "narrator": "千羽鶴",
            "text": "それでは、\n５秒待ちなさい。",
            "zh": "那么，\n等五秒。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "614/SEL",
            "narrator": "",
            "text": "あ、はい…",
            "zh": "啊，好……",
            "narrator_zh": ""
        },
        {
            "location": "615/ACT",
            "narrator": "",
            "text": "あ、はい…",
            "zh": "啊，好……",
            "narrator_zh": ""
        },
        {
            "location": "618/TALK",
            "narrator": "千羽鶴",
            "text": "……できた。",
            "zh": "……好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "621/TALK",
            "narrator": "千羽鶴",
            "text": "まあ！\n貴方は$handle$！",
            "zh": "哎呀！\n你是$handle$！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "623/TALK",
            "narrator": "千羽鶴",
            "text": "私は中学校卒業後父の稼業\nが破綻して倒産したことで\n高校を退学することになり",
            "zh": "我中学毕业后父亲的生\n意破产倒闭，于是我只\n好从高中退了学",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "624/TALK",
            "narrator": "千羽鶴",
            "text": "泣く泣く働いていたのだけ\nどクリーニング屋のおば\nちゃんに勧められたことで",
            "zh": "哭着打过工，不\n过洗衣店的阿\n姨劝了我，于是",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "625/TALK",
            "narrator": "千羽鶴",
            "text": "クリーニングフランチャイ\nズを始め経営も軌道に乗り\nかけていた矢先に株価が大",
            "zh": "办起了洗衣连\n锁，经营刚上轨\n道，股价就大",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "626/TALK",
            "narrator": "千羽鶴",
            "text": "暴落して夜逃げしている所\nだったの！そんな矢先に小\n学校の幼馴染み設定（１年",
            "zh": "暴跌，我正要连夜跑\n路！就在这时，小\n学同学设定（一年",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "627/TALK",
            "narrator": "千羽鶴",
            "text": "でクラスが一緒だった）の\n$handle$と駅前で\n運命的な出会いをして",
            "zh": "级同班）的\n$handle$，在车站前\n和我命运般重逢",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "629/TALK",
            "narrator": "千羽鶴",
            "text": "そして今私たちは\n運命のキャベツ畑にいる♪",
            "zh": "于是现在我们\n就在命运的卷心菜地里♪",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "630/SEL",
            "narrator": "",
            "text": "設定が破綻してるんですけど……",
            "zh": "设定已经崩了……",
            "narrator_zh": ""
        },
        {
            "location": "631/SEL",
            "narrator": "",
            "text": "説明口調すぎる！",
            "zh": "解说腔也太重了！",
            "narrator_zh": ""
        },
        {
            "location": "632/SEL",
            "narrator": "",
            "text": "さっきキャベツ畑だって言ったら否定したじゃん！",
            "zh": "刚才我说卷心菜地，你还否认了！",
            "narrator_zh": ""
        },
        {
            "location": "633/SEL",
            "narrator": "",
            "text": "なんて感動的な再会なんだ…これは奇跡だ！",
            "zh": "多么感人的重逢……这是奇迹！",
            "narrator_zh": ""
        },
        {
            "location": "634/ACT",
            "narrator": "",
            "text": "設定が破綻してるんですけど……",
            "zh": "设定已经崩了……",
            "narrator_zh": ""
        },
        {
            "location": "635/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "636/TALK",
            "narrator": "千羽鶴",
            "text": "貴方には１つ覚えておいて\n欲しい言葉がある。",
            "zh": "有一句话，\n希望你记住。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "637/TALK",
            "narrator": "千羽鶴",
            "text": "<size=30>現実は\n小説より奇なり！</size>",
            "zh": "<size=30>现实\n比小说更离奇！</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "638/TALK",
            "narrator": "千羽鶴",
            "text": "激動の過去を語られて\nその切なさにホロリと来て\n好きになる――",
            "zh": "听完跌宕的过去，\n酸得让人眼眶一热，\n于是喜欢上——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "641/TALK",
            "narrator": "千羽鶴",
            "text": "恋愛モノの\n常套手段だから！",
            "zh": "这是恋爱作品的\n惯用手段！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "642/SEL",
            "narrator": "",
            "text": "全然ホロリとしないんですけど",
            "zh": "我完全没觉得鼻酸",
            "narrator_zh": ""
        },
        {
            "location": "643/ACT",
            "narrator": "",
            "text": "全然ホロリとしないんですけど",
            "zh": "我完全没觉得鼻酸",
            "narrator_zh": ""
        },
        {
            "location": "646/TALK",
            "narrator": "千羽鶴",
            "text": "…そう。",
            "zh": "……是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "647/TALK",
            "narrator": "千羽鶴",
            "text": "じゃあ\nゲームオーバー。",
            "zh": "那就\n游戏结束。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "648/SEL",
            "narrator": "",
            "text": "ええええええ！！",
            "zh": "诶诶诶诶！！",
            "narrator_zh": ""
        },
        {
            "location": "649/ACT",
            "narrator": "",
            "text": "ええええええ！！",
            "zh": "诶诶诶诶！！",
            "narrator_zh": ""
        },
        {
            "location": "652/ACT",
            "narrator": "",
            "text": "説明口調すぎる！",
            "zh": "解说腔也太重了！",
            "narrator_zh": ""
        },
        {
            "location": "653/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "656/TALK",
            "narrator": "千羽鶴",
            "text": "仕方ないのです。\n予算の都合だから。",
            "zh": "没办法。\n预算就这样。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "657/TALK",
            "narrator": "千羽鶴",
            "text": "貴方の脳内で\n素晴らしい演出と\n泣ける会話に変換して。",
            "zh": "请在你脑子里\n把这些换成精彩演出\n和催泪的对白。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "658/SEL",
            "narrator": "",
            "text": "神様…",
            "zh": "神啊……",
            "narrator_zh": ""
        },
        {
            "location": "659/ACT",
            "narrator": "",
            "text": "神様…",
            "zh": "神啊……",
            "narrator_zh": ""
        },
        {
            "location": "661/TALK",
            "narrator": "千羽鶴",
            "text": "壮大なドラマに\nなりましたか？",
            "zh": "变成宏大的戏\n了吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "662/TALK",
            "narrator": "千羽鶴",
            "text": "それでは、その結末を\n胸に、ハッピーエンド。",
            "zh": "那么，把这个结局\n放在心里，好结局。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "664/ACT",
            "narrator": "",
            "text": "さっきキャベツ畑だって言ったら否定したじゃん！",
            "zh": "刚才我说卷心菜地，你还否认了！",
            "narrator_zh": ""
        },
        {
            "location": "665/TALK",
            "narrator": "千羽鶴",
            "text": "さっきの世界と\n今の世界は別の次元に\n存在している。",
            "zh": "刚才那个世界\n和现在这个世界\n处在不同次元。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "667/TALK",
            "narrator": "千羽鶴",
            "text": "その微妙な時空のねじれを\n感じ取って欲しかった。",
            "zh": "我想让你感觉到\n那点微妙的时空扭曲。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "668/SEL",
            "narrator": "",
            "text": "えと、これ、恋愛ゲーですよね？",
            "zh": "那个，这是恋爱游戏吧？",
            "narrator_zh": ""
        },
        {
            "location": "669/ACT",
            "narrator": "",
            "text": "えと、これ、恋愛ゲーですよね？",
            "zh": "那个，这是恋爱游戏吧？",
            "narrator_zh": ""
        },
        {
            "location": "671/TALK",
            "narrator": "千羽鶴",
            "text": "そう。正確には\nＳＦ恋愛アドベンチャー。",
            "zh": "是的。准确说，\n是SF恋爱冒险。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "672/TALK",
            "narrator": "千羽鶴",
            "text": "だから時には、恋愛より\n時空間考察が重要になる\n局面もある！",
            "zh": "所以有时候，比起恋爱，\n考察时空\n才更重要！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "673/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\nゲームオーバー。",
            "zh": "所以，\n游戏结束。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "675/ACT",
            "narrator": "",
            "text": "なんて感動的な再会なんだ…これは奇跡だ！",
            "zh": "多么感人的重逢……这是奇迹！",
            "narrator_zh": ""
        },
        {
            "location": "678/TALK",
            "narrator": "千羽鶴",
            "text": "えっ……！？",
            "zh": "诶……！？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "679/TALK",
            "narrator": "千羽鶴",
            "text": "まさか、この流れで\n真面目に演じるなんて。",
            "zh": "没想到，\n这种走向你还认真演。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "680/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "681/TALK",
            "narrator": "千羽鶴",
            "text": "ちょっと\nキュンとなったかも。",
            "zh": "好像\n有点心动。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "683/TALK",
            "narrator": "千羽鶴",
            "text": "……これあげる。",
            "zh": "……这个给你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "689/TALK",
            "narrator": "千羽鶴",
            "text": "でも残念ながら\n千羽鶴とは結ばれない。",
            "zh": "不过很遗憾，\n不会和千羽鹤在一起。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "690/SEL",
            "narrator": "",
            "text": "え？なんで？？",
            "zh": "诶？为什么？？",
            "narrator_zh": ""
        },
        {
            "location": "691/ACT",
            "narrator": "",
            "text": "え？なんで？？",
            "zh": "诶？为什么？？",
            "narrator_zh": ""
        },
        {
            "location": "693/TALK",
            "narrator": "千羽鶴",
            "text": "彼女は悲劇のヒロイン\n設定だから！",
            "zh": "因为她的设定\n是悲剧女主角！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "694/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\nゲームオーバー。",
            "zh": "所以，\n游戏结束。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "697/ACT",
            "narrator": "",
            "text": "もっと千羽鶴さんの可愛い所見たりデートしたりしたいです",
            "zh": "还想多看看千羽鹤那些可爱的样子，也想和她一起去约会",
            "narrator_zh": ""
        },
        {
            "location": "701/TALK",
            "narrator": "千羽鶴",
            "text": "あ、止まった。",
            "zh": "啊，卡住了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "702/SEL",
            "narrator": "",
            "text": "なんで！？",
            "zh": "为什么！？",
            "narrator_zh": ""
        },
        {
            "location": "703/ACT",
            "narrator": "",
            "text": "なんで！？",
            "zh": "为什么！？",
            "narrator_zh": ""
        },
        {
            "location": "706/TALK",
            "narrator": "千羽鶴",
            "text": "返事は２０文字以内って\n言ったはず。",
            "zh": "我说过，回复要在\n二十个字以内。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "707/TALK",
            "narrator": "千羽鶴",
            "text": "２７文字も送信したら\n止まるに決まってる。",
            "zh": "发了25个字，\n当然会卡住。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "708/SEL",
            "narrator": "",
            "text": "脆弱すぎやしませんか？",
            "zh": "是不是太脆弱了？",
            "narrator_zh": ""
        },
        {
            "location": "709/ACT",
            "narrator": "",
            "text": "脆弱すぎやしませんか？",
            "zh": "是不是太脆弱了？",
            "narrator_zh": ""
        },
        {
            "location": "711/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "712/TALK",
            "narrator": "千羽鶴",
            "text": "……まあ。",
            "zh": "……好吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "713/TALK",
            "narrator": "千羽鶴",
            "text": "確かにそうかも。",
            "zh": "确实可能是这样。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "715/TALK",
            "narrator": "千羽鶴",
            "text": "………ごめん。",
            "zh": "………对不起。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "717/TALK",
            "narrator": "千羽鶴",
            "text": "とにかく残念だけど、\n今回はここでお終い。",
            "zh": "总之很遗憾，\n这次到这里结束。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "686/DIALOG",
            "narrator": "Dialog_GETcandy_SY",
            "text": "<color=white>+10</color>",
            "zh": "<color=white>+10</color>",
            "narrator_zh": "Dialog_GETcandy_SY"
        },
        {
            "location": "700/DIALOG",
            "narrator": "Dialog_Notice",
            "text": "<color=red>不正な処理エラー</color>\n文字数がオーバーフローしました",
            "zh": "<color=red>非法处理错误</color>\n字数溢出了",
            "narrator_zh": "Dialog_Notice"
        }
    ]
}
