            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "ガブリエラ",
            "text": "私どうしてこうなのかしらね",
            "zh": "我怎么会变成这样呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "199/ACT",
            "narrator": "",
            "text": "素直になりなよ",
            "zh": "坦率一点嘛",
            "narrator_zh": ""
        },
        {
            "location": "200/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなの",
            "zh": "那种事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "201/TALK",
            "narrator": "ガブリエラ",
            "text": "出来たら苦労しないわ",
            "zh": "做得到的话就不用这么辛苦了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "202/ACT",
            "narrator": "",
            "text": "アーヤはわかってくれてるよ",
            "zh": "绫水明白的",
            "narrator_zh": ""
        },
        {
            "location": "204/TALK",
            "narrator": "ガブリエラ",
            "text": "そう",
            "zh": "是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "ガブリエラ",
            "text": "かしら？",
