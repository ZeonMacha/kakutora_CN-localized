        },
        {
            "location": "167/TALK",
            "narrator": "ガブリエラ",
            "text": "なのよね",
            "zh": "没错吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/ACT",
            "narrator": "",
            "text": "そういう人いるよね",
