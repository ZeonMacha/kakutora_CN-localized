        },
        {
            "location": "6061/SEL",
            "narrator": "",
            "text": "神楽のためならどうにかして…",
            "zh": "为了神乐的话，我会想想办法……",
            "narrator_zh": ""
        },
        {
            "location": "6062/ACT",
            "narrator": "",
            "text": "四万人中二桁らしいよ",
            "zh": "四万人里好像只有两位数",
            "narrator_zh": ""
        },
        {
            "location": "6063/TALK",
            "narrator": "神楽",
            "text": "少なっ！！！！",
            "zh": "好少！！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "6064/TALK",
            "narrator": "神楽",
            "text": "でもいるんだーすげー",
            "zh": "可是真的有啊，好厉害",
