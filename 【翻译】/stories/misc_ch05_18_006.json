        },
        {
            "location": "6053/TALK",
            "narrator": "神楽",
            "text": "$handlek$は健康優良児ダナー",
            "zh": "$handlek$是健康优良儿啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "6055/TALK",
            "narrator": "神楽",
            "text": "なんかさー",
