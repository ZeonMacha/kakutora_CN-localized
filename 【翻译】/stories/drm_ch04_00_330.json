{
    "dir": "dramatics/daydra/drm_ch04_00_330.js",
    "type": "Episode",
    "info": {
        "story_id": "4033",
        "cid": "miyabi",
        "title": "らぶとーく 第33話",
        "sub_title": "偶然だらけの赤い糸",
        "title_zh": "恋爱漫谈 第33话",
        "sub_title_zh": "全是偶然的红线"
    },
    "entry": [
        {
            "location": "198/SCENARIO",
            "narrator": "",
            "text": "偶然だらけの赤い糸",
            "zh": "全是偶然的红线",
            "narrator_zh": ""
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん…\n迷うわ……。",
            "zh": "唔嗯……\n好难选啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "212/TALK",
            "narrator": "ガブリエラ",
            "text": "季節限定って\n悪魔のささやきよね…。",
            "zh": "季节限定真是\n恶魔的低语呀……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "ガブリエラ",
            "text": "でも\n人気ナンバーワンにも\n惹かれるし…。",
            "zh": "不过\n最人气第一名也让人\n心动……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "214/TALK",
            "narrator": "みやび",
            "text": "うちもケーキを\n頼もうかね。",
            "zh": "我也点一份\n蛋糕吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "そんでガブちゃんと\nシェアすりゃええろう。",
            "zh": "那就跟加布\n分享就好了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？\nいいの？",
            "zh": "诶！？\n可以吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "218/TALK",
            "narrator": "みやび",
            "text": "そのままじゃ\n決められそうに\nないけんね。",
            "zh": "照这样下去\n恐怕定不下来\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "221/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなこと\nないけど……。",
            "zh": "那种事\n倒没有……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "でも今日は\nそうさせてもらうわ。",
            "zh": "不过今天就\n让我这样吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "そうそう。",
            "zh": "对对。",
            "narrator_zh": "雅"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "でもね、みやび。",
            "zh": "不过呢，雅。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/TALK",
            "narrator": "みやび",
            "text": "何ぞね。",
            "zh": "是驷马咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、普段は\n決断は早いほうなの。",
            "zh": "我平时的\n决断算是快的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "みやび",
            "text": "うん？",
            "zh": "嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "反射神経で\n決めるっていうの\nかしら。",
            "zh": "该说是凭\n反射神经做决定\n的那种吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "230/TALK",
            "narrator": "ガブリエラ",
            "text": "そしてその勘は\nあまり外れないって\n思ってるわ。",
            "zh": "然后那份直觉\n不太会错，\n我是这么想的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "231/TALK",
            "narrator": "みやび",
            "text": "…野性的やねえ。",
            "zh": "……真是野性咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "232/TALK",
            "narrator": "ガブリエラ",
            "text": "戦場では大事な\n能力よ。",
            "zh": "在战场上可是\n很重要的能力哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "……はあ。",
            "zh": "……唉。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "235/TALK",
            "narrator": "みやび",
            "text": "どういた？",
            "zh": "怎么了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "……ん……。",
            "zh": "……唔……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/TALK",
            "narrator": "ガブリエラ",
            "text": "恋愛でも\nそうだといいのにって\n思っただけ。",
            "zh": "只是想想，恋爱里\n要也能这样\n就好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "246/TALK",
            "narrator": "みやび",
            "text": "チキチキ",
            "zh": "啾啾",
            "narrator_zh": "雅"
        },
        {
            "location": "247/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん恋愛相談会！",
            "zh": "加布的恋爱咨询会！",
            "narrator_zh": "雅"
        },
        {
            "location": "249/SEL",
            "narrator": "",
            "text": "ガブリエラの、なの？　ガブリエラが、なの？",
            "zh": "是加布里埃拉的，还是加布里埃拉的？",
            "narrator_zh": ""
        },
        {
            "location": "250/SEL",
            "narrator": "",
            "text": "いや、話してるのみやびだよね",
            "zh": "不对，说话的这是雅吧",
            "narrator_zh": ""
        },
        {
            "location": "251/SEL",
            "narrator": "",
            "text": "うん、頑張って",
            "zh": "嗯，加油",
            "narrator_zh": ""
        },
        {
            "location": "252/ACT",
            "narrator": "",
            "text": "ガブリエラの、なの？　ガブリエラが、なの？",
            "zh": "是加布里埃拉的，还是加布里埃拉的？",
            "narrator_zh": ""
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "ご想像にお任せする",
            "zh": "就任你想象",
            "narrator_zh": "雅"
        },
        {
            "location": "254/ACT",
            "narrator": "",
            "text": "いや、話してるのみやびだよね",
            "zh": "不对，说话的这是雅吧",
            "narrator_zh": ""
        },
        {
            "location": "255/TALK",
            "narrator": "みやび",
            "text": "うちはただのエージェント",
            "zh": "我不过是个特工",
            "narrator_zh": "雅"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "クライアントはガブちゃんぞね",
            "zh": "委托人是加布咧",
            "narrator_zh": "雅"
        },
        {
            "location": "257/ACT",
            "narrator": "",
            "text": "うん、頑張って",
            "zh": "嗯，加油",
            "narrator_zh": ""
        },
        {
            "location": "258/TALK",
            "narrator": "みやび",
            "text": "ややや",
            "zh": "呀呀呀",
            "narrator_zh": "雅"
        },
        {
            "location": "259/TALK",
            "narrator": "みやび",
            "text": "他人事か",
            "zh": "当别人的事啊",
            "narrator_zh": "雅"
        },
        {
            "location": "260/TALK",
            "narrator": "みやび",
            "text": "他人事だが",
            "zh": "虽说是别人的事",
            "narrator_zh": "雅"
        },
        {
            "location": "267/TALK",
            "narrator": "みやび",
            "text": "それはうちが聞いて\n大丈夫なことかね？",
            "zh": "那个我问了\n没关系咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、別に深刻な\n話じゃないわ。\n一般論よ。",
            "zh": "啊，不是什么\n严肃的话题哦。\n就是一般论。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "269/TALK",
            "narrator": "みやび",
            "text": "一般論、ねえ。",
            "zh": "一般论啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "270/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうみやびは\nどうなのよ？",
            "zh": "那这样的雅\n又怎么样呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "271/TALK",
            "narrator": "みやび",
            "text": "うちか？",
            "zh": "我咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "272/TALK",
            "narrator": "みやび",
            "text": "うちには恋人が\nもうおるけんね。",
            "zh": "我的恋人啊，\n早就有了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "273/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？\n誰！？",
            "zh": "诶！？\n谁啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "275/TALK",
            "narrator": "みやび",
            "text": "いつもチャットとか\nしとる相手。",
            "zh": "平时一直在\n聊天的对象。",
            "narrator_zh": "雅"
        },
        {
            "location": "276/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に！？\n本当にそうなの！？",
            "zh": "真的吗！？\n真的是那样！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "277/TALK",
            "narrator": "みやび",
            "text": "何ぞね。\nそのおどろきようは。",
            "zh": "驷马咧。\n这份惊讶是怎么回事。",
            "narrator_zh": "雅"
        },
        {
            "location": "279/TALK",
            "narrator": "ガブリエラ",
            "text": "だって！",
            "zh": "因为！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "288/TALK",
            "narrator": "みやび",
            "text": "チキチキ",
            "zh": "啾啾",
            "narrator_zh": "雅"
        },
        {
            "location": "289/TALK",
            "narrator": "みやび",
            "text": "続・恋愛相談会！",
            "zh": "续·恋爱咨询会！",
            "narrator_zh": "雅"
        },
        {
            "location": "291/SEL",
            "narrator": "",
            "text": "今度は何",
            "zh": "这次又是什么",
            "narrator_zh": ""
        },
        {
            "location": "292/SEL",
            "narrator": "",
            "text": "いや、聞いてたけど",
            "zh": "不，我听到了啊",
            "narrator_zh": ""
        },
        {
            "location": "293/ACT",
            "narrator": "",
            "text": "今度は何",
            "zh": "这次又是什么",
            "narrator_zh": ""
        },
        {
            "location": "294/TALK",
            "narrator": "みやび",
            "text": "何もかにも",
            "zh": "样样都有",
            "narrator_zh": "雅"
        },
        {
            "location": "295/ACT",
            "narrator": "",
            "text": "いや、聞いてたけど",
            "zh": "不，我听到了啊",
            "narrator_zh": ""
        },
        {
            "location": "296/TALK",
            "narrator": "みやび",
            "text": "ならわかろう",
            "zh": "那就懂了啵",
            "narrator_zh": "雅"
        },
        {
            "location": "298/TALK",
            "narrator": "みやび",
            "text": "$handle$が恋人だと言うたら",
            "zh": "要是说$handle$是恋人",
            "narrator_zh": "雅"
        },
        {
            "location": "299/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんが取り乱しおった",
            "zh": "加布都慌了神咯",
            "narrator_zh": "雅"
        },
        {
            "location": "301/SEL",
            "narrator": "",
            "text": "$me$も取り乱してるよ",
            "zh": "$me$也慌了哦",
            "narrator_zh": ""
        },
        {
            "location": "302/SEL",
            "narrator": "",
            "text": "そうだろうね",
            "zh": "应该是吧",
            "narrator_zh": ""
        },
        {
            "location": "303/SEL",
            "narrator": "",
            "text": "いっそ本当のことにしよう",
            "zh": "干脆当成真的吧",
            "narrator_zh": ""
        },
        {
            "location": "304/ACT",
            "narrator": "",
            "text": "$me$も取り乱してるよ",
            "zh": "$me$也慌了哦",
            "narrator_zh": ""
        },
        {
            "location": "305/TALK",
            "narrator": "みやび",
            "text": "なんで",
            "zh": "为什么",
            "narrator_zh": "雅"
        },
        {
            "location": "307/SEL",
            "narrator": "",
            "text": "願望が現実になったから",
            "zh": "因为愿望成真了",
            "narrator_zh": ""
        },
        {
            "location": "308/ACT",
            "narrator": "",
            "text": "願望が現実になったから",
            "zh": "因为愿望成真了",
            "narrator_zh": ""
        },
        {
            "location": "309/TALK",
            "narrator": "みやび",
            "text": "冗談という言葉を知らんのか",
            "zh": "不知道玩笑这个词咩",
            "narrator_zh": "雅"
        },
        {
            "location": "310/TALK",
            "narrator": "みやび",
            "text": "$handle$め",
            "zh": "$handle$这家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "312/ACT",
            "narrator": "",
            "text": "そうだろうね",
            "zh": "应该是吧",
            "narrator_zh": ""
        },
        {
            "location": "313/TALK",
            "narrator": "みやび",
            "text": "なんだ",
            "zh": "什么事",
            "narrator_zh": "雅"
        },
        {
            "location": "314/TALK",
            "narrator": "みやび",
            "text": "その落ち着きは",
            "zh": "那份从容",
            "narrator_zh": "雅"
        },
        {
            "location": "316/SEL",
            "narrator": "",
            "text": "$me$にとっては事実なだけだから",
            "zh": "对$me$来说，这只是事实而已",
            "narrator_zh": ""
        },
        {
            "location": "317/ACT",
            "narrator": "",
            "text": "$me$にとっては事実なだけだから",
            "zh": "对$me$来说，这只是事实而已",
            "narrator_zh": ""
        },
        {
            "location": "318/TALK",
            "narrator": "みやび",
            "text": "は",
            "zh": "哈？",
            "narrator_zh": "雅"
        },
        {
            "location": "319/TALK",
            "narrator": "みやび",
            "text": "それはうちにとっては",
            "zh": "那个对我来说嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "320/TALK",
            "narrator": "みやび",
            "text": "事実ではないぞね",
            "zh": "可不是事实咧",
            "narrator_zh": "雅"
        },
        {
            "location": "322/ACT",
            "narrator": "",
            "text": "いっそ本当のことにしよう",
            "zh": "干脆当成真的吧",
            "narrator_zh": ""
        },
        {
            "location": "323/TALK",
            "narrator": "みやび",
            "text": "いっそとは",
            "zh": "说什么「干脆」啊",
            "narrator_zh": "雅"
        },
        {
            "location": "325/SEL",
            "narrator": "",
            "text": "$me$はみやびとつきあいたいと思ってた",
            "zh": "$me$一直想跟雅交往",
            "narrator_zh": ""
        },
        {
            "location": "326/ACT",
            "narrator": "",
            "text": "$me$はみやびとつきあいたいと思ってた",
            "zh": "$me$一直想跟雅交往",
            "narrator_zh": ""
        },
        {
            "location": "327/TALK",
            "narrator": "みやび",
            "text": "なぜ",
            "zh": "为什么",
            "narrator_zh": "雅"
        },
        {
            "location": "328/TALK",
            "narrator": "みやび",
            "text": "そうなるか",
            "zh": "会变成那样啊",
            "narrator_zh": "雅"
        },
        {
            "location": "329/TALK",
            "narrator": "みやび",
            "text": "理解不能だ",
            "zh": "无法理解",
            "narrator_zh": "雅"
        },
        {
            "location": "332/TALK",
            "narrator": "みやび",
            "text": "相談にならん！！！",
            "zh": "这根本算不上咨询！！！",
            "narrator_zh": "雅"
        },
        {
            "location": "338/TALK",
            "narrator": "ガブリエラ",
            "text": "……まあでも。",
            "zh": "……不过啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "340/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうこと\nなのね……。",
            "zh": "原来是\n这么回事啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "341/TALK",
            "narrator": "ガブリエラ",
            "text": "そう、みやびは\n彼氏がいるのね…。",
            "zh": "这样啊，雅\n有男朋友啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "342/TALK",
            "narrator": "みやび",
            "text": "いやいや、\n今のは冗談ぞね。",
            "zh": "不不，\n刚才是玩笑咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "344/TALK",
            "narrator": "ガブリエラ",
            "text": "……そうね。\n冗談なのね。",
            "zh": "……是呢。\n是玩笑呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "345/TALK",
            "narrator": "みやび",
            "text": "そう。\n納得してくれたかね。",
            "zh": "对。\n你接受了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "346/TALK",
            "narrator": "ガブリエラ",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "349/TALK",
            "narrator": "ガブリエラ",
            "text": "……でも。\n悩みがあるなら\n相談してね。",
            "zh": "……不过。\n有烦恼的话，\n记得来找我聊哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "いや、これは絶対\n誤解したままぞね。",
            "zh": "不，这绝对会\n被误会到底咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "209/DIALOG",
