{
    "dir": "chap33/daydra/dd_ch03_33_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "33305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "背中越しの真実＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "背后的真实＜后篇＞"
    },
    "entry": [
        {
            "location": "832/SCENARIO",
            "narrator": "",
            "text": "背中越しの真実",
            "zh": "背后的真实",
            "narrator_zh": ""
        },
        {
            "location": "855/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤからまだ\n連絡はない。",
            "zh": "绫水那边还没\n传来消息。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "856/TALK",
            "narrator": "ガブリエラ",
            "text": "もう少し時間は\nある感じね…。",
            "zh": "感觉还有\n一点时间呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "862/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ$marzanna$",
            "zh": "喂，$marzanna$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "863/TALK",
            "narrator": "ガブリエラ",
            "text": "言い忘れてたことがあるわ",
            "zh": "有件事我忘了说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "864/TALK",
            "narrator": "ガブリエラ",
            "text": "私、あなたになら背中を預けられる",
            "zh": "如果是你的话，我可以把后背托付给你",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "865/TALK",
            "narrator": "ガブリエラ",
            "text": "戦場で目を閉じろと言われても",
            "zh": "就算在战场上被要求闭上眼睛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "866/TALK",
            "narrator": "ガブリエラ",
            "text": "疑わず目を閉じるわ",
            "zh": "我也会毫不怀疑地闭上",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "870/TALK",
            "narrator": "ガブリエラ",
            "text": "私ずっと",
            "zh": "我一直以来",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "871/TALK",
            "narrator": "ガブリエラ",
            "text": "お姫様に憧れていたわ",
            "zh": "都很憧憬公主呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "872/TALK",
            "narrator": "ガブリエラ",
            "text": "いつも幸せで",
            "zh": "永远都很幸福",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "873/TALK",
            "narrator": "ガブリエラ",
            "text": "かわいいものだけに囲まれて",
            "zh": "只被可爱的东西包围着",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "874/TALK",
            "narrator": "ガブリエラ",
            "text": "辛いことも痛いことも全然知らない無垢なお姫様に",
            "zh": "对痛苦和伤痛一无所知的纯真公主",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "875/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "但是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "876/TALK",
            "narrator": "ガブリエラ",
            "text": "現実の私は戦士よ",
            "zh": "现实中的我是战士",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "877/TALK",
            "narrator": "ガブリエラ",
            "text": "お姫様なんかじゃない",
            "zh": "才不是什么公主",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "878/TALK",
            "narrator": "ガブリエラ",
            "text": "そしてそれが",
            "zh": "而且这一点",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "879/TALK",
            "narrator": "ガブリエラ",
            "text": "今はとてもうれしいの",
            "zh": "现在的我感到非常开心",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "880/TALK",
            "narrator": "ガブリエラ",
            "text": "自分自身で戦えるってことが",
            "zh": "开心自己能够亲自去战斗",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "881/TALK",
            "narrator": "ガブリエラ",
            "text": "これから戦うわ",
            "zh": "接下来我要战斗了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "882/TALK",
            "narrator": "ガブリエラ",
            "text": "世界と、何より自分自身のために",
            "zh": "为了世界，更为了我自己",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "884/SEL",
            "narrator": "",
            "text": "ご武運を",
            "zh": "祝武运昌隆",
            "narrator_zh": ""
        },
        {
            "location": "885/SEL",
            "narrator": "",
            "text": "ガブリエラはいつだって$me$の姫だよ",
            "zh": "加布里埃拉永远是$me$的公主哦",
            "narrator_zh": ""
        },
        {
            "location": "886/SEL",
            "narrator": "",
            "text": "$me$はガブリエラの王子だよ",
            "zh": "$me$就是加布里埃拉的王子哦",
            "narrator_zh": ""
        },
        {
            "location": "887/ACT",
            "narrator": "",
            "text": "ご武運を",
            "zh": "祝武运昌隆",
            "narrator_zh": ""
        },
        {
            "location": "889/TALK",
            "narrator": "ガブリエラ",
            "text": "祈ってくれるのね",
            "zh": "你在为我祈祷呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "891/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう",
            "zh": "谢谢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "892/TALK",
            "narrator": "ガブリエラ",
            "text": "生きて戻れたら",
            "zh": "要是能活着回来",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "893/TALK",
            "narrator": "ガブリエラ",
            "text": "戦果について報告するわ",
            "zh": "我会向你汇报战果的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "894/TALK",
            "narrator": "ガブリエラ",
            "text": "待ってて",
            "zh": "等着我",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "895/ACT",
            "narrator": "",
            "text": "ガブリエラはいつだって$me$の姫だよ",
            "zh": "加布里埃拉永远是$me$的公主哦",
            "narrator_zh": ""
        },
        {
            "location": "897/TALK",
            "narrator": "ガブリエラ",
            "text": "使用人のふりをしてくれるのね",
            "zh": "你是在假装成侍从陪我呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "899/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう",
            "zh": "谢谢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "900/TALK",
            "narrator": "ガブリエラ",
            "text": "とても頼りになる",
            "zh": "非常可靠",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "901/TALK",
            "narrator": "ガブリエラ",
            "text": "素敵なあなた",
            "zh": "了不起的你",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "902/ACT",
            "narrator": "",
            "text": "$me$はガブリエラの王子だよ",
            "zh": "$me$就是加布里埃拉的王子哦",
            "narrator_zh": ""
        },
        {
            "location": "904/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "906/TALK",
            "narrator": "ガブリエラ",
            "text": "あなたはいつも優しくて",
            "zh": "你总是那么温柔",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "907/TALK",
            "narrator": "ガブリエラ",
            "text": "気持ちがキラキラ輝いてた",
            "zh": "心意闪闪发光",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "908/TALK",
            "narrator": "ガブリエラ",
            "text": "だから私",
            "zh": "所以我",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "909/TALK",
            "narrator": "ガブリエラ",
            "text": "あなたと話す時は",
            "zh": "和你说话的时候",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "910/TALK",
            "narrator": "ガブリエラ",
            "text": "お姫様になれたわ",
            "zh": "就能成为公主了呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "916/TALK",
            "narrator": "透明アーヤ",
            "text": "ギャヴィ、みやび。\n館長から準備完了の\n連絡があったわ。",
            "zh": "加维、雅。\n馆长发来准备完毕的\n联络了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "917/TALK",
            "narrator": "透明アーヤ",
            "text": "サイネージに館長が\n映し出されたら\n救出開始よ。",
            "zh": "等电子屏上\n出现馆长之后\n就开始营救。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "918/TALK",
            "narrator": "ガブリエラ",
            "text": "ふうん。\nまほもやる時はやるわね。",
            "zh": "哼嗯。\n真幌关键时刻还是挺能干的嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "919/TALK",
            "narrator": "透明みやび",
            "text": "いっつもそうやったら\n肩が凝って\n仕方ないろう。",
            "zh": "要是天天都这样\n肩膀肯定酸得\n不得了咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "920/TALK",
            "narrator": "透明アーヤ",
            "text": "……スタンバイ。\n各人、構えよ。",
            "zh": "……待命。\n全员，准备。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "921/TALK",
            "narrator": "透明みやび",
            "text": "発煙手榴弾の\n安全ロック解除。",
            "zh": "发烟手榴弹的\n安全锁解除。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "922/TALK",
            "narrator": "透明みやび",
            "text": "いつでも行けるき。",
            "zh": "随时都可以上了啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "923/TALK",
            "narrator": "ガブリエラ",
            "text": "望むところよ。",
            "zh": "正合我意。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "924/TALK",
            "narrator": "透明アーヤ",
            "text": "…お願い。",
            "zh": "……拜托了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "925/TALK",
            "narrator": "透明みやび",
            "text": "オッケー。\n…発破！",
            "zh": "OK。\n……起爆！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "932/TALK",
            "narrator": "ガブリエラ",
            "text": "……勝ってみせる。\n絶対に！",
            "zh": "……我一定会赢给你看。\n绝对！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "943/DIALOG",
            "narrator": "Dialog_chapter_ch03",
            "text": "【27 シン・カグラ】",
            "zh": "【27 新·神乐】",
            "narrator_zh": "Dialog_chapter_ch03"
        }
    ]
}
