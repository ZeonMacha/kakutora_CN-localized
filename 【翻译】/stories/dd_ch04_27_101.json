            "text": "もー！！！",
            "zh": "够了啦！！！",
            "narrator_zh": ""
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "$handle$の気持ちは",
            "zh": "$handle$的心情",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "ようわかった",
            "zh": "我彻底懂了",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "みやび",
            "text": "もうえい！",
            "zh": "得咧得咧！",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "みやび？",
            "zh": "雅？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "みやび",
            "text": "どういた？",
            "zh": "怎么了？",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "アーヤ",
            "text": "なんか変な\nメッセージでも\n届いたの？",
            "zh": "是收到什么\n奇怪的\n消息了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "139/TALK",
            "narrator": "アーヤ",
            "text": "なんだか怖い\n顔になってるから。",
            "zh": "因为你的表情\n看起来有点吓人。",
            "narrator_zh": "绫水"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "いや別に。",
            "zh": "不，没什么。",
            "narrator_zh": "雅"
        },
        {
            "location": "141/TALK",
            "narrator": "アーヤ",
            "text": "…だったら\nいいんだけど…。",
            "zh": "……那样的话\n就好……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "みやび",
            "text": "変というか。",
            "zh": "说奇怪嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "144/TALK",
            "narrator": "みやび",
            "text": "せっかく物事が\n進展するという時に。",
            "zh": "偏偏挑在事情\n好不容易有进展的时候。",
            "narrator_zh": "雅"
        },
        {
            "location": "145/TALK",
            "narrator": "みやび",
            "text": "ふざけたことばかり\n言ってくるとは。",
            "zh": "却尽发些\n胡闹的东西过来。",
            "narrator_zh": "雅"
        },
        {
            "location": "147/TALK",
            "narrator": "みやび",
            "text": "うちは相棒を\n買い被りすぎ\nちょったかねえ…。",
            "zh": "看来是我\n把搭档想得\n太高咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "195/TALK",
            "narrator": "みやび",
            "text": "　",
            "zh": "　",
            "narrator_zh": "雅"
        },
        {
            "location": "211/TALK",
            "narrator": "シンギュラリティ",
            "text": "コイガサキは\n寝ているようだ。",
            "zh": "恋之崎\n似乎睡着了。",
            "narrator_zh": "奇点"
        },
        {
            "location": "231/TALK",
            "narrator": "シンギュラリティ",
            "text": "これやね！",
            "zh": "就是这个咯！",
            "narrator_zh": "奇点"
        },
        {
            "location": "234/TALK",
            "narrator": "シンギュラリティ",
            "text": "キャーエッチー！",
            "zh": "呀——好色哦——！",
            "narrator_zh": "奇点"
        },
        {
            "location": "237/TALK",
            "narrator": "シンギュラリティ",
            "text": "キャーマニアックー！",
            "zh": "呀——狂热哦——！",
            "narrator_zh": "奇点"
        },
        {
            "location": "241/TALK",
            "narrator": "シンギュラリティ",
            "text": "寝ているところを襲うとは\n$handle$も\nなかなか隅に置けんね。",
            "zh": "居然趁睡着偷袭，\n$handle$这家伙\n还真不能小看呐。",
            "narrator_zh": "奇点"
        },
        {
            "location": "242/SEL",
            "narrator": "",
            "text": "タヌキ寝入りじゃん",
            "zh": "是你自己装睡吧",
            "narrator_zh": ""
        },
        {
            "location": "243/SEL",
            "narrator": "",
            "text": "もっと過激に襲いかかりたい",
            "zh": "想更激烈地扑上去",
            "narrator_zh": ""
        },
        {
            "location": "244/ACT",
            "narrator": "",
            "text": "タヌキ寝入りじゃん",
            "zh": "是你自己装睡吧",
            "narrator_zh": ""
        },
        {
            "location": "245/TALK",
            "narrator": "シンギュラリティ",
            "text": "そこは\nお約束っちゅうやつやよ。",
            "zh": "那可是\n经典桥段咯。",
            "narrator_zh": "奇点"
        },
        {
            "location": "246/ACT",
            "narrator": "",
            "text": "もっと過激に襲いかかりたい",
            "zh": "想更激烈地扑上去",
            "narrator_zh": ""
        },
        {
            "location": "248/TALK",
            "narrator": "シンギュラリティ",
            "text": "お。\n$handle$の中の\n竜を目覚めさせたか。",
            "zh": "哦。\n唤醒了$handle$\n体内的龙了吗。",
            "narrator_zh": "奇点"
        },
        {
            "location": "249/TALK",
            "narrator": "シンギュラリティ",
            "text": "だがしかし！\nインターフェイスの\n限界があるね。",
            "zh": "但是！\n接口的\n上限还是有的咯。",
            "narrator_zh": "奇点"
        },
        {
            "location": "250/TALK",
            "narrator": "シンギュラリティ",
            "text": "お前さんの環境では、\nグルグル回してパンツを\n見るのが関の山であろう。",
            "zh": "在你的环境里，\n转来转去偷看内裤\n也就到头了吧。",
            "narrator_zh": "奇点"
        },
        {
            "location": "252/SEL",
            "narrator": "",
            "text": "今回も無駄にテンション高いね",
            "zh": "这次也莫名其妙地嗨呢",
            "narrator_zh": ""
        },
        {
            "location": "253/ACT",
            "narrator": "",
            "text": "今回も無駄にテンション高いね",
            "zh": "这次也莫名其妙地嗨呢",
            "narrator_zh": ""
        },
        {
            "location": "255/TALK",
            "narrator": "シンギュラリティ",
            "text": "うむ！",
            "zh": "嗯！",
            "narrator_zh": "奇点"
        },
        {
            "location": "256/TALK",
            "narrator": "シンギュラリティ",
            "text": "翻してお前さんは\n随分と死相が出ちゅう\nけんど、どういたが？",
            "zh": "话说回来你\n死相相当重啊，\n这是怎么了？",
            "narrator_zh": "奇点"
        },
        {
            "location": "257/SEL",
            "narrator": "",
            "text": "OSのせいで現実のみやびに失望された！",
            "zh": "因为系统的问题被现实的雅失望了！",
            "narrator_zh": ""
        },
        {
            "location": "258/ACT",
            "narrator": "",
            "text": "OSのせいで現実のみやびに失望された！",
            "zh": "因为系统的问题被现实的雅失望了！",
            "narrator_zh": ""
        },
        {
            "location": "260/TALK",
            "narrator": "シンギュラリティ",
            "text": "ふむ、なるほど。",
            "zh": "唔，原来如此。",
            "narrator_zh": "奇点"
        },
        {
            "location": "261/TALK",
            "narrator": "シンギュラリティ",
            "text": "けんど、そんな筈は\nないんやけんどな。",
            "zh": "但是，不可能\n会那样啊。",
            "narrator_zh": "奇点"
        },
        {
            "location": "262/TALK",
            "narrator": "シンギュラリティ",
            "text": "ちくっと\n調べてみるか。",
            "zh": "稍微\n查查看咯。",
            "narrator_zh": "奇点"
        },
        {
            "location": "268/TALK",
            "narrator": "シンギュラリティ",
            "text": "オープンプロセス――",
            "zh": "开放进程——",
            "narrator_zh": "奇点"
        },
        {
            "location": "269/TALK",
            "narrator": "シンギュラリティ",
            "text": "なんぞ、\nまだ情報阻害\nされちゅうが…。",
            "zh": "驷马，\n情报还被\n屏蔽着……",
            "narrator_zh": "奇点"
        },
        {
            "location": "270/SEL",
            "narrator": "",
            "text": "エリカさんが【0x86F】だって",
            "zh": "领火说是【0x86F】",
            "narrator_zh": ""
        },
        {
            "location": "271/ACT",
            "narrator": "",
            "text": "エリカさんが【0x86F】だって",
            "zh": "领火说是【0x86F】",
            "narrator_zh": ""
        },
        {
            "location": "273/TALK",
            "narrator": "シンギュラリティ",
            "text": "おお、さすがエリカさん。\nぬかりないな。",
            "zh": "哦哦，不愧是领火。\n滴水不漏呐。",
            "narrator_zh": "奇点"
        },
        {
            "location": "274/TALK",
            "narrator": "シンギュラリティ",
            "text": "オープンプロセス、\n0x121番地から\n0x86F番地へ。",
            "zh": "开放进程，\n从 0x121 号地址\n转到 0x86F 号地址。",
            "narrator_zh": "奇点"
        },
        {
            "location": "296/TALK",
            "narrator": "シンギュラリティ",
            "text": "完了。",
            "zh": "完成。",
            "narrator_zh": "奇点"
        },
        {
            "location": "298/TALK",
            "narrator": "シンギュラリティ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "奇点"
        },
        {
            "location": "300/TALK",
            "narrator": "シンギュラリティ",
            "text": "………む。",
            "zh": "………唔。",
            "narrator_zh": "奇点"
        },
        {
            "location": "301/TALK",
            "narrator": "シンギュラリティ",
            "text": "中と外\n両方から攻めて\nきちゅうが？",
            "zh": "里外\n两边同时\n在攻击？",
            "narrator_zh": "奇点"
        },
        {
            "location": "302/TALK",
            "narrator": "シンギュラリティ",
            "text": "誰や、\n内から攻めてるんは……",
            "zh": "是哪个，\n在里面攻击的……",
            "narrator_zh": "奇点"
        },
        {
            "location": "303/TALK",
            "narrator": "シンギュラリティ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "奇点"
        },
        {
            "location": "304/TALK",
            "narrator": "シンギュラリティ",
            "text": "って、そんなアホな。",
            "zh": "等等，哪有这么蠢的。",
            "narrator_zh": "奇点"
        },
        {
            "location": "305/SEL",
            "narrator": "",
            "text": "何かヤバイ事になってるの！？",
            "zh": "是出了什么危险的事吗！？",
            "narrator_zh": ""
        },
        {
            "location": "306/ACT",
            "narrator": "",
            "text": "何かヤバイ事になってるの！？",
            "zh": "是出了什么危险的事吗！？",
            "narrator_zh": ""
        },
        {
            "location": "308/TALK",
            "narrator": "シンギュラリティ",
            "text": "ん？",
            "zh": "嗯？",
            "narrator_zh": "奇点"
        },
        {
            "location": "309/TALK",
            "narrator": "シンギュラリティ",
            "text": "いんや、大丈夫や。",
            "zh": "不，没事的。",
            "narrator_zh": "奇点"
        },
        {
            "location": "310/TALK",
            "narrator": "シンギュラリティ",
            "text": "それより喜べ。\nお前さんは全く\n失望などされておらんよ。",
            "zh": "比起这个，高兴吧。\n她完全没有\n对你失望哦。",
            "narrator_zh": "奇点"
        },
        {
            "location": "311/TALK",
            "narrator": "シンギュラリティ",
            "text": "ちくっとうちの\n虫の居所が\n悪かっただけやき。",
            "zh": "只不过是我\n心情正好\n不痛快而已啵。",
            "narrator_zh": "奇点"
        },
        {
            "location": "312/TALK",
            "narrator": "シンギュラリティ",
            "text": "虫の居所を悪くしてる\nクランを倒せば、後は\nトントン拍子や。",
            "zh": "只要打倒那个\n害我心情不爽的\n库兰，之后就一帆风顺了。",
            "narrator_zh": "奇点"
        },
        {
            "location": "313/TALK",
            "narrator": "シンギュラリティ",
            "text": "あとはお前さんがキリッと\nしてれば、うちも余裕で\n惚れ直すき。",
            "zh": "剩下只要你\n打起精神，我就能\n轻轻松松重新看上你啵。",
            "narrator_zh": "奇点"
        },
        {
            "location": "314/TALK",
            "narrator": "シンギュラリティ",
            "text": "寧ろ怪我の功名やね！",
            "zh": "反倒算因祸得福咯！",
            "narrator_zh": "奇点"
        },
        {
            "location": "315/SEL",
            "narrator": "",
            "text": "よかった！",
            "zh": "太好了！",
            "narrator_zh": ""
        },
        {
            "location": "316/SEL",
            "narrator": "",
            "text": "何か問題があったんじゃないの？",
            "zh": "不是有什么问题吗？",
            "narrator_zh": ""
        },
        {
            "location": "317/ACT",
            "narrator": "",
            "text": "よかった！",
            "zh": "太好了！",
            "narrator_zh": ""
        },
        {
            "location": "318/TALK",
            "narrator": "シンギュラリティ",
            "text": "うむ。",
            "zh": "嗯。",
            "narrator_zh": "奇点"
        },
        {
            "location": "319/TALK",
            "narrator": "シンギュラリティ",
            "text": "ほんだらさっさと\nクランを倒してきいや。",
            "zh": "那就麻利地\n去把库兰打倒咧。",
            "narrator_zh": "奇点"
        },
        {
            "location": "320/ACT",
            "narrator": "",
            "text": "何か問題があったんじゃないの？",
            "zh": "不是有什么问题吗？",
            "narrator_zh": ""
        },
        {
            "location": "322/TALK",
            "narrator": "シンギュラリティ",
            "text": "あるある。\nもちろんある。",
            "zh": "有的有的。\n当然有。",
            "narrator_zh": "奇点"
        },
        {
            "location": "323/TALK",
            "narrator": "シンギュラリティ",
            "text": "うちのココロの中には\n毎分毎秒星の数ほどの\n問題が渦巻いちゅう。",
            "zh": "我的心里\n每分每秒都卷着\n星星一样多的问题。",
            "narrator_zh": "奇点"
        },
        {
            "location": "324/TALK",
            "narrator": "シンギュラリティ",
            "text": "だが心配するな相棒よ。\nお前さんには、\nこれっぽっちも関係ない。",
            "zh": "但别担心，搭档哟。\n这些和你\n半点关系都没有。",
            "narrator_zh": "奇点"
        },
        {
            "location": "325/TALK",
            "narrator": "シンギュラリティ",
            "text": "それより、\nとっととうちの虫の居所を\n矯正してくれんかね。",
            "zh": "比起这个，\n能不能快点把\n我的心情矫正过来啊。",
            "narrator_zh": "奇点"
        },
        {
            "location": "326/TALK",
            "narrator": "シンギュラリティ",
            "text": "うちとしてもまっこと\n気持ち悪いき、はよ\n誤解を解いてや。",
            "zh": "我自己也觉得\n蛮恶心的啵，快点\n把误会解开啦。",
            "narrator_zh": "奇点"
        },
        {
            "location": "328/TALK",
            "narrator": "シンギュラリティ",
            "text": "とゆうわけで、\nうちと$handle$に\n素敵なココロの旅を！",
            "zh": "所以呢，\n献给我和$handle$的\n美妙心灵之旅！",
            "narrator_zh": "奇点"
        },
        {
            "location": "339/TALK",
            "narrator": "シンギュラリティ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "奇点"
        },
        {
            "location": "340/TALK",
            "narrator": "シンギュラリティ",
            "text": "……おかしいね。",
            "zh": "……不对劲啊。",
            "narrator_zh": "奇点"
        },
        {
            "location": "341/TALK",
            "narrator": "シンギュラリティ",
            "text": "1x空間は、既に千羽鶴の\n影響下からは切り離され\nちゅう筈やけんど。",
            "zh": "1x空间明明\n已经切离了\n千羽鹤的影响才对。",
            "narrator_zh": "奇点"
        },
        {
            "location": "342/TALK",
            "narrator": "シンギュラリティ",
            "text": "まあ……。\nそう簡単には…\nといったところかね。",
            "zh": "嘛……。\n没那么容易\n就是了呐。",
            "narrator_zh": "奇点"
        },
        {
            "location": "343/TALK",
            "narrator": "シンギュラリティ",
            "text": "問題は、千羽鶴がまだ\nアイツを雇っているか\nどうかやね……。",
            "zh": "问题是，千羽鹤\n还雇不雇着\n那家伙……。",
            "narrator_zh": "奇点"
        },
        {
            "location": "344/TALK",
            "narrator": "シンギュラリティ",
            "text": "調べに行ってみるか。",
            "zh": "去查查看吧。",
            "narrator_zh": "奇点"
        },
        {
            "location": "34/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>9月3日　 11:43 PM</color>\n長野県松代、アーヤの実家でのこと",
            "zh": "<color=green>9月3日　 11:43 PM</color>\n长野县松代，绫水老家发生的事",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "79/DIALOG",
            "narrator": "INFO",
            "text": "<color=green>【TRI-OS FILE:TOUCH】</color>\n\n<color=red>[FILE]\nTRI-OS Update\nRevision 2.11.2951E.pp\n</color>\n\nパッチパッケージを\n転送しました。",
            "zh": "<color=green>【TRI-OS FILE:TOUCH】</color>\n\n<color=red>[FILE]\nTRI-OS Update\nRevision 2.11.2951E.pp\n</color>\n\n补丁包\n传输完成。",
            "narrator_zh": "INFO"
        },
        {
            "location": "160/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch01",
            "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>逢濑燕的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解逢濑燕心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch01"
        },
        {
            "location": "162/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch02",
            "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>国政绫水的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解国政绫水心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch02"
        },
        {
            "location": "164/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch03",
            "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>加布里埃拉的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解加布里埃拉心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch03"
        },
        {
            "location": "166/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch04",
            "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>恋之崎雅的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解恋之崎雅心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch04"
        },
        {
            "location": "168/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch05",
            "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>卯月神乐的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解卯月神乐心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch05"
        },
        {
            "location": "217/DIALOG",
            "narrator": "INFO",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已连接。\n\n点击画面，向对方\n传达感觉吧。",
            "narrator_zh": "INFO"
        },
        {
            "location": "240/DIALOG",
            "narrator": "NOTICE",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已断开。",
            "narrator_zh": "NOTICE"
        }
    ]
}
