        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "こっちの方だが",
            "zh": "是我这边才对",
            "narrator_zh": "雅"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "わかっておるのか",
            "zh": "你搞清楚了没啊",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "$handle$め",
            "zh": "$handle$这家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "109/SEL",
            "narrator": "",
            "text": "わかってるけど",
            "zh": "我知道啦",
            "narrator_zh": ""
        },
        {
            "location": "110/SEL",
            "narrator": "",
            "text": "どうしようもないんだって",
            "zh": "可是真的没办法呀",
            "narrator_zh": ""
