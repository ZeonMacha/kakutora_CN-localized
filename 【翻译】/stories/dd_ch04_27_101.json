    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "迷宮とはラビリンスにも似て（似て？）",
            "zh": "所谓迷宫，也挺像 labyrinth（像吗？）",
            "narrator_zh": ""
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "エリカさんからの\n荷物を全部\n確認したぞね。",
            "zh": "领火寄来的\n包裹全都\n确认完了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "36/TALK",
            "narrator": "アーヤ",
            "text": "どう？\n何かわかった？",
            "zh": "怎么样？\n查出什么了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "解析はこれからや\nけんど。",
            "zh": "解析这才\n刚要开始咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "ひとつ毛色の違う\nデータがあったき。",
            "zh": "有个数据\n路数不太一样啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "これだけ先に\n検証しようかと\n思うとる。",
            "zh": "我想先把\n这一个拿来\n验证一下。",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうものなの？",
            "zh": "是这么回事吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "うちは小さいものから\n片付けていく派やき。",
            "zh": "我是先收拾\n小的那一派啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "と\nその前に…。",
            "zh": "不过\n在那之前……。",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "驚け相棒",
            "zh": "惊讶吧，搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "アーヤの姉は実在した",
            "zh": "绫水的姐姐是真实存在的",
            "narrator_zh": "雅"
        },
        {
            "location": "57/SEL",
            "narrator": "",
            "text": "知ってる",
            "zh": "我知道",
            "narrator_zh": ""
        },
        {
            "location": "58/SEL",
            "narrator": "",
            "text": "話したことあるし",
            "zh": "还和她说过话",
            "narrator_zh": ""
        },
        {
            "location": "59/SEL",
            "narrator": "",
            "text": "秘密だったのに",
            "zh": "明明还是秘密来着",
            "narrator_zh": ""
        },
        {
            "location": "60/ACT",
            "narrator": "",
            "text": "黄色いスイカの方が甘く感じない？",
            "zh": "你不觉得黄瓤西瓜更甜吗？",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不是。",
            "narrator_zh": "雅"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "レア感は感じるが",
            "zh": "稀罕感倒是有一点",
            "narrator_zh": "雅"
        },
        {
            "location": "64/ACT",
            "narrator": "",
            "text": "晩ご飯何かな",
            "zh": "晚饭吃什么呢",
            "narrator_zh": ""
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "腹減りか",
            "zh": "饿了咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "まず空腹を収めろ",
            "zh": "先填饱肚子再说",
            "narrator_zh": "雅"
        },
        {
            "location": "67/ACT",
            "narrator": "",
            "text": "天ぷらは天つゆ派なんだ",
            "zh": "天妇罗我是蘸天露派的",
            "narrator_zh": ""
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "薄口醤油なら",
            "zh": "要是淡口酱油的话",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "天つゆだな",
            "zh": "那就是天露了",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不对。",
            "narrator_zh": "雅"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "そんなことは",
            "zh": "那种事",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "どうでもよく",
            "zh": "怎样都好",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "アーヤの姉さんが",
            "zh": "绫水的姐姐",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "コンタクトしてきたんだぞ？",
            "zh": "联系上我了啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "む",
            "zh": "唔。",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "なんぞこれ",
            "zh": "驷马呀这是",
            "narrator_zh": "雅"
        },
        {
            "location": "83/SEL",
            "narrator": "",
            "text": "エリカさんからパッチだよ",
            "zh": "是领火发来的补丁啦",
            "narrator_zh": ""
        },
        {
            "location": "84/SEL",
            "narrator": "",
            "text": "それすごい重要なやつ",
            "zh": "那个可是超重要的东西",
            "narrator_zh": ""
        },
        {
            "location": "85/ACT",
            "narrator": "",
            "text": "松代オブザデッドってゾンビ映画どうかな",
            "zh": "松代活死人那部丧尸电影怎么样呀",
            "narrator_zh": ""
        },
        {
            "location": "86/TALK",
            "narrator": "みやび",
            "text": "興味はある",
            "zh": "兴趣是有的",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "企画が通ったら",
            "zh": "要是企划通过了",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "ショッピングセンターに立てこもるヒロインをやりたい",
            "zh": "我想演据守购物中心的女主角",
            "narrator_zh": "雅"
        },
        {
            "location": "89/ACT",
            "narrator": "",
            "text": "長野って海がないよね",
            "zh": "长野没有海吧",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "高知には海も山もあるぞ",
            "zh": "高知海和山都有哦",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "あと土佐犬もおる",
            "zh": "还有土佐犬咧",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "なあ$handle$",
            "zh": "我说$handle$",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "平時ならむしろ気になる話題だが",
            "zh": "平时这种话题我反而更感兴趣",
            "narrator_zh": "雅"
        },
        {
            "location": "95/TALK",
            "narrator": "みやび",
            "text": "今はもっと大事な話をしたいのだ",
            "zh": "但现在我想谈更要紧的事",
            "narrator_zh": "雅"
        },
        {
            "location": "97/SEL",
            "narrator": "",
            "text": "$me$もそう思ってる",
            "zh": "$me$也这么觉得",
            "narrator_zh": ""
        },
        {
            "location": "98/SEL",
            "narrator": "",
            "text": "だから答えがおかしいんだって",
            "zh": "所以说你的回答才奇怪啊",
            "narrator_zh": ""
        },
        {
            "location": "99/SEL",
            "narrator": "",
