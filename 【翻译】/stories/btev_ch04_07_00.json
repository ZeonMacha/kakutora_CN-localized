{
    "dir": "chap07/battle/btev_ch04_07_00.js",
    "type": "",
    "info": {
        "story_id": "24010",
        "cid": "",
        "title": "010 ココロスフィアストーリー【Lv04】",
        "sub_title": "監視＜提起＞",
        "title_zh": "010 心灵领域故事【Lv04】",
        "sub_title_zh": "监视＜提起＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "監視",
            "zh": "监视",
            "narrator_zh": ""
        },
        {
            "location": "13/DIALOG",
            "narrator": "",
            "text": "<size=40>KOKORO-Lv. 04</size>\nMIYABI - KOIGASAKI\n\n<size=45>監視</size>\n<size=35>～天然か養殖か～</size>",
            "zh": "<size=40>KOKORO-Lv. 04</size>\n恋之崎雅\n\n<size=45>监视</size>\n<size=35>～天然还是养殖～</size>",
            "narrator_zh": ""
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "…むっ！？",
            "zh": "……唔！？",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "ああ…なんだ、\n$handle$か…。",
            "zh": "啊……什么嘛，\n是$handle$啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "46/TALK",
            "narrator": "みやび",
            "text": "いつの間に\n見ちょったが？",
            "zh": "你从什么时候\n开始看着的？",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "こっちは今、\n気がピリピリ\nしちょるき――",
            "zh": "我这边现在\n神经正绷得\n紧呢啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "みやび",
            "text": "覗き見厳禁や。\nほれ、帰った帰った。",
            "zh": "严禁偷看。\n行了，回去回去。",
            "narrator_zh": "雅"
        },
        {
            "location": "49/SEL",
            "narrator": "（選択肢）",
            "text": "警戒してる？",
            "zh": "你在戒备吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "50/ACT",
            "narrator": "",
            "text": "警戒してる？",
            "zh": "你在戒备吗？",
            "narrator_zh": ""
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "バリバリ厳戒態勢や。",
            "zh": "全方位一级戒备状态咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "今もうちを――",
            "zh": "现在也有人在——",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "ハッ！？",
            "zh": "哈！？",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "そこ！\n誰や！？",
            "zh": "那边！\n谁啊！？",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "はわわっ！？",
            "zh": "哇哇！？",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "こ、こんばんはぁ。",
            "zh": "晚、晚上好呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "…何の用や？",
            "zh": "……有驷马事？",
            "narrator_zh": "雅"
        },
        {
            "location": "63/TALK",
            "narrator": "つばめ",
            "text": "えへへー。\nこんな時間まで\nお仕事ですかぁ？",
            "zh": "诶嘿嘿——。\n都这么晚了\n还在工作呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "…そうや。\n色々やること\nあってな。",
            "zh": "……是啊。\n有各种事\n要忙嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんこそ、\nこんな時間まで\n何やっちょるが？",
            "zh": "燕你才是，\n都这个点了\n在干驷马呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "つばめ",
            "text": "夜のお散歩をしてた\nだけですよー。",
            "zh": "我只是在夜间散步\n而已哦——。",
            "narrator_zh": "燕"
        },
        {
            "location": "67/TALK",
            "narrator": "つばめ",
            "text": "そしたら、\nみやびさんの\n部屋から――",
            "zh": "结果就看见\n雅的\n房间里——",
            "narrator_zh": "燕"
        },
        {
            "location": "68/TALK",
            "narrator": "つばめ",
            "text": "灯りが漏れてるのが\n見えたんですー。",
            "zh": "有灯光漏出来\n了呢——。",
            "narrator_zh": "燕"
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "…監視しちょったが？",
            "zh": "……你在监视我咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "70/TALK",
            "narrator": "つばめ",
            "text": "えー、違いますよー。",
            "zh": "诶——，才不是呢——。",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "…もうえいから、\n部屋帰りぃ。",
            "zh": "……行了得啦，\n回你房间去。",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "つばめ",
            "text": "そうしますー。\nでも、その前に――",
            "zh": "我这就回去——。\n不过，在那之前——",
            "narrator_zh": "燕"
        },
        {
            "location": "75/TALK",
            "narrator": "つばめ",
            "text": "何やってたか\n見せてほしいなー？",
            "zh": "能让我看看你在\n做什么吗——？",
            "narrator_zh": "燕"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "プライバシーに\n関わることやき――",
            "zh": "这涉及我的\n隐私啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "80/TALK",
            "narrator": "つばめ",
            "text": "あれれー？\nお仕事じゃないん\nですかー？",
            "zh": "咦咦——？\n不是在工作\n吗——？",
            "narrator_zh": "燕"
        },
        {
            "location": "83/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "84/SEL",
            "narrator": "（選択肢）",
            "text": "邪魔しちゃダメだよ",
            "zh": "别去打扰人家呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "85/SEL",
            "narrator": "（選択肢）",
            "text": "つばめは仲間だし、見せてあげなよ",
            "zh": "燕也是伙伴嘛，给她看看呗",
            "narrator_zh": "（选项）"
        },
        {
            "location": "86/ACT",
            "narrator": "",
            "text": "邪魔しちゃダメだよ",
            "zh": "别去打扰人家呀",
            "narrator_zh": ""
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "あ…そっか、\n$handle$さんも\nいたんだ？",
            "zh": "啊……对哦，\n$handle$\n也在呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "90/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、わたしは\n帰りますけど――",
            "zh": "那我就先\n回去了，不过——",
            "narrator_zh": "燕"
        },
        {
            "location": "92/TALK",
            "narrator": "つばめ",
            "text": "あんまり危険な\nことは、やめた方が\nいいと思いますよ？",
            "zh": "太危险的事，\n我觉得还是\n别做比较好哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "97/TALK",
            "narrator": "みやび",
            "text": "はぁ…、\nヤバかったぁ…。",
            "zh": "呼……，\n好悬啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "うちだけやったら、\n今頃どんな目に\n合うてたことか…。",
            "zh": "要是只有我一个，\n现在指不定落到\n驷马下场了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "99/SEL",
            "narrator": "（選択肢）",
            "text": "一体、何をしてたの？",
            "zh": "你到底在干什么啊？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "100/ACT",
            "narrator": "",
            "text": "一体、何をしてたの？",
            "zh": "你到底在干什么啊？",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "…助けてもらった\nことやし、コッソリ\n教えるけんど――",
            "zh": "……看在你帮了我，\n就偷偷告诉你，\n但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "実はな、管理庁に\nハッキング仕掛けよう\n思うてたところや。",
            "zh": "其实呢，我正打算\n向管理厅发起\n黑客入侵。",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "うちのメンバーは、\nどうにも信用ならん\n奴ばかりやきね。",
            "zh": "我们那帮成员，\n怎么看都是些信不过的\n家伙啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "今のつばめちゃん\nだってそうや。",
            "zh": "刚才的燕\n也是那样。",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "ハッキングかけよう\n思うてた\nタイミングで――",
            "zh": "偏偏挑在我正打算\n动手黑进去的\n这个节骨眼——",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "狙ったように来るとか\nおかしいやろ？",
            "zh": "跟算准了似的找上门，\n太奇怪了吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "109/SEL",
            "narrator": "（選択肢）",
            "text": "てか、さっきのつばめ怪し過ぎない？",
            "zh": "话说，刚才的燕是不是有点太可疑了？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "110/ACT",
            "narrator": "",
            "text": "てか、さっきのつばめ怪し過ぎない？",
            "zh": "话说，刚才的燕是不是有点太可疑了？",
            "narrator_zh": ""
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "ここでそれ言うか？\n当然やろ。",
            "zh": "这种时候说这个？\n那当然了吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "113/TALK",
            "narrator": "みやび",
            "text": "うちの思い込み\nフィルターが掛かっ\nちょるきね。",
            "zh": "因为我自己心里\n正挂着偏见滤镜\n嘛啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "うちが最もスパイと\n思うちょるんが、\nつばめちゃんちや。",
            "zh": "我最怀疑是间谍的，\n就是燕\n滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "115/TALK",
            "narrator": "みやび",
            "text": "スパイと思われん\nように道化を演じ\nとるに違いない。",
            "zh": "肯定是为了不让人\n看出是间谍，才故意\n装疯卖傻的。",
            "narrator_zh": "雅"
        },
        {
            "location": "117/TALK",
            "narrator": "みやび",
            "text": "…もう監視されて\nないみたいやな。",
            "zh": "……好像已经没有\n被监视着了。",
            "narrator_zh": "雅"
        },
        {
            "location": "119/TALK",
            "narrator": "みやび",
            "text": "よし、ハッキング\n再開するぞね。",
            "zh": "好，继续\n黑客入侵咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "120/SEL",
            "narrator": "（選択肢）",
            "text": "一人で調べるなんて、危険だよ",
            "zh": "一个人去查太危险了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "121/ACT",
            "narrator": "",
            "text": "一人で調べるなんて、危険だよ",
            "zh": "一个人去查太危险了",
            "narrator_zh": ""
        },
        {
            "location": "124/TALK",
            "narrator": "みやび",
            "text": "逆や。\n一人の方が安全ぞね。",
            "zh": "恰恰相反。\n一个人反而更安全咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "125/TALK",
            "narrator": "みやび",
            "text": "…どこに管理庁の\nスパイがおるか、\nわからんき――",
            "zh": "……不知道哪里就藏着\n管理厅的间谍\n啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "126/TALK",
            "narrator": "みやび",
            "text": "下手に心を許せん。",
            "zh": "不能随便把心交出去。",
            "narrator_zh": "雅"
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん以外も、\nみんな何かしら謎を\n抱えちょるがよ。",
            "zh": "除了燕以外，\n大家也都各自背着\n不知驷马谜团咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "誰も信用できん…。",
            "zh": "谁都信不过……。",
            "narrator_zh": "雅"
        },
        {
            "location": "129/SEL",
            "narrator": "（選択肢）",
            "text": "$me$なら信用して平気",
            "zh": "是$me$的话可以放心信任",
            "narrator_zh": "（选项）"
        },
        {
            "location": "130/ACT",
            "narrator": "",
            "text": "$me$なら信用して平気",
            "zh": "是$me$的话可以放心信任",
            "narrator_zh": ""
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "…まあ、$handle$は\n他の子よりかは信用\nしちょるけんど――",
            "zh": "……嘛，$handle$\n比起其他几个我是多信\n一点，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "実際にここにおる\nわけやないやろ？",
            "zh": "你又不是真的\n在这里吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "ぶっちゃけ\n頼り甲斐ゼロちや。",
            "zh": "说白了，\n靠谱度为零滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "みやび",
            "text": "まあ、うちの戦いは\n孤独ちゅうことや。",
            "zh": "嘛，我的战斗就是\n孤独的战斗咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "143/TALK",
            "narrator": "つばめ",
            "text": "全然孤独じゃない\nですよ、みやびさん！",
            "zh": "才一点都不孤独\n哦，雅！",
            "narrator_zh": "燕"
        },
        {
            "location": "146/TALK",
            "narrator": "みやび",
            "text": "どわあっ！\nまだおったんか！",
            "zh": "哇啊！\n你还在啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "147/TALK",
            "narrator": "つばめ",
            "text": "そりゃずっといましたよ。\nお話も聞いてましたし。",
            "zh": "那当然，我一直都在哦。\n你们说的话我也全听见了。",
            "narrator_zh": "燕"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "なっ！\nなんやって！？",
            "zh": "什！\n你说驷马！？",
            "narrator_zh": "雅"
        },
        {
            "location": "149/TALK",
            "narrator": "つばめ",
            "text": "早速ですけど、\nちょっとパソコンの画面\n見せてくださいね！",
            "zh": "话不多说，\n请让我看一下\n你的电脑屏幕吧！",
            "narrator_zh": "燕"
        },
        {
            "location": "150/ACT",
            "narrator": "",
            "text": "つばめは仲間だし、見せてあげなよ",
            "zh": "燕也是伙伴嘛，给她看看呗",
            "narrator_zh": ""
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "余計なことを！！",
            "zh": "多管闲事！！",
            "narrator_zh": "雅"
        },
        {
            "location": "155/TALK",
            "narrator": "つばめ",
            "text": "そうですよー。\n仲間なんですから\nいいじゃないですか。",
            "zh": "就是呀——。\n大家都是伙伴，\n看看又怎么了嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "159/TALK",
            "narrator": "みやび",
            "text": "あ、コラ！\n見たらいかん！",
            "zh": "啊，喂！\n不准看！",
            "narrator_zh": "雅"
        },
        {
            "location": "161/TALK",
            "narrator": "つばめ",
            "text": "えーっと…あれれぇ？",
            "zh": "嗯——……咦咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "162/TALK",
            "narrator": "つばめ",
            "text": "みやびさーん。\nこれって何してる\n画面ですかぁ？",
            "zh": "雅——。\n这个画面是在\n做什么呀——？",
            "narrator_zh": "燕"
        },
        {
            "location": "165/TALK",
            "narrator": "みやび",
            "text": "ち、ちくっと\nデータをまとめちょる\nだけぞね。",
            "zh": "只、只是稍微\n整理下数据\n而已咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、こんな\nコマンドだらけの\n画面見ても――",
            "zh": "话说回来，看这种\n全是命令行指令的\n画面——",
            "narrator_zh": "雅"
        },
        {
            "location": "168/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんには\nわからんやろ？",
            "zh": "燕你也\n看不懂吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "169/TALK",
            "narrator": "つばめ",
            "text": "うーん…、\nそうですねー…。\nでもこれ――",
            "zh": "唔嗯……，\n说得也是呢……。\n可是这个——",
            "narrator_zh": "燕"
        },
        {
            "location": "170/TALK",
            "narrator": "つばめ",
            "text": "管理庁のサーバーに\nハッキングしようと\nしてますよねー？",
            "zh": "是在试图入侵\n管理厅的服务器\n吧——？",
            "narrator_zh": "燕"
        },
        {
            "location": "171/TALK",
            "narrator": "みやび",
            "text": "なっ！？",
            "zh": "什！？",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "つばめ",
            "text": "抜けてるなぁ…。\nわたしはスパイなん\nですよ？",
            "zh": "太大意了啊……。\n我可是\n间谍哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "174/TALK",
            "narrator": "つばめ",
            "text": "これくらいのこと、\nわかってるに\n決まってますよ。",
            "zh": "这种程度的事，\n我当然\n看得懂啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "雅"
        },
        {
            "location": "176/TALK",
            "narrator": "みやび",
            "text": "やっぱり…、\nつばめちゃんは\nスパイやったか…。",
            "zh": "果然……，\n燕她\n就是间谍……。",
            "narrator_zh": "雅"
        },
        {
            "location": "179/TALK",
            "narrator": "神楽",
            "text": "おっと。",
            "zh": "哎呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "180/TALK",
            "narrator": "神楽",
            "text": "はい、残念。\n逃がしませんよ。",
            "zh": "真遗憾。\n不会放你逃掉的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "182/TALK",
            "narrator": "みやび",
            "text": "なっ！？\n卯月、あんたもか！！",
            "zh": "什！？\n卯月，连你也是吗！！",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "神楽",
            "text": "さあ、つばめさん。\nこそこそと嗅ぎまわる\nネズミを――",
            "zh": "来吧，燕。\n把这只鬼鬼祟祟\n四处嗅探的老鼠——",
            "narrator_zh": "神乐"
        },
        {
            "location": "185/TALK",
            "narrator": "神楽",
            "text": "管理庁に\n連行しましょう。",
            "zh": "押送去\n管理厅吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "187/TALK",
            "narrator": "つばめ",
            "text": "うん。\nそれじゃ、\nしゅっぱーつ！",
            "zh": "嗯。\n那么，\n出发——！",
            "narrator_zh": "燕"
        },
        {
            "location": "190/TALK",
            "narrator": "みやび",
            "text": "い、嫌や！\n離せ、離せー！",
            "zh": "不、不要！\n放开，放开我——！",
            "narrator_zh": "雅"
        },
        {
            "location": "203/DIALOG",
            "narrator": "",
            "text": "<color=black><size=50><b>みやびを拘束しようとする\nつばめ達を倒せ！</b></size></color>\n\n\n\n警戒するあまり、\n心の中では敏腕スパイと化した逢瀬つばめ。\n\nその妄想は、つばめや神楽に対する\nいらぬ警戒心を増幅させるばかりか\nみやびとつばめたちの関係も悪化させてしまう。\n\nトライナリーの平穏のためにも、\nこの虚像たちは倒しておこう。",
            "zh": "<color=black><size=50><b>打倒试图拘束雅的\n燕她们吧！</b></size></color>\n\n\n\n因为过度戒备，\n而在雅心中化身为干练间谍的逢濑燕。\n\n这份妄想，不仅会放大\n对燕和神乐不必要的戒心，\n还会让雅与燕她们的关系恶化。\n\n为了三重奏的安宁，\n先把这些虚像打倒吧。",
            "narrator_zh": ""
        }
    ]
}
