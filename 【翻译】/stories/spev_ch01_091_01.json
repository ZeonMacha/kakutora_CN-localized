{
    "dir": "chap00/daydra/spev_ch01_091_01.js",
    "type": "",
    "info": {
        "story_id": "91021",
        "cid": "",
        "title": "シャッツキステリンク",
        "sub_title": "神楽の大事な忘れもの",
        "title_zh": "schatz-kiste Link",
        "sub_title_zh": "神乐重要的遗落物"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "シャッツキステコラボ：神楽の大事な忘れもの",
            "zh": "schatz-kiste联动：神乐重要的遗落物",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "神楽",
            "text": "ハァ…最悪。",
            "zh": "哈啊……最糟了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "24/TALK",
            "narrator": "神楽",
            "text": "…あれは、私にとって\n大切なものなのに…。",
            "zh": "……那对我来说\n是重要的东西……",
            "narrator_zh": "神乐"
        },
        {
            "location": "26/TALK",
            "narrator": "神楽",
            "text": "…あら？",
            "zh": "……哎呀？",
            "narrator_zh": "神乐"
        },
        {
            "location": "27/TALK",
            "narrator": "神楽",
            "text": "$handle$さん、\nいたんですか？",
            "zh": "$handle$，\n你在吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "28/SEL",
            "narrator": "（選択肢）",
            "text": "何かあったの？",
            "zh": "出什么事了？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "29/ACT",
            "narrator": "",
            "text": "何かあったの？",
            "zh": "出什么事了？",
            "narrator_zh": ""
        },
        {
            "location": "31/TALK",
            "narrator": "神楽",
            "text": "いえ…別に…。",
            "zh": "不……没什么……",
            "narrator_zh": "神乐"
        },
        {
            "location": "32/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "神乐"
        },
        {
            "location": "34/TALK",
            "narrator": "神楽",
            "text": "あ、あの…もしかして、\n$handle$さんは\nご存知じゃないですか？",
            "zh": "那、那个……难道，\n$handle$\n不知道吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "35/TALK",
            "narrator": "神楽",
            "text": "私と、つばめさんで\n撮ったプリが\nどこにあるのか…。",
            "zh": "我和燕一起\n拍的大头贴\n在哪里……",
            "narrator_zh": "神乐"
        },
        {
            "location": "36/SEL",
            "narrator": "（選択肢）",
            "text": "いや、知らないよ",
            "zh": "不，我不知道",
            "narrator_zh": "（选项）"
        },
        {
            "location": "37/ACT",
            "narrator": "",
            "text": "いや、知らないよ",
            "zh": "不，我不知道",
            "narrator_zh": ""
        },
        {
            "location": "40/TALK",
            "narrator": "神楽",
            "text": "…そう、ですか。",
            "zh": "……是吗。",
            "narrator_zh": "神乐"
        },
        {
            "location": "41/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "神乐"
        },
        {
            "location": "42/SEL",
            "narrator": "（選択肢）",
            "text": "力になるよ",
            "zh": "我来帮忙",
            "narrator_zh": "（选项）"
        },
        {
            "location": "43/SEL",
            "narrator": "（選択肢）",
            "text": "また撮りに行けばいいよ",
            "zh": "再去拍一次就好了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "44/SEL",
            "narrator": "（選択肢）",
            "text": "次は無くさないようにね",
            "zh": "下次别再弄丢了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "45/ACT",
            "narrator": "",
            "text": "力になるよ",
            "zh": "我来帮忙",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "神楽",
            "text": "…ありがとうございます。",
            "zh": "……谢谢你。",
            "narrator_zh": "神乐"
        },
        {
            "location": "48/TALK",
            "narrator": "神楽",
            "text": "でも、もういいです。\nどうせ見つかりっこ\nないですし…。",
            "zh": "不过，已经不用了。\n反正也\n找不到……",
            "narrator_zh": "神乐"
        },
        {
            "location": "49/SEL",
            "narrator": "（選択肢）",
            "text": "そっか…",
            "zh": "这样啊……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "50/SEL",
            "narrator": "（選択肢）",
            "text": "$me$は探すぞ",
            "zh": "$me$会去找的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "51/ACT",
            "narrator": "",
            "text": "そっか…",
            "zh": "这样啊……",
            "narrator_zh": ""
        },
        {
            "location": "52/TALK",
            "narrator": "神楽",
            "text": "そうですよ…。",
            "zh": "就是这样……",
            "narrator_zh": "神乐"
        },
        {
            "location": "53/TALK",
            "narrator": "神楽",
            "text": "でも、お気持ちだけは\n受け取っておきますね。",
            "zh": "不过，这份心意\n我收下了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "55/TALK",
            "narrator": "神楽",
            "text": "はぁ…。",
            "zh": "唉……",
            "narrator_zh": "神乐"
        },
        {
            "location": "58/ACT",
            "narrator": "",
            "text": "$me$は探すぞ",
            "zh": "$me$会去找的",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "神楽",
            "text": "…ごめんなさい。\nちょっと、嫌な子に\nなっていました…。",
            "zh": "……对不起。\n我刚才有点\n不可爱了……",
            "narrator_zh": "神乐"
        },
        {
            "location": "63/TALK",
            "narrator": "神楽",
            "text": "それじゃあ、\nお言葉に甘えて、\n手伝ってもらいますね。",
            "zh": "那么，\n我就承你的好意，\n请你帮忙了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "65/TALK",
            "narrator": "神楽",
            "text": "実は、プリを\n失くした場所は\nわかっているんです。",
            "zh": "其实，大头贴\n弄丢的地方\n我知道。",
            "narrator_zh": "神乐"
        },
        {
            "location": "66/TALK",
            "narrator": "神楽",
            "text": "でも…――",
            "zh": "可是……——",
            "narrator_zh": "神乐"
        },
        {
            "location": "82/TALK",
            "narrator": "メイド",
            "text": "ようこそ\nおいでくださいました。",
            "zh": "欢迎\n光临。",
            "narrator_zh": "女仆"
        },
        {
            "location": "86/TALK",
            "narrator": "神楽",
            "text": "あ、あの、すみません！\nお尋ねしたいことが\nあるんですが…。",
            "zh": "那、那个，对不起！\n我有事\n想问……",
            "narrator_zh": "神乐"
        },
        {
            "location": "87/TALK",
            "narrator": "メイド",
            "text": "どうなさいましたか？",
            "zh": "怎么了？",
            "narrator_zh": "女仆"
        },
        {
            "location": "88/TALK",
            "narrator": "神楽",
            "text": "…私、先日このお店に\n来たときに、忘れ物を\nしてしまいまして…。",
            "zh": "……我前几天来这家店，\n落下了\n东西……",
            "narrator_zh": "神乐"
        },
        {
            "location": "89/TALK",
            "narrator": "メイド",
            "text": "忘れ物…。",
            "zh": "落下的东西……",
            "narrator_zh": "女仆"
        },
        {
            "location": "90/TALK",
            "narrator": "メイド",
            "text": "あ、もしかして、\nそれはプリでは\nないでしょうか？",
            "zh": "啊，难道\n是大头贴\n吗？",
            "narrator_zh": "女仆"
        },
        {
            "location": "91/TALK",
            "narrator": "神楽",
            "text": "そ、そうです！\nあるんですか？",
            "zh": "对、对！\n有吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "92/TALK",
            "narrator": "メイド",
            "text": "はい。きっと取りに\nいらっしゃると思い、\n保管しておいたんです。",
            "zh": "有的。我想你一定会\n来取，\n就保管起来了。",
            "narrator_zh": "女仆"
        },
        {
            "location": "94/TALK",
            "narrator": "メイド",
            "text": "すぐにお持ちしますので、\n少々お待ちください。",
            "zh": "我马上拿来，\n请稍等。",
            "narrator_zh": "女仆"
        },
        {
            "location": "95/TALK",
            "narrator": "神楽",
            "text": "ありがとうございます！",
            "zh": "谢谢！",
            "narrator_zh": "神乐"
        },
        {
            "location": "99/TALK",
            "narrator": "神楽",
            "text": "…よかった。",
            "zh": "……太好了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "100/TALK",
            "narrator": "メイド",
            "text": "…あ、あら？",
            "zh": "……啊，哎呀？",
            "narrator_zh": "女仆"
        },
        {
            "location": "101/TALK",
            "narrator": "メイド",
            "text": "おかしいわ…。\n確かこの棚の上に…。",
            "zh": "奇怪……\n我记得在这个架子上……",
            "narrator_zh": "女仆"
        },
        {
            "location": "103/TALK",
            "narrator": "神楽",
            "text": "あ、あの…、\nどうかしたんですか？",
            "zh": "那、那个……\n怎么了？",
            "narrator_zh": "神乐"
        },
        {
            "location": "104/TALK",
            "narrator": "メイド",
            "text": "いえ、それが\nどうしてか\n見当たらなくて…。",
            "zh": "不，那个\n不知为什么\n找不到了……",
            "narrator_zh": "女仆"
        },
        {
            "location": "105/TALK",
            "narrator": "神楽",
            "text": "えぇっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "106/TALK",
            "narrator": "メイド",
            "text": "う～ん…。",
            "zh": "嗯……",
            "narrator_zh": "女仆"
        },
        {
            "location": "110/TALK",
            "narrator": "メイド",
            "text": "申し訳ありません。\n確かに棚の上に置いた\nはずなんですが…。",
            "zh": "非常抱歉。\n我确实放在\n架子上的……",
            "narrator_zh": "女仆"
        },
        {
            "location": "111/TALK",
            "narrator": "神楽",
            "text": "そ、そうですか…。",
            "zh": "是、是吗……",
            "narrator_zh": "神乐"
        },
        {
            "location": "112/TALK",
            "narrator": "メイド",
            "text": "はい…本当に\n申し訳ありません…。",
            "zh": "是……真的\n非常抱歉……",
            "narrator_zh": "女仆"
        },
        {
            "location": "113/TALK",
            "narrator": "神楽",
            "text": "い、いえ…元はといえば、\n忘れた私がいけないん\nですから…。",
            "zh": "不、不……说到底，\n是我忘了，\n是我不好……",
            "narrator_zh": "神乐"
        },
        {
            "location": "114/TALK",
            "narrator": "メイド",
            "text": "う～ん…。",
            "zh": "嗯……",
            "narrator_zh": "女仆"
        },
        {
            "location": "115/TALK",
            "narrator": "メイド",
            "text": "やっぱり、何かちょっと\n最近おかしいですね……。",
            "zh": "果然，最近\n有点不对劲……",
            "narrator_zh": "女仆"
        },
        {
            "location": "116/TALK",
            "narrator": "神楽",
            "text": "他にも何か\nあったんですか？",
            "zh": "还发生过\n别的事吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "118/TALK",
            "narrator": "メイド",
            "text": "はい。\n実は、あの棚なんですが\n先日…。",
            "zh": "有的。\n其实，那个架子\n前几天……",
            "narrator_zh": "女仆"
        },
        {
            "location": "132/TALK",
            "narrator": "メイド",
            "text": "あら？　旅人さまの\nお忘れ物かしら？",
            "zh": "哎呀？　是旅人\n落下的东西吗？",
            "narrator_zh": "女仆"
        },
        {
            "location": "133/TALK",
            "narrator": "メイド",
            "text": "…あっ、この旅人さまは、\nいつも交流ノートを\n書いてくれるあの子ね。",
            "zh": "……啊，这位旅人，\n是一直写交流笔记的\n那个孩子。",
            "narrator_zh": "女仆"
        },
        {
            "location": "134/TALK",
            "narrator": "メイド",
            "text": "お友達と一緒のプリを\n忘れてしまうなんて…、\nきっと困ってるわ。",
            "zh": "把和朋友一起的大头贴\n落下了……\n一定很为难。",
            "narrator_zh": "女仆"
        },
        {
            "location": "135/TALK",
            "narrator": "メイド",
            "text": "…とりあえず、\n交流ノートの間に\n挟んで…。",
            "zh": "……总之，\n先夹在\n交流笔记里……",
            "narrator_zh": "女仆"
        },
        {
            "location": "137/TALK",
            "narrator": "メイド",
            "text": "…あら？\nこんな本、棚の上に\n置いてあったかしら？",
            "zh": "……哎呀？\n这种书，架子上\n原来有吗？",
            "narrator_zh": "女仆"
        },
        {
            "location": "138/TALK",
            "narrator": "メイド",
            "text": "元々あった本がないし…、\n誰か置き換えた…？",
            "zh": "原来的书不见了……\n是谁换掉的……？",
            "narrator_zh": "女仆"
        },
        {
            "location": "154/TALK",
            "narrator": "神楽",
            "text": "…どういうことですか？",
            "zh": "……这是怎么回事？",
            "narrator_zh": "神乐"
        },
        {
            "location": "155/TALK",
            "narrator": "メイド",
            "text": "わからないんです。",
            "zh": "我也不知道。",
            "narrator_zh": "女仆"
        },
        {
            "location": "156/TALK",
            "narrator": "メイド",
            "text": "他の子に聞いても、\n誰も本を置き換えて\nいないと言っていて…。",
            "zh": "问了其他孩子，\n都说没有\n换过书……",
            "narrator_zh": "女仆"
        },
        {
            "location": "157/TALK",
            "narrator": "メイド",
            "text": "今も、交流ノート自体は\nあったんですが…。",
            "zh": "现在，交流笔记本身\n还在……",
            "narrator_zh": "女仆"
        },
        {
            "location": "158/TALK",
            "narrator": "神楽",
            "text": "まさか、メイドさんの\n知らない交流ノート…、\nだったんですか？",
            "zh": "难道，是女仆\n不知道的交流笔记……\n吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "159/TALK",
            "narrator": "メイド",
            "text": "…はい。",
            "zh": "……是的。",
            "narrator_zh": "女仆"
        },
        {
            "location": "160/TALK",
            "narrator": "神楽",
            "text": "…確かに、不思議ですね。",
            "zh": "……确实，很不可思议。",
            "narrator_zh": "神乐"
        },
        {
            "location": "162/TALK",
            "narrator": "神楽",
            "text": "無くなってるわけじゃ\nなくて、別の物に\n変わってるなんて…。",
            "zh": "不是不见了，\n而是变成了\n别的东西……",
            "narrator_zh": "神乐"
        },
        {
            "location": "163/TALK",
            "narrator": "メイド",
            "text": "そうなんです…。",
            "zh": "就是这样……",
            "narrator_zh": "女仆"
        },
        {
            "location": "164/TALK",
            "narrator": "メイド",
            "text": "ですが、旅人さんの\nお忘れ物を紛失して\nしまったのは事実です。",
            "zh": "不过，把旅人\n落下的东西弄丢了，\n是事实。",
            "narrator_zh": "女仆"
        },
        {
            "location": "166/TALK",
            "narrator": "メイド",
            "text": "わざわざ取りに来て\nいただいたのに、\n申し訳ありません…。",
            "zh": "你特地来取，\n却是这样，\n非常抱歉……",
            "narrator_zh": "女仆"
        },
        {
            "location": "167/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "神乐"
        },
        {
            "location": "178/TALK",
            "narrator": "神楽",
            "text": "…ということが\nあったんです。",
            "zh": "……就是这么\n一回事。",
            "narrator_zh": "神乐"
        },
        {
            "location": "180/TALK",
            "narrator": "神楽",
            "text": "…元々あった物が消えて、\n別の物と入れ替わる。",
            "zh": "……原来的东西消失，\n和别的东西对调。",
            "narrator_zh": "神乐"
        },
        {
            "location": "181/TALK",
            "narrator": "神楽",
            "text": "これって、どういうこと\nだと思いますか？",
            "zh": "你觉得\n这是怎么回事？",
            "narrator_zh": "神乐"
        },
        {
            "location": "182/SEL",
            "narrator": "（選択肢）",
            "text": "いや、さっぱりだ",
            "zh": "不，完全不知道",
            "narrator_zh": "（选项）"
        },
        {
            "location": "183/SEL",
            "narrator": "（選択肢）",
            "text": "どこかの世界と繋がってひっくり返ってるとか",
            "zh": "是不是和某个世界连上，翻了个个",
            "narrator_zh": "（选项）"
        },
        {
            "location": "184/ACT",
            "narrator": "",
            "text": "いや、さっぱりだ",
            "zh": "不，完全不知道",
            "narrator_zh": ""
        },
        {
            "location": "185/TALK",
            "narrator": "神楽",
            "text": "ですよね…。",
            "zh": "也是……",
            "narrator_zh": "神乐"
        },
        {
            "location": "186/TALK",
            "narrator": "神楽",
            "text": "…私も、色々と考えては\nみたんです。",
            "zh": "……我也想过\n很多。",
            "narrator_zh": "神乐"
        },
        {
            "location": "187/TALK",
            "narrator": "神楽",
            "text": "もしかしたら、\nあの棚はどこかの世界と\n繋がってる、と。",
            "zh": "也许，\n那个架子和某个世界\n连着。",
            "narrator_zh": "神乐"
        },
        {
            "location": "188/TALK",
            "narrator": "神楽",
            "text": "そして、別の世界の\nその場所にあった物と、\n入れ替わっている。",
            "zh": "然后，和另一个世界\n那个地方的东西\n对调了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "189/TALK",
            "narrator": "神楽",
            "text": "…この可能性、\n意外とあると思うんです。",
            "zh": "……这个可能，\n我觉得意外地有。",
            "narrator_zh": "神乐"
        },
        {
            "location": "190/ACT",
            "narrator": "",
            "text": "どこかの世界と繋がってひっくり返ってるとか",
            "zh": "是不是和某个世界连上，翻了个个",
            "narrator_zh": ""
        },
        {
            "location": "191/TALK",
            "narrator": "神楽",
            "text": "…それ、私もちょっとだけ\n考えました。",
            "zh": "……这个，我也稍微\n想过。",
            "narrator_zh": "神乐"
        },
        {
            "location": "192/TALK",
            "narrator": "神楽",
            "text": "あの場所は、もしかしたら\n別の世界と何らかの形で\n繋がってるのでは、と。",
            "zh": "那个地方，也许\n以某种形式\n和别的世界连着。",
            "narrator_zh": "神乐"
        },
        {
            "location": "193/TALK",
            "narrator": "神楽",
            "text": "そして何かが干渉して、\nその場にある物同士が\n入れ替わっている…。",
            "zh": "然后有什么干涉，\n当场的东西彼此\n对调了……",
            "narrator_zh": "神乐"
        },
        {
            "location": "194/TALK",
            "narrator": "神楽",
            "text": "…$handle$さんも\nそう思ったなら、本当に\nそうなのかもしれません。",
            "zh": "……$handle$也\n这么想的话，也许\n真是这样。",
            "narrator_zh": "神乐"
        },
        {
            "location": "196/TALK",
            "narrator": "神楽",
            "text": "…そうだ！",
            "zh": "……对了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "197/TALK",
            "narrator": "神楽",
            "text": "貴方の世界に、\n『シャッツキステ』という\nお店はありますか？",
            "zh": "在你的世界里，\n有一家叫『schatz-kiste』的\n店吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "198/TALK",
            "narrator": "神楽",
            "text": "もしあるなら、\n是非プリがあるか\n探してほしいんです。",
            "zh": "如果有的话，\n请务必找一找\n有没有大头贴。",
            "narrator_zh": "神乐"
        },
        {
            "location": "200/TALK",
            "narrator": "神楽",
            "text": "もしお店があるなら、\n貴方の世界に紛れ込んだ\n可能性もありますので…。",
            "zh": "如果店在的话，\n也可能混进了\n你的世界……",
            "narrator_zh": "神乐"
        },
        {
            "location": "201/SEL",
            "narrator": "（選択肢）",
            "text": "$me$が並行世界の住人って知ってるの？",
            "zh": "你知道$me$是平行世界的人？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "202/ACT",
            "narrator": "",
            "text": "$me$が並行世界の住人って知ってるの？",
            "zh": "你知道$me$是平行世界的人？",
            "narrator_zh": ""
        },
        {
            "location": "205/TALK",
            "narrator": "神楽",
            "text": "…はい。\n実は、ずーっと前から\n知っていました…。",
            "zh": "……是的。\n其实，从很久以前\n我就知道……",
            "narrator_zh": "神乐"
        },
        {
            "location": "206/TALK",
            "narrator": "神楽",
            "text": "でも、何でそれを\n知っているかは秘密です。",
            "zh": "不过，我为什么\n知道，是秘密。",
            "narrator_zh": "神乐"
        },
        {
            "location": "207/TALK",
            "narrator": "神楽",
            "text": "こんなタイミングで、\n私の口から話すことは\nできませんので。",
            "zh": "在这种时候，\n不能由我\n说出来。",
            "narrator_zh": "神乐"
        },
        {
            "location": "208/TALK",
            "narrator": "神楽",
            "text": "…でも、そろそろ秘密でも\nなんでもなくなってきそう\nですけど。",
            "zh": "……不过，好像快要\n不再是什么\n秘密了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "209/TALK",
            "narrator": "神楽",
            "text": "…とにかく、プリの件\nよろしくお願いしますね。",
            "zh": "……总之，大头贴的事\n就拜托你了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "210/ACT",
            "narrator": "",
            "text": "また撮りに行けばいい",
            "zh": "再去拍一次就好",
            "narrator_zh": ""
        },
        {
            "location": "211/TALK",
            "narrator": "神楽",
            "text": "簡単に\n言わないでください！",
            "zh": "请不要\n说得那么轻松！",
            "narrator_zh": "神乐"
        },
        {
            "location": "212/TALK",
            "narrator": "神楽",
            "text": "また撮りになんて、\n行けるかどうか\nわからないんですから…。",
            "zh": "再去拍一次，\n也不知道\n能不能去……",
            "narrator_zh": "神乐"
        },
        {
            "location": "213/SEL",
            "narrator": "（選択肢）",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "214/ACT",
            "narrator": "",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "217/TALK",
            "narrator": "神楽",
            "text": "…いえ、\n何でもありません。",
            "zh": "……不，\n没什么。",
            "narrator_zh": "神乐"
        },
        {
            "location": "218/TALK",
            "narrator": "神楽",
            "text": "知らないなら、いいです。\nありがとうございました。",
            "zh": "不知道的话，就好。\n谢谢你。",
            "narrator_zh": "神乐"
        },
        {
            "location": "221/ACT",
            "narrator": "",
            "text": "次は無くさないようにね",
            "zh": "下次别再弄丢了",
            "narrator_zh": ""
        },
        {
            "location": "223/TALK",
            "narrator": "神楽",
            "text": "…そう、ですね。",
            "zh": "……说得也是。",
            "narrator_zh": "神乐"
        },
        {
            "location": "224/TALK",
            "narrator": "神楽",
            "text": "もし…次があれば\nですけど…。",
            "zh": "如果……还有下次\n的话……",
            "narrator_zh": "神乐"
        },
        {
            "location": "225/SEL",
            "narrator": "（選択肢）",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "226/ACT",
            "narrator": "",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "229/TALK",
            "narrator": "神楽",
            "text": "…いえ、\n何でもありません。",
            "zh": "……不，\n没什么。",
            "narrator_zh": "神乐"
        },
        {
            "location": "230/TALK",
            "narrator": "神楽",
            "text": "知らないならいいんです。\nありがとうございました。",
            "zh": "不知道就好。\n谢谢你。",
            "narrator_zh": "神乐"
        }
    ]
}
