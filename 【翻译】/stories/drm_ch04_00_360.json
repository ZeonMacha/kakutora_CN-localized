        },
        {
            "location": "298/SEL",
            "narrator": "",
            "text": "みやびのためなら",
            "zh": "为了雅的话",
            "narrator_zh": ""
        },
        {
            "location": "299/ACT",
            "narrator": "",
            "text": "わかった",
            "zh": "知道了",
            "narrator_zh": ""
        },
        {
            "location": "301/TALK",
            "narrator": "ラビットアニマ",
            "text": "よかったです",
