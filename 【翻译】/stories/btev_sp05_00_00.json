{
    "dir": "chap21/battle/btev_sp05_00_00.js",
    "type": "EventQuest",
    "info": {
        "story_id": "10601",
        "cid": "all",
        "title": "【期間限定】夏は短しハジけよ乙女♪",
        "sub_title": "夏は短しハジけよ乙女♪＜願望編＞",
        "title_zh": "【期间限定】夏日苦短，绽放吧少女♪",
        "sub_title_zh": "夏日苦短，绽放吧少女♪＜愿望篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "夏は短しハジけよ乙女♪＜願望編＞",
            "zh": "夏日苦短，绽放吧少女♪＜愿望篇＞",
            "narrator_zh": ""
        },
        {
            "location": "25/TALK",
            "narrator": "真幌",
            "text": "よし、みんな！\n今日はめいっぱい\n遊んでいいぞ！",
            "zh": "好，大家！\n今天可以放开了\n尽情玩个痛快！",
            "narrator_zh": "真幌"
        },
        {
            "location": "26/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\n本当にいいんですか？",
            "zh": "诶诶！？\n真的可以吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "27/TALK",
            "narrator": "真幌",
            "text": "本当もなにも、\n海に来て遊ばないとか\n勿体ないだろう？",
            "zh": "什么真的假的，\n来海边不玩的话\n岂不是太浪费了吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "28/TALK",
            "narrator": "神楽",
            "text": "さすが真幌さんです！",
            "zh": "真不愧是真幌！",
            "narrator_zh": "神乐"
        },
        {
            "location": "29/TALK",
            "narrator": "神楽",
            "text": "それじゃつばめさん、\n今日は思いっきり\n遊んじゃいましょ！",
            "zh": "那么燕，\n今天咱们就痛痛快快\n玩个够吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "うん！\nわたし、神楽ちゃんと\n遊びたかったんだ。",
            "zh": "嗯！\n我也好想跟神乐\n一起玩呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "真幌",
            "text": "あまり遠くへ\n行くんじゃないぞー。",
            "zh": "别跑到太远的地方\n去了哦——。",
            "narrator_zh": "真幌"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃん、\nいくよー！",
            "zh": "神乐，\n我发球啦——！",
            "narrator_zh": "燕"
        },
        {
            "location": "46/TALK",
            "narrator": "神楽",
            "text": "はい、こっちも\n返します！",
            "zh": "好，这边也\n回敬你！",
            "narrator_zh": "神乐"
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "よーし、それじゃあ…。",
            "zh": "好咧，那我就要……。",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "たーっ！！",
            "zh": "嘿——！！",
            "narrator_zh": "燕"
        },
        {
            "location": "49/TALK",
            "narrator": "神楽",
            "text": "あ、あわわわわ！",
            "zh": "啊、啊啊哇哇哇！",
            "narrator_zh": "神乐"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "ご、ごめん！\n大丈夫！？",
            "zh": "对、对不起！\n你没事吧！？",
            "narrator_zh": "燕"
        },
        {
            "location": "51/TALK",
            "narrator": "神楽",
            "text": "はい。\nすぐ取ってきますね。",
            "zh": "没事。\n我这就去把球捡回来哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "53/TALK",
            "narrator": "つばめ",
            "text": "（…………。）",
            "zh": "（…………。）",
            "narrator_zh": "燕"
        },
        {
            "location": "54/SEL",
            "narrator": "",
            "text": "仲がいいね",
            "zh": "关系真好啊",
            "narrator_zh": ""
        },
        {
            "location": "55/ACT",
            "narrator": "",
            "text": "仲がいいね",
            "zh": "关系真好啊",
            "narrator_zh": ""
        },
        {
            "location": "57/TALK",
            "narrator": "つばめ",
            "text": "うん…。\nココロの中だからね。",
            "zh": "嗯……。\n因为是在心里面嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "現実だと、わたし達、\nまだギスギスしちゃって\nる",
            "zh": "在现实里，我们俩\n还是处得有点\n僵硬",
            "narrator_zh": "燕"
        },
        {
            "location": "59/TALK",
            "narrator": "つばめ",
            "text": "けど…。",
            "zh": "就是了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "60/TALK",
            "narrator": "つばめ",
            "text": "だからかな？\nココロの中でだけでも、\n仲良くしてたいの。",
            "zh": "正因如此吧？\n所以才想至少在心里面，\n也能和她好好相处呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "現実から見たら、\nただの妄想でしか\nないけど…。",
            "zh": "虽然从现实看来，\n这不过是一场\n妄想罢了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "62/SEL",
            "narrator": "",
            "text": "空しいだけだと思う",
            "zh": "我觉得那样只会觉得空虚",
            "narrator_zh": ""
        },
        {
            "location": "63/SEL",
            "narrator": "",
            "text": "仲良い姿は見てて嬉しい",
            "zh": "看你们相处得那么好我也很开心",
            "narrator_zh": ""
        },
        {
            "location": "64/ACT",
            "narrator": "",
            "text": "空しいだけだと思う",
            "zh": "我觉得那样只会觉得空虚",
            "narrator_zh": ""
        },
        {
            "location": "65/TALK",
            "narrator": "つばめ",
            "text": "そうかもしれないけど…。",
            "zh": "或许是那样吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "66/TALK",
            "narrator": "つばめ",
            "text": "でも、神楽ちゃんと\n一緒にいられないの、\nとっても辛くて…。",
            "zh": "可是，不能跟神乐\n待在一起，\n真的让人好难受呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "67/SEL",
            "narrator": "",
            "text": "僕がいるじゃないか",
            "zh": "这不还有我吗",
            "narrator_zh": ""
        },
        {
            "location": "68/SEL",
            "narrator": "",
            "text": "僕はいらないんだ？",
            "zh": "原来不需要我啊？",
            "narrator_zh": ""
        },
        {
            "location": "69/ACT",
            "narrator": "",
            "text": "僕がいるじゃないか",
            "zh": "这不还有我吗",
            "narrator_zh": ""
        },
        {
            "location": "70/ACT",
            "narrator": "",
            "text": "僕はいらないんだ？",
            "zh": "原来不需要我啊？",
            "narrator_zh": ""
        },
        {
            "location": "71/TALK",
            "narrator": "つばめ",
            "text": "そうだけど…。",
            "zh": "话是这么说没错啦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "72/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんと\n神楽ちゃんは、\n別だから…。",
            "zh": "$handle$和\n神乐，\n是不一样的嘛……。",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "つばめ",
            "text": "ごめんね…。",
            "zh": "对不起呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "75/TALK",
            "narrator": "つばめ",
            "text": "もう少しだけ、\nこの時間を楽しませて。",
            "zh": "再稍微让我，\n多享受一会儿这份时光吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "76/ACT",
            "narrator": "",
            "text": "仲良い姿は見てて嬉しい",
            "zh": "看你们相处得那么好我也很开心",
            "narrator_zh": ""
        },
        {
            "location": "77/TALK",
            "narrator": "つばめ",
            "text": "そう言ってもらえると、\nとっても嬉しい。",
            "zh": "能听你这么说，\n我真的好开心。",
            "narrator_zh": "燕"
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "作り物の世界なのは\nわかってるけど…。",
            "zh": "虽然明知道这是\n虚构出来的世界……。",
            "narrator_zh": "燕"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "それでも、わたしも\nとっても楽しいし…。",
            "zh": "即便如此，我也\n还是觉得好开心……。",
            "narrator_zh": "燕"
        },
        {
            "location": "80/SEL",
            "narrator": "",
            "text": "戻ってくるか心配",
            "zh": "真担心你能不能回来啊",
            "narrator_zh": ""
        },
        {
            "location": "81/ACT",
            "narrator": "",
            "text": "戻ってくるか心配",
            "zh": "真担心你能不能回来啊",
            "narrator_zh": ""
        },
        {
            "location": "83/TALK",
            "narrator": "つばめ",
            "text": "大丈夫だよ。",
            "zh": "没问题的哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "84/TALK",
            "narrator": "つばめ",
            "text": "やっぱりこの世界の\n神楽ちゃんは、\n本物じゃないし…。",
            "zh": "毕竟这个世界里的\n神乐，\n终究不是真正的她嘛……。",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "神楽",
            "text": "つばめさーん！",
            "zh": "燕——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "88/TALK",
            "narrator": "神楽",
            "text": "お待たせしました！\nボール取ってきたんで、\n再開しましょう！",
            "zh": "让你久等了！\n球捡回来了，\n我们继续吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "89/TALK",
            "narrator": "つばめ",
            "text": "…うん！",
            "zh": "……嗯！",
            "narrator_zh": "燕"
        },
        {
            "location": "93/TALK",
            "narrator": "神楽",
            "text": "…沢山遊びましたね。\nとっても楽しかったです！",
            "zh": "……玩了这么久呢。\n真是太开心了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "94/TALK",
            "narrator": "つばめ",
            "text": "わたしも…、\n本当に楽しかった…。",
            "zh": "我也是……，\n真的玩得好开心……。",
            "narrator_zh": "燕"
        },
        {
            "location": "95/TALK",
            "narrator": "神楽",
            "text": "ふふっ、よかった…。",
            "zh": "呵呵，太好了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "96/TALK",
            "narrator": "神楽",
            "text": "それじゃあ、そろそろ\n家に戻りましょう。",
            "zh": "那么，差不多该\n回家去了吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "97/TALK",
            "narrator": "つばめ",
            "text": "（…………。）",
            "zh": "（…………。）",
            "narrator_zh": "燕"
        },
        {
            "location": "98/TALK",
            "narrator": "神楽",
            "text": "つばめさん？",
            "zh": "燕？",
            "narrator_zh": "神乐"
        },
        {
            "location": "99/TALK",
            "narrator": "つばめ",
            "text": "…神楽ちゃん、\n先帰ってて。",
            "zh": "……神乐，\n你先回去吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "100/TALK",
            "narrator": "つばめ",
            "text": "わたし…、\n$handle$さんと、\nお話があるから…。",
            "zh": "我……，\n还有点话想单独\n跟$handle$说说……。",
            "narrator_zh": "燕"
        },
        {
            "location": "101/TALK",
            "narrator": "神楽",
            "text": "えっ！？\n二人きりでお話！？",
            "zh": "诶！？\n两个人单独聊天！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "102/TALK",
            "narrator": "神楽",
            "text": "まさか…愛の告白を\nしちゃうんですか！？",
            "zh": "难道说……是要来一场\n爱的告白吗！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "103/SEL",
            "narrator": "",
            "text": "イエス、神楽が好きです",
            "zh": "是的，我喜欢神乐",
            "narrator_zh": ""
        },
        {
            "location": "104/SEL",
            "narrator": "",
            "text": "そうなんだ、大好きだよつばめ",
            "zh": "是啊，我最喜欢你了，燕",
            "narrator_zh": ""
        },
        {
            "location": "105/ACT",
            "narrator": "",
            "text": "イエス、神楽が好きです",
            "zh": "是的，我喜欢神乐",
            "narrator_zh": ""
        },
        {
            "location": "106/TALK",
            "narrator": "神楽",
            "text": "私にですか！？",
            "zh": "对、对我吗！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "107/TALK",
            "narrator": "つばめ",
            "text": "ちょ、\n$handle$さん！",
            "zh": "喂，\n$handle$！",
            "narrator_zh": "燕"
        },
        {
            "location": "108/TALK",
            "narrator": "つばめ",
            "text": "告白じゃなくて、\nちょっとお話があるだけ\nだから…。",
            "zh": "才不是要告白啦，\n就只是有点话想说\n而已……。",
            "narrator_zh": "燕"
        },
        {
            "location": "109/TALK",
            "narrator": "神楽",
            "text": "ほっ、ビックリした…。\n$handle$さんは\n冗談が過ぎますよ。",
            "zh": "呼，吓我一跳……。\n$handle$你这玩笑\n开得太过分了哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "110/TALK",
            "narrator": "神楽",
            "text": "…まあ、嬉しいな、とは\n思いましたけどね。",
            "zh": "……不过，其实我倒是\n觉得挺开心的就是了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "111/ACT",
            "narrator": "",
            "text": "そうなんだ、大好きだよつばめ",
            "zh": "是啊，我最喜欢你了，燕",
            "narrator_zh": ""
        },
        {
            "location": "113/TALK",
            "narrator": "神楽",
            "text": "ふふっ、\nそれじゃあお先に。",
            "zh": "呵呵，\n那我就先走一步啦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "115/TALK",
            "narrator": "つばめ",
            "text": "もぉ…真面目な話を\nするんだから、\n冗談は言わないでよぉ…。",
            "zh": "真是的……明明要谈\n正经事的嘛，\n别开那种玩笑啦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "116/SEL",
            "narrator": "",
            "text": "ごめんね。それで、話って？",
            "zh": "抱歉抱歉。那，你想说什么？",
            "narrator_zh": ""
        },
        {
            "location": "117/ACT",
            "narrator": "",
            "text": "ごめんね。それで、話って？",
            "zh": "抱歉抱歉。那，你想说什么？",
            "narrator_zh": ""
        },
        {
            "location": "119/TALK",
            "narrator": "つばめ",
            "text": "うん…簡単なこと\nなんだけど…。",
            "zh": "嗯……其实只是件\n很简单的事……。",
            "narrator_zh": "燕"
        },
        {
            "location": "120/TALK",
            "narrator": "つばめ",
            "text": "わたしにね、\n勇気が出るおまじないを\nしてほしいの。",
            "zh": "我想让你对我念一个\n能鼓起勇气的\n小咒语呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "121/TALK",
            "narrator": "つばめ",
            "text": "だって、この世界は\nわたしが逃げるための\n妄想の世界でしょ？",
            "zh": "因为，这个世界\n是我为了逃避现实而\n妄想出来的世界吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "122/TALK",
            "narrator": "つばめ",
            "text": "現実の神楽ちゃんのこと、\n考えてると辛くなる\nからって…。",
            "zh": "觉得一想到现实里的神乐\n心里就会好难受，\n所以才……。",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "つばめ",
            "text": "偽物の神楽ちゃんで、\n癒されるために\n作った世界…。",
            "zh": "为了能从假的神乐那里\n获得安慰，而创造出来的\n世界……。",
            "narrator_zh": "燕"
        },
        {
            "location": "124/TALK",
            "narrator": "つばめ",
            "text": "だから、この世界に\nこれ以上いたらいけない。",
            "zh": "所以，我不能再继续\n留在这个世界里了。",
            "narrator_zh": "燕"
        },
        {
            "location": "125/TALK",
            "narrator": "つばめ",
            "text": "ちゃんと現実で、\n神楽ちゃんのこと、\n考えないといけないから。",
            "zh": "必须要在现实里，\n好好地去思考\n神乐的事才行。",
            "narrator_zh": "燕"
        },
        {
            "location": "126/TALK",
            "narrator": "つばめ",
            "text": "だから…、\nお願いしていいかな？",
            "zh": "所以……，\n可以拜托你吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "127/SEL",
            "narrator": "",
            "text": "つばめが望むなら",
            "zh": "只要是燕的心愿",
            "narrator_zh": ""
        },
        {
            "location": "128/ACT",
            "narrator": "",
            "text": "つばめが望むなら",
            "zh": "只要是燕的心愿",
            "narrator_zh": ""
        },
        {
            "location": "130/TALK",
            "narrator": "つばめ",
            "text": "うん、お願いします。",
            "zh": "嗯，那就拜托你啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "131/TALK",
            "narrator": "つばめ",
            "text": "今より、もっと心を\n強くするために！",
            "zh": "为了能让自己的心，\n变得比现在更加坚强！",
            "narrator_zh": "燕"
        }
    ]
}
