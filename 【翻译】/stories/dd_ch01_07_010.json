    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "迷子",
            "zh": "迷路",
            "narrator_zh": ""
        },
        {
            "location": "18/TALK",
            "narrator": "つばめ",
            "text": "えっと、確かここを\n曲がると…。",
            "zh": "那个，记得从这里\n拐弯就……。",
            "narrator_zh": "燕"
        },
        {
            "location": "20/TALK",
            "narrator": "つばめ",
            "text": "…やっぱり違う。\nどうしよう…。",
            "zh": "……果然不对。\n怎么办……。",
            "narrator_zh": "燕"
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "道に迷っちゃった(´・ω・｀)",
            "zh": "迷路了(´・ω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "34/SEL",
            "narrator": "",
            "text": "今、どの辺にいるの？",
            "zh": "你现在在哪一带？",
            "narrator_zh": ""
        },
        {
            "location": "35/ACT",
            "narrator": "",
            "text": "今、どの辺にいるの？",
            "zh": "你现在在哪一带？",
            "narrator_zh": ""
        },
        {
            "location": "37/TALK",
            "narrator": "つばめ",
            "text": "神楽坂の駅を出たところ(･ｪ･^ )( ^･ｪ･)",
            "zh": "神乐坂站出来的地方(･ｪ･^ )( ^･ｪ･)",
            "narrator_zh": "燕"
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "そんなに駅から離れてなぃと思うけど",
            "zh": "应该没离车站太远",
            "narrator_zh": "燕"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "よくわからない(´つω・｀)ｼｭﾝ",
            "zh": "搞不清楚(´つω・｀)ｼｭﾝ",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "どぅしよぅ",
            "zh": "怎么办哦",
            "narrator_zh": "燕"
        },
        {
            "location": "42/TALK",
            "narrator": "つばめ",
            "text": "言われた時間に遅れちゃぅ・゜・(ノД`)・゜・",
            "zh": "要赶不上说好的时间了・゜・(ノД`)・゜・",
            "narrator_zh": "燕"
        },
        {
            "location": "44/SEL",
            "narrator": "",
            "text": "みやびに電話して助けてもらおう",
            "zh": "给雅打电话求救吧",
            "narrator_zh": ""
        },
        {
            "location": "45/SEL",
            "narrator": "",
            "text": "父親に電話して助けてもらおう！",
            "zh": "给爸爸打电话求救吧！",
            "narrator_zh": ""
        },
        {
            "location": "46/ACT",
            "narrator": "",
            "text": "みやびに電話して助けてもらおう",
            "zh": "给雅打电话求救吧",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "みやびさんを？",
            "zh": "找雅？",
            "narrator_zh": "燕"
        },
        {
            "location": "49/TALK",
            "narrator": "つばめ",
            "text": "大丈夫",
            "zh": "不要紧",
            "narrator_zh": "燕"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "燕"
        },
        {
            "location": "51/TALK",
            "narrator": "つばめ",
            "text": "まだほとんど知らなぃ人だし",
            "zh": "还几乎不认识的人",
            "narrator_zh": "燕"
        },
        {
            "location": "52/TALK",
            "narrator": "つばめ",
            "text": "こんな理由で呼び出したら",
            "zh": "因为这种理由叫出来",
            "narrator_zh": "燕"
        },
        {
            "location": "53/TALK",
            "narrator": "つばめ",
            "text": "失礼だよ(o´Д`)=з",
            "zh": "很失礼(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "55/SEL",
            "narrator": "",
            "text": "仲間になる人だよ？",
            "zh": "是要成为同伴的人哦？",
            "narrator_zh": ""
        },
        {
            "location": "56/ACT",
            "narrator": "",
            "text": "仲間になる人だよ？",
            "zh": "是要成为同伴的人哦？",
            "narrator_zh": ""
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "それはそぅだけど",
            "zh": "那是那样",
            "narrator_zh": "燕"
        },
        {
            "location": "59/TALK",
            "narrator": "つばめ",
            "text": "大丈夫かな？(･Д･｀)",
            "zh": "不要紧吗？(･Д･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "61/SEL",
            "narrator": "",
            "text": "みやびは面倒見のいい人だ",
            "zh": "雅是会照顾人的人",
            "narrator_zh": ""
        },
        {
            "location": "62/ACT",
            "narrator": "",
            "text": "みやびは面倒見のいい人だ",
            "zh": "雅是会照顾人的人",
            "narrator_zh": ""
        },
        {
            "location": "64/TALK",
            "narrator": "つばめ",
            "text": "そぅなの？(*´︶`*)",
            "zh": "是这样吗？(*´︶`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "66/TALK",
            "narrator": "つばめ",
            "text": "わかった",
            "zh": "知道了",
            "narrator_zh": "燕"
        },
        {
            "location": "67/TALK",
            "narrator": "つばめ",
            "text": "ぉ願ぃしてみるo(*･ﾛ･*)o、",
            "zh": "我去拜托看看o(*･ﾛ･*)o、",
            "narrator_zh": "燕"
        },
        {
            "location": "72/TALK",
            "narrator": "つばめ",
            "text": "…………",
            "zh": "…………",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "つばめ",
            "text": "よし、これで…送信！",
            "zh": "好，这样就……发送！",
            "narrator_zh": "燕"
        },
        {
            "location": "77/TALK",
            "narrator": "つばめ",
            "text": "初めて送るメッセージが\n助けてなんて、ちょっと\nかっこ悪いけど――",
            "zh": "第一次发的消息\n却是求救，有点\n不帅气——",
            "narrator_zh": "燕"
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "みやびさん、\nお願いします！",
            "zh": "雅，\n拜托了！",
            "narrator_zh": "燕"
        },
        {
            "location": "85/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "87/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "…あっ！\nみやびさーん！！",
            "zh": "……啊！\n雅——！！",
            "narrator_zh": "燕"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "お待たせ、つばめちゃん。",
            "zh": "让你等了，燕。",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "つばめ",
            "text": "ごめんなさい、急に\n呼び出しちゃったりして。",
            "zh": "对不起，突然\n把你叫出来。",
            "narrator_zh": "燕"
        },
        {
            "location": "95/TALK",
            "narrator": "みやび",
            "text": "えいからえいから。\nこういう時のための\nお友達登録やき。",
            "zh": "要得，要得。\n朋友登记就是为了\n这种时候啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "まあ、まだ来たばかり\nやき、何も恥ずかしい\nことやないよ？",
            "zh": "嘛，才刚来啵，\n没什么好\n害羞的哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "つばめ",
            "text": "ごめんなさい。でも、\nできればこれっきりに\nしたいです…。",
            "zh": "对不起。不过，\n我希望就这一次\n就好……。",
            "narrator_zh": "燕"
        },
        {
            "location": "99/ACT",
            "narrator": "",
            "text": "父親に電話して助けてもらおう！",
            "zh": "给爸爸打电话求救吧！",
            "narrator_zh": ""
        },
        {
            "location": "100/TALK",
            "narrator": "つばめ",
            "text": "ぇっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "102/TALK",
            "narrator": "つばめ",
            "text": "それはちょっと",
            "zh": "这个有点",
            "narrator_zh": "燕"
        },
        {
            "location": "104/TALK",
            "narrator": "つばめ",
            "text": "他の方法考えるよ(´･ω･｀) ",
            "zh": "我再想别的办法(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "106/SEL",
            "narrator": "",
            "text": "どうして？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "107/ACT",
            "narrator": "",
            "text": "どうして？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "109/TALK",
            "narrator": "つばめ",
            "text": "どぅしてって(･Д･｀)",
            "zh": "什么叫为什么(･Д･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "ほら",
            "zh": "你看",
            "narrator_zh": "燕"
        },
        {
            "location": "111/TALK",
            "narrator": "つばめ",
            "text": "ぉ父さん静岡にぃるし",
            "zh": "爸爸在静冈",
            "narrator_zh": "燕"
        },
        {
            "location": "112/TALK",
            "narrator": "つばめ",
            "text": "電話しても無駄だよ(o´Д`)=з",
            "zh": "打电话也没用(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "114/SEL",
            "narrator": "",
            "text": "電話したくないの？",
            "zh": "不想打电话吗？",
            "narrator_zh": ""
        },
        {
            "location": "115/ACT",
            "narrator": "",
            "text": "電話したくないの？",
            "zh": "不想打电话吗？",
            "narrator_zh": ""
        },
        {
            "location": "117/TALK",
            "narrator": "つばめ",
            "text": "そぅぃぅわけじゃなくて",
            "zh": "不是那个意思",
            "narrator_zh": "燕"
        },
        {
            "location": "119/TALK",
            "narrator": "つばめ",
            "text": "そんなことで電話するほど",
            "zh": "这种事还不至于打电话",
            "narrator_zh": "燕"
        },
        {
            "location": "120/TALK",
            "narrator": "つばめ",
            "text": "子供じゃなぃしヾ(｡>﹏<｡)ﾉﾞ",
            "zh": "又不是小孩子ヾ(｡>﹏<｡)ﾉﾞ",
            "narrator_zh": "燕"
        },
        {
            "location": "122/SEL",
            "narrator": "",
            "text": "もしかして、ケンカ中とか？",
            "zh": "难道在吵架？",
            "narrator_zh": ""
        },
        {
            "location": "123/SEL",
            "narrator": "",
            "text": "ごめん、冗談だった",
            "zh": "对不起，是开玩笑的",
            "narrator_zh": ""
        },
        {
            "location": "124/ACT",
            "narrator": "",
            "text": "もしかして、ケンカ中とか？",
            "zh": "难道在吵架？",
            "narrator_zh": ""
        },
        {
            "location": "127/TALK",
            "narrator": "つばめ",
            "text": "自分で考ぇてみる(´･ω･｀) ",
            "zh": "我自己再想想(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "128/TALK",
            "narrator": "つばめ",
            "text": "それじゃ",
            "zh": "那就",
            "narrator_zh": "燕"
        },
        {
            "location": "140/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "141/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、今はまだ\n電話できないかも…。",
            "zh": "果然，现在还是\n打不了电话……。",
            "narrator_zh": "燕"
        },
        {
            "location": "142/TALK",
            "narrator": "つばめ",
            "text": "何か他の方法を\n考えないと…。",
            "zh": "得想\n别的办法……。",
            "narrator_zh": "燕"
        },
        {
            "location": "146/TALK",
            "narrator": "ガブリエラ",
            "text": "何やってんのよ、新人？",
            "zh": "你在干什么，新人？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "148/TALK",
            "narrator": "つばめ",
            "text": "ひゃわっ！？",
            "zh": "呀哇！？",
            "narrator_zh": "燕"
        },
        {
            "location": "149/TALK",
            "narrator": "つばめ",
            "text": "が、ガブちゃん！！",
            "zh": "加、加布！！",
            "narrator_zh": "燕"
        },
        {
            "location": "150/TALK",
            "narrator": "ガブリエラ",
            "text": "ガブちゃん言うな！\nガブリエラ先輩、でしょ？",
            "zh": "不许叫加布！\n是加布里埃拉前辈，对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "それより、\nこんなところで\n何やってんの？",
            "zh": "比起这个，\n在这种地方\n干什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "つばめ",
            "text": "えっと…帰り道が\nわからなくなっちゃって、\nその…。",
            "zh": "那个……回去的路\n找不到了，\n那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "155/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…迷子とか、\nドン臭いにも\n程があるわ。",
            "zh": "哈啊……迷路，\n笨也\n有个限度。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "156/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、劇場はこっちよ。\n早く来なさい。",
            "zh": "喂，剧场在这边。\n快点过来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "158/TALK",
            "narrator": "つばめ",
            "text": "う、うん…",
            "zh": "唔、嗯……",
            "narrator_zh": "燕"
        },
        {
            "location": "159/TALK",
            "narrator": "つばめ",
            "text": "でも、せんぱいは\nどうしてここにいるん\nですか？",
            "zh": "可是，前辈\n为什么在\n这里？",
            "narrator_zh": "燕"
        },
        {
            "location": "160/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたが変なところで\n曲がったのを見たから、\nつけてきたのよ。",
            "zh": "看到你在奇怪的地方\n拐了弯，\n就跟过来了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "隠れて何かやってるの\nかと思ったら、まさか\n迷子って…。",
            "zh": "还以为你躲着\n在干什么，没想到\n是迷路……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "164/TALK",
            "narrator": "つばめ",
            "text": "お願い！　このことは\nみんなには秘密にして！",
            "zh": "拜托！　这件事\n对大家保密！",
            "narrator_zh": "燕"
        },
        {
            "location": "166/TALK",
            "narrator": "ガブリエラ",
            "text": "は？　\n言うわけないじゃん。",
            "zh": "哈？　\n我才不会说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "ガブリエラ",
            "text": "他人の失敗を言い触らす\n趣味、持ってないし。",
            "zh": "我没有到处说别人失败的\n爱好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "170/TALK",
            "narrator": "つばめ",
            "text": "ありがと、ガブちゃん。",
            "zh": "谢谢，加布。",
            "narrator_zh": "燕"
        },
        {
            "location": "172/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うるさい！\nそれと先輩って\n呼びなさい！",
            "zh": "吵、吵死了！\n还有，要叫\n前辈！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/ACT",
            "narrator": "",
            "text": "ごめん、冗談だった",
            "zh": "对不起，是开玩笑的",
            "narrator_zh": ""
        },
        {
            "location": "174/TALK",
            "narrator": "つばめ",
            "text": "冗談言ってる状況じゃないよー…",
            "zh": "现在不是开玩笑的时候哦……",
            "narrator_zh": "燕"
        },
        {
            "location": "175/TALK",
            "narrator": "つばめ",
            "text": "もういい、自分で考えるね",
            "zh": "算了，我自己想",
            "narrator_zh": "燕"
        },
        {
            "location": "187/TALK",
            "narrator": "つばめ",
            "text": "どうしよう、このままじゃ\nバイトの時間に間に合わ\nない…。",
            "zh": "怎么办，这样下去\n打工时间要\n赶不上……。",
            "narrator_zh": "燕"
        },
        {
            "location": "188/TALK",
            "narrator": "つばめ",
            "text": "道に迷って帰れません、\nって劇場に電話した方が\nいいかな？",
            "zh": "迷路回不去了，\n要不要给剧场\n打电话？",
            "narrator_zh": "燕"
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "何やってんのよ、新人？",
            "zh": "你在干什么，新人？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "194/TALK",
            "narrator": "つばめ",
            "text": "ひゃわっ！？",
            "zh": "呀哇！？",
            "narrator_zh": "燕"
        },
        {
            "location": "195/TALK",
            "narrator": "つばめ",
            "text": "が、ガブちゃん！！",
            "zh": "加、加布！！",
            "narrator_zh": "燕"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "ガブちゃん言うな！\nガブリエラ先輩、でしょ？",
            "zh": "不许叫加布！\n是加布里埃拉前辈，对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "それより、\nこんなところで\n何やってんの？",
            "zh": "比起这个，\n在这种地方\n干什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "200/TALK",
            "narrator": "つばめ",
            "text": "えっと…帰り道が\nわからなくなっちゃって、\nその…。",
            "zh": "那个……回去的路\n找不到了，\n那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "201/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…下校中に迷子とか、\nドン臭いにも程があるわ。",
            "zh": "哈啊……放学路上还迷路，\n笨也有个限度。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "202/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、劇場はこっちよ。\n早く来なさい。",
            "zh": "喂，剧场在这边。\n快点过来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "204/TALK",
            "narrator": "つばめ",
            "text": "う、うん…",
            "zh": "唔、嗯……",
            "narrator_zh": "燕"
        },
        {
            "location": "205/TALK",
            "narrator": "つばめ",
            "text": "でも、せんぱいは\nどうしてここにいるん\nですか？",
            "zh": "可是，前辈\n为什么在\n这里？",
            "narrator_zh": "燕"
        },
        {
            "location": "206/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたが変なところで\n曲がったのを見たから、\nつけてきたのよ。",
            "zh": "看到你在奇怪的地方\n拐了弯，\n就跟过来了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "208/TALK",
            "narrator": "ガブリエラ",
            "text": "隠れて何かやってるの\nかと思ったら、まさか\n迷子って…。",
            "zh": "还以为你躲着\n在干什么，没想到\n是迷路……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "つばめ",
            "text": "お願い！　このことは\nみんなには秘密にして！",
            "zh": "拜托！　这件事\n对大家保密！",
            "narrator_zh": "燕"
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "は？　\n言うわけないじゃん。",
            "zh": "哈？　\n我才不会说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "212/TALK",
            "narrator": "ガブリエラ",
            "text": "他人の失敗を言い触らす\n趣味、持ってないし。",
            "zh": "我没有到处说别人失败的\n爱好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "216/TALK",
            "narrator": "つばめ",
            "text": "ありがと、ガブちゃん。",
            "zh": "谢谢，加布。",
            "narrator_zh": "燕"
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うるさい！\nそれと先輩って\n呼びなさい！",
            "zh": "吵、吵死了！\n还有，要叫\n前辈！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "17/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月7日　2:14 PM</color>\nとある昼下がり、\n神楽坂奥の細道にて。",
            "zh": "<color=green>5月7日　2:14 PM</color>\n某个午后，\n神乐坂深处的小路上。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
