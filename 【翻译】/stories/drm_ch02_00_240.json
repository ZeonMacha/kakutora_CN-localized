{
    "dir": "dramatics/daydra/drm_ch02_00_240.js",
    "type": "Episode",
    "info": {
        "story_id": "2024",
        "cid": "ayami",
        "title": "らぶとーく 第24話",
        "sub_title": "いいこ、いいこ",
        "title_zh": "恋爱漫谈 第24话",
        "sub_title_zh": "乖乖，乖乖"
    },
    "entry": [
        {
            "location": "317/SCENARIO",
            "narrator": "",
            "text": "いいこ、いいこ",
            "zh": "好孩子，好孩子",
            "narrator_zh": ""
        },
        {
            "location": "328/TALK",
            "narrator": "つばめ",
            "text": "これで明日の準備は\n終わったかな？",
            "zh": "明天的准备\n这样就算完了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "333/TALK",
            "narrator": "つばめ",
            "text": "はい。\nどうぞ！",
            "zh": "是的。\n请！",
            "narrator_zh": "燕"
        },
        {
            "location": "340/TALK",
            "narrator": "アーヤ",
            "text": "遅くにごめんね。\nもう寝るところ？",
            "zh": "这么晚抱歉。\n要睡了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "341/TALK",
            "narrator": "つばめ",
            "text": "あ、いえ。\n大丈夫です。",
            "zh": "啊，没有。\n没关系。",
            "narrator_zh": "燕"
        },
        {
            "location": "342/TALK",
            "narrator": "アーヤ",
            "text": "そう。\nよかったわ。",
            "zh": "对。\n太好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "343/TALK",
            "narrator": "つばめ",
            "text": "何もないですが\nゆっくりしていって\nくださいね！",
            "zh": "什么都没有，\n请慢慢坐一会儿\n呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "345/TALK",
            "narrator": "アーヤ",
            "text": "……。\nありがとう。",
            "zh": "……。\n谢谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "346/TALK",
            "narrator": "アーヤ",
            "text": "ええとね。ちょっと\n聞きたいことが\nあって。",
            "zh": "那个。有点\n想问的\n事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "347/TALK",
            "narrator": "アーヤ",
            "text": "つばめはＢｏｔが\n人間だってわかって\n喜んでたでしょ。",
            "zh": "燕知道Bot\n是人类，\n很高兴吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "348/TALK",
            "narrator": "つばめ",
            "text": "……？",
            "zh": "……？",
            "narrator_zh": "燕"
        },
        {
            "location": "349/TALK",
            "narrator": "アーヤ",
            "text": "今もうれしい？\n普通にチャットとか\nできてる？",
            "zh": "现在也高兴吗？\n能平常地聊天\n了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "350/TALK",
            "narrator": "つばめ",
            "text": "んー……。",
            "zh": "嗯——……。",
            "narrator_zh": "燕"
        },
        {
            "location": "351/TALK",
            "narrator": "つばめ",
            "text": "普通というより\nもっと仲良くなった\n感じですよ。",
            "zh": "与其说平常，\n更像是变得更亲近\n了呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "353/TALK",
            "narrator": "つばめ",
            "text": "やっぱり人間の方が\nお話ししてても\n楽しいですし。",
            "zh": "果然还是人\n聊起来\n更开心。",
            "narrator_zh": "燕"
        },
        {
            "location": "354/TALK",
            "narrator": "アーヤ",
            "text": "……そうなのね……。",
            "zh": "……是这样啊……",
            "narrator_zh": "绫水"
        },
        {
            "location": "355/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんは\nそうじゃないん\nですか？",
            "zh": "绫水\n不是这样\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "357/TALK",
            "narrator": "アーヤ",
            "text": "……そうね。",
            "zh": "……是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "359/TALK",
            "narrator": "アーヤ",
            "text": "私はそこまで\nポジティブには\nなれないわ。",
            "zh": "我没法\n积极到\n那个地步。",
            "narrator_zh": "绫水"
        },
        {
            "location": "360/TALK",
            "narrator": "つばめ",
            "text": "ポジティブって\nことはないと\n思うんですけど…。",
            "zh": "我觉得\n算不上积极\n……",
            "narrator_zh": "燕"
        },
        {
            "location": "361/TALK",
            "narrator": "アーヤ",
            "text": "自覚がないのが\nつばめらしいわね。",
            "zh": "没有自觉，\n还真像燕。",
            "narrator_zh": "绫水"
        },
        {
            "location": "362/TALK",
            "narrator": "つばめ",
            "text": "わたしはみんなの\n反応の方が不思議\nなんですけど…。",
            "zh": "我倒是觉得\n大家的反应\n更奇妙……",
            "narrator_zh": "燕"
        },
        {
            "location": "363/TALK",
            "narrator": "つばめ",
            "text": "決まった話より\nいろんな話が\nしたいですし。",
            "zh": "比起定好的话，\n我更想聊\n各种各样的。",
            "narrator_zh": "燕"
        },
        {
            "location": "364/TALK",
            "narrator": "つばめ",
            "text": "それに悪い人だった\nわけでもないですし。",
            "zh": "而且他也不是\n坏人。",
            "narrator_zh": "燕"
        },
        {
            "location": "365/TALK",
            "narrator": "アーヤ",
            "text": "悪い人じゃ\nない、か…。",
            "zh": "不是坏人，\n吗……",
            "narrator_zh": "绫水"
        },
        {
            "location": "366/TALK",
            "narrator": "つばめ",
            "text": "わたし、また\n変なこと\n言いました…？",
            "zh": "我又\n说了奇怪的话\n吗……？",
            "narrator_zh": "燕"
        },
        {
            "location": "368/TALK",
            "narrator": "アーヤ",
            "text": "ううん。\nそうじゃないの。",
            "zh": "不。\n不是那样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "369/TALK",
            "narrator": "アーヤ",
            "text": "つばめは本当に\n素直ねって\n思っただけよ。",
            "zh": "我只是觉得燕\n真的\n很坦率而已。",
            "narrator_zh": "绫水"
        },
        {
            "location": "370/TALK",
            "narrator": "つばめ",
            "text": "そうなん\nですか？",
            "zh": "是这样\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "371/SEL",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "372/ACT",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "376/TALK",
            "narrator": "アーヤ",
            "text": "ん？",
            "zh": "嗯？",
            "narrator_zh": "绫水"
        },
        {
            "location": "390/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと今は",
            "zh": "现在稍微",
            "narrator_zh": "绫水"
        },
        {
            "location": "391/TALK",
            "narrator": "アーヤ",
            "text": "取り込み中",
            "zh": "正在忙",
            "narrator_zh": "绫水"
        },
        {
            "location": "392/TALK",
            "narrator": "アーヤ",
            "text": "また後でね",
            "zh": "待会儿见哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "404/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう。\n参考になったわ。",
            "zh": "谢谢。\n很有参考。",
            "narrator_zh": "绫水"
        },
        {
            "location": "405/TALK",
            "narrator": "つばめ",
            "text": "はい！",
            "zh": "是的！",
            "narrator_zh": "燕"
        }
    ]
}
