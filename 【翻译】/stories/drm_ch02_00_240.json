{
 "dir": "dramatics/daydra/drm_ch02_00_240.js",
 "type": "Episode",
 "info": {
  "story_id": "2024",
  "cid": "ayami",
  "title": "らぶとーく 第24話",
  "sub_title": "いいこ、いいこ"
 },
 "entry": [
  {
   "location": "317/SCENARIO",
   "narrator": "",
   "text": "いいこ、いいこ",
   "zh": "好孩子，好孩子",
   "narrator_zh": ""
  },
  {
   "location": "328/TALK",
   "narrator": "つばめ",
   "text": "これで明日の準備は\n終わったかな？",
   "zh": "明天的准备\n这样就算完了吗？",
   "narrator_zh": "燕"
  },
  {
   "location": "333/TALK",
   "narrator": "つばめ",
   "text": "はい。\nどうぞ！"
  },
  {
   "location": "340/TALK",
   "narrator": "アーヤ",
   "text": "遅くにごめんね。\nもう寝るところ？"
  },
  {
   "location": "341/TALK",
   "narrator": "つばめ",
   "text": "あ、いえ。\n大丈夫です。"
  },
  {
   "location": "342/TALK",
   "narrator": "アーヤ",
   "text": "そう。\nよかったわ。",
   "zh": "对。\n太好了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "343/TALK",
   "narrator": "つばめ",
   "text": "何もないですが\nゆっくりしていって\nくださいね！"
  },
  {
   "location": "345/TALK",
   "narrator": "アーヤ",
   "text": "……。\nありがとう。"
  },
  {
   "location": "346/TALK",
   "narrator": "アーヤ",
   "text": "ええとね。ちょっと\n聞きたいことが\nあって。"
  },
  {
   "location": "347/TALK",
   "narrator": "アーヤ",
   "text": "つばめはＢｏｔが\n人間だってわかって\n喜んでたでしょ。",
   "zh": "燕知道Bot\n是人类，\n很高兴吧。",
   "narrator_zh": "绫水"
  },
  {
   "location": "348/TALK",
   "narrator": "つばめ",
   "text": "……？"
  },
  {
   "location": "349/TALK",
   "narrator": "アーヤ",
   "text": "今もうれしい？\n普通にチャットとか\nできてる？"
  },
  {
   "location": "350/TALK",
   "narrator": "つばめ",
   "text": "んー……。",
   "zh": "嗯——……。",
   "narrator_zh": "燕"
  },
  {
   "location": "351/TALK",
   "narrator": "つばめ",
   "text": "普通というより\nもっと仲良くなった\n感じですよ。"
  },
  {
   "location": "353/TALK",
   "narrator": "つばめ",
   "text": "やっぱり人間の方が\nお話ししてても\n楽しいですし。"
  },
  {
   "location": "354/TALK",
   "narrator": "アーヤ",
   "text": "……そうなのね……。"
  },
  {
   "location": "355/TALK",
   "narrator": "つばめ",
   "text": "アーヤさんは\nそうじゃないん\nですか？"
  },
  {
   "location": "357/TALK",
   "narrator": "アーヤ",
   "text": "……そうね。",
   "zh": "……是啊。",
   "narrator_zh": "绫水"
  },
  {
   "location": "359/TALK",
   "narrator": "アーヤ",
   "text": "私はそこまで\nポジティブには\nなれないわ。"
  },
  {
   "location": "360/TALK",
   "narrator": "つばめ",
   "text": "ポジティブって\nことはないと\n思うんですけど…。"
  },
  {
   "location": "361/TALK",
   "narrator": "アーヤ",
   "text": "自覚がないのが\nつばめらしいわね。"
  },
  {
   "location": "362/TALK",
   "narrator": "つばめ",
   "text": "わたしはみんなの\n反応の方が不思議\nなんですけど…。"
  },
  {
   "location": "363/TALK",
   "narrator": "つばめ",
   "text": "決まった話より\nいろんな話が\nしたいですし。"
  },
  {
   "location": "364/TALK",
   "narrator": "つばめ",
   "text": "それに悪い人だった\nわけでもないですし。",
   "zh": "而且他也不是\n坏人。",
   "narrator_zh": "燕"
  },
  {
   "location": "365/TALK",
   "narrator": "アーヤ",
   "text": "悪い人じゃ\nない、か…。"
  },
  {
   "location": "366/TALK",
   "narrator": "つばめ",
   "text": "わたし、また\n変なこと\n言いました…？"
  },
  {
   "location": "368/TALK",
   "narrator": "アーヤ",
   "text": "ううん。\nそうじゃないの。"
  },
  {
   "location": "369/TALK",
   "narrator": "アーヤ",
   "text": "つばめは本当に\n素直ねって\n思っただけよ。",
   "zh": "我只是觉得燕\n真的\n很坦率而已。",
   "narrator_zh": "绫水"
  },
  {
   "location": "370/TALK",
   "narrator": "つばめ",
   "text": "そうなん\nですか？",
   "zh": "是这样\n吗？",
   "narrator_zh": "燕"
  },
  {
   "location": "371/SEL",
   "narrator": "",
   "text": "おーい",
   "zh": "喂——",
   "narrator_zh": ""
  },
  {
   "location": "372/ACT",
   "narrator": "",
   "text": "おーい",
   "zh": "喂——",
   "narrator_zh": ""
  },
  {
   "location": "376/TALK",
   "narrator": "アーヤ",
   "text": "ん？",
   "zh": "嗯？",
   "narrator_zh": "绫水"
  },
  {
   "location": "390/TALK",
   "narrator": "アーヤ",
   "text": "ちょっと今は",
   "zh": "现在稍微",
   "narrator_zh": "绫水"
  },
  {
   "location": "391/TALK",
   "narrator": "アーヤ",
   "text": "取り込み中"
  },
  {
   "location": "392/TALK",
   "narrator": "アーヤ",
   "text": "また後でね",
   "zh": "待会儿见哦",
   "narrator_zh": "绫水"
  },
  {
   "location": "404/TALK",
   "narrator": "アーヤ",
   "text": "ありがとう。\n参考になったわ。"
  },
  {
   "location": "405/TALK",
   "narrator": "つばめ",
   "text": "はい！",
   "zh": "是的！",
   "narrator_zh": "燕"
  }
 ]
}
