    },
    "entry": [
        {
            "location": "497/SCENARIO",
            "narrator": "",
            "text": "わかること、わかったこと",
            "zh": "明白的事，弄懂的事",
            "narrator_zh": ""
        },
        {
            "location": "517/TALK",
            "narrator": "みやび",
            "text": "…なごちゃん…。",
            "zh": "……七五……。",
            "narrator_zh": "雅"
        },
        {
            "location": "518/TALK",
            "narrator": "みやび",
            "text": "なごちゃんはやっぱり\nフェノメノンで死んだや\nなかったぞね……。",
            "zh": "七五果然\n不是死于PhenoMENON\n的咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "519/SEL",
            "narrator": "",
            "text": "フェノメノン知ってるの？",
            "zh": "你知道PhenoMENON？",
            "narrator_zh": ""
        },
        {
            "location": "520/SEL",
            "narrator": "",
            "text": "あれ？　さっきまでは…",
            "zh": "咦？　刚才还是…",
            "narrator_zh": ""
        },
        {
            "location": "521/SEL",
            "narrator": "",
            "text": "みやびはどういうみやびなの？",
            "zh": "雅是怎样的雅？",
            "narrator_zh": ""
        },
        {
            "location": "522/ACT",
            "narrator": "",
            "text": "フェノメノン知ってるの？",
            "zh": "你知道PhenoMENON？",
            "narrator_zh": ""
        },
        {
            "location": "523/TALK",
            "narrator": "みやび",
            "text": "当然ちや。",
            "zh": "那是当然滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "524/ACT",
            "narrator": "",
            "text": "あれ？　さっきまでは…",
            "zh": "咦？　刚才还是…",
            "narrator_zh": ""
        },
        {
            "location": "525/TALK",
            "narrator": "みやび",
            "text": "どういた？",
            "zh": "怎么了？",
            "narrator_zh": "雅"
        },
        {
            "location": "526/ACT",
            "narrator": "",
            "text": "みやびはどういうみやびなの？",
            "zh": "雅是怎样的雅？",
            "narrator_zh": ""
        },
        {
            "location": "527/TALK",
            "narrator": "みやび",
            "text": "どういうって\nいつも通りの\nみやびさんぞね。",
            "zh": "什么怎样，\n是和平时一样的\n雅咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "529/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "530/TALK",
            "narrator": "みやび",
            "text": "フェノメノンを知らん\nうちと知っとるうちは\nどこで別れた？",
            "zh": "不认识PhenoMENON的\n我和认识的\n我是在哪里分开的？",
            "narrator_zh": "雅"
        },
        {
            "location": "531/SEL",
            "narrator": "",
            "text": "そこ最重要ポイント",
            "zh": "那里是最关键的点",
            "narrator_zh": ""
        },
        {
            "location": "532/SEL",
            "narrator": "",
            "text": "違う世界線のみやびってこと？",
            "zh": "是不同世界线的雅？",
            "narrator_zh": ""
        },
        {
            "location": "533/SEL",
            "narrator": "",
            "text": "実はみやびは双子？？？",
            "zh": "其实雅是双胞胎？？？",
            "narrator_zh": ""
        },
        {
            "location": "534/ACT",
            "narrator": "",
            "text": "そこ最重要ポイント",
            "zh": "那里是最关键的点",
            "narrator_zh": ""
        },
        {
            "location": "535/TALK",
            "narrator": "みやび",
            "text": "…けんどわからん。",
            "zh": "……但是我也不懂啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "536/ACT",
            "narrator": "",
            "text": "違う世界線のみやびってこと？",
            "zh": "是不同世界线的雅？",
            "narrator_zh": ""
        },
        {
            "location": "537/TALK",
            "narrator": "みやび",
            "text": "そういうことに\nなるんかね。",
            "zh": "那就算\n是那么回事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "538/ACT",
            "narrator": "",
            "text": "実はみやびは双子？？？",
            "zh": "其实雅是双胞胎？？？",
            "narrator_zh": ""
        },
        {
            "location": "539/TALK",
            "narrator": "みやび",
            "text": "それは絶対にない。\n……はず。",
            "zh": "那是绝对没有的。\n……应该。",
            "narrator_zh": "雅"
        },
        {
            "location": "541/TALK",
            "narrator": "みやび",
            "text": "それと。なごちゃんは\nたぶん死んどらん。",
            "zh": "还有。七五\n多半没死。",
            "narrator_zh": "雅"
        },
        {
            "location": "542/TALK",
            "narrator": "みやび",
            "text": "どこにおるんか……。\n知らんか？",
            "zh": "她人在哪里……。\n你不知道咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "543/SEL",
            "narrator": "",
            "text": "ごめん",
            "zh": "对不起",
            "narrator_zh": ""
        },
        {
            "location": "544/SEL",
            "narrator": "",
            "text": "知らないんだ",
            "zh": "我不知道啊",
            "narrator_zh": ""
        },
        {
            "location": "545/SEL",
            "narrator": "",
            "text": "誰に聞けばいいかな",
            "zh": "该去问谁好呢",
            "narrator_zh": ""
        },
        {
            "location": "546/ACT",
            "narrator": "",
            "text": "ごめん",
            "zh": "对不起",
            "narrator_zh": ""
        },
        {
            "location": "547/TALK",
            "narrator": "みやび",
            "text": "謝る必要はないけんど。",
            "zh": "没必要道歉咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "548/ACT",
            "narrator": "",
            "text": "知らないんだ",
            "zh": "我不知道啊",
            "narrator_zh": ""
        },
        {
            "location": "549/TALK",
            "narrator": "みやび",
            "text": "それは残念。",
            "zh": "那真是遗憾。",
            "narrator_zh": "雅"
        },
        {
            "location": "550/ACT",
            "narrator": "",
            "text": "誰に聞けばいいかな",
            "zh": "该去问谁好呢",
            "narrator_zh": ""
        },
        {
            "location": "551/TALK",
            "narrator": "みやび",
            "text": "うちが聞きたい。",
            "zh": "我也想知道。",
            "narrator_zh": "雅"
        },
        {
            "location": "553/TALK",
            "narrator": "みやび",
            "text": "使えんな。\nしかしそれでこそ\n$handle$。",
            "zh": "真没用呐。\n不过这才像\n$handle$。",
            "narrator_zh": "雅"
        },
        {
            "location": "555/TALK",
            "narrator": "みやび",
            "text": "うちはそんな相棒が\n意外と気にいっちゅう。",
            "zh": "这样的搭档，我\n意外地还挺中意咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "556/SEL",
            "narrator": "",
            "text": "それってラブ？",
            "zh": "这就是爱？",
            "narrator_zh": ""
        },
        {
            "location": "557/SEL",
            "narrator": "",
            "text": "みやびの方がかわいいよ",
            "zh": "雅你更可爱哦",
            "narrator_zh": ""
        },
        {
            "location": "558/SEL",
            "narrator": "",
            "text": "デレいただきましたー！",
            "zh": "傲娇破功啦——！",
            "narrator_zh": ""
        },
        {
            "location": "559/ACT",
            "narrator": "",
            "text": "それってラブ？",
            "zh": "这就是爱？",
            "narrator_zh": ""
        },
        {
            "location": "560/TALK",
            "narrator": "みやび",
            "text": "…そう思ってくれても\nえいよ。",
            "zh": "……你要这么想\n也行咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "561/ACT",
            "narrator": "",
            "text": "みやびの方がかわいいよ",
            "zh": "雅你更可爱哦",
            "narrator_zh": ""
        },
        {
            "location": "562/TALK",
            "narrator": "みやび",
            "text": "見た目の話とは\nちっくと違うき。",
            "zh": "这跟外表那一说\n差得远着啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "563/ACT",
            "narrator": "",
            "text": "デレいただきましたー！",
            "zh": "傲娇破功啦——！",
            "narrator_zh": ""
        },
        {
            "location": "564/TALK",
            "narrator": "みやび",
            "text": "そういう\n言い方をするなら\n返してもらうき。",
            "zh": "要是这么说话，\n我可要收回\n刚才的话啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "566/SEL",
            "narrator": "",
            "text": "なごちゃんのことで",
            "zh": "是关于七五的事",
            "narrator_zh": ""
        },
        {
            "location": "567/SEL",
            "narrator": "",
            "text": "これってヒントになるかな",
            "zh": "这算不算个线索呢",
            "narrator_zh": ""
        },
        {
            "location": "568/SEL",
            "narrator": "",
            "text": "多分なんだけど",
            "zh": "可能不一定对",
            "narrator_zh": ""
        },
        {
            "location": "569/ACT",
            "narrator": "",
            "text": "なごちゃんのことで",
            "zh": "是关于七五的事",
            "narrator_zh": ""
        },
        {
            "location": "570/TALK",
            "narrator": "みやび",
            "text": "何ぞあるんかね。",
            "zh": "有什么事吗咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "571/ACT",
            "narrator": "",
            "text": "これってヒントになるかな",
            "zh": "这算不算个线索呢",
            "narrator_zh": ""
        },
        {
            "location": "572/TALK",
            "narrator": "みやび",
            "text": "まず聞いてみるちや。",
            "zh": "那就先听听滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "573/ACT",
            "narrator": "",
            "text": "多分なんだけど",
            "zh": "可能不一定对",
            "narrator_zh": ""
        },
        {
            "location": "574/TALK",
            "narrator": "みやび",
            "text": "期待して聞こう。",
            "zh": "那我满怀期待地听。",
            "narrator_zh": "雅"
        },
        {
            "location": "576/SEL",
            "narrator": "",
            "text": "つばめとなごちゃんの症状が似てる",
            "zh": "燕和七五的症状很像",
            "narrator_zh": ""
        },
        {
            "location": "577/SEL",
            "narrator": "",
            "text": "なごちゃんはつばめより先に発症したんじゃないかな",
            "zh": "七五会不会比燕先发症了",
            "narrator_zh": ""
        },
        {
            "location": "578/ACT",
            "narrator": "",
            "text": "つばめとなごちゃんの症状が似てる",
            "zh": "燕和七五的症状很像",
            "narrator_zh": ""
        },
        {
            "location": "579/TALK",
            "narrator": "みやび",
            "text": "…なるほど。",
            "zh": "……原来如此。",
            "narrator_zh": "雅"
        },
        {
            "location": "580/ACT",
            "narrator": "",
            "text": "なごちゃんはつばめより先に発症したんじゃないかな",
            "zh": "七五会不会比燕先发症了",
            "narrator_zh": ""
        },
        {
            "location": "581/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "583/TALK",
            "narrator": "みやび",
            "text": "ちうことは……。",
            "zh": "也就是说……。",
            "narrator_zh": "雅"
        },
        {
            "location": "586/TALK",
            "narrator": "みやび",
            "text": "ふむ……。\n確かに。",
            "zh": "唔……。\n确实。",
            "narrator_zh": "雅"
        },
        {
            "location": "587/TALK",
            "narrator": "みやび",
            "text": "逢瀬つばめと\nなごちゃんは同じ\n病気やったかもしれん。",
            "zh": "逢濑燕和七五\n得的多半是\n同一种病。",
            "narrator_zh": "雅"
        },
        {
            "location": "590/TALK",
            "narrator": "みやび",
            "text": "ちうことはなごちゃんは\nどこかでフェノメノンを\n展開ちょるとか…？",
            "zh": "也就是说七五\n是不是在驷马地方\n展开着PhenoMENON啵…？",
            "narrator_zh": "雅"
        },
        {
            "location": "591/TALK",
            "narrator": "みやび",
            "text": "あるいはエンタングルに\n囚われちゅう…？",
            "zh": "还是被纠缠\n困住了咯…？",
            "narrator_zh": "雅"
        },
        {
            "location": "592/TALK",
            "narrator": "みやび",
            "text": "……けんど……。",
            "zh": "……但是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "593/TALK",
            "narrator": "みやび",
            "text": "うちがフェノム計画に\n加わった時は逢瀬つばめの\n名前しか見とらん。",
            "zh": "我加入Phenom计划的时候，\n只看到逢濑燕的\n名字咯[?]",
            "narrator_zh": "雅"
        },
        {
            "location": "594/TALK",
            "narrator": "みやび",
            "text": "これはどういうこと\n何やろうかね…？",
            "zh": "这是怎么回事，\n为什么呢…？",
            "narrator_zh": "雅"
        },
        {
            "location": "595/SEL",
            "narrator": "",
            "text": "なごちゃんで既に実験済みで失敗してたとか？",
            "zh": "是不是已经用七五做过实验而且失败了？",
            "narrator_zh": ""
        },
        {
            "location": "596/SEL",
            "narrator": "",
            "text": "被検体毎に計画が進行してたんじゃない？",
            "zh": "计划会不会是按每个被试对象分别推进的？",
            "narrator_zh": ""
        },
        {
            "location": "597/SEL",
            "narrator": "",
            "text": "別の役目があったんじゃない？",
            "zh": "她会不会另有别的职责？",
            "narrator_zh": ""
        },
        {
            "location": "598/SEL",
            "narrator": "",
            "text": "エンタングルはなごちゃんに無関係",
            "zh": "纠缠和七五没有关系",
            "narrator_zh": ""
        },
        {
            "location": "599/ACT",
            "narrator": "",
            "text": "なごちゃんで既に実験済みで失敗してたとか？",
            "zh": "是不是已经用七五做过实验而且失败了？",
            "narrator_zh": ""
        },
        {
            "location": "600/TALK",
            "narrator": "みやび",
            "text": "…やったら失敗例として\n内容が共有されとらんと\nおかしいき。",
            "zh": "……那样的话，\n作为失败案例，内容\n没被共享就说不过去啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "601/TALK",
            "narrator": "みやび",
            "text": "成功例より失敗例の\n分析の方が大事やきね。",
            "zh": "比起成功案例，\n失败案例的分析才更要紧啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "602/TALK",
            "narrator": "みやび",
            "text": "仮に名前は非公開\nやったとしてもそんな\n話は聞いとらん。",
            "zh": "就算名字不公开，\n这种事我也\n没听说过咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "603/ACT",
            "narrator": "",
            "text": "被検体毎に計画が進行してたんじゃない？",
            "zh": "计划会不会是按每个被试对象分别推进的？",
            "narrator_zh": ""
        },
        {
            "location": "604/TALK",
            "narrator": "みやび",
            "text": "その可能性は十分に\nありえる。",
            "zh": "这种可能性\n完全存在。",
            "narrator_zh": "雅"
        },
        {
            "location": "605/TALK",
            "narrator": "みやび",
            "text": "けんど。その切れっ端も\nうちに掴めんことが\nありゆうかね？",
            "zh": "但是。那点碎片\n搞不好也是\n我抓不到的咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "606/ACT",
            "narrator": "",
            "text": "別の役目があったんじゃない？",
            "zh": "她会不会另有别的职责？",
            "narrator_zh": ""
        },
        {
            "location": "607/TALK",
            "narrator": "みやび",
            "text": "別？",
            "zh": "别的？",
            "narrator_zh": "雅"
        },
        {
            "location": "608/TALK",
            "narrator": "みやび",
            "text": "仮に別の役目が\nあったとして。\nそれは何ぞね？",
            "zh": "就算真有\n别的职责。\n那是驷马咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "609/TALK",
            "narrator": "みやび",
            "text": "…言うたちそもそも\n二人の力も把握できて\nおらんきね。",
            "zh": "……话说回来，\n两人的力量我\n都没掌握清楚啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "610/TALK",
            "narrator": "みやび",
            "text": "まずはそこからやね。",
            "zh": "先从这里开始咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "611/ACT",
            "narrator": "",
            "text": "エンタングルはなごちゃんに無関係",
            "zh": "纠缠和七五没有关系",
            "narrator_zh": ""
        },
        {
            "location": "612/TALK",
            "narrator": "みやび",
            "text": "なるほど解決。",
            "zh": "原来如此，解决咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "613/TALK",
            "narrator": "みやび",
            "text": "いやそんなわけが\nないろう。",
            "zh": "不，哪有\n这种道理咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "614/TALK",
            "narrator": "みやび",
            "text": "相手は病院にも手が\n回せるほどの大がかりな\n組織。",
            "zh": "对方可是能把手\n伸进医院的大规模\n组织。",
            "narrator_zh": "雅"
        },
        {
            "location": "615/TALK",
            "narrator": "みやび",
            "text": "仮に無関係やったら\nうちには存在すら\n掴めちょらん相手や。",
            "zh": "要是真没关系，\n那就是连存在\n都摸不到的对手咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "617/TALK",
            "narrator": "みやび",
            "text": "そんなことは\nさすがに考えられん。",
            "zh": "那种事，\n实在无法想象。",
            "narrator_zh": "雅"
        },
        {
            "location": "619/TALK",
            "narrator": "みやび",
            "text": "…なあお前さん。",
            "zh": "……呐，你。",
            "narrator_zh": "雅"
        },
        {
            "location": "620/TALK",
            "narrator": "みやび",
            "text": "今は情報が\n足りなさすぎる。",
            "zh": "现在的情报\n实在太少咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "621/TALK",
            "narrator": "みやび",
            "text": "調査の手伝いを\nしてもろうても\nえいかね。",
            "zh": "调查的事，\n能不能请你\n搭把手咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "622/SEL",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "623/SEL",
            "narrator": "",
            "text": "$me$は協力しない",
            "zh": "$me$不会协助",
            "narrator_zh": ""
        },
        {
            "location": "624/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "625/TALK",
            "narrator": "みやび",
            "text": "…ありがとう。\nご協力感謝する。",
            "zh": "……多谢。\n你的协助我很感激。",
            "narrator_zh": "雅"
        },
        {
            "location": "626/TALK",
            "narrator": "みやび",
            "text": "けんど。",
            "zh": "但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "627/TALK",
            "narrator": "みやび",
            "text": "$handle$の\n知っとるうちは\n今のうちと違うろう？",
            "zh": "$handle$认识的\n那个我，\n和现在的我不同吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "628/SEL",
            "narrator": "",
            "text": "それがどうしたの？",
            "zh": "那又怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "629/SEL",
            "narrator": "",
            "text": "みやびはみやびでしょ",
            "zh": "雅就是雅啊",
            "narrator_zh": ""
        },
        {
            "location": "630/SEL",
            "narrator": "",
            "text": "$me$が協力したいだけ",
            "zh": "$me$只是想帮忙而已",
            "narrator_zh": ""
        },
        {
            "location": "631/ACT",
            "narrator": "",
            "text": "それがどうしたの？",
            "zh": "那又怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "633/TALK",
            "narrator": "みやび",
            "text": "$handle$は\n気にならんかね？",
            "zh": "$handle$你\n不介意咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "634/ACT",
            "narrator": "",
            "text": "みやびはみやびでしょ",
            "zh": "雅就是雅啊",
            "narrator_zh": ""
        },
        {
            "location": "635/TALK",
            "narrator": "みやび",
            "text": "それはそうなんや\nけんど…。",
            "zh": "那倒是没错，\n但是…。",
            "narrator_zh": "雅"
        },
        {
            "location": "636/ACT",
            "narrator": "",
            "text": "$me$が協力したいだけ",
            "zh": "$me$只是想帮忙而已",
            "narrator_zh": ""
        },
        {
            "location": "638/TALK",
            "narrator": "みやび",
            "text": "そのことには感謝しとる。",
            "zh": "这份心意我很感激。",
            "narrator_zh": "雅"
        },
        {
            "location": "640/SEL",
            "narrator": "",
            "text": "どんなみやびでもみやびはみやび",
            "zh": "不管是哪种雅，雅都是雅",
            "narrator_zh": ""
        },
        {
            "location": "641/SEL",
            "narrator": "",
            "text": "みやびの役に立ちたいんだ",
            "zh": "我想帮上雅的忙",
            "narrator_zh": ""
        },
        {
            "location": "642/SEL",
            "narrator": "",
            "text": "だって$me$はみやびの相棒でしょ",
            "zh": "因为$me$是雅的搭档啊",
            "narrator_zh": ""
        },
        {
            "location": "643/ACT",
            "narrator": "",
            "text": "どんなみやびでもみやびはみやび",
            "zh": "不管是哪种雅，雅都是雅",
            "narrator_zh": ""
        },
        {
            "location": "644/TALK",
            "narrator": "みやび",
            "text": "どんなうちでも…。",
            "zh": "不管是哪个我…。",
            "narrator_zh": "雅"
        },
        {
            "location": "645/ACT",
            "narrator": "",
            "text": "みやびの役に立ちたいんだ",
            "zh": "我想帮上雅的忙",
            "narrator_zh": ""
        },
        {
            "location": "646/TALK",
            "narrator": "みやび",
            "text": "…そうか…。",
            "zh": "……这样啊…。",
            "narrator_zh": "雅"
        },
        {
            "location": "647/ACT",
            "narrator": "",
            "text": "だって$me$はみやびの相棒でしょ",
            "zh": "因为$me$是雅的搭档啊",
            "narrator_zh": ""
        },
        {
            "location": "648/TALK",
            "narrator": "みやび",
            "text": "そうやね。\n相棒やき。",
            "zh": "是啊。\n是搭档啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "650/TALK",
            "narrator": "みやび",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "雅"
        },
        {
            "location": "651/TALK",
            "narrator": "みやび",
            "text": "よし。",
            "zh": "好。",
            "narrator_zh": "雅"
        },
        {
            "location": "652/TALK",
            "narrator": "みやび",
            "text": "ほいたらチキチキ\n働いてもらうぞね、\n相棒。",
            "zh": "那就麻溜地\n给我干活咧，\n搭档。",
            "narrator_zh": "雅"
        },
        {
            "location": "653/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんと\nなごちゃんのためにも。",
            "zh": "也是为了\n燕和七五。",
            "narrator_zh": "雅"
        },
        {
            "location": "654/SEL",
            "narrator": "",
            "text": "一番はみやびのためだよ",
            "zh": "首先是为了雅哦",
            "narrator_zh": ""
        },
        {
            "location": "655/SEL",
            "narrator": "",
            "text": "つばめちゃんって言った",
            "zh": "你刚才说了“小燕”哦",
            "narrator_zh": ""
        },
        {
            "location": "656/SEL",
            "narrator": "",
            "text": "$me$にどーんと任せて！",
            "zh": "放心大胆地交给$me$吧！",
            "narrator_zh": ""
        },
        {
            "location": "657/ACT",
            "narrator": "",
            "text": "一番はみやびのためだよ",
            "zh": "首先是为了雅哦",
            "narrator_zh": ""
        },
        {
            "location": "658/TALK",
            "narrator": "みやび",
            "text": "よう言うた。",
            "zh": "说得好。",
            "narrator_zh": "雅"
        },
        {
            "location": "659/ACT",
            "narrator": "",
            "text": "つばめちゃんって言った",
            "zh": "你刚才说了“小燕”哦",
            "narrator_zh": ""
        },
        {
            "location": "660/TALK",
            "narrator": "みやび",
            "text": "被検体でのうて\n仲間やきね、\nつばめちゃんは。",
            "zh": "不是被试对象，\n是同伴啵，\n说的是燕啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "661/ACT",
            "narrator": "",
            "text": "$me$にどーんと任せて！",
            "zh": "放心大胆地交给$me$吧！",
            "narrator_zh": ""
        },
        {
            "location": "662/TALK",
            "narrator": "みやび",
            "text": "すぐ調子に乗るのが\n悪い癖やね、相棒の。",
            "zh": "马上就得意忘形，\n是你这搭档的坏毛病咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "664/TALK",
            "narrator": "みやび",
            "text": "なごちゃんの真実に\n一歩近づけたのは\n相棒のおかげやき。",
            "zh": "能朝七五的真相\n迈近一步，\n多亏了搭档啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "665/SEL",
            "narrator": "",
            "text": "そんなことないよ",
            "zh": "才不是这样",
            "narrator_zh": ""
        },
        {
            "location": "666/SEL",
            "narrator": "",
            "text": "その通り！！！！",
            "zh": "说得对！！！！",
            "narrator_zh": ""
        },
        {
            "location": "667/SEL",
            "narrator": "",
            "text": "そうかなあ…",
            "zh": "是这样吗…",
            "narrator_zh": ""
        },
        {
            "location": "668/ACT",
            "narrator": "",
            "text": "そんなことないよ",
            "zh": "才不是这样",
            "narrator_zh": ""
        },
        {
            "location": "669/TALK",
            "narrator": "みやび",
            "text": "謙遜せんでもえいき。",
            "zh": "不用谦虚啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "670/ACT",
            "narrator": "",
            "text": "その通り！！！！",
            "zh": "说得对！！！！",
            "narrator_zh": ""
        },
        {
            "location": "671/TALK",
            "narrator": "みやび",
            "text": "どんだけドヤ顔なんかね。\n…まあえいけんど。",
            "zh": "瞧你那张得意脸咯。\n……嘛，算了。",
            "narrator_zh": "雅"
        },
        {
            "location": "672/ACT",
            "narrator": "",
            "text": "そうかなあ…",
            "zh": "是这样吗…",
            "narrator_zh": ""
        },
        {
            "location": "673/TALK",
            "narrator": "みやび",
            "text": "無自覚なんやねえ。",
            "zh": "真是没自觉咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "675/TALK",
            "narrator": "みやび",
            "text": "相棒が隣におると\n気持ちが違うき。",
            "zh": "搭档在身边，\n干劲都不一样啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "676/TALK",
            "narrator": "みやび",
            "text": "うちも全力で\nやるしかないねえ…！",
            "zh": "我也只能\n全力以赴咯…！",
            "narrator_zh": "雅"
        },
        {
            "location": "677/ACT",
            "narrator": "",
            "text": "$me$は協力しない",
            "zh": "$me$不会协助",
            "narrator_zh": ""
        },
        {
            "location": "678/TALK",
            "narrator": "みやび",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "雅"
        },
        {
            "location": "680/TALK",
            "narrator": "みやび",
            "text": "それも仕方ないろうね。",
            "zh": "那也是没办法的事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "681/TALK",
            "narrator": "みやび",
            "text": "$handle$の知っとる\nうちは今話とるうちでは\nないんやろうし。",
            "zh": "$handle$认识的\n那个我，\n大概不是现在的我咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "682/TALK",
            "narrator": "みやび",
            "text": "逆にうちは知らん\n$handle$なんやと\n確信できたし。",
            "zh": "反倒是能确信，\n你是我所不认识的\n$handle$咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "683/TALK",
            "narrator": "みやび",
            "text": "さようならやね。",
            "zh": "那就再见了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "689/TALK",
            "narrator": "みやび",
            "text": "おっ…！？",
            "zh": "哦…！？",
            "narrator_zh": "雅"
