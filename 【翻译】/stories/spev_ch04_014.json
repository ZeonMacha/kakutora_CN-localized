{
    "dir": "chap00/daydra/spev_ch04_014.js",
    "type": "",
    "info": {
        "story_id": "4014",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "とうちゃんどんちゃん騒ぎ",
        "title_zh": "特别篇",
        "sub_title_zh": "老爸热闹大骚动"
    },
    "entry": [
        {
            "location": "29/TALK",
            "narrator": "とうちゃん",
            "text": "ガーッハハハハハ！！\nいやー、チキンもビールも\n最高だなぁ！",
            "zh": "嘎哈哈哈哈哈！！\n哎呀，炸鸡和啤酒\n真是太棒啦！",
            "narrator_zh": "老爸"
        },
        {
            "location": "31/TALK",
            "narrator": "透明みやび",
            "text": "ぶはっ、あははははは！！\nと、とうちゃん、\nそれ面白過ぎや！",
            "zh": "噗哈，啊哈哈哈哈哈！！\n老、老爸，\n你这实在太逗咯！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "32/TALK",
            "narrator": "とうちゃん",
            "text": "なんだなんだ？\n俺の食いっぷりが\nそんなにおかしいのか？",
            "zh": "怎么了怎么了？\n我这吃相\n有那么好笑吗？",
            "narrator_zh": "老爸"
        },
        {
            "location": "35/TALK",
            "narrator": "透明みやび",
            "text": "頭や、頭！\nなんやそれ、\nトナカイ角やろ？",
            "zh": "头上啊，头上！\n那驷马玩意，\n驯鹿角咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "36/TALK",
            "narrator": "とうちゃん",
            "text": "よくわかったな。\nどうだ、可愛いだろ？",
            "zh": "眼力不错嘛。\n怎么样，挺可爱吧？",
            "narrator_zh": "老爸"
        },
        {
            "location": "39/TALK",
            "narrator": "透明みやび",
            "text": "や、やめぃ、うちのこと\n笑い殺す気か！？",
            "zh": "停、停下啊，你是想\n把我笑死咩！？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "40/TALK",
            "narrator": "透明みやび",
            "text": "とうちゃんみたいな\n怖い顔したトナカイなんぞ\nいたら堪らんぞね。",
            "zh": "要是真有像老爸这样\n长着张凶脸的驯鹿，\n谁顶得住咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "41/TALK",
            "narrator": "とうちゃん",
            "text": "いいじゃねぇか。\n怖いトナカイってのも\n可愛いもんだろうが。",
            "zh": "这不挺好嘛。\n凶巴巴的驯鹿\n不也照样可爱得很嘛。",
            "narrator_zh": "老爸"
        },
        {
            "location": "43/TALK",
            "narrator": "透明みやび",
            "text": "ふむ…まあ、確かに\n見慣れてくると、\nありな感じするぞね。",
            "zh": "唔……嘛，确实\n看习惯之后，\n感觉还真行咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "44/TALK",
            "narrator": "透明みやび",
            "text": "ゆうても、角しか\nトナカイ要素\nないけんどな。",
            "zh": "不过话说回来，\n浑身上下也就只有角\n是驯鹿要素，但是嘛。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "45/TALK",
            "narrator": "とうちゃん",
            "text": "鼻くらい赤くした方が\nよかったか？",
            "zh": "要不至少把鼻子\n也涂红点更好？",
            "narrator_zh": "老爸"
        },
        {
            "location": "46/TALK",
            "narrator": "透明みやび",
            "text": "お、塗るか？\nマジックあるぞね。",
            "zh": "哦，要涂咩？\n这儿有记号笔咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "47/TALK",
            "narrator": "とうちゃん",
            "text": "ガハハハ、いらねぇよ。\nなんたって俺は――",
            "zh": "嘎哈哈哈，不用啦。\n毕竟我可是——",
            "narrator_zh": "老爸"
        },
        {
            "location": "53/TALK",
            "narrator": "とうちゃん",
            "text": "鼻の代わりに\n目が赤いからな！",
            "zh": "我不是红鼻子，\n是红眼睛嘛！",
            "narrator_zh": "老爸"
        },
        {
            "location": "55/TALK",
            "narrator": "透明みやび",
            "text": "ぶはっ！？\nあははははは！！",
            "zh": "噗哈！？\n啊哈哈哈哈哈！！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "56/TALK",
            "narrator": "透明みやび",
            "text": "そ、それじゃトナカイ\nじゃなくて、ウサギちや！",
            "zh": "那、那不就不是驯鹿，\n变成兔子了滴！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "57/TALK",
            "narrator": "とうちゃん",
            "text": "おーい、誰か！\nうさ耳持ってるヤツ\nいねぇかぁ！？",
            "zh": "喂——，谁来着！\n有没有人手头有\n兔耳朵啊！？",
            "narrator_zh": "老爸"
        },
        {
            "location": "58/TALK",
            "narrator": "透明みやび",
            "text": "ひーっ、とうちゃんに\n笑い殺されるがよー！",
            "zh": "噫——，真要被老爸\n给笑死咯——！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "59/SEL",
            "narrator": "（選択肢）",
            "text": "酔っ払ってるの？",
            "zh": "你喝醉了吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "60/ACT",
            "narrator": "",
            "text": "酔っ払ってるの？",
            "zh": "你喝醉了吗？",
            "narrator_zh": ""
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "失礼な",
            "zh": "真没礼貌",
            "narrator_zh": "雅"
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "うちは不真面目ではあっても",
            "zh": "我就算有些吊儿郎当",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "不良ではない",
            "zh": "也算不上不良",
            "narrator_zh": "雅"
        },
        {
            "location": "72/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "不真面目でもないのだが",
            "zh": "其实也称不上吊儿郎当就是了",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "酔ってると思ったか？",
            "zh": "你以为我喝醉了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "75/SEL",
            "narrator": "（選択肢）",
            "text": "テンション高かったから、つい…",
            "zh": "看你兴致那么高，一不小心就……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "76/SEL",
            "narrator": "（選択肢）",
            "text": "酔ってる人ほど酔ってないという",
            "zh": "越是喝醉的人越会说自己没醉",
            "narrator_zh": "（选项）"
        },
        {
            "location": "77/ACT",
            "narrator": "",
            "text": "テンション高かったから、つい…",
            "zh": "看你兴致那么高，一不小心就……",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "単純過ぎないか？",
            "zh": "未免也太单纯了吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "楽しい楽しいクリスマスパーティー",
            "zh": "快快乐乐的圣诞派对",
            "narrator_zh": "雅"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "テンション低く祝うバカはいない",
            "zh": "哪有笨蛋会垂头丧气地庆祝的",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "そうであろう？",
            "zh": "难道不是吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "82/ACT",
            "narrator": "",
            "text": "酔ってる人ほど酔ってないという",
            "zh": "越是喝醉的人越会说自己没醉",
            "narrator_zh": ""
        },
        {
            "location": "83/TALK",
            "narrator": "みやび",
            "text": "うちは飲んでない",
            "zh": "我没喝",
            "narrator_zh": "雅"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "$handle$こそ",
            "zh": "$handle$才是",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "自分の判断に酔っているのだ",
            "zh": "醉在自己的判断里了吧",
            "narrator_zh": "雅"
        },
        {
            "location": "86/TALK",
            "narrator": "みやび",
            "text": "まあ酒ではないが",
            "zh": "嘛，虽然不是酒",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "この場の雰囲気には",
            "zh": "对这现场的气氛",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "若干酔っておる",
            "zh": "多少还是有点醉了",
            "narrator_zh": "雅"
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "かもしれん",
            "zh": "也说不定",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "しかし",
            "zh": "不过",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "こうしてクラン達と",
            "zh": "像这样和库兰们一起",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "飲んで食べてのどんちゃん騒ぎ",
            "zh": "又吃又喝地热闹闹腾一场",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "楽しくて堪らん",
            "zh": "开心得不得了",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "こういうの",
            "zh": "这种场面",
            "narrator_zh": "雅"
        },
        {
            "location": "97/TALK",
            "narrator": "みやび",
            "text": "嫌いではないぞね",
            "zh": "我倒是不讨厌咧",
            "narrator_zh": "雅"
        },
        {
            "location": "98/SEL",
            "narrator": "（選択肢）",
            "text": "楽しそうだと思う",
            "zh": "觉得挺开心的样子",
            "narrator_zh": "（选项）"
        },
        {
            "location": "99/SEL",
            "narrator": "（選択肢）",
            "text": "みやびもこういうの好きなんだ？",
            "zh": "原来雅也喜欢这种热闹啊？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "100/ACT",
            "narrator": "",
            "text": "楽しそうだと思う",
            "zh": "觉得挺开心的样子",
            "narrator_zh": ""
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "羨ましいか？",
            "zh": "羡慕咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "みやび",
            "text": "できることなら",
            "zh": "可以的话",
            "narrator_zh": "雅"
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "誘ってやりたいが",
            "zh": "倒也想邀你一起来",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "誘っても来れないだろう？",
            "zh": "但就算邀了你也过不来吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "というか",
            "zh": "不如说",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "来れるならもっと早く来いと",
            "zh": "要是能来的话早就叫你早点过来了",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "うちの長時間文句の餌食になるわけなのだが",
            "zh": "不然你准要沦为我长时间念叨的靶子就是了",
            "narrator_zh": "雅"
        },
        {
            "location": "109/ACT",
            "narrator": "",
            "text": "みやびもこういうの好きなんだ？",
            "zh": "原来雅也喜欢这种热闹啊？",
            "narrator_zh": ""
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "仲間内でわいわい",
            "zh": "跟自己人凑一块热热闹闹的",
            "narrator_zh": "雅"
        },
        {
            "location": "111/TALK",
            "narrator": "みやび",
            "text": "嫌いじゃない",
            "zh": "不讨厌",
            "narrator_zh": "雅"
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "というか好ましい",
            "zh": "不如说还挺喜欢",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "人混みは嫌いだがな",
            "zh": "虽然讨厌人挤人就是了",
            "narrator_zh": "雅"
        },
        {
            "location": "115/TALK",
            "narrator": "みやび",
            "text": "好みうるさいと思うか？",
            "zh": "觉得我挑剔咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "ほっとけ",
            "zh": "少管我",
            "narrator_zh": "雅"
        },
        {
            "location": "118/TALK",
            "narrator": "みやび",
            "text": "まあとにかく",
            "zh": "嘛总之",
            "narrator_zh": "雅"
        },
        {
            "location": "119/TALK",
            "narrator": "みやび",
            "text": "話しかけてもらえてよかった",
            "zh": "你能来搭话真是太好了",
            "narrator_zh": "雅"
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "楽しすぎてうっかりだったが",
            "zh": "刚才太开心差点给忘了",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "言うことがあったのだ",
            "zh": "其实有句话要对你说",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "みやび",
            "text": "聞く準備は？",
            "zh": "准备好听了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "123/SEL",
            "narrator": "（選択肢）",
            "text": "ＯＫ！！",
            "zh": "OK！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "124/SEL",
            "narrator": "（選択肢）",
            "text": "あ、その前にトイレ",
            "zh": "啊，在此之前我先去趟厕所",
            "narrator_zh": "（选项）"
        },
        {
            "location": "125/ACT",
            "narrator": "",
            "text": "ＯＫ！！",
            "zh": "OK！！",
            "narrator_zh": ""
        },
        {
            "location": "126/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "簡単なことなのだが",
            "zh": "也就是句简单的话",
            "narrator_zh": "雅"
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "メリークリスマス",
            "zh": "圣诞快乐",
            "narrator_zh": "雅"
        },
        {
            "location": "130/TALK",
            "narrator": "みやび",
            "text": "来年は",
            "zh": "明年的话",
            "narrator_zh": "雅"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "一緒だとえいな",
            "zh": "能在一起就得咯",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "なんてな",
            "zh": "开玩笑的",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "以上",
            "zh": "以上",
            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "さらば",
            "zh": "告辞",
            "narrator_zh": "雅"
        },
        {
            "location": "136/ACT",
            "narrator": "",
            "text": "あ、その前にトイレ",
            "zh": "啊，在此之前我先去趟厕所",
            "narrator_zh": ""
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "ガラガラバリーン",
            "zh": "哗啦哐啷——",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "今のは",
            "zh": "刚才那是",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "空気の壊れる音",
            "zh": "气氛碎掉的声音",
            "narrator_zh": "雅"
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "来年言おう",
            "zh": "明年再说吧",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "覚えていたら",
            "zh": "要是我还记得的话",
            "narrator_zh": "雅"
        },
        {
            "location": "146/TALK",
            "narrator": "透明みやび",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "147/TALK",
            "narrator": "とうちゃん",
            "text": "ん？　なんだ？\n顔が赤いじゃねぇか…。",
            "zh": "嗯？　怎么了？\n你脸怎么红扑扑的……。",
            "narrator_zh": "老爸"
        },
        {
            "location": "148/TALK",
            "narrator": "とうちゃん",
            "text": "おい、まさか！\n酒飲んだんじゃねぇ\nだろうな！？",
            "zh": "喂，该不会！\n你偷喝酒了\n吧！？",
            "narrator_zh": "老爸"
        },
        {
            "location": "150/TALK",
            "narrator": "透明みやび",
            "text": "アホか！",
            "zh": "蠢不蠢啊！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "151/TALK",
            "narrator": "透明みやび",
            "text": "ずっととーちゃんの隣で\nジュース飲んじょった\nやろ？",
            "zh": "我一直待在老爸旁边\n喝果汁来着\n吧？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "152/TALK",
            "narrator": "とうちゃん",
            "text": "あぁん？\nそういやぁそうか…。",
            "zh": "啊？\n这么一说好像也是……。",
            "narrator_zh": "老爸"
        },
        {
            "location": "153/TALK",
            "narrator": "透明みやび",
            "text": "まったく…、\nどいつもこいつも\nうちが酔っちゅうとか…。",
            "zh": "真是的……，\n一个两个全都\n以为我喝醉了什么的……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "154/TALK",
            "narrator": "透明みやび",
            "text": "失礼な話ぞね。",
            "zh": "真是有够失礼咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "155/TALK",
            "narrator": "とうちゃん",
            "text": "あはははは、冗談だ冗談。\nそんな怖い顔しなくても\nいいじゃねぇか？",
            "zh": "啊哈哈哈哈，开玩笑的开玩笑。\n用不着摆出那么吓人的\n脸色嘛？",
            "narrator_zh": "老爸"
        },
        {
            "location": "157/TALK",
            "narrator": "透明みやび",
            "text": "なに言うが？\nとーちゃんの顔の方が\nよっぽど怖いぞね。",
            "zh": "说驷马呢？\n老爸你的脸才\n吓人得多咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "158/TALK",
            "narrator": "とうちゃん",
            "text": "顔つきはそうだけどなぁ、\n意外と性格は、臆病で\n小心者なんだぜ？",
            "zh": "长相是这样没错啦，\n可性格意外地又胆小\n又谨小慎微着呢？",
            "narrator_zh": "老爸"
        },
        {
            "location": "159/TALK",
            "narrator": "透明みやび",
            "text": "笑えん冗談乙ぞねー。",
            "zh": "这不好笑的冷笑话省省咧——。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "160/TALK",
            "narrator": "とうちゃん",
            "text": "証拠だってあるぞ。\nなんたって、俺はおまえが\n言ったとおり――",
            "zh": "我还有证据呢。\n毕竟我就像你\n刚才说的那样——",
            "narrator_zh": "老爸"
        },
        {
            "location": "164/TALK",
            "narrator": "とうちゃん",
            "text": "臆病な赤い目の\nウサギちゃんだからな！",
            "zh": "是只胆小怕事的\n红眼睛小兔子嘛！",
            "narrator_zh": "老爸"
        },
        {
            "location": "166/TALK",
            "narrator": "透明みやび",
            "text": "ぶはっ、あははははは！！\nきゅ、急に目を見せるのは\n卑怯ちやぁ！！",
            "zh": "噗哈，啊哈哈哈哈哈！！\n突、突然凑过来瞪眼睛\n太卑鄙了滴呀！！",
            "narrator_zh": "透明雅"
        }
    ]
}
