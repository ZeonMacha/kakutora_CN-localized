        "title": "Twitter Archive 006",
        "sub_title": "卯月画廊：いい色気の日",
        "title_zh": "推特 存档 006",
        "sub_title_zh": "卯月画廊：色气正好的日子"
    },
    "entry": [
        {
            "location": "29/TALK",
            "narrator": "透明みやび",
            "text": "いや～、さすがは\n卯月大先生や。",
            "zh": "哎哟～不愧是\n卯月大先生咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "30/TALK",
            "narrator": "透明みやび",
            "text": "今回もなかなかの力作\n引っ提げてきよったね。",
            "zh": "这次又带来好几幅\n像样的力作咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "31/TALK",
            "narrator": "透明神楽",
            "text": "ふふっ、\nありがとうございます！",
            "zh": "呵呵，\n谢谢夸奖！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "33/TALK",
            "narrator": "透明アーヤ",
            "text": "いや、力作なのは\n認めるけど、\nどうして私とみやびなの？",
            "zh": "力作这点我承认，\n可为什么画的\n是我和雅呀？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "透明神楽",
            "text": "１１月１６日、\nつまりいい色気の日に\n描いたものだからです。",
            "zh": "因为这是在１１月１６日，\n也就是“色气正好之日”\n画的东西。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "35/TALK",
            "narrator": "透明神楽",
            "text": "ヒヒイロカネの日じゃ\nないですよ？",
            "zh": "可不是“绯绯色金”\n之日哦？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "36/TALK",
            "narrator": "透明アーヤ",
            "text": "あー、神器とかに使う\n金属ね。ていうか、卯月\n難しい事知ってるわね。",
            "zh": "啊，就是做神器用的\n那种金属呀。话说，卯月\n懂得还挺多呀。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "透明みやび",
            "text": "あ～、多分卯月はそっちを\n指しては言っちょらん\n気がするが。",
            "zh": "哎～我猜卯月指的\n恐怕不是那个\n意思咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "39/TALK",
            "narrator": "透明神楽",
            "text": "とにかく、私達の中で\n一番色気のあるお二人を\n選んだんです。",
            "zh": "总之，我是选了\n我们之中最有色气的\n两位来画的。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "40/TALK",
            "narrator": "透明アーヤ",
            "text": "それにしたって、\nこのポーズはないでしょ？",
            "zh": "就算这样，\n这个姿势也太夸张了吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "41/TALK",
            "narrator": "透明アーヤ",
            "text": "こんなに胸を強調した\nポーズにすること\nないのに…。",
            "zh": "根本没必要摆这种\n拼命强调胸部的\n姿势呀……。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "透明みやび",
            "text": "アーヤなんかまだえいよ。\nうちなんか完全に\n脱げちょるきね。",
            "zh": "绫水你那还算好咧。\n我这边简直\n要彻底脱光了啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "44/TALK",
            "narrator": "透明みやび",
            "text": "アーヤの巨乳のおかげで\nギリ保っちょるヤバさ。",
            "zh": "多亏了绫水的巨乳\n才勉强撑住的，吓人得很咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "45/TALK",
            "narrator": "透明神楽",
            "text": "ここはお二人の仲のよさを\n表現したんです。",
            "zh": "这里是用来表现\n两位感情要好的。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "47/TALK",
            "narrator": "透明アーヤ",
            "text": "…もうちょっと違う\n表現の仕方はなかったの？",
            "zh": "……就不能换个\n别的方式表现吗？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "48/TALK",
            "narrator": "透明みやび",
            "text": "まあ、ポーズはどうあれ\n上手く描いてくれたのは\n確かや。",
            "zh": "嘛，姿势先不论，\n画得漂亮这点\n是没错咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "49/TALK",
            "narrator": "透明みやび",
            "text": "それで満足しておくぞね。",
            "zh": "就先满足于此咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "50/TALK",
            "narrator": "透明アーヤ",
            "text": "でも…。",
            "zh": "可是……。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "51/TALK",
            "narrator": "透明みやび",
            "text": "それに、アーヤも\n卯月に言ってたやろ？",
            "zh": "再说，绫水你也\n对卯月说过，是没是？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "53/TALK",
            "narrator": "透明みやび",
            "text": "卯月はもっとジャンジャン\n絵を描いていけばえい、\nって。",
            "zh": "说卯月尽管\n放开手多画些画\n就好咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "54/TALK",
            "narrator": "透明アーヤ",
            "text": "だから、ジャンジャン\nなんて言ってないから…。",
            "zh": "所以说，我才没说\n什么“放开手”呀……。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "55/SEL",
            "narrator": "（選択肢）",
            "text": "楽しそうなことになってるね",
            "zh": "看起来聊得很开心呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "56/ACT",
            "narrator": "",
            "text": "楽しそうなことになってるね",
            "zh": "看起来聊得很开心呀",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "そう見える？（；￢＿￢）",
            "zh": "看起来像吗？（；￢＿￢）",
            "narrator_zh": "绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと",
            "zh": "其实",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "困ってるんだけど(；´Д｀)",
