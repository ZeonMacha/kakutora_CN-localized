            "narrator": "雛",
            "text": "…炭酸は入ってない\nみたいだね。",
            "zh": "……好像没有\n碳酸呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "175/TALK",
            "narrator": "つばめ",
            "text": "うん…桃の匂いが\nちょっと強いかも。",
            "zh": "嗯……桃子的味道\n有点浓。",
            "narrator_zh": "燕"
        },
        {
            "location": "176/TALK",
            "narrator": "つばめ",
            "text": "味はどうかな…んくっ。",
            "zh": "味道怎么样……咕嘟。",
            "narrator_zh": "燕"
        },
        {
            "location": "177/TALK",
            "narrator": "ヒカル",
            "text": "……ど、どうですか？",
            "zh": "……怎、怎么样？",
            "narrator_zh": "光"
        },
        {
            "location": "181/TALK",
            "narrator": "つばめ",
            "text": "んっ、んんっ！！",
            "zh": "嗯、嗯嗯！！",
            "narrator_zh": "燕"
        },
        {
            "location": "186/TALK",
            "narrator": "つばめ",
            "text": "美味しい！\nこれ、当たりだよ！",
            "zh": "好喝！\n这个，中奖了呀！",
