{
    "dir": "chap09/daydra/dd_ch01_09_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "9152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "罰ゲーム",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "惩罚游戏"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "罰ゲーム",
            "zh": "惩罚游戏",
            "narrator_zh": ""
        },
        {
            "location": "29/TALK",
            "narrator": "つばめ",
            "text": "う～ん…\nどれにしようかなぁ？",
            "zh": "嗯——……\n选哪个好呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "キリト",
            "text": "どれ選んでも地雷っぽい\nのが酷ぇな。",
            "zh": "选哪个都像踩雷，\n也太狠了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "32/TALK",
            "narrator": "ヒカル",
            "text": "そうですね…。\nこれなんか、飲み物として\nどうなんでしょう？",
            "zh": "是啊……。\n这个作为饮料，\n怎么样？",
            "narrator_zh": "光"
        },
        {
            "location": "33/TALK",
            "narrator": "雛",
            "text": "えっと…繊維質たっぷり\nゴボウジュース？",
            "zh": "那个……富含纤维的\n牛蒡汁？",
            "narrator_zh": "雏"
        },
        {
            "location": "34/TALK",
            "narrator": "雛",
            "text": "どんな味なんだろ？",
            "zh": "会是什么味道呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "ちょっと、土っぽい味が\nしそうだから、それは\n避けたいな。",
            "zh": "感觉会有点\n土味，这个\n我想避开。",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "雛",
            "text": "はぁ…さすがは我が校一、\nヘンテコなラインナップの\n自販機だね。",
            "zh": "哈啊……不愧是我们学校\n最古怪阵容的\n自动售货机呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "37/TALK",
            "narrator": "ヒカル",
            "text": "逢瀬さん、やっぱり\nやめた方がいいですよ。",
            "zh": "逢濑，还是\n算了比较好哦。",
            "narrator_zh": "光"
        },
        {
            "location": "40/TALK",
            "narrator": "つばめ",
            "text": "ダメだよ。\nゲームで負けた人が、\nここのジュースを飲む――",
            "zh": "不行呀。\n游戏输了的人，\n要喝这里的果汁——",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "そういうルール\nなんだから。",
            "zh": "规则就是\n这样的。",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "キリト",
            "text": "逢瀬の言う通りだぜ。\nじゃなきゃゲームやった\n意味なくなっちまうだろ。",
            "zh": "逢濑说得对。\n不然玩游戏就\n没意义了吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "44/TALK",
            "narrator": "キリト",
            "text": "…けど、あんまりヤバそう\nなのは避けような？",
            "zh": "……不过，太危险的\n还是避开吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "45/TALK",
            "narrator": "雛",
            "text": "そうだね。\n飲めなかったら\n無駄になっちゃうし。",
            "zh": "说得是呀。\n喝不下去的话\n就白费了。",
            "narrator_zh": "雏"
        },
        {
            "location": "46/TALK",
            "narrator": "雛",
            "text": "…あっ、これなんかどう？\n「蜂蜜桃林檎ジュース」\nだって。",
            "zh": "……啊，这个怎么样？\n叫「蜂蜜桃苹果汁」\n哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "48/TALK",
            "narrator": "キリト",
            "text": "…怪しいな。",
            "zh": "……可疑啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "50/TALK",
            "narrator": "雛",
            "text": "どこも怪しくないって。\n一番まともそうなのを\n選んだのに。",
            "zh": "哪里都不可疑。\n我选的是\n最正常的那个。",
            "narrator_zh": "雏"
        },
        {
            "location": "54/TALK",
            "narrator": "キリト",
            "text": "ヘンテコ自販機の中で、\n一番まともそうなのが\n怪しいんだよ。",
            "zh": "在古怪自动售货机里，\n最正常的那个\n才可疑。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "57/TALK",
            "narrator": "キリト",
            "text": "俺としては…\nああ、これなんか\nいいと思うぞ。",
            "zh": "要我说……\n啊，这个\n就不错。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "60/TALK",
            "narrator": "つばめ",
            "text": "えっと…「ディス・イズ・\nプロテイン」？",
            "zh": "那个……「This is\nProtein」？",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "わたし、プロテインって\n飲んだことないから、\nちょっと気になるかも。",
            "zh": "我没喝过蛋白粉，\n所以有点\n在意。",
            "narrator_zh": "燕"
        },
        {
            "location": "62/TALK",
            "narrator": "雛",
            "text": "やめた方がいいと思うよ？",
            "zh": "我觉得还是算了哦？",
            "narrator_zh": "雏"
        },
        {
            "location": "63/TALK",
            "narrator": "ヒカル",
            "text": "そうですね。\nそれにするならまだ――",
            "zh": "是啊。\n要选的话还不如——",
            "narrator_zh": "光"
        },
        {
            "location": "64/TALK",
            "narrator": "ヒカル",
            "text": "この「濃厚イモゼリー\nドリンク」の方が良いと\n思いますよ？",
            "zh": "这个「浓厚红薯果冻\n饮料」比较好\n吧？",
            "narrator_zh": "光"
        },
        {
            "location": "67/TALK",
            "narrator": "キリト",
            "text": "これはこれで、\n結構キツそうな気が\nするぞ？",
            "zh": "这个本身，\n感觉也挺\n难喝的？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "68/TALK",
            "narrator": "ヒカル",
            "text": "液体よりゼリーの方が、\n何となくマシな気が\nしたんですが…。",
            "zh": "比起液体，果冻\n总觉得好一点\n……。",
            "narrator_zh": "光"
        },
        {
            "location": "71/TALK",
            "narrator": "つばめ",
            "text": "う～ん…どうしよう…。\nみんなが選んでくれた\n中から決めようかな？",
            "zh": "嗯——……怎么办……。\n从大家选的里面\n决定吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "75/SEL",
            "narrator": "",
            "text": "蜂蜜桃林檎ジュース",
            "zh": "蜂蜜桃苹果汁",
            "narrator_zh": ""
        },
        {
            "location": "76/SEL",
            "narrator": "",
            "text": "ディス・イズ・プロテイン",
            "zh": "This is Protein",
            "narrator_zh": ""
        },
        {
            "location": "77/SEL",
            "narrator": "",
            "text": "濃厚イモゼリードリンク",
            "zh": "浓厚红薯果冻饮料",
            "narrator_zh": ""
        },
        {
            "location": "80/TALK",
            "narrator": "雛",
            "text": "べ、別に良いんだよ？\nあたし達が選んだ中から\nじゃなくたって。",
            "zh": "也、也没关系哦？\n不一定非要从\n我们选的里面。",
            "narrator_zh": "雏"
        },
        {
            "location": "84/TALK",
            "narrator": "つばめ",
            "text": "ううん、そうじゃないの。",
            "zh": "不是的，不是那个意思。",
            "narrator_zh": "燕"
        },
        {
            "location": "85/TALK",
            "narrator": "つばめ",
            "text": "その三つ以外だと、\nどれもハズレばっかりな\n気がして…。",
            "zh": "这三个以外的，\n感觉全是\n地雷……。",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "キリト",
            "text": "…罰ゲーム、\n少しキツかったか？",
            "zh": "……惩罚游戏，\n有点太狠了吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "そんなことないよ。",
            "zh": "没有那种事呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "89/TALK",
            "narrator": "つばめ",
            "text": "こういう罰ゲームって、\nちょっと怖いけど――",
            "zh": "这种惩罚游戏，\n虽然有点可怕——",
            "narrator_zh": "燕"
        },
        {
            "location": "90/TALK",
            "narrator": "つばめ",
            "text": "何が出るかわからなくて\nワクワクするから、\n結構好きなの。",
            "zh": "不知道会出什么，\n让人兴奋，\n我挺喜欢的。",
            "narrator_zh": "燕"
        },
        {
            "location": "93/TALK",
            "narrator": "つばめ",
            "text": "じゃあ…ひなこちゃんが\n選んだのを買ってみるね。",
            "zh": "那就……雏选的\n我买来试试哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "97/TALK",
            "narrator": "雛",
            "text": "大丈夫かなー？\n少しでも美味しいと\n良いんだけど…。",
            "zh": "不要紧吧——？\n哪怕有一点点好喝\n就好了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "99/TALK",
            "narrator": "つばめ",
            "text": "よーし…それじゃあ\n開けるよ…えいっ！",
            "zh": "好——……那就\n打开了……嘿！",
            "narrator_zh": "燕"
        },
        {
            "location": "101/TALK",
            "narrator": "雛",
            "text": "…炭酸は入ってない\nみたいだね。",
            "zh": "……好像没有\n碳酸呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "103/TALK",
            "narrator": "つばめ",
            "text": "うん…桃の匂いが\nちょっと強いかも。",
            "zh": "嗯……桃子的味道\n有点浓。",
            "narrator_zh": "燕"
        },
        {
            "location": "104/TALK",
            "narrator": "つばめ",
            "text": "味はどうかな…んくっ。",
            "zh": "味道怎么样……咕嘟。",
            "narrator_zh": "燕"
        },
        {
            "location": "105/TALK",
            "narrator": "ヒカル",
            "text": "……ど、どうですか？",
            "zh": "……怎、怎么样？",
            "narrator_zh": "光"
        },
        {
            "location": "109/TALK",
            "narrator": "つばめ",
            "text": "んっ、んんっ！！",
            "zh": "嗯、嗯嗯！！",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "つばめ",
            "text": "これ…もしかしたら\n当たりかも。",
            "zh": "这个……说不定\n是中奖了。",
            "narrator_zh": "燕"
        },
        {
            "location": "117/TALK",
            "narrator": "キリト",
            "text": "マジか！？",
            "zh": "真的假的！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "120/TALK",
            "narrator": "雛",
            "text": "美味しかったの！？",
            "zh": "好喝吗！？",
            "narrator_zh": "雏"
        },
        {
            "location": "122/TALK",
            "narrator": "つばめ",
            "text": "うん、凄く美味しいよ。\nこれなら時々は買って\n飲みたいかも。",
            "zh": "嗯，非常好喝哦。\n这个的话偶尔\n也想买来喝。",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "ヒカル",
            "text": "えっ？\n凄く美味しいのに、\n時々なんですか？",
            "zh": "诶？\n这么好喝，\n为什么只是偶尔？",
            "narrator_zh": "光"
        },
        {
            "location": "126/TALK",
            "narrator": "つばめ",
            "text": "美味しいけど…\nビックリするほど\n甘いの。",
            "zh": "好喝是好喝……\n甜得\n吓人。",
            "narrator_zh": "燕"
        },
        {
            "location": "127/TALK",
            "narrator": "つばめ",
            "text": "何の甘さだろ？\nんくっ、んくっ…。",
            "zh": "是什么的甜味呀？\n咕嘟，咕嘟……。",
            "narrator_zh": "燕"
        },
        {
            "location": "128/TALK",
            "narrator": "雛",
            "text": "…ずっと飲み続けてるし、\n美味しいのは間違いない\nみたい。",
            "zh": "……一直在喝，\n好喝是肯定的\n样子。",
            "narrator_zh": "雏"
        },
        {
            "location": "129/TALK",
            "narrator": "キリト",
            "text": "でも、凄く甘いんだろ？\n俺には向いてなさそうだ。",
            "zh": "可是很甜吧？\n好像不适合我。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "130/TALK",
            "narrator": "つばめ",
            "text": "疲れてる時なら\n美味しく飲めるかも\nしれないよ？",
            "zh": "累的时候\n也许能好喝地喝下去\n哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "131/TALK",
            "narrator": "雛",
            "text": "糖分の補給は十分に\nできそうだよね。",
            "zh": "糖分应该能\n补得很够呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "132/TALK",
            "narrator": "ヒカル",
            "text": "疲れてるときに、それを\n飲もう、って気になれば\nいいんですが…。",
            "zh": "累的时候，要是\n能想着喝这个\n就好了……。",
            "narrator_zh": "光"
        },
        {
            "location": "134/ACT",
            "narrator": "",
            "text": "蜂蜜桃林檎ジュース",
            "zh": "蜂蜜桃苹果汁",
            "narrator_zh": ""
        },
        {
            "location": "154/TALK",
            "narrator": "つばめ",
            "text": "うん、それが一番安全っぽいよね",
            "zh": "嗯，这个好像最安全呀",
            "narrator_zh": "燕"
        },
        {
            "location": "155/TALK",
            "narrator": "つばめ",
            "text": "キリトくんは怪しがってたけど",
            "zh": "圣翔虽然觉得可疑",
            "narrator_zh": "燕"
        },
        {
            "location": "156/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、これにするよ",
            "zh": "果然还是选这个",
            "narrator_zh": "燕"
        },
        {
            "location": "168/TALK",
            "narrator": "つばめ",
            "text": "じゃあ…ひなこちゃんが\n選んだのを買ってみるね。",
            "zh": "那就……雏选的\n我买来试试哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "169/TALK",
            "narrator": "雛",
            "text": "大丈夫かなー？\n少しでも美味しいと\n良いんだけど…。",
            "zh": "不要紧吧——？\n哪怕有一点点好喝\n就好了……。",
