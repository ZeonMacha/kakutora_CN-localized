        {
            "location": "202/TALK",
            "narrator": "キリト",
            "text": "でも、凄く甘いんだろ？\n俺には向いてなさそうだ。",
            "zh": "可是很甜吧？\n好像不适合我。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "204/TALK",
            "narrator": "つばめ",
            "text": "疲れてる時なら\n美味しく飲めるかも\nしれないよ？",
            "zh": "累的时候\n也许能好喝地喝下去\n哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "205/TALK",
            "narrator": "雛",
            "text": "糖分の補給は十分に\nできそうだよね。",
            "zh": "糖分应该能\n补得很够呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "206/TALK",
            "narrator": "ヒカル",
            "text": "疲れてるときに、それを\n飲もう、って気になれば\nいいんですが…。",
            "zh": "累的时候，要是\n能想着喝这个\n就好了……。",
            "narrator_zh": "光"
        },
        {
            "location": "207/ACT",
            "narrator": "",
            "text": "ディス・イズ・プロテイン",
            "zh": "This is Protein",
            "narrator_zh": ""
        },
        {
            "location": "228/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃんには止められたけど",
            "zh": "雏虽然劝我别买",
            "narrator_zh": "燕"
        },
        {
            "location": "229/TALK",
            "narrator": "つばめ",
            "text": "やっぱりそれにしようかな？",
            "zh": "果然还是选那个吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "230/TALK",
            "narrator": "つばめ",
            "text": "飲みたい、って思うのを買った方がいいよね",
            "zh": "还是买想喝的比较好吧",
            "narrator_zh": "燕"
        },
        {
            "location": "242/TALK",
            "narrator": "つばめ",
            "text": "プロテインのジュースを\n買ってみるよ。",
            "zh": "我去买蛋白粉的\n果汁哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "243/TALK",
            "narrator": "雛",
            "text": "よりにもよってそれ！？",
            "zh": "偏偏是那个！？",
            "narrator_zh": "雏"
        },
        {
            "location": "245/TALK",
            "narrator": "キリト",
            "text": "逢瀬、おまえプロテイン\n飲んだことないんだろ？",
            "zh": "逢濑，你没喝过\n蛋白粉吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "247/TALK",
            "narrator": "つばめ",
            "text": "うん、だから一度飲んで\nみたいと思ってたの。",
            "zh": "嗯，所以想\n喝一次看看。",
            "narrator_zh": "燕"
        },
        {
            "location": "248/TALK",
            "narrator": "ヒカル",
            "text": "それなら、まずは\n普通に売ってる粉のを\n試してからの方が――",
            "zh": "那样的话，先试试\n普通在卖的粉\n比较——",
            "narrator_zh": "光"
        },
        {
            "location": "252/TALK",
            "narrator": "ヒカル",
            "text": "ああ…\n買っちゃいましたね。",
            "zh": "啊……\n已经买了呀。",
            "narrator_zh": "光"
        },
        {
            "location": "256/TALK",
            "narrator": "つばめ",
            "text": "プレーンタイプ、だって。\nちょっと楽しみかも。",
            "zh": "说是原味。\n有点期待。",
            "narrator_zh": "燕"
        },
        {
            "location": "257/TALK",
            "narrator": "つばめ",
            "text": "いただきまーす。\nんくっ…。",
            "zh": "我开动了——。\n咕嘟……。",
            "narrator_zh": "燕"
        },
        {
            "location": "261/TALK",
            "narrator": "つばめ",
            "text": "…んっ！？",
            "zh": "……嗯！？",
            "narrator_zh": "燕"
        },
        {
            "location": "263/TALK",
            "narrator": "雛",
            "text": "つ、つばめちゃん！？",
            "zh": "燕、燕！？",
            "narrator_zh": "雏"
        },
        {
            "location": "265/TALK",
            "narrator": "つばめ",
            "text": "けほっ、けほけほっ！\n…だ、大丈夫…平気だよ。",
            "zh": "咳、咳咳！\n……没、没事……不要紧呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "266/TALK",
            "narrator": "キリト",
            "text": "やっぱ、不味かったか？",
            "zh": "果然很难喝吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "268/TALK",
            "narrator": "つばめ",
            "text": "けほっ、けほっ…\nううん、そうじゃないの。",
            "zh": "咳、咳……\n不，不是的。",
            "narrator_zh": "燕"
        },
        {
            "location": "269/TALK",
            "narrator": "つばめ",
            "text": "味は…好きじゃないけど、\n飲めない、って味でも\nなかったよ。",
            "zh": "味道……我不喜欢，\n但也不是\n喝不下去。",
            "narrator_zh": "燕"
        },
        {
            "location": "271/TALK",
            "narrator": "つばめ",
            "text": "けど、ちょっと粉っぽい\n感じがして、喉が…。",
            "zh": "不过有点粉粉的\n感觉，喉咙……。",
            "narrator_zh": "燕"
        },
        {
            "location": "272/TALK",
            "narrator": "ヒカル",
            "text": "ありますよね。\n粉っぽいプロテインって。",
            "zh": "是有这种。\n粉粉的蛋白粉。",
            "narrator_zh": "光"
        },
        {
            "location": "273/TALK",
            "narrator": "キリト",
            "text": "そんなの再現しないで、\n飲みやすくした方が\nいいだろうにな。",
            "zh": "那种就别还原了，\n做得好喝一点\n不就好了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "274/TALK",
            "narrator": "つばめ",
            "text": "でも、ずっと気になってた\nプロテインの味が\nわかったから――",
            "zh": "不过，一直在意的\n蛋白粉的味道\n弄明白了——",
            "narrator_zh": "燕"
        },
        {
            "location": "275/TALK",
            "narrator": "つばめ",
            "text": "それだけでも\nよかったと思うよ。",
            "zh": "光是这样就\n觉得很好了呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "276/TALK",
            "narrator": "雛",
            "text": "つばめちゃんのそういう\nポジティブなところ、\n素直に尊敬するよ。",
            "zh": "燕这种\n积极的地方，\n我打从心里尊敬。",
            "narrator_zh": "雏"
        },
        {
            "location": "277/ACT",
            "narrator": "",
            "text": "濃厚イモゼリードリンク",
            "zh": "浓厚红薯果冻饮料",
            "narrator_zh": ""
        },
        {
            "location": "297/TALK",
            "narrator": "つばめ",
            "text": "わたしも、これは結構美味しいと思うの",
            "zh": "我也觉得这个挺好吃的",
            "narrator_zh": "燕"
        },
        {
            "location": "298/TALK",
            "narrator": "つばめ",
            "text": "それに、ゼリーだから飲みやすそうだし",
            "zh": "而且是果冻，好像比较好喝",
            "narrator_zh": "燕"
        },
        {
            "location": "299/TALK",
            "narrator": "つばめ",
            "text": "食べやすそう、って言った方がいいのかな？",
            "zh": "说好入口比较对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "311/TALK",
            "narrator": "つばめ",
            "text": "決めた。\nイモゼリーのジュースに\nしてみるよ。",
            "zh": "决定了。\n就选红薯果冻的\n果汁哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "312/TALK",
            "narrator": "キリト",
            "text": "マジかよ…イモだぞ？",
            "zh": "真的假的……是红薯哦？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "314/TALK",
            "narrator": "つばめ",
            "text": "ゴボウよりかは、\n美味しいと思うよ？",
            "zh": "比起牛蒡，\n我觉得会好吃哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "315/TALK",
            "narrator": "キリト",
            "text": "そりゃそうかも\nしんねぇけど…。",
            "zh": "那倒也许\n是吧……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "320/TALK",
            "narrator": "雛",
            "text": "あっ、買っちゃった…。",
            "zh": "啊，已经买了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "322/TALK",
            "narrator": "キリト",
            "text": "あ～あ…おい、ヒカル。\nもし飲みきれなかったら\n責任取ってやれよ？",
            "zh": "啊——啊……喂，光。\n要是喝不完\n你可得负责哦？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "325/TALK",
            "narrator": "ヒカル",
            "text": "えぇっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "光"
        },
        {
            "location": "326/TALK",
            "narrator": "つばめ",
            "text": "大丈夫だよ。\nそんなに不味そうには\n思えないし。",
            "zh": "不要紧呀。\n看起来也没那么\n难吃。",
            "narrator_zh": "燕"
        },
        {
            "location": "332/TALK",
            "narrator": "つばめ",
            "text": "それに、罰ゲームだから\nちょっと変わったのに\nしないと面白くないよ。",
            "zh": "而且是惩罚游戏，\n不选点特别的\n就没意思呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "333/TALK",
            "narrator": "雛",
            "text": "真面目か！？",
            "zh": "这么认真！？",
            "narrator_zh": "雏"
        },
        {
            "location": "336/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、飲んでみるね。\nちゅぅーっ…。",
            "zh": "那就喝喝看哦。\n吸——……。",
            "narrator_zh": "燕"
        },
        {
            "location": "337/TALK",
            "narrator": "ヒカル",
            "text": "ああっ、そんな勢いよく\n飲まなくても…。",
            "zh": "啊啊，不用喝得\n那么猛……。",
            "narrator_zh": "光"
        },
        {
            "location": "339/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "343/TALK",
            "narrator": "つばめ",
            "text": "あっ…これ、美味しい。",
            "zh": "啊……这个，好喝。",
            "narrator_zh": "燕"
        },
        {
            "location": "344/TALK",
            "narrator": "キリト",
            "text": "マジかよ！？\nだってイモだろ？",
            "zh": "真的假的！？\n可这是红薯吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "346/TALK",
            "narrator": "つばめ",
            "text": "うん、甘いお芋の味がして\n凄く美味しいの。",
            "zh": "嗯，是甜红薯的味道，\n非常好喝。",
            "narrator_zh": "燕"
        },
        {
            "location": "348/TALK",
            "narrator": "つばめ",
            "text": "えへへ、大当たりだね。\nありがと、ヒカルくん。",
            "zh": "诶嘿嘿，大中奖呀。\n谢谢，光。",
            "narrator_zh": "燕"
        },
        {
            "location": "349/TALK",
            "narrator": "ヒカル",
            "text": "…どういたしまして、と\n言うべきでしょうか？",
            "zh": "……该说不客气，\n吗？",
            "narrator_zh": "光"
        },
        {
            "location": "352/TALK",
            "narrator": "つばめ",
            "text": "…でもこれ、ちょっと\n喉が渇く味かも。\nお芋だからかな？",
            "zh": "……不过这个，味道\n有点让人喉咙干。\n因为是红薯吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "353/TALK",
            "narrator": "雛",
            "text": "単体で飲むのは、\nちょっとキツいかも\nしれないね。",
            "zh": "单独喝的话，\n也许有点\n够呛呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "355/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、\n蜂蜜桃林檎ジュースも\n買ってみよっと。",
            "zh": "那就，\n蜂蜜桃苹果汁也\n买一个吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "357/TALK",
            "narrator": "キリト",
            "text": "お、おい逢瀬！\n二本目は普通ので――。",
            "zh": "喂、喂，逢濑！\n第二瓶选普通的——。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "364/TALK",
            "narrator": "キリト",
            "text": "…間に合わなかったか。",
            "zh": "……没来得及吗。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "365/TALK",
            "narrator": "つばめ",
            "text": "そんな変なジュース、\nってわけじゃなさそう\nだし、平気だよ。",
            "zh": "也不像是\n那么奇怪的果汁，\n不要紧呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "366/TALK",
            "narrator": "雛",
            "text": "無理はしないでね？\n不味かったら残して\nいいんだから。",
            "zh": "别勉强哦？\n难喝的话剩下\n也没关系。",
            "narrator_zh": "雏"
        },
        {
            "location": "368/TALK",
            "narrator": "つばめ",
            "text": "うん…んくっ…。",
            "zh": "嗯……咕嘟……。",
            "narrator_zh": "燕"
        },
        {
            "location": "372/TALK",
            "narrator": "つばめ",
            "text": "んっ！？\nあ、甘ーい！！",
            "zh": "嗯！？\n好、好甜！！",
            "narrator_zh": "燕"
        },
        {
            "location": "376/TALK",
            "narrator": "ヒカル",
            "text": "あ、甘い？",
            "zh": "啊，甜？",
            "narrator_zh": "光"
        },
        {
            "location": "378/TALK",
            "narrator": "つばめ",
            "text": "こ、これ、ビックリする\nくらい甘いの！",
            "zh": "这、这个，甜得\n吓人！",
            "narrator_zh": "燕"
        },
        {
            "location": "379/TALK",
            "narrator": "キリト",
            "text": "甘いの二連発か。\nキツいな…。",
            "zh": "甜的连着两发。\n够呛啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "381/TALK",
            "narrator": "つばめ",
            "text": "普通の炭酸にすれば\nよかった…。",
            "zh": "选普通碳酸\n就好了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "382/TALK",
            "narrator": "雛",
            "text": "やっぱり、ここの自販機は\n危険だね。",
            "zh": "果然，这里的自动售货机\n很危险呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "17/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月23日　12:15 PM</color>\nとある昼休み、学食横の自販機コーナーにて。",
            "zh": "<color=green>5月23日　12:15 PM</color>\n某个午休，食堂旁边的自动售货机角落。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
