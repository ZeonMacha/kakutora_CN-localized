        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "みんなのお友達は？",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "大家的朋友是？"
    },
    "entry": [
        {
            "location": "235/SCENARIO",
            "narrator": "",
            "text": "みんなのお友達は？",
            "zh": "大家的朋友是？",
            "narrator_zh": ""
        },
        {
            "location": "258/TALK",
            "narrator": "雛",
            "text": "キリトー、そこのゴミを\n外に出しといてー。",
            "zh": "圣翔，把那边的垃圾\n拿到外面去吧—。",
            "narrator_zh": "雏"
        },
        {
            "location": "260/TALK",
            "narrator": "キリト",
            "text": "すっげぇ量あるな…\nヒカル、手伝ってくれ。",
            "zh": "量真多啊……\n光，帮个忙。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "262/TALK",
            "narrator": "ヒカル",
            "text": "わかりました。",
            "zh": "明白了。",
            "narrator_zh": "光"
        },
        {
            "location": "263/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "271/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん、\nどうかしたんですか？",
            "zh": "加布，\n怎么了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "272/TALK",
            "narrator": "ガブリエラ",
            "text": "別に…ただ、ここも\n賑やかになったな、って\n思っただけ。",
            "zh": "没什么……只是觉得，这里\n也变得热闹起来了\n而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "273/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、\nつばめって\n結構友達多いのね？",
            "zh": "话说回来，\n燕的\n朋友还挺多的呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "274/TALK",
            "narrator": "つばめ",
            "text": "そう言ってもらえると\n嬉しいな。",
            "zh": "你能这么说\n我好开心呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "276/TALK",
            "narrator": "つばめ",
            "text": "みんな、わたしの\n自慢のお友達だから。",
            "zh": "因为大家都是\n我引以为傲的朋友嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "277/TALK",
            "narrator": "つばめ",
            "text": "そういえば、\nガブちゃんの\nお友達は？",
            "zh": "说起来，\n加布的\n朋友呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "278/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あたしの友達！？",
            "zh": "我、我的朋友！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "279/TALK",
            "narrator": "つばめ",
            "text": "はい！",
            "zh": "是的！",
            "narrator_zh": "燕"
        },
        {
            "location": "280/TALK",
            "narrator": "ガブリエラ",
            "text": "友達、友達ね…。\nえーっと…。",
            "zh": "朋友、朋友呢……\n呃……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "281/SEL",
            "narrator": "",
            "text": "いる、とだけ答えておこう",
            "zh": "就只回答“有”吧",
            "narrator_zh": ""
        },
        {
            "location": "282/SEL",
            "narrator": "",
            "text": "ちょっと待って考える",
            "zh": "等一下我想想",
            "narrator_zh": ""
        },
        {
            "location": "283/SEL",
            "narrator": "",
            "text": "$me$を友達だと思って",
            "zh": "把$me$当成朋友",
            "narrator_zh": ""
        },
        {
            "location": "286/TALK",
            "narrator": "ガブリエラ",
            "text": "ど、どうしよう。",
            "zh": "怎、怎么办。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "287/TALK",
            "narrator": "ガブリエラ",
            "text": "まさかいないなんて\n言えるわけないし…。",
            "zh": "总不可能说\n自己没有朋友吧……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん？",
            "zh": "加布？",
            "narrator_zh": "燕"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "これ以上黙ってたら、\nさすがに怪しく\n思われるかも…。",
            "zh": "再这么沉默下去，\n果然还是会被\n起疑吧……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "296/TALK",
            "narrator": "雛",
            "text": "何で悩んじゃうかなー？\nそんなの、超簡単じゃん。",
            "zh": "这有什么好烦恼的呀—？\n这种事，超简单的嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "298/TALK",
            "narrator": "ガブリエラ",
            "text": "ど、どういう意味？",
            "zh": "什、什么意思？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "299/TALK",
            "narrator": "雛",
            "text": "あたし達を指差して、\nあんな友達、って言えば\nそれでＯＫでしょ？",
            "zh": "指着我们说，\n“像她们那样的朋友”，\n这样不就OK了吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "301/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ……。",
            "zh": "呃……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "302/TALK",
            "narrator": "雛",
            "text": "だって、あたし達だって\nガブリエラちゃんの\n友達なんだし。ね？",
            "zh": "毕竟，我们也都是\n加布里埃拉的\n朋友嘛。对吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "306/TALK",
            "narrator": "キリト",
            "text": "おう、当然じゃん！",
            "zh": "哦，那当然了！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "308/TALK",
            "narrator": "ヒカル",
            "text": "ひなこさんの\n言うとおりですよ。",
            "zh": "就像雏\n说的那样哦。",
            "narrator_zh": "光"
        },
        {
            "location": "311/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "312/TALK",
            "narrator": "雛",
            "text": "あれ？　どうかしたの？",
            "zh": "咦？　怎么了吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "313/TALK",
            "narrator": "ガブリエラ",
            "text": "あ…あたし、向こうで\n仕事があるから！",
            "zh": "我……我那边\n还有工作要做！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "321/TALK",
            "narrator": "つばめ",
            "text": "あ、ガブちゃん？",
            "zh": "啊，加布？",
            "narrator_zh": "燕"
        },
        {
            "location": "331/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ、はぁ…ふぅ…。",
            "zh": "哈啊、哈啊……呼……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "333/TALK",
            "narrator": "ガブリエラ",
            "text": "危なかった…涙出ちゃう\nところだったわ…。",
            "zh": "好险……差点\n就要掉眼泪了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "335/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、そっか…。\nひなこ達は、\nあたしのお友達なんだ。",
            "zh": "不过，这样啊……\n雏她们，\n是我的朋友啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "337/ACT",
            "narrator": "",
            "text": "いる、とだけ答えておこう",
            "zh": "就只回答“有”吧",
            "narrator_zh": ""
        },
        {
            "location": "357/TALK",
            "narrator": "ガブリエラ",
            "text": "そっけなく答える作戦ね",
            "zh": "冷淡敷衍的作战对吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "358/TALK",
            "narrator": "ガブリエラ",
            "text": "さすがはマルザンナ、頼りになるわ♪",
            "zh": "不愧是玛尔赞娜，真可靠♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "369/TALK",
            "narrator": "ガブリエラ",
            "text": "友達ならいるわ。",
            "zh": "朋友的话我还是有的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "371/TALK",
            "narrator": "つばめ",
            "text": "…はい？",
            "zh": "……什么？",
            "narrator_zh": "燕"
        },
        {
            "location": "372/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、友達はいるから。\nわかった？",
            "zh": "所以我说了，我有朋友。\n明白了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "374/TALK",
            "narrator": "つばめ",
            "text": "えっと…どういう人達\nなのかを知りたいん\nだけど…。",
            "zh": "那个……我想知道的是\n她们是怎样的人\n呢……。",
            "narrator_zh": "燕"
        },
        {
            "location": "375/TALK",
            "narrator": "ガブリエラ",
            "text": "し、しまった！\nこれじゃ答えになって\nないじゃない！",
            "zh": "糟、糟了！\n这根本不算\n回答嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "376/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナへの聞き方が\n間違ってたみたい。\nうー、どうしよう…。",
            "zh": "看来问玛尔赞娜的方式\n搞错了。\n呜—，怎么办……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "377/TALK",
            "narrator": "つばめ",
            "text": "えっと、ガブちゃん？",
            "zh": "那个，加布？",
            "narrator_zh": "燕"
        },
        {
            "location": "378/TALK",
            "narrator": "ガブリエラ",
            "text": "…ふ、普通よ。",
            "zh": "……普、普通啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "379/TALK",
            "narrator": "ガブリエラ",
            "text": "別に、特に変わったところ\nなんてない、普通の友達\nしかいないの！",
            "zh": "也没什么特别奇怪的地方，\n只有很普通的\n朋友而已！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "380/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、あたしは向こうで\n仕事があるから！",
            "zh": "那，我那边\n还有工作要做！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "381/TALK",
            "narrator": "ガブリエラ",
            "text": "友達がいないってこと、\nバレてないかしら？",
            "zh": "我没有朋友这件事，\n应该没露馅吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "388/TALK",
            "narrator": "つばめ",
            "text": "普通の友達かぁ…。",
            "zh": "普通的朋友呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "390/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃん達みたいな、\nキャラの濃い子達じゃ\nない、ってことかな？",
            "zh": "意思是说，不像雏她们\n那样性格鲜明、\n画风浓烈的人吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "391/ACT",
            "narrator": "",
            "text": "ちょっと待って考える",
            "zh": "等一下我想想",
            "narrator_zh": ""
        },
        {
            "location": "399/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか、マルザンナ！？\n何かいい方法があるの？",
            "zh": "难道说，玛尔赞娜！？\n你有什么好办法吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "400/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと待って。\n今、ＷＡＶＥが来た\nみたいだから。",
            "zh": "等一下。\n好像刚好\n来了ＷＡＶＥ。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "414/TALK",
            "narrator": "ガブリエラ",
            "text": "考えてから言ってきて！",
            "zh": "想好了再发过来啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "415/TALK",
            "narrator": "ガブリエラ",
            "text": "何か良い方法があるのかと思って期待したのに…",
            "zh": "还以为你有什么好办法才满怀期待的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "416/TALK",
            "narrator": "ガブリエラ",
            "text": "もういいわ、自分で考える！",
            "zh": "算了，我自己想！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "428/TALK",
            "narrator": "ガブリエラ",
            "text": "とは言ったものの、\nなんて答えようかしら…。",
            "zh": "话虽这么说，\n该怎么回答才好呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "431/TALK",
            "narrator": "雛",
            "text": "何で悩んじゃうかなー？\nそんなの、超簡単じゃん。",
            "zh": "这有什么好烦恼的呀—？\n这种事，超简单的嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "433/TALK",
            "narrator": "ガブリエラ",
            "text": "ど、どういう意味？",
            "zh": "什、什么意思？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "434/TALK",
            "narrator": "雛",
            "text": "あたし達を指差して、\nあんな友達、って言えば\nそれでＯＫでしょ？",
            "zh": "指着我们说，\n“像她们那样的朋友”，\n这样不就OK了吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "436/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ……。",
            "zh": "呃……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "437/TALK",
            "narrator": "雛",
            "text": "だって、あたし達だって\nガブリエラちゃんの\n友達なんだし。ね？",
            "zh": "毕竟，我们也都是\n加布里埃拉的\n朋友嘛。对吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "441/TALK",
            "narrator": "キリト",
            "text": "おう、当然じゃん！",
            "zh": "哦，那当然了！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "443/TALK",
            "narrator": "ヒカル",
            "text": "ひなこさんの\n言うとおりですよ。",
            "zh": "就像雏\n说的那样哦。",
            "narrator_zh": "光"
        },
        {
            "location": "446/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "447/TALK",
            "narrator": "雛",
            "text": "あれ？　どうかしたの？",
            "zh": "咦？　怎么了吗？",
