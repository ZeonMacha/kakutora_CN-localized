{
    "dir": "chap06/daydra/dd_ch03_06_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "6352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "告白",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "告白"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "告白",
            "zh": "告白",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "さてと、\nお昼休みもそろそろ\nお終いだし――",
            "zh": "那么，\n午休也快\n结束了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "25/TALK",
            "narrator": "ガブリエラ",
            "text": "教室に帰って\n準備しなくちゃだわ。",
            "zh": "得回教室\n做准备了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "男子高校生Ａ",
            "text": "あの、\nちょっといいかな？",
            "zh": "那个，\n能耽误你一下吗？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "男子高校生Ａ",
            "text": "君さ、中等部の\nガブリエラだよね？",
            "zh": "你就是中学部的\n加布里埃拉吧？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？\n何、こいつ？\nっていうか誰なの！？",
            "zh": "诶！？\n什么，这人？\n话说你是谁！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "男子高校生Ａ",
            "text": "えっと…\n警戒されてる？",
            "zh": "那个……\n我被警惕了？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "38/SEL",
            "narrator": "",
            "text": "電話で話すフリをして",
            "zh": "假装在打电话",
            "narrator_zh": ""
        },
        {
            "location": "40/TALK",
            "narrator": "男子高校生Ａ",
            "text": "ごめんね、\n急に声掛けて。",
            "zh": "对不起，\n突然叫住你。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "41/TALK",
            "narrator": "男子高校生Ａ",
            "text": "ただ、ちょっと\n二人きりで話したい\nことがあって…。",
            "zh": "只是，有点事\n想两个人单独\n说……。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "42/TALK",
            "narrator": "男子高校生Ａ",
            "text": "今って時間あるかな？",
            "zh": "现在有时间吗？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "46/TALK",
            "narrator": "ガブリエラ",
            "text": "ど、どうしよう、断ら\nないと。知らない人と\n二人きりなんて嫌よ！",
            "zh": "怎、怎么办，得拒绝。\n跟不认识的人\n单独待着我可不想！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "ああもうっ！\nどうしていつも声が\n出なくなっちゃうの！",
            "zh": "啊真是的！\n为什么每次都\n发不出声音！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "49/TALK",
            "narrator": "男子高校生Ａ",
            "text": "…逃げないってことは、\nＯＫってことかな？",
            "zh": "……不逃的话，\n就是OK了吧？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "50/TALK",
            "narrator": "男子高校生Ａ",
            "text": "とりあえず、\n場所移そう。\n俺に付いてきて。",
            "zh": "总之，\n换个地方。\n跟我来。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしよう…。\n誰か、助けて…。",
            "zh": "怎么办……。\n谁来帮帮我……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "男子高校生Ａ",
            "text": "ありがとう。\n急に無理な\nお願い聞いてくれて。",
            "zh": "谢谢。\n突然的无理请求\n你还是听了。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "69/TALK",
            "narrator": "ガブリエラ",
            "text": "聞いたんじゃない！\n断れなかった\nだけなのに！",
            "zh": "我才没有答应！\n只是拒绝\n不了而已！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "71/TALK",
            "narrator": "男子高校生Ａ",
            "text": "あっ、警戒しないで。\n本当少し話があるだけ\nなんだよ。",
            "zh": "啊，别那么警惕。\n真的只是有点话\n要说。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "72/TALK",
            "narrator": "男子高校生Ａ",
            "text": "実はさ…その――",
            "zh": "其实啊……那个——",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "73/TALK",
            "narrator": "男子高校生Ａ",
            "text": "ガブリエラって、\n今、お付き合いしてる\n人いない…よね？",
            "zh": "加布里埃拉，\n现在没有在交往的\n人……对吧？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "男子高校生Ａ",
            "text": "気になってる人とかも\nもしいないなら――",
            "zh": "要是也没有\n在意的人的话——",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "76/TALK",
            "narrator": "男子高校生Ａ",
            "text": "良ければ…\n俺と付き合って\nほしいんだ。",
            "zh": "如果可以……\n希望你和我\n交往。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "…えっ！？",
            "zh": "……诶！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "79/TALK",
            "narrator": "男子高校生Ａ",
            "text": "…俺さ、\nずっと君のことが\n好きだったんだ。",
            "zh": "……我啊，\n一直\n喜欢你。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "80/TALK",
            "narrator": "男子高校生Ａ",
            "text": "正確には、数ヶ月前に\n校庭で見かけてから\nなんだけど――",
            "zh": "准确说，是几个月前\n在操场看见你\n之后——",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "81/TALK",
            "narrator": "男子高校生Ａ",
            "text": "一目惚れなんだ。",
            "zh": "是一见钟情。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "82/SEL",
            "narrator": "",
            "text": "端末操作：着信音",
            "zh": "终端操作：来电铃声",
            "narrator_zh": ""
        },
        {
            "location": "83/SEL",
            "narrator": "",
            "text": "端末操作：アーヤ呼び出し",
            "zh": "终端操作：绫水呼叫",
            "narrator_zh": ""
        },
        {
            "location": "84/SEL",
            "narrator": "",
            "text": "代わりに応えるよ",
            "zh": "我替你回答",
            "narrator_zh": ""
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "うそっ！？\nあたし、本当に告白され\nちゃってるの！？",
            "zh": "不会吧！？\n我真的正在被\n告白！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "それも年上の\n男の子に…。",
            "zh": "而且还是年长的\n男孩子……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、よく知らない\nどころか初めて見る人\nとは付き合えないし…。",
            "zh": "……可是，别说熟悉，\n连第一次见的人\n我都没法交往……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "男子高校生Ａ",
            "text": "別に、今って相手は\nいないんだろ？",
            "zh": "反正现在\n没有对象吧？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "95/TALK",
            "narrator": "男子高校生Ａ",
            "text": "俺、ずっと君のことを\n見てたから知ってる\nけど――",
            "zh": "我一直看着你，\n所以知道，\n不过——",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "96/TALK",
            "narrator": "男子高校生Ａ",
            "text": "フリーだよね？",
            "zh": "单身吧？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "…見てた？\n今、この人見てたって\n言った？",
            "zh": "……看着？\n刚才这人说\n他看着我？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "101/TALK",
            "narrator": "男子高校生Ａ",
            "text": "お昼ご飯も、帰る時も、\nいつも女の子とばかり\nいたの、見てるから。",
            "zh": "午饭也好，回去的时候也好，\n总是只和女孩子在一起，\n我都看着的。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "102/TALK",
            "narrator": "男子高校生Ａ",
            "text": "寮にもまっすぐ帰って、\n寄り道も男の二人きりで\nすることはないし…。",
            "zh": "回宿舍也是直接回去，\n绕路也不会和男生单独，\n不会做那种事……。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "やだ、何この人！？\n怖い！",
            "zh": "讨厌，这人怎么回事！？\n好可怕！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "ていうか、\nあたしのこと\n寮までつけてたの！？",
            "zh": "话说，\n他跟着我\n一直到宿舍了！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "男子高校生Ａ",
            "text": "…そろそろさ、\nいい加減返事が\n欲しいんだけど？",
            "zh": "……差不多了，\n我想要一个\n答复？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "返事って…この人、\n本気で言ってるの？",
            "zh": "答复……这人\n是认真的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対に嫌よ。\n嫌だって…一言、\n嫌って言えれば…。",
            "zh": "绝对不要。\n不要……只要一句，\n能说出不要就好……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！　…っ！",
            "zh": "唔！　……唔！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "111/TALK",
            "narrator": "男子高校生Ａ",
            "text": "…どうしたの？\nもしかして、\n具合でも悪いとか？",
            "zh": "……怎么了？\n难道\n身体不舒服？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "114/TALK",
            "narrator": "男子高校生Ａ",
            "text": "保健室に行く？\nほら、手を貸して。",
            "zh": "去保健室吗？\n来，我扶你。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "118/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！！",
            "zh": "唔！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "男子高校生Ａ",
            "text": "あっ、待って！",
            "zh": "啊，等等！",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "128/TALK",
            "narrator": "男子高校生Ａ",
            "text": "…まだ、返事もらって\nないんだけど…。",
            "zh": "……我还没\n得到答复……。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "130/ACT",
            "narrator": "",
            "text": "端末操作：着信音",
            "zh": "终端操作：来电铃声",
            "narrator_zh": ""
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "ナイスよマルザンナ！\n話すフリをして\n部屋から出ていけば…。",
            "zh": "漂亮，玛尔赞娜！\n假装在说话，\n然后离开房间……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "159/TALK",
            "narrator": "男子高校生Ａ",
            "text": "電話、切ってくれる？\n真面目な話だからさ。",
            "zh": "能把电话挂了吗？\n因为是认真的话。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "…この人、怖い。\n言う通りにしておいた\n方が良いかも…。",
            "zh": "……这人，好可怕。\n也许照他说的做\n比较好……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "164/TALK",
            "narrator": "男子高校生Ａ",
            "text": "別に、今って相手は\nいないんだろ？",
            "zh": "反正现在\n没有对象吧？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "165/TALK",
            "narrator": "男子高校生Ａ",
            "text": "俺、ずっと君のことを\n見てたから知ってる\nけど――",
            "zh": "我一直看着你，\n所以知道，\n不过——",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "167/TALK",
            "narrator": "男子高校生Ａ",
            "text": "フリーだよね？",
            "zh": "单身吧？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "170/TALK",
            "narrator": "ガブリエラ",
            "text": "…見てた？\n今、この人見てたって\n言った？",
            "zh": "……看着？\n刚才这人说\n他看着我？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "171/TALK",
            "narrator": "男子高校生Ａ",
            "text": "お昼ご飯も、帰る時も、\nいつも女の子とばかり\nいたの、見てるから。",
            "zh": "午饭也好，回去的时候也好，\n总是只和女孩子在一起，\n我都看着的。",
            "narrator_zh": "男高中生A"
        },
        {
