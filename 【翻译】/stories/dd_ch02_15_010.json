{
    "dir": "chap15/daydra/dd_ch02_15_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "15252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "電車通学",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "坐电车上学"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "電車通学",
            "zh": "坐电车上学",
            "narrator_zh": ""
        },
        {
            "location": "18/TALK",
            "narrator": "つばめ",
            "text": "あれ？　アーヤさん。\n今日はバイクじゃないん\nですか？",
            "zh": "哎？绫水。\n今天没骑摩托\n来吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "21/TALK",
            "narrator": "アーヤ",
            "text": "来る時に雨が降りそう\nだったから、電車にしたん\nだけど――",
            "zh": "来的时候眼看要下雨了，\n所以改坐电车了，\n结果——",
            "narrator_zh": "绫水"
        },
        {
            "location": "22/TALK",
            "narrator": "アーヤ",
            "text": "見ての通り、今頃になって\n晴れてきちゃってね…。",
            "zh": "如你所见，偏偏这会儿\n放晴了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/TALK",
            "narrator": "つばめ",
            "text": "そうだったんですか…。",
            "zh": "原来是这样啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "24/TALK",
            "narrator": "アーヤ",
            "text": "バイクで少しだけ\n遠回りして帰るのが\n好きなんだけど――",
            "zh": "我本来挺喜欢骑摩托\n稍微绕点远路回家的\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "残念ながら、\n今日はお預けね。",
            "zh": "可惜，\n今天只能作罢了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "28/TALK",
            "narrator": "つばめ",
            "text": "…アーヤさん、\n何だかガッカリしてる\nみたい。",
            "zh": "……绫水，\n看起来好像\n有点失望呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "29/TALK",
            "narrator": "つばめ",
            "text": "…そうだ！\n今日の放課後って\n予定ありますか？",
            "zh": "……对了！\n今天放学后\n你有安排吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "30/TALK",
            "narrator": "アーヤ",
            "text": "う～ん…早く帰って、\n少しでもバイクに\n乗ろうかと思ってるわ。",
            "zh": "唔……我想早点回去，\n哪怕骑上一小会儿\n摩托也好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "あの子、一日一回は\nエンジン掛けないと、\n機嫌悪くなっちゃうのよ。",
            "zh": "那孩子一天不发动\n一次引擎，\n脾气就会变坏哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "つばめ",
            "text": "あはは、かっこいいのに\nワガママさんなんですね。",
            "zh": "啊哈哈，明明那么帅气，\n却还是个任性的家伙呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "もし予定がないなら、\n一緒に寄り道なんて\nどうかな――",
            "zh": "要是没有安排的话，\n要不要一起绕个路\n逛逛——",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "つばめ",
            "text": "って、思ったんですけど、\nそれじゃあ仕方ない\nですね。",
            "zh": "我本来是这么想的，\n那也没办法\n了呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "38/TALK",
            "narrator": "アーヤ",
            "text": "つばめと？",
            "zh": "和燕一起？",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "はい。アーヤさんって、\nいつもバイクで大学に\n通ってますよね？",
            "zh": "嗯。绫水你平时\n都是骑摩托去大学的\n对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "40/TALK",
            "narrator": "つばめ",
            "text": "だから、たまには普通に\n寄り道して帰るのも\n楽しいんじゃないかな――",
            "zh": "所以我想，偶尔像这样\n顺路逛逛再回家，\n说不定也挺开心的——",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "って、思ったんです。",
            "zh": "我是这么想的。",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "アーヤ",
            "text": "う～ん…寄り道かぁ。",
            "zh": "唔……顺路逛逛啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "44/SEL",
            "narrator": "",
            "text": "まっすぐ帰ろう",
            "zh": "直接回家吧",
            "narrator_zh": ""
        },
        {
            "location": "45/SEL",
            "narrator": "",
            "text": "たまには良いと思うよ",
            "zh": "我觉得偶尔一次也不错",
            "narrator_zh": ""
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "でも、バイトの時間も\nあるから、遠くには\n行けないわよ？",
            "zh": "不过，我还有打工的\n时间，太远的地方\n可去不了哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "帰り道にも、面白いお店は\n沢山あります。",
            "zh": "回家的路上也有很多\n有意思的店哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "49/TALK",
            "narrator": "つばめ",
            "text": "そうだ！\nこの前も、素敵な雑貨屋を\n見つけちゃったんです。",
            "zh": "对了！\n我前阵子也发现了一家\n很棒的杂货店呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "北欧スタイルの雑貨や\n家具なんかが置いてある、\n素敵なお店なんですよ。",
            "zh": "里面摆着北欧风格的\n杂货和家具之类的，\n是一家很棒的店哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "へぇ、そんな素敵な\nお店が近くにあるんだ？",
            "zh": "哦，这么棒的店\n就在附近吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "つばめ",
            "text": "大通りから一本奥に\n入ったところにある\nお店なんです。",
            "zh": "从大马路往里拐一条街\n就能看到那家\n店了。",
            "narrator_zh": "燕"
        },
        {
            "location": "54/TALK",
            "narrator": "アーヤ",
            "text": "そうなんだ…。\nじゃあ、帰りはそこに\n行ってみましょ。",
            "zh": "这样啊……。\n那回去的时候就去那家\n看看吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "56/TALK",
            "narrator": "つばめ",
            "text": "やった！\nじゃあ、授業終わったら\nＷＡＶＥを送りますね。",
            "zh": "太好啦！\n那下课之后\n我给你发WAVE哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "ええ、楽しみにしてるわ。",
            "zh": "嗯，我很期待。",
            "narrator_zh": "绫水"
        },
        {
            "location": "59/ACT",
            "narrator": "",
            "text": "まっすぐ帰ろう",
            "zh": "直接回家吧",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "…そうよね",
            "zh": "……也是呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "バイトのことも考えると、今日はやめた方が良いかも",
            "zh": "考虑到还要打工，今天还是算了比较好",
            "narrator_zh": "绫水"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "せっかくだけど、\n今日はやめておくわ。",
            "zh": "难得你邀请，\n不过今天还是算了吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "バイトもあるから、\nあんまりゆっくりとして\nいられないだろうし。",
            "zh": "因为待会儿还要打工，\n大概也没法\n太悠闲地逛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "93/TALK",
            "narrator": "アーヤ",
            "text": "せっかくお店を見て\n周るなら、時間のある日に\n行きたいわ。",
            "zh": "既然难得去逛店，\n还是挑有时间的日子\n再去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "95/TALK",
            "narrator": "つばめ",
            "text": "そうですか…。",
            "zh": "这样啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "96/TALK",
            "narrator": "アーヤ",
            "text": "その代わりなんだけど、\n今日は私に付き合って\nもらえないかしら？",
            "zh": "作为补偿，\n今天能不能陪我\n一趟呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "97/TALK",
            "narrator": "アーヤ",
            "text": "帰ったら近所をバイクで\n流そうと思うから――",
            "zh": "我打算回去之后骑摩托\n在附近兜兜风——",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/TALK",
            "narrator": "アーヤ",
            "text": "よければ、一緒にどう？\nたまには後ろに誰か\n乗ってほしかったの。",
            "zh": "如果方便的话，一起去吗？\n偶尔也想让谁坐在\n后座呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "101/TALK",
            "narrator": "つばめ",
            "text": "わぁ、いいんですか？",
            "zh": "哇，可以吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "もちろんよ。",
            "zh": "当然了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "つばめ",
            "text": "お付き合いします！\n楽しみです。",
            "zh": "我陪你去！\n好期待呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "105/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、つばめも\nバイクの良さがわかって\nきたのかしら？",
            "zh": "呵呵，燕也开始\n体会到摩托的好\n了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "106/TALK",
            "narrator": "アーヤ",
            "text": "私も楽しみにしてるわ。\nそれじゃあ、放課後にね。",
            "zh": "我也很期待哦。\n那就放学后见。",
            "narrator_zh": "绫水"
        },
        {
            "location": "107/ACT",
            "narrator": "",
            "text": "たまには良いと思うよ",
            "zh": "我觉得偶尔一次也不错",
            "narrator_zh": ""
        },
        {
            "location": "127/TALK",
            "narrator": "アーヤ",
            "text": "聞いてたの？",
            "zh": "你听到了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "アーヤ",
            "text": "私もそう思ってたところよ",
            "zh": "我也正这么想呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "決まりね(*^-ﾟ)v",
            "zh": "就这么定了(*^-ﾟ)v",
            "narrator_zh": "绫水"
        },
        {
            "location": "141/TALK",
            "narrator": "つばめ",
            "text": "ＷＡＶＥですか？",
            "zh": "是WAVE吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "144/TALK",
            "narrator": "アーヤ",
            "text": "あ、ごめんなさい。\nちょっと友達からね…。",
            "zh": "啊，不好意思。\n是朋友发来的消息……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "145/TALK",
            "narrator": "アーヤ",
            "text": "寄り道しながら帰るのも\n楽しそうね。\n今日は一緒に帰りましょ。",
            "zh": "边逛边回家好像也\n挺有意思的。\n今天我们一起回去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "146/TALK",
            "narrator": "つばめ",
            "text": "本当ですか！？",
            "zh": "真的吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "147/TALK",
            "narrator": "アーヤ",
            "text": "ええ。",
            "zh": "嗯。",
            "narrator_zh": "绫水"
        },
        {
            "location": "148/TALK",
            "narrator": "アーヤ",
            "text": "ただし、どこに行くかは\nつばめが決めてね。",
            "zh": "不过，去哪里得由\n燕来定哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "150/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！！\nわ、わたしがですか！？",
            "zh": "哎！！\n我、我来定吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "152/TALK",
            "narrator": "アーヤ",
            "text": "そりゃ、こういうのは\n誘った人が決めるもん\nでしょ？",
            "zh": "那是当然，这种事本来\n就是发起邀请的人来定\n的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "アーヤ",
            "text": "それに私、寄り道なんて\n普段しないから――",
            "zh": "而且我平时根本\n不会绕路去逛街——",
            "narrator_zh": "绫水"
        },
        {
            "location": "154/TALK",
            "narrator": "アーヤ",
            "text": "どういうところに行けば\nいいのかわからないもの。",
            "zh": "实在不知道该去\n什么样的地方好呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "156/TALK",
            "narrator": "アーヤ",
            "text": "そういうわけで、\n放課後楽しみにしてるわ。",
            "zh": "就是这样，\n我很期待放学后哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "157/TALK",
            "narrator": "つばめ",
            "text": "えぇーっ！？",
            "zh": "哎——！？",
            "narrator_zh": "燕"
        },
        {
            "location": "158/TALK",
            "narrator": "つばめ",
            "text": "ど、どうしよう…。\nアーヤさんが楽しめる\nところ、行けるかなぁ？",
            "zh": "怎、怎么办……。\n能带绫水去她喜欢\n的地方吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "159/TALK",
            "narrator": "アーヤ",
            "text": "こっちに来てから\nこういうの初めてだし――",
            "zh": "来到这边之后\n这还是头一回——",
            "narrator_zh": "绫水"
        },
        {
            "location": "160/TALK",
            "narrator": "アーヤ",
            "text": "私はどこでも構わないん\nだけどね。",
            "zh": "我倒是去哪儿都无所谓\n就是了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "16/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月4日　3:13 PM</color>\nとある平日の放課後、附属学園正門前にて。",
            "zh": "<color=green>7月4日　3:13 PM</color>\n某天平日放学后，在附属学园正门前。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
