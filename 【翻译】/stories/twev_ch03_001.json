            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "ガブリエラ",
            "text": "早速",
            "zh": "我这就去",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "近くでお祭りやらないか調べるから",
            "zh": "查查附近有没有祭典",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "134/TALK",
            "narrator": "ガブリエラ",
            "text": "お話はまた夜にね",
            "zh": "我们晚上再聊哦",
            "narrator_zh": "加布里埃拉"
        },
        {
