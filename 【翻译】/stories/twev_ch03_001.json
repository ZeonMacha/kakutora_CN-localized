    "info": {
        "story_id": "31121",
        "cid": "",
        "title": "Twitter Archive 003",
        "sub_title": "卯月画廊：お祭りガブちゃん♪",
        "title_zh": "推特 存档 003",
        "sub_title_zh": "卯月画廊：祭典上的加布酱♪"
    },
    "entry": [
        {
            "location": "27/TALK",
            "narrator": "透明アーヤ",
            "text": "卯月の描いたギャヴィ、\nとっても可愛いと思うわ。",
            "zh": "我觉得卯月画的加维，\n非常可爱哦。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "28/TALK",
            "narrator": "透明神楽",
            "text": "ふふっ、自信作だったので\n褒めていただけると\n嬉しいです。",
            "zh": "呵呵，因为是自信之作，\n能得到夸奖\n我很开心。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "29/TALK",
            "narrator": "透明神楽",
            "text": "ガブちゃんも、\n気に入ってくれましたか？",
            "zh": "加布酱也\n中意这幅画了吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "30/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ええ、とっても素敵で\n気に入ったわ。",
            "zh": "嗯，非常漂亮，\n我很中意。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "透明神楽",
            "text": "やった！",
            "zh": "太好了！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "33/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ただ…本当に着るなら、\nもう少し布が多い方が\nいいけど…。",
            "zh": "只是……真要穿的话，\n布料再多一点\n才好呀……。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "透明アーヤ",
            "text": "確かに布は少ないけど、\nこれはこれで可愛いと\n思うけど？",
            "zh": "布料是少了点，\n不过我觉得这样\n也挺可爱的呀？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そ、そうかしら？",
            "zh": "真、真是这样吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "透明神楽",
            "text": "粋な江戸っ子、って\n感じをイメージして\n描いたんですよ。",
            "zh": "我画的时候想的是\n“潇洒的江户子”\n那种感觉哦。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "38/TALK",
            "narrator": "透明神楽",
            "text": "それに、これくらい\nじゃないとお神輿は\n担げませんよ？",
            "zh": "再说了，不是\n这种打扮，神轿\n可扛不动哦？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "40/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そ、そうなんだ…。\n男の人は上半身裸で\n担いだりしてるものね。",
            "zh": "是、是呀……。\n男人扛神轿时\n都光着上半身呢。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そういえば、ふんどしも\n付けなきゃいけない、って\nアーヤが言ってたわ。",
            "zh": "说起来，绫水还说\n必须要配上\n兜裆布呢。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "透明アーヤ",
            "text": "そ、そのことは\n忘れていいから…。",
            "zh": "那、那件事\n你就忘了吧……。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "透明ガブリエラ",
            "text": "なんで？\nっていうか、この絵には\nふんどし描いてないの？",
            "zh": "为什么？\n话说，这幅画里\n没画兜裆布吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "透明神楽",
            "text": "ごめんなさい…。\nさすがに、それを描く\n勇気ありませんでした…。",
            "zh": "对不起……。\n那个东西我实在\n没勇气画出来……。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "46/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…？\nまあ、これはこれで\n可愛いからいいけどね。",
            "zh": "……？\n嘛，这样也有\n这样的可爱，就随它吧。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "47/SEL",
            "narrator": "（選択肢）",
            "text": "おへそ可愛い！",
            "zh": "肚脐好可爱！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "48/SEL",
            "narrator": "（選択肢）",
            "text": "ハッピガブリエラ、可愛いね",
            "zh": "穿短褂的加布里埃拉，真可爱",
            "narrator_zh": "（选项）"
        },
        {
            "location": "49/ACT",
            "narrator": "",
            "text": "おへそ可愛い！",
            "zh": "肚脐好可爱！",
            "narrator_zh": ""
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナ！",
            "zh": "玛尔赞娜！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "57/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうところ見たらダメよ！",
            "zh": "那种地方是不可以看的哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "見えてはいるけど",
            "zh": "虽然看得到",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "ジッと見るのは",
            "zh": "但一直盯着看",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "失礼よ",
            "zh": "是很失礼的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/SEL",
            "narrator": "（選択肢）",
            "text": "あまりにも可愛くて",
            "zh": "实在是太可爱了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "62/SEL",
            "narrator": "（選択肢）",
            "text": "失礼だったかな？",
            "zh": "是不是失礼了？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "63/ACT",
            "narrator": "",
            "text": "あまりにも可愛くて",
            "zh": "实在是太可爱了",
            "narrator_zh": ""
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "だからって見ないの",
            "zh": "就算这样也不许看呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "絵の中の私だけど",
            "zh": "虽然只是画里的我",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "恥ずかしくなってくるわ",
            "zh": "还是会害羞起来呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/ACT",
            "narrator": "",
            "text": "失礼だったかな？",
            "zh": "是不是失礼了？",
            "narrator_zh": ""
        },
        {
            "location": "69/TALK",
            "narrator": "ガブリエラ",
            "text": "服を褒めずにおへそ褒めるとか",
            "zh": "不夸衣服却去夸肚脐",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "レディに対する態度ではないわ",
            "zh": "可不是对待淑女的态度",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "まずは服を見なさいよ",
            "zh": "先好好看看衣服呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "服を見なさいよ",
            "zh": "看看衣服呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/ACT",
            "narrator": "",
            "text": "ハッピガブリエラ、可愛いね",
            "zh": "穿短褂的加布里埃拉，真可爱",
            "narrator_zh": ""
        },
        {
            "location": "81/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと",
            "zh": "谢谢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽は本当に絵が上手",
            "zh": "神乐真的画画很棒",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと元気なかったけど",
            "zh": "虽然之前有点没精神",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "この絵のおかげで",
            "zh": "多亏这幅画",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "元気出たわ",
            "zh": "我打起精神了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/SEL",
            "narrator": "（選択肢）",
            "text": "元気なかったの？",
            "zh": "你之前没精神吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "88/ACT",
            "narrator": "",
            "text": "元気なかったの？",
            "zh": "你之前没精神吗？",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "花火の写真を見てたら",
            "zh": "看烟花照片的时候",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと",
            "zh": "有点",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "ホームシックになっちゃったの",
            "zh": "想家了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "ハッキリ言わないけど",
            "zh": "虽然她没明说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "私のこと",
            "zh": "但应该是为了让我",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "元気づけるために描いてくれたみたい",
            "zh": "打起精神才画的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "お祭りといえば浴衣かと思ったけど",
            "zh": "还以为说到祭典就是浴衣呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "こういうスタイルもいいわね",
            "zh": "这种打扮也不赖呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "101/TALK",
            "narrator": "ガブリエラ",
            "text": "今度お祭り行く時は",
            "zh": "下次去祭典的时候",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "ハッピで参加しようかしら？",
            "zh": "要不要穿短褂去参加呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/SEL",
            "narrator": "（選択肢）",
            "text": "かっこいいと思うよ",
            "zh": "我觉得很帅气哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "105/SEL",
            "narrator": "（選択肢）",
            "text": "サラシは過激だからシャツを着よう",
            "zh": "缠胸布太大胆了，还是穿件衬衫吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "106/ACT",
            "narrator": "",
            "text": "一度付けてもいいかもね",
            "zh": "偶尔穿一次也许不错呢",
            "narrator_zh": ""
        },
        {
            "location": "107/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナもそう思う？",
            "zh": "玛尔赞娜你也这么觉得？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "浴衣は素敵だけど",
            "zh": "浴衣是很漂亮",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "ハッピはかっこいい",
            "zh": "但短褂更帅气",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "ガブリエラ",
            "text": "そう思うでしょ？",
            "zh": "你也这么觉得吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "111/ACT",
            "narrator": "",
            "text": "サラシは過激だからシャツを着よう",
            "zh": "缠胸布太大胆了，还是穿件衬衫吧",
            "narrator_zh": ""
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "そうかしら？",
            "zh": "是那样吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "結構気に入ってるんだけど",
            "zh": "我倒是挺中意的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "かっこいいでしょ//////",
            "zh": "很帅气吧//////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/SEL",
            "narrator": "（選択肢）",
            "text": "かっこいいとは思うよ",
            "zh": "帅气是挺帅气的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "116/SEL",
            "narrator": "（選択肢）",
            "text": "ちょっと目のやり場に困る…",
            "zh": "有点不知道该往哪看……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "117/ACT",
            "narrator": "",
            "text": "かっこいいとは思うよ",
            "zh": "帅气是挺帅气的",
            "narrator_zh": ""
        },
        {
            "location": "118/TALK",
            "narrator": "ガブリエラ",
            "text": "でしょ？",
            "zh": "对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "それにハッピ着てる女の人は",
            "zh": "再说穿短褂的女人",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/TALK",
            "narrator": "ガブリエラ",
            "text": "みんなこの格好なんだから",
            "zh": "都是这身打扮",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "121/TALK",
            "narrator": "ガブリエラ",
            "text": "一人だけ違ったら変だもの",
            "zh": "就我一个人不一样会很怪的呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/ACT",
            "narrator": "",
            "text": "ちょっと目のやり場に困る…",
            "zh": "有点不知道该往哪看……",
            "narrator_zh": ""
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "そうかしら？",
            "zh": "是那样吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "言われたら",
            "zh": "被你这么一说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと恥ずかしくなってきたかも////////",
            "zh": "是有点害羞起来了////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり着てみたいわ",
