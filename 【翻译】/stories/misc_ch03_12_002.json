        },
        {
            "location": "148/TALK",
            "narrator": "ガブリエラ",
            "text": "日本の情報は入ってきてたのにね",
            "zh": "日本的消息倒是传得到",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "150/SEL",
            "narrator": "",
            "text": "そうなの？",
            "zh": "是吗？",
            "narrator_zh": ""
        },
