{
    "dir": "chap28/daydra/dd_ch03_28_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "28305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "蝶々のささやき＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "蝴蝶的低语＜后篇＞"
    },
    "entry": [
        {
            "location": "473/SCENARIO",
            "narrator": "",
            "text": "波紋の終結",
            "zh": "波纹的终结",
            "narrator_zh": ""
        },
        {
            "location": "496/TALK",
            "narrator": "ガブリエラ",
            "text": "いけない、あたしったら\nデリカシーのない事ばかり\n聞いちゃって！",
            "zh": "糟糕，我真是的，\n净问些没有分寸的\n事情！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "497/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤを励ましてって\n頼まれてたのに。\nこれじゃ逆効果だわ。",
            "zh": "明明拜托了我\n要鼓励绫水的。\n这样不就适得其反了嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "498/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと\n落ち着かなくちゃ。",
            "zh": "得稍微\n冷静一下才行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "499/TALK",
            "narrator": "ガブリエラ",
            "text": "ア、アーヤもすごい\n大変な中、頑張って\nきたのね。ビックリだわ！",
            "zh": "绫、绫水你也在那么\n辛苦的环境里，一直\n努力过来了呢。真是吓了一跳！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "500/TALK",
            "narrator": "アーヤ",
            "text": "まあ、そんな\n大げさに言われる程\n大変でもないけどね…。",
            "zh": "嘛，倒也没到\n需要被说得那么夸张的\n程度就是了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "501/TALK",
            "narrator": "アーヤ",
            "text": "でも確かに、\nあの時の事件が無ければ\n全然違ったとは思うわね。",
            "zh": "不过确实，\n要是没有那时候的事件，\n一切大概都会截然不同吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "502/TALK",
            "narrator": "ガブリエラ",
            "text": "あの時の事件…って…？",
            "zh": "那时候的事件……是指……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "503/TALK",
            "narrator": "アーヤ",
            "text": "父は次男でね。\nこの家を継ぐか\nどうかで揉めたのよ。",
            "zh": "我父亲是次子呢。\n当年为了要不要继承\n这个家，闹得很僵。",
            "narrator_zh": "绫水"
        },
        {
            "location": "504/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなの？",
            "zh": "这样啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "506/TALK",
            "narrator": "アーヤ",
            "text": "國政家はどうも\n第一子が自由奔放に\n育つみたいで。",
            "zh": "国政家似乎总是\n长子长女会养成\n自由奔放的性格。",
            "narrator_zh": "绫水"
        },
        {
            "location": "507/TALK",
            "narrator": "アーヤ",
            "text": "業を煮やした祖父が\n長男には継がせないって\n宣言して。",
            "zh": "忍无可忍的祖父\n宣布绝不让长男\n继承家业。",
            "narrator_zh": "绫水"
        },
        {
            "location": "508/TALK",
            "narrator": "アーヤ",
            "text": "次男にお鉢が回って来たん\nだけど、父は既に婿養子に\n入るって話が出てて。",
            "zh": "于是担子就落到了\n次男头上，可父亲当时已经\n在谈入赘女方的事了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "509/TALK",
            "narrator": "アーヤ",
            "text": "結局私の父が神社を\n継ぐことで決着したけど。",
            "zh": "最后还是由我父亲\n继承神社，才算平息了下来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "510/TALK",
            "narrator": "アーヤ",
            "text": "その話し合いの結果次第\nでは、私は國政綾水では\nなかったかもしれないの。",
            "zh": "要是那场商议的结果\n稍有不同，我说不定就不会\n姓国政、不叫国政绫水了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "511/TALK",
            "narrator": "アーヤ",
            "text": "まあ、そもそも\n家の事情も変わるし、\n生まれてないかもだけど。",
            "zh": "嘛，本来家里情况\n也会跟着变，说不定我\n根本就不会出生呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "512/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん。もしお父様が\n婿養子？になってたら、\nどんな名前になってたの？",
            "zh": "唔嗯。要是你父亲\n真的入赘了的话，\n你会叫什么名字呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "513/TALK",
            "narrator": "アーヤ",
            "text": "結城綾水？\n母方の名字が\n結城だから。",
            "zh": "结城绫水？\n因为母亲娘家\n姓结城。",
            "narrator_zh": "绫水"
        },
        {
            "location": "514/TALK",
            "narrator": "アーヤ",
            "text": "まあ、名前も\n変わってたかも\nしれないけど。",
            "zh": "嘛，名字说不定\n也会跟着\n改掉就是了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "515/TALK",
            "narrator": "ガブリエラ",
            "text": "そうだったのね。",
            "zh": "原来是这样啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "517/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、ゆーきあやみって\nなんかちょっと\n響きがオシャレかも。",
            "zh": "不过，「结城绫水」这名字\n念起来总觉得\n有点时髦呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "518/TALK",
            "narrator": "アーヤ",
            "text": "そう？\n私にはよく\nわからないけど。",
            "zh": "是吗？\n我自己倒是\n不太懂啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "519/TALK",
            "narrator": "アーヤ",
            "text": "しかもね。長男に\n継がせないって話も\n理由がひどくて。",
            "zh": "而且啊，不让长男\n继承家业的理由，\n也真是离谱得很。",
            "narrator_zh": "绫水"
        },
        {
            "location": "520/TALK",
            "narrator": "アーヤ",
            "text": "５分遅刻したんだって。\nすごく重要な祭事に。\n祭主を任されてたのに。",
            "zh": "听说他迟到了5分钟。\n而且是在非常重要的祭典上，\n明明被委任了祭主一职。",
            "narrator_zh": "绫水"
        },
        {
            "location": "521/TALK",
            "narrator": "アーヤ",
            "text": "きっとそれ以前の\n色々が積み重なっての\nことだろうけど。",
            "zh": "当然，想必也是之前\n积累了种种不满，才终于\n爆发出来的吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "523/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあその日、アーヤの\nお父さんのお兄さんが、\n５分早く着いてたら…。",
            "zh": "那如果那天，绫水\n爸爸的哥哥\n早到5分钟的话……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "524/TALK",
            "narrator": "アーヤ",
            "text": "私は結城の人間だったかも\nしれないし、生まれて\nなかったかもしれない。",
            "zh": "我说不定就成了结城家的人，\n甚至说不定根本\n不会出生在这个世上。",
            "narrator_zh": "绫水"
        },
        {
            "location": "525/SEL",
            "narrator": "",
            "text": "バタフライエフェクトだ",
            "zh": "这就是蝴蝶效应啊",
            "narrator_zh": ""
        },
        {
            "location": "526/SEL",
            "narrator": "",
            "text": "何故かわからないけど今$me$は感極まっている",
            "zh": "不知为何我现在$me$感动得不行",
            "narrator_zh": ""
        },
        {
            "location": "527/ACT",
            "narrator": "",
            "text": "バタフライエフェクトだ",
            "zh": "这就是蝴蝶效应啊",
            "narrator_zh": ""
        },
        {
            "location": "545/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "546/TALK",
            "narrator": "ガブリエラ",
            "text": "本当にそう",
            "zh": "真的是这样",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "547/ACT",
            "narrator": "",
            "text": "何故かわからないけど今$me$は感極まっている",
            "zh": "不知为何我现在$me$感动得不行",
            "narrator_zh": ""
        },
        {
            "location": "565/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ！？！？",
            "zh": "诶诶！？！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "567/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしちゃったの！？",
            "zh": "你怎么了！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "568/TALK",
            "narrator": "ガブリエラ",
            "text": "今アーヤ、何か感動的な話をしたかしら",
            "zh": "刚才绫水有说什么感人的话吗",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "569/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、私にとってはちょっとだけ感動的だったけど//",
            "zh": "不对，对我来说倒是确实有一点感人啦//",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "570/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$も共感してくれたのかしらね？",
            "zh": "难道$marzanna$也产生共鸣了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "583/TALK",
            "narrator": "アーヤ",
            "text": "神社の娘に生まれる\nこともなくて\n霊の怖さも知らなくて。",
            "zh": "我不会生在\n神社之家，也不会知道\n幽灵有多可怕。",
            "narrator_zh": "绫水"
        },
        {
            "location": "584/TALK",
            "narrator": "アーヤ",
            "text": "跡継ぎ問題で\n悩んだりもしない\n普通の家で育って。",
            "zh": "也不会为了继承权问题\n而烦恼，而是在\n普通的家庭里长大。",
            "narrator_zh": "绫水"
        },
        {
            "location": "585/TALK",
            "narrator": "アーヤ",
            "text": "トライナリーになって\nなくて、剣道もして\nなかったかもしれない。",
            "zh": "说不定既不会成为三重奏，\n也不会去学\n剑道了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "587/TALK",
            "narrator": "ガブリエラ",
            "text": "そしたら、あたしとも\n逢えなかったわね。",
            "zh": "那那样的话，也就\n遇不到我了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "588/TALK",
            "narrator": "アーヤ",
            "text": "そうねー。",
            "zh": "是呀—。",
            "narrator_zh": "绫水"
        },
        {
            "location": "590/TALK",
            "narrator": "アーヤ",
            "text": "…それはそれで、\n寂しいわね。",
            "zh": "……那样的话，\n也挺寂寞的呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "591/TALK",
            "narrator": "ガブリエラ",
            "text": "何か言った？",
            "zh": "你刚才说什么了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "596/TALK",
            "narrator": "アーヤ",
            "text": "いいえ？　何も。",
            "zh": "没有哦？　什么都没说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "598/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤには悪いけど…\nお父様のお兄さんに\n感謝だわね。",
            "zh": "虽然对绫水有点过意不去……\n但我还真是得感谢\n你伯父呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "601/TALK",
            "narrator": "アーヤ",
            "text": "何か言った？",
            "zh": "你刚才说什么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "605/TALK",
            "narrator": "ガブリエラ",
            "text": "いいえ？　何も。",
            "zh": "没有哦？　什么都没说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "606/TALK",
            "narrator": "アーヤ",
            "text": "……ありがと、ギャヴィ。",
            "zh": "……谢谢你，加维。",
            "narrator_zh": "绫水"
        },
        {
            "location": "609/TALK",
            "narrator": "アーヤ",
            "text": "色々話をしてたら、\nちょっと元気が\n出てきたわ。",
            "zh": "跟你聊了这么多，\n我稍微打起\n点精神了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "610/TALK",
            "narrator": "アーヤ",
            "text": "本当のことを言うとね。",
            "zh": "说实话呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "611/TALK",
            "narrator": "アーヤ",
            "text": "姉と会えないって\nわかってすごく\nがっかりしたの。",
            "zh": "知道见不到姐姐的时候，\n我心里真的\n非常失落。",
            "narrator_zh": "绫水"
        },
        {
            "location": "612/TALK",
            "narrator": "アーヤ",
            "text": "自分でもびっくりしたけど\n少しだけ泣いたの。",
            "zh": "连我自己都吓了一跳，\n还稍微哭了一下呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "613/TALK",
            "narrator": "アーヤ",
            "text": "だけどギャヴィと\n話してて気持ちの整理が\nついたみたい。",
            "zh": "不过和加维聊过之后，\n心情好像就\n整理好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "614/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィがいてくれて\nよかったわ。",
            "zh": "有加维在\n真是太好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "617/TALK",
            "narrator": "ガブリエラ",
            "text": "…べ、別に……\nあたし何も……。",
            "zh": "……才、才没有……\n我又没做什么……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "618/SEL",
            "narrator": "",
            "text": "結果オーライだ",
            "zh": "结果圆满就好",
            "narrator_zh": ""
        },
        {
            "location": "619/SEL",
            "narrator": "",
            "text": "一件落着かな",
            "zh": "算是告一段落了吧",
            "narrator_zh": ""
        },
        {
            "location": "620/SEL",
            "narrator": "",
            "text": "盛大なるツンデレ合戦！",
            "zh": "盛大的傲娇大战！",
            "narrator_zh": ""
        },
        {
            "location": "621/ACT",
            "narrator": "",
            "text": "結果オーライだ",
            "zh": "结果圆满就好",
            "narrator_zh": ""
        },
        {
            "location": "639/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "640/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤが泣いたなんて",
            "zh": "虽然绫水居然哭了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "641/TALK",
            "narrator": "ガブリエラ",
            "text": "少し意外だけど",
            "zh": "有点出乎意料就是了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "642/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな一面もあるのね",
            "zh": "原来她也有那样的一面啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "643/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな面が見れるなんて",
            "zh": "能看到她那样的一面",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "644/TALK",
            "narrator": "ガブリエラ",
            "text": "役得かもしれないわｖｖｖ",
            "zh": "说不定还算意外的收获呢ｖｖｖ",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "645/ACT",
            "narrator": "",
            "text": "一件落着かな",
            "zh": "算是告一段落了吧",
            "narrator_zh": ""
        },
        {
            "location": "663/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうことね",
            "zh": "就是这么回事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "664/TALK",
            "narrator": "ガブリエラ",
            "text": "よかったわ",
            "zh": "真是太好了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "665/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に",
            "zh": "真的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "666/ACT",
            "narrator": "",
            "text": "盛大なるツンデレ合戦！",
            "zh": "盛大的傲娇大战！",
            "narrator_zh": ""
        },
        {
            "location": "684/TALK",
            "narrator": "ガブリエラ",
            "text": "あんまり",
            "zh": "别老是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "685/TALK",
            "narrator": "ガブリエラ",
            "text": "からかわないで////////",
            "zh": "拿人家打趣啦////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "686/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "687/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとうｖｖｖ",
            "zh": "谢谢你ｖｖｖ",
            "narrator_zh": "加布里埃拉"
