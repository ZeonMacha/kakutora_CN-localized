        "title": "Extra007 ヒメゴトチャット",
        "sub_title": "マカロンをどうぞ",
        "title_zh": "Extra007 秘语聊天",
        "sub_title_zh": "请用马卡龙"
    },
    "entry": [
        {
            "location": "1337/SCENARIO",
            "narrator": "",
            "text": "マカロンをどうぞ",
            "zh": "请用马卡龙",
            "narrator_zh": ""
        },
        {
            "location": "1362/TALK",
            "narrator": "神楽",
            "text": "マカロンとババロアは作りたくない",
            "zh": "马卡龙和芭芭露亚，我不想做",
            "narrator_zh": "神乐"
        },
        {
            "location": "1363/TALK",
            "narrator": "神楽",
            "text": "この二つは最高難易度を誇るお菓子たちだから",
            "zh": "这两种是号称最高难度的点心",
            "narrator_zh": "神乐"
        },
        {
            "location": "1365/SEL",
            "narrator": "",
            "text": "そうなんだ？",
            "zh": "是这样吗？",
            "narrator_zh": ""
        },
        {
            "location": "1366/SEL",
            "narrator": "",
            "text": "じゃあ$me$がプレゼントするね",
            "zh": "那$me$送你吧",
            "narrator_zh": ""
        },
        {
            "location": "1367/SEL",
            "narrator": "",
            "text": "えー作ってよー",
            "zh": "诶——做嘛——",
            "narrator_zh": ""
        },
        {
            "location": "1368/ACT",
            "narrator": "",
            "text": "そうなんだ？",
            "zh": "是这样吗？",
            "narrator_zh": ""
        },
        {
            "location": "1369/TALK",
            "narrator": "神楽",
            "text": "厳密な温度管理と湿度管理が必要だから",
            "zh": "因为需要严格的温度和湿度管理",
            "narrator_zh": "神乐"
        },
        {
            "location": "1370/ACT",
            "narrator": "",
            "text": "じゃあ$me$がプレゼントするね",
            "zh": "那$me$送你吧",
            "narrator_zh": ""
        },
        {
            "location": "1372/TALK",
            "narrator": "神楽",
            "text": "えっ！！！！",
            "zh": "诶！！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1374/TALK",
            "narrator": "神楽",
            "text": "やだ…やさしい…",
            "zh": "讨厌……好温柔……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1375/TALK",
            "narrator": "神楽",
            "text": "絶対にちょうだいね！！！！",
            "zh": "一定要给我！！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1376/ACT",
            "narrator": "",
            "text": "えー作ってよー",
            "zh": "诶——做嘛——",
            "narrator_zh": ""
        },
        {
            "location": "1377/TALK",
            "narrator": "神楽",
            "text": "却下",
            "zh": "驳回",
            "narrator_zh": "神乐"
        },
        {
            "location": "1388/TALK",
            "narrator": "神楽",
            "text": "そういうものはプロが作ったものを買うのが一番いい",
            "zh": "那种东西，买专业的人做的最好",
            "narrator_zh": "神乐"
        },
        {
            "location": "1390/TALK",
            "narrator": "神楽",
            "text": "愛情こもった不味いお菓子よりプロの技の美味しいお菓子こそが正義",
            "zh": "比起倾注了爱的难吃点心，专业手艺的好吃点心才是正义",
            "narrator_zh": "神乐"
        },
        {
            "location": "1392/SEL",
            "narrator": "",
            "text": "そ、そうだね…",
            "zh": "也、也是呢……",
            "narrator_zh": ""
        },
        {
            "location": "1393/SEL",
            "narrator": "",
            "text": "隙があるのが家庭料理のよさ",
            "zh": "有破绽才是家常菜的好处",
            "narrator_zh": ""
        },
        {
            "location": "1394/SEL",
            "narrator": "",
            "text": "神楽のプロ意識格好いい",
            "zh": "神乐的专业意识好帅",
            "narrator_zh": ""
        },
        {
            "location": "1395/ACT",
            "narrator": "",
            "text": "そ、そうだね…",
            "zh": "也、也是呢……",
            "narrator_zh": ""
        },
        {
            "location": "1396/TALK",
            "narrator": "神楽",
            "text": "そこで引くタイプかー",
            "zh": "是会在这里退缩的类型啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "1397/ACT",
            "narrator": "",
            "text": "隙があるのが家庭料理のよさ",
            "zh": "有破绽才是家常菜的好处",
            "narrator_zh": ""
        },
        {
            "location": "1398/TALK",
            "narrator": "神楽",
            "text": "それって真理",
            "zh": "这是真理",
            "narrator_zh": "神乐"
        },
        {
            "location": "1399/ACT",
            "narrator": "",
            "text": "神楽のプロ意識格好いい",
            "zh": "神乐的专业意识好帅",
            "narrator_zh": ""
        },
        {
            "location": "1401/TALK",
            "narrator": "神楽",
            "text": "当たり前のことを言ってるだけなんだけどね",
            "zh": "我只是在说理所当然的事",
            "narrator_zh": "神乐"
        },
        {
            "location": "1402/TALK",
            "narrator": "神楽",
            "text": "プロじゃない人にはあんまりわかってもらえない部分だったり",
            "zh": "对不是专业的人来说，有些地方不太能懂",
            "narrator_zh": "神乐"
        },
        {
            "location": "1404/TALK",
            "narrator": "神楽",
            "text": "マカロンは季節ごとに限定フレーバーも出るから楽しい",
            "zh": "马卡龙每个季节都出限定口味，很有趣",
            "narrator_zh": "神乐"
        },
        {
            "location": "1405/TALK",
            "narrator": "神楽",
            "text": "ショーケースの中のマカロンって宝石みたいだし",
            "zh": "橱窗里的马卡龙也像宝石一样",
            "narrator_zh": "神乐"
        },
        {
            "location": "1406/TALK",
            "narrator": "神楽",
            "text": "味が好きかって聞かれたら実はそうでもないんだけど",
            "zh": "要问我喜不喜欢那个味道，其实也没那么喜欢",
            "narrator_zh": "神乐"
        },
        {
            "location": "1407/TALK",
            "narrator": "神楽",
            "text": "それでも買っちゃう魅力があるって逆にすごいと思う",
            "zh": "即便如此还是会买，这种魅力反过来也很厉害",
            "narrator_zh": "神乐"
        }
    ]
}
