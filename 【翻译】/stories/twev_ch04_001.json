{
    "dir": "chap00/daydra/twev_ch04_001.js",
    "type": "",
    "info": {
        "story_id": "31131",
        "cid": "",
        "title": "Twitter Archive 008",
        "sub_title": "卯月画廊：うとうとお風呂",
        "title_zh": "推特 存档 008",
        "sub_title_zh": "卯月画廊：昏昏欲睡的洗澡"
    },
    "entry": [
        {
            "location": "149/TALK",
            "narrator": "透明みやび",
            "text": "きゃーえっちー。\n卯月がうちの入浴現場\n盗撮しよったー。",
            "zh": "呀——好色哦——。\n卯月把我洗澡的现场\n偷拍下来了呀——",
            "narrator_zh": "透明雅"
        },
        {
            "location": "151/TALK",
            "narrator": "透明神楽",
            "text": "ちょ！？　みやびさん！\n誤解されるようなこと\n言わないでください！",
            "zh": "等！？　雅小姐！\n请不要说些\n会让人误会的话！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "152/TALK",
            "narrator": "透明みやび",
            "text": "いやー、卯月の絵は\n上手やき、つい写真と\n見間違うてしまったがよ。",
            "zh": "哎呀——，卯月的画\n画得太好啵，\n一不小心看成照片了咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "154/TALK",
            "narrator": "透明みやび",
            "text": "とまあ、冗談はさておき。\n何故にうちの入浴中の\n絵をアップしたん？",
            "zh": "好了，玩笑放一边。\n为什么把我泡澡中的\n画上传了咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "155/TALK",
            "narrator": "透明神楽",
            "text": "それはですね、\nみやびさんが入浴剤を\n使ったからです。",
            "zh": "这是因为，\n雅小姐用了\n那款入浴剂呀。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "156/TALK",
            "narrator": "透明みやび",
            "text": "？",
            "zh": "？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "157/TALK",
            "narrator": "透明神楽",
            "text": "あの入浴剤には、\n私の呪いがかけて\nあるんですよ。",
            "zh": "那款入浴剂上，\n可是加了我的\n诅咒的哦。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "158/TALK",
            "narrator": "透明みやび",
            "text": "ほほぅ、呪い？\n入浴シーンがネット公開\nされる呪いとかか？",
            "zh": "哦哦——，诅咒？\n难道是洗澡画面会被\n传上网的诅咒咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "159/TALK",
            "narrator": "透明神楽",
            "text": "近いけど、ハズレです。",
            "zh": "很接近了，但猜错了。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "162/TALK",
            "narrator": "透明神楽",
            "text": "あの入浴剤にかけられた\n呪いというのは、\n透視です！",
            "zh": "加在那款入浴剂上的\n诅咒，\n就是透视！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "164/TALK",
            "narrator": "透明みやび",
            "text": "透視？\n風呂場のか？",
            "zh": "透视？\n浴室里的那个咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "165/TALK",
            "narrator": "透明神楽",
            "text": "そんなの、呪いじゃ\nなくてもできるじゃ\nないですか。",
            "zh": "那种事，就算没有\n诅咒不也照样\n做得到嘛。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "167/TALK",
            "narrator": "透明神楽",
            "text": "私が透視するのは、\n使用者の妄想です。",
            "zh": "我透视的，\n是使用者的妄想。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "168/TALK",
            "narrator": "透明神楽",
            "text": "そして、その透視した\n妄想を描いたものこそ、\nこの絵なんです。",
            "zh": "而把透视到的妄想\n画下来的东西，\n正是这幅画。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "169/TALK",
            "narrator": "透明みやび",
            "text": "…マジか。",
            "zh": "……真的咩。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "170/TALK",
            "narrator": "透明神楽",
            "text": "大マジです。",
            "zh": "千真万确。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "171/TALK",
            "narrator": "透明みやび",
            "text": "うち、妄想じゃなくて\nまっこと風呂で爆睡してた\nんやけんど…。",
            "zh": "我可不是在妄想，\n我是货真价实在浴缸里\n睡死过去了但是……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "172/TALK",
            "narrator": "透明神楽",
            "text": "…リアルでお風呂で\n寝るのは、ちょっと\n危ないと思いますよ？",
            "zh": "……在现实中泡着澡\n睡觉，我觉得\n有点危险哦？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "174/TALK",
            "narrator": "透明みやび",
            "text": "溺れたとしたら、\nそれも卯月の呪いちや。",
            "zh": "要是淹死了，\n那也是卯月的诅咒滴。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "175/TALK",
            "narrator": "透明神楽",
            "text": "そんな呪いかけませんし、\nかけられません！",
            "zh": "那种诅咒我不会下，\n也不会中！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "176/SEL",
            "narrator": "（選択肢）",
            "text": "お風呂で寝たら危ないよ！",
            "zh": "在浴缸里睡觉很危险哦！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "177/ACT",
            "narrator": "",
            "text": "お風呂で寝たら危ないよ！",
            "zh": "在浴缸里睡觉很危险哦！",
            "narrator_zh": ""
        },
        {
            "location": "185/TALK",
            "narrator": "みやび",
            "text": "危険だが",
            "zh": "危险归危险",
            "narrator_zh": "雅"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "気持ちいいのだ",
            "zh": "舒服也是真舒服",
            "narrator_zh": "雅"
        },
        {
            "location": "188/TALK",
            "narrator": "みやび",
            "text": "故にやめられない",
            "zh": "所以停不下来",
            "narrator_zh": "雅"
        },
        {
            "location": "189/SEL",
            "narrator": "（選択肢）",
            "text": "わからなくもないけどね",
            "zh": "也不是不能理解呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "190/SEL",
            "narrator": "（選択肢）",
            "text": "溺れないか心配だ",
            "zh": "我担心你会溺水",
            "narrator_zh": "（选项）"
        },
        {
            "location": "191/ACT",
            "narrator": "",
            "text": "わからなくもないけどね",
            "zh": "也不是不能理解呢",
            "narrator_zh": ""
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "さすがは相棒",
            "zh": "不愧是搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "もしや",
            "zh": "莫非",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "経験あるな？",
            "zh": "你有过经验？",
            "narrator_zh": "雅"
        },
        {
            "location": "195/SEL",
            "narrator": "（選択肢）",
            "text": "バレたか",
            "zh": "被发现了呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "196/SEL",
            "narrator": "（選択肢）",
            "text": "ないよ",
            "zh": "没有哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "197/ACT",
            "narrator": "",
            "text": "バレたか",
            "zh": "被发现了呀",
            "narrator_zh": ""
        },
        {
            "location": "198/TALK",
            "narrator": "みやび",
            "text": "理解ある時点で",
            "zh": "你流露出理解的那一刻",
            "narrator_zh": "雅"
        },
        {
            "location": "200/TALK",
            "narrator": "みやび",
            "text": "経験ありと感じた",
            "zh": "我就觉得你有经验",
            "narrator_zh": "雅"
        },
        {
            "location": "201/TALK",
            "narrator": "みやび",
            "text": "同士よ！",
            "zh": "是同类呀！",
            "narrator_zh": "雅"
        },
        {
            "location": "202/ACT",
            "narrator": "",
            "text": "ないよ",
            "zh": "没有哦",
            "narrator_zh": ""
        },
        {
            "location": "203/TALK",
            "narrator": "みやび",
            "text": "ないのにわかるのか",
            "zh": "没经历过却懂吗",
            "narrator_zh": "雅"
        },
        {
            "location": "204/TALK",
            "narrator": "みやび",
            "text": "理解力があるせいか",
            "zh": "是理解力太好的缘故吗",
            "narrator_zh": "雅"
        },
        {
            "location": "205/TALK",
            "narrator": "みやび",
            "text": "それとも",
            "zh": "还是说",
            "narrator_zh": "雅"
        },
        {
            "location": "206/TALK",
            "narrator": "みやび",
            "text": "適当に言っただけなのか",
            "zh": "只是随口说说呢",
            "narrator_zh": "雅"
        },
        {
            "location": "207/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "どちらでも構わんが",
            "zh": "哪个都无所谓就是了",
            "narrator_zh": "雅"
        },
        {
            "location": "210/ACT",
            "narrator": "",
            "text": "溺れないか心配だ",
            "zh": "我担心你会溺水",
            "narrator_zh": ""
        },
        {
            "location": "211/TALK",
            "narrator": "みやび",
            "text": "心配してくれるなら",
            "zh": "既然你这么担心",
            "narrator_zh": "雅"
        },
        {
            "location": "212/TALK",
            "narrator": "みやび",
            "text": "見張りをやってほしいぞね",
            "zh": "就希望你帮我望风咧",
            "narrator_zh": "雅"
        },
        {
            "location": "214/TALK",
            "narrator": "みやび",
            "text": "それなら",
            "zh": "那样的话",
            "narrator_zh": "雅"
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "爆睡しても怖くない",
            "zh": "睡死了也不怕",
            "narrator_zh": "雅"
        },
        {
            "location": "216/SEL",
            "narrator": "（選択肢）",
            "text": "眠い時はシャワーにして",
            "zh": "困的时候就用淋浴吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "217/SEL",
            "narrator": "（選択肢）",
            "text": "胸ばかり目がいきそう…",
            "zh": "眼睛总忍不住往胸上看……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "218/ACT",
            "narrator": "",
            "text": "眠い時はシャワーにして",
            "zh": "困的时候就用淋浴吧",
            "narrator_zh": ""
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "眠い時の風呂こそ",
            "zh": "犯困的时候泡澡",
            "narrator_zh": "雅"
        },
        {
            "location": "220/TALK",
            "narrator": "みやび",
            "text": "最高なのだがね",
            "zh": "那才叫最棒的呀",
            "narrator_zh": "雅"
        },
        {
            "location": "221/ACT",
            "narrator": "",
            "text": "胸ばかり目がいきそう…",
            "zh": "眼睛总忍不住往胸上看……",
            "narrator_zh": ""
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "顔を見てほしい",
            "zh": "给我看脸呀",
            "narrator_zh": "雅"
        },
        {
            "location": "224/TALK",
            "narrator": "みやび",
            "text": "胸は浮くが",
            "zh": "胸会浮起来",
            "narrator_zh": "雅"
        },
        {
            "location": "225/TALK",
            "narrator": "みやび",
            "text": "顔は沈むのだ",
            "zh": "但脸是往下沉的",
            "narrator_zh": "雅"
        },
        {
            "location": "228/TALK",
            "narrator": "みやび",
            "text": "しかし",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "229/TALK",
            "narrator": "みやび",
            "text": "あの入浴剤は",
            "zh": "那款入浴剂",
            "narrator_zh": "雅"
        },
        {
            "location": "230/TALK",
            "narrator": "みやび",
            "text": "とても気持ちよかった",
            "zh": "泡得实在舒服",
            "narrator_zh": "雅"
        },
        {
            "location": "231/TALK",
            "narrator": "みやび",
            "text": "また入れたいぞね",
            "zh": "还想再放一次咧",
            "narrator_zh": "雅"
        },
        {
            "location": "232/TALK",
            "narrator": "みやび",
            "text": "今日も入れるか",
            "zh": "今天就再放一包啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "233/SEL",
            "narrator": "（選択肢）",
            "text": "また呪いで透視されるよ？",
            "zh": "又会被诅咒透视哦？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "234/SEL",
            "narrator": "（選択肢）",
            "text": "また寝ちゃうよ？",
            "zh": "又会睡着的哦？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "235/ACT",
            "narrator": "",
            "text": "また呪いで透視されるよ？",
            "zh": "又会被诅咒透视哦？",
            "narrator_zh": ""
        },
        {
            "location": "236/TALK",
            "narrator": "みやび",
            "text": "それを期待している",
            "zh": "我正期待着呢",
            "narrator_zh": "雅"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "今度はもっと",
            "zh": "下次啊",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "みやび",
            "text": "普段思うてる妄想",
            "zh": "把我平时想着的妄想",
            "narrator_zh": "雅"
        },
        {
            "location": "240/TALK",
            "narrator": "みやび",
            "text": "ちゃんと透視して描いてほしいのだ",
            "zh": "好好透视清楚画出来才行",
            "narrator_zh": "雅"
        },
        {
            "location": "241/SEL",
            "narrator": "（選択肢）",
            "text": "どんな妄想してるの？",
            "zh": "你都在妄想什么呀？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "242/ACT",
            "narrator": "",
            "text": "どんな妄想してるの？",
            "zh": "你都在妄想什么呀？",
            "narrator_zh": ""
        },
        {
            "location": "244/TALK",
            "narrator": "みやび",
            "text": "トップシークレット",
            "zh": "最高机密",
            "narrator_zh": "雅"
        },
        {
            "location": "245/TALK",
            "narrator": "みやび",
            "text": "相棒に言うのは",
            "zh": "对搭档说这个",
            "narrator_zh": "雅"
        },
        {
            "location": "246/TALK",
            "narrator": "みやび",
            "text": "照れるからな",
            "zh": "会害羞的嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "247/ACT",
            "narrator": "",
            "text": "また寝ちゃうよ？",
            "zh": "又会睡着的哦？",
            "narrator_zh": ""
        },
        {
            "location": "248/TALK",
            "narrator": "みやび",
            "text": "それもよかろう",
            "zh": "那也无妨",
            "narrator_zh": "雅"
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "風呂で寝ると",
            "zh": "在浴缸里睡觉这件事",
            "narrator_zh": "雅"
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "相棒も知ったのだし",
            "zh": "搭档你也已经知道了",
            "narrator_zh": "雅"
        },
        {
            "location": "251/TALK",
            "narrator": "みやび",
            "text": "もし寝ても",
            "zh": "就算睡着了",
            "narrator_zh": "雅"
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "相棒が起こしてくれると期待している",
            "zh": "我期待着搭档会叫醒我",
            "narrator_zh": "雅"
        },
        {
            "location": "254/TALK",
            "narrator": "みやび",
            "text": "とりあえず",
            "zh": "总之",
            "narrator_zh": "雅"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "今度呪いかける時は",
            "zh": "下次下诅咒的时候",
            "narrator_zh": "雅"
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "透視ではなく",
            "zh": "别透视了",
            "narrator_zh": "雅"
        },
        {
            "location": "258/TALK",
            "narrator": "みやび",
            "text": "胸が小さくなる呪いを希望する",
            "zh": "给我来个胸变小的诅咒",
            "narrator_zh": "雅"
        },
        {
            "location": "259/TALK",
            "narrator": "みやび",
            "text": "そう言っておくぞね",
            "zh": "先把话放这儿咧",
            "narrator_zh": "雅"
        },
        {
            "location": "265/DIALOG",
            "narrator": "",
            "text": "このシナリオの元になっている\nTwitterの会話ログを見ますか？",
            "zh": "要查看这个剧本\n取材的Twitter对话日志吗？",
            "narrator_zh": ""
        }
    ]
}
