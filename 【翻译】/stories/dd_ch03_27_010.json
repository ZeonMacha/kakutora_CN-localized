{
    "dir": "chap27/daydra/dd_ch03_27_010.js",
    "type": "",
    "info": {
        "story_id": "50004",
        "cid": "",
        "title": "SideStory004 ストーリー",
        "sub_title": "FILE03.試行",
        "title_zh": "SideStory004 剧情",
        "sub_title_zh": "FILE03.试行"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "東京編３話",
            "zh": "东京篇 第3话",
            "narrator_zh": ""
        },
        {
            "location": "19/DIALOG",
            "narrator": "",
            "text": "<color=green>9月4日　 0:21 PM</color>\nとある日曜、某所にて。",
            "zh": "<color=green>9月4日　 0:21 PM</color>\n某个周日，于某处。",
            "narrator_zh": ""
        },
        {
            "location": "20/TALK",
            "narrator": "キリト",
            "text": "はぁ…小夜さんに聞いても\nわからなかったな…。",
            "zh": "唉……就算问了小夜\n还是没头绪啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "22/TALK",
            "narrator": "キリト",
            "text": "もう、他に行き先知ってる\nような奴、いないだろ？",
            "zh": "已经没有其他知道\n她们去向的家伙了吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "23/TALK",
            "narrator": "雛",
            "text": "うーん…綾水先輩の\n実家じゃないとしたら、\nみやび先輩の実家とかは？",
            "zh": "唔……要不是去绫水前辈\n老家的话，\n会不会是雅前辈老家之类的？",
            "narrator_zh": "雏"
        },
        {
            "location": "25/TALK",
            "narrator": "繭",
            "text": "絶対に行ってない。",
            "zh": "绝对没去。",
            "narrator_zh": "茧"
        },
        {
            "location": "27/TALK",
            "narrator": "キリト",
            "text": "なんでわかるんだよ？",
            "zh": "你怎么知道的？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "30/TALK",
            "narrator": "繭",
            "text": "みやび先輩の実家にある\nスパコン、操作された\n形跡なかったから。",
            "zh": "因为雅前辈老家里的\n超级计算机，没有被操作过的\n痕迹。",
            "narrator_zh": "茧"
        },
        {
            "location": "31/TALK",
            "narrator": "繭",
            "text": "…さっき、\nアクセスして調べた。",
            "zh": "……刚才，\n我入侵查过了。",
            "narrator_zh": "茧"
        },
        {
            "location": "35/TALK",
            "narrator": "キリト",
            "text": "なるほど。\nみやび先輩だったら\n絶対触ってるはずだよな。",
            "zh": "原来如此。\n要是雅前辈在的话\n肯定会去碰的吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "36/TALK",
            "narrator": "ヒカル",
            "text": "ガブリエラさんの\n実家はポーランドだから\n除外して…。",
            "zh": "加布里埃拉的\n老家在波兰，所以\n先排除……。",
            "narrator_zh": "光"
        },
        {
            "location": "37/TALK",
            "narrator": "キリト",
            "text": "じゃ、逢瀬の実家は？",
            "zh": "那，逢濑的老家呢？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "39/TALK",
            "narrator": "ヒカル",
            "text": "逢瀬さんが捕まってるの\n家族にバレちゃうから、\n行かないと思うよ。",
            "zh": "逢濑被抓走的事\n会暴露给家人的，\n我觉得她不会去哦。",
            "narrator_zh": "光"
        },
        {
            "location": "40/TALK",
            "narrator": "雛",
            "text": "…みんな、どこに\n行っちゃったのかな？",
            "zh": "……大家，到底\n去哪里了呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "44/TALK",
            "narrator": "キリト",
            "text": "あっ。",
            "zh": "啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "45/TALK",
            "narrator": "繭",
            "text": "…緊張感のないヤツ。",
            "zh": "……毫无紧张感的家伙。",
            "narrator_zh": "茧"
        },
        {
            "location": "47/TALK",
            "narrator": "キリト",
            "text": "あ、頭使うと\n腹が減るんだよ。",
            "zh": "因、因为动脑筋\n肚子就会饿嘛。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "49/TALK",
            "narrator": "ヒカル",
            "text": "そういえば、\nちょっとお腹空いて\nきたよね？",
            "zh": "说起来，\n是稍微有点\n饿了呢？",
            "narrator_zh": "光"
        },
        {
            "location": "50/TALK",
            "narrator": "キリト",
            "text": "だろ？",
            "zh": "对吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "51/TALK",
            "narrator": "キリト",
            "text": "俺、ちょっとコンビニに\n買い出し行ってくる。",
            "zh": "我去一趟便利店\n买点东西回来。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "52/TALK",
            "narrator": "キリト",
            "text": "みんなはここで\nなにかいい案ないか\n考えててくれよ。",
            "zh": "大家留在这里\n再想想看有没有\n什么好主意吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "53/TALK",
            "narrator": "繭",
            "text": "サンドイッチとエクレア。\nホットのミルクティーで。",
            "zh": "三明治和闪电泡芙。\n再来杯热奶茶。",
            "narrator_zh": "茧"
        },
        {
            "location": "54/TALK",
            "narrator": "キリト",
            "text": "ＷＡＶＥの方に\n送ってくれよ。",
            "zh": "发到我 WAVE 上\n去啦。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "55/TALK",
            "narrator": "キリト",
            "text": "じゃあ、ちょっと\n行ってくる。",
            "zh": "那我先\n去去就回。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "68/TALK",
            "narrator": "キリト",
            "text": "…で？\nどうしてひなこまで\n来てるんだよ？",
            "zh": "……所以？\n怎么连雏子也\n跟过来了？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "70/TALK",
            "narrator": "雛",
            "text": "ちょっと脳みそクリアに\nしたいなー、って\n思ってねー。",
            "zh": "我想着稍微让脑子\n清醒一下嘛—\n就这样。",
            "narrator_zh": "雏"
        },
        {
            "location": "72/TALK",
            "narrator": "キリト",
            "text": "…そうだな。",
            "zh": "……说得也是。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "73/TALK",
            "narrator": "キリト",
            "text": "適度な気分転換しなきゃ、\nいい案なんて\n浮かぶはずないし。",
            "zh": "不适当转换一下心情的话，\n好主意也是\n冒不出来的。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "74/TALK",
            "narrator": "雛",
            "text": "そーゆーこと。",
            "zh": "就是这么回事。",
            "narrator_zh": "雏"
        },
        {
            "location": "75/TALK",
            "narrator": "雛",
            "text": "…それに、ちょっと\nキリトに聞きたいことも\nあったし。",
            "zh": "……而且，我也有点\n想问圣翔的事\n嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "77/TALK",
            "narrator": "キリト",
            "text": "なんだ、\n聞きたいことって？",
            "zh": "怎么了，\n想问什么事？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "79/TALK",
            "narrator": "雛",
            "text": "連絡が取れなかった間の\nことだよ。",
            "zh": "就是之前联系不上你们\n那段时间的事呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "80/TALK",
            "narrator": "雛",
            "text": "何日も連絡もしないで、\nどこでなにやってたの？",
            "zh": "好几天都不联系，\n你们到底在哪里干什么呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "81/TALK",
            "narrator": "キリト",
            "text": "なにしてたって…、\nほとんどなにもして\nなかったんだけどな…。",
            "zh": "干什么呢……\n其实几乎什么都\n没干啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "83/TALK",
            "narrator": "キリト",
            "text": "テレビもスマホも\nネットもない専用の\n官舎に呼ばれてさ。",
            "zh": "被叫去了一栋既没电视\n也没手机没网络的专用\n官舍里。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "84/TALK",
            "narrator": "キリト",
            "text": "出撃命令が下るまで\n部隊丸ごとただそこで\n待機せよ、だったし…。",
            "zh": "命令就是“在出击命令下达前\n整支部队就在那里\n待命”……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "86/TALK",
            "narrator": "キリト",
            "text": "だからまあ、ずーっと\n暇つぶしにヒカルと\n話してたなぁ…。",
            "zh": "所以嘛，我就一直\n找光聊天\n消磨时间啦……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "88/TALK",
            "narrator": "雛",
            "text": "…そうだったんだ。",
            "zh": "……原来是这样啊。",
            "narrator_zh": "雏"
        },
        {
            "location": "90/TALK",
            "narrator": "キリト",
            "text": "せめてスマホがあれば\nマシだったんだけど…。",
            "zh": "要是好歹有手机在手\n还能好过点……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "91/TALK",
            "narrator": "キリト",
            "text": "マジで暇と退屈で\n地獄みたいな数日間\nだったぜ…。",
            "zh": "真是闲得无聊透顶，\n简直像地狱一样的\n好几天啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "93/TALK",
            "narrator": "雛",
            "text": "もぅ、暇とか退屈とか\n言わないでよー。",
            "zh": "真是的，别说什么闲啊\n无聊啊之类的嘛—。",
            "narrator_zh": "雏"
        },
        {
            "location": "94/TALK",
            "narrator": "雛",
            "text": "こっちは本当に\n心配してたんだからね？",
            "zh": "我们这边可是真的\n很担心你们好吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "96/TALK",
            "narrator": "キリト",
            "text": "冗談だって。\nわりぃわりぃ。",
            "zh": "开玩笑的啦。\n抱歉抱歉。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "98/TALK",
            "narrator": "雛",
            "text": "まったく…。",
            "zh": "真是的……。",
            "narrator_zh": "雏"
        },
        {
            "location": "99/TALK",
            "narrator": "キリト",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "100/TALK",
            "narrator": "キリト",
            "text": "しっかし、スゴイな…。\nヒカルの予想\n的中じゃねぇか…。",
            "zh": "不过，真厉害啊……。\n光的预测\n居然全中啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "102/TALK",
            "narrator": "雛",
            "text": "なんの話？",
            "zh": "说什么呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "103/TALK",
            "narrator": "キリト",
            "text": "待機任務中、\nずっとヒカルと話してた\nって言っただろ？",
            "zh": "我刚才不是说待命期间，\n一直在跟光聊天\n吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "104/TALK",
            "narrator": "キリト",
            "text": "その時にあいつ、\n言ってたんだよ。",
            "zh": "那时候那家伙，\n就这么说过。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "105/TALK",
            "narrator": "キリト",
            "text": "自分たちと連絡が\n取れなくなって…。",
            "zh": "说自己这帮人\n突然断了联系……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "106/TALK",
            "narrator": "キリト",
            "text": "ひなこ達が心配してるに\n違いない、ってさ。",
            "zh": "雏子她们肯定\n担心坏了，这么说的。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "107/TALK",
            "narrator": "雛",
            "text": "ふーん…キリトは、\nそう思わなかったの？",
            "zh": "嗯—……圣翔你，\n没这么觉得吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "108/TALK",
            "narrator": "キリト",
            "text": "たかが数日で心配なんか\nされない、って\n思ってたぞ？",
            "zh": "我还以为区区几天而已\n才不会被担心\n呢。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "109/TALK",
            "narrator": "雛",
            "text": "…キリトらしいというか、\nなんというか…。",
            "zh": "……该说真像圣翔呢，\n还是怎么说好呢……。",
            "narrator_zh": "雏"
        },
        {
            "location": "110/TALK",
            "narrator": "キリト",
            "text": "けど、ヒカルはさ、\nひなこは絶対に\n心配してるはずだ、って。",
            "zh": "但是啊，光他就说，\n雏子绝对\n在担心着呢。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "111/TALK",
            "narrator": "キリト",
            "text": "だから、どうにかして\n外部と連絡取りたいって、\n言っててな…。",
            "zh": "所以还一直念叨着，\n得想办法跟外面\n取得联系才行……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "113/TALK",
            "narrator": "雛",
            "text": "そっかぁ…。",
            "zh": "这样啊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "114/TALK",
            "narrator": "雛",
            "text": "やっぱり、ヒカル君は\nさすがだなぁ…。",
            "zh": "果然，还是光\n最靠得住啊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "115/TALK",
            "narrator": "雛",
            "text": "…それに比べて、\nキリトは相変わらずって\nいうか…。",
            "zh": "……相比之下，\n圣翔就还是一如既往\n该怎么说呢……。",
            "narrator_zh": "雏"
        },
        {
            "location": "116/TALK",
            "narrator": "キリト",
            "text": "相変わらずって…、\n数日で変わったり\nなんかしねぇよ。",
            "zh": "什么叫一如既往……\n才几天时间哪会\n轻易就变了啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "117/TALK",
            "narrator": "雛",
            "text": "…そっか。",
            "zh": "……这样啊。",
            "narrator_zh": "雏"
        },
        {
            "location": "118/TALK",
            "narrator": "雛",
            "text": "よかった…。\nそれ聞いて、ちょっと\n安心したかもー。",
            "zh": "太好了……。\n听到你这么说，稍微\n安心了一点呢—。",
            "narrator_zh": "雏"
        },
        {
            "location": "119/TALK",
            "narrator": "キリト",
            "text": "なんでだ？",
            "zh": "为啥啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "120/TALK",
            "narrator": "雛",
            "text": "キリトがキリトのままで\nいてくれてるからだよー。",
            "zh": "因为圣翔还是那个圣翔，\n一点都没变呀—。",
            "narrator_zh": "雏"
        },
        {
            "location": "121/TALK",
            "narrator": "キリト",
            "text": "そりゃそうだろ。\n俺がヒカルになったりする\nはずないんだからな。",
            "zh": "那当然啦。\n我又不可能突然变成\n光那样的家伙。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "122/TALK",
            "narrator": "雛",
            "text": "あたしの言ってること\n全然理解してないっぽい\nけど…。",
            "zh": "虽然你好像完全没听懂\n我在说什么的样子\n……。",
            "narrator_zh": "雏"
        },
        {
            "location": "123/TALK",
            "narrator": "雛",
            "text": "むしろそこに安心した。\nいいよ、キリト。\n最高だね！",
            "zh": "不如说正因如此才安心呢。\n很好哦，圣翔。\n太棒了！",
            "narrator_zh": "雏"
        },
        {
            "location": "124/TALK",
            "narrator": "キリト",
            "text": "褒められてる気が\n全然しねぇなぁ…。",
            "zh": "总觉得完全不像是在\n夸我啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "126/TALK",
            "narrator": "キリト",
            "text": "…ん？",
            "zh": "……嗯？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "137/TALK",
            "narrator": "雛",
            "text": "どうしたの、キリト？",
            "zh": "怎么了，圣翔？",
            "narrator_zh": "雏"
        },
        {
            "location": "138/TALK",
            "narrator": "キリト",
            "text": "いや、これって…。",
            "zh": "不是，这个是……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "140/TALK",
            "narrator": "雛",
            "text": "？　掲示板じゃん。\nほら、地域のイベントの\nお知らせとか貼るやつ。",
            "zh": "？ 这不就是公告栏嘛。\n就是用来贴社区活动\n通知之类的那个。",
            "narrator_zh": "雏"
        },
        {
            "location": "141/TALK",
            "narrator": "雛",
            "text": "これがどうかしたの？",
            "zh": "这怎么了吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "142/TALK",
            "narrator": "キリト",
            "text": "…そうか。",
            "zh": "……原来如此。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "143/TALK",
            "narrator": "キリト",
            "text": "これだ！\nこれなら、綾水先輩達と\n連絡取れるかもしれない！",
            "zh": "就是这个！\n用这个的话，说不定就能\n联系上绫水前辈她们了！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "145/TALK",
            "narrator": "雛",
            "text": "えっ！？",
