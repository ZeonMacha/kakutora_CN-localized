{
    "dir": "chap05/daydra/dd_ch02_05_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "5202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "劇場の日常＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "剧场的日常＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "幽霊の出る指令本部",
            "zh": "闹鬼的指挥部",
            "narrator_zh": ""
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "状況完了。\nこれより帰還します。",
            "zh": "情况结束。\n这就返航。",
            "narrator_zh": "绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "真幌",
            "text": "了解。\n任務ご苦労だった。",
            "zh": "了解。\n任务辛苦了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "45/TALK",
            "narrator": "アーヤ",
            "text": "さてと、\n顔バレする前に\n劇場に戻りましょ。",
            "zh": "那么，\n在露脸之前\n回剧场吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうかさー、\n顔バレ対策なのは\nわかるけど――",
            "zh": "话说，\n防露脸这点\n我懂——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "指令室が場末の\n映画館、って、\n納得いかなくない？",
            "zh": "指挥室是偏僻的\n电影院，这点\n没法接受吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "50/TALK",
            "narrator": "アーヤ",
            "text": "まあ、館長の趣味も\n多少入ってるとは\n思うから――",
            "zh": "嘛，馆长的兴趣\n也掺了一点进去，\n我想——",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "アーヤ",
            "text": "そっとしておいた\n方がいいと思うわ。\nさ、行きましょ。",
            "zh": "还是别去碰\n比较好。\n走吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "みやび",
            "text": "…まあ、まほさんの\n趣味でも、隠れ蓑と\nしては最高やね。",
            "zh": "……嘛，真幌的\n兴趣也好，当掩护\n是最好的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "トライナリーの\nアジトがこんな\nレトロな劇場とは――",
            "zh": "三重奏的\n据点居然是这么\n复古的剧场——",
            "narrator_zh": "雅"
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "誰も、夢にも\n思わんやろ。",
            "zh": "谁也做梦都\n想不到咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしだって、\n最初は冗談かと\n思ったわ。",
            "zh": "我一开始\n也以为是\n开玩笑。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "アーヤ",
            "text": "私達がそう思えるなら\nこれからもバレる\n心配はなさそうね。",
            "zh": "我们都这么想的话，\n以后也不用担心\n暴露了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "真幌",
            "text": "三人とも、\nご苦労だったな。",
            "zh": "你们三个，\n辛苦了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "まったくよ。\n今日は本当に\n大変だったわ。",
            "zh": "可不是。\n今天真的\n很辛苦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "真幌",
            "text": "わかっている。\n劇場のスクリーンで\n見てたからな。",
            "zh": "我知道。\n在剧场银幕上\n看着的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "131/TALK",
            "narrator": "真幌",
            "text": "今回はイレギュラーな\nことも多かったが――",
            "zh": "这次突发的事\n也很多——",
            "narrator_zh": "真幌"
        },
        {
            "location": "132/TALK",
            "narrator": "真幌",
            "text": "そっちは管理庁の方で\n対応する。\nおまえ等は休め。",
            "zh": "那边由管理厅\n来应对。\n你们休息。",
            "narrator_zh": "真幌"
        },
        {
            "location": "135/TALK",
            "narrator": "アーヤ",
            "text": "わかりました。\nあ、でもバイトは\nどうします？",
            "zh": "知道了。\n啊，不过打工\n怎么办？",
            "narrator_zh": "绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "真幌",
            "text": "ん？　そういえば、\n今日も営業日\nだったか…。",
            "zh": "嗯？　这么说，\n今天也是\n营业日……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "140/TALK",
            "narrator": "真幌",
            "text": "まあ、どうせ客なんぞ\n来ないだろうし――",
            "zh": "嘛，反正客人\n也不会来——",
            "narrator_zh": "真幌"
        },
        {
            "location": "141/TALK",
            "narrator": "真幌",
            "text": "適当にやってるフリを\nしておいてくれ。",
            "zh": "随便装装样子\n就行。",
            "narrator_zh": "真幌"
        },
        {
            "location": "144/TALK",
            "narrator": "真幌",
            "text": "では、私は管理庁に\n報告書を置きに行く。\nあとは任せたぞ。",
            "zh": "那我去管理厅\n交报告。\n剩下的交给你们。",
            "narrator_zh": "真幌"
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "…映画館がアジト\nっちゅうのは\nえいとして――",
            "zh": "……电影院当据点\n这件事，\n要得，不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "150/TALK",
            "narrator": "みやび",
            "text": "実際に、うちらに\nバイトさせる\n必要あるか？",
            "zh": "真的有必要\n让我们来\n打工吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "アーヤ",
            "text": "はいはい、ぼやくのは\nそこまで。",
            "zh": "好好，抱怨\n到此为止。",
            "narrator_zh": "绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "アーヤ",
            "text": "もう劇場開ける時間\nだから、持ち場に\nついて。",
            "zh": "已经到开馆时间了，\n去自己的\n岗位。",
            "narrator_zh": "绫水"
        },
        {
            "location": "155/TALK",
            "narrator": "ガブリエラ",
            "text": "まだ早いわよ。\nもう少しのんびり\nしてもいいでしょ？",
            "zh": "还早呢。\n再悠闲一会儿\n也可以吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "158/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんに賛成。\n世界を救ったばかりの\nうちらには――",
            "zh": "赞成加布。\n刚拯救了世界的\n我们——",
            "narrator_zh": "雅"
        },
        {
            "location": "161/TALK",
            "narrator": "みやび",
            "text": "のんびり身体を休める\n権利があるがよ。",
            "zh": "有权利慢慢\n歇一歇咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "164/TALK",
            "narrator": "アーヤ",
            "text": "バイトも私達の\n仕事なんだから――",
            "zh": "打工也是我们的\n工作——",
            "narrator_zh": "绫水"
        },
        {
            "location": "166/TALK",
            "narrator": "アーヤ",
            "text": "文句言わずに\n持ち場について。",
            "zh": "别抱怨，\n去岗位上。",
            "narrator_zh": "绫水"
        },
        {
            "location": "167/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…アーヤって、\n本当カタブツよね…。",
            "zh": "哈啊……绫水，\n真是个死脑筋……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと、何よそれ？",
            "zh": "等等，什么意思？",
            "narrator_zh": "绫水"
        },
        {
            "location": "170/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな急がなくても、\nお客なんて来ない\nわよ。",
            "zh": "不用那么急，\n客人根本\n不会来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "171/TALK",
            "narrator": "みやび",
            "text": "客が来ないのに\n急ぐ必要なんぞ\nないちや。",
            "zh": "客人又不来，\n没必要\n急咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "早く開けて無理に\nバイトしよう\n思うんは――",
            "zh": "早早开门硬要\n去打工，\n这么想——",
            "narrator_zh": "雅"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "人生を無駄にするんも\n同然の行為ぞね。",
            "zh": "跟浪费人生\n也没什么两样啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "176/TALK",
            "narrator": "アーヤ",
            "text": "バイトだって\n仕事なんだから、\n責任感持ちなさいよ。",
            "zh": "打工也是\n工作，\n拿出责任心来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "178/TALK",
            "narrator": "みやび",
            "text": "うちの責任感は\n戦闘で使いつくして\nしもうたき――",
            "zh": "我的责任感\n在战斗里用光了\n啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "179/TALK",
            "narrator": "みやび",
            "text": "今はエンプティ状態で\nスッカラカンやぞ。",
            "zh": "现在空空的，\n一点不剩咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "180/TALK",
            "narrator": "アーヤ",
            "text": "あのね…。",
            "zh": "我说……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "181/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤはさ、\nあれよね？",
            "zh": "绫水啊，\n是那个吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "182/TALK",
            "narrator": "ガブリエラ",
            "text": "まほにとっての\nいい子でいたい、\nってだけでしょ？",
            "zh": "只是想当\n真幌眼里的\n好孩子吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "183/TALK",
            "narrator": "アーヤ",
            "text": "ちょ、何よそれ？\n私は別に…。",
            "zh": "等、什么意思？\n我才没有……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "185/TALK",
            "narrator": "みやび",
            "text": "いや、ガブちゃん。\nアーヤはそうでないと\nうちらが困るがよ。",
            "zh": "不对，加布。\n绫水不那样的话\n我们就麻烦咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "186/TALK",
            "narrator": "みやび",
            "text": "アーヤがえい子で\nいようと頑張って\nくれちょるき――",
            "zh": "绫水努力当个\n好孩子，\n啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "うちらが不真面目でも\n許されるがよ。",
            "zh": "我们不认真\n也能被原谅咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "188/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "189/TALK",
            "narrator": "アーヤ",
            "text": "全部が本気、って\nわけじゃないだろう\nけど――",
            "zh": "也不全是认真的，\n大概不是\n吧——",
            "narrator_zh": "绫水"
        },
        {
            "location": "190/TALK",
            "narrator": "アーヤ",
            "text": "ある程度本音が\n混じってそうね…。",
            "zh": "好像掺了几分\n真心……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "そんな風に思われてた\nなんて…ちょっと\nショック…。",
            "zh": "居然被这么想……\n有点\n受打击……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/SEL",
            "narrator": "",
            "text": "先輩だしリーダーなんだから、ガツンと言ってやれ！",
            "zh": "你是前辈又是队长，狠狠说她们！",
            "narrator_zh": ""
        },
        {
            "location": "193/SEL",
            "narrator": "",
            "text": "このままだと嫌われちゃうね",
            "zh": "这样下去会被讨厌的",
            "narrator_zh": ""
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "…いい加減、劇場を\n開けないといけない\n時間なのに。",
            "zh": "……差不多，剧场\n该开门的\n时间了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "このままだと、\n館長にも怒られるの、\nわからないのかしら？",
            "zh": "这样下去，\n馆长也会生气，\n她们不明白吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "200/TALK",
            "narrator": "アーヤ",
            "text": "…困ったわ。",
            "zh": "……真难办。",
            "narrator_zh": "绫水"
        },
        {
            "location": "202/ACT",
            "narrator": "",
            "text": "先輩だしリーダーなんだから、ガツンと言ってやれ！",
            "zh": "你是前辈又是队长，狠狠说她们！",
            "narrator_zh": ""
        },
        {
            "location": "227/TALK",
            "narrator": "アーヤ",
            "text": "結構言ってるつもりなんだけど？",
            "zh": "我觉得已经说得不少了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "アーヤ",
            "text": "もっと言わないとダメ？",
            "zh": "还得再说重一点？",
            "narrator_zh": "绫水"
        },
        {
            "location": "229/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "绫水"
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "出撃の後なのは確かだし",
            "zh": "刚出击完是事实",
            "narrator_zh": "绫水"
        },
        {
            "location": "231/TALK",
            "narrator": "アーヤ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/TALK",
            "narrator": "アーヤ",
            "text": "あまり強く言ったら",
            "zh": "说得太重的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "233/TALK",
            "narrator": "アーヤ",
            "text": "嫌われちゃうかもしれないし",
            "zh": "也许会被讨厌",
            "narrator_zh": "绫水"
        },
        {
            "location": "244/ACT",
            "narrator": "",
            "text": "このままだと嫌われちゃうね",
            "zh": "这样下去会被讨厌的",
            "narrator_zh": ""
        },
        {
            "location": "269/TALK",
            "narrator": "アーヤ",
            "text": "なんか",
            "zh": "总觉得",
            "narrator_zh": "绫水"
        },
        {
            "location": "270/TALK",
            "narrator": "アーヤ",
            "text": "もう嫌われてるのかも",
            "zh": "也许已经被讨厌了",
            "narrator_zh": "绫水"
        },
        {
            "location": "271/TALK",
            "narrator": "アーヤ",
            "text": "館長の前でだけ",
            "zh": "好像只有在馆长面前",
            "narrator_zh": "绫水"
        },
        {
            "location": "272/TALK",
            "narrator": "アーヤ",
            "text": "いい子にしてると思われてるみたいだし",
            "zh": "才被当成好孩子",
            "narrator_zh": "绫水"
        },
        {
            "location": "284/TALK",
            "narrator": "アーヤ",
            "text": "もう時間がないのに、\nどうしよう…。",
            "zh": "已经没时间了，\n怎么办……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "330/TALK",
            "narrator": "アーヤ",
            "text": "あら、[ココロゲート]へ\nようこそ。\nお早いお着きね。",
            "zh": "哎呀，欢迎来到\n[心之扉]。\n来得真早。",
            "narrator_zh": "绫水"
        },
        {
            "location": "331/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさいね。\nまたココロにロックが\nかかっちゃったみたい。",
            "zh": "抱歉。\n心好像又\n锁上了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "332/TALK",
            "narrator": "アーヤ",
            "text": "早速その【問題の扉】を\n呼び出すわね。",
            "zh": "那就马上呼叫\n那扇【问题之门】。",
            "narrator_zh": "绫水"
        },
        {
            "location": "339/TALK",
            "narrator": "アーヤ",
            "text": "オープンプロセス、\n0x992番地から\n0x044番地へ。",
            "zh": "开放进程，\n从0x992地址\n到0x044地址。",
            "narrator_zh": "绫水"
        },
        {
            "location": "354/TALK",
            "narrator": "アーヤ",
            "text": "シーク完了。",
            "zh": "搜索完成。",
            "narrator_zh": "绫水"
        },
        {
            "location": "357/TALK",
            "narrator": "アーヤ",
            "text": "さて、今回の\nロックの原因は……？",
            "zh": "那么，这次\n上锁的原因是……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "358/TALK",
            "narrator": "アーヤ",
            "text": "…。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "359/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "360/TALK",
            "narrator": "アーヤ",
            "text": "なるほど。\n前回と大して変わらない\n理由なのね。",
            "zh": "原来如此。\n理由跟上回\n差不了多少。",
            "narrator_zh": "绫水"
        },
        {
            "location": "361/TALK",
            "narrator": "アーヤ",
            "text": "自分の事ながら\n苦笑するしかないわ。",
            "zh": "明明是自己的事，\n也只能苦笑。",
            "narrator_zh": "绫水"
        },
        {
            "location": "362/SEL",
            "narrator": "",
            "text": "なに？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "363/ACT",
            "narrator": "",
            "text": "なに？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "365/TALK",
            "narrator": "アーヤ",
            "text": "また体裁を気にする\n自分と、責務を果たす\n自分が葛藤してる。",
            "zh": "又是在意体面的自己，\n和要尽责的自己\n在挣扎。",
            "narrator_zh": "绫水"
        },
        {
            "location": "366/TALK",
            "narrator": "アーヤ",
            "text": "まあ今回の件は、\n現実世界で見たことが\n全てだと思うわよ？",
            "zh": "嘛，这次的事，\n在现实里看到的\n就是全部了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "367/SEL",
            "narrator": "",
            "text": "確かに",
            "zh": "确实",
            "narrator_zh": ""
        },
        {
            "location": "368/ACT",
            "narrator": "",
            "text": "確かに",
            "zh": "确实",
            "narrator_zh": ""
        },
        {
            "location": "370/TALK",
            "narrator": "アーヤ",
            "text": "こんな不甲斐ない\n私ですけど、また\n協力してくれないかしら。",
            "zh": "这么不中用的\n我，还能再\n帮我一次吗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "371/SEL",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "372/SEL",
            "narrator": "",
            "text": "人とはそういう生き物",
            "zh": "人就是这样的生物",
            "narrator_zh": ""
        },
        {
            "location": "373/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "374/TALK",
            "narrator": "アーヤ",
            "text": "ふふ、ありがと。\n恩にきるわ。",
            "zh": "呵呵，谢谢。\n承你的情。",
            "narrator_zh": "绫水"
        },
        {
            "location": "375/ACT",
            "narrator": "",
            "text": "人とはそういう生き物",
            "zh": "人就是这样的生物",
            "narrator_zh": ""
        },
        {
            "location": "376/TALK",
            "narrator": "アーヤ",
            "text": "そうね、ホントに。",
            "zh": "是啊，真的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "377/TALK",
            "narrator": "アーヤ",
            "text": "何が正しいって\n自分でわかってるのに、\nそれを選択できない。",
            "zh": "明明自己知道\n什么是对的，\n却选不了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "378/TALK",
            "narrator": "アーヤ",
            "text": "自分にとって正しい選択を\n阻止する[クラン]は、\n誰の心にもいるものね。",
            "zh": "阻止自己做出正确选择的\n[库兰]，\n谁的心里都有。",
            "narrator_zh": "绫水"
        },
        {
            "location": "380/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、この扉のこと\n宜しくお願いします。",
            "zh": "那么，这扇门\n就拜托了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "382/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！",
            "zh": "献给$handle$和\n国政绫水的，\n美妙的心灵之旅！",
            "narrator_zh": "绫水"
        },
        {
            "location": "36/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月3日　7:22 PM</color>\nFreyMENOWライブ戦でのフェノメノン収束直後、現場にて。",
            "zh": "<color=green>5月3日　7:22 PM</color>\nFreyMENOW现场战的PhenoMENON刚平息，现场。",
