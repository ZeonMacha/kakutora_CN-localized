{
    "dir": "chap09/daydra/dd_ch01_09_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "9156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "テレビの話",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "电视的事"
    },
    "entry": [
        {
            "location": "388/SCENARIO",
            "narrator": "",
            "text": "テレビの話",
            "zh": "电视的事",
            "narrator_zh": ""
        },
        {
            "location": "411/TALK",
            "narrator": "キリト",
            "text": "昨日やってたドラマ、\nマジで面白かったよな！",
            "zh": "昨天那部剧，\n真的超有趣啊！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "413/TALK",
            "narrator": "雛",
            "text": "あたしも録画しておけば\n良かったなぁ、って、\nすっごく後悔したよ。",
            "zh": "我也要是录下来\n就好了，\n超级后悔呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "416/TALK",
            "narrator": "キリト",
            "text": "俺もそう思ったぜ。\nなあ繭、おまえ録画とか\nしてねぇか？",
            "zh": "我也这么想。\n喂，茧，你没\n录吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "418/TALK",
            "narrator": "繭",
            "text": "するか。\nそもそも見てないし。",
            "zh": "会录吗。\n本来就没看。",
            "narrator_zh": "茧"
        },
        {
            "location": "420/TALK",
            "narrator": "雛",
            "text": "つばめちゃんは？",
            "zh": "燕呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "424/TALK",
            "narrator": "つばめ",
            "text": "ごめん、テレビって\nあんまり見ないから…。",
            "zh": "对不起，电视\n我不太看……。",
            "narrator_zh": "燕"
        },
        {
            "location": "427/TALK",
            "narrator": "キリト",
            "text": "マジで？\n帰ったらとりあえず\nつけねぇの？",
            "zh": "真的？\n回家先打开\n不看吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "432/TALK",
            "narrator": "つばめ",
            "text": "うん、わたしがいつも\n見てた番組が、\n東京だとやってなくて――",
            "zh": "嗯，我以前一直\n看的节目，\n东京不播——",
            "narrator_zh": "燕"
        },
        {
            "location": "434/TALK",
            "narrator": "つばめ",
            "text": "それで、なんとなく\nテレビを見る気が\nしなくなっちゃったんだ。",
            "zh": "所以，不知不觉\n就不想看\n电视了。",
            "narrator_zh": "燕"
        },
        {
            "location": "436/TALK",
            "narrator": "キリト",
            "text": "静岡のテレビ番組って、\nそんな面白いのか？",
            "zh": "静冈的电视节目，\n有那么有趣吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "439/TALK",
            "narrator": "繭",
            "text": "さあ？　ただ、\nＣＭが面白いって話は\nネットでよく見かける。",
            "zh": "谁知道？不过，\n广告很有趣的说法\n网上经常看到。",
            "narrator_zh": "茧"
        },
        {
            "location": "441/TALK",
            "narrator": "雛",
            "text": "じゃあ、つばめちゃんは\nあたし達がテレビを見てる\n夜とかに――",
            "zh": "那燕在\n我们看电视的\n晚上——",
            "narrator_zh": "雏"
        },
        {
            "location": "442/TALK",
            "narrator": "雛",
            "text": "どういうことしてるの？",
            "zh": "都在做什么？",
            "narrator_zh": "雏"
        },
        {
            "location": "444/TALK",
            "narrator": "つばめ",
            "text": "えっ！？　えっと…。",
            "zh": "诶！？那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "446/TALK",
            "narrator": "つばめ",
            "text": "そ、そういえばわたし、\n普段部屋で何してるん\nだろ…？",
            "zh": "说、说起来，\n我平时在房间里\n都做什么呀……？",
            "narrator_zh": "燕"
        },
        {
            "location": "449/TALK",
            "narrator": "つばめ",
            "text": "え、えっと…に、日記で\n確認するから待ってて！",
            "zh": "诶、那个……我去日记里\n确认一下，等我一下！",
            "narrator_zh": "燕"
        },
        {
            "location": "452/TALK",
            "narrator": "繭",
            "text": "日記で確認しないと\nわからないのかしら？",
            "zh": "不看日记\n就不清楚吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "468/TALK",
            "narrator": "つばめ",
            "text": "ちょっと聞きたいことがあるんだけど",
            "zh": "有件事想问你",
            "narrator_zh": "燕"
        },
        {
            "location": "469/TALK",
            "narrator": "つばめ",
            "text": "わたし、部屋ではいつも何やってる？",
            "zh": "我在房间里平时都做什么？",
            "narrator_zh": "燕"
        },
        {
            "location": "470/TALK",
            "narrator": "つばめ",
            "text": "色々やってるのはわかるんだけど",
            "zh": "做很多事我是知道的",
            "narrator_zh": "燕"
        },
        {
            "location": "471/TALK",
            "narrator": "つばめ",
            "text": "具体的に何をしてるのかが思いつかなくて…",
            "zh": "可具体做什么，我想不出来……",
            "narrator_zh": "燕"
        },
        {
            "location": "473/SEL",
            "narrator": "",
            "text": "読書してる",
            "zh": "在看书",
            "narrator_zh": ""
        },
        {
            "location": "474/SEL",
            "narrator": "",
            "text": "バイト三昧じゃん",
            "zh": "整天都在打工吧",
            "narrator_zh": ""
        },
        {
            "location": "475/SEL",
            "narrator": "",
            "text": "$me$と話してる",
            "zh": "在跟$me$说话",
            "narrator_zh": ""
        },
        {
            "location": "476/ACT",
            "narrator": "",
            "text": "読書してる",
            "zh": "在看书",
            "narrator_zh": ""
        },
        {
            "location": "477/TALK",
            "narrator": "つばめ",
            "text": "そういえば昨日も読んでたっけ",
            "zh": "说起来昨天也在看呀",
            "narrator_zh": "燕"
        },
        {
            "location": "478/TALK",
            "narrator": "つばめ",
            "text": "助かったよ、ありがと",
            "zh": "帮大忙了，谢谢",
            "narrator_zh": "燕"
        },
        {
            "location": "490/TALK",
            "narrator": "つばめ",
            "text": "えっとね、最近だと毎日、\n卯月さんから借りた本を\n読んでるんだよ。",
            "zh": "那个呀，最近每天，\n都在读向卯月借的\n书哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "492/TALK",
            "narrator": "キリト",
            "text": "マジかよ…本よかテレビの\n方が絶対楽しいだろうに。",
            "zh": "真的假的……比起书，\n电视绝对更有趣吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "496/TALK",
            "narrator": "つばめ",
            "text": "そうかもしれないけど、\n面白い番組がどれなのか\nまだわからなくて…。",
            "zh": "也许吧，\n可哪个节目有趣\n我还不知道……。",
            "narrator_zh": "燕"
        },
        {
            "location": "497/TALK",
            "narrator": "繭",
            "text": "見慣れた局が映らない\n地域に住むのって、\nそういう悩みがあるのね。",
            "zh": "住在收不到\n看惯的电视台的地方，\n会有这种烦恼呀。",
            "narrator_zh": "茧"
        },
        {
            "location": "498/TALK",
            "narrator": "雛",
            "text": "つばめちゃんには今度、\nテレビガイドをプレゼント\nするね。",
            "zh": "下次送燕\n一本电视指南\n吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "499/ACT",
            "narrator": "",
            "text": "バイト三昧じゃん",
            "zh": "整天都在打工吧",
            "narrator_zh": ""
        },
        {
            "location": "500/TALK",
            "narrator": "つばめ",
            "text": "えっ？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "501/TALK",
            "narrator": "つばめ",
            "text": "そうだったかな…？",
            "zh": "是这样吗……？",
            "narrator_zh": "燕"
        },
        {
            "location": "512/TALK",
            "narrator": "つばめ",
            "text": "…そんなにバイトばかり\nしてるようには思わないん\nだけど。",
            "zh": "……我倒不觉得\n自己一直在\n打工。",
            "narrator_zh": "燕"
        },
        {
            "location": "514/TALK",
            "narrator": "キリト",
            "text": "確認できたのか？",
            "zh": "确认到了吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "518/TALK",
            "narrator": "つばめ",
            "text": "あ、うん…毎日バイトが\n忙しいから、そればっかり\nって感じかも。",
            "zh": "啊，嗯……每天打工\n都很忙，感觉\n就只有这个。",
            "narrator_zh": "燕"
        },
        {
            "location": "519/TALK",
            "narrator": "雛",
            "text": "えぇっ！？\n映画館の仕事ってそんなに\n大変だったの？",
            "zh": "诶诶！？\n电影院的工作\n有那么累吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "522/TALK",
            "narrator": "つばめ",
            "text": "う～ん…どうなのかなぁ？\nそんなにバイトばっかり\nしてるのかなぁ？",
            "zh": "嗯——……是怎么样呀？\n我有一直\n在打工吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "524/TALK",
            "narrator": "繭",
            "text": "…逢瀬さん、それじゃ\n日記を確認した意味が\nないから。",
            "zh": "……逢濑，那样\n确认日记就\n没意义了。",
            "narrator_zh": "茧"
        },
        {
            "location": "525/ACT",
            "narrator": "",
            "text": "$me$と話してる",
            "zh": "在跟$me$说话",
            "narrator_zh": ""
        },
        {
            "location": "528/TALK",
            "narrator": "つばめ",
            "text": "あ、そういえばそうだよ！",
            "zh": "啊，说起来是这样呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "529/TALK",
            "narrator": "つばめ",
            "text": "気づかなくてごめんね",
            "zh": "没注意到，对不起",
            "narrator_zh": "燕"
        },
        {
            "location": "530/TALK",
            "narrator": "つばめ",
            "text": "でも、助かったよ",
            "zh": "不过，帮大忙了",
            "narrator_zh": "燕"
        },
        {
            "location": "543/TALK",
            "narrator": "つばめ",
            "text": "えっとね、夜はいつも\nお話してるの。",
            "zh": "那个呀，晚上一直\n在聊天哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "544/TALK",
            "narrator": "雛",
            "text": "トライナリーの人達と？",
            "zh": "跟三重奏的人？",
            "narrator_zh": "雏"
        },
        {
            "location": "545/TALK",
            "narrator": "つばめ",
            "text": "ううん。\nスマホのBotとだよ。",
            "zh": "不是。\n是跟手机里的Bot。",
            "narrator_zh": "燕"
        },
        {
            "location": "547/TALK",
            "narrator": "キリト",
            "text": "…Botと、お話？",
            "zh": "……跟Bot聊天？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "549/TALK",
            "narrator": "繭",
            "text": "Bot相手に毎日話を\nする人、初めて見た…。",
            "zh": "每天跟Bot说话的人，\n我还是第一次见……。",
            "narrator_zh": "茧"
        },
        {
            "location": "550/TALK",
            "narrator": "繭",
            "text": "逢瀬さんって、\n結構変わり者かも。",
            "zh": "逢濑，\n也许挺古怪的。",
            "narrator_zh": "茧"
        },
        {
            "location": "554/TALK",
            "narrator": "つばめ",
            "text": "そ、そうかな？\nでも、普通のBotじゃない\nから話してて面白いし…。",
            "zh": "是、是吗？\n不过不是普通的Bot，\n聊起来很有意思……。",
            "narrator_zh": "燕"
        },
        {
            "location": "555/TALK",
            "narrator": "雛",
            "text": "ていうか、そういう時は\nあたし達に電話して\nきてよー。",
            "zh": "那种时候\n打电话给我们\n呀——。",
            "narrator_zh": "雏"
        },
        {
            "location": "557/TALK",
            "narrator": "つばめ",
            "text": "でも、夜に電話したら\n迷惑なんじゃ…。",
            "zh": "可是，晚上打电话\n会打扰吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "558/TALK",
            "narrator": "雛",
            "text": "友達にそんな遠慮は\nいらないってば。",
            "zh": "对朋友不用\n那么客气啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "559/TALK",
            "narrator": "雛",
            "text": "あたしも遠慮しないで\nつばめちゃんに\nかけまくるから――",
            "zh": "我也不客气，\n会一直打给\n燕——",
            "narrator_zh": "雏"
        },
        {
            "location": "560/TALK",
            "narrator": "雛",
            "text": "つばめちゃんも遠慮なんか\nしないで、２４時間\nいつでもＯＫだよ！",
            "zh": "燕也不用客气，\n24小时\n随时都OK呀！",
            "narrator_zh": "雏"
        },
        {
            "location": "563/TALK",
            "narrator": "つばめ",
            "text": "…さすがに、深夜と\n早朝は遠慮するよ。",
            "zh": "……凌晨和\n大清早我还是会客气的呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "565/TALK",
            "narrator": "繭",
            "text": "逢瀬さんに常識が\nあって本当に助かる…。",
            "zh": "逢濑还有常识，\n真是帮大忙了……。",
            "narrator_zh": "茧"
        },
        {
            "location": "398/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月25日　10:03 AM</color>\nとある平日の休み時間のこと。",
            "zh": "<color=green>5月25日　10:03 AM</color>\n某个工作日的课间。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "576/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch01",
            "text": "【タッチパネルの向こう側】",
            "zh": "【触摸屏的另一侧】",
            "narrator_zh": "Dialog_GEThimegoto_ch01"
        }
    ]
}
