            "narrator": "みやび",
            "text": "$handle$よ",
            "zh": "$handle$啊",
            "narrator_zh": "雅"
        },
        {
            "location": "237/TALK",
            "narrator": "みやび",
            "text": "うちが同級生からゴミを見るような目で見られ、さらには罵られたことについては貴殿に責任がある",
            "zh": "我被同学用看垃圾的眼神看着，还挨了骂。这事责任在你",
            "narrator_zh": "雅"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "よって",
            "zh": "所以",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "みやび",
            "text": "責任とれ",
            "zh": "你来负责",
            "narrator_zh": "雅"
        },
        {
            "location": "242/SEL",
            "narrator": "",
            "text": "え",
            "zh": "诶",
            "narrator_zh": ""
        },
        {
            "location": "243/SEL",
            "narrator": "",
            "text": "なんでまた",
            "zh": "怎么又来",
            "narrator_zh": ""
        },
        {
            "location": "244/SEL",
            "narrator": "",
            "text": "覚えがないんだけど",
            "zh": "我没什么印象",
            "narrator_zh": ""
        },
        {
            "location": "245/ACT",
            "narrator": "",
            "text": "え",
            "zh": "诶",
            "narrator_zh": ""
        },
        {
            "location": "246/TALK",
            "narrator": "みやび",
            "text": "えではない",
            "zh": "不是诶",
            "narrator_zh": "雅"
        },
        {
            "location": "247/ACT",
            "narrator": "",
            "text": "なんでまた",
            "zh": "怎么又来",
            "narrator_zh": ""
        },
        {
            "location": "248/TALK",
            "narrator": "みやび",
            "text": "なんでかまた",
            "zh": "你问怎么又来？",
            "narrator_zh": "雅"
        },
        {
            "location": "249/ACT",
            "narrator": "",
            "text": "覚えがないんだけど",
            "zh": "我没什么印象",
            "narrator_zh": ""
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "そんなわけはなかろう",
            "zh": "没那种道理",
            "narrator_zh": "雅"
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "Botについて問うたら",
            "zh": "我一问Bot的事",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "そのような態度を取られたのだ",
            "zh": "就被那样对待了",
            "narrator_zh": "雅"
        },
        {
            "location": "254/SEL",
            "narrator": "",
            "text": "ちょっと待って",
            "zh": "等一下",
            "narrator_zh": ""
        },
        {
            "location": "255/TALK",
            "narrator": "みやび",
            "text": "これが貴殿の責任でなくて何であろう",
            "zh": "这不是你的责任，还能是什么",
            "narrator_zh": "雅"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "下手を打ったら国際紛争に発展する大問題ぞね",
            "zh": "处理不好，可是会闹成国际争端的啵",
            "narrator_zh": "雅"
