            "narrator_zh": "雅"
        },
        {
            "location": "266/TALK",
            "narrator": "みやび",
            "text": "Botについて聞いた",
            "zh": "问了Bot的事",
            "narrator_zh": "雅"
        },
        {
            "location": "269/SEL",
            "narrator": "",
            "text": "そこを詳しく",
            "zh": "那里说详细点",
            "narrator_zh": ""
        },
        {
            "location": "270/ACT",
            "narrator": "",
            "text": "そこを詳しく",
            "zh": "那里说详细点",
            "narrator_zh": ""
        },
        {
            "location": "277/TALK",
            "narrator": "みやび",
            "text": "WAVE廃人という噂の女生徒がいるというので",
            "zh": "听说有个女学生，传闻是个WAVE废人",
            "narrator_zh": "雅"
        },
        {
            "location": "278/TALK",
            "narrator": "みやび",
            "text": "廃人と言われるくらいWAVEをしているのならBotのことを知っちゅうろうと問いただしたら",
            "zh": "既然都废成这样还泡在WAVE里，Bot的事总该晓得，我这么一问",
            "narrator_zh": "雅"
        },
        {
            "location": "279/TALK",
            "narrator": "みやび",
            "text": "知らぬと答えおった",
            "zh": "她回答说不晓得",
            "narrator_zh": "雅"
        },
        {
            "location": "280/TALK",
            "narrator": "みやび",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "雅"
        },
        {
            "location": "281/TALK",
            "narrator": "みやび",
            "text": "WAVEのアドレス帳を見せろ、Botがいないかどうか判定してやると言ったのに拒否しおった",
            "zh": "我说把WAVE的通讯录交出来，我来判断有没有Bot，她却拒绝了",
            "narrator_zh": "雅"
        },
        {
            "location": "282/TALK",
            "narrator": "みやび",
            "text": "なので",
            "zh": "于是",
            "narrator_zh": "雅"
        },
        {
            "location": "283/TALK",
            "narrator": "みやび",
            "text": "ネットワークに介入してみたら",
            "zh": "我进到她的网络里一看",
            "narrator_zh": "雅"
        },
        {
            "location": "284/TALK",
            "narrator": "みやび",
            "text": "なんと",
            "zh": "岂料",
            "narrator_zh": "雅"
        },
