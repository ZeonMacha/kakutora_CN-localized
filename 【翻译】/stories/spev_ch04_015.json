{
    "dir": "chap00/daydra/spev_ch04_015.js",
    "type": "",
    "info": {
        "story_id": "4015",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "特別製は渡せない",
        "title_zh": "特别篇",
        "sub_title_zh": "特制的那份给不了"
    },
    "entry": [
        {
            "location": "29/TALK",
            "narrator": "みやび",
            "text": "まったく、クラン達の\nお騒がせっぷりも\n困ったもんぞね。",
            "zh": "真是的，库兰们\n这能折腾的劲头\n也真够叫人头疼咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "みやび",
            "text": "ほれ、\nちゃんと反省しちょるが？",
            "zh": "来，\n有好好反省着咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "31/TALK",
            "narrator": "透明寅沢ハル",
            "text": "は～い…。",
            "zh": "有～……。",
            "narrator_zh": "透明寅泽春"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "うむうむ。\nそれでヨシ。",
            "zh": "嗯嗯。\n这就对了。",
            "narrator_zh": "雅"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "チョコが欲しいなら\nちゃんと言わんと\nいかんよ。",
            "zh": "想要巧克力的话\n得老实讲出来\n才行哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "透明寅沢ハル",
            "text": "チョコが欲しいよー。",
            "zh": "我想要巧克力呀——。",
            "narrator_zh": "透明寅泽春"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "早いな…。",
            "zh": "真快啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "36/TALK",
            "narrator": "みやび",
            "text": "まあえい、うちもこれから\n作るところやき、\nハルの分も作っちゃる。",
            "zh": "嘛得吧，反正我待会儿\n也要开始做了啵，\n也给春做一份吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "37/TALK",
            "narrator": "透明寅沢ハル",
            "text": "わぁ～い！\nやったぁー！！",
            "zh": "哇～咿！\n太好啦——！！",
            "narrator_zh": "透明寅泽春"
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "ハルはまっこと\n食べ物が好きやねぇ。",
            "zh": "春你还真是\n蛮爱吃的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "透明寅沢ハル",
            "text": "食べることがどんなこと\nよりも一番楽しいよ！",
            "zh": "吃东西比什么事\n都要最让人开心啦！",
            "narrator_zh": "透明寅泽春"
        },
        {
            "location": "41/TALK",
            "narrator": "透明寅沢ハル",
            "text": "三度の飯より\n好きなものはないね！",
            "zh": "世上最爱的\n就是一日三餐啦！",
            "narrator_zh": "透明寅泽春"
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "それはえいけど\nほどほどにせんと\nいかんよ。",
            "zh": "喜欢吃是好事，\n不过还是得有个度\n才行哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "透明寅沢ハル",
            "text": "そこらへんのクランとは\n鍛え方が違うから\n大丈夫だよ。",
            "zh": "我跟外头那些随便的库兰\n锻炼方式可不一样，\n没关系的啦。",
            "narrator_zh": "透明寅泽春"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "そもそもクランは\n食事の必要がないから…。",
            "zh": "说到底库兰根本就\n不需要进食啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "ほんだら、すっと\n始めるかねぇ。",
            "zh": "那就，赶紧\n动手开工吧咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "57/SEL",
            "narrator": "（選択肢）",
            "text": "$me$の分のチョコもお願い！",
            "zh": "也拜托做份$me$的巧克力！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "58/ACT",
            "narrator": "",
            "text": "$me$の分のチョコもお願い！",
            "zh": "也拜托做份$me$的巧克力！",
            "narrator_zh": ""
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "もちろん、相棒の分も作るちや",
            "zh": "那是当然，搭档的份也会做滴",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "そのためにチョコや洋菓子について色々調べたんよ",
            "zh": "为此我特地查了好多关于巧克力和西点的资料",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "色々とあったけんど",
            "zh": "中间虽说出了不少状况，但是",
            "narrator_zh": "雅"
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "不安そうにしてたつばめちゃんも上手く出来たみたいやし",
            "zh": "原本还一脸不安的燕看着也做得挺顺利",
            "narrator_zh": "雅"
        },
        {
            "location": "70/SEL",
            "narrator": "（選択肢）",
            "text": "でもクランが居ると賑やかでいいね",
            "zh": "不过有库兰在还挺热闹的嘛",
            "narrator_zh": "（选项）"
        },
        {
            "location": "71/SEL",
            "narrator": "（選択肢）",
            "text": "寅沢ハルを許すのは甘いんじゃない？",
            "zh": "就这么原谅寅泽春是不是太给甜头了？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "72/SEL",
            "narrator": "（選択肢）",
            "text": "モーフィアスはもっとお仕置きしてしまえ",
            "zh": "摩耳甫斯就该再多教训她一顿",
            "narrator_zh": "（选项）"
        },
        {
            "location": "73/ACT",
            "narrator": "",
            "text": "でもクランが居ると賑やかでいいね",
            "zh": "不过有库兰在还挺热闹的嘛",
            "narrator_zh": ""
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "そうやね",
            "zh": "是咯",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "ちくっと賑やかすぎる時もあるけんど…",
            "zh": "虽说偶尔也热闹得稍微过头了点，但是……",
            "narrator_zh": "雅"
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "皆が楽しんでるのはえいことちや",
            "zh": "大家能玩得开心就是好事滴",
            "narrator_zh": "雅"
        },
        {
            "location": "78/ACT",
            "narrator": "",
            "text": "寅沢ハルを許すのは甘いんじゃない？",
            "zh": "就这么原谅寅泽春是不是太给甜头了？",
            "narrator_zh": ""
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "甘いか。チョコだけに",
            "zh": "太甜了吗。毕竟做的是巧克力嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "80/SEL",
            "narrator": "（選択肢）",
            "text": "あ、はい…",
            "zh": "啊，是……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "81/SEL",
            "narrator": "（選択肢）",
            "text": "わはは（どっ",
            "zh": "哇哈哈（爆笑",
            "narrator_zh": "（选项）"
        },
        {
            "location": "82/ACT",
            "narrator": "",
            "text": "あ、はい…",
            "zh": "啊，是……",
            "narrator_zh": ""
        },
        {
            "location": "83/TALK",
            "narrator": "みやび",
            "text": "ぬ…微妙な反応",
            "zh": "唔……好微妙的反应",
            "narrator_zh": "雅"
        },
        {
            "location": "84/ACT",
            "narrator": "",
            "text": "わはは（どっ",
            "zh": "哇哈哈（爆笑",
            "narrator_zh": ""
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "もっとウケてもえいよ",
            "zh": "多笑两声也行啵",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "まあ子供のイタズラみたいなもんやき",
            "zh": "嘛也就跟小孩子恶作剧差不多啵",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "反省もしとるようから今回はこれでえいんよ",
            "zh": "看她好像也反省了，这次就这么算了咯",
            "narrator_zh": "雅"
        },
        {
            "location": "89/ACT",
            "narrator": "",
            "text": "モーフィアスはもっとお仕置きしてしまえ",
            "zh": "摩耳甫斯就该再多教训她一顿",
            "narrator_zh": ""
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "まああいつのことは卯月に任せるちや",
            "zh": "嘛那家伙的事就交给卯月管滴",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "…卯月がお仕置きする限り、あいつは喜び続けるかもしれんけんど",
            "zh": "……不过只要是卯月来惩罚，那家伙说不定只会一直乐在其中就是了",
            "narrator_zh": "雅"
        },
        {
            "location": "95/TALK",
            "narrator": "みやび",
            "text": "今日はあいつらの分も作ってやらんとね",
            "zh": "今天也得把那帮家伙的份给做出来才行呢",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "当然、相棒のは特別製やけんどね",
            "zh": "当然，搭档那份可是特制的咯",
            "narrator_zh": "雅"
        },
        {
            "location": "97/TALK",
            "narrator": "みやび",
            "text": "ところで、相棒はどんなチョコが好きなが？",
            "zh": "话说回来，搭档你喜欢哪种巧克力？",
            "narrator_zh": "雅"
        },
        {
            "location": "98/SEL",
            "narrator": "（選択肢）",
            "text": "チョコトリュフかな",
            "zh": "松露巧克力吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "99/SEL",
            "narrator": "（選択肢）",
            "text": "チョコケーキがいい",
            "zh": "巧克力蛋糕就好",
            "narrator_zh": "（选项）"
        },
        {
            "location": "100/SEL",
            "narrator": "（選択肢）",
            "text": "チョコクッキーが食べたい",
            "zh": "想吃巧克力曲奇",
            "narrator_zh": "（选项）"
        },
        {
            "location": "101/ACT",
            "narrator": "",
            "text": "生チョコトリュフかな",
            "zh": "生松露巧克力吧",
            "narrator_zh": ""
        },
        {
            "location": "102/TALK",
            "narrator": "みやび",
            "text": "相棒は一口で食べやすいのが好きなんやね",
            "zh": "搭档喜欢一口一个方便吃的那种咯",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "とろけるような食感がたまらんね、あれは",
            "zh": "入口即化的口感确实叫人欲罢不能咯，那个",
            "narrator_zh": "雅"
        },
        {
            "location": "105/ACT",
            "narrator": "",
            "text": "チョコケーキがいい",
            "zh": "巧克力蛋糕就好",
            "narrator_zh": ""
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "ふわふわしたのが好きなんかね",
            "zh": "喜欢松松软软的那种咩",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "やっぱりケーキは満足感が高いぞね",
            "zh": "果然还是蛋糕吃着满足感高咧",
            "narrator_zh": "雅"
        },
        {
            "location": "109/ACT",
            "narrator": "",
            "text": "チョコクッキーが食べたい",
            "zh": "想吃巧克力曲奇",
            "narrator_zh": ""
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "サクっとしたのがええんやね",
            "zh": "喜欢酥酥脆脆的那种咯",
            "narrator_zh": "雅"
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "手軽に食べられるのがえいね",
            "zh": "随手拿来就能吃这点蛮好咯",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "相棒の好みのチョコを作るために",
            "zh": "为了做出合搭档口味的巧克力",
            "narrator_zh": "雅"
        },
        {
            "location": "115/TALK",
            "narrator": "みやび",
            "text": "チョコの種類を調べてるうちに",
            "zh": "查着查着各种巧克力的种类",
            "narrator_zh": "雅"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "うちのほうが食べたくなってきたぞね",
            "zh": "连我自己都嘴馋起来咧",
            "narrator_zh": "雅"
        },
        {
            "location": "117/TALK",
            "narrator": "みやび",
            "text": "和食専門やったけんど、チョコ作りで色々試してみるんも面白いかもしれんねえ",
            "zh": "虽说我向来专攻和食，但是借着做巧克力多试些花样说不定也蛮有趣咯",
            "narrator_zh": "雅"
        },
        {
            "location": "118/TALK",
            "narrator": "みやび",
            "text": "一流チョコメーカーのようにはいかんけんど",
            "zh": "虽说比不上一流巧克力厂商那样厉害，但是",
            "narrator_zh": "雅"
        },
        {
            "location": "119/TALK",
            "narrator": "みやび",
            "text": "相棒に気に入ってもらえるように頑張るぞね",
            "zh": "为了让搭档满意我会加把劲咧",
            "narrator_zh": "雅"
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "期待しとってえいよ",
            "zh": "尽管期待着就得",
            "narrator_zh": "雅"
        },
        {
            "location": "121/SEL",
            "narrator": "（選択肢）",
            "text": "$me$にとっては市販品よりもいい",
            "zh": "对$me$来说比市面上买的都要好",
            "narrator_zh": "（选项）"
        },
        {
            "location": "122/SEL",
            "narrator": "（選択肢）",
            "text": "まああれと比べちゃうとねｗ",
            "zh": "嘛真拿来跟名牌比的话哈哈",
            "narrator_zh": "（选项）"
        },
        {
            "location": "123/ACT",
            "narrator": "",
            "text": "$me$にとっては市販品よりもいい",
            "zh": "对$me$来说比市面上买的都要好",
            "narrator_zh": ""
        },
        {
            "location": "124/TALK",
            "narrator": "みやび",
            "text": "そう言ってくれると作り甲斐があるんよ",
            "zh": "你这么一说我做着也更有干劲了",
            "narrator_zh": "雅"
        },
        {
            "location": "125/ACT",
            "narrator": "",
            "text": "まああれと比べちゃうとねｗ",
            "zh": "嘛真拿来跟名牌比的话哈哈",
            "narrator_zh": ""
        },
        {
            "location": "126/TALK",
            "narrator": "みやび",
            "text": "はっきりいいよる…。",
            "zh": "你还真是说得够直白啊……",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "さて、気合入れて頑張るかねぇ",
            "zh": "那么，打起精神加油干吧咯",
            "narrator_zh": "雅"
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "ほんだら、また後でな",
            "zh": "那就，回头再见咯",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "透明寅沢ハル",
            "text": "ん～、甘くて\n美味しいなぁ。",
            "zh": "嗯～，又甜\n又好吃呀。",
            "narrator_zh": "透明寅泽春"
        },
        {
            "location": "139/TALK",
            "narrator": "透明みやび",
            "text": "ちょ、ハル！\n作りかけのチョコを――",
            "zh": "等、春！\n那还是做到一半的巧克力——",
            "narrator_zh": "透明雅"
        },
        {
            "location": "140/TALK",
            "narrator": "透明みやび",
            "text": "次々食べるのは\nやめるちや！",
            "zh": "别一个接一个\n往嘴里塞了滴！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "141/TALK",
            "narrator": "透明みやび",
            "text": "これじゃ全部、完成前に\nなくなってしまうぞね！",
            "zh": "照这样下去，做好之前\n就要全被你吃光咧！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "142/TALK",
            "narrator": "透明寅沢ハル",
            "text": "む～、また\n怒られちゃうから\n我慢するよ～。",
            "zh": "唔～，再吃\n又要挨骂了，\n那我忍着就是～。",
            "narrator_zh": "透明寅泽春"
        },
        {
            "location": "144/TALK",
            "narrator": "透明みやび",
            "text": "やれやれ…。\nハルを満足させるのは\n苦労しそうぞね",
            "zh": "唉呀呀……。\n想喂饱春这胃口\n看来够呛咧",
            "narrator_zh": "透明雅"
        },
        {
            "location": "145/SEL",
            "narrator": "（選択肢）",
            "text": "調子はどう？",
            "zh": "进展怎么样？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "146/ACT",
            "narrator": "",
            "text": "調子はどう？",
