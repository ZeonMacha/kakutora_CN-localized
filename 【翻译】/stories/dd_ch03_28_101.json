{
    "dir": "chap28/daydra/dd_ch03_28_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "28302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "蝶々のささやき＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "蝴蝶的低语＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "蝶々のささやき",
            "zh": "蝴蝶的低语",
            "narrator_zh": ""
        },
        {
            "location": "28/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に神社なのね。\nアーヤのうちは。",
            "zh": "真的是神社呀。\n绫水家里。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "30/TALK",
            "narrator": "アーヤ",
            "text": "山の奥すぎて\nびっくりしたでしょ？",
            "zh": "在这么深的山里，\n吓了一跳吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうところも\n素敵じゃない。",
            "zh": "这种地方不也\n挺不错的嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "全然よ。\n三日で飽きるわ\nこんなところ。",
            "zh": "才怪呢。\n待三天就会腻了，\n这种地方。",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ$marzanna$",
            "zh": "呐$marzanna$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "46/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤの話し相手になってって",
            "zh": "你让我当绫水的说话对象",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "こういうところ？",
            "zh": "就是指这种事吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤはおうちが",
            "zh": "绫水她是不是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "嫌いなのかしら？",
            "zh": "讨厌自己家呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/SEL",
            "narrator": "",
            "text": "うーん……",
            "zh": "唔嗯……",
            "narrator_zh": ""
        },
        {
            "location": "52/SEL",
            "narrator": "",
            "text": "ちょっと違うけど",
            "zh": "稍微有点不一样哦",
            "narrator_zh": ""
        },
        {
            "location": "53/SEL",
            "narrator": "",
            "text": "もっと色々聞いてみたらどうかな",
            "zh": "试着多打听点其他事情怎么样",
            "narrator_zh": ""
        },
        {
            "location": "54/ACT",
            "narrator": "",
            "text": "うーん……",
            "zh": "唔嗯……",
            "narrator_zh": ""
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "それとも照れてるだけなのかしら？",
            "zh": "还是说她只是害羞了呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "だったらいいんだけど",
            "zh": "那样的话倒还好",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "57/ACT",
            "narrator": "",
            "text": "ちょっと違うけど",
            "zh": "稍微有点不一样哦",
            "narrator_zh": ""
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなの？",
            "zh": "是这样吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "59/ACT",
            "narrator": "",
            "text": "もっと色々聞いてみたらどうかな",
            "zh": "试着多打听点其他事情怎么样",
            "narrator_zh": ""
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "そうすれば",
            "zh": "那样做的话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "いいのかしら？",
            "zh": "会比较好吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "でも結構忙しかったり\nするんじゃないの？\nお祓いとかで。",
            "zh": "不过平时是不是\n还挺忙的呀？\n比如驱邪之类的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "アーヤ",
            "text": "それはあるけど…。",
            "zh": "那倒确实……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "え？　お祓いとか\n本当にするの？",
            "zh": "诶？　驱邪什么的\n真的会做吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/TALK",
            "narrator": "アーヤ",
            "text": "するわよ。",
            "zh": "会做哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "霊とか悪霊とかを？\n映画やゲームみたいな。",
            "zh": "对付幽灵和恶灵吗？\n就像电影和游戏里那样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "83/TALK",
            "narrator": "アーヤ",
            "text": "そこまで\n派手じゃないけど。",
            "zh": "倒也没那么\n夸张啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "ガブリエラ",
            "text": "…いるの？　本当に？",
            "zh": "……真的有吗？　那种东西？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "本当にいるから\nするのよ。",
            "zh": "正因为真的有，\n才要驱邪的呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなのね……。",
            "zh": "原来是这样啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "でもそれだったら\nアーヤ恐がりなのに\n大変じゃない？",
            "zh": "但要是那样的话，\n绫水你明明那么怕鬼，\n岂不是很辛苦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "…本当に見たりしたら\n恐がりにもなるわよ。",
            "zh": "……真要亲眼见识过，\n任谁都会怕的吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そうね……。",
            "zh": "这、说得也是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "そうよ。本当に洒落に\nならないことは\nいっぱいあるんだから。",
            "zh": "是啊。真的有\n好多完全笑不出来的\n事情呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "あ！　だから\nみやびの家であんなに\n厳しかったの？",
            "zh": "啊！　所以之前\n在雅家里才会\n那么严格吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "アーヤ",
            "text": "そう。",
            "zh": "对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "アーヤ",
            "text": "昔から父には大体\n立ち会わされたから。",
            "zh": "从以前开始，父亲几乎每次\n都要让我在旁边看着。",
            "narrator_zh": "绫水"
        },
        {
            "location": "95/TALK",
            "narrator": "アーヤ",
            "text": "本当に色んなものを\n見たし、体験したわ。\n私はね。",
            "zh": "我可是见过\n各种各样的东西，\n也亲身体验过呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "96/TALK",
            "narrator": "ガブリエラ",
            "text": "私は？",
            "zh": "怎么只说「我」？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "アーヤ",
            "text": "姉はいつも逃げてたから。\n私が立ち会うしかなくて。",
            "zh": "姐姐总是逃跑嘛。\n结果就只有我不得不在场了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "98/TALK",
            "narrator": "アーヤ",
            "text": "父は私を跡継ぎにする\nつもりだったみたいで。\nそういうのもあって。",
            "zh": "父亲似乎是打算\n让我当继承人的。\n也有这方面的原因。",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうだったんだ…。",
            "zh": "……原来如此啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "でもそれって\nエクソシストみたいな\nものでしょ？",
            "zh": "不过那样的话，\n不就跟驱魔师\n差不多嘛？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "すごく素敵！",
            "zh": "好帅气！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "…実際体験したら\nそうも言ってられないわ。",
            "zh": "……等真正体验过，\n就说不出这种话了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "…それに他の事情も\nあったし…。",
            "zh": "……而且也还有\n其他隐情……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "187/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "さて。",
            "zh": "好了。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "どういうことなのか\n説明して\nもらいましょうか。",
            "zh": "能请你\n好好解释一下\n这到底是怎么回事吗。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "189/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "説明する必要なんてない。",
            "zh": "没必要解释。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "あんたはもう、とうの昔に\n契約者から司書を否定\nされているはず。",
            "zh": "你早就已经被\n契约者否定司书身份了\n不是吗。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "191/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "正式な解約をされていない\nからといって、司書として\n振る舞うのはやめなさい。",
            "zh": "别仗着还没\n正式解约，就继续\n摆出一副司书的架子。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "ていうか、\nあんた誰？",
            "zh": "话说回来，\n你谁啊？",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "193/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "あなたの代わりに\n司書として就任した人格。",
            "zh": "代替你\n就任司书的人格。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "ふーん、そう。\nわかったわ。\n適当に頑張って頂戴。",
            "zh": "唔嗯，这样啊。\n我知道了。\n那你就随便加油吧。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "それじゃ、\nあたし急ぐから。",
            "zh": "那么，\n我赶时间，先走了。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "ここは通さない。",
            "zh": "这里不能让你过去。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "……なんでよ。",
            "zh": "……为什么啊。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "198/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "あんただって\nわかってるはず。\nここから先は聖域だって。",
            "zh": "你应该也\n很清楚才对。\n从这里往前是圣域。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "199/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "じゃあ、教えてくれる？",
            "zh": "那你能告诉我吗？",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "200/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "今、マークスマンの様子が\nおかしいんだけど、一体\n何が起こってるの？",
            "zh": "现在神射手的样子\n很不对劲，到底\n发生什么事了？",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "201/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "マークスマンは、今\n進化に向けての準備を\n行っているの。",
            "zh": "神射手现在，\n正在进行迈向进化的\n准备工作。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "202/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "これは\nとても喜ばしいことよ？",
            "zh": "这可是\n非常值得欣喜的事哦？",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "203/SEL",
            "narrator": "",
            "text": "進化！？\nURになるの？",
            "zh": "进化！？\n要变成UR了吗？",
            "narrator_zh": ""
        },
        {
            "location": "204/SEL",
            "narrator": "",
            "text": "嫌な予感しかしない",
            "zh": "总觉得有不好的预感",
            "narrator_zh": ""
        },
        {
            "location": "205/ACT",
            "narrator": "",
            "text": "進化！？\nURになるの？",
            "zh": "进化！？\n要变成UR了吗？",
            "narrator_zh": ""
        },
        {
            "location": "209/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "誰？",
            "zh": "谁啊？",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "URってなんなの！？\n何か知ってるなら\n早く教えてよ！",
            "zh": "UR是什么东西啊！？\n要是知道点什么\n就快点告诉我！",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "212/SEL",
            "narrator": "",
            "text": "すみません、メタな冗談です",
            "zh": "抱歉，只是个Meta玩笑",
            "narrator_zh": ""
        },
        {
            "location": "213/ACT",
            "narrator": "",
            "text": "すみません、メタな冗談です",
            "zh": "抱歉，只是个Meta玩笑",
            "narrator_zh": ""
        },
        {
            "location": "215/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "は？　意味が\n分からないんだけど。",
            "zh": "哈？　完全\n听不懂你在说什么。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "滑稽ね。\nお似合いのコンビだわ。",
            "zh": "真滑稽呢。\n真是天生一对的搭档。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "219/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "うるさいわね！\n$handle$のこと\n悪く言わないで。",
            "zh": "少啰嗦！\n不准说$handle$的\n坏话。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "220/ACT",
            "narrator": "",
            "text": "嫌な予感しかしない",
            "zh": "总觉得有不好的预感",
            "narrator_zh": ""
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "誰？",
            "zh": "谁啊？",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "嫌な予感しかしない？\n本当に無能なのね、貴方。",
            "zh": "总觉得有不好的预感？\n你还真是无能呢，你这家伙。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "はぁ！？\n何最初から\nディスってるのよ！",
            "zh": "哈啊！？\n干嘛一上来\n就diss人家啊！",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "230/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "$handle$は、\n今までずっと、あたしを\n助けてくれたんだから！",
            "zh": "$handle$可是\n一直以来都在\n帮我的忙好吗！",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "232/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "その異常な肩の持ち方。\n確かに成果は出てるって\nことかしらね。",
            "zh": "这非同寻常的偏袒。\n看来确实是\n出成果了呢。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "233/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "……何よ、\nその「成果」ってのは。",
            "zh": "……什么呀，\n你说的那个「成果」是什么意思。",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "さあ？\n何なのかしら。",
            "zh": "谁知道呢？\n会是什么意思呢。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "235/SEL",
            "narrator": "",
            "text": "信頼関係を築いたことを「成果」とか言わないでくれ",
            "zh": "别把建立信赖关系说成是什么「成果」啊",
            "narrator_zh": ""
        },
        {
            "location": "236/SEL",
            "narrator": "",
            "text": "$me$と司書ちゃんのラブラブの成果？　だとしたら確かに成果出てる！",
            "zh": "是$me$和司书酱甜甜蜜蜜的成果？　那确实很有成果！",
            "narrator_zh": ""
        },
        {
            "location": "237/ACT",
            "narrator": "",
            "text": "信頼関係を築いたことを「成果」とか言わないでくれ",
            "zh": "别把建立信赖关系说成是什么「成果」啊",
            "narrator_zh": ""
        },
        {
            "location": "239/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "信頼関係ね。ふーん。",
            "zh": "信赖关系啊。唔嗯。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "まあ、あたしの人格の中で\n最高にチョロい、この子\nだものね。仕方ないか。",
            "zh": "毕竟在我的所有人格里，\n最容易上钩的就是这孩子\n了嘛。也没办法。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "何ですって……？",
            "zh": "你说什么……？",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "243/ACT",
            "narrator": "",
            "text": "$me$と司書ちゃんのラブラブの成果？　だとしたら確かに成果出てる！",
            "zh": "是$me$和司书酱甜甜蜜蜜的成果？　那确实很有成果！",
            "narrator_zh": ""
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラの元司書",
            "text": "ちょ、ちょっと！\n恥ずかしいから人前で\nそういう事言わないで！",
            "zh": "等、等一下！\n好丢脸啊，别在别人面前\n说这种话啦！",
            "narrator_zh": "加布里埃拉的原司书"
        },
        {
            "location": "246/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "ふふ、\nオメデタイ人たちね。",
            "zh": "呵呵，\n真是些天真到傻气的人呢。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "249/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "類は友を呼ぶとは\nまさにこの事。",
            "zh": "所谓物以类聚\n指的就是这么一回事吧。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "251/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "問題は、それが\n現実のあたしにも影響\nダダ漏れてるところよね。",
            "zh": "问题在于，那些影响\n正毫无保留地漏到\n现实中的我身上呢。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "まあでも、それが\n契約主の御希望なんだし\nそこは大目に見るわ。",
            "zh": "不过算了，既然那是\n契约主的期望，\n这点程度我就睁一只眼闭一只眼吧。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "あたしとしては、\n全く以て\n納得いかないけど。",
            "zh": "虽说就我个人而言，\n实在完全\n无法认同就是了。",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "254/SEL",
            "narrator": "",
            "text": "ていうか、君は誰？　挨拶もナシ？",
            "zh": "话说回来，你到底是谁啊？　连个招呼都不打吗？",
            "narrator_zh": ""
        },
        {
            "location": "255/ACT",
            "narrator": "",
            "text": "ていうか、君は誰？　挨拶もナシ？",
            "zh": "话说回来，你到底是谁啊？　连个招呼都不打吗？",
            "narrator_zh": ""
        },
        {
            "location": "258/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "挨拶ってのは、\n人間同士でするものよ？",
            "zh": "打招呼这种事，\n是人与人之间才做的吧？",
            "narrator_zh": "加布里埃拉的新司书"
        },
        {
            "location": "259/TALK",
            "narrator": "ガブリエラの新司書　",
            "text": "でもまあいいわ、\n今回は特別に\n挨拶してあげる。",
