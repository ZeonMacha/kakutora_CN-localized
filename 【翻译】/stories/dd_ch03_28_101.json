        {
            "location": "260/TALK",
            "narrator": "リヴォルカ　",
            "text": "初めまして。\nあたしはリヴォルカ。",
            "zh": "初次见面。\n我叫莉沃尔卡。",
            "narrator_zh": "莉沃尔卡"
