   "narrator_zh": ""
  },
  {
   "location": "583/ACT",
   "narrator": "",
   "text": "かもね",
   "zh": "说不定哦",
   "narrator_zh": ""
  },
  {
   "location": "584/TALK",
   "narrator": "みやび",
   "text": "せやろ",
   "zh": "是这样啵",
   "narrator_zh": "雅"
  },
  {
   "location": "585/ACT",
   "narrator": "",
   "text": "気にすんな",
   "zh": "别在意",
   "narrator_zh": ""
  },
  {
   "location": "586/TALK",
   "narrator": "みやび",
   "text": "それが正しいとはわかっておるが",
   "zh": "我知道那是对的咯",
