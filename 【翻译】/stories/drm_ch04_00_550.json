   "text": "言葉遊びにしては悪意がある"
  },
  {
   "location": "581/SEL",
   "narrator": "",
   "text": "かもね",
   "zh": "说不定哦",
   "narrator_zh": ""
  },
  {
   "location": "582/SEL",
   "narrator": "",
   "text": "気にすんな",
