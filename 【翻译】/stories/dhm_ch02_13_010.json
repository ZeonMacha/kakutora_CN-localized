            "text": "何がたまに？",
            "zh": "什么偶尔？",
            "narrator_zh": ""
        },
        {
            "location": "39/TALK",
            "narrator": "アーヤ",
            "text": "あれ",
            "zh": "咦",
            "narrator_zh": "绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "アーヤ",
            "text": "いなかったっけ",
            "zh": "你刚才不在吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "41/ACT",
            "narrator": "",
            "text": "$me$はいつでもアーヤが好き",
            "zh": "$me$永远都喜欢绫水",
            "narrator_zh": ""
        },
        {
            "location": "43/TALK",
            "narrator": "アーヤ",
            "text": "あら(*^^*)",
            "zh": "哎呀(*^^*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/TALK",
            "narrator": "アーヤ",
            "text": "そうなの？",
            "zh": "是这样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "でも今の話とは関係ないわね",
            "zh": "不过和刚才说的事没关系哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "みんなとお茶して",
            "zh": "和大家喝了个茶",
            "narrator_zh": "绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "アーヤ",
            "text": "ついでにラーメンも食べちゃったことよ",
            "zh": "还顺便吃了拉面哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "アーヤ",
            "text": "滅多にないことだものね",
            "zh": "这种事可不常有呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/SEL",
            "narrator": "",
            "text": "さあ、体重計へどうぞ",
            "zh": "来，请上体重秤",
            "narrator_zh": ""
        },
        {
            "location": "53/SEL",
            "narrator": "",
            "text": "意外と食べるんだね？",
            "zh": "你饭量意外地大啊？",
            "narrator_zh": ""
        },
        {
            "location": "54/SEL",
            "narrator": "",
            "text": "幸せそうだ",
            "zh": "听起来好幸福",
            "narrator_zh": ""
        },
        {
            "location": "55/ACT",
            "narrator": "",
            "text": "さあ、体重計へどうぞ",
            "zh": "来，请上体重秤",
            "narrator_zh": ""
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "もう",
            "zh": "真是的",
            "narrator_zh": "绫水"
        },
        {
            "location": "57/TALK",
            "narrator": "アーヤ",
            "text": "なんでそんなこと言うのかしら",
            "zh": "你怎么就说这个呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "乗らないから",
            "zh": "我才不上秤",
            "narrator_zh": "绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "アーヤ",
            "text": "今週は運動して",
            "zh": "这周先运动",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "ライ数体重計に乗るわ",
            "zh": "莱周再上体重秤",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "アーヤ",
            "text": "来週",
            "zh": "下周",
            "narrator_zh": "绫水"
        },
        {
            "location": "63/ACT",
            "narrator": "",
            "text": "意外と食べるんだね？",
            "zh": "你饭量意外地大啊？",
            "narrator_zh": ""
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "そう？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "65/TALK",
            "narrator": "アーヤ",
            "text": "これでも高校時代よりは減ったわよ",
            "zh": "这已经比高中时代吃得少了哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "66/TALK",
            "narrator": "アーヤ",
            "text": "そう言えば",
            "zh": "说起来",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "アーヤ",
            "text": "高校時代ってなんであんなに食べれたのかしら",
            "zh": "高中时代怎么那么能吃来着",
            "narrator_zh": "绫水"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "不思議だわ",
            "zh": "真是不可思议",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/ACT",
            "narrator": "",
            "text": "幸せそうだ",
            "zh": "听起来好幸福",
            "narrator_zh": ""
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "アーヤ",
            "text": "おいしいものって幸せよね",
            "zh": "好吃的东西就是幸福呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "アーヤ",
            "text": "みんなそうだと思うわ",
            "zh": "大家都一样的",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "アーヤ",
            "text": "カロリーさえ考えなきゃね",
            "zh": "只要不考虑热量就完美了",
