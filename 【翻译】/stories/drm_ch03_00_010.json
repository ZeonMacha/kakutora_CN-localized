    "type": "Episode",
    "info": {
        "story_id": "3001",
        "cid": "gabriella",
        "title": "らぶとーく 第01話",
        "sub_title": "幼気な恋",
        "title_zh": "恋爱漫谈 第01话",
        "sub_title_zh": "稚嫩的恋情"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "010_幼気な恋",
            "zh": "010_稚嫩的恋情",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "千羽鶴",
            "text": "まずはおめでとう。",
            "zh": "先恭喜你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "24/TALK",
            "narrator": "千羽鶴",
            "text": "貴方が今ここにいると\nいうことは、彼女との\n関係の開始を意味する。",
            "zh": "你现在在这里，\n就意味着，和她的\n关系开始了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "26/SEL",
            "narrator": "",
            "text": "関係の開始って、つまり…",
            "zh": "关系开始，也就是说……",
            "narrator_zh": ""
        },
        {
            "location": "27/ACT",
            "narrator": "",
            "text": "関係の開始って、つまり…",
            "zh": "关系开始，也就是说……",
            "narrator_zh": ""
        },
        {
            "location": "30/TALK",
            "narrator": "千羽鶴",
            "text": "そう。",
            "zh": "是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "31/TALK",
            "narrator": "千羽鶴",
            "text": "今この瞬間から、貴方と\n彼女は、真のパートナー\nとして歩み始める。",
            "zh": "从这一刻起，你和\n她，要作为真正的伙伴\n一起走下去。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "32/TALK",
            "narrator": "千羽鶴",
            "text": "その結果としては、\n恋人になったり、結婚\nしたりするかもしれない。",
            "zh": "结果也许是，\n成为恋人，\n或者结婚。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "33/TALK",
            "narrator": "千羽鶴",
            "text": "もちろんそれは、\nあくまで可能性でしか\nないけれども。",
            "zh": "当然，\n那也只是\n可能性而已。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "34/TALK",
            "narrator": "千羽鶴",
            "text": "１つだけ言えることは、\n全ては貴方の行動次第\nということ。",
            "zh": "只有一点能说，\n一切都看你\n怎么做。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "35/TALK",
            "narrator": "千羽鶴",
            "text": "何にしても、今後\n貴方と彼女の関係進展は、\n全てここで行われる。",
            "zh": "总之，往后\n你和她的关系进展，\n全都会在这里发生。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "36/TALK",
            "narrator": "千羽鶴",
            "text": "一見貴方に関係無いような\nお話が繰り広げられる事も\nあるけど、全部関係ある。",
            "zh": "看上去和你无关的\n故事，有时也会展开。\n但全部都有关系。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "37/TALK",
            "narrator": "千羽鶴",
            "text": "だから、彼女を大切に\n想うなら、ここでの物語は\n決して軽視しないよう。",
            "zh": "所以，要是珍惜她，\n这里的故事，\n千万别看轻。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "38/SEL",
            "narrator": "",
            "text": "これでもうパートナーは決まっちゃったの？",
            "zh": "这样伙伴就已经定下了吗？",
            "narrator_zh": ""
        },
        {
            "location": "39/ACT",
            "narrator": "",
            "text": "これでもうパートナーは決まっちゃったの？",
            "zh": "这样伙伴就已经定下了吗？",
            "narrator_zh": ""
        },
        {
            "location": "41/TALK",
            "narrator": "千羽鶴",
            "text": "まさか。\nまだ始まりに過ぎない。",
            "zh": "怎么会。\n这才刚开始。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "42/TALK",
            "narrator": "千羽鶴",
            "text": "もちろん、複数の子と\n関係を深められる。\nというか深めて欲しい。",
            "zh": "当然，可以和好几个女孩\n加深关系。\n不如说，希望你去加深。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "43/TALK",
            "narrator": "千羽鶴",
            "text": "最初にも言ったとおり、\n貴方には、全員の支えに\nなって欲しいと思ってる。",
            "zh": "一开始也说过。\n我希望你\n成为大家的支撑。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "44/TALK",
            "narrator": "千羽鶴",
            "text": "もちろん、\n強制はしないけど。",
            "zh": "当然，\n不会强迫。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "45/TALK",
            "narrator": "千羽鶴",
            "text": "貴方がしたいように、\n彼女たちとの物語を\n紡いでいけばいい。",
            "zh": "照你想的那样，\n和她们把故事\n讲下去就好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "46/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃ、頑張って。\n彼女のココロは、貴方の\n頑張りに委ねられている。",
            "zh": "那就，加油。\n她的心，\n交给你的努力了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "一体全体、どうすればいいんでしょうか。",
            "zh": "究竟该怎么办才好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "ガブリエラ",
            "text": "姫はどんな名医にも治せない、厄介な病気にかかってしまったのです。",
            "zh": "公主得了任何名医都治不好的、棘手的病。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "これまでに同じことがあったのではありませんか？　医師はそう聞きます。",
            "zh": "以前没有过同样的事吗？　医生这么问。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "なぜそんなことを聞くの？　姫は医師に聞き返します。",
            "zh": "为什么要问那种事？　公主反问医生。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "ガブリエラ",
            "text": "原因はわかっております。しかし、初めてかどうかがこの病の治療には必要不可欠な情報なのです。",
            "zh": "病因是知道的。可是，是不是第一次，对这病的治疗是必不可少的信息。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "なぜなら・・・",
            "zh": "因为……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/SEL",
            "narrator": "",
            "text": "またお姫様ごっこ？",
            "zh": "又在玩公主游戏？",
            "narrator_zh": ""
        },
        {
            "location": "88/SEL",
            "narrator": "",
            "text": "体調が悪いの？",
            "zh": "你不舒服吗？",
            "narrator_zh": ""
        },
        {
            "location": "89/SEL",
            "narrator": "",
            "text": "姫、いかがなさいましたか？",
            "zh": "公主，出什么事了吗？",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "なぜなら・・・",
            "zh": "因为……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "姫の病は恋だからです。",
            "zh": "因为公主的病是恋爱。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/ACT",
            "narrator": "",
            "text": "またお姫様ごっこ？",
            "zh": "又在玩公主游戏？",
            "narrator_zh": ""
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな言い方ってないと思うわ",
            "zh": "我觉得没有那种说法",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/ACT",
            "narrator": "",
            "text": "体調が悪いの？",
            "zh": "你不舒服吗？",
            "narrator_zh": ""
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "大丈夫よ、私は平気",
            "zh": "没事的，我不要紧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "いい子ねv",
            "zh": "真是好孩子呢v",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/ACT",
            "narrator": "",
            "text": "姫、いかがなさいましたか？",
            "zh": "公主，出什么事了吗？",
            "narrator_zh": ""
        },
        {
            "location": "121/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、心配かけちゃったかしら",
            "zh": "哎呀，让你担心了吗",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "大丈夫よ、私は平気なの",
            "zh": "没事的，我不要紧的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "ガブリエラ",
            "text": "いい子ねv",
            "zh": "真是好孩子呢v",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "あのね・・・",
            "zh": "那个呀……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナにだけ教えてあげるv",
            "zh": "只告诉玛尔赞娜一个人v",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "ガブリエラ",
            "text": "私ね、今、すきなひとがいるのvvvvvvv",
            "zh": "我呀，现在，有喜欢的人了vvvvvvv",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "130/SEL",
            "narrator": "",
            "text": "それは誰？",
            "zh": "那是谁？",
            "narrator_zh": ""
        },
        {
            "location": "131/SEL",
            "narrator": "",
            "text": "$handle$のことだよね？",
            "zh": "说的是$handle$的事吧？",
            "narrator_zh": ""
        },
        {
            "location": "132/ACT",
            "narrator": "",
            "text": "それは誰？",
            "zh": "那是谁？",
            "narrator_zh": ""
        },
        {
            "location": "134/TALK",
            "narrator": "ガブリエラ",
            "text": "・・・聞きたい？",
            "zh": "……想听吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/ACT",
            "narrator": "",
            "text": "$handle$のことだよね？",
            "zh": "说的是$handle$的事吧？",
            "narrator_zh": ""
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "まあマルザンナ！",
            "zh": "哎呀玛尔赞娜！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "また変なこと言って！",
            "zh": "又说奇怪的话！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナはマルザンナでしょう？\n$handle$なんて変な名前はやめてちょうだいね？",
            "zh": "玛尔赞娜就是玛尔赞娜吧？\n别用$handle$这种奇怪的名字了，好吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "すきなひとの話だけど・・・・",
            "zh": "喜欢的人的事……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "145/TALK",
            "narrator": "ガブリエラ",
            "text": "ヒカルくんっていうの",
            "zh": "叫光",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "155/TALK",
            "narrator": "ガブリエラ",
            "text": "あ",
            "zh": "啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "156/TALK",
            "narrator": "ガブリエラ",
            "text": "私ばっかり話しちゃったわね？",
            "zh": "光顾着我说了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "157/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナにも楽しい話をしてあげるわねvvvvvvv",
            "zh": "也给玛尔赞娜讲点开心的事吧vvvvvvv",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "161/TALK",
            "narrator": "ボイスメール",
            "text": "白ウサギの優しき嘘",
            "zh": "白兔温柔的谎",
            "narrator_zh": "语音信箱"
        },
        {
            "location": "178/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあねvvvvvvvv",
            "zh": "再见vvvvvvvv",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/DIALOG",
            "narrator": "Dialog_GETGokigen",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>500pt.</b></color></size>\n增加了！",
            "narrator_zh": "Dialog_GETGokigen"
        },
        {
            "location": "173/DIALOG",
            "narrator": "Dialog_GETVoice",
            "text": "<color=green>【ガブリエラ】</color>のボイスメール\n<color=red>【白ウサギの優しき嘘】</color>\nをゲットしました！",
            "zh": "<color=green>【加布里埃拉】</color>的语音信箱\n<color=red>【白兔温柔的谎】</color>\n拿到了！",
            "narrator_zh": "Dialog_GETVoice"
        }
    ]
}
