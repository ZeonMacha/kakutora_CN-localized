{
    "dir": "dramatics/daydra/drm_ch02_00_770.js",
    "type": "Episode",
    "info": {
        "story_id": "2077",
        "cid": "ayami",
        "title": "らぶとーく 第76話",
        "sub_title": "びっくり箱",
        "title_zh": "恋爱漫谈 第76话",
        "sub_title_zh": "惊吓盒"
    },
    "entry": [
        {
            "location": "122/SCENARIO",
            "narrator": "",
            "text": "びっくり箱",
            "zh": "惊吓盒",
            "narrator_zh": ""
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "開いてるわよ。",
            "zh": "门开着哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "アーヤ",
            "text": "ごめんね、こんな時間に。",
            "zh": "抱歉，这么晚还来找你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "144/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん、気にしないで。",
            "zh": "不，别在意。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "146/TALK",
            "narrator": "ガブリエラ",
            "text": "多分、そろそろ来る頃じゃ\nないかな、って思ってた\nところだし。",
            "zh": "我正想着\n你也差不多\n该来了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "148/TALK",
            "narrator": "アーヤ",
            "text": "うっ…。",
            "zh": "唔……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "149/TALK",
            "narrator": "ガブリエラ",
            "text": "で？　どんな用事かしら？",
            "zh": "那？是什么事呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "150/TALK",
            "narrator": "アーヤ",
            "text": "…お礼を言いに来たのよ。",
            "zh": "…我是来道谢的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "152/TALK",
            "narrator": "アーヤ",
            "text": "その、ほら…私の箱を、\n回収してくれたから…。",
            "zh": "那个，你看……因为你\n帮我找回了我的箱……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "アーヤ",
            "text": "…ありがとう。\n本当、安心したわ。",
            "zh": "…谢谢你。\n真的，松了口气。",
            "narrator_zh": "绫水"
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱり、超大切な物\nだったんだ？",
            "zh": "……果然，那是你\n超级重要的东西吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "155/TALK",
            "narrator": "アーヤ",
            "text": "当然よ！",
            "zh": "当然！",
            "narrator_zh": "绫水"
        },
        {
            "location": "156/TALK",
            "narrator": "アーヤ",
            "text": "あの箱の中身、\nギャヴィも見たんでしょ？",
            "zh": "那箱子的东西，\n加维也看过了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "手作りっぽい服とか、\n色んな物が入ってた\nけど――",
            "zh": "里面塞了像手工缝的\n衣服之类，\n各种东西——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "159/TALK",
            "narrator": "ガブリエラ",
            "text": "男物っぽいデザインの物\nばかりだったわね。",
            "zh": "而且净是\n男款设计的东西呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "161/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "ははぁん、なるほど…。",
            "zh": "哈——原来如此…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "166/TALK",
            "narrator": "ガブリエラ",
            "text": "彼氏へのプレゼントが\n詰まった箱、ってわけ？",
            "zh": "箱子里塞满了\n给男朋友的礼物，是吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "…そうよ。",
            "zh": "…是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "168/TALK",
            "narrator": "ガブリエラ",
            "text": "へぇー、アーヤってば\nそんな彼氏箱とか\n作ったりするのね！？",
            "zh": "欸——绫水还会\n做那种男朋友箱\n啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "171/TALK",
            "narrator": "アーヤ",
            "text": "ち、違うわ！\n彼氏箱じゃないから！",
            "zh": "不、不是！\n又不是男朋友箱！",
            "narrator_zh": "绫水"
        },
        {
            "location": "172/TALK",
            "narrator": "ガブリエラ",
            "text": "彼氏へのプレゼントを\n詰めた箱なんでしょ？\n彼氏箱じゃん",
            "zh": "塞满给男朋友礼物的\n箱子对吧？\n不就是男朋友箱嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "アーヤ",
            "text": "違うから！",
            "zh": "当然不是！",
            "narrator_zh": "绫水"
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "あれは、あなた箱、\nっていうの！",
            "zh": "那个要叫“你箱”，\n才对！",
            "narrator_zh": "绫水"
        },
        {
            "location": "176/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、うん…わかった…。\nあなた箱ね…。",
            "zh": "啊，嗯…懂了…。\n“你箱”呢…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "けど、そんな大切な物を、\n酔った勢いで捨てるのは\nどうなのよ？",
            "zh": "可是，那么重要的东西，\n趁着酒劲就扔掉，\n这样好吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "182/TALK",
            "narrator": "アーヤ",
            "text": "わかってるわ。\nあの時は、どうかしてた\nのよ。",
            "zh": "我知道。\n那时候的我，\n真的不正常。",
            "narrator_zh": "绫水"
        },
        {
            "location": "183/TALK",
            "narrator": "アーヤ",
            "text": "でも、色んなこと考えて\nたら、どうしても自分を\n抑えられなくて…。",
            "zh": "不过，想了很多之后，\n怎么都控制不住\n自己……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "185/TALK",
            "narrator": "ガブリエラ",
            "text": "キレちゃった、\nってわけね。",
            "zh": "就是说\n发飙了，是吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "186/TALK",
            "narrator": "アーヤ",
            "text": "…恥ずかしながらね。",
            "zh": "……说来惭愧呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。\nアーヤってさ、普段は凄く\nお姉さんぶってるのに――",
            "zh": "唉……。\n绫水平时明明\n超爱装姐姐——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "189/TALK",
            "narrator": "ガブリエラ",
            "text": "時々、そうやって\nキレることあるわよね？",
            "zh": "偶尔也会那样\n突然发火，对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "え、ええ…そうね…。",
            "zh": "嗯、嗯……是呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "正直、アーヤのそういう\nところって、あたしは\nかっこ悪くて嫌いよ。",
            "zh": "说实话，绫水那种\n地方，我觉得\n又丢人又讨厌哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラ",
            "text": "…でもまあ――",
            "zh": "…不过嘛——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤの好きな人には、\nそういうところが可愛くて\n良いんだろうけどね。",
            "zh": "对绫水喜欢的人来说，\n那种地方大概\n可爱得正好呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "198/TALK",
            "narrator": "アーヤ",
            "text": "そんな、まさか…。\nそれはないわよ。",
            "zh": "那种，怎么可能……。\n不会有的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "200/TALK",
            "narrator": "ガブリエラ",
            "text": "あるって、絶対。",
            "zh": "肯定有，绝对。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/TALK",
            "narrator": "アーヤ",
            "text": "無いから、絶対。",
            "zh": "才没有，绝对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/TALK",
            "narrator": "ガブリエラ",
            "text": "もう！",
            "zh": "真是！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "ガブリエラ",
            "text": "だったら、今この場で\n聞いてみてよ。",
            "zh": "那样的话，就在这里\n问问看吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "207/TALK",
            "narrator": "アーヤ",
            "text": "はぁ！？\n無理よ、そんなの！\n絶対無理だから！",
            "zh": "哈！？\n不行，那种事！\n绝对不行！",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/TALK",
            "narrator": "ガブリエラ",
            "text": "いいじゃん、ちょっと\n聞くくらいなんだし。",
            "zh": "有什么关系，\n不过是问一句嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "アーヤ",
            "text": "無理だってば！\nっていうか、それのどこが\n可愛いのよ？",
            "zh": "不行就是不行！\n再说，那种地方\n哪里可爱了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/TALK",
            "narrator": "ガブリエラ",
            "text": "いいから、今すぐ聞く！\n今日くらい、あたしの\n言うこと聞きなさいよ。",
            "zh": "别废话，现在就问！\n至少今天，你得\n听我的哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしはあなた箱を\n回収した、恩人なのよ？",
            "zh": "我可是帮你找回\n“你箱”的恩人哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "アーヤ",
            "text": "そ、それはそうだけど…。",
            "zh": "这、这倒是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "なら、今日は文句\n言わずにあたしの\n言うこと聞きなさい。",
            "zh": "那今天就别抱怨，\n照我说的\n做。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/TALK",
            "narrator": "ガブリエラ",
            "text": "…さ、早く聞いて。",
            "zh": "…来，快点问。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "221/TALK",
            "narrator": "アーヤ",
            "text": "…もぅ、仕方ないわね。",
            "zh": "……真是的，没办法呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "222/TALK",
            "narrator": "アーヤ",
            "text": "本当に、そうなのかしら？",
            "zh": "真的，是那样吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "227/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さん",
            "zh": "$handle$",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "アーヤ",
            "text": "聞きたいことがあるの( ・_・)σﾞ",
            "zh": "我有想问的事( ・_・)σﾞ",
            "narrator_zh": "绫水"
        },
        {
            "location": "230/SEL",
            "narrator": "",
            "text": "何でも聞いて",
            "zh": "问什么都行",
            "narrator_zh": ""
        },
        {
            "location": "231/ACT",
            "narrator": "",
            "text": "何でも聞いて",
            "zh": "问什么都行",
            "narrator_zh": ""
        },
        {
            "location": "233/TALK",
            "narrator": "アーヤ",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "绫水"
        },
        {
            "location": "234/TALK",
            "narrator": "アーヤ",
            "text": "今回の件もそうなんだけど",
            "zh": "这次的事也是",
            "narrator_zh": "绫水"
        },
        {
            "location": "235/TALK",
            "narrator": "アーヤ",
            "text": "私ね",
            "zh": "我啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "236/TALK",
            "narrator": "アーヤ",
            "text": "時々キレることがあるの(-ω-;)",
            "zh": "偶尔会突然发火(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "237/TALK",
            "narrator": "アーヤ",
            "text": "そういうところって",
            "zh": "那种地方啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "238/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんはどう思う？",
            "zh": "$handle$觉得呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "239/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": "绫水"
        },
        {
            "location": "240/TALK",
            "narrator": "アーヤ",
            "text": "どう考えても変よね？(; ;)",
            "zh": "怎么想都很奇怪吧？(; ;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "243/SEL",
            "narrator": "",
            "text": "可愛いから許す",
            "zh": "因为可爱，我原谅你",
            "narrator_zh": ""
        },
        {
            "location": "244/SEL",
            "narrator": "",
            "text": "たまにはいいよね",
            "zh": "偶尔也挺好呢",
            "narrator_zh": ""
        },
        {
            "location": "245/SEL",
            "narrator": "",
            "text": "アーヤってだけで全部あり",
            "zh": "只要是绫水，全都行",
            "narrator_zh": ""
        },
        {
            "location": "246/ACT",
            "narrator": "",
            "text": "可愛いから許す",
            "zh": "因为可爱，我原谅你",
            "narrator_zh": ""
        },
        {
            "location": "249/TALK",
            "narrator": "アーヤ",
            "text": "もー！",
            "zh": "真是的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "250/TALK",
            "narrator": "アーヤ",
            "text": "違うでしょ！？",
            "zh": "不对吧！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "251/TALK",
            "narrator": "アーヤ",
            "text": "そういうこと聞いてるんじゃないのに！(>_<)",
            "zh": "我问的不是那种事！(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "255/ACT",
            "narrator": "",
            "text": "たまには良いよね",
            "zh": "偶尔也不错呢",
            "narrator_zh": ""
        },
        {
            "location": "256/TALK",
            "narrator": "アーヤ",
            "text": "ありなの！？＼(◎o◎)／",
            "zh": "居然可以！？＼(◎o◎)／",
            "narrator_zh": "绫水"
        },
        {
            "location": "258/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "259/TALK",
            "narrator": "アーヤ",
            "text": "もうやらないようにするわ",
            "zh": "我会注意不再犯的",
            "narrator_zh": "绫水"
        },
        {
            "location": "261/TALK",
            "narrator": "アーヤ",
            "text": "恥ずかしいし…(>_<)",
            "zh": "太羞人了……(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "262/ACT",
            "narrator": "",
            "text": "アーヤってだけで全部あり",
            "zh": "只要是绫水，全都行",
            "narrator_zh": ""
        },
        {
            "location": "264/TALK",
            "narrator": "アーヤ",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "绫水"
        },
        {
            "location": "265/TALK",
            "narrator": "アーヤ",
            "text": "なんなのそれ！？",
            "zh": "那是什么！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "普通に可愛いって言われるより",
            "zh": "比起直接被说可爱",
            "narrator_zh": "绫水"
        },
        {
            "location": "268/TALK",
            "narrator": "アーヤ",
            "text": "数倍恥ずかしいんだけど！？(>_<)",
            "zh": "这个害羞好几倍啊！？(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "270/SEL",
            "narrator": "",
            "text": "恥ずかしがらせてみた",
            "zh": "我试着让她害羞了",
            "narrator_zh": ""
        },
        {
            "location": "271/ACT",
            "narrator": "",
            "text": "恥ずかしがらせてみた",
            "zh": "我试着让她害羞了",
            "narrator_zh": ""
        },
        {
            "location": "274/TALK",
            "narrator": "アーヤ",
            "text": "バカ！",
            "zh": "笨蛋！",
            "narrator_zh": "绫水"
        },
        {
            "location": "275/TALK",
            "narrator": "アーヤ",
            "text": "いつかお返しするから！",
            "zh": "总有一天我会报复回来的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "287/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "288/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん…。",
            "zh": "哦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "290/TALK",
            "narrator": "アーヤ",
            "text": "な、なによ？\nそんなニヤニヤして…。",
            "zh": "干、干什么啊？\n笑得那么诡异……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "…顔、赤くなってる。\n相当嬉しいこと言われた\nみたいね。",
            "zh": "……脸红了。\n看来是听到\n相当开心的话呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "292/TALK",
            "narrator": "アーヤ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "294/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ、驚きだわ。\nアーヤがこんな反応\n見せる日が来るなんて。",
            "zh": "呵呵，真意外。\n没想到绫水也会有\n露出这种反应的一天。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "295/TALK",
            "narrator": "ガブリエラ",
            "text": "恋は人を変える、って\nいうけど、本当ね。",
            "zh": "都说恋爱会改变人，\n看来是真的呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "298/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "299/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、ごめん…。\nちょっとからかい過ぎた？",
            "zh": "啊，抱歉…。\n是不是逗过头了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "300/TALK",
            "narrator": "アーヤ",
            "text": "…ううん。\nそうじゃないの。",
            "zh": "…不是。\n不是因为那个。",
            "narrator_zh": "绫水"
        },
        {
            "location": "303/TALK",
            "narrator": "アーヤ",
            "text": "恋は人を変える、って\nいうの…私も何となく\nわかる気がしたから…。",
            "zh": "“恋爱会改变人”\n这句话……我好像\n也有点懂了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "304/TALK",
            "narrator": "ガブリエラ",
            "text": "…あのさ、改めて\nそういうこと言うの、\nやめてもらえる？",
            "zh": "…那个，重新\n说这种话，\n可以别再来一次吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "306/TALK",
            "narrator": "ガブリエラ",
            "text": "今度は、聞いてる\nこっちが恥ずかしく\nなってくるから…。",
            "zh": "这次换\n听的这边\n要害羞了……。",
            "narrator_zh": "加布里埃拉"
        }
    ]
}
