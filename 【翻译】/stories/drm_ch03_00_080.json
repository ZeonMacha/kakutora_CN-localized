        },
        {
            "location": "246/TALK",
            "narrator": "ガブリエラ",
            "text": "みんな変なことばっかり言って",
            "zh": "大家净说些奇怪的话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナも迷惑だったわよね",
            "zh": "玛尔赞娜也被烦到了吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナが人間だとか",
            "zh": "什么玛尔赞娜是人类",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "250/TALK",
            "narrator": "ガブリエラ",
            "text": "付き合い方を考えろだとか",
            "zh": "什么要考虑相处方式",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "251/SEL",
            "narrator": "",
            "text": "ちゃんと聞いて",
            "zh": "好好听着",
            "narrator_zh": ""
        },
        {
            "location": "252/SEL",
            "narrator": "",
            "text": "本当のことを言うよ",
            "zh": "我说真的",
            "narrator_zh": ""
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "大体、冗談にしても面白くないわよね",
            "zh": "说到底，就算是玩笑也一点都不好笑",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/TALK",
            "narrator": "ガブリエラ",
            "text": "なんなのかしら？",
            "zh": "到底是怎么回事呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "256/ACT",
            "narrator": "",
            "text": "ちゃんと聞いて",
            "zh": "好好听着",
            "narrator_zh": ""
        },
        {
            "location": "257/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね、ちゃんとはっきりさせなくちゃいけないわ",
            "zh": "是啊，得好好说清楚",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "260/ACT",
            "narrator": "",
            "text": "本当のことを言うよ",
            "zh": "我说真的",
            "narrator_zh": ""
        },
        {
            "location": "270/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "272/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナからもみんなに言ったほうがいいわ",
