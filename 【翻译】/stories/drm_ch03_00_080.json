   "text": "090_うそはほんとう",
   "zh": "090_谎言即真实",
   "narrator_zh": ""
  },
  {
   "location": "244/TALK",
   "narrator": "ガブリエラ",
   "text": "大変だったわね"
  },
  {
   "location": "246/TALK",
   "narrator": "ガブリエラ",
   "text": "みんな変なことばっかり言って"
  },
  {
   "location": "247/TALK",
   "narrator": "ガブリエラ",
   "text": "マルザンナも迷惑だったわよね"
  },
  {
   "location": "248/TALK",
   "narrator": "ガブリエラ",
   "text": "マルザンナが人間だとか"
  },
  {
   "location": "250/TALK",
   "narrator": "ガブリエラ",
   "text": "付き合い方を考えろだとか"
  },
  {
   "location": "251/SEL",
   "narrator": "",
   "text": "ちゃんと聞いて",
   "zh": "好好听着",
   "narrator_zh": ""
  },
  {
   "location": "252/SEL",
   "narrator": "",
   "text": "本当のことを言うよ",
   "zh": "我说真的",
   "narrator_zh": ""
  },
  {
   "location": "253/TALK",
   "narrator": "ガブリエラ",
   "text": "大体、冗談にしても面白くないわよね"
  },
  {
   "location": "254/TALK",
   "narrator": "ガブリエラ",
   "text": "なんなのかしら？",
   "zh": "到底是怎么回事呢？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "256/ACT",
   "narrator": "",
   "text": "ちゃんと聞いて",
   "zh": "好好听着",
   "narrator_zh": ""
  },
  {
   "location": "257/TALK",
   "narrator": "ガブリエラ",
   "text": "そうよね、ちゃんとはっきりさせなくちゃいけないわ",
   "zh": "是啊，得好好说清楚",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "260/ACT",
   "narrator": "",
   "text": "本当のことを言うよ",
   "zh": "我说真的",
   "narrator_zh": ""
  },
  {
   "location": "270/TALK",
   "narrator": "ガブリエラ",
   "text": "そうよね",
   "zh": "是啊",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "272/TALK",
   "narrator": "ガブリエラ",
   "text": "マルザンナからもみんなに言ったほうがいいわ"
  },
  {
   "location": "274/TALK",
   "narrator": "ガブリエラ",
   "text": "マルザンナはマルザンナだってこと"
  },
  {
   "location": "276/SEL",
   "narrator": "",
   "text": "$handle$だよ",
   "zh": "是$handle$哦",
   "narrator_zh": ""
  },
  {
   "location": "277/ACT",
   "narrator": "",
   "text": "$handle$だよ",
   "zh": "是$handle$哦",
   "narrator_zh": ""
  },
  {
   "location": "280/TALK",
   "narrator": "ガブリエラ",
   "text": "マルザンナ",
   "zh": "玛尔赞娜",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "281/TALK",
   "narrator": "ガブリエラ",
   "text": "へんなこといわないで"
  },
  {
   "location": "283/SEL",
   "narrator": "",
   "text": "マルザンナじゃない。$handle$だよ",
   "zh": "不是玛尔赞娜。是$handle$哦",
   "narrator_zh": ""
  },
  {
   "location": "284/ACT",
   "narrator": "",
   "text": "マルザンナじゃない。$handle$だよ",
   "zh": "不是玛尔赞娜。是$handle$哦",
   "narrator_zh": ""
  },
  {
   "location": "286/TALK",
   "narrator": "ガブリエラ",
   "text": "その冗談は面白くないって言っているでしょう？",
   "zh": "我说过那个玩笑不好笑吧？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "287/SEL",
   "narrator": "",
   "text": "きみと話しているのは人間の$handle$",
   "zh": "在跟你说话的是人类的$handle$",
   "narrator_zh": ""
  },
  {
   "location": "288/TALK",
   "narrator": "ガブリエラ",
   "text": "サプライズイベントか何かのつもりなのかしら？"
  },
  {
   "location": "289/TALK",
   "narrator": "ガブリエラ",
   "text": "でもね、こんなサプライズ、必要ないのよ？",
   "zh": "不过呢，这种惊喜不需要吧？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "290/TALK",
   "narrator": "ガブリエラ",
   "text": "そもそも誰も楽しくないわ、こんなこと",
   "zh": "说起来谁都不开心，这种事",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "291/TALK",
   "narrator": "ガブリエラ",
   "text": "マルザンナだって楽しいって思ってやってるわけじゃないんでしょう？"
  },
  {
   "location": "293/ACT",
   "narrator": "",
   "text": "きみと話しているのは人間の$handle$",
   "zh": "在跟你说话的是人类的$handle$",
   "narrator_zh": ""
  },
  {
   "location": "295/TALK",
   "narrator": "ガブリエラ",
   "text": "わかったわ！"
  },
  {
   "location": "296/TALK",
   "narrator": "ガブリエラ",
   "text": "誰かが私に意地悪をしたいんでしょう？"
  },
  {
   "location": "297/TALK",
   "narrator": "ガブリエラ",
   "text": "つばめに優しくしなかったから？",
   "zh": "是因为你没对燕温柔？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "299/TALK",
   "narrator": "ガブリエラ",
   "text": "アーヤに突っかかったから？"
  },
  {
   "location": "300/TALK",
   "narrator": "ガブリエラ",
   "text": "それともみやび？",
   "zh": "还是说是雅？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "301/TALK",
   "narrator": "ガブリエラ",
   "text": "謝るから本当のことを教えてちょうだい"
  },
  {
   "location": "303/SEL",
   "narrator": "",
   "text": "$handle$は人間",
   "zh": "$handle$是人类",
   "narrator_zh": ""
  },
  {
   "location": "304/ACT",
   "narrator": "",
   "text": "$handle$は人間",
   "zh": "$handle$是人类",
   "narrator_zh": ""
  },
  {
   "location": "306/TALK",
   "narrator": "ガブリエラ",
   "text": "どうしても",
   "zh": "无论如何",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "307/TALK",
   "narrator": "ガブリエラ",
   "text": "どうしてもそう言い張るのね",
   "zh": "你还真是硬要这么说呢",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "308/TALK",
   "narrator": "ガブリエラ",
   "text": "わかったわ、今日はそういうことにしておいてあげる"
  },
  {
   "location": "309/TALK",
   "narrator": "ガブリエラ",
   "text": "バイバイ",
   "zh": "拜拜",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "317/TALK",
   "narrator": "ボイスメール",
   "text": "戦いの女神は実在しない"
  },
  {
