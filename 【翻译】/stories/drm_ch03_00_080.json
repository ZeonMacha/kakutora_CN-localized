        },
        {
            "location": "277/ACT",
            "narrator": "",
            "text": "$handle$だよ",
            "zh": "是$handle$哦",
            "narrator_zh": ""
        },
        {
            "location": "280/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナ",
            "zh": "玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "281/TALK",
            "narrator": "ガブリエラ",
            "text": "へんなこといわないで",
            "zh": "别说奇怪的话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "283/SEL",
            "narrator": "",
            "text": "マルザンナじゃない。$handle$だよ",
            "zh": "不是玛尔赞娜。是$handle$哦",
            "narrator_zh": ""
        },
        {
            "location": "284/ACT",
            "narrator": "",
            "text": "マルザンナじゃない。$handle$だよ",
            "zh": "不是玛尔赞娜。是$handle$哦",
            "narrator_zh": ""
        },
        {
            "location": "286/TALK",
            "narrator": "ガブリエラ",
            "text": "その冗談は面白くないって言っているでしょう？",
            "zh": "我说过那个玩笑不好笑吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "287/SEL",
            "narrator": "",
            "text": "きみと話しているのは人間の$handle$",
            "zh": "在跟你说话的是人类的$handle$",
            "narrator_zh": ""
        },
        {
            "location": "288/TALK",
            "narrator": "ガブリエラ",
            "text": "サプライズイベントか何かのつもりなのかしら？",
            "zh": "是打算当成惊喜活动什么的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/TALK",
            "narrator": "ガブリエラ",
            "text": "でもね、こんなサプライズ、必要ないのよ？",
            "zh": "不过呢，这种惊喜不需要吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "290/TALK",
            "narrator": "ガブリエラ",
            "text": "そもそも誰も楽しくないわ、こんなこと",
            "zh": "说起来谁都不开心，这种事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナだって楽しいって思ってやってるわけじゃないんでしょう？",
            "zh": "玛尔赞娜也不是觉得好玩才做的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "293/ACT",
            "narrator": "",
            "text": "きみと話しているのは人間の$handle$",
            "zh": "在跟你说话的是人类的$handle$",
            "narrator_zh": ""
        },
        {
            "location": "295/TALK",
            "narrator": "ガブリエラ",
            "text": "わかったわ！",
            "zh": "我知道了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "296/TALK",
            "narrator": "ガブリエラ",
            "text": "誰かが私に意地悪をしたいんでしょう？",
            "zh": "是谁想对我使坏吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "297/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめに優しくしなかったから？",
            "zh": "是因为你没对燕温柔？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "299/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤに突っかかったから？",
            "zh": "因为我顶撞了绫水？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "300/TALK",
            "narrator": "ガブリエラ",
            "text": "それともみやび？",
            "zh": "还是说是雅？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "301/TALK",
            "narrator": "ガブリエラ",
            "text": "謝るから本当のことを教えてちょうだい",
            "zh": "我道歉，把真相告诉我",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "303/SEL",
            "narrator": "",
            "text": "$handle$は人間",
            "zh": "$handle$是人类",
            "narrator_zh": ""
        },
        {
            "location": "304/ACT",
            "narrator": "",
            "text": "$handle$は人間",
            "zh": "$handle$是人类",
            "narrator_zh": ""
        },
        {
            "location": "306/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしても",
            "zh": "无论如何",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "307/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしてもそう言い張るのね",
