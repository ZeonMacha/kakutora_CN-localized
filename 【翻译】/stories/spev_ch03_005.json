        "title": "スペシャルエピソード",
        "sub_title": "更衣室での秘め事",
        "title_zh": "特别篇",
        "sub_title_zh": "更衣室里的隐秘"
    },
    "entry": [
        {
            "location": "27/TALK",
            "narrator": "透明みやび",
            "text": "しっかし、アーヤは\nまっこと似合うなぁ…。",
            "zh": "不过，绫水\n真是蛮衬这身啵……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "28/TALK",
            "narrator": "透明アーヤ",
            "text": "そう？\nみんなだって、\nとっても素敵よ。",
            "zh": "是吗？\n大家穿起来，\n也都很漂亮哦。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "30/TALK",
            "narrator": "透明つばめ",
            "text": "うぅ…でも、やっぱり\nちょっと恥ずかしいです。",
            "zh": "呜……不过，果然\n还是有点害羞。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "31/TALK",
            "narrator": "透明神楽",
            "text": "あ、またシャッター\nチャンスです！",
            "zh": "啊，又是绝佳的\n抓拍机会！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "36/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あ～、息苦しい…。\nあたし、ちょっと脱いで\nくるから。",
            "zh": "啊～，好闷呀……\n我先去把它\n脱下来了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "透明神楽",
            "text": "えっ？\nもう脱いじゃうんですか？",
            "zh": "诶？\n这就已经要脱了吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "38/TALK",
            "narrator": "透明ガブリエラ",
            "text": "本番でもないのに、\n長時間着てても\n疲れるだけでしょ？",
            "zh": "又不是正式婚礼，\n穿太长时间\n也只是白白累人吧？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "39/TALK",
            "narrator": "透明ガブリエラ",
            "text": "じゃ、お先に。",
            "zh": "那我先走一步了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…さて、と。",
            "zh": "……好了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "透明ガブリエラ",
            "text": "えっと…、\nこの辺でどうかしら？",
            "zh": "嗯……\n这个角度怎么样呢？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…もうちょっと上？\nじゃ、これくらいで…。",
            "zh": "……再往上一点？\n那、这样差不多……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "透明ガブリエラ",
            "text": "うわっ、胸見えちゃう！",
            "zh": "哇，胸口要露出来了！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "透明ガブリエラ",
            "text": "それじゃ…ここ！",
            "zh": "那就……这里！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "透明ガブリエラ",
            "text": "やった！\nナイスショット！",
            "zh": "太好了！\nNice shot！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "63/SEL",
            "narrator": "（選択肢）",
            "text": "自撮り？",
            "zh": "在自拍？",
            "narrator_zh": "（选项）"
