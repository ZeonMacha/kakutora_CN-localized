{
    "dir": "chap01/battle/btev_ch01_01_01.js",
    "type": "Other",
    "info": {
        "story_id": "60101",
        "cid": "tsubame",
        "title": "最大幸福論＜葛藤＞",
        "sub_title": "バトル中間",
        "title_zh": "最大幸福论＜纠葛＞",
        "sub_title_zh": "战斗中途"
    },
    "entry": [
        {
            "location": "262/SCENARIO",
            "narrator": "",
            "text": "バトル中間",
            "zh": "战斗中途",
            "narrator_zh": ""
        },
        {
            "location": "272/TALK",
            "narrator": "表層つばめ",
            "text": "っ！？\nあなたは…",
            "zh": "！？\n你是……",
            "narrator_zh": "表层燕"
        },
        {
            "location": "273/TALK",
            "narrator": "潜在つばめ",
            "text": "わたしは\nあなたとは違うわたし。\nそして東京行き反対派。",
            "zh": "我是\n和你不一样的我。\n而且是反对去东京的一派。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "274/TALK",
            "narrator": "潜在つばめ",
            "text": "そう、今戦った\n[クラン]をけしかけた\nのはわたしだよ。",
            "zh": "对，刚才交战的\n[库兰]，是我\n放出来的。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "275/TALK",
            "narrator": "潜在つばめ",
            "text": "ねえ、ライブに\n行きたいわたし。\nもう諦めようよ。",
            "zh": "我说，想去\n演唱会的我。\n还是放弃吧。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "276/TALK",
            "narrator": "潜在つばめ",
            "text": "お母さんが大変なとき\nなのに、一人で楽しむ\nなんてできないよね？",
            "zh": "妈妈正难受的时候，\n一个人去玩，\n做不到吧？",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "277/TALK",
            "narrator": "表層つばめ",
            "text": "でも！",
            "zh": "可是！",
            "narrator_zh": "表层燕"
        },
        {
            "location": "278/TALK",
            "narrator": "表層つばめ",
            "text": "メノウちゃんのライブ\nだって、何年も楽しみ\nにしてたんだから！",
            "zh": "MENOW的演唱会，\n我也盼了\n好几年了呀！",
            "narrator_zh": "表层燕"
        },
        {
            "location": "279/TALK",
            "narrator": "潜在つばめ",
            "text": "メノウちゃんのライブ\nならきっと、またすぐ\nあるよ。",
            "zh": "MENOW的演唱会，\n一定很快\n还会有的。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "280/TALK",
            "narrator": "潜在つばめ",
            "text": "それだけの理由なら、\n次のライブまで\n待ってもいいじゃん。",
            "zh": "如果只是这个理由，\n等到下一场演唱会\n也可以吧。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "281/TALK",
            "narrator": "表層つばめ",
            "text": "ううん、でも、\nそれだけじゃない\n気がする。",
            "zh": "不，可是，\n我觉得\n不只是这个。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "282/TALK",
            "narrator": "潜在つばめ",
            "text": "……じゃあ他に何が？",
            "zh": "……那还有什么？",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "283/TALK",
            "narrator": "表層つばめ",
            "text": "それは…",
            "zh": "那个……",
            "narrator_zh": "表层燕"
        },
        {
            "location": "284/TALK",
            "narrator": "表層つばめ",
            "text": "それは……今は\nちょっと分からない\nかも。",
            "zh": "那个……现在\n也许还\n不太清楚。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "285/TALK",
            "narrator": "潜在つばめ",
            "text": "はぁ。\nもういいよ。",
            "zh": "哈啊。\n算了。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "286/TALK",
            "narrator": "潜在つばめ",
            "text": "とにかくあなたを\n倒して、東京行きを\n諦めさせないと――",
            "zh": "总之不打倒你，\n不让你放弃\n去东京的话——",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "287/TALK",
            "narrator": "潜在つばめ",
            "text": "このままじゃずっと\nわたしの本体が\n悩みっぱなしだから。",
            "zh": "再这样下去，\n我的本体会\n一直烦恼下去。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "289/TALK",
            "narrator": "表層つばめ",
            "text": "それはこっちの\nセリフだよ！",
            "zh": "这句话\n该我说才对！",
            "narrator_zh": "表层燕"
        },
        {
            "location": "290/TALK",
            "narrator": "潜在つばめ",
            "text": "両者一歩も退かずだね。\nそれじゃ――",
            "zh": "两边都不让步呀。\n那么——",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "291/TALK",
            "narrator": "潜在つばめ",
            "text": "次の戦いで\n決着を着けよう。",
            "zh": "就在下一场战斗里\n分出胜负吧。",
            "narrator_zh": "潜在燕"
        }
    ]
}
