{
    "dir": "chap07/daydra/dd_ch04_07_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "7405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "劇場の日常＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "剧场的日常＜后篇＞"
    },
    "entry": [
        {
            "location": "373/SCENARIO",
            "narrator": "",
            "text": "劇場の日常",
            "zh": "剧场的日常",
            "narrator_zh": ""
        },
        {
            "location": "389/TALK",
            "narrator": "みやび",
            "text": "…いや、やはり\nやめといた方が\nえいかもしれん。",
            "zh": "……不，果然\n还是不干\n比较好咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "390/TALK",
            "narrator": "みやび",
            "text": "ただでさえウサギは\nオーバーワーク状態\nなんやし――",
            "zh": "兔子本来就已经\n处于超负荷状态\n了嘛——",
            "narrator_zh": "雅"
        },
        {
            "location": "391/TALK",
            "narrator": "みやび",
            "text": "これ以上負担を\n掛けるわけには\nいかんし。",
            "zh": "不能再给它\n加负担\n了。",
            "narrator_zh": "雅"
        },
        {
            "location": "392/TALK",
            "narrator": "みやび",
            "text": "…まあ、この件は\n保留っちゅうことに\nしとくか。",
            "zh": "……嘛，这件事\n就先标记为\n保留咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "393/SEL",
            "narrator": "",
            "text": "そろそろ楽屋に戻らない？",
            "zh": "差不多该回化妆间了吧？",
            "narrator_zh": ""
        },
        {
            "location": "394/ACT",
            "narrator": "",
            "text": "そろそろ楽屋に戻らない？",
            "zh": "差不多该回化妆间了吧？",
            "narrator_zh": ""
        },
        {
            "location": "413/TALK",
            "narrator": "みやび",
            "text": "そういえば",
            "zh": "说起来",
            "narrator_zh": "雅"
        },
        {
            "location": "414/TALK",
            "narrator": "みやび",
            "text": "大分時間が経っちょるな",
            "zh": "时间已经过去好一阵了咯",
            "narrator_zh": "雅"
        },
        {
            "location": "415/TALK",
            "narrator": "みやび",
            "text": "チャットに夢中になってたか",
            "zh": "光顾着聊天了啊",
            "narrator_zh": "雅"
        },
        {
            "location": "416/TALK",
            "narrator": "みやび",
            "text": "ならば、現実へ戻ろう",
            "zh": "那么，回现实去吧",
            "narrator_zh": "雅"
        },
        {
            "location": "417/TALK",
            "narrator": "みやび",
            "text": "さらば電脳ワールド",
            "zh": "别了，电脑世界",
            "narrator_zh": "雅"
        },
        {
            "location": "428/TALK",
            "narrator": "みやび",
            "text": "また連絡する、と。",
            "zh": "回头再联系，就这样。",
            "narrator_zh": "雅"
        },
        {
            "location": "467/TALK",
            "narrator": "みやび",
            "text": "…おつかれ。",
            "zh": "……辛苦了。",
            "narrator_zh": "雅"
        },
        {
            "location": "470/TALK",
            "narrator": "アーヤ",
            "text": "ああ、みやび。\nまたネット見たり\nしてたんでしょ？",
            "zh": "啊，雅。\n你又上网东看西看\n了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "471/TALK",
            "narrator": "みやび",
            "text": "やることはちゃんと\nやったき、何も問題\nないちや。",
            "zh": "该干的都好好\n干完了啵，一点问题\n都没得滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "473/TALK",
            "narrator": "みやび",
            "text": "それにしても…、\n楽屋がこざっぱりした\n気がするがよ。",
            "zh": "话说回来……，\n总觉得化妆间\n清爽了不少啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "475/TALK",
            "narrator": "アーヤ",
            "text": "今、丁度その話を\nしてたところよ。",
            "zh": "现在，正好说到\n这个呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "478/TALK",
            "narrator": "つばめ",
            "text": "どうですか、\nせんぱい？",
            "zh": "怎么样，\n前辈？",
            "narrator_zh": "燕"
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "…うん、問題なし。\nちゃんと全部あるわ。",
            "zh": "……嗯，没问题。\n东西都好好地在。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "482/TALK",
            "narrator": "ガブリエラ",
            "text": "新人にも、少しは\n物を見る目が出来て\nきたようね。",
            "zh": "新人也稍微\n长了点辨东西的\n眼光了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "484/TALK",
            "narrator": "つばめ",
            "text": "ほっ、よかったぁ…。",
            "zh": "呼，太好了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "486/TALK",
            "narrator": "みやび",
            "text": "…何やってるが？",
            "zh": "……在搞驷马？",
            "narrator_zh": "雅"
        },
        {
            "location": "488/TALK",
            "narrator": "アーヤ",
            "text": "ほら、前につばめが\n楽屋掃除した時――",
            "zh": "你看，之前燕\n打扫化妆间的时候——",
            "narrator_zh": "绫水"
        },
        {
            "location": "489/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィの私物を\n捨てちゃったことが\nあったでしょ？",
            "zh": "把加维的私物\n给扔掉了，\n有过这回事吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "490/TALK",
            "narrator": "アーヤ",
            "text": "だから、自分の物が\n捨てられてないか\n確認してたのよ。",
            "zh": "所以，她在确认\n自己的东西\n有没有被扔掉呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "492/TALK",
            "narrator": "みやび",
            "text": "なるほどなぁ…。\nけんど、ここにある\nガブちゃんの私物――",
            "zh": "原来如此啊……。\n但是，这里的这些\n加布的私物——",
            "narrator_zh": "雅"
        },
        {
            "location": "496/TALK",
            "narrator": "みやび",
            "text": "うちには、ゴミにしか\n見えんけんどね。",
            "zh": "在我眼里，怎么看\n都只是垃圾，但是呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "499/TALK",
            "narrator": "ガブリエラ",
            "text": "失礼ね。\nこれのどこが\nゴミなのよ？",
            "zh": "没礼貌。\n这东西哪里\n是垃圾了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "501/TALK",
            "narrator": "みやび",
            "text": "じゃあ、そこにある\n空になったたこ焼きの\n器は？",
            "zh": "那，摆在那的\n空章鱼烧\n盒子呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "502/TALK",
            "narrator": "ガブリエラ",
            "text": "ゴミじゃないわ。\n船の形してる、\n珍しい物なんだから。",
            "zh": "才不是垃圾。\n是船的形状，\n很稀有的东西。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "504/TALK",
            "narrator": "みやび",
            "text": "…そんな珍しいとは\n思えんのやが。",
            "zh": "……我可看不出\n哪里稀有的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "506/TALK",
            "narrator": "アーヤ",
            "text": "このボロ衣は何？",
            "zh": "这块破布是什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "508/TALK",
            "narrator": "ガブリエラ",
            "text": "それは前にフリマで\n買ったものよ。",
            "zh": "那是之前在\n跳蚤市场买的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "509/TALK",
            "narrator": "ガブリエラ",
            "text": "着物の生地で作った、\n手作りハンカチ、って\n言ってたわ。",
            "zh": "用和服布料做的\n手工手帕，\n卖的人这么说的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "511/TALK",
            "narrator": "みやび",
            "text": "…何故よりによって\n着物生地で作るが？",
            "zh": "……为什么偏挑\n和服布料来做啊？",
            "narrator_zh": "雅"
        },
        {
            "location": "515/TALK",
            "narrator": "ガブリエラ",
            "text": "知らないわよ。\n売ってた人が作った\nものなんだから。",
            "zh": "我哪知道。\n是卖的人做的\n东西嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "519/TALK",
            "narrator": "つばめ",
            "text": "でも、ちゃんと見ると\n素敵な物もあります\nよね。",
            "zh": "不过，好好看的话\n也有很棒的\n东西呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "521/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ？",
            "zh": "诶？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "522/TALK",
            "narrator": "つばめ",
            "text": "正直、わたしにも\nよくわからない物は\n沢山ありますけど――",
            "zh": "说实话，对我来说\n看不懂的东西\n也很多，但是——",
            "narrator_zh": "燕"
        },
        {
            "location": "525/TALK",
            "narrator": "つばめ",
            "text": "でも、さっきの\nハンカチとかは、\n素敵と思いました。",
            "zh": "但是，刚才那块\n手帕什么的，\n我觉得很棒。",
            "narrator_zh": "燕"
        },
        {
            "location": "526/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そう…。\n素敵だと思ったんだ？",
            "zh": "这、这样……。\n你觉得很棒？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "527/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな風に褒めて\nもらったのって、\n初めてだわ…。",
            "zh": "被人这样夸，\n还是头一回\n呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "529/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、当然のこと\n言われても嬉しく\nないから！",
            "zh": "不过，被说这是\n理所当然的话，\n我可不会高兴！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "531/TALK",
            "narrator": "つばめ",
            "text": "あ、あはは…。",
            "zh": "啊，啊哈哈……。",
            "narrator_zh": "燕"
        },
        {
            "location": "534/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、つばめの\n言うこともわから\nなくはないかも。",
            "zh": "……嘛，燕说的话\n也不是不能\n理解吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "537/TALK",
            "narrator": "アーヤ",
            "text": "あそこに飾ってある\nひな人形なんか、\n結構素敵だし。",
            "zh": "那边摆着的\n女儿节人偶，\n就相当不错。",
            "narrator_zh": "绫水"
        },
        {
            "location": "541/TALK",
            "narrator": "みやび",
            "text": "かなりの年代物みたい\nやけんど…どこで\n見つけたが？",
            "zh": "好像是相当有年代的\n老货……在哪\n找到的啊？",
            "narrator_zh": "雅"
        },
        {
            "location": "543/TALK",
            "narrator": "ガブリエラ",
            "text": "トップシークレットに\n決まってるでしょ。\n誰にも教えないわ。",
            "zh": "当然是最高机密，\n这还用说嘛。\n谁都不会告诉的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "544/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、地道に自分の\n足を使って探し回った\n結果、かしら？",
            "zh": "不过，大概是靠\n自己一步一个脚印\n到处找的成果吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "550/TALK",
            "narrator": "つばめ",
            "text": "ふふっ、こんなに\n色んな物を見つけて\nくるなんて――",
            "zh": "呵呵，竟然能找到\n这么多各种各样的\n东西——",
            "narrator_zh": "燕"
        },
        {
            "location": "551/TALK",
            "narrator": "つばめ",
            "text": "なんか、光る物を\n拾ってきちゃう、\n鳥さんみたいですね。",
            "zh": "总感觉，像是会捡\n亮晶晶东西回来的\n鸟儿一样呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "555/TALK",
            "narrator": "ガブリエラ",
            "text": "そうそう、鳥のように\nあちこちを探し\nまわって――",
            "zh": "对对，像鸟一样\n到处转来转去\n地找——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "556/TALK",
            "narrator": "ガブリエラ",
            "text": "…鳥？",
            "zh": "……鸟？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "559/TALK",
            "narrator": "つばめ",
            "text": "はい、鳥です。",
            "zh": "嗯，鸟哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "562/TALK",
            "narrator": "ガブリエラ",
            "text": "………………。",
            "zh": "………………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "566/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "569/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "570/TALK",
            "narrator": "ガブリエラ",
            "text": "あ…あ、あ――",
            "zh": "啊…啊、啊——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "575/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは\nアホな鳥か！？",
            "zh": "我是\n笨鸟吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "582/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nアホじゃなくて、\n可愛い鳥さんですよ！",
            "zh": "诶！？\n不是笨鸟，\n是可爱的鸟儿哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "585/TALK",
            "narrator": "ガブリエラ",
            "text": "光る物を拾ってくる\n鳥なんて、アホに\n決まってるでしょ！？",
            "zh": "会捡亮晶晶东西的\n鸟，肯定是\n笨蛋吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "590/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、\n新人のバカ！\n大っ嫌い！！",
            "zh": "真是的，\n新人是笨蛋！\n最讨厌了！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "595/TALK",
            "narrator": "つばめ",
            "text": "あっ、せんぱい！",
            "zh": "啊，前辈！",
            "narrator_zh": "燕"
        },
        {
            "location": "597/TALK",
            "narrator": "つばめ",
            "text": "…誤解なのにぃ。",
            "zh": "……明明是误会嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "601/TALK",
            "narrator": "アーヤ",
            "text": "え、えっと…、\n大丈夫よ、逢瀬さん。",
            "zh": "那、那个…，\n没事的，逢濑。",
            "narrator_zh": "绫水"
        },
        {
            "location": "602/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィの癇癪は\nいつものことだから、\nね？",
            "zh": "加维发脾气是\n常有的事，\n对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "603/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "605/TALK",
            "narrator": "みやび",
            "text": "…本当、この子は\n天然さんやねぇ。",
            "zh": "……真的，这孩子\n是个天然呆咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "607/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんも\nペース狂わされて\n大変そうや。",
            "zh": "加布的节奏\n被搅得一塌糊涂，\n看着都够呛咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "608/SEL",
            "narrator": "",
            "text": "つばめは、多分敵じゃないかも",
            "zh": "燕，多半不是敌人",
            "narrator_zh": ""
        },
        {
            "location": "609/ACT",
            "narrator": "",
            "text": "つばめは、多分敵じゃないかも",
            "zh": "燕，多半不是敌人",
            "narrator_zh": ""
        },
        {
            "location": "630/TALK",
            "narrator": "みやび",
            "text": "これはビックリ",
            "zh": "这就让人吃惊了",
            "narrator_zh": "雅"
        },
        {
            "location": "632/TALK",
            "narrator": "みやび",
            "text": "相棒もあの子疑うてたが？",
            "zh": "搭档也怀疑那孩子了啊？",
            "narrator_zh": "雅"
        },
        {
            "location": "634/SEL",
            "narrator": "",
            "text": "謎の多い子だから、一応ね",
            "zh": "谜团多的孩子嘛，姑且",
            "narrator_zh": ""
        },
        {
            "location": "635/SEL",
            "narrator": "",
            "text": "無闇に信じるのは危険だよ",
            "zh": "轻信是有危险的哦",
            "narrator_zh": ""
        },
        {
            "location": "636/ACT",
            "narrator": "",
            "text": "謎の多い子だから、一応ね",
            "zh": "谜团多的孩子嘛，姑且",
            "narrator_zh": ""
        },
        {
            "location": "637/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんだけやない",
            "zh": "不只燕一个",
            "narrator_zh": "雅"
        },
        {
            "location": "638/TALK",
            "narrator": "みやび",
            "text": "卯月も同じくらい謎だらけ",
            "zh": "卯月也一样是谜团满满",
            "narrator_zh": "雅"
        },
        {
            "location": "639/TALK",
            "narrator": "みやび",
            "text": "うちにはＵＭＡも同然やき",
            "zh": "对我来说跟ＵＭＡ也没两样啵",
            "narrator_zh": "雅"
        },
        {
            "location": "640/TALK",
            "narrator": "みやび",
            "text": "無闇に信じるんは、危険や",
            "zh": "轻信，是危险的",
            "narrator_zh": "雅"
        },
        {
            "location": "641/ACT",
            "narrator": "",
            "text": "無闇に信じるのは危険だよ",
            "zh": "轻信是有危险的哦",
            "narrator_zh": ""
        },
        {
            "location": "642/TALK",
            "narrator": "みやび",
            "text": "その通り",
            "zh": "说得没错",
            "narrator_zh": "雅"
        },
        {
            "location": "643/TALK",
            "narrator": "みやび",
            "text": "うちも、つばめちゃんは卯月はもちろん",
            "zh": "我这边，燕和卯月自不必说",
            "narrator_zh": "雅"
        },
        {
            "location": "644/TALK",
            "narrator": "みやび",
            "text": "正直",
            "zh": "老实说",
            "narrator_zh": "雅"
        },
        {
            "location": "645/TALK",
            "narrator": "みやび",
            "text": "アーヤもガブちゃんも",
            "zh": "绫水和加布也是",
            "narrator_zh": "雅"
        },
        {
            "location": "646/TALK",
            "narrator": "みやび",
            "text": "心から信用してはおらん",
            "zh": "我都没有打心底信任",
            "narrator_zh": "雅"
        },
        {
            "location": "647/TALK",
            "narrator": "みやび",
            "text": "みんな、何かしら謎を抱えちょるき",
            "zh": "每个人，都抱着点什么谜团啵",
            "narrator_zh": "雅"
        },
        {
            "location": "649/TALK",
            "narrator": "みやび",
            "text": "しかし驚いた",
            "zh": "不过真让人吃惊",
            "narrator_zh": "雅"
        },
        {
            "location": "650/TALK",
            "narrator": "みやび",
            "text": "相棒もうちと同じで",
            "zh": "搭档也和我一样",
            "narrator_zh": "雅"
        },
        {
            "location": "651/TALK",
            "narrator": "みやび",
            "text": "無闇に信じたりせんとは",
            "zh": "竟不会随便轻信什么",
            "narrator_zh": "雅"
        },
        {
            "location": "652/TALK",
            "narrator": "みやび",
            "text": "うちと相棒は",
            "zh": "我和搭档这是",
            "narrator_zh": "雅"
        },
        {
            "location": "653/TALK",
            "narrator": "みやび",
            "text": "相思相愛？",
            "zh": "两情相悦？",
            "narrator_zh": "雅"
        },
        {
            "location": "654/TALK",
            "narrator": "みやび",
            "text": "それは言い過ぎ",
            "zh": "那说过头了",
            "narrator_zh": "雅"
        },
        {
            "location": "655/TALK",
            "narrator": "みやび",
            "text": "以心伝心？",
            "zh": "心有灵犀？",
            "narrator_zh": "雅"
        },
        {
            "location": "656/TALK",
            "narrator": "みやび",
            "text": "それも言い過ぎ",
            "zh": "那也说过头了",
            "narrator_zh": "雅"
        },
        {
            "location": "657/TALK",
            "narrator": "みやび",
            "text": "気が合う",
            "zh": "挺合拍",
            "narrator_zh": "雅"
        },
        {
            "location": "658/TALK",
            "narrator": "みやび",
            "text": "それやね",
            "zh": "就是咯",
            "narrator_zh": "雅"
        },
        {
            "location": "660/TALK",
            "narrator": "みやび",
            "text": "そんな相棒にお悩みチャット相談",
            "zh": "那就给这样的搭档来个烦恼聊天咨询",
            "narrator_zh": "雅"
        },
        {
            "location": "661/TALK",
            "narrator": "みやび",
            "text": "うちは今",
            "zh": "我如今",
            "narrator_zh": "雅"
        },
        {
            "location": "662/TALK",
            "narrator": "みやび",
            "text": "みんなの秘密を知るために",
            "zh": "为了摸清大家的秘密",
            "narrator_zh": "雅"
        },
        {
            "location": "663/TALK",
            "narrator": "みやび",
            "text": "裏で色々しちょるところで",
            "zh": "正在背地里干着各种事",
            "narrator_zh": "雅"
        },
        {
            "location": "664/TALK",
            "narrator": "みやび",
            "text": "仲間を大募集中だったりするちや",
            "zh": "正大举招募同伴滴",
            "narrator_zh": "雅"
        },
        {
            "location": "665/TALK",
            "narrator": "みやび",
            "text": "つまり",
            "zh": "也就是说",
            "narrator_zh": "雅"
        },
        {
            "location": "666/TALK",
            "narrator": "みやび",
            "text": "相棒をスカウトしよう思うてるんやが",
            "zh": "正琢磨着把搭档挖过来咧",
            "narrator_zh": "雅"
        },
        {
            "location": "668/SEL",
            "narrator": "",
            "text": "プライバシーの侵害にならないレベルなら",
            "zh": "只要不侵犯隐私的话",
            "narrator_zh": ""
        },
        {
            "location": "669/ACT",
            "narrator": "",
            "text": "プライバシーの侵害にならないレベルなら",
            "zh": "只要不侵犯隐私的话",
            "narrator_zh": ""
        },
        {
            "location": "671/TALK",
            "narrator": "みやび",
            "text": "それで構わん",
            "zh": "那样就行",
            "narrator_zh": "雅"
        },
        {
            "location": "672/TALK",
            "narrator": "みやび",
            "text": "とりあえず",
            "zh": "总之先这样",
            "narrator_zh": "雅"
        },
        {
            "location": "673/TALK",
            "narrator": "みやび",
            "text": "話は決まりや",
            "zh": "就这么定了咯",
            "narrator_zh": "雅"
        },
        {
            "location": "674/TALK",
            "narrator": "みやび",
            "text": "これからは、まあ",
            "zh": "今后嘛，就",
            "narrator_zh": "雅"
        },
        {
            "location": "675/TALK",
            "narrator": "みやび",
            "text": "もうちくっと仲良くしような",
            "zh": "再多亲近一点咯",
            "narrator_zh": "雅"
        },
        {
            "location": "677/TALK",
            "narrator": "みやび",
            "text": "あぼん",
            "zh": "吞了",
            "narrator_zh": "雅"
        },
        {
            "location": "678/TALK",
            "narrator": "みやび",
            "text": "すまんミスタッチ",
            "zh": "没好意思，误触了",
            "narrator_zh": "雅"
        },
        {
            "location": "679/TALK",
            "narrator": "みやび",
            "text": "相棒",
            "zh": "搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "700/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【05 金色の髪のカグラ】",
            "zh": "【05 金发的神乐】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
}
