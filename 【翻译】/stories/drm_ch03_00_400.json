{
 "dir": "dramatics/daydra/drm_ch03_00_400.js",
 "type": "Episode",
 "info": {
  "story_id": "3040",
  "cid": "gabriella",
  "title": "らぶとーく  第40話",
  "sub_title": "うさぎの心"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "うさぎの心"
  },
  {
   "location": "25/TALK",
   "narrator": "ガブリエラ",
   "text": "はぁ…。",
   "zh": "哈啊……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "26/TALK",
   "narrator": "ガブリエラ",
   "text": "ヒカルくん、告白は\nもうしたのかしら？"
  },
  {
   "location": "27/TALK",
   "narrator": "ガブリエラ",
   "text": "あれっきり話してない\nからわからないけど…。"
  },
  {
   "location": "29/TALK",
   "narrator": "ガブリエラ",
   "text": "…って、バカバカしい。\nあたしが気にするような\nことじゃないわ。"
  },
  {
   "location": "31/TALK",
   "narrator": "ガブリエラ",
   "text": "はぁ…。",
   "zh": "哈啊……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "34/TALK",
   "narrator": "雛",
   "text": "あららー、本当に\n元気ないねー？"
  },
  {
   "location": "38/TALK",
   "narrator": "ガブリエラ",
   "text": "っ！？\nひ、ひなこ！？",
   "zh": "！？\n雏、雏！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "39/TALK",
   "narrator": "雛",
   "text": "はろー、\nガブリエラちゃん。"
  },
  {
   "location": "42/TALK",
   "narrator": "ガブリエラ",
   "text": "…何の用事？",
   "zh": "……有什么事？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "43/TALK",
   "narrator": "雛",
   "text": "うん、つばめちゃんから\n聞いたんだけど――"
  },
  {
   "location": "44/TALK",
   "narrator": "雛",
   "text": "最近、なーんか元気が\nないみたいだね？"
  },
  {
   "location": "47/TALK",
   "narrator": "ガブリエラ",
   "text": "…え？",
   "zh": "……诶？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "48/TALK",
   "narrator": "ガブリエラ",
   "text": "気付いてない、って\nことは――"
  },
  {
   "location": "49/TALK",
   "narrator": "ガブリエラ",
   "text": "ヒカルくん、\nまだ告白してない、\nってこと？"
  },
  {
   "location": "51/TALK",
   "narrator": "雛",
   "text": "ガブリエラちゃんが\n元気ないなんて、\nちょっと心配でさー。"
  },
  {
   "location": "52/TALK",
   "narrator": "雛",
   "text": "余計なお世話かなー、\nって思ったけど、\n来ちゃいましたー。"
  },
  {
   "location": "55/TALK",
   "narrator": "ガブリエラ",
   "text": "…な、何よ。\n余計なお世話とか、\n今更じゃない。",
   "zh": "……干、干嘛呀。\n多管闲事什么的，\n现在说不是太晚了吗。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "56/TALK",
   "narrator": "ガブリエラ",
   "text": "他人の恋愛話には\n進んで首を突っ込む\nくせに…。"
  },
  {
   "location": "58/TALK",
   "narrator": "雛",
   "text": "あー、それ言われると\n何も言えないなー…。"
  },
  {
   "location": "59/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "62/TALK",
   "narrator": "ガブリエラ",
   "text": "ま、まあ、せっかく\n余計なお世話をしようと\n思って来たなら――"
  },
  {
   "location": "63/TALK",
   "narrator": "ガブリエラ",
   "text": "一つ、相談したい\nことがあるんだけど…。"
  },
  {
   "location": "65/TALK",
   "narrator": "雛",
   "text": "おっ、珍しい！\nガブリエラちゃんから\nそんなこと言うなんて。",
   "zh": "哦，真难得！\n加布里埃拉酱居然\n会说这种话。",
   "narrator_zh": "雏"
  },
  {
   "location": "66/TALK",
   "narrator": "ガブリエラ",
   "text": "…嫌ならいいんだけど？",
   "zh": "……不愿意的话就算了？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "67/TALK",
   "narrator": "雛",
   "text": "まさか！　そのために\n来たんだから――"
  },
  {
   "location": "68/TALK",
   "narrator": "雛",
   "text": "どんな相談でも\n乗るから、どーんと\n相談しちゃってよ！",
   "zh": "什么样的商量我都\n陪你，就大胆地\n来找我商量吧！",
   "narrator_zh": "雏"
  },
  {
   "location": "70/TALK",
   "narrator": "ガブリエラ",
   "text": "人の気も知らないで…。"
  },
  {
   "location": "72/TALK",
   "narrator": "ガブリエラ",
   "text": "…最初に、これだけは\nはっきりさせておく\nけど――",
   "zh": "……首先，这一点\n我要先\n说清楚——",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "73/TALK",
   "narrator": "ガブリエラ",
   "text": "ヒカルくんのことじゃ\nないから。\nそれだけは忘れないで。"
  },
  {
   "location": "75/TALK",
   "narrator": "雛",
   "text": "う、うん…。\nそれで？"
  },
  {
   "location": "76/TALK",
   "narrator": "ガブリエラ",
   "text": "…ある人に、あたしの\n気持ちを伝えたい、って\n思ってるの。"
  },
  {
   "location": "77/TALK",
   "narrator": "ガブリエラ",
   "text": "けど…自分の気持ちを\n相手に伝えるのって――",
   "zh": "可是……把自己的心情\n传达给对方——",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "78/TALK",
   "narrator": "ガブリエラ",
   "text": "どうすればいいか\nわからなくて…。",
   "zh": "不知道该怎么\n办……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "80/TALK",
   "narrator": "雛",
   "text": "ふむふむ、なるほど…。"
  },
  {
   "location": "81/TALK",
   "narrator": "雛",
   "text": "相手がヒカルくんじゃ\nないっていうのが、\n少し驚きだけど――"
  },
  {
   "location": "84/TALK",
   "narrator": "雛",
   "text": "まあ、それなら答えは\n簡単だと思うなー。"
  },
  {
   "location": "86/TALK",
   "narrator": "ガブリエラ",
   "text": "は？　簡単？"
  },
  {
   "location": "87/TALK",
   "narrator": "雛",
   "text": "うん。\n伝えたい気持ちが\nあるんでしょ？"
  },
  {
   "location": "88/TALK",
   "narrator": "雛",
   "text": "だったら、そのまま\n伝えるのが一番じゃん。",
   "zh": "那样的话，直接\n说出来最好啊。",
   "narrator_zh": "雏"
  },
  {
   "location": "89/TALK",
   "narrator": "ガブリエラ",
   "text": "だから、それができない\nから相談してるんじゃ\nない！",
   "zh": "所以，我就是因为做不到\n才来商量的\n不是吗！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "90/TALK",
   "narrator": "雛",
   "text": "そうは言うけどさー。",
   "zh": "话是这么说啦——",
   "narrator_zh": "雏"
  },
  {
   "location": "91/TALK",
   "narrator": "雛",
   "text": "気持ちって、結局のとこ\n言葉にしないと伝え\nられないもんだよ？"
  },
  {
   "location": "92/TALK",
   "narrator": "雛",
   "text": "あ、手紙にしたりする\n方法もあるけど――"
  },
  {
   "location": "93/TALK",
   "narrator": "雛",
   "text": "どっちにしろ、\nそのまま伝える以外に\nないんじゃないかなー？",
   "zh": "不管怎样，除了\n直接说出来\n也没别的办法吧？",
   "narrator_zh": "雏"
  },
  {
   "location": "96/TALK",
   "narrator": "ガブリエラ",
   "text": "そ、それはまあ、\nそうなんだけど…。",
   "zh": "那、那个嘛，\n虽然是没错……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "97/TALK",
   "narrator": "雛",
   "text": "ふふーん、あたしの\n答えは完璧だわ！"
  },
  {
   "location": "99/TALK",
   "narrator": "ガブリエラ",
   "text": "いや、だからそれが\nできないから相談して\nるんじゃない…。"
  },
  {
   "location": "101/TALK",
   "narrator": "雛",
   "text": "あなたが好きです。\n付き合ってください。\nチューしてください。"
  },
  {
   "location": "103/TALK",
   "narrator": "雛",
   "text": "って言えば完璧！！",
   "zh": "这么说就完美了！！",
   "narrator_zh": "雏"
  },
  {
   "location": "104/TALK",
   "narrator": "ガブリエラ",
   "text": "い、言えるわけ\nないでしょ！！"
  },
  {
   "location": "105/TALK",
   "narrator": "ガブリエラ",
   "text": "っていうか、最後の\nチューって何！？",
   "zh": "话说，最后的\n那个亲吻是什么！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "108/TALK",
   "narrator": "雛",
   "text": "キスとか口づけとか\n接吻とか…そういうの？"
  },
  {
   "location": "109/TALK",
   "narrator": "ガブリエラ",
   "text": "いや、だからそういう\nことじゃなくて…。"
  },
  {
   "location": "111/TALK",
   "narrator": "ガブリエラ",
   "text": "はぁ…なんか本当、\nひなこと話してると\n調子狂うわ…。",
   "zh": "唉……真的，\n跟雏说话\n就乱了节奏……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "112/SEL",
   "narrator": "",
   "text": "おーい",
   "zh": "喂——",
   "narrator_zh": ""
  },
  {
   "location": "113/ACT",
   "narrator": "",
   "text": "おーい",
   "zh": "喂——",
   "narrator_zh": ""
  },
  {
   "location": "117/TALK",
   "narrator": "ガブリエラ",
   "text": "まったく、\nうるさいわね…。"
  },
  {
   "location": "120/TALK",
   "narrator": "雛",
   "text": "おっ、ＷＡＶＥ？",
   "zh": "哦，WAVE？",
   "narrator_zh": "雏"
  },
  {
   "location": "121/TALK",
   "narrator": "雛",
   "text": "もしかしてもしかして、\nそれが例の気持ちを\n伝えたい相手？"
  },
  {
   "location": "123/TALK",
   "narrator": "ガブリエラ",
   "text": "っ！？",
   "zh": "！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "124/TALK",
   "narrator": "雛",
   "text": "やっぱり！",
   "zh": "果然！",
   "narrator_zh": "雏"
  },
  {
   "location": "125/TALK",
   "narrator": "雛",
   "text": "いいから、早く返事して\nあげなよ！"
  },
  {
   "location": "126/TALK",
   "narrator": "ガブリエラ",
   "text": "べ、別にいいわよ！\nそんな重要なことでも\nないだろうし…。"
  },
  {
   "location": "127/TALK",
   "narrator": "雛",
   "text": "重要じゃなくても\n出なきゃダメ！"
  },
  {
   "location": "128/TALK",
   "narrator": "雛",
   "text": "相談してきたのは\nガブリエラちゃん\nなんだから――"
  },
  {
   "location": "129/TALK",
   "narrator": "雛",
   "text": "アドバイスには\n従わないとダメですー！"
  },
  {
   "location": "131/TALK",
   "narrator": "ガブリエラ",
   "text": "…今、ひなこに\n相談したのをスゴく\n後悔してるわ…。",
   "zh": "……我现在超级后悔\n跟雏\n商量了这事……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "132/TALK",
   "narrator": "雛",
   "text": "後悔してももう遅いよ。\nほら、返信返信。"
  },
  {
   "location": "133/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "145/TALK",
   "narrator": "ガブリエラ",
   "text": "なんのよう？",
   "zh": "干什么呀？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "146/TALK",
   "narrator": "ガブリエラ",
   "text": "今忙しいんだけど？"
  },
  {
   "location": "148/SEL",
   "narrator": "",
   "text": "じゃあまた後でね",
   "zh": "那就回头见",
   "narrator_zh": ""
  },
  {
   "location": "149/SEL",
   "narrator": "",
   "text": "こっちの方が忙しいんだけど",
   "zh": "这边才更忙啊",
   "narrator_zh": ""
  },
  {
   "location": "150/SEL",
   "narrator": "",
   "text": "何か手伝えることある？",
   "zh": "有我能帮上忙的吗？",
   "narrator_zh": ""
  },
  {
   "location": "151/ACT",
   "narrator": "",
   "text": "じゃあまた後でね",
   "zh": "那就回头见",
   "narrator_zh": ""
  },
  {
   "location": "152/TALK",
   "narrator": "ガブリエラ",
   "text": "ん",
   "zh": "嗯",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "163/TALK",
   "narrator": "ガブリエラ",
   "text": "はぁ…。",
   "zh": "哈啊……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "164/TALK",
   "narrator": "ガブリエラ",
   "text": "またやっちゃった…。",
   "zh": "又搞砸了……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "165/TALK",
   "narrator": "ガブリエラ",
   "text": "もっと、$handle$と\n話したいことあった\nのに…。",
   "zh": "本来还有好多话\n想跟$handle$说\n的……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "168/TALK",
   "narrator": "雛",
   "text": "…………。"
  },
  {
   "location": "170/TALK",
   "narrator": "ガブリエラ",
   "text": "…おまたせ。\nなんでもなかった\nみたい。",
   "zh": "……让你久等了。\n好像没\n出什么事。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "171/TALK",
   "narrator": "雛",
   "text": "ブーッ！！\nブッブー！！",
   "zh": "嘟嘟！！\n哔哔！！",
   "narrator_zh": "雏"
  },
  {
   "location": "172/TALK",
   "narrator": "雛",
   "text": "ガブリエラちゃん！\n今の返信は不正解！！\nマイナス１００点！！",
   "zh": "加布里埃拉！\n你刚才那个回复不正确！！\n扣一百分！！",
   "narrator_zh": "雏"
  },
  {
   "location": "174/TALK",
   "narrator": "ガブリエラ",
   "text": "な、何がよ！？\n別に変なこと書いたり\nしてないでしょ！？",
   "zh": "什、什么啊！？\n我又没写什么\n奇怪的东西吧！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "175/TALK",
   "narrator": "雛",
   "text": "変なことどころか、\n何も書いてないじゃん！"
  },
  {
   "location": "176/TALK",
   "narrator": "雛",
   "text": "もっと押してかないと\nダメなんだって！"
  },
  {
   "location": "177/TALK",
   "narrator": "雛",
   "text": "じゃあまた後でね、\nに対して、ん、って――"
  },
  {
   "location": "178/TALK",
   "narrator": "雛",
   "text": "そこで会話終了じゃん！\nもっと伸ばして！！\n話題を振らなきゃ！！",
   "zh": "对话就在那里结束了！\n再多展开一点！！\n得抛话题才行！！",
   "narrator_zh": "雏"
  },
  {
   "location": "181/TALK",
   "narrator": "ガブリエラ",
   "text": "そ、それはあたしが\nするようなことじゃ\nないわ！",
   "zh": "那、那可不是\n我该做的\n事！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "183/TALK",
   "narrator": "雛",
   "text": "それだよ、それ！！",
   "zh": "就是那个，那个！！",
   "narrator_zh": "雏"
  },
  {
   "location": "184/TALK",
   "narrator": "雛",
   "text": "ガブリエラちゃんの\nいけないところは――"
  },
  {
   "location": "185/TALK",
   "narrator": "雛",
   "text": "待ってるだけで、\n自分からは行動しない\nところだよ。"
  },
  {
   "location": "188/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "190/TALK",
   "narrator": "雛",
   "text": "待ってるだけの\nお姫様やってると――"
  },
  {
   "location": "191/TALK",
   "narrator": "雛",
   "text": "気付いたら他の人に\n取られて、取り残され\nちゃうよ？"
  },
  {
   "location": "193/TALK",
   "narrator": "ガブリエラ",
   "text": "っ！？",
   "zh": "！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "195/TALK",
   "narrator": "ガブリエラ",
   "text": "…今の、結構グサッと\nきたわ。",
   "zh": "……刚才那句，\n挺扎心的呢。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "197/TALK",
   "narrator": "雛",
   "text": "厳しいアドバイスも\n時には辞さない\n恋愛キューピッド――"
  },
  {
   "location": "198/TALK",
   "narrator": "雛",
   "text": "それがあたしの\nやり方だからねー。",
   "zh": "那就是我的\n做法哦——",
   "narrator_zh": "雏"
  },
  {
   "location": "199/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "201/TALK",
   "narrator": "雛",
   "text": "っと、いけない！\nそろそろ休み時間\n終わっちゃう！",
   "zh": "啊，糟了！\n休息时间\n快结束了！",
   "narrator_zh": "雏"
  },
  {
   "location": "202/TALK",
   "narrator": "雛",
   "text": "じゃあ、\nまた放課後にねー。",
   "zh": "那，\n放学后见啦——。",
   "narrator_zh": "雏"
  },
  {
   "location": "205/TALK",
