{
    "dir": "dramatics/daydra/drm_ch03_00_400.js",
    "type": "Episode",
    "info": {
        "story_id": "3040",
        "cid": "gabriella",
        "title": "らぶとーく  第40話",
        "sub_title": "うさぎの心",
        "title_zh": "恋爱漫谈 第40话",
        "sub_title_zh": "兔子的心"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "うさぎの心",
            "zh": "兔子的心"
        },
        {
            "location": "25/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "ヒカルくん、告白は\nもうしたのかしら？",
            "zh": "光，告白\n已经做了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "27/TALK",
            "narrator": "ガブリエラ",
            "text": "あれっきり話してない\nからわからないけど…。",
            "zh": "那之后就没说话，\n所以不知道……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "ガブリエラ",
            "text": "…って、バカバカしい。\nあたしが気にするような\nことじゃないわ。",
            "zh": "……说起来，好蠢。\n又不是我该\n在意的事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "雛",
            "text": "あららー、本当に\n元気ないねー？",
            "zh": "哎呀，真的\n没什么精神呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "38/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？\nひ、ひなこ！？",
            "zh": "！？\n雏、雏！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "39/TALK",
            "narrator": "雛",
            "text": "はろー、\nガブリエラちゃん。",
            "zh": "哈啰，\n加布里埃拉。",
            "narrator_zh": "雏"
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "…何の用事？",
            "zh": "……有什么事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "43/TALK",
            "narrator": "雛",
            "text": "うん、つばめちゃんから\n聞いたんだけど――",
            "zh": "嗯，听燕\n说——",
            "narrator_zh": "雏"
        },
        {
            "location": "44/TALK",
            "narrator": "雛",
            "text": "最近、なーんか元気が\nないみたいだね？",
            "zh": "最近，好像没什么\n精神呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "…え？",
            "zh": "……诶？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "気付いてない、って\nことは――",
            "zh": "没发现的话，\n就是说——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "ヒカルくん、\nまだ告白してない、\nってこと？",
            "zh": "光，\n还没告白，\n是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんが\n元気ないなんて、\nちょっと心配でさー。",
            "zh": "加布里埃拉\n没什么精神，\n有点担心呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "52/TALK",
            "narrator": "雛",
            "text": "余計なお世話かなー、\nって思ったけど、\n来ちゃいましたー。",
            "zh": "我想着会不会\n多管闲事，\n还是来了。",
            "narrator_zh": "雏"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "…な、何よ。\n余計なお世話とか、\n今更じゃない。",
            "zh": "……干、干嘛呀。\n多管闲事什么的，\n现在说不是太晚了吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "他人の恋愛話には\n進んで首を突っ込む\nくせに…。",
            "zh": "别人的恋爱\n倒是积极插手\n……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "雛",
            "text": "あー、それ言われると\n何も言えないなー…。",
            "zh": "啊，被这么说\n我就没什么好说的了……",
            "narrator_zh": "雏"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、まあ、せっかく\n余計なお世話をしようと\n思って来たなら――",
            "zh": "也、也罢，既然\n特地想来多管闲事\n的话——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "一つ、相談したい\nことがあるんだけど…。",
            "zh": "有一件事，\n想找你商量……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "雛",
            "text": "おっ、珍しい！\nガブリエラちゃんから\nそんなこと言うなんて。",
            "zh": "哦，真难得！\n加布里埃拉酱居然\n会说这种话。",
            "narrator_zh": "雏"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "…嫌ならいいんだけど？",
            "zh": "……不愿意的话就算了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "雛",
            "text": "まさか！　そのために\n来たんだから――",
            "zh": "难道！　我就是\n为此而来的——",
            "narrator_zh": "雏"
        },
        {
            "location": "68/TALK",
            "narrator": "雛",
            "text": "どんな相談でも\n乗るから、どーんと\n相談しちゃってよ！",
            "zh": "什么样的商量我都\n陪你，就大胆地\n来找我商量吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "人の気も知らないで…。",
            "zh": "一点都不懂别人的心情……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "…最初に、これだけは\nはっきりさせておく\nけど――",
            "zh": "……首先，这一点\n我要先\n说清楚——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "ヒカルくんのことじゃ\nないから。\nそれだけは忘れないで。",
            "zh": "不是光的事。\n这点\n你别忘了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "雛",
            "text": "う、うん…。\nそれで？",
            "zh": "嗯、嗯……\n然后呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "…ある人に、あたしの\n気持ちを伝えたい、って\n思ってるの。",
            "zh": "……我想把我的\n心情告诉某个人，\n我是这么想的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "けど…自分の気持ちを\n相手に伝えるのって――",
            "zh": "可是……把自己的心情\n传达给对方——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "どうすればいいか\nわからなくて…。",
            "zh": "不知道该怎么\n办……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/TALK",
            "narrator": "雛",
            "text": "ふむふむ、なるほど…。",
            "zh": "嗯嗯，原来如此……",
            "narrator_zh": "雏"
        },
        {
            "location": "81/TALK",
            "narrator": "雛",
            "text": "相手がヒカルくんじゃ\nないっていうのが、\n少し驚きだけど――",
            "zh": "对方不是光，\n这点有点\n吃惊——",
            "narrator_zh": "雏"
        },
        {
            "location": "84/TALK",
            "narrator": "雛",
            "text": "まあ、それなら答えは\n簡単だと思うなー。",
            "zh": "嘛，那样的话答案\n我觉得很简单呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "は？　簡単？",
            "zh": "哈？　简单？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "雛",
            "text": "うん。\n伝えたい気持ちが\nあるんでしょ？",
            "zh": "嗯。\n你有想传达的心情\n吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "88/TALK",
            "narrator": "雛",
            "text": "だったら、そのまま\n伝えるのが一番じゃん。",
            "zh": "那样的话，直接\n说出来最好啊。",
            "narrator_zh": "雏"
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、それができない\nから相談してるんじゃ\nない！",
            "zh": "所以，我就是因为做不到\n才来商量的\n不是吗！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "雛",
            "text": "そうは言うけどさー。",
            "zh": "话是这么说啦——",
            "narrator_zh": "雏"
        },
        {
            "location": "91/TALK",
            "narrator": "雛",
            "text": "気持ちって、結局のとこ\n言葉にしないと伝え\nられないもんだよ？",
            "zh": "心情这东西，说到底\n不说出来就\n传不到吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "92/TALK",
            "narrator": "雛",
            "text": "あ、手紙にしたりする\n方法もあるけど――",
            "zh": "啊，也有写信\n这种方法——",
            "narrator_zh": "雏"
        },
        {
            "location": "93/TALK",
            "narrator": "雛",
            "text": "どっちにしろ、\nそのまま伝える以外に\nないんじゃないかなー？",
            "zh": "不管怎样，除了\n直接说出来\n也没别的办法吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "96/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、それはまあ、\nそうなんだけど…。",
            "zh": "那、那个嘛，\n虽然是没错……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "雛",
            "text": "ふふーん、あたしの\n答えは完璧だわ！",
            "zh": "哼哼，我的\n答案是完美的！",
            "narrator_zh": "雏"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、だからそれが\nできないから相談して\nるんじゃない…。",
            "zh": "不，所以就是因为\n做不到才来\n商量的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "101/TALK",
            "narrator": "雛",
            "text": "あなたが好きです。\n付き合ってください。\nチューしてください。",
            "zh": "我喜欢你。\n请和我交往。\n请亲亲我。",
            "narrator_zh": "雏"
        },
        {
            "location": "103/TALK",
            "narrator": "雛",
            "text": "って言えば完璧！！",
            "zh": "这么说就完美了！！",
            "narrator_zh": "雏"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "い、言えるわけ\nないでしょ！！",
            "zh": "怎、怎么可能\n说得出口！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、最後の\nチューって何！？",
            "zh": "话说，最后的\n那个亲吻是什么！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "雛",
            "text": "キスとか口づけとか\n接吻とか…そういうの？",
            "zh": "亲吻啦接吻啦\n亲吻啦……那种？",
            "narrator_zh": "雏"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、だからそういう\nことじゃなくて…。",
            "zh": "不，所以不是\n那种事……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…なんか本当、\nひなこと話してると\n調子狂うわ…。",
            "zh": "唉……真的，\n跟雏说话\n就乱了节奏……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/SEL",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "113/ACT",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "117/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、\nうるさいわね…。",
            "zh": "真是的，\n好吵……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/TALK",
            "narrator": "雛",
            "text": "おっ、ＷＡＶＥ？",
            "zh": "哦，WAVE？",
            "narrator_zh": "雏"
        },
        {
            "location": "121/TALK",
            "narrator": "雛",
            "text": "もしかしてもしかして、\nそれが例の気持ちを\n伝えたい相手？",
            "zh": "难道难道，\n那就是你想传达心情的\n对象？",
            "narrator_zh": "雏"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "雛",
            "text": "やっぱり！",
            "zh": "果然！",
            "narrator_zh": "雏"
        },
        {
            "location": "125/TALK",
            "narrator": "雛",
            "text": "いいから、早く返事して\nあげなよ！",
            "zh": "好了，快点回\n人家呀！",
            "narrator_zh": "雏"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "べ、別にいいわよ！\nそんな重要なことでも\nないだろうし…。",
            "zh": "也、也不是不行！\n大概也不是\n那么重要的事……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "雛",
            "text": "重要じゃなくても\n出なきゃダメ！",
            "zh": "不重要也得\n回！",
            "narrator_zh": "雏"
        },
        {
            "location": "128/TALK",
            "narrator": "雛",
            "text": "相談してきたのは\nガブリエラちゃん\nなんだから――",
            "zh": "来商量的是\n加布里埃拉\n所以——",
            "narrator_zh": "雏"
        },
        {
            "location": "129/TALK",
            "narrator": "雛",
            "text": "アドバイスには\n従わないとダメですー！",
            "zh": "建议就得\n照做呀！",
            "narrator_zh": "雏"
        },
        {
            "location": "131/TALK",
            "narrator": "ガブリエラ",
            "text": "…今、ひなこに\n相談したのをスゴく\n後悔してるわ…。",
            "zh": "……我现在超级后悔\n跟雏\n商量了这事……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "雛",
            "text": "後悔してももう遅いよ。\nほら、返信返信。",
            "zh": "后悔就晚了。\n来，回复回复。",
            "narrator_zh": "雏"
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "145/TALK",
            "narrator": "ガブリエラ",
            "text": "なんのよう？",
            "zh": "干什么呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "146/TALK",
            "narrator": "ガブリエラ",
            "text": "今忙しいんだけど？",
            "zh": "我现在很忙？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "148/SEL",
            "narrator": "",
            "text": "じゃあまた後でね",
            "zh": "那就回头见",
            "narrator_zh": ""
        },
        {
            "location": "149/SEL",
            "narrator": "",
            "text": "こっちの方が忙しいんだけど",
            "zh": "这边才更忙啊",
            "narrator_zh": ""
        },
        {
            "location": "150/SEL",
            "narrator": "",
            "text": "何か手伝えることある？",
            "zh": "有我能帮上忙的吗？",
            "narrator_zh": ""
        },
        {
            "location": "151/ACT",
            "narrator": "",
            "text": "じゃあまた後でね",
            "zh": "那就回头见",
            "narrator_zh": ""
        },
        {
            "location": "152/TALK",
            "narrator": "ガブリエラ",
            "text": "ん",
            "zh": "嗯",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "164/TALK",
            "narrator": "ガブリエラ",
            "text": "またやっちゃった…。",
            "zh": "又搞砸了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "もっと、$handle$と\n話したいことあった\nのに…。",
            "zh": "本来还有好多话\n想跟$handle$说\n的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "170/TALK",
            "narrator": "ガブリエラ",
            "text": "…おまたせ。\nなんでもなかった\nみたい。",
            "zh": "……让你久等了。\n好像没\n出什么事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "171/TALK",
            "narrator": "雛",
            "text": "ブーッ！！\nブッブー！！",
            "zh": "嘟嘟！！\n哔哔！！",
            "narrator_zh": "雏"
        },
        {
            "location": "172/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん！\n今の返信は不正解！！\nマイナス１００点！！",
            "zh": "加布里埃拉！\n你刚才那个回复不正确！！\n扣一百分！！",
            "narrator_zh": "雏"
        },
        {
            "location": "174/TALK",
            "narrator": "ガブリエラ",
            "text": "な、何がよ！？\n別に変なこと書いたり\nしてないでしょ！？",
            "zh": "什、什么啊！？\n我又没写什么\n奇怪的东西吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "175/TALK",
            "narrator": "雛",
            "text": "変なことどころか、\n何も書いてないじゃん！",
            "zh": "别说奇怪的话了，\n什么都没写嘛！",
            "narrator_zh": "雏"
        },
        {
            "location": "176/TALK",
            "narrator": "雛",
            "text": "もっと押してかないと\nダメなんだって！",
            "zh": "不更进一步\n可不行！",
            "narrator_zh": "雏"
        },
        {
            "location": "177/TALK",
            "narrator": "雛",
            "text": "じゃあまた後でね、\nに対して、ん、って――",
            "zh": "对「那待会儿见」，\n就回「嗯」——",
            "narrator_zh": "雏"
        },
        {
            "location": "178/TALK",
            "narrator": "雛",
            "text": "そこで会話終了じゃん！\nもっと伸ばして！！\n話題を振らなきゃ！！",
            "zh": "对话就在那里结束了！\n再多展开一点！！\n得抛话题才行！！",
            "narrator_zh": "雏"
        },
        {
            "location": "181/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、それはあたしが\nするようなことじゃ\nないわ！",
            "zh": "那、那可不是\n我该做的\n事！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "183/TALK",
            "narrator": "雛",
            "text": "それだよ、それ！！",
            "zh": "就是那个，那个！！",
            "narrator_zh": "雏"
        },
        {
            "location": "184/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんの\nいけないところは――",
            "zh": "加布里埃拉\n不好的地方是——",
            "narrator_zh": "雏"
        },
        {
            "location": "185/TALK",
            "narrator": "雛",
            "text": "待ってるだけで、\n自分からは行動しない\nところだよ。",
            "zh": "只会等，\n自己不行动\n这一点。",
            "narrator_zh": "雏"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "雛",
            "text": "待ってるだけの\nお姫様やってると――",
            "zh": "只当一个等着的\n公主的话——",
            "narrator_zh": "雏"
        },
        {
            "location": "191/TALK",
            "narrator": "雛",
            "text": "気付いたら他の人に\n取られて、取り残され\nちゃうよ？",
            "zh": "回过神来就被别人\n抢走，自己被\n剩下了哦？",
            "narrator_zh": "雏"
        },
        {
            "location": "193/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "…今の、結構グサッと\nきたわ。",
            "zh": "……刚才那句，\n挺扎心的呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/TALK",
            "narrator": "雛",
            "text": "厳しいアドバイスも\n時には辞さない\n恋愛キューピッド――",
            "zh": "严厉的建议\n有时也不回避的\n恋爱丘比特——",
            "narrator_zh": "雏"
        },
        {
            "location": "198/TALK",
            "narrator": "雛",
            "text": "それがあたしの\nやり方だからねー。",
            "zh": "那就是我的\n做法哦——",
            "narrator_zh": "雏"
        },
        {
            "location": "199/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "201/TALK",
            "narrator": "雛",
            "text": "っと、いけない！\nそろそろ休み時間\n終わっちゃう！",
            "zh": "啊，糟了！\n休息时间\n快结束了！",
            "narrator_zh": "雏"
        },
        {
            "location": "202/TALK",
            "narrator": "雛",
            "text": "じゃあ、\nまた放課後にねー。",
            "zh": "那，\n放学后见啦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "205/TALK",
            "narrator": "ガブリエラ",
            "text": "…はぁ。",
            "zh": "……哈啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "206/TALK",
            "narrator": "ガブリエラ",
            "text": "…認めたくないけど、\n結構参考になったかも。",
            "zh": "……虽然不想承认，\n不过还挺有参考价值的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "207/ACT",
            "narrator": "",
            "text": "こっちの方が忙しいんだけど",
            "zh": "这边才更忙啊",
            "narrator_zh": ""
        },
        {
            "location": "208/TALK",
            "narrator": "ガブリエラ",
            "text": "は？",
            "zh": "啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "ガブリエラ",
            "text": "なにそれ？",
            "zh": "那是什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "210/TALK",
            "narrator": "ガブリエラ",
            "text": "だったら連絡してこなければいいじゃない！",
            "zh": "那样的话不联系就好了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "221/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "またやっちゃった…。",
            "zh": "又搞砸了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/TALK",
            "narrator": "ガブリエラ",
            "text": "もっと、$handle$と\n話したいことあった\nのに…。",
            "zh": "本来还有好多话\n想跟$handle$说\n的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "…おまたせ。\nなんでもなかった\nみたい。",
            "zh": "……让你久等了。\n好像没\n出什么事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "雛",
            "text": "ブーッ！！\nブッブー！！",
            "zh": "嘟嘟！！\n哔哔！！",
            "narrator_zh": "雏"
        },
        {
            "location": "229/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん！\n今の返信は不正解！！\nマイナス１００点！！",
            "zh": "加布里埃拉！\n你刚才那个回复不正确！！\n扣一百分！！",
            "narrator_zh": "雏"
        },
        {
            "location": "230/TALK",
            "narrator": "ガブリエラ",
            "text": "な、何がよ！？\n別に変なこと書いたり\nしてないでしょ！？",
            "zh": "什、什么啊！？\n我又没写什么\n奇怪的东西吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "231/TALK",
            "narrator": "雛",
            "text": "いや、キレてたじゃん！\nその時点でもうダメの\n極致だから！",
            "zh": "不，你发火了嘛！\n到那一步就已经\n完了！",
            "narrator_zh": "雏"
        },
        {
            "location": "232/TALK",
            "narrator": "雛",
            "text": "相手が忙しいって\n言うなら――",
            "zh": "对方要是说\n很忙——",
            "narrator_zh": "雏"
        },
        {
            "location": "234/TALK",
            "narrator": "雛",
            "text": "まぁ！　忙しいのに\n私のことを想って\n連絡くれたのね――",
            "zh": "哎呀！　明明很忙\n还想着我\n联系我——",
            "narrator_zh": "雏"
        },
        {
            "location": "235/TALK",
            "narrator": "雛",
            "text": "嬉しいっ！！",
            "zh": "好高兴！！",
            "narrator_zh": "雏"
        },
        {
            "location": "237/TALK",
            "narrator": "雛",
            "text": "って、言わなきゃ！",
            "zh": "啊，得说了！",
            "narrator_zh": "雏"
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしがそんなこと\n言うわけないでしょ！？",
            "zh": "我怎么可能\n说那种话！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "雛",
            "text": "それでも言わなきゃ\nいけないの！",
            "zh": "不过还是\n非说不可！",
            "narrator_zh": "雏"
        },
        {
            "location": "242/TALK",
            "narrator": "雛",
            "text": "何であれ、ガブリエラ\nちゃんのことを想って\nくれてるんだから――",
            "zh": "不管怎样，既然想着\n加布里埃拉\n所以——",
            "narrator_zh": "雏"
        },
        {
            "location": "243/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんも\nそれに応えてあげな\nいと――",
            "zh": "加布里埃拉也\n得回应\n才行——",
            "narrator_zh": "雏"
        },
        {
            "location": "244/TALK",
            "narrator": "雛",
            "text": "気持ちも何も、\n相手に伝わらないよ？",
            "zh": "心情什么的，\n传不到对方那里哦？",
            "narrator_zh": "雏"
        },
        {
            "location": "246/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "248/TALK",
            "narrator": "雛",
            "text": "っと、いけない！\nそろそろ休み時間\n終わっちゃう！",
            "zh": "啊，糟了！\n休息时间\n快结束了！",
            "narrator_zh": "雏"
        },
        {
            "location": "250/TALK",
            "narrator": "雛",
            "text": "じゃあ、\nまた放課後にねー。",
            "zh": "那，\n放学后见啦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "…はぁ。",
            "zh": "……哈啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "257/TALK",
            "narrator": "ガブリエラ",
            "text": "…認めたくないけど、\n結構参考になったかも。",
            "zh": "……虽然不想承认，\n不过还挺有参考价值的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "258/ACT",
            "narrator": "",
            "text": "何か手伝えることある？",
            "zh": "有我能帮上忙的吗？",
            "narrator_zh": ""
        },
        {
            "location": "259/TALK",
            "narrator": "ガブリエラ",
            "text": "別にないから黙ってて",
            "zh": "没什么，你闭嘴",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "271/TALK",
            "narrator": "ガブリエラ",
            "text": "またやっちゃった…。",
            "zh": "又搞砸了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "272/TALK",
            "narrator": "ガブリエラ",
            "text": "もっと、$handle$と\n話したいことあった\nのに…。",
            "zh": "本来还有好多话\n想跟$handle$说\n的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "274/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "276/TALK",
            "narrator": "ガブリエラ",
            "text": "…おまたせ。\nなんでもなかった\nみたい。",
            "zh": "……让你久等了。\n好像没\n出什么事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "277/TALK",
            "narrator": "雛",
            "text": "ブーッ！！\nブッブー！！",
            "zh": "嘟嘟！！\n哔哔！！",
            "narrator_zh": "雏"
        },
        {
            "location": "278/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん！\n今の返信は不正解！！\nマイナス１００点！！",
            "zh": "加布里埃拉！\n你刚才那个回复不正确！！\n扣一百分！！",
            "narrator_zh": "雏"
        },
        {
            "location": "279/TALK",
            "narrator": "ガブリエラ",
            "text": "な、何がよ！？\n別に変なこと書いたり\nして…。",
            "zh": "有、有什么啊！？\n我也没写什么\n奇怪的东西……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "282/TALK",
            "narrator": "ガブリエラ",
            "text": "…ま、まあ、さすがに\nちょっとそっけなかった\nかもしれないけど…。",
            "zh": "……算、算了，确实\n可能是有那么点\n冷淡……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "283/TALK",
            "narrator": "雛",
            "text": "そうじゃなくて！",
            "zh": "不是那样啦！",
            "narrator_zh": "雏"
        },
        {
            "location": "284/TALK",
            "narrator": "雛",
            "text": "何か手伝えることある、\nって聞いてきたって\nことは――",
            "zh": "问有没有能帮忙的，\n这句话\n意思是——",
            "narrator_zh": "雏"
        },
        {
            "location": "285/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんの\n力になりたい、って\nことだよ？",
            "zh": "想成为加布里埃拉的\n力量，\n就是这个意思吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "286/TALK",
            "narrator": "雛",
            "text": "別にないけど、\nその気持ちが嬉しい！",
            "zh": "虽然没什么，\n这份心意我很高兴！",
            "narrator_zh": "雏"
        },
        {
            "location": "287/TALK",
            "narrator": "雛",
            "text": "って言わなきゃ！",
            "zh": "得这么说！",
            "narrator_zh": "雏"
        },
        {
            "location": "290/TALK",
            "narrator": "ガブリエラ",
            "text": "ど、どうしてそこまで\n言わなきゃいけない\nのよ！？",
            "zh": "为、为什么要说到\n那个地步\n啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "291/TALK",
            "narrator": "雛",
            "text": "何か手伝うことない、\nって聞かれて、\n少しも嬉しくなかった？",
            "zh": "被问有没有能帮忙的，\n你一点都不\n高兴吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "294/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "295/TALK",
            "narrator": "雛",
            "text": "ほらね？",
            "zh": "看吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "296/TALK",
            "narrator": "雛",
            "text": "気持ちを伝えたいなら、\n自分の気持ちに正直に\nならないと――",
            "zh": "想传达心情的话，\n不对自己的心情诚实\n的话——",
            "narrator_zh": "雏"
        },
        {
            "location": "297/TALK",
            "narrator": "雛",
            "text": "いつまで経っても\n伝えられないよ？",
            "zh": "到什么时候都\n传达不了哦？",
            "narrator_zh": "雏"
        },
        {
            "location": "299/TALK",
            "narrator": "雛",
            "text": "っと、いけない！\nそろそろ休み時間\n終わっちゃう！",
            "zh": "啊，糟了！\n休息时间\n快结束了！",
            "narrator_zh": "雏"
        },
        {
            "location": "301/TALK",
            "narrator": "雛",
            "text": "じゃあ、\nまた放課後にねー。",
            "zh": "那，\n放学后见啦——。",
            "narrator_zh": "雏"
