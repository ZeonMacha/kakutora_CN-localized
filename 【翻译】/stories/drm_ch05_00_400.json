   "location": "1624/SCENARIO",
   "narrator": "",
   "text": "神の采配と民草の希望"
  },
  {
   "location": "1651/TALK",
   "narrator": "神楽",
   "text": "私は神々のチェスに参加することになった"
  },
  {
   "location": "1652/TALK",
   "narrator": "神楽",
   "text": "プレイヤーとして"
  },
  {
   "location": "1653/TALK",
   "narrator": "神楽",
   "text": "開始にあたって受けたアドバイスはふたつ"
  },
  {
   "location": "1654/TALK",
   "narrator": "神楽",
   "text": "序盤は本のごとく、中盤は奇術師のごとく、終盤は機械のごとく指せ"
  },
  {
   "location": "1655/TALK",
   "narrator": "神楽",
   "text": "よい手を見つけたと思ったら、もっとよい手を考えろ"
  },
  {
   "location": "1657/SEL",
   "narrator": "",
   "text": "なんかかっこいい！",
   "zh": "怎么有点帅！",
   "narrator_zh": ""
  },
  {
   "location": "1658/SEL",
   "narrator": "",
   "text": "何の比喩かな？",
   "zh": "是什么比喻呢？",
   "narrator_zh": ""
  },
  {
   "location": "1659/SEL",
   "narrator": "",
   "text": "$me$にも手ほどきしてよ",
   "zh": "$me$也要你手把手教",
   "narrator_zh": ""
  },
  {
   "location": "1660/ACT",
   "narrator": "",
   "text": "なんかかっこいい！",
   "zh": "怎么有点帅！",
   "narrator_zh": ""
  },
  {
   "location": "1661/TALK",
   "narrator": "神楽",
   "text": "でしょでしょでしょでしょ～～～♪",
   "zh": "对吧对吧对吧对吧～～～♪",
   "narrator_zh": "神乐"
  },
  {
   "location": "1663/TALK",
   "narrator": "神楽",
   "text": "いやそんな場合じゃない"
  },
  {
   "location": "1664/ACT",
   "narrator": "",
   "text": "何の比喩かな？",
   "zh": "是什么比喻呢？",
   "narrator_zh": ""
  },
  {
   "location": "1665/TALK",
   "narrator": "神楽",
   "text": "暗喩であり直喩"
  },
  {
   "location": "1666/ACT",
   "narrator": "",
   "text": "$me$にも手ほどきしてよ",
   "zh": "$me$也要你手把手教",
   "narrator_zh": ""
  },
  {
   "location": "1667/TALK",
   "narrator": "神楽",
   "text": "どうしよっかな～？",
   "zh": "怎么办呢～？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1668/TALK",
   "narrator": "神楽",
   "text": "やっぱやめとく～"
  },
  {
   "location": "1670/TALK",
   "narrator": "神楽",
   "text": "神々のチェスの駒は人間"
  },
  {
   "location": "1671/TALK",
   "narrator": "神楽",
   "text": "差し替えることも追加することも可能だが"
  },
  {
   "location": "1672/TALK",
   "narrator": "神楽",
   "text": "その代償は駒になった人間の命",
   "zh": "代价是成为棋子的人类的生命",
   "narrator_zh": "神乐"
  },
  {
   "location": "1673/TALK",
   "narrator": "神楽",
   "text": "一旦盤上に上った人間が盤を降りることは死を意味する"
  },
  {
   "location": "1675/SEL",
   "narrator": "",
   "text": "なにそれこわい",
   "zh": "那是什么，好可怕",
   "narrator_zh": ""
  },
  {
   "location": "1676/SEL",
   "narrator": "",
   "text": "それが…神々のチェス…！",
   "zh": "这就是……众神的棋局……！",
   "narrator_zh": ""
  },
  {
   "location": "1677/SEL",
   "narrator": "",
   "text": "重い話だ",
   "zh": "这话题真沉重",
