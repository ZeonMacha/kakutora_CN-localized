   "narrator_zh": "神乐"
  },
  {
   "location": "1680/TALK",
   "narrator": "神楽",
   "text": "仕方ない",
   "zh": "没办法",
   "narrator_zh": "神乐"
  },
  {
   "location": "1681/ACT",
   "narrator": "",
   "text": "それが…神々のチェス…！",
   "zh": "这就是……众神的棋局……！",
   "narrator_zh": ""
  },
  {
   "location": "1682/TALK",
   "narrator": "神楽",
   "text": "人の命は神が握っている"
  },
  {
   "location": "1683/TALK",
   "narrator": "神楽",
   "text": "なぜならこれは神々の遊びなのだから",
   "zh": "因为这是众神的游戏",
