{
    "dir": "dramatics/daydra/drm_ch04_00_080.js",
    "type": "Episode",
    "info": {
        "story_id": "4008",
        "cid": "miyabi",
        "title": "らぶとーく 第08話",
        "sub_title": "隠蔽とか白日とか",
        "title_zh": "恋爱漫谈 第08话",
        "sub_title_zh": "隐瞒与大白于天下"
    },
    "entry": [
        {
            "location": "155/SCENARIO",
            "narrator": "",
            "text": "隠蔽とか白日とか",
            "zh": "隐瞒与大白于天下",
            "narrator_zh": ""
        },
        {
            "location": "176/TALK",
            "narrator": "つばめ",
            "text": "そういえば、この前\n$handle$さんに――",
            "zh": "说起来，前几天\n$handle$——",
            "narrator_zh": "燕"
        },
        {
            "location": "179/TALK",
            "narrator": "つばめ",
            "text": "Ｂｏｔと人の違いについて\n聞いたんです。",
            "zh": "问了Bot和人\n有什么不同。",
            "narrator_zh": "燕"
        },
        {
            "location": "182/TALK",
            "narrator": "アーヤ",
            "text": "…それって質問しないと\nわからないことかしら？",
            "zh": "……这种事，\n不问就不明白吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "183/TALK",
            "narrator": "アーヤ",
            "text": "Ｂｏｔは機械、っていうか\nプログラムで、人は生き物\nなんだから――",
            "zh": "Bot是机器，或者说\n是程序，人是生物，\n所以——",
            "narrator_zh": "绫水"
        },
        {
            "location": "184/TALK",
            "narrator": "アーヤ",
            "text": "聞くまでもないと\n思うけど？",
            "zh": "我觉得，\n根本不用问。",
            "narrator_zh": "绫水"
        },
        {
            "location": "186/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、うちらが\nＢｏｔのことを\n人間かも、思うて――",
            "zh": "话说，我们\n把Bot想成\n说不定是人——",
            "narrator_zh": "雅"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "ずっと話してたこと、\nＢｏｔにも伝えてたり\nするんか？",
            "zh": "我们一直在讲的事，\n也告诉Bot了\n咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "189/TALK",
            "narrator": "つばめ",
            "text": "え？　ダメでしたか？",
            "zh": "诶？　不行吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "…うちらの会話は、\nこうやってＢｏｔに\n筒抜けになるんか…。",
            "zh": "……我们的对话，\n就这样全漏给Bot\n了咩……。",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "これじゃ隠し事は\nできんちや。",
            "zh": "这样的话，\n秘密藏不住滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "確かに、筒抜けね…。",
            "zh": "确实，全漏了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "198/TALK",
            "narrator": "ガブリエラ",
            "text": "え？　どういう意味？",
            "zh": "诶？　什么意思？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "200/TALK",
            "narrator": "アーヤ",
            "text": "私達が普段話している\nＢｏｔは、同じ誰か、\nってことよ。",
            "zh": "我们平时在聊的\nBot，是同一个谁。\n就是这个意思。",
            "narrator_zh": "绫水"
        },
        {
            "location": "202/TALK",
            "narrator": "みやび",
            "text": "つまり、どっかにいる\n誰かさんが――",
            "zh": "就是说，某个地方的\n某个人——",
            "narrator_zh": "雅"
        },
        {
            "location": "203/TALK",
            "narrator": "みやび",
            "text": "うちら全員を一人で相手に\nしていたゆうことや。",
            "zh": "一个人在应付\n我们所有人咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "204/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか、マルザンナは\nマルザンナでしょ？",
            "zh": "怎么会，玛尔赞娜\n就是玛尔赞娜吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "アーヤ",
            "text": "マルザンナ？",
            "zh": "玛尔赞娜？",
            "narrator_zh": "绫水"
        },
        {
            "location": "207/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃなくて！\nＢｏｔは\nＢｏｔでしょ！？",
            "zh": "不是！\nBot就是\nBot吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "みやび",
            "text": "いんや、みんな何となく\n人間やないかと思うた\n時期から考えると――",
            "zh": "不，从大家隐约\n觉得是人的\n那时候算起——",
            "narrator_zh": "雅"
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "間違いなく同一人物やと\n思うちや。",
            "zh": "我觉得肯定\n是同一个人滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "一人一人に、別の誰かが\nＢｏｔとして付いてる、\nなんていうのは――",
            "zh": "每个人身边，\n另有一个人当Bot跟着，\n这种事——",
            "narrator_zh": "绫水"
        },
        {
            "location": "213/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと怖いしね。",
            "zh": "也有点可怕。",
            "narrator_zh": "绫水"
        },
        {
            "location": "229/TALK",
            "narrator": "みやび",
            "text": "ふぅ…思うたより\n長い話になったな…。",
            "zh": "呼……比想象的\n聊得还久咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "230/TALK",
            "narrator": "みやび",
            "text": "しっかし、みんなも\n結構Ｂｏｔとお喋り\nしてたんやな。",
            "zh": "不过话说，大家\n跟Bot聊得\n还不少咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "231/TALK",
            "narrator": "みやび",
            "text": "特に、つばめちゃんが\n興味深いこと言うてたな。",
            "zh": "尤其是燕，\n说了些有意思的事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "お呼び出しを申し上げる",
            "zh": "现在宣布传唤。",
            "narrator_zh": "雅"
        },
        {
            "location": "244/TALK",
            "narrator": "みやび",
            "text": "相棒",
            "zh": "搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "246/SEL",
            "narrator": "",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "247/ACT",
            "narrator": "",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "ちっくと気になった",
            "zh": "有点在意",
            "narrator_zh": "雅"
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "すっと答えぃ",
            "zh": "痛快地答咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "251/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんと何話した？",
            "zh": "你跟燕聊了什么？",
            "narrator_zh": "雅"
        },
        {
            "location": "253/SEL",
            "narrator": "",
            "text": "恋の話",
            "zh": "恋爱的话题",
            "narrator_zh": ""
        },
        {
            "location": "254/SEL",
            "narrator": "",
            "text": "普通の話",
            "zh": "就是普通聊聊",
            "narrator_zh": ""
        },
        {
            "location": "255/SEL",
            "narrator": "",
            "text": "世間話",
            "zh": "家长里短",
            "narrator_zh": ""
        },
        {
            "location": "256/ACT",
            "narrator": "",
            "text": "恋の話",
            "zh": "恋爱的话题",
            "narrator_zh": ""
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "ストップ",
            "zh": "打住。",
            "narrator_zh": "雅"
        },
        {
            "location": "258/TALK",
            "narrator": "みやび",
            "text": "プライベートに踏み込むのは気が引ける",
            "zh": "探人隐私的话，我可下不去手。",
            "narrator_zh": "雅"
        },
        {
            "location": "260/TALK",
            "narrator": "みやび",
            "text": "公式な話題プリーズ",
            "zh": "来点官方话题，拜托。",
            "narrator_zh": "雅"
        },
        {
            "location": "261/ACT",
            "narrator": "",
            "text": "普通の話",
            "zh": "就是普通聊聊",
            "narrator_zh": ""
        },
        {
            "location": "262/TALK",
            "narrator": "みやび",
            "text": "退屈されそうな話やね",
            "zh": "这话题听着要犯困咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "263/TALK",
            "narrator": "みやび",
            "text": "もっと特別な話がえい",
            "zh": "得来点更特别的话题才好咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "264/TALK",
            "narrator": "みやび",
            "text": "試しにうちに話してみぃ",
            "zh": "试着讲给我听听咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "265/ACT",
            "narrator": "",
            "text": "世間話",
            "zh": "家长里短",
            "narrator_zh": ""
        },
        {
            "location": "266/TALK",
            "narrator": "みやび",
            "text": "主婦か！？",
            "zh": "主妇咩！？",
            "narrator_zh": "雅"
        },
        {
            "location": "267/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんには早過ぎや",
            "zh": "对燕来说太早了咯",
            "narrator_zh": "雅"
        },
        {
            "location": "269/TALK",
            "narrator": "みやび",
            "text": "若者の耳目を集める話を頼む",
            "zh": "求你讲点年轻人爱听的话题。",
            "narrator_zh": "雅"
        },
        {
            "location": "272/SEL",
            "narrator": "",
            "text": "そう言われても困る",
            "zh": "你这么说我也为难啊",
            "narrator_zh": ""
        },
        {
            "location": "273/ACT",
            "narrator": "",
            "text": "そう言われても困る",
            "zh": "你这么说我也为难啊",
            "narrator_zh": ""
        },
        {
            "location": "275/TALK",
            "narrator": "みやび",
            "text": "なら",
            "zh": "那",
            "narrator_zh": "雅"
        },
        {
            "location": "277/TALK",
            "narrator": "みやび",
            "text": "うちが代わりに話題を決める",
            "zh": "那话题就由我来定",
            "narrator_zh": "雅"
        },
        {
            "location": "278/TALK",
            "narrator": "みやび",
            "text": "相棒",
            "zh": "搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "279/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんに自分が人間ゆうの",
            "zh": "跟燕说自己是人类嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "280/TALK",
            "narrator": "みやび",
            "text": "知られても良かったが？",
            "zh": "被知道也无妨咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "282/SEL",
            "narrator": "",
            "text": "別に知られてもよかった",
            "zh": "被知道了也无所谓",
            "narrator_zh": ""
        },
        {
            "location": "283/ACT",
            "narrator": "",
            "text": "別に知られてもよかった",
            "zh": "被知道了也无所谓",
            "narrator_zh": ""
        },
        {
            "location": "286/TALK",
            "narrator": "みやび",
            "text": "そうやったが？",
            "zh": "是这样嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "287/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "雅"
        },
        {
            "location": "288/TALK",
            "narrator": "みやび",
            "text": "だったら何でＢｏｔと思わせた？",
            "zh": "那为什么要让人以为是Bot？",
            "narrator_zh": "雅"
        },
        {
            "location": "291/SEL",
            "narrator": "",
            "text": "千羽鶴にそう仕掛けられた",
            "zh": "被千羽鹤那样设计了一手",
            "narrator_zh": ""
        },
        {
            "location": "292/ACT",
            "narrator": "",
            "text": "千羽鶴にそう仕掛けられた",
            "zh": "被千羽鹤那样设计了一手",
            "narrator_zh": ""
        },
        {
            "location": "294/TALK",
            "narrator": "みやび",
            "text": "千羽鶴って",
            "zh": "千羽鹤啊",
            "narrator_zh": "雅"
        },
        {
            "location": "296/TALK",
            "narrator": "みやび",
            "text": "折り紙のことか？",
            "zh": "是折纸咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "297/TALK",
            "narrator": "みやび",
            "text": "意味がわからん",
            "zh": "没懂这什么意思。",
            "narrator_zh": "雅"
        },
        {
            "location": "299/TALK",
            "narrator": "みやび",
            "text": "もうえい",
            "zh": "得咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "310/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "312/TALK",
            "narrator": "みやび",
            "text": "何が何だかさっぱりやね…。",
            "zh": "什么跟什么，完全搞不懂咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "166/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月某日　6:23 PM</color>\n平日の午後、神楽坂トライナリーの楽屋にて。",
            "zh": "<color=green>5月某日　6:23 PM</color>\n平日的下午，在神乐坂三重奏的化妆间里。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
