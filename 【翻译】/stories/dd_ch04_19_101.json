    "entry": [
        {
            "location": "36/TALK",
            "narrator": "繭",
            "text": "…みやび先輩。\nこちらの作業が\n終わりました。",
            "zh": "……雅前辈。\n这边的作业\n完成了。",
            "narrator_zh": "茧"
        },
        {
            "location": "37/TALK",
            "narrator": "繭",
            "text": "次は不可思議の\n解析作業に\n入りますね。",
            "zh": "接下来就要进入\n不可思议的\n解析作业了吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "よろ～。",
            "zh": "拜托咯～。",
            "narrator_zh": "雅"
        },
        {
            "location": "39/TALK",
            "narrator": "繭",
            "text": "はい、それでは…。",
            "zh": "好，那么……。",
            "narrator_zh": "茧"
        },
        {
            "location": "40/TALK",
            "narrator": "繭",
            "text": "…は？\nもう解析終了！？",
            "zh": "……哈？\n解析已经结束了！？",
            "narrator_zh": "茧"
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "あはは、さすがは\nウサギやね。",
            "zh": "啊哈哈，不愧是\n兔子咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "うちのスパコン、\n不可思議ちゃんの\n性能がわかるとは。",
            "zh": "能见识到\n我家超算不可思议的\n性能咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "繭",
            "text": "恐ろしい性能です。",
            "zh": "性能可怕得很。",
            "narrator_zh": "茧"
        },
        {
            "location": "46/TALK",
            "narrator": "繭",
            "text": "トライナリーになる\n対価がこれとは…。",
            "zh": "成为三重奏的\n代价竟然是这个……。",
            "narrator_zh": "茧"
        },
        {
            "location": "48/TALK",
            "narrator": "みやび",
            "text": "そのつもりやったん\nやけど、これがまた\nケチ臭い話なんよ。",
            "zh": "我本来也是\n这么打算的，但是这件事\n办得实在小气咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "対価に何が欲しい\n言われたから、\nこれをくれと言うた。",
            "zh": "他们问我要什么\n当报酬，\n我就说把这个给我。",
            "narrator_zh": "雅"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "したら高価過ぎるき、\n貸与という形に\nなったがよ。",
            "zh": "结果说太贵了啵，\n就变成了\n租借的形式咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "繭",
            "text": "安く見られたもの\nですね。",
            "zh": "结果被小瞧\n了呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "うむ、おかげでもっと\n管理庁を嫌いになれた\nちや。",
            "zh": "嗯，托这个福，\n我更讨厌\n管理厅了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "繭",
            "text": "まあ、貸与だろうと\n不可思議が我々の\n手元にあれば――",
            "zh": "嘛，就算是\n租借，只要不可思议\n在我们手上——",
            "narrator_zh": "茧"
        },
        {
            "location": "55/TALK",
            "narrator": "繭",
            "text": "管理庁を探るための\n武器になるので、\n問題はありませんが。",
            "zh": "就能成为\n探查管理厅的武器，\n所以没有问题。",
            "narrator_zh": "茧"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "そういうことや。",
            "zh": "就是这么回事。",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "繭",
            "text": "…準備は整いました。\nですが、本当にやるの\nですか？",
            "zh": "……准备\n都做好了。\n不过，真的要做吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "60/TALK",
            "narrator": "繭",
            "text": "愚問と承知で言わせて\n頂きますが。",
            "zh": "我知道是蠢问题，\n但还是容我问一句。",
            "narrator_zh": "茧"
        },
        {
            "location": "61/TALK",
            "narrator": "繭",
            "text": "これは、管理庁に対し\n反旗を翻すことに\nなりますよ。",
            "zh": "这样做，等于\n是向管理厅\n竖起反旗哦。",
            "narrator_zh": "茧"
        },
        {
            "location": "62/TALK",
            "narrator": "繭",
            "text": "覚悟は\nよろしいですか？",
            "zh": "觉悟\n准备好了吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "…当然や。",
            "zh": "……当然咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "ＦａｔａｌＱｕｅｅｎ\nの活動の目的やき。",
            "zh": "ＦａｔａｌＱｕｅｅｎ\n活动的目的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "今更になってやめる\nわけがないろう。",
            "zh": "现在才说要\n罢手，没可能咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "やめることは\n協力者たちへの\n裏切りにもなるがよ。",
            "zh": "收手的话，\n也等于背叛了\n那些协力者咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "繭",
            "text": "それはそうなの\nですが…。",
            "zh": "话是\n这么说……。",
            "narrator_zh": "茧"
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "…何かあるなら\n言うてみぃ？",
            "zh": "……有什么想说的，\n说出来咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "72/TALK",
            "narrator": "繭",
            "text": "…みやび先輩…、\nいえ、Ｆａｔａｌ\nＱｕｅｅｎ。",
            "zh": "……雅前辈……\n不，Ｆａｔａｌ\nＱｕｅｅｎ。",
            "narrator_zh": "茧"
        },
        {
            "location": "73/TALK",
            "narrator": "繭",
            "text": "あなたがスパコンまで\n所有しているとは、\n知りませんでした。",
            "zh": "没想到你连\n超算都有，\n我完全不知道。",
            "narrator_zh": "茧"
        },
        {
            "location": "74/TALK",
            "narrator": "繭",
            "text": "なので、今までは\n管理庁を探る際\n静かに行動してきました。",
            "zh": "所以到现在为止，\n探查管理厅都是\n悄悄行动的。",
            "narrator_zh": "茧"
        },
        {
            "location": "75/TALK",
            "narrator": "繭",
            "text": "ですが…不可思議を\n本格的に使用して\n動くならば。",
            "zh": "但如果……要\n全面启用不可思议\n来行动的话。",
            "narrator_zh": "茧"
        },
        {
            "location": "76/TALK",
            "narrator": "繭",
            "text": "より大胆な行動を\n起こすという\nことになります。",
            "zh": "就意味着\n要采取\n更大胆的行动。",
            "narrator_zh": "茧"
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "繭",
            "text": "管理庁に対して、\n真っ向から戦争を\n仕掛けるも同然です。",
            "zh": "这几乎等于\n向管理厅\n正面宣战。",
            "narrator_zh": "茧"
        },
        {
            "location": "80/TALK",
            "narrator": "繭",
            "text": "その覚悟は、本当に\n決まっているの\nでしょうか？",
            "zh": "这个觉悟，真的\n已经下定\n了吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "81/TALK",
            "narrator": "繭",
            "text": "最終確認をさせて\nください…クイーン。",
            "zh": "请容我最后\n确认一次……女王。",
            "narrator_zh": "茧"
        },
        {
            "location": "82/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
