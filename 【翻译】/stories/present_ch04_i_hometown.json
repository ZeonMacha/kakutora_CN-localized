            "location": "181/TALK",
            "narrator": "みやび",
            "text": "こう言うたら住んでる人間に申し訳ないが",
            "zh": "这么讲对住在那里的人有点过意不去",
            "narrator_zh": "雅"
        },
        {
            "location": "183/TALK",
            "narrator": "みやび",
            "text": "超絶ド田舎やね",
            "zh": "超级无敌大乡下咯",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "みやび",
            "text": "嫌いやないけんど",
            "zh": "但是不讨厌",
            "narrator_zh": "雅"
        },
        {
            "location": "187/SEL",
            "narrator": "",
            "text": "ネット回線来てなさそうだよ？",
            "zh": "看起来网络线路都没通进去哦？",
            "narrator_zh": ""
        },
        {
            "location": "188/ACT",
            "narrator": "",
            "text": "ネット回線来てなさそうだよ？",
            "zh": "看起来网络线路都没通进去哦？",
            "narrator_zh": ""
        },
        {
            "location": "191/TALK",
            "narrator": "みやび",
            "text": "うちを何だと思うてるが？",
            "zh": "你把我想成驷马了？",
            "narrator_zh": "雅"
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "住みたいわけやない",
            "zh": "又不是想住过去",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "見てて落ち着くから好き",
            "zh": "看着让人安心，所以喜欢",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "それだけのことや",
            "zh": "就这么点事",
            "narrator_zh": "雅"
        },
        {
            "location": "197/SEL",
            "narrator": "",
            "text": "みやびにとっての落ち着く場所は？",
            "zh": "对雅来说能安心的地方是？",
            "narrator_zh": ""
        },
        {
            "location": "198/ACT",
            "narrator": "",
            "text": "みやびにとっての落ち着く場所は？",
            "zh": "对雅来说能安心的地方是？",
            "narrator_zh": ""
        },
        {
            "location": "201/TALK",
            "narrator": "みやび",
            "text": "ＰＣの前",
            "zh": "ＰＣ跟前",
            "narrator_zh": "雅"
        },
        {
            "location": "204/SEL",
            "narrator": "",
            "text": "そこ以外だと？",
            "zh": "除了那里呢？",
            "narrator_zh": ""
        },
        {
            "location": "205/ACT",
            "narrator": "",
            "text": "そこ以外だと？",
            "zh": "除了那里呢？",
