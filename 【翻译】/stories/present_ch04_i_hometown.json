        },
        {
            "location": "211/TALK",
            "narrator": "みやび",
            "text": "気付いてないだけかもしれんけんど",
            "zh": "但是也可能只是没注意到",
            "narrator_zh": "雅"
        },
        {
            "location": "212/TALK",
            "narrator": "みやび",
            "text": "今は思いつかん",
