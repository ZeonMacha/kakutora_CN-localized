        {
            "location": "255/ACT",
            "narrator": "",
            "text": "愛は等しく注ぐもの",
            "zh": "爱是要平等倾注的",
            "narrator_zh": ""
        },
        {
            "location": "256/TALK",
            "narrator": "神楽",
            "text": "やっぱりそういう考えなんですね",
            "zh": "果然你是这么想的呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "257/ACT",
            "narrator": "",
            "text": "えと…怒ってるのかな？",
            "zh": "那个…是生气了吗？",
            "narrator_zh": ""
        },
        {
            "location": "258/TALK",
            "narrator": "神楽",
            "text": "そういうわけじゃないんですけど、、、",
            "zh": "不是那么回事……",
            "narrator_zh": "神乐"
        },
        {
            "location": "260/TALK",
            "narrator": "神楽",
            "text": "$handle$さんが人間だって最初から知ってたのはぴょんこだけだったのに",
