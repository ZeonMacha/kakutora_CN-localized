        },
        {
            "location": "245/ACT",
            "narrator": "",
            "text": "何でだろうね？",
            "zh": "是为什么呢？",
            "narrator_zh": ""
        },
        {
            "location": "246/TALK",
            "narrator": "神楽",
            "text": "不思議ですよね？",
            "zh": "很不可思议对吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "247/ACT",
            "narrator": "",
            "text": "それより愛について語ろうよ",
            "zh": "不如来聊聊爱情吧",
            "narrator_zh": ""
        },
        {
            "location": "249/TALK",
            "narrator": "神楽",
            "text": "$handle$さんの愛は博愛ですよね",
            "zh": "$handle$的爱是博爱呢",
