 "entry": [
  {
   "location": "202/SCENARIO",
   "narrator": "",
   "text": "愛は欲望に入りますか？"
  },
  {
   "location": "227/TALK",
   "narrator": "神楽",
   "text": "ぴょんこはフェノメノンの発生条件について考察したのです"
  },
  {
   "location": "228/TALK",
   "narrator": "神楽",
   "text": "そして疑問に思ったことがあるんです",
   "zh": "然后有件事我一直觉得奇怪",
   "narrator_zh": "神乐"
  },
  {
   "location": "229/TALK",
   "narrator": "神楽",
   "text": "$handle$さん、聞いてくれますか？",
   "zh": "$handle$，你愿意听我说吗？",
   "narrator_zh": "神乐"
  },
  {
   "location": "231/SEL",
   "narrator": "",
   "text": "もちろん",
   "zh": "当然",
   "narrator_zh": ""
  },
  {
   "location": "232/SEL",
   "narrator": "",
   "text": "今忙しい",
   "zh": "现在正忙",
   "narrator_zh": ""
  },
  {
   "location": "233/ACT",
   "narrator": "",
   "text": "もちろん",
   "zh": "当然",
   "narrator_zh": ""
  },
  {
   "location": "235/TALK",
   "narrator": "神楽",
   "text": "$handle$さんｽｷｽｷｰ！",
   "zh": "最喜欢$handle$了！",
   "narrator_zh": "神乐"
  },
  {
   "location": "237/TALK",
   "narrator": "神楽",
   "text": "ええっとですね"
  },
  {
   "location": "238/TALK",
   "narrator": "神楽",
   "text": "人間の三大欲に起因するフェノメノンが発生しないのはどうしてなんでしょう？"
  },
  {
   "location": "240/SEL",
   "narrator": "",
   "text": "単純すぎるから？",
   "zh": "因为太简单了？",
   "narrator_zh": ""
  },
  {
   "location": "241/SEL",
   "narrator": "",
   "text": "何でだろうね？",
   "zh": "是为什么呢？",
   "narrator_zh": ""
  },
  {
   "location": "242/SEL",
   "narrator": "",
   "text": "それより愛について語ろうよ",
   "zh": "不如来聊聊爱情吧",
   "narrator_zh": ""
  },
  {
   "location": "243/ACT",
   "narrator": "",
   "text": "単純すぎるから？",
   "zh": "因为太简单了？",
   "narrator_zh": ""
  },
  {
   "location": "244/TALK",
   "narrator": "神楽",
   "text": "なるほどです",
   "zh": "原来如此",
   "narrator_zh": "神乐"
  },
  {
   "location": "245/ACT",
   "narrator": "",
   "text": "何でだろうね？",
   "zh": "是为什么呢？",
   "narrator_zh": ""
  },
  {
   "location": "246/TALK",
   "narrator": "神楽",
   "text": "不思議ですよね？"
  },
  {
   "location": "247/ACT",
   "narrator": "",
   "text": "それより愛について語ろうよ",
   "zh": "不如来聊聊爱情吧",
   "narrator_zh": ""
  },
  {
   "location": "249/TALK",
   "narrator": "神楽",
   "text": "$handle$さんの愛は博愛ですよね",
   "zh": "$handle$的爱是博爱呢",
   "narrator_zh": "神乐"
  },
  {
   "location": "250/SEL",
   "narrator": "",
   "text": "神楽だけへの愛だよ",
   "zh": "是只献给神乐的爱哦",
   "narrator_zh": ""
  },
  {
   "location": "251/SEL",
   "narrator": "",
   "text": "愛は等しく注ぐもの",
   "zh": "爱是要平等倾注的",
   "narrator_zh": ""
  },
  {
   "location": "252/SEL",
   "narrator": "",
   "text": "えと…怒ってるのかな？",
   "zh": "那个…是生气了吗？",
   "narrator_zh": ""
  },
  {
   "location": "253/ACT",
   "narrator": "",
   "text": "神楽だけへの愛だよ",
   "zh": "是只献给神乐的爱哦",
   "narrator_zh": ""
  },
  {
   "location": "254/TALK",
   "narrator": "神楽",
   "text": "ぴょんこはそう思えないんです"
  },
  {
   "location": "255/ACT",
   "narrator": "",
   "text": "愛は等しく注ぐもの",
   "zh": "爱是要平等倾注的",
   "narrator_zh": ""
  },
  {
   "location": "256/TALK",
   "narrator": "神楽",
   "text": "やっぱりそういう考えなんですね"
  },
  {
   "location": "257/ACT",
   "narrator": "",
   "text": "えと…怒ってるのかな？",
   "zh": "那个…是生气了吗？",
   "narrator_zh": ""
  },
  {
   "location": "258/TALK",
   "narrator": "神楽",
   "text": "そういうわけじゃないんですけど、、、",
   "zh": "不是那么回事……",
   "narrator_zh": "神乐"
  },
  {
   "location": "260/TALK",
   "narrator": "神楽",
   "text": "$handle$さんが人間だって最初から知ってたのはぴょんこだけだったのに",
