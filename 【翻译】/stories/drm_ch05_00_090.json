        },
        {
            "location": "266/SEL",
            "narrator": "",
            "text": "えっと…ごめんなさい",
            "zh": "那个……对不起",
            "narrator_zh": ""
        },
        {
            "location": "267/SEL",
            "narrator": "",
            "text": "やっぱり怒ってたんだ",
            "zh": "果然是生气了",
            "narrator_zh": ""
        },
        {
            "location": "268/SEL",
            "narrator": "",
            "text": "そんなこと言ったっけ？",
            "zh": "我说过那种话吗？",
            "narrator_zh": ""
        },
        {
            "location": "269/ACT",
            "narrator": "",
            "text": "えっと…ごめんなさい",
            "zh": "那个……对不起",
            "narrator_zh": ""
        },
        {
            "location": "270/TALK",
