  },
  {
   "location": "273/TALK",
   "narrator": "神楽",
   "text": "怒るっていうか、、、"
  },
  {
   "location": "274/TALK",
   "narrator": "神楽",
   "text": "さみしくて○んじゃうかと思ったんですー！"
