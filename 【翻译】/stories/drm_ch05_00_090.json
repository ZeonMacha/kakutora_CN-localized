   "narrator_zh": "神乐"
  },
  {
   "location": "261/TALK",
   "narrator": "神楽",
   "text": "それがばれた時、ぴょんこは本当に心配したのに",
   "zh": "那事暴露的时候，pyon子真的很担心",
   "narrator_zh": "神乐"
  },
  {
   "location": "262/TALK",
   "narrator": "神楽",
   "text": "「$me$はトライナリー全員の信頼を得ているから」",
   "zh": "“$me$得到了三重奏全员的信任”",
   "narrator_zh": "神乐"
  },
  {
   "location": "264/TALK",
   "narrator": "神楽",
   "text": "そう言った人ですもんね？",
   "zh": "你就是说过这话的人吧？",
   "narrator_zh": "神乐"
  },
  {
   "location": "266/SEL",
   "narrator": "",
   "text": "えっと…ごめんなさい",
   "zh": "那个……对不起",
   "narrator_zh": ""
  },
  {
   "location": "267/SEL",
   "narrator": "",
   "text": "やっぱり怒ってたんだ",
   "zh": "果然是生气了",
   "narrator_zh": ""
  },
  {
   "location": "268/SEL",
   "narrator": "",
   "text": "そんなこと言ったっけ？",
   "zh": "我说过那种话吗？",
   "narrator_zh": ""
  },
  {
   "location": "269/ACT",
   "narrator": "",
   "text": "えっと…ごめんなさい",
   "zh": "那个……对不起",
   "narrator_zh": ""
  },
  {
   "location": "270/TALK",
   "narrator": "神楽",
   "text": "謝って欲しいわけじゃなくって"
  },
  {
   "location": "271/TALK",
   "narrator": "神楽",
   "text": "ぴょんこはすごくさみしかったんですー！"
