    "entry": [
        {
            "location": "202/SCENARIO",
            "narrator": "",
            "text": "愛は欲望に入りますか？",
            "zh": "爱算是一种欲望吗？",
            "narrator_zh": ""
        },
        {
            "location": "227/TALK",
            "narrator": "神楽",
            "text": "ぴょんこはフェノメノンの発生条件について考察したのです",
            "zh": "蹦子刚才考察了一下PhenoMENON的发生条件哦",
            "narrator_zh": "神乐"
        },
        {
            "location": "228/TALK",
            "narrator": "神楽",
            "text": "そして疑問に思ったことがあるんです",
            "zh": "然后有件事我一直觉得奇怪",
            "narrator_zh": "神乐"
        },
        {
            "location": "229/TALK",
            "narrator": "神楽",
            "text": "$handle$さん、聞いてくれますか？",
            "zh": "$handle$，你愿意听我说吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "231/SEL",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "232/SEL",
            "narrator": "",
            "text": "今忙しい",
            "zh": "现在正忙",
            "narrator_zh": ""
        },
        {
            "location": "233/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "235/TALK",
            "narrator": "神楽",
            "text": "$handle$さんｽｷｽｷｰ！",
            "zh": "最喜欢$handle$了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "237/TALK",
            "narrator": "神楽",
            "text": "ええっとですね",
            "zh": "那个呀",
            "narrator_zh": "神乐"
        },
        {
            "location": "238/TALK",
            "narrator": "神楽",
            "text": "人間の三大欲に起因するフェノメノンが発生しないのはどうしてなんでしょう？",
            "zh": "为什么不会发生源自人类三大欲望的PhenoMENON呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "240/SEL",
            "narrator": "",
            "text": "単純すぎるから？",
            "zh": "因为太简单了？",
            "narrator_zh": ""
        },
        {
            "location": "241/SEL",
            "narrator": "",
            "text": "何でだろうね？",
            "zh": "是为什么呢？",
            "narrator_zh": ""
        },
        {
            "location": "242/SEL",
            "narrator": "",
            "text": "それより愛について語ろうよ",
            "zh": "不如来聊聊爱情吧",
            "narrator_zh": ""
        },
        {
            "location": "243/ACT",
            "narrator": "",
            "text": "単純すぎるから？",
            "zh": "因为太简单了？",
            "narrator_zh": ""
        },
        {
            "location": "244/TALK",
            "narrator": "神楽",
            "text": "なるほどです",
