        },
        {
            "location": "253/ACT",
            "narrator": "",
            "text": "神楽だけへの愛だよ",
            "zh": "是只献给神乐的爱哦",
            "narrator_zh": ""
        },
        {
            "location": "254/TALK",
            "narrator": "神楽",
            "text": "ぴょんこはそう思えないんです",
            "zh": "蹦子可不这么觉得",
