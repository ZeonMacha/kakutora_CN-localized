{
    "dir": "chap18/daydra/dd_ch04_18_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "18456",
        "cid": "miyabi",
        "title": "Extra005 プレミアムストーリー",
        "sub_title": "テストプレイ",
        "title_zh": "Extra005 额外剧情",
        "sub_title_zh": "测试游玩"
    },
    "entry": [
        {
            "location": "222/SCENARIO",
            "narrator": "",
            "text": "テストプレイ",
            "zh": "测试游玩",
            "narrator_zh": ""
        },
        {
            "location": "248/TALK",
            "narrator": "キリト",
            "text": "うわっ、また死んだ！！",
            "zh": "哇啊，又死了！！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "凡ミスやね。\nキリト君、シューティング\nゲームは苦手やったが？",
            "zh": "低级失误咯。\n圣翔，你以前\n不是不擅长射击游戏咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "252/TALK",
            "narrator": "キリト",
            "text": "いや、違いますって！\nみやび先輩のゲームが\n難し過ぎるんすよ！",
            "zh": "不，不是的啦！\n是雅前辈的游戏\n太难了啊！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "254/TALK",
            "narrator": "つばめ",
            "text": "わたしなんか、始まって\n十秒でやられちゃい\nました…。",
            "zh": "我这种水平的，\n开场十秒就\n被打倒了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "256/TALK",
            "narrator": "繭",
            "text": "あの、このゲームって\n本当にみやび先輩は\nクリアしたのですか？",
            "zh": "那个，这个游戏\n雅前辈真的\n通关过吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "製作者やき、当然ぞね。",
            "zh": "我是制作者嘛，当然咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "259/TALK",
            "narrator": "みやび",
            "text": "ほれ、次はまた\nひなこちゃんの番や。",
            "zh": "来，接下来又是\n小雏的回合咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "261/TALK",
            "narrator": "雛",
            "text": "クリアできる気が\nしないので、パスです！",
            "zh": "感觉根本不可能\n通关，我弃权！",
            "narrator_zh": "雏"
        },
        {
            "location": "262/TALK",
            "narrator": "雛",
            "text": "っていうか、もう少し\n難易度下げてください！",
            "zh": "不如说，把难度\n再调低一点啦！",
            "narrator_zh": "雏"
        },
        {
            "location": "263/TALK",
            "narrator": "みやび",
            "text": "難易度が高くない\n弾幕シューティングなんぞ\n楽しめんがよ。",
            "zh": "难度不高的\n驷马弹幕射击，\n玩起来没意思咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "266/TALK",
            "narrator": "キリト",
            "text": "高過ぎるのも楽しめない\nと思うっすけど…。",
            "zh": "可是太难了也\n玩不高兴吧……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "268/TALK",
            "narrator": "みやび",
            "text": "そんな高いやろか？",
            "zh": "有那么高咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "270/TALK",
            "narrator": "つばめ",
            "text": "高過ぎます！",
            "zh": "太高了！",
            "narrator_zh": "燕"
        },
        {
            "location": "274/TALK",
            "narrator": "繭",
            "text": "私もそう思います。\n一般人が楽しめない\nゲームは、問題ありです。",
            "zh": "我也这么认为。\n普通人玩不下去的\n游戏，是有问题的。",
            "narrator_zh": "茧"
        },
        {
            "location": "276/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "288/TALK",
            "narrator": "みやび",
            "text": "相棒、うちにはいくつかの自分ルールがあるがよ",
            "zh": "搭档，我有几条自己的规矩咯",
            "narrator_zh": "雅"
        },
        {
            "location": "289/TALK",
            "narrator": "みやび",
            "text": "そのうちの一つが",
            "zh": "其中有一条",
            "narrator_zh": "雅"
        },
        {
            "location": "290/TALK",
            "narrator": "みやび",
            "text": "一度完成したゲームには手を付けん、というものやが",
            "zh": "做完的游戏绝不再动，这么一条咯",
            "narrator_zh": "雅"
        },
        {
            "location": "292/SEL",
            "narrator": "",
            "text": "初耳だよ",
            "zh": "第一次听说",
            "narrator_zh": ""
        },
        {
            "location": "293/ACT",
            "narrator": "",
            "text": "初耳だよ",
            "zh": "第一次听说",
            "narrator_zh": ""
        },
        {
            "location": "295/TALK",
            "narrator": "みやび",
            "text": "当然や",
            "zh": "当然咯",
            "narrator_zh": "雅"
        },
        {
            "location": "296/TALK",
            "narrator": "みやび",
            "text": "今さっき決めたルールやき、知っちょったらホラーやぞ",
            "zh": "这可是刚定下的规矩啵，要是早就知道才吓人咧",
            "narrator_zh": "雅"
        },
        {
            "location": "297/TALK",
            "narrator": "みやび",
            "text": "けんど、どうにもうちのゲームは難しいらしくてなぁ…",
            "zh": "但是，我的游戏好像就是难了点咯……",
            "narrator_zh": "雅"
        },
        {
            "location": "298/TALK",
            "narrator": "みやび",
            "text": "…どうしたら\nえいと思う？",
            "zh": "…你觉得\n怎样才好？",
            "narrator_zh": "雅"
        },
        {
            "location": "300/SEL",
            "narrator": "",
            "text": "直してあげようよ",
            "zh": "帮大家改一改吧",
            "narrator_zh": ""
        },
        {
            "location": "301/SEL",
            "narrator": "",
            "text": "みんなが下手なだけだ",
            "zh": "只是大家太菜了而已",
            "narrator_zh": ""
        },
        {
            "location": "302/SEL",
            "narrator": "",
            "text": "ネットに公開だ！",
            "zh": "公布到网上去！",
            "narrator_zh": ""
        },
        {
            "location": "303/ACT",
            "narrator": "",
            "text": "直してあげようよ",
            "zh": "帮大家改一改吧",
            "narrator_zh": ""
        },
        {
            "location": "305/TALK",
            "narrator": "みやび",
            "text": "…マジで言うとる？",
            "zh": "…你认真的？",
            "narrator_zh": "雅"
        },
        {
            "location": "306/TALK",
            "narrator": "みやび",
            "text": "はぁ…自分ルール曲げなあかんかぁ…ショックやなぁ…",
            "zh": "哈……还不得不弯掉自己的规矩咯……好受伤……",
            "narrator_zh": "雅"
        },
        {
            "location": "307/TALK",
            "narrator": "みやび",
            "text": "まあ、あいつらにはテストプレイしてもらった恩もあるき",
            "zh": "嘛，那帮家伙帮忙测试过，我也欠着人情啵",
            "narrator_zh": "雅"
        },
        {
            "location": "308/TALK",
            "narrator": "みやび",
            "text": "ちっくとだけ難易度調整しちゃるか",
            "zh": "就给你稍微调一下难度咯",
            "narrator_zh": "雅"
        },
        {
            "location": "320/TALK",
            "narrator": "みやび",
            "text": "今回だけやぞ？",
            "zh": "就这次哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "322/TALK",
            "narrator": "つばめ",
            "text": "難易度、下げてくれるん\nですか？",
            "zh": "难度，真的会\n帮我们调低吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "323/TALK",
            "narrator": "みやび",
            "text": "ちっくとだけ下げちゃる\nけんど――",
            "zh": "稍微给你降一点\n但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "324/TALK",
            "narrator": "みやび",
            "text": "それでもクリアできん\nかった時は、うちはもう\n知らんちや。",
            "zh": "就算这样还通不了关，\n那我可就\n不管滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "326/TALK",
            "narrator": "キリト",
            "text": "ちょっとかよ…\nでもまあ、今より優しく\nなるだけマシか。",
            "zh": "才一点啊……\n不过嘛，能比现在\n温柔点就算好。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "328/TALK",
            "narrator": "繭",
            "text": "今の鬼畜レベルのを\nプレイした後なら、\nきっと簡単に感じるはず。",
            "zh": "玩过现在这个\n鬼畜难度的版本之后，\n肯定会觉得简单。",
            "narrator_zh": "茧"
        },
        {
            "location": "329/TALK",
            "narrator": "繭",
            "text": "修正版で、絶対に\nリベンジしなくちゃ…。",
            "zh": "一定要用修正版\n一雪前耻……。",
            "narrator_zh": "茧"
        },
        {
            "location": "331/TALK",
            "narrator": "雛",
            "text": "あたしも簡単になるん\nだったら、また遊んで\nみたいなー。",
            "zh": "要是变简单了，\n我也想再玩\n一遍呐～。",
            "narrator_zh": "雏"
        },
        {
            "location": "332/TALK",
            "narrator": "雛",
            "text": "ゲームシステムとか、\nストーリーは間違いなく\n面白いんだし。",
            "zh": "毕竟游戏系统啦\n剧情，明明都\n很有意思的。",
            "narrator_zh": "雏"
        },
        {
            "location": "333/TALK",
            "narrator": "キリト",
            "text": "ああ、同感だぜ！\n難易度のせいで\n台無しになってるけどな。",
            "zh": "啊，同感！\n就是难度把一切都\n毁了而已。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "334/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "337/TALK",
            "narrator": "つばめ",
            "text": "修正版が完成するの、\n楽しみに待ってます。",
            "zh": "我们等着修正版\n完成哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "338/TALK",
            "narrator": "みやび",
            "text": "…次からは、\nイージーモードも\n用意しちゃるか。",
            "zh": "…下次，\n就再给你备一个\n简单模式咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "339/ACT",
            "narrator": "",
            "text": "みんなが下手なだけだ",
            "zh": "只是大家太菜了而已",
            "narrator_zh": ""
        },
        {
            "location": "340/TALK",
            "narrator": "みやび",
            "text": "うちもそう思うがよ",
            "zh": "我也这么想咯",
            "narrator_zh": "雅"
        },
        {
            "location": "341/TALK",
            "narrator": "みやび",
            "text": "相棒もそう思うんなら、やはしうちの思うた通りやね",
            "zh": "连搭档都这么想，果然跟我想的一样咯",
            "narrator_zh": "雅"
        },
        {
            "location": "342/TALK",
            "narrator": "みやび",
            "text": "難易度下げる必要、なしや！",
            "zh": "没必要降难度咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "353/TALK",
            "narrator": "みやび",
            "text": "あんたら、\nゲーム下手過ぎやき。",
            "zh": "你们啊，\n游戏玩得也太菜啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "355/TALK",
            "narrator": "繭",
            "text": "なっ！？",
            "zh": "什！？",
            "narrator_zh": "茧"
        },
        {
            "location": "356/TALK",
            "narrator": "雛",
            "text": "あ、あたし達が下手！？",
            "zh": "我、我们太菜！？",
            "narrator_zh": "雏"
        },
        {
            "location": "357/TALK",
            "narrator": "つばめ",
            "text": "わ、わたしはちょっと、\nこういうの苦手かも…。",
            "zh": "我、我可能，\n不太擅长这种……。",
            "narrator_zh": "燕"
        },
        {
            "location": "360/TALK",
            "narrator": "キリト",
            "text": "聞き捨てならねぇな。\n俺はゲーセンでワンコイン\nクリアの常連なんすよ？",
            "zh": "这话我可不能听过就算。\n我在游戏厅可是\n一币通关的常客哦？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "362/TALK",
            "narrator": "みやび",
            "text": "ゲーセンはゲーセン。\nうちのゲームはうちの\nゲームちや。",
            "zh": "游戏厅是游戏厅。\n我的游戏是我的\n游戏滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "364/TALK",
            "narrator": "みやび",
            "text": "それに、ゲーセンのは\n難易度が低く設定されて\nるんもあるがよ。",
            "zh": "再说，游戏厅的\n难度本来就\n调得低咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "365/TALK",
            "narrator": "キリト",
            "text": "ぐっ、うぐぐ…っ！",
            "zh": "咕……呃呃呃……！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "367/TALK",
            "narrator": "雛",
            "text": "…こうなったら、\n練習するしかないよ。",
            "zh": "…都到这份上了，\n只能练了。",
            "narrator_zh": "雏"
        },
        {
            "location": "368/TALK",
            "narrator": "雛",
            "text": "いっぱい練習して、\nあたし達が下手じゃない\nことを証明しよう！",
            "zh": "拼命练习，\n证明我们根本\n不菜！",
            "narrator_zh": "雏"
        },
        {
            "location": "369/TALK",
            "narrator": "繭",
            "text": "賛成よ。\n私も下手と言われたままで\nいるのは性に合わないわ。",
            "zh": "赞成。\n被人说菜还一声不吭，\n不合我的性子。",
            "narrator_zh": "茧"
        },
        {
            "location": "370/TALK",
            "narrator": "キリト",
            "text": "先輩、絶対にクリアして\nみせるから、練習させて\nくれないっすか？",
            "zh": "前辈，我们绝对会\n通关给你看，能让我们\n练一练吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "371/TALK",
            "narrator": "みやび",
            "text": "うむ、えいよ。\n気が済むまで練習しい。",
            "zh": "嗯，得。\n练到自己爽够为止。",
            "narrator_zh": "雅"
        },
        {
            "location": "372/TALK",
            "narrator": "みやび",
            "text": "うちの出した評価が\n変わることを期待しとる\nがよ。",
            "zh": "我可期待着\n你们的水平能让我\n改评价咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "375/TALK",
            "narrator": "雛",
            "text": "よーし、今度はあたしが\nやってみる！",
            "zh": "好——这次换我\n来试一试！",
            "narrator_zh": "雏"
        },
        {
            "location": "376/TALK",
            "narrator": "みやび",
            "text": "…自分の作ったゲームで\n遊ぶヤツの姿を見るんは、\n気持ちえいもんやなぁ。",
            "zh": "…看着别人玩自己\n做的游戏，这感觉\n实在舒畅咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "378/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "379/TALK",
            "narrator": "真幌",
            "text": "おまえら…仕事中なのを\n忘れるなよ？",
            "zh": "你们几个……别忘了\n现在是工作时间哦？",
            "narrator_zh": "真幌"
        },
        {
            "location": "380/ACT",
            "narrator": "",
            "text": "ネットに公開だ",
            "zh": "公布到网上去",
            "narrator_zh": ""
        },
        {
            "location": "381/TALK",
            "narrator": "みやび",
            "text": "なるほど…それはえい考えかもしれんな",
            "zh": "原来如此……那说不定是个好主意咯",
            "narrator_zh": "雅"
        },
        {
            "location": "382/TALK",
            "narrator": "みやび",
            "text": "この難易度のゲームを、喉から手が出るほど求めちゅうヤツもおるやろうし",
            "zh": "渴求这种难度游戏想到喉咙里伸手的人，多半也有咯",
            "narrator_zh": "雅"
        },
        {
            "location": "383/TALK",
            "narrator": "みやび",
            "text": "決まりや、それでいくがよ",
            "zh": "就这么定了，我照这个来咯",
            "narrator_zh": "雅"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "なら、うちはこのゲームを\nネットに公開するちや。",
            "zh": "那我就把这游戏\n公布到网上去滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "396/TALK",
            "narrator": "みやび",
            "text": "あんたらはダメでも、\n世界にはこの難易度の\nゲームを――",
            "zh": "你们不行，\n但世界上想要这种\n难度的游戏的——",
            "narrator_zh": "雅"
        },
        {
            "location": "398/TALK",
            "narrator": "みやび",
            "text": "喉から手が出るほど\n求めちゅうヤツも\nおるやろうきね。",
            "zh": "渴求到喉咙里\n伸手的家伙，\n肯定也有啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "400/TALK",
            "narrator": "キリト",
            "text": "そりゃまあ、間違いなく\nいるとは思いますけど…。",
            "zh": "那倒是，肯定\n会有吧……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "402/TALK",
            "narrator": "繭",
            "text": "凄腕の廃人プレイヤー以外\n考えられません。",
            "zh": "除了顶尖的骨灰级\n玩家之外想不出来。",
            "narrator_zh": "茧"
        },
        {
            "location": "404/TALK",
            "narrator": "みやび",
            "text": "作り手のうちとしては、\n廃人でも構わんがよ。",
            "zh": "作为制作者的我，\n是骨灰玩家也无所谓咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "406/TALK",
            "narrator": "雛",
            "text": "…無料の、自作ゲーム\n配布サイトにでも\nアップするんですか？",
            "zh": "…是要上传到\n免费的自制游戏\n发布网站吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "408/TALK",
            "narrator": "みやび",
            "text": "そのつもりちや。",
            "zh": "我是这么打算滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "409/TALK",
            "narrator": "みやび",
            "text": "まあ、初めてやき、\nダウンロード数は期待\nできんやろうけんどな。",
            "zh": "毕竟是头一回啵，\n下载量估计\n指望不上咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "411/TALK",
            "narrator": "繭",
            "text": "…帰ったら、絶対に\nダウンロードしないと！",
            "zh": "…回去之后，\n绝对要下载下来！",
            "narrator_zh": "茧"
        },
        {
            "location": "413/TALK",
            "narrator": "雛",
            "text": "今夜中にステージ１\nくらいはクリアしたいな。",
            "zh": "今晚之内，至少想\n通关第 1 关呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "414/TALK",
            "narrator": "キリト",
            "text": "シューティングは苦手じゃ\nねぇってこと、証明して\nやるぜ！",
            "zh": "我会证明，射击游戏\n这种东西我根本\n不菜！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "234/DIALOG",
