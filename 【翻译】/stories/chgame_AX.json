    },
    "entry": [
        {
            "location": "356/SCENARIO",
            "narrator": "",
            "text": "AX強い敵（死ぬ） アーヤ",
            "zh": "AX强敌（会死） 绫水",
            "narrator_zh": ""
        },
        {
            "location": "381/TALK",
            "narrator": "アーヤ",
            "text": "やっと来たわね！\n待ってたわよ！！",
            "zh": "总算来了！\n我可是等了很久哦！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "382/TALK",
            "narrator": "千羽鶴",
            "text": "いけない！\nこの子は\nイカズゴケアーヤ！",
            "zh": "不好！\n这孩子是\n不嫁苔绫水！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "383/TALK",
            "narrator": "千羽鶴",
            "text": "婚期を逃すことを\n恐れるあまり、最強の\n敵になってしまった。",
            "zh": "因为太害怕错过婚期，\n结果变成了最强的\n敌人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "384/TALK",
            "narrator": "アーヤ",
            "text": "何をごちゃごちゃ\n言ってるの？",
            "zh": "你在嘀嘀咕咕\n说些什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "385/TALK",
            "narrator": "アーヤ",
            "text": "ここで会ったが\n１００年目。貴方から\n$handle$を奪う！",
            "zh": "冤家路窄，\n百年一遇。我从你\n手上夺走$handle$！",
            "narrator_zh": "绫水"
        },
        {
            "location": "386/TALK",
            "narrator": "アーヤ",
            "text": "そして、\n華々しく早婚を\nするんだから！",
            "zh": "然后，\n我要风风光光地\n把早婚办了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "387/TALK",
            "narrator": "千羽鶴",
            "text": "そんなことしなくても、\n$handle$は\n貴方の物よ、どーどー。",
            "zh": "用不着那样，\n$handle$本来就是你的，\n堂堂正正地拿哦。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "388/SEL",
            "narrator": "",
            "text": "貴方の「もの」って…",
            "zh": "你说的「东西」是……",
            "narrator_zh": ""
        },
        {
            "location": "389/SEL",
            "narrator": "",
            "text": "どーどーって…",
            "zh": "堂堂正正是……",
            "narrator_zh": ""
        },
        {
            "location": "390/ACT",
            "narrator": "",
            "text": "貴方の「もの」って…",
            "zh": "你说的「东西」是……",
            "narrator_zh": ""
        },
        {
            "location": "391/ACT",
            "narrator": "",
            "text": "どーどーって…",
            "zh": "堂堂正正是……",
            "narrator_zh": ""
        },
        {
            "location": "395/TALK",
            "narrator": "千羽鶴",
            "text": "大丈夫よ、落ち着いて。\n今ならこの子を倒せるわ。",
            "zh": "没事，冷静。\n现在能打倒这孩子。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "396/TALK",
            "narrator": "千羽鶴",
            "text": "さっき見つけた\n【早婚の杖】を\n使えば…！！",
            "zh": "只要用上刚找到的\n【早婚之杖】\n就行……！！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "400/TALK",
            "narrator": "千羽鶴",
            "text": "えーいっ！",
            "zh": "嘿——！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "405/TALK",
            "narrator": "アーヤ",
            "text": "きゃああっ！！",
            "zh": "呀啊啊！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "406/TALK",
            "narrator": "アーヤ",
            "text": "やられたぁぁ。",
            "zh": "被打倒了啊啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "418/TALK",
            "narrator": "千羽鶴",
            "text": "杖のお陰で\n何とか倒せた。",
            "zh": "多亏了法杖，\n总算打倒了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "419/TALK",
            "narrator": "千羽鶴",
            "text": "先へ進みましょ。",
            "zh": "继续前进吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "432/TALK",
            "narrator": "千羽鶴",
            "text": "いけない。\nこの子は強い。",
            "zh": "不好。\n这孩子很强。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "434/TALK",
            "narrator": "千羽鶴",
            "text": "今の私たちでは\nとても太刀打ちできない。",
            "zh": "凭现在的我们，\n根本没法抗衡。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "436/TALK",
            "narrator": "千羽鶴",
            "text": "私は\n非攻略対象！",
            "zh": "我是\n非攻略对象！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "443/TALK",
            "narrator": "アーヤ",
            "text": "はああっ！！",
            "zh": "哈啊啊！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "363/DIALOG",
            "narrator": "NOTICE",
            "text": "敵が現れた！！",
            "zh": "敌人出现了！！",
            "narrator_zh": "NOTICE"
        },
        {
            "location": "398/DIALOG",
            "narrator": "INFO",
            "text": "千羽鶴は\n【早婚の杖】を\nつかった！",
            "zh": "千羽鹤\n使用了\n【早婚之杖】！",
            "narrator_zh": "INFO"
        },
        {
            "location": "435/DIALOG",
            "narrator": "INFO",
            "text": "千羽鶴のこうげき！",
            "zh": "千羽鹤的攻击！",
            "narrator_zh": "INFO"
        },
        {
            "location": "441/DIALOG",
            "narrator": "INFO",
            "text": "イカズゴケアーヤに\n１ポイントのダメージ",
            "zh": "对不嫁苔绫水造成\n１点伤害",
            "narrator_zh": "INFO"
        },
        {
            "location": "442/DIALOG",
            "narrator": "INFO",
            "text": "イカズゴケアーヤの\nこうげき！",
            "zh": "不嫁苔绫水的\n攻击！",
            "narrator_zh": "INFO"
        },
        {
            "location": "449/DIALOG",
            "narrator": "INFO",
            "text": "千羽鶴は\n10000ポイントのダメージ",
            "zh": "千羽鹤受到\n10000点伤害",
            "narrator_zh": "INFO"
        },
        {
            "location": "450/DIALOG",
            "narrator": "INFO",
            "text": "千羽鶴は\n死んでしまった。",
            "zh": "千羽鹤\n死掉了。",
            "narrator_zh": "INFO"
        }
    ]
}
