{
    "dir": "chap10/daydra/dd_ch04_10_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "10402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "遊んでるわけやない＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "可不是在玩＜前篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "遊んでるわけやない",
            "zh": "可不是在玩",
            "narrator_zh": ""
        },
        {
            "location": "32/TALK",
            "narrator": "真幌",
            "text": "これが今日入荷した\nフィルムだ。\nすぐに整理してくれ。",
            "zh": "这是今天入库的\n胶片。\n马上整理好。",
            "narrator_zh": "真幌"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "五本も入荷したが\nですか？\n珍しく多いですね。",
            "zh": "居然入库了五部，\n是吗？\n还真是少见地多呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "36/TALK",
            "narrator": "真幌",
            "text": "とある好事家から、\n色々あって手に入れた\n超レア物なんだ。",
            "zh": "从某个发烧友那里，\n几经周折弄到手的\n超稀有货。",
            "narrator_zh": "真幌"
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "…そうですか。",
            "zh": "……这样啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "真幌",
            "text": "そうだ。\nつまり、何を言いたい\nかというと――",
            "zh": "对了。\n也就是说，我想说的\n是——",
            "narrator_zh": "真幌"
        },
        {
            "location": "41/TALK",
            "narrator": "真幌",
            "text": "絶対にキズとか\nつけたりするなよ？\nしたら弁償だぞ？",
            "zh": "绝对不许弄出\n划痕之类的。\n弄了就照价赔偿？",
            "narrator_zh": "真幌"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "褒められませんがよ。\nそんな責任、バイトに\n押し付けるゆうんは。",
            "zh": "这可没法恭维啊。\n把这种责任推给\n打工的人，真是的。",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "真幌",
            "text": "文句を言うな。\n任せるのが逢瀬達なら\nこんなことは言わん。",
            "zh": "别抱怨了。\n要是交给逢濑她们，\n我就不会说这些。",
            "narrator_zh": "真幌"
        },
        {
            "location": "46/TALK",
            "narrator": "真幌",
            "text": "だが、おまえは\n特にズボラだからな。",
            "zh": "但你这家伙，\n是出了名的懒散。",
            "narrator_zh": "真幌"
        },
        {
            "location": "47/TALK",
            "narrator": "真幌",
            "text": "鞭を与えておかんと、\n適当なことをする\n可能性が捨てきれん。",
            "zh": "不先抽一鞭子，\n就不能排除你\n应付了事的可能。",
            "narrator_zh": "真幌"
        },
        {
            "location": "48/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "…まほさん、\n鏡を見たことないが？",
            "zh": "……真幌，\n你没照过镜子吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "まほさんの方が、\nうちの数倍ズボラや\nっちゅうに…。",
            "zh": "真幌你自己，\n明明比我懒上好几倍，\n还敢说我……。",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "しっかし、何でこんな\nよくわからん白黒映画\n集めちょるが？",
            "zh": "话说回来，为什么要收\n这种莫名其妙的\n黑白电影嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "72/TALK",
            "narrator": "みやび",
            "text": "こんなもん\n上映したって、\n客なんぞ来ない――",
            "zh": "放映这种东西，\n客人什么的\n才不会来——",
            "narrator_zh": "雅"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "いや、来られたら\n困るのか。",
            "zh": "不对，要是真来人\n反倒麻烦咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "人に来られても\n困るし、営業せんでも\nやはり困る…。",
            "zh": "有人来也头疼，\n不营业吧，\n还是头疼……。",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "今更やけんど、\n面倒な映画館やね。",
            "zh": "事到如今才说，\n真是麻烦的电影馆咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "このフィルムも、\n聞いたことない\n映画やし…ん？",
            "zh": "这胶片也是，\n一部没听说过的\n电影……嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "この映像…、\n知ってるぞ？\n確かどこかで…。",
            "zh": "这个影像……，\n我认识啊？\n好像在哪里……。",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "う～ん……。",
            "zh": "唔～……。",
            "narrator_zh": "雅"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "緊急事態",
            "zh": "紧急事态",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "今見た映画の映像",
            "zh": "刚看的电影画面",
            "narrator_zh": "雅"
        },
        {
            "location": "86/TALK",
            "narrator": "みやび",
            "text": "どっかで見たことある",
            "zh": "好像在哪见过",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "けど",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "思い出せん",
            "zh": "想不起来",
            "narrator_zh": "雅"
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "検索頼む",
            "zh": "拜托搜一下",
            "narrator_zh": "雅"
        },
        {
            "location": "91/SEL",
            "narrator": "",
            "text": "さすがに画像見ないとわからない",
            "zh": "不看图片果然不知道",
            "narrator_zh": ""
        },
        {
            "location": "92/SEL",
            "narrator": "",
            "text": "ガッテン姉貴！",
            "zh": "懂了，大姐头！",
            "narrator_zh": ""
        },
        {
            "location": "93/ACT",
            "narrator": "",
            "text": "さすがに画像見ないとわからない",
            "zh": "不看图片果然不知道",
            "narrator_zh": ""
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "面倒くさい",
            "zh": "麻烦死了",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "自分で調べよ",
            "zh": "自己查去",
            "narrator_zh": "雅"
        },
        {
            "location": "98/SEL",
            "narrator": "",
            "text": "そう言わずに、見せて",
            "zh": "别这么说，给我看看嘛",
            "narrator_zh": ""
        },
        {
            "location": "99/SEL",
            "narrator": "",
            "text": "無理なので諦めます",
            "zh": "做不到，我放弃",
            "narrator_zh": ""
        },
        {
            "location": "100/ACT",
            "narrator": "",
            "text": "そう言わずに、見せて",
            "zh": "别这么说，给我看看嘛",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "仕方のないヤツめ",
            "zh": "真拿你没办法",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "うちの優しさに震えよ",
            "zh": "在我的温柔面前颤抖吧",
            "narrator_zh": "雅"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "見せたぞ",
            "zh": "给你看咯",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "すっと検索せよ",
            "zh": "快点去搜",
            "narrator_zh": "雅"
        },
        {
            "location": "110/SEL",
            "narrator": "",
            "text": "これだけじゃ不可能だ",
            "zh": "就这点根本不可能找到",
            "narrator_zh": ""
        },
        {
            "location": "111/ACT",
            "narrator": "",
            "text": "これだけじゃ不可能だ",
            "zh": "就这点根本不可能找到",
            "narrator_zh": ""
        },
        {
            "location": "113/TALK",
            "narrator": "みやび",
            "text": "ここまでさせといてそれか？",
            "zh": "都伺候到这个份上了，就这？",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "期待はしとらんかったが",
            "zh": "虽然本来就没指望你",
            "narrator_zh": "雅"
        },
        {
            "location": "115/ACT",
            "narrator": "",
            "text": "無理なので諦めます",
            "zh": "做不到，我放弃",
            "narrator_zh": ""
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "うむ",
            "zh": "嗯。",
            "narrator_zh": "雅"
        },
        {
            "location": "117/TALK",
            "narrator": "みやび",
            "text": "期待しとらんかったき",
            "zh": "本来就没指望啵",
            "narrator_zh": "雅"
        },
        {
            "location": "118/TALK",
            "narrator": "みやび",
            "text": "それでえいよ",
            "zh": "那样就得咯",
            "narrator_zh": "雅"
        },
        {
            "location": "120/ACT",
            "narrator": "",
            "text": "ガッテン姉貴",
            "zh": "懂了，大姐头！",
            "narrator_zh": ""
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "マジか",
            "zh": "真的假的",
            "narrator_zh": "雅"
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "じゃあ",
            "zh": "那么",
            "narrator_zh": "雅"
        },
        {
            "location": "124/TALK",
            "narrator": "みやび",
            "text": "どれくらいで検索できる？",
            "zh": "多久能搜出来？",
            "narrator_zh": "雅"
        },
        {
            "location": "126/SEL",
            "narrator": "",
            "text": "一瞬",
            "zh": "一瞬间",
            "narrator_zh": ""
        },
        {
            "location": "127/SEL",
            "narrator": "",
            "text": "１０分",
            "zh": "１０分钟",
            "narrator_zh": ""
        },
        {
            "location": "128/SEL",
            "narrator": "",
            "text": "１０年",
            "zh": "１０年",
            "narrator_zh": ""
        },
        {
            "location": "129/ACT",
            "narrator": "",
            "text": "一瞬",
            "zh": "一瞬间",
            "narrator_zh": ""
        },
        {
            "location": "130/TALK",
            "narrator": "みやび",
            "text": "一瞬なら",
            "zh": "要是一瞬间的话",
            "narrator_zh": "雅"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "一瞬と答える前に",
            "zh": "在回答一瞬之前",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "検索結果を出しぃ",
            "zh": "就先把搜索结果交出来",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "そして未だに出てこない",
            "zh": "然后到现在都没出来",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "慰謝料は気持ち程度でえいぞ",
            "zh": "精神损失费给个意思就行咯",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "みやび",
            "text": "ハワイ旅行７泊８日程度でな",
            "zh": "夏威夷７晚８天游的程度就行咯",
            "narrator_zh": "雅"
        },
        {
            "location": "137/ACT",
            "narrator": "",
            "text": "１０分",
            "zh": "１０分钟",
            "narrator_zh": ""
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "遅くも早くもない",
            "zh": "说慢不慢说快不快",
            "narrator_zh": "雅"
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "微妙な時間やけんど",
            "zh": "挺微妙的时间就是咯",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "ストレス溜まって",
            "zh": "压力攒起来",
            "narrator_zh": "雅"
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "どうでもよくなるには",
            "zh": "要想变得无所谓",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "十分過ぎる時間や",
            "zh": "这时间绰绰有余咯",
            "narrator_zh": "雅"
        },
        {
            "location": "143/TALK",
            "narrator": "みやび",
            "text": "この疑問",
            "zh": "这个疑问",
            "narrator_zh": "雅"
        },
        {
            "location": "145/TALK",
            "narrator": "みやび",
            "text": "迷宮入り！",
            "zh": "就此成谜！",
            "narrator_zh": "雅"
        },
        {
            "location": "146/ACT",
            "narrator": "",
            "text": "１０年",
            "zh": "１０年",
            "narrator_zh": ""
        },
        {
            "location": "147/TALK",
            "narrator": "みやび",
            "text": "駄菓子屋のおじちゃんか？",
            "zh": "你是零食铺大叔吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "１００円の物を１００万円っちゅう",
            "zh": "把１００日元的东西说成１００万日元",
            "narrator_zh": "雅"
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "つまり渡すのは",
            "zh": "也就是说要交的",
            "narrator_zh": "雅"
        },
        {
            "location": "150/TALK",
            "narrator": "みやび",
            "text": "１０秒でえいな？",
            "zh": "１０秒就得咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "151/TALK",
            "narrator": "みやび",
            "text": "ほれ、１０、９、８、７、６",
            "zh": "来，１０、９、８、７、６",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "みやび",
            "text": "５、４、３、２、１",
            "zh": "５、４、３、２、１",
            "narrator_zh": "雅"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "ウソつき確定！",
            "zh": "骗子坐实！",
            "narrator_zh": "雅"
        },
        {
            "location": "154/TALK",
            "narrator": "みやび",
            "text": "１０年反省しぃ",
            "zh": "给我反省１０年",
            "narrator_zh": "雅"
        },
        {
            "location": "157/TALK",
            "narrator": "みやび",
            "text": "いや待て",
            "zh": "不，等等",
            "narrator_zh": "雅"
        },
        {
            "location": "159/TALK",
            "narrator": "みやび",
            "text": "思い出した！",
            "zh": "想起来了！",
            "narrator_zh": "雅"
        },
        {
            "location": "164/TALK",
            "narrator": "みやび",
            "text": "確か、こんな感じの\n名前だったか？",
            "zh": "记得，好像是\n这种感觉的名字？",
            "narrator_zh": "雅"
        },
        {
            "location": "170/TALK",
            "narrator": "みやび",
            "text": "あった、これや！\nこのサイトやったかー。",
            "zh": "有了，是这个！\n原来是这个网站啊——。",
            "narrator_zh": "雅"
        },
        {
            "location": "171/TALK",
            "narrator": "みやび",
            "text": "しっかし、誰がこんな\nサイト運営しちょるか。",
            "zh": "话说回来，谁在\n运营这种网站啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "…まさか、まほさんの\n言うてた好事家って――",
            "zh": "……难不成，真幌说的\n那个发烧友——",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "こいつらと\n関係あるんかいな？",
            "zh": "跟这帮家伙\n有关系咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "174/SEL",
            "narrator": "",
            "text": "一人で楽しまないで",
            "zh": "不要一个人偷乐",
            "narrator_zh": ""
        },
        {
            "location": "175/ACT",
            "narrator": "",
            "text": "一人で楽しまないで",
            "zh": "不要一个人偷乐",
            "narrator_zh": ""
        },
        {
            "location": "183/TALK",
            "narrator": "みやび",
            "text": "いやー",
            "zh": "哎呀——",
            "narrator_zh": "雅"
        },
        {
            "location": "185/TALK",
            "narrator": "みやび",
            "text": "それはムリな話や",
            "zh": "那可办不到咯",
            "narrator_zh": "雅"
        },
        {
            "location": "186/TALK",
            "narrator": "みやび",
            "text": "チャットじゃ見せられん",
            "zh": "聊天里没法给你看",
            "narrator_zh": "雅"
        },
        {
            "location": "189/SEL",
            "narrator": "",
            "text": "また画像送ってよ",
            "zh": "再把图片发来嘛",
            "narrator_zh": ""
        },
        {
            "location": "190/ACT",
            "narrator": "",
            "text": "また画像送ってよ",
            "zh": "再把图片发来嘛",
            "narrator_zh": ""
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "くだらんこと覚えよって",
            "zh": "记这种无聊玩意干嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "194/SEL",
            "narrator": "",
            "text": "画像送ってよ",
            "zh": "把图片发来嘛",
            "narrator_zh": ""
        },
        {
            "location": "195/ACT",
            "narrator": "",
            "text": "画像送ってよ",
            "zh": "把图片发来嘛",
            "narrator_zh": ""
        },
        {
            "location": "199/TALK",
            "narrator": "みやび",
            "text": "これな",
            "zh": "喏，这个",
            "narrator_zh": "雅"
        },
        {
            "location": "201/TALK",
            "narrator": "みやび",
            "text": "イケてないサイトやろ？",
            "zh": "很逊的网站，是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "207/TALK",
            "narrator": "みやび",
            "text": "どっかのマニアが管理しちょる",
            "zh": "是哪个狂热粉在管理着",
            "narrator_zh": "雅"
        },
        {
            "location": "209/TALK",
            "narrator": "みやび",
            "text": "トライナリーファンサイトや",
            "zh": "是三重奏粉丝网站咯",
            "narrator_zh": "雅"
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "トライナリーは身バレ厳禁",
            "zh": "三重奏严禁身份暴露",
            "narrator_zh": "雅"
        },
        {
            "location": "211/TALK",
            "narrator": "みやび",
            "text": "つまり",
            "zh": "也就是说",
            "narrator_zh": "雅"
        },
        {
            "location": "212/TALK",
            "narrator": "みやび",
            "text": "学校以外の人間は誰も知らん",
            "zh": "学校以外没人知道",
            "narrator_zh": "雅"
        },
        {
            "location": "213/TALK",
            "narrator": "みやび",
            "text": "けんど",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "214/TALK",
            "narrator": "みやび",
            "text": "何故か年頃の女の子が戦っちょるゆうんは",
            "zh": "不知为何，「妙龄少女们在战斗」这种说法",
            "narrator_zh": "雅"
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "公然の秘密みたいな感じで出回っとる",
            "zh": "以公开秘密的架势流传着",
            "narrator_zh": "雅"
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "下らんサイトが乱立するんは",
            "zh": "无聊网站遍地乱冒",
            "narrator_zh": "雅"
        },
        {
            "location": "217/TALK",
            "narrator": "みやび",
            "text": "この噂が原因や",
            "zh": "原因就是这个传言咯",
            "narrator_zh": "雅"
        },
        {
            "location": "218/TALK",
            "narrator": "みやび",
            "text": "例えば",
            "zh": "比如说",
            "narrator_zh": "雅"
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "トライナリーの正体は",
            "zh": "三重奏的真实身份是",
            "narrator_zh": "雅"
        },
        {
            "location": "220/TALK",
            "narrator": "みやび",
            "text": "あの有名地下アイドルだった！",
            "zh": "竟然是那个有名的地下偶像！",
            "narrator_zh": "雅"
        },
        {
            "location": "221/TALK",
            "narrator": "みやび",
            "text": "…アホかと",
            "zh": "……是笨蛋吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "そんなクソ情報",
            "zh": "那种垃圾情报",
            "narrator_zh": "雅"
        },
        {
            "location": "224/TALK",
            "narrator": "みやび",
            "text": "どこから手に入れるのか？",
            "zh": "到底从哪弄来的？",
            "narrator_zh": "雅"
        },
        {
            "location": "226/SEL",
            "narrator": "",
            "text": "実際やったら売れそう",
            "zh": "真这么做的话好像能卖",
            "narrator_zh": ""
        },
        {
            "location": "227/ACT",
            "narrator": "",
            "text": "実際やったら売れそう",
            "zh": "真这么做的话好像能卖",
            "narrator_zh": ""
        },
        {
            "location": "229/TALK",
            "narrator": "みやび",
            "text": "は？",
            "zh": "哈？",
            "narrator_zh": "雅"
        },
        {
            "location": "231/TALK",
            "narrator": "みやび",
            "text": "ありえん",
            "zh": "不可能",
            "narrator_zh": "雅"
        },
        {
            "location": "232/TALK",
            "narrator": "みやび",
            "text": "アイドルキャラ作るなんぞ",
            "zh": "搞偶像人设什么的",
            "narrator_zh": "雅"
        },
        {
            "location": "233/TALK",
            "narrator": "みやび",
            "text": "面倒臭過ぎる",
            "zh": "麻烦到不行",
            "narrator_zh": "雅"
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "今でもキャラ作っちょるっちゅうに",
            "zh": "明明现在已经在捏人设了",
            "narrator_zh": "雅"
        },
        {
            "location": "235/TALK",
            "narrator": "みやび",
            "text": "しかもうちには合わん",
            "zh": "而且跟我完全不搭",
            "narrator_zh": "雅"
        },
        {
            "location": "237/SEL",
            "narrator": "",
            "text": "素でやればいいじゃん",
            "zh": "本色出演不就行了嘛",
            "narrator_zh": ""
        },
        {
            "location": "238/ACT",
            "narrator": "",
            "text": "素でやればいいじゃん",
            "zh": "本色出演不就行了嘛",
            "narrator_zh": ""
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "ありえん",
            "zh": "不可能",
            "narrator_zh": "雅"
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "あほらしい",
            "zh": "蠢死了",
            "narrator_zh": "雅"
        },
        {
            "location": "289/TALK",
            "narrator": "みやび",
            "text": "お、来よったか。\nはよ、はよ。",
            "zh": "哦，来了呀。\n快点、快点。",
            "narrator_zh": "雅"
        },
        {
            "location": "302/TALK",
            "narrator": "みやび",
            "text": "あいたっ！",
            "zh": "好痛！",
            "narrator_zh": "雅"
        },
        {
            "location": "305/TALK",
            "narrator": "みやび",
            "text": "きゃあー",
            "zh": "呀啊——",
            "narrator_zh": "雅"
        },
        {
            "location": "308/TALK",
            "narrator": "みやび",
            "text": "はあっ！",
            "zh": "哈啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "314/TALK",
            "narrator": "みやび",
            "text": "みやびさん\n２ポイントゲット。",
            "zh": "雅小姐\n获得２点。",
            "narrator_zh": "雅"
        },
        {
            "location": "315/SEL",
            "narrator": "",
            "text": "なんですかそれ",
            "zh": "那是什么呀",
            "narrator_zh": ""
        },
        {
            "location": "316/ACT",
            "narrator": "",
            "text": "なんですかそれ",
            "zh": "那是什么呀",
            "narrator_zh": ""
        },
        {
            "location": "318/TALK",
            "narrator": "みやび",
            "text": "おさわりポイントや。",
            "zh": "是摸摸积分咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "319/TALK",
            "narrator": "みやび",
            "text": "これからお前さんが\nうちを触るたびに\nポイントが加算され――",
            "zh": "从今往后你每摸\n我一次，就累加\n积分——",
            "narrator_zh": "雅"
        },
        {
            "location": "320/TALK",
            "narrator": "みやび",
            "text": "貯まるとなんと！\nみやびさんがお前さんに\n何かをねだる！",
            "zh": "攒够了竟会——！\n雅小姐朝你\n讨要东西！",
            "narrator_zh": "雅"
        },
        {
            "location": "321/SEL",
            "narrator": "",
            "text": "何ポイントでねだるの？",
            "zh": "攒多少点讨一次？",
            "narrator_zh": ""
        },
        {
            "location": "322/SEL",
            "narrator": "",
            "text": "何をねだるの？",
            "zh": "讨什么东西？",
            "narrator_zh": ""
        },
        {
            "location": "323/ACT",
            "narrator": "",
            "text": "何ポイントでねだるの？",
            "zh": "攒多少点讨一次？",
            "narrator_zh": ""
        },
        {
            "location": "324/ACT",
            "narrator": "",
            "text": "何をねだるの？",
            "zh": "讨什么东西？",
            "narrator_zh": ""
        },
        {
            "location": "326/TALK",
            "narrator": "みやび",
            "text": "さあね。\nキマグレやき。",
            "zh": "谁知道呢。\n看心情啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "327/TALK",
            "narrator": "みやび",
            "text": "明日本マグロを\nねだるかもしれんし、\n１年後に指輪かもしれん。",
            "zh": "明天可能讨\n蓝鳍金枪鱼，\n一年后也可能讨戒指。",
            "narrator_zh": "雅"
        },
        {
            "location": "328/SEL",
            "narrator": "",
            "text": "随分高価ですね…",
            "zh": "这也太贵重了吧……",
            "narrator_zh": ""
        },
        {
            "location": "329/SEL",
            "narrator": "",
            "text": "そんなキマグレじゃポイント意味なくね？",
            "zh": "这么看心情的话积分不就没意义了？",
            "narrator_zh": ""
        },
        {
            "location": "330/ACT",
            "narrator": "",
            "text": "随分高価ですね…",
            "zh": "这也太贵重了吧……",
            "narrator_zh": ""
        },
        {
            "location": "331/TALK",
            "narrator": "みやび",
            "text": "うちを触りゆうは\nそうゆうことやき。",
            "zh": "你摸我图的\n就是这个啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "332/ACT",
            "narrator": "",
            "text": "そんなキマグレじゃポイント意味なくね？",
            "zh": "这么看心情的话积分不就没意义了？",
            "narrator_zh": ""
        },
        {
            "location": "333/TALK",
            "narrator": "みやび",
            "text": "うちが暇つぶしに\n盛り上がる為に\n意味がある！",
            "zh": "为了我消遣时\n玩得开心，\n就有意义！",
            "narrator_zh": "雅"
        },
        {
            "location": "335/TALK",
            "narrator": "みやび",
            "text": "…と、そんなことより、\nそろそろ仕事を\nさせてもらえんかね。",
            "zh": "……总之闲话到此，\n也该让我\n干活了吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "336/SEL",
            "narrator": "",
            "text": "ど、どうぞ……",
            "zh": "请、请便……",
            "narrator_zh": ""
        },
        {
            "location": "337/ACT",
            "narrator": "",
            "text": "ど、どうぞ……",
            "zh": "请、请便……",
            "narrator_zh": ""
        },
        {
            "location": "341/TALK",
            "narrator": "みやび",
            "text": "まったく、お前さんは\nすぐに脇道に逸れるき\n仕事が全然進まんちや。",
            "zh": "真是的，你老是\n岔开话题啵，害我\n活儿一点都推进不了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "342/SEL",
            "narrator": "",
            "text": "えー…",
            "zh": "诶——……",
            "narrator_zh": ""
        },
        {
            "location": "343/SEL",
            "narrator": "",
            "text": "前回「仕事ばかり」だって言ってたから、いい潤いになったでしょ？",
            "zh": "上次不是说「净是工作」嘛，就当调剂一下了？",
            "narrator_zh": ""
        },
        {
            "location": "344/ACT",
            "narrator": "",
            "text": "えー…",
            "zh": "诶——……",
            "narrator_zh": ""
        },
        {
            "location": "345/TALK",
            "narrator": "みやび",
            "text": "なんぞ？",
            "zh": "驷马？",
            "narrator_zh": "雅"
        },
        {
            "location": "346/ACT",
            "narrator": "",
            "text": "前回「仕事ばかり」だって言ってたから、いい潤いになったでしょ？",
            "zh": "上次不是说「净是工作」嘛，就当调剂一下了？",
            "narrator_zh": ""
        },
        {
            "location": "349/TALK",
            "narrator": "みやび",
            "text": "否！\nそれはまた別やき。",
            "zh": "否！\n那又是另一回事啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "350/TALK",
            "narrator": "みやび",
            "text": "えいか。うちがゆうたがは\n仕事が無い状態で戯れたい\nっちゅうことや。",
            "zh": "懂了吗？我说的是\n要在没活干的时候\n嬉闹咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "仕事が目の前にあったら\n思う存分楽しめんぞね。",
            "zh": "工作摆在眼前的话，\n就没法玩得尽兴咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "352/SEL",
            "narrator": "",
            "text": "戯れたいんですか！？",
            "zh": "你想嬉闹！？",
            "narrator_zh": ""
        },
        {
            "location": "353/ACT",
            "narrator": "",
            "text": "戯れたいんですか！？",
            "zh": "你想嬉闹！？",
            "narrator_zh": ""
        },
        {
            "location": "356/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "357/TALK",
            "narrator": "みやび",
            "text": "そんなことは\n言っちょらんがね。",
            "zh": "那种话\n我可没说过啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "359/TALK",
            "narrator": "みやび",
            "text": "ほれ、\nまた横道に逸れる！\nもう先に進むぞね！",
            "zh": "看吧，\n又岔到一边去了！\n赶紧往下进行咧！",
            "narrator_zh": "雅"
        },
        {
            "location": "366/TALK",
            "narrator": "みやび",
            "text": "オープンプロセス、\n0x815番地から\n0x2CC番地へ。",
            "zh": "开放进程，\n从0x815地址\n到0x2CC地址。",
            "narrator_zh": "雅"
        },
        {
            "location": "388/TALK",
            "narrator": "みやび",
            "text": "完了。",
            "zh": "完成。",
            "narrator_zh": "雅"
        },
        {
            "location": "390/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "392/TALK",
            "narrator": "みやび",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "雅"
        },
        {
            "location": "393/TALK",
            "narrator": "みやび",
            "text": "………だが断る！",
            "zh": "………但是我拒绝！",
            "narrator_zh": "雅"
        },
        {
            "location": "394/SEL",
            "narrator": "",
            "text": "な、何を！？",
            "zh": "你、你要干什么！？",
            "narrator_zh": ""
        },
        {
            "location": "395/ACT",
            "narrator": "",
            "text": "な、何を！？",
            "zh": "你、你要干什么！？",
            "narrator_zh": ""
        },
        {
            "location": "397/TALK",
            "narrator": "みやび",
            "text": "どうせアイドルユニットを\n結成するための一押しを\n期待しちゅうがやろ？",
            "zh": "反正你就是想\n来一手「推我结成偶像\n组合」，是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "398/SEL",
            "narrator": "",
            "text": "まさかそんな…",
            "zh": "怎么会那样……",
            "narrator_zh": ""
        },
        {
            "location": "399/SEL",
            "narrator": "",
            "text": "みやびのアイドル姿が見たい",
            "zh": "想看雅的偶像姿态",
            "narrator_zh": ""
        },
        {
            "location": "400/ACT",
            "narrator": "",
            "text": "まさかそんな…",
            "zh": "怎么会那样……",
            "narrator_zh": ""
        },
        {
            "location": "401/TALK",
            "narrator": "みやび",
            "text": "ふむ。\nならばよいが。",
            "zh": "唔。\n那样就好。",
            "narrator_zh": "雅"
        },
        {
            "location": "402/ACT",
            "narrator": "",
            "text": "みやびのアイドル姿が見たい",
            "zh": "想看雅的偶像姿态",
            "narrator_zh": ""
        },
        {
            "location": "403/TALK",
            "narrator": "みやび",
            "text": "やはりか！\nだが断る！！",
            "zh": "果然如此！\n但是我拒绝！！",
            "narrator_zh": "雅"
        },
        {
            "location": "404/SEL",
            "narrator": "",
            "text": "ですよねー",
            "zh": "就是嘛——",
            "narrator_zh": ""
        },
        {
            "location": "405/SEL",
            "narrator": "",
            "text": "そこを何とか！",
            "zh": "这里就通融通融嘛！",
            "narrator_zh": ""
        },
        {
            "location": "406/ACT",
            "narrator": "",
            "text": "ですよねー",
            "zh": "就是嘛——",
            "narrator_zh": ""
        },
        {
            "location": "408/TALK",
            "narrator": "みやび",
            "text": "あたりまえや。\n全く、仕方のないやつめ。",
            "zh": "当然咯。\n真是的，拿你没法子。",
            "narrator_zh": "雅"
        },
        {
            "location": "409/ACT",
            "narrator": "",
            "text": "そこを何とか！",
            "zh": "这里就通融通融嘛！",
            "narrator_zh": ""
        },
        {
            "location": "410/TALK",
            "narrator": "みやび",
            "text": "死んでもやらん。",
            "zh": "死也不干。",
            "narrator_zh": "雅"
        },
        {
            "location": "411/SEL",
            "narrator": "",
            "text": "松",
            "zh": "松",
            "narrator_zh": ""
        },
        {
            "location": "412/SEL",
            "narrator": "",
            "text": "素直にやめる",
            "zh": "老实放弃",
            "narrator_zh": ""
        },
        {
            "location": "413/ACT",
            "narrator": "",
            "text": "松",
            "zh": "松",
            "narrator_zh": ""
        },
        {
            "location": "414/TALK",
            "narrator": "みやび",
            "text": "なんぞ松っちゅうんは…",
            "zh": "「松」是驷马玩意啊……",
            "narrator_zh": "雅"
        },
        {
            "location": "433/TALK",
            "narrator": "みやび",
            "text": "……ん？",
            "zh": "……嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "435/TALK",
            "narrator": "みやび",
            "text": "ふわあっ！\nこれはなんぞね！！",
            "zh": "呼哇！\n这是驷马啊！！",
            "narrator_zh": "雅"
        },
        {
            "location": "445/TALK",
            "narrator": "みやび",
            "text": "ま、まさか\nうちがこんなことを！",
            "zh": "不、不会吧，\n我竟会做出这种事！",
            "narrator_zh": "雅"
        },
        {
            "location": "455/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "456/TALK",
            "narrator": "みやび",
            "text": "なんでこんなことを\nせないかんちや！",
            "zh": "为什么非得\n做这种事滴！",
            "narrator_zh": "雅"
        },
        {
            "location": "466/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "468/TALK",
            "narrator": "みやび",
            "text": "デレッ♪",
            "zh": "娇羞♪",
            "narrator_zh": "雅"
        },
        {
            "location": "485/TALK",
            "narrator": "みやび",
            "text": "さて。\nどうゆうことなのか\n説明してもらうぞね。",
            "zh": "那么。\n到底是怎么回事，\n给我解释清楚咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "486/SEL",
            "narrator": "",
            "text": "説明も何も「松」っての押しただけですけど",
            "zh": "没什么好说的，我就是按了下「松」而已",
            "narrator_zh": ""
        },
        {
            "location": "487/SEL",
            "narrator": "",
            "text": "みやびだってノリノリだったじゃん",
            "zh": "雅你不也一样来劲了嘛",
            "narrator_zh": ""
        },
        {
            "location": "488/ACT",
            "narrator": "",
            "text": "説明も何も「松」っての押しただけですけど",
            "zh": "没什么好说的，我就是按了下「松」而已",
            "narrator_zh": ""
        },
        {
            "location": "490/TALK",
            "narrator": "みやび",
            "text": "「松」ってのを押した？\nなんぞ、そのボタン押し\nちゅうような言い方は。",
            "zh": "按了叫「松」的玩意？\n驷马，「按按钮」\n这种说法算怎么回事。",
            "narrator_zh": "雅"
        },
        {
            "location": "491/TALK",
            "narrator": "みやび",
            "text": "まあえい。",
            "zh": "得吧得吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "492/TALK",
            "narrator": "みやび",
            "text": "お前さんは色々\n謎なことをやりゆうき、\nやはり要注意やね。",
            "zh": "你尽做些\n莫名其妙的事啵，\n果然得多提防咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "493/ACT",
            "narrator": "",
            "text": "みやびだってノリノリだったじゃん",
            "zh": "雅你不也一样来劲了嘛",
            "narrator_zh": ""
        },
        {
            "location": "495/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "496/TALK",
            "narrator": "みやび",
            "text": "うちは、どうせやるなら\n全力でやるっちゅう\nポリシーがあるだけや。",
            "zh": "我只是有条原则，\n反正要做就\n全力去做咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "498/TALK",
            "narrator": "みやび",
            "text": "別にお前さんとは\n全然関係ないわ。",
            "zh": "跟你完全\n没关系。",
            "narrator_zh": "雅"
        },
        {
            "location": "500/TALK",
            "narrator": "みやび",
            "text": "ほれ！\nまた脱線したちや！",
            "zh": "看吧！\n又跑题滴！",
            "narrator_zh": "雅"
        },
        {
            "location": "501/TALK",
            "narrator": "みやび",
            "text": "うちの葛藤を\n解消しに来たがやろ。\n本題に移るぞね。",
            "zh": "你是来解决\n我的挣扎的吧。\n进入正题咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "502/ACT",
            "narrator": "",
            "text": "素直にやめる",
            "zh": "老实放弃",
            "narrator_zh": ""
        },
        {
            "location": "503/TALK",
            "narrator": "みやび",
            "text": "ふむ。\n当然の判断や。",
            "zh": "唔。\n理所当然的判断咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "507/TALK",
            "narrator": "みやび",
            "text": "今回のうちからの願いは、\n調査を諦めんよう、一押し\nして欲しいという事や。",
            "zh": "这次我的愿望是，\n推我一把，让我\n别放弃调查咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "508/SEL",
            "narrator": "",
            "text": "そんなに重要な調査なの？",
            "zh": "有那么重要的调查吗？",
            "narrator_zh": ""
        },
        {
            "location": "509/ACT",
            "narrator": "",
            "text": "そんなに重要な調査なの？",
            "zh": "有那么重要的调查吗？",
            "narrator_zh": ""
        },
        {
            "location": "511/TALK",
            "narrator": "みやび",
            "text": "うむ。",
            "zh": "嗯。",
            "narrator_zh": "雅"
        },
        {
            "location": "512/TALK",
            "narrator": "みやび",
            "text": "だいぶ主題が逸れちゅう\nけんど、本来の目的は\nファンサイトではない。",
            "zh": "虽然主题已经\n偏得够远，但原本的\n目的不是粉丝网站。",
            "narrator_zh": "雅"
        },
        {
            "location": "513/TALK",
            "narrator": "みやび",
            "text": "まほさんのフィルムの\n出所調査こそが、やり遂げ\nねばならん任務やき。",
            "zh": "查明真幌那卷胶片的\n出处，才是我必须\n完成的任务啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "514/SEL",
            "narrator": "",
            "text": "あーそういえばそうだったね",
            "zh": "啊——这么一说是来着",
            "narrator_zh": ""
        },
        {
            "location": "515/ACT",
            "narrator": "",
            "text": "あーそういえばそうだったね",
            "zh": "啊——这么一说是来着",
            "narrator_zh": ""
        },
        {
            "location": "518/TALK",
            "narrator": "みやび",
            "text": "忘れちょったか。\n情けない相棒ぞね…。",
            "zh": "忘干净了吧。\n真是不争气的搭档咧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "519/TALK",
            "narrator": "みやび",
            "text": "ともあれ、ここで諦めると\n今後のうちにとって\n大変よくない事になる。",
            "zh": "总之，在这里放弃的话，\n对我今后\n可是大大的不利。",
            "narrator_zh": "雅"
        },
        {
            "location": "520/TALK",
            "narrator": "みやび",
            "text": "敗北こそ\n最強の枯葉剤やき。",
            "zh": "失败才是\n最强的枯叶剂啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "521/TALK",
            "narrator": "みやび",
            "text": "うちを枯らさぬよう\n最善を尽くせ、相棒。",
            "zh": "为了不让我枯掉，\n尽全力吧，搭档。",
            "narrator_zh": "雅"
        },
        {
            "location": "522/TALK",
            "narrator": "みやび",
            "text": "うちと$handle$に\nえいココロの旅を。",
            "zh": "献给我和$handle$的\n美妙的心灵之旅。",
            "narrator_zh": "雅"
        },
        {
