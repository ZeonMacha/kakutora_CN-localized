   "narrator_zh": "雅"
  },
  {
   "location": "259/ACT",
   "narrator": "",
   "text": "なくなるかもー",
   "zh": "可能会没哦——",
   "narrator_zh": ""
  },
  {
   "location": "260/TALK",
   "narrator": "みやび",
   "text": "脅かすな"
