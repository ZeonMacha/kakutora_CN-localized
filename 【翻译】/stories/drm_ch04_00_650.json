   "narrator_zh": "雅"
  },
  {
   "location": "263/TALK",
   "narrator": "みやび",
   "text": "懸念しておる"
  },
  {
   "location": "265/TALK",
   "narrator": "みやび",
   "text": "思い出はみな美しいという"
