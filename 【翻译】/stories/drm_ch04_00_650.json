        },
        {
            "location": "273/TALK",
            "narrator": "みやび",
            "text": "いい",
            "zh": "就好",
            "narrator_zh": "雅"
        },
        {
            "location": "274/ACT",
            "narrator": "",
            "text": "みやびと$me$の思い出は永遠",
            "zh": "和雅与$me$的回忆是永远的",
            "narrator_zh": ""
        },
        {
            "location": "275/TALK",
