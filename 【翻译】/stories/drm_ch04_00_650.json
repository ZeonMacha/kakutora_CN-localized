        },
        {
            "location": "182/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんは以外と詩人やき",
            "zh": "加布意外地是个诗人啵",
            "narrator_zh": "雅"
        },
        {
            "location": "183/TALK",
            "narrator": "みやび",
            "text": "どうもうちも影響を受けてしまう",
            "zh": "总觉得连我也受了影响嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "185/SEL",
            "narrator": "",
            "text": "なにかあったの？",
            "zh": "出什么事了？",
            "narrator_zh": ""
        },
        {
            "location": "186/SEL",
            "narrator": "",
            "text": "みやびの前だと$handle$も詩人になるよ",
            "zh": "在雅面前，$handle$也会变成诗人",
            "narrator_zh": ""
        },
        {
            "location": "187/ACT",
            "narrator": "",
            "text": "なにかあったの？",
            "zh": "出什么事了？",
            "narrator_zh": ""
        },
        {
            "location": "188/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんの",
            "zh": "是加布的",
            "narrator_zh": "雅"
        },
        {
            "location": "189/TALK",
            "narrator": "みやび",
            "text": "乙女心に",
            "zh": "少女心",
            "narrator_zh": "雅"
        },
        {
            "location": "190/TALK",
            "narrator": "みやび",
            "text": "あてられた",
            "zh": "给戳中了",
            "narrator_zh": "雅"
        },
        {
            "location": "192/SEL",
            "narrator": "",
            "text": "心の俳句？",
            "zh": "内心的俳句？",
            "narrator_zh": ""
        },
        {
            "location": "193/SEL",
            "narrator": "",
            "text": "川柳かな",
            "zh": "是川柳吧",
            "narrator_zh": ""
        },
        {
            "location": "194/SEL",
            "narrator": "",
            "text": "詩とはちょっと違うような",
            "zh": "感觉和诗有点不一样",
            "narrator_zh": ""
        },
        {
            "location": "195/ACT",
            "narrator": "",
            "text": "心の俳句？",
            "zh": "内心的俳句？",
            "narrator_zh": ""
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "図らずも五七五",
            "zh": "无意间凑成了五七五",
            "narrator_zh": "雅"
        },
        {
            "location": "197/ACT",
            "narrator": "",
            "text": "川柳かな",
            "zh": "是川柳吧",
            "narrator_zh": ""
        },
        {
            "location": "198/TALK",
            "narrator": "みやび",
            "text": "うちはサラリーマンでも",
            "zh": "我又不是上班族",
            "narrator_zh": "雅"
        },
        {
            "location": "199/TALK",
            "narrator": "みやび",
            "text": "ＯＬでもないぞね",
            "zh": "也不是什么OL咧",
            "narrator_zh": "雅"
        },
        {
            "location": "200/ACT",
            "narrator": "",
            "text": "詩とはちょっと違うような",
            "zh": "感觉和诗有点不一样",
            "narrator_zh": ""
        },
        {
            "location": "201/TALK",
            "narrator": "みやび",
            "text": "確かに",
            "zh": "确实",
            "narrator_zh": "雅"
        },
        {
            "location": "202/TALK",
            "narrator": "みやび",
            "text": "そうかも",
            "zh": "说不定吧",
            "narrator_zh": "雅"
        },
        {
            "location": "204/ACT",
            "narrator": "",
            "text": "みやびの前だと$handle$も詩人になるよ",
            "zh": "在雅面前，$handle$也会变成诗人",
            "narrator_zh": ""
        },
        {
            "location": "214/TALK",
            "narrator": "みやび",
            "text": "またそういうことを",
            "zh": "又来这套了",
            "narrator_zh": "雅"
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "そこまで言うなら",
            "zh": "既然都说到这份上了",
            "narrator_zh": "雅"
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "愛の詩をささやけ",
            "zh": "就低声吟首爱情诗吧",
            "narrator_zh": "雅"
        },
        {
            "location": "217/TALK",
            "narrator": "みやび",
            "text": "ばかちんが",
            "zh": "这笨蛋",
            "narrator_zh": "雅"
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんは",
            "zh": "加布她",
            "narrator_zh": "雅"
        },
        {
            "location": "220/TALK",
            "narrator": "みやび",
            "text": "夕暮れの街を歩くのが",
            "zh": "在黄昏的街上散步这件事",
            "narrator_zh": "雅"
        },
        {
            "location": "221/TALK",
            "narrator": "みやび",
            "text": "とても好きなのだと言っておった",
            "zh": "她说非常喜欢",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "神楽坂の緩い坂道を",
            "zh": "在神乐坂那缓缓的坡道上",
            "narrator_zh": "雅"
        },
        {
            "location": "224/TALK",
            "narrator": "みやび",
            "text": "すれ違う人の話をなんとなく聞きながら歩くのが",
            "zh": "一边走着一边随意听着擦肩路人的闲聊",
            "narrator_zh": "雅"
        },
        {
            "location": "226/SEL",
            "narrator": "",
            "text": "わかる気がする",
            "zh": "我觉得我懂",
            "narrator_zh": ""
        },
        {
            "location": "227/SEL",
            "narrator": "",
            "text": "そういうもんかなー",
            "zh": "大概是吧——",
            "narrator_zh": ""
        },
        {
            "location": "228/SEL",
            "narrator": "",
            "text": "確かに詩人っぽい",
            "zh": "确实有点像诗人",
            "narrator_zh": ""
        },
        {
            "location": "229/ACT",
            "narrator": "",
            "text": "わかる気がする",
            "zh": "我觉得我懂",
            "narrator_zh": ""
        },
        {
            "location": "230/TALK",
            "narrator": "みやび",
            "text": "うむ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "231/TALK",
            "narrator": "みやび",
            "text": "そうであろう",
            "zh": "应该是咯",
            "narrator_zh": "雅"
        },
        {
            "location": "232/ACT",
            "narrator": "",
            "text": "そういうもんかなー",
            "zh": "大概是吧——",
            "narrator_zh": ""
        },
        {
            "location": "233/TALK",
            "narrator": "みやび",
            "text": "ドライだの",
            "zh": "真是够冷淡的咯",
            "narrator_zh": "雅"
        },
        {
            "location": "236/ACT",
            "narrator": "",
            "text": "確かに詩人っぽい",
            "zh": "确实有点像诗人",
            "narrator_zh": ""
        },
        {
            "location": "237/TALK",
            "narrator": "みやび",
            "text": "そうなのだ",
            "zh": "就是这样",
            "narrator_zh": "雅"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "なんてこともない日常なんじゃがの",
            "zh": "虽然是没什么特别的日常",
            "narrator_zh": "雅"
        },
        {
            "location": "240/TALK",
            "narrator": "みやび",
            "text": "そういう隙間的なささやかなものに気づく幸せ",
            "zh": "察觉到那种缝隙里细微之物的幸福",
            "narrator_zh": "雅"
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "いいものだ、と思いつつ",
            "zh": "觉得是好事的同时",
            "narrator_zh": "雅"
        },
        {
            "location": "242/TALK",
            "narrator": "みやび",
            "text": "少し気になるところもある",
            "zh": "也有点在意的地方",
            "narrator_zh": "雅"
        },
        {
            "location": "244/SEL",
            "narrator": "",
            "text": "何が？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "245/SEL",
            "narrator": "",
            "text": "嫉妬じゃない？",
            "zh": "是嫉妒吧？",
            "narrator_zh": ""
        },
        {
            "location": "246/ACT",
            "narrator": "",
            "text": "何が？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "247/TALK",
            "narrator": "みやび",
            "text": "うちが悲観的すぎるのかもしれんが",
            "zh": "虽然也许是我悲观过头了",
            "narrator_zh": "雅"
        },
        {
            "location": "248/ACT",
            "narrator": "",
            "text": "嫉妬じゃない？",
            "zh": "是嫉妒吧？",
            "narrator_zh": ""
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "そういう意見もあるろう",
            "zh": "也会有那种意见啵",
            "narrator_zh": "雅"
        },
        {
            "location": "251/TALK",
            "narrator": "みやび",
            "text": "その幸せは",
            "zh": "那份幸福",
            "narrator_zh": "雅"
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "いつまでもあるものだろうか？",
            "zh": "就真能一直都在嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "254/SEL",
            "narrator": "",
            "text": "あるでしょ",
            "zh": "有吧",
            "narrator_zh": ""
        },
        {
            "location": "255/SEL",
            "narrator": "",
            "text": "なくなるかもー",
            "zh": "可能会没哦——",
            "narrator_zh": ""
        },
        {
            "location": "256/SEL",
            "narrator": "",
            "text": "幸せって感じられなくなることはあるかも",
            "zh": "也许会有感觉不到幸福的时候",
            "narrator_zh": ""
        },
        {
            "location": "257/ACT",
            "narrator": "",
            "text": "あるでしょ",
            "zh": "有吧",
            "narrator_zh": ""
        },
        {
            "location": "258/TALK",
            "narrator": "みやび",
            "text": "なんとシンプルな答えであることか",
            "zh": "多么简单的回答",
            "narrator_zh": "雅"
        },
        {
            "location": "259/ACT",
            "narrator": "",
            "text": "なくなるかもー",
            "zh": "可能会没哦——",
            "narrator_zh": ""
        },
        {
            "location": "260/TALK",
            "narrator": "みやび",
            "text": "脅かすな",
            "zh": "别吓人啊",
            "narrator_zh": "雅"
        },
        {
            "location": "261/ACT",
            "narrator": "",
            "text": "幸せって感じられなくなることはあるかも",
            "zh": "也许会有感觉不到幸福的时候",
            "narrator_zh": ""
        },
        {
            "location": "262/TALK",
            "narrator": "みやび",
            "text": "それを一番",
            "zh": "那个最",
            "narrator_zh": "雅"
        },
        {
            "location": "263/TALK",
            "narrator": "みやび",
            "text": "懸念しておる",
            "zh": "正担心着呢",
            "narrator_zh": "雅"
        },
        {
            "location": "265/TALK",
            "narrator": "みやび",
            "text": "思い出はみな美しいという",
            "zh": "所谓回忆都是美好的这种说法",
            "narrator_zh": "雅"
        },
        {
            "location": "266/TALK",
            "narrator": "みやび",
            "text": "が",
            "zh": "不过",
            "narrator_zh": "雅"
        },
        {
            "location": "267/TALK",
            "narrator": "みやび",
            "text": "そればかりでは現実に対処できないのでは",
            "zh": "光靠那个应付不了现实吧",
            "narrator_zh": "雅"
        },
        {
            "location": "269/SEL",
            "narrator": "",
            "text": "考えすぎだよ",
            "zh": "你想太多了",
            "narrator_zh": ""
        },
        {
            "location": "270/SEL",
            "narrator": "",
            "text": "みやびと$me$の思い出は永遠",
            "zh": "和雅与$me$的回忆是永远的",
            "narrator_zh": ""
        },
        {
            "location": "271/ACT",
            "narrator": "",
            "text": "考えすぎだよ",
            "zh": "你想太多了",
            "narrator_zh": ""
        },
        {
            "location": "272/TALK",
            "narrator": "みやび",
            "text": "なら",
