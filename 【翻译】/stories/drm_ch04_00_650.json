   "text": "思ひでころころ"
  },
  {
   "location": "182/TALK",
   "narrator": "みやび",
   "text": "ガブちゃんは以外と詩人やき"
  },
  {
   "location": "183/TALK",
   "narrator": "みやび",
   "text": "どうもうちも影響を受けてしまう",
   "zh": "连我家也受到影响了嘛",
   "narrator_zh": "雅"
  },
  {
   "location": "185/SEL",
   "narrator": "",
   "text": "なにかあったの？",
   "zh": "出什么事了？",
   "narrator_zh": ""
  },
  {
   "location": "186/SEL",
   "narrator": "",
   "text": "みやびの前だと$handle$も詩人になるよ",
   "zh": "在雅面前，$handle$也会变成诗人",
   "narrator_zh": ""
  },
  {
   "location": "187/ACT",
   "narrator": "",
   "text": "なにかあったの？",
   "zh": "出什么事了？",
   "narrator_zh": ""
  },
  {
   "location": "188/TALK",
   "narrator": "みやび",
   "text": "ガブちゃんの"
  },
  {
   "location": "189/TALK",
   "narrator": "みやび",
   "text": "乙女心に"
  },
  {
   "location": "190/TALK",
   "narrator": "みやび",
   "text": "あてられた"
  },
  {
   "location": "192/SEL",
   "narrator": "",
   "text": "心の俳句？",
   "zh": "内心的俳句？",
   "narrator_zh": ""
  },
  {
   "location": "193/SEL",
   "narrator": "",
   "text": "川柳かな",
   "zh": "是川柳吧",
   "narrator_zh": ""
  },
  {
   "location": "194/SEL",
   "narrator": "",
   "text": "詩とはちょっと違うような",
   "zh": "感觉和诗有点不一样",
   "narrator_zh": ""
  },
  {
   "location": "195/ACT",
   "narrator": "",
   "text": "心の俳句？",
   "zh": "内心的俳句？",
   "narrator_zh": ""
  },
  {
   "location": "196/TALK",
   "narrator": "みやび",
   "text": "図らずも五七五"
  },
  {
   "location": "197/ACT",
   "narrator": "",
   "text": "川柳かな",
   "zh": "是川柳吧",
   "narrator_zh": ""
  },
  {
   "location": "198/TALK",
   "narrator": "みやび",
   "text": "うちはサラリーマンでも"
  },
  {
   "location": "199/TALK",
   "narrator": "みやび",
   "text": "ＯＬでもないぞね"
  },
  {
   "location": "200/ACT",
   "narrator": "",
   "text": "詩とはちょっと違うような",
   "zh": "感觉和诗有点不一样",
   "narrator_zh": ""
  },
  {
   "location": "201/TALK",
   "narrator": "みやび",
   "text": "確かに",
   "zh": "确实",
   "narrator_zh": "雅"
  },
  {
   "location": "202/TALK",
   "narrator": "みやび",
   "text": "そうかも",
   "zh": "说不定吧",
   "narrator_zh": "雅"
  },
  {
   "location": "204/ACT",
   "narrator": "",
   "text": "みやびの前だと$handle$も詩人になるよ",
   "zh": "在雅面前，$handle$也会变成诗人",
   "narrator_zh": ""
  },
  {
   "location": "214/TALK",
   "narrator": "みやび",
   "text": "またそういうことを"
  },
  {
   "location": "215/TALK",
   "narrator": "みやび",
   "text": "そこまで言うなら"
  },
  {
   "location": "216/TALK",
   "narrator": "みやび",
   "text": "愛の詩をささやけ"
  },
  {
   "location": "217/TALK",
   "narrator": "みやび",
   "text": "ばかちんが",
   "zh": "这笨蛋",
   "narrator_zh": "雅"
  },
  {
   "location": "219/TALK",
   "narrator": "みやび",
   "text": "ガブちゃんは",
   "zh": "加布她",
   "narrator_zh": "雅"
  },
  {
   "location": "220/TALK",
   "narrator": "みやび",
   "text": "夕暮れの街を歩くのが"
  },
  {
   "location": "221/TALK",
   "narrator": "みやび",
   "text": "とても好きなのだと言っておった",
   "zh": "他说非常喜欢",
   "narrator_zh": "雅"
  },
  {
   "location": "223/TALK",
   "narrator": "みやび",
   "text": "神楽坂の緩い坂道を"
  },
  {
   "location": "224/TALK",
   "narrator": "みやび",
   "text": "すれ違う人の話をなんとなく聞きながら歩くのが"
  },
  {
   "location": "226/SEL",
   "narrator": "",
   "text": "わかる気がする",
   "zh": "我觉得我懂",
   "narrator_zh": ""
  },
  {
   "location": "227/SEL",
   "narrator": "",
   "text": "そういうもんかなー",
   "zh": "大概是吧——",
   "narrator_zh": ""
  },
  {
   "location": "228/SEL",
   "narrator": "",
   "text": "確かに詩人っぽい",
   "zh": "确实有点像诗人",
   "narrator_zh": ""
  },
  {
   "location": "229/ACT",
   "narrator": "",
   "text": "わかる気がする",
   "zh": "我觉得我懂",
   "narrator_zh": ""
  },
  {
   "location": "230/TALK",
   "narrator": "みやび",
   "text": "うむ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "231/TALK",
   "narrator": "みやび",
   "text": "そうであろう",
   "zh": "应该是咯",
   "narrator_zh": "雅"
  },
  {
   "location": "232/ACT",
   "narrator": "",
   "text": "そういうもんかなー",
   "zh": "大概是吧——",
   "narrator_zh": ""
  },
  {
   "location": "233/TALK",
   "narrator": "みやび",
   "text": "ドライだの",
   "zh": "真是干脆咯",
   "narrator_zh": "雅"
  },
  {
   "location": "236/ACT",
   "narrator": "",
   "text": "確かに詩人っぽい",
   "zh": "确实有点像诗人",
   "narrator_zh": ""
  },
  {
   "location": "237/TALK",
   "narrator": "みやび",
   "text": "そうなのだ",
   "zh": "就是这样",
   "narrator_zh": "雅"
  },
  {
   "location": "238/TALK",
   "narrator": "みやび",
   "text": "なんてこともない日常なんじゃがの",
   "zh": "虽然是没什么特别的日常",
   "narrator_zh": "雅"
  },
  {
   "location": "240/TALK",
   "narrator": "みやび",
   "text": "そういう隙間的なささやかなものに気づく幸せ",
   "zh": "察觉到那种缝隙里细微之物的幸福",
   "narrator_zh": "雅"
  },
  {
   "location": "241/TALK",
   "narrator": "みやび",
   "text": "いいものだ、と思いつつ"
  },
  {
   "location": "242/TALK",
   "narrator": "みやび",
   "text": "少し気になるところもある"
  },
  {
   "location": "244/SEL",
   "narrator": "",
   "text": "何が？",
   "zh": "什么？",
   "narrator_zh": ""
  },
  {
   "location": "245/SEL",
   "narrator": "",
   "text": "嫉妬じゃない？",
   "zh": "是嫉妒吧？",
   "narrator_zh": ""
  },
  {
   "location": "246/ACT",
   "narrator": "",
   "text": "何が？",
   "zh": "什么？",
   "narrator_zh": ""
  },
  {
   "location": "247/TALK",
   "narrator": "みやび",
   "text": "うちが悲観的すぎるのかもしれんが"
  },
  {
   "location": "248/ACT",
   "narrator": "",
   "text": "嫉妬じゃない？",
   "zh": "是嫉妒吧？",
   "narrator_zh": ""
  },
  {
   "location": "249/TALK",
   "narrator": "みやび",
   "text": "そういう意見もあるろう",
   "zh": "也会有那种意见啵",
   "narrator_zh": "雅"
  },
  {
   "location": "251/TALK",
   "narrator": "みやび",
   "text": "その幸せは",
   "zh": "那份幸福",
   "narrator_zh": "雅"
  },
  {
   "location": "252/TALK",
   "narrator": "みやび",
   "text": "いつまでもあるものだろうか？"
  },
  {
   "location": "254/SEL",
   "narrator": "",
   "text": "あるでしょ",
   "zh": "有吧",
   "narrator_zh": ""
  },
  {
   "location": "255/SEL",
   "narrator": "",
   "text": "なくなるかもー",
   "zh": "可能会没哦——",
   "narrator_zh": ""
  },
  {
   "location": "256/SEL",
   "narrator": "",
   "text": "幸せって感じられなくなることはあるかも",
   "zh": "也许会有感觉不到幸福的时候",
   "narrator_zh": ""
  },
  {
   "location": "257/ACT",
   "narrator": "",
   "text": "あるでしょ",
   "zh": "有吧",
   "narrator_zh": ""
  },
  {
   "location": "258/TALK",
   "narrator": "みやび",
   "text": "なんとシンプルな答えであることか",
