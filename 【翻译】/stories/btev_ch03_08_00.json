        "title": "013 ココロスフィアストーリー【Lv05】",
        "sub_title": "母とは何たるか＜提起＞",
        "title_zh": "013 心灵领域故事【Lv05】",
        "sub_title_zh": "母亲究竟是什么＜提起＞"
    },
    "entry": [
        {
            "location": "14/DIALOG",
            "narrator": "",
            "text": "<size=40>KOKORO-Lv. 05</size>\nGABRIELLA\n\n<size=45>母とは何たるか</size>\n<size=35>～微かな記憶と粛清の嵐～</size>",
            "zh": "<size=40>KOKORO-Lv. 05</size>\n加布里埃拉\n\n<size=45>母亲究竟是什么</size>\n<size=35>～微弱的记忆与肃清风暴～</size>",
            "narrator_zh": ""
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "ここは…？",
            "zh": "这里是……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/SEL",
            "narrator": "（選択肢）",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "35/ACT",
            "narrator": "",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": ""
        },
        {
            "location": "37/TALK",
            "narrator": "？？？",
            "text": "ガブリエラ。",
            "zh": "加布里埃拉。",
            "narrator_zh": "？？？"
        },
        {
            "location": "39/TALK",
            "narrator": "ガブリエラ",
            "text": "！！",
            "zh": "！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "ああっ！",
            "zh": "啊啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/SEL",
            "narrator": "（選択肢）",
            "text": "まずい！ガブリエラ逃げろ！",
            "zh": "不妙！加布里埃拉快逃！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "43/ACT",
            "narrator": "",
            "text": "まずい！ガブリエラ逃げろ！",
            "zh": "不妙！加布里埃拉快逃！",
            "narrator_zh": ""
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "え？\nどうして？",
            "zh": "诶？\n为什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "ガブリエラ",
            "text": "心配しなくても\n大丈夫よ？",
            "zh": "不用担心，\n没关系的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "紹介するわ。\nあたしのお母様なの。",
            "zh": "我来介绍一下。\n这是我的妈妈。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/SEL",
            "narrator": "（選択肢）",
            "text": "…え？",
            "zh": "……诶？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "54/ACT",
            "narrator": "",
            "text": "…え？",
            "zh": "……诶？",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "お母様、\nあたし今日も\n良い子にしていたわ。",
            "zh": "妈妈，\n我今天也\n乖乖当了好孩子哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "？？？",
            "text": "そう。ギャヴィは\nおりこうさんで\nえらいわね。",
            "zh": "是啊。加维\n真听话，\n真了不起呢。",
            "narrator_zh": "？？？"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/SEL",
            "narrator": "（選択肢）",
            "text": "ちょっ！！",
            "zh": "等下！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "67/ACT",
            "narrator": "",
            "text": "ちょっ！！",
            "zh": "等下！！",
            "narrator_zh": ""
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "間違えたわ。\nお母様じゃなかった。",
            "zh": "弄错了。\n不是妈妈。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/SEL",
            "narrator": "（選択肢）",
            "text": "ええっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "81/ACT",
            "narrator": "",
            "text": "ええっ！？",
            "zh": "诶诶！？",
            "narrator_zh": ""
        },
        {
            "location": "84/TALK",
            "narrator": "？？？",
            "text": "ガブリエラ。",
            "zh": "加布里埃拉。",
            "narrator_zh": "？？？"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "お母様！",
            "zh": "妈妈！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "早く来てくれないから\n不審者をお母様と\n間違えちゃったわ？",
            "zh": "谁叫你一直不快点来，\n我都把可疑分子\n错认成妈妈了呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "？？？",
            "text": "ごめんなさいね。\n早くおうちに帰って\nバルシチ食べましょ？",
            "zh": "抱歉嘛。\n快点回家\n喝红菜汤吧？",
            "narrator_zh": "？？？"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "また\n間違えちゃった。",
            "zh": "又\n弄错了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "？？？",
            "text": "何やってるの！\n今日の宿題は\nもう終わったの！？",
            "zh": "你在干什么！\n今天的作业\n已经做完了吗！？",
            "narrator_zh": "？？？"
        },
        {
            "location": "120/TALK",
            "narrator": "？？？",
            "text": "ガブリエラ。\n今日のクレー射撃は――",
            "zh": "加布里埃拉。\n今天的飞碟射击——",
            "narrator_zh": "？？？"
        },
        {
            "location": "135/TALK",
            "narrator": "つばめ",
            "text": "せんぱい！\n今日のバイトは――",
            "zh": "前辈！\n今天的打工——",
            "narrator_zh": "燕"
        },
        {
            "location": "149/SEL",
            "narrator": "（選択肢）",
            "text": "ちょっ！！ためらいなし！？",
            "zh": "等下！！连犹豫都不犹豫吗！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "150/ACT",
            "narrator": "",
            "text": "ちょっ！！ためらいなし！？",
            "zh": "等下！！连犹豫都不犹豫吗！？",
            "narrator_zh": ""
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしには\nお母様以外は\n必要無いの。",
            "zh": "对我来说，\n除了妈妈以外\n全都不需要。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "159/TALK",
            "narrator": "？？？",
            "text": "ギャヴィちゃん！",
            "zh": "小加维！",
            "narrator_zh": "？？？"
        },
        {
            "location": "173/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ！",
            "zh": "加维！",
            "narrator_zh": "绫水"
        },
        {
            "location": "177/SEL",
            "narrator": "（選択肢）",
            "text": "撃つな！",
            "zh": "别开枪！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "178/ACT",
            "narrator": "",
            "text": "撃つな！",
            "zh": "别开枪！",
            "narrator_zh": ""
        },
        {
            "location": "180/TALK",
            "narrator": "アーヤ",
            "text": "あなた、\nなにやってるのよ！",
            "zh": "你\n在干什么啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "182/TALK",
            "narrator": "ガブリエラ",
            "text": "あ……",
            "zh": "啊……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "186/SEL",
            "narrator": "（選択肢）",
            "text": "…っ！",
            "zh": "……唔！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "187/SEL",
            "narrator": "（選択肢）",
            "text": "やめろ！！",
            "zh": "住手！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "188/ACT",
            "narrator": "",
            "text": "…っ！",
            "zh": "……唔！",
            "narrator_zh": ""
        },
        {
            "location": "200/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "201/TALK",
            "narrator": "ガブリエラ",
            "text": "……やっぱり。",
            "zh": "……果然。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしには、\nお母様なんて\nいなかったんだわ。",
            "zh": "我根本就\n没有什么\n妈妈啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/TALK",
            "narrator": "千羽鶴",
            "text": "終わってしまった。",
            "zh": "结束了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "217/SEL",
            "narrator": "（選択肢）",
            "text": "何が？",
            "zh": "什么？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "218/ACT",
            "narrator": "",
            "text": "何が？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "220/TALK",
            "narrator": "千羽鶴",
            "text": "ガブリエラの世界が。",
            "zh": "加布里埃拉的世界。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "221/TALK",
            "narrator": "千羽鶴",
            "text": "彼女の心が\n安定してしまった。",
            "zh": "她的心\n安定下来了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "222/TALK",
            "narrator": "千羽鶴",
            "text": "よって、この世界は\n閉じられた。",
            "zh": "因此，这个世界\n关闭了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "223/TALK",
            "narrator": "千羽鶴",
            "text": "もちろん、安定とは\n言っても、必ずしも\n良いこととは限らない。",
            "zh": "当然，虽说是\n安定，但也未必\n就是好事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "224/TALK",
            "narrator": "千羽鶴",
            "text": "停滞の方向に安定して\nしまうと、問題の\n解決や成長は望めない。",
            "zh": "一旦朝着停滞的方向\n安定下来，就无法指望\n解决问题或获得成长了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "225/TALK",
            "narrator": "千羽鶴",
            "text": "そして今は\nまさにその状況にある。",
            "zh": "而现在正是\n处于这种状况。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "226/TALK",
            "narrator": "千羽鶴",
            "text": "ガブリエラが今\n抱えている心の問題。",
            "zh": "加布里埃拉如今\n怀有的心结。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "227/TALK",
            "narrator": "千羽鶴",
            "text": "それを解決したければ\n別の方法をとること。",
            "zh": "若想解决它，\n就采取别的方法。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "228/TALK",
            "narrator": "千羽鶴",
            "text": "それが唯一の手段。",
            "zh": "这是唯一的手段。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "229/TALK",
            "narrator": "千羽鶴",
            "text": "幸い貴方は、何度も\n同じ時間にチャレンジ\nすることができる。",
            "zh": "幸好你能够\n一次次向同一时间\n发起挑战。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "230/TALK",
            "narrator": "千羽鶴",
            "text": "まだその気があれば、\nやってみるのがいい。",
            "zh": "如果还有那个心意，\n再试一次就好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "232/ACT",
            "narrator": "",
            "text": "やめろ！！",
            "zh": "住手！！",
            "narrator_zh": ""
        },
        {
            "location": "235/TALK",
            "narrator": "ガブリエラ",
            "text": "…っ。",
            "zh": "……唔。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "どうして？\n明らかに\nお母様じゃないのに。",
            "zh": "为什么？\n明明一眼就看出\n不是妈妈了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしには\nお母様が\n必要なの！",
            "zh": "我是\n需要妈妈\n的啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/TALK",
            "narrator": "ガブリエラ",
            "text": "お母様以外は\n全て不要なの。",
            "zh": "除了妈妈以外\n一切都不需要。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "244/SEL",
            "narrator": "（選択肢）",
            "text": "今一瞬、手を止めなかった？",
            "zh": "刚才一瞬间，你是不是停手了？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "245/ACT",
            "narrator": "",
            "text": "今一瞬、手を止めなかった？",
            "zh": "刚才一瞬间，你是不是停手了？",
            "narrator_zh": ""
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/TALK",
            "narrator": "ガブリエラ",
            "text": "……そ、そうね。",
            "zh": "……是、是啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "250/SEL",
            "narrator": "（選択肢）",
            "text": "どうして？",
            "zh": "为什么？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "251/ACT",
            "narrator": "",
            "text": "どうして？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/TALK",
            "narrator": "ガブリエラ",
            "text": "一瞬、\n本物のお母様だと\n勘違いしたからよ。",
            "zh": "因为一瞬间，\n误以为是\n真正的妈妈了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/TALK",
            "narrator": "ガブリエラ",
            "text": "でも見れば一目瞭然、\nどう見ても\nアーヤじゃないの！",
            "zh": "可仔细一看一目了然，\n怎么看这不就是\n绫水嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "だから撃つ！",
            "zh": "所以我要开枪！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "257/SEL",
            "narrator": "（選択肢）",
            "text": "待て待て！！",
            "zh": "等等等等！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "258/ACT",
            "narrator": "",
            "text": "待て待て！！",
            "zh": "等等等等！！",
            "narrator_zh": ""
        },
        {
            "location": "261/TALK",
            "narrator": "ガブリエラ",
            "text": "どうして！",
            "zh": "为什么！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "262/SEL",
            "narrator": "（選択肢）",
            "text": "なんで撃つ必要があるの？",
            "zh": "为什么要开枪啊？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "263/ACT",
            "narrator": "",
            "text": "なんで撃つ必要があるの？",
            "zh": "为什么要开枪啊？",
            "narrator_zh": ""
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのお母様を\n偽って心を混乱させる\n元凶だからよ！",
            "zh": "因为她是冒充我妈妈、\n扰乱我内心的\n罪魁祸首啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "ガブリエラ",
            "text": "……あたし、\nお母様のこと\nよく覚えてないのよ。",
            "zh": "……我呀，\n关于妈妈的事\n其实不太记得了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "267/TALK",
            "narrator": "ガブリエラ",
            "text": "お父様に聞いても\n全然答えて\nくれなかったし。",
            "zh": "就算去问爸爸，\n他也完全不肯\n回答我。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、あたしの心には\nお母様が絶対に\n必要なの。",
