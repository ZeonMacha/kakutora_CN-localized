{
    "dir": "chap22/daydra/dd_ch03_22_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "22356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ちょっと心配",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "有点担心"
    },
    "entry": [
        {
            "location": "291/SCENARIO",
            "narrator": "",
            "text": "ちょっと心配",
            "zh": "有点担心",
            "narrator_zh": ""
        },
        {
            "location": "307/TALK",
            "narrator": "ガブリエラ",
            "text": "…お菓子が食べたいわ。",
            "zh": "……好想吃点心啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "309/TALK",
            "narrator": "神楽",
            "text": "ガブちゃん、\nついさっきお夕飯を\n食べたばかりですよ？",
            "zh": "加布，\n你才刚吃过晚饭\n没多久吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "311/TALK",
            "narrator": "ガブリエラ",
            "text": "夕飯は夕飯。\nお菓子はお菓子よ。",
            "zh": "晚饭是晚饭。\n点心是点心嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "314/TALK",
            "narrator": "みやび",
            "text": "すまんけんど、\n我が家の菓子類は\n今のところ品切れや。",
            "zh": "对不住，不过\n我家的零食类\n这阵正好断货咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "315/TALK",
            "narrator": "みやび",
            "text": "うちの親が、\n明日買い出しに行く\n言うてたきね。",
            "zh": "我爸妈说了，\n明天会去\n采购补货啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "316/TALK",
            "narrator": "つばめ",
            "text": "コンビニで買ってきた\nお菓子も、今日のおやつに\n食べきっちゃったし…。",
            "zh": "从便利店买来的\n零食，今天下午茶也\n已经全吃光了……",
            "narrator_zh": "燕"
        },
        {
            "location": "320/TALK",
            "narrator": "ガブリエラ",
            "text": "えーっ、何もないの？",
            "zh": "欸——，什么都没了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "322/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィもコンビニで\nお菓子買ってなかった？",
            "zh": "加维在便利店不是\n也买了零食吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "325/TALK",
            "narrator": "ガブリエラ",
            "text": "もうとっくに\n食べ終わっちゃったわよ。",
            "zh": "早就\n已经吃光了啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "327/TALK",
            "narrator": "神楽",
            "text": "あまり食べ過ぎると\n太りますよ？",
            "zh": "吃太多的话\n会发胖的哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "329/TALK",
            "narrator": "ガブリエラ",
            "text": "その分動いてるから\n平気よ。",
            "zh": "我运动量也摆在那儿，\n完全没问题啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "332/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…まったく…。",
            "zh": "哈啊……真是的……",
            "narrator_zh": "绫水"
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "まあ、丁度暇してた\nところだし、コンビニまで\n買いに行ってくるわ。",
            "zh": "嘛，反正我刚好也闲着，\n我去趟便利店\n买回来吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "336/TALK",
            "narrator": "ガブリエラ",
            "text": "いいの？",
            "zh": "可以吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "337/TALK",
            "narrator": "アーヤ",
            "text": "ええ…みんなも、\n必要な物があったら\nＷＡＶＥに送っといて。",
            "zh": "嗯……大家还有什么\n需要的东西，\n发到 WAVE 上吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "339/TALK",
            "narrator": "みやび",
            "text": "夜道は暗いき、\n気ぃつけや。",
            "zh": "夜路黑得很啵，\n小心点咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "342/TALK",
            "narrator": "アーヤ",
            "text": "うん、行ってきます。",
            "zh": "嗯，我出门了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "363/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "365/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ、いくらなんでも\nアーヤ、遅過ぎない？",
            "zh": "我说，不管怎么想\n绫水也太慢了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "369/TALK",
            "narrator": "つばめ",
            "text": "え？　そうかな？",
            "zh": "欸？是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "370/TALK",
            "narrator": "ガブリエラ",
            "text": "だって、出ていってから\n一時間以上経ってるわ。",
            "zh": "因为从她出门到现在\n已经过去一个多小时了啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "371/TALK",
            "narrator": "ガブリエラ",
            "text": "ここからコンビニって、\nそこまで遠くないでしょ？",
            "zh": "从这里到便利店，\n也没那么远对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "373/TALK",
            "narrator": "神楽",
            "text": "立ち読みでもしてるんじゃ\nないですか？",
            "zh": "说不定是在站着看杂志\n之类的吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "374/TALK",
            "narrator": "神楽",
            "text": "行くとき、暇してる、って\n言ってたじゃないですか。",
            "zh": "出门的时候她不是还说\n自己正闲着嘛。",
            "narrator_zh": "神乐"
        },
        {
            "location": "377/TALK",
            "narrator": "ガブリエラ",
            "text": "そうだけど…。",
            "zh": "话是这么说……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "380/TALK",
            "narrator": "みやび",
            "text": "この時間は海からの風が\n心地えいき、のんびり散歩\nしちゅうかもしれんよ。",
            "zh": "这阵海风吹过来\n舒服得很啵，说不定正\n慢悠悠地散步咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "381/SEL",
            "narrator": "",
            "text": "待ってた方が良い",
            "zh": "还是等她吧",
            "narrator_zh": ""
        },
        {
            "location": "382/SEL",
            "narrator": "",
            "text": "迎えに行こう",
            "zh": "去接她吧",
            "narrator_zh": ""
        },
        {
            "location": "383/SEL",
            "narrator": "",
            "text": "ＷＡＶＥ送ってみれば？",
            "zh": "发条 WAVE 试试？",
            "narrator_zh": ""
        },
        {
            "location": "385/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうかしら？",
            "zh": "……是这样吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "388/TALK",
            "narrator": "つばめ",
            "text": "もしかして、お買い物\n頼み過ぎちゃったから――",
            "zh": "该不会是因为大家\n拜托她买的东西太多——",
            "narrator_zh": "燕"
        },
        {
            "location": "389/TALK",
            "narrator": "つばめ",
            "text": "重くて休みながら\n歩いてるのかな？",
            "zh": "提着太重，只能边歇着\n边往回走呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "391/TALK",
            "narrator": "神楽",
            "text": "そんなに重い物、\n誰も頼んでませんよ。",
            "zh": "那么重的东西，\n谁都没有拜托她买哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "心配やったら、\nＷＡＶＥでも送ってみる？",
            "zh": "要是担心的话，\n发条 WAVE 问问看？",
            "narrator_zh": "雅"
        },
        {
            "location": "399/TALK",
            "narrator": "ガブリエラ",
            "text": "し、心配じゃないわよ！\nお菓子が食べたいだけ\nなんだから…。",
            "zh": "才、才不是担心她呢！\n我只是想吃点心\n而已……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "401/TALK",
            "narrator": "ガブリエラ",
            "text": "えっと…今どこ？　っと、\n送信。",
            "zh": "那个……现在到哪了？\n好，发送。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "404/TALK",
            "narrator": "みやび",
            "text": "送った？",
            "zh": "发过去了？",
            "narrator_zh": "雅"
        },
        {
            "location": "406/TALK",
            "narrator": "ガブリエラ",
            "text": "うん…まったく、\n何やってるのかしら…。",
            "zh": "嗯……真是的，\n到底在搞什么名堂啊……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "428/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "429/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんからの返信、\nまだないんですか？",
            "zh": "绫水还没有\n回消息吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "433/TALK",
            "narrator": "ガブリエラ",
            "text": "うん…。\n十分くらい経つのに、\n既読も付かないわ。",
            "zh": "嗯……\n都过去差不多十分钟了，\n连已读都没有显示。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "434/TALK",
            "narrator": "神楽",
            "text": "どうしたんでしょう？\nアーヤさんらしくない\nですね。",
            "zh": "是怎么回事呢？\n这可不像绫水的作风\n呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "435/TALK",
            "narrator": "神楽",
            "text": "いつもならすぐに\n確認して、何かしら\n返してくれるのに…。",
            "zh": "平时她都会立刻\n确认，然后多少\n回个信的……",
            "narrator_zh": "神乐"
        },
        {
            "location": "436/TALK",
            "narrator": "みやび",
            "text": "律儀なアーヤには\n珍しいことやね。",
            "zh": "一向守规矩的绫水\n这样可真是稀奇咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "437/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、\n何かあったんじゃ…。",
            "zh": "难道说，\n真是出什么事了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "440/TALK",
            "narrator": "アーヤ",
            "text": "ただいまー。",
            "zh": "我回来啦—。",
            "narrator_zh": "绫水"
        },
        {
            "location": "442/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、アーヤ！？",
            "zh": "啊、绫水！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "446/TALK",
            "narrator": "アーヤ",
            "text": "お待たせ。\nはい、頼まれてたお菓子、\n買ってきたわ。",
            "zh": "久等了。\n来，你们拜托的零食，\n买回来了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "448/TALK",
            "narrator": "つばめ",
            "text": "おかえりなさい。\n遅かったけど、\n何かあったんですか？",
            "zh": "欢迎回来。\n怎么这么晚，\n发生什么事了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "451/TALK",
            "narrator": "アーヤ",
            "text": "ううん、何も。",
            "zh": "没，什么事也没有。",
            "narrator_zh": "绫水"
        },
        {
            "location": "452/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと立ち読みして、\n潮風が気持ちよかったから\n散歩してただけよ。",
            "zh": "只是稍微站着看了会书，\n海风又挺舒服的，\n就顺便散了会儿步而已。",
            "narrator_zh": "绫水"
        },
        {
            "location": "455/TALK",
            "narrator": "みやび",
            "text": "やっぱりそうやったか。",
            "zh": "果然是这样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "459/TALK",
            "narrator": "神楽",
            "text": "何もなかったようで…\nガブちゃん、よかった\nですね？",
            "zh": "看来什么事都没发生……\n加布，这下放心\n了吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "462/TALK",
            "narrator": "ガブリエラ",
            "text": "な、なんであたしに\n振るのよ！？",
            "zh": "干、干嘛突然把话题\n往我身上引啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "465/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、アーヤ。\nＷＡＶＥ送ったのに\nどうして返事しないのよ？",
            "zh": "话说回来，绫水。\n我明明发了 WAVE 给你，\n怎么不回消息啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "467/TALK",
            "narrator": "アーヤ",
            "text": "どうって、これ見れば\nわかるでしょ？",
            "zh": "怎么不回，你看这个\n不就明白了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "468/TALK",
            "narrator": "アーヤ",
            "text": "あなたが大袋のポテチを\n頼むから、両手が塞がって\n取れなかったのよ。",
            "zh": "谁让你点了个大袋装薯片，\n我两只手都占满了，\n根本腾不出手拿手机啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "470/TALK",
            "narrator": "ガブリエラ",
            "text": "うっ…。",
            "zh": "唔……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "474/TALK",
            "narrator": "みやび",
            "text": "とにかく、お疲れさん。\nお茶煎れるき、アーヤは\nのんびりしちょれ。",
            "zh": "总之，辛苦咯。\n我去泡茶啵，绫水你就\n好好歇着吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "476/TALK",
            "narrator": "アーヤ",
            "text": "ええ…ほら、みんな。\n自分で頼んだの\n持っていって。",
            "zh": "嗯……来，大家。\n自己点的东西\n过来拿吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "479/TALK",
            "narrator": "ガブリエラ",
            "text": "…まったく、心配かけて。",
            "zh": "……真是的，害人白担心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "480/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、何もなかった\nみたいで良かった…。",
            "zh": "不过，看样子没事\n真是太好了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "481/ACT",
            "narrator": "",
            "text": "待ってた方が良い",
            "zh": "还是等她吧",
            "narrator_zh": ""
        },
        {
            "location": "499/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "也是呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "500/TALK",
            "narrator": "ガブリエラ",
            "text": "私も、行けるものなら行きたいけど",
            "zh": "我虽然也想如果能去就去一趟",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "501/TALK",
            "narrator": "ガブリエラ",
            "text": "コンビニまでの道って、まだうろ覚えだし…",
            "zh": "但去便利店的路，我也还记不太清……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "512/TALK",
            "narrator": "ガブリエラ",
            "text": "…まったく、\n早く帰ってきなさいよ…。",
            "zh": "……真是的，\n赶紧给我回来啊……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "535/TALK",
            "narrator": "アーヤ",
            "text": "ただいま。",
            "zh": "我回来了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "537/TALK",
            "narrator": "つばめ",
            "text": "あ、おかえりなさい。\n随分遅かったですね？",
            "zh": "啊，欢迎回来。\n回来得挺晚的呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "541/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさい、待たせて。\nはい、頼まれてた\nおつかいよ。",
            "zh": "抱歉，久等了。\n来，大家托我买的\n东西都在这了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "542/TALK",
            "narrator": "神楽",
            "text": "ありがとうございます！",
            "zh": "谢谢你！",
            "narrator_zh": "神乐"
        },
        {
            "location": "545/TALK",
            "narrator": "アーヤ",
            "text": "ほら、ギャヴィ。\nあんたのお菓子よ。",
            "zh": "来，加维。\n这是你的零食哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "546/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うん…。",
            "zh": "嗯、嗯……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "548/TALK",
            "narrator": "ガブリエラ",
            "text": "…でもこんな時間まで\n何やってたの？",
            "zh": "……不过你磨蹭到这么晚\n到底在干嘛呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "549/TALK",
            "narrator": "アーヤ",
            "text": "少し立ち読みしたあと、\n散歩しながら帰って\nきたのよ。",
            "zh": "稍微站着看了会儿书，\n然后又一边散步一边\n走回来的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "551/TALK",
            "narrator": "アーヤ",
            "text": "そしたら、思ったより\n時間経ってたみたい。",
            "zh": "结果好像比想象中\n花的时间多了一点。",
            "narrator_zh": "绫水"
        },
        {
            "location": "552/TALK",
            "narrator": "ガブリエラ",
            "text": "そう…。\nまあ、それならいいん\nだけど…。",
            "zh": "这样啊……\n嘛，没事的话\n就好……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "553/TALK",
            "narrator": "アーヤ",
            "text": "？",
            "zh": "？",
            "narrator_zh": "绫水"
        },
        {
            "location": "555/TALK",
            "narrator": "ガブリエラ",
            "text": "何でもない！\nほら、アーヤも\nお菓子食べるでしょ？",
            "zh": "没什么！\n来，绫水也一起\n吃零食吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "556/ACT",
            "narrator": "",
            "text": "迎えに行こう",
            "zh": "去接她吧",
            "narrator_zh": ""
        },
        {
            "location": "576/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "也是呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "577/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に、何かあったのかもしれないし",
            "zh": "说不定，真的出了什么事呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "589/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、アーヤ迎えに\n行ってくる！",
            "zh": "我去接一下\n绫水！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "608/TALK",
            "narrator": "ガブリエラ",
            "text": "え、えっと…\nどっちだったかしら？",
            "zh": "哪、哪边来着……\n是走这边吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "609/TALK",
            "narrator": "ガブリエラ",
            "text": "ああもう、昼間だったら\n道わかるのに！",
            "zh": "啊真是的，要是白天的话\n路明明很好认的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "611/TALK",
            "narrator": "ガブリエラ",
            "text": "えーっと、確か…。",
            "zh": "嗯——，我记得……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "615/TALK",
            "narrator": "アーヤ",
            "text": "…ギャヴィ？",
            "zh": "……加维？",
            "narrator_zh": "绫水"
        },
        {
            "location": "617/TALK",
            "narrator": "ガブリエラ",
            "text": "きゃぁっ！？\nあ、アーヤ！！",
            "zh": "呀啊！？\n绫、绫水！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "618/TALK",
            "narrator": "アーヤ",
            "text": "何やってるの、\nこんなところで？",
            "zh": "你在这种地方\n干什么呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "619/TALK",
            "narrator": "アーヤ",
            "text": "もう遅いんだから、\n夜遊びはダメよ。",
            "zh": "天这么晚了，\n晚上可不许跑出来玩哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "620/TALK",
            "narrator": "ガブリエラ",
            "text": "遊んでなんかないわよ！",
            "zh": "我才没有出来玩呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "621/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、何してたの？",
            "zh": "那你这是在干嘛？",
            "narrator_zh": "绫水"
        },
        {
            "location": "624/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、それは…。",
            "zh": "那、那个是……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "627/TALK",
            "narrator": "ガブリエラ",
            "text": "…あ、アーヤが遅くて、\nお菓子待ちきれ\nなかったの！",
            "zh": "……谁、谁让绫水这么慢，\n我等不及吃零食\n了嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "629/TALK",
            "narrator": "アーヤ",
            "text": "何？　そんなにお菓子\n食べたかったの？",
            "zh": "什么？你就那么\n想吃零食吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "630/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ。\nそれ、貰うわよ。",
            "zh": "没错。\n那个，我拿走了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "631/TALK",
            "narrator": "アーヤ",
            "text": "歩きながら食べるつもり？\nお行儀悪いわね。",
            "zh": "你打算边走边吃吗？\n真没礼貌。",
            "narrator_zh": "绫水"
        },
        {
            "location": "633/TALK",
            "narrator": "ガブリエラ",
            "text": "いいじゃん、誰が見てる\nわけでもないんだし。",
            "zh": "有什么关系，反正又没有\n别人在看着。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "634/TALK",
            "narrator": "アーヤ",
            "text": "まったく、自分勝手\nなんだから…。",
            "zh": "真是的，就知道\n由着自己性子来……",
            "narrator_zh": "绫水"
        },
        {
            "location": "636/TALK",
            "narrator": "アーヤ",
            "text": "…っていうか、ウソでも\n心配してたの一言くらい、\n言えないの？",
            "zh": "……话说回来，哪怕是嘴硬，\n你难道连一句“我很担心你”，\n都说不出口吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "638/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "640/TALK",
            "narrator": "ガブリエラ",
            "text": "全然帰ってくる気配なくて\n心配だったから、こうして\n迎えに来たのよ。",
            "zh": "看你半天没有要回来的迹象，\n我太担心了，所以才像这样\n出来接你的啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "642/TALK",
            "narrator": "アーヤ",
            "text": "はいはい、ありがと。\nほら、帰るわよ。",
            "zh": "好好好，谢谢。\n行啦，回去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "645/TALK",
            "narrator": "ガブリエラ",
            "text": "何よ、自分で言えって\n言ったくせに…。",
            "zh": "什么嘛，明明是你自己\n让我说出来的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "646/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、無事でよかった。",
            "zh": "……不过，平安无事就好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "663/ACT",
            "narrator": "",
            "text": "ＷＡＶＥ送ってみれば？",
            "zh": "发条 WAVE 试试？",
            "narrator_zh": ""
        },
        {
            "location": "682/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "也是呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "683/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ、ＷＡＶＥにはすぐ返事くれるし",
            "zh": "绫水平时收到 WAVE 都会很快回复的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "686/TALK",
            "narrator": "ガブリエラ",
            "text": "えっと…今どこ？　っと、\n送信。",
            "zh": "那个……现在到哪了？\n好，发送。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "688/TALK",
            "narrator": "みやび",
            "text": "ＷＡＶＥ送ったが？",
            "zh": "发 WAVE 了喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "689/TALK",
            "narrator": "ガブリエラ",
            "text": "うん…まったく、\n何やってるのかしら…。",
            "zh": "嗯……真是的，\n到底在搞什么名堂啊……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "306/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月22日　 7:53 PM</color>\n合宿中、みやびの実家でのこと",
            "zh": "<color=green>8月22日　 7:53 PM</color>\n合宿期间，在雅的老家",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "657/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch03",
            "text": "【お姉さんぶっちゃって】",
            "zh": "【还摆起姐姐架子了】",
            "narrator_zh": "Dialog_GEThimegoto_ch03"
        }
    ]
}
