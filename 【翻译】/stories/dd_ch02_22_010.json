{
    "dir": "chap22/daydra/dd_ch02_22_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "22252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "人形の間での一夜",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "人偶房间里的一夜"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "人形の間での一夜",
            "zh": "人偶房间里的一夜",
            "narrator_zh": ""
        },
        {
            "location": "19/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "22/TALK",
            "narrator": "アーヤ",
            "text": "大丈夫、ギャヴィ？",
            "zh": "没事吧，加维？",
            "narrator_zh": "绫水"
        },
        {
            "location": "25/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは平気よ…。\n大丈夫じゃないのは、\nアーヤの方でしょ？",
            "zh": "我倒是没事啦……。\n真正有事的，\n是绫水才对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱり、怖いよね？",
            "zh": "……果然，还是会害怕吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "…ごめん。\nあたしのせいで、\nこんなことになって…。",
            "zh": "……抱歉。\n都是因为我，\n才变成这样……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "アーヤ",
            "text": "…いいのよ。",
            "zh": "……没关系的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "36/TALK",
            "narrator": "アーヤ",
            "text": "私だって、まさかここまで\n大事になるとは、思いも\nしなかったし…。",
            "zh": "我也是，真没想到\n事情会闹到这么大，\n完全没料到……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "ガブリエラ",
            "text": "…あの話、本当かな？",
            "zh": "……那件事，是真的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "…島流し？",
            "zh": "……流放？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "そうや。",
            "zh": "是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "この土地にはな、\n昔から島流しっちゅう\n神隠しを起こす――",
            "zh": "这片地方啊，\n从古时候起就有个叫流放、\n会把人神隐的——",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "恐ろしい悪霊が\nおったがよ。",
            "zh": "吓人的恶灵\n在的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "そいつはこの土地に住む\n人たちを、大勢攫って\n消してしもうたんや。",
            "zh": "那家伙把住在这片地方的\n好多人，都掳走\n弄消失了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "そ、その悪霊が、\nあの部屋に閉じ込めて\nあった、っていうの！？",
            "zh": "那、那个恶灵，\n原本一直被关在\n那个房间里吗！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか…幽霊なんて\n存在するはず――。",
            "zh": "怎么可能……幽灵什么的\n怎么可能存在——。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "あの部屋に入ってから、\n何かおかしなことが\n起きてないが？",
            "zh": "进过那个房间之后，\n没发生什么\n奇怪的事吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "例えば…手紙の入った\nボトルを拾ったりとか…。",
            "zh": "比如说……捡到装了信的\n瓶子之类的……。",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "寝ちゅう間に、身体に\n手形みたいな痣が\n出来てたりとか…。",
            "zh": "睡着的时候，身上\n冒出像手印一样的淤青\n之类的……。",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "ひっ！？",
            "zh": "噫！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "…非常に不味い事態や。\n真面目な話、一刻を争う\n事態や。",
            "zh": "……情况相当不妙咯。\n说真的，这是刻不容缓的\n事态咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "二人には、今日はあの\n部屋で一夜を明かして\nもらうぞ。",
            "zh": "你们两个，今晚就在那个\n房间里过一夜\n吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "えぇっ！？\nど、どうして！？",
            "zh": "诶诶！？\n为、为什么！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "あの部屋の封印解いたんは\nアーヤ達やろ！？",
            "zh": "解开那个房间封印的\n不就是绫水你们嘛！？",
            "narrator_zh": "雅"
        },
        {
            "location": "82/TALK",
            "narrator": "みやび",
            "text": "それに、悪霊に狙われ\nちゅうんもアーヤ達や。",
            "zh": "而且，被恶灵盯上的\n也是绫水你们咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "83/TALK",
            "narrator": "みやび",
            "text": "なら、二人が囮になれば\nあの悪霊はもう一度あの\n部屋に戻ってくる。",
            "zh": "那只要你们俩当诱饵，\n那个恶灵就会再次回到\n那个房间里来。",
            "narrator_zh": "雅"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "そうすれば、もう一度\nあの部屋に封印することが\nできるちや。",
            "zh": "那样一来，就能再一次\n把它封印进那个房间里\n了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ！？\nあたし達に囮になれって\nいうの！？",
            "zh": "哈啊！？\n你是说要让我们俩\n去当诱饵吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "奴をもう一度封印する\n方法も――",
            "zh": "把那家伙再次封印的\n办法也好——",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "二人を助ける方法も、\nもうそれしかない。",
            "zh": "救你们俩的办法也好，\n都只有这一个了。",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "…だから、あれほど\n入るな言うたのに…。",
            "zh": "……所以我才那么叮嘱\n不要进去嘛……。",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "アーヤ",
            "text": "大丈夫？",
            "zh": "没事吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うん…なんだか、\n人形たちに見られてる\n気がして来て…。",
            "zh": "嗯、嗯……总觉得，\n好像一直被那些人偶\n盯着看一样……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/TALK",
            "narrator": "アーヤ",
            "text": "ほら、こっちおいで。",
            "zh": "来，到这边来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "117/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "アーヤ",
            "text": "くっついてれば、\n怖くないでしょ？",
            "zh": "贴在一起的话，\n就不怕了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "ガブリエラ",
            "text": "な、なによ。\nアーヤの方が\n怖がりのクセに…。",
            "zh": "什、什么嘛。\n明明绫水自己才是\n个胆小鬼……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…そうね…。",
            "zh": "呵呵……是啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "アーヤ",
            "text": "けど…ギャヴィのことは\n護るから…安心して。",
            "zh": "不过……我会保护好\n加维的……放心吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "134/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/TALK",
            "narrator": "ガブリエラ",
            "text": "…アーヤって、こんなに\n凛々しかったっけ？",
            "zh": "……绫水有这么\n英气凛然吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "二人とも、大人しく\n部屋にいるようやな。",
            "zh": "两个人，都老老实实\n待在房间里了嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "161/TALK",
            "narrator": "みやび",
            "text": "相棒、アーヤ達を驚かす手伝いをしてもらえるか？",
            "zh": "搭档，能帮我吓唬一下绫水她们吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "163/SEL",
            "narrator": "",
            "text": "驚かす？",
            "zh": "吓唬？",
            "narrator_zh": ""
        },
        {
            "location": "164/ACT",
            "narrator": "",
            "text": "驚かす？",
            "zh": "吓唬？",
            "narrator_zh": ""
        },
        {
            "location": "166/TALK",
            "narrator": "みやび",
            "text": "そうや",
            "zh": "是咯",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "あの二人な、うちが入るな言うた部屋に入ったんよ",
            "zh": "那两个人啊，进了我不让进的房间咯",
            "narrator_zh": "雅"
        },
        {
            "location": "168/TALK",
            "narrator": "みやび",
            "text": "やき、ちっくとお仕置きが必要思うてな",
            "zh": "所以啊，我觉得有必要给一哈惩罚啵",
            "narrator_zh": "雅"
        },
        {
            "location": "169/TALK",
            "narrator": "みやび",
            "text": "相棒には悪霊のフリして、アーヤ達に話しかけてほしいがよ",
            "zh": "我想让搭档假装恶灵，去跟绫水她们搭话啵",
            "narrator_zh": "雅"
        },
        {
            "location": "172/SEL",
            "narrator": "",
            "text": "島流しをする悪霊は？",
            "zh": "会引起流放的恶灵呢？",
            "narrator_zh": ""
        },
        {
            "location": "173/ACT",
            "narrator": "",
            "text": "島流しをする悪霊は？",
            "zh": "会引起流放的恶灵呢？",
            "narrator_zh": ""
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "んなもんいるわけないちや",
            "zh": "那种东西怎么可能有咯",
            "narrator_zh": "雅"
        },
        {
            "location": "176/TALK",
            "narrator": "みやび",
            "text": "さあ、頼んだぞ",
            "zh": "来，拜托你咯",
            "narrator_zh": "雅"
        },
        {
            "location": "200/TALK",
            "narrator": "ガブリエラ",
            "text": "そっか…アーヤの実家って\n神社だったんだ…。",
            "zh": "这样啊……绫水老家\n是神社来着……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/TALK",
            "narrator": "アーヤ",
            "text": "うん…だから、実際に\nお祓いをするところを\n何度も見ていて――",
            "zh": "嗯……所以，我亲眼\n见过好多次实际\n驱邪除灵的场面——",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/TALK",
            "narrator": "アーヤ",
            "text": "そういう恐ろしい物が\n本当に存在する、って\nいうのを――",
            "zh": "那些可怕的东西\n真的存在，\n这件事——",
            "narrator_zh": "绫水"
        },
        {
            "location": "205/TALK",
            "narrator": "アーヤ",
            "text": "子供の頃から何度も\n見ているの。",
            "zh": "我从很小的时候起\n就见过好多次了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/TALK",
            "narrator": "ガブリエラ",
            "text": "…ようやくわかった。\nアーヤが人並み以上に、\nオカルト嫌いな理由が。",
            "zh": "……总算明白了。\n绫水之所以比一般人\n更讨厌灵异怪谈的原因。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当、ごめん。\nそんなこととは\n知らなくて、あたし…。",
            "zh": "……真的，抱歉。\n我完全不知道\n还有这种事……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "214/TALK",
            "narrator": "アーヤ",
            "text": "ううん、私だって\n悪かったのよ。",
            "zh": "没事，我也有\n做得不对的地方。",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィが幽霊とか、\nオカルトを信じてないの\n知ってるのに――",
            "zh": "明明知道加维\n不信幽灵啊、\n灵异之类的东西——",
            "narrator_zh": "绫水"
        },
        {
            "location": "216/TALK",
            "narrator": "アーヤ",
            "text": "まともに説明もしないで、\nダメとか言っても――",
            "zh": "却不好好解释，\n光说不行不行——",
            "narrator_zh": "绫水"
        },
        {
            "location": "218/TALK",
            "narrator": "アーヤ",
            "text": "そんなの、説得力ないし\n聞いてもらえるわけ\nないもの。",
            "zh": "那样既没有说服力，\n别人也不可能\n听进去嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "222/TALK",
            "narrator": "アーヤ",
            "text": "古い家なら、どこでも\nこういう曰く付きの\n部屋や――",
            "zh": "也不是说只要是老宅子，\n就一定会有这种\n有来头的房间或——",
            "narrator_zh": "绫水"
        },
        {
            "location": "223/TALK",
            "narrator": "アーヤ",
            "text": "物がある、ってわけじゃ\nないの。",
            "zh": "什么东西\n在里面。",
            "narrator_zh": "绫水"
        },
        {
            "location": "224/TALK",
            "narrator": "アーヤ",
            "text": "けど、あるところには、\n確かに存在する。",
            "zh": "但有的地方，\n确实是存在的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "225/TALK",
            "narrator": "アーヤ",
            "text": "その中にも、噂だけで\n実際は何でもないところの\n方が多いと思うけど――",
            "zh": "虽然这其中，大多只是\n空穴来风、实际上\n什么也没有的地方居多——",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/TALK",
            "narrator": "アーヤ",
            "text": "噂じゃなくて、\n本当に超常的な何かが\n存在する場合もある。",
            "zh": "但也确实有不是谣言、\n真正存在某种超自然\n之物的情况。",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "アーヤ",
            "text": "…少なくとも、\nこれくらいの説明は\nしておくべきだったわ。",
            "zh": "……至少，\n这点解释我还是\n应该提前说清楚的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "230/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "232/TALK",
            "narrator": "ガブリエラ",
            "text": "何か、起きるのかな？",
            "zh": "真的会出什么事吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "235/TALK",
            "narrator": "アーヤ",
            "text": "…起きなければいいん\nだけど…わからないわ。",
            "zh": "……不出事当然最好……\n不过我也说不好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "237/SEL",
            "narrator": "",
            "text": "ミ　ツ　ケ　タ",
            "zh": "找　到　你　了",
            "narrator_zh": ""
        },
        {
            "location": "238/SEL",
            "narrator": "",
            "text": "$me$だよー、驚いた？",
            "zh": "是$me$呀——，吓到了吗？",
            "narrator_zh": ""
        },
        {
            "location": "239/ACT",
            "narrator": "",
            "text": "ミ　ツ　ケ　タ",
            "zh": "找　到　你　了",
            "narrator_zh": ""
        },
        {
            "location": "247/TALK",
            "narrator": "アーヤ",
            "text": "っ！？\n何かしら…。",
            "zh": "唔！？\n是什么呀……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "261/TALK",
            "narrator": "アーヤ",
            "text": "は？　何これ！",
            "zh": "哈？　什么啊这是！",
            "narrator_zh": "绫水"
        },
        {
            "location": "262/TALK",
            "narrator": "アーヤ",
            "text": "今はイタズラはやめて！",
            "zh": "现在别搞恶作剧！",
            "narrator_zh": "绫水"
        },
        {
            "location": "264/SEL",
            "narrator": "",
            "text": "ソノ女ヲ頂ク",
            "zh": "那个女人我收下了",
            "narrator_zh": ""
        },
        {
            "location": "265/ACT",
            "narrator": "",
            "text": "ソノ女ヲ頂ク",
            "zh": "那个女人我收下了",
            "narrator_zh": ""
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "あなた…まさか、Ｂｏｔじゃないの？",
            "zh": "你……难道说，不是 Bot 吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "270/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "272/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ…それ送ってきたの\nって、まさか…。",
            "zh": "绫水……发那个过来的\n该不会是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "273/TALK",
            "narrator": "アーヤ",
            "text": "…ソノ女ヲ頂ク…\nその女って！",
            "zh": "……那个女人我收下了……\n那个女人指的是！",
            "narrator_zh": "绫水"
        },
        {
            "location": "276/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ！！",
            "zh": "加维！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "279/TALK",
            "narrator": "ガブリエラ",
            "text": "きゃっ！？\nちょ、苦しいって！",
            "zh": "呀！？\n等、勒得好紧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "283/TALK",
            "narrator": "アーヤ",
            "text": "渡さない！",
            "zh": "休想带走！",
            "narrator_zh": "绫水"
        },
        {
            "location": "285/TALK",
            "narrator": "アーヤ",
            "text": "この子は、\n絶対に渡さないわ！",
            "zh": "这孩子，\n我绝对不会交出去！",
            "narrator_zh": "绫水"
        },
        {
            "location": "286/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ…。",
            "zh": "绫水……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/TALK",
            "narrator": "アーヤ",
            "text": "大丈夫よ、ギャヴィ。\nこうしてしっかり\n抱きしめてるから…。",
            "zh": "没事的，加维。\n我就这样紧紧\n抱着你……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "291/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ…あなたは、\n私が護ってみせるから。",
            "zh": "加维……我一定会\n保护好你的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "294/TALK",
            "narrator": "アーヤ",
            "text": "連れてくなら、\n私を連れて行きなさい！",
            "zh": "要带走的话，\n就把我带走好了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "295/TALK",
            "narrator": "ガブリエラ",
            "text": "な、何言ってるの！？\n狙われてるのはあたし\nなんだから！",
            "zh": "你、你在说什么啊！？\n被盯上的明明是我\n好不好！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "297/TALK",
            "narrator": "アーヤ",
            "text": "だから護るの！\nギャヴィはどこにも\n連れて行かせないわ。",
            "zh": "所以我才要保护你！\n绝不会让加维\n被带到任何地方去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "298/TALK",
            "narrator": "ガブリエラ",
            "text": "バカ！！\nあたしより、ずっと\n怖がりのクセに！！",
            "zh": "笨蛋！！\n你明明比我还要\n怕得要死！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "301/TALK",
            "narrator": "ガブリエラ",
            "text": "悪霊だかなんだか\n知らないけど、\n狙うのはあたしよ！",
            "zh": "管它是什么恶灵还是\n什么东西，\n它盯上的是我！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "305/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ！？",
            "zh": "加维！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "306/TALK",
            "narrator": "ガブリエラ",
            "text": "怖がりのアーヤに\n手出ししたら、\nあたしが許さない！",
            "zh": "要是敢对胆小的绫水\n出手，\n我可绝不饶它！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "307/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしがアーヤを\n護るんだから！！",
            "zh": "由我来保护\n绫水才对！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "308/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "314/TALK",
            "narrator": "ガブリエラ",
            "text": "…………あっ。",
            "zh": "…………啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "317/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのスマホが…。",
            "zh": "我的手机……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "318/TALK",
            "narrator": "アーヤ",
            "text": "…何て書いてあるの？",
            "zh": "……上面写了什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "319/TALK",
            "narrator": "ガブリエラ",
            "text": "…え？",
            "zh": "……诶？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "320/TALK",
            "narrator": "ガブリエラ",
            "text": "次はない、\n二度と我の部屋に\n入るな…って…。",
            "zh": "下不为例，\n绝不许再踏入吾之\n房间……这样写着……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "321/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "322/TALK",
            "narrator": "ガブリエラ",
            "text": "…これ…許されたの？",
            "zh": "……这算……被原谅了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "アーヤ",
            "text": "わからない…\nわからないけど――",
            "zh": "不知道……\n虽然不知道——",
            "narrator_zh": "绫水"
        },
        {
            "location": "328/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、なんともない？",
            "zh": "加维，没出什么事吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "331/TALK",
            "narrator": "ガブリエラ",
            "text": "うん…アーヤも平気？",
            "zh": "嗯……绫水也没事吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "ええ…どうやら、\n助かった、ってこと\nかしら？",
            "zh": "嗯……看来我们，\n这是得救了\n吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "338/TALK",
            "narrator": "ガブリエラ",
            "text": "よ、よかったぁ…。",
            "zh": "太、太好了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "339/TALK",
            "narrator": "ガブリエラ",
            "text": "本当、一時はどうなるかと\n思ったわ…。",
            "zh": "真的，刚才有一瞬间\n我都不知道会怎样了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "342/TALK",
            "narrator": "アーヤ",
            "text": "どうなるかと思った、\nじゃないでしょ！",
            "zh": "怎么能只说\n不知道会怎样呢！",
            "narrator_zh": "绫水"
        },
        {
            "location": "343/TALK",
            "narrator": "アーヤ",
            "text": "自分を狙えだなんて、\nなんてバカなこと\n言うの！？",
            "zh": "说什么冲我来吧之类的，\n怎么能说出\n那种傻话！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "345/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？\nだ、だって…。",
            "zh": "诶！？\n可、可是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "346/TALK",
            "narrator": "アーヤ",
            "text": "私が護るって言ったのに、\nどうしていつも勝手に――",
            "zh": "明明我都说了会保护你，\n为什么总是擅自——",
            "narrator_zh": "绫水"
        },
        {
            "location": "348/TALK",
            "narrator": "ガブリエラ",
            "text": "か、勝手なのは\nアーヤの方でしょ！？",
            "zh": "擅、擅自做主的是\n绫水才对吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "349/TALK",
            "narrator": "ガブリエラ",
            "text": "狙われてたのは\nあたしなのに――",
            "zh": "被盯上的明明是\n我才对——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "350/TALK",
            "narrator": "ガブリエラ",
            "text": "勝手に身代わりになろうと\nしたじゃない！",
            "zh": "你不是也擅自想当我的\n替身吗！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "353/TALK",
            "narrator": "アーヤ",
            "text": "そ、それは…私は神社の\n娘だから、こういうのは\n慣れてるのよ。",
            "zh": "那、那是因为……我是神社\n的女儿，这种场面\n早就习惯了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "354/TALK",
            "narrator": "ガブリエラ",
            "text": "超怖がりじゃん！\n耐性ゼロじゃん！",
            "zh": "明明超怕的好吗！\n抗性明明是零好吗！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "356/TALK",
            "narrator": "アーヤ",
            "text": "うっ…そ、それは…。",
            "zh": "唔……这、这个……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "357/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、やっぱり。",
            "zh": "你看，果然。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "358/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "361/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、嬉しかった。",
            "zh": "……不过，我很开心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "362/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのこと…\n護るって言ってくれて…。",
            "zh": "你愿意说……\n要保护我……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "363/TALK",
            "narrator": "ガブリエラ",
            "text": "凄く怖かったのに、\n言ってくれたのよね？",
            "zh": "明明自己怕得要命，\n却还是说出口了，对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "366/TALK",
            "narrator": "アーヤ",
            "text": "…ギャヴィがいなくなる\nことに比べたら、\n何てことないわ。",
            "zh": "……和失去加维\n相比，\n那点害怕不算什么。",
            "narrator_zh": "绫水"
        },
        {
            "location": "368/TALK",
            "narrator": "アーヤ",
            "text": "それに、私も嬉しかった。\n護るって言ってもらえて。",
            "zh": "而且，我也很开心。\n听到你说要保护我。",
            "narrator_zh": "绫水"
        },
        {
            "location": "372/TALK",
            "narrator": "ガブリエラ",
            "text": "…と、当然じゃない！\nあたしは怖くないん\nだから…。",
            "zh": "……那、那不是当然的吗！\n反正我又不会\n害怕……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "373/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、そうね…。",
            "zh": "呵呵，是呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "374/TALK",
            "narrator": "アーヤ",
            "text": "…でも、もう二度と\n私の身代わりになろうと\nするようなこと――",
            "zh": "……不过，以后\n再像这样想替我\n当替身的事——",
            "narrator_zh": "绫水"
        },
        {
            "location": "375/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィにはしてほしく\nないわ。",
            "zh": "以后再也不许\n加维这么做了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "378/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしも同じよ。\nあんなの、全然嬉しく\nないんだから…。",
            "zh": "我也一样。\n那种事，我可一点都\n开心不起来……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "379/TALK",
            "narrator": "アーヤ",
            "text": "たった今嬉しいって\n言ったのは、誰だった\nかしら？",
            "zh": "刚刚才说过很开心的，\n不知道是谁\n呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "381/TALK",
            "narrator": "ガブリエラ",
            "text": "い、一々そんな\nツッコミ入れないでよ！",
            "zh": "别、别特意挑这种\n字眼吐槽啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "382/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかく、もう二度と\n身代わりになろうと\nするのは禁止よ？",
            "zh": "总之，以后不准再\n想替别人当替身了，\n禁止哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "383/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィもしない、って\n約束してくれるなら、\n私も誓うわ。",
            "zh": "要是加维也答应\n不这么做的话，\n我也发誓。",
            "narrator_zh": "绫水"
        },
        {
            "location": "385/TALK",
            "narrator": "ガブリエラ",
            "text": "しないって。",
            "zh": "不会的啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "387/TALK",
            "narrator": "ガブリエラ",
            "text": "…………多分ね。",
            "zh": "…………大概吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "397/TALK",
            "narrator": "みやび",
            "text": "乱入するタイミング、\n完全に逃したてしもうた。",
            "zh": "插话进去的时机，\n完全错过了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "409/TALK",
            "narrator": "みやび",
            "text": "相棒の協力のおかげで、バッチリお仕置き完了ちや",
            "zh": "多亏搭档帮忙，惩罚完美收工咯",
            "narrator_zh": "雅"
        },
        {
            "location": "410/TALK",
            "narrator": "みやび",
            "text": "お手伝いありがとさん",
            "zh": "谢啦，帮大忙了",
            "narrator_zh": "雅"
        },
        {
            "location": "412/SEL",
            "narrator": "",
            "text": "二人はどうする？",
            "zh": "那两人怎么办？",
            "narrator_zh": ""
        },
        {
            "location": "413/ACT",
            "narrator": "",
            "text": "二人はどうする？",
            "zh": "那两人怎么办？",
            "narrator_zh": ""
        },
        {
            "location": "415/TALK",
            "narrator": "みやび",
            "text": "えい雰囲気やし、一晩放っておくつもりや",
            "zh": "气氛好得很，我打算晾她们一晚咯",
            "narrator_zh": "雅"
        },
        {
            "location": "416/TALK",
            "narrator": "みやび",
            "text": "あんな仲のえい二人の姿、初めて見るきね",
            "zh": "她俩关系这么好的样子，我还是头一回见啵",
            "narrator_zh": "雅"
        },
        {
            "location": "443/ACT",
            "narrator": "",
            "text": "$me$だよー、驚いた？",
            "zh": "是$me$呀——，吓到了吗？",
            "narrator_zh": ""
        },
        {
            "location": "450/TALK",
            "narrator": "アーヤ",
            "text": "っ！？\n何かしら…。",
            "zh": "唔！？\n是什么呀……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "464/TALK",
            "narrator": "アーヤ",
            "text": "タイミング悪過ぎ",
            "zh": "时机太差了",
            "narrator_zh": "绫水"
        },
        {
            "location": "465/TALK",
            "narrator": "アーヤ",
            "text": "空気読めないおふざけって、本当最低ね",
