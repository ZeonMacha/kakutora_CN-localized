{
    "dir": "chap11/daydra/dd_ch02_11_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "11205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "その彼女嫉妬につき＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "关于那女孩的嫉妒＜后篇＞"
    },
    "entry": [
        {
            "location": "564/SCENARIO",
            "narrator": "",
            "text": "恋について",
            "zh": "关于恋爱",
            "narrator_zh": ""
        },
        {
            "location": "593/TALK",
            "narrator": "アーヤ",
            "text": "…そっか。",
            "zh": "……这样啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "594/TALK",
            "narrator": "アーヤ",
            "text": "つばめが私と小夜に\n対しての態度が\n違うのは――",
            "zh": "燕对我和小夜\n态度之所以\n不一样——",
            "narrator_zh": "绫水"
        },
        {
            "location": "595/TALK",
            "narrator": "アーヤ",
            "text": "私にも原因が\nあったんだわ。",
            "zh": "我自己也是\n有原因的啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "597/TALK",
            "narrator": "アーヤ",
            "text": "今まで、何となく\nつばめに対して――",
            "zh": "至今为止，我一直\n不知不觉对燕——",
            "narrator_zh": "绫水"
        },
        {
            "location": "598/TALK",
            "narrator": "アーヤ",
            "text": "一線引いた態度を\n取っちゃってたのは\n事実だし。",
            "zh": "保持着划清界线的\n态度，这也是\n事实嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "599/TALK",
            "narrator": "アーヤ",
            "text": "素直に接してる\n小夜に懐くのは、\n当然のことよね。",
            "zh": "她会黏着坦率相待的\n小夜，也是理所当然\n的事呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "600/TALK",
            "narrator": "アーヤ",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "602/TALK",
            "narrator": "小夜",
            "text": "あれ？\nため息なんか吐いて、\nどうしたの？",
            "zh": "咦？\n干嘛叹起气来了，\n怎么了吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "604/TALK",
            "narrator": "アーヤ",
            "text": "あ、ううん。\n何でもない。",
            "zh": "啊，没什么。\n什么事也没有。",
            "narrator_zh": "绫水"
        },
        {
            "location": "606/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん、\nなんだか元気ない\nみたいです。",
            "zh": "绫水，\n看起来好像有点\n没精神呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "607/TALK",
            "narrator": "つばめ",
            "text": "もしかして、\n具合でも悪いんじゃ\nないですか？",
            "zh": "难道说，\n是哪里身体\n不舒服吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "610/TALK",
            "narrator": "アーヤ",
            "text": "ううん、本当に平気。",
            "zh": "没事，真的没关系。",
            "narrator_zh": "绫水"
        },
        {
            "location": "611/TALK",
            "narrator": "アーヤ",
            "text": "心配してくれて\nありがとう、つばめ。",
            "zh": "谢谢你关心我，\n燕。",
            "narrator_zh": "绫水"
        },
        {
            "location": "613/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ？",
            "zh": "哎？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "616/TALK",
            "narrator": "つばめ",
            "text": "あっ…い、いえ…。",
            "zh": "啊……没、没有……。",
            "narrator_zh": "燕"
        },
        {
            "location": "617/TALK",
            "narrator": "アーヤ",
            "text": "…？　どうかしたの？",
            "zh": "……？怎么了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "620/TALK",
            "narrator": "つばめ",
            "text": "いえ、その…大した\nことじゃないんです\nけど。",
            "zh": "没、没什么……\n也不是什么\n大不了的事啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "621/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんに名前で\n呼ばれるの初めて\nだったから――",
            "zh": "只是，还是第一次被\n绫水直接叫名字\n呢——",
            "narrator_zh": "燕"
        },
        {
            "location": "622/TALK",
            "narrator": "つばめ",
            "text": "ちょっとだけ\nビックリしちゃい\nました。",
            "zh": "稍微有点\n被吓到了\n而已。",
            "narrator_zh": "燕"
        },
        {
            "location": "624/TALK",
            "narrator": "アーヤ",
            "text": "…え？",
            "zh": "……哎？",
            "narrator_zh": "绫水"
        },
        {
            "location": "627/TALK",
            "narrator": "アーヤ",
            "text": "え！？\n今、私つばめって\n言った？",
            "zh": "哎！？\n刚才，我直接\n叫了「燕」吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "630/TALK",
            "narrator": "ガブリエラ",
            "text": "言ってたわ。",
            "zh": "叫了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "632/TALK",
            "narrator": "小夜",
            "text": "普通に言ってたよ。",
            "zh": "很自然地就叫出来了呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "633/TALK",
            "narrator": "アーヤ",
            "text": "えぇっ！？",
            "zh": "哎哎！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "634/TALK",
            "narrator": "アーヤ",
            "text": "ご、ごめんなさい、\n逢瀬さん。",
            "zh": "抱、抱歉，\n逢濑。",
            "narrator_zh": "绫水"
        },
        {
            "location": "636/TALK",
            "narrator": "つばめ",
            "text": "いえ、いいんです。\n呼ばれ方は別に\n気にしてませんから。",
            "zh": "没关系的，不用道歉。\n怎么称呼我其实\n并不在意的。",
            "narrator_zh": "燕"
        },
        {
            "location": "637/TALK",
            "narrator": "アーヤ",
            "text": "そ、そう？",
            "zh": "是、是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "638/TALK",
            "narrator": "つばめ",
            "text": "はい…。",
            "zh": "是的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "640/TALK",
            "narrator": "つばめ",
            "text": "でも、名字よりも、\n名前で読んでもらった\n方が――",
            "zh": "不过，比起姓氏，\n还是被叫名字\n的时候——",
            "narrator_zh": "燕"
        },
        {
            "location": "641/TALK",
            "narrator": "つばめ",
            "text": "何となくだけど\n嬉しい感じがします。",
            "zh": "总觉得心里会\n莫名感到更开心一些呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "644/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "646/TALK",
            "narrator": "アーヤ",
            "text": "じゃ、じゃあ、\n私もこれからは――",
            "zh": "那、那么，\n我从今以后也——",
            "narrator_zh": "绫水"
        },
        {
            "location": "647/TALK",
            "narrator": "アーヤ",
            "text": "つばめ、って呼ばせて\nもらおうかしら？",
            "zh": "可以直接叫你\n「燕」吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "649/TALK",
            "narrator": "つばめ",
            "text": "…はい！\n嬉しいです、\nアーヤさん。",
            "zh": "……好的！\n我很开心，\n绫水。",
            "narrator_zh": "燕"
        },
        {
            "location": "650/TALK",
            "narrator": "小夜",
            "text": "私も、つばめちゃんは\n名前で呼んだ方が\n絶対いいと思うよ。",
            "zh": "我也觉得，直接\n叫燕的名字\n绝对更好哦。",
            "narrator_zh": "小夜"
        },
        {
            "location": "651/TALK",
            "narrator": "小夜",
            "text": "つばめって名前、\n凄く素敵だし。",
            "zh": "毕竟「燕」这个名字，\n特别好听嘛。",
            "narrator_zh": "小夜"
        },
        {
            "location": "653/TALK",
            "narrator": "つばめ",
            "text": "そ、そうですか？\nえへへ…ありがとう\nございます。",
            "zh": "是、是这样吗？\n哎嘿嘿……谢谢\n你的夸奖。",
            "narrator_zh": "燕"
        },
        {
            "location": "656/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "659/TALK",
            "narrator": "ガブリエラ",
            "text": "何よ、つばめってば。\n小夜さんに懐いてたと\n思ったら――",
            "zh": "什么嘛，燕这家伙。\n刚才还以为她正\n黏着小夜呢——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "660/TALK",
            "narrator": "ガブリエラ",
            "text": "今度は突然、アーヤと\n仲良くしだして…。",
            "zh": "这下又突然跟绫水\n亲热起来了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "662/TALK",
            "narrator": "ガブリエラ",
            "text": "…ふふっ、\nいいこと考えた。",
            "zh": "……呵呵，\n我想到个好主意。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "665/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃあ、つばめも\nアーヤを呼び捨てに\nすれば？",
            "zh": "那这样的话，燕也\n别带敬称直接叫\n绫水不就好了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "668/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nだ、ダメダメ、\nできないよぉ…。",
            "zh": "哎哎！？\n不、不行不行，\n我做不到啦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "669/TALK",
            "narrator": "ガブリエラ",
            "text": "何でよ？",
            "zh": "为什么呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "670/TALK",
            "narrator": "つばめ",
            "text": "だって、アーヤさんは\n先輩だし…。",
            "zh": "因为，绫水是\n前辈嘛……。",
            "narrator_zh": "燕"
        },
        {
            "location": "671/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしもみやびも、\n普通にアーヤのこと\n呼び捨てなんだけど？",
            "zh": "我和雅平时也是\n直接叫绫水名字\n不带敬称的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "674/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、アーヤだって\nそんなこと気にしない\nわよ…ね？",
            "zh": "而且，绫水她才不会\n在意这种事呢\n……对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "676/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、そうね。\n別に構わないわ。",
            "zh": "呵呵，是啊。\n我完全不介意哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "678/TALK",
            "narrator": "つばめ",
            "text": "で、でも…。",
            "zh": "可、可是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "681/TALK",
            "narrator": "ガブリエラ",
            "text": "一回だけさ、\n試しに呼んでみれば？",
            "zh": "就试着叫一次嘛，\n叫叫看怎么样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "682/TALK",
            "narrator": "ガブリエラ",
            "text": "意外と呼びやすくて\n定着するかもしれない\nんだし。",
            "zh": "说不定意外地顺口，\n以后就这么习惯\n下来了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "683/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\nそれいいかも。",
            "zh": "说得对。\n那主意好像不错。",
            "narrator_zh": "绫水"
        },
        {
            "location": "685/TALK",
            "narrator": "つばめ",
            "text": "え、ちょ…、\n本気ですか？",
            "zh": "哎、等……，\n你们是认真的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "686/TALK",
            "narrator": "小夜",
            "text": "あー、はいはい、\nそこまでー。",
            "zh": "啊——，好好好，\n就到这里打住——。",
            "narrator_zh": "小夜"
        },
        {
            "location": "687/TALK",
            "narrator": "小夜",
            "text": "可愛いからからかい\nたくなる気持ち\nわかるけど――",
            "zh": "虽然很理解你们\n看她可爱想逗逗她\n的心情——",
            "narrator_zh": "小夜"
        },
        {
            "location": "688/TALK",
            "narrator": "小夜",
            "text": "やり過ぎると\n嫌われちゃうよ？",
            "zh": "但逗过头的话\n会被讨厌的哦？",
            "narrator_zh": "小夜"
        },
        {
            "location": "689/TALK",
            "narrator": "アーヤ",
            "text": "そ、そうね…。\nちょっと調子に\n乗っちゃったかしら？",
            "zh": "说、说得也是……。\n是不是稍微有点\n得意忘形了呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "691/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、つばめは\n堅苦しいんだから…。",
            "zh": "真是的，燕也太\n拘谨了啦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "693/TALK",
            "narrator": "つばめ",
            "text": "助かりました、\n小夜さん。",
            "zh": "真是得救了，\n小夜。",
            "narrator_zh": "燕"
        },
        {
            "location": "694/TALK",
            "narrator": "小夜",
            "text": "あはは、これくらい\n何てことないって。",
            "zh": "啊哈哈，这点小事\n算不了什么啦。",
            "narrator_zh": "小夜"
        },
        {
            "location": "695/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "707/TALK",
            "narrator": "アーヤ",
            "text": "何だか",
            "zh": "总觉得",
            "narrator_zh": "绫水"
        },
        {
            "location": "708/TALK",
            "narrator": "アーヤ",
            "text": "この数分で",
            "zh": "在这短短几分钟里",
            "narrator_zh": "绫水"
        },
        {
            "location": "709/TALK",
            "narrator": "アーヤ",
            "text": "つばめとの距離",
            "zh": "我和燕之间的距离",
            "narrator_zh": "绫水"
        },
        {
            "location": "710/TALK",
            "narrator": "アーヤ",
            "text": "グッと縮まった気がする",
            "zh": "好像一下子拉近了",
            "narrator_zh": "绫水"
        },
        {
            "location": "712/SEL",
            "narrator": "",
            "text": "それはよかった",
            "zh": "那真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "713/ACT",
            "narrator": "",
            "text": "それはよかった",
            "zh": "那真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "715/TALK",
            "narrator": "アーヤ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "717/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう",
            "zh": "谢谢",
            "narrator_zh": "绫水"
        },
        {
            "location": "718/TALK",
            "narrator": "アーヤ",
            "text": "多分",
            "zh": "我想大概",
            "narrator_zh": "绫水"
        },
        {
            "location": "719/TALK",
            "narrator": "アーヤ",
            "text": "$handle$が何かしたんじゃないかなって",
            "zh": "是不是$handle$做了什么呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "720/TALK",
            "narrator": "アーヤ",
            "text": "そう思ったから声かけたの",
            "zh": "因为这么想才找你搭话的",
            "narrator_zh": "绫水"
        },
        {
            "location": "722/SEL",
            "narrator": "",
            "text": "ご想像にお任せします",
            "zh": "请任凭你想象",
            "narrator_zh": ""
        },
        {
            "location": "723/ACT",
            "narrator": "",
            "text": "ご想像にお任せします",
            "zh": "请任凭你想象",
            "narrator_zh": ""
        },
        {
            "location": "725/TALK",
            "narrator": "アーヤ",
            "text": "ええ",
            "zh": "嗯",
            "narrator_zh": "绫水"
        },
        {
            "location": "726/TALK",
            "narrator": "アーヤ",
            "text": "そうするわ",
            "zh": "那我就尽情想象咯",
            "narrator_zh": "绫水"
        },
        {
            "location": "748/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【09 パーフェクトイエロー】",
            "zh": "【09 完美之黄】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
