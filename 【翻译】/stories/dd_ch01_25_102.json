    "entry": [
        {
            "location": "509/SCENARIO",
            "narrator": "",
            "text": "逃げるも時には役に立つ",
            "zh": "逃跑有时也有用",
            "narrator_zh": ""
        },
        {
            "location": "524/TALK",
            "narrator": "つばめ",
            "text": "…うん。",
            "zh": "……嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "537/TALK",
            "narrator": "つばめ",
            "text": "ぁたし決めた",
            "zh": "我决定了",
            "narrator_zh": "燕"
        },
        {
            "location": "538/TALK",
            "narrator": "つばめ",
            "text": "掃除用具入れに隠れることにする",
            "zh": "决定躲进清洁柜",
            "narrator_zh": "燕"
        },
        {
            "location": "540/SEL",
            "narrator": "",
            "text": "やめて",
            "zh": "别这样",
            "narrator_zh": ""
        },
        {
            "location": "541/SEL",
            "narrator": "",
            "text": "すぐにそこを出て",
            "zh": "马上从那里出来",
            "narrator_zh": ""
        },
        {
            "location": "542/SEL",
            "narrator": "",
            "text": "デバッグしてないよこれ",
            "zh": "这个没调试过呀",
            "narrator_zh": ""
        },
        {
            "location": "543/SEL",
            "narrator": "",
            "text": "自分で選択肢作りたい！！！！！",
            "zh": "我想自己做选项！！！！！",
            "narrator_zh": ""
        },
        {
            "location": "544/SEL",
            "narrator": "",
            "text": "それが正解",
            "zh": "这就是正确答案",
            "narrator_zh": ""
        },
        {
            "location": "545/ACT",
            "narrator": "",
            "text": "つばめはかわいいなあ",
            "zh": "燕好可爱呀",
            "narrator_zh": ""
        },
        {
            "location": "546/TALK",
            "narrator": "つばめ",
            "text": "もう",
            "zh": "真是的",
            "narrator_zh": "燕"
        },
        {
            "location": "548/TALK",
            "narrator": "つばめ",
            "text": "なんでそうなるの",
            "zh": "为什么会变成这样",
            "narrator_zh": "燕"
        },
        {
            "location": "549/ACT",
            "narrator": "",
            "text": "今度イチゴ狩りに行こうよ",
            "zh": "下次去摘草莓吧",
            "narrator_zh": ""
        },
        {
            "location": "550/TALK",
            "narrator": "つばめ",
            "text": "ぇ",
            "zh": "哎",
            "narrator_zh": "燕"
        },
        {
            "location": "552/TALK",
            "narrator": "つばめ",
            "text": "もぅ夏だし",
            "zh": "已经是夏天了呀",
            "narrator_zh": "燕"
        },
        {
            "location": "553/TALK",
            "narrator": "つばめ",
            "text": "やってなぃょ？",
            "zh": "没有在办的呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "554/ACT",
            "narrator": "",
            "text": "カプドラどこまで進んだ？",
            "zh": "卡普多拉打到哪了？",
            "narrator_zh": ""
        },
        {
            "location": "555/TALK",
            "narrator": "つばめ",
            "text": "最近は",
            "zh": "最近",
            "narrator_zh": "燕"
        },
        {
            "location": "556/TALK",
            "narrator": "つばめ",
            "text": "ちょとお休みしてるんだ",
            "zh": "稍微休息一下",
            "narrator_zh": "燕"
        },
        {
            "location": "557/ACT",
            "narrator": "",
            "text": "髪飾りずれてるよ",
            "zh": "发饰歪了呀",
            "narrator_zh": ""
        },
        {
            "location": "558/TALK",
            "narrator": "つばめ",
            "text": "ぁ",
            "zh": "啊",
            "narrator_zh": "燕"
        },
        {
            "location": "559/TALK",
            "narrator": "つばめ",
            "text": "走ったからかな？",
            "zh": "是因为跑了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "561/TALK",
            "narrator": "つばめ",
            "text": "直さなきゃ",
            "zh": "得整理一下",
            "narrator_zh": "燕"
        },
        {
            "location": "562/ACT",
            "narrator": "",
            "text": "それが正解",
            "zh": "这就是正确答案",
            "narrator_zh": ""
        },
        {
            "location": "563/TALK",
            "narrator": "つばめ",
            "text": "ぅん",
            "zh": "嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "564/TALK",
            "narrator": "つばめ",
            "text": "$handle1$に",
            "zh": "问了$handle1$",
            "narrator_zh": "燕"
        },
        {
            "location": "565/TALK",
            "narrator": "つばめ",
            "text": "聞いてよかった",
            "zh": "真是太好了",
            "narrator_zh": "燕"
        },
        {
            "location": "580/TALK",
            "narrator": "つばめ",
            "text": "……狭いなあ…。",
            "zh": "……好窄呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "581/TALK",
            "narrator": "つばめ",
            "text": "でもここだったら\n人が隠れてるって\n思わないよね？",
            "zh": "不过这里的话\n不会想到\n有人躲着吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "582/SEL",
            "narrator": "",
            "text": "絶対バレるって",
            "zh": "绝对会暴露的",
            "narrator_zh": ""
        },
        {
            "location": "583/SEL",
            "narrator": "",
            "text": "さっきから選択肢がおかしいんだ",
            "zh": "从刚才起选项就很奇怪",
            "narrator_zh": ""
        },
        {
            "location": "584/SEL",
            "narrator": "",
            "text": "大丈夫、安心して",
