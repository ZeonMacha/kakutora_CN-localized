{
    "dir": "chap00/daydra/spev_ch01_091_02.js",
    "type": "",
    "info": {
        "story_id": "91022",
        "cid": "",
        "title": "シャッツキステリンク",
        "sub_title": "彼女がメイドに着替えたら",
        "title_zh": "宝箱链接",
        "sub_title_zh": "当她换上女仆装"
    },
    "entry": [
        {
            "location": "238/SCENARIO",
            "narrator": "",
            "text": "トライナリー×シャッツキステ",
            "zh": "三重奏×宝箱",
            "narrator_zh": ""
        },
        {
            "location": "259/TALK",
            "narrator": "メイド",
            "text": "――ご注文、承りました。\n少々お待ちください。",
            "zh": "——点单收到了。\n请稍等。",
            "narrator_zh": "女仆"
        },
        {
            "location": "261/TALK",
            "narrator": "神楽",
            "text": "はい、\nありがとうございます。",
            "zh": "好的，\n谢谢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "265/TALK",
            "narrator": "神楽",
            "text": "…素敵だなぁ。",
            "zh": "……真好啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "267/TALK",
            "narrator": "神楽",
            "text": "もし、みんなで\nこのお店で働けたら、\nとっても楽しいかも！",
            "zh": "要是大家\n都能在这家店工作，\n也许会很开心！",
            "narrator_zh": "神乐"
        },
        {
            "location": "268/TALK",
            "narrator": "神楽",
            "text": "例えば――",
            "zh": "比如说——",
            "narrator_zh": "神乐"
        },
        {
            "location": "273/DIALOG",
            "narrator": "",
            "text": "<size=35>シャッツキステ・お給仕レッスン①</size>\n\n\n<size=50>- 逢瀬つばめのCase. -</size>\n",
            "zh": "<size=35>宝箱·上菜练习①</size>\n\n\n<size=50>- 逢濑燕的Case. -</size>\n",
            "narrator_zh": ""
        },
        {
            "location": "293/TALK",
            "narrator": "メイド",
            "text": "それじゃあつばめちゃん。\nこれをテーブルまで\n運んでもらえるかしら？",
            "zh": "那么燕。\n能把这个\n端到桌子那边吗？",
            "narrator_zh": "女仆"
        },
        {
            "location": "295/TALK",
            "narrator": "つばめ",
            "text": "わかりました！",
            "zh": "我知道了！",
            "narrator_zh": "燕"
        },
        {
            "location": "296/TALK",
            "narrator": "メイド",
            "text": "ちょっと重いから、\nくれぐれも気を付けて――",
            "zh": "有点重，\n千万小心——",
            "narrator_zh": "女仆"
        },
        {
            "location": "304/TALK",
            "narrator": "つばめ",
            "text": "わわっ！？",
            "zh": "哇哇！？",
            "narrator_zh": "燕"
        },
        {
            "location": "305/TALK",
            "narrator": "メイド",
            "text": "つばめちゃん、危ない！",
            "zh": "燕，危险！",
            "narrator_zh": "女仆"
        },
        {
            "location": "306/TALK",
            "narrator": "つばめ",
            "text": "あっ、とっ、とっ…。",
            "zh": "啊，踉、踉……",
            "narrator_zh": "燕"
        },
        {
            "location": "309/TALK",
            "narrator": "つばめ",
            "text": "…ふぅー。\nだ、大丈夫です、\n転びませんでした！",
            "zh": "……呼。\n没、没事，\n没摔倒！",
            "narrator_zh": "燕"
        },
        {
            "location": "310/TALK",
            "narrator": "メイド",
            "text": "よかった…。\n足元に気を付けて\n運んでね？",
            "zh": "太好了……\n看着脚下\n端过去哦？",
            "narrator_zh": "女仆"
        },
        {
            "location": "312/TALK",
            "narrator": "つばめ",
            "text": "わ、わかりました…。",
            "zh": "知、知道了……",
            "narrator_zh": "燕"
        },
        {
            "location": "316/TALK",
            "narrator": "メイド",
            "text": "ほっ…今度はちゃんと\n運べたみたい…。",
            "zh": "呼……这次\n好像好好端过去了……",
            "narrator_zh": "女仆"
        },
        {
            "location": "317/TALK",
            "narrator": "メイド",
            "text": "って、あら？",
            "zh": "咦，哎呀？",
            "narrator_zh": "女仆"
        },
        {
            "location": "320/TALK",
            "narrator": "つばめ",
            "text": "あ、あの…。",
            "zh": "那、那个……",
            "narrator_zh": "燕"
        },
        {
            "location": "322/TALK",
            "narrator": "つばめ",
            "text": "どのテーブルに\n運ぶか聞き忘れてて…。",
            "zh": "忘了问\n端到哪张桌子……",
            "narrator_zh": "燕"
        },
        {
            "location": "324/TALK",
            "narrator": "メイド",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "女仆"
        },
        {
            "location": "344/TALK",
            "narrator": "神楽",
            "text": "…つ、つばめさんには、\nお給仕のお仕事は\n合わないかも…。",
            "zh": "……燕的话，\n上菜这份工作\n也许不合适……",
            "narrator_zh": "神乐"
        },
        {
            "location": "345/TALK",
            "narrator": "神楽",
            "text": "…他の人達だったら、\nどうなるかなぁ…？",
            "zh": "……其他人的话，\n会变成什么样呢……？",
            "narrator_zh": "神乐"
        },
        {
            "location": "346/TALK",
            "narrator": "神楽",
            "text": "う～ん…。",
            "zh": "嗯……",
            "narrator_zh": "神乐"
        },
        {
            "location": "347/TALK",
            "narrator": "神楽",
            "text": "もし、アーヤさんが\nシャッツキステで\n働いてたら――",
            "zh": "要是绫水\n在宝箱\n工作的话——",
            "narrator_zh": "神乐"
        },
        {
            "location": "353/DIALOG",
            "narrator": "",
            "text": "<size=35>シャッツキステ・お給仕レッスン②</size>\n\n\n<size=50>- 國政綾水のCase. -</size>\n",
            "zh": "<size=35>宝箱·上菜练习②</size>\n\n\n<size=50>- 国政绫水的Case. -</size>\n",
            "narrator_zh": ""
        },
        {
            "location": "369/TALK",
            "narrator": "メイド",
            "text": "ふう…今日は大勢の\n旅人さまがいらっしゃい\nますね…。",
            "zh": "呼……今天来了\n好多\n旅人……",
            "narrator_zh": "女仆"
        },
        {
            "location": "371/TALK",
            "narrator": "アーヤ",
            "text": "いつも、こんなに\n忙しいんですか？",
            "zh": "一直都\n这么忙吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "373/TALK",
            "narrator": "メイド",
            "text": "日によりますね。\n賑やかな時もあれば、\n静かな時もありますし。",
            "zh": "看日子。\n有热闹的时候，\n也有安静的时候。",
            "narrator_zh": "女仆"
        },
        {
            "location": "374/TALK",
            "narrator": "メイド",
            "text": "それより、大丈夫？\nアーヤさん、まだ\n入ったばかりなのに…。",
            "zh": "比起那个，没事吧？\n绫水，才刚\n进来……",
            "narrator_zh": "女仆"
        },
        {
            "location": "376/TALK",
            "narrator": "アーヤ",
            "text": "はい、平気です。\n部活で鍛えられたので、\n体力には自信あるんです。",
            "zh": "没事。\n社团锻炼过，\n体力我有自信。",
            "narrator_zh": "绫水"
        },
        {
            "location": "377/TALK",
            "narrator": "メイド",
            "text": "頼もしいわ。",
            "zh": "真可靠。",
            "narrator_zh": "女仆"
        },
        {
            "location": "379/TALK",
            "narrator": "メイド",
            "text": "あっ、旅人さまが\nお呼びですね。\nお願いできますか？",
            "zh": "啊，旅人\n在叫了。\n能拜托你吗？",
            "narrator_zh": "女仆"
        },
        {
            "location": "380/TALK",
            "narrator": "アーヤ",
            "text": "はい、わかり――",
            "zh": "好，我知——",
            "narrator_zh": "绫水"
        },
        {
            "location": "389/TALK",
            "narrator": "アーヤ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "391/TALK",
            "narrator": "メイド",
            "text": "あ、アーヤさん。\n仕事中はスマホの電源は\n切っておいてください。",
            "zh": "绫、绫水。\n工作的时候请把手机\n关掉。",
            "narrator_zh": "女仆"
        },
        {
            "location": "392/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "绫水"
        },
        {
            "location": "393/TALK",
            "narrator": "メイド",
            "text": "あ、あの…。",
            "zh": "那、那个……",
            "narrator_zh": "女仆"
        },
        {
            "location": "397/TALK",
            "narrator": "アーヤ",
            "text": "すみません。\n一身上の都合により、\n早退させていただきます。",
            "zh": "对不起。\n因个人原因，\n我先回去了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "398/TALK",
            "narrator": "メイド",
            "text": "えぇっ！？\nそ、そんな急に困ります！",
            "zh": "诶诶！？\n这、这么突然会为难的！",
            "narrator_zh": "女仆"
        },
        {
            "location": "399/TALK",
            "narrator": "アーヤ",
            "text": "本当にごめんなさい。\nでも、公務なんです。\n失礼します！",
            "zh": "真的对不起。\n可是这是公务。\n失陪了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "407/TALK",
            "narrator": "メイド",
            "text": "こ、公務って！？\n意味がわかりませんよー！",
            "zh": "公、公务！？\n我听不懂呀！",
            "narrator_zh": "女仆"
        },
        {
            "location": "426/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "神乐"
        },
        {
            "location": "428/TALK",
            "narrator": "神楽",
            "text": "…アーヤさんの\n真面目さから考えて、\n確実にそうなるなぁ…。",
            "zh": "……以绫水的\n认真来想，\n肯定会变成这样……",
            "narrator_zh": "神乐"
        },
        {
            "location": "429/TALK",
            "narrator": "神楽",
            "text": "う～ん…もしかしたら、\nみんなメイド喫茶には\n向いてないのかも…。",
            "zh": "嗯……也许，\n大家都不适合\n女仆咖啡店……",
            "narrator_zh": "神乐"
        },
        {
            "location": "430/TALK",
            "narrator": "神楽",
            "text": "あっ、でもガブちゃんなら\n喜びそう！",
            "zh": "啊，不过加布的话\n好像会高兴！",
            "narrator_zh": "神乐"
        },
        {
            "location": "431/TALK",
            "narrator": "神楽",
            "text": "それに、メイド姿も\n絶対に似合うと思うし――",
            "zh": "而且，女仆装\n也绝对合适——",
            "narrator_zh": "神乐"
        },
        {
            "location": "437/DIALOG",
            "narrator": "",
            "text": "<size=35>シャッツキステ・お給仕レッスン③</size>\n\n\n<size=50>- ガブリエラのCase. -</size>\n",
            "zh": "<size=35>宝箱·上菜练习③</size>\n\n\n<size=50>- 加布里埃拉的Case. -</size>\n",
            "narrator_zh": ""
        },
        {
            "location": "457/TALK",
            "narrator": "ガブリエラ",
            "text": "ようこそ\nおいでくださいました。\nありがとうございました。",
            "zh": "欢迎\n光临。\n谢谢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "458/TALK",
            "narrator": "メイド",
            "text": "じゃあ、ご注文を\n受けた時は？",
            "zh": "那么，接单的\n时候呢？",
            "narrator_zh": "女仆"
        },
        {
            "location": "460/TALK",
            "narrator": "ガブリエラ",
            "text": "承りました。\n少々お待ちください。",
            "zh": "收到了。\n请稍等。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "462/TALK",
            "narrator": "ガブリエラ",
            "text": "…ちゃんと\nできてるかしら？",
            "zh": "……我做得\n对吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "463/TALK",
            "narrator": "メイド",
            "text": "完璧です。\n百点満点の受け答えよ。",
            "zh": "完美。\n应答是满分。",
            "narrator_zh": "女仆"
        },
        {
            "location": "465/TALK",
            "narrator": "ガブリエラ",
            "text": "そう…まあ、これくらい\nマニュアル読めば簡単に\nできることだけど。",
            "zh": "这样……嘛，这种程度\n看过手册就能\n轻易做到。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "466/TALK",
            "narrator": "メイド",
            "text": "最初のうちは旅人さまの\n前で実際に言うの、\n結構緊張するものよ？",
            "zh": "一开始在旅人面前\n真正说出来，\n还是会紧张的哦？",
            "narrator_zh": "女仆"
        },
        {
            "location": "467/TALK",
            "narrator": "メイド",
            "text": "…でも、せっかくだから\n次に入ってくる旅人さまの\n案内、任せていいかしら？",
            "zh": "……不过，难得的机会，\n下一位进来的旅人，\n交给你可以吗？",
            "narrator_zh": "女仆"
        },
        {
            "location": "470/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、いきなり！？",
            "zh": "诶，突然！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "471/TALK",
            "narrator": "メイド",
            "text": "ふふっ、やっぱり\n緊張しちゃってる？",
            "zh": "呵呵，果然\n紧张了？",
            "narrator_zh": "女仆"
        },
        {
            "location": "473/TALK",
            "narrator": "ガブリエラ",
            "text": "へ、平気よ！\nそれじゃ、次に誰か\n入ってきたら…。",
            "zh": "我、我没事！\n那么，下次有人\n进来的话……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、ようこそおいで――",
            "zh": "啊，欢迎光——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "483/TALK",
            "narrator": "男子高校生",
            "text": "どうも。\nあの、一人なんですけど。",
            "zh": "你好。\n那个，我一个人。",
            "narrator_zh": "男高中生"
        },
        {
            "location": "485/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "487/TALK",
            "narrator": "メイド",
            "text": "やっぱり緊張してる…。\nガブリエラちゃん、\n挨拶して。",
            "zh": "果然在紧张……\n加布里埃拉，\n打招呼。",
            "narrator_zh": "女仆"
        },
        {
            "location": "488/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "489/TALK",
            "narrator": "男子高校生",
            "text": "あ、あの…すみません。\n一名なんですけど…。",
            "zh": "那、那个……对不起。\n一位……",
            "narrator_zh": "男高中生"
        },
        {
            "location": "491/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "493/TALK",
            "narrator": "メイド",
            "text": "こ、ここまで\n緊張しちゃうなんて…。",
            "zh": "紧、紧张到\n这个地步……",
            "narrator_zh": "女仆"
        },
        {
            "location": "513/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "神乐"
        },
        {
            "location": "514/TALK",
            "narrator": "神楽",
            "text": "男の人相手っていうのを\n考えると…ダメかなぁ…。",
            "zh": "一想到对方是男生……\n就不行了吧……",
            "narrator_zh": "神乐"
        },
        {
            "location": "515/TALK",
            "narrator": "神楽",
            "text": "あとは、みやびさんかぁ。\n妄想でも浮かんでこない\nけど…。",
            "zh": "剩下就是雅了。\n幻想里也浮现\n不出来……",
            "narrator_zh": "神乐"
        },
        {
            "location": "516/TALK",
            "narrator": "神楽",
            "text": "う～ん…みやびさんが\nお給仕…シャッツキステで\nお給仕…。",
            "zh": "嗯……雅\n上菜……在宝箱\n上菜……",
            "narrator_zh": "神乐"
        },
        {
            "location": "522/DIALOG",
            "narrator": "",
            "text": "<size=35>シャッツキステ・お給仕レッスン④</size>\n\n\n<size=50>- 恋ヶ崎みやびのCase. -</size>\n",
            "zh": "<size=35>宝箱·上菜练习④</size>\n\n\n<size=50>- 恋之崎雅的Case. -</size>\n",
            "narrator_zh": ""
        },
        {
            "location": "539/TALK",
            "narrator": "みやび",
            "text": "ご注文承りました。\n少々お待ちください。",
            "zh": "点单收到了。\n请稍等。",
            "narrator_zh": "雅"
        },
        {
            "location": "542/TALK",
            "narrator": "みやび",
            "text": "メイドさーん。\n注文受けてきたがですよ。",
            "zh": "女仆——。\n点单我接下来了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "544/TALK",
            "narrator": "メイド",
            "text": "ありがとう。\nこっちで見てたけど、\n完璧なお給仕だったわ。",
            "zh": "谢谢。\n我在这边看着，\n上菜很完美。",
            "narrator_zh": "女仆"
        },
        {
            "location": "545/TALK",
            "narrator": "みやび",
            "text": "安心しました。\nうち、お給仕なんて\nやったことないですき。",
            "zh": "我放心了。\n我呀，上菜这种事\n没做过啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "546/TALK",
            "narrator": "みやび",
            "text": "滑って転んで皿割って、\n宙を舞ったケーキが\n旅人さまの頭に直撃。",
            "zh": "脚一滑摔倒打碎盘子，\n飞到半空的蛋糕\n正中旅人的头。",
            "narrator_zh": "雅"
        },
        {
            "location": "547/TALK",
            "narrator": "みやび",
            "text": "なんてことにならんよう、\n頑張った甲斐があるって\nもんですよ。",
            "zh": "为了别变成那样，\n这下算没白\n努力。",
            "narrator_zh": "雅"
        },
        {
            "location": "548/TALK",
            "narrator": "メイド",
            "text": "あ、あはは…。\n本当、そうならなくて\n安心したわ…。",
            "zh": "啊、啊哈哈……\n真的没变成那样，\n我放心了……",
            "narrator_zh": "女仆"
        },
        {
            "location": "550/TALK",
            "narrator": "みやび",
            "text": "…ところで、\nそろそろうちもアレやって\nえいですか？",
            "zh": "……对了，\n我也差不多可以做那个了，\n要得吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "551/TALK",
            "narrator": "メイド",
            "text": "アレ？\nアレって、なに？",
            "zh": "那个？\n那个是什么？",
            "narrator_zh": "女仆"
        },
        {
            "location": "554/TALK",
            "narrator": "みやび",
            "text": "ゾンビですよ。",
            "zh": "是僵尸。",
            "narrator_zh": "雅"
        },
        {
            "location": "556/TALK",
            "narrator": "メイド",
            "text": "…………はい？",
            "zh": "…………什么？",
            "narrator_zh": "女仆"
        },
        {
            "location": "557/TALK",
            "narrator": "みやび",
            "text": "ブログで見かけてから、\nずーっと面白そうやと\n思うてたがですよ。",
            "zh": "从博客上看到之后，\n就一直觉得蛮有意思\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "558/TALK",
            "narrator": "みやび",
            "text": "ゾンビになった\nメイドさんっちゅう\n格好でお給仕…。",
            "zh": "打扮成变成僵尸的\n女仆那样\n来上菜……",
            "narrator_zh": "雅"
        },
        {
            "location": "559/TALK",
            "narrator": "みやび",
            "text": "それ楽しみにしてたき、\nお給仕頑張れたんですよ。",
            "zh": "就因为盼着那个，\n上菜才撑下来的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "560/TALK",
            "narrator": "メイド",
            "text": "え、えっと…残念だけど、\nアレはいつもなってる\nわけじゃなくて…。",
            "zh": "那、那个……很遗憾，\n那个并不是一直\n都有的……",
            "narrator_zh": "女仆"
        },
        {
            "location": "561/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "雅"
        },
        {
            "location": "562/TALK",
            "narrator": "メイド",
            "text": "楽しみにしてたのに\n申し訳ないけど、\nそういうことだから…。",
            "zh": "你那么期待，\n对不起，\n就是这么回事……",
            "narrator_zh": "女仆"
        },
        {
            "location": "565/TALK",
            "narrator": "みやび",
            "text": "…今、うちの心が\nゾンビになったぞね。",
            "zh": "……这阵我的心\n变成僵尸了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "566/TALK",
            "narrator": "メイド",
            "text": "そもそも、うちは\nそういうコンセプトの\nカフェじゃありません！",
            "zh": "说到底，我们\n不是那种主题的\n咖啡店！",
            "narrator_zh": "女仆"
        },
        {
            "location": "584/TALK",
            "narrator": "神楽",
            "text": "…かなりぶっ飛んだ\n妄想になっちゃったけど、\nありそうかも…。",
            "zh": "……虽然变成了\n相当离谱的幻想，\n但好像真会发生……",
            "narrator_zh": "神乐"
        },
        {
            "location": "586/TALK",
            "narrator": "神楽",
            "text": "はぁ…妄想とはいえ、\nみんなダメダメだなぁ…。",
            "zh": "唉……就算是幻想，\n大家也都不行啊……",
            "narrator_zh": "神乐"
        },
        {
            "location": "587/TALK",
            "narrator": "神楽",
            "text": "多分、私一人で\nお給仕した方が、\n四人以上に働けそうだし。",
            "zh": "大概我一个人\n上菜，\n都能顶她们四个以上。",
            "narrator_zh": "神乐"
        },
        {
            "location": "589/TALK",
            "narrator": "神楽",
            "text": "…でも、せっかく\nメイド服を着るなら、\nやっぱり――",
            "zh": "……可是，难得\n穿女仆装的话，\n果然还是——",
            "narrator_zh": "神乐"
        },
        {
            "location": "595/DIALOG",
            "narrator": "",
            "text": "<size=35>シャッツキステ・お給仕レッスン⑤</size>\n\n\n<size=50>- 卯月神楽のCase. -</size>\n",
            "zh": "<size=35>宝箱·上菜练习⑤</size>\n\n\n<size=50>- 卯月神乐的Case. -</size>\n",
            "narrator_zh": ""
        },
        {
            "location": "612/TALK",
            "narrator": "神楽",
            "text": "お紅茶、\nお待たせいたしましたぁ。",
            "zh": "红茶，\n久等了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "613/TALK",
            "narrator": "神楽",
            "text": "――はい。\nありがとうございます！",
            "zh": "——好的。\n谢谢！",
            "narrator_zh": "神乐"
        },
        {
            "location": "614/TALK",
            "narrator": "神楽",
            "text": "では、ごゆっくりどうぞ。",
            "zh": "那么，请慢慢享用。",
            "narrator_zh": "神乐"
        },
        {
            "location": "616/TALK",
            "narrator": "神楽",
            "text": "えっと、次は…。",
            "zh": "那个，接下来……",
            "narrator_zh": "神乐"
        },
        {
            "location": "618/TALK",
            "narrator": "メイド",
            "text": "さすがは神楽ちゃん。",
            "zh": "不愧是神乐。",
            "narrator_zh": "女仆"
        },
        {
            "location": "619/TALK",
            "narrator": "メイド",
            "text": "よく来てくれていた\nだけあって、\n完璧なお給仕よ。",
            "zh": "你常来，\n就凭这一点，\n上菜很完美。",
            "narrator_zh": "女仆"
        },
        {
            "location": "622/TALK",
            "narrator": "神楽",
            "text": "ふふっ、このお店は\nお客として来てた時から、\n大好きなお店なんです。",
            "zh": "呵呵，这家店\n从我当客人的时候起，\n就是我很喜欢的店。",
            "narrator_zh": "神乐"
        },
        {
            "location": "625/TALK",
            "narrator": "神楽",
            "text": "だから、他の旅人さまにも\nこのお店をたくさん好きに\nなってもらいたいんです。",
            "zh": "所以，我也希望\n其他旅人\n多多喜欢这家店。",
            "narrator_zh": "神乐"
        },
        {
            "location": "626/TALK",
            "narrator": "メイド",
            "text": "神楽ちゃん…。",
            "zh": "神乐……",
            "narrator_zh": "女仆"
        },
        {
            "location": "627/TALK",
            "narrator": "神楽",
            "text": "ふふっ…、\n大好きな場所で働けて、\n本当に嬉しくて――",
            "zh": "呵呵……\n能在喜欢的地方工作，\n真的很高兴——",
            "narrator_zh": "神乐"
        },
        {
            "location": "634/TALK",
            "narrator": "メイド",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "女仆"
        },
        {
            "location": "637/TALK",
            "narrator": "神楽",
            "text": "あっ！",
            "zh": "啊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "640/TALK",
            "narrator": "メイド",
            "text": "ちょ、神楽ちゃん！\nどうしてスカートの中から\n銃が落ちてくるの！？",
            "zh": "等、神乐！\n为什么裙子里面\n会掉出枪！？",
            "narrator_zh": "女仆"
        },
        {
            "location": "642/TALK",
            "narrator": "神楽",
            "text": "ご、ごめんなさい！\nでもほら、ラノベとかで\nあるじゃないですか。",
            "zh": "对、对不起！\n可是你看，轻小说里\n不就有吗。",
            "narrator_zh": "神乐"
        },
        {
            "location": "644/TALK",
            "narrator": "神楽",
            "text": "メイドさんはスカートの\n内側に銃やナイフを\n沢山隠し持ってて…。",
            "zh": "女仆会在裙子\n内侧藏很多\n枪和刀……",
            "narrator_zh": "神乐"
        },
        {
            "location": "645/TALK",
            "narrator": "神楽",
            "text": "…皆さんも、\nなにか持っては\nいるんですよね？",
            "zh": "……大家也\n带着什么\n吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "646/TALK",
            "narrator": "メイド",
            "text": "そうそう！\nスカートの中に――",
            "zh": "对对！\n裙子里面——",
            "narrator_zh": "女仆"
        },
        {
            "location": "647/TALK",
            "narrator": "メイド",
            "text": "って！\nこのカフェに戦う相手\nなんていませんから！",
            "zh": "不对！\n这家咖啡店\n又没有要打的对手！",
            "narrator_zh": "女仆"
        },
        {
            "location": "648/TALK",
            "narrator": "神楽",
            "text": "そ、そんなぁ…。",
            "zh": "怎、怎么这样……",
            "narrator_zh": "神乐"
        },
        {
            "location": "668/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "神乐"
        },
        {
            "location": "671/TALK",
            "narrator": "メイド",
            "text": "お待たせいたしました。\nお紅茶とスコーンです。",
            "zh": "久等了。\n红茶和司康。",
            "narrator_zh": "女仆"
        },
        {
            "location": "674/TALK",
            "narrator": "神楽",
            "text": "あ、はい…。",
            "zh": "啊，好的……",
            "narrator_zh": "神乐"
        },
        {
            "location": "675/TALK",
            "narrator": "メイド",
            "text": "以上でよろしいですか？",
            "zh": "这样就好了吗？",
            "narrator_zh": "女仆"
        },
        {
            "location": "676/TALK",
            "narrator": "神楽",
            "text": "はい…それと…。",
            "zh": "好的……还有……",
            "narrator_zh": "神乐"
        },
        {
            "location": "677/TALK",
            "narrator": "神楽",
            "text": "私の妄想の中とはいえ、\nメイドさんや館内を\n騒がしくしてしまい…。",
            "zh": "虽然是在我的幻想里，\n还是吵到了女仆\n和店里……",
            "narrator_zh": "神乐"
        },
        {
            "location": "681/TALK",
            "narrator": "神楽",
            "text": "…すみませんでした。",
            "zh": "……对不起。",
            "narrator_zh": "神乐"
        },
        {
            "location": "682/TALK",
            "narrator": "メイド",
            "text": "…はい？",
            "zh": "……什么？",
            "narrator_zh": "女仆"
        }
    ]
}
