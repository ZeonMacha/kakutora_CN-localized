    "entry": [
        {
            "location": "291/SCENARIO",
            "narrator": "",
            "text": "アイリッシュコーヒー",
            "zh": "爱尔兰咖啡",
            "narrator_zh": ""
        },
        {
            "location": "293/TALK",
            "narrator": "アーヤ",
            "text": "そうね、それじゃ",
            "zh": "是啊，那就",
            "narrator_zh": "绫水"
        },
        {
            "location": "295/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと変わり種を",
            "zh": "说个稍微特别点的吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "296/TALK",
            "narrator": "アーヤ",
            "text": "それね、",
            "zh": "那个呀，",
            "narrator_zh": "绫水"
        },
        {
            "location": "297/TALK",
            "narrator": "アーヤ",
            "text": "完全に大人の飲み物なのよね",
            "zh": "完全是大人的饮品哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "298/TALK",
            "narrator": "アーヤ",
            "text": "当たり前よね、お酒なんだし",
            "zh": "也是理所当然的，毕竟是酒嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "300/SEL",
            "narrator": "",
            "text": "なに？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "301/SEL",
            "narrator": "",
            "text": "アーヤはＯＫってこと？",
            "zh": "意思是绫水可以喝了？",
            "narrator_zh": ""
        },
        {
            "location": "302/SEL",
            "narrator": "",
            "text": "$me$との恋の味だよね",
            "zh": "是和$me$恋爱的味道吧",
            "narrator_zh": ""
        },
        {
            "location": "303/ACT",
            "narrator": "",
            "text": "なに？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "304/TALK",
            "narrator": "アーヤ",
            "text": "ええとね",
            "zh": "呃那个",
            "narrator_zh": "绫水"
        },
        {
            "location": "305/ACT",
            "narrator": "",
            "text": "アーヤはＯＫってこと？",
            "zh": "意思是绫水可以喝了？",
            "narrator_zh": ""
        },
        {
            "location": "306/TALK",
            "narrator": "アーヤ",
            "text": "もちろん！",
            "zh": "当然！",
            "narrator_zh": "绫水"
        },
        {
            "location": "307/ACT",
            "narrator": "",
            "text": "$me$との恋の味だよね",
            "zh": "是和$me$恋爱的味道吧",
            "narrator_zh": ""
        },
        {
            "location": "308/TALK",
            "narrator": "アーヤ",
            "text": "あら素敵",
            "zh": "哎呀真不错",
            "narrator_zh": "绫水"
        },
        {
            "location": "309/TALK",
            "narrator": "アーヤ",
            "text": "そういうのもいいわね",
            "zh": "那种也不赖呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "310/TALK",
            "narrator": "アーヤ",
            "text": "でも今は",
            "zh": "不过现在",
            "narrator_zh": "绫水"
        },
        {
            "location": "311/TALK",
            "narrator": "アーヤ",
            "text": "残念だけど",
            "zh": "虽然遗憾",
            "narrator_zh": "绫水"
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "違う話なの(・・。)ゞ",
            "zh": "说的不是那个啦(・・。)ゞ",
            "narrator_zh": "绫水"
        },
        {
            "location": "314/TALK",
            "narrator": "アーヤ",
            "text": "アイリッシュコーヒーって",
            "zh": "爱尔兰咖啡这款",
            "narrator_zh": "绫水"
        },
        {
            "location": "315/TALK",
            "narrator": "アーヤ",
            "text": "カクテル知ってる？",
            "zh": "鸡尾酒你知道吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "317/SEL",
            "narrator": "",
            "text": "知らないし",
            "zh": "我不知道啊",
            "narrator_zh": ""
        },
        {
            "location": "318/SEL",
            "narrator": "",
            "text": "あれかー",
            "zh": "是那个啊——",
            "narrator_zh": ""
        },
        {
            "location": "319/SEL",
            "narrator": "",
            "text": "ホットカクテルだね",
            "zh": "热鸡尾酒对吧",
            "narrator_zh": ""
        },
        {
            "location": "320/ACT",
            "narrator": "",
            "text": "知らないし",
            "zh": "我不知道啊",
            "narrator_zh": ""
        },
        {
            "location": "321/TALK",
            "narrator": "アーヤ",
            "text": "そうなのね",
            "zh": "这样啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "322/ACT",
            "narrator": "",
            "text": "あれかー",
            "zh": "是那个啊——",
            "narrator_zh": ""
        },
        {
            "location": "323/TALK",
            "narrator": "アーヤ",
            "text": "適当なこと",
            "zh": "你该不会在",
            "narrator_zh": "绫水"
        },
        {
            "location": "324/TALK",
            "narrator": "アーヤ",
            "text": "言ってない？",
            "zh": "随便瞎蒙吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "325/ACT",
            "narrator": "",
            "text": "ホットカクテルだね",
            "zh": "热鸡尾酒对吧",
            "narrator_zh": ""
        },
        {
            "location": "326/TALK",
            "narrator": "アーヤ",
            "text": "そうそう",
            "zh": "对对",
            "narrator_zh": "绫水"
        },
        {
            "location": "327/TALK",
            "narrator": "アーヤ",
            "text": "カクテルなのに",
            "zh": "明明是鸡尾酒",
            "narrator_zh": "绫水"
        },
        {
            "location": "328/TALK",
            "narrator": "アーヤ",
            "text": "ホットなのよね",
            "zh": "却是热的哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "330/TALK",
            "narrator": "アーヤ",
            "text": "上にホイップクリームが",
            "zh": "因为上面盖着一层",
            "narrator_zh": "绫水"
        },
        {
            "location": "331/TALK",
            "narrator": "アーヤ",
            "text": "乗ってるから",
            "zh": "鲜奶油",
            "narrator_zh": "绫水"
        },
        {
            "location": "332/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィが飲んでみたいって",
            "zh": "加维就闹着说",
            "narrator_zh": "绫水"
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "言い出して",
            "zh": "想尝尝看",
            "narrator_zh": "绫水"
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "お酒なのに",
            "zh": "明明是酒来着",
            "narrator_zh": "绫水"
        },
        {
            "location": "336/SEL",
            "narrator": "",
            "text": "ノンアルコールで作れば",
            "zh": "做成无酒精的就好了嘛",
            "narrator_zh": ""
        },
        {
            "location": "337/SEL",
            "narrator": "",
            "text": "大人になるまで我慢って言わなきゃ",
            "zh": "得告诉她忍到成年才行啊",
            "narrator_zh": ""
        },
        {
            "location": "338/ACT",
            "narrator": "",
            "text": "ノンアルコールで作れば",
            "zh": "做成无酒精的就好了嘛",
            "narrator_zh": ""
        },
        {
            "location": "339/TALK",
            "narrator": "アーヤ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "340/TALK",
            "narrator": "アーヤ",
            "text": "それならありかも",
            "zh": "那样的话倒也行",
            "narrator_zh": "绫水"
        },
        {
            "location": "341/TALK",
            "narrator": "アーヤ",
            "text": "作ってあげようかな",
            "zh": "下次做给她试试吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "342/ACT",
            "narrator": "",
            "text": "大人になるまで我慢って言わなきゃ",
            "zh": "得告诉她忍到成年才行啊",
            "narrator_zh": ""
        },
        {
            "location": "343/TALK",
            "narrator": "アーヤ",
            "text": "そうよね",
            "zh": "就是说啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "344/TALK",
            "narrator": "アーヤ",
            "text": "未成年なんだもの",
            "zh": "毕竟还是未成年嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "345/TALK",
            "narrator": "アーヤ",
            "text": "今は無理よね",
            "zh": "现在可不行",
            "narrator_zh": "绫水"
        }
    ]
}
