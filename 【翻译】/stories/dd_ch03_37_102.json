{
    "dir": "chap37/daydra/dd_ch03_37_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "37305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "あたし自身のあたしのユメ＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "我自身的我的梦＜后篇＞"
    },
    "entry": [
        {
            "location": "653/TALK",
            "narrator": "ガブリエラ",
            "text": "運命なんて\n全然ロマンチックじゃ\nないものなのね。",
            "zh": "原来命运这东西，\n一点都不浪漫\n呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "654/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしようもない\n現実と同じなんて\nがっかりだわ。",
            "zh": "和无可奈何的\n现实一模一样，\n真是让人失望啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "656/SEL",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "657/SEL",
            "narrator": "",
            "text": "少し話せる？",
            "zh": "能稍微聊聊吗？",
            "narrator_zh": ""
        },
        {
            "location": "658/SEL",
            "narrator": "",
            "text": "$me$を恨んでる？",
            "zh": "你在怨恨$me$吗？",
            "narrator_zh": ""
        },
        {
            "location": "659/ACT",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "660/TALK",
            "narrator": "ガブリエラ",
            "text": "元気だと思う？",
            "zh": "你看我像很好的样子吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "661/ACT",
            "narrator": "",
            "text": "少し話せる？",
            "zh": "能稍微聊聊吗？",
            "narrator_zh": ""
        },
        {
            "location": "662/TALK",
            "narrator": "ガブリエラ",
            "text": "いいわよ。\n話しても。",
            "zh": "行啊。\n聊聊也无妨。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "663/ACT",
            "narrator": "",
            "text": "$me$を恨んでる？",
            "zh": "你在怨恨$me$吗？",
            "narrator_zh": ""
        },
        {
            "location": "664/TALK",
            "narrator": "ガブリエラ",
            "text": "そう思ったり\nするんだ？",
            "zh": "你居然会\n这么想啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "667/SEL",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "668/SEL",
            "narrator": "",
            "text": "少し話せる？",
            "zh": "能稍微聊聊吗？",
            "narrator_zh": ""
        },
        {
            "location": "669/SEL",
            "narrator": "",
            "text": "$me$を恨んでる？",
            "zh": "你在怨恨$me$吗？",
            "narrator_zh": ""
        },
        {
            "location": "670/ACT",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "671/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね。\n割と元気。",
            "zh": "是啊。\n精神还算不错。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "672/ACT",
            "narrator": "",
            "text": "少し話せる？",
            "zh": "能稍微聊聊吗？",
            "narrator_zh": ""
        },
        {
            "location": "674/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしも少し\n話したかったところよ。",
            "zh": "我正好也想\n和你稍微聊聊呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "675/ACT",
            "narrator": "",
            "text": "$me$を恨んでる？",
            "zh": "你在怨恨$me$吗？",
            "narrator_zh": ""
        },
        {
            "location": "676/TALK",
            "narrator": "ガブリエラ",
            "text": "どうして\nそう思うの？",
            "zh": "为什么\n会这么觉得？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "679/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$は\nこの世界について\n選択をしたけど。",
            "zh": "虽然$handle$\n对这个世界\n做出了选择。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "680/TALK",
            "narrator": "ガブリエラ",
            "text": "それは確定じゃ\nないのよね。",
            "zh": "但那还没有\n最终确定呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "681/SEL",
            "narrator": "",
            "text": "どうなんだろ",
            "zh": "会怎么样呢",
            "narrator_zh": ""
        },
        {
            "location": "682/SEL",
            "narrator": "",
            "text": "ほぼ確定だから",
            "zh": "差不多已经确定了",
            "narrator_zh": ""
        },
        {
            "location": "683/SEL",
            "narrator": "",
            "text": "半々ってとこじゃない",
            "zh": "大概五五开吧",
            "narrator_zh": ""
        },
        {
            "location": "684/ACT",
            "narrator": "",
            "text": "どうなんだろ",
            "zh": "会怎么样呢",
            "narrator_zh": ""
        },
        {
            "location": "685/TALK",
            "narrator": "ガブリエラ",
            "text": "わからないのね…。",
            "zh": "你也不知道啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "686/ACT",
            "narrator": "",
            "text": "ほぼ確定だから",
            "zh": "差不多已经确定了",
            "narrator_zh": ""
        },
        {
            "location": "688/TALK",
            "narrator": "ガブリエラ",
            "text": "そうでしょうね。",
            "zh": "也是呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "689/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃなきゃわざわざ\n決めさせないもの。",
            "zh": "不然也不会特地\n让你来做决定嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "690/ACT",
            "narrator": "",
            "text": "半々ってとこじゃない",
            "zh": "大概五五开吧",
            "narrator_zh": ""
        },
        {
            "location": "692/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなことないでしょ？",
            "zh": "才没那回事吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "693/TALK",
            "narrator": "ガブリエラ",
            "text": "わざわざ指名して\n決めさせたんだもの。",
            "zh": "毕竟可是特地指名\n让你来做决定的呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "695/TALK",
            "narrator": "ガブリエラ",
            "text": "この先もう\n話せない可能性が\nあるから言っておくわ。",
            "zh": "因为接下来\n可能再也没机会说话了，\n所以我要先告诉你。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "696/TALK",
            "narrator": "ガブリエラ",
            "text": "なんだかんだで\nあたし$handle$に\n感謝しているの。",
            "zh": "不管怎么说，\n我还是很感谢\n$handle$的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "697/TALK",
            "narrator": "ガブリエラ",
            "text": "日本に来て\n全然習慣も\n違っていて。",
            "zh": "来到日本之后，\n生活习惯也\n完全不一样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "698/TALK",
            "narrator": "ガブリエラ",
            "text": "それでなくても\n話せない時に\n色々話してくれたこと。",
            "zh": "就算本来就难以启齿，\n在我说不出话的时候，\n你也还是陪我聊了那么多。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "699/TALK",
            "narrator": "ガブリエラ",
            "text": "すぐに意地を張って\nふてくされるあたしを\n見ていてくれたこと。",
            "zh": "总是看着这个\n动不动就闹别扭、\n鼓起腮帮子生闷气的我。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "700/TALK",
            "narrator": "ガブリエラ",
            "text": "今はそれでいいよって\n言ってくれたこと。",
            "zh": "还对我说\n现在这样就很好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "701/TALK",
            "narrator": "ガブリエラ",
            "text": "そのおかげで、\nあたし少し人に\n優しくなれた。",
            "zh": "多亏了那样，\n我稍微能对别人\n温柔一点了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "702/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$みたいに\n優しくなろうって\nそう思えた。",
            "zh": "让我觉得，自己也想\n变得像$handle$\n那样温柔。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "703/SEL",
            "narrator": "",
            "text": "がんばってたもんね",
            "zh": "因为你一直都很努力呀",
            "narrator_zh": ""
        },
        {
            "location": "704/SEL",
            "narrator": "",
            "text": "たまには泣いてもいいんだよ",
            "zh": "偶尔哭出来也没关系的哦",
            "narrator_zh": ""
        },
        {
            "location": "705/SEL",
            "narrator": "",
            "text": "元々優しい子だったよ",
            "zh": "你本来就是个温柔的孩子呀",
            "narrator_zh": ""
        },
        {
            "location": "706/ACT",
            "narrator": "",
            "text": "がんばってたもんね",
            "zh": "因为你一直都很努力呀",
            "narrator_zh": ""
        },
        {
            "location": "707/TALK",
            "narrator": "ガブリエラ",
            "text": "…うん。\nあたしなりにだけどね。",
            "zh": "……嗯。\n好歹是按我自己的方式努力过啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "708/ACT",
            "narrator": "",
            "text": "たまには泣いてもいいんだよ",
            "zh": "偶尔哭出来也没关系的哦",
            "narrator_zh": ""
        },
        {
            "location": "709/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね。",
            "zh": "是呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "710/TALK",
            "narrator": "ガブリエラ",
            "text": "こうやって\n$handle$と\n話せるうちに。",
            "zh": "趁着现在还能像这样\n和$handle$\n说话的时候。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "711/ACT",
            "narrator": "",
            "text": "元々優しい子だったよ",
            "zh": "你本来就是个温柔的孩子呀",
            "narrator_zh": ""
        },
        {
            "location": "712/TALK",
            "narrator": "ガブリエラ",
            "text": "…そんなことを\n言ってくれるのは\n$handle$だけよ。",
            "zh": "……会对我说\n这种话的人，\n只有$handle$而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "714/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$は\n優しい。",
            "zh": "$handle$真的\n好温柔。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "715/SEL",
            "narrator": "",
            "text": "ガブリエラにだけだよ",
            "zh": "只对加布里埃拉这样哦",
            "narrator_zh": ""
        },
        {
            "location": "716/SEL",
            "narrator": "",
            "text": "そうかな？",
            "zh": "是吗？",
            "narrator_zh": ""
        },
        {
            "location": "717/SEL",
            "narrator": "",
            "text": "そんなことないし",
            "zh": "才没有那回事呢",
            "narrator_zh": ""
        },
        {
            "location": "718/ACT",
            "narrator": "",
            "text": "ガブリエラにだけだよ",
            "zh": "只对加布里埃拉这样哦",
            "narrator_zh": ""
        },
        {
            "location": "719/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対の絶対の\n絶対にそう？\nあたしにだけ？",
            "zh": "绝对的绝对的\n绝对是这样吗？\n只对我一个人？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "720/TALK",
            "narrator": "ガブリエラ",
            "text": "なんてね。\n知ってる。\nそんなことは。",
            "zh": "开玩笑的啦。\n我知道的。\n那种事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "721/ACT",
            "narrator": "",
            "text": "そうかな？",
            "zh": "是吗？",
            "narrator_zh": ""
        },
        {
            "location": "722/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ。",
            "zh": "就是啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "723/ACT",
            "narrator": "",
            "text": "そんなことないし",
            "zh": "才没有那回事呢",
            "narrator_zh": ""
        },
        {
            "location": "724/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうの\n謙遜って言うんでしょ。",
            "zh": "这种说法\n就是所谓的谦虚对吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "726/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ$handle$。\nこの先あたしが\n魂だけになっても。",
            "zh": "呐$handle$。\n就算以后我\n只剩下灵魂了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "727/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$は\nずっとあたしの\n側にいて。",
            "zh": "$handle$也要\n一直待在\n我身边哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "729/TALK",
            "narrator": "ガブリエラ",
            "text": "いつもあたしを\n感じていて。",
            "zh": "一直感受着\n我的存在。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "730/TALK",
            "narrator": "ガブリエラ",
            "text": "今こうやって\n話してるみたいに。",
            "zh": "就像现在这样\n和我说话一样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "731/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん、今より\nずっと深いところで。",
            "zh": "不，是在比现在\n更深的地方。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "732/TALK",
            "narrator": "ガブリエラ",
            "text": "空を見上げたら\n月や星や太陽が\n見えるみたいに。",
            "zh": "就像抬头仰望天空，\n就能看见月亮、星星\n和太阳那样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "733/TALK",
            "narrator": "ガブリエラ",
            "text": "当たり前にあたしの\n側にいて。",
            "zh": "理所当然地\n待在我身边。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "734/TALK",
            "narrator": "ガブリエラ",
            "text": "息をするみたいに\nあたしのことを\n感じていて。",
            "zh": "就像呼吸一样\n自然地感受着\n我的存在。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "735/TALK",
            "narrator": "ガブリエラ",
            "text": "あなたの心臓が\nあたしの魂。",
            "zh": "你的心脏，\n就是我的灵魂。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "736/TALK",
            "narrator": "ガブリエラ",
            "text": "そう思ったら\n怖いものなんて\nないような気がする。",
            "zh": "只要这么一想，\n就觉得好像没什么\n好害怕的了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "737/TALK",
            "narrator": "ガブリエラ",
            "text": "だって$handle$が\nいるだけであたしは\n震えるから。",
            "zh": "因为只要有$handle$\n在，我就会\n忍不住颤抖。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "738/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの魂が\n喜びで震えるから。",
            "zh": "我的灵魂会因为\n喜悦而颤抖。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "739/TALK",
            "narrator": "ガブリエラ",
            "text": "だからこの先もずっと\nあたしを感じて。",
            "zh": "所以今后也请一直\n感受着我。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "740/TALK",
            "narrator": "ガブリエラ",
            "text": "あなたのセカイに\nあたしをいさせて。",
            "zh": "让我在你的世界里\n一直待下去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "741/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのセカイは\nあなたの一部でしか\nないから。",
            "zh": "因为我的世界，\n只不过是你\n的一部分而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "742/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのセカイの\nどんな場所にも\nあなたがいるから。",
            "zh": "因为在我的世界的\n任何角落，\n都有你的存在。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "744/SEL",
            "narrator": "",
            "text": "愛してる。ずっと一緒だから",
            "zh": "我爱你。我们会永远在一起",
            "narrator_zh": ""
        },
        {
            "location": "745/SEL",
            "narrator": "",
            "text": "これからも共に支え合っていこう",
            "zh": "今后也一起互相扶持走下去吧",
            "narrator_zh": ""
        },
        {
            "location": "746/SEL",
            "narrator": "",
            "text": "これからも頑張ってね",
            "zh": "今后也要加油哦",
            "narrator_zh": ""
        },
        {
            "location": "747/SEL",
            "narrator": "",
            "text": "役に立てて良かったよ",
            "zh": "能帮上忙真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "748/ACT",
            "narrator": "",
            "text": "愛してる。ずっと一緒だから",
            "zh": "我爱你。我们会永远在一起",
            "narrator_zh": ""
        },
        {
            "location": "749/TALK",
            "narrator": "ガブリエラ",
            "text": "ちゃんと魂のあたしを\n見分けてね。",
            "zh": "要好好认出\n化作灵魂的我哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "750/ACT",
            "narrator": "",
            "text": "これからも共に支え合っていこう",
            "zh": "今后也一起互相扶持走下去吧",
            "narrator_zh": ""
        },
        {
            "location": "751/TALK",
            "narrator": "ガブリエラ",
            "text": "そのガブリエラは\nそのガブリエラ？",
            "zh": "你说的那个加布里埃拉，\n是指哪边的加布里埃拉？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "752/ACT",
            "narrator": "",
            "text": "これからも頑張ってね",
            "zh": "今后也要加油哦",
            "narrator_zh": ""
        },
        {
            "location": "753/TALK",
            "narrator": "ガブリエラ",
            "text": "…当たり前よ。",
            "zh": "……那当然啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "754/ACT",
            "narrator": "",
            "text": "役に立てて良かったよ",
            "zh": "能帮上忙真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "755/TALK",
            "narrator": "ガブリエラ",
            "text": "…そんなの全然だわ。",
            "zh": "……那种事根本算不上什么啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "758/SEL",
            "narrator": "",
            "text": "愛してる。ずっと一緒だから",
            "zh": "我爱你。我们会永远在一起",
            "narrator_zh": ""
        },
        {
            "location": "759/SEL",
            "narrator": "",
            "text": "これからも共に支え合っていこう",
            "zh": "今后也一起互相扶持走下去吧",
            "narrator_zh": ""
        },
        {
            "location": "760/SEL",
            "narrator": "",
            "text": "これからも頑張ってね",
            "zh": "今后也要加油哦",
            "narrator_zh": ""
        },
        {
            "location": "761/SEL",
            "narrator": "",
            "text": "役に立てて良かったよ",
            "zh": "能帮上忙真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "762/ACT",
            "narrator": "",
            "text": "愛してる。ずっと一緒だから",
            "zh": "我爱你。我们会永远在一起",
            "narrator_zh": ""
        },
        {
            "location": "763/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの方がその\n百万倍愛してる。",
            "zh": "我爱你可是你的\n一百万倍哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "764/TALK",
            "narrator": "ガブリエラ",
            "text": "何があっても一緒。\n永遠に一緒。",
            "zh": "无论发生什么都在一起。\n永远在一起。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "765/ACT",
            "narrator": "",
            "text": "これからも共に支え合っていこう",
            "zh": "今后也一起互相扶持走下去吧",
            "narrator_zh": ""
        },
        {
            "location": "766/TALK",
            "narrator": "ガブリエラ",
            "text": "もうちょっと\nロマンティックに\n言ってほしいのよ？",
            "zh": "你就不能说得\n再浪漫一点\n吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "767/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも好きよ。\nそんなところも。",
            "zh": "……不过我还是喜欢。\n连你这一点也喜欢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "768/ACT",
            "narrator": "",
            "text": "これからも頑張ってね",
            "zh": "今后也要加油哦",
            "narrator_zh": ""
        },
        {
            "location": "769/TALK",
            "narrator": "ガブリエラ",
            "text": "何よ。",
            "zh": "什么啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "770/TALK",
            "narrator": "ガブリエラ",
            "text": "もっと優しく\n言ってくれても\nいいと思うの。",
            "zh": "我觉得你明明可以\n说得再温柔\n一点的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "771/ACT",
            "narrator": "",
            "text": "役に立てて良かったよ",
            "zh": "能帮上忙真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "772/TALK",
            "narrator": "ガブリエラ",
            "text": "…そんな言い方\n冷たくないかしら？",
            "zh": "……这种说法\n未免太冷淡了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "774/TALK",
            "narrator": "ガブリエラ",
            "text": "最終的な結果は\nまだわからないけど。",
            "zh": "虽然最终的结果\n还不得而知。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "775/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$が\nあたしを選んで\nくれたことは。",
            "zh": "但$handle$\n选择了我\n这件事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "776/TALK",
            "narrator": "ガブリエラ",
            "text": "とてもとてもとても\n嬉しかったの。",
            "zh": "让我觉得非常非常\n非常的开心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "777/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう。",
            "zh": "谢谢你。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "782/TALK",
            "narrator": "ガブリエラ",
            "text": "この先がどうなるかは\n$handle$にすら\nわからない。",
            "zh": "今后会变成什么样，\n就连$handle$也\n不知道。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "783/TALK",
            "narrator": "ガブリエラ",
            "text": "でもあたしね。",
            "zh": "但我呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "784/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$の\n決断は正しいって\n信じてる。",
            "zh": "我相信$handle$的\n决断一定是\n正确的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "785/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしをずっと見てて。\n別のあたしも知ってて。",
            "zh": "你一直注视着我，\n也了解另一个我。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "786/TALK",
            "narrator": "ガブリエラ",
            "text": "色んなことを考えて。\n真面目に出した\n答えなんでしょ。",
            "zh": "一定是思考了很多，\n才认真得出的\n答案吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "787/TALK",
            "narrator": "ガブリエラ",
            "text": "普段はふざけたこと\nばかり言ってても。",
            "zh": "虽然平时净说些\n不正经的玩笑话。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "788/TALK",
            "narrator": "ガブリエラ",
            "text": "ピンチの時は必ず\nあたしを助けてくれた。",
            "zh": "但在紧要关头，\n你一定会出手救我。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "789/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしが泣きそうな夜は\nずっとそばに\nついててくれた。",
            "zh": "在我快要哭出来的夜晚，\n也一直陪在\n我的身边。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "790/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな$handle$が\n出した答えだもの。",
            "zh": "既然是这样的$handle$\n得出的答案。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "791/TALK",
            "narrator": "ガブリエラ",
            "text": "どんなだったとしても\n正解以外の\n答えはないわ。",
            "zh": "那无论结果如何，\n都绝不会有\n正确答案以外的可能。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "794/SEL",
            "narrator": "",
            "text": "ありがとう",
            "zh": "谢谢你",
            "narrator_zh": ""
        },
        {
            "location": "795/SEL",
            "narrator": "",
            "text": "ごめんね",
            "zh": "抱歉",
            "narrator_zh": ""
        },
        {
            "location": "796/SEL",
            "narrator": "",
