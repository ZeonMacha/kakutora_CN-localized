            "zh": "要幸福啊",
            "narrator_zh": ""
        },
        {
            "location": "797/ACT",
            "narrator": "",
            "text": "ありがとう",
            "zh": "谢谢你",
            "narrator_zh": ""
        },
        {
            "location": "798/TALK",
            "narrator": "ガブリエラ",
            "text": "少しだけさよならね。",
            "zh": "只是短暂的告别呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "799/ACT",
            "narrator": "",
            "text": "ごめんね",
            "zh": "抱歉",
            "narrator_zh": ""
        },
        {
            "location": "800/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんで謝るの？",
            "zh": "……为什么要道歉？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "801/ACT",
            "narrator": "",
            "text": "幸せになって",
            "zh": "要幸福啊",
            "narrator_zh": ""
        },
        {
            "location": "802/TALK",
            "narrator": "ガブリエラ",
            "text": "…なるに決まってる。",
            "zh": "……那还用说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "805/SEL",
            "narrator": "",
            "text": "ありがとう",
            "zh": "谢谢你",
            "narrator_zh": ""
        },
        {
