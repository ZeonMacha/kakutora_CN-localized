            "narrator_zh": ""
        },
        {
            "location": "807/SEL",
            "narrator": "",
            "text": "幸せになって",
            "zh": "要幸福啊",
            "narrator_zh": ""
        },
        {
            "location": "808/ACT",
            "narrator": "",
            "text": "ありがとう",
            "zh": "谢谢你",
            "narrator_zh": ""
        },
        {
            "location": "809/TALK",
            "narrator": "ガブリエラ",
            "text": "それはあたしの\n台詞だわ。",
            "zh": "那应该是我\n要说的话才对。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "810/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう\n$handle$。",
            "zh": "谢谢你\n$handle$。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "811/ACT",
            "narrator": "",
            "text": "ごめんね",
            "zh": "抱歉",
            "narrator_zh": ""
        },
        {
            "location": "812/TALK",
            "narrator": "ガブリエラ",
            "text": "変なこと言うのね。",
            "zh": "真是会说奇怪的话呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "813/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$は\n悪いことなんて\nしてないでしょ？",
            "zh": "$handle$又没有\n做过什么坏事，\n不是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
