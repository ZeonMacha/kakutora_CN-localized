        },
        {
            "location": "3083/SEL",
            "narrator": "",
            "text": "いいよ",
            "zh": "可以",
            "narrator_zh": ""
        },
        {
            "location": "3084/SEL",
            "narrator": "",
            "text": "ごめん、心の準備があるからまた今度でいい？",
            "zh": "抱歉，我得先做好心理准备，下次再说行吗？",
            "narrator_zh": ""
        },
        {
            "location": "3085/ACT",
            "narrator": "",
            "text": "いいよ",
            "zh": "可以",
            "narrator_zh": ""
        },
        {
            "location": "3086/ACT",
            "narrator": "",
            "text": "ごめん、心の準備があるからまた今度でいい？",
            "zh": "抱歉，我得先做好心理准备，下次再说行吗？",
            "narrator_zh": ""
        },
        {
            "location": "3087/TALK",
            "narrator": "神楽",
            "text": "いや、心の準備が必要なのはぴょんこの方であって",
