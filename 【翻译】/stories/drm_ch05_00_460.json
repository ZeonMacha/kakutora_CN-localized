        },
        {
            "location": "3130/TALK",
            "narrator": "神楽",
            "text": "そうかもしれないぴょん",
            "zh": "也许是吧pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "3131/ACT",
            "narrator": "",
            "text": "うーんわからん！",
            "zh": "唔——搞不懂！",
