        },
        {
            "location": "3060/ACT",
            "narrator": "",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": ""
        },
        {
            "location": "3061/ACT",
            "narrator": "",
            "text": "「好き」じゃないよ、「愛してる」だよ！",
