  {
   "location": "3053/ACT",
   "narrator": "",
   "text": "知ってる",
   "zh": "知道",
   "narrator_zh": ""
  },
  {
   "location": "3055/TALK",
   "narrator": "神楽",
   "text": "この前ね",
   "zh": "之前呢",
   "narrator_zh": "神乐"
  },
  {
   "location": "3056/TALK",
   "narrator": "神楽",
   "text": "$handle$が、私のこと、全部全部好きって言ってくれたでしょ",
   "zh": "$handle$不是说过喜欢我的全部全部吗",
   "narrator_zh": "神乐"
  },
  {
   "location": "3058/SEL",
   "narrator": "",
   "text": "うん",
   "zh": "嗯",
   "narrator_zh": ""
  },
  {
   "location": "3059/SEL",
   "narrator": "",
   "text": "「好き」じゃないよ、「愛してる」だよ！",
   "zh": "不是“喜欢”哦，是“爱你”！",
   "narrator_zh": ""
  },
  {
   "location": "3060/ACT",
   "narrator": "",
   "text": "うん",
   "zh": "嗯",
   "narrator_zh": ""
  },
  {
   "location": "3061/ACT",
   "narrator": "",
   "text": "「好き」じゃないよ、「愛してる」だよ！",
   "zh": "不是“喜欢”哦，是“爱你”！",
   "narrator_zh": ""
  },
  {
   "location": "3063/TALK",
   "narrator": "神楽",
   "text": "ふふふ～～～"
  },
  {
   "location": "3064/TALK",
   "narrator": "神楽",
   "text": "ごめんね、そうだった",
   "zh": "抱歉，是这样啊",
   "narrator_zh": "神乐"
  },
  {
   "location": "3066/TALK",
   "narrator": "神楽",
   "text": "私も、$handle$のこと、あ・い・し・て・る！"
  },
  {
   "location": "3068/TALK",
   "narrator": "神楽",
   "text": "それでね、フォビアのことで、私が質問したの覚えてる？",
   "zh": "然后呢，关于恐惧症，你还记得我问过的话吗？",
   "narrator_zh": "神乐"
  },
  {
   "location": "3070/SEL",
   "narrator": "",
   "text": "覚えてる",
   "zh": "我记得",
   "narrator_zh": ""
  },
  {
   "location": "3071/ACT",
   "narrator": "",
   "text": "覚えてる",
   "zh": "我记得",
   "narrator_zh": ""
  },
  {
   "location": "3073/TALK",
   "narrator": "神楽",
   "text": "あの後色々考えた"
  },
  {
   "location": "3074/TALK",
   "narrator": "神楽",
   "text": "ホントに色々考えて"
  },
  {
   "location": "3075/TALK",
   "narrator": "神楽",
   "text": "いっぱい泣いた"
  },
  {
   "location": "3077/SEL",
   "narrator": "",
   "text": "大丈夫？"
  },
  {
   "location": "3078/ACT",
   "narrator": "",
   "text": "大丈夫？"
  },
  {
   "location": "3080/TALK",
   "narrator": "神楽",
   "text": "$handle$にひとつ懺悔したいことがあるの",
   "zh": "我有件事想向$handle$忏悔",
   "narrator_zh": "神乐"
  },
  {
   "location": "3081/TALK",
   "narrator": "神楽",
   "text": "その話を、今からしていい？",
   "zh": "那件事，现在能说吗？",
   "narrator_zh": "神乐"
  },
  {
   "location": "3083/SEL",
   "narrator": "",
   "text": "いいよ",
   "zh": "可以",
   "narrator_zh": ""
  },
  {
   "location": "3084/SEL",
   "narrator": "",
   "text": "ごめん、心の準備があるからまた今度でいい？",
   "zh": "抱歉，我得先做好心理准备，下次再说行吗？",
   "narrator_zh": ""
  },
  {
   "location": "3085/ACT",
   "narrator": "",
   "text": "いいよ",
   "zh": "可以",
   "narrator_zh": ""
  },
  {
   "location": "3086/ACT",
   "narrator": "",
   "text": "ごめん、心の準備があるからまた今度でいい？",
   "zh": "抱歉，我得先做好心理准备，下次再说行吗？",
   "narrator_zh": ""
  },
  {
   "location": "3087/TALK",
   "narrator": "神楽",
   "text": "いや、心の準備が必要なのはぴょんこの方であって"
  },
  {
   "location": "3088/TALK",
   "narrator": "神楽",
   "text": "でも、色々有ると思うから、準備できたらまた声かけてぴょん",
   "zh": "不过，我想会有各种情况，准备好了再叫我pyon",
   "narrator_zh": "神乐"
  },
  {
   "location": "3099/TALK",
   "narrator": "神楽",
   "text": "ありがとう",
   "zh": "谢谢",
   "narrator_zh": "神乐"
  },
  {
   "location": "3100/TALK",
   "narrator": "神楽",
   "text": "ぴょんこがね、ママに虐待されてるでしょ"
  },
  {
   "location": "3101/TALK",
   "narrator": "神楽",
   "text": "あれね、ホントは因果応報なの"
  },
  {
   "location": "3102/TALK",
   "narrator": "神楽",
   "text": "だからね、$handle$に全部懺悔して、カルマの浄化をするの",
   "zh": "所以呢，向$handle$全部忏悔，净化业障",
   "narrator_zh": "神乐"
  },
  {
   "location": "3104/SEL",
   "narrator": "",
   "text": "あれって因果応報だったの！？",
   "zh": "那个是因果报应吗！？",
   "narrator_zh": ""
  },
  {
   "location": "3105/SEL",
   "narrator": "",
   "text": "承知致しました。不肖$handle$、全て受けとめ浄化致す所存です",
   "zh": "明白了。不才$handle$，必将全部承受并净化之",
   "narrator_zh": ""
  },
  {
   "location": "3106/ACT",
   "narrator": "",
   "text": "あれって因果応報だったの！？",
   "zh": "那个是因果报应吗！？",
   "narrator_zh": ""
  },
  {
   "location": "3107/TALK",
   "narrator": "神楽",
   "text": "えっと",
   "zh": "那个",
   "narrator_zh": "神乐"
  },
  {
   "location": "3108/TALK",
   "narrator": "神楽",
   "text": "なんて説明したらいいものか",
   "zh": "该怎么说明才好呢",
   "narrator_zh": "神乐"
  },
  {
   "location": "3110/TALK",
   "narrator": "神楽",
   "text": "ちょっとドラマチックにしてみただけぴょん",
   "zh": "只是试着弄得戏剧化一点pyon",
   "narrator_zh": "神乐"
  },
  {
   "location": "3111/TALK",
   "narrator": "神楽",
   "text": "マジレスすると、ママの件は全然関係無いぴょん"
  },
  {
   "location": "3112/TALK",
   "narrator": "神楽",
   "text": "忘れて"
  },
  {
   "location": "3113/ACT",
   "narrator": "",
   "text": "承知致しました。不肖$handle$、全て受けとめ浄化致す所存です",
   "zh": "明白了。不才$handle$，必将全部承受并净化之",
   "narrator_zh": ""
  },
  {
   "location": "3114/TALK",
   "narrator": "神楽",
   "text": "ぴょん！",
   "zh": "pyon！",
   "narrator_zh": "神乐"
  },
  {
   "location": "3115/TALK",
   "narrator": "神楽",
   "text": "ありがとうございます、$handle$様"
  },
  {
   "location": "3119/TALK",
   "narrator": "神楽",
   "text": "私にとって創作とは、古事記でいうところの国産みと同じです"
  },
  {
   "location": "3120/TALK",
   "narrator": "神楽",
   "text": "どの子も、お腹を痛めて生んだ子だし、それぞれ個性があってかわいい",
   "zh": "每个孩子都是我痛着生下来的，各有各的个性，都很可爱",
   "narrator_zh": "神乐"
  },
  {
   "location": "3122/SEL",
   "narrator": "",
   "text": "わかる",
   "zh": "我懂",
   "narrator_zh": ""
  },
  {
   "location": "3123/SEL",
   "narrator": "",
   "text": "わかるようなわからないような",
   "zh": "懂，又好像不懂",
   "narrator_zh": ""
  },
  {
   "location": "3124/SEL",
   "narrator": "",
   "text": "うーんわからん！",
   "zh": "唔——搞不懂！",
   "narrator_zh": ""
  },
  {
   "location": "3125/ACT",
   "narrator": "",
   "text": "わかる",
   "zh": "我懂",
   "narrator_zh": ""
  },
  {
   "location": "3126/TALK",
