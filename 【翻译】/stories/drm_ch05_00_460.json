            "text": "私は",
            "zh": "我",
            "narrator_zh": "神乐"
        },
        {
            "location": "3139/SEL",
            "narrator": "",
            "text": "無理しないで？",
            "zh": "你不勉强自己？",
            "narrator_zh": ""
        },
        {
            "location": "3140/SEL",
            "narrator": "",
            "text": "いつまでも待ってるから、落ち着いてお話して？",
            "zh": "我会一直等的，你慢慢说啊？",
            "narrator_zh": ""
        },
        {
            "location": "3141/ACT",
            "narrator": "",
            "text": "無理しないで？",
            "zh": "你不勉强自己？",
            "narrator_zh": ""
        },
        {
            "location": "3142/ACT",
            "narrator": "",
            "text": "いつまでも待ってるから、落ち着いてお話して？",
            "zh": "我会一直等的，你慢慢说啊？",
