   "narrator_zh": "神乐"
  },
  {
   "location": "3127/TALK",
   "narrator": "神楽",
   "text": "わかってくれて"
  },
  {
   "location": "3128/ACT",
   "narrator": "",
   "text": "わかるようなわからないような",
   "zh": "懂，又好像不懂",
   "narrator_zh": ""
  },
  {
   "location": "3129/TALK",
   "narrator": "神楽",
   "text": "そっか",
   "zh": "这样啊",
   "narrator_zh": "神乐"
  },
  {
   "location": "3130/TALK",
   "narrator": "神楽",
   "text": "そうかもしれないぴょん",
   "zh": "也许是吧pyon",
   "narrator_zh": "神乐"
  },
  {
   "location": "3131/ACT",
   "narrator": "",
   "text": "うーんわからん！",
   "zh": "唔——搞不懂！",
   "narrator_zh": ""
  },
  {
   "location": "3132/TALK",
   "narrator": "神楽",
   "text": "伝わんないぴょん、、、"
  },
  {
   "location": "3133/TALK",
   "narrator": "神楽",
   "text": "仕方ないけど",
   "zh": "也没办法",
   "narrator_zh": "神乐"
  },
  {
   "location": "3135/TALK",
   "narrator": "神楽",
   "text": "なのに",
   "zh": "可是",
   "narrator_zh": "神乐"
  },
  {
   "location": "3136/TALK",
   "narrator": "神楽",
   "text": "私は",
   "zh": "我",
   "narrator_zh": "神乐"
  },
  {
   "location": "3139/SEL",
   "narrator": "",
   "text": "無理しないで？",
   "zh": "你不勉强自己？",
   "narrator_zh": ""
  },
  {
   "location": "3140/SEL",
   "narrator": "",
   "text": "いつまでも待ってるから、落ち着いてお話して？",
   "zh": "我会一直等的，你慢慢说啊？",
   "narrator_zh": ""
  },
  {
   "location": "3141/ACT",
   "narrator": "",
   "text": "無理しないで？",
   "zh": "你不勉强自己？",
   "narrator_zh": ""
  },
  {
   "location": "3142/ACT",
   "narrator": "",
   "text": "いつまでも待ってるから、落ち着いてお話して？",
   "zh": "我会一直等的，你慢慢说啊？",
   "narrator_zh": ""
  },
  {
   "location": "3144/TALK",
   "narrator": "神楽",
   "text": "ありがとう",
   "zh": "谢谢",
   "narrator_zh": "神乐"
  },
  {
   "location": "3145/TALK",
   "narrator": "神楽",
   "text": "私は、イシュフォビアという作品の事が嫌いでした"
  },
  {
   "location": "3146/TALK",
   "narrator": "神楽",
   "text": "ずっと恨んでた"
  },
