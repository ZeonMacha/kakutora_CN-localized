  {
   "location": "3050/TALK",
   "narrator": "神楽",
   "text": "ぴょんこはその子になりきるぴょん"
  },
  {
   "location": "3052/SEL",
   "narrator": "",
   "text": "知ってる",
   "zh": "知道",
