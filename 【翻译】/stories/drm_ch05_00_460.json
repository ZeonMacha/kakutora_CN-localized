        },
        {
            "location": "3144/TALK",
            "narrator": "神楽",
            "text": "ありがとう",
            "zh": "谢谢",
            "narrator_zh": "神乐"
        },
        {
            "location": "3145/TALK",
            "narrator": "神楽",
            "text": "私は、イシュフォビアという作品の事が嫌いでした",
            "zh": "我曾讨厌过Wishphobia这部作品",
            "narrator_zh": "神乐"
        },
        {
            "location": "3146/TALK",
            "narrator": "神楽",
            "text": "ずっと恨んでた",
            "zh": "一直怀恨在心",
            "narrator_zh": "神乐"
        },
        {
            "location": "3147/TALK",
            "narrator": "神楽",
            "text": "だってイシュフォビアは、私が作った作品じゃない",
            "zh": "因为Wishphobia不是我创作的作品",
            "narrator_zh": "神乐"
        },
        {
            "location": "3148/TALK",
            "narrator": "神楽",
            "text": "アップサイドサウンズのPが方向性を決めて、",
            "zh": "那是Upside Sounds的制作人定下的方向，",
            "narrator_zh": "神乐"
        },
        {
            "location": "3149/TALK",
            "narrator": "神楽",
            "text": "ううん、もっともっと上からの命令で、こういうお話にしろという命令の下で作られた物語で",
            "zh": "不对，是在更上面、更上面发来的命令下，被要求“给我做成这种故事”而诞生的作品，",
            "narrator_zh": "神乐"
        },
        {
            "location": "3150/TALK",
            "narrator": "神楽",
            "text": "あれは私が作りたいものじゃなかった",
            "zh": "那根本不是我想创作的东西",
            "narrator_zh": "神乐"
        },
        {
            "location": "3151/TALK",
            "narrator": "神楽",
            "text": "だから私は、イシュフォビアを自分の作品だと思わないようにしていたし、唄うときも無心で唄うようにしていた",
            "zh": "所以我才不去想Wishphobia是自己的作品，唱的时候也尽量心无杂念地唱",
            "narrator_zh": "神乐"
        },
        {
            "location": "3152/TALK",
            "narrator": "神楽",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "神乐"
        },
        {
            "location": "3155/TALK",
            "narrator": "神楽",
            "text": "やっぱだめだ",
            "zh": "果然还是不行",
            "narrator_zh": "神乐"
        },
        {
            "location": "3156/TALK",
            "narrator": "神楽",
            "text": "これはちゃんと",
            "zh": "这个好好地",
            "narrator_zh": "神乐"
        },
        {
            "location": "3157/TALK",
            "narrator": "神楽",
            "text": "言葉でお話したいから",
            "zh": "我想好好用语言说给你听",
            "narrator_zh": "神乐"
        },
        {
            "location": "3158/TALK",
            "narrator": "神楽",
            "text": "どうか、聞いて下さい",
            "zh": "请你听一听",
            "narrator_zh": "神乐"
        },
        {
