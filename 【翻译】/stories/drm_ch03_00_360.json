{
    "dir": "dramatics/daydra/drm_ch03_00_360.js",
    "type": "Episode",
    "info": {
        "story_id": "3036",
        "cid": "gabriella",
        "title": "らぶとーく  第36話",
        "sub_title": "失恋",
        "title_zh": "恋爱漫谈 第36话",
        "sub_title_zh": "失恋"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "失恋",
            "zh": "失恋"
        },
        {
            "location": "18/TALK",
            "narrator": "ガブリエラ",
            "text": "…髪型ＯＫ。\n歯も磨いたし、\n服も汚れてないし――",
            "zh": "……发型OK。\n牙也刷过了，\n衣服也没弄脏——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "19/TALK",
            "narrator": "ガブリエラ",
            "text": "うん、完璧！\n準備ＯＫ！",
            "zh": "嗯，完美！\n准备OK！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$、おかしなところはないかしら？",
            "zh": "$handle$，有没有什么奇怪的地方？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/SEL",
            "narrator": "",
            "text": "気合入ってるね",
            "zh": "你还挺有干劲",
            "narrator_zh": ""
        },
        {
            "location": "35/ACT",
            "narrator": "",
            "text": "気合入ってるね",
            "zh": "你还挺有干劲",
            "narrator_zh": ""
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "気が付いた？",
            "zh": "你发现了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "39/TALK",
            "narrator": "ガブリエラ",
            "text": "ヒカルくんがあたしに話があるみたいなの！",
            "zh": "光好像有话要跟我说！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "みんなに内緒で二人きりで",
            "zh": "瞒着大家，两个人单独",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "何の話だと思う？",
            "zh": "你觉得是什么话？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "43/SEL",
            "narrator": "",
            "text": "愛の告白",
            "zh": "爱的告白",
            "narrator_zh": ""
        },
        {
            "location": "44/SEL",
            "narrator": "",
            "text": "先輩として忠告がある",
            "zh": "作为学姐我得提醒你一句",
            "narrator_zh": ""
        },
        {
            "location": "45/SEL",
            "narrator": "",
            "text": "お金の相談",
            "zh": "商量钱的事",
            "narrator_zh": ""
        },
        {
            "location": "46/ACT",
            "narrator": "",
            "text": "愛の告白",
            "zh": "爱的告白",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりそうよね/////////",
            "zh": "果然是这样吧/////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "みんなに内緒で二人きりで会いたいなんて",
            "zh": "瞒着大家想单独见面什么的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "それ以外考えられないわ/////////",
            "zh": "除了那个想不出别的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "50/ACT",
            "narrator": "",
            "text": "先輩として忠告がある",
            "zh": "作为学姐我得提醒你一句",
            "narrator_zh": ""
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "なにそれ？",
            "zh": "那是什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "私、何も悪いことしてないわよ！？",
            "zh": "我又没做什么坏事！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "心配になるようなこと言わないで！",
            "zh": "别说让人担心的话！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなはずないんだから",
            "zh": "不可能那样的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "…ないわよね？",
            "zh": "……没有的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "57/ACT",
            "narrator": "",
            "text": "お金の相談",
            "zh": "商量钱的事",
            "narrator_zh": ""
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対にありえないと思うけど？",
            "zh": "我觉得绝对不可能，不过？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "お金の相談をするような仲じゃないし",
            "zh": "又不是能商量钱的那种关系",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、もし本当にそうだったとしたら",
            "zh": "不过，要是真的那样的话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしよう…",
            "zh": "怎么办呀……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "私もそんなに持ってないんだけど…",
            "zh": "我也没抱那么大期望……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "ガブリエラ",
            "text": "って、いけない！\nそろそろ行かないと。",
            "zh": "啊，不行！\n差不多该走了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ…楽しみだわ。",
            "zh": "呵呵……好期待。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "えっと…。",
            "zh": "那个……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ヒカル",
            "text": "ガブリエラさん、\nこっちです。",
            "zh": "加布里埃拉，\n这边。",
            "narrator_zh": "光"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！！",
            "zh": "唔！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "いた！\n本当に…。",
            "zh": "在！\n真的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "ヒカル",
            "text": "突然呼び出してしまって\nすみません…。",
            "zh": "突然把你叫出来\n对不起……",
            "narrator_zh": "光"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ、携帯！",
            "zh": "啊，手机！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "えっと…こちらこそ\n待たせてごめんなさい、\nっと。",
            "zh": "那个……该我说\n让你久等了，对不起，\n发送。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "ヒカル",
            "text": "いえ、僕が早く来過ぎた\nだけですから…。",
            "zh": "没事，是我来得\n太早了……",
            "narrator_zh": "光"
        },
        {
            "location": "118/TALK",
            "narrator": "ヒカル",
            "text": "とりあえず、\nまずは座って何か\n注文しちゃいましょう。",
            "zh": "总之，\n先坐下点点\n什么吧。",
            "narrator_zh": "光"
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "なんだか、ちょっと\n緊張して来たかも…。",
            "zh": "总觉得，有点\n紧张起来了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "131/TALK",
            "narrator": "ヒカル",
            "text": "…本当、すみません。\n放課後に呼び出したり\nしてしまって…。",
            "zh": "……真的，对不起。\n放学后还把你\n叫出来……。",
            "narrator_zh": "光"
        },
        {
            "location": "132/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "これで六回目…。",
            "zh": "这是第六次……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "134/TALK",
            "narrator": "ガブリエラ",
            "text": "ヒカルくん、さっきから\n謝ってばかり…。",
            "zh": "光，从刚才起\n一直在道歉……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "これって…ヒカルくんも\n緊張してる証拠…よね？",
            "zh": "这个……光君也在\n紧张的证据……对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/TALK",
            "narrator": "ヒカル",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "光"
        },
        {
            "location": "139/TALK",
            "narrator": "ヒカル",
            "text": "本当、すみません。\n僕、さっきからずっと、\n謝ってばかりですね。",
            "zh": "真的，对不起。\n我从刚才起，\n一直在道歉呢。",
            "narrator_zh": "光"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "ヒカル",
            "text": "長引かせても、きっと\nどんどん言い難くなると\n思うので――",
            "zh": "再拖下去，肯定\n会越来越难说出口\n所以——",
            "narrator_zh": "光"
        },
        {
            "location": "145/TALK",
            "narrator": "ヒカル",
            "text": "思い切って、言います！",
            "zh": "我鼓起勇气，说了！",
            "narrator_zh": "光"
        },
        {
            "location": "150/TALK",
            "narrator": "ガブリエラ",
            "text": "き、来た！！\n告白！！",
            "zh": "来、来了！！\n告白！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "ヒカル",
            "text": "あ、あの…実は…。",
            "zh": "那、那个……其实……",
            "narrator_zh": "光"
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "ヒカル",
            "text": "ガブリエラさんに…\n相談したいことが\nありまして…。",
            "zh": "有件事想……\n找加布里埃拉\n商量……",
            "narrator_zh": "光"
        },
        {
            "location": "155/TALK",
            "narrator": "ガブリエラ",
            "text": "…………？",
            "zh": "…………？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "そう、だん？",
            "zh": "商量？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "160/TALK",
            "narrator": "ヒカル",
            "text": "…あれ？\nガブリエラさん？",
            "zh": "……咦？\n加布里埃拉？",
            "narrator_zh": "光"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "なんだ…告白じゃ\nなかったんだ…。",
            "zh": "什么啊……不是告白\n啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "164/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "ヒカル",
            "text": "す、すみません！\n迷惑でしたよね…。",
            "zh": "对、对不起！\n给你添麻烦了吧……",
            "narrator_zh": "光"
        },
        {
            "location": "167/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ！",
            "zh": "啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "170/TALK",
            "narrator": "ガブリエラ",
            "text": "違うんです！\nそうじゃなくて――",
            "zh": "不是的！\n不是那样——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "171/TALK",
            "narrator": "ガブリエラ",
            "text": "何で呼ばれたのかが\nわかって、安心した\nだけです、っと。",
            "zh": "我只是明白了\n为什么被叫来，\n松了口气，发送。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "175/TALK",
            "narrator": "ヒカル",
            "text": "そうですか…。",
            "zh": "是这样啊……。",
            "narrator_zh": "光"
        },
        {
            "location": "176/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、現実なんて\nこんなもんよね。",
            "zh": "……嘛，现实\n就是这么回事呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "178/TALK",
            "narrator": "ガブリエラ",
            "text": "…それで、相談って\nなんですか、っと。",
            "zh": "……那么，商量的事\n是什么，发送。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "180/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "183/TALK",
            "narrator": "ヒカル",
            "text": "はい…その、驚かないで\nくださいね。",
            "zh": "是……那个，请不要\n吃惊哦。",
            "narrator_zh": "光"
        },
        {
            "location": "184/TALK",
            "narrator": "ヒカル",
            "text": "実は…僕、その…。",
            "zh": "其实……我，那个……",
            "narrator_zh": "光"
        },
        {
            "location": "185/TALK",
            "narrator": "ヒカル",
            "text": "ひなこさんのことが\n好きで…告白しようと\n考えていて…。",
            "zh": "我喜欢\n雏子……正在考虑\n告白……",
            "narrator_zh": "光"
        },
        {
            "location": "187/TALK",
            "narrator": "ガブリエラ",
            "text": "…………えっ？",
            "zh": "…………诶？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "188/TALK",
            "narrator": "ヒカル",
            "text": "お、驚きましたよね？\n急にこんなこと\n言われて…。",
            "zh": "吓、吓到了吧？\n突然跟你说\n这种事……。",
            "narrator_zh": "光"
        },
        {
            "location": "190/TALK",
            "narrator": "ヒカル",
            "text": "けど、その…こういう\nこと相談できるの――",
            "zh": "可是，那个……能商量\n这种事——",
            "narrator_zh": "光"
        },
        {
            "location": "191/TALK",
            "narrator": "ヒカル",
            "text": "ガブリエラさんしか\n思いつかなくて…。",
            "zh": "我只想得起\n加布里埃拉……",
            "narrator_zh": "光"
        },
        {
            "location": "193/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "200/TALK",
            "narrator": "ヒカル",
            "text": "ああ…実は僕、\nガブリエラさんの\nことは前から――",
            "zh": "啊……其实我，\n对加布里埃拉\n从以前就——",
            "narrator_zh": "光"
        },
        {
            "location": "201/TALK",
            "narrator": "ヒカル",
            "text": "妹のような存在だと\n思っているので――",
            "zh": "把你当成\n妹妹一样——",
            "narrator_zh": "光"
        },
        {
            "location": "202/TALK",
            "narrator": "ヒカル",
            "text": "言い難い話も、\n言いやすいんです。",
            "zh": "难开口的话，\n也比较容易说。",
            "narrator_zh": "光"
        },
        {
            "location": "204/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "206/TALK",
            "narrator": "ヒカル",
            "text": "それでですね――",
            "zh": "然后呢——",
            "narrator_zh": "光"
        },
        {
            "location": "207/TALK",
            "narrator": "ヒカル",
            "text": "その、ひなこさんへの\n告白ですが――",
            "zh": "那个，关于向雏\n告白的事——",
            "narrator_zh": "光"
        },
        {
            "location": "208/TALK",
            "narrator": "ヒカル",
            "text": "そ、その…どんなことを\n言ったり、すればいいか\nわからなくて…。",
            "zh": "那、那个……该说什么、\n该怎么做，\n我不太清楚……。",
            "narrator_zh": "光"
        },
        {
            "location": "209/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "211/TALK",
            "narrator": "ヒカル",
            "text": "…僕、どうすれば\n良いと思いますか？",
            "zh": "……我该怎么做\n比较好呢？",
            "narrator_zh": "光"
        },
        {
            "location": "212/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "ガブリエラ",
            "text": "ひなこは、みんなが\n思ってるよりも恋愛に\n対して奥手です。",
            "zh": "雏子比大家\n想的更不擅长\n恋爱。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、あまり強引に\nならないよう気を付けて\nください、っと。",
            "zh": "所以，请注意\n不要太\n强硬。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "218/TALK",
            "narrator": "ヒカル",
            "text": "…そう、ですか…。",
            "zh": "……是、是吗……",
            "narrator_zh": "光"
        },
        {
            "location": "220/TALK",
            "narrator": "ヒカル",
            "text": "…難しそうです。\n僕、こういうのって\n慣れてないから…。",
            "zh": "……好像很难。\n我这种东西\n不太习惯……。",
            "narrator_zh": "光"
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！！",
            "zh": "唔！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/TALK",
            "narrator": "ガブリエラ",
            "text": "弱気になるな！！",
            "zh": "别气馁！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！！",
            "zh": "唔！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "226/TALK",
            "narrator": "ヒカル",
            "text": "えっ？",
            "zh": "诶？",
            "narrator_zh": "光"
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな弱気の告白じゃ、\n誰だってＯＫして\nくれません！",
            "zh": "那么胆怯的告白，\n谁都不会\n答应的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "もっと、自信持ってください！",
            "zh": "请再自信一点！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "230/TALK",
            "narrator": "ヒカル",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "光"
        },
        {
            "location": "232/TALK",
            "narrator": "ガブリエラ",
            "text": "大丈夫です。",
            "zh": "没事的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "ガブリエラ",
            "text": "ヒカルくんなら、\nきっと大丈夫だから。",
            "zh": "光的话，\n一定没问题。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "236/TALK",
            "narrator": "ヒカル",
            "text": "…ありがとう\nございます。",
            "zh": "……谢谢\n你。",
            "narrator_zh": "光"
        },
        {
            "location": "237/TALK",
            "narrator": "ヒカル",
            "text": "やっぱり、\nガブリエラさんに\n相談して正解でした。",
            "zh": "果然，\n找加布里埃拉\n商量是对的。",
            "narrator_zh": "光"
        },
        {
            "location": "238/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "239/TALK",
            "narrator": "ガブリエラ",
            "text": "頑張ってくださいね。\nそれじゃあ…。",
            "zh": "请加油。\n那就……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "ヒカル",
            "text": "はい…また学校で。",
            "zh": "好……学校见。",
            "narrator_zh": "光"
        },
        {
            "location": "243/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "244/SEL",
            "narrator": "",
            "text": "ガブリエラ、大丈夫？",
            "zh": "加布里埃拉，你没事吧？",
            "narrator_zh": ""
        },
        {
            "location": "245/ACT",
            "narrator": "",
            "text": "ガブリエラ、大丈夫？",
            "zh": "加布里埃拉，你没事吧？",
            "narrator_zh": ""
        },
        {
            "location": "250/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "251/SEL",
            "narrator": "",
            "text": "ガブリエラ！",
            "zh": "加布里埃拉！",
            "narrator_zh": ""
        },
        {
            "location": "252/ACT",
            "narrator": "",
            "text": "ガブリエラ！",
            "zh": "加布里埃拉！",
            "narrator_zh": ""
        },
        {
