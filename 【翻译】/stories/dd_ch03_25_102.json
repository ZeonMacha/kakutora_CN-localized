    "entry": [
        {
            "location": "427/SCENARIO",
            "narrator": "",
            "text": "釦とリボンと指ぬきと",
            "zh": "纽扣、丝带与顶针",
            "narrator_zh": ""
        },
        {
            "location": "442/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし……。",
            "zh": "我……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "443/TALK",
            "narrator": "ガブリエラ",
            "text": "冷静にならなきゃって\n思ってたのに…。",
            "zh": "明明想着必须得\n保持冷静才行的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "455/TALK",
            "narrator": "ガブリエラ",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "456/TALK",
            "narrator": "ガブリエラ",
            "text": "さっきの話だけど",
            "zh": "刚才那件事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "458/SEL",
            "narrator": "",
            "text": "バグバグなんだけど！",
            "zh": "全都出Bug了啊！",
            "narrator_zh": ""
        },
        {
            "location": "459/SEL",
            "narrator": "",
            "text": "本気にしないで",
            "zh": "别放在心上",
            "narrator_zh": ""
        },
        {
            "location": "460/SEL",
            "narrator": "",
            "text": "迷ってる暇なんてないよ！",
            "zh": "没有犹豫的时间了！",
            "narrator_zh": ""
        },
        {
            "location": "461/ACT",
            "narrator": "",
            "text": "迷ってる暇なんてないよ！",
            "zh": "没有犹豫的时间了！",
            "narrator_zh": ""
        },
        {
            "location": "462/ACT",
            "narrator": "",
            "text": "迷ってる暇なんてないよ！",
            "zh": "没有犹豫的时间了！",
            "narrator_zh": ""
        },
        {
            "location": "463/ACT",
            "narrator": "",
            "text": "迷ってる暇なんてないよ！",
            "zh": "没有犹豫的时间了！",
            "narrator_zh": ""
        },
        {
            "location": "465/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "466/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし一人で怖がって",
            "zh": "我一个人在这里胡思乱想害怕",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "467/TALK",
            "narrator": "ガブリエラ",
            "text": "焦ってたわ",
            "zh": "太心急了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "468/TALK",
            "narrator": "ガブリエラ",
            "text": "だけど",
            "zh": "不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "469/TALK",
            "narrator": "ガブリエラ",
            "text": "もう迷わない",
            "zh": "我已经不再迷茫了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "470/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤがここにいてって",
            "zh": "因为绫水她",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "471/TALK",
            "narrator": "ガブリエラ",
            "text": "言ったんだから",
            "zh": "让我待在这里的嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "472/TALK",
            "narrator": "ガブリエラ",
            "text": "ここで待つわ",
            "zh": "我就留在这里等她",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "473/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤを信じて",
            "zh": "相信绫水",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "475/SEL",
            "narrator": "",
            "text": "それがいいよ",
            "zh": "那样最好",
            "narrator_zh": ""
        },
        {
            "location": "476/SEL",
            "narrator": "",
            "text": "探しに行かないの？",
            "zh": "不去找她了吗？",
            "narrator_zh": ""
        },
        {
            "location": "477/ACT",
            "narrator": "",
            "text": "それがいいよ",
            "zh": "那样最好",
            "narrator_zh": ""
        },
        {
            "location": "478/TALK",
            "narrator": "ガブリエラ",
            "text": "そうでしょう？",
            "zh": "对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "479/ACT",
            "narrator": "",
            "text": "探しに行かないの？",
            "zh": "不去找她了吗？",
            "narrator_zh": ""
        },
        {
            "location": "480/TALK",
            "narrator": "ガブリエラ",
            "text": "行かないわ",
            "zh": "不去了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "482/TALK",
            "narrator": "ガブリエラ",
            "text": "ここは今戦場だもの",
            "zh": "这里现在就是战场",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "483/TALK",
            "narrator": "ガブリエラ",
            "text": "戦場で勝手な行動は命取り",
            "zh": "在战场上擅自行动可是会致命的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "484/TALK",
            "narrator": "ガブリエラ",
            "text": "それを忘れていたの",
            "zh": "我刚才把这一点都给忘了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "485/TALK",
            "narrator": "ガブリエラ",
            "text": "焦りすぎて",
            "zh": "实在太心急了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "487/SEL",
            "narrator": "",
            "text": "そっか",
            "zh": "这样啊",
            "narrator_zh": ""
        },
        {
            "location": "488/SEL",
            "narrator": "",
            "text": "少しは落ち着いたんだ",
            "zh": "总算稍微冷静下来了呢",
            "narrator_zh": ""
        },
        {
            "location": "489/ACT",
            "narrator": "",
            "text": "そっか",
            "zh": "这样啊",
            "narrator_zh": ""
        },
        {
            "location": "490/TALK",
            "narrator": "ガブリエラ",
            "text": "そうだったのよ",
            "zh": "就是这么回事哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "491/ACT",
            "narrator": "",
            "text": "少しは落ち着いたんだ",
            "zh": "总算稍微冷静下来了呢",
            "narrator_zh": ""
        },
        {
            "location": "492/TALK",
            "narrator": "ガブリエラ",
            "text": "そう思いたいわ",
            "zh": "我也希望自己冷静下来了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "494/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし確かに情勢不安な場所で生まれたけど",
            "zh": "我确实出生在局势动荡的地方",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "495/TALK",
            "narrator": "ガブリエラ",
            "text": "戦争をしている時期もあったけど",
            "zh": "也经历过正在打仗的时期",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "496/TALK",
            "narrator": "ガブリエラ",
            "text": "でも前線からは遠く離れていたんだわ",
            "zh": "但其实离前线还很远呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "497/TALK",
            "narrator": "ガブリエラ",
            "text": "当たり前よね",
            "zh": "这也是理所当然的吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "499/TALK",
            "narrator": "ガブリエラ",
            "text": "子供だもの",
            "zh": "毕竟还是小孩子嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "501/SEL",
            "narrator": "",
            "text": "でも慣れてはいるんじゃ…",
            "zh": "可你应该也算习惯了……",
            "narrator_zh": ""
        },
        {
            "location": "502/SEL",
            "narrator": "",
            "text": "結構重い体験だよね",
            "zh": "这已经是相当沉重的经历了啊",
            "narrator_zh": ""
        },
        {
            "location": "503/ACT",
            "narrator": "",
            "text": "でも慣れてはいるんじゃ…",
            "zh": "可你应该也算习惯了……",
            "narrator_zh": ""
        },
        {
            "location": "504/TALK",
            "narrator": "ガブリエラ",
            "text": "全然だった",
            "zh": "才没有呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "505/ACT",
            "narrator": "",
            "text": "結構重い体験だよね",
            "zh": "这已经是相当沉重的经历了啊",
            "narrator_zh": ""
        },
        {
            "location": "506/TALK",
            "narrator": "ガブリエラ",
            "text": "今の方がよっぽど重いわよ",
            "zh": "现在才要沉重得多呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "508/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのお父様は人に向ける引き金の重さを知っているわ",
            "zh": "我的爸爸知道把枪口指向别人并扣下扳机有多沉重",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "509/TALK",
            "narrator": "ガブリエラ",
            "text": "でもあたしは知らずにすんでた",
            "zh": "但我过去一直不需要去体会那种重量",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "510/TALK",
            "narrator": "ガブリエラ",
            "text": "だけど",
            "zh": "然而",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "511/TALK",
            "narrator": "ガブリエラ",
            "text": "この先",
            "zh": "从今往后",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "514/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ$marzanna$",
            "zh": "喂$marzanna$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "515/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしがかわいそうだと思うなら",
            "zh": "如果你觉得我很可怜的话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "516/TALK",
            "narrator": "ガブリエラ",
            "text": "何か言って",
            "zh": "就说点什么吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "518/SEL",
            "narrator": "",
            "text": "欲しいのは同情？",
            "zh": "你想要的是同情吗？",
            "narrator_zh": ""
        },
        {
            "location": "519/ACT",
            "narrator": "",
            "text": "欲しいのは同情？",
            "zh": "你想要的是同情吗？",
            "narrator_zh": ""
        },
        {
            "location": "521/TALK",
            "narrator": "ガブリエラ",
            "text": "同情で",
            "zh": "如果同情",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "522/TALK",
            "narrator": "ガブリエラ",
            "text": "抱きしめてもらえるなら",
            "zh": "能换来你的拥抱",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "523/TALK",
            "narrator": "ガブリエラ",
            "text": "同情でもいいわ",
            "zh": "那同情也无所谓",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "525/SEL",
            "narrator": "",
            "text": "怖くて当たり前だから",
            "zh": "害怕是理所当然的嘛",
            "narrator_zh": ""
        },
        {
            "location": "526/SEL",
            "narrator": "",
            "text": "$me$がハグしてるところを妄想して",
            "zh": "妄想一下$me$在抱着你吧",
            "narrator_zh": ""
        },
        {
            "location": "527/SEL",
            "narrator": "",
            "text": "ガブリエラはとてもいい子だ",
            "zh": "加布里埃拉是个很乖的好孩子",
            "narrator_zh": ""
        },
        {
            "location": "528/ACT",
            "narrator": "",
            "text": "怖くて当たり前だから",
            "zh": "害怕是理所当然的嘛",
            "narrator_zh": ""
        },
        {
            "location": "529/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "530/TALK",
            "narrator": "ガブリエラ",
            "text": "怖いの",
            "zh": "我好害怕",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "531/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしすごく",
            "zh": "我真的非常害怕",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "532/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "533/TALK",
            "narrator": "ガブリエラ",
            "text": "それでいいのね・・・",
            "zh": "害怕也是可以的呢……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "534/ACT",
            "narrator": "",
            "text": "$me$がハグしてるところを妄想して",
            "zh": "妄想一下$me$在抱着你吧",
            "narrator_zh": ""
        },
        {
            "location": "535/TALK",
            "narrator": "ガブリエラ",
            "text": "妄想って何よ",
            "zh": "什么叫妄想啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "536/TALK",
            "narrator": "ガブリエラ",
            "text": "妄想って！",
            "zh": "什么叫妄想啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "537/TALK",
            "narrator": "ガブリエラ",
            "text": "もう！",
            "zh": "真是的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "538/ACT",
            "narrator": "",
            "text": "ガブリエラはとてもいい子だ",
            "zh": "加布里埃拉是个很乖的好孩子",
            "narrator_zh": ""
        },
        {
            "location": "539/TALK",
            "narrator": "ガブリエラ",
            "text": "・・・そうやって",
            "zh": "……你就这样",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "540/TALK",
            "narrator": "ガブリエラ",
            "text": "子供扱いするのね",
            "zh": "把我当成小孩子哄呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "541/TALK",
            "narrator": "ガブリエラ",
            "text": "でも今回だけは",
            "zh": "不过就这一次",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "542/TALK",
            "narrator": "ガブリエラ",
            "text": "子供でいいわ",
            "zh": "当个小孩子也无所谓啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "554/TALK",
            "narrator": "ガブリエラ",
            "text": "ふう…。",
            "zh": "呼……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "555/TALK",
            "narrator": "ガブリエラ",
            "text": "少し落ち着けたかしら…。\nアーヤの冷静さには\n全然及ばないけど…。",
            "zh": "好像稍微冷静下来一点了……。\n虽然和绫水的冷静\n完全没法比就是了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "556/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$の\nおかげね。",
            "zh": "这都是托了\n$marzanna$的福呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "557/TALK",
            "narrator": "ガブリエラ",
            "text": "戦場で仲間を\n信じるって\nこういうことなのね。",
            "zh": "在战场上信任同伴，\n原来就是\n这种感觉啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "560/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう…。",
            "zh": "谢谢你……。",
            "narrator_zh": "加布里埃拉"
        },
