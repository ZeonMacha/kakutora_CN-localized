{
    "dir": "chap21/daydra/dd_ch03_21_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "21305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "胸騒ぎの鼻＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "令人不安之鼻＜后篇＞"
    },
    "entry": [
        {
            "location": "572/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱり、手くらい\n握ってあげよう。",
            "zh": "……还是稍微牵一下\n她的手吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "574/TALK",
            "narrator": "ガブリエラ",
            "text": "こんな暗いんだし。",
            "zh": "毕竟这里这么黑。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "575/TALK",
            "narrator": "ガブリエラ",
            "text": "先輩として\n後輩を気に掛けるのは\n当たり前よね…。",
            "zh": "作为前辈，\n照顾后辈也是\n理所当然的嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "576/TALK",
            "narrator": "ガブリエラ",
            "text": "…よしっ！",
            "zh": "……好！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "581/TALK",
            "narrator": "ガブリエラ",
            "text": "…つばめ、手出して。\n握っててあげるから。",
            "zh": "……燕，把手伸出来。\n我牵着你走。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "584/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "哎？",
            "narrator_zh": "燕"
        },
        {
            "location": "585/TALK",
            "narrator": "ガブリエラ",
            "text": "やせ我慢してんの\nバレバレよ。",
            "zh": "你那点死撑早就\n暴露无遗啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "587/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなんで転んだり\nされても迷惑だし？",
            "zh": "要是那样摔倒了\n也是会添麻烦的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "589/TALK",
            "narrator": "ガブリエラ",
            "text": "奥に行くまで、\nあたしが引っ張って\nあげるわ。",
            "zh": "在走到最里面之前，\n就由我拉着你\n走吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "590/TALK",
            "narrator": "つばめ",
            "text": "…ありがと、\nガブちゃん。",
            "zh": "……谢谢，\n加布。",
            "narrator_zh": "燕"
        },
        {
            "location": "591/TALK",
            "narrator": "つばめ",
            "text": "でも大丈夫だよ。",
            "zh": "不过没关系的哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "593/TALK",
            "narrator": "ガブリエラ",
            "text": "…強がってるでしょ？",
            "zh": "……你是在逞强吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "594/TALK",
            "narrator": "つばめ",
            "text": "そ、そんなこと\nないよ。",
            "zh": "没、没有那回事\n啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "595/TALK",
            "narrator": "つばめ",
            "text": "それに、手を繋いだら\n歩きにくくなるから。",
            "zh": "而且，牵着手的话\n反而不容易走路嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "596/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんも\n転んじゃうかも\nしれないし。",
            "zh": "说不定连加布\n也会跟着摔倒\n的呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "598/TALK",
            "narrator": "ガブリエラ",
            "text": "…あっそ。\nなら、気を付けて\n歩きなさいよ？",
            "zh": "……哦，这样啊。\n那就给我小心点\n好好走路哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "599/TALK",
            "narrator": "つばめ",
            "text": "う、うん…。",
            "zh": "嗯、嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "603/TALK",
            "narrator": "ガブリエラ",
            "text": "…なによ、せっかく\n気にしてやったって\nいうのに…。",
            "zh": "……搞什么啊，我好心\n好意才关心你\n一下的说……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "604/TALK",
            "narrator": "ガブリエラ",
            "text": "無理に強がったって、\n自分が辛いだけじゃ\nない。",
            "zh": "就算硬撑着，\n难受的也只有\n自己而已嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "605/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、あたしのことも\n心配してくれてる\nのよね。",
            "zh": "算了，她也是在\n担心我才这么说的\n对吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "606/TALK",
            "narrator": "ガブリエラ",
            "text": "悪い気はしない\nけど…。",
            "zh": "虽然心里不坏\n就是了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "607/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんか、反応に困る\n断られ方だわ。",
            "zh": "……总觉得，这拒绝方式\n让人不知该怎么接话呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "634/TALK",
            "narrator": "みやび",
            "text": "…そろそろ到着や。",
            "zh": "……差不多到了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "635/TALK",
            "narrator": "ガブリエラ",
            "text": "え？　なんかここ、\nちょっと明るい？",
            "zh": "哎？　总觉得这里，\n稍微有点亮了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "637/TALK",
            "narrator": "アーヤ",
            "text": "…あっ、凄いわ！\nほら、天井に穴が\n空いてる！",
            "zh": "……啊，好厉害！\n你们看，头顶上\n有个洞！",
            "narrator_zh": "绫水"
        },
        {
            "location": "640/TALK",
            "narrator": "つばめ",
            "text": "え…わぁ！\n空が見えますよ！",
            "zh": "哎……哇啊！\n能看见天空哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "642/TALK",
            "narrator": "ガブリエラ",
            "text": "本当…みやび、\nここって何なの？",
            "zh": "真的耶……雅，\n这里到底是什么地方？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "644/TALK",
            "narrator": "みやび",
            "text": "さあ？　うちもよくは\n知らん。",
            "zh": "谁晓得喃？　我也不太\n清楚。",
            "narrator_zh": "雅"
        },
        {
            "location": "646/TALK",
            "narrator": "みやび",
            "text": "けんど、この場所は\n暗くて静かやき、\n考え事に最適ちや。",
            "zh": "不过，这地方又黑\n又安静啵，\n最适合想事情咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "647/TALK",
            "narrator": "みやび",
            "text": "やき、時々一人で来る\n秘密の場所ながよ。",
            "zh": "所以呀，是我时不时\n一个人来的秘密基地啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "649/TALK",
            "narrator": "神楽",
            "text": "こういう場所、\nテレビでは\n見ますけど。",
            "zh": "这种地方，\n电视里倒是\n经常看到。",
            "narrator_zh": "神乐"
        },
        {
            "location": "650/TALK",
            "narrator": "神楽",
            "text": "実際に来たのは\n初めてです。",
            "zh": "但实际亲眼见到，\n还是第一次。",
            "narrator_zh": "神乐"
        },
        {
            "location": "652/TALK",
            "narrator": "みやび",
            "text": "まあ、そこまで\nロマンチックな場所\nではないけんどな。",
            "zh": "算了，虽说也算不上\n什么特别浪漫的地方\n不过。",
            "narrator_zh": "雅"
        },
        {
            "location": "654/TALK",
            "narrator": "アーヤ",
            "text": "…どんなところに\n行くつもりなのかって\n思ったけど。",
            "zh": "……本来还在想，\n你到底打算带我们\n去什么地方呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "656/TALK",
            "narrator": "アーヤ",
            "text": "想像以上に面白い\nところに連れてきて\nもらえたわ。",
            "zh": "结果比想象中还要\n有趣得多，真是\n来值了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "658/TALK",
            "narrator": "みやび",
            "text": "…ガブちゃんは\nどうや？",
            "zh": "……加布觉得\n怎么样？",
            "narrator_zh": "雅"
        },
        {
            "location": "660/TALK",
            "narrator": "ガブリエラ",
            "text": "合格よ。",
            "zh": "合格了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "661/TALK",
            "narrator": "ガブリエラ",
            "text": "どうせなら\nもっと早く教えて\nほしかったわ。",
            "zh": "早知道这样，\n真希望你能早点\n告诉我们呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "663/TALK",
            "narrator": "みやび",
            "text": "秘密の場所\n言うたやろ？",
            "zh": "我都说是秘密\n基地咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "664/TALK",
            "narrator": "みやび",
            "text": "みんなは特別やき、\n教えたがよ。",
            "zh": "因为大家很特别啵，\n才告诉你们的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "666/TALK",
            "narrator": "つばめ",
            "text": "洞窟の中にいるのに\n空が見えるなんて、\nちょっと不思議だね。",
            "zh": "明明待在洞窟里面，\n却能看见天空，\n真有点不可思议呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "668/TALK",
            "narrator": "神楽",
            "text": "ふふっ、そうですね。",
            "zh": "呵呵，是啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "670/TALK",
            "narrator": "ガブリエラ",
            "text": "…つばめも、\nこれでもう怖くない\nみたいね。",
            "zh": "……燕这样一来，\n好像也就不怎么\n害怕了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "671/TALK",
            "narrator": "つばめ",
            "text": "それにしても、\n高い穴だねー。",
            "zh": "话说回来，\n好高的洞口呀～。",
            "narrator_zh": "燕"
        },
        {
            "location": "672/TALK",
            "narrator": "つばめ",
            "text": "上から覗いたら、\nちょっと怖いかも。",
            "zh": "要是从上面往下看，\n说不定还有点吓人呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "673/TALK",
            "narrator": "神楽",
            "text": "外からだと、真っ暗な\n穴にしか見えないと\n思いますしね。",
            "zh": "从外面看的话，应该\n只会觉得是个黑漆漆\n的洞穴吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "675/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "687/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ$marzanna$",
            "zh": "呐$marzanna$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "688/TALK",
            "narrator": "ガブリエラ",
            "text": "あなたはどんな時なら",
            "zh": "你觉得什么时候才",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "689/TALK",
            "narrator": "ガブリエラ",
            "text": "手をつないでもいいと思う？",
            "zh": "可以牵手呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "691/SEL",
            "narrator": "",
            "text": "恋人同士の時",
            "zh": "恋人们在一起的时候",
            "narrator_zh": ""
        },
        {
            "location": "692/SEL",
            "narrator": "",
            "text": "子供と歩く時",
            "zh": "牵着小孩子走的时候",
            "narrator_zh": ""
        },
        {
            "location": "693/SEL",
            "narrator": "",
            "text": "犯人を捕まえた時",
            "zh": "抓到犯人的时候",
            "narrator_zh": ""
        },
        {
            "location": "694/ACT",
            "narrator": "",
            "text": "恋人同士の時",
            "zh": "恋人们在一起的时候",
            "narrator_zh": ""
        },
        {
            "location": "695/TALK",
            "narrator": "ガブリエラ",
            "text": "確かにそうかも////////////////",
            "zh": "确实是那样也说不定////////////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "696/TALK",
            "narrator": "ガブリエラ",
            "text": "だったら",
            "zh": "那样的话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "697/TALK",
            "narrator": "ガブリエラ",
            "text": "断られても仕方ないかも",
            "zh": "被拒绝也是没办法的事呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "699/SEL",
            "narrator": "",
            "text": "つばめとは友達だからね",
            "zh": "毕竟你和燕只是朋友嘛",
            "narrator_zh": ""
        },
        {
            "location": "700/SEL",
            "narrator": "",
            "text": "恋人は$me$だからね",
            "zh": "因为你的恋人是$me$嘛",
            "narrator_zh": ""
        },
        {
            "location": "701/ACT",
            "narrator": "",
            "text": "つばめとは友達だからね",
            "zh": "毕竟你和燕只是朋友嘛",
            "narrator_zh": ""
        },
        {
            "location": "702/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "704/TALK",
            "narrator": "ガブリエラ",
            "text": "その通りよ",
            "zh": "正是如此",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "705/ACT",
            "narrator": "",
            "text": "恋人は$me$だからね",
            "zh": "因为你的恋人是$me$嘛",
            "narrator_zh": ""
        },
        {
            "location": "706/TALK",
            "narrator": "ガブリエラ",
            "text": "もう//////////////",
            "zh": "真是的//////////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "707/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなこと言わないの//////////",
            "zh": "别说这种话啦//////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "709/ACT",
            "narrator": "",
            "text": "子供と歩く時",
            "zh": "牵着小孩子走的时候",
            "narrator_zh": ""
        },
        {
            "location": "710/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "711/TALK",
            "narrator": "ガブリエラ",
            "text": "ちゃんと手を引いてあげないとね",
            "zh": "不好好牵着人家的手可不行呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "713/SEL",
            "narrator": "",
            "text": "つばめはああ見えて高校生だからね",
            "zh": "燕别看那样好歹也是高中生嘛",
            "narrator_zh": ""
        },
        {
            "location": "714/SEL",
            "narrator": "",
            "text": "ガブリエラももう中学生だしね",
            "zh": "加布里埃拉也已经是初中生了呢",
            "narrator_zh": ""
        },
        {
            "location": "715/ACT",
            "narrator": "",
            "text": "つばめはああ見えて高校生だからね",
            "zh": "燕别看那样好歹也是高中生嘛",
            "narrator_zh": ""
        },
        {
            "location": "716/TALK",
            "narrator": "ガブリエラ",
            "text": "もう子供って年じゃないわね",
            "zh": "确实已经不是小孩子的年纪了呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "717/ACT",
            "narrator": "",
            "text": "ガブリエラももう中学生だしね",
            "zh": "加布里埃拉也已经是初中生了呢",
            "narrator_zh": ""
        },
        {
            "location": "718/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "720/TALK",
            "narrator": "ガブリエラ",
            "text": "って",
            "zh": "不对",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "721/TALK",
            "narrator": "ガブリエラ",
            "text": "私が引く側なんだけど！！",
            "zh": "是我要去牵别人好不好！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "723/ACT",
            "narrator": "",
            "text": "犯人を捕まえた時",
            "zh": "抓到犯人的时候",
            "narrator_zh": ""
        },
        {
            "location": "724/TALK",
            "narrator": "ガブリエラ",
            "text": "えーと",
            "zh": "那个……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "725/TALK",
            "narrator": "ガブリエラ",
            "text": "何の話をしているのかしら？",
            "zh": "我们到底在聊什么啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "727/SEL",
            "narrator": "",
            "text": "民間人でも現行犯逮捕なら可能だから！",
            "zh": "因为普通市民也可以实施现行犯逮捕嘛！",
            "narrator_zh": ""
        },
        {
            "location": "728/SEL",
            "narrator": "",
            "text": "ガブリエラ捕物帖",
            "zh": "加布里埃拉捕物帖",
            "narrator_zh": ""
        },
        {
            "location": "729/ACT",
            "narrator": "",
            "text": "民間人でも現行犯逮捕なら可能だから！",
            "zh": "因为普通市民也可以实施现行犯逮捕嘛！",
            "narrator_zh": ""
        },
        {
            "location": "730/TALK",
            "narrator": "ガブリエラ",
            "text": "いえ待って",
            "zh": "不，等等",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "731/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな話は",
            "zh": "我可没在聊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "732/TALK",
            "narrator": "ガブリエラ",
            "text": "していないわよ！？！？！",
            "zh": "那种话题啊！？！？！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "733/ACT",
            "narrator": "",
            "text": "ガブリエラ捕物帖",
            "zh": "加布里埃拉捕物帖",
            "narrator_zh": ""
        },
        {
            "location": "734/TALK",
            "narrator": "ガブリエラ",
            "text": "なんだか",
            "zh": "总觉得",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "735/TALK",
            "narrator": "ガブリエラ",
            "text": "時代劇みたいで格好いいわｖｖｖｖｖｖｖｖｖｖｖｖｖｖ",
            "zh": "听起来像时代剧一样好帅气ｖｖｖｖｖｖｖｖｖｖｖｖｖｖ",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "736/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "737/TALK",
            "narrator": "ガブリエラ",
            "text": "今したい話とは",
            "zh": "这跟我现在想聊的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "738/TALK",
            "narrator": "ガブリエラ",
            "text": "違うんだけど",
            "zh": "完全不是一回事啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "754/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "756/TALK",
            "narrator": "神楽",
            "text": "つばめさん。",
            "zh": "燕。",
            "narrator_zh": "神乐"
        },
        {
            "location": "758/TALK",
            "narrator": "つばめ",
            "text": "なあに？",
            "zh": "什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "759/TALK",
            "narrator": "神楽",
            "text": "手を繋いでも\nいいですか？",
            "zh": "我可以牵你的手\n吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "761/TALK",
            "narrator": "つばめ",
            "text": "……えっ！？",
            "zh": "……哎！？",
            "narrator_zh": "燕"
        },
        {
            "location": "762/TALK",
            "narrator": "つばめ",
            "text": "な、何なの\nみんなして！？",
            "zh": "怎、怎么回事啊，\n大家都这样！？",
            "narrator_zh": "燕"
        },
        {
            "location": "763/TALK",
            "narrator": "神楽",
            "text": "みんな？",
            "zh": "大家？",
            "narrator_zh": "神乐"
        },
        {
            "location": "764/TALK",
            "narrator": "つばめ",
            "text": "えと、さっき\nガブちゃんにも\n言われて…。",
            "zh": "那个，刚才\n加布也这么\n问过我……。",
            "narrator_zh": "燕"
        },
        {
            "location": "765/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんも、\nこういうところって\n苦手なの？",
            "zh": "神乐也\n不太擅长应付\n这种地方吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "767/TALK",
            "narrator": "ガブリエラ",
            "text": "違うわよ！\nあたしはつばめが\n怖がってたから…。",
            "zh": "才不是那样！\n我只是看燕\n很害怕才……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "769/TALK",
            "narrator": "神楽",
            "text": "…慣れてない\n場所ですからね…。",
            "zh": "……毕竟是不习惯的\n地方嘛……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "770/TALK",
            "narrator": "神楽",
            "text": "少しだけ緊張は\nしてますね…。",
            "zh": "稍微有点\n紧张呢……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "772/TALK",
            "narrator": "神楽",
            "text": "だから、って\n思ったんですけど\nダメですか…？",
            "zh": "所以才想着\n要不要牵手，\n不行吗……？",
            "narrator_zh": "神乐"
        },
        {
            "location": "773/TALK",
            "narrator": "つばめ",
            "text": "えとね……。\n手をつなぐと却って\n危ないと思うんだ…。",
            "zh": "那个呀……。\n牵着手的话反而\n会更危险吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "774/TALK",
            "narrator": "つばめ",
            "text": "だから、ごめんね。",
            "zh": "所以，抱歉啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "776/TALK",
            "narrator": "神楽",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "778/TALK",
            "narrator": "つばめ",
            "text": "えっと…\n帰り道は歌でも\n歌っちゃおうか？",
            "zh": "那个……\n回去的路上，我们\n唱唱歌什么的吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "779/TALK",
            "narrator": "ガブリエラ",
            "text": "何よ…あたしの時と\n態度が違うじゃ\nない…。",
            "zh": "什么嘛……跟对我的时候\n态度完全不一样\n嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "781/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽にばっかり、\nそうやって…。",
            "zh": "老是只对神乐\n那个样子……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "783/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしに対しては\nそんな素振り、\n全然見せないのに…。",
            "zh": "对我却从来\n不露出那种\n神情……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "785/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしだって、\n友達なのに…。",
            "zh": "明明我也是\n你的朋友啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "786/TALK",
            "narrator": "ガブリエラ",
            "text": "…バカ。",
            "zh": "……笨蛋。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "789/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、\n何か言った？",
            "zh": "加维，\n你刚才说什么了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "792/TALK",
            "narrator": "ガブリエラ",
            "text": "何でもないわよ！",
            "zh": "什么都没有啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "803/DIALOG",
            "narrator": "Dialog_chapter_ch03",
            "text": "【17 告白】",
            "zh": "【17 告白】",
            "narrator_zh": "Dialog_chapter_ch03"
        }
    ]
}
