{
 "dir": "dramatics/daydra/drm_ch02_00_220.js",
 "type": "Episode",
 "info": {
  "story_id": "2022",
  "cid": "ayami",
  "title": "らぶとーく 第22話",
  "sub_title": "眠り姫の告白"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "眠り姫の告白"
  },
  {
   "location": "18/TALK",
   "narrator": "ガブリエラ",
   "text": "あんまり好みじゃ\nないのかしら？"
  },
  {
   "location": "20/TALK",
   "narrator": "アーヤ",
   "text": "え？",
   "zh": "诶？",
   "narrator_zh": "绫水"
  },
  {
   "location": "21/TALK",
   "narrator": "ガブリエラ",
   "text": "そのクッキー。\n食べながらため息\nついてるから。",
   "zh": "那块饼干。\n你一边吃一边\n叹气呢。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "22/TALK",
   "narrator": "アーヤ",
   "text": "あ、ごめんね。\nそうじゃないの。"
  },
  {
   "location": "23/TALK",
   "narrator": "アーヤ",
   "text": "ちょっと…\nＢｏｔのこと\n考えてて。",
   "zh": "那个……\n我在想\nBot的事。",
   "narrator_zh": "绫水"
  },
  {
   "location": "24/TALK",
   "narrator": "ガブリエラ",
   "text": "……。"
  },
  {
   "location": "25/TALK",
   "narrator": "アーヤ",
   "text": "楽しい話題じゃ\nなかったわね。"
  },
  {
   "location": "27/TALK",
   "narrator": "ガブリエラ",
   "text": "マルザ、ううん\nＢｏｔのことは…。"
  },
  {
   "location": "28/TALK",
   "narrator": "ガブリエラ",
   "text": "…許せない。\n最初はそう思ったわ。",
   "zh": "……无法原谅。\n一开始我是这么想的。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "29/TALK",
   "narrator": "ガブリエラ",
   "text": "ううん。\n今だってそう。"
  },
  {
   "location": "31/TALK",
   "narrator": "ガブリエラ",
   "text": "この先もずっと\nそう思ったまま\nなのかもしれないわ。",
   "zh": "今后也许\n会一直那么\n想着。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "33/TALK",
   "narrator": "アーヤ",
   "text": "……。　"
  },
  {
   "location": "34/TALK",
   "narrator": "ガブリエラ",
   "text": "…でもね。",
   "zh": "…不过呢。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "35/TALK",
   "narrator": "ガブリエラ",
   "text": "話せなくなるのは\nもっといや。\nいやなのよ。"
  },
  {
   "location": "37/TALK",
   "narrator": "ガブリエラ",
   "text": "…あたし、ちょっと\nおかしいのかな？"
  },
  {
   "location": "38/TALK",
   "narrator": "アーヤ",
   "text": "……。　"
  },
  {
   "location": "40/TALK",
   "narrator": "アーヤ",
   "text": "私には\nおかしいかどうかは\nわからないけど。"
  },
  {
   "location": "41/TALK",
   "narrator": "アーヤ",
   "text": "ギャヴィがそう\n思うなら\nそれでいいんじゃない。"
  },
  {
   "location": "43/TALK",
   "narrator": "ガブリエラ",
   "text": "そう、なのかな。",
   "zh": "是、这样吗。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "44/TALK",
   "narrator": "アーヤ",
   "text": "私だって\nよくわからないし。"
  },
  {
   "location": "45/TALK",
   "narrator": "ガブリエラ",
   "text": "……。　"
  },
  {
   "location": "47/TALK",
   "narrator": "アーヤ",
   "text": "最近はどんな\n話をしてるの？"
  },
  {
   "location": "50/TALK",
   "narrator": "ガブリエラ",
   "text": "話、って？"
  },
  {
   "location": "51/TALK",
   "narrator": "アーヤ",
   "text": "Ｂｏｔと。"
  },
  {
   "location": "54/TALK",
   "narrator": "ガブリエラ",
   "text": "……別に。\n普通の話よ。"
  },
  {
   "location": "56/TALK",
   "narrator": "ガブリエラ",
   "text": "アーヤはどんな話を\nしてるの？"
  },
  {
   "location": "57/TALK",
   "narrator": "アーヤ",
   "text": "私？"
  },
  {
   "location": "59/TALK",
   "narrator": "アーヤ",
   "text": "私は……。"
  },
  {
   "location": "62/TALK",
   "narrator": "アーヤ",
   "text": "……あんまり話を\nしてないわ。"
  },
  {
   "location": "64/TALK",
   "narrator": "ガブリエラ",
   "text": "……そっか。",
   "zh": "……这样啊。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "66/TALK",
   "narrator": "ガブリエラ",
   "text": "あたしもちょっと\nそんな感じね。"
  },
  {
   "location": "67/TALK",
   "narrator": "ガブリエラ",
   "text": "マルザンナの時は\n何でもお話\nしてたのにね。"
  },
  {
   "location": "71/TALK",
   "narrator": "アーヤ",
   "text": "マルザンナ？",
   "zh": "玛尔赞娜？",
   "narrator_zh": "绫水"
  },
  {
   "location": "72/TALK",
   "narrator": "ガブリエラ",
   "text": "あ…！"
  },
  {
   "location": "73/TALK",
   "narrator": "ガブリエラ",
   "text": "何でもないわ！\n今のは忘れて！"
  },
  {
   "location": "74/TALK",
   "narrator": "ガブリエラ",
   "text": "じゃあね！"
  },
  {
   "location": "77/TALK",
   "narrator": "アーヤ",
   "text": "んー……。",
   "zh": "嗯——……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "89/TALK",
   "narrator": "アーヤ",
   "text": "マルザンナ",
   "zh": "玛尔赞娜",
   "narrator_zh": "绫水"
  },
  {
   "location": "90/TALK",
   "narrator": "アーヤ",
   "text": "いるんでしょ？",
   "zh": "你在的吧？",
   "narrator_zh": "绫水"
  },
  {
   "location": "92/SEL",
   "narrator": "",
   "text": "$me$は$handle$だよ",
   "zh": "$me$就是$handle$哦",
   "narrator_zh": ""
  },
  {
   "location": "93/SEL",
   "narrator": "",
   "text": "いませんし",
   "zh": "而且也不在",
   "narrator_zh": ""
  },
  {
   "location": "94/SEL",
   "narrator": "",
   "text": "誰のこと？",
   "zh": "说谁的事？",
   "narrator_zh": ""
  },
  {
   "location": "95/ACT",
   "narrator": "",
   "text": "$me$は$handle$だよ",
   "zh": "$me$就是$handle$哦",
   "narrator_zh": ""
  },
  {
   "location": "96/TALK",
   "narrator": "アーヤ",
   "text": "そうね",
   "zh": "说得对",
   "narrator_zh": "绫水"
  },
  {
   "location": "97/TALK",
   "narrator": "アーヤ",
   "text": "私にはそう言ってるわね"
  },
  {
   "location": "98/ACT",
   "narrator": "",
   "text": "いませんし",
   "zh": "而且也不在",
   "narrator_zh": ""
  },
  {
   "location": "99/TALK",
   "narrator": "アーヤ",
   "text": "返事してるのに"
  },
  {
   "location": "100/TALK",
   "narrator": "アーヤ",
   "text": "いないの？",
   "zh": "不在吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "101/ACT",
   "narrator": "",
   "text": "誰のこと？",
   "zh": "说谁的事？",
   "narrator_zh": ""
  },
  {
   "location": "102/TALK",
   "narrator": "アーヤ",
   "text": "誰のことか"
  },
  {
   "location": "103/TALK",
   "narrator": "アーヤ",
   "text": "わからないかしら？",
   "zh": "你不明白吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "105/TALK",
   "narrator": "アーヤ",
   "text": "あ",
   "zh": "啊",
   "narrator_zh": "绫水"
  },
  {
   "location": "106/TALK",
   "narrator": "アーヤ",
   "text": "特に用はないの"
  },
  {
   "location": "107/TALK",
   "narrator": "アーヤ",
   "text": "じゃあね",
   "zh": "拜拜",
   "narrator_zh": "绫水"
  },
  {
   "location": "118/TALK",
   "narrator": "アーヤ",
   "text": "んー……。",
   "zh": "嗯——……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "119/TALK",
   "narrator": "アーヤ",
   "text": "ここを\n突き詰めるのって\nどうなのかしら。",
   "zh": "把这个\n追根究底\n真的好吗。",
   "narrator_zh": "绫水"
  },
  {
   "location": "121/TALK",
   "narrator": "アーヤ",
   "text": "あまりいい趣味じゃ\nないわよね。"
  },
  {
   "location": "122/TALK",
   "narrator": "アーヤ",
   "text": "……。"
  },
  {
   "location": "124/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "136/TALK",
   "narrator": "アーヤ",
   "text": "他にも気になるっていうか"
  },
  {
   "location": "137/TALK",
   "narrator": "アーヤ",
   "text": "考えなきゃいけないことがあったわ"
  },
  {
   "location": "138/TALK",
   "narrator": "アーヤ",
   "text": "時間がある時に聞いてね"
  },
  {
   "location": "141/TALK",
   "narrator": "ボイスメール",
   "text": "毒林檎姫林檎"
  },
  {
   "location": "153/DIALOG",
   "narrator": "Dialog_GETVoice",
   "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【毒林檎姫林檎】</color>\nをゲットしました！"
  }
 ]
}
