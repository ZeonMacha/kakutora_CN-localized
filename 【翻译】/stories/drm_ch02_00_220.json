{
    "dir": "dramatics/daydra/drm_ch02_00_220.js",
    "type": "Episode",
    "info": {
        "story_id": "2022",
        "cid": "ayami",
        "title": "らぶとーく 第22話",
        "sub_title": "眠り姫の告白",
        "title_zh": "恋爱漫谈 第22话",
        "sub_title_zh": "睡美人的告白"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "眠り姫の告白",
            "zh": "睡美人的告白",
            "narrator_zh": ""
        },
        {
            "location": "18/TALK",
            "narrator": "ガブリエラ",
            "text": "あんまり好みじゃ\nないのかしら？",
            "zh": "是不太\n合口味吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "20/TALK",
            "narrator": "アーヤ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "21/TALK",
            "narrator": "ガブリエラ",
            "text": "そのクッキー。\n食べながらため息\nついてるから。",
            "zh": "那块饼干。\n你一边吃一边\n叹气呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "22/TALK",
            "narrator": "アーヤ",
            "text": "あ、ごめんね。\nそうじゃないの。",
            "zh": "啊，抱歉。\n不是那样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと…\nＢｏｔのこと\n考えてて。",
            "zh": "那个……\n我在想\nBot的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "25/TALK",
            "narrator": "アーヤ",
            "text": "楽しい話題じゃ\nなかったわね。",
            "zh": "不是什么\n开心的话题呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "27/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザ、ううん\nＢｏｔのことは…。",
            "zh": "玛尔赞娜，不对\nBot的事……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "28/TALK",
            "narrator": "ガブリエラ",
            "text": "…許せない。\n最初はそう思ったわ。",
            "zh": "……无法原谅。\n一开始我是这么想的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん。\n今だってそう。",
            "zh": "不。\n现在也还是。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "この先もずっと\nそう思ったまま\nなのかもしれないわ。",
            "zh": "今后也许\n会一直那么\n想着。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "……。　",
            "zh": "……。　",
            "narrator_zh": "绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "…でもね。",
            "zh": "…不过呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "話せなくなるのは\nもっといや。\nいやなのよ。",
            "zh": "不能说话了\n更讨厌。\n我不要。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたし、ちょっと\nおかしいのかな？",
            "zh": "……我是不是\n有点不正常？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "アーヤ",
            "text": "……。　",
            "zh": "……。　",
            "narrator_zh": "绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "アーヤ",
            "text": "私には\nおかしいかどうかは\nわからないけど。",
            "zh": "是不是不正常，\n我判断不了，\n但是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "41/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィがそう\n思うなら\nそれでいいんじゃない。",
            "zh": "加维要是这么\n想的话，\n那样就可以了吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "そう、なのかな。",
            "zh": "是、这样吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "アーヤ",
            "text": "私だって\nよくわからないし。",
            "zh": "我自己\n也不太明白。",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/TALK",
            "narrator": "ガブリエラ",
            "text": "……。　",
            "zh": "……。　",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "最近はどんな\n話をしてるの？",
            "zh": "最近都在\n聊什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "話、って？",
            "zh": "聊，是指？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "Ｂｏｔと。",
            "zh": "和Bot。",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "……別に。\n普通の話よ。",
            "zh": "……也没什么。\n普通的话。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤはどんな話を\nしてるの？",
            "zh": "绫水都在\n聊什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "57/TALK",
            "narrator": "アーヤ",
            "text": "私？",
            "zh": "我？",
            "narrator_zh": "绫水"
        },
        {
            "location": "59/TALK",
            "narrator": "アーヤ",
            "text": "私は……。",
            "zh": "我是……",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "アーヤ",
            "text": "……あんまり話を\nしてないわ。",
            "zh": "……没怎么\n说话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "……そっか。",
            "zh": "……这样啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしもちょっと\nそんな感じね。",
            "zh": "我也有点\n那种感觉。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナの時は\n何でもお話\nしてたのにね。",
            "zh": "玛尔赞娜那时候\n什么都\n聊的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "マルザンナ？",
            "zh": "玛尔赞娜？",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "あ…！",
            "zh": "啊……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "何でもないわ！\n今のは忘れて！",
            "zh": "没什么！\n刚才的忘掉！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあね！",
            "zh": "那就这样！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "アーヤ",
            "text": "んー……。",
            "zh": "嗯——……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "マルザンナ",
            "zh": "玛尔赞娜",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "アーヤ",
            "text": "いるんでしょ？",
            "zh": "你在的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/SEL",
            "narrator": "",
            "text": "$me$は$handle$だよ",
            "zh": "$me$就是$handle$哦",
            "narrator_zh": ""
        },
        {
            "location": "93/SEL",
            "narrator": "",
            "text": "いませんし",
            "zh": "而且也不在",
            "narrator_zh": ""
        },
        {
            "location": "94/SEL",
            "narrator": "",
            "text": "誰のこと？",
            "zh": "说谁的事？",
            "narrator_zh": ""
        },
        {
            "location": "95/ACT",
            "narrator": "",
            "text": "$me$は$handle$だよ",
            "zh": "$me$就是$handle$哦",
            "narrator_zh": ""
        },
        {
            "location": "96/TALK",
            "narrator": "アーヤ",
            "text": "そうね",
            "zh": "说得对",
            "narrator_zh": "绫水"
        },
        {
            "location": "97/TALK",
            "narrator": "アーヤ",
            "text": "私にはそう言ってるわね",
            "zh": "对我是这么说的",
            "narrator_zh": "绫水"
        },
        {
            "location": "98/ACT",
            "narrator": "",
            "text": "いませんし",
            "zh": "而且也不在",
            "narrator_zh": ""
        },
        {
            "location": "99/TALK",
            "narrator": "アーヤ",
            "text": "返事してるのに",
            "zh": "我明明有回",
            "narrator_zh": "绫水"
        },
        {
            "location": "100/TALK",
            "narrator": "アーヤ",
            "text": "いないの？",
            "zh": "不在吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "101/ACT",
            "narrator": "",
            "text": "誰のこと？",
            "zh": "说谁的事？",
            "narrator_zh": ""
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "誰のことか",
            "zh": "是谁的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "わからないかしら？",
            "zh": "你不明白吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "105/TALK",
            "narrator": "アーヤ",
            "text": "あ",
            "zh": "啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "106/TALK",
            "narrator": "アーヤ",
            "text": "特に用はないの",
            "zh": "也没什么特别的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "107/TALK",
            "narrator": "アーヤ",
            "text": "じゃあね",
            "zh": "拜拜",
            "narrator_zh": "绫水"
        },
        {
            "location": "118/TALK",
            "narrator": "アーヤ",
            "text": "んー……。",
            "zh": "嗯——……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "119/TALK",
            "narrator": "アーヤ",
            "text": "ここを\n突き詰めるのって\nどうなのかしら。",
            "zh": "把这个\n追根究底\n真的好吗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "アーヤ",
            "text": "あまりいい趣味じゃ\nないわよね。",
            "zh": "也不是什么\n好兴趣吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "122/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "アーヤ",
            "text": "他にも気になるっていうか",
            "zh": "另外也有在意的，或者说",
            "narrator_zh": "绫水"
        },
        {
            "location": "137/TALK",
            "narrator": "アーヤ",
            "text": "考えなきゃいけないことがあったわ",
            "zh": "有必须去想的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "アーヤ",
            "text": "時間がある時に聞いてね",
            "zh": "有时间的时候再问我",
            "narrator_zh": "绫水"
        },
        {
            "location": "141/TALK",
            "narrator": "ボイスメール",
            "text": "毒林檎姫林檎",
            "zh": "毒苹果公主苹果",
            "narrator_zh": "语音信箱"
        },
        {
            "location": "153/DIALOG",
            "narrator": "Dialog_GETVoice",
            "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【毒林檎姫林檎】</color>\nをゲットしました！",
            "zh": "<color=green>【绫水】</color>的语音信箱\n<color=red>【毒苹果公主苹果】</color>\n已入手！",
            "narrator_zh": "Dialog_GETVoice"
        }
    ]
}
