 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "どきがむねむねする理由",
   "zh": "心口怦怦跳的理由",
   "narrator_zh": ""
  },
  {
   "location": "13/DIALOG",
   "narrator": "",
   "text": "<size=40>KOKORO-Lv. 05</size>\nTSUBAME - OHSE\n\n<size=40>どきがむねむねする</size>\n<size=35>～それは何かヘンですね～</size>",
   "zh": "<size=40>KOKORO-Lv. 05</size>\n逢濑燕\n\n<size=40>心口怦怦跳</size>\n<size=35>～总觉得有点怪呢～</size>",
   "narrator_zh": ""
  },
  {
   "location": "29/TALK",
   "narrator": "神楽",
   "text": "はあっ！\nもう、つばめさんったら\n本当に可愛いですね！",
   "zh": "哈啊！\n真是的，燕也\n太可爱了！",
   "narrator_zh": "神乐"
  },
  {
   "location": "31/TALK",
   "narrator": "つばめ",
   "text": "えーっ、\nそんなことないよぅ。",
   "zh": "诶——，\n才没有呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "32/TALK",
   "narrator": "つばめ",
   "text": "卯月さんの方が\n全然かわいいし。",
   "zh": "卯月才\n可爱得多。",
   "narrator_zh": "燕"
  },
  {
   "location": "35/TALK",
   "narrator": "神楽",
   "text": "そんな謙遜しちゃう\nところも、とっても\nキュートですっ！",
   "zh": "会这么谦虚的地方，\n也非常\n可爱！",
   "narrator_zh": "神乐"
  },
  {
   "location": "37/TALK",
   "narrator": "神楽",
   "text": "でもそんなに\n可愛いことばかり\n言ってると――",
   "zh": "可是你要是一直\n说这么可爱的话\n——",
   "narrator_zh": "神乐"
  },
  {
   "location": "40/TALK",
   "narrator": "神楽",
   "text": "また色んなトコ\n揉んじゃいますよっ？",
   "zh": "我又要揉\n你各种地方了哦？",
   "narrator_zh": "神乐"
  },
  {
   "location": "41/SEL",
   "narrator": "（選択肢）",
   "text": "じーっ",
   "zh": "盯——",
   "narrator_zh": "（选项）"
  },
  {
   "location": "42/SEL",
   "narrator": "（選択肢）",
   "text": "ガタッ！",
   "zh": "哐当！",
   "narrator_zh": "（选项）"
  },
  {
   "location": "43/ACT",
   "narrator": "",
   "text": "じーっ",
   "zh": "盯——",
   "narrator_zh": ""
  },
  {
   "location": "44/TALK",
   "narrator": "つばめ",
   "text": "ええええっ！！\nこ、今度は\nどこなのかなぁ～…っ",
   "zh": "诶诶诶诶！！\n这、这次\n是哪里呀～……",
   "narrator_zh": "燕"
  },
  {
   "location": "46/TALK",
   "narrator": "神楽",
   "text": "…？",
   "zh": "……？",
   "narrator_zh": "神乐"
  },
  {
   "location": "49/TALK",
   "narrator": "神楽",
   "text": "つばめさん、\nあの人は誰ですか？",
   "zh": "燕，\n那个人是谁？",
   "narrator_zh": "神乐"
  },
  {
   "location": "51/TALK",
   "narrator": "つばめ",
   "text": "えっ？",
   "zh": "诶？",
   "narrator_zh": "燕"
  },
  {
   "location": "52/ACT",
   "narrator": "",
   "text": "ガタッ！",
   "zh": "哐当！",
   "narrator_zh": ""
  },
  {
   "location": "56/TALK",
   "narrator": "神楽",
   "text": "キャッ！",
   "zh": "呀！",
   "narrator_zh": "神乐"
  },
  {
   "location": "58/TALK",
   "narrator": "つばめ",
   "text": "えっ！？",
   "zh": "诶！？",
   "narrator_zh": "燕"
  },
  {
   "location": "61/TALK",
   "narrator": "神楽",
   "text": "つ、つばめさん！\nこの人誰ですかっ？",
   "zh": "燕、燕！\n这个人是谁？",
   "narrator_zh": "神乐"
  },
  {
   "location": "62/TALK",
   "narrator": "つばめ",
   "text": "あっ、え、ええと…",
   "zh": "啊，呃，那个……",
   "narrator_zh": "燕"
  },
  {
   "location": "63/SEL",
   "narrator": "（選択肢）",
   "text": "照れずに紹介してよ",
   "zh": "别害羞，介绍一下呀",
   "narrator_zh": "（选项）"
  },
  {
   "location": "64/SEL",
   "narrator": "（選択肢）",
   "text": "$handle$です(ｷﾘｯ",
   "zh": "我是$handle$(ｷﾘｯ",
   "narrator_zh": "（选项）"
  },
  {
   "location": "65/ACT",
   "narrator": "",
   "text": "照れずに紹介してよ",
   "zh": "别害羞，介绍一下呀",
   "narrator_zh": ""
  },
  {
   "location": "67/TALK",
   "narrator": "つばめ",
   "text": "べ、別に照れてる\nわけじゃないよ！",
   "zh": "我、我才没有\n在害羞！",
   "narrator_zh": "燕"
  },
  {
   "location": "69/TALK",
   "narrator": "つばめ",
   "text": "この人は\n$handle$さんだよ。",
   "zh": "这个人是\n$handle$。",
   "narrator_zh": "燕"
  },
  {
   "location": "71/TALK",
   "narrator": "神楽",
   "text": "なんだ、つばめさんの\n知り合いなんですね。",
   "zh": "原来是燕的\n熟人呀。",
   "narrator_zh": "神乐"
  },
  {
   "location": "72/ACT",
   "narrator": "",
   "text": "$handle$です(ｷﾘｯ",
   "zh": "我是$handle$(ｷﾘｯ",
   "narrator_zh": ""
  },
  {
   "location": "73/TALK",
   "narrator": "神楽",
   "text": "………。",
   "zh": "………。",
   "narrator_zh": "神乐"
  },
  {
   "location": "75/TALK",
   "narrator": "神楽",
   "text": "つばめさんの\n知り合いですか？",
   "zh": "是燕的\n熟人吗？",
   "narrator_zh": "神乐"
  },
  {
   "location": "77/TALK",
   "narrator": "つばめ",
   "text": "えっ？\nあ、うん。そうだよ？",
   "zh": "诶？\n啊，嗯。是呀？",
   "narrator_zh": "燕"
  },
  {
   "location": "78/TALK",
   "narrator": "神楽",
   "text": "ふーん……\nつばめさんって案外…",
   "zh": "哼——……\n燕意外地……",
   "narrator_zh": "神乐"
  },
  {
   "location": "80/TALK",
   "narrator": "つばめ",
   "text": "え？",
   "zh": "诶？",
   "narrator_zh": "燕"
  },
  {
   "location": "81/TALK",
   "narrator": "神楽",
   "text": "いえ、\nなんでもありません。",
   "zh": "不，\n没什么。",
   "narrator_zh": "神乐"
  },
  {
   "location": "83/TALK",
   "narrator": "神楽",
   "text": "それより、どうして急に\n$handle$さんを\n呼んだんですか？",
   "zh": "比起这个，为什么突然\n把$handle$\n叫来了？",
   "narrator_zh": "神乐"
  },
  {
   "location": "84/TALK",
   "narrator": "つばめ",
   "text": "いや、\n私が呼んだわけじゃ…",
   "zh": "不，\n不是我叫来的……",
   "narrator_zh": "燕"
  },
  {
   "location": "85/TALK",
   "narrator": "神楽",
   "text": "ああっ！\nわかりましたっ！\nつばめさん……",
   "zh": "啊啊！\n我明白了！\n燕……",
   "narrator_zh": "神乐"
  },
  {
   "location": "89/TALK",
   "narrator": "神楽",
   "text": "人に見られながら\n色々されちゃうのが\nいいんですねっ！",
   "zh": "原来你喜欢\n被人看着\n做各种事呀！",
   "narrator_zh": "神乐"
  },
  {
   "location": "92/TALK",
   "narrator": "つばめ",
   "text": "ち、ちがうよ～～！",
   "zh": "不、不是的～～！",
   "narrator_zh": "燕"
  },
  {
   "location": "93/TALK",
   "narrator": "神楽",
   "text": "照れなくても\nいいんですよっ！",
   "zh": "不用害羞\n也没关系呀！",
   "narrator_zh": "神乐"
  },
  {
   "location": "94/SEL",
   "narrator": "（選択肢）",
   "text": "あ、あのー……",
   "zh": "啊，那个……",
   "narrator_zh": "（选项）"
  },
  {
   "location": "95/SEL",
   "narrator": "（選択肢）",
   "text": "$me$も混ぜて！",
   "zh": "把$me$也算上！",
   "narrator_zh": "（选项）"
  },
  {
   "location": "96/SEL",
   "narrator": "（選択肢）",
   "text": "$me$という者がありながらなんてことを！",
   "zh": "有$me$在，你还做这种事！",
   "narrator_zh": "（选项）"
  },
  {
   "location": "97/ACT",
   "narrator": "",
   "text": "あ、あのー……",
   "zh": "啊，那个……",
   "narrator_zh": ""
  },
  {
   "location": "99/TALK",
   "narrator": "神楽",
   "text": "あっ！\nごめんなさい！",
   "zh": "啊！\n对不起！",
   "narrator_zh": "神乐"
  },
  {
   "location": "101/TALK",
   "narrator": "神楽",
   "text": "つばめさん、\n$handle$さんも\n混ざりたいみたいです！",
   "zh": "燕，\n$handle$\n好像也想加入！",
   "narrator_zh": "神乐"
  },
  {
   "location": "103/TALK",
   "narrator": "神楽",
   "text": "せっかくですから、\n３人で\n楽しみましょうっ！",
   "zh": "难得这样，\n我们三个\n一起享受吧！",
   "narrator_zh": "神乐"
  },
  {
   "location": "106/TALK",
   "narrator": "つばめ",
   "text": "えっ？",
   "zh": "诶？",
   "narrator_zh": "燕"
  },
  {
   "location": "107/SEL",
   "narrator": "（選択肢）",
   "text": "あ、いや…",
   "zh": "啊，不是……",
   "narrator_zh": "（选项）"
  },
  {
   "location": "108/ACT",
   "narrator": "",
   "text": "あ、いや…",
   "zh": "啊，不是……",
   "narrator_zh": ""
  },
  {
   "location": "113/TALK",
   "narrator": "つばめ",
   "text": "う、うん。\n全然いいけど……",
   "zh": "嗯、嗯。\n完全可以……",
   "narrator_zh": "燕"
  },
  {
   "location": "114/ACT",
   "narrator": "",
   "text": "$me$も混ぜて！",
   "zh": "把$me$也算上！",
   "narrator_zh": ""
  },
  {
   "location": "116/TALK",
   "narrator": "神楽",
   "text": "もちろんですっ！",
   "zh": "当然可以！",
   "narrator_zh": "神乐"
  },
  {
   "location": "118/TALK",
   "narrator": "神楽",
   "text": "ね、つばめさん？\n３人で楽しみましょう！",
   "zh": "对吧，燕？\n我们三个一起享受吧！",
   "narrator_zh": "神乐"
  },
  {
   "location": "120/TALK",
   "narrator": "つばめ",
   "text": "え？\nあ、うん……いいよ？",
   "zh": "诶？\n啊，嗯……可以呀？",
   "narrator_zh": "燕"
  },
  {
   "location": "121/SEL",
   "narrator": "（選択肢）",
   "text": "えっ！？ほんと？",
   "zh": "诶！？真的？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "122/ACT",
   "narrator": "",
   "text": "えっ！？ほんと？",
   "zh": "诶！？真的？",
   "narrator_zh": ""
  },
  {
   "location": "124/ACT",
   "narrator": "",
   "text": "$me$という者がありながらなんてことを！",
   "zh": "有$me$在，你还做这种事！",
   "narrator_zh": ""
  },
  {
   "location": "126/TALK",
   "narrator": "神楽",
   "text": "きゃー！\nそういう関係だったん\nですねっ！",
   "zh": "呀——！\n原来是这种\n关系呀！",
   "narrator_zh": "神乐"
  },
  {
   "location": "128/TALK",
   "narrator": "神楽",
   "text": "なら、３人で\n楽しみましょうっ！",
   "zh": "那就三个一起\n享受吧！",
   "narrator_zh": "神乐"
  },
  {
   "location": "130/TALK",
   "narrator": "つばめ",
   "text": "え……えええっ！？",
   "zh": "诶……诶诶诶！？",
   "narrator_zh": "燕"
  },
  {
   "location": "131/TALK",
   "narrator": "つばめ",
   "text": "ま、まあ、いいけど…",
   "zh": "也、也好，可以是可以……",
   "narrator_zh": "燕"
  },
  {
   "location": "132/SEL",
   "narrator": "（選択肢）",
   "text": "えっ！？本気？",
   "zh": "诶！？认真的？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "133/ACT",
   "narrator": "",
   "text": "えっ！？本気？",
   "zh": "诶！？认真的？",
   "narrator_zh": ""
  },
  {
   "location": "137/TALK",
   "narrator": "神楽",
   "text": "流石つばめさんですっ！",
   "zh": "不愧是燕！",
   "narrator_zh": "神乐"
  },
  {
   "location": "138/TALK",
   "narrator": "潜在つばめ",
   "text": "ちょっと待って！！",
   "zh": "等一下！！",
   "narrator_zh": "潜在燕"
  },
  {
   "location": "142/TALK",
   "narrator": "神楽",
   "text": "あらっ！",
   "zh": "哎呀！",
   "narrator_zh": "神乐"
  },
  {
   "location": "144/TALK",
   "narrator": "つばめ",
   "text": "わ、わたし！？",
   "zh": "我、我！？",
   "narrator_zh": "燕"
  },
  {
   "location": "145/TALK",
   "narrator": "潜在つばめ",
   "text": "ちょっと、そこの\nわたしと卯月さん！\n二人ともどうかしてる！",
   "zh": "喂，那边的\n我和卯月！\n你们两个都不正常！",
   "narrator_zh": "潜在燕"
  },
  {
   "location": "146/SEL",
   "narrator": "（選択肢）",
   "text": "ですよねー",
   "zh": "就是说呀——",
   "narrator_zh": "（选项）"
  },
  {
   "location": "147/SEL",
   "narrator": "（選択肢）",
   "text": "そんなことないよ！",
   "zh": "才没有！",
   "narrator_zh": "（选项）"
  },
  {
   "location": "148/ACT",
   "narrator": "",
   "text": "ですよねー",
   "zh": "就是说呀——",
   "narrator_zh": ""
  },
  {
   "location": "149/ACT",
   "narrator": "",
   "text": "そんなことないよ！",
   "zh": "才没有！",
   "narrator_zh": ""
  },
  {
   "location": "152/TALK",
   "narrator": "潜在つばめ",
   "text": "$handle$さんは\n黙ってて！",
   "zh": "$handle$\n你安静！",
   "narrator_zh": "潜在燕"
  },
  {
   "location": "154/TALK",
   "narrator": "神楽",
   "text": "あっ…と、私ちょっと\nお花を摘みに\n行ってきますね！",
   "zh": "啊……那个，我稍微\n去摘朵花\n就回来！",
   "narrator_zh": "神乐"
  },
  {
   "location": "159/TALK",
   "narrator": "潜在つばめ",
   "text": "さて。そこのわたし！\n一体何を考えてるの？",
   "zh": "好了。那边的我！\n你到底在想什么？",
   "narrator_zh": "潜在燕"
  },
  {
   "location": "161/TALK",
   "narrator": "つばめ",
   "text": "ええっ？\nな、何かおかしなこと\n言ったかなぁ？",
   "zh": "诶诶？\n我、我说了什么\n奇怪的话吗？",
   "narrator_zh": "燕"
  },
  {
   "location": "162/TALK",
   "narrator": "潜在つばめ",
   "text": "３人で楽しみましょう\nなんて、卯月さんが\n言うわけないじゃん！",
   "zh": "“我们三个一起享受”\n这种话，卯月\n才不会说！",
   "narrator_zh": "潜在燕"
  },
  {
   "location": "163/TALK",
   "narrator": "潜在つばめ",
   "text": "あなたの勝手な妄想で\nわたしのイメージを\n汚すのはやめて！",
   "zh": "别用你随便的妄想\n弄脏我的\n形象！",
   "narrator_zh": "潜在燕"
  },
  {
   "location": "164/TALK",
   "narrator": "つばめ",
   "text": "汚してないよ！",
   "zh": "我没有弄脏！",
   "narrator_zh": "燕"
  },
  {
   "location": "166/TALK",
   "narrator": "潜在つばめ",
   "text": "そんなことない。\n$handle$さんも\nそう思うよね？",
   "zh": "才不是。\n$handle$\n也这么想吧？",
   "narrator_zh": "潜在燕"
  },
  {
   "location": "167/SEL",
   "narrator": "（選択肢）",
   "text": "イエス！つばめがイチャイチャすべきは$me$！",
   "zh": "Yes！燕该腻歪的对象是$me$！",
   "narrator_zh": "（选项）"
  },
  {
   "location": "168/SEL",
   "narrator": "（選択肢）",
   "text": "いえ、３人の方が楽しいですよ？",
   "zh": "不，三个人更开心呀？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "169/ACT",
   "narrator": "",
   "text": "イエス！つばめがイチャイチャすべきは$me$！",
   "zh": "Yes！燕该腻歪的对象是$me$！",
   "narrator_zh": ""
  },
  {
   "location": "170/TALK",
   "narrator": "潜在つばめ",
   "text": "それも違うよ。",
   "zh": "那也不对。",
   "narrator_zh": "潜在燕"
  },
  {
   "location": "171/ACT",
   "narrator": "",
   "text": "３人の方が楽しいですよ？",
   "zh": "不，三个人更开心呀？",
   "narrator_zh": ""
  },
  {
   "location": "172/TALK",
   "narrator": "潜在つばめ",
   "text": "いいえ！",
   "zh": "不对！",
   "narrator_zh": "潜在燕"
  },
  {
   "location": "176/TALK",
   "narrator": "潜在つばめ",
   "text": "わたしがイチャコラ\nすべきなのは、\n卯月さんだけだよ！",
   "zh": "我该腻歪的，\n只有\n卯月一个人！",
