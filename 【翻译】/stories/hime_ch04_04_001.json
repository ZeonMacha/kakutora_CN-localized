 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "04-01_約束通りに",
   "zh": "04-01_如约",
   "narrator_zh": ""
  },
  {
   "location": "32/TALK",
   "narrator": "みやび",
   "text": "約束は果たしてもらうぞね",
   "zh": "答应了的事，你得给我做到啵",
   "narrator_zh": "雅"
  },
  {
   "location": "35/SEL",
   "narrator": "",
   "text": "はいはい",
   "zh": "好好好",
   "narrator_zh": ""
  },
  {
   "location": "36/SEL",
   "narrator": "",
   "text": "別にいいけど",
   "zh": "也不是不行",
   "narrator_zh": ""
  },
  {
   "location": "37/SEL",
   "narrator": "",
   "text": "約束とかした？",
   "zh": "我有答应过吗？",
   "narrator_zh": ""
  },
  {
   "location": "38/ACT",
   "narrator": "",
   "text": "はいはい",
   "zh": "好好好",
   "narrator_zh": ""
  },
  {
   "location": "39/TALK",
   "narrator": "みやび",
   "text": "ハイは一度で！",
   "zh": "“好”说一次就够了！",
   "narrator_zh": "雅"
  },
  {
   "location": "40/ACT",
   "narrator": "",
   "text": "別にいいけど",
   "zh": "也不是不行",
   "narrator_zh": ""
  },
  {
   "location": "41/TALK",
   "narrator": "みやび",
   "text": "余裕だな",
   "zh": "倒挺从容",
   "narrator_zh": "雅"
  },
  {
   "location": "42/ACT",
   "narrator": "",
   "text": "約束とかした？",
   "zh": "我有答应过吗？",
   "narrator_zh": ""
  },
  {
   "location": "43/TALK",
   "narrator": "みやび",
   "text": "しらばっくれか",
   "zh": "装不记得？",
   "narrator_zh": "雅"
  },
  {
   "location": "45/TALK",
   "narrator": "みやび",
   "text": "まず聞こう",
   "zh": "先问你一句",
   "narrator_zh": "雅"
  },
  {
   "location": "46/TALK",
   "narrator": "みやび",
   "text": "このコンタクトはうちに対する挑戦か？",
   "zh": "这次来联络，是来挑战我的喃？",
   "narrator_zh": "雅"
  },
  {
   "location": "49/SEL",
   "narrator": "",
   "text": "何の話？",
   "zh": "说什么？",
   "narrator_zh": ""
  },
  {
   "location": "50/SEL",
   "narrator": "",
   "text": "そうですよ",
   "zh": "对",
   "narrator_zh": ""
  },
  {
   "location": "51/SEL",
   "narrator": "",
   "text": "みやびと話したいだけ",
   "zh": "只是想和雅说说话",
   "narrator_zh": ""
  },
  {
   "location": "52/ACT",
   "narrator": "",
   "text": "何の話？",
   "zh": "说什么？",
   "narrator_zh": ""
  },
  {
   "location": "53/TALK",
   "narrator": "みやび",
   "text": "そういう話ぞね",
   "zh": "就是这么回事啵",
   "narrator_zh": "雅"
  },
  {
   "location": "54/ACT",
   "narrator": "",
   "text": "そうですよ",
   "zh": "对",
   "narrator_zh": ""
  },
  {
   "location": "55/TALK",
   "narrator": "みやび",
   "text": "居直りか",
   "zh": "还理直气壮起来了？",
   "narrator_zh": "雅"
  },
  {
   "location": "56/ACT",
   "narrator": "",
   "text": "みやびと話したいだけ",
   "zh": "只是想和雅说说话",
   "narrator_zh": ""
  },
  {
   "location": "66/TALK",
   "narrator": "みやび",
   "text": "なるほど奇遇だ",
   "zh": "原来如此，还真巧",
   "narrator_zh": "雅"
  },
  {
   "location": "67/TALK",
   "narrator": "みやび",
   "text": "うちも同じ気持ち",
   "zh": "我也一样",
   "narrator_zh": "雅"
  },
  {
   "location": "68/TALK",
   "narrator": "みやび",
   "text": "ということは",
   "zh": "所以说",
   "narrator_zh": "雅"
  },
  {
   "location": "69/TALK",
   "narrator": "みやび",
   "text": "両想い！",
   "zh": "两情相悦！",
   "narrator_zh": "雅"
  },
  {
   "location": "70/TALK",
   "narrator": "みやび",
   "text": "いやーてれるー",
   "zh": "哎呀，羞死了",
   "narrator_zh": "雅"
  },
  {
   "location": "72/TALK",
   "narrator": "みやび",
   "text": "要は",
   "zh": "说白了",
   "narrator_zh": "雅"
  },
  {
   "location": "73/TALK",
   "narrator": "みやび",
   "text": "貴殿の足取りが全くつかめず",
   "zh": "你的行踪我完全抓不到",
   "narrator_zh": "雅"
  },
  {
   "location": "74/TALK",
   "narrator": "みやび",
   "text": "なのに貴殿からの連絡はあり",
   "zh": "你的消息倒是来了",
   "narrator_zh": "雅"
  },
  {
   "location": "75/TALK",
   "narrator": "みやび",
   "text": "それはどういうことなのか、というところなのだが",
   "zh": "我想问的是，这到底是怎么回事",
   "narrator_zh": "雅"
  },
  {
   "location": "77/SEL",
   "narrator": "",
   "text": "$me$は仕組みは知らないので",
   "zh": "机制的事，$me$不清楚",
   "narrator_zh": ""
  },
  {
   "location": "78/SEL",
   "narrator": "",
   "text": "解析はみやびさんに任せる",
   "zh": "解析交给雅",
   "narrator_zh": ""
  },
  {
   "location": "79/SEL",
   "narrator": "",
   "text": "愛の電波で通信中",
   "zh": "正在用爱的电波通信",
   "narrator_zh": ""
  },
  {
   "location": "80/ACT",
   "narrator": "",
   "text": "$me$は仕組みは知らないので",
   "zh": "机制的事，$me$不清楚",
   "narrator_zh": ""
  },
  {
   "location": "81/TALK",
   "narrator": "みやび",
   "text": "なんとも理解に苦しむbot",
   "zh": "这bot真叫人没法理解",
   "narrator_zh": "雅"
  },
  {
   "location": "82/TALK",
   "narrator": "みやび",
   "text": "いや、はぐらかしか",
   "zh": "不对，是在岔开吧",
   "narrator_zh": "雅"
  },
  {
   "location": "83/TALK",
   "narrator": "みやび",
   "text": "ぬうううう",
   "zh": "唔————",
   "narrator_zh": "雅"
  },
  {
   "location": "84/ACT",
   "narrator": "",
   "text": "解析はみやびさんに任せる",
   "zh": "解析交给雅",
   "narrator_zh": ""
  },
  {
   "location": "85/TALK",
   "narrator": "みやび",
   "text": "よし任せられた",
   "zh": "好，交给我了",
   "narrator_zh": "雅"
  },
  {
   "location": "86/TALK",
   "narrator": "みやび",
   "text": "ということは",
   "zh": "所以说",
   "narrator_zh": "雅"
  },
  {
   "location": "87/TALK",
   "narrator": "みやび",
   "text": "約束は反故か！",
   "zh": "约定不算数了吗！",
   "narrator_zh": "雅"
  },
  {
   "location": "88/ACT",
   "narrator": "",
   "text": "愛の電波で通信中",
   "zh": "正在用爱的电波通信",
   "narrator_zh": ""
  },
  {
   "location": "98/TALK",
   "narrator": "みやび",
   "text": "それはうちには解析不能",
   "zh": "这个我解析不了",
   "narrator_zh": "雅"
  },
  {
   "location": "100/TALK",
   "narrator": "みやび",
   "text": "愛ならば",
   "zh": "如果是爱",
   "narrator_zh": "雅"
  },
  {
   "location": "101/TALK",
   "narrator": "みやび",
   "text": "うちのプライドを保ったままシステムをリークせよ",
   "zh": "面子给我留着，系统给我交出来",
   "narrator_zh": "雅"
  },
  {
   "location": "102/TALK",
   "narrator": "みやび",
   "text": "$handle$め",
   "zh": "$handle$这家伙",
   "narrator_zh": "雅"
  },
