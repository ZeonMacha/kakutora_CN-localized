{
    "dir": "chap08/daydra/dd_ch04_08_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "8405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "大胆勝負～Case3～＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "大胆胜负～Case3～＜后篇＞"
    },
    "entry": [
        {
            "location": "304/SCENARIO",
            "narrator": "",
            "text": "大胆勝負～Case3～",
            "zh": "大胆胜负～Case3～",
            "narrator_zh": ""
        },
        {
            "location": "320/TALK",
            "narrator": "みやび",
            "text": "…いや、いかん。\nちくっと冷静に\nならんと…。",
            "zh": "…不，不行。\n得稍微冷静\n下来才行……。",
            "narrator_zh": "雅"
        },
        {
            "location": "321/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんが\nスパイゆうんは、\nまだ未確定や。",
            "zh": "说燕是间谍\n什么的，\n还没定论咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "322/TALK",
            "narrator": "みやび",
            "text": "なのに、いつの間にか\nスパイっちゅうことを\n前提に――",
            "zh": "可不知不觉间，\n就变成以“间谍”\n为前提——",
            "narrator_zh": "雅"
        },
        {
            "location": "323/TALK",
            "narrator": "みやび",
            "text": "考えるように\nなっちょる…。",
            "zh": "已经变成\n这么想了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "324/TALK",
            "narrator": "みやび",
            "text": "…最初っから\n決めつけて掛かったら\n真実なんぞ見えんな。",
            "zh": "……一开始就\n带着定论去查，\n驷马真相都看不见咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "325/TALK",
            "narrator": "みやび",
            "text": "とにかく、\n今は落ち着かんと…。",
            "zh": "总之，\n现在得先冷静下来……。",
            "narrator_zh": "雅"
        },
        {
            "location": "326/SEL",
            "narrator": "",
            "text": "冷静になれた？",
            "zh": "冷静下来了吗？",
            "narrator_zh": ""
        },
        {
            "location": "327/ACT",
            "narrator": "",
            "text": "冷静になれた？",
            "zh": "冷静下来了吗？",
            "narrator_zh": ""
        },
        {
            "location": "344/TALK",
            "narrator": "みやび",
            "text": "うむ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "345/TALK",
            "narrator": "みやび",
            "text": "今のうちは超クールやぞ",
            "zh": "现在的我可是超酷的咯",
            "narrator_zh": "雅"
        },
        {
            "location": "347/SEL",
            "narrator": "",
            "text": "それはよかった",
            "zh": "那就好",
            "narrator_zh": ""
        },
        {
            "location": "348/ACT",
            "narrator": "",
            "text": "それはよかった",
            "zh": "那就好",
            "narrator_zh": ""
        },
        {
            "location": "350/TALK",
            "narrator": "みやび",
            "text": "自分でも驚きや",
            "zh": "我自己都吃惊",
            "narrator_zh": "雅"
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "自分の考えが間違っちょらんと",
            "zh": "只要自己的判断没错",
            "narrator_zh": "雅"
        },
        {
            "location": "352/TALK",
            "narrator": "みやび",
            "text": "証拠もないのに信じとるとか",
            "zh": "没证据却硬信着之类的",
            "narrator_zh": "雅"
        },
        {
            "location": "353/TALK",
            "narrator": "みやび",
            "text": "妄想と何も変わらん、いかんいかん",
            "zh": "跟妄想没两样，不行不行",
            "narrator_zh": "雅"
        },
        {
            "location": "355/TALK",
            "narrator": "みやび",
            "text": "ちゅうか",
            "zh": "说起来",
            "narrator_zh": "雅"
        },
        {
            "location": "356/TALK",
            "narrator": "みやび",
            "text": "唐突にクールになれたんが不思議なんやが",
            "zh": "突然就能变酷，蛮不可思议的",
            "narrator_zh": "雅"
        },
        {
            "location": "357/TALK",
            "narrator": "みやび",
            "text": "相棒の仕業か？",
            "zh": "是搭档搞的鬼？",
            "narrator_zh": "雅"
        },
        {
            "location": "359/SEL",
            "narrator": "",
            "text": "きっかけを与えただけだよ",
            "zh": "我只是给了个契机而已",
            "narrator_zh": ""
        },
        {
            "location": "360/ACT",
            "narrator": "",
            "text": "きっかけを与えただけだよ",
            "zh": "我只是给了个契机而已",
            "narrator_zh": ""
        },
        {
            "location": "362/TALK",
            "narrator": "みやび",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "雅"
        },
        {
            "location": "364/TALK",
            "narrator": "みやび",
            "text": "相棒に助けられたようやね",
            "zh": "好像是被搭档救了咯",
            "narrator_zh": "雅"
        },
        {
            "location": "365/TALK",
            "narrator": "みやび",
            "text": "ありがとな",
            "zh": "谢了啊",
            "narrator_zh": "雅"
        },
        {
            "location": "367/TALK",
            "narrator": "みやび",
            "text": "またうちが変にムキになっとったら",
            "zh": "下次我要是又莫名较上劲",
            "narrator_zh": "雅"
        },
        {
            "location": "368/TALK",
            "narrator": "みやび",
            "text": "その時はよろしくな",
            "zh": "到时候就拜托你了",
            "narrator_zh": "雅"
        },
        {
            "location": "379/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "381/TALK",
            "narrator": "みやび",
            "text": "まほさん、\nそろそろうちも\n上がります。",
            "zh": "真幌，\n我也差不多\n该下班了。",
            "narrator_zh": "雅"
        },
        {
            "location": "383/TALK",
            "narrator": "真幌",
            "text": "そうか。\n今日もご苦労だった。",
            "zh": "是嘛。\n今天也辛苦了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "385/TALK",
            "narrator": "みやび",
            "text": "お疲れでしたー。",
            "zh": "辛苦啦——",
            "narrator_zh": "雅"
        },
        {
            "location": "386/TALK",
            "narrator": "みやび",
            "text": "…銭湯にでも寄って、\n気持ち切り替えるか。",
            "zh": "……顺路去趟澡堂，\n换换心情吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "405/TALK",
            "narrator": "みやび",
            "text": "この時間になると、\n人が少なくて\n貸し切り状態やな。",
            "zh": "一到这个时间，\n人就少，\n跟包场一样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "406/TALK",
            "narrator": "透明神楽",
            "text": "じゃあ、手を上げて\nくださーい。",
            "zh": "那么，请把手\n举起来哟——",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "407/TALK",
            "narrator": "みやび",
            "text": "…卯月？\nなんや、来てたんか。",
            "zh": "……卯月？\n怎么，原来来了啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "408/TALK",
            "narrator": "透明つばめ",
            "text": "ひやぁぁぁぁぁっ！！",
            "zh": "呀啊啊啊啊啊！！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "409/TALK",
            "narrator": "透明神楽",
            "text": "あ、ごめんなさい。\n手が滑っちゃい\nました。",
            "zh": "啊，对不起。\n手滑\n了一下。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "411/TALK",
            "narrator": "みやび",
            "text": "…何やってるが、\nあの子達？",
            "zh": "……那些孩子\n在搞驷马呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "412/TALK",
            "narrator": "みやび",
            "text": "…ちくっと待ってから\n入るか。",
            "zh": "……等子再\n进去吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "442/TALK",
            "narrator": "みやび",
            "text": "ふぅ…えい湯やねぇ。\n疲れが湯に染み出して\nいくようや…。",
            "zh": "呼……真是好汤啊。\n疲劳好像\n溶进热水里流走了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "444/TALK",
            "narrator": "つばめ",
            "text": "そんなにお疲れなん\nですか？",
            "zh": "有那么累\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "446/TALK",
            "narrator": "みやび",
            "text": "そりゃそうやろ。\n学校にバイトに\n出撃やぞ？",
            "zh": "那当然咯。\n学校、打工、\n还有出击呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "448/TALK",
            "narrator": "みやび",
            "text": "休む暇ナッシングの、\nブラック企業真っ青な\n労働環境や。",
            "zh": "一点休息时间都没有，\n黑心企业看了\n都要汗颜的劳动环境咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "450/TALK",
            "narrator": "つばめ",
            "text": "そうですか？\nわたし、ブラックには\n思いませんけど…。",
            "zh": "是这样吗？\n我倒不觉得\n有那么黑……。",
            "narrator_zh": "燕"
        },
        {
            "location": "451/TALK",
            "narrator": "神楽",
            "text": "私も、戦闘に関しては\n少し怖いですけど――",
            "zh": "我也是，战斗方面\n虽然有点怕——",
            "narrator_zh": "神乐"
        },
        {
            "location": "452/TALK",
            "narrator": "神楽",
            "text": "それ以外では、\n特にそうは感じま\nせん。",
            "zh": "除此之外，\n就没有特别\n这种感觉了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "455/TALK",
            "narrator": "みやび",
            "text": "入隊したばっかで、\n新鮮に感じられちょる\nからやろうねぇ。",
            "zh": "刚入队，\n什么都觉得新鲜，\n所以才会这样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "456/TALK",
            "narrator": "みやび",
            "text": "うちには、銭湯で\nじゃれ合ったりする\n元気は残っとらんよ。",
            "zh": "我啊，在澡堂里\n打打闹闹的力气\n是一点都不剩咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "458/TALK",
            "narrator": "つばめ",
            "text": "あ、あはは…、\n聞こえてたんですね。",
            "zh": "啊、啊哈哈……、\n原来你听到了啊。",
            "narrator_zh": "燕"
        },
        {
            "location": "459/TALK",
            "narrator": "みやび",
            "text": "声から判断して、\n卯月がセクハラ\nかましたんやろ？",
            "zh": "光听声音就知道，\n搞性骚扰的\n是卯月吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "461/TALK",
            "narrator": "神楽",
            "text": "スキンシップです！\n素敵な柔らかさ\nでした。",
            "zh": "这是肌肤接触！\n触感非常\n美妙。",
            "narrator_zh": "神乐"
        },
        {
            "location": "463/TALK",
            "narrator": "つばめ",
            "text": "い、言わないでよー！",
            "zh": "别、别说出来啊——！",
            "narrator_zh": "燕"
        },
        {
            "location": "465/TALK",
            "narrator": "みやび",
            "text": "まあ、仲がいいのは\nえいことやと思う\nけんど――",
            "zh": "嘛，感情好\n是好事，\n但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "467/TALK",
            "narrator": "みやび",
            "text": "ああいうんは、\n銭湯でやらん方が\nえいと思うぞね。",
            "zh": "那种事，\n还是别在澡堂\n做比较好咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "473/TALK",
            "narrator": "つばめ",
            "text": "え、えっと…。",
            "zh": "诶、那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "475/TALK",
            "narrator": "つばめ",
            "text": "あ、ああっ、そうだ。\nさっき劇場で――",
            "zh": "啊、啊对，对了。\n刚才在剧场——",
            "narrator_zh": "燕"
        },
        {
            "location": "476/TALK",
            "narrator": "つばめ",
            "text": "クランの皆さんと\n会ったんです。",
            "zh": "和各位库兰\n碰面了。",
            "narrator_zh": "燕"
        },
        {
            "location": "477/TALK",
            "narrator": "みやび",
            "text": "そりゃ会うやろ。\nあそこはクランの家も\n兼ねてるきね。",
            "zh": "那肯定会碰上。\n那里同时也兼作\n库兰的家啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "478/TALK",
            "narrator": "つばめ",
            "text": "そうだったんですか？",
            "zh": "是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "480/TALK",
            "narrator": "みやび",
            "text": "なんや、まほさんから\nクランについて、\n何も聞いてないが？",
            "zh": "怎么，关于\n库兰的事，真幌\n一点没跟你讲？",
            "narrator_zh": "雅"
        },
        {
            "location": "483/TALK",
            "narrator": "つばめ",
            "text": "はい…卯月さんは？",
            "zh": "嗯……那卯月你呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "486/TALK",
            "narrator": "神楽",
            "text": "私も聞いてません。",
            "zh": "我也没听说。",
            "narrator_zh": "神乐"
        },
        {
            "location": "489/TALK",
            "narrator": "みやび",
            "text": "しゃあないなぁ…。\nなら――",
            "zh": "真拿你们没辙咯……。\n那就——",
            "narrator_zh": "雅"
        },
        {
            "location": "490/TALK",
            "narrator": "みやび",
            "text": "うちが超簡単に、\nクランについての\n講義をしちゃるがよ。",
            "zh": "我超简单地，\n给你们开一堂\n库兰的讲座咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "493/TALK",
            "narrator": "つばめ",
            "text": "わぁ、ありがとう\nございます！",
            "zh": "哇，多谢\n啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "494/TALK",
            "narrator": "神楽",
            "text": "っていうか、\nここでするんですか？",
            "zh": "话说回来，\n要在这里讲吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "495/TALK",
            "narrator": "神楽",
            "text": "公の場でするには、\n問題がありそうな\n話題なんじゃ…。",
            "zh": "在公共场合讲，\n这话题好像\n有点不妥……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "497/TALK",
            "narrator": "みやび",
            "text": "どうせ誰もおらんし、\nいたとしても――",
            "zh": "反正也没人，\n就算有人——",
            "narrator_zh": "雅"
        },
        {
            "location": "498/TALK",
            "narrator": "みやび",
            "text": "アニメか漫画の話で\n盛り上がっちょる\nようにしか見えんよ。",
            "zh": "别人看起来，\n也只会以为在\n火热地聊动漫咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "499/TALK",
            "narrator": "みやび",
            "text": "じゃあ、まずは\n根本的な部分からの\n話やけんど――",
            "zh": "那么，先从\n最根本的部分\n讲起吧——",
            "narrator_zh": "雅"
        },
        {
            "location": "500/TALK",
            "narrator": "みやび",
            "text": "クランとは何か？",
            "zh": "库兰是驷马？",
            "narrator_zh": "雅"
        },
        {
            "location": "505/TALK",
            "narrator": "つばめ",
            "text": "えっと…人間の魂が\n抜けだしたもの…、\nですよね？",
            "zh": "那个……是人类的\n灵魂脱离出来的\n东西……，对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "507/TALK",
            "narrator": "みやび",
            "text": "それは知っちょる\nようやね。",
            "zh": "这部分你\n算是知道咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "508/TALK",
            "narrator": "みやび",
            "text": "で、そんな魂だけの\n丸裸な状態の\nクランを――",
            "zh": "然后，那种只剩\n灵魂、赤裸裸状态的\n库兰——",
            "narrator_zh": "雅"
        },
        {
            "location": "509/TALK",
            "narrator": "みやび",
            "text": "安全に保護できる\n特別な施設が、\nあの劇場ちや。",
            "zh": "能安全保护它们\n的特殊设施，\n就是那座剧场滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "512/TALK",
            "narrator": "みやび",
            "text": "まあ、寂びれた古い\n劇場にしか見えん\nやろうけんど――",
            "zh": "嘛，虽然在你们\n眼里只会是座\n冷清的老剧场——",
            "narrator_zh": "雅"
        },
        {
            "location": "513/TALK",
            "narrator": "みやび",
            "text": "それ相応の特殊な\n造りになっちょる\nがよ。",
            "zh": "其实里面是做了\n相应特殊\n构造的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "515/TALK",
            "narrator": "つばめ",
            "text": "そ、そうだったん\nですか！",
            "zh": "原、原来\n是这样！",
            "narrator_zh": "燕"
        },
        {
            "location": "516/TALK",
            "narrator": "神楽",
            "text": "劇場兼秘密基地兼、\nクランのおうち…。",
            "zh": "剧场兼秘密基地兼、\n库兰的家……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "518/TALK",
            "narrator": "神楽",
            "text": "なんか、何でもあり\nって感じですね。",
            "zh": "总感觉，\n像是什么都行的样子呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "520/TALK",
            "narrator": "みやび",
            "text": "何でもありの方が\n秘密基地っぽくて\nワクワクするやろ？",
            "zh": "什么都有的话\n才更像秘密基地，\n更让人兴奋吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "522/TALK",
            "narrator": "つばめ",
            "text": "あ、あの！\n質問いいですか、\nみやび先生！？",
            "zh": "那、那个！\n我可以提问吗，\n雅老师！？",
            "narrator_zh": "燕"
        },
        {
            "location": "525/TALK",
            "narrator": "みやび",
            "text": "うむ、許可する。\n言うてみぃ。",
            "zh": "嗯，准了。\n说来听听。",
            "narrator_zh": "雅"
        },
        {
            "location": "526/TALK",
            "narrator": "つばめ",
            "text": "その、クランを\n安全に保護するための\n特殊な造りって――",
            "zh": "那个，为了保护\n库兰安全的\n特殊构造是指——",
            "narrator_zh": "燕"
        },
        {
            "location": "527/TALK",
            "narrator": "つばめ",
            "text": "具体的には\nどういったもの\nなんですか！？",
            "zh": "具体来说是\n什么样的东西\n呀！？",
            "narrator_zh": "燕"
        },
        {
            "location": "530/TALK",
            "narrator": "みやび",
            "text": "うむ、知らん！",
            "zh": "嗯，不知道！",
            "narrator_zh": "雅"
        },
        {
            "location": "532/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "535/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、そんなもん\n知りたいと思うた\nこともなかったちや。",
            "zh": "说起来，那种东西\n我连想过去了解的\n念头都没有滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "536/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんは、\n建物の構造なんぞが\n気になるが？",
            "zh": "燕你啊，\n居然会对建筑构造\n什么的感兴趣？",
            "narrator_zh": "雅"
        },
        {
            "location": "538/TALK",
            "narrator": "つばめ",
            "text": "特殊っていうから、\nちょっと気になった\n程度ですけど…。",
            "zh": "因为你说是特殊，\n我就稍微有点\n好奇而已……。",
            "narrator_zh": "燕"
        },
        {
            "location": "540/TALK",
            "narrator": "みやび",
            "text": "なら、うちらには\n理解の及ばん――",
            "zh": "那就是我们\n理解不了的——",
            "narrator_zh": "雅"
        },
        {
            "location": "541/TALK",
            "narrator": "みやび",
            "text": "超技術が使われて\n作られちょる思うて\nおけばえいがよ。",
            "zh": "只要当成是用\n超级技术造出来的\n就好了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "542/TALK",
            "narrator": "みやび",
            "text": "その方が、秘密基地\nっぽくてえいやろ？",
            "zh": "那样才更有秘密基地的味道，\n更棒吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "544/TALK",
            "narrator": "つばめ",
            "text": "うーん…。",
            "zh": "唔——……。",
            "narrator_zh": "燕"
        },
        {
            "location": "547/TALK",
            "narrator": "神楽",
            "text": "…あの、私もさっき\nからずっと気になる\nことがあるんです。",
            "zh": "……那个，其实\n我也从刚才起\n一直有件事很在意。",
            "narrator_zh": "神乐"
        },
        {
            "location": "548/TALK",
            "narrator": "みやび",
            "text": "言うてみ。",
            "zh": "说来听听。",
            "narrator_zh": "雅"
        },
        {
            "location": "552/TALK",
            "narrator": "神楽",
            "text": "それです！\nみやびさんのその…、\n胸です！",
            "zh": "就是这个！\n雅你的那个……、\n胸部！",
            "narrator_zh": "神乐"
        },
        {
            "location": "553/TALK",
            "narrator": "みやび",
            "text": "…うちの胸じゃ、\nクランの保護は\nできんと思うがよ？",
            "zh": "……我这胸部，\n可保护不了\n库兰吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "556/TALK",
            "narrator": "神楽",
            "text": "そうじゃなくて！",
            "zh": "我说的不是那个！",
            "narrator_zh": "神乐"
        },
        {
            "location": "557/TALK",
            "narrator": "神楽",
            "text": "さっきから、\nみやびさんが\n動くたびに――",
            "zh": "从刚才开始，\n雅你每次\n动的时候——",
            "narrator_zh": "神乐"
        },
        {
            "location": "558/TALK",
            "narrator": "神楽",
            "text": "目の前で凄い揺れて、\n気になるんです！",
            "zh": "就在眼前晃得特别厉害，\n很在意啊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "560/TALK",
            "narrator": "つばめ",
            "text": "…そういえば、\nさっきからずっと\n動いてたような。",
            "zh": "……这么说来，\n好像从刚才起\n就一直在晃。",
            "narrator_zh": "燕"
        },
        {
            "location": "562/TALK",
            "narrator": "みやび",
            "text": "そりゃ動くやろ。\n身体から垂れ下がっ\nちょるんやき。",
            "zh": "那当然会晃咯。\n它们就是垂挂在\n身体上的嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "563/TALK",
            "narrator": "神楽",
            "text": "ていうか、\n大き過ぎです！",
            "zh": "话说，\n也太大了吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "564/TALK",
            "narrator": "神楽",
            "text": "みやびさん、\n何センチあるん\nですか？",
            "zh": "雅，\n究竟有多少\n厘米呀？",
            "narrator_zh": "神乐"
        },
        {
            "location": "566/TALK",
            "narrator": "みやび",
            "text": "…手のひらから\nはみ出る程度、とだけ\n言うておこう。",
            "zh": "……我就只说，\n大到能从手掌\n里溢出来的程度。",
            "narrator_zh": "雅"
        },
        {
            "location": "568/TALK",
            "narrator": "つばめ",
            "text": "て、手のひらから\nはみ出るって…。",
            "zh": "从、从手掌\n里溢出来……。",
            "narrator_zh": "燕"
        },
        {
            "location": "569/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "570/TALK",
            "narrator": "みやび",
            "text": "女の子の胸に\n興味あるなら、\n触ってもえいよ。",
            "zh": "对女孩子的胸部\n有兴趣的话，\n摸一下也无妨哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "573/TALK",
            "narrator": "神楽",
            "text": "失礼な！\nみやびさんと比べたら\n小さいですけど――",
            "zh": "真失礼！\n跟雅比起来\n虽然算小——",
            "narrator_zh": "神乐"
        },
        {
            "location": "574/TALK",
            "narrator": "神楽",
            "text": "私たちだって\n女の子です！",
            "zh": "我们也是\n女孩子呀！",
            "narrator_zh": "神乐"
        },
        {
            "location": "576/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "578/TALK",
            "narrator": "つばめ",
            "text": "や、やっぱり、\n触るのはいいです！",
            "zh": "果、果然，\n还是不摸了！",
            "narrator_zh": "燕"
        },
        {
            "location": "580/TALK",
            "narrator": "みやび",
            "text": "タダやぞ？",
            "zh": "免费的哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "581/TALK",
            "narrator": "つばめ",
            "text": "でも、何だか\n緊張しちゃって…。",
            "zh": "可是，总觉得\n好紧张……。",
            "narrator_zh": "燕"
        },
        {
            "location": "583/TALK",
            "narrator": "みやび",
            "text": "…卯月は？",
            "zh": "……卯月呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "585/TALK",
            "narrator": "神楽",
            "text": "遠慮します。\n欲しい気持ちが\n膨れ上がって――",
            "zh": "我还是算了吧。\n想要的心情\n会不断膨胀——",
            "narrator_zh": "神乐"
        },
        {
            "location": "586/TALK",
            "narrator": "神楽",
            "text": "引っ張っちゃうかも\nしれないので。",
            "zh": "搞不好会\n忍不住去拉。",
            "narrator_zh": "神乐"
        },
        {
            "location": "589/TALK",
            "narrator": "みやび",
            "text": "はぁ…こんなもんが\nほしいとか、\n理解できんなぁ。",
            "zh": "唉……居然会想要\n这种东西，\n我实在无法理解啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "590/TALK",
            "narrator": "みやび",
            "text": "重くて邪魔なだけで、\n何のメリットもない\n贅肉の塊やぞ？",
            "zh": "又重又碍事，\n一点好处都没有，\n只是块赘肉而已啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "593/TALK",
            "narrator": "つばめ",
            "text": "そ、それでも、\nちょっとくらいは\n欲しいですよ…。",
            "zh": "即、即便如此，\n多少还是\n想要的呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "595/TALK",
            "narrator": "神楽",
            "text": "そうです！\nなのに、重いとか\n邪魔だとか――",
            "zh": "就是！\n明明是这样，还\n说又重又碍事——",
            "narrator_zh": "神乐"
        },
        {
            "location": "596/TALK",
            "narrator": "神楽",
            "text": "胸の大きい人は、\nいつも決まって\nそう言いますよね？",
            "zh": "胸部大的人，\n每次都铁定\n这么说，对吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "599/TALK",
            "narrator": "みやび",
            "text": "…小さい人も、\nいつもそう返して\nくるきね。",
            "zh": "……小的这边，\n也每次都会\n这么顶回来啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "601/TALK",
            "narrator": "神楽",
            "text": "わ、私は小さいかも\nしれませんけど――",
            "zh": "我、我或许是算小的，\n但是——",
            "narrator_zh": "神乐"
        },
        {
            "location": "603/TALK",
            "narrator": "神楽",
            "text": "つばめさんは\n十分大きいです！",
            "zh": "燕可是\n足够大了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "605/TALK",
            "narrator": "つばめ",
            "text": "そ、そうです！\nわたしは――",
            "zh": "对、对！\n我是——",
            "narrator_zh": "燕"
        },
        {
            "location": "608/TALK",
            "narrator": "つばめ",
            "text": "って、えぇっ！？",
            "zh": "等等，诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "609/TALK",
            "narrator": "神楽",
            "text": "つばめさんって、\n着痩せするタイプ\nなんですね。",
            "zh": "原来燕是属于\n那种穿衣\n显瘦的类型啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "611/TALK",
            "narrator": "つばめ",
            "text": "ちょ、卯月さん。\n恥ずかしいよぉ…。",
            "zh": "等、卯月。\n好害羞呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "613/TALK",
            "narrator": "みやび",
            "text": "…まっことこの二人、\n仲えいなぁ…。",
            "zh": "……这两个家伙，\n感情真是蛮好咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "624/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【06 史上最愛の作戦】",
            "zh": "【06 史上最爱的作战】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
}
