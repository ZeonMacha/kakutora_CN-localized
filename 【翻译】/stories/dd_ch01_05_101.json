{
    "dir": "chap05/daydra/dd_ch01_05_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "5102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "社会生活不適応少女＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "无法适应社会生活的少女＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "社会生活不適応少女",
            "zh": "无法适应社会生活的少女",
            "narrator_zh": ""
        },
        {
            "location": "25/TALK",
            "narrator": "つばめ",
            "text": "わぁ…。",
            "zh": "哇……。",
            "narrator_zh": "燕"
        },
        {
            "location": "28/TALK",
            "narrator": "珠緒先生",
            "text": "ふふっ、\nそんなに珍しい？",
            "zh": "呵呵，\n有那么稀奇吗？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "珍しいっていうか…。",
            "zh": "与其说稀奇……。",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "今までいた学校に比べて、\n倍以上大きくて、なんか\n落ち着かないんです。",
            "zh": "跟以前的学校比，\n大了一倍以上，总觉得\n静不下来。",
            "narrator_zh": "燕"
        },
        {
            "location": "32/TALK",
            "narrator": "珠緒先生",
            "text": "そっか、急に転校が\n決まったんだものね。",
            "zh": "是啊，转学\n定得太突然了。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "34/TALK",
            "narrator": "つばめ",
            "text": "はい…だからこの学校の\nことも、まだ全然\n知らないんです。",
            "zh": "是的……所以这所学校的事，\n我还完全\n不了解。",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "珠緒先生",
            "text": "詳しい話はまほちゃん――",
            "zh": "详细的话让真幌——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "38/TALK",
            "narrator": "珠緒先生",
            "text": "じゃなくて、東雲教官に\n説明してもらってね。",
            "zh": "不对，让东云教官\n跟你说明吧。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "40/TALK",
            "narrator": "珠緒先生",
            "text": "多分、ここの学校のことを\n説明すると、うんと長く\nなると思うから…。",
            "zh": "要是说明这所学校，\n我想会变得\n非常长……。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "42/TALK",
            "narrator": "つばめ",
            "text": "そうなんですか？",
            "zh": "是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "珠緒先生",
            "text": "政府機関が建てた\n学校だから、\n色々あるのよ。",
            "zh": "因为是政府机关建的\n学校，\n事情很多。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "44/TALK",
            "narrator": "珠緒先生",
            "text": "とはいっても、普通の\n中高大一貫の学校と\n思ってもらえれば――",
            "zh": "虽说如此，把它当成\n普通的初中高中大学一贯制\n学校就好——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "45/TALK",
            "narrator": "珠緒先生",
            "text": "とりあえずそれで\n問題はないはずよ。",
            "zh": "暂且这样，\n应该没有问题。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "46/TALK",
            "narrator": "つばめ",
            "text": "はい…。",
            "zh": "好的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "珠緒先生",
            "text": "それで、逢瀬さんは\n『特殊攻撃隊特科』\nだけど――",
            "zh": "然后，逢濑\n是『特殊攻击队专科』，\n不过——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "49/TALK",
            "narrator": "珠緒先生",
            "text": "他にどんな学科があるかは\n知ってる？",
            "zh": "其他还有哪些学科，\n你知道吗？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "51/TALK",
            "narrator": "つばめ",
            "text": "あ、いえ…。",
            "zh": "啊，不……。",
            "narrator_zh": "燕"
        },
        {
            "location": "53/TALK",
            "narrator": "珠緒先生",
            "text": "簡単に説明すると、\n『通常攻撃隊特科』という\nものがあるわ。",
            "zh": "简单说明的话，\n还有『通常攻击队专科』\n这个。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "54/TALK",
            "narrator": "珠緒先生",
            "text": "授業のカリキュラムは、\n通常攻撃隊特科と\n同じと思って構わないわ。",
            "zh": "课程安排，\n当成和通常攻击队专科\n一样就行。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "55/TALK",
            "narrator": "珠緒先生",
            "text": "その他にも――",
            "zh": "除此之外——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "57/TALK",
            "narrator": "つばめ",
            "text": "どうしよう…まさかこんな\n急に転校が決まるなんて\n思わなかったなぁ。",
            "zh": "怎么办……没想到转学\n会定得这么突然，\n完全没想到呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "転校の挨拶、ちゃんと\nできるかな？",
            "zh": "转学问候，\n能好好说出来吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "59/TALK",
            "narrator": "つばめ",
            "text": "緊張し過ぎて、\nハッキリ喋れるか\n心配だよ…。",
            "zh": "太紧张了，\n能不能说清楚，\n我好担心……。",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "珠緒先生",
            "text": "――とまあ、簡単だけど\nうちはこんな感じの\n学校なの。",
            "zh": "——总之，简单说来，\n我们学校\n就是这样。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "62/TALK",
            "narrator": "珠緒先生",
            "text": "どう？\n理解してもらえたかしら？",
            "zh": "怎么样？\n能理解了吗？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "64/TALK",
            "narrator": "つばめ",
            "text": "え！？\nあ、はい、大丈夫です！",
            "zh": "诶！？\n啊，是的，没问题！",
            "narrator_zh": "燕"
        },
        {
            "location": "65/TALK",
            "narrator": "珠緒先生",
            "text": "まあ、日常生活を送る\n面では、普通の学校と\n大差はないから――",
            "zh": "嘛，就日常生活来说，\n和普通学校\n差不了多少——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "67/TALK",
            "narrator": "つばめ",
            "text": "…な、なんか、話が\n飛び過ぎて、付いていけ\nないかも。",
            "zh": "……总、总觉得，话\n跳得太快，我可能\n跟不上。",
            "narrator_zh": "燕"
        },
        {
            "location": "70/TALK",
            "narrator": "雛",
            "text": "おーい。",
            "zh": "喂——。",
            "narrator_zh": "雏"
        },
        {
            "location": "71/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "84/TALK",
            "narrator": "つばめ",
            "text": "うわぁっ！！",
            "zh": "哇啊！！",
            "narrator_zh": "燕"
        },
        {
            "location": "95/TALK",
            "narrator": "珠緒先生",
            "text": "あまり緊張しないで、\nのびのびと過ごして\nもらって――",
            "zh": "别太紧张，\n放松地\n过就好——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "96/TALK",
            "narrator": "珠緒先生",
            "text": "って、あら？\n逢瀬さん？",
            "zh": "说起来，哎呀？\n逢濑？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "97/TALK",
            "narrator": "珠緒先生",
            "text": "…もぅ、話の途中で\nいなくなるなんて。",
            "zh": "……真是的，话说到一半\n人就不见了。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "98/TALK",
            "narrator": "珠緒先生",
            "text": "特別攻撃隊特科に所属する\n子達って、集団行動が\n苦手な子ばかりだけど――",
            "zh": "特别攻击队专科的\n孩子，不擅长集体行动的\n特别多——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "99/TALK",
            "narrator": "珠緒先生",
            "text": "まさか、逢瀬さんも\nそうなのかしら？",
            "zh": "难道，逢濑\n也是这样？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "100/TALK",
            "narrator": "珠緒先生",
            "text": "はぁ…、\n先が思いやられるわ……",
            "zh": "哈啊……\n往后真让人担心……",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "101/TALK",
            "narrator": "珠緒先生",
            "text": "って、ダメよ！\nそんなこと考えたら！",
            "zh": "不行不行！\n不能这么想！",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "102/TALK",
            "narrator": "珠緒先生",
            "text": "私は先生なんだから、\nここはビシッと注意\nしないとダメね！",
            "zh": "我是老师，\n这里必须干脆地\n提醒才行！",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "122/TALK",
            "narrator": "雛",
            "text": "いやー、ごめんねー。\n急に呼び止めたり\nしちゃってー。",
            "zh": "哎呀，对不起啦。\n突然把你叫住，\n真是的。",
            "narrator_zh": "雏"
        },
        {
            "location": "125/TALK",
            "narrator": "つばめ",
            "text": "えっ！？\n呼び止めたっていうより、\nあれは、その…。",
            "zh": "诶！？\n与其说叫住，\n那是，那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "126/TALK",
            "narrator": "繭",
            "text": "拉致。",
            "zh": "绑架。",
            "narrator_zh": "茧"
        },
        {
            "location": "129/TALK",
            "narrator": "雛",
            "text": "誰がそんなことを！？",
            "zh": "谁会做那种事！？",
            "narrator_zh": "雏"
        },
        {
            "location": "132/TALK",
            "narrator": "繭",
            "text": "おまえだ。",
            "zh": "是你。",
            "narrator_zh": "茧"
        },
        {
            "location": "133/TALK",
            "narrator": "つばめ",
            "text": "あ、あのぉ…。\nわたしに、何か用ですか？",
            "zh": "那、那个……\n找我有什么事吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "140/TALK",
            "narrator": "雛",
            "text": "あっ、そうだった！",
            "zh": "啊，对了！",
            "narrator_zh": "雏"
        },
        {
            "location": "142/TALK",
            "narrator": "雛",
            "text": "あなた、新しく特別攻撃隊\n特科に来た生徒でしょ？",
            "zh": "你，是新来特别攻击队\n专科的学生吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "143/TALK",
            "narrator": "つばめ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "144/TALK",
            "narrator": "雛",
            "text": "あれ？　違った？\n間違ってないよねー？",
            "zh": "咦？　不是吗？\n我没认错吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "147/TALK",
            "narrator": "つばめ",
            "text": "え、えと、その…。",
            "zh": "诶，那个，这个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "148/TALK",
            "narrator": "つばめ",
            "text": "ど、どうしよう…。\nそれって、言っても\nいいことなのかな？",
            "zh": "怎、怎么办……\n这种事，说出来\n没关系吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "149/TALK",
            "narrator": "雛",
            "text": "…あらら？\nどしたの？",
            "zh": "……哎呀？\n怎么了？",
            "narrator_zh": "雏"
        },
        {
            "location": "151/TALK",
            "narrator": "つばめ",
            "text": "あ、いえ…。",
            "zh": "啊，没什么……。",
            "narrator_zh": "燕"
        },
        {
            "location": "153/TALK",
            "narrator": "繭",
            "text": "…………ハァ。",
            "zh": "…………哈啊。",
            "narrator_zh": "茧"
        },
        {
            "location": "154/TALK",
            "narrator": "つばめ",
            "text": "っ！",
            "zh": "！",
            "narrator_zh": "燕"
        },
        {
            "location": "156/TALK",
            "narrator": "つばめ",
            "text": "どうしよう…。\nわたし、どうしたら\nいいんだろ…。",
            "zh": "怎么办……\n我，该怎么办\n才好……。",
            "narrator_zh": "燕"
        },
        {
            "location": "203/TALK",
            "narrator": "つばめ",
            "text": "こんにちは、\n$handle$さん。\n[ココロゲート]へようこそ。",
            "zh": "你好，\n$handle$。\n欢迎来到[心之扉]。",
            "narrator_zh": "燕"
        },
        {
            "location": "204/TALK",
            "narrator": "つばめ",
            "text": "どうやらまたココロに\nロックがかかって\nしまったみたいですね。",
            "zh": "看来这颗心\n又上了锁，\n是这样。",
            "narrator_zh": "燕"
        },
        {
            "location": "205/TALK",
            "narrator": "つばめ",
            "text": "早速その【問題の扉】を\nコールします！",
            "zh": "这就呼叫\n那扇【问题之扉】！",
            "narrator_zh": "燕"
        },
        {
            "location": "212/TALK",
            "narrator": "つばめ",
            "text": "オープンプロセス、\n0x663番地から\n0x8EF番地へ。",
            "zh": "开放进程，\n从0x663地址\n到0x8EF地址。",
            "narrator_zh": "燕"
        },
        {
            "location": "227/TALK",
            "narrator": "つばめ",
            "text": "シーク完了しました。",
            "zh": "搜索完成。",
            "narrator_zh": "燕"
        },
        {
            "location": "228/TALK",
            "narrator": "つばめ",
            "text": "今回もここに、\n躊躇の根源になっている\n<color=red>【[クラン]】</color>がいます。",
            "zh": "这次这里也有，\n成为犹豫根源的\n<color=red>【[库兰]】</color>。",
            "narrator_zh": "燕"
        },
        {
            "location": "230/TALK",
            "narrator": "つばめ",
            "text": "ココロファイルナンバー\n01-258-39によれば、\n今回の躊躇の原因は……",
            "zh": "根据心之档案编号\n01-258-39，\n这次犹豫的原因是……",
            "narrator_zh": "燕"
        },
        {
            "location": "231/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "232/TALK",
            "narrator": "つばめ",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "燕"
        },
        {
            "location": "233/TALK",
            "narrator": "つばめ",
            "text": "あー、なるほど。",
            "zh": "啊，原来如此。",
            "narrator_zh": "燕"
        },
        {
            "location": "234/SEL",
            "narrator": "",
            "text": "なに？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "235/ACT",
            "narrator": "",
            "text": "なに？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "237/TALK",
            "narrator": "つばめ",
            "text": "いえ。どうもわたし、\n過去に何度か友達関係で\n問題があったようで……。",
            "zh": "没有。看来我\n过去在朋友关系上\n出过几次问题……。",
            "narrator_zh": "燕"
        },
        {
            "location": "238/TALK",
            "narrator": "つばめ",
            "text": "そのトラウマが無意識に\n作用して、先へ進めない\nみたいですね。",
            "zh": "那份创伤在无意识里\n起作用，好像没法\n往前走了。",
            "narrator_zh": "燕"
        },
        {
            "location": "239/SEL",
            "narrator": "",
            "text": "何があったの？",
            "zh": "发生了什么？",
            "narrator_zh": ""
        },
        {
            "location": "240/ACT",
            "narrator": "",
            "text": "何があったの？",
            "zh": "发生了什么？",
            "narrator_zh": ""
        },
        {
            "location": "242/TALK",
            "narrator": "つばめ",
            "text": "簡単に言えば、自分に\n心当たりが無いのに、\n嫌われちゃったとか――",
            "zh": "简单说，自己\n完全没印象，\n却被讨厌了——",
            "narrator_zh": "燕"
        },
        {
            "location": "243/TALK",
            "narrator": "つばめ",
            "text": "次の日から突然\n無視されるように\nなっちゃったとかですね。",
            "zh": "或者从第二天起\n突然被\n无视了。",
            "narrator_zh": "燕"
        },
        {
            "location": "244/SEL",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "245/ACT",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "247/TALK",
            "narrator": "つばめ",
            "text": "まあ、わたし総体としては\n今回の件は全然問題ないと\n思ってるんですけど。",
            "zh": "嘛，作为整体的我，\n觉得这次的事\n完全没问题。",
            "narrator_zh": "燕"
        },
        {
            "location": "248/TALK",
