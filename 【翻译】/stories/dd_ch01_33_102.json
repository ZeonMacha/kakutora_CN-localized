        "title": "005 メインストーリー",
        "sub_title": "チャンネルカグラ＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "神乐频道＜后篇＞"
    },
    "entry": [
        {
            "location": "512/SCENARIO",
            "narrator": "",
            "text": "灰色の天然色",
            "zh": "灰色的天然色[?]",
            "narrator_zh": ""
        },
        {
            "location": "529/TALK",
            "narrator": "神楽",
            "text": "ぅあぁぁぁぁ……！",
            "zh": "呜啊啊啊啊……！",
            "narrator_zh": "神乐"
        },
        {
            "location": "531/TALK",
            "narrator": "神楽",
            "text": "…っ……。\nこんな事になるなら\nいっそ……――",
            "zh": "……唔……。\n与其变成这样\n干脆……——",
            "narrator_zh": "神乐"
        },
        {
            "location": "532/TALK",
            "narrator": "神楽",
            "text": "だめ……",
            "zh": "不行……",
            "narrator_zh": "神乐"
        },
        {
            "location": "533/TALK",
            "narrator": "神楽",
            "text": "だめ！",
            "zh": "不行！",
            "narrator_zh": "神乐"
        },
        {
            "location": "534/TALK",
            "narrator": "神楽",
            "text": "生きる。",
            "zh": "我要活下去。",
            "narrator_zh": "神乐"
        },
        {
            "location": "535/TALK",
            "narrator": "神楽",
            "text": "生きてやる！\n絶対……",
            "zh": "我一定要活下去！\n绝对……",
            "narrator_zh": "神乐"
        },
        {
            "location": "537/TALK",
            "narrator": "神楽",
            "text": "早く…っ……",
            "zh": "快……唔……",
            "narrator_zh": "神乐"
        },
        {
            "location": "538/TALK",
            "narrator": "神楽",
            "text": "早く…死ななくちゃ……",
            "zh": "得快点……去死才行……",
            "narrator_zh": "神乐"
        },
        {
            "location": "539/TALK",
            "narrator": "神楽",
            "text": "……　…っ…",
            "zh": "……　…唔…",
            "narrator_zh": "神乐"
        },
        {
            "location": "541/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "542/TALK",
            "narrator": "神楽",
            "text": "あ、あぁ…ぁ……！",
            "zh": "啊、啊啊……啊……！",
            "narrator_zh": "神乐"
        },
        {
            "location": "543/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "546/TALK",
            "narrator": "神楽",
            "text": "あ……。",
            "zh": "啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "556/TALK",
            "narrator": "透明神楽",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "562/TALK",
            "narrator": "千羽鶴",
            "text": "完了。",
            "zh": "完成。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "563/TALK",
            "narrator": "千羽鶴",
            "text": "一之宮神楽。",
            "zh": "一之宫神乐。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "564/TALK",
            "narrator": "千羽鶴",
            "text": "あなたはこちらの\n準備したことに\n従わなかった。",
            "zh": "你没有遵从\n我这边\n准备好的安排。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "565/TALK",
            "narrator": "千羽鶴",
            "text": "逢瀬つばめへの\n激しい好意と憎悪。",
            "zh": "对逢濑燕\n强烈的好感与憎恶。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "566/TALK",
            "narrator": "千羽鶴",
            "text": "矛盾する気持ちを\n抱かせて葛藤させ\nあなたを発症させた。",
            "zh": "让你同时怀抱\n矛盾的心情陷入挣扎，\n从而令你发症。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "567/TALK",
            "narrator": "千羽鶴",
            "text": "あとは歌うだけで\n逢瀬つばめは破壊され\n任務は完了した。",
            "zh": "本来只要唱出来，\n逢濑燕就会被破坏，\n任务也就完成了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "568/TALK",
            "narrator": "千羽鶴",
            "text": "任務実行にあたり\nこちらは破格の条件を\n提示したはず。",
            "zh": "关于任务的执行，\n我们应该开出了\n破格的条件。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "569/TALK",
            "narrator": "千羽鶴",
            "text": "スピネルは卯月美佐子の\n中へ戻し、あなたは\nフランスに帰る。",
            "zh": "把尖晶石放回\n卯月美佐子体内，\n而你返回法国。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "570/TALK",
            "narrator": "千羽鶴",
            "text": "国家機密の実行者に\n対する措置としては\nありえない好条件。",
            "zh": "作为对国家机密执行者\n的处置来说，这已经是\n难以置信的优厚条件。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "571/TALK",
            "narrator": "千羽鶴",
            "text": "なのにあなたは\n歌わなかった。",
            "zh": "可你却\n没有唱。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "572/TALK",
            "narrator": "千羽鶴",
            "text": "だけど今回こそ\n歌えるでしょう？\n一之宮神楽。",
            "zh": "不过这一次\n应该能唱了吧？\n一之宫神乐。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "573/TALK",
            "narrator": "神楽",
            "text": "はい。",
            "zh": "是。",
            "narrator_zh": "神乐"
        },
        {
            "location": "575/TALK",
            "narrator": "千羽鶴",
            "text": "それはよかった。",
            "zh": "那太好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "576/TALK",
            "narrator": "千羽鶴",
            "text": "儀式の決行は１時間後。",
            "zh": "仪式在1小时后举行。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "577/TALK",
            "narrator": "神楽",
            "text": "はい。",
            "zh": "是。",
            "narrator_zh": "神乐"
        },
        {
            "location": "578/TALK",
            "narrator": "千羽鶴",
            "text": "あなたも儀式用の服に\n着替えてもらう。\nあっちに準備がある。",
            "zh": "你也要换上\n仪式用的服装。\n那边已经准备好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "579/TALK",
            "narrator": "神楽",
            "text": "はい。",
            "zh": "是。",
            "narrator_zh": "神乐"
        },
        {
            "location": "585/TALK",
            "narrator": "千羽鶴",
            "text": "協力してくれて\nありがと。",
            "zh": "谢谢你的\n配合。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "586/TALK",
            "narrator": "千羽鶴",
            "text": "これで概ね、\n全ての準備が整った。",
            "zh": "这样一来，大体上\n所有准备都已就绪。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "587/TALK",
            "narrator": "千羽鶴",
            "text": "あとは、貴方がココロの\n中で協力してくれれば、\n全ては完了する。",
            "zh": "剩下的，只要你在心灵\n之中予以配合，\n一切就完成了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "588/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃ、また後ほど。",
            "zh": "那么，待会儿见。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "590/TALK",
            "narrator": "千羽鶴",
            "text": "自殺しないようにって\nお願いしたはず。",
            "zh": "我应该拜托过你\n别让她自杀的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "591/TALK",
            "narrator": "千羽鶴",
            "text": "幸い、フェノメノン展開の\n方が辛うじて早かったから\n死なずに済んだけど。",
            "zh": "幸好PhenoMENON展开\n勉强快了一步，\n才没死掉。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "592/TALK",
            "narrator": "千羽鶴",
            "text": "彼女が死んでいたら\nもはや為す術は\nなくなっていた。",
            "zh": "要是她死了，\n就彻底\n无计可施了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "593/TALK",
            "narrator": "千羽鶴",
            "text": "まあ、結果オーライだから\nこれくらいに\nしておくけど。",
            "zh": "算了，结果没出岔子，\n这件事就\n到此为止吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "594/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃ、私はこれから\n儀式の準備があるから。",
            "zh": "那我接下来要去\n准备仪式了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "595/TALK",
            "narrator": "千羽鶴",
            "text": "また後ほど。",
            "zh": "待会儿见。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "625/TALK",
            "narrator": "つばめ",
            "text": "もうやだ…。\nやだよ……。",
            "zh": "我受够了……。\n不要啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "626/TALK",
            "narrator": "つばめ",
            "text": "う…うう……。",
            "zh": "呜……呜呜……。",
            "narrator_zh": "燕"
        },
        {
            "location": "627/SEL",
            "narrator": "",
            "text": "つばめ！",
            "zh": "燕！",
            "narrator_zh": ""
        },
        {
            "location": "628/SEL",
            "narrator": "",
            "text": "しっかりして！",
            "zh": "振作点！",
            "narrator_zh": ""
        },
        {
            "location": "629/SEL",
            "narrator": "",
            "text": "辛いんだよね？",
            "zh": "很难受对吧？",
            "narrator_zh": ""
        },
        {
            "location": "630/ACT",
            "narrator": "",
            "text": "つばめ！",
            "zh": "燕！",
            "narrator_zh": ""
        },
        {
            "location": "631/ACT",
            "narrator": "",
            "text": "しっかりして！",
            "zh": "振作点！",
            "narrator_zh": ""
        },
        {
            "location": "632/ACT",
            "narrator": "",
            "text": "辛いんだよね？",
            "zh": "很难受对吧？",
            "narrator_zh": ""
        },
        {
            "location": "636/TALK",
            "narrator": "つばめ",
            "text": "う…ぁ……。\n$handle$さん……。\nたすけ…て…よ…。",
            "zh": "呜……啊……。\n$handle$……。\n救……救我……呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "637/SEL",
            "narrator": "",
            "text": "$me$はここだよ！",
            "zh": "$me$就在这里啊！",
            "narrator_zh": ""
        },
        {
            "location": "638/SEL",
            "narrator": "",
            "text": "つばめ！　つばめ！！",
            "zh": "燕！　燕！！",
            "narrator_zh": ""
        },
        {
            "location": "639/SEL",
            "narrator": "",
            "text": "$handle$だよ！",
            "zh": "是$handle$啊！",
            "narrator_zh": ""
        },
        {
            "location": "640/ACT",
            "narrator": "",
            "text": "$me$はここだよ！",
            "zh": "$me$就在这里啊！",
            "narrator_zh": ""
        },
        {
            "location": "641/ACT",
            "narrator": "",
            "text": "つばめ！　つばめ！！",
            "zh": "燕！　燕！！",
            "narrator_zh": ""
        },
        {
            "location": "642/ACT",
            "narrator": "",
            "text": "$handle$だよ！",
            "zh": "是$handle$啊！",
            "narrator_zh": ""
        },
        {
            "location": "646/TALK",
            "narrator": "つばめ",
            "text": "痛い……。\n辛いの……。",
            "zh": "好痛……。\n好难受……。",
            "narrator_zh": "燕"
        },
        {
            "location": "647/SEL",
            "narrator": "",
            "text": "気付いて…！",
            "zh": "快发现我……！",
            "narrator_zh": ""
        },
        {
            "location": "648/SEL",
            "narrator": "",
            "text": "つばめ！！！！！",
            "zh": "燕！！！！！",
            "narrator_zh": ""
        },
        {
            "location": "649/SEL",
            "narrator": "",
            "text": "ここにいるのに…",
            "zh": "我就在这里啊……",
            "narrator_zh": ""
        },
        {
            "location": "650/ACT",
            "narrator": "",
            "text": "気付いて…！",
            "zh": "快发现我……！",
            "narrator_zh": ""
        },
        {
