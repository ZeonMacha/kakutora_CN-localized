{
    "dir": "chap09/daydra/dd_ch04_09_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "9452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "今更！？",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "事到如今！？"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "今更！？",
            "zh": "事到如今！？",
            "narrator_zh": ""
        },
        {
            "location": "25/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん、ちっくと\nこっち手伝ってくれんか？",
            "zh": "燕，过来搭把手\n帮忙得不得？",
            "narrator_zh": "雅"
        },
        {
            "location": "27/TALK",
            "narrator": "つばめ",
            "text": "はーい、今行きまーす！",
            "zh": "来啦——马上来——！",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "みやび",
            "text": "ありがとな。\nまっこと助かったわ。",
            "zh": "谢了啊。\n真是帮了大忙咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "44/TALK",
            "narrator": "つばめ",
            "text": "いえ、また何かあったら\n言ってください…。",
            "zh": "不会，再有什么事\n请随时叫我……。",
            "narrator_zh": "燕"
        },
        {
            "location": "46/TALK",
            "narrator": "みやび",
            "text": "…？\n何か聞きたいことでも\nありそうな顔やね。",
            "zh": "……？\n你这表情，好像\n有什么想问的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "はい…あの、今更かって\n言われちゃいそうなん\nですけど――。",
            "zh": "嗯……那个，虽然\n可能会被笑话\n这么晚才问——。",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "みやびさんの方言って、\n何弁になるんですか？",
            "zh": "雅的方言，\n算是什么腔呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "…ま、まっこと、\n今更過ぎる質問やね。",
            "zh": "……真、真是\n事到如今过头的问题咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "つばめ",
            "text": "す、すみません…。",
            "zh": "对、对不起……。",
            "narrator_zh": "燕"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "いや、えいよえいよ。\nつばめちゃんのそういう\nところ、結構好きやし。",
            "zh": "不，得吧得吧。\n燕你这种地方，\n我其实蛮喜欢的。",
            "narrator_zh": "雅"
        },
        {
            "location": "54/SEL",
            "narrator": "",
            "text": "普通に土佐弁と言おう",
            "zh": "老实说土佐腔吧",
            "narrator_zh": ""
        },
        {
            "location": "55/SEL",
            "narrator": "",
            "text": "古代ジャンガリヤ語",
            "zh": "古代加卡利亚语",
            "narrator_zh": ""
        },
        {
            "location": "56/SEL",
            "narrator": "",
            "text": "キャラ作りと言え",
            "zh": "就说是立人设",
            "narrator_zh": ""
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "けんど、うちの方言って\nそんなにマイナーながか？",
            "zh": "但是，我的方言\n有那么冷门咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "どうなんでしょう？\nわたし、方言とかって\n詳しくなくて…。",
            "zh": "这怎么说呢？\n我对方言什么的\n不太了解……。",
            "narrator_zh": "燕"
        },
        {
            "location": "62/TALK",
            "narrator": "つばめ",
            "text": "聞いたことはあるけど、\nそれがどこの方言なのかは\nわからない――",
            "zh": "听过是听过，\n但那是哪里的腔调\n就不知道了——",
            "narrator_zh": "燕"
        },
        {
            "location": "63/TALK",
            "narrator": "つばめ",
            "text": "って感じなんです。",
            "zh": "就是这么个情况。",
            "narrator_zh": "燕"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "…なるほど。\nえいよ、別に隠すことでも\nないき。",
            "zh": "……原来如此。\n得，反正也不是\n要藏着掖着的事嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "うちが使っちゅうんは、\n土佐弁や。",
            "zh": "我用的\n是土佐腔。",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "まあかなり崩しちょるき、\nほぼ標準語に近くは\nなっちょるけんどな。",
            "zh": "嘛，被我崩得挺厉害，\n基本已经\n接近普通话咯，不过呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "つばめ",
            "text": "土佐、ですか？",
            "zh": "是土佐吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "74/TALK",
            "narrator": "神楽",
            "text": "坂本竜馬も使っていた\nやつですよ。",
            "zh": "坂本龙马也曾用过的\n那种哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "77/TALK",
            "narrator": "つばめ",
            "text": "ああ、わかった！",
            "zh": "啊，我知道了！",
            "narrator_zh": "燕"
        },
        {
            "location": "80/TALK",
            "narrator": "つばめ",
            "text": "ぜよ、ですね！",
            "zh": "ぜよ，对吧！",
            "narrator_zh": "燕"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "そうやね…まあ、女は\nぜよを使わんし、今は\n男も使わんけんどな…。",
            "zh": "是咯……嘛，女性\n是不用“ぜよ”的，现在\n男性也不用，不过呢……。",
            "narrator_zh": "雅"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "しかし、土佐弁イコール\n竜馬のイメージは、\nやっぱり強いよなぁ…。",
            "zh": "不过，土佐腔就等于\n龙马这个印象，\n果然还是很强啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "86/ACT",
            "narrator": "",
            "text": "普通に土佐弁と言おう",
            "zh": "老实说土佐腔吧",
            "narrator_zh": ""
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "なんや、つまらんヤツやな",
            "zh": "怎么，真是个无趣的家伙咯",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "ここはありもしない言語の名前の一つも言うところやのに…",
            "zh": "这种时候本该随口报个不存在的语言名字才对……",
            "narrator_zh": "雅"
        },
        {
            "location": "118/TALK",
            "narrator": "みやび",
            "text": "まあ、つばめちゃんは純粋やき",
            "zh": "嘛，燕这孩子很单纯嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "119/TALK",
            "narrator": "みやび",
            "text": "下手なウソ言うて信じられても",
            "zh": "蹩脚的谎话要是被信了",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "後々面倒なことになりそうやが…",
            "zh": "以后怕是要惹出麻烦……",
            "narrator_zh": "雅"
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "うちが使っちゅうんは、\n土佐弁や。",
            "zh": "我用的\n是土佐腔。",
            "narrator_zh": "雅"
        },
        {
            "location": "124/TALK",
            "narrator": "みやび",
            "text": "まあ、かなり崩してるき、\nほぼ標準語に近くは\nなっちょるけんどな。",
            "zh": "嘛，被我崩得挺厉害，\n基本已经\n接近普通话咯，不过呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "125/TALK",
            "narrator": "つばめ",
            "text": "土佐、ですか？",
            "zh": "是土佐吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "128/TALK",
            "narrator": "神楽",
            "text": "坂本竜馬も使っていた\nやつですよ。",
            "zh": "坂本龙马也曾用过的\n那种哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "131/TALK",
            "narrator": "つばめ",
            "text": "ああ、わかった！",
            "zh": "啊，我知道了！",
            "narrator_zh": "燕"
        },
        {
            "location": "134/TALK",
            "narrator": "つばめ",
            "text": "ぜよ、ですね！",
            "zh": "ぜよ，对吧！",
            "narrator_zh": "燕"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "そうやね…まあ、女は\nぜよを使わんし、今は\n男も使わんけんどな…。",
            "zh": "是咯……嘛，女性\n是不用“ぜよ”的，现在\n男性也不用，不过呢……。",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "しかし、土佐弁イコール\n竜馬のイメージは、\nやっぱり強いよなぁ…。",
            "zh": "不过，土佐腔就等于\n龙马这个印象，\n果然还是很强啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "139/ACT",
            "narrator": "",
            "text": "古代ジャンガリヤ語",
            "zh": "古代加卡利亚语",
            "narrator_zh": ""
        },
        {
            "location": "160/TALK",
            "narrator": "みやび",
            "text": "それや！",
            "zh": "就是这个！",
            "narrator_zh": "雅"
        },
        {
            "location": "161/TALK",
            "narrator": "みやび",
            "text": "そういうのを期待してたんよ",
            "zh": "我等的就是这种咯",
            "narrator_zh": "雅"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "相棒は最高やな、うちの部屋にあるお菓子食べてもえいぞ",
            "zh": "搭档最棒了咯，我房间里的零食随便你吃啵",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "みやび",
            "text": "古代ジャンガリヤ語や。",
            "zh": "是古代加卡利亚语咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "177/TALK",
            "narrator": "つばめ",
            "text": "…はい？",
            "zh": "……哈？",
            "narrator_zh": "燕"
        },
        {
            "location": "178/TALK",
            "narrator": "みやび",
            "text": "古代ジャンガリヤ語。\nなんや、知らんのか？",
            "zh": "古代加卡利亚语。\n怎么，没听说过？",
            "narrator_zh": "雅"
        },
        {
            "location": "181/TALK",
            "narrator": "つばめ",
            "text": "えっ！？　えっと…\nそれ、冗談ですよね？",
            "zh": "诶！？　那个……\n这是玩笑对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "184/TALK",
            "narrator": "ガブリエラ",
            "text": "何言ってんのよ？\n超メジャーじゃない。",
            "zh": "说什么呢？\n这不是超有名的嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "おっ、ナイスタイミング\nやないか、ガブちゃん！",
            "zh": "哦，这时机\n妙得很嘛，加布！",
            "narrator_zh": "雅"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "古代ジャンガリヤ語は\nその昔、邪馬台国の隣に\nあったという――",
            "zh": "古代加卡利亚语，\n据说是远古时位于\n邪马台国旁边的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "191/TALK",
            "narrator": "ガブリエラ",
            "text": "雀狩耶ノ国で使われていた\n言語で、今も一部地域に\n残ってる方言よ。",
            "zh": "雀狩耶之国所使用的\n语言，现在还有部分\n地区留存的方言哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "194/TALK",
            "narrator": "つばめ",
            "text": "えぇーっ！？\n初めて知りました！",
            "zh": "诶——！？\n我还是第一次听说！",
            "narrator_zh": "燕"
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん、よくもまあ\nそんなデタラメをペラペラ\n言えるもんやなぁ…。",
            "zh": "加布，你还真能面不改色\n把那种鬼话\n说得一套一套的啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "199/TALK",
            "narrator": "みやび",
            "text": "まあ、そういうことやき。\nわかってもらえたがか？",
            "zh": "嘛，就是这么回事嘛。\n这样懂了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "201/TALK",
            "narrator": "つばめ",
            "text": "は、はい。\n勉強になりました。",
            "zh": "是、是的。\n学到了。",
            "narrator_zh": "燕"
        },
        {
            "location": "202/TALK",
            "narrator": "ガブリエラ",
            "text": "うんうん、また一つ\n賢くなったわねぇ。",
            "zh": "嗯嗯，又变聪明\n了一点呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "206/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん、悪そうな\n笑顔やなぁ…。",
            "zh": "加布，这笑得\n可真不怀好意啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "208/TALK",
            "narrator": "つばめ",
            "text": "…わたし、まだまだ\n知らないことが沢山\nあるんだなぁ。",
            "zh": "……我啊，还\n有好多好多\n不知道的事呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "209/TALK",
            "narrator": "つばめ",
            "text": "今度、お母さんにも\n教えてあげよっと。",
            "zh": "下次，也讲给\n妈妈听吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "212/TALK",
            "narrator": "みやび",
            "text": "…なんやろう、\nこの嫌な予感は？",
            "zh": "……是驷马呢，\n这股不祥的预感？",
            "narrator_zh": "雅"
        },
        {
            "location": "213/ACT",
            "narrator": "",
            "text": "キャラ作りと言え",
            "zh": "就说是立人设",
            "narrator_zh": ""
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "予想外やけんど、えいな",
            "zh": "虽然出乎意料，还不错咯",
            "narrator_zh": "雅"
        },
        {
            "location": "235/TALK",
            "narrator": "みやび",
            "text": "よし、キャラ崩壊覚悟でいってやるき！",
            "zh": "好，我豁出去人设崩坏也要说啵！",
            "narrator_zh": "雅"
        },
        {
            "location": "247/TALK",
            "narrator": "みやび",
            "text": "実はな、つばめちゃん…\nこの話し方はただの\nキャラ作りなんよ。",
            "zh": "其实吧，燕……\n我这种说话方式\n只是立人设而已哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "250/TALK",
            "narrator": "つばめ",
            "text": "えっ、キャラですか！？",
            "zh": "诶，是人设吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "そうや。\nその証拠に、私は標準語も\n話せるんだから。",
            "zh": "是咯。\n证据就是，我连\n普通话都会讲。",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "つばめ",
            "text": "わわっ、本当だ！",
            "zh": "哇哇，是真的！",
            "narrator_zh": "燕"
        },
        {
            "location": "254/TALK",
            "narrator": "みやび",
            "text": "今は方言キャラやき、\n標準語はここまでや。",
            "zh": "现在的人设是方言咖嘛，\n普通话就到这里咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "ちなみに方言キャラの\n前は、超ぶりっ子キャラ\nだったんよ。",
            "zh": "顺带一提，方言人设\n之前，是超级\n装乖人设哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "257/TALK",
            "narrator": "つばめ",
            "text": "ぶりっ子！？\nみやびさんが！？",
            "zh": "装乖！？\n雅你！？",
            "narrator_zh": "燕"
        },
        {
            "location": "259/TALK",
            "narrator": "みやび",
            "text": "その前はござる口調やった\nっけか…もう忘れてしも\nうたがな。",
            "zh": "再往前，好像是\n「在下」腔来着……\n已经忘得一干二净咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "262/TALK",
            "narrator": "みやび",
            "text": "って、さすがにこれは\n言い過ぎたかもしれんな。",
            "zh": "话说，这个说不定\n确实说过头了。",
            "narrator_zh": "雅"
        },
        {
            "location": "264/TALK",
            "narrator": "みやび",
            "text": "いくらつばめちゃんでも、\n冗談と気づいて…。",
            "zh": "再怎么说燕也\n该察觉是玩笑……",
            "narrator_zh": "雅"
        },
        {
            "location": "265/TALK",
            "narrator": "つばめ",
            "text": "そうだったんですかぁ…。",
            "zh": "原来是这样啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "266/TALK",
            "narrator": "つばめ",
            "text": "次のキャラがどんなのに\nなるのか、楽しみにして\nいますね。",
            "zh": "下一个会换成\n什么人设呢，\n我很期待哦。",
            "narrator_zh": "燕"
        },
        {
