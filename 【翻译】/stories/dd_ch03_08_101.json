{
    "dir": "chap08/daydra/dd_ch03_08_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "8302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "大胆勝負～Case2～＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "大胆对决～Case2～＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "大胆勝負～Case2～",
            "zh": "大胆对决～Case2～",
            "narrator_zh": ""
        },
        {
            "location": "28/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "ガブリエラ",
            "text": "戦いの後のお風呂と、\n風呂上りのミルクは\nいつも最高なのに――",
            "zh": "明明战斗后的泡澡，\n还有洗完澡的牛奶\n平时都是最棒的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "今日はそんな気に\nなれないみたい…。",
            "zh": "今天却怎么也\n提不起那份兴致呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "それもこれも、\n全部あの新人の\nせいよ！",
            "zh": "说来说去，\n全都是那个新人的\n错啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "前回の戦闘といい、\n今回といい、美味しい\nとこ全部持ってくし！",
            "zh": "上次的战斗也是，\n这次也是，好风头\n全被她一个人占尽了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん、\nそれだけじゃない。",
            "zh": "不对，\n还不止这些。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤも、やたらと\nあいつに肩入れして\n味方するし…。",
            "zh": "绫水也是，一个劲地\n偏袒那家伙，\n站在她那边……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしだって、\n頑張ってるのに…。",
            "zh": "……明明我也有在\n很努力的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "43/TALK",
            "narrator": "アーヤ",
            "text": "…あら、ギャヴィ。\nもう出るところ？",
            "zh": "……哎呀，加维。\n已经要出去了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "46/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？\nな、何よ、悪い！？",
            "zh": "唔！？\n干、干嘛呀，不行吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "聞いただけよ。\nそれじゃ、私も\n入って来るわ。",
            "zh": "我只是问一句而已。\n那我也\n进去洗了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "51/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "またやっちゃった。\nせっかく、話をする\nチャンスだったのに。",
            "zh": "又搞砸了。\n明明难得有个\n能聊几句的机会。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、特に話す\nこともないんだけど。",
            "zh": "……嘛，虽然我也\n没什么非说不可的事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "でも…何でこんなに\nモヤモヤするの…？",
            "zh": "可是……为什么心里会\n这么烦闷啊……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "いらっしゃい♪\nそろそろ来る頃だと\n思ってたわ！",
            "zh": "欢迎光临♪\n我就想着差不多\n该是你来的时候了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/SEL",
            "narrator": "",
            "text": "いつも思うけど、現実のガブリエラより明るいよね",
            "zh": "虽然每次都这么觉得，但你比现实里的加布里埃拉开朗多了呢",
            "narrator_zh": ""
        },
        {
            "location": "100/SEL",
            "narrator": "",
            "text": "今回もちゃちゃっとよろしく！",
            "zh": "这次也麻利地拜托你啦！",
            "narrator_zh": ""
        },
        {
            "location": "101/ACT",
            "narrator": "",
            "text": "いつも思うけど元気だね",
            "zh": "虽然每次都这么觉得，但你真有精神呢",
            "narrator_zh": ""
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "そうかしら？\nそうかもね～♪",
            "zh": "是这样吗？\n兴许是吧～♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、あたしも正真正銘\nガブリエラの一部。\n一人格なのよ？",
            "zh": "不过，我也是货真价实的\n加布里埃拉的一部分。\n是她的人格之一哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "要するに、あたしの中にも\nこんなあたしも存在する\nってことね。",
            "zh": "简而言之，我的内心之中\n也存在着这样一个\n我呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "ただ、普段は表には\n出てこないだけで。",
            "zh": "只是平时不会\n露到表面上来罢了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、司書なんていう\nヒマな事やらされてる\nってことは――",
            "zh": "嘛，不过既然被派来做\n司书这种闲差，\n也就说明——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしってば、\nあたしにとって要らない子\nなのかもしれないけど♪",
            "zh": "我啊，\n对“我”来说说不定是个\n多余的孩子呢♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/SEL",
            "narrator": "",
            "text": "そういうものなの？",
            "zh": "是这样的吗？",
            "narrator_zh": ""
        },
        {
            "location": "110/ACT",
            "narrator": "",
            "text": "そういうものなの？",
            "zh": "是这样的吗？",
            "narrator_zh": ""
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "さあ、どうかしらね♪\n真実は貴方のココロの内に\nお任せするわ。",
            "zh": "谁知道呢～♪\n真相如何，就交给你的\n心里去自行体会啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "さて、それはそれとして、\n今回も頑張って扉を\n検索するわよ♪",
            "zh": "好啦，闲话少说，\n这次也得加把劲\n搜索门扉才行哦♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/ACT",
            "narrator": "",
            "text": "今回もちゃちゃっとよろしく！",
            "zh": "这次也麻利地拜托你啦！",
            "narrator_zh": ""
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "Zrozumiałam!\n今回も頑張って扉を\n検索するわよ♪",
            "zh": "Zrozumiałam!\n这次也得加把劲\n搜索门扉才行哦♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "ガブリエラ",
            "text": "オープンプロセス、\n0x112番地から\n0x31B番地へ。",
            "zh": "开放进程，\n从0x112号地址\n前往0x31B号地址。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "シーク完了っ♪",
            "zh": "搜索完成♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "141/TALK",
            "narrator": "ガブリエラ",
            "text": "さて、今回は……っと。",
            "zh": "好了，这次是……我看看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "144/TALK",
            "narrator": "ガブリエラ",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "145/TALK",
            "narrator": "ガブリエラ",
            "text": "わかったわ。\nどうもあたし、アーヤ分が\n枯渇してるみたいだわ。",
            "zh": "我明白了。\n看来我啊，体内的绫水成分\n已经快枯竭了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "147/TALK",
            "narrator": "ガブリエラ",
            "text": "最近、業務以外で殆ど\nお話してなかったみたい\nだから、それが原因ね。",
            "zh": "最近除了公事以外，\n好像几乎没怎么和她\n说过话，原因就在这儿呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "148/SEL",
            "narrator": "",
            "text": "お風呂場で話ししてたよ？",
            "zh": "刚才在澡堂明明有说话的呀？",
            "narrator_zh": ""
        },
        {
            "location": "149/ACT",
            "narrator": "",
            "text": "お風呂場で話ししてたよ？",
            "zh": "刚才在澡堂明明有说话的呀？",
            "narrator_zh": ""
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなのよ。\nだから今回のクラン発生は\nそこじゃないのよね。",
            "zh": "就是说呀。\n所以这次的库兰并不是\n从那件事上冒出来的呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤと話すチャンス\nなのに、自分から話し\nかけられない――",
            "zh": "明明有和绫水说话的机会，\n却没法由自己主动\n开口搭话——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "そこに今回の\nクランが潜んでいるのよ！",
            "zh": "这就是这次的\n库兰所潜藏的地方哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "話しかけたいのに\n話しかけられない。",
            "zh": "明明想和她搭话，\n却偏偏开不了口。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "155/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな、あたしの気持ちを\n阻害するクランなんて、\nやっつけちゃって頂戴！",
            "zh": "这种阻碍我心意的\n讨厌库兰，\n就拜托你替我收拾掉吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "156/SEL",
            "narrator": "",
            "text": "お、おう",
            "zh": "哦、哦",
            "narrator_zh": ""
        },
        {
            "location": "157/ACT",
            "narrator": "",
            "text": "お、おう",
            "zh": "哦、哦",
            "narrator_zh": ""
        },
        {
            "location": "160/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと♪\nよろしくお願いね。",
            "zh": "谢啦♪\n那就拜托你咯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "161/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！",
            "zh": "祝我和\n$handle$\n拥有一趟美好的心灵之旅！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "27/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月9日　8:15 PM</color>\n高校でのフェノメノン戦の後、劇場横の銭湯にて。",
            "zh": "<color=green>5月9日　8:15 PM</color>\n高中里的PhenoMENON战后，在剧场旁的钱汤。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "66/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch03",
            "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>在加布里埃拉的心中\n展开了战斗。</b></size></color>\n\n\n\n\n\n她的心中，\n正产生着巨大的纠葛。\n\n请潜入心灵领域\n消除加布里埃拉内心的纠葛。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch03"
        }
    ]
}
