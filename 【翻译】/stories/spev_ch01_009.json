{
    "dir": "chap00/daydra/spev_ch01_009.js",
    "type": "",
    "info": {
        "story_id": "1009",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "完成！つばめ城",
        "title_zh": "特别篇",
        "sub_title_zh": "完成！燕城"
    },
    "entry": [
        {
            "location": "32/TALK",
            "narrator": "透明つばめ",
            "text": "うーん…もう一本くらい\n塔を追加しようかな？",
            "zh": "嗯……再加一座\n塔，好不好？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "33/TALK",
            "narrator": "透明つばめ",
            "text": "でも、あまり手を加えて\n途中で失敗したら\n困るし…。",
            "zh": "可是，再改太多，\n做到一半失败了\n就麻烦了……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "34/TALK",
            "narrator": "透明つばめ",
            "text": "うーん…。",
            "zh": "嗯……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "35/SEL",
            "narrator": "（選択肢）",
            "text": "なにをやってるの？",
            "zh": "你在做什么？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "36/ACT",
            "narrator": "",
            "text": "なにをやってるの？",
            "zh": "你在做什么？",
            "narrator_zh": ""
        },
        {
            "location": "38/TALK",
            "narrator": "透明つばめ",
            "text": "あ、今ね、砂のお城を\n作ってるところなの！",
            "zh": "啊，我现在\n在做沙堡！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "39/TALK",
            "narrator": "透明つばめ",
            "text": "わたしとしては、\nもう少し大きくしたいと\n思ってるんだけど…。",
            "zh": "我是想\n再做大一点\n……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "41/TALK",
            "narrator": "透明つばめ",
            "text": "途中で失敗するのが\n怖くて…。",
            "zh": "怕做到一半\n失败……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "42/SEL",
            "narrator": "（選択肢）",
            "text": "精神世界だから心配無用！",
            "zh": "这里是精神世界，不用担心！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "43/SEL",
            "narrator": "（選択肢）",
            "text": "ここまで作れたんだから大丈夫",
            "zh": "都能做到这里了，没问题的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "44/ACT",
            "narrator": "",
            "text": "精神世界だから心配無用！",
            "zh": "这里是精神世界，不用担心！",
            "narrator_zh": ""
        },
        {
            "location": "45/TALK",
            "narrator": "透明つばめ",
            "text": "そっか、精神世界だから\nやり直したいって思えば\n途中からやり直せるんだ？",
            "zh": "这样啊，因为是精神世界，\n想重来的话\n就能从中途重来？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "46/TALK",
            "narrator": "透明つばめ",
            "text": "ありがたくいけど…、\nそれってちょっと\n達成感なさそうだし…。",
            "zh": "虽然很感谢……\n那样的话\n好像没什么成就感……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "48/TALK",
            "narrator": "透明つばめ",
            "text": "壊さないように\n頑張ってみるよ。",
            "zh": "我会小心\n不弄坏的。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "49/ACT",
            "narrator": "",
            "text": "ここまで作れたんだから大丈夫",
            "zh": "都能做到这里了，没问题的",
            "narrator_zh": ""
        },
        {
            "location": "51/TALK",
            "narrator": "透明つばめ",
            "text": "そっか…ここまでは\n失敗せずに作れたん\nだし…。",
            "zh": "这样啊……到这里\n都没失败地\n做下来了……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "52/TALK",
            "narrator": "透明つばめ",
            "text": "あとちょっとくらい、\nどうにかなるよね！",
            "zh": "再加一点点，\n总能行的吧！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "54/TALK",
            "narrator": "透明つばめ",
            "text": "それじゃあ、もう一本の\n塔は、この辺にして…。",
            "zh": "那么，再加的\n那座塔，就放这边……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "55/TALK",
            "narrator": "透明つばめ",
            "text": "そーっと、そーっと…。",
            "zh": "轻轻地，轻轻地……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "56/TALK",
            "narrator": "透明つばめ",
            "text": "よし、あとは指先で\n形を整えれば…。",
            "zh": "好，剩下用指尖\n把形状修一修……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "58/TALK",
            "narrator": "透明つばめ",
            "text": "で、できたーっ！！\n砂のお城、完成だよ！",
            "zh": "做、做好了！！\n沙堡，完成啦！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "59/SEL",
            "narrator": "（選択肢）",
            "text": "わーっ、完成おめでとう！",
            "zh": "哇，完成了，恭喜！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "60/SEL",
            "narrator": "（選択肢）",
            "text": "つばめ城だね",
            "zh": "这是燕城呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "61/ACT",
            "narrator": "",
            "text": "わーっ、完成おめでとう！",
            "zh": "哇，完成了，恭喜！",
            "narrator_zh": ""
        },
        {
            "location": "62/TALK",
            "narrator": "透明つばめ",
            "text": "ありがとう！",
            "zh": "谢谢！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "63/TALK",
            "narrator": "透明つばめ",
            "text": "えへへ、初めてだから\nちゃんとできるかなー\nって心配だったけど…。",
            "zh": "诶嘿嘿，第一次做，\n还担心能不能\n做好……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "64/TALK",
            "narrator": "透明つばめ",
            "text": "思ってたよりも\nかっこいいのが\n作れたよ。",
            "zh": "比我想的\n更帅的\n做出来了。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "65/ACT",
            "narrator": "",
            "text": "つばめ城だね",
            "zh": "这是燕城呀",
            "narrator_zh": ""
        },
        {
            "location": "68/TALK",
            "narrator": "透明つばめ",
            "text": "えぇっ！！\nわたしの名前が付くの！？",
            "zh": "诶诶！！\n要用我的名字吗！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "69/SEL",
            "narrator": "（選択肢）",
            "text": "つばめの城だからね",
            "zh": "因为是燕的城呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "70/SEL",
            "narrator": "（選択肢）",
            "text": "ガブリエラ城じゃ変でしょ？",
            "zh": "叫加布里埃拉城不奇怪吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "71/ACT",
            "narrator": "",
            "text": "つばめの城だからね",
            "zh": "因为是燕的城呀",
            "narrator_zh": ""
        },
        {
            "location": "73/TALK",
            "narrator": "透明つばめ",
            "text": "そっか…。",
            "zh": "这样啊……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "74/TALK",
            "narrator": "透明つばめ",
            "text": "えへへ、嬉しいけど、\nちょっとだけ\n照れくさいかも…。",
            "zh": "诶嘿嘿，虽然高兴，\n就是有一点点\n不好意思……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "75/ACT",
            "narrator": "",
            "text": "ガブリエラ城じゃ変でしょ？",
            "zh": "叫加布里埃拉城不奇怪吗？",
            "narrator_zh": ""
        },
        {
            "location": "76/TALK",
            "narrator": "透明つばめ",
            "text": "そ、それは違うよ！\nわたしが作った\nお城なんだから…。",
            "zh": "那、那不一样！\n这是我做的\n城堡……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "78/TALK",
            "narrator": "透明つばめ",
            "text": "…そっか。\nじゃあやっぱり、\nこのお城はつばめ城だね。",
            "zh": "……这样啊。\n那果然，\n这座城就是燕城。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "81/TALK",
            "narrator": "透明つばめ",
            "text": "でも、いいなぁ…。",
            "zh": "不过，真好啊……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "82/TALK",
            "narrator": "透明つばめ",
            "text": "これは砂のお城だけど、\n本当にこういう形の\nお城があって…。",
            "zh": "这是沙做的城，\n要是真有这种形状的\n城堡……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "83/TALK",
            "narrator": "透明つばめ",
            "text": "そこにみんなで住めたら、\n楽しそうだなぁ…。",
            "zh": "大家一起住在那里，\n好像很开心……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "84/SEL",
            "narrator": "（選択肢）",
            "text": "それ、絶対楽しいヤツだ",
            "zh": "那绝对很开心",
            "narrator_zh": "（选项）"
        },
        {
            "location": "85/SEL",
            "narrator": "（選択肢）",
            "text": "$me$も一緒に住みたいな",
            "zh": "$me$也想一起住",
            "narrator_zh": "（选项）"
        },
        {
            "location": "86/SEL",
            "narrator": "（選択肢）",
            "text": "そんなのダメだよ",
            "zh": "那样可不行",
            "narrator_zh": "（选项）"
        },
        {
            "location": "87/ACT",
            "narrator": "",
            "text": "それ、絶対楽しいヤツだ",
            "zh": "那绝对很开心",
            "narrator_zh": ""
        },
        {
            "location": "88/TALK",
            "narrator": "透明つばめ",
            "text": "広いお城に\nみんなで住むんだよ？",
            "zh": "住在好大的城里，\n大家一起住哦？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "89/TALK",
            "narrator": "透明つばめ",
            "text": "絶対楽しいよね！",
            "zh": "绝对很开心吧！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "90/ACT",
            "narrator": "",
            "text": "$me$も一緒に住みたいな",
            "zh": "$me$也想一起住",
            "narrator_zh": ""
        },
        {
            "location": "91/TALK",
            "narrator": "透明つばめ",
            "text": "それ、とってもいいよ！",
            "zh": "那太好了！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "92/TALK",
            "narrator": "透明つばめ",
            "text": "わたしも、神楽ちゃん達\nだけじゃなくて――",
            "zh": "也不只是\n神乐她们——",
            "narrator_zh": "透明燕"
        },
        {
            "location": "93/TALK",
            "narrator": "透明つばめ",
            "text": "$handle$さんも\n一緒だったら、\nとっても嬉しいな…。",
            "zh": "要是$handle$\n也在一起，\n我会非常高兴……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "94/ACT",
            "narrator": "",
            "text": "そんなのダメだよ",
            "zh": "那样可不行",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "透明つばめ",
            "text": "えっ、どうして？",
            "zh": "诶，为什么？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "96/SEL",
            "narrator": "（選択肢）",
            "text": "$me$とつばめで住むから",
            "zh": "因为$me$和燕一起住",
            "narrator_zh": "（选项）"
        },
        {
            "location": "97/SEL",
            "narrator": "（選択肢）",
            "text": "つばめ一人の城だからだよ",
            "zh": "因为这是燕一个人的城",
            "narrator_zh": "（选项）"
        },
        {
            "location": "98/ACT",
            "narrator": "",
            "text": "$me$とつばめで住むから",
            "zh": "因为$me$和燕一起住",
            "narrator_zh": ""
        },
        {
            "location": "100/TALK",
            "narrator": "透明つばめ",
            "text": "ふふっ…、\n$handle$さんが\n一緒に住んでくれるの？",
            "zh": "呵呵……\n$handle$\n要一起住吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "101/TALK",
            "narrator": "透明つばめ",
            "text": "それだったら、\nあたしも二人だけの方が\nいいかなー？",
            "zh": "那样的话，\n我也觉得只有两个人\n更好？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "102/TALK",
            "narrator": "透明つばめ",
            "text": "もし本当にそうなったら、\nずーっと二人で色んな\nお話したり…。",
            "zh": "要是真变成那样，\n两个人一直说各种各样的\n话……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "103/TALK",
            "narrator": "透明つばめ",
            "text": "遊んだりできて\n楽しそうだよね！",
            "zh": "还能一起玩，\n好像很开心！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "104/ACT",
            "narrator": "",
            "text": "つばめ一人の城だからだよ",
            "zh": "因为这是燕一个人的城",
            "narrator_zh": ""
        },
        {
            "location": "107/TALK",
            "narrator": "透明つばめ",
            "text": "お、お城に一人で住むの、\n凄く寂しい気がするん\nだけど…。",
            "zh": "一、一个人住在城里，\n我觉得会\n非常寂寞……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "109/TALK",
            "narrator": "透明つばめ",
            "text": "できれば、寮みたいに\nみんなと一緒に住めたら\n楽しそうだなー。",
            "zh": "可以的话，像宿舍那样\n和大家一起住，\n好像很开心。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "110/TALK",
            "narrator": "透明つばめ",
            "text": "ひなこちゃん達の\nお部屋も用意したりして、\nえへへ…。",
            "zh": "小雏子她们的\n房间也准备好，\n诶嘿嘿……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "117/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ちょっと、つばめ！\nこんなところで\nなにして…。",
            "zh": "等等，燕！\n在这种地方\n干什么……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "118/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…お城作ってたの？",
            "zh": "……在做城堡？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "119/TALK",
            "narrator": "透明つばめ",
            "text": "あ、うん！　どうかな？\n結構自信作なんだけど…。",
            "zh": "啊，嗯！　怎么样？\n我还挺有自信的……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "120/TALK",
            "narrator": "透明アーヤ",
            "text": "へぇ、一人でこんなに\n大きいの作るなんて、\nすごいと思うわ。",
            "zh": "哦，一个人做出\n这么大的，\n我觉得很厉害。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "透明つばめ",
            "text": "えへへ…。",
            "zh": "诶嘿嘿……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "122/TALK",
            "narrator": "透明アーヤ",
            "text": "でも…大事なこと\n忘れてない？",
            "zh": "可是……重要的事\n没忘吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "123/TALK",
            "narrator": "透明つばめ",
            "text": "大事なこと、ですか？\nあ、お城の旗とか！",
            "zh": "重要的事？\n啊，城堡的旗之类的！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "124/TALK",
            "narrator": "透明ガブリエラ",
            "text": "じゃなくて、時間！\n全然気にしてなかったの？",
            "zh": "不是那个，是时间！\n你完全没在意吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "透明つばめ",
            "text": "え…。",
            "zh": "诶……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "131/TALK",
            "narrator": "透明つばめ",
            "text": "ああーーーーーーっ！！\nきゅ、休憩時間、\nもう終わっちゃってる！？",
            "zh": "啊啊——————！！\n休、休息时间，\n已经结束了！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "132/TALK",
            "narrator": "透明アーヤ",
            "text": "とっくにね…。",
            "zh": "早就结束了……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "133/TALK",
            "narrator": "透明アーヤ",
            "text": "訓練始められないって、\n館長怒ってるわよ？",
            "zh": "训练开始不了，\n馆长在生气哦？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "透明つばめ",
            "text": "えぇっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "137/SEL",
            "narrator": "（選択肢）",
            "text": "ここでも訓練やってるの！？",
            "zh": "这里也要训练的吗！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "138/ACT",
            "narrator": "",
            "text": "ここでも訓練やってるの！？",
            "zh": "这里也要训练的吗！？",
            "narrator_zh": ""
        },
        {
            "location": "140/TALK",
            "narrator": "透明ガブリエラ",
            "text": "当然じゃない。",
