{
    "dir": "chap22/daydra/dd_ch04_22_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "22405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "勇気＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "勇气＜后篇＞"
    },
    "entry": [
        {
            "location": "372/TALK",
            "narrator": "みやび",
            "text": "…いかん。",
            "zh": "……不行。",
            "narrator_zh": "雅"
        },
        {
            "location": "373/TALK",
            "narrator": "みやび",
            "text": "うち、今めっちゃ\nビビっちょる。",
            "zh": "我，现在\n怕得要死着。",
            "narrator_zh": "雅"
        },
        {
            "location": "374/TALK",
            "narrator": "みやび",
            "text": "見なかったことに\nするなんて\n絶対にありえん。",
            "zh": "装作没看见\n什么的，绝对\n不可能。",
            "narrator_zh": "雅"
        },
        {
            "location": "375/TALK",
            "narrator": "みやび",
            "text": "今までの活動\n丸ごと無駄になる。",
            "zh": "至今的活动\n会全部白费。",
            "narrator_zh": "雅"
        },
        {
            "location": "376/TALK",
            "narrator": "みやび",
            "text": "…やはり、管理庁に\n何か行動を起こさん\nわけにはいかんな。",
            "zh": "……果然，不能\n不对管理厅\n采取点什么行动。",
            "narrator_zh": "雅"
        },
        {
            "location": "377/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "379/TALK",
            "narrator": "みやび",
            "text": "今のうちらに\nできることは\n何や？",
            "zh": "现在的我们\n能做到的，\n是驷马？",
            "narrator_zh": "雅"
        },
        {
            "location": "383/TALK",
            "narrator": "みやび",
            "text": "急募",
            "zh": "急招",
            "narrator_zh": "雅"
        },
        {
            "location": "384/TALK",
            "narrator": "みやび",
            "text": "管理庁をギャフンと言わせられる行動",
            "zh": "能让管理厅吃瘪的行动",
            "narrator_zh": "雅"
        },
        {
            "location": "385/TALK",
            "narrator": "みやび",
            "text": "条件",
            "zh": "条件",
            "narrator_zh": "雅"
        },
        {
            "location": "386/TALK",
            "narrator": "みやび",
            "text": "うちらの安全重視",
            "zh": "重视我们的安全",
            "narrator_zh": "雅"
        },
        {
            "location": "387/TALK",
            "narrator": "みやび",
            "text": "何かアイデアは？",
            "zh": "有什么点子吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "389/SEL",
            "narrator": "",
            "text": "$me$に聞くの？",
            "zh": "要问问$me$吗？",
            "narrator_zh": ""
        },
        {
            "location": "390/ACT",
            "narrator": "",
            "text": "$me$に聞くの？",
            "zh": "要问问$me$吗？",
            "narrator_zh": ""
        },
        {
            "location": "392/TALK",
            "narrator": "みやび",
            "text": "第三者の意見が欲しい",
            "zh": "想要第三者的意见",
            "narrator_zh": "雅"
        },
        {
            "location": "393/TALK",
            "narrator": "みやび",
            "text": "つまり相棒",
            "zh": "也就是说，搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "394/TALK",
            "narrator": "みやび",
            "text": "君に決めた！",
            "zh": "就决定是你了！",
            "narrator_zh": "雅"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "さあアイデアは？",
            "zh": "来，有什么点子？",
            "narrator_zh": "雅"
        },
        {
            "location": "397/SEL",
            "narrator": "",
            "text": "みんなに相談するべきだ",
            "zh": "应该找大家商量",
            "narrator_zh": ""
        },
        {
            "location": "398/SEL",
            "narrator": "",
            "text": "繭には聞かないの？",
            "zh": "不问问茧吗？",
            "narrator_zh": ""
        },
        {
            "location": "399/ACT",
            "narrator": "",
            "text": "みんなに相談するべきだ",
            "zh": "应该找大家商量",
            "narrator_zh": ""
        },
        {
            "location": "402/TALK",
            "narrator": "みやび",
            "text": "考えてはいた",
            "zh": "我考虑过",
            "narrator_zh": "雅"
        },
        {
            "location": "403/TALK",
            "narrator": "みやび",
            "text": "けんど問題が一つ",
            "zh": "但是有一个问题",
            "narrator_zh": "雅"
        },
        {
            "location": "404/TALK",
            "narrator": "みやび",
            "text": "うちらの中にいるスパイの存在や",
            "zh": "就是我们中间有间谍",
            "narrator_zh": "雅"
        },
        {
            "location": "405/TALK",
            "narrator": "みやび",
            "text": "まほさんとアーヤは違うと思う",
            "zh": "真幌和绫水应该不是",
            "narrator_zh": "雅"
        },
        {
            "location": "406/TALK",
            "narrator": "みやび",
            "text": "残りの三人は",
            "zh": "剩下的三个人就",
            "narrator_zh": "雅"
        },
        {
            "location": "409/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "411/TALK",
            "narrator": "みやび",
            "text": "そういうことやき",
            "zh": "就是这么回事啵",
            "narrator_zh": "雅"
        },
        {
            "location": "412/TALK",
            "narrator": "みやび",
            "text": "全員に話せない以上は誰にも相談できん",
            "zh": "既然不能告诉所有人，那就谁也没法商量",
            "narrator_zh": "雅"
        },
        {
            "location": "413/TALK",
            "narrator": "みやび",
            "text": "仲間に対して疑心暗鬼とか",
            "zh": "对同伴疑神疑鬼什么的",
            "narrator_zh": "雅"
        },
        {
            "location": "414/TALK",
            "narrator": "みやび",
            "text": "うちだけで十分や",
            "zh": "我一个人就够了",
            "narrator_zh": "雅"
        },
        {
            "location": "415/ACT",
            "narrator": "",
            "text": "繭には聞かないの？",
            "zh": "不问问茧吗？",
            "narrator_zh": ""
        },
        {
            "location": "417/TALK",
            "narrator": "みやび",
            "text": "聞けるわけがない",
            "zh": "怎么可能问得了",
            "narrator_zh": "雅"
        },
        {
            "location": "418/TALK",
            "narrator": "みやび",
            "text": "大抵のことは相談できても",
            "zh": "一般的事虽然能商量",
            "narrator_zh": "雅"
        },
        {
            "location": "419/TALK",
            "narrator": "みやび",
            "text": "事の大きさを考えると",
            "zh": "可考虑到事情的分量",
            "narrator_zh": "雅"
        },
        {
            "location": "420/TALK",
            "narrator": "みやび",
            "text": "これはうちが決めなければならんし",
            "zh": "这就必须由我来决定",
            "narrator_zh": "雅"
        },
        {
            "location": "423/TALK",
            "narrator": "みやび",
            "text": "あまりうちの情けない姿",
            "zh": "我那没出息的样子",
            "narrator_zh": "雅"
        },
        {
            "location": "424/TALK",
            "narrator": "みやび",
            "text": "うさぎに見せるのは",
            "zh": "让兔子看到的话",
            "narrator_zh": "雅"
        },
        {
            "location": "425/TALK",
            "narrator": "みやび",
            "text": "好ましくない",
            "zh": "可不怎么好",
            "narrator_zh": "雅"
        },
        {
            "location": "427/SEL",
            "narrator": "",
            "text": "じゃあみんなに相談しよう",
            "zh": "那就找大家商量吧",
            "narrator_zh": ""
        },
        {
            "location": "428/ACT",
            "narrator": "",
            "text": "じゃあみんなに相談しよう",
            "zh": "那就找大家商量吧",
            "narrator_zh": ""
        },
        {
            "location": "432/TALK",
            "narrator": "みやび",
            "text": "仕方がない",
            "zh": "没办法",
            "narrator_zh": "雅"
        },
        {
            "location": "433/TALK",
            "narrator": "みやび",
            "text": "自分で考えるしかなさそうやね",
            "zh": "看来只能自己想了咯",
            "narrator_zh": "雅"
        },
        {
            "location": "438/TALK",
            "narrator": "みやび",
            "text": "ふむ…。",
            "zh": "唔……。",
            "narrator_zh": "雅"
        },
        {
            "location": "439/TALK",
            "narrator": "繭",
            "text": "…事が事なだけに、\n簡単に答えを\n出せませんね。",
            "zh": "……正因为事情\n非同小可，没法轻易\n给出答案呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "440/TALK",
            "narrator": "みやび",
            "text": "うん…いや、\nちっくと\n整理すれば……。",
            "zh": "嗯……不，\n稍微整理一下\n的话……。",
            "narrator_zh": "雅"
        },
        {
            "location": "444/TALK",
            "narrator": "みやび",
            "text": "なっ！？",
            "zh": "怎！？",
            "narrator_zh": "雅"
        },
        {
            "location": "445/TALK",
            "narrator": "繭",
            "text": "フェノメノン\nアラートですか！？",
            "zh": "PhenoMENON\n警报吗！？",
            "narrator_zh": "茧"
        },
        {
            "location": "446/TALK",
            "narrator": "みやび",
            "text": "そのようや…。\nこんな時間に、\nまったく…。",
            "zh": "看样子是……。\n这种时间，\n真是的……。",
            "narrator_zh": "雅"
        },
        {
            "location": "447/TALK",
            "narrator": "みやび",
            "text": "うさぎ、すまん。\n話の続きはまた\n後でや。",
            "zh": "兔子，没好意思。\n话的后半段，\n回头再说啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "448/TALK",
            "narrator": "繭",
            "text": "了解しました。\nみやび先輩、\nお気をつけて…。",
            "zh": "了解了。\n雅前辈，\n请小心……。",
            "narrator_zh": "茧"
        },
        {
            "location": "452/TALK",
            "narrator": "みやび",
            "text": "…みんなのとこ\n行かんと！",
            "zh": "……得马上去\n大家那边！",
            "narrator_zh": "雅"
        },
        {
            "location": "463/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【18 ブラック・クラン】",
            "zh": "【18 黑之库兰】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
}
