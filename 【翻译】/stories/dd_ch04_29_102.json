{
    "dir": "chap29/daydra/dd_ch04_29_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "29405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "向かい合わせの鏡＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "相向之镜＜后篇＞"
    },
    "entry": [
        {
            "location": "368/SCENARIO",
            "narrator": "",
            "text": "向かい合わせの鏡のように",
            "zh": "如相向之镜一般",
            "narrator_zh": ""
        },
        {
            "location": "383/TALK",
            "narrator": "みやび",
            "text": "ああ。\n考え違いをしとった。",
            "zh": "啊。\n是我想岔了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "385/TALK",
            "narrator": "みやび",
            "text": "今考えんといかんのは\nそういうことやない。",
            "zh": "现在该想的，\n不是那种事。",
            "narrator_zh": "雅"
        },
        {
            "location": "386/TALK",
            "narrator": "みやび",
            "text": "まずはこの世界の\n事実の把握をせんと。",
            "zh": "首先得把这个世界的事实\n摸清楚才行。",
            "narrator_zh": "雅"
        },
        {
            "location": "388/TALK",
            "narrator": "真幌",
            "text": "みやび？",
            "zh": "雅？",
            "narrator_zh": "真幌"
        },
        {
            "location": "390/TALK",
            "narrator": "みやび",
            "text": "すみません。\nエリカさんの話を\n聞かせてください。",
            "zh": "抱歉。\n请讲讲领火的\n事情吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "391/TALK",
            "narrator": "真幌",
            "text": "…元々はエリカも自分も\n管理庁のエージェントの\nようなものだった。",
            "zh": "……其实领火和我，\n原本都算是\n管理厅的特工。",
            "narrator_zh": "真幌"
        },
        {
            "location": "392/TALK",
            "narrator": "真幌",
            "text": "自分は情報統制担当、\nエリカは技術担当だ。",
            "zh": "我负责信息管制，\n领火负责技术。",
            "narrator_zh": "真幌"
        },
        {
            "location": "393/TALK",
            "narrator": "真幌",
            "text": "エリカは長官の右腕と\n言うべきポジションで\n仕事をしていた。",
            "zh": "领火在堪称长官\n左右手的位置上\n工作。",
            "narrator_zh": "真幌"
        },
        {
            "location": "394/TALK",
            "narrator": "真幌",
            "text": "ところが突然\n管理庁から離れて\n付属大の教授になった。",
            "zh": "然而她突然\n脱离管理厅，\n当上了附属大学的教授。",
            "narrator_zh": "真幌"
        },
        {
            "location": "395/TALK",
            "narrator": "真幌",
            "text": "驚いて理由を聞いたが\n教えてはもらえなかった。",
            "zh": "我吃惊之下追问理由，\n她却没告诉我。",
            "narrator_zh": "真幌"
        },
        {
            "location": "396/TALK",
            "narrator": "真幌",
            "text": "そしてある日連絡が来た。",
            "zh": "然后某天，来了一通联络。",
            "narrator_zh": "真幌"
        },
        {
            "location": "397/TALK",
            "narrator": "真幌",
            "text": "「長官の言う事には\n常に気をつけて。\n臭ったときには連絡を」",
            "zh": "「对长官说的话，\n要时刻留心。\n察觉不对劲就联系我」",
            "narrator_zh": "真幌"
        },
        {
            "location": "398/TALK",
            "narrator": "真幌",
            "text": "そう言い残してエリカは\n音信不通になった。",
            "zh": "留下这句话后，\n领火就音讯全无了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "399/TALK",
            "narrator": "真幌",
            "text": "今回連絡をしてくるまで\n私も連絡が取れなかった。",
            "zh": "直到这次她主动联络，\n我都没能联系上她。",
            "narrator_zh": "真幌"
        },
        {
            "location": "400/TALK",
            "narrator": "真幌",
            "text": "だから私にも\nわからないことだらけ\nなんだ。",
            "zh": "所以我这边，\n也尽是些\n弄不明白的事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "401/TALK",
            "narrator": "真幌",
            "text": "…すまないな。",
            "zh": "……对不住啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "402/TALK",
            "narrator": "みやび",
            "text": "…いえ。",
            "zh": "……不。",
            "narrator_zh": "雅"
        },
        {
            "location": "403/SEL",
            "narrator": "",
            "text": "嘘かもよ",
            "zh": "也可能是骗人的哦",
            "narrator_zh": ""
        },
        {
            "location": "404/SEL",
            "narrator": "",
            "text": "これ以上は聞き出せないか",
            "zh": "问不出更多的了吧",
            "narrator_zh": ""
        },
        {
            "location": "405/SEL",
            "narrator": "",
            "text": "あんまり進展しないね",
            "zh": "进展不太顺利呢",
            "narrator_zh": ""
        },
        {
            "location": "406/ACT",
            "narrator": "",
            "text": "嘘かもよ",
            "zh": "也可能是骗人的哦",
            "narrator_zh": ""
        },
        {
            "location": "422/TALK",
            "narrator": "みやび",
            "text": "そうだとしても",
            "zh": "就算是这样",
            "narrator_zh": "雅"
        },
        {
            "location": "423/TALK",
            "narrator": "みやび",
            "text": "これ以上は",
            "zh": "更多的事",
            "narrator_zh": "雅"
        },
        {
            "location": "424/TALK",
            "narrator": "みやび",
            "text": "聞けんろうね",
            "zh": "也问不到了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "426/ACT",
            "narrator": "",
            "text": "これ以上は聞き出せないか",
            "zh": "问不出更多的了吧",
            "narrator_zh": ""
        },
        {
            "location": "442/TALK",
            "narrator": "みやび",
            "text": "確かにの",
            "zh": "的确是呐。",
            "narrator_zh": "雅"
        },
        {
            "location": "443/TALK",
            "narrator": "みやび",
            "text": "残念だが",
            "zh": "很遗憾",
            "narrator_zh": "雅"
        },
        {
            "location": "445/ACT",
            "narrator": "",
            "text": "あんまり進展しないね",
            "zh": "进展不太顺利呢",
            "narrator_zh": ""
        },
        {
            "location": "461/TALK",
            "narrator": "みやび",
            "text": "それはもう",
            "zh": "那就真是",
            "narrator_zh": "雅"
        },
        {
            "location": "462/TALK",
            "narrator": "みやび",
            "text": "仕方がないか",
            "zh": "没办法了",
            "narrator_zh": "雅"
        },
        {
            "location": "463/TALK",
            "narrator": "みやび",
            "text": "がっかりだ",
            "zh": "好失望啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "477/TALK",
            "narrator": "みやび",
            "text": "大丈夫です。\n情報はこちらでも\n集めます。",
            "zh": "没问题的。\n情报这边\n也会收集。",
            "narrator_zh": "雅"
        },
        {
            "location": "479/TALK",
            "narrator": "みやび",
            "text": "音羽のことはともかく\nつばめちゃんのことや\n卯月のこともありますし。",
            "zh": "音羽的事先放一边，\n燕的事和\n神乐的事也摆着呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "480/TALK",
            "narrator": "真幌",
            "text": "頼む。",
            "zh": "拜托了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "481/TALK",
            "narrator": "みやび",
            "text": "國政家のアンペア数が\nもう少しあれば\nもっとええんですけど…。",
            "zh": "国政家的安培数\n再多一点的话，\n就更好咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "482/TALK",
            "narrator": "真幌",
            "text": "そういえば。",
            "zh": "说起来。",
            "narrator_zh": "真幌"
        },
        {
            "location": "483/TALK",
            "narrator": "真幌",
            "text": "みやびとエリカは\n雰囲気が似ているな。",
            "zh": "雅和领火，\n气质有点像啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "484/TALK",
            "narrator": "みやび",
            "text": "…本当ですか？",
            "zh": "……真的吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "485/TALK",
            "narrator": "真幌",
            "text": "集中している時の\nオーラとかそういう\nところが。",
            "zh": "专注时的气场\n之类的\n地方。",
            "narrator_zh": "真幌"
        },
        {
            "location": "486/TALK",
            "narrator": "真幌",
            "text": "研究者の情熱を\n感じるんだ。",
            "zh": "让我感受到\n研究者的热情。",
            "narrator_zh": "真幌"
        },
        {
            "location": "488/TALK",
            "narrator": "みやび",
            "text": "おおお。",
            "zh": "哦哦哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "489/TALK",
            "narrator": "真幌",
            "text": "しかしエリカには\nサボり癖はないがな。",
            "zh": "不过领火可没有\n偷懒的毛病。",
            "narrator_zh": "真幌"
        },
        {
            "location": "491/TALK",
            "narrator": "みやび",
            "text": "…やる時にやれれば\n十分やないですか。",
            "zh": "……该干的时候能干，\n不就够了吗。",
            "narrator_zh": "雅"
        },
        {
            "location": "492/TALK",
            "narrator": "真幌",
            "text": "いややっぱり\n似てないな。\n前言撤回。",
            "zh": "不，果然还是\n不像啊。\n前言撤回。",
            "narrator_zh": "真幌"
        },
        {
            "location": "494/TALK",
            "narrator": "みやび",
            "text": "えー！\nそこはもっとおだてて\nくださいよー。",
            "zh": "欸——！\n这种时候就该多捧\n两句嘛——。",
            "narrator_zh": "雅"
        },
        {
            "location": "495/TALK",
            "narrator": "真幌",
            "text": "あはははは。",
            "zh": "啊哈哈哈哈。",
            "narrator_zh": "真幌"
        },
        {
            "location": "506/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【MV EXE_MiYABi】",
            "zh": "【MV EXE_MiYABi】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
}
