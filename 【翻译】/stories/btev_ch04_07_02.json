{
    "dir": "chap07/battle/btev_ch04_07_02.js",
    "type": "",
    "info": {
        "story_id": "24012",
        "cid": "",
        "title": "012 ココロスフィアストーリー【Lv04】",
        "sub_title": "監視＜帰結＞",
        "title_zh": "012 心灵领域故事【Lv04】",
        "sub_title_zh": "监视＜归结＞"
    },
    "entry": [
        {
            "location": "210/SCENARIO",
            "narrator": "",
            "text": "監視",
            "zh": "监视",
            "narrator_zh": ""
        },
        {
            "location": "225/TALK",
            "narrator": "みやび",
            "text": "うわー、\nやーらーれーたー…。",
            "zh": "呜哇——，\n输——掉——了——……。",
            "narrator_zh": "雅"
        },
        {
            "location": "226/TALK",
            "narrator": "みやび",
            "text": "…と、$handle$に\nやられるのも――",
            "zh": "……话虽如此，输给\n$handle$这种事——",
            "narrator_zh": "雅"
        },
        {
            "location": "227/TALK",
            "narrator": "みやび",
            "text": "慣れてきた感あって\n余裕出てきたな…。",
            "zh": "好像都有点习惯了，\n反倒生出点从容来了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "228/SEL",
            "narrator": "（選択肢）",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": "（选项）"
        },
        {
            "location": "229/ACT",
            "narrator": "",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": ""
        },
        {
            "location": "232/TALK",
            "narrator": "みやび",
            "text": "いや…。",
            "zh": "不……。",
            "narrator_zh": "雅"
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "まあ、悪い気せんき、\nえいんやけんど…。",
            "zh": "嘛，感觉倒也不坏，\n算了，但是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "235/TALK",
            "narrator": "みやび",
            "text": "…あんたのおかげで、\nまた一つ――",
            "zh": "……多亏了你，\n我又得把一份——",
            "narrator_zh": "雅"
        },
        {
            "location": "236/TALK",
            "narrator": "みやび",
            "text": "うちの正直な気持ち\n出さなきゃならなく\nなったか…。",
            "zh": "把我坦诚的心情\n也给逼得\n摊出来了么……。",
            "narrator_zh": "雅"
        },
        {
            "location": "237/TALK",
            "narrator": "みやび",
            "text": "正直、スパイが誰か\n探そうしちゅう\nけんど――",
            "zh": "老实说，虽然我正想\n查出间谍究竟\n是谁——",
            "narrator_zh": "雅"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "不安で堪らん。",
            "zh": "但心里不安得受不了。",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "みやび",
            "text": "当然やろ？\n仲間の中にスパイが\nおるかもしれんのや。",
            "zh": "那还用说吧？\n伙伴里面说不定就\n混着间谍啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "240/TALK",
            "narrator": "みやび",
            "text": "しかも、それが誰か、\n何人おるのかも\n全て不明…。",
            "zh": "而且是谁、\n有几个人，\n全都一团黑……。",
            "narrator_zh": "雅"
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "…難易度ヤバ過ぎや。\nこれがゲームやったら\nクソゲーやぞ？",
            "zh": "……这难度也太离谱了。\n这要是游戏，\n妥妥的粪作咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "242/SEL",
            "narrator": "（選択肢）",
            "text": "$me$が手伝うよ",
            "zh": "$me$来帮你",
            "narrator_zh": "（选项）"
        },
        {
            "location": "243/ACT",
            "narrator": "",
            "text": "$me$が手伝うよ",
            "zh": "$me$来帮你",
            "narrator_zh": ""
        },
        {
            "location": "245/TALK",
            "narrator": "みやび",
            "text": "まだ言うてるが？",
            "zh": "还在说这话咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "246/TALK",
            "narrator": "みやび",
            "text": "$handle$は\nそこそこ信用しちょる\nけんど――",
            "zh": "虽然我也算\n有点信$handle$，\n但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "247/TALK",
            "narrator": "みやび",
            "text": "頼りがいはない\nっちゅうたやろ？",
            "zh": "我不是说过你\n完全靠不住了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "248/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "いや、まあここでは\n頼りになるか。",
            "zh": "不对，嘛在这里的话\n倒是挺靠得住。",
            "narrator_zh": "雅"
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "まあ、その気持ちは\nありがたく貰うとく\nぞね。",
            "zh": "嘛，你这份心意\n我就心怀感激地收下\n咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "はぁ…まっこと、\nどうしたもんかなぁ？",
            "zh": "唉……真是个大难题，\n到底该怎么办才好呀？",
            "narrator_zh": "雅"
        }
    ]
}
