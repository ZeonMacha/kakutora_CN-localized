{
    "dir": "chap10/daydra/dd_ch05_10_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "10505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "私は卯月神楽？＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "我是卯月神乐？＜后篇＞"
    },
    "entry": [
        {
            "location": "828/TALK",
            "narrator": "神楽",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "830/TALK",
            "narrator": "神楽",
            "text": "あー、ダメ…。\n全然内容が\n頭に入らない…。",
            "zh": "啊——，不行……。\n内容完全\n进不了脑子……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "831/TALK",
            "narrator": "神楽",
            "text": "今までは、どんなに\n疲れてるときでも\n夢中で読んでたのになぁ。",
            "zh": "以前不管有多累，\n都会看得入迷\n的说。",
            "narrator_zh": "神乐"
        },
        {
            "location": "835/TALK",
            "narrator": "神楽",
            "text": "あっ！",
            "zh": "啊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "840/TALK",
            "narrator": "つばめ",
            "text": "お弁当タィムーヽ(*´∀｀*)ﾉ",
            "zh": "便当时间到ヽ(*´∀｀*)ﾉ",
            "narrator_zh": "燕"
        },
        {
            "location": "841/TALK",
            "narrator": "つばめ",
            "text": "まゆちんから",
            "zh": "从小茧那里",
            "narrator_zh": "燕"
        },
        {
            "location": "842/TALK",
            "narrator": "つばめ",
            "text": "卵焼きのぉ裾分け(*´﹃｀*)",
            "zh": "分到玉子烧啦(*´﹃｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "844/TALK",
            "narrator": "神楽",
            "text": "美味しそうですね",
            "zh": "看起来很好吃呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "846/TALK",
            "narrator": "雛",
            "text": "☆ゲキウマ☆",
            "zh": "☆超好吃☆",
            "narrator_zh": "雏"
        },
        {
            "location": "847/TALK",
            "narrator": "繭",
            "text": "実は冷凍食品",
            "zh": "其实是冷冻食品",
            "narrator_zh": "茧"
        },
        {
            "location": "848/TALK",
            "narrator": "つばめ",
            "text": "ぇっ！？(ﾟ△ﾟ;ﾉ)ﾉ",
            "zh": "诶！？(ﾟ△ﾟ;ﾉ)ﾉ",
            "narrator_zh": "燕"
        },
        {
            "location": "849/TALK",
            "narrator": "繭",
            "text": "冗談",
            "zh": "开玩笑的",
            "narrator_zh": "茧"
        },
        {
            "location": "850/TALK",
            "narrator": "神楽",
            "text": "繭さんも冗談って言うんですね",
            "zh": "茧也会说开玩笑呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "853/TALK",
            "narrator": "雛",
            "text": "かなりレアー",
            "zh": "相当稀有",
            "narrator_zh": "雏"
        },
        {
            "location": "854/TALK",
            "narrator": "神楽",
            "text": "見ていたらお腹空いてきました",
            "zh": "看着看着肚子饿了",
            "narrator_zh": "神乐"
        },
        {
            "location": "855/TALK",
            "narrator": "神楽",
            "text": "私もそろそろお昼にしようかな？",
            "zh": "我也差不多吃午饭吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "858/TALK",
            "narrator": "神楽",
            "text": "？",
            "zh": "？",
            "narrator_zh": "神乐"
        },
        {
            "location": "860/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃん",
            "zh": "神乐",
            "narrator_zh": "燕"
        },
        {
            "location": "861/TALK",
            "narrator": "つばめ",
            "text": "ぉ昼まだだったの？(´･ω･｀) ",
            "zh": "午饭还没吃吗？(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "862/TALK",
            "narrator": "神楽",
            "text": "食欲なかったんですけど",
            "zh": "没什么食欲来着",
            "narrator_zh": "神乐"
        },
        {
            "location": "863/TALK",
            "narrator": "神楽",
            "text": "お弁当の写真見たら空いてきました",
            "zh": "看到便当的照片就饿了",
            "narrator_zh": "神乐"
        },
        {
            "location": "866/TALK",
            "narrator": "神楽",
            "text": "なにを食べるべきか",
            "zh": "该吃什么好呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "869/TALK",
            "narrator": "つばめ",
            "text": "わたしもそぅ思ぅ(≧ω≦)",
            "zh": "我也这么想(≧ω≦)",
            "narrator_zh": "燕"
        },
        {
            "location": "870/TALK",
            "narrator": "神楽",
            "text": "はい？",
            "zh": "嗯？",
            "narrator_zh": "神乐"
        },
        {
            "location": "872/TALK",
            "narrator": "つばめ",
            "text": "わー(ﾟ△ﾟ;ﾉ)ﾉ",
            "zh": "哇——(ﾟ△ﾟ;ﾉ)ﾉ",
            "narrator_zh": "燕"
        },
        {
            "location": "873/TALK",
            "narrator": "つばめ",
            "text": "ごめんなさいー",
            "zh": "对不起——",
            "narrator_zh": "燕"
        },
        {
            "location": "874/TALK",
            "narrator": "つばめ",
            "text": "こっちで話してたこと",
            "zh": "这边说的话",
            "narrator_zh": "燕"
        },
        {
            "location": "875/TALK",
            "narrator": "つばめ",
            "text": "ぅっかりＷＡＶＥに送っちゃった(/ω＼)(/ω＼)ﾊｽﾞｶｼｰｨ",
            "zh": "不小心发到WAVE上了(/ω＼)(/ω＼)好害羞——",
            "narrator_zh": "燕"
        },
        {
            "location": "877/TALK",
            "narrator": "雛",
            "text": "すごいよつばめちゃん",
            "zh": "好厉害啊燕",
            "narrator_zh": "雏"
        },
        {
            "location": "878/TALK",
            "narrator": "雛",
            "text": "そんなうっかり",
            "zh": "这种不小心",
            "narrator_zh": "雏"
        },
        {
            "location": "879/TALK",
            "narrator": "雛",
            "text": "つばめちゃんしかできないよ",
            "zh": "只有燕能做到",
            "narrator_zh": "雏"
        },
        {
            "location": "880/TALK",
            "narrator": "繭",
            "text": "ひなこも似たようなことした",
            "zh": "小雏也干过差不多的事",
            "narrator_zh": "茧"
        },
        {
            "location": "881/TALK",
            "narrator": "雛",
            "text": "いつ？",
            "zh": "什么时候？",
            "narrator_zh": "雏"
        },
        {
            "location": "882/TALK",
            "narrator": "繭",
            "text": "おかゆって言ったし",
            "zh": "你不是说了粥嘛",
            "narrator_zh": "茧"
        },
        {
            "location": "883/TALK",
            "narrator": "神楽",
            "text": "なんの話ですか？",
            "zh": "在说什么？",
            "narrator_zh": "神乐"
        },
        {
            "location": "885/TALK",
            "narrator": "雛",
            "text": "そうだ、おかゆ！",
            "zh": "对了，粥！",
            "narrator_zh": "雏"
        },
        {
            "location": "886/TALK",
            "narrator": "雛",
            "text": "おかゆだよ神楽ちゃん！",
            "zh": "是粥哦神乐！",
            "narrator_zh": "雏"
        },
        {
            "location": "887/TALK",
            "narrator": "神楽",
            "text": "？？？？？",
            "zh": "？？？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "889/TALK",
            "narrator": "雛",
            "text": "神楽ちゃんのお昼ごはん",
            "zh": "神乐的午饭",
            "narrator_zh": "雏"
        },
        {
            "location": "890/TALK",
            "narrator": "神楽",
            "text": "ああ",
            "zh": "啊啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "891/TALK",
            "narrator": "神楽",
            "text": "おかゆいいですね",
            "zh": "粥不错呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "892/TALK",
            "narrator": "神楽",
            "text": "優しい味で癒やされそうです",
            "zh": "味道温和，感觉能被治愈",
            "narrator_zh": "神乐"
        },
        {
            "location": "895/TALK",
            "narrator": "繭",
            "text": "もっと普通のでいいと思うけど？",
            "zh": "我觉得更普通的就行吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "896/TALK",
            "narrator": "繭",
            "text": "風邪ってわけじゃないんだし",
            "zh": "又不是感冒",
            "narrator_zh": "茧"
        },
        {
            "location": "897/TALK",
            "narrator": "神楽",
            "text": "じゃあなにかオススメは？",
            "zh": "那有什么推荐吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "899/TALK",
            "narrator": "繭",
            "text": "唐揚げとか",
            "zh": "唐扬之类的",
            "narrator_zh": "茧"
        },
        {
            "location": "900/TALK",
            "narrator": "神楽",
            "text": "急に油っこくなったような？",
            "zh": "突然变得很油腻了？",
            "narrator_zh": "神乐"
        },
        {
            "location": "902/TALK",
            "narrator": "繭",
            "text": "美味しいから",
            "zh": "因为好吃",
            "narrator_zh": "茧"
        },
        {
            "location": "903/TALK",
            "narrator": "神楽",
            "text": "食べてるんですか？",
            "zh": "你在吃吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "905/TALK",
            "narrator": "繭",
            "text": "レモンはないけど",
            "zh": "没有柠檬就是了",
            "narrator_zh": "茧"
        },
        {
            "location": "906/TALK",
            "narrator": "繭",
            "text": "ひなこが持ってきてないから",
            "zh": "因为小雏没带来",
            "narrator_zh": "茧"
        },
        {
            "location": "907/TALK",
            "narrator": "神楽",
            "text": "食べてる唐揚げ",
            "zh": "正在吃的唐扬",
            "narrator_zh": "神乐"
        },
        {
            "location": "908/TALK",
            "narrator": "神楽",
            "text": "ひなこさんのだったんですね",
            "zh": "是小雏的啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "911/TALK",
            "narrator": "神楽",
            "text": "ところでつばめさんは？",
            "zh": "话说燕呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "912/TALK",
            "narrator": "繭",
            "text": "ひなこと話に夢中",
            "zh": "和小雏聊得入迷",
            "narrator_zh": "茧"
        },
        {
            "location": "913/TALK",
            "narrator": "繭",
            "text": "おかゆナンバーワンの味について",
            "zh": "在聊粥哪一种最好吃",
            "narrator_zh": "茧"
        },
        {
            "location": "917/TALK",
            "narrator": "神楽",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": "神乐"
        },
        {
            "location": "918/TALK",
            "narrator": "神楽",
            "text": "ちょっと目眩がするので落ちますね",
            "zh": "有点头晕，我先下了",
            "narrator_zh": "神乐"
        },
        {
            "location": "921/TALK",
            "narrator": "繭",
            "text": "お大事に",
            "zh": "保重",
            "narrator_zh": "茧"
        },
        {
            "location": "925/TALK",
            "narrator": "神楽",
            "text": "まあ、リアルの方が\n盛り上がるから…。",
            "zh": "嘛，现实那边\n更热闹……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "927/TALK",
            "narrator": "神楽",
            "text": "こっちがついでになるのは\n仕方ないんだけど。",
            "zh": "这边变成附带的\n也没办法。",
            "narrator_zh": "神乐"
        },
        {
            "location": "929/TALK",
            "narrator": "神楽",
            "text": "…でも、つばめさんまで\n私を構わないなんて、\n信じられない！",
            "zh": "……可是，连燕\n都不来理我，\n真不敢相信！",
            "narrator_zh": "神乐"
        },
        {
            "location": "930/TALK",
            "narrator": "神楽",
            "text": "いつもなら卯月さん\n卯月さんしつこいくらい\n構って――",
            "zh": "平时的话会卯月、\n卯月地缠个不停\n来理我——",
            "narrator_zh": "神乐"
        },
        {
            "location": "931/TALK",
            "narrator": "神楽",
            "text": "…私、なに考えてるの？",
            "zh": "……我在想什么啊？",
            "narrator_zh": "神乐"
        },
        {
            "location": "932/TALK",
            "narrator": "神楽",
            "text": "これじゃまるで、\n私がつばめさん達と\n話すのを…。",
            "zh": "这样简直像是，\n我和燕她们\n说话这件事……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "933/TALK",
            "narrator": "神楽",
            "text": "楽しみにしてる\nみたい…。",
            "zh": "在期待着\n一样……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "936/TALK",
            "narrator": "神楽",
            "text": "…ううん、まさか。\nそんなことない。",
            "zh": "……不对，怎么可能。\n没有那种事。",
            "narrator_zh": "神乐"
        },
        {
            "location": "937/TALK",
            "narrator": "神楽",
            "text": "ひなこさんや繭さんと\n話すのが楽しいだけで…。",
            "zh": "只是和小雏、茧\n说话很开心而已……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "938/TALK",
            "narrator": "神楽",
            "text": "つばめさんと話すのが\n楽しい、ってわけじゃ\nない。",
            "zh": "并不是和燕说话\n很开心，\n不是那样。",
            "narrator_zh": "神乐"
        },
        {
            "location": "939/TALK",
            "narrator": "神楽",
            "text": "きっとそうよ。\nそうじゃなきゃ…。",
            "zh": "一定是这样。\n不然的话……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "940/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "942/TALK",
            "narrator": "神楽",
            "text": "はぁ…やっぱり、\n疲れてるのかなぁ？",
            "zh": "哈啊……果然，\n是累了吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "951/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【08 HANABI】",
            "zh": "【08 HANABI】",
            "narrator_zh": "Dialog_chapter_ch05"
        },
        {
            "location": "963/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【08 HANABI】",
            "zh": "【08 HANABI】",
            "narrator_zh": "Dialog_chapter_ch05"
        }
    ]
}
