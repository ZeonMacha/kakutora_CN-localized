    "entry": [
        {
            "location": "110/SCENARIO",
            "narrator": "",
            "text": "014_ゆずジュースはとてもすなおで",
            "zh": "014_柚子汁非常坦率",
            "narrator_zh": ""
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "謎が謎を呼び",
            "zh": "谜题招来谜题",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "みやび",
            "text": "憶測が噂を拡大させる",
            "zh": "臆测把传闻放大",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "即ちネットロアの成り立ちとは",
            "zh": "也就是说，网络传说的由来",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "疑問に対する独自見解と言えよう",
            "zh": "可以说是对疑问的一家之言",
            "narrator_zh": "雅"
        },
        {
            "location": "141/SEL",
            "narrator": "",
            "text": "なんか難しい話？",
            "zh": "是什么难懂的话？",
            "narrator_zh": ""
        },
        {
            "location": "142/SEL",
            "narrator": "",
            "text": "$me$がみやびを噂から守るよ",
            "zh": "$me$会保护雅不被传闻缠上",
            "narrator_zh": ""
        },
        {
            "location": "143/SEL",
            "narrator": "",
            "text": "噂になりたいってこと？",
            "zh": "是想成为传闻吗？",
            "narrator_zh": ""
        },
        {
            "location": "144/ACT",
            "narrator": "",
            "text": "なんか難しい話？",
            "zh": "是什么难懂的话？",
            "narrator_zh": ""
        },
        {
            "location": "145/TALK",
            "narrator": "みやび",
            "text": "かもな",
            "zh": "也许吧",
            "narrator_zh": "雅"
        },
        {
            "location": "146/ACT",
            "narrator": "",
            "text": "$me$がみやびを噂から守るよ",
            "zh": "$me$会保护雅不被传闻缠上",
            "narrator_zh": ""
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "ふむ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "よい心がけ",
            "zh": "这份心不错",
            "narrator_zh": "雅"
        },
        {
            "location": "151/TALK",
            "narrator": "みやび",
            "text": "誉めてつかわす",
            "zh": "夸你一句",
            "narrator_zh": "雅"
        },
        {
            "location": "152/ACT",
            "narrator": "",
            "text": "噂になりたいってこと？",
            "zh": "是想成为传闻吗？",
            "narrator_zh": ""
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "みやび",
            "text": "そうかも？",
            "zh": "也许是？",
            "narrator_zh": "雅"
        },
        {
            "location": "158/TALK",
            "narrator": "みやび",
            "text": "例えば柚だ",
            "zh": "比如说柚子",
            "narrator_zh": "雅"
        },
        {
            "location": "159/TALK",
            "narrator": "みやび",
            "text": "柚は本来酸味が強く、飲料には向かない",
            "zh": "柚子本来酸味很强，不适合做饮料",
            "narrator_zh": "雅"
        },
        {
            "location": "160/TALK",
            "narrator": "みやび",
            "text": "しかし世間にはゆずジュースなるものが出回っている",
            "zh": "但是世上却流通着叫柚子汁的东西",
            "narrator_zh": "雅"
        },
        {
            "location": "161/SEL",
            "narrator": "",
            "text": "へー",
            "zh": "嘿——",
            "narrator_zh": ""
        },
        {
            "location": "162/SEL",
            "narrator": "",
            "text": "えっと…何の話？",
            "zh": "那个……在说什么？",
            "narrator_zh": ""
        },
        {
            "location": "163/SEL",
            "narrator": "",
            "text": "ゆずジュース最高！",
            "zh": "柚子汁最棒！",
            "narrator_zh": ""
        },
        {
            "location": "165/TALK",
            "narrator": "みやび",
            "text": "これが何を意味するか？",
            "zh": "这意味着什么？",
            "narrator_zh": "雅"
        },
        {
            "location": "169/ACT",
            "narrator": "",
            "text": "へー",
            "zh": "嘿——",
            "narrator_zh": ""
        },
        {
            "location": "170/TALK",
            "narrator": "みやび",
            "text": "適当な相槌だな",
            "zh": "随口附和啊",
            "narrator_zh": "雅"
        },
        {
            "location": "171/ACT",
            "narrator": "",
            "text": "えっと…何の話？",
            "zh": "那个……在说什么？",
            "narrator_zh": ""
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "最後まで聞けばわかる",
            "zh": "听到最后就明白了",
            "narrator_zh": "雅"
        },
        {
            "location": "173/ACT",
            "narrator": "",
            "text": "ゆずジュース最高！",
            "zh": "柚子汁最棒！",
            "narrator_zh": ""
        },
        {
            "location": "174/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "美味しいな",
            "zh": "是好喝",
            "narrator_zh": "雅"
        },
        {
            "location": "177/TALK",
            "narrator": "みやび",
            "text": "そのいち。人工的に甘味を加える。",
            "zh": "其一。人为地加甜味。",
            "narrator_zh": "雅"
        },
        {
            "location": "178/TALK",
            "narrator": "みやび",
            "text": "そのに。柚の酸味を抑える。",
            "zh": "其二。压住柚子的酸味。",
            "narrator_zh": "雅"
        },
        {
            "location": "179/TALK",
            "narrator": "みやび",
            "text": "そのさん。柚とゆずジュースは無関係。",
            "zh": "其三。柚子和柚子汁没关系。",
            "narrator_zh": "雅"
        },
        {
            "location": "181/SEL",
            "narrator": "",
            "text": "そのいちかな",
            "zh": "是其一吧",
            "narrator_zh": ""
        },
        {
            "location": "182/SEL",
            "narrator": "",
            "text": "そのに…？",
            "zh": "是其二……？",
            "narrator_zh": ""
        },
        {
            "location": "183/SEL",
            "narrator": "",
            "text": "そのさんでしょ！",
            "zh": "是其三吧！",
            "narrator_zh": ""
        },
        {
            "location": "184/ACT",
            "narrator": "",
            "text": "そのいちかな",
            "zh": "是其一吧",
            "narrator_zh": ""
        },
        {
            "location": "185/TALK",
            "narrator": "みやび",
            "text": "その通り",
            "zh": "正是如此",
            "narrator_zh": "雅"
        },
        {
            "location": "186/TALK",
            "narrator": "みやび",
            "text": "砂糖やはちみつで甘味を足すと",
            "zh": "用糖或者蜂蜜把甜味补上",
            "narrator_zh": "雅"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "おいしいゆずジュースのできあがり",
            "zh": "好喝的柚子汁就做成了",
            "narrator_zh": "雅"
        },
        {
            "location": "188/ACT",
            "narrator": "",
            "text": "そのに…？",
            "zh": "是其二……？",
            "narrator_zh": ""
        },
        {
            "location": "189/TALK",
            "narrator": "みやび",
            "text": "なかなか面白いことを言うが",
            "zh": "说得倒挺有意思",
            "narrator_zh": "雅"
        },
        {
            "location": "190/TALK",
            "narrator": "みやび",
            "text": "そんな品種改良はされてないぞね",
            "zh": "可没有那样的品种改良咧",
            "narrator_zh": "雅"
        },
        {
            "location": "191/TALK",
            "narrator": "みやび",
            "text": "残念でした",
            "zh": "很遗憾",
            "narrator_zh": "雅"
        },
        {
            "location": "192/ACT",
            "narrator": "",
            "text": "そのさんでしょ！",
            "zh": "是其三吧！",
            "narrator_zh": ""
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "ほほう",
            "zh": "哦哦",
            "narrator_zh": "雅"
        },
        {
            "location": "195/TALK",
            "narrator": "みやび",
            "text": "これこそが独自見解",
            "zh": "这才是一家之言",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "即ちネットロアの成り立ち",
            "zh": "也就是网络传说的由来",
            "narrator_zh": "雅"
        },
        {
            "location": "197/TALK",
            "narrator": "みやび",
            "text": "いいものを見たぞね",
            "zh": "见到好东西了咧",
            "narrator_zh": "雅"
        }
    ]
}
