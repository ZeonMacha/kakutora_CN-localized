{
    "dir": "chap00/daydra/spev_notice_cd_01_04.js",
    "type": "",
    "info": {
        "story_id": "91054",
        "cid": "",
        "title": "004 アフターストーリー",
        "sub_title": "國政綾水の思い出",
        "title_zh": "004 后日谈",
        "sub_title_zh": "国政绫水的回忆"
    },
    "entry": [
        {
            "location": "1122/DIALOG",
            "narrator": "",
            "text": "<color=green>某月某日　4:07 PM</color>\nとある平日、寮「とらいあんぐる」アーヤの部屋にて。",
            "zh": "<color=green>某月某日　4:07 PM</color>\n某工作日，在宿舍“Tri-angle”绫水的房间。",
            "narrator_zh": ""
        },
        {
            "location": "1123/TALK",
            "narrator": "小夜",
            "text": "うん、美味しい！\nこのパニーニ最高よ！",
            "zh": "嗯，真好吃！\n这个帕尼尼绝了！",
            "narrator_zh": "小夜"
        },
        {
            "location": "1124/TALK",
            "narrator": "アーヤ",
            "text": "お店のメニューに\n追加しても平気そう？",
            "zh": "加进店里的菜单里\n应该没问题吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1125/TALK",
            "narrator": "小夜",
            "text": "問題なし。\n５００円までだったら\n私も出すと思うなぁ。",
            "zh": "完全没问题。\n只要在500日元以内，\n我也会愿意买单吧。",
            "narrator_zh": "小夜"
        },
        {
            "location": "1126/TALK",
            "narrator": "アーヤ",
            "text": "オッケー。\nじゃあこれは\nランチメニューで。",
            "zh": "OK。\n那就把这道列进\n午餐菜单里。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1127/TALK",
            "narrator": "小夜",
            "text": "だいぶメニューも\n固まってきたみたいね。",
            "zh": "菜单看着也\n基本定下来了呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "1129/TALK",
            "narrator": "アーヤ",
            "text": "小夜が手伝ってくれた\nおかげよ。",
            "zh": "多亏小夜过来\n帮忙了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1130/TALK",
            "narrator": "アーヤ",
            "text": "モーニング、ランチ、\nカフェタイム、それと\nサンセットメニュー――",
            "zh": "早餐、午餐、\n下午茶，还有\n日落菜单——",
            "narrator_zh": "绫水"
        },
        {
            "location": "1131/TALK",
            "narrator": "アーヤ",
            "text": "これ以上作ったら\nさすがに\n対応しきれないか…。",
            "zh": "再多加的话，\n大家肯定就\n忙不过来了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1132/TALK",
            "narrator": "小夜",
            "text": "増やし過ぎても\nみんなが\n死んじゃうわよ…。",
            "zh": "菜品加太多的话，\n大家会直接\n累趴下的哦……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "1133/TALK",
            "narrator": "小夜",
            "text": "…そういえば、\n劇場のロゴがあるって\n聞いたんだけど…。",
            "zh": "……说起来，\n我听说剧场本来就有\n一个标志来着……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "1134/TALK",
            "narrator": "アーヤ",
            "text": "あ、そうそう。\nまだ見せてなかったわね。",
            "zh": "啊，对对。\n还没给你看过呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1140/TALK",
            "narrator": "アーヤ",
            "text": "これよ。",
            "zh": "就是这个。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1141/TALK",
            "narrator": "小夜",
            "text": "へー、こんなにかっこいい\nロゴだったんだ？",
            "zh": "唔——，原来是\n这么帅气的标志啊？",
            "narrator_zh": "小夜"
        },
        {
            "location": "1142/TALK",
            "narrator": "アーヤ",
            "text": "色と中心の風車は\n私が付け足したもの\nだけどね。",
            "zh": "不过配色和中间的风车\n是我自己后来\n加进去的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1144/TALK",
            "narrator": "アーヤ",
            "text": "それで、今はこのロゴを\nどの食器に付けようか\n悩んでるの。",
            "zh": "然后，现在我正在发愁\n要把这个标志印在\n哪一款餐具上。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1145/TALK",
            "narrator": "小夜",
            "text": "へー、食器にロゴなんて\n中々本格的じゃない。",
            "zh": "哇，餐具上还要印标志，\n搞得还挺像模像样的嘛。",
            "narrator_zh": "小夜"
        },
        {
            "location": "1146/TALK",
            "narrator": "小夜",
            "text": "それで、どの食器に\nしようと思ってるわけ？",
            "zh": "那，你打算选\n哪种餐具啊？",
            "narrator_zh": "小夜"
        },
        {
            "location": "1147/TALK",
            "narrator": "アーヤ",
            "text": "まだ悩み中。\nみんなも、どれにするか\n迷ってるらしくて…。",
            "zh": "还在发愁呢。\n大家好像也都在犹豫\n要选哪一个……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1148/TALK",
            "narrator": "アーヤ",
            "text": "なにかオススメってある？",
            "zh": "你有什么推荐吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1149/TALK",
            "narrator": "小夜",
            "text": "別に、どれにしても\n変わらないと思うけど…。",
            "zh": "我觉得其实选哪个\n都没什么区别就是了……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "1150/TALK",
            "narrator": "小夜",
            "text": "普通にお皿とかで\nいいんじゃない？",
            "zh": "挑个普通的盘子之类的\n不就行了吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "1151/TALK",
            "narrator": "アーヤ",
            "text": "それは避けたいの。\nお皿は他の子が選びそうな\n気がするし…。",
            "zh": "那个我想避开。\n总觉得盘子会被\n其他女孩子挑走……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1152/TALK",
            "narrator": "小夜",
            "text": "それじゃ、残り物に\nするってこと？",
            "zh": "这么说，你打算捡\n别人挑剩下的咯？",
            "narrator_zh": "小夜"
        },
        {
            "location": "1154/TALK",
            "narrator": "アーヤ",
            "text": "それは…ちょっと\n寂しい気がするし…。",
            "zh": "那样的话……又总觉得\n有点寂寞……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1155/TALK",
            "narrator": "小夜",
            "text": "わがままなんだから…。",
            "zh": "真够任性的啊……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "1156/TALK",
            "narrator": "小夜",
            "text": "まあ、私のオススメは\nティーカップかな？",
            "zh": "嘛，我要推荐的话\n大概是茶杯吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "1157/TALK",
            "narrator": "アーヤ",
            "text": "どうして？",
            "zh": "为什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1158/TALK",
            "narrator": "小夜",
            "text": "紅茶が好きだからよ。\nどう、立派な理由でしょ？",
            "zh": "因为我喜欢红茶呀。\n怎样，很堂堂正正的理由吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "1159/TALK",
            "narrator": "アーヤ",
            "text": "あはは、納得。",
            "zh": "啊哈哈，说得通。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1174/TALK",
            "narrator": "アーヤ",
            "text": "ふう…。\n洗い物終わり、っと…。",
            "zh": "呼……。\n碗总算洗完了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1176/TALK",
            "narrator": "アーヤ",
            "text": "小夜のおかげで\nだいぶメニューも\n固まってきたし…。",
            "zh": "多亏了小夜，\n菜单也总算\n定得差不多了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1177/TALK",
            "narrator": "アーヤ",
            "text": "週末にでも、みんなに\n味見してもらおうかしら。",
            "zh": "趁着周末，让大家都来\n试吃一下吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1178/TALK",
            "narrator": "アーヤ",
            "text": "あと決めなくちゃ\nいけないのはデザートと\nアペタイザー……。",
            "zh": "接下来还得决定的，\n就是甜点和\n开胃菜了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1179/TALK",
            "narrator": "アーヤ",
            "text": "…そうだ。\n食器も選ばなくちゃ\nいけないんだった…。",
            "zh": "……对了。\n餐具也还没选好\n来着……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1180/TALK",
            "narrator": "アーヤ",
            "text": "本当、どうしよう…。\nどれ選んでも使うんだから\nなにも変わらないし…。",
            "zh": "真是的，该怎么办……。\n反正挑哪一种都会用上，\n其实根本没差……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1181/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1194/TALK",
            "narrator": "アーヤ",
            "text": "装弾",
            "zh": "上膛[?]",
            "narrator_zh": "绫水"
        },
        {
            "location": "1196/SEL",
            "narrator": "（選択肢）",
            "text": "物騒な！！",
            "zh": "好吓人！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1197/ACT",
            "narrator": "",
            "text": "物騒な！！",
            "zh": "好吓人！！",
            "narrator_zh": ""
        },
        {
            "location": "1199/TALK",
            "narrator": "アーヤ",
            "text": "相談！！(>_<)",
            "zh": "商谈！！(>_<)[?]",
            "narrator_zh": "绫水"
        },
        {
            "location": "1200/TALK",
            "narrator": "アーヤ",
            "text": "間違った(;^_^A",
            "zh": "打错了(;^_^A",
            "narrator_zh": "绫水"
        },
        {
            "location": "1201/TALK",
            "narrator": "アーヤ",
            "text": "スマホの変換がおかしい",
            "zh": "手机联想输入抽风了",
            "narrator_zh": "绫水"
        },
        {
            "location": "1203/TALK",
            "narrator": "アーヤ",
            "text": "それはそうと",
            "zh": "不说这个了",
            "narrator_zh": "绫水"
        },
        {
            "location": "1204/TALK",
            "narrator": "アーヤ",
            "text": "食器のこと",
            "zh": "餐具的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "1205/TALK",
            "narrator": "アーヤ",
            "text": "聞いてくれる？(￣Д￣ )",
            "zh": "能听我说说吗？(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "1207/SEL",
            "narrator": "（選択肢）",
            "text": "決まってないの？",
            "zh": "还没定下来吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1208/ACT",
            "narrator": "",
            "text": "決まってないの？",
            "zh": "还没定下来吗？",
            "narrator_zh": ""
        },
        {
            "location": "1210/TALK",
            "narrator": "アーヤ",
            "text": "決まってない",
            "zh": "还没定",
            "narrator_zh": "绫水"
        },
        {
            "location": "1211/TALK",
            "narrator": "アーヤ",
            "text": "だって",
            "zh": "因为啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "1212/TALK",
            "narrator": "アーヤ",
            "text": "どの食器がいいか",
            "zh": "突然被问起喜欢什么餐具",
            "narrator_zh": "绫水"
        },
        {
            "location": "1213/TALK",
            "narrator": "アーヤ",
            "text": "なんて聞かれて",
            "zh": "这种问题",
            "narrator_zh": "绫水"
        },
        {
            "location": "1214/TALK",
            "narrator": "アーヤ",
            "text": "どう答えろと？",
            "zh": "让我怎么答嘛？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1215/TALK",
            "narrator": "アーヤ",
            "text": "元々",
            "zh": "本来嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "1216/TALK",
            "narrator": "アーヤ",
            "text": "食器に興味あるなら別だけど",
            "zh": "对餐具感兴趣倒另当别论",
            "narrator_zh": "绫水"
        },
        {
            "location": "1217/TALK",
            "narrator": "アーヤ",
            "text": "私違うし",
            "zh": "可我又不是",
            "narrator_zh": "绫水"
        },
        {
            "location": "1220/TALK",
            "narrator": "アーヤ",
            "text": "$handle$は",
            "zh": "$handle$你",
            "narrator_zh": "绫水"
        },
        {
            "location": "1221/TALK",
            "narrator": "アーヤ",
            "text": "なにがいいと思う？",
            "zh": "觉得选什么好？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1223/SEL",
            "narrator": "（選択肢）",
            "text": "マグカップとか",
            "zh": "马克杯之类的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1224/SEL",
            "narrator": "（選択肢）",
            "text": "フォークかナイフは？",
            "zh": "叉子或者餐刀呢？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1225/ACT",
            "narrator": "",
            "text": "マグカップとか",
            "zh": "马克杯之类的",
            "narrator_zh": ""
        },
        {
            "location": "1226/TALK",
            "narrator": "アーヤ",
            "text": "いいんだけど",
            "zh": "是不错啦",
            "narrator_zh": "绫水"
        },
        {
            "location": "1227/TALK",
            "narrator": "アーヤ",
            "text": "なんか普通っていうか",
            "zh": "不过总觉得有点普通",
            "narrator_zh": "绫水"
        },
        {
            "location": "1228/TALK",
            "narrator": "アーヤ",
            "text": "他の子とかぶりそう",
            "zh": "好像会跟其他人撞上",
            "narrator_zh": "绫水"
        },
        {
            "location": "1229/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "1231/SEL",
            "narrator": "（選択肢）",
            "text": "フォークかナイフは？",
            "zh": "叉子或者餐刀呢？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1232/ACT",
            "narrator": "",
            "text": "フォークかナイフは？",
            "zh": "叉子或者餐刀呢？",
            "narrator_zh": ""
        },
        {
            "location": "1234/ACT",
            "narrator": "",
            "text": "フォークかナイフは？",
            "zh": "叉子或者餐刀呢？",
            "narrator_zh": ""
        },
        {
            "location": "1236/TALK",
            "narrator": "アーヤ",
            "text": "あー",
            "zh": "啊—",
            "narrator_zh": "绫水"
        },
        {
            "location": "1237/TALK",
            "narrator": "アーヤ",
            "text": "それならいいかも",
            "zh": "那个倒不错",
            "narrator_zh": "绫水"
        },
        {
            "location": "1238/TALK",
            "narrator": "アーヤ",
            "text": "みんな",
            "zh": "其他人",
            "narrator_zh": "绫水"
        },
        {
            "location": "1239/TALK",
            "narrator": "アーヤ",
            "text": "絶対選ばなそうだし",
            "zh": "肯定不会选这个",
            "narrator_zh": "绫水"
        },
        {
            "location": "1243/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "1244/TALK",
            "narrator": "アーヤ",
            "text": "縁起的には",
            "zh": "从彩头上讲",
            "narrator_zh": "绫水"
        },
        {
            "location": "1246/TALK",
            "narrator": "アーヤ",
            "text": "あまりよくないわよね",
            "zh": "不太吉利吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "1247/TALK",
            "narrator": "アーヤ",
            "text": "刃物は",
            "zh": "毕竟都说",
            "narrator_zh": "绫水"
        },
        {
            "location": "1248/TALK",
            "narrator": "アーヤ",
            "text": "縁を切るモノ",
            "zh": "带刃的东西",
            "narrator_zh": "绫水"
        },
        {
            "location": "1249/TALK",
            "narrator": "アーヤ",
            "text": "とかいうし",
            "zh": "会斩断缘分嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "1251/SEL",
            "narrator": "（選択肢）",
            "text": "それ、ギフトの話でしょ？",
            "zh": "那是说送礼的时候吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1252/SEL",
            "narrator": "（選択肢）",
            "text": "メイン武器剣だし、いいと思うのに",
            "zh": "主武器本来就是剑，我觉得挺好的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1253/ACT",
            "narrator": "",
            "text": "それ、ギフトの話でしょ？",
            "zh": "那是说送礼的时候吧？",
            "narrator_zh": ""
        },
        {
            "location": "1254/TALK",
            "narrator": "アーヤ",
            "text": "それはそうだけど",
            "zh": "话是这么说",
            "narrator_zh": "绫水"
        },
        {
            "location": "1255/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "绫水"
        },
        {
            "location": "1256/ACT",
            "narrator": "",
            "text": "メイン武器剣だし、いいと思うのに",
            "zh": "主武器本来就是剑，我觉得挺好的",
            "narrator_zh": ""
        },
        {
            "location": "1257/TALK",
            "narrator": "アーヤ",
            "text": "武器で食器選ばれても",
            "zh": "拿武器标准来挑餐具",
            "narrator_zh": "绫水"
        },
        {
            "location": "1259/TALK",
            "narrator": "アーヤ",
            "text": "困るから",
            "zh": "我也很困扰啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "1260/TALK",
            "narrator": "アーヤ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "绫水"
        },
        {
            "location": "1261/TALK",
            "narrator": "アーヤ",
            "text": "刃物はちょっと",
            "zh": "刀具还是有点",
            "narrator_zh": "绫水"
        },
        {
            "location": "1263/TALK",
            "narrator": "アーヤ",
            "text": "オリジナル食器だし",
            "zh": "毕竟是原创餐具",
            "narrator_zh": "绫水"
        },
        {
            "location": "1264/TALK",
            "narrator": "アーヤ",
            "text": "ギフトセットとか",
            "zh": "说不定以后还会",
            "narrator_zh": "绫水"
        },
        {
            "location": "1265/TALK",
            "narrator": "アーヤ",
            "text": "作るかもしれないでしょ",
            "zh": "做礼盒套装什么的吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "1266/TALK",
            "narrator": "アーヤ",
            "text": "それ考えるとね",
            "zh": "一想到这点呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "1269/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "1270/TALK",
            "narrator": "アーヤ",
            "text": "参考にするわ",
            "zh": "我会作参考的",
            "narrator_zh": "绫水"
        },
        {
            "location": "1281/TALK",
            "narrator": "アーヤ",
            "text": "…もう一度、小夜に、\n相談してみようかしら？",
            "zh": "……再找小夜\n商量一次看看吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1294/TALK",
            "narrator": "小夜",
            "text": "…いやいや、さすがに\n生真面目すぎでしょ。",
            "zh": "……不是我说，你这也\n实在太一本正经了吧。",
            "narrator_zh": "小夜"
        },
        {
            "location": "1295/TALK",
            "narrator": "小夜",
            "text": "今時縁起がどうとか、\nそんなこと深く考える人\nいないと思うけど？",
            "zh": "现在这年头，哪还有人\n会去深究什么\n吉不吉利的呀？",
            "narrator_zh": "小夜"
        },
        {
            "location": "1296/TALK",
            "narrator": "アーヤ",
            "text": "小夜は気にしないの？",
            "zh": "小夜你不会介意吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1297/TALK",
            "narrator": "小夜",
            "text": "ていうか、別に\nギフトセットの中身を\n決めてるわけじゃないし。",
            "zh": "话说回来，你现在又不是\n在决定礼盒里要\n装什么东西嘛。",
            "narrator_zh": "小夜"
        },
        {
            "location": "1299/TALK",
            "narrator": "アーヤ",
            "text": "そうだけど、でも…。",
            "zh": "话是没错，可是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1300/TALK",
            "narrator": "小夜",
            "text": "それに、ナイフ、スプーン\nフォークはカフェには絶対\n必要だと思うんだけど？",
            "zh": "再说了，餐刀、勺子和\n叉子在咖啡馆里\n不是绝对必需的吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "1301/TALK",
            "narrator": "小夜",
            "text": "後にギフトにするなら\nフォークとスプーンだけ\n入れればいいと思うし。",
            "zh": "以后真要做礼盒的话，\n只往里面放叉子和勺子\n不就行了吗。",
            "narrator_zh": "小夜"
        },
        {
            "location": "1302/TALK",
            "narrator": "アーヤ",
            "text": "あー、確かにそうかも。",
            "zh": "啊——，确实有道理。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1303/TALK",
            "narrator": "アーヤ",
            "text": "フォークとスプーンなら\nパスタ用ってことで\n丁度良さそうだし。",
            "zh": "如果是叉子和勺子，\n刚好还能当作吃意面\n用的餐具呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1304/TALK",
            "narrator": "小夜",
            "text": "そういうこと。",
            "zh": "就是这么回事。",
            "narrator_zh": "小夜"
        },
        {
            "location": "1306/TALK",
            "narrator": "アーヤ",
            "text": "気に入ったわ。\n早速みんなに話してみる。",
            "zh": "我很满意。\n这就去跟大家说说看。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1307/TALK",
            "narrator": "小夜",
            "text": "決まるといいわね。",
            "zh": "能顺利敲定就好了呢。",
            "narrator_zh": "小夜"
        }
    ]
}
