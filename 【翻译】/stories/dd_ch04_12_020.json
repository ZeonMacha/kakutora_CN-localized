{
    "dir": "chap12/daydra/dd_ch04_12_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "12456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ソフトボールの練習",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "垒球练习"
    },
    "entry": [
        {
            "location": "291/SCENARIO",
            "narrator": "",
            "text": "ソフトボールの練習",
            "zh": "垒球练习",
            "narrator_zh": ""
        },
        {
            "location": "306/TALK",
            "narrator": "キリト",
            "text": "よし、二人とも、\nグローブはちゃんと\nはめたな？",
            "zh": "好，你们俩，\n手套都好好\n戴上了没？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "308/TALK",
            "narrator": "つばめ",
            "text": "うん。\nよろしくお願いします。",
            "zh": "嗯。\n请多多指教。",
            "narrator_zh": "燕"
        },
        {
            "location": "310/TALK",
            "narrator": "雛",
            "text": "キリト、本気で\nお願いね。",
            "zh": "圣翔，这次\n认真拜托你哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "311/TALK",
            "narrator": "キリト",
            "text": "後で後悔すんなよ。",
            "zh": "待会儿别后悔啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "313/TALK",
            "narrator": "ヒカル",
            "text": "キリト、ほどほどに\nしないとダメですよ？",
            "zh": "圣翔，得适可而止\n才行哦？",
            "narrator_zh": "光"
        },
        {
            "location": "314/TALK",
            "narrator": "キリト",
            "text": "心配すんなって。",
            "zh": "不用担心啦。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "322/TALK",
            "narrator": "ヒカル",
            "text": "二人とも、頑張って！",
            "zh": "你们俩，加油！",
            "narrator_zh": "光"
        },
        {
            "location": "324/TALK",
            "narrator": "みやび",
            "text": "…元気やねぇ。",
            "zh": "……真有精神咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "326/TALK",
            "narrator": "ヒカル",
            "text": "あ、みやび先輩。",
            "zh": "啊，雅前辈。",
            "narrator_zh": "光"
        },
        {
            "location": "328/TALK",
            "narrator": "みやび",
            "text": "球技大会の\n練習しゆうが？",
            "zh": "是在练球类\n大会咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "329/TALK",
            "narrator": "ヒカル",
            "text": "はい。",
            "zh": "是的。",
            "narrator_zh": "光"
        },
        {
            "location": "330/TALK",
            "narrator": "ヒカル",
            "text": "二人とも、\nソフトボールの経験が\nないというので――",
            "zh": "因为听说她们俩，\n都没有打垒球的\n经验——",
            "narrator_zh": "光"
        },
        {
            "location": "331/TALK",
            "narrator": "ヒカル",
            "text": "キリトがコーチについて、\n守備の練習中なんです。",
            "zh": "所以圣翔当教练，\n正在练防守。",
            "narrator_zh": "光"
        },
        {
            "location": "334/TALK",
            "narrator": "みやび",
            "text": "精が出ちゅうねぇ…。",
            "zh": "真卖力呢咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "335/TALK",
            "narrator": "ヒカル",
            "text": "…みやび先輩は、\n練習しなくて\nいいんですか？",
            "zh": "……雅前辈，\n不用参加\n练习吗？",
            "narrator_zh": "光"
        },
        {
            "location": "337/TALK",
            "narrator": "みやび",
            "text": "体育の授業と同じで\n適当に流すき、\n練習はいらんがよ。",
            "zh": "跟体育课一样\n随便应付就行嘛，\n不用练习咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "338/TALK",
            "narrator": "ヒカル",
            "text": "…みやび先輩。\nそれは少々、問題発言かと\n思います。",
            "zh": "……雅前辈。\n这发言恐怕\n有点问题。",
            "narrator_zh": "光"
        },
        {
            "location": "339/TALK",
            "narrator": "ヒカル",
            "text": "個人ならまだしも、\nソフトボールはチームで\nプレイするものですし。",
            "zh": "个人还说得过去，\n但垒球是要全队\n一起打的。",
            "narrator_zh": "光"
        },
        {
            "location": "341/TALK",
            "narrator": "みやび",
            "text": "練習が面倒で言うてる\nわけやないんよ。",
            "zh": "我不是嫌练习\n麻烦才说的哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "342/TALK",
            "narrator": "みやび",
            "text": "去年の大会の時にな、\nちっくと真剣に\n力入れてやったら――",
            "zh": "去年大会的时候，\n我稍微认真\n较了一回劲——",
            "narrator_zh": "雅"
        },
        {
            "location": "344/TALK",
            "narrator": "みやび",
            "text": "ボールが変なところに\nばっか飛んでいきよって、\nぼろ負けしてな…。",
            "zh": "结果球老是往\n奇怪的地方飞，\n输得一塌糊涂……。",
            "narrator_zh": "雅"
        },
        {
            "location": "345/TALK",
            "narrator": "ヒカル",
            "text": "そんなことが…。",
            "zh": "还有这种事……。",
            "narrator_zh": "光"
        },
        {
            "location": "347/TALK",
            "narrator": "みやび",
            "text": "やき、今回は力を抜いて、\n適当に流すことにした\nんよ。",
            "zh": "所以嘛，这次我打算\n放轻松，随便\n应付过去哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "348/TALK",
            "narrator": "みやび",
            "text": "変に力むと、ロクなことに\nならんとわかったきね。",
            "zh": "瞎较劲没好事，\n这点我懂了嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "349/TALK",
            "narrator": "ヒカル",
            "text": "…すみませんでした。\n失礼な勘違いを\nしてしまって…。",
            "zh": "……对不起。\n是我失礼，\n误会了前辈……。",
            "narrator_zh": "光"
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "えいよえいよ。\n謝る必要ないぞね。",
            "zh": "得吧得吧。\n用不着道歉咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "353/TALK",
            "narrator": "みやび",
            "text": "…しっかし、本当に\n頑張っちゅうねぇ。",
            "zh": "……不过，她们是\n真卖力呢咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "354/SEL",
            "narrator": "",
            "text": "混ぜてもらえば？",
            "zh": "不如加入她们？",
            "narrator_zh": ""
        },
        {
            "location": "356/TALK",
            "narrator": "みやび",
            "text": "一日の授業を終えた\nばかりやし、みんな\n疲れてるはずやのに…。",
            "zh": "明明刚上完一天的课，\n大家应该都很累了\n才对……。",
            "narrator_zh": "雅"
        },
        {
            "location": "358/TALK",
            "narrator": "ヒカル",
            "text": "それだけ楽しみにしてる、\nということでしょうね。",
            "zh": "说明她们就\n那么期待吧。",
            "narrator_zh": "光"
        },
        {
            "location": "359/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "363/TALK",
            "narrator": "みやび",
            "text": "さてと、うちは先に\n帰らせてもらうき。",
            "zh": "那么，我先\n告辞回家咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "364/TALK",
            "narrator": "みやび",
            "text": "ヒカル君達も、あんまし\n帰り遅くならんようにな。",
            "zh": "光你们几个，\n也别回去太晚哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "366/TALK",
            "narrator": "ヒカル",
            "text": "わかりました。\nまた明日、みやび先輩。",
            "zh": "知道了。\n明天见，雅前辈。",
            "narrator_zh": "光"
        },
        {
            "location": "369/TALK",
            "narrator": "みやび",
            "text": "ん、また明日な。",
            "zh": "嗯，明天见咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "371/ACT",
            "narrator": "",
            "text": "混ぜてもらえば？",
            "zh": "不如加入她们？",
            "narrator_zh": ""
        },
        {
            "location": "376/TALK",
            "narrator": "みやび",
            "text": "ん…相棒か？",
            "zh": "嗯……是搭档？",
            "narrator_zh": "雅"
        },
        {
            "location": "392/TALK",
            "narrator": "みやび",
            "text": "練習に混ぜてもらえいうんか？",
            "zh": "要我跟她们一起练习？",
            "narrator_zh": "雅"
        },
        {
            "location": "393/TALK",
            "narrator": "みやび",
            "text": "却下、お断りや",
            "zh": "驳回，不接受",
            "narrator_zh": "雅"
        },
        {
            "location": "394/TALK",
            "narrator": "みやび",
            "text": "うちは身体を動かすんは好きやないし",
            "zh": "我又不喜欢活动身体",
            "narrator_zh": "雅"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "そもそも、練習する必要がないんよ",
            "zh": "说到底，我根本没必要练习哦",
            "narrator_zh": "雅"
        },
        {
            "location": "397/SEL",
            "narrator": "",
            "text": "自信ないんでしょ？",
            "zh": "你其实没自信吧？",
            "narrator_zh": ""
        },
        {
            "location": "398/SEL",
            "narrator": "",
            "text": "高校生活最後なんだよ？",
            "zh": "这可是高中生活的最后一次了哦？",
            "narrator_zh": ""
        },
        {
            "location": "399/ACT",
            "narrator": "",
            "text": "自信ないんでしょ？",
            "zh": "你其实没自信吧？",
            "narrator_zh": ""
        },
        {
            "location": "400/TALK",
            "narrator": "みやび",
            "text": "それは挑発のつもりか？",
            "zh": "这是在激将吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "401/TALK",
            "narrator": "みやび",
            "text": "残念、逆効果やね",
            "zh": "遗憾，适得其反咯",
            "narrator_zh": "雅"
        },
        {
            "location": "402/TALK",
            "narrator": "みやび",
            "text": "うちはそんな挑発に乗るほど、アホやないぞね",
            "zh": "我才没蠢到会上这种激将的当咧",
            "narrator_zh": "雅"
        },
        {
            "location": "413/TALK",
            "narrator": "みやび",
            "text": "…帰るわ。",
            "zh": "……回去了。",
            "narrator_zh": "雅"
        },
        {
            "location": "415/TALK",
            "narrator": "ヒカル",
            "text": "え？　あ、はい…。",
            "zh": "诶？　啊，好的……。",
            "narrator_zh": "光"
        },
        {
            "location": "416/TALK",
            "narrator": "ヒカル",
            "text": "また明日。",
            "zh": "明天见。",
            "narrator_zh": "光"
        },
        {
            "location": "418/TALK",
            "narrator": "みやび",
            "text": "ん、また明日な。",
            "zh": "嗯，明天见咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "423/TALK",
            "narrator": "ヒカル",
            "text": "…みやび先輩、何だか\n機嫌が悪かったような…？",
            "zh": "……雅前辈，好像\n有点不高兴……？",
            "narrator_zh": "光"
        },
        {
            "location": "424/ACT",
            "narrator": "",
            "text": "高校生活最後なんだよ？",
            "zh": "这可是高中生活的最后一次了哦？",
            "narrator_zh": ""
        },
        {
            "location": "426/TALK",
            "narrator": "みやび",
            "text": "おおっ、すっかり忘れちょった！",
            "zh": "哦哦，这茬忘得干干净净！",
            "narrator_zh": "雅"
        },
        {
            "location": "427/TALK",
            "narrator": "みやび",
            "text": "もう三年やき、これが最後の球技大会になるんか",
            "zh": "都三年级了嘛，这是最后一届球类大会了啊",
            "narrator_zh": "雅"
        },
        {
            "location": "428/TALK",
            "narrator": "みやび",
            "text": "…そう考えると、何となく感慨深い気持ちになってくるちや",
            "zh": "……这么一想，莫名就有点感慨滴",
            "narrator_zh": "雅"
        },
        {
            "location": "440/TALK",
            "narrator": "みやび",
            "text": "…やっぱり、うちも\n練習に混ぜてもらうぞね。",
            "zh": "……算了，我也来\n参加练习咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "442/TALK",
            "narrator": "ヒカル",
            "text": "やっぱり、少しはしないと\n不安ですか？",
            "zh": "果然不练一下\n不安心吗？",
            "narrator_zh": "光"
        },
        {
            "location": "443/TALK",
            "narrator": "みやび",
            "text": "いんや、練習する必要は\nないんやけんど――",
            "zh": "不是，练习本身\n没必要――",
            "narrator_zh": "雅"
        },
        {
            "location": "445/TALK",
            "narrator": "みやび",
            "text": "空気だけでも味わって\nおきたいんよ。",
            "zh": "只是想先感受一下\n气氛哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "446/TALK",
            "narrator": "ヒカル",
            "text": "わかりました。\n鞄は見ておきますから、\n行ってきてください。",
            "zh": "明白了。\n书包我帮忙看着，\n请去吧。",
            "narrator_zh": "光"
        },
        {
            "location": "449/TALK",
            "narrator": "みやび",
            "text": "ん、ありがとさん。\nおーい、うちも混ざって\nえいかー？",
            "zh": "嗯，多谢啦。\n喂——，我也来掺一脚\n得不得——？",
            "narrator_zh": "雅"
        },
        {
            "location": "471/TALK",
            "narrator": "みやび",
            "text": "はぁ…はぁ…。",
            "zh": "哈……哈……。",
            "narrator_zh": "雅"
        },
        {
            "location": "474/TALK",
            "narrator": "キリト",
            "text": "だ、大丈夫っすか？\nすっげぇ苦しそうっす\nけど…。",
            "zh": "没、没事吧？\n看着超级痛苦的\n样子……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "477/TALK",
            "narrator": "みやび",
            "text": "…だ、大丈夫や…。\nち、ちっくと…\n運動不足なだけやき…。",
            "zh": "……没、没事……。\n只、只是……\n稍微缺了点运动而已……。",
            "narrator_zh": "雅"
        },
        {
            "location": "479/TALK",
            "narrator": "雛",
            "text": "全然ちょっとには\n見えないけど…。",
            "zh": "可完全看不出\n'稍微'在哪里……。",
            "narrator_zh": "雏"
        },
        {
            "location": "485/TALK",
            "narrator": "みやび",
            "text": "しっかし…思うてたより\n楽しかったわ。",
            "zh": "不过……比想象中\n开心多了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "486/TALK",
            "narrator": "みやび",
            "text": "球技大会の空気を、\nちっくとだけ感じる\nつもりやったが――",
            "zh": "明明只是打算\n感受一下球类大会\n的气氛——",
            "narrator_zh": "雅"
        },
        {
            "location": "487/TALK",
            "narrator": "みやび",
            "text": "つい、夢中になって\nしもうたがよ。",
            "zh": "结果不知不觉\n就入迷了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "489/TALK",
            "narrator": "つばめ",
            "text": "本番が楽しみですね。",
            "zh": "好期待正式比赛呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "490/TALK",
            "narrator": "みやび",
            "text": "ん？　そうやね…。",
            "zh": "嗯？　是啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "491/TALK",
            "narrator": "みやび",
            "text": "まあ、うちは競技には\n出ないんやけんど。",
            "zh": "嘛，不过我不参加\n比赛就是了。",
            "narrator_zh": "雅"
        },
        {
            "location": "493/TALK",
            "narrator": "ヒカル",
            "text": "え？　それって\nどういうことですか？",
            "zh": "诶？那是\n什么意思？",
            "narrator_zh": "光"
        },
        {
            "location": "495/TALK",
            "narrator": "みやび",
            "text": "うち、球技大会では\n放送席で実況する係に\nなったんよ。",
            "zh": "我呀，在球类大会\n接了在广播席做\n实况的差事哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "498/TALK",
            "narrator": "キリト",
            "text": "は！？　\nみやび先輩が実況！？",
            "zh": "哈！？\n雅前辈做实况！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "499/TALK",
            "narrator": "つばめ",
            "text": "みやびさん、実況なんて\nできるんですか！？",
            "zh": "雅，实况这种事\n做得来吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "501/TALK",
            "narrator": "みやび",
            "text": "目の前で起こっちゅう\nことを説明するくらい\nやったら――",
            "zh": "要说把眼前发生的\n事讲解一下\n这种程度的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "503/TALK",
            "narrator": "みやび",
            "text": "どうとでもなるぞね。",
            "zh": "随便都能对付咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "504/TALK",
            "narrator": "みやび",
            "text": "やき、練習とはいえ\nボールを投げられて、\n結構楽しかったちや。",
            "zh": "所以嘛，虽说只是练习，\n能扔扔球，\n还是挺开心滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "506/TALK",
            "narrator": "つばめ",
            "text": "ま、まあ、そう思って\nくれたならよかった\nですけど…。",
