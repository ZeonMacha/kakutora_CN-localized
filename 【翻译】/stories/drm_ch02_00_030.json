{
 "dir": "dramatics/daydra/drm_ch02_00_030.js",
 "type": "Episode",
 "info": {
  "story_id": "2003",
  "cid": "ayami",
  "title": "らぶとーく 第03話",
  "sub_title": "記憶のかけら"
 },
 "entry": [
  {
   "location": "345/SCENARIO",
   "narrator": "",
   "text": "記憶のかけら"
  },
  {
   "location": "362/TALK",
   "narrator": "みやび",
   "text": "前にテレビだか\n雑誌だかで見たことが\nあるけんど――"
  },
  {
   "location": "363/TALK",
   "narrator": "みやび",
   "text": "マイペースなんは\n長女の特徴らしいぞね。"
  },
  {
   "location": "364/TALK",
   "narrator": "アーヤ",
   "text": "そうなの？",
   "zh": "是吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "365/TALK",
   "narrator": "みやび",
   "text": "つばめちゃんが\nいい例ぞね。",
   "zh": "燕就是\n好例子咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "366/TALK",
   "narrator": "みやび",
   "text": "長女ちゅうか\n一人っ子やけんど。"
  },
  {
   "location": "367/TALK",
   "narrator": "みやび",
   "text": "それにうちや。",
   "zh": "而且是我家咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "368/TALK",
   "narrator": "アーヤ",
   "text": "…ああ、確かに！"
  },
  {
   "location": "369/TALK",
   "narrator": "みやび",
   "text": "やき、そんな姉を持った\n次女は、長女を反面教師に\nキッチリさんになるんよ。"
  },
  {
   "location": "370/TALK",
   "narrator": "アーヤ",
   "text": "あはは…まあ、なんとなく\nわかる気がするわ。"
  },
  {
   "location": "372/TALK",
   "narrator": "アーヤ",
   "text": "本当、マイペースな姉を\n持つと苦労するのよ。"
  },
  {
   "location": "373/TALK",
   "narrator": "みやび",
   "text": "…そんなお姉さんの話を\nしちゃあくれんかね。"
  },
  {
   "location": "375/TALK",
   "narrator": "アーヤ",
   "text": "……………………\n…………………。"
  },
  {
   "location": "377/TALK",
   "narrator": "みやび",
   "text": "…ツンデレやね。",
   "zh": "……真是傲娇咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "378/TALK",
   "narrator": "アーヤ",
   "text": "……………………\nそういうんじゃないわ。"
  },
  {
   "location": "379/TALK",
   "narrator": "アーヤ",
   "text": "ただ姉なんかの\n話をしたくないだけよ。",
   "zh": "只是不想谈\n姐姐之类的事而已。",
   "narrator_zh": "绫水"
  },
  {
   "location": "380/TALK",
   "narrator": "みやび",
   "text": "そうなるとうちも\n嫌われゆうことになるん\nかね…。",
   "zh": "那样的话，我大概\n也会被\n讨厌咯……。",
   "narrator_zh": "雅"
  },
  {
   "location": "381/TALK",
   "narrator": "アーヤ",
   "text": "違うわ。\nそういうことじゃない。"
  },
  {
   "location": "382/TALK",
   "narrator": "アーヤ",
   "text": "あの人に比べれば、\nみやびなんてまだまだ\nしっかり者だし。"
  },
  {
   "location": "383/TALK",
   "narrator": "みやび",
   "text": "…まっこと、色々と\n苦労してきたんやね。",
   "zh": "……真是的，你也\n吃了不少苦咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "384/TALK",
   "narrator": "アーヤ",
   "text": "まあね…。"
  },
  {
   "location": "386/TALK",
   "narrator": "アーヤ",
   "text": "そういえば、マイペースは\n長女の特徴、って言ってた\nけど――",
   "zh": "说起来，你说过\n我行我素是\n长女的特征——",
   "narrator_zh": "绫水"
  },
  {
   "location": "387/TALK",
   "narrator": "アーヤ",
   "text": "男兄弟の場合でも\nそうなのかしら？"
  },
  {
   "location": "388/TALK",
   "narrator": "みやび",
   "text": "さあ？　トライナリーには\n男兄弟いる子はおらんき、\n知りようないけんど。",
   "zh": "这个嘛？　三重奏里\n没有有兄弟的孩子，\n所以也无从知道咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "389/TALK",
   "narrator": "アーヤ",
   "text": "そうよね…。"
  },
  {
   "location": "391/TALK",
   "narrator": "アーヤ",
   "text": "じゃあ、\nＢｏｔに聞いてみるわ。"
  },
  {
   "location": "397/TALK",
   "narrator": "アーヤ",
   "text": "質問"
  },
  {
   "location": "398/TALK",
   "narrator": "アーヤ",
   "text": "男兄弟の長男って"
  },
  {
   "location": "399/TALK",
   "narrator": "アーヤ",
   "text": "マイペースだったりする？（￣ー￣？）"
  },
  {
   "location": "401/SEL",
   "narrator": "",
   "text": "まずはマイペースの定義からだね",
   "zh": "先来定义一下什么叫我行我素吧",
   "narrator_zh": ""
  },
  {
   "location": "402/SEL",
   "narrator": "",
   "text": "マイペースすぎて登山するレベル",
   "zh": "我行我素到能去爬山的程度",
   "narrator_zh": ""
  },
  {
   "location": "403/SEL",
   "narrator": "",
   "text": "だと思うよ",
   "zh": "我觉得是",
   "narrator_zh": ""
  },
  {
   "location": "404/ACT",
   "narrator": "",
   "text": "まずはマイペースの定義からだね",
   "zh": "先来定义一下什么叫我行我素吧",
   "narrator_zh": ""
  },
  {
   "location": "405/TALK",
   "narrator": "アーヤ",
   "text": "え",
   "zh": "诶",
   "narrator_zh": "绫水"
  },
  {
   "location": "406/TALK",
   "narrator": "アーヤ",
   "text": "なんか面倒くさいわね",
   "zh": "总觉得很麻烦呢",
   "narrator_zh": "绫水"
  },
  {
   "location": "407/ACT",
   "narrator": "",
   "text": "マイペースすぎて登山するレベル",
   "zh": "我行我素到能去爬山的程度",
   "narrator_zh": ""
  },
  {
   "location": "408/TALK",
   "narrator": "アーヤ",
   "text": "意味がわからないわ"
  },
  {
   "location": "409/TALK",
   "narrator": "アーヤ",
   "text": "でもこれ",
   "zh": "可是这个",
   "narrator_zh": "绫水"
  },
  {
   "location": "410/TALK",
   "narrator": "アーヤ",
   "text": "マイペースと言えなくはないか"
  },
  {
   "location": "411/ACT",
   "narrator": "",
   "text": "だと思うよ",
   "zh": "我觉得是",
   "narrator_zh": ""
  },
  {
   "location": "412/TALK",
   "narrator": "アーヤ",
   "text": "そうなんだ(*^o^*)",
   "zh": "是这样啊(*^o^*)",
   "narrator_zh": "绫水"
  },
  {
   "location": "413/TALK",
   "narrator": "アーヤ",
   "text": "っていうか",
   "zh": "话说",
   "narrator_zh": "绫水"
  },
  {
   "location": "414/TALK",
   "narrator": "アーヤ",
   "text": "そんなこともわかるんだ？",
   "zh": "那种事你也懂？",
   "narrator_zh": "绫水"
  },
  {
   "location": "416/TALK",
   "narrator": "アーヤ",
   "text": "そうだ",
   "zh": "对了",
   "narrator_zh": "绫水"
  },
  {
   "location": "417/TALK",
   "narrator": "アーヤ",
   "text": "もしかして",
   "zh": "难道",
   "narrator_zh": "绫水"
  },
  {
   "location": "418/TALK",
   "narrator": "アーヤ",
   "text": "兄弟いたりする？(￣∇￣)"
  },
  {
   "location": "420/SEL",
   "narrator": "",
   "text": "姉妹ならいるよ",
   "zh": "姐妹的话倒是有",
   "narrator_zh": ""
  },
  {
   "location": "421/SEL",
   "narrator": "",
   "text": "兄弟も姉妹もいないし",
   "zh": "我既没兄弟也没姐妹",
   "narrator_zh": ""
  },
  {
   "location": "422/SEL",
   "narrator": "",
   "text": "実は６人兄弟で…",
   "zh": "其实我有六个兄弟姐妹……",
   "narrator_zh": ""
  },
  {
   "location": "423/SEL",
   "narrator": "",
   "text": "お姉様とお呼び！",
   "zh": "叫我姐姐大人！",
   "narrator_zh": ""
  },
  {
   "location": "424/SEL",
   "narrator": "",
   "text": "アーヤとは魂の兄弟だから",
   "zh": "因为和绫水是灵魂上的兄弟",
   "narrator_zh": ""
  },
  {
   "location": "425/ACT",
   "narrator": "",
   "text": "姉妹ならいるよ",
   "zh": "姐妹的话倒是有",
   "narrator_zh": ""
  },
  {
   "location": "426/TALK",
   "narrator": "アーヤ",
   "text": "冗談も言えるのね(-.-;)"
  },
  {
   "location": "427/ACT",
   "narrator": "",
   "text": "兄弟も姉妹もいないし",
   "zh": "我既没兄弟也没姐妹",
   "narrator_zh": ""
  },
  {
   "location": "428/TALK",
   "narrator": "アーヤ",
   "text": "まあそうよね(￣Д￣ )"
  },
  {
   "location": "429/ACT",
   "narrator": "",
   "text": "実は６人兄弟で…",
   "zh": "其实我有六个兄弟姐妹……",
   "narrator_zh": ""
  },
  {
   "location": "430/TALK",
   "narrator": "アーヤ",
   "text": "いや",
   "zh": "不对",
   "narrator_zh": "绫水"
  },
  {
   "location": "431/TALK",
   "narrator": "アーヤ",
   "text": "さすがにそれは盛り過ぎだから(￣Д￣ )",
   "zh": "那确实吹得过火了(￣Д￣ )",
   "narrator_zh": "绫水"
  },
  {
   "location": "432/ACT",
   "narrator": "",
   "text": "お姉様とお呼び！",
   "zh": "叫我姐姐大人！",
   "narrator_zh": ""
  },
  {
   "location": "433/TALK",
   "narrator": "アーヤ",
   "text": "お",
   "zh": "哦",
   "narrator_zh": "绫水"
  },
  {
   "location": "434/TALK",
   "narrator": "アーヤ",
   "text": "お姉様！？",
   "zh": "姐姐大人！？",
   "narrator_zh": "绫水"
  },
  {
   "location": "435/TALK",
   "narrator": "アーヤ",
   "text": "とは呼ばないかな、、、",
   "zh": "大概不会那么叫……",
   "narrator_zh": "绫水"
  },
  {
   "location": "436/ACT",
   "narrator": "",
   "text": "アーヤとは魂の兄弟だから",
   "zh": "因为和绫水是灵魂上的兄弟",
   "narrator_zh": ""
  },
  {
   "location": "437/TALK",
   "narrator": "アーヤ",
   "text": "ソウルメイト？"
  },
  {
   "location": "438/TALK",
   "narrator": "アーヤ",
   "text": "ソウルブラザー？"
  },
  {
   "location": "439/TALK",
   "narrator": "アーヤ",
   "text": "なんか",
   "zh": "总觉得",
   "narrator_zh": "绫水"
  },
  {
   "location": "440/TALK",
   "narrator": "アーヤ",
   "text": "例えが古くない？(-ω-;)"
  },
  {
   "location": "442/TALK",
   "narrator": "アーヤ",
   "text": "っていうか",
   "zh": "话说",
   "narrator_zh": "绫水"
  },
  {
   "location": "443/TALK",
   "narrator": "アーヤ",
   "text": "Ｂｏｔに兄弟がいるとか"
  },
  {
   "location": "444/TALK",
   "narrator": "アーヤ",
   "text": "あるわけないわよね"
  },
  {
   "location": "452/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "454/TALK",
   "narrator": "みやび",
   "text": "どうかしたが？",
   "zh": "怎么了？",
   "narrator_zh": "雅"
  },
  {
   "location": "456/TALK",
   "narrator": "アーヤ",
   "text": "ううん。\n別に。"
  },
  {
   "location": "457/TALK",
   "narrator": "アーヤ",
   "text": "ただ、男兄弟って\n気楽でいいかもって\n思っただけよ。",
   "zh": "只是，我觉得有兄弟\n也许会轻松一点\n而已。",
   "narrator_zh": "绫水"
  },
  {
   "location": "458/TALK",
   "narrator": "みやび",
   "text": "そうかねえ。",
   "zh": "是这样嘛。",
   "narrator_zh": "雅"
  },
  {
   "location": "459/TALK",
   "narrator": "みやび",
   "text": "隣の芝生は青いって\nだけやないかねえ。"
  },
  {
   "location": "460/TALK",
   "narrator": "アーヤ",
   "text": "……。"
  },
  {
   "location": "461/TALK",
   "narrator": "アーヤ",
   "text": "そういうことに\nしておくわ。",
   "zh": "就这么\n算了吧。",
   "narrator_zh": "绫水"
  },
  {
   "location": "462/TALK",
   "narrator": "アーヤ",
   "text": "そういうみやびは\nどうなの？",
   "zh": "那这样的雅\n怎么样呢？",
   "narrator_zh": "绫水"
  },
  {
   "location": "464/TALK",
   "narrator": "みやび",
   "text": "うちか？",
   "zh": "我咯？",
   "narrator_zh": "雅"
  },
  {
   "location": "465/TALK",
   "narrator": "みやび",
   "text": "うちは…。"
  },
  {
   "location": "466/TALK",
   "narrator": "みやび",
   "text": "その話をすると\nアーヤはうちという\nスーパハッカーを失う。",
   "zh": "说那件事的话，\n绫水就会失去\n我这个超级黑客咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "467/TALK",
   "narrator": "みやび",
   "text": "それでもよいなら\n話すぞね。",
   "zh": "那样也好的话\n我就说咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "468/TALK",
   "narrator": "アーヤ",
   "text": "またまた。\n冗談ばっかり。"
  },
  {
   "location": "469/TALK",
   "narrator": "アーヤ",
   "text": "でもそうね。\nお互い話したくない\n話はあるものね。",
   "zh": "不过是啊。\n总有些彼此都\n不想提的话呢。",
   "narrator_zh": "绫水"
  },
  {
   "location": "470/TALK",
   "narrator": "アーヤ",
   "text": "そういうことでしょ？",
   "zh": "就是这么回事吧？",
   "narrator_zh": "绫水"
  },
  {
   "location": "471/TALK",
   "narrator": "みやび",
   "text": "……。"
  },
  {
   "location": "472/TALK",
   "narrator": "アーヤ",
   "text": "わかったわ。\n紳士協定を\n結びましょう。"
  },
  {
   "location": "473/TALK",
   "narrator": "アーヤ",
   "text": "私はみやびの兄弟に\nついて聞かない。"
  },
  {
   "location": "474/TALK",
   "narrator": "アーヤ",
   "text": "だからみやびも\n私の姉については\nもう聞かないで。",
   "zh": "所以雅也别再\n问我姐姐的\n事了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "476/TALK",
   "narrator": "アーヤ",
   "text": "どう？",
   "zh": "怎么样？",
   "narrator_zh": "绫水"
  },
  {
   "location": "477/TALK",
   "narrator": "みやび",
   "text": "……。\nうちにはちっくと\n不利な条件ぞね。"
  },
  {
   "location": "478/TALK",
   "narrator": "アーヤ",
   "text": "そうかしら。\nいい条件だと\n思うけど。",
   "zh": "是这样吗。\n我觉得条件\n不错。",
   "narrator_zh": "绫水"
  },
  {
   "location": "479/TALK",
   "narrator": "アーヤ",
   "text": "じゃあ、\n協定成立ね。"
  },
  {
   "location": "360/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>5月某日　4:41 PM</color>\n放課後、神楽坂付近のカフェにて。"
  }
 ]
}
