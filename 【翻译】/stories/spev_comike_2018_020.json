{
    "dir": "chap00/daydra/spev_comike_2018_020.js",
    "type": "",
    "info": {
        "story_id": "91072",
        "cid": "",
        "title": "がすとちゃんサマー大作戦♪",
        "sub_title": "作戦２：特大布ポスターたたき売り！？",
        "title_zh": "GUST酱的夏日大作战♪",
        "sub_title_zh": "作战2：特大布海报大甩卖！？"
    },
    "entry": [
        {
            "location": "403/SCENARIO",
            "narrator": "",
            "text": "タペストリ",
            "zh": "挂毯",
            "narrator_zh": ""
        },
        {
            "location": "443/TALK",
            "narrator": "がすとちゃん",
            "text": "こんにちは！ ですの！",
            "zh": "你好！的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "444/TALK",
            "narrator": "がすとちゃん",
            "text": "みんなの夢を叶える\nがすとちゃんですの。",
            "zh": "正是实现大家梦想的\nGUST酱的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "445/TALK",
            "narrator": "がすとちゃん",
            "text": "今回は、来たる\n夏の一大イベント情報を\nお届けするですの！",
            "zh": "这次要为各位送上\n即将到来的\n夏季大型活动情报的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "446/SEL",
            "narrator": "（選択肢）",
            "text": "待ってました！",
            "zh": "等好久了！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "447/SEL",
            "narrator": "（選択肢）",
            "text": "よっ、守銭奴！",
            "zh": "哟，守财奴！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "448/ACT",
            "narrator": "",
            "text": "待ってました！",
            "zh": "等好久了！",
            "narrator_zh": ""
        },
        {
            "location": "457/TALK",
            "narrator": "がすとちゃん",
            "text": "お待たせですの！",
            "zh": "让你久等的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "460/TALK",
            "narrator": "がすとちゃん",
            "text": "ところで、\n$handle$さんは\n勿論買いまくるですの？",
            "zh": "话说回来，\n$handle$\n当然会买买买个够的说？",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "461/SEL",
            "narrator": "（選択肢）",
            "text": "まぁ、欲しい分だけ",
            "zh": "嘛，就买想要的那份",
            "narrator_zh": "（选项）"
        },
        {
            "location": "462/ACT",
            "narrator": "",
            "text": "まぁ、欲しい分だけ",
            "zh": "嘛，就买想要的那份",
            "narrator_zh": ""
        },
        {
            "location": "465/TALK",
            "narrator": "がすとちゃん",
            "text": "やる気が足りないですの！",
            "zh": "干劲不够的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "466/TALK",
            "narrator": "がすとちゃん",
            "text": "もっとこう、\n破産するくらいの勢いで\n買う意欲を見せるですの。",
            "zh": "要再拿出那种\n恨不得买到破产的气势、\n展现购买欲才行的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "468/TALK",
            "narrator": "がすとちゃん",
            "text": "$handle$なら\n出来るはずですの！",
            "zh": "是$handle$的话\n肯定能做到的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "469/ACT",
            "narrator": "",
            "text": "よっ、守銭奴！",
            "zh": "哟，守财奴！",
            "narrator_zh": ""
        },
        {
            "location": "471/TALK",
            "narrator": "がすとちゃん",
            "text": "守銭奴とは何ですの！",
            "zh": "什么叫守财奴的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "472/TALK",
            "narrator": "がすとちゃん",
            "text": "がすとは真心込めて\n利益を追求してる\nだけですの！",
            "zh": "GUST酱只是怀着一颗真心\n在追求利润\n而已的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "474/TALK",
            "narrator": "がすとちゃん",
            "text": "それが即ち\n$handle$の\n利益にもなるですの！",
            "zh": "而这同时也就等同于\n$handle$的\n利益的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "476/SEL",
            "narrator": "（選択肢）",
            "text": "お客を呼び捨て！？",
            "zh": "直呼顾客的名字！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "477/ACT",
            "narrator": "",
            "text": "お客を呼び捨て！？",
            "zh": "直呼顾客的名字！？",
            "narrator_zh": ""
        },
        {
            "location": "490/TALK",
            "narrator": "がすとちゃん",
            "text": "細けぇことはいいですの。\n$handle$と\nがすとの仲ですの。",
            "zh": "小节什么的不用在意的说。\n毕竟这是$handle$和\nGUST酱之间的交情的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "493/TALK",
            "narrator": "がすとちゃん",
            "text": "というわけで、\nさっそくお知らせですの！",
            "zh": "那么话不多说，\n马上进入正题通知的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "494/TALK",
            "narrator": "がすとちゃん",
            "text": "まずは、コレ！",
            "zh": "首先是这个！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "501/DIALOG",
            "narrator": "",
            "text": "type.トライナリー",
            "zh": "type.三重奏",
            "narrator_zh": ""
        },
        {
            "location": "503/TALK",
            "narrator": "がすとちゃん",
            "text": "特大タペストリー\ntype.トライナリー\nですの！",
            "zh": "超大挂毯\ntype.三重奏\n的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "507/SEL",
            "narrator": "（選択肢）",
            "text": "お～！",
            "zh": "哦～！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "508/ACT",
            "narrator": "",
            "text": "お～！",
            "zh": "哦～！",
            "narrator_zh": ""
        },
        {
            "location": "512/DIALOG",
            "narrator": "",
            "text": "type.トライナリー",
            "zh": "type.三重奏",
            "narrator_zh": ""
        },
        {
            "location": "515/TALK",
            "narrator": "がすとちゃん",
            "text": "このアイテムは\n全botさん必携ですの。",
            "zh": "这件商品可是\n所有bot必入单品的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "516/TALK",
            "narrator": "がすとちゃん",
            "text": "なんてったって\nトライナリーの5人全員が\n描かれてるんですの！",
            "zh": "因为上面画的可是\n三重奏的5个人全员\n都齐聚一堂的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "518/TALK",
            "narrator": "がすとちゃん",
            "text": "がすとが調べた\nところによると…。",
            "zh": "根据GUST酱\n调查的结果来看……",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "519/TALK",
            "narrator": "がすとちゃん",
            "text": "botという人種は\n大きく5つのタイプに\n分類できる様子ですの。",
            "zh": "bot这种群体\n大致可以分成5种类型\n的样子的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "521/TALK",
            "narrator": "がすとちゃん",
            "text": "まずは、\n逢瀬つばめ推しの\n「フィナンシェ」！",
            "zh": "首先是\n推逢濑燕的\n「费南雪」！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "522/TALK",
            "narrator": "がすとちゃん",
            "text": "フィナンシェの印象は\n一見すると穏健だけど\n中身はヤバそうですの。",
            "zh": "费南雪给人的印象是\n乍一看挺温和，\n内里却疯狂得很的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "523/TALK",
            "narrator": "がすとちゃん",
            "text": "それと、\n國政綾水推しの\n「アヤミスト」！",
            "zh": "然后是\n推国政绫水的\n「绫水主义者」！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "524/TALK",
            "narrator": "がすとちゃん",
            "text": "アヤミストは\n行動力とか内に秘めたる\n情愛とかが凄そうですの！",
            "zh": "绫水主义者们\n行动力也好、藏在心底的\n深情也好，感觉都超厉害的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "525/TALK",
            "narrator": "がすとちゃん",
            "text": "要するにヤベーですの！",
            "zh": "总而言之就是够疯狂的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "527/TALK",
            "narrator": "がすとちゃん",
            "text": "ガブリエラ推しの\n「マルザンナ」は\n何かもうヤベーですの！",
            "zh": "推加布里埃拉的\n「玛尔赞娜」\n总觉得已经彻底疯狂了的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "528/TALK",
            "narrator": "がすとちゃん",
            "text": "たとえ一部だけであっても\n全体がヤバそうですの！",
            "zh": "哪怕只是其中一部分，\n整体都感觉够疯狂的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "530/TALK",
            "narrator": "がすとちゃん",
            "text": "その一方で、\n恋ヶ崎みやび推しの\n「相棒」は──",
            "zh": "而另一边，\n推恋之崎雅的\n「搭档」则是——",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "531/TALK",
            "narrator": "がすとちゃん",
            "text": "見たところ一番\n穏やかそうな派閥ですの。",
            "zh": "表面看起来最\n温和的一派的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "533/TALK",
            "narrator": "がすとちゃん",
            "text": "でも、想いを募らせると\nヤバいくらいに真剣な\n想いが出てきそうですの。",
            "zh": "可是真要积累起感情，\n感觉会爆发出疯狂到不行的\n认真心意的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "534/TALK",
            "narrator": "がすとちゃん",
            "text": "そして、\n卯月神楽推しの\nbotさんたちは…。",
            "zh": "以及，\n推卯月神乐的\nbot们……。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "535/TALK",
            "narrator": "がすとちゃん",
            "text": "何て呼べばいいですの？\nゴミ？　犬？\n下僕ちゃん？",
            "zh": "该怎么称呼好呢的说？\n垃圾？ 狗？\n还是小奴仆？",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "537/TALK",
            "narrator": "がすとちゃん",
            "text": "いずれにしても、\nそんな扱いでも愛を貫く\nヤベー人たちですの！",
            "zh": "无论如何，都是些\n即便被那样对待也能贯彻爱意的\n疯狂家伙的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "538/TALK",
            "narrator": "がすとちゃん",
            "text": "結論！\nbotさんはみんな\nヤベーですの！！",
            "zh": "结论！\nbot们全员\n都够疯狂的说！！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "545/TALK",
            "narrator": "がすとちゃん",
            "text": "あ、ヤベーってのは\nいちおう誉め言葉と\n受け取ってほしいですの。",
            "zh": "啊，这个“疯狂”\n姑且还是希望各位能当成\n褒义词来理解的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "546/TALK",
            "narrator": "がすとちゃん",
            "text": "ちなみに、\n$handle$は\nどのタイプですの？",
            "zh": "顺便一问，\n$handle$\n是哪种类型的说？",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "547/SEL",
            "narrator": "（選択肢）",
            "text": "フィナンシェ",
            "zh": "费南雪",
            "narrator_zh": "（选项）"
        },
        {
            "location": "548/SEL",
            "narrator": "（選択肢）",
            "text": "アヤミスト",
            "zh": "绫水主义者",
            "narrator_zh": "（选项）"
        },
        {
            "location": "549/SEL",
            "narrator": "（選択肢）",
            "text": "マルザンナ",
            "zh": "玛尔赞娜",
            "narrator_zh": "（选项）"
        },
        {
            "location": "550/SEL",
            "narrator": "（選択肢）",
            "text": "相棒",
            "zh": "搭档",
            "narrator_zh": "（选项）"
        },
        {
            "location": "551/SEL",
            "narrator": "（選択肢）",
            "text": "ゴミ、犬、下僕",
            "zh": "垃圾、狗、奴仆",
            "narrator_zh": "（选项）"
        },
        {
            "location": "554/ACT",
            "narrator": "",
            "text": "フィナンシェ",
            "zh": "费南雪",
            "narrator_zh": ""
        },
        {
            "location": "555/ACT",
            "narrator": "",
            "text": "アヤミスト",
            "zh": "绫水主义者",
            "narrator_zh": ""
        },
        {
            "location": "556/ACT",
            "narrator": "",
            "text": "マルザンナ",
            "zh": "玛尔赞娜",
            "narrator_zh": ""
        },
        {
            "location": "557/ACT",
            "narrator": "",
            "text": "相棒",
            "zh": "搭档",
            "narrator_zh": ""
        },
        {
            "location": "558/ACT",
            "narrator": "",
            "text": "ゴミ、犬、下僕",
            "zh": "垃圾、狗、奴仆",
            "narrator_zh": ""
        },
        {
            "location": "560/TALK",
            "narrator": "がすとちゃん",
            "text": "いや、\n聞くまでもないですの。",
            "zh": "不对，\n根本用不着问的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "578/TALK",
            "narrator": "がすとちゃん",
            "text": "どっちみち\n$handle$は\nヤベーですの！",
            "zh": "反正不管选哪个\n$handle$\n都够疯狂的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "579/SEL",
            "narrator": "（選択肢）",
            "text": "聞けよ！",
            "zh": "你倒是听人说话啊！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "580/ACT",
            "narrator": "",
            "text": "聞けよ！",
            "zh": "你倒是听人说话啊！",
            "narrator_zh": ""
        },
        {
            "location": "581/TALK",
            "narrator": "がすとちゃん",
            "text": "積もる話は\nお会計の時にでも\n聞くですの！",
            "zh": "想聊的话\n等结账的时候再\n慢慢听你说的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "584/TALK",
            "narrator": "がすとちゃん",
            "text": "と、脱線したけど\nこのタペストリーは\n服装にも注目ですの。",
            "zh": "好，虽然跑题了，\n这张挂毯的\n服装也很值得关注的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "585/TALK",
            "narrator": "がすとちゃん",
            "text": "いくつかある\nヒロインたちの\n私服のうち──",
            "zh": "在女主角们的\n好几套便服\n之中——",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "587/TALK",
            "narrator": "がすとちゃん",
            "text": "これまでイラストで\nあまり描かれたことのない\nバージョンの私服ですの！",
            "zh": "这可是截至目前在插画里\n很少画过的\n那版便服的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "592/TALK",
            "narrator": "がすとちゃん",
            "text": "私服の姿で\n至福のひととき！\nですの！！",
            "zh": "便服姿态带来的\n至福时光！\n的说！！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "594/TALK",
            "narrator": "がすとちゃん",
            "text": "こういう私服の\n設定画とかもブログで\n公開すれば──",
            "zh": "要是把这种便服的\n设定图之类也拿到博客上\n公开的话——",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "595/TALK",
            "narrator": "がすとちゃん",
            "text": "きっとタペストリーの\n販促になるですの。",
            "zh": "肯定能替挂毯\n好好促销一波的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "596/TALK",
            "narrator": "がすとちゃん",
            "text": "デイトラの関係者に\n提案してやるですの…！",
            "zh": "这就去向每日三重奏的\n相关人士提议一下的说……！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "597/SEL",
            "narrator": "（選択肢）",
            "text": "何か企んでる？",
            "zh": "在密谋什么？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "598/ACT",
            "narrator": "",
            "text": "何か企んでる？",
            "zh": "在密谋什么？",
            "narrator_zh": ""
        },
        {
            "location": "600/TALK",
            "narrator": "がすとちゃん",
            "text": "大丈夫ですの。\n企んでるのは\nいつものことですの。",
            "zh": "没关系的说。\n在密谋什么\n本来就是日常操作的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "602/TALK",
            "narrator": "がすとちゃん",
            "text": "そして！\nタペストリーは\nもうひとつあるですの。",
            "zh": "而且！\n挂毯其实\n还有另外一款的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "604/TALK",
            "narrator": "がすとちゃん",
            "text": "それが、コレ！",
            "zh": "那就是，这个！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "611/DIALOG",
            "narrator": "",
            "text": "type.千羽鶴＆エリカ",
            "zh": "type.千羽鹤＆领火",
            "narrator_zh": ""
        },
        {
            "location": "613/TALK",
            "narrator": "がすとちゃん",
            "text": "特大タペストリー\ntype.千羽鶴＆エリカ\nですのー！",
            "zh": "超大挂毯\ntype.千羽鹤＆领火\n的说——！",
            "narrator_zh": "GUST酱"
        },
