{
    "dir": "dramatics/daydra/drm_ch01_00_440.js",
    "type": "Episode",
    "info": {
        "story_id": "1044",
        "cid": "tsubame",
        "title": "らぶとーく 第44話",
        "sub_title": "どうにもならないことだってある",
        "title_zh": "恋爱漫谈 第44话",
        "sub_title_zh": "也有没办法的事"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "どうにもならないことだってある",
            "zh": "也有没办法的事",
            "narrator_zh": ""
        },
        {
            "location": "19/TALK",
            "narrator": "つばめ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "22/TALK",
            "narrator": "アーヤ",
            "text": "つばめ、大丈夫？\n元気なさそうだけど…。",
            "zh": "燕，没事吧？\n好像没什么精神……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "24/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん…。\nいえ、大丈夫です。",
            "zh": "绫水……。\n没有，我没事。",
            "narrator_zh": "燕"
        },
        {
            "location": "25/TALK",
            "narrator": "アーヤ",
            "text": "そう…私の考え過ぎ\nだったかしら？",
            "zh": "是这样……是我\n想太多了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "みやびに言われたことを\n考えて――",
            "zh": "是不是在想雅\n跟你说过的话——",
            "narrator_zh": "绫水"
        },
        {
            "location": "27/TALK",
            "narrator": "アーヤ",
            "text": "落ち込んでるん\nじゃないか、って\n思ったんだけど…。",
            "zh": "心里正消沉着\n吧，我是\n这么想的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "28/TALK",
            "narrator": "つばめ",
            "text": "えっ…知ってたんですか？",
            "zh": "诶……你知道吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "30/TALK",
            "narrator": "アーヤ",
            "text": "やっぱりね…。\nみやびも気にしてたわ。",
            "zh": "果然啊……。\n雅也在意这件事哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "つばめを困らせて\nしまったかもしれない、\nってね。",
            "zh": "也许让燕\n为难了，\n我是说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "そうだったんですか…。",
            "zh": "是这样啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "まあ、つばめが卯月の\nことを心配しているのは\nわかるんだけど――",
            "zh": "嘛，我明白燕\n是在担心\n卯月——",
            "narrator_zh": "绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "アーヤ",
            "text": "みやびも言った通り、\nあまり思いつめたり、\n肩入れし過ぎるのは――",
            "zh": "就像雅说过的，\n钻牛角尖或者\n偏袒得太过分——",
            "narrator_zh": "绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "アーヤ",
            "text": "つばめのために\nならないわ。",
            "zh": "对燕\n不好的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "36/TALK",
            "narrator": "アーヤ",
            "text": "わかってても、\nわからなくなる…。",
            "zh": "就算明明懂了，\n也会又弄不懂……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "アーヤ",
            "text": "それが人の気持ちって\nやつなんだから。",
            "zh": "因为那就是所谓的\n人心。",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "わかってても、\nわからなくなる…ですか？",
            "zh": "就算明明懂了，\n也会又弄不懂……是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "40/TALK",
            "narrator": "アーヤ",
            "text": "そうよ。",
            "zh": "是呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "41/TALK",
            "narrator": "アーヤ",
            "text": "だから、あまり考え過ぎ\nない方が、私もいいと\n思うわ。",
            "zh": "所以，我觉得还是\n别想太多\n比较好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "42/SEL",
            "narrator": "",
            "text": "だから知りたくなるんだよね",
            "zh": "所以才会想打听",
            "narrator_zh": ""
        },
        {
            "location": "43/SEL",
            "narrator": "",
            "text": "わからないままにするのも手かな",
            "zh": "一直不明白下去也许也是个办法",
            "narrator_zh": ""
        },
        {
            "location": "44/SEL",
            "narrator": "",
            "text": "答える義理はないと思う",
            "zh": "我觉得没义务回答",
            "narrator_zh": ""
        },
        {
            "location": "46/TALK",
            "narrator": "つばめ",
            "text": "…アーヤさんも、\nみやびさんと同じ\n考えなんだ…。",
            "zh": "……原来绫水小姐\n和雅小姐\n想法一样……。",
            "narrator_zh": "燕"
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、そういうもの\nなのかな？",
            "zh": "果然，事情就是\n那样的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "わたし、肩入れし過ぎ\nなのかな？",
            "zh": "我、真的偏袒过头\n了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "52/TALK",
            "narrator": "アーヤ",
            "text": "…って、ごめんね。\n余計落ち込ませるような\nこと言ったかしら？",
            "zh": "……那个，抱歉啦。\n我说的话反倒让你\n更消沉了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "つばめ",
            "text": "いえ、そんなこと\nないです。",
            "zh": "没有，\n不是那样。",
            "narrator_zh": "燕"
        },
        {
            "location": "54/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんも\nみやびさんも――",
            "zh": "不管是绫水\n还是雅——",
            "narrator_zh": "燕"
        },
        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "わたしのことを想って\n言ってくれてるの、\nちゃんとわかりますし。",
            "zh": "都是为了我好\n才说这些话的，\n我都清楚得很。",
            "narrator_zh": "燕"
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "そう…よかった。",
            "zh": "是嘛……太好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "57/TALK",
            "narrator": "アーヤ",
            "text": "とりあえず、そのことを\n忘れないでね。",
            "zh": "总之，别忘了\n那件事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "63/TALK",
            "narrator": "つばめ",
            "text": "本当、どうするのが\n正しいのかな？",
            "zh": "到底怎么做\n才是对的呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "65/ACT",
            "narrator": "",
            "text": "だから知りたくなるんだよね",
            "zh": "所以才会想打听",
            "narrator_zh": ""
        },
        {
            "location": "83/TALK",
            "narrator": "つばめ",
            "text": "ぅん",
            "zh": "嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "84/TALK",
            "narrator": "つばめ",
            "text": "その通りだと思ぅよ",
            "zh": "我觉得确实如此",
            "narrator_zh": "燕"
        },
        {
            "location": "96/TALK",
            "narrator": "つばめ",
            "text": "でも、そうなるからこそ、\n知りたいんだと思います。",
            "zh": "不过，正因如此，\n我才想知道。",
            "narrator_zh": "燕"
        },
        {
            "location": "97/TALK",
            "narrator": "つばめ",
            "text": "わかっててもわからなく\nなるようなことに\nならないためにも――",
            "zh": "正为了不变成那种\n就算明白过也弄不明白\n的地步——",
            "narrator_zh": "燕"
        },
        {
            "location": "98/TALK",
            "narrator": "つばめ",
            "text": "しっかりと知っておき\nたいんです。",
            "zh": "我才更想好好\n了解清楚。",
            "narrator_zh": "燕"
        },
        {
            "location": "99/TALK",
            "narrator": "アーヤ",
            "text": "…なるほどね。",
            "zh": "……原来如此。",
            "narrator_zh": "绫水"
        },
        {
            "location": "100/TALK",
            "narrator": "つばめ",
            "text": "…間違ってますか？",
            "zh": "……是我错了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "101/TALK",
            "narrator": "アーヤ",
            "text": "さあ、どうかしら？",
            "zh": "这个嘛，怎么样呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "ただ、知りたくなる、\nっていうのは、\nつばめの気持ちよね？",
            "zh": "只是，会想知道，\n那就是\n燕的心情吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "でも、相手が気持ちを\n知られたくなくて、\n隠してる場合――",
            "zh": "不过，对方不想让人\n知道自己的心情，\n藏着的时候——",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "それは、間違ったことに\nなると思うわ。",
            "zh": "我觉得那就\n错了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "107/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "108/TALK",
            "narrator": "アーヤ",
            "text": "まあ、だからって\n納得するとは思えない\nけど――",
            "zh": "嘛，虽然这么说\n我也没指望你能\n一下想通——",
            "narrator_zh": "绫水"
        },
        {
            "location": "109/TALK",
            "narrator": "アーヤ",
            "text": "どうにもならないことも\nある、っていうのは\n覚えておいてね…じゃあ。",
            "zh": "也有没办法的事，\n这个你记着……\n那么。",
            "narrator_zh": "绫水"
        },
        {
            "location": "113/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "115/TALK",
            "narrator": "つばめ",
            "text": "卯月さんは、知られたく\nないと思ってるのかな？",
            "zh": "卯月小姐是不是不想\n被人知道呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "116/ACT",
            "narrator": "",
            "text": "わからないままにするのも手かな",
            "zh": "一直不明白下去也许也是个办法",
            "narrator_zh": ""
        },
        {
            "location": "134/TALK",
            "narrator": "つばめ",
            "text": "ダメだよ(´・ω・｀)",
            "zh": "那不行啦(´・ω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "135/TALK",
            "narrator": "つばめ",
            "text": "わからなぃままになんてしたくなぃ！",
            "zh": "我不想就这么不明不白下去！",
            "narrator_zh": "燕"
        },
        {
            "location": "147/TALK",
            "narrator": "つばめ",
            "text": "…アーヤさんには、\n分からない気持ちって\nあるんですか？",
            "zh": "……绫水小姐也有\n不能理解的\n心情吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "148/TALK",
            "narrator": "アーヤ",
            "text": "…もちろんよ。",
            "zh": "…当然哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "149/TALK",
            "narrator": "アーヤ",
            "text": "人間、わからない気持ちが\nあるのが普通なんじゃない\nかしら？",
            "zh": "人嘛，有些弄不懂的\n心情才正常\n不是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "150/TALK",
            "narrator": "アーヤ",
            "text": "相手の気持ちなんて、\n目に見えて触れられる\nものじゃないんだし――",
            "zh": "对方的心情这种东西，\n既看不见\n也摸不着——",
            "narrator_zh": "绫水"
        },
        {
            "location": "151/TALK",
            "narrator": "アーヤ",
            "text": "逆に、全部わかる、なんて\nいう人は信じられないわ。",
            "zh": "反倒是一口咬定什么都懂的人，\n才叫人没法相信哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "154/TALK",
            "narrator": "アーヤ",
            "text": "納得しろとは言わない\nけど、どうにもならない\nこともある――",
            "zh": "我不是叫你非得\n接受，只是有些事\n确实没办法——",
            "narrator_zh": "绫水"
        },
        {
            "location": "155/TALK",
            "narrator": "アーヤ",
            "text": "それを覚えておいて\nもらえればいいわ。",
            "zh": "你记得那个\n就行了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "158/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "161/TALK",
            "narrator": "つばめ",
            "text": "卯月さんは、知られたく\nないと思ってるのかな？",
            "zh": "卯月小姐是不是不想\n被人知道呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "162/ACT",
            "narrator": "",
            "text": "答える義理はないと思う",
            "zh": "我觉得没义务回答",
            "narrator_zh": ""
        },
        {
            "location": "180/TALK",
            "narrator": "つばめ",
            "text": "そぅぃぅわけにはぃかなぃよ",
            "zh": "可不能那样啦",
            "narrator_zh": "燕"
        },
        {
            "location": "181/TALK",
            "narrator": "つばめ",
            "text": "聞かれたことには答えなきゃ",
            "zh": "被问到的话就得好好回答呀",
            "narrator_zh": "燕"
        },
        {
            "location": "193/TALK",
            "narrator": "つばめ",
            "text": "…もし、アーヤさんの\n言うような状況に\nなったとしたら――",
            "zh": "……如果，真的变成\n绫水小姐说的\n那种情况的话——",
            "narrator_zh": "燕"
        },
        {
            "location": "194/TALK",
            "narrator": "つばめ",
            "text": "聞けばいいと思います。",
            "zh": "去问本人就好了。",
            "narrator_zh": "燕"
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "聞くって、本人に\nあなたの気持ちを教えて、\nって聞くつもり？",
            "zh": "去问，你是打算直接\n跑去问本人“把你的\n心情告诉我”吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "196/TALK",
            "narrator": "つばめ",
            "text": "はい。\nそれが一番早いし、\n確実だと思いますし…。",
            "zh": "是的。\n那样最快，\n我觉得也最稳妥……。",
            "narrator_zh": "燕"
        },
        {
            "location": "198/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "199/TALK",
            "narrator": "アーヤ",
            "text": "つばめ…あなたって、\nちょっと前向き過ぎるわ。",
            "zh": "燕……你真是\n有点太积极了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "200/TALK",
            "narrator": "つばめ",
            "text": "そ、そうですか？",
            "zh": "是、是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "201/TALK",
            "narrator": "アーヤ",
            "text": "ええ…どうにもならない\nことだってある、って\nいうことも――",
            "zh": "嗯……确实也有\n毫无办法的事，\n这一点——",
            "narrator_zh": "绫水"
        },
        {
            "location": "202/TALK",
            "narrator": "アーヤ",
            "text": "知っておいた方がいいわ。\nあなたのためにもね。",
            "zh": "你还是心里有数比较好。\n也是为了你好哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "206/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "208/TALK",
            "narrator": "つばめ",
            "text": "…前向きなのって、\nいけないことなのかな？",
            "zh": "……积极向上，\n难道是件不好的事吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "17/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月某日　 9:12 PM</color>\n合宿中、みやびの実家でのこと",
            "zh": "<color=green>8月某日　 9:12 PM</color>\n合宿期间，在雅的老家",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
