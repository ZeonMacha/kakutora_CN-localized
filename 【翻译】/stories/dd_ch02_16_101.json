{
    "dir": "chap16/daydra/dd_ch02_16_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "16202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "誰でもない父だから＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "正因是旁人之父＜前篇＞"
    },
    "entry": [
        {
            "location": "33/TALK",
            "narrator": "神楽",
            "text": "つばめさん。\nこの新刊なんか\nよさそうですよ。",
            "zh": "燕。\n这本新刊似乎\n挺不错的哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "ちょ！？　卯月さん！\nこんなの\n読んでるの？",
            "zh": "等！？　卯月！\n你平时都在看\n这种书吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "神楽",
            "text": "んー……。\nこれはまだ全年齢向け\nみたいですから。",
            "zh": "嗯——……。\n这本好像还是\n全年龄向的呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "38/TALK",
            "narrator": "神楽",
            "text": "私たちが読んでも\nたぶん問題は\nありませんよ。",
            "zh": "就算我们来看\n大概也\n没问题的哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "そ、そうなのかなぁ？",
            "zh": "是、是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "神楽",
            "text": "ほら、つばめさん。\n次は向こうの棚を\n見に行きましょう。",
            "zh": "来吧，燕。\n接下来去看看\n那边的书架吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "せっかくのお休み\nだったのに…。",
            "zh": "明明是难得的\n休息日……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "65/TALK",
            "narrator": "啓介",
            "text": "くっ、なんと狭くて\n歩きにくい本屋だ。",
            "zh": "唔，真是家又窄\n又难走动的书店。",
            "narrator_zh": "启介"
        },
        {
            "location": "67/TALK",
            "narrator": "啓介",
            "text": "しかも、どれもこれも\n薄い割に恐ろしく高い\n本ばかりだ。",
            "zh": "而且，每本都\n那么薄，价格却\n高得吓人。",
            "narrator_zh": "启介"
        },
        {
            "location": "70/TALK",
            "narrator": "啓介",
            "text": "こんな店に、\nつばめは何をしに\n来ているんだ？",
            "zh": "这种店，\n燕到底是来\n干什么的？",
            "narrator_zh": "启介"
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/SEL",
            "narrator": "",
            "text": "どういう状況？",
            "zh": "这是什么情况？",
            "narrator_zh": ""
        },
        {
            "location": "73/SEL",
            "narrator": "",
            "text": "不倫はダメだ！",
            "zh": "不伦可不行啊！",
            "narrator_zh": ""
        },
        {
            "location": "74/ACT",
            "narrator": "",
            "text": "どういう状況？",
            "zh": "这是什么情况？",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "アーヤ",
            "text": "タスケテー(T_T)",
            "zh": "救命啊(T_T)",
            "narrator_zh": "绫水"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "まさか",
            "zh": "真没想到",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "こんなことになるとは思わなくて",
            "zh": "事情会变成这样",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "アーヤ",
            "text": "実は…",
            "zh": "其实……",
            "narrator_zh": "绫水"
        },
        {
            "location": "105/ACT",
            "narrator": "",
            "text": "不倫はダメだ！",
            "zh": "不伦可不行啊！",
            "narrator_zh": ""
        },
        {
            "location": "121/TALK",
            "narrator": "アーヤ",
            "text": "不倫なわけないでしょ(--#)",
            "zh": "怎么可能是不伦啊(--#)",
            "narrator_zh": "绫水"
        },
        {
            "location": "122/TALK",
            "narrator": "アーヤ",
            "text": "そうじゃなくて",
            "zh": "才不是那样",
            "narrator_zh": "绫水"
        },
        {
            "location": "123/TALK",
            "narrator": "アーヤ",
            "text": "実は…",
            "zh": "其实……",
            "narrator_zh": "绫水"
        },
        {
            "location": "165/TALK",
            "narrator": "つばめ",
            "text": "お待たせー。\n今日はよろしくね。",
            "zh": "久等啦——。\n今天请多关照哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "167/TALK",
            "narrator": "神楽",
            "text": "任せてください。\n面白いお店を\n色々紹介しますね！",
            "zh": "包在我身上吧。\n我会带你逛很多\n有趣的店哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "170/TALK",
            "narrator": "アーヤ",
            "text": "あら？　二人とも\n出かけるの？",
            "zh": "哎呀？　你们两个\n要出门吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "172/TALK",
            "narrator": "つばめ",
            "text": "はい。卯月さんに、\n秋葉原を案内して\nもらうんです。",
            "zh": "是的。我让卯月\n带我去逛逛\n秋叶原。",
            "narrator_zh": "燕"
        },
        {
            "location": "173/TALK",
            "narrator": "アーヤ",
            "text": "そう…、\n楽しんできてね。",
            "zh": "这样……，\n玩得开心哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "174/TALK",
            "narrator": "つばめ",
            "text": "はい！\n卯月さん、行こ。",
            "zh": "好！\n卯月，走吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "181/TALK",
            "narrator": "アーヤ",
            "text": "…さてと、私もバイク\n持ってこなきゃ。",
            "zh": "……好了，我也得\n把摩托车骑出来才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "185/TALK",
            "narrator": "アーヤ",
            "text": "視線…後ろから！？",
            "zh": "视线……从后面！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "188/TALK",
            "narrator": "アーヤ",
            "text": "そこ！　路地裏に\n隠れてる不審者、\n出てきなさい！",
            "zh": "那边的！　躲在\n小巷里的可疑分子，\n给我出来！",
            "narrator_zh": "绫水"
        },
        {
            "location": "189/TALK",
            "narrator": "アーヤ",
            "text": "言うとおりにしないと\n通報するわよ！",
            "zh": "不照做的话\n我可要报警了哦！",
            "narrator_zh": "绫水"
        },
        {
            "location": "193/TALK",
            "narrator": "啓介",
            "text": "いや、待ってくれ。",
            "zh": "不，等一下。",
            "narrator_zh": "启介"
        },
        {
            "location": "195/TALK",
            "narrator": "啓介",
            "text": "…疑わしいことを\nしたのは謝るが、\n不審者ではない。",
            "zh": "……做出令人怀疑的\n举动是我不对，\n但我不是可疑分子。",
            "narrator_zh": "启介"
        },
        {
            "location": "197/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？\nつばめのお父さんじゃ\nないですか！",
            "zh": "咦！？\n这不是燕的爸爸\n吗！",
            "narrator_zh": "绫水"
        },
        {
            "location": "198/TALK",
            "narrator": "アーヤ",
            "text": "こんなところで\n何をしてるんですか？",
            "zh": "您在这种地方\n做什么呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "199/TALK",
            "narrator": "アーヤ",
            "text": "っていうか、\nいつこちらへ？",
            "zh": "话说回来，\n您什么时候来这边的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "201/TALK",
            "narrator": "啓介",
            "text": "順番に説明するが、\n今日の始発の新幹線で\n東京へ来たんだ。",
            "zh": "我按顺序说明吧，\n我是坐今天头班\n新干线来东京的。",
            "narrator_zh": "启介"
        },
        {
            "location": "202/TALK",
            "narrator": "啓介",
            "text": "私の娘が、東京で\nどんな暮らしを\nしているのか。",
            "zh": "我女儿在东京\n过着怎样的\n生活，",
            "narrator_zh": "启介"
        },
        {
            "location": "203/TALK",
            "narrator": "啓介",
            "text": "気にならない親が\nいるわけない。",
            "zh": "哪有不操心的\n父母。",
            "narrator_zh": "启介"
        },
        {
            "location": "205/TALK",
            "narrator": "アーヤ",
            "text": "…あ、あの、\nまさかとは\n思いますが…。",
            "zh": "……那、那个，\n该不会是我想的\n那样吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "206/TALK",
            "narrator": "アーヤ",
            "text": "朝からずっと\nこの場所で張り込み\nしてたんですか？",
            "zh": "您从早上开始就一直\n在这个地方\n蹲守吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/TALK",
            "narrator": "啓介",
            "text": "もちろんだ。\nバレては元も子も\nないからな。",
            "zh": "那是当然。\n被发现的话可就\n前功尽弃了。",
            "narrator_zh": "启介"
        },
        {
            "location": "211/TALK",
            "narrator": "アーヤ",
            "text": "…本当、\n過保護な人なのね。",
            "zh": "……真是的，\n过度保护的人呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "でも、つばめさんなら\nたった今、外出して\nしまいましたよ？",
            "zh": "不过，燕的话\n刚才已经\n出门了哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "214/TALK",
            "narrator": "啓介",
            "text": "むっ、そうだった。\nすぐに追わねば。",
            "zh": "唔，说得也是。\n得赶紧追上去。",
            "narrator_zh": "启介"
        },
        {
            "location": "216/TALK",
            "narrator": "啓介",
            "text": "君は確か…綾水さん\nだったかな？",
            "zh": "你记得是……\n绫水吧？",
            "narrator_zh": "启介"
        },
        {
            "location": "217/TALK",
            "narrator": "啓介",
            "text": "私のことは、娘には\n内緒で頼むよ。",
            "zh": "我来的事，\n还请你对女儿保密。",
            "narrator_zh": "启介"
        },
        {
            "location": "222/TALK",
            "narrator": "アーヤ",
            "text": "ふぅ…、\nビックリした。",
            "zh": "呼……，\n吓了一跳。",
            "narrator_zh": "绫水"
        },
        {
            "location": "223/TALK",
            "narrator": "アーヤ",
            "text": "悪い人ではないと\n思うけど、ね。",
            "zh": "虽然觉得他不是\n坏人，不过啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "224/TALK",
            "narrator": "アーヤ",
            "text": "過保護が過ぎて、\nつばめがちょっと\nかわいそうかも…。",
            "zh": "过度保护过头了，\n燕倒有点\n可怜呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "225/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/TALK",
            "narrator": "アーヤ",
            "text": "あのお父さん、\nまさか秋葉原まで\n追うつもりかしら？",
            "zh": "那位爸爸，\n该不会打算一直\n追到秋叶原吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "227/TALK",
            "narrator": "アーヤ",
            "text": "だとしたら…、\n大変なことに\nなるかも。",
            "zh": "如果真是那样……，\n说不定会闹出\n大事来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "アーヤ",
            "text": "あのお父さんの\nことだもの。",
            "zh": "毕竟是那位爸爸\n嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "229/TALK",
            "narrator": "アーヤ",
            "text": "何かのタイミングで\n飛び出していったり\nしそうだし。",
            "zh": "说不定会在某个\n时机突然\n冲出去呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "でもそうなったら、\n多分つばめも黙っては\nいないと思うし。",
            "zh": "可要是变成那样，\n大概燕也不会\n一声不吭的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "231/TALK",
            "narrator": "アーヤ",
            "text": "…まさか、秋葉原の\nど真ん中で大喧嘩？",
            "zh": "……难道说，要在\n秋叶原正中央大吵一架？",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "233/TALK",
            "narrator": "アーヤ",
            "text": "か、関わらない方が\nよさそうね。",
            "zh": "还、还是不要牵扯\n进去比较好呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "234/TALK",
            "narrator": "アーヤ",
            "text": "そんなことしたら、\n絶対面倒なことに\nなるんだから。",
            "zh": "要是插手了，\n绝对会惹上\n麻烦事的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "235/TALK",
            "narrator": "アーヤ",
            "text": "隊員の家族のことに\nまで、私が関わること\nないのよね。",
            "zh": "连队员家里的事\n我都没必要\n去管吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "236/TALK",
            "narrator": "アーヤ",
            "text": "うん、関係ないわ。\n私も買い物に\n行かないと…。",
            "zh": "嗯，跟我没关系。\n我也得去买东西\n了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "284/TALK",
            "narrator": "アーヤ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "绫水"
        },
        {
            "location": "300/TALK",
            "narrator": "アーヤ",
            "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。",
            "zh": "欢迎来到\n[心之扉]，\n$handle$。",
            "narrator_zh": "绫水"
        },
        {
            "location": "301/SEL",
            "narrator": "",
            "text": "どうしたの？怖い顔して",
            "zh": "怎么了？板着张可怕的脸",
            "narrator_zh": ""
        },
        {
            "location": "302/ACT",
            "narrator": "",
            "text": "どうしたの？怖い顔して",
            "zh": "怎么了？板着张可怕的脸",
            "narrator_zh": ""
        },
        {
            "location": "304/TALK",
            "narrator": "アーヤ",
            "text": "えっと。\nそれは……",
            "zh": "那个。\n这个嘛……",
            "narrator_zh": "绫水"
        },
        {
            "location": "305/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんに\n言わなければならない\nことがあります。",
            "zh": "我有件事\n必须对$handle$\n说才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "306/SEL",
            "narrator": "",
            "text": "告白！？",
            "zh": "告白！？",
            "narrator_zh": ""
        },
        {
            "location": "307/SEL",
            "narrator": "",
            "text": "なに？",
            "zh": "什么事？",
            "narrator_zh": ""
        },
        {
            "location": "308/ACT",
            "narrator": "",
            "text": "告白！？",
            "zh": "告白！？",
            "narrator_zh": ""
        },
        {
            "location": "309/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "310/TALK",
            "narrator": "アーヤ",
            "text": "やっぱりいいわ。",
            "zh": "算了，还是不说了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "311/SEL",
            "narrator": "",
            "text": "ならばよし",
            "zh": "那就好",
            "narrator_zh": ""
        },
        {
            "location": "312/SEL",
            "narrator": "",
            "text": "えー、冗談です！",
            "zh": "哎——，开玩笑的啦！",
            "narrator_zh": ""
        },
        {
            "location": "313/ACT",
            "narrator": "",
            "text": "ならばよし",
            "zh": "那就好",
            "narrator_zh": ""
        },
        {
            "location": "314/TALK",
            "narrator": "アーヤ",
            "text": "そう。",
            "zh": "这样啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "316/ACT",
            "narrator": "",
            "text": "えー、冗談です！",
            "zh": "哎——，开玩笑的啦！",
            "narrator_zh": ""
        },
        {
            "location": "317/TALK",
            "narrator": "アーヤ",
            "text": "もう…。\n冗談も\n時と場所をを選んでね。",
            "zh": "真是的……。\n开玩笑也得\n分清时间和场合哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "320/ACT",
            "narrator": "",
            "text": "なに？",
            "zh": "什么事？",
            "narrator_zh": ""
        },
        {
            "location": "322/TALK",
            "narrator": "アーヤ",
            "text": "えと……ね。",
            "zh": "那个……呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "323/TALK",
            "narrator": "アーヤ",
            "text": "実は…",
            "zh": "其实……",
            "narrator_zh": "绫水"
        },
        {
            "location": "324/TALK",
            "narrator": "アーヤ",
            "text": "言っておきたいことが\nあるんだけど……",
            "zh": "我有件事想先\n跟你说清楚……",
            "narrator_zh": "绫水"
        },
        {
            "location": "325/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "326/TALK",
            "narrator": "アーヤ",
            "text": "うーん……",
            "zh": "唔——……",
            "narrator_zh": "绫水"
        },
        {
            "location": "327/SEL",
            "narrator": "",
            "text": "……？",
            "zh": "……？",
            "narrator_zh": ""
        },
        {
            "location": "328/ACT",
            "narrator": "",
            "text": "……？",
            "zh": "……？",
            "narrator_zh": ""
        },
        {
            "location": "330/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "331/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさい！\nやっぱり今回はナシ！",
            "zh": "对不起！\n这次还是算了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "332/SEL",
            "narrator": "",
            "text": "えー！？",
            "zh": "哎——！？",
            "narrator_zh": ""
        },
        {
            "location": "333/SEL",
            "narrator": "",
            "text": "言いたくなったらいつでも言ってね",
            "zh": "想说的时候随时告诉我哦",
            "narrator_zh": ""
        },
        {
            "location": "334/ACT",
            "narrator": "",
            "text": "えー！？",
            "zh": "哎——！？",
            "narrator_zh": ""
        },
        {
            "location": "335/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさい。\nホントにごめんね。",
            "zh": "对不起。\n真的很抱歉。",
            "narrator_zh": "绫水"
        },
        {
            "location": "336/ACT",
            "narrator": "",
            "text": "言いたくなったらいつでも言ってね",
            "zh": "想说的时候随时告诉我哦",
            "narrator_zh": ""
        },
        {
            "location": "337/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう…。\n$handle$さんは\n優しいのね。",
            "zh": "谢谢……。\n$handle$\n真是温柔呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "338/TALK",
            "narrator": "アーヤ",
            "text": "その優しさに応える\nためにも、早く心を\n決めなくちゃね……。",
            "zh": "为了回应这份温柔，\n我也得早点下定\n决心才行呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "340/TALK",
            "narrator": "アーヤ",
            "text": "でも、次回は言う。\n絶対……言うから。",
            "zh": "不过，下次我会说的。\n绝对……会说出来的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "341/SEL",
            "narrator": "",
            "text": "待ってます",
            "zh": "我等着你",
            "narrator_zh": ""
        },
        {
            "location": "342/ACT",
            "narrator": "",
            "text": "待ってます",
            "zh": "我等着你",
            "narrator_zh": ""
        },
        {
            "location": "344/TALK",
            "narrator": "アーヤ",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "绫水"
        },
        {
            "location": "348/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ今日も早速、\n何を悩んでるのか\n検索するわね。",
            "zh": "那么今天也事不宜迟，\n来搜索一下她在\n烦恼什么吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "353/TALK",
            "narrator": "アーヤ",
            "text": "オープンプロセス、\n0x853番地から\n0x773番地へ。",
            "zh": "开放进程，\n从0x853号地址\n前往0x773号地址。",
            "narrator_zh": "绫水"
        },
        {
            "location": "375/TALK",
            "narrator": "アーヤ",
            "text": "シーク完了。",
            "zh": "搜索完成。",
            "narrator_zh": "绫水"
        },
        {
            "location": "378/TALK",
            "narrator": "アーヤ",
            "text": "さて、と。\n今回は……",
            "zh": "好了，那么。\n这次是……",
            "narrator_zh": "绫水"
        },
        {
            "location": "380/TALK",
            "narrator": "アーヤ",
            "text": "あー……。",
            "zh": "啊——……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "381/TALK",
            "narrator": "アーヤ",
            "text": "今回はすごいことに\nなってるわね。",
            "zh": "这次的状况\n可不得了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "382/SEL",
            "narrator": "",
            "text": "つばめのお父さんすごいよね",
            "zh": "燕的爸爸真厉害啊",
            "narrator_zh": ""
        },
        {
            "location": "383/SEL",
            "narrator": "",
            "text": "アーヤのお父さんって確か…",
            "zh": "绫水的爸爸记得是……",
            "narrator_zh": ""
        },
        {
            "location": "384/ACT",
            "narrator": "",
            "text": "つばめのお父さんすごいよね",
            "zh": "燕的爸爸真厉害啊",
            "narrator_zh": ""
        },
        {
            "location": "385/TALK",
            "narrator": "アーヤ",
            "text": "ホントにね。\nまるでうちの父を\n見てるみたい。",
            "zh": "真的呢。\n简直像在看\n我家的父亲一样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "386/ACT",
            "narrator": "",
            "text": "アーヤのお父さんって確か…",
            "zh": "绫水的爸爸记得是……",
            "narrator_zh": ""
        },
        {
            "location": "387/TALK",
            "narrator": "アーヤ",
            "text": "あら？\nどこかで父の話を\nしたことあったっけ？",
            "zh": "哎呀？\n我在哪里提起过\n父亲的事吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "388/TALK",
            "narrator": "アーヤ",
            "text": "まあ確かに、つばめの\nお父さんを見てると\nちょっと被るわね。",
            "zh": "不过确实，看着\n燕的爸爸，总觉得\n有点重叠呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "390/TALK",
            "narrator": "アーヤ",
            "text": "だからこそ、\n放っておけないんだけど。",
            "zh": "正因如此，\n才没法放着不管呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "391/SEL",
            "narrator": "",
            "text": "それじゃやっぱり、本心では一緒にいてあげたいんだね",
            "zh": "那果然，你打心底里还是想陪着他呢",
            "narrator_zh": ""
        },
        {
            "location": "392/ACT",
            "narrator": "",
            "text": "それじゃやっぱり、本心では一緒にいてあげたいんだね",
            "zh": "那果然，你打心底里还是想陪着他呢",
            "narrator_zh": ""
        },
        {
            "location": "394/TALK",
            "narrator": "アーヤ",
            "text": "あ、そうそう。\nごめんなさい。",
            "zh": "啊，对对。\n不好意思。",
            "narrator_zh": "绫水"
        },
        {
            "location": "395/TALK",
            "narrator": "アーヤ",
            "text": "今回はやっぱり、\n一緒にいた方がいいだろう\nって思ってるのよね。",
            "zh": "这次她果然还是\n觉得，陪在旁边\n会比较好吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "396/TALK",
            "narrator": "アーヤ",
            "text": "うちの父と同じなら――",
            "zh": "要是和我们家父亲一样――",
            "narrator_zh": "绫水"
        },
        {
            "location": "397/TALK",
            "narrator": "アーヤ",
            "text": "悪い人じゃないのは\nわかるけど、ちょっと\n危なっかしいっていうか。",
            "zh": "虽然知道不是坏人，\n但总觉得有点\n让人捏把汗呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "398/TALK",
            "narrator": "アーヤ",
            "text": "多分、つばめの事になると\n暴走しちゃうような\nタイプだと思うし。",
            "zh": "大概只要一涉及燕的事\n就会失控暴走\n的那种类型吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "399/SEL",
            "narrator": "",
            "text": "アーヤのお父さんもそうなの？",
            "zh": "绫水的爸爸也是那样吗？",
            "narrator_zh": ""
        },
        {
            "location": "400/ACT",
            "narrator": "",
            "text": "アーヤのお父さんもそうなの？",
            "zh": "绫水的爸爸也是那样吗？",
            "narrator_zh": ""
        },
        {
            "location": "402/TALK",
            "narrator": "アーヤ",
            "text": "うちはちょっとだけ\n違うかな。",
            "zh": "我们家稍微有\n点不一样吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "403/TALK",
            "narrator": "アーヤ",
            "text": "なんていうか、\n厳しさの方向が。",
            "zh": "该怎么说呢，\n严格的方向不太一样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "404/TALK",
            "narrator": "アーヤ",
            "text": "つばめのお父さんは、\nつばめを愛するあまり、\nつばめを制限してる感じ？",
            "zh": "燕的爸爸是因为\n太爱燕了，所以\n才去限制她的感觉？",
            "narrator_zh": "绫水"
        },
        {
            "location": "405/TALK",
            "narrator": "アーヤ",
            "text": "うちの場合はもっと、\nなんていうか――",
            "zh": "我们家的话更像是，\n该怎么说呢――",
            "narrator_zh": "绫水"
        },
        {
            "location": "406/TALK",
            "narrator": "アーヤ",
            "text": "人様に迷惑かけないよう\n厳しく言われ続けたって\n感じかしらね。",
            "zh": "一直被严厉叮嘱\n不要给别人添麻烦\n的那种感觉吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "407/SEL",
            "narrator": "",
            "text": "だからそんなに凛とした立派な人になったんだね",
            "zh": "所以才成长为这么凛然出色的女孩子呢",
            "narrator_zh": ""
        },
        {
            "location": "408/SEL",
            "narrator": "",
            "text": "だからそんなにカタブツになっちゃったんだね",
            "zh": "所以才变得这么死板固执呢",
            "narrator_zh": ""
        },
        {
            "location": "409/ACT",
            "narrator": "",
            "text": "だからそんなに凛とした立派な人になったんだね",
            "zh": "所以才成长为这么凛然出色的女孩子呢",
            "narrator_zh": ""
        },
        {
            "location": "411/TALK",
            "narrator": "アーヤ",
            "text": "え……。",
            "zh": "咦……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "412/TALK",
            "narrator": "アーヤ",
            "text": "全然立派なんかじゃ\nないから。",
            "zh": "根本一点也\n谈不上出色。",
            "narrator_zh": "绫水"
        },
        {
            "location": "413/TALK",
            "narrator": "アーヤ",
            "text": "他人に迷惑かけないフリを\nしてるだけ。",
            "zh": "只是装出一副不给\n别人添麻烦的样子而已。",
            "narrator_zh": "绫水"
        },
        {
            "location": "414/TALK",
            "narrator": "アーヤ",
            "text": "実際は逆で、凄く迷惑\nかけてるって自覚してる。",
            "zh": "实际上恰恰相反，她自己\n也清楚给大家添了很大麻烦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "415/SEL",
            "narrator": "",
            "text": "そう思えるのって凄いと思うよ",
            "zh": "能这样自省已经很了不起了哦",
            "narrator_zh": ""
        },
        {
            "location": "416/SEL",
            "narrator": "",
            "text": "自分の方こそ、最近エッチなことばかり聞いて迷惑かけてごめんね",
            "zh": "我才该道歉呢，最近老是问你些色色的事给你添麻烦了",
            "narrator_zh": ""
        },
        {
            "location": "417/ACT",
            "narrator": "",
            "text": "そう思えるのって凄いと思うよ",
            "zh": "能这样自省已经很了不起了哦",
            "narrator_zh": ""
        },
        {
            "location": "418/TALK",
            "narrator": "アーヤ",
            "text": "…ありがと。\nいつも支えてくれて、\nホントに感謝してる。",
            "zh": "……谢谢。\n一直这么支持我，\n真的很感激。",
            "narrator_zh": "绫水"
        },
        {
            "location": "419/TALK",
            "narrator": "アーヤ",
            "text": "貴方にだけは\n絶対に迷惑を\nかけたくない。",
            "zh": "唯独对你，\n我绝对不想\n给你添麻烦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "420/TALK",
            "narrator": "アーヤ",
            "text": "けど…\nもう少しだけ\n時間をください。ね？",
            "zh": "不过……\n请再多给我\n一点时间。好吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "421/ACT",
            "narrator": "",
            "text": "自分の方こそ、最近エッチなことばかり聞いて迷惑かけてごめんね",
            "zh": "我才该道歉呢，最近老是问你些色色的事给你添麻烦了",
            "narrator_zh": ""
        },
        {
            "location": "423/TALK",
            "narrator": "アーヤ",
            "text": "ほんとよ！\nもう…。",
            "zh": "就是说啊！\n真是的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "424/TALK",
            "narrator": "アーヤ",
            "text": "まあでも、別に\n嫌っていうわけじゃ\nなかったけどね。",
            "zh": "嘛不过，倒也\n并不是讨厌\n就是了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "425/SEL",
            "narrator": "",
            "text": "それじゃこれからもエッチなこと聞きます！",
            "zh": "那今后我也要继续问色色的事！",
            "narrator_zh": ""
        },
        {
            "location": "426/ACT",
            "narrator": "",
            "text": "それじゃこれからもエッチなこと聞きます！",
            "zh": "那今后我也要继续问色色的事！",
            "narrator_zh": ""
        },
        {
            "location": "428/TALK",
            "narrator": "アーヤ",
            "text": "それはダメ！",
            "zh": "那可不行！",
            "narrator_zh": "绫水"
        },
        {
            "location": "429/SEL",
            "narrator": "",
            "text": "言ってることが矛盾してるよ",
            "zh": "你说话前后矛盾哦",
            "narrator_zh": ""
        },
        {
            "location": "430/ACT",
            "narrator": "",
            "text": "言ってることが矛盾してるよ",
            "zh": "你说话前后矛盾哦",
            "narrator_zh": ""
        },
        {
            "location": "432/TALK",
            "narrator": "アーヤ",
            "text": "もうっ！",
            "zh": "真是的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "433/TALK",
            "narrator": "アーヤ",
            "text": "ここではもっと\n大人の対応を\nして欲しいわね…。",
            "zh": "这种时候我倒希望\n你能拿出更成熟\n大人的应对呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "435/ACT",
            "narrator": "",
            "text": "だからそんなにカタブツになっちゃったんだね",
            "zh": "所以才变得这么死板固执呢",
            "narrator_zh": ""
        },
        {
            "location": "436/TALK",
            "narrator": "アーヤ",
            "text": "あはは……。\n確かにそれはあるかも。",
            "zh": "啊哈哈……。\n确实有这方面呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "437/TALK",
            "narrator": "アーヤ",
            "text": "やっぱりダメよね、\n融通利かない人に\nなっちゃって。",
            "zh": "果然不行呢，\n变成了一个不知\n变通的人。",
            "narrator_zh": "绫水"
        },
        {
            "location": "438/TALK",
            "narrator": "アーヤ",
            "text": "でも、親の躾って\n本当に効果絶大よね。",
            "zh": "不过，父母的管教\n效果真是大得惊人呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "439/TALK",
            "narrator": "アーヤ",
            "text": "いつだって人様の迷惑に\nなってないかばっかり\n考えて生活してるもの。",
            "zh": "每天都在想着\n有没有给别人添麻烦，\n简直成了习惯呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "440/TALK",
            "narrator": "アーヤ",
            "text": "だから、貴方にも\nあまり迷惑を掛けたく\nないんだけど……。",
            "zh": "所以，也不太想\n给你添太多\n麻烦就是了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "441/TALK",
            "narrator": "アーヤ",
            "text": "もうちょっとだけ\n待ってね。",
            "zh": "再稍微\n等我一下哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "443/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、そろそろ\nクランを倒しに\n行きましょうか？",
            "zh": "那么，差不多\n该去打倒\n库兰了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "444/TALK",
            "narrator": "アーヤ",
            "text": "つばめのお父さんを\n助けてあげたいしね。",
            "zh": "毕竟也想帮帮\n燕的爸爸呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "445/SEL",
            "narrator": "",
            "text": "オーケー",
            "zh": "OK",
            "narrator_zh": ""
        },
        {
            "location": "446/ACT",
            "narrator": "",
            "text": "オーケー",
            "zh": "OK",
            "narrator_zh": ""
        },
        {
            "location": "448/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！",
            "zh": "祝愿$handle$与\n国政绫水，\n拥有一段美妙的心灵之旅！",
            "narrator_zh": "绫水"
        },
        {
            "location": "460/TALK",
            "narrator": "アーヤ",
            "text": "はぁ……。\nほんと、ダメな私。",
            "zh": "哈啊……。\n真是个没用的我。",
            "narrator_zh": "绫水"
        },
        {
            "location": "461/TALK",
            "narrator": "アーヤ",
            "text": "でも、\n変わらなくちゃ…。",
            "zh": "不过，\n必须改变才行……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "462/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんの\n為にも――。",
            "zh": "为了$handle$\n也一样――。",
            "narrator_zh": "绫水"
        },
        {
