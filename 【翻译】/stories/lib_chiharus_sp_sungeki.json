    "entry": [
        {
            "location": "69/SCENARIO",
            "narrator": "",
            "text": "精神世界概念チュートリアル（寸劇）",
            "zh": "精神世界概念教学（短剧）",
            "narrator_zh": ""
        },
        {
            "location": "72/SEL",
            "narrator": "",
            "text": "これは一体…？",
            "zh": "这到底是什么…？",
            "narrator_zh": ""
        },
        {
            "location": "73/ACT",
            "narrator": "",
            "text": "これは一体…？",
            "zh": "这到底是什么…？",
            "narrator_zh": ""
        },
        {
            "location": "77/TALK",
            "narrator": "千羽鶴",
            "text": "夢の中の世界ね。",
            "zh": "是梦中的世界。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "78/TALK",
            "narrator": "千羽鶴",
            "text": "ココロスフィアでは\n希によくあるケース。",
            "zh": "在心灵领域中，\n属于稀有的常见情况。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "79/SEL",
            "narrator": "",
            "text": "日本語オカシイデス",
            "zh": "日语怪怪的说",
            "narrator_zh": ""
        },
        {
            "location": "80/ACT",
            "narrator": "",
            "text": "日本語オカシイデス",
            "zh": "日语怪怪的说",
            "narrator_zh": ""
        },
        {
            "location": "82/TALK",
            "narrator": "千羽鶴",
            "text": "……細かいことは\n気にしないように。",
            "zh": "……细枝末节的\n就别在意了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "83/TALK",
            "narrator": "千羽鶴",
            "text": "心の中では、直接\n貴方に悩みを訴えて\nくるケースと――",
            "zh": "在心中，有直接\n向你倾诉烦恼的\n情况——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "84/TALK",
            "narrator": "千羽鶴",
            "text": "今回のように、悩みが\n劇のような形で表現\nされるケースがある。",
            "zh": "也有像这次这样，\n烦恼以戏剧形式\n表现出来的情况。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "85/TALK",
            "narrator": "千羽鶴",
            "text": "まあ、心の中だから、\n夢を見ている状態だと\n思えば間違いない。",
            "zh": "嘛，因为是在心中，\n当成在做梦的状态\n来想准没错。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "86/TALK",
            "narrator": "千羽鶴",
            "text": "貴方はいつものように\n彼女達を注意深く\n見ていればいい。",
            "zh": "你只要像往常一样，\n仔细地观察\n她们就行。",
            "narrator_zh": "千羽鹤"
        }
    ]
}
