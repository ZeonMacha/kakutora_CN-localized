    "entry": [
        {
            "location": "156/SCENARIO",
            "narrator": "",
            "text": "TGSアーヤ",
            "zh": "TGS绫水",
            "narrator_zh": ""
        },
        {
            "location": "176/TALK",
            "narrator": "アーヤ",
            "text": "気持ちいいわ…。\n私ね、海風って好きなの。",
            "zh": "真舒服……\n我呀，很喜欢海风的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "177/TALK",
            "narrator": "アーヤ",
            "text": "ちょっとベタつくけど、\n普段の毎日とは違う、\n潮の香りがする風…。",
            "zh": "虽然有点黏糊糊，\n但和平常不同的、\n带着潮味的风……",
            "narrator_zh": "绫水"
        },
        {
            "location": "178/TALK",
            "narrator": "アーヤ",
            "text": "なんだか、\nわくわくした気持ちに\nなってこない？",
            "zh": "总觉得，\n心情是不是变得\n兴奋起来了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "179/SEL",
            "narrator": "",
            "text": "かわいい反応だね",
            "zh": "反应真可爱",
            "narrator_zh": ""
        },
        {
            "location": "180/SEL",
            "narrator": "",
            "text": "駆け出したくなるよね",
            "zh": "让人想跑起来呢",
            "narrator_zh": ""
        },
        {
            "location": "181/ACT",
            "narrator": "",
            "text": "かわいい反応だね",
            "zh": "反应真可爱",
            "narrator_zh": ""
        },
        {
            "location": "183/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？\nもしかして、ちょっと\n子供っぽかったかしら？",
            "zh": "诶！？\n难道说，刚才\n有点孩子气了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "184/SEL",
            "narrator": "",
            "text": "そんなアーヤが好きです",
            "zh": "就喜欢这样的绫水",
            "narrator_zh": ""
        },
        {
            "location": "185/SEL",
            "narrator": "",
            "text": "そんなことはないよ",
            "zh": "才没有那回事",
            "narrator_zh": ""
        },
        {
            "location": "186/ACT",
            "narrator": "",
            "text": "そんなアーヤが好きです",
            "zh": "就喜欢这样的绫水",
            "narrator_zh": ""
        },
        {
            "location": "187/TALK",
            "narrator": "アーヤ",
            "text": "…ありがとう。",
            "zh": "……谢谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "188/TALK",
            "narrator": "アーヤ",
            "text": "きっと、そんな風に\n言ってくれる人って、\nあなただけだと思う。",
            "zh": "会像这样对我说的人，\n我想大概\n只有你一个。",
            "narrator_zh": "绫水"
        },
        {
            "location": "189/TALK",
            "narrator": "アーヤ",
            "text": "…っていうより、\nあなた以外に言われても\n嬉しくない、かな…？",
            "zh": "……或者说，\n换成别人来说，\n我也不会高兴……吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "190/ACT",
            "narrator": "",
            "text": "そんなことはないよ",
            "zh": "才没有那回事",
            "narrator_zh": ""
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "よかった…。",
            "zh": "太好了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/TALK",
            "narrator": "アーヤ",
            "text": "子供っぽくて幻滅されたら\nイヤだもの…。",
            "zh": "要是因为孩子气\n被你幻灭，可就糟了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "194/ACT",
            "narrator": "",
            "text": "駆け出したくなるよね",
            "zh": "让人想跑起来呢",
            "narrator_zh": ""
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "さすが、わかってるわね。",
            "zh": "不愧是你，挺懂的嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "って、もちろん本当に\n駆け出したりとかは\nしないけど…。",
            "zh": "不过，当然不会\n真的撒腿\n跑起来就是……",
            "narrator_zh": "绫水"
        },
        {
            "location": "198/TALK",
            "narrator": "アーヤ",
            "text": "さすがに、ちょっと\n子供っぽいと\n思われちゃいそうだし。",
            "zh": "毕竟那样的话，\n会显得\n有点孩子气吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "200/TALK",
            "narrator": "アーヤ",
            "text": "…ところで、その…、\nどうかしら？",
            "zh": "……话说，那个……\n怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "201/TALK",
            "narrator": "アーヤ",
            "text": "実はね、今日のデートの\nために、水着を新調して\n見たんだけど…。",
            "zh": "其实呀，为了今天的\n约会，我新买了\n一件泳装……",
            "narrator_zh": "绫水"
        },
        {
            "location": "202/SEL",
            "narrator": "",
            "text": "スゴく素敵だ",
            "zh": "非常好看",
            "narrator_zh": ""
        },
        {
            "location": "203/SEL",
            "narrator": "",
            "text": "一言で言うなら、愛しい",
            "zh": "一句话来说，惹人怜爱",
            "narrator_zh": ""
        },
        {
            "location": "204/SEL",
            "narrator": "",
            "text": "ドキドキする",
            "zh": "心跳加速",
            "narrator_zh": ""
        },
        {
            "location": "205/ACT",
            "narrator": "",
            "text": "スゴく素敵だ",
            "zh": "非常好看",
            "narrator_zh": ""
        },
        {
            "location": "206/TALK",
            "narrator": "アーヤ",
            "text": "よかった…。",
            "zh": "太好了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "207/TALK",
            "narrator": "アーヤ",
            "text": "本当は、これ着るの\nちょっと照れくさかったん\nだけど…。",
            "zh": "其实穿这个，\n我原本还有点\n不好意思来着……",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/TALK",
            "narrator": "アーヤ",
            "text": "今の一言で、\n照れくさかった気持ち、\n消えちゃったわ。",
            "zh": "你刚才那句话，\n让我害羞的\n心情全消了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "209/ACT",
            "narrator": "",
            "text": "一言で言うなら、愛しい",
            "zh": "一句话来说，惹人怜爱",
            "narrator_zh": ""
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？　えっと…。",
            "zh": "诶！？　那个……",
            "narrator_zh": "绫水"
        },
        {
            "location": "211/TALK",
            "narrator": "アーヤ",
            "text": "…想像以上の答えで、\nビックリしたわ。",
            "zh": "……答案超乎想象，\n吓了我一跳。",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "でも、水着以外の時でも\nそう思ってもらえたら、\nもっと嬉しいけど。",
            "zh": "不过，要是平时\n也能这么想，\n我会更高兴的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "213/ACT",
            "narrator": "",
            "text": "ドキドキする",
            "zh": "心跳加速",
            "narrator_zh": ""
        },
        {
            "location": "214/TALK",
            "narrator": "アーヤ",
            "text": "もぅ…そんな風に\n言われたら…。",
            "zh": "真是的……\n被你这么一说……",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/TALK",
            "narrator": "アーヤ",
            "text": "私の方まで、なんだか\nドキドキしてきちゃう…。",
            "zh": "连我这边都好像\n开始心跳加速了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "217/SEL",
            "narrator": "",
            "text": "ちょっと、触っていい？",
            "zh": "可以碰一下吗？",
            "narrator_zh": ""
        },
        {
            "location": "218/ACT",
            "narrator": "",
            "text": "ちょっと、触っていい？",
            "zh": "可以碰一下吗？",
            "narrator_zh": ""
        },
        {
            "location": "221/TALK",
            "narrator": "アーヤ",
            "text": "こ、こんなところで…？",
            "zh": "这、这种地方……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "222/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、いいけど…、\nちょっとだけよ？",
            "zh": "……好吧，倒也行……\n只许碰一下哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "241/TALK",
            "narrator": "アーヤ",
            "text": "…あなたから見たら、\n私もまだまだ\n子供なのかしら？",
            "zh": "……在你眼里，\n我是不是也还是\n个孩子呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "244/TALK",
            "narrator": "アーヤ",
            "text": "…頭ポンポンされるの\n好きな人の気持ち、\nわかったかも。",
            "zh": "……喜欢被人\n摸头的人的心情，\n我好像懂了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "251/TALK",
            "narrator": "アーヤ",
            "text": "ちょっ！？\n誰も見てなくても、\nこれはダメよ！",
            "zh": "等下！？\n就算没人看着，\n这样也不行哦！",
            "narrator_zh": "绫水"
        },
        {
            "location": "252/TALK",
            "narrator": "アーヤ",
            "text": "あ…二人の時ならいいって\nわけじゃないけど…。",
            "zh": "啊……又不是说\n两个人的时候就可以……",
            "narrator_zh": "绫水"
        },
        {
            "location": "255/TALK",
            "narrator": "アーヤ",
            "text": "ちょ、ダメだったら。",
            "zh": "等、说不行就是不行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "256/TALK",
            "narrator": "アーヤ",
            "text": "いくらなんでも…、\nちょっと強引すぎ！",
            "zh": "再怎么说……\n这也太强硬了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "262/TALK",
            "narrator": "アーヤ",
            "text": "アンッ！？",
            "zh": "嗯！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "264/TALK",
            "narrator": "アーヤ",
            "text": "ば、バカ！\n変な声出ちゃった\nじゃない！！",
            "zh": "笨、笨蛋！\n不是让我发出\n怪声了嘛！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "266/TALK",
            "narrator": "アーヤ",
            "text": "な、なんでお腹なのに、\nこんなに恥ずかしいの\nかしら…。",
            "zh": "为、为什么只是肚子，\n却让人这么\n害羞……",
            "narrator_zh": "绫水"
        },
        {
            "location": "272/TALK",
            "narrator": "アーヤ",
            "text": "…あなたから見たら、\n私もまだまだ\n子供なのかしら？",
            "zh": "……在你眼里，\n我是不是也还是\n个孩子呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "275/TALK",
            "narrator": "アーヤ",
            "text": "…あなたの撫で方って、\nどうして\nこんなに優しいの？",
            "zh": "……你抚摸的手法，\n为什么\n这么温柔？",
            "narrator_zh": "绫水"
        },
        {
            "location": "282/TALK",
            "narrator": "アーヤ",
            "text": "ちょっ！？\n誰も見てなくても、\nこれはダメよ！",
            "zh": "等下！？\n就算没人看着，\n这样也不行哦！",
            "narrator_zh": "绫水"
        },
        {
            "location": "283/TALK",
            "narrator": "アーヤ",
            "text": "あ…二人の時ならいいって\nわけじゃないけど…。",
            "zh": "啊……又不是说\n两个人的时候就可以……",
            "narrator_zh": "绫水"
        },
        {
            "location": "286/TALK",
            "narrator": "アーヤ",
            "text": "ちょ、ダメだったら。",
            "zh": "等、说不行就是不行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "287/TALK",
            "narrator": "アーヤ",
            "text": "いくらなんでも…、\nちょっと強引すぎ！",
            "zh": "再怎么说……\n这也太强硬了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "293/TALK",
            "narrator": "アーヤ",
            "text": "アンッ！？",
            "zh": "嗯！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "295/TALK",
            "narrator": "アーヤ",
            "text": "ば、バカ！\n変な声出ちゃった\nじゃない！！",
            "zh": "笨、笨蛋！\n不是让我发出\n怪声了嘛！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "297/TALK",
            "narrator": "アーヤ",
            "text": "な、なんでお腹なのに、\nこんなに恥ずかしいの\nかしら…。",
            "zh": "为、为什么只是肚子，\n却让人这么\n害羞……",
            "narrator_zh": "绫水"
        },
