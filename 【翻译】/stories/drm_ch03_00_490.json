{
    "dir": "dramatics/daydra/drm_ch03_00_490.js",
    "type": "Episode",
    "info": {
        "story_id": "3049",
        "cid": "gabriella",
        "title": "らぶとーく  第50話",
        "sub_title": "たまたまなんだから",
        "title_zh": "恋爱漫谈 第50话",
        "sub_title_zh": "只是碰巧而已"
    },
    "entry": [
        {
            "location": "167/SCENARIO",
            "narrator": "",
            "text": "たまたまなんだから",
            "zh": "因为只是碰巧",
            "narrator_zh": ""
        },
        {
            "location": "180/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぅ…結構色んなお店\n周ったわね…。",
            "zh": "呼……逛了\n好多家店呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "182/TALK",
            "narrator": "つばめ",
            "text": "ちゃんと案内できてる\nかな？",
            "zh": "我有好好\n带路吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "183/TALK",
            "narrator": "ガブリエラ",
            "text": "上出来よ。\n欲しかったゲームや\nＤＶＤも結構買えたし。",
            "zh": "干得不错。\n想要的游戏和\nＤＶＤ也买到了不少。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、いつの間に\nそんなに秋葉原のこと\n詳しくなったのよ？",
            "zh": "话说，你什么时候\n对秋叶原这么\n了解了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "185/TALK",
            "narrator": "つばめ",
            "text": "時々、一人で遊びに\n来たりしてるからかな？",
            "zh": "大概是偶尔自己\n跑来玩的关系吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "186/TALK",
            "narrator": "ガブリエラ",
            "text": "うそっ！？\nつばめ、そんな頻繁に\n来てるわけ！？",
            "zh": "骗人的吧！？\n燕，你有那么\n频繁地来吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "188/TALK",
            "narrator": "つばめ",
            "text": "そ、そんな頻繁って\nわけじゃないよ。",
            "zh": "也、也没那么\n频繁啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "191/TALK",
            "narrator": "つばめ",
            "text": "ただ、欲しいラノベは\n秋葉原で買うように\nしてるから――",
            "zh": "只是，想要的轻小说\n我都是在秋叶原\n买的，所以——",
            "narrator_zh": "燕"
        },
        {
            "location": "192/TALK",
            "narrator": "つばめ",
            "text": "その時に色々探検して、\n面白いお店を見つける\nのが楽しみなんだ。",
            "zh": "那天四处探险，\n找到有趣的小店，\n是我最期待的。",
            "narrator_zh": "燕"
        },
        {
            "location": "193/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん…。",
            "zh": "哦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラ",
            "text": "結構気になるお店も\nあったから――",
            "zh": "因为也有几家\n挺在意的店——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしも一人で\n来てみようかしら？",
            "zh": "我是不是也\n自己来看看呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "つばめ",
            "text": "楽しいと思うよ。",
            "zh": "我觉得会很好玩哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "199/TALK",
            "narrator": "つばめ",
            "text": "あっ、そうだ！\n裏通りの方にも面白い\nお店があるの。",
            "zh": "啊，对了！\n后街那边也有\n有趣的店哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "201/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、ちょっと待って！\nあんたまだ周る気？",
            "zh": "等、等一下！\n你还打算绕圈子？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "202/TALK",
            "narrator": "つばめ",
            "text": "え？　だってまだ、\n予定の半分くらいしか\n周ってないよ？",
            "zh": "诶？　可是还没，\n计划里连一半\n都还没逛完哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "203/TALK",
            "narrator": "ガブリエラ",
            "text": "半分って…あんた、\nちょっと詳し過ぎ！",
            "zh": "一半什么的……你，\n未免也太熟了吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "つばめ",
            "text": "えへへ…\n実は、ガブちゃんと\n来るのが楽しみで――",
            "zh": "嘿嘿……\n其实我一直在期待\n跟加布一起来——",
            "narrator_zh": "燕"
        },
        {
            "location": "206/TALK",
            "narrator": "つばめ",
            "text": "ちょっと下見したり、\n調べたりしてたんだ。",
            "zh": "我去稍微看过场地，\n也查了一下。",
            "narrator_zh": "燕"
        },
        {
            "location": "208/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "210/TALK",
            "narrator": "つばめ",
            "text": "ね？　すぐそこだから\n行こう！",
            "zh": "呐？就在那边，\n去吧！",
            "narrator_zh": "燕"
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…楽しくなかったら\n承知しないわよ？",
            "zh": "唉……要是不好玩\n我可不答应哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "つばめ",
            "text": "うん！\nさ、行こう！",
            "zh": "嗯！\n来，走吧！",
            "narrator_zh": "燕"
        },
        {
            "location": "216/TALK",
            "narrator": "ガブリエラ",
            "text": "…まったく。",
            "zh": "……真是的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめと秋葉原に来てるんだけど",
            "zh": "我和燕来秋叶原了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめのテンションが高くて疲れるわ",
            "zh": "燕太有劲了，累人",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "231/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "232/TALK",
            "narrator": "ガブリエラ",
            "text": "案内頼んだのは私だから文句は言えないけど",
            "zh": "带路的人是我拜托的，所以也没资格抱怨就是了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "234/SEL",
            "narrator": "",
            "text": "なんでそんなところに？",
            "zh": "怎么会在那种地方？",
            "narrator_zh": ""
        },
        {
            "location": "235/SEL",
            "narrator": "",
            "text": "代わりに案内しようか？",
            "zh": "我陪你一起走？",
            "narrator_zh": ""
        },
        {
            "location": "236/SEL",
            "narrator": "",
            "text": "君には似合わない",
            "zh": "这不像你",
            "narrator_zh": ""
        },
        {
            "location": "237/ACT",
            "narrator": "",
            "text": "なんでそんなところに？",
            "zh": "怎么会在那种地方？",
            "narrator_zh": ""
        },
        {
            "location": "238/TALK",
            "narrator": "ガブリエラ",
            "text": "なんでって",
            "zh": "为什么嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "私の趣味は知ってるでしょ？",
            "zh": "我的爱好你是知道的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "ゲームとかアニメとか",
            "zh": "游戏啦动画啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "ここだと何でも手に入るわ！",
            "zh": "在这里什么都能买到哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/TALK",
            "narrator": "ガブリエラ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$もゲームが好きみたいだから",
            "zh": "既然$handle$好像也喜欢游戏",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか",
            "zh": "话说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "246/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$の好きなゲーム、教えなさいよ",
            "zh": "$handle$喜欢的游戏，说给我听听",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "248/SEL",
            "narrator": "",
            "text": "コンシューマ系かな？",
            "zh": "是主机游戏那种？",
            "narrator_zh": ""
        },
        {
            "location": "249/SEL",
            "narrator": "",
            "text": "洋ゲーかな？",
            "zh": "是欧美游戏吧？",
            "narrator_zh": ""
        },
        {
            "location": "250/SEL",
            "narrator": "",
            "text": "スマホゲーかな？",
            "zh": "是手游吗？",
            "narrator_zh": ""
        },
        {
            "location": "251/ACT",
            "narrator": "",
            "text": "コンシューマ系かな？",
            "zh": "是主机游戏那种？",
            "narrator_zh": ""
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん",
            "zh": "嗯——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "意外と普通なのね",
            "zh": "意外地挺普通呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/ACT",
            "narrator": "",
            "text": "洋ゲーかな？",
            "zh": "是欧美游戏吧？",
            "narrator_zh": ""
        },
        {
            "location": "255/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、意外かも",
            "zh": "哎呀，是挺意外",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなるとＰＣでやるようなのかしら？",
            "zh": "那样的话是要用电脑玩吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "257/TALK",
            "narrator": "ガブリエラ",
            "text": "もしかして",
            "zh": "难道",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "258/TALK",
            "narrator": "ガブリエラ",
            "text": "意外とゲーマー？",
            "zh": "意外地是个玩家？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "259/ACT",
            "narrator": "",
            "text": "スマホゲーかな？",
            "zh": "是手游吗？",
            "narrator_zh": ""
        },
        {
            "location": "260/TALK",
            "narrator": "ガブリエラ",
            "text": "手軽だし気持ちはわかるわ",
            "zh": "方便是方便，我懂这种心情",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "262/TALK",
            "narrator": "ガブリエラ",
            "text": "私もカプドラ好きだし",
            "zh": "我也挺喜欢卡普多拉的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "264/TALK",
            "narrator": "ガブリエラ",
            "text": "言っとくけど！",
            "zh": "我先说好！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたのこと知りたくて聞いたわけじゃないから",
            "zh": "才不是想了解你才问的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "ガブリエラ",
            "text": "勘違いしないでね！",
            "zh": "别会错意哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "267/TALK",
            "narrator": "ガブリエラ",
            "text": "でも参考になったわ",
            "zh": "不过很有参考价值",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "269/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと",
            "zh": "谢谢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "280/TALK",
            "narrator": "ガブリエラ",
            "text": "…あ、ありがとは、\n余計だったかしら",
            "zh": "……啊，那句谢谢，\n是不是多余了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "284/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん。\nどうかしたの？",
            "zh": "加布。\n怎么了？",
            "narrator_zh": "燕"
        },
        {
            "location": "286/TALK",
            "narrator": "ガブリエラ",
            "text": "な、何でもないわ。\nほら、早く行くわよ。",
            "zh": "没、没什么啦。\n快，赶紧走啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/TALK",
            "narrator": "つばめ",
            "text": "あ、待って！\nお店。そっちじゃ\nないよぉ！",
            "zh": "啊，等等！\n那家店，不是\n往那边啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "290/ACT",
            "narrator": "",
            "text": "代わりに案内しようか？",
            "zh": "我陪你一起走？",
            "narrator_zh": ""
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり詳しいの？",
            "zh": "你还真的很熟吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "292/TALK",
            "narrator": "ガブリエラ",
            "text": "私なんて来てみたは良いけど",
            "zh": "我倒是来了这里",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "293/TALK",
            "narrator": "ガブリエラ",
            "text": "この街はさっぱりよ",
            "zh": "这座城市完全不行呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "295/TALK",
            "narrator": "ガブリエラ",
            "text": "もしかして",
            "zh": "难道",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "296/TALK",
            "narrator": "ガブリエラ",
            "text": "よく来たりしてるのかしら？",
            "zh": "是不是常来呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "298/SEL",
            "narrator": "",
            "text": "結構頻繁に",
            "zh": "还挺频繁的",
            "narrator_zh": ""
        },
        {
            "location": "299/SEL",
            "narrator": "",
            "text": "まあね",
            "zh": "嘛",
            "narrator_zh": ""
        },
        {
            "location": "300/SEL",
            "narrator": "",
            "text": "ごめん、実は行ったことない",
            "zh": "抱歉，其实我没去过",
            "narrator_zh": ""
        },
        {
            "location": "301/ACT",
            "narrator": "",
            "text": "結構頻繁に",
            "zh": "还挺频繁的",
            "narrator_zh": ""
        },
        {
            "location": "302/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなの！？",
            "zh": "是这样吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "303/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃあ",
            "zh": "那就",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "304/TALK",
            "narrator": "ガブリエラ",
            "text": "私も頻繁に通うようにしようかしら？",
            "zh": "我是不是也该常来呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "305/ACT",
            "narrator": "",
            "text": "まあね",
            "zh": "嘛",
            "narrator_zh": ""
        },
        {
            "location": "306/TALK",
            "narrator": "ガブリエラ",
            "text": "そう",
            "zh": "对",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "307/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、今度私が一人で来た時は",
            "zh": "那，下次我一个人来的时候",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "308/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$に案内してもらおうかしら？",
            "zh": "要不要让$handle$带带你？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "309/ACT",
            "narrator": "",
            "text": "ごめん、実は行ったことない",
            "zh": "抱歉，其实我没去过",
            "narrator_zh": ""
        },
        {
            "location": "310/TALK",
            "narrator": "ガブリエラ",
            "text": "ウソつき",
            "zh": "骗子",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "311/TALK",
            "narrator": "ガブリエラ",
            "text": "別に見得張るようなことでもないでしょ？",
            "zh": "这又不是什么要撑面子的事吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "313/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "加布里埃拉"
