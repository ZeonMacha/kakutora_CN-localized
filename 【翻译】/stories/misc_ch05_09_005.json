            "narrator": "神楽",
            "text": "そうだから",
            "zh": "因为是这样",
            "narrator_zh": "神乐"
        },
        {
            "location": "2337/ACT",
            "narrator": "",
            "text": "神楽はそれができる子だよ",
            "zh": "神乐是能做到的孩子",
            "narrator_zh": ""
        },
        {
            "location": "2339/TALK",
            "narrator": "神楽",
            "text": "そりゃできなくはないけどー",
            "zh": "那倒也不是做不到——",
