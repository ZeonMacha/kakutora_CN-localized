{
    "dir": "chap18/daydra/dd_ch01_18_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "18102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "大事な友達だから＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "因为是重要的朋友＜前篇＞"
    },
    "entry": [
        {
            "location": "33/TALK",
            "narrator": "雛",
            "text": "神楽ちゃん、\n今日もお休みだね。",
            "zh": "神乐，\n今天也请假呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "34/TALK",
            "narrator": "キリト",
            "text": "そうだな…。\n逢瀬、卯月の様子は\nどうなんだ？",
            "zh": "是啊……。\n逢濑，卯月的情况\n怎么样？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "36/TALK",
            "narrator": "つばめ",
            "text": "それが、わたしにも\nわからないの。",
            "zh": "这个，我也不\n知道。",
            "narrator_zh": "燕"
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "ＷＡＶＥに何度も\nメッセージ送っては\nいるんだけど…。",
            "zh": "WAVE上发了\n好多次消息，\n可是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "既読が付くだけで、\n返事がなくて…。",
            "zh": "只有已读，\n没有回复……。",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "ヒカル",
            "text": "…やっぱり、\nこの前のフェノメノンの\nせいじゃないかな。",
            "zh": "……果然，\n是前阵子PhenoMENON\n的缘故吧。",
            "narrator_zh": "光"
        },
        {
            "location": "42/TALK",
            "narrator": "ヒカル",
            "text": "家が巻き込まれるって\n相当ショックだった\nだろうし…。",
            "zh": "家里被卷进去，\n打击应该\n很大……。",
            "narrator_zh": "光"
        },
        {
            "location": "44/TALK",
            "narrator": "つばめ",
            "text": "う、うん…。",
            "zh": "嗯、嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "…神楽ちゃん、自分が\nメノウちゃんだって\nずっと隠してた。",
            "zh": "……神乐，自己是\nMENOW这件事，\n一直瞒着。",
            "narrator_zh": "燕"
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "ばれちゃったから\n連絡してきて\nくれないのかも…。",
            "zh": "被发现了，\n所以也许\n不联系了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "でも、みんなには\n言えないし…。",
            "zh": "可是，又不能\n跟大家说……。",
            "narrator_zh": "燕"
        },
        {
            "location": "49/TALK",
            "narrator": "キリト",
            "text": "いや、でも家族は\n無事だったんだろ？",
            "zh": "不，可家人\n不是没事吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "51/TALK",
            "narrator": "キリト",
            "text": "なら、何日も学校\n休むほどじゃねぇと\n思うんだけどな…。",
            "zh": "那就不至于\n连着好几天\n不上学吧……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "53/TALK",
            "narrator": "雛",
            "text": "…そういうことじゃ\nないんだよ。",
            "zh": "……不是\n那种事呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "55/TALK",
            "narrator": "雛",
            "text": "無事だったとしても、\n巻き込まれた時の\n怖さは残るよ。",
            "zh": "就算没事，\n被卷进去时的\n害怕也会留下。",
            "narrator_zh": "雏"
        },
        {
            "location": "56/TALK",
            "narrator": "雛",
            "text": "落ち着くまでは\n家から離れられないん\nじゃないかな？",
            "zh": "在安定下来之前，\n也许离不开\n家吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "59/SEL",
            "narrator": "",
            "text": "つばめ、静かだね？",
            "zh": "燕，好安静呀？",
            "narrator_zh": ""
        },
        {
            "location": "60/ACT",
            "narrator": "",
            "text": "つばめ、静かだね？",
            "zh": "燕，好安静呀？",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "ごめんね(´・ω・｀)",
            "zh": "对不起呀(´・ω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "卯月さんのこと",
            "zh": "卯月的事",
            "narrator_zh": "燕"
        },
        {
            "location": "80/TALK",
            "narrator": "つばめ",
            "text": "色々考ぇてて(o´Д`)=з",
            "zh": "在想好多(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "82/SEL",
            "narrator": "",
            "text": "つばめもそっとしておきたい？",
            "zh": "燕也想静一静吗？",
            "narrator_zh": ""
        },
        {
            "location": "83/ACT",
            "narrator": "",
            "text": "つばめもそっとしておきたい？",
            "zh": "燕也想静一静吗？",
            "narrator_zh": ""
        },
        {
            "location": "85/TALK",
            "narrator": "つばめ",
            "text": "わからなぃ",
            "zh": "不知道呀",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "つばめ",
            "text": "このままはダメだけど",
            "zh": "这样下去不行",
            "narrator_zh": "燕"
        },
        {
            "location": "87/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "燕"
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "無理に会ぃに行っても",
            "zh": "硬去见的话",
            "narrator_zh": "燕"
        },
        {
            "location": "90/TALK",
            "narrator": "つばめ",
            "text": "困らせちゃぅし",
            "zh": "会让她为难",
            "narrator_zh": "燕"
        },
        {
            "location": "91/TALK",
            "narrator": "つばめ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "燕"
        },
        {
            "location": "94/TALK",
            "narrator": "つばめ",
            "text": "会ってくれなぃかも(´つω・｀)ｼｭﾝ",
            "zh": "也许不会见我(´つω・｀)ｼｭﾝ",
            "narrator_zh": "燕"
        },
        {
            "location": "95/TALK",
            "narrator": "つばめ",
            "text": "ＷＡＶＥにも",
            "zh": "WAVE上也",
            "narrator_zh": "燕"
        },
        {
            "location": "96/TALK",
            "narrator": "つばめ",
            "text": "返事くれなぃし(´･ω･｀) ",
            "zh": "不回我(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "97/TALK",
            "narrator": "つばめ",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "燕"
        },
        {
            "location": "100/TALK",
            "narrator": "つばめ",
            "text": "どうしたらぃぃんだろ？(o´Д`)=з",
            "zh": "怎么办才好呀？(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "112/TALK",
            "narrator": "つばめ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "雛",
            "text": "…心配だよね？\n神楽ちゃんのこと。",
            "zh": "……担心吧？\n神乐的事。",
            "narrator_zh": "雏"
        },
        {
            "location": "116/TALK",
            "narrator": "つばめ",
            "text": "うん…せめて、\n返信くらいして\nほしいんだけど…。",
            "zh": "嗯……至少，\n希望能回个\n消息……。",
            "narrator_zh": "燕"
        },
        {
            "location": "117/TALK",
            "narrator": "雛",
            "text": "つばめちゃんの\n連絡にも\n返さないんだよね。",
            "zh": "燕的联络\n也不\n回呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "118/TALK",
            "narrator": "雛",
            "text": "でも\nまだ方法が\nないわけじゃない。",
            "zh": "不过\n也不是\n没办法。",
            "narrator_zh": "雏"
        },
        {
            "location": "120/TALK",
            "narrator": "ヒカル",
            "text": "というと？",
            "zh": "你是说？",
            "narrator_zh": "光"
        },
        {
            "location": "121/TALK",
            "narrator": "雛",
            "text": "お見舞いだよ、\nお見舞い。",
            "zh": "是探病呀，\n探病。",
            "narrator_zh": "雏"
        },
        {
            "location": "122/TALK",
            "narrator": "雛",
            "text": "連絡ないなら、\nこっちから会いに\n行けばいいんだよ。",
            "zh": "不联系的话，\n我们去见她\n就好了。",
            "narrator_zh": "雏"
        },
        {
            "location": "124/TALK",
            "narrator": "つばめ",
            "text": "えっ…。",
            "zh": "诶……。",
            "narrator_zh": "燕"
        },
        {
            "location": "125/TALK",
            "narrator": "キリト",
            "text": "なるほど。\n家の場所も\nわかるんだしね。",
            "zh": "原来如此。\n家的位置\n也知道。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "126/TALK",
            "narrator": "キリト",
            "text": "こっちから行けば\nいいのか。",
            "zh": "我们过去\n就行了吗。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "127/TALK",
            "narrator": "雛",
            "text": "そういうことー。",
            "zh": "就是这样——。",
            "narrator_zh": "雏"
        },
        {
            "location": "128/TALK",
            "narrator": "ヒカル",
            "text": "でも、いきなり\n大勢で押しかけて\n平気かな？",
            "zh": "可是，突然\n一大群人过去\n不要紧吗？",
            "narrator_zh": "光"
        },
        {
            "location": "129/TALK",
            "narrator": "ヒカル",
            "text": "ショックを受けてる\n可能性があるん\nでしょう。",
            "zh": "她可能受着\n打击\n吧。",
            "narrator_zh": "光"
        },
        {
            "location": "130/TALK",
            "narrator": "ヒカル",
            "text": "あまり大勢で行くのは\n避けるべきでは？",
            "zh": "人太多的话，\n是不是该避开？",
            "narrator_zh": "光"
        },
        {
            "location": "131/TALK",
            "narrator": "キリト",
            "text": "…それもそうか。\n逆効果になっちゃ\n意味ねぇしな。",
            "zh": "……说得也是。\n要是起反效果\n就没意义了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "133/TALK",
            "narrator": "雛",
            "text": "…じゃあ、ここは\nつばめちゃんだけに\n行ってもらおうよ。",
            "zh": "……那就，这里\n只让燕\n一个人去吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "え、えぇっ！\nわたし！？",
            "zh": "诶、诶诶！\n我！？",
            "narrator_zh": "燕"
        },
        {
            "location": "137/TALK",
            "narrator": "雛",
            "text": "あたしたちの中で\n一番神楽ちゃんのこと\nわかってるのはさ。",
            "zh": "我们里面\n最了解神乐的\n是。",
            "narrator_zh": "雏"
        },
        {
            "location": "138/TALK",
            "narrator": "雛",
            "text": "多分つばめちゃんだと\n思うし。",
            "zh": "我觉得大概\n是燕。",
            "narrator_zh": "雏"
        },
        {
            "location": "140/TALK",
            "narrator": "つばめ",
            "text": "そ、それは、まあ…。",
            "zh": "那、那个，嘛……。",
            "narrator_zh": "燕"
        },
        {
            "location": "141/TALK",
            "narrator": "雛",
            "text": "それに。",
            "zh": "而且。",
            "narrator_zh": "雏"
        },
        {
            "location": "142/TALK",
            "narrator": "雛",
            "text": "神楽ちゃんと、\n何か話したいこと\nあるんじゃないのー？",
            "zh": "和神乐，\n有想说的话\n吧——？",
            "narrator_zh": "雏"
        },
        {
            "location": "144/TALK",
            "narrator": "つばめ",
            "text": "…うん………。",
            "zh": "……嗯………。",
            "narrator_zh": "燕"
        },
        {
            "location": "145/TALK",
            "narrator": "つばめ",
            "text": "話したいことも、\n言いたいことも\nあるけど…………。",
            "zh": "想说的，\n想讲的\n都有…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "146/TALK",
            "narrator": "つばめ",
            "text": "でも…。",
            "zh": "可是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "210/TALK",
            "narrator": "つばめ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "燕"
        },
        {
            "location": "218/TALK",
            "narrator": "つばめ",
            "text": "こんにちは、\n$handle$さん。",
            "zh": "你好，\n$handle$。",
            "narrator_zh": "燕"
        },
        {
            "location": "219/SEL",
            "narrator": "",
            "text": "いつも思ってるんだけど――",
            "zh": "我一直在想——",
            "narrator_zh": ""
        },
        {
            "location": "220/SEL",
            "narrator": "",
            "text": "さあ、仕事をしましょう",
            "zh": "来，工作吧",
            "narrator_zh": ""
        },
        {
            "location": "221/ACT",
            "narrator": "",
            "text": "いつも思ってるんだけど",
            "zh": "我一直在想",
            "narrator_zh": ""
        },
        {
            "location": "222/TALK",
            "narrator": "つばめ",
            "text": "…はい？\nなんでしょうか。",
            "zh": "……是？\n什么事。",
            "narrator_zh": "燕"
        },
        {
            "location": "223/SEL",
            "narrator": "",
            "text": "ホントにつばめの人格？",
            "zh": "真的是燕的人格？",
            "narrator_zh": ""
        },
        {
            "location": "224/SEL",
            "narrator": "",
            "text": "もしかして無理してキャラ作ってない？",
            "zh": "该不会在硬演人设吧？",
            "narrator_zh": ""
        },
        {
            "location": "225/SEL",
            "narrator": "",
            "text": "ホントは根はいい子だよね",
            "zh": "其实本性是好孩子吧",
            "narrator_zh": ""
        },
        {
            "location": "226/ACT",
            "narrator": "",
            "text": "ホントにつばめの人格？",
            "zh": "真的是燕的人格？",
            "narrator_zh": ""
        },
        {
            "location": "227/TALK",
            "narrator": "つばめ",
            "text": "疑り深い人ですね。",
            "zh": "你疑心真重。",
            "narrator_zh": "燕"
        },
        {
            "location": "228/TALK",
            "narrator": "つばめ",
            "text": "わたしは正真正銘、逢瀬\nつばめの人格でし…す。",
            "zh": "我是货真价实的逢濑\n燕的人格……是的。",
            "narrator_zh": "燕"
        },
        {
            "location": "229/ACT",
            "narrator": "",
            "text": "もしかして無理してキャラ作ってない？",
            "zh": "该不会在硬演人设吧？",
            "narrator_zh": ""
        },
        {
            "location": "230/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "231/TALK",
            "narrator": "つばめ",
            "text": "どうしてそんなこと\n聞くんですか？",
            "zh": "为什么问\n这种事？",
            "narrator_zh": "燕"
        },
        {
            "location": "232/TALK",
            "narrator": "つばめ",
            "text": "そんなにわたしのことが\n嫌いなんですか？",
            "zh": "就这么\n讨厌我吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "233/TALK",
            "narrator": "つばめ",
            "text": "同じつばめでも、わたしは\n愛せないんですか？",
            "zh": "就算同样是燕，我\n你就爱不了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "234/SEL",
            "narrator": "",
            "text": "そんなことないよ！",
            "zh": "才没有！",
            "narrator_zh": ""
        },
        {
            "location": "235/SEL",
            "narrator": "",
            "text": "正直ちょっと無理",
            "zh": "老实说有点吃不消",
            "narrator_zh": ""
        },
        {
            "location": "236/SEL",
            "narrator": "",
            "text": "そもそもつばめを愛することが無理",
            "zh": "爱燕这件事本身就不可能",
            "narrator_zh": ""
        },
        {
            "location": "237/ACT",
            "narrator": "",
            "text": "そんなことないよ！",
            "zh": "才没有！",
            "narrator_zh": ""
        },
        {
            "location": "238/TALK",
            "narrator": "つばめ",
            "text": "…よかっ――",
            "zh": "……太好——",
            "narrator_zh": "燕"
        },
        {
            "location": "240/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "242/TALK",
            "narrator": "つばめ",
            "text": "仕事をしましょう。",
            "zh": "来工作吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "243/ACT",
            "narrator": "",
            "text": "正直ちょっと無理",
            "zh": "老实说有点吃不消",
            "narrator_zh": ""
        },
        {
            "location": "244/TALK",
            "narrator": "つばめ",
            "text": "…そうですか。",
            "zh": "……是吗。",
            "narrator_zh": "燕"
        },
        {
            "location": "245/TALK",
            "narrator": "つばめ",
            "text": "まあいいです。\n私は事務的な女ですから。",
            "zh": "无所谓。\n我是办事的女人。",
            "narrator_zh": "燕"
        },
        {
            "location": "246/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんが\nわたしを好きでも\n嫌いでも関係ないです。",
            "zh": "$handle$\n喜不喜欢我\n都没关系。",
            "narrator_zh": "燕"
        },
        {
            "location": "247/ACT",
            "narrator": "",
            "text": "そもそもつばめを愛することが無理",
            "zh": "爱燕这件事本身就不可能",
            "narrator_zh": ""
        },
        {
            "location": "248/TALK",
            "narrator": "つばめ",
            "text": "じゃあここに\n入ってくんなよ\n■■野郎が！",
            "zh": "那就别\n进来啊，\n■■混蛋！",
            "narrator_zh": "燕"
        },
        {
            "location": "250/SEL",
            "narrator": "",
            "text": "冗談ですすみません",
            "zh": "开玩笑的，对不起",
            "narrator_zh": ""
        },
        {
            "location": "251/SEL",
            "narrator": "",
            "text": "嘘はつけない人間なので",
            "zh": "因为我是不会说谎的人",
            "narrator_zh": ""
        },
        {
            "location": "252/SEL",
            "narrator": "",
            "text": "そのワイルド怒リングなつばめが見たかった！",
            "zh": "就想看那个狂野怒环的燕！[?]",
            "narrator_zh": ""
        },
        {
            "location": "253/ACT",
            "narrator": "",
            "text": "冗談ですすみません",
            "zh": "开玩笑的，对不起",
            "narrator_zh": ""
        },
        {
            "location": "254/TALK",
            "narrator": "つばめ",
            "text": "なんだ。\nよかったです。",
            "zh": "什么啊。\n太好了。",
            "narrator_zh": "燕"
        },
        {
            "location": "255/ACT",
            "narrator": "",
            "text": "嘘はつけない人間なので",
            "zh": "因为我是不会说谎的人",
            "narrator_zh": ""
        },
        {
            "location": "256/TALK",
            "narrator": "つばめ",
            "text": "偽善者ですか？",
            "zh": "伪善者吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "257/TALK",
            "narrator": "つばめ",
            "text": "なんて。\nまあ、わかりますけど。",
            "zh": "开玩笑的。\n嘛，我明白。",
            "narrator_zh": "燕"
        },
        {
            "location": "258/TALK",
            "narrator": "つばめ",
            "text": "罪悪感があるんですよね。\n優しい人。",
            "zh": "有罪恶感吧。\n温柔的人。",
            "narrator_zh": "燕"
        },
        {
            "location": "259/ACT",
            "narrator": "",
            "text": "そのワイルド怒リングなつばめが見たかった！",
            "zh": "就想看那个狂野怒环的燕！[?]",
            "narrator_zh": ""
        },
        {
            "location": "261/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "266/ACT",
            "narrator": "",
            "text": "ホントは根はいい子だよね",
            "zh": "其实本性是好孩子吧",
            "narrator_zh": ""
        },
        {
            "location": "268/TALK",
            "narrator": "つばめ",
            "text": "ボロ泣き狙ってますか？",
            "zh": "想看我哭崩吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "269/TALK",
            "narrator": "つばめ",
            "text": "残念ながら、\nわたしは心の底から\nこういう子です。",
            "zh": "可惜，\n我从心底\n就是这种孩子。",
            "narrator_zh": "燕"
        },
        {
            "location": "270/TALK",
            "narrator": "つばめ",
            "text": "……と、ココロの中の\n一人格にも、心の底が\nあるのかという疑問が。",
            "zh": "……话说，心中的\n一个人格，是不是\n也有心底，这是个疑问。",
            "narrator_zh": "燕"
        },
        {
            "location": "271/TALK",
            "narrator": "つばめ",
            "text": "あるならマトリョーシカ\n状態ですね。",
            "zh": "要是有，就是套娃\n状态了。",
            "narrator_zh": "燕"
        },
        {
            "location": "272/TALK",
            "narrator": "つばめ",
            "text": "フラクタルとも言える\nかもしれません。",
            "zh": "也可以说是\n分形。",
            "narrator_zh": "燕"
        },
        {
            "location": "274/TALK",
            "narrator": "つばめ",
            "text": "……って、\nそんなことは\nどうでもいいんです！",
            "zh": "……这种事\n怎么样都\n无所谓！",
            "narrator_zh": "燕"
        },
        {
            "location": "276/ACT",
            "narrator": "",
            "text": "さあ、仕事をしましょう",
            "zh": "来，工作吧",
            "narrator_zh": ""
        },
        {
            "location": "277/TALK",
            "narrator": "つばめ",
            "text": "その通りです。\n最高効率でする仕事こそが\n唯一たる神状態です。",
            "zh": "说得对。\n最高效地干活，\n才是唯一的神状态。",
            "narrator_zh": "燕"
        },
        {
            "location": "279/TALK",
            "narrator": "つばめ",
            "text": "さあ、それじゃ\n早速仕事をしましょう。",
            "zh": "那么，\n马上开始工作吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "287/TALK",
            "narrator": "つばめ",
            "text": "オープンプロセス、\n0x8E4番地から\n0x22F番地へ。",
            "zh": "开放进程，\n从0x8E4地址\n到0x22F地址。",
            "narrator_zh": "燕"
        },
        {
            "location": "302/TALK",
            "narrator": "つばめ",
            "text": "シーク完了しました。",
            "zh": "搜索完成。",
            "narrator_zh": "燕"
        },
        {
            "location": "305/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "307/TALK",
            "narrator": "つばめ",
            "text": "……なるほど。",
            "zh": "……原来如此。",
            "narrator_zh": "燕"
        },
        {
            "location": "308/TALK",
            "narrator": "つばめ",
            "text": "まあ。",
            "zh": "嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "309/TALK",
            "narrator": "つばめ",
            "text": "話したいことがあるなら、\n絶対言った方がいいよね。",
            "zh": "有想说的话，\n绝对还是说出来比较好。",
            "narrator_zh": "燕"
        },
        {
            "location": "310/TALK",
            "narrator": "つばめ",
            "text": "と、わたしは思いますが、\n$handle$さんは？",
            "zh": "我是这么想的，\n$handle$怎么看？",
            "narrator_zh": "燕"
        },
        {
            "location": "311/SEL",
            "narrator": "",
            "text": "ほんとそれ",
            "zh": "就是这样",
            "narrator_zh": ""
        },
        {
            "location": "312/SEL",
            "narrator": "",
            "text": "あまり賛同できない",
            "zh": "不太能赞成",
            "narrator_zh": ""
        },
        {
            "location": "313/ACT",
            "narrator": "",
            "text": "ほんとそれ",
            "zh": "就是这样",
            "narrator_zh": ""
        },
        {
            "location": "314/TALK",
            "narrator": "つばめ",
            "text": "意見が合いましたね。",
            "zh": "意见一致了。",
            "narrator_zh": "燕"
        },
        {
            "location": "315/TALK",
            "narrator": "つばめ",
            "text": "正直な気持ちを\n相手に伝えるのは\n大事な事です！",
            "zh": "把老实的心情\n告诉对方，\n是很重要的事！",
            "narrator_zh": "燕"
        },
        {
            "location": "316/ACT",
            "narrator": "",
            "text": "あまり賛同できない",
            "zh": "不太能赞成",
            "narrator_zh": ""
        },
        {
            "location": "317/TALK",
            "narrator": "つばめ",
            "text": "そうですか。",
            "zh": "是吗。",
            "narrator_zh": "燕"
        },
        {
            "location": "318/TALK",
            "narrator": "つばめ",
            "text": "でも今回は、\n$handle$さんの\n好みにかかわらず。",
            "zh": "不过这次，\n不管$handle$\n喜不喜欢。",
            "narrator_zh": "燕"
        },
        {
            "location": "319/TALK",
            "narrator": "つばめ",
            "text": "キチキチと\n働いていただきます。",
            "zh": "给我密不透风地\n干活。",
            "narrator_zh": "燕"
        },
        {
            "location": "321/TALK",
            "narrator": "つばめ",
            "text": "それでは、\n準備はいいですか？",
            "zh": "那么，\n准备好了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "322/SEL",
            "narrator": "",
            "text": "オーケー",
            "zh": "OK",
            "narrator_zh": ""
        },
        {
            "location": "323/SEL",
            "narrator": "",
            "text": "いやです",
            "zh": "不要",
            "narrator_zh": ""
        },
        {
            "location": "324/ACT",
            "narrator": "",
            "text": "オーケー",
            "zh": "OK",
            "narrator_zh": ""
        },
        {
            "location": "325/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！",
            "zh": "献给$handle$和\n我的，\n美妙的心灵之旅！",
            "narrator_zh": "燕"
        },
        {
            "location": "326/ACT",
            "narrator": "",
            "text": "いやです",
            "zh": "不要",
            "narrator_zh": ""
        },
        {
            "location": "327/TALK",
            "narrator": "つばめ",
            "text": "はぁ…相変わらず\nあまのじゃくさんですね。",
            "zh": "哈啊……还是老样子，\n别扭鬼。",
            "narrator_zh": "燕"
        },
        {
            "location": "328/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんが\nクラン撃退を拒否すると\n世界は進歩できません。",
            "zh": "$handle$\n要是拒绝击退库兰，\n世界就无法进步。",
            "narrator_zh": "燕"
        },
        {
            "location": "329/TALK",
            "narrator": "つばめ",
            "text": "停滞こそが\n世界の敵だからです。",
            "zh": "停滞才是\n世界的敌人。",
            "narrator_zh": "燕"
        },
        {
            "location": "330/TALK",
            "narrator": "つばめ",
            "text": "そしてもはや、\n十分な時間は\n残されてはいません。",
            "zh": "而且现在，\n已经没有\n足够的时间了。",
            "narrator_zh": "燕"
        },
        {
            "location": "331/SEL",
            "narrator": "",
            "text": "十分な時間って！？",
            "zh": "足够的时间是什么！？",
            "narrator_zh": ""
        },
        {
            "location": "332/ACT",
            "narrator": "",
            "text": "十分な時間って！？",
            "zh": "足够的时间是什么！？",
            "narrator_zh": ""
        },
        {
            "location": "334/TALK",
            "narrator": "つばめ",
            "text": "というわけで、\n必殺――",
            "zh": "所以，\n必杀——",
            "narrator_zh": "燕"
        },
        {
            "location": "335/TALK",
            "narrator": "つばめ",
            "text": "無理矢理\n素敵なココロの旅へゴー。",
            "zh": "强制前往\n美妙的心灵之旅。出发。",
            "narrator_zh": "燕"
        },
        {
            "location": "348/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "349/TALK",
            "narrator": "つばめ",
            "text": "それにしても……\n事前に聞いては\nいましたけど――",
            "zh": "话说回来……\n虽然事先\n听说了——",
            "narrator_zh": "燕"
        },
        {
            "location": "350/TALK",
            "narrator": "つばめ",
            "text": "“0x”は\nヌルすぎですね…。",
            "zh": "“0x”\n也太null了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "18/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月28日　11:03 AM</color>\nとある夏休み直前の平日、つばめの教室にて。",
            "zh": "<color=green>7月28日　11:03 AM</color>\n某个暑假前的工作日，燕的教室。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "175/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch01",
            "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>逢濑燕的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解逢濑燕心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch01"
        },
        {
            "location": "177/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch02",
            "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>国政绫水的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解国政绫水心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch02"
        },
        {
            "location": "179/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch03",
            "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>加布里埃拉的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解加布里埃拉心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch03"
        },
        {
            "location": "181/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch04",
            "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>恋之崎雅的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解恋之崎雅心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch04"
        },
        {
            "location": "183/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch05",
            "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>卯月神乐的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解卯月神乐心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch05"
        }
    ]
