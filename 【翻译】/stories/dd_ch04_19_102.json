{
    "dir": "chap19/daydra/dd_ch04_19_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "19405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "気にしすぎのHACK＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "想太多的HACK＜后篇＞"
    },
    "entry": [
        {
            "location": "393/TALK",
            "narrator": "みやび",
            "text": "情けない",
            "zh": "真没出息",
            "narrator_zh": "雅"
        },
        {
            "location": "394/TALK",
            "narrator": "みやび",
            "text": "土壇場で怖気づくとは",
            "zh": "到了最后关头才怯场",
            "narrator_zh": "雅"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "まったく",
            "zh": "真是的",
            "narrator_zh": "雅"
        },
        {
            "location": "396/TALK",
            "narrator": "みやび",
            "text": "悩む必要などない",
            "zh": "根本没必要烦恼",
            "narrator_zh": "雅"
        },
        {
            "location": "397/TALK",
            "narrator": "みやび",
            "text": "うちの心は決まっちょる",
            "zh": "我的心早就定下来咯",
            "narrator_zh": "雅"
        },
        {
            "location": "404/TALK",
            "narrator": "みやび",
            "text": "…ウサギ。\n心配はいらんがよ。",
            "zh": "……兔子。\n不用担心咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "405/TALK",
            "narrator": "みやび",
            "text": "うちの覚悟はもう\n決まっちょるぞね。",
            "zh": "我的觉悟\n早就下定了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "406/TALK",
            "narrator": "繭",
            "text": "…本気なんですね？",
            "zh": "……是认真的吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "407/TALK",
            "narrator": "みやび",
            "text": "もちろんや。",
            "zh": "当然咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "409/TALK",
            "narrator": "みやび",
            "text": "管理庁が隠している\n秘密を暴くと\n最初から決めちょった。",
            "zh": "揭开管理厅\n藏起来的秘密，\n我从一开始就打定主意了。",
            "narrator_zh": "雅"
        },
        {
            "location": "410/TALK",
            "narrator": "みやび",
            "text": "最初はうちだけの\n事情やった。\nけんど、今は違う。",
            "zh": "最开始只是\n我自己的事。\n但是，现在不一样了。",
            "narrator_zh": "雅"
        },
        {
            "location": "411/TALK",
            "narrator": "みやび",
            "text": "うちだけやのうて、\n仲間たちにも関係の\nあることになった。",
            "zh": "不只是我，\n也变成了关系到\n伙伴们的事。",
            "narrator_zh": "雅"
        },
        {
            "location": "413/TALK",
            "narrator": "繭",
            "text": "…トライナリーは、\n管理庁管轄の部隊\nですからね。",
            "zh": "……因为三重奏，\n是管理厅管辖的\n部队啊。",
            "narrator_zh": "茧"
        },
        {
            "location": "414/TALK",
            "narrator": "みやび",
            "text": "そうや。",
            "zh": "没错咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "416/TALK",
            "narrator": "みやび",
            "text": "騙されたまま、\nっちゅうのは\n気に入らんし。",
            "zh": "被人蒙在鼓里\n这种事，\n我可不乐意。",
            "narrator_zh": "雅"
        },
        {
            "location": "417/TALK",
            "narrator": "みやび",
            "text": "それに、仲間内で\n調べるスキルが\nあるんはうちだけや。",
            "zh": "而且，伙伴里\n有调查技能的，\n也只有我一个。",
            "narrator_zh": "雅"
        },
        {
            "location": "418/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "419/TALK",
            "narrator": "みやび",
            "text": "うちはやるがよ、\nウサギ。",
            "zh": "我要干咯，\n兔子。",
            "narrator_zh": "雅"
        },
        {
            "location": "421/TALK",
            "narrator": "みやび",
            "text": "管理庁相手に、\n真っ向から戦争\n吹っかけてやるちや。",
            "zh": "对着管理厅，\n正面把战争\n挑起来给他们看滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "422/TALK",
            "narrator": "繭",
            "text": "…それを聞いて、\n安心しました。",
            "zh": "……听到这话，\n我就安心了。",
            "narrator_zh": "茧"
        },
        {
            "location": "424/TALK",
            "narrator": "繭",
            "text": "みやび先輩の覚悟が\n決まっているなら。",
            "zh": "只要雅前辈的觉悟\n已经定下。",
            "narrator_zh": "茧"
        },
        {
            "location": "426/TALK",
            "narrator": "繭",
            "text": "私も、安心して\nついていけます。",
            "zh": "我也能安心\n跟下去。",
            "narrator_zh": "茧"
        },
        {
            "location": "427/TALK",
            "narrator": "みやび",
            "text": "…いや。",
            "zh": "……不。",
            "narrator_zh": "雅"
        },
        {
            "location": "428/TALK",
            "narrator": "みやび",
            "text": "ウサギはもう、\nここで降りた方が\nえいと思う。",
            "zh": "兔子我觉得，\n你还是在这里\n收手比较好。",
            "narrator_zh": "雅"
        },
        {
            "location": "429/TALK",
            "narrator": "繭",
            "text": "…何故ですか？",
            "zh": "……为什么？",
            "narrator_zh": "茧"
        },
        {
            "location": "430/TALK",
            "narrator": "みやび",
            "text": "管理庁のことは\nウサギ個人には\nメリットはないろう？",
            "zh": "跟管理厅斗，\n对兔子你个人\n没好处吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "431/TALK",
            "narrator": "みやび",
            "text": "それに、ここから先は\nまっことデンジャー\nゾーンやし…。",
            "zh": "而且，从这往后\n就是蛮危险\n的地带了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "433/TALK",
            "narrator": "繭",
            "text": "…何を言うかと\n思えば。",
            "zh": "……正想着\n你会说什么呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "435/TALK",
            "narrator": "繭",
            "text": "私は最初から\n覚悟していました。",
            "zh": "我从一开始\n就下定决心了。",
            "narrator_zh": "茧"
        },
        {
            "location": "436/TALK",
            "narrator": "繭",
            "text": "そしてそれを\n望んでいました。",
            "zh": "而且这正是\n我所期望的。",
            "narrator_zh": "茧"
        },
        {
            "location": "438/TALK",
            "narrator": "繭",
            "text": "ＦａｔａｌＱｕｅｅｎ。\nあなたに出会った\nその時から。",
            "zh": "ＦａｔａｌＱｕｅｅｎ。\n从遇见你\n那一刻起。",
            "narrator_zh": "茧"
        },
        {
            "location": "439/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "440/TALK",
            "narrator": "繭",
            "text": "今更、そんな理由で\n引けと言われても\n従えません。",
            "zh": "事到如今，\n就算你拿这种理由\n叫我退，我也不从。",
            "narrator_zh": "茧"
        },
        {
            "location": "441/TALK",
            "narrator": "繭",
            "text": "第一、ここで\n戦力を低下させるなんて\n下策すぎます。",
            "zh": "再说，在这里\n降低战力什么的，\n也太下策了。",
            "narrator_zh": "茧"
        },
        {
            "location": "442/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "443/TALK",
            "narrator": "繭",
            "text": "そうでしょう？",
            "zh": "对吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "444/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "445/TALK",
            "narrator": "繭",
            "text": "Ｒａｂｂｉｔ\nＡｎｉｍａを\nなめないでください。",
            "zh": "Ｒａｂｂｉｔ\nＡｎｉｍａ\n也请不要小看。",
            "narrator_zh": "茧"
        },
        {
            "location": "447/TALK",
            "narrator": "みやび",
            "text": "……プッ。",
            "zh": "……噗。",
            "narrator_zh": "雅"
        },
        {
            "location": "449/TALK",
            "narrator": "繭",
            "text": "何で\n笑うんですか！？",
            "zh": "为什么\n要笑啊！？",
            "narrator_zh": "茧"
        },
        {
            "location": "451/TALK",
            "narrator": "みやび",
            "text": "……いや……。",
            "zh": "……没……。",
            "narrator_zh": "雅"
        },
        {
            "location": "453/TALK",
            "narrator": "みやび",
            "text": "…ウサギの中身は\nオッサンやと思うてた\nのになあって。",
            "zh": "……我还一直以为\n兔子你的内在\n是个大叔呢……。",
            "narrator_zh": "雅"
        },
        {
            "location": "455/TALK",
            "narrator": "繭",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": "茧"
        },
        {
            "location": "456/TALK",
            "narrator": "みやび",
            "text": "うちもまだまだ\nやったねえ。",
            "zh": "看来我还是\n修行不够啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "457/TALK",
            "narrator": "繭",
            "text": "お、オッサンって…。",
            "zh": "大、大叔什么的……。",
            "narrator_zh": "茧"
        },
        {
            "location": "458/TALK",
            "narrator": "繭",
            "text": "何が！？　何が原因で\nそう思わせてしまった\nのですか！？",
            "zh": "哪里！？　到底是哪里\n让你产生了\n这种想法！？",
            "narrator_zh": "茧"
        },
        {
            "location": "459/TALK",
            "narrator": "繭",
            "text": "私の発言がオッサン\n臭かったということ\nですか！？",
            "zh": "是我的发言\n有大叔味\n吗！？",
            "narrator_zh": "茧"
        },
        {
            "location": "462/TALK",
            "narrator": "みやび",
            "text": "いや、そうやない。",
            "zh": "不，不是那样。",
            "narrator_zh": "雅"
        },
        {
            "location": "463/TALK",
            "narrator": "繭",
            "text": "では、私の作成した\nコードが原因ですか？",
            "zh": "那么，是我写的\n代码的问题吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "464/TALK",
            "narrator": "みやび",
            "text": "あ、それはちっくと\n関係あるな。",
            "zh": "啊，那个确实\n有点关系。",
            "narrator_zh": "雅"
        },
        {
            "location": "465/TALK",
            "narrator": "みやび",
            "text": "あんな渋いコードを\n書いちょるのが年下の\n女子高生とは思わん。",
            "zh": "能写出那种\n老成代码的，\n我不信是年下的女高中生。",
            "narrator_zh": "雅"
        },
        {
            "location": "466/TALK",
            "narrator": "繭",
            "text": "なっ…。",
            "zh": "什……。",
            "narrator_zh": "茧"
        },
        {
            "location": "467/TALK",
            "narrator": "みやび",
            "text": "こんなことがある\nなんて、夢にも\n思わんかったがよ。",
            "zh": "会有这种事，\n做梦\n都没想过咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "468/TALK",
            "narrator": "繭",
            "text": "ど、どこが問題\nですか！？",
            "zh": "哪、哪里\n有问题！？",
            "narrator_zh": "茧"
        },
        {
            "location": "469/TALK",
            "narrator": "繭",
            "text": "そのオッサン臭さを\n感じる部分はどの辺り\nなのですか！？",
            "zh": "有大叔味的\n具体是哪一部分\n啊！？",
            "narrator_zh": "茧"
        },
        {
            "location": "470/TALK",
            "narrator": "みやび",
            "text": "あー、落ち着け\nウサギ。\n別に気にせんでも…。",
            "zh": "啊——冷静点，\n兔子。\n没必要在意的……。",
            "narrator_zh": "雅"
        },
        {
            "location": "471/TALK",
            "narrator": "繭",
            "text": "気になります！",
            "zh": "我很在意！",
            "narrator_zh": "茧"
        },
        {
            "location": "472/TALK",
            "narrator": "繭",
            "text": "渋いまでは許容範囲\nですが、オッサン臭い\nのは耐えられません！",
            "zh": "老成还能接受，\n有大叔味\n我可忍不了！",
            "narrator_zh": "茧"
        },
        {
            "location": "474/TALK",
            "narrator": "みやび",
            "text": "ちょ、落ち着け\nウサギ。",
            "zh": "等、等下，冷静，\n兔子。",
            "narrator_zh": "雅"
        },
        {
            "location": "476/TALK",
            "narrator": "みやび",
            "text": "――うわっ！？",
            "zh": "——哇！？",
            "narrator_zh": "雅"
        },
        {
            "location": "494/TALK",
            "narrator": "繭",
            "text": "きゃあっ！",
            "zh": "呀啊！",
            "narrator_zh": "茧"
        },
        {
            "location": "500/TALK",
            "narrator": "繭",
            "text": "…イタタタ。",
            "zh": "……疼疼疼。",
            "narrator_zh": "茧"
        },
        {
            "location": "501/TALK",
            "narrator": "みやび",
            "text": "…大丈夫か、ウサギ？",
            "zh": "……没事吧，兔子？",
            "narrator_zh": "雅"
        },
        {
            "location": "502/TALK",
            "narrator": "繭",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "茧"
        },
        {
            "location": "503/TALK",
            "narrator": "繭",
            "text": "な、なんてことを！\n私、みやび先輩を\n押し倒して…！！",
            "zh": "怎、怎么能这样！\n我竟然把\n雅前辈推倒了……！！",
            "narrator_zh": "茧"
        },
        {
            "location": "504/TALK",
            "narrator": "繭",
            "text": "す、すみません！\nすぐに退きますから！",
            "zh": "对、对不起！\n我马上让开！",
            "narrator_zh": "茧"
        },
        {
            "location": "508/TALK",
            "narrator": "繭",
            "text": "も、もも！\n申し訳ありません！",
            "zh": "真、真的！\n非常抱歉！",
            "narrator_zh": "茧"
        },
        {
            "location": "511/TALK",
            "narrator": "みやび",
            "text": "あ～、構わん構わん。\n別に痛かったわけや\nないんやし。",
            "zh": "啊～没事没事。\n反正又不是\n真的痛咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "512/TALK",
            "narrator": "繭",
            "text": "ですが…。",
            "zh": "可是……。",
            "narrator_zh": "茧"
        },
        {
            "location": "514/TALK",
            "narrator": "みやび",
            "text": "気にせんでえいって。\nオッサン臭い言うた\nうちのせいなんやし。",
            "zh": "别放在心上好咧。\n说有大叔味的\n是我，怪我咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "515/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "517/TALK",
            "narrator": "みやび",
            "text": "まあ、とにかく、\nウサギも手伝って\nちゅうことで。",
            "zh": "嘛，总之，\n就当兔子也来\n帮忙咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "518/TALK",
            "narrator": "みやび",
            "text": "ありがたく協力して\nもらうき。\nよろしく頼むぞね。",
            "zh": "这份协力我就\n不客气收下啵。\n拜托你了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "519/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "521/TALK",
            "narrator": "繭",
            "text": "…お任せください、\nみやび先輩！",
            "zh": "……请交给我吧，\n雅前辈！",
            "narrator_zh": "茧"
        },
        {
            "location": "523/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "524/TALK",
            "narrator": "繭",
            "text": "…何か？",
            "zh": "……怎么了吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "526/TALK",
            "narrator": "みやび",
            "text": "いや…随分嬉しそうに\nしちょるきねえ。",
            "zh": "没……你一副\n挺高兴的样子嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "527/TALK",
            "narrator": "みやび",
            "text": "今度はハグくらい\nしてくるかと思うて\n構えてるがよ。",
            "zh": "我正防着\n你待会儿会不会\n上来抱一下咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "529/TALK",
            "narrator": "繭",
            "text": "し、しません！\nそんなこと…。",
            "zh": "不、不会的！\n那种事……。",
            "narrator_zh": "茧"
        },
        {
            "location": "530/TALK",
            "narrator": "繭",
            "text": "…ちょっと待って…！\nせっかく構えていて\nくれたのに…！",
            "zh": "……等一下……！\n你特意防备\n到这份上……！",
            "narrator_zh": "茧"
        },
        {
            "location": "531/TALK",
            "narrator": "繭",
            "text": "これは自分で\nフラグ折った…！？",
            "zh": "这下是自己把\nflag给折了……！？",
            "narrator_zh": "茧"
        },
        {
            "location": "532/TALK",
            "narrator": "繭",
            "text": "…いやきっと冗談…\n冗談だから…。",
            "zh": "……不，肯定是玩笑……\n是玩笑啦……。",
            "narrator_zh": "茧"
        },
        {
            "location": "533/TALK",
            "narrator": "繭",
            "text": "…はぁ…。",
            "zh": "……唉……。",
            "narrator_zh": "茧"
        },
        {
            "location": "534/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "535/TALK",
            "narrator": "みやび",
            "text": "オッサン臭い言われて\nまっことショック\nやったみたいやな…。",
            "zh": "被人说有大叔味，\n看来是真的\n蛮受打击啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "538/TALK",
