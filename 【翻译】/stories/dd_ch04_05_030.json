{
    "dir": "chap05/daydra/dd_ch04_05_030.js",
    "type": "MainStory",
    "info": {
        "story_id": "5459",
        "cid": "miyabi",
        "title": "Extra009 プレミアムストーリー",
        "sub_title": "落ち込みガブちゃん",
        "title_zh": "Extra009 额外剧情",
        "sub_title_zh": "沮丧的小加布"
    },
    "entry": [
        {
            "location": "515/SCENARIO",
            "narrator": "",
            "text": "落ち込みガブちゃん",
            "zh": "沮丧的小加布",
            "narrator_zh": ""
        },
        {
            "location": "535/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "537/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん？\nなんか元気なさそう\nやけんど…。",
            "zh": "加布？\n好像没什么精神，\n但是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "538/TALK",
            "narrator": "みやび",
            "text": "おーい、ガブちゃん。\nどうかしたが？",
            "zh": "喂——，加布。\n怎么了？",
            "narrator_zh": "雅"
        },
        {
            "location": "540/TALK",
            "narrator": "ガブリエラ",
            "text": "…別に。",
            "zh": "……没什么。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "541/TALK",
            "narrator": "みやび",
            "text": "…機嫌悪そうやね。\n何かあったん？",
            "zh": "……好像心情不好咯。\n出什么事了？",
            "narrator_zh": "雅"
        },
        {
            "location": "542/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "544/TALK",
            "narrator": "みやび",
            "text": "話くらいなら\n聞くけんど？",
            "zh": "话的话\n我可以听，但是？",
            "narrator_zh": "雅"
        },
        {
            "location": "546/TALK",
            "narrator": "ガブリエラ",
            "text": "もう、うるさい！\n放っといて！",
            "zh": "真是的，好吵！\n别管我！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "549/TALK",
            "narrator": "みやび",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "550/TALK",
            "narrator": "みやび",
            "text": "…行ってしもうた。\n何があったんやろう？",
            "zh": "……走掉了。\n到底出什么事了？",
            "narrator_zh": "雅"
        },
        {
            "location": "555/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、\n荒れてるわね。",
            "zh": "加维，\n闹脾气了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "557/TALK",
            "narrator": "みやび",
            "text": "アーヤ…\n何か知ってるが？",
            "zh": "绫水……\n你知道什么咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "558/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "560/TALK",
            "narrator": "アーヤ",
            "text": "学校でね、\nクラスメイトに\n声をかけたらしいの。",
            "zh": "在学校，\n好像跟同学\n搭话了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "561/TALK",
            "narrator": "アーヤ",
            "text": "放課後、一緒に\nカフェでも\n行かないか、って。",
            "zh": "说放学后，\n要不要一起\n去咖啡馆。",
            "narrator_zh": "绫水"
        },
        {
            "location": "563/TALK",
            "narrator": "みやび",
            "text": "…ガブちゃんから\n行動するとは、\nビックリやね。",
            "zh": "……加布居然\n主动开口，\n真让人吃惊咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "565/TALK",
            "narrator": "アーヤ",
            "text": "そうね…けど、\n断られたみたいなの。",
            "zh": "是啊……不过，\n好像被拒绝了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "566/TALK",
            "narrator": "アーヤ",
            "text": "避けられてる、って\nわけじゃないみたい\nだけど――",
            "zh": "倒也不像是\n被躲开了\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "567/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、少しだけ\n距離を開けられてる\nみたい。",
            "zh": "不过，好像还是\n被稍微拉开了\n距离。",
            "narrator_zh": "绫水"
        },
        {
            "location": "568/TALK",
            "narrator": "みやび",
            "text": "…そうやったんか。\nガブちゃん、ショック\nやったろうね。",
            "zh": "……原来是这样咩。\n加布，一定\n受打击了吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "569/TALK",
            "narrator": "アーヤ",
            "text": "そういうわけだから、\n今はそっとしておいた\n方がいいわ。",
            "zh": "所以，\n现在还是先\n别去碰她。",
            "narrator_zh": "绫水"
        },
        {
            "location": "570/TALK",
            "narrator": "アーヤ",
            "text": "下手に刺激しても、\n大爆発しちゃう\nだろうし。",
            "zh": "乱刺激的话，\n大概会大爆发\n的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "573/TALK",
            "narrator": "みやび",
            "text": "…ん、わかった。",
            "zh": "……嗯，好。",
            "narrator_zh": "雅"
        },
        {
            "location": "578/TALK",
            "narrator": "みやび",
            "text": "…さて、と。",
            "zh": "……那么。",
            "narrator_zh": "雅"
        },
        {
            "location": "590/TALK",
            "narrator": "みやび",
            "text": "なあ、相棒",
            "zh": "我说，搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "591/TALK",
            "narrator": "みやび",
            "text": "もし、今からすることでうちが失敗したら",
            "zh": "要是我接下来要做的事失败了",
            "narrator_zh": "雅"
        },
        {
            "location": "592/TALK",
            "narrator": "みやび",
            "text": "その時は、慰めてもらえるか？",
            "zh": "到时候，能安慰我咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "594/SEL",
            "narrator": "",
            "text": "何をする気なの？",
            "zh": "你打算做什么？",
            "narrator_zh": ""
        },
        {
            "location": "595/ACT",
            "narrator": "",
            "text": "何をする気なの？",
            "zh": "你打算做什么？",
            "narrator_zh": ""
        },
        {
            "location": "597/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんのとこに行くんよ",
            "zh": "我要去加布那儿",
            "narrator_zh": "雅"
        },
        {
            "location": "598/TALK",
            "narrator": "みやび",
            "text": "アーヤにはああ言われたけんど、\n放ってはおけんきね",
            "zh": "绫水是那么说了，但是，\n我不能放着不管啵",
            "narrator_zh": "雅"
        },
        {
            "location": "599/TALK",
            "narrator": "みやび",
            "text": "ちゅうても、何をするわけでも\nないんやけんど",
            "zh": "话虽这么说，也不是\n要做什么，但是",
            "narrator_zh": "雅"
        },
        {
            "location": "600/TALK",
            "narrator": "みやび",
            "text": "怒らせてしもうた時は、\nうちのこと、慰めてほしいんよ",
            "zh": "要是把她惹火了，\n希望你安慰我",
            "narrator_zh": "雅"
        },
        {
            "location": "602/SEL",
            "narrator": "",
            "text": "わかった、頑張って！",
            "zh": "好，加油！",
            "narrator_zh": ""
        },
        {
            "location": "603/SEL",
            "narrator": "",
            "text": "放っておいた方が良い",
            "zh": "还是别管比较好",
            "narrator_zh": ""
        },
        {
            "location": "604/ACT",
            "narrator": "",
            "text": "わかった、頑張って！",
            "zh": "好，加油！",
            "narrator_zh": ""
        },
        {
            "location": "606/TALK",
            "narrator": "みやび",
            "text": "何を頑張ればえいのか、さっぱりやけんどね",
            "zh": "到底该怎么加油才得，我完全没懂，但是呢",
            "narrator_zh": "雅"
        },
        {
            "location": "607/TALK",
            "narrator": "みやび",
            "text": "すまんな、相棒にまで世話かけて",
            "zh": "没好意思，连搭档都要麻烦",
            "narrator_zh": "雅"
        },
        {
            "location": "608/TALK",
            "narrator": "みやび",
            "text": "じゃ、準備するちや",
            "zh": "那就，去准备滴",
            "narrator_zh": "雅"
        },
        {
            "location": "621/TALK",
            "narrator": "みやび",
            "text": "…とりあえず、\nコンビニでえいか。",
            "zh": "……总之，\n便利店就行了吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "634/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ……。",
            "zh": "唉……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "635/TALK",
            "narrator": "ガブリエラ",
            "text": "何よ、最初の頃は\nあんなに向こうから\n声かけてきたくせに。",
            "zh": "什么啊，一开始\n明明是对方\n主动跟我说话的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "636/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたし、別に何も\nしてないのに。",
            "zh": "……我又\n什么都没做。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "637/TALK",
            "narrator": "ガブリエラ",
            "text": "…結構、勇気出して\n声かけたのに。",
            "zh": "……我可是鼓足勇气\n才开口的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "639/TALK",
            "narrator": "ガブリエラ",
            "text": "ぐすっ…。",
            "zh": "呜……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "642/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん、おつ～。",
            "zh": "加布，辛苦～。",
            "narrator_zh": "雅"
        },
        {
            "location": "646/TALK",
            "narrator": "ガブリエラ",
            "text": "きゃぁっ！？",
            "zh": "呀啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "648/TALK",
            "narrator": "みやび",
            "text": "おっ、可愛い声やね。\nどうかしたが？",
            "zh": "哦，声音真可爱咯。\n怎么了？",
            "narrator_zh": "雅"
        },
        {
            "location": "651/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そそ、それは\nこっちのセリフよ、\nバカ！！",
            "zh": "这、这这，那是\n我要说的话，\n笨蛋！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "652/TALK",
            "narrator": "ガブリエラ",
            "text": "ノックも挨拶もなしに\n人の部屋入って来る\nとか、何考えてるの！？",
            "zh": "也不敲门也不打招呼\n就进别人房间，\n你在想什么！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "653/TALK",
            "narrator": "みやび",
            "text": "すまんすまん。",
            "zh": "没好意思没好意思。",
            "narrator_zh": "雅"
        },
        {
            "location": "654/TALK",
            "narrator": "みやび",
            "text": "けんど、どうしても\nガブちゃんとチョコを\n食べたい思うたら――",
            "zh": "但是，我实在想\n和加布一起\n吃巧克力——",
            "narrator_zh": "雅"
        },
        {
            "location": "656/TALK",
            "narrator": "みやび",
            "text": "自分を抑えられなく\nなってしもうたんよ。",
            "zh": "就忍不住\n了。",
            "narrator_zh": "雅"
        },
        {
            "location": "657/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ！？　っていうか、\nその大きいコンビニの\n袋って…。",
            "zh": "哈！？　话说，\n那个好大的便利店\n袋子是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "658/TALK",
            "narrator": "みやび",
            "text": "チョコレートちや。\nコンビニで美味そうなん、\n適当に買ってきたんよ。",
            "zh": "巧克力滴。\n便利店里看起来好吃的，\n随便买了些来。",
            "narrator_zh": "雅"
        },
        {
            "location": "659/TALK",
            "narrator": "みやび",
            "text": "さあ、食べよ食べよ。\nほれ、ストロベリー\n入りのもあるがよ。",
            "zh": "来，吃吧吃吧。\n瞧，还有草莓\n夹心的。",
            "narrator_zh": "雅"
        },
        {
            "location": "660/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、待ってよ！\nあたし、食べるなんて\n一言も…。",
            "zh": "等、等一下！\n我可一句\n要吃都没说……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "661/TALK",
            "narrator": "みやび",
            "text": "えいから、ほら。\n一つ口に入れてみぃ。",
            "zh": "好啦，来。\n往嘴里放一个试试。",
            "narrator_zh": "雅"
        },
        {
            "location": "663/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "664/TALK",
            "narrator": "みやび",
            "text": "頑固やねぇ…。\nまあ、それならうちが\n食べるき、えいよ。",
            "zh": "真固执咯……。\n嘛，那我来\n吃啵，得咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "665/TALK",
            "narrator": "みやび",
            "text": "あむっ…",
            "zh": "啊呜……",
            "narrator_zh": "雅"
        },
        {
            "location": "666/TALK",
            "narrator": "みやび",
            "text": "んんっ！？",
            "zh": "嗯嗯！？",
            "narrator_zh": "雅"
        },
        {
            "location": "667/TALK",
            "narrator": "みやび",
            "text": "思うてたより濃厚で、\n口ん中が一瞬で\nチョコの味まみれや。",
            "zh": "比想的更浓，\n嘴里一下子\n全是巧克力味。",
            "narrator_zh": "雅"
        },
        {
            "location": "668/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "669/TALK",
            "narrator": "みやび",
            "text": "次は、こっちのにするか。",
            "zh": "下一个，换这个吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "670/TALK",
            "narrator": "みやび",
            "text": "あむっ…んむんむ…。",
            "zh": "啊呜……嗯唔嗯唔……。",
            "narrator_zh": "雅"
        },
        {
            "location": "671/TALK",
            "narrator": "みやび",
            "text": "…こっちは薄いけんど、\n優しい甘さやね。",
            "zh": "……这个淡一些，但是\n甜得很柔和咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "673/TALK",
            "narrator": "ガブリエラ",
            "text": "…聞かないの？\n何かあったのか、って。",
            "zh": "……你不问吗？\n问我出了什么事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "675/TALK",
            "narrator": "みやび",
            "text": "うち、ガブちゃんと\nチョコ食べよう思うて\n来ただけや。",
            "zh": "我只是想来\n和加布\n吃巧克力。",
            "narrator_zh": "雅"
        },
        {
            "location": "676/TALK",
            "narrator": "みやび",
            "text": "ほれ、早く食べんと、\n全部うちが食べてしまう\nぞね？",
            "zh": "瞧，不快点吃，\n全都被我吃掉\n了咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "678/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしからは、\n話さないからね？",
            "zh": "……我这边，\n是不会说的？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "679/TALK",
            "narrator": "みやび",
            "text": "話さんでえいから、\nほれ、\nチョコ食べるちや。",
            "zh": "不说也行，\n来，\n吃巧克力滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "681/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "683/TALK",
            "narrator": "ガブリエラ",
            "text": "あむっ…。",
            "zh": "啊呜……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "685/TALK",
            "narrator": "みやび",
            "text": "どうや？",
            "zh": "怎么样？",
            "narrator_zh": "雅"
        },
        {
            "location": "687/TALK",
            "narrator": "ガブリエラ",
            "text": "…美味しいわ。",
            "zh": "……好吃。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "688/TALK",
            "narrator": "みやび",
            "text": "そうか…もっとあるき、\nどんどん食べるんよ。",
            "zh": "是咩……还有很多啵，\n尽管吃。",
            "narrator_zh": "雅"
        },
        {
            "location": "690/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当、絶対に\n話さないからね？",
            "zh": "……真的，绝对\n不会说的？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "692/TALK",
            "narrator": "みやび",
            "text": "食べながら話すんは\n行儀も悪いきね。",
            "zh": "边吃边说\n也不礼貌啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "693/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "696/TALK",
            "narrator": "ガブリエラ",
            "text": "…ありがと。\n一緒にいてくれて。",
            "zh": "……谢谢。\n陪着我。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "697/TALK",
            "narrator": "みやび",
            "text": "…うん。",
            "zh": "……嗯。",
            "narrator_zh": "雅"
        },
        {
            "location": "699/TALK",
            "narrator": "ガブリエラ",
            "text": "…そっちの、\nマシュマロチョコも\n開けていい？",
            "zh": "……那边那个，\n棉花糖巧克力\n也能打开吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "700/TALK",
            "narrator": "みやび",
            "text": "もちろんや。\n全部開けて、テーブルに\n広げても構わないんよ。",
            "zh": "当然咯。\n全部打开，摊在桌上\n也没关系。",
            "narrator_zh": "雅"
        },
        {
            "location": "701/TALK",
            "narrator": "みやび",
            "text": "好きなように、\n好きなだけ\n食べればえいちや。",
            "zh": "随你喜欢，\n想吃多少\n就吃多少，就行滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "727/ACT",
            "narrator": "",
            "text": "放っておいた方が良い",
            "zh": "还是别管比较好",
            "narrator_zh": ""
        },
        {
            "location": "728/TALK",
            "narrator": "みやび",
            "text": "相棒はアーヤと同じような考えなが？",
            "zh": "搭档和绫水想的一样咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "729/TALK",
            "narrator": "みやび",
            "text": "まあ、確かに今のガブちゃんに近づくと、大爆発起こしそうではあるけんど",
            "zh": "嘛，现在靠近加布，确实像会大爆发，但是",
            "narrator_zh": "雅"
        },
        {
            "location": "730/TALK",
            "narrator": "みやび",
            "text": "そんなときに部屋に一人でいるんは、いつも以上に寂しいと思うんよ",
            "zh": "这种时候一个人待在房间里，我想会比平时更孤单",
            "narrator_zh": "雅"
        },
        {
            "location": "731/TALK",
            "narrator": "みやび",
            "text": "それに、一人で爆発するより、誰かに爆発した方が気持ちもスッキリするやろうしね",
            "zh": "而且，比起一个人爆发，冲着谁爆发心情也会痛快些吧",
            "narrator_zh": "雅"
        },
        {
            "location": "732/TALK",
            "narrator": "みやび",
            "text": "まあ、爆発されたら、いくらうちでもグサッとは来るき――",
            "zh": "嘛，要是被爆发冲到，就算是我也会扎心地一紧啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "733/TALK",
            "narrator": "みやび",
            "text": "その時の慰め役に、相棒にはなってもらいたいんよ",
            "zh": "到时候，想请搭档来当安慰的人",
            "narrator_zh": "雅"
        },
        {
            "location": "735/SEL",
            "narrator": "",
            "text": "わかった、頑張って！",
            "zh": "好，加油！",
            "narrator_zh": ""
        },
        {
            "location": "736/SEL",
            "narrator": "",
            "text": "結果は見えてるよ",
            "zh": "结果已经能看见了",
            "narrator_zh": ""
        },
        {
            "location": "737/ACT",
            "narrator": "",
            "text": "わかった、頑張って！",
            "zh": "好，加油！",
            "narrator_zh": ""
        },
        {
            "location": "738/TALK",
            "narrator": "みやび",
            "text": "何を頑張ればえいのか、さっぱりやけんどね",
            "zh": "到底该怎么加油才得，我完全没懂，但是呢",
            "narrator_zh": "雅"
        },
        {
            "location": "739/TALK",
            "narrator": "みやび",
            "text": "すまんな、相棒にまで世話かけて",
            "zh": "没好意思，连搭档都要麻烦",
            "narrator_zh": "雅"
        },
        {
            "location": "740/TALK",
            "narrator": "みやび",
            "text": "じゃ、準備するちや",
            "zh": "那就，去准备滴",
            "narrator_zh": "雅"
        },
        {
            "location": "742/ACT",
            "narrator": "",
            "text": "結果は見えてるよ",
            "zh": "结果已经能看见了",
            "narrator_zh": ""
        },
        {
            "location": "743/TALK",
            "narrator": "みやび",
            "text": "…なら、うちが勝手にやるだけや",
            "zh": "……那，我就自作主张去做了",
            "narrator_zh": "雅"
        },
        {
            "location": "755/TALK",
            "narrator": "みやび",
            "text": "…薄情な奴や、\nまったく。",
            "zh": "……真薄情，\n真是的。",
            "narrator_zh": "雅"
        },
        {
            "location": "756/TALK",
            "narrator": "みやび",
            "text": "さてと、\n急いで準備せんと…。",
            "zh": "那么，\n得赶紧准备……。",
            "narrator_zh": "雅"
        },
        {
            "location": "524/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月16日　4:23 PM</color>\nとある平日の夕方、神楽坂トライナリー楽屋にて。",
            "zh": "<color=green>5月16日　4:23 PM</color>\n某个工作日的傍晚，在神乐坂三重奏剧场的后台。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "712/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch04",
            "text": "【笑わせるか笑われるか、それが問題だ】",
            "zh": "【是逗人笑，还是被人笑，这是个问题】",
            "narrator_zh": "Dialog_GEThimegoto_ch04"
        },
        {
            "location": "723/DIALOG",
            "narrator": "Dialog_GETGokigen",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": "Dialog_GETGokigen"
        }
    ]
}
