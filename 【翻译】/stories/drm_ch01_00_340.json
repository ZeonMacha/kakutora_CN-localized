   "narrator_zh": "燕"
  },
  {
   "location": "543/TALK",
   "narrator": "つばめ",
   "text": "来なくなったのは絶対理由がぁるはずだょ(´・ω・｀)"
  },
  {
   "location": "544/TALK",
   "narrator": "つばめ",
   "text": "なのにどうして、みんな卯月さんのこと悪く言うの？",
