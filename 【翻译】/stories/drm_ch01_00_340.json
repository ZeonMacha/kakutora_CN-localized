  },
  {
   "location": "539/TALK",
   "narrator": "つばめ",
   "text": "ぁたしどうしてみんなと違っちゃうんだろう？"
  },
  {
   "location": "540/TALK",
   "narrator": "つばめ",
   "text": "なんでみんな、ぁたしと違うことを言うんだろう？",
   "zh": "为什么大家都说跟我不一样的话呢？",
   "narrator_zh": "燕"
  },
  {
   "location": "541/TALK",
   "narrator": "つばめ",
   "text": "ぁたしは卯月さんのことが心配なの(´・ω・｀)"
  },
  {
   "location": "542/TALK",
   "narrator": "つばめ",
   "text": "だってあんなにがんばりやさんだったんだょ？",
