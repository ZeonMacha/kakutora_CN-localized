{
    "dir": "chap23/daydra/dd_ch02_23_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "23252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "不器用なリーダー",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "笨拙的队长"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "不器用なリーダー",
            "zh": "笨拙的队长",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "あー、疲れたぁ…。\n今日の訓練、ちょっと\nスパルタ過ぎじゃない？",
            "zh": "啊—，累死了……。\n今天的训练，是不是有点\n太魔鬼了呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "当然でしょ？\n限界まで動かなくちゃ\n訓練じゃないわ。",
            "zh": "那当然了？\n不练到极限\n就不叫训练哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "28/TALK",
            "narrator": "つばめ",
            "text": "もうヘトヘトです…。\n早く帰ろうよ…。",
            "zh": "已经筋疲力尽了……。\n快点回去吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "29/TALK",
            "narrator": "みやび",
            "text": "大賛成や。\n熱い風呂と冷えた麦茶で\n疲れた身体を癒すぞね。",
            "zh": "我完全赞成。\n洗个热水澡再喝杯冰麦茶\n把累坏的身子好好缓一缓啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃ、早く帰りましょ。",
            "zh": "那，我们快回去吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "あ、ちょっと待って。",
            "zh": "啊，等一下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "36/TALK",
            "narrator": "アーヤ",
            "text": "卯月、この後なんだけど、\nお茶しに行かない？",
            "zh": "卯月，等会儿有空吗，\n要不要一起去喝茶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "神楽",
            "text": "えっ…、いいですけど、\nそれなら、つばめさんも\n一緒に――",
            "zh": "哎……，我是可以，\n那既然这样，燕也\n一起——",
            "narrator_zh": "神乐"
        },
        {
            "location": "39/TALK",
            "narrator": "アーヤ",
            "text": "二人だけがいいわ。\nちょっと、大事な話だから。",
            "zh": "就我们两个人吧。\n有点重要的事想跟你说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "…訓練で疲れてるとこ、\n無理言ってごめんなさい。",
            "zh": "……刚训练完很累吧，\n还勉强约你出来，抱歉。",
            "narrator_zh": "绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "神楽",
            "text": "あ、いえ…。\n特に予定もありません\nでしたから…。",
            "zh": "啊，没有……。\n反正我也\n没什么别的安排……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "そう…。",
            "zh": "这样啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "…緊張してるのかしら？\nまあ、無理もないわね。",
            "zh": "……在紧张吗？\n嘛，这也是难免的吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "私も、卯月と二人きりで\n話すことって少ないから、\nちょっと緊張してるし…。",
            "zh": "其实我也很少和卯月\n单独两个人聊天，\n也有点紧张呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "65/TALK",
            "narrator": "アーヤ",
            "text": "…って、いけないわね。\n誘ったのは私なんだから、\nこっちから始めないと。",
            "zh": "……不过，这样可不行。\n既然是我约的你，\n就该由我先开口才对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "66/TALK",
            "narrator": "アーヤ",
            "text": "えっと…どうして呼んだか、\n卯月も察しは付いてると\n思うんだけど…どう？",
            "zh": "那个……我为什么叫你出来，\n我想卯月心里应该也有数了……\n怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "神楽",
            "text": "…最近の私の態度に、\n問題があるからですよね？",
            "zh": "……是因为我最近的态度，\n有问题对吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "68/TALK",
            "narrator": "アーヤ",
            "text": "率直に言うと、まあ…\nそういうことになるわね。",
            "zh": "直白地说，嘛……\n算是这么回事吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "神楽",
            "text": "…ごめんなさい。",
            "zh": "……对不起。",
            "narrator_zh": "神乐"
        },
        {
            "location": "72/TALK",
            "narrator": "アーヤ",
            "text": "あ、ううん。\n謝ってほしいわけじゃ\nないのよ。",
            "zh": "啊，不是的。\n我并不是想\n让你道歉。",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "アーヤ",
            "text": "むしろ、今卯月に\n謝らなきゃいけないのは\n私の方よ。",
            "zh": "不如说，现在该向卯月\n道歉的\n是我才对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "アーヤ",
            "text": "卯月の気持ちを知ってて、\n無茶なお願いしてるんだし。",
            "zh": "明明知道卯月的心情，\n却还是提出这么强人所难的要求。",
            "narrator_zh": "绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "77/TALK",
            "narrator": "アーヤ",
            "text": "でも、このままの状態が\n続くと…不安なのよ。",
            "zh": "可是，照现在这样下去……\n我会很不安的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "今の卯月は、訓練にすら\n集中できないような\n状態でしょ？",
            "zh": "现在的卯月，甚至连训练\n都无法集中精力，\n不是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "なのに、実戦でちゃんと\n動けるのか、って…。",
            "zh": "这样的话，到了实战时\n真的能好好行动吗……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "アーヤ",
            "text": "私達も、そんな卯月を\n護って戦えるか聞かれると、\nちょっと自信ないの。",
            "zh": "要是被问起我们能不能保护\n这样的卯月继续战斗，\n老实说我也没太大把握。",
            "narrator_zh": "绫水"
        },
        {
            "location": "81/TALK",
            "narrator": "神楽",
            "text": "…すみません。",
            "zh": "……非常抱歉。",
            "narrator_zh": "神乐"
        },
        {
            "location": "82/TALK",
            "narrator": "アーヤ",
            "text": "…ううん。\n人間だし、悩みを抱くのは\n当然のことよね。",
            "zh": "……没事。\n只要是人，心里有烦恼\n都是很正常的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "それに、そういう時に\n支え合ってこそ、\n仲間なんだし。",
            "zh": "而且，在这种时候\n互相扶持，\n才是同伴嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "だからね、今すぐに\nどうにかしろとは言わない。",
            "zh": "所以呢，我不是说让你\n立刻就振作起来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "アーヤ",
            "text": "けど、少しでも早く\n元の状態に戻ってほしいと\n思ってる。",
            "zh": "只是，我希望你能哪怕早一点\n恢复到\n原来的状态。",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "卯月が、少しでもみんなと\n元の状態に戻りたいと\n思ってくれてるなら…ね。",
            "zh": "如果卯月自己，哪怕有一点想和大家\n回到从前那种状态的话……\n对吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "神楽",
            "text": "…はい。",
            "zh": "……是的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "90/TALK",
            "narrator": "アーヤ",
            "text": "…わかってくれた？",
            "zh": "……明白我的意思了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "91/TALK",
            "narrator": "神楽",
            "text": "…すぐには無理です。",
            "zh": "……虽然没法立刻做到。",
            "narrator_zh": "神乐"
        },
        {
            "location": "92/TALK",
            "narrator": "神楽",
            "text": "でも…この状態がいいとは\n私も思っていません。",
            "zh": "但是……我也并不觉得\n现在这种状态是好的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "93/TALK",
            "narrator": "神楽",
            "text": "だから、何とかします…。",
            "zh": "所以，我会想办法调整的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "94/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "95/TALK",
            "narrator": "神楽",
            "text": "…すみませんでした。\nでは、失礼します。",
            "zh": "……实在不好意思。\n那我先失陪了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "106/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/TALK",
            "narrator": "アーヤ",
            "text": "失敗したかも(-ω-;)",
            "zh": "好像搞砸了(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "113/TALK",
            "narrator": "アーヤ",
            "text": "卯月",
            "zh": "卯月",
            "narrator_zh": "绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "アーヤ",
            "text": "もっと元気なくなっちゃった気がする(T_T)",
            "zh": "感觉她变得更没精神了(T_T)",
            "narrator_zh": "绫水"
        },
        {
            "location": "116/SEL",
            "narrator": "",
            "text": "元気づけたかったの？",
            "zh": "原本是想给她打气的？",
            "narrator_zh": ""
        },
        {
            "location": "117/ACT",
            "narrator": "",
            "text": "元気づけたかったの？",
            "zh": "原本是想给她打气的？",
            "narrator_zh": ""
        },
        {
            "location": "119/TALK",
            "narrator": "アーヤ",
            "text": "そう(; ;)",
            "zh": "对(; ;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "アーヤ",
            "text": "卯月と",
            "zh": "我和卯月",
            "narrator_zh": "绫水"
        },
        {
            "location": "122/TALK",
            "narrator": "アーヤ",
            "text": "二人だけで話したこと",
            "zh": "几乎没怎么",
            "narrator_zh": "绫水"
        },
        {
            "location": "123/TALK",
            "narrator": "アーヤ",
            "text": "ほとんどなかったの(>_<)",
            "zh": "单独聊过天(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "しかも真面目な話",
            "zh": "而且还是这么严肃的话题",
            "narrator_zh": "绫水"
        },
        {
            "location": "125/TALK",
            "narrator": "アーヤ",
            "text": "緊張して",
            "zh": "一紧张起来",
            "narrator_zh": "绫水"
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "追い打ちかけちゃった気がする(；´Д｀)",
            "zh": "感觉反而对她穷追猛打了(；´Д｀)",
            "narrator_zh": "绫水"
        },
        {
            "location": "127/TALK",
            "narrator": "アーヤ",
            "text": "私はただ",
            "zh": "我明明只是",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "アーヤ",
            "text": "卯月に元気になってほしくて",
            "zh": "希望卯月能打起精神",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "励ますつもりだった",
            "zh": "原本是打算鼓励她的",
            "narrator_zh": "绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "アーヤ",
            "text": "なのに逆効果(ノД`)",
            "zh": "结果却适得其反(ノД`)",
            "narrator_zh": "绫水"
        },
        {
            "location": "132/TALK",
            "narrator": "アーヤ",
            "text": "バカなことしたな",
            "zh": "真是干了件蠢事",
            "narrator_zh": "绫水"
        },
        {
            "location": "133/TALK",
            "narrator": "アーヤ",
            "text": "見守ってればよかった(T_T)",
            "zh": "当初默默守着她就好了(T_T)",
            "narrator_zh": "绫水"
        },
        {
            "location": "135/SEL",
            "narrator": "",
            "text": "言ってよかったと思う",
            "zh": "我觉得说出来挺好的",
            "narrator_zh": ""
        },
        {
            "location": "136/SEL",
            "narrator": "",
            "text": "謝りに行くしかない",
            "zh": "只能去道歉了",
            "narrator_zh": ""
        },
        {
            "location": "137/SEL",
            "narrator": "",
            "text": "頼りないなぁ",
            "zh": "真靠不住啊",
            "narrator_zh": ""
        },
        {
            "location": "138/ACT",
            "narrator": "",
            "text": "言ってよかったと思う",
            "zh": "我觉得说出来挺好的",
            "narrator_zh": ""
        },
        {
            "location": "139/TALK",
            "narrator": "アーヤ",
            "text": "そう？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "140/TALK",
            "narrator": "アーヤ",
            "text": "逆効果になってない？",
            "zh": "没有适得其反吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "142/SEL",
            "narrator": "",
            "text": "やるべきことをやった",
            "zh": "你做了该做的事",
            "narrator_zh": ""
        },
        {
            "location": "143/SEL",
            "narrator": "",
            "text": "かっこよかったよ",
            "zh": "你刚才很帅哦",
            "narrator_zh": ""
        },
        {
            "location": "144/ACT",
            "narrator": "",
            "text": "やるべきことをやった",
            "zh": "你做了该做的事",
            "narrator_zh": ""
        },
        {
            "location": "145/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう(; ;)",
            "zh": "谢谢(; ;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "147/TALK",
            "narrator": "アーヤ",
            "text": "誰かにそう言ってもらえると",
            "zh": "能听见有人这么说",
            "narrator_zh": "绫水"
        },
        {
            "location": "148/TALK",
            "narrator": "アーヤ",
            "text": "安心する(T_T)",
            "zh": "心里安心多了(T_T)",
            "narrator_zh": "绫水"
        },
        {
            "location": "149/TALK",
            "narrator": "アーヤ",
            "text": "ちょっとだけど",
            "zh": "虽然只有一点点",
            "narrator_zh": "绫水"
        },
        {
            "location": "150/TALK",
            "narrator": "アーヤ",
            "text": "伝えたいことは伝えたから",
            "zh": "但想传达的话已经传达到了",
            "narrator_zh": "绫水"
        },
        {
            "location": "151/TALK",
            "narrator": "アーヤ",
            "text": "慌てないで",
            "zh": "别慌张",
            "narrator_zh": "绫水"
        },
        {
            "location": "152/TALK",
            "narrator": "アーヤ",
            "text": "見守ることにするわ(｡-_-｡)",
            "zh": "我决定先静静守着她了(｡-_-｡)",
            "narrator_zh": "绫水"
        },
        {
            "location": "154/ACT",
            "narrator": "",
            "text": "かっこよかったよ",
            "zh": "你刚才很帅哦",
            "narrator_zh": ""
        },
        {
            "location": "155/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう(^^",
            "zh": "谢谢(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "157/TALK",
            "narrator": "アーヤ",
            "text": "でもやっぱり",
            "zh": "不过果然还是",
            "narrator_zh": "绫水"
        },
        {
            "location": "158/TALK",
            "narrator": "アーヤ",
            "text": "バカなことしたかも(-.-;)",
            "zh": "干了件蠢事吧(-.-;)",
            "narrator_zh": "绫水"
