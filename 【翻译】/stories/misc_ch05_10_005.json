        },
        {
            "location": "2771/TALK",
            "narrator": "神楽",
            "text": "多すぎねえ？",
            "zh": "也太多了吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2773/SEL",
            "narrator": "",
            "text": "さすがに盛りすぎだろｗ",
