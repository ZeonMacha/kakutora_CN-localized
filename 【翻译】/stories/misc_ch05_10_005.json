        },
        {
            "location": "2779/TALK",
            "narrator": "神楽",
            "text": "な？",
            "zh": "是吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2780/ACT",
            "narrator": "",
            "text": "神楽なら５０人でも足りないよ！",
            "zh": "以神乐来说，50个人也不够！",
            "narrator_zh": ""
        },
        {
            "location": "2782/TALK",
            "narrator": "神楽",
            "text": "$handlek$は神楽に対して欲張りぴょん♪",
            "zh": "$handlek$对神乐可贪心pyon♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "2783/TALK",
            "narrator": "神楽",
            "text": "その重い愛がたまらないデュフフ",
            "zh": "这份沉重的爱让人受不了，嘟呼呼",
            "narrator_zh": "神乐"
        },
        {
            "location": "2785/TALK",
            "narrator": "神楽",
            "text": "しかもケルベロス、神話でもらったことになってる食べ物ってパンとか炭水化物系ばっかりなんだけど",
            "zh": "而且刻耳柏洛斯，神话里说它得到的食物净是面包之类的碳水化合物",
            "narrator_zh": "神乐"
        },
        {
            "location": "2786/TALK",
            "narrator": "神楽",
            "text": "ひょっとしてアイツ、肉食獣じゃないのかな！？",
            "zh": "难道那家伙不是肉食兽！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2787/TALK",
            "narrator": "神楽",
            "text": "野生の力を取り戻せケルベロス！！！",
            "zh": "取回野性的力量吧，刻耳柏洛斯！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2788/TALK",
            "narrator": "神楽",
            "text": "いや番犬だから飼いならされてるって暗示なのかもしれず",
            "zh": "不对，因为它是看门犬，也许是在暗示它被驯服了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2790/TALK",
            "narrator": "神楽",
            "text": "ケルベロスに対する興味は尽きないね！",
            "zh": "对刻耳柏洛斯的兴趣停不下来呢！",
            "narrator_zh": "神乐"
