            "narrator": "神楽",
            "text": "自分で調べろ",
            "zh": "自己去查",
            "narrator_zh": "神乐"
        },
        {
            "location": "2769/TALK",
            "narrator": "神楽",
            "text": "ところでケルベロスの初期設定って頭５０個あったんだって",
            "zh": "话说刻耳柏洛斯的初期设定，听说有50个头",
