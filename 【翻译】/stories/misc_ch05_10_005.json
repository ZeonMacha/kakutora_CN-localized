            "narrator_zh": ""
        },
        {
            "location": "2764/TALK",
            "narrator": "神楽",
            "text": "ちょっと今すぐやってみせて！",
            "zh": "现在马上做给我看！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2765/TALK",
            "narrator": "神楽",
            "text": "動画サイトに投稿するから！！！",
            "zh": "我要投稿到视频网站！！！",
