    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "アニメ第07話",
            "zh": "动画第07话",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "千羽鶴",
            "text": "塩対応モードの\n千羽鶴です。",
            "zh": "这里是冷淡应对模式的\n千羽鹤。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "48/TALK",
            "narrator": "千羽鶴",
            "text": "なので今回は、\n冒頭の挨拶もなし。",
            "zh": "所以这一次，\n连开场白都省了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "49/SEL",
            "narrator": "",
            "text": "OK",
            "zh": "OK",
            "narrator_zh": ""
        },
        {
            "location": "50/SEL",
            "narrator": "",
            "text": "何かお話ししたい！",
            "zh": "想跟你聊点什么！",
            "narrator_zh": ""
        },
        {
            "location": "52/ACT",
            "narrator": "",
            "text": "何かお話ししたい！",
            "zh": "想跟你聊点什么！",
            "narrator_zh": ""
        },
        {
            "location": "54/TALK",
            "narrator": "千羽鶴",
            "text": "そう言われても……。",
            "zh": "就算你这么说……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "55/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃ――",
            "zh": "那好吧——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "56/TALK",
            "narrator": "千羽鶴",
            "text": "ヘーゲルの弁証法について\nお話してみることにする。",
            "zh": "我就来和你聊聊\n黑格尔的辩证法吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "57/SEL",
            "narrator": "",
            "text": "遠慮します",
            "zh": "那还是免了",
            "narrator_zh": ""
        },
        {
            "location": "58/SEL",
            "narrator": "",
            "text": "是非とも！",
            "zh": "请务必讲讲！",
            "narrator_zh": ""
        },
        {
            "location": "59/ACT",
            "narrator": "",
            "text": "遠慮します",
            "zh": "那还是免了",
            "narrator_zh": ""
        },
        {
            "location": "60/TALK",
            "narrator": "千羽鶴",
            "text": "賢明な判断。",
            "zh": "明智的判断。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "61/ACT",
            "narrator": "",
            "text": "是非とも！",
            "zh": "请务必讲讲！",
            "narrator_zh": ""
        },
        {
            "location": "62/TALK",
            "narrator": "千羽鶴",
            "text": "……物好きな人。",
            "zh": "……真是怪癖。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "63/TALK",
            "narrator": "千羽鶴",
            "text": "まあいい。",
            "zh": "算了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "64/TALK",
            "narrator": "千羽鶴",
            "text": "ヘーゲルの弁証法は、\n正と反から合を作り出す\n錬金術の法則。",
            "zh": "黑格尔的辩证法，\n是从正题与反题中创造出\n合题的炼金术法则。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "65/TALK",
            "narrator": "千羽鶴",
            "text": "この法則を知ってると、\n世の中をとても楽に\n支配できるかもしれない。",
            "zh": "只要掌握了这个法则，\n说不定就能非常轻松地\n支配这个世界。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "66/SEL",
            "narrator": "",
            "text": "どうやって？",
            "zh": "具体要怎么做？",
            "narrator_zh": ""
        },
        {
            "location": "67/ACT",
            "narrator": "",
            "text": "どうやって？",
            "zh": "具体要怎么做？",
            "narrator_zh": ""
        },
        {
            "location": "69/TALK",
            "narrator": "千羽鶴",
            "text": "それは自分で調べて。",
            "zh": "那种事自己去查。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "70/SEL",
            "narrator": "",
            "text": "ひどい！",
            "zh": "太过分了！",
            "narrator_zh": ""
        },
        {
            "location": "71/ACT",
            "narrator": "",
            "text": "ひどい！",
            "zh": "太过分了！",
            "narrator_zh": ""
        },
        {
            "location": "73/TALK",
            "narrator": "千羽鶴",
            "text": "だって今、ちーは\n塩対応モードだもの。",
            "zh": "因为现在小千可是\n冷淡应对模式嘛。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "74/TALK",
            "narrator": "千羽鶴",
            "text": "はい、これでお話は終了。",
            "zh": "好了，闲聊到此为止。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "80/TALK",
            "narrator": "千羽鶴",
            "text": "今回は、\n逢瀬つばめの解説を\nするだけでもいい？",
            "zh": "这一次，\n只做逢濑燕的解说\n就可以了吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "83/TALK",
            "narrator": "千羽鶴",
            "text": "今回は、\n國政綾水の解説を\nするだけでもいい？",
            "zh": "这一次，\n只做国政绫水的解说\n就可以了吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "86/TALK",
            "narrator": "千羽鶴",
            "text": "今回は、\nガブリエラの解説を\nするだけでもいい？",
            "zh": "这一次，\n只做加布里埃拉的解说\n就可以了吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "89/TALK",
            "narrator": "千羽鶴",
            "text": "今回は、\n恋ヶ崎みやびの解説を\nするだけでもいい？",
            "zh": "这一次，\n只做恋之崎雅的解说\n就可以了吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "91/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是的",
            "narrator_zh": ""
        },
        {
            "location": "92/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "不是",
            "narrator_zh": ""
        },
        {
            "location": "93/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是的",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "千羽鶴",
            "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。",
            "zh": "太好了。\n我也省事了。\n这才是WIN-WIN啊。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "97/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不是",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。\nそれじゃもう１回\n同じ話をする。",
            "zh": "知道了。\n那我就再说\n一遍同样的内容。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "103/TALK",
            "narrator": "千羽鶴",
            "text": "お待ちかねの\n新しいエピソードの\n幕開けです。",
            "zh": "久等的\n新篇章终于\n拉开帷幕了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "104/TALK",
            "narrator": "千羽鶴",
            "text": "そろそろこのアプリにも\n慣れてきたころだと思う。",
            "zh": "我想你也差不多\n习惯这个应用了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "105/TALK",
            "narrator": "千羽鶴",
            "text": "けど、そんな和やかな\n会話の最中に、言わねば\nならないことが、ある！",
            "zh": "不过，就在这祥和的\n对话之中，有一件事\n我必须得说！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "108/TALK",
            "narrator": "千羽鶴",
            "text": "どーん！",
            "zh": "咚！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "109/SEL",
            "narrator": "",
            "text": "…何でしょう",
            "zh": "…是什么事",
            "narrator_zh": ""
        },
        {
            "location": "110/SEL",
            "narrator": "",
            "text": "プロポーズしてくれるの？",
            "zh": "是要向我求婚吗？",
            "narrator_zh": ""
        },
        {
            "location": "111/ACT",
            "narrator": "",
            "text": "…何でしょう",
            "zh": "…是什么事",
            "narrator_zh": ""
        },
        {
            "location": "113/TALK",
            "narrator": "千羽鶴",
            "text": "わたし、さめましたわ。",
            "zh": "我呀，彻底冷下来了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "114/SEL",
            "narrator": "",
            "text": "……回文のつもり？",
            "zh": "……你这是想说回文吗？",
            "narrator_zh": ""
        },
        {
            "location": "115/ACT",
            "narrator": "",
            "text": "……回文のつもり？",
            "zh": "……你这是想说回文吗？",
            "narrator_zh": ""
        },
        {
            "location": "118/TALK",
            "narrator": "千羽鶴",
            "text": "そうしたかったけど\n失敗した。",
            "zh": "我是想写成回文来着，\n但失败了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "119/TALK",
            "narrator": "千羽鶴",
            "text": "これだと、逆さに読むと\nマメを刺してしまう。\nとても痛そう。",
            "zh": "这样的话，倒过来念\n就会变成刺豆子了。\n听起来就很痛。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "120/ACT",
            "narrator": "",
            "text": "プロポーズしてくれるの？",
            "zh": "是要向我求婚吗？",
            "narrator_zh": ""
        },
        {
            "location": "122/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "123/TALK",
            "narrator": "千羽鶴",
            "text": "貴方には、千羽鶴の非攻略\n対象アラーム目覚まし時計\nを代引で送りつけたい。",
            "zh": "真想给你到付寄去一台\n千羽鹤的非攻略对象\n语音闹钟。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "128/TALK",
            "narrator": "千羽鶴",
            "text": "要点だけ言うと、\n千羽鶴は\nだいぶ疲れてきた。",
            "zh": "只说重点的话，\n千羽鹤已经\n相当疲惫了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "129/TALK",
            "narrator": "千羽鶴",
            "text": "貴方とこのアプリを介して\n繋がってから、ずっと私は\n貴方のお世話をしてきた。",
            "zh": "自从通过这个应用与你\n相连以来，我一直都在\n照顾你的各种事务。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "130/TALK",
            "narrator": "千羽鶴",
            "text": "けど、もうそろそろ\n独り立ちの季節だと思う！",
            "zh": "不过，差不多也到了\n你该独立的时候了！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "131/TALK",
            "narrator": "千羽鶴",
            "text": "そこで千羽鶴は、\nモードシフトをする。",
            "zh": "所以千羽鹤要进行\n模式切换了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "132/SEL",
            "narrator": "",
            "text": "どんなモードになるの？",
            "zh": "会变成什么模式？",
            "narrator_zh": ""
        },
        {
            "location": "133/ACT",
            "narrator": "",
            "text": "どんなモードになるの？",
            "zh": "会变成什么模式？",
            "narrator_zh": ""
        },
        {
            "location": "135/TALK",
            "narrator": "千羽鶴",
            "text": "塩対応モード。",
            "zh": "冷淡应对模式。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "138/TALK",
            "narrator": "千羽鶴",
            "text": "塩対応モード！",
            "zh": "冷淡应对模式！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "139/SEL",
            "narrator": "",
            "text": "２回言わなくてもOK",
            "zh": "不用说两遍也OK",
            "narrator_zh": ""
        },
        {
            "location": "140/ACT",
            "narrator": "",
            "text": "２回言わなくてもOK",
            "zh": "不用说两遍也OK",
            "narrator_zh": ""
        },
        {
            "location": "142/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\n適当に記録映像を流して\nおくから、後はよろしく。",
            "zh": "总而言之，\n我会随便把记录影像\n放出来，剩下的交给你了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "143/TALK",
            "narrator": "千羽鶴",
            "text": "前回の続きからだから\n特に説明も要らないと思う。",
            "zh": "因为是接着上一回的，\n我想也不需要特别说明了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "144/SEL",
            "narrator": "",
            "text": "塩対応すぎる！",
            "zh": "应对得太冷淡了吧！",
            "narrator_zh": ""
        },
        {
            "location": "145/ACT",
            "narrator": "",
            "text": "塩対応すぎる！",
            "zh": "应对得太冷淡了吧！",
            "narrator_zh": ""
        },
        {
            "location": "148/SEL",
            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/70MB 4:37】</color>",
            "zh": "观看影像\n<color=green>【高画质/70MB 4:37】</color>",
            "narrator_zh": ""
        },
        {
            "location": "149/SEL",
            "narrator": "",
            "text": "映像を見る\n<color=green>【標準画質/22MB 4:37】</color>",
            "zh": "观看影像\n<color=green>【标准画质/22MB 4:37】</color>",
            "narrator_zh": ""
        },
        {
            "location": "150/SEL",
            "narrator": "",
            "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>",
            "zh": "选择剧情提要报告\n<color=green>【文本汇总】</color>",
            "narrator_zh": ""
        },
        {
            "location": "151/ACT",
            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/70MB 4:37】</color>",
            "zh": "观看影像\n<color=green>【高画质/70MB 4:37】</color>",
            "narrator_zh": ""
        },
        {
            "location": "152/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "158/ACT",
            "narrator": "",
            "text": "映像を見る\n<color=green>【標準画質/22MB 4:37】</color>",
            "zh": "观看影像\n<color=green>【标准画质/22MB 4:37】</color>",
            "narrator_zh": ""
        },
        {
            "location": "159/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "165/ACT",
            "narrator": "",
            "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>",
            "zh": "选择剧情提要报告\n<color=green>【文本汇总】</color>",
            "narrator_zh": ""
        },
        {
            "location": "166/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "167/TALK",
            "narrator": "千羽鶴",
            "text": "残念だけど、いろいろ\n事情があってのことだと\n思うから。",
            "zh": "虽然很遗憾，但想来\n应该也是有各种\n难处吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "168/TALK",
            "narrator": "千羽鶴",
            "text": "家に帰ったら、是非\n映像記録の方も\n見てみて欲しい。",
            "zh": "回家之后，\n请务必也看看\n影像记录那边。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "169/TALK",
            "narrator": "千羽鶴",
            "text": "それではどうぞ。",
            "zh": "那么请看。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "203/TALK",
            "narrator": "千羽鶴",
            "text": "はい、どうでしたか？",
            "zh": "好了，觉得怎么样？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "204/TALK",
            "narrator": "千羽鶴",
            "text": "今回は塩対応モードにつき\n質問は受け付けません。",
            "zh": "本次处于冷淡应对模式，\n不接受任何提问。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "206/SEL",
            "narrator": "",
            "text": "神楽のチャンネルくるー？",
            "zh": "神乐的频道要来了吗——？",
            "narrator_zh": ""
        },
        {
            "location": "207/SEL",
            "narrator": "",
            "text": "今回のフェノメノンはどうなってるの？",
            "zh": "这次的PhenoMENON是怎么回事？",
            "narrator_zh": ""
        },
        {
            "location": "208/SEL",
            "narrator": "",
            "text": "特にない\n<color=blue>（※先へ進みます）</color>",
            "zh": "没什么特别的\n<color=blue>（※继续往下）</color>",
            "narrator_zh": ""
        },
        {
            "location": "209/ACT",
            "narrator": "",
            "text": "神楽のチャンネルくるー？",
            "zh": "神乐的频道要来了吗——？",
            "narrator_zh": ""
        },
        {
            "location": "210/TALK",
            "narrator": "千羽鶴",
            "text": "既にある。\nそれは貴方の心の中に。",
            "zh": "早就有了。\n就在你的心中。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "211/SEL",
            "narrator": "",
            "text": "もちろんあるけど、それって来ないってこと？",
            "zh": "心里当然有，但那意思就是不会有了吗？",
            "narrator_zh": ""
        },
        {
            "location": "212/SEL",
            "narrator": "",
            "text": "それって来ないってこと？",
            "zh": "那意思就是不会有了吗？",
            "narrator_zh": ""
        },
        {
            "location": "213/ACT",
            "narrator": "",
            "text": "もちろんあるけど、それって来ないってこと？",
            "zh": "心里当然有，但那意思就是不会有了吗？",
            "narrator_zh": ""
        },
        {
            "location": "214/TALK",
            "narrator": "千羽鶴",
            "text": "本当にあるのね。",
            "zh": "真的有啊。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "215/TALK",
            "narrator": "千羽鶴",
            "text": "ならば是非とも貴方の\n脳内でタップリと\nイチャイチャして欲しい。",
            "zh": "那请务必在你的\n脑内尽情地\n和她亲热腻歪吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "216/ACT",
            "narrator": "",
            "text": "それって来ないってこと？",
            "zh": "那意思就是不会有了吗？",
            "narrator_zh": ""
        },
        {
            "location": "217/TALK",
            "narrator": "千羽鶴",
            "text": "前向きに検討しております。",
            "zh": "我们正在积极探讨中。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "219/SEL",
            "narrator": "",
            "text": "いや、実際の所どうなの？",
            "zh": "不是，实际上到底怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "220/ACT",
            "narrator": "",
            "text": "いや、実際の所どうなの？",
            "zh": "不是，实际上到底怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "223/TALK",
            "narrator": "千羽鶴",
            "text": "塩対応モードだって\n言ってるのに。",
            "zh": "我都说了我现在是\n冷淡应对模式了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "224/TALK",
            "narrator": "千羽鶴",
            "text": "卯月神楽のチャンネルは\nもちろん枠は\n用意してある。",
            "zh": "卯月神乐的频道\n栏位当然是\n准备好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "225/TALK",
            "narrator": "千羽鶴",
            "text": "けど、何らかの障害が\n発生していて映らないから\n現在原因究明中。",
            "zh": "但不知发生了什么故障\n导致画面无法显示，\n目前正在排查原因。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "226/SEL",
            "narrator": "",
            "text": "それって、神楽黒幕疑惑！？",
            "zh": "难道说，神乐是幕后黑手！？",
            "narrator_zh": ""
        },
        {
            "location": "227/SEL",
            "narrator": "",
            "text": "それって、神楽ラスボス疑惑！？",
            "zh": "难道说，神乐是最终Boss！？",
            "narrator_zh": ""
        },
        {
            "location": "228/ACT",
            "narrator": "",
            "text": "それって、神楽黒幕疑惑！？",
            "zh": "难道说，神乐是幕后黑手！？",
            "narrator_zh": ""
        },
        {
            "location": "229/TALK",
            "narrator": "千羽鶴",
            "text": "んー。\n確かにそれはあるかも。",
            "zh": "嗯——。\n确实有这个可能。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "230/TALK",
            "narrator": "千羽鶴",
            "text": "一人だけ魔女ッ子っぽい\n上に、戦闘力も高いから、\nそうかもしれない。",
            "zh": "就她一个人像魔法少女，\n而且战斗力又那么高，\n说不定真是那样。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "231/SEL",
            "narrator": "",
            "text": "えっと、そういうの、隠す気無いの？",
            "zh": "那个，这种事你都不打算藏一下吗？",
            "narrator_zh": ""
        },
        {
            "location": "232/ACT",
            "narrator": "",
            "text": "えっと、そういうの、隠す気無いの？",
            "zh": "那个，这种事你都不打算藏一下吗？",
            "narrator_zh": ""
        },
        {
            "location": "235/TALK",
            "narrator": "千羽鶴",
            "text": "隠すも何も、\nよくわからないから\n適当に言ってるだけ。",
            "zh": "藏不藏的，\n反正我也不太清楚，\n只是随便说说而已。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "236/TALK",
            "narrator": "千羽鶴",
            "text": "逆に黒幕だと思わせて\nおいて、実は真の勇者は\n彼女だけだったりして。",
            "zh": "搞不好先让人以为她是黑手，\n结果其实真正的勇者\n只有她一个也说不定。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "237/TALK",
            "narrator": "千羽鶴",
            "text": "それとも、彼女だけは\n既に死んでいるとか。",
            "zh": "又或者，其实只有她\n早就已经死了之类的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "238/SEL",
            "narrator": "",
            "text": "どれもありそうで怖い",
            "zh": "感觉哪种都有可能，好可怕",
            "narrator_zh": ""
        },
        {
            "location": "239/SEL",
            "narrator": "",
            "text": "混乱させようとしてる？",
            "zh": "你是想把人搞糊涂吧？",
            "narrator_zh": ""
        },
        {
            "location": "240/ACT",
            "narrator": "",
            "text": "どれもありそうで怖い",
            "zh": "感觉哪种都有可能，好可怕",
            "narrator_zh": ""
        },
        {
            "location": "242/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。この情報が\n錯綜する感覚、まさに\nネット時代って感じ。",
            "zh": "是啊。这种信息\n错综复杂的感觉，\n真有网络时代内味儿了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "243/ACT",
            "narrator": "",
            "text": "混乱させようとしてる？",
            "zh": "你是想把人搞糊涂吧？",
            "narrator_zh": ""
        },
        {
            "location": "245/TALK",
            "narrator": "千羽鶴",
            "text": "まさか。\n寧ろ私が混乱してる。",
            "zh": "怎么会。\n不如说我自己才糊涂着。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "247/TALK",
            "narrator": "千羽鶴",
            "text": "何にせよ、\n早くシステムエラーの\n原因を突き止めないと。",
            "zh": "不管怎样，\n得赶紧查明系统错误的\n原因才行。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "248/ACT",
            "narrator": "",
            "text": "それって、神楽ラスボス疑惑！？",
            "zh": "难道说，神乐是最终Boss！？",
            "narrator_zh": ""
        },
        {
            "location": "249/TALK",
            "narrator": "千羽鶴",
            "text": "それは違う！\n断じて違う！",
            "zh": "那绝不可能！\n绝对不可能！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "250/SEL",
            "narrator": "",
            "text": "断言した！",
            "zh": "说得好肯定！",
            "narrator_zh": ""
        },
        {
            "location": "251/ACT",
            "narrator": "",
            "text": "断言した！",
            "zh": "说得好肯定！",
            "narrator_zh": ""
        },
        {
            "location": "253/TALK",
            "narrator": "千羽鶴",
            "text": "それはそう。\nだって――",
            "zh": "那是当然。\n因为——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "256/TALK",
            "narrator": "千羽鶴",
            "text": "ラスボスは私だから！",
            "zh": "最终Boss是我嘛！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "257/TALK",
            "narrator": "千羽鶴",
            "text": "どーん！",
            "zh": "咚！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "258/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "260/TALK",
            "narrator": "千羽鶴",
            "text": "ごめんなさい。\n反省してる。",
            "zh": "对不起。\n我在反省了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "261/TALK",
            "narrator": "千羽鶴",
            "text": "とにかく私も\n混乱してる状況だから。",
            "zh": "总之我现在也是\n一头雾水的状态。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "262/TALK",
            "narrator": "千羽鶴",
            "text": "早くシステムエラーの\n原因を突き止めないと。",
            "zh": "得赶紧查明系统错误的\n原因才行。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "265/ACT",
            "narrator": "",
            "text": "今回のフェノメノンはどうなってるの？",
            "zh": "这次的PhenoMENON是怎么回事？",
            "narrator_zh": ""
        },
        {
            "location": "267/TALK",
            "narrator": "千羽鶴",
            "text": "今、塩対応モードだって\n言ってるのに。",
            "zh": "我都说了我现在是\n冷淡应对模式了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "268/TALK",
            "narrator": "千羽鶴",
            "text": "今回はWAVEアプリという\nチャットアプリがそのまま\n現実になったもの。",
            "zh": "这次是名为WAVE的应用\n——也就是聊天应用\n直接变成了现实。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "269/TALK",
            "narrator": "千羽鶴",
            "text": "襲ってきてるのは、\nスタンプね。",
            "zh": "袭击她们的，\n是表情包。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "270/TALK",
            "narrator": "千羽鶴",
            "text": "そう、あの可愛かったり\nキモかったりする絵。",
            "zh": "对，就是那些有的可爱\n有的恶心的图片。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "271/TALK",
            "narrator": "千羽鶴",
            "text": "スタンプに\n殺されたりしたら、\nもの凄く惨めかも。",
            "zh": "要是被表情包\n给杀掉的话，\n那可真是太惨了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "272/TALK",
            "narrator": "千羽鶴",
            "text": "そういう意味でも今回は\n負けられないと思う。\n精神的に。",
            "zh": "从这个意义上来说，\n这次也绝对不能输。\n精神层面上。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "274/ACT",
            "narrator": "",
            "text": "特にない\n<color=blue>（※先へ進みます）</color>",
            "zh": "没什么特别的\n<color=blue>（※继续往下）</color>",
            "narrator_zh": ""
        },
        {
            "location": "281/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃ、今回の\n逢瀬つばめについて、\nちゃっちゃと説明する。",
            "zh": "那么，关于这次的\n逢濑燕，我就\n麻利地说明一下。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "282/TALK",
            "narrator": "千羽鶴",
            "text": "色々考えたんだけど、\n今回彼女がバトルに集中\nできるようにするには――",
            "zh": "我想了很多，\n这次要让她能够\n集中精力战斗的话——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "283/TALK",
            "narrator": "千羽鶴",
            "text": "数日前のある出来事で\n彼女をサポートしてあげる\nのが一番良いと判断した。",
            "zh": "我觉得在几天前的某个\n事件中去支援她，\n是最好的做法。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "284/TALK",
            "narrator": "千羽鶴",
            "text": "そこで逢瀬つばめの\nチャンネルでは、数日前、\n入隊時にフォーカスする。",
            "zh": "所以逢濑燕的\n频道，将聚焦于几天前\n她入队的时候。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "285/SEL",
            "narrator": "",
            "text": "入隊時？",
            "zh": "入队的时候？",
            "narrator_zh": ""
        },
        {
            "location": "286/ACT",
            "narrator": "",
            "text": "入隊時？",
            "zh": "入队的时候？",
            "narrator_zh": ""
        },
        {
            "location": "288/TALK",
            "narrator": "千羽鶴",
            "text": "そう。前回の\nドームでの戦いの翌日、\n逢瀬つばめは入隊した。",
            "zh": "是的。上次\n穹顶战的第二天，\n逢濑燕就入队了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "289/TALK",
            "narrator": "千羽鶴",
            "text": "それは記録映像に\nあった通り。",
            "zh": "就和记录影像里\n拍到的一样。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "293/TALK",
            "narrator": "千羽鶴",
            "text": "けど、その入隊手続きは\nある一面においては、少々\n強引に行われた。",
            "zh": "不过，那个入队手续\n从某种角度来看，\n办得稍微有些强硬。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "294/TALK",
            "narrator": "千羽鶴",
            "text": "そして彼女は、\nその日の夜に、その事を\nとても悩むことになる。",
            "zh": "于是她在那天晚上，\n为了这件事\n苦恼了很久。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "297/TALK",
            "narrator": "千羽鶴",
            "text": "貴方はそんな彼女の\n夜のひとときにアクセスし\n彼女のココロを導くの。",
            "zh": "你要接入她那个\n夜晚的片刻时光，\n去引导她的心灵。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "299/TALK",
            "narrator": "千羽鶴",
            "text": "その問題を解消できるか\n否かで、トライナリーの\n戦績は大きく変わる。",
            "zh": "能否解决那个问题，\n将极大改变三重奏的\n战绩。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "300/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、今回も\n彼女のサポートよろしく。",
            "zh": "总而言之，这次也\n拜托你支援她了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "304/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃ、今回の\n國政綾水について、\nちゃっちゃと説明する。",
            "zh": "那么，关于这次的\n国政绫水，我就\n麻利地说明一下。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "305/TALK",
            "narrator": "千羽鶴",
            "text": "色々考えたんだけど、\n今回彼女がバトルに集中\nできるようにするには――",
            "zh": "我想了很多，\n这次要让她能够\n集中精力战斗的话——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "306/TALK",
            "narrator": "千羽鶴",
            "text": "数日前のある出来事で\n彼女をサポートしてあげる\nのが一番良いと判断した。",
            "zh": "我觉得在几天前的某个\n事件中去支援她，\n是最好的做法。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "307/TALK",
            "narrator": "千羽鶴",
            "text": "そこで今回、國政綾水の\nチャンネルでは――",
            "zh": "所以这次，国政绫水的\n频道决定——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "308/TALK",
            "narrator": "千羽鶴",
            "text": "数日前、逢瀬つばめの\n入隊時にフォーカスを\n当てることにした。",
            "zh": "把焦点放在几天前\n逢濑燕入队的\n那个时候。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "309/SEL",
            "narrator": "",
            "text": "つばめの入隊時？",
            "zh": "燕入队的时候？",
            "narrator_zh": ""
        },
        {
            "location": "310/ACT",
            "narrator": "",
            "text": "つばめの入隊時？",
            "zh": "燕入队的时候？",
            "narrator_zh": ""
        },
        {
            "location": "312/TALK",
            "narrator": "千羽鶴",
            "text": "そう。",
            "zh": "是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "314/TALK",
            "narrator": "千羽鶴",
            "text": "記録映像の通り、入隊\n手続きの際に、彼女は東雲\n真幌と共にその場にいた。",
            "zh": "正如记录影像所示，\n办理入队手续时，\n她和东云真幌都在场。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "315/TALK",
            "narrator": "千羽鶴",
            "text": "そしてその後、入隊の件に\n関して東雲真幌と話すの\nだけど――",
            "zh": "而在那之后，她就\n入队的事与东云真幌\n交谈了起来——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "316/TALK",
            "narrator": "千羽鶴",
            "text": "その時、とても心を\nかき乱すような事態に\nなってしまう。",
            "zh": "当时，事态变得\n非常扰乱她的\n心神。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "318/TALK",
            "narrator": "千羽鶴",
            "text": "貴方には、その時の彼女を\n見てもらい、的確に\nサポートしてもらいたい。",
            "zh": "我希望你能看看那时的她，\n并给予她精准的\n支援。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "319/TALK",
            "narrator": "千羽鶴",
            "text": "その問題を解消できるか\n否かで、トライナリーの\n戦績は大きく変わる。",
            "zh": "能否解决那个问题，\n将极大改变三重奏的\n战绩。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "320/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、今回も\n彼女のサポートよろしく。",
            "zh": "总而言之，这次也\n拜托你支援她了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "324/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃ、今回の\nガブリエラについて、\nちゃっちゃと説明する。",
            "zh": "那么，关于这次的\n加布里埃拉，我就\n麻利地说明一下。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "325/TALK",
            "narrator": "千羽鶴",
            "text": "彼女は今回の戦闘に\n非常に大きな不満を\n持っている。",
            "zh": "她对这一次的战斗\n抱有非常强烈的\n不满。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "326/TALK",
            "narrator": "千羽鶴",
            "text": "いえ、寧ろこれは\n今までの蓄積もあっての\nことなんだけど。",
            "zh": "不，倒不如说这是\n一直以来积攒下来的\n结果。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "327/TALK",
            "narrator": "千羽鶴",
            "text": "とにかく、その不満が\n既に無視できないレベルに\nまで大きくなってるの。",
            "zh": "总之，那股不满已经\n膨胀到了无法忽视的\n程度。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "328/TALK",
            "narrator": "千羽鶴",
            "text": "このままでは、彼女の\n働きは非常に悪くなり、\n本人の為にもよくない。",
            "zh": "再这样下去，她的\n表现会变得非常糟糕，\n对她本人也没好处。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "329/TALK",
            "narrator": "千羽鶴",
            "text": "そこで貴方には、戦闘中の\n彼女から不満を聞き出し、\nクリアにしてもらいたい。",
            "zh": "所以我希望你能从\n战斗中的她那里问出不满，\n帮她疏导清楚。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "330/TALK",
            "narrator": "千羽鶴",
            "text": "その問題を解消できるか\n否かで、トライナリーの\n戦績は大きく変わる。",
            "zh": "能否解决那个问题，\n将极大改变三重奏的\n战绩。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "331/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、今回も\n彼女のサポートよろしく。",
            "zh": "总而言之，这次也\n拜托你支援她了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "335/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃ、今回の\n恋ヶ崎みやびについて、\nちゃっちゃと説明する。",
            "zh": "那么，关于这次的\n恋之崎雅，我就\n麻利地说明一下。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "336/TALK",
            "narrator": "千羽鶴",
            "text": "彼女は正直、私にも\n良く解らないことが多くて\n今回もかなり悩んだ。",
            "zh": "说实话，她身上有很多\n连我也不太明白的地方，\n这次我也苦恼了很久。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "337/TALK",
            "narrator": "千羽鶴",
            "text": "そして悩んだ結果、\n普通に彼女の日常生活を\n見てもらうことにした。",
            "zh": "苦恼之后的结果就是，\n决定让你正常看看\n她的日常生活。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "338/SEL",
            "narrator": "",
            "text": "え！？",
            "zh": "诶！？",
            "narrator_zh": ""
        },
        {
            "location": "339/ACT",
            "narrator": "",
            "text": "え！？",
            "zh": "诶！？",
            "narrator_zh": ""
        },
        {
            "location": "341/TALK",
            "narrator": "千羽鶴",
            "text": "だって仕方ないでしょう？",
            "zh": "那也没办法吧？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "342/TALK",
            "narrator": "千羽鶴",
            "text": "彼女には今、特に何か\nサポートしなければ\nならない問題が無い。",
            "zh": "她现在并没有什么\n特别需要去\n支援的问题。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "343/TALK",
            "narrator": "千羽鶴",
            "text": "とは言っても、彼女だけ\n「今回はナシ」って\n言ったら怒るでしょ？",
            "zh": "话虽如此，要是唯独说\n「这次没有她的戏份」，\n她肯定会生气的吧？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "344/SEL",
            "narrator": "",
            "text": "そりゃそうだ！",
            "zh": "那倒也是！",
            "narrator_zh": ""
        },
        {
            "location": "345/SEL",
            "narrator": "",
            "text": "まあ、それならそれで",
            "zh": "嘛，那样倒也行",
            "narrator_zh": ""
        },
        {
            "location": "346/ACT",
            "narrator": "",
            "text": "そりゃそうだ！",
            "zh": "那倒也是！",
            "narrator_zh": ""
        },
        {
            "location": "347/TALK",
            "narrator": "千羽鶴",
            "text": "良かった。\n見繕う作業が\n無駄にならなくて。",
            "zh": "太好了。\n省得我一番挑选\n白费功夫。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "348/ACT",
            "narrator": "",
            "text": "まあ、それならそれで",
            "zh": "嘛，那样倒也行",
            "narrator_zh": ""
        },
        {
            "location": "349/TALK",
            "narrator": "千羽鶴",
            "text": "淡泊。",
            "zh": "真冷淡。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "350/TALK",
            "narrator": "千羽鶴",
            "text": "今流行の「ホトケ男子」？\nいや「ホトケ女子」かも。",
            "zh": "现在流行的「佛系男子」？\n不，也许是「佛系女子」吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "351/TALK",
            "narrator": "千羽鶴",
            "text": "まあ、貴方のことなんて\nどうでもいい。",
            "zh": "算了，你的事怎样\n都无所谓。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "353/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、彼女の\n日常生活を\nお楽しみください。",
            "zh": "总而言之，请尽情\n欣赏她的\n日常生活吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "354/TALK",
            "narrator": "千羽鶴",
            "text": "とはいえ、何もないのに\n彼女の生活を映したら、\nそれは単なる盗撮。",
            "zh": "话虽如此，平白无故地\n把她的生活放出来，\n那不就成了纯粹的偷拍。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "355/TALK",
            "narrator": "千羽鶴",
            "text": "そこで今回は、\n直接戦闘に関係\nないことだけど――",
            "zh": "所以这一次，\n虽然和战斗没有\n直接关系——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "356/TALK",
            "narrator": "千羽鶴",
            "text": "私が彼女について、少々\n気になってることについて\nスポットを当ててみた。",
            "zh": "我把焦点放在了\n我个人对她稍微有些\n在意的事情上。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "357/SEL",
            "narrator": "",
            "text": "気になってること？",
            "zh": "在意的事情？",
            "narrator_zh": ""
        },
        {
            "location": "358/ACT",
            "narrator": "",
            "text": "気になってること？",
            "zh": "在意的事情？",
            "narrator_zh": ""
        },
        {
            "location": "360/TALK",
            "narrator": "千羽鶴",
            "text": "ええ。",
            "zh": "是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "361/TALK",
            "narrator": "千羽鶴",
            "text": "まあ、それが私の杞憂で、\n実際には何も無ければ\nそれでもよし。",
            "zh": "嘛，如果那只是我杞人忧天，\n实际上什么事都没发生，\n那也挺好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "362/TALK",
            "narrator": "千羽鶴",
            "text": "予想通り何かあっても、\n貴方がサポートして\nくれればそれでよし。",
            "zh": "就算真像我预料的那样\n出了什么事，只要你去\n支援她也就行了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "363/TALK",
            "narrator": "千羽鶴",
            "text": "…そんな感じ？",
            "zh": "…大概就这种感觉？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "364/SEL",
            "narrator": "",
            "text": "どんな感じっすか…",
            "zh": "到底是哪种感觉啊……",
            "narrator_zh": ""
        },
        {
            "location": "365/ACT",
            "narrator": "",
            "text": "どんな感じっすか…",
            "zh": "到底是哪种感觉啊……",
            "narrator_zh": ""
        },
        {
            "location": "367/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、今回も\n彼女のサポートよろしく。",
            "zh": "总而言之，这次也\n拜托你支援她了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "369/SEL",
            "narrator": "",
            "text": "頑張ります！",
            "zh": "我会加油的！",
            "narrator_zh": ""
        },
        {
            "location": "370/SEL",
            "narrator": "",
            "text": "塩対応といいつつ、ちゃんと説明する千羽鶴かわいい",
            "zh": "嘴上说着冷淡应对，结果还是老老实实解释了一通的千羽鹤好可爱",
            "narrator_zh": ""
        },
        {
            "location": "371/ACT",
            "narrator": "",
            "text": "頑張ります！",
            "zh": "我会加油的！",
            "narrator_zh": ""
        },
        {
            "location": "372/ACT",
            "narrator": "",
            "text": "塩対応といいつつ、ちゃんと説明する千羽鶴かわいい",
            "zh": "嘴上说着冷淡应对，结果还是老老实实解释了一通的千羽鹤好可爱",
            "narrator_zh": ""
        },
        {
            "location": "375/TALK",
            "narrator": "千羽鶴",
            "text": "…！？",
            "zh": "…！？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "376/TALK",
            "narrator": "千羽鶴",
            "text": "理解不能。",
            "zh": "无法理解。",
            "narrator_zh": "千羽鹤"
        },
        {
