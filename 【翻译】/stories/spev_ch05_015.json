        {
            "location": "265/TALK",
            "narrator": "神楽",
            "text": "それじゃ、ぴょんこのチョコはいらないよね",
            "zh": "既然这样，蹦子的巧克力也就不需要了吧",
            "narrator_zh": "神乐"
