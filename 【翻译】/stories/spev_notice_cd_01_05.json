{
    "dir": "chap00/daydra/spev_notice_cd_01_05.js",
    "type": "",
    "info": {
        "story_id": "91055",
        "cid": "",
        "title": "005 アフターストーリー",
        "sub_title": "ガブリエラの思い出",
        "title_zh": "005 后日谈",
        "sub_title_zh": "加布里埃拉的回忆"
    },
    "entry": [
        {
            "location": "1326/DIALOG",
            "narrator": "",
            "text": "<color=green>某月某日　5:16 PM</color>\nとある平日の放課後、神楽坂トライナリー楽屋にて。",
            "zh": "<color=green>某月某日　5:16 PM</color>\n某个工作日的放学后，在神乐坂三重奏后台。",
            "narrator_zh": ""
        },
        {
            "location": "1327/TALK",
            "narrator": "真幌",
            "text": "ギャヴィ。\nおまえが置こうとしている\nテーブルだが…。",
            "zh": "加维。\n你打算放进来的\n那张桌子啊……",
            "narrator_zh": "真幌"
        },
        {
            "location": "1328/TALK",
            "narrator": "真幌",
            "text": "さすがに高過ぎる。\nもっと安いのに変えろ。",
            "zh": "实在太贵了。\n换一张便宜点的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "1330/TALK",
            "narrator": "ガブリエラ",
            "text": "モダン和風で\n統一するんだから、\nこれくらい仕方ないのよ。",
            "zh": "因为要统一成\n现代和风嘛，\n这种程度也是没办法的呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1331/TALK",
            "narrator": "真幌",
            "text": "もっと安く手に入る\nレプリカじゃダメなのか？",
            "zh": "用更便宜就能买到的\n仿制品不行吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "1334/TALK",
            "narrator": "ガブリエラ",
            "text": "レプリカなんかじゃ\n安っぽくなっちゃう\nでしょ？",
            "zh": "用仿制品什么的\n不就会显得\n很廉价了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1335/TALK",
            "narrator": "神楽",
            "text": "うーん…。",
            "zh": "唔——……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1336/TALK",
            "narrator": "神楽",
            "text": "…そうだ。\n全く同じとはいかないかも\nしれませんけど…。",
            "zh": "……对了。\n虽然可能没法做到\n一模一样……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1337/TALK",
            "narrator": "神楽",
            "text": "似たようなのがありそうな\nお店を知っているんで、\n一度行ってみませんか？",
            "zh": "但我知道一家店，说不定\n会有差不多的款式，\n要不要去看看？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1338/TALK",
            "narrator": "ガブリエラ",
            "text": "…いいけど。",
            "zh": "……行吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1340/TALK",
            "narrator": "神楽",
            "text": "大丈夫ですよ。\nきっと、気に入るモノが\n見つかりますから…。",
            "zh": "没问题的。\n一定能找到\n合你心意的款式的……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1352/TALK",
            "narrator": "ガブリエラ",
            "text": "へぇ…思ったより\n悪くない品揃えね。",
            "zh": "哎呀……比我想象中\n货品还要齐全嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1354/TALK",
            "narrator": "神楽",
            "text": "このショッピングセンター\nに、本を買いに来たときに\n見つけたんです。",
            "zh": "之前我来这家购物中心\n买书的时候，\n顺便发现的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1355/TALK",
            "narrator": "神楽",
            "text": "ここのお店、オシャレな\n家具が沢山揃ってるん\nですよ。",
            "zh": "这家店里，\n摆了好多时髦的\n家具哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1357/TALK",
            "narrator": "神楽",
            "text": "あ、ガブちゃん。\nこのテーブル、さっきのに\nそっくりじゃないですか？",
            "zh": "啊，加布。\n这张桌子，是不是跟\n刚才那张特别像？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1359/TALK",
            "narrator": "ガブリエラ",
            "text": "うそっ！？\nあたしが見つけたのより\n全然安いわ！",
            "zh": "不会吧！？\n比我找到的那张\n便宜了好多！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1360/TALK",
            "narrator": "神楽",
            "text": "レプリカですからね。\nでも、そんな風には\n見えないでしょう？",
            "zh": "毕竟是仿制品嘛。\n不过，完全\n看不出来吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1362/TALK",
            "narrator": "ガブリエラ",
            "text": "…侮ってたわ。\nこんなクオリティ高いのが\nあったなんて…。",
            "zh": "……是我小看它了。\n居然还有\n品质这么高的货……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1364/TALK",
            "narrator": "神楽",
            "text": "どうですか？\nこれなら十分代わりに\nなると思うんですけど…。",
            "zh": "怎么样？\n这样的话，我觉得\n完全足够拿来替代了……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1368/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、問題ないわ。\nいいお店教えてくれて\n助かったわ。",
            "zh": "嗯，没问题。\n多亏你告诉我这家好店，\n真是帮大忙了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1372/TALK",
            "narrator": "神楽",
            "text": "じゃあ、早速真幌さんに\n連絡しますね。",
            "zh": "那我就马上\n联系真幌咯。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1386/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぅ…まほからも\nＯＫの連絡もらえたし、\nこれで一安心だわ。",
            "zh": "呼……真幌那边也\n回复同意了，\n这下总算安心了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1387/TALK",
            "narrator": "神楽",
            "text": "椅子とテーブルがないと、\nお店が始まりません\nからね。",
            "zh": "毕竟没有桌椅的话，\n店也开不起来\n嘛。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1388/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね…本当助かったわ。\nありがと…。",
            "zh": "是啊……真的帮大忙了。\n谢谢……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1389/TALK",
            "narrator": "神楽",
            "text": "力になれたなら、\n何よりです。",
            "zh": "能帮上忙，\n比什么都好。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1390/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1391/TALK",
            "narrator": "神楽",
            "text": "ガブちゃん？",
            "zh": "加布？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1392/TALK",
            "narrator": "ガブリエラ",
            "text": "あのさ、こういうの\nそろそろ終わりにしない？",
            "zh": "那个啊，这种样子\n差不多该到此为止了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1394/TALK",
            "narrator": "神楽",
            "text": "…ごめんなさい。\n余計なこと言って、\n連れ出すようなマネを――",
            "zh": "……对不起。\n说了多余的话，\n还做出把你拉出来这种事——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1395/TALK",
            "narrator": "ガブリエラ",
            "text": "ち、違う違う！\nなにバカなこと\n言い出すのよ！？",
            "zh": "不、不对不对！\n你怎么突然说出\n这种傻话啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1397/TALK",
            "narrator": "神楽",
            "text": "ち、違うんですか？\nそれじゃやっぱり、\n私と一緒にいるのが……",
            "zh": "不、不对吗？\n那果然还是\n跟我待在一起……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1398/TALK",
            "narrator": "ガブリエラ",
            "text": "…あんたさ、\nいい加減にしなさいよ？",
            "zh": "……我说你啊，\n差不多该适可而止了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1399/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしもみんなも、\nそのことはもういいって\n言ったでしょ？",
            "zh": "不管是大家还是我，\n不是都已经说过\n那件事翻篇了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1400/TALK",
            "narrator": "ガブリエラ",
            "text": "いいって言ってんだから、\nいつまでもズルズル\n引きずらないでよね？",
            "zh": "既然都说了翻篇了，\n就别再没完没了地\n往心里拖着了好吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1402/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "神乐"
        },
        {
            "location": "1403/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしが言おうとして\nたのは…神楽の態度よ。",
            "zh": "……我本来想说的……\n是神乐你的态度啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1404/TALK",
            "narrator": "ガブリエラ",
            "text": "いつまでも、なんとなく\n他人行儀な感じで\n接してくるところ…。",
            "zh": "老是像这样，莫名\n摆出一副见外的样子\n跟我们相处……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1405/TALK",
            "narrator": "ガブリエラ",
            "text": "ぶっちゃけ、\nあまりいい気しないわ。",
            "zh": "说实话，\n心里很不是滋味啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1406/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "神乐"
        },
        {
            "location": "1407/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、今すぐ変えろとは\n言わないけど…。",
            "zh": "嘛，虽然也不是叫你\n立刻就改过来……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1408/TALK",
            "narrator": "ガブリエラ",
            "text": "他人行儀な感じなのは、\nできるだけ早いとこ\n直してよね？",
            "zh": "但那副见外的样子，\n还是尽可能早点\n改掉好不好？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1409/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽だって…その…。",
            "zh": "毕竟神乐你也是……那个……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1410/TALK",
            "narrator": "ガブリエラ",
            "text": "…友達なんだから。",
            "zh": "……我们的朋友嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1412/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "神乐"
        },
        {
            "location": "1414/TALK",
            "narrator": "ガブリエラ",
            "text": "だ、黙ってないで、\n返事くらいしなさい！",
            "zh": "别、别光顾着沉默，\n好歹回句话呀！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1415/TALK",
            "narrator": "神楽",
            "text": "…わかりました。\nありがとう、ガブちゃん。",
            "zh": "……我知道了。\n谢谢你，加布。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1416/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そう…。\nわかればいいのよ…。",
            "zh": "是、是吗……\n你明白就好……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1417/TALK",
            "narrator": "ガブリエラ",
            "text": "と、とにかく！\n今日の買い物で大きい物は\n揃ったことだし…。",
            "zh": "总、总之！\n今天出来采购，\n大件物品都买齐了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1418/TALK",
            "narrator": "ガブリエラ",
            "text": "あとは細々したモノを\n揃えれば、\n開店に間に合うわ。",
            "zh": "接下来只要把零零碎碎的\n东西凑齐，\n就能赶上开店了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1419/TALK",
            "narrator": "神楽",
            "text": "あれ？　それじゃあ、\nガブちゃんはもう、\n食器を決めたんですか？",
            "zh": "咦？那这么说，\n加布你已经\n决定好餐具了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1420/TALK",
            "narrator": "ガブリエラ",
            "text": "え？　あっ！！",
            "zh": "诶？　啊！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1421/TALK",
            "narrator": "ガブリエラ",
            "text": "インテリアのことで\n頭いっぱいだったから、\n忘れてたわ…。",
            "zh": "光顾着想\n装潢的事，\n全给忘掉了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1422/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽はもう決めたの？",
            "zh": "神乐已经定好了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1424/TALK",
            "narrator": "神楽",
            "text": "二つの候補があって、\nどっちにするか\n悩み中です。",
            "zh": "我有两个备选，\n还在纠结到底\n选哪一个好。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1425/TALK",
            "narrator": "ガブリエラ",
            "text": "そっか…。\nあたし、何にしよう\nかしら…？",
            "zh": "这样啊……\n我该选什么\n才好呢……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1431/TALK",
            "narrator": "ガブリエラ",
            "text": "意外と難しいわ",
            "zh": "意外地好难选啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1432/TALK",
            "narrator": "ガブリエラ",
            "text": "自分で作ったロゴを",
            "zh": "我自己设计的logo",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1433/TALK",
            "narrator": "ガブリエラ",
            "text": "どの食器に付けたらいいかしら？",
            "zh": "印在什么餐具上好呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1435/SEL",
            "narrator": "（選択肢）",
            "text": "とにかく大きいお皿がいい",
            "zh": "总之用大盘子好",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1436/SEL",
            "narrator": "（選択肢）",
            "text": "小さいお皿とかは？",
            "zh": "小盘子之类的呢？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1437/SEL",
            "narrator": "（選択肢）",
            "text": "ランチプレートは？",
            "zh": "午餐餐盘怎么样？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1438/ACT",
            "narrator": "",
            "text": "とにかく大きいお皿がいい",
            "zh": "总之用大盘子好",
            "narrator_zh": ""
        },
        {
            "location": "1439/TALK",
            "narrator": "ガブリエラ",
            "text": "言い方！",
            "zh": "什么叫法啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1440/TALK",
            "narrator": "ガブリエラ",
            "text": "パスタ用のお皿とかもいいかと思ったけど",
            "zh": "虽然我也想过意面盘之类的也不错",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1441/TALK",
            "narrator": "ガブリエラ",
            "text": "今ので気が変わったわ",
            "zh": "但听你这么一说我又改变主意了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1444/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1445/TALK",
            "narrator": "ガブリエラ",
            "text": "お皿はいいチョイスだと思うわ",
            "zh": "我觉得选盘子确实是个好主意",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1446/ACT",
            "narrator": "",
            "text": "小さいお皿とかは？",
            "zh": "小盘子之类的呢？",
            "narrator_zh": ""
        },
        {
            "location": "1447/TALK",
            "narrator": "ガブリエラ",
            "text": "へえ",
            "zh": "哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1448/TALK",
            "narrator": "ガブリエラ",
            "text": "中々素敵なチョイスね",
            "zh": "蛮不错的选择嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1449/ACT",
            "narrator": "",
            "text": "ランチプレートは？",
            "zh": "午餐餐盘怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "1450/TALK",
            "narrator": "ガブリエラ",
            "text": "ランチプレートはやらないと思うわ",
            "zh": "我觉得店里应该不会用午餐餐盘",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1451/TALK",
            "narrator": "ガブリエラ",
            "text": "倉庫にあった食器の中に",
            "zh": "仓库里翻出来的餐具里",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1452/TALK",
            "narrator": "ガブリエラ",
            "text": "ランチプレートなんて入ってなかったし",
            "zh": "压根也没有午餐餐盘",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1455/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ",
            "zh": "不过嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1456/TALK",
            "narrator": "ガブリエラ",
            "text": "ランチプレートではないけれど",
            "zh": "虽然不是午餐餐盘",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1457/TALK",
            "narrator": "ガブリエラ",
            "text": "お皿とかいいかもしれないわね",
            "zh": "但选盘子或许挺不错的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1458/TALK",
            "narrator": "ガブリエラ",
            "text": "大きいのじゃなくて",
            "zh": "不是大的那种",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1459/TALK",
            "narrator": "ガブリエラ",
            "text": "ケーキをのせられるくらいの大きさのとか",
            "zh": "像能放蛋糕的那种大小之类的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1461/TALK",
            "narrator": "ガブリエラ",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1462/TALK",
            "narrator": "ガブリエラ",
            "text": "決めたわ",
            "zh": "决定了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1463/TALK",
            "narrator": "ガブリエラ",
            "text": "私は小さいお皿にするってみんなに言うわ",
            "zh": "我去跟大家说我选小盘子",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1465/SEL",
            "narrator": "（選択肢）",
            "text": "決定？",
            "zh": "确定了？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1466/ACT",
            "narrator": "",
            "text": "決定？",
            "zh": "确定了？",
            "narrator_zh": ""
        },
        {
            "location": "1468/TALK",
            "narrator": "ガブリエラ",
            "text": "決定よ",
            "zh": "确定了哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1474/TALK",
            "narrator": "ガブリエラ",
            "text": "…決めた。\n小さいお皿にするわ。",
            "zh": "……决定了。\n我选小盘子。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1477/TALK",
            "narrator": "神楽",
            "text": "えっ、\nもう決めたんですか！？",
            "zh": "诶，\n这就决定了吗！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1478/TALK",
            "narrator": "ガブリエラ",
            "text": "まあね…。カフェで\n出てくる、素敵な柄の\n小皿があるでしょ？",
            "zh": "算是吧……咖啡馆里\n不是常会端出来那种\n花纹很精致的小碟吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1479/TALK",
            "narrator": "神楽",
            "text": "ああ、クッキーとかが\n紅茶の添え物として\n出される時のような？",
            "zh": "啊啊，就像端红茶时\n把曲奇之类的当配点\n端出来那种吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1480/TALK",
            "narrator": "ガブリエラ",
            "text": "そうそう。",
            "zh": "对对。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1481/TALK",
            "narrator": "ガブリエラ",
            "text": "あれ、あたしがまだ\n小さい頃だったかしら？",
            "zh": "那还是我\n很小的时候吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1482/TALK",
            "narrator": "ガブリエラ",
            "text": "初めて和食を食べたときも\nそういうのが出てきたん\nだけど…。",
            "zh": "第一次吃和食的时候\n也端上来过\n那种碟子……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1483/TALK",
            "narrator": "ガブリエラ",
            "text": "その時のお皿が、\nビックリするくらい\n素敵だったの。",
            "zh": "那时候用的盘子，\n漂亮到\n吓了我一跳。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1484/TALK",
            "narrator": "神楽",
            "text": "そんなに素敵な\nお皿だったんですか？",
            "zh": "竟然是那么好看的\n盘子吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1485/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、あんまりにも\n素敵だったから…。",
            "zh": "嗯，因为实在\n太好看了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1486/TALK",
            "narrator": "ガブリエラ",
            "text": "家の白いお皿に、\n同じ模様を描こうとして\n怒られたっけ…。",
            "zh": "我还想在自家的白盘子上\n照着画一样的花纹，\n结果被训了一顿呢……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1487/TALK",
            "narrator": "神楽",
            "text": "ふふっ、可愛らしい\n思い出ですね。",
            "zh": "呵呵，真是可爱的\n回忆呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1488/TALK",
            "narrator": "ガブリエラ",
            "text": "か、可愛らしくなんか\nないわよ！",
            "zh": "才、才不可爱\n好不好！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1489/TALK",
            "narrator": "神楽",
            "text": "…きっと、\n素敵なお皿になると\n思いますよ。",
            "zh": "……我觉得一定能做出\n非常漂亮的\n盘子的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1491/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうね。\nそうなってくれると、\n嬉しいわ",
            "zh": "……是啊。\n要是真能那样，\n我会很开心的",
            "narrator_zh": "加布里埃拉"
        }
    ]
}
