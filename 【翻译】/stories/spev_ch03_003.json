            "location": "164/TALK",
            "narrator": "透明アーヤ",
            "text": "見つけた。\nこんなところに\n座ってたのね。",
            "zh": "找到你了。\n原来你坐到\n这种地方来了呀。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "166/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あ、うん。\nちょっと歩き疲れ\nちゃってね。",
            "zh": "啊，嗯。\n走得有点累\n了嘛。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "170/TALK",
            "narrator": "透明アーヤ",
            "text": "…そういえば、\nさっきは焼きそば\n食べてなかった？",
            "zh": "……说起来，\n你刚才不是在吃\n炒面吗？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "171/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そりゃね。\nお祭りに来たら\n食べなくちゃ。",
            "zh": "那当然。\n都来祭典了\n肯定得吃呀。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "172/TALK",
            "narrator": "透明アーヤ",
            "text": "お好み焼きと\nたこ焼きとかも\n食べてたわね？",
            "zh": "大阪烧还有\n章鱼小丸子什么的\n也吃了吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "173/TALK",
            "narrator": "透明ガブリエラ",
            "text": "かき氷とかも\n食べたわ。",
            "zh": "刨冰什么的\n也吃了哦。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "174/TALK",
            "narrator": "透明アーヤ",
            "text": "…食べ過ぎじゃない？",
            "zh": "……不会吃太多了吗？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "176/TALK",
            "narrator": "透明ガブリエラ",
            "text": "屋台の食べ物は、\nお祭りじゃないと\n食べれないでしょ？",
            "zh": "摊位上的东西，\n不趁着祭典\n就吃不到吧？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "177/TALK",
            "narrator": "透明ガブリエラ",
            "text": "アーヤは\n食べないの？",
            "zh": "绫水\n不吃吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "178/TALK",
            "narrator": "透明アーヤ",
            "text": "私はもういいわ。\nとりあえず\n満足したし。",
            "zh": "我就不用了。\n暂时已经\n吃满足了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "179/TALK",
            "narrator": "透明ガブリエラ",
            "text": "勿体ないわねぇ。\nせっかくの\nお祭りなんだし――",
            "zh": "真可惜呀。\n难得来一趟\n祭典嘛——",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "180/TALK",
            "narrator": "透明ガブリエラ",
            "text": "もっと食べれば\nいいのに。",
            "zh": "多吃点\n才好嘛。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "181/TALK",
            "narrator": "透明アーヤ",
            "text": "うーん、\nそう言われても…。",
            "zh": "唔……\n就算你这么说……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "182/TALK",
            "narrator": "透明アーヤ",
            "text": "あ、それじゃあ。",
            "zh": "啊，那这样好了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "184/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あっ！",
            "zh": "啊！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "192/TALK",
            "narrator": "透明アーヤ",
            "text": "んっ、\n甘くて美味しいわ。",
            "zh": "嗯，\n甜甜的，挺好吃。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "194/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ちょ、アーヤ！\n勝手に食べないでよ！",
            "zh": "喂、绫水！\n别擅自吃我的呀！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "透明アーヤ",
            "text": "ふふっ、見てたら\n食べたくなっちゃった\nのよ。",
            "zh": "呵呵，看着你吃\n我就也想尝尝\n了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "196/TALK",
            "narrator": "透明アーヤ",
            "text": "それに、綿あめって\n丸々一つだと私には\n多過ぎるから。",
            "zh": "而且，棉花糖\n一整团对我来说\n实在太多了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "197/TALK",
            "narrator": "透明ガブリエラ",
            "text": "もぅ…。",
            "zh": "真是的……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "透明アーヤ",
            "text": "ごちそうさまでした。\nじゃあ、ちょっと\n屋台見てくるわ。",
            "zh": "多谢款待。\n那我去那边\n逛逛摊位了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "203/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "204/TALK",
            "narrator": "透明ガブリエラ",
            "text": "綿あめ食べた時の\nアーヤ…ちょっと、\n可愛かったかも…。",
            "zh": "吃棉花糖时候的\n绫水……稍微，\n有点可爱呢……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "206/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…もう一口くらい、\nあげてもよかった\nのに…。",
            "zh": "……其实再分她一口，\n也没什么\n不可以嘛……",
            "narrator_zh": "透明加布里埃拉"
        }
    ]
}
