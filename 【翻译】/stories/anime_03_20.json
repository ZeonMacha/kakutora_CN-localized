        "sub_title_zh": "EXE_GARBiELa"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "アニメ第20話",
            "zh": "动画第20话",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "千羽鶴",
            "text": "ごきげんよう。\n今週はガブリエラ\n強化月間。",
            "zh": "贵安。\n本周是加布里埃拉\n强化月。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "48/TALK",
            "narrator": "千羽鶴",
            "text": "MV回だから、\nガブリエラのMVを\n再生するだけにしていい？",
            "zh": "因为是MV回，\n只播放加布里埃拉的\nMV可以吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "49/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "50/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "否",
            "narrator_zh": ""
        },
        {
            "location": "51/SEL",
            "narrator": "",
            "text": "MVの再生すら不要",
            "zh": "连MV也不用放",
            "narrator_zh": ""
        },
        {
            "location": "52/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "54/TALK",
            "narrator": "千羽鶴",
            "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。",
            "zh": "太好了。\n我也省事。\n这正是WIN-WIN呢。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "56/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "否",
            "narrator_zh": ""
        },
        {
            "location": "57/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "我知道了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "59/ACT",
            "narrator": "",
            "text": "MVの再生すら不要",
            "zh": "连MV也不用放",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "千羽鶴",
            "text": "そう。\nそれじゃここでお別れね。",
            "zh": "是吗。\n那就在这里告别了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "62/TALK",
            "narrator": "千羽鶴",
            "text": "また今度。",
            "zh": "下次见。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "67/TALK",
            "narrator": "千羽鶴",
            "text": "ごきげんよう。",
            "zh": "贵安。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "68/SEL",
            "narrator": "",
            "text": "前のノリに戻った！？",
            "zh": "变回以前的腔调了！？",
            "narrator_zh": ""
        },
        {
            "location": "69/ACT",
            "narrator": "",
            "text": "前のノリに戻った！？",
            "zh": "变回以前的腔调了！？",
            "narrator_zh": ""
        },
        {
            "location": "71/TALK",
            "narrator": "千羽鶴",
            "text": "そう。今回は\nガブリエラMV回だから。",
            "zh": "是的。这次是\n加布里埃拉MV回嘛。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "72/TALK",
            "narrator": "千羽鶴",
            "text": "日本古来の戦が\nそうしていたように、\n何事にも合意休戦は必要。",
            "zh": "就像日本古代的战争\n那样，凡事都需要\n合意休战。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "73/TALK",
            "narrator": "千羽鶴",
            "text": "今回貴方には、何ひとつ\n構えることなくMVを楽しん\nで欲しいと思ってる。",
            "zh": "这次我希望你\n毫无防备地\n好好享受MV。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "74/TALK",
            "narrator": "千羽鶴",
            "text": "だから大道具を\n以前のものに戻してみた。",
            "zh": "所以大道具也\n试着换回以前的样子了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "75/SEL",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "76/SEL",
            "narrator": "",
            "text": "そもそも戦ってません",
            "zh": "本来就没有在战斗吧",
            "narrator_zh": ""
        },
        {
            "location": "77/ACT",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "78/ACT",
            "narrator": "",
            "text": "そもそも戦ってません",
            "zh": "本来就没有在战斗吧",
            "narrator_zh": ""
        },
        {
            "location": "79/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。",
            "zh": "原来如此。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "81/TALK",
            "narrator": "千羽鶴",
            "text": "そういうわけだから、\n今回は心をカラッポにして\n彼女を堪能して欲しい。",
            "zh": "所以说，\n这次希望你放空大脑\n尽情品味她。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "82/SEL",
            "narrator": "",
            "text": "はーい",
            "zh": "好——",
            "narrator_zh": ""
        },
        {
            "location": "83/SEL",
            "narrator": "",
            "text": "ガブちゃんは天使！",
            "zh": "加布是天使！",
            "narrator_zh": ""
        },
        {
            "location": "84/SEL",
            "narrator": "",
            "text": "いやいや無理でしょ",
            "zh": "不不，不可能的吧",
            "narrator_zh": ""
        },
        {
            "location": "85/ACT",
            "narrator": "",
            "text": "はーい",
            "zh": "好——",
            "narrator_zh": ""
        },
        {
            "location": "86/TALK",
            "narrator": "千羽鶴",
            "text": "いい子。",
            "zh": "乖孩子。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "87/ACT",
            "narrator": "",
            "text": "ガブちゃんは天使！",
            "zh": "加布是天使！",
            "narrator_zh": ""
        },
        {
            "location": "88/TALK",
            "narrator": "千羽鶴",
            "text": "そ、そうね…。",
            "zh": "说、说得也是……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "89/ACT",
            "narrator": "",
            "text": "いやいや無理でしょ",
            "zh": "不不，不可能的吧",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "千羽鶴",
            "text": "先を急ぎたいのはわかる。\nでも、息抜きも必要。",
            "zh": "我知道你想赶进度。\n不过，喘口气也很重要。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "91/TALK",
            "narrator": "千羽鶴",
            "text": "ちゃんと息抜きしないと\n精神的に滅入ってしまい\n帰って来れなくなる。",
            "zh": "不好好喘口气的话，\n精神上会垮掉\n再也回不来的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "92/SEL",
            "narrator": "",
            "text": "それは言い過ぎでは？",
            "zh": "这未免说得太夸张了吧？",
            "narrator_zh": ""
        },
        {
            "location": "93/SEL",
            "narrator": "",
            "text": "ここから先、そんなに凄いの…？",
            "zh": "往后的剧情，有那么厉害吗……？",
            "narrator_zh": ""
        },
        {
            "location": "94/ACT",
            "narrator": "",
            "text": "それは言い過ぎでは？",
            "zh": "这未免说得太夸张了吧？",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "千羽鶴",
            "text": "それはどうかしら。",
            "zh": "那可不好说。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "96/TALK",
            "narrator": "千羽鶴",
            "text": "是非とも貴方の無限に\n広がる想像の海で、色んな\n想いを馳せてみて欲しい。",
            "zh": "还请你务必在自己\n无限广阔的想象之海里，\n尽情驰骋思绪。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "97/ACT",
            "narrator": "",
            "text": "ここから先、そんなに凄いの…？",
            "zh": "往后的剧情，有那么厉害吗……？",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "99/TALK",
            "narrator": "千羽鶴",
            "text": "確かに言い過ぎたかも。",
            "zh": "确实可能说得太过了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "101/TALK",
            "narrator": "千羽鶴",
            "text": "いずれにせよ、\n今回は掛け値無しに、\nビックリ企画はない。",
            "zh": "不管怎样，\n这次实打实地\n没有惊喜企划。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "102/TALK",
            "narrator": "千羽鶴",
            "text": "だからホントに\nリラックスして\n楽しんで欲しい。",
            "zh": "所以真的\n放轻松\n享受就好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "104/TALK",
            "narrator": "千羽鶴",
            "text": "ちなみに、今回は\nポエムもナシで。",
            "zh": "顺便一提，这次\n也没有诗朗诵。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "105/SEL",
            "narrator": "",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": ""
        },
        {
            "location": "106/SEL",
            "narrator": "",
            "text": "えー",
            "zh": "诶——",
            "narrator_zh": ""
        },
        {
            "location": "107/ACT",
            "narrator": "",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": ""
        },
        {
            "location": "108/TALK",
            "narrator": "千羽鶴",
            "text": "無い事は想定済みと。\n酷い反応。",
            "zh": "早料到没有了吗。\n好过分的反应。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "109/ACT",
            "narrator": "",
            "text": "えー",
            "zh": "诶——",
            "narrator_zh": ""
        },
        {
            "location": "110/TALK",
            "narrator": "千羽鶴",
            "text": "また書けと。\n酷い仕打ち。",
            "zh": "让我再写吗。\n好过分的待遇。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "112/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\nどうする？",
            "zh": "那么，\n要怎么选？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "115/SEL",
            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/36MB 2:22】</color>",
            "zh": "观看影像\n<color=green>【高画质/36MB 2:22】</color>",
            "narrator_zh": ""
        },
        {
            "location": "116/SEL",
            "narrator": "",
            "text": "映像を見る\n<color=green>【標準画質/13MB 2:22】</color>",
            "zh": "观看影像\n<color=green>【标准画质/13MB 2:22】</color>",
            "narrator_zh": ""
        },
        {
            "location": "117/SEL",
            "narrator": "",
            "text": "映像をスキップする",
            "zh": "跳过影像",
            "narrator_zh": ""
        },
        {
            "location": "118/ACT",
            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/36MB 2:22】</color>",
            "zh": "观看影像\n<color=green>【高画质/36MB 2:22】</color>",
            "narrator_zh": ""
        },
        {
            "location": "119/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "125/ACT",
            "narrator": "",
            "text": "映像を見る\n<color=green>【標準画質/13MB 2:22】</color>",
            "zh": "观看影像\n<color=green>【标准画质/13MB 2:22】</color>",
            "narrator_zh": ""
        },
        {
            "location": "126/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "132/ACT",
            "narrator": "",
            "text": "映像をスキップする",
            "zh": "跳过影像",
            "narrator_zh": ""
        },
        {
            "location": "133/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "146/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\n素敵なMVだった。",
            "zh": "于是，\n真是一部很棒的MV。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "147/TALK",
            "narrator": "千羽鶴",
            "text": "ガブリエラに\nラブラブできたでしょう。",
            "zh": "应该对加布里埃拉\n爱意满满了吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "149/SEL",
            "narrator": "",
            "text": "ガブリエラがとても可愛かった",
            "zh": "加布里埃拉非常可爱",
            "narrator_zh": ""
        },
        {
            "location": "150/SEL",
            "narrator": "",
            "text": "音楽がよかった",
            "zh": "音乐很棒",
            "narrator_zh": ""
        },
        {
            "location": "151/SEL",
            "narrator": "",
            "text": "男の子とは話せるようになるんだろうか",
            "zh": "她以后能和男孩子说上话吗",
            "narrator_zh": ""
        },
        {
            "location": "152/SEL",
            "narrator": "",
            "text": "銃と少女の組み合わせは最高ですね",
            "zh": "枪械和少女的组合最棒了",
            "narrator_zh": ""
        },
        {
            "location": "153/SEL",
            "narrator": "",
            "text": "次の子のMVはいつ、誰が配信されますか？",
            "zh": "下一个女孩子的MV什么时候发，是谁的？",
            "narrator_zh": ""
        },
        {
            "location": "154/SEL",
            "narrator": "",
            "text": "千羽鶴のMVはいつ出ますか？",
            "zh": "千羽鹤的MV什么时候出？",
            "narrator_zh": ""
        },
        {
            "location": "155/SEL",
            "narrator": "",
            "text": "特にない \n<color=blue>（※先へ進みます）</color>",
            "zh": "没有了 \n<color=blue>（※继续前进）</color>",
            "narrator_zh": ""
        },
        {
            "location": "156/ACT",
            "narrator": "",
            "text": "ガブリエラがとても可愛かった",
            "zh": "加布里埃拉非常可爱",
            "narrator_zh": ""
        },
        {
            "location": "157/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。\n彼女はとても\nカワイイと思う。",
            "zh": "是啊。\n我觉得她\n非常可爱。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "158/TALK",
            "narrator": "千羽鶴",
            "text": "しっかりしてるから\n忘れがちだけど、\n彼女はまだ――",
            "zh": "因为平时很可靠\n容易忘记，\n但她还只是——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "161/TALK",
            "narrator": "千羽鶴",
            "text": "<size=40><color=red>中学生だから！</color></size>",
            "zh": "<size=40><color=red>中学生！</color></size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "162/TALK",
            "narrator": "千羽鶴",
            "text": "海外の子は独り立ちが\n早いとか、戦火の中育った\nとか、色々あるけど――",
            "zh": "虽然说海外的孩子独立\n得早、在战火中长大\n之类的各有各的情况——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "165/TALK",
            "narrator": "千羽鶴",
            "text": "<size=40><color=red>中学生だから！</color></size>",
            "zh": "<size=40><color=red>还是中学生！</color></size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "166/TALK",
            "narrator": "千羽鶴",
            "text": "やはりまだ、感情を制御\nできなかったり、経験が\n足りなかったりする。",
            "zh": "果然还是会有控制不住\n情绪的时候，经验也\n还不够。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "167/TALK",
            "narrator": "千羽鶴",
            "text": "だから、貴方がしっかりと\n支えてあげて欲しい。",
            "zh": "所以，希望你能\n好好地支持她。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "168/TALK",
            "narrator": "千羽鶴",
            "text": "他は？",
            "zh": "还有吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "170/ACT",
            "narrator": "",
            "text": "音楽がよかった",
            "zh": "音乐很棒",
            "narrator_zh": ""
        },
        {
            "location": "171/TALK",
            "narrator": "千羽鶴",
            "text": "そう。\nそれはよかった。",
            "zh": "是吗。\n那太好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "172/TALK",
            "narrator": "千羽鶴",
            "text": "彼女の母国語を\n沢山堪能できて\n良かったと思う。",
            "zh": "能尽情听到\n她的母语\n真是太好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "173/TALK",
            "narrator": "千羽鶴",
            "text": "そんな貴方に朗報。",
            "zh": "这里有个好消息要告诉这样的你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "174/TALK",
            "narrator": "千羽鶴",
            "text": "このMVの配信と同時に、\n然るべき場所で歌曲の\nフルVerも公開してる。",
            "zh": "配合这次MV的上线，\n在相应的地方也公开了\n歌曲的完整版。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "175/TALK",
            "narrator": "千羽鶴",
            "text": "興味があれば、是非\n探して聞いてみると\nいいかも。",
            "zh": "如果有兴趣的话，\n不妨去找来\n听听看。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "176/TALK",
            "narrator": "千羽鶴",
            "text": "ガブリエラの可愛さを\nより深く堪能できると\n思うから。",
            "zh": "我想你能更深入地\n品味到加布里埃拉\n的可爱之处。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "177/TALK",
            "narrator": "千羽鶴",
            "text": "他は？",
            "zh": "还有吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "179/ACT",
            "narrator": "",
            "text": "男の子とは話せるようになるんだろうか",
            "zh": "她以后能和男孩子说上话吗",
            "narrator_zh": ""
        },
        {
            "location": "180/TALK",
            "narrator": "千羽鶴",
            "text": "それは貴方次第。",
            "zh": "那取决于你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "181/TALK",
            "narrator": "千羽鶴",
            "text": "貴方が男だろうが\n女だろうが関係無く、\n貴方の関わり次第。",
            "zh": "不管你是男是女\n都无所谓，\n全看你怎么和她相处。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "182/TALK",
            "narrator": "千羽鶴",
            "text": "彼女が男性と喋れないのは\n心因性のもの。",
            "zh": "她没法和男性说话\n是心因性的问题。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "183/TALK",
            "narrator": "千羽鶴",
            "text": "貴方が彼女のココロに\n深く関わり、その問題を\n解決できれば……",
            "zh": "如果你能深入她的心灵，\n帮她把那个问题\n解决掉的话……",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "184/TALK",
            "narrator": "千羽鶴",
            "text": "彼女は今よりずっと\n素敵になれる。",
            "zh": "她一定会变得\n比现在更出色。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "185/TALK",
            "narrator": "千羽鶴",
            "text": "他は？",
            "zh": "还有吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "187/ACT",
            "narrator": "",
            "text": "銃と少女の組み合わせは最高ですね",
            "zh": "枪械和少女的组合最棒了",
            "narrator_zh": ""
        },
        {
            "location": "188/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。\n彼女にはとても\nよく似合う。",
            "zh": "是啊。\n和她真是\n绝配。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "189/TALK",
            "narrator": "千羽鶴",
            "text": "私にはマネできない\n可愛さ。",
            "zh": "是我模仿不来的\n可爱。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "190/SEL",
            "narrator": "",
            "text": "千羽鶴も銃を持ってみて！",
            "zh": "千羽鹤也拿拿枪试试！",
            "narrator_zh": ""
        },
        {
            "location": "191/SEL",
            "narrator": "",
            "text": "確かに千羽鶴には似合わないな",
            "zh": "确实不适合千羽鹤呢",
            "narrator_zh": ""
        },
        {
            "location": "192/ACT",
            "narrator": "",
            "text": "千羽鶴も銃を持ってみて！",
            "zh": "千羽鹤也拿拿枪试试！",
            "narrator_zh": ""
        },
        {
            "location": "193/TALK",
            "narrator": "千羽鶴",
            "text": "いいえ。\n私は銃を持ってなくても\n殺せるから。",
            "zh": "不了。\n我就算不拿枪\n也能杀人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "194/SEL",
            "narrator": "",
            "text": "何を！？",
            "zh": "什么！？",
            "narrator_zh": ""
        },
        {
            "location": "195/SEL",
            "narrator": "",
            "text": "やはりな。",
            "zh": "果然如此。",
            "narrator_zh": ""
        },
        {
            "location": "196/ACT",
            "narrator": "",
            "text": "何を！？",
            "zh": "什么！？",
            "narrator_zh": ""
        },
        {
            "location": "197/ACT",
            "narrator": "",
            "text": "やはりな。",
            "zh": "果然如此。",
            "narrator_zh": ""
        },
        {
            "location": "199/TALK",
            "narrator": "千羽鶴",
            "text": "…言ってみたかっただけ。",
            "zh": "……只是想试着说说看而已。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "200/TALK",
            "narrator": "千羽鶴",
            "text": "真剣に受け答えする\n$handle$が\nちょっと可愛かった。",
            "zh": "认真接话的\n$handle$\n有点可爱。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "201/ACT",
            "narrator": "",
            "text": "確かに千羽鶴には似合わないな",
            "zh": "确实不适合千羽鹤呢",
            "narrator_zh": ""
        },
        {
            "location": "202/TALK",
            "narrator": "千羽鶴",
            "text": "むっ。",
            "zh": "唔。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "203/TALK",
            "narrator": "千羽鶴",
            "text": "私に銃が似合わないなんて\nそんなこと思ってる貴方の\nセンスも大した事ない。",
            "zh": "觉得我不适合拿枪，\n有这种想法的你\n品味也不怎么样嘛。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "204/SEL",
            "narrator": "",
            "text": "自分で「マネできない」って言ってたし！",
            "zh": "明明是你自己说“模仿不来”的！",
            "narrator_zh": ""
        },
        {
            "location": "205/ACT",
            "narrator": "",
            "text": "自分で「マネできない」って言ってたし！",
            "zh": "明明是你自己说“模仿不来”的！",
            "narrator_zh": ""
        },
        {
            "location": "207/TALK",
            "narrator": "千羽鶴",
            "text": "サソイウケに\n決まってるから！",
            "zh": "那肯定是\n故意抛梗的嘛！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "209/TALK",
            "narrator": "千羽鶴",
            "text": "他は？",
            "zh": "还有吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "211/ACT",
            "narrator": "",
            "text": "次の子のMVはいつ、誰が配信されますか？",
            "zh": "下一个女孩子的MV什么时候发，是谁的？",
            "narrator_zh": ""
        },
        {
            "location": "212/TALK",
            "narrator": "千羽鶴",
            "text": "それはまだ\n公表できない。",
            "zh": "这还不能\n公开。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "213/TALK",
            "narrator": "千羽鶴",
            "text": "私としては、この辺という\nアタリはつけているけど、\nもう少し待って欲しい。",
            "zh": "我心里倒是大致\n定下了时间点，\n不过还得请你再等等。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "214/TALK",
            "narrator": "千羽鶴",
            "text": "けど、そう遠くない時期に\nなると思うから、首を\n洗って待っていて。",
            "zh": "不过我想不会太远，\n你就洗干净脖子\n等着吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "215/TALK",
            "narrator": "千羽鶴",
            "text": "他は？",
            "zh": "还有吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "217/ACT",
            "narrator": "",
            "text": "千羽鶴のMVはいつ出ますか？",
            "zh": "千羽鹤的MV什么时候出？",
            "narrator_zh": ""
        },
        {
            "location": "218/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "219/SEL",
            "narrator": "",
            "text": "お",
            "zh": "哦",
            "narrator_zh": ""
        },
        {
            "location": "220/ACT",
            "narrator": "",
            "text": "お",
            "zh": "哦",
            "narrator_zh": ""
        },
        {
            "location": "224/TALK",
            "narrator": "千羽鶴",
            "text": "<size=260>私</size>",
            "zh": "<size=260>我</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "227/TALK",
            "narrator": "千羽鶴",
            "text": "<size=230>は</size>",
            "zh": "<size=230>某</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "230/TALK",
            "narrator": "千羽鶴",
            "text": "<size=200>あ</size>",
            "zh": "<size=200>种</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "234/TALK",
            "narrator": "千羽鶴",
            "text": "<size=170>る</size>",
            "zh": "<size=170>意</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "238/TALK",
            "narrator": "千羽鶴",
            "text": "<size=140>意</size>",
            "zh": "<size=140>义</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "242/TALK",
            "narrator": "千羽鶴",
            "text": "<size=110>味</size>",
            "zh": "<size=110>是</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "246/TALK",
            "narrator": "千羽鶴",
            "text": "<size=80>攻</size>",
            "zh": "<size=80>攻</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "250/TALK",
            "narrator": "千羽鶴",
            "text": "<size=50>略</size>",
            "zh": "<size=50>略</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "254/TALK",
            "narrator": "千羽鶴",
            "text": "<size=30>対</size>",
            "zh": "<size=30>对</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "258/TALK",
            "narrator": "千羽鶴",
            "text": "<size=20>象</size>",
            "zh": "<size=20>象</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "265/TALK",
            "narrator": "千羽鶴",
            "text": "わかった？",
            "zh": "明白了吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "266/SEL",
            "narrator": "",
            "text": "意味が分かりません！",
            "zh": "完全没听懂！",
            "narrator_zh": ""
        },
        {
            "location": "267/SEL",
            "narrator": "",
            "text": "新方式！？",
            "zh": "新方式！？",
            "narrator_zh": ""
        },
        {
            "location": "268/ACT",
            "narrator": "",
            "text": "意味が分かりません！",
            "zh": "完全没听懂！",
            "narrator_zh": ""
        },
        {
            "location": "269/TALK",
            "narrator": "千羽鶴",
            "text": "そう？",
            "zh": "是吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "270/TALK",
            "narrator": "千羽鶴",
            "text": "「ある意味」という弱さが\nMV回の否定を裏付けて\nいるわけだけど。",
            "zh": "“某种意义”这种弱气的说法，\n反而坐实了对MV回的\n否定就是了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "271/ACT",
            "narrator": "",
            "text": "新方式！？",
            "zh": "新方式！？",
            "narrator_zh": ""
        },
        {
            "location": "272/TALK",
            "narrator": "千羽鶴",
            "text": "毎回同じだと\nマンネリするでしょ。",
            "zh": "每次都一样的话\n会腻的吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "273/TALK",
            "narrator": "千羽鶴",
            "text": "ちーはいつも\n貴方にサプライズを\n提供するのに全力！",
            "zh": "小千一直都在\n全力为你提供\n惊喜！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "275/TALK",
            "narrator": "千羽鶴",
            "text": "他は？",
            "zh": "还有吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "277/ACT",
            "narrator": "",
            "text": "特にない \n<color=blue>（※先へ進みます）</color>",
            "zh": "没有了 \n<color=blue>（※继续前进）</color>",
            "narrator_zh": ""
        },
        {
            "location": "279/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "281/TALK",
            "narrator": "千羽鶴",
            "text": "今回はガブリエラに\n特化する為、他の\nエピソードはない。",
            "zh": "这次为了专攻\n加布里埃拉，没有\n其他剧情。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "282/TALK",
            "narrator": "千羽鶴",
            "text": "是非MVやバトル、まだ\n見ていない彼女とのらぶ\nとーくを楽しんで欲しい。",
            "zh": "请务必好好享受MV、\n战斗，还有没看过的\n和她的恋爱对话。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "286/TALK",
            "narrator": "千羽鶴",
            "text": "そして今回も１つ、貴方に\nボーナスプレゼントの\nお知らせがある。",
            "zh": "另外这次也有一个\n奖励礼物的消息\n要通知你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "287/TALK",
            "narrator": "千羽鶴",
            "text": "ガブリエラのエピソードを\nこのMVまで到達した人は\n全員ゲットできる。",
            "zh": "只要在加布里埃拉的\n剧情推进到这个MV的人，\n全员都能拿到。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "288/TALK",
            "narrator": "千羽鶴",
            "text": "私との会話が終わったら、\n是非イベントクエストへ\n向かって欲しい。",
            "zh": "和我的对话结束后，\n请务必前往\n活动副本。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "293/TALK",
            "narrator": "千羽鶴",
            "text": "そこにも\n『EXE_GARBiELRA』\nというイベントがある。",
            "zh": "那里也有一个叫\n『EXE_GARBiELRA』\n的活动。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "294/TALK",
            "narrator": "千羽鶴",
            "text": "そこで、なかなか手に\n入りにくいプレゼント\nアイテム等がもらえる。",
            "zh": "在那里能拿到平时\n很难入手的礼物道具\n之类的东西。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "299/TALK",
            "narrator": "千羽鶴",
            "text": "ここまで来てる人には\nもはや全プレレベルだから\n是非立ち寄ってみて。",
            "zh": "对走到这一步的人来说\n几乎等于全员白送，\n一定要去看看。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "300/SEL",
            "narrator": "",
            "text": "行ってきます！",
            "zh": "我去了！",
            "narrator_zh": ""
        },
        {
            "location": "301/SEL",
            "narrator": "",
            "text": "そういえば何で綴りが「ガルビエラ」さんなの？",
            "zh": "说起来为什么拼写是“加尔比埃拉”小姐啊？",
            "narrator_zh": ""
        },
        {
            "location": "302/ACT",
            "narrator": "",
            "text": "行ってきます！",
            "zh": "我去了！",
            "narrator_zh": ""
        },
        {
            "location": "303/TALK",
            "narrator": "千羽鶴",
            "text": "いってらっしゃい。",
            "zh": "路上小心。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "304/TALK",
            "narrator": "千羽鶴",
            "text": "今日もお仕事頑張ってね。\nあなた。",
            "zh": "今天工作也要加油哦。\n亲爱的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "305/TALK",
            "narrator": "千羽鶴",
            "text": "お小遣いは\n１５０円だけど。",
            "zh": "虽然零花钱\n只有150日元。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "306/TALK",
            "narrator": "千羽鶴",
            "text": "そんなわけで、\n貴方に素敵な\nガブリエライフを。",
            "zh": "那么就这样，\n祝你度过美好的\n加布里埃生活。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "307/ACT",
            "narrator": "",
            "text": "そういえば何で綴りが「ガルビエラ」さんなの？",
            "zh": "说起来为什么拼写是“加尔比埃拉”小姐啊？",
            "narrator_zh": ""
        },
        {
            "location": "308/TALK",
            "narrator": "千羽鶴",
            "text": "いいところに気づいた。",
            "zh": "注意到了不错的地方。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "309/TALK",
            "narrator": "千羽鶴",
            "text": "決して誤字などではなく、\nそれが本来の、戸籍登録\nされてるポーランド記述。",
            "zh": "这绝不是错字之类的，\n而是原本在户籍上登记的\n波兰语写法。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "310/TALK",
            "narrator": "千羽鶴",
            "text": "日本で言うなら\n旧漢字みたいなもの。",
            "zh": "用日本的话来说，\n就像是旧字体一样的东西。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "311/TALK",
            "narrator": "千羽鶴",
            "text": "読み方も、決して\nガルビエラではないから\n注意するように。",
            "zh": "读法也绝对不是\n加尔比埃拉，\n这点要注意。",
