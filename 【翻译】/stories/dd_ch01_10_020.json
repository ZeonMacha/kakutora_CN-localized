{
    "dir": "chap10/daydra/dd_ch01_10_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "10156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "クラスメイトからの頼み",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "同学的拜托"
    },
    "entry": [
        {
            "location": "253/SCENARIO",
            "narrator": "",
            "text": "クラスメイトからの頼み",
            "zh": "同学的拜托",
            "narrator_zh": ""
        },
        {
            "location": "269/TALK",
            "narrator": "女子高校生Ａ",
            "text": "逢瀬さん。",
            "zh": "逢濑。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "271/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "欸？",
            "narrator_zh": "燕"
        },
        {
            "location": "272/TALK",
            "narrator": "つばめ",
            "text": "あ…この人たちって、\n確か同じクラスの…。",
            "zh": "啊……这些人，\n好像是同班的……",
            "narrator_zh": "燕"
        },
        {
            "location": "273/TALK",
            "narrator": "つばめ",
            "text": "え、えっと…なんですか？",
            "zh": "欸、那个……什么事？",
            "narrator_zh": "燕"
        },
        {
            "location": "275/TALK",
            "narrator": "女子高校生Ａ",
            "text": "うん…急で驚かせちゃう\nかもしれないんだけど――",
            "zh": "嗯……突然的，\n可能会吓到你——",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "276/TALK",
            "narrator": "女子高校生Ａ",
            "text": "今度さ、一緒にどこか\n遊びに行かない？",
            "zh": "下次，要不要\n一起去哪里玩？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "278/TALK",
            "narrator": "つばめ",
            "text": "えっ！？",
            "zh": "欸！？",
            "narrator_zh": "燕"
        },
        {
            "location": "279/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "やっぱ驚かせちゃった？\nてか、急だもんね。",
            "zh": "果然吓到了？\n毕竟太突然了。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "280/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ごめん！\nでも、ずっと声かけたい\nって思ってたんだ。",
            "zh": "抱歉！\n不过，我一直想\n跟你搭话。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "282/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ただ、その…。",
            "zh": "只是，那个……",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "283/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "特別攻撃隊の人だから、\n気軽に声掛けていいの\nかな、って思ってさ。",
            "zh": "因为你是特别攻击队的人，\n就在想能不能\n随便搭话。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "284/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "ほら、なんとなくだけど、\n声掛けづらい人達が多い\nイメージあるし。",
            "zh": "你看，虽然只是感觉，\n总觉得不好搭话的人\n比较多。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "286/TALK",
            "narrator": "つばめ",
            "text": "えっと…誰のことかは\n聞かないでおくけど…。",
            "zh": "那个……是在说谁\n我就不问了……",
            "narrator_zh": "燕"
        },
        {
            "location": "288/TALK",
            "narrator": "つばめ",
            "text": "わたしも、みんなと同じ\n普通の高校生ですから…。",
            "zh": "我也是，和大家一样的\n普通高中生……",
            "narrator_zh": "燕"
        },
        {
            "location": "290/TALK",
            "narrator": "女子高校生Ａ",
            "text": "うん。\n日向さん達と一緒にいるの\n見て、やっとわかったの。",
            "zh": "嗯。\n看到你和日向她们在一起，\n才终于明白。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "291/TALK",
            "narrator": "女子高校生Ａ",
            "text": "だから、今更ではある\nけど、逢瀬さんと仲良く\nなりたいなぁ、って…。",
            "zh": "所以，虽然有点晚了，\n还是想和逢濑\n好好相处……",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "292/TALK",
            "narrator": "女子高校生Ａ",
            "text": "…ダメかな？",
            "zh": "……不行吗？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "294/TALK",
            "narrator": "つばめ",
            "text": "そんな、ダメじゃないよ！",
            "zh": "怎么会，当然行啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "295/TALK",
            "narrator": "つばめ",
            "text": "わたしだって、その…\nお友達いっぱい作りたい、\nって思ってたし…。",
            "zh": "我自己也，那个……\n一直想交很多\n朋友……",
            "narrator_zh": "燕"
        },
        {
            "location": "296/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "やった！\nじゃあ、決まりだね。",
            "zh": "太好了！\n那就这么定了。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "298/TALK",
            "narrator": "つばめ",
            "text": "う、うん。\nよろしくお願いします。",
            "zh": "嗯、嗯。\n请多关照。",
            "narrator_zh": "燕"
        },
        {
            "location": "299/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ありがとう、逢瀬さん。",
            "zh": "谢谢你，逢濑。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "300/TALK",
            "narrator": "女子高校生Ａ",
            "text": "それで、逢瀬さんは\nどういうところに\n行きたい？",
            "zh": "那么，逢濑\n想去什么样的\n地方？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "303/TALK",
            "narrator": "つばめ",
            "text": "えっと…実はまだ、\nあまり東京のことには\n詳しくなくて…。",
            "zh": "那个……其实我\n对东京还\n不太熟……",
            "narrator_zh": "燕"
        },
        {
            "location": "304/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "じゃあ、こっちで適当に\n決めとくから、決まったら\n伝える感じでいい？",
            "zh": "那我们这边先随便定，\n定了再告诉你，\n这样可以吗？",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "306/TALK",
            "narrator": "つばめ",
            "text": "うん、お任せします。",
            "zh": "嗯，交给你们啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "307/TALK",
            "narrator": "女子高校生Ａ",
            "text": "オッケー。\n楽しいとこ選んどくから、\n楽しみにしててね。",
            "zh": "OK。\n我会选个好玩的地方，\n你期待一下。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "314/TALK",
            "narrator": "つばめ",
            "text": "…えへへ。",
            "zh": "……诶嘿嘿。",
            "narrator_zh": "燕"
        },
        {
            "location": "326/TALK",
            "narrator": "つばめ",
            "text": "聞いて聞いて、今凄く嬉しいことがあったの！",
            "zh": "听我说听我说，刚才有件超开心的事！",
            "narrator_zh": "燕"
        },
        {
            "location": "327/TALK",
            "narrator": "つばめ",
            "text": "クラスの女の子に話しかけられて、お友達になろう、って言われちゃった",
            "zh": "班上的女生来跟我说话，还说要跟我做朋友",
            "narrator_zh": "燕"
        },
        {
            "location": "328/TALK",
            "narrator": "つばめ",
            "text": "今度一緒に出掛ける約束もしたんだよ",
            "zh": "还约好下次一起出去哦",
            "narrator_zh": "燕"
        },
        {
            "location": "329/TALK",
            "narrator": "つばめ",
            "text": "今から楽しみだなぁ",
            "zh": "现在就开始期待啦",
            "narrator_zh": "燕"
        },
        {
            "location": "331/SEL",
            "narrator": "",
            "text": "放課後早速、はダメなの？",
            "zh": "放学后马上，不行吗？",
            "narrator_zh": ""
        },
        {
            "location": "332/SEL",
            "narrator": "",
            "text": "新しいお友達、おめでとう",
            "zh": "交到新朋友，恭喜",
            "narrator_zh": ""
        },
        {
            "location": "333/ACT",
            "narrator": "",
            "text": "放課後早速、はダメなの？",
            "zh": "放学后马上，不行吗？",
            "narrator_zh": ""
        },
        {
            "location": "335/TALK",
            "narrator": "つばめ",
            "text": "あ、それいいかも、ナイスアイデア！",
            "zh": "啊，那个也许不错，好主意！",
            "narrator_zh": "燕"
        },
        {
            "location": "347/TALK",
            "narrator": "つばめ",
            "text": "…まだ、よく知らない人に\n声かけるのって緊張する\nけど――",
            "zh": "……跟还不熟的人\n开口搭话，\n还是会紧张——",
            "narrator_zh": "燕"
        },
        {
            "location": "348/TALK",
            "narrator": "つばめ",
            "text": "でも、あの子達はわたしに\n声かけてくれたんだもん。\nわたしも、頑張らなきゃ！",
            "zh": "可是，那些孩子\n先跟我搭话了。\n我也得加油！",
            "narrator_zh": "燕"
        },
        {
            "location": "361/TALK",
            "narrator": "つばめ",
            "text": "…ちょ、ちょっと待って！",
            "zh": "……等、等一下！",
            "narrator_zh": "燕"
        },
        {
            "location": "363/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "ん？",
            "zh": "嗯？",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "365/TALK",
            "narrator": "女子高校生Ａ",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "366/TALK",
            "narrator": "つばめ",
            "text": "あのね…もし、今日時間が\n空いてるなら――",
            "zh": "那个呀……如果今天\n有空的话——",
            "narrator_zh": "燕"
        },
        {
            "location": "367/TALK",
            "narrator": "つばめ",
            "text": "一緒に、カフェに\n行きませんか？",
            "zh": "要不要一起\n去咖啡馆？",
            "narrator_zh": "燕"
        },
        {
            "location": "368/TALK",
            "narrator": "つばめ",
            "text": "わたしも、二人のこと\n早く知りたいし――",
            "zh": "我也想快点\n了解你们两个——",
            "narrator_zh": "燕"
        },
        {
            "location": "369/TALK",
            "narrator": "つばめ",
            "text": "どこへ行くのかも、\n一緒に話し合えたら\n楽しいかな、って…。",
            "zh": "要去哪里，\n要是能一起商量，\n应该会很开心……",
            "narrator_zh": "燕"
        },
        {
            "location": "370/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "あ、いいねそれ。",
            "zh": "啊，这个不错。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "371/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "あたしはオッケーだよ。\nてか、早ければ早いだけ\n嬉しいし。",
            "zh": "我OK哦。\n而且越早\n越开心。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "372/TALK",
            "narrator": "女子高校生Ａ",
            "text": "私も！\nどこのカフェにする？",
            "zh": "我也是！\n去哪家咖啡馆？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "373/TALK",
            "narrator": "つばめ",
            "text": "あ、あの――",
            "zh": "啊、那个——",
            "narrator_zh": "燕"
        },
        {
            "location": "375/TALK",
            "narrator": "つばめ",
            "text": "帰りに、よく行くカフェが\nあるから、よかったら\nそこはどうかな？",
            "zh": "回家路上有家\n我常去的咖啡馆，\n不介意的话去那里？",
            "narrator_zh": "燕"
        },
        {
            "location": "376/TALK",
            "narrator": "女子高校生Ａ",
            "text": "お茶とケーキが\n美味しければ文句なし！",
            "zh": "茶和蛋糕\n好吃的话就没意见！",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "377/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "同じく！\n放課後が楽しみだなぁ。",
            "zh": "一样！\n好期待放学呀。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "379/TALK",
            "narrator": "つばめ",
            "text": "わたしもです。\n早く放課後にならない\nかなぁ…。",
            "zh": "我也是。\n怎么还不放学\n呀……",
            "narrator_zh": "燕"
        },
        {
            "location": "397/ACT",
            "narrator": "",
            "text": "新しいお友達、おめでとう",
            "zh": "交到新朋友，恭喜",
            "narrator_zh": ""
        },
        {
            "location": "398/TALK",
            "narrator": "つばめ",
            "text": "ありがとう！",
            "zh": "谢谢！",
            "narrator_zh": "燕"
        },
        {
            "location": "399/TALK",
            "narrator": "つばめ",
            "text": "東京に出てきてから、ビックリするくらいお友達ができてるよ",
            "zh": "来到东京之后，朋友多得我自己都吓一跳哦",
            "narrator_zh": "燕"
        },
        {
            "location": "400/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃん達もそうだし、今の子達もそうだし",
            "zh": "雏她们是这样，现在这些孩子也是",
            "narrator_zh": "燕"
        },
        {
            "location": "401/TALK",
            "narrator": "つばめ",
            "text": "お友達になりたい、って言ってくれる人がいるのって、凄く幸せだよ",
            "zh": "有人说想和我做朋友，真的很幸福哦",
            "narrator_zh": "燕"
        },
        {
            "location": "412/TALK",
            "narrator": "つばめ",
            "text": "…あっ！",
            "zh": "……啊！",
            "narrator_zh": "燕"
        },
        {
            "location": "413/TALK",
            "narrator": "つばめ",
            "text": "そうだ、今日の放課後、\nバイトおやすみだった\nんだ！",
            "zh": "对了，今天放学后，\n打工是休息\n的！",
            "narrator_zh": "燕"
        },
        {
            "location": "414/TALK",
            "narrator": "つばめ",
            "text": "お茶しに行こう、って\n誘えばよかったかも…\n失敗しちゃったなぁ…。",
            "zh": "要是邀请她们\n去喝茶就好了……\n搞砸了呀……",
            "narrator_zh": "燕"
        },
        {
            "location": "416/TALK",
            "narrator": "つばめ",
            "text": "っていうかわたし、\n完全に受け身になってる？",
            "zh": "话说，我是不是\n完全变成被动的了？",
            "narrator_zh": "燕"
        },
        {
            "location": "417/TALK",
            "narrator": "つばめ",
            "text": "反省しよう…。\n今度、わたしの方から\nどこか誘ってみようかな？",
            "zh": "反省一下……\n下次，试着由我\n来邀请怎么样？",
            "narrator_zh": "燕"
        },
        {
            "location": "264/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月10日　10:06 AM</color>\n平日午前中の休み時間、教室にて。",
            "zh": "<color=green>6月10日　10:06 AM</color>\n平日上午的休息时间，在教室。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "391/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch01",
            "text": "【百人までの第一歩】",
            "zh": "【走向一百人的第一步】",
            "narrator_zh": "Dialog_GEThimegoto_ch01"
        }
    ]
}
