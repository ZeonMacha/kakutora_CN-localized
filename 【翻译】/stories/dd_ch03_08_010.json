{
    "dir": "chap08/daydra/dd_ch03_08_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "8352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "ガブリエラの知らない世界",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "加布里埃拉所不知的世界"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "ガブリエラの知らない世界",
            "zh": "加布里埃拉所不知的世界",
            "narrator_zh": ""
        },
        {
            "location": "20/TALK",
            "narrator": "アーヤ",
            "text": "…そういえば――",
            "zh": "……说起来——",
            "narrator_zh": "绫水"
        },
        {
            "location": "22/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィって、日本の\n食べ物で食べられない\nものはないの？",
            "zh": "加维，日本的食物里\n没有你吃不惯的\n东西吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、あたしの知る限り\nないわ。",
            "zh": "嗯，就我所知\n没有。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "25/TALK",
            "narrator": "ガブリエラ",
            "text": "納豆でも漬物でも\n刺身でも、何だって\n食べれるもの！",
            "zh": "不管是纳豆还是咸菜\n还是刺身，什么我都能\n吃得下去！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "凄いわね…漬物って、\n私でも苦手なのが\nあるのに…。",
            "zh": "真厉害啊……咸菜的话，\n连我也有吃不惯的\n种类呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "28/TALK",
            "narrator": "みやび",
            "text": "ほほぅ、なかなか面白い\n話しゆうね。",
            "zh": "哦吼，你们在聊的事\n蛮有意思咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "29/TALK",
            "narrator": "みやび",
            "text": "ならガブちゃん、\n活き造りは食べたこと\nあるが？",
            "zh": "那加布，\n活鱼刺身你吃过\n没喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "イキヅクリ？\n聞いたことないわ。",
            "zh": "活鱼刺身？\n没听说过。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "やっぱしな…。\n外国の人間にはちっくと\nエグい料理やき。",
            "zh": "果然啊……。\n对外国人来说，这菜\n有点太刺激了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "どんな料理なの？",
            "zh": "是什么样的料理？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "刺身にされながらも、\n生きて動いている魚を\n見ながら食べる料理や。",
            "zh": "就是把鱼片成刺身，\n一边看着那条鱼还活着在动\n一边吃的料理咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "みやび！！\n冗談でも言って良いことと\n悪いことがあるでしょ！？",
            "zh": "雅！！\n就算开玩笑，也有能说\n和不能说的分寸吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "46/TALK",
            "narrator": "みやび",
            "text": "冗談やない。\n活き造りは昔から日本に\nある料理やき。",
            "zh": "不是开玩笑。\n活鱼刺身自古以来就是\n日本有的料理啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか、そんな料理が\nあるわけないじゃない。",
            "zh": "怎么可能，那种料理\n根本不可能存在吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、ちょっと気に\nなるかも。",
            "zh": "……不过，倒也有点\n在意呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょー気分悪い！",
            "zh": "超让人不爽的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/SEL",
            "narrator": "",
            "text": "何を怒ってるの？",
            "zh": "你在气什么？",
            "narrator_zh": ""
        },
        {
            "location": "65/ACT",
            "narrator": "",
            "text": "何を怒ってるの？",
            "zh": "你在气什么？",
            "narrator_zh": ""
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびが酷い冗談言ったのよ",
            "zh": "雅她开了个特别过分的玩笑",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "ガブリエラ",
            "text": "魚を生きたままお刺身にして食べる",
            "zh": "说什么把活鱼直接做成刺身来吃",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "69/TALK",
            "narrator": "ガブリエラ",
            "text": "活き造りとかいう料理があるって",
            "zh": "还叫什么活鱼刺身",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなのウソに決まってるわ",
            "zh": "那种事肯定是瞎编的嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/SEL",
            "narrator": "",
            "text": "いや、普通にあるよ",
            "zh": "不，这菜很常见哦",
            "narrator_zh": ""
        },
        {
            "location": "73/SEL",
            "narrator": "",
            "text": "酷い冗談だ、怒った方が良い",
            "zh": "太过分了，是该生气",
            "narrator_zh": ""
        },
        {
            "location": "74/SEL",
            "narrator": "",
            "text": "踊り食いは知ってる？",
            "zh": "你知道“活吞”吗？",
            "narrator_zh": ""
        },
        {
            "location": "75/ACT",
            "narrator": "",
            "text": "いや、普通にあるよ",
            "zh": "不，这菜很常见哦",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "え？",
            "zh": "哎？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか、本当に存在するの！？",
            "zh": "难道说，真的存在吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、アーヤ！\n活き造りって料理、\n本当に存在するの！？",
            "zh": "绫、绫水！\n叫活鱼刺身的料理，\n真的存在吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "アーヤ",
            "text": "ええ、そこまで珍しい\nものではないわよ？",
            "zh": "嗯，并不是什么\n太稀奇的东西哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ！？",
            "zh": "哈啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、何なのその\nおぞましさの塊みたいな\n料理！？",
            "zh": "话说回来，那是什么\n毛骨悚然到极点的\n料理啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしてお刺身の状態に\nしてまで、魚を生かして\nおく必要があるのよ？",
            "zh": "为什么非要把鱼都片成刺身了，\n还非得让它\n活着不可啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/TALK",
            "narrator": "みやび",
            "text": "活きの良さを見せるために\n決まっとるがよ。",
            "zh": "那还不是为了显摆它\n有多新鲜啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "うん、今できたわ。\n見たくもないくらい\n苦手な和食が。",
            "zh": "嗯，刚刚诞生了。\n我连看都不想看一眼的\n讨厌的和食。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "アーヤ",
            "text": "食べてみれば\nイメージ変わると\n思うんだけど…。",
            "zh": "其实吃吃看的话，\n印象应该会\n有所改观吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対食べないから！！",
            "zh": "我绝对不吃！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "やっぱり、外国人の\nガブちゃんには\nちっくとキツ過ぎたか。",
            "zh": "果然，对外国人的\n加布来说\n还是有点太重口了喃。",
            "narrator_zh": "雅"
        },
        {
            "location": "124/ACT",
            "narrator": "",
            "text": "酷い冗談だ、怒った方が良い",
            "zh": "太过分了，是该生气",
            "narrator_zh": ""
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね",
            "zh": "就是说啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとこれは酷過ぎるわ！",
            "zh": "这也未免太过分了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "みやび、今回の冗談は\n笑えないし度を越してる\nしで、最低よ。",
            "zh": "雅，这次的玩笑\n既不好笑又过了头，\n简直差劲透了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "もう二度と活き造りの\n話はしないで。",
            "zh": "以后再也别跟我提\n活鱼刺身的事了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "でもギャヴィ、\n活き造りは――",
            "zh": "可是加维，\n活鱼刺身它——",
            "narrator_zh": "绫水"
        },
        {
            "location": "145/TALK",
            "narrator": "みやび",
            "text": "アーヤ、えいから。",
            "zh": "绫水，莫讲咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "146/TALK",
            "narrator": "みやび",
            "text": "世の中には知らん方が\nえいこともあるんよ。",
            "zh": "这世上有些事情，\n还是不晓得才好啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "すまんな、ガブちゃん。\n性質の悪い冗談言うて。",
            "zh": "对不住咯，加布。\n跟你开了个这么缺德的玩笑。",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "ガブリエラ",
            "text": "わかればいいのよ。\nまったく…。",
            "zh": "你知道就好。\n真是的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "でもな、ガブちゃん。",
            "zh": "不过呢，加布。",
            "narrator_zh": "雅"
        },
        {
            "location": "154/TALK",
            "narrator": "みやび",
            "text": "本当にそんなイヤなら、\n絶対に検索せん方が\nえいよ。",
            "zh": "要是真那么讨厌的话，\n可千万莫去\n网上搜咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "155/TALK",
            "narrator": "アーヤ",
            "text": "そうね…。\n私もそう思うわ。",
            "zh": "是啊……。\n我也这么觉得。",
            "narrator_zh": "绫水"
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "な、何よ？\nアーヤまでそんな\n反応しちゃって。",
            "zh": "什、什么呀？\n怎么连绫水都\n这副反应。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "161/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか、本当にそんな\n料理が存在するとか？",
            "zh": "难道说，那种料理\n真的存在不成？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん、そんなのない！\nあるわけない！\nだから検索もしない！",
            "zh": "不、没有那种东西！\n绝对不可能有！\n所以我才不会去搜呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "166/ACT",
            "narrator": "",
            "text": "踊り食いは知ってる？",
            "zh": "你知道“活吞”吗？",
            "narrator_zh": ""
        },
        {
            "location": "168/TALK",
            "narrator": "ガブリエラ",
            "text": "何だか、お行儀の悪い食べ方ね",
            "zh": "总觉得是很没礼貌的吃法呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "169/TALK",
            "narrator": "ガブリエラ",
            "text": "本当にそんなのあるのかしら？",
            "zh": "真的会有那种东西吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "181/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ、踊り食いって\n知ってる？",
            "zh": "哎，你们知道\n“活吞”吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "182/TALK",
            "narrator": "アーヤ",
            "text": "ええ…、小さな魚を\n生きたまま飲み込む\n食べ方よね？",
            "zh": "嗯……，就是把小鱼\n活生生吞下去的\n吃法对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "184/TALK",
            "narrator": "ガブリエラ",
            "text": "…は？",
            "zh": "……哈？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "185/TALK",
            "narrator": "みやび",
            "text": "しょうゆとかポン酢に\nつけて、ちゅるんと\n飲み込むんよ。",
            "zh": "蘸点酱油或者柚子醋，\n出溜一下就\n吞下去咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "187/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "191/TALK",
            "narrator": "ガブリエラ",
            "text": "和食の闇を\n知ってしまったわ。",
            "zh": "我算是见识到\n和食的黑暗面了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "別に闇でもなんでも\nないんやけどなぁ。",
            "zh": "倒也算不上什么\n黑暗面就是了嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "そこまで珍しい料理、\nってわけでもないん\nだけど…。",
            "zh": "也不算是什么\n太罕见的料理\n就是了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "ていうか、それ料理とは\n言えないわよ！",
            "zh": "话说回来，那根本不能\n算作料理好不好！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "18/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月14日　3:24 PM</color>\nＷＡＶＥ戦から5日後、アーヤの部屋にて。",
            "zh": "<color=green>5月14日　3:24 PM</color>\nWAVE战5天后，在绫水的房间。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "118/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch03",
            "text": "【身近にあるホラー】",
            "zh": "【身边的恐怖】",
            "narrator_zh": "Dialog_GEThimegoto_ch03"
        }
    ]
}
