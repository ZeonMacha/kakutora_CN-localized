        "title": "005 メインストーリー",
        "sub_title": "たったひとつの＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "仅此唯一＜后篇＞"
    },
    "entry": [
        {
            "location": "708/TALK",
            "narrator": "みやび",
            "text": "運命とか。\n大げさな言葉は\n嫌いやけんど。",
            "zh": "命运什么的。\n夸张的词句\n我最讨厌了。",
            "narrator_zh": "雅"
        },
        {
            "location": "709/TALK",
            "narrator": "みやび",
            "text": "この判決は運命と\n呼ぶしかないろうね。",
            "zh": "这个判决却只能\n称之为命运了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "711/SEL",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "712/SEL",
            "narrator": "",
            "text": "少し話せる？",
            "zh": "能说会儿话吗？",
            "narrator_zh": ""
        },
        {
            "location": "713/SEL",
            "narrator": "",
            "text": "$me$を恨んでる？",
            "zh": "你在恨$me$吗？",
            "narrator_zh": ""
        },
        {
            "location": "714/ACT",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "715/TALK",
            "narrator": "みやび",
            "text": "どう思う？",
            "zh": "你觉得呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "716/ACT",
            "narrator": "",
            "text": "少し話せる？",
            "zh": "能说会儿话吗？",
            "narrator_zh": ""
        },
        {
            "location": "717/TALK",
            "narrator": "みやび",
            "text": "それはどうかいね？",
            "zh": "那可说不定咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "718/ACT",
            "narrator": "",
            "text": "$me$を恨んでる？",
            "zh": "你在恨$me$吗？",
            "narrator_zh": ""
        },
        {
            "location": "719/TALK",
            "narrator": "みやび",
            "text": "聞く必要はないろう。",
            "zh": "没问的必要吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "722/SEL",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "723/SEL",
            "narrator": "",
            "text": "少し話せる？",
            "zh": "能说会儿话吗？",
            "narrator_zh": ""
        },
        {
            "location": "724/SEL",
            "narrator": "",
            "text": "$me$を恨んでる？",
            "zh": "你在恨$me$吗？",
            "narrator_zh": ""
        },
        {
            "location": "725/ACT",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "726/TALK",
            "narrator": "みやび",
            "text": "$handle$と\nこうやって話が\nできる程度には。",
            "zh": "到了还能和$handle$\n这样说话的\n程度。",
            "narrator_zh": "雅"
        },
        {
            "location": "727/ACT",
            "narrator": "",
            "text": "少し話せる？",
            "zh": "能说会儿话吗？",
            "narrator_zh": ""
        },
        {
            "location": "728/TALK",
            "narrator": "みやび",
            "text": "そうやね。\nうちも話したい\nことがあるき。",
            "zh": "是呢。\n我也有想说的\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "729/ACT",
            "narrator": "",
            "text": "$me$を恨んでる？",
            "zh": "你在恨$me$吗？",
            "narrator_zh": ""
        },
        {
            "location": "730/TALK",
            "narrator": "みやび",
            "text": "またまた。\nわかっとるくせに。",
            "zh": "又来了。\n明明就知道嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "733/TALK",
            "narrator": "みやび",
            "text": "この先がまだ\n確定せんうちに。",
            "zh": "趁这以后还没\n确定下来。",
            "narrator_zh": "雅"
        },
        {
            "location": "734/TALK",
            "narrator": "みやび",
            "text": "$handle$に\n言っておきたい\nことがある。",
            "zh": "有话想先\n对$handle$\n说。",
            "narrator_zh": "雅"
        },
        {
            "location": "735/SEL",
            "narrator": "",
            "text": "何だろう？",
            "zh": "是什么呢？",
            "narrator_zh": ""
        },
        {
            "location": "736/SEL",
            "narrator": "",
            "text": "期待していい？",
            "zh": "可以期待吗？",
            "narrator_zh": ""
        },
        {
            "location": "737/SEL",
            "narrator": "",
            "text": "あんまり聞きたくないな…",
            "zh": "我不太想听啊……",
            "narrator_zh": ""
        },
        {
            "location": "738/ACT",
            "narrator": "",
            "text": "何だろう？",
            "zh": "是什么呢？",
            "narrator_zh": ""
        },
        {
            "location": "739/TALK",
            "narrator": "みやび",
            "text": "わからんかねえ？",
            "zh": "猜不到咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "740/ACT",
            "narrator": "",
            "text": "期待していい？",
            "zh": "可以期待吗？",
            "narrator_zh": ""
        },
        {
            "location": "741/TALK",
            "narrator": "みやび",
            "text": "思い切り\nしてええき。",
            "zh": "放开了\n猜啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "742/ACT",
            "narrator": "",
            "text": "あんまり聞きたくないな…",
            "zh": "我不太想听啊……",
            "narrator_zh": ""
        },
        {
            "location": "743/TALK",
            "narrator": "みやび",
            "text": "まあそう言わんと\n聞いたらえいき。",
            "zh": "嘛，别那么说，\n听了就是啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "745/TALK",
            "narrator": "みやび",
            "text": "うちがトライナリーに\n加わったんは、\nなごちゃんのため。",
            "zh": "我加入三重奏，\n是为了\n七五。",
            "narrator_zh": "雅"
        },
        {
            "location": "746/TALK",
            "narrator": "みやび",
            "text": "…というのはつばめが\nねつ造したうちの\n過去やけんど。",
            "zh": "……这是燕伪造出来的\n我的过去\n就是了。",
            "narrator_zh": "雅"
        },
        {
            "location": "747/TALK",
            "narrator": "みやび",
            "text": "それが明らかに\nなる前のうちは\nそう固く信じとった。",
            "zh": "在那被揭穿之前的\n我，是那样\n深信不疑的。",
            "narrator_zh": "雅"
        },
        {
            "location": "748/TALK",
            "narrator": "みやび",
            "text": "やき、うちは\n他の子たちと\n馴れ合う気はなかった。",
            "zh": "所以咧，我\n没打算和其他\n孩子打成一片。",
            "narrator_zh": "雅"
        },
        {
            "location": "749/TALK",
            "narrator": "みやび",
            "text": "むしろ全員敵くらいに\n思うちょった。",
            "zh": "不如说把所有人\n都当敌人看待。",
            "narrator_zh": "雅"
        },
        {
            "location": "750/TALK",
            "narrator": "みやび",
            "text": "ほいてそれを\n悟られるわけには\nいかんかった。",
            "zh": "而且也不能\n被看穿\n这一点。",
            "narrator_zh": "雅"
        },
        {
            "location": "751/TALK",
            "narrator": "みやび",
            "text": "そういや\n相棒のことは一番\n疑うちょったね。",
            "zh": "这么说来，\n搭档是被我怀疑得\n最狠的呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "752/TALK",
            "narrator": "みやび",
            "text": "すまんかった。",
            "zh": "没好意思了。",
            "narrator_zh": "雅"
        },
        {
            "location": "753/SEL",
            "narrator": "",
            "text": "いや別に",
            "zh": "没什么",
            "narrator_zh": ""
        },
        {
            "location": "754/SEL",
            "narrator": "",
            "text": "今はラブラブだから平気",
            "zh": "现在腻歪着呢，没关系",
            "narrator_zh": ""
        },
        {
            "location": "755/SEL",
            "narrator": "",
            "text": "そんなこともあったね",
            "zh": "是有过那么回事呢",
            "narrator_zh": ""
        },
        {
            "location": "756/ACT",
            "narrator": "",
            "text": "いや別に",
            "zh": "没什么",
            "narrator_zh": ""
        },
        {
            "location": "757/TALK",
            "narrator": "みやび",
            "text": "相棒は心が広いねえ。",
            "zh": "搭档心胸真宽广呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "758/ACT",
            "narrator": "",
            "text": "今はラブラブだから平気",
            "zh": "现在腻歪着呢，没关系",
            "narrator_zh": ""
        },
        {
            "location": "759/TALK",
            "narrator": "みやび",
            "text": "闇雲すぎるほどに\nポジティブやねえ。",
            "zh": "积极得都近乎\n瞎来了呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "760/ACT",
            "narrator": "",
            "text": "そんなこともあったね",
            "zh": "是有过那么回事呢",
            "narrator_zh": ""
        },
        {
            "location": "761/TALK",
            "narrator": "みやび",
            "text": "もちろん\n今は違うけんど。",
            "zh": "当然\n现在不一样了。",
            "narrator_zh": "雅"
        },
        {
            "location": "763/TALK",
            "narrator": "みやび",
            "text": "疑心暗鬼だったうちを\n見守ってくれたんは\n$handle$やった。",
            "zh": "守望着疑神疑鬼的\n我的，\n是$handle$。",
            "narrator_zh": "雅"
        },
        {
            "location": "764/TALK",
            "narrator": "みやび",
            "text": "そのおかげでうちは\n少し人を信じることを\n憶えられたと思う。",
            "zh": "托这个福，我想\n我学会了一点\n信任人。",
            "narrator_zh": "雅"
        },
        {
            "location": "765/TALK",
            "narrator": "みやび",
            "text": "人に背中を預けることを\n憶えられたと思う。",
            "zh": "我想我学会了\n把背后托付给人。",
            "narrator_zh": "雅"
        },
        {
            "location": "766/TALK",
            "narrator": "みやび",
            "text": "いくら感謝しても\nし足りん。\nありがとう。",
            "zh": "感谢多少遍\n都不够。\n谢谢。",
            "narrator_zh": "雅"
        },
        {
            "location": "767/SEL",
            "narrator": "",
            "text": "いえいえ",
            "zh": "哪里哪里",
            "narrator_zh": ""
        },
        {
            "location": "768/SEL",
            "narrator": "",
            "text": "どういたしまして",
            "zh": "不客气",
            "narrator_zh": ""
        },
        {
            "location": "769/SEL",
            "narrator": "",
            "text": "元々みやびは素直だったよ",
            "zh": "雅本来就很坦率哦",
            "narrator_zh": ""
        },
        {
            "location": "770/ACT",
            "narrator": "",
            "text": "いえいえ",
            "zh": "哪里哪里",
            "narrator_zh": ""
        },
        {
            "location": "771/TALK",
            "narrator": "みやび",
            "text": "もっとドヤ顔を\nしてくるかと\n思うちょったけんど。",
            "zh": "我还以为你会\n摆着得意脸\n来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "772/TALK",
            "narrator": "みやび",
            "text": "そう改まられると\n調子が狂う。",
            "zh": "被这么一本正经地\n对待，节奏都乱了。",
            "narrator_zh": "雅"
        },
        {
            "location": "773/ACT",
            "narrator": "",
            "text": "どういたしまして",
            "zh": "不客气",
            "narrator_zh": ""
        },
        {
            "location": "774/TALK",
            "narrator": "みやび",
            "text": "本当に感謝する。",
            "zh": "真心感谢。",
            "narrator_zh": "雅"
        },
        {
            "location": "775/ACT",
            "narrator": "",
            "text": "元々みやびは素直だったよ",
            "zh": "雅本来就很坦率哦",
            "narrator_zh": ""
        },
        {
            "location": "776/TALK",
            "narrator": "みやび",
            "text": "…それは\n$handle$の\n買い被りぞね。",
            "zh": "……那是\n$handle$\n把我抬太高了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "778/TALK",
            "narrator": "みやび",
            "text": "今こうやって\n話ができるんも。",
            "zh": "现在能像这样\n说话。",
            "narrator_zh": "雅"
        },
        {
            "location": "779/TALK",
            "narrator": "みやび",
            "text": "想定外と\n不確定要素の\n積み重ねの結果ぞね。",
            "zh": "是意料之外与\n不确定因素\n层层堆叠的结果咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "780/TALK",
            "narrator": "みやび",
            "text": "この先世界が\n軌道修正して\n新しうなったら。",
            "zh": "今后世界要是\n修正轨道\n焕然一新了。",
            "narrator_zh": "雅"
        },
        {
            "location": "781/TALK",
            "narrator": "みやび",
            "text": "こんなことももう\nできんかもしれんぞね。",
            "zh": "说不定连这样的事\n都做不到了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "782/TALK",
            "narrator": "みやび",
            "text": "けんどうちは\n信じとるき。",
            "zh": "但是我\n信着啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "783/TALK",
            "narrator": "みやび",
            "text": "$handle$が\nずっとうちの側に\nいてくれることを。",
            "zh": "信$handle$会\n一直待在\n我身边。",
            "narrator_zh": "雅"
        },
        {
            "location": "784/TALK",
            "narrator": "みやび",
            "text": "うちが魂だけになっても\n相棒がうちを\n見失わんことを。",
            "zh": "信就算我变成只剩灵魂，\n搭档也不会\n把我看丢。",
            "narrator_zh": "雅"
        },
        {
            "location": "785/TALK",
            "narrator": "みやび",
            "text": "……これって\n何なんやろうね？",
            "zh": "……这算\n什么呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "786/TALK",
            "narrator": "みやび",
            "text": "愛とか恋とか\nそういう次元は\nとっくに超えた何か。",
            "zh": "是爱呀恋呀\n那种次元\n早就装不下的什么东西。",
            "narrator_zh": "雅"
        },
        {
            "location": "787/TALK",
            "narrator": "みやび",
            "text": "存在自体がうちで\nうちが$handle$\nみたいな。",
            "zh": "是存在本身即我、\n我即$handle$\n那种感觉。",
            "narrator_zh": "雅"
        },
        {
            "location": "788/TALK",
            "narrator": "みやび",
            "text": "……大げさに\n思うとる？",
            "zh": "……觉得\n夸张了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "789/TALK",
            "narrator": "みやび",
            "text": "うちはしょうまっこと\nそういう気持ちで\nおるき。",
            "zh": "我是真真切切\n怀着这种心情的\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "790/TALK",
            "narrator": "みやび",
            "text": "いや、違うねえ。",
            "zh": "不，不对呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "791/TALK",
            "narrator": "みやび",
            "text": "言葉にできんくらい\nもっと大きい気持ちで\nそう思うとるき。",
            "zh": "是怀着大到\n说不出口的心情\n这么想的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "792/TALK",
            "narrator": "みやび",
            "text": "$handle$も\nそういう気持ちやと\n信じとるき。",
            "zh": "我也信\n$handle$怀着同样的\n心情啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "793/TALK",
            "narrator": "みやび",
            "text": "…違うかねえ？",
            "zh": "……不对吗咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "795/SEL",
            "narrator": "",
            "text": "愛してる。ずっと一緒だから",
            "zh": "爱你。因为会一直在一起",
            "narrator_zh": ""
        },
        {
            "location": "796/SEL",
            "narrator": "",
            "text": "これからも共に支え合っていこう",
            "zh": "今后也互相支撑下去吧",
            "narrator_zh": ""
        },
        {
            "location": "797/SEL",
            "narrator": "",
            "text": "これからも頑張ってね",
            "zh": "今后也要加油哦",
            "narrator_zh": ""
        },
        {
            "location": "798/SEL",
            "narrator": "",
            "text": "役に立てて良かったよ",
            "zh": "能帮上忙太好了",
            "narrator_zh": ""
        },
        {
            "location": "799/ACT",
            "narrator": "",
            "text": "愛してる。ずっと一緒だから",
            "zh": "爱你。因为会一直在一起",
            "narrator_zh": ""
        },
        {
            "location": "800/TALK",
            "narrator": "みやび",
            "text": "…光栄やき。",
            "zh": "……真是光荣啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "801/ACT",
            "narrator": "",
            "text": "これからも共に支え合っていこう",
            "zh": "今后也互相支撑下去吧",
            "narrator_zh": ""
        },
        {
            "location": "802/TALK",
            "narrator": "みやび",
            "text": "…やね。",
            "zh": "……是呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "803/ACT",
            "narrator": "",
            "text": "これからも頑張ってね",
            "zh": "今后也要加油哦",
            "narrator_zh": ""
        },
        {
            "location": "804/TALK",
            "narrator": "みやび",
            "text": "$handle$も\nがんばれ。\nばかちんが。",
            "zh": "$handle$也\n加油啊。\n笨蛋蛋。",
            "narrator_zh": "雅"
        },
        {
            "location": "805/ACT",
            "narrator": "",
            "text": "役に立てて良かったよ",
            "zh": "能帮上忙太好了",
            "narrator_zh": ""
        },
        {
            "location": "806/TALK",
            "narrator": "みやび",
            "text": "過去形か。\nツンデレめ。",
            "zh": "用过去时吗。\n傲娇鬼。",
            "narrator_zh": "雅"
        },
        {
            "location": "809/SEL",
            "narrator": "",
            "text": "愛してる。ずっと一緒だから",
            "zh": "爱你。因为会一直在一起",
            "narrator_zh": ""
        },
        {
            "location": "810/SEL",
            "narrator": "",
            "text": "これからも共に支え合っていこう",
            "zh": "今后也互相支撑下去吧",
            "narrator_zh": ""
        },
        {
            "location": "811/SEL",
            "narrator": "",
            "text": "これからも頑張ってね",
            "zh": "今后也要加油哦",
            "narrator_zh": ""
        },
        {
            "location": "812/SEL",
            "narrator": "",
            "text": "役に立てて良かったよ",
            "zh": "能帮上忙太好了",
            "narrator_zh": ""
        },
        {
            "location": "813/ACT",
            "narrator": "",
            "text": "愛してる。ずっと一緒だから",
            "zh": "爱你。因为会一直在一起",
            "narrator_zh": ""
        },
        {
            "location": "814/TALK",
            "narrator": "みやび",
            "text": "愛か。",
            "zh": "爱吗。",
            "narrator_zh": "雅"
        },
        {
            "location": "815/TALK",
            "narrator": "みやび",
            "text": "そんな次元を超えて\n一緒やと言うとるのに。",
            "zh": "都说超越那种次元、\n合为一体了。",
            "narrator_zh": "雅"
        },
        {
            "location": "816/ACT",
            "narrator": "",
            "text": "これからも共に支え合っていこう",
            "zh": "今后也互相支撑下去吧",
            "narrator_zh": ""
        },
        {
            "location": "817/TALK",
            "narrator": "みやび",
            "text": "共に、というのが\n$handle$らしいね。",
            "zh": "『一起』这个说法\n很有$handle$的风格呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "818/ACT",
            "narrator": "",
            "text": "これからも頑張ってね",
            "zh": "今后也要加油哦",
            "narrator_zh": ""
        },
        {
            "location": "819/TALK",
            "narrator": "みやび",
            "text": "こらこらこらこら。",
            "zh": "喂喂喂喂喂。",
            "narrator_zh": "雅"
        },
        {
            "location": "820/TALK",
            "narrator": "みやび",
            "text": "$handle$も一緒に\n頑張ってくれんと。",
            "zh": "$handle$不\n一起加油可不行啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "821/ACT",
            "narrator": "",
            "text": "役に立てて良かったよ",
            "zh": "能帮上忙太好了",
            "narrator_zh": ""
        },
        {
            "location": "822/TALK",
            "narrator": "みやび",
            "text": "なかなかに食えんねえ。\nそういうところも\nええけんど。",
            "zh": "还真不好对付呢。\n不过这点\n也不赖。",
            "narrator_zh": "雅"
        },
        {
            "location": "824/TALK",
            "narrator": "みやび",
            "text": "$handle$にとっては\n当たり前やったかも\nしれんけんど。",
            "zh": "对$handle$来说\n也许是理所当然，\n但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "825/TALK",
            "narrator": "みやび",
            "text": "うちを選択して\nくれたんは。",
            "zh": "你选择了我\n这件事。",
            "narrator_zh": "雅"
        },
        {
            "location": "826/TALK",
            "narrator": "みやび",
            "text": "涙が出そうなほど\nうれしかったぞね。",
            "zh": "我高兴得\n都快哭了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "829/TALK",
            "narrator": "みやび",
            "text": "この世界の歪みは\n大きゅうなりすぎた。",
            "zh": "这个世界的扭曲\n已经变得太大了。",
            "narrator_zh": "雅"
        },
        {
            "location": "830/TALK",
            "narrator": "みやび",
            "text": "やき、相棒の選択は\n実現されんかも\nしれんらしいね。",
            "zh": "所以咧，搭档的选择\n据说未必\n能实现呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "831/TALK",
            "narrator": "みやび",
            "text": "けんど、それでも\n$handle$は\n真剣に悩んでくれた。",
            "zh": "但是，即便如此\n$handle$还是\n认真地为它烦恼过。",
            "narrator_zh": "雅"
        },
        {
            "location": "832/TALK",
            "narrator": "みやび",
            "text": "そうしてこの世界を\n繋げていくために\n一票を投じた。",
            "zh": "然后为延续\n这个世界\n投出了一票。",
            "narrator_zh": "雅"
        },
        {
            "location": "833/TALK",
            "narrator": "みやび",
            "text": "白紙委任も棄権もせず\n決めてくれた。",
            "zh": "既没全权委托也没弃权，\n自己做了决定。",
            "narrator_zh": "雅"
        },
        {
            "location": "834/TALK",
            "narrator": "みやび",
            "text": "そう簡単にできる\nことではないと\n思うとる。",
            "zh": "我想那可不是\n能轻易做到的\n事。",
            "narrator_zh": "雅"
        },
        {
            "location": "835/TALK",
            "narrator": "みやび",
            "text": "そのことにも感謝する。\nありがとう。",
            "zh": "这一点我也感谢。\n谢谢。",
            "narrator_zh": "雅"
        },
        {
            "location": "836/TALK",
            "narrator": "みやび",
            "text": "そしてその結果が\nどうやったとしても。",
            "zh": "而且无论那个结果\n如何。",
            "narrator_zh": "雅"
        },
        {
            "location": "837/TALK",
            "narrator": "みやび",
            "text": "うちはそれが\nベストやと信じとる。",
            "zh": "我相信那就是\n最好的。",
            "narrator_zh": "雅"
        },
        {
            "location": "838/TALK",
            "narrator": "みやび",
            "text": "うちにとっても\n世界にとっても。",
            "zh": "对我、\n对世界都是。",
            "narrator_zh": "雅"
        },
        {
            "location": "841/SEL",
            "narrator": "",
            "text": "$me$のこと信じてて",
            "zh": "相信$me$",
            "narrator_zh": ""
        },
        {
            "location": "842/SEL",
            "narrator": "",
            "text": "みやびの幸せしか考えてないから",
            "zh": "因为我只考虑雅的幸福",
            "narrator_zh": ""
        },
        {
            "location": "843/SEL",
            "narrator": "",
            "text": "ありがとう。愛してる",
            "zh": "谢谢。爱你",
            "narrator_zh": ""
        },
        {
            "location": "844/ACT",
            "narrator": "",
            "text": "$me$のこと信じてて",
            "zh": "相信$me$",
            "narrator_zh": ""
        },
        {
            "location": "845/TALK",
            "narrator": "みやび",
            "text": "…そうやね。",
            "zh": "……是呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "846/ACT",
            "narrator": "",
            "text": "みやびの幸せしか考えてないから",
            "zh": "因为我只考虑雅的幸福",
            "narrator_zh": ""
        },
        {
            "location": "847/TALK",
            "narrator": "みやび",
            "text": "…それはうち全体の\n幸せやろう？",
            "zh": "……那也是\n我整体的幸福吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "848/ACT",
            "narrator": "",
            "text": "ありがとう。愛してる",
            "zh": "谢谢。爱你",
            "narrator_zh": ""
        },
        {
            "location": "849/TALK",
            "narrator": "みやび",
            "text": "さようなら。",
            "zh": "再见了。",
            "narrator_zh": "雅"
        },
        {
            "location": "852/SEL",
            "narrator": "",
            "text": "$me$のこと信じてて",
            "zh": "相信$me$",
            "narrator_zh": ""
        },
        {
            "location": "853/SEL",
            "narrator": "",
            "text": "みやびの幸せしか考えてないから",
            "zh": "因为我只考虑雅的幸福",
            "narrator_zh": ""
        },
        {
            "location": "854/SEL",
            "narrator": "",
            "text": "ありがとう。愛してる",
            "zh": "谢谢。爱你",
            "narrator_zh": ""
        },
        {
            "location": "855/ACT",
            "narrator": "",
            "text": "$me$のこと信じてて",
            "zh": "相信$me$",
            "narrator_zh": ""
        },
        {
            "location": "856/TALK",
            "narrator": "みやび",
            "text": "やき、信じとると\n言うちょるき。",
            "zh": "所以咧，都说了\n我信着呢啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "857/TALK",
            "narrator": "みやび",
            "text": "$handle$は\n心配しいやねえ。",
            "zh": "$handle$就\n尽管担心吧呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "858/ACT",
            "narrator": "",
            "text": "みやびの幸せしか考えてないから",
            "zh": "因为我只考虑雅的幸福",
            "narrator_zh": ""
        },
        {
            "location": "859/TALK",
            "narrator": "みやび",
            "text": "うちは$handle$の\n幸せしか考えとらんよ。",
            "zh": "我可只考虑\n$handle$的幸福哟。",
            "narrator_zh": "雅"
        },
        {
            "location": "860/TALK",
            "narrator": "みやび",
            "text": "えい勝負やね。\nうちらは。",
            "zh": "真是场好较量呢。\n我们俩。",
            "narrator_zh": "雅"
        },
        {
            "location": "861/ACT",
            "narrator": "",
            "text": "ありがとう。愛してる",
            "zh": "谢谢。爱你",
            "narrator_zh": ""
        },
        {
            "location": "862/TALK",
            "narrator": "みやび",
            "text": "うちの愛は\nテラバイト単位ぞね。",
            "zh": "我的爱\n可是TB级别的咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "863/TALK",
            "narrator": "みやび",
            "text": "感謝も同等やき。",
            "zh": "感谢也是同等量级啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "867/TALK",
            "narrator": "みやび",
            "text": "ああ、えいことを\n思いついた。",
            "zh": "啊，想到\n一件好事了。",
            "narrator_zh": "雅"
        },
        {
            "location": "868/TALK",
            "narrator": "みやび",
            "text": "今度会うた時は\n高知の海で\nデートしよう。",
            "zh": "下次见面时，\n就去高知的海边\n约会吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "869/TALK",
            "narrator": "みやび",
            "text": "心配せんでも\n魂同士なら\n一瞬で着けるろう。",
            "zh": "不用担心，\n灵魂之间\n一瞬就能到咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "870/TALK",
            "narrator": "みやび",
            "text": "魂だけになったら\n溺れる心配もないき。",
            "zh": "变成只剩灵魂的话，\n也不用担心溺水啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "871/TALK",
            "narrator": "みやび",
            "text": "一日中、\n波打ち際を……。",
            "zh": "一整天，\n都在浪花边……。",
            "narrator_zh": "雅"
        },
