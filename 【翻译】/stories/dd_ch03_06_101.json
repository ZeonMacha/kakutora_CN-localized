{
    "dir": "chap06/daydra/dd_ch03_06_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "6302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "出陣【Case：ガブリエラ】＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "出阵【Case：加布里埃拉】＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "出陣【ギャヴィから見たCase】",
            "zh": "出阵【从加维看到的Case】",
            "narrator_zh": ""
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "逢瀬さん？",
            "zh": "逢濑？",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "は、はいっ！？",
            "zh": "是、是的！？",
            "narrator_zh": "燕"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "そんなに緊張しないでも\n平気よ。",
            "zh": "不用那么紧张\n也没关系。",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "つばめ",
            "text": "す、すみません…。\nわたし、こういうのって\n初めてで…。",
            "zh": "对、对不起……。\n我，这种事\n是第一次……。",
            "narrator_zh": "燕"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "ドームで経験してる\nじゃない。",
            "zh": "穹顶里不是\n经历过了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "そうだけど、あの時は\nこんなに暗いところじゃ\nなかったし…。",
            "zh": "是这样，可那时候\n没有这么暗\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "…何でそんなことも\n知らないのよ、この子？",
            "zh": "……这种事都不知道，\n这孩子怎么回事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "まさかまほ、事前に何も\n教えなかったわけ？",
            "zh": "难道真幌事先\n什么都没教？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "つばめ",
            "text": "――えぇっ！？\nそ、それじゃわたし達も\n危ないじゃないですか！",
            "zh": "——诶诶！？\n那、那样的话我们\n不也很危险吗！",
            "narrator_zh": "燕"
        },
        {
            "location": "71/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…ねえ、アーヤ。\nやっぱあたし達だけで\n行った方が良くない？",
            "zh": "哈啊……呐，绫水。\n果然还是只有我们\n去比较好吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "何もわかってない子を\n連れてったって、\n足手まといになるだけよ。",
            "zh": "什么都不懂的孩子\n带去的话，\n只会成为累赘。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと、ギャヴィ。\nそういう言い方は…。",
            "zh": "等等，加维。\n那种说法……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "事実を言ったまでよ。",
            "zh": "我只是说了事实。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "い、いいんです。\n勉強不足なわたしが\n悪いんだし…。",
            "zh": "没、没关系。\n是我学习不足\n不好……。",
            "narrator_zh": "燕"
        },
        {
            "location": "81/TALK",
            "narrator": "つばめ",
            "text": "ごめんね、えと…\nガブリエラちゃん。",
            "zh": "对不起，那个……\n加布里埃拉。",
            "narrator_zh": "燕"
        },
        {
            "location": "84/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたは\n“ちゃん”付け禁止。",
            "zh": "你\n不准加亲昵称呼。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "冗談じゃない。何が\nガブリエラちゃんよ！？",
            "zh": "开什么玩笑。什么\n加布里埃拉呀！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな風に呼ばれるほど、\n親しくもないのに。",
            "zh": "我们又没有亲到\n可以那样叫。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、アーヤも\n新人のこと庇い過ぎよ。",
            "zh": "而且，绫水也\n太护着新人了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしだって、\nイジワルで言ってる\nわけじゃないんだから。",
            "zh": "我又不是\n为了使坏\n才说的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "つばめ",
            "text": "あ、あの、その…。",
            "zh": "那、那个，这个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "94/TALK",
            "narrator": "つばめ",
            "text": "大丈夫ですよね？\nだって、皆さんとっても\n強いし…。",
            "zh": "没问题吧？\n因为大家\n都很强……。",
            "narrator_zh": "燕"
        },
        {
            "location": "95/TALK",
            "narrator": "アーヤ",
            "text": "…だといいけど。",
            "zh": "……那样就好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "…っていうか、あんたが\n言うな、って話よね。",
            "zh": "……话说，这话\n轮不到你说吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "101/TALK",
            "narrator": "ガブリエラ",
            "text": "フェノメノンの中で、\n生身で発症者と戦って――",
            "zh": "在PhenoMENON里，\n用肉体和发病者战斗——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "素手でクランを引き剥がす\nなんて芸当、あたし達でも\nできないわ。",
            "zh": "徒手把库兰撕下来\n这种本事，连我们\n都做不到。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなあんたに、\n強いとか言われてもね。",
            "zh": "被那样的你\n说强，也没什么用。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、そういう言い方\nしないの。",
            "zh": "加维，别用\n那种说法。",
            "narrator_zh": "绫水"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "だって本当のことじゃん。",
            "zh": "因为是事实啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "アーヤ",
            "text": "ごめんね、逢瀬さん。\nギャヴィの言ったことは\n気にしないで。",
            "zh": "对不起，逢濑。\n加维说的话\n你别在意。",
            "narrator_zh": "绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱり、新人のこと\nばかり庇ってる。",
            "zh": "……果然，只护着\n新人。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ…あたしのこと、\n嫌いになっちゃったの…？",
            "zh": "绫水……是不是\n开始讨厌我了……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "ガブリエラ",
            "text": "…ううん、違うわ。",
            "zh": "……不，不对。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "118/TALK",
            "narrator": "ガブリエラ",
            "text": "逆よ！\n嫌ってるのはあたしの方\nなんだから！",
            "zh": "反过来！\n讨厌的是我\n这边！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの好きだった、\n剣道大会で見たアーヤは、\nもういないのよ。",
            "zh": "我喜欢过的、\n在剑道大会上看到的绫水，\n已经不在了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/TALK",
            "narrator": "ガブリエラ",
            "text": "家が大事だからとかいう\n理由で、剣道を辞めた\n今のあいつは――",
            "zh": "因为家里重要之类的\n理由，放弃剑道的\n现在的她——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "121/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの好きだった\nアーヤの、抜け殻なん\nだから！",
            "zh": "是我喜欢过的\n绫水的空壳\n而已！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "150/TALK",
            "narrator": "つばめ",
            "text": "あの、せんぱい。",
            "zh": "那个，前辈。",
            "narrator_zh": "燕"
        },
        {
            "location": "152/TALK",
            "narrator": "ガブリエラ",
            "text": "…何よ？",
            "zh": "……什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "153/TALK",
            "narrator": "つばめ",
            "text": "え、えっと…。",
            "zh": "那、那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "154/TALK",
            "narrator": "つばめ",
            "text": "…よかったら、\nわたしと手を繋いで\nもらえませんか？",
            "zh": "……如果可以的话，\n能和我\n牵手吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "155/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "は？　いや、何？\n急に何言い出すの？",
            "zh": "哈？　不，什么？\n突然说什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "160/TALK",
            "narrator": "つばめ",
            "text": "だ、だって、こんな\n不気味なところ\n歩いてると――",
            "zh": "因、因为，走在\n这么阴森的\n地方——",
            "narrator_zh": "燕"
        },
        {
            "location": "161/TALK",
            "narrator": "つばめ",
            "text": "何か不安な気持ちに\nなってくるじゃない\nですか。",
            "zh": "会变得\n不安起来\n不是吗。",
            "narrator_zh": "燕"
        },
        {
            "location": "162/TALK",
            "narrator": "つばめ",
            "text": "だから、よかったら\n手を握ってもらえたら\n嬉しいなぁ、って…。",
            "zh": "所以，如果可以\n能握着你的手\n我会很高兴……。",
            "narrator_zh": "燕"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "164/TALK",
            "narrator": "ガブリエラ",
            "text": "…何やってんだろ、\nあたし。",
            "zh": "……我在干什么啊，\n我自己。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "新人の方から、\nこんなに近寄ろうと\nしてくれてるのに――",
            "zh": "新人那边，\n都这么想靠近\n了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "166/TALK",
            "narrator": "ガブリエラ",
            "text": "変に意地張って、\n酷い態度ばかり\n取って…。",
            "zh": "我却别扭，\n净是态度\n很差……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "168/TALK",
            "narrator": "ガブリエラ",
            "text": "…この子だって、\nきっと不安なのよね。",
            "zh": "……这孩子也\n一定很不安吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "169/TALK",
            "narrator": "ガブリエラ",
            "text": "…この手を握れば、\n仲直りできる…かな？",
            "zh": "……握住这只手，\n就能和好……吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "215/TALK",
            "narrator": "ガブリエラ",
            "text": "また来てくれたのね！\nようこそ[ココロゲート]へ！",
            "zh": "又来了！\n欢迎来到[心之扉]！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ今回も\n扉を回すわね♪",
            "zh": "那就这次也\n转动门吧♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/TALK",
            "narrator": "ガブリエラ",
            "text": "オープンプロセス、\n0x773番地から\n0xCEF番地へ。",
            "zh": "开放进程，\n从0x773地址\n到0xCEF地址。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/TALK",
            "narrator": "ガブリエラ",
            "text": "シーク完了っ♪",
            "zh": "搜索完成♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "でも今回は、\n何を迷ってるかなんて\n既に知ってるのよね～♪",
            "zh": "可是这次，\n在犹豫什么\n我已经知道了～♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめと手を繋ぐか\nどうしよっか\n迷ってるのよ、あたし！",
            "zh": "要不要和燕牵手，\n我正在\n犹豫呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/SEL",
            "narrator": "",
            "text": "どうしてそんな乗り気なの？",
            "zh": "为什么这么起劲？",
            "narrator_zh": ""
        },
        {
            "location": "243/ACT",
            "narrator": "",
            "text": "どうしてそんな乗り気なの？",
            "zh": "为什么这么起劲？",
            "narrator_zh": ""
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラ",
            "text": "だってあたし、\n意地っ張り過ぎ\nなんだもん。",
            "zh": "因为我\n太别扭\n了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "246/TALK",
            "narrator": "ガブリエラ",
            "text": "[ココロゲート]から\n日々自分を見守っていて、\nイライラするのよね。",
            "zh": "从[心之扉]\n天天看着自己，\n真让人着急。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "でもここで手を繋ぐ事が\nできたら、きっと関係が\nステップアップするわ！",
            "zh": "可是在这里能牵上手的话，\n关系一定\n会更进一步！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "きっと数少ない\n素敵なお友達になれると\nおもうのよ♪",
            "zh": "一定能成为\n为数不多的\n好朋友♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/SEL",
            "narrator": "",
            "text": "じゃあ、その期待に添いましょうか",
            "zh": "那就回应这份期待吧",
            "narrator_zh": ""
        },
        {
            "location": "250/ACT",
            "narrator": "",
            "text": "じゃあ、その期待に添いましょうか",
            "zh": "那就回应这份期待吧",
            "narrator_zh": ""
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラ",
            "text": "ホント！？\nありがとう♪",
            "zh": "真的！？\n谢谢♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、手を繋ぎたい\n気持ちを阻むクランを\nやっつけちゃってくれる？",
            "zh": "那就，把挡住\n想牵手的心情的库兰\n打倒好吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！",
            "zh": "献给我和\n$handle$的，\n美妙的心灵之旅！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月9日　1:45 PM</color>\nWAVE戦フェノメノン内部へ向かう途中、不確定量子の繭の中にて。",
            "zh": "<color=green>5月9日　1:45 PM</color>\n前往WAVE战PhenoMENON内部途中，在不确定量子的茧里。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "181/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch03",
