{
    "dir": "chap14/daydra/anime_01_14.js",
    "type": "MainStory",
    "info": {
        "story_id": "14101",
        "cid": "tsubame",
        "title": "001 アニメーション",
        "sub_title": "EXE_AYAMi",
        "title_zh": "001 动画",
        "sub_title_zh": "EXE_AYAMi"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "アニメ第11話",
            "zh": "动画第11话",
            "narrator_zh": ""
        },
        {
            "location": "49/TALK",
            "narrator": "千羽鶴",
            "text": "ごきげんよう。\n今週も國政綾水強化週間の\n千羽鶴です。",
            "zh": "贵安。\n我是本周依然处于国政绫水\n强化周的千羽鹤。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "50/TALK",
            "narrator": "千羽鶴",
            "text": "今回はMV回だから、\n國政綾水のMVを\n再生するだけにしていい？",
            "zh": "因为这一次是MV回，\n只播放国政绫水的MV\n就可以了吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "51/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是的",
            "narrator_zh": ""
        },
        {
            "location": "52/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "不是",
            "narrator_zh": ""
        },
        {
            "location": "53/SEL",
            "narrator": "",
            "text": "MVの再生すら不要",
            "zh": "连MV也不用播放了",
            "narrator_zh": ""
        },
        {
            "location": "54/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是的",
            "narrator_zh": ""
        },
        {
            "location": "56/TALK",
            "narrator": "千羽鶴",
            "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。",
            "zh": "太好了。\n我也省事了。\n这才是WIN-WIN啊。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "58/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不是",
            "narrator_zh": ""
        },
        {
            "location": "59/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "知道了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "61/ACT",
            "narrator": "",
            "text": "MVの再生すら不要",
            "zh": "连MV也不用播放了",
            "narrator_zh": ""
        },
        {
            "location": "63/TALK",
            "narrator": "千羽鶴",
            "text": "そう。\nそれじゃここでお別れね。",
            "zh": "是吗。\n那就在这里道别吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "64/TALK",
            "narrator": "千羽鶴",
            "text": "また今度。",
            "zh": "下次再见。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "69/TALK",
            "narrator": "千羽鶴",
            "text": "ごきげんよう、\n$handle$。",
            "zh": "贵安，\n$handle$。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "70/TALK",
            "narrator": "千羽鶴",
            "text": "前回予告したとおり、\n今回は國政綾水の\nMVをお披露目する。",
            "zh": "正如上回预告的那样，\n这一次将为你揭晓\n国政绫水的MV。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "71/TALK",
            "narrator": "千羽鶴",
            "text": "けど、その前に１つ、\n補足しなければならない\nことがある。",
            "zh": "不过，在此之前有件事\n我必须先补充\n说明一下。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "72/TALK",
            "narrator": "千羽鶴",
            "text": "前回、トライナリー一人\nずつ順番にMVをお披露目\nしていくと伝えた。",
            "zh": "上回我说过，打算按顺序\n逐一揭晓三重奏每个人的\nMV。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "73/TALK",
            "narrator": "千羽鶴",
            "text": "その後情報をリサーチ\nしていると、ちらほらと\nこんな噂が流れてきた。",
            "zh": "结果之后我调研情报时，\n零星听到了外面流传着\n这样的谣言。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "74/TALK",
            "narrator": "千羽鶴",
            "text": "『これから５回連続で\nMV回みたいだから――』",
            "zh": "『听说接下来好像要连续\n5回都是MV回呢——』",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "76/TALK",
            "narrator": "千羽鶴",
            "text": "……。\nまずは私の伝え方が\n良くなかったと反省。",
            "zh": "……。\n首先我要反省一下，\n是我自己没传达清楚。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "77/TALK",
            "narrator": "千羽鶴",
            "text": "結論から言えば、\nMVは連続では配信しない。",
            "zh": "先说结论，\nMV并不会连续发布。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "78/TALK",
            "narrator": "千羽鶴",
            "text": "その子が一番輝けると\n思った瞬間に、サッと\n差し込んでいくつもり。",
            "zh": "我打算在觉得那个孩子\n最闪耀的瞬间，顺势\n插播进去。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "79/TALK",
            "narrator": "千羽鶴",
            "text": "だから、次はまた少し\n記録映像が進んでから\n公開したいと思ってる。",
            "zh": "所以，下一支MV我打算等\n记录影像再推进一些后\n再行公开。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "80/TALK",
            "narrator": "千羽鶴",
            "text": "次回は普通に\n記録映像を配信するから、\nそのつもりで。",
            "zh": "下一回会正常发布\n记录影像，还请你\n做好心理准备。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "81/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、改めて。\n今回は國政綾水の\nスペシャルMV回。",
            "zh": "那么，言归正传。\n这一次是国政绫水的\n特别MV回。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "82/TALK",
            "narrator": "千羽鶴",
            "text": "今回に関しては、\n解説をするという事自体\n野暮なこと。",
            "zh": "关于这一回，\n再去解说这件事本身\n就太不解风情了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "83/TALK",
            "narrator": "千羽鶴",
            "text": "よって、私から特に何か\n解説をしたりはしない。",
            "zh": "因此，我这边不会\n特意去做任何解说。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "84/TALK",
            "narrator": "千羽鶴",
            "text": "そしてなんと！\n今回は「あらすじ」も\n用意していない。",
            "zh": "而且竟然！\n这一次连「剧情提要」\n都没有准备。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "85/SEL",
            "narrator": "",
            "text": "ですよねー",
            "zh": "也是呢——",
            "narrator_zh": ""
        },
        {
            "location": "86/SEL",
            "narrator": "",
            "text": "ないの！？",
            "zh": "没有吗！？",
            "narrator_zh": ""
        },
        {
            "location": "87/ACT",
            "narrator": "",
            "text": "ですよねー",
            "zh": "也是呢——",
            "narrator_zh": ""
        },
        {
            "location": "88/TALK",
            "narrator": "千羽鶴",
            "text": "わかってくれて\nとても嬉しい。",
            "zh": "你能理解\n我真是太高兴了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "89/TALK",
            "narrator": "千羽鶴",
            "text": "MVのあらすじなんて、\n私のポエムを披露するか\n1行でおわるかどちらか。",
            "zh": "MV的剧情提要什么的，\n不是得献丑朗诵我的诗，\n就是1句话写完，二选一。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "90/TALK",
            "narrator": "千羽鶴",
            "text": "どちらにしても、\nあまり私に利益がない。",
            "zh": "不管选哪一种，\n对我来说都没什么好处。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "91/ACT",
            "narrator": "",
            "text": "ないの！？",
            "zh": "没有吗！？",
            "narrator_zh": ""
        },
        {
            "location": "92/TALK",
            "narrator": "千羽鶴",
            "text": "MVのあらすじって\n確かになかなか斬新。",
            "zh": "MV的剧情提要\n确实听起来挺新奇的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "93/TALK",
            "narrator": "千羽鶴",
            "text": "本当の事をいえば、\nネタ的にちょっと\n美味しいかもとは思った。",
            "zh": "说实话，从玩梗的角度\n我也觉得说不定\n还挺有意思的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "94/TALK",
            "narrator": "千羽鶴",
            "text": "けど、自分の恥ずかしい\nポエムを晒すことになる\nことに気づき、やめた。",
            "zh": "但转念一想，那样岂不是\n要把自己羞耻的诗作\n公之于众，于是就作罢了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "96/SEL",
            "narrator": "",
            "text": "千羽鶴のポエムが見たかった",
            "zh": "好想看千羽鹤写的诗啊",
            "narrator_zh": ""
        },
        {
            "location": "97/SEL",
            "narrator": "",
            "text": "ポエムは鳥肌が立つから遠慮します",
            "zh": "看诗会起鸡皮疙瘩还是免了",
            "narrator_zh": ""
        },
        {
            "location": "98/ACT",
            "narrator": "",
            "text": "千羽鶴のポエムが見たかった",
            "zh": "好想看千羽鹤写的诗啊",
            "narrator_zh": ""
        },
        {
            "location": "99/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "100/TALK",
            "narrator": "千羽鶴",
            "text": "それ、本気で言ってる？",
            "zh": "你这话，是认真的吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "101/SEL",
            "narrator": "",
            "text": "本気です",
            "zh": "认真的",
            "narrator_zh": ""
        },
        {
            "location": "102/SEL",
            "narrator": "",
            "text": "冗談です",
            "zh": "开玩笑的",
            "narrator_zh": ""
        },
        {
            "location": "103/ACT",
            "narrator": "",
            "text": "本気です",
            "zh": "认真的",
            "narrator_zh": ""
        },
        {
            "location": "105/TALK",
            "narrator": "千羽鶴",
            "text": "……なんて無謀な。",
            "zh": "……真是太莽撞了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "106/TALK",
            "narrator": "千羽鶴",
            "text": "後で後悔しても\n責任は持てないから。",
            "zh": "就算事后后悔，\n我可不负责哦。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "109/ACT",
            "narrator": "",
            "text": "冗談です",
            "zh": "开玩笑的",
            "narrator_zh": ""
        },
        {
            "location": "110/TALK",
            "narrator": "千羽鶴",
            "text": "そう。\nそれならいいけど。",
            "zh": "是吗。\n那就好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "112/ACT",
            "narrator": "",
            "text": "ポエムは鳥肌が立つから遠慮します",
            "zh": "看诗会起鸡皮疙瘩还是免了",
            "narrator_zh": ""
        },
        {
            "location": "113/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。\nそれが身のため。",
            "zh": "是啊。\n那样才是明智之举。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "114/TALK",
            "narrator": "千羽鶴",
            "text": "私のポエムなんて、\n見たらきっと脳が壊れる。",
            "zh": "要是看了我写的诗，\n大脑肯定会坏掉的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "117/TALK",
            "narrator": "千羽鶴",
            "text": "何にしても、今回は\n私も多くは語らず、\n彼女を見ようと思う。",
            "zh": "不管怎样，这一次\n我也不再多言，\n打算静静欣赏她。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "118/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで\nどうする？",
            "zh": "那么，\n你怎么选？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "121/SEL",
            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/45MB 2:49】</color>",
            "zh": "观看影像\n<color=green>【高画质/45MB 2:49】</color>",
            "narrator_zh": ""
        },
        {
            "location": "122/SEL",
            "narrator": "",
            "text": "映像を見る\n<color=green>【標準画質/14MB 2:49】</color>",
            "zh": "观看影像\n<color=green>【标准画质/14MB 2:49】</color>",
            "narrator_zh": ""
        },
        {
            "location": "123/SEL",
            "narrator": "",
            "text": "$poemwd$",
            "zh": "$poemwd$",
            "narrator_zh": ""
        },
        {
            "location": "124/ACT",
            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/45MB 2:49】</color>",
            "zh": "观看影像\n<color=green>【高画质/45MB 2:49】</color>",
            "narrator_zh": ""
        },
        {
            "location": "125/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "131/ACT",
            "narrator": "",
            "text": "映像を見る\n<color=green>【標準画質/14MB 2:49】</color>",
            "zh": "观看影像\n<color=green>【标准画质/14MB 2:49】</color>",
            "narrator_zh": ""
        },
        {
            "location": "132/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "139/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "175/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\n素敵なMVだった。",
            "zh": "总而言之，\n真是部很棒的MV。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "176/TALK",
            "narrator": "千羽鶴",
            "text": "これで貴方の\n國政綾水へのラブラブ度は\nうなぎ登りだと思うけど。",
            "zh": "我想你对国政绫水的\n恋爱度应该也随之\n直线飙升了吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "178/SEL",
            "narrator": "",
            "text": "アーヤがとても魅力的だった",
            "zh": "绫水非常有魅力",
            "narrator_zh": ""
        },
        {
            "location": "179/SEL",
            "narrator": "",
            "text": "音楽がよかった",
            "zh": "音乐很棒",
            "narrator_zh": ""
        },
        {
            "location": "180/SEL",
            "narrator": "",
            "text": "あの電話はなんの電話だったの？",
            "zh": "那个电话是谁打来的啊？",
            "narrator_zh": ""
        },
        {
            "location": "181/SEL",
            "narrator": "",
            "text": "アーヤってエロいよね",
            "zh": "绫水好色气啊",
            "narrator_zh": ""
        },
        {
            "location": "182/SEL",
            "narrator": "",
            "text": "次の子のMVはいつ配信されますか？",
            "zh": "下一个孩子的MV什么时候发布？",
            "narrator_zh": ""
        },
        {
            "location": "183/SEL",
            "narrator": "",
            "text": "千羽鶴のMVはいつ出ますか？",
            "zh": "千羽鹤的MV什么时候出？",
            "narrator_zh": ""
        },
        {
            "location": "184/SEL",
            "narrator": "",
            "text": "特にない \n<color=blue>（※先へ進みます）</color>",
            "zh": "没什么特别的\n<color=blue>（※继续往下）</color>",
            "narrator_zh": ""
        },
        {
            "location": "185/ACT",
            "narrator": "",
            "text": "アーヤがとても魅力的だった",
            "zh": "绫水非常有魅力",
            "narrator_zh": ""
        },
        {
            "location": "186/TALK",
            "narrator": "千羽鶴",
            "text": "よかった。\n狙い通りに楽しんで\nもらえたみたいで。",
            "zh": "太好了。\n看来如我所愿，\n你看得很开心。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "187/TALK",
            "narrator": "千羽鶴",
            "text": "これを機に、是非\n國政綾水とラブラブして\nみてほしい。",
            "zh": "借着这个机会，请务必\n试着和国政绫水\n腻歪亲热一下吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "188/TALK",
            "narrator": "千羽鶴",
            "text": "きっと彼女の、いつもと\n違った魅力的な一面が\n見られるはずだから。",
            "zh": "因为你一定能看到\n她和平时不一样、\n充满魅力的一面。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "189/TALK",
            "narrator": "千羽鶴",
            "text": "他は？",
            "zh": "还有别的吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "191/ACT",
            "narrator": "",
            "text": "音楽がよかった",
            "zh": "音乐很棒",
            "narrator_zh": ""
        },
        {
            "location": "192/TALK",
            "narrator": "千羽鶴",
            "text": "そう。\nそれはよかった。",
            "zh": "是吗。\n那真是太好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "193/TALK",
            "narrator": "千羽鶴",
            "text": "そんな貴方に朗報。",
            "zh": "告诉这样的你一个好消息。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "194/TALK",
            "narrator": "千羽鶴",
            "text": "このMVの配信と同時に、\n然るべき場所で歌曲の\nフルVerも公開してる。",
            "zh": "就在这支MV发布的同时，\n在对应的地方也公开了\n歌曲的完整版。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "195/TALK",
            "narrator": "千羽鶴",
            "text": "興味があれば、是非\n探して聞いてみると\nいいかも。",
            "zh": "如果有兴趣的话，\n不妨去找来\n听听看哦。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "196/TALK",
            "narrator": "千羽鶴",
            "text": "國政綾水のココロを\nもっとよく知ることが\nできると思うから。",
            "zh": "我想这能让你\n更加深入地了解\n国政绫水的内心。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "197/TALK",
            "narrator": "千羽鶴",
            "text": "他は？",
            "zh": "还有别的吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "199/ACT",
            "narrator": "",
            "text": "あの電話はなんの電話だったの？",
            "zh": "那个电话是谁打来的啊？",
            "narrator_zh": ""
        },
        {
            "location": "200/TALK",
            "narrator": "千羽鶴",
            "text": "それはひみつ。",
            "zh": "这是秘密。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "201/TALK",
            "narrator": "千羽鶴",
            "text": "気になるなら、\n國政綾水に直接\n聞いてみるといい。",
            "zh": "如果很在意的话，\n直接去问国政绫水\n就好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "202/TALK",
            "narrator": "千羽鶴",
            "text": "例えば、\n「一緒にアニメを見る」\nのところとかで。",
            "zh": "比方说，\n在「一起看动画」\n的时候之类的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "203/TALK",
            "narrator": "千羽鶴",
            "text": "今回、彼女のたっての\n希望で、貴方と二人きりで\n見ることになってる。",
            "zh": "这一次，应她本人的\n强烈要求，决定由她和你\n两个人单独一起看。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "204/TALK",
            "narrator": "千羽鶴",
            "text": "いつもとは違う、甘い\nムードに満ち溢れると\n思うから、是非。",
            "zh": "我想一定会充满和平时\n截然不同的甜蜜氛围，\n请务必去看看。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "205/TALK",
            "narrator": "千羽鶴",
            "text": "他は？",
            "zh": "还有别的吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "207/ACT",
            "narrator": "",
            "text": "アーヤってエロいよね",
            "zh": "绫水好色气啊",
            "narrator_zh": ""
        },
        {
            "location": "208/TALK",
            "narrator": "千羽鶴",
            "text": "是非本人に\n直接言ってあげて。",
            "zh": "请务必直接去对她\n本人说这句话。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "209/TALK",
            "narrator": "千羽鶴",
            "text": "とっても喜ぶと思うから。",
            "zh": "我想她一定会非常开心的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "210/TALK",
            "narrator": "千羽鶴",
            "text": "他は？",
            "zh": "还有别的吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "212/ACT",
            "narrator": "",
            "text": "次の子のMVはいつ配信されますか？",
            "zh": "下一个孩子的MV什么时候发布？",
            "narrator_zh": ""
        },
        {
            "location": "213/TALK",
            "narrator": "千羽鶴",
            "text": "それはまだ\n公表できない。",
            "zh": "那个现在还\n不能公布。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "214/TALK",
            "narrator": "千羽鶴",
            "text": "私としては、この辺という\nアタリはつけているけど、\nもう少し待って欲しい。",
            "zh": "我个人心里倒是\n大概定了时间点，\n不过还请你再等等。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "215/TALK",
            "narrator": "千羽鶴",
            "text": "けど、そう遠くない時期に\nなると思うから、首を\n洗って待っていて。",
            "zh": "不过，应该不会等太久，\n你就洗干净脖子\n等着吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "216/TALK",
            "narrator": "千羽鶴",
            "text": "他は？",
            "zh": "还有别的吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "218/ACT",
            "narrator": "",
            "text": "千羽鶴のMVはいつ出ますか？",
            "zh": "千羽鹤的MV什么时候出？",
            "narrator_zh": ""
        },
        {
            "location": "219/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "220/SEL",
            "narrator": "",
            "text": "お",
            "zh": "哦",
            "narrator_zh": ""
        },
        {
            "location": "221/ACT",
            "narrator": "",
            "text": "お",
            "zh": "哦",
            "narrator_zh": ""
        },
        {
            "location": "225/TALK",
            "narrator": "千羽鶴",
            "text": "<size=40>私</size>",
            "zh": "<size=40>我</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "228/TALK",
            "narrator": "千羽鶴",
            "text": "<size=70>は</size>",
            "zh": "<size=70>不</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "231/TALK",
            "narrator": "千羽鶴",
            "text": "<size=100>非</size>",
            "zh": "<size=100>是</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "234/TALK",
            "narrator": "千羽鶴",
            "text": "<size=130>攻</size>",
            "zh": "<size=130>攻</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "237/TALK",
            "narrator": "千羽鶴",
            "text": "<size=170>略</size>",
            "zh": "<size=170>略</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "240/TALK",
            "narrator": "千羽鶴",
            "text": "<size=200>対</size>",
            "zh": "<size=200>对</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "243/TALK",
            "narrator": "千羽鶴",
            "text": "<size=230>象</size>",
            "zh": "<size=230>象</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "248/TALK",
            "narrator": "千羽鶴",
            "text": "わかった？",
            "zh": "明白了吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "249/SEL",
            "narrator": "",
            "text": "はい…",
            "zh": "是……",
            "narrator_zh": ""
        },
        {
            "location": "250/SEL",
            "narrator": "",
            "text": "味を占めたか",
            "zh": "这是尝到甜头了吗",
            "narrator_zh": ""
        },
        {
            "location": "251/ACT",
            "narrator": "",
            "text": "はい…",
            "zh": "是……",
            "narrator_zh": ""
        },
        {
            "location": "252/TALK",
            "narrator": "千羽鶴",
            "text": "よかった。",
            "zh": "太好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "253/ACT",
            "narrator": "",
            "text": "味を占めたか",
            "zh": "这是尝到甜头了吗",
            "narrator_zh": ""
        },
        {
            "location": "254/TALK",
            "narrator": "千羽鶴",
            "text": "それは\nこっちのセリフ。",
            "zh": "这句话该由\n我来说才对。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "255/TALK",
            "narrator": "千羽鶴",
            "text": "非攻略対象目覚まし、\nやはり必要かもしれない。",
            "zh": "非攻略对象语音闹钟，\n果然还是很有必要的吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "256/SEL",
            "narrator": "",
            "text": "是非",
            "zh": "请务必",
            "narrator_zh": ""
        },
        {
            "location": "257/SEL",
            "narrator": "",
            "text": "要らない",
            "zh": "不需要",
            "narrator_zh": ""
        },
        {
            "location": "258/ACT",
            "narrator": "",
            "text": "是非",
            "zh": "请务必",
            "narrator_zh": ""
        },
        {
            "location": "259/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。\n然るべきところに\n伝えておく。",
            "zh": "知道了。\n我会向有关部门\n转达的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "260/TALK",
            "narrator": "千羽鶴",
            "text": "特定人物攻略気力喪失\nサブリミナル音波を小さな\n音で仕込まないと……。",
            "zh": "得用极小的音量在里面\n植入丧失特定人物攻略\n干劲的潜意识音波才行……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "261/ACT",
            "narrator": "",
            "text": "要らない",
            "zh": "不需要",
            "narrator_zh": ""
        },
        {
            "location": "263/TALK",
            "narrator": "千羽鶴",
            "text": "…そう。",
            "zh": "…是吗。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "268/ACT",
            "narrator": "",
            "text": "特にない \n<color=blue>（※先へ進みます）</color>",
            "zh": "没什么特别的\n<color=blue>（※继续往下）</color>",
            "narrator_zh": ""
        },
        {
            "location": "270/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "知道了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "272/TALK",
            "narrator": "千羽鶴",
            "text": "今回は國政綾水に特化\nすることにした為、他の\nエピソードはない。",
            "zh": "因为这一次特意做成了\n国政绫水专场，所以没有\n其他人的剧情。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "273/TALK",
            "narrator": "千羽鶴",
            "text": "是非MVやバトル、まだ\n見ていない彼女とのらぶ\nとーくを楽しんで欲しい。",
            "zh": "请务必尽情享受MV、战斗，\n还有还没看过的与她的\n恋爱对谈吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "277/TALK",
            "narrator": "千羽鶴",
            "text": "そうそう。１つ貴方に\nボーナスプレゼントの\nお知らせがある。",
            "zh": "对了。还有一则\n特典礼物的通知\n要告诉你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "278/TALK",
            "narrator": "千羽鶴",
            "text": "國政綾水のエピソードを\nこのMVまで到達した人は\n全員ゲットできる。",
            "zh": "只要把国政绫水的剧情\n推进到这支MV的人，\n全员都可以拿到。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "279/TALK",
            "narrator": "千羽鶴",
            "text": "私との会話が終わったら、\n是非イベントクエストへ\n向かって欲しい。",
            "zh": "和我的对话结束后，\n请务必前往\n活动副本看看。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "284/TALK",
            "narrator": "千羽鶴",
            "text": "そこにも『EXE_AYAMi』\nというイベントがある。",
            "zh": "那里也有一个名为\n『EXE_AYAMi』的活动。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "285/TALK",
            "narrator": "千羽鶴",
            "text": "そこで、なかなか手に\n入りにくいプレゼント\nアイテム等がもらえる。",
            "zh": "在那里可以获得\n平时很难入手的\n礼物道具等奖励。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "290/TALK",
            "narrator": "千羽鶴",
            "text": "ここまで来てる人には\nもはや全プレレベルだから\n是非立ち寄ってみて。",
            "zh": "只要打到这里的人\n几乎等于全员白送了，\n务必去逛逛看。",
            "narrator_zh": "千羽鹤"
        },
