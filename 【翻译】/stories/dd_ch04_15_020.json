{
    "dir": "chap15/daydra/dd_ch04_15_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "15456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "忘れ物",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "遗失物"
    },
    "entry": [
        {
            "location": "247/SCENARIO",
            "narrator": "",
            "text": "忘れ物",
            "zh": "遗失物",
            "narrator_zh": ""
        },
        {
            "location": "273/TALK",
            "narrator": "雛",
            "text": "東雲教官、\nちょっといいですか？",
            "zh": "东云教官，\n方便占用一点时间吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "275/TALK",
            "narrator": "真幌",
            "text": "どうした？",
            "zh": "怎么了？",
            "narrator_zh": "真幌"
        },
        {
            "location": "276/TALK",
            "narrator": "雛",
            "text": "今、キリトと劇場内の\n清掃をしてたら、\n忘れ物を見つけたんです。",
            "zh": "我和圣翔刚才打扫\n剧场的时候，\n捡到了一件遗失物。",
            "narrator_zh": "雏"
        },
        {
            "location": "279/TALK",
            "narrator": "みやび",
            "text": "珍しいこともあるんやね。",
            "zh": "也会有这种稀罕事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "280/TALK",
            "narrator": "真幌",
            "text": "客が少ないからな。\nそれで、その忘れ物とは\n何なんだ？",
            "zh": "因为客人少嘛。\n那么，那个遗失物\n到底是什么？",
            "narrator_zh": "真幌"
        },
        {
            "location": "283/TALK",
            "narrator": "キリト",
            "text": "これっすよ。",
            "zh": "是这个哦。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "284/TALK",
            "narrator": "真幌",
            "text": "…本屋の紙袋か？",
            "zh": "…书店的纸袋啊？",
            "narrator_zh": "真幌"
        },
        {
            "location": "285/TALK",
            "narrator": "キリト",
            "text": "中に本もちゃんと\n入ってますよ。",
            "zh": "里面还好好地\n装着书哦。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "286/TALK",
            "narrator": "キリト",
            "text": "まあ、あんまり褒められた\n内容のもんじゃないっす\nけどね。",
            "zh": "嘛，虽然内容\n是不太能拿出手\n的东西啦。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "287/TALK",
            "narrator": "真幌",
            "text": "まったく…そんな本を\n忘れていくなんて、\nどんな奴なんだ？",
            "zh": "真是的……居然会把\n那种书忘在这儿，\n是个什么样的人啊？",
            "narrator_zh": "真幌"
        },
        {
            "location": "288/TALK",
            "narrator": "みやび",
            "text": "今日は二人しかお客は\n来てないがですよ。",
            "zh": "今天来的客人\n只有两位咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "289/TALK",
            "narrator": "みやび",
            "text": "確か、一人は四十代\nくらいのサラリーマン\nっぽい人で――",
            "zh": "记得一位是四十来岁、\n像是上班族的\n人——",
            "narrator_zh": "雅"
        },
        {
            "location": "290/TALK",
            "narrator": "みやび",
            "text": "もう一人はうちの学生さん\nだったはずですよ。",
            "zh": "另一位应该是我们的\n学生才对哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "291/TALK",
            "narrator": "雛",
            "text": "まあ、どっちが忘れたに\nしても、取りには来ないと\n思いますけどねー。",
            "zh": "嘛，不管是哪位忘的，\n我觉得都不会\n来取了。",
            "narrator_zh": "雏"
        },
        {
            "location": "292/TALK",
            "narrator": "真幌",
            "text": "小金井、一週間以内に\nその本を取りに来る奴が\nいなければ――",
            "zh": "小金井，一周之内\n要是没人来取\n那本书——",
            "narrator_zh": "真幌"
        },
        {
            "location": "293/TALK",
            "narrator": "真幌",
            "text": "持って帰っていいぞ。",
            "zh": "就拿回去吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "294/TALK",
            "narrator": "キリト",
            "text": "マジっすか！？\nよっしゃぁ！！",
            "zh": "真的吗！？\n好耶！！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "295/TALK",
            "narrator": "真幌",
            "text": "じゃあ、後は任せたぞ。",
            "zh": "那接下来就交给你了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "297/TALK",
            "narrator": "キリト",
            "text": "へへっ、一週間後が\n待ち遠しいぜ。",
            "zh": "嘿嘿，好期待\n一周后啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "300/TALK",
            "narrator": "みやび",
            "text": "男の子やねぇ…。",
            "zh": "男孩子就是咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "301/TALK",
            "narrator": "みやび",
            "text": "けんど、どんな本なのか\nちっくと気になるな…。",
            "zh": "但是，到底是什么书，\n有点让人在意啊……",
            "narrator_zh": "雅"
        },
        {
            "location": "302/TALK",
            "narrator": "みやび",
            "text": "キリト君、その本うちに\n貸してもらえんか？",
            "zh": "圣翔，那本书能\n借我看看咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "304/TALK",
            "narrator": "キリト",
            "text": "いいっすけど…\nあげないっすよ？",
            "zh": "借是行……\n可不会给你哦？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "307/TALK",
            "narrator": "雛",
            "text": "まだキリトの物じゃ\nないってば。",
            "zh": "那现在还不是\n圣翔的东西啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "309/TALK",
            "narrator": "みやび",
            "text": "いや、欲しいんやなくて、\nどんな本かが気になった\nだけやき。",
            "zh": "不，不是想要，\n只是好奇是什么书\n嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "312/TALK",
            "narrator": "雛",
            "text": "そういえば、あたしも\nまだ見てないんです\nよねー。",
            "zh": "说起来，就连我\n都还没\n看过呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "313/TALK",
            "narrator": "みやび",
            "text": "ふむ、どれどれ…。",
            "zh": "唔，让我瞧瞧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "314/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "315/TALK",
            "narrator": "雛",
            "text": "う、うわぁ…\nなんか、露骨というか、\n開放的というか…。",
            "zh": "唔、呜哇……\n总感觉，直白过头，\n或者说太奔放了……",
            "narrator_zh": "雏"
        },
        {
            "location": "316/TALK",
            "narrator": "みやび",
            "text": "うん…そうかぁ…\nキリト君はこういう系が\n好きなんやね？",
            "zh": "嗯…这样啊…\n圣翔喜欢的是这种\n类型的咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "317/TALK",
            "narrator": "雛",
            "text": "なんか、意外かも…。",
            "zh": "总觉得，有点意外……",
            "narrator_zh": "雏"
        },
        {
            "location": "320/TALK",
            "narrator": "キリト",
            "text": "う、うっせぇな！",
            "zh": "啰、啰嗦什么啊！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "321/TALK",
            "narrator": "キリト",
            "text": "健全な男なら、\n誰だってそういうのが\n好きなんだよ。",
            "zh": "健全的男人，\n不管是谁都会喜欢\n这种的好吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "322/TALK",
            "narrator": "みやび",
            "text": "…まあ、間違っては\nいないと思うけんど――",
            "zh": "…嘛，虽然觉得\n说得也没错——",
            "narrator_zh": "雅"
        },
        {
            "location": "323/TALK",
            "narrator": "みやび",
            "text": "しっかし…こんな本が\n売ってるんやね？",
            "zh": "不过…这种书\n居然有得卖咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "324/TALK",
            "narrator": "雛",
            "text": "ビックリですよね…。\nこれをレジに持って行ける\n神経が信じられません。",
            "zh": "很吃惊对吧……\n能把这种书拿到收银台\n结账的神经真是难以置信。",
            "narrator_zh": "雏"
        },
        {
            "location": "334/TALK",
            "narrator": "男子高校生",
            "text": "あ、あの！！\nすみません！！",
            "zh": "那、那个！！\n不好意思！！",
            "narrator_zh": "男高中生"
        },
        {
            "location": "337/TALK",
            "narrator": "キリト",
            "text": "ん？　誰だ？",
            "zh": "嗯？　是谁啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "338/TALK",
            "narrator": "キリト",
            "text": "じゃなくて、\nいらっしゃいませ！",
            "zh": "不对，\n欢迎光临！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "340/TALK",
            "narrator": "雛",
            "text": "申し訳ありません。\n本日の上映はもう\n終了で…。",
            "zh": "非常抱歉。\n今天的放映已经\n结束了……",
            "narrator_zh": "雏"
        },
        {
            "location": "342/TALK",
            "narrator": "男子高校生",
            "text": "あの、そうじゃなくて、\nその――",
            "zh": "那个，不是的，\n那个——",
            "narrator_zh": "男高中生"
        },
        {
            "location": "344/TALK",
            "narrator": "男子高校生",
            "text": "本の忘れ物！\nありませんでしたか？",
            "zh": "遗失的书！\n有没有捡到啊？",
            "narrator_zh": "男高中生"
        },
        {
            "location": "345/TALK",
            "narrator": "キリト",
            "text": "…こいつか！！",
            "zh": "…就是这家伙！！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "346/TALK",
            "narrator": "雛",
            "text": "この人だったの！？",
            "zh": "是这个人啊！？",
            "narrator_zh": "雏"
        },
        {
            "location": "348/TALK",
            "narrator": "みやび",
            "text": "ああ、彼の本やったか。",
            "zh": "啊，原来是他的书啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "349/SEL",
            "narrator": "",
            "text": "本を袋にしまって！！",
            "zh": "快把书塞回袋子里！！",
            "narrator_zh": ""
        },
        {
            "location": "350/SEL",
            "narrator": "",
            "text": "中身の確認をしてもらおう",
            "zh": "让他确认一下内容",
            "narrator_zh": ""
        },
        {
            "location": "353/TALK",
            "narrator": "男子高校生",
            "text": "紙袋に入った状態で\n忘れていったと思うん\nですけど…。",
            "zh": "我记得是装在\n纸袋里忘在\n这儿的……",
            "narrator_zh": "男高中生"
        },
        {
            "location": "354/TALK",
            "narrator": "キリト",
            "text": "…あ、ああ、はい。\nちゃんとありましたよ。",
            "zh": "…啊、啊，在的。\n好好地收着呢。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "355/TALK",
            "narrator": "男子高校生",
            "text": "ほ、本当ですか！？",
            "zh": "真、真的吗！？",
            "narrator_zh": "男高中生"
        },
        {
            "location": "358/TALK",
            "narrator": "キリト",
            "text": "今さっき見つけたばかり\nですよ。\nね、みやび先輩？",
            "zh": "是刚刚\n才找到的。\n对吧，雅前辈？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "360/TALK",
            "narrator": "みやび",
            "text": "うん…これやね？",
            "zh": "嗯…是这个咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "362/TALK",
            "narrator": "男子高校生",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "男高中生"
        },
        {
            "location": "364/TALK",
            "narrator": "雛",
            "text": "ちょっ！？",
            "zh": "等下！？",
            "narrator_zh": "雏"
        },
        {
            "location": "366/TALK",
            "narrator": "キリト",
            "text": "み、みやび先輩！？",
            "zh": "雅、雅前辈！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "368/TALK",
            "narrator": "みやび",
            "text": "ん？　どうしたが？",
            "zh": "嗯？　怎么了咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "369/TALK",
            "narrator": "キリト",
            "text": "本！　袋から出っぱなし\nだから！！",
            "zh": "书！　一直露在\n袋子外面啊！！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "372/TALK",
            "narrator": "みやび",
            "text": "…ああ、そうやった。",
            "zh": "…啊，是这样来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "373/TALK",
            "narrator": "みやび",
            "text": "まあ、忘れ物の中身を\n確認せんといかんのは\n規則やき――",
            "zh": "嘛，遗失物必须\n确认内容，这是\n规定嘛——",
            "narrator_zh": "雅"
        },
        {
            "location": "375/TALK",
            "narrator": "みやび",
            "text": "それで開けただけぞね。\nこの本でえいがか？",
            "zh": "就只是为此打开的咧。\n是这本书得咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "377/TALK",
            "narrator": "男子高校生",
            "text": "あ、あぅ…あ、その…。",
            "zh": "啊、唔…那、那个……",
            "narrator_zh": "男高中生"
        },
        {
            "location": "378/TALK",
            "narrator": "男子高校生",
            "text": "し、失礼しましたー！！",
            "zh": "打、打扰了——！！",
            "narrator_zh": "男高中生"
        },
        {
            "location": "384/TALK",
            "narrator": "雛",
            "text": "お、お客様！？",
            "zh": "客、客人！？",
            "narrator_zh": "雏"
        },
        {
            "location": "385/TALK",
            "narrator": "雛",
            "text": "…に、逃げちゃったよ？",
            "zh": "…跑、跑掉了啊？",
            "narrator_zh": "雏"
        },
        {
            "location": "387/TALK",
            "narrator": "キリト",
            "text": "…かわいそうに。\n同じ男として同情するぜ。",
            "zh": "…真可怜。\n作为男人我同情他。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "391/TALK",
            "narrator": "みやび",
            "text": "…まあ、一週間もあれば、\nもう一度くらい取りに\n来るんやろうね。",
            "zh": "…嘛，有一周时间，\n应该还会再来取\n一次吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "393/TALK",
            "narrator": "キリト",
            "text": "絶対に来ませんって！",
            "zh": "他绝对不会来的！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "395/ACT",
            "narrator": "",
            "text": "本を袋にしまって！！",
            "zh": "快把书塞回袋子里！！",
            "narrator_zh": ""
        },
        {
            "location": "414/TALK",
            "narrator": "みやび",
            "text": "相棒、ナイスサポートや！",
            "zh": "搭档，支援得漂亮！",
            "narrator_zh": "雅"
        },
        {
            "location": "426/TALK",
            "narrator": "みやび",
            "text": "気付かれんように、\nそっと袋に戻して…。",
            "zh": "趁没被注意到，\n轻轻塞回袋子里……",
            "narrator_zh": "雅"
        },
        {
            "location": "427/TALK",
            "narrator": "みやび",
            "text": "…よし。",
            "zh": "…好。",
            "narrator_zh": "雅"
        },
        {
            "location": "429/TALK",
            "narrator": "みやび",
            "text": "忘れ物いうんは、\nこれのことですか？",
            "zh": "你说的遗失物，\n是指这个咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "430/TALK",
            "narrator": "男子高校生",
            "text": "そ、そうです！\nこれ、これです！！",
            "zh": "对、对！\n就是这个！！",
            "narrator_zh": "男高中生"
        },
        {
            "location": "431/TALK",
            "narrator": "キリト",
            "text": "座席の上に置いたままに\nなってましたよ。",
            "zh": "它就放在\n座位上哦。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "432/TALK",
            "narrator": "男子高校生",
            "text": "すみません…上映中、\n隣の席に置いていたら\n忘れてしまって…。",
            "zh": "对不起……放映时\n放在旁边座位上，\n就忘掉了……",
            "narrator_zh": "男高中生"
        },
        {
            "location": "433/TALK",
            "narrator": "男子高校生",
            "text": "と、とにかく、\n無事に見つかって\n安心しました！",
            "zh": "总、总之，\n顺利找到了\n就安心了！",
            "narrator_zh": "男高中生"
        },
        {
            "location": "434/TALK",
            "narrator": "雛",
            "text": "これからは気を付けて\nくださいね。",
            "zh": "以后请多加\n注意哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "435/TALK",
            "narrator": "男子高校生",
            "text": "はい！！\nありがとう\nございました！！",
            "zh": "是！！\n非常\n感谢！！",
            "narrator_zh": "男高中生"
        },
        {
            "location": "440/TALK",
            "narrator": "雛",
            "text": "…行っちゃった。\n凄く嬉しそうだったね。",
            "zh": "…走了。\n看起来超开心的呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "442/TALK",
            "narrator": "キリト",
            "text": "そりゃそうだろうよ。\nこっちはその逆だって\nのに…。",
            "zh": "那当然。\n毕竟这边\n正相反……",
            "narrator_zh": "圣翔"
        },
        {
            "location": "445/TALK",
            "narrator": "みやび",
            "text": "キリト君、これで本を\nもらえなくなっちゅう\nたきね。",
            "zh": "圣翔，这下书\n就拿不到了\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "447/TALK",
            "narrator": "キリト",
            "text": "こんなことなら、\n見つけた時に一通り\n目を通しとくんだったぜ。",
            "zh": "早知道这样，\n找到的时候就该\n通读一遍了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "449/TALK",
            "narrator": "雛",
            "text": "そんなに欲しかったの？",
            "zh": "有那么想要吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "451/TALK",
            "narrator": "みやび",
            "text": "男の子やし、そう思うんは\n当然やと思うんよ。",
            "zh": "是男孩子嘛，\n会那么想也正常咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "452/TALK",
            "narrator": "みやび",
            "text": "本に載ってた女の子より\n可愛くはないけんど――",
            "zh": "虽然比不上书上印的\n女孩子可爱——",
            "narrator_zh": "雅"
        },
        {
            "location": "455/TALK",
            "narrator": "みやび",
            "text": "それでもえいなら、\n代わりにうちの胸でも\n見るが？",
            "zh": "要是那样也得的话，\n要不要改看\n我的胸口咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "456/TALK",
            "narrator": "キリト",
            "text": "…え？\nい、いいんすか！？",
            "zh": "…诶？\n真、真的可以吗！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "458/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "459/TALK",
            "narrator": "キリト",
            "text": "って、冗談！！\n冗談っすから！！",
            "zh": "骗你的！！\n是开玩笑啊！！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "461/TALK",
            "narrator": "キリト",
            "text": "あ、劇場の清掃が\nまだ途中だから、\nまた後で！！",
            "zh": "啊，剧场的清扫\n还没做完，\n回头再来！！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "466/TALK",
            "narrator": "雛",
            "text": "はぁ…男ってのは、\nまったく…。",
            "zh": "哈啊……\n男人真是的……",
            "narrator_zh": "雏"
        },
        {
            "location": "469/TALK",
            "narrator": "みやび",
            "text": "可愛くてからかい甲斐が\nあって、中々面白いぞね。",
            "zh": "又可爱又经得起捉弄，\n还挺有意思的咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "471/TALK",
            "narrator": "雛",
            "text": "…あんまり、キリトを\nからかわないであげて\nくださいね？",
            "zh": "…请别太\n捉弄圣翔了，\n好吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "488/ACT",
            "narrator": "",
            "text": "中身の確認をしてもらおう",
            "zh": "让他确认一下内容",
            "narrator_zh": ""
        },
        {
            "location": "506/TALK",
            "narrator": "みやび",
            "text": "そういえば、そういう規則になってたんやったわ",
            "zh": "说起来，原来还有这么一条规定来着",
            "narrator_zh": "雅"
        },
        {
            "location": "519/TALK",
            "narrator": "みやび",
            "text": "じゃあ、一度本を袋に\n戻して…。",
            "zh": "那么，先把书\n装回袋子里……",
            "narrator_zh": "雅"
        },
        {
            "location": "521/TALK",
            "narrator": "キリト",
            "text": "みやび先輩。\nこの人がさっきの本の\n持ち主さんみたいっす。",
            "zh": "雅前辈。\n这个人好像就是\n刚才那本书的主人。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "524/TALK",
            "narrator": "男子高校生",
            "text": "あっ、それです！\nその紙袋ですよ！",
            "zh": "啊，是那个！\n就是那个纸袋！",
            "narrator_zh": "男高中生"
        },
        {
            "location": "526/TALK",
            "narrator": "みやび",
            "text": "あ～、申し訳ないけんど、\nこのまますぐには\nお返しできないがですよ。",
            "zh": "啊～，很抱歉，\n但是这样可没法\n马上还给你哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "527/TALK",
            "narrator": "男子高校生",
            "text": "な、何でですか！？\nそれ、俺のですって。",
            "zh": "为、为什么！？\n那明明是我的东西。",
            "narrator_zh": "男高中生"
        },
        {
            "location": "528/TALK",
            "narrator": "みやび",
            "text": "なら、この袋の中の\n本のタイトルを言うて\nもらえますか？",
            "zh": "那么，能请你说出\n这个袋子里那本书\n的书名吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "530/TALK",
            "narrator": "男子高校生",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": "男高中生"
        },
        {
            "location": "532/TALK",
            "narrator": "雛",
            "text": "ちょ、みやび先輩！？",
            "zh": "等、雅前辈！？",
            "narrator_zh": "雏"
        },
        {
            "location": "534/TALK",
            "narrator": "みやび",
            "text": "これが本当にこの人の\n物かを確認するだけや。",
            "zh": "只是确认一下这是\n不是他的东西而已。",
            "narrator_zh": "雅"
        },
        {
            "location": "536/TALK",
            "narrator": "みやび",
            "text": "言うておくけんど、\nちゃんとこの劇場の\n規則にあるんよ。",
            "zh": "先把话放在前头，\n这可是这个剧场\n规定里有的哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "537/TALK",
            "narrator": "みやび",
            "text": "間違いがあったら\n許されんきね。",
            "zh": "要是搞错了，\n可没人会原谅啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "539/TALK",
            "narrator": "雛",
            "text": "そ、それはそうです\nけど…。",
            "zh": "话、话是没错，\n但是……",
            "narrator_zh": "雏"
        },
        {
            "location": "541/TALK",
            "narrator": "キリト",
            "text": "みやび先輩。\nあの本のタイトルを\n言わせるのは酷っすよ？",
            "zh": "雅前辈。\n让人说出那本书的\n书名也太狠了吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "542/TALK",
            "narrator": "男子高校生",
            "text": "み、見たんですか！？",
            "zh": "你、你看了吗！？",
            "narrator_zh": "男高中生"
        },
        {
            "location": "544/TALK",
            "narrator": "キリト",
            "text": "あ、それは、えっと…。",
            "zh": "啊，那个，呃……",
            "narrator_zh": "圣翔"
        },
        {
            "location": "545/TALK",
            "narrator": "みやび",
            "text": "忘れ物の中身を確認する\nんは、当然のことです。",
            "zh": "确认遗失物的内容，\n是理所当然的事情。",
            "narrator_zh": "雅"
        },
        {
            "location": "546/TALK",
            "narrator": "みやび",
            "text": "中身がわからんことには、\nこちらも対処できません\nきね。",
            "zh": "不弄清楚内容，\n我们这边也没法\n处理啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "549/TALK",
            "narrator": "男子高校生",
            "text": "うっ…。",
            "zh": "呃……。",
            "narrator_zh": "男高中生"
        },
        {
            "location": "550/TALK",
            "narrator": "みやび",
            "text": "最低限の確認ですよ。",
            "zh": "只是最低限度的确认哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "551/TALK",
            "narrator": "みやび",
            "text": "それで…本のタイトルを\n言うてもらえますか？",
            "zh": "所以……能请你说出\n这本书的书名吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "554/TALK",
            "narrator": "男子高校生",
            "text": "え、えと、そのぉ…\nば、バク…。",
            "zh": "呃、呃，那个……\n巴、巴库……",
            "narrator_zh": "男高中生"
        },
        {
            "location": "555/TALK",
            "narrator": "みやび",
            "text": "ばく？",
            "zh": "巴库？",
            "narrator_zh": "雅"
        },
        {
            "location": "556/TALK",
            "narrator": "男子高校生",
            "text": "ば、ばく…ばくに…\nう、うぅ…。",
            "zh": "巴、巴库…巴库尼…\n呜、呜呜……",
            "narrator_zh": "男高中生"
        },
        {
            "location": "558/TALK",
            "narrator": "男子高校生",
            "text": "すみません！\n俺の勘違いでしたぁ！！",
            "zh": "对不起！\n是我搞错了啊！！",
            "narrator_zh": "男高中生"
        },
        {
            "location": "564/TALK",
            "narrator": "キリト",
            "text": "お、お客さん！？",
            "zh": "客、客人！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "566/TALK",
            "narrator": "雛",
            "text": "あ～あ…まあ、そりゃ\n逃げて当然だよねー。",
            "zh": "唉……嘛，那种情况\n跑掉也是当然的。",
            "narrator_zh": "雏"
        },
        {
            "location": "569/TALK",
            "narrator": "雛",
            "text": "あのタイトルを女の人に\n言うのは、かなり酷って\nいうか――",
            "zh": "让他在女孩子面前\n说出那个书名，\n可以说相当残忍——",
            "narrator_zh": "雏"
        },
        {
            "location": "570/TALK",
            "narrator": "雛",
            "text": "拷問に近いものが\nあるしー。",
            "zh": "简直跟拷问\n没什么两样。",
            "narrator_zh": "雏"
        },
        {
            "location": "571/TALK",
            "narrator": "キリト",
            "text": "…哀れだ。",
            "zh": "…可悲啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "574/TALK",
            "narrator": "みやび",
            "text": "…規則通りとはいえ、\nかわいそうなことした\nかもしれんなぁ。",
            "zh": "…虽说是按规矩来，\n但也许做得\n太狠了点啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "577/TALK",
            "narrator": "真幌",
            "text": "いや、何も問題はない。",
            "zh": "不，没有任何问题。",
            "narrator_zh": "真幌"
        },
        {
            "location": "579/TALK",
            "narrator": "みやび",
            "text": "まほさん、\n見てたがですか…。",
            "zh": "真幌，\n你都看见了咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "581/TALK",
            "narrator": "真幌",
            "text": "みやびの対応は、\n何一つ間違えては\nいなかった。",
            "zh": "雅的处理，\n没有一处\n出错。",
            "narrator_zh": "真幌"
        },
        {
            "location": "582/TALK",
            "narrator": "真幌",
            "text": "気に病む必要はないぞ。",
            "zh": "不必放在心上。",
            "narrator_zh": "真幌"
        },
        {
            "location": "583/TALK",
            "narrator": "みやび",
            "text": "…まほさんが言うなら、\nもう気にしませんちや。",
            "zh": "…真幌都这么说，\n那我就不在意滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "585/TALK",
            "narrator": "真幌",
            "text": "それでいい。\nそれはそうと、\n今の客だが――",
            "zh": "这样就好。\n话说回来，\n刚才那位客人——",
            "narrator_zh": "真幌"
        },
        {
            "location": "586/TALK",
            "narrator": "真幌",
            "text": "うちの学園の\n制服だったな？",
            "zh": "那是我们学园的\n制服没错吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "587/TALK",
            "narrator": "キリト",
            "text": "そ、そういえば\n確かに…。",
            "zh": "这、这么一说\n确实是……",
            "narrator_zh": "圣翔"
        },
        {
            "location": "588/TALK",
            "narrator": "真幌",
            "text": "確か、高等部の二年に\n似たような奴がいた\n気がするんでな。",
            "zh": "我记得高等部二年级\n好像有个\n差不多的人。",
            "narrator_zh": "真幌"
        },
        {
            "location": "590/TALK",
            "narrator": "真幌",
            "text": "忘れ物の本は、私から\n彼に返しておくとしよう。",
            "zh": "遗失的那本书，\n就由我亲手还给他吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "592/TALK",
            "narrator": "みやび",
            "text": "了解です。\nそれじゃ、よろしく\n頼みますがよ。",
            "zh": "明白了。\n那就拜托\n你了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "594/TALK",
            "narrator": "キリト",
            "text": "…あの本、教師から\n手渡されることに\nなるのか。",
            "zh": "…那本书，\n要由老师\n亲手交给他吗。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "596/TALK",
            "narrator": "キリト",
            "text": "…想像するだけで、\n胃がキリキリしてくる\n気がするぜ…。",
            "zh": "…光是想象一下，\n胃就一阵阵\n绞着疼了……",
            "narrator_zh": "圣翔"
        },
        {
            "location": "258/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月12日　17:12 PM</color>\nとある初夏の放課後、神楽坂トライナリー劇場でのバイト中のこと。",
            "zh": "<color=green>7月12日　17:12 PM</color>\n某个初夏的放学后，在神乐坂三重奏剧场打工时的事。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "482/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch04",
            "text": "【今は原始ではないのでね】",
            "zh": "【毕竟现在可不是原始时代呢】",
            "narrator_zh": "Dialog_GEThimegoto_ch04"
        }
    ]
}
