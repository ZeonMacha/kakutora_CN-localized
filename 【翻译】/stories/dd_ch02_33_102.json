{
    "dir": "chap33/daydra/dd_ch02_33_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "33205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "少女の器＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "少女之器＜后篇＞"
    },
    "entry": [
        {
            "location": "731/SCENARIO",
            "narrator": "",
            "text": "ずっと、奥底に、あった",
            "zh": "一直、都在最深处",
            "narrator_zh": ""
        },
        {
            "location": "749/TALK",
            "narrator": "アーヤ",
            "text": "……変なの。",
            "zh": "……真奇怪。",
            "narrator_zh": "绫水"
        },
        {
            "location": "750/TALK",
            "narrator": "アーヤ",
            "text": "私、すごく落ち着いてる。",
            "zh": "我心里非常平静。",
            "narrator_zh": "绫水"
        },
        {
            "location": "751/TALK",
            "narrator": "アーヤ",
            "text": "それから、確信がある。\n私は死なない。",
            "zh": "而且，我有种确信。\n我不会死。",
            "narrator_zh": "绫水"
        },
        {
            "location": "752/SEL",
            "narrator": "",
            "text": "アーヤ？",
            "zh": "绫水？",
            "narrator_zh": ""
        },
        {
            "location": "753/ACT",
            "narrator": "",
            "text": "アーヤ？",
            "zh": "绫水？",
            "narrator_zh": ""
        },
        {
            "location": "770/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さん",
            "zh": "$handle$",
            "narrator_zh": "绫水"
        },
        {
            "location": "772/SEL",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "773/SEL",
            "narrator": "",
            "text": "ボーッとしてた？",
            "zh": "在发呆吗？",
            "narrator_zh": ""
        },
        {
            "location": "774/ACT",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "775/TALK",
            "narrator": "アーヤ",
            "text": "元気よ",
            "zh": "我很好哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "776/ACT",
            "narrator": "",
            "text": "ボーッとしてた？",
            "zh": "在发呆吗？",
            "narrator_zh": ""
        },
        {
            "location": "777/TALK",
            "narrator": "アーヤ",
            "text": "そうかもしれないわ",
            "zh": "或许吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "779/TALK",
            "narrator": "アーヤ",
            "text": "ねえ",
            "zh": "呐",
            "narrator_zh": "绫水"
        },
        {
            "location": "780/TALK",
            "narrator": "アーヤ",
            "text": "これから",
            "zh": "接下来",
            "narrator_zh": "绫水"
        },
        {
            "location": "781/TALK",
            "narrator": "アーヤ",
            "text": "はいしか答えられないことを言うから",
            "zh": "我要说一件你只能回答「是」的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "782/TALK",
            "narrator": "アーヤ",
            "text": "はいって言って",
            "zh": "所以请回答「是」",
            "narrator_zh": "绫水"
        },
        {
            "location": "784/SEL",
            "narrator": "",
            "text": "強制なの？",
            "zh": "这是强迫吗？",
            "narrator_zh": ""
        },
        {
            "location": "785/SEL",
            "narrator": "",
            "text": "いいえの準備だ",
            "zh": "我已经准备好说「不是」了",
            "narrator_zh": ""
        },
        {
            "location": "786/SEL",
            "narrator": "",
            "text": "聞いてみないとわからない",
            "zh": "得先听完才知道",
            "narrator_zh": ""
        },
        {
            "location": "787/ACT",
            "narrator": "",
            "text": "強制なの？",
            "zh": "这是强迫吗？",
            "narrator_zh": ""
        },
        {
            "location": "788/TALK",
            "narrator": "アーヤ",
            "text": "違うわ",
            "zh": "不是哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "789/ACT",
            "narrator": "",
            "text": "いいえの準備だ",
            "zh": "我已经准备好说「不是」了",
            "narrator_zh": ""
        },
        {
            "location": "790/TALK",
            "narrator": "アーヤ",
            "text": "無駄になるわよ",
            "zh": "那可要白准备了哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "791/ACT",
            "narrator": "",
            "text": "聞いてみないとわからない",
            "zh": "得先听完才知道",
            "narrator_zh": ""
        },
        {
            "location": "792/TALK",
            "narrator": "アーヤ",
            "text": "聞いたらはいって言うことになるわ",
            "zh": "听了之后你还是会说「是」的",
            "narrator_zh": "绫水"
        },
        {
            "location": "794/TALK",
            "narrator": "アーヤ",
            "text": "ずっと側にいて",
            "zh": "请一直留在我身边",
            "narrator_zh": "绫水"
        },
        {
            "location": "795/TALK",
            "narrator": "アーヤ",
            "text": "私のことを見守っていて",
            "zh": "请一直守护着我",
            "narrator_zh": "绫水"
        },
        {
            "location": "797/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "798/SEL",
            "narrator": "",
            "text": "結婚するしかないね",
            "zh": "看来只能结婚了呢",
            "narrator_zh": ""
        },
        {
            "location": "799/SEL",
            "narrator": "",
            "text": "ずっと一緒にいるよ",
            "zh": "我会一直陪着你的",
            "narrator_zh": ""
        },
        {
            "location": "800/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "801/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう",
            "zh": "谢谢你",
            "narrator_zh": "绫水"
        },
        {
            "location": "802/ACT",
            "narrator": "",
            "text": "結婚するしかないね",
            "zh": "看来只能结婚了呢",
            "narrator_zh": ""
        },
        {
            "location": "803/TALK",
            "narrator": "アーヤ",
            "text": "結婚？",
            "zh": "结婚？",
            "narrator_zh": "绫水"
        },
        {
            "location": "804/TALK",
            "narrator": "アーヤ",
            "text": "いいけどちょっと",
            "zh": "倒也不是不行，不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "805/TALK",
            "narrator": "アーヤ",
            "text": "不思議な感じ",
            "zh": "有种不可思议的感觉",
            "narrator_zh": "绫水"
        },
        {
            "location": "807/SEL",
            "narrator": "",
            "text": "そんなことないでしょ",
            "zh": "没那回事吧",
            "narrator_zh": ""
        },
        {
            "location": "808/SEL",
            "narrator": "",
            "text": "それこそ運命なのに",
            "zh": "这才是命运啊",
            "narrator_zh": ""
        },
        {
            "location": "809/SEL",
            "narrator": "",
            "text": "どこが不思議なの",
            "zh": "哪里不可思议了",
            "narrator_zh": ""
        },
        {
            "location": "810/ACT",
            "narrator": "",
            "text": "そんなことないでしょ",
            "zh": "没那回事吧",
            "narrator_zh": ""
        },
        {
            "location": "811/TALK",
            "narrator": "アーヤ",
            "text": "そうかしら",
            "zh": "是吗",
            "narrator_zh": "绫水"
        },
        {
            "location": "812/ACT",
            "narrator": "",
            "text": "それこそ運命なのに",
            "zh": "这才是命运啊",
            "narrator_zh": ""
        },
        {
            "location": "813/TALK",
            "narrator": "アーヤ",
            "text": "そうかもしれないけど",
            "zh": "或许是这样吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "814/ACT",
            "narrator": "",
            "text": "どこが不思議なの",
            "zh": "哪里不可思议了",
            "narrator_zh": ""
        },
        {
            "location": "815/TALK",
            "narrator": "アーヤ",
            "text": "うまく言えないけど",
            "zh": "我也说不太清",
            "narrator_zh": "绫水"
        },
        {
            "location": "817/TALK",
            "narrator": "アーヤ",
            "text": "結婚って",
            "zh": "所谓结婚",
            "narrator_zh": "绫水"
        },
        {
            "location": "818/TALK",
            "narrator": "アーヤ",
            "text": "恋愛の先にあるものだって",
            "zh": "我以前一直以为",
            "narrator_zh": "绫水"
        },
        {
            "location": "819/TALK",
            "narrator": "アーヤ",
            "text": "そう思ってた",
            "zh": "那是恋爱的延续",
            "narrator_zh": "绫水"
        },
        {
            "location": "820/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "821/TALK",
            "narrator": "アーヤ",
            "text": "今$handle$さんとの間にあるのは",
            "zh": "现在我和$handle$之间的",
            "narrator_zh": "绫水"
        },
        {
            "location": "822/TALK",
            "narrator": "アーヤ",
            "text": "そういう感情より",
            "zh": "是比那种感情",
            "narrator_zh": "绫水"
        },
        {
            "location": "823/TALK",
            "narrator": "アーヤ",
            "text": "もっと深いものだから",
            "zh": "更加深厚的东西",
            "narrator_zh": "绫水"
        },
        {
            "location": "825/TALK",
            "narrator": "アーヤ",
            "text": "恋心みたいに消えるものじゃなくて",
            "zh": "不是像爱慕那样会消逝的东西",
            "narrator_zh": "绫水"
        },
        {
            "location": "826/TALK",
            "narrator": "アーヤ",
            "text": "ずっと魂で結びついてるみたいな",
            "zh": "而是仿佛灵魂永远相连一般的",
            "narrator_zh": "绫水"
        },
        {
            "location": "827/TALK",
            "narrator": "アーヤ",
            "text": "そんな気持ちだから",
            "zh": "那样的心情",
            "narrator_zh": "绫水"
        },
        {
            "location": "829/SEL",
            "narrator": "",
            "text": "なんかすごいね？",
            "zh": "总觉得好厉害呢？",
            "narrator_zh": ""
        },
        {
            "location": "830/SEL",
            "narrator": "",
            "text": "$me$もそう思ってた",
            "zh": "$me$也是这么想的",
            "narrator_zh": ""
        },
        {
            "location": "831/SEL",
            "narrator": "",
            "text": "ラブもほしい！",
            "zh": "我也想要爱啊！",
            "narrator_zh": ""
        },
        {
            "location": "832/ACT",
            "narrator": "",
            "text": "なんかすごいね？",
            "zh": "总觉得好厉害呢？",
            "narrator_zh": ""
        },
        {
            "location": "833/TALK",
            "narrator": "アーヤ",
            "text": "どうしても大げさになるわね",
            "zh": "一说出来就显得太夸张了呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "834/TALK",
            "narrator": "アーヤ",
            "text": "言葉で伝えようとすると",
            "zh": "想要用语言来传达的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "835/TALK",
            "narrator": "アーヤ",
            "text": "難しいわ",
            "zh": "果然还是很难呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "836/TALK",
            "narrator": "アーヤ",
            "text": "説明が",
            "zh": "解释起来",
            "narrator_zh": "绫水"
        },
        {
            "location": "837/ACT",
            "narrator": "",
            "text": "$me$もそう思ってた",
            "zh": "$me$也是这么想的",
            "narrator_zh": ""
        },
        {
            "location": "838/TALK",
            "narrator": "アーヤ",
            "text": "本当？",
            "zh": "真的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "839/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": "绫水"
        },
        {
            "location": "840/TALK",
            "narrator": "アーヤ",
            "text": "私と$handle$さんは",
            "zh": "我和$handle$",
            "narrator_zh": "绫水"
        },
        {
            "location": "841/TALK",
            "narrator": "アーヤ",
            "text": "そういうことなのね",
            "zh": "就是这么一回事呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "842/ACT",
            "narrator": "",
            "text": "ラブもほしい！",
            "zh": "我也想要爱啊！",
            "narrator_zh": ""
        },
        {
            "location": "843/TALK",
            "narrator": "アーヤ",
            "text": "どう言えばいいのかしら",
            "zh": "该怎么说才好呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "844/TALK",
            "narrator": "アーヤ",
            "text": "ないわけじゃないの",
            "zh": "倒也不是没有",
            "narrator_zh": "绫水"
        },
        {
            "location": "845/TALK",
            "narrator": "アーヤ",
            "text": "でも少し違うの",
            "zh": "但还是稍微有点不同",
            "narrator_zh": "绫水"
        },
        {
            "location": "846/TALK",
            "narrator": "アーヤ",
            "text": "難しいわ",
            "zh": "好难表达啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "848/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんは$handle$さん",
            "zh": "$handle$就是$handle$",
            "narrator_zh": "绫水"
        },
        {
            "location": "849/TALK",
            "narrator": "アーヤ",
            "text": "それからすごくだいじなひと",
            "zh": "也是对我而言无比重要的人",
            "narrator_zh": "绫水"
        },
        {
            "location": "850/TALK",
            "narrator": "アーヤ",
            "text": "うまく伝えられないけど",
            "zh": "虽然不太会表达",
            "narrator_zh": "绫水"
        },
        {
            "location": "851/TALK",
            "narrator": "アーヤ",
            "text": "そういう人なの",
            "zh": "但你就是这样的人",
            "narrator_zh": "绫水"
        },
        {
            "location": "852/TALK",
            "narrator": "アーヤ",
            "text": "私にとっては",
            "zh": "对我来说",
            "narrator_zh": "绫水"
        },
        {
            "location": "853/ACT",
            "narrator": "",
            "text": "ずっと一緒にいるよ",
            "zh": "我会一直陪着你的",
            "narrator_zh": ""
        },
        {
            "location": "854/TALK",
            "narrator": "アーヤ",
            "text": "うれしいわ",
            "zh": "我很开心",
            "narrator_zh": "绫水"
        },
        {
            "location": "869/TALK",
            "narrator": "アーヤ",
            "text": "！",
            "zh": "！",
            "narrator_zh": "绫水"
        },
        {
            "location": "871/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、みやび。\n館長から準備完了の\n連絡があったわ。",
            "zh": "加维、雅。\n馆长发来联络，\n说已经准备好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "872/TALK",
            "narrator": "アーヤ",
            "text": "サイネージに館長が\n映し出されたら\n救出開始よ。",
            "zh": "等电子广告牌上\n出现馆长的画面，\n就开始营救。",
            "narrator_zh": "绫水"
        },
        {
            "location": "873/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ふうん。\nまほもやる時はやるわね。",
            "zh": "哼。\n真幌该出手时还是挺靠谱的嘛。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "874/TALK",
            "narrator": "透明みやび",
            "text": "いっつもそうやったら\n肩が凝って\n仕方ないろう。",
            "zh": "要是天天都这样，\n肩膀岂不是要\n酸痛死咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "875/TALK",
            "narrator": "アーヤ",
            "text": "……スタンバイ。\n各人、構えよ。",
            "zh": "……准备就绪。\n各位，做好迎战准备。",
            "narrator_zh": "绫水"
        },
        {
            "location": "876/TALK",
            "narrator": "透明みやび",
            "text": "発煙手榴弾の\n安全ロック解除。",
            "zh": "发烟手榴弹\n安全锁解除。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "877/TALK",
            "narrator": "透明みやび",
            "text": "いつでも行けるき。",
            "zh": "随时都能上啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "878/TALK",
            "narrator": "透明ガブリエラ",
            "text": "望むところよ。",
            "zh": "正合我意。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "879/TALK",
            "narrator": "アーヤ",
            "text": "…お願い。",
            "zh": "……拜托了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "880/TALK",
            "narrator": "透明みやび",
            "text": "オッケー。\n…発破！",
            "zh": "OK。\n……爆破！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "888/TALK",
            "narrator": "アーヤ",
            "text": "絶対に成功させる！\n見守ってて、\n$handle$さん…！",
            "zh": "绝对要成功！\n看着我吧，\n$handle$……！",
            "narrator_zh": "绫水"
        },
        {
            "location": "905/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【27 シン・カグラ】",
            "zh": "【27 新·神乐】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
