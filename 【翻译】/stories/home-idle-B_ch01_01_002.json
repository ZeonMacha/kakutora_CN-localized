            "text": "つばめHOME画面・昼（手前に来てから）",
            "zh": "燕的HOME画面·白天（走到近前之后）",
            "narrator_zh": ""
        },
        {
            "location": "313/TALK",
            "narrator": "つばめ",
            "text": "え！？\n今、この辺で\n呼ばれたような…",
            "zh": "诶！？\n刚才，好像在这边\n有人叫我……",
            "narrator_zh": "燕"
        },
        {
            "location": "318/TALK",
            "narrator": "つばめ",
            "text": "……何も無い。",
            "zh": "……什么也没有。",
            "narrator_zh": "燕"
        },
        {
            "location": "322/TALK",
            "narrator": "つばめ",
            "text": "今誰か、呼んだ？",
            "zh": "刚才有人叫我吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "326/TALK",
            "narrator": "つばめ",
            "text": "……\n誰もいない……よね？",
            "zh": "……\n没人在……对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "330/TALK",
            "narrator": "つばめ",
            "text": "……気のせいかな。",
            "zh": "……是我的错觉吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "332/TALK",
            "narrator": "つばめ",
            "text": "誰かに呼ばれた\n気がしたんだけど……",
            "zh": "总觉得好像\n有人在叫我来着……",
            "narrator_zh": "燕"
        }
    ]
}
