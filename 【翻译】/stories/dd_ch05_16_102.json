{
    "dir": "chap16/daydra/dd_ch05_16_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "16505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "十六方塞がり＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "十六方堵死＜后篇＞[?]"
    },
    "entry": [
        {
            "location": "721/TALK",
            "narrator": "つばめ",
            "text": "卯月さん、\n大丈夫だからね？",
            "zh": "卯月，\n没事的哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "723/TALK",
            "narrator": "つばめ",
            "text": "今日のわたしは、\nいつも以上に\n頑張っちゃうから！",
            "zh": "今天的我，\n会比平时\n更努力的！",
            "narrator_zh": "燕"
        },
        {
            "location": "725/TALK",
            "narrator": "神楽",
            "text": "…はい。\n頼りに、してますね。",
            "zh": "……好。\n我会依靠你的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "727/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "729/TALK",
            "narrator": "神楽",
            "text": "バカじゃないの？\nつばめさんに話そうとか、\nありえないわ。",
            "zh": "我是傻瓜吗？\n跟燕说这种话，\n怎么可能。",
            "narrator_zh": "神乐"
        },
        {
            "location": "730/TALK",
            "narrator": "神楽",
            "text": "もし話したりしてたら、\n今頃…。",
            "zh": "要是说了，\n现在早就……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "732/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "736/TALK",
            "narrator": "神楽",
            "text": "少しお話に付き合ってもらえますか？",
            "zh": "能陪我说一会儿话吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "737/TALK",
            "narrator": "神楽",
            "text": "ちょっと頭を冷やしたいので",
            "zh": "我想让脑袋冷静一下",
            "narrator_zh": "神乐"
        },
        {
            "location": "739/SEL",
            "narrator": "",
            "text": "つばめに話さないんだ？",
            "zh": "不跟燕说吗？",
            "narrator_zh": ""
        },
        {
            "location": "740/ACT",
            "narrator": "",
            "text": "つばめに話さないんだ？",
            "zh": "不跟燕说吗？",
            "narrator_zh": ""
        },
        {
            "location": "742/TALK",
            "narrator": "神楽",
            "text": "気づいてたんですか？",
            "zh": "你发现了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "745/TALK",
            "narrator": "神楽",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "神乐"
        },
        {
            "location": "746/TALK",
            "narrator": "神楽",
            "text": "話してどうにかなるものじゃありませんし",
            "zh": "说了也解决不了什么",
            "narrator_zh": "神乐"
        },
        {
            "location": "747/TALK",
            "narrator": "神楽",
            "text": "うっかりしてましたけど",
            "zh": "我差点没忍住",
            "narrator_zh": "神乐"
        },
        {
            "location": "749/TALK",
            "narrator": "神楽",
            "text": "私達は外のみやびさんと真幌さんに監視されてるんです",
            "zh": "我们被外面的雅和真幌监视着",
            "narrator_zh": "神乐"
        },
        {
            "location": "750/TALK",
            "narrator": "神楽",
            "text": "つばめさんが協力してくれたとしても",
            "zh": "就算燕愿意帮忙",
            "narrator_zh": "神乐"
        },
        {
            "location": "751/TALK",
            "narrator": "神楽",
            "text": "離れればすぐにバレてしまいますから",
            "zh": "一离开马上就会暴露",
            "narrator_zh": "神乐"
        },
        {
            "location": "755/TALK",
            "narrator": "神楽",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "神乐"
        },
        {
            "location": "756/TALK",
            "narrator": "神楽",
            "text": "つばめさんに自宅がバレたら",
            "zh": "要是让燕知道了我家",
            "narrator_zh": "神乐"
        },
        {
            "location": "757/TALK",
            "narrator": "神楽",
            "text": "絶対に来ちゃうじゃないですか",
            "zh": "她绝对会跑来的",
            "narrator_zh": "神乐"
        },
        {
            "location": "758/TALK",
            "narrator": "神楽",
            "text": "それだけはイヤなんです",
            "zh": "唯独这个，我不愿意",
            "narrator_zh": "神乐"
        },
        {
            "location": "760/SEL",
            "narrator": "",
            "text": "母親を見られたくないから？",
            "zh": "因为不想让人看见母亲？",
            "narrator_zh": ""
        },
        {
            "location": "761/SEL",
            "narrator": "",
            "text": "これ以上好きになりたくないから？",
            "zh": "因为不想再喜欢下去了？",
            "narrator_zh": ""
        },
        {
            "location": "762/ACT",
            "narrator": "",
            "text": "母親を見られたくないから？",
            "zh": "因为不想让人看见母亲？",
            "narrator_zh": ""
        },
        {
            "location": "764/TALK",
            "narrator": "神楽",
            "text": "そうです",
            "zh": "是的",
            "narrator_zh": "神乐"
        },
        {
            "location": "765/TALK",
            "narrator": "神楽",
            "text": "やっぱり$handle$さんは知ってるんですね",
            "zh": "果然$handle$知道啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "766/TALK",
            "narrator": "神楽",
            "text": "うちの母のこと",
            "zh": "我母亲的事",
            "narrator_zh": "神乐"
        },
        {
            "location": "769/TALK",
            "narrator": "神楽",
            "text": "私の母",
            "zh": "我的母亲",
            "narrator_zh": "神乐"
        },
        {
            "location": "770/TALK",
            "narrator": "神楽",
            "text": "今は普通の状態じゃないんです",
            "zh": "现在已经不是平常的状态了",
            "narrator_zh": "神乐"
        },
        {
            "location": "771/TALK",
            "narrator": "神楽",
            "text": "そんな状態の母を見られるのは",
            "zh": "让人看见那种状态的母亲",
            "narrator_zh": "神乐"
        },
        {
            "location": "772/TALK",
            "narrator": "神楽",
            "text": "イヤなんです",
            "zh": "我不愿意",
            "narrator_zh": "神乐"
        },
        {
            "location": "774/TALK",
            "narrator": "神楽",
            "text": "きっと母だって",
            "zh": "母亲也一定",
            "narrator_zh": "神乐"
        },
        {
            "location": "775/TALK",
            "narrator": "神楽",
            "text": "自分のそんな姿を見られたくない",
            "zh": "不想让人看见自己那副样子",
            "narrator_zh": "神乐"
        },
        {
            "location": "776/TALK",
            "narrator": "神楽",
            "text": "そう思うはずだから",
            "zh": "她会这么想的",
            "narrator_zh": "神乐"
        },
        {
            "location": "778/SEL",
            "narrator": "",
            "text": "お母さんを護ってるんだね",
            "zh": "你是在保护妈妈吧",
            "narrator_zh": ""
        },
        {
            "location": "779/SEL",
            "narrator": "",
            "text": "どうせわからないと思うけど？",
            "zh": "反正你也不懂吧？",
            "narrator_zh": ""
        },
        {
            "location": "780/ACT",
            "narrator": "",
            "text": "お母さんを護ってるんだね",
            "zh": "你是在保护妈妈吧",
            "narrator_zh": ""
        },
        {
            "location": "781/TALK",
            "narrator": "神楽",
            "text": "私しかいませんから",
            "zh": "因为只有我",
            "narrator_zh": "神乐"
        },
        {
            "location": "783/TALK",
            "narrator": "神楽",
            "text": "母を護れるのは",
            "zh": "能保护母亲",
            "narrator_zh": "神乐"
        },
        {
            "location": "786/TALK",
            "narrator": "神楽",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "神乐"
        },
        {
            "location": "787/TALK",
            "narrator": "神楽",
            "text": "$handle$さんにお願いがあるんです",
            "zh": "我有事想拜托$handle$",
            "narrator_zh": "神乐"
        },
        {
            "location": "788/TALK",
            "narrator": "神楽",
            "text": "この事態が終わるまで",
            "zh": "在这件事结束之前",
            "narrator_zh": "神乐"
        },
        {
            "location": "789/TALK",
            "narrator": "神楽",
            "text": "私の母は無事なのか",
            "zh": "我的母亲是否平安",
            "narrator_zh": "神乐"
        },
        {
            "location": "790/TALK",
            "narrator": "神楽",
            "text": "それを教えて欲しいんです",
            "zh": "希望你告诉我",
            "narrator_zh": "神乐"
        },
        {
            "location": "792/SEL",
            "narrator": "",
            "text": "未来のことは話せない",
            "zh": "未来的事不能说",
            "narrator_zh": ""
        },
        {
            "location": "793/ACT",
            "narrator": "",
            "text": "未来のことは話せない",
            "zh": "未来的事不能说",
            "narrator_zh": ""
        },
        {
            "location": "795/TALK",
            "narrator": "神楽",
            "text": "そんなのわかってます",
            "zh": "那种事我知道",
            "narrator_zh": "神乐"
        },
        {
            "location": "796/TALK",
            "narrator": "神楽",
            "text": "でも知らなきゃ動けません",
            "zh": "可是不知道的话我动不了",
            "narrator_zh": "神乐"
        },
        {
            "location": "797/TALK",
            "narrator": "神楽",
            "text": "私はどうしたらいいんですか？",
            "zh": "我该怎么办？",
            "narrator_zh": "神乐"
        },
        {
            "location": "798/TALK",
            "narrator": "神楽",
            "text": "母が危ない目に遭っているのに",
            "zh": "母亲正身处险境",
            "narrator_zh": "神乐"
        },
        {
            "location": "799/TALK",
            "narrator": "神楽",
            "text": "それがバレないようにヘラヘラ笑ってどうでもいい発症者を助けろと？",
            "zh": "却要我瞒着这件事，傻笑着去救那些无关紧要的发症者吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "800/TALK",
            "narrator": "神楽",
            "text": "なんですかそれもう拷問と同じだから",
            "zh": "这算什么，简直跟拷问一样",
            "narrator_zh": "神乐"
        },
        {
            "location": "801/TALK",
            "narrator": "神楽",
            "text": "こんな気持ちじゃまともに戦うことだってできない！",
            "zh": "这种心情，连好好战斗都做不到！",
            "narrator_zh": "神乐"
        },
        {
            "location": "802/TALK",
            "narrator": "神楽",
            "text": "ルールとかどうでもいいから教ええろよ",
            "zh": "规则什么的无所谓，快告诉我啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "804/SEL",
            "narrator": "",
            "text": "今現在は無事だ",
            "zh": "她眼下是平安的",
            "narrator_zh": ""
        },
        {
            "location": "805/SEL",
            "narrator": "",
            "text": "$me$だって教えたい！！",
            "zh": "$me$也想告诉你！！",
            "narrator_zh": ""
        },
        {
            "location": "806/ACT",
            "narrator": "",
            "text": "今現在は無事だ",
            "zh": "她眼下是平安的",
            "narrator_zh": ""
        },
        {
            "location": "808/TALK",
            "narrator": "神楽",
            "text": "本当ですか？",
            "zh": "真的吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "810/SEL",
            "narrator": "",
            "text": "$me$に言えるのはこれだけ",
            "zh": "$me$能说的只有这些",
            "narrator_zh": ""
        },
        {
            "location": "811/ACT",
            "narrator": "",
            "text": "$me$に言えるのはこれだけ",
            "zh": "$me$能说的只有这些",
            "narrator_zh": ""
        },
        {
            "location": "814/TALK",
            "narrator": "神楽",
            "text": "ありがとう",
            "zh": "谢谢",
            "narrator_zh": "神乐"
        },
        {
            "location": "815/TALK",
            "narrator": "神楽",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "神乐"
        },
        {
            "location": "818/TALK",
            "narrator": "神楽",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": "神乐"
        },
        {
            "location": "819/TALK",
            "narrator": "神楽",
            "text": "酷いことを言いました",
            "zh": "我说了很过分的话",
            "narrator_zh": "神乐"
        },
        {
            "location": "822/TALK",
            "narrator": "神楽",
            "text": "自分はみんなに言えないことがあるのに",
            "zh": "明明自己也有不能对大家说的事",
            "narrator_zh": "神乐"
        },
        {
            "location": "823/TALK",
            "narrator": "神楽",
            "text": "$handle$さんにはルールを破って言えだなんて",
            "zh": "却要$handle$打破规则说出来",
            "narrator_zh": "神乐"
        },
        {
            "location": "826/TALK",
            "narrator": "神楽",
            "text": "こんなこと言う資格ないけど",
            "zh": "我说这种话没有资格",
            "narrator_zh": "神乐"
        },
        {
            "location": "827/TALK",
            "narrator": "神楽",
            "text": "大丈夫なんですか？",
            "zh": "你没事吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "829/SEL",
            "narrator": "",
            "text": "神楽の助けになったなら構わない",
            "zh": "如果帮到了神乐就没关系",
            "narrator_zh": ""
        },
        {
            "location": "830/SEL",
            "narrator": "",
            "text": "怒られるのは慣れてる",
            "zh": "被骂我已经习惯了",
            "narrator_zh": ""
        },
        {
            "location": "831/SEL",
            "narrator": "",
            "text": "未来のことは言ってない",
            "zh": "我没说未来的事",
            "narrator_zh": ""
        },
        {
            "location": "832/ACT",
            "narrator": "",
            "text": "神楽の助けになったなら構わない",
            "zh": "如果帮到了神乐就没关系",
            "narrator_zh": ""
        },
        {
            "location": "833/TALK",
            "narrator": "神楽",
            "text": "なりましたよ",
            "zh": "帮到了",
            "narrator_zh": "神乐"
        },
        {
            "location": "835/TALK",
            "narrator": "神楽",
            "text": "今の状態がわかっただけでも",
            "zh": "光是知道现在的状态",
            "narrator_zh": "神乐"
        },
        {
            "location": "836/TALK",
            "narrator": "神楽",
            "text": "本当にありがたいです",
            "zh": "就已经非常感谢了",
            "narrator_zh": "神乐"
        },
        {
            "location": "838/ACT",
            "narrator": "",
            "text": "怒られるのは慣れてる",
            "zh": "被骂我已经习惯了",
            "narrator_zh": ""
        },
        {
            "location": "840/TALK",
            "narrator": "神楽",
            "text": "本当にごめんなさい",
            "zh": "真的对不起",
            "narrator_zh": "神乐"
        },
        {
            "location": "841/TALK",
            "narrator": "神楽",
            "text": "$handle$さんに負担をかけてしまって",
            "zh": "给$handle$添负担了",
            "narrator_zh": "神乐"
        },
        {
            "location": "842/ACT",
            "narrator": "",
            "text": "未来のことは言ってない",
            "zh": "我没说未来的事",
            "narrator_zh": ""
        },
        {
            "location": "843/TALK",
            "narrator": "神楽",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "神乐"
        },
        {
            "location": "844/TALK",
            "narrator": "神楽",
            "text": "言われてみれば確かに！",
            "zh": "这么一说，确实！",
            "narrator_zh": "神乐"
        },
        {
            "location": "845/TALK",
            "narrator": "神楽",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "神乐"
        },
        {
            "location": "846/TALK",
            "narrator": "神楽",
            "text": "とりあえずの無事がわかって安心しました",
            "zh": "知道眼下平安，我就安心了",
            "narrator_zh": "神乐"
        },
        {
            "location": "848/TALK",
            "narrator": "神楽",
            "text": "私が母を護ろうとしているのと同じで",
            "zh": "就和我想保护母亲一样",
            "narrator_zh": "神乐"
        },
        {
            "location": "849/TALK",
            "narrator": "神楽",
            "text": "$handle$さんは",
            "zh": "$handle$",
            "narrator_zh": "神乐"
        },
        {
            "location": "850/TALK",
            "narrator": "神楽",
            "text": "私のことをこうやって",
            "zh": "也是这样",
            "narrator_zh": "神乐"
        },
        {
            "location": "851/TALK",
            "narrator": "神楽",
            "text": "護ってくれているんですよね",
            "zh": "保护着我，对吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "852/TALK",
            "narrator": "神楽",
            "text": "改めて実感しました",
            "zh": "我重新认识到了",
            "narrator_zh": "神乐"
        },
        {
            "location": "853/TALK",
            "narrator": "神楽",
            "text": "これからも",
            "zh": "今后也是",
            "narrator_zh": "神乐"
        },
        {
            "location": "854/TALK",
            "narrator": "神楽",
            "text": "私を護ってくださいね",
            "zh": "请保护我哦",
            "narrator_zh": "神乐"
        },
        {
            "location": "859/TALK",
            "narrator": "神楽",
            "text": "…本当、よかった。\n今のところは無事みたいで。",
            "zh": "……真的，太好了。\n眼下好像是平安的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "860/TALK",
            "narrator": "神楽",
            "text": "…でも、これから\nどうなるのかは\nわからないし…。",
            "zh": "……可是，之后\n会变成什么样，\n还不知道……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "861/TALK",
            "narrator": "神楽",
            "text": "さっさと終わらせて、\nママのところに\n急がなくちゃ！",
            "zh": "得快点结束，\n赶到妈妈\n那里去！",
            "narrator_zh": "神乐"
        },
        {
            "location": "862/ACT",
            "narrator": "",
            "text": "$me$だって教えたい！！",
            "zh": "$me$也想告诉你！！",
            "narrator_zh": ""
        },
        {
            "location": "863/TALK",
            "narrator": "神楽",
            "text": "だったら",
            "zh": "那样的话",
            "narrator_zh": "神乐"
        },
        {
            "location": "866/TALK",
            "narrator": "神楽",
            "text": "いえ",
            "zh": "不",
            "narrator_zh": "神乐"
        },
        {
            "location": "867/TALK",
            "narrator": "神楽",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": "神乐"
        },
        {
            "location": "868/TALK",
            "narrator": "神楽",
            "text": "$handle$さんはいつも",
            "zh": "$handle$一直",
            "narrator_zh": "神乐"
        },
        {
            "location": "869/TALK",
            "narrator": "神楽",
            "text": "私のことを心配して",
            "zh": "担心着我",
            "narrator_zh": "神乐"
        },
        {
            "location": "870/TALK",
            "narrator": "神楽",
            "text": "力になってくれてました",
            "zh": "还帮着我",
            "narrator_zh": "神乐"
        },
        {
            "location": "871/TALK",
            "narrator": "神楽",
            "text": "なのにあんな酷いことを言うなんて",
            "zh": "我却说了那么过分的话",
            "narrator_zh": "神乐"
        },
        {
            "location": "874/TALK",
            "narrator": "神楽",
            "text": "やっぱり今は",
            "zh": "果然现在的我",
            "narrator_zh": "神乐"
        },
        {
            "location": "875/TALK",
            "narrator": "神楽",
            "text": "冷静じゃないみたいです",
            "zh": "好像并不冷静",
            "narrator_zh": "神乐"
        },
        {
            "location": "877/TALK",
            "narrator": "神楽",
            "text": "多分",
            "zh": "大概",
            "narrator_zh": "神乐"
        },
        {
            "location": "878/TALK",
            "narrator": "神楽",
            "text": "落ち着くのは無理だと思うけど",
            "zh": "要冷静下来是不可能了",
            "narrator_zh": "神乐"
        },
        {
            "location": "879/TALK",
            "narrator": "神楽",
            "text": "努力はしてみます",
            "zh": "但我会试着努力",
            "narrator_zh": "神乐"
        },
        {
            "location": "882/TALK",
            "narrator": "神楽",
            "text": "本当ごめんなさい",
            "zh": "真的对不起",
            "narrator_zh": "神乐"
        },
        {
            "location": "888/TALK",
            "narrator": "神楽",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "889/TALK",
            "narrator": "神楽",
            "text": "私、最低だったかも。",
            "zh": "我，也许糟透了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "890/TALK",
            "narrator": "神楽",
            "text": "…でも、こうしてる今も、\nママはフェノメノンの\nどこかにいるんだし…。",
            "zh": "……可是，就算现在这样，\n妈妈也还在PhenoMENON的\n某个地方……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "892/TALK",
            "narrator": "神楽",
            "text": "さっさと終わらせて、\nママのところへ\n急がなくちゃ…！",
            "zh": "得快点结束，\n赶到妈妈\n那里去……！",
            "narrator_zh": "神乐"
        },
        {
            "location": "894/ACT",
            "narrator": "",
            "text": "どうせわからないと思うけど",
            "zh": "反正你也不懂吧",
            "narrator_zh": ""
        },
        {
            "location": "897/TALK",
            "narrator": "神楽",
            "text": "あのさ",
            "zh": "我说啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "898/TALK",
            "narrator": "神楽",
            "text": "人の大切な人にそんなこと言うとか",
            "zh": "对别人重要的人说这种话",
            "narrator_zh": "神乐"
        },
        {
            "location": "899/TALK",
            "narrator": "神楽",
            "text": "頭おかしいんじゃない？",
            "zh": "你脑子没问题吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "900/TALK",
            "narrator": "神楽",
            "text": "私の気持ちもわからないなら二度と話さないから",
            "zh": "要是连我的心情都不懂，我就再也不跟你说话了",
            "narrator_zh": "神乐"
        },
        {
            "location": "907/ACT",
            "narrator": "",
            "text": "これ以上好きになりたくないから？",
            "zh": "因为不想再喜欢下去了？",
            "narrator_zh": ""
        },
        {
            "location": "909/TALK",
            "narrator": "神楽",
            "text": "いやそうじゃなくて",
            "zh": "不，不是那样",
            "narrator_zh": "神乐"
        },
        {
            "location": "912/TALK",
            "narrator": "神楽",
            "text": "やっぱりいいです",
            "zh": "还是算了",
            "narrator_zh": "神乐"
        },
        {
            "location": "913/TALK",
            "narrator": "神楽",
            "text": "お話付き合ってくれてありがとうございました",
            "zh": "谢谢你陪我说话",
            "narrator_zh": "神乐"
        },
        {
            "location": "918/TALK",
            "narrator": "神楽",
            "text": "…それなりに長い付き合い\nなのに、全然私のこと\n理解してないみたい。",
            "zh": "……都相处这么久了，\n却好像完全\n不理解我。",
            "narrator_zh": "神乐"
        },
        {
            "location": "919/TALK",
            "narrator": "神楽",
            "text": "ちょっと、ガッカリかも…。",
            "zh": "有点，失望……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "930/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【13 電脳料理人】",
            "zh": "【13 电脑厨师】",
            "narrator_zh": "Dialog_chapter_ch05"
        },
        {
            "location": "942/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【13 電脳料理人】",
            "zh": "【13 电脑厨师】",
            "narrator_zh": "Dialog_chapter_ch05"
        }
    ]
}
