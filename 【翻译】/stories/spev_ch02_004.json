{
    "dir": "chap00/daydra/spev_ch02_004.js",
    "type": "",
    "info": {
        "story_id": "2004",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "至福の眺め",
        "title_zh": "特别篇",
        "sub_title_zh": "至福的光景"
    },
    "entry": [
        {
            "location": "18/TALK",
            "narrator": "透明アーヤ",
            "text": "ふふっ、よく寝てる。",
            "zh": "呵呵，睡得很熟。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "19/TALK",
            "narrator": "透明アーヤ",
            "text": "やっぱり、\n疲れが溜まってたの\nかしら？",
            "zh": "果然，\n疲劳积下来了\n吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "20/TALK",
            "narrator": "透明アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "21/TALK",
            "narrator": "透明アーヤ",
            "text": "せっかくの\nデートなのに…。",
            "zh": "难得的\n约会……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "22/TALK",
            "narrator": "透明アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "23/TALK",
            "narrator": "透明アーヤ",
            "text": "でもまあ、\nこれも悪くないけど…。",
            "zh": "不过嘛，\n这样也不坏……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "24/TALK",
            "narrator": "透明アーヤ",
            "text": "…あら？",
            "zh": "……哎呀？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "30/TALK",
            "narrator": "透明アーヤ",
            "text": "ごめんなさい、\n起こしちゃった？",
            "zh": "对不起，\n把你弄醒了？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "33/SEL",
            "narrator": "（選択肢）",
            "text": "え？　どういう状況？",
            "zh": "咦？　这是什么情况？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "34/ACT",
            "narrator": "",
            "text": "え？　どういう状況？",
            "zh": "咦？　这是什么情况？",
            "narrator_zh": ""
        },
        {
            "location": "36/TALK",
            "narrator": "透明アーヤ",
            "text": "覚えてない？",
            "zh": "不记得了？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "透明アーヤ",
            "text": "公園でデートしてたら、\n疲れたって言うから\nベンチに座ったの。",
            "zh": "在公园约会的时候，\n你说累了，\n所以坐到了长椅上。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "透明アーヤ",
            "text": "そしたら$handle$、\nそのまま寝落ち\nしちゃったのよ？",
            "zh": "结果$handle$，\n就那样睡过去\n了？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "透明アーヤ",
            "text": "本当、ビックリした…。\nでも、とっても疲れてた\nみたいね。",
            "zh": "真的吓了一跳……\n不过，看起来\n真的很累。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "40/SEL",
            "narrator": "（選択肢）",
            "text": "ごめん",
            "zh": "对不起",
            "narrator_zh": "（选项）"
        },
        {
            "location": "41/ACT",
            "narrator": "",
            "text": "ごめん",
            "zh": "对不起",
            "narrator_zh": ""
        },
        {
            "location": "43/TALK",
            "narrator": "透明アーヤ",
            "text": "謝らなくていいから、\nもう少しそのままで\nいた方がいいわ。",
            "zh": "不用道歉，\n再这样\n待一会儿比较好。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "透明アーヤ",
            "text": "休める時は休む。\nじゃなきゃ、\n身体が持たないわ。",
            "zh": "能休息的时候就休息。\n不然的话，\n身体会撑不住。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "45/SEL",
            "narrator": "（選択肢）",
            "text": "ていうか、これ、膝枕？",
            "zh": "话说，这是膝枕？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "46/ACT",
            "narrator": "",
            "text": "ていうか、これ、膝枕？",
            "zh": "话说，这是膝枕？",
            "narrator_zh": ""
        },
        {
            "location": "49/TALK",
            "narrator": "透明アーヤ",
            "text": "あっ…わ、私がしようと\n思ったわけじゃないのよ！",
            "zh": "啊……我、我不是\n想这么做的！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "透明アーヤ",
            "text": "隣で寝てた$handle$が、\nだんだん横になって、\n倒れてきたから…。",
            "zh": "旁边睡着的$handle$，\n慢慢躺下来，\n倒过来了……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "51/SEL",
            "narrator": "（選択肢）",
            "text": "良い夢見れた理由がわかった",
            "zh": "难怪会做个好梦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "52/SEL",
            "narrator": "（選択肢）",
            "text": "重かったよね、ごめんね",
            "zh": "很重吧，对不起",
            "narrator_zh": "（选项）"
        },
        {
            "location": "53/ACT",
            "narrator": "",
            "text": "良い夢見れた理由がわかった",
            "zh": "难怪会做个好梦",
            "narrator_zh": ""
        },
        {
            "location": "55/TALK",
            "narrator": "透明アーヤ",
            "text": "あら、私の膝枕だと\nそんないい夢見れるの？",
            "zh": "哎呀，枕着我的膝盖\n就能做那么好的梦？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "56/SEL",
            "narrator": "（選択肢）",
            "text": "毎日寝たいな",
            "zh": "真想每天都这样睡",
            "narrator_zh": "（选项）"
        },
        {
            "location": "57/SEL",
            "narrator": "（選択肢）",
            "text": "好きな人の膝枕だからね",
            "zh": "因为是喜欢的人的膝枕",
            "narrator_zh": "（选项）"
        },
        {
            "location": "58/ACT",
            "narrator": "",
            "text": "毎日寝たいな",
            "zh": "真想每天都这样睡",
            "narrator_zh": ""
        },
        {
            "location": "60/TALK",
            "narrator": "透明アーヤ",
            "text": "あはは…それはちょっと、\n私が大変かも…。",
            "zh": "啊哈哈……那有点，\n我会吃不消……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "透明アーヤ",
            "text": "でも、時々だったら\nいいかな？",
            "zh": "不过，偶尔的话\n可以吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "62/ACT",
            "narrator": "",
            "text": "好きな人の膝枕だからね",
            "zh": "因为是喜欢的人的膝枕",
            "narrator_zh": ""
        },
        {
            "location": "66/TALK",
            "narrator": "透明アーヤ",
            "text": "えぇっ！？",
            "zh": "咦咦！？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "透明アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "68/TALK",
            "narrator": "透明アーヤ",
            "text": "そ、そうやって\n突然恥ずかしいこと\n言ったらダメよ。",
            "zh": "不、不能那样\n突然说\n让人害羞的话。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "69/TALK",
            "narrator": "透明アーヤ",
            "text": "言われた方は驚いて、\nどう反応したらいいか\nわからないんだから…。",
            "zh": "被说的人会吓一跳，\n不知道该\n怎么反应……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "透明アーヤ",
            "text": "あ、でも別に\n怒ってるわけじゃ\nないから！？",
            "zh": "啊，不过我\n并没有\n在生气！？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "透明アーヤ",
            "text": "ただ、ビックリし過ぎて\n変なこと言っちゃうかも\nしれないでしょ…？",
            "zh": "只是吓过头了，\n可能会说出\n奇怪的话吧……？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "72/SEL",
            "narrator": "（選択肢）",
            "text": "カワイイね、見てみたいな",
            "zh": "好可爱，真想看看",
            "narrator_zh": "（选项）"
        },
        {
            "location": "73/ACT",
            "narrator": "",
            "text": "カワイイね、見てみたいな",
            "zh": "好可爱，真想看看",
            "narrator_zh": ""
        },
        {
            "location": "76/TALK",
            "narrator": "透明アーヤ",
            "text": "こ、こっちは\n恥ずかしいだけよ…。",
            "zh": "我、我这边\n只是害羞……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "77/TALK",
            "narrator": "透明アーヤ",
            "text": "…それに、見てみたいも\n何も…今見てるじゃない。",
            "zh": "……而且，说什么想看\n……你现在不就在看吗。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "透明アーヤ",
            "text": "…ああ、ほら！\nやっぱり変なこと\n言っちゃってる…。",
            "zh": "……啊，你看！\n果然说出\n奇怪的话了……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "80/ACT",
            "narrator": "",
            "text": "重かったよね、ごめんね",
            "zh": "很重吧，对不起",
            "narrator_zh": ""
        },
        {
            "location": "83/TALK",
            "narrator": "透明アーヤ",
            "text": "あ、ううん。\nそんなことないから。",
            "zh": "啊，没有。\n没有那么重。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "透明アーヤ",
            "text": "膝枕は地元にいた頃、\n時々やってたし。\n慣れてるのよ。",
            "zh": "膝枕的话，在老家的时候\n偶尔会做。\n我习惯了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "85/SEL",
            "narrator": "（選択肢）",
            "text": "どういうこと！？",
            "zh": "什么意思！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "86/SEL",
            "narrator": "（選択肢）",
            "text": "膝枕のプロだね",
            "zh": "真是膝枕专家",
            "narrator_zh": "（选项）"
        },
        {
            "location": "87/ACT",
            "narrator": "",
            "text": "どういうこと！？",
            "zh": "什么意思！？",
            "narrator_zh": ""
        },
        {
            "location": "88/TALK",
            "narrator": "透明アーヤ",
            "text": "ふふっ…部活の後輩とか\n友達がふざけて、\n時々枕にしてたのよ。",
            "zh": "呵呵……社团的后辈\n和朋友闹着玩，\n偶尔拿我当枕头。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "透明アーヤ",
            "text": "彼氏いないから\n気分だけでも恋人感覚\n味わいたい、って…。",
            "zh": "因为没有男朋友，\n就算只有心情，也想体会\n恋人的感觉，她们说……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "透明アーヤ",
            "text": "ふふっ、安心した？",
            "zh": "呵呵，放心了？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "91/SEL",
            "narrator": "（選択肢）",
            "text": "安心したけど、悔しい…",
            "zh": "是放心了，但是不甘心……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "92/ACT",
            "narrator": "",
            "text": "安心したけど、悔しい…",
            "zh": "是放心了，但是不甘心……",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "透明アーヤ",
            "text": "もぅ、そんな悔しがる\nことじゃないでしょ？",
            "zh": "真是的，这种事\n有什么好不甘心的？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "96/TALK",
            "narrator": "透明アーヤ",
            "text": "それに…男の人は\n$handle$が初めて\nなんだし…。",
            "zh": "而且……男生的话，\n$handle$是第一个\n……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "97/TALK",
            "narrator": "透明アーヤ",
            "text": "なんてね。",
            "zh": "开玩笑的。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "98/ACT",
            "narrator": "",
            "text": "膝枕のプロだね",
            "zh": "真是膝枕专家",
            "narrator_zh": ""
        },
        {
            "location": "101/TALK",
            "narrator": "透明アーヤ",
            "text": "あ、あはは…、\n反応に困るわね、それ…。",
            "zh": "啊、啊哈哈……\n这个我都不知道怎么反应……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "105/TALK",
            "narrator": "透明アーヤ",
            "text": "はぁ…それにしても、\nせっかくのデートなのに、\n公園だけで終わりそうね。",
            "zh": "唉……话说回来，\n难得的约会，\n好像只在公园就结束了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "106/TALK",
            "narrator": "透明アーヤ",
            "text": "本当は、もっと色んなとこ\n行きたかったんだけど…。",
            "zh": "本来还想去\n更多地方的……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "107/TALK",
            "narrator": "透明アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "109/TALK",
            "narrator": "透明アーヤ",
            "text": "まあ、こういう\nのんびりしたデートも、\n楽しくていいかな？",
            "zh": "不过，这种\n悠闲的约会，\n开心地过也不错吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "111/TALK",
            "narrator": "透明アーヤ",
            "text": "好きな人の寝顔も\n見れたわけだしね、\nふふっ…。",
            "zh": "喜欢的人的睡脸\n也看到了，\n呵呵……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "126/SEL",
            "narrator": "（選択肢）",
            "text": "こんなデートをしたいんだ！",
            "zh": "我想要这样的约会！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "127/ACT",
            "narrator": "",
            "text": "こんなデートをしたいんだ！",
            "zh": "我想要这样的约会！",
            "narrator_zh": ""
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "いや",
            "zh": "不是",
            "narrator_zh": "绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "アーヤ",
            "text": "あのね(-ω-;)",
            "zh": "那个(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "131/TALK",
            "narrator": "アーヤ",
            "text": "したい気持ちはわかった",
            "zh": "想要的心情我知道了",
            "narrator_zh": "绫水"
        },
        {
            "location": "132/TALK",
            "narrator": "アーヤ",
            "text": "けど",
            "zh": "但是",
            "narrator_zh": "绫水"
        },
        {
            "location": "133/TALK",
            "narrator": "アーヤ",
            "text": "私こんなこと言わないし！(>_<)",
            "zh": "我才不会说这种话！(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "135/SEL",
            "narrator": "（選択肢）",
            "text": "デートなのに！？",
            "zh": "这可是约会啊！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "136/ACT",
            "narrator": "",
            "text": "デートなのに！？",
            "zh": "这可是约会啊！？",
            "narrator_zh": ""
        },
        {
            "location": "138/TALK",
            "narrator": "アーヤ",
            "text": "デートだけど",
            "zh": "是约会",
            "narrator_zh": "绫水"
        },
        {
            "location": "139/TALK",
            "narrator": "アーヤ",
            "text": "好きな人の寝顔も見れたわけだし、ふふっ…",
            "zh": "喜欢的人的睡脸也看到了，呵呵……",
            "narrator_zh": "绫水"
        },
        {
            "location": "140/TALK",
            "narrator": "アーヤ",
            "text": "なんて絶対言わない！（｀皿´ )",
            "zh": "这种话我绝对不会说！（｀皿´ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "141/TALK",
            "narrator": "アーヤ",
            "text": "まったく",
            "zh": "真是的",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "アーヤ",
            "text": "妄想はほどほどにね？( ・_・)σﾞ",
            "zh": "妄想适可而止哦？( ・_・)σﾞ",
            "narrator_zh": "绫水"
        }
    ]
}
