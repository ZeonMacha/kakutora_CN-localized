{
    "dir": "chap12/daydra/dd_ch03_12_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "12305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "口添えを頼まれて＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "被拜托美言几句＜后篇＞"
    },
    "entry": [
        {
            "location": "505/SCENARIO",
            "narrator": "",
            "text": "口添えを頼まれて",
            "zh": "被拜托美言几句",
            "narrator_zh": ""
        },
        {
            "location": "522/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱり、\nこのまま\n放っておけないわ。",
            "zh": "……果然，\n不能就这么\n放着不管呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "524/TALK",
            "narrator": "ガブリエラ",
            "text": "口添えを引き受けた\n以上は――",
            "zh": "既然答应了\n帮她们说情——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "526/TALK",
            "narrator": "ガブリエラ",
            "text": "できる限りの\nフォローする\n責任はあるし。",
            "zh": "我就有责任\n尽我所能\n帮她们圆场。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "529/TALK",
            "narrator": "ガブリエラ",
            "text": "…ねえ、まほ。\n全員雇っちゃっても\nいいんじゃない？",
            "zh": "……喂，真幌。\n干脆把她们全雇下来\n不也挺好的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "531/TALK",
            "narrator": "真幌",
            "text": "勘弁してくれ…。\nおまえまで何を\n言い出すんだ？",
            "zh": "饶了我吧……。\n怎么连你也\n说出这种话来？",
            "narrator_zh": "真幌"
        },
        {
            "location": "532/TALK",
            "narrator": "ガブリエラ",
            "text": "雇った方がメリット\nあるから言ってる\nのよ。",
            "zh": "我是觉得雇用她们\n有好处才这么说的\n呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "534/TALK",
            "narrator": "ガブリエラ",
            "text": "トライナリーの仕事\nだけじゃなくて――",
            "zh": "不只是三重奏的\n工作——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "535/TALK",
            "narrator": "ガブリエラ",
            "text": "劇場の仕事だって、\n今よりラクになると\n思うし。",
            "zh": "连剧场这边的工作，\n我觉得也会比现在\n轻松不少。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "537/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、男の子達が\n入れば力仕事を\n任せられるでしょ？",
            "zh": "而且，男生们\n加进来的话，体力活\n也能交给他们不是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "539/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "540/TALK",
            "narrator": "キリト",
            "text": "ち、力仕事なら\n任せてくださいよ。\nなっ！？",
            "zh": "体、体力活的话\n尽管交给我们吧。\n对吧！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "541/TALK",
            "narrator": "ヒカル",
            "text": "え、ええ…。\n通常攻撃隊の訓練で\n鍛えられているので。",
            "zh": "是、是的……。\n我们在普通攻击队的\n训练里也是练过的。",
            "narrator_zh": "光"
        },
        {
            "location": "544/TALK",
            "narrator": "真幌",
            "text": "いや、しかし…。",
            "zh": "不，可是……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "545/TALK",
            "narrator": "ガブリエラ",
            "text": "それにね、この子達は\nあたしに口添えを\n頼んできたのよ？",
            "zh": "而且呢，这群孩子\n可是特意跑来拜托我\n帮她们说情的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "546/TALK",
            "narrator": "ガブリエラ",
            "text": "まほに頼んだって、\n十中八九断られるって\nわかってるのに。",
            "zh": "明明知道直接找真幌，\n十有八九会被拒绝，\n却还是来了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "547/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな行動力があるん\nだから、もし断ったり\nしても――",
            "zh": "既然有这种行动力，\n就算把她们\n拒绝了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "548/TALK",
            "narrator": "ガブリエラ",
            "text": "勝手に劇場の手伝いを\nし出す可能性もあると\n思うのよ。",
            "zh": "我觉得她们也很有可能\n擅自跑来剧场\n帮忙的哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "550/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなったら、\n余計面倒なことに\nなるんじゃない？",
            "zh": "要是变成那样，\n岂不是会更麻烦\n吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "551/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "553/TALK",
            "narrator": "雛",
            "text": "その通りです。\nやっちゃうかも\nしれませんよ！！",
            "zh": "就是这样。\n我们说不定真的\n会那么做哦！！",
            "narrator_zh": "雏"
        },
        {
            "location": "554/TALK",
            "narrator": "ガブリエラ",
            "text": "ほらね？",
            "zh": "你看吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "557/TALK",
            "narrator": "ガブリエラ",
            "text": "だったらあたし達の\n手元に置いといて――",
            "zh": "既然如此，不如把她们留在\n我们眼皮底下——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "558/TALK",
            "narrator": "ガブリエラ",
            "text": "望み通り、ここで\nこき使ってやれば\nいいじゃない。",
            "zh": "照她们的心愿，在这里\n使唤她们干活\n不就好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "560/TALK",
            "narrator": "ガブリエラ",
            "text": "望みを叶えてやれば、\nまほの気にしてる\n情報っていうのも――",
            "zh": "只要满足了她们的心愿，\n真幌你在意的\n那个情报——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "561/TALK",
            "narrator": "ガブリエラ",
            "text": "外に漏らしたりする\n心配はないはずよ。",
            "zh": "应该也不用担心\n会泄露到外面去了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "563/TALK",
            "narrator": "繭",
            "text": "約束します。\n二度と口には\n出しません。",
            "zh": "我保证。\n绝不会再\n提半个字。",
            "narrator_zh": "茧"
        },
        {
            "location": "565/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "566/TALK",
            "narrator": "真幌",
            "text": "はぁ…確かに、\nギャヴィの言う通り\nだな。",
            "zh": "哈啊……确实，\n就像加维\n说的那样啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "568/TALK",
            "narrator": "雛",
            "text": "じゃ、じゃあ、\nいいんですか！？",
            "zh": "那、那么，\n您同意了吗！？",
            "narrator_zh": "雏"
        },
        {
            "location": "569/TALK",
            "narrator": "真幌",
            "text": "その代わり！",
            "zh": "作为交换！",
            "narrator_zh": "真幌"
        },
        {
            "location": "571/TALK",
            "narrator": "真幌",
            "text": "もしもおまえ達が\n何か問題を起こした\n場合には――",
            "zh": "要是你们\n惹出什么\n麻烦的话——",
            "narrator_zh": "真幌"
        },
        {
            "location": "573/TALK",
            "narrator": "真幌",
            "text": "その責任は、\nギャヴィに\n取ってもらう。",
            "zh": "那个责任，\n就由加维\n来承担。",
            "narrator_zh": "真幌"
        },
        {
            "location": "575/TALK",
            "narrator": "ヒカル",
            "text": "えっ！？\nガブリエラさんは\n関係ありませんよ。",
            "zh": "诶！？\n这和加布里埃拉\n没有关系吧。",
            "narrator_zh": "光"
        },
        {
            "location": "577/TALK",
            "narrator": "真幌",
            "text": "口添えを引き受けた\n時点で大ありだ。",
            "zh": "从她答应帮忙说情的\n那一刻起，就大有关系了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "579/TALK",
            "narrator": "真幌",
            "text": "…どうする？",
            "zh": "……怎么样？",
            "narrator_zh": "真幌"
        },
        {
            "location": "582/TALK",
            "narrator": "ガブリエラ",
            "text": "…わかったわ。\nその時は、あたしが\n責任取るわよ。",
            "zh": "……我知道了。\n到那个时候，就由我来\n承担责任好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "584/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん！\nさすがにそれは…。",
            "zh": "加布里埃拉！\n这未免也太……。",
            "narrator_zh": "雏"
        },
        {
            "location": "587/TALK",
            "narrator": "ガブリエラ",
            "text": "何よ？\n問題起こそうと\n思ってるわけ？",
            "zh": "干嘛？\n难道你们还打算\n惹出什么麻烦吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "589/TALK",
            "narrator": "雛",
            "text": "そうじゃないけど…。",
            "zh": "倒不是那样……。",
            "narrator_zh": "雏"
        },
        {
            "location": "590/TALK",
            "narrator": "ガブリエラ",
            "text": "なら問題ないわ。",
            "zh": "那就没问题了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "592/TALK",
            "narrator": "真幌",
            "text": "そうか…。\nでは、決まりだな。",
            "zh": "是吗……。\n那么，就这么定了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "593/TALK",
            "narrator": "真幌",
            "text": "おまえ達には、\n今日からこの劇場で\n働いてもらうぞ。",
            "zh": "你们几个，\n从今天起就在这家剧场\n工作吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "595/TALK",
            "narrator": "キリト",
            "text": "ま、マジですか！？\nマジでいいんですか？",
            "zh": "真、真的吗！？\n真的可以吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "597/TALK",
            "narrator": "真幌",
            "text": "ああ…許可する。",
            "zh": "嗯……批准了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "599/TALK",
            "narrator": "雛",
            "text": "や、やったぁー！！",
            "zh": "太、太好了—！！",
            "narrator_zh": "雏"
        },
        {
            "location": "601/TALK",
            "narrator": "ヒカル",
            "text": "まさか、許可して\n頂けるなんて…。",
            "zh": "没想到，竟然真的\n能得到批准……。",
            "narrator_zh": "光"
        },
        {
            "location": "603/TALK",
            "narrator": "キリト",
            "text": "全部ガブリエラの\nおかげだな！",
            "zh": "全靠加布里埃拉\n才行啊！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "605/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんに\n頼んでよかったー。\nありがと！",
            "zh": "找加布里埃拉帮忙\n真是太好了—。\n谢谢你！",
            "narrator_zh": "雏"
        },
        {
            "location": "608/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あたしが\nラクしたかった\nだけよ。",
            "zh": "我、我只是\n想自己轻松点\n而已啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "609/TALK",
            "narrator": "ガブリエラ",
            "text": "人手が増えれば\nシフトの回数も\n減るだろうし…。",
            "zh": "人手增加的话，\n排班的次数\n也会减少嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "611/TALK",
            "narrator": "雛",
            "text": "それでも感謝だよ！\nガブリエラちゃん\n大好き！！",
            "zh": "即便如此还是很感激你！\n最喜欢加布里埃拉\n了！！",
            "narrator_zh": "雏"
        },
        {
            "location": "612/TALK",
            "narrator": "雛",
            "text": "絶対、責任取らせる\nような問題は起こさ\nないからね！",
            "zh": "我们绝对不会惹出\n让你担责的\n麻烦来的！",
            "narrator_zh": "雏"
        },
        {
            "location": "615/TALK",
            "narrator": "ガブリエラ",
            "text": "はいはい…。\nまあ、期待してるわ。",
            "zh": "好好好……。\n嘛，我拭目以待。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "617/TALK",
            "narrator": "真幌",
            "text": "よし、男子二人は\n私に付いて来い。",
            "zh": "好，两个男生\n跟我来。",
            "narrator_zh": "真幌"
        },
        {
            "location": "618/TALK",
            "narrator": "真幌",
            "text": "早速力仕事を\nしてもらうぞ。",
            "zh": "马上就有体力活\n要交给你们干。",
            "narrator_zh": "真幌"
        },
        {
            "location": "619/TALK",
            "narrator": "キリト",
            "text": "了解っす！",
            "zh": "明白！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "620/TALK",
            "narrator": "ヒカル",
            "text": "わかりました。",
            "zh": "知道了。",
            "narrator_zh": "光"
        },
        {
            "location": "629/TALK",
            "narrator": "雛",
            "text": "まゆちん。\nあたし達も\n頑張ろうね！",
            "zh": "小茧。\n我们也\n加油吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "630/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "631/TALK",
            "narrator": "雛",
            "text": "あれ、まゆちん？",
            "zh": "咦，小茧？",
            "narrator_zh": "雏"
        },
        {
            "location": "632/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "641/TALK",
            "narrator": "雛",
            "text": "まゆちん！？",
            "zh": "小茧！？",
            "narrator_zh": "雏"
        },
        {
            "location": "642/TALK",
            "narrator": "雛",
            "text": "…気絶してる。",
            "zh": "……晕过去了。",
            "narrator_zh": "雏"
        },
        {
            "location": "643/TALK",
            "narrator": "ガブリエラ",
            "text": "まほの気迫を\n真正面から受けたん\nだし、当然よ。",
            "zh": "毕竟正面承受了\n真幌的威压，\n这也是当然的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "645/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃ、最初の仕事よ。\n楽屋に運んで寝かして\nあげなさい。",
            "zh": "好啦，第一份工作来了。\n把她抬到后台休息室\n躺着去吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "646/TALK",
            "narrator": "雛",
            "text": "初仕事りょーかい！\nほら、まゆちん\n行くよー。",
            "zh": "第一份工作收到！\n来，小茧\n我们走咯—。",
            "narrator_zh": "雏"
        },
        {
            "location": "650/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "652/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "664/TALK",
            "narrator": "ガブリエラ",
            "text": "面倒なこと引き受けちゃったわ",
            "zh": "接下了一桩麻烦事呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "665/TALK",
            "narrator": "ガブリエラ",
            "text": "口添えするだけの話のはずだったのに",
            "zh": "明明原本只是说帮忙美言几句而已",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "666/TALK",
            "narrator": "ガブリエラ",
            "text": "あの子達が問題起こしたら、その責任を取らなくちゃいけないとか",
            "zh": "结果那些孩子要是惹出麻烦，还得由我来承担责任什么的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "667/TALK",
            "narrator": "ガブリエラ",
            "text": "おもいっきり貧乏くじ引いた感じだわ",
            "zh": "简直感觉自己抽中了天字第一号下下签",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "669/SEL",
            "narrator": "",
            "text": "みんな喜んでくれたね",
            "zh": "大家都很开心呢",
            "narrator_zh": ""
        },
        {
            "location": "670/ACT",
            "narrator": "",
            "text": "みんな喜んでくれたね",
            "zh": "大家都很开心呢",
            "narrator_zh": ""
        },
        {
            "location": "672/TALK",
            "narrator": "ガブリエラ",
            "text": "望み通りの結果になったんだもの、喜んで当然よ",
            "zh": "毕竟得到了想要的结果，开心也是理所当然的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "673/TALK",
            "narrator": "ガブリエラ",
