{
    "dir": "chap11/daydra/dd_ch03_11_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "11352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "ガブリエラ日記",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "加布里埃拉日记"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "ガブリエラ日記",
            "zh": "加布里埃拉日记",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぁ～…今日も暇ねぇ…。",
            "zh": "呼哇～…今天也好闲啊…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "25/TALK",
            "narrator": "ガブリエラ",
            "text": "…こうしてボーッと\nしてると、なんだか\n眠くなってくるわ。",
            "zh": "…像这样一直发呆，\n总觉得都有点\n犯困了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "時間も勿体ないし…。",
            "zh": "时间也挺浪费的…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "27/TALK",
            "narrator": "ガブリエラ",
            "text": "今のうちに、少しだけ\n日記書いとこうかしら。",
            "zh": "趁现在，干脆写点\n日记打发时间吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "28/TALK",
            "narrator": "ガブリエラ",
            "text": "えっと、確か鞄の中に…\nっと、あったあった。",
            "zh": "嗯，记得是在包里…\n哦，找到了找到了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "さて、と…。",
            "zh": "那么，开始吧…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "○月×日。\n今日はとても素敵な一日\nだったから――",
            "zh": "○月×日。\n今天是很棒的\n一天——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "書くことが多くて、\nちょっと大変かも。",
            "zh": "要写的事太多，\n搞不好还有点写不过来呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "午前の授業、今日は凄く\n眠かったけど、どうにか\n眠らずに頑張れた。",
            "zh": "上午的课，今天虽然\n困得要命，但还是\n咬牙撑住没睡着。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな自分へのご褒美に、\nお昼ご飯はちょっとだけ\n豪華にデザート追加。",
            "zh": "为了犒劳这样的自己，\n午饭稍微奢侈了一点，\n多加了份甜点。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "36/SEL",
            "narrator": "",
            "text": "そんな一日だったの？",
            "zh": "是这样的一天吗？",
            "narrator_zh": ""
        },
        {
            "location": "38/TALK",
            "narrator": "ガブリエラ",
            "text": "やる気の補給完了！\nおかげで午後の授業は\n完璧、ＧＯＯＤ☆",
            "zh": "干劲补给完毕！\n多亏这个，下午的课\n完美，GOOD☆",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "39/TALK",
            "narrator": "ガブリエラ",
            "text": "もちろん、放課後は\nバイトの前にプチ休憩。",
            "zh": "当然，放学后\n在打工前也要小憩一下。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "お友達と一緒にカフェで\nお喋りしながらの\nティータイム。",
            "zh": "和朋友一起在咖啡馆\n一边聊天一边享受\n下午茶时光。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "恋バナとか、私にはまだ\n早過ぎ？",
            "zh": "恋爱话题什么的，对我来说\n还太早了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "ガブリエラ",
            "text": "早くバイトを終わらせて、\n夜はまたお友達と\nお話したいな。",
            "zh": "真想早点结束打工，\n晚上再继续和朋友\n聊个痛快呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "…ん、こんなもんかしら？",
            "zh": "…嗯，差不多就这样吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、時間潰しにも\nならなかったわね。",
            "zh": "话说回来，根本没起到\n打发时间的作用嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "…動画サイトでも見て、\n時間潰そう。",
            "zh": "…还是看会儿视频网站\n消磨时间吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/ACT",
            "narrator": "",
            "text": "そんな一日だったの？",
            "zh": "是这样的一天吗？",
            "narrator_zh": ""
        },
        {
            "location": "57/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ…やだ！！",
            "zh": "哎…讨厌！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "71/TALK",
            "narrator": "ガブリエラ",
            "text": "もう、マルザンナ！",
            "zh": "真是的，玛尔赞娜！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "人の日記を見るのはマナー違反よ！？",
            "zh": "偷看别人日记可是违反礼貌的哦！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、マルザンナで安心したけど",
            "zh": "…不过，还好是玛尔赞娜，那我就放心了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "この日記はね、日記の中に、自分の願望を混ぜて書いてるの",
            "zh": "这本日记呢，是把自己的愿望也混在里面一起写的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "こうだったら良かったな、こうだったら楽しかっただろうなぁ、って",
            "zh": "想着要是这样就好了、要是这样肯定会很开心吧，之类的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "そうやって書くと、意外と面白いのよ？",
            "zh": "这么写下来，意外地还挺有意思的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/SEL",
            "narrator": "",
            "text": "願望じゃない部分はどこ？",
            "zh": "不是愿望的部分是哪段？",
            "narrator_zh": ""
        },
        {
            "location": "81/ACT",
            "narrator": "",
            "text": "願望じゃない部分はどこ？",
            "zh": "不是愿望的部分是哪段？",
            "narrator_zh": ""
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "…マルザンナのいじわる",
            "zh": "…玛尔赞娜真坏心眼",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "ガブリエラ",
            "text": "わかってるくせに",
            "zh": "明明心里都知道的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "神楽",
            "text": "ガブちゃん、\nそっちの作業は――",
            "zh": "加布，\n你那边的工作——",
            "narrator_zh": "神乐"
        },
        {
            "location": "100/TALK",
            "narrator": "神楽",
            "text": "その様子だと、\n終わってるみたいですね。",
            "zh": "看这架势，\n好像已经做完了呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、とっくにね。",
            "zh": "嗯，早就弄完了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "神楽",
            "text": "そっちの作業も\n終わっているなら、\n一息入れませんか？",
            "zh": "既然你那边的工作也\n做完了，要不要\n歇一口气呀？",
            "narrator_zh": "神乐"
        },
        {
            "location": "104/TALK",
            "narrator": "神楽",
            "text": "学校帰りに、大好きな\n紅茶の葉を買ってきたん\nです。",
            "zh": "放学回来的路上，我买了\n最喜欢的红茶茶叶\n哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "いいわね。\nいただくわ。",
            "zh": "不错呀。\n那我就不客气了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "神楽",
            "text": "はい…………？",
            "zh": "好的…………？",
            "narrator_zh": "神乐"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "なに？",
            "zh": "怎么了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "神楽",
            "text": "そのノート、ガブちゃんの\nですか？",
            "zh": "那个笔记本，是加布\n的吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "やだ、開いたまま！？",
            "zh": "糟了，居然还摊开着！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/TALK",
            "narrator": "神楽",
            "text": "ガブちゃん、これって…。",
            "zh": "加布，这个是…。",
            "narrator_zh": "神乐"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "こ、これはその…\nえっと…。",
            "zh": "这、这个是那个…\n呃…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "神楽",
            "text": "ガブちゃんって、\n小説を書く趣味が\nあったんですね。",
            "zh": "原来加布还有\n写小说的爱好\n呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "え？",
            "zh": "咦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/TALK",
            "narrator": "神楽",
            "text": "驚きました。\nそんな素振り、ちっとも\n見えませんでしたし。",
            "zh": "真让我吃惊。\n平时完全没看出\n有这方面的迹象呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "121/TALK",
            "narrator": "ガブリエラ",
            "text": "…もしかして、これが\n日記ってことに気付いて\nない？",
            "zh": "…难道说，她没发现\n这是日记吗\n？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "それなら、こっちとしては\nありがたいけど…。",
            "zh": "那样的话，对我来说\n倒是求之不得…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "神楽",
            "text": "どんな話なのかは\n聞かないけど――",
            "zh": "虽然我不会打听\n写的是什么故事——",
            "narrator_zh": "神乐"
        },
        {
            "location": "125/TALK",
            "narrator": "神楽",
            "text": "完成したら、絶対に\n読ませてくださいね！",
            "zh": "写完之后，一定要\n让我拜读一下哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "…ど、どうしよう。",
            "zh": "…怎、怎么办。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "たすけてまるざんな",
            "zh": "救命啊玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/SEL",
            "narrator": "",
            "text": "日記だと正直に言おう",
            "zh": "老实说这是日记吧",
            "narrator_zh": ""
        },
        {
            "location": "143/SEL",
            "narrator": "",
            "text": "とりあえず頷いておこう",
            "zh": "先点点头蒙混过去吧",
            "narrator_zh": ""
        },
        {
            "location": "144/ACT",
            "narrator": "",
            "text": "日記だと正直に言おう",
            "zh": "老实说这是日记吧",
            "narrator_zh": ""
        },
        {
            "location": "156/TALK",
            "narrator": "ガブリエラ",
            "text": "間違えられたままじゃ、\nみんなに話が広がるかも\nしれないし――",
            "zh": "要是就这么被误会下去，\n说不定会在大家中间\n传开的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "157/TALK",
            "narrator": "ガブリエラ",
            "text": "仕方ないわ。\nこうなったら…。",
            "zh": "没办法了。\n事到如今…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "159/TALK",
            "narrator": "ガブリエラ",
            "text": "これ、小説じゃないわ。\nあたしの日記よ。",
            "zh": "这不是什么小说。\n是我的日记啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "160/TALK",
            "narrator": "神楽",
            "text": "日記？",
            "zh": "日记？",
            "narrator_zh": "神乐"
        },
        {
            "location": "161/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ。\nだからノートが埋まったと\nしても、見せられないわ。",
            "zh": "没错。\n所以就算这本子写满了，\n也不能给你看哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "日記なんだから、\n見せなくても変じゃ\nないわよね？",
            "zh": "因为是日记嘛，\n不给人看也一点都不\n奇怪对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "164/TALK",
            "narrator": "神楽",
            "text": "…あの、本当にそれ、\n日記なんですか？",
            "zh": "…那个，那真的\n是日记吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、日記だってば。\n信じないの？",
            "zh": "我都说了是日记嘛。\n你不信吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "神楽",
            "text": "えっと…本当に日記だと\nしたら、ちょっとだけ\n申し訳ないけど――",
            "zh": "呃…如果真的是日记，\n那我稍微有点\n过意不去——",
            "narrator_zh": "神乐"
        },
        {
            "location": "168/TALK",
            "narrator": "神楽",
            "text": "ほんの少しだけ、\n内容が見えちゃったん\nです。",
            "zh": "其实我刚才不小心\n瞥到了一点点\n内容。",
            "narrator_zh": "神乐"
        },
        {
            "location": "169/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "170/TALK",
            "narrator": "ガブリエラ",
            "text": "ど、どこを見たの！？\nなんて書いてあった！？",
            "zh": "你、你看到哪里了！？\n上面写了什么！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "神楽",
            "text": "え、えっと、確か――",
            "zh": "呃、那个，记得是——",
            "narrator_zh": "神乐"
        },
        {
            "location": "174/TALK",
            "narrator": "神楽",
            "text": "『やる気の補給完了！\nおかげで午後の授業は\n完璧、ＧＯＯＤ☆』",
            "zh": "“干劲补给完毕！\n多亏这个，下午的课\n完美，GOOD☆”",
            "narrator_zh": "神乐"
        },
        {
            "location": "175/TALK",
            "narrator": "神楽",
            "text": "っていうのが見えました。",
            "zh": "我看到了这一句。",
            "narrator_zh": "神乐"
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "よ、よりにもよって、\nそこ！？",
            "zh": "偏、偏偏就看到\n那一段！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "178/TALK",
            "narrator": "神楽",
            "text": "文章が可愛かったから、\n日記とは思えなかった\nです。",
            "zh": "因为文笔很可爱，\n所以才没觉得像\n日记呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "…見間違い。",
            "zh": "…你看错了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "180/TALK",
            "narrator": "神楽",
            "text": "え？",
            "zh": "咦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "183/TALK",
            "narrator": "ガブリエラ",
            "text": "それ、見間違いだから。\nそんなこと書いてないし。",
            "zh": "那肯定是你看错了。\n根本没写那种东西。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "ガブリエラ",
            "text": "『学校行って勉強して、\n何事もなく一日終わり\nそうだ』",
            "zh": "“去学校上课学习，\n平平淡淡地结束一天的\n样子”",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "185/TALK",
            "narrator": "ガブリエラ",
            "text": "今日の日記の内容は\nこんな感じよ？",
            "zh": "今天的日记内容\n差不多就是这样哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "187/TALK",
            "narrator": "神楽",
            "text": "内容違いすぎますよ！\n私が見たのとまったく\n違うじゃないですか？",
            "zh": "内容差太多了吧！\n跟我刚才看到的完全\n不一样不是吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "189/TALK",
            "narrator": "ガブリエラ",
            "text": "で、でも、実際そんなこと\n書いてないんだから――",
            "zh": "可、可是，实际上确实\n没写那种话嘛——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽の見間違いなの！\nわかった！？",
            "zh": "就是神乐你看错了！\n明白了吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "191/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "193/TALK",
            "narrator": "神楽",
            "text": "はぁ…わかりました。\nガブちゃんがそこまで\n言うなら――",
            "zh": "哈啊…好吧。\n既然加布都这么\n说了——",
            "narrator_zh": "神乐"
        },
        {
            "location": "194/TALK",
            "narrator": "神楽",
            "text": "そういうことに\nしておきます。",
            "zh": "那就姑且当成是\n那样吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "それが事実なの！",
            "zh": "本来就是事实嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "神楽",
            "text": "わかってますよー。\nそれじゃ、紅茶煎れて\nきますね。",
            "zh": "我知道啦—。\n那我就去泡红茶\n了哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "202/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ…もうっ！",
            "zh": "啊…真是的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/TALK",
            "narrator": "ガブリエラ",
            "text": "…仕方ないか。\nあたしが不注意だったのが\n悪いんだし…。",
            "zh": "…也没办法了。\n谁让我自己太粗心\n大意呢…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "ガブリエラ",
            "text": "…もう、日記は部屋以外で\n書かないようにしよう。",
            "zh": "…以后再也不在房间\n以外的地方写日记了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "206/ACT",
            "narrator": "",
            "text": "とりあえず頷いておこう",
            "zh": "先点点头蒙混过去吧",
            "narrator_zh": ""
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "だ、大丈夫なのかしら？\nそんなことしちゃって…。",
            "zh": "真、真的没问题吗？\n干出这种事…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、中身を見られた\nみたいだし、そう誤魔化す\nしかないわよね？",
            "zh": "不过，看样子内容也\n没被看到，只能顺着\n这么糊弄过去了是吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "…わ、わかったわ。\n完成したら見せてあげる。",
            "zh": "…我、我知道了。\n等写完就给你看吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "222/TALK",
            "narrator": "神楽",
            "text": "やった、楽しみです！",
            "zh": "太好了，好期待！",
            "narrator_zh": "神乐"
        },
        {
            "location": "223/TALK",
            "narrator": "神楽",
            "text": "完成、楽しみに\n待ってますね。",
            "zh": "那我就期待着\n完成的那一天咯。",
            "narrator_zh": "神乐"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、それより！\nほら、お茶煎れてくれるん\nじゃないの？",
            "zh": "比、比起那个！\n喂，你不是要去\n泡茶吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/TALK",
            "narrator": "神楽",
            "text": "あ、そうでした！",
            "zh": "啊，对哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "230/TALK",
            "narrator": "ガブリエラ",
            "text": "…ど、どうしよう。",
            "zh": "…怎、怎么办。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナ！",
            "zh": "玛尔赞娜！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/TALK",
            "narrator": "ガブリエラ",
            "text": "あなたの言う通りにしたけど、本当にこれで良かったの？",
            "zh": "虽然按你说的做了，但这样真的没问题吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽、完成するのを待ってるとか言ってたし…",
            "zh": "神乐还说在等着我写完呢…",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "246/SEL",
            "narrator": "",
            "text": "ああいう言葉は大抵お世辞",
            "zh": "那种话多半只是客套",
            "narrator_zh": ""
        },
        {
            "location": "247/SEL",
            "narrator": "",
            "text": "これを機に書いてみれば？",
            "zh": "趁这机会试试写一下呗？",
            "narrator_zh": ""
        },
        {
            "location": "248/ACT",
            "narrator": "",
            "text": "ああいう言葉は大抵お世辞",
            "zh": "那种话多半只是客套",
            "narrator_zh": ""
        },
        {
            "location": "250/TALK",
            "narrator": "ガブリエラ",
            "text": "…そっか",
            "zh": "…这样啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "251/TALK",
            "narrator": "ガブリエラ",
            "text": "言われてみると、確かにそうよね？",
            "zh": "听你这么一说，确实是这样呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう、マルザンナ",
            "zh": "谢谢你，玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "264/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね…普段から\nラノベばかり読んでる\n神楽が――",
            "zh": "也是嘛…平时整天\n都在看轻小说的\n神乐——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "素人のあたしが書いた\n小説を、本気で読みたい\nなんて思うわけないわ。",
            "zh": "怎么可能真的想看\n我这个外行写的\n小说呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "慌てて損したわ、\nまったく…。",
            "zh": "害我白慌了一场，\n真是的…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "269/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、もう部屋以外で\n日記書くのはやめよう。",
            "zh": "…不过，以后还是别在\n房间以外的地方写日记了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/ACT",
            "narrator": "",
            "text": "これを機に書いてみれば？",
            "zh": "趁这机会试试写一下呗？",
            "narrator_zh": ""
        },
        {
            "location": "271/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは読む専門だから、書く気はないわ",
            "zh": "我可是专门负责看的，才没打算自己写",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "272/TALK",
            "narrator": "ガブリエラ",
            "text": "楽しそうだとは思うけど、自分の書いたものを読まれるのって、恥ずかしいし",
            "zh": "虽然觉得应该挺有意思，但自己写的东西被别人看太羞耻了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "273/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、マルザンナにだけなら見せてもいいかな？",
            "zh": "不过，要是只给玛尔赞娜看的话，倒也不是不行？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "284/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ…。",
            "zh": "呵呵…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "285/TALK",
            "narrator": "ガブリエラ",
            "text": "って、しまった…。\n神楽のことどうするか、\n結局相談してないじゃん！",
            "zh": "不对，糟了…。\n神乐那边的事到底怎么办，\n结果完全没商量到嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "286/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "288/TALK",
            "narrator": "ガブリエラ",
            "text": "ずっと、まだ書き途中、\nってことにしよう。",
            "zh": "就一直说还在连载中，\n还没写完算了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "15/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月29日　5:20 PM</color>\n5月も半ばを過ぎた頃、神楽坂トライナリーのバイト中。",
            "zh": "<color=green>6月29日　5:20 PM</color>\n5月中旬过后，在神乐坂三重奏打工时。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
