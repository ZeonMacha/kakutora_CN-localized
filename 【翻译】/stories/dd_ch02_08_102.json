{
    "dir": "chap08/daydra/dd_ch02_08_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "8205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "先輩会議＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "前辈会议＜后篇＞"
    },
    "entry": [
        {
            "location": "333/SCENARIO",
            "narrator": "",
            "text": "先輩会議",
            "zh": "前辈会议",
            "narrator_zh": ""
        },
        {
            "location": "362/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "363/TALK",
            "narrator": "アーヤ",
            "text": "まあ、まだ入隊した\nばかりなんだから――",
            "zh": "嘛，毕竟才刚\n入队不久——",
            "narrator_zh": "绫水"
        },
        {
            "location": "364/TALK",
            "narrator": "アーヤ",
            "text": "わからないのは\n当然よね。",
            "zh": "不了解也是\n理所当然的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "365/TALK",
            "narrator": "アーヤ",
            "text": "一人で悩んでても\n仕方ないし――",
            "zh": "一个人烦恼也\n于事无补——",
            "narrator_zh": "绫水"
        },
        {
            "location": "366/TALK",
            "narrator": "アーヤ",
            "text": "いい機会だし、\n二人にも聞いて\nみよう。",
            "zh": "趁这个机会，\n也问问她们\n两个吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "367/TALK",
            "narrator": "アーヤ",
            "text": "…お待たせ。",
            "zh": "……久等了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "369/TALK",
            "narrator": "ガブリエラ",
            "text": "で？　お姉さんから\n返事あった？",
            "zh": "所以？你姐姐\n回消息了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "370/TALK",
            "narrator": "アーヤ",
            "text": "う、ううん。\n返事なしよ。",
            "zh": "没、没有。\n没有回复哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "373/TALK",
            "narrator": "みやび",
            "text": "…その割には、\n結構長くポチポチ\nしちょったね？",
            "zh": "……话虽如此，\n你刚才可戳屏幕\n戳了好久咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "374/TALK",
            "narrator": "アーヤ",
            "text": "き、既読付かないかと\n思って、色々送って\nたのよ。",
            "zh": "我、我想着会不会\n显示已读，就多发了\n几条嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "375/TALK",
            "narrator": "アーヤ",
            "text": "まあ、無駄に終わった\nけどね…。",
            "zh": "不过，最后还是\n白费工夫就是了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "376/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "377/TALK",
            "narrator": "アーヤ",
            "text": "そ、それより！！",
            "zh": "那、先不说这个！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "379/TALK",
            "narrator": "アーヤ",
            "text": "二人とも、卯月のこと\nどう思った？",
            "zh": "你们俩，觉得\n卯月怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "382/TALK",
            "narrator": "ガブリエラ",
            "text": "どうって…適応力は\n高そうだし、即戦力\nにはなりそうよね。",
            "zh": "怎么说呢……适应力\n挺强的，应该能\n很快派上用场吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "383/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、それくらいで\nあとは普通でしょ。",
            "zh": "嘛，也就这样，\n其他方面挺普通的吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "386/TALK",
            "narrator": "アーヤ",
            "text": "それこそ普通じゃ\nないと思うわ。",
            "zh": "我倒觉得那恰恰\n很不普通。",
            "narrator_zh": "绫水"
        },
        {
            "location": "387/TALK",
            "narrator": "アーヤ",
            "text": "初陣で、あれだけの\n動きをしたのよ？",
            "zh": "第一次上阵，就能\n发挥出那种水准哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "388/TALK",
            "narrator": "アーヤ",
            "text": "コネクトしても、\n状況判断能力までは\n上がらないのに…。",
            "zh": "就算进行了连接，\n情况判断能力也不会\n跟着提升的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "389/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの銃と同じで、\n入隊前から訓練して\nたんじゃないの？",
            "zh": "跟我的枪一样，\n入队前就已经\n训练过了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "392/TALK",
            "narrator": "みやび",
            "text": "それはないやろ。\n日本はラブ＆ピースの\n国やぞ？",
            "zh": "这不可能吧。\n日本可是Love&Peace的\n国家啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "394/TALK",
            "narrator": "みやび",
            "text": "…いや、今の日本は\nラブ＆フェノメノン\nやったか。",
            "zh": "……不对，现在的日本\n是Love&PhenoMENON\n来着？",
            "narrator_zh": "雅"
        },
        {
            "location": "397/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、本当に\n才能だけで、あれだけ\n動けた、ってこと？",
            "zh": "那岂不是说，她真的\n光凭天赋，就能\n有那种表现了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "398/TALK",
            "narrator": "アーヤ",
            "text": "…だけ、ってことは\nないと思うけど…。",
            "zh": "……应该不至于\n“光凭”那个吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "400/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、卯月は\n汗臭いこととは\n無縁そうな――",
            "zh": "话说回来，卯月\n看起来就跟浑身汗臭\n无缘——",
            "narrator_zh": "雅"
        },
        {
            "location": "402/TALK",
            "narrator": "みやび",
            "text": "ゴージャスな香りが\nぷんぷんすると\n思わん？",
            "zh": "你不觉得她浑身都\n散发着一股华贵的\n气息吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "405/TALK",
            "narrator": "アーヤ",
            "text": "あ、わかるわかる。\n確かにそんな感じ\nするかも。",
            "zh": "啊，懂的懂的。\n确实有点那种\n感觉。",
            "narrator_zh": "绫水"
        },
        {
            "location": "407/TALK",
            "narrator": "みやび",
            "text": "名探偵みやびさんの\n推理では――",
            "zh": "按照名侦探雅\n的推理——",
            "narrator_zh": "雅"
        },
        {
            "location": "409/TALK",
            "narrator": "みやび",
            "text": "卯月は中々えいとこの\nお嬢様やと思うがよ。",
            "zh": "我觉得卯月八成是\n相当了不得人家的大小姐咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "410/TALK",
            "narrator": "みやび",
            "text": "喋り方や仕草の\n端々に――",
            "zh": "言谈举止的\n细节里——",
            "narrator_zh": "雅"
        },
        {
            "location": "411/TALK",
            "narrator": "みやび",
            "text": "うちら庶民とは違う\nオーラを感じるがよ。",
            "zh": "能感觉到跟我们庶民\n不一样的气场咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "414/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん…あたしは\nキャラ作りだと\n思ったけど？",
            "zh": "哼……我倒觉得\n那只是在立人设\n吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "416/TALK",
            "narrator": "みやび",
            "text": "まあ、ハズレちょる\nかもしれんけんどね。",
            "zh": "嘛，说不定是\n猜偏了也讲不定咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "418/TALK",
            "narrator": "アーヤ",
            "text": "信じるわよ。\nみやびのそういう直感\nって、大抵当たるし。",
            "zh": "我相信哦。\n雅的这种直觉，\n十有八九都挺准的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "420/TALK",
            "narrator": "みやび",
            "text": "相手の見えない電脳\n空間で、何年も鍛えて\nきた観察能力や。",
            "zh": "这可是在看不见对手的\n电脑空间里，锻炼了\n好几年的观察力咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "424/TALK",
            "narrator": "ガブリエラ",
            "text": "それ聞くと、ネット\nサーフィンもバカに\nできないわね…。",
            "zh": "听你这么一说，\n网上冲浪也不能\n小瞧了呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "426/TALK",
            "narrator": "みやび",
            "text": "けんど、あいつの\n性格的な部分は、\nうちにもわからん。",
            "zh": "不过，那家伙\n性格方面的底细，\n我也搞不懂。",
            "narrator_zh": "雅"
        },
        {
            "location": "427/TALK",
            "narrator": "ガブリエラ",
            "text": "どじっこ天然娘？",
            "zh": "冒失天然系女孩？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "429/TALK",
            "narrator": "みやび",
            "text": "けんど、正念場での\n機転の利かせ方は――",
            "zh": "不过，在紧要关头\n随机应变的本事——",
            "narrator_zh": "雅"
        },
        {
            "location": "431/TALK",
            "narrator": "みやび",
            "text": "ビックリするほど\nシャープやったし。",
            "zh": "犀利得\n让人吃惊啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "434/TALK",
            "narrator": "ガブリエラ",
            "text": "つまり、よくわから\nない、ってことね？",
            "zh": "也就是说，完全\n摸不透，对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "436/TALK",
            "narrator": "みやび",
            "text": "卯月についての\n情報が、あまりにも\n少な過ぎるんよ。",
            "zh": "关于卯月的\n情报，实在\n太少咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "438/TALK",
            "narrator": "みやび",
            "text": "例えば、卯月の入隊\nした経緯についてや\nけんど――。",
            "zh": "比如说，卯月\n入队的经过\n嘛——。",
            "narrator_zh": "雅"
        },
        {
            "location": "440/TALK",
            "narrator": "みやび",
            "text": "誰か、まほさんから\n聞いたか？",
            "zh": "你们谁听真幌\n提起过吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "442/TALK",
            "narrator": "アーヤ",
            "text": "そういえば、\n何も説明が\nなかったわ。",
            "zh": "说起来，\n完全没有任何\n说明呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "445/TALK",
            "narrator": "ガブリエラ",
            "text": "あの新人みたいに、\n偶然見つかったんじゃ\nないの？",
            "zh": "难道不是像那个新人\n一样，偶然被\n发现的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "447/TALK",
            "narrator": "みやび",
            "text": "…まあ、今のところ\n偶然発見率が優勢\nやきね。",
            "zh": "……嘛，目前来看\n偶然发现率占上风\n嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "449/TALK",
            "narrator": "みやび",
            "text": "アーヤも、偶然\nフェノメノンに巻き\n込まれたけんど――",
            "zh": "绫水也是，虽然是\n偶然被卷进\nPhenoMENON的——",
            "narrator_zh": "雅"
        },
        {
            "location": "450/TALK",
            "narrator": "みやび",
            "text": "正気の状態で、たった\n一人で初収束をさせた\nのがきっかけやし。",
            "zh": "因为你在神智清醒下，\n独自一人完成了\n首次收敛才入队的。",
            "narrator_zh": "雅"
        },
        {
            "location": "452/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィは正式な\n招集だったのよね？",
            "zh": "加维则是正式\n征召的对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "454/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、トライガジェッ\nトを持ってたから――",
            "zh": "嗯，因为我持有\nTri-Gadget——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "455/TALK",
            "narrator": "ガブリエラ",
            "text": "管理庁から正式に\n招集されたのよ。",
            "zh": "才被管理厅正式\n征召进来的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "457/TALK",
            "narrator": "みやび",
            "text": "うちは志願入隊で、\nつばめちゃんは\n偶然発見された、と。",
            "zh": "我是志愿入队，\n燕则是\n偶然被发现的。",
            "narrator_zh": "雅"
        },
        {
            "location": "459/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしみたいに、\nどこかから発掘して\nきたんじゃないの？",
            "zh": "会不会像我一样，\n是从哪里发掘\n过来的？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "460/TALK",
            "narrator": "アーヤ",
            "text": "でも、ギャヴィの時は\n館長から事前に話を\n聞いてたわ。",
            "zh": "可是，加维那时候\n馆长事先有跟我们\n打过招呼。",
            "narrator_zh": "绫水"
        },
        {
            "location": "462/TALK",
            "narrator": "ガブリエラ",
            "text": "人数も増えたし、\n一々言うのも\n面倒だったんじゃない？",
            "zh": "人也变多了，\n一个个交代\n嫌麻烦了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "464/TALK",
            "narrator": "みやび",
            "text": "…まあ、ありえん話\nでもないな。",
            "zh": "……嘛，也不是\n没这个可能。",
            "narrator_zh": "雅"
        },
        {
            "location": "466/TALK",
            "narrator": "みやび",
            "text": "入隊経緯なんぞ、\nぶっちゃけ聞いても\n何にもならんし。",
            "zh": "入队经过什么的，\n老实说打听了\n也没得用。",
            "narrator_zh": "雅"
        },
        {
            "location": "468/TALK",
            "narrator": "ガブリエラ",
            "text": "何にせよ、あの二人は\n揃って謎と裏があり\nそう、ってことね…。",
            "zh": "不管怎样，那两个人\n都一副满身谜团又藏着\n隐情的样子呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "471/TALK",
            "narrator": "みやび",
            "text": "そうやね。",
            "zh": "是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "473/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんの、\nあの謎の力とかの\nこともあるし…。",
            "zh": "而且还有燕\n那股神秘力量的\n事……。",
            "narrator_zh": "雅"
        },
        {
            "location": "475/TALK",
            "narrator": "アーヤ",
            "text": "…疑うのは\n嫌だけど――",
            "zh": "……虽然讨厌\n去怀疑同伴——",
            "narrator_zh": "绫水"
        },
        {
            "location": "476/TALK",
            "narrator": "アーヤ",
            "text": "三人態勢の時と\n同じようには\nいかなそうね…。",
            "zh": "看来没法像\n三人体制时那样\n相处了呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "478/TALK",
            "narrator": "みやび",
            "text": "まあ、ネガティブな\n方向に考えても\nしゃあない。",
            "zh": "嘛，往消极的\n方向去想也\n没用。",
            "narrator_zh": "雅"
        },
        {
            "location": "479/TALK",
            "narrator": "みやび",
            "text": "期待の新人卯月と、\n不死身人間の\nつばめちゃん。",
            "zh": "备受期待的新人卯月，\n还有不死之身的\n燕。",
            "narrator_zh": "雅"
        },
        {
            "location": "481/TALK",
            "narrator": "みやび",
            "text": "うちらの考えが杞憂\nやったら、二人は\nうちら以上に強い――",
            "zh": "要是我们的担心只是\n杞人忧天，那她俩就会\n成为比我们还强的——",
            "narrator_zh": "雅"
        },
        {
            "location": "483/TALK",
            "narrator": "みやび",
            "text": "スーパートライナリー\nになって大活躍して\nくれるやろうし。",
            "zh": "超级三重奏\n大显身手\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "485/TALK",
            "narrator": "ガブリエラ",
            "text": "…それはそれで、\n面白くないわ。",
            "zh": "……那样一来，\n我可不甘心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "487/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\n疑いが晴れるのは\nいいことだけど――",
            "zh": "是啊。\n疑虑消除虽然\n是好事——",
            "narrator_zh": "绫水"
        },
        {
            "location": "488/TALK",
            "narrator": "アーヤ",
            "text": "私たち、先輩としての\n立場がなくなっちゃう\nものね。",
            "zh": "我们作为前辈的\n颜面可就没地方\n搁了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "489/TALK",
            "narrator": "みやび",
            "text": "まあ、ラクさせて\nもらえるんは\nありがたいけんど――",
            "zh": "嘛，能让我\n轻松点倒是\n求之不得不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "490/TALK",
            "narrator": "みやび",
            "text": "パワーインフレで\n戦力外っちゅうのは、\n面白くないな…。",
            "zh": "因为战力膨胀\n被踢出主力，那可\n不好玩咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "491/TALK",
            "narrator": "アーヤ",
            "text": "あの子達に全部持って\nいかれないように、\n私達も頑張りましょ。",
            "zh": "为了不被她们把风头\n全抢走，\n我们也要加油才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "493/TALK",
            "narrator": "ガブリエラ",
            "text": "…悔しいけど、\n賛成よ。",
            "zh": "……虽然不甘心，\n但同意。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "494/TALK",
            "narrator": "ガブリエラ",
            "text": "あんなわけのわから\nない後輩に、負けて\nいられないわ！",
            "zh": "才不能输给那种\n莫名其妙的\n后辈啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "506/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【06 史上最愛の作戦】",
            "zh": "【06 史上最爱的作战】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
