            "text": "030_文学の海背川腹",
            "zh": "030_文学的海背川腹",
            "narrator_zh": ""
        },
        {
            "location": "185/TALK",
            "narrator": "みやび",
            "text": "何故に人は海ではしゃぐのだろう",
            "zh": "为什么人一到海边就闹腾",
            "narrator_zh": "雅"
        },
        {
            "location": "187/SEL",
            "narrator": "",
            "text": "水着のせいかな",
            "zh": "是因为泳装吗",
            "narrator_zh": ""
        },
        {
            "location": "188/SEL",
            "narrator": "",
            "text": "気分？",
            "zh": "心情？",
            "narrator_zh": ""
        },
        {
            "location": "189/SEL",
            "narrator": "",
            "text": "恋人同士っぽい気持ちになるから",
            "zh": "因为会变得像恋人一样",
            "narrator_zh": ""
        },
        {
            "location": "190/ACT",
            "narrator": "",
            "text": "水着のせいかな",
            "zh": "是因为泳装吗",
            "narrator_zh": ""
        },
        {
            "location": "191/TALK",
            "narrator": "みやび",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "雅"
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "では水着ではない時は？",
            "zh": "那么不是泳装的时候呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "193/ACT",
            "narrator": "",
            "text": "気分？",
            "zh": "心情？",
            "narrator_zh": ""
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "その気分はなぜかと問うておる",
            "zh": "我问的是那心情为什么来",
            "narrator_zh": "雅"
        },
        {
            "location": "197/ACT",
            "narrator": "",
            "text": "恋人同士っぽい気持ちになるから",
            "zh": "因为会变得像恋人一样",
            "narrator_zh": ""
        },
        {
            "location": "199/TALK",
            "narrator": "みやび",
            "text": "それだ",
            "zh": "就是这个",
            "narrator_zh": "雅"
        },
        {
            "location": "200/TALK",
            "narrator": "みやび",
            "text": "つまり都市伝説を目の当たりにしてはしゃぐということだな",
            "zh": "也就是说，是亲眼看见都市传说才闹腾的啊",
            "narrator_zh": "雅"
        },
        {
            "location": "201/TALK",
            "narrator": "みやび",
            "text": "理解した",
            "zh": "我理解了",
            "narrator_zh": "雅"
        },
        {
            "location": "204/SEL",
            "narrator": "",
            "text": "海嫌い？",
            "zh": "讨厌海？",
            "narrator_zh": ""
        },
        {
            "location": "205/SEL",
            "narrator": "",
            "text": "海っていいよね",
            "zh": "海很好吧",
            "narrator_zh": ""
        },
        {
            "location": "206/SEL",
            "narrator": "",
            "text": "$me$もみやびと海に行きたい",
            "zh": "$me$也想和雅去海边",
            "narrator_zh": ""
        },
        {
            "location": "207/ACT",
            "narrator": "",
            "text": "海嫌い？",
            "zh": "讨厌海？",
            "narrator_zh": ""
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "嫌いではない",
            "zh": "并不讨厌",
            "narrator_zh": "雅"
        },
        {
            "location": "209/TALK",
            "narrator": "みやび",
            "text": "ただ三崎の海は",
            "zh": "只是三崎的海",
            "narrator_zh": "雅"
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "土佐の海と違うぞね",
            "zh": "和土佐的海不一样咧",
            "narrator_zh": "雅"
        },
        {
            "location": "211/TALK",
            "narrator": "みやび",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "雅"
        },
        {
            "location": "212/TALK",
            "narrator": "みやび",
            "text": "海は海だが違う気がするだけぞね",
            "zh": "海是海，只是感觉不一样咧",
            "narrator_zh": "雅"
        },
        {
            "location": "213/ACT",
            "narrator": "",
            "text": "海っていいよね",
            "zh": "海很好吧",
            "narrator_zh": ""
        },
        {
            "location": "214/TALK",
            "narrator": "みやび",
            "text": "いいな",
            "zh": "是好",
            "narrator_zh": "雅"
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "しかしだからといって闇雲にはしゃげばいいちうもんでもなかろ",
            "zh": "但是也不能因此就瞎闹腾吧",
            "narrator_zh": "雅"
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "そういうことぞね",
            "zh": "就是这么回事咧",
            "narrator_zh": "雅"
        },
        {
            "location": "217/ACT",
            "narrator": "",
            "text": "$me$もみやびと海に行きたい",
            "zh": "$me$也想和雅去海边",
            "narrator_zh": ""
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "行っとろう",
            "zh": "去就是了",
            "narrator_zh": "雅"
        },
        {
            "location": "220/TALK",
            "narrator": "みやび",
            "text": "スマホ越しで",
            "zh": "隔着手机",
            "narrator_zh": "雅"
        },
        {
            "location": "221/TALK",
            "narrator": "みやび",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "雅"
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "こっちに来るのはやぶさかではない",
            "zh": "你到这边来，我也不拒绝",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "たまには来てみ",
            "zh": "偶尔来看看",
            "narrator_zh": "雅"
        }
    ]
