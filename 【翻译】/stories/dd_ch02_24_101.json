{
    "dir": "chap24/daydra/dd_ch02_24_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "24202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "貴方を憂う手紙＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "为你担忧的信＜前篇＞"
    },
    "entry": [
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "あーあ、\n午後からむぎまるで\n話し合いかぁ…。",
            "zh": "唉——，\n下午还要去麦丸\n开会讨论啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "気が乗らなそうね。",
            "zh": "看起来兴致不高呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "そりゃそうでしょ。",
            "zh": "那不是废话吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽が裏切っただけなら\nともかく、管理庁まで\n関わってたんだから。",
            "zh": "要是只有神乐背叛\n倒也罢了，连管理厅都\n牵扯进来了啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "正直、話し合って\nどうにかなるレベルの\nことじゃないわよ。",
            "zh": "说实话，这事根本不是\n坐下来谈谈就能\n解决的级别好吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "アーヤ",
            "text": "別に、今後の対策を\n練るだけが目的じゃ\nないわ。",
            "zh": "我也没说目的\n只是为了商量\n今后的对策。",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "アーヤ",
            "text": "話し合って、お互いの\n気持ちを確かめるのも\n大切なことよ。",
            "zh": "好好谈一谈，确认彼此\n的想法也是\n很重要的事哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "気持ちねぇ…。",
            "zh": "想法啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "ええ…ギャヴィは\n卯月の裏切りを\n許せないと思ってる？",
            "zh": "嗯……加维你觉得\n卯月的背叛\n不可原谅吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "当然でしょ？",
            "zh": "那还用问？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "アーヤ",
            "text": "うん、そうよね。\n私もギャヴィと\n同じ気持ちよ。",
            "zh": "嗯，也是呢。\n我的想法也和\n加维一样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/TALK",
            "narrator": "アーヤ",
            "text": "…でも、つばめなら\nどう答えるかしら？",
            "zh": "……不过，换作燕的话\n会怎么回答呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "46/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "多分、許せない、\nなんて思わないんじゃ\nないかしら？",
            "zh": "大概，她不会觉得\n“不可原谅”\n吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "…だと思うわ。",
            "zh": "……我觉得也是。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "天然でお人好しで、\nバカみたいに人のこと\n信じちゃうし。",
            "zh": "她天然又老好人，\n傻乎乎地就会\n去相信别人。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "ガブリエラ",
            "text": "しかも、神楽とは\n一番仲もよかったでしょ？",
            "zh": "而且，她和神乐\n关系本来也是最好的不是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、敵として\n見るなんて、絶対に\nできないと思うわ。",
            "zh": "所以让她把神乐当成\n敌人来看待，她绝对\n做不到吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "てか、下手したら\n庇ったりするわよ？",
            "zh": "甚至弄不好，\n她还会护着神乐哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "アーヤ",
            "text": "…そうね。",
            "zh": "……是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "私、つばめのそういう\nところって、嫌いじゃ\nないの。",
            "zh": "我其实\n并不讨厌燕的\n这一点。",
            "narrator_zh": "绫水"
        },
        {
            "location": "57/TALK",
            "narrator": "アーヤ",
            "text": "どんな相手にも\n優しくできるのって、\n凄いことだと思うし。",
            "zh": "能对任何人都\n保持温柔，我觉得是件\n很了不起的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "悪いとことでも\nあると思うけど？",
            "zh": "但这也是她的\n缺点就是了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "59/TALK",
            "narrator": "アーヤ",
            "text": "…わかってる。",
            "zh": "……我知道。",
            "narrator_zh": "绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "アーヤ",
            "text": "でも、もし今つばめが\nそんな気持ちでいると\nしたら、それは問題よ。",
            "zh": "不过，如果现在的燕\n还抱着那种想法，\n那就有问题了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "下手をすれば、\n全滅の危機にも\nなりかねないんだし…。",
            "zh": "搞不好，甚至可能\n引发全军覆没的\n危机……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "アーヤ",
            "text": "だから、話し合いでは\nそのことをきっちりと\n言い聞かせたいの。",
            "zh": "所以，我想在这次\n谈话里把这件事\n清清楚楚地跟她讲明。",
            "narrator_zh": "绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめに理解して\nもらうため？",
            "zh": "为了让燕\n理解现状？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "そういうことよ。",
            "zh": "就是这样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "…聞く耳持たないと\n思うけど？",
            "zh": "……我觉得她\n不会听进去的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "アーヤ",
            "text": "だからって無視は\nできないでしょ？",
            "zh": "就算这样也不能\n放着不管吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "あの子が卯月のことを\n大切に思ってるのは\nわかってる。",
            "zh": "我知道\n那孩子很看重\n卯月。",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "アーヤ",
            "text": "でも、卯月が今現在\n敵だってことも\n事実よ。",
            "zh": "但卯月现在是\n我们的敌人，这也是\n不争的事实。",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "アーヤ",
            "text": "そんな相手のために、\n私たちは全滅する\nリスクを抱えられない。",
            "zh": "为了那样的对手，\n我们不能背负\n全灭的风险。",
            "narrator_zh": "绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "アーヤ",
            "text": "無条件に\n卯月を信じたりする\nことはできない。",
            "zh": "我们不可能\n无条件地去\n相信卯月。",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "アーヤ",
            "text": "それは、しっかりと\nつばめに伝えないと\nいけないことよ。",
            "zh": "这件事，必须\n认认真真地传达给\n燕才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "…聞き入れてくれる\nとは思えないけど？",
            "zh": "……我不觉得她会\n乖乖听话就是了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "アーヤ",
            "text": "全部は無理でしょうね。",
            "zh": "要她全盘接受是不可能的吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "でも、それを伝えておく\nだけでも違うと思うわ。",
            "zh": "不过，哪怕只是把话\n挑明放在这儿，结果也会不一样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/TALK",
            "narrator": "アーヤ",
            "text": "どう思う？",
            "zh": "你怎么看？",
            "narrator_zh": "绫水"
        },
        {
            "location": "81/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、何もしないで\n全滅なんてのは\n嫌だしね。",
            "zh": "……算了，什么都不做\n最后全军覆没的话\n我也受不了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "やれるだけのことは\nやっておく、っていうのは\n賛成よ。",
            "zh": "把能做的事都做到位，\n这一点我\n赞成。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "…よかった。",
            "zh": "……太好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、無理だと思う\nって気持ちに\n変わりないけど。",
            "zh": "不过，我觉得行不通\n这个想法还是\n没变就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "わかってる。\n一緒に説得してくれる\nだけで十分よ。",
            "zh": "我知道。\n你肯一起帮忙劝她\n就足够了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…面倒だなぁ…。",
            "zh": "唉……好麻烦啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱり、\nまほが帰ってくるの\n待った方がよくない？",
            "zh": "……说起来，\n还是等真幌回来再谈\n不是更好吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "え？　なによ。\nまさかまだ連絡が\n来ないの？",
            "zh": "哎？　什么嘛。\n难道她到现在都还没\n联系你们吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "うん…電話かけても、\nすぐに留守電に\nなっちゃって…。",
            "zh": "嗯……打电话过去，\n也总是直接转入\n语音信箱……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "…まさかだけど。",
            "zh": "……不会吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "管理庁の話に行って、\nそのまま捕まった…、\nとか？",
            "zh": "去管理厅谈事，\n结果直接被扣下来了……\n之类的？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "アーヤ",
            "text": "…わからないけど、\n可能性ゼロとは\n言えないわよね。",
            "zh": "……虽然还不清楚，\n但可能性也不能说\n是零呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "95/TALK",
            "narrator": "アーヤ",
            "text": "管理庁は、神楽と\n繋がってるわけだし。",
            "zh": "毕竟管理厅，和神乐\n是一伙的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "97/TALK",
            "narrator": "アーヤ",
            "text": "…そういえば、\nこの前飲みに行った\n時に――",
            "zh": "……说起来，\n上次一起去喝酒的\n时候——",
            "narrator_zh": "绫水"
        },
        {
            "location": "115/TALK",
            "narrator": "真幌",
            "text": "私は思っているんだ。",
            "zh": "我心里有数。",
            "narrator_zh": "真幌"
        },
        {
            "location": "116/TALK",
            "narrator": "真幌",
            "text": "…私も、そう長くは\nないかもしれん。",
            "zh": "……我啊，说不定也\n活不了太久了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "…え？",
            "zh": "……哎？",
            "narrator_zh": "绫水"
        },
        {
            "location": "118/TALK",
            "narrator": "真幌",
            "text": "私に何かあったら、\nトライナリーや\n劇場を仕切れ。",
            "zh": "要是我出了什么事，\n三重奏和剧场就由你来\n掌管。",
            "narrator_zh": "真幌"
        },
        {
            "location": "119/TALK",
            "narrator": "真幌",
            "text": "おまえに\n任せたぞ。",
            "zh": "就交给你\n了啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "141/TALK",
            "narrator": "アーヤ",
            "text": "…まさか館長、\nこうなることを\n予想してたの？",
            "zh": "……难道馆长，\n早就预料到会变成\n这样了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "144/TALK",
            "narrator": "アーヤ",
            "text": "館長がいない間、\nギャヴィ達を護るのが\n私の仕事だもの。",
            "zh": "馆长不在的这段时间，\n保护好加维她们就是\n我的职责。",
            "narrator_zh": "绫水"
        },
        {
            "location": "145/TALK",
            "narrator": "アーヤ",
            "text": "館長だって、\nそう望んでいるはず。",
            "zh": "馆长肯定，\n也是这么希望的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "146/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "147/TALK",
            "narrator": "アーヤ",
            "text": "でも…館長のことは\n気になるわ。",
            "zh": "不过……馆长的事\n还是让人放心不下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "148/TALK",
            "narrator": "アーヤ",
            "text": "…管理庁に行ってみるべき\nなのかしら？",
            "zh": "……是不是该去趟\n管理厅看看呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "196/TALK",
            "narrator": "千羽鶴",
            "text": "　",
            "zh": "　",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "239/TALK",
            "narrator": "千羽鶴",
            "text": "ようこそ、\n國政綾水の\nココロスフィアへ。",
            "zh": "欢迎来到\n国政绫水的\n心灵领域。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "242/TALK",
            "narrator": "千羽鶴",
            "text": "國政綾水の\nココロゲートでも\n話をしたけども――",
            "zh": "我在国政绫水的\n心之扉里也\n说过了——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "244/TALK",
            "narrator": "千羽鶴",
            "text": "ガブリエラの\nココロゲートでも\n話をしたけども――",
            "zh": "我在加布里埃拉的\n心之扉里也\n说过了——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "246/TALK",
            "narrator": "千羽鶴",
            "text": "恋ヶ崎みやびの\nココロゲートでも\n話をしたけども――",
            "zh": "我在恋之崎雅的\n心之扉里也\n说过了——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "248/TALK",
            "narrator": "千羽鶴",
            "text": "次回から、\n彼女たちの心のメンテは\n私が直接やることにする。",
            "zh": "从下次开始，\n她们内心的维护就由\n我来亲自负责。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "249/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\n今回だけはクランの\n消去を手伝って欲しい。",
            "zh": "所以，\n就这一次，希望你能\n帮忙消除库兰。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "251/SEL",
            "narrator": "",
            "text": "なんで千羽鶴が！？",
            "zh": "为什么是千羽鹤！？",
            "narrator_zh": ""
        },
        {
            "location": "252/ACT",
            "narrator": "",
            "text": "なんで千羽鶴が！？",
            "zh": "为什么是千羽鹤！？",
            "narrator_zh": ""
        },
        {
            "location": "254/TALK",
            "narrator": "千羽鶴",
            "text": "前回のメンテナンスで\n権限拡大をしたから。",
            "zh": "因为在上次的维护里\n扩大了权限。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "255/TALK",
            "narrator": "千羽鶴",
            "text": "これからは、\n私が直接ココロゲートを\n管理することにする。",
            "zh": "今后，\n就由我直接来管理\n心之扉。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "256/SEL",
            "narrator": "",
            "text": "なにそれすごい",
            "zh": "那是什么好厉害",
            "narrator_zh": ""
        },
        {
            "location": "257/SEL",
            "narrator": "",
            "text": "なにそれやばい",
            "zh": "那是什么好不妙",
            "narrator_zh": ""
        },
        {
            "location": "258/ACT",
            "narrator": "",
            "text": "なにそれすごい",
            "zh": "那是什么好厉害",
            "narrator_zh": ""
        },
        {
            "location": "259/TALK",
            "narrator": "千羽鶴",
            "text": "本当は最初から\nこうしておく\nべきだった。",
            "zh": "本来从一开始\n就该这样\n做的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "260/TALK",
            "narrator": "千羽鶴",
            "text": "だから、途中から\n方針転換をして\n準備はしていた。",
            "zh": "所以，我从半途就\n改变了方针，\n一直在做准备。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "261/TALK",
            "narrator": "千羽鶴",
            "text": "けど、OSの機能制限で\nなかなかできず。\nようやく前回実現した。",
            "zh": "但受限于OS的功能，\n一直没能做到。\n直到上次才终于实现。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "262/ACT",
            "narrator": "",
            "text": "なにそれやばい",
            "zh": "那是什么好不妙",
            "narrator_zh": ""
        },
        {
            "location": "263/TALK",
            "narrator": "千羽鶴",
            "text": "やばくなんかない。",
            "zh": "一点都不妙。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "264/TALK",
            "narrator": "千羽鶴",
            "text": "元々の想定では\n私が直接介入する\n予定だったんだから。",
            "zh": "在原本的设想里，\n本来就是预定由我\n直接介入的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "265/TALK",
            "narrator": "千羽鶴",
            "text": "けど、OSの機能制限で\nそれはできなかった。\nだから前回調整した。",
            "zh": "但受限于OS的功能，\n当时没能做到。\n所以上次做了调整。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "267/SEL",
            "narrator": "",
            "text": "でも、チュートリアルでは$me$にしか出来ない役割だと…",
            "zh": "可是，教程里不是说这是只有$me$才能胜任的工作吗……",
            "narrator_zh": ""
        },
        {
            "location": "268/ACT",
            "narrator": "",
            "text": "でも、チュートリアルでは$me$にしか出来ない役割だと…",
            "zh": "可是，教程里不是说这是只有$me$才能胜任的工作吗……",
            "narrator_zh": ""
        },
        {
            "location": "270/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。",
            "zh": "是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "271/SEL",
            "narrator": "",
            "text": "どうして、やろうと思えば自分でできたのに$me$にやらせたの？",
            "zh": "既然你想做的话自己就能做到，为什么还要让$me$来做？",
            "narrator_zh": ""
        },
        {
            "location": "272/ACT",
            "narrator": "",
            "text": "どうして、やろうと思えば自分でできたのに$me$にやらせたの？",
            "zh": "既然你想做的话自己就能做到，为什么还要让$me$来做？",
            "narrator_zh": ""
        },
        {
            "location": "274/TALK",
            "narrator": "千羽鶴",
            "text": "彼女の自由意志によって、\n理想的な世界を創造する\n道程を進んで欲しかった。",
            "zh": "我希望她能凭自己的\n自由意志，走上创造\n理想世界的道路。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "275/TALK",
            "narrator": "千羽鶴",
            "text": "私が介入するということは\n洗脳することと同義。",
            "zh": "由我介入的话，\n就等同于洗脑。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "276/TALK",
            "narrator": "千羽鶴",
            "text": "私は貴方と違い、\n自身だけでクランを\n対処できない。",
            "zh": "我和你不同，\n单凭我自身无法\n应对库兰。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "277/TALK",
            "narrator": "千羽鶴",
            "text": "よって、私にできることは\nクランが出る前に\nココロを固めること――",
            "zh": "因此，我能做的就只有\n在库兰出现之前\n固定住她的心——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "278/TALK",
            "narrator": "千羽鶴",
            "text": "すなわち、\n洗脳することだけ。",
            "zh": "换言之，\n就只有洗脑。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "279/TALK",
            "narrator": "千羽鶴",
            "text": "けど、それは極力\n避けたかった。",
            "zh": "不过，我原本想\n尽量避免这么做。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "280/TALK",
            "narrator": "千羽鶴",
            "text": "だから、クランに介入\nできる貴方にお願いした。",
            "zh": "所以，才拜托了能够\n介入库兰的你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "281/TALK",
            "narrator": "千羽鶴",
            "text": "そうすれば、\n彼女の意志である\nココロの司書と協力し――",
            "zh": "那样的话，\n就能和作为她意志的\n心之司书合作——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "282/TALK",
            "narrator": "千羽鶴",
            "text": "彼女自らの意志として\n理想的な未来を\n歩むことができる。",
            "zh": "让她以自己的意志，\n迈向理想的\n未来。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "283/TALK",
            "narrator": "千羽鶴",
            "text": "誤算だったのは、\n初代ココロの司書たち。",
            "zh": "失算的地方，\n在于初代心之司书们。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "284/SEL",
            "narrator": "",
            "text": "そこを予測して動かなかったのは落ち度じゃない？",
            "zh": "没能预测到这一点并提前行动，难道不是失职吗？",
            "narrator_zh": ""
        },
        {
            "location": "285/SEL",
            "narrator": "",
            "text": "どうして洗脳ではなく、自由意志を重視したの？",
            "zh": "为什么不选择洗脑，而要重视自由意志？",
            "narrator_zh": ""
        },
        {
            "location": "286/ACT",
            "narrator": "",
            "text": "そこを予測して動かなかったのは落ち度じゃない？",
            "zh": "没能预测到这一点并提前行动，难道不是失职吗？",
            "narrator_zh": ""
        },
        {
            "location": "287/TALK",
            "narrator": "千羽鶴",
            "text": "人のココロを、\n全く介入せず予測するのは\n何より難しい計算。",
            "zh": "在不做任何介入的前提下\n预测人心，是世上最难\n计算的难题。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "288/TALK",
            "narrator": "千羽鶴",
            "text": "複数の人間の自由意志を\n保持しつつ、未来を予測\nするのは神業に近い。",
            "zh": "要在保留多个人类\n自由意志的同时预测未来，\n简直接近神迹。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "289/TALK",
            "narrator": "千羽鶴",
            "text": "その為、上手くいかない\n場合の対応策も用意しつつ\n運用を試みている。",
            "zh": "为此，我也准备好了\n进展不顺时的对策，\n一边尝试着运作。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "290/SEL",
            "narrator": "",
            "text": "もしかして、それが新しい司書？",
            "zh": "难道说，那就是新的司书？",
            "narrator_zh": ""
        },
        {
            "location": "291/ACT",
            "narrator": "",
            "text": "もしかして、それが新しい司書？",
            "zh": "难道说，那就是新的司书？",
            "narrator_zh": ""
        },
        {
            "location": "293/TALK",
            "narrator": "千羽鶴",
            "text": "そう。\nそれが第一の対応策。",
            "zh": "是的。\n那就是第一道对策。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "294/TALK",
            "narrator": "千羽鶴",
            "text": "半分だけ彼女の意志を\n残した状態で、もう半分を\n意図的に動かせる存在――",
            "zh": "只保留她一半的意志，\n另一半则由可以刻意\n操控的存在替代——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "295/TALK",
            "narrator": "千羽鶴",
            "text": "半人格による\nココロの制御。",
            "zh": "通过半人格\n来控制内心。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "296/TALK",
            "narrator": "千羽鶴",
            "text": "これは例えるなら\n心臓ペースメーカーに\n近い。",
            "zh": "打个比方的话，\n就接近于\n心脏起搏器。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "297/TALK",
            "narrator": "千羽鶴",
            "text": "免疫力に抵抗されず、\n人工的なシステムによって\n人をサポートする。",
            "zh": "不会遭到免疫力排斥，\n通过人工系统来\n辅助本人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "298/TALK",
            "narrator": "千羽鶴",
            "text": "そして、それでも\n難しいと判断した場合は、\n私が介入する予定だった。",
            "zh": "而即便如此\n还是判断行不通的话，\n就预定由我亲自介入。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "299/TALK",
            "narrator": "千羽鶴",
            "text": "これは完全なる洗脳に\nなるから、代償が伴う。",
            "zh": "这会变成彻头彻尾的\n洗脑，所以伴随代价。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "300/TALK",
            "narrator": "千羽鶴",
            "text": "けど、それを加味しても\nやらねばならないときが\n来たらやるつもりだった。",
            "zh": "不过，就算把代价算进去，\n到了非做不可的时候，\n我也打算去做。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "301/ACT",
            "narrator": "",
            "text": "どうして洗脳ではなく、自由意志を重視したの？",
            "zh": "为什么不选择洗脑，而要重视自由意志？",
            "narrator_zh": ""
        },
        {
            "location": "302/TALK",
            "narrator": "千羽鶴",
            "text": "洗脳による\n未来の創造では\n欠落するものがある。",
            "zh": "靠洗脑来\n创造的未来，\n会有所欠缺。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "303/TALK",
            "narrator": "千羽鶴",
            "text": "極力その欠落を\n抑えつつ未来を\n選択せねばならない。",
            "zh": "必须尽量抑制住\n那种欠缺，再去\n选择未来。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "304/SEL",
            "narrator": "",
            "text": "何が欠落するの？",
            "zh": "会欠缺什么？",
            "narrator_zh": ""
        },
        {
            "location": "305/ACT",
            "narrator": "",
            "text": "何が欠落するの？",
            "zh": "会欠缺什么？",
            "narrator_zh": ""
        },
        {
            "location": "307/TALK",
            "narrator": "千羽鶴",
            "text": "強い意志と精神力。",
            "zh": "强大的意志与精神力。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "309/TALK",
            "narrator": "千羽鶴",
            "text": "いずれにせよ、\n既に私自身が介入する\nことで決定した。",
            "zh": "不管怎样，\n现在已经决定由我\n亲自介入了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "311/TALK",
            "narrator": "千羽鶴",
            "text": "だから、これによって\n貴方は、少しだけ重荷が\nおりることになる。",
            "zh": "因此，借由这件事，\n你肩上的担子也算\n稍微卸下了一点。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "312/TALK",
            "narrator": "千羽鶴",
            "text": "これからは、ココロの中に\n方針を与える必要は\nなくなるから――",
            "zh": "今后你不再需要\n往她的内心里面\n给出方针了——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "313/TALK",
            "narrator": "千羽鶴",
            "text": "思う存分、彼女と\nイチャイチャするだけで\nオッケー！",
            "zh": "只要尽管和她\n尽情腻歪就\nOK！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "314/SEL",
            "narrator": "",
            "text": "やったー！",
            "zh": "太好啦——！",
            "narrator_zh": ""
        },
        {
            "location": "315/SEL",
            "narrator": "",
            "text": "えー",
            "zh": "哎——",
            "narrator_zh": ""
        },
        {
            "location": "316/ACT",
            "narrator": "",
            "text": "やったー！",
            "zh": "太好啦——！",
            "narrator_zh": ""
        },
        {
            "location": "317/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\n次回からはココロゲートに\n来なくてもいい。",
            "zh": "那么，\n从下次起你就不用再来\n心之扉了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "318/ACT",
            "narrator": "",
            "text": "えー",
            "zh": "哎——",
            "narrator_zh": ""
        },
        {
            "location": "319/TALK",
            "narrator": "千羽鶴",
            "text": "意外。",
            "zh": "真意外。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "320/TALK",
            "narrator": "千羽鶴",
            "text": "そこで嫌がられるとは\n思ってもみなかった。",
            "zh": "我还真没想到你会在\n这种地方表现出不情愿。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "321/TALK",
            "narrator": "千羽鶴",
            "text": "ココロゲートと\nクランのデリートは\nかなり負担だったのでは。",
            "zh": "心之扉与\n删除库兰的工作，\n对你来说负担很大吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "322/SEL",
            "narrator": "",
            "text": "まあ、ね…",
            "zh": "算、算是吧……",
            "narrator_zh": ""
        },
        {
            "location": "323/SEL",
            "narrator": "",
            "text": "いや、楽しかった",
            "zh": "不，挺开心的",
            "narrator_zh": ""
        },
        {
            "location": "324/ACT",
            "narrator": "",
            "text": "まあ、ね…",
            "zh": "算、算是吧……",
            "narrator_zh": ""
        },
        {
            "location": "325/TALK",
            "narrator": "千羽鶴",
            "text": "じゃあどうして\nえーなの？",
            "zh": "那为什么\n还要“哎——”？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "326/ACT",
            "narrator": "",
            "text": "いや、楽しかった",
            "zh": "不，挺开心的",
            "narrator_zh": ""
        },
        {
            "location": "327/TALK",
            "narrator": "千羽鶴",
            "text": "そうなのね。\nかわった人。",
            "zh": "是吗。\n真是个怪人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "328/SEL",
            "narrator": "",
            "text": "司書たちとラブラブ中だったし",
            "zh": "而且我正和司书们打得火热呢",
            "narrator_zh": ""
        },
        {
            "location": "329/SEL",
            "narrator": "",
            "text": "バトル出来なくなるの辛い",
            "zh": "不能战斗了很痛苦",
            "narrator_zh": ""
        },
        {
            "location": "330/SEL",
            "narrator": "",
            "text": "お話の核心が見られるから",
            "zh": "因为能看到故事的核心啊",
            "narrator_zh": ""
        },
        {
            "location": "331/SEL",
            "narrator": "",
            "text": "どっちかというと千羽鶴に任せるのが心配",
            "zh": "真要说的话，交给千羽鹤实在让人放心不下",
            "narrator_zh": ""
        },
        {
            "location": "332/ACT",
            "narrator": "",
            "text": "司書たちとラブラブ中だったし",
            "zh": "而且我正和司书们打得火热呢",
            "narrator_zh": ""
        },
        {
            "location": "333/TALK",
            "narrator": "千羽鶴",
            "text": "禁断の恋ね。\n誰とラブラブしたのか\n教えて。",
            "zh": "真是禁忌之恋呀。\n告诉我，你和谁\n打得火热？",
            "narrator_zh": "千羽鹤"
        },
        {
