            "narrator_zh": ""
        },
        {
            "location": "344/ACT",
            "narrator": "",
            "text": "つばめの新司書",
            "zh": "燕的新司书",
            "narrator_zh": ""
        },
        {
            "location": "346/ACT",
            "narrator": "",
            "text": "アーヤの元司書",
            "zh": "绫水的原司书",
            "narrator_zh": ""
        },
        {
            "location": "348/ACT",
            "narrator": "",
            "text": "アーヤの新司書",
            "zh": "绫水的新司书",
            "narrator_zh": ""
        },
        {
            "location": "350/ACT",
            "narrator": "",
            "text": "ガブリエラの司書",
            "zh": "加布里埃拉的司书",
            "narrator_zh": ""
        },
        {
            "location": "352/ACT",
            "narrator": "",
            "text": "みやびの元司書",
            "zh": "雅的原司书",
            "narrator_zh": ""
        },
        {
            "location": "354/ACT",
            "narrator": "",
            "text": "みやびの新司書",
            "zh": "雅的新司书",
            "narrator_zh": ""
        },
        {
            "location": "356/ACT",
            "narrator": "",
            "text": "冗談でした",
            "zh": "开玩笑的",
            "narrator_zh": ""
        },
        {
            "location": "359/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。",
            "zh": "原来如此。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "360/ACT",
            "narrator": "",
            "text": "バトル出来なくなるの辛い",
            "zh": "不能战斗了很痛苦",
            "narrator_zh": ""
        },
        {
            "location": "361/TALK",
            "narrator": "千羽鶴",
            "text": "それなら安心して。",
            "zh": "那点尽管放心。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "362/TALK",
            "narrator": "千羽鶴",
            "text": "これからも要所要所で\n手伝ってもらうから。",
            "zh": "今后在关键时刻\n还是会请你帮忙的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "363/ACT",
            "narrator": "",
            "text": "お話の核心が見られるから",
            "zh": "因为能看到故事的核心啊",
            "narrator_zh": ""
        },
        {
            "location": "364/TALK",
            "narrator": "千羽鶴",
            "text": "それなら安心して。",
            "zh": "那点尽管放心。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "365/TALK",
            "narrator": "千羽鶴",
            "text": "私が毎回\n語ってあげるから。",
            "zh": "以后每次都由我\n讲给你听。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "366/ACT",
            "narrator": "",
            "text": "どっちかというと千羽鶴に任せるのが心配",
            "zh": "真要说的话，交给千羽鹤实在让人放心不下",
            "narrator_zh": ""
        },
        {
            "location": "367/TALK",
            "narrator": "千羽鶴",
            "text": "それって、私を\n信用できないってこと？",
            "zh": "你这是在说，\n你不信任我吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "368/SEL",
            "narrator": "",
            "text": "イエス！",
            "zh": "Yes！",
            "narrator_zh": ""
        },
        {
            "location": "369/SEL",
            "narrator": "",
            "text": "そういうわけじゃないけど、",
            "zh": "倒也不是那个意思，",
            "narrator_zh": ""
        },
        {
            "location": "370/ACT",
            "narrator": "",
            "text": "イエス！",
            "zh": "Yes！",
            "narrator_zh": ""
        },
        {
            "location": "371/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。",
            "zh": "原来如此。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "372/TALK",
            "narrator": "千羽鶴",
            "text": "それは残念。",
            "zh": "那还真是遗憾。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "373/ACT",
            "narrator": "",
            "text": "そういうわけじゃないけど、",
            "zh": "倒也不是那个意思，",
            "narrator_zh": ""
        },
        {
            "location": "374/TALK",
            "narrator": "千羽鶴",
            "text": "煮え切らない人。",
            "zh": "真是个优柔寡断的人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "379/TALK",
            "narrator": "千羽鶴",
            "text": "いずれにせよ、\n貴方がどう思おうが\n状況はかわらない。",
            "zh": "不管怎样，\n无论你怎么想，\n情况都不会改变。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "380/TALK",
            "narrator": "千羽鶴",
            "text": "今後貴方には、現実の\n彼女をめいっぱい\n支えてあげて欲しい。",
            "zh": "今后希望你能把重心\n放到现实，全力去\n支撑她。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "381/TALK",
            "narrator": "千羽鶴",
            "text": "さて、そんな状況では\nあるのだけど――",
            "zh": "话虽如此，在眼下\n这种状况下——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "382/TALK",
            "narrator": "千羽鶴",
            "text": "今回ばかりは\n貴方の力が必要だから\n協力して欲しい。",
            "zh": "偏偏这一次\n还需要你的力量，\n所以请配合一下。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "383/SEL",
            "narrator": "",
            "text": "あれ？$me$は必要ないのでは？",
            "zh": "咦？不是说不需要$me$了吗？",
            "narrator_zh": ""
        },
        {
            "location": "384/ACT",
            "narrator": "",
            "text": "あれ？$me$は必要ないのでは？",
            "zh": "咦？不是说不需要$me$了吗？",
            "narrator_zh": ""
        },
        {
            "location": "386/TALK",
            "narrator": "千羽鶴",
            "text": "今回だけは\nまだ不十分なところが\nあるから。",
            "zh": "因为唯独这一次，\n还有尚不充分的\n部分。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "387/TALK",
            "narrator": "千羽鶴",
            "text": "前回の調整からあまり\n時間がなくて、完全な形\nでの対応ができなかった。",
            "zh": "距离上次调整没隔\n多少时间，没法做到\n以完全形态应对。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "388/TALK",
            "narrator": "千羽鶴",
            "text": "次回からは全部\n私の手でやる。",
            "zh": "从下次起就全部\n由我亲手处理了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "390/SEL",
            "narrator": "",
            "text": "わかった",
            "zh": "我知道了",
            "narrator_zh": ""
        },
        {
            "location": "391/SEL",
            "narrator": "",
            "text": "それはそうと、アーヤの司書はどうなった？",
            "zh": "话虽如此，绫水的司书怎么样了？",
            "narrator_zh": ""
        },
        {
            "location": "392/ACT",
            "narrator": "",
            "text": "わかった",
            "zh": "我知道了",
            "narrator_zh": ""
        },
        {
            "location": "393/TALK",
            "narrator": "千羽鶴",
            "text": "よろしく。",
            "zh": "拜托你了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "394/ACT",
            "narrator": "",
            "text": "それはそうと、アーヤの司書はどうなった？",
            "zh": "话虽如此，绫水的司书怎么样了？",
            "narrator_zh": ""
        },
        {
            "location": "395/TALK",
            "narrator": "千羽鶴",
            "text": "その役割は\n終了する。",
            "zh": "她的职责\n结束了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "396/TALK",
            "narrator": "千羽鶴",
            "text": "よって\n消滅することになる。",
            "zh": "因此\n将会消灭。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "397/SEL",
            "narrator": "",
            "text": "え！？　普通の人格に戻るんじゃなくて！？",
            "zh": "哎！？　不是变回普通的人格吗！？",
            "narrator_zh": ""
        },
        {
            "location": "398/ACT",
            "narrator": "",
            "text": "え！？　普通の人格に戻るんじゃなくて！？",
            "zh": "哎！？　不是变回普通的人格吗！？",
            "narrator_zh": ""
        },
        {
            "location": "400/TALK",
            "narrator": "千羽鶴",
            "text": "二代目の司書は、\n司書として\n新たに起こした人格。",
            "zh": "二代司书，\n是作为司书而\n新近唤起的人格。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "401/TALK",
            "narrator": "千羽鶴",
            "text": "よって、\n司書が不要になれば\nバラすだけ。",
            "zh": "因此，\n只要不再需要司书，\n把她拆解掉就行了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "402/SEL",
            "narrator": "",
            "text": "初代は？",
            "zh": "那初代呢？",
            "narrator_zh": ""
        },
        {
            "location": "403/ACT",
            "narrator": "",
            "text": "初代は？",
            "zh": "那初代呢？",
            "narrator_zh": ""
        },
        {
            "location": "405/TALK",
            "narrator": "千羽鶴",
            "text": "初代は\n事を起こしすぎてる。",
            "zh": "初代\n掀起的风波太多了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "406/TALK",
            "narrator": "千羽鶴",
            "text": "今後の設計には\n害悪になる。\nだから消滅させる。",
            "zh": "对今后的设计来说\n只会成为害虫。\n所以要让她消灭。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "407/SEL",
            "narrator": "",
            "text": "確かにだいぶ暴れたからね、仕方ない",
            "zh": "她确实闹腾得够呛呢，没办法",
            "narrator_zh": ""
        },
        {
            "location": "408/SEL",
            "narrator": "",
            "text": "初代司書が言っていた契約者って千羽鶴でしょう？",
            "zh": "初代司书说过的那个契约者，就是千羽鹤你吧？",
            "narrator_zh": ""
        },
        {
            "location": "409/ACT",
            "narrator": "",
            "text": "確かにだいぶ暴れたからね、仕方ない",
            "zh": "她确实闹腾得够呛呢，没办法",
            "narrator_zh": ""
        },
        {
            "location": "410/TALK",
            "narrator": "千羽鶴",
            "text": "そう。\n仕方ない。",
            "zh": "是的。\n没办法。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "411/TALK",
            "narrator": "千羽鶴",
            "text": "残念だけど、\nもう再教育してる\n時間はない。",
            "zh": "虽然很遗憾，\n但已经没有时间\n对她再教育了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "412/ACT",
            "narrator": "",
            "text": "初代司書が言っていた契約者って千羽鶴でしょう？",
            "zh": "初代司书说过的那个契约者，就是千羽鹤你吧？",
            "narrator_zh": ""
        },
        {
            "location": "413/TALK",
            "narrator": "千羽鶴",
            "text": "そう。",
            "zh": "是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "414/SEL",
            "narrator": "",
            "text": "利害が一致しなくなったら自分に牙を剥くって言ってたけど本当だね",
            "zh": "她说一旦利害不再一致就会露出獠牙，果然是真的呢",
            "narrator_zh": ""
        },
        {
            "location": "415/ACT",
            "narrator": "",
            "text": "利害が一致しなくなったら自分に牙を剥くって言ってたけど本当だね",
            "zh": "她说一旦利害不再一致就会露出獠牙，果然是真的呢",
            "narrator_zh": ""
        },
        {
            "location": "417/TALK",
            "narrator": "千羽鶴",
            "text": "全てはこの先の\n幸せを願ってのこと。",
            "zh": "这一切都是为了\n祈愿今后的幸福。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "418/TALK",
            "narrator": "千羽鶴",
            "text": "決して國政綾水を\n傷つけたいわけじゃない。",
            "zh": "我绝不是想要\n伤害国政绫水。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "419/TALK",
            "narrator": "千羽鶴",
            "text": "けど、時にそれは\n茨の道になることもある。",
            "zh": "不过，有时候这也\n会是一条荆棘之路。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "420/TALK",
            "narrator": "千羽鶴",
            "text": "彼女…初代司書には\nそれがわからないだけ。",
            "zh": "她……初代司书只是\n不明白这一点罢了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "422/TALK",
            "narrator": "千羽鶴",
            "text": "さあ、それじゃ\nそろそろよろしく。",
            "zh": "好啦，那么\n差不多拜托你了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "450/TALK",
            "narrator": "千羽鶴",
            "text": "貴方とこの世界に\n素敵なココロの旅を。",
            "zh": "祝你与这个世界\n拥有一段美妙的心灵之旅。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "30/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>9月3日　 10:03 AM</color>\nとある休日の午前中、寮「とらいあんぐる」アーヤの部屋にて",
            "zh": "<color=green>9月3日　 10:03 AM</color>\n某个休息日的上午，在宿舍「三角」绫水的房间内",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "161/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch01",
            "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>在逢濑燕的心灵之中\n战斗开始了。</b></size></color>\n\n\n\n\n\n在她的心灵之中，\n正产生着巨大的纠葛。\n\n请潜入心灵领域\n化解逢濑燕内心的纠葛吧。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch01"
        },
        {
