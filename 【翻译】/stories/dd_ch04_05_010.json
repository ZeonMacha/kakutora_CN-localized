{
    "dir": "chap05/daydra/dd_ch04_05_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "5452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "新しい帯",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "新腰带"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "新しい帯",
            "zh": "新腰带",
            "narrator_zh": ""
        },
        {
            "location": "19/TALK",
            "narrator": "みやび",
            "text": "アーヤ。すまんが\n今日は、帰りが\nちっくと遅くなるき。",
            "zh": "绫水。对不住\n今天回去\n会晚一哈啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "22/TALK",
            "narrator": "アーヤ",
            "text": "あら、何か用事？",
            "zh": "哎呀，有什么事？",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/TALK",
            "narrator": "みやび",
            "text": "うむ、実は先日\n注文した新しい帯が、\n店のほうに届いたんよ。",
            "zh": "嗯，其实前几天\n订的新腰带，\n送到店里了。",
            "narrator_zh": "雅"
        },
        {
            "location": "24/TALK",
            "narrator": "みやび",
            "text": "本当は週末に\n受け取りに行く予定\nやったけんど――",
            "zh": "本来打算周末\n去取的，\n不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "25/TALK",
            "narrator": "みやび",
            "text": "早く見たくて堪らんき、\n帰りに行って来るちや。",
            "zh": "想早点看到，实在忍不住嘛，\n回来路上就去拿咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、なるほどね。\nわかったわ。",
            "zh": "呵呵，原来如此。\n知道了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "28/TALK",
            "narrator": "みやび",
            "text": "すまんな。",
            "zh": "对不住。",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "アーヤ",
            "text": "でも、帯ってことは\n和服専門の店よね？",
            "zh": "不过，腰带的话，\n是和服专门店吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "そういうお店に行ったの\n成人式の振袖を選びに\n行ったのが最後かも。",
            "zh": "那种店，我最后一次去\n可能是成年礼挑\n长袖和服的时候。",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "まあ、普通のヤツは\n滅多に行かない\n店やしな。",
            "zh": "嘛，一般人\n很少会去\n那种店。",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "アーヤ",
            "text": "そうね。でも、\n綺麗な着物が沢山\nあって素敵だったわ。",
            "zh": "是啊。不过，\n有好多漂亮的和服，\n很不错。",
            "narrator_zh": "绫水"
        },
        {
            "location": "36/TALK",
            "narrator": "みやび",
            "text": "…なんや、興味がある\nような言い方やな。",
            "zh": "……怎么，听起来\n你挺有兴趣。",
            "narrator_zh": "雅"
        },
        {
            "location": "37/SEL",
            "narrator": "",
            "text": "誘ってあげよう",
            "zh": "邀请她吧",
            "narrator_zh": ""
        },
        {
            "location": "38/SEL",
            "narrator": "",
            "text": "誘うのはやめよう",
            "zh": "还是别邀请",
            "narrator_zh": ""
        },
        {
            "location": "39/SEL",
            "narrator": "",
            "text": "着物を見繕ってあげよう",
            "zh": "帮她挑件和服",
            "narrator_zh": ""
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "ついでやし、一緒に\n行くんも楽しいかも\nしれんな。",
            "zh": "反正顺路，一起去\n也许也挺\n有意思。",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "アーヤがどんな着物を\n着たがるかも、ちっくと\n気にはなるし…。",
            "zh": "绫水想穿什么样的和服，\n我也有点\n在意……。",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "興味あるんやったら、\n一緒に来てもえいよ。",
            "zh": "有兴趣的话，\n一起来也要得。",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "えっ、いいの？",
            "zh": "诶，可以吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "構わんよ。\nうちもせっかくやき、\n店で試着もしたいき――",
            "zh": "没关系。\n我也难得嘛，\n还想在店里试穿啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "アーヤがいれば、\n似合うかどうか\n聞けるやろうしな。",
            "zh": "绫水在的话，\n合不合适\n也能问一声吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "喜んでお供するわ。",
            "zh": "乐意奉陪。",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、綺麗な着物が\n沢山見れそうで、\n今から凄く楽しみ。",
            "zh": "呵呵，好像能看到\n好多漂亮的和服，\n现在就开始期待了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "…こういう素直に喜ぶ\nところが、アーヤの\n可愛らしいところやね。",
            "zh": "……这么坦率地高兴，\n正是绫水\n可爱的地方咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "56/ACT",
            "narrator": "",
            "text": "誘ってあげよう",
            "zh": "邀请她吧",
            "narrator_zh": ""
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "うちもそう思うてた",
            "zh": "我也是这么想的",
            "narrator_zh": "雅"
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "気が合うな、相棒！",
            "zh": "合拍啊，搭档！",
            "narrator_zh": "雅"
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "シンクロ率上昇記念日や",
            "zh": "同步率上升纪念日咯",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "興味あるんやったら、\n一緒に来てもえいよ。",
            "zh": "有兴趣的话，\n一起来也要得。",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "えっ、いいの？",
            "zh": "诶，可以吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "構わんよ。\nうちもせっかくやき、\n店で試着もしたいき――",
            "zh": "没关系。\n我也难得嘛，\n还想在店里试穿啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "95/TALK",
            "narrator": "みやび",
            "text": "アーヤがいれば、\n似合うかどうか聞ける\nやろうしな。",
            "zh": "绫水在的话，\n合不合适也能问\n一声吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "97/TALK",
            "narrator": "アーヤ",
            "text": "喜んでお供するわ。",
            "zh": "乐意奉陪。",
            "narrator_zh": "绫水"
        },
        {
            "location": "98/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、綺麗な着物が\n沢山見れそうで、\n今から凄く楽しみ。",
            "zh": "呵呵，好像能看到\n好多漂亮的和服，\n现在就开始期待了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/TALK",
            "narrator": "みやび",
            "text": "…こういう素直に喜ぶ\nところが、アーヤの\n可愛らしいところやね。",
            "zh": "……这么坦率地高兴，\n正是绫水\n可爱的地方咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "116/ACT",
            "narrator": "",
            "text": "誘うのはやめよう",
            "zh": "还是别邀请",
            "narrator_zh": ""
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "意外やね",
            "zh": "意外咯",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "みやび",
            "text": "あんたなら、誘ってあげろ言うんかと思ったんやが",
            "zh": "我还以为以你的性子，会说去邀请她喃",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "まあ、帯を受け取りにいくだけやき",
            "zh": "嘛，不过是去取腰带而已啵",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "長いせんよう、一人で行くべきやな",
            "zh": "反正不会待很久，该一个人去",
            "narrator_zh": "雅"
        },
        {
            "location": "151/TALK",
            "narrator": "みやび",
            "text": "まあ、そういうこと\nやき。とりあえず\n伝えよう思うたんよ。",
            "zh": "嘛，就是这么回事\n啵。总之\n我想先说一声。",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "アーヤ",
            "text": "そっか…。",
            "zh": "这样啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "アーヤ",
            "text": "わかったわ。\nみんなには私から\n伝えておくから――",
            "zh": "知道了。\n大家那边我来\n转告——",
            "narrator_zh": "绫水"
        },
        {
            "location": "154/TALK",
            "narrator": "アーヤ",
            "text": "みやびは新しい帯を\n取りにいってきて。",
            "zh": "雅去把新腰带\n取回来吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "155/TALK",
            "narrator": "みやび",
            "text": "すまんな。",
            "zh": "对不住。",
            "narrator_zh": "雅"
        },
        {
            "location": "157/TALK",
            "narrator": "アーヤ",
            "text": "これくらい構わないわ。\n帰ったら、どんな\n帯なのか見せてね。",
            "zh": "这点没关系。\n回来让我看看\n是什么样的腰带。",
            "narrator_zh": "绫水"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "…やっぱりついて\nくるか、聞くべき\nやったかもしれんなぁ。",
            "zh": "……果然还是该问一句\n要不要跟着\n来的，也许。",
            "narrator_zh": "雅"
        },
        {
            "location": "164/TALK",
            "narrator": "みやび",
            "text": "今更後悔しても\n遅いけんど…。",
            "zh": "现在后悔\n也晚了，不过……。",
            "narrator_zh": "雅"
        },
        {
            "location": "165/ACT",
            "narrator": "",
            "text": "着物を見繕ってあげよう",
            "zh": "帮她挑件和服",
            "narrator_zh": ""
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "さすがは相棒や",
            "zh": "不愧是搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "うちじゃそんな面白いこと、絶対思いつかん",
            "zh": "我绝对想不出这么有意思的事",
            "narrator_zh": "雅"
        },
        {
            "location": "195/TALK",
            "narrator": "みやび",
            "text": "さっそく言ってみるき",
            "zh": "我这就去说啵",
            "narrator_zh": "雅"
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "アーヤ、うちと一緒に\n着物を見に行かんか？",
            "zh": "绫水，要不要和我一起\n去看和服喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "209/TALK",
            "narrator": "アーヤ",
            "text": "えっ、いいの？",
            "zh": "诶，可以吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "構わんよ。",
            "zh": "没关系。",
            "narrator_zh": "雅"
        },
        {
            "location": "212/TALK",
            "narrator": "みやび",
            "text": "というか、アーヤに\n似合いそうな着物を――",
            "zh": "说起来，有件好像\n很适合绫水的和服——",
            "narrator_zh": "雅"
        },
        {
            "location": "213/TALK",
            "narrator": "みやび",
            "text": "一着見繕ってやりたいと\n思うてなぁ。",
            "zh": "想给你\n挑一件。",
            "narrator_zh": "雅"
        },
        {
            "location": "215/TALK",
            "narrator": "アーヤ",
            "text": "それ、凄く嬉しいわ！\nちゃんとした着物を\n一着欲しかったの！",
            "zh": "那我太高兴了！\n我一直想要一件\n正经的和服！",
            "narrator_zh": "绫水"
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "なら、アーヤにお薦め\nしたいのがあるんよ。",
            "zh": "那，我有一件\n想推荐给绫水的。",
            "narrator_zh": "雅"
        },
        {
            "location": "217/TALK",
            "narrator": "みやび",
            "text": "藍色にピンクと白の\n模様が入った柄の\n生地があってな。",
            "zh": "有一块底子是蓝色，\n带粉色和白色\n花纹的布料。",
            "narrator_zh": "雅"
        },
        {
            "location": "218/TALK",
            "narrator": "アーヤ",
            "text": "へぇ、涼しげな感じね。",
            "zh": "嘿，看起来挺凉快。",
            "narrator_zh": "绫水"
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "帯含めて三百万ほど\nやけんど、値段相応の\nえいものやったよ。",
            "zh": "连腰带大概三百万，\n不过和价钱相称，\n是好东西。",
            "narrator_zh": "雅"
        },
        {
            "location": "221/TALK",
            "narrator": "アーヤ",
            "text": "…え？",
            "zh": "……诶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "222/TALK",
            "narrator": "アーヤ",
            "text": "ちょ、ちょっと待って！\n今、三百って…。",
            "zh": "等、等一下！\n刚才说三百……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "三百万や。",
            "zh": "三百万咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "225/TALK",
            "narrator": "アーヤ",
            "text": "新車のバイクが\n買えちゃうじゃない！",
            "zh": "都够买一辆\n新摩托车了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/TALK",
            "narrator": "みやび",
            "text": "アーヤ、着物は大事に\n着れば一生もんやき。\n高いのは当然ながよ。",
            "zh": "绫水，和服要是好好穿，\n是能穿一辈子的啵。\n贵是当然的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "229/TALK",
            "narrator": "アーヤ",
            "text": "や、やっぱり遠慮する！\nそれじゃ、講義が\nあるから私はこれで！",
            "zh": "还、还是算了！\n那么，我还有课，\n先走了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/TALK",
            "narrator": "みやび",
            "text": "あっ…逃げよった。",
            "zh": "啊……跑掉了。",
            "narrator_zh": "雅"
        },
        {
            "location": "235/TALK",
            "narrator": "みやび",
            "text": "…最初はもっと\nリーズナブルなものを\n薦めるべきやったか…。",
            "zh": "……一开始是不是该\n推荐更实惠的\n才对……。",
            "narrator_zh": "雅"
        },
        {
            "location": "16/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月10日　3:50 PM</color>\nとある平日の放課後、\n学園前の通学路にて。",
            "zh": "<color=green>5月10日　3:50 PM</color>\n某个工作日的放学后，\n在学园前的上学路上。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "110/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch04",
            "text": "【そこな越後屋】",
            "zh": "【那边的越后屋】",
            "narrator_zh": "Dialog_GEThimegoto_ch04"
        },
        {
            "location": "171/DIALOG",
            "narrator": "Dialog_GETGokigen",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": "Dialog_GETGokigen"
        }
    ]
}
