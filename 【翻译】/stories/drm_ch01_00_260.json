{
    "dir": "dramatics/daydra/drm_ch01_00_260.js",
    "type": "Episode",
    "info": {
        "story_id": "1026",
        "cid": "tsubame",
        "title": "らぶとーく 第26話",
        "sub_title": "恋人の条件",
        "title_zh": "恋爱漫谈 第26话",
        "sub_title_zh": "恋人的条件"
    },
    "entry": [
        {
            "location": "219/SCENARIO",
            "narrator": "",
            "text": "恋人の条件",
            "zh": "恋人的条件",
            "narrator_zh": ""
        },
        {
            "location": "236/TALK",
            "narrator": "つばめ",
            "text": "ごめんね、ひなこちゃん。\n何度も相談に乗って\nもらって…。",
            "zh": "抱歉，雏酱。\n好几次都找你\n商量……。",
            "narrator_zh": "燕"
        },
        {
            "location": "238/TALK",
            "narrator": "雛",
            "text": "ううん、気にしないでー。",
            "zh": "没事没事，别在意——。",
            "narrator_zh": "雏"
        },
        {
            "location": "239/TALK",
            "narrator": "雛",
            "text": "っていうか、ここまで\n関わったら――",
            "zh": "话说，都参与到\n这个地步了——",
            "narrator_zh": "雏"
        },
        {
            "location": "240/TALK",
            "narrator": "雛",
            "text": "途中で投げ出すなんて\nできないって。",
            "zh": "可不能半途而废\n直接甩手不管嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "241/TALK",
            "narrator": "つばめ",
            "text": "…本当にありがと。",
            "zh": "……真的谢谢你。",
            "narrator_zh": "燕"
        },
        {
            "location": "242/TALK",
            "narrator": "雛",
            "text": "それで…どう？",
            "zh": "然后……怎么样？",
            "narrator_zh": "雏"
        },
        {
            "location": "243/TALK",
            "narrator": "雛",
            "text": "あれから少しは考えが\nまとまった？",
            "zh": "从那之后稍微\n理出点头绪了吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "245/TALK",
            "narrator": "つばめ",
            "text": "うーん…。",
            "zh": "嗯……",
            "narrator_zh": "燕"
        },
        {
            "location": "247/TALK",
            "narrator": "つばめ",
            "text": "とりあえず、ツンデレに\nなるのは間違い、って\nいうのはわかったかな？",
            "zh": "总之，变成傲娇是\n错的，这一点\n你明白了吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "248/TALK",
            "narrator": "雛",
            "text": "…ぜ、前進してるって\n思っていいのかなー？",
            "zh": "……这、这能算是在\n往前推进了吧——？",
            "narrator_zh": "雏"
        },
        {
            "location": "249/TALK",
            "narrator": "つばめ",
            "text": "どうなのかな？",
            "zh": "怎么样呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "250/TALK",
            "narrator": "つばめ",
            "text": "でも、それ以外は\nさっぱりわからないの。",
            "zh": "不过，除此之外我\n完全不明白。",
            "narrator_zh": "燕"
        },
        {
            "location": "251/TALK",
            "narrator": "つばめ",
            "text": "そもそもの話、\n何を考えればいいのかが\nわからないし…。",
            "zh": "说到底，\n该想什么\n我都不清楚……。",
            "narrator_zh": "燕"
        },
        {
            "location": "252/TALK",
            "narrator": "雛",
            "text": "あ、あはは…。\nそっかぁ、そこからかー。",
            "zh": "啊、啊哈哈……。\n这样啊，得从那儿开始啊——。",
            "narrator_zh": "雏"
        },
        {
            "location": "253/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、何度考えても\n好きって思うんだけど――",
            "zh": "果然，不管想多少次\n我都觉得是喜欢——",
            "narrator_zh": "燕"
        },
        {
            "location": "255/TALK",
            "narrator": "つばめ",
            "text": "でも、この好きは恋とは\n違う好きで――",
            "zh": "不过，这份喜欢和恋爱的\n喜欢不一样——",
            "narrator_zh": "燕"
        },
        {
            "location": "256/TALK",
            "narrator": "つばめ",
            "text": "でも恋も好きってことに\n変わりはなくて――",
            "zh": "不过喜欢这件事\n没有变——",
            "narrator_zh": "燕"
        },
        {
            "location": "257/TALK",
            "narrator": "つばめ",
            "text": "うーん…。",
            "zh": "嗯……",
            "narrator_zh": "燕"
        },
        {
            "location": "258/TALK",
            "narrator": "雛",
            "text": "…真剣なんだね。",
            "zh": "……你是认真的呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "261/TALK",
            "narrator": "つばめ",
            "text": "でも、いくら真剣でも\n全然わからないの。",
            "zh": "不过，再怎么认真，\n我也完全不明白。",
            "narrator_zh": "燕"
        },
        {
            "location": "263/TALK",
            "narrator": "つばめ",
            "text": "もしかして、わたしには\n一生理解できないのかな？",
            "zh": "难道说，我一辈子\n都理解不了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "264/TALK",
            "narrator": "雛",
            "text": "ダメだよつばめちゃん！\n弱気になったら\nそこで終わりだよ！？",
            "zh": "不行哦燕！\n要是气馁了，\n那可就完了哦！？",
            "narrator_zh": "雏"
        },
        {
            "location": "267/TALK",
            "narrator": "つばめ",
            "text": "そ、そうかもしれない\nけど、でも…。",
            "zh": "也、也许是这样\n不过，可是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "268/TALK",
            "narrator": "雛",
            "text": "…それじゃあ、ちょっと\n考え方を変えてみよっか？",
            "zh": "……那么，稍微\n换个思路试试吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "269/TALK",
            "narrator": "雛",
            "text": "つばめちゃんはさ、\n恋人になる人に対して――",
            "zh": "燕啊，对要成为\n恋人的人——",
            "narrator_zh": "雏"
        },
        {
            "location": "270/TALK",
            "narrator": "雛",
            "text": "どういう条件が必要だと\n思ってる？",
            "zh": "你觉得需要\n什么条件？",
            "narrator_zh": "雏"
        },
        {
            "location": "272/TALK",
            "narrator": "つばめ",
            "text": "条件？",
            "zh": "条件？",
            "narrator_zh": "燕"
        },
        {
            "location": "273/TALK",
            "narrator": "雛",
            "text": "うん、恋人の条件。",
            "zh": "嗯，恋人的条件。",
            "narrator_zh": "雏"
        },
        {
            "location": "274/TALK",
            "narrator": "雛",
            "text": "そういうの、何かしら\nあるでしょ？",
            "zh": "那种的，总会有\n一些的吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "275/TALK",
            "narrator": "つばめ",
            "text": "うーん、条件かぁ…。",
            "zh": "唔——，条件啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "276/TALK",
            "narrator": "雛",
            "text": "…わからないなら、\nちょっと検索でも\nしてみなよ。",
            "zh": "……不明白的话，\n就稍微\n上网查一查嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "277/TALK",
            "narrator": "雛",
            "text": "この手の話は、ネットに\nゴロゴロ転がってるよー。",
            "zh": "这类事情，网上\n到处都是哦—。",
            "narrator_zh": "雏"
        },
        {
            "location": "278/TALK",
            "narrator": "つばめ",
            "text": "う、うん…。",
            "zh": "嗯、嗯……",
            "narrator_zh": "燕"
        },
        {
            "location": "280/TALK",
            "narrator": "つばめ",
            "text": "…でも、それだったら\n$handle$さんに聞いて\nみようかな？",
            "zh": "……不过，要是那样，\n干脆去问问$handle$\n好不好呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "292/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんヽ(*´∀｀*)ﾉ",
            "zh": "$handle$＼(*´∀｀*)／",
            "narrator_zh": "燕"
        },
        {
            "location": "293/TALK",
            "narrator": "つばめ",
            "text": "ちょっと聞きたぃんだけど",
            "zh": "我想稍微问一下",
            "narrator_zh": "燕"
        },
        {
            "location": "294/TALK",
            "narrator": "つばめ",
            "text": "恋人の条件ってなんだろぅ？(ﾟ∀ﾟ人)",
            "zh": "恋人的条件是什么呀？(ﾟ∀ﾟ人)",
            "narrator_zh": "燕"
        },
        {
            "location": "296/SEL",
            "narrator": "",
            "text": "それを$me$に聞かれても",
            "zh": "你来问$me$这个",
            "narrator_zh": ""
        },
        {
            "location": "297/SEL",
            "narrator": "",
            "text": "特別かどうかってことかな",
            "zh": "是在说算不算特别吧",
            "narrator_zh": ""
        },
        {
            "location": "298/SEL",
            "narrator": "",
            "text": "ときめきがあるかどうかかな",
            "zh": "就看有没有心动吧",
            "narrator_zh": ""
        },
        {
            "location": "299/ACT",
            "narrator": "",
            "text": "それを$me$に聞かれても",
            "zh": "你来问$me$这个",
            "narrator_zh": ""
        },
        {
            "location": "300/TALK",
            "narrator": "つばめ",
            "text": "ぁ(ﾟ△ﾟ;ﾉ)ﾉ",
            "zh": "啊(ﾟ△ﾟ;ﾉ)ﾉ",
            "narrator_zh": "燕"
        },
        {
            "location": "302/TALK",
            "narrator": "つばめ",
            "text": "そぅだよね",
            "zh": "是这样吧",
            "narrator_zh": "燕"
        },
        {
            "location": "304/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんに求める条件なんだから",
            "zh": "这是对$handle$提的条件嘛",
            "narrator_zh": "燕"
        },
        {
            "location": "305/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんに聞くのは変だよね(/ω＼)(/ω＼)ﾊｽﾞｶｼｰｨ",
            "zh": "问$handle$太奇怪了吧(/ω＼)(/ω＼)好羞人",
            "narrator_zh": "燕"
        },
        {
            "location": "307/TALK",
            "narrator": "つばめ",
            "text": "難しぃなぁ(´・ω・｀)",
            "zh": "好难呀(´・ω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "309/SEL",
            "narrator": "",
            "text": "そんなところがつばめらしい",
            "zh": "这种地方才像燕",
            "narrator_zh": ""
        },
        {
            "location": "310/ACT",
            "narrator": "",
            "text": "そんなところがつばめらしい",
            "zh": "这种地方才像燕",
            "narrator_zh": ""
        },
        {
            "location": "312/TALK",
            "narrator": "つばめ",
            "text": "ぅーん",
            "zh": "唔——",
            "narrator_zh": "燕"
        },
        {
            "location": "313/TALK",
            "narrator": "つばめ",
            "text": "良ぃってことかな？(´・ω・｀)",
            "zh": "这是夸我不错的意思吗？(´・ω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "314/TALK",
            "narrator": "つばめ",
            "text": "そぅだったら嬉しぃな(●´ω｀●)ゞｴﾍﾍ",
            "zh": "那样就好了(●´ω｀●)嘿嘿",
            "narrator_zh": "燕"
        },
        {
            "location": "315/ACT",
            "narrator": "",
            "text": "特別かどうかってことかな",
            "zh": "是在说算不算特别吧",
            "narrator_zh": ""
        },
        {
            "location": "316/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんは特別だよヾ(*´ｴ`*)ﾉ ｲｯﾁｬｯﾀ",
            "zh": "$handle$是特别的哦＼(*´ε`*)／说出来了",
            "narrator_zh": "燕"
        },
        {
            "location": "318/SEL",
            "narrator": "",
            "text": "じゃあ気にしなくていいよ",
            "zh": "那就不用在意了",
            "narrator_zh": ""
        },
        {
            "location": "319/ACT",
            "narrator": "",
            "text": "じゃあ気にしなくていいよ",
            "zh": "那就不用在意了",
            "narrator_zh": ""
        },
        {
            "location": "321/TALK",
            "narrator": "つばめ",
            "text": "そぅなの？",
            "zh": "是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "322/TALK",
            "narrator": "つばめ",
            "text": "ぅーん",
            "zh": "唔——",
            "narrator_zh": "燕"
        },
        {
            "location": "324/TALK",
            "narrator": "つばめ",
            "text": "それでぃぃのかなぁ？(o´Д`)=з",
            "zh": "这样真行吗？(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "325/ACT",
            "narrator": "",
            "text": "ときめきがあるかどうかかな",
            "zh": "就看有没有心动吧",
            "narrator_zh": ""
        },
        {
            "location": "326/TALK",
            "narrator": "つばめ",
            "text": "ときめきって何だろぅ？",
            "zh": "心动到底是什么呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "327/TALK",
            "narrator": "つばめ",
            "text": "それがわかると恋もわかるよぅになるのかな？(｡･ω･｡)",
            "zh": "明白那个就能明白恋爱了吗？(｡･ω･｡)",
            "narrator_zh": "燕"
        },
        {
            "location": "329/SEL",
            "narrator": "",
            "text": "だったら教えようがないよ",
            "zh": "那我就没法教你了",
            "narrator_zh": ""
        },
        {
            "location": "330/ACT",
            "narrator": "",
            "text": "だったら教えようがないよ",
            "zh": "那我就没法教你了",
            "narrator_zh": ""
        },
        {
            "location": "332/TALK",
            "narrator": "つばめ",
            "text": "そっか(´･ω･｀) ",
            "zh": "这样啊(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "333/TALK",
            "narrator": "つばめ",
            "text": "ぅーん",
            "zh": "唔——",
            "narrator_zh": "燕"
        },
        {
            "location": "334/TALK",
            "narrator": "つばめ",
            "text": "やっぱり難しぃね(o´Д`)=з",
            "zh": "果然还是好难呀(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "348/TALK",
            "narrator": "つばめ",
            "text": "…ごめん、ひなこちゃん。\n全然わからないや。",
            "zh": "……抱歉，小雏。\n我完全搞不懂呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "349/TALK",
            "narrator": "雛",
            "text": "…そ、それ、本気？",
            "zh": "……你、你是认真的？",
            "narrator_zh": "雏"
        },
        {
            "location": "350/TALK",
            "narrator": "つばめ",
            "text": "うん…恋人の条件って、\nなんなんだろう？",
            "zh": "嗯……恋人的条件，\n到底是什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "353/TALK",
            "narrator": "つばめ",
            "text": "好きって気持ちだけじゃ\nダメなのかなぁ？",
            "zh": "光有喜欢的心情\n难道不行吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "354/TALK",
            "narrator": "つばめ",
            "text": "あ、でもわたしの好きは\n恋の好きじゃないし…\nう～ん…。",
            "zh": "啊，不过我的喜欢\n又不是恋爱的喜欢……\n唔——……。",
            "narrator_zh": "燕"
        },
        {
            "location": "356/TALK",
            "narrator": "雛",
            "text": "…ちょっと疑ったけど、\nしらばっくれてるわけじゃ\nないみたいだねー。",
            "zh": "……我还稍微怀疑了一下，\n看来你真不是在\n装糊涂呢——。",
            "narrator_zh": "雏"
        },
        {
            "location": "359/TALK",
            "narrator": "つばめ",
            "text": "え？　何を？",
            "zh": "诶？　什么？",
            "narrator_zh": "燕"
        },
        {
            "location": "361/TALK",
            "narrator": "雛",
            "text": "ううん、何でもない。",
            "zh": "嗯嗯，没什么。",
            "narrator_zh": "雏"
        },
        {
            "location": "362/TALK",
            "narrator": "雛",
            "text": "つばめちゃんは、\n人一倍時間を掛けて――",
            "zh": "燕比别人\n多花一倍时间——",
            "narrator_zh": "雏"
        },
        {
            "location": "363/TALK",
            "narrator": "雛",
            "text": "ゆっくり恋をしていく\nタイプなのかも\nしれないね。",
            "zh": "说不定就是那种\n慢慢坠入爱河的\n类型呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "366/TALK",
            "narrator": "つばめ",
            "text": "そうなのかなぁ？\nうーん…。",
            "zh": "是这样吗？\n嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "367/TALK",
            "narrator": "雛",
            "text": "今はこれ以上考えても\n答えなんて出ないよ。",
            "zh": "现在再怎么想，\n也想不出答案的啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "368/TALK",
            "narrator": "雛",
            "text": "それより、せっかく\nカフェに来てるんだから、\n甘い物でも食べよ。",
            "zh": "比起那个，难得\n来咖啡馆了，\n吃点甜的吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "227/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　2:04 PM</color>\nとある平日の午後、学園廊下にて。",
            "zh": "<color=green>某月某日　2:04 PM</color>\n某个平日的下午，在学园走廊。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
