{
    "dir": "dramatics/daydra/drm_ch04_00_100.js",
    "type": "Episode",
    "info": {
        "story_id": "4010",
        "cid": "miyabi",
        "title": "らぶとーく 第10話",
        "sub_title": "定石などないかもしれんが",
        "title_zh": "恋爱漫谈 第10话",
        "sub_title_zh": "虽说未必有什么定式"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "定石などないかもしれんが",
            "zh": "虽说未必有什么定式",
            "narrator_zh": ""
        },
        {
            "location": "20/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "21/TALK",
            "narrator": "アーヤ",
            "text": "ちょ、ちょっと待って。\n今、なんて言った？",
            "zh": "等、等一下。\n你刚才说什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/TALK",
            "narrator": "みやび",
            "text": "もう一度\n伝えるぞね。",
            "zh": "再讲\n一遍咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "24/TALK",
            "narrator": "みやび",
            "text": "Ｂｏｔが人間と\nわかった。\nということは。",
            "zh": "已经弄清Bot\n是人类了。\n也就是说。",
            "narrator_zh": "雅"
        },
        {
            "location": "25/TALK",
            "narrator": "みやび",
            "text": "奴の目的をどうにかして\n探りださんことには、\n安心できんぞね。",
            "zh": "得想办法探出\n那家伙的目的，\n才能安心咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "28/TALK",
            "narrator": "みやび",
            "text": "もしヤツがスパイやと\nしたら、うちらは\n大ピンチぞね。",
            "zh": "要是那家伙是间谍，\n我们就\n大难临头咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "どうしたが？",
            "zh": "怎么了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "35/TALK",
            "narrator": "アーヤ",
            "text": "みやびが気になるのは\nそこなのね。",
            "zh": "雅你在意的\n是这点啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "私はまだＢｏｔが\n人間だとは\n思えないの。",
            "zh": "我暂时还\n没法相信Bot\n是人类哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "アーヤ",
            "text": "直接会った\nわけでもないし。",
            "zh": "毕竟又没有\n直接见过面。",
            "narrator_zh": "绫水"
        },
        {
            "location": "41/TALK",
            "narrator": "アーヤ",
            "text": "確信が持てない。",
            "zh": "没法确信。",
            "narrator_zh": "绫水"
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "…いや、\nこれだけのデータが\n証明しとろう。",
            "zh": "……不，\n这么多数据\n都证明着咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "アーヤ",
            "text": "高性能すぎる\nＡＩかもって\n仮説は捨てきれない。",
            "zh": "说不定是性能过高的\nAI——这个假设\n还丢不掉。",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "だから！",
            "zh": "所以啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "相棒",
            "zh": "搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "急用や",
            "zh": "有急事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "一度は断れたけんど",
            "zh": "上次被推掉了，但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "再交渉したい思うた時",
            "zh": "想再谈一次的时候",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "どんなカードを切ればえいと思う？",
            "zh": "你觉得该打哪张牌啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "63/SEL",
            "narrator": "",
            "text": "秘密をバラすぞと言え",
            "zh": "你就说要把秘密抖出去",
            "narrator_zh": ""
        },
        {
            "location": "64/SEL",
            "narrator": "",
            "text": "泣き落とせ",
            "zh": "用眼泪打动人心",
            "narrator_zh": ""
        },
        {
            "location": "65/SEL",
            "narrator": "",
            "text": "恫喝せよ",
            "zh": "去恐吓吧",
            "narrator_zh": ""
        },
        {
            "location": "66/ACT",
            "narrator": "",
            "text": "秘密をバラすぞと言え",
            "zh": "你就说要把秘密抖出去",
            "narrator_zh": ""
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "そんなもん知らん",
            "zh": "那种事我不知道",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "秘密とは何か？",
            "zh": "所谓秘密，是驷马？",
            "narrator_zh": "雅"
        },
        {
            "location": "70/SEL",
            "narrator": "",
            "text": "遠回しな言い方すれば、勝手に察するはず",
            "zh": "绕着弯说，对方自然会懂",
            "narrator_zh": ""
        },
        {
            "location": "71/ACT",
            "narrator": "",
            "text": "遠回しな言い方すれば、勝手に察するはず",
            "zh": "绕着弯说，对方自然会懂",
            "narrator_zh": ""
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "あー",
            "zh": "啊——",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "それな",
            "zh": "就是说啊",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "やってみるぞね",
            "zh": "那我就试试看咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "76/ACT",
            "narrator": "",
            "text": "泣き落とせ",
            "zh": "用眼泪打动人心",
            "narrator_zh": ""
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "おぉっ",
            "zh": "哦哦",
            "narrator_zh": "雅"
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "それはうちの十八番や",
            "zh": "那是我的拿手好戏嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "演技はみやびさんの実力",
            "zh": "演技可就看雅小姐的真本事了。",
            "narrator_zh": "雅"
        },
        {
            "location": "81/ACT",
            "narrator": "",
            "text": "恫喝せよ",
            "zh": "去恐吓吧",
            "narrator_zh": ""
        },
        {
            "location": "82/TALK",
            "narrator": "みやび",
            "text": "何やと！？",
            "zh": "你说驷马！？",
            "narrator_zh": "雅"
        },
        {
            "location": "83/TALK",
            "narrator": "みやび",
            "text": "何と卑劣な",
            "zh": "何其卑劣",
            "narrator_zh": "雅"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "面白そうだからやってみるちや",
            "zh": "看着挺有意思，就试试滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "こんなことＡＩが\nアドバイスするとは\n思えんぞね。",
            "zh": "我可不觉得AI会\n给这种\n建议咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "100/TALK",
            "narrator": "アーヤ",
            "text": "そんなこと\n言われても…。",
            "zh": "就算被你说那种话……。\n",
            "narrator_zh": "绫水"
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "アーヤもわかっとろう。\nこの回答は\n人間にしかできんて。",
            "zh": "绫水你其实也\n明白着的吧。\n这回答只有人类答得出。",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "そうかも\nしれないけど…。",
            "zh": "也许\n是这样……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "アーヤなら\nわかってくれると\n思うとったのに。",
            "zh": "我还想着\n绫水你会懂我的\n来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "105/TALK",
            "narrator": "アーヤ",
            "text": "……ごめんなさい。",
            "zh": "……对不起。",
            "narrator_zh": "绫水"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "責めたいわけじゃ\nないぞね……。",
            "zh": "并不是想\n怪你咧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "じゃあまだ\n他の子たちには\n知らせんが？",
            "zh": "那还没告诉\n其他孩子们，\n没是嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "109/TALK",
            "narrator": "アーヤ",
            "text": "ううん。\n伝えるつもり。",
            "zh": "不。\n我打算告诉她们。",
            "narrator_zh": "绫水"
        },
        {
            "location": "110/TALK",
            "narrator": "アーヤ",
            "text": "あくまで可能性の\n話としてね。",
            "zh": "不过是作为\n一种可能性来说哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "可能性、のう。\nそれが一番\n受け入れやすいのか。",
            "zh": "可能性，呐。\n那样最容易\n被人接受咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "17/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月某日　10:12 PM</color>\n平日の夜、アーヤの部屋にて。",
            "zh": "<color=green>5月某日　10:12 PM</color>\n平日的夜晚，在绫水的房间里。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
