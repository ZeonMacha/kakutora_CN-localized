{
 "dir": "dramatics/daydra/drm_ch04_00_100.js",
 "type": "Episode",
 "info": {
  "story_id": "4010",
  "cid": "miyabi",
  "title": "らぶとーく 第10話",
  "sub_title": "定石などないかもしれんが"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "定石などないかもしれんが"
  },
  {
   "location": "20/TALK",
   "narrator": "アーヤ",
   "text": "えっ！？",
   "zh": "诶！？",
   "narrator_zh": "绫水"
  },
  {
   "location": "21/TALK",
   "narrator": "アーヤ",
   "text": "ちょ、ちょっと待って。\n今、なんて言った？",
   "zh": "等、等一下。\n你刚才说什么？",
   "narrator_zh": "绫水"
  },
  {
   "location": "23/TALK",
   "narrator": "みやび",
   "text": "もう一度\n伝えるぞね。"
  },
  {
   "location": "24/TALK",
   "narrator": "みやび",
   "text": "Ｂｏｔが人間と\nわかった。\nということは。"
  },
  {
   "location": "25/TALK",
   "narrator": "みやび",
   "text": "奴の目的をどうにかして\n探りださんことには、\n安心できんぞね。"
  },
  {
   "location": "28/TALK",
   "narrator": "みやび",
   "text": "もしヤツがスパイやと\nしたら、うちらは\n大ピンチぞね。"
  },
  {
   "location": "30/TALK",
   "narrator": "アーヤ",
   "text": "……。"
  },
  {
   "location": "33/TALK",
   "narrator": "みやび",
   "text": "どうしたが？",
   "zh": "怎么了……？",
   "narrator_zh": "雅"
  },
  {
   "location": "35/TALK",
   "narrator": "アーヤ",
   "text": "みやびが気になるのは\nそこなのね。"
  },
  {
   "location": "37/TALK",
   "narrator": "アーヤ",
   "text": "私はまだＢｏｔが\n人間だとは\n思えないの。"
  },
  {
   "location": "39/TALK",
   "narrator": "アーヤ",
   "text": "直接会った\nわけでもないし。"
  },
  {
   "location": "41/TALK",
   "narrator": "アーヤ",
   "text": "確信が持てない。"
  },
  {
   "location": "42/TALK",
   "narrator": "みやび",
   "text": "…いや、\nこれだけのデータが\n証明しとろう。"
  },
  {
   "location": "43/TALK",
   "narrator": "アーヤ",
   "text": "高性能すぎる\nＡＩかもって\n仮説は捨てきれない。"
  },
  {
   "location": "45/TALK",
   "narrator": "みやび",
   "text": "だから！",
   "zh": "所以啊！",
   "narrator_zh": "雅"
  },
  {
   "location": "57/TALK",
   "narrator": "みやび",
   "text": "相棒"
  },
  {
   "location": "58/TALK",
   "narrator": "みやび",
   "text": "急用や"
  },
  {
   "location": "59/TALK",
   "narrator": "みやび",
   "text": "一度は断れたけんど"
  },
  {
   "location": "60/TALK",
   "narrator": "みやび",
   "text": "再交渉したい思うた時"
  },
  {
   "location": "61/TALK",
   "narrator": "みやび",
   "text": "どんなカードを切ればえいと思う？",
   "zh": "你觉得该打哪张牌啵？",
   "narrator_zh": "雅"
  },
  {
   "location": "63/SEL",
   "narrator": "",
   "text": "秘密をバラすぞと言え",
   "zh": "你就说要把秘密抖出去",
   "narrator_zh": ""
  },
  {
   "location": "64/SEL",
   "narrator": "",
   "text": "泣き落とせ",
   "zh": "用眼泪打动人心",
   "narrator_zh": ""
  },
  {
   "location": "65/SEL",
   "narrator": "",
   "text": "恫喝せよ",
   "zh": "去恐吓吧",
   "narrator_zh": ""
  },
  {
   "location": "66/ACT",
   "narrator": "",
   "text": "秘密をバラすぞと言え",
   "zh": "你就说要把秘密抖出去",
   "narrator_zh": ""
  },
  {
   "location": "67/TALK",
   "narrator": "みやび",
   "text": "そんなもん知らん",
   "zh": "那种事我不知道",
   "narrator_zh": "雅"
  },
  {
   "location": "68/TALK",
   "narrator": "みやび",
   "text": "秘密とは何か？"
  },
  {
   "location": "70/SEL",
   "narrator": "",
   "text": "遠回しな言い方すれば、勝手に察するはず",
   "zh": "绕着弯说，对方自然会懂",
   "narrator_zh": ""
  },
  {
   "location": "71/ACT",
   "narrator": "",
   "text": "遠回しな言い方すれば、勝手に察するはず",
   "zh": "绕着弯说，对方自然会懂",
   "narrator_zh": ""
  },
  {
   "location": "73/TALK",
   "narrator": "みやび",
   "text": "あー",
   "zh": "啊——",
   "narrator_zh": "雅"
  },
  {
   "location": "74/TALK",
   "narrator": "みやび",
   "text": "それな",
   "zh": "就是说啊",
   "narrator_zh": "雅"
  },
  {
   "location": "75/TALK",
   "narrator": "みやび",
   "text": "やってみるぞね"
  },
  {
   "location": "76/ACT",
   "narrator": "",
   "text": "泣き落とせ",
   "zh": "用眼泪打动人心",
   "narrator_zh": ""
  },
  {
   "location": "77/TALK",
   "narrator": "みやび",
   "text": "おぉっ",
   "zh": "哦哦",
   "narrator_zh": "雅"
  },
  {
   "location": "78/TALK",
   "narrator": "みやび",
   "text": "それはうちの十八番や",
   "zh": "那是我的拿手好戏嘛",
   "narrator_zh": "雅"
  },
  {
   "location": "79/TALK",
   "narrator": "みやび",
   "text": "演技はみやびさんの実力"
  },
  {
   "location": "81/ACT",
   "narrator": "",
   "text": "恫喝せよ",
   "zh": "去恐吓吧",
   "narrator_zh": ""
  },
  {
   "location": "82/TALK",
   "narrator": "みやび",
   "text": "何やと！？"
  },
  {
   "location": "83/TALK",
   "narrator": "みやび",
   "text": "何と卑劣な"
  },
  {
   "location": "84/TALK",
   "narrator": "みやび",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "85/TALK",
   "narrator": "みやび",
   "text": "面白そうだからやってみるちや"
  },
  {
   "location": "98/TALK",
   "narrator": "みやび",
   "text": "こんなことＡＩが\nアドバイスするとは\n思えんぞね。",
   "zh": "我可不觉得AI会\n给这种\n建议咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "100/TALK",
   "narrator": "アーヤ",
   "text": "そんなこと\n言われても…。",
   "zh": "就算被你说那种话……。\n",
   "narrator_zh": "绫水"
  },
  {
   "location": "101/TALK",
   "narrator": "みやび",
   "text": "アーヤもわかっとろう。\nこの回答は\n人間にしかできんて。"
  },
  {
   "location": "102/TALK",
   "narrator": "アーヤ",
   "text": "そうかも\nしれないけど…。",
   "zh": "也许\n是这样……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "103/TALK",
   "narrator": "みやび",
   "text": "アーヤなら\nわかってくれると\n思うとったのに。"
  },
  {
   "location": "104/TALK",
   "narrator": "アーヤ",
   "text": "……。"
  },
  {
   "location": "105/TALK",
   "narrator": "アーヤ",
   "text": "……ごめんなさい。"
  },
  {
   "location": "106/TALK",
   "narrator": "みやび",
   "text": "責めたいわけじゃ\nないぞね……。"
  },
  {
   "location": "107/TALK",
   "narrator": "アーヤ",
   "text": "……。"
  },
  {
   "location": "108/TALK",
   "narrator": "みやび",
   "text": "じゃあまだ\n他の子たちには\n知らせんが？"
  },
  {
   "location": "109/TALK",
   "narrator": "アーヤ",
   "text": "ううん。\n伝えるつもり。"
  },
  {
   "location": "110/TALK",
   "narrator": "アーヤ",
   "text": "あくまで可能性の\n話としてね。"
  },
  {
   "location": "112/TALK",
   "narrator": "みやび",
   "text": "可能性、のう。\nそれが一番\n受け入れやすいのか。"
  },
  {
   "location": "17/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>5月某日　10:12 PM</color>\n平日の夜、アーヤの部屋にて。"
  }
 ]
}
