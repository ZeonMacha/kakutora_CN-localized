{
    "dir": "chap19/daydra/dd_ch01_19_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "19156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "家族からのメール",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "来自家人的邮件"
    },
    "entry": [
        {
            "location": "468/SCENARIO",
            "narrator": "",
            "text": "家族からのメール",
            "zh": "来自家人的邮件",
            "narrator_zh": ""
        },
        {
            "location": "500/TALK",
            "narrator": "つばめ",
            "text": "…あっ。",
            "zh": "……啊。",
            "narrator_zh": "燕"
        },
        {
            "location": "505/TALK",
            "narrator": "キリト",
            "text": "なんだ、ＷＡＶＥか？",
            "zh": "怎么，来WAVE了吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "507/TALK",
            "narrator": "つばめ",
            "text": "うん、お父さんから。",
            "zh": "嗯，爸爸发来的。",
            "narrator_zh": "燕"
        },
        {
            "location": "509/TALK",
            "narrator": "雛",
            "text": "何て書いてあるの？",
            "zh": "上面写了什么呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "511/TALK",
            "narrator": "つばめ",
            "text": "えっと…、\n合宿とはいえ、自由時間に\n気を緩め過ぎていないか？",
            "zh": "那个……，\n虽说是合宿，自由时间\n有没有太松懈了？",
            "narrator_zh": "燕"
        },
        {
            "location": "512/TALK",
            "narrator": "つばめ",
            "text": "お友達のご家族に\n迷惑をかけていないか？",
            "zh": "有没有给朋友的家人\n添麻烦？",
            "narrator_zh": "燕"
        },
        {
            "location": "513/TALK",
            "narrator": "つばめ",
            "text": "夜遊びはしていないか？",
            "zh": "晚上有没有出去玩？",
            "narrator_zh": "燕"
        },
        {
            "location": "516/TALK",
            "narrator": "つばめ",
            "text": "…そんな感じかな。",
            "zh": "……大概就是这些吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "518/TALK",
            "narrator": "ヒカル",
            "text": "良いお父さんじゃない\nですか。",
            "zh": "这不是一位\n好爸爸吗。",
            "narrator_zh": "光"
        },
        {
            "location": "524/TALK",
            "narrator": "つばめ",
            "text": "うーん…ちょっと心配性\nだけどね…。",
            "zh": "嗯——……就是稍微有点\n爱操心就是了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "526/TALK",
            "narrator": "つばめ",
            "text": "そういえば、みんなも\n家の人から連絡来てるの？",
            "zh": "说起来，大家家里人\n也都会发消息过来吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "527/TALK",
            "narrator": "雛",
            "text": "うん、一応ねー。",
            "zh": "嗯，算是吧——。",
            "narrator_zh": "雏"
        },
        {
            "location": "529/TALK",
            "narrator": "キリト",
            "text": "俺のとこも来るけど…\n逢瀬、おまえの親父さんは\n一日何通送ってくる？",
            "zh": "我这边也会发来……\n逢濑，你爸一天\n给你发几条？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "530/TALK",
            "narrator": "つばめ",
            "text": "え？　一回だけど…。",
            "zh": "诶？ 一条呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "531/TALK",
            "narrator": "キリト",
            "text": "だったら、うちの親の方が\n心配性だな。",
            "zh": "那还是我爸妈\n更爱操心啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "533/TALK",
            "narrator": "雛",
            "text": "朝と夜に一回ずつ\n来るもんねー。",
            "zh": "早晚各发\n一次嘛——。",
            "narrator_zh": "雏"
        },
        {
            "location": "534/TALK",
            "narrator": "つばめ",
            "text": "えっ、二回も？",
            "zh": "诶，两次吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "536/TALK",
            "narrator": "雛",
            "text": "意外かもしれないけど、\nキリトの両親って\n超心配性なんだよ？",
            "zh": "可能挺让人意外的，\n圣翔的爸妈其实\n超级爱操心的哦？",
            "narrator_zh": "雏"
        },
        {
            "location": "540/TALK",
            "narrator": "キリト",
            "text": "ああ…普段だって、\n放課後にＷＡＶＥが\n送られてくるんだぜ？",
            "zh": "啊……平时也是，\n一放学就会给我发\nWAVE过来呢？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "541/TALK",
            "narrator": "キリト",
            "text": "今日は何時頃帰るんだ、\nとか、夕飯何が食べたい、\nとか、色々な。",
            "zh": "像是今天几点左右回来啦，\n晚饭想吃什么啦，\n各种各样的。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "544/TALK",
            "narrator": "ヒカル",
            "text": "そうだったんですか！？\nそれは知りませんでした。",
            "zh": "是这样的吗！？\n我还真不知道。",
            "narrator_zh": "光"
        },
        {
            "location": "547/TALK",
            "narrator": "キリト",
            "text": "まあ、大抵スタンプで\n返信するだけなんだけ\nどな。",
            "zh": "嘛，不过我一般也就\n回个表情包完事\n就是了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "549/TALK",
            "narrator": "つばめ",
            "text": "ちゃんと返信するんだ？\nわたし、面倒臭くて、\n無視することあるのに…。",
            "zh": "还会好好回复呀？\n我有时候嫌麻烦，\n直接无视掉呢……。",
            "narrator_zh": "燕"
        },
        {
            "location": "553/TALK",
            "narrator": "キリト",
            "text": "…まあ、正直俺もさ、\n超ウゼェ、って思うことは\nあるさ。",
            "zh": "……嘛，老实说我也有\n觉得超级烦人的时候\n啦。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "554/TALK",
            "narrator": "キリト",
            "text": "けど、人一倍心配性の\nクセに、俺のやりたいこと\n全部応援してくれるし――",
            "zh": "可是，明明比谁都爱操心，\n我想做的事情却全都\n支持我——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "555/TALK",
            "narrator": "キリト",
            "text": "養成科入る時だって、\n一言も文句言わなかった\n親だからさ。",
            "zh": "就连进培训科的时候，\n也是连一句抱怨都没说的\n父母啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "556/TALK",
            "narrator": "キリト",
            "text": "なんか、こう、無視したら\nいけねぇなぁ、って気に\nなっちまうんだよ…。",
            "zh": "就觉得，好像不能\n随随便便无视\n他们呀……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "558/TALK",
            "narrator": "つばめ",
            "text": "…そうなんだ。",
            "zh": "……原来如此。",
            "narrator_zh": "燕"
        },
        {
            "location": "560/TALK",
            "narrator": "つばめ",
            "text": "キリトくん、家族のことが\n大好きなんだね。",
            "zh": "圣翔，真的很喜欢\n自己的家人呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "563/TALK",
            "narrator": "キリト",
            "text": "ばっ！？\nそういうんじゃねぇって！",
            "zh": "笨！？\n才不是那样啊！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "565/TALK",
            "narrator": "雛",
            "text": "キリトは家族に対しては\nツンデレだからねー。",
            "zh": "圣翔对家人可是\n傲娇哦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "566/TALK",
            "narrator": "ヒカル",
            "text": "あはは、照れること\nないと思いますよ？",
            "zh": "啊哈哈，我觉得\n没必要害羞嘛？",
            "narrator_zh": "光"
        },
        {
            "location": "567/TALK",
            "narrator": "キリト",
            "text": "照れてねぇよ！",
            "zh": "才没害羞啊！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "569/TALK",
            "narrator": "キリト",
            "text": "ってか、そうだ！\n逢瀬はヒカルのＷＡＶＥ、\n見たことあるか？",
            "zh": "话说回来，对了！\n逢濑看过光的WAVE\n吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "570/TALK",
            "narrator": "つばめ",
            "text": "え？　ないけど…。",
            "zh": "诶？ 没看过呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "572/TALK",
            "narrator": "キリト",
            "text": "こいつの凄いんだよ。\nほら、見せてやれよ。",
            "zh": "这家伙的厉害着呢。\n喂，给她看看啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "573/TALK",
            "narrator": "つばめ",
            "text": "え、見ていいの？",
            "zh": "诶，可以看看吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "576/TALK",
            "narrator": "ヒカル",
            "text": "ええ、構いませんよ。\nどうぞ。",
            "zh": "嗯，不介意哦。\n请看吧。",
            "narrator_zh": "光"
        },
        {
            "location": "580/TALK",
            "narrator": "つばめ",
            "text": "…あ、あれ？\n何で、全部英語なの？",
            "zh": "……诶、咦？\n为什么，全是英语呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "584/TALK",
            "narrator": "キリト",
            "text": "そうなんだよ。\nこいつ、家族とは英語で\nやりとりしてんだよ。",
            "zh": "对吧。\n这家伙跟家人交流\n全是用英语呢。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "586/TALK",
            "narrator": "つばめ",
            "text": "えぇっ、そうなの！？",
            "zh": "诶诶，真的吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "588/TALK",
            "narrator": "ヒカル",
            "text": "逢瀬さんには言ってません\nでしたっけ？",
            "zh": "我没跟逢濑\n说过吗？",
            "narrator_zh": "光"
        },
        {
            "location": "589/TALK",
            "narrator": "ヒカル",
            "text": "うちは父と姉が\n英国人なんです。",
            "zh": "我家爸爸和姐姐\n是英国人。",
            "narrator_zh": "光"
        },
        {
            "location": "590/TALK",
            "narrator": "ヒカル",
            "text": "なので、日常会話は\n日本語で、ＷＡＶＥとか\nメモなどの――",
            "zh": "所以日常对话用日语，\n不过像WAVE或者\n便条这类——",
            "narrator_zh": "光"
        },
        {
            "location": "591/TALK",
            "narrator": "ヒカル",
            "text": "文字でやり取りをする\n場合には、英語を使う\n約束になっているんです。",
            "zh": "需要用文字交流的时候，\n家里约好了必须\n用英语。",
            "narrator_zh": "光"
        },
        {
            "location": "593/TALK",
            "narrator": "つばめ",
            "text": "それって、ヒカルくんが\n英語ができるように\nなるために、かな？",
            "zh": "那是为了让光\n能够学好英语，\n对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "597/TALK",
            "narrator": "ヒカル",
            "text": "だと思います。",
            "zh": "我想是的。",
            "narrator_zh": "光"
        },
        {
            "location": "600/TALK",
            "narrator": "キリト",
            "text": "ズルいよな？\nそんなことやってりゃ、\n英語の成績いいわけだぜ。",
            "zh": "真狡猾吧？\n天天这么练，\n英语成绩当然好啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "601/TALK",
            "narrator": "雛",
            "text": "ヒカルくんは英語以外の\n成績もいいけどねー。",
            "zh": "光英语以外的成绩\n也很好就是了——。",
            "narrator_zh": "雏"
        },
        {
            "location": "602/SEL",
            "narrator": "",
            "text": "つばめも真似すれば？",
            "zh": "燕也学一下呗？",
            "narrator_zh": ""
        },
        {
            "location": "603/SEL",
            "narrator": "",
            "text": "どんなお姉さんなんだろ？",
            "zh": "是什么样的姐姐呀？",
            "narrator_zh": ""
        },
        {
            "location": "604/SEL",
            "narrator": "",
            "text": "雛の親はどんな人？",
            "zh": "雏的父母是什么样的人？",
            "narrator_zh": ""
        },
        {
            "location": "606/TALK",
            "narrator": "つばめ",
            "text": "かっこいいなぁ…。",
            "zh": "好帅气呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "607/TALK",
            "narrator": "つばめ",
            "text": "会話は日本語だけど、\n文字でのやり取りは\n英語かぁ…。",
            "zh": "说话用日语，\n文字交流用英语\n呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "612/ACT",
            "narrator": "",
            "text": "つばめも真似すれば？",
            "zh": "燕也学一下呗？",
            "narrator_zh": ""
        },
        {
            "location": "632/TALK",
            "narrator": "つばめ",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "633/TALK",
            "narrator": "つばめ",
            "text": "そうしてみようかな、って思ってたんだ",
            "zh": "我正想着要不也试试这样呢",
            "narrator_zh": "燕"
        },
        {
            "location": "648/TALK",
            "narrator": "つばめ",
            "text": "…わたしも、真似して\nみようかな？",
            "zh": "……我也要不要\n学着试试看呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "650/TALK",
            "narrator": "雛",
            "text": "真似って…お父さんに\n英語で返信するの？",
            "zh": "学着……你要用英语\n给你爸回复吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "652/TALK",
            "narrator": "つばめ",
            "text": "うん。\n丁度返信しようと思ってた\nところだったし。",
            "zh": "嗯。\n正好我也正准备\n回复呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "657/TALK",
            "narrator": "つばめ",
            "text": "えっとぉ…スペルは確か、\nこうだったかな？",
            "zh": "那个……拼写记得\n应该是这样吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "658/TALK",
            "narrator": "つばめ",
            "text": "うん、送信！",
            "zh": "嗯，发送！",
            "narrator_zh": "燕"
        },
        {
            "location": "660/TALK",
            "narrator": "ヒカル",
            "text": "なんて書いたのか、\n聞いてもいいですか？",
            "zh": "能问问你\n写了什么吗？",
            "narrator_zh": "光"
        },
        {
            "location": "663/TALK",
            "narrator": "つばめ",
            "text": "「no problem」だよ。",
            "zh": "是“no problem”哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "666/TALK",
            "narrator": "キリト",
            "text": "おっ！？\n何かかっこいいな！",
            "zh": "哦！？\n还挺帅的嘛！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "669/TALK",
            "narrator": "雛",
            "text": "いやいや、どこの洋画の\n主役だよ！？",
            "zh": "不不不，你是哪部外国\n电影的主角啊！？",
            "narrator_zh": "雏"
        },
        {
            "location": "671/TALK",
            "narrator": "つばめ",
            "text": "でも、お父さんって\n英語できるのかな？",
            "zh": "不过，爸爸\n看得懂英语吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "673/TALK",
            "narrator": "雛",
            "text": "いやー、あれくらいなら\n読めなきゃマズい気が\nするけど…。",
            "zh": "不是吧——，那点程度\n要是都看不懂，\n感觉挺不妙的……。",
            "narrator_zh": "雏"
        },
        {
            "location": "679/TALK",
            "narrator": "つばめ",
            "text": "…あっ、お父さんから\n返信が――",
            "zh": "……啊，爸爸\n回复了——",
            "narrator_zh": "燕"
        },
        {
            "location": "680/TALK",
            "narrator": "つばめ",
            "text": "…あ、あれ？",
            "zh": "……咦、奇怪？",
            "narrator_zh": "燕"
        },
        {
            "location": "681/TALK",
            "narrator": "キリト",
            "text": "もしかして、\n怒らせちまったのか？",
            "zh": "该不会，\n惹他生气了吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "684/TALK",
            "narrator": "つばめ",
            "text": "え、えっと…。",
            "zh": "那、那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "687/TALK",
            "narrator": "つばめ",
            "text": "ヒカルくん、このメール\n翻訳してもらえる？",
            "zh": "光，能帮我翻译一下\n这封邮件吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "688/TALK",
            "narrator": "ヒカル",
            "text": "え…うわっ！\n全文英語じゃないですか。",
            "zh": "诶……哇啊！\n整篇全都是英语啊。",
            "narrator_zh": "光"
        },
        {
            "location": "689/TALK",
            "narrator": "雛",
            "text": "そっかぁ…\nあのメールに対して\nこう返してくるかぁ…。",
            "zh": "这样啊……\n对着那条消息，\n居然这样回过来呀……。",
            "narrator_zh": "雏"
        },
        {
            "location": "690/TALK",
            "narrator": "雛",
            "text": "つばめちゃんのお父さん、\nノリがいいね！",
            "zh": "燕的爸爸，\n真配合啊！",
            "narrator_zh": "雏"
        },
        {
            "location": "691/TALK",
            "narrator": "つばめ",
            "text": "全然そういうタイプの\n人じゃないんだけど…。",
            "zh": "他完全不是那种类型的\n人就是了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "693/TALK",
            "narrator": "ヒカル",
            "text": "えっと、色々書いて\nありましたが、\n要約すると――",
            "zh": "那个，里面写了\n好多，\n总结起来就是——",
            "narrator_zh": "光"
        },
        {
            "location": "694/TALK",
            "narrator": "ヒカル",
            "text": "ちゃんとした文章に\nして送ってきなさい、\nとのことです。",
            "zh": "让你写成正经句子\n再发过去，\n就是这个意思。",
            "narrator_zh": "光"
        },
        {
            "location": "695/TALK",
            "narrator": "キリト",
            "text": "親父さんの方が\n上手だったみたいだな。",
            "zh": "看来还是你爸\n棋高一着啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "699/TALK",
            "narrator": "つばめ",
            "text": "…何かわたし、メールや\nＷＡＶＥで怒られるの、\n結構多い気がするよ…。",
            "zh": "……总觉得我因为邮件或\nWAVE挨骂的次数，\n好像还挺多的呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "700/TALK",
            "narrator": "つばめ",
            "text": "っていうか、お父さんが\nこんなに英語できるなんて\n知らなかったなぁ…。",
            "zh": "话说回来，我都不知道\n爸爸的英语居然\n这么好……。",
            "narrator_zh": "燕"
        },
        {
            "location": "701/ACT",
            "narrator": "",
            "text": "どんなお姉さんなんだろ？",
            "zh": "是什么样的姐姐呀？",
            "narrator_zh": ""
        },
        {
            "location": "723/TALK",
            "narrator": "つばめ",
            "text": "うん、わたしも気になるから聞いてみるね",
            "zh": "嗯，我也挺好奇的，我去问问哦",
            "narrator_zh": "燕"
        },
        {
            "location": "736/TALK",
            "narrator": "つばめ",
            "text": "そういえば、ヒカルくんの\nお姉さんって、どんな人\nなの？",
            "zh": "说起来，光的姐姐\n是个什么样的\n人呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "738/TALK",
            "narrator": "ヒカル",
            "text": "姉ですか？",
            "zh": "我姐姐吗？",
            "narrator_zh": "光"
        },
        {
            "location": "741/TALK",
            "narrator": "キリト",
            "text": "そういや、俺達もまだ\n詳しく聞いたこと\nなかったな。",
            "zh": "这么一说，我们好像也\n还没详细问过\n这件事呢。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "742/TALK",
            "narrator": "雛",
            "text": "確か、年が離れてる、\nっていうのは前に\n聞いたかも？",
            "zh": "记得以前好像听说过，\n你们年纪相差\n挺大的？",
            "narrator_zh": "雏"
        },
        {
            "location": "744/TALK",
            "narrator": "ヒカル",
            "text": "はい、姉と僕は母親が\n違いまして――",
            "zh": "是的，我和姐姐\n母亲不同——",
            "narrator_zh": "光"
        },
        {
            "location": "745/TALK",
            "narrator": "ヒカル",
            "text": "言ってしまえば、\n姉は英国人の父の\n連れ子なんです。",
            "zh": "说白了，姐姐是我\n英国人爸爸带来的\n孩子。",
            "narrator_zh": "光"
        },
        {
            "location": "748/TALK",
            "narrator": "つばめ",
            "text": "あっ、そっか。",
            "zh": "啊，这样呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "749/TALK",
            "narrator": "つばめ",
            "text": "お父さんとお姉さんは\n英国人、ってさっき\n言ってたよね？",
            "zh": "刚才你确实说过\n爸爸和姐姐都是\n英国人呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "751/TALK",
            "narrator": "ヒカル",
            "text": "はい、そういうことです。",
            "zh": "对，就是这样。",
            "narrator_zh": "光"
        },
        {
            "location": "752/TALK",
            "narrator": "キリト",
            "text": "おまえの姉ちゃん、\n何やってる人なんだ？",
            "zh": "你姐姐她是\n做什么工作的？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "753/TALK",
            "narrator": "ヒカル",
            "text": "海外企業でコンサルタント\nとして働いているようなの\nですが――",
            "zh": "好像是在海外企业\n担任顾问的\n样子——",
            "narrator_zh": "光"
        },
        {
            "location": "754/TALK",
            "narrator": "ヒカル",
            "text": "僕も、詳しいことは\nよくわからないんです。",
            "zh": "具体情况，\n我也不太清楚。",
            "narrator_zh": "光"
        },
        {
            "location": "756/TALK",
            "narrator": "つばめ",
            "text": "どうして？",
            "zh": "为什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "757/TALK",
            "narrator": "ヒカル",
            "text": "…姉が家を出てからと\nいうもの、全然連絡を\nしてこないからです。",
            "zh": "……因为自从姐姐离家之后，\n就再也没主动\n联系过家里。",
            "narrator_zh": "光"
        },
        {
            "location": "758/TALK",
            "narrator": "キリト",
            "text": "そりゃ、海外企業で\nコンサルタントなんて\nやってりゃ――",
            "zh": "毕竟是在海外企业\n当顾问这种\n差事——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "761/TALK",
            "narrator": "キリト",
            "text": "忙しくて連絡する\n暇が無いんじゃねぇか？",
            "zh": "忙得没时间联系家里，\n也是正常的吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "762/TALK",
            "narrator": "ヒカル",
            "text": "…かもしれません。",
            "zh": "……或许吧。",
            "narrator_zh": "光"
        },
        {
            "location": "763/TALK",
            "narrator": "雛",
            "text": "ちょっと寂しいね。",
            "zh": "稍微有点寂寞呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "764/TALK",
            "narrator": "ヒカル",
            "text": "…はい。",
            "zh": "……嗯。",
            "narrator_zh": "光"
        },
        {
            "location": "766/TALK",
            "narrator": "ヒカル",
            "text": "…連絡の一つくらい、\nくれてもいいのに…。",
            "zh": "……好歹也发条消息\n过来嘛……。",
            "narrator_zh": "光"
        },
        {
            "location": "769/TALK",
            "narrator": "つばめ",
            "text": "…ヒカルくん、\nちょっと怒ってるみたい。",
            "zh": "……光，\n好像有点生气了。",
            "narrator_zh": "燕"
        },
        {
            "location": "770/TALK",
            "narrator": "つばめ",
            "text": "それだけ心配してる、\nってことかな？",
            "zh": "说明他有那么\n担心姐姐吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "771/ACT",
            "narrator": "",
            "text": "雛の親はどんな人？",
            "zh": "雏的父母是什么样的人？",
            "narrator_zh": ""
        },
        {
            "location": "793/TALK",
            "narrator": "つばめ",
            "text": "そういえば、まだ聞いたことなかったっけ？",
            "zh": "说起来，我是不是还没问过呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "794/TALK",
            "narrator": "つばめ",
            "text": "いい機会だし、聞いてみようかな",
            "zh": "机会难得，我去问问看好了",
            "narrator_zh": "燕"
        },
        {
            "location": "807/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃんの親って、\nどんな人なの？",
            "zh": "小雏的爸爸妈妈，\n是什么样的人呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "808/TALK",
            "narrator": "ヒカル",
            "text": "っ！？",
            "zh": "……！？",
            "narrator_zh": "光"
        },
        {
            "location": "811/TALK",
            "narrator": "キリト",
            "text": "ちょ、逢瀬！\nおまえそれ…！",
            "zh": "喂、逢濑！\n你这话……！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "814/TALK",
            "narrator": "つばめ",
            "text": "？",
            "zh": "？",
            "narrator_zh": "燕"
        },
        {
            "location": "815/TALK",
            "narrator": "雛",
            "text": "あ、そっかそっか。\nごめん、うっかりしてた！",
            "zh": "啊，对了。\n抱歉，我一时疏忽了！",
            "narrator_zh": "雏"
        },
        {
            "location": "818/TALK",
            "narrator": "雛",
            "text": "実はさー、ちょーっとだけ\n衝撃の事実！！　みたいに\nなっちゃいそうだけど――",
            "zh": "其实呀——，虽然听起来\n有点像“冲击性的事实！！”\n那样的感觉——",
            "narrator_zh": "雏"
        },
        {
            "location": "819/TALK",
            "narrator": "雛",
            "text": "うち、両親とも\n死んじゃってるん\nだよねー。",
            "zh": "我家嘛，爸妈两个\n都已经去世了\n哦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "821/TALK",
            "narrator": "つばめ",
            "text": "…えっ？",
            "zh": "……诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "822/TALK",
            "narrator": "雛",
            "text": "死んじゃってるの。",
            "zh": "已经不在了哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "824/TALK",
            "narrator": "つばめ",
            "text": "…えぇっ！？",
            "zh": "……诶诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "827/TALK",
            "narrator": "つばめ",
            "text": "ご、ごめん！\nごめんなさい！",
            "zh": "对、对不起！\n真的很抱歉！",
            "narrator_zh": "燕"
        },
        {
            "location": "828/TALK",
            "narrator": "つばめ",
            "text": "わたし知らなくて、\nそれでつい――",
            "zh": "我完全不知道，\n结果一不小心就——",
            "narrator_zh": "燕"
        },
        {
            "location": "829/TALK",
            "narrator": "雛",
            "text": "いやいやいや、そんなに\n謝らなくていいって。",
            "zh": "不不不，不用这样\n一直道歉啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "830/TALK",
            "narrator": "雛",
            "text": "あたしもついうっかり\nして、つばめちゃんに\n話すの忘れてたよ。",
            "zh": "我自己也疏忽了，\n忘了跟燕\n提过这事。",
            "narrator_zh": "雏"
        },
        {
            "location": "834/TALK",
            "narrator": "キリト",
            "text": "ってか、そんな話する\nタイミングなかっただろ？",
            "zh": "说到底，也没找到过\n聊这种话题的时机吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "837/TALK",
            "narrator": "雛",
            "text": "だよねー。\n本当この手の話って、\nするタイミング難しいし。",
            "zh": "是呀——。\n真的，这种事还挺难\n找时机开口的。",
            "narrator_zh": "雏"
        },
        {
            "location": "839/TALK",
            "narrator": "雛",
            "text": "つまり、話してないん\nだからつばめちゃんが\n知らないのは当然なの。",
            "zh": "也就是说，既然没聊过，\n那燕不知道\n也是理所当然的。",
            "narrator_zh": "雏"
        },
        {
            "location": "840/TALK",
            "narrator": "雛",
            "text": "だから謝る必要は\n一切ナッシング！\nオッケー？",
            "zh": "所以道歉什么的\n完全Nothing！\nOK？",
            "narrator_zh": "雏"
        },
        {
            "location": "844/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "848/TALK",
            "narrator": "つばめ",
            "text": "うん…。",
            "zh": "嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "850/TALK",
            "narrator": "雛",
            "text": "うん、わかってもらえて\nよかった。",
            "zh": "嗯，你能听进去\n太好了。",
            "narrator_zh": "雏"
        },
        {
            "location": "851/TALK",
            "narrator": "雛",
            "text": "ちなみにだけど、あたしに\nＷＡＶＥ送って来るのは、\nあたしのお兄ちゃんだよ。",
            "zh": "顺便一提，给我发\nWAVE过来的，\n是我的哥哥哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "852/TALK",
            "narrator": "雛",
            "text": "「美味いもん食ってる？」\n「土産はいらんから」",
            "zh": "“有好好吃好吃的吗？”\n“伴手礼就免了”",
            "narrator_zh": "雏"
        },
        {
            "location": "853/TALK",
            "narrator": "雛",
            "text": "みたいな内容のばっかり\nだけどね。",
            "zh": "虽说发来的尽是\n这种内容就是了。",
            "narrator_zh": "雏"
        },
        {
            "location": "855/TALK",
            "narrator": "ヒカル",
            "text": "…でも、毎日ちゃんと\n送ってくれるんですね。",
            "zh": "……不过，每天都会\n好好发给你呢。",
            "narrator_zh": "光"
        },
        {
            "location": "858/TALK",
            "narrator": "雛",
            "text": "まあ、仲良し兄弟なんで！",
            "zh": "嘛，毕竟是感情很好的兄妹！",
            "narrator_zh": "雏"
        },
        {
            "location": "861/TALK",
            "narrator": "つばめ",
            "text": "そっか…。\n良いお兄さんなんだね。",
            "zh": "这样啊……。\n真是个好哥哥呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "864/TALK",
            "narrator": "雛",
            "text": "うーん…。",
            "zh": "嗯——……。",
            "narrator_zh": "雏"
        },
        {
            "location": "867/TALK",
            "narrator": "雛",
            "text": "えへへ…まあねー。",
            "zh": "诶嘿嘿……算是吧——。",
            "narrator_zh": "雏"
        },
        {
            "location": "870/TALK",
            "narrator": "つばめ",
            "text": "…ひなこちゃん、\nご両親いないんだ…。",
            "zh": "……小雏，\n父母已经不在了呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "871/TALK",
            "narrator": "つばめ",
            "text": "出会ってから何カ月も\n経つのに――",
            "zh": "从认识到现在\n都过去好几个月了——",
            "narrator_zh": "燕"
        },
        {
            "location": "873/TALK",
            "narrator": "つばめ",
            "text": "まだまだ知らないこと、\n沢山あるんだなぁ…。",
            "zh": "我不知道的事情，\n还有这么多呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "496/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月19日　 8:43 PM</color>\n合宿中の夜、みやびの実家にて",
            "zh": "<color=green>8月19日　 8:43 PM</color>\n合宿中的夜晚，雅的老家",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
