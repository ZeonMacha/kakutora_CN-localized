{
    "dir": "chap00/daydra/spev_ch03_012.js",
    "type": "",
    "info": {
        "story_id": "3012",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "雪女、あたためますか",
        "title_zh": "特别篇",
        "sub_title_zh": "雪女，要不要暖一暖"
    },
    "entry": [
        {
            "location": "22/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…逃がさない。",
            "zh": "……不会放你跑的。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "23/TALK",
            "narrator": "透明ガブリエラ",
            "text": "絶対に、あんたを\n帰したりしないわ。",
            "zh": "我绝对不会\n让你回去的。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "30/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あたしを置いて、\n山を下りるなんて…。",
            "zh": "居然想丢下我\n一个人下山……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そんなの、\n絶対に許さない。",
            "zh": "这种事，\n绝对不饶你。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "32/SEL",
            "narrator": "（選択肢）",
            "text": "雪女！？",
            "zh": "雪女！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "33/ACT",
            "narrator": "",
            "text": "雪女！？",
            "zh": "雪女！？",
            "narrator_zh": ""
        },
        {
            "location": "35/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…ええ、そうよ。",
            "zh": "……对，没错。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あたしはこの山に住む、\nたった一人の雪女…。",
            "zh": "我是住在这座山里的，\n唯一一个雪女……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "透明ガブリエラ",
            "text": "だからあんたも、\nこの山から帰したりは\nしないわ。",
            "zh": "所以我也绝不会\n放你从这座山里\n回去。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "38/SEL",
            "narrator": "（選択肢）",
            "text": "$me$をどうするつもりだ！？",
            "zh": "你打算把$me$怎么样！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "39/ACT",
            "narrator": "",
            "text": "$me$をどうするつもりだ！？",
            "zh": "你打算把$me$怎么样！？",
            "narrator_zh": ""
        },
        {
            "location": "41/TALK",
            "narrator": "透明ガブリエラ",
            "text": "もう二度と、あたしを\n一人にしようと思えない\nようにするわ。",
            "zh": "我要让你再也\n不敢起把我一个人\n丢在这里的念头。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "透明ガブリエラ",
            "text": "今まであたしを置いて\n山を下りようとした\n奴らと同じように…。",
            "zh": "就跟以前那些\n想丢下我下山的\n家伙们一样……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "43/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あんたも、カチカチの\n氷に閉じ込める！",
            "zh": "把你也封进硬邦邦的\n坚冰里面！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "44/SEL",
            "narrator": "（選択肢）",
            "text": "死んじゃうよ！！",
            "zh": "会死掉的啊！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "45/SEL",
            "narrator": "（選択肢）",
            "text": "とっても寒そうだ",
            "zh": "听起来好冷啊",
            "narrator_zh": "（选项）"
        },
        {
            "location": "46/ACT",
            "narrator": "",
            "text": "死んじゃうよ！！",
            "zh": "会死掉的啊！！",
            "narrator_zh": ""
        },
        {
            "location": "49/TALK",
            "narrator": "透明ガブリエラ",
            "text": "え…、もしかして\n通じてなかった？",
            "zh": "诶……难道说\n你刚才没听懂吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "50/TALK",
            "narrator": "透明ガブリエラ",
            "text": "氷に閉じ込めるってのは\n殺すってことだったん\nだけど…。",
            "zh": "封进冰里就是\n要了你的命的\n意思啊……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…意外と鈍感なのね？",
            "zh": "……你还挺迟钝的嘛？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "52/ACT",
            "narrator": "",
            "text": "死んじゃうよ！！",
            "zh": "会死掉的啊！！",
            "narrator_zh": ""
        },
        {
            "location": "54/TALK",
            "narrator": "透明ガブリエラ",
            "text": "大丈夫よ。\n無闇に苦しめるような\nことは好きじゃないから。",
            "zh": "放心吧。\n我可不喜欢平白无故\n折磨别人那一套。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "透明ガブリエラ",
            "text": "一瞬でカチコチにして\nあげるから、苦しんだりは\nしないはずよ。",
            "zh": "我会一瞬间把你\n冻得硬邦邦的，\n应该不会觉得痛苦的。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "59/TALK",
            "narrator": "透明ガブリエラ",
            "text": "だから、安心して\n凍りづけになっちゃい\nなさい。",
            "zh": "所以，你就放心地\n变成冰雕\n吧。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "透明ガブリエラ",
            "text": "それじゃ…いくわよ！",
            "zh": "那么……我要动手了哦！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "62/SEL",
            "narrator": "（選択肢）",
            "text": "なんでこんなことするの？",
            "zh": "为什么要做这种事？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "63/ACT",
            "narrator": "",
            "text": "なんでこんなことするの？",
            "zh": "为什么要做这种事？",
            "narrator_zh": ""
        },
        {
            "location": "66/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あんたが山を下りようと\nするからよ。",
            "zh": "还不是因为\n你想要下山。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "透明ガブリエラ",
            "text": "みんなと同じで、\nあたしをまた一人だけ\nここに残して…。",
            "zh": "跟大家一样，\n又要把我孤零零地\n留在这里……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "透明ガブリエラ",
            "text": "だから、あんたのことも\n氷付けにするの。",
            "zh": "所以，我也只能\n把你冻成冰块了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "69/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そして、他のみんなと\n一緒に保管するわ。",
            "zh": "然后，把你和其他人\n一起好好存放在这里。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そうすれば、あたしは\n独りぼっちじゃないから。",
            "zh": "这样一来，我就不算\n孤零零一个人了嘛。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "71/SEL",
            "narrator": "（選択肢）",
            "text": "意味がないよ、そんなの",
            "zh": "那种事根本没有意义",
            "narrator_zh": "（选项）"
        },
        {
            "location": "72/SEL",
            "narrator": "（選択肢）",
            "text": "それで満足するの？",
            "zh": "那样你就能满足吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "73/ACT",
            "narrator": "",
            "text": "意味がないよ、そんなの",
            "zh": "那种事根本没有意义",
            "narrator_zh": ""
        },
        {
            "location": "75/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ふん、なによそれ？\nそういえばあたしの\n考えが変わると思った？",
            "zh": "哼，你那是什么态度？\n以为这么说就能让我\n改变主意吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "透明ガブリエラ",
            "text": "だとしたら無駄よ。\n今更命乞いしたって\n遅いんだから。",
            "zh": "要是那么想就白费力气了。\n事到如今再求饶\n也已经晚了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "77/ACT",
            "narrator": "",
            "text": "それで満足するの？",
            "zh": "那样你就能满足吗？",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "透明ガブリエラ",
            "text": "当然でしょ。\nそんなこと聞いて、\n時間稼ぎのつもり？",
            "zh": "那当然了。\n问这种话，\n是想拖延时间吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "80/SEL",
            "narrator": "（選択肢）",
            "text": "何人氷付けにしても解決しないよ",
            "zh": "不管把多少人冻成冰块都解决不了问题",
            "narrator_zh": "（选项）"
        },
        {
            "location": "81/ACT",
            "narrator": "",
            "text": "何人氷付けにしても解決しないよ",
            "zh": "不管把多少人冻成冰块都解决不了问题",
            "narrator_zh": ""
        },
        {
            "location": "84/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…そ、そんなの、\nわからないじゃない！",
            "zh": "……那、那种事，\n不试试看怎么知道啊！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "85/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あんたが増えたら、\nもしかしたら寂しくは\nなくなるかもしれない。",
            "zh": "多了你的话，\n说不定我就不会\n觉得寂寞了呀。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "透明ガブリエラ",
            "text": "もう、独りぼっちって\n思わなくてすむように\nなるかもしれないでしょ？",
            "zh": "说不定，就再也不用\n觉得自己是孤零零\n一个人了吧？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "87/SEL",
            "narrator": "（選択肢）",
            "text": "本気でそう思ってるわけ？",
            "zh": "你是真心这么觉得的吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "88/ACT",
            "narrator": "",
            "text": "本気でそう思ってるわけ？",
            "zh": "你是真心这么觉得的吗？",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "透明ガブリエラ",
            "text": "それは…。",
            "zh": "这个嘛……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "91/SEL",
            "narrator": "（選択肢）",
            "text": "そんなの、一緒にいるとは言えない",
            "zh": "那种样子，根本算不上陪在一起",
            "narrator_zh": "（选项）"
        },
        {
            "location": "92/ACT",
            "narrator": "",
            "text": "そんなの、一緒にいるとは言えない",
            "zh": "那种样子，根本算不上陪在一起",
            "narrator_zh": ""
        },
        {
            "location": "94/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…でも――",
            "zh": "……可是——",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "透明ガブリエラ",
            "text": "仕方ないじゃない！",
            "zh": "那也没办法啊！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "96/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あたしは雪女で、\nあんたは人間なんだから！",
            "zh": "我是雪女，\n而你是人类嘛！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "透明ガブリエラ",
            "text": "こうでもしないと、\nあんたは一緒にいては\nくれないでしょ！？",
            "zh": "我不这么做的话，\n你根本就不会愿意\n留下来陪我吧！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "98/SEL",
            "narrator": "（選択肢）",
            "text": "こんなやり方じゃ当然だ",
            "zh": "用这种办法那当然不会留",
            "narrator_zh": "（选项）"
        },
        {
            "location": "99/SEL",
            "narrator": "（選択肢）",
            "text": "雪女と人間は住む世界が違う",
            "zh": "雪女和人类本来就不是同一个世界",
            "narrator_zh": "（选项）"
        },
        {
            "location": "100/ACT",
            "narrator": "",
            "text": "こんなやり方じゃ当然だ",
            "zh": "用这种办法那当然不会留",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "透明ガブリエラ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "透明ガブリエラ",
            "text": "じゃ、じゃあ…あんたは\nあたしみたいな雪女と、\n一緒にいてくれるの？",
            "zh": "那、那你的意思是……\n你愿意和像我这样的\n雪女待在一起吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "透明ガブリエラ",
            "text": "家に帰りたいとか、\nもう言わない？",
            "zh": "不会再吵着说\n要回家了？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "107/SEL",
            "narrator": "（選択肢）",
            "text": "絶対戻ってくるよ",
            "zh": "我一定会回来的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "108/SEL",
            "narrator": "（選択肢）",
            "text": "いや、帰れないのは困る",
            "zh": "不，回不去可不行",
            "narrator_zh": "（选项）"
        },
        {
            "location": "109/ACT",
            "narrator": "",
            "text": "絶対戻ってくるよ",
            "zh": "我一定会回来的",
            "narrator_zh": ""
        },
        {
            "location": "111/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ウソ！\nそんなこと言って、\nどうせ――",
            "zh": "骗人！\n嘴上这么说，\n反正——",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "112/SEL",
            "narrator": "（選択肢）",
            "text": "人を信じられなければ一生孤独のままだ",
            "zh": "如果不愿相信别人，一辈子都会孤单下去",
            "narrator_zh": "（选项）"
        },
        {
            "location": "113/ACT",
            "narrator": "",
            "text": "人を信じられなければ一生孤独のままだ",
            "zh": "如果不愿相信别人，一辈子都会孤单下去",
            "narrator_zh": ""
        },
        {
            "location": "116/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…でも、もし信じて、\n裏切られたらって\n思うと…。",
            "zh": "……可是，一想到万一\n相信了，结果却被\n背叛的话……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "透明ガブリエラ",
            "text": "不安でたまらないの！\nもう、寂しい想いは\nしたくないのよ！",
            "zh": "我就不安得受不了啊！\n我不想再尝那种\n寂寞的滋味了！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "118/SEL",
            "narrator": "（選択肢）",
            "text": "$me$はそんな想いさせない",
            "zh": "$me$不会让你有那种感受的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "119/ACT",
            "narrator": "",
            "text": "$me$はそんな想いさせない",
            "zh": "$me$不会让你有那种感受的",
            "narrator_zh": ""
        },
        {
            "location": "121/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "122/SEL",
            "narrator": "（選択肢）",
            "text": "もっと君のことを知りたいから",
            "zh": "因为我想更了解你",
            "narrator_zh": "（选项）"
        },
        {
            "location": "123/SEL",
            "narrator": "（選択肢）",
            "text": "だから家に帰して",
            "zh": "所以让我回家吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "124/ACT",
            "narrator": "",
            "text": "もっと君のことを知りたいから",
            "zh": "因为我想更了解你",
            "narrator_zh": ""
        },
        {
            "location": "126/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…あたしも。",
            "zh": "……我也是。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あんたと沢山話して、\n沢山、色んなことを\n知りたい…。",
            "zh": "我也想和你多聊聊天，\n多了解关于你的\n各种各样的事……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…わかった。\n山を下りて、家に帰っても\nいいわ…。",
            "zh": "……我知道了。\n你可以下山回家\n了……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "130/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あんたのこと知る前に、\n氷付けにしちゃいたく\nないから…。",
            "zh": "因为在了解你之前，\n我还不想把你\n冻成冰块……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "131/SEL",
            "narrator": "（選択肢）",
            "text": "$me$はそんな想いさせない",
            "zh": "$me$不会让你有那种感受的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "132/ACT",
            "narrator": "",
            "text": "$me$はそんな想いさせない",
            "zh": "$me$不会让你有那种感受的",
            "narrator_zh": ""
        },
        {
            "location": "134/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…信じるわ。",
            "zh": "……我信你。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "135/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あたしは、あんたを\n氷付けにしようとした\nっていうのに…。",
            "zh": "明明我刚才\n还差点要把你\n冻成冰块……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そんな風に言ってくれる\nあんたを…あたしも、\n信じたいから…。",
            "zh": "可对能说出那种话的你……\n我也想要试着\n去相信……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "137/TALK",
            "narrator": "透明ガブリエラ",
            "text": "絶対、またこの山に\n帰ってきてね…。",
            "zh": "你一定要再回到\n这座山上来哦……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "138/TALK",
            "narrator": "透明ガブリエラ",
            "text": "その時は――",
            "zh": "到那个时候——",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "透明ガブリエラ",
            "text": "吹雪が止むまで、\n沢山、あなたのお話\n聞かせてね…。",
            "zh": "在暴风雪停歇之前，\n多跟我讲讲\n你的故事吧……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "145/ACT",
            "narrator": "",
            "text": "だから家に帰して",
            "zh": "所以让我回家吧",
            "narrator_zh": ""
        },
        {
            "location": "147/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…ダメ。",
            "zh": "……不行。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "148/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あんたの言葉は、\n信じられない！",
            "zh": "你的话，\n我可信不过！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "151/ACT",
            "narrator": "",
            "text": "いや、帰れないのは困る",
            "zh": "不，回不去可不行",
            "narrator_zh": ""
        },
        {
            "location": "153/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…なによそれ？",
            "zh": "……那算什么呀？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "透明ガブリエラ",
            "text": "結局、あんたは家に\n帰りたいだけじゃない！",
            "zh": "说到底，你不就是\n光想着回家而已吗！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "157/ACT",
            "narrator": "",
            "text": "雪女と人間は住む世界が違う",
            "zh": "雪女和人类本来就不是同一个世界",
            "narrator_zh": ""
        },
        {
            "location": "160/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…そうよね。",
            "zh": "……也是呢。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "161/TALK",
            "narrator": "透明ガブリエラ",
            "text": "結局、そういうこと\nなのよね…。",
            "zh": "归根结底，\n就是这么回事呢……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "透明ガブリエラ",
            "text": "やっぱり、あんたには\nここで凍り付けになって\nもらう。",
            "zh": "看来还是得让你\n在这里变成冰雕\n才行。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "166/TALK",
            "narrator": "透明ガブリエラ",
            "text": "大丈夫よ、痛くないし、\n苦しくもないから…。",
            "zh": "放心吧，既不会疼，\n也不会难受……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "透明ガブリエラ",
            "text": "さあ、目をつむって…。\nゆっくり、穏やかに\nおやすみなさい…。",
            "zh": "来，闭上眼睛……\n安安静静地，\n好好睡吧……",
            "narrator_zh": "透明加布里埃拉"
        }
    ]
}
