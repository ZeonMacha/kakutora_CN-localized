{
    "dir": "chap15/daydra/dd_ch04_15_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "15405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "適正な役割分担とは＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "何谓合理的分工＜后篇＞"
    },
    "entry": [
        {
            "location": "586/SCENARIO",
            "narrator": "",
            "text": "偶然の出会い",
            "zh": "偶然的相遇",
            "narrator_zh": ""
        },
        {
            "location": "603/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "607/TALK",
            "narrator": "みやび",
            "text": "まほさん、\n一つお願いがあるが\nですよ。",
            "zh": "真幌，\n我有一个请求\n要提咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "608/TALK",
            "narrator": "みやび",
            "text": "うち、後方援護に\n回りますき、\n残りたいがですよ。",
            "zh": "我想转到后方\n支援去，所以想\n留下来咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "609/TALK",
            "narrator": "透明真幌",
            "text": "後方援護だと？",
            "zh": "后方支援？",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "610/TALK",
            "narrator": "みやび",
            "text": "今回の世界は、\nアプリゲームの世界\n言うてましたよね？",
            "zh": "这次的世界，\n你说过是App游戏\n的世界吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "612/TALK",
            "narrator": "みやび",
            "text": "なら、プログラムを\n改変してこちらに\n有利な状況を――",
            "zh": "那样的话，改写\n程序制造对我方\n有利的状况——",
            "narrator_zh": "雅"
        },
        {
            "location": "613/TALK",
            "narrator": "みやび",
            "text": "作りだすことも\nできると思うが\nですよ。",
            "zh": "我觉得那种事\n也是做得到\n的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "614/TALK",
            "narrator": "透明真幌",
            "text": "…現場に行って\n作業することは\nできないのか？",
            "zh": "…就不能到现场\n去作业\n吗？",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "615/TALK",
            "narrator": "みやび",
            "text": "内部からだと、\n改変できん可能性が\nあります。",
            "zh": "要是进了里面，\n就有可能\n没法改写。",
            "narrator_zh": "雅"
        },
        {
            "location": "616/TALK",
            "narrator": "みやび",
            "text": "それと、指令室の\nマシンの方がパワーが\n上やき――",
            "zh": "还有，指令室的\n机器算力更强\n嘛——",
            "narrator_zh": "雅"
        },
        {
            "location": "617/TALK",
            "narrator": "みやび",
            "text": "改変作業に重視する\nなら、残った方が\n効率えいがですよ。",
            "zh": "要是重视改写\n作业的话，留下\n效率更好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "618/TALK",
            "narrator": "透明真幌",
            "text": "なるほど…。",
            "zh": "原来如此……。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "619/TALK",
            "narrator": "みやび",
            "text": "どうですか？",
            "zh": "怎么样？",
            "narrator_zh": "雅"
        },
        {
            "location": "620/TALK",
            "narrator": "透明真幌",
            "text": "…いい判断だ。\nでは、みやびは残り\n後方援護を頼む。",
            "zh": "…不错的判断。\n那么，雅留下，\n后方支援就拜托了。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "621/TALK",
            "narrator": "みやび",
            "text": "了解です。",
            "zh": "明白。",
            "narrator_zh": "雅"
        },
        {
            "location": "627/TALK",
            "narrator": "みやび",
            "text": "…ちゅうわけやき、\n光月さんのアイデア、\n使わせてもらうぞね。",
            "zh": "…就是这么回事嘛，\n光月的点子，\n就借来用用咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "629/TALK",
            "narrator": "みやび",
            "text": "まっこと助かった。\nありがとう。",
            "zh": "算帮了大忙。\n谢谢。",
            "narrator_zh": "雅"
        },
        {
            "location": "630/TALK",
            "narrator": "繭",
            "text": "い、いえ…、\nお力になれたなら\n光栄です。",
            "zh": "不、不…，\n能帮上忙的话\n是我的荣幸。",
            "narrator_zh": "茧"
        },
        {
            "location": "632/TALK",
            "narrator": "繭",
            "text": "…それと、もし私の\n思い付きを採用される\nのでしたら――",
            "zh": "…还有，如果我的\n灵机一动\n被采用的话——",
            "narrator_zh": "茧"
        },
        {
            "location": "633/TALK",
            "narrator": "繭",
            "text": "一つ、お願いが\nあるのですが…。",
            "zh": "我有一个\n小小的请求……。",
            "narrator_zh": "茧"
        },
        {
            "location": "635/TALK",
            "narrator": "みやび",
            "text": "缶ジュースか？\nそれともチュウか？",
            "zh": "要罐装果汁？\n还是亲亲？",
            "narrator_zh": "雅"
        },
        {
            "location": "637/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "640/TALK",
            "narrator": "繭",
            "text": "………………。",
            "zh": "………………。",
            "narrator_zh": "茧"
        },
        {
            "location": "642/TALK",
            "narrator": "繭",
            "text": "……………………。",
            "zh": "……………………。",
            "narrator_zh": "茧"
        },
        {
            "location": "645/TALK",
            "narrator": "繭",
            "text": "…いえ…どちらでも\nなくて…。",
            "zh": "…不…都不是\n……。",
            "narrator_zh": "茧"
        },
        {
            "location": "646/TALK",
            "narrator": "繭",
            "text": "みやび先輩の、\n作業のお手伝いを\nさせてほしいんです。",
            "zh": "我想请雅前辈\n让我帮忙一起\n做那份工作。",
            "narrator_zh": "茧"
        },
        {
            "location": "647/TALK",
            "narrator": "みやび",
            "text": "手伝ってくれるが？",
            "zh": "肯帮我啊？",
            "narrator_zh": "雅"
        },
        {
            "location": "648/TALK",
            "narrator": "繭",
            "text": "はい…とはいっても、\n簡単な作業程度しか\nお力になれませんが。",
            "zh": "是…话虽如此，\n我也只能帮上\n简单工作的忙。",
            "narrator_zh": "茧"
        },
        {
            "location": "650/TALK",
            "narrator": "みやび",
            "text": "いや、正直手伝いが\nおるんは助かる。",
            "zh": "不，说实话\n有帮手在，就省心多了。",
            "narrator_zh": "雅"
        },
        {
            "location": "652/TALK",
            "narrator": "みやび",
            "text": "それに、光月さんの\nプログラムセンスは\n中々やき――",
            "zh": "再说，光月的\n程序品味\n算不赖嘛——",
            "narrator_zh": "雅"
        },
        {
            "location": "653/TALK",
            "narrator": "みやび",
            "text": "ハッカー修行にも\n丁度えいかもしれん。",
            "zh": "用来修行黑客\n说不定也刚好得。",
            "narrator_zh": "雅"
        },
        {
            "location": "654/TALK",
            "narrator": "みやび",
            "text": "準備ができ次第\n連絡するきね。",
            "zh": "准备好之后\n就联系你啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "656/TALK",
            "narrator": "繭",
            "text": "お待ちしております。",
            "zh": "我恭候通知。",
            "narrator_zh": "茧"
        },
        {
            "location": "657/TALK",
            "narrator": "みやび",
            "text": "ん、それじゃ…。",
            "zh": "嗯，那么……",
            "narrator_zh": "雅"
        },
        {
            "location": "661/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "662/TALK",
            "narrator": "繭",
            "text": "ごめんなさい、\nみやび先輩…。",
            "zh": "对不起，\n雅前辈……。",
            "narrator_zh": "茧"
        },
        {
            "location": "663/TALK",
            "narrator": "繭",
            "text": "私は…、あなたの\nことを利用して\nしまいました…。",
            "zh": "我……把你\n给利用了\n……。",
            "narrator_zh": "茧"
        },
        {
            "location": "664/TALK",
            "narrator": "繭",
            "text": "でも、プログラムの\n奥深くまで潜れさえ\nすれば――",
            "zh": "但是，只要能潜入\n程序深处\n的话——",
            "narrator_zh": "茧"
        },
        {
            "location": "665/TALK",
            "narrator": "繭",
            "text": "きっと、どこかに\nバックドアがある\nはず。",
            "zh": "肯定在什么地方\n有后门\n才对。",
            "narrator_zh": "茧"
        },
        {
            "location": "666/TALK",
            "narrator": "繭",
            "text": "それさえ見つけて、\n開けることさえ\nできれば――",
            "zh": "只要找到它，\n只要能打开\n的话——",
            "narrator_zh": "茧"
        },
        {
            "location": "667/TALK",
            "narrator": "繭",
            "text": "フェノメノンの\n絡繰りが、何かしら\nわかるかもしれない。",
            "zh": "PhenoMENON的\n机关，说不定\n就能知道点什么。",
            "narrator_zh": "茧"
        },
        {
            "location": "668/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "669/TALK",
            "narrator": "繭",
            "text": "今は、少しでも\n情報を集めることが\n最優先…。",
            "zh": "现在，多收集\n一点情报才是\n最优先……。",
            "narrator_zh": "茧"
        },
        {
            "location": "670/TALK",
            "narrator": "繭",
            "text": "ＦａｔａｌＱｕｅｅｎ\nと共に、管理庁の\n謎を解くためにも。",
            "zh": "也为了和\nＦａｔａｌＱｕｅｅｎ一起，\n解开管理厅之谜。",
            "narrator_zh": "茧"
        },
        {
            "location": "671/TALK",
            "narrator": "繭",
            "text": "だから――",
            "zh": "所以——",
            "narrator_zh": "茧"
        },
        {
            "location": "672/TALK",
            "narrator": "繭",
            "text": "許してください、\nみやび先輩…。",
            "zh": "请原谅我，\n雅前辈……。",
            "narrator_zh": "茧"
        },
        {
            "location": "700/TALK",
            "narrator": "みやび",
            "text": "聞いてたか相棒？",
            "zh": "听到了吗搭档？",
            "narrator_zh": "雅"
        },
        {
            "location": "701/TALK",
            "narrator": "みやび",
            "text": "さっきの光月さんの案",
            "zh": "刚才光月那个方案",
            "narrator_zh": "雅"
        },
        {
            "location": "702/TALK",
            "narrator": "みやび",
            "text": "まっこと凄いと思わん？",
            "zh": "是不是蛮厉害的？",
            "narrator_zh": "雅"
        },
        {
            "location": "704/SEL",
            "narrator": "",
            "text": "嬉しそうだね",
            "zh": "看起来很开心呢",
            "narrator_zh": ""
        },
        {
            "location": "705/ACT",
            "narrator": "",
            "text": "嬉しそうだね",
            "zh": "看起来很开心呢",
            "narrator_zh": ""
        },
        {
            "location": "707/TALK",
            "narrator": "みやび",
            "text": "嬉しさエクスプロージョン",
            "zh": "开心大爆炸",
            "narrator_zh": "雅"
        },
        {
            "location": "709/TALK",
            "narrator": "みやび",
            "text": "フェノメノンをハッキングして",
            "zh": "黑进PhenoMENON",
            "narrator_zh": "雅"
        },
        {
            "location": "710/TALK",
            "narrator": "みやび",
            "text": "改変するとか",
            "zh": "然后改写什么的",
            "narrator_zh": "雅"
        },
        {
            "location": "711/TALK",
            "narrator": "みやび",
            "text": "思い付きにしても凄い",
            "zh": "就算是一时兴起也够厉害",
            "narrator_zh": "雅"
        },
        {
            "location": "712/TALK",
            "narrator": "みやび",
            "text": "ああいう閃きこそ",
            "zh": "那种灵光一闪才正是",
            "narrator_zh": "雅"
        },
        {
            "location": "713/TALK",
            "narrator": "みやび",
            "text": "ハッカーに大切なセンスなのである",
            "zh": "黑客必不可少的重要品味",
            "narrator_zh": "雅"
        },
        {
            "location": "715/SEL",
            "narrator": "",
            "text": "繭にはハッカーのセンスあり？",
            "zh": "茧有黑客的天分吗？",
            "narrator_zh": ""
        },
        {
            "location": "716/ACT",
            "narrator": "",
            "text": "繭にはハッカーのセンスあり？",
            "zh": "茧有黑客的天分吗？",
            "narrator_zh": ""
        },
        {
            "location": "718/TALK",
            "narrator": "みやび",
            "text": "大ありやね",
            "zh": "多得很咯",
            "narrator_zh": "雅"
        },
        {
            "location": "719/TALK",
            "narrator": "みやび",
            "text": "ちゅうか",
            "zh": "话说",
            "narrator_zh": "雅"
        },
        {
            "location": "720/TALK",
            "narrator": "みやび",
            "text": "前々からそう思ってはいた",
            "zh": "我以前就那么想了",
            "narrator_zh": "雅"
        },
        {
            "location": "721/TALK",
            "narrator": "みやび",
            "text": "発言やコードの組み方を見ればわかる",
            "zh": "看她的发言和代码的组织方式就知道",
            "narrator_zh": "雅"
        },
        {
            "location": "722/TALK",
            "narrator": "みやび",
            "text": "ただ者じゃない感半端ない",
            "zh": "不是等闲之辈的感觉强得离谱",
            "narrator_zh": "雅"
        },
        {
            "location": "725/TALK",
            "narrator": "みやび",
            "text": "意外と",
            "zh": "说不定",
            "narrator_zh": "雅"
        },
        {
            "location": "726/TALK",
            "narrator": "みやび",
            "text": "うちのＦａｔａｌＱｕｅｅｎとしての活動の方で",
            "zh": "在我以ＦａｔａｌＱｕｅｅｎ身份活动的那方面",
            "narrator_zh": "雅"
        },
        {
            "location": "727/TALK",
            "narrator": "みやび",
            "text": "花を咲かせるのかもしれん",
            "zh": "反倒能开出一朵花来",
            "narrator_zh": "雅"
        },
        {
            "location": "728/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "729/TALK",
            "narrator": "みやび",
            "text": "勝手な期待やけんど",
            "zh": "虽然是我一厢情愿的期待但是",
            "narrator_zh": "雅"
        },
        {
            "location": "740/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "741/TALK",
            "narrator": "みやび",
            "text": "いずれは、仲間に\n誘うのもえいかも\nしれんなぁ…。",
            "zh": "将来，说不定\n把她也招进伙\n也挺好啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "752/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【12 ピクシャル】",
            "zh": "【12 像素】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
}
