        "title": "らぶとーく  第28話",
        "sub_title": "チャンスをあげる",
        "title_zh": "恋爱漫谈 第28话",
        "sub_title_zh": "给你一个机会"
    },
    "entry": [
        {
            "location": "157/SCENARIO",
            "narrator": "",
            "text": "チャンスをあげる",
            "zh": "给你一个机会"
        },
        {
            "location": "170/TALK",
            "narrator": "ガブリエラ",
            "text": "…あら？\nあそこにいるのって…。",
            "zh": "…哎呀？\n站在那边的不是…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "171/TALK",
            "narrator": "ヒカル",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "光"
        },
        {
            "location": "172/TALK",
            "narrator": "ガブリエラ",
            "text": "ヒカルくんだ。\nこんなところで\n何してるのかしら？",
            "zh": "是光。\n在这种地方\n做什么呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "ガブリエラ",
            "text": "時間を気にしてる？\n誰かと待ち合わせでも\nしてるのかしら？",
            "zh": "在看时间？\n是在和谁\n碰头吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "174/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "187/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$、聞いてる？",
            "zh": "$handle$，你在听吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "189/SEL",
            "narrator": "",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "190/ACT",
            "narrator": "",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "チャンスをあげるわ",
            "zh": "给你一个机会",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/TALK",
            "narrator": "ガブリエラ",
            "text": "ヒカルくんと何を話せばいいのか",
            "zh": "该和光说什么才好",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラ",
            "text": "それを教えなさい",
            "zh": "把那个教给我",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "196/SEL",
            "narrator": "",
            "text": "男の人とは話せないでしょ？",
            "zh": "没法跟男人说话吧？",
            "narrator_zh": ""
        },
        {
            "location": "197/ACT",
            "narrator": "",
            "text": "男の人とは話せないでしょ？",
            "zh": "没法跟男人说话吧？",
            "narrator_zh": ""
        },
        {
            "location": "199/TALK",
            "narrator": "ガブリエラ",
            "text": "スマホで筆談するから平気よ！",
            "zh": "用手机笔谈就没事！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "200/TALK",
            "narrator": "ガブリエラ",
            "text": "いいから、早く話題！",
            "zh": "少废话，快点给话题！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "202/SEL",
            "narrator": "",
            "text": "ポーランドの話",
            "zh": "波兰的事",
            "narrator_zh": ""
        },
        {
            "location": "203/SEL",
            "narrator": "",
            "text": "勉強のこと",
            "zh": "学习的事",
            "narrator_zh": ""
        },
        {
            "location": "204/SEL",
            "narrator": "",
            "text": "好きな物を聞け",
            "zh": "说说你喜欢的东西",
            "narrator_zh": ""
        },
        {
            "location": "205/ACT",
            "narrator": "",
            "text": "ポーランドの話",
            "zh": "波兰的事",
            "narrator_zh": ""
        },
        {
            "location": "206/TALK",
            "narrator": "ガブリエラ",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "208/TALK",
            "narrator": "ガブリエラ",
            "text": "互いの共通点から攻めていく、ってことね",
            "zh": "从彼此的共同点攻进去，是这个意思吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "ガブリエラ",
            "text": "少し見直したわ",
            "zh": "稍微刮目相看了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "えっと…まずは\nこっちに気付いて\nもらわないと…。",
            "zh": "那个……得先\n让你注意到\n这边才行……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "…ふ、服の裾引っ張る\nくらい…いいよね？",
            "zh": "……就、就拉一下\n衣角……可以吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "226/TALK",
            "narrator": "ヒカル",
            "text": "ん？",
            "zh": "嗯？",
            "narrator_zh": "光"
        },
        {
            "location": "229/TALK",
            "narrator": "ヒカル",
            "text": "あれ？\nガブリエラさんじゃ\nないですか。",
            "zh": "咦？\n这不是加布里埃拉\n嘛。",
            "narrator_zh": "光"
        },
        {
            "location": "230/TALK",
            "narrator": "ヒカル",
            "text": "こんにちは。\nお買い物ですか？",
            "zh": "你好。\n来买东西吗？",
            "narrator_zh": "光"
        },
        {
            "location": "232/TALK",
            "narrator": "ガブリエラ",
            "text": "えっと…そうです、と。",
            "zh": "那个……是这样，吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "234/TALK",
            "narrator": "ヒカル",
            "text": "そうだったんですか。",
            "zh": "是这样啊。",
            "narrator_zh": "光"
        },
        {
            "location": "235/TALK",
            "narrator": "ヒカル",
            "text": "僕は、友達とここで\n待ち合わせをしているん\nです。",
            "zh": "我约了朋友\n在这里\n碰面。",
            "narrator_zh": "光"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり…それじゃあ、\nそれまでは時間がある\nってことね。",
            "zh": "果然……那也就是说，\n在那之前还有\n时间呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "239/TALK",
            "narrator": "ガブリエラ",
            "text": "えっと…ポーランドの\n好きなところって、\nどんなところですか？",
            "zh": "那个……波兰\n喜欢的地方，\n是什么样的地方？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/TALK",
            "narrator": "ヒカル",
            "text": "えっと…そうですね…。",
            "zh": "那个……这个嘛……",
            "narrator_zh": "光"
        },
        {
            "location": "243/TALK",
            "narrator": "ヒカル",
            "text": "つまらない感想に\nなってしまうかも\nしれませんが――",
            "zh": "也许感想会变得\n很无聊，\n不过——",
            "narrator_zh": "光"
        },
        {
            "location": "244/TALK",
            "narrator": "ヒカル",
            "text": "綺麗なところ、\nでしょうか？",
            "zh": "漂亮的地方，\n吗？",
            "narrator_zh": "光"
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラ",
            "text": "…綺麗なところって、\n例えば？",
            "zh": "……漂亮的地方，\n比如说？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "246/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/TALK",
            "narrator": "ヒカル",
            "text": "ワルシャワの街並みが\n大好きなんです。",
            "zh": "我最喜欢\n华沙的街景。",
            "narrator_zh": "光"
        },
        {
            "location": "248/TALK",
            "narrator": "ヒカル",
            "text": "あと、凄く素敵な教会が\nあって、そこが凄く\n気に入ってしまって…。",
            "zh": "还有一座非常漂亮的教堂，\n我特别\n喜欢那里……",
            "narrator_zh": "光"
        },
        {
            "location": "249/TALK",
            "narrator": "ガブリエラ",
            "text": "教会っていうと、\nもしかして！",
            "zh": "说到教堂，\n难道是！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "250/TALK",
            "narrator": "ガブリエラ",
            "text": "聖十字架教会ですか、\nっと。",
            "zh": "是圣十字架教堂吗，\n发送。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/TALK",
            "narrator": "ヒカル",
            "text": "そう、そこです！\nガブリエラさんも\n知ってるんですか？",
            "zh": "对，就是那里！\n加布里埃拉\n也知道吗？",
            "narrator_zh": "光"
        },
        {
            "location": "255/TALK",
            "narrator": "ガブリエラ",
            "text": "何度か行ったことが\nあります、っと。",
            "zh": "去过几次，\n发送。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "257/TALK",
            "narrator": "ヒカル",
            "text": "そうだったんですか。",
            "zh": "是这样啊。",
            "narrator_zh": "光"
        },
        {
            "location": "258/TALK",
            "narrator": "ヒカル",
            "text": "嬉しいなぁ。\nまさか、あの教会の話を\n日本でできるなんて。",
            "zh": "好高兴啊。\n没想到能在日本\n聊那座教堂。",
            "narrator_zh": "光"
        },
        {
            "location": "259/TALK",
            "narrator": "ガブリエラ",
            "text": "やった！\n楽しんでくれたみたい。",
            "zh": "太好了！\n他好像很开心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "262/TALK",
            "narrator": "ヒカル",
            "text": "…あ、いけない。\nそろそろ約束の時間だ。",
            "zh": "……啊，不好。\n差不多到约定的时间了。",
            "narrator_zh": "光"
        },
        {
            "location": "263/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、あたしも\nそろそろ行きます、\nっと。",
            "zh": "那，我也\n差不多走了，\n发送。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "264/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "265/TALK",
            "narrator": "ヒカル",
            "text": "はい。\nまた学校で。",
            "zh": "好。\n学校再见。",
            "narrator_zh": "光"
        },
        {
            "location": "269/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぅ…ふふっ。",
            "zh": "呼……呵呵。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "281/TALK",
            "narrator": "ガブリエラ",
            "text": "やったわ、大成功よ！",
            "zh": "太好了，大成功！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "283/TALK",
            "narrator": "ガブリエラ",
            "text": "ヒカルくんと、また色々お話で来たわ",
            "zh": "又能和光聊上各种话了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "285/SEL",
            "narrator": "",
            "text": "よかったね",
            "zh": "那就好",
            "narrator_zh": ""
        },
        {
            "location": "286/ACT",
            "narrator": "",
            "text": "よかったね",
            "zh": "那就好",
            "narrator_zh": ""
        },
        {
            "location": "288/TALK",
            "narrator": "ガブリエラ",
            "text": "認めたくないけど、$handle$のアドバイスのおかげね",
            "zh": "虽然不想承认，是$handle$的建议的功劳",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/TALK",
            "narrator": "ガブリエラ",
            "text": "少しは役に立つじゃない",
            "zh": "多少还是有点用嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "290/TALK",
            "narrator": "ガブリエラ",
            "text": "これからも頼むわよ",
            "zh": "今后也拜托你了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "301/ACT",
            "narrator": "",
            "text": "勉強のこと",
            "zh": "学习的事",
            "narrator_zh": ""
        },
        {
            "location": "302/TALK",
            "narrator": "ガブリエラ",
            "text": "つまらないわね、何それ？",
            "zh": "真无聊，那是什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "303/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、でも",
            "zh": "啊，不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "304/TALK",
            "narrator": "ガブリエラ",
            "text": "苦手な教科の話とかすれば、二人っきりで教えてくれたりするかしら？",
            "zh": "要是聊不擅长的科目，他会单独教我吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "316/TALK",
            "narrator": "ガブリエラ",
            "text": "…ふふっ。\nよし、それに決めた！",
            "zh": "……呵呵。\n好，就决定是那个了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "317/TALK",
            "narrator": "ガブリエラ",
            "text": "えっと…まずは\nこっちに気付いて\nもらわないと…。",
            "zh": "那个……得先\n让你注意到\n这边才行……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "319/TALK",
            "narrator": "ガブリエラ",
            "text": "…ふ、服の裾引っ張る\nくらい…いいよね？",
            "zh": "……就、就拉一下\n衣角……可以吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
