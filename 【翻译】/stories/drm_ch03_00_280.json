  "title": "らぶとーく  第28話",
  "sub_title": "チャンスをあげる"
 },
 "entry": [
  {
   "location": "157/SCENARIO",
   "narrator": "",
   "text": "チャンスをあげる"
  },
  {
   "location": "170/TALK",
   "narrator": "ガブリエラ",
   "text": "…あら？\nあそこにいるのって…。",
   "zh": "…哎呀？\n站在那边的不是…。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "171/TALK",
   "narrator": "ヒカル",
   "text": "…………。"
  },
  {
   "location": "172/TALK",
   "narrator": "ガブリエラ",
   "text": "ヒカルくんだ。\nこんなところで\n何してるのかしら？"
  },
  {
   "location": "173/TALK",
   "narrator": "ガブリエラ",
   "text": "時間を気にしてる？\n誰かと待ち合わせでも\nしてるのかしら？"
  },
  {
   "location": "174/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "187/TALK",
   "narrator": "ガブリエラ",
   "text": "$handle$、聞いてる？",
   "zh": "$handle$，你在听吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "189/SEL",
   "narrator": "",
   "text": "どうしたの？",
   "zh": "怎么了？",
   "narrator_zh": ""
  },
  {
   "location": "190/ACT",
   "narrator": "",
   "text": "どうしたの？",
   "zh": "怎么了？",
   "narrator_zh": ""
  },
  {
   "location": "192/TALK",
   "narrator": "ガブリエラ",
   "text": "チャンスをあげるわ"
  },
  {
   "location": "193/TALK",
   "narrator": "ガブリエラ",
   "text": "ヒカルくんと何を話せばいいのか"
  },
  {
   "location": "194/TALK",
   "narrator": "ガブリエラ",
   "text": "それを教えなさい",
   "zh": "把那个教给我",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "196/SEL",
   "narrator": "",
   "text": "男の人とは話せないでしょ？",
   "zh": "没法跟男人说话吧？",
   "narrator_zh": ""
  },
  {
   "location": "197/ACT",
   "narrator": "",
   "text": "男の人とは話せないでしょ？",
   "zh": "没法跟男人说话吧？",
   "narrator_zh": ""
  },
  {
   "location": "199/TALK",
   "narrator": "ガブリエラ",
   "text": "スマホで筆談するから平気よ！"
  },
  {
   "location": "200/TALK",
   "narrator": "ガブリエラ",
   "text": "いいから、早く話題！"
  },
  {
   "location": "202/SEL",
   "narrator": "",
   "text": "ポーランドの話",
   "zh": "波兰的事",
   "narrator_zh": ""
  },
  {
   "location": "203/SEL",
   "narrator": "",
   "text": "勉強のこと",
   "zh": "学习的事",
   "narrator_zh": ""
  },
  {
   "location": "204/SEL",
   "narrator": "",
   "text": "好きな物を聞け",
   "zh": "说说你喜欢的东西",
   "narrator_zh": ""
  },
  {
   "location": "205/ACT",
   "narrator": "",
   "text": "ポーランドの話",
   "zh": "波兰的事",
   "narrator_zh": ""
  },
  {
   "location": "206/TALK",
   "narrator": "ガブリエラ",
   "text": "なるほど",
   "zh": "原来如此",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "208/TALK",
   "narrator": "ガブリエラ",
   "text": "互いの共通点から攻めていく、ってことね"
  },
  {
   "location": "209/TALK",
   "narrator": "ガブリエラ",
   "text": "少し見直したわ"
  },
  {
   "location": "220/TALK",
   "narrator": "ガブリエラ",
   "text": "えっと…まずは\nこっちに気付いて\nもらわないと…。",
   "zh": "那个……得先\n让你注意到\n这边才行……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "222/TALK",
   "narrator": "ガブリエラ",
   "text": "…ふ、服の裾引っ張る\nくらい…いいよね？",
   "zh": "……就、就拉一下\n衣角……可以吧？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "223/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "226/TALK",
   "narrator": "ヒカル",
   "text": "ん？",
   "zh": "嗯？",
   "narrator_zh": "光"
  },
  {
   "location": "229/TALK",
   "narrator": "ヒカル",
   "text": "あれ？\nガブリエラさんじゃ\nないですか。",
   "zh": "咦？\n这不是加布里埃拉\n嘛。",
   "narrator_zh": "光"
  },
  {
   "location": "230/TALK",
   "narrator": "ヒカル",
   "text": "こんにちは。\nお買い物ですか？",
   "zh": "你好。\n来买东西吗？",
   "narrator_zh": "光"
  },
  {
   "location": "232/TALK",
   "narrator": "ガブリエラ",
   "text": "えっと…そうです、と。",
   "zh": "那个……是这样，吧。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "233/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "234/TALK",
   "narrator": "ヒカル",
   "text": "そうだったんですか。",
   "zh": "是这样啊。",
   "narrator_zh": "光"
  },
  {
   "location": "235/TALK",
   "narrator": "ヒカル",
   "text": "僕は、友達とここで\n待ち合わせをしているん\nです。",
   "zh": "我约了朋友\n在这里\n碰面。",
   "narrator_zh": "光"
  },
  {
   "location": "237/TALK",
   "narrator": "ガブリエラ",
   "text": "やっぱり…それじゃあ、\nそれまでは時間がある\nってことね。",
   "zh": "果然……那也就是说，\n在那之前还有\n时间呢。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "239/TALK",
   "narrator": "ガブリエラ",
   "text": "えっと…ポーランドの\n好きなところって、\nどんなところですか？"
  },
  {
   "location": "241/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "242/TALK",
   "narrator": "ヒカル",
   "text": "えっと…そうですね…。"
  },
  {
   "location": "243/TALK",
   "narrator": "ヒカル",
   "text": "つまらない感想に\nなってしまうかも\nしれませんが――",
   "zh": "也许感想会变得\n很无聊，\n不过——",
   "narrator_zh": "光"
  },
  {
   "location": "244/TALK",
   "narrator": "ヒカル",
   "text": "綺麗なところ、\nでしょうか？"
  },
  {
   "location": "245/TALK",
   "narrator": "ガブリエラ",
   "text": "…綺麗なところって、\n例えば？",
   "zh": "……漂亮的地方，\n比如说？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "246/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "247/TALK",
   "narrator": "ヒカル",
   "text": "ワルシャワの街並みが\n大好きなんです。"
  },
  {
   "location": "248/TALK",
   "narrator": "ヒカル",
   "text": "あと、凄く素敵な教会が\nあって、そこが凄く\n気に入ってしまって…。"
  },
  {
   "location": "249/TALK",
   "narrator": "ガブリエラ",
   "text": "教会っていうと、\nもしかして！"
  },
  {
   "location": "250/TALK",
   "narrator": "ガブリエラ",
   "text": "聖十字架教会ですか、\nっと。"
  },
  {
   "location": "252/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "254/TALK",
   "narrator": "ヒカル",
   "text": "そう、そこです！\nガブリエラさんも\n知ってるんですか？",
   "zh": "对，就是那里！\n加布里埃拉\n也知道吗？",
   "narrator_zh": "光"
  },
  {
   "location": "255/TALK",
   "narrator": "ガブリエラ",
   "text": "何度か行ったことが\nあります、っと。"
  },
  {
   "location": "256/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "257/TALK",
   "narrator": "ヒカル",
   "text": "そうだったんですか。",
   "zh": "是这样啊。",
   "narrator_zh": "光"
  },
  {
   "location": "258/TALK",
   "narrator": "ヒカル",
   "text": "嬉しいなぁ。\nまさか、あの教会の話を\n日本でできるなんて。"
  },
  {
   "location": "259/TALK",
   "narrator": "ガブリエラ",
   "text": "やった！\n楽しんでくれたみたい。"
  },
  {
   "location": "262/TALK",
   "narrator": "ヒカル",
   "text": "…あ、いけない。\nそろそろ約束の時間だ。"
  },
  {
   "location": "263/TALK",
   "narrator": "ガブリエラ",
   "text": "じゃあ、あたしも\nそろそろ行きます、\nっと。"
  },
  {
   "location": "264/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "265/TALK",
   "narrator": "ヒカル",
   "text": "はい。\nまた学校で。"
  },
  {
   "location": "269/TALK",
   "narrator": "ガブリエラ",
   "text": "ふぅ…ふふっ。"
  },
  {
   "location": "281/TALK",
   "narrator": "ガブリエラ",
   "text": "やったわ、大成功よ！"
  },
  {
   "location": "283/TALK",
   "narrator": "ガブリエラ",
   "text": "ヒカルくんと、また色々お話で来たわ"
  },
  {
   "location": "285/SEL",
   "narrator": "",
   "text": "よかったね",
   "zh": "那就好",
   "narrator_zh": ""
  },
  {
   "location": "286/ACT",
   "narrator": "",
   "text": "よかったね",
   "zh": "那就好",
   "narrator_zh": ""
  },
  {
   "location": "288/TALK",
   "narrator": "ガブリエラ",
   "text": "認めたくないけど、$handle$のアドバイスのおかげね"
  },
  {
   "location": "289/TALK",
   "narrator": "ガブリエラ",
   "text": "少しは役に立つじゃない"
  },
  {
   "location": "290/TALK",
   "narrator": "ガブリエラ",
   "text": "これからも頼むわよ",
   "zh": "今后也拜托你了",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "301/ACT",
   "narrator": "",
   "text": "勉強のこと",
   "zh": "学习的事",
   "narrator_zh": ""
  },
  {
   "location": "302/TALK",
   "narrator": "ガブリエラ",
   "text": "つまらないわね、何それ？",
   "zh": "真无聊，那是什么？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "303/TALK",
   "narrator": "ガブリエラ",
   "text": "あ、でも"
  },
  {
   "location": "304/TALK",
   "narrator": "ガブリエラ",
   "text": "苦手な教科の話とかすれば、二人っきりで教えてくれたりするかしら？"
  },
  {
   "location": "316/TALK",
   "narrator": "ガブリエラ",
   "text": "…ふふっ。\nよし、それに決めた！",
   "zh": "……呵呵。\n好，就决定是那个了！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "317/TALK",
   "narrator": "ガブリエラ",
   "text": "えっと…まずは\nこっちに気付いて\nもらわないと…。",
   "zh": "那个……得先\n让你注意到\n这边才行……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "319/TALK",
   "narrator": "ガブリエラ",
   "text": "…ふ、服の裾引っ張る\nくらい…いいよね？",
   "zh": "……就、就拉一下\n衣角……可以吧？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "320/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "323/TALK",
   "narrator": "ヒカル",
   "text": "ん？",
   "zh": "嗯？",
   "narrator_zh": "光"
  },
  {
   "location": "325/TALK",
   "narrator": "ヒカル",
   "text": "あれ？\nガブリエラさんじゃ\nないですか。",
   "zh": "咦？\n这不是加布里埃拉\n嘛。",
   "narrator_zh": "光"
  },
  {
   "location": "326/TALK",
   "narrator": "ヒカル",
   "text": "こんにちは。\nお買い物ですか？",
   "zh": "你好。\n来买东西吗？",
   "narrator_zh": "光"
  },
  {
   "location": "327/TALK",
   "narrator": "ガブリエラ",
   "text": "えっと…そうです、と。",
   "zh": "那个……是这样，吧。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "328/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "329/TALK",
   "narrator": "ヒカル",
   "text": "そうだったんですか。",
   "zh": "是这样啊。",
   "narrator_zh": "光"
  },
  {
   "location": "330/TALK",
   "narrator": "ヒカル",
   "text": "僕は、友達とここで\n待ち合わせをしているん\nです。",
   "zh": "我约了朋友\n在这里\n碰面。",
   "narrator_zh": "光"
  },
  {
   "location": "332/TALK",
   "narrator": "ガブリエラ",
   "text": "やっぱり…それじゃあ、\nそれまでは時間がある\nってことね。",
   "zh": "果然……那也就是说，\n在那之前还有\n时间呢。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "333/TALK",
   "narrator": "ガブリエラ",
   "text": "えっと…あたしは、\n参考書を見に来たん\nです、っと。"
  },
  {
   "location": "334/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "335/TALK",
   "narrator": "ヒカル",
   "text": "そうだったんですか。\n勉強熱心なんですね。",
   "zh": "原来是这样啊。\n你很用功呢。",
   "narrator_zh": "光"
  },
  {
   "location": "336/TALK",
   "narrator": "ヒカル",
   "text": "僕もガブリエラさんに\n負けないように、もっと\n勉強しないと…。"
  },
  {
   "location": "338/TALK",
   "narrator": "ガブリエラ",
   "text": "…そういえば、\nヒカルくんって苦手な\n教科とかあるのかしら？"
  },
  {
   "location": "339/TALK",
   "narrator": "ガブリエラ",
   "text": "えっと…苦手な教科って\nあるんですか、っと。"
  },
  {
   "location": "341/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "342/TALK",
   "narrator": "ヒカル",
   "text": "うーん…そうですね…。"
  },
  {
   "location": "343/TALK",
   "narrator": "ヒカル",
   "text": "国語…特に古文とかが\n苦手ですね。"
  },
  {
   "location": "345/TALK",
   "narrator": "ガブリエラ",
   "text": "あっ、それわかる！"
  },
  {
   "location": "346/TALK",
   "narrator": "ガブリエラ",
   "text": "レ点とか、未然形とか、\n色々あって難しいです\nよね、っと。"
  },
  {
   "location": "347/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "349/TALK",
   "narrator": "ヒカル",
   "text": "ガブリエラさんも\nそう思いますか？"
  },
  {
   "location": "350/TALK",
   "narrator": "ヒカル",
   "text": "本当、あれはどれだけ\n勉強しても、中々理解が\n出来なくて困ります…。"
  },
  {
   "location": "352/TALK",
   "narrator": "ガブリエラ",
   "text": "そっか…ヒカルくんも\n古文が苦手なんだ…。",
   "zh": "这样啊……原来光\n也不擅长古文……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "353/TALK",
   "narrator": "ガブリエラ",
   "text": "ふふっ、共通点が\n見つかったわ。"
  },
  {
   "location": "354/TALK",
   "narrator": "ガブリエラ",
   "text": "良ければ、今度一緒に\n勉強しませんか？\nっと。"
  },
  {
   "location": "356/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "357/TALK",
   "narrator": "ヒカル",
   "text": "ええ、是非。"
  },
  {
   "location": "358/TALK",
   "narrator": "ヒカル",
   "text": "わからないところは、\nお互い助け合いながら\n勉強しましょう。"
  },
  {
   "location": "360/ACT",
   "narrator": "",
   "text": "好きな物を聞け",
   "zh": "说说你喜欢的东西",
   "narrator_zh": ""
  },
  {
   "location": "362/TALK",
   "narrator": "ガブリエラ",
   "text": "はぁ！？",
   "zh": "哈！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "363/TALK",
   "narrator": "ガブリエラ",
   "text": "好きって、つまり好きな人とか、タイプとか/////////"
  },
  {
   "location": "365/SEL",
   "narrator": "",
   "text": "食べ物とか動物とか",
   "zh": "吃的呀动物之类的",
   "narrator_zh": ""
  },
  {
   "location": "366/ACT",
   "narrator": "",
   "text": "食べ物とか動物とか",
   "zh": "吃的呀动物之类的",
   "narrator_zh": ""
  },
  {
   "location": "368/TALK",
   "narrator": "ガブリエラ",
   "text": "ああ",
   "zh": "啊",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "369/TALK",
   "narrator": "ガブリエラ",
   "text": "そういうことね",
   "zh": "就是这么回事啊",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "370/TALK",
   "narrator": "ガブリエラ",
   "text": "ビックリさせないでよ！"
  },
  {
   "location": "381/TALK",
   "narrator": "ガブリエラ",
   "text": "えっと…まずは\nこっちに気付いて\nもらわないと…。",
   "zh": "那个……得先\n让你注意到\n这边才行……。",
   "narrator_zh": "加布里埃拉"
  },
  {
