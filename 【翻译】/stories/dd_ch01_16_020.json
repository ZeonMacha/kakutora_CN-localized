{
    "dir": "chap16/daydra/dd_ch01_16_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "16156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "アイスをかけた戦い",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "赌上冰淇淋的战斗"
    },
    "entry": [
        {
            "location": "297/SCENARIO",
            "narrator": "",
            "text": "アイスをかけた戦い",
            "zh": "赌上冰淇淋的战斗",
            "narrator_zh": ""
        },
        {
            "location": "318/TALK",
            "narrator": "真幌",
            "text": "逢瀬、ちょっといいか？",
            "zh": "逢濑，能耽误你一下吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "319/TALK",
            "narrator": "つばめ",
            "text": "はい、どうかしました？",
            "zh": "在的，怎么了？",
            "narrator_zh": "燕"
        },
        {
            "location": "320/TALK",
            "narrator": "真幌",
            "text": "さっき冷蔵庫を開けたら、\nアイスが一つ余っててな。",
            "zh": "刚才打开冰箱，\n还多出来一个冰淇淋。",
            "narrator_zh": "真幌"
        },
        {
            "location": "321/TALK",
            "narrator": "真幌",
            "text": "私はいらんから、\n食べたい奴が\n食べてくれ。",
            "zh": "我不要。\n谁想吃\n谁吃。",
            "narrator_zh": "真幌"
        },
        {
            "location": "322/TALK",
            "narrator": "つばめ",
            "text": "わかりました！",
            "zh": "知道了！",
            "narrator_zh": "燕"
        },
        {
            "location": "326/TALK",
            "narrator": "つばめ",
            "text": "卯月さんはバイトお休みだし\nあとの四人で――",
            "zh": "卯月今天打工休息，\n剩下四个人——",
            "narrator_zh": "燕"
        },
        {
            "location": "328/TALK",
            "narrator": "つばめ",
            "text": "ジャンケンでもして\n決めちゃおうかな？",
            "zh": "用猜拳\n来决定？",
            "narrator_zh": "燕"
        },
        {
            "location": "346/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃあ、一対一で\n勝負して三勝した人が\n勝ちってことでいいわね？",
            "zh": "那就一对一比，\n先赢三场的人\n算赢，可以吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "349/TALK",
            "narrator": "つばめ",
            "text": "わかりました！",
            "zh": "知道了！",
            "narrator_zh": "燕"
        },
        {
            "location": "350/TALK",
            "narrator": "みやび",
            "text": "それでえいよ。",
            "zh": "那就要得。",
            "narrator_zh": "雅"
        },
        {
            "location": "353/TALK",
            "narrator": "アーヤ",
            "text": "全員で一気にじゃ\nダメなの？",
            "zh": "大家一起出，\n不行吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "354/TALK",
            "narrator": "ガブリエラ",
            "text": "こっちの方がゲーム\nっぽくて面白いでしょ？",
            "zh": "这样更像在玩游戏，\n比较有意思吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "355/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん、一戦目の\n相手頼むがよ。",
            "zh": "加布，第一场\n当我对手咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "359/TALK",
            "narrator": "アーヤ",
            "text": "それじゃあ、\n私はつばめとね。",
            "zh": "那我\n就跟燕比。",
            "narrator_zh": "绫水"
        },
        {
            "location": "360/TALK",
            "narrator": "アーヤ",
            "text": "とりあえず、グーで\n行こうかしら？",
            "zh": "总之，先出\n石头看看？",
            "narrator_zh": "绫水"
        },
        {
            "location": "362/TALK",
            "narrator": "つばめ",
            "text": "う～ん…\n何を出そうかなぁ？",
            "zh": "嗯——……\n出什么好呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "363/SEL",
            "narrator": "",
            "text": "パーを出そう",
            "zh": "出布吧",
            "narrator_zh": ""
        },
        {
            "location": "366/TALK",
            "narrator": "つばめ",
            "text": "うーん、グーがいいかな？\nでも、逆にチョキで\nいった方がいいのかも。",
            "zh": "嗯，出石头好吗？\n不过反过来出剪刀\n也许更好。",
            "narrator_zh": "燕"
        },
        {
            "location": "368/TALK",
            "narrator": "つばめ",
            "text": "う～ん…悩んでも\n仕方ないし、\nそうしようかな？",
            "zh": "嗯——……再想也\n没用，\n就这么办？",
            "narrator_zh": "燕"
        },
        {
            "location": "372/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、準備はいい？",
            "zh": "那么，准备好了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "373/TALK",
            "narrator": "つばめ",
            "text": "はい！",
            "zh": "好！",
            "narrator_zh": "燕"
        },
        {
            "location": "377/TALK",
            "narrator": "アーヤ",
            "text": "じゃん、けん…。",
            "zh": "猜、拳……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "380/TALK",
            "narrator": "つばめ",
            "text": "チョキ！",
            "zh": "剪刀！",
            "narrator_zh": "燕"
        },
        {
            "location": "383/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、私の勝ちね。",
            "zh": "呵呵，我赢了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "385/TALK",
            "narrator": "つばめ",
            "text": "うう…\n負けちゃいましたぁ…。",
            "zh": "呜……\n输了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "386/TALK",
            "narrator": "つばめ",
            "text": "考え過ぎちゃったかな？\nやっぱり、グーでいった方が\nよかったかも。",
            "zh": "是想太多了吗？\n果然还是出石头\n更好。",
            "narrator_zh": "燕"
        },
        {
            "location": "388/ACT",
            "narrator": "",
            "text": "パーを出そう",
            "zh": "出布吧",
            "narrator_zh": ""
        },
        {
            "location": "420/TALK",
            "narrator": "つばめ",
            "text": "パーかぁ…アーヤさんも、\nグーって考えてるかも\nしれないし…。",
            "zh": "布啊……绫水\n也许也在想出石头\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "421/TALK",
            "narrator": "つばめ",
            "text": "それで行ってみよ。",
            "zh": "就这么出看看。",
            "narrator_zh": "燕"
        },
        {
            "location": "423/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、準備はいい？",
            "zh": "那么，准备好了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "424/TALK",
            "narrator": "つばめ",
            "text": "はい！",
            "zh": "好！",
            "narrator_zh": "燕"
        },
        {
            "location": "427/TALK",
            "narrator": "アーヤ",
            "text": "じゃん、けん…。",
            "zh": "猜、拳……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "432/TALK",
            "narrator": "つばめ",
            "text": "パー！",
            "zh": "布！",
            "narrator_zh": "燕"
        },
        {
            "location": "436/TALK",
            "narrator": "つばめ",
            "text": "あっ、わたしの勝ちです！",
            "zh": "啊，我赢了！",
            "narrator_zh": "燕"
        },
        {
            "location": "439/TALK",
            "narrator": "アーヤ",
            "text": "あらら、負けちゃったわ。",
            "zh": "哎呀，输了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "442/TALK",
            "narrator": "ガブリエラ",
            "text": "うーっ、悔しいー！",
            "zh": "呜，好不甘心！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "443/TALK",
            "narrator": "つばめ",
            "text": "せんぱい、みやびさんに\n負けちゃったんですか？",
            "zh": "前辈，是输给\n雅了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "446/TALK",
            "narrator": "ガブリエラ",
            "text": "聞かないでよ！",
            "zh": "别问了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "447/TALK",
            "narrator": "ガブリエラ",
            "text": "五回もあいこが続いたのに\n負けて、本気で悔しいん\nだから…。",
            "zh": "平了五次还是输了，\n真的很不甘心\n……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "449/TALK",
            "narrator": "ガブリエラ",
            "text": "こうなったら、つばめには\n一発で勝ってみせるわ。",
            "zh": "既然这样，我要\n一把赢过燕。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "450/TALK",
            "narrator": "ガブリエラ",
            "text": "確か、さっきはパーで\n勝ってたから、連続で\nパーはないわね。",
            "zh": "刚才是出布赢的，\n不会连续\n再出布。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "451/TALK",
            "narrator": "ガブリエラ",
            "text": "だとすると、とりあえず\nグーを出しておけば\n負けはしないわね。",
            "zh": "那样的话，先\n出石头，\n就不会输。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "452/TALK",
            "narrator": "つばめ",
            "text": "う～ん…さっきはパーで\n勝ったから、次こそは\nグーかチョキかなぁ？",
            "zh": "嗯——……刚才出布\n赢了，下次该出\n石头还是剪刀呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "453/SEL",
            "narrator": "",
            "text": "もう一度パーだ！",
            "zh": "再出一次布！",
            "narrator_zh": ""
        },
        {
            "location": "455/TALK",
            "narrator": "つばめ",
            "text": "グーかチョキか…\nう～ん…。",
            "zh": "石头还是剪刀……\n嗯——……。",
            "narrator_zh": "燕"
        },
        {
            "location": "456/TALK",
            "narrator": "つばめ",
            "text": "…チョキにしようかな？",
            "zh": "……出剪刀吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "461/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、行くわよ！\nじゃんけん…。",
            "zh": "那就来了！\n猜拳……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "466/TALK",
            "narrator": "ガブリエラ",
            "text": "グー！",
            "zh": "石头！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "467/TALK",
            "narrator": "つばめ",
            "text": "チョキです！！",
            "zh": "剪刀！！",
            "narrator_zh": "燕"
        },
        {
            "location": "468/TALK",
            "narrator": "つばめ",
            "text": "あっ…あれ？",
            "zh": "啊……咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "471/TALK",
            "narrator": "ガブリエラ",
            "text": "やった！\nあたしの勝ちよ！",
            "zh": "太好了！\n我赢了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "473/TALK",
            "narrator": "つばめ",
            "text": "うう、\n負けちゃいました…。",
            "zh": "呜，\n输了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "475/TALK",
            "narrator": "ガブリエラ",
            "text": "さっきパー出してたから、\n同じのは出さない、って\n思ったのよ。",
            "zh": "你刚才出了布，\n我就以为不会\n再出一样的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "477/TALK",
            "narrator": "ガブリエラ",
            "text": "この調子で次も勝つわ。\nアーヤ、次はあたしよ！",
            "zh": "照这样下一场也赢。\n绫水，下一个是我！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "480/TALK",
            "narrator": "つばめ",
            "text": "…せんぱい、\n凄く楽しんでて\n可愛いな…。",
            "zh": "……前辈\n玩得好开心，\n好可爱……。",
            "narrator_zh": "燕"
        },
        {
            "location": "482/ACT",
            "narrator": "",
            "text": "もう一度パーだ！",
            "zh": "再出一次布！",
            "narrator_zh": ""
        },
        {
            "location": "513/TALK",
            "narrator": "つばめ",
            "text": "また指示が来てる。",
            "zh": "又来指示了。",
            "narrator_zh": "燕"
        },
        {
            "location": "515/TALK",
            "narrator": "つばめ",
            "text": "でも、同じのを連続で\n出すのって、ちょっとだけ\n不安かも…。",
            "zh": "可是，连续出\n一样的，有点\n不安……。",
            "narrator_zh": "燕"
        },
        {
            "location": "518/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、いくわよ。\nじゃーんけーん…。",
            "zh": "那就来了。\n猜——拳——……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "520/TALK",
            "narrator": "つばめ",
            "text": "でも、信じてみよう！",
            "zh": "不过，还是相信一次！",
            "narrator_zh": "燕"
        },
        {
            "location": "523/TALK",
            "narrator": "つばめ",
            "text": "パー！",
            "zh": "布！",
            "narrator_zh": "燕"
        },
        {
            "location": "525/TALK",
            "narrator": "つばめ",
            "text": "…あれ？\nわたしの勝ちです！",
            "zh": "……咦？\n我赢了！",
            "narrator_zh": "燕"
        },
        {
            "location": "526/TALK",
            "narrator": "ガブリエラ",
            "text": "もーっ、また負けたー！",
            "zh": "真是的，又输了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "527/TALK",
            "narrator": "ガブリエラ",
            "text": "二回連続で同じのは\n出してこないと\n思ったのに…。",
            "zh": "我以为连续两次\n不会出一样的\n……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "529/TALK",
            "narrator": "つばめ",
            "text": "…また勝っちゃった。",
            "zh": "……又赢了。",
            "narrator_zh": "燕"
        },
        {
            "location": "530/TALK",
            "narrator": "つばめ",
            "text": "もしかして、次に何が\n出るかわかるのかな？",
            "zh": "难道，能知道\n下一次出什么吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "535/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん、\n絶好調みたいやね。",
            "zh": "燕，\n看起来状态好得很咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "536/TALK",
            "narrator": "つばめ",
            "text": "あ、はい…\nどうにか勝ててます。",
            "zh": "啊，是……\n总算是在赢。",
            "narrator_zh": "燕"
        },
        {
            "location": "538/TALK",
            "narrator": "みやび",
            "text": "うちも二勝してるき、\n優勝決定戦やね。",
            "zh": "我也是两胜啵，\n接下来就是决赛咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "540/TALK",
            "narrator": "みやび",
            "text": "本気で行くぞね！",
            "zh": "我要认真上了啵！",
            "narrator_zh": "雅"
        },
        {
            "location": "542/TALK",
            "narrator": "つばめ",
            "text": "はい！\nわたしも負けません！",
            "zh": "好！\n我也不会输！",
            "narrator_zh": "燕"
        },
        {
            "location": "543/TALK",
            "narrator": "みやび",
            "text": "…とは言うたけんど、\nここまで来ると何を出すか\n決められんなぁ。",
            "zh": "……话是这么说，\n到了这一步出什么\n反而不晓得了。",
            "narrator_zh": "雅"
        },
        {
            "location": "544/TALK",
            "narrator": "みやび",
            "text": "…何も考えんで、\n適当に出してみるか。",
            "zh": "……什么都不想，\n随便出一个看看。",
            "narrator_zh": "雅"
        },
        {
            "location": "545/TALK",
            "narrator": "つばめ",
            "text": "う～ん…次は何を出せば\nいいんだろう？",
            "zh": "嗯——……下一次\n出什么好呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "546/SEL",
            "narrator": "",
            "text": "多分、グーだ！！",
            "zh": "大概是石头！！",
            "narrator_zh": ""
        },
        {
            "location": "548/TALK",
            "narrator": "つばめ",
            "text": "さっきまでは指示に\n従って勝ててたけど…。",
            "zh": "刚才一直按指示\n出，都赢了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "549/TALK",
            "narrator": "つばめ",
            "text": "…どうしたのかな？",
            "zh": "……怎么了呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "550/TALK",
            "narrator": "つばめ",
            "text": "今回は来ないのかな？",
            "zh": "这次不会来了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "556/TALK",
            "narrator": "みやび",
            "text": "すっと始めるちや。\nつばめちゃん、いくがよ！",
            "zh": "马上开始咯。\n燕，来咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "559/TALK",
            "narrator": "つばめ",
            "text": "は、はい！！\nじゃーんけーん…。",
            "zh": "好、好！！\n猜——拳——……。",
            "narrator_zh": "燕"
        },
        {
            "location": "561/TALK",
            "narrator": "みやび",
            "text": "パーや！",
            "zh": "布！",
            "narrator_zh": "雅"
        },
        {
            "location": "562/TALK",
            "narrator": "つばめ",
            "text": "チョキです！！",
            "zh": "剪刀！！",
            "narrator_zh": "燕"
        },
        {
            "location": "566/TALK",
            "narrator": "つばめ",
            "text": "…わぁ、勝ったぁ！\n三連勝です！",
            "zh": "……哇，赢了！\n三连胜！",
            "narrator_zh": "燕"
        },
        {
            "location": "569/TALK",
            "narrator": "みやび",
            "text": "はぁ…負けたがよ。\nあと一勝やったがに…。",
            "zh": "唉……输了咯。\n再赢一场就好了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "571/TALK",
            "narrator": "みやび",
            "text": "賞品のアイスは\nつばめちゃんの物やね。",
            "zh": "奖品的冰淇淋\n是燕的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "574/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…結局一勝も\nできなかったわ…。",
            "zh": "唉……结果一场\n都没赢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "576/TALK",
            "narrator": "アーヤ",
            "text": "そういうこともあるわよ。\nおめでとう、つばめ。",
            "zh": "也会有这种事。\n恭喜，燕。",
            "narrator_zh": "绫水"
        },
        {
            "location": "579/TALK",
            "narrator": "つばめ",
            "text": "ありがとうございます！",
            "zh": "谢谢！",
            "narrator_zh": "燕"
        },
        {
            "location": "581/TALK",
            "narrator": "つばめ",
            "text": "…そういえば、\n最後は何も指示が\n来なかったなぁ。",
            "zh": "……这么一说，\n最后一次什么指示\n都没来。",
            "narrator_zh": "燕"
        },
        {
            "location": "583/TALK",
            "narrator": "つばめ",
            "text": "もしかして、わたしが\n自力で勝つってわかって\nたから…なのかな？",
            "zh": "难道是知道\n我能靠自己赢\n……所以？",
            "narrator_zh": "燕"
        },
        {
            "location": "600/ACT",
            "narrator": "",
            "text": "多分、グーだ！！",
            "zh": "大概是石头！！",
            "narrator_zh": ""
        },
        {
            "location": "631/TALK",
            "narrator": "つばめ",
            "text": "…やっぱり来た。",
            "zh": "……果然来了。",
            "narrator_zh": "燕"
        },
        {
            "location": "632/TALK",
            "narrator": "つばめ",
            "text": "今度はグーかぁ…\nさすがに、三連続で\nパーはないみたい。",
            "zh": "这次是石头啊……\n果然，不会连续三次\n都出布。",
            "narrator_zh": "燕"
        },
        {
            "location": "635/TALK",
            "narrator": "みやび",
            "text": "それじゃあ行くがよ！\nじゃん、けん…。",
            "zh": "那就来咯！\n猜、拳……。",
            "narrator_zh": "雅"
        },
        {
            "location": "637/TALK",
            "narrator": "つばめ",
            "text": "よーし、これで\n三連勝だよ！",
            "zh": "好，这样就是\n三连胜了！",
            "narrator_zh": "燕"
        },
        {
            "location": "639/TALK",
            "narrator": "つばめ",
            "text": "グーです！！",
            "zh": "石头！！",
            "narrator_zh": "燕"
        },
        {
            "location": "640/TALK",
            "narrator": "みやび",
            "text": "パーや…。\n残念やったね、\nつばめちゃん。",
            "zh": "布……\n可惜了咯，\n燕。",
            "narrator_zh": "雅"
        },
        {
            "location": "644/TALK",
            "narrator": "つばめ",
            "text": "あ、あれ？\n負けちゃった…？",
            "zh": "啊、咦？\n输了……？",
            "narrator_zh": "燕"
        },
        {
            "location": "645/TALK",
            "narrator": "つばめ",
            "text": "ちゃんと指示通りに\n出したはずなのに…。",
            "zh": "我明明是\n按指示出的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "647/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…優勝はみやびかぁ。",
            "zh": "唉……冠军是雅啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "648/TALK",
            "narrator": "ガブリエラ",
            "text": "結局、あたしは一勝も\nできなかったわ。",
            "zh": "结果，我一场\n都没赢成。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "650/TALK",
            "narrator": "アーヤ",
            "text": "そういうこともあるわよ。\nじゃんけんなんて\n運なんだから。",
            "zh": "也会有这种事。\n猜拳本来\n就是靠运气。",
            "narrator_zh": "绫水"
        },
        {
            "location": "652/TALK",
            "narrator": "つばめ",
            "text": "…そっか。\nそうですよね。",
            "zh": "……这样啊。\n也是呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "653/TALK",
            "narrator": "つばめ",
            "text": "指示通りにすれば\n絶対に勝てると\n思っちゃってた…。",
            "zh": "我还以为\n按指示出\n就一定能赢……。",
            "narrator_zh": "燕"
        },
        {
            "location": "655/TALK",
            "narrator": "つばめ",
            "text": "ズルした罰が当たったの\nかもしれないなぁ…。",
            "zh": "也许是作弊的\n报应来了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "305/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月17日　4:04 PM</color>\nとある休日、神楽坂トライナリー劇場でのバイト中のこと。",
            "zh": "<color=green>7月17日　4:04 PM</color>\n某个假日，在神乐坂三重奏剧场打工的时候。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "594/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch01",
            "text": "【未来予知者と明日の過去】",
            "zh": "【未来预知者与明天的过去】",
            "narrator_zh": "Dialog_GEThimegoto_ch01"
        }
    ]
}
