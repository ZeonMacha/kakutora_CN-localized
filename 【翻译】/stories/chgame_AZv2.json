{
    "dir": "chap17/daydra/chgame_AZv2.js",
    "type": "Other",
    "info": {
        "story_id": "",
        "cid": "_",
        "title": "",
        "sub_title": "AZご褒美（普通に宝箱）",
        "title_zh": "",
        "sub_title_zh": "AZ奖励（就普通的宝箱）"
    },
    "entry": [
        {
            "location": "1555/SCENARIO",
            "narrator": "",
            "text": "AZご褒美（普通に宝箱）",
            "zh": "AZ奖励（就普通的宝箱）",
            "narrator_zh": ""
        },
        {
            "location": "1560/TALK",
            "narrator": "千羽鶴",
            "text": "ここは、\n普通の宝箱が\n置いてあった場所。",
            "zh": "这里，\n是普通宝箱\n曾经摆着的位置。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1561/TALK",
            "narrator": "千羽鶴",
            "text": "RPGには宝箱が\nつきものだから。",
            "zh": "因为RPG嘛，\n当然要有宝箱。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1562/TALK",
            "narrator": "千羽鶴",
            "text": "それに、こういった\n奥まった場所には大抵\nイイモノが入ってる。",
            "zh": "而且在这种\n不起眼的角落里，\n一般都装着好东西。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1563/TALK",
            "narrator": "千羽鶴",
            "text": "だからここには、\nココロキャンディを大量に\n詰め込んでおいた。",
            "zh": "所以我在这里，\n塞了大量的\n心之糖果。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1564/TALK",
            "narrator": "千羽鶴",
            "text": "それはそうと。",
            "zh": "话说回来。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1565/TALK",
            "narrator": "千羽鶴",
            "text": "実はこの宝箱には\n心理的なトラップを\n仕掛けておいたんだけど。",
            "zh": "其实这个宝箱上，\n我还设了一个\n心理陷阱。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1566/SEL",
            "narrator": "",
            "text": "どんな仕掛け？",
            "zh": "什么机关？",
            "narrator_zh": ""
        },
        {
            "location": "1567/SEL",
            "narrator": "",
            "text": "興味無い",
            "zh": "没兴趣",
            "narrator_zh": ""
        },
        {
            "location": "1568/ACT",
            "narrator": "",
            "text": "どんな仕掛け？",
            "zh": "什么机关？",
            "narrator_zh": ""
        },
        {
            "location": "1569/TALK",
            "narrator": "千羽鶴",
            "text": "RPGでは、宝箱の解放には\nミミックのリスクが\n伴うのは周知のこと。",
            "zh": "在RPG里，开宝箱\n要冒宝箱怪的风险，\n这是周知的事实。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1570/TALK",
            "narrator": "千羽鶴",
            "text": "そのドキドキ感は、\n実にゲーム的だと思う。",
            "zh": "那种心跳感，\n我觉得很有游戏味。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1571/TALK",
            "narrator": "千羽鶴",
            "text": "そしてそのスリル的な\n感覚は、人間の学習能力に\nよって享受される。",
            "zh": "而那种惊险的感觉，\n要靠人类的学习能力\n来享受。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1572/TALK",
            "narrator": "千羽鶴",
            "text": "すなわち――",
            "zh": "也就是说——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1573/TALK",
            "narrator": "千羽鶴",
            "text": "ミミックに一度も\n遭遇してなければ、\nなんの緊張もせず――",
            "zh": "要是从没遭遇过\n宝箱怪，就不会\n有半点紧张——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1574/TALK",
            "narrator": "千羽鶴",
            "text": "あっさり宝箱を\n開けてそれでお終い。",
            "zh": "爽快地打开宝箱，\n然后就完事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1575/TALK",
            "narrator": "千羽鶴",
            "text": "けれども、一度でも\nミミックを開けてしまうと\n次からは疑心暗鬼になる。",
            "zh": "可是，只要开到过\n一次宝箱怪，之后\n就会疑神疑鬼。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1576/TALK",
            "narrator": "千羽鶴",
            "text": "だから、このゲームの\nレベルデザインとして、\nまずミミックを置いた。",
            "zh": "所以作为这个游戏的\n关卡设计，我先\n放了宝箱怪。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1577/TALK",
            "narrator": "千羽鶴",
            "text": "そして、その後に\nこの宝箱を配置した。",
            "zh": "然后，再把这只宝箱\n放上去。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1578/SEL",
            "narrator": "",
            "text": "もしかしてミミックって、ガブ……",
            "zh": "该不会那个宝箱怪，是加布……",
            "narrator_zh": ""
        },
        {
            "location": "1579/ACT",
            "narrator": "",
            "text": "もしかしてミミックって、ガブ……",
            "zh": "该不会那个宝箱怪，是加布……",
            "narrator_zh": ""
        },
        {
            "location": "1581/TALK",
            "narrator": "千羽鶴",
            "text": "そう。\nガブリエラ。",
            "zh": "是的。\n加布里埃拉。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1582/SEL",
            "narrator": "",
            "text": "ちっちゃ可愛いやつだ！",
            "zh": "是那个又小又可爱的家伙！",
            "narrator_zh": ""
        },
        {
            "location": "1583/ACT",
            "narrator": "",
            "text": "ちっちゃ可愛いやつだ！",
            "zh": "是那个又小又可爱的家伙！",
            "narrator_zh": ""
        },
        {
            "location": "1585/TALK",
            "narrator": "千羽鶴",
            "text": "そう。",
            "zh": "是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1586/TALK",
            "narrator": "千羽鶴",
            "text": "…って、あれ？\n警戒してない？",
            "zh": "……等等，咦？\n你没在戒备吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1587/TALK",
            "narrator": "千羽鶴",
            "text": "失敗だったか。",
            "zh": "失策了吗。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1589/ACT",
            "narrator": "",
            "text": "興味無い",
            "zh": "没兴趣",
            "narrator_zh": ""
        }
    ]
}
