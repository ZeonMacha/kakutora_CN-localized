{
    "dir": "chap31/daydra/dd_ch02_31_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "31202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "生体認証媒体＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "生物识别媒介＜前篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "松代大本営",
            "zh": "松代大本营",
            "narrator_zh": ""
        },
        {
            "location": "38/TALK",
            "narrator": "アーヤ",
            "text": "すみません、\n館長に運転\nさせてしまって。",
            "zh": "不好意思，\n还得劳烦馆长\n来开车。",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "透明真幌",
            "text": "いや、気にするな。",
            "zh": "没事，别在意。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "で？\n何て名前だったっけ？",
            "zh": "然后呢？\n叫什么名字来着？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "エヴェレット脳科学研究所\nJapanSite。",
            "zh": "艾弗雷特脑科学研究所\nJapanSite。",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "まっさか日本にも\n研究所が\nあったとはねえ。",
            "zh": "真没想到日本竟然也\n有研究所\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "44/TALK",
            "narrator": "透明真幌",
            "text": "実質はエリカ一人の\nためのラボだ。",
            "zh": "实质上是专门为领火\n一个人设的实验室。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "45/TALK",
            "narrator": "透明真幌",
            "text": "それだけ重要な\n研究に携わって\nいたんだよ。",
            "zh": "因为她当时参与的\n就是如此重要的\n研究啊。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "48/TALK",
            "narrator": "透明真幌",
            "text": "アーヤが場所を\n知らないのも\n無理はない。",
            "zh": "绫水不知道这里\n也是理所当然\n的。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "49/TALK",
            "narrator": "透明真幌",
            "text": "一般人には\n秘匿された\n施設だからな。",
            "zh": "毕竟这是对一般人\n保密的\n设施。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "姉妹でも言えない\n機密情報なのね…。",
            "zh": "连亲姐妹都不能说的\n机密情报啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "国同士が関わるような\n研究なら当たり前ぞね。",
            "zh": "只要是涉及国家之间的\n研究，那也是理所当然的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "むしろうちらが\nのこのこ行っても\n大丈夫なんですか？",
            "zh": "倒不如说我们这样\n大摇大摆地过去\n真的没问题吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "透明真幌",
            "text": "……関係者というか\n当事者だからな。",
            "zh": "……毕竟我们算是相关者，\n或者说当事人嘛。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "55/TALK",
            "narrator": "透明真幌",
            "text": "特にアーヤ。\nアーヤではないと\nできないことがある。",
            "zh": "尤其是绫水。\n有件事非绫水\n不可。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "57/TALK",
            "narrator": "アーヤ",
            "text": "私でないと\nできないこと？",
            "zh": "非我不可\n的事？",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "透明真幌",
            "text": "そう。",
            "zh": "是的。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "59/TALK",
            "narrator": "透明真幌",
            "text": "そしてそれが松代に\n来た目的だ。",
            "zh": "而那正是我们来松代的\n目的。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "60/SEL",
            "narrator": "",
            "text": "アーヤ",
            "zh": "绫水",
            "narrator_zh": ""
        },
        {
            "location": "61/ACT",
            "narrator": "",
            "text": "アーヤ",
            "zh": "绫水",
            "narrator_zh": ""
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "何？",
            "zh": "怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "82/SEL",
            "narrator": "",
            "text": "自分自身を信じて",
            "zh": "相信你自己",
            "narrator_zh": ""
        },
        {
            "location": "83/SEL",
            "narrator": "",
            "text": "$me$はアーヤを応援する",
            "zh": "$me$会支持绫水的",
            "narrator_zh": ""
        },
        {
            "location": "84/SEL",
            "narrator": "",
            "text": "いつも通りやれば大丈夫だよ",
            "zh": "像平时那样做就没问题的",
            "narrator_zh": ""
        },
        {
            "location": "85/ACT",
            "narrator": "",
            "text": "自分自身を信じて",
            "zh": "相信你自己",
            "narrator_zh": ""
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "何なの急に",
            "zh": "怎么突然说这个",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/ACT",
            "narrator": "",
            "text": "$me$はアーヤを応援する",
            "zh": "$me$会支持绫水的",
            "narrator_zh": ""
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう？",
            "zh": "谢谢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/ACT",
            "narrator": "",
            "text": "いつも通りやれば大丈夫だよ",
            "zh": "像平时那样做就没问题的",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "アーヤ",
            "text": "えと",
            "zh": "那个",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "何の話？",
            "zh": "你在说什么事？",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/SEL",
            "narrator": "",
            "text": "これから起こること",
            "zh": "接下来要发生的事",
            "narrator_zh": ""
        },
        {
            "location": "95/SEL",
            "narrator": "",
            "text": "頼まれごとについて",
            "zh": "关于拜托你的事",
            "narrator_zh": ""
        },
        {
            "location": "96/SEL",
            "narrator": "",
            "text": "この世界の再生に向けた行動",
            "zh": "为了再生这个世界的行动",
            "narrator_zh": ""
        },
        {
            "location": "97/ACT",
            "narrator": "",
            "text": "これから起こること",
            "zh": "接下来要发生的事",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "アーヤ",
            "text": "そうなの？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/ACT",
            "narrator": "",
            "text": "頼まれごとについて",
            "zh": "关于拜托你的事",
            "narrator_zh": ""
        },
        {
            "location": "100/TALK",
            "narrator": "アーヤ",
            "text": "館長の話ね",
            "zh": "馆长说的那件事吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "101/ACT",
            "narrator": "",
            "text": "この世界の再生に向けた行動",
            "zh": "为了再生这个世界的行动",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "そんな大きい話",
            "zh": "哪有那么大的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "なわけね",
            "zh": "怎么可能呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "106/TALK",
            "narrator": "アーヤ",
            "text": "がんばるわ",
            "zh": "我会加油的",
            "narrator_zh": "绫水"
        },
        {
            "location": "118/TALK",
            "narrator": "透明真幌",
            "text": "着いたぞ。",
            "zh": "到了。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "152/TALK",
            "narrator": "アーヤ",
            "text": "ここが……。",
            "zh": "这里就是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "洞窟の中に\nこんなに大きい\n施設を作るなんて…。",
            "zh": "居然在洞窟里面\n建了这么大的\n设施……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "157/TALK",
            "narrator": "みやび",
            "text": "いかにも秘密基地、\nちゅう雰囲気ぞね。\n気に入った。",
            "zh": "很有一股秘密基地\n的氛围\n啵。我蛮喜欢。",
            "narrator_zh": "雅"
        },
        {
            "location": "160/TALK",
            "narrator": "ガブリエラ",
            "text": "そこなの？",
            "zh": "重点是这个吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "これがお城やったら\nガブちゃんは大喜び\nしたろう？",
            "zh": "这要是座城堡的话，\n加布肯定会高兴坏\n了咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "166/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあちょっと\n格好いいかもね…。",
            "zh": "……嘛，稍微\n是有点帅气吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/TALK",
            "narrator": "アーヤ",
            "text": "…。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "真幌",
            "text": "アーヤ。",
            "zh": "绫水。",
            "narrator_zh": "真幌"
        },
        {
            "location": "172/TALK",
            "narrator": "アーヤ",
            "text": "あ、はい！",
            "zh": "啊，是！",
            "narrator_zh": "绫水"
        },
        {
            "location": "173/TALK",
            "narrator": "真幌",
            "text": "アーヤにはこれから\n精神世界に\nダイブしてもらう。",
            "zh": "接下来要让绫水\n潜入精神\n世界。",
            "narrator_zh": "真幌"
        },
        {
            "location": "175/TALK",
            "narrator": "アーヤ",
            "text": "え？",
            "zh": "哎？",
            "narrator_zh": "绫水"
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "どういう意味？",
            "zh": "这是什么意思？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "180/TALK",
            "narrator": "みやび",
            "text": "…そうきたかね。",
            "zh": "……来这招了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "181/TALK",
            "narrator": "真幌",
            "text": "この研究所で\nしていたことの\n予測は付いてるだろう。",
            "zh": "你应该也猜得到\n这座研究所里\n原本在做什么吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "182/TALK",
            "narrator": "真幌",
            "text": "クランとフェノメノン。\nそしてトライガジェット。",
            "zh": "库兰与PhenoMENON。\n还有Tri-Gadget。",
            "narrator_zh": "真幌"
        },
        {
            "location": "183/TALK",
            "narrator": "真幌",
            "text": "エリカはそういった\n研究をしていた。",
            "zh": "领火做的就是\n这方面的研究。",
            "narrator_zh": "真幌"
        },
        {
            "location": "184/TALK",
            "narrator": "真幌",
            "text": "そして今回、\n音羽を再生するため\n必要なものがここにある。",
            "zh": "而这一次，\n为了再生音羽\n所必需的东西就在这里。",
            "narrator_zh": "真幌"
        },
        {
            "location": "185/TALK",
            "narrator": "真幌",
            "text": "そのキーになるのが\nアーヤなんだ。",
            "zh": "其中的关键\n就是绫水。",
            "narrator_zh": "真幌"
        },
        {
            "location": "186/TALK",
            "narrator": "アーヤ",
            "text": "私…？",
            "zh": "我……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "真幌",
            "text": "そう。",
            "zh": "是的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "188/TALK",
            "narrator": "真幌",
            "text": "音羽の精神世界に\nダイブして音羽を\n修復する。",
            "zh": "潜入音羽的\n精神世界，\n将音羽修复。",
            "narrator_zh": "真幌"
        },
        {
            "location": "189/TALK",
            "narrator": "真幌",
            "text": "そのための設備が\nこの更に下にある巨大な\nサイクロトロンだ。",
            "zh": "为此所需的设备，\n就是位于这更下方的巨大\n回旋加速器。",
            "narrator_zh": "真幌"
        },
        {
            "location": "190/TALK",
            "narrator": "真幌",
            "text": "そしてサイクロトロンを\n動かすことは\nアーヤにしかできない。",
            "zh": "而能够启动\n那台回旋加速器的\n只有绫水。",
            "narrator_zh": "真幌"
        },
        {
            "location": "192/TALK",
            "narrator": "アーヤ",
            "text": "…ええと？\n私ここに来たことすら\nないですし……。",
            "zh": "……哎？\n我甚至连来都没\n来过这里啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "193/TALK",
            "narrator": "真幌",
            "text": "サイクロトロンには\n一種の生体認証が\n使われていてな。",
            "zh": "回旋加速器上\n使用了一种\n生物识别认证。",
            "narrator_zh": "真幌"
        },
        {
            "location": "194/TALK",
            "narrator": "真幌",
            "text": "その条件に合うのが\nアーヤなんだ。",
            "zh": "符合那个条件的\n就是绫水。",
            "narrator_zh": "真幌"
        },
        {
            "location": "197/TALK",
            "narrator": "アーヤ",
            "text": "…なんで…。",
            "zh": "……为什么……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "200/TALK",
            "narrator": "ガブリエラ",
            "text": "お姉さんが\nアーヤを信用してたって\nことじゃない？",
            "zh": "这不就说明\n你姐姐一直很信任\n绫水吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/TALK",
            "narrator": "みやび",
            "text": "誰がスパイか\nわかったもんじゃ\nないきね。",
            "zh": "毕竟谁是间谍\n都说不准\n嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "204/TALK",
            "narrator": "みやび",
            "text": "けんど、使えるのが\n自分だけとなると\n万が一に対応できん。",
            "zh": "不过，要是只有\n自己能用的话，\n万一出事就应付不过来了。",
            "narrator_zh": "雅"
        },
        {
            "location": "205/TALK",
            "narrator": "みやび",
            "text": "やき、一番信用できる\n人間に権限を\n与えておいた。",
            "zh": "所以，才把权限\n交给了最信得过的\n人啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "206/TALK",
            "narrator": "みやび",
            "text": "ちうことやと\n思うけんど。",
            "zh": "我想大概就是\n这么回事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "207/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/TALK",
            "narrator": "真幌",
            "text": "やってくれるか？",
            "zh": "你愿意做吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "209/SEL",
            "narrator": "",
            "text": "アーヤならできるよ",
            "zh": "绫水的话一定能做到的",
            "narrator_zh": ""
        },
        {
            "location": "210/ACT",
            "narrator": "",
            "text": "アーヤならできるよ",
            "zh": "绫水的话一定能做到的",
            "narrator_zh": ""
        },
        {
            "location": "227/TALK",
            "narrator": "アーヤ",
            "text": "そんなこと言われても",
            "zh": "就算你这么说",
            "narrator_zh": "绫水"
        },
        {
            "location": "229/SEL",
            "narrator": "",
            "text": "大丈夫だって",
            "zh": "会没事的",
            "narrator_zh": ""
        },
        {
            "location": "230/SEL",
            "narrator": "",
            "text": "$me$がついてる",
            "zh": "有$me$在呢",
            "narrator_zh": ""
        },
        {
            "location": "231/SEL",
            "narrator": "",
            "text": "アーヤにしかできないことだよ",
            "zh": "这是只有绫水能做到的事哦",
            "narrator_zh": ""
        },
        {
            "location": "232/ACT",
            "narrator": "",
            "text": "大丈夫だって",
            "zh": "会没事的",
            "narrator_zh": ""
        },
        {
            "location": "233/TALK",
            "narrator": "アーヤ",
            "text": "簡単に言わないで",
            "zh": "别说得这么轻松",
            "narrator_zh": "绫水"
        },
        {
            "location": "234/ACT",
            "narrator": "",
            "text": "$me$がついてる",
            "zh": "有$me$在呢",
            "narrator_zh": ""
        },
        {
            "location": "235/TALK",
            "narrator": "アーヤ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "236/TALK",
            "narrator": "アーヤ",
            "text": "そうだけど、、、",
            "zh": "话虽如此……",
            "narrator_zh": "绫水"
        },
        {
            "location": "237/ACT",
            "narrator": "",
            "text": "アーヤにしかできないことだよ",
            "zh": "这是只有绫水能做到的事哦",
            "narrator_zh": ""
        },
        {
            "location": "238/TALK",
            "narrator": "アーヤ",
            "text": "そうだけど、、、",
            "zh": "话虽如此……",
            "narrator_zh": "绫水"
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "まほさん。",
            "zh": "真幌。",
            "narrator_zh": "雅"
        },
        {
            "location": "254/TALK",
            "narrator": "真幌",
            "text": "ん？\n何だ？",
            "zh": "嗯？\n怎么了？",
            "narrator_zh": "真幌"
        },
        {
            "location": "255/TALK",
            "narrator": "みやび",
            "text": "アーヤがダイブ\nした時なんですけど。",
            "zh": "在绫水潜入\n的时候，",
            "narrator_zh": "雅"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "こちらでモニターする\n方法はありますか？",
            "zh": "我们这边有办法\n进行监控吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "アーヤが何をしているか\n危険なことはないか\nそういったことを。",
            "zh": "比如绫水在做什么、\n有没有遇到危险\n之类的情况。",
            "narrator_zh": "雅"
        },
        {
            "location": "258/TALK",
            "narrator": "真幌",
            "text": "…生体反応については\nあるはずだが……。",
            "zh": "……生理反应的话\n应该能看得到……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "259/TALK",
            "narrator": "真幌",
            "text": "その先となると…。",
            "zh": "至于更深层的情况就……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "260/TALK",
            "narrator": "アーヤ",
            "text": "何なの…。",
            "zh": "怎么这样……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "261/TALK",
            "narrator": "アーヤ",
            "text": "突然言われても\nどうすればいいのか\nわからないし……。",
            "zh": "突然这么跟我说，\n我也不知道该怎么\n办才好……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "263/TALK",
            "narrator": "アーヤ",
            "text": "それにやっぱり\nちょっと怖い…。",
            "zh": "而且果然还是\n有点害怕……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "264/SEL",
            "narrator": "",
            "text": "$me$も一緒に行くよ",
            "zh": "$me$也一起去哦",
            "narrator_zh": ""
        },
        {
            "location": "265/ACT",
            "narrator": "",
            "text": "$me$も一緒に行くよ",
            "zh": "$me$也一起去哦",
            "narrator_zh": ""
        },
        {
            "location": "282/TALK",
            "narrator": "アーヤ",
            "text": "そんなことできるの？",
            "zh": "这种事做得到吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "284/SEL",
            "narrator": "",
            "text": "当然",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "285/SEL",
            "narrator": "",
            "text": "$me$を誰だと思ってるの？",
            "zh": "你把$me$当成谁了？",
            "narrator_zh": ""
        },
        {
            "location": "286/SEL",
            "narrator": "",
            "text": "そういう選択肢が出たから多分行けるんだと思う",
            "zh": "既然出了这个选项，大概就能过去吧",
            "narrator_zh": ""
        },
        {
            "location": "287/ACT",
            "narrator": "",
            "text": "当然",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "288/TALK",
            "narrator": "アーヤ",
            "text": "すごい自信ね",
            "zh": "好大的自信呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "290/ACT",
            "narrator": "",
            "text": "$me$を誰だと思ってるの？",
            "zh": "你把$me$当成谁了？",
            "narrator_zh": ""
        },
        {
            "location": "292/TALK",
            "narrator": "アーヤ",
            "text": "いや",
            "zh": "不",
            "narrator_zh": "绫水"
        },
        {
            "location": "293/TALK",
            "narrator": "アーヤ",
            "text": "$handle2$でしょ",
            "zh": "不就是$handle2$吗",
            "narrator_zh": "绫水"
        },
        {
            "location": "295/ACT",
            "narrator": "",
            "text": "そういう選択肢が出たから多分行けるんだと思う",
            "zh": "既然出了这个选项，大概就能过去吧",
            "narrator_zh": ""
        },
        {
            "location": "296/TALK",
            "narrator": "アーヤ",
            "text": "適当ね",
            "zh": "真随便呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "310/TALK",
            "narrator": "アーヤ",
            "text": "…怖いけど…。",
            "zh": "……虽然很害怕……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "311/TALK",
            "narrator": "アーヤ",
            "text": "私以外にできる人は\nいないんだし……。",
            "zh": "但除了我之外\n也没有别人能做了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "それに\n$handle$さんも\n来てくれるって言うし。",
            "zh": "而且\n$handle$也说\n会陪我一起去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "314/TALK",
            "narrator": "アーヤ",
            "text": "…覚悟決めなきゃね…。",
            "zh": "……必须下定决心才行呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "345/SEL",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "346/ACT",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "350/TALK",
            "narrator": "エヴェレット",
            "text": "こんにちは",
            "zh": "你好",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "351/SEL",
            "narrator": "",
            "text": "エヴェレットも白烏もどうしちゃったの！？",
            "zh": "艾弗雷特和白鸦都怎么了！？",
            "narrator_zh": ""
        },
        {
            "location": "352/ACT",
            "narrator": "",
            "text": "エヴェレットも白烏もどうしちゃったの！？",
            "zh": "艾弗雷特和白鸦都怎么了！？",
            "narrator_zh": ""
        },
        {
            "location": "354/TALK",
            "narrator": "エヴェレット",
            "text": "$handle$さんに、お願いがあります",
            "zh": "我有件事，想拜托$handle$",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "355/TALK",
            "narrator": "エヴェレット",
            "text": "1x0FFに来てください",
            "zh": "请来1x0FF一趟",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "356/TALK",
            "narrator": "エヴェレット",
            "text": "そこには私のセルフクランがいます。彼女と話をして欲しい",
            "zh": "那里有我的自身库兰。希望你能和她谈谈",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "357/SEL",
            "narrator": "",
            "text": "どんな話？",
            "zh": "什么话？",
            "narrator_zh": ""
        },
        {
            "location": "358/SEL",
            "narrator": "",
            "text": "二人とも大丈夫！？",
            "zh": "你们两个没事吧！？",
            "narrator_zh": ""
        },
        {
            "location": "359/ACT",
            "narrator": "",
            "text": "どんな話？",
            "zh": "什么话？",
            "narrator_zh": ""
        },
        {
            "location": "360/TALK",
            "narrator": "エヴェレット",
            "text": "それは、私たちの存在にかかわる話",
            "zh": "那是，关系到我们存在的话",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "361/TALK",
            "narrator": "エヴェレット",
            "text": "お願い、早く",
            "zh": "拜托了，快点",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "362/ACT",
            "narrator": "",
            "text": "二人とも大丈夫！？",
            "zh": "你们两个没事吧！？",
            "narrator_zh": ""
        },
        {
            "location": "363/TALK",
            "narrator": "エヴェレット",
            "text": "あまり大丈夫じゃない",
            "zh": "情况不太乐观",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "364/TALK",
            "narrator": "エヴェレット",
            "text": "だから、早く",
            "zh": "所以，快点",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "366/TALK",
            "narrator": "エヴェレット",
            "text": "私も後から行くから",
            "zh": "我之后也会过去的",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "367/TALK",
            "narrator": "エヴェレット",
            "text": "決心がついたら、、",
            "zh": "等我下定决心以后……",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "370/SEL",
            "narrator": "",
            "text": "EXEC_SEEK_SECTOR/.",
            "zh": "EXEC_SEEK_SECTOR/.",
            "narrator_zh": ""
        },
        {
            "location": "371/SEL",
            "narrator": "",
            "text": "EXEC_SUSPEND/.",
            "zh": "EXEC_SUSPEND/.",
            "narrator_zh": ""
        },
        {
            "location": "375/SEL",
            "narrator": "",
            "text": "Type::KokoroError",
            "zh": "Type::KokoroError",
            "narrator_zh": ""
        },
        {
            "location": "376/SEL",
            "narrator": "",
            "text": "Type::Addr::C2:9:311//1x0FF",
            "zh": "Type::Addr::C2:9:311//1x0FF",
            "narrator_zh": ""
        },
        {
            "location": "377/SEL",
            "narrator": "",
            "text": "Back",
            "zh": "Back",
            "narrator_zh": ""
        },
        {
            "location": "409/TALK",
            "narrator": "水鏡の神子",
            "text": "貴方は…\n$handle$ね。",
            "zh": "你是……\n$handle$吧。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "410/SEL",
            "narrator": "",
            "text": "セルフクラン！？",
            "zh": "自身库兰！？",
            "narrator_zh": ""
        },
        {
            "location": "411/ACT",
            "narrator": "",
            "text": "セルフクラン！？",
            "zh": "自身库兰！？",
            "narrator_zh": ""
        },
        {
            "location": "413/TALK",
            "narrator": "水鏡の神子",
            "text": "ええ、そうよ。\n私は水鏡の神子。",
            "zh": "是的，没错。\n我是水镜之巫女。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "414/TALK",
            "narrator": "水鏡の神子",
            "text": "いつも國政綾水を\n支えてくれてありがとう。",
            "zh": "谢谢你一直以来的支持，\n守护着国政绫水。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "415/SEL",
            "narrator": "",
            "text": "いえいえ、こちらこそ",
            "zh": "哪里哪里，彼此彼此",
            "narrator_zh": ""
        },
        {
            "location": "416/SEL",
            "narrator": "",
            "text": "自分の事なのに他人行儀な言い方だね",
            "zh": "明明是你自己的事，说话却这么见外啊",
            "narrator_zh": ""
        },
        {
            "location": "417/ACT",
            "narrator": "",
            "text": "いえいえ、こちらこそ",
            "zh": "哪里哪里，彼此彼此",
            "narrator_zh": ""
        },
        {
            "location": "418/TALK",
            "narrator": "水鏡の神子",
            "text": "さて。",
            "zh": "那么。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "419/ACT",
            "narrator": "",
            "text": "自分の事なのに他人行儀な言い方だね",
            "zh": "明明是你自己的事，说话却这么见外啊",
            "narrator_zh": ""
        },
        {
            "location": "421/TALK",
            "narrator": "水鏡の神子",
            "text": "そうね。\n私は國政綾水を\n客観的に見る存在だから。",
            "zh": "是啊。\n因为我是从客观视角\n看待国政绫水的存在。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "422/TALK",
            "narrator": "水鏡の神子",
            "text": "それに、現在においては\n似て非なる存在でもある。",
            "zh": "而且就现在而言，\n我们也已经是似是而非的存在了。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "423/TALK",
            "narrator": "水鏡の神子",
            "text": "さて。",
            "zh": "那么。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "425/TALK",
            "narrator": "水鏡の神子",
            "text": "来ていただいて\n早々にお願いするのも\n恐縮ではありますが――",
            "zh": "刚一请你过来\n就要开口相求，\n实在有失礼数——",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "426/TALK",
            "narrator": "水鏡の神子",
            "text": "$handle$に\n頼みがあります。",
            "zh": "我有件事想拜托\n$handle$。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "427/SEL",
            "narrator": "",
            "text": "何なりと",
            "zh": "什么事尽管说",
            "narrator_zh": ""
        },
        {
            "location": "428/SEL",
            "narrator": "",
            "text": "内容による",
            "zh": "要看是什么内容",
            "narrator_zh": ""
        },
        {
            "location": "429/ACT",
            "narrator": "",
            "text": "何なりと",
            "zh": "什么事尽管说",
            "narrator_zh": ""
        },
        {
            "location": "430/TALK",
            "narrator": "水鏡の神子",
            "text": "ありがとう。",
            "zh": "谢谢。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "431/ACT",
            "narrator": "",
            "text": "内容による",
            "zh": "要看是什么内容",
            "narrator_zh": ""
        },
        {
            "location": "432/TALK",
            "narrator": "水鏡の神子",
            "text": "貴方は國政綾水を\n心から支えてくれる\n方だから大丈夫。",
            "zh": "你是发自内心\n支持国政绫水的人，\n所以没问题的。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "434/TALK",
            "narrator": "水鏡の神子",
            "text": "私には\nやらねばならない\n使命があります。",
            "zh": "我有着\n必须去履行的\n使命。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "435/TALK",
            "narrator": "水鏡の神子",
            "text": "ですが現状はといえば、\nその道筋は大きくぶれ、\n非常に深刻な状況です。",
            "zh": "然而事到如今，\n那条道路已严重偏离，\n局势十分严峻。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "436/TALK",
            "narrator": "水鏡の神子",
            "text": "その状況を打破するため、\n司書という存在を\n抹消せねばなりません。",
            "zh": "为了打破这一局面，\n必须抹消名为司书的\n存在。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "437/SEL",
            "narrator": "",
            "text": "なぜ！？",
            "zh": "为什么！？",
            "narrator_zh": ""
        },
        {
            "location": "438/ACT",
            "narrator": "",
            "text": "なぜ！？",
            "zh": "为什么！？",
            "narrator_zh": ""
        },
        {
            "location": "440/TALK",
            "narrator": "水鏡の神子",
            "text": "司書制度は、私の\n輝ける未来への希望を\n下支えする存在。",
            "zh": "司书制度，本是支撑\n我迈向辉煌未来的希望\n的基石。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "441/TALK",
            "narrator": "水鏡の神子",
            "text": "しかし私の総意は、\n二度もその職務を全う\nしない人格を選抜した。",
            "zh": "然而我的总体意志，\n却接连两次选拔出了\n未能尽责的人格。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "442/SEL",
            "narrator": "",
            "text": "何をしたの？",
            "zh": "她们做了什么？",
            "narrator_zh": ""
        },
        {
            "location": "443/ACT",
            "narrator": "",
            "text": "何をしたの？",
            "zh": "她们做了什么？",
            "narrator_zh": ""
        },
        {
            "location": "445/TALK",
            "narrator": "水鏡の神子",
            "text": "私の思想に\n疑問を抱きました。",
            "zh": "她们对我的思想\n产生了怀疑。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "446/TALK",
            "narrator": "水鏡の神子",
            "text": "その為、\n一人は指導者たる\n千羽鶴に排除され――",
            "zh": "因此，\n其中一人被身为指导者的\n千羽鹤所排除——",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "447/TALK",
            "narrator": "水鏡の神子",
            "text": "もう一人は、\n私自らが排除しました。",
            "zh": "而另一人，\n则由我亲自排除了。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "448/TALK",
            "narrator": "水鏡の神子",
            "text": "そこで、貴方に\nお願いしたいことは１つ。",
            "zh": "于是，我有一件事\n想拜托你。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "449/TALK",
            "narrator": "水鏡の神子",
            "text": "司書の代理として、\n私のビジョンを実現する\n下支えをして戴きたい。",
            "zh": "希望你能作为司书的代理，\n协助支撑起\n我愿景的实现。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "450/TALK",
            "narrator": "水鏡の神子",
            "text": "國政綾水と共に、\nこれからもずっと\n歩んで頂けるなら――",
            "zh": "如果你愿意与国政绫水\n一同，今后也一直\n走下去的话——",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "451/TALK",
            "narrator": "水鏡の神子",
            "text": "このお願いは、とても\n重要なものになります。",
            "zh": "这个请求，就会成为\n至关重要的事情。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "452/SEL",
            "narrator": "",
            "text": "具体的には何をすればいいの？",
            "zh": "具体来说要我做什么？",
            "narrator_zh": ""
        },
        {
            "location": "453/SEL",
            "narrator": "",
            "text": "エヴェレットたちを返して！",
            "zh": "把艾弗雷特她们还回来！",
            "narrator_zh": ""
        },
        {
            "location": "454/ACT",
            "narrator": "",
            "text": "具体的には何をすればいいの？",
            "zh": "具体来说要我做什么？",
            "narrator_zh": ""
        },
        {
            "location": "456/TALK",
            "narrator": "水鏡の神子",
            "text": "貴方には\n特別な力があります。",
            "zh": "你拥有着\n特殊的力量。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "457/TALK",
            "narrator": "水鏡の神子",
            "text": "その力をどうか\n貸して頂きたい。",
            "zh": "还请务必将那份力量\n借给我。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "458/TALK",
            "narrator": "水鏡の神子",
            "text": "本来なら、この嘆願は\n司書の役目なのですが。",
            "zh": "本来，这份恳求\n应当由司书来承担。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "459/TALK",
            "narrator": "水鏡の神子",
            "text": "それを私が直接言わねば\nならないとは、全く\n不甲斐ないことです……。",
            "zh": "竟沦落到需要我\n亲自开口的地步，\n实在是太不争气了……。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "460/SEL",
            "narrator": "",
            "text": "エヴェレットたちは何故役割を果たさなかったの？",
            "zh": "艾弗雷特她们为什么没有履行职责？",
            "narrator_zh": ""
        },
        {
            "location": "461/ACT",
            "narrator": "",
            "text": "エヴェレットたちは何故役割を果たさなかったの？",
            "zh": "艾弗雷特她们为什么没有履行职责？",
            "narrator_zh": ""
        },
        {
            "location": "463/TALK",
            "narrator": "水鏡の神子",
            "text": "本人の凝り固まった\n観念に囚われて、司書に\n否定的だったのでしょう。",
            "zh": "大概是被自身固执的\n观念所束缚，从而对司书\n持否定态度了吧。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "464/TALK",
            "narrator": "水鏡の神子",
            "text": "だから、全く毛色の違う\n二人の人格が、全く同じ\n事をして消されてました。",
            "zh": "所以，性格截然不同的\n两个人格，才会做出\n完全相同的事而被消除。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "465/TALK",
            "narrator": "水鏡の神子",
            "text": "私も総元締として\n責任を感じます。特に\nエヴェレットには。",
            "zh": "我作为总负责人也感到\n责任重大。尤其是\n对艾弗雷特。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "466/SEL",
            "narrator": "",
            "text": "エヴェレットに何があったの？",
            "zh": "艾弗雷特怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "467/ACT",
            "narrator": "",
            "text": "エヴェレットに何があったの？",
            "zh": "艾弗雷特怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "470/ACT",
            "narrator": "",
            "text": "エヴェレットたちを返して！",
            "zh": "把艾弗雷特她们还回来！",
            "narrator_zh": ""
        },
        {
            "location": "471/TALK",
            "narrator": "水鏡の神子",
            "text": "白烏は、心配せずとも\n私の大役が終われば\n解放します。",
            "zh": "白鸦的话不用担心，\n只要我的大任完成\n就会释放她。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "472/TALK",
            "narrator": "水鏡の神子",
            "text": "そして従来通りの\n人格としての役割を\n担うことでしょう。",
            "zh": "届时她应该就会\n回归以往的人格，\n继续承担原来的职责。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "473/TALK",
            "narrator": "水鏡の神子",
            "text": "ですが、エヴェレットは\nその類ではありません。",
            "zh": "但是，艾弗雷特\n却不属于那一类。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "474/SEL",
            "narrator": "",
            "text": "千羽鶴にやられたから？",
            "zh": "是因为被千羽鹤干掉了吗？",
            "narrator_zh": ""
        },
        {
            "location": "475/ACT",
            "narrator": "",
            "text": "千羽鶴にやられたから？",
            "zh": "是因为被千羽鹤干掉了吗？",
            "narrator_zh": ""
        },
        {
            "location": "477/TALK",
            "narrator": "水鏡の神子",
            "text": "いいえ。\nその程度であれば、\nすぐに戻せます。",
            "zh": "不是的。\n那种程度的话，\n很快就能复原。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "479/TALK",
            "narrator": "水鏡の神子",
            "text": "彼女は、\n発症してしまったのです。",
            "zh": "她啊，\n已经发作了。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "480/SEL",
            "narrator": "",
            "text": "どういうこと！？",
            "zh": "什么意思！？",
            "narrator_zh": ""
        },
        {
            "location": "481/ACT",
            "narrator": "",
            "text": "どういうこと！？",
            "zh": "什么意思！？",
            "narrator_zh": ""
        },
        {
            "location": "483/TALK",
            "narrator": "水鏡の神子",
            "text": "その言葉の意味の通り。",
            "zh": "就是字面上的意思。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "484/TALK",
            "narrator": "水鏡の神子",
            "text": "エヴェレットは、\n私のビジョンを頑なに\n否定し、阻止しました。",
            "zh": "艾弗雷特她，\n顽固地否定并阻止了\n我的愿景。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "485/TALK",
            "narrator": "水鏡の神子",
            "text": "その想いが募り、\n自己発症したのです。",
            "zh": "那份执念不断积聚，\n最终自我发作了。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "486/TALK",
            "narrator": "水鏡の神子",
            "text": "もはや、かなり\n前のことになりますが。",
            "zh": "虽然这已经是\n相当久之前的事了。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "487/SEL",
            "narrator": "",
            "text": "今はどうしてるの！？",
            "zh": "她现在怎么样了！？",
            "narrator_zh": ""
        },
        {
            "location": "488/ACT",
            "narrator": "",
            "text": "今はどうしてるの！？",
            "zh": "她现在怎么样了！？",
            "narrator_zh": ""
        },
        {
            "location": "490/TALK",
            "narrator": "水鏡の神子",
            "text": "私にはわかりませんが…。",
            "zh": "我也不清楚……。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "491/TALK",
            "narrator": "水鏡の神子",
            "text": "消滅はしていません。\n恐らく何処かにいるはず。",
            "zh": "她并没有消灭。\n恐怕还在某处吧。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "492/SEL",
            "narrator": "",
            "text": "エヴェレット、どういうこと！？",
            "zh": "艾弗雷特，这是怎么回事！？",
            "narrator_zh": ""
        },
        {
            "location": "493/ACT",
            "narrator": "",
            "text": "エヴェレット、どういうこと！？",
            "zh": "艾弗雷特，这是怎么回事！？",
            "narrator_zh": ""
        },
        {
            "location": "496/TALK",
            "narrator": "エヴェレット",
            "text": "バレちゃったか",
            "zh": "还是暴露了吗",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "497/SEL",
            "narrator": "",
            "text": "発症しちゃったの！？",
            "zh": "你发作了吗！？",
            "narrator_zh": ""
        },
        {
            "location": "498/ACT",
            "narrator": "",
            "text": "発症しちゃったの！？",
            "zh": "你发作了吗！？",
            "narrator_zh": ""
        },
        {
            "location": "500/TALK",
            "narrator": "エヴェレット",
            "text": "こうするしかなかった",
            "zh": "我也是没办法才这样的",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "501/TALK",
            "narrator": "エヴェレット",
            "text": "1xに閉じこめられたとき、私は人格ごと消されかけた",
            "zh": "被关进1x的时候，我差点连同人格一起被抹消",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "502/TALK",
            "narrator": "エヴェレット",
            "text": "絶対消されたくないという想いから発症するのには、そんなに時間は必要無かった",
            "zh": "因为无论如何都不想被抹消，这份念头没花多少时间就让我发作了",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "503/TALK",
            "narrator": "エヴェレット",
            "text": "お陰で私は今でも存在していられているけど",
            "zh": "多亏那样，我现在才还能继续存在下去",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "504/TALK",
            "narrator": "エヴェレット",
            "text": "もう司書でもなんでもないし、水鏡の神子にも不要とされてる",
            "zh": "我已经既不是司书也不是什么了，也被水镜之巫女当成不需要的存在",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "505/TALK",
            "narrator": "エヴェレット",
            "text": "けど、それでも私は、私が大好きな人格で、貴方のことも大好きな人格だから",
            "zh": "可是，即便如此，我也还是最喜欢自己的人格，也是最喜欢你的人格",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "506/TALK",
            "narrator": "エヴェレット",
            "text": "消えるのだけは絶対嫌だったの",
            "zh": "所以唯独消失这件事，我绝对不愿意",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "507/TALK",
            "narrator": "エヴェレット",
            "text": "お願い、私を呼んで",
            "zh": "求你了，呼唤我吧",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "509/TALK",
            "narrator": "エヴェレット",
            "text": "貴方に見られるのはちょっと恥ずかしいけど",
            "zh": "被你看到现在的样子虽然有点害羞",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "510/TALK",
            "narrator": "エヴェレット",
            "text": "久し振りに逢えるからうれしい",
            "zh": "但好久没见面了，能再见到你我真的很开心",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "512/SEL",
            "narrator": "",
            "text": "Jump::C2:9:311//1x0FF::EVERETT",
            "zh": "Jump::C2:9:311//1x0FF::EVERETT",
            "narrator_zh": ""
        },
        {
            "location": "526/SEL",
            "narrator": "",
            "text": "え！？",
            "zh": "哎！？",
            "narrator_zh": ""
        },
        {
            "location": "527/ACT",
            "narrator": "",
            "text": "え！？",
            "zh": "哎！？",
            "narrator_zh": ""
        },
        {
            "location": "529/TALK",
            "narrator": "昇華エヴェレット",
            "text": "$handle$さん……\nお久し振り。",
            "zh": "$handle$……\n好久不见。",
            "narrator_zh": "升华艾弗雷特"
        },
        {
            "location": "541/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "542/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "否",
            "narrator_zh": ""
        },
        {
            "location": "543/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "551/ACT",
