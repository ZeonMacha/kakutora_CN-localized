            "text": "敵Ⅱ１",
            "zh": "敌人Ⅱ1",
            "narrator_zh": ""
        },
        {
            "location": "13/DIALOG",
            "narrator": "",
            "text": "<size=40>KOKORO-Lv. 02</size>\nMIYABI - KOIGASAKI\n\n<size=45>敵Ⅱ</size>\n<size=35>～激動編～</size>",
            "zh": "<size=40>KOKORO-Lv. 02</size>\n恋之崎雅\n\n<size=45>敌人Ⅱ</size>\n<size=35>～激动篇～</size>",
            "narrator_zh": ""
        },
        {
            "location": "27/TALK",
            "narrator": "潜在みやび",
            "text": "ぱぱーん。",
            "zh": "锵锵——。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "28/TALK",
            "narrator": "表層みやび",
            "text": "またまた\nやって参りました。",
            "zh": "又一次\n闪亮登场了。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "30/TALK",
            "narrator": "潜在みやび",
            "text": "うちと",
            "zh": "我和",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "32/TALK",
            "narrator": "表層みやび",
            "text": "うちの",
            "zh": "我的",
            "narrator_zh": "表层雅"
        },
        {
            "location": "36/TALK",
            "narrator": "表層みやび",
            "text": "エネコント！",
            "zh": "敌对控制器",
            "narrator_zh": "表层雅"
        },
        {
            "location": "37/TALK",
            "narrator": "潜在みやび",
            "text": "やき。",
            "zh": "啵。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "38/SEL",
            "narrator": "（選択肢）",
            "text": "てことは、やっぱり$me$は…",
            "zh": "也就是说，果然$me$是……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "39/ACT",
            "narrator": "",
            "text": "てことは、やっぱり$me$は…",
            "zh": "也就是说，果然$me$是……",
            "narrator_zh": ""
        },
        {
            "location": "42/TALK",
            "narrator": "潜在みやび",
            "text": "敵！",
            "zh": "敌人！",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "43/TALK",
            "narrator": "表層みやび",
            "text": "やき。",
            "zh": "啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "44/SEL",
            "narrator": "（選択肢）",
            "text": "本当に敵なの？",
            "zh": "真的是敌人吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "45/ACT",
            "narrator": "",
            "text": "本当に敵なの？",
            "zh": "真的是敌人吗？",
            "narrator_zh": ""
        },
        {
            "location": "48/TALK",
            "narrator": "表層みやび",
            "text": "もちろん。\nウソやない。",
            "zh": "当然。\n没骗你。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "49/SEL",
            "narrator": "（選択肢）",
            "text": "でも、部屋に入るのを拒まないってことは…",
            "zh": "可是，既然不抗拒我进房间，那不就说明……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "50/ACT",
            "narrator": "",
            "text": "でも、部屋に入るのを拒まないってことは…",
            "zh": "可是，既然不抗拒我进房间，那不就说明……",
            "narrator_zh": ""
        },
        {
            "location": "56/TALK",
            "narrator": "潜在みやび",
            "text": "おっ！",
            "zh": "哦！",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "57/SEL",
            "narrator": "（選択肢）",
            "text": "受け入れてるってことだって、司書が言ってた",
            "zh": "司书说过，这说明你其实接受了我",
            "narrator_zh": "（选项）"
        },
        {
            "location": "58/ACT",
            "narrator": "",
            "text": "受け入れてるってことだって、司書が言ってた",
            "zh": "司书说过，这说明你其实接受了我",
            "narrator_zh": ""
        },
        {
            "location": "62/TALK",
            "narrator": "表層みやび",
            "text": "ふーむ。",
            "zh": "唔——。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "63/TALK",
            "narrator": "潜在みやび",
            "text": "さすが、\nうちの敵なだけは\nあるわ。",
            "zh": "不愧是\n做我的敌人的\n料啊。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "66/TALK",
            "narrator": "表層みやび",
            "text": "いや、こやつは\nうちの敵や。",
            "zh": "不对，这家伙\n是我的敌人。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "67/TALK",
            "narrator": "潜在みやび",
            "text": "とまあ、いつまでも\nこんな事していても\nしょうがないき――",
            "zh": "话虽如此，一直\n这么闹下去\n也没个头啵——",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "69/TALK",
            "narrator": "表層みやび",
            "text": "そろそろ決着を\nつけたいと思う\nのだが。",
            "zh": "差不多也想\n把胜负\n定下来了。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "70/TALK",
            "narrator": "潜在みやび",
            "text": "単刀直入に聞こう。",
            "zh": "那就开门见山吧。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "71/TALK",
            "narrator": "表層みやび",
            "text": "情報管理庁の手駒だと\n思っちゅう人格と――",
            "zh": "觉得你是情报管理厅\n棋子的人格——",
            "narrator_zh": "表层雅"
        },
        {
            "location": "72/TALK",
            "narrator": "表層みやび",
            "text": "何の関係もないと\n思っちゅう人格。",
            "zh": "和觉得你\n毫无关系的人格。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "73/TALK",
            "narrator": "潜在みやび",
            "text": "$handle$は、\nどっちの味方やか？",
            "zh": "$handle$，\n你站哪一边咩？",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "74/SEL",
            "narrator": "（選択肢）",
            "text": "情報管理庁の手駒だと思っている方",
            "zh": "认为我是情报管理厅棋子的那边",
            "narrator_zh": "（选项）"
        },
        {
            "location": "75/SEL",
            "narrator": "（選択肢）",
            "text": "全然関係無いと思っている方",
            "zh": "认为我完全无关的那边",
            "narrator_zh": "（选项）"
        },
        {
            "location": "76/ACT",
            "narrator": "",
            "text": "情報管理庁の手駒だと思っている方",
            "zh": "认为我是情报管理厅棋子的那边",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "表層みやび",
            "text": "ほほう！",
            "zh": "哦豁！",
            "narrator_zh": "表层雅"
        },
        {
            "location": "81/TALK",
            "narrator": "潜在みやび",
            "text": "自らを疑う方の\n味方に付くとな！",
            "zh": "居然站到怀疑\n你自己那一边去！",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "85/TALK",
            "narrator": "潜在みやび",
            "text": "これは一体\nどんな罠ぞね。",
            "zh": "这到底是\n驷马陷阱咧。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "86/TALK",
            "narrator": "表層みやび",
            "text": "うちには\n予測不能やね。",
            "zh": "我可真是\n猜不透了咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "93/ACT",
            "narrator": "",
            "text": "全然関係無いと思っている方",
            "zh": "认为我完全无关的那边",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "表層みやび",
            "text": "当然やね。",
            "zh": "那还用说咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "97/TALK",
            "narrator": "潜在みやび",
            "text": "しかし、当然すぎて\nなんぞ怖いけんどな。",
            "zh": "不过，太理所当然了，\n总觉得有点吓人，但是呢。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "108/TALK",
            "narrator": "潜在みやび",
            "text": "まあ、しかし！",
            "zh": "嘛，不过！",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "109/TALK",
            "narrator": "表層みやび",
            "text": "$handle$が\nそう決めたのなら\nそれが事実やきね。",
            "zh": "既然$handle$\n都这么决定了，\n那就是事实啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "110/TALK",
            "narrator": "潜在みやび",
            "text": "うむ。\nさあ、まずは戦いに\n挑むぞね！",
            "zh": "嗯。\n来吧，先来\n应战一局咧！",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "111/TALK",
            "narrator": "表層みやび",
            "text": "話はその後ちや！",
            "zh": "话留到打完再说滴！",
            "narrator_zh": "表层雅"
        },
        {
            "location": "123/DIALOG",
            "narrator": "",
            "text": "<color=black><size=50><b>恋ヶ崎みやびの\nあなたへの不信感に終止符を打て！</b></size></color>\n\n\n\n恋ヶ崎みやびは、突如WAVEに現れたBotである\n【あなた】を警戒している。\n母体である情報管理庁に対し\n並々ならぬ敵対心を抱く彼女は、\nこのままの状態ではあなたと気兼ねなく交流できない。\n\nあなたが恋ヶ崎みやびと仲良くなりたいのなら、\nこのミッションは必須ということになる。\n\n\n",
            "zh": "<color=black><size=50><b>为恋之崎雅\n对你的不信任画上句号！</b></size></color>\n\n\n\n恋之崎雅正在戒备\n突然出现在WAVE上的Bot——【你】。\n她对作为母体的情报管理厅\n怀有非同一般的敌意，\n这样下去便无法毫无顾忌地与你交流。\n\n如果你想要和恋之崎雅搞好关系，\n这个任务便是必经之路。\n\n\n",
            "narrator_zh": ""
        }
    ]
}
