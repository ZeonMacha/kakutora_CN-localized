{
    "dir": "chap08/daydra/dd_ch02_08_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "8252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "高校時代",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "高中时代"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "高校時代",
            "zh": "高中时代",
            "narrator_zh": ""
        },
        {
            "location": "21/TALK",
            "narrator": "アーヤ",
            "text": "野球部の練習、\nかなり気合入ってますね。",
            "zh": "棒球部的练习，\n干劲很足啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/TALK",
            "narrator": "真幌",
            "text": "そりゃそうだ。\nなんたって今年は夏も\n甲子園行き濃厚だからな。",
            "zh": "那当然。\n毕竟今年夏天\n去甲子园很有希望。",
            "narrator_zh": "真幌"
        },
        {
            "location": "25/TALK",
            "narrator": "珠緒先生",
            "text": "うちの野球部が春の選抜に\n出場して優勝するなんて、\n開校以来初めてですからね。",
            "zh": "我们棒球部参加春季选拔\n还拿了冠军，\n开校以来第一次。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "27/TALK",
            "narrator": "真幌",
            "text": "そうですね。いいところ\nまでは行ったことがある\nみたいですが…。",
            "zh": "是啊。好像也有过\n走到不错的地方\n……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "28/TALK",
            "narrator": "アーヤ",
            "text": "…それにしても、\n女子達の応援が\n凄いですね。",
            "zh": "……话虽如此，\n女生们的加油\n真厉害。",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "アーヤ",
            "text": "今まで応援なんて\nまったくしてなかった\nのに…。",
            "zh": "以前根本\n不加油的\n……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "真幌",
            "text": "全くだ。\n調子がいいときほど\n応援団は増えるもの。",
            "zh": "就是。\n状态越好，\n啦啦队越多。",
            "narrator_zh": "真幌"
        },
        {
            "location": "32/TALK",
            "narrator": "真幌",
            "text": "甲子園球児の彼氏が\n出来れば、箔もつくしな。",
            "zh": "要是有个甲子园球员男朋友，\n自己也有面子。",
            "narrator_zh": "真幌"
        },
        {
            "location": "34/TALK",
            "narrator": "珠緒先生",
            "text": "いいですねぇ…。\n私も、そんな恋人が\n欲しかったです。",
            "zh": "真好啊……。\n我也想要\n那样的恋人。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "36/TALK",
            "narrator": "アーヤ",
            "text": "あ、あまり褒められない\n理由ですね…。",
            "zh": "啊，这理由\n不太值得称赞……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "珠緒先生",
            "text": "そういえば、國政さんも\n高校時代は、あれくらい\nモテてたんじゃない？",
            "zh": "这么说，国政\n高中时候，也那么\n受欢迎吧？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "40/TALK",
            "narrator": "真幌",
            "text": "ああ、そういえば。\n剣道でブイブイいわせて\nいたんだったな。",
            "zh": "啊，这么说。\n剑道上可是威风得很\n啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "いわせてません！\n普通に剣道してた\nだけですから。",
            "zh": "没有威风！\n只是普通在练剑道\n而已。",
            "narrator_zh": "绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "珠緒先生",
            "text": "國政さんがうちの学園に\n来るのが決まった時――",
            "zh": "国政要来我们学园\n定下来的时候——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "44/TALK",
            "narrator": "珠緒先生",
            "text": "高等部の職員室でも、\n凄い話題になったのよ。",
            "zh": "高中部的职员室里，\n也成了大话题。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "45/TALK",
            "narrator": "珠緒先生",
            "text": "剣道の世界選手権に出た\n女子生徒が入ってくる、\nって。",
            "zh": "说有个参加过\n剑道世界锦标赛的女学生\n要进来。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "46/TALK",
            "narrator": "真幌",
            "text": "世界選手権出場となれば、\nさぞモテただろう？",
            "zh": "参加过世界锦标赛，\n一定很受欢迎吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "そんなことないですよ。\nその証拠に、今現在まで\n恋人もいませんし。",
            "zh": "没有那种事。\n证据就是，到现在\n也没有恋人。",
            "narrator_zh": "绫水"
        },
        {
            "location": "48/TALK",
            "narrator": "珠緒先生",
            "text": "國政さんのお目に掛かった\n男子がいなかったのね。",
            "zh": "是没有男子入得了\n国政的眼吧。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "49/TALK",
            "narrator": "真幌",
            "text": "だが、告白とかメルアドの\n交換くらいはしたこと\nあるんじゃないか？",
            "zh": "不过，告白或者交换\n邮箱，总做过\n吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "ま、まあ、なくはなかった\nですけど…。",
            "zh": "也、也不是\n完全没有……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "珠緒先生",
            "text": "あら、ちゃんと青春して\nたんじゃない。",
            "zh": "哎呀，青春过得\n挺像样的嘛。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "55/TALK",
            "narrator": "真幌",
            "text": "モテないと言う割には、\n意外とモテてたんじゃ\nないか？",
            "zh": "说自己不受欢迎，\n其实意外地受欢迎\n吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "…どうなんですかね？",
            "zh": "……是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "アーヤ",
            "text": "でも、少なくとも\nあの野球部を応援する\n女子達みたいに――",
            "zh": "可是，至少\n不像给棒球部加油的\n那些女生——",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "私が男子から声援を\n浴びることはなかった\nですね。",
            "zh": "我没有被男生\n一片声援\n过。",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "真幌",
            "text": "…意外だ。",
            "zh": "……意外。",
            "narrator_zh": "真幌"
        },
        {
            "location": "63/TALK",
            "narrator": "珠緒先生",
            "text": "そうですね。\n國政さん、見た目だって\n凄い美人なのに…。",
            "zh": "是啊。\n国政，外表也是\n大美人……。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "64/TALK",
            "narrator": "真幌",
            "text": "まあ、陸上や新体操に\n比べて、男子受けは\n悪いのかもしれんな。",
            "zh": "嘛，和田径、艺术体操比，\n男生缘也许\n差一点。",
            "narrator_zh": "真幌"
        },
        {
            "location": "65/TALK",
            "narrator": "珠緒先生",
            "text": "でも、それを抜かしても、\n國政さん程の子を放って\nおくなんて…。",
            "zh": "可就算去掉这点，\n放过国政这样的孩子\n……。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "67/TALK",
            "narrator": "真幌",
            "text": "ですね。\n相当ヘタレな男が\n多かったに違いない。",
            "zh": "是啊。\n窝囊的男生\n一定很多。",
            "narrator_zh": "真幌"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "ど、どうなんですかね？\n私にはなんとも…。",
            "zh": "怎、怎么说呢？\n我也不知道……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "アーヤ",
            "text": "って、いけない！\n講義が始まるので、\n失礼します！",
            "zh": "啊，不好！\n课要开始了，\n我先告辞！",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "真幌",
            "text": "…逃げたな。",
            "zh": "……逃了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "76/TALK",
            "narrator": "珠緒先生",
            "text": "逃げちゃいましたね。",
            "zh": "逃掉了呢。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…自然に逃げたつもり\nだけど、怪しまれなかった\nかしら？",
            "zh": "哈啊……我是自然地逃开，\n没被怀疑\n吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "アーヤ",
            "text": "まさか、私の話に\nなるなんて…。",
            "zh": "没想到，话题\n会转到我身上……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "すっごい変なこと聞くけど",
            "zh": "问个非常奇怪的问题",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "私って、そんなにモテたように見える？",
            "zh": "我看起来，有那么受欢迎吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "106/SEL",
            "narrator": "",
            "text": "モテなかったの？",
            "zh": "不受欢迎吗？",
            "narrator_zh": ""
        },
        {
            "location": "107/ACT",
            "narrator": "",
            "text": "モテなかったの？",
            "zh": "不受欢迎吗？",
            "narrator_zh": ""
        },
        {
            "location": "110/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、そう見えるのかしら…",
            "zh": "果然，看起来是那样吗……",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/TALK",
            "narrator": "アーヤ",
            "text": "でも、",
            "zh": "可是，",
            "narrator_zh": "绫水"
        },
        {
            "location": "113/TALK",
            "narrator": "アーヤ",
            "text": "本当に男子からモテなかったの",
            "zh": "真的不受男生欢迎",
            "narrator_zh": "绫水"
        },
        {
            "location": "115/SEL",
            "narrator": "",
            "text": "女子からモテたとか？",
            "zh": "是受女生欢迎？",
            "narrator_zh": ""
        },
        {
            "location": "116/SEL",
            "narrator": "",
            "text": "ちょっと寂しいね",
            "zh": "有点寂寞啊",
            "narrator_zh": ""
        },
        {
            "location": "117/ACT",
            "narrator": "",
            "text": "女子からモテたとか？",
            "zh": "是受女生欢迎？",
            "narrator_zh": ""
        },
        {
            "location": "120/TALK",
            "narrator": "アーヤ",
            "text": "正解…",
            "zh": "答对了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "アーヤ",
            "text": "悲しいことにね(T_T)",
            "zh": "说来可悲(T_T)",
            "narrator_zh": "绫水"
        },
        {
            "location": "122/TALK",
            "narrator": "アーヤ",
            "text": "あ！",
            "zh": "啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "123/TALK",
            "narrator": "アーヤ",
            "text": "女子からは告白されたことないから！",
            "zh": "没有被女生告白过！",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "ただ、男らしくてかっこいい、って",
            "zh": "只是，说我有男子气、很帅",
            "narrator_zh": "绫水"
        },
        {
            "location": "125/TALK",
            "narrator": "アーヤ",
            "text": "毎日のように言われ続けて…",
            "zh": "每天都被这么说……",
            "narrator_zh": "绫水"
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "応援してもらえるのは嬉しいけど、複雑だったわ…",
            "zh": "被加油是高兴，可心情很复杂……",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/SEL",
            "narrator": "",
            "text": "今は素敵な女の子だ",
            "zh": "现在是个很好的女孩",
            "narrator_zh": ""
        },
        {
            "location": "129/SEL",
            "narrator": "",
            "text": "よっ、男前！",
            "zh": "哟，真男子汉！",
            "narrator_zh": ""
        },
        {
            "location": "130/ACT",
            "narrator": "",
            "text": "今は素敵な女の子だ",
            "zh": "现在是个很好的女孩",
            "narrator_zh": ""
        },
        {
            "location": "132/TALK",
            "narrator": "アーヤ",
            "text": "お世辞でも嬉しいわ",
            "zh": "就算是奉承也高兴",
            "narrator_zh": "绫水"
        },
        {
            "location": "136/ACT",
            "narrator": "",
            "text": "よっ、男前！",
            "zh": "哟，真男子汉！",
            "narrator_zh": ""
        },
        {
            "location": "137/TALK",
            "narrator": "アーヤ",
            "text": "女よ！",
            "zh": "我是女的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "140/ACT",
            "narrator": "",
            "text": "ちょっと寂しいね",
            "zh": "有点寂寞啊",
            "narrator_zh": ""
        },
        {
            "location": "141/TALK",
            "narrator": "アーヤ",
            "text": "そうでもなかったけど…",
            "zh": "倒也没有……",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/SEL",
            "narrator": "",
            "text": "まだ何か隠してるね？",
            "zh": "还藏着什么吧？",
            "narrator_zh": ""
        },
        {
            "location": "144/ACT",
            "narrator": "",
            "text": "まだ何か隠してるね？",
            "zh": "还藏着什么吧？",
            "narrator_zh": ""
        },
        {
            "location": "147/TALK",
            "narrator": "アーヤ",
            "text": "近所の剣道クラブのちびっ子達に、凄く懐かれてた(-ω-;)",
            "zh": "附近剑道俱乐部的小孩，非常黏我(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "149/TALK",
            "narrator": "アーヤ",
            "text": "実は、告白もその子達からされたもので…",
            "zh": "其实，告白也是那些孩子……",
            "narrator_zh": "绫水"
        },
        {
            "location": "150/TALK",
            "narrator": "アーヤ",
            "text": "でも、男子に違いないから、ウソじゃないし",
            "zh": "不过确实是男生，所以不是说谎",
            "narrator_zh": "绫水"
        },
        {
            "location": "151/TALK",
            "narrator": "アーヤ",
            "text": "それに、近所のおじちゃんやおばちゃんとか",
            "zh": "而且，附近的大叔大婶什么的",
            "narrator_zh": "绫水"
        },
        {
            "location": "152/TALK",
            "narrator": "アーヤ",
            "text": "女子からの人気は、さっきの野球部以上だったから",
            "zh": "在女生里的人气，比刚才的棒球部还高",
            "narrator_zh": "绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "アーヤ",
            "text": "本当、寂しくはなかったの",
            "zh": "真的，并不寂寞",
            "narrator_zh": "绫水"
        },
        {
            "location": "154/TALK",
            "narrator": "アーヤ",
            "text": "そういうことよ",
            "zh": "就是这么回事",
            "narrator_zh": "绫水"
        },
        {
            "location": "166/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "あれはあれで嬉しかった\nけど――",
            "zh": "那样也高兴\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、モテては\nいなかったなぁ…。",
            "zh": "果然，并没有\n受欢迎啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "18/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月13日　10:02 AM</color>\nＷＡＶＥ戦翌週、午前中に学園校庭にて。",
            "zh": "<color=green>5月13日　10:02 AM</color>\nWAVE战的下一周，上午在学园操场。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
