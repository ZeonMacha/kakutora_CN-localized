    "entry": [
        {
            "location": "205/TALK",
            "narrator": "ガブリエラ",
            "text": "サバイバル入門なんて、私には必要ないわ",
            "zh": "生存入门什么的，我才不需要呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "207/TALK",
            "narrator": "ガブリエラ",
            "text": "子供の頃から、サバイバル術もちゃんと習ってきたんだし",
            "zh": "我从小就把生存术正经学过来了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "210/SEL",
            "narrator": "",
            "text": "火とか起こせたりする？",
            "zh": "比如生火你会吗？",
            "narrator_zh": ""
        },
        {
            "location": "211/ACT",
            "narrator": "",
            "text": "火とか起こせたりする？",
            "zh": "比如生火你会吗？",
            "narrator_zh": ""
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "習った最初の頃にやったわ",
            "zh": "刚开始学的时候做过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "215/TALK",
            "narrator": "ガブリエラ",
            "text": "あれ、難しいから今でも嫌いよ",
            "zh": "那个很难，我现在都还讨厌它",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、他にも食べられる野草の勉強とかも習ったけど",
            "zh": "嗯，还学过可食用野草之类的课",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "実践したことはないわ",
            "zh": "不过没实践过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "220/SEL",
            "narrator": "",
            "text": "大変だったんだね",
            "zh": "真不容易啊",
            "narrator_zh": ""
        },
        {
            "location": "221/ACT",
            "narrator": "",
            "text": "大変だったんだね",
            "zh": "真不容易啊",
            "narrator_zh": ""
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "楽しくもあったけれどね",
            "zh": "不过也挺快乐的哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/TALK",
            "narrator": "ガブリエラ",
            "text": "森で訓練してる時とか",
            "zh": "在森林里训练的时候",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "時々、洞窟とか見つけることもあって",
            "zh": "偶尔还会找到洞穴什么的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとした冒険心を駆り立てられもしたし",
            "zh": "也曾被激起一点小小的冒险心",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "また、ああいう経験出来ればいいんだけれど",
            "zh": "要是能再有一次那种经历就好了",
            "narrator_zh": "加布里埃拉"
        }
    ]
}
