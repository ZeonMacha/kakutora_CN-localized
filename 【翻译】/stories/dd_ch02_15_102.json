{
    "dir": "chap15/daydra/dd_ch02_15_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "15205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "ここは横須賀＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "这里是横须贺＜后篇＞"
    },
    "entry": [
        {
            "location": "431/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "433/TALK",
            "narrator": "雛",
            "text": "綾水様、\nどうかしましたか？",
            "zh": "绫水大人，\n怎么了吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "435/TALK",
            "narrator": "アーヤ",
            "text": "…あ、ごめんなさい。\nぼーっとしちゃってたわ。",
            "zh": "……啊，不好意思。\n不小心发呆了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "436/TALK",
            "narrator": "アーヤ",
            "text": "そろそろお昼時だし、\nどこかでランチでもどう？",
            "zh": "差不多到午饭时间了，\n要不要找个地方吃顿午饭？",
            "narrator_zh": "绫水"
        },
        {
            "location": "437/TALK",
            "narrator": "アーヤ",
            "text": "電車旅の楽しさを\n教えてくれたお礼に、\n何でも奢るわ。",
            "zh": "作为你告诉我电车旅行\n乐趣的谢礼，\n想吃什么我都请客。",
            "narrator_zh": "绫水"
        },
        {
            "location": "439/TALK",
            "narrator": "雛",
            "text": "いいんですか！？\nやったー！！",
            "zh": "可以吗！？\n太棒啦——！！",
            "narrator_zh": "雏"
        },
        {
            "location": "441/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…何がいいか、\nゆっくり考えて。",
            "zh": "呵呵……想吃什么，\n慢慢考虑吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "454/TALK",
            "narrator": "アーヤ",
            "text": "帰るのやめたわ(￣∇￣)",
            "zh": "我不回去了(￣∇￣)",
            "narrator_zh": "绫水"
        },
        {
            "location": "455/TALK",
            "narrator": "アーヤ",
            "text": "ランチ行ってくる(^^",
            "zh": "这就去吃午饭(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "457/SEL",
            "narrator": "",
            "text": "どんな心境の変化？",
            "zh": "心境发生什么变化了？",
            "narrator_zh": ""
        },
        {
            "location": "458/ACT",
            "narrator": "",
            "text": "どんな心境の変化？",
            "zh": "心境发生什么变化了？",
            "narrator_zh": ""
        },
        {
            "location": "460/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり",
            "zh": "总觉得",
            "narrator_zh": "绫水"
        },
        {
            "location": "461/TALK",
            "narrator": "アーヤ",
            "text": "このまま帰るなんて",
            "zh": "要是就这样直接回去",
            "narrator_zh": "绫水"
        },
        {
            "location": "462/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと素っ気ないし(￣Д￣ )",
            "zh": "未免太冷淡了(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "463/TALK",
            "narrator": "アーヤ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "绫水"
        },
        {
            "location": "464/TALK",
            "narrator": "アーヤ",
            "text": "ランチ食べながらなら",
            "zh": "如果边吃午饭边聊",
            "narrator_zh": "绫水"
        },
        {
            "location": "465/TALK",
            "narrator": "アーヤ",
            "text": "何かしら",
            "zh": "总能找到些",
            "narrator_zh": "绫水"
        },
        {
            "location": "466/TALK",
            "narrator": "アーヤ",
            "text": "話題も見つかると思うの(*^.^*)",
            "zh": "共同话题吧(*^.^*) ",
            "narrator_zh": "绫水"
        },
        {
            "location": "469/TALK",
            "narrator": "アーヤ",
            "text": "あと",
            "zh": "还有",
            "narrator_zh": "绫水"
        },
        {
            "location": "470/TALK",
            "narrator": "アーヤ",
            "text": "日向さん",
            "zh": "日向她",
            "narrator_zh": "绫水"
        },
        {
            "location": "471/TALK",
            "narrator": "アーヤ",
            "text": "私に憧れてるって",
            "zh": "以前也说过",
            "narrator_zh": "绫水"
        },
        {
            "location": "472/TALK",
            "narrator": "アーヤ",
            "text": "言ってたから(｡-_-｡)",
            "zh": "很崇拜我(｡-_-｡)",
            "narrator_zh": "绫水"
        },
        {
            "location": "473/TALK",
            "narrator": "アーヤ",
            "text": "なら",
            "zh": "那我想",
            "narrator_zh": "绫水"
        },
        {
            "location": "474/TALK",
            "narrator": "アーヤ",
            "text": "喜んでくれるかなって(・・。)ゞ",
            "zh": "她应该会开心的吧(・・。)ゞ",
            "narrator_zh": "绫水"
        },
        {
            "location": "478/TALK",
            "narrator": "アーヤ",
            "text": "私なら",
            "zh": "换作是我的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "479/TALK",
            "narrator": "アーヤ",
            "text": "憧れてる人と話せるの",
            "zh": "能和自己崇拜的人聊天",
            "narrator_zh": "绫水"
        },
        {
            "location": "480/TALK",
            "narrator": "アーヤ",
            "text": "嬉しいと思うから(^^",
            "zh": "也会觉得很开心嘛(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "483/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと自意識過剰？(-ω-;)",
            "zh": "这样算有点自作多情吗？(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "486/SEL",
            "narrator": "",
            "text": "今の雛は喜んでるよ",
            "zh": "现在的雏肯定很开心哦",
            "narrator_zh": ""
        },
        {
            "location": "487/ACT",
            "narrator": "",
            "text": "今の雛は喜んでるよ",
            "zh": "现在的雏肯定很开心哦",
            "narrator_zh": ""
        },
        {
            "location": "489/TALK",
            "narrator": "アーヤ",
            "text": "そうね",
            "zh": "是吗",
            "narrator_zh": "绫水"
        },
        {
            "location": "490/TALK",
            "narrator": "アーヤ",
            "text": "よかった(^^",
            "zh": "那太好了(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "502/TALK",
            "narrator": "アーヤ",
            "text": "…何食べたいか\n決まった？",
            "zh": "……决定好\n想吃什么了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "504/TALK",
            "narrator": "雛",
            "text": "はい！　横須賀の\nグルメといったら、\nアレだと思います！",
            "zh": "嗯！说到横须贺的\n美食，\n当然就是那个啦！",
            "narrator_zh": "雏"
        },
        {
            "location": "524/TALK",
            "narrator": "アーヤ",
            "text": "ご馳走様でした。",
            "zh": "多谢款待。",
            "narrator_zh": "绫水"
        },
        {
            "location": "525/TALK",
            "narrator": "雛",
            "text": "綾水様、お味の方は\nいかがでしたか？",
            "zh": "绫水大人，味道\n怎么样？",
            "narrator_zh": "雏"
        },
        {
            "location": "526/TALK",
            "narrator": "アーヤ",
            "text": "とっても\n美味しかったわ。",
            "zh": "非常\n好吃哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "527/TALK",
            "narrator": "アーヤ",
            "text": "横浜海軍カレーって、\nレトルトのは食べた\nことあったけどね。",
            "zh": "横滨海军咖喱，\n虽然我以前吃过\n速食装的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "528/TALK",
            "narrator": "アーヤ",
            "text": "でも、\nやっぱり本場の味は、\nそれ以上に美味しい。",
            "zh": "不过，\n果然还是当地的正宗味道\n更胜一筹呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "529/TALK",
            "narrator": "雛",
            "text": "よかったー。\n綾水様に気にいって\nいただけて…。",
            "zh": "太好啦——。\n能合绫水大人的口味\n真是太好了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "530/TALK",
            "narrator": "雛",
            "text": "カレーが嫌いだったら\nどうしよう…って、\n少し不安だったんですよ。",
            "zh": "我刚才还一直有点不安，\n想着要是你不喜欢咖喱\n该怎么办呢……。",
            "narrator_zh": "雏"
        },
        {
            "location": "531/TALK",
            "narrator": "アーヤ",
            "text": "カレーは大好きよ。\n自分でも時々作るし。",
            "zh": "我很喜欢咖喱哦。\n自己平时有时也会做。",
            "narrator_zh": "绫水"
        },
        {
            "location": "532/TALK",
            "narrator": "雛",
            "text": "綾水様カレーかぁ。\nそれも食べてみたいかも。",
            "zh": "绫水大人做的咖喱呀。\n那个我也好想尝尝看。",
            "narrator_zh": "雏"
        },
        {
            "location": "534/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…。",
            "zh": "呵呵……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "535/TALK",
            "narrator": "アーヤ",
            "text": "…日向さん、\n楽しんでくれてるみたい。",
            "zh": "……看来日向\n吃得挺开心的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "536/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、あのまま\n帰らないでよかった。",
            "zh": "果然没有就那样\n直接回去是对的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "537/TALK",
            "narrator": "雛",
            "text": "…そういえば――",
            "zh": "……说起来——",
            "narrator_zh": "雏"
        },
        {
            "location": "538/TALK",
            "narrator": "雛",
            "text": "綾水様って、お鍋料理が\n得意なんですよね？",
            "zh": "绫水大人是不是很擅长\n做火锅料理呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "539/TALK",
            "narrator": "アーヤ",
            "text": "ええ…あら？\nでも日向さんに\n言ったかしら？",
            "zh": "嗯……哎？\n我有和日向\n说过这件事吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "540/TALK",
            "narrator": "雛",
            "text": "いえ、つばめちゃんに\n聞いたんです。",
            "zh": "没有，我是听燕\n说的啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "541/TALK",
            "narrator": "雛",
            "text": "前に、綾水様が作って\nくれたことがあって、\n凄く美味しかったって。",
            "zh": "她说以前绫水大人\n做给她吃过，\n味道超级棒呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "542/TALK",
            "narrator": "アーヤ",
            "text": "ああ、\nそういうことね。",
            "zh": "啊啊，\n原来是这样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "543/TALK",
            "narrator": "雛",
            "text": "はい。",
            "zh": "是的。",
            "narrator_zh": "雏"
        },
        {
            "location": "544/TALK",
            "narrator": "雛",
            "text": "つばめちゃんから、\n綾水様の話は色々\n聞きますからねー。",
            "zh": "我经常听燕提起\n绫水大人的各种\n事哦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "545/TALK",
            "narrator": "雛",
            "text": "いつも気遣ってくれるし、\nすごく頼りになる\n素敵な先輩だ、って。",
            "zh": "说你总是很照顾人，\n是一位非常可靠\n又很棒的前辈。",
            "narrator_zh": "雏"
        },
        {
            "location": "546/TALK",
            "narrator": "アーヤ",
            "text": "それ、本当なの？",
            "zh": "这话，是真的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "547/TALK",
            "narrator": "雛",
            "text": "本当ですよ。",
            "zh": "是真的哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "548/TALK",
            "narrator": "雛",
            "text": "綾水様みたいになりたい\nって、いつも嬉しそうに\n話してます。",
            "zh": "她总是开开心心地说，\n以后也想成为\n像绫水大人那样的人。",
            "narrator_zh": "雏"
        },
        {
            "location": "550/TALK",
            "narrator": "アーヤ",
            "text": "そ、そう…。\nつばめがそんな\nことを…。",
            "zh": "这、这样啊……。\n燕居然说过\n这种话……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "551/TALK",
            "narrator": "アーヤ",
            "text": "嬉しいんだけど…、\n知らないところで\n褒められるのって――",
            "zh": "虽然很开心……\n但在自己不知道的地方\n被人夸奖——",
            "narrator_zh": "绫水"
        },
        {
            "location": "552/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと照れるかも。",
            "zh": "还是让人有点不好意思呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "553/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "554/TALK",
            "narrator": "アーヤ",
            "text": "そ、そうだ！\n私からも聞きたいこと\nあったんだけど――",
            "zh": "对、对了！\n我也有点事想问你\n来着——",
            "narrator_zh": "绫水"
        },
        {
            "location": "556/TALK",
            "narrator": "アーヤ",
            "text": "劇場のバイトはどう？\n学業に影響とか\n出てない？",
            "zh": "剧场的打工怎么样？\n有没有影响到\n学业之类的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "557/TALK",
            "narrator": "雛",
            "text": "ご心配なく。\n成績の方は\n問題ありません！",
            "zh": "请放心。\n成绩方面\n完全没问题！",
            "narrator_zh": "雏"
        },
        {
            "location": "558/TALK",
            "narrator": "雛",
            "text": "専攻してる授業が、\n元々あたしの趣味の\n延長なので――",
            "zh": "我专攻的课程\n本来就是我兴趣的\n延伸——",
            "narrator_zh": "雏"
        },
        {
            "location": "559/TALK",
            "narrator": "雛",
            "text": "勉強しなくても\nそこそこいい点数は\n取れるくらいなんで。",
            "zh": "就算不怎么复习，\n也能拿到相当不错\n的分数啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "560/TALK",
            "narrator": "アーヤ",
            "text": "ふーん…そういえば、\n日向さんの専攻って？",
            "zh": "哦……说起来，\n日向的专业是？",
            "narrator_zh": "绫水"
        },
        {
            "location": "561/TALK",
            "narrator": "雛",
            "text": "システム系ですよー。",
            "zh": "是系统工程类的哦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "562/TALK",
            "narrator": "アーヤ",
            "text": "そうだったの？\nちょっと意外かも…。",
            "zh": "是这样啊？\n稍微有点意外呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "563/TALK",
            "narrator": "雛",
            "text": "昔っから、機械工学が\n大好きで、そのまま\nここまで来ちゃいました。",
            "zh": "我从小就特别喜欢\n机械工程，不知不觉\n就一路走到这里了。",
            "narrator_zh": "雏"
        },
        {
            "location": "564/TALK",
            "narrator": "アーヤ",
            "text": "好きなことをとことん\n極める、っていうのは\nいいことよ。",
            "zh": "把喜欢的事情钻研\n到底，是很棒的一件事\n哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "565/TALK",
            "narrator": "アーヤ",
            "text": "それにシステム系って\n私にはまったくわから\nない分野だから――",
            "zh": "而且系统类对我来说\n是完全一窍不通的\n领域——",
            "narrator_zh": "绫水"
        },
        {
            "location": "566/TALK",
            "narrator": "アーヤ",
            "text": "それが得意なんて、\nちょっと尊敬するわ。",
            "zh": "能擅长这个，\n让我挺佩服的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "568/TALK",
            "narrator": "雛",
            "text": "そ、そんな、\n尊敬だなんて…。",
            "zh": "哪、哪里，\n还谈不上佩服啦……。",
            "narrator_zh": "雏"
        },
        {
            "location": "569/TALK",
            "narrator": "アーヤ",
            "text": "だって、本当に私には\nさっぱりだもの。",
            "zh": "是真的，我对这方面\n真是一点儿也不懂。",
            "narrator_zh": "绫水"
        },
        {
            "location": "570/TALK",
            "narrator": "アーヤ",
            "text": "だから劇場にある\nシステムなんて、一度も\n触ったことないし。",
            "zh": "所以剧场里的那些\n系统，我一次都没\n碰过呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "572/TALK",
            "narrator": "雛",
            "text": "トライナリー関係の\nシステムですかぁ…。",
            "zh": "三重奏相关的\n系统吗……。",
            "narrator_zh": "雏"
        },
        {
            "location": "573/TALK",
            "narrator": "雛",
            "text": "チラッと見たことが\nありますけど――",
            "zh": "我倒是瞄到过\n几眼——",
            "narrator_zh": "雏"
        },
        {
            "location": "574/TALK",
            "narrator": "雛",
            "text": "ビックリするくらい\n最先端のマシンを\n使ってますよね？",
            "zh": "那里面用的可是\n让人大吃一惊的\n最尖端机器对吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "575/TALK",
            "narrator": "アーヤ",
            "text": "そう、なのかしら？\n私もその辺りのことは\n詳しくなくて…。",
            "zh": "是、是吗？\n我对那方面的事\n也不太了解……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "576/TALK",
            "narrator": "雛",
            "text": "いや、凄いんですよ！\nＳＦ映画かよ、って\nくらいの設備ですし。",
            "zh": "不，真的超厉害的！\n那套设备简直跟科幻\n电影里的一样嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "577/TALK",
            "narrator": "アーヤ",
            "text": "そこまで凄いもの\nだったんだ？",
            "zh": "原来是那么厉害的\n东西吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "578/TALK",
            "narrator": "雛",
            "text": "そうですよー。",
            "zh": "没错呀——。",
            "narrator_zh": "雏"
        },
        {
            "location": "579/TALK",
            "narrator": "雛",
            "text": "やっぱりバックに\n政府がついていると、\n違いますよねー。",
            "zh": "果然背后有\n政府撑腰，\n就是不一样呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "580/TALK",
            "narrator": "雛",
            "text": "…まあ、その割に\n宝の持ち腐れ感も\nありますけど。",
            "zh": "……不过，话虽如此，\n也有种大材小用的\n感觉就是了。",
            "narrator_zh": "雏"
        },
        {
            "location": "581/TALK",
            "narrator": "アーヤ",
            "text": "というと？",
            "zh": "这话怎么说？",
            "narrator_zh": "绫水"
        },
        {
            "location": "582/TALK",
            "narrator": "雛",
            "text": "ハイテクな設備に\n追いついてない面が\n多々あるんですよ。",
            "zh": "有很多方面完全没能\n跟上这么高科技的\n设备呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "583/TALK",
            "narrator": "雛",
            "text": "例えばフェノメノン\nアラートが鳴った際の\n召集の仕方とか――",
            "zh": "比如说PhenoMENON\n警报响起时的\n召集方式之类的——",
            "narrator_zh": "雏"
        },
        {
            "location": "584/TALK",
            "narrator": "雛",
            "text": "ぶっちゃけ、\n超アナログじゃない\nですか？",
            "zh": "老实说，\n是不是太原始了\n一点呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "586/TALK",
            "narrator": "アーヤ",
            "text": "そうかしら？\n私は気にしたこと\nないけど…。",
            "zh": "是吗？\n我倒是从来没\n注意过……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "587/TALK",
            "narrator": "雛",
            "text": "つばめちゃんから、\n聞いた話によると――",
            "zh": "听燕跟我\n说的情况——",
            "narrator_zh": "雏"
        },
        {
            "location": "588/TALK",
            "narrator": "雛",
            "text": "アラートが鳴ると、\nまずスマホに連絡が\n来るんですよね？",
            "zh": "警报一响，\n首先会往手机上\n发通知对吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "589/TALK",
            "narrator": "雛",
            "text": "それを確認した後、\n各自が劇場か現場に\n向かうなんて――",
            "zh": "确认通知之后，\n大家再各自赶往剧场\n或者现场——",
            "narrator_zh": "雏"
        },
        {
            "location": "590/TALK",
            "narrator": "雛",
            "text": "面倒過ぎますよ。\nっていうか、\n時間掛かり過ぎです。",
            "zh": "这也太麻烦了啦。\n而且说到底，\n太花时间了。",
            "narrator_zh": "雏"
        },
        {
            "location": "591/TALK",
            "narrator": "雛",
            "text": "それに、電車にでも\n乗ってたりしたら\n大変ですよね？",
            "zh": "万一那个时候正好\n坐在电车上，\n不就麻烦大了吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "592/TALK",
            "narrator": "雛",
            "text": "下手すると停車して、\n車内に閉じ込められる\n可能性もありますし。",
            "zh": "搞不好电车一停运，\n还会被关在车厢里\n出不来呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "593/TALK",
            "narrator": "アーヤ",
            "text": "…それ、わかるわ。\nちょっと前に\n経験したし…。",
            "zh": "……这点我深有体会。\n前不久才刚\n经历过……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "594/TALK",
            "narrator": "雛",
            "text": "ほら、やっぱり。",
            "zh": "您看，果然吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "595/TALK",
            "narrator": "雛",
            "text": "隊員だけじゃなく、交通\n機関にまで同時にアラート\n出すのが変なんです。",
            "zh": "不仅给队员发，还同时\n给公共交通发警报，\n这本身就很奇怪呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "596/TALK",
            "narrator": "雛",
            "text": "現場に向かう隊員の\n妨げになってますし。",
            "zh": "这反倒成了队员赶往\n现场的阻碍嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "597/TALK",
            "narrator": "アーヤ",
            "text": "でも、交通機関にも\nアラートを出さない\nわけにはいかないわ。",
            "zh": "不过，也不能不给\n公共交通发警报\n呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "598/TALK",
            "narrator": "雛",
            "text": "それは当然です。",
            "zh": "那当然啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "599/TALK",
            "narrator": "雛",
            "text": "でも、\nただ出してるだけじゃ\n意味がないんですよ。",
            "zh": "但是，\n光只是发出警报\n是没有意义的呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "600/TALK",
            "narrator": "雛",
            "text": "例えばですけど、\nスマホにはＧＰＳが\n付いてますよね？",
            "zh": "比方说吧，\n手机里不是都装有\nGPS吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "601/TALK",
            "narrator": "雛",
            "text": "それで隊員の現在地を\n管理庁側が把握して\nおけば――",
            "zh": "只要让管理厅那边通过它\n掌握队员的当前位置\n——",
            "narrator_zh": "雏"
        },
        {
            "location": "602/TALK",
            "narrator": "雛",
            "text": "有事の際も速やかに\n現場までの誘導が\n可能になります。",
            "zh": "发生紧急情况时也能迅速\n引导队员前往现场\n了呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "603/TALK",
            "narrator": "アーヤ",
            "text": "えっ……",
            "zh": "哎……",
            "narrator_zh": "绫水"
        },
        {
            "location": "605/TALK",
            "narrator": "アーヤ",
            "text": "なんかプライベートまで\n監視されそうでちょっと\n怖いけど……",
            "zh": "总觉得连私人时间都要\n被监控似的，稍微有点\n吓人呢……",
            "narrator_zh": "绫水"
        },
        {
            "location": "606/TALK",
            "narrator": "雛",
            "text": "大丈夫ですよ。普段は\n物理的にオフにして\nおけばいいんですから。",
            "zh": "没关系的。平时只要\n从物理层面关掉\n就可以了呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "607/TALK",
            "narrator": "雛",
            "text": "綾水様の恥ずかしい所を\n無駄に見られないように\nガッチリガードですよ！",
            "zh": "我会严防死守，绝不让\n绫水大人难为情的地方\n被白白看去的！",
            "narrator_zh": "雏"
        },
        {
            "location": "608/TALK",
            "narrator": "アーヤ",
            "text": "そ、そうね……。",
            "zh": "这、这样啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "609/TALK",
            "narrator": "アーヤ",
            "text": "まあ確かに、管理庁側が\nこちらの場所を把握でき\nれば、何かと便利よね。",
            "zh": "不过确实，管理厅那边\n要是能掌握我们的位置，\n各方面都会方便很多呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "610/TALK",
            "narrator": "アーヤ",
            "text": "迎えの車だって\nすぐに寄越して\nもらえるはずだし。",
            "zh": "就连派来接人的车，\n也应该能立刻开过来\n才对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "611/TALK",
            "narrator": "雛",
            "text": "そうです。",
            "zh": "就是说呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "612/TALK",
            "narrator": "雛",
            "text": "なのに、その程度の\nシステムが未だに構築\nされてないなんて。",
            "zh": "可偏偏连这点程度的\n系统都还没搭建起来，\n真是的。",
            "narrator_zh": "雏"
        },
        {
            "location": "613/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "614/TALK",
            "narrator": "アーヤ",
            "text": "今言ってた話、\n館長にもして\nもらえるかしら？",
            "zh": "刚才说的这些，\n能请你去跟馆长\n也提一下吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "615/TALK",
            "narrator": "アーヤ",
            "text": "まあ、予算の都合で無理、\nって言われる可能性は\n高いけどね……。",
            "zh": "虽说十有八九会因为\n预算问题被驳回\n就是了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "616/TALK",
            "narrator": "雛",
            "text": "わかりましたー！",
            "zh": "明白了——！",
            "narrator_zh": "雏"
        },
        {
            "location": "617/TALK",
            "narrator": "雛",
            "text": "もう少し考えをまとめたら\n東雲教官へも\n伝えておきますね。",
            "zh": "等我把想法再整理一下，\n也会转达给\n东云教官的。",
            "narrator_zh": "雏"
        },
        {
            "location": "618/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう。",
            "zh": "谢谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "620/TALK",
            "narrator": "アーヤ",
            "text": "…日向さんは、\n心強い味方になって\nくれそうね。",
            "zh": "……日向说不定会\n成为非常可靠的\n伙伴呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "621/TALK",
            "narrator": "雛",
            "text": "ほ、本当ですかー！？\n光栄です！",
            "zh": "真、真的吗——！？\n不胜荣幸！",
            "narrator_zh": "雏"
        },
        {
            "location": "622/TALK",
            "narrator": "雛",
            "text": "この日向雛、綾水様の\nためならば！",
            "zh": "我日向雏，只要是\n为了绫水大人！",
            "narrator_zh": "雏"
        },
        {
            "location": "623/TALK",
            "narrator": "雛",
            "text": "お手伝いから\n好みを捧げるまで、\n何でもやりますよ！！",
            "zh": "从打下手\n到奉献喜好，\n我什么都愿意做！！",
            "narrator_zh": "雏"
        },
        {
            "location": "624/TALK",
            "narrator": "アーヤ",
            "text": "…き、期待してるわ。",
            "zh": "……我、我很期待哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "625/TALK",
            "narrator": "アーヤ",
            "text": "周囲に勘違いされ\nそうなことを言わなければ\n完璧なんだけどね…。",
            "zh": "只要别说出容易让周围\n误会的话，就完美了\n呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "636/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【12 ピクシャル】",
            "zh": "【12 像素】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
