{
    "dir": "chap25/daydra/dd_ch02_25_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "25205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "想定外の想定値＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "意料之外的预设值＜后篇＞"
    },
    "entry": [
        {
            "location": "452/SCENARIO",
            "narrator": "",
            "text": "１００パーセントなんてないけど",
            "zh": "虽说没有百分之百的事",
            "narrator_zh": ""
        },
        {
            "location": "467/TALK",
            "narrator": "アーヤ",
            "text": "つばめはクラン達を\n退避させた後\nどこに向かったの？",
            "zh": "燕把库兰们\n疏散之后\n去了哪里？",
            "narrator_zh": "绫水"
        },
        {
            "location": "468/TALK",
            "narrator": "アーヤ",
            "text": "普段使わない廊下だから\n迷ってるのかも…。",
            "zh": "因为是平时不怎么走的走廊，\n说不定迷路了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "469/TALK",
            "narrator": "アーヤ",
            "text": "ならこの辺りに\nいてもいいはず…。",
            "zh": "那样的话应该\n就在这附近才对……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "470/SEL",
            "narrator": "",
            "text": "いや、逃げようよ",
            "zh": "不，快逃吧",
            "narrator_zh": ""
        },
        {
            "location": "471/SEL",
            "narrator": "",
            "text": "二階にいるよ…？",
            "zh": "在二楼哦……？",
            "narrator_zh": ""
        },
        {
            "location": "472/ACT",
            "narrator": "",
            "text": "二階にいるよ…？",
            "zh": "在二楼哦……？",
            "narrator_zh": ""
        },
        {
            "location": "473/ACT",
            "narrator": "",
            "text": "二階にいるよ…？",
            "zh": "在二楼哦……？",
            "narrator_zh": ""
        },
        {
            "location": "490/TALK",
            "narrator": "アーヤ",
            "text": "ごめんね",
            "zh": "抱歉",
            "narrator_zh": "绫水"
        },
        {
            "location": "492/TALK",
            "narrator": "アーヤ",
            "text": "相手できないから",
            "zh": "我现在没空理你",
            "narrator_zh": "绫水"
        },
        {
            "location": "503/TALK",
            "narrator": "アーヤ",
            "text": "最後に見たのは\nどこだっけ？",
            "zh": "最后看见她是在\n哪里来着？",
            "narrator_zh": "绫水"
        },
        {
            "location": "504/SEL",
            "narrator": "",
            "text": "いいから逃げようよ",
            "zh": "别管了快逃吧",
            "narrator_zh": ""
        },
        {
            "location": "505/SEL",
            "narrator": "",
            "text": "二階だってば",
            "zh": "我都说在二楼了",
            "narrator_zh": ""
        },
        {
            "location": "506/ACT",
            "narrator": "",
            "text": "二階だってば",
            "zh": "我都说在二楼了",
            "narrator_zh": ""
        },
        {
            "location": "507/ACT",
            "narrator": "",
            "text": "二階だってば",
            "zh": "我都说在二楼了",
            "narrator_zh": ""
        },
        {
            "location": "536/TALK",
            "narrator": "アーヤ",
            "text": "一旦別れた場所まで\n戻った方がいい？",
            "zh": "要先退回到刚才\n分开的地方比较好吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "537/SEL",
            "narrator": "",
            "text": "危険すぎるでしょ",
            "zh": "太危险了吧",
            "narrator_zh": ""
        },
        {
            "location": "538/SEL",
            "narrator": "",
            "text": "二階上がって！",
            "zh": "快上二楼！",
            "narrator_zh": ""
        },
        {
            "location": "539/ACT",
            "narrator": "",
            "text": "二階上がって！",
            "zh": "快上二楼！",
            "narrator_zh": ""
        },
        {
            "location": "540/ACT",
            "narrator": "",
            "text": "二階上がって！",
            "zh": "快上二楼！",
            "narrator_zh": ""
        },
        {
            "location": "546/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "哎！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "547/TALK",
            "narrator": "通常攻撃隊Ａ",
            "text": "いたぞ！",
            "zh": "在这里！",
            "narrator_zh": "普通攻击队A"
        },
        {
            "location": "548/TALK",
            "narrator": "アーヤ",
            "text": "まずい！",
            "zh": "糟了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "550/TALK",
            "narrator": "アーヤ",
            "text": "とりあえず\nシャッターを！",
            "zh": "总之先把\n卷帘门放下来！",
            "narrator_zh": "绫水"
        },
        {
            "location": "555/TALK",
            "narrator": "アーヤ",
            "text": "もうこれ以上は\n探せない…！",
            "zh": "已经没法继续\n往下找了……！",
            "narrator_zh": "绫水"
        },
        {
            "location": "575/TALK",
            "narrator": "ガブリエラ",
            "text": "お帰りなさい。",
            "zh": "你回来啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "576/TALK",
            "narrator": "ガブリエラ",
            "text": "って、つばめは…。",
            "zh": "哎，燕呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "578/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさい。",
            "zh": "对不起。",
            "narrator_zh": "绫水"
        },
        {
            "location": "579/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？",
            "zh": "哎！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "580/TALK",
            "narrator": "アーヤ",
            "text": "すぐに通常攻撃隊が\nやってくるわ。",
            "zh": "普通攻击队很快\n就要追过来了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "581/TALK",
            "narrator": "アーヤ",
            "text": "アーケロンに\n乗って、ギャヴィ。",
            "zh": "快坐上古巨龟，\n加维。",
            "narrator_zh": "绫水"
        },
        {
            "location": "582/TALK",
            "narrator": "ガブリエラ",
            "text": "だったら\n今度はあたしが\n探しに行くわ！",
            "zh": "既然这样，\n这次换我\n去找她！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "583/TALK",
            "narrator": "アーヤ",
            "text": "ダメよ！",
            "zh": "不行！",
            "narrator_zh": "绫水"
        },
        {
            "location": "584/TALK",
            "narrator": "ガブリエラ",
            "text": "だって\nつばめが…！",
            "zh": "可是\n燕她……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "585/TALK",
            "narrator": "アーヤ",
            "text": "本当にごめん。\n後でいくらでも\n怒っていいわ。",
            "zh": "真的对不起。\n之后你想怎么\n生我气都行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "586/TALK",
            "narrator": "アーヤ",
            "text": "でもここで\nギャヴィまでも\n守れなかったら。",
            "zh": "但如果在这里\n连加维都没能\n保护好的话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "587/TALK",
            "narrator": "アーヤ",
            "text": "私はリーダーを\n続けられない。",
            "zh": "我就没法继续\n当这个领队了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "588/TALK",
            "narrator": "ガブリエラ",
            "text": "……………………。",
            "zh": "……………………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "589/TALK",
            "narrator": "アーヤ",
            "text": "乗り込んだらすぐに\nみやびを迎えに行くわ。",
            "zh": "坐上去之后\n我们马上去接雅。",
            "narrator_zh": "绫水"
        },
        {
            "location": "590/TALK",
            "narrator": "ガブリエラ",
            "text": "…もう！",
            "zh": "……真是的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "619/TALK",
            "narrator": "アーヤ",
            "text": "……ごめんね。",
            "zh": "……对不起。",
            "narrator_zh": "绫水"
        },
        {
            "location": "620/TALK",
            "narrator": "アーヤ",
            "text": "いくら謝っても\n謝り足りないとは\n思うけど。",
            "zh": "虽然我觉得\n再怎么道歉\n也不够就是了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "621/TALK",
            "narrator": "ガブリエラ",
            "text": "………………。",
            "zh": "………………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "623/TALK",
            "narrator": "みやび",
            "text": "いや。\n現時点では\n一番えい選択やき。",
            "zh": "没有的事。\n就这阵来看\n是最要得的选法啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "624/TALK",
            "narrator": "みやび",
            "text": "そこはもう\n仕方がないろう。",
            "zh": "那事也是\n没得办法咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "625/TALK",
            "narrator": "みやび",
            "text": "音羽はこうやって\n連れ出せた\nわけやし。",
            "zh": "毕竟像这样\n把音羽带出来了\n嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "626/TALK",
            "narrator": "みやび",
            "text": "反撃のチャンスを\n伺えばええだけぞね。",
            "zh": "等着寻机会\n反击就是了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "627/TALK",
            "narrator": "アーヤ",
            "text": "ごめんね、ギャヴィ。",
            "zh": "对不起，加维。",
            "narrator_zh": "绫水"
        },
        {
            "location": "628/TALK",
            "narrator": "アーヤ",
            "text": "偉そうなことを\n言ったくせに\nこんな結果になって。",
            "zh": "明明说了那么\n狂妄的话，\n结果却变成这样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "629/TALK",
            "narrator": "ガブリエラ",
            "text": "…………別に。",
            "zh": "…………也没什么。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "631/TALK",
            "narrator": "みやび",
            "text": "これから憧れの\nアーヤの実家に\n行くんやき。",
            "zh": "接下来可是要去\n憧憬的绫水老家\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "632/TALK",
            "narrator": "みやび",
            "text": "もう少し楽しい顔\nしてもええと\n思うちや。",
            "zh": "我觉得多少可以\n露出点高兴的表情\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "635/TALK",
            "narrator": "ガブリエラ",
            "text": "あんた本っ当に\n呑気ね！",
            "zh": "你可真——是\n心够大的啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "636/TALK",
            "narrator": "みやび",
            "text": "いや？　先輩の\n余裕を見せとる\nだけぞね。",
            "zh": "哪有？　只是展示一哈\n前辈的从容\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "638/TALK",
            "narrator": "ガブリエラ",
            "text": "まるであたしに\n余裕がない\nみたいじゃない！",
            "zh": "你那话说得好像\n我一点都不从容\n似的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "639/TALK",
            "narrator": "みやび",
            "text": "…そんなつもりは\nないけんどねえ？",
            "zh": "……我倒没那个意思\n不过嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "640/TALK",
            "narrator": "ガブリエラ",
            "text": "わかってて\n言ってるでしょ！",
            "zh": "你明明就是\n明知故问吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "641/TALK",
            "narrator": "アーヤ",
            "text": "こらこら、\n喧嘩しないの。",
            "zh": "好啦好啦，\n别吵架了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "642/TALK",
            "narrator": "アーヤ",
            "text": "みやびがいてくれて\nよかったわ……。",
            "zh": "还好有雅在\n真是太好了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "643/TALK",
            "narrator": "アーヤ",
            "text": "悔しいからって\n余裕をなくしちゃ\nダメよね……。",
            "zh": "不能因为不甘心\n就失去了\n从容啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "644/TALK",
            "narrator": "アーヤ",
            "text": "絶対に助ける。\nだから無事でいてね\nつばめ……。",
            "zh": "我一定会救出她的。\n所以一定要平安无事哦，\n燕……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "656/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【MV EXE_KAGURa】",
            "zh": "【MV EXE_KAGURa】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
