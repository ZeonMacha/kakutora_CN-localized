        "title": "Extra007 ヒメゴトチャット",
        "sub_title": "覚えめでたく覚えておらず",
        "title_zh": "Extra007 秘语聊天",
        "sub_title_zh": "背时风光，背完就忘"
    },
    "entry": [
        {
            "location": "77/SCENARIO",
            "narrator": "",
            "text": "008_覚えめでたく覚えておらず",
            "zh": "008_背时风光，背完就忘",
            "narrator_zh": ""
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "キリト君たちに勉強を教えてて",
            "zh": "我在教圣翔他们功课",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "まずいことに気づいちゃったわ",
            "zh": "发现了一件不妙的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "高校時代に習ったこと、結構忘れてたの",
            "zh": "高中时代学的东西，忘得还不少",
            "narrator_zh": "绫水"
        },
        {
            "location": "106/SEL",
            "narrator": "",
            "text": "そういうもんだよ",
            "zh": "人就是这样嘛",
            "narrator_zh": ""
        },
        {
            "location": "107/SEL",
            "narrator": "",
            "text": "復習するの？",
            "zh": "要复习吗？",
            "narrator_zh": ""
        },
        {
            "location": "108/SEL",
            "narrator": "",
            "text": "教えられはしたの？",
            "zh": "那你还是教了？",
            "narrator_zh": ""
        },
        {
            "location": "109/ACT",
            "narrator": "",
            "text": "そういうもんだよ",
            "zh": "人就是这样嘛",
            "narrator_zh": ""
        },
        {
            "location": "111/TALK",
            "narrator": "アーヤ",
            "text": "あら",
            "zh": "哎呀",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/TALK",
            "narrator": "アーヤ",
            "text": "やっぱりそう（￣ー￣？）",
            "zh": "果然是这样（￣ー￣？）",
            "narrator_zh": "绫水"
        },
        {
            "location": "113/TALK",
            "narrator": "アーヤ",
            "text": "なんて",
            "zh": "哪怕",
            "narrator_zh": "绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "アーヤ",
            "text": "慰めでも",
            "zh": "只是安慰",
            "narrator_zh": "绫水"
        },
        {
            "location": "115/TALK",
            "narrator": "アーヤ",
            "text": "うれしいわ",
            "zh": "我也开心哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "117/SEL",
            "narrator": "",
            "text": "普通だよ",
            "zh": "很正常的",
            "narrator_zh": ""
        },
        {
            "location": "118/SEL",
            "narrator": "",
            "text": "当たり前だって",
            "zh": "这不是理所当然吗",
            "narrator_zh": ""
        },
        {
            "location": "119/ACT",
            "narrator": "",
            "text": "普通だよ",
            "zh": "很正常的",
            "narrator_zh": ""
        },
        {
            "location": "120/TALK",
            "narrator": "アーヤ",
            "text": "そうよね",
            "zh": "是啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "アーヤ",
            "text": "時間が経ったら忘れるのは当たり前よね",
            "zh": "时间一长就会忘，很正常吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "122/TALK",
            "narrator": "アーヤ",
            "text": "それはそうね",
            "zh": "话是没错",
            "narrator_zh": "绫水"
        },
        {
            "location": "123/ACT",
            "narrator": "",
            "text": "当たり前だって",
            "zh": "这不是理所当然吗",
            "narrator_zh": ""
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "かもね",
            "zh": "或许吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "125/TALK",
            "narrator": "アーヤ",
            "text": "使わないことって",
            "zh": "用不上的东西",
            "narrator_zh": "绫水"
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "すぐ忘れちゃうわよね",
            "zh": "就是忘得快呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/ACT",
            "narrator": "",
            "text": "復習するの？",
            "zh": "要复习吗？",
            "narrator_zh": ""
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "今必要かって言われると困るのよね",
            "zh": "要说现在用不用得上，还真难说",
            "narrator_zh": "绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "アーヤ",
            "text": "でもせっかく覚えたことを",
            "zh": "可好不容易记住的东西",
            "narrator_zh": "绫水"
        },
        {
            "location": "131/TALK",
            "narrator": "アーヤ",
            "text": "忘れてるのは悔しいのよね",
            "zh": "却忘掉了，实在不甘心",
            "narrator_zh": "绫水"
        },
        {
            "location": "132/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと考えるわ",
            "zh": "我再想想",
            "narrator_zh": "绫水"
        },
        {
            "location": "133/ACT",
            "narrator": "",
            "text": "教えられはしたの？",
            "zh": "那你还是教了？",
            "narrator_zh": ""
        },
        {
            "location": "134/TALK",
            "narrator": "アーヤ",
            "text": "一応ね",
            "zh": "好歹算是",
            "narrator_zh": "绫水"
        },
        {
            "location": "135/TALK",
            "narrator": "アーヤ",
            "text": "教科書見ながらだったし",
            "zh": "反正一直看着教科书",
            "narrator_zh": "绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "アーヤ",
            "text": "なんとかなってよかったわ",
            "zh": "总算没露馅，太好了",
            "narrator_zh": "绫水"
        }
    ]
}
