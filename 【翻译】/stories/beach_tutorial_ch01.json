        "title": "",
        "sub_title": "TGSつばめ",
        "sub_title_zh": "TGS燕"
    },
    "entry": [
        {
            "location": "5/SCENARIO",
            "narrator": "",
            "text": "TGSつばめ",
            "zh": "TGS燕",
            "narrator_zh": ""
        },
        {
            "location": "25/TALK",
            "narrator": "つばめ",
            "text": "んー、いい天気！",
            "zh": "嗯——，天气真好！",
            "narrator_zh": "燕"
        },
        {
            "location": "26/TALK",
            "narrator": "つばめ",
            "text": "晴れてよかったぁ。\n昨日、天気予報では\n雨って言ってたんだよ？",
            "zh": "放晴了真是太好啦。\n昨天天气预报\n还说会下雨哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "27/SEL",
            "narrator": "",
            "text": "そうだったんだ？",
            "zh": "是这样吗？",
            "narrator_zh": ""
        },
        {
            "location": "28/SEL",
            "narrator": "",
            "text": "雨だったらがっかりだった",
            "zh": "要是下雨就扫兴了",
            "narrator_zh": ""
        },
        {
            "location": "29/ACT",
            "narrator": "",
            "text": "そうだったんだ？",
            "zh": "是这样吗？",
            "narrator_zh": ""
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "あなたとのデートが\n雨になりませんようにー！",
            "zh": "愿和你的约会\n不要变成雨天——！",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "って、お願いしたのが\nよかったのかも。",
            "zh": "说不定，许了那个愿\n是对的哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "32/ACT",
            "narrator": "",
            "text": "雨だったらがっかりだった",
            "zh": "要是下雨就扫兴了",
            "narrator_zh": ""
        },
        {
            "location": "33/TALK",
            "narrator": "つばめ",
            "text": "本当だよぉ。",
            "zh": "真的呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "34/TALK",
            "narrator": "つばめ",
            "text": "せっかくの海デートで\n雨とかだったら、\nションボリだったよね。",
            "zh": "难得的海边约会，\n要是下起雨来，\n可就蔫掉啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "つばめ",
            "text": "でも、もし雨だったら\n屋内デートだったのかな？",
            "zh": "不过，要是下雨的话，\n会变成室内约会吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "37/TALK",
            "narrator": "つばめ",
            "text": "それも悪くなかったかも。\n水族館とか映画とかも\n楽しそうだし。",
            "zh": "那样好像也不错。\n水族馆呀电影什么的，\n听起来也很好玩。",
            "narrator_zh": "燕"
        },
        {
            "location": "38/SEL",
            "narrator": "",
            "text": "そっちの方がよかった",
            "zh": "那样更好",
            "narrator_zh": ""
        },
        {
            "location": "39/SEL",
            "narrator": "",
            "text": "それじゃつばめの水着が見れない！",
            "zh": "那样就看不到燕的泳装了！",
            "narrator_zh": ""
        },
        {
            "location": "40/ACT",
            "narrator": "",
            "text": "そっちの方がよかった",
            "zh": "那样更好",
            "narrator_zh": ""
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "もしかして、\nどこかデートしたいとこ\nあった？",
            "zh": "难道说，\n你有想去约会的\n地方吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "42/SEL",
            "narrator": "",
            "text": "つばめの部屋がいい",
            "zh": "燕的房间就好",
            "narrator_zh": ""
        },
        {
            "location": "43/SEL",
            "narrator": "",
            "text": "屋内の流れるプールとか",
            "zh": "室内的漂流河什么的",
            "narrator_zh": ""
        },
        {
            "location": "44/ACT",
            "narrator": "",
            "text": "つばめの部屋で",
            "zh": "在燕的房间",
            "narrator_zh": ""
        },
        {
            "location": "46/TALK",
            "narrator": "つばめ",
            "text": "そ、それは、えっと…。\nちょっと恥ずかしいかも。",
            "zh": "那、那个，嗯……\n有点不好意思啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "いつも部屋で話したりは\nしてるけど、デートで、\nって言われると…。",
            "zh": "平时也会在房间里\n说话，可要说是\n约会的话……",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "ちょっと、\n緊張しちゃうかも…。",
            "zh": "有点，\n会紧张起来哦……",
            "narrator_zh": "燕"
        },
        {
            "location": "49/TALK",
            "narrator": "つばめ",
            "text": "あ、あはは。\nドキドキ、止まらなく\nなっちゃった…。",
            "zh": "啊、啊哈哈。\n心跳，停不下来\n啦……",
            "narrator_zh": "燕"
        },
        {
            "location": "50/ACT",
            "narrator": "",
            "text": "屋内の流れるプールとか",
            "zh": "室内的漂流河什么的",
            "narrator_zh": ""
        },
        {
            "location": "51/TALK",
            "narrator": "つばめ",
            "text": "それも楽しそうかも！",
            "zh": "那个听起来也很好玩！",
            "narrator_zh": "燕"
        },
        {
            "location": "52/TALK",
            "narrator": "つばめ",
            "text": "そういうところだったら、\n大きな滑り台とかも\nありそうだよね？",
            "zh": "那种地方的话，\n好像也会有大滑梯\n对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "54/TALK",
            "narrator": "つばめ",
            "text": "あなたと一緒に、\nピッタリくっついて\n滑ったりできるかも…。",
            "zh": "说不定能和你\n紧紧贴在一起\n滑下去哦……",
            "narrator_zh": "燕"
        },
        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "えへへ…恥ずかしいけど、\n一緒に滑った方が\n絶対楽しいよね。",
            "zh": "诶嘿嘿……虽然不好意思，\n还是一起滑\n绝对更开心啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "57/ACT",
            "narrator": "",
            "text": "それじゃつばめの水着が見れない",
            "zh": "那样就看不到燕的泳装了",
            "narrator_zh": ""
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "えっ…わ、わたしの水着、\n見たかったの…？",
            "zh": "诶……我、我的泳装，\n你想看吗……？",
            "narrator_zh": "燕"
        },
        {
            "location": "60/TALK",
            "narrator": "つばめ",
            "text": "…改めて言われると、\nちょっと恥ずかしいかも。",
            "zh": "……这么一说，\n有点不好意思啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "でも、そんなに楽しみに\nしてもらえてたのは、\nちょっと嬉しいな…。",
            "zh": "不过，你这么期待，\n我还是\n有点高兴……",
            "narrator_zh": "燕"
        },
        {
            "location": "63/SEL",
            "narrator": "",
            "text": "ちょっと触っていい？",
            "zh": "可以稍微碰一下吗？",
            "narrator_zh": ""
        },
        {
            "location": "64/ACT",
            "narrator": "",
            "text": "ちょっと触っていい？",
            "zh": "可以稍微碰一下吗？",
            "narrator_zh": ""
        },
        {
            "location": "67/TALK",
            "narrator": "つばめ",
            "text": "う、うん…。\nくすぐったいのは\nダメだよ？",
            "zh": "嗯、嗯……\n痒痒的\n可不行哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "つばめ",
            "text": "えへへ…、\n優しいツンツンだね。",
            "zh": "诶嘿嘿……\n是温柔的戳戳呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "あ、あんまりイタズラ\nしたらダメだよ…？",
            "zh": "太、太恶作剧\n可不行哦……？",
            "narrator_zh": "燕"
        },
        {
            "location": "95/TALK",
            "narrator": "つばめ",
            "text": "む、むぎゅ～……。",
            "zh": "唔、唔咕～……。",
            "narrator_zh": "燕"
        },
        {
            "location": "96/TALK",
            "narrator": "つばめ",
            "text": "あ、あはは…、\nちょっと恥ずかしいかも。",
            "zh": "啊、啊哈哈……\n有点不好意思啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "99/TALK",
            "narrator": "つばめ",
            "text": "きゃぁっ！？",
            "zh": "呀啊！？",
            "narrator_zh": "燕"
        },
        {
            "location": "100/TALK",
            "narrator": "つばめ",
            "text": "ふ、普通に触るのは\nダメー！！",
            "zh": "普、普通地摸\n不行啦——！！",
            "narrator_zh": "燕"
        },
        {
            "location": "106/TALK",
            "narrator": "つばめ",
            "text": "お、お腹ツンツンするの、\n変な感じだよぉ…。",
            "zh": "戳、戳肚子，\n感觉怪怪的呀……",
            "narrator_zh": "燕"
        },
        {
            "location": "108/TALK",
            "narrator": "つばめ",
            "text": "く、くすぐったいから…、\n優しくだよ？",
            "zh": "因、因为很痒……\n要轻轻的哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "つばめ",
            "text": "えへへ…ナデナデ、\nうれしいな…。",
            "zh": "诶嘿嘿……摸摸，\n好高兴呀……",
            "narrator_zh": "燕"
        },
        {
            "location": "116/TALK",
            "narrator": "つばめ",
            "text": "…頭の中、ぽーって\nしてきちゃいそうかも…。",
            "zh": "……脑子里，好像\n要变得晕乎乎的了……",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "つばめ",
            "text": "む、むぎゅ～……。",
            "zh": "唔、唔咕～……。",
            "narrator_zh": "燕"
        },
        {
            "location": "124/TALK",
            "narrator": "つばめ",
            "text": "あ、あはは…、\nちょっと恥ずかしいかも。",
            "zh": "啊、啊哈哈……\n有点不好意思啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "127/TALK",
            "narrator": "つばめ",
            "text": "きゃぁっ！？",
            "zh": "呀啊！？",
            "narrator_zh": "燕"
        },
        {
            "location": "128/TALK",
            "narrator": "つばめ",
            "text": "ふ、普通に触るのは\nダメー！！",
            "zh": "普、普通地摸\n不行啦——！！",
            "narrator_zh": "燕"
        },
        {
            "location": "134/TALK",
            "narrator": "つばめ",
            "text": "えへへ…、\nお腹ナデナデ、\n落ち着くから好きだよ。",
            "zh": "诶嘿嘿……\n摸摸肚子我会安心，\n所以我喜欢哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "く、くすぐったいから…、\n優しくだよ？",
            "zh": "因、因为很痒……\n要轻轻的哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "72/DIALOG",
            "narrator": "INFO",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已连接。\n\n请点击画面，向对方\n传达感觉吧。",
            "narrator_zh": "INFO"
        },
        {
            "location": "143/DIALOG",
            "narrator": "NOTICE",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已断开。",
            "narrator_zh": "NOTICE"
        }
    ]
}
