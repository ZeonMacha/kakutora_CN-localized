{
    "dir": "dramatics/daydra/drm_ch03_00_720.js",
    "type": "Episode",
    "info": {
        "story_id": "3072",
        "cid": "gabriella",
        "title": "らぶとーく  第73話",
        "sub_title": "お父さん、という存在",
        "title_zh": "恋爱漫谈 第73话",
        "sub_title_zh": "父亲，这种存在"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "お父さん、という存在",
            "zh": "父亲，这种存在",
            "narrator_zh": ""
        },
        {
            "location": "20/TALK",
            "narrator": "つばめ",
            "text": "はぁ…こんなこと、\n一々送って来なくて\nいいのに…。",
            "zh": "唉……这种事，\n不用一个一个\n发过来也行……。",
            "narrator_zh": "燕"
        },
        {
            "location": "23/TALK",
            "narrator": "ガブリエラ",
            "text": "何廊下でブツブツ\n言ってんのよ？",
            "zh": "你在走廊上嘀嘀咕咕\n说什么呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "25/TALK",
            "narrator": "つばめ",
            "text": "あ、ガブちゃん…。",
            "zh": "啊，加布…。",
            "narrator_zh": "燕"
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "何？\nＷＡＶＥ？",
            "zh": "怎么了？\nWAVE？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "つばめ",
            "text": "うん、お父さんから\nなんだけど――",
            "zh": "嗯，是爸爸\n发来的——",
            "narrator_zh": "燕"
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "いつまで経っても\n過保護過ぎて、ちょっと\n困ってるの…。",
            "zh": "不管过多久\n都过度保护，有点\n吃不消呢……。",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "…お父さんの気持ちも\nわからなくはないわね。",
            "zh": "……也不是\n不能理解爸爸的心情呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "もぉ、どういう意味？",
            "zh": "好啦，什么意思嘛？",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "落ち込ませそうだから\n詳しくは言わないで\nおくわ。",
            "zh": "看起来会让你\n失落，那我就\n不细说了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "そっちの方が余計に\n落ち込みそうなん\nだけど…。",
            "zh": "那样反而更让人\n低落，\n不过……。",
            "narrator_zh": "燕"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "てか、つばめの場合は\n急にこっちで暮らすのが\n決まったんだし――",
            "zh": "话说，燕的情况是\n突然决定在这边\n生活，所以——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "人一倍心配されても、\n仕方ないと思うけど？",
            "zh": "被多一倍地操心，\n我觉得也没办法吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "つばめ",
            "text": "そうかなぁ…？",
            "zh": "是这样吗……？",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "兄弟もいないんでしょ？",
            "zh": "你也没有兄弟姐妹吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "一人娘なんだから、\nそりゃ過保護になっても\n当然よ。",
            "zh": "既然是独生女，\n那过度保护也是\n理所当然的哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "うーん、そっかぁ…。",
            "zh": "唔……这样啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "でも、それなら\nガブちゃんも\n大変じゃない？",
            "zh": "不过，那样的话\n加布不也\n很辛苦吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしが？",
            "zh": "我？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "49/TALK",
            "narrator": "つばめ",
            "text": "だって、ガブちゃんも\n一人娘だし、しかも\n家はポーランドでしょ？",
            "zh": "因为，加布也是\n独生女，而且\n家还在波兰吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "外国での一人暮らしを、\nよくお父さんは許して\nくれたね？",
            "zh": "在国外一个人生活，\n你爸爸居然肯答应，\n真厉害呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "あー…まあ、うちは\nちょっと色々あって…。",
            "zh": "啊……嘛，我家\n有点各种情况……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "つばめ",
            "text": "色々？",
            "zh": "各种情况？",
            "narrator_zh": "燕"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "…つばめにはうちの\n事情、まだ話して\nなかったんだったわ…。",
            "zh": "……对了，我家的事\n还没跟燕说过\n呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしよう…。",
            "zh": "怎么办呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "…ちょっと待って。\nＷＡＶＥを一件\n送るから…。",
            "zh": "……等一下。\n我先发一条\nWAVE……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "面倒なことになったわ",
            "zh": "事情变得麻烦了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "71/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめには",
            "zh": "对燕啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "お父さんと絶縁状態にあることを教えてなかったの",
            "zh": "你没告诉我你跟父亲处于断绝关系状态呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/SEL",
            "narrator": "",
            "text": "今、教えれば？",
            "zh": "现在说说不就行了？",
            "narrator_zh": ""
        },
        {
            "location": "74/ACT",
            "narrator": "",
            "text": "今、教えれば？",
            "zh": "现在说说不就行了？",
            "narrator_zh": ""
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "却下",
            "zh": "驳回",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめにそんなこと言ったらどうなると思う？",
            "zh": "你觉得跟燕说那种话会怎么样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対お節介焼いてきそうだし",
            "zh": "她绝对会跑来多管闲事的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかく",
            "zh": "总之",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "上手く言い逃れるためにはなんて言えばいいと思う？",
            "zh": "你觉得要怎么说才能顺利蒙混过去？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/SEL",
            "narrator": "",
            "text": "自立してるから、と言ってやれ",
            "zh": "你就说她很独立",
            "narrator_zh": ""
        },
        {
            "location": "82/SEL",
            "narrator": "",
            "text": "家出して来たんだ、と言ってやれ",
            "zh": "你就说你是离家出走的",
            "narrator_zh": ""
        },
        {
            "location": "83/SEL",
            "narrator": "",
            "text": "そっちが過保護過ぎるんだと言ってやれ",
            "zh": "你就说那边才过度保护过头",
            "narrator_zh": ""
        },
        {
            "location": "84/ACT",
            "narrator": "",
            "text": "自立してるから、と言ってやれ",
            "zh": "你就说她很独立",
            "narrator_zh": ""
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "確かにそれはあるかもね",
            "zh": "确实有道理呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、あたしは\nつばめとは違って\n自立してるから――",
            "zh": "……算了，我和燕\n不一样，\n我可是很自立的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "日本に行くって言っても\n反対はされなかったわ。",
            "zh": "说是要去日本，\n也没遭到反对哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "101/TALK",
            "narrator": "つばめ",
            "text": "そうなの！？",
            "zh": "是这样吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "102/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、ガブちゃんは\n凄いなぁ…。",
            "zh": "加布果然\n好厉害啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "103/TALK",
            "narrator": "つばめ",
            "text": "年上のわたしの方が\n親に心配されてるのが、\nちょっと恥ずかしいよ。",
            "zh": "年长的我反而\n被父母操心，\n有点不好意思呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、それが普通\nだから。",
            "zh": "不，那才是\n正常的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "うちはその辺…\nちょっと特別だから…。",
            "zh": "我家在这方面……\n有点特殊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "つばめ",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": "燕"
        },
        {
            "location": "110/TALK",
            "narrator": "ガブリエラ",
            "text": "な、なんでもない！",
            "zh": "没、没什么！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかく、心配して\n色々ＷＡＶＥを送って\n来てるんだから――",
            "zh": "总之，因为是担心才\n发了各种WAVE\n过来——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "ちゃんと返信して\nあげなさいよ？",
            "zh": "要好好\n回信哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "つばめ",
            "text": "…しないとダメかな？",
            "zh": "……不回不行吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "当たり前じゃない。",
            "zh": "那还用说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "ガブリエラ",
            "text": "自立できてなくて\n心配かけさせてる\nつばめが悪いんだし。",
            "zh": "是没能自立、\n还让家人操心的\n燕不好哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "119/TALK",
            "narrator": "つばめ",
            "text": "そ、それ言われたら\n何も言い返せない\nよぉ…。",
            "zh": "被、被这么说\n我就什么都\n反驳不了了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "120/TALK",
            "narrator": "ガブリエラ",
            "text": "言い返さなくていいから\n返信しなさいよ。",
            "zh": "不用反驳，\n给我回信哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "…贅沢な悩みよね。",
            "zh": "……真是奢侈的烦恼呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく気にかけて\nもらえないあたしから\nしたら――",
            "zh": "对根本没被\n放在心上的\n我来说——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "凄い羨ましいこと\nなのに…。",
            "zh": "那可是\n非常让人羡慕的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/ACT",
            "narrator": "",
            "text": "家出して来たんだ、と言ってやれ",
            "zh": "你就说你是离家出走的",
            "narrator_zh": ""
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "ウソってバレバレじゃない？",
            "zh": "这谎也太容易被拆穿了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "ガブリエラ",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめなら信じそうね",
            "zh": "燕的话大概会信",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "141/TALK",
            "narrator": "ガブリエラ",
            "text": "…実はね、これは\nアーヤとまほにしか\n言ってないんだけど――",
            "zh": "……其实呢，这件事\n我只跟绫水和真幌\n说过——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、家出して\n日本に来てるの。",
            "zh": "我呀，是离家出走\n跑到日本来的哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "144/TALK",
            "narrator": "つばめ",
            "text": "ふーん、家出…。",
            "zh": "哦——离家出走……。",
            "narrator_zh": "燕"
        },
        {
            "location": "147/TALK",
            "narrator": "つばめ",
            "text": "家出！？",
            "zh": "离家出走！？",
            "narrator_zh": "燕"
        },
        {
            "location": "150/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしてもお父さんと\n気が合わなくて――",
            "zh": "怎么也跟爸爸\n合不来——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "こんな家にいられない、\nって着の身着のままで\n日本に来た、ってわけ。",
            "zh": "在这种家里待不下去，\n于是就穿着身上这身\n跑到日本来了，就是这样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "つばめ",
            "text": "…有資格者だから\n日本に呼ばれた、って\nわけじゃないの？",
            "zh": "……不是因为我是\n有资格者，才被\n叫到日本来的？",
            "narrator_zh": "燕"
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "それがわかったの、\n日本に来てからだし。",
            "zh": "弄明白那个，\n是来日本之后的事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "だからまあ、有資格者\nじゃなかったとしたら、\n今頃どうなってたか…。",
            "zh": "所以，要是没有\n资格的话，\n现在会怎样呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "156/TALK",
            "narrator": "つばめ",
            "text": "そんな…。",
            "zh": "怎么会……。",
            "narrator_zh": "燕"
        },
        {
            "location": "159/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "160/TALK",
            "narrator": "ガブリエラ",
            "text": "ぷっ…バカね。\n冗談に決まってる\nじゃない。",
            "zh": "噗……笨蛋。\n当然是开玩笑的\n嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "つばめ",
            "text": "…え？",
            "zh": "……诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "164/TALK",
            "narrator": "ガブリエラ",
            "text": "冗談よ、冗談。\nっていうか、常識的に\n考えればわかるでしょ？",
            "zh": "开玩笑的，开玩笑。\n话说用常识想想\n就能明白吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "中学生のあたしが、\n家出で外国まで\n来れると思う？",
            "zh": "你觉得初中生的我，\n离家出走能跑到\n外国来吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "つばめ",
            "text": "ひ、ヒドイよ！\nわたし、本気で心配\nしたんだよ！？",
            "zh": "太、太过分了！\n我可是真的很担心\n你啊！？",
            "narrator_zh": "燕"
        },
        {
            "location": "169/TALK",
            "narrator": "ガブリエラ",
            "text": "あはは、ごめんって。",
            "zh": "啊哈哈，好啦抱歉。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "171/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、つばめは\n何でもかんでも信じ過ぎ\nだっての。",
            "zh": "话说，燕就是\n什么都太容易\n相信了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "172/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと考えれば\nウソってわかるように\n言ったつもりだけど？",
            "zh": "我本来说得能让人\n稍微想想就明白是假的，\n不过？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "つばめ",
            "text": "でも、ガブちゃんなら\n本当にやりそうだし…。",
            "zh": "不过，加布的话\n真的会那么做……。",
            "narrator_zh": "燕"
        },
        {
            "location": "174/TALK",
            "narrator": "ガブリエラ",
            "text": "どういう意味よ！？",
            "zh": "什么意思！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "176/TALK",
            "narrator": "つばめ",
            "text": "えっ！？　えっと…。",
            "zh": "诶！？　那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "178/TALK",
            "narrator": "つばめ",
            "text": "あ、ああ、そうだ！\nお父さんに返信しないと\nいけなかった！",
            "zh": "啊，对了！\n还得给爸爸\n回信呢！",
            "narrator_zh": "燕"
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "…あんた、逃げ方が\n随分上手くなったわね？",
            "zh": "……你啊，逃跑的\n本事倒是见长呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "180/TALK",
            "narrator": "つばめ",
            "text": "そ、そうかな…？\nごめん…。",
            "zh": "是、是这样吗……？\n对不起……。",
            "narrator_zh": "燕"
        },
        {
            "location": "181/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…まあ、いつもの\nことだから、疲れるし\n一々怒ってらんないわ。",
            "zh": "唉……嘛，也是平常\n的事，累人，\n不值得一一发火。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "182/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、さっさと\n返信しちゃいなさい。",
            "zh": "好了，赶紧\n回信吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "185/TALK",
            "narrator": "つばめ",
            "text": "う、うん。\nえっと…。",
            "zh": "嗯、嗯。\n那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "186/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "187/TALK",
            "narrator": "ガブリエラ",
            "text": "お父さん、\n今頃何してるのかな？",
            "zh": "爸爸现在\n在做什么呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしも、ちょっとは\n気にかけてほしいのに。",
            "zh": "……明明我也想\n多少被放在心上。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "192/TALK",
            "narrator": "つばめ",
            "text": "ん？　どうしたの？",
            "zh": "嗯？　怎么了？",
            "narrator_zh": "燕"
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラ",
            "text": "…何でもないわよ。",
            "zh": "……没什么哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/ACT",
            "narrator": "",
            "text": "そっちが過保護過ぎるんだと言ってやれ",
            "zh": "你就说那边才过度保护过头",
            "narrator_zh": ""
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "確かにそうね",
            "zh": "确实如此。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "前に聞いた話だと",
            "zh": "按之前听说的情况",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "ガブリエラ",
            "text": "毎日何かしら送って来るみたいだし",
            "zh": "好像每天都会发点什么过来",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "210/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、うちは色々と\n特別だから、って\nいうのはあるけど――",
            "zh": "嘛，虽然我家\n是有各种特殊性，\n不过——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめのお父さんは、\nちょっと過保護過ぎ\nなのは確かかもね。",
            "zh": "燕的爸爸确实\n有点过度保护\n过头了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "つばめ",
            "text": "やっぱりそう思う？",
            "zh": "你也这么想？",
            "narrator_zh": "燕"
        },
        {
            "location": "214/TALK",
            "narrator": "つばめ",
            "text": "今日なんて、お昼ご飯は\nちゃんと野菜も\n食べるんだぞ、って――",
            "zh": "像今天还说什么\n午饭要好好\n吃蔬菜什么的——",
            "narrator_zh": "燕"
        },
        {
            "location": "216/TALK",
            "narrator": "つばめ",
            "text": "そんなこと書いて\n送って来るくらいだし。",
            "zh": "都特地写那种事\n发过来了。",
            "narrator_zh": "燕"
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "…過保護なお父さんも\nどうかと思うけど――",
            "zh": "……过度保护的爸爸，\n我也觉得不太行——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "それだけ心配されてる\nつばめにも問題あるん\nじゃない？",
            "zh": "被担心到这个程度的\n燕自己也有问题\n吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "219/TALK",
            "narrator": "つばめ",
            "text": "お、お父さんが\n心配性過ぎるだけだよ！",
            "zh": "是、是老爸\n太爱操心了啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "221/TALK",
            "narrator": "つばめ",
            "text": "もぅ、お父さんのせいで\nあたしがダメ人間と\n勘違いされちゃうよ…。",
            "zh": "好啦，都怪爸爸，\n害我被误会成\n废人啦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、そこまでは\n言ってないし…。",
            "zh": "不，我倒没说到\n那个地步……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/TALK",
            "narrator": "ガブリエラ",
            "text": "ってか、そんなに\nお父さんのこと\n苦手とはね…。",
            "zh": "话说，你对爸爸\n这么不擅长\n啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/TALK",
            "narrator": "つばめ",
            "text": "あ、ううん。\n違うよ。",
            "zh": "啊，不。\n不是的。",
            "narrator_zh": "燕"
        },
        {
            "location": "226/TALK",
            "narrator": "つばめ",
            "text": "お父さんのことは\n苦手でも嫌いでも\nないよ。",
            "zh": "对爸爸，我虽然\n不擅长应对，但也不\n讨厌哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "227/TALK",
            "narrator": "つばめ",
            "text": "っていうか、むしろ\n大好きだし…。",
            "zh": "话说，反而是我\n超级喜欢……。",
            "narrator_zh": "燕"
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ？　あんた、\n今まで言ってたことと\n違くない？",
            "zh": "哈？　你\n跟刚才说的\n不一样吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "231/TALK",
            "narrator": "つばめ",
            "text": "そ、そうかな？\nそんなことないと\n思うけど…。",
            "zh": "是、是这样吗？\n我觉得\n应该不会吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "232/TALK",
            "narrator": "つばめ",
            "text": "過保護過ぎるのが\nちょっと困る、って\nいうのは本当だけど――",
            "zh": "虽然过度保护\n确实有点困扰，\n是真的——",
            "narrator_zh": "燕"
        },
        {
            "location": "233/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、心配して\nもらえるのって、\n嬉しいよ…。",
            "zh": "但果然，能被人\n担心着，\n还是很开心的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "236/TALK",
            "narrator": "つばめ",
            "text": "えっと…\nわかり難いかな？",
            "zh": "那个……\n不太好懂吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん、平気。\nつばめの言ってること、\nよくわかるし…。",
            "zh": "不，没事。\n燕说的话，\n我很能明白……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、ちょっとだけ\n羨ましく思うわ。",
            "zh": "而且，我有点\n羡慕。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "239/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "…何でもない。",
            "zh": "……没什么。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、早く返信して\nあげなさいよ。",
            "zh": "好了，赶紧\n回信去哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/TALK",
            "narrator": "つばめ",
            "text": "う、うん。\nえっと…。",
            "zh": "嗯、嗯。\n那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラ",
            "text": "…お父さんも、あたしの\nこと、少しは心配して\nくれてるかしら？",
            "zh": "……爸爸也会\n多少担心我\n一下吗？",
            "narrator_zh": "加布里埃拉"
        }
    ]
}
