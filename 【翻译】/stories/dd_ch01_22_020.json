{
    "dir": "chap22/daydra/dd_ch01_22_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "22156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "神楽との距離",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "和神乐的距离"
    },
    "entry": [
        {
            "location": "255/SCENARIO",
            "narrator": "",
            "text": "神楽との距離",
            "zh": "和神乐的距离",
            "narrator_zh": ""
        },
        {
            "location": "267/TALK",
            "narrator": "つばめ",
            "text": "あれ？\n神楽ちゃん、いませんか？",
            "zh": "咦？\n神乐不在吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "270/TALK",
            "narrator": "アーヤ",
            "text": "どこに行ったのかしら？\nさっきまでここにいたん\nだけど…。",
            "zh": "去哪儿了？\n刚才还在\n这里……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "271/TALK",
            "narrator": "アーヤ",
            "text": "散歩にでも行ったの\nかもしれないわ。\nＷＡＶＥ送ってみたら？",
            "zh": "也许去散步了。\n发个WAVE\n试试？",
            "narrator_zh": "绫水"
        },
        {
            "location": "272/TALK",
            "narrator": "つばめ",
            "text": "そうしてみます。",
            "zh": "我试试。",
            "narrator_zh": "燕"
        },
        {
            "location": "280/TALK",
            "narrator": "つばめ",
            "text": "えっと…\n今、どこにいるの？",
            "zh": "那个……\n你现在在哪儿？",
            "narrator_zh": "燕"
        },
        {
            "location": "281/TALK",
            "narrator": "つばめ",
            "text": "送信、っと。",
            "zh": "发送。",
            "narrator_zh": "燕"
        },
        {
            "location": "282/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "286/TALK",
            "narrator": "つばめ",
            "text": "あ、返ってきた。\nえっと――",
            "zh": "啊，回了。\n那个——",
            "narrator_zh": "燕"
        },
        {
            "location": "287/TALK",
            "narrator": "つばめ",
            "text": "コンビニに行ってきます。\n欲しい物があったら\n言ってください…。",
            "zh": "我去趟便利店。\n有想要的东西\n请告诉我……。",
            "narrator_zh": "燕"
        },
        {
            "location": "289/TALK",
            "narrator": "つばめ",
            "text": "…コンビニ行くなら、\n誘ってくれれば\n良かったのに。",
            "zh": "……去便利店的话，\n叫上我就\n好了。",
            "narrator_zh": "燕"
        },
        {
            "location": "290/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "297/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃん、やっぱりまだ落ち込んでるのかな？",
            "zh": "神乐，果然还在失落吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "298/TALK",
            "narrator": "つばめ",
            "text": "なんとなくだけど、ちょっと距離を開けられてる気がするの",
            "zh": "虽然只是感觉，好像被拉开了一点距离",
            "narrator_zh": "燕"
        },
        {
            "location": "299/TALK",
            "narrator": "つばめ",
            "text": "今も、こんな時間に一人でコンビニに行っちゃうし…",
            "zh": "现在也是，这个时间一个人跑去便利店……",
            "narrator_zh": "燕"
        },
        {
            "location": "300/TALK",
            "narrator": "つばめ",
            "text": "…それとも、わたしの考え過ぎかな？",
            "zh": "……还是说，我想太多了？",
            "narrator_zh": "燕"
        },
        {
            "location": "302/SEL",
            "narrator": "",
            "text": "避けられてるみたい",
            "zh": "好像在躲着你",
            "narrator_zh": ""
        },
        {
            "location": "303/SEL",
            "narrator": "",
            "text": "今から追いかければ？",
            "zh": "现在追上去怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "304/SEL",
            "narrator": "",
            "text": "アイスでも頼もうよ",
            "zh": "让她带个冰淇淋吧",
            "narrator_zh": ""
        },
        {
            "location": "305/ACT",
            "narrator": "",
            "text": "避けられてるみたい",
            "zh": "好像在躲着你",
            "narrator_zh": ""
        },
        {
            "location": "308/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、そうなのかな？",
            "zh": "果然是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "309/TALK",
            "narrator": "つばめ",
            "text": "一応仲直りはしたんだけど",
            "zh": "好歹是和好了",
            "narrator_zh": "燕"
        },
        {
            "location": "310/TALK",
            "narrator": "つばめ",
            "text": "…でも、やっぱり何か引っかかるかも",
            "zh": "……可是，果然还是有哪里不对",
            "narrator_zh": "燕"
        },
        {
            "location": "321/TALK",
            "narrator": "つばめ",
            "text": "…よし、決めた！",
            "zh": "……好，决定了！",
            "narrator_zh": "燕"
        },
        {
            "location": "332/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "333/TALK",
            "narrator": "つばめ",
            "text": "いた！\n神楽ちゃーん！",
            "zh": "找到了！\n神乐——！",
            "narrator_zh": "燕"
        },
        {
            "location": "348/TALK",
            "narrator": "神楽",
            "text": "つばめさん！？",
            "zh": "燕！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "350/TALK",
            "narrator": "つばめ",
            "text": "はぁ、はぁ…よかったぁ。\n行き違いにならなくて。",
            "zh": "哈啊，哈啊……太好了。\n没有走岔。",
            "narrator_zh": "燕"
        },
        {
            "location": "351/TALK",
            "narrator": "神楽",
            "text": "走ってきたんですか！？\nそんなに息切らせて…。",
            "zh": "跑过来的吗！？\n喘成这样……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "354/TALK",
            "narrator": "つばめ",
            "text": "はぁ、はぁ…うん。",
            "zh": "哈啊，哈啊……嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "355/TALK",
            "narrator": "つばめ",
            "text": "どうしても、神楽ちゃんに\n会いたくて…。",
            "zh": "无论如何，都想\n见到神乐……。",
            "narrator_zh": "燕"
        },
        {
            "location": "356/TALK",
            "narrator": "神楽",
            "text": "えっ？",
            "zh": "欸？",
            "narrator_zh": "神乐"
        },
        {
            "location": "358/TALK",
            "narrator": "つばめ",
            "text": "二人っきりで、\nお話したかったの。",
            "zh": "想两个人，\n说说话。",
            "narrator_zh": "燕"
        },
        {
            "location": "361/TALK",
            "narrator": "神楽",
            "text": "…つばめさん、さっきから\n狙ってドキッとさせること\n言ってませんか？",
            "zh": "……燕，从刚才起\n是不是故意说些\n让人心跳的话？",
            "narrator_zh": "神乐"
        },
        {
            "location": "362/TALK",
            "narrator": "つばめ",
            "text": "えっ？\nえっと、よくわからないん\nだけど…。",
            "zh": "欸？\n那个，我不太\n明白……。",
            "narrator_zh": "燕"
        },
        {
            "location": "366/TALK",
            "narrator": "神楽",
            "text": "…そうですよね。\nつばめさんはそういう\nタイプじゃありませんし。",
            "zh": "……也是。\n燕不是那种\n类型。",
            "narrator_zh": "神乐"
        },
        {
            "location": "368/TALK",
            "narrator": "神楽",
            "text": "それはともかく、\n別にここまで来なくても\n良かったじゃないですか。",
            "zh": "先不说这个，\n没必要特意\n追到这里吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "369/TALK",
            "narrator": "神楽",
            "text": "話なら、私が帰ってから\nでもできるのに…。",
            "zh": "要说的话，等我回去\n也可以的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "370/TALK",
            "narrator": "つばめ",
            "text": "それだと、神楽ちゃんに\n逃げられちゃいそうな\n気がするし…。",
            "zh": "那样的话，感觉\n神乐会\n逃走……。",
            "narrator_zh": "燕"
        },
        {
            "location": "373/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "374/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんのことは、\nこれでも結構わかってる\nつもりだよ。",
            "zh": "神乐的事，\n我自以为还挺\n了解的。",
            "narrator_zh": "燕"
        },
        {
            "location": "375/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "376/TALK",
            "narrator": "つばめ",
            "text": "間違ってた？",
            "zh": "猜错了？",
            "narrator_zh": "燕"
        },
        {
            "location": "381/TALK",
            "narrator": "神楽",
            "text": "…本当、つばめさんって\n狙わずに相手をドキッと\nさせる天才ですね。",
            "zh": "……真是的，燕\n不用故意就能让人\n心跳，真是天才。",
            "narrator_zh": "神乐"
        },
        {
            "location": "382/TALK",
            "narrator": "神楽",
            "text": "そこまでわかられてると、\n少しだけ悔しいです。",
            "zh": "被看透到这个地步，\n有一点不甘心。",
            "narrator_zh": "神乐"
        },
        {
            "location": "383/TALK",
            "narrator": "つばめ",
            "text": "そうなの？",
            "zh": "是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "385/TALK",
            "narrator": "神楽",
            "text": "そうですよ。\nけど、私だって負けて\nませんよ。",
            "zh": "是啊。\n不过，我也不会\n输。",
            "narrator_zh": "神乐"
        },
        {
            "location": "386/TALK",
            "narrator": "神楽",
            "text": "私も、つばめさんからの\n返信をもらった時――",
            "zh": "我也是，收到燕的\n回复的时候——",
            "narrator_zh": "神乐"
        },
        {
            "location": "388/TALK",
            "narrator": "神楽",
            "text": "多分追いかけてくる、\nって思ってましたし。",
            "zh": "就想着，你大概\n会追过来。",
            "narrator_zh": "神乐"
        },
        {
            "location": "389/TALK",
            "narrator": "つばめ",
            "text": "えっ、そうなの！？",
            "zh": "欸，是这样！？",
            "narrator_zh": "燕"
        },
        {
            "location": "390/TALK",
            "narrator": "神楽",
            "text": "何ヶ月一緒にいると\n思ってるんですか？",
            "zh": "你以为我们在一起\n几个月了？",
            "narrator_zh": "神乐"
        },
        {
            "location": "391/TALK",
            "narrator": "神楽",
            "text": "私だって、つばめさんの\nことは結構わかっている\nつもりなんですよ？",
            "zh": "我对燕的事，\n也自以为挺\n了解的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "392/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "394/TALK",
            "narrator": "つばめ",
            "text": "嬉しいけど、ちょっとだけ\n恥ずかしいかも。",
            "zh": "高兴，可是有一点\n不好意思。",
            "narrator_zh": "燕"
        },
        {
            "location": "396/TALK",
            "narrator": "神楽",
            "text": "最初に言い出したのは\nつばめさんの方じゃ\nないですか、もぅ…。",
            "zh": "先说出来的\n是燕吧，\n真是的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "398/TALK",
            "narrator": "つばめ",
            "text": "えへへ…。",
            "zh": "诶嘿嘿……。",
            "narrator_zh": "燕"
        },
        {
            "location": "399/TALK",
            "narrator": "つばめ",
            "text": "少し遠回りして、\nお散歩しながら帰らない？",
            "zh": "稍微绕个路，\n散着步回去好不好？",
            "narrator_zh": "燕"
        },
        {
            "location": "400/TALK",
            "narrator": "つばめ",
            "text": "わたし、もう少しだけ\n神楽ちゃんとお話したいな。",
            "zh": "我还想再跟神乐\n多说一会儿。",
            "narrator_zh": "燕"
        },
        {
            "location": "402/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "403/TALK",
            "narrator": "つばめ",
            "text": "ダメ？",
            "zh": "不行？",
            "narrator_zh": "燕"
        },
        {
            "location": "404/TALK",
            "narrator": "神楽",
            "text": "いえ…私も、もう少し\nつばめさんとお話したい\nです。",
            "zh": "不……我也想再和\n燕多说\n一会儿。",
            "narrator_zh": "神乐"
        },
        {
            "location": "405/TALK",
            "narrator": "神楽",
            "text": "こっち来てから、あんまり\nお話してませんでしたし。",
            "zh": "来了这边之后，\n没怎么说话。",
            "narrator_zh": "神乐"
        },
        {
            "location": "407/TALK",
            "narrator": "つばめ",
            "text": "うん！",
            "zh": "嗯！",
            "narrator_zh": "燕"
        },
        {
            "location": "408/TALK",
            "narrator": "つばめ",
            "text": "わたし、夜の砂浜に\n行ってみたいな。",
            "zh": "我想去\n夜里的沙滩。",
            "narrator_zh": "燕"
        },
        {
            "location": "410/TALK",
            "narrator": "神楽",
            "text": "そんなところに\n誘うなんて――",
            "zh": "约人去\n那种地方——",
            "narrator_zh": "神乐"
        },
        {
            "location": "412/TALK",
            "narrator": "神楽",
            "text": "つばめさん、もしかして\nまた押し倒されたいとか\n思ってませんか？",
            "zh": "燕，难道\n又想被推倒\n吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "415/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nち、違うよぉ！",
            "zh": "欸欸！？\n不、不是呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "417/TALK",
            "narrator": "神楽",
            "text": "ふふっ、冗談ですよ。",
            "zh": "呵呵，开玩笑的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "420/TALK",
            "narrator": "神楽",
            "text": "つばめさんが慌てる、\n可愛いところを\n見たかっただけです。",
            "zh": "只是想看\n燕慌张起来\n可爱的样子。",
            "narrator_zh": "神乐"
        },
        {
            "location": "437/ACT",
            "narrator": "",
            "text": "今から追いかければ？",
            "zh": "现在追上去怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "438/TALK",
            "narrator": "つばめ",
            "text": "そうしようかな？",
            "zh": "就这么做吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "439/TALK",
            "narrator": "つばめ",
            "text": "それなら、歩きながらお話もできるし",
            "zh": "那样的话，走着也能说话",
            "narrator_zh": "燕"
        },
        {
            "location": "444/TALK",
            "narrator": "つばめ",
            "text": "えっと…わたしも今から\n行くよ、と…送信！",
            "zh": "那个……我现在也\n过去哦，然后……发送！",
            "narrator_zh": "燕"
        },
        {
            "location": "445/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "449/TALK",
            "narrator": "つばめ",
            "text": "あ、返ってきた。",
            "zh": "啊，回了。",
            "narrator_zh": "燕"
        },
        {
            "location": "450/TALK",
            "narrator": "つばめ",
            "text": "…もう終わるところなので\n良いです…。",
            "zh": "……马上就结束了，\n不用了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "452/TALK",
            "narrator": "つばめ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "454/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、避けられ\nてるのかも…。",
            "zh": "果然，是在\n躲着我……。",
            "narrator_zh": "燕"
        },
        {
            "location": "455/TALK",
            "narrator": "つばめ",
            "text": "合宿中に、もう一度\n機会を見つけて二人きりで\n話したいな…。",
            "zh": "合宿期间，想再找个\n机会两个人\n说说话……。",
            "narrator_zh": "燕"
        },
        {
            "location": "456/ACT",
            "narrator": "",
            "text": "アイスでも頼もうよ",
            "zh": "让她带个冰淇淋吧",
            "narrator_zh": ""
        },
        {
            "location": "458/TALK",
            "narrator": "つばめ",
            "text": "わたしの考え過ぎってこと？",
            "zh": "是我想太多了？",
            "narrator_zh": "燕"
        },
        {
            "location": "459/TALK",
            "narrator": "つばめ",
            "text": "そうなのかな？",
            "zh": "是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "465/TALK",
            "narrator": "つばめ",
            "text": "う～ん…。",
            "zh": "嗯——……。",
            "narrator_zh": "燕"
        },
        {
            "location": "466/TALK",
            "narrator": "つばめ",
            "text": "でも、仲直りはちゃんと\nしたんだし…。",
            "zh": "可是，和好是好好\n和好了的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "467/TALK",
            "narrator": "つばめ",
            "text": "…そうだよね？\n多分、考え過ぎだよね。",
            "zh": "……是吧？\n大概是我想太多了吧。",
            "narrator_zh": "燕"
        },
        {
