 },
 "entry": [
  {
   "location": "189/SCENARIO",
   "narrator": "",
   "text": "トーキョー奇譚"
  },
  {
   "location": "210/TALK",
   "narrator": "ガブリエラ",
   "text": "…お客さん、\n来ないわね。"
  },
  {
   "location": "212/TALK",
   "narrator": "みやび",
   "text": "いつものことぞね。"
  },
  {
   "location": "214/TALK",
   "narrator": "つばめ",
   "text": "掃除ももう\n終わっちゃい\nましたしね……。"
  },
  {
   "location": "217/TALK",
   "narrator": "みやび",
   "text": "いっそ今日は\n休館日に\nしたらどうかいね。"
  },
  {
   "location": "218/TALK",
   "narrator": "つばめ",
   "text": "そんなことして\nいいんですか！？",
   "zh": "做那种事\n可以吗！？",
   "narrator_zh": "燕"
  },
  {
   "location": "221/TALK",
   "narrator": "ガブリエラ",
   "text": "……さすがにそれは\nダメでしょ……。"
  },
  {
   "location": "225/TALK",
   "narrator": "みやび",
   "text": "ガブちゃんは\n真面目やねえ。"
  },
  {
   "location": "226/TALK",
   "narrator": "みやび",
   "text": "うち以上に真面目なんは\nガブちゃんだけぞね。"
  },
  {
   "location": "228/TALK",
   "narrator": "ガブリエラ",
   "text": "みやびより不真面目な\n人なんて滅多にいないの\n間違いでしょ？"
  },
  {
   "location": "230/TALK",
   "narrator": "神楽",
   "text": "…実は。",
   "zh": "……其实。",
   "narrator_zh": "神乐"
  },
  {
   "location": "231/TALK",
   "narrator": "神楽",
   "text": "真面目に聞いて欲しい\n話があるんです。"
  },
  {
   "location": "235/TALK",
   "narrator": "みやび",
   "text": "え？",
   "zh": "诶？",
   "narrator_zh": "雅"
  },
  {
   "location": "239/TALK",
   "narrator": "つばめ",
   "text": "どんな話？",
   "zh": "什么话题？",
   "narrator_zh": "燕"
  },
  {
   "location": "240/TALK",
   "narrator": "神楽",
   "text": "神楽坂と\n卯月神楽にまつわる\n秘密の話です。"
  },
  {
   "location": "241/TALK",
   "narrator": "みやび",
   "text": "……なるほど？"
  },
  {
   "location": "242/SEL",
   "narrator": "",
   "text": "聞いてないよ！？",
   "zh": "我没听过啊！？",
   "narrator_zh": ""
  },
  {
   "location": "243/ACT",
   "narrator": "",
   "text": "聞いてないよ！？",
   "zh": "我没听过啊！？",
   "narrator_zh": ""
  },
  {
   "location": "260/TALK",
   "narrator": "神楽",
   "text": "そういえば",
   "zh": "说起来",
   "narrator_zh": "神乐"
  },
  {
   "location": "261/TALK",
   "narrator": "神楽",
   "text": "$handle$さんにも言ってない話でした♪",
   "zh": "这是连$handle$都没说过的话♪",
   "narrator_zh": "神乐"
  },
  {
   "location": "263/SEL",
   "narrator": "",
   "text": "後付けの設定かなー",
   "zh": "是后补的设定吧——",
   "narrator_zh": ""
  },
  {
   "location": "264/SEL",
   "narrator": "",
   "text": "$me$に先に教えて欲しかった",
   "zh": "真希望你早点告诉$me$",
   "narrator_zh": ""
  },
  {
   "location": "265/SEL",
   "narrator": "",
   "text": "聞くのが楽しみ",
   "zh": "我很期待听",
   "narrator_zh": ""
  },
  {
   "location": "266/ACT",
   "narrator": "",
   "text": "後付けの設定かなー",
   "zh": "是后补的设定吧——",
   "narrator_zh": ""
  },
  {
   "location": "267/TALK",
   "narrator": "神楽",
   "text": "後付けっていうか"
  },
  {
   "location": "268/TALK",
   "narrator": "神楽",
   "text": "今思いついた話なんですけどね♪"
  },
  {
   "location": "271/ACT",
   "narrator": "",
   "text": "$me$に先に教えて欲しかった",
   "zh": "真希望你早点告诉$me$",
   "narrator_zh": ""
  },
  {
   "location": "272/TALK",
   "narrator": "神楽",
   "text": "ちょっと難しいですね～",
   "zh": "有点难呢～",
   "narrator_zh": "神乐"
  },
  {
   "location": "273/TALK",
   "narrator": "神楽",
   "text": "今思いついた話ですから♪"
  },
  {
   "location": "275/ACT",
   "narrator": "",
   "text": "聞くのが楽しみ",
   "zh": "我很期待听",
   "narrator_zh": ""
  },
  {
   "location": "276/TALK",
   "narrator": "神楽",
   "text": "ハードル上がっちゃいましたね"
  },
  {
   "location": "277/TALK",
   "narrator": "神楽",
   "text": "ぴょんこがんばります★"
  },
  {
   "location": "291/TALK",
   "narrator": "神楽",
   "text": "…お待たせしました。"
  },
  {
   "location": "292/TALK",
   "narrator": "神楽",
   "text": "神楽と神楽坂の\n秘密をお話しましょう。"
  },
  {
   "location": "293/TALK",
   "narrator": "つばめ",
   "text": "……。"
  },
  {
   "location": "294/TALK",
   "narrator": "神楽",
   "text": "この坂には\n神楽パワーが\n満ちているんです。",
   "zh": "这座斜坡上\n充满了神乐的\n力量。",
   "narrator_zh": "神乐"
  },
  {
   "location": "295/TALK",
   "narrator": "つばめ",
   "text": "そうなんだ！？",
   "zh": "原来是这样啊！？",
   "narrator_zh": "燕"
  },
  {
   "location": "296/TALK",
   "narrator": "みやび",
   "text": "へえ？"
  },
  {
   "location": "297/TALK",
   "narrator": "ガブリエラ",
   "text": "またまた",
   "zh": "又来了",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "299/SEL",
   "narrator": "",
   "text": "どんなパワー？",
   "zh": "什么样的力量？",
   "narrator_zh": ""
  },
  {
   "location": "300/ACT",
   "narrator": "",
   "text": "どんなパワー？",
   "zh": "什么样的力量？",
   "narrator_zh": ""
  },
  {
   "location": "317/TALK",
   "narrator": "神楽",
   "text": "何にすればいいでしょう？"
  },
  {
   "location": "319/SEL",
   "narrator": "",
   "text": "決めてなかったの？",
   "zh": "你没定好吗？",
   "narrator_zh": ""
  },
  {
   "location": "320/SEL",
   "narrator": "",
   "text": "いや聞かれても",
   "zh": "就算你这么问",
   "narrator_zh": ""
  },
  {
   "location": "321/ACT",
   "narrator": "",
   "text": "決めてなかったの？",
   "zh": "你没定好吗？",
   "narrator_zh": ""
  },
  {
   "location": "323/TALK",
   "narrator": "神楽",
   "text": "そうなんです",
   "zh": "是这样",
   "narrator_zh": "神乐"
  },
  {
   "location": "324/ACT",
   "narrator": "",
   "text": "いや聞かれても",
   "zh": "就算你这么问",
   "narrator_zh": ""
  },
  {
   "location": "325/TALK",
   "narrator": "神楽",
   "text": "そんな",
   "zh": "那种",
   "narrator_zh": "神乐"
  },
  {
   "location": "326/TALK",
   "narrator": "神楽",
   "text": "$handle$さんだけが頼りなんです～～～",
   "zh": "只能靠$handle$了～～～",
   "narrator_zh": "神乐"
  },
  {
   "location": "329/SEL",
   "narrator": "",
   "text": "天気を左右する力",
   "zh": "左右天气的力量",
   "narrator_zh": ""
  },
  {
   "location": "330/SEL",
   "narrator": "",
   "text": "坂道を楽しく上る力",
   "zh": "快乐爬坡的力量",
   "narrator_zh": ""
  },
  {
   "location": "331/SEL",
   "narrator": "",
   "text": "恋愛成就の力",
   "zh": "让恋情开花的力量",
   "narrator_zh": ""
  },
  {
   "location": "332/ACT",
   "narrator": "",
   "text": "天気を左右する力",
   "zh": "左右天气的力量",
   "narrator_zh": ""
  },
  {
   "location": "333/TALK",
   "narrator": "神楽",
   "text": "かなり強いパワーですねっ",
   "zh": "是相当强的力量呢",
   "narrator_zh": "神乐"
  },
  {
   "location": "335/TALK",
   "narrator": "神楽",
   "text": "気に入りました♪"
  },
  {
   "location": "347/TALK",
   "narrator": "神楽",
   "text": "えー…。\n天気を左右する力\nなんです。",
   "zh": "诶……。\n那是能左右天气的\n力量啊。",
   "narrator_zh": "神乐"
  },
  {
   "location": "348/TALK",
   "narrator": "みやび",
   "text": "それはまた便利な\n力やねえ。",
   "zh": "那又是很方便的\n力量呢。",
   "narrator_zh": "雅"
  },
  {
   "location": "349/TALK",
   "narrator": "つばめ",
   "text": "本当だね！\n卯月さんすごい！"
  },
  {
   "location": "350/TALK",
   "narrator": "神楽",
   "text": "そうでしょう？\nありがとうございます。",
   "zh": "是吧？\n谢谢你。",
   "narrator_zh": "神乐"
  },
  {
   "location": "352/TALK",
   "narrator": "つばめ",
   "text": "かっこいいね！\nさすがだよ！",
   "zh": "好帅啊！\n真不愧是你！",
   "narrator_zh": "燕"
  },
  {
   "location": "353/TALK",
   "narrator": "ガブリエラ",
   "text": "…いやいや。\nまあいいか。"
  },
  {
   "location": "354/ACT",
   "narrator": "",
   "text": "坂道を楽しく上る力",
   "zh": "快乐爬坡的力量",
   "narrator_zh": ""
  },
  {
   "location": "355/TALK",
   "narrator": "神楽",
   "text": "微妙ですね……。"
  },
  {
   "location": "356/TALK",
   "narrator": "神楽",
   "text": "でもその位地味な方がリアリティがあるかもしれませんねっ♪",
   "zh": "不过也许那种朴素一点的更有真实感呢♪",
   "narrator_zh": "神乐"
  },
  {
   "location": "368/TALK",
   "narrator": "神楽",
   "text": "えっとですね…。"
  },
  {
   "location": "369/TALK",
   "narrator": "神楽",
   "text": "坂道を楽しく上る力\nなんです。"
  },
  {
   "location": "370/TALK",
   "narrator": "ガブリエラ",
   "text": "…期待したけど\nいまいちね。",
   "zh": "……期待过，\n不过也就那样呢。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "371/TALK",
   "narrator": "みやび",
   "text": "もっと\n超常現象的なものを\n期待したんやけんど。"
  },
  {
   "location": "372/TALK",
   "narrator": "つばめ",
   "text": "ううん、すごいよ！"
  },
  {
   "location": "373/TALK",
   "narrator": "つばめ",
   "text": "わたしいつも\n神楽坂歩くの\n楽しいなって思ってた。"
  },
  {
   "location": "375/TALK",
   "narrator": "つばめ",
   "text": "それは卯月さんの\nおかげだったんだね！",
   "zh": "那都是托卯月的\n福呢！",
   "narrator_zh": "燕"
  },
  {
   "location": "376/TALK",
   "narrator": "神楽",
   "text": "そ、そうです、ね…。",
   "zh": "是、是这样，吧……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "377/TALK",
   "narrator": "ガブリエラ",
   "text": "そういうことに\nしておけば？",
   "zh": "就这么\n理解不就好了？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "378/ACT",
   "narrator": "",
   "text": "恋愛成就の力",
   "zh": "让恋情开花的力量",
   "narrator_zh": ""
  },
  {
   "location": "379/TALK",
   "narrator": "神楽",
   "text": "女子ウケしそうな答えですね"
  },
  {
   "location": "380/TALK",
   "narrator": "神楽",
   "text": "そうしてみます♪",
   "zh": "我试试看♪",
   "narrator_zh": "神乐"
  },
  {
   "location": "392/TALK",
   "narrator": "神楽",
   "text": "恋愛成就の力が\nあるんです。"
  },
  {
   "location": "393/TALK",
   "narrator": "みやび",
   "text": "…坂に？",
   "zh": "……坡道？",
   "narrator_zh": "雅"
  },
  {
   "location": "394/TALK",
   "narrator": "神楽",
   "text": "そ、そうですね。\n神楽坂をそぞろ歩けば\n恋が実るんです。",
   "zh": "是、是啊。\n在神乐坂漫步，\n恋情就会开花结果。",
   "narrator_zh": "神乐"
  },
  {
   "location": "396/TALK",
   "narrator": "みやび",
   "text": "…それはまた\nえろうロマンチック\nやねえ。"
  },
  {
   "location": "397/TALK",
   "narrator": "ガブリエラ",
   "text": "ほんとにねー。"
  },
  {
   "location": "398/TALK",
   "narrator": "つばめ",
   "text": "うん！\nそうだよね！"
  },
  {
   "location": "401/TALK",
   "narrator": "みやび",
   "text": "お？",
   "zh": "哦？",
   "narrator_zh": "雅"
  },
  {
   "location": "402/TALK",
   "narrator": "つばめ",
   "text": "だからデートコースに\nする人がいるんだね。\n知らなかったよ。",
   "zh": "所以才会有人拿来\n当约会路线呢。\n我都不知道。",
   "narrator_zh": "燕"
  },
  {
   "location": "403/TALK",
   "narrator": "みやび",
   "text": "…まあそうやろうねえ。",
   "zh": "……嘛，大概就是这样咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "405/TALK",
   "narrator": "ガブリエラ",
   "text": "信じれば本当に\nなるかもよ？"
  },
  {
   "location": "199/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>某月某日　4:24 PM</color>\nとある平日、神楽坂トライナリーにて"
  }
 ]
}
