{
    "dir": "dramatics/daydra/drm_ch03_00_100.js",
    "type": "Episode",
    "info": {
        "story_id": "3010",
        "cid": "gabriella",
        "title": "らぶとーく  第10話",
        "sub_title": "見たくなかった真実",
        "title_zh": "恋爱漫谈 第10话",
        "sub_title_zh": "不想看见的真相"
    },
    "entry": [
        {
            "location": "234/SCENARIO",
            "narrator": "",
            "text": "見たくなかった真実",
            "zh": "不想看见的真相"
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/TALK",
            "narrator": "雛",
            "text": "珍しいねー。",
            "zh": "真少见呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "250/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんが、\nそんな思い悩んだ\n顔してるなんて。",
            "zh": "加布里埃拉\n居然露出\n这么烦恼的脸。",
            "narrator_zh": "雏"
        },
        {
            "location": "251/TALK",
            "narrator": "ガブリエラ",
            "text": "…ちょっと、悩んでる\nことがあるのよ。",
            "zh": "……有点\n在烦恼的事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "252/TALK",
            "narrator": "雛",
            "text": "ピピッと来た！！\n恋愛の悩みでしょ！？",
            "zh": "叮地一下就懂了！！\n是恋爱烦恼吧！？",
            "narrator_zh": "雏"
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "…いや、全然違うし。",
            "zh": "……才不是，完全不一样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/TALK",
            "narrator": "繭",
            "text": "変なの受信してるだけ。\nいつものことだから\n放っておいていい。",
            "zh": "只是收到奇怪的东西。\n平时也这样，\n放着不管就行。",
            "narrator_zh": "茧"
        },
        {
            "location": "257/TALK",
            "narrator": "雛",
            "text": "高性能なだけですー！",
            "zh": "只是性能很高啦！",
            "narrator_zh": "雏"
        },
        {
            "location": "258/TALK",
            "narrator": "繭",
            "text": "…まあ、聞くくらいは\nできるから。",
            "zh": "……嘛，至少听听\n还是可以的。",
            "narrator_zh": "茧"
        },
        {
            "location": "259/TALK",
            "narrator": "雛",
            "text": "聞くって、何を？",
            "zh": "听，听什么？",
            "narrator_zh": "雏"
        },
        {
            "location": "260/TALK",
            "narrator": "繭",
            "text": "悩みの話でしょ？\nアドバイスは期待され\nても困るけど。",
            "zh": "是烦恼的事吧？\n要我给建议的话\n可就为难了。",
            "narrator_zh": "茧"
        },
        {
            "location": "262/TALK",
            "narrator": "ガブリエラ",
            "text": "期待はしてないわ。\nどうしようもないこと、\nってのはわかって――",
            "zh": "没期待。\n我知道这是\n没办法的事——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "264/TALK",
            "narrator": "繭",
            "text": "あっ。",
            "zh": "啊。",
            "narrator_zh": "茧"
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "267/TALK",
            "narrator": "繭",
            "text": "…ごめんなさい。\n話の腰を折ったわ。",
            "zh": "……对不起。\n打断你了。",
            "narrator_zh": "茧"
        },
        {
            "location": "270/TALK",
            "narrator": "ガブリエラ",
            "text": "…別に良いわ。\nそれより、\n何かあったの？",
            "zh": "……没关系哦。\n倒是说，\n出什么事了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "272/TALK",
            "narrator": "繭",
            "text": "うん。今、カプドラを\nやっていたんだけど――",
            "zh": "嗯。刚才在玩\n卡普多拉——",
            "narrator_zh": "茧"
        },
        {
            "location": "273/TALK",
            "narrator": "繭",
            "text": "Ｂｏｔアカウントを\n見つけたの。",
            "zh": "发现了\nBot账号。",
            "narrator_zh": "茧"
        },
        {
            "location": "276/TALK",
            "narrator": "ガブリエラ",
            "text": "…Ｂｏｔアカウント？",
            "zh": "……Bot账号？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "278/TALK",
            "narrator": "雛",
            "text": "どれどれ？",
            "zh": "我看看？",
            "narrator_zh": "雏"
        },
        {
            "location": "279/TALK",
            "narrator": "繭",
            "text": "こいつ。\nさっきフレンド登録した\nユーザーだけど――",
            "zh": "这家伙。\n是刚才加好友的\n用户吧——",
            "narrator_zh": "茧"
        },
        {
            "location": "280/TALK",
            "narrator": "繭",
            "text": "あとでブロックして\nおかないと。",
            "zh": "待会儿得\n拉黑才行。",
            "narrator_zh": "茧"
        },
        {
            "location": "282/TALK",
            "narrator": "ガブリエラ",
            "text": "…これ、本当にＢｏｔ？\nあたしには普通にしか\n見えないけど？",
            "zh": "……这个，真的是Bot？\n在我看来\n只是普通人啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "284/TALK",
            "narrator": "繭",
            "text": "明らかにＢｏｔ。\nまず、パターン化された\n行動しかしないでしょ。",
            "zh": "明显是Bot。\n首先，只会做\n模式化的行动吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "285/TALK",
            "narrator": "繭",
            "text": "それにこっちの\nメッセージに対する\n返答も皆無。",
            "zh": "而且对这边的\n消息也完全\n没有回复。",
            "narrator_zh": "茧"
        },
        {
            "location": "286/TALK",
            "narrator": "繭",
            "text": "それに、反応速度が\n明らかに異常。",
            "zh": "而且，反应速度\n明显异常。",
            "narrator_zh": "茧"
        },
        {
            "location": "287/TALK",
            "narrator": "ガブリエラ",
            "text": "…パターン化された\n行動？",
            "zh": "……模式化的\n行动？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、マルザンナは\nＢｏｔなのに、そんなの\nないし…。",
            "zh": "不过，马尔赞娜明明是\nBot，不会有\n那种事……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "…じゃ、じゃあさ…\nその逆は？",
            "zh": "……那、那么……\n反过来呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "293/TALK",
            "narrator": "繭",
            "text": "？",
            "zh": "？",
            "narrator_zh": "茧"
        },
        {
            "location": "297/TALK",
            "narrator": "ガブリエラ",
            "text": "パターン化された行動を\nしないで、メッセージに\n返事をして来たら――",
            "zh": "要是不做\n模式化的行动，还会\n回消息的话——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "298/TALK",
            "narrator": "ガブリエラ",
            "text": "それは、人間…\nってことになるの？",
            "zh": "那、就是人类……\n的意思吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "299/TALK",
            "narrator": "繭",
            "text": "…大雑把に答えると、\nそういうことになる。",
            "zh": "……粗略地回答的话，\n就是那么回事。",
            "narrator_zh": "茧"
        },
        {
            "location": "301/TALK",
            "narrator": "雛",
            "text": "超絶廃人ゲーマーという\n可能性はー？",
            "zh": "有没有可能是\n超级废人玩家——？",
            "narrator_zh": "雏"
        },
        {
            "location": "302/TALK",
            "narrator": "繭",
            "text": "その割にレベルが低い。\nプレイスタイルも、\n単調過ぎ。",
            "zh": "可水平却很低。\n打法也\n太单调。",
            "narrator_zh": "茧"
        },
        {
            "location": "303/TALK",
            "narrator": "繭",
            "text": "廃人ゲーマーにしては\n明らかにおかしい。",
            "zh": "作为废人玩家来说，\n明显不对劲。",
            "narrator_zh": "茧"
        },
        {
            "location": "305/TALK",
            "narrator": "ガブリエラ",
            "text": "だとすると…\nまさか、本当に…。",
            "zh": "那样的话……\n难道真的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "317/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナ！",
            "zh": "玛尔赞娜！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "318/TALK",
            "narrator": "ガブリエラ",
            "text": "あなた、まさか本当に人間なの？",
            "zh": "你，难道真的是人类？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "320/SEL",
            "narrator": "",
            "text": "ずっとそう言っていたよ",
            "zh": "我一直这么说啊",
            "narrator_zh": ""
        },
        {
            "location": "321/SEL",
            "narrator": "",
            "text": "うん、そうなんだ",
            "zh": "嗯，是这样啊",
            "narrator_zh": ""
        },
        {
            "location": "322/SEL",
            "narrator": "",
            "text": "認めたくなかっただけだよね？",
            "zh": "你只是不想承认吧？",
            "narrator_zh": ""
        },
        {
            "location": "323/ACT",
            "narrator": "",
            "text": "ずっとそう言っていたよ",
            "zh": "我一直这么说啊",
            "narrator_zh": ""
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "確かにそうだけど",
            "zh": "话是这么说没错",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/ACT",
            "narrator": "",
            "text": "うん、そうなんだ",
            "zh": "嗯，是这样啊",
            "narrator_zh": ""
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな…",
            "zh": "那种……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "327/ACT",
            "narrator": "",
            "text": "認めたくなかっただけだよね？",
            "zh": "你只是不想承认吧？",
            "narrator_zh": ""
        },
        {
            "location": "328/TALK",
            "narrator": "ガブリエラ",
            "text": "それは",
            "zh": "这个",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "329/TALK",
            "narrator": "ガブリエラ",
            "text": "そういう気持ちも確かにあったけど",
            "zh": "那种心情也确实有过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "331/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、それならなんでマルザンナのふりをしていたの？",
            "zh": "不过，那为什么要装成马尔赞娜？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "332/TALK",
            "narrator": "ガブリエラ",
            "text": "私がマルザンナって呼ぶたびに、違うって否定すればよかったのに",
            "zh": "每次我叫你玛尔赞娜，你否定说不是就好了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "333/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか！",
            "zh": "怎么会！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "334/TALK",
            "narrator": "ガブリエラ",
            "text": "貴方、マルザンナを乗っ取ったのね！？",
            "zh": "你，把玛尔赞娜顶替掉了吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "336/SEL",
            "narrator": "",
            "text": "最初から$me$は$me$",
            "zh": "$me$从一开始就是$me$",
            "narrator_zh": ""
        },
        {
            "location": "337/ACT",
            "narrator": "",
            "text": "最初から$me$は$me$",
            "zh": "$me$从一开始就是$me$",
            "narrator_zh": ""
        },
        {
            "location": "339/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、なんでマルザンナって名乗ってたのよ？",
            "zh": "那你为什么要自称玛尔赞娜？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "342/SEL",
            "narrator": "",
            "text": "ガブリエラが名付けてくれたから",
            "zh": "因为是加布里埃拉给我起的名字",
            "narrator_zh": ""
        },
        {
            "location": "343/ACT",
            "narrator": "",
            "text": "ガブリエラが名付けてくれたから",
            "zh": "因为是加布里埃拉给我起的名字",
            "narrator_zh": ""
        },
        {
            "location": "345/TALK",
            "narrator": "ガブリエラ",
            "text": "…なるほどね",
            "zh": "……原来如此。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "346/TALK",
            "narrator": "ガブリエラ",
            "text": "とりあえず、今はそれで納得しておくわ",
            "zh": "总之，现在先这么接受吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "357/TALK",
            "narrator": "ガブリエラ",
            "text": "…確かに、マルザンナ\nって勝手に名付けたのは\nあたしだったわ。",
            "zh": "……确实，玛尔赞娜这个名字\n是我自作主张\n取的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "358/TALK",
            "narrator": "ガブリエラ",
            "text": "けど…マルザンナが\n本当に人間だった\nなんて…。",
            "zh": "可是……玛尔赞娜\n居然是真正的人类\n什么的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "360/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…やっぱり、\n人間なのよね…。",
            "zh": "唉……果然，\n是人类呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "362/TALK",
            "narrator": "雛",
            "text": "…まゆちん。\nガブリエラちゃん、\nどうしちゃったのかな？",
            "zh": "……茧茧。\n加布里埃拉她\n到底怎么了呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "364/TALK",
            "narrator": "繭",
            "text": "放っておいて\nいいと思う。",
            "zh": "我觉得\n放着不管就行。",
            "narrator_zh": "茧"
        },
        {
            "location": "365/TALK",
            "narrator": "繭",
            "text": "きっと、私達には\nわからない悩みが\nあるんだろうし…。",
            "zh": "一定有我们\n无法理解的烦恼\n在困扰着她……。",
            "narrator_zh": "茧"
        }
    ]
}
