{
    "dir": "chap00/daydra/spev_ch03_014.js",
    "type": "",
    "info": {
        "story_id": "3014",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "飾らざるもの食うべからず",
        "title_zh": "特别篇",
        "sub_title_zh": "不加修饰的东西不可食"
    },
    "entry": [
        {
            "location": "32/TALK",
            "narrator": "透明ガブリエラ",
            "text": "まったく…、準備できた\nって言ったのは\n誰だったかしら？",
            "zh": "真是的……刚才说\n“准备好了”的\n到底是谁来着？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "コルト",
            "text": "できてるじゃないッスか。\n食事の準備。",
            "zh": "不是已经准备好了嘛，\n饭菜都摆好了。",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "34/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あのね、クリスマス\nパーティーってこと\n忘れてるんじゃないの？",
            "zh": "我说你呀，\n该不会忘了今天是\n圣诞派对吧？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "透明ガブリエラ",
            "text": "主役のツリーが\n飾りづけられてないって、\n大問題でしょ。",
            "zh": "主角圣诞树\n还没装饰上去，\n这可是大问题吧。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "コルト",
            "text": "でも、ツリーだけより、\n食事だけの方がいいと\n思うんスよ。",
            "zh": "可是，比起光看树，\n我觉得光吃饭\n要强多了啊。",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "39/TALK",
            "narrator": "透明ガブリエラ",
            "text": "口答えしない！\nほら、あんたもさっさと\n飾りを付けなさい。",
            "zh": "别顶嘴！\n快点，你也赶紧\n把装饰挂上去。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "コルト",
            "text": "はいはい…。\nこんな感じでいいッスか？",
            "zh": "好好好……\n像这样行了吧？",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "41/TALK",
            "narrator": "透明ガブリエラ",
            "text": "適当すぎ！！\n同じ枝にばっかり\n飾らないの。",
            "zh": "太敷衍了！！\n别净往同一根\n树枝上挂呀。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そんなことしたら\n重さで折れちゃうでしょ？",
            "zh": "那样做的话\n树枝会压断掉的吧？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "コルト",
            "text": "そうなったら飾り付け\nできなくなるッスね！",
            "zh": "真那样的话不就\n不用装饰了嘛！",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "46/TALK",
            "narrator": "透明ガブリエラ",
            "text": "嬉しそうに言うな！",
            "zh": "别一脸高兴地说出来啊！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "コルト",
            "text": "ってか、何も飾らなくても\nツリー自体の存在感だけで\n十分だと思うんスけど？",
            "zh": "再说了，就算什么都不挂，\n光靠树本身的存在感\n我觉得就已经够了啊？",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "48/TALK",
            "narrator": "透明ガブリエラ",
            "text": "なるほど、そんなに\n飾り付けが面倒なのね。",
            "zh": "原来如此，你觉得\n做装饰这么麻烦啊。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "49/TALK",
            "narrator": "コルト",
            "text": "ええ、そりゃもう！",
            "zh": "对啊，那可真是太麻烦了！",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "51/TALK",
            "narrator": "透明ガブリエラ",
            "text": "今度の出動の時、\nいつもよりあんたのこと\n酷使してもいいんだけど？",
            "zh": "那下次出动的时候，\n我可以比平时\n更狠地使唤你喽？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "コルト",
            "text": "あ、あはは！\nイヤだなぁ、姉さん。\n冗談ッスよ、冗談！！",
            "zh": "啊、哈哈！\n别这样嘛，姐。\n开玩笑的啦，开玩笑！！",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "53/TALK",
            "narrator": "コルト",
            "text": "さあ、ドンドン綺麗に\n飾り付けちゃいましょう！\nあ、電飾も付けるッスよ！",
            "zh": "来，赶快把它\n装饰得漂漂亮亮吧！\n啊，小彩灯也得挂上！",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "56/TALK",
            "narrator": "透明ガブリエラ",
            "text": "うんうん、\n働き者は大好きよ。",
            "zh": "嗯嗯，\n我最喜欢勤快人了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "57/TALK",
            "narrator": "透明ガブリエラ",
            "text": "じゃあ、見張ってるから\n続きは任せたわね。",
            "zh": "那好，我在这儿盯着，\n剩下的就交给你了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "コルト",
            "text": "えぇーっ！？",
            "zh": "诶——！？",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "59/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あら、文句があると？",
            "zh": "哎呀，你有意见吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "コルト",
            "text": "い、いいんスか！？\n一人で全部やっちゃって！\nわーいわーい！",
            "zh": "可、可以吗！？\n让我一个人全包了！\n好耶好耶！",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "61/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ええ、もちろんよ。\nサボッた分頑張って\n働きなさいね。",
            "zh": "对呀，当然可以。\n把偷懒的那份给我\n加倍干回来哦。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "コルト",
            "text": "とほほ…。",
            "zh": "呜呜……",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "64/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ふぅ…さてと…。",
            "zh": "呼……好了……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "そっちの方はどう？",
            "zh": "你那边怎么样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "ガブリエラ",
            "text": "クリスマスちゃんと祝ってる？",
            "zh": "有好好在过圣诞节吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "69/SEL",
            "narrator": "（選択肢）",
            "text": "もちろん！",
            "zh": "当然了！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "70/SEL",
            "narrator": "（選択肢）",
            "text": "クリスマスだけど祝ってないよ",
            "zh": "虽然是圣诞节但没在庆祝哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "71/SEL",
            "narrator": "（選択肢）",
            "text": "こっちはクリスマスじゃないよ",
            "zh": "我这边现在不是圣诞节哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "72/ACT",
            "narrator": "",
            "text": "もちろん！",
            "zh": "当然了！",
            "narrator_zh": ""
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりクリスマスは特別な日だもの",
            "zh": "毕竟圣诞节是特别的日子嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "祝わなくっちゃね",
            "zh": "不好好庆祝可不行呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/ACT",
            "narrator": "",
            "text": "クリスマスだけど祝ってないよ",
            "zh": "虽然是圣诞节但没在庆祝哦",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "正気！？",
            "zh": "你认真的吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "クリスマスを祝わないなんて変よ",
            "zh": "圣诞节都不庆祝太奇怪了啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$って変わってるわ",
            "zh": "$handle$真是个怪人",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/ACT",
            "narrator": "",
            "text": "こっちはクリスマスじゃないよ",
            "zh": "我这边现在不是圣诞节哦",
            "narrator_zh": ""
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "あらそうなの？",
            "zh": "哎呀，是这样吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "ガブリエラ",
            "text": "一緒にクリスマスを祝おうと思ったのに",
            "zh": "我还想着能和你一起庆祝圣诞节呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "こっちは見ての通りよ",
            "zh": "我这边就如你所见",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "みんなでクリスマスを祝ってるわ",
            "zh": "大家正在一起庆祝圣诞节呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "今日はクラン達も一緒だから",
            "zh": "今天库兰们也在一起",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "とても賑やかなの",
            "zh": "特别热闹",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/SEL",
            "narrator": "（選択肢）",
            "text": "楽しそうで羨ましい",
            "zh": "看起来好开心，真羡慕",
            "narrator_zh": "（选项）"
        },
        {
            "location": "94/SEL",
            "narrator": "（選択肢）",
            "text": "まだ準備中みたいだけど？",
            "zh": "不过好像还在准备中？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "95/ACT",
            "narrator": "",
            "text": "楽しそうで羨ましい",
            "zh": "看起来好开心，真羡慕",
            "narrator_zh": ""
        },
        {
            "location": "96/TALK",
            "narrator": "ガブリエラ",
            "text": "みんな楽しんでいるわ",
            "zh": "大家都玩得很开心呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "私の方はまだだけど",
            "zh": "虽然我这边还没好",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "クリスマスツリーの飾り付けが終わってないから",
            "zh": "因为圣诞树的装饰还没弄完",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "美味しい料理はまだお預けよ",
            "zh": "美味的大餐还不能开动",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/ACT",
            "narrator": "",
            "text": "まだ準備中みたいだけど？",
            "zh": "不过好像还在准备中？",
            "narrator_zh": ""
        },
        {
            "location": "101/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなのよ",
            "zh": "就是说啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "コルトがツリーの飾り付けをサボってたから",
            "zh": "因为柯尔特装饰圣诞树时在偷懒",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "私はこれが終わるまでお料理はお預け",
            "zh": "弄完之前我也得跟着干等大餐",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "お腹空いたわ",
            "zh": "肚子好饿啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりツリーがないとね",
            "zh": "果然还是得有圣诞树才行呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "シンボルがないと寂しいわ",
            "zh": "没有象征物的话会觉得冷清呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$もそう思うでしょ？",
            "zh": "$handle$也这么觉得吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "111/SEL",
            "narrator": "（選択肢）",
            "text": "もちろんだよ",
            "zh": "那当然",
            "narrator_zh": "（选项）"
        },
        {
            "location": "112/SEL",
            "narrator": "（選択肢）",
            "text": "食事だけで十分じゃない？",
            "zh": "光有大餐不就够了吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "113/ACT",
            "narrator": "",
            "text": "もちろんだよ",
            "zh": "那当然",
            "narrator_zh": ""
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりそうよね",
            "zh": "果然是这样对吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "どんなに美味しい料理が並んでいても",
            "zh": "不管桌上摆着多美味的菜肴",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "ガブリエラ",
            "text": "どんなにみんなと楽しくしていても",
            "zh": "不管大家凑在一起有多开心",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "118/TALK",
            "narrator": "ガブリエラ",
            "text": "クリスマスツリーがないと寂しいものよね",
            "zh": "没有圣诞树的话总归会显得冷清嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "コルトにはわからないみたいだけど",
            "zh": "虽然柯尔特好像理解不了这一点",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/ACT",
            "narrator": "",
            "text": "もちろんだよ",
            "zh": "那当然",
            "narrator_zh": ""
        },
        {
            "location": "121/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$もコルトと一緒なの？",
            "zh": "$handle$也和柯尔特一个想法吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "ツリーのないクリスマスでも平気だなんて",
            "zh": "没有树的圣诞节也觉得无所谓什么的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対に変だと思うんだけど",
            "zh": "我绝对觉得很奇怪好吗",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "お国柄なのかしら？",
            "zh": "难道是国情不同吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "今日はこんな感じで",
            "zh": "今天就像这样",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "ガブリエラ",
            "text": "遅くまでパーティーやりそうだから",
            "zh": "派对大概会开到很晚",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "帰ったらすぐに寝ちゃうかも",
            "zh": "回去之后说不定倒头就睡了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "130/SEL",
            "narrator": "（選択肢）",
            "text": "お話はなしかな？",
            "zh": "今天不聊了吗？",
            "narrator_zh": "（选项）"
        },
        {
