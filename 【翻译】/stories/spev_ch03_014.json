        {
            "location": "135/TALK",
            "narrator": "ガブリエラ",
            "text": "その時はお話ししましょ",
            "zh": "到时候就来聊天吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか",
            "zh": "话说回来",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/TALK",
            "narrator": "ガブリエラ",
            "text": "今日は特別な夜だから",
            "zh": "今天毕竟是特别的夜晚",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "できればお話はしたいんだけど",
