        {
            "location": "148/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あら、いい感じ。\nやればできるじゃない。",
            "zh": "哎呀，挺不错的嘛。\n只要肯干还是做得到的嘛。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "149/TALK",
            "narrator": "コルト",
            "text": "おっ、褒められた。\nじゃあ飾り付けは\nおしまいってことで…。",
            "zh": "哦，被夸了。\n那装饰工作\n就到此结束……",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "151/TALK",
            "narrator": "透明ガブリエラ",
            "text": "はぁ…仕方ないわね。\nまだ完璧じゃないけど、\n許してあげるわ。",
            "zh": "唉……拿你没办法。\n虽然还算不上完美，\n就放你过关吧。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "コルト",
            "text": "マジッスか！？",
            "zh": "真的吗！？",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "153/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あんまりガミガミと\n言いたくないのよ。",
            "zh": "我也不想\n一直啰啰嗦嗦地念叨。",
            "narrator_zh": "透明加布里埃拉"
