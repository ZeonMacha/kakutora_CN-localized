            "narrator": "",
            "text": "お話はなしかな？",
            "zh": "今天不聊了吗？",
            "narrator_zh": ""
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "どうかしら？",
            "zh": "不好说呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "134/TALK",
            "narrator": "ガブリエラ",
            "text": "帰って元気があったら",
            "zh": "要是回去之后还有精神",
            "narrator_zh": "加布里埃拉"
