{
    "dir": "chap14/daydra/dd_ch01_14_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "14152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "國政綾水とスクーター",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "国政绫水与小摩托"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "アーヤＭＶ回１",
            "zh": "绫水MV第1回",
            "narrator_zh": ""
        },
        {
            "location": "27/TALK",
            "narrator": "アーヤ",
            "text": "えーっと、\n確かこの辺の\nページに…。",
            "zh": "那个，\n记得就在这附近的\n页面上……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "アーヤ",
            "text": "あったわ。\nほら、外国製\nスクーターの特集よ。",
            "zh": "找到了。\n你看，外国产\n小摩托的特辑。",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "わぁ、カワイイ！",
            "zh": "哇，好可爱！",
            "narrator_zh": "燕"
        },
        {
            "location": "34/TALK",
            "narrator": "神楽",
            "text": "ふふ、つばめさんなら\n気に入ると思って\nました。",
            "zh": "呵呵，要是燕，\n我觉得\n会喜欢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "それにしても、\n外国のスクーターに\n興味あるなんて意外ね。",
            "zh": "话说回来，\n会对外国小摩托\n有兴趣，真意外。",
            "narrator_zh": "绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "神楽",
            "text": "前にテレビで見た\nことがあるんです\nけど――",
            "zh": "我以前在电视上\n看到过，\n不过——",
            "narrator_zh": "神乐"
        },
        {
            "location": "41/TALK",
            "narrator": "神楽",
            "text": "つばめさんが\n好きそうだったから、\n覚えていたんです。",
            "zh": "因为觉得\n燕会喜欢，\n所以记住了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "42/TALK",
            "narrator": "つばめ",
            "text": "こんなに可愛いなら、\nわたしも乗って\nみたいなぁ…。",
            "zh": "这么可爱的话，\n我也想\n坐坐看呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "44/TALK",
            "narrator": "神楽",
            "text": "私も可愛いスクーターに\n乗ったつばめさん、\n見てみたいです。",
            "zh": "我也想看看\n骑着可爱小摩托的\n燕。",
            "narrator_zh": "神乐"
        },
        {
            "location": "45/TALK",
            "narrator": "アーヤ",
            "text": "その時は、\n卯月も一緒に免許\n取ったら？",
            "zh": "那时候，\n卯月也一起去考\n驾照怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "48/TALK",
            "narrator": "神楽",
            "text": "私はつばめさんの\n後ろに乗りたいん\nです！",
            "zh": "我想坐在\n燕的\n后面！",
            "narrator_zh": "神乐"
        },
        {
            "location": "49/TALK",
            "narrator": "アーヤ",
            "text": "二人乗りは免許を\n取って一年以上\n経たないと無理よ。",
            "zh": "载人的话，驾照拿到\n没满一年\n是不行的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "アーヤ",
            "text": "それに、免許取れば\nつばめと一緒に――",
            "zh": "而且，拿到驾照的话，\n就能和燕一起——",
            "narrator_zh": "绫水"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "バイク旅行とかも\n出来るんじゃない？",
            "zh": "摩托旅行之类的，\n不也能去了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "神楽",
            "text": "えっ、バイク旅行？",
            "zh": "诶，摩托旅行？",
            "narrator_zh": "神乐"
        },
        {
            "location": "54/TALK",
            "narrator": "アーヤ",
            "text": "そうよ。",
            "zh": "是呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "55/TALK",
            "narrator": "アーヤ",
            "text": "観光地に行ったり、\n温泉に行ったり――",
            "zh": "去景点，\n或者去温泉——",
            "narrator_zh": "绫水"
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "行動範囲広がるん\nだから、行かないのは\n勿体ないわ。",
            "zh": "能去的地方变多了，\n不去的话\n太可惜了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "59/TALK",
            "narrator": "つばめ",
            "text": "わぁ、楽しそう！\nバイクで行く\n温泉旅行かぁ…。",
            "zh": "哇，好像很好玩！\n骑摩托去的\n温泉旅行呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "卯月さん、見て！\n朝日だよ！",
            "zh": "卯月，你看！\n是朝阳呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "81/TALK",
            "narrator": "神楽",
            "text": "綺麗ですね…。\n夜中に出発した甲斐が\nありました。",
            "zh": "好漂亮……。\n半夜出发，\n值得了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "82/TALK",
            "narrator": "つばめ",
            "text": "うん。\n綺麗だなぁ…。",
            "zh": "嗯。\n好漂亮呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "83/TALK",
            "narrator": "神楽",
            "text": "でも、山の上だから\nちょっと冷えますね。",
            "zh": "不过，在山上，\n有点冷呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "86/TALK",
            "narrator": "神楽",
            "text": "早く温泉に\n行きましょ。",
            "zh": "早点去\n温泉吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "うん、あっ！\nでもその前に――",
            "zh": "嗯，啊！\n不过在那之前——",
            "narrator_zh": "燕"
        },
        {
            "location": "89/TALK",
            "narrator": "つばめ",
            "text": "ここで記念写真撮ろ。\nほら、くっついて\nくっついて！",
            "zh": "在这里拍纪念照吧。\n来，靠紧一点\n靠紧一点！",
            "narrator_zh": "燕"
        },
        {
            "location": "113/TALK",
            "narrator": "つばめ",
            "text": "気持ちいいねー。\nわたし、もうここから\n出たくないよ…。",
            "zh": "好舒服呀。\n我已经不想\n从这里出去了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "神楽",
            "text": "何だか、凄く幸せな\n気持ちです…。\n来て正解でしたね。",
            "zh": "总觉得，非常幸福\n……。\n来对了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "115/TALK",
            "narrator": "つばめ",
            "text": "うん。他にお客さんも\nいないから、貸し切り\n状態だし…。",
            "zh": "嗯。其他客人也\n没有，等于包场\n了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "116/TALK",
            "narrator": "つばめ",
            "text": "…コッソリ、\n泳いじゃおうかな？",
            "zh": "……偷偷地，\n游一会儿好了？",
            "narrator_zh": "燕"
        },
        {
            "location": "119/TALK",
            "narrator": "神楽",
            "text": "もう、つばめさん\nってば…ちょっと\nだけですよ？",
            "zh": "真是的，燕\n……就一点点\n哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "133/TALK",
            "narrator": "つばめ",
            "text": "ふぁ～…。",
            "zh": "哈啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "134/TALK",
            "narrator": "つばめ",
            "text": "朝早かったから、\nもう眠いよぉ…。",
            "zh": "起得太早，\n已经困了呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "136/TALK",
            "narrator": "神楽",
            "text": "ちょっと早いけど、\n今日はもうお布団に\n入りましょう。",
            "zh": "虽然还早，\n今天就进被窝\n吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "139/TALK",
            "narrator": "つばめ",
            "text": "うん。それじゃあ、\n電気消すね。",
            "zh": "嗯。那么，\n我关灯了。",
            "narrator_zh": "燕"
        },
        {
            "location": "144/TALK",
            "narrator": "神楽",
            "text": "はい…。\nあっ、そういえば\nこの前――",
            "zh": "好……。\n啊，说起来\n之前——",
            "narrator_zh": "神乐"
        },
        {
            "location": "147/TALK",
            "narrator": "神楽",
            "text": "凄く面白いラノベを\n見つけたんです。",
            "zh": "我发现了一本\n非常有趣的轻小说。",
            "narrator_zh": "神乐"
        },
        {
            "location": "148/TALK",
            "narrator": "つばめ",
            "text": "わぁ、どんなお話か\n聞きたいな。",
            "zh": "哇，想听听\n是什么样的故事。",
            "narrator_zh": "燕"
        },
        {
            "location": "150/TALK",
            "narrator": "神楽",
            "text": "じゃあ、ネタバレに\nならない程度に…。\n物語は――",
            "zh": "那就，讲到不剧透\n的程度……。\n故事是——",
            "narrator_zh": "神乐"
        },
        {
            "location": "171/TALK",
            "narrator": "つばめ",
            "text": "…なんて、そんな\n旅行にしたいなぁ。",
            "zh": "……之类的，真想\n来一趟这样的旅行呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "172/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、早速プランを\n立て始めてるわね。",
            "zh": "呵呵，已经开始\n做计划了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "173/TALK",
            "narrator": "神楽",
            "text": "うーん…。",
            "zh": "嗯……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "176/TALK",
            "narrator": "つばめ",
            "text": "あ、あれ？\n卯月さんは温泉旅行\n行きたくなかった？",
            "zh": "啊，咦？\n卯月不想去\n温泉旅行吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "178/TALK",
            "narrator": "神楽",
            "text": "まさか！",
            "zh": "怎么会！",
            "narrator_zh": "神乐"
        },
        {
            "location": "179/TALK",
            "narrator": "神楽",
            "text": "つばめさんとなら、\nどこへでも喜んで\nお供しますよ！",
            "zh": "只要是和燕，\n去哪里我都乐意\n陪着！",
            "narrator_zh": "神乐"
        },
        {
            "location": "181/TALK",
            "narrator": "神楽",
            "text": "ただ…今の話だと、\nちょっと仲良し度が\n足りない気がします。",
            "zh": "只是……按现在这个说法，\n亲密度好像\n还差一点。",
            "narrator_zh": "神乐"
        },
        {
            "location": "182/TALK",
            "narrator": "つばめ",
            "text": "はい？",
            "zh": "什么？",
            "narrator_zh": "燕"
        },
        {
            "location": "184/TALK",
            "narrator": "アーヤ",
            "text": "仲良し度？",
            "zh": "亲密度？",
            "narrator_zh": "绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "神楽",
            "text": "つまりですね、\nもっとこう――",
            "zh": "就是说，\n还要再这样——",
            "narrator_zh": "神乐"
        },
        {
            "location": "207/TALK",
            "narrator": "つばめ",
            "text": "卯月さん、見て！\n朝日だよ！",
            "zh": "卯月，你看！\n是朝阳呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "210/TALK",
            "narrator": "神楽",
            "text": "朝日に照らされた\nつばめさん、とっても\n綺麗ですよ。",
            "zh": "被朝阳照着的\n燕，非常\n漂亮。",
            "narrator_zh": "神乐"
        },
        {
            "location": "213/TALK",
            "narrator": "つばめ",
            "text": "あはは、卯月さんは\n冗談が上手いん\nだから…。",
            "zh": "啊哈哈，卯月\n真会开玩笑\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "214/TALK",
            "narrator": "神楽",
            "text": "本気なのに…。",
            "zh": "我是认真的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "215/TALK",
            "narrator": "つばめ",
            "text": "ふふっ…それより、\n記念写真撮ろうよ。",
            "zh": "呵呵……比起那个，\n来拍纪念照吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "217/TALK",
            "narrator": "神楽",
            "text": "あ、はい。\nそれじゃ失礼して…。",
            "zh": "啊，好。\n那就失礼了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "226/TALK",
            "narrator": "つばめ",
            "text": "ちょ、卯月さん！？\nちょっと近過ぎる\nような…。",
            "zh": "等、卯月！？\n是不是靠得\n太近了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "227/TALK",
            "narrator": "神楽",
            "text": "ツーショットなんです\nから、離れて撮ったら\n寂しいですよ。",
            "zh": "这是双人合照，\n离远了拍\n会显得冷清。",
            "narrator_zh": "神乐"
        },
        {
            "location": "229/TALK",
            "narrator": "神楽",
            "text": "そうだ、ほっぺたも\nくっつけちゃい\nましょう。",
            "zh": "对了，脸蛋也\n贴在一起\n吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "232/TALK",
            "narrator": "つばめ",
            "text": "あ、うぅ…、\n恥ずかしいよぉ…。",
            "zh": "啊，唔……，\n好害羞呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "265/TALK",
            "narrator": "つばめ",
            "text": "気持ちいいねー。\nわたし、もうここから\n出たくないよ…。",
            "zh": "好舒服呀。\n我已经不想\n从这里出去了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "266/TALK",
            "narrator": "神楽",
            "text": "何だか、凄く幸せな\n気持ちです…。\n来て正解でしたね。",
            "zh": "总觉得，非常幸福\n……。\n来对了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "269/TALK",
            "narrator": "つばめ",
            "text": "うん。他にお客さんも\nいないから、貸し切り\n状態だし…。",
            "zh": "嗯。其他客人也\n没有，等于包场\n了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "270/TALK",
            "narrator": "つばめ",
            "text": "…コッソリ、\n泳いじゃおうかな？",
            "zh": "……偷偷地，\n游一会儿好了？",
            "narrator_zh": "燕"
        },
        {
            "location": "272/TALK",
            "narrator": "神楽",
            "text": "それより、もっと\nしなくちゃいけない\nことがあります。",
            "zh": "比起那个，还有\n更必须做的\n事。",
            "narrator_zh": "神乐"
        },
        {
            "location": "273/TALK",
            "narrator": "神楽",
            "text": "つばめさん。\n前に銭湯に行った時\nから――",
            "zh": "燕。\n从上次去澡堂\n那时起——",
            "narrator_zh": "神乐"
        },
        {
            "location": "274/TALK",
            "narrator": "神楽",
            "text": "ちょっと成長したん\nじゃないですか？",
            "zh": "是不是长大了\n一点？",
            "narrator_zh": "神乐"
        },
        {
            "location": "275/TALK",
            "narrator": "つばめ",
            "text": "えっ？\nせ、成長って…。",
            "zh": "诶？\n长、长大是指……。",
            "narrator_zh": "燕"
        },
        {
            "location": "281/TALK",
            "narrator": "神楽",
            "text": "確認しまーす。\nえっと、まずは…。",
            "zh": "我来确认一下。\n那个，首先……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "282/TALK",
            "narrator": "つばめ",
            "text": "ちょ、あっ！\nく、くすぐったいよ、\n卯月さん…。",
            "zh": "等、啊！\n好、好痒呀，\n卯月……。",
            "narrator_zh": "燕"
        },
        {
            "location": "295/TALK",
            "narrator": "つばめ",
            "text": "ふぁ～…。",
            "zh": "哈啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "296/TALK",
            "narrator": "つばめ",
            "text": "朝早かったから、\nもう眠いよぉ…。",
            "zh": "起得太早，\n已经困了呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "298/TALK",
            "narrator": "神楽",
            "text": "ちょっと早いけど、\n今日はもうお布団に\n入りましょう。",
            "zh": "虽然还早，\n今天就进被窝\n吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "301/TALK",
            "narrator": "つばめ",
            "text": "うん。それじゃあ、\n電気消して――",
            "zh": "嗯。那么，\n关灯——",
            "narrator_zh": "燕"
        },
        {
            "location": "304/TALK",
            "narrator": "つばめ",
            "text": "あ、あれ？\n布団、一つしか\n敷いてないよ？",
            "zh": "啊，咦？\n被子只铺了\n一床呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "306/TALK",
            "narrator": "神楽",
            "text": "あー、もしかしたら\n私が予約した時に――",
            "zh": "啊，也许是\n我订房间的时候——",
            "narrator_zh": "神乐"
        },
        {
            "location": "308/TALK",
            "narrator": "神楽",
            "text": "カップルプランで\n部屋を取ったからかも\nしれませんねー。",
            "zh": "也许是用情侣套餐\n订的房间\n吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "311/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nき、聞いてないよ！",
            "zh": "诶诶！？\n我、我没听说呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "312/TALK",
            "narrator": "神楽",
            "text": "部屋が取れたなら、\nプランは関係ないかな\nって思ったので。",
            "zh": "房间能订到的话，\n套餐是什么\n我就觉得无所谓了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "314/TALK",
            "narrator": "神楽",
            "text": "それより、\n早くお布団に\n入りましょう。",
            "zh": "比起那个，\n快点进被窝\n吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "315/TALK",
            "narrator": "神楽",
            "text": "温泉で火照った身体が\n冷めないうちに…、\nふふっ…。",
            "zh": "趁泡完温泉的身子\n还没凉……，\n呵呵……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "333/TALK",
            "narrator": "神楽",
            "text": "…ふふっ。",
            "zh": "……呵呵。",
            "narrator_zh": "神乐"
        },
        {
            "location": "335/TALK",
            "narrator": "アーヤ",
            "text": "いや、それ友達と\n旅行してる感じに\n聞こえないんだけど？",
            "zh": "不对，这听起来\n不像是和朋友\n一起旅行吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "337/TALK",
            "narrator": "神楽",
            "text": "大親友との旅行なら、\nこれくらい当然の\nことですよ。",
            "zh": "要是挚友一起旅行，\n这种程度是\n理所当然的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "339/TALK",
            "narrator": "神楽",
            "text": "つばめさんも\nそう思いますよね？",
            "zh": "燕也\n这么觉得吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "340/SEL",
            "narrator": "",
            "text": "神楽以外も誘おうよ",
            "zh": "也邀请神乐以外的人吧",
            "narrator_zh": ""
        },
        {
            "location": "341/SEL",
            "narrator": "",
            "text": "$me$も忘れないでね",
            "zh": "也别忘了$me$哦",
            "narrator_zh": ""
        },
        {
            "location": "344/TALK",
            "narrator": "つばめ",
            "text": "うーん、楽しそう\nだけど、お風呂のは\n恥ずかしいかも…。",
            "zh": "嗯，听着很好玩，\n不过洗澡那段\n也许会害羞……。",
            "narrator_zh": "燕"
        },
        {
            "location": "346/TALK",
            "narrator": "神楽",
            "text": "女の子同士なら\n普通にすることです。",
            "zh": "女孩子之间，\n这是很普通的事。",
            "narrator_zh": "神乐"
        },
        {
            "location": "348/TALK",
            "narrator": "アーヤ",
            "text": "当たり前のように\nウソつかないの。",
            "zh": "别一脸理所当然地\n说谎。",
            "narrator_zh": "绫水"
        },
        {
            "location": "350/TALK",
            "narrator": "アーヤ",
            "text": "まあ、とりあえずは\n免許を取れる年齢に\nなるのが先よね。",
            "zh": "总之，先等到\n能考驾照的年龄\n吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "351/TALK",
            "narrator": "アーヤ",
            "text": "それに…つばめは\nお父さんからの\n許可も必要じゃない？",
            "zh": "而且……燕\n也得得到爸爸的\n许可吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "353/TALK",
            "narrator": "つばめ",
            "text": "は、はい…免許取る\nよりも、そっちの方が\n何倍も難関かも…。",
            "zh": "是、是……比起考驾照，\n那一边也许难上\n好几倍……。",
            "narrator_zh": "燕"
        },
        {
            "location": "354/TALK",
            "narrator": "神楽",
            "text": "そ、その時が来たら、\n絶対に説得して\nくださいね。",
            "zh": "那、那时候到了，\n请一定\n说服他。",
            "narrator_zh": "神乐"
        },
        {
            "location": "357/TALK",
            "narrator": "つばめ",
            "text": "…成人するまでダメ、\nって言われそうな\n気がするよぉ…。",
            "zh": "……感觉会被说，\n成年之前都不行，\n呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "359/ACT",
            "narrator": "",
            "text": "神楽以外も誘おうよ",
            "zh": "也邀请神乐以外的人吧",
            "narrator_zh": ""
        },
        {
            "location": "378/TALK",
            "narrator": "つばめ",
            "text": "そぅだね(*´︶`*)",
            "zh": "是呀(*´︶`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "379/TALK",
            "narrator": "つばめ",
            "text": "旅行は",
            "zh": "旅行的话",
            "narrator_zh": "燕"
        },
        {
            "location": "380/TALK",
            "narrator": "つばめ",
            "text": "大勢で行った方が",
            "zh": "人多一起去",
            "narrator_zh": "燕"
        },
        {
            "location": "381/TALK",
            "narrator": "つばめ",
            "text": "楽しそぅだしヽ(*´∀｀*)ﾉ",
            "zh": "好像更开心ヽ(*´∀｀*)ﾉ",
            "narrator_zh": "燕"
        },
        {
            "location": "382/TALK",
            "narrator": "つばめ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "燕"
        },
        {
            "location": "383/TALK",
            "narrator": "つばめ",
            "text": "ァーヤさんには",
            "zh": "绫水的话",
            "narrator_zh": "燕"
        },
        {
            "location": "384/TALK",
            "narrator": "つばめ",
            "text": "一緒に来てほしぃかも(≧艸≦*)",
            "zh": "也想请她一起来(≧艸≦*)",
            "narrator_zh": "燕"
        },
        {
            "location": "399/TALK",
            "narrator": "つばめ",
            "text": "ねえ、卯月さん。\nバイク旅行に\n行く時は――",
            "zh": "我说，卯月。\n去摩托旅行的\n时候——",
            "narrator_zh": "燕"
        },
        {
            "location": "400/TALK",
            "narrator": "つばめ",
            "text": "みんなも一緒の方が\n楽しいんじゃない\nかな？",
            "zh": "大家一起去，\n不是更开心\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "402/TALK",
            "narrator": "神楽",
            "text": "それはまあ、\n楽しいとは思います\nけど…。",
            "zh": "这个嘛，\n我觉得是会开心，\n不过……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "403/TALK",
            "narrator": "つばめ",
            "text": "それに、バイク旅行に\n慣れてるアーヤさんが\n一緒だと――",
            "zh": "而且，要是习惯\n摩托旅行的绫水\n也一起的话——",
            "narrator_zh": "燕"
        },
        {
            "location": "404/TALK",
            "narrator": "つばめ",
            "text": "ちょっと心強い気も\nするし。",
            "zh": "也会觉得\n安心一点。",
            "narrator_zh": "燕"
        },
        {
            "location": "406/TALK",
            "narrator": "アーヤ",
            "text": "…そういえば、\n誰かとバイク旅行\nしたことって――",
            "zh": "……说起来，\n和别人一起摩托旅行，\n这件事——",
            "narrator_zh": "绫水"
        },
        {
            "location": "407/TALK",
            "narrator": "アーヤ",
            "text": "まだ一度も\nなかったわ。",
            "zh": "还一次都\n没有过。",
            "narrator_zh": "绫水"
        },
        {
            "location": "409/TALK",
            "narrator": "つばめ",
            "text": "そうだったんですか？",
            "zh": "是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "411/TALK",
            "narrator": "アーヤ",
            "text": "ええ。",
            "zh": "嗯。",
            "narrator_zh": "绫水"
        },
        {
            "location": "413/TALK",
            "narrator": "アーヤ",
            "text": "まあ、二人きりで\n行かせるのは\n少し心配だし――",
            "zh": "让她们两个人去，\n我也有点\n不放心——",
            "narrator_zh": "绫水"
        },
        {
            "location": "414/TALK",
            "narrator": "アーヤ",
            "text": "それに、一人じゃない\nバイク旅行ってのも\n楽しそうかも。",
            "zh": "而且，不是一个人的\n摩托旅行，\n好像也不错。",
            "narrator_zh": "绫水"
        },
        {
            "location": "417/TALK",
            "narrator": "つばめ",
            "text": "よかった…。\nこれで安心だね。",
            "zh": "太好了……。\n这样就放心了呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "419/TALK",
            "narrator": "神楽",
            "text": "まあ、ラブラブ二人旅\nじゃなくなっちゃう\nのが――",
            "zh": "不过，就不再是\n甜蜜双人旅行\n了——",
            "narrator_zh": "神乐"
        },
        {
            "location": "421/TALK",
            "narrator": "神楽",
            "text": "ちょこっとだけ\n残念ですけど…。",
            "zh": "有一点点\n遗憾……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "423/TALK",
            "narrator": "アーヤ",
            "text": "…それも、二人きりに\nするのが心配な理由の\n一つなんだけどね。",
            "zh": "……这也是我不放心\n让你们两个人去的\n理由之一。",
            "narrator_zh": "绫水"
        },
        {
            "location": "424/ACT",
            "narrator": "",
            "text": "$me$も忘れないでね",
            "zh": "也别忘了$me$哦",
            "narrator_zh": ""
        },
        {
            "location": "443/TALK",
            "narrator": "つばめ",
            "text": "もちろんo(*･ﾛ･*)o、",
            "zh": "当然o(*･ﾛ･*)o、",
            "narrator_zh": "燕"
        },
        {
            "location": "444/TALK",
            "narrator": "つばめ",
            "text": "ぁ",
            "zh": "啊",
            "narrator_zh": "燕"
        },
        {
            "location": "445/TALK",
            "narrator": "つばめ",
            "text": "でもそぅなると",
            "zh": "不过那样的话",
            "narrator_zh": "燕"
        },
        {
            "location": "446/TALK",
            "narrator": "つばめ",
            "text": "二人旅行じゃなぃんだよね(´･ω･｀) ",
            "zh": "就不是双人旅行了呀(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "447/TALK",
            "narrator": "つばめ",
            "text": "ごめんなさぃ",
            "zh": "对不起",
            "narrator_zh": "燕"
        },
        {
            "location": "460/TALK",
            "narrator": "つばめ",
            "text": "うっかりしてたけど、\n二人旅行じゃ\nなくて――",
            "zh": "我疏忽了，\n不是双人旅行，\n而是——",
            "narrator_zh": "燕"
        },
        {
            "location": "462/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんも\n入るから、\n三人旅行だよね。",
            "zh": "$handle$也\n要去，\n就是三人旅行了呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "464/TALK",
            "narrator": "神楽",
            "text": "…ああ、そういえば。\nすっかり忘れていま\nした…。",
            "zh": "……啊，说起来。\n我完全\n给忘了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "466/TALK",
            "narrator": "アーヤ",
            "text": "まあ、$handle$が\nいれば二人に何か\nあっても――",
            "zh": "有$handle$在的话，\n两个人出了什么事，\n也会——",
            "narrator_zh": "绫水"
        },
        {
            "location": "467/TALK",
            "narrator": "アーヤ",
            "text": "こっちに連絡して\nくれるから、\n安心よね。",
            "zh": "会联系我们，\n所以\n放心。",
            "narrator_zh": "绫水"
        },
        {
            "location": "469/TALK",
            "narrator": "つばめ",
            "text": "はい。",
            "zh": "是。",
            "narrator_zh": "燕"
        },
        {
            "location": "471/TALK",
            "narrator": "神楽",
            "text": "…バイク旅行に\n行く時は――",
            "zh": "……去摩托旅行的\n时候——",
            "narrator_zh": "神乐"
        },
        {
            "location": "472/TALK",
            "narrator": "神楽",
            "text": "できるだけ、スマホは\n鞄から出さないように\nしましょうね。",
            "zh": "尽量不要把手机\n从包里拿出来\n哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "16/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月26日　1:34 PM</color>\nとある休日、神楽坂トライナリーでのバイトの最中のこと。",
            "zh": "<color=green>6月26日　1:34 PM</color>\n某个假日，在神乐坂三重奏打工的时候。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
