{
    "dir": "chap02/battle/btev_ch00_02_00.js",
    "type": "",
    "info": {
        "story_id": "22000",
        "cid": "",
        "title": "000 ココロスフィア解説",
        "sub_title": "ココロの深淵へようこそ",
        "title_zh": "000 心灵领域解说",
        "sub_title_zh": "欢迎来到心灵深渊"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "ココロスフィア導入アーヤ",
            "zh": "心灵领域导入 绫水",
            "narrator_zh": ""
        },
        {
            "location": "13/DIALOG",
            "narrator": "",
            "text": "<size=40>DOOR-No. 000</size>\nCHIHARU\n\n<size=40>Kokoro.Initialize();</size>\n<size=25>～深層ココロスフィアの概念について～</size>",
            "zh": "<size=40>DOOR-No. 000</size>\n千羽鹤\n\n<size=40>Kokoro.Initialize();</size>\n<size=25>～关于深层心灵领域的概念～</size>",
            "narrator_zh": ""
        },
        {
            "location": "22/TALK",
            "narrator": "千羽鶴",
            "text": "ようこそ、\n國政綾水の\n深層世界へ。",
            "zh": "欢迎来到\n国政绫水的\n深层世界。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "24/TALK",
            "narrator": "千羽鶴",
            "text": "前にもしてるけど、\n深層世界についての説明、\nもう一度聞く？",
            "zh": "之前也讲过了，\n关于深层世界的说明，\n还要再听一遍吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "25/SEL",
            "narrator": "（選択肢）",
            "text": "はい",
            "zh": "要",
            "narrator_zh": "（选项）"
        },
        {
            "location": "26/SEL",
            "narrator": "（選択肢）",
            "text": "いいえ",
            "zh": "不用",
            "narrator_zh": "（选项）"
        },
        {
            "location": "27/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "要",
            "narrator_zh": ""
        },
        {
            "location": "28/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。\nそれじゃもう一度、\n深層世界の話をする。",
            "zh": "知道了。\n那我就再讲一次\n深层世界的事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "30/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不用",
            "narrator_zh": ""
        },
        {
            "location": "31/TALK",
            "narrator": "千羽鶴",
            "text": "そう、助かる。",
            "zh": "是吗，省事了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "47/TALK",
            "narrator": "千羽鶴",
            "text": "さて。",
            "zh": "好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "48/TALK",
            "narrator": "千羽鶴",
            "text": "改めて、\nここは國政綾水の\n深層世界。",
            "zh": "重新介绍一下，\n这里是国政绫水的\n深层世界。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "49/TALK",
            "narrator": "千羽鶴",
            "text": "少しでも彼女を見ていれば\n分かると思うけど、彼女に\n悩みはとても多い。",
            "zh": "只要稍微观察过她\n就能明白吧，她的\n烦恼非常多。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "50/TALK",
            "narrator": "千羽鶴",
            "text": "どうしてか分かる？",
            "zh": "知道是为什么吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "51/SEL",
            "narrator": "（選択肢）",
            "text": "リーダーだから",
            "zh": "因为她是队长",
            "narrator_zh": "（选项）"
        },
        {
            "location": "52/SEL",
            "narrator": "（選択肢）",
            "text": "えいかっこしいだから",
            "zh": "因为她太爱逞强",
            "narrator_zh": "（选项）"
        },
        {
            "location": "53/SEL",
            "narrator": "（選択肢）",
            "text": "身長も年齢もみやびより上なのに胸はみやびの方が大きいから",
            "zh": "因为她身高和年纪都比雅大，胸却还是雅比较大",
            "narrator_zh": "（选项）"
        },
        {
            "location": "54/ACT",
            "narrator": "",
            "text": "リーダーだから",
            "zh": "因为她是队长",
            "narrator_zh": ""
        },
        {
            "location": "55/TALK",
            "narrator": "千羽鶴",
            "text": "確かにそれはある。",
            "zh": "确实有这方面原因。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "56/TALK",
            "narrator": "千羽鶴",
            "text": "でもそれは、どちらか\nといえば、深層心理からは\n少し遠いところにある。",
            "zh": "不过那方面的原因，\n真要说起来，离她的\n深层心理还有点距离。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "57/ACT",
            "narrator": "",
            "text": "えいかっこしいだから",
            "zh": "因为她太爱逞强",
            "narrator_zh": ""
        },
        {
            "location": "58/TALK",
            "narrator": "千羽鶴",
            "text": "なかなか鋭い。\n貴方はとても有能。",
            "zh": "相当敏锐。\n你很有能耐。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "59/TALK",
            "narrator": "千羽鶴",
            "text": "いいこいいこ。",
            "zh": "乖，真乖。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "60/ACT",
            "narrator": "",
            "text": "身長も年齢もみやびより上なのに胸はみやびの方が大きいから",
            "zh": "因为她身高和年纪都比雅大，胸却还是雅比较大",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "千羽鶴",
            "text": "そう、それ！\nそれこそが彼女の悩み――",
            "zh": "没错，就是那个！\n那正是她的烦恼——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "64/TALK",
            "narrator": "千羽鶴",
            "text": "<color=red><size=30>なわけないから！</size></color>",
            "zh": "<color=red><size=30>怎么可能是那个！</size></color>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "65/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "66/TALK",
            "narrator": "千羽鶴",
            "text": "ん？　いや、\nそれもあったような……",
            "zh": "嗯？　不对，\n好像也有过这事……",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "67/TALK",
            "narrator": "千羽鶴",
            "text": "まあいいか。",
            "zh": "算了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "68/TALK",
            "narrator": "千羽鶴",
            "text": "無いから。\nもっと真面目にやって。",
            "zh": "没有这回事。\n给我再认真点。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "69/TALK",
            "narrator": "千羽鶴",
            "text": "人の心の奥底へ触れる\n人として、ちょっとふざけ\nすぎ。真面目にやって。",
            "zh": "作为一个要去触碰\n别人心底的人，你也太\n胡闹了。认真点。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "71/TALK",
            "narrator": "千羽鶴",
            "text": "正解は、彼女の今までの\n環境が生み出した、\n自身のスタンスにある。",
            "zh": "正解在于她迄今为止的\n成长环境所造就的\n自身行事姿态。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "72/TALK",
            "narrator": "千羽鶴",
            "text": "それは、人に絶対弱い\nところを見せたくない、\n見せられないという想い。",
            "zh": "那就是，绝不想对别人\n展示软弱的一面，\n也绝不能展示的想法。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "73/TALK",
            "narrator": "千羽鶴",
            "text": "乱暴に言えば、\n人一倍、えいかっこしいで\n完璧主義なところ。",
            "zh": "粗暴点说，\n就是比常人更爱逞强、\n还是个完美主义者。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "74/TALK",
            "narrator": "千羽鶴",
            "text": "もちろんそれは、彼女を\n良い結果に導くことも\n多々ある。",
            "zh": "当然，那一点\n也时常能把她\n引向好的结果。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "75/TALK",
            "narrator": "千羽鶴",
            "text": "ただ、\n当然デメリットもある。",
            "zh": "只不过，\n当然也会有弊端。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "76/TALK",
            "narrator": "千羽鶴",
            "text": "そんな風に、安定して\nいそうに見える彼女は、\n実はわりと不安定なの。",
            "zh": "像那样看起来\n四平八稳的她，\n其实相当不稳定。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "77/TALK",
            "narrator": "千羽鶴",
            "text": "とても支え甲斐が\nあると思わない？",
            "zh": "你不觉得非常\n值得去支撑她吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "78/SEL",
            "narrator": "（選択肢）",
            "text": "はい",
            "zh": "觉得",
            "narrator_zh": "（选项）"
        },
        {
            "location": "79/SEL",
            "narrator": "（選択肢）",
            "text": "いいえ",
            "zh": "不觉得",
            "narrator_zh": "（选项）"
        },
        {
            "location": "80/SEL",
            "narrator": "（選択肢）",
            "text": "千羽鶴の方が興味ある",
            "zh": "我对千羽鹤更感兴趣",
            "narrator_zh": "（选项）"
        },
        {
            "location": "81/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "觉得",
            "narrator_zh": ""
        },
        {
            "location": "82/TALK",
            "narrator": "千羽鶴",
            "text": "まあでも。",
            "zh": "不过嘛。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "83/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不觉得",
            "narrator_zh": ""
        },
        {
            "location": "84/TALK",
            "narrator": "千羽鶴",
            "text": "そう。まあ確かに、\n実際に見てみたら、支え\n甲斐は無いかもしれない。",
            "zh": "这样。确实，\n真要看的话，说不定\n也没什么值得支撑的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "85/TALK",
            "narrator": "千羽鶴",
            "text": "それに。",
            "zh": "而且。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "86/ACT",
            "narrator": "",
            "text": "千羽鶴の方が興味ある",
            "zh": "我对千羽鹤更感兴趣",
            "narrator_zh": ""
        },
        {
            "location": "89/TALK",
            "narrator": "千羽鶴",
            "text": "もうここでは\n何も出ませんよ。",
            "zh": "这里已经\n什么都不会出来了哦。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "90/TALK",
            "narrator": "千羽鶴",
            "text": "そんなことより、\n國政綾水のココロを\n癒してあげて。",
            "zh": "比起这个，\n快去治愈国政绫水的\n心吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "95/TALK",
            "narrator": "千羽鶴",
            "text": "……ほんとに。",
            "zh": "……真是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "96/TALK",
            "narrator": "千羽鶴",
            "text": "ホントにしつこい人。",
            "zh": "真是够纠缠不休的人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "97/TALK",
            "narrator": "千羽鶴",
            "text": "そんなに私の\n心の中を見たい？",
            "zh": "就这么想看\n我的心里吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "98/SEL",
            "narrator": "（選択肢）",
            "text": "はい",
            "zh": "想",
            "narrator_zh": "（选项）"
        },
        {
            "location": "99/SEL",
            "narrator": "（選択肢）",
            "text": "いいえ",
            "zh": "不想",
            "narrator_zh": "（选项）"
        },
        {
            "location": "100/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "想",
            "narrator_zh": ""
        },
        {
            "location": "101/TALK",
            "narrator": "千羽鶴",
            "text": "おぞましすぎて、\n現実に帰って来れなく\nなるかもしれないけど。",
            "zh": "可能会骇人到\n让你再也回不到\n现实里去哦。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "102/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "103/TALK",
            "narrator": "千羽鶴",
            "text": "まあ、それでもと言うなら\nいずれ何か見せられる日が\n来るかもしれない。",
            "zh": "不过，既然你非要这么说，\n日后说不定会有能给你\n看点什么的一天吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "104/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不想",
            "narrator_zh": ""
        },
        {
            "location": "105/TALK",
            "narrator": "千羽鶴",
            "text": "それが正しい判断。\n私の中を覗いても、\nろくなことがないから。",
            "zh": "这才是明智判断。\n偷窥我的内心，\n也不会有什么好事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "107/TALK",
            "narrator": "千羽鶴",
            "text": "とにかく。\n貴方の実直すぎるアホに\n免じて、ご褒美あげる。",
            "zh": "总之。\n看在你这过于耿直的傻劲\n分上，给你点奖励。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "117/TALK",
            "narrator": "千羽鶴",
            "text": "何にしても今は、\n國政綾水のココロを\n癒してあげて。",
            "zh": "不管怎样，现在\n先去治愈国政绫水的\n心吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "121/TALK",
            "narrator": "千羽鶴",
            "text": "しつこいです。\nさっさと國政綾水の\nココロを癒してあげて。",
            "zh": "太纠缠了。\n快点去治愈国政绫水的\n心吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "125/TALK",
            "narrator": "千羽鶴",
            "text": "だから、私は\nチュートリアルキャラ。\nココロなんて存在しない。",
            "zh": "我都说了，我是\n教程角色。\n根本不存在什么心。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "126/TALK",
            "narrator": "千羽鶴",
            "text": "さっさと國政綾水の\nココロを癒してあげて。",
            "zh": "快点去治愈国政绫水的\n心吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "130/TALK",
            "narrator": "千羽鶴",
            "text": "残念だけど、私は単なる\nチュートリアルキャラ。\nココロなんて存在しない。",
            "zh": "遗憾的是，我只是个\n教程角色。\n根本不存在什么心。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "131/TALK",
            "narrator": "千羽鶴",
            "text": "今は國政綾水の\nココロを癒すことに\n集中して。",
            "zh": "现在请专注于\n治愈国政绫水的\n心。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "136/TALK",
            "narrator": "千羽鶴",
            "text": "話を戻すけど。\n彼女の心の中は、決して\n安穏とはしていない。",
            "zh": "言归正传。\n她的内心之中，绝非\n安稳平静。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "138/TALK",
            "narrator": "千羽鶴",
            "text": "関わってみると、\n割とむかつくことも\nあるかもしれないし。",
            "zh": "真去跟她打交道，\n说不定还会遇到挺让人\n火大的事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "139/TALK",
            "narrator": "千羽鶴",
            "text": "けど、彼女にとっては、\nそれさえも、魂がすり減る\nくらい考えた結果なの。",
            "zh": "但对她来说，\n就连那些，也是她磨耗着\n灵魂思考出来的结果。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "140/TALK",
            "narrator": "千羽鶴",
            "text": "だから是非、\n真摯に向かい合って\n支えてあげてほしい。",
            "zh": "所以无论如何，\n希望你能认真面对她，\n去支撑她。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "141/TALK",
            "narrator": "千羽鶴",
            "text": "貴方と國政綾水に、\n素晴らしきココロの旅を。",
            "zh": "祝你与国政绫水，\n有一场美妙的心灵之旅。",
            "narrator_zh": "千羽鹤"
        }
    ]
}
