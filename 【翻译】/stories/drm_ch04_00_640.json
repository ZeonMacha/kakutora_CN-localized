    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "OSが違うのだ",
            "zh": "OS不一样咧",
            "narrator_zh": ""
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "互換性がないのだ",
            "zh": "是没有兼容性的",
            "narrator_zh": "雅"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "互換性が",
            "zh": "兼容性啊",
            "narrator_zh": "雅"
        },
        {
            "location": "35/SEL",
            "narrator": "",
            "text": "マルチブートさせれば？",
            "zh": "做个多重启动不就好了？",
            "narrator_zh": ""
        },
        {
            "location": "36/SEL",
            "narrator": "",
            "text": "何の話？",
            "zh": "在说什么？",
            "narrator_zh": ""
        },
        {
            "location": "37/SEL",
            "narrator": "",
            "text": "デジュリスタンダードかデファクトスタンダードか",
            "zh": "是法定标准还是事实标准之争",
            "narrator_zh": ""
        },
        {
            "location": "38/ACT",
            "narrator": "",
            "text": "マルチブートさせれば？",
            "zh": "做个多重启动不就好了？",
            "narrator_zh": ""
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "ＯＳならば",
            "zh": "要是OS的话",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "みやび",
            "text": "そうするところだ",
            "zh": "就该那么干了",
            "narrator_zh": "雅"
        },
        {
            "location": "41/ACT",
            "narrator": "",
            "text": "何の話？",
            "zh": "在说什么？",
            "narrator_zh": ""
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "例え話",
            "zh": "打个比方",
            "narrator_zh": "雅"
        },
        {
            "location": "43/ACT",
            "narrator": "",
            "text": "デジュリスタンダードかデファクトスタンダードか",
            "zh": "是法定标准还是事实标准之争",
            "narrator_zh": ""
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "どちらでもないが",
            "zh": "哪个都不是，不过",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "あえて言うならデファクトだな",
            "zh": "硬要说的话，算事实标准啊",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "同じ言語を操っているはずなのに",
            "zh": "明明说的是同一种语言",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "みやび",
            "text": "どうにも話がかみ合わないことがあろう",
            "zh": "总会有话说不到一块儿的时候嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "そういう時に思うのだ",
            "zh": "那种时候会这么想",
            "narrator_zh": "雅"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "目の前の人物とは",
            "zh": "跟眼前这人之间",
            "narrator_zh": "雅"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "違うＯＳが搭載されているのではないかと",
            "zh": "装的是不同的OS吧",
            "narrator_zh": "雅"
        },
        {
            "location": "53/SEL",
            "narrator": "",
            "text": "そういう話か",
            "zh": "是那种事啊",
            "narrator_zh": ""
        },
        {
            "location": "54/SEL",
            "narrator": "",
            "text": "ふうん？",
            "zh": "哦？",
            "narrator_zh": ""
        },
        {
            "location": "55/SEL",
            "narrator": "",
            "text": "互換性確保したいよね",
            "zh": "真希望保证兼容性啊",
            "narrator_zh": ""
        },
        {
            "location": "56/ACT",
            "narrator": "",
            "text": "そういう話か",
            "zh": "是那种事啊",
            "narrator_zh": ""
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "そう",
            "zh": "对",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "現実とはなかなか厄介ぞね",
            "zh": "现实这东西真是难缠咧",
            "narrator_zh": "雅"
        },
        {
            "location": "60/ACT",
            "narrator": "",
            "text": "ふうん？",
            "zh": "哦？",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "おや",
            "zh": "哦呀",
            "narrator_zh": "雅"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "ピンとこんとは",
            "zh": "居然没反应过来",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "逆に羨ましいぞ",
            "zh": "反倒让人羡慕咧",
            "narrator_zh": "雅"
        },
        {
            "location": "65/ACT",
            "narrator": "",
            "text": "互換性確保したいよね",
            "zh": "真希望保证兼容性啊",
            "narrator_zh": ""
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "そう",
            "zh": "对",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "その気持ちはあるのだ",
            "zh": "那份心情也是有的",
            "narrator_zh": "雅"
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "だからせめてＯＳの種類を特定できればと",
            "zh": "所以我想，至少能确定OS的种类",
            "narrator_zh": "雅"
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "思うことが多々ある",
            "zh": "这种念头多得很",
            "narrator_zh": "雅"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "どこを確認すれば",
            "zh": "该确认哪里",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "互換性が確保できるのかと探ってみたり",
            "zh": "能不能保证兼容性，也试着摸索过",
            "narrator_zh": "雅"
        },
        {
            "location": "83/SEL",
            "narrator": "",
            "text": "人付き合いって難しいよね",
            "zh": "人际交往真难啊",
            "narrator_zh": ""
        },
        {
            "location": "84/SEL",
            "narrator": "",
            "text": "お互い歩み寄れるといいね",
            "zh": "但愿我们能彼此靠近一步",
            "narrator_zh": ""
        },
        {
            "location": "85/SEL",
            "narrator": "",
            "text": "ほっといてもいいんじゃない",
            "zh": "放着不管不就好了",
            "narrator_zh": ""
        },
        {
            "location": "86/ACT",
            "narrator": "",
            "text": "人付き合いって難しいよね",
            "zh": "人际交往真难啊",
            "narrator_zh": ""
        },
        {
