            "narrator_zh": "雅"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "気の持ちようが違うのかもということか",
            "zh": "心态就会不一样——是这么回事啊",
            "narrator_zh": "雅"
        },
        {
            "location": "108/SEL",
            "narrator": "",
            "text": "そういうこと",
            "zh": "原来是这样",
            "narrator_zh": ""
        },
        {
            "location": "109/SEL",
            "narrator": "",
            "text": "もっと気楽になってってこと",
            "zh": "就是想让你更放松点",
