            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "無理をしとるつもりはなかったが",
            "zh": "倒也没打算勉强",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "最悪の状況を考えておけば",
