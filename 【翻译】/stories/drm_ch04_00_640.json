        },
        {
            "location": "110/ACT",
            "narrator": "",
            "text": "そういうこと",
            "zh": "原来是这样",
            "narrator_zh": ""
        },
        {
            "location": "111/TALK",
            "narrator": "みやび",
            "text": "それも手ぞね",
            "zh": "那也是办法咧",
            "narrator_zh": "雅"
        },
        {
            "location": "112/ACT",
            "narrator": "",
            "text": "もっと気楽になってってこと",
