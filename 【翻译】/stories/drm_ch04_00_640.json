        {
            "location": "95/TALK",
            "narrator": "みやび",
            "text": "ありか",
            "zh": "算数啊",
            "narrator_zh": "雅"
        },
        {
            "location": "98/SEL",
            "narrator": "",
            "text": "最初から話が合わないって思うのも手だよ",
            "zh": "一开始就认定聊不来也算个办法哦",
            "narrator_zh": ""
        },
        {
            "location": "99/SEL",
            "narrator": "",
            "text": "無理する必要もないんじゃない",
            "zh": "也没必要勉强吧",
            "narrator_zh": ""
        },
        {
            "location": "100/ACT",
            "narrator": "",
            "text": "最初から話が合わないって思うのも手だよ",
            "zh": "一开始就认定聊不来也算个办法哦",
            "narrator_zh": ""
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "逆転の発想というやつか",
            "zh": "这就是所谓的逆向思维咩",
