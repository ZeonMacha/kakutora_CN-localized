            "narrator": "みやび",
            "text": "ほんに",
            "zh": "可不是嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "88/ACT",
            "narrator": "",
            "text": "お互い歩み寄れるといいね",
            "zh": "但愿我们能彼此靠近一步",
