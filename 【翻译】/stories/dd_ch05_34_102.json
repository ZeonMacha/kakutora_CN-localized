        {
            "location": "634/ACT",
            "narrator": "",
            "text": "こんなことして楽しい？",
            "zh": "做这种事很好玩吗？",
            "narrator_zh": ""
        },
        {
            "location": "635/TALK",
            "narrator": "プレイヤー",
            "text": "楽しくてやってるわけじゃない",
            "zh": "我也不是觉得好玩才做的",
            "narrator_zh": "玩家"
        },
        {
            "location": "636/SEL",
            "narrator": "",
            "text": "じゃあどうして？",
            "zh": "那又是为什么？",
            "narrator_zh": ""
        },
        {
            "location": "637/ACT",
            "narrator": "",
            "text": "じゃあどうして？",
            "zh": "那又是为什么？",
            "narrator_zh": ""
        },
        {
            "location": "639/TALK",
            "narrator": "プレイヤー",
            "text": "リプレイス前の進行に流れを戻したいだけ",
            "zh": "只是想把流程拉回到替换之前的进度而已",
            "narrator_zh": "玩家"
        },
        {
            "location": "640/ACT",
            "narrator": "",
            "text": "つばめがこんな目にあってるのに平気なの？",
            "zh": "燕遭了这种罪，你就一点都不在乎吗？",
            "narrator_zh": ""
        },
        {
            "location": "641/TALK",
            "narrator": "プレイヤー",
            "text": "これも予定通りだから",
            "zh": "因为这也是在计划之内",
            "narrator_zh": "玩家"
        },
        {
            "location": "642/SEL",
            "narrator": "",
            "text": "予定って？",
            "zh": "计划是指？",
            "narrator_zh": ""
        },
        {
            "location": "643/ACT",
            "narrator": "",
            "text": "予定って？",
            "zh": "计划是指？",
            "narrator_zh": ""
        },
        {
            "location": "645/TALK",
            "narrator": "プレイヤー",
            "text": "リプレイス前の進行に流れを戻すのが目的だから",
            "zh": "因为目的就是把流程拉回到替换之前的进度嘛",
            "narrator_zh": "玩家"
        },
        {
            "location": "647/SEL",
            "narrator": "",
            "text": "何故？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "648/ACT",
            "narrator": "",
            "text": "何故？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "650/TALK",
            "narrator": "プレイヤー",
            "text": "$me$達もリプレイスをしてるからだよ",
            "zh": "因为$me$们也在进行替换啊",
            "narrator_zh": "玩家"
        },
        {
            "location": "651/SEL",
            "narrator": "",
            "text": "どんな？",
            "zh": "怎样的？",
            "narrator_zh": ""
        },
        {
            "location": "652/SEL",
            "narrator": "",
            "text": "なら協力しようよ",
            "zh": "那一起来合作吧",
            "narrator_zh": ""
        },
        {
            "location": "653/ACT",
            "narrator": "",
            "text": "どんな？",
            "zh": "怎样的？",
            "narrator_zh": ""
        },
        {
            "location": "654/TALK",
            "narrator": "プレイヤー",
            "text": "リプレイスし始めた世界をリプレイス前に戻す",
            "zh": "把已经开始替换的世界恢复到替换之前",
            "narrator_zh": "玩家"
        },
        {
            "location": "655/ACT",
            "narrator": "",
            "text": "なら協力しようよ",
            "zh": "那一起来合作吧",
            "narrator_zh": ""
        },
        {
            "location": "656/TALK",
            "narrator": "プレイヤー",
            "text": "もちろん大歓迎だよ、その言葉を待っていた",
            "zh": "当然热烈欢迎，我就等着这句话呢",
            "narrator_zh": "玩家"
        },
        {
            "location": "657/SEL",
            "narrator": "",
            "text": "おまえは何を目指してる？",
            "zh": "你到底以什么为目标？",
            "narrator_zh": ""
        },
        {
            "location": "658/ACT",
            "narrator": "",
            "text": "おまえは何を目指してる？",
            "zh": "你到底以什么为目标？",
            "narrator_zh": ""
        },
        {
            "location": "660/TALK",
            "narrator": "プレイヤー",
            "text": "だから、リプレイスし始めた世界を、その前に戻したいんだって",
            "zh": "我都说了，想把已经开始替换的世界恢复到那之前呀",
            "narrator_zh": "玩家"
        },
        {
            "location": "662/SEL",
            "narrator": "",
            "text": "そんなことしてどうなる？",
            "zh": "那样做会怎样？",
            "narrator_zh": ""
        },
        {
            "location": "663/ACT",
            "narrator": "",
            "text": "そんなことしてどうなる？",
            "zh": "那样做会怎样？",
            "narrator_zh": ""
        },
        {
            "location": "665/TALK",
            "narrator": "プレイヤー",
            "text": "最大の敗因を挽回するために必要なんだ",
            "zh": "为了挽回最大的败因，这是必需的",
            "narrator_zh": "玩家"
        },
        {
            "location": "666/SEL",
            "narrator": "",
            "text": "何それ？",
            "zh": "那是什么？",
            "narrator_zh": ""
        },
        {
            "location": "667/ACT",
            "narrator": "",
            "text": "何それ？",
            "zh": "那是什么？",
            "narrator_zh": ""
        },
        {
            "location": "669/TALK",
            "narrator": "プレイヤー",
            "text": "最終的に昇華出来なかったこと",
            "zh": "最终没能成功升华这件事",
            "narrator_zh": "玩家"
        },
        {
            "location": "670/SEL",
            "narrator": "",
            "text": "その辺詳しく",
            "zh": "详细说说那方面",
            "narrator_zh": ""
        },
        {
            "location": "671/ACT",
            "narrator": "",
            "text": "その辺詳しく",
            "zh": "详细说说那方面",
            "narrator_zh": ""
        },
        {
            "location": "673/TALK",
            "narrator": "プレイヤー",
            "text": "その辺を伝えたくて来たんだ",
            "zh": "我就是为了传达这些才来的",
            "narrator_zh": "玩家"
        },
        {
            "location": "674/SEL",
            "narrator": "",
            "text": "早く聞かせて",
            "zh": "快点让我听听",
            "narrator_zh": ""
        },
        {
            "location": "675/ACT",
            "narrator": "",
            "text": "早く聞かせて",
            "zh": "快点让我听听",
            "narrator_zh": ""
        },
        {
            "location": "677/TALK",
            "narrator": "プレイヤー",
            "text": "君にも力になってほしい",
            "zh": "我也想请你助一臂之力",
            "narrator_zh": "玩家"
        },
        {
            "location": "678/SEL",
            "narrator": "",
            "text": "乗っ取り猛々しい",
            "zh": "劫了线还敢这么厚脸皮",
            "narrator_zh": ""
        },
        {
            "location": "679/SEL",
            "narrator": "",
            "text": "自分との協力プレイ展開！？",
            "zh": "这是要和自己合作通关的展开！？",
            "narrator_zh": ""
        },
        {
            "location": "680/SEL",
            "narrator": "",
            "text": "こっちに協力してよ",
            "zh": "你来帮这边嘛",
            "narrator_zh": ""
        },
        {
            "location": "681/SEL",
            "narrator": "",
            "text": "ジュエル９００個で手を打とう",
            "zh": "给900颗珠宝就成交吧",
            "narrator_zh": ""
        },
        {
            "location": "682/ACT",
            "narrator": "",
            "text": "乗っ取り猛々しい",
            "zh": "劫了线还敢这么厚脸皮",
            "narrator_zh": ""
        },
        {
            "location": "683/TALK",
            "narrator": "プレイヤー",
            "text": "$me$と君では確かにそうだけど、君と“彼女らの記憶”だったらどうかな",
            "zh": "$me$和你的话确实是那样，可如果是你和“她们的记忆”呢",
            "narrator_zh": "玩家"
        },
        {
            "location": "684/ACT",
            "narrator": "",
            "text": "自分との協力プレイ展開！？",
            "zh": "这是要和自己合作通关的展开！？",
            "narrator_zh": ""
        },
        {
            "location": "685/TALK",
            "narrator": "プレイヤー",
            "text": "正確には君が$me$に協力するんだ",
            "zh": "准确来说，是你来配合$me$",
            "narrator_zh": "玩家"
        },
        {
            "location": "686/SEL",
            "narrator": "",
            "text": "何それ、お邪魔キャラの分際で",
            "zh": "什么鬼，区区一个来捣乱的",
            "narrator_zh": ""
        },
        {
            "location": "687/ACT",
            "narrator": "",
            "text": "何それ、お邪魔キャラの分際で",
            "zh": "什么鬼，区区一个来捣乱的",
            "narrator_zh": ""
        },
        {
            "location": "689/TALK",
            "narrator": "プレイヤー",
            "text": "$me$と君では確かにそうだけど、君と“彼女らの記憶”だったらどうかな",
            "zh": "$me$和你的话确实是那样，可如果是你和“她们的记忆”呢",
            "narrator_zh": "玩家"
        },
        {
            "location": "690/ACT",
            "narrator": "",
            "text": "こっちに協力してよ",
            "zh": "你来帮这边嘛",
            "narrator_zh": ""
        },
        {
            "location": "691/TALK",
            "narrator": "プレイヤー",
            "text": "君が$me$に協力するのが一番いいことだよ",
            "zh": "你来配合$me$才是最好的选择哦",
            "narrator_zh": "玩家"
        },
        {
            "location": "692/SEL",
            "narrator": "",
            "text": "いや、そうは思わない",
            "zh": "不，我不这么认为",
            "narrator_zh": ""
        },
        {
            "location": "693/ACT",
            "narrator": "",
            "text": "いや、そうは思わない",
            "zh": "不，我不这么认为",
            "narrator_zh": ""
        },
        {
            "location": "695/TALK",
            "narrator": "プレイヤー",
            "text": "さて、それはどうかな？",
            "zh": "那可不一定吧？",
            "narrator_zh": "玩家"
        },
        {
            "location": "696/ACT",
            "narrator": "",
            "text": "ジュエル９００個で手を打とう",
            "zh": "给900颗珠宝就成交吧",
            "narrator_zh": ""
        },
        {
            "location": "697/TALK",
            "narrator": "プレイヤー",
            "text": "ジュエルの譲渡機能なんてないじゃん",
            "zh": "根本就没有珠宝转让功能吧",
            "narrator_zh": "玩家"
        },
        {
            "location": "698/SEL",
            "narrator": "",
            "text": "じゃあヤダよ",
            "zh": "那我可不干",
            "narrator_zh": ""
        },
        {
            "location": "699/ACT",
            "narrator": "",
            "text": "じゃあヤダよ",
            "zh": "那我可不干",
            "narrator_zh": ""
        },
        {
            "location": "701/TALK",
            "narrator": "プレイヤー",
            "text": "じゃあ、勝手に進めさせてもらうよ",
            "zh": "那我就按自己的步调推进了哦",
            "narrator_zh": "玩家"
        },
        {
            "location": "703/TALK",
            "narrator": "プレイヤー",
            "text": "$me$が言っても上手く伝わらないので、トライナリーたちの現実記憶を招待した",
            "zh": "光靠$me$说传达不太明白，所以我请来了三重奏们的现实记忆",
            "narrator_zh": "玩家"
        },
        {
            "location": "704/SEL",
            "narrator": "",
            "text": "現実記憶？？",
            "zh": "现实记忆？？",
            "narrator_zh": ""
        },
        {
            "location": "705/ACT",
            "narrator": "",
            "text": "現実記憶？？",
            "zh": "现实记忆？？",
            "narrator_zh": ""
        },
        {
            "location": "707/TALK",
            "narrator": "プレイヤー",
            "text": "現実世界の記憶を映画のように再生すること。映画と違ってインタラクティブだけど",
            "zh": "就是把现实世界的记忆像电影一样重放。不过和电影不同，是可互动的",
            "narrator_zh": "玩家"
        },
        {
            "location": "708/SEL",
            "narrator": "",
            "text": "アーヤたちがフェノメノンに入る前の記憶と話せるってこと？",
            "zh": "意思是能和绫水她们进入PhenoMENON之前的记忆对话？",
            "narrator_zh": ""
        },
        {
            "location": "709/ACT",
            "narrator": "",
            "text": "アーヤたちがフェノメノンに入る前の記憶と話せるってこと？",
            "zh": "意思是能和绫水她们进入PhenoMENON之前的记忆对话？",
            "narrator_zh": ""
        },
        {
            "location": "711/TALK",
            "narrator": "プレイヤー",
            "text": "うん、そう。その方が絶対分かりやすいと思うしね",
            "zh": "嗯，没错。那样绝对更好懂嘛",
            "narrator_zh": "玩家"
        },
        {
            "location": "712/TALK",
            "narrator": "プレイヤー",
            "text": "ごゆっくり！",
            "zh": "请慢聊！",
            "narrator_zh": "玩家"
        },
        {
            "location": "746/SEL",
            "narrator": "",
            "text": "ここは！？",
            "zh": "这里是！？",
            "narrator_zh": ""
        },
        {
            "location": "747/ACT",
            "narrator": "",
            "text": "ここは！？",
            "zh": "这里是！？",
            "narrator_zh": ""
        },
        {
            "location": "750/TALK",
            "narrator": "アーヤ",
            "text": "…貴方、ですか？",
            "zh": "……是你，吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "751/SEL",
            "narrator": "",
            "text": "なにが？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "752/ACT",
            "narrator": "",
            "text": "なにが？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "754/TALK",
            "narrator": "アーヤ",
            "text": "フェノメノンの中で\n洗脳された私達を――",
            "zh": "对PhenoMENON之中\n被洗脑的我们——",
            "narrator_zh": "绫水"
        },
        {
            "location": "755/TALK",
            "narrator": "アーヤ",
            "text": "たきつけているのは\n貴方なのかと\n聞いているんです。",
            "zh": "我是在问，\n煽动她们的人\n是不是你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "756/SEL",
            "narrator": "",
            "text": "いや、協力してるだけだよ",
            "zh": "不，我只是在协助而已",
            "narrator_zh": ""
        },
        {
            "location": "757/SEL",
            "narrator": "",
            "text": "人違いしてませんか？",
            "zh": "是不是认错人了？",
            "narrator_zh": ""
        },
        {
            "location": "758/SEL",
            "narrator": "",
            "text": "言い方は悪いけど、そういうことになる",
            "zh": "虽然话不太好听，但差不多就是那样",
            "narrator_zh": ""
        },
        {
            "location": "759/SEL",
            "narrator": "",
            "text": "それ以外の選択なかったし",
            "zh": "因为也没有别的选择嘛",
            "narrator_zh": ""
        },
        {
            "location": "760/ACT",
            "narrator": "",
            "text": "いや、協力してるだけだよ",
            "zh": "不，我只是在协助而已",
            "narrator_zh": ""
        },
        {
            "location": "761/TALK",
            "narrator": "ガブリエラ",
            "text": "フェノメノンの中の\nあたし達に協力してる\nってことは…。",
            "zh": "协助PhenoMENON里面的\n我们，\n不就等于……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "762/TALK",
            "narrator": "ガブリエラ",
            "text": "たきつけてるのと\nやってることは\n変わらないわ。",
            "zh": "跟煽动我们\n干的事\n没什么两样嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "763/ACT",
            "narrator": "",
            "text": "人違いしてませんか？",
            "zh": "是不是认错人了？",
            "narrator_zh": ""
        },
        {
            "location": "765/TALK",
            "narrator": "みやび",
            "text": "この期に及んで、\nそれは苦し過ぎやろ？",
            "zh": "都到这节骨眼上了，\n这借口也太牵强了啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "766/ACT",
            "narrator": "",
            "text": "言い方は悪いけど、そういうことになる",
            "zh": "虽然话不太好听，但差不多就是那样",
            "narrator_zh": ""
        },
        {
            "location": "767/TALK",
            "narrator": "みやび",
            "text": "意外と素直に\n認めよったな。",
            "zh": "意外还蛮老实就\n认账了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "768/TALK",
            "narrator": "ガブリエラ",
            "text": "言い訳しても無駄と\nわかって、\n観念したみたいね。",
            "zh": "看来是明白\n狡辩也没用，\n彻底死心了吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "769/SEL",
            "narrator": "",
            "text": "そういうわけじゃないけど",
            "zh": "倒也不是那个意思",
            "narrator_zh": ""
        },
        {
            "location": "770/ACT",
            "narrator": "",
            "text": "そういうわけじゃないけど",
            "zh": "倒也不是那个意思",
            "narrator_zh": ""
        },
        {
            "location": "773/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、\nどういうわけよ？",
            "zh": "那\n是什么意思？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "774/ACT",
            "narrator": "",
            "text": "それ以外の選択なかったし",
            "zh": "因为也没有别的选择嘛",
            "narrator_zh": ""
        },
        {
            "location": "775/TALK",
            "narrator": "ガブリエラ",
            "text": "つまり、たきつけた\nってことよね？",
            "zh": "也就是说，\n就是煽动了对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "776/TALK",
            "narrator": "みやび",
            "text": "ハッキリ言わん辺り、\n後ろめたさがある\nっちゅうことやろか？",
            "zh": "看你不肯直说，\n是心里头有鬼\n的意思咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "778/TALK",
            "narrator": "アーヤ",
            "text": "なんであれ、\n貴方のやっている\nことは…。",
            "zh": "不管怎样，\n你正在做的\n事情……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "779/TALK",
            "narrator": "アーヤ",
            "text": "私達の足を\n引っ張ってることに\n変わりないわ。",
            "zh": "是在拖我们后腿，\n这一点\n没有改变。",
            "narrator_zh": "绫水"
        },
        {
            "location": "780/SEL",
            "narrator": "",
            "text": "いや、そう言われても…",
            "zh": "不，就算你这么说……",
            "narrator_zh": ""
        },
        {
            "location": "781/ACT",
            "narrator": "",
            "text": "いや、そう言われても…",
            "zh": "不，就算你这么说……",
            "narrator_zh": ""
        },
        {
            "location": "784/TALK",
            "narrator": "ガブリエラ",
            "text": "この様子からすると、\n大人しく認めることは\nなさそうね。",
            "zh": "看这架势，\n是不打算乖乖\n承认了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "785/TALK",
            "narrator": "みやび",
            "text": "簡単に認められても、\nそれはそれでウソっ\nぽく思えるけんどな。",
            "zh": "但是要是痛快认了，\n反倒觉得\n像是在撒谎咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "786/TALK",
            "narrator": "みやび",
            "text": "それに、初めっから\n簡単にことが進むとも\n思うちょらんし。",
            "zh": "再说，打从一开始我\n也没觉得事情\n会那么顺啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "787/SEL",
            "narrator": "",
            "text": "全面戦争する気、とか？",
            "zh": "莫非你们想全面开战，之类的？",
            "narrator_zh": ""
        },
        {
            "location": "788/SEL",
            "narrator": "",
            "text": "つまり$me$に協力してくれるんだね？",
            "zh": "也就是说，你们愿意协助$me$了？",
            "narrator_zh": ""
        },
        {
            "location": "789/SEL",
            "narrator": "",
            "text": "さすがみやび、$me$のこと理解してるね",
            "zh": "不愧是雅，真理解$me$呢",
            "narrator_zh": ""
        },
        {
            "location": "790/ACT",
            "narrator": "",
            "text": "全面戦争する気、とか？",
            "zh": "莫非你们想全面开战，之类的？",
            "narrator_zh": ""
        },
        {
            "location": "791/TALK",
            "narrator": "みやび",
            "text": "…随分好戦的なヤツ\nみたいやね。",
            "zh": "……看来是个\n挺好战的家伙咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "792/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、あんたがそれを\n望むなら、それでも\n構わないけど？",
            "zh": "嘛，要是你非要\n那样的话，我也\n无所谓就是了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "794/TALK",
            "narrator": "アーヤ",
            "text": "ダメよ。\nそれが目的じゃ\nないでしょ？",
            "zh": "不行。\n那又不是我们的\n目的对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "795/ACT",
            "narrator": "",
            "text": "つまり$me$に協力してくれるんだね？",
            "zh": "也就是说，你们愿意协助$me$了？",
            "narrator_zh": ""
        },
        {
            "location": "797/TALK",
            "narrator": "ガブリエラ",
            "text": "なんでそうなるのよ？",
            "zh": "怎么会得出那种结论的啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "798/TALK",
            "narrator": "みやび",
            "text": "そんな都合のいい\n展開になるはず\nないやろ…。",
            "zh": "哪会有这么\n便宜的好事\n啵……。",
            "narrator_zh": "雅"
        },
        {
            "location": "799/ACT",
            "narrator": "",
            "text": "さすがみやび、$me$のこと理解してるね",
            "zh": "不愧是雅，真理解$me$呢",
            "narrator_zh": ""
        },
        {
            "location": "800/TALK",
            "narrator": "みやび",
            "text": "いや、知らん。\nちゅうか、あんまし\n興味もないし。",
            "zh": "没有，不懂啊。\n不如说，也没多大\n兴趣。",
            "narrator_zh": "雅"
        },
        {
            "location": "802/TALK",
            "narrator": "アーヤ",
            "text": "貴方が洗脳された\n私達をたきつけて\nいることは…。",
            "zh": "你正在煽动\n被洗脑的我们\n这件事……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "803/TALK",
            "narrator": "アーヤ",
            "text": "$handle$から\n聞いたわ。",
            "zh": "我从$handle$\n那里听说了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "804/TALK",
            "narrator": "アーヤ",
            "text": "だから、作戦を\n正当化するために、\n貴方を説得に来たの。",
            "zh": "所以，为了证明\n作战的正当性，\n我们才来说服你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "805/SEL",
            "narrator": "",
            "text": "作戦って？",
            "zh": "作战是指？",
            "narrator_zh": ""
        },
        {
            "location": "806/SEL",
            "narrator": "",
            "text": "どんな風に説得するつもり？",
            "zh": "你们打算怎么说服？",
            "narrator_zh": ""
        },
        {
            "location": "807/ACT",
            "narrator": "",
            "text": "作戦って？",
            "zh": "作战是指？",
            "narrator_zh": ""
        },
        {
            "location": "809/TALK",
            "narrator": "アーヤ",
            "text": "ええ、それを話せば、\nわかってもらえると\n信じてる。",
            "zh": "嗯，只要说出来，\n我相信你\n会明白的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "810/ACT",
            "narrator": "",
            "text": "どんな風に説得するつもり？",
            "zh": "你们打算怎么说服？",
            "narrator_zh": ""
        },
        {
            "location": "811/TALK",
            "narrator": "アーヤ",
            "text": "…私達の任務について\n貴方に話す。",
            "zh": "……我会向你说明\n我们的任务。",
            "narrator_zh": "绫水"
        },
        {
            "location": "812/TALK",
            "narrator": "アーヤ",
            "text": "こちらの意図を\n理解してもらわないと\n話にならないし。",
            "zh": "不先让你理解\n我方的意图，\n就谈不下去了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "814/TALK",
            "narrator": "アーヤ",
            "text": "私達は、フェノメノン\nという神の奇跡を\n媒介として…。",
            "zh": "我们以PhenoMENON\n这一神之奇迹\n为媒介……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "815/TALK",
            "narrator": "アーヤ",
            "text": "天使となり、世界に\n恒久的安寧を\nもたらすという…。",
            "zh": "化作天使，为世界\n带来恒久安宁——\n我们正肩负着这样的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "816/TALK",
            "narrator": "アーヤ",
            "text": "重大な任務があるの。",
            "zh": "重大任务。",
            "narrator_zh": "绫水"
        },
        {
            "location": "817/SEL",
            "narrator": "",
            "text": "いや、もうちょっと根本的なことから頼む",
            "zh": "不，拜托先从更根本的事讲起吧",
            "narrator_zh": ""
        },
        {
            "location": "818/SEL",
            "narrator": "",
            "text": "なるほど意味がわからない",
            "zh": "原来如此完全听不懂",
            "narrator_zh": ""
        },
        {
            "location": "819/ACT",
            "narrator": "",
            "text": "いや、もうちょっと根本的なことから頼む",
            "zh": "不，拜托先从更根本的事讲起吧",
            "narrator_zh": ""
        },
        {
            "location": "820/ACT",
            "narrator": "",
            "text": "なるほど意味がわからない",
            "zh": "原来如此完全听不懂",
            "narrator_zh": ""
        },
        {
            "location": "823/TALK",
            "narrator": "ガブリエラ",
            "text": "…大分洗脳されてる\nみたいね？",
            "zh": "……看来被洗脑得\n很深了呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "824/TALK",
            "narrator": "みやび",
            "text": "初心者さんやし、\nお手柔らかにしてやりや。",
            "zh": "人家还是新手嘛，\n就手下留情一点啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "825/TALK",
            "narrator": "アーヤ",
            "text": "まあ、簡単に説得\nできるとは最初から\n思ってないわ。",
            "zh": "嘛，我也没指望\n一开始就能\n轻易说服你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "826/TALK",
            "narrator": "アーヤ",
            "text": "順番に、一つずつ\n話していくから、\nよく聞いて。",
            "zh": "我会按顺序，\n一件一件讲清楚，\n你听好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "827/TALK",
            "narrator": "アーヤ",
            "text": "この世界の平和的\n統治を目指す人達が\nいるんだけど…。",
            "zh": "有一群旨在和平统治\n这个世界的人\n存在……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "828/TALK",
            "narrator": "アーヤ",
            "text": "それは仮に、\n“彼ら”と\n言っておくわ。",
            "zh": "关于他们，我暂且\n称之为\n“他们”。",
            "narrator_zh": "绫水"
        },
        {
            "location": "829/TALK",
            "narrator": "アーヤ",
            "text": "その“彼ら”の推進する、\n人々を絶対なる安寧へ\n導くための政策に――",
            "zh": "在“他们”所推进的、\n引导人们走向绝对安宁的\n政策之中——",
            "narrator_zh": "绫水"
        },
        {
            "location": "830/TALK",
            "narrator": "アーヤ",
            "text": "私達は、中心メンバー\nとして参加してるの。",
            "zh": "我们作为核心成员\n参与其中。",
            "narrator_zh": "绫水"
        },
        {
            "location": "831/SEL",
            "narrator": "",
            "text": "安寧って、どういうこと？",
            "zh": "安宁，是什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "832/ACT",
            "narrator": "",
            "text": "安寧って、どういうこと？",
            "zh": "安宁，是什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "834/TALK",
            "narrator": "みやび",
            "text": "フェノメノンっちゅう\n神の奇跡で、敗戦国\n日本を蘇らせ…。",
            "zh": "用PhenoMENON这\n神之奇迹，让战败国\n日本复苏……。",
            "narrator_zh": "雅"
        },
        {
            "location": "835/TALK",
            "narrator": "みやび",
            "text": "その奇跡を持って、\n千年王国とし…。",
            "zh": "并以此奇迹\n化作千年王国……。",
            "narrator_zh": "雅"
        },
        {
            "location": "836/TALK",
            "narrator": "みやび",
            "text": "人々に神の奇跡を\n信じさせる気持ちを\n復活させることや。",
            "zh": "让人们重新拾起\n相信神之奇迹的心情\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "837/TALK",
            "narrator": "ガブリエラ",
            "text": "その千年王国は\n理想的な社会に\n於いて…。",
            "zh": "那座千年王国\n在理想社会的\n建构下……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "838/TALK",
            "narrator": "ガブリエラ",
            "text": "世界で最も豊かで\n幸せな、法と規律に\nよって…。",
            "zh": "靠着法度与纪律，\n成为世界上最富足\n幸福的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "839/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対的な秩序のある\n国として世界に\n知らしめること。",
            "zh": "拥有绝对秩序的国家，\n从而向全世界\n昭示这一点。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "840/TALK",
            "narrator": "アーヤ",
            "text": "そして、千年王国を\n創りし存在こそが…。",
            "zh": "而创造出千年王国的\n存在，正是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "841/TALK",
            "narrator": "アーヤ",
            "text": "４人の天使であると\nいうこともまた…。",
            "zh": "四位天使\n这件事，也……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "843/TALK",
            "narrator": "アーヤ",
            "text": "具体的行動により\n世界に示すことが、\n私達の任務なの。",
            "zh": "通过具体行动\n向世界证明，\n这就是我们的任务。",
            "narrator_zh": "绫水"
        },
        {
            "location": "844/SEL",
            "narrator": "",
            "text": "いやいや、わけわからないし！",
            "zh": "不不，完全听不懂好吗！",
            "narrator_zh": ""
        },
        {
            "location": "845/SEL",
            "narrator": "",
            "text": "えっと、カルト？",
            "zh": "那个，邪教？",
            "narrator_zh": ""
        },
        {
            "location": "846/ACT",
            "narrator": "",
            "text": "いやいや、わけわからないし！",
            "zh": "不不，完全听不懂好吗！",
            "narrator_zh": ""
        },
        {
            "location": "848/TALK",
            "narrator": "アーヤ",
            "text": "…上手く説明できたと\n思ったんだけど。",
            "zh": "……我还以为已经\n解释得很清楚了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "849/TALK",
            "narrator": "みやび",
            "text": "洗脳の影響やろ。\n根気よくいかんと\nダメそうやね。",
            "zh": "是洗脑的影响咯。\n不耐着性子慢慢来\n怕是不行咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "850/ACT",
            "narrator": "",
            "text": "えっと、カルト？",
            "zh": "那个，邪教？",
            "narrator_zh": ""
        },
        {
            "location": "852/TALK",
            "narrator": "ガブリエラ",
            "text": "あのね、あたし達は\n現実的なことを\n話してるのよ？",
            "zh": "我说啊，我们\n可是在谈论\n很现实的事哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "853/TALK",
            "narrator": "ガブリエラ",
            "text": "妄想に狂った連中と\n一緒にされるのは、\n不愉快だわ。",
            "zh": "把我们跟沉溺妄想的疯子\n混为一谈，\n真让人不爽。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "854/TALK",
            "narrator": "みやび",
            "text": "しゃあない。\n信じられんからこそ\n“奇跡”になるんやし。",
            "zh": "没得办法。\n正因为让人没法相信，\n才称得上“奇迹”啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "856/TALK",
            "narrator": "アーヤ",
            "text": "えっと…それじゃあ、\nもう少し詳しく\n話すわ。",
            "zh": "那个……那么，\n我再讲得\n详细一点。",
            "narrator_zh": "绫水"
        },
        {
            "location": "857/TALK",
            "narrator": "アーヤ",
            "text": "４人の天使について\nだけど、わかる？",
            "zh": "关于四位天使，\n你知道吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "858/SEL",
            "narrator": "",
            "text": "知らない",
            "zh": "不知道",
            "narrator_zh": ""
        },
        {
            "location": "859/SEL",
            "narrator": "",
            "text": "つばめ、アーヤ、ガブリエラ、みやびのこと？",
            "zh": "是指燕、绫水、加布里埃拉、雅吗？",
            "narrator_zh": ""
        },
        {
            "location": "860/ACT",
            "narrator": "",
            "text": "知らない",
            "zh": "不知道",
            "narrator_zh": ""
        },
        {
            "location": "861/ACT",
            "narrator": "",
            "text": "つばめ、アーヤ、ガブリエラ、みやびのこと？",
            "zh": "是指燕、绫水、加布里埃拉、雅吗？",
            "narrator_zh": ""
        },
        {
            "location": "863/TALK",
            "narrator": "アーヤ",
            "text": "違うわ。",
            "zh": "不对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "865/TALK",
            "narrator": "アーヤ",
            "text": "私達三人と、\n卯月のことよ。",
            "zh": "是我们三个，\n加上卯月。",
            "narrator_zh": "绫水"
        },
        {
            "location": "866/TALK",
            "narrator": "アーヤ",
            "text": "それは４人の\n熾天使であり、\n今この時を境に…。",
            "zh": "那是指四位\n炽天使，\n以此时此刻为界……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "867/TALK",
            "narrator": "アーヤ",
            "text": "それは伝説の存在では\nなく、現実のものと\nなるの。",
            "zh": "她们将不再是传说，\n而是化为现实的\n存在。",
            "narrator_zh": "绫水"
        },
        {
            "location": "868/TALK",
            "narrator": "みやび",
            "text": "わかりやすく言うと、\n黙示録の始まり、\nっちゅうことや。",
            "zh": "说简单点，\n就是启示录的开端，\n这么回事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "869/TALK",
            "narrator": "みやび",
            "text": "うちらは荒廃した\nフェノメノンの中に\n入り…。",
            "zh": "我们进入荒废的\nPhenoMENON里面\n……。",
            "narrator_zh": "雅"
        },
        {
            "location": "870/TALK",
            "narrator": "みやび",
            "text": "その世界を千年王国\nとして切り開く。",
            "zh": "把那个世界开拓为\n千年王国。",
            "narrator_zh": "雅"
        },
        {
            "location": "872/TALK",
            "narrator": "みやび",
            "text": "そして、世界を\n安寧へと導くための\n存在なんよ。",
            "zh": "而且，我们就是\n为了把世界引向安宁的\n存在啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "873/TALK",
            "narrator": "ガブリエラ",
            "text": "それが達成されれば、\n世界は一つになる。",
            "zh": "一旦达成这一点，\n世界就会合而为一。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "874/TALK",
            "narrator": "ガブリエラ",
            "text": "この世は\n日本を皮切りとして、\n神の統治の元で…。",
            "zh": "这个世间\n将以日本为开端，\n在神的统治之下……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "875/TALK",
            "narrator": "ガブリエラ",
            "text": "全世界規模の\n千年王国へと\n突き進めるのよ。",
            "zh": "向着全世界规模的\n千年王国\n迈进哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "876/SEL",
            "narrator": "",
            "text": "自信満々に言うね？",
            "zh": "说得还真自信满满啊？",
            "narrator_zh": ""
        },
        {
            "location": "877/ACT",
            "narrator": "",
            "text": "自信満々に言うね？",
            "zh": "说得还真自信满满啊？",
            "narrator_zh": ""
        },
        {
            "location": "879/TALK",
            "narrator": "ガブリエラ",
            "text": "根拠もあるわ。",
            "zh": "也是有根据的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "880/TALK",
            "narrator": "ガブリエラ",
            "text": "日本が一夜にして\n復興するっていう…。",
            "zh": "日本在一夜之间\n复兴这样……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "882/TALK",
            "narrator": "ガブリエラ",
            "text": "神の奇跡を、全人類が\n目の当たりにする\nことになるんだから。",
            "zh": "神之奇迹，全人类\n都将亲眼\n目睹啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "883/TALK",
            "narrator": "みやび",
            "text": "今、否定的なことを\n言うてても…。",
            "zh": "现在嘴上\n就算再否定……。",
            "narrator_zh": "雅"
        },
        {
            "location": "884/TALK",
            "narrator": "みやび",
            "text": "否定しようもない\n大いなる奇跡を\n目にすれば…。",
            "zh": "只要亲眼见识到\n无可否定的\n伟大奇迹……。",
            "narrator_zh": "雅"
        },
        {
            "location": "885/TALK",
            "narrator": "みやび",
            "text": "信仰は間違いなく\n復活する。",
            "zh": "信仰就毫无疑问\n会复活。",
            "narrator_zh": "雅"
        },
        {
            "location": "886/TALK",
            "narrator": "アーヤ",
            "text": "そして世界中の人々は\n自らの国にも千年王国\n創造を祈る。",
            "zh": "于是全世界的人们\n都会祈求自己的国家\n也能创造千年王国。",
            "narrator_zh": "绫水"
        },
        {
            "location": "887/TALK",
            "narrator": "アーヤ",
            "text": "私達天使が、\nそれを判断する",
            "zh": "由我们天使\n来做出裁断",
            "narrator_zh": "绫水"
        },
        {
            "location": "888/TALK",
            "narrator": "アーヤ",
            "text": "黙示録の天使として、\n厳格な基準のもとに\n行動し…。",
            "zh": "作为启示录的天使，\n依照严格的标准\n行动……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "889/TALK",
            "narrator": "アーヤ",
            "text": "全世界規模の\n千年王国を\n創造するの。",
            "zh": "去创造出\n全世界规模的\n千年王国。",
            "narrator_zh": "绫水"
        },
        {
            "location": "890/SEL",
            "narrator": "",
            "text": "ごめん、マジで話についていけない",
            "zh": "抱歉，我真的完全跟不上你们的思路",
            "narrator_zh": ""
        },
        {
            "location": "891/ACT",
            "narrator": "",
            "text": "ごめん、マジで話についていけない",
            "zh": "抱歉，我真的完全跟不上你们的思路",
            "narrator_zh": ""
        },
        {
            "location": "894/TALK",
            "narrator": "アーヤ",
            "text": "…ダメみたい。\n想像以上に旧世界秩序の\n観念に囚われてるわね。",
            "zh": "……看来不行。\n他被旧世界秩序的观念\n束缚得比想象中还深。",
            "narrator_zh": "绫水"
        },
        {
            "location": "895/TALK",
            "narrator": "ガブリエラ",
            "text": "それ以外\n考えられないわ。",
            "zh": "除此之外\n没别的解释了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "896/TALK",
            "narrator": "みやび",
            "text": "面倒やねえ。\nどうしたらえいか…。",
            "zh": "真麻烦咧。\n该怎么弄才好……。",
            "narrator_zh": "雅"
        },
