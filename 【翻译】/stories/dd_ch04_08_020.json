{
    "dir": "chap08/daydra/dd_ch04_08_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "8456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ネットサーフィン",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "网上冲浪"
    },
    "entry": [
        {
            "location": "210/SCENARIO",
            "narrator": "",
            "text": "ネットサーフィン",
            "zh": "网上冲浪",
            "narrator_zh": ""
        },
        {
            "location": "227/TALK",
            "narrator": "みやび",
            "text": "今日もネット掲示板は\n大荒れやね。",
            "zh": "今天的网络论坛也是\n大乱斗咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "228/TALK",
            "narrator": "みやび",
            "text": "どうしてここの掲示板は\nいつも荒れてるがか…？",
            "zh": "为什么这里的论坛\n总是吵个没完呢……？",
            "narrator_zh": "雅"
        },
        {
            "location": "229/TALK",
            "narrator": "みやび",
            "text": "…罵倒のぶつけ合いが\n始まったき、他んとこ\n見るか。",
            "zh": "……对骂开始了啵，\n换别的\n地方看吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "232/TALK",
            "narrator": "真幌",
            "text": "おい、みやび。",
            "zh": "喂，雅。",
            "narrator_zh": "真幌"
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "おっ、まほさん。\nどうかしたがですか？",
            "zh": "哦，真幌。\n怎么了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "235/TALK",
            "narrator": "真幌",
            "text": "どうかしたも何も、\n今はバイト中だろう？",
            "zh": "什么怎么了的，\n现在不是在打工吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "236/TALK",
            "narrator": "真幌",
            "text": "なのに、おまえときたら\nさっきからずっとネット\nサーフィンばかり――",
            "zh": "可你倒好，从刚才起\n就一直网上\n冲浪——",
            "narrator_zh": "真幌"
        },
        {
            "location": "237/TALK",
            "narrator": "真幌",
            "text": "少しは働いたら\nどうなんだ？",
            "zh": "稍微干点活\n不好吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "うちの仕事はとっくに\n終わっちょりますき。",
            "zh": "我的活早就\n干完着啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "240/TALK",
            "narrator": "真幌",
            "text": "そういう問題ではない！",
            "zh": "这不是那个问题！",
            "narrator_zh": "真幌"
        },
        {
            "location": "241/TALK",
            "narrator": "真幌",
            "text": "いいか？　確かにおまえは\n自分の仕事をしっかりと\n終わらせたかもしれん。",
            "zh": "听好了？　确实，你\n可能把自己的活\n好好干完了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "242/TALK",
            "narrator": "真幌",
            "text": "しかしな、まだ他の\nみんなが働いていると\nいうのにおまえだけ…。",
            "zh": "但是呢，明明大家\n都还在干活，\n就你一个……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "244/SEL",
            "narrator": "",
            "text": "たまには大人しく聞こう",
            "zh": "偶尔也乖乖听着吧",
            "narrator_zh": ""
        },
        {
            "location": "245/SEL",
            "narrator": "",
            "text": "真幌を黙らせる情報を探せ",
            "zh": "去找让真幌闭嘴的情报",
            "narrator_zh": ""
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "まほさん、珍しく説教\nモードになっちゅうな。",
            "zh": "真幌，难得切到\n说教模式里了呐。",
            "narrator_zh": "雅"
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "まあ、いつもの気まぐれ\nとは思うけんど…\n面倒やなぁ。",
            "zh": "嘛，虽然心里想\n大概是平时那种心血来潮……\n可真麻烦呐。",
            "narrator_zh": "雅"
        },
        {
            "location": "251/TALK",
            "narrator": "みやび",
            "text": "いつもは何も言わんのに、\n急にガミガミ言われても、\n困るぞね。",
            "zh": "平时什么都不说，\n突然被这么劈头盖脸\n地骂，我很困扰咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "どうにか黙らせる方法が\nあればえいんやけんど、\nう～ん…。",
            "zh": "要是有办法让他\n闭嘴就好了，但是，\n唔～……。",
            "narrator_zh": "雅"
        },
        {
            "location": "255/TALK",
            "narrator": "真幌",
            "text": "…おい、聞いてないだろ？",
            "zh": "……喂，你根本没在听吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "まほさん黙らす方法…\n相棒に聞いた方が\nえいやろか？",
            "zh": "让真幌闭嘴的方法……\n要不要问搭档\n才好咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "258/TALK",
            "narrator": "真幌",
            "text": "みやび！",
            "zh": "雅！",
            "narrator_zh": "真幌"
        },
        {
            "location": "259/TALK",
            "narrator": "みやび",
            "text": "うわっ！？\nどうしたがです？\n急に大声出して…。",
            "zh": "哇！？\n怎么了这是？\n突然这么大声……。",
            "narrator_zh": "雅"
        },
        {
            "location": "260/TALK",
            "narrator": "真幌",
            "text": "どうしたじゃない！\n人が説教してる時に\nぼーっとするな！",
            "zh": "什么怎么了！\n我在说教的时候\n别发呆！",
            "narrator_zh": "真幌"
        },
        {
            "location": "261/TALK",
            "narrator": "真幌",
            "text": "そもそも、おまえは\nいつもいつも――",
            "zh": "说到底，你就是\n一直一直——",
            "narrator_zh": "真幌"
        },
        {
            "location": "263/TALK",
            "narrator": "みやび",
            "text": "…あかん、こりゃ当分\n終わりそうにないな。",
            "zh": "……不行，这一时半会\n怕是结束不了了。",
            "narrator_zh": "雅"
        },
        {
            "location": "264/TALK",
            "narrator": "みやび",
            "text": "余計なこと考えんで、\n黙って耳傾けておくべき\nやったか…。",
            "zh": "早知道别多想，\n闭上嘴竖起耳朵\n听着就好了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "265/TALK",
            "narrator": "真幌",
            "text": "…また聞いてないな？",
            "zh": "……又没在听吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "266/TALK",
            "narrator": "みやび",
            "text": "聞いてますよ。",
            "zh": "在听哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "268/TALK",
            "narrator": "みやび",
            "text": "自業自得やし、\nちっくと真面目に聞くと\nするちや。",
            "zh": "自作自受嘛，\n就稍微认真点\n听滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "270/ACT",
            "narrator": "",
            "text": "たまには大人しく聞こう",
            "zh": "偶尔也乖乖听着吧",
            "narrator_zh": ""
        },
        {
            "location": "289/TALK",
            "narrator": "みやび",
            "text": "…相棒は大人やね",
            "zh": "……搭档是大人呢",
            "narrator_zh": "雅"
        },
        {
            "location": "300/TALK",
            "narrator": "みやび",
            "text": "まあ、まほさんがこんなに\nガミガミ言うんは珍しい\nことやき。",
            "zh": "嘛，真幌这么劈头\n盖脸地骂人是\n稀罕事啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "301/TALK",
            "narrator": "みやび",
            "text": "きっと、何か嫌なことでも\nあったんやろうなぁ。",
            "zh": "八成是遇上什么\n烦心的事了吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "302/TALK",
            "narrator": "みやび",
            "text": "うちも相棒を見習って、\nちっくと大人になると\nするちや。",
            "zh": "我也学学搭档，\n稍微变得\n大人一点滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "303/TALK",
            "narrator": "真幌",
            "text": "自分の仕事が終わったなら\n他の者を手伝うとかしたら\nどうなんだ？",
            "zh": "干完了自己的活，\n去帮帮别人\n不好吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "304/TALK",
            "narrator": "真幌",
            "text": "何も力仕事をしろとは\n言わん。おまえに力仕事は\n期待していないからな。",
            "zh": "又没说要你干\n力气活。对你的力气\n我没抱指望。",
            "narrator_zh": "真幌"
        },
        {
            "location": "305/TALK",
            "narrator": "真幌",
            "text": "しかし、劇場の掃除を\n手伝うくらいはできる\nだろう？",
            "zh": "但是，帮着打扫\n剧场这种程度，\n总能做到吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "307/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "308/TALK",
            "narrator": "真幌",
            "text": "劇場の中以外でも\nやれることはある。",
            "zh": "剧场之外，\n也有能干的事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "309/TALK",
            "narrator": "真幌",
            "text": "うちのチラシを道に立って\n配ることもできるはずだ。",
            "zh": "站到街上发本剧场的\n传单也应当可行。",
            "narrator_zh": "真幌"
        },
        {
            "location": "310/TALK",
            "narrator": "真幌",
            "text": "まあ、大勢に押しかけられ\nても困りはするが――",
            "zh": "嘛，要是一大群人涌过来\n也会犯难——",
            "narrator_zh": "真幌"
        },
        {
            "location": "311/TALK",
            "narrator": "みやび",
            "text": "…まほさん、相当溜まって\nたんやねぇ。",
            "zh": "……真幌，积压的\n东西相当多呐。",
            "narrator_zh": "雅"
        },
        {
            "location": "312/TALK",
            "narrator": "真幌",
            "text": "劇場がずっと閑古鳥なのも\nそれはそれで困る。",
            "zh": "剧场一直门可罗雀，\n这也是个问题。",
            "narrator_zh": "真幌"
        },
        {
            "location": "313/TALK",
            "narrator": "真幌",
            "text": "どうしてこの劇場はやって\nいけてるのかと疑問に…。",
            "zh": "这剧场到底靠什么维持\n下去，真让人纳闷……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "314/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "315/TALK",
            "narrator": "みやび",
            "text": "？　どうかしたがです？",
            "zh": "？　怎么了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "316/TALK",
            "narrator": "真幌",
            "text": "…やけに大人しいな？",
            "zh": "……怎么这么乖？",
            "narrator_zh": "真幌"
        },
        {
            "location": "317/TALK",
            "narrator": "みやび",
            "text": "説教やき、ちゃんと\n聞きますがよ。",
            "zh": "在说教嘛，我好好\n听着呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "318/TALK",
            "narrator": "真幌",
            "text": "…そうか。",
            "zh": "……这样啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "319/TALK",
            "narrator": "真幌",
            "text": "いや、もういい。\n少し言い過ぎたようだ。",
            "zh": "算了，不用了。\n好像说得有点过头了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "320/TALK",
            "narrator": "真幌",
            "text": "まあ、仕事中のサボりは\nほどほどにしろ。\n以上だ。",
            "zh": "总之，上班时间\n摸鱼适可而止。\n完了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "325/TALK",
            "narrator": "みやび",
            "text": "…思ったよりあっさり\n終わりよったな。",
            "zh": "……比想象中\n干脆利落地结束了呐。",
            "narrator_zh": "雅"
        },
        {
            "location": "326/TALK",
            "narrator": "みやび",
            "text": "時には大人しく聞くんも、\n有効手段ゆうことやね。",
            "zh": "有时候乖乖听着，\n也是有效手段咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "327/ACT",
            "narrator": "",
            "text": "真幌を黙らせる情報を探せ",
            "zh": "去找让真幌闭嘴的情报",
            "narrator_zh": ""
        },
        {
            "location": "348/TALK",
            "narrator": "みやび",
            "text": "まほさんを黙らせる情報…微妙に難しいことを言いよる",
            "zh": "让真幌闭嘴的情报……真幌说的事微妙地刁钻呢",
            "narrator_zh": "雅"
        },
        {
            "location": "349/TALK",
            "narrator": "みやび",
            "text": "…まあ、当てがないわけやないけんどね",
            "zh": "……嘛，也不是完全没有眉目咯",
            "narrator_zh": "雅"
        },
        {
            "location": "360/TALK",
            "narrator": "みやび",
            "text": "多分、海外サイトの\nこの辺りなら…。",
            "zh": "大概，海外网站的\n这一带的话……。",
            "narrator_zh": "雅"
        },
        {
            "location": "361/TALK",
            "narrator": "真幌",
            "text": "自分の仕事が終わったなら\n他の者を手伝うとかしたら\nどうなんだ？",
            "zh": "干完了自己的活，\n去帮帮别人\n不好吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "363/TALK",
            "narrator": "みやび",
            "text": "まほさんの好みを\n考えると、多分…。",
            "zh": "想想真幌的喜好，\n大概……。",
            "narrator_zh": "雅"
        },
        {
            "location": "364/TALK",
            "narrator": "真幌",
            "text": "何も力仕事をしろとは\n言わん。おまえに力仕事は\n期待して――",
            "zh": "又没说要你干\n力气活。对你的力气\n我没抱期——",
            "narrator_zh": "真幌"
        },
        {
            "location": "365/TALK",
            "narrator": "真幌",
            "text": "って、話くらい聞け！",
            "zh": "喂，好歹把话听完！",
            "narrator_zh": "真幌"
        },
        {
            "location": "367/TALK",
            "narrator": "みやび",
            "text": "まほさん、ちっくと\n聞きたいがですけど――",
            "zh": "真幌，有点事\n想问一下——",
            "narrator_zh": "雅"
        },
        {
            "location": "368/TALK",
            "narrator": "みやび",
            "text": "「死霊のカウボーイ」\nっちゅう大昔の映画、\n知っちょりますか？",
            "zh": "「死灵牛仔」\n这部老掉牙的电影，\n你晓得吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "369/TALK",
            "narrator": "真幌",
            "text": "…９０年以上前に米国で\n公開した幻の映画だ。",
            "zh": "……九十年以上前在美国\n上映的幻之电影。",
            "narrator_zh": "真幌"
        },
        {
            "location": "370/TALK",
            "narrator": "真幌",
            "text": "現存するフィルムはないと\n言われ、今では伝説と\nなった映画の一本で――",
            "zh": "据说现存的胶片\n已经不存在，如今已成\n传说电影之一——",
            "narrator_zh": "真幌"
        },
        {
            "location": "371/TALK",
            "narrator": "真幌",
            "text": "って、話を逸らすな！",
            "zh": "喂，别岔开话！",
            "narrator_zh": "真幌"
        },
        {
            "location": "373/TALK",
            "narrator": "みやび",
            "text": "いや、説教するんは\nいいがですけんど――",
            "zh": "不，说教\n我不反对，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "374/TALK",
            "narrator": "みやび",
            "text": "そのフィルムの一つが、\n海外のオークション\nサイトに出てますがよ？",
            "zh": "那批胶片里的一部，\n正挂在海外的拍卖\n网站上哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "376/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "378/TALK",
            "narrator": "真幌",
            "text": "ほ、本当か？",
            "zh": "当、当真？",
            "narrator_zh": "真幌"
        },
        {
            "location": "379/TALK",
            "narrator": "みやび",
            "text": "ほんまですよ。",
            "zh": "千真万确哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "380/TALK",
            "narrator": "みやび",
            "text": "まほさんがえいなら、\n落札のために張り付き\nますけんど…。",
            "zh": "真幌要是说好，\n为了拍下它我就\n一直盯着就是了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "382/TALK",
            "narrator": "真幌",
            "text": "なんてことだ…まさか\n現存するフィルムが\n残っていたとは…。",
            "zh": "怎么会……居然\n还有现存胶片\n留存于世……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "384/TALK",
            "narrator": "真幌",
            "text": "金に糸目はつけん！\n何としても落札しろ！！",
            "zh": "钱不是问题！\n无论如何都要拍下！！",
            "narrator_zh": "真幌"
        },
        {
            "location": "385/TALK",
            "narrator": "みやび",
            "text": "ラジャーです。\n絶対に落札して\nみせますき。",
