{
    "dir": "chap00/daydra/first_anniversary_030.js",
    "type": "",
    "info": {
        "story_id": "11803",
        "cid": "",
        "title": "祝・１周年記念",
        "sub_title": "祝・１周年記念＜第３話＞",
        "title_zh": "祝・1周年纪念",
        "sub_title_zh": "祝・1周年纪念＜第3话＞"
    },
    "entry": [
        {
            "location": "460/TALK",
            "narrator": "神楽",
            "text": "さて。\n用意したイラストは\nこれです。",
            "zh": "那么。\n我准备的插画\n就是这张。",
            "narrator_zh": "神乐"
        },
        {
            "location": "461/TALK",
            "narrator": "神楽",
            "text": "みなさんの意見を\n尊重して浴衣です。",
            "zh": "尊重大家的意见\n画的是浴衣。",
            "narrator_zh": "神乐"
        },
        {
            "location": "462/TALK",
            "narrator": "アーヤ",
            "text": "それはぜひそうして。",
            "zh": "那就务必这么做吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "464/TALK",
            "narrator": "みやび",
            "text": "うちはまあえいよ。\nしょせん絵やし。",
            "zh": "我是得吧得吧。\n反正只是画而已啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "466/TALK",
            "narrator": "ガブリエラ",
            "text": "もう！　みやびには\n恥じらいってものが\nないの！？",
            "zh": "真是的！　雅你\n就一点羞耻心\n都没有吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "491/TALK",
            "narrator": "透明神楽",
            "text": "えーと……。\nこんな感じでしょうか。",
            "zh": "呃……。\n是这样的感觉吗。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "495/TALK",
            "narrator": "透明神楽",
            "text": "いつも側にいてくれて\nありがとう。\nこれからもよろしく。",
            "zh": "谢谢你一直\n陪在我身边。\n今后也请多关照。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "499/TALK",
            "narrator": "透明アーヤ",
            "text": "$handle$さんの\nおかげで毎日が\n楽しいの。",
            "zh": "多亏了$handle$，\n每天都\n过得很开心。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "500/TALK",
            "narrator": "透明アーヤ",
            "text": "これからもいっぱい\nお話ししましょうね。",
            "zh": "今后也一起\n多多聊天吧。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "503/TALK",
            "narrator": "透明みやび",
            "text": "相棒よ。\nうちはうちとして生きる。",
            "zh": "搭档。\n我以我自己的方式活着。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "505/TALK",
            "narrator": "透明みやび",
            "text": "やき、相棒は相棒らしく\nうちとともに歩め。\n以上。",
            "zh": "嘛，搭档就像个搭档，\n和我并肩走下去。\n以上。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "508/TALK",
            "narrator": "透明ガブリエラ",
            "text": "$handle$へ。",
            "zh": "给$handle$。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "509/TALK",
            "narrator": "透明ガブリエラ",
            "text": "いつもあたしに\n優しくしてくれて\nありがとう。",
            "zh": "总是对我\n这么温柔，\n谢谢你。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "511/TALK",
            "narrator": "透明ガブリエラ",
            "text": "だいすきよ。",
            "zh": "最喜欢你了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "515/TALK",
            "narrator": "透明つばめ",
            "text": "みんなこんなところに\nいたの！？",
            "zh": "大家居然\n都在这里！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "516/TALK",
            "narrator": "透明つばめ",
            "text": "で、これって？",
            "zh": "那，这个是？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "517/TALK",
            "narrator": "透明つばめ",
            "text": "$handle$さんへの\nメッセージ？",
            "zh": "给$handle$的\n留言？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "520/TALK",
            "narrator": "透明つばめ",
            "text": "$handle$さん\n元気ですか？\nつばめは元気です。",
            "zh": "$handle$，\n你还好吗？\n燕很有精神哦。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "521/TALK",
            "narrator": "透明つばめ",
            "text": "この元気は\n$handle$さんが\nくれた元気だよ。",
            "zh": "这份元气\n是$handle$给\n我的元气哦。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "522/TALK",
            "narrator": "透明つばめ",
            "text": "だからこれからも\n元気でいてね。\nいつもありがとう。",
            "zh": "所以今后也要\n精神满满哦。\n一直以来都谢谢你啦。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "530/TALK",
            "narrator": "透明みやび",
            "text": "…すう…。",
            "zh": "…呼…。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "531/TALK",
            "narrator": "透明アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "532/TALK",
            "narrator": "透明つばめ",
            "text": "ぐう……。",
            "zh": "呼噜……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "533/TALK",
            "narrator": "透明ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "551/TALK",
            "narrator": "神楽",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "563/TALK",
            "narrator": "神楽",
            "text": "起きてるぴょん？",
            "zh": "醒着吗pyon？",
            "narrator_zh": "神乐"
        },
        {
            "location": "564/SEL",
            "narrator": "（選択肢）",
            "text": "起きてるよ",
            "zh": "醒着呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "565/SEL",
            "narrator": "（選択肢）",
            "text": "今起きた",
            "zh": "刚醒",
            "narrator_zh": "（选项）"
        },
        {
            "location": "566/SEL",
            "narrator": "（選択肢）",
            "text": "寝てる暇とかないし",
            "zh": "哪有功夫睡觉啊",
            "narrator_zh": "（选项）"
        },
        {
            "location": "567/ACT",
            "narrator": "",
            "text": "起きてるよ",
            "zh": "醒着呢",
            "narrator_zh": ""
        },
        {
            "location": "569/ACT",
            "narrator": "",
            "text": "今起きた",
            "zh": "刚醒",
            "narrator_zh": ""
        },
        {
            "location": "571/ACT",
            "narrator": "",
            "text": "寝てる暇とかないし",
            "zh": "哪有功夫睡觉啊",
            "narrator_zh": ""
        },
        {
            "location": "572/TALK",
            "narrator": "神楽",
            "text": "またまたー",
            "zh": "才不信呢——",
            "narrator_zh": "神乐"
        },
        {
            "location": "574/TALK",
            "narrator": "神楽",
            "text": "こっちは月がきれいぴょん",
            "zh": "我这边月亮好美pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "577/SEL",
            "narrator": "（選択肢）",
            "text": "愛の告白？",
            "zh": "爱的告白？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "578/SEL",
            "narrator": "（選択肢）",
            "text": "田舎だからじゃねｗ",
            "zh": "因为是乡下吧ｗ",
            "narrator_zh": "（选项）"
        },
        {
            "location": "579/SEL",
            "narrator": "（選択肢）",
            "text": "一緒に見たかったな",
            "zh": "真想一起看啊",
            "narrator_zh": "（选项）"
        },
        {
            "location": "580/ACT",
            "narrator": "",
            "text": "愛の告白？",
            "zh": "爱的告白？",
            "narrator_zh": ""
        },
        {
            "location": "581/TALK",
            "narrator": "神楽",
            "text": "どうかなー",
            "zh": "你说呢——",
            "narrator_zh": "神乐"
        },
        {
            "location": "582/ACT",
            "narrator": "",
            "text": "田舎だからじゃねｗ",
            "zh": "因为是乡下吧ｗ",
            "narrator_zh": ""
        },
        {
            "location": "583/TALK",
            "narrator": "神楽",
            "text": "情緒がないぴょん",
            "zh": "真没情调pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "584/ACT",
            "narrator": "",
            "text": "一緒に見たかったな",
            "zh": "真想一起看啊",
            "narrator_zh": ""
        },
        {
            "location": "585/TALK",
            "narrator": "神楽",
            "text": "ぴょんこも、、、",
            "zh": "蹦子也、、、",
            "narrator_zh": "神乐"
        },
        {
            "location": "588/TALK",
            "narrator": "神楽",
            "text": "いやいやそれより",
            "zh": "不不，比起这个",
            "narrator_zh": "神乐"
        },
        {
            "location": "589/TALK",
            "narrator": "神楽",
            "text": "メッセージカードどうでしたか？",
            "zh": "留言卡感觉怎么样？",
            "narrator_zh": "神乐"
        },
        {
            "location": "591/SEL",
            "narrator": "（選択肢）",
            "text": "萌えた",
            "zh": "被萌到了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "592/SEL",
            "narrator": "（選択肢）",
            "text": "すごくうれしかった",
            "zh": "特别开心",
            "narrator_zh": "（选项）"
        },
        {
            "location": "593/SEL",
            "narrator": "（選択肢）",
            "text": "ちょっと不満かな……",
            "zh": "多少有点不满……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "594/ACT",
            "narrator": "",
            "text": "萌えた",
            "zh": "被萌到了",
            "narrator_zh": ""
        },
        {
            "location": "595/TALK",
            "narrator": "神楽",
            "text": "やったね！",
            "zh": "太棒了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "596/ACT",
            "narrator": "",
            "text": "すごくうれしかった",
            "zh": "特别开心",
            "narrator_zh": ""
        },
        {
            "location": "597/TALK",
            "narrator": "神楽",
            "text": "よかったぴょん♪",
            "zh": "太好了pyon♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "598/ACT",
            "narrator": "",
            "text": "ちょっと不満かな……",
            "zh": "多少有点不满……",
            "narrator_zh": ""
        },
        {
            "location": "599/TALK",
            "narrator": "神楽",
            "text": "ダヨネー",
            "zh": "就是说嘛——",
            "narrator_zh": "神乐"
        },
        {
            "location": "601/TALK",
            "narrator": "神楽",
            "text": "実は実は",
            "zh": "其实其实",
            "narrator_zh": "神乐"
        },
        {
            "location": "602/TALK",
            "narrator": "神楽",
            "text": "全員温泉バージョンも",
            "zh": "全员温泉版也",
            "narrator_zh": "神乐"
        },
        {
            "location": "603/TALK",
            "narrator": "神楽",
            "text": "用意してるんですよね♪",
            "zh": "早就准备好了哦♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "604/TALK",
            "narrator": "神楽",
            "text": "見たい？",
            "zh": "想看吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "605/TALK",
            "narrator": "神楽",
            "text": "ねえねえねえねえ",
            "zh": "呐呐呐呐",
            "narrator_zh": "神乐"
        },
        {
            "location": "607/TALK",
            "narrator": "神楽",
            "text": "見たいでしょ？？？",
            "zh": "想看的吧？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "608/TALK",
            "narrator": "神楽",
            "text": "見たいでしょー！？！？！？！？",
            "zh": "想看的吧——！？！？！？！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "610/SEL",
            "narrator": "（選択肢）",
            "text": "別にー",
            "zh": "没什么——",
            "narrator_zh": "（选项）"
        },
        {
            "location": "611/SEL",
            "narrator": "（選択肢）",
            "text": "超見たい！！！！",
            "zh": "超想看！！！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "612/SEL",
            "narrator": "（選択肢）",
            "text": "どうしてもって言うなら",
            "zh": "如果你非要这样说",
            "narrator_zh": "（选项）"
        },
        {
            "location": "613/ACT",
            "narrator": "",
            "text": "別にー",
            "zh": "没什么——",
            "narrator_zh": ""
        },
        {
            "location": "614/TALK",
            "narrator": "神楽",
            "text": "またまた",
            "zh": "才不信呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "615/TALK",
            "narrator": "神楽",
            "text": "やせ我慢しなくてもいいんですよっ",
            "zh": "不用嘴硬也没关系哦",
            "narrator_zh": "神乐"
        },
        {
            "location": "616/ACT",
            "narrator": "",
            "text": "超見たい！！！！",
            "zh": "超想看！！！！",
            "narrator_zh": ""
        },
        {
            "location": "619/TALK",
            "narrator": "神楽",
            "text": "正直ですね♪",
            "zh": "真坦率呀♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "620/ACT",
            "narrator": "",
            "text": "どうしてもって言うなら",
            "zh": "如果你非要这样说",
            "narrator_zh": ""
        },
        {
            "location": "621/TALK",
            "narrator": "神楽",
            "text": "もったいぶらなくても平気ですよ♪",
            "zh": "不用卖关子也没关系哦♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "623/TALK",
            "narrator": "神楽",
            "text": "それじゃアップの準備しますから、少しだけ待ってくださいね♪",
            "zh": "那我这就准备上传，稍微等我一下哦♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "634/TALK",
            "narrator": "神楽",
            "text": "なーんて言って、\nこのままシカトして\n寝ちゃったり――",
            "zh": "——才怪，\n要是我就这样装没看见\n直接睡过去——",
            "narrator_zh": "神乐"
        },
        {
            "location": "635/TALK",
            "narrator": "神楽",
            "text": "……したら、ちょっと\n意地悪すぎだよねー。",
            "zh": "……那样的话，\n就太坏心眼了呀——",
            "narrator_zh": "神乐"
        },
        {
            "location": "639/DIALOG",
            "narrator": "",
            "text": "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n　　　　　　To be continued !",
            "zh": "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n　　　　　　To be continued !",
            "narrator_zh": ""
        }
    ]
}
