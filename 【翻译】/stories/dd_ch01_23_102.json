            "narrator": "",
            "text": "そう言ってくれてよかった……",
            "zh": "你能这么说真是太好了……",
            "narrator_zh": ""
        },
        {
            "location": "959/TALK",
            "narrator": "つばめ",
            "text": "えと",
            "zh": "那个",
            "narrator_zh": "燕"
        },
        {
            "location": "960/TALK",
            "narrator": "つばめ",
            "text": "ごめんね",
            "zh": "对不起呀",
            "narrator_zh": "燕"
        },
        {
            "location": "962/TALK",
            "narrator": "つばめ",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "963/TALK",
            "narrator": "つばめ",
            "text": "わたし",
            "zh": "我",
            "narrator_zh": "燕"
        },
        {
            "location": "964/TALK",
            "narrator": "つばめ",
            "text": "本当は",
            "zh": "其实",
            "narrator_zh": "燕"
        },
        {
            "location": "965/TALK",
            "narrator": "つばめ",
            "text": "死にたくない",
            "zh": "不想死",
            "narrator_zh": "燕"
        },
        {
            "location": "966/TALK",
            "narrator": "つばめ",
            "text": "死にたくないよ",
            "zh": "我不想死呀",
            "narrator_zh": "燕"
        },
        {
            "location": "979/TALK",
            "narrator": "つばめ",
            "text": "ごめん…。\nごめんね、\n神楽ちゃん…。",
            "zh": "对不起……。\n对不起呀，\n神乐……。",
            "narrator_zh": "燕"
        },
        {
            "location": "981/TALK",
            "narrator": "つばめ",
            "text": "ごめんなさい、\n$handle$さん…。",
            "zh": "对不起，\n$handle$……。",
            "narrator_zh": "燕"
        },
        {
            "location": "982/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "985/TALK",
            "narrator": "つばめ",
            "text": "…ありがとう…、\n$handle$さん…。",
            "zh": "……谢谢你……，\n$handle$……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1005/TALK",
            "narrator": "つばめ",
            "text": "わぁ…。",
            "zh": "哇啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1010/TALK",
            "narrator": "つばめ",
            "text": "…綺麗な花火。",
            "zh": "……好漂亮的烟花。",
            "narrator_zh": "燕"
        },
        {
            "location": "1012/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "1024/TALK",
            "narrator": "つばめ",
            "text": "$handle$さん(´・ω・`) ",
            "zh": "$handle$(´・ω・`) ",
            "narrator_zh": "燕"
        },
        {
            "location": "1025/TALK",
            "narrator": "つばめ",
            "text": "わかる？",
            "zh": "能感受到吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "1026/TALK",
            "narrator": "つばめ",
            "text": "凄い花火だよ(*≧∀≦*) ",
            "zh": "是好厉害的烟花呀(*≧∀≦*) ",
            "narrator_zh": "燕"
        },
        {
            "location": "1028/SEL",
            "narrator": "",
            "text": "そうみたいだね",
            "zh": "好像是呀",
            "narrator_zh": ""
        },
        {
            "location": "1029/ACT",
            "narrator": "",
            "text": "そうみたいだね",
            "zh": "好像是呀",
            "narrator_zh": ""
        },
        {
            "location": "1031/TALK",
            "narrator": "つばめ",
            "text": "うん(*´︶`*)",
            "zh": "嗯(*´︶`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "1032/TALK",
            "narrator": "つばめ",
            "text": "とっても素敵で綺麗(´∀｀*)ｳﾌﾌ",
            "zh": "又好看又漂亮(´∀｀*)ｳﾌﾌ",
            "narrator_zh": "燕"
        },
        {
            "location": "1033/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "燕"
        },
        {
            "location": "1036/TALK",
            "narrator": "つばめ",
            "text": "さっき死んじゃってたら",
            "zh": "要是刚才死掉的话",
            "narrator_zh": "燕"
        },
        {
            "location": "1037/TALK",
            "narrator": "つばめ",
            "text": "見れなかったんだよね",
            "zh": "就看不到了呀",
            "narrator_zh": "燕"
        },
        {
            "location": "1040/TALK",
            "narrator": "つばめ",
            "text": "来年も",
            "zh": "明年也",
            "narrator_zh": "燕"
        },
        {
            "location": "1041/TALK",
            "narrator": "つばめ",
            "text": "また見に来たいな",
            "zh": "想再来看呀",
            "narrator_zh": "燕"
        },
        {
            "location": "1042/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんと(*´ω｀*)",
            "zh": "和$handle$一起(*´ω｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "1045/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんも一緒に",
            "zh": "还有神乐也一起",
            "narrator_zh": "燕"
        },
        {
            "location": "1047/SEL",
            "narrator": "",
            "text": "二人きりの方がいいな",
            "zh": "只有我们两个人更好哦",
            "narrator_zh": ""
        },
        {
            "location": "1048/SEL",
            "narrator": "",
            "text": "楽しみにしてるよ",
            "zh": "我很期待哦",
            "narrator_zh": ""
        },
        {
            "location": "1049/ACT",
            "narrator": "",
            "text": "二人きりの方がいいな",
            "zh": "只有我们两个人更好哦",
            "narrator_zh": ""
        },
        {
            "location": "1050/ACT",
            "narrator": "",
            "text": "楽しみにしてるよ",
            "zh": "我很期待哦",
            "narrator_zh": ""
        },
        {
            "location": "1052/TALK",
            "narrator": "つばめ",
            "text": "うん(*´︶`*)",
            "zh": "嗯(*´︶`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "1053/TALK",
            "narrator": "つばめ",
            "text": "叶えるために",
            "zh": "为了实现约定",
            "narrator_zh": "燕"
        },
        {
            "location": "1054/TALK",
            "narrator": "つばめ",
            "text": "わたし",
            "zh": "我",
            "narrator_zh": "燕"
        },
        {
            "location": "1055/TALK",
            "narrator": "つばめ",
            "text": "頑張る！(๑･ㅂ･)و☆",
            "zh": "会加油的！(๑･ㅂ･)و☆",
            "narrator_zh": "燕"
        },
        {
            "location": "1066/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "1070/TALK",
            "narrator": "つばめ",
            "text": "…来年も、絶対に\n見にこよう…。",
            "zh": "……明年也，一定\n要来看……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1073/SEL",
            "narrator": "",
            "text": "端末操作：雛へ通話",
            "zh": "终端操作：致电雏",
            "narrator_zh": ""
        },
        {
            "location": "1074/ACT",
            "narrator": "",
            "text": "端末操作：雛へ通話",
            "zh": "终端操作：致电雏",
            "narrator_zh": ""
        },
        {
            "location": "1079/TALK",
            "narrator": "雛",
            "text": "もしもし？",
            "zh": "喂？",
            "narrator_zh": "雏"
        },
        {
            "location": "1080/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "1081/TALK",
            "narrator": "雛",
            "text": "つばめちゃん？\nおーい、もしもーし！",
            "zh": "燕？\n喂——，听得到吗——！",
            "narrator_zh": "雏"
        },
        {
            "location": "1082/TALK",
            "narrator": "つばめ",
            "text": "…あ、あれ？",
            "zh": "……哎、哎？",
            "narrator_zh": "燕"
        },
        {
            "location": "1085/TALK",
            "narrator": "雛",
            "text": "もしもーし！",
            "zh": "喂——！",
            "narrator_zh": "雏"
        },
        {
            "location": "1086/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃん！？\nえ、でもどうして、\n勝手に…。",
            "zh": "小雏！？\n哎，可为什么，\n自己就……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1087/TALK",
            "narrator": "雛",
            "text": "あれ？　もしかして\n間違ってかけちゃった\n感じ？",
            "zh": "咦？　难道是\n不小心\n按错拨出去了？",
            "narrator_zh": "雏"
        },
        {
            "location": "1088/TALK",
            "narrator": "つばめ",
            "text": "…もしかして、\n$handle$さんが\nかけたのかな？",
            "zh": "……难道是\n$handle$\n拨的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "1089/TALK",
            "narrator": "雛",
            "text": "つばめちゃん？",
            "zh": "燕？",
            "narrator_zh": "雏"
        },
        {
            "location": "1091/TALK",
            "narrator": "つばめ",
            "text": "あ、うん。\n間違っちゃったの、\nごめんね。",
            "zh": "啊，嗯。\n按错了呀，\n对不起哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "1092/TALK",
            "narrator": "雛",
            "text": "あはは、つばめちゃん\nらしいなー。",
            "zh": "啊哈哈，很有燕的\n风格呀——。",
            "narrator_zh": "雏"
        },
        {
            "location": "1093/TALK",
            "narrator": "雛",
            "text": "そういえば、前にも\n一度あったよね？",
            "zh": "说起来，以前\n也有过一次吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "1094/TALK",
            "narrator": "雛",
            "text": "すっごい朝早くに、\n寝ぼけてかけて\nきちゃったこと。",
            "zh": "大清早的，\n迷迷糊糊打过来\n那次。",
            "narrator_zh": "雏"
        },
        {
            "location": "1095/TALK",
            "narrator": "つばめ",
            "text": "あ、あの時は\n本当にごめんね…。",
            "zh": "啊、那次\n真是对不起呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1096/TALK",
            "narrator": "つばめ",
            "text": "携帯の目覚まし止める\nつもりが、ひなこちゃんに\n電話しちゃって…。",
            "zh": "本来想关掉手机闹钟的，\n结果给小雏\n拨出去了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1097/TALK",
            "narrator": "雛",
            "text": "いいのいいのー。\nそういうのって\nあるあるだし。",
            "zh": "没事没事啦——。\n那种事\n常有的嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "1098/TALK",
            "narrator": "つばめ",
            "text": "…ふふっ。\nそう言ってもらえると\n安心するよ…。",
            "zh": "……呵呵。\n听你这么说\n我就放心了呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1099/TALK",
            "narrator": "雛",
            "text": "うん…。",
            "zh": "嗯……。",
            "narrator_zh": "雏"
        },
        {
            "location": "1100/TALK",
            "narrator": "つばめ",
            "text": "…………？\nひなこちゃん？",
            "zh": "…………？\n小雏？",
            "narrator_zh": "燕"
        },
        {
            "location": "1101/TALK",
            "narrator": "雛",
            "text": "あ、ごめんごめん。\nちょっと、その…。",
            "zh": "啊，抱歉抱歉。\n稍微，那个……。",
            "narrator_zh": "雏"
        },
        {
            "location": "1102/TALK",
            "narrator": "雛",
            "text": "ほら、あたし達が\n東京に帰った日のこと、\n覚えてる？",
            "zh": "你看，我们\n回东京那天的事，\n还记得吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "1103/TALK",
            "narrator": "雛",
            "text": "つばめちゃん、\n駅まで見送りに\n来てくれたでしょ？",
            "zh": "燕你呀，\n还专门跑到车站\n来送我们了吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "1104/TALK",
            "narrator": "つばめ",
            "text": "うん…。",
            "zh": "嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1105/TALK",
            "narrator": "雛",
            "text": "あの時ね、\nすっごく嬉しかったよ。",
            "zh": "那时候啊，\n我真的超级高兴哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "1106/TALK",
            "narrator": "雛",
            "text": "けど…、同じくらい、\nすっごく寂しく\nなっちゃったんだ。",
            "zh": "可是……，高兴的同时，\n也变得超级\n寂寞了。",
            "narrator_zh": "雏"
        },
        {
            "location": "1107/TALK",
            "narrator": "雛",
            "text": "つばめちゃんが\n東京に帰ってくるまで、\n会えないんだな、って…。",
            "zh": "想着一直到燕\n回东京为止，\n都见不到面了啊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "1108/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "1109/TALK",
            "narrator": "雛",
            "text": "だから、つばめちゃんの\n声が聞けて、\nすっごく嬉しいよー！",
            "zh": "所以，能听到燕的\n声音，\n真的好开心呀——！",
            "narrator_zh": "雏"
        },
        {
            "location": "1110/TALK",
            "narrator": "雛",
            "text": "間違いに感謝だねー。",
            "zh": "得好好感谢这次拨错呀——。",
            "narrator_zh": "雏"
        },
        {
            "location": "1111/TALK",
            "narrator": "つばめ",
            "text": "…ひなこちゃん。",
            "zh": "……小雏。",
            "narrator_zh": "燕"
        },
        {
            "location": "1112/TALK",
            "narrator": "雛",
            "text": "それで？　こっちには\nいつ帰ってくるの？",
            "zh": "然后呢？　你什么时候\n回这边来呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "1113/TALK",
            "narrator": "つばめ",
            "text": "…今日の夜には。\n今、横須賀に\n寄り道してるけど…。",
            "zh": "……今天晚上就回。\n现在虽然顺道停在\n横须贺……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1114/TALK",
            "narrator": "雛",
            "text": "うわ、マジ！？\n何そのサプライズ！！",
            "zh": "哇，真的假的！？\n什么惊喜啊这是！！",
            "narrator_zh": "雏"
        },
        {
            "location": "1115/TALK",
            "narrator": "雛",
            "text": "じゃあ、明日には\nつばめちゃんと会えるね。",
            "zh": "那明天就能\n见到燕啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "1116/TALK",
            "narrator": "つばめ",
            "text": "…うん。",
            "zh": "……嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "1117/TALK",
            "narrator": "雛",
            "text": "キリトもヒカルくんも\nまゆちんも、\nみんな待ってるよ。",
            "zh": "圣翔、光、\n还有小茧，\n大家都在等着你哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "1118/TALK",
            "narrator": "雛",
            "text": "だから寄り道しないで、\nちゃんと帰ってきてね。\nおっけー？",
            "zh": "所以别再绕远路了，\n乖乖回来哦。\nOK？",
            "narrator_zh": "雏"
        },
        {
            "location": "1120/TALK",
            "narrator": "つばめ",
            "text": "…うん。\nちゃんと帰るよ。",
            "zh": "……嗯。\n我会好好回去的。",
            "narrator_zh": "燕"
        },
        {
            "location": "1121/TALK",
            "narrator": "雛",
            "text": "よかったー。",
            "zh": "太好了——。",
            "narrator_zh": "雏"
        },
        {
            "location": "1122/TALK",
            "narrator": "雛",
            "text": "それじゃ、\nまた明日ねー。",
            "zh": "那就，\n明天见啦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "1123/TALK",
            "narrator": "つばめ",
            "text": "うん…。\nありがと…。",
            "zh": "嗯……。\n谢谢你……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1129/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "1130/TALK",
            "narrator": "つばめ",
            "text": "不思議だな…。\nなんでなんだろ？",
            "zh": "好不可思议呀……。\n这是为什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "1132/TALK",
            "narrator": "つばめ",
            "text": "ついさっきまで、\nあんなに死にたいって\n思ってたのに。",
            "zh": "明明直到刚才，\n还那么一心\n想去死来着。",
            "narrator_zh": "燕"
        },
        {
            "location": "1133/TALK",
            "narrator": "つばめ",
            "text": "今は、わたし…、\n死にたくないと\n思ってる…。",
            "zh": "现在，我……、\n觉得不想死了\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1134/TALK",
            "narrator": "つばめ",
            "text": "…死にたくない。\n死にたくないよ…。",
            "zh": "……不想死。\n我不想死呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1135/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃん達に\n会いたい…。",
            "zh": "好想见小雏\n她们……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1136/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんとも、\nもっといっぱい\n一緒にいたい。",
            "zh": "也想和神乐\n一起待上\n好久好久。",
            "narrator_zh": "燕"
        },
        {
            "location": "1137/TALK",
            "narrator": "つばめ",
            "text": "わたし…、\n死にたくないよぉ…。",
            "zh": "我……、\n不想死呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1157/TALK",
            "narrator": "つばめ",
            "text": "わぁ…。",
            "zh": "哇啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1161/TALK",
            "narrator": "つばめ",
            "text": "…綺麗な花火。",
            "zh": "……好漂亮的烟花。",
            "narrator_zh": "燕"
        },
        {
            "location": "1162/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "1163/TALK",
            "narrator": "つばめ",
            "text": "でも、やっぱり\n一人で見るのは、\nちょっと寂しいな…。",
            "zh": "不过，果然\n一个人看，\n还是有点寂寞呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1164/SEL",
            "narrator": "",
            "text": "$me$はいつも一緒だよ",
            "zh": "$me$一直都和你在一起哦",
            "narrator_zh": ""
        },
        {
            "location": "1165/ACT",
            "narrator": "",
            "text": "$me$はいつも一緒だよ",
            "zh": "$me$一直都和你在一起哦",
            "narrator_zh": ""
        },
        {
            "location": "1182/TALK",
            "narrator": "つばめ",
            "text": "そうだね",
            "zh": "是呀",
            "narrator_zh": "燕"
        },
        {
            "location": "1183/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃんに電話してくれてぁりがとぉ",
            "zh": "谢谢你帮我给小雏打电话",
            "narrator_zh": "燕"
        },
        {
            "location": "1187/TALK",
            "narrator": "つばめ",
            "text": "次は",
            "zh": "下一次",
            "narrator_zh": "燕"
        },
        {
            "location": "1188/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんととなり同士で花火見られるとぃぃな",
            "zh": "要是能和$handle$并肩一起看烟花就好了呀",
            "narrator_zh": "燕"
        },
        {
            "location": "1189/TALK",
            "narrator": "つばめ",
            "text": "これからもずっと",
            "zh": "今后也一直",
            "narrator_zh": "燕"
        },
        {
            "location": "1190/TALK",
            "narrator": "つばめ",
            "text": "一緒にぃてね",
            "zh": "陪在我身边哦",
            "narrator_zh": "燕"
        },
        {
            "location": "1203/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1204/TALK",
            "narrator": "つばめ",
            "text": "来年の花火大会は、\nひなこちゃん達も誘って、\n大勢で見に来たいな。",
            "zh": "明年的烟花大会，\n也叫上小雏她们，\n想大家一起热闹来看呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "1205/TALK",
            "narrator": "つばめ",
            "text": "それに…その時は\n神楽ちゃんも\n一緒に…。",
            "zh": "而且……到时候\n神乐也\n一起……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1210/TALK",
            "narrator": "つばめ",
            "text": "…死にたいなんて、\n言ってられないよね。",
            "zh": "……可不能再说什么\n想死之类的话了呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "1212/TALK",
            "narrator": "つばめ",
            "text": "絶対、来年もこの花火を\n見にこよう…。",
            "zh": "明年也一定要来看\n这片烟花……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1213/TALK",
            "narrator": "つばめ",
            "text": "みんなで…絶対に…。",
            "zh": "大家一起……一定要……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1226/DIALOG",
            "narrator": "Dialog_chapter_ch01",
            "text": "【19 三戸浜からの手紙】",
            "zh": "【19 来自三户滨的信】",
            "narrator_zh": "Dialog_chapter_ch01"
        }
    ]
}
