{
    "dir": "chap00/daydra/spev_ch04_009.js",
    "type": "",
    "info": {
        "story_id": "4009",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "太陽とPCと",
        "title_zh": "特别篇",
        "sub_title_zh": "太阳与PC与"
    },
    "entry": [
        {
            "location": "29/TALK",
            "narrator": "透明みやび",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "30/TALK",
            "narrator": "透明みやび",
            "text": "砂浜でＰＣ弄くる\nっちゅうのも、\n悪くないもんやね。",
            "zh": "在沙滩上鼓捣\nPC这事嘛，\n倒也不赖咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "32/TALK",
            "narrator": "透明みやび",
            "text": "相棒もそう思わんか？",
            "zh": "搭档你不这么觉得咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "33/SEL",
            "narrator": "（選択肢）",
            "text": "潮風でＰＣ壊れるよ？",
            "zh": "海风会把PC吹坏的哦？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "34/SEL",
            "narrator": "（選択肢）",
            "text": "海に来てまでなぜＰＣ？",
            "zh": "都来海边了干嘛还要用PC？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "35/ACT",
            "narrator": "",
            "text": "潮風でＰＣ壊れるよ？",
            "zh": "海风会把PC吹坏的哦？",
            "narrator_zh": ""
        },
        {
            "location": "37/TALK",
            "narrator": "透明みやび",
            "text": "安心安全の精神世界やき、\n心配無用や。",
            "zh": "这里是安全放心的精神世界啵，\n用不着操心。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "39/TALK",
            "narrator": "透明みやび",
            "text": "っちゅうか、うちだって\n海に来たかったわけや\nないぞね。",
            "zh": "话说回来，我原本\n也并不是多想来\n海边咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "40/ACT",
            "narrator": "",
            "text": "海に来てまでなぜＰＣ？",
            "zh": "都来海边了干嘛还要用PC？",
            "narrator_zh": ""
        },
        {
            "location": "42/TALK",
            "narrator": "透明みやび",
            "text": "別にうちが来たくて\n来たわけやないちや。",
            "zh": "我又不是自己\n想来才来的滴。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "44/TALK",
            "narrator": "透明みやび",
            "text": "みんなが海行く言うて、\n無理矢理付き合わされて\n来ただけや。",
            "zh": "大家伙儿说要去海边，\n硬把我也拽过来\n陪着罢了。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "45/TALK",
            "narrator": "透明みやび",
            "text": "まったく…海なんぞ、\n塩辛いだけの超巨大な\n水溜まりやっちゅうに。",
            "zh": "真是的……海算驷马嘛，\n说白了不就是一摊\n又咸又大的水坑么。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "47/TALK",
            "narrator": "透明みやび",
            "text": "なにが楽しくて\n夢中になれるんか、\n理解に苦しむちや。",
            "zh": "到底哪点好玩、\n值得这么着迷，\n真是搞不懂滴。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "48/SEL",
            "narrator": "（選択肢）",
            "text": "みやびも少しは海を楽しもう",
            "zh": "雅也稍微享受一下大海吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "49/SEL",
            "narrator": "（選択肢）",
            "text": "じゃあ、$me$と楽しもう",
            "zh": "那，就和$me$一起玩吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "50/ACT",
            "narrator": "",
            "text": "みやびも少しは海を楽しもう",
            "zh": "雅也稍微享受一下大海吧",
            "narrator_zh": ""
        },
        {
            "location": "53/TALK",
            "narrator": "透明みやび",
            "text": "海に来ている。",
            "zh": "我人在海边。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "54/TALK",
            "narrator": "透明みやび",
            "text": "そして水着を着ている。",
            "zh": "而且穿着泳衣。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "56/TALK",
            "narrator": "透明みやび",
            "text": "これで十分やろ？",
            "zh": "这还不够咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "57/TALK",
            "narrator": "透明みやび",
            "text": "まあ、水着はピッチリして\n息苦しいのが欠点なんや\nけんど…。",
            "zh": "嘛，泳衣紧绷绷的\n喘不过气这点是\n缺点，但是……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "58/TALK",
            "narrator": "透明みやび",
            "text": "なのでうちは水着の上を\n外して自由になるという\n結論に辿り着いたわけや。",
            "zh": "所以我便得出了\n干脆解开泳衣上装\n重获自由的结论咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "59/ACT",
            "narrator": "",
            "text": "じゃあ、$me$と楽しもう",
            "zh": "那，就和$me$一起玩吧",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "透明みやび",
            "text": "そう言うてくれるのを\n待っちょったがよ。",
            "zh": "就等着你\n说这句话咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "62/TALK",
            "narrator": "透明みやび",
            "text": "さすがにうちもな、\n海に来てまでＰＣは\nどうかと思うてたき。",
            "zh": "老实说连我自己，\n都觉得大老远来海边还抱个PC\n有点不像话啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "63/TALK",
            "narrator": "透明みやび",
            "text": "…で、なにをして楽しむ？",
            "zh": "……那么，玩驷马好呢？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "64/SEL",
            "narrator": "（選択肢）",
            "text": "海らしいことをして、かな？",
            "zh": "做些有海边特色的事，之类的？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "65/ACT",
            "narrator": "",
            "text": "海らしいことをして、かな？",
            "zh": "做些有海边特色的事，之类的？",
            "narrator_zh": ""
        },
        {
            "location": "69/TALK",
            "narrator": "透明みやび",
            "text": "今のうち、ぶっちゃけ\n半裸状態や。",
            "zh": "实话实说，我现在\n正处于半裸状态咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "71/TALK",
            "narrator": "透明みやび",
            "text": "サービスショットやろ？\nスクショ撮るんは自由や\nけんどな…。",
            "zh": "够福利镜头了吧？\n截屏随你的便，\n不过嘛……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "72/TALK",
            "narrator": "透明みやび",
            "text": "お題は高いホテルの\nデザートブッフェくらいは\nいただくぞね？",
            "zh": "价钱起码得收个\n高档酒店的甜品自助餐，\n我才认账咧？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "73/SEL",
            "narrator": "（選択肢）",
            "text": "なかなか高いよね",
            "zh": "还挺贵的呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "74/SEL",
            "narrator": "（選択肢）",
            "text": "一緒に行く？",
            "zh": "要一起去吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "75/ACT",
            "narrator": "",
            "text": "なかなか高いよね",
            "zh": "还挺贵的呢",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "透明みやび",
            "text": "とほほ、うちの半裸は\nデザートブッフェ以下か。",
            "zh": "呜呼哀哉，我的半裸\n还比不上甜品自助餐咩。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "79/TALK",
            "narrator": "透明みやび",
            "text": "けんど、高いと言われては\n諦めるしかないなぁ…。",
            "zh": "但是，你都嫌贵了\n那我也只好死心了……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "80/ACT",
            "narrator": "",
            "text": "一緒に行く？",
            "zh": "要一起去吗？",
            "narrator_zh": ""
        },
        {
            "location": "82/TALK",
            "narrator": "透明みやび",
            "text": "まあ、一人で行っても\n楽しくはないやろうし。",
            "zh": "嘛，一个人去\n也没驷马意思就是了。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "83/TALK",
            "narrator": "透明みやび",
            "text": "とはいえ、デザート\nブッフェとはいえ\n言い換えれば食い放題。",
            "zh": "话虽这么说，甜品\n自助餐说穿了\n还不是放开肚皮随便吃。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "84/TALK",
            "narrator": "透明みやび",
            "text": "そんなところへデートで\n行くっちゅうのは、\nどうなんや？",
            "zh": "约会跑去\n那种地方吃喝，\n像话咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "86/TALK",
            "narrator": "透明みやび",
            "text": "…うむ、よろしくない\nような気がしてきた。",
            "zh": "……嗯，总觉得\n好像不太妙起来了。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "87/TALK",
            "narrator": "透明みやび",
            "text": "今の話は無しや。\nブッフェ無し。\n半裸撮影もなし。",
            "zh": "刚才的话作废咯。\n自助餐取消。\n半裸拍摄也取消。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "89/TALK",
            "narrator": "透明みやび",
            "text": "…ちゅうか、海に来て\nデザートブッフェの話とか\nどうなんや？",
            "zh": "……话说回来，人都来海边了\n还聊什么甜品自助餐，\n像话咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "90/TALK",
            "narrator": "透明みやび",
            "text": "これこそ海を楽しんでる\nとは言えん行為やな…。",
            "zh": "这才是真叫人没法说\n是在享受大海的行为啊……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "91/TALK",
            "narrator": "透明みやび",
            "text": "…仕方ない、奥の手や。",
            "zh": "……没办法，使出杀手锏咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "92/TALK",
            "narrator": "透明みやび",
            "text": "相棒、実はすぐそこに\nサンオイルなんぞも\n用意してあるのだが…。",
            "zh": "搭档，其实我就在旁边\n还准备了助晒油\n之类的玩意……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "94/TALK",
            "narrator": "透明みやび",
            "text": "どうする？\nうちにヌリヌリして\nみたい思うちょる？",
            "zh": "咋样？\n想不想在我身上\n滑溜溜地抹上一遍？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "95/SEL",
            "narrator": "（選択肢）",
            "text": "もちろん！",
            "zh": "当然！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "96/SEL",
            "narrator": "（選択肢）",
            "text": "したいが、できない！",
            "zh": "想做，可做不到啊！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "97/ACT",
            "narrator": "",
            "text": "もちろん！",
            "zh": "当然！",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "透明みやび",
            "text": "まっこと、\n欲望に忠実なヤツやねぇ。",
            "zh": "真是的，\n你这蛮忠于欲望的家伙咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "100/TALK",
            "narrator": "透明みやび",
            "text": "そういう直球なとこ、\n嫌いやないがよ。",
            "zh": "这种直来直去的劲头，\n我倒是不讨厌咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "102/TALK",
            "narrator": "透明みやび",
            "text": "…いや、むしろ\n気に入っちょるところ\nかもしれん…。",
            "zh": "……不，说不定\n我还蛮中意你\n这一点呢……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "103/TALK",
            "narrator": "透明みやび",
            "text": "…とにかく、決まりや。\nこのサンオイルを\nうちに塗りたくり…。",
            "zh": "……总之，就这么定咯。\n把这助晒油\n往我身上可劲抹……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "104/ACT",
            "narrator": "",
            "text": "したいが、できない！",
            "zh": "想做，可做不到啊！",
            "narrator_zh": ""
        },
        {
            "location": "106/TALK",
            "narrator": "透明みやび",
            "text": "なんや？　別にそれくらい\nしても…。",
            "zh": "搞驷马嘛？　这点小事\n做一下倒也……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "108/TALK",
            "narrator": "透明みやび",
            "text": "…いや、ちくっと\n冷静にならんとな。",
            "zh": "……不对，得稍微\n冷静下来才行啊。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "109/TALK",
            "narrator": "透明みやび",
            "text": "さすがに、それは\nサービスし過ぎな気が\nしてきたちや。",
            "zh": "细想一下，那也\n未免有点太发福利\n过头了滴。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "110/TALK",
            "narrator": "透明みやび",
            "text": "うちは相棒からは\nなにも貰っちょらん\nっちゅうのに…。",
            "zh": "我明明从搭档这儿\n还驷马甜头都没\n捞着呢……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "111/TALK",
            "narrator": "透明みやび",
            "text": "相棒にばかり美味しい想い\nさせるっちゅうのは、\n不公平や。",
            "zh": "光让搭档一个人\n占这种美差，\n太不公平咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "113/TALK",
            "narrator": "透明みやび",
            "text": "なので…おっ、\nえいところに…。",
            "zh": "所以嘛……哦，\n来得正好……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "115/TALK",
            "narrator": "透明みやび",
            "text": "つばめちゃーん。\nちくっとこっち\nおいでやー。",
            "zh": "燕——。\n等子过来这边\n一下咧——。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "119/TALK",
            "narrator": "透明つばめ",
            "text": "はい。\nどうしたんですか？",
            "zh": "好呀。\n怎么了吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "120/TALK",
            "narrator": "透明みやび",
            "text": "うむ…実はサンオイルを\n塗ろうと思うちょるん\nやけんど…。",
            "zh": "嗯……其实我是打算\n抹点助晒油来着，\n但是……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "121/TALK",
            "narrator": "透明みやび",
            "text": "相棒に濡らせるんは、\nちくっとサービスの\nし過ぎや思うてな。",
            "zh": "让搭档来给我抹的话，\n觉得稍微有点\n太便宜你了。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "122/TALK",
            "narrator": "透明みやび",
            "text": "代わりに、つばめちゃんに\n塗ってもらおうと\n思うたわけちや。",
            "zh": "所以我就想着，\n干脆让燕来帮我\n抹上算了滴。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "123/TALK",
            "narrator": "透明つばめ",
            "text": "えっと…、\nよくはわからないん\nですけど…。",
            "zh": "那个……，\n虽然不太明白\n是怎么回事……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "124/TALK",
            "narrator": "透明つばめ",
            "text": "とにかく、わたしが\nみやびさんにサンオイルを\n塗ればいいんですね？",
            "zh": "总之，只要我帮\n雅涂上助晒油\n就可以了对吧？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "125/TALK",
            "narrator": "透明みやび",
            "text": "そういうことや…。\nお願いしてえい？",
            "zh": "就是这么回事……。\n能拜托你咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "127/TALK",
            "narrator": "透明つばめ",
            "text": "はい、それくらいなら\n任せてください！",
            "zh": "好呀，这种小事\n交给我吧！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "128/TALK",
            "narrator": "透明つばめ",
            "text": "みやびさんの背中、\nサンオイルをたっぷり\n塗っちゃいますね！",
            "zh": "雅的后背，\n我给你满满当当地\n涂上助晒油哦！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "130/TALK",
            "narrator": "透明みやび",
            "text": "…ほ、ほどほどにな？\nさすがにびしょ濡れは\n勘弁やき…。",
            "zh": "……适、适可而止啊？\n要是抹得油腻腻湿哒哒\n我可吃不消啵……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "131/TALK",
            "narrator": "透明つばめ",
            "text": "えーっと、それじゃあ\nどこから始めようかなぁ？",
            "zh": "唔——，那我\n从哪里开始涂好呀？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "132/SEL",
            "narrator": "（選択肢）",
            "text": "お尻の方にたっぷり丁寧に",
            "zh": "在屁股那边仔细多抹点",
            "narrator_zh": "（选项）"
        },
        {
            "location": "133/SEL",
            "narrator": "（選択肢）",
            "text": "うなじから背筋に沿って",
            "zh": "从后颈顺着脊背往下涂",
            "narrator_zh": "（选项）"
        },
        {
            "location": "134/ACT",
            "narrator": "",
            "text": "お尻の方にたっぷり丁寧に",
            "zh": "在屁股那边仔细多抹点",
            "narrator_zh": ""
        },
        {
            "location": "135/TALK",
            "narrator": "透明つばめ",
            "text": "お尻を丁寧に…？\nあ、そういうことか！",
            "zh": "仔细涂屁股……？\n啊，原来是这样啊！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "136/TALK",
            "narrator": "透明つばめ",
            "text": "それじゃ、みやびさん。\n始めますねー。",
            "zh": "那，雅。\n我开始啦——。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "138/TALK",
            "narrator": "透明みやび",
            "text": "うむ、頼むがよ。",
            "zh": "嗯，拜托你咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "143/TALK",
            "narrator": "透明みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "144/TALK",
            "narrator": "透明つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "150/TALK",
            "narrator": "透明みやび",
            "text": "え、えっと…、\nつばめちゃん？",
            "zh": "那、那个……，\n燕？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "152/TALK",
            "narrator": "透明みやび",
            "text": "なんか、やたらと丁寧に\n尻を揉んどるみたい\nやけんど…。",
            "zh": "怎么感觉你好像\n特别起劲地在揉我\n屁股，但是……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "153/TALK",
            "narrator": "透明つばめ",
            "text": "はい！\nお尻は普段、陽の光が\n当たらない場所でしょ？",
            "zh": "是呀！\n屁股平时不是\n晒不到太阳的地方嘛？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "154/TALK",
            "narrator": "透明つばめ",
            "text": "だから、その分たっぷり、\n丁寧に塗り込めって、\n$handle$さんが。",
            "zh": "所以才要更足量、\n更仔细地揉进去，\n$handle$这么说的。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "155/TALK",
            "narrator": "透明みやび",
            "text": "あ、あいつ…、\nそんなアホなこと\n頼みよって…。",
            "zh": "那、那家伙……，\n竟敢交代这种\n蠢到家的事……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "159/TALK",
            "narrator": "透明つばめ",
            "text": "きゃっ！？",
            "zh": "呀！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "162/TALK",
            "narrator": "透明みやび",
            "text": "ちょぉぉぉぉ！？\nつばめちゃん、ヤバい！\n水着の中はヤバいぞね！",
            "zh": "等——等下啊！？\n燕，不妙！\n泳衣里面绝对不妙咧！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "163/TALK",
            "narrator": "透明つばめ",
            "text": "ご、ごめんなさい！\nオイルで指が滑って、\n水着の中に…。",
            "zh": "对、对不起！\n油太滑手指溜进\n泳衣里面去了……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "165/TALK",
            "narrator": "透明つばめ",
            "text": "あ、あれ？\n水着に指が\n絡まっちゃってる！？",
            "zh": "咦、咦？\n手指被泳衣\n缠住了！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "166/TALK",
            "narrator": "透明みやび",
            "text": "え、えいから、\n落ち着いてゆっくり\n指外しぃ。",
            "zh": "没、没事得啦，\n先稳住慢慢地\n把手指抽出来。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "167/TALK",
            "narrator": "透明つばめ",
            "text": "だ、大丈夫です。\nこうやって、おもいっきり\n引っ張ればー！",
            "zh": "没、没关系的。\n像这样使劲\n往外一拽——！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "169/TALK",
            "narrator": "透明みやび",
            "text": "ちょちょちょ、いかん、\nマジでそれはいかん！",
            "zh": "等等等、不行，\n那真使不得啊！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "170/TALK",
            "narrator": "透明みやび",
            "text": "食い込みまくりやき、\n乱暴はいかんって！",
            "zh": "已经勒得死紧了啵，\n别那么粗鲁啊！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "171/TALK",
            "narrator": "透明つばめ",
            "text": "あわわ、ごめんなさい！",
            "zh": "啊哇哇，对不起！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "174/TALK",
            "narrator": "透明みやび",
            "text": "…やはり、海なんぞ\n来るべきやなかった…。",
            "zh": "……果然，大海这种地方\n打一开始就不该来……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "175/ACT",
            "narrator": "",
            "text": "うなじから背筋に沿って",
            "zh": "从后颈顺着脊背往下涂",
            "narrator_zh": ""
        },
        {
            "location": "176/TALK",
            "narrator": "透明つばめ",
            "text": "…背筋に沿ってだったら、\n指先じゃないと\nダメだよね。",
            "zh": "……顺着脊背的话，\n不用指尖\n不行呢。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "177/TALK",
            "narrator": "透明つばめ",
            "text": "よーし、それじゃあ、\n失礼します。",
            "zh": "好——，那我\n失礼了。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "179/TALK",
            "narrator": "透明みやび",
            "text": "よろしく頼むぞね。",
            "zh": "麻烦你多关照咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "188/TALK",
            "narrator": "透明みやび",
            "text": "んぃっ！？",
            "zh": "唔咿！？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "189/TALK",
            "narrator": "透明つばめ",
            "text": "うなじから、腰に向かって\nゆっくりと…。",
            "zh": "从后颈，往腰那里\n慢慢地……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "190/TALK",
            "narrator": "透明みやび",
            "text": "ちょっ、つ、つば、\nつばめちゃん、\nストップ、ストップや！",
            "zh": "等下、燕、\n燕呀，\n停、快停下！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "191/TALK",
            "narrator": "透明つばめ",
            "text": "あ、はい…。\nどうしたんですか？",
            "zh": "啊，好……。\n怎么了吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "192/TALK",
            "narrator": "透明みやび",
            "text": "いや…なんちゅうかな、\n背筋なぞられると\nゾゾッとくるんやけんど？",
            "zh": "不是……咋说呢，\n被人顺着脊背这么划拉\n浑身直发麻啊，但是？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "193/TALK",
            "narrator": "透明つばめ",
            "text": "でも、\n$handle$さんが\nそうしろって…。",
            "zh": "可是，\n$handle$让我\n这么做的……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "194/TALK",
            "narrator": "透明みやび",
            "text": "なっ！？\n$handle$のヤツ、\nなんちゅうことを…！",
            "zh": "驷马！？\n$handle$这家伙，\n居然出这种鬼主意……！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "195/TALK",
            "narrator": "透明つばめ",
            "text": "えっと、たっぷりと\n塗るんでしたよね？",
            "zh": "那个，是要多多地\n涂上对吧？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "196/TALK",
            "narrator": "透明つばめ",
            "text": "それじゃ、あと五回は\n往復させますよー。",
            "zh": "那，还要再\n来回涂五次哦——。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "198/TALK",
            "narrator": "透明みやび",
            "text": "五回！？　ちょっと、\nつば、め、ひぁっ！？",
            "zh": "五次！？　等下、\n燕、呀啊！？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "200/TALK",
            "narrator": "透明みやび",
            "text": "んっ、あっ、うぅっ…。",
            "zh": "唔、啊、呜……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "201/TALK",
            "narrator": "透明つばめ",
            "text": "あと３往復ですよー。",
            "zh": "还剩3个来回哦——。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "204/TALK",
            "narrator": "透明みやび",
            "text": "…サンオイルなんぞ、\n用意するんやなかった…。",
            "zh": "……助晒油这种东西，\n早知道就不该准备……。",
            "narrator_zh": "透明雅"
        }
    ]
}
