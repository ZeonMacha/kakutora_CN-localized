        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "今忙しいのだが",
            "zh": "我现在正忙着",
            "narrator_zh": "雅"
        },
        {
            "location": "109/TALK",
            "narrator": "みやび",
            "text": "忙しく見えなくても忙しいということを、日々肝に免じておいて欲しいのだが",
            "zh": "就算看起来不忙其实也很忙这件事，希望你每天都铭记在心",
            "narrator_zh": "雅"
        },
        {
            "location": "115/SEL",
            "narrator": "",
            "text": "プレゼントあるよ",
            "zh": "有礼物哦",
