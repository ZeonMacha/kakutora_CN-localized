        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "なんぞbotからか！",
            "zh": "驷马，居然是bot发来的咩！",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "あやかしい機能ついちょるな",
            "zh": "装着这么个可疑的功能咯",
            "narrator_zh": "雅"
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "む？",
            "zh": "唔？",
