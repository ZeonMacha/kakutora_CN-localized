 "dir": "chap07/battle/btev_ch01_07_02.js",
 "type": "",
 "info": {
  "story_id": "21012",
  "cid": "",
  "title": "012 ココロスフィアストーリー【Lv04】",
  "sub_title": "仁王門＜帰結＞",
  "title_zh": "012 心灵领域故事【Lv04】",
  "sub_title_zh": "仁王门＜归结＞"
 },
 "entry": [
  {
   "location": "145/SCENARIO",
   "narrator": "",
   "text": "仁王門",
   "zh": "仁王门",
   "narrator_zh": ""
  },
  {
   "location": "156/TALK",
   "narrator": "啓介",
   "text": "…まさか\n私のパワーに\n勝るとはな。",
   "zh": "……没想到\n你的力量\n竟胜过我。",
   "narrator_zh": "启介"
  },
  {
   "location": "158/TALK",
   "narrator": "啓介",
   "text": "だがよいか！",
   "zh": "但是你听好！",
   "narrator_zh": "启介"
  },
  {
   "location": "159/TALK",
   "narrator": "啓介",
   "text": "あー……",
   "zh": "啊——……",
   "narrator_zh": "启介"
  },
  {
   "location": "161/SEL",
   "narrator": "（選択肢）",
   "text": "あ、$handle$です",
   "zh": "啊，我是$handle$",
   "narrator_zh": "（选项）"
  },
  {
   "location": "162/ACT",
   "narrator": "",
   "text": "あ、$handle$です",
   "zh": "啊，我是$handle$",
   "narrator_zh": ""
  },
  {
   "location": "164/TALK",
   "narrator": "啓介",
   "text": "ふむ、ありがとう。",
   "zh": "嗯，谢谢。",
   "narrator_zh": "启介"
  },
  {
   "location": "165/TALK",
   "narrator": "啓介",
   "text": "だがよいか！\n$handle$よ！",
   "zh": "但是你听好！\n$handle$！",
   "narrator_zh": "启介"
  },
  {
   "location": "166/TALK",
   "narrator": "啓介",
   "text": "このつばめに\n騙されるな！",
   "zh": "不要被这个燕\n骗了！",
   "narrator_zh": "启介"
  },
  {
   "location": "167/TALK",
   "narrator": "啓介",
   "text": "私はまだつばめの\n東京滞在を許した\nわけではないのだ。",
   "zh": "我还没有\n允许燕\n留在东京。",
   "narrator_zh": "启介"
  },
  {
   "location": "168/TALK",
   "narrator": "啓介",
   "text": "現実の私が許さぬ\n限り、私は何度でも\n復活するだろう。",
   "zh": "只要现实中的我\n不允许，我就会\n一次次复活吧。",
   "narrator_zh": "启介"
  },
  {
   "location": "169/TALK",
   "narrator": "啓介",
   "text": "それだけは\n覚えておくがいい。",
   "zh": "这一点，\n你最好记住。",
   "narrator_zh": "启介"
  },
  {
   "location": "182/TALK",
   "narrator": "つばめ",
   "text": "……。",
   "zh": "……。",
   "narrator_zh": "燕"
  },
  {
   "location": "183/SEL",
   "narrator": "（選択肢）",
   "text": "許してないって本当？",
   "zh": "他没允许，是真的吗？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "184/ACT",
   "narrator": "",
   "text": "許してないって本当？",
   "zh": "他没允许，是真的吗？",
   "narrator_zh": ""
  },
  {
   "location": "186/TALK",
   "narrator": "つばめ",
   "text": "え？",
   "zh": "诶？",
   "narrator_zh": "燕"
  },
  {
   "location": "189/TALK",
   "narrator": "つばめ",
   "text": "…え、えへへ。\n実はそうなんだ。",
   "zh": "……诶，诶嘿嘿。\n其实是这样。",
   "narrator_zh": "燕"
  },
  {
   "location": "190/SEL",
   "narrator": "（選択肢）",
   "text": "そんな気はしてた",
   "zh": "我就有这种感觉",
   "narrator_zh": "（选项）"
  },
  {
   "location": "191/SEL",
   "narrator": "（選択肢）",
   "text": "それってやばくない？",
   "zh": "那不是很不妙吗？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "192/ACT",
   "narrator": "",
   "text": "そんな気はしてた",
   "zh": "我就有这种感觉",
   "narrator_zh": ""
  },
  {
   "location": "193/TALK",
   "narrator": "つばめ",
   "text": "ええっ？\nそうなの？",
   "zh": "诶诶？\n是吗？",
   "narrator_zh": "燕"
  },
  {
   "location": "194/SEL",
   "narrator": "（選択肢）",
   "text": "顔に出てたよ",
   "zh": "都写在脸上了呀",
   "narrator_zh": "（选项）"
  },
  {
   "location": "195/ACT",
   "narrator": "",
   "text": "顔に出てたよ",
   "zh": "都写在脸上了呀",
   "narrator_zh": ""
  },
  {
   "location": "197/TALK",
   "narrator": "つばめ",
   "text": "そうなんだ…。",
   "zh": "是这样……。",
   "narrator_zh": "燕"
  },
  {
   "location": "198/TALK",
   "narrator": "つばめ",
   "text": "$handle$さんは\nすごいね！\nなんでもわかっちゃう。",
   "zh": "$handle$\n好厉害！\n什么都明白。",
   "narrator_zh": "燕"
  },
  {
   "location": "200/TALK",
   "narrator": "つばめ",
   "text": "本当のこと言うと、\nケンカしちゃって\nそのままなんだ。",
   "zh": "说实话，\n吵了一架\n就一直这样了。",
   "narrator_zh": "燕"
  },
  {
   "location": "202/TALK",
   "narrator": "つばめ",
   "text": "だってお父さんが\n強情なんだもん！",
   "zh": "因为爸爸\n太固执了！",
   "narrator_zh": "燕"
  },
  {
   "location": "203/ACT",
   "narrator": "",
   "text": "それってやばくない？",
   "zh": "那不是很不妙吗？",
   "narrator_zh": ""
  },
  {
   "location": "204/TALK",
   "narrator": "つばめ",
   "text": "うーん、確かに\nちょっとまずいかも。",
   "zh": "嗯——，确实\n也许有点麻烦。",
   "narrator_zh": "燕"
  },
  {
   "location": "205/TALK",
   "narrator": "つばめ",
   "text": "とはいっても、少しの\n間わたしとお父さんが\n気まずいだけだよね。",
   "zh": "不过，也只是\n我和爸爸暂时\n有点尴尬吧。",
   "narrator_zh": "燕"
  },
  {
   "location": "207/SEL",
   "narrator": "（選択肢）",
   "text": "無理矢理実家に連れもどされるよ",
   "zh": "会被硬带回老家的呀",
   "narrator_zh": "（选项）"
  },
  {
   "location": "208/ACT",
   "narrator": "",
   "text": "無理矢理実家に連れもどされるよ",
   "zh": "会被硬带回老家的呀",
   "narrator_zh": ""
  },
  {
   "location": "210/TALK",
   "narrator": "つばめ",
   "text": "えええっ！？\nそうなの！？",
   "zh": "诶诶诶！？\n是这样！？",
   "narrator_zh": "燕"
  },
  {
   "location": "211/SEL",
   "narrator": "（選択肢）",
   "text": "未成年においては親権が何より強いからね",
   "zh": "未成年的话，亲权比什么都强呀",
   "narrator_zh": "（选项）"
  },
  {
   "location": "212/ACT",
   "narrator": "",
   "text": "未成年においては親権が何より強いからね",
   "zh": "未成年的话，亲权比什么都强呀",
   "narrator_zh": ""
  },
  {
   "location": "215/TALK",
   "narrator": "つばめ",
   "text": "どどどどどうしよう！",
   "zh": "怎怎怎怎么办！",
   "narrator_zh": "燕"
  },
  {
   "location": "217/TALK",
   "narrator": "つばめ",
   "text": "帰りたくない…\nううん、\nまだ帰れないよ。",
   "zh": "我不想回去……\n不，\n我还不能回去。",
   "narrator_zh": "燕"
  },
  {
   "location": "218/SEL",
   "narrator": "（選択肢）",
   "text": "相談にのるよ？",
   "zh": "我帮你想想？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "219/ACT",
   "narrator": "",
   "text": "相談にのるよ？",
   "zh": "我帮你想想？",
   "narrator_zh": ""
  },
  {
   "location": "223/TALK",
   "narrator": "つばめ",
   "text": "…ありがとう。",
   "zh": "……谢谢你。",
   "narrator_zh": "燕"
  },
  {
   "location": "225/TALK",
   "narrator": "つばめ",
   "text": "えっと、それじゃ\nまずはどうすれば\nいいかなぁ…。",
   "zh": "那个，那么\n首先该怎么办\n才好……。",
   "narrator_zh": "燕"
  },
  {
   "location": "226/SEL",
   "narrator": "（選択肢）",
   "text": "状況を教えて",
   "zh": "把情况告诉我",
   "narrator_zh": "（选项）"
  },
  {
   "location": "227/SEL",
   "narrator": "（選択肢）",
   "text": "今度リアルのお父さんを紹介して",
   "zh": "下次把现实里的爸爸介绍给我",
   "narrator_zh": "（选项）"
  },
  {
   "location": "228/ACT",
   "narrator": "",
   "text": "状況を教えて",
   "zh": "把情况告诉我",
   "narrator_zh": ""
  },
  {
   "location": "229/TALK",
   "narrator": "つばめ",
   "text": "ああっ！\nそ、そうだね！",
   "zh": "啊啊！\n对、对呀！",
   "narrator_zh": "燕"
  },
  {
   "location": "230/TALK",
   "narrator": "つばめ",
   "text": "それじゃまずは\nお父さんと何があったか\n伝えるね。",
   "zh": "那就先把\n我和爸爸之间发生的事\n告诉你。",
   "narrator_zh": "燕"
  },
  {
   "location": "231/ACT",
   "narrator": "",
   "text": "今度リアルのお父さんを紹介して",
   "zh": "下次把现实里的爸爸介绍给我",
   "narrator_zh": ""
  },
  {
   "location": "233/TALK",
   "narrator": "つばめ",
   "text": "え？\nいいけど……",
   "zh": "诶？\n可以是可以……",
   "narrator_zh": "燕"
  },
  {
   "location": "234/TALK",
   "narrator": "つばめ",
   "text": "多分殆どお話ししないで\n終わっちゃうと思うよ？",
   "zh": "大概几乎说不上话\n就会结束了吧？",
   "narrator_zh": "燕"
  },
  {
   "location": "235/TALK",
   "narrator": "つばめ",
   "text": "うちのお父さん、\n仕事以外に趣味って\n無い人だから――",
   "zh": "我家爸爸，\n除了工作没有\n爱好——",
   "narrator_zh": "燕"
  },
  {
   "location": "236/TALK",
   "narrator": "つばめ",
   "text": "多分、お友達に\nなるのは大変なんじゃ\nないかなぁ？",
   "zh": "大概，要和他\n成为朋友\n挺难的吧？",
   "narrator_zh": "燕"
  },
  {
   "location": "237/SEL",
   "narrator": "（選択肢）",
   "text": "……意味分かってる？",
   "zh": "……你明白我的意思吗？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "238/SEL",
   "narrator": "（選択肢）",
   "text": "結婚前提のお付き合いをさせてくださいって言うだけだよ",
   "zh": "只要说请让我以结婚为前提交往就行了呀",
   "narrator_zh": "（选项）"
  },
  {
   "location": "239/ACT",
   "narrator": "",
   "text": "……意味分かってる？",
   "zh": "……你明白我的意思吗？",
   "narrator_zh": ""
  },
  {
   "location": "240/TALK",
   "narrator": "つばめ",
   "text": "え？",
   "zh": "诶？",
   "narrator_zh": "燕"
  },
  {
   "location": "241/TALK",
   "narrator": "つばめ",
   "text": "うーん、\nよくわかんないや。",
   "zh": "嗯——，\n我不太明白呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "242/ACT",
   "narrator": "",
   "text": "結婚前提のお付き合いをさせてくださいって言うだけだよ",
   "zh": "只要说请让我以结婚为前提交往就行了呀",
   "narrator_zh": ""
  },
  {
   "location": "244/TALK",
   "narrator": "つばめ",
   "text": "へぇ、そうなんだ。\n$handle$さん、\n結婚するんだねー！",
   "zh": "诶，是这样。\n$handle$，\n要结婚了呀！",
   "narrator_zh": "燕"
  },
  {
   "location": "246/TALK",
   "narrator": "つばめ",
   "text": "おめでとう！\n誰とするの？",
   "zh": "恭喜！\n和谁？",
   "narrator_zh": "燕"
  },
  {
   "location": "247/SEL",
   "narrator": "（選択肢）",
   "text": "つばめのお父さんの娘さんだよ…",
   "zh": "是燕的爸爸的女儿呀……",
   "narrator_zh": "（选项）"
  },
  {
   "location": "248/ACT",
   "narrator": "",
   "text": "つばめのお父さんの娘さんだよ…",
   "zh": "是燕的爸爸的女儿呀……",
   "narrator_zh": ""
  },
  {
   "location": "251/TALK",
   "narrator": "つばめ",
   "text": "わたしのお父さんの娘？",
   "zh": "我爸爸的女儿？",
   "narrator_zh": "燕"
  },
  {
   "location": "252/TALK",
   "narrator": "つばめ",
   "text": "って、わたし！",
   "zh": "那不就是我！",
   "narrator_zh": "燕"
  },
  {
   "location": "254/TALK",
   "narrator": "つばめ",
   "text": "ええええええっ…！？",
   "zh": "诶诶诶诶诶……！？",
   "narrator_zh": "燕"
  },
  {
   "location": "255/TALK",
   "narrator": "つばめ",
   "text": "意味が分かりません！",
   "zh": "我听不懂！",
   "narrator_zh": "燕"
  },
  {
   "location": "256/SEL",
   "narrator": "（選択肢）",
   "text": "冗談です",
   "zh": "开玩笑的",
   "narrator_zh": "（选项）"
  },
  {
   "location": "257/SEL",
   "narrator": "（選択肢）",
   "text": "本気です",
   "zh": "是认真的",
   "narrator_zh": "（选项）"
  },
  {
   "location": "258/ACT",
   "narrator": "",
   "text": "冗談です",
   "zh": "开玩笑的",
   "narrator_zh": ""
  },
  {
   "location": "260/TALK",
   "narrator": "つばめ",
   "text": "もぅ！\n冗談はダメだよ！",
   "zh": "真是的！\n不许开玩笑！",
   "narrator_zh": "燕"
  },
  {
   "location": "261/ACT",
   "narrator": "",
   "text": "本気です",
   "zh": "是认真的",
   "narrator_zh": ""
  },
  {
   "location": "264/TALK",
   "narrator": "つばめ",
   "text": "もーーーっ！",
   "zh": "真是的——！",
   "narrator_zh": "燕"
  },
  {
   "location": "265/TALK",
   "narrator": "つばめ",
   "text": "こういうときに\n冗談言ったら\nダメなんだよ！",
   "zh": "这种时候\n开玩笑\n是不行的！",
   "narrator_zh": "燕"
  },
  {
   "location": "270/TALK",
   "narrator": "つばめ",
   "text": "とにかくっ！",
   "zh": "总之！",
   "narrator_zh": "燕"
  },
  {
   "location": "271/TALK",
   "narrator": "つばめ",
   "text": "まずは今お父さんと\nどうなってるかを\n伝えるね。",
   "zh": "先把现在和爸爸\n变成什么样了\n告诉你。",
   "narrator_zh": "燕"
  },
  {
   "location": "275/TALK",
   "narrator": "つばめ",
   "text": "本当は恥ずかしいから\nあまり誰かに見せたく\nないんだけど……。",
   "zh": "其实很不好意思，\n不太想给别人看\n……。",
   "narrator_zh": "燕"
  },
  {
   "location": "294/DIALOG",
   "narrator": "",
   "text": "これは、\n真幌さんからトライナリー入隊について\nお話があった日の夜。\n\n楽屋でのこと――。",
   "zh": "这是，\n从真幌那里听到三重奏入队说明\n那天的晚上。\n\n是在后台的事——。",
   "narrator_zh": ""
  },
  {
   "location": "295/TALK",
   "narrator": "つばめ",
   "text": "だから！\n私が自分で決めた\nことでもあるの！",
   "zh": "所以！\n这也是我自己\n决定的事！",
   "narrator_zh": "燕"
  },
  {
   "location": "296/DIALOG",
   "narrator": "",
   "text": "お父さんに電話をした時には\n既に政府の人が実家に行って\nわたしのトライナリー入隊について\n説明していた。",
   "zh": "我给爸爸打电话的时候，\n政府的人已经去了老家，\n把我加入三重奏的事\n说明过了。",
   "narrator_zh": ""
  },
  {
   "location": "297/TALK",
   "narrator": "啓介",
   "text": "そんなの許さん！\nすぐ帰ってこい！",
   "zh": "那种事我不许！\n马上给我回来！",
   "narrator_zh": "启介"
  },
  {
   "location": "300/TALK",
   "narrator": "つばめ",
   "text": "いやだよ！\n私だってやりたいん\nだもん！",
   "zh": "我不要！\n我也想做\n的！",
   "narrator_zh": "燕"
  },
  {
   "location": "301/TALK",
   "narrator": "啓介",
   "text": "何故そこまで\n頑なになる！",
   "zh": "为什么要\n这么固执！",
   "narrator_zh": "启介"
  },
  {
   "location": "304/TALK",
   "narrator": "つばめ",
   "text": "わたしだって\nお母さんに何か\nしてあげたいの！",
   "zh": "我也想\n为妈妈做点\n什么！",
   "narrator_zh": "燕"
  },
  {
   "location": "305/DIALOG",
   "narrator": "",
   "text": "トライナリーへの入隊は\n大きな生命のリスクが伴う。\n\nだから政府はその対価として、\n現実的に可能な限りの\n隊員の希望を１つ、\n実現してくれるという\n契約になっている。",
   "zh": "加入三重奏，\n伴随着很大的生命风险。\n\n所以作为代价，政府\n在现实所能及的范围内，\n会实现队员的\n一个愿望，\n这就是订下的契约。",
   "narrator_zh": ""
  },
  {
   "location": "306/DIALOG",
   "narrator": "",
   "text": "わたしはその契約で、\nお母さんの病気を治してもらえるよう\n政府の人にお願いした。\n\nお父さんとお母さんは\n高いお金を使って\n自分よりも先に、\n私の病気を治してくれたから―。",
   "zh": "我用这份契约，\n请求政府的人\n治好妈妈的病。\n\n爸爸和妈妈\n花了很多钱，\n先于他们自己，\n治好了我的病—。",
   "narrator_zh": ""
  },
  {
   "location": "307/TALK",
   "narrator": "つばめ",
   "text": "お母さんに\n早く元気になって\n欲しいし――",
   "zh": "我想让妈妈\n快点\n好起来——",
   "narrator_zh": "燕"
  },
  {
   "location": "308/TALK",
   "narrator": "つばめ",
   "text": "わたしそれを\n政府の人に\nお願いしたから！",
   "zh": "所以我把这件事\n拜托给了\n政府的人！",
   "narrator_zh": "燕"
  },
  {
   "location": "309/TALK",
   "narrator": "啓介",
   "text": "馬鹿者！！",
   "zh": "蠢货！！",
   "narrator_zh": "启介"
  },
  {
   "location": "310/TALK",
   "narrator": "啓介",
   "text": "子供はそんなこと\n考えなくていいんだ！",
   "zh": "小孩子\n不用想这种事！",
   "narrator_zh": "启介"
  },
  {
   "location": "312/TALK",
   "narrator": "つばめ",
   "text": "わたしはもう\n子供じゃありません！",
   "zh": "我已经\n不是小孩子了！",
   "narrator_zh": "燕"
  },
  {
   "location": "314/TALK",
   "narrator": "つばめ",
   "text": "もう十分大人に\nなったんだよ！",
   "zh": "我已经\n足够是大人了！",
   "narrator_zh": "燕"
  },
  {
   "location": "315/TALK",
   "narrator": "啓介",
   "text": "バカも休み休み言え！\nとにかくダメだ！\nすぐ帰ってこい！",
   "zh": "傻话也得有个限度！\n总之不行！\n马上给我回来！",
   "narrator_zh": "启介"
  },
  {
   "location": "317/TALK",
   "narrator": "つばめ",
   "text": "いやだ！",
   "zh": "我不要！",
   "narrator_zh": "燕"
  },
  {
   "location": "318/TALK",
   "narrator": "啓介",
   "text": "ダメだ！",
   "zh": "不行！",
   "narrator_zh": "启介"
  },
  {
   "location": "320/TALK",
   "narrator": "つばめ",
   "text": "お父さん嫌い！！",
   "zh": "我讨厌爸爸！！",
   "narrator_zh": "燕"
  },
  {
   "location": "335/TALK",
   "narrator": "つばめ",
   "text": "結局この時の電話は\nケンカしたまま\n切っちゃって――",
   "zh": "结果那通电话\n就在吵架中\n挂断了——",
   "narrator_zh": "燕"
  },
  {
   "location": "337/TALK",
   "narrator": "つばめ",
   "text": "その後もずっと\n一度もお話して\nないんだよね。",
   "zh": "那之后一直\n一次都没有\n说过话。",
   "narrator_zh": "燕"
  },
  {
   "location": "338/TALK",
   "narrator": "つばめ",
   "text": "……えっと、\nどう思う？",
   "zh": "……那个，\n你怎么想？",
   "narrator_zh": "燕"
  },
  {
   "location": "339/TALK",
   "narrator": "つばめ",
   "text": "わたしの言ってること\nそんなにダメかな？",
   "zh": "我说的话\n有那么不行吗？",
   "narrator_zh": "燕"
  },
  {
   "location": "340/SEL",
   "narrator": "（選択肢）",
   "text": "つばめの気持ちはわかる",
   "zh": "我懂燕的心情",
   "narrator_zh": "（选项）"
  },
  {
   "location": "341/SEL",
   "narrator": "（選択肢）",
   "text": "お父さんの気持ちはわかる",
   "zh": "我懂爸爸的心情",
   "narrator_zh": "（选项）"
  },
  {
   "location": "342/SEL",
   "narrator": "（選択肢）",
   "text": "二人の気持ちはどっちもわかる",
   "zh": "两个人的心情我都懂",
   "narrator_zh": "（选项）"
  },
  {
   "location": "343/ACT",
   "narrator": "",
   "text": "つばめの気持ちはわかる",
   "zh": "我懂燕的心情",
   "narrator_zh": ""
  },
  {
   "location": "344/TALK",
   "narrator": "つばめ",
   "text": "ありがとう。\nそう言ってもらえて\n少し安心したよ。",
   "zh": "谢谢你。\n你这么说，\n我稍微安心了。",
   "narrator_zh": "燕"
  },
  {
   "location": "345/ACT",
   "narrator": "",
   "text": "お父さんの気持ちはわかる",
   "zh": "我懂爸爸的心情",
   "narrator_zh": ""
  },
  {
   "location": "347/TALK",
   "narrator": "つばめ",
   "text": "えっ！\nどうして！？",
   "zh": "诶！\n为什么！？",
   "narrator_zh": "燕"
  },
  {
   "location": "348/SEL",
   "narrator": "（選択肢）",
   "text": "つばめに危ないことをして欲しくないんだよ",
   "zh": "他不想让燕做危险的事呀",
   "narrator_zh": "（选项）"
  },
  {
   "location": "349/SEL",
   "narrator": "（選択肢）",
   "text": "つばめと離れたくないんだよ",
   "zh": "他不想和燕分开呀",
   "narrator_zh": "（选项）"
  },
  {
   "location": "350/ACT",
   "narrator": "",
   "text": "つばめに危ないことをして欲しくないんだよ",
   "zh": "他不想让燕做危险的事呀",
   "narrator_zh": ""
  },
  {
   "location": "351/TALK",
   "narrator": "つばめ",
   "text": "それは……\nそうかもしれないけど…",
   "zh": "那是……\n也许是这样……",
   "narrator_zh": "燕"
  },
  {
   "location": "352/ACT",
   "narrator": "",
   "text": "つばめと離れたくないんだよ",
   "zh": "他不想和燕分开呀",
   "narrator_zh": ""
  },
  {
   "location": "353/TALK",
   "narrator": "つばめ",
   "text": "わたしだって、\n一人は心細いよ？",
   "zh": "我也不想，\n一个人也很寂寞呀？",
   "narrator_zh": "燕"
  },
  {
   "location": "355/TALK",
   "narrator": "つばめ",
   "text": "でも、わたし\n今回はどうしても\nやりたいの！",
   "zh": "可是，我\n这次无论如何\n都想做！",
   "narrator_zh": "燕"
  },
  {
   "location": "356/ACT",
   "narrator": "",
   "text": "二人の気持ちはどっちもわかる",
   "zh": "两个人的心情我都懂",
   "narrator_zh": ""
  },
  {
   "location": "358/TALK",
   "narrator": "つばめ",
   "text": "うっ……\nその言い方はずるいよ。",
   "zh": "唔……\n这么说太狡猾了。",
   "narrator_zh": "燕"
  },
  {
   "location": "359/SEL",
   "narrator": "（選択肢）",
   "text": "本当にそう思うんだって",
   "zh": "我是真的这么想",
   "narrator_zh": "（选项）"
  },
  {
   "location": "360/SEL",
   "narrator": "（選択肢）",
   "text": "大人の対応",
   "zh": "大人的做法",
   "narrator_zh": "（选项）"
  },
  {
   "location": "361/ACT",
   "narrator": "",
   "text": "本当にそう思うんだって",
   "zh": "我是真的这么想",
   "narrator_zh": ""
  },
  {
   "location": "363/TALK",
   "narrator": "つばめ",
   "text": "そっか。\n真剣に考えてくれて\nありがとう。",
   "zh": "是吗。\n你认真想了，\n谢谢你。",
   "narrator_zh": "燕"
  },
  {
   "location": "364/ACT",
   "narrator": "",
   "text": "大人の対応",
   "zh": "大人的做法",
   "narrator_zh": ""
  },
  {
   "location": "365/TALK",
   "narrator": "つばめ",
   "text": "そういうのを\n大人の対応って\nいうんだ。",
   "zh": "原来这种\n就叫\n大人的做法。",
   "narrator_zh": "燕"
  },
  {
   "location": "366/TALK",
   "narrator": "つばめ",
   "text": "よくわからないわたしは\nやっぱり子供なのかな。",
   "zh": "不太明白的我，\n果然还是小孩子吧。",
   "narrator_zh": "燕"
  },
  {
   "location": "369/TALK",
   "narrator": "つばめ",
   "text": "わたしね、お母さんに\nずっと助けられて\n生きてきたんだ。",
   "zh": "我呀，一直被妈妈\n帮助着\n活到现在。",
   "narrator_zh": "燕"
  },
  {
   "location": "370/TALK",
   "narrator": "つばめ",
   "text": "だからどうしても、\nお母さんに恩返し\nしたくて。",
   "zh": "所以无论如何，\n都想报答\n妈妈。",
   "narrator_zh": "燕"
  },
  {
   "location": "371/TALK",
   "narrator": "つばめ",
   "text": "自分の力がみんなの\n役に立って、お母さん\nも幸せにできるなら――",
   "zh": "如果自己的力量能帮到大家，\n也能让妈妈\n幸福的话——",
   "narrator_zh": "燕"
  },
  {
   "location": "372/TALK",
   "narrator": "つばめ",
   "text": "こんなにいいことは\nないよねって、そう\n思ったんだ。",
   "zh": "没有比这更好的事了，\n我是这么\n想的。",
   "narrator_zh": "燕"
  },
  {
   "location": "373/TALK",
   "narrator": "つばめ",
   "text": "だからね、お父さんに\nもう一度話してみようと\n思う。",
   "zh": "所以呀，我想\n再和爸爸\n谈一次。",
   "narrator_zh": "燕"
  },
  {
   "location": "375/TALK",
   "narrator": "つばめ",
   "text": "わかってもらえるまで\n何度でも。",
   "zh": "直到他明白为止，\n多少次都可以。",
   "narrator_zh": "燕"
  },
  {
   "location": "377/TALK",
   "narrator": "つばめ",
   "text": "時間はかかるかも\nしれないけど、自分で\n決めた事だもん。",
   "zh": "也许要花时间，\n但这是我自己\n决定的事。",
   "narrator_zh": "燕"
  },
  {
   "location": "378/TALK",
   "narrator": "つばめ",
   "text": "頑張るよ。",
   "zh": "我会加油的。",
   "narrator_zh": "燕"
  },
  {
   "location": "380/TALK",
   "narrator": "つばめ",
   "text": "こんな風に思えるのも\n$handle$さんの\nお陰だよ？",
   "zh": "能这样想，\n也是多亏了\n$handle$呀？",
   "narrator_zh": "燕"
  },
  {
   "location": "381/TALK",
   "narrator": "つばめ",
   "text": "これからも色々\n相談しちゃうかもだけど\nその時はよろしくね。",
   "zh": "以后也许还会\n问你很多事，\n到时候拜托你了。",
   "narrator_zh": "燕"
  },
  {
   "location": "382/SEL",
   "narrator": "（選択肢）",
   "text": "まかせておけ！",
   "zh": "交给我吧！",
   "narrator_zh": "（选项）"
  },
  {
   "location": "383/SEL",
   "narrator": "（選択肢）",
   "text": "程々に",
   "zh": "适可而止",
   "narrator_zh": "（选项）"
  },
  {
   "location": "384/SEL",
   "narrator": "（選択肢）",
   "text": "そのかわり、お義父さん紹介してね？",
   "zh": "作为交换，把岳父介绍给我吧？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "385/ACT",
   "narrator": "",
   "text": "まかせておけ！",
   "zh": "交给我吧！",
   "narrator_zh": ""
  },
  {
   "location": "387/TALK",
   "narrator": "つばめ",
   "text": "えへへ、ありがと。",
   "zh": "诶嘿嘿，谢谢。",
   "narrator_zh": "燕"
  },
  {
   "location": "392/TALK",
   "narrator": "つばめ",
   "text": "今回は\n本当にありがとう。",
   "zh": "这次\n真的谢谢你。",
   "narrator_zh": "燕"
  },
  {
   "location": "393/ACT",
   "narrator": "",
   "text": "程々に",
   "zh": "适可而止",
   "narrator_zh": ""
  },
  {
   "location": "394/TALK",
   "narrator": "つばめ",
   "text": "うん、それでいいよ？",
   "zh": "嗯，那样就可以吧？",
   "narrator_zh": "燕"
  },
  {
   "location": "397/TALK",
   "narrator": "つばめ",
   "text": "今回は\n本当にありがとう。",
   "zh": "这次\n真的谢谢你。",
   "narrator_zh": "燕"
  },
  {
   "location": "398/ACT",
   "narrator": "",
   "text": "そのかわり、お義父さん紹介してね？",
   "zh": "作为交换，把岳父介绍给我吧？",
   "narrator_zh": ""
  },
  {
   "location": "399/TALK",
   "narrator": "つばめ",
   "text": "えっ！？\nなんでそうなるの？",
   "zh": "诶！？\n怎么变成这样了？",
   "narrator_zh": "燕"
  },
  {
   "location": "400/TALK",
   "narrator": "つばめ",
   "text": "まあいいけど、\nでもどうやって\n紹介すればいいのかな。",
   "zh": "倒也没关系，\n可是该怎么\n介绍才好。",
   "narrator_zh": "燕"
  },
  {
   "location": "401/SEL",
   "narrator": "（選択肢）",
   "text": "「友だちです」って",
   "zh": "“是朋友”",
   "narrator_zh": "（选项）"
  },
  {
   "location": "402/SEL",
   "narrator": "（選択肢）",
   "text": "「フィアンセです」って",
   "zh": "“是费昂塞”",
   "narrator_zh": "（选项）"
  },
  {
   "location": "403/SEL",
   "narrator": "（選択肢）",
   "text": "「手合わせ願いたい」って",
   "zh": "“想请你过招”",
   "narrator_zh": "（选项）"
  },
  {
   "location": "404/ACT",
   "narrator": "",
   "text": "「友だちです」って",
   "zh": "“是朋友”",
   "narrator_zh": ""
  },
  {
   "location": "406/TALK",
   "narrator": "つばめ",
   "text": "んー、いいけど――",
   "zh": "嗯——，可以是可以——",
   "narrator_zh": "燕"
  },
  {
   "location": "408/TALK",
   "narrator": "つばめ",
   "text": "スルーされて\n終わりだと思うなぁ。",
   "zh": "大概会被无视，\n然后就结束了。",
   "narrator_zh": "燕"
  },
  {
   "location": "409/TALK",
   "narrator": "つばめ",
   "text": "うちのお父さん、\n自分と関係無いことは\n話さない人だから。",
   "zh": "我家爸爸，\n和自己无关的事\n他不会谈。",
   "narrator_zh": "燕"
  },
  {
   "location": "410/ACT",
   "narrator": "",
   "text": "「フィアンセです」って",
   "zh": "“是费昂塞”",
   "narrator_zh": ""
  },
  {
   "location": "412/TALK",
   "narrator": "つばめ",
   "text": "えええっ！！\nそれはやめた方が\nいいよ。",
   "zh": "诶诶诶！！\n那个还是\n算了吧。",
   "narrator_zh": "燕"
  },
  {
   "location": "413/TALK",
   "narrator": "つばめ",
   "text": "多分わたしのスマホ\n壊されちゃうよ。",
   "zh": "我的手机\n大概会被摔坏。",
   "narrator_zh": "燕"
  },
  {
   "location": "414/TALK",
   "narrator": "つばめ",
   "text": "でも、もし\n$handle$さんと\n出逢うことができて――",
   "zh": "可是，如果\n能和$handle$\n遇见的话——",
   "narrator_zh": "燕"
  },
  {
   "location": "415/TALK",
   "narrator": "つばめ",
   "text": "二人とも好きに\nなっちゃったら\n覚悟決めないとね。",
   "zh": "两个人都喜欢上了的话，\n就得下定\n决心了呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "417/TALK",
   "narrator": "つばめ",
   "text": "そのときは\nがんばってね。",
   "zh": "到那时候\n要加油呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "418/ACT",
   "narrator": "",
   "text": "「手合わせ願いたい」って",
   "zh": "“想请你过招”",
   "narrator_zh": ""
  },
  {
   "location": "420/TALK",
   "narrator": "つばめ",
   "text": "えええっ！！\nそれはやめた方が\nいいよ。",
   "zh": "诶诶诶！！\n那个还是\n算了吧。",
   "narrator_zh": "燕"
  },
  {
   "location": "421/TALK",
   "narrator": "つばめ",
   "text": "うちのお父さん、\n柔道すごく強いんだよ。",
   "zh": "我家爸爸，\n柔道非常强。",
   "narrator_zh": "燕"
  },
  {
   "location": "422/SEL",
   "narrator": "（選択肢）",
   "text": "望むところ",
   "zh": "正合我意",
   "narrator_zh": "（选项）"
  },
  {
   "location": "423/SEL",
   "narrator": "（選択肢）",
   "text": "囲碁か将棋でお願いします…",
   "zh": "请用围棋或者将棋……",
   "narrator_zh": "（选项）"
  },
  {
   "location": "424/ACT",
   "narrator": "",
   "text": "望むところ",
   "zh": "正合我意",
   "narrator_zh": ""
  },
  {
   "location": "425/TALK",
   "narrator": "つばめ",
   "text": "$handle$さんも\n柔道強いんだ！",
   "zh": "$handle$\n柔道也很强！",
   "narrator_zh": "燕"
  },
  {
   "location": "426/TALK",
   "narrator": "つばめ",
   "text": "それじゃ、逢えたら\n是非紹介するね。",
   "zh": "那么，要是能见到，\n一定介绍给你。",
   "narrator_zh": "燕"
  },
  {
   "location": "427/TALK",
   "narrator": "つばめ",
   "text": "最近柔道できなくて\n溜め込んでる\nみたいだから。",
   "zh": "他最近没法练柔道，\n好像憋着\n一股劲。",
   "narrator_zh": "燕"
  },
  {
   "location": "428/ACT",
   "narrator": "",
   "text": "囲碁か将棋でお願いします…",
   "zh": "请用围棋或者将棋……",
   "narrator_zh": ""
  },
  {
   "location": "429/TALK",
   "narrator": "つばめ",
   "text": "あ、そっちなんだ。",
   "zh": "啊，是那边呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "430/TALK",
   "narrator": "つばめ",
   "text": "でもそっちも\nお父さん結構\n強いんだよね。",
   "zh": "不过那边\n爸爸也相当\n强呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "433/TALK",
   "narrator": "つばめ",
   "text": "とは言ってるけど、\nなんかわたしね…",
   "zh": "话是这么说，\n总觉得我呀……",
   "narrator_zh": "燕"
  },
  {
   "location": "434/TALK",
   "narrator": "つばめ",
   "text": "$handle$さんを\nお父さんに会わせる\n事になるんじゃって――",
   "zh": "会变成让$handle$\n去见爸爸\n的事——",
   "narrator_zh": "燕"
  },
  {
   "location": "435/TALK",
   "narrator": "つばめ",
   "text": "そんな気もしてるんだ。\n理由はわからないけど。",
   "zh": "我也有这种感觉。\n虽然不知道理由。",
   "narrator_zh": "燕"
  },
  {
   "location": "436/TALK",
   "narrator": "つばめ",
   "text": "もちろん、\n$handle$さん\n次第だけどね。",
   "zh": "当然，\n要看$handle$\n怎么想。",
   "narrator_zh": "燕"
  },
  {
   "location": "438/TALK",
   "narrator": "つばめ",
   "text": "話が逸れちゃったけど、\n今回はありがとう。",
   "zh": "话说远了，\n这次谢谢你。",
   "narrator_zh": "燕"
  },
  {
   "location": "440/TALK",
   "narrator": "つばめ",
   "text": "わたし、お父さんが\n許してくれるまで\nちゃんと説得するよ。",
   "zh": "我会好好说服爸爸，\n直到他\n允许为止。",
   "narrator_zh": "燕"
  },
  {
   "location": "442/TALK",
   "narrator": "つばめ",
   "text": "家族だもんね。\nえへへ……。",
   "zh": "毕竟是家人呀。\n诶嘿嘿……。",
   "narrator_zh": "燕"
  },
  {
   "location": "444/TALK",
   "narrator": "つばめ",
   "text": "それじゃ、またね！",
   "zh": "那就，下次见！",
   "narrator_zh": "燕"
  },
  {
   "location": "470/TALK",
   "narrator": "千羽鶴",
   "text": "なかなかの\nココロ裁き。\n順風満帆ね。",
   "zh": "相当不错的\n心的裁断。\n一帆风顺。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "471/SEL",
   "narrator": "（選択肢）",
   "text": "つばめのお父さんと会ったぜ！",
   "zh": "我见到燕的爸爸了！",
   "narrator_zh": "（选项）"
  },
  {
   "location": "472/SEL",
   "narrator": "（選択肢）",
   "text": "つばめのお父さんは本物？",
   "zh": "燕的爸爸是真的吗？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "473/ACT",
   "narrator": "",
   "text": "つばめのお父さんと会ったぜ！",
   "zh": "我见到燕的爸爸了！",
   "narrator_zh": ""
  },
  {
   "location": "474/TALK",
   "narrator": "千羽鶴",
   "text": "つばめの心の中のね。",
   "zh": "是燕心里的那个。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "475/ACT",
   "narrator": "",
   "text": "つばめのお父さんは本物？",
   "zh": "燕的爸爸是真的吗？",
   "narrator_zh": ""
  },
  {
   "location": "476/TALK",
   "narrator": "千羽鶴",
   "text": "いいえ。",
   "zh": "不是。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "478/TALK",
   "narrator": "千羽鶴",
   "text": "貴方が出逢った\n逢瀬つばめの父、\n啓介は彼女の妄想。",
   "zh": "你遇见的\n逢濑燕的父亲启介，\n是她的妄想。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "480/TALK",
   "narrator": "千羽鶴",
   "text": "ここは\n逢瀬つばめの\n心の中。",
   "zh": "这里是\n逢濑燕的\n心里。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "482/TALK",
   "narrator": "千羽鶴",
   "text": "そこで出てくる人物は\n全て、彼女が想い描く\n勝手な人物像。",
   "zh": "在那里出现的人，\n全都是她想象出来的\n随意的人物形象。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "483/SEL",
   "narrator": "（選択肢）",
   "text": "じゃあ、全部嘘ってこと？",
   "zh": "那么，全部都是假的？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "484/ACT",
   "narrator": "",
   "text": "じゃあ、全部嘘ってこと？",
   "zh": "那么，全部都是假的？",
   "narrator_zh": ""
  },
  {
   "location": "486/TALK",
   "narrator": "千羽鶴",
   "text": "いいえ。",
   "zh": "不是。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "487/TALK",
   "narrator": "千羽鶴",
   "text": "もちろん、合っている\n部分は多い。でも――",
   "zh": "当然，对得上的\n部分很多。但是——",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "488/TALK",
   "narrator": "千羽鶴",
   "text": "その一部は、自分に\n都合のいいようにねじ\n曲げられていたり――",
   "zh": "其中一部分，会被\n拧成对自己方便的形状，\n或者——",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "489/TALK",
   "narrator": "千羽鶴",
   "text": "先入観で\n作られていたり――",
   "zh": "被先入为主\n造出来——",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "490/TALK",
   "narrator": "千羽鶴",
   "text": "自分をよく見せる\nためにわざと印象悪く\n見せる時もある。",
   "zh": "为了让自己好看，\n有时还会故意\n把印象弄得很差。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "491/TALK",
   "narrator": "千羽鶴",
   "text": "貴方も他人に誰かの\n話をするときに、\nそういう事しない？",
   "zh": "你跟别人讲某个人的时候，\n不也会\n做这种事吗？",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "492/SEL",
   "narrator": "（選択肢）",
   "text": "しますね…",
   "zh": "会的……",
   "narrator_zh": "（选项）"
  },
  {
   "location": "493/SEL",
   "narrator": "（選択肢）",
   "text": "しません！",
   "zh": "不会！",
   "narrator_zh": "（选项）"
  },
  {
   "location": "494/ACT",
   "narrator": "",
   "text": "しますね…",
   "zh": "会的……",
   "narrator_zh": ""
  },
  {
   "location": "495/TALK",
   "narrator": "千羽鶴",
   "text": "正直者ね。素敵。",
   "zh": "挺诚实。不错。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "496/ACT",
   "narrator": "",
   "text": "しません！",
   "zh": "不会！",
   "narrator_zh": ""
  },
  {
   "location": "497/TALK",
   "narrator": "千羽鶴",
   "text": "正直者なのね…。\n世渡り大変そう。",
   "zh": "你倒是诚实……。\n在世上怕是不好过。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "499/TALK",
   "narrator": "千羽鶴",
   "text": "心の中では\nそれがよりリアリティを\nもって再現される。",
   "zh": "在心里，\n那会以更强的现实感\n被重现出来。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "500/TALK",
   "narrator": "千羽鶴",
   "text": "だから、細心の注意を\nするように。",
   "zh": "所以，\n要格外小心。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "501/TALK",
   "narrator": "千羽鶴",
   "text": "まあでも……",
   "zh": "不过……",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "502/TALK",
   "narrator": "千羽鶴",
   "text": "何度か痛い目を見れば\nなれると思うから\n心配しなくても大丈夫。",
   "zh": "吃几次亏\n就会习惯的，\n不用担心。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "503/TALK",
   "narrator": "千羽鶴",
   "text": "それじゃ、\n現実世界に送還する。",
   "zh": "那么，\n把你送回现实世界。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "505/TALK",
   "narrator": "千羽鶴",
   "text": "貴方にも良い夢を――。",
   "zh": "也祝你有个好梦——。",
   "narrator_zh": "千羽鹤"
  }
 ]
