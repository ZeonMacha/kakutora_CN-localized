{
    "dir": "chap09/daydra/dd_ch02_09_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "9256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ここに桃がある",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "这里有桃子"
    },
    "entry": [
        {
            "location": "204/SCENARIO",
            "narrator": "",
            "text": "ここに桃がある",
            "zh": "这里有桃子",
            "narrator_zh": ""
        },
        {
            "location": "214/TALK",
            "narrator": "アーヤ",
            "text": "ただいまぁ。\nふぅ、重かった…。",
            "zh": "我回来啦。\n呼，好重……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/TALK",
            "narrator": "アーヤ",
            "text": "…でもこれ、\nどうしようかしら？",
            "zh": "……不过这么多，\n该怎么办才好呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "216/TALK",
            "narrator": "アーヤ",
            "text": "そのままじゃ食べきれる\nとは思えないし…。",
            "zh": "光这么直接吃的话，\n感觉根本吃不完……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "217/TALK",
            "narrator": "アーヤ",
            "text": "う～ん…。",
            "zh": "唔～……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "229/TALK",
            "narrator": "アーヤ",
            "text": "ヽ(∇⌒ヽ)(ﾉ⌒∇)ﾉ",
            "zh": "ヽ(∇⌒ヽ)(ﾉ⌒∇)ﾉ",
            "narrator_zh": "绫水"
        },
        {
            "location": "231/SEL",
            "narrator": "",
            "text": "いいことあったの？",
            "zh": "遇到什么好事了吗？",
            "narrator_zh": ""
        },
        {
            "location": "232/ACT",
            "narrator": "",
            "text": "いいことあったの？",
            "zh": "遇到什么好事了吗？",
            "narrator_zh": ""
        },
        {
            "location": "236/TALK",
            "narrator": "アーヤ",
            "text": "スーパーでくじを引いたら",
            "zh": "在超市抽奖的时候",
            "narrator_zh": "绫水"
        },
        {
            "location": "237/TALK",
            "narrator": "アーヤ",
            "text": "桃五キロを当てたの(≧∇≦)b",
            "zh": "抽中了五公斤桃子(≧∇≦)b",
            "narrator_zh": "绫水"
        },
        {
            "location": "238/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと高級なやつみたいで",
            "zh": "好像还是挺高级的那种",
            "narrator_zh": "绫水"
        },
        {
            "location": "239/TALK",
            "narrator": "アーヤ",
            "text": "凄く大きくて、甘い香りがするの",
            "zh": "又大又香，味道甜甜的",
            "narrator_zh": "绫水"
        },
        {
            "location": "241/SEL",
            "narrator": "",
            "text": "スゴイ！やったね！",
            "zh": "厉害！太棒了！",
            "narrator_zh": ""
        },
        {
            "location": "242/ACT",
            "narrator": "",
            "text": "スゴイ！やったね！",
            "zh": "厉害！太棒了！",
            "narrator_zh": ""
        },
        {
            "location": "244/TALK",
            "narrator": "アーヤ",
            "text": "ヽ(*^^*)ノ",
            "zh": "ヽ(*^^*)ノ",
            "narrator_zh": "绫水"
        },
        {
            "location": "245/TALK",
            "narrator": "アーヤ",
            "text": "冷やして食べるのが楽しみ",
            "zh": "好期待冰镇之后吃起来的味道",
            "narrator_zh": "绫水"
        },
        {
            "location": "246/TALK",
            "narrator": "アーヤ",
            "text": "でも、",
            "zh": "不过，",
            "narrator_zh": "绫水"
        },
        {
            "location": "247/TALK",
            "narrator": "アーヤ",
            "text": "多いから、これでデザートでも作ろうかしら？",
            "zh": "因为太多了，要不要用这些做点甜点呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "249/TALK",
            "narrator": "アーヤ",
            "text": "桃を使ったデザート、何かしらない？",
            "zh": "用桃子做的甜点，你有什么好点子吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "251/SEL",
            "narrator": "アーヤ",
            "text": "パイにしよう",
            "zh": "做成派吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "252/SEL",
            "narrator": "アーヤ",
            "text": "シャーベットにしよう",
            "zh": "做成冰沙吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "253/SEL",
            "narrator": "アーヤ",
            "text": "おすそわけすれば？",
            "zh": "分给大家怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "254/ACT",
            "narrator": "",
            "text": "パイにしよう",
            "zh": "做成派吧",
            "narrator_zh": ""
        },
        {
            "location": "257/TALK",
            "narrator": "アーヤ",
            "text": "お茶菓子に合いそうでいいかも",
            "zh": "感觉很适合当茶点，挺不错的",
            "narrator_zh": "绫水"
        },
        {
            "location": "258/TALK",
            "narrator": "アーヤ",
            "text": "作るのも難しくないし",
            "zh": "做起来也不算难",
            "narrator_zh": "绫水"
        },
        {
            "location": "259/TALK",
            "narrator": "アーヤ",
            "text": "それにするわ(*^^*)",
            "zh": "就这么决定了(*^^*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "265/TALK",
            "narrator": "アーヤ",
            "text": "さてと、レシピは…。",
            "zh": "好，那么食谱是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "266/TALK",
            "narrator": "アーヤ",
            "text": "…でも、パイって\n結構カロリー高いわね。",
            "zh": "……不过，派的\n热量其实挺高的吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "268/TALK",
            "narrator": "アーヤ",
            "text": "これだけの桃のほとんどを\nパイにしたとして、それを\n食べたとしたら…。",
            "zh": "要是把这么多桃子里的\n大部分都做成派，\n然后全都吃掉的话……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "271/TALK",
            "narrator": "アーヤ",
            "text": "…しばらく、自主トレの\n量を増やした方が\nいいかも…。",
            "zh": "……接下来一段时间，\n还是增加自主训练的量\n比较好吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "272/ACT",
            "narrator": "",
            "text": "シャーベットにしよう",
            "zh": "做成冰沙吧",
            "narrator_zh": ""
        },
        {
            "location": "274/TALK",
            "narrator": "アーヤ",
            "text": "さっぱりして美味しそう",
            "zh": "感觉清爽又好吃",
            "narrator_zh": "绫水"
        },
        {
            "location": "275/TALK",
            "narrator": "アーヤ",
            "text": "お風呂上りに食べたら最高かも(*^^*)",
            "zh": "洗完澡出来吃的话一定棒极了(*^^*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "276/TALK",
            "narrator": "アーヤ",
            "text": "あ、だったら",
            "zh": "啊，说起来",
            "narrator_zh": "绫水"
        },
        {
            "location": "277/TALK",
            "narrator": "アーヤ",
            "text": "普通に切った桃を冷凍庫で冷やすだけっていうのも",
            "zh": "直接把切好的桃子放进冷冻室冰起来",
            "narrator_zh": "绫水"
        },
        {
            "location": "278/TALK",
            "narrator": "アーヤ",
            "text": "美味しく食べられそうでいいかも",
            "zh": "好像也会很好吃，挺不错的",
            "narrator_zh": "绫水"
        },
        {
            "location": "289/TALK",
            "narrator": "アーヤ",
            "text": "冷たいデザートなら、\n簡単な物でも美味しく\nなりそうで良いわ。",
            "zh": "如果是冰凉的甜点，\n哪怕做法简单也能\n做得很好吃，挺不错的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "290/TALK",
            "narrator": "アーヤ",
            "text": "レシピを調べて、\n色々作ってみよっと。",
            "zh": "查查食谱，\n试着做各种花样吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "291/ACT",
            "narrator": "",
            "text": "おすそわけすれば？",
            "zh": "分给大家怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "293/TALK",
            "narrator": "アーヤ",
            "text": "あ、それいいかも",
            "zh": "啊，这个主意不错",
            "narrator_zh": "绫水"
        },
        {
            "location": "294/TALK",
            "narrator": "アーヤ",
            "text": "デザート作るにしても、一人でこの量は難しいし…",
            "zh": "就算要做甜点，一个人也吃不完这么多……",
            "narrator_zh": "绫水"
        },
        {
            "location": "295/TALK",
            "narrator": "アーヤ",
            "text": "そうしてみるわ",
            "zh": "那就这么办吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "319/TALK",
            "narrator": "アーヤ",
            "text": "…というわけで、\nもしよければみんなにも\n食べてもらいたいの。",
            "zh": "……就是这样，\n如果大家不嫌弃的话，\n也一起来吃吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "321/TALK",
            "narrator": "つばめ",
            "text": "それは構いませんけど、\n本当にいいんですか？",
            "zh": "我是无所谓啦，\n不过真的可以吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "322/TALK",
            "narrator": "つばめ",
            "text": "凄くいい桃みたい\nですけど…。",
            "zh": "看起来像是\n非常高级的桃子呢……。",
            "narrator_zh": "燕"
        },
        {
            "location": "325/TALK",
            "narrator": "アーヤ",
            "text": "いい桃だから、\n無駄にしたくないの。",
            "zh": "正因为是好桃子，\n才不想浪费掉。",
            "narrator_zh": "绫水"
        },
        {
            "location": "326/TALK",
            "narrator": "アーヤ",
            "text": "少しでも持っていって\nもらえると助かるわ。",
            "zh": "你们能拿走一点的话\n反而是帮了我大忙。",
            "narrator_zh": "绫水"
        },
        {
            "location": "329/TALK",
            "narrator": "みやび",
            "text": "そういうことなら、\n遠慮なく貰ってくぞね。",
            "zh": "既然这样，\n那我就不客气拿走啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "330/TALK",
            "narrator": "みやび",
            "text": "冷やした桃は美味いきね。\n夕飯のデザートにさせて\nもらうが。",
            "zh": "冰镇过的桃子好吃得很啵。\n我就拿来当晚饭后的\n甜点咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "332/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしもそうするわ。\n桃なんて、最近食べて\nなかったし。",
            "zh": "那我也拿一些吧。\n说起来最近也\n一直没吃桃子。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "助かるわ。\n一個二個とかじゃなくて、\nもっと抱えて持ってって。",
            "zh": "真是帮大忙了。\n别只拿一两个，\n多抱些回去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "335/TALK",
            "narrator": "ガブリエラ",
            "text": "今度はあたし達が\n食べ切れなくなるわよ。",
            "zh": "那样的话该变成我们\n吃不完了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "337/TALK",
            "narrator": "みやび",
            "text": "…なら、少し多めに\n貰ってもえいか？",
            "zh": "……那，稍微多拿点\n要得吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "338/TALK",
            "narrator": "みやび",
            "text": "そしたら桃のお菓子を\n作れるきね。",
            "zh": "这样就能做桃子点心\n来吃啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "340/TALK",
            "narrator": "つばめ",
            "text": "わぁ、美味しそうです！",
            "zh": "哇，听起来好好吃！",
            "narrator_zh": "燕"
        },
        {
            "location": "343/TALK",
            "narrator": "ガブリエラ",
            "text": "お菓子かぁ…。",
            "zh": "点心啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "344/TALK",
            "narrator": "ガブリエラ",
            "text": "タルトとかパイなら、\n作れるし、あたしも\nそうしようかしら？",
            "zh": "挞或者派的话，\n我也会做，要不我也\n做点那个吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "345/TALK",
            "narrator": "みやび",
            "text": "出来上がったら、\nみんなにおすそわけ\nするちや。",
            "zh": "做好以后，\n再分给大家吃\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "346/TALK",
            "narrator": "アーヤ",
            "text": "なら、遠慮せずどんどん\n持ってっちゃって。",
            "zh": "那就别客气，\n尽管多拿点回去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "348/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、遠慮なく…。",
            "zh": "那我就不客气了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "350/TALK",
            "narrator": "つばめ",
            "text": "わたしも、この機会に\n何か作ってみようかなぁ？",
            "zh": "我也趁这个机会，\n试着做点什么吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "352/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…どんなお菓子が\n出来上がるのか、今から\n楽しみだわ。",
            "zh": "呵呵……能做出怎样的\n点心呢，现在就开始\n期待了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "353/TALK",
            "narrator": "アーヤ",
            "text": "おすそ分けして\n正解だったみたい。",
            "zh": "分给大家果然是\n正确的选择。",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月20日　2:43 PM</color>\nとある平日の午後、アーヤの部屋にて。",
            "zh": "<color=green>5月20日　2:43 PM</color>\n某个平日的午后，在绫水的房间里。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
