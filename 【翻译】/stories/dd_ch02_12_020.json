{
    "dir": "chap12/daydra/dd_ch02_12_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "12256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "進路相談",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "出路咨询"
    },
    "entry": [
        {
            "location": "311/SCENARIO",
            "narrator": "",
            "text": "進路相談",
            "zh": "出路咨询",
            "narrator_zh": ""
        },
        {
            "location": "324/TALK",
            "narrator": "繭",
            "text": "キリト、小テストの点数、\nちょっと酷過ぎる。",
            "zh": "圣翔，你这次小测的分数，\n未免太惨了点。",
            "narrator_zh": "茧"
        },
        {
            "location": "326/TALK",
            "narrator": "キリト",
            "text": "…テスト勉強、\n結構頑張ったんだけどな。",
            "zh": "……备考的时候，\n我明明还挺努力的啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "328/TALK",
            "narrator": "雛",
            "text": "う～ん…まあ、留年する\n心配はなさそうだけど――",
            "zh": "唔～……嘛，虽然应该\n不用担心留级就是了——",
            "narrator_zh": "雏"
        },
        {
            "location": "329/TALK",
            "narrator": "雛",
            "text": "もう１０点くらいは\nあった方がいいかも…。",
            "zh": "但要是能再多考个10分\n左右或许会比较好……。",
            "narrator_zh": "雏"
        },
        {
            "location": "332/TALK",
            "narrator": "キリト",
            "text": "だよなぁ…今は良いけど、\n後々不安だし…。",
            "zh": "就是说啊……现在倒是无所谓，\n以后心里总归没底……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "335/TALK",
            "narrator": "アーヤ",
            "text": "就職のこと？",
            "zh": "是指找工作的事吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "337/TALK",
            "narrator": "キリト",
            "text": "そうっす。",
            "zh": "没错。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "338/TALK",
            "narrator": "キリト",
            "text": "情報管理庁管轄下の\nどっかには入れるのは\nわかってるけど――",
            "zh": "虽然我知道总归能进\n情报管理厅管辖下的\n某个部门——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "339/TALK",
            "narrator": "キリト",
            "text": "どうせなら、それなりに\nデカい企業に入りたい\nっすからね。",
            "zh": "但既然要选，还是想进\n规模大一点的企业\n嘛。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "341/TALK",
            "narrator": "雛",
            "text": "キリトもそんなこと\n考えてるんだ？",
            "zh": "圣翔也会考虑\n这种事呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "344/TALK",
            "narrator": "キリト",
            "text": "テストの後は特にな。",
            "zh": "考完试之后尤其会想。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "346/TALK",
            "narrator": "キリト",
            "text": "綾水先輩、俺の成績だと\nどの辺りに入れると\n思うっすか？",
            "zh": "绫水前辈，以我的成绩，\n你觉得能进到\n什么水平的单位啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "348/TALK",
            "narrator": "アーヤ",
            "text": "ど、どうかしら…？\n私もまだ大学生だから\nよくわからないけど――",
            "zh": "这、这个嘛……？\n我也还是个大学生，\n不太清楚——",
            "narrator_zh": "绫水"
        },
        {
            "location": "349/TALK",
            "narrator": "アーヤ",
            "text": "お役所勤めは、\nちょっと厳しいかも…。",
            "zh": "去政府机关就职，\n可能会有点悬……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "351/TALK",
            "narrator": "雛",
            "text": "ていうか、そういう\n仕事はキリトに\n向いてなさそう。",
            "zh": "话说回来，那种\n工作感觉也不太\n适合圣翔吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "353/TALK",
            "narrator": "キリト",
            "text": "はぁ…さすがの俺も、\n今回ばかりは凹んだわ。",
            "zh": "唉……就连我，\n这次也真是受打击了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "354/TALK",
            "narrator": "キリト",
            "text": "もう留年さえしなけりゃ\n良い、って思うように\nしちまおうかなぁ？",
            "zh": "干脆就想着只要\n不留级就行了，\n这样安慰自己算了？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "355/TALK",
            "narrator": "雛",
            "text": "…本気でヘコんじゃってる\nみたいだね。",
            "zh": "……看来是真受\n打击了呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "356/TALK",
            "narrator": "繭",
            "text": "こんなにヘコんでる\nキリトは、珍しい。",
            "zh": "圣翔消沉成这样，\n还真是少见。",
            "narrator_zh": "茧"
        },
        {
            "location": "358/TALK",
            "narrator": "繭",
            "text": "何とかして、元気付けて\nあげたいけど…。",
            "zh": "真想办法\n帮他打起精神来……。",
            "narrator_zh": "茧"
        },
        {
            "location": "363/TALK",
            "narrator": "アーヤ",
            "text": "相当ショックだった\nみたいね。",
            "zh": "看来受到的打击\n相当大呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "365/TALK",
            "narrator": "雛",
            "text": "元気のないキリトを\n見てると、こっちまで\n落ち込んじゃいます。",
            "zh": "看着没精打采的圣翔，\n连我也跟着\n低落起来了。",
            "narrator_zh": "雏"
        },
        {
            "location": "368/TALK",
            "narrator": "キリト",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "370/TALK",
            "narrator": "アーヤ",
            "text": "どうすれば少しは元気に\nなってくれるかしら？",
            "zh": "怎么做才能让他稍微\n打起精神来呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "371/TALK",
            "narrator": "アーヤ",
            "text": "…コッソリ聞いてみよう。",
            "zh": "……偷偷问一下吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "383/TALK",
            "narrator": "アーヤ",
            "text": "相談に乗ってもらえる？",
            "zh": "能帮我参谋一下吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "385/SEL",
            "narrator": "",
            "text": "先輩って呼んでくれたらね",
            "zh": "叫声前辈就帮你",
            "narrator_zh": ""
        },
        {
            "location": "386/ACT",
            "narrator": "",
            "text": "先輩って呼んでくれたらね",
            "zh": "叫声前辈就帮你",
            "narrator_zh": ""
        },
        {
            "location": "388/TALK",
            "narrator": "アーヤ",
            "text": "聞かれてた(-ω-;)",
            "zh": "被听见了吗(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "389/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、先輩",
            "zh": "那好吧，前辈",
            "narrator_zh": "绫水"
        },
        {
            "location": "390/TALK",
            "narrator": "アーヤ",
            "text": "キリト君を元気付ける方法、一緒に考えてもらえる？",
            "zh": "能和我一起想想怎么让圣翔打起精神吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "392/SEL",
            "narrator": "",
            "text": "得意なものを磨こう",
            "zh": "打磨擅长的领域吧",
            "narrator_zh": ""
        },
        {
            "location": "393/SEL",
            "narrator": "",
            "text": "勉強を教えてあげよう",
            "zh": "教他学习吧",
            "narrator_zh": ""
        },
        {
            "location": "394/ACT",
            "narrator": "",
            "text": "得意なものを磨こう",
            "zh": "打磨擅长的领域吧",
            "narrator_zh": ""
        },
        {
            "location": "395/TALK",
            "narrator": "アーヤ",
            "text": "それなら、キリト君も頑張れるかも",
            "zh": "那样的话，圣翔说不定也能加把劲呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "396/TALK",
            "narrator": "アーヤ",
            "text": "早速言ってみるわ(*^-ﾟ)v",
            "zh": "我马上去跟他说(*^-ﾟ)v",
            "narrator_zh": "绫水"
        },
        {
            "location": "408/TALK",
            "narrator": "アーヤ",
            "text": "キリトくんって、得意な\n科目はなんだったかしら？",
            "zh": "圣翔，你擅长的\n科目是什么来着？",
            "narrator_zh": "绫水"
        },
        {
            "location": "410/TALK",
            "narrator": "キリト",
            "text": "えっと、部隊指揮と\n模擬戦っすね。",
            "zh": "呃，是部队指挥和\n模拟战。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "412/TALK",
            "narrator": "雛",
            "text": "その二つに関していえば、\nトップクラスだもんねー。",
            "zh": "说到这两门的话，\n他可是顶尖水平呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "415/TALK",
            "narrator": "キリト",
            "text": "へへっ、まあな。",
            "zh": "嘿嘿，那当然。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "420/TALK",
            "narrator": "アーヤ",
            "text": "それなら、その二つだけは\n特に力を入れて学んだ方が\n良いわ。",
            "zh": "既然如此，那这两门就\n更要重点下功夫\n学好才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "421/TALK",
            "narrator": "アーヤ",
            "text": "極めれば、そのスキルを\n活かせる職場に、優先的に\n就職できるし。",
            "zh": "只要学精了，就能优先\n进入能发挥那些技能的\n单位就职。",
            "narrator_zh": "绫水"
        },
        {
            "location": "423/TALK",
            "narrator": "キリト",
            "text": "なるほど…どうせなら\n得意なことが活かせる\n職場がいいよな。",
            "zh": "原来如此……既然要工作，\n还是去能发挥所长的地方\n比较好啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "426/TALK",
            "narrator": "アーヤ",
            "text": "そういうこと。",
            "zh": "就是这么回事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "427/TALK",
            "narrator": "アーヤ",
            "text": "もちろん、苦手な科目は\n捨てて良い、ってわけじゃ\nないけど。",
            "zh": "当然，这也不是说\n不擅长的科目就可以\n直接放弃了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "428/TALK",
            "narrator": "キリト",
            "text": "わかってるって。",
            "zh": "我知道的。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "429/TALK",
            "narrator": "キリト",
            "text": "サンキュ、綾水先輩。\nなんか、ちょっとだけ\n軽くなったっす。",
            "zh": "谢啦，绫水前辈。\n总觉得心情稍微\n轻松了点。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "430/TALK",
            "narrator": "アーヤ",
            "text": "よかった、何とか元気に\nなってくれたみたい…。",
            "zh": "太好了，总算是\n让他振作起来了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "431/ACT",
            "narrator": "",
            "text": "勉強を教えてあげよう",
            "zh": "教他学习吧",
            "narrator_zh": ""
        },
        {
            "location": "433/TALK",
            "narrator": "アーヤ",
            "text": "そうね",
            "zh": "也是呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "434/TALK",
            "narrator": "アーヤ",
            "text": "勉強に協力すれば、少しは元気出してくれるかも",
            "zh": "如果能帮他补习功课，说不定他能稍微打起精神",
            "narrator_zh": "绫水"
        },
        {
            "location": "446/TALK",
            "narrator": "アーヤ",
            "text": "もしよければだけど、\n私が勉強を教える、って\nいうのはどうかしら？",
            "zh": "如果你不介意的话，\n由我来教你学习，\n怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "449/TALK",
            "narrator": "キリト",
            "text": "えっ！？",
            "zh": "咦！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "451/TALK",
            "narrator": "アーヤ",
            "text": "多分、今やってる範囲の\n内容なら、教えることが\nできると思うんだけど…。",
            "zh": "我想，如果是你们现在\n学到的范围，我应该\n还是能教得来的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "454/TALK",
            "narrator": "キリト",
            "text": "そりゃ、教えてもらえる\nなら嬉しいけど――",
            "zh": "那要是能得到前辈辅导，\n我当然很高兴——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "456/TALK",
            "narrator": "キリト",
            "text": "本当に良いんすか？\nバイトや大学もあるから\n忙しいのに…。",
            "zh": "真的没关系吗？\n前辈又有打工又要上大学，\n那么忙……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "458/TALK",
            "narrator": "アーヤ",
            "text": "う～ん…毎日は無理かな。",
            "zh": "唔～……每天的话可能不行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "459/TALK",
            "narrator": "アーヤ",
            "text": "けど、勉強でどうしても\nわからないことが\nあった時に――",
            "zh": "不过，在学习上实在\n有搞不懂的地方\n时——",
            "narrator_zh": "绫水"
        },
        {
            "location": "461/TALK",
            "narrator": "アーヤ",
            "text": "聞いてきてくれれば\n教えることくらいの\nことは出来るわ。",
            "zh": "只要来问我，\n帮你们讲讲题还是\n做得到的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "462/TALK",
            "narrator": "キリト",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "463/TALK",
            "narrator": "キリト",
            "text": "綾水先輩…\nマジで助かるっす！！",
            "zh": "绫水前辈……\n真是帮大忙了！！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "464/TALK",
            "narrator": "雛",
            "text": "あ、あの！",
            "zh": "那、那个！",
            "narrator_zh": "雏"
        },
        {
            "location": "465/TALK",
            "narrator": "雛",
            "text": "あたしも、文系の授業が\nちょっと苦手で…。",
            "zh": "我也有点不擅长\n文科类的课程……。",
            "narrator_zh": "雏"
        },
        {
            "location": "467/TALK",
            "narrator": "アーヤ",
            "text": "ええ、良いわよ。",
            "zh": "嗯，没问题哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "468/TALK",
            "narrator": "雛",
            "text": "やったー！！\n綾水様に教えてもらえる\nなんて、感激です！",
            "zh": "太好了——！！\n居然能得到绫水大人亲自辅导，\n太感动了！",
            "narrator_zh": "雏"
        },
        {
            "location": "472/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…とりあえず、\n今日はテストの見直し\nから始めましょ。",
            "zh": "呵呵……总之，\n今天先从复习这次的\n测验卷开始吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "473/TALK",
            "narrator": "キリト",
            "text": "今からっすか！？",
            "zh": "从现在就开始吗！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "474/TALK",
            "narrator": "アーヤ",
            "text": "早い方がいいでしょ？\n日向さんも、答案用紙\n出して。",
            "zh": "越早开始越好吧？\n日向也把答卷\n拿出来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "476/TALK",
            "narrator": "雛",
            "text": "わかりました！\nキリト、頑張ろうね！",
            "zh": "知道了！\n圣翔，一起加油吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "478/TALK",
            "narrator": "キリト",
            "text": "…そうだな。\nよっしゃー、次は絶対\n良い点取るぜ！！",
            "zh": "……说得也是。\n好嘞——，下次绝对要\n考个好分数！！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "479/TALK",
            "narrator": "繭",
            "text": "良かった…キリトが\n元気になって…。",
            "zh": "太好了……圣翔\n终于打起精神来了……。",
            "narrator_zh": "茧"
        },
        {
            "location": "323/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月1日　4:08 PM</color>\nとある平日の午後、学園中庭にて。",
            "zh": "<color=green>7月1日　4:08 PM</color>\n某个工作日的下午，在学园中庭。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "490/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch02",
            "text": "【覚えめでたく覚えておらず】",
            "zh": "【深受器重却记不住】",
            "narrator_zh": "Dialog_GEThimegoto_ch02"
        }
    ]
}
