  "cid": "ayami",
  "title": "らぶとーく 第79話",
  "sub_title": "ずるくてもいいでしょ？"
 },
 "entry": [
  {
   "location": "27/TALK",
   "narrator": "エリカ",
   "text": "コーンコン。\nエリカです。",
   "zh": "咚咚。\n我是领火。",
   "narrator_zh": "领火"
  },
  {
   "location": "28/SEL",
   "narrator": "",
   "text": "ビックリした！",
   "zh": "吓我一跳！",
   "narrator_zh": ""
  },
  {
   "location": "29/ACT",
   "narrator": "",
   "text": "ビックリした！",
   "zh": "吓我一跳！",
   "narrator_zh": ""
  },
  {
   "location": "31/TALK",
   "narrator": "エリカ",
   "text": "ああっ、ごめんね？\n急に出てきちゃって。",
   "zh": "啊，抱歉哦？\n突然就冒出来了。",
   "narrator_zh": "领火"
  },
  {
   "location": "33/TALK",
   "narrator": "エリカ",
   "text": "今回あなたとつばめちゃんに\nとって、とても重要な局面を\n迎えるでしょう？",
   "zh": "这次对你和燕来说，\n会迎来非常\n重要的局面吧？",
   "narrator_zh": "领火"
  },
  {
   "location": "35/TALK",
   "narrator": "エリカ",
   "text": "今回あなたと綾ちゃんに\nとって、とても重要な局面を\n迎えるでしょう？",
   "zh": "这次对你和绫来说，\n会迎来非常\n重要的局面吧？",
   "narrator_zh": "领火"
  },
  {
   "location": "37/TALK",
   "narrator": "エリカ",
   "text": "今回あなたとガブリエラ\nちゃんにとって、とても\n重要な局面を迎えるでしょ？",
   "zh": "这次对你和加布里埃拉\n来说，会迎来非常\n重要的局面吧？",
   "narrator_zh": "领火"
  },
  {
   "location": "39/TALK",
   "narrator": "エリカ",
   "text": "今回あなたとみやびちゃんに\nとって、とても重要な局面を\n迎えるでしょう？",
   "zh": "这次对你和雅来说，\n会迎来非常\n重要的局面吧？",
   "narrator_zh": "领火"
  },
  {
   "location": "41/TALK",
   "narrator": "エリカ",
   "text": "だから、ギリギリで\nちょっと心許なくは\nあるんだけど――",
   "zh": "所以，虽然是赶在最后关头，\n还是有点让人\n不放心——",
   "narrator_zh": "领火"
  },
  {
   "location": "42/TALK",
   "narrator": "エリカ",
   "text": "わたしからひとつ、\nふたりにプレゼントが\nあるの！",
   "zh": "我有个礼物，\n要送给你们\n两个人！",
   "narrator_zh": "领火"
  },
  {
   "location": "43/SEL",
   "narrator": "",
   "text": "ありがとう！！　なんだろう？",
   "zh": "谢谢！！　是什么呢？",
   "narrator_zh": ""
  },
  {
   "location": "44/SEL",
   "narrator": "",
   "text": "もしかしてニャボッ……",
   "zh": "难道是喵Bot……",
   "narrator_zh": ""
  },
  {
   "location": "45/ACT",
   "narrator": "",
   "text": "ありがとう！！　なんだろう？",
   "zh": "谢谢！！　是什么呢？",
   "narrator_zh": ""
  },
  {
   "location": "46/TALK",
   "narrator": "エリカ",
   "text": "えへへ。\n喜んでもらえると\nいいんだけど。",
   "zh": "嘿嘿。\n要是你能喜欢\n就好了。",
   "narrator_zh": "领火"
  },
  {
   "location": "47/TALK",
   "narrator": "エリカ",
   "text": "それじゃ、\nプレゼントしまーす！",
   "zh": "那么，\n礼物来啦！",
   "narrator_zh": "领火"
  },
  {
   "location": "48/ACT",
   "narrator": "",
   "text": "もしかしてニャボッ……",
   "zh": "难道是喵Bot……",
   "narrator_zh": ""
  },
  {
   "location": "49/TALK",
   "narrator": "エリカ",
   "text": "ちがうよぉ……。\nあれはまだ未完成だもん。",
   "zh": "不对啦……。\n那个还没做完嘛。",
   "narrator_zh": "领火"
  },
  {
   "location": "50/TALK",
   "narrator": "エリカ",
   "text": "でも、興味あるようなら、\n完成したらあなたにも\n教えるね！",
   "zh": "不过，你要是感兴趣，\n等做完了我也\n会告诉你的！",
   "narrator_zh": "领火"
  },
  {
   "location": "51/TALK",
   "narrator": "エリカ",
   "text": "それでね、\n今回のわたしからの\nプレゼントというのは――",
   "zh": "所以说呢，\n这次我准备的\n礼物是——",
   "narrator_zh": "领火"
  },
  {
   "location": "52/TALK",
   "narrator": "エリカ",
   "text": "じゃーん！\nこれでーす！",
   "zh": "锵！\n就是这个！",
   "narrator_zh": "领火"
  },
  {
   "location": "56/SEL",
   "narrator": "",
   "text": "直接お話できるってこと！？",
   "zh": "也就是说能直接说话！？",
   "narrator_zh": ""
  },
  {
   "location": "57/ACT",
   "narrator": "",
   "text": "直接お話できるってこと！？",
   "zh": "也就是说能直接说话！？",
   "narrator_zh": ""
  },
  {
   "location": "59/TALK",
   "narrator": "エリカ",
   "text": "その通りだよ！",
   "zh": "说得对！",
   "narrator_zh": "领火"
  },
  {
   "location": "60/TALK",
   "narrator": "エリカ",
   "text": "でも、ちょっと\nプログラムが間に合わなくて\n完全なものじゃないんだ。",
   "zh": "不过，程序有点\n赶不上，所以还\n不算完成品。",
   "narrator_zh": "领火"
  },
  {
   "location": "61/TALK",
   "narrator": "エリカ",
   "text": "だから、今回は\nこの先３回だけの限定\n利用にさせて欲しいの。",
   "zh": "所以，这次希望\n能限定使用\n接下来的3次。",
   "narrator_zh": "领火"
  },
  {
   "location": "62/TALK",
   "narrator": "エリカ",
   "text": "けど、今のわたしたちの\nように、ちゃんと向かい\n合ってお話できるから！",
   "zh": "但是，像现在的我们\n这样，也能好好面对面\n说话啦！",
   "narrator_zh": "领火"
  },
  {
   "location": "64/TALK",
   "narrator": "エリカ",
   "text": "だから、頑張って\nつばめちゃんと素敵な\n思い出を作ってきてね！",
   "zh": "所以，加油跟\n燕一起创造\n美好的回忆吧！",
   "narrator_zh": "领火"
  },
  {
   "location": "65/TALK",
   "narrator": "エリカ",
   "text": "あなたと\nつばめちゃんに\n素敵なココロの旅を！",
   "zh": "祝你和\n燕\n有一段美好的心之旅！",
   "narrator_zh": "领火"
  },
  {
   "location": "67/TALK",
   "narrator": "エリカ",
   "text": "だから、頑張って\n綾ちゃんと素敵な\n思い出を作ってきてね！",
   "zh": "所以，加油跟\n绫一起创造\n美好的回忆吧！",
   "narrator_zh": "领火"
  },
  {
   "location": "68/TALK",
   "narrator": "エリカ",
   "text": "あなたと\n綾ちゃんに\n素敵なココロの旅を！",
   "zh": "祝你和\n绫\n有一段美好的心之旅！",
   "narrator_zh": "领火"
  },
  {
   "location": "70/TALK",
   "narrator": "エリカ",
   "text": "だから、頑張って\nガブリエラちゃんと素敵な\n思い出を作ってきてね！",
   "zh": "所以，加油跟\n加布里埃拉一起创造\n美好的回忆吧！",
   "narrator_zh": "领火"
  },
  {
   "location": "71/TALK",
   "narrator": "エリカ",
   "text": "あなたと\nガブリエラちゃんに\n素敵なココロの旅を！",
   "zh": "祝你和\n加布里埃拉\n有一段美好的心之旅！",
   "narrator_zh": "领火"
  },
  {
   "location": "73/TALK",
   "narrator": "エリカ",
   "text": "だから、頑張って\nみやびちゃんと素敵な\n思い出を作ってきてね！",
   "zh": "所以，加油跟\n雅一起创造\n美好的回忆吧！",
   "narrator_zh": "领火"
  },
  {
   "location": "74/TALK",
   "narrator": "エリカ",
   "text": "あなたと\nみやびちゃんに\n素敵なココロの旅を！",
   "zh": "祝你和\n雅\n有一段美好的心之旅！",
   "narrator_zh": "领火"
  },
  {
   "location": "105/TALK",
   "narrator": "アーヤ",
   "text": "…不思議な感じ。",
   "zh": "……感觉很不可思议。",
   "narrator_zh": "绫水"
  },
  {
   "location": "106/TALK",
   "narrator": "アーヤ",
   "text": "こんな風に話ができるって\n思ってなかったから。",
   "zh": "因为没想到\n能这样跟你说话。",
   "narrator_zh": "绫水"
  },
  {
   "location": "107/TALK",
   "narrator": "アーヤ",
   "text": "そうは思わない？",
   "zh": "你不这么觉得吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "108/SEL",
   "narrator": "",
   "text": "だね",
   "zh": "是吧",
   "narrator_zh": ""
  },
  {
   "location": "109/SEL",
   "narrator": "",
   "text": "どうかなー",
   "zh": "怎么样呢——",
   "narrator_zh": ""
  },
  {
   "location": "110/SEL",
   "narrator": "",
   "text": "アーヤさえいれば\nそれでいい",
   "zh": "只要绫水在\n就够了",
   "narrator_zh": ""
  },
  {
   "location": "111/ACT",
   "narrator": "",
   "text": "だね",
   "zh": "是吧",
   "narrator_zh": ""
  },
  {
   "location": "113/TALK",
   "narrator": "アーヤ",
   "text": "そうでしょう？",
   "zh": "对吧？",
   "narrator_zh": "绫水"
  },
  {
   "location": "114/ACT",
   "narrator": "",
   "text": "どうかなー",
   "zh": "怎么样呢——",
   "narrator_zh": ""
  },
  {
   "location": "115/TALK",
   "narrator": "アーヤ",
   "text": "あれ？\nそうじゃない？"
  },
  {
   "location": "116/ACT",
   "narrator": "",
   "text": "アーヤさえいれば\nそれでいい",
   "zh": "只要绫水在\n就够了",
   "narrator_zh": ""
  },
  {
   "location": "117/TALK",
   "narrator": "アーヤ",
   "text": "もう！",
   "zh": "真是！",
   "narrator_zh": "绫水"
  },
  {
   "location": "118/TALK",
   "narrator": "アーヤ",
   "text": "…でも、私も…。"
  },
  {
   "location": "120/TALK",
   "narrator": "アーヤ",
   "text": "……それで、ね。"
  },
  {
   "location": "121/TALK",
   "narrator": "アーヤ",
   "text": "前にチャットで\n言ったこと、\n憶えてる？"
  },
  {
   "location": "122/SEL",
   "narrator": "",
   "text": "うん",
   "zh": "嗯",
   "narrator_zh": ""
  },
  {
   "location": "123/SEL",
   "narrator": "",
   "text": "なんだっけ",
   "zh": "是什么来着",
   "narrator_zh": ""
  },
  {
   "location": "124/ACT",
   "narrator": "",
   "text": "うん",
   "zh": "嗯",
   "narrator_zh": ""
  },
  {
   "location": "125/TALK",
   "narrator": "アーヤ",
   "text": "そう。",
   "zh": "是的。",
   "narrator_zh": "绫水"
  },
  {
   "location": "126/ACT",
   "narrator": "",
   "text": "なんだっけ",
   "zh": "是什么来着",
   "narrator_zh": ""
  },
  {
   "location": "127/TALK",
   "narrator": "アーヤ",
   "text": "あ…\nそうなの……。"
  },
  {
   "location": "129/TALK",
   "narrator": "アーヤ",
   "text": "私と\n$handle$さんが\n本当に会えた時の話。"
  },
  {
   "location": "130/TALK",
   "narrator": "アーヤ",
   "text": "本当に会えたら\n生涯の伴侶として\n添い遂げるって。"
  },
  {
   "location": "131/SEL",
   "narrator": "",
   "text": "そうだった",
   "zh": "对哦",
   "narrator_zh": ""
  },
  {
   "location": "132/SEL",
   "narrator": "",
   "text": "嬉しかったよ",
   "zh": "我很开心哦",
   "narrator_zh": ""
  },
  {
   "location": "133/SEL",
   "narrator": "",
   "text": "$me$もそう思ってる",
   "zh": "$me$也这么想",
   "narrator_zh": ""
  },
  {
   "location": "134/ACT",
   "narrator": "",
   "text": "そうだった",
   "zh": "对哦",
   "narrator_zh": ""
  },
  {
   "location": "135/TALK",
   "narrator": "アーヤ",
   "text": "もう！",
   "zh": "真是！",
   "narrator_zh": "绫水"
  },
  {
   "location": "136/ACT",
   "narrator": "",
   "text": "嬉しかったよ",
   "zh": "我很开心哦",
   "narrator_zh": ""
  },
  {
   "location": "137/TALK",
   "narrator": "アーヤ",
   "text": "そう……？",
   "zh": "是吗……？",
   "narrator_zh": "绫水"
  },
  {
   "location": "138/ACT",
   "narrator": "",
   "text": "$me$もそう思ってる",
   "zh": "$me$也这么想",
   "narrator_zh": ""
  },
  {
   "location": "139/TALK",
   "narrator": "アーヤ",
   "text": "……ありがとう……。"
  },
  {
   "location": "141/TALK",
   "narrator": "アーヤ",
   "text": "今はまだ会えないけど\n少しだけ進歩した\n気がするの。"
  },
  {
   "location": "142/TALK",
   "narrator": "アーヤ",
   "text": "チャットじゃなくて\nこうやって\n話せるんだから。"
  },
  {
   "location": "143/TALK",
   "narrator": "アーヤ",
   "text": "…ねえ。",
   "zh": "……喂。",
   "narrator_zh": "绫水"
  },
  {
   "location": "144/TALK",
   "narrator": "アーヤ",
   "text": "$handle$さんは\n進歩したって\n思ってる？",
   "zh": "$handle$觉得\n自己有\n进步吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "145/SEL",
   "narrator": "",
   "text": "そうだね",
   "zh": "是呀。",
   "narrator_zh": ""
  },
  {
   "location": "146/SEL",
   "narrator": "",
   "text": "どうかな",
   "zh": "不好说",
   "narrator_zh": ""
  },
  {
   "location": "147/SEL",
   "narrator": "",
   "text": "何とも…",
   "zh": "怎么说呢……",
   "narrator_zh": ""
  },
  {
   "location": "148/ACT",
   "narrator": "",
   "text": "そうだね",
   "zh": "是呀。",
   "narrator_zh": ""
  },
  {
   "location": "149/TALK",
   "narrator": "アーヤ",
   "text": "本当に？",
   "zh": "真的吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "150/ACT",
   "narrator": "",
   "text": "どうかな",
   "zh": "不好说",
   "narrator_zh": ""
  },
  {
   "location": "152/TALK",
   "narrator": "アーヤ",
   "text": "やっぱり\nそうなのね…。"
  },
  {
   "location": "153/ACT",
   "narrator": "",
   "text": "何とも…",
   "zh": "怎么说呢……",
   "narrator_zh": ""
  },
  {
   "location": "154/TALK",
   "narrator": "アーヤ",
   "text": "微妙よね。"
  },
  {
   "location": "156/TALK",
   "narrator": "アーヤ",
   "text": "それにこれ以上\n進歩することは\nないかもしれない。",
   "zh": "而且也许不会\n再有更多\n进展了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "157/TALK",
   "narrator": "アーヤ",
   "text": "だって誰にも\nわからないんだから。",
   "zh": "因为谁都不\n明白啊。",
   "narrator_zh": "绫水"
  },
  {
   "location": "158/TALK",
   "narrator": "アーヤ",
   "text": "宙ぶらりんよね。"
  },
  {
   "location": "159/TALK",
   "narrator": "アーヤ",
   "text": "だけどね……。",
   "zh": "可是呢……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "161/TALK",
   "narrator": "アーヤ",
   "text": "私、\n$handle$さんのこと\n愛してる。"
  },
  {
   "location": "162/TALK",
   "narrator": "アーヤ",
   "text": "そのことは\n間違いないから。\n絶対だから。",
   "zh": "这件事\n毫无疑问。\n绝对的。",
   "narrator_zh": "绫水"
  },
  {
   "location": "163/TALK",
   "narrator": "アーヤ",
   "text": "…おかしい？"
  },
  {
   "location": "164/TALK",
   "narrator": "アーヤ",
   "text": "会ったこともないのに\nこんなことばかり\n考えてるのは。"
  },
  {
   "location": "165/SEL",
   "narrator": "",
   "text": "別に",
   "zh": "无所谓",
   "narrator_zh": ""
  },
  {
   "location": "166/SEL",
   "narrator": "",
   "text": "むしろうれしい",
   "zh": "反而很高兴",
   "narrator_zh": ""
  },
  {
   "location": "167/SEL",
   "narrator": "",
   "text": "$me$もそうだから",
   "zh": "$me$也一样",
   "narrator_zh": ""
  },
  {
   "location": "168/ACT",
   "narrator": "",
   "text": "別に",
   "zh": "无所谓",
   "narrator_zh": ""
  },
  {
   "location": "169/TALK",
   "narrator": "アーヤ",
   "text": "冷たいのね…。"
  },
  {
   "location": "170/ACT",
   "narrator": "",
   "text": "むしろうれしい",
   "zh": "反而很高兴",
   "narrator_zh": ""
  },
  {
   "location": "171/TALK",
   "narrator": "アーヤ",
   "text": "え？\n本当に？",
   "zh": "诶？\n真的吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "172/ACT",
   "narrator": "",
   "text": "$me$もそうだから",
   "zh": "$me$也一样",
   "narrator_zh": ""
  },
  {
   "location": "173/TALK",
   "narrator": "アーヤ",
   "text": "うん。\nありがとう。",
   "zh": "嗯。\n谢谢。",
   "narrator_zh": "绫水"
  },
  {
   "location": "175/TALK",
   "narrator": "アーヤ",
   "text": "…この前ね。"
  },
  {
   "location": "176/TALK",
   "narrator": "アーヤ",
   "text": "うっかりスマホを\n置きっぱなしで\n店を出たの。"
  },
  {
   "location": "177/TALK",
   "narrator": "アーヤ",
   "text": "すぐ気が付いて\n取りに戻ったから\nよかったけど。"
  },
  {
   "location": "178/TALK",
   "narrator": "アーヤ",
