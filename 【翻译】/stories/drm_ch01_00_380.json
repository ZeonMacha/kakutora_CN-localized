{
    "dir": "dramatics/daydra/drm_ch01_00_380.js",
    "type": "Episode",
    "info": {
        "story_id": "1038",
        "cid": "tsubame",
        "title": "らぶとーく 第38話",
        "sub_title": "東京を一時離れて",
        "title_zh": "恋爱漫谈 第38话",
        "sub_title_zh": "暂时离开东京"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "東京を一時離れて",
            "zh": "暂时离开东京",
            "narrator_zh": ""
        },
        {
            "location": "20/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…いいわねぇ…。",
            "zh": "唉……真好啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "21/TALK",
            "narrator": "アーヤ",
            "text": "こうやって砂浜で、\n何もせずゆったりと\n過ごすのも…。",
            "zh": "像这样在沙滩上，\n什么也不做，悠悠闲闲地\n待着……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "22/TALK",
            "narrator": "神楽",
            "text": "他に人がいない、って\nいうのも素敵ですね。",
            "zh": "没有其他人在这一点，\n也很棒呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "23/TALK",
            "narrator": "神楽",
            "text": "この時期の海といえば、\nどこに行っても人で\n溢れかえってますし。",
            "zh": "这个时期的海边，\n不管去哪里都挤满了\n人呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "正直、あんまり期待して\nなかったけど――",
            "zh": "老实说，本来没怎么\n抱期待的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "他の人を気にしないで\nおもいっきり遊べるし――",
            "zh": "可以不用在意别人\n痛痛快快地玩——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "28/TALK",
            "narrator": "ガブリエラ",
            "text": "のんびりもできるから、\n来て良かったわ。",
            "zh": "因为也能悠闲地过，\n来对了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "つばめ",
            "text": "そうだね…。",
            "zh": "是啊……",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "ねえ、ガブちゃん。\n少し休んだら、沖の方まで\n泳いでみない？",
            "zh": "喂，加布。\n休息一会儿，去远海\n游一游吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あんた、元気ね…。",
            "zh": "你、你也太有精神了吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "神楽",
            "text": "ビーチバレーやった\nばかりなのに、\n疲れてないんですか？",
            "zh": "刚刚才打完\n沙滩排球，\n你不累吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "えへへ…楽しいからかな？\nあまり疲れてる感じが\nしないんだ。",
            "zh": "嘿嘿……可能是因为开心吧？\n不太觉得\n累呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "39/TALK",
            "narrator": "アーヤ",
            "text": "何にせよ、もう少し\n休んでからがいいわね。",
            "zh": "不管怎样，还是再\n休息一会儿比较好哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "アーヤ",
            "text": "つばめは良くても、\nギャヴィも卯月も\n疲れてるみたいだし。",
            "zh": "燕倒无所谓，\n可加维和卯月\n看起来也很累了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "三十分くらい昼寝するわ。\n朝の特訓もあったから、\nさすがに疲れたし。",
            "zh": "我要午睡三十分钟。\n早上还有过特训，\n确实也累了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、起きたら\n泳ぎに行こうね。",
            "zh": "那等睡醒了，\n我们去游泳吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "46/TALK",
            "narrator": "ガブリエラ",
            "text": "一人で行ってもらえると\n嬉しいんだけど？",
            "zh": "你要是能一个人去，\n我倒是求之不得？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "でも、ガブちゃんと\n一緒の方が楽しそう\nだし…。",
            "zh": "不过，跟加布一起\n好像更\n开心……。",
            "narrator_zh": "燕"
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "だめ？",
            "zh": "不行？",
            "narrator_zh": "燕"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "…ま、まあ、休んだ後なら\n考えてあげなくもないわ。",
            "zh": "……算、算了，等休息完\n再考虑一下也不是不行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "つばめ",
            "text": "やった！",
            "zh": "太好了！",
            "narrator_zh": "燕"
        },
        {
            "location": "55/TALK",
            "narrator": "神楽",
            "text": "なんだかんだ言っても、\nガブちゃんは優しい\n女の子ですね！",
            "zh": "不管怎么说，\n加布真是个温柔的\n女孩子呢！",
            "narrator_zh": "神乐"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うるさい！\n寝るんだから、ちょっと\n静かにしてて！",
            "zh": "吵、吵死了！\n我要睡觉了，给我\n安静一点！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "神楽",
            "text": "…つばめさんも、\nガブちゃんが起きるまでは\n休んだ方が良いですよ。",
            "zh": "……燕，\n在加布醒来之前\n还是休息一下比较好哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "61/TALK",
            "narrator": "神楽",
            "text": "沖まで泳いだところで\n疲れちゃったら、\n大変ですし。",
            "zh": "要是游到远处\n才累了的话，\n可就麻烦了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "64/TALK",
            "narrator": "つばめ",
            "text": "うん、そうするよ。",
            "zh": "嗯，我听你的。",
            "narrator_zh": "燕"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "まったりぃ(*´ω｀)",
            "zh": "悠闲自在呀(*´ω｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "81/SEL",
            "narrator": "",
            "text": "また相談？",
            "zh": "又要商量？",
            "narrator_zh": ""
        },
        {
            "location": "82/SEL",
            "narrator": "",
            "text": "エマージェンシーコール？",
            "zh": "紧急呼叫？",
            "narrator_zh": ""
        },
        {
            "location": "83/SEL",
            "narrator": "",
            "text": "何用？",
            "zh": "有什么事？",
            "narrator_zh": ""
        },
        {
            "location": "84/ACT",
            "narrator": "",
            "text": "また相談？",
            "zh": "又要商量？",
            "narrator_zh": ""
        },
        {
            "location": "85/TALK",
            "narrator": "つばめ",
            "text": "違ぅよ(´・ω・`) ",
            "zh": "不是啦(´･ω･`)",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "つばめ",
            "text": "凄く楽しぃから",
            "zh": "因为太开心了",
            "narrator_zh": "燕"
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんとぉ話したくなったの",
            "zh": "我忽然想跟$handle$聊聊了",
            "narrator_zh": "燕"
        },
        {
            "location": "89/ACT",
            "narrator": "",
            "text": "エマージェンシーコール？",
            "zh": "紧急呼叫？",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？(ﾟ△ﾟ;ﾉ)ﾉ",
            "zh": "诶诶！？(ﾟ△ﾟ;ﾉ)ﾉ",
            "narrator_zh": "燕"
        },
        {
            "location": "92/TALK",
            "narrator": "つばめ",
            "text": "違ぅよ(´・ω・`) ",
            "zh": "不是啦(´･ω･`)",
            "narrator_zh": "燕"
        },
        {
            "location": "93/TALK",
            "narrator": "つばめ",
            "text": "もしかして何か大変なことがぁったの？",
            "zh": "难道说那边出了什么大事吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "95/SEL",
            "narrator": "",
            "text": "何もないよ",
            "zh": "什么都没有哦",
            "narrator_zh": ""
        },
        {
            "location": "96/ACT",
            "narrator": "",
            "text": "何もないよ",
            "zh": "什么都没有哦",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "つばめ",
            "text": "よかった(o´Д`)=з",
            "zh": "太好了(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "99/TALK",
            "narrator": "つばめ",
            "text": "そっちが大変なのかと思ったよ",
            "zh": "我还以为那边才辛苦呢",
            "narrator_zh": "燕"
        },
        {
            "location": "101/TALK",
            "narrator": "つばめ",
            "text": "こっちは凄く楽しぃよ(*´︶`*)",
            "zh": "这边特别开心哦(*´︶`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "102/ACT",
            "narrator": "",
            "text": "何用？",
            "zh": "有什么事？",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "つばめ",
            "text": "ぅぅん",
            "zh": "唔唔",
            "narrator_zh": "燕"
        },
        {
            "location": "105/TALK",
            "narrator": "つばめ",
            "text": "特に用事はなぃの(●´ω｀●)ゞ",
            "zh": "倒也没有什么特别的事(●´ω｀●)ゞ",
            "narrator_zh": "燕"
        },
        {
            "location": "106/TALK",
            "narrator": "つばめ",
            "text": "ただ",
            "zh": "只是",
            "narrator_zh": "燕"
        },
        {
            "location": "107/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんとお話したくなって(´ω｀*)",
            "zh": "我忽然想跟$handle$聊聊(´ω｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "108/TALK",
            "narrator": "つばめ",
            "text": "それで声掛けたの(´∀｀*)ｳﾌﾌ",
            "zh": "所以我才开口的(´∀｀*)嘻嘻",
            "narrator_zh": "燕"
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "今はまったりタィムだけど",
            "zh": "虽然现在是悠闲时间",
            "narrator_zh": "燕"
        },
        {
            "location": "111/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんが起きたら",
            "zh": "等加布醒来以后",
            "narrator_zh": "燕"
        },
        {
            "location": "112/TALK",
            "narrator": "つばめ",
            "text": "沖まで泳ごぅって約束してるんだ",
            "zh": "我们约好要游到远海那边去",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "つばめ",
            "text": "凄く楽しみ(*≧∀≦*) ",
            "zh": "好期待呀(*≧∀≦*)",
            "narrator_zh": "燕"
        },
        {
            "location": "116/SEL",
            "narrator": "",
            "text": "はしゃいでるみたいだね",
            "zh": "好像玩得挺嗨呢",
            "narrator_zh": ""
        },
        {
            "location": "117/ACT",
            "narrator": "",
            "text": "はしゃいでるみたいだね",
            "zh": "好像玩得挺嗨呢",
            "narrator_zh": ""
        },
        {
            "location": "119/TALK",
            "narrator": "つばめ",
            "text": "友達と海で遊ぶのって初めてだから",
            "zh": "因为我还是第一次跟朋友来海边玩",
            "narrator_zh": "燕"
        },
        {
            "location": "120/TALK",
            "narrator": "つばめ",
            "text": "凄く楽しくてｖ(*´∀｀*)ｖ",
            "zh": "特别开心ｖ(*´∀｀*)ｖ",
            "narrator_zh": "燕"
        },
        {
            "location": "122/SEL",
            "narrator": "",
            "text": "いっぱい楽しんでね",
            "zh": "玩得开心点哦",
            "narrator_zh": ""
        },
        {
            "location": "123/ACT",
            "narrator": "",
            "text": "いっぱい楽しんでね",
            "zh": "玩得开心点哦",
            "narrator_zh": ""
        },
        {
            "location": "125/TALK",
            "narrator": "つばめ",
            "text": "ぅん",
            "zh": "嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "126/TALK",
            "narrator": "つばめ",
            "text": "そぅするよ(*´ω｀*)",
            "zh": "就那么办(*´ω｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "139/TALK",
            "narrator": "つばめ",
            "text": "…ガブちゃん、\n早く起きないかなぁ？",
            "zh": "……加布她\n怎么还不起来呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "…いや、まだ三分も\n経ってないし、\n寝つけてもないから…。",
            "zh": "……不，这才过了\n不到三分钟，\n我根本还没睡着好吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "18/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月某日　 3:16 PM</color>\n合宿中、みやびの実家近くの砂浜にて",
            "zh": "<color=green>8月某日　 3:16 PM</color>\n合宿期间，雅的老家附近的沙滩上",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
