    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "013_総天然肉球の魅力",
            "zh": "013_纯天然肉球的魅力",
            "narrator_zh": ""
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "時に$handle$よ",
            "zh": "且说，$handle$",
            "narrator_zh": "雅"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "肉球は天然と人工のどちらが好きかね",
            "zh": "肉球你喜欢天然的还是人工的咩",
            "narrator_zh": "雅"
        },
        {
            "location": "35/SEL",
            "narrator": "",
            "text": "質問の意味がわかりません",
            "zh": "听不懂这个问题的意思",
            "narrator_zh": ""
        },
        {
            "location": "36/SEL",
            "narrator": "",
            "text": "やっぱり天然かな",
            "zh": "果然还是天然吧",
            "narrator_zh": ""
        },
        {
            "location": "37/SEL",
            "narrator": "",
            "text": "肉球は全て素晴らしい",
            "zh": "肉球全都很棒",
            "narrator_zh": ""
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "にくきゅうだぞ？",
            "zh": "是肉球哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "46/ACT",
            "narrator": "",
            "text": "質問の意味がわかりません",
            "zh": "听不懂这个问题的意思",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "なんと",
            "zh": "什么",
            "narrator_zh": "雅"
        },
        {
            "location": "48/ACT",
            "narrator": "",
            "text": "やっぱり天然かな",
            "zh": "果然还是天然吧",
            "narrator_zh": ""
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "天然原理主義者め",
            "zh": "你这个天然原理主义者",
            "narrator_zh": "雅"
        },
        {
            "location": "50/ACT",
            "narrator": "",
            "text": "肉球は全て素晴らしい",
            "zh": "肉球全都很棒",
            "narrator_zh": ""
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "また分かった風な口を",
            "zh": "又是一副懂了的口气",
            "narrator_zh": "雅"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "その通りだが",
            "zh": "不过说得对",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "そして皆に肉球を付けるとすれば",
            "zh": "那么，要是给大家都装上肉球",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "それは天然か人工か？",
            "zh": "那是天然还是人工？",
            "narrator_zh": "雅"
        },
        {
            "location": "58/SEL",
            "narrator": "",
            "text": "だから何の話？",
            "zh": "所以到底在说什么？",
            "narrator_zh": ""
        },
        {
            "location": "59/SEL",
            "narrator": "",
            "text": "後付けだから人工かな",
            "zh": "是后加的，所以是人工吧",
            "narrator_zh": ""
        },
        {
            "location": "60/SEL",
            "narrator": "",
            "text": "天然！　天然！　天然！",
            "zh": "天然！　天然！　天然！",
            "narrator_zh": ""
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "こんな簡単なこともわからんのか？",
            "zh": "这么简单的事都没懂吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "69/ACT",
            "narrator": "",
            "text": "だから何の話？",
            "zh": "所以到底在说什么？",
            "narrator_zh": ""
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "即ち",
            "zh": "也就是",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "肉球の話ぞね",
            "zh": "肉球的事咧",
            "narrator_zh": "雅"
        },
        {
            "location": "72/ACT",
            "narrator": "",
            "text": "後付けだから人工かな",
            "zh": "是后加的，所以是人工吧",
            "narrator_zh": ""
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "ふむ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "ご名答",
            "zh": "答得好",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "正しすぎてつまらんちや",
            "zh": "正确过头，没意思滴",
            "narrator_zh": "雅"
        },
        {
            "location": "76/ACT",
            "narrator": "",
            "text": "天然！　天然！　天然！",
            "zh": "天然！　天然！　天然！",
            "narrator_zh": ""
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "熱意は受け取った",
            "zh": "热情我收到了",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "要は",
            "zh": "说到底",
            "narrator_zh": "雅"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "秋葉原には肉球を纏う女子が接待する店があると聞く",
            "zh": "听说秋叶原有店，是包着肉球的女生在接待",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "$handle$の見解を述べよ",
            "zh": "说说$handle$的看法",
            "narrator_zh": "雅"
        },
        {
            "location": "82/SEL",
            "narrator": "",
            "text": "みやびがするならなんでもいい",
            "zh": "要是雅来做，怎样都行",
            "narrator_zh": ""
        },
        {
            "location": "83/SEL",
            "narrator": "",
            "text": "興味ない",
            "zh": "没兴趣",
            "narrator_zh": ""
        },
        {
            "location": "84/SEL",
            "narrator": "",
            "text": "肉球最高！！！！！",
            "zh": "肉球最棒！！！！！",
            "narrator_zh": ""
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "ということだ",
            "zh": "就是这么回事",
            "narrator_zh": "雅"
        },
        {
            "location": "86/ACT",
            "narrator": "",
            "text": "みやびがするならなんでもいい",
            "zh": "要是雅来做，怎样都行",
            "narrator_zh": ""
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "なんでもいいとは",
            "zh": "怎样都行是什么意思",
            "narrator_zh": "雅"
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "わらわが聞いておるのは",
            "zh": "我问的是",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "にくきゅうだぞ？",
            "zh": "是肉球哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "それを何でもいいとは",
            "zh": "你对这个说怎样都行",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "なんなんだ！",
            "zh": "到底怎么回事！",
            "narrator_zh": "雅"
        },
        {
            "location": "93/ACT",
            "narrator": "",
            "text": "興味ない",
            "zh": "没兴趣",
            "narrator_zh": ""
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "雅"
        },
        {
            "location": "95/TALK",
            "narrator": "みやび",
            "text": "クールジャパン、かっこ悪いということか",
            "zh": "酷日本，很逊，是这个意思吗",
            "narrator_zh": "雅"
        },
        {
            "location": "96/ACT",
            "narrator": "",
            "text": "肉球最高！！！！！",
            "zh": "肉球最棒！！！！！",
            "narrator_zh": ""
        },
        {
            "location": "97/TALK",
            "narrator": "みやび",
            "text": "うわ",
            "zh": "哇",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "本気も本気ぞね",
            "zh": "认真也太认真了咧",
            "narrator_zh": "雅"
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "とりあえず",
            "zh": "总之",
            "narrator_zh": "雅"
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "$handle$の肉球にかける思い",
            "zh": "$handle$寄托在肉球上的心意",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "みやび",
            "text": "受け取ったぞね",
