{
    "dir": "chap23/daydra/dd_ch01_23_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "23152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "思い出の写真",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "回忆的照片"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "思い出の写真",
            "zh": "回忆的照片",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "つばめ",
            "text": "えっ、花火？",
            "zh": "哎，烟花？",
            "narrator_zh": "燕"
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "うん、だって夏なのよ？",
            "zh": "嗯，毕竟现在是夏天嘛？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "27/TALK",
            "narrator": "ガブリエラ",
            "text": "日本の夏といえば、\n花火をやらなきゃ\n終われないでしょ。",
            "zh": "说到日本的夏天，\n不放烟花的话\n可没法收尾吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "みやび",
            "text": "そんなもんせんでも、\nいずれ夏は秋へ変わり\n冬が来るぞね。",
            "zh": "不做那种事，\n夏天早晚也会变成秋天，\n冬天照样会来咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "気持ち的な問題よ。",
            "zh": "这是心情问题。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…花火をしないと\n夏が終わらないかどうかは\nわからないわ。",
            "zh": "呵呵……不放烟花\n夏天会不会结束\n我倒是不知道。",
            "narrator_zh": "绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "アーヤ",
            "text": "けど、花火をするのには\n賛成よ。",
            "zh": "不过，放烟花\n我赞成哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "みんなで思い出になる\nようなこと、\nしたかったし。",
            "zh": "我也想和大家\n做些能留作\n回忆的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "つばめ",
            "text": "わたしも賛成です！\n神楽ちゃんは？",
            "zh": "我也赞成！\n神乐呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "神楽",
            "text": "あ、はい…。\n私も、いいと思いますよ。",
            "zh": "啊，好……。\n我也觉得不错哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "46/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびは？",
            "zh": "雅呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "みやび",
            "text": "うちも構わんよ。\n花火の臭いは\n嫌いやないしね。",
            "zh": "我也无所谓咯。\n烟花的味道\n本来也不讨厌啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "アーヤ",
            "text": "じゃ、決まりね。\n早速買いに行きましょ。",
            "zh": "那就这么定了。\n这就去买吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "つばめ",
            "text": "あ、アーヤさん。\nわたし、お留守番してて\nいいですか？",
            "zh": "啊，绫水。\n我可以留下来\n看家吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "お世話になったお礼に、\n家のお掃除をしようかな、\nって思ってて。",
            "zh": "想着作为受照顾的谢礼，\n帮着把家里\n打扫一下。",
            "narrator_zh": "燕"
        },
        {
            "location": "57/TALK",
            "narrator": "神楽",
            "text": "じゃあ、私も残って\nつばめさんを手伝います。",
            "zh": "那我也留下来\n帮燕吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは行くわ。\nちょっと散歩したい\n気分だったし。",
            "zh": "我去。\n刚好我也有点\n想散散步。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "みやびはどうする？",
            "zh": "雅怎么办？",
            "narrator_zh": "绫水"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "…そうやなぁ…。\nほったらかしやった\n自室の掃除でもするがよ。",
            "zh": "……也是啵……。\n那就去收拾一下\n一直丢着不管的房间咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "アーヤ",
            "text": "決まりね。\nそれじゃあ、\nささっと行ってくるわ。",
            "zh": "那就这么定了。\n那我们\n快去快回。",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "つばめ",
            "text": "ふぅ…。\n床拭きおしまい！",
            "zh": "呼……。\n擦完地板了！",
            "narrator_zh": "燕"
        },
        {
            "location": "87/TALK",
            "narrator": "つばめ",
            "text": "えへへ、ピカピカ…。\nやっぱりお掃除すると\n気持ちいいなぁ…。",
            "zh": "诶嘿嘿，亮晶晶的……。\n果然打扫完卫生\n心情就是舒畅呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "…神楽ちゃんの方も、\nそろそろ終わったかな？",
            "zh": "……神乐那边，\n也差不多结束了吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "100/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "101/TALK",
            "narrator": "神楽",
            "text": "…ふふっ。",
            "zh": "……呵呵。",
            "narrator_zh": "神乐"
        },
        {
            "location": "104/TALK",
            "narrator": "つばめ",
            "text": "あ、神楽ちゃん。\nお掃除終わったんだ？",
            "zh": "啊，神乐。\n打扫完了呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "107/TALK",
            "narrator": "神楽",
            "text": "きゃっ！？",
            "zh": "呀！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "108/TALK",
            "narrator": "つばめ",
            "text": "あ、ごめん…。\n驚かせちゃった？",
            "zh": "啊，对不起……。\n吓到你了？",
            "narrator_zh": "燕"
        },
        {
            "location": "109/TALK",
            "narrator": "神楽",
            "text": "いえ、私こそ…。\n写真に夢中になり過ぎて\nました…。",
            "zh": "不，我才是……。\n看照片看得\n太入迷了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "写真？",
            "zh": "照片？",
            "narrator_zh": "燕"
        },
        {
            "location": "112/TALK",
            "narrator": "神楽",
            "text": "はい…トライナリーに\n入隊してから、今までに\n撮ってきた写真です。",
            "zh": "是的……是加入三重奏\n之后，到现在为止\n拍下来的照片。",
            "narrator_zh": "神乐"
        },
        {
            "location": "114/TALK",
            "narrator": "神楽",
            "text": "あ、ほらこの写真。\n覚えてますか？",
            "zh": "啊，你看这张照片。\n还记得吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "118/TALK",
            "narrator": "つばめ",
            "text": "あ、懐かしい！",
            "zh": "啊，好怀念！",
            "narrator_zh": "燕"
        },
        {
            "location": "119/TALK",
            "narrator": "つばめ",
            "text": "これ、神楽ちゃんが\n転校してきた日の\n写真だよね？",
            "zh": "这是神乐\n转学过来那天的\n照片对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "121/TALK",
            "narrator": "神楽",
            "text": "正解です。\nそれじゃ…これは？",
            "zh": "答对了。\n那么……这张呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "123/TALK",
            "narrator": "つばめ",
            "text": "覚えてるよ。\n初めて寄り道して\n帰った日の写真だよ。",
            "zh": "记得呀。\n是第一次顺路逛着\n回家那天的照片呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "124/TALK",
            "narrator": "つばめ",
            "text": "あの時食べたたい焼き、\n美味しかったなぁ…。",
            "zh": "那时候吃的鲷鱼烧，\n好好吃呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "126/TALK",
            "narrator": "神楽",
            "text": "もう…、つばめさんは\nたい焼きがあったから\n覚えてたんですか？",
            "zh": "真是的……，燕\n该不会是因为有鲷鱼烧\n才记住的吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "128/TALK",
            "narrator": "つばめ",
            "text": "ち、違うよ！\nたい焼きのこと以外も\nちゃんと覚えてるから。",
            "zh": "才、才不是！\n除了鲷鱼烧以外的事，\n我也记得清清楚楚的。",
            "narrator_zh": "燕"
        },
        {
            "location": "130/TALK",
            "narrator": "神楽",
            "text": "じゃあ、\nこれは覚えてますか？",
            "zh": "那，\n这张还记得吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "132/TALK",
            "narrator": "つばめ",
            "text": "えっと…あ、これって\n秋葉原に行った時の\n写真だよ。",
            "zh": "那个……啊，这张是\n去秋叶原时候的\n照片呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "133/TALK",
            "narrator": "つばめ",
            "text": "あの…えっと…、\n凄い本がいっぱいの\n本屋の前だよね？",
            "zh": "那个……呃……、\n是摆满厉害书的那家\n书店门口对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "136/TALK",
            "narrator": "神楽",
            "text": "さすがつばめさん！\nもしかして、あのお店\nまた行きたいですか？",
            "zh": "真不愧是燕！\n难道说，那家店\n你还想再去吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "138/TALK",
            "narrator": "つばめ",
            "text": "えっと…か、神楽ちゃんが\n一緒なら…。",
            "zh": "那个……要、要是神乐\n一起去的话……。",
            "narrator_zh": "燕"
        },
        {
            "location": "140/TALK",
            "narrator": "神楽",
            "text": "一人で行くのも、\nドキドキして\n楽しいですよ？",
            "zh": "一个人去，\n心跳加速的\n也很有趣哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "141/TALK",
            "narrator": "つばめ",
            "text": "わ、わたしにはちょっと、\n早過ぎるかも…。",
            "zh": "对、对我来说可能\n还有点太早了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "143/TALK",
            "narrator": "神楽",
            "text": "ふふっ…。",
            "zh": "呵呵……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "145/TALK",
            "narrator": "神楽",
            "text": "でも、こうして写真を\n見てて思ったんです。",
            "zh": "不过，像这样看着\n照片，我就想啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "146/TALK",
            "narrator": "神楽",
            "text": "私達、まだ出会ってから\n数カ月しか経ってないん\nだな、って…。",
            "zh": "我们从相识到现在，\n居然才过去了\n几个月呀……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "147/TALK",
            "narrator": "つばめ",
            "text": "…そうだね。\nなんだか、凄く長い時間\n一緒にいる気がするよ。",
            "zh": "……是呀。\n总觉得，好像已经在\n一起待了好久好久了。",
            "narrator_zh": "燕"
        },
        {
            "location": "148/TALK",
            "narrator": "神楽",
            "text": "そうですね…。",
            "zh": "是啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "150/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃん。\n東京に戻ったら、\nまた二人でお出かけしよ。",
            "zh": "神乐。\n回东京之后，\n我们两个人再去逛街吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "154/TALK",
            "narrator": "神楽",
            "text": "お出かけ、ですか？",
            "zh": "去逛街，吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "155/TALK",
            "narrator": "つばめ",
            "text": "うん。また新しい思いでの\n写真増やしたいんだ。",
            "zh": "嗯。我想再多攒点\n新的回忆照片呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "156/TALK",
            "narrator": "つばめ",
            "text": "それと、\n秋葉原も行きたいな。",
            "zh": "还有，\n也想去秋叶原。",
            "narrator_zh": "燕"
        },
        {
            "location": "157/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんおすすめの\nお店、まだまだ教えて\nほしいし。",
            "zh": "神乐推荐的店，\n我还想\n多知道几家呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "159/TALK",
            "narrator": "神楽",
            "text": "任せてください。\nつばめさんが喜びそうな\nお店を、まだまだ――",
            "zh": "包在我身上。\n燕会喜欢的店，\n还有好多——",
            "narrator_zh": "神乐"
        },
        {
            "location": "160/TALK",
            "narrator": "神楽",
            "text": "あっ………。",
            "zh": "啊………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "161/TALK",
            "narrator": "つばめ",
            "text": "…神楽ちゃん？",
            "zh": "……神乐？",
            "narrator_zh": "燕"
        },
        {
            "location": "164/TALK",
            "narrator": "神楽",
            "text": "…いえ…また、一緒に\nお出かけできれば\n嬉しいんですけど…。",
            "zh": "……不……如果能\n再一起出去玩的话，\n我也会很高兴的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "165/TALK",
            "narrator": "つばめ",
            "text": "うん、だからまた一緒に\nお出かけしよ？",
            "zh": "嗯，所以再一起\n出去玩吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "166/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "169/TALK",
            "narrator": "神楽",
            "text": "ごめんなさい。\nちょっと、やることが\nあるので…。",
            "zh": "对不起。\n我还有点事\n要办……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "174/TALK",
            "narrator": "つばめ",
            "text": "あっ、神楽ちゃん…。",
            "zh": "啊，神乐……。",
            "narrator_zh": "燕"
        },
        {
            "location": "176/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "177/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、まだダメかな？",
            "zh": "果然，还是不行吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "190/TALK",
            "narrator": "つばめ",
            "text": "辛ぃな",
            "zh": "好难受呀",
            "narrator_zh": "燕"
        },
        {
            "location": "192/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんと",
            "zh": "和神乐",
            "narrator_zh": "燕"
        },
        {
            "location": "193/TALK",
            "narrator": "つばめ",
            "text": "まだ",
            "zh": "还是",
            "narrator_zh": "燕"
        },
        {
            "location": "194/TALK",
            "narrator": "つばめ",
            "text": "前みたぃに話せなぃ(o´Д`)=з",
            "zh": "没法像以前那样说话(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "195/TALK",
            "narrator": "つばめ",
            "text": "結構よくなったけど",
            "zh": "虽然比之前好多了",
            "narrator_zh": "燕"
        },
        {
            "location": "196/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "燕"
        },
        {
            "location": "197/TALK",
            "narrator": "つばめ",
            "text": "まだ全然なの(´･ω･｀) ",
            "zh": "还是差得远呀(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "198/TALK",
            "narrator": "つばめ",
            "text": "東京戻っても",
            "zh": "就算回了东京",
            "narrator_zh": "燕"
        },
        {
            "location": "199/TALK",
            "narrator": "つばめ",
            "text": "しばらくは",
            "zh": "暂时也还会",
            "narrator_zh": "燕"
        },
        {
            "location": "200/TALK",
            "narrator": "つばめ",
            "text": "この状態なのかな？",
            "zh": "一直这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "203/TALK",
            "narrator": "つばめ",
            "text": "だとしたら",
            "zh": "如果是那样",
            "narrator_zh": "燕"
        },
        {
            "location": "205/TALK",
            "narrator": "つばめ",
