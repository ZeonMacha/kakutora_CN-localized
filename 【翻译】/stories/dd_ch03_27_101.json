            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "そりゃあたしだって\n同じ気持ちだけど……",
            "zh": "话是这么说，其实我也\n是一样的心情啦……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "235/TALK",
            "narrator": "ガブリエラ",
            "text": "って、そうじゃなくて！\n今は早くマークスマンの\n所にいかないと！",
            "zh": "不对，不是说这个的时候！\n现在得赶紧去神射手\n那里才行！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "236/SEL",
            "narrator": "",
            "text": "そうですね、すみません",
            "zh": "说得也是，抱歉",
            "narrator_zh": ""
        },
        {
            "location": "237/SEL",
            "narrator": "",
            "text": "せめてウェディングドレスだけでも！",
            "zh": "至少让我看看婚纱也好啊！",
            "narrator_zh": ""
        },
        {
            "location": "238/ACT",
            "narrator": "",
            "text": "そうですね、すみません",
            "zh": "说得也是，抱歉",
            "narrator_zh": ""
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。\nまったくもう。",
            "zh": "哈啊……。\n真是受不了你。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "この忙しいときに、\nくだらないこと\n言ってないで。",
            "zh": "这么忙的时候，\n别净说些没营养的\n废话啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/ACT",
            "narrator": "",
            "text": "せめてウェディングドレスだけでも！",
            "zh": "至少让我看看婚纱也好啊！",
            "narrator_zh": ""
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "はああああ！？",
            "zh": "哈啊啊啊啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "246/TALK",
            "narrator": "ガブリエラ",
            "text": "も、もう！\nわかったわよ！",
            "zh": "真、真是的！\n我知道了啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "259/TALK",
            "narrator": "ガブリエラ",
            "text": "はい！\nこれでいい？",
            "zh": "好！\n这样总行了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "260/SEL",
            "narrator": "",
            "text": "最高です！",
            "zh": "太棒了！",
            "narrator_zh": ""
        },
        {
            "location": "261/SEL",
            "narrator": "",
            "text": "愛してる！",
            "zh": "我爱你！",
            "narrator_zh": ""
        },
        {
            "location": "262/ACT",
            "narrator": "",
            "text": "最高です！",
            "zh": "太棒了！",
            "narrator_zh": ""
        },
        {
            "location": "263/TALK",
            "narrator": "ガブリエラ",
            "text": "ほんとにもう…。",
            "zh": "真是拿你没办法……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "264/ACT",
            "narrator": "",
            "text": "最高です！",
            "zh": "太棒了！",
            "narrator_zh": ""
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "だ、だから！\nそれは現実のあたしに\n言ってよね？",
            "zh": "所、所以说！\n这种话要对现实的我\n去说才行啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "ガブリエラ",
            "text": "もうベースは\n十分準備OKに\nなってるから！",
            "zh": "我这边的底子\n早就充分准备OK\n了嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "269/TALK",
            "narrator": "ガブリエラ",
            "text": "式なんてやってる暇ない\nから、このままマークス\nマンの所へ行くわよ？",
            "zh": "现在可没工夫办仪式\n了，就这样直接去\n神射手那里咯？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/SEL",
            "narrator": "",
            "text": "それは正式なご挨拶と考えてよろしいか",
            "zh": "我可以把它当成正式的问候吗",
            "narrator_zh": ""
        },
        {
            "location": "271/ACT",
            "narrator": "",
            "text": "それは正式なご挨拶と考えてよろしいか",
            "zh": "我可以把它当成正式的问候吗",
            "narrator_zh": ""
        },
        {
            "location": "273/TALK",
            "narrator": "ガブリエラ",
            "text": "はいはい、\nよろしいよろしい。",
            "zh": "好好好，\n可以可以。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "279/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、\n扉を回すわね。",
            "zh": "那么，\n我要转动门扉咯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "283/TALK",
            "narrator": "ガブリエラ",
            "text": "オープンプロセス、\n0xFA1番地から\nC3:7:CB1//1x0FF番地へ。",
            "zh": "开放进程，\n从0xFA1号地址前往\nC3:7:CB1//1x0FF号地址。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "288/TALK",
            "narrator": "ガブリエラ",
            "text": "スピードアップ。",
            "zh": "提升速度。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "292/TALK",
            "narrator": "ガブリエラ",
            "text": "更に加速。",
            "zh": "继续加速。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "ガブリエラ",
            "text": "相変わらず\n酷い有様ね。",
            "zh": "还是一如既往地\n惨不忍睹呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "327/TALK",
            "narrator": "ガブリエラ",
            "text": "こっちよ。",
            "zh": "这边走。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "336/TALK",
            "narrator": "ガブリエラ",
            "text": "…ここ。",
            "zh": "……就是这里。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "337/SEL",
            "narrator": "",
            "text": "ここって…",
            "zh": "这里是……",
            "narrator_zh": ""
        },
        {
            "location": "338/ACT",
            "narrator": "",
            "text": "ここって…",
            "zh": "这里是……",
            "narrator_zh": ""
        },
        {
            "location": "340/TALK",
            "narrator": "ガブリエラ",
            "text": "大丈夫。\n取って食われたりは\nしないから。",
            "zh": "放心。\n不会把你抓去\n吃掉的啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "341/TALK",
            "narrator": "ガブリエラ",
            "text": "既にここからでも\n感じるの。マークスマンの\n様子がおかしいってこと。",
            "zh": "哪怕站在这里，我也已经\n能感觉到了。神射手的\n状态不太对劲。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "342/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、みやびの家での\n神楽の事件と、横須賀での\n発言が問題だったのかも。",
            "zh": "果然，还是在雅家里的\n神乐事件，还有在横须贺\n说的那句话惹出的祸吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "343/TALK",
            "narrator": "ガブリエラ",
            "text": "あの時から、\nあたしは少しずつ\n変わってる気がするの。",
            "zh": "从那时候起，\n我总觉得自己正在\n一点点地发生变化。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "344/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$は\nあたしを見ていて\nどう思う？",
            "zh": "$handle$你\n看着我，\n觉得怎么样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "345/SEL",
            "narrator": "",
            "text": "とりあえずマークスマンについてもうちょっと詳しく教えて欲しい",
            "zh": "首先希望你能再详细告诉我一些关于神射手的事",
            "narrator_zh": ""
        },
        {
            "location": "346/SEL",
            "narrator": "",
            "text": "とりあえずガブリエラの実家に二人きりで来てることに感極まってる",
            "zh": "首先光是能两个人单独来到加布里埃拉老家我就百感交集了",
            "narrator_zh": ""
        },
        {
            "location": "347/ACT",
            "narrator": "",
            "text": "とりあえずマークスマンについてもうちょっと詳しく教えて欲しい",
            "zh": "首先希望你能再详细告诉我一些关于神射手的事",
            "narrator_zh": ""
        },
        {
            "location": "348/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "349/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね。",
            "zh": "说得也是。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "350/TALK",
            "narrator": "ガブリエラ",
            "text": "確かに\nここまでつき合わせて\n秘密も何も無いものね。",
            "zh": "确实\n都拉着你陪到这里了，\n也没什么好隐瞒的了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "351/TALK",
            "narrator": "ガブリエラ",
            "text": "マークスマンは、\nあたしたちの中の\nあたしたち。",
            "zh": "神射手是，\n我们之中的\n我们。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "352/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしを形成する中でも\nもっとあたしという人間を\n色濃く作り出してる存在。",
            "zh": "在构成我的诸多存在中，\n更是浓墨重彩地塑造出\n“我”这个人的核心存在。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "353/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、あたしみたいな\n一人格がどうかなっても\n大した問題は無いけど――",
            "zh": "所以，就算像我这样的\n区区一个人格出了什么事\n也算不上什么大问题——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "354/TALK",
            "narrator": "ガブリエラ",
            "text": "マークスマンの考え方が\n変われば、あたしの性格は\n大きく変わるし――",
            "zh": "但只要神射手的想法\n发生改变，我的性格就会\n随之剧烈改变——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "355/TALK",
            "narrator": "ガブリエラ",
            "text": "マークスマンが発症すれば\nフェノメノンになる。",
            "zh": "一旦神射手发病，\n就会化作PhenoMENON。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "356/SEL",
            "narrator": "",
            "text": "それって、今ガブリエラたちが戦ってるフェノメノンのこと？",
            "zh": "那是指，现在加布里埃拉她们正在战斗的PhenoMENON吗？",
            "narrator_zh": ""
        },
        {
            "location": "357/ACT",
            "narrator": "",
            "text": "それって、今ガブリエラたちが戦ってるフェノメノンのこと？",
            "zh": "那是指，现在加布里埃拉她们正在战斗的PhenoMENON吗？",
            "narrator_zh": ""
        },
        {
            "location": "359/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ。",
            "zh": "没错哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "360/TALK",
            "narrator": "ガブリエラ",
            "text": "フェノメノン発症には\nとっても強い意志の力が\n必要なのよ。",
            "zh": "想要引发PhenoMENON，\n需要极为强大的\n意志之力。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "361/TALK",
            "narrator": "ガブリエラ",
            "text": "それは、あたしみたいな\n下っ端が発症したところで\n作り出せるものじゃない。",
            "zh": "那可不是像我这种\n小卒子就算发病\n也能制造出来的东西。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "362/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、あたしが発症\nしてもココロの中で暴れる\nレベルだけど――",
            "zh": "所以，我就算发病，\n顶多也只是在心灵之中\n大闹一场的程度——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "363/TALK",
            "narrator": "ガブリエラ",
            "text": "マークスマンが発症すれば\n現実に影響が出る。",
            "zh": "可一旦神射手发病，\n就会对现实产生影响。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "364/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、ザックリとした\n説明になっちゃったけど、\nだいたいこんな感じね。",
            "zh": "嘛，虽然只是粗略地\n解释了一下，\n大概就是这么回事吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "365/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、\n先へ進みましょ。",
            "zh": "那么，\n我们继续往前走吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "366/ACT",
            "narrator": "",
            "text": "とりあえずガブリエラの実家に二人きりで来てることに感極まってる",
            "zh": "首先光是能两个人单独来到加布里埃拉老家我就百感交集了",
            "narrator_zh": ""
        },
        {
            "location": "367/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね。\nあたしも嬉しいけど。",
            "zh": "是啊。\n我也很开心哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "368/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、こんな壊れた\n家じゃなければ、\nもっと良かったのにね。",
            "zh": "不过，要是能不是这么\n破败不堪的家，\n就更好了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "369/TALK",
            "narrator": "ガブリエラ",
            "text": "現実のあたしも、\n$handle$を家に\n招待すればいいのにね。",
            "zh": "要是现实中的我，\n也能邀请$handle$来家里\n做客就好了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "370/SEL",
            "narrator": "",
            "text": "旅費が大変そう",
            "zh": "路费好像会很吃力",
            "narrator_zh": ""
        },
        {
            "location": "371/SEL",
            "narrator": "",
            "text": "お父様にご挨拶します",
            "zh": "我会向令尊问候的",
            "narrator_zh": ""
        },
        {
            "location": "372/ACT",
            "narrator": "",
            "text": "旅費が大変そう",
            "zh": "路费好像会很吃力",
            "narrator_zh": ""
        },
        {
            "location": "373/TALK",
            "narrator": "ガブリエラ",
            "text": "そこはほら、\n愛の力でクリアするのよ。",
            "zh": "那种事嘛，\n靠爱的力量克服就好啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "374/ACT",
            "narrator": "",
            "text": "お父様にご挨拶します",
            "zh": "我会向令尊问候的",
            "narrator_zh": ""
        },
        {
            "location": "375/TALK",
            "narrator": "ガブリエラ",
            "text": "殺されるかも\nしれないけど。",
            "zh": "弄不好会被\n杀掉的哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "376/SEL",
            "narrator": "",
            "text": "それ本当なの？",
            "zh": "这是真的吗？",
            "narrator_zh": ""
        },
        {
            "location": "377/ACT",
            "narrator": "",
            "text": "それ本当なの？",
            "zh": "这是真的吗？",
            "narrator_zh": ""
        },
        {
            "location": "379/TALK",
            "narrator": "ガブリエラ",
            "text": "冗談よ。",
            "zh": "开玩笑的啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "380/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、常に臨戦状態で\n活動してる軍人だし――",
            "zh": "不过，他毕竟是时刻处于\n临战状态的军人——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "381/TALK",
            "narrator": "ガブリエラ",
            "text": "ヘラヘラしてたら\n多分家からたたき出される\nと思うわよ？",
            "zh": "要是嘻嘻哈哈的，\n搞不好真的会被从家里\n轰出去哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "382/TALK",
            "narrator": "ガブリエラ",
            "text": "タダでさえ、\nあたしもたたき出されてる\n身なんだから。",
            "zh": "本来嘛，\n我自己也是被轰出家门\n的处境呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "383/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、二人でたたき\n出されたら、二人きりの\n自由を満喫できるわね！",
            "zh": "不过，要是两个人一起被\n轰出来，倒是可以尽情享受\n二人世界的自由啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "385/TALK",
            "narrator": "ガブリエラ",
            "text": "……なんて冗談は\nさておき、\n先へ進まなくちゃ。",
            "zh": "……玩笑话就\n先放到一边，\n得赶紧往前走了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "390/TALK",
            "narrator": "ガブリエラ",
            "text": "え…！？",
            "zh": "诶……！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "391/TALK",
            "narrator": "ガブリエラの新司書　",
