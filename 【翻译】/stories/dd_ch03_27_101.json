    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "夕焼け空、気持ちはブルー",
            "zh": "晚霞满天，心情忧郁",
            "narrator_zh": ""
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "…。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "アーヤ",
            "text": "ふう。",
            "zh": "呼。",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえアーヤ。",
            "zh": "我说绫水。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "39/TALK",
            "narrator": "アーヤ",
            "text": "何？",
            "zh": "怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "さっきからため息\nばかりだけど。",
            "zh": "你刚才起就一直在\n叹气啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "そうやねえ。",
            "zh": "是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなにお姉さんに\n会いたくないの？",
            "zh": "你就那么不想\n见你姐姐吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "アーヤ",
            "text": "…え。",
            "zh": "……诶。",
            "narrator_zh": "绫水"
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "会いたくないって\nわけじゃないわ。",
            "zh": "倒也不是\n不想见。",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "でも気持ちはブルーなの。\n姉妹がいないとなかなか\nわからないと思うけど。",
            "zh": "只是心情有点忧郁罢了。\n没有姐妹的人大概\n不太能理解吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "何言ってるのよ。",
            "zh": "你在说什么呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "本当はお姉さんに会うの\n恥ずかしいだけでしょ？",
            "zh": "其实你只是不好意思\n去见姐姐吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "違うわよ。",
            "zh": "不是的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "アーヤ",
            "text": "そんな単純な話じゃ\nないの。",
            "zh": "不是那么简单的\n事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "素直に\n認めればいいのに。",
            "zh": "坦率承认\n不就好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "大人ぶってても\nすごく子供っぽいわ、\nそういうの。",
            "zh": "明明老是装大人，\n这种地方却幼稚得很，\n真是的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "…外の空気吸ってくる。",
            "zh": "……我去外面透透气。",
            "narrator_zh": "绫水"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "……。\nなんでお姉さんが絡むと\nああなのかしら。",
            "zh": "……。\n为什么一扯到她姐姐，\n就会变成那样呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "一言では表せんような\nことがあったんやろう。",
            "zh": "大概是有过一句话\n讲不清楚的事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、だからって…。",
            "zh": "不过，是吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "言いとうなる気持ちも\nわかるけんど。",
            "zh": "不过我也能理解\n你想说两句的心情。",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしが悪いみたいに\n言わないでよ！",
            "zh": "别说得好像全是\n我的错一样啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "まあまあ。\nお茶でも飲んで\n落ち着き。",
            "zh": "好啦好啦。\n喝口茶\n定定神咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ$marzanna$",
            "zh": "我说$marzanna$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "私悪いことを言ったのかしら？",
            "zh": "我是不是说了什么不该说的话？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/SEL",
            "narrator": "",
            "text": "なんとも",
            "zh": "不好说",
            "narrator_zh": ""
        },
        {
            "location": "83/SEL",
            "narrator": "",
            "text": "そうかも",
            "zh": "也许吧",
            "narrator_zh": ""
        },
        {
            "location": "84/SEL",
            "narrator": "",
            "text": "そんなことないんじゃない",
            "zh": "没那回事吧",
            "narrator_zh": ""
        },
        {
            "location": "85/ACT",
            "narrator": "",
            "text": "なんとも",
            "zh": "不好说",
            "narrator_zh": ""
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "そう",
            "zh": "是吗",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/ACT",
            "narrator": "",
            "text": "そうかも",
            "zh": "也许吧",
            "narrator_zh": ""
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなのね",
            "zh": "是这样啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/ACT",
            "narrator": "",
            "text": "そんなことないんじゃない",
            "zh": "没那回事吧",
            "narrator_zh": ""
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "違うかしら？",
            "zh": "不是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "本当は私",
            "zh": "其实我",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとアーヤを",
            "zh": "只是想稍微让绫水",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "元気にしたかったのに",
            "zh": "打起精神来而已",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/SEL",
            "narrator": "",
            "text": "ならそう言えばいい",
            "zh": "那就直接这么说嘛",
            "narrator_zh": ""
        },
        {
            "location": "98/SEL",
            "narrator": "",
            "text": "あれだと通じないだろうね",
            "zh": "那样说她大概领会不到吧",
            "narrator_zh": ""
        },
        {
            "location": "99/SEL",
            "narrator": "",
            "text": "ガブリエラはツンデレだなあ",
            "zh": "加布里埃拉真是傲娇啊",
            "narrator_zh": ""
        },
        {
            "location": "100/ACT",
            "narrator": "",
            "text": "ならそう言えばいい",
            "zh": "那就直接这么说嘛",
            "narrator_zh": ""
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "それだけの話なのね",
            "zh": "不过就这么回事而已",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/ACT",
            "narrator": "",
            "text": "あれだと通じないだろうね",
            "zh": "那样说她大概领会不到吧",
            "narrator_zh": ""
        },
        {
            "location": "107/TALK",
            "narrator": "ガブリエラ",
            "text": "通じないなら",
            "zh": "要是领会不到",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "意味ないわよね",
            "zh": "那就没意义了呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "私ったら",
            "zh": "我真是的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/ACT",
            "narrator": "",
            "text": "ガブリエラはツンデレだなあ",
            "zh": "加布里埃拉真是傲娇啊",
            "narrator_zh": ""
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "もう！",
            "zh": "真是的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな言い方",
            "zh": "别用那种说法",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "やめてよね！",
            "zh": "说我啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "みんなしてあたしが\n悪いみたいに…。",
            "zh": "一个个的都搞得好像\n全是我的错一样……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "でも確かにちょっと\n言い方は悪かった\n気がするわ。",
            "zh": "不过刚才说话的语气\n确实觉得有那么点\n过分了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "176/TALK",
            "narrator": "ガブリエラ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$！\nよく来たわね。",
            "zh": "$handle$！\n欢迎你来呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラ",
            "text": "前に来たときの約束、\nおぼえていて？",
            "zh": "上次来的时候做的约定，\n你还记得吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/SEL",
            "narrator": "",
            "text": "マークスマンの所へ行くんだっけ？",
            "zh": "是要去神射手那里对吧？",
            "narrator_zh": ""
        },
        {
            "location": "196/SEL",
            "narrator": "",
            "text": "あ、今回がガブリエラとの挙式回だったか！",
            "zh": "啊，这回是和加布里埃拉举行婚礼的一回啊！",
            "narrator_zh": ""
        },
        {
            "location": "197/ACT",
            "narrator": "",
            "text": "マークスマンの所へ行くんだっけ？",
            "zh": "是要去神射手那里对吧？",
            "narrator_zh": ""
        },
        {
            "location": "198/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ。",
            "zh": "没错哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "199/TALK",
            "narrator": "ガブリエラ",
            "text": "凄く嫌な予感がするから、\n一刻も早く\n向かいたいのよ。",
            "zh": "我有非常不好的预感，\n所以想一刻也不耽搁地\n赶过去呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "200/ACT",
            "narrator": "",
            "text": "あ、今回がガブリエラとの挙式回だったか！",
            "zh": "啊，这回是和加布里埃拉举行婚礼的一回啊！",
            "narrator_zh": ""
        },
        {
            "location": "203/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ！？",
            "zh": "哈啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "204/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうよ！！\nだから早く\n挙式の準備しなさいよ！",
            "zh": "……没错！！\n所以快去\n准备婚礼啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "206/SEL",
            "narrator": "",
            "text": "す、すみません、冗談です…",
            "zh": "对、对不起，开玩笑的……",
            "narrator_zh": ""
        },
        {
            "location": "207/SEL",
            "narrator": "",
            "text": "さあ、早く着替えて！",
            "zh": "来，快去换衣服吧！",
            "narrator_zh": ""
        },
        {
            "location": "208/ACT",
            "narrator": "",
            "text": "す、すみません、冗談です…",
            "zh": "对、对不起，开玩笑的……",
            "narrator_zh": ""
        },
        {
            "location": "210/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。\nまったくもう。",
            "zh": "哈啊……。\n真是受不了你。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "この忙しいときに、\n冗談とか言わないで。",
            "zh": "这么忙的时候，\n别开这种玩笑啦。",
