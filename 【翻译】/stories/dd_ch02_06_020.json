{
    "dir": "chap06/daydra/dd_ch02_06_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "6256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "カップル現る",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "情侣现身"
    },
    "entry": [
        {
            "location": "318/SCENARIO",
            "narrator": "",
            "text": "カップル現る",
            "zh": "情侣现身",
            "narrator_zh": ""
        },
        {
            "location": "338/TALK",
            "narrator": "みやび",
            "text": "おおっ…\n盛り上がっちゅう\nなぁ…。",
            "zh": "哦……\n热闹得很\n啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "341/TALK",
            "narrator": "アーヤ",
            "text": "こら、みやび。\n上映中なんだから、\n中を覗いたらダメよ？",
            "zh": "喂，雅。\n正在放映，\n不许往里偷看哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "344/TALK",
            "narrator": "みやび",
            "text": "おっ、えいところに\n来た。アーヤ、ちくっ\nと中を覗いてみぃ。",
            "zh": "哦，来得正好。\n绫水，往里\n看一哈。",
            "narrator_zh": "雅"
        },
        {
            "location": "346/TALK",
            "narrator": "アーヤ",
            "text": "もぉ…何があるって\nいうのよ？",
            "zh": "真是的……里面\n有什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "348/TALK",
            "narrator": "アーヤ",
            "text": "…ちょっ！？\nあ、あれなに！？",
            "zh": "……等！？\n那、那是什么！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "349/TALK",
            "narrator": "みやび",
            "text": "見てわからんがか？\n高校生のカップルや。",
            "zh": "看不出来吗？\n是高中生情侣咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "350/TALK",
            "narrator": "みやび",
            "text": "他に客がおらんのを\nえいことに、チュッチュ\nしまくりやね。",
            "zh": "没别的客人，\n正好不停地亲\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "354/TALK",
            "narrator": "アーヤ",
            "text": "チュッチュじゃなくて、\nもっと凄いことに\nなってない？",
            "zh": "不是亲亲，\n是不是已经更\n厉害了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "357/TALK",
            "narrator": "みやび",
            "text": "ディープなやつやね。\n生で見たん初めてや\nけんど――",
            "zh": "很深的那种咯。\n真人还是第一次见，\n不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "358/TALK",
            "narrator": "みやび",
            "text": "思うてたより、\nなんか…\n気色悪いな。",
            "zh": "比我想的，\n总觉得……\n有点恶心。",
            "narrator_zh": "雅"
        },
        {
            "location": "360/TALK",
            "narrator": "アーヤ",
            "text": "今どきの高校生って、\nあれが\n普通なのかしら…？",
            "zh": "现在的高中生，\n那样\n算普通吗……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "362/TALK",
            "narrator": "アーヤ",
            "text": "って、\nそうじゃなくて！",
            "zh": "等，\n不是这个！",
            "narrator_zh": "绫水"
        },
        {
            "location": "364/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、\n注意した方が\n良いのかしら？",
            "zh": "果然，\n还是提醒一下\n比较好吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "365/TALK",
            "narrator": "みやび",
            "text": "いんや、今のところ\n注意する理由は\n見つからんよ。",
            "zh": "不，眼下\n找不到提醒的\n理由。",
            "narrator_zh": "雅"
        },
        {
            "location": "366/TALK",
            "narrator": "みやび",
            "text": "映画館でイチャつく\n程度、極々普通で\n当たり前のことやき。",
            "zh": "在电影院腻歪\n这个程度，非常普通，\n是理所当然的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "368/TALK",
            "narrator": "アーヤ",
            "text": "したこともないのに、\n何故堂々と言えるのか\n不思議でならないわ…。",
            "zh": "自己都没做过，\n为什么能说得这么理直气壮，\n真不可思议……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "370/TALK",
            "narrator": "アーヤ",
            "text": "でも、他のお客さんの\n迷惑に…。",
            "zh": "可是，会打扰\n别的客人……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "373/TALK",
            "narrator": "みやび",
            "text": "客はあのカップル以外、\nだ～れもおらんぞ。",
            "zh": "除了那对，\n一个客人都没有。",
            "narrator_zh": "雅"
        },
        {
            "location": "374/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、注意なんぞ\nしてみぃ。",
            "zh": "要不，你去\n提醒看看。",
            "narrator_zh": "雅"
        },
        {
            "location": "375/TALK",
            "narrator": "みやび",
            "text": "うちらが覗いてたん、\nバレるがよ？",
            "zh": "我们在偷看，\n会被发现咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "376/TALK",
            "narrator": "アーヤ",
            "text": "そ、それはそうだけど…。",
            "zh": "这、这倒是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "377/TALK",
            "narrator": "アーヤ",
            "text": "でも、盛り上がってこう、\nほら…わかるでしょ？",
            "zh": "可是，要是越来越起劲，\n那个……你懂吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "378/TALK",
            "narrator": "アーヤ",
            "text": "そうなってからじゃ\n遅いと思うし…。",
            "zh": "到那时候\n就晚了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "379/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "381/TALK",
            "narrator": "みやび",
            "text": "想像力豊かやねぇ。\nそういうところ、\n可愛くてえいと思うんよ。",
            "zh": "想象力真丰富咯。\n这种地方，\n我觉得可爱，很好。",
            "narrator_zh": "雅"
        },
        {
            "location": "382/TALK",
            "narrator": "アーヤ",
            "text": "からかわないでよ、\nもう！",
            "zh": "别逗我了，\n真是的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "383/TALK",
            "narrator": "みやび",
            "text": "まあ、なんにせよ\nうちはもう飽きたき、\n退散するわ。",
            "zh": "嘛，总之\n我看够了啵，\n先撤了。",
            "narrator_zh": "雅"
        },
        {
            "location": "384/TALK",
            "narrator": "みやび",
            "text": "アーヤも、\nあまり夢中に\nならんようにな。",
            "zh": "绫水也别\n看得\n太入迷。",
            "narrator_zh": "雅"
        },
        {
            "location": "388/TALK",
            "narrator": "アーヤ",
            "text": "もう、勝手なんだから…。",
            "zh": "真是的，太任性了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "389/TALK",
            "narrator": "アーヤ",
            "text": "でも、あの二人のこと、\n放っておいていいの\nかしら？",
            "zh": "可是，那两个人，\n放着不管\n好吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "390/TALK",
            "narrator": "アーヤ",
            "text": "確かにキスしか\nしてないように\n見えるけど――",
            "zh": "确实看起来\n只是在接吻\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "391/TALK",
            "narrator": "アーヤ",
            "text": "何かあるといけない\nから、やっぱり注意\nした方が良さそう…。",
            "zh": "万一出事就不好了，\n果然还是提醒\n比较好……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "393/TALK",
            "narrator": "アーヤ",
            "text": "う～ん…。",
            "zh": "唔——嗯……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "405/TALK",
            "narrator": "アーヤ",
            "text": "キスしてるカップルがいるの",
            "zh": "有情侣在接吻",
            "narrator_zh": "绫水"
        },
        {
            "location": "407/SEL",
            "narrator": "",
            "text": "普通でしょ？",
            "zh": "很普通吧？",
            "narrator_zh": ""
        },
        {
            "location": "408/ACT",
            "narrator": "",
            "text": "普通でしょ？",
            "zh": "很普通吧？",
            "narrator_zh": ""
        },
        {
            "location": "410/TALK",
            "narrator": "アーヤ",
            "text": "ごめん",
            "zh": "抱歉",
            "narrator_zh": "绫水"
        },
        {
            "location": "411/TALK",
            "narrator": "アーヤ",
            "text": "聞き方が悪かった",
            "zh": "问法不好",
            "narrator_zh": "绫水"
        },
        {
            "location": "412/TALK",
            "narrator": "アーヤ",
            "text": "劇場の中で、キスしてるカップルがいるの",
            "zh": "剧场里面，有情侣在接吻",
            "narrator_zh": "绫水"
        },
        {
            "location": "413/TALK",
            "narrator": "アーヤ",
            "text": "他の場所でならいいけど",
            "zh": "在别的地方倒还好",
            "narrator_zh": "绫水"
        },
        {
            "location": "414/TALK",
            "narrator": "アーヤ",
            "text": "上映中の劇場でするのは、よくないと思うの(｀ヘ´) ",
            "zh": "在放映中的剧场做，我觉得不好(｀ヘ´)",
            "narrator_zh": "绫水"
        },
        {
            "location": "415/TALK",
            "narrator": "アーヤ",
            "text": "注意した方がいいかしら？",
            "zh": "要不要提醒一下？",
            "narrator_zh": "绫水"
        },
        {
            "location": "417/SEL",
            "narrator": "",
            "text": "しばらく監視しよう",
            "zh": "先监视一会儿",
            "narrator_zh": ""
        },
        {
            "location": "418/SEL",
            "narrator": "",
            "text": "アーヤ、硬過ぎ！",
            "zh": "绫水，太死板了！",
            "narrator_zh": ""
        },
        {
            "location": "419/ACT",
            "narrator": "",
            "text": "しばらく監視しよう",
            "zh": "先监视一会儿",
            "narrator_zh": ""
        },
        {
            "location": "420/TALK",
            "narrator": "アーヤ",
            "text": "まだ許容範囲？",
            "zh": "还在能容忍的范围？",
            "narrator_zh": "绫水"
        },
        {
            "location": "421/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、監視するわ",
            "zh": "那，我监视着",
            "narrator_zh": "绫水"
        },
        {
            "location": "432/TALK",
            "narrator": "アーヤ",
            "text": "このままいくとあの\n二人、絶対にもっと\n凄いことしそうだもの。",
            "zh": "这样下去那\n两个人，绝对会做\n更厉害的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "434/TALK",
            "narrator": "アーヤ",
            "text": "不純異性交遊なんて、\nうちの劇場から出す\nわけにはいかないわ。",
            "zh": "不正当交往这种事，\n不能从我们剧场\n传出去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "435/TALK",
            "narrator": "アーヤ",
            "text": "…でも、さっきから\nずっとキスばかり…。",
            "zh": "……可是，从刚才起\n一直只是在接吻……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "436/TALK",
            "narrator": "アーヤ",
            "text": "口、疲れそうだなぁ…。",
            "zh": "嘴，会累吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "440/TALK",
            "narrator": "真幌",
            "text": "何をやっているんだ？",
            "zh": "在干什么？",
            "narrator_zh": "真幌"
        },
        {
            "location": "442/TALK",
            "narrator": "アーヤ",
            "text": "あっ、館長！",
            "zh": "啊，馆长！",
            "narrator_zh": "绫水"
        },
        {
            "location": "443/TALK",
            "narrator": "真幌",
            "text": "上映中に劇場の中を\n覗くんじゃない。\nアーヤらしくもないな。",
            "zh": "放映的时候别往\n剧场里偷看。\n不像绫水。",
            "narrator_zh": "真幌"
        },
        {
            "location": "447/TALK",
            "narrator": "アーヤ",
            "text": "す、すみません。\nでも、その…。",
            "zh": "对、对不起。\n可是，那个……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "448/TALK",
            "narrator": "真幌",
            "text": "…？\n中で何か起きてるのか？",
            "zh": "……？\n里面出什么事了？",
            "narrator_zh": "真幌"
        },
        {
            "location": "450/TALK",
            "narrator": "アーヤ",
            "text": "あ、はい。\n実はその…。",
            "zh": "啊，是。\n其实那个……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "453/TALK",
            "narrator": "真幌",
            "text": "ふむ…ああ、あれか。",
            "zh": "嗯……啊，那个啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "456/TALK",
            "narrator": "アーヤ",
            "text": "カップルがいるの、\n見えますか？",
            "zh": "有情侣，\n看得见吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "457/TALK",
            "narrator": "真幌",
            "text": "ああ…カップルで\n映画館と来れば、\nだいたいこれだ。",
            "zh": "啊……情侣来\n电影院，\n大体都是这样。",
            "narrator_zh": "真幌"
        },
        {
            "location": "460/TALK",
            "narrator": "真幌",
            "text": "…大丈夫だ。\n安心しろ、アーヤ。",
            "zh": "……没事。\n放心，绫水。",
            "narrator_zh": "真幌"
        },
        {
            "location": "461/TALK",
            "narrator": "アーヤ",
            "text": "えっ？",
            "zh": "诶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "462/TALK",
            "narrator": "アーヤ",
            "text": "さすが館長。\n注意しに行くのね！",
            "zh": "不愧是馆长。\n要去提醒他们吧！",
            "narrator_zh": "绫水"
        },
        {
            "location": "463/TALK",
            "narrator": "真幌",
            "text": "羨ましがらんでも、\nおまえもいずれは\n彼氏ができて――",
            "zh": "不必羡慕，\n你迟早也会\n有男朋友——",
            "narrator_zh": "真幌"
        },
        {
            "location": "464/TALK",
            "narrator": "真幌",
            "text": "あれくらい、\n普通にするように\nなるさ。",
            "zh": "那种程度，\n也会变得\n很普通。",
            "narrator_zh": "真幌"
        },
        {
            "location": "465/TALK",
            "narrator": "アーヤ",
            "text": "はい！",
            "zh": "是！",
            "narrator_zh": "绫水"
        },
        {
            "location": "466/TALK",
            "narrator": "アーヤ",
            "text": "…って、え？\nあの、\nそうじゃなくて…。",
            "zh": "……等，诶？\n那个，\n不是这个意思……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "467/TALK",
            "narrator": "真幌",
            "text": "落ち込むことはないぞ。\nアーヤは美人だから、\nその気になればすぐさ。",
            "zh": "不用沮丧。\n绫水这么漂亮，\n想的话很快就有。",
            "narrator_zh": "真幌"
        },
        {
            "location": "468/TALK",
            "narrator": "アーヤ",
            "text": "だ、だから、そういう\nことじゃなくて…。",
            "zh": "所以说，不是\n这个意思……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "469/TALK",
            "narrator": "真幌",
            "text": "わかったわかった。\nまあ、あまり気に\n病まずにいることだな。",
            "zh": "知道了知道了。\n嘛，别太\n往心里去。",
            "narrator_zh": "真幌"
        },
        {
            "location": "473/TALK",
            "narrator": "アーヤ",
            "text": "ご、誤解なんです！\n館長ー！",
            "zh": "是、是误会！\n馆长——！",
            "narrator_zh": "绫水"
        },
        {
            "location": "474/ACT",
            "narrator": "",
            "text": "アーヤ、硬過ぎ！",
            "zh": "绫水，太死板了！",
            "narrator_zh": ""
        },
        {
            "location": "476/TALK",
            "narrator": "アーヤ",
            "text": "あなたが甘過ぎるだけ！",
            "zh": "是你太松了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "477/TALK",
            "narrator": "アーヤ",
            "text": "公共良俗を乱すようなことは、許したらダメよ(｀ヘ´)",
            "zh": "扰乱公共良俗的事，不能原谅(｀ヘ´)",
            "narrator_zh": "绫水"
        },
        {
            "location": "489/TALK",
            "narrator": "アーヤ",
            "text": "…でも、どうやって\n注意すればいいかしら？",
            "zh": "……可是，该怎么\n提醒才好？",
            "narrator_zh": "绫水"
        },
        {
            "location": "490/TALK",
            "narrator": "アーヤ",
            "text": "みやびの言った通り、\n覗いてたのがバレたら、\n気まずくなるし…。",
            "zh": "就像雅说的，\n偷看被发现的话，\n会很尴尬……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "492/TALK",
            "narrator": "アーヤ",
            "text": "…あっ、館長。",
            "zh": "……啊，馆长。",
            "narrator_zh": "绫水"
        },
        {
            "location": "496/TALK",
            "narrator": "真幌",
            "text": "ん？　どうかしたのか？",
            "zh": "嗯？　怎么了？",
            "narrator_zh": "真幌"
        },
        {
            "location": "497/TALK",
            "narrator": "アーヤ",
            "text": "はい。実は劇場の中に、\n高校生のカップルが\nいるんですが――",
            "zh": "是。其实剧场里，\n有一对高中生\n情侣——",
            "narrator_zh": "绫水"
        },
        {
            "location": "501/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと、その…\n不純異性交遊に\n発展しかけていて…。",
            "zh": "有点，那个……\n快发展成不正当交往\n了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "502/TALK",
            "narrator": "真幌",
            "text": "なにっ？\nそれはマズいな。",
            "zh": "什么？\n那可糟了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "503/TALK",
            "narrator": "真幌",
            "text": "営業停止になったら\nご先祖様に顔向けできん。\nそいつらはどこだ？",
            "zh": "要是被勒令停业，\n没脸见祖先。\n人在哪？",
            "narrator_zh": "真幌"
        },
        {
            "location": "506/TALK",
            "narrator": "アーヤ",
            "text": "ここから覗いて\nください。正面の\n真ん中あたりの席です。",
            "zh": "请从这里看。\n正对面\n中间一带的座位。",
            "narrator_zh": "绫水"
        },
        {
            "location": "509/TALK",
            "narrator": "真幌",
            "text": "ふむ、どれどれ…。",
            "zh": "嗯，我看看……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "511/TALK",
            "narrator": "アーヤ",
            "text": "さすがは館長。\nここはビシッと言って\nもらわなくちゃ！",
            "zh": "不愧是馆长。\n这里得说得\n干脆才行！",
            "narrator_zh": "绫水"
        },
        {
            "location": "512/TALK",
            "narrator": "真幌",
            "text": "…………？",
            "zh": "…………？",
            "narrator_zh": "真幌"
        },
        {
            "location": "515/TALK",
            "narrator": "真幌",
            "text": "おい、アーヤ…。\nどこが不純異性交遊だ？",
            "zh": "喂，绫水……。\n哪是不正当交往？",
            "narrator_zh": "真幌"
        },
        {
            "location": "518/TALK",
            "narrator": "アーヤ",
            "text": "え？\nカップルがいるの、\n見えませんか？",
            "zh": "诶？\n有情侣，\n看不见吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "519/TALK",
            "narrator": "真幌",
            "text": "見えるが…キスくらい\nしかしていないように\n見えるんだが――",
            "zh": "看得见……可看起来\n只是在接吻\n——",
            "narrator_zh": "真幌"
        },
        {
            "location": "520/TALK",
            "narrator": "真幌",
            "text": "まさか、キスだけで\n不純異性交遊とか\n思っているのか？",
            "zh": "难道，你觉得光是接吻\n就是不正当交往\n吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "522/TALK",
            "narrator": "アーヤ",
            "text": "だ、だって、普通の\nキスじゃないですよ？",
            "zh": "可、可是，这不是\n普通的接吻吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "523/TALK",
            "narrator": "アーヤ",
            "text": "凄くディープだし、\nなんか髪の毛とか\nかき上げてますし…。",
            "zh": "很深，\n还在拨头发\n什么的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "524/TALK",
            "narrator": "真幌",
            "text": "それくらい普通だ。\n不純異性交遊でも\nなんでもない。",
            "zh": "这种程度很普通。\n既不是不正当交往，\n也什么都不是。",
            "narrator_zh": "真幌"
        },
        {
            "location": "525/TALK",
            "narrator": "真幌",
            "text": "あれくらいのこと、\n当時の私もしていたぞ。",
            "zh": "那种程度的事，\n我那时候也做过。",
            "narrator_zh": "真幌"
        },
        {
            "location": "527/TALK",
            "narrator": "アーヤ",
            "text": "はぁ！？",
            "zh": "哈！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "528/TALK",
            "narrator": "真幌",
            "text": "どれだけディープでも、\n音を立てなければ\n注意する必要はない。",
            "zh": "再深，\n只要不出声，\n就不必提醒。",
            "narrator_zh": "真幌"
        },
        {
            "location": "529/TALK",
            "narrator": "真幌",
            "text": "それと、硬過ぎるのは\n良くないぞ。",
            "zh": "还有，太死板\n不好。",
            "narrator_zh": "真幌"
        },
        {
            "location": "532/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "533/TALK",
            "narrator": "アーヤ",
            "text": "あれが…普通なの？",
            "zh": "那样……是普通吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "534/TALK",
            "narrator": "アーヤ",
            "text": "っていうか、\nもしかして\n私が遅れてる？",
            "zh": "话说，\n难道\n是我落后了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "535/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "537/TALK",
            "narrator": "アーヤ",
            "text": "もういいわ。\n見なかったことに\nしよう…。",
            "zh": "算了。\n就当没看见\n吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "327/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月10日　4:14 PM</color>\nとある放課後、神楽坂トライナリーでのバイト中。",
            "zh": "<color=green>5月10日　4:14 PM</color>\n某个放学后，神乐坂三重奏打工的时候。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "548/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch02",
            "text": "【発展などしなくてよろしい】",
            "zh": "【不必发展也无妨】",
            "narrator_zh": "Dialog_GEThimegoto_ch02"
        }
    ]
}
