{
    "dir": "chap24/daydra/dd_ch04_24_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "24452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "うさぎとデート",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "和兔子约会"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "ウサギとデート",
            "zh": "和兔子约会",
            "narrator_zh": ""
        },
        {
            "location": "31/TALK",
            "narrator": "雛",
            "text": "つばめちゃん。\n早く学食いこ？",
            "zh": "燕。\n快点去食堂吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "あ、ちょっと待って。",
            "zh": "啊，等我一下。",
            "narrator_zh": "燕"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "おーい、うさぎー。\nおるかー？",
            "zh": "喂——兔子——。\n在不在啊——？",
            "narrator_zh": "雅"
        },
        {
            "location": "37/TALK",
            "narrator": "繭",
            "text": "…はい？",
            "zh": "……在。",
            "narrator_zh": "茧"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "あ、みやびさん。\nどうしたんですか？",
            "zh": "啊，雅。\n有什么事吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "40/TALK",
            "narrator": "みやび",
            "text": "ん、ちくっとうさぎに\n用事があってな。",
            "zh": "嗯，找兔子\n有点事。",
            "narrator_zh": "雅"
        },
        {
            "location": "41/TALK",
            "narrator": "繭",
            "text": "何の御用でしょう？",
            "zh": "请问有何贵干？",
            "narrator_zh": "茧"
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "ん…予定ないなら、\nこれからうちと\nデートせんか？",
            "zh": "嗯……要是没安排，\n现在就和\n我来场约会咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "44/TALK",
            "narrator": "つばめ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "46/TALK",
            "narrator": "雛",
            "text": "で、デート！？",
            "zh": "约、约会！？",
            "narrator_zh": "雏"
        },
        {
            "location": "47/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "48/TALK",
            "narrator": "繭",
            "text": "わかりました。\n予定はないので、\nお付き合いいたします。",
            "zh": "我知道了。\n反正也没安排，\n我就奉陪了。",
            "narrator_zh": "茧"
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "すまんなぁ。\nまっこと感謝するちや。",
            "zh": "没好意思哈。\n真是感激滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "ちゅーわけやき、\nうさぎを借りるぞねー。",
            "zh": "事情就是这样嘛，\n兔子我先借走咧——",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "繭",
            "text": "二人とも、また。",
            "zh": "两位，回头见。",
            "narrator_zh": "茧"
        },
        {
            "location": "60/TALK",
            "narrator": "雛",
            "text": "…ほ、本当のデートって\nわけじゃないよね？",
            "zh": "……不、不是真的\n约会吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "62/TALK",
            "narrator": "つばめ",
            "text": "どうなんだろ？\nでも、二人ともとっても\n仲いいよね！",
            "zh": "谁知道呢？\n不过两个人感情\n真的很好呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "63/TALK",
            "narrator": "雛",
            "text": "だからちょっと\n疑っちゃうんじゃん。",
            "zh": "所以我才\n有点怀疑嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "65/TALK",
            "narrator": "雛",
            "text": "…それにしても、\nデートって、\nどこ行くんだろ…？",
            "zh": "……话说回来，\n约会的话，\n会去哪呢……？",
            "narrator_zh": "雏"
        },
        {
            "location": "67/TALK",
            "narrator": "つばめ",
            "text": "まさか、学校サボって\nほんとにデート\nするのかなぁ？",
            "zh": "难道说会翘掉学校，\n真的去\n约会吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "68/TALK",
            "narrator": "雛",
            "text": "さすがにそれは……",
            "zh": "那也太……",
            "narrator_zh": "雏"
        },
        {
            "location": "69/TALK",
            "narrator": "雛",
            "text": "いや、やりかねないわ。",
            "zh": "不，还真干得出来。",
            "narrator_zh": "雏"
        },
        {
            "location": "82/TALK",
            "narrator": "みやび",
            "text": "あ～、やっぱこの街は\n落ち着くなぁ…。",
            "zh": "啊～，这地方果然\n让人安心呀……。",
            "narrator_zh": "雅"
        },
        {
            "location": "83/TALK",
            "narrator": "みやび",
            "text": "うちの好きなもんが\nたっくさん集まる、\n夢のパラダイスや！",
            "zh": "我喜欢的玩意\n全都聚在这里，\n梦想天堂啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "うちはいずれ、\nアキバの中心に\n家作って引きこもるがよ。",
            "zh": "我早晚要在\n秋叶原的正中心\n盖个窝宅着咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "繭",
            "text": "大きいのか小さいのか\n判断に困る夢ですね。",
            "zh": "这梦想是大是小，\n真让人难以判断呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "まあ、うちの夢の話は\n今はどうでもえい。",
            "zh": "嘛，我的梦想的事，\n现在无所谓啦。",
            "narrator_zh": "雅"
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "田舎にずーっといたり、\n卯月のことで溜まっちょった\nこのフラストレーション――",
            "zh": "一直闷在乡下，\n又因为卯月的事攒下的\n这股压力——",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "限界突破のメルトダウン\n起こす前に発散できて、\n一安心ぞね。",
            "zh": "总算在突破极限\n熔断之前发散掉了，\n松了口气咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "繭",
            "text": "ご実家のある街も、\n静かでよいところだと\n思いました。",
            "zh": "你老家那边的镇子，\n我也觉得是个安静\n不错的地方。",
            "narrator_zh": "茧"
        },
        {
            "location": "94/TALK",
            "narrator": "繭",
            "text": "ですが、我々にとっては\nこういう街こそが\n癒しの場ですからね。",
            "zh": "不过对我们来说，\n这种街才是\n治愈之所呀。",
            "narrator_zh": "茧"
        },
        {
            "location": "97/TALK",
            "narrator": "みやび",
            "text": "理解が早くて助かる。",
            "zh": "理解得快，省心。",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "けんど…誘いに行った時に\nちくっとも慌てんかったのは\n寂しかったちや…。",
            "zh": "但是……上次去约你的时候，\n你一点都不慌，\n还挺失落的滴……。",
            "narrator_zh": "雅"
        },
        {
            "location": "100/TALK",
            "narrator": "繭",
            "text": "多分こういうことだろうと\n予想はしていましたので。",
            "zh": "我想大概会是那样，\n所以早有预料。",
            "narrator_zh": "茧"
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "むむむ、理解があり過ぎる\nっちゅうのも、考えもん\nやね…。",
            "zh": "唔唔唔，理解过头\n这一点嘛，也得\n琢磨琢磨咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "繭",
            "text": "それは重要なのでしょうか？",
            "zh": "这很重要吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "103/TALK",
            "narrator": "繭",
            "text": "今日の目的は、パーツを\n買ってフラストレーションを\n発散することでしょう？",
            "zh": "今天的目的，是买零件\n然后发散压力，\n对吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "そうやけんど、うさぎの\n可愛らしく慌てる姿も\n見れたらなぁ…。",
            "zh": "是没错，\n不过要是能看到兔子\n慌得可爱的样子就更好咧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "繭",
            "text": "ご、ご冗談を…。",
            "zh": "请、请别开玩笑……。",
            "narrator_zh": "茧"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "いやいや、まっことや。\nウソやないぞ？",
            "zh": "不不，是真的。\n没骗你啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "110/TALK",
            "narrator": "繭",
            "text": "はぁ…バカなことを\n言わないでください。",
            "zh": "唉……请别说\n傻话。",
            "narrator_zh": "茧"
        },
        {
            "location": "111/TALK",
            "narrator": "繭",
            "text": "利益のないことをしても\n得るものなど何も\nありませんよ？",
            "zh": "做没好处的事，\n什么也得不到，\n不是吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "113/TALK",
            "narrator": "みやび",
            "text": "…うさぎが段々と、\nうちに対してドライに\nなってきちゅう気がする…。",
            "zh": "……我感觉兔子，\n对我越来越\n冷淡了啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "115/TALK",
            "narrator": "繭",
            "text": "鍛えられましたので。\nみやび先輩直々に。",
            "zh": "因为我受过锻炼。\n还是雅前辈亲自出手的。",
            "narrator_zh": "茧"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "ふむ…。",
            "zh": "唔……",
            "narrator_zh": "雅"
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "というわけで",
            "zh": "所以说",
            "narrator_zh": "雅"
        },
        {
            "location": "130/TALK",
            "narrator": "みやび",
            "text": "相棒の出番や",
            "zh": "该搭档出场咯",
            "narrator_zh": "雅"
        },
        {
            "location": "132/SEL",
            "narrator": "",
            "text": "$me$に何をしろと？",
            "zh": "要$me$做什么？",
            "narrator_zh": ""
        },
        {
            "location": "133/ACT",
            "narrator": "",
            "text": "$me$に何をしろと？",
            "zh": "要$me$做什么？",
            "narrator_zh": ""
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "オーダー",
            "zh": "订单",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "みやび",
            "text": "うさぎの可愛いところを引き出す方法",
            "zh": "引出兔子可爱一面的方法",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "というわけなのだ",
            "zh": "就是这么回事",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "どうにも最近",
            "zh": "总感觉最近",
            "narrator_zh": "雅"
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "うさぎはドライな反応が過ぎる",
            "zh": "兔子的反应冷淡得过头",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "悪くはないが",
            "zh": "倒也不算坏",
            "narrator_zh": "雅"
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "うちの中のうさぎは",
            "zh": "我心目中的兔子",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "そうじゃなくてな",
            "zh": "不该是那样",
            "narrator_zh": "雅"
        },
        {
            "location": "143/TALK",
            "narrator": "みやび",
            "text": "わかるだろう？",
            "zh": "你懂的吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "145/SEL",
            "narrator": "",
            "text": "デートスポットへ誘ってみれば？",
            "zh": "要不试着约她去约会景点？",
            "narrator_zh": ""
        },
        {
            "location": "146/SEL",
            "narrator": "",
            "text": "今の繭も可愛いと思うけど？",
            "zh": "我觉得现在的茧也挺可爱的？",
            "narrator_zh": ""
        },
        {
            "location": "147/ACT",
            "narrator": "",
            "text": "デートスポットへ誘ってみれば？",
            "zh": "要不试着约她去约会景点？",
            "narrator_zh": ""
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "マジか",
            "zh": "真的假的",
            "narrator_zh": "雅"
        },
        {
            "location": "150/TALK",
            "narrator": "みやび",
            "text": "マジで言ってるのか？",
            "zh": "你说真的？",
            "narrator_zh": "雅"
        },
        {
            "location": "151/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "みやび",
            "text": "昨日テレビで特集見たばかりで",
            "zh": "昨天刚在电视上看了专题",
            "narrator_zh": "雅"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "ぶっちゃけた話",
            "zh": "老实说",
            "narrator_zh": "雅"
        },
        {
            "location": "154/TALK",
            "narrator": "みやび",
            "text": "あてはある",
            "zh": "我心里有数",
            "narrator_zh": "雅"
        },
        {
            "location": "158/TALK",
            "narrator": "みやび",
            "text": "行ってみよう",
            "zh": "走一趟吧",
            "narrator_zh": "雅"
        },
        {
            "location": "170/TALK",
            "narrator": "みやび",
            "text": "…よし、うさぎ。\n場所を変えるぞね。",
            "zh": "……好，兔子。\n换个地方咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "171/TALK",
            "narrator": "繭",
            "text": "次はどこへ？",
            "zh": "接下来去哪？",
            "narrator_zh": "茧"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "ゆりかもめに乗って、\nお台場へ行くちや。",
            "zh": "坐百合海鸥号，\n去台场滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "繭",
            "text": "…お、お台場？\nみやび先輩が！？",
            "zh": "……台、台场？\n雅前辈居然！？",
            "narrator_zh": "茧"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "うむ、遅くなるき、\n急いで行くぞね！",
            "zh": "嗯，要变晚了，\n快点出发咧！",
            "narrator_zh": "雅"
        },
        {
            "location": "176/TALK",
            "narrator": "繭",
            "text": "は、はい…。",
            "zh": "好、好的……。",
            "narrator_zh": "茧"
        },
        {
            "location": "186/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "189/TALK",
            "narrator": "繭",
            "text": "それで…お台場に来た\n理由はこれですか？",
            "zh": "所以说……你来台场的\n理由就是这个？",
            "narrator_zh": "茧"
        },
        {
            "location": "190/TALK",
            "narrator": "みやび",
            "text": "うむ…。",
            "zh": "嗯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "191/TALK",
            "narrator": "繭",
            "text": "何故観覧車なんですか？",
            "zh": "为什么是摩天轮？",
            "narrator_zh": "茧"
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "デートゆうて誘ったやろ？",
            "zh": "我约你的时候说的是约会啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "やき、まっことのデート\nスポットに来てみただけ\nなんやけんど…。",
            "zh": "嘛，就只是带你来\n真正的约会景点\n看看而已啵……。",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "…ぶっちゃけつまらん。\nこんな巨大なゴンドラ乗って\n何が楽しいが？",
            "zh": "……老实说好无聊。\n坐这么巨大的吊舱\n有什么好乐的咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "197/TALK",
            "narrator": "繭",
            "text": "連れてきたみやび先輩が\n言いますか？",
            "zh": "把人带过来的\n雅前辈好意思说吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "198/TALK",
            "narrator": "みやび",
            "text": "まあ、うるさい人混みから\n一時は確実に解放されるき、\n休憩タイムにはえいやろ。",
            "zh": "嘛，起码能确保暂时\n躲开吵闹的人潮，\n当休息时间还算好啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "199/TALK",
            "narrator": "みやび",
            "text": "うさぎも今のうちに\nリラックスしときぃ。",
            "zh": "兔子也趁现在\n放松放松嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "201/TALK",
            "narrator": "繭",
            "text": "この状況でそれは、\nちょっと難しいですね…。",
            "zh": "在这个状况下，\n有点难啊……",
            "narrator_zh": "茧"
        },
        {
            "location": "202/TALK",
            "narrator": "みやび",
            "text": "高所恐怖症か？",
            "zh": "恐高症吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "203/TALK",
            "narrator": "繭",
            "text": "いえ…あ、はい…。\nそういうことにしておいて\nください…。",
            "zh": "不是……啊，是……。\n就当是这样\n吧……。",
            "narrator_zh": "茧"
        },
        {
            "location": "205/TALK",
            "narrator": "みやび",
            "text": "そうか…じゃ、下は見んで\n景色を眺めるんよ。",
            "zh": "这样啊……那就别看下面，\n光看风景好了。",
            "narrator_zh": "雅"
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "ほれ、見てみぃ。\n綺麗やぞ？",
            "zh": "喏，看看咯。\n很漂亮啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "211/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "212/TALK",
            "narrator": "繭",
            "text": "はい…とても綺麗です…。",
            "zh": "是……非常漂亮……。",
            "narrator_zh": "茧"
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "はは、二人してらしくない\nことしちゅうなぁ。",
            "zh": "哈哈，两个人都在做\n不像自己的事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "218/TALK",
            "narrator": "繭",
            "text": "そうですね…。",
            "zh": "是啊……。",
            "narrator_zh": "茧"
        },
        {
            "location": "219/TALK",
            "narrator": "繭",
            "text": "でも…嫌な気はしません…。",
            "zh": "不过……并不讨厌……。",
            "narrator_zh": "茧"
        },
        {
            "location": "220/TALK",
            "narrator": "みやび",
            "text": "…そうやね。",
            "zh": "……是啊咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "224/TALK",
            "narrator": "みやび",
            "text": "…うさぎには\n言ったことあったっけか？",
            "zh": "……这事我跟\n兔子说过没咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "225/TALK",
            "narrator": "みやび",
            "text": "うちが本気モードになれる\n時間は、たった三分だけ、\nっちゅうのを…。",
            "zh": "我能进入认真模式的时间，\n只有短短三分钟，\n这件事……。",
            "narrator_zh": "雅"
        },
        {
            "location": "226/TALK",
            "narrator": "繭",
            "text": "…どうでしょうか？\nすみません、\n覚えていません。",
            "zh": "……怎么说呢？\n对不起，\n我不记得了。",
            "narrator_zh": "茧"
        },
        {
            "location": "228/TALK",
            "narrator": "繭",
            "text": "ですが、それが何か？",
            "zh": "不过，那又怎么了？",
            "narrator_zh": "茧"
        },
        {
            "location": "229/TALK",
            "narrator": "みやび",
            "text": "いや…せっかく、こうして\nゆっくり話せる場所に\nいるんやしね。",
            "zh": "没什么……难得能在这种\n能慢慢说话的地方\n待着嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "230/TALK",
            "narrator": "みやび",
            "text": "ちくっと…本気でうさぎに、\n真面目な話をさせてもらう\nがよ。",
            "zh": "等子……我要认真\n跟兔子说点正经话\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "231/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "233/TALK",
            "narrator": "みやび",
            "text": "改めて、ありがとう。",
            "zh": "再一次，谢谢你。",
            "narrator_zh": "雅"
        },
        {
            "location": "235/TALK",
            "narrator": "繭",
            "text": "えっ？",
            "zh": "诶？",
            "narrator_zh": "茧"
        },
        {
            "location": "236/TALK",
            "narrator": "みやび",
            "text": "うさぎが横須賀まで\n来てくれたの…、\nまっこと嬉しかったちや。",
            "zh": "兔子愿意来到横须贺……，\n我真是\n高兴滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "237/TALK",
            "narrator": "みやび",
            "text": "あの時のうちは…いや、\n今もやけんど…、\n結構参っちょるがよ…。",
            "zh": "那时候的我……不对，\n现在也一样啵……，\n其实挺受打击的咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "やき…もしあの時、\nうさぎがいなかったら…、\nうちは潰れちょったはずや。",
            "zh": "所以嘛……如果那时\n没有兔子在……，\n我早就垮掉了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "繭",
            "text": "そんな！　みやび先輩は\nそんなに弱くは――",
            "zh": "怎么会！　雅前辈\n没有那么脆弱——",
            "narrator_zh": "茧"
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "弱いんよ…。\nそんな自分を偽っちょる\nだけや。",
            "zh": "就是弱咯……。\n只是一直在伪装\n那样的自己啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "…見損なったか？",
            "zh": "……看走眼了？",
            "narrator_zh": "雅"
        },
        {
            "location": "244/TALK",
            "narrator": "繭",
            "text": "…まさか。\nそんなはず、ないじゃ\nありませんか…。",
            "zh": "……怎么会。\n那样的事，\n不会有的……。",
            "narrator_zh": "茧"
        },
        {
            "location": "245/TALK",
            "narrator": "繭",
            "text": "みやび先輩こそ、私を\n見損なわないでください。",
            "zh": "雅前辈才是，\n请不要看走眼了我。",
            "narrator_zh": "茧"
        },
        {
            "location": "246/TALK",
            "narrator": "みやび",
            "text": "…うん、そうやね。",
            "zh": "……嗯，是啊咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "248/TALK",
            "narrator": "みやび",
            "text": "タイムリミット近いき、\nすっと言わせてもらう\nけんど。",
            "zh": "时间快到咧，\n容我赶紧把话\n说完啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "うさぎは…まっこと、\nうちにとって最高の\nパートナーや…。",
            "zh": "兔子……真的是，\n对我来说最好的\n搭档咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "心からそう思うてる…。",
            "zh": "我是真心这么想的……。",
            "narrator_zh": "雅"
        },
        {
            "location": "251/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "252/TALK",
            "narrator": "繭",
            "text": "光栄です…。\n私も、本当に心から\nそう思います…。",
            "zh": "不胜荣幸……。\n我也是，发自内心\n这么想的……。",
            "narrator_zh": "茧"
        },
        {
            "location": "253/TALK",
            "narrator": "繭",
            "text": "みやび先輩に、\nパートナーとして\n認められるなんて…。",
            "zh": "能被雅前辈，\n当作搭档\n认可什么的……。",
            "narrator_zh": "茧"
        },
        {
            "location": "255/TALK",
            "narrator": "みやび",
            "text": "そう思うてくれるが？",
            "zh": "你也是这么想的咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "256/TALK",
            "narrator": "繭",
            "text": "はい…クイーン。",
            "zh": "是的……女王。",
            "narrator_zh": "茧"
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "…よかった。",
            "zh": "……太好了。",
            "narrator_zh": "雅"
        },
        {
            "location": "260/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "262/TALK",
            "narrator": "みやび",
            "text": "ちなみに、Ｆａｔａｌ\nＱｕｅｅｎの時は、\nちくっと違うんよ。",
            "zh": "顺带一提，作为\nＦａｔａｌＱｕｅｅｎ的时候，\n就不太一样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "263/TALK",
            "narrator": "みやび",
            "text": "ＦａｔａｌＱｕｅｅｎに\nとってのうさぎは、\n嫁さんみたいなもんや。",
            "zh": "对ＦａｔａｌＱｕｅｅｎ来说，\n兔子就像\n老婆一样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "264/TALK",
            "narrator": "繭",
            "text": "は…っ！？",
            "zh": "诶……！？",
            "narrator_zh": "茧"
        },
        {
            "location": "265/TALK",
            "narrator": "繭",
            "text": "い、今、あの…えぇっ！？\n嫁ですか？",
            "zh": "刚、刚才，那个……诶！？\n老婆吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "266/TALK",
            "narrator": "みやび",
            "text": "うむ、うさぎはうちの嫁、\nっちゅう感じや。",
            "zh": "嗯，兔子是我家老婆，\n就是这个感觉咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "268/TALK",
            "narrator": "みやび",
            "text": "まあ、女のうちに嫁とか\n言われても、嬉しくないとは\n思うけんどな。",
            "zh": "嘛，虽然你是女孩子，\n被叫老婆这种事，\n我想未必高兴啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "269/TALK",
            "narrator": "繭",
            "text": "そ、そんな！\nまさか！",
            "zh": "才、才不是！\n怎么可能！",
            "narrator_zh": "茧"
        },
        {
            "location": "270/TALK",
            "narrator": "繭",
            "text": "そっちも光栄です！\n本当…本気で、\nそう思います…。",
            "zh": "那样我也很荣幸！\n真的……真心，\n这么想……。",
            "narrator_zh": "茧"
        },
        {
            "location": "271/TALK",
            "narrator": "みやび",
            "text": "…よかった。",
            "zh": "……太好了。",
            "narrator_zh": "雅"
        },
        {
            "location": "272/TALK",
            "narrator": "繭",
            "text": "ですが、一つワガママを\n言わせていただきますと、\n逆がいいです。",
            "zh": "不过，容我任性提一个\n要求的话，\n反过来的话更好。",
            "narrator_zh": "茧"
        },
        {
            "location": "273/TALK",
            "narrator": "みやび",
            "text": "…逆？",
            "zh": "……反过来？",
            "narrator_zh": "雅"
        },
        {
            "location": "274/TALK",
            "narrator": "繭",
            "text": "はい。嫁役は私より、\nみやび先輩の方が\n的確かと思います。",
            "zh": "是的。当老婆的话，\n比起我，雅前辈\n应该更合适。",
            "narrator_zh": "茧"
        },
        {
            "location": "276/TALK",
            "narrator": "繭",
            "text": "きっと…素敵なお嫁さんに\nなると思いますし…。",
            "zh": "我想前辈一定会……\n成为很棒的新娘……。",
            "narrator_zh": "茧"
        },
        {
            "location": "278/TALK",
            "narrator": "みやび",
            "text": "はは、そうかぁ？",
            "zh": "哈哈，是吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "279/TALK",
            "narrator": "みやび",
            "text": "…ん？　そういえば、\nちくっと前に\nウエディングドレス着たな。",
            "zh": "……嗯？　说起来，\n前阵子\n还穿过婚纱来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "281/TALK",
            "narrator": "繭",
            "text": "えぇっ！？",
            "zh": "诶！？",
            "narrator_zh": "茧"
        },
        {
            "location": "283/TALK",
            "narrator": "みやび",
            "text": "いや、ブライダルフェア\nっちゅうのに、みんなで\n遊びに行ったんよ。",
            "zh": "就是有个婚博会，\n大家一起去\n玩了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "284/TALK",
            "narrator": "みやび",
            "text": "その時に、なんとなくノリで\nウェディングドレスを\nしちゃくしてな…。",
            "zh": "那时候，一时兴起\n就试穿上了\n婚纱……。",
            "narrator_zh": "雅"
        },
        {
            "location": "285/TALK",
            "narrator": "繭",
            "text": "み、みやび先輩が…、\nウェディングドレスを！？",
            "zh": "雅、雅前辈……，\n穿婚纱！？",
            "narrator_zh": "茧"
        },
        {
            "location": "286/TALK",
            "narrator": "みやび",
            "text": "…写真、見たい？",
            "zh": "……照片，想看？",
            "narrator_zh": "雅"
        },
        {
            "location": "287/TALK",
            "narrator": "繭",
            "text": "も、もちろんです。\nウェディングドレス姿って、\nレア過ぎます！",
            "zh": "想、当然想看。\n婚纱造型什么的，\n太过稀有了！",
            "narrator_zh": "茧"
        },
        {
            "location": "289/TALK",
            "narrator": "みやび",
            "text": "なら、宝探しゲームや。",
            "zh": "那就来玩寻宝游戏。",
            "narrator_zh": "雅"
        },
        {
            "location": "290/TALK",
            "narrator": "みやび",
            "text": "うちのサーバの\nどこかに、圧縮ファイルで\n置いてあるき。",
            "zh": "在我服务器的\n某个角落，\n放着压缩包啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "291/TALK",
            "narrator": "みやび",
            "text": "見たければ、ハッキングして\n自力で手に入れるぞね。",
            "zh": "想看的话，就自己黑进来\n凭本事拿到咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "293/TALK",
            "narrator": "繭",
            "text": "…いいでしょう。\n今夜中に、絶対に手に入れて\nみせます。",
            "zh": "……好啊。\n今晚之内，我一定\n拿到手给你看。",
            "narrator_zh": "茧"
        },
        {
            "location": "294/TALK",
            "narrator": "みやび",
            "text": "はは、報告楽しみに\nしてるぞね。",
            "zh": "哈哈，我期待你的\n报告咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "295/TALK",
            "narrator": "繭",
            "text": "はい…。",
            "zh": "是……。",
            "narrator_zh": "茧"
        },
        {
            "location": "296/TALK",
            "narrator": "繭",
            "text": "ところで…みやび先輩の\n本気モード…三分間だけ\nでしたね？",
            "zh": "话说……雅前辈的\n认真模式……只有三分钟\n对吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "297/TALK",
            "narrator": "みやび",
            "text": "そうやけんど、それが？",
            "zh": "是啊啵，然后？",
            "narrator_zh": "雅"
        },
        {
            "location": "300/TALK",
            "narrator": "繭",
            "text": "…タイムリミットを\n迎えたのは、話のどの辺り\nですか？",
            "zh": "……时间到的时候，\n是说到哪一段\n了？",
            "narrator_zh": "茧"
        },
        {
            "location": "301/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "302/TALK",
            "narrator": "みやび",
            "text": "そろそろ一周するき、\n降りる準備するがよ。",
            "zh": "差不多要转完一圈了啵，\n准备下轮咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "319/ACT",
            "narrator": "",
            "text": "今の繭も可愛いと思うけど？",
            "zh": "我觉得现在的茧也挺可爱的？",
            "narrator_zh": ""
        },
        {
            "location": "321/TALK",
            "narrator": "みやび",
            "text": "否定できん",
            "zh": "没法否认",
            "narrator_zh": "雅"
        },
        {
            "location": "322/TALK",
            "narrator": "みやび",
            "text": "確かに可愛い",
            "zh": "确实可爱",
            "narrator_zh": "雅"
        },
        {
            "location": "323/TALK",
            "narrator": "みやび",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "雅"
        },
        {
            "location": "324/TALK",
            "narrator": "みやび",
            "text": "うさぎはどうなろうと",
            "zh": "兔子不管变成什么样",
            "narrator_zh": "雅"
        },
        {
            "location": "325/TALK",
            "narrator": "みやび",
            "text": "可愛いままなのか",
            "zh": "都还是可爱的吗",
            "narrator_zh": "雅"
        },
        {
            "location": "326/TALK",
            "narrator": "みやび",
            "text": "世紀の大発見レベルの衝撃",
            "zh": "堪称世纪大发现级别的冲击",
            "narrator_zh": "雅"
        },
        {
            "location": "327/TALK",
            "narrator": "みやび",
            "text": "↑は大げさ度１００００００００％",
            "zh": "↑夸张程度１００００００００％",
            "narrator_zh": "雅"
        },
        {
            "location": "339/TALK",
            "narrator": "みやび",
            "text": "…まあ、ドライなうさぎも、\nこれはこれで可愛いき、\nえいもんやね。",
            "zh": "……嘛，冷淡的兔子，\n也有这种可爱法啵，\n这样也蛮好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "341/TALK",
            "narrator": "繭",
            "text": "な、何をバカな…。",
            "zh": "说、说什么傻话……。",
            "narrator_zh": "茧"
        },
        {
            "location": "342/TALK",
            "narrator": "みやび",
            "text": "いやいや、まっことの\nことぞね。",
            "zh": "不不，我是认真\n说的咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "344/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、うさぎは\nもとがえいきね。",
            "zh": "说起来，兔子\n底子本来就好嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "345/TALK",
            "narrator": "みやび",
            "text": "当然と言っちゃそれまで\nなんやけんど…。",
            "zh": "说是理所当然，\n倒也没错啵……。",
            "narrator_zh": "雅"
        },
        {
            "location": "348/TALK",
            "narrator": "繭",
            "text": "…そ、それくらいにして\nいただけませんか？",
            "zh": "……请、请适可而止\n可以吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "349/TALK",
            "narrator": "みやび",
            "text": "いや、すまん。\nけんどな、まっこと\n嬉しがよ。",
            "zh": "抱歉抱歉。\n不过，我是真心\n高兴咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "ほれ、うさぎがどんな奴か\n知らんかった頃、オッサンと\n思うてた言うたやろ？",
            "zh": "喏，还不了解兔子是\n什么人的时候，我说过\n把你当大叔了咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "352/TALK",
            "narrator": "みやび",
            "text": "もしそうやったら、\n冗談でデートとか言うたり\nできんかったやろうなぁ。",
            "zh": "要是真那样的话，\n也不会拿约会这种话\n开玩笑了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "355/TALK",
            "narrator": "繭",
            "text": "…まあ、同性に対して\n言うのもどうかとは\n思いますが。",
            "zh": "……嘛，对同性\n这么说，确实\n有点微妙。",
            "narrator_zh": "茧"
        },
        {
            "location": "356/TALK",
            "narrator": "みやび",
            "text": "同好の士で、同年代の女子。\nしかも、見た目もえいと\nきちょる。",
            "zh": "同好之士，同龄的女孩子。\n而且，长相\n也蛮好看着。",
            "narrator_zh": "雅"
        },
        {
            "location": "358/TALK",
            "narrator": "みやび",
            "text": "まっこと、\nありがたい存在や。\n拝んどくか。",
            "zh": "真是，\n值得感谢的存在咯。\n那就拜一拜啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "359/TALK",
            "narrator": "繭",
            "text": "…少し、照れくさくは\nありますが…光栄です。",
            "zh": "……虽然有点\n难为情……但很荣幸。",
            "narrator_zh": "茧"
        },
        {
            "location": "360/TALK",
            "narrator": "繭",
            "text": "みやび先輩にとって、\nありがたいと思えるような\n存在になれたなんて…。",
            "zh": "竟然能成为雅前辈\n觉得值得感谢的\n存在什么的……。",
            "narrator_zh": "茧"
        },
        {
            "location": "361/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "362/TALK",
            "narrator": "繭",
            "text": "…………？",
            "zh": "…………？",
            "narrator_zh": "茧"
        },
        {
            "location": "364/TALK",
            "narrator": "みやび",
            "text": "はぁ…やっぱうさぎ、\n前よかドライになっちょる\nなぁ…。",
            "zh": "唉……兔子果然，\n比以前更冷淡\n了啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "365/TALK",
            "narrator": "繭",
            "text": "えっ？",
            "zh": "诶？",
            "narrator_zh": "茧"
        },
        {
            "location": "367/TALK",
            "narrator": "みやび",
            "text": "ちくっと前やったら、\nもっと照れて慌てちょった\nはずやのに…。",
            "zh": "要是前阵子，\n你该更害羞更慌张\n才对啵……。",
            "narrator_zh": "雅"
        },
        {
            "location": "368/TALK",
            "narrator": "繭",
            "text": "なっ！？　まさか！\n今の言葉はそれを狙って\n言ったんですか！？",
            "zh": "怎！？　不会吧！\n刚才那句话，\n是故意说的吗！？",
            "narrator_zh": "茧"
        },
        {
            "location": "369/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "370/TALK",
            "narrator": "みやび",
            "text": "さて、どうやろね…。\nほれ、まだ買うものあるき、\n付き合うてくれちや。",
            "zh": "谁知道呢……。\n喏，还有东西要买啵，\n陪我逛完滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "374/TALK",
            "narrator": "繭",
            "text": "…見間違い？",
            "zh": "……看错了？",
            "narrator_zh": "茧"
        },
        {
            "location": "375/TALK",
            "narrator": "繭",
            "text": "今、みやび先輩も\n少し赤くなってたような？",
            "zh": "刚才，雅前辈\n好像也红了脸？",
            "narrator_zh": "茧"
        },
        {
            "location": "17/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>9月2日　 0:11 PM</color>\nとある平日の昼休み、付属学園つばめの教室にて",
            "zh": "<color=green>9月2日　 0:11 PM</color>\n某个工作日的午休，附属学园燕的教室里。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "313/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch04",
            "text": "【三分間の】",
            "zh": "【三分钟的】",
            "narrator_zh": "Dialog_GEThimegoto_ch04"
        }
    ]
}
