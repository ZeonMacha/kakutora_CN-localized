        },
        {
            "location": "381/TALK",
            "narrator": "つばめ",
            "text": "$handle$さん",
            "zh": "$handle$",
            "narrator_zh": "燕"
        },
        {
            "location": "382/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃん",
            "zh": "神乐",
            "narrator_zh": "燕"
        },
        {
            "location": "383/TALK",
            "narrator": "つばめ",
            "text": "会ってくれるかな？(´･ω･｀) ",
            "zh": "会见到我吗？(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "385/SEL",
            "narrator": "",
            "text": "心配？",
            "zh": "担心？",
            "narrator_zh": ""
        },
        {
            "location": "386/ACT",
            "narrator": "",
            "text": "心配？",
            "zh": "担心？",
            "narrator_zh": ""
        },
        {
            "location": "388/TALK",
            "narrator": "つばめ",
            "text": "だって",
            "zh": "因为",
            "narrator_zh": "燕"
        },
        {
            "location": "389/TALK",
            "narrator": "つばめ",
            "text": "ＷＡＶＥに返事くれなぃし(´つω・｀)ｼｭﾝ",
            "zh": "WAVE也不回我(´つω・｀)ｼｭﾝ",
            "narrator_zh": "燕"
        },
        {
            "location": "390/TALK",
            "narrator": "つばめ",
            "text": "会ってくれるか",
            "zh": "会不会见我",
            "narrator_zh": "燕"
        },
        {
            "location": "392/TALK",
            "narrator": "つばめ",
            "text": "不安でヾ(｡>﹏<｡)ﾉﾞ",
            "zh": "好不安ヾ(｡>﹏<｡)ﾉﾞ",
            "narrator_zh": "燕"
        },
        {
            "location": "394/SEL",
            "narrator": "",
            "text": "行かないで悩むより行ってスッキリしよう",
            "zh": "与其不去干着急，不如去了痛快一点",
            "narrator_zh": ""
        },
        {
            "location": "395/ACT",
            "narrator": "",
            "text": "行かないで悩むより行ってスッキリしよう",
            "zh": "与其不去干着急，不如去了痛快一点",
            "narrator_zh": ""
        },
        {
            "location": "398/TALK",
            "narrator": "つばめ",
            "text": "ぁりがとぅ(*´︶`*)",
            "zh": "谢谢呀(*´︶`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "399/TALK",
            "narrator": "つばめ",
            "text": "決心付ぃたよ(๑･ㅂ･)و☆",
            "zh": "下定决心了(๑･ㅂ･)و☆",
            "narrator_zh": "燕"
        },
        {
            "location": "400/TALK",
            "narrator": "つばめ",
            "text": "わたし",
            "zh": "我",
            "narrator_zh": "燕"
        },
        {
            "location": "401/TALK",
            "narrator": "つばめ",
            "text": "行ってみる",
            "zh": "去看看",
            "narrator_zh": "燕"
        },
        {
            "location": "415/TALK",
            "narrator": "つばめ",
            "text": "…じゃあ、明日。",
            "zh": "……那么，明天。",
            "narrator_zh": "燕"
        },
        {
            "location": "417/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんの家に\n行ってみるよ。",
            "zh": "我去神乐\n家里看看。",
            "narrator_zh": "燕"
        },
        {
            "location": "419/TALK",
            "narrator": "雛",
            "text": "うん…ごめんねー。\nつばめちゃんに\nお任せしちゃってー。",
            "zh": "嗯……对不起哦——。\n都交给\n燕了——。",
            "narrator_zh": "雏"
        },
        {
            "location": "421/TALK",
            "narrator": "つばめ",
            "text": "ううん…わたしも、\nちょっとお話ししたい\nことあったし。",
            "zh": "没事……我也\n有点想说的\n话。",
            "narrator_zh": "燕"
        },
        {
            "location": "422/TALK",
            "narrator": "雛",
            "text": "えっへへ、あたしの\n予想的中だねー。",
            "zh": "诶嘿嘿，我的预料\n中了呀——。",
            "narrator_zh": "雏"
        },
        {
            "location": "423/TALK",
            "narrator": "キリト",
            "text": "なあ、見舞い行ったら\nすぐにＷＡＶＥで\n教えてくれよ。",
            "zh": "呐，去探病了\n马上用WAVE\n告诉我。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "424/TALK",
            "narrator": "キリト",
            "text": "寝込んだりしてねぇか\n心配だからな。",
            "zh": "有没有躺倒起不来，\n我担心啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "425/TALK",
            "narrator": "雛",
            "text": "いや、風邪じゃないん\nだからさ…。",
            "zh": "不是，又不是\n感冒……。",
            "narrator_zh": "雏"
        },
        {
            "location": "426/TALK",
            "narrator": "キリト",
            "text": "そんなのわかんねぇ\nだろ？",
            "zh": "那种事\n谁知道啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "428/TALK",
            "narrator": "ヒカル",
            "text": "お見舞いに行ったら、\n僕にも報告して\nもらえますか？",
            "zh": "去探病的话，\n也跟我\n说一声可以吗？",
            "narrator_zh": "光"
        },
        {
            "location": "429/TALK",
            "narrator": "つばめ",
            "text": "うん…でも、まだ\n会ってくれるかは\nわからないけど…。",
            "zh": "嗯……不过，还\n不知道会不会\n见我……。",
            "narrator_zh": "燕"
        },
        {
            "location": "430/TALK",
            "narrator": "雛",
            "text": "何言ってるの、\nつばめちゃん？",
            "zh": "说什么呀，\n燕？",
            "narrator_zh": "雏"
        },
        {
            "location": "431/TALK",
            "narrator": "雛",
            "text": "つばめちゃんが\n行けば、絶対に会って\nくれるはずだよ。",
            "zh": "燕要是\n去了，绝对会\n见你的。",
            "narrator_zh": "雏"
        },
        {
            "location": "433/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃん…。",
            "zh": "雏……。",
            "narrator_zh": "燕"
        },
        {
            "location": "434/TALK",
            "narrator": "雛",
            "text": "あとさ。",
            "zh": "还有。",
            "narrator_zh": "雏"
        },
        {
            "location": "435/TALK",
            "narrator": "雛",
            "text": "急がなくていいから、\nこっちにも連絡してって\n伝えて欲しいな。",
            "zh": "不用急，\n也让她联系\n我们吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "436/TALK",
            "narrator": "雛",
            "text": "あたし達だって、\n神楽ちゃんの\nお友達なんだし。",
            "zh": "我们也是\n神乐的\n朋友呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "437/TALK",
            "narrator": "キリト",
            "text": "ああ、頼んだからな、\n逢瀬。",
            "zh": "啊，拜托了，\n逢濑。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "438/TALK",
            "narrator": "ヒカル",
            "text": "よろしく\nお願いしますね。",
            "zh": "请多\n关照。",
            "narrator_zh": "光"
        },
        {
            "location": "440/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "442/TALK",
            "narrator": "つばめ",
            "text": "うん、任せて！",
            "zh": "嗯，交给我！",
            "narrator_zh": "燕"
        },
        {
            "location": "445/TALK",
            "narrator": "つばめ",
            "text": "…みんなの気持ちを\n聞いたら――",
            "zh": "……听了大家的\n心意——",
            "narrator_zh": "燕"
        },
        {
            "location": "446/TALK",
            "narrator": "つばめ",
            "text": "きっと、神楽ちゃんも\n元気になってくれる\nよね？",
            "zh": "神乐也一定会\n振作起来的\n吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "457/DIALOG",
            "narrator": "Dialog_chapter_ch01",
            "text": "【15 弾の数だけ抱きしめて】",
            "zh": "【15 有多少发子弹，就拥抱多少次】",
            "narrator_zh": "Dialog_chapter_ch01"
        }
    ]
}
