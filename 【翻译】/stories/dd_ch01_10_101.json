        },
        {
            "location": "404/ACT",
            "narrator": "",
            "text": "なんか裏がありそうだし仕方ない",
            "zh": "好像有内情，也没办法",
            "narrator_zh": ""
        },
        {
            "location": "406/TALK",
            "narrator": "つばめ",
            "text": "あ、ありがとう\nございます！",
            "zh": "啊，谢谢\n你！",
            "narrator_zh": "燕"
        },
        {
            "location": "407/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんが\n優しい人で良かったです。",
