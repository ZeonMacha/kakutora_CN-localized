    "entry": [
        {
            "location": "654/TALK",
            "narrator": "みやび",
            "text": "ほいたらTwitterの\n人柱は別に確保\nしようかねえ。",
            "zh": "那就，Twitter的\n小白鼠另找一伙\n来当吧咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "655/TALK",
            "narrator": "繭",
            "text": "別って？",
            "zh": "『另外』是指？",
            "narrator_zh": "茧"
        },
        {
            "location": "657/TALK",
            "narrator": "みやび",
            "text": "うちの戦友たちぞね。",
            "zh": "是我的战友们咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "665/TALK",
            "narrator": "みやび",
            "text": "カンカンカンカン",
            "zh": "哐哐哐哐",
            "narrator_zh": "雅"
        },
        {
            "location": "666/TALK",
            "narrator": "みやび",
            "text": "全員集合",
            "zh": "全员集合",
            "narrator_zh": "雅"
        },
        {
            "location": "667/TALK",
            "narrator": "みやび",
            "text": "以下のものをインストールしてサインアップすべし",
            "zh": "把以下的东西统统安装并注册完毕",
            "narrator_zh": "雅"
        },
        {
            "location": "669/TALK",
            "narrator": "つばめ",
            "text": "これ何ですか？",
            "zh": "这是什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "670/TALK",
            "narrator": "アーヤ",
            "text": "いつも突然すぎるのよみやび",
            "zh": "你总是太突然了，雅",
            "narrator_zh": "绫水"
        },
        {
            "location": "671/TALK",
            "narrator": "ガブリエラ",
            "text": "また変なこと始めたの？",
            "zh": "又开始搞什么怪名堂了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "672/TALK",
            "narrator": "みやび",
            "text": "聞いて驚け",
            "zh": "听好了，吓你们一跳",
            "narrator_zh": "雅"
        },
        {
            "location": "673/TALK",
            "narrator": "みやび",
            "text": "もしかしたらあやつと会えるかもしれんツールや",
            "zh": "是个说不定能和那家伙见面的工具",
            "narrator_zh": "雅"
        },
        {
            "location": "675/TALK",
            "narrator": "アーヤ",
            "text": "え",
            "zh": "诶",
            "narrator_zh": "绫水"
        },
        {
            "location": "676/TALK",
            "narrator": "アーヤ",
            "text": "あやつって",
            "zh": "那家伙是",
            "narrator_zh": "绫水"
        },
        {
            "location": "677/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんのこと？",
            "zh": "是指$handle$吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "678/TALK",
            "narrator": "みやび",
            "text": "イエス即ち肯定",
            "zh": "Yes即是肯定",
            "narrator_zh": "雅"
        },
        {
            "location": "680/TALK",
            "narrator": "神楽",
            "text": "えーと、、、",
            "zh": "那个、、、",
            "narrator_zh": "神乐"
        },
        {
            "location": "681/TALK",
            "narrator": "神楽",
            "text": "本気で言っていますか？？？",
            "zh": "你是在认真说吗？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "682/TALK",
            "narrator": "つばめ",
            "text": "なんかエラー出ましたΣ(･ω･;|||",
            "zh": "好像出错了Σ(･ω･;|||",
            "narrator_zh": "燕"
        },
        {
            "location": "683/TALK",
            "narrator": "アーヤ",
            "text": "大丈夫。できたわよ＼(^O^)／",
            "zh": "没事。搞定了＼(^O^)／",
            "narrator_zh": "绫水"
        },
        {
            "location": "689/TALK",
            "narrator": "みやび",
            "text": "アーヤが一番乗りに\nなったねえ。",
            "zh": "绫水抢先\n登顶了呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "690/TALK",
            "narrator": "みやび",
            "text": "ほいたらアーヤと\n通信テストを\nしてみるき。",
            "zh": "那就先和绫水\n试试\n通信啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "691/TALK",
            "narrator": "繭",
            "text": "慎重にお願いします。\n監視はこちらで\nしますけど。",
            "zh": "请谨慎操作。\n监控由\n我们这边来做。",
            "narrator_zh": "茧"
        },
        {
            "location": "694/TALK",
            "narrator": "みやび",
            "text": "信用しとるよ。",
            "zh": "我相信你哟。",
            "narrator_zh": "雅"
        },
        {
            "location": "698/TALK",
            "narrator": "みやび",
            "text": "何を書いたら\nええろうね。",
            "zh": "写什么\n才好呢咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "699/TALK",
            "narrator": "みやび",
            "text": "適当でええか。\n「ヒトヨヒトヨニ\nヒトミゴロ」",
            "zh": "随便写点行吧。\n「ヒトヨヒトヨニ\nヒトミゴロ」",
            "narrator_zh": "雅"
        },
        {
            "location": "703/TALK",
            "narrator": "つばめ",
            "text": "どぅすればぃぃかわかんなぃょ(´・ω・｀)(´・ω・｀)",
            "zh": "不造该怎么办了啦(´・ω・｀)(´・ω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "704/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんは後で見ちゃる",
            "zh": "燕的回头我来给你弄",
            "narrator_zh": "雅"
        },
        {
            "location": "705/TALK",
            "narrator": "みやび",
            "text": "アーヤは何か書き込んだかね？",
            "zh": "绫水写了点什么吗咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "707/TALK",
            "narrator": "アーヤ",
            "text": "Twitterはじめました",
            "zh": "Twitter开张了",
            "narrator_zh": "绫水"
        },
        {
            "location": "708/TALK",
            "narrator": "アーヤ",
            "text": "って会話",
            "zh": "这么段对话",
            "narrator_zh": "绫水"
        },
        {
            "location": "709/TALK",
            "narrator": "アーヤ",
            "text": "書いたわ",
            "zh": "写上去了",
            "narrator_zh": "绫水"
        },
        {
            "location": "710/TALK",
            "narrator": "みやび",
            "text": "冷やし中華か！",
            "zh": "中华冷面吗！",
            "narrator_zh": "雅"
        },
        {
            "location": "712/TALK",
            "narrator": "アーヤ",
            "text": "定型文であったのよ(--*;",
            "zh": "那是模板句来的(--*;",
            "narrator_zh": "绫水"
        },
        {
            "location": "720/TALK",
            "narrator": "みやび",
            "text": "とりあえずアーヤと\nうちは書きこんだ\nけんど。",
            "zh": "总之绫水和我\n是写上去了\n就是。",
            "narrator_zh": "雅"
        },
        {
            "location": "721/TALK",
            "narrator": "みやび",
            "text": "不審な動きは\nあったかね？",
            "zh": "有可疑的\n动静吗咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "722/TALK",
            "narrator": "繭",
            "text": "…いえ。\n今のところは特に。",
            "zh": "……没有。\n目前没有。",
            "narrator_zh": "茧"
        },
        {
            "location": "723/TALK",
            "narrator": "みやび",
            "text": "トライナリー全員が\nサインアップしたら\n追って知らせるき。",
            "zh": "等三重奏全员\n注册完，\n我再通知你啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "724/TALK",
            "narrator": "繭",
            "text": "はい。\n何かあったら即\n対応します。",
            "zh": "好。\n一有状况\n立刻处理。",
            "narrator_zh": "茧"
        },
        {
            "location": "725/TALK",
            "narrator": "繭",
            "text": "それでは、\n今日はこれで。",
            "zh": "那么，\n今天就到这里。",
            "narrator_zh": "茧"
        },
        {
            "location": "732/TALK",
            "narrator": "みやび",
            "text": "もちろん今は全て\n仮定でしかないけんど。",
            "zh": "当然现在这一切\n都还只是假设。",
            "narrator_zh": "雅"
        },
        {
            "location": "734/TALK",
            "narrator": "みやび",
            "text": "それを検証していくのは\nたまらんねえ…！",
            "zh": "能把它们逐一验证下去，\n可太让人上头了……！",
            "narrator_zh": "雅"
        },
        {
            "location": "735/SEL",
            "narrator": "",
            "text": "そういうことだったんだ",
            "zh": "原来是这么回事啊",
            "narrator_zh": ""
