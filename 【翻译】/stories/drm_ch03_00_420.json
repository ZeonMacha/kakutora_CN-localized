{
    "dir": "dramatics/daydra/drm_ch03_00_420.js",
    "type": "Episode",
    "info": {
        "story_id": "3042",
        "cid": "gabriella",
        "title": "らぶとーく  第42話",
        "sub_title": "シネマ",
        "title_zh": "恋爱漫谈 第42话",
        "sub_title_zh": "电影"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "シネマ",
            "zh": "电影"
        },
        {
            "location": "20/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぁ～…。",
            "zh": "哈啊……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "22/TALK",
            "narrator": "真幌",
            "text": "おい、ギャヴィ。\n名作を見ながら\nあくびをするな。",
            "zh": "喂，加维。\n别一边看名作\n一边打哈欠。",
            "narrator_zh": "真幌"
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "見たくて見てる\nわけじゃないし…。",
            "zh": "又不是想看才看的\n……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "25/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、\nこれ名作なの？",
            "zh": "话说，\n这是名作吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "真幌",
            "text": "まあ、古い映画だから\nおまえくらいの年じゃ\n知らないだろうが――",
            "zh": "嘛，是老电影，\n你这个年纪\n大概不知道——",
            "narrator_zh": "真幌"
        },
        {
            "location": "27/TALK",
            "narrator": "真幌",
            "text": "数々の賞を総なめした\n世界的に有名な映画だ。",
            "zh": "拿下过无数奖项的\n世界闻名的电影。",
            "narrator_zh": "真幌"
        },
        {
            "location": "28/TALK",
            "narrator": "ガブリエラ",
            "text": "えーっ、これが？",
            "zh": "诶，这个？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "ガブリエラ",
            "text": "すっごい退屈で、\n見てるのが苦痛なん\nだけど…。",
            "zh": "无聊透了，\n看着都痛苦\n……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "ラブロマンスの方が\n楽しくていいじゃない。",
            "zh": "爱情片不是\n更有意思吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "真幌",
            "text": "ははっ…ギャヴィには\nまだこの映画の良さは\nわからないか…。",
            "zh": "哈哈……对加维来说\n这部电影的好处\n还看不懂吧……",
            "narrator_zh": "真幌"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "一生わからないと\n思うけど？",
            "zh": "我觉得一辈子\n都看不懂？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "真幌",
            "text": "ほら、目を反らすな。\nここからが\n名シーンだぞ。",
            "zh": "喂，别移开眼睛。\n从这里开始\n是名场面。",
            "narrator_zh": "真幌"
        },
        {
            "location": "39/TALK",
            "narrator": "真幌",
            "text": "今際の際の祖父と、\n主人公の孫が人生に\nついて語り合うんだ。",
            "zh": "临终的祖父，\n和当主角的孙子\n谈论人生。",
            "narrator_zh": "真幌"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "その割に、すっごい\nハキハキ喋ってると\n思うんだけど…。",
            "zh": "可是看起来明明\n说得特别有\n精神……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "真幌",
            "text": "はぁ…本当にわからん\nヤツだなぁ…。",
            "zh": "唉……真是个\n搞不懂的家伙……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "42/TALK",
            "narrator": "真幌",
            "text": "ラストで、主人公が\n祖父の志に触れる\nシーンがあるんだが――",
            "zh": "结尾有主角\n触及祖父志向的\n一场——",
            "narrator_zh": "真幌"
        },
        {
            "location": "43/TALK",
            "narrator": "真幌",
            "text": "そこが重要なんだ。\n涙なしには見れんぞ？",
            "zh": "那里才是最重要的。\n没有眼泪可看不下去哦？",
            "narrator_zh": "真幌"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？\n真幌も泣くの！？",
            "zh": "诶！？\n真幌也会哭吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "46/TALK",
            "narrator": "真幌",
            "text": "五十回以上は見たから、\nさすがにもう泣かんな。",
            "zh": "看了五十遍以上，\n现在倒是不哭了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "説得力なくなったわ。\nもぅ…。",
            "zh": "没说服力了。\n真是……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "…志に触れる、か。",
            "zh": "……触碰志向，是吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "今見てる映画なんだけど",
            "zh": "现在看的电影",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "主人公とおじいさんがわかりあえると思う？",
            "zh": "你觉得主角和爷爷能互相理解吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/SEL",
            "narrator": "",
            "text": "そういう話なの？",
            "zh": "是那种事吗？",
            "narrator_zh": ""
        },
        {
            "location": "64/ACT",
            "narrator": "",
            "text": "そういう話なの？",
            "zh": "是那种事吗？",
            "narrator_zh": ""
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "内容全部話すと凄く長くなるから短く説明すると",
            "zh": "全部讲会很长，简单说的话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "おじいさんと主人公がちょっと通じ合ってない関係でね",
            "zh": "爷爷和主角之间有点说不到一块去的关系呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "ガブリエラ",
            "text": "真幌の話だと最後におじいさんの志に触れるみたいだけど",
            "zh": "按真幌的说法，最后好像会触及爷爷的志向",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "69/TALK",
            "narrator": "ガブリエラ",
            "text": "それで分かり合えると思う？",
            "zh": "你觉得这样就能互相理解？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは",
            "zh": "我",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "71/TALK",
            "narrator": "ガブリエラ",
            "text": "通じ合うとは限らないと思うんだけど？",
            "zh": "我觉得不一定能心意相通？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/SEL",
            "narrator": "",
            "text": "そういうこともあるかもしれないね",
            "zh": "也许也有那种事呢",
            "narrator_zh": ""
        },
        {
            "location": "74/SEL",
            "narrator": "",
            "text": "通じる日が来るまで待つ",
            "zh": "等到彼此能相通的那天",
            "narrator_zh": ""
        },
        {
            "location": "75/SEL",
            "narrator": "",
            "text": "秘するが花って言葉もあるね",
            "zh": "也有句话叫秘则为花呢",
            "narrator_zh": ""
        },
        {
            "location": "76/ACT",
            "narrator": "",
            "text": "そういうこともあるかもしれないね",
            "zh": "也许也有那种事呢",
            "narrator_zh": ""
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりそう思うわよね？",
            "zh": "你也这么想吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "…あ、でもこれ、\n映画だったわね。",
            "zh": "……啊，不过这是\n电影呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/TALK",
            "narrator": "真幌",
            "text": "何だ、急に？",
            "zh": "怎么了，突然？",
            "narrator_zh": "真幌"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "現実じゃ、志に触れたり\nしたって、わからない\nものはわからない――",
            "zh": "现实里，就算触及了志向，\n不懂的\n还是不懂——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "ってことよ。",
            "zh": "就是这么回事哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "96/TALK",
            "narrator": "真幌",
            "text": "随分ネガティブな\n考えだな。",
            "zh": "想法相当\n消极啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "だって、そうじゃない。",
            "zh": "因为，不是那样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "いくら志に触れたと\nしても――",
            "zh": "就算触及了志向\n——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "親子であっても分かり\n合えないことって、\nあると思うわ。",
            "zh": "就算是亲子，\n也有无法互相理解的\n时候，我觉得。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "真幌",
            "text": "…まあ、そうだな。",
            "zh": "……嘛，是啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "101/TALK",
            "narrator": "真幌",
            "text": "敢えて伝えないという\nのも、人生ではあるな。",
            "zh": "故意不说，\n人生里也是有的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "でしょ？",
            "zh": "对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "真幌",
            "text": "ああ、おまえの\n言う通りだ…。",
            "zh": "啊，你说得\n对……",
            "narrator_zh": "真幌"
        },
        {
            "location": "104/TALK",
            "narrator": "真幌",
            "text": "だがな、ギャヴィ。\n問題はそこじゃない。",
            "zh": "可是啊，加维。\n问题不在那里。",
            "narrator_zh": "真幌"
        },
        {
            "location": "105/TALK",
            "narrator": "真幌",
            "text": "伝えないまま\n終わったら後悔する。",
            "zh": "不说就结束的话，\n会后悔。",
            "narrator_zh": "真幌"
        },
        {
            "location": "106/TALK",
            "narrator": "真幌",
            "text": "そう思ったからこそ、\nこの爺さんはきっと――",
            "zh": "正因为这么想，\n这位老爷子一定会——",
            "narrator_zh": "真幌"
        },
        {
            "location": "107/TALK",
            "narrator": "真幌",
            "text": "孫に自分の志を\n伝えたんじゃないか？",
            "zh": "不是向孙子\n传达了自己的志向吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "真幌",
            "text": "まあ、これは私個人の\n感想ではあるがな。",
            "zh": "不过，这也就是我个人的\n看法罢了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "110/TALK",
            "narrator": "真幌",
            "text": "おまえには、そういう\n想いはないのか？",
            "zh": "你就没有\n那种想法吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしの気持ちは、\nどうなのかしら？",
            "zh": "…那我自己的心情，\n又算什么呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "このまま伝えないまま\nいようと思ったけど…。",
            "zh": "我本来想就这样\n一直不说出口的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "…そっか。",
            "zh": "……这样啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "なんか、それ聞いて\n納得したわ。",
            "zh": "听你这么一说，\n我倒是想通了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "真幌",
            "text": "そうか？\nそう言ってもらえると、\n私も嬉しいよ。",
            "zh": "是吗？\n你这么说，\n我也高兴。",
            "narrator_zh": "真幌"
        },
        {
            "location": "118/TALK",
            "narrator": "ガブリエラ",
            "text": "…伝えないまま終わる\n後悔、か…。",
            "zh": "…什么都没说就结束的\n后悔，是吧…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしも、ちゃんと\n自分の気持ちを\n伝えないと。",
            "zh": "我也得好好\n把自己的心情\n说出来才行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/TALK",
            "narrator": "ガブリエラ",
            "text": "言わないで、\nいつか絶対に後悔する\n日が来る前に…。",
            "zh": "别说，\n在将来一定会后悔的\n那天到来之前……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "121/ACT",
            "narrator": "",
            "text": "通じる日が来るまで待つ",
            "zh": "等到彼此能相通的那天",
            "narrator_zh": ""
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "時が解決するのを待つのが一番よね",
            "zh": "等时间去解决是最好的吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "…このおじいさんさ、\n多分間違ってると\n思うわ。",
            "zh": "……这个爷爷，\n我觉得大概\n错了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "135/TALK",
            "narrator": "真幌",
            "text": "ギャヴィは\nそう思うのか？",
            "zh": "加维\n这么想吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "137/TALK",
            "narrator": "ガブリエラ",
            "text": "確かに、気持ちが\n通じ合ってないのは\n嫌かもしれない。",
            "zh": "确实，心意\n不通的话，\n也许讨厌。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "けど、待つことで\nハッピーエンドに\n繋がる可能性も――",
            "zh": "可是，靠等待\n也有可能通向\n圆满结局——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "あると思うの。",
            "zh": "我觉得是有的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "141/TALK",
            "narrator": "ガブリエラ",
            "text": "間違ってないでしょ？",
            "zh": "没错吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "真幌",
            "text": "…さあな。\n私にはわからん。",
            "zh": "……谁知道。\n我不懂。",
            "narrator_zh": "真幌"
        },
        {
            "location": "144/TALK",
            "narrator": "真幌",
            "text": "だが、一つだけ\n言えることがある。",
            "zh": "可是，有一件事\n我可以说。",
            "narrator_zh": "真幌"
        },
        {
            "location": "146/TALK",
            "narrator": "真幌",
            "text": "…相手がいつまでも\n待ってくれるとは\n思うなよ。",
            "zh": "……别以为对方\n会一直\n等着你。",
            "narrator_zh": "真幌"
        },
        {
            "location": "147/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "148/TALK",
            "narrator": "真幌",
            "text": "通じる日が最後まで\n来なかったとしたら――",
            "zh": "如果直到最后\n那一天都没来——",
            "narrator_zh": "真幌"
        },
        {
            "location": "149/TALK",
            "narrator": "真幌",
            "text": "最後に残るのは、\n伝えなかったことへの\n後悔だけだからな。",
            "zh": "最后留下的，\n只有没说出口的\n后悔。",
            "narrator_zh": "真幌"
        },
        {
            "location": "150/TALK",
            "narrator": "真幌",
            "text": "ギャヴィはそんなことに\nなるなよ。",
            "zh": "加维可别\n变成那样。",
            "narrator_zh": "真幌"
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "そっか…通じる日が\n来なかったら――",
            "zh": "这样啊……要是\n心意相通的那一天没来——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "待ってるのは、\n後悔だけなんだ…。",
            "zh": "等来的，\n只有后悔……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "156/TALK",
            "narrator": "ガブリエラ",
            "text": "なんか、それ聞いて\n納得したわ。",
            "zh": "听你这么一说，\n我倒是想通了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "157/TALK",
            "narrator": "真幌",
            "text": "そうか？\nそう言ってもらえると、\n私も嬉しいよ。",
            "zh": "是吗？\n你这么说，\n我也高兴。",
            "narrator_zh": "真幌"
        },
        {
            "location": "159/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしも、ちゃんと\n自分の気持ちを\n伝えないと。",
            "zh": "我也得好好\n把自己的心情\n说出来才行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "160/TALK",
            "narrator": "ガブリエラ",
            "text": "言わないで、\nいつか絶対に後悔する\n日が来る前に…。",
            "zh": "别说，\n在将来一定会后悔的\n那天到来之前……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "161/ACT",
            "narrator": "",
            "text": "秘するが花って言葉もあるね",
            "zh": "也有句话叫秘则为花呢",
            "narrator_zh": ""
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "说得对",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "最後まで自分の中に秘めていた方が幸せってことは",
            "zh": "一直藏在自己心里直到最后才更幸福，这种事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "164/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対にあると思うわ",
            "zh": "我绝对觉得是有的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "176/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、志を伝えたと\nしても――",
            "zh": "……可是，就算传达了志向\n——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "相手に伝わる保証なんて\nないわけよね？",
            "zh": "也没有保证能传到对方那里\n吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "179/TALK",
            "narrator": "真幌",
            "text": "そりゃそうだ。\n分かり合えないことも\nあるのが人生だからな。",
            "zh": "那当然。\n人生里总会有\n互相无法理解的事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "180/TALK",
            "narrator": "ガブリエラ",
            "text": "だったら、そんなのは\n伝えない方が幸せなん\nじゃない？",
            "zh": "那样的话，那种事\n不说反而比较\n幸福吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "181/TALK",
            "narrator": "ガブリエラ",
            "text": "分かり合えない、\nってことがわかっちゃう\nより――",
            "zh": "与其明白\n无法互相理解\n这件事——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "182/TALK",
            "narrator": "ガブリエラ",
            "text": "何も伝えないでいる方が\n悪いことにはならないと\n思うわ。",
            "zh": "什么都不说，\n我觉得不会变成\n更糟的事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "真幌",
            "text": "…まあ、そういう\n考え方もあるな。",
            "zh": "……嘛，那种\n想法也是有的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "185/TALK",
            "narrator": "ガブリエラ",
            "text": "でしょ？",
            "zh": "对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "186/TALK",
            "narrator": "真幌",
            "text": "ああ…だが…。",
            "zh": "啊……可是……",
            "narrator_zh": "真幌"
        },
        {
            "location": "188/TALK",
            "narrator": "真幌",
            "text": "おまえは自分の気持ちを\n伝えないまま終わる\nことに――",
            "zh": "你把自己的心情\n一直不说出来\n就这么结束——",
            "narrator_zh": "真幌"
        },
        {
            "location": "189/TALK",
            "narrator": "真幌",
            "text": "後悔を覚えずに\nいられるか？",
            "zh": "能不感到\n后悔吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "191/TALK",
            "narrator": "ガブリエラ",
            "text": "…え？",
            "zh": "……诶？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "192/TALK",
            "narrator": "真幌",
            "text": "少なくとも、この映画の\n爺さんはそう思ったん\nだろうな。",
            "zh": "至少，这部电影的\n老爷子是这么\n想的吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "193/TALK",
            "narrator": "真幌",
            "text": "だから、孫に自分の志を\n伝えたんじゃないか？",
            "zh": "所以，他不是把志向\n传给孙子了吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/TALK",
            "narrator": "真幌",
            "text": "まあ、これは私個人の\n感想ではあるがな。",
            "zh": "不过，这也就是我个人的\n看法罢了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "198/TALK",
            "narrator": "真幌",
            "text": "おまえには、そういう\n想いはないのか？",
            "zh": "你就没有\n那种想法吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "199/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "201/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしの気持ちは、\nどうなのかしら？",
            "zh": "…那我自己的心情，\n又算什么呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "202/TALK",
            "narrator": "ガブリエラ",
            "text": "このまま伝えないまま\nいようと思ったけど…。",
            "zh": "我本来想就这样\n一直不说出口的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/TALK",
            "narrator": "ガブリエラ",
            "text": "…そっか。",
            "zh": "……这样啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "204/TALK",
            "narrator": "ガブリエラ",
            "text": "なんか、それ聞いて\n納得したわ。",
            "zh": "听你这么一说，\n我倒是想通了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "真幌",
            "text": "そうか？\nそう言ってもらえると、\n私も嬉しいよ。",
            "zh": "是吗？\n你这么说，\n我也高兴。",
            "narrator_zh": "真幌"
        },
        {
            "location": "207/TALK",
            "narrator": "ガブリエラ",
            "text": "…伝えないまま終わる\n後悔、か…。",
            "zh": "…什么都没说就结束的\n后悔，是吧…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしも、ちゃんと\n自分の気持ちを\n伝えないと。",
            "zh": "我也得好好\n把自己的心情\n说出来才行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "210/TALK",
            "narrator": "ガブリエラ",
            "text": "言わないで、\nいつか絶対に後悔する\n日が来る前に…。",
            "zh": "别说，\n在将来一定会后悔的\n那天到来之前……。",
            "narrator_zh": "加布里埃拉"
        },
        {
