    "entry": [
        {
            "location": "123/SCENARIO",
            "narrator": "",
            "text": "たったひとつのやおよろず",
            "zh": "唯一的八百万",
            "narrator_zh": ""
        },
        {
            "location": "125/TALK",
            "narrator": "アーヤ",
            "text": "そうねえ",
            "zh": "这个嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "127/TALK",
            "narrator": "アーヤ",
            "text": "そうだ",
            "zh": "对了",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "アーヤ",
            "text": "六曜って知ってる？",
            "zh": "你知道六曜吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "あれ本来神社と全く関係ないのよね(>_<)",
            "zh": "那个其实本来和神社完全没关系哦(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "131/SEL",
            "narrator": "",
            "text": "そうだったんだ？",
            "zh": "原来是这样啊？",
            "narrator_zh": ""
        },
        {
            "location": "132/SEL",
            "narrator": "",
            "text": "ていうか、六曜って何？",
            "zh": "话说回来，六曜是什么？",
            "narrator_zh": ""
        },
        {
            "location": "133/SEL",
            "narrator": "",
            "text": "幕末辺りに成立したらしいね",
            "zh": "好像是在幕末左右定下来的吧",
            "narrator_zh": ""
        },
        {
            "location": "134/ACT",
            "narrator": "",
            "text": "そうだったんだ？",
            "zh": "原来是这样啊？",
            "narrator_zh": ""
        },
        {
            "location": "135/TALK",
            "narrator": "アーヤ",
            "text": "普通の人は",
            "zh": "普通人",
            "narrator_zh": "绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり知らないもの",
            "zh": "果然还是不知道嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "137/ACT",
            "narrator": "",
            "text": "ていうか、六曜って何？",
            "zh": "话说回来，六曜是什么？",
            "narrator_zh": ""
        },
        {
            "location": "138/TALK",
            "narrator": "アーヤ",
            "text": "大安とか仏滅とか",
            "zh": "就是大安啊佛灭啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "139/TALK",
            "narrator": "アーヤ",
            "text": "そういうやつのこと",
            "zh": "说的就是那种东西",
            "narrator_zh": "绫水"
        },
        {
            "location": "140/ACT",
            "narrator": "",
            "text": "幕末辺りに成立したらしいね",
            "zh": "好像是在幕末左右定下来的吧",
            "narrator_zh": ""
        },
        {
            "location": "141/TALK",
            "narrator": "アーヤ",
            "text": "そうそう",
            "zh": "对对",
            "narrator_zh": "绫水"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "そうなのよ",
            "zh": "就是那样",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "アーヤ",
            "text": "でもなんだかいつの間にか",
            "zh": "可是总觉得不知不觉间",
            "narrator_zh": "绫水"
        },
        {
            "location": "144/TALK",
            "narrator": "アーヤ",
            "text": "神道の一部みたいに思われてたりして",
            "zh": "就被人当成神道教的一部分了",
            "narrator_zh": "绫水"
        },
        {
            "location": "145/TALK",
            "narrator": "アーヤ",
            "text": "なんでこうなっちゃったのかしらね？",
            "zh": "怎么会变成这样了呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "147/TALK",
            "narrator": "アーヤ",
            "text": "気にする人も多いから",
            "zh": "因为在意的人也很多",
            "narrator_zh": "绫水"
        },
        {
            "location": "148/TALK",
            "narrator": "アーヤ",
            "text": "もちろんそういったことも",
            "zh": "当然那方面的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "149/TALK",
            "narrator": "アーヤ",
            "text": "考慮するけどね",
            "zh": "我们也会考虑进去就是了",
            "narrator_zh": "绫水"
        },
        {
            "location": "151/SEL",
            "narrator": "",
            "text": "商売だしね",
            "zh": "毕竟也是生意嘛",
            "narrator_zh": ""
        },
        {
            "location": "152/SEL",
            "narrator": "",
            "text": "波風は立てたくないしね",
            "zh": "也不想闹出风波嘛",
            "narrator_zh": ""
        },
        {
            "location": "153/SEL",
            "narrator": "",
            "text": "アーヤは大人だよね",
            "zh": "绫水已经是个大人了嘛",
            "narrator_zh": ""
        },
        {
            "location": "154/ACT",
            "narrator": "",
            "text": "商売だしね",
            "zh": "毕竟也是生意嘛",
            "narrator_zh": ""
        },
        {
            "location": "155/TALK",
            "narrator": "アーヤ",
            "text": "そうだけど",
            "zh": "话是这么说",
            "narrator_zh": "绫水"
        },
        {
            "location": "156/TALK",
            "narrator": "アーヤ",
            "text": "その言い方はちょっとね",
            "zh": "你这说法有点太直白了吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "157/ACT",
            "narrator": "",
            "text": "波風は立てたくないしね",
            "zh": "也不想闹出风波嘛",
            "narrator_zh": ""
        },
        {
            "location": "158/TALK",
            "narrator": "アーヤ",
            "text": "そういうことなんだけど",
            "zh": "确实是这样没错",
            "narrator_zh": "绫水"
        },
        {
            "location": "159/TALK",
            "narrator": "アーヤ",
            "text": "もう少しね",
            "zh": "不过还是再委婉一点吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "160/ACT",
            "narrator": "",
            "text": "アーヤは大人だよね",
            "zh": "绫水已经是个大人了嘛",
            "narrator_zh": ""
        },
        {
            "location": "161/TALK",
            "narrator": "アーヤ",
            "text": "実際子供のふりも",
            "zh": "实际上也不是",
            "narrator_zh": "绫水"
        },
        {
            "location": "162/TALK",
            "narrator": "アーヤ",
            "text": "できない年だしね",
            "zh": "能装小孩的年纪了",
            "narrator_zh": "绫水"
        },
        {
            "location": "164/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "165/TALK",
            "narrator": "アーヤ",
            "text": "少しは落ち着いて見られてるのかしら？",
            "zh": "这是说明看起来多少稳重了点吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "166/TALK",
            "narrator": "アーヤ",
            "text": "だったら",
            "zh": "如果是那样的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "悪い気はしないわ",
            "zh": "感觉倒也不坏",
            "narrator_zh": "绫水"
        },
        {
            "location": "170/TALK",
            "narrator": "アーヤ",
            "text": "こういうのを",
            "zh": "像这种事",
            "narrator_zh": "绫水"
        },
        {
            "location": "171/TALK",
            "narrator": "アーヤ",
            "text": "調べたりするの",
            "zh": "去查一查什么的",
            "narrator_zh": "绫水"
        },
        {
            "location": "172/TALK",
            "narrator": "アーヤ",
            "text": "実は意外と嫌いじゃないの",
            "zh": "其实我意外地并不讨厌",
            "narrator_zh": "绫水"
        },
        {
            "location": "173/TALK",
            "narrator": "アーヤ",
            "text": "今度ちゃんと",
            "zh": "下次干脆",
            "narrator_zh": "绫水"
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "調べてみようかな(￣Д￣ )",
            "zh": "好好调查一下吧(￣Д￣ )",
