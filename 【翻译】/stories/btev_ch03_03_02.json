{
    "dir": "chap03/battle/btev_ch03_03_02.js",
    "type": "",
    "info": {
        "story_id": "23003",
        "cid": "",
        "title": "003 ココロスフィアストーリー【Lv01】",
        "sub_title": "明晰記憶喪失＜帰結＞",
        "title_zh": "003 心灵领域故事【Lv01】",
        "sub_title_zh": "明确性记忆丧失＜归结＞"
    },
    "entry": [
        {
            "location": "227/SCENARIO",
            "narrator": "",
            "text": "バトル終了",
            "zh": "战斗结束",
            "narrator_zh": ""
        },
        {
            "location": "236/TALK",
            "narrator": "潜在ガブリエラ",
            "text": "……なんて\n…ことなの？",
            "zh": "……怎么会\n……这样？",
            "narrator_zh": "潜在加布里埃拉"
        },
        {
            "location": "237/TALK",
            "narrator": "表層ガブリエラ",
            "text": "……。　　　　",
            "zh": "……。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "239/TALK",
            "narrator": "潜在ガブリエラ",
            "text": "ケダモノ！\n……銃なんて、\n何も…生まないのに…",
            "zh": "野兽！\n……枪这种东西，\n明明……什么也创造不出……",
            "narrator_zh": "潜在加布里埃拉"
        },
        {
            "location": "245/TALK",
            "narrator": "表層ガブリエラ",
            "text": "……。　　　　",
            "zh": "……。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "248/TALK",
            "narrator": "表層ガブリエラ",
            "text": "ありがと。\nあんたのお陰で\nあたしは救われる。",
            "zh": "谢谢。\n多亏了你，\n我得救了。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "250/SEL",
            "narrator": "（選択肢）",
            "text": "どういたしまして",
            "zh": "不客气",
            "narrator_zh": "（选项）"
        },
        {
            "location": "251/SEL",
            "narrator": "（選択肢）",
            "text": "過去見せてくれるんでしょ？",
            "zh": "你会让我看你的过去吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "252/ACT",
            "narrator": "",
            "text": "どういたしまして",
            "zh": "不客气",
            "narrator_zh": ""
        },
        {
            "location": "253/TALK",
            "narrator": "表層ガブリエラ",
            "text": "それじゃ約束通り\nあたしの過去を\n見せてあげるわ。",
            "zh": "那就照约定那样，\n把我的过去\n给你看看吧。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "254/ACT",
            "narrator": "",
            "text": "過去見せてくれるんでしょ？",
            "zh": "你会让我看你的过去吧？",
            "narrator_zh": ""
        },
        {
            "location": "255/TALK",
            "narrator": "表層ガブリエラ",
            "text": "見せるわよ。\nせっかちなんだから。",
            "zh": "给你看就是了。\n真是急性子。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "257/TALK",
            "narrator": "表層ガブリエラ",
            "text": "それは昔のこと。\nあたしが\n初等部だった頃の話よ。",
            "zh": "那是很久以前的事了。\n是我还在\n小学部那会儿的事。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "278/DIALOG",
            "narrator": "",
            "text": "あたしの生まれ育った街\nそれは、ポーランド共和国の首都、\nワルシャワだった。",
            "zh": "我出生并长大的城市，\n是波兰共和国的首都，\n华沙。",
            "narrator_zh": ""
        },
        {
            "location": "280/TALK",
            "narrator": "ガブリエラ",
            "text": "あーっ、楽しかった！",
            "zh": "啊——，真开心！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "281/TALK",
            "narrator": "ガブリエラ",
            "text": "また明日も\nアーニャちゃんの\nおうちに行こっと。",
            "zh": "明天也要再去\n阿尼娅\n家里玩。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "282/DIALOG",
            "narrator": "",
            "text": "この頃のポーランドは、\n東西の対立が激化していたこともあり、\nかなり物騒な状況だった。",
            "zh": "那时候的波兰，\n加上东西方对立日趋激化，\n局势相当动荡不安。",
            "narrator_zh": ""
        },
        {
            "location": "283/TALK",
            "narrator": "ガブリエラ",
            "text": "いけないわ。\nもうこんな時間！",
            "zh": "糟糕。\n都这么晚了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "284/TALK",
            "narrator": "ガブリエラ",
            "text": "早く帰らないと、\nお父様に怒られちゃう。",
            "zh": "再不快点回去，\n爸爸要生气的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "296/DIALOG",
            "narrator": "",
            "text": "街の治安は悪化し、\n夜出歩くことは\nとても危険なことだった。",
            "zh": "城里的治安不断恶化，\n晚上出门走动\n是非常危险的事。",
            "narrator_zh": ""
        },
        {
            "location": "297/DIALOG",
            "narrator": "",
            "text": "そして、その情勢不安は\nあたしの家にも\n最悪の事件をもたらしたの。",
            "zh": "而那份动荡不安，\n也给我的家里\n带来了最糟糕的事件。",
            "narrator_zh": ""
        },
        {
            "location": "302/SEL",
            "narrator": "（選択肢）",
            "text": "どういたしまして",
            "zh": "不客气",
            "narrator_zh": "（选项）"
        },
        {
            "location": "303/SEL",
            "narrator": "（選択肢）",
            "text": "デートしてくれるんでしょ？",
            "zh": "你会和我约会吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "304/ACT",
            "narrator": "",
            "text": "どういたしまして",
            "zh": "不客气",
            "narrator_zh": ""
        },
        {
            "location": "305/TALK",
            "narrator": "表層ガブリエラ",
            "text": "それじゃ約束通り\nデート、する？",
            "zh": "那就照约定那样，\n约会……吗？",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "306/SEL",
            "narrator": "（選択肢）",
            "text": "する！",
            "zh": "约！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "307/ACT",
            "narrator": "",
            "text": "する！",
            "zh": "约！",
            "narrator_zh": ""
        },
        {
            "location": "309/ACT",
            "narrator": "",
            "text": "デートしてくれるんでしょ？",
            "zh": "你会和我约会吧？",
            "narrator_zh": ""
        },
        {
            "location": "310/TALK",
            "narrator": "表層ガブリエラ",
            "text": "す、するわよ！\nもう、せっかち\nなんだから。",
            "zh": "约、约就是了！\n真是的，\n急死人了。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "332/TALK",
            "narrator": "ガブリエラ",
            "text": "せっかくだから、\nあたしの故郷の\nワルシャワにしてみた。",
            "zh": "难得约一次，\n我就把地点选在故乡\n华沙了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "333/SEL",
            "narrator": "（選択肢）",
            "text": "どこの国だっけ？",
            "zh": "那是哪个国家来着？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "334/SEL",
            "narrator": "（選択肢）",
            "text": "その服かわいい",
            "zh": "那身衣服好可爱",
            "narrator_zh": "（选项）"
        },
        {
            "location": "335/ACT",
            "narrator": "",
            "text": "どこの国だっけ？",
            "zh": "那是哪个国家来着？",
            "narrator_zh": ""
        },
        {
            "location": "337/TALK",
            "narrator": "ガブリエラ",
            "text": "ポーランドよ！\nポーランドの首都！",
            "zh": "波兰呀！\n波兰的首都！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "338/ACT",
            "narrator": "",
            "text": "その服かわいい",
            "zh": "那身衣服好可爱",
            "narrator_zh": ""
        },
        {
            "location": "344/DIALOG",
            "narrator": "",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": ""
        },
        {
            "location": "349/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？　うそよ……\nちょっと子供っぽくて\n恥ずかしいのに。",
            "zh": "诶！？　骗人的吧……\n明明有点幼稚，\n怪不好意思的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "350/TALK",
            "narrator": "ガブリエラ",
            "text": "昔ポーランドにいた頃\n着ていた服なのよ。",
            "zh": "这是以前在波兰的时候\n穿过的衣服哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "353/TALK",
            "narrator": "ガブリエラ",
            "text": "当時のポーランドは\n情勢不安が酷くて\n大変だったわ。",
            "zh": "那时候的波兰，\n局势动荡得很厉害，\n日子真不好过。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "354/TALK",
            "narrator": "ガブリエラ",
            "text": "今でも\nそうなんでしょうけど。",
            "zh": "虽说现在大概\n也还是那样吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "355/TALK",
            "narrator": "ガブリエラ",
            "text": "だからすごく治安が\n悪くて。こんなに\n綺麗な街なのにね。",
            "zh": "所以治安非常差。\n明明是这么\n漂亮的城市啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "356/SEL",
            "narrator": "（選択肢）",
            "text": "大変だったね",
            "zh": "真不容易呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "357/ACT",
            "narrator": "",
            "text": "大変だったね",
            "zh": "真不容易呀",
            "narrator_zh": ""
        },
        {
            "location": "359/TALK",
            "narrator": "ガブリエラ",
            "text": "そう。\n大変だったわ。",
            "zh": "是啊。\n真不容易。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "361/TALK",
            "narrator": "ガブリエラ",
            "text": "私の家も、\n被害にあったもの。",
            "zh": "就连我家，\n也遭了殃。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "362/SEL",
            "narrator": "（選択肢）",
            "text": "え？　だいじょうぶ！？",
            "zh": "诶？　不要紧吧！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "363/ACT",
            "narrator": "",
            "text": "え？　だいじょうぶ！？",
            "zh": "诶？　不要紧吧！？",
            "narrator_zh": ""
        },
        {
            "location": "365/TALK",
            "narrator": "ガブリエラ",
            "text": "……あまり。",
            "zh": "……算不上好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "366/TALK",
            "narrator": "ガブリエラ",
            "text": "…聞いてくれる？\n何があったか。",
            "zh": "……你愿意听吗？\n当时发生了什么。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "379/DIALOG",
            "narrator": "",
            "text": "強盗。",
            "zh": "强盗。",
            "narrator_zh": ""
        },
        {
            "location": "381/DIALOG",
            "narrator": "",
            "text": "あいつらは、うちのことを\n前もって調べていたみたい。\n\nお父様が一番油断する\n夕食後の団欒を\n狙って襲ってきたのだから。",
            "zh": "那帮家伙，似乎提前\n就把我家调查清楚了。\n\n因为他们专挑爸爸\n最松懈的晚饭后一家团聚时\n袭击了过来。",
            "narrator_zh": ""
        },
        {
            "location": "383/DIALOG",
            "narrator": "",
            "text": "銃を取る間もなく、\nお母様は強盗に\n羽交い締めにされたわ。\n\nそして、\nお父様の説得の甲斐も無く――",
            "zh": "连拿枪的工夫都没有，\n妈妈就被强盗\n从背后制住了。\n\n然后，\n爸爸的劝说也无济于事——",
            "narrator_zh": ""
        },
        {
            "location": "399/DIALOG",
            "narrator": "",
            "text": "お母様は\n殺された。",
            "zh": "妈妈\n被杀害了。",
            "narrator_zh": ""
        },
        {
            "location": "412/TALK",
            "narrator": "表層ガブリエラ",
            "text": "この事件があって、\nあたしは銃を撃つとき\n必ず抵抗を感じるの。",
            "zh": "经过这件事之后，\n每当要开枪时，\n我总会感到一阵抗拒。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "414/TALK",
            "narrator": "表層ガブリエラ",
            "text": "それは、さっきの\nもう一人のあたしの\nような――",
            "zh": "那就像刚才的\n另一个我\n那样——",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "415/TALK",
            "narrator": "表層ガブリエラ",
            "text": "もう銃を見るのも嫌\nっていうあたしが\n心の中にいるから。",
            "zh": "因为我心里住着一个\n连看都不想再看到枪的\n另一个我。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "416/TALK",
            "narrator": "表層ガブリエラ",
            "text": "でも、ドーム戦の時の\n抵抗は凄かったわ。",
            "zh": "不过，穹顶战那次的\n抗拒强烈得惊人。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "417/TALK",
            "narrator": "表層ガブリエラ",
            "text": "いつもだったら\nあたし一人で抑え\n込めたんだけど……。",
            "zh": "换作平时的话，\n我一个人就能\n压制住的……。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "418/TALK",
            "narrator": "表層ガブリエラ",
            "text": "もしかしたら、\n何か別の要因が\nあるのかも。",
            "zh": "说不定，\n还有什么别的\n诱因存在。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "419/SEL",
            "narrator": "（選択肢）",
            "text": "どんな？",
            "zh": "什么样的？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "420/ACT",
            "narrator": "",
            "text": "どんな？",
            "zh": "什么样的？",
            "narrator_zh": ""
        },
        {
            "location": "422/TALK",
            "narrator": "表層ガブリエラ",
            "text": "それはあたしには\nわからないわ。",
            "zh": "那我就\n不知道了。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "423/TALK",
            "narrator": "表層ガブリエラ",
            "text": "あたしが教えられる\nのは、これくらいね。",
            "zh": "我能告诉你的，\n也就这么多了。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "424/TALK",
            "narrator": "表層ガブリエラ",
            "text": "ともあれ、あの時\nあんたが助けてくれた\nことは感謝してる。",
            "zh": "不管怎样，那时候\n你帮了我，\n我还是很感谢的。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "425/TALK",
            "narrator": "表層ガブリエラ",
            "text": "今回のことも……。",
            "zh": "这次的事也是……。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "427/TALK",
            "narrator": "表層ガブリエラ",
            "text": "あ、ありがと。",
            "zh": "谢、谢谢。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "428/TALK",
            "narrator": "表層ガブリエラ",
            "text": "お陰で落ち着いて\n撃てそう。",
            "zh": "托你的福，现在应该能\n冷静地开枪了。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "429/SEL",
            "narrator": "（選択肢）",
            "text": "どういたしまして",
            "zh": "不客气",
            "narrator_zh": "（选项）"
        },
        {
            "location": "430/ACT",
            "narrator": "",
            "text": "どういたしまして",
            "zh": "不客气",
            "narrator_zh": ""
        },
        {
            "location": "432/TALK",
            "narrator": "表層ガブリエラ",
            "text": "それじゃ、\nあたしはこれで。",
            "zh": "那就这样，\n我先走了。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "434/TALK",
            "narrator": "表層ガブリエラ",
            "text": "また縁があったら\nここで会いましょ。",
            "zh": "有缘的话，\n再在这里见吧。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "458/TALK",
            "narrator": "千羽鶴",
            "text": "おめでとう。",
            "zh": "恭喜你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "459/TALK",
            "narrator": "千羽鶴",
            "text": "あなたは彼女の\nココロの迷いを解消し、\n一歩前進させた。",
            "zh": "你解开了她\n心里的迷茫，\n让她往前走了一步。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "460/SEL",
            "narrator": "（選択肢）",
            "text": "えっへん",
            "zh": "嘿嘿",
            "narrator_zh": "（选项）"
        },
        {
            "location": "461/SEL",
            "narrator": "（選択肢）",
            "text": "あまり実感ない",
            "zh": "没什么实感",
            "narrator_zh": "（选项）"
        },
        {
            "location": "462/SEL",
            "narrator": "（選択肢）",
            "text": "本当にこれで良かったのだろうか",
            "zh": "这样真的好吗",
            "narrator_zh": "（选项）"
        },
        {
            "location": "463/ACT",
            "narrator": "",
            "text": "えっへん",
            "zh": "嘿嘿",
            "narrator_zh": ""
        },
        {
            "location": "464/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。\n今回ばかりは\n誇っていいと思う。",
            "zh": "是的。\n只有这一次，\n可以觉得骄傲。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "465/ACT",
            "narrator": "",
            "text": "あまり実感ない",
            "zh": "没什么实感",
            "narrator_zh": ""
        },
        {
            "location": "466/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。\nそう思うかも知れない。\nでも――",
            "zh": "是的。\n也许会这么想。\n但是——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "467/ACT",
            "narrator": "",
            "text": "本当にこれで良かったのだろうか",
            "zh": "这样真的好吗",
            "narrator_zh": ""
        },
        {
            "location": "469/TALK",
            "narrator": "千羽鶴",
            "text": "選択に絶対的な\n正解なんて最初から\n存在しない。",
            "zh": "选择从一开始\n就不存在绝对的\n正确答案。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "471/TALK",
            "narrator": "千羽鶴",
            "text": "汚い言い方をすれば、\n利己的な選択をし、\n結果が伴えば正解。",
            "zh": "说得难听一点，\n做出利己的选择，\n只要有了结果就是正确。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "472/TALK",
            "narrator": "千羽鶴",
            "text": "それは申し訳無いけど\n今はあなたも知らない\n私の思惑も含めて。",
            "zh": "这话很抱歉，\n其中也包括你现在还不知道的\n我的盘算。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "473/TALK",
            "narrator": "千羽鶴",
            "text": "一般的にも、ダメな\n選択をしたと思ったら\n物事が好転したり――",
            "zh": "一般说来，也会有\n觉得做了糟糕的选择，\n事情却好转的情况——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "474/TALK",
            "narrator": "千羽鶴",
            "text": "逆に順当な選択をした\nつもりが、後悔する\n結果になったりもする。",
            "zh": "反过来，本以为\n做了稳妥的选择，\n结果却会后悔。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "475/TALK",
            "narrator": "千羽鶴",
            "text": "大事なのは\n「自分はどうしたいか」",
            "zh": "重要的是\n“自己想怎样”",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "476/TALK",
            "narrator": "千羽鶴",
            "text": "周囲のノイズを遮断し\n自分で決めること。",
            "zh": "隔绝周围的噪音，\n由自己来决定。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "477/TALK",
            "narrator": "千羽鶴",
            "text": "私があなたにお願い\nしたいのは、あくまで\nそのサポートなの。",
            "zh": "我想请你做的，\n归根结底是\n这份支持。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "479/TALK",
            "narrator": "千羽鶴",
            "text": "人のココロを動かす\nには、いつも大きな\n力が必要とは限らない。",
            "zh": "打动人的心，\n并不总是需要\n很大的力量。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "480/TALK",
            "narrator": "千羽鶴",
            "text": "些細なきっかけを\n与えるだけで、整理が\nつくこともある。",
            "zh": "有时只给一个\n细小的契机，\n心里就能理清。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "481/TALK",
            "narrator": "千羽鶴",
            "text": "そうやって、逃げずに\n決めて、それを実行\nすることは――",
            "zh": "像这样，不逃避地\n做出决定，再去实行\n——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "482/TALK",
            "narrator": "千羽鶴",
            "text": "次第にココロを\n強くすることに繋がる。",
            "zh": "会渐渐让心\n变得坚强。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "483/SEL",
            "narrator": "（選択肢）",
            "text": "よくわからない",
            "zh": "不太明白",
            "narrator_zh": "（选项）"
        },
        {
            "location": "484/ACT",
            "narrator": "",
            "text": "よくわからない",
            "zh": "不太明白",
            "narrator_zh": ""
        },
        {
            "location": "486/TALK",
            "narrator": "千羽鶴",
            "text": "一気に理解は\n出来ないと思う。",
            "zh": "我想你没法\n一下子就理解。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "487/TALK",
            "narrator": "千羽鶴",
            "text": "とにかくあなたには、\nこれからもずっと、\n今回の様に――",
            "zh": "总之，希望你\n今后也一直，\n像这次这样——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "488/TALK",
            "narrator": "千羽鶴",
            "text": "彼女のココロの成長を\n支援してあげて欲しい。",
            "zh": "去支持她的心\n成长。",
            "narrator_zh": "千羽鹤"
        }
    ]
}
