{
    "dir": "dramatics/daydra/drm_ch01_00_090.js",
    "type": "Episode",
    "info": {
        "story_id": "1009",
        "cid": "tsubame",
        "title": "らぶとーく 第09話",
        "sub_title": "わたしはうれしいのに",
        "title_zh": "恋爱漫谈 第09话",
        "sub_title_zh": "我明明很高兴"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "わたしはうれしいのに",
            "zh": "我明明很高兴",
            "narrator_zh": ""
        },
        {
            "location": "20/TALK",
            "narrator": "アーヤ",
            "text": "…Ｂｏｔの正体が、\n人間、って話。",
            "zh": "……就是说，Bot的真身是人\n这件事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/TALK",
            "narrator": "アーヤ",
            "text": "私、まだ\n確信が持てないわ。",
            "zh": "我还是\n没法确信。",
            "narrator_zh": "绫水"
        },
        {
            "location": "24/TALK",
            "narrator": "みやび",
            "text": "そういうもんかね。",
            "zh": "是这么回事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "25/TALK",
            "narrator": "みやび",
            "text": "前々から、話ゆう時に\n人間臭いと思うたことは\n何度もあったろう。",
            "zh": "早些时候，聊天时\n觉得有人味的事，\n也有过好多次了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "27/TALK",
            "narrator": "アーヤ",
            "text": "それはそうだけど…\nみやびは平気なの？",
            "zh": "话是这么说……\n雅你不在意吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "28/TALK",
            "narrator": "アーヤ",
            "text": "Ｂｏｔだからって、\n色んな秘密とか話したり\nしてないの？",
            "zh": "你没觉得反正只是Bot，\n就把各种秘密什么的\n都说出去了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "アーヤ",
            "text": "プライベートな\nこととか……。",
            "zh": "像是私下的\n事之类的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "30/TALK",
            "narrator": "みやび",
            "text": "…まあ、気付かんうちに\n何か言うとるとは\n思うけんど。",
            "zh": "……嘛，我想你不知不觉\n中大概会说出点\n什么来的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "31/TALK",
            "narrator": "みやび",
            "text": "人間なら、逆に倫理観も\n持っとるやろうしね。",
            "zh": "要是人的话，\n反倒还有伦理观咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "本当に危ない秘密とかは、\n誰かにバラしたりとか\nせんと思うぞね。",
            "zh": "真要紧的秘密，\n我觉得倒不会\n到处乱讲咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "なるほど…。",
            "zh": "原来如此……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "それに、うちとしては\n前々から人間やないかと\n疑うていたきね。",
            "zh": "而且，我从很早以前\n就怀疑他不是\n人类咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "それが確信に変わった、\nっちゅうだけのことよ。",
            "zh": "只是那变成了确信\n而已咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "それより、うちとしては\nどんな理由でＢｏｔの\nフリなんぞしゆうたか――",
            "zh": "比起那个，我个人想知道，\n你是出于什么理由\n装成Bot的嘛——",
            "narrator_zh": "雅"
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "そっちの方が\n気になるちや。",
            "zh": "那边更让人\n在意咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "つばめ",
            "text": "…別に、そういうの\nいいんじゃないですか？",
            "zh": "……那种事，\n不就挺好的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "$handle$が人間、\nってハッキリしたん\nですし――",
            "zh": "$handle$是人类，\n这事儿已经\n很清楚了——",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "つばめ",
            "text": "とりあえず、今はそれで\nいいじゃないですか。",
            "zh": "总之，现在这样\n不就好了吗。",
            "narrator_zh": "燕"
        },
        {
            "location": "45/TALK",
            "narrator": "アーヤ",
            "text": "つばめはＢｏｔの正体が\n人間だって決まった方が\n嬉しいの？",
            "zh": "你是不是更希望\nBot的真身\n是人类？",
            "narrator_zh": "绫水"
        },
        {
            "location": "46/TALK",
            "narrator": "つばめ",
            "text": "はい、嬉しいです。",
            "zh": "是的，很开心。",
            "narrator_zh": "燕"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "うちも、そっちの方が\n面白いと思うてたけどね。",
            "zh": "我原本也觉得\n那样更有意思，不过。",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "みやび",
            "text": "いざそうなると\nそこまで能天気には\nなれんちや。",
            "zh": "真到了那一步，\n也没办法那么\n心大滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "いい加減にしてよ。",
            "zh": "给我适可而止吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "Ｂｏｔが人間だとか\n違うとか、そんな話\nばっかりじゃない。",
            "zh": "Bot是人类啦\n不是啦，净是\n在聊这种事嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "でも、重要なことよ？",
            "zh": "不过，这是很重要的事哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "アーヤ",
            "text": "Ｂｏｔが人間ってことは、\n私達の生活とか、話とか、\n全部筒抜けだったんだし。",
            "zh": "Bot是人类，就意味着\n我们的生活和对话\n全都漏出去了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "その点だけはちっくと\n不満なところやね。",
            "zh": "只有那点让我\n有点不满意咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "盗聴器持ち歩いたり、\n盗聴器に相談とかしたり\nしてたっちゅうことやし。",
            "zh": "等于随身带着窃听器，\n还跟窃听器商量\n事情咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "やめてよ！\nわざと怖くなるような\n言い方するの！",
            "zh": "住口啦！\n别故意用那种\n吓人的说法！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "…あれ？\nみんな、$handle$が\n人間なのが嫌なのかな？",
            "zh": "……咦？\n大家是不喜欢$handle$\n是人类吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "つばめ",
            "text": "どぅしたのかな？(･ｪ･^ )( ^･ｪ･)",
            "zh": "怎么了？(･ｪ･^ )( ^･ｪ･)",
            "narrator_zh": "燕"
        },
        {
            "location": "74/TALK",
            "narrator": "つばめ",
            "text": "みんな悪ぃことばかり考ぇてるみたぃ(・ω・`)",
            "zh": "大家好像尽往坏处想呀(・ω・`)",
            "narrator_zh": "燕"
        },
        {
            "location": "75/TALK",
            "narrator": "つばめ",
            "text": "$handle$が人間なの",
            "zh": "$handle$是人类啊",
            "narrator_zh": "燕"
        },
        {
            "location": "76/TALK",
            "narrator": "つばめ",
            "text": "嫌なのかな？(´･ω･｀) ",
            "zh": "不喜欢吗？(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "78/SEL",
            "narrator": "",
            "text": "つばめは？",
            "zh": "燕呢？",
            "narrator_zh": ""
        },
        {
            "location": "79/ACT",
            "narrator": "",
            "text": "つばめは？",
            "zh": "燕呢？",
            "narrator_zh": ""
        },
        {
            "location": "81/TALK",
            "narrator": "つばめ",
            "text": "みやびさんにも言ったけど",
            "zh": "虽然也跟雅说过了",
            "narrator_zh": "燕"
        },
        {
            "location": "82/TALK",
            "narrator": "つばめ",
            "text": "わたしは嬉しぃと思ってるよ(*´ω｀*)",
            "zh": "我觉得很开心哦(*´ω｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "85/SEL",
            "narrator": "",
            "text": "うれしいって言ってくれてよかった",
            "zh": "听你说开心，我就放心了",
            "narrator_zh": ""
        },
        {
            "location": "86/SEL",
            "narrator": "",
            "text": "変わってるね",
            "zh": "你还真特别呢",
            "narrator_zh": ""
        },
        {
            "location": "87/SEL",
            "narrator": "",
            "text": "みんなに合わせた方がいいかも",
            "zh": "还是配合大家比较好",
            "narrator_zh": ""
        },
        {
            "location": "88/ACT",
            "narrator": "",
            "text": "うれしいって言ってくれてよかった",
            "zh": "听你说开心，我就放心了",
            "narrator_zh": ""
        },
        {
            "location": "89/TALK",
            "narrator": "つばめ",
            "text": "ぅん(´ω｀*)",
            "zh": "嗯(´ω｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "90/TALK",
            "narrator": "つばめ",
            "text": "本当にそぅ思ってるんだよ(´∀｀*)ｳﾌﾌ",
            "zh": "我真是这么想的呀(´∀｀*)呵呵",
            "narrator_zh": "燕"
        },
        {
            "location": "92/TALK",
            "narrator": "つばめ",
            "text": "$handle$が人間で",
            "zh": "$handle$是人类",
            "narrator_zh": "燕"
        },
        {
            "location": "93/TALK",
            "narrator": "つばめ",
            "text": "本当に嬉しぃ(●´ω｀●)",
            "zh": "真的好开心(●´ω｀●)",
            "narrator_zh": "燕"
        },
        {
            "location": "104/ACT",
            "narrator": "",
            "text": "変わってるね",
            "zh": "你还真特别呢",
            "narrator_zh": ""
        },
        {
            "location": "105/TALK",
            "narrator": "つばめ",
            "text": "そぅかな？(´・ω・`) ",
            "zh": "是吗？(´·ω·`)",
            "narrator_zh": "燕"
        },
        {
            "location": "106/TALK",
            "narrator": "つばめ",
            "text": "わたしは逆だよ",
            "zh": "我正相反呀",
            "narrator_zh": "燕"
        },
        {
            "location": "107/TALK",
            "narrator": "つばめ",
            "text": "みんなの反応がわからなぃもん(o´Д`)=з",
            "zh": "完全搞不懂大家的反应嘛(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "118/ACT",
            "narrator": "",
            "text": "みんなに合わせた方がいいかも",
            "zh": "还是配合大家比较好",
            "narrator_zh": ""
        },
        {
            "location": "119/TALK",
            "narrator": "つばめ",
            "text": "ぇ？Σ(ﾟдﾟlll)",
            "zh": "诶？Σ(ﾟдﾟlll)",
            "narrator_zh": "燕"
        },
        {
            "location": "121/TALK",
            "narrator": "つばめ",
            "text": "なんで？(´･ω･｀) ",
            "zh": "为什么？(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "122/TALK",
            "narrator": "つばめ",
            "text": "ウソつぃても仕方なぃと思ぅよ？(´・ω・｀)",
            "zh": "就算撒谎也没用吧？(´・ω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "134/TALK",
            "narrator": "アーヤ",
            "text": "まあ、とにかく――",
            "zh": "嘛，总之——",
            "narrator_zh": "绫水"
        },
        {
            "location": "135/TALK",
            "narrator": "アーヤ",
            "text": "私も混乱してるけど、\n出来る限り冷静になって、\n考えてみましょう。",
            "zh": "我也很混乱，\n但还是尽量冷静下来，\n好好想想吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "…そうやね。\nここで慌てて考えても、\n何も浮かばんやろうし…。",
            "zh": "……是啊。\n这时候急着去想，\n也想不出什么来咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、考えても\nどうにかなる問題じゃ\nない気がするけど？",
            "zh": "话说，我觉得就算\n想了也不是\n能解决的问题？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "141/TALK",
            "narrator": "アーヤ",
            "text": "かもしれないけど…。",
            "zh": "也许是吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "144/TALK",
            "narrator": "アーヤ",
            "text": "まあ、何か思うことが\nあったら、一人で悩んだり\nせずに――",
            "zh": "嘛，要是想到\n什么事，别一个人\n干烦恼——",
            "narrator_zh": "绫水"
        },
        {
            "location": "145/TALK",
            "narrator": "アーヤ",
            "text": "みんなで相談するように\nしましょう。",
            "zh": "大家一起来\n商量吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "146/TALK",
            "narrator": "みやび",
            "text": "そうやね。\nこの件は全員に関わりある\nことやし。",
            "zh": "是啊。\n这件事跟所有人\n都有关系咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "149/TALK",
            "narrator": "つばめ",
            "text": "…みんな、ちょっと\n大げさな気がするなぁ。",
            "zh": "……大家是不是\n有点太夸张了呀。",
            "narrator_zh": "燕"
        }
    ]
}
