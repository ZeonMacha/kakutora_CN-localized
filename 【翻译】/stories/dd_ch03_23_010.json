{
    "dir": "chap23/daydra/dd_ch03_23_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "23352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "神楽の優しさ",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "神乐的温柔"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "神楽の優しさ",
            "zh": "神乐的温柔",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "真幌",
            "text": "よーし、今日の訓練は\nこれで終わりだ。",
            "zh": "好—，今天的训练\n到此结束。",
            "narrator_zh": "真幌"
        },
        {
            "location": "24/TALK",
            "narrator": "真幌",
            "text": "午後はゆっくり休んで、\n明日に備えるんだ。\n解散！",
            "zh": "下午好好休息，\n为明天做准备。\n解散！",
            "narrator_zh": "真幌"
        },
        {
            "location": "25/TALK",
            "narrator": "つばめ",
            "text": "はぁ…へとへとだよぉ…。",
            "zh": "哈啊……累趴下了啦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "26/TALK",
            "narrator": "神楽",
            "text": "そ、そう、ですね…。\n今日はなんだか、\nとってもハードでした…。",
            "zh": "说、说得也是……。\n今天总觉得，\n强度好大呀……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "27/TALK",
            "narrator": "アーヤ",
            "text": "暑さのせいよ。\n多分いつも以上に\n体力持ってかれてるわ。",
            "zh": "是因为太热了。\n多半比平时更消耗\n体力吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ、はぁ…。",
            "zh": "哈啊、哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん、大丈夫？",
            "zh": "加布，没事吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "う、ん…。\n喉、カラカラで…。",
            "zh": "嗯、嗯……。\n嗓子、干得冒烟……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "アーヤ",
            "text": "早く帰って冷たい物\n飲みましょ。",
            "zh": "快点回去喝点\n冰镇的东西吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "賛成…ってか、あれ？\nみやびはどこ？",
            "zh": "赞成……话说，咦？\n雅去哪儿了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "真幌",
            "text": "あいつならさっさと\n戻ってったぞ。",
            "zh": "那家伙早就麻溜地\n回去了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "41/TALK",
            "narrator": "真幌",
            "text": "冷たい麦茶が待ってる、\nとか言ってな。",
            "zh": "说什么冰镇麦茶在等着她，\n然后就跑了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "44/TALK",
            "narrator": "つばめ",
            "text": "麦茶…。\n神楽ちゃん、行こ。",
            "zh": "麦茶……。\n神乐，我们走吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "46/TALK",
            "narrator": "神楽",
            "text": "はい。\nガブちゃんも、\n歩けますか？",
            "zh": "好的。\n加布，\n还走得动吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "平気よ、大げさね…。",
            "zh": "没事啦，太夸张了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "何か、今日は本当に\n疲れたわ…。",
            "zh": "总觉得，今天真是\n累坏了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "シャワー浴びたし、\n食事も済んだのに、\nまだちょっと息苦しい…。",
            "zh": "明明冲了澡，\n饭也吃过了，\n还是有点喘不过气……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "それに…ちょっと\n頭も痛いし…。",
            "zh": "而且……头也\n有点痛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "…夕飯の時間まで、\nちょっと寝よう。",
            "zh": "……到晚饭时间前，\n稍微睡一会儿吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "…布団出さないと――",
            "zh": "……得把被褥铺出来——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あれ…なんか…、\nめまいが…。",
            "zh": "咦、奇怪……总觉得……\n有点头晕……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "うっ…あ、あれ？",
            "zh": "唔……咦、奇怪？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし…何して…。",
            "zh": "我……这是在干嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし…寝てたの？\nでも、いつの間に…。",
            "zh": "我……睡着了吗？\n可是，什么时候……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/TALK",
            "narrator": "神楽",
            "text": "ガブちゃん！？",
            "zh": "加布！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "95/TALK",
            "narrator": "神楽",
            "text": "ダメですよ！\nまだ休んでないと！",
            "zh": "不行哦！\n还得再多休息才行！",
            "narrator_zh": "神乐"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽…えっ？\nあたし…どうしたの？",
            "zh": "神乐……咦？\n我……怎么了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "神楽",
            "text": "覚えてないんですか？",
            "zh": "你不记得了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "99/TALK",
            "narrator": "神楽",
            "text": "ガブちゃん、\nここで倒れてたんですよ。",
            "zh": "加布，\n你刚才晕倒在这里了哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "倒れてた…あたしが！？",
            "zh": "晕倒了……我吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "神楽",
            "text": "はい…多分、熱中症だと\n思いますよ。",
            "zh": "是的……多半是\n中暑了吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "103/TALK",
            "narrator": "神楽",
            "text": "どうですか？\n気持ち悪かったり\nしませんか？",
            "zh": "感觉怎么样？\n有没有觉得\n恶心难受？",
            "narrator_zh": "神乐"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "え、ええ…ちょっとだけ\n頭が痛いけど…。",
            "zh": "嗯、嗯……只是有\n一点点头痛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "神楽",
            "text": "やっぱり…顔色もあまり\nよくありませんから、\nもう少し休んでください。",
            "zh": "果然……脸色也不太\n好，请再多\n休息一会儿吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "107/TALK",
            "narrator": "神楽",
            "text": "私、氷枕と冷たい飲み物を\n持ってきますから。",
            "zh": "我去拿冰枕和\n冷饮过来。",
            "narrator_zh": "神乐"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "い、いいわよ。\nそんな大げさな――",
            "zh": "不、不用了啦。\n这么小题大做——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "神楽",
            "text": "ガブちゃん！",
            "zh": "加布！",
            "narrator_zh": "神乐"
        },
        {
            "location": "111/TALK",
            "narrator": "神楽",
            "text": "倒れてた人にそんなこと\n言う権利はありません！",
            "zh": "晕倒的人可没有\n说这种话的权利！",
            "narrator_zh": "神乐"
        },
        {
            "location": "112/TALK",
            "narrator": "神楽",
            "text": "私が戻るまで、\n大人しくしていて\nくださいね…約束ですよ！",
            "zh": "在我回来之前，\n请乖乖躺好\n哦……说定了哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "は、はい…。",
            "zh": "好、好的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "情けない…。\nまさか、熱中症って…。",
            "zh": "真丢脸……。\n居然会中暑什么的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/SEL",
            "narrator": "",
            "text": "具合は平気？",
            "zh": "身体不要紧吗？",
            "narrator_zh": ""
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "気を付けてたつもり\nなんだけど…。",
            "zh": "我明明自认已经\n挺小心了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、訓練中じゃなくて\n本当助かったわ。",
            "zh": "不过，幸好不是在\n训练的时候。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめには、あんまり\nかっこ悪い姿見られたく\nないし…。",
            "zh": "也不太想让燕看到\n我这么狼狈的样子\n就是了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "…っていうか、神楽しか\n倒れてるの見てないの\nかしら？",
            "zh": "……话说，只有神乐\n看到我晕倒\n了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "ガブリエラ",
            "text": "具合よくなってからで\nいいか…。",
            "zh": "等好一点再说\n吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "134/ACT",
            "narrator": "",
            "text": "具合は平気？",
            "zh": "身体不要紧吗？",
            "narrator_zh": ""
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "なんとか",
            "zh": "勉强还行",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "155/TALK",
            "narrator": "ガブリエラ",
            "text": "ごめん",
            "zh": "抱歉",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "156/TALK",
            "narrator": "ガブリエラ",
            "text": "小さいもじ",
            "zh": "看小字",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "157/TALK",
            "narrator": "ガブリエラ",
            "text": "ツラいから",
            "zh": "有点难受",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "あとで",
            "zh": "回头再聊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "159/TALK",
            "narrator": "ガブリエラ",
            "text": "よくなったらね",
            "zh": "等好点再说吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "172/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "176/TALK",
            "narrator": "神楽",
            "text": "ガブちゃん、冷たい麦茶と\n氷枕持って――",
            "zh": "加布，我把冰麦茶和\n冰枕拿过——",
            "narrator_zh": "神乐"
        },
        {
            "location": "177/TALK",
            "narrator": "神楽",
            "text": "って、スマホなんか\n弄ってちゃダメですよ！",
            "zh": "喂，怎么能\n玩手机呢！",
            "narrator_zh": "神乐"
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "大げさ過ぎ…、\nこれくらい平気よ。",
            "zh": "太夸张了……\n这点程度没事啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "180/TALK",
            "narrator": "神楽",
            "text": "ガブちゃん…、\n私、本当に怒りますよ？",
            "zh": "加布……\n我真的要生气了哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "181/TALK",
            "narrator": "ガブリエラ",
            "text": "うっ…。",
            "zh": "唔……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "182/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "183/TALK",
            "narrator": "ガブリエラ",
            "text": "わ、わかったわよ…。\n倒れたのは事実だし、\n従うわ。",
            "zh": "知、知道了啦……。\n晕倒确实是事实，\n我听你的就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "186/TALK",
            "narrator": "神楽",
            "text": "そうです。\n今日一日は素直な良い子で\nいてくださいね。",
            "zh": "这就对了。\n今天一整天都要做个\n听话的好孩子哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "189/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし…どれくらい\n倒れてたの？",
            "zh": "我……晕倒了\n多久？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "神楽",
            "text": "私が見つけたのが、\n大体三十分くらい前です。",
            "zh": "我发现你的时候，\n大概是三十分钟前。",
            "narrator_zh": "神乐"
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "…その間、ずっと看病して\nくれてたの？",
            "zh": "……那段时间，你一直\n在照顾我吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/TALK",
            "narrator": "神楽",
            "text": "それこそ大袈裟ですよ。\n冷たいタオルを当てたり\nしてただけです。",
            "zh": "那才叫太夸张了哦。\n我只是帮你敷了敷\n冷毛巾而已。",
            "narrator_zh": "神乐"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/TALK",
            "narrator": "神楽",
            "text": "やっぱり、\nまだ具合悪いですか？",
            "zh": "果然，\n还是很不舒服吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "198/TALK",
            "narrator": "ガブリエラ",
            "text": "…ううん。",
            "zh": "……不是。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "199/TALK",
            "narrator": "ガブリエラ",
            "text": "め、面倒かけたわ…。",
            "zh": "给、给你添麻烦了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "200/TALK",
            "narrator": "神楽",
            "text": "もう…友達なんだから、\n面倒なんて言わないで\nください。",
            "zh": "真是的……大家是朋友，\n请别说什么\n添麻烦啦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "201/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "202/TALK",
            "narrator": "神楽",
            "text": "氷枕、置いときますね。",
            "zh": "冰枕我放在这里了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "203/TALK",
            "narrator": "神楽",
            "text": "麦茶飲んだら、\nもう少し横になって\n休んでください。",
            "zh": "喝完麦茶后，\n请再躺着\n休息一会儿。",
            "narrator_zh": "神乐"
        },
        {
            "location": "204/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "神楽",
            "text": "じゃあ、私はこれで…。",
            "zh": "那我先走了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "207/TALK",
            "narrator": "ガブリエラ",
            "text": "か、神楽！",
            "zh": "神、神乐！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "神楽",
            "text": "はい？",
            "zh": "嗯？",
            "narrator_zh": "神乐"
        },
        {
            "location": "210/TALK",
            "narrator": "ガブリエラ",
            "text": "…世話になったわ。",
            "zh": "……多亏你照顾了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "211/TALK",
            "narrator": "神楽",
            "text": "もう、だからそんなこと\n言わないで――",
            "zh": "真是的，不是说了\n不用这么客气——",
            "narrator_zh": "神乐"
        },
        {
            "location": "215/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと…。",
            "zh": "谢谢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "217/TALK",
            "narrator": "神楽",
            "text": "はい…。",
            "zh": "不客气……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "221/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…なんか、\n余計に顔が熱くなった\n気がするわ…。",
            "zh": "哈啊……总觉得，\n脸反而变得更烫\n了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "…友達なんだから\n気にするな、かぁ…。",
            "zh": "……因为是朋友所以\n别放在心上，吗……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/TALK",
            "narrator": "ガブリエラ",
            "text": "本当、よくもあんな\n恥ずかしいセリフを\n平然と言えるもんだわ。",
            "zh": "真是的，亏她能面不改色地\n说出那种让人害臊的\n台词啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "…悪い気はしないけど。",
            "zh": "……虽然感觉倒也不坏。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "色々と用意して\nもらったんだし、\nお昼寝しよ…。",
            "zh": "既然人家都帮忙准备了\n这么多东西，\n就睡个午觉吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "22/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月25日　 0:10 PM</color>\n合宿中、みやびの実家近くの砂浜でのこと",
            "zh": "<color=green>8月25日　 0:10 PM</color>\n合宿期间，在雅的老家附近的沙滩上",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "239/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch03",
            "text": "【ナイチンゲール誓詞】",
            "zh": "【南丁格尔誓词】",
            "narrator_zh": "Dialog_GEThimegoto_ch03"
        }
    ]
}
