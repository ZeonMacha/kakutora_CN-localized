{
    "dir": "dramatics/daydra/drm_ch01_00_470.js",
    "type": "Episode",
    "info": {
        "story_id": "1047",
        "cid": "tsubame",
        "title": "らぶとーく 第47話",
        "sub_title": "秘密と策略",
        "title_zh": "恋爱漫谈 第47话",
        "sub_title_zh": "秘密与策略"
    },
    "entry": [
        {
            "location": "201/SCENARIO",
            "narrator": "",
            "text": "秘密と策略",
            "zh": "秘密与策略",
            "narrator_zh": ""
        },
        {
            "location": "215/TALK",
            "narrator": "アーヤ",
            "text": "は！？\nつばめ、あなた何を\n言い出すの！？",
            "zh": "哈！？\n燕，你在说什么\n胡话呢！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "217/TALK",
            "narrator": "つばめ",
            "text": "だから、卯月さんは\n何も悪くないんです！",
            "zh": "所以，卯月没有\n任何错！",
            "narrator_zh": "燕"
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "何バカなこと\n言ってんのよ！？",
            "zh": "你在说什么\n蠢话呢！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "219/TALK",
            "narrator": "ガブリエラ",
            "text": "あんた、あいつに\n殺されかけたの\n忘れたっていうの！？",
            "zh": "你难道忘了自己\n差点被那家伙杀掉\n了吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "220/TALK",
            "narrator": "つばめ",
            "text": "忘れてないよ。",
            "zh": "我没忘哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "221/TALK",
            "narrator": "つばめ",
            "text": "でも、あれにはきっと、\n何か理由があったんだと\n思うの。",
            "zh": "不过，那里面一定\n有什么理由，\n我是这么想的。",
            "narrator_zh": "燕"
        },
        {
            "location": "222/TALK",
            "narrator": "つばめ",
            "text": "じゃなきゃ、卯月さんが\nあんな酷いことするはず\nないし。",
            "zh": "不然的话，卯月\n怎么可能做出那么过分的\n事嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "223/TALK",
            "narrator": "アーヤ",
            "text": "理由のあるなしの\n問題じゃないでしょ！？",
            "zh": "这根本不是有没有\n理由的问题吧！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "224/TALK",
            "narrator": "アーヤ",
            "text": "どんな理由があろうと、\n誰かを殺していいわけじゃ\nないのよ？",
            "zh": "不管有什么理由，\n都不能杀\n别人吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "227/TALK",
            "narrator": "つばめ",
            "text": "で、でも、わたしは\nこうして生きてますし…。",
            "zh": "可、可是，我这不是\n这样活着吗……。",
            "narrator_zh": "燕"
        },
        {
            "location": "228/TALK",
            "narrator": "みやび",
            "text": "いい加減にしぃ。",
            "zh": "够了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "229/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんが\n優しい子いうんは、\nうちもよく知っちょるよ。",
            "zh": "燕是个温柔的孩子，\n这一点我也\n很清楚咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "230/TALK",
            "narrator": "みやび",
            "text": "けんど、殺されかけてまで\n庇おうとしゆうんは――",
            "zh": "不过，都差点被杀了\n还要去护着她，这——",
            "narrator_zh": "雅"
        },
        {
            "location": "231/TALK",
            "narrator": "みやび",
            "text": "さすがに異常や。\nわけがわからんちや。",
            "zh": "确实异常咯。\n完全搞不懂咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "233/TALK",
            "narrator": "つばめ",
            "text": "そんな…。",
            "zh": "怎么会……。",
            "narrator_zh": "燕"
        },
        {
            "location": "235/TALK",
            "narrator": "アーヤ",
            "text": "まあ、あれだけのことを\nされたんだから――",
            "zh": "嘛，毕竟被做了\n那种事——",
            "narrator_zh": "绫水"
        },
        {
            "location": "236/TALK",
            "narrator": "アーヤ",
            "text": "ショックで正常な判断が\n出来なくなってるんじゃ\nないかしら？",
            "zh": "大概是受打击太大，\n没法做出正常判断\n了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "そうじゃなきゃ困るわ。\n仲間の誰かが本当に\n殺されたとしても――",
            "zh": "不这样的话就麻烦了。\n就算同伴里真的\n有人被杀——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "239/TALK",
            "narrator": "ガブリエラ",
            "text": "理由があるに違いない、\nとか言って許しそうだし。",
            "zh": "肯定还会说着什么“一定有理由”，\n然后就原谅她了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "255/TALK",
            "narrator": "つばめ",
            "text": "どぅしよぅ",
            "zh": "怎么办哦",
            "narrator_zh": "燕"
        },
        {
            "location": "256/TALK",
            "narrator": "つばめ",
            "text": "卯月さんが悪者だと思われちゃってる",
            "zh": "大家都把卯月当成坏人了",
            "narrator_zh": "燕"
        },
        {
            "location": "257/TALK",
            "narrator": "つばめ",
            "text": "絶対誤解だって思ぅのに(´・ω・｀)",
            "zh": "我明明觉得绝对是误会(´・ω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "258/TALK",
            "narrator": "つばめ",
            "text": "みんなそぅは思わなぃのかな？(´つω・｀)ｼｭﾝ",
            "zh": "大家难道都不这么觉得吗？(´つω・｀)呜",
            "narrator_zh": "燕"
        },
        {
            "location": "260/SEL",
            "narrator": "",
            "text": "今庇うのは逆効果",
            "zh": "现在护着反而适得其反",
            "narrator_zh": ""
        },
        {
            "location": "261/SEL",
            "narrator": "",
            "text": "推理の材料が少なすぎる",
            "zh": "推理的材料太少了",
            "narrator_zh": ""
        },
        {
            "location": "262/SEL",
            "narrator": "",
            "text": "冗談ってことにすれば",
            "zh": "就当是开个玩笑",
            "narrator_zh": ""
        },
        {
            "location": "263/ACT",
            "narrator": "",
            "text": "今庇うのは逆効果",
            "zh": "现在护着反而适得其反",
            "narrator_zh": ""
        },
        {
            "location": "264/TALK",
            "narrator": "つばめ",
            "text": "そぅかも",
            "zh": "也许吧",
            "narrator_zh": "燕"
        },
        {
            "location": "265/TALK",
            "narrator": "つばめ",
            "text": "みんな今は何言っても聞ぃてくれそぅになぃし(o´Д`)=з",
            "zh": "大家现在不管我说什么好像都听不进去(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "266/TALK",
            "narrator": "つばめ",
            "text": "嫌だけど",
            "zh": "虽然不太情愿",
            "narrator_zh": "燕"
        },
        {
            "location": "267/TALK",
            "narrator": "つばめ",
            "text": "今は大人しくしてるよ(´つω・｀)ｼｭﾝ",
            "zh": "我现在还是先老实点吧(´つω・｀)呜",
            "narrator_zh": "燕"
        },
        {
            "location": "278/TALK",
            "narrator": "アーヤ",
            "text": "まあ、卯月に何かしら\n理由があるのかどうかは\nわからないけど――",
            "zh": "嘛，卯月到底有\n没有什么理由，\n我是不清楚——",
            "narrator_zh": "绫水"
        },
        {
            "location": "279/TALK",
            "narrator": "アーヤ",
            "text": "ハッキリしてるのは、\n私達を裏切ったという\nことと――",
            "zh": "不过摆在眼前的事实，\n就是她背叛了\n我们——",
            "narrator_zh": "绫水"
        },
        {
            "location": "280/TALK",
            "narrator": "アーヤ",
            "text": "つばめを殺そうとした、\nってこと。",
            "zh": "就是说\n想杀燕。",
            "narrator_zh": "绫水"
        },
        {
            "location": "281/TALK",
            "narrator": "アーヤ",
            "text": "卯月に対して警戒する\n理由としては、十分だと\n思うわ。",
            "zh": "作为警戒卯月\n的理由，我觉得\n已经足够了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "283/TALK",
            "narrator": "ガブリエラ",
            "text": "十分過ぎるわ。\n仲間だと思ってたのに、\nあいつ――",
            "zh": "简直绰绰有余。\n明明还把她当成同伴，\n那家伙居然——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "284/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対許さないんだから！",
            "zh": "我绝对不会原谅她的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "287/TALK",
            "narrator": "みやび",
            "text": "うちも、今回はまっこと\n腹が立ってるちや。",
            "zh": "我这次也蛮\n生气的滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "288/TALK",
            "narrator": "みやび",
            "text": "何かしら理由があったと\nしても、簡単に許すわけ\nにはいかんな。",
            "zh": "就算有驷马苦衷，\n也没法这么轻易\n就原谅咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "289/TALK",
            "narrator": "ガブリエラ",
            "text": "今後は卯月のことは\n敵として扱う、って\nことで――",
            "zh": "今后就把卯月\n当成敌人对待，\n就这么决定——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "290/TALK",
            "narrator": "ガブリエラ",
            "text": "それでいいわね？",
            "zh": "这样可以吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "292/TALK",
            "narrator": "つばめ",
            "text": "そ、そんな！",
            "zh": "怎、怎么会！",
            "narrator_zh": "燕"
        },
        {
            "location": "294/TALK",
            "narrator": "ガブリエラ",
            "text": "いい加減にしてよ！\nあんた殺されかけた\nのよ！？",
            "zh": "你适可而止吧！\n差点被杀的可是\n你啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "295/TALK",
            "narrator": "ガブリエラ",
            "text": "裏切って、仲間のことを\n殺そうとしたような奴の\nことを――",
            "zh": "背叛大家、甚至想\n杀掉同伴的那种家伙，\n你还——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "296/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたは許せるの？\nあたし達が殺され\nかけたとしても――",
            "zh": "你居然能原谅她吗？\n哪怕换成是我们\n差点被她杀了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "297/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたは怒りもせずに、\n理由があったに違いない、\nとか言うわけ！？",
            "zh": "难道你也能半点不生气，\n张口就说“她肯定有什么\n理由”吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "299/TALK",
            "narrator": "つばめ",
            "text": "そ、そんなこと…。",
            "zh": "那、那种事……。",
            "narrator_zh": "燕"
        },
        {
            "location": "301/TALK",
            "narrator": "ガブリエラ",
            "text": "だったらもう黙って！\nつばめが許せばそれで\nおしまいなんて――",
            "zh": "那就闭嘴！\n只要燕原谅，就这么\n算完了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "302/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな簡単な話じゃ\nないんだから！",
            "zh": "不是那么简单的\n事啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "304/TALK",
            "narrator": "アーヤ",
            "text": "…私も、ギャヴィの\n意見に賛成よ。",
            "zh": "……我也赞成\n加维的意见。",
            "narrator_zh": "绫水"
        },
        {
            "location": "305/TALK",
            "narrator": "アーヤ",
            "text": "どんな理由であれ、\n仲間に手を掛けた\n相手のことを――",
            "zh": "不管有什么理由，\n对同伴动手的\n对手——",
            "narrator_zh": "绫水"
        },
        {
            "location": "306/TALK",
            "narrator": "アーヤ",
            "text": "簡単に許したりする\nことはできないわ。",
            "zh": "是没法轻易\n原谅的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "308/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "310/TALK",
            "narrator": "みやび",
            "text": "…つばめちゃんも、\nちっくとでえいき――",
            "zh": "……燕你也，\n哪怕就一点也好——",
            "narrator_zh": "雅"
        },
        {
            "location": "311/TALK",
            "narrator": "みやび",
            "text": "卯月が目の前に現れたら、\n警戒せんといかんよ？",
            "zh": "要是卯月出现在眼前，\n可不能不防备啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "312/TALK",
            "narrator": "つばめ",
            "text": "…わかり、ました。",
            "zh": "……我明、明白了。",
            "narrator_zh": "燕"
        },
        {
            "location": "313/TALK",
            "narrator": "つばめ",
            "text": "…絶対、何か理由が\nあるはずなのに…。",
            "zh": "……明明一定\n有什么理由的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "314/ACT",
            "narrator": "",
            "text": "推理の材料が少なすぎる",
            "zh": "推理的材料太少了",
            "narrator_zh": ""
        },
        {
            "location": "315/TALK",
            "narrator": "つばめ",
            "text": "そぅだよね",
            "zh": "是这样吧",
            "narrator_zh": "燕"
        },
        {
            "location": "316/TALK",
            "narrator": "つばめ",
            "text": "卯月さんが本当に裏切ったのかどうか",
            "zh": "卯月到底是不是真的背叛了",
            "narrator_zh": "燕"
        },
        {
            "location": "317/TALK",
            "narrator": "つばめ",
            "text": "その確証はなぃよね！(´∀｀*)",
            "zh": "没有那个确证吧！(´∀｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "329/TALK",
            "narrator": "つばめ",
            "text": "あ、あの！",
            "zh": "那、那个！",
            "narrator_zh": "燕"
        },
        {
            "location": "330/TALK",
            "narrator": "つばめ",
            "text": "本当に裏切ったと\n決めつけるのには、\nまだ早いです！",
            "zh": "现在就断定她\n真的背叛了我们，\n还太早了！",
            "narrator_zh": "燕"
        },
        {
            "location": "332/TALK",
            "narrator": "みやび",
            "text": "どこがや？",
            "zh": "哪里？",
            "narrator_zh": "雅"
        },
        {
            "location": "333/TALK",
            "narrator": "つばめ",
            "text": "だって、まだその証拠が\nないじゃないですか！",
            "zh": "因为，还没有那个证据\n不是吗！",
            "narrator_zh": "燕"
        },
        {
            "location": "334/TALK",
            "narrator": "つばめ",
            "text": "なのに、そんな敵になった\nみたいな言い方で話を\nするのは…。",
            "zh": "可是，用那种像变成\n敌人似的说法\n讲话……。",
            "narrator_zh": "燕"
        },
        {
            "location": "335/TALK",
            "narrator": "ガブリエラ",
            "text": "いい加減にしてよ、\nバカ！！",
            "zh": "你适可而止吧，\n笨蛋！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "336/TALK",
            "narrator": "ガブリエラ",
            "text": "あんた、\n殺されかけたのよ！？",
            "zh": "差点被杀的，\n可是你啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "337/TALK",
            "narrator": "ガブリエラ",
            "text": "どんな理由があっても、\n殺そうとした時点で\n敵じゃない！",
            "zh": "不管有什么理由，\n想杀人的那一刻起\n就是敌人！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "338/TALK",
            "narrator": "つばめ",
            "text": "そ、それは…。",
            "zh": "那、那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "340/ACT",
            "narrator": "",
            "text": "冗談ってことにすれば",
            "zh": "就当是开个玩笑",
            "narrator_zh": ""
        },
        {
            "location": "341/TALK",
            "narrator": "つばめ",
            "text": "さすがにそれはなぃよ(ﾟ△ﾟ;ﾉ)ﾉ",
            "zh": "那确实不至于吧(ﾟ△ﾟ;)",
            "narrator_zh": "燕"
        },
        {
            "location": "342/TALK",
            "narrator": "つばめ",
            "text": "っていうか",
            "zh": "话说",
            "narrator_zh": "燕"
        },
        {
            "location": "343/TALK",
            "narrator": "つばめ",
            "text": "シャレにならなぃよそれ(o´Д`)=з",
            "zh": "这玩笑一点都不好笑啦(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "355/TALK",
            "narrator": "つばめ",
            "text": "…で、でも！",
            "zh": "…可、可是！",
            "narrator_zh": "燕"
        },
        {
            "location": "356/TALK",
            "narrator": "つばめ",
            "text": "卯月さんは、本当に、\n凄く悩んでいたんです！",
            "zh": "卯月她、真的、\n非常苦恼来着！",
            "narrator_zh": "燕"
        },
        {
            "location": "357/TALK",
            "narrator": "つばめ",
            "text": "だから、絶対に何か\n理由があったんだと――",
            "zh": "所以，一定有什么\n理由——",
            "narrator_zh": "燕"
        },
        {
            "location": "359/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんが\n卯月を庇う気持ちは\nわかるけんど――",
            "zh": "燕想护着卯月\n的心情我明白，\n不过嘛——",
            "narrator_zh": "雅"
        },
        {
            "location": "360/TALK",
            "narrator": "みやび",
            "text": "事実を変えることは\nできんちや。",
            "zh": "但事实是没法\n改变滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "361/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ。",
            "zh": "是呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "362/TALK",
            "narrator": "ガブリエラ",
            "text": "あいつはつばめのことを\n殺そうとした。",
            "zh": "那家伙想要\n杀掉燕。",
            "narrator_zh": "加布里埃拉"
        },
        {
