{
 "dir": "dramatics/daydra/drm_ch01_00_470.js",
 "type": "Episode",
 "info": {
  "story_id": "1047",
  "cid": "tsubame",
  "title": "らぶとーく 第47話",
  "sub_title": "秘密と策略"
 },
 "entry": [
  {
   "location": "201/SCENARIO",
   "narrator": "",
   "text": "秘密と策略"
  },
  {
   "location": "215/TALK",
   "narrator": "アーヤ",
   "text": "は！？\nつばめ、あなた何を\n言い出すの！？"
  },
  {
   "location": "217/TALK",
   "narrator": "つばめ",
   "text": "だから、卯月さんは\n何も悪くないんです！",
   "zh": "所以，卯月没有\n任何错！",
   "narrator_zh": "燕"
  },
  {
   "location": "218/TALK",
   "narrator": "ガブリエラ",
   "text": "何バカなこと\n言ってんのよ！？"
  },
  {
   "location": "219/TALK",
   "narrator": "ガブリエラ",
   "text": "あんた、あいつに\n殺されかけたの\n忘れたっていうの！？"
  },
  {
   "location": "220/TALK",
   "narrator": "つばめ",
   "text": "忘れてないよ。"
  },
  {
   "location": "221/TALK",
   "narrator": "つばめ",
   "text": "でも、あれにはきっと、\n何か理由があったんだと\n思うの。",
   "zh": "不过，那里面一定\n有什么理由，\n我是这么想的。",
   "narrator_zh": "燕"
  },
  {
   "location": "222/TALK",
   "narrator": "つばめ",
   "text": "じゃなきゃ、卯月さんが\nあんな酷いことするはず\nないし。"
  },
  {
   "location": "223/TALK",
   "narrator": "アーヤ",
   "text": "理由のあるなしの\n問題じゃないでしょ！？"
  },
  {
   "location": "224/TALK",
   "narrator": "アーヤ",
   "text": "どんな理由があろうと、\n誰かを殺していいわけじゃ\nないのよ？",
   "zh": "不管有什么理由，\n都不能杀\n别人吧？",
   "narrator_zh": "绫水"
  },
  {
   "location": "227/TALK",
   "narrator": "つばめ",
   "text": "で、でも、わたしは\nこうして生きてますし…。",
   "zh": "可、可是，我这不是\n这样活着吗……。",
   "narrator_zh": "燕"
  },
  {
   "location": "228/TALK",
   "narrator": "みやび",
   "text": "いい加減にしぃ。"
  },
  {
   "location": "229/TALK",
   "narrator": "みやび",
   "text": "つばめちゃんが\n優しい子いうんは、\nうちもよく知っちょるよ。",
   "zh": "燕是个温柔的孩子，\n这一点我也\n很清楚咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "230/TALK",
   "narrator": "みやび",
   "text": "けんど、殺されかけてまで\n庇おうとしゆうんは――",
   "zh": "不过，都差点被杀了\n还要去护着她，这——",
   "narrator_zh": "雅"
  },
  {
   "location": "231/TALK",
   "narrator": "みやび",
   "text": "さすがに異常や。\nわけがわからんちや。",
   "zh": "确实异常咯。\n完全搞不懂咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "233/TALK",
   "narrator": "つばめ",
   "text": "そんな…。",
   "zh": "怎么会……。",
   "narrator_zh": "燕"
  },
  {
   "location": "235/TALK",
   "narrator": "アーヤ",
   "text": "まあ、あれだけのことを\nされたんだから――"
  },
  {
   "location": "236/TALK",
   "narrator": "アーヤ",
   "text": "ショックで正常な判断が\n出来なくなってるんじゃ\nないかしら？"
  },
  {
   "location": "237/TALK",
   "narrator": "ガブリエラ",
   "text": "そうじゃなきゃ困るわ。\n仲間の誰かが本当に\n殺されたとしても――",
   "zh": "不这样的话就麻烦了。\n就算同伴里真的\n有人被杀——",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "239/TALK",
   "narrator": "ガブリエラ",
   "text": "理由があるに違いない、\nとか言って許しそうだし。"
  },
  {
   "location": "241/TALK",
   "narrator": "つばめ",
   "text": "…………。"
  },
  {
   "location": "255/TALK",
   "narrator": "つばめ",
   "text": "どぅしよぅ",
   "zh": "怎么办哦",
   "narrator_zh": "燕"
  },
  {
   "location": "256/TALK",
   "narrator": "つばめ",
   "text": "卯月さんが悪者だと思われちゃってる"
  },
  {
   "location": "257/TALK",
   "narrator": "つばめ",
   "text": "絶対誤解だって思ぅのに(´・ω・｀)"
  },
  {
   "location": "258/TALK",
   "narrator": "つばめ",
   "text": "みんなそぅは思わなぃのかな？(´つω・｀)ｼｭﾝ"
  },
  {
   "location": "260/SEL",
   "narrator": "",
   "text": "今庇うのは逆効果",
   "zh": "现在护着反而适得其反",
   "narrator_zh": ""
  },
  {
   "location": "261/SEL",
   "narrator": "",
   "text": "推理の材料が少なすぎる",
   "zh": "推理的材料太少了",
   "narrator_zh": ""
  },
  {
   "location": "262/SEL",
   "narrator": "",
   "text": "冗談ってことにすれば",
   "zh": "就当是开个玩笑",
   "narrator_zh": ""
  },
  {
   "location": "263/ACT",
   "narrator": "",
   "text": "今庇うのは逆効果",
   "zh": "现在护着反而适得其反",
   "narrator_zh": ""
  },
  {
   "location": "264/TALK",
   "narrator": "つばめ",
   "text": "そぅかも",
   "zh": "也许吧",
   "narrator_zh": "燕"
  },
  {
   "location": "265/TALK",
   "narrator": "つばめ",
   "text": "みんな今は何言っても聞ぃてくれそぅになぃし(o´Д`)=з"
  },
  {
   "location": "266/TALK",
   "narrator": "つばめ",
   "text": "嫌だけど"
  },
  {
   "location": "267/TALK",
   "narrator": "つばめ",
   "text": "今は大人しくしてるよ(´つω・｀)ｼｭﾝ"
  },
  {
   "location": "278/TALK",
   "narrator": "アーヤ",
   "text": "まあ、卯月に何かしら\n理由があるのかどうかは\nわからないけど――"
  },
  {
   "location": "279/TALK",
   "narrator": "アーヤ",
   "text": "ハッキリしてるのは、\n私達を裏切ったという\nことと――"
  },
  {
   "location": "280/TALK",
   "narrator": "アーヤ",
   "text": "つばめを殺そうとした、\nってこと。",
   "zh": "就是说\n想杀燕。",
   "narrator_zh": "绫水"
  },
  {
   "location": "281/TALK",
   "narrator": "アーヤ",
   "text": "卯月に対して警戒する\n理由としては、十分だと\n思うわ。"
  },
  {
   "location": "283/TALK",
   "narrator": "ガブリエラ",
   "text": "十分過ぎるわ。\n仲間だと思ってたのに、\nあいつ――"
  },
  {
   "location": "284/TALK",
   "narrator": "ガブリエラ",
   "text": "絶対許さないんだから！"
  },
  {
   "location": "287/TALK",
   "narrator": "みやび",
   "text": "うちも、今回はまっこと\n腹が立ってるちや。"
  },
  {
   "location": "288/TALK",
   "narrator": "みやび",
   "text": "何かしら理由があったと\nしても、簡単に許すわけ\nにはいかんな。"
  },
  {
   "location": "289/TALK",
   "narrator": "ガブリエラ",
   "text": "今後は卯月のことは\n敵として扱う、って\nことで――"
  },
  {
   "location": "290/TALK",
   "narrator": "ガブリエラ",
   "text": "それでいいわね？",
   "zh": "这样可以吧？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "292/TALK",
   "narrator": "つばめ",
   "text": "そ、そんな！",
   "zh": "怎、怎么会！",
   "narrator_zh": "燕"
  },
  {
   "location": "294/TALK",
   "narrator": "ガブリエラ",
   "text": "いい加減にしてよ！\nあんた殺されかけた\nのよ！？"
  },
  {
   "location": "295/TALK",
   "narrator": "ガブリエラ",
   "text": "裏切って、仲間のことを\n殺そうとしたような奴の\nことを――"
  },
  {
   "location": "296/TALK",
   "narrator": "ガブリエラ",
   "text": "あんたは許せるの？\nあたし達が殺され\nかけたとしても――"
  },
  {
   "location": "297/TALK",
   "narrator": "ガブリエラ",
   "text": "あんたは怒りもせずに、\n理由があったに違いない、\nとか言うわけ！？"
  },
  {
   "location": "299/TALK",
   "narrator": "つばめ",
   "text": "そ、そんなこと…。",
   "zh": "那、那种事……。",
   "narrator_zh": "燕"
  },
  {
   "location": "301/TALK",
   "narrator": "ガブリエラ",
   "text": "だったらもう黙って！\nつばめが許せばそれで\nおしまいなんて――",
   "zh": "那就闭嘴！\n只要燕原谅，就这么\n算完了——",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "302/TALK",
   "narrator": "ガブリエラ",
   "text": "そんな簡単な話じゃ\nないんだから！",
   "zh": "不是那么简单的\n事啊！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "304/TALK",
   "narrator": "アーヤ",
   "text": "…私も、ギャヴィの\n意見に賛成よ。",
   "zh": "……我也赞成\n加维的意见。",
   "narrator_zh": "绫水"
  },
  {
   "location": "305/TALK",
   "narrator": "アーヤ",
   "text": "どんな理由であれ、\n仲間に手を掛けた\n相手のことを――",
   "zh": "不管有什么理由，\n对同伴动手的\n对手——",
   "narrator_zh": "绫水"
  },
  {
   "location": "306/TALK",
   "narrator": "アーヤ",
   "text": "簡単に許したりする\nことはできないわ。"
  },
  {
   "location": "308/TALK",
   "narrator": "つばめ",
   "text": "…………。"
  },
  {
   "location": "310/TALK",
   "narrator": "みやび",
   "text": "…つばめちゃんも、\nちっくとでえいき――"
  },
  {
   "location": "311/TALK",
   "narrator": "みやび",
   "text": "卯月が目の前に現れたら、\n警戒せんといかんよ？"
  },
  {
   "location": "312/TALK",
   "narrator": "つばめ",
   "text": "…わかり、ました。",
   "zh": "……我明、明白了。",
   "narrator_zh": "燕"
  },
  {
   "location": "313/TALK",
   "narrator": "つばめ",
   "text": "…絶対、何か理由が\nあるはずなのに…。",
   "zh": "……明明一定\n有什么理由的……。",
   "narrator_zh": "燕"
  },
  {
   "location": "314/ACT",
   "narrator": "",
   "text": "推理の材料が少なすぎる",
   "zh": "推理的材料太少了",
   "narrator_zh": ""
  },
  {
   "location": "315/TALK",
   "narrator": "つばめ",
   "text": "そぅだよね",
   "zh": "是这样吧",
   "narrator_zh": "燕"
  },
  {
   "location": "316/TALK",
   "narrator": "つばめ",
   "text": "卯月さんが本当に裏切ったのかどうか"
  },
  {
   "location": "317/TALK",
   "narrator": "つばめ",
   "text": "その確証はなぃよね！(´∀｀*)",
   "zh": "没有那个确证吧！(´∀｀*)",
   "narrator_zh": "燕"
  },
  {
   "location": "329/TALK",
   "narrator": "つばめ",
   "text": "あ、あの！",
   "zh": "那、那个！",
   "narrator_zh": "燕"
  },
  {
   "location": "330/TALK",
   "narrator": "つばめ",
   "text": "本当に裏切ったと\n決めつけるのには、\nまだ早いです！"
  },
  {
   "location": "332/TALK",
   "narrator": "みやび",
   "text": "どこがや？",
   "zh": "哪里？",
   "narrator_zh": "雅"
  },
  {
   "location": "333/TALK",
   "narrator": "つばめ",
   "text": "だって、まだその証拠が\nないじゃないですか！",
   "zh": "因为，还没有那个证据\n不是吗！",
   "narrator_zh": "燕"
  },
  {
   "location": "334/TALK",
   "narrator": "つばめ",
   "text": "なのに、そんな敵になった\nみたいな言い方で話を\nするのは…。",
   "zh": "可是，用那种像变成\n敌人似的说法\n讲话……。",
   "narrator_zh": "燕"
  },
  {
   "location": "335/TALK",
   "narrator": "ガブリエラ",
   "text": "いい加減にしてよ、\nバカ！！"
  },
  {
   "location": "336/TALK",
   "narrator": "ガブリエラ",
   "text": "あんた、\n殺されかけたのよ！？"
  },
  {
   "location": "337/TALK",
   "narrator": "ガブリエラ",
   "text": "どんな理由があっても、\n殺そうとした時点で\n敵じゃない！",
   "zh": "不管有什么理由，\n想杀人的那一刻起\n就是敌人！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "338/TALK",
   "narrator": "つばめ",
   "text": "そ、それは…。",
   "zh": "那、那个……。",
   "narrator_zh": "燕"
  },
  {
   "location": "340/ACT",
   "narrator": "",
   "text": "冗談ってことにすれば",
   "zh": "就当是开个玩笑",
   "narrator_zh": ""
  },
  {
   "location": "341/TALK",
   "narrator": "つばめ",
   "text": "さすがにそれはなぃよ(ﾟ△ﾟ;ﾉ)ﾉ",
   "zh": "那确实不至于吧(ﾟ△ﾟ;)",
   "narrator_zh": "燕"
  },
  {
   "location": "342/TALK",
   "narrator": "つばめ",
   "text": "っていうか",
   "zh": "话说",
   "narrator_zh": "燕"
  },
  {
   "location": "343/TALK",
   "narrator": "つばめ",
   "text": "シャレにならなぃよそれ(o´Д`)=з"
  },
  {
   "location": "355/TALK",
   "narrator": "つばめ",
   "text": "…で、でも！",
   "zh": "…可、可是！",
   "narrator_zh": "燕"
  },
  {
   "location": "356/TALK",
   "narrator": "つばめ",
   "text": "卯月さんは、本当に、\n凄く悩んでいたんです！"
  },
  {
   "location": "357/TALK",
   "narrator": "つばめ",
   "text": "だから、絶対に何か\n理由があったんだと――",
   "zh": "所以，一定有什么\n理由——",
   "narrator_zh": "燕"
  },
  {
   "location": "359/TALK",
   "narrator": "みやび",
   "text": "つばめちゃんが\n卯月を庇う気持ちは\nわかるけんど――",
   "zh": "燕想护着卯月\n的心情我明白，\n不过嘛——",
   "narrator_zh": "雅"
  },
  {
   "location": "360/TALK",
   "narrator": "みやび",
   "text": "事実を変えることは\nできんちや。"
  },
  {
   "location": "361/TALK",
   "narrator": "ガブリエラ",
   "text": "そうよ。",
   "zh": "是呀。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "362/TALK",
   "narrator": "ガブリエラ",
   "text": "あいつはつばめのことを\n殺そうとした。"
  },
  {
   "location": "363/TALK",
   "narrator": "ガブリエラ",
   "text": "その事実がある時点で、\n許すことはできないわ。",
   "zh": "有这个事实存在，\n就不能原谅。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "212/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>8月某日　 8:43 PM</color>\n合宿中、みやびの実家でのこと"
  }
 ]
}
