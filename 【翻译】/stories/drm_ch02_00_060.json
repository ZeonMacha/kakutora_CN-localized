{
    "dir": "dramatics/daydra/drm_ch02_00_060.js",
    "type": "Episode",
    "info": {
        "story_id": "2006",
        "cid": "ayami",
        "title": "らぶとーく 第06話",
        "sub_title": "マニュアルじゃなくて",
        "title_zh": "恋爱漫谈 第06话",
        "sub_title_zh": "不是手册"
    },
    "entry": [
        {
            "location": "356/SCENARIO",
            "narrator": "",
            "text": "マニュアルじゃなくて",
            "zh": "不是手册",
            "narrator_zh": ""
        },
        {
            "location": "369/TALK",
            "narrator": "真幌",
            "text": "アーヤの部屋は\n片付いてるな。",
            "zh": "绫水的房间\n收拾得挺整齐啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "371/TALK",
            "narrator": "アーヤ",
            "text": "……。\nそうでも\nないですよ。",
            "zh": "……。\n也没有\n那么整齐。",
            "narrator_zh": "绫水"
        },
        {
            "location": "372/TALK",
            "narrator": "真幌",
            "text": "私の部屋と\n交換して欲しいな。",
            "zh": "真想跟我的房间\n换一换啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "374/TALK",
            "narrator": "アーヤ",
            "text": "え！？",
            "zh": "欸！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "377/TALK",
            "narrator": "真幌",
            "text": "あはは。\n冗談、冗談。",
            "zh": "啊哈哈。\n开玩笑，开玩笑。",
            "narrator_zh": "真幌"
        },
        {
            "location": "380/TALK",
            "narrator": "真幌",
            "text": "それより何だ？\nわざわざ\n聞きたいことって。",
            "zh": "比起那个是什么？\n特地想\n问的事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "383/TALK",
            "narrator": "アーヤ",
            "text": "ええと…。",
            "zh": "那个……",
            "narrator_zh": "绫水"
        },
        {
            "location": "384/TALK",
            "narrator": "アーヤ",
            "text": "Ｂｏｔのことなん\nですけど…。",
            "zh": "是关于Bot\n的事……",
            "narrator_zh": "绫水"
        },
        {
            "location": "388/TALK",
            "narrator": "アーヤ",
            "text": "トライガジェットの\n機能の。",
            "zh": "Tri-Gadget\n的功能。",
            "narrator_zh": "绫水"
        },
        {
            "location": "389/TALK",
            "narrator": "真幌",
            "text": "ああ。\n今さら使い方が\nわからないってことか。",
            "zh": "哦。\n到现在还不知道\n怎么用吗。",
            "narrator_zh": "真幌"
        },
        {
            "location": "390/TALK",
            "narrator": "真幌",
            "text": "それなら私より…。",
            "zh": "那样的话比我……",
            "narrator_zh": "真幌"
        },
        {
            "location": "391/TALK",
            "narrator": "アーヤ",
            "text": "あ、いえ。\nそうじゃなくて。",
            "zh": "啊，不是。\n不是那样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "392/TALK",
            "narrator": "アーヤ",
            "text": "仕様とかが\nわかる資料って\nないでしょうか？",
            "zh": "有没有能看懂\n规格之类的\n资料呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "393/TALK",
            "narrator": "真幌",
            "text": "ん？\nマニュアルじゃ\nなくて？",
            "zh": "嗯？\n不是\n手册吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "394/TALK",
            "narrator": "アーヤ",
            "text": "はい。\n仕様です。",
            "zh": "是的。\n是规格。",
            "narrator_zh": "绫水"
        },
        {
            "location": "395/TALK",
            "narrator": "真幌",
            "text": "……んー……。",
            "zh": "……嗯——……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "396/TALK",
            "narrator": "真幌",
            "text": "知らないし\nもし知っていたとしても\nアーヤには渡せない。",
            "zh": "我不知道。\n就算知道，\n也不能交给绫水。",
            "narrator_zh": "真幌"
        },
        {
            "location": "397/TALK",
            "narrator": "真幌",
            "text": "私の立場上な。",
            "zh": "我的立场使然。",
            "narrator_zh": "真幌"
        },
        {
            "location": "399/TALK",
            "narrator": "アーヤ",
            "text": "…そうですか…。",
            "zh": "……是这样啊……",
            "narrator_zh": "绫水"
        },
        {
            "location": "400/TALK",
            "narrator": "真幌",
            "text": "それより。\nなんでそんなものを\n見たがるんだ？",
            "zh": "比起那个。\n你为什么想\n看那种东西？",
            "narrator_zh": "真幌"
        },
        {
            "location": "403/TALK",
            "narrator": "アーヤ",
            "text": "え。",
            "zh": "诶。",
            "narrator_zh": "绫水"
        },
        {
            "location": "404/TALK",
            "narrator": "真幌",
            "text": "何か困ったことが\nあったのか？",
            "zh": "是有什么\n为难的事吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "408/TALK",
            "narrator": "アーヤ",
            "text": "え、と。",
            "zh": "那、那个。",
            "narrator_zh": "绫水"
        },
        {
            "location": "409/SEL",
            "narrator": "",
            "text": "やあやあ",
            "zh": "呀呀",
            "narrator_zh": ""
        },
        {
            "location": "410/ACT",
            "narrator": "",
            "text": "やあやあ",
            "zh": "呀呀",
            "narrator_zh": ""
        },
        {
            "location": "415/TALK",
            "narrator": "真幌",
            "text": "スマホ、鳴ったぞ。",
            "zh": "手机响了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "418/TALK",
            "narrator": "アーヤ",
            "text": "…。",
            "zh": "…。",
            "narrator_zh": "绫水"
        },
        {
            "location": "419/TALK",
            "narrator": "真幌",
            "text": "遠慮せず出ればいい。",
            "zh": "不用客气，接就是了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "433/TALK",
            "narrator": "アーヤ",
            "text": "やあやあって",
            "zh": "呀呀呀",
            "narrator_zh": "绫水"
        },
        {
            "location": "434/TALK",
            "narrator": "アーヤ",
            "text": "ずいぶんのんきね",
            "zh": "还真悠闲啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "436/SEL",
            "narrator": "",
            "text": "駄目？",
            "zh": "不行？",
            "narrator_zh": ""
        },
        {
            "location": "437/SEL",
            "narrator": "",
            "text": "気楽にやろうよ",
            "zh": "轻松点来吧",
            "narrator_zh": ""
        },
        {
            "location": "438/ACT",
            "narrator": "",
            "text": "駄目？",
            "zh": "不行？",
            "narrator_zh": ""
        },
        {
            "location": "439/TALK",
            "narrator": "アーヤ",
            "text": "ダメっていうか",
            "zh": "说不行的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "440/TALK",
            "narrator": "アーヤ",
            "text": "今、館長いるから",
            "zh": "现在馆长在",
            "narrator_zh": "绫水"
        },
        {
            "location": "441/TALK",
            "narrator": "アーヤ",
            "text": "後でね",
            "zh": "回头再说",
            "narrator_zh": "绫水"
        },
        {
            "location": "442/ACT",
            "narrator": "",
            "text": "気楽にやろうよ",
            "zh": "轻松点来吧",
            "narrator_zh": ""
        },
        {
            "location": "443/TALK",
            "narrator": "アーヤ",
            "text": "気楽に",
            "zh": "轻松点",
            "narrator_zh": "绫水"
        },
        {
            "location": "444/TALK",
            "narrator": "アーヤ",
            "text": "できないときもあるのよ",
            "zh": "也有做不到的时候哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "445/TALK",
            "narrator": "アーヤ",
            "text": "今日はできないの",
            "zh": "今天不行",
            "narrator_zh": "绫水"
        },
        {
            "location": "446/TALK",
            "narrator": "アーヤ",
            "text": "だから後でね",
            "zh": "那待会儿再说",
            "narrator_zh": "绫水"
        },
        {
            "location": "458/TALK",
            "narrator": "真幌",
            "text": "急ぎの用とかじゃ\nないのか？",
            "zh": "不是什么\n急事吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "460/TALK",
            "narrator": "アーヤ",
            "text": "あ、違います。",
            "zh": "啊，不是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "461/TALK",
            "narrator": "真幌",
            "text": "で、さっきの\n続きだが。",
            "zh": "那么，接着刚才的\n说。",
            "narrator_zh": "真幌"
        },
        {
            "location": "462/TALK",
            "narrator": "真幌",
            "text": "困ったことが\nあるなら\n教えて欲しい。",
            "zh": "要是有\n为难的事，\n告诉我就好。",
            "narrator_zh": "真幌"
        },
        {
            "location": "463/TALK",
            "narrator": "真幌",
            "text": "これでも一応\n上司だし。",
            "zh": "就算这样，我好歹\n也是上司。",
            "narrator_zh": "真幌"
        },
        {
            "location": "464/TALK",
            "narrator": "真幌",
            "text": "できる限り\n力になりたいと\n思っている。",
            "zh": "我想尽量\n出一份\n力。",
            "narrator_zh": "真幌"
        },
        {
            "location": "466/TALK",
            "narrator": "アーヤ",
            "text": "…はい…。",
            "zh": "……嗯……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "467/TALK",
            "narrator": "真幌",
            "text": "そんな顔をするな。",
            "zh": "别摆出那种脸。",
            "narrator_zh": "真幌"
        },
        {
            "location": "468/TALK",
            "narrator": "真幌",
            "text": "と言っても\n無理か。",
            "zh": "就算这么说，\n也没办法吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "469/TALK",
            "narrator": "真幌",
            "text": "もしお姉さんに\n連絡がつくなら…。",
            "zh": "要是能联系上\n姐姐的话……",
            "narrator_zh": "真幌"
        },
        {
            "location": "471/TALK",
            "narrator": "アーヤ",
            "text": "それだけは\nいやです。",
            "zh": "只有这个，\n我不要。",
            "narrator_zh": "绫水"
        },
        {
            "location": "473/TALK",
            "narrator": "真幌",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "475/TALK",
            "narrator": "真幌",
            "text": "そう言われる\n気はしてたが。",
            "zh": "我早就觉得\n你会这么说。",
            "narrator_zh": "真幌"
        },
        {
            "location": "478/TALK",
            "narrator": "真幌",
            "text": "じゃあ次点は\nみやびだろう。",
            "zh": "那下一个\n就是雅了吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "479/TALK",
            "narrator": "真幌",
            "text": "残念ながら本当に\n知る立場にないんだ\n私は。",
            "zh": "可惜我真的\n没有知情的立场。\n我没有。",
            "narrator_zh": "真幌"
        },
        {
            "location": "481/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "482/TALK",
            "narrator": "真幌",
            "text": "役に立てず\nすまないね。",
            "zh": "帮不上忙，\n对不住。",
            "narrator_zh": "真幌"
        },
        {
            "location": "484/TALK",
            "narrator": "アーヤ",
            "text": "いえ。\nこちらこそ\nすみませんでした。",
            "zh": "没有。\n是我这边\n该道歉。",
            "narrator_zh": "绫水"
        },
        {
            "location": "485/TALK",
            "narrator": "真幌",
            "text": "…見つかるといいな。\n捜し物。",
            "zh": "……希望你能找到。\n你要找的东西。",
            "narrator_zh": "真幌"
        },
        {
            "location": "487/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "367/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月某日　9:02 PM</color>\nとある平日の夜、アーヤの部屋にて。",
            "zh": "<color=green>5月某日　9:02 PM</color>\n某个平日的夜里，绫水的房间。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
