{
    "dir": "chap17/daydra/dd_ch03_17_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "17356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "お手前披露",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "一展身手"
    },
    "entry": [
        {
            "location": "299/SCENARIO",
            "narrator": "",
            "text": "お手前披露",
            "zh": "一展身手",
            "narrator_zh": ""
        },
        {
            "location": "317/TALK",
            "narrator": "つばめ",
            "text": "わぁ、すごい！\nガブちゃんまた命中だよ！",
            "zh": "哇，好厉害！\n加布又打中了呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "318/TALK",
            "narrator": "雛",
            "text": "凄いよガブリエラちゃん！\n射撃の腕は世界一だね！",
            "zh": "太厉害了，加布里埃拉！\n这枪法简直天下第一嘛！",
            "narrator_zh": "雏"
        },
        {
            "location": "321/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、これくらい当然よ。",
            "zh": "哼，这种程度理所当然啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "322/TALK",
            "narrator": "ガブリエラ",
            "text": "それにしても、エアガンの\nシューティングレンジが\nあるなんて――",
            "zh": "不过话说回来，\n没想到这里居然还有\n气枪射击场——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "今日まで知らなかったわ。",
            "zh": "我直到今天才知道呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "ヒカル",
            "text": "僕とキリトは\nよく来るんですよ。",
            "zh": "我和圣翔\n经常来这里哦。",
            "narrator_zh": "光"
        },
        {
            "location": "326/TALK",
            "narrator": "ヒカル",
            "text": "授業で習った射撃訓練の\n復習にもなるので。",
            "zh": "正好也能用来复习\n课上学过的射击训练嘛。",
            "narrator_zh": "光"
        },
        {
            "location": "327/TALK",
            "narrator": "雛",
            "text": "ん～、関心関心。\n勉強熱心だねー。",
            "zh": "嗯～真令人钦佩。\n学习真用功啊——",
            "narrator_zh": "雏"
        },
        {
            "location": "328/TALK",
            "narrator": "ヒカル",
            "text": "まあ、半分は遊びみたいな\nものですけど…ね？",
            "zh": "嘛，虽然有一半也算是\n来玩的吧……对吧？",
            "narrator_zh": "光"
        },
        {
            "location": "329/TALK",
            "narrator": "キリト",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "330/TALK",
            "narrator": "ヒカル",
            "text": "キリト、\nどうかしましたか？",
            "zh": "圣翔，\n你怎么了？",
            "narrator_zh": "光"
        },
        {
            "location": "331/TALK",
            "narrator": "キリト",
            "text": "…俺のハイスコア、\nガブリエラに抜かれち\nまった。",
            "zh": "……我的最高纪录，\n被加布里埃拉\n给破了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "332/TALK",
            "narrator": "ヒカル",
            "text": "いや、それは仕方ないと\n思いますよ？",
            "zh": "哎呀，这也没办法\n不是吗？",
            "narrator_zh": "光"
        },
        {
            "location": "333/TALK",
            "narrator": "ヒカル",
            "text": "ガブリエラさんの方が\n銃の経験は豊富に積んで\nいるんですし。",
            "zh": "毕竟加布里埃拉\n摸枪的经验可比我们\n丰富得多嘛。",
            "narrator_zh": "光"
        },
        {
            "location": "335/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "336/TALK",
            "narrator": "キリト",
            "text": "けどな、俺にも養成科の\n射撃成績一位のプライドが\nあるんだ。",
            "zh": "话虽如此，我好歹也有\n养成科射击成绩第一名的\n尊严在啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "338/TALK",
            "narrator": "キリト",
            "text": "おい、雛。\n俺は今から、ガブリエラに\n勝負を申し込むぜ。",
            "zh": "喂，雏。\n我现在要向加布里埃拉\n发起挑战了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "340/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "342/TALK",
            "narrator": "雛",
            "text": "…って言ってるけど、\nどうする？",
            "zh": "……他是这么说的，\n你要接招吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "343/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、まあ、あたしは別に\n構わないけど…。",
            "zh": "这、这个嘛，我倒是\n无所谓啦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "345/TALK",
            "narrator": "つばめ",
            "text": "でも、ガブちゃんって\nキリトくんのハイスコアを\n抜いたんだよね？",
            "zh": "可是，加布不是刚刚\n才打破圣翔的\n最高纪录吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "346/TALK",
            "narrator": "ヒカル",
            "text": "そうですよ。\n勝負は見えてるじゃ\nないですか。",
            "zh": "就是说啊。\n胜负不是一眼就看出来了\n吗。",
            "narrator_zh": "光"
        },
        {
            "location": "347/TALK",
            "narrator": "キリト",
            "text": "へへっ、甘いな。\nちゃーんと考えが\nあってのことさ。",
            "zh": "嘿嘿，太天真了。\n我可是早有打算\n才这么说的。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "348/TALK",
            "narrator": "つばめ",
            "text": "何か作戦があるの？",
            "zh": "你有什么作战计划吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "350/TALK",
            "narrator": "キリト",
            "text": "ああ…なあ、ガブリエラ。\n俺の提案を聞いてくれ。",
            "zh": "嗯……我说，加布里埃拉。\n你先听听我的提议。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "353/TALK",
            "narrator": "ガブリエラ",
            "text": "…な、なんだろう？\n何を言われるのかしら？",
            "zh": "……什、什么呀？\n他到底想说什么啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "354/TALK",
            "narrator": "キリト",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "356/TALK",
            "narrator": "キリト",
            "text": "ハンデください。",
            "zh": "请让我一下吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "358/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "360/TALK",
            "narrator": "つばめ",
            "text": "ハンデ！？",
            "zh": "让你！？",
            "narrator_zh": "燕"
        },
        {
            "location": "361/TALK",
            "narrator": "雛",
            "text": "しょぼっ！！\nてか超ダサッ！！",
            "zh": "好逊！！\n不如说简直丢人丢大发了！！",
            "narrator_zh": "雏"
        },
        {
            "location": "364/TALK",
            "narrator": "ヒカル",
            "text": "き、キリト…\nさすがにそれはどうなん\nですか？",
            "zh": "圣、圣翔……\n这未免也太不像话了\n吧？",
            "narrator_zh": "光"
        },
        {
            "location": "367/TALK",
            "narrator": "キリト",
            "text": "お、おまえらだって\nわかってんだろ！？",
            "zh": "你、你们自己心里\n不也清楚吗！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "368/TALK",
            "narrator": "キリト",
            "text": "俺がまともにやっても、\nガブリエラに勝てるはず\nねぇって！",
            "zh": "真要正儿八经地比，\n我根本不可能赢过\n加布里埃拉啊！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "370/TALK",
            "narrator": "雛",
            "text": "だからって、女の子に\nハンデ貰うって…ねえ？",
            "zh": "就算这样，跟女孩子\n讨让步也太……对吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "372/TALK",
            "narrator": "ガブリエラ",
            "text": "ハンデかぁ…\nう～ん…。",
            "zh": "让步啊……\n唔～嗯……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "373/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと調べるから\n待ってて。",
            "zh": "我稍微查点东西，\n你们等一下。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "374/TALK",
            "narrator": "雛",
            "text": "ごめんね、キリトの\nワガママに付き合わせて。",
            "zh": "不好意思啊，还要你\n陪着圣翔胡闹。",
            "narrator_zh": "雏"
        },
        {
            "location": "387/TALK",
            "narrator": "ガブリエラ",
            "text": "相談があるの、マルザンナ",
            "zh": "有件事想和你商量，玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "389/SEL",
            "narrator": "",
            "text": "それはそうと、楽しそうだね",
            "zh": "不过话说回来，你玩得很开心嘛",
            "narrator_zh": ""
        },
        {
            "location": "390/ACT",
            "narrator": "",
            "text": "それはそうと、楽しそうだね",
            "zh": "不过话说回来，你玩得很开心嘛",
            "narrator_zh": ""
        },
        {
            "location": "392/TALK",
            "narrator": "ガブリエラ",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "393/TALK",
            "narrator": "ガブリエラ",
            "text": "こういうところでみんなと遊ぶの初めてだから、凄く楽しんでるわ",
            "zh": "我还是第一次在这样的地方和大家一起玩，所以真的超开心的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "394/TALK",
            "narrator": "ガブリエラ",
            "text": "それで、相談なんだけど",
            "zh": "然后，我想商量的事就是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "396/TALK",
            "narrator": "ガブリエラ",
            "text": "キリトにハンデをあげるべきかしら？",
            "zh": "我该不该给圣翔让步呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "398/SEL",
            "narrator": "",
            "text": "何か問題でもあるの？",
            "zh": "这有什么问题吗？",
            "narrator_zh": ""
        },
        {
            "location": "399/ACT",
            "narrator": "",
            "text": "何か問題でもあるの？",
            "zh": "这有什么问题吗？",
            "narrator_zh": ""
        },
        {
            "location": "401/TALK",
            "narrator": "ガブリエラ",
            "text": "男の子相手にハンデあげて、それでキリトが勝っても嬉しくないと思うの",
            "zh": "对一个男生让步，就算圣翔赢了，我觉得他也不会高兴啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "402/TALK",
            "narrator": "ガブリエラ",
            "text": "だから正々堂々とやった方が良いのかな、って",
            "zh": "所以我在想，是不是还是堂堂正正地一决胜负比较好",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "403/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、友達の頼みだからハンデあげた方が良いのかな、とも思うし",
            "zh": "可另一方面，毕竟是朋友的请求，又觉得是不是让一点步比较好",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "404/TALK",
            "narrator": "ガブリエラ",
            "text": "どっちがいいと思う？",
            "zh": "你觉得哪种比较好？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "406/SEL",
            "narrator": "",
            "text": "ゲームにハンデは必要",
            "zh": "游戏就需要让步来平衡",
            "narrator_zh": ""
        },
        {
            "location": "407/SEL",
            "narrator": "",
            "text": "真剣勝負だ",
            "zh": "既然要打就真刀真枪地比",
            "narrator_zh": ""
        },
        {
            "location": "408/ACT",
            "narrator": "",
            "text": "ゲームにハンデは必要",
            "zh": "游戏就需要让步来平衡",
            "narrator_zh": ""
        },
        {
            "location": "410/TALK",
            "narrator": "ガブリエラ",
            "text": "なるほど…",
            "zh": "原来如此……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "411/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナ、あなたの言う通りだわ",
            "zh": "玛尔赞娜，你说得对",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "422/TALK",
            "narrator": "ガブリエラ",
            "text": "お待たせ。",
            "zh": "久等了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "424/TALK",
            "narrator": "つばめ",
            "text": "随分長く調べてたね。",
            "zh": "你查了好久呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "426/TALK",
            "narrator": "ガブリエラ",
            "text": "え、えっと…エアガンの\nことを、ちょっとね…。",
            "zh": "那、那个……稍微查了点\n关于气枪的事嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "429/TALK",
            "narrator": "ガブリエラ",
            "text": "ハンデのことだけど、\nあたしは構わないわ。",
            "zh": "关于让步的事，\n我这边没问题哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "431/TALK",
            "narrator": "キリト",
            "text": "おおっ、マジか！！",
            "zh": "哦哦，真的吗！！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "433/TALK",
            "narrator": "雛",
            "text": "ハンデなんかあげて\n大丈夫なの？",
            "zh": "给他让步真的\n没关系吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "435/TALK",
            "narrator": "ガブリエラ",
            "text": "ゲームなんだから、\n互角にしないと\n面白くないわ。",
            "zh": "反正是玩游戏嘛，\n势均力敌一点\n才比较有意思啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "436/TALK",
            "narrator": "ガブリエラ",
            "text": "その方がつばめ達も\n盛り上がれるし、真剣に\n勝負もできるでしょ？",
            "zh": "那样一来，燕她们\n也能跟着热闹起来，\n也能认真比一场吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "437/TALK",
            "narrator": "キリト",
            "text": "さすが、ガブリエラは\nわかってるなぁ。",
            "zh": "不愧是加布里埃拉，\n真是深明大义啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "439/TALK",
            "narrator": "つばめ",
            "text": "それで、どれくらい\nハンデをつけるの？",
            "zh": "那打算让多少\n才好呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "441/TALK",
            "narrator": "ガブリエラ",
            "text": "まずは距離ね。\nあたしは１５メートルから\n撃つから――",
            "zh": "首先是距离。\n我从15米开外\n射击——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "442/TALK",
            "narrator": "ガブリエラ",
            "text": "１０メートル地点から\n撃っていいわ。",
            "zh": "你就从10米的位置\n射击好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "444/TALK",
            "narrator": "ガブリエラ",
            "text": "それと、銃も好きに\nオプション付けて\n構わないから。",
            "zh": "还有，枪上你想加什么\n配件都随便你，\n我无所谓。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "445/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんは？",
            "zh": "那加布你呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "448/TALK",
            "narrator": "ガブリエラ",
            "text": "何も必要ないわ。\n１５メートルくらいなら\n肉眼でいけるし。",
            "zh": "我什么都不需要。\n才15米而已，\n用肉眼瞄就够了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "449/TALK",
            "narrator": "ヒカル",
            "text": "…キリト、どうしますか？",
            "zh": "……圣翔，你打算怎么办？",
            "narrator_zh": "光"
        },
        {
            "location": "451/TALK",
            "narrator": "キリト",
            "text": "スコープとレーザー\nポインターを付けてくれ。",
            "zh": "帮我装上瞄准镜和\n激光指示器吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "452/TALK",
            "narrator": "キリト",
            "text": "それくらいしねぇと、\nマジで勝てる気しねぇ\nからな…。",
            "zh": "不做到这种程度，\n我是真觉得一点赢面\n都没有啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "454/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん、\n頑張ってね！",
            "zh": "加布里埃拉，\n加油哦！",
            "narrator_zh": "雏"
        },
        {
            "location": "455/TALK",
            "narrator": "つばめ",
            "text": "ファイト、ガブちゃん！",
            "zh": "加油呀，加布！",
            "narrator_zh": "燕"
        },
        {
            "location": "464/TALK",
            "narrator": "雛",
            "text": "次が最後だね。\nこれで中心を当てれば…。",
            "zh": "下一发就是最后一发了。\n只要这发命中靶心……。",
            "narrator_zh": "雏"
        },
        {
            "location": "465/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん、頑張って！",
            "zh": "加布，加油呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "466/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "467/TALK",
            "narrator": "ガブリエラ",
            "text": "今だっ！",
            "zh": "就是现在！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "474/TALK",
            "narrator": "キリト",
            "text": "うわっ、やりやがった！",
            "zh": "哇啊，真让她打中了！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "476/TALK",
            "narrator": "ガブリエラ",
            "text": "やった！\n当たったわ！",
            "zh": "太好了！\n打中了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "477/TALK",
            "narrator": "つばめ",
            "text": "やったねガブちゃん！\nガブちゃんの勝ちだよ！",
            "zh": "太棒啦加布！\n是加布赢了哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "479/TALK",
            "narrator": "ガブリエラ",
            "text": "…ギリギリだったけどね。",
            "zh": "……虽然只是险胜啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "480/TALK",
            "narrator": "雛",
            "text": "ハンデ付けたんだから、\nギリギリでも勝ったのは\n凄いよ！",
            "zh": "你都让了那么多，\n就算只是险胜也已经\n很厉害啦！",
            "narrator_zh": "雏"
        },
        {
            "location": "481/TALK",
            "narrator": "キリト",
            "text": "はぁ…負けちまったぁ…。",
            "zh": "哈啊……还是输了啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "483/TALK",
            "narrator": "ヒカル",
            "text": "残念でしたね。",
            "zh": "真遗憾呢。",
            "narrator_zh": "光"
        },
        {
            "location": "485/TALK",
            "narrator": "キリト",
            "text": "ははっ、ちょっとだけな。\nでもすげぇ楽しかったぜ。",
            "zh": "哈哈，是有点不甘心啦。\n不过玩得真的超痛快。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "487/TALK",
            "narrator": "キリト",
            "text": "もっと腕を磨いたら、\n今度こそリベンジして\nやるさ。",
            "zh": "等我再磨练磨练技术，\n下次一定要找回\n这个场子。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "488/TALK",
            "narrator": "ヒカル",
            "text": "あはは、今まで以上に\n射撃訓練に力入れそう\nですね。",
            "zh": "啊哈哈，感觉他会比以前\n更加拼命投入到\n射击训练里去呢。",
            "narrator_zh": "光"
        },
        {
            "location": "490/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "492/TALK",
            "narrator": "ガブリエラ",
            "text": "凄く楽しかったし、\n本当にまた勝負したいな。",
            "zh": "我也觉得特别开心，\n真想再比一次呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "509/ACT",
            "narrator": "",
            "text": "真剣勝負だ",
            "zh": "既然要比就真刀真枪地比",
            "narrator_zh": ""
        },
        {
            "location": "510/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね",
            "zh": "对吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "511/TALK",
            "narrator": "ガブリエラ",
            "text": "勝負である以上、真剣にやらないとダメよね",
            "zh": "既然是一决胜负，不认真打可不行",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "522/TALK",
            "narrator": "ガブリエラ",
            "text": "お待たせ。",
            "zh": "久等了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "524/TALK",
            "narrator": "つばめ",
            "text": "随分長く調べてたね。",
            "zh": "你查了好久呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "526/TALK",
            "narrator": "ガブリエラ",
            "text": "え、えっと…エアガンの\nことを、ちょっとね…。",
            "zh": "那、那个……稍微查了点\n关于气枪的事嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "529/TALK",
            "narrator": "ガブリエラ",
            "text": "ハンデのことだけど、\n却下よ。",
            "zh": "关于让步的事，\n我驳回。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "531/TALK",
            "narrator": "キリト",
            "text": "なにぃ！？",
            "zh": "什么！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "533/TALK",
            "narrator": "雛",
            "text": "いや、驚くようなことじゃ\nないから…。",
            "zh": "哎呀，这有什么好\n惊讶的……。",
            "narrator_zh": "雏"
        },
        {
            "location": "534/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、勝負は対等に\nやらなきゃダメだから？",
            "zh": "果然还是因为，胜负必须\n公平对等地比才行吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "536/TALK",
            "narrator": "ガブリエラ",
            "text": "それもあるけど、\n養成科で鍛えた人の腕が\nどの程度なのか――",
            "zh": "这倒也是，\n不过我也想亲眼确认一下\n——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "537/TALK",
            "narrator": "ガブリエラ",
            "text": "一度、この目で確かめて\nみたいのよ。",
            "zh": "在养成科受过训练的人，\n水平究竟到了什么程度。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "539/TALK",
            "narrator": "キリト",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "541/TALK",
            "narrator": "ヒカル",
            "text": "キリト、しっかり！\n始める前から諦めないで\nください。",
            "zh": "圣翔，打起精神来！\n还没开始呢，别先认输了\n啊。",
            "narrator_zh": "光"
        },
        {
            "location": "543/TALK",
            "narrator": "ガブリエラ",
            "text": "距離は１５メートル。\n使う弾は十発ね。",
            "zh": "距离15米。\n每人十发子弹哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "544/TALK",
            "narrator": "雛",
            "text": "…だって。\nわかった、キリト？",
            "zh": "……她都这么说了。\n听明白了吗，圣翔？",
            "narrator_zh": "雏"
        },
        {
            "location": "546/TALK",
            "narrator": "キリト",
            "text": "くそぉ、こうなったら\nやけくそだ！",
            "zh": "可恶，事到如今\n豁出去了！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "549/TALK",
            "narrator": "ガブリエラ",
            "text": "…あんなに荒れてたら、\nまず当たらないわね。",
            "zh": "……心态乱成那样，\n多半是打不中的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "550/TALK",
            "narrator": "ガブリエラ",
            "text": "勝負は見えたわ。",
            "zh": "胜负已分了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "563/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "564/TALK",
            "narrator": "キリト",
            "text": "…ま、マジか？",
            "zh": "……真、真的假的？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "565/TALK",
            "narrator": "ヒカル",
            "text": "はい…ガブリエラさんが\n９４点で、キリトの方が\n９６点なので――",
            "zh": "是的……加布里埃拉\n是94分，而圣翔\n是96分——",
            "narrator_zh": "光"
        },
        {
            "location": "566/TALK",
            "narrator": "ヒカル",
            "text": "ギリギリですが、\nキリトの勝ちです。",
            "zh": "虽然只差一点，\n但这次是圣翔赢了。",
            "narrator_zh": "光"
        },
        {
            "location": "568/TALK",
            "narrator": "つばめ",
            "text": "うそっ！？\nガブちゃんが負ける\nなんて！！",
            "zh": "不会吧！？\n加布居然输了\n吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "571/TALK",
            "narrator": "ガブリエラ",
            "text": "うっ…。",
            "zh": "唔……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "573/TALK",
            "narrator": "雛",
            "text": "ちょ、つばめちゃん！\nそんなハッキリ言ったら\nダメだってば！",
            "zh": "喂、燕！\n别把话说得那么直白\n呀！",
            "narrator_zh": "雏"
        },
        {
            "location": "574/TALK",
            "narrator": "雛",
            "text": "ああ、ほら、明らかに\n落ち込んじゃってるし…。",
            "zh": "啊，你看，她明显\n消沉下去了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "576/TALK",
            "narrator": "ヒカル",
            "text": "し、仕方ないですよ！\nガブリエラさんは\n本物派ですし！",
            "zh": "这、这也是没办法的事嘛！\n毕竟加布里埃拉是\n实弹派的！",
            "narrator_zh": "光"
        },
        {
            "location": "578/TALK",
            "narrator": "キリト",
            "text": "そ、そうだぜ！\n弾の飛び方も反動も、\n全然違うだろ？",
            "zh": "对、对啊！\n子弹的弹道和后坐力，\n完全不一样吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "579/TALK",
            "narrator": "キリト",
            "text": "エアガン慣れしてる\n俺の方が有利なんだから、\n落ち込む必要ねぇって！",
            "zh": "习惯气枪的我本来就\n占了便宜，根本没必要\n往心里去啦！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "583/TALK",
            "narrator": "ガブリエラ",
            "text": "な、なんかメチャクチャ\nフォローされてるし…。",
            "zh": "总、总觉得被他们\n拼命在安慰呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "584/TALK",
            "narrator": "ガブリエラ",
            "text": "…ま、まあ、確かに\n本物とは全然違うわね。",
            "zh": "……唔、嗯，确实跟\n真枪完全不一样呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "586/TALK",
            "narrator": "ガブリエラ",
            "text": "けど…真剣勝負だったん\nだから、負けは負けよ。\n潔く認めるわ。",
            "zh": "不过……既然是真刀真枪的\n胜负，输了就是输了。\n我干脆地认输。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "588/TALK",
            "narrator": "つばめ",
            "text": "…意外と、落ち込んでは\nいないみたいのかな？",
            "zh": "……意外地，她好像\n并没有那么消沉嘛？",
            "narrator_zh": "燕"
        },
        {
            "location": "589/TALK",
            "narrator": "ヒカル",
            "text": "そうですね。\nちょっと驚いただけなの\nかもしれませんね。",
            "zh": "是啊。\n说不定只是稍微有点\n意外罢了。",
            "narrator_zh": "光"
        },
        {
            "location": "591/TALK",
            "narrator": "キリト",
            "text": "…じゃあ、とりあえず\n勝ちは勝ちなんだし、\n素直に喜んでおくぜ。",
            "zh": "……那好吧，反正\n赢了就是赢了，\n我就坦率地高兴一回了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "592/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "594/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと、一時間だけ\n延長してくるわ。",
            "zh": "我稍微去加时\n一个小时。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "596/TALK",
            "narrator": "つばめ",
            "text": "えっ！？",
            "zh": "咦！？",
            "narrator_zh": "燕"
        },
        {
            "location": "598/TALK",
            "narrator": "ガブリエラ",
            "text": "べ、別に、悔しいからじゃ\nないわよ！？",
            "zh": "我、我才不是因为\n不甘心才去的哦！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "599/TALK",
            "narrator": "ガブリエラ",
            "text": "もう少しエアガンを\n撃ってみたい、って\n思っただけだから…。",
            "zh": "只是单纯觉得，\n想再多打一会儿气枪\n而已……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "601/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと、行ってくるわ。",
            "zh": "我稍微去一下哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "605/TALK",
            "narrator": "つばめ",
            "text": "…やっぱり、気にしてた\nみたいだね。",
            "zh": "……果然，还是挺在意的\n嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "607/TALK",
            "narrator": "ヒカル",
            "text": "まあ、逆に安心しました。",
            "zh": "嘛，倒不如说我反而放心了。",
            "narrator_zh": "光"
        },
        {
            "location": "608/TALK",
            "narrator": "ヒカル",
            "text": "ガブリエラさんが得意な\n射撃で負けて、気にしない\nとは思えませんでしたし。",
            "zh": "要是加布里埃拉在拿手的\n射击上输掉却毫不介意，\n那才不像她的作风呢。",
            "narrator_zh": "光"
        },
        {
            "location": "609/TALK",
            "narrator": "雛",
            "text": "これさ、練習しまくって\nいずれキリトにリベンジ\nするつもりじゃないの？",
            "zh": "这下子，她该不会疯狂\n练习然后迟早找圣翔\n报一箭之仇吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "611/TALK",
            "narrator": "キリト",
            "text": "ははっ…ちょっと怖い気も\nするけど――",
            "zh": "哈哈……虽然是有点吓人\n就是了——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "612/TALK",
            "narrator": "キリト",
            "text": "ガブリエラの方から\n勝負しようって\n言ってきてくれるのは――",
            "zh": "不过能由加布里埃拉\n主动提出再来一局的\n话——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "613/TALK",
            "narrator": "キリト",
            "text": "ちょっと楽しみかもな。",
            "zh": "说不定还有点让人期待呢。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "312/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月25日　3:11 PM</color>\nとある休日の午後、屋外シューティングレンジにて。",
            "zh": "<color=green>6月25日　3:11 PM</color>\n某个休息日的午后，于户外射击场。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "503/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch03",
            "text": "【闇夜に霜の降る如く】",
            "zh": "【犹如暗夜降霜】",
            "narrator_zh": "Dialog_GEThimegoto_ch03"
        }
    ]
}
