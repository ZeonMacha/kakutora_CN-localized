        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "敵なのよ",
            "zh": "她是敌人哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "なのにどうしてわざわざ看病なんてしたの？",
            "zh": "那为什么还特意来照顾我？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/SEL",
            "narrator": "",
            "text": "裏切り者が看病するのかな？",
            "zh": "叛徒也会照顾人吗？",
            "narrator_zh": ""
        },
        {
            "location": "56/SEL",
            "narrator": "",
            "text": "あれは演技に見えなかった",
            "zh": "那看起来不像演技",
            "narrator_zh": ""
        },
        {
            "location": "57/SEL",
            "narrator": "",
            "text": "舐められてるってことか",
            "zh": "这么说是在小瞧我吗",
            "narrator_zh": ""
        },
        {
            "location": "58/ACT",
            "narrator": "",
            "text": "裏切り者が看病するのかな？",
            "zh": "叛徒也会照顾人吗？",
            "narrator_zh": ""
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなの",
            "zh": "那种事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "知らないわ",
            "zh": "我怎么知道",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "もしかしたら",
            "zh": "说不定",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "なめられてたのかもしれないし",
            "zh": "真的是被小瞧了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "あーもう！",
            "zh": "啊——真是的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/ACT",
            "narrator": "",
