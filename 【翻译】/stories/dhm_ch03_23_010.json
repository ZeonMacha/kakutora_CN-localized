            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽がなんで",
            "zh": "神乐到底为什么",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "私の看病をしたのか",
            "zh": "要来照顾我",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/SEL",
            "narrator": "",
            "text": "辛そうだったからでしょ",
            "zh": "因为看你难受得不行吧",
            "narrator_zh": ""
        },
        {
            "location": "39/SEL",
            "narrator": "",
            "text": "親切は素直に受けようよ",
            "zh": "好意就坦然收下嘛",
            "narrator_zh": ""
        },
        {
            "location": "40/SEL",
            "narrator": "",
            "text": "ガブリエラが好きだから",
            "zh": "因为加布里埃拉讨人喜欢呀",
            "narrator_zh": ""
        },
        {
            "location": "41/ACT",
            "narrator": "",
            "text": "辛そうだったからでしょ",
            "zh": "因为看你难受得不行吧",
            "narrator_zh": ""
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "そうかもしれないけど",
            "zh": "或许是这样没错",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "43/ACT",
            "narrator": "",
            "text": "親切は素直に受けようよ",
            "zh": "好意就坦然收下嘛",
            "narrator_zh": ""
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "あの時は",
            "zh": "那次",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "ガブリエラ",
            "text": "ちゃんと受けたわ",
            "zh": "我是好好收下了",
