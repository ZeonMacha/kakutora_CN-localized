    "entry": [
        {
            "location": "93/SCENARIO",
            "narrator": "",
            "text": "胸の内、隠し事",
            "zh": "心里话，藏着的事",
            "narrator_zh": ""
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "誰の心の中にも",
            "zh": "谁的心里",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "不可侵の領域があるのだ",
            "zh": "都有不可侵犯的领域",
            "narrator_zh": "雅"
        },
        {
            "location": "123/SEL",
            "narrator": "",
            "text": "そうだね",
            "zh": "是啊",
            "narrator_zh": ""
        },
        {
            "location": "124/SEL",
            "narrator": "",
            "text": "むしろそこを暴きたい",
            "zh": "我反倒想把它揭开",
            "narrator_zh": ""
        },
        {
            "location": "125/SEL",
            "narrator": "",
            "text": "$me$はみやびに全部を見せるよ",
            "zh": "$me$会把全部展示给雅",
            "narrator_zh": ""
        },
        {
            "location": "126/ACT",
            "narrator": "",
            "text": "そうだね",
            "zh": "是啊",
            "narrator_zh": ""
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "そうなのだ",
            "zh": "就是这样",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "そこには触れず",
            "zh": "不去碰那里",
            "narrator_zh": "雅"
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "そっと見守るがよかろうぞ",
            "zh": "轻轻守着为好",
            "narrator_zh": "雅"
        },
        {
            "location": "130/ACT",
            "narrator": "",
            "text": "むしろそこを暴きたい",
            "zh": "我反倒想把它揭开",
            "narrator_zh": ""
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "ああ",
            "zh": "啊",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "そう思うこともあるぞね",
            "zh": "有时也会这么想咧",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "だが",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "感心せん",
            "zh": "我不赞成",
            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "自分自身が同じことをされたら",
            "zh": "要是自己也被这么对待",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "みやび",
            "text": "と思ったが",
            "zh": "我是这么想的",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "そういうのに快楽を憶える口なら",
            "zh": "要是那种会从中记住快感的人",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "仕方ないぞね",
            "zh": "那就没办法咧",
            "narrator_zh": "雅"
        },
        {
            "location": "139/ACT",
            "narrator": "",
            "text": "$me$はみやびに全部を見せるよ",
            "zh": "$me$会把全部展示给雅",
            "narrator_zh": ""
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "その覚悟があるということか",
            "zh": "是说有这份觉悟吗",
            "narrator_zh": "雅"
        },
        {
            "location": "143/TALK",
            "narrator": "みやび",
            "text": "しかしだ",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "144/TALK",
            "narrator": "みやび",
            "text": "プライベートは",
            "zh": "私事",
            "narrator_zh": "雅"
        },
        {
            "location": "146/TALK",
            "narrator": "みやび",
            "text": "大事にするべきだ",
            "zh": "还是该看重",
            "narrator_zh": "雅"
        },
        {
            "location": "147/TALK",
            "narrator": "みやび",
            "text": "相棒",
            "zh": "搭档",
            "narrator_zh": "雅"
        }
    ]
}
