{
    "dir": "chap31/daydra/dd_ch04_31_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "31405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "不可視可視の問題＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "不可见与可见的问题＜后篇＞"
    },
    "entry": [
        {
            "location": "440/SCENARIO",
            "narrator": "",
            "text": "話は聞いた。いやもっと聞かせてくれ",
            "zh": "事情我听过了。不——再多讲点给我听",
            "narrator_zh": ""
        },
        {
            "location": "459/TALK",
            "narrator": "真幌",
            "text": "音羽がコンタクトを\n取ってきたのか？",
            "zh": "音羽主动联系\n上你们了？",
            "narrator_zh": "真幌"
        },
        {
            "location": "460/TALK",
            "narrator": "みやび",
            "text": "騙りでなければ\nそうなりますね。",
            "zh": "若不是假冒的，\n那就是了。",
            "narrator_zh": "雅"
        },
        {
            "location": "461/TALK",
            "narrator": "真幌",
            "text": "…私にも見せてくれ。",
            "zh": "…也让我看看。",
            "narrator_zh": "真幌"
        },
        {
            "location": "462/TALK",
            "narrator": "みやび",
            "text": "もちろんです。",
            "zh": "当然可以。",
            "narrator_zh": "雅"
        },
        {
            "location": "474/TALK",
            "narrator": "みやび",
            "text": "こちらはみやび",
            "zh": "这里是雅",
            "narrator_zh": "雅"
        },
        {
            "location": "475/TALK",
            "narrator": "みやび",
            "text": "トライナリーの一員",
            "zh": "三重奏的一员",
            "narrator_zh": "雅"
        },
        {
            "location": "477/TALK",
            "narrator": "音羽",
            "text": "はい",
            "zh": "是",
            "narrator_zh": "音羽"
        },
        {
            "location": "478/TALK",
            "narrator": "音羽",
            "text": "知っています",
            "zh": "我知道",
            "narrator_zh": "音羽"
        },
        {
            "location": "479/TALK",
            "narrator": "音羽",
            "text": "まずは感謝とお詫びを",
            "zh": "首先是致谢与致歉",
            "narrator_zh": "音羽"
        },
        {
            "location": "480/TALK",
            "narrator": "みやび",
            "text": "それはこちらからすべきこと",
            "zh": "那应该由我们这边先说",
            "narrator_zh": "雅"
        },
        {
            "location": "482/TALK",
            "narrator": "音羽",
            "text": "それから今こちらには",
            "zh": "另外，现在这边",
            "narrator_zh": "音羽"
        },
        {
            "location": "483/TALK",
            "narrator": "音羽",
            "text": "アーヤさんとガブリエラさんがいます",
            "zh": "绫水和加布里埃拉都在",
            "narrator_zh": "音羽"
        },
        {
            "location": "484/TALK",
            "narrator": "みやび",
            "text": "それを聞いて安心した",
            "zh": "听到这个我就安心了",
            "narrator_zh": "雅"
        },
        {
            "location": "486/TALK",
            "narrator": "音羽",
            "text": "それからエリカさんも",
            "zh": "还有领火也在",
            "narrator_zh": "音羽"
        },
        {
            "location": "487/TALK",
            "narrator": "みやび",
            "text": "なんとうらやましい話",
            "zh": "这可真让人羡慕啊",
            "narrator_zh": "雅"
        },
        {
            "location": "489/TALK",
            "narrator": "音羽",
            "text": "今は作戦会議中です",
            "zh": "现在正在开作战会议",
            "narrator_zh": "音羽"
        },
        {
            "location": "490/TALK",
            "narrator": "音羽",
            "text": "そしてみやびさんにお願いがあります",
            "zh": "然后想拜托雅一件事",
            "narrator_zh": "音羽"
        },
        {
            "location": "491/TALK",
            "narrator": "みやび",
            "text": "うちに？",
            "zh": "找我？",
            "narrator_zh": "雅"
        },
        {
            "location": "493/TALK",
            "narrator": "音羽",
            "text": "今回の作戦には技術サポートが不可欠です",
            "zh": "这次作战少不了技术支持",
            "narrator_zh": "音羽"
        },
        {
            "location": "494/TALK",
            "narrator": "音羽",
            "text": "劇場システムのプログラムの書き換えが必要です",
            "zh": "需要改写剧场系统的程序",
            "narrator_zh": "音羽"
        },
        {
            "location": "495/TALK",
            "narrator": "みやび",
            "text": "意外",
            "zh": "意外",
            "narrator_zh": "雅"
        },
        {
            "location": "496/TALK",
            "narrator": "みやび",
            "text": "音羽さんがそげなことにも詳しかったとは",
            "zh": "没想到音羽连这种事都懂",
            "narrator_zh": "雅"
        },
        {
            "location": "498/TALK",
            "narrator": "音羽",
            "text": "いえこれは",
            "zh": "不，这是",
            "narrator_zh": "音羽"
        },
        {
            "location": "499/TALK",
            "narrator": "音羽",
            "text": "エリカさんからの要望です",
            "zh": "领火提的要求",
            "narrator_zh": "音羽"
        },
        {
            "location": "500/TALK",
            "narrator": "音羽",
            "text": "みやびさんならできる",
            "zh": "说是雅的话能行",
            "narrator_zh": "音羽"
        },
        {
            "location": "501/TALK",
            "narrator": "音羽",
            "text": "アドバイスをと",
            "zh": "说是请雅给点建议来着",
            "narrator_zh": "音羽"
        },
        {
            "location": "502/TALK",
            "narrator": "みやび",
            "text": "なんと",
            "zh": "哎呀呀",
            "narrator_zh": "雅"
        },
        {
            "location": "516/TALK",
            "narrator": "真幌",
            "text": "この非常時に\nうれしそうだな\nみやび。",
            "zh": "都这种紧急时候了，\n你还一脸高兴啊，\n雅。",
            "narrator_zh": "真幌"
        },
        {
            "location": "518/TALK",
            "narrator": "みやび",
            "text": "大人のくせに\nからかうのは\nなしですよ。",
            "zh": "明明是大人了，\n还捉弄人，\n可不行哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "519/SEL",
            "narrator": "",
            "text": "やったね！",
            "zh": "太棒了！",
            "narrator_zh": ""
        },
        {
            "location": "520/ACT",
            "narrator": "",
            "text": "やったね！",
            "zh": "太棒了！",
            "narrator_zh": ""
        },
        {
            "location": "538/TALK",
            "narrator": "みやび",
            "text": "$handle$までそう言うか",
            "zh": "连$handle$都这么说啊",
            "narrator_zh": "雅"
        },
        {
            "location": "540/SEL",
            "narrator": "",
            "text": "うれしいくせに",
            "zh": "明明就很开心",
            "narrator_zh": ""
        },
        {
            "location": "541/SEL",
            "narrator": "",
            "text": "なんかうれしくて",
            "zh": "总觉得你就是开心",
            "narrator_zh": ""
        },
        {
            "location": "542/SEL",
            "narrator": "",
            "text": "本当は嫉妬の嵐",
            "zh": "其实心里嫉妒成灾吧",
            "narrator_zh": ""
        },
        {
            "location": "543/ACT",
            "narrator": "",
            "text": "うれしいくせに",
            "zh": "明明就很开心",
            "narrator_zh": ""
        },
        {
            "location": "544/TALK",
            "narrator": "みやび",
            "text": "うれしいに",
            "zh": "开心",
            "narrator_zh": "雅"
        },
        {
            "location": "545/TALK",
            "narrator": "みやび",
            "text": "決まっておるわ",
            "zh": "那还用说",
            "narrator_zh": "雅"
        },
        {
            "location": "546/ACT",
            "narrator": "",
            "text": "なんかうれしくて",
            "zh": "总觉得你就是开心",
            "narrator_zh": ""
        },
        {
            "location": "547/TALK",
            "narrator": "みやび",
            "text": "それは何か",
            "zh": "那是什么",
            "narrator_zh": "雅"
        },
        {
            "location": "549/TALK",
            "narrator": "みやび",
            "text": "心の友というやつか",
            "zh": "就是所谓心之友吗",
            "narrator_zh": "雅"
        },
        {
            "location": "550/ACT",
            "narrator": "",
            "text": "本当は嫉妬の嵐",
            "zh": "其实心里嫉妒成灾吧",
            "narrator_zh": ""
        },
        {
            "location": "551/TALK",
            "narrator": "みやび",
            "text": "なんと",
            "zh": "哎呀呀",
            "narrator_zh": "雅"
        },
        {
            "location": "552/TALK",
            "narrator": "みやび",
            "text": "うちの心は$handle$のものぞね",
            "zh": "我的心已经是$handle$的了咧",
            "narrator_zh": "雅"
        },
        {
            "location": "564/TALK",
            "narrator": "みやび",
            "text": "夜も寝んとエリカさんの\nデータを読み込んだ\n意味があったぞね…！",
            "zh": "通宵没睡读领火的\n数据，总算\n有意义了咧…！",
            "narrator_zh": "雅"
        },
        {
            "location": "565/TALK",
            "narrator": "みやび",
            "text": "まさかこんな展開に\nなるとは…！",
            "zh": "没想到会发展到\n这一步…！",
            "narrator_zh": "雅"
        },
        {
            "location": "568/TALK",
            "narrator": "みやび",
            "text": "アドレスの割出しと\n修復は自動化\nできますき。",
            "zh": "地址的追查和修复\n都可以自动化\n搞定了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "569/TALK",
            "narrator": "みやび",
            "text": "うちは音羽の話を\n聞くことにします。",
            "zh": "我去听音羽\n怎么说。",
            "narrator_zh": "雅"
        },
        {
            "location": "570/TALK",
            "narrator": "真幌",
            "text": "…ああ。\n頼んだぞ。",
            "zh": "…嗯。\n交给你了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "583/TALK",
            "narrator": "みやび",
            "text": "ではまず…",
            "zh": "那么首先…",
            "narrator_zh": "雅"
        },
        {
            "location": "596/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【25 ワールド・スピード】",
            "zh": "【25 世界速度】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
}
