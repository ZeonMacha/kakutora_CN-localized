{
    "dir": "chap19/daydra/dd_ch04_19_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "19452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "みやびの部屋",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "雅的房间"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "みやびの部屋",
            "zh": "雅的房间",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "みやび",
            "text": "…やっぱし、実家はえい\nもんやね。",
            "zh": "……果然，老家\n就是好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "26/TALK",
            "narrator": "みやび",
            "text": "なんちゅうても、\n愛しのスパコン、\n不可思議ちゃんもおるし！",
            "zh": "不管怎么说，\n心爱的超算，\n还有不可思议在呢！",
            "narrator_zh": "雅"
        },
        {
            "location": "27/TALK",
            "narrator": "みやび",
            "text": "たまには一泊二日でも\nえいき――",
            "zh": "偶尔来个两天一夜\n也不错嘛——",
            "narrator_zh": "雅"
        },
        {
            "location": "28/TALK",
            "narrator": "みやび",
            "text": "不可思議ちゃん触りに\n帰るようにした方が\nえいかもしれんね。",
            "zh": "以后还是养成\n回老家摸摸不可思议的\n习惯比较好啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "みやび",
            "text": "…しっかし。",
            "zh": "……话说回来。",
            "narrator_zh": "雅"
        },
        {
            "location": "32/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "まさか、ウサギがうちより\n先に部屋にいるとは、\n思わんかったわ。",
            "zh": "真没想到，\n兔子居然比我还先\n待在房间里啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "雅"
        },
        {
            "location": "41/TALK",
            "narrator": "繭",
            "text": "っ！？\nす、すみません！",
            "zh": "——！？\n对、对不起！",
            "narrator_zh": "茧"
        },
        {
            "location": "42/TALK",
            "narrator": "繭",
            "text": "久しぶりのご実家だと\nいうのに――",
            "zh": "难得回一趟\n老家——",
            "narrator_zh": "茧"
        },
        {
            "location": "44/TALK",
            "narrator": "繭",
            "text": "私のような邪魔者が\nいたら、くつろげません\nよね？",
            "zh": "有我这种碍事的人\n在的话，肯定\n放松不下来吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "46/TALK",
            "narrator": "みやび",
            "text": "いや、そんなことないき。",
            "zh": "不，才没那回事啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "この部屋にうち以外の\n人間がいるんが、ちっくと\n珍しいだけちや。",
            "zh": "这房间里除了我\n之外还有别人，\n只是有点稀奇滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "繭",
            "text": "…そうなんですか？",
            "zh": "……是这样吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "うちと家族を抜かすと、\n数人しか入ったこと\nないきね。",
            "zh": "除了我和家人，\n进来过的\n只有那么几个人啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "繭",
            "text": "…光栄です！",
            "zh": "……真是荣幸！",
            "narrator_zh": "茧"
        },
        {
            "location": "54/TALK",
            "narrator": "繭",
            "text": "…それにしても、\n凄いですね。",
            "zh": "……话说回来，\n真厉害啊。",
            "narrator_zh": "茧"
        },
        {
            "location": "55/TALK",
            "narrator": "繭",
            "text": "まさかご実家に、\nこんなスパコンを\nお持ちであったとは――",
            "zh": "没想到你老家\n居然摆着\n这样的超算——",
            "narrator_zh": "茧"
        },
        {
            "location": "56/TALK",
            "narrator": "繭",
            "text": "想像もしませんでした。",
            "zh": "完全没想到。",
            "narrator_zh": "茧"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "まあ、正式には借り物\nいうことになっちゅう\nけんどね。",
            "zh": "嘛，正式来说\n算是借来的，\n但是呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "繭",
            "text": "借り物、ですか？",
            "zh": "借来的，是吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "なんや、まほさんから\n聞いてないが？",
            "zh": "怎么，真幌\n没跟你说嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "うちのこのスパコン\n『不可思議』はな――",
            "zh": "我这台超算\n『不可思议』啊——",
            "narrator_zh": "雅"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "フェノメノンのことを\n調べるいう目的で、\n国から借りゆう物やき――",
            "zh": "是为了调查\nPhenoMENON，\n才从国家借来的啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "完全にうちの物や\nないんよ。",
            "zh": "完全就是\n不属于我的东西咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "繭",
            "text": "そういうことだったの\nですか…。",
            "zh": "原来\n是这么回事……。",
            "narrator_zh": "茧"
        },
        {
            "location": "65/TALK",
            "narrator": "繭",
            "text": "どうして東雲教官が、\nみやび先輩のご実家の\nＰＣを――",
            "zh": "为什么东云教官\n会对雅前辈老家的\nＰＣ——",
            "narrator_zh": "茧"
        },
        {
            "location": "66/TALK",
            "narrator": "繭",
            "text": "私にチェックしに行けと\n命じたのか、ずっと\n謎だったのですが――",
            "zh": "下命令叫我去检查的理由，\n我一直\n弄不明白——",
            "narrator_zh": "茧"
        },
        {
            "location": "67/TALK",
            "narrator": "繭",
            "text": "それを聞いて\n納得しました。",
            "zh": "听完这个\n就懂了。",
            "narrator_zh": "茧"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "数億円はする借り物やき、\n状態の確認をして\nおきたいんやろうね。",
            "zh": "好几亿日元的\n租借品啵，\n当然想确认下状态咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "繭",
            "text": "いらぬ心配ですね。\nこれといって、\n異常は見られません。",
            "zh": "是多虑了呢。\n目前并没有\n发现什么异常。",
            "narrator_zh": "茧"
        },
        {
            "location": "71/TALK",
            "narrator": "繭",
            "text": "…申し訳ありません、\nみやび先輩。",
            "zh": "……非常抱歉，\n雅前辈。",
            "narrator_zh": "茧"
        },
        {
            "location": "72/TALK",
            "narrator": "みやび",
            "text": "ん？",
            "zh": "嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "繭",
            "text": "出来る限り、早急に\n終わらせて出ていきます\nので…。",
            "zh": "我会尽快\n把检查做完，然后\n离开的……。",
            "narrator_zh": "茧"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "ウサギも、うちと同じ\nタイプの人間やき。",
            "zh": "兔子也是和我\n同一种人啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "自分のＰＣに触られる\n抵抗、よぉわかっちょるん\nやろうなぁ…。",
            "zh": "别人碰自己的ＰＣ\n有多别扭，她\n肯定最懂啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "…けんど。",
            "zh": "……但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "相棒",
            "zh": "搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "ウサギに対して",
            "zh": "对兔子",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "出ていけオーラ出てるか？",
            "zh": "我有放出「滚出去」气场吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "95/SEL",
            "narrator": "",
            "text": "え？　出してなかったの？",
            "zh": "诶？　你没放出来过？",
            "narrator_zh": ""
        },
        {
            "location": "96/SEL",
            "narrator": "",
            "text": "お茶でも出してあげたら？",
            "zh": "要不给她倒杯茶？",
            "narrator_zh": ""
        },
        {
            "location": "97/ACT",
            "narrator": "",
            "text": "え？　出してなかったの？",
            "zh": "诶？　你没放出来过？",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "そうか…",
            "zh": "这样啊……",
            "narrator_zh": "雅"
        },
        {
            "location": "99/TALK",
            "narrator": "みやび",
            "text": "謝罪案件だ",
            "zh": "得道歉了",
            "narrator_zh": "雅"
        },
        {
            "location": "111/TALK",
            "narrator": "みやび",
            "text": "あー、ウサギ。",
            "zh": "啊——兔子。",
            "narrator_zh": "雅"
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "もしうちが、さっさと\n部屋から出ていけオーラ\n出しちょるとしたら――",
            "zh": "要是刚才我一直在\n散发快滚出去的\n气场的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "それは謝る。\nすまんな。",
            "zh": "那我就道歉。\n没好意思啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "116/TALK",
            "narrator": "繭",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "茧"
        },
        {
            "location": "118/TALK",
            "narrator": "みやび",
            "text": "ウサギやって、\nまほさんに言われて――",
            "zh": "兔子你嘛，\n是被真幌派来的——",
            "narrator_zh": "雅"
        },
        {
            "location": "119/TALK",
            "narrator": "みやび",
            "text": "仕方なくチェックしに\n来ちゅうんやし。",
            "zh": "是没办法才\n来检查的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "邪魔者みたいに思わて、\nえい気持ちはせん\nやろうし…。",
            "zh": "被当成碍事的人，\n心情肯定\n不好受吧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "繭",
            "text": "いえ、良いんです！\n謝らないでください！",
            "zh": "没有，我没事！\n请不要道歉！",
            "narrator_zh": "茧"
        },
        {
            "location": "123/TALK",
            "narrator": "繭",
            "text": "そもそも、東雲教官の\n命令とはいえ――",
            "zh": "再说了，虽说是\n东云教官的命令——",
            "narrator_zh": "茧"
        },
        {
            "location": "124/TALK",
            "narrator": "繭",
            "text": "みやび先輩の部屋に入り\n作業するのですから――",
            "zh": "可我是要进雅前辈的\n房间来做作业的——",
            "narrator_zh": "茧"
        },
        {
            "location": "126/TALK",
            "narrator": "繭",
            "text": "事前に連絡して、\n許可を頂くべきでした。",
            "zh": "本该事先联系，\n征得你的许可才对。",
            "narrator_zh": "茧"
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "そんな余裕、\n多分なかったんやろ？",
            "zh": "那种闲工夫，\n多半是没有的吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "129/TALK",
            "narrator": "繭",
            "text": "それは…まあ…。",
            "zh": "这……嗯……。",
            "narrator_zh": "茧"
        },
        {
            "location": "131/TALK",
            "narrator": "繭",
            "text": "だとしても、自室は\n自分にとっては神聖な\n場所です。",
            "zh": "就算这样，自己的\n房间对自己来说\n也是神圣的地方。",
            "narrator_zh": "茧"
        },
        {
            "location": "132/TALK",
            "narrator": "繭",
            "text": "そこに他人が入るの\nだから、不快感を\n抱くのは当然のことです。",
            "zh": "有别人进去，\n会觉得\n不舒服很正常。",
            "narrator_zh": "茧"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "…なるほどな。",
            "zh": "……原来如此啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "繭",
            "text": "それに、私がみやび\n先輩の立場だったら――",
            "zh": "而且，要是我\n处在雅前辈的立场——",
            "narrator_zh": "茧"
        },
        {
            "location": "136/TALK",
            "narrator": "繭",
            "text": "間違いなく、出ていけ\nオーラを出していたと\n思いますし。",
            "zh": "肯定也会\n散发快滚出去的\n气场的。",
            "narrator_zh": "茧"
        },
        {
            "location": "138/TALK",
            "narrator": "繭",
            "text": "なので、みやび先輩が\n私に対して謝罪する\n必要はありません。",
            "zh": "所以雅前辈\n没有必要\n向我道歉。",
            "narrator_zh": "茧"
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "…わかった。\nじゃあ、もう謝らんよ。",
            "zh": "……懂了。\n那我就不道歉咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "繭",
            "text": "ありがとうございます。\nでは、作業を急ぎます。",
            "zh": "谢谢。\n那我去赶作业了。",
            "narrator_zh": "茧"
        },
        {
            "location": "141/ACT",
            "narrator": "",
            "text": "お茶でも出してあげたら？",
            "zh": "要不给她倒杯茶？",
            "narrator_zh": ""
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "うっかりしてた",
            "zh": "是我疏忽了",
            "narrator_zh": "雅"
        },
        {
            "location": "154/TALK",
            "narrator": "みやび",
            "text": "ウサギ、すまん。",
            "zh": "兔子，没好意思。",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "繭",
            "text": "はい？",
            "zh": "嗯？",
            "narrator_zh": "茧"
        },
        {
            "location": "157/TALK",
            "narrator": "みやび",
            "text": "ウサギはお客さんやのに、\n茶の一つも出しちょらん\nかった。",
            "zh": "兔子明明是客人，\n我却连一杯茶\n都没倒咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "158/TALK",
            "narrator": "みやび",
            "text": "すぐに持ってくるき、\n作業続けててな。",
            "zh": "我马上端来啵，\n你继续做你的。",
            "narrator_zh": "雅"
        },
        {
            "location": "160/TALK",
            "narrator": "繭",
            "text": "いえ、そんな！",
            "zh": "不用，哪能这样！",
            "narrator_zh": "茧"
        },
        {
            "location": "161/TALK",
            "narrator": "繭",
            "text": "自分は逢瀬さん達とは\n違う、招かれざる客です。",
            "zh": "我和逢濑她们不一样，\n是不请自来的客人。",
            "narrator_zh": "茧"
        },
        {
            "location": "162/TALK",
            "narrator": "繭",
            "text": "なので、そんな気を\n使わないでください。",
            "zh": "所以请不要\n这么客气。",
            "narrator_zh": "茧"
        },
        {
            "location": "163/TALK",
            "narrator": "みやび",
            "text": "これくらいのこと、\n気にする必要ないがよ。",
            "zh": "这点小事，\n没必要放心上咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "164/TALK",
            "narrator": "みやび",
            "text": "それに、せっかく\nうちの実家まで\n来てくれたんやし。",
            "zh": "再说你特意\n跑到我老家\n来一趟嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "165/TALK",
            "narrator": "みやび",
            "text": "茶でも飲みながら、\nのんびり話でもするぞね。",
            "zh": "边喝点茶，\n悠闲聊聊天咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "繭",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "茧"
        },
        {
            "location": "168/TALK",
            "narrator": "繭",
            "text": "みやび先輩の部屋で、\n二人きりで話、か…。",
