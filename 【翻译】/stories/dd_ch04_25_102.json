    "info": {
        "story_id": "25405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "非携帯とは何事か＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "不带手机成何体统＜后篇＞"
    },
    "entry": [
        {
            "location": "488/SCENARIO",
            "narrator": "",
            "text": "しばしさらば",
            "zh": "暂且再会",
            "narrator_zh": ""
        },
        {
            "location": "502/TALK",
            "narrator": "みやび",
            "text": "いやいや。\n願いは口に出せ\n言うしね。",
            "zh": "不不。\n愿望啊，据说要\n说出口才灵。",
            "narrator_zh": "雅"
        },
        {
            "location": "503/TALK",
            "narrator": "みやび",
            "text": "ここしばらくの\n超展開ぶりから\n叶わぬ願いではない。",
            "zh": "看这阵子的\n超展开程度，\n这愿望未必不能实现。",
            "narrator_zh": "雅"
        },
        {
            "location": "510/TALK",
            "narrator": "みやび",
            "text": "$handle$と\n一緒にここに\n戻れますように。",
            "zh": "愿能和$handle$\n一起\n回到这里。",
            "narrator_zh": "雅"
        },
        {
            "location": "511/SEL",
            "narrator": "",
            "text": "それって…二人で？",
            "zh": "那是说……两个人一起？",
            "narrator_zh": ""
        },
        {
            "location": "512/SEL",
            "narrator": "",
            "text": "もしかしてリアルに？",
            "zh": "该不会是现实中？",
            "narrator_zh": ""
        },
        {
            "location": "513/SEL",
            "narrator": "",
            "text": "物理的な話として？",
            "zh": "是从物理层面来说？",
            "narrator_zh": ""
        },
        {
            "location": "514/ACT",
            "narrator": "",
            "text": "それって…二人で？",
            "zh": "那是说……两个人一起？",
            "narrator_zh": ""
        },
        {
            "location": "515/ACT",
            "narrator": "",
            "text": "もしかしてリアルに？",
            "zh": "该不会是现实中？",
            "narrator_zh": ""
        },
        {
            "location": "516/ACT",
            "narrator": "",
            "text": "物理的な話として？",
            "zh": "是从物理层面来说？",
            "narrator_zh": ""
        },
        {
            "location": "533/TALK",
            "narrator": "みやび",
            "text": "おう",
            "zh": "哦",
            "narrator_zh": "雅"
        },
        {
            "location": "534/TALK",
            "narrator": "みやび",
            "text": "当然じゃ",
            "zh": "当然咯",
            "narrator_zh": "雅"
        },
        {
            "location": "535/TALK",
            "narrator": "みやび",
            "text": "ばかちんが",
            "zh": "你这个小笨蛋啊",
            "narrator_zh": "雅"
        },
        {
            "location": "537/SEL",
            "narrator": "",
            "text": "うれしいな",
            "zh": "好开心啊",
            "narrator_zh": ""
        },
        {
            "location": "538/SEL",
            "narrator": "",
            "text": "本当に大変なことになってるんだ",
            "zh": "事情真的变得好严重啊",
            "narrator_zh": ""
        },
        {
            "location": "539/SEL",
            "narrator": "",
            "text": "本気なんだよね？",
            "zh": "是认真的吧？",
            "narrator_zh": ""
        },
        {
            "location": "540/ACT",
            "narrator": "",
            "text": "うれしいな",
            "zh": "好开心啊",
            "narrator_zh": ""
        },
        {
            "location": "541/TALK",
            "narrator": "みやび",
            "text": "それは",
            "zh": "那样的话",
            "narrator_zh": "雅"
        },
        {
            "location": "542/TALK",
            "narrator": "みやび",
            "text": "よかった",
            "zh": "太好了",
            "narrator_zh": "雅"
        },
        {
            "location": "543/TALK",
            "narrator": "みやび",
            "text": "ホッとした",
            "zh": "我也松了口气",
            "narrator_zh": "雅"
        },
        {
            "location": "544/ACT",
            "narrator": "",
            "text": "本当に大変なことになってるんだ",
            "zh": "事情真的变得好严重啊",
            "narrator_zh": ""
        },
        {
            "location": "545/TALK",
            "narrator": "みやび",
            "text": "こらこら",
            "zh": "喂喂",
            "narrator_zh": "雅"
        },
        {
            "location": "546/TALK",
            "narrator": "みやび",
            "text": "ピンときてなかったのか",
            "zh": "原来你没反应过来啊",
            "narrator_zh": "雅"
        },
        {
            "location": "547/TALK",
            "narrator": "みやび",
            "text": "$handle$め",
            "zh": "$handle$这家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "548/ACT",
            "narrator": "",
            "text": "本気なんだよね？",
            "zh": "是认真的吧？",
            "narrator_zh": ""
        },
        {
            "location": "549/TALK",
            "narrator": "みやび",
            "text": "嘘でこんなことを言えるのは",
            "zh": "能把这种话当谎话说出口的",
            "narrator_zh": "雅"
        },
        {
            "location": "550/TALK",
            "narrator": "みやび",
            "text": "結婚詐欺師か",
            "zh": "只有结婚诈骗犯",
            "narrator_zh": "雅"
        },
        {
            "location": "551/TALK",
            "narrator": "みやび",
            "text": "乙女ゲーのヒーローしかおらん",
            "zh": "和乙女游戏的男主角了咧",
            "narrator_zh": "雅"
        },
        {
            "location": "553/TALK",
            "narrator": "みやび",
            "text": "というわけで",
            "zh": "所以说",
            "narrator_zh": "雅"
        },
        {
            "location": "554/TALK",
            "narrator": "みやび",
            "text": "第一希望は",
            "zh": "第一愿望是",
            "narrator_zh": "雅"
        },
        {
            "location": "555/TALK",
            "narrator": "みやび",
            "text": "相棒とここに戻ってくる、だが",
            "zh": "和搭档一起回到这里，不过",
            "narrator_zh": "雅"
        },
        {
            "location": "556/TALK",
            "narrator": "みやび",
            "text": "それより確率の高い話をしたい",
            "zh": "我更想先聊聊可能性高的那个",
            "narrator_zh": "雅"
        },
        {
            "location": "558/SEL",
            "narrator": "",
            "text": "何？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "559/SEL",
            "narrator": "",
            "text": "聞きたくない話のような",
            "zh": "感觉是不想听的话",
            "narrator_zh": ""
        },
        {
            "location": "560/SEL",
            "narrator": "",
            "text": "何でも言って！",
            "zh": "什么都说出来吧！",
            "narrator_zh": ""
        },
        {
            "location": "561/ACT",
            "narrator": "",
            "text": "何？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "562/TALK",
            "narrator": "みやび",
            "text": "ええと",
            "zh": "那个……",
            "narrator_zh": "雅"
        },
        {
            "location": "563/ACT",
            "narrator": "",
            "text": "聞きたくない話のような",
            "zh": "感觉是不想听的话",
            "narrator_zh": ""
        },
        {
            "location": "564/TALK",
            "narrator": "みやび",
            "text": "かもしれん",
            "zh": "说不定咯",
            "narrator_zh": "雅"
        },
        {
            "location": "565/ACT",
            "narrator": "",
            "text": "何でも言って！",
            "zh": "什么都说出来吧！",
            "narrator_zh": ""
        },
        {
            "location": "566/TALK",
            "narrator": "みやび",
            "text": "これは頼もしい",
            "zh": "这可真靠得住",
            "narrator_zh": "雅"
        },
        {
            "location": "568/TALK",
            "narrator": "みやび",
            "text": "うちが亡き後は",
            "zh": "等我死之后，",
            "narrator_zh": "雅"
        },
        {
            "location": "569/TALK",
            "narrator": "みやび",
            "text": "この部屋の権利を",
            "zh": "这个房间的权益",
            "narrator_zh": "雅"
        },
        {
            "location": "570/TALK",
            "narrator": "みやび",
            "text": "$handle$に譲る",
            "zh": "就转让给$handle$",
            "narrator_zh": "雅"
        },
        {
            "location": "571/TALK",
            "narrator": "みやび",
            "text": "やき",
            "zh": "就这样嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "572/TALK",
            "narrator": "みやび",
            "text": "この部屋に残したデータは",
            "zh": "在这个房间留下的数据",
            "narrator_zh": "雅"
        },
        {
            "location": "573/TALK",
            "narrator": "みやび",
            "text": "全部消してくれ",
            "zh": "全都帮我删掉",
            "narrator_zh": "雅"
        },
        {
            "location": "574/TALK",
            "narrator": "みやび",
            "text": "絶対に",
            "zh": "绝对要",
            "narrator_zh": "雅"
        },
        {
            "location": "576/SEL",
            "narrator": "",
            "text": "了解",
            "zh": "收到",
            "narrator_zh": ""
        },
        {
            "location": "577/SEL",
            "narrator": "",
            "text": "そんなことにならないよね？",
            "zh": "不会走到那一步的吧？",
            "narrator_zh": ""
        },
        {
            "location": "578/SEL",
            "narrator": "",
            "text": "気が向いたらね",
            "zh": "看我心情咯",
            "narrator_zh": ""
        },
        {
            "location": "579/ACT",
            "narrator": "",
            "text": "了解",
            "zh": "收到",
            "narrator_zh": ""
        },
        {
            "location": "580/TALK",
            "narrator": "みやび",
            "text": "感謝する",
            "zh": "多谢了",
            "narrator_zh": "雅"
        },
        {
            "location": "581/ACT",
            "narrator": "",
            "text": "そんなことにならないよね？",
            "zh": "不会走到那一步的吧？",
            "narrator_zh": ""
        },
        {
            "location": "582/TALK",
            "narrator": "みやび",
            "text": "ならよいが",
            "zh": "不那样最好",
            "narrator_zh": "雅"
        },
        {
            "location": "583/ACT",
            "narrator": "",
            "text": "気が向いたらね",
            "zh": "看我心情咯",
            "narrator_zh": ""
        },
        {
            "location": "584/TALK",
            "narrator": "みやび",
            "text": "適当なやつめ",
            "zh": "这家伙真敷衍啊",
            "narrator_zh": "雅"
        },
        {
            "location": "587/SEL",
            "narrator": "",
            "text": "それはそれとして",
            "zh": "那是另外一回事",
            "narrator_zh": ""
        },
        {
            "location": "588/ACT",
            "narrator": "",
            "text": "それはそれとして",
            "zh": "那是另外一回事",
            "narrator_zh": ""
        },
        {
            "location": "589/TALK",
            "narrator": "みやび",
            "text": "うむ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "592/SEL",
            "narrator": "",
            "text": "つばめが大変なことに",
            "zh": "燕出大事了",
            "narrator_zh": ""
        },
        {
            "location": "593/SEL",
            "narrator": "",
            "text": "つばめ逃げ遅れたみたい",
            "zh": "燕好像没能逃掉",
            "narrator_zh": ""
        },
        {
            "location": "594/SEL",
            "narrator": "",
            "text": "今一番危機にあるのはつばめ",
            "zh": "现在最危急的是燕",
            "narrator_zh": ""
        },
        {
            "location": "595/ACT",
            "narrator": "",
            "text": "データって$me$のセクシーショット？",
            "zh": "数据是指$me$的性感照吗？",
            "narrator_zh": ""
        },
        {
            "location": "596/TALK",
            "narrator": "みやび",
            "text": "なんでだ！",
            "zh": "你想驷马呢！",
            "narrator_zh": "雅"
        },
        {
            "location": "599/ACT",
            "narrator": "",
            "text": "$me$の隠し撮り画像なんでしょ、データって",
            "zh": "所谓数据，就是$me$的偷拍照吧",
            "narrator_zh": ""
        },
        {
            "location": "600/TALK",
            "narrator": "みやび",
            "text": "どうやって！",
            "zh": "你是怎么搞到手的！",
            "narrator_zh": "雅"
        },
        {
            "location": "603/ACT",
            "narrator": "",
            "text": "$me$への恋文なら全世界にアーカイブしよう",
            "zh": "要是写给$me$的情书，那我就帮你归档给全世界",
            "narrator_zh": ""
        },
        {
            "location": "604/TALK",
            "narrator": "みやび",
            "text": "ないわーマジでないわー",
            "zh": "没得哇，真的没得哇——",
            "narrator_zh": "雅"
        },
        {
            "location": "608/TALK",
            "narrator": "みやび",
            "text": "本当に",
            "zh": "真是的，",
            "narrator_zh": "雅"
        },
        {
            "location": "609/TALK",
            "narrator": "みやび",
            "text": "$handle$はどこまでも$handle$",
            "zh": "$handle$到哪里都是$handle$",
            "narrator_zh": "雅"
        },
        {
            "location": "610/TALK",
            "narrator": "みやび",
            "text": "しかしそのおかげで",
            "zh": "不过托这个的福，",
            "narrator_zh": "雅"
        },
        {
            "location": "611/TALK",
            "narrator": "みやび",
            "text": "少し元気が出た",
            "zh": "精神稍微回来了点",
            "narrator_zh": "雅"
        },
        {
            "location": "626/TALK",
            "narrator": "みやび",
            "text": "お。",
            "zh": "哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "627/TALK",
            "narrator": "みやび",
            "text": "お迎えが来たぞね。",
            "zh": "来接我的到了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "650/TALK",
            "narrator": "アーヤ",
            "text": "みやび！",
            "zh": "雅！",
            "narrator_zh": "绫水"
        },
        {
            "location": "652/TALK",
            "narrator": "みやび",
            "text": "待たせて\nすまんかったぞね。",
            "zh": "让你们久等了，\n没好意思咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "653/TALK",
            "narrator": "アーヤ",
            "text": "大丈夫？\n忘れ物ない？",
            "zh": "没事吧？\n没落下东西吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "654/TALK",
            "narrator": "みやび",
            "text": "もうえいよ。\n忘れ物は全部\n回収したきね。",
            "zh": "都得咯。\n忘掉的东西全部\n回收完啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "656/TALK",
            "narrator": "みやび",
            "text": "物理的なんも、\n精神的なんも…。",
            "zh": "物理上的也好，\n精神上的也好……。",
            "narrator_zh": "雅"
        },
        {
            "location": "667/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【MV EXE_KAGURa】",
            "zh": "【MV EXE_KAGURa】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
