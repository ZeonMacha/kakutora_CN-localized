{
    "dir": "dramatics/daydra/drm_ch01_00_810.js",
    "type": "Episode",
    "info": {
        "story_id": "1081",
        "cid": "tsubame",
        "title": "らぶとーく 第82話",
        "sub_title": "特別な人へ感謝を込めて",
        "title_zh": "恋爱漫谈 第82话",
        "sub_title_zh": "向特别的人致以感谢"
    },
    "entry": [
        {
            "location": "320/TALK",
            "narrator": "つばめ",
            "text": "でね。式には\nお父さんを\n呼びたいの。",
            "zh": "然后呢。婚礼上\n我想请\n爸爸来。",
            "narrator_zh": "燕"
        },
        {
            "location": "321/SEL",
            "narrator": "",
            "text": "え",
            "zh": "诶",
            "narrator_zh": ""
        },
        {
            "location": "322/SEL",
            "narrator": "",
            "text": "ちょっと待って！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "323/SEL",
            "narrator": "",
            "text": "本気で言ってる？",
            "zh": "你是认真的？",
            "narrator_zh": ""
        },
        {
            "location": "324/ACT",
            "narrator": "",
            "text": "え",
            "zh": "诶",
            "narrator_zh": ""
        },
        {
            "location": "325/TALK",
            "narrator": "つばめ",
            "text": "あれ？",
            "zh": "咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "326/ACT",
            "narrator": "",
            "text": "ちょっと待って！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "327/TALK",
            "narrator": "つばめ",
            "text": "うん。\n準備とかあるもんね。",
            "zh": "嗯。\n毕竟还要做准备嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "328/ACT",
            "narrator": "",
            "text": "本気で言ってる？",
            "zh": "你是认真的？",
            "narrator_zh": ""
        },
        {
            "location": "329/TALK",
            "narrator": "つばめ",
            "text": "えと\n本気だよ？",
            "zh": "那个\n我是认真的哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "331/TALK",
            "narrator": "つばめ",
            "text": "前にちょっと\n言ったよね？",
            "zh": "之前稍微\n提过对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "332/SEL",
            "narrator": "",
            "text": "そうだった",
            "zh": "对哦",
            "narrator_zh": ""
        },
        {
            "location": "333/SEL",
            "narrator": "",
            "text": "聞いたけど",
            "zh": "我听说了",
            "narrator_zh": ""
        },
        {
            "location": "334/SEL",
            "narrator": "",
            "text": "本気だったんだ",
            "zh": "原来是认真的啊",
            "narrator_zh": ""
        },
        {
            "location": "335/ACT",
            "narrator": "",
            "text": "そうだった",
            "zh": "对哦",
            "narrator_zh": ""
        },
        {
            "location": "336/TALK",
            "narrator": "つばめ",
            "text": "ね？",
            "zh": "对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "337/ACT",
            "narrator": "",
            "text": "聞いたけど",
            "zh": "我听说了",
            "narrator_zh": ""
        },
        {
            "location": "338/TALK",
            "narrator": "つばめ",
            "text": "言ったもん。",
            "zh": "我说了嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "339/ACT",
            "narrator": "",
            "text": "本気だったんだ",
            "zh": "原来是认真的啊",
            "narrator_zh": ""
        },
        {
            "location": "340/TALK",
            "narrator": "つばめ",
            "text": "そうだよ？",
            "zh": "是吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "342/SEL",
            "narrator": "",
            "text": "あー…",
            "zh": "啊……",
            "narrator_zh": ""
        },
        {
            "location": "343/SEL",
            "narrator": "",
            "text": "対策しないと",
            "zh": "不做防护可不行",
            "narrator_zh": ""
        },
        {
            "location": "344/SEL",
            "narrator": "",
            "text": "ハードル高いなー！",
            "zh": "门槛好高啊——！",
            "narrator_zh": ""
        },
        {
            "location": "345/ACT",
            "narrator": "",
            "text": "あー…",
            "zh": "啊……",
            "narrator_zh": ""
        },
        {
            "location": "346/TALK",
            "narrator": "つばめ",
            "text": "あれ？",
            "zh": "咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "347/ACT",
            "narrator": "",
            "text": "対策しないと",
            "zh": "不做防护可不行",
            "narrator_zh": ""
        },
        {
            "location": "348/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "349/ACT",
            "narrator": "",
            "text": "ハードル高いなー！",
            "zh": "门槛好高啊——！",
            "narrator_zh": ""
        },
        {
            "location": "350/TALK",
            "narrator": "つばめ",
            "text": "そうかも……。",
            "zh": "也许……。",
            "narrator_zh": "燕"
        },
        {
            "location": "353/TALK",
            "narrator": "つばめ",
            "text": "えとね……。",
            "zh": "那个啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "354/TALK",
            "narrator": "つばめ",
            "text": "スマホも返してくれたし\n話していいって\n言ってくれたし。",
            "zh": "手机也还给我了，\n也同意让我们\n说话了。",
            "narrator_zh": "燕"
        },
        {
            "location": "355/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんの\nこと、嫌いじゃないと\n思うんだ。",
            "zh": "我觉得我\n并不讨厌\n$handle$。",
            "narrator_zh": "燕"
        },
        {
            "location": "356/TALK",
            "narrator": "つばめ",
            "text": "それにね。",
            "zh": "而且呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "357/TALK",
            "narrator": "つばめ",
            "text": "お父さんにちゃんと\nわかってもらいたい。",
            "zh": "我想让爸爸好好\n明白。",
            "narrator_zh": "燕"
        },
        {
            "location": "358/TALK",
            "narrator": "つばめ",
            "text": "わたしたちのこと。",
            "zh": "我们俩的事。",
            "narrator_zh": "燕"
        },
        {
            "location": "359/SEL",
            "narrator": "",
            "text": "そう言われたら…",
            "zh": "被你这么一说…",
            "narrator_zh": ""
        },
        {
            "location": "360/SEL",
            "narrator": "",
            "text": "うーん…",
            "zh": "嗯——",
            "narrator_zh": ""
        },
        {
            "location": "361/SEL",
            "narrator": "",
            "text": "当たって砕けろか",
            "zh": "那就豁出去试试吧",
            "narrator_zh": ""
        },
        {
            "location": "362/ACT",
            "narrator": "",
            "text": "そう言われたら…",
            "zh": "被你这么一说…",
            "narrator_zh": ""
        },
        {
            "location": "364/TALK",
            "narrator": "つばめ",
            "text": "ちゃんと話せば\nわかってくれるよ。",
            "zh": "好好说的话\n他会明白的。",
            "narrator_zh": "燕"
        },
        {
            "location": "365/ACT",
            "narrator": "",
            "text": "うーん…",
            "zh": "嗯——",
            "narrator_zh": ""
        },
        {
            "location": "367/TALK",
            "narrator": "つばめ",
            "text": "大丈夫だよ。\nきっと。",
            "zh": "没事的啦。\n肯定没问题。",
            "narrator_zh": "燕"
        },
        {
            "location": "368/ACT",
            "narrator": "",
            "text": "当たって砕けろか",
            "zh": "那就豁出去试试吧",
            "narrator_zh": ""
        },
        {
            "location": "370/TALK",
            "narrator": "つばめ",
            "text": "ちょっと怖いけど\n暴力とかはないよ。",
            "zh": "有点可怕，\n但不会有暴力之类的哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "388/TALK",
            "narrator": "啓介",
            "text": "……………………\n……………………\n……………………。",
            "zh": "……………………\n……………………\n……………………。",
            "narrator_zh": "启介"
        },
        {
            "location": "389/TALK",
            "narrator": "つばめ",
            "text": "そういうわけで\n結婚式に\n出て欲しいんです。",
            "zh": "所以，\n希望你能出席\n婚礼。",
            "narrator_zh": "燕"
        },
        {
            "location": "390/TALK",
            "narrator": "啓介",
            "text": "……………………\n……………………\n……………………。",
            "zh": "……………………\n……………………\n……………………。",
            "narrator_zh": "启介"
        },
        {
            "location": "391/TALK",
            "narrator": "つばめ",
            "text": "準備とかは\n自分たちで\nちゃんとするから。",
            "zh": "准备之类的\n我们自己会\n好好弄好的。",
            "narrator_zh": "燕"
        },
        {
            "location": "392/TALK",
            "narrator": "啓介",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "启介"
        },
        {
            "location": "393/TALK",
            "narrator": "つばめ",
            "text": "お父さんの仕事が\n忙しくない時に\nするつもりだし。",
            "zh": "打算等爸爸工作\n不忙的时候\n再做。",
            "narrator_zh": "燕"
        },
        {
            "location": "394/TALK",
            "narrator": "啓介",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "启介"
        },
        {
            "location": "395/TALK",
            "narrator": "つばめ",
            "text": "お願い。",
            "zh": "拜托了。",
            "narrator_zh": "燕"
        },
        {
            "location": "396/TALK",
            "narrator": "啓介",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "启介"
        },
        {
            "location": "397/TALK",
            "narrator": "つばめ",
            "text": "あと何て言えば\nいいかな……。",
            "zh": "还要再说些\n什么好呢……。",
            "narrator_zh": "燕"
        },
        {
            "location": "398/TALK",
            "narrator": "啓介",
            "text": "相手と話を\nさせなさい。",
            "zh": "让我跟对方\n谈一谈。",
            "narrator_zh": "启介"
        },
        {
            "location": "399/TALK",
            "narrator": "つばめ",
            "text": "……え？",
            "zh": "……诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "400/TALK",
            "narrator": "啓介",
            "text": "$handle$と\nやらと二人きりで\n話がしたい。",
            "zh": "我想跟$handle$\n两个人单独\n聊聊。",
            "narrator_zh": "启介"
        },
        {
            "location": "401/TALK",
            "narrator": "つばめ",
            "text": "……うん。\nわかった。",
            "zh": "……嗯。\n我知道了。",
            "narrator_zh": "燕"
        },
        {
            "location": "407/TALK",
            "narrator": "啓介",
            "text": "あー……。",
            "zh": "呃……。",
            "narrator_zh": "启介"
        },
        {
            "location": "408/TALK",
            "narrator": "啓介",
            "text": "君は本気で\n言っているのか？",
            "zh": "你是认真的\n吗？",
            "narrator_zh": "启介"
        },
        {
            "location": "409/SEL",
            "narrator": "",
            "text": "本気です、お父さん",
            "zh": "我是认真的，爸爸",
            "narrator_zh": ""
        },
        {
            "location": "410/SEL",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "411/SEL",
            "narrator": "",
            "text": "今のところは",
            "zh": "就目前来说",
            "narrator_zh": ""
        },
        {
            "location": "412/ACT",
            "narrator": "",
            "text": "本気です、お父さん",
            "zh": "我是认真的，爸爸",
            "narrator_zh": ""
        },
        {
            "location": "413/TALK",
            "narrator": "啓介",
            "text": "お父さんと言われる\n謂われはない。",
            "zh": "没有理由\n被叫做父亲。",
            "narrator_zh": "启介"
        },
        {
            "location": "414/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "415/TALK",
            "narrator": "啓介",
            "text": "口では\n何とでも言える。",
            "zh": "嘴上说说\n谁都能说得好听。",
            "narrator_zh": "启介"
        },
        {
            "location": "416/ACT",
            "narrator": "",
            "text": "今のところは",
            "zh": "就目前来说",
            "narrator_zh": ""
        },
        {
            "location": "417/TALK",
            "narrator": "啓介",
            "text": "…ある意味正直だな。",
            "zh": "……某种意义上倒挺老实。",
            "narrator_zh": "启介"
        },
        {
            "location": "419/TALK",
            "narrator": "啓介",
            "text": "ならなぜ\nここに来ない。",
            "zh": "那为什么\n不来这里。",
            "narrator_zh": "启介"
        },
        {
            "location": "420/SEL",
            "narrator": "",
            "text": "無理だからです",
            "zh": "因为做不到",
            "narrator_zh": ""
        },
        {
            "location": "421/SEL",
            "narrator": "",
            "text": "できるものなら\n行きたいんですが",
            "zh": "能办到的话\n我倒想去",
            "narrator_zh": ""
        },
        {
            "location": "422/SEL",
            "narrator": "",
            "text": "行けるようになれば\n一番最初に伺います",
            "zh": "要是能去了\n我第一个去拜访",
            "narrator_zh": ""
        },
        {
            "location": "423/ACT",
            "narrator": "",
            "text": "無理だからです",
            "zh": "因为做不到",
            "narrator_zh": ""
        },
        {
            "location": "424/TALK",
            "narrator": "啓介",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "启介"
        },
        {
            "location": "425/ACT",
            "narrator": "",
            "text": "できるものなら\n行きたいんですが",
            "zh": "能办到的话\n我倒想去",
            "narrator_zh": ""
        },
        {
            "location": "426/TALK",
            "narrator": "啓介",
            "text": "要は無理だと。",
            "zh": "说到底就是办不到嘛。",
            "narrator_zh": "启介"
        },
        {
            "location": "427/ACT",
            "narrator": "",
            "text": "行けるようになれば\n一番最初に伺います",
            "zh": "要是能去了\n我第一个去拜访",
            "narrator_zh": ""
        },
        {
            "location": "428/TALK",
            "narrator": "啓介",
            "text": "…口だけは達者だな。",
            "zh": "……就是嘴皮子利索。",
            "narrator_zh": "启介"
        },
        {
            "location": "430/TALK",
            "narrator": "啓介",
            "text": "こうやって会話を\nする以外の方法が\nないという時点で。",
            "zh": "只能像这样\n对话这一点，\n本身就已经。",
            "narrator_zh": "启介"
        },
        {
            "location": "431/TALK",
            "narrator": "啓介",
            "text": "私は君を信用できない。",
            "zh": "我没法信任你。",
            "narrator_zh": "启介"
        },
        {
            "location": "432/TALK",
            "narrator": "啓介",
            "text": "うちの娘がごっこ遊びに\n夢中になっているだけと\nしか思えない。",
            "zh": "在我看来，不过是我家女儿\n一时沉迷在过家家游戏里\n罢了。",
            "narrator_zh": "启介"
        },
        {
            "location": "433/TALK",
            "narrator": "啓介",
            "text": "ここまでのめり込む前に\n禁止しておけばよかったと\n思っているくらいだ。",
            "zh": "我甚至觉得，该在陷这么深之前\n就禁止的\n才对呢。",
            "narrator_zh": "启介"
        },
        {
            "location": "434/SEL",
            "narrator": "",
            "text": "そんな",
            "zh": "那种",
            "narrator_zh": ""
        },
        {
            "location": "435/SEL",
            "narrator": "",
            "text": "$me$は本気です",
            "zh": "$me$是认真的",
            "narrator_zh": ""
        },
        {
            "location": "436/SEL",
            "narrator": "",
            "text": "認めては\nもらえないんでしょうか",
            "zh": "就不能\n得到认可吗",
            "narrator_zh": ""
        },
        {
            "location": "437/ACT",
            "narrator": "",
            "text": "そんな",
            "zh": "那种",
            "narrator_zh": ""
        },
        {
            "location": "438/TALK",
            "narrator": "啓介",
            "text": "当然だろう。",
            "zh": "那不是当然的吗。",
            "narrator_zh": "启介"
        },
        {
            "location": "439/ACT",
            "narrator": "",
            "text": "$me$は本気です",
            "zh": "$me$是认真的",
            "narrator_zh": ""
        },
        {
            "location": "440/TALK",
            "narrator": "啓介",
            "text": "立場が逆でも\n同じことが\n言えるか？",
            "zh": "要是立场互换，\n你还能说出\n同样的话吗？",
            "narrator_zh": "启介"
        },
        {
            "location": "441/ACT",
            "narrator": "",
            "text": "認めては\nもらえないんでしょうか",
            "zh": "就不能\n得到认可吗",
            "narrator_zh": ""
        },
        {
            "location": "442/TALK",
            "narrator": "啓介",
            "text": "それ以前の問題だ。",
            "zh": "那是更根本的问题。",
            "narrator_zh": "启介"
        },
        {
            "location": "444/TALK",
            "narrator": "啓介",
            "text": "しかし、だ。",
            "zh": "不过，话说回来。",
            "narrator_zh": "启介"
        },
        {
            "location": "445/TALK",
            "narrator": "啓介",
            "text": "娘が言う結婚式と\nやらには出席する。",
            "zh": "我女儿说的那个什么\n婚礼，我会出席。",
            "narrator_zh": "启介"
        },
        {
            "location": "446/SEL",
            "narrator": "",
            "text": "ありがとうございます！",
            "zh": "谢谢你！",
            "narrator_zh": ""
        },
        {
            "location": "447/SEL",
            "narrator": "",
            "text": "本当ですか？",
            "zh": "真的吗？",
            "narrator_zh": ""
        },
        {
            "location": "448/SEL",
            "narrator": "",
            "text": "ツンデレなんだからもー！",
            "zh": "都傲娇了，真是的！",
            "narrator_zh": ""
        },
        {
            "location": "449/ACT",
            "narrator": "",
            "text": "ありがとうございます！",
            "zh": "谢谢你！",
            "narrator_zh": ""
        },
        {
            "location": "450/TALK",
            "narrator": "啓介",
            "text": "君に礼を言われる\n筋合いはない。",
            "zh": "轮不到你来\n向我道谢。",
