{
    "dir": "chap11/daydra/dd_ch01_11_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "11105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "親離れ子離れ＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "父母放手，孩子离巢＜后篇＞"
    },
    "entry": [
        {
            "location": "579/SCENARIO",
            "narrator": "",
            "text": "親離れ子離れ",
            "zh": "父母放手，孩子离巢",
            "narrator_zh": ""
        },
        {
            "location": "606/TALK",
            "narrator": "つばめ",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": "燕"
        },
        {
            "location": "607/TALK",
            "narrator": "つばめ",
            "text": "本当は",
            "zh": "其实",
            "narrator_zh": "燕"
        },
        {
            "location": "608/TALK",
            "narrator": "つばめ",
            "text": "帰れたの",
            "zh": "能回去的",
            "narrator_zh": "燕"
        },
        {
            "location": "609/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "燕"
        },
        {
            "location": "610/TALK",
            "narrator": "つばめ",
            "text": "面倒くさくなっちゃって",
            "zh": "嫌起麻烦来了",
            "narrator_zh": "燕"
        },
        {
            "location": "612/SEL",
            "narrator": "",
            "text": "正直に言わなきゃ",
            "zh": "得老实说",
            "narrator_zh": ""
        },
        {
            "location": "613/ACT",
            "narrator": "",
            "text": "正直に言わなきゃ",
            "zh": "得老实说",
            "narrator_zh": ""
        },
        {
            "location": "615/TALK",
            "narrator": "つばめ",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "616/TALK",
            "narrator": "つばめ",
            "text": "ちゃんと",
            "zh": "好好",
            "narrator_zh": "燕"
        },
        {
            "location": "617/TALK",
            "narrator": "つばめ",
            "text": "お父さんに話すよ",
            "zh": "跟爸爸说",
            "narrator_zh": "燕"
        },
        {
            "location": "629/TALK",
            "narrator": "つばめ",
            "text": "はぁ…。",
            "zh": "哈啊……",
            "narrator_zh": "燕"
        },
        {
            "location": "631/TALK",
            "narrator": "啓介",
            "text": "…話は終わったのか？",
            "zh": "……话说完了吗？",
            "narrator_zh": "启介"
        },
        {
            "location": "634/TALK",
            "narrator": "つばめ",
            "text": "えっ！？　あ、ああ、\nえっと…。",
            "zh": "欸！？　啊，啊，\n那个……",
            "narrator_zh": "燕"
        },
        {
            "location": "635/TALK",
            "narrator": "つばめ",
            "text": "いけない…。\nスマホ弄ってるの\n見られちゃった…。",
            "zh": "糟了……\n摆弄手机\n被看见了……",
            "narrator_zh": "燕"
        },
        {
            "location": "637/TALK",
            "narrator": "啓介",
            "text": "…まあいい。\nこっちも、大体の話は\n終わったところだ。",
            "zh": "……算了。\n我这边话也\n大致说完了。",
            "narrator_zh": "启介"
        },
        {
            "location": "638/TALK",
            "narrator": "真幌",
            "text": "逢瀬隊員。\n劇場の仕事は\nもういいので――",
            "zh": "逢濑队员。\n剧场的工作\n到此为止——",
            "narrator_zh": "真幌"
        },
        {
            "location": "639/TALK",
            "narrator": "真幌",
            "text": "今日はお父上と\n帰宅しなさい。",
            "zh": "今天和令尊\n一起回去吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "641/TALK",
            "narrator": "つばめ",
            "text": "えっ！？\n帰宅って…。",
            "zh": "欸！？\n回家是……",
            "narrator_zh": "燕"
        },
        {
            "location": "642/TALK",
            "narrator": "真幌",
            "text": "もちろん、寮です。",
            "zh": "当然，是回宿舍。",
            "narrator_zh": "真幌"
        },
        {
            "location": "643/TALK",
            "narrator": "つばめ",
            "text": "…わかりました。\n失礼します。",
            "zh": "……我知道了。\n我先告辞。",
            "narrator_zh": "燕"
        },
        {
            "location": "648/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "649/TALK",
            "narrator": "真幌",
            "text": "はぁぁぁぁぁぁ～…。",
            "zh": "哈啊啊啊啊啊啊～……",
            "narrator_zh": "真幌"
        },
        {
            "location": "650/TALK",
            "narrator": "真幌",
            "text": "…一応の説得は\n出来たと思うが――",
            "zh": "……说服算是\n做到了——",
            "narrator_zh": "真幌"
        },
        {
            "location": "651/TALK",
            "narrator": "真幌",
            "text": "あのオヤジ…、\n大人しく帰って\nくれるだろうか？",
            "zh": "那个大叔……\n会乖乖\n回去吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "670/TALK",
            "narrator": "つばめ",
            "text": "…そうだ。\n帰らなかったこと、\nちゃんと謝らなきゃ。",
            "zh": "……对了。\n没回去这件事，\n得好好道歉。",
            "narrator_zh": "燕"
        },
        {
            "location": "671/TALK",
            "narrator": "つばめ",
            "text": "でも…。",
            "zh": "可是……",
            "narrator_zh": "燕"
        },
        {
            "location": "672/TALK",
            "narrator": "啓介",
            "text": "ふん…部屋は\nいいものが支給されて\nいるんだな。",
            "zh": "哼……房间\n配了不错的东西\n啊。",
            "narrator_zh": "启介"
        },
        {
            "location": "673/TALK",
            "narrator": "つばめ",
            "text": "う、うん…。",
            "zh": "嗯、嗯……",
            "narrator_zh": "燕"
        },
        {
            "location": "674/TALK",
            "narrator": "つばめ",
            "text": "…正直に言ったら、\n怒られちゃう、かな？",
            "zh": "……要是老实说，\n会被骂吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "675/SEL",
            "narrator": "",
            "text": "頑張れ！",
            "zh": "加油！",
            "narrator_zh": ""
        },
        {
            "location": "676/ACT",
            "narrator": "",
            "text": "頑張れ！",
            "zh": "加油！",
            "narrator_zh": ""
        },
        {
            "location": "693/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "燕"
        },
        {
            "location": "694/TALK",
            "narrator": "つばめ",
            "text": "怖いよ",
            "zh": "害怕呀",
            "narrator_zh": "燕"
        },
        {
            "location": "696/SEL",
            "narrator": "",
            "text": "$me$が付いてる",
            "zh": "有$me$在",
            "narrator_zh": ""
        },
        {
            "location": "697/ACT",
            "narrator": "",
            "text": "$me$が付いてる",
            "zh": "有$me$在",
            "narrator_zh": ""
        },
        {
            "location": "700/TALK",
            "narrator": "つばめ",
            "text": "ありがと",
            "zh": "谢谢",
            "narrator_zh": "燕"
        },
        {
            "location": "702/TALK",
            "narrator": "つばめ",
            "text": "わたし",
            "zh": "我",
            "narrator_zh": "燕"
        },
        {
            "location": "703/TALK",
            "narrator": "つばめ",
            "text": "頑張ってみる！",
            "zh": "我会加油的！",
            "narrator_zh": "燕"
        },
        {
            "location": "715/TALK",
            "narrator": "つばめ",
            "text": "…あ、あの、\nお父さん…。",
            "zh": "……啊、那个，\n爸爸……",
            "narrator_zh": "燕"
        },
        {
            "location": "717/TALK",
            "narrator": "啓介",
            "text": "なんだ？",
            "zh": "什么事？",
            "narrator_zh": "启介"
        },
        {
            "location": "718/TALK",
            "narrator": "つばめ",
            "text": "わ、わたし…、\nわたしね――",
            "zh": "我、我……\n我呀——",
            "narrator_zh": "燕"
        },
        {
            "location": "719/TALK",
            "narrator": "つばめ",
            "text": "一つ、訂正しないと\nいけないことが\nあるんだけど…。",
            "zh": "有一件，必须\n订正的事\n……",
            "narrator_zh": "燕"
        },
        {
            "location": "720/TALK",
            "narrator": "啓介",
            "text": "…言ってみろ。",
            "zh": "……说来听听。",
            "narrator_zh": "启介"
        },
        {
            "location": "721/TALK",
            "narrator": "つばめ",
            "text": "あの、帰らなかった\n理由なんだけど――",
            "zh": "那个，没回去的\n理由——",
            "narrator_zh": "燕"
        },
        {
            "location": "722/TALK",
            "narrator": "つばめ",
            "text": "別に、帰ろうと思えば\n普通に帰れたの。",
            "zh": "其实，想回的话\n平常就能回去。",
            "narrator_zh": "燕"
        },
        {
            "location": "723/TALK",
            "narrator": "つばめ",
            "text": "だけど、わたしが\nちょっとダメな\n感じで――",
            "zh": "可是，我有点\n不中用\n——",
            "narrator_zh": "燕"
        },
        {
            "location": "725/TALK",
            "narrator": "つばめ",
            "text": "先延ばしにしちゃった\nだけで…。",
            "zh": "只是拖延了\n而已……",
            "narrator_zh": "燕"
        },
        {
            "location": "726/TALK",
            "narrator": "啓介",
            "text": "…そうか。",
            "zh": "……这样啊。",
            "narrator_zh": "启介"
        },
        {
            "location": "727/TALK",
            "narrator": "つばめ",
            "text": "う、うん…。\n怒らないの？",
            "zh": "嗯、嗯……\n你不生气吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "728/TALK",
            "narrator": "啓介",
            "text": "今更。",
            "zh": "事到如今。",
            "narrator_zh": "启介"
        },
        {
            "location": "729/TALK",
            "narrator": "啓介",
            "text": "どうせそんなこと\nだろうと思っていた\nからな。",
            "zh": "我反正猜\n就是\n这么回事。",
            "narrator_zh": "启介"
        },
        {
            "location": "730/TALK",
            "narrator": "つばめ",
            "text": "えっ！？\n気付いてたの？",
            "zh": "欸！？\n你发现了？",
            "narrator_zh": "燕"
        },
        {
            "location": "731/TALK",
            "narrator": "啓介",
            "text": "いつものこと\nだからな。",
            "zh": "你一直\n都这样。",
            "narrator_zh": "启介"
        },
        {
            "location": "733/TALK",
            "narrator": "つばめ",
            "text": "あ、あはは…、\nそっかぁ…。",
            "zh": "啊、啊哈哈……\n这样啊……",
            "narrator_zh": "燕"
        },
        {
            "location": "734/TALK",
            "narrator": "つばめ",
            "text": "…お父さんには、\n隠し事できないなぁ。",
            "zh": "……对爸爸，\n瞒不住呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "736/TALK",
            "narrator": "啓介",
            "text": "…それより――",
            "zh": "……比起那个——",
            "narrator_zh": "启介"
        },
        {
            "location": "737/TALK",
            "narrator": "啓介",
            "text": "こっちでは、\n上手くやってるのか？",
            "zh": "在这边，\n过得还好吗？",
            "narrator_zh": "启介"
        },
        {
            "location": "739/TALK",
            "narrator": "つばめ",
            "text": "…うん。\nとっても楽しいよ。",
            "zh": "……嗯。\n非常开心哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "740/TALK",
            "narrator": "つばめ",
            "text": "クラスにも、トライナ\nリーにも、お友達が\nできたし。",
            "zh": "班上也有，\n三重奏里也有，\n朋友都交到了。",
            "narrator_zh": "燕"
        },
        {
            "location": "741/TALK",
            "narrator": "啓介",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "启介"
        },
        {
            "location": "742/TALK",
            "narrator": "啓介",
            "text": "怪我したりは\nしてないんだろうな？",
            "zh": "没受伤\n吧？",
            "narrator_zh": "启介"
        },
        {
            "location": "743/TALK",
            "narrator": "つばめ",
            "text": "うん、大丈夫。",
            "zh": "嗯，没事。",
            "narrator_zh": "燕"
        },
        {
            "location": "744/TALK",
            "narrator": "つばめ",
            "text": "トライナリーに\nなると\n無敵なんだよ？",
            "zh": "成为三重奏\n之后\n就会无敌的哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "745/TALK",
            "narrator": "つばめ",
            "text": "変身すれば空だって\n飛べるし――",
            "zh": "变身的话，天空\n也能飞——",
            "narrator_zh": "燕"
        },
        {
            "location": "746/TALK",
            "narrator": "つばめ",
            "text": "鉄よりも硬くなったり\nできるの。",
            "zh": "还能变得\n比铁更硬。",
            "narrator_zh": "燕"
        },
        {
            "location": "747/TALK",
            "narrator": "啓介",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "启介"
        },
        {
            "location": "748/TALK",
            "narrator": "つばめ",
            "text": "…なんか、嬉しいな。",
            "zh": "……总觉得，好开心呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "749/TALK",
            "narrator": "つばめ",
            "text": "お父さんが、こんなに\n色んなこと聞いてくる\nなんて…。",
            "zh": "爸爸问了\n这么多事\n……",
            "narrator_zh": "燕"
        },
        {
            "location": "750/TALK",
            "narrator": "つばめ",
            "text": "…それだけ、\n心配させちゃってた\nってことだよね…。",
            "zh": "……就是说，\n让你担心了\n吧……",
            "narrator_zh": "燕"
        },
        {
            "location": "751/TALK",
            "narrator": "つばめ",
            "text": "…あの、お父さん。\nお母さんは…どう？",
            "zh": "……那个，爸爸。\n妈妈……怎么样？",
            "narrator_zh": "燕"
        },
        {
            "location": "752/TALK",
            "narrator": "啓介",
            "text": "…今月から名古屋の\n先進医療病院に\n変わったもんでな。",
            "zh": "……这个月\n转到名古屋的\n先进医疗医院了。",
            "narrator_zh": "启介"
        },
        {
            "location": "753/TALK",
            "narrator": "啓介",
            "text": "それから\nだいぶ楽に\nなったようだ。",
            "zh": "从那以后\n好像轻松了\n不少。",
            "narrator_zh": "启介"
        },
        {
            "location": "754/TALK",
            "narrator": "つばめ",
            "text": "そっか…よかった。",
            "zh": "这样啊……太好了。",
            "narrator_zh": "燕"
        },
        {
            "location": "755/TALK",
            "narrator": "啓介",
            "text": "おまえのこと、\n心配してたぞ。",
            "zh": "她担心\n你呢。",
            "narrator_zh": "启介"
        },
        {
            "location": "756/TALK",
            "narrator": "啓介",
            "text": "東京で一人、\n不安にしてるんじゃ\nないか、ってな。",
            "zh": "说你一个人在东京，\n会不会\n不安。",
            "narrator_zh": "启介"
        },
        {
            "location": "758/TALK",
            "narrator": "つばめ",
            "text": "…ごめんなさい。\nお母さんにも、\n心配かけちゃって。",
            "zh": "……对不起。\n也让妈妈\n担心了。",
            "narrator_zh": "燕"
        },
        {
            "location": "760/TALK",
            "narrator": "啓介",
            "text": "…これからも、\nフェノメノン退治は\n続けるのか？",
            "zh": "……今后，\n消灭PhenoMENON\n还要继续吗？",
            "narrator_zh": "启介"
        },
        {
            "location": "761/TALK",
            "narrator": "つばめ",
            "text": "続けるよ。",
            "zh": "会继续哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "762/TALK",
            "narrator": "つばめ",
            "text": "わたしを必要として\nくれている人も\nいるし――",
            "zh": "也有人\n需要我\n——",
            "narrator_zh": "燕"
        },
        {
            "location": "763/TALK",
            "narrator": "つばめ",
            "text": "わたしも、護りたい\n大切な人が\n沢山できたから。",
            "zh": "我也有了很多\n想保护的\n重要的人。",
            "narrator_zh": "燕"
        },
        {
            "location": "764/TALK",
            "narrator": "つばめ",
            "text": "それに、ずっと病院に\nいたわたしを――",
            "zh": "而且，一直住院的\n我——",
            "narrator_zh": "燕"
        },
        {
            "location": "765/TALK",
            "narrator": "つばめ",
            "text": "沢山の借金して、\n先進医療を受けさせて\nもらったでしょ？",
            "zh": "你们借了很多钱，\n让我接受了\n先进医疗吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "766/TALK",
            "narrator": "つばめ",
            "text": "そのおかげで、\nこんなに元気にして\nもらったんだから――",
            "zh": "多亏那样，\n我才能这么\n有精神——",
            "narrator_zh": "燕"
        },
        {
            "location": "767/TALK",
            "narrator": "つばめ",
            "text": "今度は、わたしが\nみんなの喜ぶことを\nしたいんだ。",
            "zh": "所以这次，\n我想做让大家\n高兴的事。",
            "narrator_zh": "燕"
        },
        {
            "location": "768/TALK",
            "narrator": "つばめ",
            "text": "それに、お母さんにも\n今の病院で治療受けて\nもらって――",
            "zh": "而且，也想让妈妈\n在现在的医院\n接受治疗——",
            "narrator_zh": "燕"
        },
        {
            "location": "769/TALK",
            "narrator": "つばめ",
            "text": "元気になってほしい\nから…トライナリーは\n続けるよ。",
            "zh": "想让她好起来，\n所以三重奏\n我会继续哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "771/TALK",
            "narrator": "啓介",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "启介"
        },
        {
            "location": "772/TALK",
            "narrator": "つばめ",
            "text": "心配しないで。\nわたしは\n大丈夫だから！",
            "zh": "别担心。\n我\n没问题！",
            "narrator_zh": "燕"
        },
        {
            "location": "773/TALK",
            "narrator": "つばめ",
            "text": "わたしだって、\nもう子供じゃないん\nだから！",
            "zh": "我呀，\n已经不是\n小孩子了！",
            "narrator_zh": "燕"
        },
        {
            "location": "776/TALK",
            "narrator": "つばめ",
            "text": "バーン！",
            "zh": "砰！",
            "narrator_zh": "燕"
        },
        {
            "location": "777/TALK",
            "narrator": "啓介",
            "text": "？",
            "zh": "？",
            "narrator_zh": "启介"
        },
        {
            "location": "779/TALK",
            "narrator": "つばめ",
            "text": "ほら、胸だって\n結構あるんだから。\n知ってた？",
            "zh": "你看，胸口\n也挺有的。\n你知道吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "781/TALK",
            "narrator": "啓介",
            "text": "…そういうところが\n子供なんだ。",
            "zh": "……这种地方\n才是孩子。",
            "narrator_zh": "启介"
        },
        {
            "location": "784/TALK",
            "narrator": "つばめ",
            "text": "もぅ、ちょっとくらい\nドキドキしない？",
            "zh": "真是的，你就\n一点都不心跳吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "785/TALK",
            "narrator": "啓介",
            "text": "するか。",
            "zh": "怎么会。",
            "narrator_zh": "启介"
        },
        {
            "location": "787/TALK",
            "narrator": "つばめ",
            "text": "ちぇー、もういいよ。",
            "zh": "切——，算了。",
            "narrator_zh": "燕"
        },
        {
            "location": "788/TALK",
            "narrator": "啓介",
            "text": "…それより、\nそこに立ちなさい。",
            "zh": "……比起那个，\n站到那里去。",
            "narrator_zh": "启介"
        },
        {
            "location": "789/TALK",
            "narrator": "つばめ",
            "text": "え？　もしかして\n写真撮るの？",
            "zh": "欸？难道\n要拍照吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "790/TALK",
            "narrator": "啓介",
            "text": "ああ、\n母さんに見せる。",
            "zh": "啊，\n给妈妈看。",
            "narrator_zh": "启介"
        },
        {
            "location": "791/TALK",
            "narrator": "つばめ",
            "text": "あ、うん…。\nこのままでいい？",
            "zh": "啊，嗯……\n这样就行吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "792/TALK",
            "narrator": "啓介",
            "text": "ああ…写真はやめて\n動画にしよう。",
            "zh": "啊……照片算了，\n改成视频吧。",
            "narrator_zh": "启介"
        },
        {
            "location": "793/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nちょっと、そんな！",
            "zh": "诶！？\n等、怎么这样！",
            "narrator_zh": "燕"
        },
        {
            "location": "810/TALK",
            "narrator": "つばめ",
            "text": "え、えっと…。",
            "zh": "欸、那个……",
            "narrator_zh": "燕"
        },
        {
            "location": "812/TALK",
            "narrator": "つばめ",
            "text": "お、お母さーん、\nつばめだよ。\n調子はどうかな？",
            "zh": "妈——妈——，\n我是燕。\n身体怎么样？",
            "narrator_zh": "燕"
        },
        {
            "location": "813/TALK",
            "narrator": "つばめ",
            "text": "つばめは\n楽しくやってるよ。",
            "zh": "燕\n过得很开心哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "814/TALK",
            "narrator": "つばめ",
            "text": "でも、全然帰れなくて\nごめんね。",
            "zh": "可是，完全回不去，\n对不起。",
            "narrator_zh": "燕"
        },
        {
            "location": "816/TALK",
            "narrator": "つばめ",
            "text": "んと、こっちに来て\nいっぱいお友達も\nできました。",
            "zh": "那个，来了这边，\n也交到了好多\n朋友。",
            "narrator_zh": "燕"
        },
        {
            "location": "817/TALK",
            "narrator": "つばめ",
            "text": "任務は大変だけど、\n優しい先輩が護って\nくれるから――",
            "zh": "任务虽然辛苦，\n有温柔的前辈\n保护我——",
            "narrator_zh": "燕"
        },
        {
            "location": "818/TALK",
            "narrator": "つばめ",
            "text": "全然怖くないよ。",
            "zh": "一点都不害怕哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "820/TALK",
            "narrator": "つばめ",
            "text": "あーっ…えっと、\n近いうちに\n絶対帰るから――",
            "zh": "啊……那个，\n过不久\n我一定回去——",
            "narrator_zh": "燕"
        },
        {
            "location": "821/TALK",
            "narrator": "つばめ",
            "text": "もうちょっとだけ\n待っててね。",
            "zh": "再等我\n一小会儿。",
            "narrator_zh": "燕"
        },
        {
            "location": "822/TALK",
            "narrator": "つばめ",
            "text": "あまり無理しちゃ\nダメだよ？",
            "zh": "不要太\n勉强哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "824/TALK",
            "narrator": "つばめ",
            "text": "それじゃ、ね。\nばいばーい。",
            "zh": "那就，再见。\n拜拜。",
            "narrator_zh": "燕"
        },
        {
            "location": "841/TALK",
            "narrator": "啓介",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "启介"
        },
        {
            "location": "842/TALK",
            "narrator": "つばめ",
            "text": "お母さん、\n喜んでくれるかな？",
            "zh": "妈妈，\n会高兴吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "843/TALK",
            "narrator": "啓介",
            "text": "おまえが家に帰るのが\n一番喜ぶ。",
            "zh": "你回家，\n她才会最高兴。",
            "narrator_zh": "启介"
        },
        {
            "location": "845/TALK",
            "narrator": "つばめ",
            "text": "わ、わかってるよ…。",
            "zh": "我、我知道啦……",
            "narrator_zh": "燕"
        },
        {
            "location": "846/TALK",
            "narrator": "つばめ",
            "text": "…冗談抜きで、\n一度帰らないと\nいけないなぁ…。",
            "zh": "……不开玩笑，\n我得回去\n一趟呀……",
            "narrator_zh": "燕"
        },
        {
            "location": "847/TALK",
            "narrator": "つばめ",
            "text": "…それより、\n今日はこっちに\n泊まってくんでしょ？",
            "zh": "……比起那个，\n今天你会在这边\n住下吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "848/TALK",
            "narrator": "つばめ",
            "text": "それなら、わたしの\nベッドを使って――",
            "zh": "那样的话，用我的\n床——",
            "narrator_zh": "燕"
        },
        {
            "location": "850/TALK",
            "narrator": "啓介",
            "text": "バカ言え、できるか。",
            "zh": "说什么傻话，怎么可能。",
            "narrator_zh": "启介"
        },
        {
            "location": "851/TALK",
            "narrator": "啓介",
            "text": "近くに宿を取るから\n大丈夫だ。",
            "zh": "我在附近找住处，\n没事。",
            "narrator_zh": "启介"
        },
        {
            "location": "853/TALK",
            "narrator": "つばめ",
            "text": "…そっか。",
            "zh": "……这样啊。",
            "narrator_zh": "燕"
        },
        {
            "location": "854/TALK",
            "narrator": "啓介",
            "text": "…ちゃんと\n戸締りをしろよ。",
            "zh": "……给我\n好好锁门。",
            "narrator_zh": "启介"
        },
        {
            "location": "855/TALK",
            "narrator": "啓介",
            "text": "それと、父さんは\nまだ――",
            "zh": "还有，爸爸\n还——",
            "narrator_zh": "启介"
        },
        {
            "location": "856/TALK",
            "narrator": "啓介",
            "text": "フェノメノン退治を\n認めたわけじゃ\nないからな。",
            "zh": "消灭PhenoMENON\n这件事，我还\n没承认。",
            "narrator_zh": "启介"
        },
        {
            "location": "857/TALK",
            "narrator": "つばめ",
            "text": "わかってる\nわかってる。",
            "zh": "知道了\n知道了。",
            "narrator_zh": "燕"
        },
        {
            "location": "859/TALK",
            "narrator": "啓介",
            "text": "また連絡する。",
            "zh": "还会再联系。",
            "narrator_zh": "启介"
        },
        {
            "location": "861/TALK",
            "narrator": "つばめ",
            "text": "うん、バイバイ。\n来てくれて、\nありがとね。",
            "zh": "嗯，拜拜。\n你来了，\n谢谢呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "867/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "879/TALK",
            "narrator": "つばめ",
            "text": "お父さん",
            "zh": "爸爸",
            "narrator_zh": "燕"
        },
        {
            "location": "881/TALK",
            "narrator": "つばめ",
            "text": "わたしがウソついてたの",
            "zh": "我说谎的事",
            "narrator_zh": "燕"
        },
        {
            "location": "882/TALK",
            "narrator": "つばめ",
            "text": "最初から知ってたね",
            "zh": "一开始就知道吧",
            "narrator_zh": "燕"
        },
        {
            "location": "884/SEL",
            "narrator": "",
            "text": "つばめのこと、理解してるんだよ",
            "zh": "燕的事，他懂的",
            "narrator_zh": ""
        },
        {
            "location": "885/ACT",
            "narrator": "",
            "text": "つばめのこと、理解してるんだよ",
            "zh": "燕的事，他懂的",
            "narrator_zh": ""
        },
        {
            "location": "887/TALK",
            "narrator": "つばめ",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "888/TALK",
            "narrator": "つばめ",
            "text": "正直に言ってよかった",
            "zh": "老实说了真好",
            "narrator_zh": "燕"
        },
        {
            "location": "889/TALK",
            "narrator": "つばめ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "燕"
        },
        {
            "location": "890/TALK",
            "narrator": "つばめ",
            "text": "あのままウソついてたら",
            "zh": "要是一直那么说谎",
            "narrator_zh": "燕"
        },
        {
            "location": "891/TALK",
            "narrator": "つばめ",
            "text": "今頃",
            "zh": "现在",
            "narrator_zh": "燕"
        },
        {
            "location": "892/TALK",
            "narrator": "つばめ",
            "text": "きっとモヤモヤしてたと思うし",
            "zh": "心里一定发闷",
            "narrator_zh": "燕"
        },
        {
            "location": "894/SEL",
            "narrator": "",
            "text": "言えてよかったね",
            "zh": "能说出来真好",
            "narrator_zh": ""
        },
        {
            "location": "895/ACT",
            "narrator": "",
            "text": "言えてよかったね",
            "zh": "能说出来真好",
            "narrator_zh": ""
        },
        {
            "location": "897/TALK",
            "narrator": "つばめ",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "898/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんが",
            "zh": "$handle$",
            "narrator_zh": "燕"
        },
        {
            "location": "899/TALK",
            "narrator": "つばめ",
            "text": "正直に話すきっかけをくれたから",
            "zh": "给了我老实说的契机",
            "narrator_zh": "燕"
        },
        {
            "location": "900/TALK",
            "narrator": "つばめ",
            "text": "そのおかげだよ",
            "zh": "都是多亏这个呀",
            "narrator_zh": "燕"
        },
        {
            "location": "901/TALK",
            "narrator": "つばめ",
            "text": "ありがと、$handle$さん",
            "zh": "谢谢，$handle$",
            "narrator_zh": "燕"
        },
        {
            "location": "925/DIALOG",
            "narrator": "Dialog_chapter_ch01",
            "text": "【09 パーフェクトイエロー】",
            "zh": "【09 完美之黄】",
            "narrator_zh": "Dialog_chapter_ch01"
        }
    ]
}
