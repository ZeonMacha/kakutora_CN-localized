        "title": "明晰記憶喪失＜葛藤＞",
        "sub_title": "バトル中盤",
        "title_zh": "明确性记忆丧失＜纠葛＞",
        "sub_title_zh": "战斗中段"
    },
    "entry": [
        {
            "location": "196/SCENARIO",
            "narrator": "",
            "text": "バトル中盤",
            "zh": "战斗中段",
            "narrator_zh": ""
        },
        {
            "location": "205/TALK",
            "narrator": "潜在ガブリエラ",
            "text": "……強い。\nそんなはずは……",
            "zh": "……好强。\n怎么会……",
            "narrator_zh": "潜在加布里埃拉"
        },
        {
            "location": "206/TALK",
            "narrator": "潜在ガブリエラ",
            "text": "まさか、\nマルザンナ……いえ、\nえっと……",
            "zh": "难道说，\n玛尔赞娜……不对，\n那个……",
            "narrator_zh": "潜在加布里埃拉"
        },
        {
            "location": "207/SEL",
            "narrator": "",
            "text": "だから、$handle$です",
            "zh": "所以说，我是$handle$",
            "narrator_zh": ""
        },
        {
            "location": "208/ACT",
            "narrator": "",
            "text": "だから、$handle$です",
            "zh": "所以说，我是$handle$",
            "narrator_zh": ""
        },
        {
            "location": "210/TALK",
            "narrator": "潜在ガブリエラ",
            "text": "$handle$！\nあんたの力だって\nいうの！？",
            "zh": "$handle$！\n你说这是\n你的力量！？",
            "narrator_zh": "潜在加布里埃拉"
        },
        {
            "location": "211/TALK",
            "narrator": "表層ガブリエラ",
            "text": "悔しいけど、\nそれはあるかもね。",
            "zh": "虽然不甘心，\n但没准真有这回事。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "212/TALK",
            "narrator": "表層ガブリエラ",
            "text": "でも今はそんなこと\nどうでもいいの。",
            "zh": "不过现在那种事\n怎样都好。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "表層ガブリエラ",
            "text": "あたしはあんたを\n一秒でも早く倒す。",
            "zh": "我要尽快\n把你打倒，哪怕快一秒。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "214/TALK",
            "narrator": "表層ガブリエラ",
            "text": "そして、落ち着いて\n銃が撃てるように\nなるんだから！",
            "zh": "然后，就能心平气和地\n重新拿起枪\n射击了！",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "215/TALK",
            "narrator": "潜在ガブリエラ",
            "text": "させないんだから！",
            "zh": "休想得逞！",
            "narrator_zh": "潜在加布里埃拉"
        },
        {
            "location": "216/TALK",
            "narrator": "潜在ガブリエラ",
            "text": "次で絶対に\n倒してあげるわ！！",
            "zh": "下一次绝对\n要打倒你！！",
            "narrator_zh": "潜在加布里埃拉"
        }
    ]
}
