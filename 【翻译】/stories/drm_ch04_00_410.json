{
    "dir": "dramatics/daydra/drm_ch04_00_410.js",
    "type": "Episode",
    "info": {
        "story_id": "4041",
        "cid": "miyabi",
        "title": "らぶとーく 第42話",
        "sub_title": "答えはいくつある？",
        "title_zh": "恋爱漫谈 第42话",
        "sub_title_zh": "答案有几个？"
    },
    "entry": [
        {
            "location": "155/SCENARIO",
            "narrator": "",
            "text": "答えはいくつある？",
            "zh": "答案有几个？",
            "narrator_zh": ""
        },
        {
            "location": "169/TALK",
            "narrator": "みやび",
            "text": "ふぁ～…。",
            "zh": "哈啊……",
            "narrator_zh": "雅"
        },
        {
            "location": "171/TALK",
            "narrator": "つばめ",
            "text": "あ、みやびさん。\nおはようございます。",
            "zh": "啊，雅。\n早上好。",
            "narrator_zh": "燕"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "ん、おはよう。\nアーヤとガブちゃんもな。",
            "zh": "嗯，早啊。\n绫水和加布也早。",
            "narrator_zh": "雅"
        },
        {
            "location": "175/TALK",
            "narrator": "アーヤ",
            "text": "もう、いつもギリギリ\nなんだから。",
            "zh": "真是的，每天都是\n掐着点来啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "178/TALK",
            "narrator": "みやび",
            "text": "遅刻はせんき、\n何も問題ないちや。",
            "zh": "才不会迟到啵，\n什么问题都没有滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、コーヒー淹れて\nあげるから、もう少し\nシャキッとしなさいよ。",
            "zh": "喏，我给你泡咖啡，\n所以给我稍微\n精神一点啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "182/TALK",
            "narrator": "みやび",
            "text": "ありがと、ガブちゃん。\nうちのために毎日味噌汁も\n作ってくれん？",
            "zh": "谢啦，加布。\n那为了我，味噌汤能\n每天做给我喝咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "ガブリエラ",
            "text": "は？\n嫌よ、面倒くさい。",
            "zh": "哈？\n才不要，麻烦死了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "185/TALK",
            "narrator": "ガブリエラ",
            "text": "第一、味噌汁なら\nみやびの方が美味しいの\n作れるじゃん。",
            "zh": "再说了，要论味噌汤，\n明明是你做得\n更好吃吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "…このジョークは\n通じんかったか。",
            "zh": "……这个笑话\n没起作用啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "？　何のこと？",
            "zh": "？　你在说什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "192/TALK",
            "narrator": "アーヤ",
            "text": "うーん…ジャパニーズ\nジョーク、なのかしら？",
            "zh": "唔……这就是所谓的\n日式笑话吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "194/TALK",
            "narrator": "つばめ",
            "text": "わたしも、ガブちゃんの\nお味噌汁なら毎日でも\n飲みたいなぁ。",
            "zh": "要是加布做的味噌汤，\n我每天\n都想喝呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "自分で作りなさいよ。\n花嫁修業になるわよ？",
            "zh": "想喝就自己去做。\n这可是新娘修行哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "みやび",
            "text": "ふぁ～…まだ何となく\n寝足りない気分や…。",
            "zh": "哈啊……总感觉\n还没睡够啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "200/TALK",
            "narrator": "アーヤ",
            "text": "もう、そんな調子で\n大丈夫なの？",
            "zh": "真是的，这种状态\n真的没问题吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "201/TALK",
            "narrator": "みやび",
            "text": "ダメやね。\n学校で間違いなく\n爆睡確定や。",
            "zh": "不行咯。\n在学校绝对会\n爆睡无疑。",
            "narrator_zh": "雅"
        },
        {
            "location": "202/TALK",
            "narrator": "アーヤ",
            "text": "そうじゃなくて、\n今度の劇場の当直って、\nみやびでしょ？",
            "zh": "不是那样，\n下次剧场的值班，\n是雅吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/TALK",
            "narrator": "みやび",
            "text": "…当直？",
            "zh": "……值班？",
            "narrator_zh": "雅"
        },
        {
            "location": "207/TALK",
            "narrator": "つばめ",
            "text": "忘れちゃってたんですか？\n当番表に書いてあるじゃ\nないですか。",
            "zh": "忘掉了吗？\n值日表上明明\n写着呢呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "209/TALK",
            "narrator": "みやび",
            "text": "…ああ、そうやった。",
            "zh": "……啊，是有这么回事。",
            "narrator_zh": "雅"
        },
        {
            "location": "211/TALK",
            "narrator": "みやび",
            "text": "いや、覚えてるぞね。\n寝起きやき、\n頭が働かなかっただけや。",
            "zh": "不，我记得咧。\n刚睡醒嘛，\n只是脑子还没转起来。",
            "narrator_zh": "雅"
        },
        {
            "location": "213/TALK",
            "narrator": "みやび",
            "text": "…いかん、おもいっきり\n忘れてたちや。",
            "zh": "……不妙，忘得\n一干二净滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "214/TALK",
            "narrator": "みやび",
            "text": "その日は、絶対に譲れん\n予定があるのに…。",
            "zh": "那天明明有绝对\n不能让步的安排……。",
            "narrator_zh": "雅"
        },
        {
            "location": "215/TALK",
            "narrator": "つばめ",
            "text": "みやびさん？",
            "zh": "雅小姐？",
            "narrator_zh": "燕"
        },
        {
            "location": "217/TALK",
            "narrator": "みやび",
            "text": "ん？　\nああ、何でもないちや。",
            "zh": "嗯？\n啊，没什么滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "219/TALK",
            "narrator": "アーヤ",
            "text": "もう、そんな状態で\n劇場の当直任せるの、\nちょっと心配だわ。",
            "zh": "真是的，这种状态下\n还要托付剧场值班，\n真让人有点担心哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "221/TALK",
            "narrator": "ガブリエラ",
            "text": "逆に良いんじゃない？\n当直とか言ってるけど、\nやることもないんだし。",
            "zh": "我倒觉得挺好？\n说是值班，\n其实也没什么事做嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "暇でさっさと寝れば、\n今日よりはシャキッと\nするかもね。",
            "zh": "闲下来抓紧补觉，\n说不定比今天\n精神得多呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "224/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "225/SEL",
            "narrator": "",
            "text": "交代の話をしなよ",
            "zh": "你谈谈换人的事啊",
            "narrator_zh": ""
        },
        {
            "location": "226/SEL",
            "narrator": "",
            "text": "$me$が交渉する",
            "zh": "让$me$去谈",
            "narrator_zh": ""
        },
        {
            "location": "227/SEL",
            "narrator": "",
            "text": "本当はどうしたいの？",
            "zh": "你其实想怎么做？",
            "narrator_zh": ""
        },
        {
            "location": "228/ACT",
            "narrator": "",
            "text": "交代の話をしなよ",
            "zh": "你谈谈换人的事啊",
            "narrator_zh": ""
        },
        {
            "location": "233/TALK",
            "narrator": "みやび",
            "text": "…ん？",
            "zh": "……嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "247/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "雅"
        },
        {
            "location": "248/TALK",
            "narrator": "みやび",
            "text": "平気や",
            "zh": "没事咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "自分でどうにかする",
            "zh": "我自己会想办法",
            "narrator_zh": "雅"
        },
        {
            "location": "252/SEL",
            "narrator": "",
            "text": "本当に大丈夫？",
            "zh": "真的没事吗？",
            "narrator_zh": ""
        },
        {
            "location": "253/ACT",
            "narrator": "",
            "text": "本当に大丈夫？",
            "zh": "真的没事吗？",
            "narrator_zh": ""
        },
        {
            "location": "255/ACT",
            "narrator": "",
            "text": "$me$が交渉する",
            "zh": "让$me$去谈",
            "narrator_zh": ""
        },
        {
            "location": "260/TALK",
            "narrator": "みやび",
            "text": "…ん？",
            "zh": "……嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "264/TALK",
            "narrator": "みやび",
            "text": "余計なことせんでえい",
            "zh": "不用多管闲事",
            "narrator_zh": "雅"
        },
        {
            "location": "265/TALK",
            "narrator": "みやび",
            "text": "子供扱いすんな",
            "zh": "别把我当小孩子对待",
            "narrator_zh": "雅"
        },
        {
            "location": "268/ACT",
            "narrator": "",
            "text": "本当はどうしたいの？",
            "zh": "你其实想怎么做？",
            "narrator_zh": ""
        },
        {
            "location": "273/TALK",
            "narrator": "みやび",
            "text": "…ん？",
            "zh": "……嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "277/TALK",
            "narrator": "みやび",
            "text": "気にせんでえい",
            "zh": "不用在意",
            "narrator_zh": "雅"
        },
        {
            "location": "278/TALK",
            "narrator": "みやび",
            "text": "自分で解決するき",
            "zh": "我自己会解决啵",
            "narrator_zh": "雅"
        },
        {
            "location": "167/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　 7:50 AM</color>\nとある平日の朝、みやびの部屋でのこと",
            "zh": "<color=green>某月某日　 7:50 AM</color>\n某个平日的早晨，发生在雅的房间里。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
