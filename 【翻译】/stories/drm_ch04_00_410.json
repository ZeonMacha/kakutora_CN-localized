{
 "dir": "dramatics/daydra/drm_ch04_00_410.js",
 "type": "Episode",
 "info": {
  "story_id": "4041",
  "cid": "miyabi",
  "title": "らぶとーく 第42話",
  "sub_title": "答えはいくつある？"
 },
 "entry": [
  {
   "location": "155/SCENARIO",
   "narrator": "",
   "text": "答えはいくつある？"
  },
  {
   "location": "169/TALK",
   "narrator": "みやび",
   "text": "ふぁ～…。",
   "zh": "哈啊……",
   "narrator_zh": "雅"
  },
  {
   "location": "171/TALK",
   "narrator": "つばめ",
   "text": "あ、みやびさん。\nおはようございます。"
  },
  {
   "location": "173/TALK",
   "narrator": "みやび",
   "text": "ん、おはよう。\nアーヤとガブちゃんもな。"
  },
  {
   "location": "175/TALK",
   "narrator": "アーヤ",
   "text": "もう、いつもギリギリ\nなんだから。"
  },
  {
   "location": "178/TALK",
   "narrator": "みやび",
   "text": "遅刻はせんき、\n何も問題ないちや。"
  },
  {
   "location": "179/TALK",
   "narrator": "ガブリエラ",
   "text": "ほら、コーヒー淹れて\nあげるから、もう少し\nシャキッとしなさいよ。"
  },
  {
   "location": "182/TALK",
   "narrator": "みやび",
   "text": "ありがと、ガブちゃん。\nうちのために毎日味噌汁も\n作ってくれん？"
  },
  {
   "location": "184/TALK",
   "narrator": "ガブリエラ",
   "text": "は？\n嫌よ、面倒くさい。"
  },
  {
   "location": "185/TALK",
   "narrator": "ガブリエラ",
   "text": "第一、味噌汁なら\nみやびの方が美味しいの\n作れるじゃん。"
  },
  {
   "location": "187/TALK",
   "narrator": "みやび",
   "text": "…このジョークは\n通じんかったか。"
  },
  {
   "location": "190/TALK",
   "narrator": "ガブリエラ",
   "text": "？　何のこと？"
  },
  {
   "location": "192/TALK",
   "narrator": "アーヤ",
   "text": "うーん…ジャパニーズ\nジョーク、なのかしら？"
  },
  {
   "location": "194/TALK",
   "narrator": "つばめ",
   "text": "わたしも、ガブちゃんの\nお味噌汁なら毎日でも\n飲みたいなぁ。"
  },
  {
   "location": "197/TALK",
   "narrator": "ガブリエラ",
   "text": "自分で作りなさいよ。\n花嫁修業になるわよ？"
  },
  {
   "location": "198/TALK",
   "narrator": "みやび",
   "text": "ふぁ～…まだ何となく\n寝足りない気分や…。"
  },
  {
   "location": "200/TALK",
   "narrator": "アーヤ",
   "text": "もう、そんな調子で\n大丈夫なの？"
  },
  {
   "location": "201/TALK",
   "narrator": "みやび",
   "text": "ダメやね。\n学校で間違いなく\n爆睡確定や。"
  },
  {
   "location": "202/TALK",
   "narrator": "アーヤ",
   "text": "そうじゃなくて、\n今度の劇場の当直って、\nみやびでしょ？",
   "zh": "不是那样，\n下次剧场的值班，\n是雅吧？",
   "narrator_zh": "绫水"
  },
  {
   "location": "204/TALK",
   "narrator": "みやび",
   "text": "…当直？"
  },
  {
   "location": "207/TALK",
   "narrator": "つばめ",
   "text": "忘れちゃってたんですか？\n当番表に書いてあるじゃ\nないですか。"
  },
  {
   "location": "209/TALK",
   "narrator": "みやび",
   "text": "…ああ、そうやった。"
  },
  {
   "location": "211/TALK",
   "narrator": "みやび",
   "text": "いや、覚えてるぞね。\n寝起きやき、\n頭が働かなかっただけや。"
  },
  {
   "location": "213/TALK",
   "narrator": "みやび",
   "text": "…いかん、おもいっきり\n忘れてたちや。"
  },
  {
   "location": "214/TALK",
   "narrator": "みやび",
   "text": "その日は、絶対に譲れん\n予定があるのに…。",
   "zh": "那天明明有绝对\n不能让步的安排……。",
   "narrator_zh": "雅"
  },
  {
   "location": "215/TALK",
   "narrator": "つばめ",
   "text": "みやびさん？",
   "zh": "雅小姐？",
   "narrator_zh": "燕"
  },
  {
   "location": "217/TALK",
   "narrator": "みやび",
   "text": "ん？　\nああ、何でもないちや。"
  },
  {
   "location": "219/TALK",
   "narrator": "アーヤ",
   "text": "もう、そんな状態で\n劇場の当直任せるの、\nちょっと心配だわ。"
  },
  {
   "location": "221/TALK",
   "narrator": "ガブリエラ",
   "text": "逆に良いんじゃない？\n当直とか言ってるけど、\nやることもないんだし。"
  },
  {
   "location": "222/TALK",
   "narrator": "ガブリエラ",
   "text": "暇でさっさと寝れば、\n今日よりはシャキッと\nするかもね。"
  },
  {
   "location": "224/TALK",
   "narrator": "みやび",
   "text": "…………。"
  },
  {
   "location": "225/SEL",
   "narrator": "",
   "text": "交代の話をしなよ",
   "zh": "你谈谈换人的事啊",
   "narrator_zh": ""
  },
  {
   "location": "226/SEL",
   "narrator": "",
   "text": "$me$が交渉する",
   "zh": "让$me$去谈",
   "narrator_zh": ""
  },
  {
   "location": "227/SEL",
   "narrator": "",
   "text": "本当はどうしたいの？",
   "zh": "你其实想怎么做？",
   "narrator_zh": ""
  },
  {
   "location": "228/ACT",
   "narrator": "",
   "text": "交代の話をしなよ",
   "zh": "你谈谈换人的事啊",
   "narrator_zh": ""
  },
  {
   "location": "233/TALK",
   "narrator": "みやび",
   "text": "…ん？",
   "zh": "……嗯？",
   "narrator_zh": "雅"
  },
  {
   "location": "247/TALK",
   "narrator": "みやび",
   "text": "いや",
   "zh": "不对",
   "narrator_zh": "雅"
  },
  {
   "location": "248/TALK",
   "narrator": "みやび",
   "text": "平気や"
  },
  {
   "location": "249/TALK",
   "narrator": "みやび",
   "text": "自分でどうにかする"
  },
  {
   "location": "252/SEL",
   "narrator": "",
   "text": "本当に大丈夫？",
   "zh": "真的没事吗？",
   "narrator_zh": ""
  },
  {
   "location": "253/ACT",
   "narrator": "",
   "text": "本当に大丈夫？",
   "zh": "真的没事吗？",
   "narrator_zh": ""
  },
  {
   "location": "255/ACT",
   "narrator": "",
   "text": "$me$が交渉する",
   "zh": "让$me$去谈",
   "narrator_zh": ""
  },
  {
   "location": "260/TALK",
   "narrator": "みやび",
   "text": "…ん？",
   "zh": "……嗯？",
   "narrator_zh": "雅"
  },
  {
   "location": "264/TALK",
   "narrator": "みやび",
   "text": "余計なことせんでえい"
  },
  {
   "location": "265/TALK",
   "narrator": "みやび",
   "text": "子供扱いすんな"
  },
  {
   "location": "268/ACT",
   "narrator": "",
   "text": "本当はどうしたいの？",
   "zh": "你其实想怎么做？",
   "narrator_zh": ""
  },
  {
   "location": "273/TALK",
   "narrator": "みやび",
   "text": "…ん？",
   "zh": "……嗯？",
   "narrator_zh": "雅"
  },
  {
   "location": "277/TALK",
   "narrator": "みやび",
   "text": "気にせんでえい"
  },
  {
   "location": "278/TALK",
   "narrator": "みやび",
   "text": "自分で解決するき"
  },
  {
   "location": "167/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>某月某日　 7:50 AM</color>\nとある平日の朝、みやびの部屋でのこと"
  }
 ]
}
