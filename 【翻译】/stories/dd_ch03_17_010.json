{
    "dir": "chap17/daydra/dd_ch03_17_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "17352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "休みを増やせ",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "多放点假"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "休みを増やせ",
            "zh": "多放点假",
            "narrator_zh": ""
        },
        {
            "location": "28/TALK",
            "narrator": "真幌",
            "text": "休みを増やせ、だと？",
            "zh": "你说要多放点假？",
            "narrator_zh": "真幌"
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ。",
            "zh": "没错。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、ちょっと\nバイトのシフトの数が\n多い気がするわ。",
            "zh": "不如说，我总觉得\n打工的排班未免也\n太多了一点。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "真幌",
            "text": "シフトはちゃんと均等に\n割り振っているつもり\nなんだが？",
            "zh": "我自认为排班已经\n分配得很均匀了，\n不是吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "35/TALK",
            "narrator": "真幌",
            "text": "それに、用事がある時は\nいつでも休めるように\nしているだろう？",
            "zh": "而且有事的时候，\n我也一直都有准许\n你们请假吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "38/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、用事はないけど\n休みたい、って言ったと\nしたら――",
            "zh": "可要是没什么事，\n只是单纯想休息，\n你肯定——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "39/TALK",
            "narrator": "ガブリエラ",
            "text": "休ませてはくれない\nでしょ？",
            "zh": "就不会让我请假\n对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "真幌",
            "text": "当たり前だ。",
            "zh": "那不是废话吗。",
            "narrator_zh": "真幌"
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、最初からもっと\n休みを多くしておけば\nいいじゃない。",
            "zh": "所以啊，干脆从一开始\n就把休假多排一点\n不就好了嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "話は聞いたぞね！",
            "zh": "情况我都听到了啵！",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "みやび！？",
            "zh": "雅！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "真幌",
            "text": "…面倒なのが増えた。",
            "zh": "……又来个添乱的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "うちもガブちゃんの\n意見に賛成ちや。",
            "zh": "我也赞成\n加布的意见咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "まほさん、うちも前々から\nバイトの出勤が多いと\n思うてたがですよ。",
            "zh": "真幌，我早就\n觉得打工的排班\n有点太密了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、見てのとおり\nお客も来ないんやき――",
            "zh": "再说了，你看这里\n根本也没客人来啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "休み増やしても支障は\n無いと思うですけんど？",
            "zh": "就算多放点假，\n我觉得也没什么影响咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "真幌",
            "text": "却下だ。",
            "zh": "驳回。",
            "narrator_zh": "真幌"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしてよ？",
            "zh": "为什么呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "真幌",
            "text": "…私も、別におまえ達を\n無理やり拘束しようと\nいう気持ちはない。",
            "zh": "……我也不是故意想\n强行把你们\n拴在这里。",
            "narrator_zh": "真幌"
        },
        {
            "location": "67/TALK",
            "narrator": "真幌",
            "text": "だが、急な出動が\n掛かった時――",
            "zh": "但是，万一接到\n紧急出动指令时——",
            "narrator_zh": "真幌"
        },
        {
            "location": "68/TALK",
            "narrator": "真幌",
            "text": "最低限のメンバーが\nすぐに出動できる状態に\nしておく必要がある。",
            "zh": "必须保证至少有最低限度的\n成员处在随时能够\n出击的状态才行。",
            "narrator_zh": "真幌"
        },
        {
            "location": "70/TALK",
            "narrator": "真幌",
            "text": "それも考えて、シフトを\n作ってあるんだ。",
            "zh": "这都是考虑过这些之后\n才排出的班表。",
            "narrator_zh": "真幌"
        },
        {
            "location": "71/TALK",
            "narrator": "ガブリエラ",
            "text": "…初耳だわ。",
            "zh": "……头一次听说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/TALK",
            "narrator": "みやび",
            "text": "うちもや。\nちゃんと考えて\n作っちょったんですね。",
            "zh": "我也是。\n原来你有好好考虑过\n再排班的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "真幌",
            "text": "…気付かれていなかった\nことが驚きだ。",
            "zh": "……你们居然一直没发现，\n真让我惊讶。",
            "narrator_zh": "真幌"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "劇場にいなくたって、\n連絡もらえばみんな\nすぐに集まるでしょ？",
            "zh": "就算人不在剧场，\n只要接到联络，大家\n马上就能赶过来的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "放課後にそんな遠出する\nこともないと思うし。",
            "zh": "放学后大家应该也不会\n跑到多远的地方去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "真幌",
            "text": "…理由は他にもある。",
            "zh": "……理由不止这一个。",
            "narrator_zh": "真幌"
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "何よ？",
            "zh": "是什么呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "真幌",
            "text": "…知ってのとおり、\nここは映画館だ。",
            "zh": "……如你们所知，\n这里是电影院。",
            "narrator_zh": "真幌"
        },
        {
            "location": "82/TALK",
            "narrator": "真幌",
            "text": "映画館である以上は、\n最低限の体裁を保つ\n必要がある。",
            "zh": "只要还是电影院，\n就必须维持住\n最起码的体面。",
            "narrator_zh": "真幌"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "…と、言うと？",
            "zh": "……这话怎么讲？",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "真幌",
            "text": "休みを増やせば、一人や\n二人しかシフトに入らない\nことも考えられる。",
            "zh": "要是再增加休假，\n很可能会出现班表上\n只排进一两个人的情况。",
            "narrator_zh": "真幌"
        },
        {
            "location": "86/TALK",
            "narrator": "真幌",
            "text": "客も従業員も少ない\n映画館とか、不安で\n入り辛いだろう？",
            "zh": "客人少店员也少的\n电影院，只会让人觉得\n不靠谱不敢进来吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "けんど、客が入り過ぎると\n出動の時に困るんじゃ…。",
            "zh": "不过，客人来太多的话\n要出动的时候就麻烦了啵……。",
            "narrator_zh": "雅"
        },
        {
            "location": "89/TALK",
            "narrator": "真幌",
            "text": "だからといって、\n露骨にやる気のない\n営業もできん。",
            "zh": "话虽如此，也不能\n摆出一副明显毫无干劲的\n营业态度。",
            "narrator_zh": "真幌"
        },
        {
            "location": "90/TALK",
            "narrator": "真幌",
            "text": "最低限の体裁を保ち、\n尚且つ客も入らない\nベストな状態――",
            "zh": "既能保住最起码的体面，\n又恰好不会有客人上门的\n最佳平衡状态——",
            "narrator_zh": "真幌"
        },
        {
            "location": "91/TALK",
            "narrator": "真幌",
            "text": "それが今なんだ。",
            "zh": "就是现在这样。",
            "narrator_zh": "真幌"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "誰からも興味を持たれない\n古い映画をやっちゅう\nだけで――",
            "zh": "光靠放没人感兴趣的\n老电影\n就已经——",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "十分やと思いますけんど？",
            "zh": "我觉得就够了咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "真幌",
            "text": "そうかもしれないが、\nそれだけではダメなんだ。\n例えばだが――",
            "zh": "或许吧，但光靠那样\n还远远不够。\n打个比方——",
            "narrator_zh": "真幌"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "…ダメだわ。\nこれじゃ埒が明かない。",
            "zh": "……不行。\n这样下去没完没了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "今、休日を増やすように真幌と交渉中なんだけど",
            "zh": "我现在正和真幌交涉，想让她多排点休假",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "中々話が進まなくて困ってるの",
            "zh": "可半天谈不拢，真让人头疼",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/SEL",
            "narrator": "",
            "text": "ずっと見てた、お疲れ様",
            "zh": "我一直在看，辛苦了",
            "narrator_zh": ""
        },
        {
            "location": "116/ACT",
            "narrator": "",
            "text": "ずっと見てた、お疲れ様",
            "zh": "我一直在看，辛苦了",
            "narrator_zh": ""
        },
        {
            "location": "118/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと、マルザンナ",
            "zh": "谢谢你，玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、できればあなたの知恵も貸してほしいの",
            "zh": "不过如果可以的话，也希望你能借我点智慧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "121/SEL",
            "narrator": "",
            "text": "てか、映画館やる意味ある？",
            "zh": "话说回来，开这电影院真有意义吗？",
            "narrator_zh": ""
        },
        {
            "location": "122/SEL",
            "narrator": "",
            "text": "休業日を作ればいい",
            "zh": "设几个休息日就行了",
            "narrator_zh": ""
        },
        {
            "location": "123/ACT",
            "narrator": "",
            "text": "てか、映画館やる意味ある？",
            "zh": "话说回来，开这电影院真有意义吗？",
            "narrator_zh": ""
        },
        {
            "location": "124/TALK",
            "narrator": "ガブリエラ",
            "text": "…言われてみれば、確かに",
            "zh": "……听你这么一说，确实",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "待機するのが目的なら、寮にいるだけでもいいのに",
            "zh": "如果目的只是待命，明明待在宿舍不就好了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "さすがはマルザンナ、冴えてるわ",
            "zh": "不愧是玛尔赞娜，脑筋真灵",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ、映画館辞めて、\nあたし達専用の待機所に\nするっていうのはどう？",
            "zh": "我说，干脆把电影院关了，\n改成专门给我们待命的\n据点怎么样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "真幌",
            "text": "ありえん！\n映画館を畳むなんて、\n絶対にダメだ！",
            "zh": "荒唐！\n把电影院关门大吉什么的，\n绝对不行！",
            "narrator_zh": "真幌"
        },
        {
            "location": "141/TALK",
            "narrator": "ガブリエラ",
            "text": "もぉ、なんでそんなに\n映画館にこだわるのよ？",
            "zh": "真是的，你干嘛那么\n执着于开电影院呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし達が集まってれば\nいいんだから、バイトする\n必要はないでしょ？",
            "zh": "只要我们人能聚在一起\n不就行了吗，根本没必要\n打工吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "みやび",
            "text": "同感です。\nどうして映画館やないと\nいかんがですか？",
            "zh": "我同意。\n为么子非得开成\n电影院不可咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "145/TALK",
            "narrator": "真幌",
            "text": "それは――",
            "zh": "那是因为——",
            "narrator_zh": "真幌"
        },
        {
            "location": "146/TALK",
            "narrator": "真幌",
            "text": "この劇場はな、私の先祖が\n代々続けてきた、由緒ある\n劇場だからだ。",
            "zh": "这座剧场，可是我的先祖\n代代传承下来的、\n历史悠久的剧场啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "147/TALK",
            "narrator": "ガブリエラ",
            "text": "…先祖代々？",
            "zh": "……先祖代代？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "149/TALK",
            "narrator": "真幌",
            "text": "そうだ。\nとはいえ、明治以前は\n映画館ではなく――",
            "zh": "没错。\n话虽如此，在明治以前\n这里还不是电影院——",
            "narrator_zh": "真幌"
        },
        {
            "location": "150/TALK",
            "narrator": "真幌",
            "text": "演芸場や芝居小屋だった\nらしいがな。",
            "zh": "好像是曲艺场\n或是小戏园子。",
            "narrator_zh": "真幌"
        },
        {
            "location": "152/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そんなに昔から\nあるの！？",
            "zh": "竟、竟然从那么久以前\n就有了吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "真幌",
            "text": "ああ…当然、改装工事も\n何度も入っているため、\n形は変わっているが――",
            "zh": "嗯……当然，因为中间\n翻修过很多次，\n模样早就变了——",
            "narrator_zh": "真幌"
        },
        {
            "location": "155/TALK",
            "narrator": "真幌",
            "text": "先祖から受け継いだ大切な\n劇場を、私の代で潰すわけ\nにはいかないんだ。",
            "zh": "但先祖传下来的宝贵剧场，\n绝不能在我这一代\n给砸在手里。",
            "narrator_zh": "真幌"
        },
        {
            "location": "156/TALK",
            "narrator": "みやび",
            "text": "…こう言うてはなんです\nけんど、負の遺産に\nなっちゅうのに…。",
            "zh": "……这话可能不太好听，\n不过它都已经变成\n负资产了咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "何言ってるのよ！？\n全然負の遺産なんかじゃ\nないわ。",
            "zh": "你说什么呢！？\n根本就不是什么\n负资产啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "159/TALK",
            "narrator": "みやび",
            "text": "…なんやと？",
            "zh": "……搞么子？",
            "narrator_zh": "雅"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか、ここがそんな\n歴史のある場所だった\nなんて、思わなかったわ。",
            "zh": "真没想到，\n这里竟然是这么有\n历史渊源的地方。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "真幌",
            "text": "ん？　興味あるのか？",
            "zh": "嗯？　你有兴趣吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "164/TALK",
            "narrator": "ガブリエラ",
            "text": "当然よ！",
            "zh": "那当然！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな歴史のある場所で\n働けるなんて、凄いこと\nじゃない！",
            "zh": "能在这么有历史底蕴的\n地方工作，不是很厉害\n的一件事吗！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "168/TALK",
            "narrator": "真幌",
            "text": "ふっ、やっとこの劇場の\n素晴らしさがわかったか。",
            "zh": "哼，总算体会到这座剧场的\n了不起之处了吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "169/TALK",
            "narrator": "真幌",
            "text": "改装工事は何度も\n行われてはいるが――",
            "zh": "虽然翻修工程已经\n进行过无数次——",
            "narrator_zh": "真幌"
        },
        {
            "location": "170/TALK",
            "narrator": "真幌",
            "text": "この劇場には、楽屋を始め\n当時の名残があちこちに\n残されているんだ。",
            "zh": "但剧场里从后台开始，\n到处都还留存着\n当年的痕迹哦。",
            "narrator_zh": "真幌"
        },
        {
            "location": "171/TALK",
            "narrator": "真幌",
            "text": "興味があるなら、\n暇なときにでも\n探してみるんだな。",
            "zh": "要是有兴趣的话，\n等闲下来的时候\n自己去找找看吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "172/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、そうしてみるわ。",
            "zh": "嗯，我会的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "…ガブちゃん、日本文化\n大好きなんやわかっちゅう\nけんど――",
            "zh": "……加布，我晓得你\n最喜欢日本文化了，\n不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "176/TALK",
            "narrator": "みやび",
            "text": "チョロ過ぎて、ちっくと\n心配になるんよ…。",
            "zh": "未免也太好哄了吧，\n搞得我都有点担心咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "177/ACT",
            "narrator": "",
            "text": "休業日を作ればいいい",
            "zh": "设几个休息日就行了",
            "narrator_zh": ""
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "そっか、それなら自然よね？",
            "zh": "对哦，那样就挺自然的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "191/TALK",
            "narrator": "ガブリエラ",
            "text": "まほ、いいアイデアが\nあるわ。",
            "zh": "真幌，我想到个\n好主意。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/TALK",
            "narrator": "ガブリエラ",
            "text": "最低でも、週に二日は\n休業日を作ろうよ。",
            "zh": "每周至少也得定两天\n休息日吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "真幌",
            "text": "アホか！？\n週に二日も休む映画館が\nあってたまるか！",
            "zh": "傻了吗！？\n哪有每周休两天的\n电影院啊！",
            "narrator_zh": "真幌"
        },
        {
            "location": "197/TALK",
            "narrator": "みやび",
            "text": "誰も気づきませんよ。\n開店休業状態なんやき。",
            "zh": "没人会注意到的啦。\n本来就是半关门状态啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "198/TALK",
            "narrator": "真幌",
            "text": "そうかもしれんが――",
            "zh": "也许是那样没错——",
            "narrator_zh": "真幌"
        },
        {
            "location": "199/TALK",
            "narrator": "真幌",
            "text": "しかし、ギャヴィ。\nそんなにこの劇場で\n働くのが嫌なのか？",
            "zh": "不过，加维。\n你就这么讨厌在这座\n剧场里工作吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "200/TALK",
            "narrator": "ガブリエラ",
            "text": "あ…べ、別に、嫌って\nわけじゃないけど…。",
            "zh": "啊……倒、倒也不是\n讨厌啦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "201/TALK",
            "narrator": "真幌",
            "text": "そうとは思えんな。\nそんなに休みをよこせと\n言うのだから――",
            "zh": "我看可不像。\n你既然这么拼命地\n吵着要休假——",
            "narrator_zh": "真幌"
        },
        {
            "location": "202/TALK",
            "narrator": "真幌",
            "text": "何かそれなりの理由が\nあるんだろう？",
            "zh": "肯定是有什么\n非休不可的理由吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "204/TALK",
            "narrator": "みやび",
            "text": "…ガブちゃん。\n何かあるんやったら\n言うた方がえいよ。",
            "zh": "……加布。\n要是有什么事，\n还是说出来要得咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "205/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "207/TALK",
            "narrator": "ガブリエラ",
            "text": "だって…クラスのみんなは\n誰もバイトなんかして\nないんだもの…。",
            "zh": "因为……班上的同学\n根本没有一个人在\n打工的嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "208/TALK",
            "narrator": "ガブリエラ",
            "text": "みんな放課後は部活とか、\n遊ぶ約束とかしてるし…。",
            "zh": "大家放学后不是去社团，\n就是约好一起去玩……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "真幌",
            "text": "…あっ！！",
            "zh": "……啊！！",
            "narrator_zh": "真幌"
        },
        {
            "location": "211/TALK",
            "narrator": "みやび",
            "text": "まほさん！\nすっかり忘れてたけんど、\nガブちゃんまだ中学生や！",
            "zh": "真幌！\n我差点都忘了，\n加布她还是初中生啵！",
            "narrator_zh": "雅"
        },
        {
            "location": "213/TALK",
            "narrator": "ガブリエラ",
            "text": "そりゃ、トライナリーに\n所属してるんだから、\n出撃には文句ないわ。",
            "zh": "当然，既然加入了\n三重奏，对于出击\n我绝对不会有半句怨言。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "215/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、クラスメイトの\n子達みたいに、もう少し\n遊ぶ時間も欲しいわ…。",
            "zh": "可是，我也想像班上的\n同学们那样，再多一点\n用来玩的时间啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "218/TALK",
            "narrator": "真幌",
            "text": "…すまん！！",
            "zh": "……抱歉！！",
            "narrator_zh": "真幌"
        },
        {
            "location": "219/TALK",
            "narrator": "真幌",
            "text": "すっかり忘れていた！\nギャヴィがまだ中学生だと\nいうことを！",
            "zh": "我完全给忘了！\n忘了加维你还只是个\n初中生！",
            "narrator_zh": "真幌"
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "まほさんだけやない。\nうちや、アーヤ達も多分\n忘れてたと思うんよ。",
            "zh": "不光是真幌。\n我还有绫水她们，\n大概也都忘了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "224/TALK",
            "narrator": "みやび",
            "text": "すまんな、ガブちゃん。\n気付いてやれんで…。",
            "zh": "对不住啊，加布。\n没早点察觉到……。",
            "narrator_zh": "雅"
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/TALK",
            "narrator": "真幌",
            "text": "基本的に、バイトは\n高校生からだからな。",
            "zh": "说到底，打工本来也是\n高中生以后才开始的事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "228/TALK",
            "narrator": "真幌",
            "text": "中学生のギャヴィには、\n酷なことだったかも\nしれん…本当にすまん。",
            "zh": "让还是初中生的加维陪着一起，\n确实有点苛刻了……\n真的很抱歉。",
            "narrator_zh": "真幌"
        },
        {
            "location": "231/TALK",
            "narrator": "ガブリエラ",
            "text": "…いいわよ、もう。",
            "zh": "……算了啦，没事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしも、今の今まで\nそのこと言わなかったん\nだし…。",
            "zh": "而且我自己，也是到刚才\n为止一直都没提过\n这件事……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "235/TALK",
            "narrator": "みやび",
            "text": "…まほさん、来月から\nガブちゃんのシフト、\n休み多めでお願いします。",
            "zh": "……真幌，从下个月起\n加布的排班，\n就麻烦多给她排点休假咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "236/TALK",
            "narrator": "みやび",
            "text": "その分は、うちらで\n補いますき。",
            "zh": "空出来的班，\n我们几个补上就是了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "237/TALK",
            "narrator": "真幌",
            "text": "ああ、そうしてもらえると\n助かる。",
            "zh": "嗯，能有你们帮着顶上，\n我也省心多了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、でもそれじゃ…。",
            "zh": "咦，可那样的话……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/TALK",
            "narrator": "真幌",
            "text": "もちろん、ギャヴィの\nシフトをゼロにすることは\nできないが…。",
            "zh": "当然，虽说没法把\n加维你的排班彻底清零\n就是了……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そこまでしろとは\n言ってないから！",
            "zh": "我、我又没让你\n做到那种地步！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/TALK",
            "narrator": "みやび",
            "text": "わかっちゅうよ。\nけんど、今より間違いなく\n休みは増やすき――",
            "zh": "我晓得咯。\n不过，休假肯定会\n比现在多的啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "246/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんはその分、\nおもいっきり好きなことを\nしてえいんよ。",
            "zh": "多出来的空余时间，\n加布你就尽管痛痛快快去\n做自己喜欢的事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "247/TALK",
            "narrator": "真幌",
            "text": "アーヤ達には私から話す。\nギャヴィは何も気にしな\nくていい。",
            "zh": "绫水她们那边由我来说。\n加维你什么都不用\n多想。",
            "narrator_zh": "真幌"
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当にいいの？",
            "zh": "……真的可以吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "うちらも、中学時代は\nバイトなんかせんで、\n好き放題やってたきね。",
            "zh": "我们初中那阵，\n也根本没打过工，\n都是想干嘛就干嘛嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "254/TALK",
            "narrator": "みやび",
            "text": "休みが多くなるんは、\nガブちゃんにとって\n当然の権利やき――",
            "zh": "多拿点休假，\n本来就是加布你\n应得的权利啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "255/TALK",
            "narrator": "みやび",
            "text": "気にせんで、今のうちに\n沢山好きなことせんと\nいかんよ。",
            "zh": "别往心里去，趁现在\n可得多做些自己喜欢的事\n才行咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "257/TALK",
            "narrator": "真幌",
            "text": "…しかし、シフトを\nどうするべきか…\nう～む…。",
            "zh": "……不过，排班到底\n该怎么调整才好呢……\n唔～嗯……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "259/TALK",
            "narrator": "ガブリエラ",
            "text": "…無理に減らさ\nなくてもいいわ。",
            "zh": "……也不用勉强\n减少那么多啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "260/TALK",
            "narrator": "ガブリエラ",
            "text": "ただ、休みたい時に\n少しだけ無理を聞いて\nもらえたら――",
            "zh": "只要我想休息的时候，\n能稍微通融一下\n答应我——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "261/TALK",
            "narrator": "ガブリエラ",
            "text": "それでいいから！\nシフトで休み多くしたり\nとかはしないで。",
            "zh": "那样就够了！\n不用特意在排班里\n多给我放假什么的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "263/TALK",
            "narrator": "みやび",
            "text": "えいが？\n休みが欲しい言うたんは\nガブちゃんやのに…。",
            "zh": "要得吗？\n明明是加布你自己说\n想要假期的……。",
            "narrator_zh": "雅"
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "そうだけど…やっぱり、\nあたしだけ減らすって\nいうのは――",
            "zh": "话是这么说……可果然，\n只减少我一个人的班\n总觉得——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "ガブリエラ",
            "text": "なんか、対等じゃなくて\n嫌な感じだし…。",
            "zh": "感觉很不平等，\n我不太喜欢这样……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、劇場の仕事は\n嫌いじゃないし…。",
            "zh": "而且，剧场的工作\n我也不讨厌……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/TALK",
            "narrator": "真幌",
            "text": "…わかった。\nおまえがそう言うなら、\nその通りにしよう。",
            "zh": "……好吧。\n既然你都这么说了，\n那就按你的意思办。",
            "narrator_zh": "真幌"
        },
        {
            "location": "271/TALK",
            "narrator": "みやび",
            "text": "休みが欲しい時は、\n遠慮なく言うがよ？",
            "zh": "什么时候想休假了，\n千万别客气直接说咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "275/TALK",
            "narrator": "ガブリエラ",
            "text": "…思ったより気を使わせ\nちゃったみたい。",
            "zh": "……好像比预想中\n还让她们费心了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "276/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと、ワガママ\n言い過ぎたかしら？",
            "zh": "我是不是有点\n太任性了呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "17/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月26日　3:34 PM</color>\nとある平日、神楽坂トライナリー劇場にて。",
            "zh": "<color=green>7月26日　3:34 PM</color>\n某个平日，于神乐坂三重奏剧场。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "287/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch03",
            "text": "【それが子供の仕事】",
            "zh": "【那就是孩子的本分】",
            "narrator_zh": "Dialog_GEThimegoto_ch03"
        }
    ]
}
