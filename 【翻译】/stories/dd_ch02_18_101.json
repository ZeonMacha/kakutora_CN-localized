        "title": "002 メインストーリー",
        "sub_title": "其は詮索か友愛か＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "此乃刺探抑或友爱＜前篇＞"
    },
    "entry": [
        {
            "location": "24/TALK",
            "narrator": "アーヤ",
            "text": "…サークルで使う\n人形、完成！",
            "zh": "……社团要用的\n人偶，完成了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "25/TALK",
            "narrator": "アーヤ",
            "text": "買い物にでも\n行ってみようかしら？",
            "zh": "去买点东西\n顺便逛逛吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "アーヤ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "30/TALK",
            "narrator": "アーヤ",
            "text": "メノウのＣＭ…。\nベストアルバムが\n出たんだ…。",
            "zh": "MENOW的广告……。\n原来出了\n精选专辑啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "メイクしてるから、\nパッと見じゃ全然\nわからないわ…。",
            "zh": "因为化了妆，\n乍一看完全\n认不出来呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "これが\n卯月だってこと…。",
            "zh": "完全看不出这就是\n卯月……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "ダメね(-ω-;)",
            "zh": "不行呢(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "私",
            "zh": "我",
            "narrator_zh": "绫水"
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "卯月のこと",
            "zh": "对卯月的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "アーヤ",
            "text": "全然知らなかった(; ;)",
            "zh": "完全不了解(; ;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "51/SEL",
            "narrator": "",
            "text": "メノウだったこと？",
            "zh": "是指她是MENOW的事？",
            "narrator_zh": ""
        },
        {
            "location": "52/ACT",
            "narrator": "",
            "text": "メノウだったこと？",
            "zh": "是指她是MENOW的事？",
            "narrator_zh": ""
        },
        {
            "location": "54/TALK",
            "narrator": "アーヤ",
            "text": "それもある（；￢＿￢）",
            "zh": "那也是其一（；￢＿￢）",
            "narrator_zh": "绫水"
        },
        {
            "location": "55/TALK",
            "narrator": "アーヤ",
            "text": "けど",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "この前のフェノメノン",
            "zh": "上次的PhenoMENON",
            "narrator_zh": "绫水"
        },
        {
            "location": "57/TALK",
            "narrator": "アーヤ",
            "text": "卯月の家が巻き込まれてたのも",
            "zh": "连卯月家里被卷进去的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "全然知らなくて(>_<)",
            "zh": "我也完全不知道(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "アーヤ",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "キツいこと言っちゃって(; ;)",
            "zh": "才对她说了那么重的话(; ;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "65/SEL",
            "narrator": "",
            "text": "間違ったことは言ってない",
            "zh": "你并没有说错什么",
            "narrator_zh": ""
        },
        {
            "location": "66/ACT",
            "narrator": "",
            "text": "間違ったことは言ってない",
            "zh": "你并没有说错什么",
            "narrator_zh": ""
        },
        {
            "location": "68/TALK",
            "narrator": "アーヤ",
            "text": "わかってる",
            "zh": "我知道",
            "narrator_zh": "绫水"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "あの時怒ったことを後悔はしてないわ",
            "zh": "我并不后悔当时发了火",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "アーヤ",
            "text": "みんなを危険な目に合わせたのは事実だし",
            "zh": "她确实让大家陷入了危险之中",
            "narrator_zh": "绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "但是",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "アーヤ",
            "text": "卯月のことほとんど知らないのも事実(´o｀；",
            "zh": "我几乎不了解卯月也是事实(´o｀；",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "アーヤ",
            "text": "知らな過ぎるっていうのも",
            "zh": "了解得太少这一点",
            "narrator_zh": "绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり問題あると思うから(>_<)",
            "zh": "果然还是有问题的吧(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "アーヤ",
            "text": "みやびに頼んで",
            "zh": "要不拜托雅",
            "narrator_zh": "绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "アーヤ",
            "text": "卯月の情報を手に入れるとか(-ω-;)",
            "zh": "去搞点卯月的情报来(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり今のなし(>_<)",
            "zh": "刚才那句还是算了(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "81/SEL",
            "narrator": "",
            "text": "アーヤは知りたくないの？",
            "zh": "绫水你不想知道吗？",
            "narrator_zh": ""
        },
        {
            "location": "82/ACT",
            "narrator": "",
            "text": "アーヤは知りたくないの？",
            "zh": "绫水你不想知道吗？",
            "narrator_zh": ""
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "知りたいとは思うけど",
            "zh": "想倒是很想知道",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "プライバシーの侵害までするのは",
            "zh": "但做到侵犯隐私那一步",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "やり過ぎだと思うし(￣Д￣ )",
            "zh": "我觉得未免太过头了(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "アーヤ",
            "text": "気にはなるけど",
            "zh": "还是会在意就是了",
            "narrator_zh": "绫水"
        },
        {
            "location": "156/TALK",
            "narrator": "アーヤ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "绫水"
        },
        {
            "location": "165/TALK",
            "narrator": "アーヤ",
            "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。",
            "zh": "欢迎来到\n[心之扉]，\n$handle$。",
            "narrator_zh": "绫水"
        },
        {
            "location": "166/SEL",
            "narrator": "",
            "text": "あれ！？",
            "zh": "咦！？",
            "narrator_zh": ""
        },
        {
            "location": "167/ACT",
            "narrator": "",
            "text": "あれ！？",
            "zh": "咦！？",
            "narrator_zh": ""
        },
        {
            "location": "170/TALK",
            "narrator": "アーヤ",
            "text": "え！？\nな、なに？？",
            "zh": "咦！？\n什、什么呀？？",
            "narrator_zh": "绫水"
        },
        {
            "location": "171/SEL",
            "narrator": "",
            "text": "前回いなかったよね？",
            "zh": "上次你不在吧？",
            "narrator_zh": ""
        },
        {
            "location": "172/SEL",
            "narrator": "",
            "text": "別のアーヤさん？",
            "zh": "另一位绫水？",
            "narrator_zh": ""
        },
        {
            "location": "173/ACT",
            "narrator": "",
            "text": "前回いなかったよね？",
            "zh": "上次你不在吧？",
            "narrator_zh": ""
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "え…！？",
            "zh": "咦……！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "175/TALK",
            "narrator": "アーヤ",
            "text": "ああ～、\nごめんなさい。",
            "zh": "啊——\n抱歉呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "176/TALK",
            "narrator": "アーヤ",
            "text": "相変わらず私ってば\nタイミング悪いわよね。",
            "zh": "我这人还是一如既往地\n时机不对呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "177/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと野暮用で\nゲートから外してた\nだけなの。",
            "zh": "只是因为有点杂事，\n暂时离开了\n扉门而已哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "178/SEL",
            "narrator": "",
            "text": "よかった。更迭されたのかと思った",
            "zh": "太好了。我还以为你被撤换了",
            "narrator_zh": ""
        },
        {
            "location": "179/SEL",
            "narrator": "",
            "text": "野暮用？どんな？",
            "zh": "杂事？什么杂事？",
            "narrator_zh": ""
        },
        {
            "location": "180/ACT",
            "narrator": "",
            "text": "よかった。更迭されたのかと思った",
            "zh": "太好了。我还以为你被撤换了",
            "narrator_zh": ""
        },
        {
            "location": "181/TALK",
            "narrator": "アーヤ",
            "text": "ふふ。\nまさか。",
            "zh": "呵呵。\n怎么可能。",
            "narrator_zh": "绫水"
        },
        {
            "location": "182/ACT",
            "narrator": "",
            "text": "野暮用？どんな？",
            "zh": "杂事？什么杂事？",
            "narrator_zh": ""
        },
        {
            "location": "183/TALK",
            "narrator": "アーヤ",
            "text": "そんな不躾な質問は\n感心しないわね。",
            "zh": "这么唐突的提问\n可不值得夸奖哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "184/TALK",
            "narrator": "アーヤ",
            "text": "野暮用は\n野暮用よ？",
            "zh": "杂事就是\n杂事嘛？",
            "narrator_zh": "绫水"
        },
        {
            "location": "186/ACT",
            "narrator": "",
            "text": "別のアーヤさん？",
            "zh": "另一位绫水？",
            "narrator_zh": ""
        },
        {
            "location": "187/TALK",
            "narrator": "アーヤ",
            "text": "え？\nどういうこと？",
            "zh": "咦？\n什么意思？",
            "narrator_zh": "绫水"
        },
        {
            "location": "188/TALK",
            "narrator": "アーヤ",
            "text": "突然意味の分からないこと\n言わないでちょうだい？",
            "zh": "别突然说些让人\n摸不着头脑的话呀？",
            "narrator_zh": "绫水"
        },
        {
            "location": "189/TALK",
            "narrator": "アーヤ",
            "text": "ミステリー小説とかじゃ\nないんだから。",
            "zh": "这又不是什么\n推理小说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ早速、\n仕事しましょ？",
            "zh": "那么事不宜迟，\n开始工作吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/SEL",
            "narrator": "",
            "text": "オーケー",
            "zh": "OK",
            "narrator_zh": ""
        },
        {
            "location": "193/SEL",
            "narrator": "",
            "text": "ちょっと待って！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "194/ACT",
            "narrator": "",
            "text": "オーケー",
            "zh": "OK",
            "narrator_zh": ""
        },
        {
            "location": "195/ACT",
            "narrator": "",
            "text": "ちょっと待って！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "ええっ？\nな、なあに？",
            "zh": "咦——？\n怎、怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "197/SEL",
            "narrator": "",
            "text": "この前言ってた「言わなければならない事」は？",
            "zh": "之前说过的“非说不可的事”呢？",
            "narrator_zh": ""
        },
        {
            "location": "198/SEL",
            "narrator": "",
            "text": "この前ジャンケンで負けて、次は服脱いでくれるって言ったじゃん",
            "zh": "之前猜拳输了，你不是说下次会脱衣服给我看的吗",
            "narrator_zh": ""
        },
        {
            "location": "199/ACT",
            "narrator": "",
            "text": "「言わなければならないこと」は？",
            "zh": "“非说不可的事”呢？",
            "narrator_zh": ""
        },
        {
            "location": "200/TALK",
            "narrator": "アーヤ",
            "text": "え？",
            "zh": "咦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "201/TALK",
            "narrator": "アーヤ",
            "text": "ああ、アレね。",
            "zh": "啊，那件事呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "202/TALK",
            "narrator": "アーヤ",
            "text": "アレはもういいの。\n解決しちゃったから。",
            "zh": "那件事已经没事了。\n因为已经解决了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "203/TALK",
            "narrator": "アーヤ",
            "text": "お騒がせしちゃって\nごめんなさいね。",
            "zh": "让你跟着操心了，\n真不好意思呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/ACT",
            "narrator": "",
            "text": "この前ジャンケンで負けて、次は服脱いでくれるって言ったじゃん",
            "zh": "之前猜拳输了，你不是说下次会脱衣服给我看的吗",
            "narrator_zh": ""
        },
        {
            "location": "206/TALK",
            "narrator": "アーヤ",
            "text": "は！？\n私、そんなこと――！！",
            "zh": "哈！？\n我、我哪有——！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "207/SEL",
            "narrator": "",
            "text": "ごめん、ちょっと言ってみたかっただけ",
            "zh": "抱歉，只是稍微想说一次试试",
            "narrator_zh": ""
        },
        {
            "location": "208/SEL",
            "narrator": "",
            "text": "やっぱり別のアーヤさんだったか",
            "zh": "果然是另一位绫水吧",
            "narrator_zh": ""
        },
        {
            "location": "209/ACT",
            "narrator": "",
            "text": "ごめん、ちょっと言ってみたかっただけ",
            "zh": "抱歉，只是稍微想说一次试试",
            "narrator_zh": ""
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "…はぁ。もう、\nビックリさせないで。",
            "zh": "……唉。真是的，\n别吓唬人好吗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "211/TALK",
            "narrator": "アーヤ",
            "text": "冗談でも言っていいことと\n悪い事がありますからね？",
            "zh": "就算是开玩笑，也有\n能说和不能说的话呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/ACT",
            "narrator": "",
            "text": "やっぱり別のアーヤさんだったか",
            "zh": "果然是另一位绫水吧",
            "narrator_zh": ""
        },
        {
            "location": "214/TALK",
            "narrator": "アーヤ",
            "text": "ワケのわからないこと\n言わないで！",
            "zh": "别胡说些\n莫名其妙的话！",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/TALK",
            "narrator": "アーヤ",
            "text": "確かに…負けたけど！\nまさか本当にやれって\n言うとは思わなかったのよ。",
            "zh": "确实……我是输了啦！\n可真没想到你竟然\n还真让我做啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "216/TALK",
            "narrator": "アーヤ",
            "text": "はぁ……\nもう仕方ないわね。",
            "zh": "唉……\n真拿你没办法呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "231/TALK",
            "narrator": "アーヤ",
            "text": "はい、これでいい？",
            "zh": "诺，这样行了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/TALK",
            "narrator": "アーヤ",
            "text": "これ以上はもう\n絶対無理だから！",
            "zh": "再往下脱可\n绝对不行了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "233/SEL",
            "narrator": "",
            "text": "ガンプクガンプク",
            "zh": "大饱眼福大饱眼福",
            "narrator_zh": ""
        },
        {
            "location": "234/SEL",
            "narrator": "",
            "text": "へー、なるほどね",
            "zh": "哦——，原来如此",
            "narrator_zh": ""
        },
        {
            "location": "235/ACT",
            "narrator": "",
            "text": "ガンプクガンプク",
            "zh": "大饱眼福大饱眼福",
            "narrator_zh": ""
        },
        {
            "location": "237/TALK",
            "narrator": "アーヤ",
            "text": "呆れた……。",
            "zh": "真是服了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "238/TALK",
            "narrator": "アーヤ",
            "text": "はいはい、\n鼻の下伸ばしてないで、\n仕事仕事。",
            "zh": "好好好，\n别流口水啦，\n干正事干正事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "239/ACT",
            "narrator": "",
            "text": "へー、なるほどね",
            "zh": "哦——，原来如此",
            "narrator_zh": ""
        },
        {
            "location": "240/TALK",
            "narrator": "アーヤ",
            "text": "一応私にだって羞恥心は\nあるんですからね？",
            "zh": "我好歹也是有\n羞耻心的哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "241/TALK",
            "narrator": "アーヤ",
            "text": "はいはい、\nもう仕事するわよ？",
            "zh": "好好好，\n要开始工作了哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "247/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ改めて、\n今回の悩みを\n検索するわね。",
            "zh": "那么重新开始，\n我来检索这次的\n烦恼哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "252/TALK",
            "narrator": "アーヤ",
            "text": "オープンプロセス、\n0x307番地から\n0xBCF番地へ。",
            "zh": "开放进程，\n从0x307地址至\n0xBCF地址。",
            "narrator_zh": "绫水"
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "シーク完了。",
            "zh": "搜索完成。",
            "narrator_zh": "绫水"
        },
        {
            "location": "270/TALK",
            "narrator": "アーヤ",
            "text": "さて、と。\n今回は……",
            "zh": "那么。\n这次是……",
            "narrator_zh": "绫水"
        },
        {
            "location": "272/TALK",
            "narrator": "アーヤ",
            "text": "あー……。",
            "zh": "啊——……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "273/TALK",
            "narrator": "アーヤ",
            "text": "確かにこれは\n悩めるところよね。",
            "zh": "确实这是挺令人\n烦恼的地方呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "274/TALK",
            "narrator": "アーヤ",
            "text": "卯月のことは\n本当にわからないこと\nだらけだったし――",
            "zh": "关于卯月的事\n实在有太多\n搞不懂的地方——",
            "narrator_zh": "绫水"
        },
        {
            "location": "275/TALK",
            "narrator": "アーヤ",
            "text": "過去にも何度かお茶して\n話したことあるけど、\n全然わからないのよ。",
            "zh": "以前也曾几次一起喝茶\n聊过天，可还是\n完全看不透她。",
            "narrator_zh": "绫水"
        },
        {
            "location": "276/TALK",
            "narrator": "アーヤ",
            "text": "空を掴むような\n感じっていうか。",
            "zh": "怎么说呢，就像\n抓空气一样抓不住。",
            "narrator_zh": "绫水"
        },
        {
            "location": "277/TALK",
            "narrator": "アーヤ",
            "text": "だから今回は、少しでも\n情報を集めた方がいいかな\nって思ったんだけど。",
            "zh": "所以这次，我才想着\n哪怕收集一点点情报\n会不会比较好呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "278/TALK",
            "narrator": "アーヤ",
            "text": "でもやっぱり、\n後で後悔しそうなのよね。\nやったことを。",
            "zh": "可果然，真做了的话\n之后还是会\n后悔的吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "279/TALK",
            "narrator": "アーヤ",
            "text": "だから今回はパス。",
            "zh": "所以这次就算了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "280/TALK",
            "narrator": "アーヤ",
            "text": "というわけで、\nその方向で\nお願いしていい？",
            "zh": "总而言之，\n就按这个方向处理\n可以吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "281/SEL",
            "narrator": "",
            "text": "いいよ",
            "zh": "好啊",
            "narrator_zh": ""
        },
        {
            "location": "282/SEL",
            "narrator": "",
            "text": "やだ",
            "zh": "不要",
            "narrator_zh": ""
        },
        {
            "location": "283/ACT",
            "narrator": "",
            "text": "いいよ",
            "zh": "好啊",
            "narrator_zh": ""
        },
        {
            "location": "284/TALK",
            "narrator": "アーヤ",
            "text": "ふふ、ありがと。",
            "zh": "呵呵，谢谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "285/ACT",
            "narrator": "",
            "text": "やだ",
            "zh": "不要",
            "narrator_zh": ""
        },
        {
            "location": "286/TALK",
            "narrator": "アーヤ",
            "text": "ええっ！？",
            "zh": "咦——！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "287/TALK",
            "narrator": "アーヤ",
            "text": "うーん、やっぱり今日の\n$handle$さんは\n何かヘンね。",
            "zh": "唔，果然今天的\n$handle$\n有点奇怪呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "288/TALK",
            "narrator": "アーヤ",
            "text": "もしかして貴方、\nなりすましじゃない？\n正直に白状しなさい。",
            "zh": "难道说你，\n其实是冒牌货吧？\n老实招来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "289/SEL",
            "narrator": "",
            "text": "いつもと同じだよ",
            "zh": "和平时一样啊",
            "narrator_zh": ""
        },
        {
            "location": "290/SEL",
            "narrator": "",
            "text": "そっちこそ、前と違う司書でしょ？",
            "zh": "你才是，和之前的司书不是同一个吧？",
            "narrator_zh": ""
        },
        {
            "location": "291/ACT",
            "narrator": "",
            "text": "いつもと同じだよ",
            "zh": "和平时一样啊",
            "narrator_zh": ""
        },
        {
            "location": "292/TALK",
            "narrator": "アーヤ",
            "text": "どうかしら。",
            "zh": "那可不好说呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "293/TALK",
            "narrator": "アーヤ",
            "text": "とは言っても、\n調べる術はないのよね。",
            "zh": "话虽如此，\n我也没法调查就是了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "294/TALK",
            "narrator": "アーヤ",
            "text": "とにかく信じてるから、\n例えあなたが同じ人でも\n別人でも――",
            "zh": "总之我相信你，\n不管你是同一个人\n还是别人——",
            "narrator_zh": "绫水"
        },
        {
            "location": "295/TALK",
            "narrator": "アーヤ",
            "text": "私のココロの平穏の為にも\nクランは倒して！",
            "zh": "为了我内心的平静，\n也请打倒库兰！",
            "narrator_zh": "绫水"
        },
        {
            "location": "296/SEL",
            "narrator": "",
            "text": "はい、頑張りますよ",
            "zh": "是，我会加油的",
            "narrator_zh": ""
        },
        {
            "location": "297/ACT",
            "narrator": "",
            "text": "はい、頑張りますよ",
            "zh": "是，我会加油的",
            "narrator_zh": ""
        },
        {
            "location": "299/TALK",
            "narrator": "アーヤ",
            "text": "はぁ、よかった。",
            "zh": "呼，太好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "300/ACT",
            "narrator": "",
            "text": "そっちこそ、前と違う司書でしょ？",
            "zh": "你才是，和之前的司书不是同一个吧？",
            "narrator_zh": ""
        },
        {
            "location": "301/TALK",
            "narrator": "アーヤ",
            "text": "はぁ……。\nだから――",
            "zh": "唉……。\n所以我说——",
            "narrator_zh": "绫水"
        },
        {
            "location": "302/TALK",
            "narrator": "アーヤ",
            "text": "って、まあその気持ちは\nわからなくないわね。",
            "zh": "不过嘛，这种心情\n我也不是不能理解呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "303/TALK",
            "narrator": "アーヤ",
            "text": "私だって、貴方が別人じゃ\nないかって疑ったり\nしてるワケだし……。",
            "zh": "就连我自己，不也在\n怀疑你是不是\n换了个人吗……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "304/TALK",
            "narrator": "アーヤ",
            "text": "お互い、それを確定できる\n証拠すら、ろくに取れない\n状況だもの。",
            "zh": "毕竟眼下连能确定\n彼此身份的证据，\n都几乎拿不出来嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "305/TALK",
            "narrator": "アーヤ",
            "text": "とにかく。私は貴方の\nことを信じるから、貴方も\n私を信じて。",
            "zh": "总之。我会相信你，\n所以你也\n相信我吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "306/SEL",
            "narrator": "",
            "text": "はいはい",
            "zh": "好好好",
            "narrator_zh": ""
        },
        {
            "location": "307/ACT",
            "narrator": "",
            "text": "はいはい",
            "zh": "好好好",
            "narrator_zh": ""
        },
        {
            "location": "309/TALK",
            "narrator": "アーヤ",
            "text": "はぁ、よかった。",
            "zh": "呼，太好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "313/SEL",
            "narrator": "",
            "text": "それにしても、判断がガブリエラと正反対で面白い",
            "zh": "不过话说回来，你的判断跟加布里埃拉正好相反，真有意思",
            "narrator_zh": ""
        },
        {
            "location": "314/ACT",
            "narrator": "",
            "text": "それにしても、判断がガブリエラと正反対で面白い",
            "zh": "不过话说回来，你的判断跟加布里埃拉正好相反，真有意思",
            "narrator_zh": ""
        },
        {
            "location": "316/TALK",
            "narrator": "アーヤ",
            "text": "え？　それって、\nギャヴィも卯月のことで\n悩んでたってこと？",
            "zh": "咦？　这么说，\n加维也在为卯月的事\n烦恼过吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "317/SEL",
            "narrator": "",
            "text": "そう。そして「ちゃんと相手を知る」ことを選んでる",
            "zh": "对。而且她选择了“好好去了解对方”",
            "narrator_zh": ""
        },
        {
            "location": "318/ACT",
            "narrator": "",
            "text": "そう。そして「ちゃんと相手を知る」ことを選んでる",
            "zh": "对。而且她选择了“好好去了解对方”",
            "narrator_zh": ""
        },
        {
            "location": "320/TALK",
            "narrator": "アーヤ",
            "text": "…そうなのね。",
            "zh": "……是这样啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "321/TALK",
            "narrator": "アーヤ",
            "text": "やっぱりギャヴィは\n凄いわ。",
            "zh": "加维果然\n很了不起呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "322/TALK",
            "narrator": "アーヤ",
            "text": "貴方はどう思う？",
            "zh": "你怎么看？",
            "narrator_zh": "绫水"
        },
        {
            "location": "323/SEL",
            "narrator": "",
            "text": "アーヤの考えに近い",
            "zh": "更接近绫水的想法",
            "narrator_zh": ""
        },
        {
            "location": "324/SEL",
            "narrator": "",
            "text": "ガブリエラの考えに近い",
            "zh": "更接近加布里埃拉的想法",
            "narrator_zh": ""
        },
        {
            "location": "325/ACT",
            "narrator": "",
            "text": "アーヤの考えに近い",
            "zh": "更接近绫水的想法",
            "narrator_zh": ""
        },
        {
            "location": "326/TALK",
            "narrator": "アーヤ",
            "text": "ふふ、ありがと。\n嘘でも嬉しい。",
            "zh": "呵呵，谢谢。\n哪怕是哄我的也很开心。",
            "narrator_zh": "绫水"
        },
        {
            "location": "327/TALK",
            "narrator": "アーヤ",
            "text": "正直、自分のそういう所\n臆病で嫌いなの。",
            "zh": "说实话，我自己很讨厌\n自己这种胆小的地方。",
            "narrator_zh": "绫水"
        },
        {
            "location": "328/TALK",
            "narrator": "アーヤ",
            "text": "でも、そう言って\nもらえると、少しだけ\n許された気がするから。",
            "zh": "不过，能听你这么说，\n就觉得自己似乎稍微\n被原谅了一点。",
            "narrator_zh": "绫水"
        },
        {
            "location": "329/TALK",
            "narrator": "アーヤ",
            "text": "これからも貴方には、\nずっと綾水の傍に\nいて欲しい。",
            "zh": "今后也希望你，\n能一直留在\n绫水的身边。",
            "narrator_zh": "绫水"
        },
        {
            "location": "330/ACT",
            "narrator": "",
            "text": "ガブリエラの考えに近い",
            "zh": "更接近加布里埃拉的想法",
            "narrator_zh": ""
        },
        {
            "location": "331/TALK",
            "narrator": "アーヤ",
            "text": "やっぱりそうよね。",
            "zh": "果然是这样呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "332/TALK",
            "narrator": "アーヤ",
            "text": "貴方はギャヴィにとって\nいいパートナーに\nなれると思うわ。",
            "zh": "我觉得你对加维而言，\n能成为一个\n很好的搭档哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "あの子の性格や思想は、\n日本で暮らすにはちょっと\n辛いかもって思う。",
            "zh": "那孩子的性格和想法，\n要在日本生活的话，\n或许会有点辛苦呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "でも、貴方みたいに彼女に\n共感出来る人が傍にいれば\nきっと幸せだと思うの。",
            "zh": "不过，如果有像你这样\n能理解她的人在身边，\n她一定会很幸福的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "335/TALK",
            "narrator": "アーヤ",
            "text": "だから、これからも\nギャヴィのことを\n宜しくお願いね。",
            "zh": "所以，今后也请\n多多关照\n加维哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "338/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、行くわよ？",
            "zh": "那么，要出发咯？",
            "narrator_zh": "绫水"
        },
        {
            "location": "339/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！",
            "zh": "祝愿$handle$与\n国政绫水，\n拥有一段美妙的心灵之旅！",
            "narrator_zh": "绫水"
        },
        {
            "location": "22/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月27日　2:22 PM</color>\nとある夏休み直前の平日、寮「とらいあんぐる」アーヤの部屋。",
            "zh": "<color=green>7月27日　2:22 PM</color>\n暑假前夕的某工作日，宿舍“三角”绫水的房间。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "121/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch01",
            "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>在逢濑燕的心灵之中\n战斗开始了。</b></size></color>\n\n\n\n\n\n在她的心灵之中，\n正产生巨大的纠葛。\n\n请潜入心灵领域，\n消除逢濑燕内心的纠葛。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch01"
        },
        {
            "location": "123/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch02",
            "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>在国政绫水的心灵之中\n战斗开始了。</b></size></color>\n\n\n\n\n\n在她的心灵之中，\n正产生巨大的纠葛。\n\n请潜入心灵领域，\n消除国政绫水内心的纠葛。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch02"
        },
        {
            "location": "125/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch03",
            "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>在加布里埃拉的心灵之中\n战斗开始了。</b></size></color>\n\n\n\n\n\n在她的心灵之中，\n正产生巨大的纠葛。\n\n请潜入心灵领域，\n消除加布里埃拉内心的纠葛。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch03"
        },
        {
            "location": "127/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch04",
            "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>在恋之崎雅的心灵之中\n战斗开始了。</b></size></color>\n\n\n\n\n\n在她的心灵之中，\n正产生巨大的纠葛。\n\n请潜入心灵领域，\n消除恋之崎雅内心的纠葛。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch04"
