        {
            "location": "5152/TALK",
            "narrator": "神楽",
            "text": "２．５次元舞台ってあるじゃないですかー",
            "zh": "有2.5次元舞台吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "5153/TALK",
            "narrator": "神楽",
            "text": "ぴょんこ０．５の部分が気になってしょうがないんですけどー？",
            "zh": "蹦子在意那个0.5的部分，在意得不得了——？",
            "narrator_zh": "神乐"
        },
        {
            "location": "5155/SEL",
            "narrator": "",
            "text": "人の子よ…ついに次元の隙間に気付いてしまったのか…",
            "zh": "人之子啊……终于注意到次元的缝隙了吗……",
            "narrator_zh": ""
        },
        {
            "location": "5156/SEL",
            "narrator": "",
            "text": "いや別に",
            "zh": "不，也没什么",
            "narrator_zh": ""
        },
        {
            "location": "5157/SEL",
            "narrator": "",
            "text": "どっちつかずだよね",
            "zh": "两边都不靠吧",
            "narrator_zh": ""
        },
        {
            "location": "5158/ACT",
            "narrator": "",
            "text": "人の子よ…ついに次元の隙間に気付いてしまったのか…",
            "zh": "人之子啊……终于注意到次元的缝隙了吗……",
            "narrator_zh": ""
        },
        {
            "location": "5160/TALK",
            "narrator": "神楽",
            "text": "おお神よ、、、",
            "zh": "哦哦神啊……",
            "narrator_zh": "神乐"
        },
        {
            "location": "5162/TALK",
            "narrator": "神楽",
            "text": "これが深淵に至る隙間なのですね、、、",
            "zh": "这就是通往深渊的缝隙吗……",
            "narrator_zh": "神乐"
        },
        {
            "location": "5163/ACT",
            "narrator": "",
            "text": "いや別に",
            "zh": "不，也没什么",
            "narrator_zh": ""
        },
        {
            "location": "5164/TALK",
            "narrator": "神楽",
            "text": "あれ変だな",
            "zh": "咦，好奇怪",
            "narrator_zh": "神乐"
        },
        {
            "location": "5165/ACT",
            "narrator": "",
            "text": "どっちつかずだよね",
            "zh": "两边都不靠吧",
            "narrator_zh": ""
        },
        {
            "location": "5166/TALK",
            "narrator": "神楽",
            "text": "でしょー？",
            "zh": "对吧——？",
            "narrator_zh": "神乐"
        },
        {
            "location": "5168/TALK",
            "narrator": "神楽",
            "text": "いや意図してることはわかるぴょん",
            "zh": "意图我是懂的pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "5169/TALK",
            "narrator": "神楽",
            "text": "二次元でも三次元でもないんだ！むしろ両方のいいとこどりなんだ！みたいなさ！",
            "zh": "既不是二次元也不是三次元！不如说是两边的优点都占了！之类的！",
            "narrator_zh": "神乐"
        },
        {
            "location": "5170/TALK",
            "narrator": "神楽",
            "text": "でもほら、、、正直どっちのよさもなくなってるっていうか、、、ちょっとアレだよね！？ってのもあるからさ、、、",
            "zh": "可是你看……老实说两边的好处都没了，有点那个吧！？也是有的……",
            "narrator_zh": "神乐"
        },
        {
            "location": "5172/SEL",
            "narrator": "",
            "text": "ああ（察し）",
            "zh": "啊啊（领会）",
            "narrator_zh": ""
        },
        {
            "location": "5173/SEL",
            "narrator": "",
            "text": "それ言っちゃいけないやつ",
            "zh": "那种话不能说",
            "narrator_zh": ""
        },
        {
            "location": "5174/SEL",
            "narrator": "",
            "text": "神楽はいつでも最高でしょ？",
            "zh": "神乐什么时候都是最棒的吧？",
            "narrator_zh": ""
        },
        {
            "location": "5175/ACT",
            "narrator": "",
            "text": "ああ（察し）",
            "zh": "啊啊（领会）",
            "narrator_zh": ""
        },
        {
            "location": "5176/TALK",
            "narrator": "神楽",
            "text": "あれは誰得なんだろうね？",
            "zh": "那个是便宜了谁啊？",
            "narrator_zh": "神乐"
        },
        {
            "location": "5178/TALK",
            "narrator": "神楽",
            "text": "ほんとどうにかならないのかなー",
            "zh": "真的不能想想办法吗",
            "narrator_zh": "神乐"
        },
        {
            "location": "5179/ACT",
            "narrator": "",
            "text": "それ言っちゃいけないやつ",
            "zh": "那种话不能说",
            "narrator_zh": ""
        },
        {
            "location": "5180/TALK",
            "narrator": "神楽",
            "text": "あえてタブーに切り込むのがぴょんこだから！",
            "zh": "故意切入禁忌，才是蹦子！",
            "narrator_zh": "神乐"
        },
        {
            "location": "5181/TALK",
            "narrator": "神楽",
            "text": "本当は$handlek$もそう思ってるんでしょ？",
            "zh": "其实$handlek$也这么想吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "5182/TALK",
            "narrator": "神楽",
            "text": "素直になるぴょん♪",
            "zh": "变得坦率pyon♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "5183/ACT",
            "narrator": "",
            "text": "神楽はいつでも最高でしょ？",
            "zh": "神乐什么时候都是最棒的吧？",
            "narrator_zh": ""
        },
        {
            "location": "5185/TALK",
            "narrator": "神楽",
            "text": "そんな話してないしー",
            "zh": "我可没在说那种话——",
            "narrator_zh": "神乐"
        },
        {
            "location": "5186/TALK",
            "narrator": "神楽",
            "text": "でも$handlek$がぴょんこのこと好きで好きで好きで好きで仕方ないことは理解いたしました",
            "zh": "不过$handlek$喜欢蹦子喜欢到没办法这件事，我理解了",
            "narrator_zh": "神乐"
        },
        {
            "location": "5187/TALK",
            "narrator": "神楽",
            "text": "かわいいね$handlek$♪",
            "zh": "好可爱呢$handlek$♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "5189/TALK",
            "narrator": "神楽",
            "text": "なでなでしてあげるぴょん",
            "zh": "摸摸你pyon",
            "narrator_zh": "神乐"
        }
    ]
