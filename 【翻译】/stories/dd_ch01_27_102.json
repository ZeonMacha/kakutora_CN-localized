            "narrator_zh": ""
        },
        {
            "location": "659/ACT",
            "narrator": "",
            "text": "大好きだよ",
            "zh": "最喜欢你了",
            "narrator_zh": ""
        },
        {
            "location": "660/ACT",
            "narrator": "",
            "text": "愛してる",
            "zh": "我爱你",
            "narrator_zh": ""
        },
        {
            "location": "674/TALK",
            "narrator": "つばめ",
            "text": "…本当に何なの…？",
            "zh": "……到底怎么回事啊……？",
            "narrator_zh": "燕"
        },
        {
            "location": "676/TALK",
            "narrator": "つばめ",
            "text": "全然わからないよ……。",
            "zh": "完全搞不懂呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "683/TALK",
            "narrator": "つばめ",
            "text": "！",
            "zh": "！",
            "narrator_zh": "燕"
        },
        {
            "location": "690/TALK",
            "narrator": "千羽鶴",
            "text": "見つけた。",
            "zh": "找到了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "692/TALK",
            "narrator": "千羽鶴",
            "text": "鬼ごっこ\n楽しかったでしょ。",
            "zh": "捉迷藏\n很好玩吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "693/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "694/TALK",
            "narrator": "千羽鶴",
            "text": "次はあなたが\n鬼の番。",
            "zh": "接下来轮到你\n当鬼。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "695/TALK",
            "narrator": "つばめ",
            "text": "…あなたは誰ですか…？",
            "zh": "……你是谁……？",
            "narrator_zh": "燕"
        },
        {
            "location": "696/TALK",
            "narrator": "千羽鶴",
            "text": "私のことは\nまた改めて\n教えてあげる。",
            "zh": "关于我的事\n改天再\n告诉你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "697/TALK",
            "narrator": "千羽鶴",
            "text": "今は鬼ごっこを\n続けるの。",
            "zh": "现在要继续玩\n捉迷藏。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "698/TALK",
            "narrator": "千羽鶴",
            "text": "鬼さんは最初\n目隠しして\n待たないと。",
            "zh": "当鬼的人一开始\n得蒙上眼睛\n等着才行。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "699/TALK",
            "narrator": "千羽鶴",
            "text": "…でも。\n目隠しがないから\n代わりに眠って。",
            "zh": "……不过。\n没有蒙眼布，\n就用睡着代替吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "700/TALK",
            "narrator": "つばめ",
            "text": "…っ！",
            "zh": "……唔！",
            "narrator_zh": "燕"
        },
        {
            "location": "701/TALK",
            "narrator": "つばめ",
            "text": "……………………。",
            "zh": "……………………。",
            "narrator_zh": "燕"
        },
        {
            "location": "709/TALK",
            "narrator": "千羽鶴",
            "text": "さて。",
            "zh": "好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "712/TALK",
            "narrator": "千羽鶴",
            "text": "多分、この辺。",
            "zh": "大概，这附近。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "713/TALK",
            "narrator": "千羽鶴",
            "text": "ごきげんよう。",
            "zh": "贵安。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "714/SEL",
            "narrator": "",
            "text": "千羽鶴！？",
            "zh": "千羽鹤！？",
            "narrator_zh": ""
        },
        {
            "location": "715/ACT",
            "narrator": "",
            "text": "千羽鶴！？",
            "zh": "千羽鹤！？",
            "narrator_zh": ""
        },
        {
            "location": "717/TALK",
            "narrator": "千羽鶴",
            "text": "$handle$と\n現実で会うのは\n初めてね。",
            "zh": "和$handle$\n在现实里见面，\n还是第一次吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "718/TALK",
            "narrator": "千羽鶴",
            "text": "とても新鮮。",
            "zh": "非常新鲜。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "719/SEL",
            "narrator": "",
            "text": "これは一体どうなってるの！？",
            "zh": "这到底是怎么回事！？",
            "narrator_zh": ""
        },
        {
            "location": "720/ACT",
            "narrator": "",
            "text": "これは一体どうなってるの！？",
            "zh": "这到底是怎么回事！？",
            "narrator_zh": ""
        },
        {
            "location": "722/TALK",
            "narrator": "千羽鶴",
            "text": "私はあの場から\n閉め出されてしまった。",
            "zh": "我被从那个地方\n关在门外了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "723/TALK",
            "narrator": "千羽鶴",
            "text": "貴方には迷惑かけたと\n思ってるけど、１点だけ\n聞きたいことがある。",
            "zh": "我觉得给你\n添麻烦了，不过只有一点\n想问你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "724/TALK",
            "narrator": "千羽鶴",
            "text": "今、國政領火がOSの\nアドミニストレーターに\nなっているわけだけど。",
            "zh": "现在，国政领火成了\nOS的\n管理员，",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "725/TALK",
            "narrator": "千羽鶴",
            "text": "貴方が彼女に\n協力しているのは、本意？\nそれとも不本意？",
            "zh": "你配合她，\n是本意？\n还是非本意？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "726/SEL",
            "narrator": "",
            "text": "エリカに同意して協力してる",
            "zh": "我赞同领火所以配合她",
            "narrator_zh": ""
        },
        {
            "location": "727/SEL",
            "narrator": "",
            "text": "千羽鶴に協力したいけどエリカに邪魔されてる",
            "zh": "我想配合千羽鹤但被领火妨碍了",
            "narrator_zh": ""
        },
        {
            "location": "728/ACT",
            "narrator": "",
            "text": "エリカに同意して協力してる",
            "zh": "我赞同领火所以配合她",
            "narrator_zh": ""
        },
        {
            "location": "730/TALK",
            "narrator": "千羽鶴",
            "text": "そう。",
            "zh": "是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "731/TALK",
            "narrator": "千羽鶴",
            "text": "貴方は私の目指す\n輝ける未来には\n賛同していなかったのね。",
            "zh": "你并不赞同\n我所追求的\n光辉未来啊。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "733/ACT",
            "narrator": "",
            "text": "千羽鶴に協力したいけどエリカに邪魔されてる",
            "zh": "我想配合千羽鹤但被领火妨碍了",
            "narrator_zh": ""
        },
        {
            "location": "734/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。",
            "zh": "原来如此。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "735/TALK",
            "narrator": "千羽鶴",
            "text": "それならまずは\nひと安心。",
            "zh": "那样的话我首先\n放心了一点。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "738/TALK",
            "narrator": "千羽鶴",
            "text": "ただ、\nどちらにしても。",
            "zh": "只是，\n无论哪一种。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "739/TALK",
            "narrator": "千羽鶴",
            "text": "結果として世界は\n大きく動いてしまった。",
            "zh": "结果上世界还是\n发生了巨大的变动。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "740/TALK",
            "narrator": "千羽鶴",
            "text": "もはや\n収拾がつかないほどに。",
            "zh": "已经到了\n难以收拾的地步。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "741/TALK",
            "narrator": "千羽鶴",
            "text": "そのため、\n更に計画を変更\nせざるを得なくなった。",
            "zh": "为此，\n我也不得不\n进一步修改计划。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "742/TALK",
            "narrator": "千羽鶴",
            "text": "貴方に迷惑をかける\nつもりはない。",
            "zh": "我无意给你\n添麻烦。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "743/TALK",
            "narrator": "千羽鶴",
            "text": "ただ、万一貴方にとって\n納得できないような状況に\nなったとしても――",
            "zh": "只是，万一出现了\n让你无法接受的\n状况——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "744/TALK",
            "narrator": "千羽鶴",
            "text": "今回ばかりは、もはや\n話し合ったりしている\n時間はない。",
            "zh": "唯独这一次，已经\n没有慢慢商量的\n时间了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "745/TALK",
            "narrator": "千羽鶴",
            "text": "だから、その時の為に\n最初に謝っておく。",
            "zh": "所以，为了到时候，\n我先在这里道个歉。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "746/TALK",
            "narrator": "千羽鶴",
            "text": "けど、それでも尚、\n逢瀬つばめを始めとする\n彼女たちを支えて欲しい。",
            "zh": "不过，即便如此，\n我还是希望你继续支持\n以逢濑燕为首的她们。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "747/TALK",
            "narrator": "千羽鶴",
            "text": "彼女たちが、彼女たちで\nあり続ける最期の時まで。",
            "zh": "直到她们还能作为\n她们自己的最后一刻为止。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "750/TALK",
            "narrator": "千羽鶴",
            "text": "逢瀬つばめを\n捕獲して。",
            "zh": "把逢濑燕\n抓起来。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "751/TALK",
            "narrator": "千羽鶴",
            "text": "幇助未遂の実行犯たちは\n事が済むまで謹慎処分。",
            "zh": "协助未遂的实行犯们，\n在事情了结前给予禁足处分。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "752/TALK",
            "narrator": "通常攻撃隊Ａ",
            "text": "はっ。",
            "zh": "是。",
            "narrator_zh": "普通攻击队A"
        },
        {
            "location": "754/SEL",
            "narrator": "",
            "text": "千羽鶴！",
            "zh": "千羽鹤！",
            "narrator_zh": ""
        },
        {
            "location": "755/ACT",
            "narrator": "",
            "text": "千羽鶴！",
            "zh": "千羽鹤！",
            "narrator_zh": ""
        },
        {
            "location": "759/TALK",
            "narrator": "千羽鶴",
            "text": "何？",
            "zh": "什么？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "760/SEL",
            "narrator": "",
            "text": "千羽鶴はナビの千羽鶴と同じなの？",
            "zh": "千羽鹤和导航的千羽鹤是同一个吗？",
            "narrator_zh": ""
        },
        {
            "location": "761/SEL",
            "narrator": "",
            "text": "計画通りにはさせない",
            "zh": "不会让你按计划得逞的",
            "narrator_zh": ""
        },
        {
            "location": "762/SEL",
            "narrator": "",
            "text": "本当に千羽鶴は何なの？",
            "zh": "千羽鹤你到底是什么？",
            "narrator_zh": ""
        },
        {
            "location": "763/ACT",
            "narrator": "",
            "text": "千羽鶴はナビの千羽鶴と同じなの？",
            "zh": "千羽鹤和导航的千羽鹤是同一个吗？",
            "narrator_zh": ""
        },
        {
            "location": "765/TALK",
            "narrator": "千羽鶴",
            "text": "同じ。",
            "zh": "同一个。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "767/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃ。",
            "zh": "那么再会。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "768/ACT",
            "narrator": "",
            "text": "計画通りにはさせない",
            "zh": "不会让你按计划得逞的",
            "narrator_zh": ""
        },
        {
            "location": "770/TALK",
            "narrator": "千羽鶴",
            "text": "そう。\nそれは残念。",
            "zh": "是的。\n那真是遗憾。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "771/TALK",
            "narrator": "千羽鶴",
            "text": "ならば貴方はもう\n障害でしかない。",
            "zh": "既然如此，你现在\n就只是障碍罢了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "772/TALK",
            "narrator": "千羽鶴",
            "text": "いずれ私は\nアドミニストレーターに\n復帰する。",
            "zh": "迟早我会\n重回\n管理员之位。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "773/TALK",
            "narrator": "千羽鶴",
            "text": "その時は、\n貴方との回線を\n切断することにする。",
            "zh": "到那时，\n我会切断\n与你的线路。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "774/TALK",
            "narrator": "千羽鶴",
            "text": "その日まで、\nごきげんよう。",
            "zh": "直到那天到来，\n贵安。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "775/ACT",
            "narrator": "",
            "text": "本当に千羽鶴は何なの？",
            "zh": "千羽鹤你到底是什么？",
            "narrator_zh": ""
        },
        {
            "location": "777/TALK",
            "narrator": "千羽鶴",
            "text": "その質問は、\n漠然とし過ぎていて\n回答できない。",
            "zh": "那个问题\n太过宽泛，\n无法回答。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "778/TALK",
            "narrator": "千羽鶴",
            "text": "いずれ私は\nアドミニストレーターに\n復帰する。",
            "zh": "迟早我会\n重回\n管理员之位。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "779/TALK",
            "narrator": "千羽鶴",
            "text": "その時には、貴方と\n本気の話をしようと\n思っている。",
            "zh": "到那时，我打算\n和你认真\n谈一谈。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "780/TALK",
            "narrator": "千羽鶴",
            "text": "その日まで、\nごきげんよう。",
            "zh": "直到那天到来，\n贵安。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "793/DIALOG",
            "narrator": "Dialog_chapter_ch01",
            "text": "【22 トークン・リング】",
            "zh": "【22 令牌环网】",
            "narrator_zh": "Dialog_chapter_ch01"
        }
    ]
}
