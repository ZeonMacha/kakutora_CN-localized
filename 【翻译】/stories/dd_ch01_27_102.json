    "entry": [
        {
            "location": "520/SCENARIO",
            "narrator": "",
            "text": "後ろの正面だあれ",
            "zh": "背后正面是谁",
            "narrator_zh": ""
        },
        {
            "location": "538/TALK",
            "narrator": "つばめ",
            "text": "まあいいや、\n$handle1$が\nわからなくても。",
            "zh": "算了，\n就算$handle1$\n搞不清楚也没事。",
            "narrator_zh": "燕"
        },
        {
            "location": "539/TALK",
            "narrator": "つばめ",
            "text": "そんなことより、\n何とかここから\n逃げなくちゃ……",
            "zh": "比起那个，\n我得想办法\n从这里逃出去才行……",
            "narrator_zh": "燕"
        },
        {
            "location": "552/TALK",
            "narrator": "つばめ",
            "text": "なんで急にお話してくれなくなっちゃったのかはわからないけど",
            "zh": "虽然不知道你为什么突然就不和我说话了",
            "narrator_zh": "燕"
        },
        {
            "location": "553/TALK",
            "narrator": "つばめ",
            "text": "今はそれより頑張って逃げなくちゃだから",
            "zh": "但现在更重要的是我得努力逃出去",
            "narrator_zh": "燕"
        },
        {
            "location": "554/TALK",
            "narrator": "つばめ",
            "text": "ぁたしもしばらく音信不通になるょ",
            "zh": "我也会暂时失联一阵子哦",
            "narrator_zh": "燕"
        },
        {
            "location": "555/TALK",
            "narrator": "つばめ",
            "text": "お互いがんばろぅ",
            "zh": "我们一起加油吧",
            "narrator_zh": "燕"
        },
        {
            "location": "556/SEL",
            "narrator": "",
            "text": "つばめ待って！",
            "zh": "燕等一下！",
            "narrator_zh": ""
        },
        {
            "location": "557/ACT",
            "narrator": "",
            "text": "つばめ待って！",
            "zh": "燕等一下！",
            "narrator_zh": ""
        },
        {
            "location": "571/TALK",
            "narrator": "つばめ",
            "text": "よし！",
            "zh": "好！",
            "narrator_zh": "燕"
        },
        {
            "location": "573/TALK",
            "narrator": "つばめ",
            "text": "……返事して\nもらえるかな……。",
            "zh": "……能得到\n你的回复吗……。",
            "narrator_zh": "燕"
        },
        {
            "location": "574/TALK",
            "narrator": "つばめ",
            "text": "もらえなかったら\nどうしよう……。",
            "zh": "要是没有回复\n该怎么办……。",
            "narrator_zh": "燕"
        },
        {
            "location": "587/TALK",
            "narrator": "つばめ",
            "text": "いてくれますか",
            "zh": "你在吗",
            "narrator_zh": "燕"
        },
        {
            "location": "588/TALK",
            "narrator": "つばめ",
            "text": "まだお話ししてくれますか",
            "zh": "还会再跟我说话吗",
            "narrator_zh": "燕"
        },
        {
            "location": "591/TALK",
            "narrator": "つばめ",
            "text": "ぇと",
            "zh": "那个",
            "narrator_zh": "燕"
        },
        {
            "location": "592/TALK",
            "narrator": "つばめ",
            "text": "ぁたしの気持ちだけ",
            "zh": "姑且把我的心意",
            "narrator_zh": "燕"
        },
        {
            "location": "593/TALK",
            "narrator": "つばめ",
            "text": "伝えてぉくね",
            "zh": "先告诉你呀",
            "narrator_zh": "燕"
        },
        {
            "location": "594/TALK",
            "narrator": "つばめ",
            "text": "ぃつもぁりがとぅ",
            "zh": "一直都很谢谢你",
            "narrator_zh": "燕"
        },
        {
            "location": "595/TALK",
            "narrator": "つばめ",
            "text": "それから",
            "zh": "还有就是",
            "narrator_zh": "燕"
        },
        {
            "location": "596/TALK",
            "narrator": "つばめ",
            "text": "甘えすぎててごめんね",
            "zh": "总是对你过分撒娇，对不起呀",
            "narrator_zh": "燕"
        },
        {
            "location": "598/TALK",
            "narrator": "つばめ",
            "text": "きっと$handle1$は",
            "zh": "$handle1$一定是",
            "narrator_zh": "燕"
        },
        {
            "location": "599/TALK",
            "narrator": "つばめ",
            "text": "ぁたしが甘えすぎって",
            "zh": "觉得我太爱撒娇",
            "narrator_zh": "燕"
        },
        {
            "location": "600/TALK",
            "narrator": "つばめ",
            "text": "心配してくれてるんだょね",
            "zh": "才为我担心的对吧",
            "narrator_zh": "燕"
        },
        {
            "location": "601/TALK",
            "narrator": "つばめ",
            "text": "気をつけます",
            "zh": "我会注意的",
            "narrator_zh": "燕"
        },
        {
            "location": "603/SEL",
            "narrator": "",
            "text": "そうじゃない",
            "zh": "不是那样",
            "narrator_zh": ""
        },
        {
            "location": "604/SEL",
            "narrator": "",
            "text": "多少はそれもあるけど",
            "zh": "多少是有那么一点啦",
            "narrator_zh": ""
        },
        {
            "location": "605/SEL",
            "narrator": "",
            "text": "うんと甘えて欲しいけど",
            "zh": "其实我希望你尽管撒娇呀",
            "narrator_zh": ""
        },
        {
            "location": "606/TALK",
            "narrator": "つばめ",
            "text": "それで",
            "zh": "而且",
            "narrator_zh": "燕"
        },
        {
            "location": "607/TALK",
            "narrator": "つばめ",
            "text": "ぁたしちゃんと",
            "zh": "我会好好地",
            "narrator_zh": "燕"
        },
        {
            "location": "608/TALK",
            "narrator": "つばめ",
            "text": "自分で決めるから",
            "zh": "自己做决定的",
            "narrator_zh": "燕"
        },
        {
            "location": "609/TALK",
            "narrator": "つばめ",
            "text": "$handle1$の",
            "zh": "绝不会怪到$handle1$",
            "narrator_zh": "燕"
        },
        {
            "location": "610/TALK",
            "narrator": "つばめ",
            "text": "せいになんて",
            "zh": "头上去",
            "narrator_zh": "燕"
        },
        {
            "location": "611/TALK",
            "narrator": "つばめ",
            "text": "しないから",
            "zh": "的呀",
            "narrator_zh": "燕"
        },
        {
            "location": "612/ACT",
            "narrator": "",
            "text": "そうじゃない",
            "zh": "不是那样",
            "narrator_zh": ""
        },
        {
            "location": "613/ACT",
            "narrator": "",
            "text": "多少はそれもあるけど",
            "zh": "多少是有那么一点啦",
            "narrator_zh": ""
        },
        {
            "location": "614/ACT",
            "narrator": "",
            "text": "うんと甘えて欲しいけど",
            "zh": "其实我希望你尽管撒娇呀",
            "narrator_zh": ""
        },
        {
            "location": "618/SEL",
            "narrator": "",
            "text": "何かを仕組まれてるから",
            "zh": "因为有人暗中做了手脚",
            "narrator_zh": ""
        },
        {
            "location": "619/SEL",
            "narrator": "",
            "text": "$me$の選択肢がちゃんと表示されないから",
            "zh": "因为$me$的选项没能正常显示",
            "narrator_zh": ""
        },
        {
            "location": "620/SEL",
            "narrator": "",
            "text": "バグがひどいから",
            "zh": "因为Bug太严重了",
            "narrator_zh": ""
        },
        {
            "location": "621/SEL",
            "narrator": "",
            "text": "言いたいことが伝わらないんだ",
            "zh": "我想说的话传达不到你那里",
            "narrator_zh": ""
        },
        {
            "location": "622/SEL",
            "narrator": "",
            "text": "つばめのことが大好きだから",
            "zh": "因为最喜欢燕了",
            "narrator_zh": ""
        },
        {
            "location": "623/SEL",
            "narrator": "",
            "text": "つばめを酷い目に遭わせたくないから",
            "zh": "因为不想让燕遭遇过分的事",
            "narrator_zh": ""
        },
        {
            "location": "624/ACT",
            "narrator": "",
            "text": "下着は上下揃えた方がいいよ",
            "zh": "内衣最好穿成套的哦",
            "narrator_zh": ""
        },
        {
            "location": "625/TALK",
            "narrator": "つばめ",
            "text": "ぇ",
            "zh": "哎",
            "narrator_zh": "燕"
        },
        {
            "location": "627/TALK",
            "narrator": "つばめ",
            "text": "何で知ってるの",
            "zh": "怎么连这种事",
            "narrator_zh": "燕"
        },
        {
            "location": "628/TALK",
            "narrator": "つばめ",
            "text": "そんなこと",
            "zh": "你都知道",
            "narrator_zh": "燕"
        },
        {
            "location": "629/ACT",
            "narrator": "",
            "text": "かき氷って頭キーンってなるよね",
            "zh": "吃刨冰会冰得脑袋发疼呀",
            "narrator_zh": ""
        },
        {
            "location": "630/TALK",
            "narrator": "つばめ",
            "text": "ぇと",
            "zh": "那个",
            "narrator_zh": "燕"
        },
        {
            "location": "631/TALK",
            "narrator": "つばめ",
            "text": "何でそんな話になるの",
            "zh": "怎么突然说起这个",
            "narrator_zh": "燕"
        },
        {
            "location": "632/ACT",
            "narrator": "",
            "text": "小テストの勉強した？",
            "zh": "小测验复习了吗？",
            "narrator_zh": ""
        },
        {
            "location": "633/TALK",
            "narrator": "つばめ",
            "text": "そんな余裕なぃょ",
            "zh": "没那份余裕呀",
            "narrator_zh": "燕"
        },
        {
            "location": "634/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "燕"
        },
        {
            "location": "635/TALK",
            "narrator": "つばめ",
            "text": "しとかなきゃだね",
            "zh": "确实得复习才行呀",
            "narrator_zh": "燕"
        },
        {
            "location": "636/ACT",
            "narrator": "",
            "text": "ポケベルって知ってる？",
            "zh": "你知道BP机吗？",
            "narrator_zh": ""
        },
        {
            "location": "637/TALK",
            "narrator": "つばめ",
            "text": "それ何？",
            "zh": "那是什么？",
            "narrator_zh": "燕"
        },
        {
            "location": "638/ACT",
            "narrator": "",
            "text": "つばめのことが大好きだから",
            "zh": "因为最喜欢燕了",
            "narrator_zh": ""
        },
        {
            "location": "639/TALK",
            "narrator": "つばめ",
            "text": "ぅん",
            "zh": "嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "640/TALK",
            "narrator": "つばめ",
            "text": "そぅ思ってて",
            "zh": "我可以",
            "narrator_zh": "燕"
        },
        {
            "location": "641/TALK",
            "narrator": "つばめ",
            "text": "ぃぃんだょね？",
            "zh": "这么认为对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "642/ACT",
            "narrator": "",
            "text": "これから映画観るから",
            "zh": "待会儿要去看电影",
            "narrator_zh": ""
        },
        {
            "location": "643/TALK",
            "narrator": "つばめ",
            "text": "ぇと",
            "zh": "那个",
            "narrator_zh": "燕"
        },
        {
            "location": "644/TALK",
            "narrator": "つばめ",
            "text": "忙しいんだね",
            "zh": "你挺忙的呀",
            "narrator_zh": "燕"
        },
        {
            "location": "647/SEL",
            "narrator": "",
            "text": "大好きだから",
            "zh": "因为最喜欢你了",
            "narrator_zh": ""
        },
        {
            "location": "648/SEL",
            "narrator": "",
            "text": "世界で一番かわいいよ、つばめ",
            "zh": "燕是世界上最可爱的哦",
            "narrator_zh": ""
        },
        {
            "location": "649/SEL",
            "narrator": "",
            "text": "愛してることは信じてほしい",
            "zh": "希望你相信我爱你",
            "narrator_zh": ""
        },
        {
            "location": "650/ACT",
            "narrator": "",
            "text": "大好きだから",
            "zh": "因为最喜欢你了",
            "narrator_zh": ""
        },
        {
            "location": "651/ACT",
            "narrator": "",
            "text": "世界で一番かわいいよ、つばめ",
            "zh": "燕是世界上最可爱的哦",
            "narrator_zh": ""
        },
        {
            "location": "652/ACT",
            "narrator": "",
            "text": "愛してることは信じてほしい",
            "zh": "希望你相信我爱你",
            "narrator_zh": ""
        },
        {
            "location": "655/SEL",
            "narrator": "",
            "text": "元気でね",
            "zh": "保重哦",
            "narrator_zh": ""
        },
        {
            "location": "656/SEL",
            "narrator": "",
            "text": "大好きだよ",
            "zh": "最喜欢你了",
