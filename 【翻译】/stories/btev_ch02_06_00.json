{
    "dir": "chap06/battle/btev_ch02_06_00.js",
    "type": "",
    "info": {
        "story_id": "22007",
        "cid": "",
        "title": "007 ココロスフィアストーリー【Lv03】",
        "sub_title": "姉妹の隔絶Ⅰ＜提起＞",
        "title_zh": "007 心灵领域故事【Lv03】",
        "sub_title_zh": "姐妹间的隔阂Ⅰ＜提起＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "姉妹の隔絶・前編１",
            "zh": "姐妹间的隔阂·前篇1",
            "narrator_zh": ""
        },
        {
            "location": "13/DIALOG",
            "narrator": "",
            "text": "<size=40>KOKORO-Lv. 03</size>\nAYAMI - KUNIMASA\n\n<size=45>姉妹の隔絶Ⅰ</size>\n<size=35>～その始まりに関する告白～</size>",
            "zh": "<size=40>KOKORO-Lv. 03</size>\n国政绫水\n\n<size=45>姐妹间的隔阂Ⅰ</size>\n<size=35>～关于那场开端的告白～</size>",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "潜在アーヤ",
            "text": "おーい！\nこっちよ！",
            "zh": "喂——！\n这边哦！",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "24/TALK",
            "narrator": "潜在アーヤ",
            "text": "また会えて嬉しいわ。",
            "zh": "真高兴能再见到你。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "25/SEL",
            "narrator": "（選択肢）",
            "text": "あ、欲求人格のアーヤさん、こんにちは",
            "zh": "啊，欲求人格的绫水，你好",
            "narrator_zh": "（选项）"
        },
        {
            "location": "26/SEL",
            "narrator": "（選択肢）",
            "text": "あ、欲望人格のアーヤさん、こんにちは",
            "zh": "啊，欲望人格的绫水，你好",
            "narrator_zh": "（选项）"
        },
        {
            "location": "27/ACT",
            "narrator": "",
            "text": "あ、欲求人格のアーヤさん、こんにちは",
            "zh": "啊，欲求人格的绫水，你好",
            "narrator_zh": ""
        },
        {
            "location": "30/TALK",
            "narrator": "潜在アーヤ",
            "text": "ふふ。\n覚えていてくれて\nありがと。",
            "zh": "呵呵。\n谢谢你还记得\n我呀。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "31/ACT",
            "narrator": "",
            "text": "あ、欲望人格のアーヤさん、こんにちは",
            "zh": "啊，欲望人格的绫水，你好",
            "narrator_zh": ""
        },
        {
            "location": "33/TALK",
            "narrator": "潜在アーヤ",
            "text": "えー、\n欲望じゃないわよ？\n欲求人格。",
            "zh": "诶——\n才不是欲望好吗？\n是欲求人格。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "潜在アーヤ",
            "text": "まあ、\nどっちでもいいか。",
            "zh": "嘛，\n叫哪个都无所谓啦。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "潜在アーヤ",
            "text": "貴方に興味あったり、\nお近づきになりたい\nのは欲望だものね。",
            "zh": "毕竟对你感兴趣、\n想和你亲近之类的，\n确实算是欲望呢。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "37/SEL",
            "narrator": "（選択肢）",
            "text": "で、こんどは欲求人格さんを支援するってこと？",
            "zh": "所以，这次是要支援欲求人格吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "38/ACT",
            "narrator": "",
            "text": "で、こんどは欲求人格さんを支援するってこと？",
            "zh": "所以，这次是要支援欲求人格吗？",
            "narrator_zh": ""
        },
        {
            "location": "41/TALK",
            "narrator": "潜在アーヤ",
            "text": "あら、頭いいのね。\n私が誘ったんだもの、\nそういう事になるわ。",
            "zh": "哎呀，挺聪明的嘛。\n既然是我邀请你的，\n自然就是这样。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "42/TALK",
            "narrator": "潜在アーヤ",
            "text": "実は今回、どうしても\n打ち負かしたい相手が\nいるの。",
            "zh": "其实这一次，我有个\n无论如何都想打败的\n家伙。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "潜在アーヤ",
            "text": "だから、貴方の力を\n借りたくて。",
            "zh": "所以，才想\n借用一下你的力量。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "44/SEL",
            "narrator": "（選択肢）",
            "text": "どんな相手？",
            "zh": "什么样的对手？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "45/ACT",
            "narrator": "",
            "text": "どんな相手？",
            "zh": "什么样的对手？",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "潜在アーヤ",
            "text": "私の姉を、姉と\n思っていない相手。",
            "zh": "一个没把我姐姐\n当姐姐看的家伙。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "48/TALK",
            "narrator": "潜在アーヤ",
            "text": "貴方は現実で\n見ているはずよ。",
            "zh": "你在现实里\n应该见过的哦。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "潜在アーヤ",
            "text": "現実世界で私が\n「あんなの姉じゃない」\nって言ってるところ。",
            "zh": "就是现实世界里我说着\n“那种人不是姐姐”\n的时候。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "潜在アーヤ",
            "text": "正直、もう和解したい\nのよね、姉とは。",
            "zh": "老实说，我都想和好了\n呀，和姐姐。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "51/TALK",
            "narrator": "潜在アーヤ",
            "text": "いや、和解するって\nいうより、私が一方\n的に嫌ってるだけか。",
            "zh": "不，与其说是和解，\n不如说只是我\n单方面在讨厌她吧。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "52/SEL",
            "narrator": "（選択肢）",
            "text": "何があったのか知りたい。",
            "zh": "我想知道发生过什么。",
            "narrator_zh": "（选项）"
        },
        {
            "location": "53/SEL",
            "narrator": "（選択肢）",
            "text": "酷いお姉さんなんだね！",
            "zh": "真是个糟糕的姐姐啊！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "54/ACT",
            "narrator": "",
            "text": "何があったのか知りたい。",
            "zh": "我想知道发生过什么。",
            "narrator_zh": ""
        },
        {
            "location": "55/TALK",
            "narrator": "潜在アーヤ",
            "text": "そうね。一緒に戦って\nくれるんだから、教え\nておいた方が――",
            "zh": "说得也是。既然你要陪我\n一起战斗，先告诉你\n或许比较好——",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "56/ACT",
            "narrator": "",
            "text": "酷いお姉さんなんだね！",
            "zh": "真是个糟糕的姐姐啊！",
            "narrator_zh": ""
        },
        {
            "location": "57/TALK",
            "narrator": "潜在アーヤ",
            "text": "あら、失礼ね。\n酷くなんてないわよ。",
            "zh": "哎呀，真失礼。\n她才不糟糕呢。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "潜在アーヤ",
            "text": "まあ、そうね、\n強いて言うなら、\n変人？",
            "zh": "嘛，要说的话，\n硬要形容大概是……\n怪人？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "59/TALK",
            "narrator": "潜在アーヤ",
            "text": "うーん…。",
            "zh": "嗯——……。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "潜在アーヤ",
            "text": "一緒に戦ってもらう\nのに、姉を誤解された\nままってのも嫌だし―",
            "zh": "请你和我一起战斗，\n要是让你一直误解我姐\n也不太好——",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "潜在アーヤ",
            "text": "先に教えて\nおこうかしら――",
            "zh": "要不我先跟你\n讲讲好了——",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "64/TALK",
            "narrator": "表層アーヤ",
            "text": "貴方ね！\n私を倒そうなんて\n画策しているのは！",
            "zh": "就是你吧！\n企图打倒我的\n就是你们！",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "潜在アーヤ",
            "text": "あら、貴方は\nもしかして……",
            "zh": "哎呀，你\n难道是……",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "68/TALK",
            "narrator": "表層アーヤ",
            "text": "そう。\n姉を許さない私よ。",
            "zh": "没错。\n就是不原谅姐姐的我。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "69/TALK",
            "narrator": "表層アーヤ",
            "text": "私を倒すということは\n姉を許すということ。\nそんなの言語道断よ。",
            "zh": "打倒我，就等于\n原谅姐姐。\n这种事岂有此理。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "表層アーヤ",
            "text": "貴方のような人格は\n私の方から積極的に\n消しにいく。",
            "zh": "像你这样的人格，\n我倒要主动出击\n先把你抹消掉。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "潜在アーヤ",
            "text": "はぁ、血の気が多い\n人格さんね。\n望む所よ。",
            "zh": "哈啊，真是火气很大的\n人格小姐呢。\n正合我意。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "表層アーヤ",
            "text": "私の所持するクランを\n甘く見ると、痛い目を\n見るわよ？",
            "zh": "小看我持有的\n库兰，可是会\n吃苦头的哦？",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "潜在アーヤ",
            "text": "はいはい。\nお手柔らかに。",
            "zh": "好好好。\n手下留情哦。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "潜在アーヤ",
            "text": "ごめんなさいね。\nどうやら説明は\n後になりそう。",
            "zh": "不好意思啊。\n看来说明得留到\n事后了。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "潜在アーヤ",
            "text": "まずは一緒に\n戦ってくれないかしら。",
            "zh": "能不能先和我\n一起并肩作战呢。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "77/TALK",
            "narrator": "潜在アーヤ",
            "text": "勝ったら\n姉のこと、色々\n教えてあげるし……",
            "zh": "只要赢了，我就把\n姐姐的事统统\n告诉你……",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "潜在アーヤ",
            "text": "あと、ご希望であれば\nお礼にデートなんかも\nいかが？",
            "zh": "还有，如果你愿意的话，\n作为谢礼来一场约会\n如何？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "80/SEL",
            "narrator": "（選択肢）",
            "text": "是非！",
            "zh": "求之不得！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "81/SEL",
            "narrator": "（選択肢）",
            "text": "自分がデートしたいだけでは……？",
            "zh": "其实只是你自己想约会吧……？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "82/ACT",
            "narrator": "",
            "text": "是非！",
            "zh": "求之不得！",
            "narrator_zh": ""
        },
        {
            "location": "83/TALK",
            "narrator": "潜在アーヤ",
            "text": "ふふっ、\n嬉しい。",
            "zh": "呵呵，\n真开心。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "潜在アーヤ",
            "text": "それじゃ行くわよ。\n戦いは真剣勝負！",
            "zh": "那我们上咯。\n战斗可是认真的决胜负！",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "92/ACT",
            "narrator": "",
            "text": "自分がデートしたいだけでは……？",
            "zh": "其实只是你自己想约会吧……？",
            "narrator_zh": ""
        },
        {
            "location": "93/TALK",
            "narrator": "潜在アーヤ",
            "text": "あら、酷いツッコミ。\nデリカシーないのね。",
            "zh": "哎呀，好犀利的吐槽。\n真是不懂分寸。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "潜在アーヤ",
            "text": "いいわ。\nお望み通り、\nデートは無しで。",
            "zh": "行吧。\n那就如你所愿，\n约会取消。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "96/TALK",
            "narrator": "潜在アーヤ",
            "text": "それじゃ行くわよ！",
            "zh": "那我们上咯！",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "表層アーヤ",
            "text": "私を消そうとしたこと、\n後悔させてあげるわ。",
            "zh": "竟敢企图抹消我，\n我会让你们后悔的。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "116/DIALOG",
            "narrator": "",
            "text": "<color=black><size=50><b>姉を絶対的に排除する人格を倒し\n姉との和解を進展させよ！</b></size></color>\n\n\n\nアーヤと彼女の姉の確執は、\n相当なもののようだ。\nそれでも、もう和解したいと思う気持ちと、\n絶対に許したくないという気持ちが\n交錯している。\n\n強烈な思い出に対抗するには、\nあなたの力が必要。\n\n姉との和解を進展し、彼女を成長させよう！\n\n\n\n\n",
            "zh": "<color=black><size=50><b>打倒坚决排斥姐姐的人格，\n推进与姐姐的和解！</b></size></color>\n\n\n\n绫水与她姐姐之间的隔阂，\n似乎相当深重。\n即便如此，想要和解的心情，\n与绝对不想原谅的心情\n依然在心中交织。\n\n为了对抗这份强烈的回忆，\n需要你的力量。\n\n推进与姐姐的和解，让她成长吧！\n\n\n\n\n",
            "narrator_zh": ""
        }
    ]
}
