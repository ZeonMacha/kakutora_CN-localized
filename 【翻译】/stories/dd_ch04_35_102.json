    "entry": [
        {
            "location": "583/SCENARIO",
            "narrator": "",
            "text": "シスターズ・コンフリクト",
            "zh": "姐妹冲突",
            "narrator_zh": ""
        },
        {
            "location": "603/TALK",
            "narrator": "みやび",
            "text": "うちはめでたく\n発症したんか？",
            "zh": "我是不是\n光荣发症了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "604/TALK",
            "narrator": "みやび",
            "text": "逢瀬つばめの\nフェノメノンにいた時の\n記憶が……。",
            "zh": "在逢濑燕的\nPhenoMENON里那会儿的\n记忆……。",
            "narrator_zh": "雅"
        },
        {
            "location": "605/TALK",
            "narrator": "みやび",
            "text": "いや違う、これは。",
            "zh": "不，这不是。",
            "narrator_zh": "雅"
        },
        {
            "location": "606/TALK",
            "narrator": "みやび",
            "text": "相棒！",
            "zh": "搭档！",
            "narrator_zh": "雅"
        },
        {
            "location": "607/SEL",
            "narrator": "",
            "text": "$handle$だよ",
            "zh": "我是$handle$",
            "narrator_zh": ""
        },
        {
            "location": "608/SEL",
            "narrator": "",
            "text": "どうなってるの？",
            "zh": "这是怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "609/SEL",
            "narrator": "",
            "text": "こっちの方が\n今大変だから",
            "zh": "这边现在\n更要紧啊",
            "narrator_zh": ""
        },
        {
            "location": "610/ACT",
            "narrator": "",
            "text": "$handle$だよ",
            "zh": "我是$handle$",
            "narrator_zh": ""
        },
        {
            "location": "611/TALK",
            "narrator": "みやび",
            "text": "名前はどうでもえい。",
            "zh": "名字怎样都好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "612/ACT",
            "narrator": "",
            "text": "どうなってるの？",
            "zh": "这是怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "613/TALK",
            "narrator": "みやび",
            "text": "こっちが\n聞きたいちや。",
            "zh": "想问的\n是我这边才滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "614/ACT",
            "narrator": "",
            "text": "こっちの方が\n今大変だから",
            "zh": "这边现在\n更要紧啊",
            "narrator_zh": ""
        },
        {
            "location": "615/TALK",
            "narrator": "みやび",
            "text": "サポートＡＩが\n何を言っちゅう。",
            "zh": "辅助AI\n在说什么咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "617/TALK",
            "narrator": "みやび",
            "text": "今すぐにでもつばめを\n蒸着させんと\n世界の危機ぞね。",
            "zh": "再不马上让燕\n蒸镀的话，\n世界就危险咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "618/TALK",
            "narrator": "みやび",
            "text": "早う――",
            "zh": "快——",
            "narrator_zh": "雅"
        },
        {
            "location": "633/TALK",
            "narrator": "みやび",
            "text": "こんなことをせいとは\n言うとらん！",
            "zh": "我可没叫你\n干这种事！",
            "narrator_zh": "雅"
        },
        {
            "location": "634/TALK",
            "narrator": "みやび",
            "text": "早う競合を解除せい！",
            "zh": "快点解除竞合！",
            "narrator_zh": "雅"
        },
        {
            "location": "635/SEL",
            "narrator": "",
            "text": "$me$は何もしていない",
            "zh": "$me$什么都没做",
            "narrator_zh": ""
        },
        {
            "location": "636/SEL",
            "narrator": "",
            "text": "そもそも何が何だか",
            "zh": "根本不知道发生了什么",
            "narrator_zh": ""
        },
        {
            "location": "637/SEL",
            "narrator": "",
            "text": "$me$にもわからない",
            "zh": "$me$也不知道",
            "narrator_zh": ""
        },
        {
            "location": "638/ACT",
            "narrator": "",
            "text": "$me$は何もしていない",
            "zh": "$me$什么都没做",
            "narrator_zh": ""
        },
        {
            "location": "639/TALK",
            "narrator": "みやび",
            "text": "そんなわけはないろう！",
            "zh": "哪有那种事咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "640/ACT",
            "narrator": "",
            "text": "そもそも何が何だか",
            "zh": "根本不知道发生了什么",
            "narrator_zh": ""
        },
        {
            "location": "641/TALK",
            "narrator": "みやび",
            "text": "データの共有は\nされておらんのかね？",
            "zh": "数据的共享\n是没做吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "642/ACT",
            "narrator": "",
            "text": "$me$にもわからない",
            "zh": "$me$也不知道",
            "narrator_zh": ""
        },
        {
            "location": "643/TALK",
            "narrator": "みやび",
            "text": "例外処理の\n検索パターンが\n貧弱なんやないかね？",
            "zh": "例外处理的\n检索模式，\n是不是太弱了咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "645/TALK",
            "narrator": "みやび",
            "text": "これではサポートＡＩの\n意味がないろう！",
            "zh": "这样辅助AI\n还有什么意义咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "659/TALK",
            "narrator": "みやび",
            "text": "ん……。",
            "zh": "嗯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "660/TALK",
            "narrator": "みやび",
            "text": "……ここは……。",
            "zh": "……这里是……。",
            "narrator_zh": "雅"
