        "title": "Extra004 ヒメゴトチャット",
        "sub_title": "もしかして：初恋",
        "title_zh": "Extra004 秘语聊天",
        "sub_title_zh": "难道说：初恋"
    },
    "entry": [
        {
            "location": "103/SCENARIO",
            "narrator": "",
            "text": "000_もしかして：初恋",
            "zh": "000_难道说：初恋",
            "narrator_zh": ""
        },
        {
            "location": "128/TALK",
            "narrator": "アーヤ",
            "text": "昼間言ってた箱型ブランコね",
            "zh": "就是白天说的那个箱形秋千吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "ホントは",
            "zh": "其实",
            "narrator_zh": "绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "アーヤ",
            "text": "男の子と乗ったことがあるのよね",
            "zh": "我和男孩子一起坐过哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "133/SEL",
            "narrator": "",
            "text": "好きだった子？",
            "zh": "是你喜欢的孩子？",
            "narrator_zh": ""
        },
        {
            "location": "134/SEL",
            "narrator": "",
            "text": "そいつ羨ましい…",
            "zh": "那家伙真让人羡慕…",
            "narrator_zh": ""
        },
        {
            "location": "135/SEL",
            "narrator": "",
            "text": "ちょっと意外だ",
            "zh": "有点意外",
            "narrator_zh": ""
        },
        {
            "location": "136/ACT",
            "narrator": "",
            "text": "好きだった子？",
            "zh": "是你喜欢的孩子？",
            "narrator_zh": ""
        },
        {
            "location": "137/TALK",
            "narrator": "アーヤ",
            "text": "まあね",
            "zh": "算是吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "アーヤ",
            "text": "幼稚園児の時点でモテる男子だったわ",
            "zh": "幼儿园的时候就挺受女孩子欢迎了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "139/TALK",
            "narrator": "アーヤ",
            "text": "って",
            "zh": "这么一说",
            "narrator_zh": "绫水"
        },
        {
            "location": "140/TALK",
            "narrator": "アーヤ",
            "text": "気付いちゃったわ",
            "zh": "才发觉了哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "その時同じ子が好きだった子",
            "zh": "那时候喜欢同一个男孩子的女孩",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "アーヤ",
            "text": "今ブランコの相手と付き合ってる",
            "zh": "现在正和秋千上那位交往",
            "narrator_zh": "绫水"
        },
        {
            "location": "144/TALK",
            "narrator": "アーヤ",
            "text": "うわ",
            "zh": "唉",
            "narrator_zh": "绫水"
        },
        {
            "location": "145/TALK",
            "narrator": "アーヤ",
            "text": "人生初の失恋",
            "zh": "人生第一次失恋",
            "narrator_zh": "绫水"
        },
        {
            "location": "146/TALK",
            "narrator": "アーヤ",
            "text": "気付きたくなかたわ",
            "zh": "真不想意识到啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "147/ACT",
            "narrator": "",
            "text": "そいつ羨ましい…",
            "zh": "那家伙真让人羡慕…",
            "narrator_zh": ""
        },
        {
            "location": "157/TALK",
            "narrator": "アーヤ",
            "text": "え",
            "zh": "咦",
            "narrator_zh": "绫水"
        },
        {
            "location": "158/TALK",
            "narrator": "アーヤ",
            "text": "幼稚園の時の話だから",
            "zh": "那是幼儿园时候的事了",
            "narrator_zh": "绫水"
        },
        {
            "location": "159/TALK",
            "narrator": "アーヤ",
            "text": "妬かなくていいのよ",
            "zh": "不用嫉妒的哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "161/TALK",
            "narrator": "アーヤ",
            "text": "やきもちとか",
            "zh": "也不用吃什么醋",
            "narrator_zh": "绫水"
        },
        {
            "location": "163/ACT",
            "narrator": "",
            "text": "ちょっと意外だ",
            "zh": "有点意外",
            "narrator_zh": ""
        },
        {
            "location": "164/TALK",
            "narrator": "アーヤ",
            "text": "あ",
            "zh": "啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "165/TALK",
            "narrator": "アーヤ",
            "text": "なにそれ(￣Д￣ )",
            "zh": "什么嘛(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "166/TALK",
            "narrator": "アーヤ",
            "text": "私にだってそんな思い出くらいあるわよ",
            "zh": "那种回忆我也有哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "ぷんすか！",
            "zh": "气呼呼！",
            "narrator_zh": "绫水"
        },
        {
            "location": "153/DIALOG",
            "narrator": "Dialog_GETGokigen",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n提升了！",
            "narrator_zh": "Dialog_GETGokigen"
        }
    ]
}
