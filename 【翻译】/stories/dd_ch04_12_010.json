{
    "dir": "chap12/daydra/dd_ch04_12_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "12452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "迷惑メール",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "垃圾邮件"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "迷惑メール",
            "zh": "垃圾邮件",
            "narrator_zh": ""
        },
        {
            "location": "21/TALK",
            "narrator": "雛",
            "text": "う～ん……。",
            "zh": "唔～……。",
            "narrator_zh": "雏"
        },
        {
            "location": "23/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃん、\nどうかしたの？",
            "zh": "小雏，\n怎么了呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "26/TALK",
            "narrator": "雛",
            "text": "…これ、見て。\nさっきあたしに届いた\nメールなんだけど。",
            "zh": "……看这个。\n刚才发到我这里的\n邮件。",
            "narrator_zh": "雏"
        },
        {
            "location": "27/TALK",
            "narrator": "つばめ",
            "text": "えっと…あなたの口座に\n３００万円を振り込み\nたいので――",
            "zh": "那个……想往你的\n账户汇入\n３００万日元——",
            "narrator_zh": "燕"
        },
        {
            "location": "28/TALK",
            "narrator": "つばめ",
            "text": "どうかこのメールに\n銀行口座を書いて\n返信してください…。",
            "zh": "请在这封邮件里\n写上银行账号后\n回信……。",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "みやび",
            "text": "よくある迷惑メールやな。\nテンプレ過ぎて、誰も\n引っかからんやろうね。",
            "zh": "很常见的垃圾邮件嘛。\n模板味太重，谁都不会\n上当的吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "35/TALK",
            "narrator": "キリト",
            "text": "さっさとそんなメール\n削除しちまえよ。",
            "zh": "赶紧把那种邮件\n删了不就完了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "38/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "41/TALK",
            "narrator": "雛",
            "text": "これ、返信したら\nどうなるのかな？",
            "zh": "这个，回了信会\n怎么样呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "43/TALK",
            "narrator": "キリト",
            "text": "何言ってんだよ！\nロクなことにならねぇの\n目に見えてんじゃねぇか。",
            "zh": "说什么呢！\n明摆着不会有什么\n好事，你还想啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "ダメだよひなこちゃん！\nこういうメールは無視\nしないと危ないよ！",
            "zh": "不可以哦小雏！\n这种邮件不无视的话\n很危险的！",
            "narrator_zh": "燕"
        },
        {
            "location": "47/TALK",
            "narrator": "雛",
            "text": "わかってるよー。\n本当にやったりは\nしないって。",
            "zh": "知道啦——。\n真的不会去\n做的啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "48/TALK",
            "narrator": "雛",
            "text": "でも、実際に返信したら\nどうなっちゃうのか――",
            "zh": "可是，真回信的话\n会变成什么样——",
            "narrator_zh": "雏"
        },
        {
            "location": "49/TALK",
            "narrator": "雛",
            "text": "それが気になった\nだけだよ。",
            "zh": "我只是好奇\n这个而已。",
            "narrator_zh": "雏"
        },
        {
            "location": "51/TALK",
            "narrator": "キリト",
            "text": "…そういや、碌なことに\nならねぇ、っていうのは\n知ってるけど――",
            "zh": "……说起来，'没好事'\n这点我是知道的，\n但是——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "52/TALK",
            "narrator": "キリト",
            "text": "具体的にどうなるのかは\n知らねぇな。",
            "zh": "具体会怎么样\n就不知道了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "54/TALK",
            "narrator": "つばめ",
            "text": "個人情報が抜かれるとか\n聞いたことあるけど…。",
            "zh": "听说过个人信息\n会被偷走的说法……。",
            "narrator_zh": "燕"
        },
        {
            "location": "56/TALK",
            "narrator": "雛",
            "text": "メールに返信する\nくらいで、そんなに\nわかっちゃうのかな？",
            "zh": "只是回个邮件，\n就能被摸得\n那么清楚吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "58/TALK",
            "narrator": "キリト",
            "text": "確かに…じゃあ、返信する\nくらいだったら問題ない、\nってことか？",
            "zh": "确实……那也就是说，\n只是回个信的话\n没问题咯？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "…この子達、まさか\n本気で返信しようとか\n考えんよな？",
            "zh": "……这帮孩子，该不会\n真的在认真考虑\n回信吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "62/SEL",
            "narrator": "",
            "text": "止めてあげて！",
            "zh": "去拦住她们！",
            "narrator_zh": ""
        },
        {
            "location": "63/SEL",
            "narrator": "",
            "text": "アーヤを呼ぼう",
            "zh": "叫绫水来吧",
            "narrator_zh": ""
        },
        {
            "location": "64/SEL",
            "narrator": "",
            "text": "送信者を割り出そう",
            "zh": "来查出发信人吧",
            "narrator_zh": ""
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "まあ、興味だけで\n実際にするとは思わん\nけんど――",
            "zh": "嘛，光凭兴趣\n就真去干，应该\n不至于――",
            "narrator_zh": "雅"
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "もしかしたら、\nちゅうこともあるき――",
            "zh": "但万一嘛，\n也难说嘛――",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "一応、注意した方が\nえいかもしれんね。",
            "zh": "保险起见，还是\n提醒一下比较好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "…一応言っておくけんど。",
            "zh": "……先说一声咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "仮にそのメールを\n返信しても、それだけじゃ\n多分何も起こらんよ。",
            "zh": "就算真回了那封邮件，\n光凭这个大概\n也不会发生什么哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "雛",
            "text": "えっ、そうなんですか？",
            "zh": "诶，是这样吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "モノにもよるけんど、\n多分、返信するだけなら\n平気やと思う。",
            "zh": "虽然得看情况，\n不过光回个信，\n应该没事的。",
            "narrator_zh": "雅"
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "けんど、一度返信したら\n脈ありと思われて――",
            "zh": "但是一旦回过信，\n对方就当你有意——",
            "narrator_zh": "雅"
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "今以上に大量のメールが\n送られてくることに\nなるちや。",
            "zh": "就会有比现在\n多出好几倍的邮件\n发过来了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "キリト",
            "text": "うわっ、\nそれウゼェかも…。",
            "zh": "哇，\n那可够烦的……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "やき、そういうんは\nすっと削除した方が\nえいんよ。",
            "zh": "所以嘛，那种东西\n麻溜删掉\n才是正解哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "83/TALK",
            "narrator": "雛",
            "text": "なるほど…そんなことに\nなっちゃうんですね。",
            "zh": "原来如此……会变成\n那样啊。",
            "narrator_zh": "雏"
        },
        {
            "location": "85/TALK",
            "narrator": "雛",
            "text": "勉強になりました！\nじゃあ、これはさっさと\n削除しちゃいますね。",
            "zh": "学到了！\n那我这就把它\n删掉。",
            "narrator_zh": "雏"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "うん、えい子やね。",
            "zh": "嗯，乖孩子咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "見知らぬメールは即削除。\n忘れたらいかんよ。",
            "zh": "陌生邮件立刻删。\n记住了哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "91/ACT",
            "narrator": "",
            "text": "止めてあげて！",
            "zh": "去拦住她们！",
            "narrator_zh": ""
        },
        {
            "location": "111/TALK",
            "narrator": "みやび",
            "text": "…まあ、ここで忠告せんと、後でうちの良心が痛むことになりかねんきな",
            "zh": "……嘛，不在这里劝一句，之后我的良心说不定会痛咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "知っちゅう？　うちにもちゃんと良心はあるんよ",
            "zh": "晓得没？我也是有良心的哦",
            "narrator_zh": "雅"
        },
        {
            "location": "113/TALK",
            "narrator": "みやび",
            "text": "海のようにとまでは言わんが、琵琶湖くらいの大きさのがな",
            "zh": "虽然不敢说像海那么大，好歹有琵琶湖那么大一块",
            "narrator_zh": "雅"
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "…まさかとは思うけんど、\n一応言っておくき。",
            "zh": "……虽然觉得不至于，\n还是先说一句啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "仮にそのメールを\n返信しても、それだけじゃ\n多分何も起こらんよ。",
            "zh": "就算真回了那封邮件，\n光凭这个大概\n也不会发生什么哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "129/TALK",
            "narrator": "雛",
            "text": "えっ、そうなんですか？",
            "zh": "诶，是这样吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "130/TALK",
            "narrator": "みやび",
            "text": "モノにもよるけんど、\n多分、返信するだけなら\n平気やと思う。",
            "zh": "虽然得看情况，\n不过光回个信，\n应该没事的。",
            "narrator_zh": "雅"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "けんど、一度返信したら\n脈ありと思われて――",
            "zh": "但是一旦回过信，\n对方就当你有意——",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "今以上に大量のスパムが\n送られてくることに\nなるちや。",
            "zh": "就会有比现在\n多出好几倍的垃圾邮件\n发过来了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "キリト",
            "text": "うわっ、\nそれウゼェかも…。",
            "zh": "哇，\n那可够烦的……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "やき、そういうんは\nすっと削除した方が\nえいんよ。",
            "zh": "所以嘛，那种东西\n麻溜删掉\n才是正解哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "雛",
            "text": "なるほど…そんなことに\nなっちゃうんですね。",
            "zh": "原来如此……会变成\n那样啊。",
            "narrator_zh": "雏"
        },
        {
            "location": "139/TALK",
            "narrator": "雛",
            "text": "勉強になりました！\nじゃあ、これはさっさと\n削除しちゃいますね。",
            "zh": "学到了！\n那我这就把它\n删掉。",
            "narrator_zh": "雏"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "うん、えい子やね。",
            "zh": "嗯，乖孩子咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "見知らぬメールは即削除。\n忘れたらいかんよ。",
            "zh": "陌生邮件立刻删。\n记住了哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "143/ACT",
            "narrator": "",
            "text": "アーヤを呼ぼう",
            "zh": "叫绫水来吧",
            "narrator_zh": ""
        },
        {
            "location": "164/TALK",
            "narrator": "みやび",
            "text": "そこまでする必要ないと思うけんど",
            "zh": "虽然我觉得没必要做到这份上咯",
            "narrator_zh": "雅"
        },
        {
            "location": "165/TALK",
            "narrator": "みやび",
            "text": "まあ、不安の種は潰しておくんがえいな",
            "zh": "嘛，不安的种子还是趁早掐掉为好",
            "narrator_zh": "雅"
        },
        {
            "location": "166/TALK",
            "narrator": "みやび",
            "text": "ちっくとメールして呼び出すき",
            "zh": "我等子发邮件把她叫出来咧",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "…と、いうわけで\nアーヤを呼んだんよ。",
            "zh": "……就是这么回事，\n我把绫水叫来了哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…なるほどね。\n大体理解したわ。",
            "zh": "哈……原来如此。\n大概明白了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "197/TALK",
            "narrator": "雛",
            "text": "あ、あのぉ…\n本当に返信しようなんて\n思ってないですよ？",
            "zh": "那、那个……\n我们真的没想过\n要回信的哦？",
            "narrator_zh": "雏"
        },
        {
            "location": "198/TALK",
            "narrator": "みやび",
            "text": "わかっちゅうけんど、\nその手の話で盛り上がられ\nると――",
            "zh": "我知道咯，\n可一聊起这种话题\n——",
            "narrator_zh": "雅"
        },
        {
            "location": "199/TALK",
            "narrator": "みやび",
            "text": "どうにも不安になるちや。",
            "zh": "总让人心里发毛滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "200/TALK",
            "narrator": "みやび",
            "text": "やき、迷惑メールには\n返信したらダメだぜ！！",
            "zh": "所以嘛，垃圾邮件\n绝对不能回喂！！",
            "narrator_zh": "雅"
        },
        {
            "location": "203/TALK",
            "narrator": "みやび",
            "text": "って、ちっくと注意を\n促してくれんがか？",
            "zh": "喏，你也等子照这样\n提醒一句得咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "207/TALK",
            "narrator": "アーヤ",
            "text": "だぜって何よ？\nまったく…。",
            "zh": "什么'喂'啊？\n真是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/TALK",
            "narrator": "雛",
            "text": "綾水様、すみません。\nあたし達が変な冗談を\n言ってたせいで…。",
            "zh": "绫水大人，对不起。\n都怪我们说了\n奇怪的玩笑……。",
            "narrator_zh": "雏"
        },
        {
            "location": "211/TALK",
            "narrator": "アーヤ",
            "text": "気にしてないわ。\nっていうか、みやびが\n大げさなだけよ。",
            "zh": "我没放在心上。\n再说，只是雅\n夸张了而已。",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "けど、本当に冗談だけで\nすませないとダメよ？",
            "zh": "但这种事，真的只能\n当玩笑说完才算哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "214/TALK",
            "narrator": "雛",
            "text": "はい、わかってます。",
            "zh": "是，我们知道的。",
            "narrator_zh": "雏"
        },
        {
            "location": "216/TALK",
            "narrator": "アーヤ",
            "text": "うん…これでいい？",
            "zh": "嗯……这样可以吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "218/TALK",
            "narrator": "みやび",
            "text": "…歯磨きを促す特撮\nヒーローっぽくは\n言うてくれんがか？",
            "zh": "……就不能说得像\n督促刷牙的特摄\n英雄得咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "221/TALK",
            "narrator": "アーヤ",
            "text": "…あなたから来た呼び出し\nメール、迷惑フォルダに\n入れておくわ。",
            "zh": "……你发来的\n呼叫邮件，我放进\n垃圾邮件文件夹了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "222/ACT",
            "narrator": "",
            "text": "送信者を割り出そう",
            "zh": "来查出发信人吧",
            "narrator_zh": ""
        },
        {
            "location": "242/TALK",
            "narrator": "みやび",
            "text": "…なるほど",
            "zh": "……原来如此",
            "narrator_zh": "雅"
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "ちっくとＰＣに詳しい人間なら出来ることを",
            "zh": "让稍微懂点电脑的人直接演示出来",
            "narrator_zh": "雅"
        },
        {
            "location": "244/TALK",
            "narrator": "みやび",
            "text": "実際に見せてやれゆうことやね？",
            "zh": "演给她们看，是这意思咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "245/TALK",
            "narrator": "みやび",
            "text": "言葉にするより効果ありそうや、採用ぞね！",
            "zh": "比嘴上说说有效果的样子，采纳咧！",
            "narrator_zh": "雅"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "さてと、ひなこちゃんに\n届いたアドレスは…。",
            "zh": "那么，发给小雏的\n地址是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "258/TALK",
            "narrator": "雛",
            "text": "でも、こんなメールを\n送ってきてるけど――",
            "zh": "不过，发这种邮件的\n家伙——",
            "narrator_zh": "雏"
        },
        {
            "location": "259/TALK",
            "narrator": "雛",
            "text": "本当にそんなお金を\n持ってる人なのかな？",
            "zh": "真的会有那么多钱\n吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "261/TALK",
            "narrator": "つばめ",
            "text": "持ってたとしても、\n本当にくれたりしない人\nじゃないかな？",
            "zh": "就算有，也不会\n是真心给出去的\n人吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "262/TALK",
            "narrator": "キリト",
            "text": "はは、そりゃそうだ。",
            "zh": "哈哈，那倒是。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "264/TALK",
            "narrator": "みやび",
            "text": "多分持ってないとは\n思うけんど、一応…。",
            "zh": "多半是没有的，\n不过保险起见……。",
            "narrator_zh": "雅"
        },
        {
            "location": "266/TALK",
            "narrator": "みやび",
            "text": "…あ～、こいつやね。",
            "zh": "……啊～，是这家伙咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "267/TALK",
            "narrator": "キリト",
            "text": "どうかしたんすか？",
            "zh": "怎么了吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "268/TALK",
            "narrator": "みやび",
            "text": "雛ちゃんにメールを\n送ってきたヤツや。",
            "zh": "就是给小雏\n发邮件的家伙咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "269/TALK",
            "narrator": "みやび",
            "text": "メルアドから個人情報\nすっぱ抜いたんよ。",
            "zh": "从邮箱地址把\n个人信息扒了个底掉哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "270/TALK",
            "narrator": "雛",
            "text": "…はい？\nえっと、ちょっと待って\nくださいね。",
            "zh": "……是？\n那个，请稍等\n一下。",
            "narrator_zh": "雏"
        },
        {
            "location": "271/TALK",
            "narrator": "雛",
            "text": "メルアドだけで、本当に\n個人情報とかわかっちゃ\nうんですか？",
            "zh": "光凭邮箱地址，真的\n能查到个人信息\n什么的吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "272/TALK",
            "narrator": "みやび",
            "text": "程度にもよるけんど、\nこれくらいなら比較的\n簡単ちや。",
            "zh": "虽然得看程度，\n这种程度的还算\n比较简单滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "273/TALK",
            "narrator": "みやび",
            "text": "ちっくと時間かければ、\nこいつのメールアカウント\n乗っ取るんも――",
            "zh": "要是肯花点时间，\n把这小子的\n邮箱账号——",
            "narrator_zh": "雅"
        },
        {
            "location": "275/TALK",
            "narrator": "みやび",
            "text": "出来なくはないぞね。",
            "zh": "也不是不能夺下来咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "276/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "277/TALK",
            "narrator": "つばめ",
            "text": "メルアド、変えようかな？\nもっとわかり難いのに\nしたくなってきたよ…。",
            "zh": "邮箱地址，要不\n换一个吧？突然想换成\n更难懂的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "278/TALK",
            "narrator": "キリト",
            "text": "俺も…長くて難しいのに\n変えようかな？",
            "zh": "我也……要不换成长\n又难懂的？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "279/TALK",
            "narrator": "みやび",
            "text": "変えたところで来る時は\n来るき、あんまし意味は\nないけんどね。",
            "zh": "不过该来的还是会来，\n换了也\n没什么意义咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "280/TALK",
            "narrator": "みやび",
            "text": "まあ、メルアドだけでも\nやろうと思えばこれくらい\n出来なくはないちや。",
            "zh": "嘛，单凭一个邮箱地址，\n肯做的话做到这份上\n也不是不行滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "281/TALK",
            "narrator": "みやび",
            "text": "やき、冗談でも返信しよう\nなんて思わんようになって\nくれたら――",
            "zh": "所以嘛，只要你们以后\n连玩笑都不想\n回信了——",
            "narrator_zh": "雅"
        },
        {
            "location": "282/TALK",
            "narrator": "みやび",
            "text": "うちはそれで安心ちや。",
            "zh": "那样我就放心滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "283/TALK",
            "narrator": "雛",
            "text": "みやび先輩みたいな人が\n本当にいるんだな、って\nわかったら――",
            "zh": "要是明白了世上真有\n雅前辈这样的人\n——",
            "narrator_zh": "雏"
        },
        {
            "location": "284/TALK",
            "narrator": "雛",
            "text": "冗談でも、もう二度と\n思えませんよ…。",
            "zh": "就算开玩笑，也再\n不会有这种念头了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "20/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月4日　12:08 PM</color>\nとある平日の昼休み、学園教室にて。",
            "zh": "<color=green>7月4日　12:08 PM</color>\n某个工作日的午休，学园教室里。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
