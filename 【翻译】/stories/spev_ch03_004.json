{
    "dir": "chap00/daydra/spev_ch03_004.js",
    "type": "",
    "info": {
        "story_id": "3004",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "繋いだ手",
        "title_zh": "特别篇",
        "sub_title_zh": "牵在一起的手"
    },
    "entry": [
        {
            "location": "16/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "17/SEL",
            "narrator": "（選択肢）",
            "text": "えっと…どうしたの？",
            "zh": "那个……怎么了？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "18/ACT",
            "narrator": "",
            "text": "えっと…どうしたの？",
            "zh": "那个……怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "22/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ちょ、聞かないでよ！\nわかるでしょ！？",
            "zh": "等、别明知故问啦！\n你肯定明白吧！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "23/TALK",
            "narrator": "透明ガブリエラ",
            "text": "今、デート中なのよ？\n忘れたの？",
            "zh": "现在可是在约会中哦？\n你忘了吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "24/TALK",
            "narrator": "透明ガブリエラ",
            "text": "デートなら、ほら…、\n当然やらなくちゃいけない\nことがあるでしょ？",
            "zh": "既然是约会，你看……\n肯定有理所当然\n必须要做的事吧？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "透明ガブリエラ",
            "text": "それをやれって\n言ってるのよ…。",
            "zh": "我是在叫你做那件事\n啦……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "27/SEL",
            "narrator": "（選択肢）",
            "text": "ごめん、慣れてないからわからない",
            "zh": "抱歉，我没经验，不太懂",
            "narrator_zh": "（选项）"
        },
        {
            "location": "28/SEL",
            "narrator": "（選択肢）",
            "text": "ぷ、プロポーズはまだ早いよ！？",
            "zh": "求、求婚还太早了吧！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "29/ACT",
            "narrator": "",
            "text": "ごめん、慣れてないからわからない",
            "zh": "抱歉，我没经验，不太懂",
            "narrator_zh": ""
        },
        {
            "location": "31/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あのね…、\n今のは問題発言よ？",
            "zh": "我说啊……\n刚才那句话很成问题哦？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "透明ガブリエラ",
            "text": "それだと、まるであたしが\nデート慣れしてるみたいに\n聞こえるじゃない。",
            "zh": "那样一说，听起来\n就好像我对约会\n很熟练一样了嘛。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あたしだって…、\nは、は…初めて…、\nだから…。",
            "zh": "我也是……\n第、第……第一次……\n嘛……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "35/SEL",
            "narrator": "（選択肢）",
            "text": "嬉しいな",
            "zh": "好开心呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "36/ACT",
            "narrator": "",
            "text": "嬉しいな",
            "zh": "好开心呀",
            "narrator_zh": ""
        },
        {
            "location": "39/TALK",
            "narrator": "透明ガブリエラ",
            "text": "別に、$handle$を\n喜ばせようと思ってじゃ\nないけど…。",
            "zh": "我又不是为了\n让$handle$高兴\n才这么说的……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "43/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ねえ…$handle$はさ、\n今楽しい？",
            "zh": "呐……$handle$，\n你现在开心吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あたしとデートしてて…、\nあんまり、ちゃんと\n話せてないし…。",
            "zh": "和我一起约会……\n好像也没怎么\n好好聊上天……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "45/SEL",
            "narrator": "（選択肢）",
            "text": "緊張してるガブリエラは可愛くて",
            "zh": "看着紧张的加布里埃拉觉得很可爱",
            "narrator_zh": "（选项）"
        },
        {
            "location": "46/SEL",
            "narrator": "（選択肢）",
            "text": "ガブリエラはどうなの？",
            "zh": "加布里埃拉觉得呢？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "47/ACT",
            "narrator": "",
            "text": "緊張してるガブリエラは可愛くて",
            "zh": "看着紧张的加布里埃拉觉得很可爱",
            "narrator_zh": ""
        },
        {
            "location": "49/TALK",
            "narrator": "透明ガブリエラ",
            "text": "だ、だから！\nそうやって恥ずかしいこと\n言わないで！",
            "zh": "所、所以说！\n别这样把让人害羞的话\n直接说出口啊！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "50/TALK",
            "narrator": "透明ガブリエラ",
            "text": "っていうか、緊張してるの\nわかってるなら、\n気遣いなさいよ…。",
            "zh": "再说了，既然知道\n我在紧张，\n就照顾一下我啊……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…まあ、楽しんでくれは\nいるみたいだし…、\nそれならいいんだけど…。",
            "zh": "……嘛，看你好像\n还挺开心的……\n那样倒也行啦……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あ、でもそれはそれよ！\n無駄に恥ずかしがらせる\nような発言禁止だから！",
            "zh": "啊，不过一码归一码！\n禁止说那些故意\n让人害羞的话！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "55/ACT",
            "narrator": "",
            "text": "ガブリエラはどうなの？",
            "zh": "加布里埃拉觉得呢？",
            "narrator_zh": ""
        },
        {
            "location": "57/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あたしは…。",
            "zh": "我嘛……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "透明ガブリエラ",
            "text": "い、今のままでも…、\nまあ、悪い気持ちは\nしないけど…。",
            "zh": "就、就算维持现在这样……\n嘛，感觉倒也\n不算坏就是了……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "62/ACT",
            "narrator": "",
            "text": "ぷ、プロポーズはまだ早いよ！？",
            "zh": "求、求婚还太早了吧！？",
            "narrator_zh": ""
        },
        {
            "location": "65/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ちょ！？　いくらなんでも\nぶっ飛び過ぎよ！",
            "zh": "等！？　再怎么说\n这也跨度太大了吧！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "透明ガブリエラ",
            "text": "大体、まだあたし達\nそこまでの関係じゃ\nないでしょ！？",
            "zh": "况且，我们两个\n现在还不到\n那种关系吧！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "透明ガブリエラ",
            "text": "プロポーズするときは、\nもっと、ほら…段階？",
            "zh": "要求婚的话，\n不得先、你看……步骤？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そう、段階踏んでからじゃ\nなくちゃダメよ！",
            "zh": "对，要一步步按顺序来\n才行呀！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あたし達、キスだって\nまだなんだから…。",
            "zh": "我们俩，连吻都\n还没亲过呢……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "71/SEL",
            "narrator": "（選択肢）",
            "text": "キスはまだ早いよ！",
            "zh": "接吻还太早了啦！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "72/SEL",
            "narrator": "（選択肢）",
            "text": "…する？",
            "zh": "……要亲吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "73/ACT",
            "narrator": "",
            "text": "キスはまだ早いよ！",
            "zh": "接吻还太早了啦！",
            "narrator_zh": ""
        },
        {
            "location": "75/TALK",
            "narrator": "透明ガブリエラ",
            "text": "わ、わかってるわよ！\nっていうか、あたしが\nしたいわけじゃないから！",
            "zh": "我、我知道啦！\n再说了，又不是我\n想亲好不好！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "76/ACT",
            "narrator": "",
            "text": "…する？",
            "zh": "……要亲吗？",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "透明ガブリエラ",
            "text": "え、えぇっ！？",
            "zh": "诶、诶诶！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "79/TALK",
            "narrator": "透明ガブリエラ",
            "text": "いや、しないしない！\n絶対しないから！",
            "zh": "才、才不亲才不亲！\n绝对不亲！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "透明ガブリエラ",
            "text": "もう、本当色々\n飛び過ぎよ。",
            "zh": "真是的，你跳跃得\n也太离谱了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "83/TALK",
            "narrator": "透明ガブリエラ",
            "text": "もっと、それより\nずーっと前にすることが\nあるんじゃないの？",
            "zh": "在那之前，\n不是还有早得多的事\n要做吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "透明ガブリエラ",
            "text": "特に今！\nデート中にしなくちゃ\nいけないことがね。",
            "zh": "尤其是现在！\n约会的时候必须要做的\n事情啊。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "透明ガブリエラ",
            "text": "これじゃ、ただ普通に\n歩いてるだけじゃない…。",
            "zh": "这样下去，不就只是\n在普通地散步而已嘛……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "89/SEL",
            "narrator": "（選択肢）",
            "text": "えーっと…",
            "zh": "呃……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "90/ACT",
            "narrator": "",
            "text": "えーっと…",
            "zh": "呃……",
            "narrator_zh": ""
        },
        {
            "location": "93/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…もうっ！\n鈍感、バカ！",
            "zh": "……真是的！\n木头、笨蛋！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "透明ガブリエラ",
            "text": "手よ、手！\nあたしの手、\nがら空きなんだけど？",
            "zh": "是手啊，手！\n我的手，\n一直都空着呢好不好？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "96/TALK",
            "narrator": "透明ガブリエラ",
            "text": "$handle$は…、\nき、気にならないの？",
            "zh": "$handle$就……\n一、一点都不在意吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "97/SEL",
            "narrator": "（選択肢）",
            "text": "手を繋ぐ",
            "zh": "牵手",
            "narrator_zh": "（选项）"
        },
        {
            "location": "98/ACT",
            "narrator": "",
            "text": "手を繋ぐ",
            "zh": "牵手",
            "narrator_zh": ""
        },
        {
            "location": "104/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あっ…。",
            "zh": "啊……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "107/SEL",
            "narrator": "（選択肢）",
            "text": "ダメだった？",
            "zh": "不行吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "108/ACT",
            "narrator": "",
            "text": "ダメだった？",
            "zh": "不行吗？",
            "narrator_zh": ""
        },
        {
            "location": "111/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ダメじゃない！",
            "zh": "不是不行！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あ…べ、別に…、\nあたしはこのままで\n構わないけど…。",
            "zh": "啊……也、也没有……\n我就这样\n倒也无所谓啦……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "113/SEL",
            "narrator": "（選択肢）",
            "text": "嫌なら離すけど",
            "zh": "讨厌的话我也可以松开",
            "narrator_zh": "（选项）"
        },
        {
            "location": "114/ACT",
            "narrator": "",
            "text": "嫌なら離すけど",
            "zh": "讨厌的话我也可以松开",
            "narrator_zh": ""
        },
        {
            "location": "116/TALK",
            "narrator": "透明ガブリエラ",
            "text": "い、嫌じゃない！\n嫌じゃないから！",
            "zh": "不、不讨厌！\n才不讨厌呢！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "118/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ほ…ほら、だって…。",
            "zh": "你……你看，因为……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "119/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そう、手握ってないと、\n$handle$が迷子になる\nかもしれないでしょ！？",
            "zh": "对了，要是不牵着手，\n$handle$说不定\n会迷路的吧！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "120/TALK",
            "narrator": "透明ガブリエラ",
            "text": "だから、あたしが\n手を握っててあげる。",
            "zh": "所以，才由我\n帮你牵着手啦。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "123/TALK",
            "narrator": "透明ガブリエラ",
            "text": "離したら…、\n許さないから…。",
            "zh": "敢松开的话……\n我可不原谅你……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "138/SEL",
            "narrator": "（選択肢）",
            "text": "こんなデートをしたいんだ！",
            "zh": "我想来场这样的约会！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "139/ACT",
            "narrator": "",
            "text": "こんなデートをしたいんだ！",
            "zh": "我想来场这样的约会！",
            "narrator_zh": ""
        },
        {
            "location": "141/TALK",
            "narrator": "ガブリエラ",
            "text": "知らないわよ！",
            "zh": "谁管你啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか何よこれ！？",
            "zh": "话说这算什么啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "デートしてる感じに聞こえなかったし",
            "zh": "听起来根本不像是在约会",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "144/TALK",
            "narrator": "ガブリエラ",
            "text": "むしろ",
            "zh": "倒不如说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "145/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしが恥ずかしがるとこばかりだったじゃない！",
            "zh": "全都是我在害羞的桥段吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "147/SEL",
            "narrator": "（選択肢）",
            "text": "そんな姿を見たい",
            "zh": "我想看你那样的样子",
            "narrator_zh": "（选项）"
        },
        {
            "location": "148/ACT",
            "narrator": "",
            "text": "そんな姿を見たい",
            "zh": "我想看你那样的样子",
            "narrator_zh": ""
        },
        {
            "location": "150/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナはデートを理解してないわ",
