        },
        {
            "location": "731/ACT",
            "narrator": "",
            "text": "$me$のいるところでは売ってる",
            "zh": "$me$住的地方有卖",
            "narrator_zh": ""
        },
        {
            "location": "733/TALK",
            "narrator": "みやび",
            "text": "マジか",
            "zh": "真的假的",
            "narrator_zh": "雅"
        },
        {
            "location": "734/TALK",
            "narrator": "みやび",
            "text": "発表もされていない続編が",
            "zh": "连正式发表都没有过的续作",
            "narrator_zh": "雅"
        },
        {
            "location": "735/TALK",
            "narrator": "みやび",
            "text": "発売されてるとな？",
            "zh": "居然已经在卖了？",
            "narrator_zh": "雅"
        },
        {
            "location": "736/TALK",
            "narrator": "みやび",
            "text": "天国ではないか！",
            "zh": "这不就是天国吗！",
            "narrator_zh": "雅"
        },
        {
            "location": "737/TALK",
            "narrator": "みやび",
            "text": "羨ましい",
            "zh": "羡慕了",
            "narrator_zh": "雅"
        },
        {
            "location": "739/SEL",
            "narrator": "",
            "text": "秘密にするならあげるよ",
            "zh": "你保密的话就送你哦",
            "narrator_zh": ""
        },
        {
            "location": "740/ACT",
            "narrator": "",
            "text": "秘密にするならあげるよ",
            "zh": "你保密的话就送你哦",
            "narrator_zh": ""
        },
        {
            "location": "742/TALK",
            "narrator": "みやび",
            "text": "二人だけの秘密とな？",
            "zh": "就成两人独有的秘密了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "743/TALK",
            "narrator": "みやび",
            "text": "恥ずかしい、キャッ☆",
            "zh": "好害羞，呀☆",
            "narrator_zh": "雅"
        },
        {
            "location": "745/SEL",
            "narrator": "",
            "text": "それで、どうする？",
            "zh": "那么，怎么办？",
            "narrator_zh": ""
        },
        {
            "location": "746/ACT",
            "narrator": "",
            "text": "それで、どうする？",
            "zh": "那么，怎么办？",
            "narrator_zh": ""
        },
        {
            "location": "748/TALK",
            "narrator": "みやび",
            "text": "いただくに決まっている！",
            "zh": "当然是收下！",
            "narrator_zh": "雅"
        },
        {
            "location": "749/TALK",
            "narrator": "みやび",
            "text": "やりこみゲーは大好物やき",
            "zh": "能肝的游戏可是大爱啵",
            "narrator_zh": "雅"
        },
        {
            "location": "750/TALK",
