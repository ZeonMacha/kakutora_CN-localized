            "narrator": "みやび",
            "text": "遠慮はするな",
            "zh": "别客气",
            "narrator_zh": "雅"
        },
        {
            "location": "110/SEL",
            "narrator": "",
            "text": "どうも",
            "zh": "多谢",
            "narrator_zh": ""
        },
        {
            "location": "111/SEL",
            "narrator": "",
            "text": "っていうか、何？",
