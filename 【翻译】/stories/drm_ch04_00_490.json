            "narrator_zh": ""
        },
        {
            "location": "112/SEL",
            "narrator": "",
            "text": "気持ちだけでいいや……",
            "zh": "有这份心就够了……",
            "narrator_zh": ""
        },
        {
            "location": "113/ACT",
            "narrator": "",
            "text": "どうも",
            "zh": "多谢",
            "narrator_zh": ""
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "無感動じゃの",
            "zh": "真是无动于衷呢",
            "narrator_zh": "雅"
        },
        {
            "location": "115/ACT",
            "narrator": "",
            "text": "っていうか、何？",
            "zh": "话说，是什么？",
            "narrator_zh": ""
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "モダマぞね",
            "zh": "是黎豆咧",
            "narrator_zh": "雅"
        },
        {
            "location": "117/ACT",
            "narrator": "",
            "text": "気持ちだけでいいや……",
            "zh": "有这份心就够了……",
            "narrator_zh": ""
        },
        {
            "location": "118/TALK",
            "narrator": "みやび",
            "text": "遠慮しいやねえ",
            "zh": "还客气什么咧",
            "narrator_zh": "雅"
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "それより",
            "zh": "比起那个",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "折り入って話があるぞね",
            "zh": "有件郑重的事要说咧",
            "narrator_zh": "雅"
        },
        {
            "location": "123/SEL",
            "narrator": "",
            "text": "いい話だったら聞く",
            "zh": "要是好事我就听",
            "narrator_zh": ""
        },
        {
            "location": "124/SEL",
            "narrator": "",
            "text": "面倒くさい",
            "zh": "好麻烦",
            "narrator_zh": ""
        },
        {
            "location": "125/SEL",
            "narrator": "",
            "text": "みやびと$me$はラブラブ",
            "zh": "雅和$me$恩爱得很",
            "narrator_zh": ""
        },
        {
            "location": "126/ACT",
            "narrator": "",
            "text": "いい話だったら聞く",
            "zh": "要是好事我就听",
            "narrator_zh": ""
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "そうか",
            "zh": "这样哦",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "なら",
            "zh": "那",
            "narrator_zh": "雅"
        },
        {
            "location": "130/TALK",
            "narrator": "みやび",
            "text": "やめておこう",
            "zh": "还是算了吧",
            "narrator_zh": "雅"
        },
        {
            "location": "131/ACT",
            "narrator": "",
            "text": "面倒くさい",
            "zh": "好麻烦",
            "narrator_zh": ""
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "話すともっと面倒なことになるのだ",
            "zh": "讲出来事情反而更麻烦",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "やめておくか",
            "zh": "要不还是算了吧",
            "narrator_zh": "雅"
        },
        {
            "location": "134/ACT",
            "narrator": "",
            "text": "みやびと$me$はラブラブ",
            "zh": "雅和$me$恩爱得很",
            "narrator_zh": ""
        },
        {
            "location": "144/TALK",
            "narrator": "みやび",
            "text": "左様",
            "zh": "正是咯",
            "narrator_zh": "雅"
        },
        {
            "location": "145/TALK",
            "narrator": "みやび",
            "text": "それは動かしがたい事実",
            "zh": "那是不可动摇的事实",
            "narrator_zh": "雅"
        },
        {
            "location": "147/SEL",
            "narrator": "",
            "text": "だよねー",
            "zh": "对吧——",
            "narrator_zh": ""
        },
        {
            "location": "148/SEL",
            "narrator": "",
            "text": "急にどうしたの",
            "zh": "怎么突然这样",
            "narrator_zh": ""
        },
        {
            "location": "149/SEL",
            "narrator": "",
            "text": "また冗談言ってるの？",
            "zh": "又在开玩笑？",
            "narrator_zh": ""
        },
        {
            "location": "150/ACT",
            "narrator": "",
            "text": "だよねー",
            "zh": "对吧——",
            "narrator_zh": ""
        },
        {
            "location": "151/ACT",
            "narrator": "",
            "text": "急にどうしたの",
            "zh": "怎么突然这样",
            "narrator_zh": ""
        },
        {
            "location": "152/ACT",
            "narrator": "",
            "text": "また冗談言ってるの？",
            "zh": "又在开玩笑？",
            "narrator_zh": ""
        },
        {
            "location": "154/TALK",
            "narrator": "みやび",
            "text": "つまり",
            "zh": "也就是说",
            "narrator_zh": "雅"
        },
        {
            "location": "155/TALK",
            "narrator": "みやび",
            "text": "あれだ",
            "zh": "就是那个",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "みやび",
            "text": "$handle$ときちんとお付き合いというやつをしようと決めたぞね",
            "zh": "我决定要跟$handle$来一场所谓的正式交往咧",
            "narrator_zh": "雅"
        },
        {
            "location": "158/SEL",
            "narrator": "",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": ""
        },
        {
            "location": "159/SEL",
            "narrator": "",
            "text": "なんでまた",
            "zh": "怎么又来",
            "narrator_zh": ""
        },
        {
            "location": "160/SEL",
            "narrator": "",
            "text": "今までは違ってたんだ……",
            "zh": "原来以前是不一样的啊……",
            "narrator_zh": ""
        },
        {
            "location": "161/ACT",
            "narrator": "",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": ""
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "えとはなんだ",
            "zh": "「诶」是什么咯",
            "narrator_zh": "雅"
        },
        {
            "location": "163/TALK",
            "narrator": "みやび",
            "text": "えとは",
            "zh": "「诶」是……",
            "narrator_zh": "雅"
        },
        {
            "location": "164/ACT",
            "narrator": "",
            "text": "なんでまた",
            "zh": "怎么又来",
            "narrator_zh": ""
        },
        {
            "location": "165/TALK",
            "narrator": "みやび",
            "text": "なんでというか",
            "zh": "该说是为什么",
            "narrator_zh": "雅"
        },
        {
            "location": "166/TALK",
            "narrator": "みやび",
            "text": "なんというか",
            "zh": "怎么说呢",
            "narrator_zh": "雅"
        },
        {
            "location": "167/ACT",
            "narrator": "",
            "text": "今までは違ってたんだ……",
            "zh": "原来以前是不一样的啊……",
            "narrator_zh": ""
        },
        {
            "location": "168/TALK",
            "narrator": "みやび",
            "text": "そういうことになるぞね",
            "zh": "就成了这么回事咧",
            "narrator_zh": "雅"
        },
        {
            "location": "170/TALK",
            "narrator": "みやび",
            "text": "うちは悟ったぞね",
            "zh": "我算是悟了咧",
            "narrator_zh": "雅"
        },
        {
            "location": "171/TALK",
            "narrator": "みやび",
            "text": "今回の一件で",
            "zh": "经过这次的事",
            "narrator_zh": "雅"
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "$handle$は",
            "zh": "$handle$是",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "なんというか",
            "zh": "怎么说呢",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "みやび",
            "text": "しょうまっこと",
            "zh": "实在是",
            "narrator_zh": "雅"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "危なっかしい",
            "zh": "让人不放心",
            "narrator_zh": "雅"
        },
        {
            "location": "178/SEL",
            "narrator": "",
            "text": "そうかも",
            "zh": "说不定吧",
            "narrator_zh": ""
        },
        {
            "location": "179/SEL",
            "narrator": "",
            "text": "意外と頼れるよ",
            "zh": "其实挺靠得住的哦",
            "narrator_zh": ""
        },
        {
            "location": "180/SEL",
            "narrator": "",
            "text": "それはこっちの台詞",
            "zh": "这话该我说才对",
            "narrator_zh": ""
        },
        {
            "location": "181/ACT",
            "narrator": "",
            "text": "そうかも",
            "zh": "说不定吧",
            "narrator_zh": ""
        },
        {
            "location": "182/TALK",
            "narrator": "みやび",
            "text": "自覚はあったのか",
            "zh": "你还有点自知之明嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "183/TALK",
            "narrator": "みやび",
            "text": "そういうことだから",
            "zh": "就是这么回事",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "みやび",
            "text": "うちがこじゃんと面倒を見てやるきね",
            "zh": "我来好好照看你啵",
            "narrator_zh": "雅"
        },
        {
            "location": "185/ACT",
            "narrator": "",
            "text": "意外と頼れるよ",
            "zh": "其实挺靠得住的哦",
            "narrator_zh": ""
        },
        {
            "location": "186/TALK",
            "narrator": "みやび",
            "text": "そういうところが危ないというのだ",
            "zh": "就是说那种地方才危险",
            "narrator_zh": "雅"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "だからうちが",
            "zh": "所以说，由我来",
            "narrator_zh": "雅"
        },
        {
            "location": "189/TALK",
            "narrator": "みやび",
            "text": "面倒を見るというのだ",
            "zh": "照看你，就是这样咧",
            "narrator_zh": "雅"
        },
        {
            "location": "190/ACT",
            "narrator": "",
            "text": "それはこっちの台詞",
            "zh": "这话该我说才对",
            "narrator_zh": ""
        },
        {
            "location": "191/TALK",
            "narrator": "みやび",
            "text": "そんなわけなかろ",
            "zh": "才没那种事咧",
            "narrator_zh": "雅"
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "いいから",
            "zh": "行了",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "うちに面倒をみさせるちや",
            "zh": "就是要交给我来照看滴",
            "narrator_zh": "雅"
        },
        {
            "location": "195/TALK",
            "narrator": "みやび",
            "text": "あと",
            "zh": "还有",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "文句も言わせろ",
            "zh": "也让我发发牢骚",
            "narrator_zh": "雅"
        },
        {
            "location": "199/TALK",
            "narrator": "ボイスメール",
            "text": "他人事に一言",
            "zh": "对别人的事说一句",
            "narrator_zh": "语音信箱"
        },
        {
            "location": "140/DIALOG",
            "narrator": "Dialog_GETGokigen",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>900pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>900pt.</b></color></size>\n增加了！",
