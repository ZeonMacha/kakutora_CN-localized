{
    "dir": "chap00/daydra/twev_ch04_002.js",
    "type": "",
    "info": {
        "story_id": "31132",
        "cid": "",
        "title": "Twitter Archive 004",
        "sub_title": "卯月画廊：メリークリスマス♪",
        "title_zh": "推特 存档 004",
        "sub_title_zh": "卯月画廊：圣诞快乐♪"
    },
    "entry": [
        {
            "location": "289/TALK",
            "narrator": "透明神楽",
            "text": "メリークリスマース！\n皆さんにプレゼント\nですよー。",
            "zh": "圣诞快乐——！\n这是送给大家的\n礼物哟——。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "291/TALK",
            "narrator": "透明つばめ",
            "text": "って、えぇーっ！？",
            "zh": "等等，诶——！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "292/TALK",
            "narrator": "透明つばめ",
            "text": "神楽ちゃん、これ！\nわたし、裸だよ！",
            "zh": "神乐，这个！\n我是全裸的呀！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "293/TALK",
            "narrator": "透明神楽",
            "text": "裸じゃありません！\nちゃんと隠してあるじゃ\nないですか。",
            "zh": "才不是全裸！\n不是都有好好\n遮住嘛。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "294/TALK",
            "narrator": "透明みやび",
            "text": "けんどこれ、リボンやろ？",
            "zh": "但是这个，是丝带啵？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "295/TALK",
            "narrator": "透明神楽",
            "text": "つばめさんは、\nプレゼント係なので！",
            "zh": "因为燕小姐是\n礼物担当嘛！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "297/TALK",
            "narrator": "透明みやび",
            "text": "あ、なるほど。",
            "zh": "哦，原来如此。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "298/TALK",
            "narrator": "透明つばめ",
            "text": "納得しちゃうんですか！？",
            "zh": "你就这样信了吗！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "299/TALK",
            "narrator": "透明神楽",
            "text": "でも、個人的には\n裸のつばめさんも\n捨てがたかったんです…。",
            "zh": "不过，私底下\n全裸的燕小姐\n我也舍不得放弃呀……。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "300/TALK",
            "narrator": "透明神楽",
            "text": "つばめさんの場合は、\n可愛いから裸でも\nみんな許してくれますし。",
            "zh": "燕小姐的话，\n够可爱，就算全裸\n大家也会原谅的。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "302/TALK",
            "narrator": "透明つばめ",
            "text": "えっ、そうなの！？",
            "zh": "诶，是这样吗！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "303/TALK",
            "narrator": "透明みやび",
            "text": "つばめちゃんこそ、\n反応間違っちょるぞね。",
            "zh": "燕你才是，\n反应搞错了咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "304/TALK",
            "narrator": "透明神楽",
            "text": "五人描くのはちょっと\n大変でしたけど…。",
            "zh": "画五个人稍微\n有点费劲……。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "305/TALK",
            "narrator": "透明神楽",
            "text": "どうですか？\nこの絵、気に入って\nいただけましたか？",
            "zh": "怎么样？\n这幅画，大家\n还中意吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "307/TALK",
            "narrator": "透明つばめ",
            "text": "う、うん…ちょっと、\n恥ずかしいけど…。",
            "zh": "嗯、嗯……虽然，\n有点害羞……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "308/TALK",
            "narrator": "透明みやび",
            "text": "ちゅうか、うちの\n着ちょる服はなんや？",
            "zh": "话说，我身上\n穿的衣服算驷马？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "310/TALK",
            "narrator": "透明みやび",
            "text": "下乳どころか、\n半乳状態なんやけんど…。",
            "zh": "别说下乳了，\n这都算半乳了但是……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "311/TALK",
            "narrator": "透明神楽",
            "text": "この服は、トライナリーで\n一番ビューティーな人しか\n着こなせない服です。",
            "zh": "这件衣服，只有\n在三重奏里最 Beauty 的\n人才能穿得好看。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "312/TALK",
            "narrator": "透明神楽",
            "text": "そして、ビューティーと\nいえばみやびさん！",
            "zh": "而说到 Beauty，\n那当然是雅小姐！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "313/TALK",
            "narrator": "透明神楽",
            "text": "なので、みやびさんには\nこの服を着てもらおうと\n思ったわけです。",
            "zh": "所以，才想让\n雅小姐来穿\n这件衣服。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "315/TALK",
            "narrator": "透明みやび",
            "text": "…最近、うちが何も\n言わんことをえいことに。",
            "zh": "……最近，还算好\n我什么都不多说。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "316/TALK",
            "narrator": "透明みやび",
            "text": "ネタキャラ扱いしてる\nようにしか思えんぞね。",
            "zh": "怎么看都是在把我\n当搞笑角色咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "317/TALK",
            "narrator": "透明神楽",
            "text": "そんなことありませんよ。\nみやびさんには、\nこの服が一番です！",
            "zh": "才没有那回事哦。\n对雅小姐来说，\n这件衣服最合适了！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "318/TALK",
            "narrator": "透明みやび",
            "text": "…ふむ。",
            "zh": "……唔。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "320/TALK",
            "narrator": "みやび",
            "text": "というわけなのだが",
            "zh": "就是这么回事",
            "narrator_zh": "雅"
        },
        {
            "location": "321/TALK",
            "narrator": "みやび",
            "text": "どう思う？",
            "zh": "你怎么看？",
            "narrator_zh": "雅"
        },
        {
            "location": "323/TALK",
            "narrator": "みやび",
            "text": "この服",
            "zh": "这件衣服",
            "narrator_zh": "雅"
        },
        {
            "location": "324/TALK",
            "narrator": "みやび",
            "text": "マジで似合っているのか？",
            "zh": "真的合适吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "325/SEL",
            "narrator": "（選択肢）",
            "text": "最高です！",
            "zh": "最棒了！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "326/SEL",
            "narrator": "（選択肢）",
            "text": "寒そうです！",
            "zh": "看着就很冷！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "327/SEL",
            "narrator": "（選択肢）",
            "text": "露出少なめが好き",
            "zh": "我喜欢露得少的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "328/ACT",
            "narrator": "",
            "text": "最高です！",
            "zh": "最棒了！",
            "narrator_zh": ""
        },
        {
            "location": "329/TALK",
            "narrator": "みやび",
            "text": "相棒スケベです！",
            "zh": "搭档真好色！",
            "narrator_zh": "雅"
        },
        {
            "location": "330/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "331/TALK",
            "narrator": "みやび",
            "text": "服は悪くない",
            "zh": "衣服不算差",
            "narrator_zh": "雅"
        },
        {
            "location": "332/TALK",
            "narrator": "みやび",
            "text": "嫌いではない",
            "zh": "也不讨厌",
            "narrator_zh": "雅"
        },
        {
            "location": "333/TALK",
            "narrator": "みやび",
            "text": "ただし",
            "zh": "只不过",
            "narrator_zh": "雅"
        },
        {
            "location": "335/TALK",
            "narrator": "みやび",
            "text": "うちが着なければだが",
            "zh": "得不是我来穿就是了",
            "narrator_zh": "雅"
        },
        {
            "location": "336/ACT",
            "narrator": "",
            "text": "寒そうです！",
            "zh": "看着就很冷！",
            "narrator_zh": ""
        },
        {
            "location": "337/TALK",
            "narrator": "みやび",
            "text": "リアルに着たら",
            "zh": "现实里穿上的话",
            "narrator_zh": "雅"
        },
        {
            "location": "338/TALK",
            "narrator": "みやび",
            "text": "１００パー腹壊すだろう",
            "zh": "百分之百会吃坏肚子吧",
            "narrator_zh": "雅"
        },
        {
            "location": "339/TALK",
            "narrator": "みやび",
            "text": "クリスマスにこれは",
            "zh": "圣诞节来这个",
            "narrator_zh": "雅"
        },
        {
            "location": "340/TALK",
            "narrator": "みやび",
            "text": "拷問ではないか？",
            "zh": "不是拷问是什么？",
            "narrator_zh": "雅"
        },
        {
            "location": "342/ACT",
            "narrator": "",
            "text": "露出少なめが好き",
            "zh": "我喜欢露得少的",
            "narrator_zh": ""
        },
        {
            "location": "343/TALK",
            "narrator": "みやび",
            "text": "逆にその方が",
            "zh": "反而那样",
            "narrator_zh": "雅"
        },
        {
            "location": "344/TALK",
            "narrator": "みやび",
            "text": "マニアック感出る気がするのだが",
            "zh": "更有种狂热宅感吧",
            "narrator_zh": "雅"
        },
        {
            "location": "345/TALK",
            "narrator": "みやび",
            "text": "どうだろうか？",
            "zh": "你觉得呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "346/SEL",
            "narrator": "（選択肢）",
            "text": "わかってらっしゃる",
            "zh": "真懂啊",
            "narrator_zh": "（选项）"
        },
        {
            "location": "347/SEL",
            "narrator": "（選択肢）",
            "text": "そうなのかな？",
            "zh": "是这样吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "348/ACT",
            "narrator": "",
            "text": "わかってらっしゃる",
            "zh": "真懂啊",
            "narrator_zh": ""
        },
        {
            "location": "349/TALK",
            "narrator": "みやび",
            "text": "スクープ！",
            "zh": "大新闻！",
            "narrator_zh": "雅"
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "相棒にはマニアックな趣味があった！",
            "zh": "搭档竟有狂热趣味！",
            "narrator_zh": "雅"
        },
        {
            "location": "352/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "353/TALK",
            "narrator": "みやび",
            "text": "趣味は人それぞれである",
            "zh": "趣味因人而异",
            "narrator_zh": "雅"
        },
        {
            "location": "354/TALK",
            "narrator": "みやび",
            "text": "責めはしない",
            "zh": "我不责怪",
            "narrator_zh": "雅"
        },
        {
            "location": "355/TALK",
            "narrator": "みやび",
            "text": "褒めもしない",
            "zh": "也不夸奖",
            "narrator_zh": "雅"
        },
        {
            "location": "356/ACT",
            "narrator": "",
            "text": "そうなのかな？",
            "zh": "是这样吗？",
            "narrator_zh": ""
        },
        {
            "location": "357/TALK",
            "narrator": "みやび",
            "text": "わからん",
            "zh": "不懂啊",
            "narrator_zh": "雅"
        },
        {
            "location": "358/TALK",
            "narrator": "みやび",
            "text": "うちの勘違いかもしれん",
            "zh": "可能是我搞错了",
            "narrator_zh": "雅"
        },
        {
            "location": "359/TALK",
            "narrator": "みやび",
            "text": "気にするな",
            "zh": "别在意",
            "narrator_zh": "雅"
        },
        {
            "location": "362/TALK",
            "narrator": "みやび",
            "text": "しかし",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "364/TALK",
            "narrator": "みやび",
            "text": "サンタクロース",
            "zh": "圣诞老人",
            "narrator_zh": "雅"
        },
        {
            "location": "365/TALK",
            "narrator": "みやび",
            "text": "相棒は",
            "zh": "搭档你",
            "narrator_zh": "雅"
        },
        {
            "location": "366/TALK",
            "narrator": "みやび",
            "text": "サンタを信じるか？",
            "zh": "还信圣诞老人咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "367/SEL",
            "narrator": "（選択肢）",
            "text": "昔は信じてた",
            "zh": "以前信过",
            "narrator_zh": "（选项）"
        },
        {
            "location": "368/SEL",
            "narrator": "（選択肢）",
            "text": "いてほしいと信じてるよ",
            "zh": "我相信他存在哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "369/ACT",
            "narrator": "",
            "text": "昔は信じてた",
            "zh": "以前信过",
            "narrator_zh": ""
        },
        {
            "location": "370/TALK",
            "narrator": "みやび",
            "text": "うちもそうだった",
            "zh": "我也曾那样",
            "narrator_zh": "雅"
        },
        {
            "location": "371/TALK",
            "narrator": "みやび",
            "text": "幼稚園くらいまでだったか？",
            "zh": "大概是到幼儿园为止吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "373/TALK",
            "narrator": "みやび",
            "text": "懐かしい",
            "zh": "真怀念",
            "narrator_zh": "雅"
        },
        {
            "location": "374/TALK",
            "narrator": "みやび",
            "text": "純粋無垢で夢いっぱいのうちよ",
            "zh": "纯真无邪满脑子梦想的我呀",
            "narrator_zh": "雅"
        },
        {
            "location": "375/ACT",
            "narrator": "",
            "text": "いてほしいと信じてるよ",
            "zh": "我相信他存在哦",
            "narrator_zh": ""
        },
        {
            "location": "376/TALK",
            "narrator": "みやび",
            "text": "嫌いじゃないぞね",
            "zh": "我不讨厌咧",
            "narrator_zh": "雅"
        },
        {
            "location": "377/TALK",
            "narrator": "みやび",
            "text": "その信じ方",
            "zh": "那种信法",
            "narrator_zh": "雅"
        },
        {
            "location": "378/TALK",
            "narrator": "みやび",
            "text": "確かに",
            "zh": "确实",
            "narrator_zh": "雅"
        },
        {
            "location": "379/TALK",
            "narrator": "みやび",
            "text": "いてほしいとは思う",
            "zh": "是会希望他存在的",
            "narrator_zh": "雅"
        },
        {
            "location": "381/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "382/TALK",
            "narrator": "みやび",
            "text": "サンタがいようがいなかろうが",
            "zh": "不管圣诞老人在不在",
            "narrator_zh": "雅"
        },
        {
            "location": "383/TALK",
            "narrator": "みやび",
            "text": "うちは枕元に",
            "zh": "我都会在枕头边",
            "narrator_zh": "雅"
        },
        {
            "location": "384/TALK",
            "narrator": "みやび",
            "text": "ちゃんと靴下用意して眠るのだが",
            "zh": "好好备好袜子再睡",
            "narrator_zh": "雅"
        },
        {
            "location": "385/SEL",
            "narrator": "（選択肢）",
            "text": "そうなの！？",
            "zh": "是这样吗！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "386/ACT",
            "narrator": "",
            "text": "そうなの！？",
            "zh": "是这样吗！？",
            "narrator_zh": ""
        },
        {
            "location": "388/TALK",
            "narrator": "みやび",
            "text": "伝統行事は重んじる",
            "zh": "传统节日要重视",
            "narrator_zh": "雅"
        },
        {
            "location": "389/TALK",
            "narrator": "みやび",
            "text": "それがうちスタイルちや",
            "zh": "这就是我的风格滴",
            "narrator_zh": "雅"
        },
        {
            "location": "390/SEL",
            "narrator": "（選択肢）",
            "text": "可愛い一面発見",
            "zh": "发现可爱的一面",
            "narrator_zh": "（选项）"
        },
        {
            "location": "391/SEL",
            "narrator": "（選択肢）",
            "text": "$me$もやってみようかな？",
            "zh": "$me$要不要也试试呢？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "392/ACT",
            "narrator": "",
            "text": "可愛い一面発見",
            "zh": "发现可爱的一面",
            "narrator_zh": ""
        },
        {
            "location": "393/TALK",
            "narrator": "みやび",
            "text": "行事を重んじてるだけだが",
            "zh": "只是重视节日而已",
            "narrator_zh": "雅"
        },
        {
            "location": "394/TALK",
            "narrator": "みやび",
            "text": "褒められているようなので",
            "zh": "既然像是在被夸",
            "narrator_zh": "雅"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "良しとしよう",
            "zh": "那就姑且收下",
            "narrator_zh": "雅"
        },
        {
            "location": "396/ACT",
            "narrator": "",
            "text": "$me$もやってみようかな？",
            "zh": "$me$要不要也试试呢？",
            "narrator_zh": ""
        },
        {
            "location": "397/TALK",
            "narrator": "みやび",
            "text": "えいと思うぞね",
            "zh": "我看行咧",
