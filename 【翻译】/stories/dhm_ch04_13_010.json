        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "自分で言うがね",
            "zh": "虽然是我自己说的啊",
            "narrator_zh": "雅"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "魅力的なお姉さまとして",
