            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "純情な男子を揶揄うのは",
            "zh": "揶揄纯情男子这种事",
            "narrator_zh": "雅"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "たまらんね",
            "zh": "真是让人欲罢不能啊",
            "narrator_zh": "雅"
        },
        {
            "location": "37/SEL",
            "narrator": "",
            "text": "程々にしてね",
            "zh": "适可而止哦",
            "narrator_zh": ""
        },
        {
            "location": "38/SEL",
            "narrator": "",
            "text": "あれはやり過ぎ",
            "zh": "那个太过了",
            "narrator_zh": ""
        },
        {
            "location": "39/SEL",
            "narrator": "",
            "text": "ちょっと嫉妬した",
            "zh": "我有点吃醋了",
            "narrator_zh": ""
        },
        {
            "location": "40/ACT",
            "narrator": "",
            "text": "程々にしてね",
            "zh": "适可而止哦",
            "narrator_zh": ""
        },
        {
            "location": "41/TALK",
            "narrator": "みやび",
            "text": "何を言い出すかと思えば",
            "zh": "我还以为你要说什么",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "そんな言葉はこのみやびさんの辞書から削除済みだ",
            "zh": "那种词早就从本雅雅的字典里删掉了",
            "narrator_zh": "雅"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "とはいえ",
            "zh": "话虽如此",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "本気にさせんようには",
            "zh": "为了不让对方当真",
            "narrator_zh": "雅"
        },
        {
            "location": "46/TALK",
            "narrator": "みやび",
            "text": "しとるつもりだ",
            "zh": "我还是有留心的",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "安心せい",
            "zh": "尽管放心",
            "narrator_zh": "雅"
        },
        {
            "location": "48/ACT",
            "narrator": "",
            "text": "あれはやり過ぎ",
            "zh": "那个太过了",
            "narrator_zh": ""
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "そうか",
            "zh": "这样啊",
            "narrator_zh": "雅"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "ぬ",
            "zh": "唔",
            "narrator_zh": "雅"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "調子に乗り過ぎたか",
            "zh": "是我得寸进尺了吗",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "ま",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "気にするな",
            "zh": "别放在心上",
            "narrator_zh": "雅"
        },
        {
            "location": "54/ACT",
            "narrator": "",
            "text": "ちょっと嫉妬した",
            "zh": "我有点吃醋了",
            "narrator_zh": ""
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "左様か",
            "zh": "原来如此",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "素直でよろしい",
            "zh": "够坦率，很好",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "なあに相棒",
            "zh": "哎呀搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "チューくらいいつでも恵んでやろう",
            "zh": "亲一个什么的，随时都赏你",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "誰にでもこんなことは言わん",
            "zh": "这话我可不是对谁都说的",
            "narrator_zh": "雅"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "特別だぞ？",
            "zh": "你可是特别的啵？",
            "narrator_zh": "雅"
        }
