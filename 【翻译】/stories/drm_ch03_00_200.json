            "narrator_zh": "燕"
        },
        {
            "location": "411/TALK",
            "narrator": "みやび",
            "text": "よし、うちも\n聞いてみるちや。",
            "zh": "好，我也\n去问问滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "424/TALK",
            "narrator": "みやび",
            "text": "すっと答えい",
