 "entry": [
  {
   "location": "327/SCENARIO",
   "narrator": "",
   "text": "ほら、やっぱりね"
  },
  {
   "location": "341/TALK",
   "narrator": "アーヤ",
   "text": "…そういえば――",
   "zh": "……这么说——",
   "narrator_zh": "绫水"
  },
  {
   "location": "342/TALK",
   "narrator": "アーヤ",
   "text": "みんな、あれから\nどうなった？"
  },
  {
   "location": "345/TALK",
   "narrator": "つばめ",
   "text": "何がですか？"
  },
  {
   "location": "347/TALK",
   "narrator": "ガブリエラ",
   "text": "何がって…アーヤが\nこうやって切り出す\nことといったら――"
  },
  {
   "location": "348/TALK",
   "narrator": "ガブリエラ",
   "text": "Ｂｏｔのこと以外\nないじゃない。"
  },
  {
   "location": "350/TALK",
   "narrator": "つばめ",
   "text": "ああ、そっか。"
  },
  {
   "location": "353/TALK",
   "narrator": "アーヤ",
   "text": "その通りよ。",
   "zh": "确实如此。",
   "narrator_zh": "绫水"
  },
  {
   "location": "354/TALK",
   "narrator": "アーヤ",
   "text": "あれから、どう？\nＢｏｔとの仲に、\n折り合いはついた？"
  },
  {
   "location": "356/TALK",
   "narrator": "つばめ",
   "text": "うーん…",
   "zh": "嗯——",
   "narrator_zh": "燕"
  },
  {
   "location": "357/TALK",
   "narrator": "つばめ",
   "text": "わたしは前より\n仲良くなったかな。"
  },
  {
   "location": "360/TALK",
   "narrator": "みやび",
   "text": "つばめちゃんらしい\n答えやね。",
   "zh": "很像燕的\n回答呢。",
   "narrator_zh": "雅"
  },
  {
   "location": "362/TALK",
   "narrator": "みやび",
   "text": "まあ、うちは元々、\n人間やないか疑うて\n相手してたきね。"
  },
  {
   "location": "363/TALK",
   "narrator": "みやび",
   "text": "そう変わったことは\nなかったと思うけんど。",
   "zh": "我觉得没什么\n变化咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "364/TALK",
   "narrator": "つばめ",
   "text": "…$handle$さんにも\nちょっと聞いてみます。"
  },
  {
   "location": "376/TALK",
   "narrator": "つばめ",
   "text": "$handle$さーん",
   "zh": "$handle$——",
   "narrator_zh": "燕"
  },
  {
   "location": "377/TALK",
   "narrator": "つばめ",
   "text": "ァーヤさんにわたし達のことを聞かれたんだけど"
  },
