    "entry": [
        {
            "location": "327/SCENARIO",
            "narrator": "",
            "text": "ほら、やっぱりね",
            "zh": "看吧，果然"
        },
        {
            "location": "341/TALK",
            "narrator": "アーヤ",
            "text": "…そういえば――",
            "zh": "……这么说——",
            "narrator_zh": "绫水"
        },
        {
            "location": "342/TALK",
            "narrator": "アーヤ",
            "text": "みんな、あれから\nどうなった？",
            "zh": "大家，那之后\n怎么样了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "345/TALK",
            "narrator": "つばめ",
            "text": "何がですか？",
            "zh": "什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "347/TALK",
            "narrator": "ガブリエラ",
            "text": "何がって…アーヤが\nこうやって切り出す\nことといったら――",
            "zh": "什么……绫水\n这样开口\n的话——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "348/TALK",
            "narrator": "ガブリエラ",
            "text": "Ｂｏｔのこと以外\nないじゃない。",
            "zh": "除了Bot的事\n没有别的吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "350/TALK",
            "narrator": "つばめ",
            "text": "ああ、そっか。",
            "zh": "啊，对哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "353/TALK",
            "narrator": "アーヤ",
            "text": "その通りよ。",
            "zh": "确实如此。",
            "narrator_zh": "绫水"
        },
        {
            "location": "354/TALK",
            "narrator": "アーヤ",
            "text": "あれから、どう？\nＢｏｔとの仲に、\n折り合いはついた？",
            "zh": "那之后，怎么样？\n和Bot的关系，\n合得来了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "356/TALK",
            "narrator": "つばめ",
            "text": "うーん…",
            "zh": "嗯——",
            "narrator_zh": "燕"
        },
        {
            "location": "357/TALK",
            "narrator": "つばめ",
            "text": "わたしは前より\n仲良くなったかな。",
            "zh": "我比以前\n更要好了吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "360/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんらしい\n答えやね。",
            "zh": "很像燕的\n回答呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "362/TALK",
            "narrator": "みやび",
            "text": "まあ、うちは元々、\n人間やないか疑うて\n相手してたきね。",
            "zh": "嘛，我本来就是\n怀疑是不是人，\n才这么相处的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "363/TALK",
            "narrator": "みやび",
            "text": "そう変わったことは\nなかったと思うけんど。",
            "zh": "我觉得没什么\n变化咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "364/TALK",
            "narrator": "つばめ",
            "text": "…$handle$さんにも\nちょっと聞いてみます。",
            "zh": "……也稍微问问\n$handle$。",
            "narrator_zh": "燕"
        },
        {
            "location": "376/TALK",
            "narrator": "つばめ",
            "text": "$handle$さーん",
            "zh": "$handle$——",
            "narrator_zh": "燕"
        },
        {
            "location": "377/TALK",
            "narrator": "つばめ",
            "text": "ァーヤさんにわたし達のことを聞かれたんだけど",
            "zh": "绫水问了我们的事",
            "narrator_zh": "燕"
        },
        {
            "location": "378/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんはどぅ思ぅ？(´・ω・`) ",
            "zh": "$handle$觉得呢？(´･ω･`)",
            "narrator_zh": "燕"
        },
        {
            "location": "379/TALK",
            "narrator": "つばめ",
            "text": "人間なのがわかってから",
            "zh": "知道是人类之后",
            "narrator_zh": "燕"
        },
        {
            "location": "380/TALK",
            "narrator": "つばめ",
            "text": "何か変わった気する？(´ω｀*)",
            "zh": "有觉得什么变了吗？(´ω｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "382/SEL",
            "narrator": "",
            "text": "ラブラブだよね",
            "zh": "真是恩爱啊",
            "narrator_zh": ""
        },
        {
            "location": "383/SEL",
            "narrator": "",
            "text": "友達にはなれたよね",
            "zh": "我们算得上是朋友了吧",
            "narrator_zh": ""
        },
        {
            "location": "384/SEL",
            "narrator": "",
            "text": "仲良くなれたつもりだけど",
            "zh": "我觉得我们关系已经不错了",
            "narrator_zh": ""
        },
        {
            "location": "385/ACT",
            "narrator": "",
            "text": "ラブラブだよね",
            "zh": "真是恩爱啊",
            "narrator_zh": ""
        },
        {
            "location": "386/TALK",
