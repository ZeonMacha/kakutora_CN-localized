            "narrator": "ガブリエラ",
            "text": "$handle$、質問があるの",
            "zh": "$handle$，我有个问题",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "475/TALK",
            "narrator": "ガブリエラ",
            "text": "あなたが人間とわかってから、今日まで",
