{
    "dir": "chap10/daydra/dd_ch04_10_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "10452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "チラッ",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "瞥一眼"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "チラッ",
            "zh": "瞥一眼",
            "narrator_zh": ""
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "はぁ…暑っ苦しくて\n堪らんちや…。",
            "zh": "唉……闷热得\n受不了滴……",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "みやび",
            "text": "火のついた蝋燭みたいに、\n身体がドロドロ溶けちゅう\n感じがするぞね。",
            "zh": "像点着的蜡烛一样，\n身体正在\n咕嘟咕嘟地化掉咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "41/TALK",
            "narrator": "神楽",
            "text": "そろそろ\n夏本番ですからね…。",
            "zh": "毕竟快到\n盛夏了呢……",
            "narrator_zh": "神乐"
        },
        {
            "location": "43/TALK",
            "narrator": "神楽",
            "text": "って、みやびさん！？\n胸元開いてますよ！",
            "zh": "不对，雅！？\n你胸口敞开着哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "開いてるんやない、\n開けてるんよ。",
            "zh": "不是它自己开的咯，\n是我自己开的。",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "こうしとけば新鮮な空気が\n谷間を通って、全身に\n伝わり…。",
            "zh": "这样弄的话，新鲜空气\n就会穿过乳沟，\n传遍全身……",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "神楽",
            "text": "そうじゃなくて！\nほら、男子達が見てます\nから！",
            "zh": "不是那个问题！\n你看，男生们都在\n看着呢！",
            "narrator_zh": "神乐"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "…ん？",
            "zh": "……嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "51/TALK",
            "narrator": "男子高校生Ａ",
            "text": "やべっ、バレたか！？",
            "zh": "糟了，被发现了！？",
            "narrator_zh": "男高中生Ａ"
        },
        {
            "location": "53/TALK",
            "narrator": "男子高校生Ｂ",
            "text": "俺はバレてない。\nチラッとしか見てないから\nバレてない！",
            "zh": "我才没被发现。\n我只瞥了一眼，\n所以没被发现！",
            "narrator_zh": "男高中生Ｂ"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "チラッ。",
            "zh": "瞥。",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "男子高校生Ａ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "男高中生Ａ"
        },
        {
            "location": "61/TALK",
            "narrator": "男子高校生Ｂ",
            "text": "ぐっ…耐えろ…\nあれは罠だ！",
            "zh": "唔……忍住……\n那是陷阱！",
            "narrator_zh": "男高中生Ｂ"
        },
        {
            "location": "64/TALK",
            "narrator": "神楽",
            "text": "ほら、あの辺の人達なんか\n明らかに見てるじゃ\nないですか。",
            "zh": "你看那边那些人，\n明显都在看，\n不是吗。",
            "narrator_zh": "神乐"
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "まあ、見たい奴には\n見せとけばえいよ。",
            "zh": "嘛，想看的人，\n给他看看就得咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "見られて減るもんや\nないんやし…。",
            "zh": "被看看又不会\n少块肉……",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "いや、減るならむしろ\n丸出しにしたいくらいや\nけんどね。",
            "zh": "不，要是真能少的话，\n我反而想干脆\n全露出来呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "72/SEL",
            "narrator": "",
            "text": "見られたくない",
            "zh": "不想被看到",
            "narrator_zh": ""
        },
        {
            "location": "73/SEL",
            "narrator": "",
            "text": "見せて！",
            "zh": "给我看！",
            "narrator_zh": ""
        },
        {
            "location": "77/TALK",
            "narrator": "神楽",
            "text": "みやびさんが言うと\n冗談に聞こえません！",
            "zh": "从雅口中说出来，\n一点都不像玩笑！",
            "narrator_zh": "神乐"
        },
        {
            "location": "78/TALK",
            "narrator": "神楽",
            "text": "…いえ、みやびさんなら\n本気でそう思ってるかも\nしれませんけど。",
            "zh": "……不，如果是雅的话，\n说不定是认真的\n也不好说。",
            "narrator_zh": "神乐"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "うちはいつも本気や。",
            "zh": "我向来都是认真的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "神楽",
            "text": "はぁ…まあ、みやびさん\nらしくはあると思います\nけど――",
            "zh": "唉……嘛，确实很有\n雅的风格，\n不过——",
            "narrator_zh": "神乐"
        },
        {
            "location": "87/TALK",
            "narrator": "神楽",
            "text": "このまま放っては\nおけません。\nほら、閉めてください。",
            "zh": "不能就这样\n放任不管。\n来，请合上。",
            "narrator_zh": "神乐"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "うっ…ご、強引やね。",
            "zh": "呜……好、好霸道咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "89/TALK",
            "narrator": "神楽",
            "text": "ネクタイは少しだけ\n緩めておきますから、\nそれで我慢してください。",
            "zh": "领带我会稍微帮你\n松一点，就用这个\n忍一忍吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "91/TALK",
            "narrator": "神楽",
            "text": "ていうか、自分が\n女の子である自覚を、\n少しは持ってください。",
            "zh": "话说回来，也请你\n多少有点身为\n女孩子的自觉。",
            "narrator_zh": "神乐"
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "…女いうんは、\n息苦しいもんやね…。",
            "zh": "……做女人这种事，\n就是憋气得很咯……",
            "narrator_zh": "雅"
        },
        {
            "location": "95/ACT",
            "narrator": "",
            "text": "見られたくない",
            "zh": "不想被看到",
            "narrator_zh": ""
        },
        {
            "location": "115/TALK",
            "narrator": "みやび",
            "text": "安心しい、相棒",
            "zh": "安心咯，搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "この暑い中、たかだかおっぱいごとき長々見る奴なんぞ、まずおらんよ",
            "zh": "这么热的天，还会为区区欧派盯上大半天的家伙，基本没有咯",
            "narrator_zh": "雅"
        },
        {
            "location": "169/TALK",
            "narrator": "みやび",
            "text": "…卯月も、気にせんで\nうちみたいにした方が\n涼しくてえいよ。",
            "zh": "……卯月你也别在意，\n学我这副样子，\n凉快得很咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "172/TALK",
            "narrator": "神楽",
            "text": "できるわけないじゃ\nないですか！",
            "zh": "怎么可能\n做得到啊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "174/TALK",
            "narrator": "神楽",
            "text": "みんなに見られてる、\nって言ってるのに…。",
            "zh": "我明明说了\n大家都在看着……",
            "narrator_zh": "神乐"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "この暑さやき、スケベ心で\nおっぱい見て余計暑くなる\nような輩は――",
            "zh": "天都热成这样了，\n还抱着色心盯欧派、\n越看越热的家伙——",
            "narrator_zh": "雅"
        },
        {
            "location": "177/TALK",
            "narrator": "みやび",
            "text": "さすがにおらんよ。",
            "zh": "再怎么说也不会有哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "180/TALK",
            "narrator": "神楽",
            "text": "現に見られてるのに…。",
            "zh": "可现在明明正被看着……",
            "narrator_zh": "神乐"
        },
        {
            "location": "181/TALK",
            "narrator": "みやび",
            "text": "チラッと見られるくらい、\n安いもんや。",
            "zh": "被瞟上一眼这种事，\n小意思咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "男子高校生Ａ",
            "text": "…チラッと見るのを、\n延々と繰り返してるん\nだけどな。",
            "zh": "……我们这是在把\n瞟一眼这件事\n无限循环啊。",
            "narrator_zh": "男高中生Ａ"
        },
        {
            "location": "187/TALK",
            "narrator": "男子高校生Ｂ",
            "text": "男のスケベ心は\n暑さには負けねぇんだ！",
            "zh": "男人的色心\n才不会输给酷暑！",
            "narrator_zh": "男高中生Ｂ"
        },
        {
            "location": "189/TALK",
            "narrator": "みやび",
            "text": "…しっかし、今日の男子は\nやけに汗かいちゅう気が\nするな。",
            "zh": "……话说回来，总觉得\n今天的男生汗\n流得特别凶啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "191/TALK",
            "narrator": "神楽",
            "text": "…みやびさんのせいです\nからね？",
            "zh": "……都是因为雅你\n才这样的哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "192/ACT",
            "narrator": "",
            "text": "見せて！",
            "zh": "给我看！",
            "narrator_zh": ""
        },
        {
            "location": "211/TALK",
            "narrator": "みやび",
            "text": "相棒は何もわかっちょらんね",
            "zh": "搭档什么都没懂咯",
            "narrator_zh": "雅"
        },
        {
            "location": "212/TALK",
            "narrator": "みやび",
            "text": "こういうんは見せてと頼むんやなくて",
            "zh": "这种事不是开口求“给我看”就能有的",
            "narrator_zh": "雅"
        },
        {
            "location": "213/TALK",
            "narrator": "みやび",
            "text": "気付かれんようにチラチラ見るからこそ価値があるんよ？",
            "zh": "躲着人偷偷瞟来瞟去，这才是它的价值所在咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "214/TALK",
            "narrator": "みやび",
            "text": "やき、自力で頑張りぃ",
            "zh": "所以咯，自己加油去咧",
            "narrator_zh": "雅"
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "まあ、固定カメラやき、見よう思うても無理やと思うけんど",
            "zh": "嘛，你是固定摄像头，想看也没得看咯",
            "narrator_zh": "雅"
        },
        {
            "location": "19/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月17日　12:33 PM</color>\nとある昼休み、学園校庭にて。",
            "zh": "<color=green>6月17日　12:33 PM</color>\n某个午休，在学园的校园里。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
