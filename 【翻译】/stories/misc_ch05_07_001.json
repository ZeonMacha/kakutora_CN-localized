        "title": "Extra002 ヒメゴトチャット",
        "sub_title": "タイガーリリィは夜眠る",
        "title_zh": "Extra002 秘语聊天",
        "sub_title_zh": "卷丹在夜里睡去"
    },
    "entry": [
        {
            "location": "1014/SCENARIO",
            "narrator": "",
            "text": "タイガーリリィは夜眠る",
            "zh": "卷丹在夜里睡去",
            "narrator_zh": ""
        },
        {
            "location": "1039/TALK",
            "narrator": "神楽",
            "text": "タイガーリリィは夜にしか開かない白くて大きな花をずっと見たいと思っていた",
            "zh": "卷丹一直想看那只在夜里开放的、又白又大的花",
            "narrator_zh": "神乐"
        },
        {
            "location": "1040/TALK",
            "narrator": "神楽",
            "text": "だけどタイガーリリィはその花の咲く場所を知らなかった",
            "zh": "可是卷丹不知道那花开在哪里",
            "narrator_zh": "神乐"
        },
        {
            "location": "1041/TALK",
            "narrator": "神楽",
            "text": "その花の咲く時間に起きていられる自信もなかった",
            "zh": "也没有信心能在花开的时间醒着",
            "narrator_zh": "神乐"
        },
        {
            "location": "1043/SEL",
            "narrator": "",
            "text": "月下美人かな",
            "zh": "是月下美人吗",
            "narrator_zh": ""
        },
        {
            "location": "1044/SEL",
            "narrator": "",
            "text": "$me$が一緒に起きててあげる",
            "zh": "$me$陪你一起醒着",
            "narrator_zh": ""
        },
        {
            "location": "1045/SEL",
            "narrator": "",
            "text": "花を見ることはできたの？",
            "zh": "看到花了吗？",
            "narrator_zh": ""
        },
        {
            "location": "1046/ACT",
            "narrator": "",
            "text": "月下美人かな",
            "zh": "是月下美人吗",
            "narrator_zh": ""
        },
        {
            "location": "1047/TALK",
            "narrator": "神楽",
            "text": "これはお話の中だけの花だから",
            "zh": "这是只存在于故事里的花",
            "narrator_zh": "神乐"
        },
        {
            "location": "1048/TALK",
            "narrator": "神楽",
            "text": "現実には存在しない",
            "zh": "现实中并不存在",
            "narrator_zh": "神乐"
        },
        {
            "location": "1049/ACT",
            "narrator": "",
            "text": "$me$が一緒に起きててあげる",
            "zh": "$me$陪你一起醒着",
            "narrator_zh": ""
        },
        {
            "location": "1051/TALK",
            "narrator": "神楽",
            "text": "それだったらタイガーリリィもきっと花が見れたわね",
            "zh": "那样的话，卷丹一定也能看到花了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1053/TALK",
            "narrator": "神楽",
            "text": "それはきっと一生忘れられない思い出になったはず",
            "zh": "那一定会成为一辈子忘不了的回忆",
            "narrator_zh": "神乐"
        },
        {
            "location": "1054/ACT",
            "narrator": "",
            "text": "花を見ることはできたの？",
            "zh": "看到花了吗？",
            "narrator_zh": ""
        },
        {
            "location": "1055/TALK",
            "narrator": "神楽",
            "text": "続きがあるから",
            "zh": "还有后续",
            "narrator_zh": "神乐"
        },
        {
            "location": "1057/TALK",
            "narrator": "神楽",
            "text": "タイガーリリィはその話をいつ聞いたかも憶えていなかった",
            "zh": "卷丹连这个故事是什么时候听来的都不记得了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1058/TALK",
            "narrator": "神楽",
            "text": "そして大きくなるにつれタイガーリリィはその話自体を忘れてしまった",
            "zh": "而且随着长大，卷丹把故事本身也忘掉了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1059/TALK",
            "narrator": "神楽",
            "text": "大人になったタイガーリリィはハネムーンの夜にその話を思い出した",
            "zh": "长大的卷丹，在蜜月的夜里想起了这个故事",
            "narrator_zh": "神乐"
        },
        {
            "location": "1060/TALK",
            "narrator": "神楽",
            "text": "タイガーリリィは旦那さまにその話をしようとして、結局自分の心にしまっておくことにした",
            "zh": "卷丹想对丈夫大人讲这个故事，最后还是决定收进自己心里",
            "narrator_zh": "神乐"
        },
        {
            "location": "1061/TALK",
            "narrator": "神楽",
            "text": "どうしてだと思う？",
            "zh": "你觉得为什么？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1063/SEL",
            "narrator": "",
            "text": "仲が悪かったから",
            "zh": "因为关系不好",
            "narrator_zh": ""
        },
        {
            "location": "1064/SEL",
            "narrator": "",
            "text": "大人になったから",
            "zh": "因为长大了",
            "narrator_zh": ""
        },
        {
            "location": "1065/SEL",
            "narrator": "",
            "text": "たいした話じゃないから",
            "zh": "因为不是什么了不起的故事",
            "narrator_zh": ""
        },
        {
            "location": "1066/ACT",
            "narrator": "",
            "text": "仲が悪かったから",
            "zh": "因为关系不好",
            "narrator_zh": ""
        },
        {
            "location": "1068/TALK",
            "narrator": "神楽",
            "text": "ある意味正しいけど",
            "zh": "某种意义上是对的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1069/TALK",
            "narrator": "神楽",
            "text": "もうそれでいいか",
            "zh": "那就这样吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "1070/ACT",
            "narrator": "",
            "text": "大人になったから",
            "zh": "因为长大了",
            "narrator_zh": ""
        },
        {
            "location": "1071/TALK",
            "narrator": "神楽",
            "text": "正解",
            "zh": "正确",
            "narrator_zh": "神乐"
        },
        {
            "location": "1072/TALK",
            "narrator": "神楽",
            "text": "絶対に辿り着けない場所だってわかっちゃったのよ",
            "zh": "因为明白了，那是绝对到不了的地方",
            "narrator_zh": "神乐"
        },
        {
            "location": "1074/TALK",
            "narrator": "神楽",
            "text": "昔の夢は",
            "zh": "从前的梦",
            "narrator_zh": "神乐"
        },
        {
            "location": "1075/ACT",
            "narrator": "",
            "text": "たいした話じゃないから",
            "zh": "因为不是什么了不起的故事",
            "narrator_zh": ""
        },
        {
            "location": "1076/TALK",
            "narrator": "神楽",
            "text": "まあ確かにそうではあるんだけど",
            "zh": "嘛，确实也是那样",
            "narrator_zh": "神乐"
        },
        {
            "location": "1078/TALK",
            "narrator": "神楽",
            "text": "話せば聞いてもらえたとは思う",
            "zh": "要是说了，我想他会听",
            "narrator_zh": "神乐"
        },
        {
            "location": "1079/TALK",
            "narrator": "神楽",
            "text": "旦那さまがタイガーリリィを愛しているなら",
            "zh": "如果丈夫大人爱着卷丹的话",
            "narrator_zh": "神乐"
        }
    ]
}
