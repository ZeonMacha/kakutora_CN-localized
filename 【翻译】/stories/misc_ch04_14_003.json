            "narrator_zh": "雅"
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "そんな高水準値を叩きだすのか",
            "zh": "能打出那么高的数值",
            "narrator_zh": "雅"
        },
        {
            "location": "220/TALK",
            "narrator": "みやび",
            "text": "言ってみるがいい",
            "zh": "你说说看",
            "narrator_zh": "雅"
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "100点満点のテストならば",
            "zh": "要是一百分满分的考试",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "かなりの好成績といえよう",
