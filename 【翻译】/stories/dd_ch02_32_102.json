            "text": "私リーダーだわ",
            "zh": "我是队长呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "829/ACT",
            "narrator": "",
            "text": "格好いいアーヤでいようよ",
            "zh": "要保持帅气的绫水啊",
            "narrator_zh": ""
        },
        {
            "location": "830/TALK",
            "narrator": "アーヤ",
            "text": "そんな",
            "zh": "哪有",
            "narrator_zh": "绫水"
        },
        {
            "location": "831/TALK",
            "narrator": "アーヤ",
            "text": "でも大事",
            "zh": "不过确实很重要",
            "narrator_zh": "绫水"
        },
        {
            "location": "834/SEL",
            "narrator": "",
            "text": "つばめを助けるんでしょ",
            "zh": "你们要去救燕的对吧",
            "narrator_zh": ""
        },
        {
            "location": "835/SEL",
            "narrator": "",
            "text": "神楽のこと信じるんでしょ",
            "zh": "你也想相信神乐的对吧",
            "narrator_zh": ""
        },
        {
            "location": "836/SEL",
            "narrator": "",
            "text": "みんなで助からなきゃ",
            "zh": "大家必须一起活下来才行",
            "narrator_zh": ""
        },
        {
            "location": "837/ACT",
            "narrator": "",
            "text": "つばめを助けるんでしょ",
            "zh": "你们要去救燕的对吧",
            "narrator_zh": ""
        },
        {
            "location": "838/TALK",
            "narrator": "アーヤ",
            "text": "助けるわ",
            "zh": "要救的",
            "narrator_zh": "绫水"
        },
        {
            "location": "839/ACT",
            "narrator": "",
            "text": "神楽のこと信じるんでしょ",
            "zh": "你也想相信神乐的对吧",
            "narrator_zh": ""
        },
        {
            "location": "840/TALK",
            "narrator": "アーヤ",
            "text": "信じたいの",
            "zh": "我想相信她",
            "narrator_zh": "绫水"
        },
        {
            "location": "841/ACT",
            "narrator": "",
            "text": "みんなで助からなきゃ",
            "zh": "大家必须一起活下来才行",
            "narrator_zh": ""
        },
        {
            "location": "842/TALK",
            "narrator": "アーヤ",
            "text": "それって大事なことよね",
            "zh": "这确实是很重要的事呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "845/SEL",
            "narrator": "",
            "text": "ベストを尽くそう",
            "zh": "竭尽全力吧",
            "narrator_zh": ""
        },
        {
            "location": "846/SEL",
            "narrator": "",
            "text": "諦めるには早いよ",
            "zh": "现在放弃还太早了",
            "narrator_zh": ""
        },
        {
            "location": "847/SEL",
            "narrator": "",
            "text": "まだできることはあるはず",
            "zh": "一定还有能做的事",
            "narrator_zh": ""
        },
        {
            "location": "848/ACT",
            "narrator": "",
            "text": "ベストを尽くそう",
            "zh": "竭尽全力吧",
            "narrator_zh": ""
        },
        {
            "location": "849/TALK",
            "narrator": "アーヤ",
            "text": "わかったわ",
            "zh": "我知道了",
            "narrator_zh": "绫水"
        },
        {
            "location": "850/ACT",
            "narrator": "",
            "text": "諦めるには早いよ",
            "zh": "现在放弃还太早了",
            "narrator_zh": ""
        },
        {
            "location": "851/TALK",
            "narrator": "アーヤ",
            "text": "そうよね",
            "zh": "说得对呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "852/ACT",
            "narrator": "",
            "text": "まだできることはあるはず",
            "zh": "一定还有能做的事",
            "narrator_zh": ""
        },
        {
            "location": "853/TALK",
            "narrator": "アーヤ",
            "text": "そうだったわ",
            "zh": "确实是这样呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "855/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう",
            "zh": "谢谢",
            "narrator_zh": "绫水"
        },
        {
            "location": "856/TALK",
            "narrator": "アーヤ",
            "text": "もう少し色々やってみる",
            "zh": "我再多试着想点别的办法",
            "narrator_zh": "绫水"
        },
        {
            "location": "857/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんがいてくれて",
            "zh": "能有$handle$陪在我身边",
            "narrator_zh": "绫水"
        },
        {
            "location": "859/TALK",
            "narrator": "アーヤ",
            "text": "よかった",
            "zh": "真是太好了",
            "narrator_zh": "绫水"
        },
        {
            "location": "864/TALK",
            "narrator": "アーヤ",
            "text": "もしトライガジェットが\nなかったら\n$handle$さんとは…。",
            "zh": "要是没有Tri-Gadget，\n也就不会和\n$handle$……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "865/TALK",
            "narrator": "アーヤ",
            "text": "…あ！",
            "zh": "……啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "866/TALK",
            "narrator": "みやび",
            "text": "どういた？\nポッドの活用法でも\n見つかったかね？",
            "zh": "怎么了？\n是找到逃生舱的\n用法了嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "869/TALK",
            "narrator": "アーヤ",
            "text": "トライコネクト！\nこれを脱出の手段に\n使えないかしら？",
            "zh": "Tri-Connect！\n能不能用这个作为\n逃生的手段呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "871/TALK",
            "narrator": "ガブリエラ",
            "text": "え？\nそんなことできるの？",
            "zh": "诶？\n这种事做得到吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "872/TALK",
            "narrator": "みやび",
            "text": "…確かに。\n今ならできるね。",
            "zh": "……确实。\n现在的话做得到咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "873/TALK",
            "narrator": "みやび",
            "text": "音羽用にシステムを\n改造したき。",
            "zh": "毕竟为了音羽\n把系统改造过啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "875/TALK",
            "narrator": "アーヤ",
            "text": "みやびがそう言うなら\n大丈夫よね。",
            "zh": "既然雅都这么说了，\n那就没问题了吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "876/TALK",
            "narrator": "みやび",
            "text": "落ち着き。\nあくまで理論上はって\nだけやき。",
            "zh": "冷静点。\n这也只是\n理论上可行啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "877/TALK",
            "narrator": "みやび",
            "text": "本番前に一度\n試してみんと。",
            "zh": "正式用之前得先\n试一次才行。",
            "narrator_zh": "雅"
        },
        {
            "location": "878/TALK",
            "narrator": "ガブリエラ",
            "text": "今？",
            "zh": "现在试吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "879/TALK",
            "narrator": "アーヤ",
            "text": "今しかないわね。",
            "zh": "也只能现在试了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "880/TALK",
            "narrator": "みやび",
            "text": "すぐ準備するきね。",
            "zh": "我马上准备啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "883/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さん\n本当にありがとう。",
            "zh": "$handle$\n真的谢谢你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "884/TALK",
            "narrator": "アーヤ",
            "text": "貴方は私の…。\nううん、私達の\n守護者ね。",
            "zh": "你是我的……。\n不，是我们的\n守护者呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "885/TALK",
            "narrator": "アーヤ",
            "text": "もう疑ったりなんて\nしない。\nだから見守ってて…。",
            "zh": "我不会再\n怀疑你了。\n所以请继续守护着我们……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "916/TALK",
            "narrator": "アーヤ",
            "text": "後はタイミングを\n計るだけね。",
            "zh": "接下来就只要\n算准时机了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "919/TALK",
            "narrator": "ガブリエラ",
            "text": "みやび、準備は\nどうなのよ？",
            "zh": "雅，准备得\n怎么样了啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "921/TALK",
            "narrator": "みやび",
            "text": "脱出ポッドの\n射出準備ならとっくに\nできちゅうき。",
            "zh": "逃生舱的\n弹射准备早就\n做好了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "922/TALK",
            "narrator": "みやび",
            "text": "それより二人は\nコネクトこじゃんと\nせんといかんよ。",
            "zh": "比起那个，你们俩\n不好好连接\n可不行咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "923/TALK",
            "narrator": "アーヤ",
            "text": "もちろんよ。",
            "zh": "那当然了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "924/TALK",
            "narrator": "ガブリエラ",
            "text": "当たり前でしょ。",
            "zh": "那还用说嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "925/TALK",
            "narrator": "アーヤ",
            "text": "それよりやっぱり\nスピードを落とす気は\nないみたいよ。",
            "zh": "而且看样子对方\n果然完全没有\n减速的打算呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "926/TALK",
            "narrator": "アーヤ",
            "text": "このまま文京ドームに\n突っ込ませる気\n満々ね。",
            "zh": "是铁了心要让车\n就这么直接撞进\n文京穹顶啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "927/TALK",
            "narrator": "みやび",
            "text": "脱出のタイミングは\nさっきの打ち合わせ\n通りに頼むちや。",
            "zh": "脱出的时机\n就拜托按刚才商量好的\n那样来咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "928/TALK",
            "narrator": "ガブリエラ",
            "text": "オッケー。",
            "zh": "OK。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "929/TALK",
            "narrator": "アーヤ",
            "text": "何かあったら\nフォローするわ。",
            "zh": "万一出了什么状况\n我会兜底的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "930/TALK",
            "narrator": "アーヤ",
            "text": "でも私、二人のこと\n信じてるから。",
            "zh": "不过，我是\n相信着你们俩的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "932/TALK",
            "narrator": "みやび",
            "text": "…泣かせるね。\nさすがはリーダーやき。",
            "zh": "……真让人感动咯。\n不愧是队长啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "933/TALK",
            "narrator": "アーヤ",
            "text": "からかわないで。",
            "zh": "别拿我打趣了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "939/TALK",
            "narrator": "みやび",
            "text": "…ＧＰＳ脱出目標まで\n１００ｍ。",
            "zh": "……距离GPS脱出目标\n100米。",
            "narrator_zh": "雅"
        },
        {
            "location": "940/TALK",
            "narrator": "みやび",
            "text": "５０ｍ。",
            "zh": "50米。",
            "narrator_zh": "雅"
        },
        {
            "location": "941/TALK",
            "narrator": "みやび",
            "text": "３０ｍ。",
            "zh": "30米。",
            "narrator_zh": "雅"
        },
        {
            "location": "942/TALK",
            "narrator": "みやび",
            "text": "２０ｍ。",
            "zh": "20米。",
            "narrator_zh": "雅"
        },
        {
            "location": "943/TALK",
            "narrator": "みやび",
            "text": "１０ｍ。",
            "zh": "10米。",
            "narrator_zh": "雅"
        },
        {
            "location": "945/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さん\nありがとう……。",
            "zh": "$handle$\n谢谢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "960/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【26 ホワイト・マイル】",
            "zh": "【26 White Mile】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
