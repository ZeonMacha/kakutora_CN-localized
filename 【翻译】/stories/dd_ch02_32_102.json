        {
            "location": "694/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ\nどうすれば…！？",
            "zh": "那到底\n该怎么办……！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "695/SEL",
            "narrator": "",
            "text": "まず落ち着こう",
            "zh": "先冷静下来",
