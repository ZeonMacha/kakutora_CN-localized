    "entry": [
        {
            "location": "636/SCENARIO",
            "narrator": "",
            "text": "全ての偶然は運命にも似て",
            "zh": "所有的偶然都似命运",
            "narrator_zh": ""
        },
        {
            "location": "672/TALK",
            "narrator": "みやび",
            "text": "順調に文京ドームへ\n進んじゅう。",
            "zh": "正顺利地朝文京穹顶\n开过去咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "673/TALK",
            "narrator": "みやび",
            "text": "スピード以外は\n意外と安全運転かも\nしれんねえ…。",
            "zh": "除了速度快了点之外，\n说不定意外地算安全驾驶\n咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "676/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなのいやよ！\nせめてスピードを\n落とせないの？",
            "zh": "我可不要这样！\n好歹把速度\n降下来行不行？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "677/TALK",
            "narrator": "アーヤ",
            "text": "止められれば\n何とかなる…！？",
            "zh": "只要能停下来的话\n总会有办法的……！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "678/TALK",
            "narrator": "アーヤ",
            "text": "…あっ…！\nサイドブレーキ…！？",
            "zh": "……啊……！\n手刹……！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "679/SEL",
            "narrator": "",
            "text": "ここ高速だよ！",
            "zh": "这里可是高速啊！",
            "narrator_zh": ""
        },
        {
            "location": "680/SEL",
            "narrator": "",
            "text": "スピード出過ぎてるし！",
            "zh": "车速太快了！",
            "narrator_zh": ""
        },
        {
            "location": "681/ACT",
            "narrator": "",
            "text": "ここ高速だよ！",
            "zh": "这里可是高速啊！",
            "narrator_zh": ""
        },
        {
            "location": "682/ACT",
            "narrator": "",
            "text": "スピード出過ぎてるし！",
