        },
        {
            "location": "233/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "我知道了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "266/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、今回も\nスリルとサスペンスに\n満ちあふれた回だった。",
            "zh": "总而言之，这一回也\n是充满了惊悚与悬念的\n一回。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "267/TALK",
            "narrator": "千羽鶴",
            "text": "感想は",
            "zh": "感想是",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "280/TALK",
            "narrator": "謎のおねえさん",
            "text": "コーンコン。",
            "zh": "叩叩。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "281/SEL",
            "narrator": "",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": ""
        },
        {
            "location": "282/ACT",
            "narrator": "",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": ""
        },
        {
            "location": "285/TALK",
            "narrator": "謎のおねえさん",
            "text": "あっ、よかった～。\nやっと上手くいったよ。",
            "zh": "啊，太好了～。\n总算顺利连上了。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "287/TALK",
            "narrator": "謎のおねえさん",
            "text": "こんにちは！\nあなたが、\n$handle$さん？",
            "zh": "你好！\n你就是\n$handle$吗？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "288/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "289/SEL",
            "narrator": "",
            "text": "そうです、$me$が$handle$です（キリッ",
            "zh": "没错，$me$就是$handle$（凛然",
            "narrator_zh": ""
        },
        {
            "location": "290/SEL",
            "narrator": "",
            "text": "違いますよ",
            "zh": "不是哦",
            "narrator_zh": ""
        },
        {
            "location": "291/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "293/TALK",
            "narrator": "謎のおねえさん",
            "text": "えへへ、よかった。",
            "zh": "诶嘿嘿，太好了。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "294/ACT",
            "narrator": "",
            "text": "そうです、$me$が$handle$です（キリッ",
            "zh": "没错，$me$就是$handle$（凛然",
            "narrator_zh": ""
        },
        {
            "location": "295/TALK",
            "narrator": "謎のおねえさん",
            "text": "うんうん。\nキリッとしてて\nカッコイイね。",
            "zh": "嗯嗯。\n好凛然，\n真帅气呢。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "296/ACT",
            "narrator": "",
            "text": "違いますよ",
            "zh": "不是哦",
            "narrator_zh": ""
        },
        {
            "location": "297/TALK",
            "narrator": "謎のおねえさん",
            "text": "そうなの？\nそれは困っちゃったな。",
            "zh": "是吗？\n那可伤脑筋了呀。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "298/SEL",
            "narrator": "",
            "text": "冗談ですよ",
            "zh": "开玩笑的啦",
            "narrator_zh": ""
        },
        {
            "location": "299/ACT",
            "narrator": "",
            "text": "冗談ですよ",
            "zh": "开玩笑的啦",
            "narrator_zh": ""
        },
        {
            "location": "301/TALK",
            "narrator": "謎のおねえさん",
            "text": "あらら。",
            "zh": "哎呀呀。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "303/TALK",
            "narrator": "謎のおねえさん",
            "text": "――っと、いけない！\nあんまりのんびりしてる\nヒマは無いんだった！",
            "zh": "——啊，糟糕！\n我可没有悠哉闲聊的\n工夫呀！",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "304/TALK",
            "narrator": "謎のおねえさん",
            "text": "色々お話しはしたいけど、\nまだ急いでやらなくちゃ\nいけないことが山積みで。",
            "zh": "虽然有很多话想聊，\n但现在急着必须做的事\n还堆积如山呢。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "305/SEL",
            "narrator": "",
            "text": "千羽鶴は！？",
            "zh": "千羽鹤呢！？",
            "narrator_zh": ""
        },
        {
            "location": "306/SEL",
            "narrator": "",
            "text": "貴方は？",
            "zh": "你是谁？",
            "narrator_zh": ""
        },
        {
            "location": "307/ACT",
            "narrator": "",
            "text": "千羽鶴は！？",
            "zh": "千羽鹤呢！？",
            "narrator_zh": ""
        },
        {
            "location": "308/TALK",
            "narrator": "謎のおねえさん",
            "text": "かなり精神状態が\n良くないから、あなたと\n接触できなくしたの。",
            "zh": "她精神状态非常不好，\n所以我让她没法\n和你接触了。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "309/SEL",
            "narrator": "",
            "text": "それじゃ千羽鶴を$me$に逢わせたのは…えっと…名前は…？",
            "zh": "那么让千羽鹤和$me$见面的人是…那个…你叫…？",
            "narrator_zh": ""
        },
        {
            "location": "310/ACT",
            "narrator": "",
            "text": "それじゃ千羽鶴を$me$に逢わせたのは…えっと…名前は…？",
            "zh": "那么让千羽鹤和$me$见面的人是…那个…你叫…？",
            "narrator_zh": ""
        },
        {
            "location": "312/TALK",
            "narrator": "謎のおねえさん",
            "text": "あ、わたし？",
            "zh": "啊，我吗？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "315/TALK",
            "narrator": "謎のおねえさん",
            "text": "とりあえず今は\n謎のおねえさん、って\nことにしておいて？",
            "zh": "总之现在，\n就先当我叫\n神秘的大姐姐好吗？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "317/TALK",
            "narrator": "謎のおねえさん",
            "text": "で、答えをいうと、\nわたしじゃないよ。",
            "zh": "至于答案嘛，\n不是我哦。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "318/ACT",
            "narrator": "",
            "text": "貴方は？",
            "zh": "你是谁？",
            "narrator_zh": ""
        },
        {
            "location": "320/TALK",
            "narrator": "謎のおねえさん",
            "text": "わたしは…えっと。",
            "zh": "我是……那个。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "323/TALK",
            "narrator": "謎のおねえさん",
            "text": "とりあえず今は\n謎のおねえさん、って\nことにしておいて？",
            "zh": "总之现在，\n就先当我叫\n神秘的大姐姐好吗？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "324/TALK",
            "narrator": "謎のおねえさん",
            "text": "落ち着いたらまた\nゆっくり自己紹介\nさせてね？",
            "zh": "等安顿下来之后\n再让我好好自我介绍\n好不好？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "325/SEL",
            "narrator": "",
            "text": "今は一体どういう状況なの？",
            "zh": "现在到底是什么情况？",
            "narrator_zh": ""
        },
        {
            "location": "326/ACT",
            "narrator": "",
            "text": "今は一体どういう状況なの？",
            "zh": "现在到底是什么情况？",
            "narrator_zh": ""
        },
        {
            "location": "328/TALK",
            "narrator": "謎のおねえさん",
            "text": "あなたに接触していた\n千羽鶴ちゃんなんだけど、\nかなり精神状態が悪くて。",
            "zh": "一直和你接触的\n千羽鹤她呀，\n精神状态非常糟糕。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "329/TALK",
            "narrator": "謎のおねえさん",
            "text": "色々大変なことを\nし始めちゃったから\n接触できなくしたの。",
            "zh": "她开始做起各种\n不得了的事情，所以\n我让她没法接触你了。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "330/SEL",
            "narrator": "",
            "text": "謎のおねえさんが、千羽鶴と$me$を会わせたの？",
            "zh": "是神秘的大姐姐让千羽鹤和$me$见面的吗？",
            "narrator_zh": ""
        },
        {
            "location": "331/ACT",
            "narrator": "",
            "text": "謎のおねえさんが、千羽鶴と$me$を会わせたの？",
            "zh": "是神秘的大姐姐让千羽鹤和$me$见面的吗？",
            "narrator_zh": ""
        },
        {
            "location": "333/TALK",
            "narrator": "謎のおねえさん",
            "text": "ううん、違うよ。",
            "zh": "嗯唔，不是哦。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "335/TALK",
            "narrator": "謎のおねえさん",
            "text": "あの子が自分でルートを\n見つけて接触を試みた\nみたい。",
            "zh": "好像是那孩子自己\n找到了路径，试着\n和你接触的。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "336/TALK",
            "narrator": "謎のおねえさん",
            "text": "すごいよね！",
            "zh": "好厉害对吧！",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "337/TALK",
            "narrator": "謎のおねえさん",
            "text": "だけど、ちょっと\nやりすぎだったと思う。",
            "zh": "不过，我觉得还是\n稍微有点做过头了。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "338/TALK",
            "narrator": "謎のおねえさん",
            "text": "少なくともわたしには、\n危険な方向に暴走し始めた\nように見えて止めたけど。",
            "zh": "至少在我看来，她像是\n开始朝危险的方向暴走了，\n所以我才阻止了她。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "339/TALK",
            "narrator": "謎のおねえさん",
            "text": "もしかして、\n邪魔だったかな…？",
            "zh": "难道说，\n我打扰到你们了吗……？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "340/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "341/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "否",
            "narrator_zh": ""
        },
        {
            "location": "342/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "343/TALK",
            "narrator": "謎のおねえさん",
            "text": "そっか。\nごめんね。",
            "zh": "这样啊。\n抱歉呢。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "344/TALK",
            "narrator": "謎のおねえさん",
            "text": "でもたぶん、あのままだと\nあなたにも彼女たちにも\n迷惑かけちゃうから――",
            "zh": "不过，要是继续那样下去，\n大概会给你和她们\n都添麻烦的——",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "345/TALK",
            "narrator": "謎のおねえさん",
            "text": "ちょっと強引だったけど\n千羽鶴ちゃんは1回休みに\nさせてもらえないかな？",
            "zh": "虽然有点强硬，\n能不能让千羽鹤\n先休息一回呢？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "346/TALK",
            "narrator": "謎のおねえさん",
            "text": "その間に、\nわたしも考えてみるね。",
            "zh": "趁这期间，\n我也来想想办法吧。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "347/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "否",
            "narrator_zh": ""
        },
        {
            "location": "349/TALK",
            "narrator": "謎のおねえさん",
            "text": "えへへ、よかった！",
            "zh": "诶嘿嘿，太好了！",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "350/TALK",
            "narrator": "謎のおねえさん",
            "text": "ちょっと強引かなって\n思ってたから、今の言葉\n聞いて安心したよ。",
            "zh": "我还在想会不会有点强硬，\n听到你这么说\n我就放心了。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "351/TALK",
            "narrator": "謎のおねえさん",
            "text": "今の千羽鶴ちゃんが\nこれ以上頑張ると、逆に\n迷惑かけそうだから――",
            "zh": "现在的千羽鹤\n要是再这么拼下去，\n反而会添麻烦的——",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "352/TALK",
            "narrator": "謎のおねえさん",
            "text": "悩んでたけど、思い切って\n千羽鶴ちゃんには外して\nもらうことにしちゃった。",
            "zh": "虽然我也犹豫过，还是\n下定决心请千羽鹤\n暂时退场了。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "354/TALK",
            "narrator": "謎のおねえさん",
            "text": "今回の記録映像についても\n色々聞きたいこと山積み\nだと思うけど――",
            "zh": "关于这次的记录影像，\n我想你一定也有\n堆积如山的问题想问——",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "355/TALK",
            "narrator": "謎のおねえさん",
            "text": "ていうか、まず\n記録映像が何なのかも\nお話しないとだよね。",
            "zh": "不如说，首先也得\n跟你讲讲记录影像\n究竟是什么才行呢。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "356/TALK",
            "narrator": "謎のおねえさん",
            "text": "ちょっと今、すぐには\n手が回らないから、\n次の時でいいかな？",
            "zh": "只是现在马上\n腾不出手来，\n等下次再说可以吗？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "357/TALK",
            "narrator": "謎のおねえさん",
            "text": "ほんとにごめんね？",
            "zh": "真的对不起哦？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "358/TALK",
            "narrator": "謎のおねえさん",
            "text": "まずは、千羽鶴ちゃんが\n今回用に作ったフォーカス\nを、収束させなくちゃ。",
            "zh": "首先，必须让千羽鹤\n为这一回准备的焦点\n收敛才行。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "359/SEL",
            "narrator": "",
            "text": "フォーカスって？",
            "zh": "焦点是指？",
            "narrator_zh": ""
        },
        {
            "location": "360/ACT",
            "narrator": "",
            "text": "フォーカスって？",
            "zh": "焦点是指？",
            "narrator_zh": ""
        },
        {
            "location": "363/TALK",
            "narrator": "謎のおねえさん",
            "text": "記録映像に至るために\n必要な行動をお膳立てする\nための介入処理、かな？",
            "zh": "就是为了达成记录影像\n而把必要行动提前铺垫好的\n介入处理，大概这样？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "365/TALK",
            "narrator": "謎のおねえさん",
            "text": "あなた側からだと、\nDAY'S DRAMAとか\nそんな表記になってない？",
            "zh": "从你那边看的话，\n是不是显示成\nDAY'S DRAMA之类的？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "366/SEL",
            "narrator": "",
            "text": "いつものアレか",
            "zh": "平时的那个啊",
            "narrator_zh": ""
        },
        {
            "location": "367/ACT",
            "narrator": "",
            "text": "いつものアレか",
            "zh": "平时的那个啊",
            "narrator_zh": ""
        },
        {
            "location": "369/TALK",
            "narrator": "謎のおねえさん",
            "text": "そう。",
            "zh": "没错。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "370/TALK",
            "narrator": "謎のおねえさん",
            "text": "TRI-OSの機能としては、\n過去や未来を覗ける\nツールでしかないけど――",
            "zh": "作为TRI-OS的功能，\n本来只是能窥探\n过去与未来的工具——",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "371/TALK",
            "narrator": "謎のおねえさん",
            "text": "千羽鶴ちゃんはそれを\n使って可能性軸の補正を\nしていたんだね。",
            "zh": "千羽鹤却利用它\n进行了可能性轴的\n修正呢。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "372/TALK",
            "narrator": "謎のおねえさん",
            "text": "それの今回分が既に\nセットされちゃってるから\nわたしが誘導するね。",
            "zh": "这回的那份已经\n设定好了，所以\n由我来引导你吧。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "377/TALK",
            "narrator": "謎のおねえさん",
            "text": "逢瀬つばめちゃんの\n場合だと――",
            "zh": "如果是逢濑燕\n的情况——",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "379/TALK",
            "narrator": "謎のおねえさん",
            "text": "ちょっと大変なことに\nなってるね。",
            "zh": "好像变成相当麻烦的\n状况了呢。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "380/TALK",
            "narrator": "謎のおねえさん",
            "text": "掃除用具入れに入らずに、\nすぐに脱出するように\n誘導できたら嬉しいかな。",
            "zh": "要是能引导她不进\n扫除用具间，\n立刻逃出去就好了呀。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "381/TALK",
            "narrator": "謎のおねえさん",
            "text": "記録映像は、\n千羽鶴ちゃんが作りたい\n世界を映し出してる。",
            "zh": "记录影像映出的，\n是千羽鹤想要创造的\n世界。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "382/TALK",
            "narrator": "謎のおねえさん",
            "text": "逆に言えばそこから\n回避する行動をとれば\n未来は変わる。",
            "zh": "反过来说，只要采取\n回避它的行动，\n未来就会改变。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "383/TALK",
            "narrator": "謎のおねえさん",
            "text": "今のままだと彼女は\n絶対捕まっちゃうから、\n何とかしてあげてね？",
            "zh": "照这样下去她\n绝对会被抓到的，\n请你一定要帮帮她好吗？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "387/TALK",
            "narrator": "謎のおねえさん",
            "text": "綾ちゃんの場合だと――",
            "zh": "如果是绫水的情况——",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "389/TALK",
            "narrator": "謎のおねえさん",
            "text": "気持ちがかなり\n焦ってるね。",
            "zh": "心情好像相当\n焦急呢。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "390/TALK",
            "narrator": "謎のおねえさん",
            "text": "責任感から、危ない橋を\n渡ろうとしてるみたい。\n綾ちゃんらしいなぁ。",
            "zh": "出于责任感，她似乎\n打算走危险的独木桥。\n真像绫水的作风呀。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "391/TALK",
            "narrator": "謎のおねえさん",
            "text": "それを回避しないと、\n綾ちゃんまで捕まっちゃう\nかもしれない。",
            "zh": "要是不回避掉，\n可能连绫水都会\n被抓到哦。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "392/TALK",
            "narrator": "謎のおねえさん",
            "text": "基本的には何もせず\nつばめちゃんを信じて\n待ってもらう感じかな。",
            "zh": "基本上就是什么都不做，\n相信燕并等待她的\n感觉吧。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "396/TALK",
            "narrator": "謎のおねえさん",
            "text": "ガブリエラちゃんの\n場合だと――",
            "zh": "如果是加布里埃拉\n的情况——",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "398/TALK",
            "narrator": "謎のおねえさん",
            "text": "やっぱり気がせいてる\nみたいだね。",
            "zh": "果然也很心急的\n样子呢。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "399/TALK",
            "narrator": "謎のおねえさん",
            "text": "こんな時だから、\n落ち着かないのは\n仕方ないけど――",
            "zh": "在这种时候，\n静不下心也是\n没办法的事——",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "400/TALK",
            "narrator": "謎のおねえさん",
            "text": "焦って行動したら、\n千羽鶴ちゃんの\n思うつぼだから。",
            "zh": "但要是焦急行动，\n就正中千羽鹤的\n下怀了。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "401/TALK",
            "narrator": "謎のおねえさん",
            "text": "あなたには、可能な限り\nガブリエラちゃんの心を\n安定させて欲しいかな。",
            "zh": "我希望你尽可能让\n加布里埃拉的心情\n安定下来呀。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "405/TALK",
            "narrator": "謎のおねえさん",
            "text": "みやびちゃんの\n場合だと――",
            "zh": "如果是雅\n的情况——",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "407/TALK",
            "narrator": "謎のおねえさん",
            "text": "表面上は落ち着いて\n行動してるけど、内心\nかなり焦燥感があるね。",
            "zh": "虽然表面上冷静地\n行动着，但内心其实\n相当焦躁呢。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "408/TALK",
            "narrator": "謎のおねえさん",
            "text": "彼女については、今回は\n他のメンバーほど深刻な\n状況じゃないけど、",
            "zh": "至于她这边，这次倒不像\n其他成员那样处于\n那么严重的状况，",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "409/TALK",
            "narrator": "謎のおねえさん",
            "text": "できる限り\nサポートしてあげて\n欲しいかな？",
            "zh": "不过还是希望能\n尽可能多支持她\n一下好吗？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "412/TALK",
            "narrator": "謎のおねえさん",
            "text": "ココロスフィアに入ったら\nわたしが情報を投下する\nから、それに準じてね。",
            "zh": "进入心灵领域之后\n我会投放信息，\n你按那个来就行哦。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "413/TALK",
            "narrator": "謎のおねえさん",
            "text": "いろいろ駆け足過ぎて、\n頭が追いつかないかも\nしれないけど、ごめんね？",
            "zh": "一下子赶得太急，\n脑子可能跟不上，\n真是抱歉呢？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "414/TALK",
            "narrator": "謎のおねえさん",
            "text": "とにかく今回だけ、\n無事に乗り切れば、次回は\n落ち着けると思うから。",
            "zh": "总之只要平安度过\n这一回，下一回应该\n就能沉下心来聊了。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "415/TALK",
            "narrator": "謎のおねえさん",
            "text": "そしたら、ちゃんと色々\n事情を説明するね。",
            "zh": "到那时，我会把各种\n来龙去脉好好说明的。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "416/TALK",
            "narrator": "謎のおねえさん",
            "text": "$handle$さんに\n素敵なココロの旅を。",
