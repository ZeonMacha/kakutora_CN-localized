    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "アニメ第25話",
            "zh": "动画第25话",
            "narrator_zh": ""
        },
        {
            "location": "48/TALK",
            "narrator": "謎のおねえさん",
            "text": "こんにちは、\n$handle$さん。",
            "zh": "你好，\n$handle$。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "50/TALK",
            "narrator": "謎のおねえさん",
            "text": "前に色々話したから、\n今回はつばめちゃんの\nお話をするだけでもいい？",
            "zh": "之前聊了很多，\n这次就只讲\n燕的事情可以吗？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "52/TALK",
            "narrator": "謎のおねえさん",
            "text": "前に色々話したから、\n今回は綾ちゃんの\nお話をするだけでもいい？",
            "zh": "之前聊了很多，\n这次就只讲\n绫水的事情可以吗？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "54/TALK",
            "narrator": "謎のおねえさん",
            "text": "前に色々話したから、\n今回はガブリエラちゃんの\nお話をするだけでもいい？",
            "zh": "之前聊了很多，\n这次就只讲\n加布里埃拉的事情可以吗？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "56/TALK",
            "narrator": "謎のおねえさん",
            "text": "前に色々話したから、\n今回はみやびちゃんの\nお話をするだけでもいい？",
            "zh": "之前聊了很多，\n这次就只讲\n雅的事情可以吗？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "58/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "59/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "否",
            "narrator_zh": ""
        },
        {
            "location": "60/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "62/TALK",
            "narrator": "謎のおねえさん",
            "text": "うん、わかった。",
            "zh": "嗯，我知道了。",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "64/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "否",
            "narrator_zh": ""
        },
        {
            "location": "66/TALK",
            "narrator": "謎のおねえさん",
            "text": "はーい。\nそれじゃ、少しだけ\n巻き戻しするね？",
            "zh": "好——。\n那就稍微\n倒回一点点哦？",
            "narrator_zh": "神秘的大姐姐"
        },
        {
            "location": "90/TALK",
            "narrator": "千羽鶴",
            "text": "ごきげんよう。",
            "zh": "贵安。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "91/TALK",
            "narrator": "千羽鶴",
            "text": "突然だけど\nアンケートに\n回答して欲しい。",
            "zh": "虽然有点突然，\n想请你回答一个\n问卷调查。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "92/SEL",
            "narrator": "",
            "text": "いいよ",
            "zh": "好啊",
            "narrator_zh": ""
        },
        {
            "location": "93/SEL",
            "narrator": "",
            "text": "ものによるけど",
            "zh": "看是什么问题吧",
            "narrator_zh": ""
        },
        {
            "location": "94/ACT",
            "narrator": "",
            "text": "いいよ",
            "zh": "好啊",
            "narrator_zh": ""
        },
        {
            "location": "95/ACT",
            "narrator": "",
            "text": "ものによるけど",
            "zh": "看是什么问题吧",
            "narrator_zh": ""
        },
        {
            "location": "97/TALK",
            "narrator": "千羽鶴",
            "text": "ありがと。\nそれじゃ質問。",
            "zh": "谢谢。\n那开始提问。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "98/TALK",
            "narrator": "千羽鶴",
            "text": "私のことは、好き？",
            "zh": "你喜欢我吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "99/SEL",
            "narrator": "",
            "text": "好き",
            "zh": "喜欢",
            "narrator_zh": ""
        },
        {
            "location": "100/SEL",
            "narrator": "",
            "text": "嫌い",
            "zh": "讨厌",
            "narrator_zh": ""
        },
        {
            "location": "101/SEL",
            "narrator": "",
            "text": "愛してる",
            "zh": "我爱你",
            "narrator_zh": ""
        },
        {
            "location": "102/ACT",
            "narrator": "",
            "text": "好き",
            "zh": "喜欢",
            "narrator_zh": ""
        },
        {
            "location": "105/TALK",
            "narrator": "千羽鶴",
            "text": "ありがと。",
            "zh": "谢谢。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "106/ACT",
            "narrator": "",
            "text": "嫌い",
            "zh": "讨厌",
            "narrator_zh": ""
        },
        {
            "location": "109/TALK",
            "narrator": "千羽鶴",
            "text": "そう。",
            "zh": "是吗。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "110/ACT",
            "narrator": "",
            "text": "愛してる",
            "zh": "我爱你",
            "narrator_zh": ""
        },
        {
            "location": "113/TALK",
            "narrator": "千羽鶴",
            "text": "それは行きすぎ。",
            "zh": "那太过了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "114/TALK",
            "narrator": "千羽鶴",
            "text": "愛しているという言葉は\n全てを受け入れる覚悟が\nあってこその言葉。",
            "zh": "“我爱你”这句话，\n是要有接受一切的\n觉悟才能说的词。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "115/TALK",
            "narrator": "千羽鶴",
            "text": "自らの人生を賭けようと\n思う時にしか\n使ってはいけない。",
            "zh": "只有在打算赌上\n自己人生的时候，\n才可以使用。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "118/TALK",
            "narrator": "千羽鶴",
            "text": "でもどうして、\nそんなに私のことを\n好きでいられるの？",
            "zh": "不过为什么，\n你还能这么\n喜欢我呢？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "119/TALK",
            "narrator": "千羽鶴",
            "text": "前回以降、私は客観的に\n見ても相当酷なことを\n彼女たちに行っている。",
            "zh": "从上一回以后，客观来看\n我对她们做了\n相当过分的事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "120/TALK",
            "narrator": "千羽鶴",
            "text": "貴方が普通の心ある\n人間なら、それを見て\n何か思う事があるはず。",
            "zh": "只要你是个有正常心智的\n人类，看到那些\n应该会有所触动才对。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "121/TALK",
            "narrator": "千羽鶴",
            "text": "それを受け入れた上での\n理由が知りたい。",
            "zh": "我想知道，在接纳了那些之后\n你依然如此的理由。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "122/SEL",
            "narrator": "",
            "text": "考え方に共感してる",
            "zh": "对你的想法有共鸣",
            "narrator_zh": ""
        },
        {
            "location": "123/SEL",
            "narrator": "",
            "text": "かわいいは正義！",
            "zh": "可爱即是正义！",
            "narrator_zh": ""
        },
        {
            "location": "124/SEL",
            "narrator": "",
            "text": "酷いことしてる自覚はあるのね",
            "zh": "你倒是有自己在做坏事的自觉啊",
            "narrator_zh": ""
        },
        {
            "location": "125/ACT",
            "narrator": "",
            "text": "考え方に共感してる",
            "zh": "对你的想法有共鸣",
            "narrator_zh": ""
        },
        {
            "location": "127/TALK",
            "narrator": "千羽鶴",
            "text": "ありがと。\n私にとって一番\n嬉しい回答。",
            "zh": "谢谢。\n对我来说这是最\n令人开心的回答。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "128/ACT",
            "narrator": "",
            "text": "かわいいは正義！",
            "zh": "可爱即是正义！",
            "narrator_zh": ""
        },
        {
            "location": "130/TALK",
            "narrator": "千羽鶴",
            "text": "意味が分からない。",
            "zh": "完全听不懂。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "131/TALK",
            "narrator": "千羽鶴",
            "text": "でも……もしかすると。",
            "zh": "不过……搞不好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "132/TALK",
            "narrator": "千羽鶴",
            "text": "選択肢一行では回答不能な\n深い理由があって、それが\n言えないからこんな事に？",
            "zh": "是因为有一行选项\n回答不出来的深层理由，\n说不出口才变成这样的吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "133/TALK",
            "narrator": "千羽鶴",
            "text": "それなら是非SNSを使って\n<color=green>#千羽鶴かわいい</color> タグで\n教えて欲しい。",
            "zh": "那样的话请务必在SNS上\n带上 <color=green>#千羽鹤好可爱</color> 标签\n告诉我。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "134/TALK",
            "narrator": "千羽鶴",
            "text": "きっと私にはわからない\n未知の想いが詰まっている\nと思うから楽しみ。",
            "zh": "里面一定装满了我所\n不知道的未知心意，\n我很期待。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "135/ACT",
            "narrator": "",
            "text": "酷いことしてる自覚はあるのね",
            "zh": "你倒是有自己在做坏事的自觉啊",
            "narrator_zh": ""
        },
        {
            "location": "137/TALK",
            "narrator": "千羽鶴",
            "text": "自覚というか――",
            "zh": "与其说是自觉——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "138/TALK",
            "narrator": "千羽鶴",
            "text": "客観的に見て意志の自主性\nに介入するのは褒められた\n行為ではないのでしょう？",
            "zh": "从客观来看，介入意志的\n自主性并不是什么\n值得称赞的行为吧？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "139/TALK",
            "narrator": "千羽鶴",
            "text": "貴方たちの住んでいる\n世界では、そういう常識が\nあるのでは？",
            "zh": "在你们所居住的\n世界里，不是有\n这样的常识吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "140/TALK",
            "narrator": "千羽鶴",
            "text": "私自身がそれについて\n罪悪感を持っているか否か\nでいえば、それはノー。",
            "zh": "至于我自己对此\n是否抱有罪恶感，\n答案是NO。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "141/TALK",
            "narrator": "千羽鶴",
            "text": "必要だからやってる。",
            "zh": "因为有必要才做的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "142/TALK",
            "narrator": "千羽鶴",
            "text": "けど、貴方から見れば\n酷いことである、という\n感情が芽生えるのも解る。",
            "zh": "不过，在你看来\n会萌生出“这是过分的事”\n这种感情，我也能理解。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "143/TALK",
            "narrator": "千羽鶴",
            "text": "それは、人間社会の\n一般的な常識になぞらえた\n解として。",
            "zh": "那是比照人类社会\n一般常识得出的\n解答。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "147/TALK",
            "narrator": "千羽鶴",
            "text": "それが自然な\n回答だと思う。",
            "zh": "我觉得那是很自然的\n回答。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "148/TALK",
            "narrator": "千羽鶴",
            "text": "私の本意でもないけど、\nもはや消去法でそこは\n断念せざるを得ない。",
            "zh": "虽然这也不是我的本意，\n但事已至此，用排除法\n也只能放弃这一点了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "149/TALK",
            "narrator": "千羽鶴",
            "text": "理想的なのは、私に対し\n最後まで好意を抱いた上で\n共に行動することだった。",
            "zh": "理想的状况，是你对我\n始终抱有好感，\n并与我一同行动。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "150/TALK",
            "narrator": "千羽鶴",
            "text": "けど、前回の行動は、\nそれが瓦解するのを覚悟で\n起こしている。",
            "zh": "但是上一回的行动，\n我是做好了让它崩塌的觉悟\n才采取的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "151/TALK",
            "narrator": "千羽鶴",
            "text": "本当はそれも含めて\n理解して貰いたかったけど\nそれは贅沢というもの。",
            "zh": "本来连同这一点在内\n我都希望你能理解，\n但那太奢侈了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "153/TALK",
            "narrator": "千羽鶴",
            "text": "さて。",
            "zh": "那么。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "154/TALK",
            "narrator": "千羽鶴",
            "text": "今回は、そんな貴方に\n伝えなければならない\nことがある。",
            "zh": "这次，我有件\n必须传达给这样的你的\n事情。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "155/TALK",
            "narrator": "千羽鶴",
            "text": "私を好きか嫌いか、\nその感情を超越して\n協力し続けてもらう為に。",
            "zh": "为了让你超越喜欢或讨厌\n我的感情，\n继续与我合作。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "156/TALK",
            "narrator": "千羽鶴",
            "text": "今貴方の焦点は、私と\nトライナリーたちとの\n関係じゃないかと思う。",
            "zh": "我想你现在的焦点，\n应该是我与三重奏她们\n之间的关系吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "157/TALK",
            "narrator": "千羽鶴",
            "text": "すなわち、\n私はトライナリーの\n敵なのか味方なのか。",
            "zh": "也就是说，\n我究竟是三重奏的\n敌人还是同伴。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "158/TALK",
            "narrator": "千羽鶴",
            "text": "結論から言えば、私は\n彼女たちを絶対的な敵認定\nすることはない。",
            "zh": "先说结论，我不会\n将她们认定为\n绝对的敌人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "159/TALK",
            "narrator": "千羽鶴",
            "text": "もし敵認定しているように\n見えるのであれば、それは\n本質ではない。",
            "zh": "如果看起来像把她们\n当成了敌人，那并非\n本质。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "160/TALK",
            "narrator": "千羽鶴",
            "text": "彼女たちや貴方にはまだ\n見えていない、本当に敵対\nすべき存在と戦う準備。",
            "zh": "那是为了与她们和你\n都尚未看到的、真正该敌对的\n存在战斗而做的准备。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "161/SEL",
            "narrator": "",
            "text": "見えていない敵？",
            "zh": "尚未看到的敌人？",
            "narrator_zh": ""
        },
        {
            "location": "162/ACT",
            "narrator": "",
            "text": "見えていない敵？",
            "zh": "尚未看到的敌人？",
            "narrator_zh": ""
        },
        {
            "location": "164/TALK",
            "narrator": "千羽鶴",
            "text": "そう。",
            "zh": "是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "165/TALK",
            "narrator": "千羽鶴",
            "text": "結論から言えば、私と\n彼女たちが対立関係にある\nように見えるのは――",
            "zh": "从结论上说，我和她们\n之所以看起来处于\n对立关系——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "166/TALK",
            "narrator": "千羽鶴",
            "text": "彼ら\n「まだ見えていない敵」が\n大きく関係している。",
            "zh": "和他们\n“尚未看到的敌人”\n有很大的关系。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "167/TALK",
            "narrator": "千羽鶴",
            "text": "得てして「対立」は、\nそういった存在によって\n計画的に創造される。",
            "zh": "“对立”这种东西，往往\n就是由那样的存在\n有计划地制造出来的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "168/TALK",
            "narrator": "千羽鶴",
            "text": "私たちにとってのそれは、\n私たちの日本の外側にいて\n日本を奪おうとしてる。",
            "zh": "对我们而言的那群人，\n身处我们的日本外侧，\n企图夺取日本。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "169/TALK",
            "narrator": "千羽鶴",
            "text": "私は、彼らからこの日本を\n護るべく行動してるけど、\n彼らにとって私は邪魔。",
            "zh": "我为了从他们手中\n守护这个日本而行动，\n所以对他们来说我很碍事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "170/TALK",
            "narrator": "千羽鶴",
            "text": "だから、内部で対立し\n自滅するための様々な\n工作を仕掛けてくる。",
            "zh": "因此，他们会在内部\n制造对立，设下各种\n令人自灭的手段。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "171/SEL",
            "narrator": "",
            "text": "それって人間なの？\nそれとも単なる概念？",
            "zh": "那些是人类吗？\n还是单纯的概念？",
            "narrator_zh": ""
        },
        {
            "location": "172/ACT",
            "narrator": "",
            "text": "それって人間なの？\nそれとも単なる概念？",
            "zh": "那些是人类吗？\n还是单纯的概念？",
            "narrator_zh": ""
        },
        {
            "location": "174/TALK",
            "narrator": "千羽鶴",
            "text": "もちろん人間。\n貴方と同じ、生身の。",
            "zh": "当然是人类。\n和你一样，有血有肉的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "175/TALK",
            "narrator": "千羽鶴",
            "text": "改造されていたり、\n能力者であったりはしない\nただの人。",
            "zh": "既没有经过改造，\n也不是能力者，\n只是普通人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "176/TALK",
            "narrator": "千羽鶴",
            "text": "私は彼らに育てられ、\nそして作られた。",
            "zh": "我是被他们养育、\n被他们创造出来的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "177/TALK",
            "narrator": "千羽鶴",
            "text": "いわば私にとっての\n親みたいな存在。",
            "zh": "可以说是类似于我\n父母一样的存在。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "178/TALK",
            "narrator": "千羽鶴",
            "text": "そして彼らは、この世界を\n理想的な社会に変貌させる\nことに尽力していた。",
            "zh": "而他们当时正致力于\n将这个世界改造成\n理想的社会。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "179/TALK",
            "narrator": "千羽鶴",
            "text": "私は彼らの思想に共感し\nその教えに忠実でいた\nのだけれど――",
            "zh": "我认同他们的思想，\n一直忠实于\n他们的教诲——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "180/TALK",
            "narrator": "千羽鶴",
            "text": "世界をこの目で見て、\n客観的な判断を続けるに\nつれて、徐々に理解した。",
            "zh": "但随着我用这双眼睛\n观察世界、持续做出\n客观判断，我逐渐明白了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "181/TALK",
            "narrator": "千羽鶴",
            "text": "彼らは決して理想的な\n社会を作ろうとはして\nいないし、作れない。",
            "zh": "他们根本没有打算\n创造理想的社会，\n也根本做不到。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "182/TALK",
            "narrator": "千羽鶴",
            "text": "それに気づいた私は\n彼らに解らないように\n密かに反旗を翻した。",
            "zh": "察觉到这一点后，\n我为了不让他们发现，\n暗中竖起了反旗。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "183/TALK",
            "narrator": "千羽鶴",
            "text": "けど、彼らはもうそれに\n気づいてしまったみたい。",
            "zh": "不过，他们好像\n已经察觉到了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "184/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "185/TALK",
            "narrator": "千羽鶴",
            "text": "一度に全部を伝えることは\nできない。",
            "zh": "没法一次把所有事情\n都传达给你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "186/TALK",
            "narrator": "千羽鶴",
            "text": "それに、私がいくら口で\n伝えても、貴方は実感が\n湧かないと思う。",
            "zh": "而且，不管我嘴上\n怎么说，我想你都\n很难有真实感。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "187/TALK",
            "narrator": "千羽鶴",
            "text": "翻し、私の狂気的な行動は\n実体験として目の当たりに\nしている。",
            "zh": "反过来，我那狂气的行动\n你却作为亲身体验\n亲眼目睹了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "189/TALK",
            "narrator": "千羽鶴",
            "text": "いくら貴方が私の理想に\n共感してくれているとは\nいえ、分が悪すぎる。",
            "zh": "就算你对我抱持的\n理想有所共鸣，\n局面对我也太不利了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "191/TALK",
            "narrator": "千羽鶴",
            "text": "嘘かほんとか、未だに私を\n可愛いなんて思ってくれて\nいる貴重な存在の貴方。",
            "zh": "不知是真是假，直到现在\n依然觉得我很可爱的\n珍贵存在的你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "192/TALK",
            "narrator": "千羽鶴",
            "text": "その気持ちが崩壊する\n前に、何とかこの事を\n体感してもらいたい。",
            "zh": "在那份心情崩塌之前，\n我无论如何都想让你\n切身体会一下这件事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "194/TALK",
            "narrator": "千羽鶴",
            "text": "やむを得ず酷いと思われる\nことをせざるを得ないこの\n状況。",
            "zh": "不得不做出看起来\n很过分的事情的\n这个处境。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "195/TALK",
            "narrator": "千羽鶴",
            "text": "これが続けば、いくら\n貴方が傍観者に徹して\nいてもいずれ離れていく。",
            "zh": "如果这样继续下去，就算你\n一直贯彻旁观者的立场，\n迟早也会离开。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "197/TALK",
            "narrator": "千羽鶴",
            "text": "嫌われて当然。",
            "zh": "被讨厌也是理所当然。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "199/TALK",
            "narrator": "千羽鶴",
            "text": "だから、\n少し方針を変える。",
            "zh": "所以，\n稍微改变一下方针。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "200/TALK",
            "narrator": "千羽鶴",
            "text": "次回から数回にわたって、\n記録映像含め「彼ら」に\nついて紹介したいと思う。",
            "zh": "从下一回起的几次里，\n连同记录影像在内，\n我想介绍一下“他们”。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "201/TALK",
            "narrator": "千羽鶴",
            "text": "どのみちフェイズⅢに\n突入するには、まだ少し\n時間がかかる。",
            "zh": "反正要进入阶段Ⅲ，\n还需要一点\n时间。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "202/TALK",
            "narrator": "千羽鶴",
            "text": "それまでに、可能な限り\n私の本当の想いと状況を\n共感してもらいたい。",
            "zh": "在那之前，希望能尽可能\n让你对我的真实想法和处境\n产生共鸣。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "203/TALK",
            "narrator": "千羽鶴",
            "text": "貴方に本当の\nパートナーに\nなって欲しいから。",
            "zh": "因为我希望你能成为\n我真正的\n搭档。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "205/TALK",
            "narrator": "千羽鶴",
            "text": "貴方が以前してくれた\n１つの回答――",
            "zh": "为了让你不必去做出你以前\n给过我的那一个回答——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "206/TALK",
            "narrator": "千羽鶴",
            "text": "『彼女の為に千羽鶴を\n犠牲にする』という選択を\nしなくて済むように。",
            "zh": "不必去做出“为了她\n而牺牲千羽鹤”的\n选择。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "207/TALK",
            "narrator": "千羽鶴",
            "text": "そして、もう１つの\n選択もまた、同様に\nしなくて済むように。",
            "zh": "也为了让你同样不必\n去做出另一个\n选择。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "209/TALK",
            "narrator": "千羽鶴",
            "text": "貴方が以前してくれた\n１つの回答――",
            "zh": "为了让你不必去做出你以前\n给过我的那一个回答——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "210/TALK",
            "narrator": "千羽鶴",
            "text": "『千羽鶴の為に彼女を\n犠牲にする』という選択を\nしなくて済むように。",
            "zh": "不必去做出“为了千羽鹤\n而牺牲她”的\n选择。",
            "narrator_zh": "千羽鹤"
        },
        {
