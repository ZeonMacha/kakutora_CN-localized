            "narrator": "ガブリエラ",
            "text": "そうよねvvvvvv",
            "zh": "是啊vvvvvv",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "301/ACT",
            "narrator": "",
            "text": "$handle$がいるよ",
            "zh": "$handle$在哦",
            "narrator_zh": ""
        },
        {
            "location": "304/TALK",
            "narrator": "ガブリエラ",
            "text": "でも今回はね？",
            "zh": "不过这次呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "305/TALK",
            "narrator": "ガブリエラ",
            "text": "うまくいきそうな気がするのよ",
            "zh": "感觉能顺利",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "306/TALK",
