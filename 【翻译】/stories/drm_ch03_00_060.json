    "entry": [
        {
            "location": "175/SCENARIO",
            "narrator": "",
            "text": "060_恋に恋して",
            "zh": "060_恋上恋爱",
            "narrator_zh": ""
        },
        {
            "location": "201/TALK",
            "narrator": "ガブリエラ",
            "text": "きみは持っているのかね？",
            "zh": "你有那种东西吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "202/TALK",
            "narrator": "ガブリエラ",
            "text": "王様が私に聞きました。",
            "zh": "国王问我。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/TALK",
            "narrator": "ガブリエラ",
            "text": "私は笑顔で答えます。",
            "zh": "我笑着回答。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "204/TALK",
            "narrator": "ガブリエラ",
            "text": "もちろんでございます、当然でしょう、と。",
            "zh": "当然有，这是当然的，我说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "ガブリエラ",
            "text": "王様は私に言います。",
            "zh": "国王对我说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "206/TALK",
            "narrator": "ガブリエラ",
            "text": "ならばそれを我に捧げよ、と。",
            "zh": "那就把它献给我吧，他说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "207/TALK",
            "narrator": "ガブリエラ",
            "text": "私は笑顔で答えます。",
            "zh": "我笑着回答。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "208/TALK",
            "narrator": "ガブリエラ",
            "text": "それは無理でございます、当然でしょう、と。",
            "zh": "那恕我做不到，这是当然的，她这么说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "ガブリエラ",
            "text": "王様はさらにさらに私に言います。",
            "zh": "国王还进一步对我说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "210/TALK",
            "narrator": "ガブリエラ",
            "text": "それは何故じゃ？　褒美ははずむと言っておるではないか。",
            "zh": "那为何如此？我不是说过报酬会丰厚吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "私は笑顔で答えます。",
            "zh": "我笑着回答。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "212/TALK",
            "narrator": "ガブリエラ",
            "text": "無理なものは無理でございます。なぜなら",
            "zh": "做不到的就是做不到。因为",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "私が恋をしているのは、あなたではないのですから。",
            "zh": "我所爱的，并不是你。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/SEL",
            "narrator": "",
            "text": "ガブリエラの話？",
            "zh": "加布里埃拉的事？",
            "narrator_zh": ""
        },
        {
            "location": "217/SEL",
            "narrator": "",
            "text": "恋する乙女の話だね",
            "zh": "是恋爱少女的话题呢",
            "narrator_zh": ""
        },
        {
            "location": "218/SEL",
            "narrator": "",
            "text": "なんだかよくわからない…",
            "zh": "总觉得搞不太明白……",
            "narrator_zh": ""
        },
        {
            "location": "219/ACT",
            "narrator": "",
            "text": "ガブリエラの話？",
            "zh": "加布里埃拉的事？",
            "narrator_zh": ""
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "違うわよ！",
            "zh": "才不是啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "221/TALK",
            "narrator": "ガブリエラ",
            "text": "・・・",
            "zh": "……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "そうだけど・・・",
            "zh": "是这样，不过・・・",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/ACT",
            "narrator": "",
            "text": "恋する乙女の話だね",
            "zh": "是恋爱少女的话题呢",
            "narrator_zh": ""
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "さすがねマルザンナ♪",
            "zh": "果然厉害呢，玛尔赞娜♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "よくわかってるじゃない♪",
            "zh": "你很明白嘛♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/TALK",
            "narrator": "ガブリエラ",
            "text": "その乙女って私なんだけどねvv",
            "zh": "那个少女就是我哦vv",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/ACT",
            "narrator": "",
            "text": "なんだかよくわからない…",
            "zh": "总觉得搞不太明白……",
            "narrator_zh": ""
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "そう・・・",
            "zh": "这样……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "がっかりだわ・・・",
            "zh": "真让人失望……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "246/TALK",
            "narrator": "ガブリエラ",
            "text": "でもこのお話、ちょっと直したいのよね",
            "zh": "不过这个故事，我想稍微改改",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "王様の話し相手をお姫様にしたいのよ",
            "zh": "我想让公主来当国王的谈话对象",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "どうすればいいかしら・・・",
            "zh": "该怎么办呢……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "250/SEL",
            "narrator": "",
            "text": "お姫様にすればいいだけじゃない？",
            "zh": "把她当公主殿下不就行了？",
            "narrator_zh": ""
        },
        {
            "location": "251/ACT",
            "narrator": "",
            "text": "お姫様にすればいいだけじゃない？",
            "zh": "把她当公主殿下不就行了？",
            "narrator_zh": ""
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "わかってないのね！",
            "zh": "你没明白呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/SEL",
            "narrator": "",
            "text": "うん、わからない",
            "zh": "嗯，不知道",
            "narrator_zh": ""
        },
        {
            "location": "255/SEL",
            "narrator": "",
            "text": "わかる気はするけど",
            "zh": "感觉能理解",
            "narrator_zh": ""
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "このままだと王様とお姫様の会話に見えないでしょう？",
            "zh": "就这样下去，看着不像国王和公主的对话吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "257/TALK",
            "narrator": "ガブリエラ",
            "text": "なんていうか",
            "zh": "怎么说呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "258/TALK",
            "narrator": "ガブリエラ",
            "text": "王様と村娘って感じでしょう？",
            "zh": "就是国王和村姑那种感觉吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "259/TALK",
            "narrator": "ガブリエラ",
            "text": "そうじゃなくて恋をしているお姫様にしたいの！",
            "zh": "不是那样，我想让公主谈起恋爱！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "260/TALK",
            "narrator": "ガブリエラ",
            "text": "きっと相手は王子様よね？",
            "zh": "对方一定是王子吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "261/TALK",
            "narrator": "ガブリエラ",
            "text": "でも村娘が王子様のことを好きなのはありかもしれないわ・・・",
            "zh": "不过村姑喜欢王子也许也是有的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "263/TALK",
            "narrator": "ガブリエラ",
            "text": "悲恋の乙女って感じで",
            "zh": "悲剧少女那种感觉",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "265/ACT",
            "narrator": "",
            "text": "うん、わからない",
            "zh": "嗯，不知道",
            "narrator_zh": ""
        },
        {
            "location": "266/TALK",
            "narrator": "ガブリエラ",
            "text": "でもでも、ハッピーエンドにしたいのよ",
            "zh": "可是可是，我想要好结局嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "267/ACT",
            "narrator": "",
            "text": "わかる気はするけど",
            "zh": "感觉能理解",
            "narrator_zh": ""
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "でもでも、ハッピーエンドにしたいのよ",
            "zh": "可是可是，我想要好结局嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん・・・",
            "zh": "嗯……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "271/TALK",
            "narrator": "ガブリエラ",
            "text": "なんだか、現実に戻っちゃうわ",
            "zh": "总觉得，要回到现实了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "272/TALK",
            "narrator": "ガブリエラ",
            "text": "お姫様のままで王子様に愛されることなんてありえるのかしら？",
            "zh": "一直都当公主，还能被王子爱上吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "274/SEL",
            "narrator": "",
            "text": "あったんでしょう？",
            "zh": "有的吧？",
            "narrator_zh": ""
        },
        {
            "location": "275/SEL",
            "narrator": "",
            "text": "なかったの？",
            "zh": "没有过？",
            "narrator_zh": ""
        },
        {
            "location": "276/ACT",
            "narrator": "",
            "text": "あったんでしょう？",
            "zh": "有的吧？",
            "narrator_zh": ""
        },
        {
            "location": "277/ACT",
            "narrator": "",
            "text": "なかったの？",
            "zh": "没有过？",
            "narrator_zh": ""
        },
        {
            "location": "279/TALK",
            "narrator": "ガブリエラ",
            "text": "好きだなって思う人はね？会ったことあるわよ",
            "zh": "觉得喜欢的人？我见过的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "280/TALK",
            "narrator": "ガブリエラ",
            "text": "それなりにいたわよ",
            "zh": "相应地也有不少哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "281/TALK",
            "narrator": "ガブリエラ",
            "text": "いたけど・・・・",
            "zh": "有过，可是……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "282/TALK",
            "narrator": "ガブリエラ",
            "text": "お付き合いは・・・したことがないのよ・・・",
            "zh": "交往……我从来没……有过呢……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "285/SEL",
            "narrator": "",
            "text": "いつか運命の人にめぐりあうよ",
            "zh": "总有一天会遇到命定的人",
            "narrator_zh": ""
        },
        {
            "location": "286/SEL",
            "narrator": "",
            "text": "$handle$がいるよ",
            "zh": "$handle$在哦",
            "narrator_zh": ""
        },
        {
