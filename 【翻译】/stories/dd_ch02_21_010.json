{
    "dir": "chap21/daydra/dd_ch02_21_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "21252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "実家の香り",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "老家的气息"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "実家の香り",
            "zh": "老家的气息",
            "narrator_zh": ""
        },
        {
            "location": "25/TALK",
            "narrator": "ガブリエラ",
            "text": "…夜になると暇ねぇ。",
            "zh": "……一到晚上就闲得慌。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "こんなことなら、\nパーティーゲームでも\n買っとけば良かったわ。",
            "zh": "早知道这样，\n买个派对游戏\n带过来就好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "28/TALK",
            "narrator": "神楽",
            "text": "カプドラやりながら\n言うのはどうかと\n思いますよ？",
            "zh": "一边玩着卡普多拉\n一边说这话，\n不太合适吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "29/TALK",
            "narrator": "つばめ",
            "text": "明日、何か遊べそうな\nもの買いに行ってみる？",
            "zh": "明天，要不要去买点\n能一起玩的东西呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね…アーヤは\nどう思う？",
            "zh": "也是……绫水\n觉得呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ？",
            "zh": "绫水？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "え？　あ、ごめん。\nぼーっとしてた。",
            "zh": "诶？　啊，抱歉。\n刚才在发呆。",
            "narrator_zh": "绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "神楽",
            "text": "お疲れみたいですね？\n朝の訓練、頑張り過ぎた\nんじゃないですか？",
            "zh": "看起来挺累的呢？\n是不是早上的训练，\n太拼过头了？",
            "narrator_zh": "神乐"
        },
        {
            "location": "43/TALK",
            "narrator": "つばめ",
            "text": "布団敷きましょうか？",
            "zh": "要不我帮你铺被褥吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "45/TALK",
            "narrator": "アーヤ",
            "text": "ううん、大丈夫。\nありがと。",
            "zh": "不用了，没事。\n谢谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "それで、何の話――",
            "zh": "话说回来，刚才在聊——",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ、ヤバい死にそう！\nどっちか回復して！",
            "zh": "啊，糟了要挂了！\n你们俩谁帮我恢复一下！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "つばめ",
            "text": "わたしに任せて！\nはい、もう大丈夫だよ。",
            "zh": "交给我吧！\n好啦，已经没事了哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "57/TALK",
            "narrator": "神楽",
            "text": "もぅ、ガブちゃん。\n協力プレイ中なんです\nから、集中してください。",
            "zh": "真是的，加布。\n现在正在联机协力呢，\n请集中注意力。",
            "narrator_zh": "神乐"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "わ、悪かったわよ…。",
            "zh": "我、我知道错了啦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "アーヤ",
            "text": "…ま、いっか。",
            "zh": "……算了，随她们去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "81/TALK",
            "narrator": "アーヤ",
            "text": "実家、帰りたいかも",
            "zh": "我有点想回老家了",
            "narrator_zh": "绫水"
        },
        {
            "location": "82/SEL",
            "narrator": "",
            "text": "急にどうしたの？",
            "zh": "怎么突然这么说？",
            "narrator_zh": ""
        },
        {
            "location": "83/ACT",
            "narrator": "",
            "text": "急にどうしたの？",
            "zh": "怎么突然这么说？",
            "narrator_zh": ""
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "こうしてのんびりしてると",
            "zh": "像这样悠闲地待着",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "実家の空気って、やっぱりいいなぁ、って感じちゃって",
            "zh": "就会觉得老家的空气，果然还是挺好的呀",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "アーヤ",
            "text": "この部屋が実家にある部屋と似てるから、そう思ったのかも",
            "zh": "可能是因为这间屋子和老家的房间很像，才会这么想吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "変？",
            "zh": "很奇怪吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "一番年上の私が、こんなこと言うなんて",
            "zh": "年纪最大的我，竟然说出这种话",
            "narrator_zh": "绫水"
        },
        {
            "location": "91/SEL",
            "narrator": "",
            "text": "普通のことだと思う",
            "zh": "我觉得很正常",
            "narrator_zh": ""
        },
        {
            "location": "92/SEL",
            "narrator": "",
            "text": "メールでも送ったら？",
            "zh": "发封邮件回去怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "93/SEL",
            "narrator": "",
            "text": "よし、帰ろう！",
            "zh": "好，回去吧！",
            "narrator_zh": ""
        },
        {
            "location": "94/ACT",
            "narrator": "",
            "text": "普通のことだと思う",
            "zh": "我觉得很正常",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "アーヤ",
            "text": "そっか",
            "zh": "这样啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "96/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、みんなも同じように思ってるのかしら？",
            "zh": "那，大家是不是也这么想呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "110/TALK",
            "narrator": "アーヤ",
            "text": "…なんだか、ここにいると\n実家のことを思い出さ\nない？",
            "zh": "……总觉得，待在这里\n不会让人想起\n老家的事吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "113/TALK",
            "narrator": "神楽",
            "text": "？　いえ、特に思い出し\nたりはしませんけど…。",
            "zh": "？　没有，倒也没有特别\n想起来……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "115/TALK",
            "narrator": "アーヤ",
            "text": "…そういえば、卯月の\n実家ってタワーマンション\nだったわ…。",
            "zh": "……说起来，卯月的\n老家是高层公寓\n来着……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "118/TALK",
            "narrator": "つばめ",
            "text": "わたし、思い出します。\n夜、こうやってのんびり\nしてると――",
            "zh": "我会想起来哦。\n晚上像这样悠闲地\n待着的时候——",
            "narrator_zh": "燕"
        },
        {
            "location": "119/TALK",
            "narrator": "つばめ",
            "text": "家にいた頃のことを、\n急に思い出すんです。",
            "zh": "就会突然想起\n还在家里时的事。",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "ふ～ん…そうなんだ？",
            "zh": "唔～……是这样啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "つばめ",
            "text": "えへへ…ガブちゃんは\nどうなの？",
            "zh": "嘿嘿……加布\n你呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "…食事の時になると、\nちょっと思い出す\nけど…。",
            "zh": "……到了吃饭的时候，\n倒是会稍微想起来\n一点……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "神楽",
            "text": "ガブちゃんの実家は\nポーランドですよね？",
            "zh": "加布的老家\n是在波兰对吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "134/TALK",
            "narrator": "神楽",
            "text": "まさか、ここみたいな\n美味しい和食が、\n毎晩出ていたんですか？",
            "zh": "该不会，每晚都有\n像这里一样美味的\n日料端上桌吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなわけないでしょ。\nそうじゃなくて――",
            "zh": "怎么可能啊。\n不是那个意思——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびとご両親が\n一緒にいるのを\n見ていると――",
            "zh": "看到雅和她父母\n待在一起的\n样子——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの家も、\n昔はそうだったな、\nってね…。",
            "zh": "就会觉得，我家里\n以前也是那样的呢\n……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "145/TALK",
            "narrator": "つばめ",
            "text": "そっか…。",
            "zh": "这样啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "150/TALK",
            "narrator": "ガブリエラ",
            "text": "言っておくけど、\nホームシックじゃ\nないわよ！？",
            "zh": "先说好，\n我可不是\n想家了哦！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "アーヤ",
            "text": "わかってるって。\nふふっ…安心したわ。",
            "zh": "我知道的。\n呵呵……那我就放心了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "155/TALK",
            "narrator": "つばめ",
            "text": "何がですか？",
            "zh": "什么放心了呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "158/TALK",
            "narrator": "アーヤ",
            "text": "…ううん、なんでもない。",
            "zh": "……没什么，不用在意。",
            "narrator_zh": "绫水"
        },
        {
            "location": "161/TALK",
            "narrator": "アーヤ",
            "text": "私が特別寂しがり屋、\nってわけじゃなかった\nみたいね。",
            "zh": "看来并不是只有我\n特别怕寂寞\n呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "162/ACT",
            "narrator": "",
            "text": "メールでも送ったら？",
            "zh": "发封邮件回去怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "163/TALK",
            "narrator": "アーヤ",
            "text": "メールって言われても",
            "zh": "就算你这么说",
            "narrator_zh": "绫水"
        },
        {
            "location": "164/TALK",
            "narrator": "アーヤ",
            "text": "特に用事もないし",
            "zh": "也没什么特别的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "168/TALK",
            "narrator": "アーヤ",
            "text": "…メールかぁ。",
            "zh": "……发邮件啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "アーヤ",
            "text": "…実家の方、やっぱり\n結構変わったのかしら？",
            "zh": "……老家那边，果然还是\n变化挺大的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "170/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "171/TALK",
            "narrator": "アーヤ",
            "text": "…最近どんな感じ？\n送信っと。",
            "zh": "……最近过得怎么样？\n发送。",
            "narrator_zh": "绫水"
        },
        {
            "location": "172/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "177/TALK",
            "narrator": "アーヤ",
            "text": "…あっ、返って来た。",
            "zh": "……啊，回信了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "178/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "179/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…。",
            "zh": "呵呵……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "182/TALK",
            "narrator": "神楽",
            "text": "？　珍しいですね。\n思い出し笑いですか？",
            "zh": "？　真少见呢。\n是想起什么开心事笑了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "187/TALK",
            "narrator": "アーヤ",
            "text": "ううん…、\n実家からのメールを\n読んでたの。",
            "zh": "不是……\n是在看老家发来的\n邮件。",
            "narrator_zh": "绫水"
        },
        {
            "location": "190/TALK",
            "narrator": "つばめ",
            "text": "何か面白いことでも\n書いてあったんですか？",
            "zh": "上面写了什么\n有趣的事吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "面白くて笑ったんじゃ\nなくて、う～ん――",
            "zh": "倒不是因为有趣才笑的，\n嗯——",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/TALK",
            "narrator": "アーヤ",
            "text": "なんか、相変わらずだな、\nって安心したから…\nかしら？",
            "zh": "总觉得，还是老样子呢，\n因为觉得很安心……\n吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "194/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "195/TALK",
            "narrator": "つばめ",
            "text": "わたしも、お父さんに\n送ってみようかな？",
            "zh": "我也给爸爸\n发一封试试看吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "197/TALK",
            "narrator": "神楽",
            "text": "つばめさん、結構頻繁に\n送ってませんでした？",
            "zh": "燕，你不是平时就发得\n挺勤快的吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "199/TALK",
            "narrator": "つばめ",
            "text": "いつもはお父さんから\n来たのに返信するだけ\nだから――",
            "zh": "平时都是爸爸发过来\n我才回复而已\n所以——",
            "narrator_zh": "燕"
        },
        {
            "location": "200/TALK",
            "narrator": "つばめ",
            "text": "今日は、わたしの方から\n送ってみるよ。",
            "zh": "今天，就由我这边\n主动发过去吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "201/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/TALK",
            "narrator": "ガブリエラ",
            "text": "…お父さん、\n元気にしてるかしら？",
            "zh": "……爸爸，\n现在还好吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "204/TALK",
            "narrator": "ガブリエラ",
            "text": "あとで、あたしも\n送ってみよう…。",
            "zh": "待会儿，我也\n发一封试试……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/ACT",
            "narrator": "",
            "text": "よし、帰ろう！",
            "zh": "好，回去吧！",
            "narrator_zh": ""
        },
        {
            "location": "207/TALK",
            "narrator": "アーヤ",
            "text": "はいはい",
            "zh": "好好好",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/TALK",
            "narrator": "アーヤ",
            "text": "まったく、そういう冗談ばっかり言うんだから",
            "zh": "真是的，净说这种玩笑话",
            "narrator_zh": "绫水"
        },
        {
            "location": "219/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "221/TALK",
            "narrator": "アーヤ",
            "text": "でも、私が突然そんなこと\n言ったら、みんなどういう\n反応するかしら？",
            "zh": "不过，要是我突然说出\n这种话，大家会是什么\n反应呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "223/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…もう、実家に帰ろう\nかしら？",
            "zh": "唉……要不，我还是\n回老家算了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "233/TALK",
            "narrator": "つばめ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "236/TALK",
            "narrator": "神楽",
            "text": "ど、どうしたんですか？\n急にらしくないこと\n言って…。",
            "zh": "怎、怎么了呀？\n突然说出这么不像你的话\n……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "238/TALK",
            "narrator": "アーヤ",
            "text": "ここに来てから、\n自分の実家が懐かしく\n感じちゃって――",
            "zh": "来到这里以后，\n就觉得很怀念\n自己的老家——",
            "narrator_zh": "绫水"
        },
        {
            "location": "240/TALK",
            "narrator": "アーヤ",
            "text": "帰りたいな、って\n気持ちになったのよ。",
            "zh": "于是就产生了\n想回去的念头。",
            "narrator_zh": "绫水"
        },
        {
            "location": "243/TALK",
            "narrator": "ガブリエラ",
            "text": "ほ、ホームシック？\nアーヤが！？",
            "zh": "思、思乡病？\n绫水你吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "248/TALK",
            "narrator": "アーヤ",
            "text": "なんてね、冗談よ。",
            "zh": "开玩笑的啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "249/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "251/TALK",
            "narrator": "アーヤ",
            "text": "懐かしい気持ちになりは\nしたけど、本当に帰りたい\nだなんて――",
            "zh": "虽然确实觉得很怀念，\n但要说真的想回去\n什么的——",
            "narrator_zh": "绫水"
        },
        {
            "location": "252/TALK",
            "narrator": "アーヤ",
            "text": "さすがに思わないわ、\nふふっ…。",
            "zh": "那倒还不至于，\n呵呵……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "253/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "254/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "258/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当？",
            "zh": "……真的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "259/TALK",
            "narrator": "アーヤ",
            "text": "本当よ。\n冗談って言ったでしょ？",
            "zh": "真的哦。\n我不是说了是开玩笑吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "265/TALK",
            "narrator": "神楽",
            "text": "…アーヤさん。\n普段冗談を言わない人が\n急に言ったら――",
            "zh": "……绫水。\n平时不开玩笑的人\n突然这么说的话——",
            "narrator_zh": "神乐"
        },
        {
            "location": "266/TALK",
            "narrator": "神楽",
            "text": "本当に冗談かどうか\n疑わしく思っちゃい\nますよ。",
            "zh": "会让人怀疑\n到底是不是真的在开玩笑\n哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "えっ？",
            "zh": "诶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "270/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね…実家に帰りたい、\nって言ったのも驚いた\nけど――",
            "zh": "是啊……虽然说想回老家\n就已经够让人吃惊了\n但——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "271/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな冗談をアーヤが\n言ったことの方が、\n驚き度は高いかも。",
            "zh": "绫水居然会开这种玩笑，\n这件事本身才更让人\n惊讶吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "273/TALK",
            "narrator": "アーヤ",
            "text": "私だって冗談の一つや\n二つくらい言うわよ！",
            "zh": "我也是会开一两个\n玩笑的好吗！",
            "narrator_zh": "绫水"
        },
        {
            "location": "277/TALK",
            "narrator": "アーヤ",
            "text": "…ちょっとは笑って\nもらえるかと思ったのに。",
            "zh": "……我还以为多少能\n逗大家笑一下呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "21/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月24日　 8:52 PM</color>\n合宿中、みやびの実家でのこと",
            "zh": "<color=green>8月24日　 8:52 PM</color>\n集训期间，在雅的老家",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
