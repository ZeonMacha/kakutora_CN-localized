            "narrator": "ガブリエラ",
            "text": "マルザンナ",
            "zh": "玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "聞いてちょうだい",
            "zh": "给我听好",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめのことなのよ",
            "zh": "是燕的事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "あのこ一度死んだはずなのに",
            "zh": "那个孩子明明应该死过一次",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "166/TALK",
            "narrator": "ガブリエラ",
            "text": "今トライナリーのメンバーになってるの",
            "zh": "现在却成了三重奏的成员",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "ガブリエラ",
            "text": "なんでなの？",
            "zh": "为什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "170/SEL",
            "narrator": "",
            "text": "気絶してただけじゃない？",
            "zh": "不就是昏过去了吗？",
            "narrator_zh": ""
        },
        {
            "location": "171/SEL",
            "narrator": "",
            "text": "言ってることがよくわからないけど…",
            "zh": "你说的我不太明白…",
            "narrator_zh": ""
        },
        {
            "location": "172/SEL",
            "narrator": "",
            "text": "ガブリエラはそれを確認したの？",
