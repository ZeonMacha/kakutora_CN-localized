        },
        {
            "location": "173/ACT",
            "narrator": "",
            "text": "気絶してただけじゃない？",
            "zh": "不就是昏过去了吗？",
            "narrator_zh": ""
        },
        {
            "location": "174/TALK",
            "narrator": "ガブリエラ",
            "text": "それはないわ",
