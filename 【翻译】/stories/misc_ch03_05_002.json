            "narrator": "ガブリエラ",
            "text": "信じられないわ・・・",
            "zh": "简直不敢相信・・・",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "159/SEL",
            "narrator": "",
            "text": "何の話？",
            "zh": "在说什么？",
            "narrator_zh": ""
        },
        {
            "location": "160/ACT",
            "narrator": "",
            "text": "何の話？",
