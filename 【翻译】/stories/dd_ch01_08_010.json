{
    "dir": "chap08/daydra/dd_ch01_08_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "8152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "父親へのメール",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "给爸爸的邮件"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "父親へのメール",
            "zh": "给爸爸的邮件",
            "narrator_zh": ""
        },
        {
            "location": "29/TALK",
            "narrator": "つばめ",
            "text": "う～ん…。",
            "zh": "嗯——……。",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "あら、悩みごと？",
            "zh": "哎呀，有烦恼？",
            "narrator_zh": "绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "はい…お父さんから\nメールが来ていて…。",
            "zh": "是的……爸爸发来了\n邮件……。",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "だったら、さっさと\n返信してやんなさいよ。",
            "zh": "那就赶紧\n回信啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんの\n言う通りや。",
            "zh": "加布\n说得对咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "一人娘が突然上京したん\nやき、心配なんよ。",
            "zh": "独生女突然来了东京\n啵，会担心的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "でも、毎回送ってくる\n内容が同じだと――",
            "zh": "可是，每次发来的\n内容都一样的话——",
            "narrator_zh": "燕"
        },
        {
            "location": "42/TALK",
            "narrator": "つばめ",
            "text": "なんて返せばいいか\n悩みますよぉ…。",
            "zh": "该怎么回才好\n好头疼呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "アーヤ",
            "text": "どんな内容なの？",
            "zh": "什么内容？",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "「上手くやれてるか？」\nとか――",
            "zh": "「过得还好吗？」\n之类的——",
            "narrator_zh": "燕"
        },
        {
            "location": "46/TALK",
            "narrator": "つばめ",
            "text": "「どうして連絡して\nこないんだ？」\nみたいなのばっかりです。",
            "zh": "「为什么不\n联系我？」\n净是这种。",
            "narrator_zh": "燕"
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "なのに、わたしがいつも\n同じ内容で返すと――",
            "zh": "可是，我每次都用\n一样的内容回的话——",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "同じ返事ばかりを\nするんじゃない、って\n怒るんです。",
            "zh": "他就会说别老回\n一样的话，\n然后生气。",
            "narrator_zh": "燕"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "…微笑まし過ぎぞね。",
            "zh": "……这也太温馨了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "つばめ",
            "text": "微笑ましくないですよぉ。\nこっちは本気で\n悩んでるのに…。",
            "zh": "一点也不温馨呀。\n我可是认真地\n在烦恼……。",
            "narrator_zh": "燕"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "だったら、ハッキリと\n言ってやんなさいよ。",
            "zh": "那就干脆\n跟他说清楚啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "いつも同じことばかり\n聞いてくるな、って。",
            "zh": "就说别老问\n一样的事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nそんなハッキリなんて\n言えませんよ！",
            "zh": "诶诶！？\n那么直白的话\n我说不出口呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "60/TALK",
            "narrator": "アーヤ",
            "text": "うーん…それなら――",
            "zh": "嗯……那样的话——",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "アーヤ",
            "text": "毎日代わり映えしない、\nって書いたら？",
            "zh": "写成每天都没什么变化，\n怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "それならお父さんも\n納得してくれるんじゃ\nないかしら。",
            "zh": "那样的话爸爸\n也会接受的\n吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "いんや、ここはちっくと\n奇をてらった方がえいな。",
            "zh": "才不，这里稍微\n出个奇招比较好。",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "何でそうなるのよ？",
            "zh": "怎么就变成这样了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "いつもと同じ返事や\nのうて、変わった返事を\n期待されてるんやき――",
            "zh": "要的不是\n老一套回复，是想要不一样的\n回复啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "それくらいの方が\nえいと思うんよ。",
            "zh": "我觉得那样才\n比较好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "つばめ",
            "text": "奇をてらった返事って、\nどんなのですか？",
            "zh": "出奇的回复，\n是什么样的呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "パパン大好きだよ、\nとか？",
            "zh": "爸比最喜欢你了，\n之类的咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "つばめ",
            "text": "それじゃ別人ですよ！\nそれにパパンなんて\n呼んでませんし！",
            "zh": "那就变成另一个人了呀！\n而且爸比什么的\n我才没这么叫！",
            "narrator_zh": "燕"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "いいから、さっさと\n返してあげなさい。",
            "zh": "少废话，赶紧\n回给他。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "催促のメールまで来たら\n余計返し難くなるわよ？",
            "zh": "要是连催的邮件都来了\n就更难回了哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "つばめ",
            "text": "わ、わかりました！",
            "zh": "知、知道了！",
            "narrator_zh": "燕"
        },
        {
            "location": "83/TALK",
            "narrator": "つばめ",
            "text": "でも、本当になんて\n返そう…。",
            "zh": "可是，到底该怎么\n回呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "98/TALK",
            "narrator": "つばめ",
            "text": "相談に乗ってー",
            "zh": "帮我出出主意呀——",
            "narrator_zh": "燕"
        },
        {
            "location": "100/SEL",
            "narrator": "",
            "text": "返信の内容？",
            "zh": "回信的内容？",
            "narrator_zh": ""
        },
        {
            "location": "101/ACT",
            "narrator": "",
            "text": "返信の内容？",
            "zh": "回信的内容？",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "つばめ",
            "text": "そう！",
            "zh": "对！",
            "narrator_zh": "燕"
        },
        {
            "location": "104/TALK",
            "narrator": "つばめ",
            "text": "凄く困ってるの…（泣）",
            "zh": "真的好头疼……（泣）",
            "narrator_zh": "燕"
        },
        {
            "location": "105/TALK",
            "narrator": "つばめ",
            "text": "みんなが色々アドバイスしてくれたんだけど",
            "zh": "大家给了好多建议",
            "narrator_zh": "燕"
        },
        {
            "location": "106/TALK",
            "narrator": "つばめ",
            "text": "誰のを参考にしようかな？",
            "zh": "该参考谁的好呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "108/SEL",
            "narrator": "",
            "text": "誰が何て言ってたっけ？",
            "zh": "谁说了什么来着？",
            "narrator_zh": ""
        },
        {
            "location": "109/ACT",
            "narrator": "",
            "text": "誰が何て言ってたっけ？",
            "zh": "谁说了什么来着？",
            "narrator_zh": ""
        },
        {
            "location": "111/TALK",
            "narrator": "つばめ",
            "text": "ガブリエラせんぱいが",
            "zh": "加布里埃拉前辈说的是",
            "narrator_zh": "燕"
        },
        {
            "location": "112/TALK",
            "narrator": "つばめ",
            "text": "いつも同じ質問ばかりするな、で",
            "zh": "别老问一样的问题，这样",
            "narrator_zh": "燕"
        },
        {
            "location": "113/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんが",
            "zh": "绫水说的是",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "つばめ",
            "text": "毎日代わり映えしない、で",
            "zh": "每天都没什么变化，这样",
            "narrator_zh": "燕"
        },
        {
            "location": "115/TALK",
            "narrator": "つばめ",
            "text": "みやびさんが、えっと…",
            "zh": "雅说的是，那个……",
            "narrator_zh": "燕"
        },
        {
            "location": "117/TALK",
            "narrator": "つばめ",
            "text": "パパン大好きだよ、だね…",
            "zh": "爸比最喜欢你了，这样……",
            "narrator_zh": "燕"
        },
        {
            "location": "119/SEL",
            "narrator": "",
            "text": "ガブリエラのが良さそう",
            "zh": "加布里埃拉的好像比较好",
            "narrator_zh": ""
        },
        {
            "location": "120/SEL",
            "narrator": "",
            "text": "アーヤのが無難かな？",
            "zh": "绫水的比较稳妥吧？",
            "narrator_zh": ""
        },
        {
            "location": "121/SEL",
            "narrator": "",
            "text": "みやびのアイデアが一番",
            "zh": "雅的主意最好",
            "narrator_zh": ""
        },
        {
            "location": "122/ACT",
            "narrator": "",
            "text": "ガブリエラのが良さそう",
            "zh": "加布里埃拉的好像比较好",
            "narrator_zh": ""
        },
        {
            "location": "124/TALK",
            "narrator": "つばめ",
            "text": "…こっちも、ちょっとは強気で行かないとダメかな？",
            "zh": "……我也得稍微强硬一点才行吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "125/TALK",
            "narrator": "つばめ",
            "text": "よーし、決めた！",
            "zh": "好——决定了！",
            "narrator_zh": "燕"
        },
        {
            "location": "129/TALK",
            "narrator": "つばめ",
            "text": "いつも同じ質問ばかり\nしてくるからだよ、と。",
            "zh": "就写都怪你老问\n一样的问题哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "130/TALK",
            "narrator": "つばめ",
            "text": "送信！",
            "zh": "发送！",
            "narrator_zh": "燕"
        },
        {
            "location": "138/TALK",
            "narrator": "つばめ",
            "text": "せんぱいに言われた通り、\n同じことばかり聞くな、\nって返しました。",
            "zh": "按前辈说的，\n回了别老问\n一样的事。",
            "narrator_zh": "燕"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "これでたまには違うこと\n聞かれるんじゃない？",
            "zh": "这样他偶尔也会问点\n别的了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "つばめ",
            "text": "だと良いんですけど…",
            "zh": "那样就好了……",
            "narrator_zh": "燕"
        },
        {
            "location": "144/TALK",
            "narrator": "つばめ",
            "text": "あ、あれ？",
            "zh": "啊、咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "149/TALK",
            "narrator": "アーヤ",
            "text": "もう返事が来たの？",
            "zh": "已经回信了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "150/TALK",
            "narrator": "つばめ",
            "text": "そうみたいです。\nえっと…。",
            "zh": "好像是的。\n那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "151/TALK",
            "narrator": "つばめ",
            "text": "「…だったら、たまには\nそっちからもメールを\n送ってきなさい。」",
            "zh": "「……那就偶尔\n你也主动发邮件\n过来。」",
            "narrator_zh": "燕"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "…たまには？",
            "zh": "……偶尔咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "154/TALK",
            "narrator": "アーヤ",
            "text": "もしかして、いつも\nお父さんから来るまで、\nメール送らないの？",
            "zh": "难道你总是\n等到爸爸来信，\n才发邮件？",
            "narrator_zh": "绫水"
        },
        {
            "location": "156/TALK",
            "narrator": "つばめ",
            "text": "え、えっと…\nつい忘れちゃって。",
            "zh": "诶、那个……\n一不小心就忘了。",
            "narrator_zh": "燕"
        },
        {
            "location": "157/TALK",
            "narrator": "ガブリエラ",
            "text": "そりゃあんたが悪いわ。",
            "zh": "那就是你不对。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "158/TALK",
            "narrator": "アーヤ",
            "text": "お父さんだって、\n毎回違うこと聞けたりは\nしないわよ。",
            "zh": "爸爸也\n没法每次都问\n不一样的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "161/TALK",
            "narrator": "つばめ",
            "text": "ううっ…すみません。",
            "zh": "呜……对不起。",
            "narrator_zh": "燕"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "謝る相手も違うし。\nほら、メールメール！",
            "zh": "道歉的对象也不对。\n来，邮件，邮件！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "つばめ",
            "text": "はい…「ごめんなさい。\n明日こそはこっちから\nメールします」っと。",
            "zh": "是……「对不起。\n明天一定由我这边\n发邮件」就这样。",
            "narrator_zh": "燕"
        },
        {
            "location": "168/TALK",
            "narrator": "みやび",
            "text": "忘れんようにね。",
            "zh": "可别忘掉咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "169/TALK",
            "narrator": "つばめ",
            "text": "そうですね。\n忘れたら、今度は\n怒られちゃうと思うし…。",
            "zh": "说得是呀。\n要是忘了，下次\n大概会被骂……。",
            "narrator_zh": "燕"
        },
        {
            "location": "170/ACT",
            "narrator": "",
            "text": "アーヤのが無難かな？",
            "zh": "绫水的比较稳妥吧？",
            "narrator_zh": ""
        },
        {
            "location": "171/TALK",
            "narrator": "つばめ",
            "text": "そうだよね",
            "zh": "说得也是呀",
            "narrator_zh": "燕"
        },
        {
            "location": "172/TALK",
            "narrator": "つばめ",
            "text": "実際、毎日代わり映えしないんだし",
            "zh": "实际上每天确实没什么变化",
            "narrator_zh": "燕"
        },
        {
            "location": "176/TALK",
            "narrator": "つばめ",
            "text": "えっと…毎日代わり映え\nしなくて、書くことが\nありません。",
            "zh": "那个……每天都没什么\n变化，没有什么\n可写的。",
            "narrator_zh": "燕"
        },
        {
            "location": "177/TALK",
            "narrator": "つばめ",
            "text": "送信！",
            "zh": "发送！",
            "narrator_zh": "燕"
        },
        {
            "location": "184/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんのアドバイス、\n参考にしました。",
            "zh": "参考了\n绫水的建议。",
            "narrator_zh": "燕"
        },
        {
            "location": "186/TALK",
            "narrator": "アーヤ",
            "text": "力になれてよかった。\nお父さん、納得して\nくれるといいわね。",
            "zh": "能帮上忙就好。\n希望爸爸能\n接受。",
            "narrator_zh": "绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "つばめ",
            "text": "はい！",
            "zh": "好！",
            "narrator_zh": "燕"
        },
        {
            "location": "192/TALK",
            "narrator": "つばめ",
            "text": "って、あれ！？",
            "zh": "等、咦！？",
            "narrator_zh": "燕"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "もう返事来たの！？",
            "zh": "回复已经来了！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "つばめ",
            "text": "みたいです。\nえっと…。",
            "zh": "好像是。\n那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "199/TALK",
            "narrator": "つばめ",
            "text": "「毎日同じわけあるか。\n少しは変わったことも\nあっただろう？」",
            "zh": "「怎么可能每天都一样。\n多少也会有\n不一样的事吧？」",
            "narrator_zh": "燕"
        },
        {
            "location": "200/TALK",
            "narrator": "つばめ",
            "text": "もぉ…何も無いって\n言ってるのに！",
            "zh": "真是的……都说什么都\n没有了！",
            "narrator_zh": "燕"
        },
        {
            "location": "202/TALK",
            "narrator": "みやび",
            "text": "それだけ心配しちゅう\n証拠やね。",
            "zh": "这就是他在担心的\n证据咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "204/TALK",
            "narrator": "みやび",
            "text": "きっと、つばめちゃんと\n色んなこと話したいんや\nない？",
            "zh": "肯定是想跟燕\n聊好多事\n啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "207/TALK",
            "narrator": "つばめ",
            "text": "そうでしょうか？",
            "zh": "是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "208/TALK",
            "narrator": "アーヤ",
            "text": "多分ね。",
            "zh": "大概是吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "209/TALK",
            "narrator": "アーヤ",
            "text": "きっと、お父さんも\n寂しいんじゃないかしら？",
            "zh": "爸爸肯定也\n寂寞吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "つばめがこっちに来て、\n急に一人になっちゃった\nわけだし…。",
            "zh": "燕来了这边，\n他一下子就成\n一个人了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "211/TALK",
            "narrator": "つばめ",
            "text": "そっか…。\nお父さん、\n家で一人なんだ…。",
            "zh": "这样啊……。\n爸爸，\n一个人在家……。",
            "narrator_zh": "燕"
        },
        {
            "location": "213/TALK",
            "narrator": "つばめ",
            "text": "今夜、お父さんに\n電話してみようかな？",
            "zh": "今晚，要不要给爸爸\n打个电话呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "214/ACT",
            "narrator": "",
            "text": "みやびのアイデアが一番",
            "zh": "雅的主意最好",
            "narrator_zh": ""
        },
        {
            "location": "216/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "217/TALK",
            "narrator": "つばめ",
            "text": "まさか、みやびさんのを勧めてくるとは思わなかったよ",
            "zh": "没想到你会推荐雅的呀",
            "narrator_zh": "燕"
        },
        {
            "location": "218/TALK",
            "narrator": "つばめ",
            "text": "う～ん…大丈夫かなぁ？",
            "zh": "嗯——……没问题吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "219/TALK",
            "narrator": "つばめ",
            "text": "…でも、驚いたお父さんが\nどう返してくるか、\nちょっと気になるかも。",
            "zh": "……不过，吓一跳的爸爸\n会怎么回，\n有点在意。",
            "narrator_zh": "燕"
        },
        {
            "location": "222/TALK",
            "narrator": "つばめ",
            "text": "よーし…「パパン、\n大好きだよ」っと。",
            "zh": "好……「爸比，\n最喜欢你了」就这样。",
            "narrator_zh": "燕"
        },
        {
            "location": "223/TALK",
            "narrator": "つばめ",
            "text": "送信です！",
            "zh": "发送！",
            "narrator_zh": "燕"
        },
        {
            "location": "231/TALK",
            "narrator": "つばめ",
            "text": "思い切って、奇をてらって\nみました！",
            "zh": "豁出去，试了\n出奇的写法！",
            "narrator_zh": "燕"
        },
        {
            "location": "233/TALK",
            "narrator": "アーヤ",
            "text": "あはは…お父さん、\nきっと驚くわね。",
            "zh": "啊哈哈……爸爸\n肯定会吓一跳。",
            "narrator_zh": "绫水"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "てか、パパンなんて\n冗談でも恥ずかしいわ。",
            "zh": "再说，爸比什么的\n就算开玩笑也丢人。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "235/TALK",
            "narrator": "つばめ",
            "text": "い、いいんです。\nいつもと違った内容では\nあるんだし…。",
            "zh": "没、没关系。\n内容跟平时不一样\n就行……。",
            "narrator_zh": "燕"
        },
        {
            "location": "236/TALK",
            "narrator": "みやび",
            "text": "別人やと思われなければ\nえいんやけんどね。",
            "zh": "只要没被当成\n另一个人就好，但是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "240/TALK",
            "narrator": "みやび",
            "text": "…ん？\nつばめちゃん、スマホが\n震えちゅう。",
            "zh": "……嗯？\n燕，手机\n在震咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "242/TALK",
            "narrator": "つばめ",
            "text": "えっ？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "246/TALK",
            "narrator": "つばめ",
            "text": "あっ！\nもう返信が着ました！",
            "zh": "啊！\n回复已经到了！",
            "narrator_zh": "燕"
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "何て返ってきた？",
            "zh": "回了什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "248/TALK",
            "narrator": "つばめ",
            "text": "えーっと…。",
            "zh": "那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "249/TALK",
            "narrator": "つばめ",
            "text": "「電話で同じことを\n言えるのか？――",
            "zh": "「电话里说得出\n同样的话吗？——",
            "narrator_zh": "燕"
        },
        {
            "location": "250/TALK",
            "narrator": "つばめ",
            "text": "言えないことは\n書くんじゃない」",
            "zh": "说不出口的事\n就别写」",
            "narrator_zh": "燕"
        },
        {
            "location": "251/TALK",
            "narrator": "アーヤ",
            "text": "…驚いてはいない\nみたいね。",
            "zh": "……看起来并没有\n被吓到。",
            "narrator_zh": "绫水"
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、狙い過ぎて\nスベッてるじゃん。",
            "zh": "再说，用力过猛\n冷场了吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/TALK",
            "narrator": "みやび",
            "text": "ふむ…中々上手い返しを\nしてくるお父さんやね。",
            "zh": "唔……这个爸爸回得\n蛮厉害的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "258/TALK",
            "narrator": "つばめ",
            "text": "感心しないでください！\nこういう時、なんて\n返せばいいんですか？",
            "zh": "请别感叹了！\n这种时候，该怎么\n回才好呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "259/TALK",
            "narrator": "みやび",
            "text": "寄をてらうんやったら\n「怒りん坊のパパンも\nカワイイ☆」やね。",
            "zh": "要出奇的话\n「爱闹别扭的爸比也\n可爱☆」咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "260/TALK",
            "narrator": "みやび",
            "text": "狙わないんやったら、\n「ごめんなさい」が\nえいと思うよ。",
            "zh": "不玩花样的话，\n「对不起」\n就好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "265/TALK",
            "narrator": "つばめ",
            "text": "「ごめんなさい」送信！",
            "zh": "「对不起」发送！",
            "narrator_zh": "燕"
        },
        {
            "location": "268/TALK",
            "narrator": "アーヤ",
            "text": "…凄く後悔してる\nみたいよ？",
            "zh": "……看起来后悔得\n很厉害哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "270/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんのお父さん、\nジョークの通じん人\nやったみたいやね。",
            "zh": "燕的爸爸，\n好像是个听不懂\n玩笑的人咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "17/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月11日　4:56 PM</color>\n転校３日目、神楽坂トライナリーでのバイト中のこと。",
            "zh": "<color=green>5月11日　4:56 PM</color>\n转学第3天，在神乐坂三重奏打工的时候。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
