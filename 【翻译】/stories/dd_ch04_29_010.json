            "narrator_zh": "雏"
        },
        {
            "location": "172/TALK",
            "narrator": "繭",
            "text": "やるだけやってみるわ",
            "zh": "尽力去做就是",
            "narrator_zh": "茧"
        },
        {
            "location": "173/ACT",
            "narrator": "",
            "text": "危なくなったら逃げるんだよ？",
            "zh": "情况不妙就快逃哦？",
            "narrator_zh": ""
        },
        {
            "location": "174/TALK",
            "narrator": "雛",
            "text": "逃げ足なら任せて！",
            "zh": "论逃跑，包在我身上！",
            "narrator_zh": "雏"
        },
        {
            "location": "175/TALK",
            "narrator": "雛",
            "text": "そういう時は結構早いんだよー",
            "zh": "这种时候我跑得可快了哟——",
            "narrator_zh": "雏"
        },
        {
            "location": "176/TALK",
            "narrator": "ヒカル",
            "text": "できれば",
            "zh": "可以的话",
            "narrator_zh": "光"
        },
        {
            "location": "177/TALK",
            "narrator": "ヒカル",
            "text": "必要にならないことを祈ってます",
            "zh": "祈祷这招用不上",
            "narrator_zh": "光"
        },
        {
            "location": "178/TALK",
            "narrator": "繭",
            "text": "同感",
            "zh": "同感",
            "narrator_zh": "茧"
        },
        {
            "location": "179/TALK",
            "narrator": "キリト",
            "text": "ま、なんとかなるさ",
            "zh": "嘛，总会有办法的",
            "narrator_zh": "圣翔"
        },
        {
            "location": "180/ACT",
            "narrator": "",
            "text": "みんなを助けてあげて",
            "zh": "要互相照应着点",
            "narrator_zh": ""
        },
        {
            "location": "181/TALK",
            "narrator": "雛",
            "text": "もちろんだよ！",
            "zh": "当然啦！",
            "narrator_zh": "雏"
        },
        {
            "location": "182/TALK",
            "narrator": "雛",
            "text": "絶対みんな助けるからね！",
            "zh": "绝对会把大家都救出来的！",
            "narrator_zh": "雏"
        },
        {
            "location": "183/TALK",
            "narrator": "繭",
            "text": "やるからには徹底的にやる",
            "zh": "要干就干彻底",
            "narrator_zh": "茧"
        },
        {
            "location": "184/TALK",
            "narrator": "ヒカル",
            "text": "微力を尽くします",
            "zh": "定当尽绵薄之力",
            "narrator_zh": "光"
        },
        {
            "location": "185/TALK",
            "narrator": "キリト",
            "text": "大船に乗った気でいろって！",
            "zh": "你就放心大胆地靠过来！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "187/TALK",
            "narrator": "キリト",
            "text": "成功したらまた連絡するぜ！",
            "zh": "成功了再跟你联络！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "201/TALK",
            "narrator": "みやび",
            "text": "ふむ…あの床下のＰＣを\n起動しようとしちゅうが\nですか…。",
            "zh": "唔……那帮家伙是想\n启动那台地板下的\nＰＣ咩……。",
            "narrator_zh": "雅"
        },
        {
            "location": "203/TALK",
            "narrator": "真幌",
            "text": "うむ…まさかとは思うが、\nあいつらあれを使って――",
            "zh": "唔……难以置信，\n但那帮家伙该不会想用那个——",
            "narrator_zh": "真幌"
        },
        {
            "location": "207/TALK",
            "narrator": "みやび",
            "text": "あ、すみません。\nメールが来て…。",
            "zh": "啊，不好意思。\n来了邮件……。",
            "narrator_zh": "雅"
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "211/TALK",
            "narrator": "真幌",
            "text": "どうした？\n東京からか？",
            "zh": "怎么了？\n是东京来的吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "212/TALK",
            "narrator": "みやび",
            "text": "…ちくっとだけ\n待ってください。",
            "zh": "……请等子\n一下。",
            "narrator_zh": "雅"
        },
        {
            "location": "217/TALK",
            "narrator": "みやび",
            "text": "相棒の仕業であろう？",
            "zh": "是搭档搞的鬼吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "218/TALK",
            "narrator": "みやび",
            "text": "うさぎ達が",
            "zh": "兔子们",
            "narrator_zh": "雅"
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "こうも活発なのは",
            "zh": "会这么活跃",
            "narrator_zh": "雅"
        },
        {
            "location": "221/SEL",
            "narrator": "（選択肢）",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "222/ACT",
            "narrator": "",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "224/TALK",
            "narrator": "みやび",
            "text": "うさぎからのメール",
            "zh": "兔子的邮件里",
            "narrator_zh": "雅"
        },
        {
            "location": "225/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんの監禁場所と",
            "zh": "附有燕的关押地点，",
            "narrator_zh": "雅"
        },
        {
            "location": "226/TALK",
            "narrator": "みやび",
            "text": "移送計画についての資料が添付されている",
            "zh": "和移送计划的资料。",
            "narrator_zh": "雅"
        },
        {
            "location": "227/TALK",
            "narrator": "みやび",
            "text": "これは",
            "zh": "这个",
            "narrator_zh": "雅"
        },
        {
            "location": "228/TALK",
            "narrator": "みやび",
            "text": "相棒がけしかけたのか？",
            "zh": "是搭档撺掇的？",
            "narrator_zh": "雅"
        },
        {
            "location": "229/TALK",
            "narrator": "みやび",
            "text": "うさぎ達に",
            "zh": "你叫兔子们",
            "narrator_zh": "雅"
        },
        {
            "location": "230/TALK",
            "narrator": "みやび",
            "text": "うちらを助けろ言うたが？",
            "zh": "来救我们了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "232/SEL",
            "narrator": "（選択肢）",
            "text": "知りませんね",
            "zh": "我可不知道哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "233/SEL",
            "narrator": "（選択肢）",
            "text": "みんなが決めたこと",
            "zh": "是大家自己决定的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "234/SEL",
            "narrator": "（選択肢）",
            "text": "今はそんなこと言ってる場合じゃない",
            "zh": "现在不是说这个的时候吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "235/ACT",
            "narrator": "",
            "text": "知りませんね",
            "zh": "我可不知道哦",
            "narrator_zh": ""
        },
        {
            "location": "237/TALK",
            "narrator": "みやび",
            "text": "信じられん",
            "zh": "真是难以置信",
            "narrator_zh": "雅"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "とはいえ",
            "zh": "话虽如此",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "みやび",
            "text": "全部が全部相棒のせいとは言わん",
            "zh": "倒也不能全算在搭档头上",
            "narrator_zh": "雅"
        },
        {
            "location": "240/TALK",
            "narrator": "みやび",
            "text": "あの子らの意志も",
            "zh": "那帮孩子自己的意愿",
            "narrator_zh": "雅"
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "間違いなくあったと思うのでな",
            "zh": "肯定也是有的",
            "narrator_zh": "雅"
        },
        {
            "location": "242/ACT",
            "narrator": "",
            "text": "みんなが決めたこと",
            "zh": "是大家自己决定的",
            "narrator_zh": ""
        },
        {
            "location": "244/TALK",
            "narrator": "みやび",
            "text": "本当か？",
            "zh": "当真？",
            "narrator_zh": "雅"
        },
        {
            "location": "247/TALK",
            "narrator": "みやび",
            "text": "そうか",
            "zh": "这样啊",
            "narrator_zh": "雅"
        },
        {
            "location": "248/TALK",
            "narrator": "みやび",
            "text": "あの子達が",
            "zh": "那帮孩子",
            "narrator_zh": "雅"
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "自分で決めたことか",
            "zh": "是自己决定的啊",
            "narrator_zh": "雅"
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "ならば",
            "zh": "那么",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "何も文句は言えんな",
            "zh": "我没什么可抱怨的了",
            "narrator_zh": "雅"
        },
        {
            "location": "254/ACT",
            "narrator": "",
            "text": "今はそんなこと言ってる場合じゃない",
            "zh": "现在不是说这个的时候吧",
            "narrator_zh": ""
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "確かにそうなのだが",
            "zh": "确实是这样没错",
            "narrator_zh": "雅"
        },
        {
            "location": "259/TALK",
            "narrator": "みやび",
            "text": "まあいいだろう",
            "zh": "罢了，就这样吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "264/TALK",
            "narrator": "みやび",
            "text": "うちが覚えていればだが",
            "zh": "——前提是，我还记得这事的话。[?]",
            "narrator_zh": "雅"
        },
        {
            "location": "266/TALK",
            "narrator": "みやび",
            "text": "さて",
            "zh": "好了",
            "narrator_zh": "雅"
        },
        {
            "location": "267/TALK",
            "narrator": "みやび",
            "text": "うちはまほさんに報告せねばならん",
            "zh": "我得向真幌报告了",
            "narrator_zh": "雅"
        },
        {
            "location": "268/TALK",
            "narrator": "みやび",
            "text": "多分",
            "zh": "多半",
            "narrator_zh": "雅"
        },
        {
            "location": "269/TALK",
            "narrator": "みやび",
            "text": "怒ると予想する",
            "zh": "会被骂的",
            "narrator_zh": "雅"
        },
        {
            "location": "280/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "281/TALK",
            "narrator": "真幌",
            "text": "おい、みやび。\n誰からのメールかと\n聞いているのだが？",
            "zh": "喂，雅。\n我问你邮件是谁\n发来的呢？",
            "narrator_zh": "真幌"
        },
        {
            "location": "283/TALK",
            "narrator": "みやび",
            "text": "…察しのとおり、\nうさぎからです…。",
            "zh": "……和您猜的一样，\n是兔子发来的……。",
            "narrator_zh": "雅"
        },
        {
            "location": "284/TALK",
            "narrator": "真幌",
            "text": "なんと言ってきた？",
            "zh": "说了什么？",
            "narrator_zh": "真幌"
        },
        {
            "location": "286/TALK",
            "narrator": "みやび",
            "text": "…今夜行動開始。\nメッセージはそれだけ\nでしたけんど…。",
            "zh": "……「今晚开始行动」。\n消息就这么多，\n但是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "287/TALK",
            "narrator": "みやび",
            "text": "一緒に、つばめちゃんの\n監禁場所と、移送計画書が\n添付されてましたよ。",
            "zh": "一起附上的，还有燕的\n关押地点，和\n移送计划书哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "288/TALK",
            "narrator": "真幌",
            "text": "…それは、本物か？",
            "zh": "……那是，真的吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "289/TALK",
            "narrator": "みやび",
            "text": "うさぎから送られてきた\nものである以上、\nうちは信じますがよ。",
            "zh": "既然是兔子送来的\n东西，我就\n相信咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "290/TALK",
            "narrator": "みやび",
            "text": "…こっちが、ミスして\n居場所バレるんを\n恐れて…。",
            "zh": "……是怕这边\n出岔子，\n把位置暴露了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "291/TALK",
            "narrator": "みやび",
            "text": "ハッキングすらできない\n状況なのをわかって、\n送ってきたんでしょうね。",
            "zh": "知道我们连黑进系统\n都做不到，\n才送来的吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "292/TALK",
            "narrator": "真幌",
            "text": "…それは、管理庁に\nハッキングして手に入れた\nデータなんだな？",
            "zh": "……也就是说，那是\n黑进管理厅拿到的\n数据，没错吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "293/TALK",
            "narrator": "みやび",
            "text": "間違いないでしょうね。\nうさぎやったらそれくらい\n朝飯前やし…。",
            "zh": "应该错不了。\n对兔子来说，那种程度\n不过是小菜一碟……。",
            "narrator_zh": "雅"
        },
        {
            "location": "294/TALK",
            "narrator": "真幌",
            "text": "なんてバカなことを！\nバレればただでは\nすまんのだぞ！？",
            "zh": "干的多蠢的事！\n一旦暴露，绝不会\n轻易了事的！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "295/TALK",
            "narrator": "みやび",
            "text": "まほさん…気持ちは\nわかりますけんど、\n怒らんでやってください。",
            "zh": "真幌……您的心情\n我明白，但是，\n请别生气。",
            "narrator_zh": "雅"
        },
        {
            "location": "296/TALK",
            "narrator": "みやび",
            "text": "うさぎが送ってくれた\n資料は、うちらにとって\nかなり助かる代物です。",
            "zh": "兔子送来的资料，\n对我们来说，\n可是帮大忙的好东西。",
            "narrator_zh": "雅"
        },
        {
            "location": "298/TALK",
            "narrator": "みやび",
            "text": "それに、床下のＰＣを\n起動するゆうことは…。",
            "zh": "而且，启动地板下的\nＰＣ这件事……。",
            "narrator_zh": "雅"
        },
        {
            "location": "299/TALK",
            "narrator": "みやび",
            "text": "管理庁のシステムを\n妨害するためかと。",
            "zh": "应该是为了\n妨碍管理厅的系统。",
            "narrator_zh": "雅"
        },
        {
            "location": "300/TALK",
            "narrator": "みやび",
            "text": "危険な行為かもしれません\nけんど、確実にうちらの\n助けになっちゅうがですよ。",
            "zh": "虽然可能是危险的\n行为，但是，\n确实能帮到我们哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "301/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "302/TALK",
            "narrator": "みやび",
            "text": "うちの言うてること、\n間違うてますか？",
            "zh": "我讲的这些，\n错了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "303/TALK",
            "narrator": "真幌",
            "text": "…間違いではない。",
            "zh": "……没有错。",
            "narrator_zh": "真幌"
        },
        {
            "location": "304/TALK",
            "narrator": "真幌",
            "text": "あいつらの送ってきた\n逢瀬についての資料も…。",
            "zh": "他们送来的\n关于逢濑的资料也……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "305/TALK",
            "narrator": "真幌",
            "text": "床下ＰＣのことも、\n私達にとって有利になる\n行動なのは確かだ。",
            "zh": "地板下ＰＣ的事，\n也确实是对我们有利的\n行动。",
            "narrator_zh": "真幌"
        },
        {
            "location": "306/TALK",
            "narrator": "みやび",
            "text": "でしょう？",
            "zh": "对吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "307/TALK",
            "narrator": "真幌",
            "text": "…だが、私は教師という\n立場にある身だ。",
            "zh": "……但是，我身为\n教师，立场在此。",
            "narrator_zh": "真幌"
        },
        {
            "location": "308/TALK",
            "narrator": "真幌",
            "text": "私達のためとはいえ、\n命に関わる危険な行為を\nすることを…。",
            "zh": "虽说是为了我们，\n但要做那种性命攸关的\n危险行为……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "309/TALK",
            "narrator": "真幌",
            "text": "認めることはできない。",
            "zh": "我无法认可。",
            "narrator_zh": "真幌"
        },
        {
            "location": "310/TALK",
            "narrator": "みやび",
            "text": "…本心でも、\nそう思うてるがですか？",
            "zh": "……您心里面，\n也是这么想的吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "312/TALK",
            "narrator": "真幌",
            "text": "…私の本心は関係ない。\n立場上、叱らなければ\nならないんだ…。",
            "zh": "……我的真心无关紧要。\n立场所在，我不得不\n训斥你们……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "313/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "314/SEL",
            "narrator": "（選択肢）",
            "text": "みんな優秀な生徒だと思うよ",
            "zh": "我觉得大家都是很优秀的学生哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "315/SEL",
            "narrator": "（選択肢）",
            "text": "少しは喜んであげてほしい",
            "zh": "多少也替他们高兴一下嘛",
            "narrator_zh": "（选项）"
        },
        {
            "location": "316/ACT",
            "narrator": "",
            "text": "みんな優秀な生徒だと思うよ",
            "zh": "我觉得大家都是很优秀的学生哦",
            "narrator_zh": ""
        },
        {
            "location": "333/TALK",
            "narrator": "みやび",
            "text": "まほさんへか？",
            "zh": "是说给真幌听的吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "334/TALK",
            "narrator": "みやび",
            "text": "伝えておこう",
            "zh": "我会转告的",
            "narrator_zh": "雅"
        },
        {
            "location": "340/TALK",
            "narrator": "みやび",
            "text": "…まほさん、\nこれ見てください。",
            "zh": "……真幌，\n请看这个。",
            "narrator_zh": "雅"
        },
        {
            "location": "342/TALK",
            "narrator": "真幌",
            "text": "ん…？",
            "zh": "嗯……？",
            "narrator_zh": "真幌"
        },
        {
            "location": "343/TALK",
            "narrator": "真幌",
            "text": "…当たり前だ。\n私の生徒だからな、\nみんな優秀だぞ。",
            "zh": "……理所当然。\n都是我的学生，\n自然个个优秀。",
            "narrator_zh": "真幌"
        },
        {
            "location": "346/ACT",
            "narrator": "",
            "text": "少しは喜んであげてほしい",
            "zh": "多少也替他们高兴一下嘛",
            "narrator_zh": ""
        },
        {
            "location": "363/TALK",
            "narrator": "みやび",
            "text": "それができんから",
            "zh": "正因为做不到",
            "narrator_zh": "雅"
        },
        {
            "location": "364/TALK",
            "narrator": "みやび",
            "text": "辛そうなのであろう",
            "zh": "您脸上才那么难受吧",
            "narrator_zh": "雅"
        },
        {
            "location": "365/TALK",
            "narrator": "みやび",
            "text": "これ以上辛そうな顔させられん",
            "zh": "再难受的脸色，我也不忍心让您露出了",
            "narrator_zh": "雅"
        },
        {
            "location": "366/TALK",
            "narrator": "みやび",
            "text": "このことは",
            "zh": "这件事",
            "narrator_zh": "雅"
        },
        {
            "location": "367/TALK",
            "narrator": "みやび",
            "text": "まほさんには伝えんぞ",
            "zh": "我就不转告真幌了。",
            "narrator_zh": "雅"
        },
        {
            "location": "380/TALK",
            "narrator": "真幌",
            "text": "…おい、みやび。",
            "zh": "……喂，雅。",
            "narrator_zh": "真幌"
        },
        {
            "location": "381/TALK",
            "narrator": "真幌",
            "text": "おまえ達の乗ってきた\n車に、私の分の装備一式は\n乗っていたか？",
            "zh": "你们坐来的车上，\n装着我那份\n全套装备了吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "383/TALK",
            "narrator": "みやび",
            "text": "ああ、あれって\nまほさん用でしたか。",
            "zh": "啊，原来那套\n是给真幌备的啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "384/TALK",
            "narrator": "みやび",
            "text": "確かに、一人分の\n装備一式載ってました\nけんど…。",
            "zh": "确实，车上放着\n一套单人份的\n装备，但是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "385/TALK",
            "narrator": "みやび",
            "text": "…まさか、まほさんも\n一緒に行くつもりですか？",
            "zh": "……该不会，真幌\n也打算一起去吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "386/TALK",
            "narrator": "真幌",
            "text": "当然だ。",
            "zh": "当然。",
            "narrator_zh": "真幌"
        },
        {
            "location": "387/TALK",
            "narrator": "真幌",
            "text": "いつもとは違い、\n今回は教師の言うことを\n聞きやしない…。",
            "zh": "和平时不同，\n这次你们可不会听\n教师的话……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "388/TALK",
            "narrator": "真幌",
            "text": "問題のある生徒も\n来るかもしれんからな。",
            "zh": "毕竟搞不好会有\n问题学生跟来。",
            "narrator_zh": "真幌"
        },
        {
            "location": "389/TALK",
            "narrator": "みやび",
            "text": "なら、そっちもうちらで\nやっておきますき、\nまほさんは――",
            "zh": "那样的话，那件事\n我们也能代办好咧，\n真幌您就——",
            "narrator_zh": "雅"
        },
        {
            "location": "390/TALK",
            "narrator": "真幌",
            "text": "それはおまえ達の\n仕事じゃない。",
            "zh": "那不是你们的\n工作。",
            "narrator_zh": "真幌"
        },
        {
            "location": "391/TALK",
            "narrator": "真幌",
            "text": "危険なことをする\n生徒を守り…。",
            "zh": "保护去做危险事的\n学生……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "392/TALK",
            "narrator": "真幌",
            "text": "言うことを聞かない\n生徒を叱る。",
            "zh": "训斥不听话的\n学生。",
            "narrator_zh": "真幌"
        },
        {
            "location": "393/TALK",
            "narrator": "真幌",
            "text": "それが私の仕事だ…。\n私の仕事を奪わないで\nもらいたいな。",
            "zh": "这才是我的工作……。\n请别夺走\n我的工作。",
            "narrator_zh": "真幌"
        },
        {
            "location": "394/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "396/TALK",
            "narrator": "みやび",
            "text": "問題児達の指導、\nよろしく頼みますがよ。\n東雲先生。",
            "zh": "问题儿童们的管教，\n就拜托您了。\n东云老师。",
            "narrator_zh": "雅"
        },
        {
            "location": "397/TALK",
            "narrator": "真幌",
            "text": "…言われるまでもないさ。",
            "zh": "……不用你说也知道。",
            "narrator_zh": "真幌"
        }
    ]
}
