{
    "dir": "chap29/daydra/dd_ch04_29_010.js",
    "type": "",
    "info": {
        "story_id": "50015",
        "cid": "",
        "title": "SideStory015 ストーリー",
        "sub_title": "FILE12.躍進",
        "title_zh": "SideStory015 剧情",
        "sub_title_zh": "FILE12.跃进"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "東京編１２話",
            "zh": "东京篇第12话",
            "narrator_zh": ""
        },
        {
            "location": "22/DIALOG",
            "narrator": "",
            "text": "<color=green>9月6日　 8:17 PM</color>\n神楽坂トライナリー偵察後、カラオケボックスにて",
            "zh": "<color=green>9月6日　 8:17 PM</color>\n神乐坂三重奏侦察结束后，在卡拉OK包厢",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "キリト",
            "text": "マジか！？\n劇場に入れそうな場所、\n見つかったのか！",
            "zh": "真的假的！？\n找到能进剧场的\n地方了！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "25/TALK",
            "narrator": "ヒカル",
            "text": "うん…かなり強引な\n方法をとる必要が\nあるけど…。",
            "zh": "嗯……虽然得用\n相当强硬的\n手段……。",
            "narrator_zh": "光"
        },
        {
            "location": "26/TALK",
            "narrator": "ヒカル",
            "text": "間違いなく、\n気づかれずに\n劇場に入れるはずだよ。",
            "zh": "可以肯定，\n能不被察觉地\n进到剧场里。",
            "narrator_zh": "光"
        },
        {
            "location": "28/TALK",
            "narrator": "繭",
            "text": "…でも、どうやって？\n劇場の周囲は厳重に\n警備されてるのに…。",
            "zh": "……但是，怎么进？\n剧场周围戒备得\n那么严……。",
            "narrator_zh": "茧"
        },
        {
            "location": "30/TALK",
            "narrator": "雛",
            "text": "はーい、囮役のあたしが\n注意を引きまーす。",
            "zh": "好——的，当诱饵的我\n来吸引注意——。",
            "narrator_zh": "雏"
        },
        {
            "location": "31/TALK",
            "narrator": "雛",
            "text": "時間になったら、\n警備の人達に聞こえる\nところで――",
            "zh": "时间一到，\n就挑保安们听得见的\n地方——",
            "narrator_zh": "雏"
        },
        {
            "location": "33/TALK",
            "narrator": "雛",
            "text": "きゃーっ、痴漢ー！！\n誰か助けてー！！！！",
            "zh": "呀——！色狼——！！\n谁来救救我——！！！！",
            "narrator_zh": "雏"
        },
        {
            "location": "35/TALK",
            "narrator": "雛",
            "text": "…って、叫ぶ予定！",
            "zh": "……以上，是我打算喊的话！",
            "narrator_zh": "雏"
        },
        {
            "location": "38/TALK",
            "narrator": "繭",
            "text": "…本気？",
            "zh": "……当真？",
            "narrator_zh": "茧"
        },
        {
            "location": "40/TALK",
            "narrator": "雛",
            "text": "ヒカルくんが\n考えた作戦だよー。",
            "zh": "这可是光\n想出来的作战哟——。",
            "narrator_zh": "雏"
        },
        {
            "location": "41/TALK",
            "narrator": "キリト",
            "text": "マジかよ！？\nヒカルがこんな作戦\n考えるなんて…。",
            "zh": "真的假的！？\n光居然能想出\n这种作战……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "42/TALK",
            "narrator": "ヒカル",
            "text": "可愛い女の子が悪漢に\n襲われてると聞けば、\nみんな放っておかないさ。",
            "zh": "只要听说可爱的女孩子\n被坏人袭击，\n谁都不会坐视不管的。",
            "narrator_zh": "光"
        },
        {
            "location": "44/TALK",
            "narrator": "雛",
            "text": "えへへ、可愛いだなんて、\nそんな事実を言われると\n照れちゃうよー。",
            "zh": "诶嘿嘿，被说什么可爱，\n一听到这种事实，\n就会害羞的呀——。",
            "narrator_zh": "雏"
        },
        {
            "location": "46/TALK",
            "narrator": "キリト",
            "text": "…もう少し可愛い子に\n頼んだ方がいいんじゃね？",
            "zh": "……不是该拜托\n再可爱一点的女孩子去干吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "47/TALK",
            "narrator": "雛",
            "text": "失礼な！！\nあたしのどこが\n可愛くないっていうの！？",
            "zh": "没礼貌！！\n我哪里\n不可爱了！？",
            "narrator_zh": "雏"
        },
        {
            "location": "50/TALK",
            "narrator": "ヒカル",
            "text": "大丈夫だよ、ひなこさん。\nひなこさんだったら、\n絶対上手くいくよ。",
            "zh": "没问题的，小雏。\n要是小雏的话，\n绝对会顺利的。",
            "narrator_zh": "光"
        },
        {
            "location": "52/TALK",
            "narrator": "雛",
            "text": "はぁ…ヒカルくんって、\n本当いい人だねー…。",
            "zh": "哈啊……光这个人，\n真是大好人呀……。",
            "narrator_zh": "雏"
        },
        {
            "location": "53/TALK",
            "narrator": "雛",
            "text": "キリトも、ヒカルくんの\n爪垢程度でいいから\n見習った方がいいよ？",
            "zh": "圣翔也，\n哪怕只学光的一点皮毛，\n也该学学哦？",
            "narrator_zh": "雏"
        },
        {
            "location": "56/TALK",
            "narrator": "キリト",
            "text": "へいへい、そのうちな。",
            "zh": "好啦好啦，改天吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "57/TALK",
            "narrator": "ヒカル",
            "text": "…それで？\n保管庫から盗ってきた\n装備の方はどう？",
            "zh": "……然后呢？\n从保管库顺来的\n装备怎么样？",
            "narrator_zh": "光"
        },
        {
            "location": "59/TALK",
            "narrator": "キリト",
            "text": "ああ、問題なしだ。\n銃の方もすぐに使えるぜ。",
            "zh": "啊，没问题。\n枪也随时能用。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "60/TALK",
            "narrator": "雛",
            "text": "…使うの？",
            "zh": "……要用的吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "62/TALK",
            "narrator": "キリト",
            "text": "使いたくはねぇけど、\n場合によっちゃな…。",
            "zh": "是不想用，\n但看情况……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "64/TALK",
            "narrator": "繭",
            "text": "…こっちも、管理庁の\nサーバーからデータを\n抜いてきた。",
            "zh": "……我这边也，\n从管理厅的\n服务器里抽了数据。",
            "narrator_zh": "茧"
        },
        {
            "location": "65/TALK",
            "narrator": "キリト",
            "text": "おっ、なにかあったか？",
            "zh": "哦，有什么收获？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "67/TALK",
            "narrator": "繭",
            "text": "逢瀬さんの監禁場所と、\n移送計画書を見つけた。",
            "zh": "找到了逢濑的\n关押地点和移送计划书。",
            "narrator_zh": "茧"
        },
        {
            "location": "68/TALK",
            "narrator": "ヒカル",
            "text": "移送、ですか？",
            "zh": "移送，是吗？",
            "narrator_zh": "光"
        },
        {
            "location": "70/TALK",
            "narrator": "繭",
            "text": "ええ…詳しくはスマホに\n送るから、\n各自で確認して。",
            "zh": "嗯……详细内容会发到\n手机上，\n各自去确认。",
            "narrator_zh": "茧"
        },
        {
            "location": "72/TALK",
            "narrator": "雛",
            "text": "綾水様たちにも\n送るの忘れたら\nダメだよー。",
            "zh": "也别忘了发给\n绫水大人她们\n哟——。",
            "narrator_zh": "雏"
        },
        {
            "location": "74/TALK",
            "narrator": "繭",
            "text": "みやび先輩宛に、\nとっくに送ったわ。",
            "zh": "发给雅前辈的，\n早就发过了。",
            "narrator_zh": "茧"
        },
        {
            "location": "76/TALK",
            "narrator": "キリト",
            "text": "よーし、みんな\n準備万端だな？",
            "zh": "好——嘞，大家\n都准备万全了吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "77/TALK",
            "narrator": "キリト",
            "text": "あとは夜になったら、\n俺とヒカルが劇場に\n侵入して…。",
            "zh": "接下来等天一黑，\n我和光就潜入\n剧场，然后……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "78/TALK",
            "narrator": "キリト",
            "text": "床下のＰＣの電源を\n入れれば、ミッション\nコンプリートだ！",
            "zh": "只要打开地板下\nＰＣ的电源，\n任务就完成了！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "81/TALK",
            "narrator": "ヒカル",
            "text": "言うは易く行うは難し、\nだけどね。",
            "zh": "说起来容易，\n做起来难就是了。",
            "narrator_zh": "光"
        },
        {
            "location": "83/TALK",
            "narrator": "雛",
            "text": "だいじょーぶ！！\nだってあたし達は、\nトライナリー応援団だよ？",
            "zh": "没问题的！！\n因为我们可是，\n三重奏应援团呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "84/TALK",
            "narrator": "雛",
            "text": "この程度のことは\n簡単にやってのけないと、\nかっこ悪いよー。",
            "zh": "这种程度的事，\n不漂亮地办到的话，\n多丢人呀——。",
            "narrator_zh": "雏"
        },
        {
            "location": "86/TALK",
            "narrator": "キリト",
            "text": "そういうことだ。\nほら、ヒカルも\n気合入れて――",
            "zh": "就是这么回事。\n来，光也\n提起干劲——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "87/TALK",
            "narrator": "キリト",
            "text": "…いや、待てよ？\nもう一つやらなきゃ\nいけないことあったな。",
            "zh": "……不对，等等？\n还有一件\n非做不可的事来着。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "89/TALK",
            "narrator": "繭",
            "text": "…なにか、やり忘れ？",
            "zh": "……有什么，忘了做？",
            "narrator_zh": "茧"
        },
        {
            "location": "90/TALK",
            "narrator": "キリト",
            "text": "まあな。",
            "zh": "算是吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "93/TALK",
            "narrator": "キリト",
            "text": "あの人がいなきゃ、\n俺は今、この場所に\nいなかったと思うし…。",
            "zh": "要不是有那个人，\n我现在，恐怕不会\n待在这个地方……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "112/TALK",
            "narrator": "キリト",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "113/TALK",
            "narrator": "キリト",
            "text": "名前知らないけど",
            "zh": "名字还不知道",
            "narrator_zh": "圣翔"
        },
        {
            "location": "114/TALK",
            "narrator": "キリト",
            "text": "逢瀬と話してる人",
            "zh": "跟逢濑聊着的那位",
            "narrator_zh": "圣翔"
        },
        {
            "location": "115/TALK",
            "narrator": "キリト",
            "text": "いるか？",
            "zh": "在吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "116/SEL",
            "narrator": "（選択肢）",
            "text": "いますよ",
            "zh": "在哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "117/SEL",
            "narrator": "（選択肢）",
            "text": "いませんよ",
            "zh": "不在哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "118/ACT",
            "narrator": "",
            "text": "いますよ",
            "zh": "在哦",
            "narrator_zh": ""
        },
        {
            "location": "119/TALK",
            "narrator": "キリト",
            "text": "よかった！",
            "zh": "太好了！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "120/TALK",
            "narrator": "ヒカル",
            "text": "こんにちは",
            "zh": "你好",
            "narrator_zh": "光"
        },
        {
            "location": "121/TALK",
            "narrator": "雛",
            "text": "どもー",
            "zh": "你好呀——",
            "narrator_zh": "雏"
        },
        {
            "location": "122/TALK",
            "narrator": "繭",
            "text": "おつ",
            "zh": "辛苦。",
            "narrator_zh": "茧"
        },
        {
            "location": "123/ACT",
            "narrator": "",
            "text": "いませんよ",
            "zh": "不在哦",
            "narrator_zh": ""
        },
        {
            "location": "124/TALK",
            "narrator": "キリト",
            "text": "そうか",
            "zh": "这样啊",
            "narrator_zh": "圣翔"
        },
        {
            "location": "125/TALK",
            "narrator": "キリト",
            "text": "っているだろ！？",
            "zh": "——才怪，肯定在吧！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "126/TALK",
            "narrator": "雛",
            "text": "面白い人だねー",
            "zh": "真是个有趣的人呀——",
            "narrator_zh": "雏"
        },
        {
            "location": "127/TALK",
            "narrator": "ヒカル",
            "text": "こんにちは",
            "zh": "你好",
            "narrator_zh": "光"
        },
        {
            "location": "128/TALK",
            "narrator": "繭",
            "text": "おつ",
            "zh": "辛苦。",
            "narrator_zh": "茧"
        },
        {
            "location": "130/SEL",
            "narrator": "（選択肢）",
            "text": "皆さんお揃いで",
            "zh": "各位都到齐了啊",
            "narrator_zh": "（选项）"
        },
        {
            "location": "131/ACT",
            "narrator": "",
            "text": "皆さんお揃いで",
            "zh": "各位都到齐了啊",
            "narrator_zh": ""
        },
        {
            "location": "133/TALK",
            "narrator": "ヒカル",
            "text": "突然すみません",
            "zh": "突然打扰，非常抱歉",
            "narrator_zh": "光"
        },
        {
            "location": "134/TALK",
            "narrator": "キリト",
            "text": "悪いな、大勢で押しかけて",
            "zh": "不好意思，一群人压上门来",
            "narrator_zh": "圣翔"
        },
        {
            "location": "135/TALK",
            "narrator": "キリト",
            "text": "俺があんたにお礼を言いたくてさ",
            "zh": "我想当面跟你说声谢谢",
            "narrator_zh": "圣翔"
        },
        {
            "location": "136/TALK",
            "narrator": "キリト",
            "text": "それ言ったらこうなったわけだ",
            "zh": "结果话一说出口就变成这样了",
            "narrator_zh": "圣翔"
        },
        {
            "location": "137/SEL",
            "narrator": "（選択肢）",
            "text": "お礼って？",
            "zh": "道谢，谢什么？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "138/ACT",
            "narrator": "",
            "text": "お礼って？",
            "zh": "道谢，谢什么？",
            "narrator_zh": ""
        },
        {
            "location": "140/TALK",
            "narrator": "キリト",
            "text": "あんたがあのこと教えてくれなかったら",
            "zh": "要不是你把那件事告诉我",
            "narrator_zh": "圣翔"
        },
        {
            "location": "141/TALK",
            "narrator": "キリト",
            "text": "俺は今も",
            "zh": "我到现在",
            "narrator_zh": "圣翔"
        },
        {
            "location": "142/TALK",
            "narrator": "キリト",
            "text": "ひなこ達に協力しなかったはずだからな",
            "zh": "应该都还不会跟小雏她们合作",
            "narrator_zh": "圣翔"
        },
        {
            "location": "143/TALK",
            "narrator": "繭",
            "text": "キリトにバラした犯人はおまえか",
            "zh": "把事情捅给圣翔的家伙，是你啊",
            "narrator_zh": "茧"
        },
        {
            "location": "144/TALK",
            "narrator": "キリト",
            "text": "仲間外れはよくないぞ",
            "zh": "把同伴晾在一边可不好哦。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "145/TALK",
            "narrator": "繭",
            "text": "協力しないと言ったキリトの意志を尊重しただけ",
            "zh": "我只是尊重了圣翔说不合作的意愿而已",
            "narrator_zh": "茧"
        },
        {
            "location": "146/TALK",
            "narrator": "雛",
            "text": "はいはいそこまで",
            "zh": "好啦好啦，到此为止",
            "narrator_zh": "雏"
        },
        {
            "location": "147/TALK",
            "narrator": "雛",
            "text": "目的忘れてない？",
            "zh": "没忘了此行的目的吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "148/TALK",
            "narrator": "キリト",
            "text": "そうだった",
            "zh": "对了",
            "narrator_zh": "圣翔"
        },
        {
            "location": "149/TALK",
            "narrator": "キリト",
            "text": "とにかくさ",
            "zh": "总之啊",
            "narrator_zh": "圣翔"
        },
        {
            "location": "150/TALK",
            "narrator": "キリト",
            "text": "俺はあんたのおかげで、自分の気持ちに正直になれたし",
            "zh": "托你的福，我才能诚实面对自己的心意",
            "narrator_zh": "圣翔"
        },
        {
            "location": "151/TALK",
            "narrator": "キリト",
            "text": "みんなと行動できることになった",
            "zh": "也才能跟大家并肩行动",
            "narrator_zh": "圣翔"
        },
        {
            "location": "152/TALK",
            "narrator": "キリト",
            "text": "そのこと、本当感謝してるよ",
            "zh": "这份情，我是真心感谢的",
            "narrator_zh": "圣翔"
        },
        {
            "location": "153/TALK",
            "narrator": "キリト",
            "text": "ありがとな",
            "zh": "谢了啊",
            "narrator_zh": "圣翔"
        },
        {
            "location": "154/TALK",
            "narrator": "雛",
            "text": "やっぱりあたし達は",
            "zh": "果然对我们来说",
            "narrator_zh": "雏"
        },
        {
            "location": "155/TALK",
            "narrator": "雛",
            "text": "四人一緒が一番だよね",
            "zh": "还是四人在一起最棒呢",
            "narrator_zh": "雏"
        },
        {
            "location": "156/TALK",
            "narrator": "ヒカル",
            "text": "そうだね",
            "zh": "是啊",
            "narrator_zh": "光"
        },
        {
            "location": "157/TALK",
            "narrator": "ヒカル",
            "text": "すごく危険なことをしようとしてるのに",
