{
    "dir": "chap05/daydra/dd_ch01_05_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "5152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "静岡から来た少女",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "从静冈来的少女"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "静岡から来た少女",
            "zh": "从静冈来的少女",
            "narrator_zh": ""
        },
        {
            "location": "18/TALK",
            "narrator": "つばめ",
            "text": "…電車が来るまで、\nまだ時間ある。\nよかったぁ…。",
            "zh": "……电车来之前，\n还有时间。\n太好啦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "19/TALK",
            "narrator": "つばめ",
            "text": "メノウちゃんに\n会うのが楽しみで――",
            "zh": "盼着见MENOW，\n所以——",
            "narrator_zh": "燕"
        },
        {
            "location": "20/TALK",
            "narrator": "つばめ",
            "text": "思ったより準備に\n時間掛かっちゃった。",
            "zh": "准备比我想的\n花了更多时间。",
            "narrator_zh": "燕"
        },
        {
            "location": "21/TALK",
            "narrator": "つばめ",
            "text": "…でも、そっかぁ。",
            "zh": "……不过，也对呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "22/TALK",
            "narrator": "つばめ",
            "text": "もうすぐ、本物の\nメノウちゃんに\n会えるんだ…。",
            "zh": "马上就能见到\n真正的MENOW\n了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "25/TALK",
            "narrator": "つばめ",
            "text": "…なんか、ドキドキ\nしてきちゃった。",
            "zh": "……心跳\n有点停不下来了。",
            "narrator_zh": "燕"
        },
        {
            "location": "26/TALK",
            "narrator": "つばめ",
            "text": "メノウちゃんに\n会えるドキドキを\n抑えるのは――",
            "zh": "要压住\n能见到MENOW的\n心跳——",
            "narrator_zh": "燕"
        },
        {
            "location": "27/TALK",
            "narrator": "つばめ",
            "text": "メノウちゃんの\n曲を聞くのが\n一番だよね。",
            "zh": "听MENOW的\n歌，\n最管用吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "えっと、どの曲に\nしようかなぁ…。",
            "zh": "那个，选\n哪一首好呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "34/TALK",
            "narrator": "つばめ",
            "text": "あ、お父さん…。\nやっと手紙に気付いて\nくれたんだ。",
            "zh": "啊，爸爸……\n终于发现\n那封信了。",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "つばめ",
            "text": "駅まで送っていくって\n言っただろ、って\n言うんだろうなぁ…。",
            "zh": "肯定要说，我说过\n送到车站的，\n吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "…あはは、やっぱり。\nわかりやす過ぎだよ。",
            "zh": "……啊哈哈，果然。\n也太好懂了。",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "啓介",
            "text": "駅まで送っていくと、昨日言っただろ？",
            "zh": "我昨天说了，送到车站的吧？",
            "narrator_zh": "启介"
        },
        {
            "location": "44/TALK",
            "narrator": "つばめ",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "46/TALK",
            "narrator": "啓介",
            "text": "なら、どうして一人で行ったんだ？",
            "zh": "那为什么一个人走了？",
            "narrator_zh": "启介"
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "ワクワクし過ぎて",
            "zh": "太兴奋了",
            "narrator_zh": "燕"
        },
        {
            "location": "49/TALK",
            "narrator": "つばめ",
            "text": "早起きしちゃったから",
            "zh": "一早就醒了",
            "narrator_zh": "燕"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "一人で落ち着きたくて",
            "zh": "想一个人静一静",
            "narrator_zh": "燕"
        },
        {
            "location": "51/TALK",
            "narrator": "つばめ",
            "text": "ごめんね",
            "zh": "对不起呀",
            "narrator_zh": "燕"
        },
        {
            "location": "53/TALK",
            "narrator": "啓介",
            "text": "何かあったらどうするつもりだ？",
            "zh": "要是出了什么事，你打算怎么办？",
            "narrator_zh": "启介"
        },
        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "駅に行くくらい",
            "zh": "不过是去车站",
            "narrator_zh": "燕"
        },
        {
            "location": "56/TALK",
            "narrator": "つばめ",
            "text": "心配ないよ",
            "zh": "不用担心哦",
            "narrator_zh": "燕"
        },
        {
            "location": "57/TALK",
            "narrator": "つばめ",
            "text": "置き手紙した通り",
            "zh": "就像留的信上写的",
            "narrator_zh": "燕"
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "わたしは大丈夫だから",
            "zh": "我没事的",
            "narrator_zh": "燕"
        },
        {
            "location": "60/TALK",
            "narrator": "啓介",
            "text": "もう駅なのか？",
            "zh": "已经到车站了吗？",
            "narrator_zh": "启介"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "62/TALK",
            "narrator": "つばめ",
            "text": "駅に入るところ",
            "zh": "正要进站",
            "narrator_zh": "燕"
        },
        {
            "location": "64/TALK",
            "narrator": "啓介",
            "text": "じゃあ、今から駅まで行くから",
            "zh": "那我现在就去车站",
            "narrator_zh": "启介"
        },
        {
            "location": "65/TALK",
            "narrator": "つばめ",
            "text": "なんで！？",
            "zh": "为什么！？",
            "narrator_zh": "燕"
        },
        {
            "location": "66/TALK",
            "narrator": "つばめ",
            "text": "来なくて大丈夫だから",
            "zh": "不用来也没关系",
            "narrator_zh": "燕"
        },
        {
            "location": "67/TALK",
            "narrator": "つばめ",
            "text": "もうすぐ電車も来るし",
            "zh": "电车也马上就到",
            "narrator_zh": "燕"
        },
        {
            "location": "68/TALK",
            "narrator": "つばめ",
            "text": "間に合わないよ？",
            "zh": "来不及的哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "70/TALK",
            "narrator": "啓介",
            "text": "万が一電車に乗れなかった時はどうするつもりだ？",
            "zh": "万一没坐上电车，你打算怎么办？",
            "narrator_zh": "启介"
        },
        {
            "location": "71/TALK",
            "narrator": "つばめ",
            "text": "ないから！",
            "zh": "不会有那种事！",
            "narrator_zh": "燕"
        },
        {
            "location": "72/TALK",
            "narrator": "つばめ",
            "text": "っていうか、どんな状況！？",
            "zh": "话说，那是什么状况！？",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "つばめ",
            "text": "お父さん、心配し過ぎ！",
            "zh": "爸爸，你担心过头了！",
            "narrator_zh": "燕"
        },
        {
            "location": "74/TALK",
            "narrator": "つばめ",
            "text": "わたしはそんな子供じゃないよ",
            "zh": "我又不是那种小孩子",
            "narrator_zh": "燕"
        },
        {
            "location": "76/TALK",
            "narrator": "啓介",
            "text": "しかし、新幹線に乗るのは初めてだろ？",
            "zh": "可是，坐新干线是第一次吧？",
            "narrator_zh": "启介"
        },
        {
            "location": "77/TALK",
            "narrator": "つばめ",
            "text": "ホームまで付いてくる気だったの！？",
            "zh": "你打算跟到站台吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "本当平気だから",
            "zh": "真的没关系",
            "narrator_zh": "燕"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "大丈夫！",
            "zh": "不要紧！",
            "narrator_zh": "燕"
        },
        {
            "location": "80/TALK",
            "narrator": "つばめ",
            "text": "来たら怒るからね？",
            "zh": "你要是来了，我会生气的哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "81/TALK",
            "narrator": "つばめ",
            "text": "いってきます",
            "zh": "我出门了",
            "narrator_zh": "燕"
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "…まったく！\nお父さんってば――",
            "zh": "……真是的！\n爸爸这个人——",
            "narrator_zh": "燕"
        },
        {
            "location": "89/TALK",
            "narrator": "つばめ",
            "text": "今時小学生だって、\n一人で遠出したり\nするのに。",
            "zh": "现在就算小学生，\n也会一个人\n出远门的。",
            "narrator_zh": "燕"
        },
        {
            "location": "90/TALK",
            "narrator": "つばめ",
            "text": "…もしかしてわたし、\n小学生よりも\n信用されてない？",
            "zh": "……难道我，\n还不如小学生\n被信任？",
            "narrator_zh": "燕"
        },
        {
            "location": "91/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "92/TALK",
            "narrator": "つばめ",
            "text": "ううん、お父さんが\n過保護なだけ。\n絶対にそう！",
            "zh": "不对，只是爸爸\n保护过头。\n绝对是这样！",
            "narrator_zh": "燕"
        },
        {
            "location": "93/TALK",
            "narrator": "つばめ",
            "text": "っていうか、\n今日はメノウちゃんの\nライブなんだから――",
            "zh": "话说，\n今天是MENOW的\n演出——",
            "narrator_zh": "燕"
        },
        {
            "location": "94/TALK",
            "narrator": "つばめ",
            "text": "もっとテンション\n上げてかないと！",
            "zh": "得把劲头\n再提上来！",
            "narrator_zh": "燕"
        },
        {
            "location": "95/TALK",
            "narrator": "つばめ",
            "text": "…メノウちゃん、\nわたしの方\n向いてくれるかな？",
            "zh": "……MENOW，\n会朝我这边\n看吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "97/TALK",
            "narrator": "つばめ",
            "text": "もしメノウちゃんと\n目が合ったら、\n感激だなぁ。",
            "zh": "要是和MENOW\n对上眼，\n那就太感动了。",
            "narrator_zh": "燕"
        },
        {
            "location": "98/TALK",
            "narrator": "つばめ",
            "text": "あ、でも大好きな\n曲の時にはちょっと\n危ないかも。",
            "zh": "啊，不过放到最喜欢的\n歌的时候，可能\n有点危险。",
            "narrator_zh": "燕"
        },
        {
            "location": "99/TALK",
            "narrator": "つばめ",
            "text": "感激し過ぎて、\n泣いちゃうかも\nしれないし…。",
            "zh": "感动过头，\n说不定会\n哭出来……。",
            "narrator_zh": "燕"
        },
        {
            "location": "100/TALK",
            "narrator": "つばめ",
            "text": "…でも、東京は\n初めてだから――",
            "zh": "……可是，东京\n是第一次——",
            "narrator_zh": "燕"
        },
        {
            "location": "101/TALK",
            "narrator": "つばめ",
            "text": "あんまり浮かれない\nように気を付け\nなくちゃ。",
            "zh": "不能太飘，\n得小心\n一点。",
            "narrator_zh": "燕"
        },
        {
            "location": "102/SEL",
            "narrator": "",
            "text": "$me$がいつでも３６５日つばめを護る！",
            "zh": "$me$随时、365天都护着燕！",
            "narrator_zh": ""
        },
        {
            "location": "103/SEL",
            "narrator": "",
            "text": "忘れ物はありませんか？",
            "zh": "有没有忘带东西？",
            "narrator_zh": ""
        },
        {
            "location": "104/ACT",
            "narrator": "",
            "text": "$me$がいつでも３６５日つばめを護る！",
            "zh": "$me$随时、365天都护着燕！",
            "narrator_zh": ""
        },
        {
            "location": "121/TALK",
            "narrator": "つばめ",
            "text": "ぁりがと",
            "zh": "谢谢",
            "narrator_zh": "燕"
        },
        {
            "location": "122/TALK",
            "narrator": "つばめ",
            "text": "ぃつも一緒だし",
            "zh": "一直都在一起",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "つばめ",
            "text": "頼りにしてます",
            "zh": "我就靠你了",
            "narrator_zh": "燕"
        },
        {
            "location": "125/TALK",
            "narrator": "つばめ",
            "text": "じゃぁ",
            "zh": "那么",
            "narrator_zh": "燕"
        },
        {
            "location": "126/TALK",
            "narrator": "つばめ",
            "text": "東京に着ぃたら",
            "zh": "到了东京的话",
            "narrator_zh": "燕"
        },
        {
            "location": "127/TALK",
            "narrator": "つばめ",
            "text": "迷子にならなぃよぅに",
            "zh": "我可不想迷路哦",
            "narrator_zh": "燕"
        },
        {
            "location": "128/TALK",
            "narrator": "つばめ",
            "text": "ナビとか",
            "zh": "导航之类的",
            "narrator_zh": "燕"
        },
        {
            "location": "129/TALK",
            "narrator": "つばめ",
            "text": "置き忘れの監視とか",
            "zh": "还有忘拿东西，帮我盯着",
            "narrator_zh": "燕"
        },
        {
            "location": "130/TALK",
            "narrator": "つばめ",
            "text": "お願いね",
            "zh": "拜托啦",
            "narrator_zh": "燕"
        },
        {
            "location": "141/ACT",
            "narrator": "",
            "text": "忘れ物はありませんか？",
            "zh": "有没有忘带东西？",
            "narrator_zh": ""
        },
        {
            "location": "158/TALK",
            "narrator": "つばめ",
            "text": "忘れ物はなぃよ",
            "zh": "没忘东西哦",
            "narrator_zh": "燕"
        },
        {
            "location": "159/TALK",
            "narrator": "つばめ",
            "text": "家を出る前に",
            "zh": "出门之前",
            "narrator_zh": "燕"
        },
        {
            "location": "160/TALK",
            "narrator": "つばめ",
            "text": "全部確認したし",
            "zh": "全都确认过了",
            "narrator_zh": "燕"
        },
        {
            "location": "161/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "燕"
        },
        {
            "location": "162/TALK",
            "narrator": "つばめ",
            "text": "置き忘れは怖ぃから",
            "zh": "半路忘拿很可怕",
            "narrator_zh": "燕"
        },
        {
            "location": "163/TALK",
            "narrator": "つばめ",
            "text": "監視よろしくお願ぃします",
            "zh": "盯着就拜托你了",
            "narrator_zh": "燕"
        },
        {
            "location": "175/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "176/TALK",
            "narrator": "つばめ",
            "text": "…財布、お金、\nスマホ、チケット、\n音楽プレイヤー。",
            "zh": "……钱包、钱、\n手机、票、\n音乐播放器。",
            "narrator_zh": "燕"
        },
        {
            "location": "177/TALK",
            "narrator": "つばめ",
            "text": "うん、全部ある！",
            "zh": "嗯，全都在！",
            "narrator_zh": "燕"
        },
        {
            "location": "178/TALK",
            "narrator": "つばめ",
            "text": "前もって忘れ物しない\nように、リストを\n作っといてよかった。",
            "zh": "事先为了不忘带，\n列了清单，\n太好了。",
            "narrator_zh": "燕"
        },
        {
            "location": "179/TALK",
            "narrator": "つばめ",
            "text": "これで安心して\nライブに行けるし――",
            "zh": "这样就能安心\n去看演出了——",
            "narrator_zh": "燕"
        },
        {
            "location": "180/TALK",
            "narrator": "つばめ",
            "text": "メノウちゃんに\nお土産も…。",
            "zh": "给MENOW的\n伴手礼也……。",
            "narrator_zh": "燕"
        },
        {
            "location": "181/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "182/TALK",
            "narrator": "つばめ",
            "text": "あーーーーーーっ！！",
            "zh": "啊——————！！",
            "narrator_zh": "燕"
        },
        {
            "location": "195/TALK",
            "narrator": "つばめ",
            "text": "どうしよう",
            "zh": "怎么办",
            "narrator_zh": "燕"
        },
        {
            "location": "196/TALK",
            "narrator": "つばめ",
            "text": "大切な物忘れちゃった！",
            "zh": "重要的东西忘了！",
            "narrator_zh": "燕"
        },
        {
            "location": "197/TALK",
            "narrator": "つばめ",
            "text": "せっかく準備したのに！",
            "zh": "明明好不容易准备好了！",
            "narrator_zh": "燕"
        },
        {
            "location": "199/SEL",
            "narrator": "",
            "text": "何を忘れたの？",
            "zh": "忘了什么？",
            "narrator_zh": ""
        },
        {
            "location": "200/ACT",
            "narrator": "",
            "text": "何を忘れたの？",
            "zh": "忘了什么？",
            "narrator_zh": ""
        },
        {
            "location": "203/TALK",
            "narrator": "つばめ",
            "text": "大切な物！",
            "zh": "重要的东西！",
            "narrator_zh": "燕"
        },
        {
            "location": "204/TALK",
            "narrator": "つばめ",
            "text": "メノウちゃんに渡そうと思った",
            "zh": "本来想交给MENOW的",
            "narrator_zh": "燕"
        },
        {
            "location": "205/TALK",
            "narrator": "つばめ",
            "text": "大切なお土産",
            "zh": "重要的伴手礼",
            "narrator_zh": "燕"
        },
        {
            "location": "206/TALK",
            "narrator": "つばめ",
            "text": "忘れないように",
            "zh": "为了不忘",
            "narrator_zh": "燕"
        },
        {
            "location": "207/TALK",
            "narrator": "つばめ",
            "text": "ベッドの上に置いたのに",
            "zh": "明明放在床上了",
            "narrator_zh": "燕"
        },
        {
            "location": "208/TALK",
            "narrator": "つばめ",
            "text": "忘れてきちゃった",
            "zh": "还是忘了带来",
            "narrator_zh": "燕"
        },
        {
            "location": "209/TALK",
            "narrator": "つばめ",
            "text": "どうしよう",
            "zh": "怎么办",
            "narrator_zh": "燕"
        },
        {
            "location": "211/SEL",
            "narrator": "",
            "text": "父に頼もう",
            "zh": "拜托爸爸吧",
            "narrator_zh": ""
        },
        {
            "location": "212/SEL",
            "narrator": "",
            "text": "また買えば？",
            "zh": "再买一份？",
            "narrator_zh": ""
        },
        {
            "location": "213/ACT",
            "narrator": "",
            "text": "父に頼もう",
            "zh": "拜托爸爸吧",
            "narrator_zh": ""
        },
        {
            "location": "214/TALK",
            "narrator": "つばめ",
            "text": "ダメ！",
            "zh": "不行！",
            "narrator_zh": "燕"
        },
        {
            "location": "215/TALK",
            "narrator": "つばめ",
            "text": "そんなことしたら",
            "zh": "要是那么做",
            "narrator_zh": "燕"
        },
        {
            "location": "216/TALK",
            "narrator": "つばめ",
            "text": "ほれ見たことかって",
            "zh": "他肯定说看吧被我说中了",
            "narrator_zh": "燕"
        },
        {
            "location": "217/TALK",
            "narrator": "つばめ",
            "text": "絶対調子に乗って勝ち誇るもん",
            "zh": "绝对会得意忘形",
            "narrator_zh": "燕"
        },
        {
            "location": "219/TALK",
            "narrator": "つばめ",
            "text": "ああ見えてお父さん",
            "zh": "别看爸爸那样",
            "narrator_zh": "燕"
        },
        {
            "location": "220/TALK",
            "narrator": "つばめ",
            "text": "凄く子供っぽいから",
            "zh": "其实特别孩子气",
            "narrator_zh": "燕"
        },
        {
            "location": "221/TALK",
            "narrator": "つばめ",
            "text": "調子に乗ってる時のお父さん",
            "zh": "得意起来的爸爸",
            "narrator_zh": "燕"
        },
        {
            "location": "222/TALK",
            "narrator": "つばめ",
            "text": "なんかムカつくんだ",
            "zh": "莫名就来气",
            "narrator_zh": "燕"
        },
        {
            "location": "224/SEL",
            "narrator": "",
            "text": "じゃあ、また買うしかないね",
            "zh": "那，就只能再买了",
            "narrator_zh": ""
        },
        {
            "location": "225/ACT",
            "narrator": "",
            "text": "じゃあ、また買うしかないね",
            "zh": "那，就只能再买了",
            "narrator_zh": ""
        },
        {
            "location": "229/TALK",
            "narrator": "つばめ",
            "text": "違うの",
            "zh": "不是的",
            "narrator_zh": "燕"
        },
        {
            "location": "230/TALK",
            "narrator": "つばめ",
            "text": "一番大切なのは",
            "zh": "最要紧的是",
            "narrator_zh": "燕"
        },
        {
            "location": "231/TALK",
            "narrator": "つばめ",
            "text": "一緒に入れた手紙なの",
            "zh": "一起放进去的那封信",
            "narrator_zh": "燕"
        },
        {
            "location": "232/TALK",
            "narrator": "つばめ",
            "text": "手紙は買えないよ",
            "zh": "信是买不到的",
            "narrator_zh": "燕"
        },
        {
            "location": "233/ACT",
            "narrator": "",
            "text": "また買えば？",
            "zh": "再买一份？",
            "narrator_zh": ""
        },
        {
            "location": "236/TALK",
            "narrator": "つばめ",
            "text": "一生懸命考えて書いたのに",
            "zh": "我拼命想了才写下来的",
            "narrator_zh": "燕"
        },
        {
            "location": "238/TALK",
            "narrator": "つばめ",
            "text": "もう",
            "zh": "真是的",
            "narrator_zh": "燕"
        },
        {
            "location": "240/TALK",
            "narrator": "つばめ",
            "text": "帰ろうかな",
            "zh": "要不回去吧",
            "narrator_zh": "燕"
        },
        {
            "location": "242/SEL",
            "narrator": "",
            "text": "便箋と封筒とペン買えば電車の中で書ける",
            "zh": "买了信纸、信封和笔，在电车上就能写",
            "narrator_zh": ""
        },
        {
            "location": "243/ACT",
            "narrator": "",
            "text": "便箋と封筒とペン買えば電車の中で書ける",
            "zh": "买了信纸、信封和笔，在电车上就能写",
            "narrator_zh": ""
        },
        {
            "location": "245/TALK",
            "narrator": "つばめ",
            "text": "そうだ",
            "zh": "对了",
            "narrator_zh": "燕"
        },
        {
            "location": "246/TALK",
            "narrator": "つばめ",
            "text": "それだよ！",
            "zh": "就是这个！",
            "narrator_zh": "燕"
        },
        {
            "location": "247/TALK",
            "narrator": "つばめ",
            "text": "内容は全部覚えてるから",
            "zh": "内容我全都记得",
            "narrator_zh": "燕"
        },
        {
            "location": "248/TALK",
            "narrator": "つばめ",
            "text": "東京に着くまでに書きなおせるし",
            "zh": "到东京之前能重写好",
            "narrator_zh": "燕"
        },
        {
            "location": "249/TALK",
            "narrator": "つばめ",
            "text": "ありがとう！",
            "zh": "谢谢！",
            "narrator_zh": "燕"
        },
        {
            "location": "250/TALK",
            "narrator": "つばめ",
            "text": "急いで買ってくる！",
            "zh": "我赶快去买！",
            "narrator_zh": "燕"
        },
        {
            "location": "261/TALK",
            "narrator": "つばめ",
            "text": "…よかった。\nこれでメノウちゃんに\n手紙渡せる。",
            "zh": "……太好了。\n这样就能把信\n交给MENOW了。",
            "narrator_zh": "燕"
        },
        {
            "location": "262/TALK",
            "narrator": "つばめ",
            "text": "スマホのコンピュー\nターって、頭いいん\nだなぁ。",
            "zh": "手机里的电脑，\n还真\n聪明呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "264/TALK",
            "narrator": "つばめ",
            "text": "…お土産と便箋、\n早く買わなくちゃ！",
            "zh": "……伴手礼和信纸，\n得赶快去买！",
            "narrator_zh": "燕"
        },
        {
            "location": "276/TALK",
            "narrator": "つばめ",
            "text": "――そんな感じで、\nあの日の朝はすっごく\nドタバタでした…。",
            "zh": "——就是这样，\n那天早上忙得\n乱七八糟……。",
            "narrator_zh": "燕"
        },
        {
            "location": "277/TALK",
            "narrator": "真幌",
            "text": "モグモグ…ふむ、\nなるほどな…。",
            "zh": "嚼嚼……嗯，\n原来如此……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "279/TALK",
            "narrator": "真幌",
            "text": "で？　これがメノウに\n渡そうと思っていた\nお土産のお菓子か。",
            "zh": "然后？　这就是打算\n交给MENOW的\n伴手礼点心吗。",
            "narrator_zh": "真幌"
        },
        {
            "location": "281/TALK",
            "narrator": "つばめ",
            "text": "はい！",
            "zh": "是的！",
            "narrator_zh": "燕"
        },
        {
            "location": "282/TALK",
            "narrator": "つばめ",
            "text": "凄く美味しい\nお菓子なんで――",
            "zh": "非常好吃的\n点心——",
            "narrator_zh": "燕"
        },
        {
            "location": "283/TALK",
            "narrator": "つばめ",
            "text": "メノウちゃんも\n喜んでくれるかな、\nって思ったんです。",
            "zh": "MENOW也会\n高兴吧，\n我是这么想的。",
            "narrator_zh": "燕"
        },
        {
            "location": "284/TALK",
            "narrator": "つばめ",
            "text": "まあ、結局渡す\n暇ありませんでした\nけど…。",
            "zh": "不过，最后\n没找到机会给，\n就是了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "285/TALK",
            "narrator": "真幌",
            "text": "あの状況だったから、\nまあ、当然だな。",
            "zh": "那种情况，\n也是，当然了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "288/TALK",
            "narrator": "真幌",
            "text": "…それにしても、\nこれ美味いな。",
            "zh": "……不过，\n这个真好吃。",
            "narrator_zh": "真幌"
        },
        {
            "location": "290/TALK",
            "narrator": "つばめ",
            "text": "どんどん食べて\nください。",
            "zh": "请尽管\n吃。",
            "narrator_zh": "燕"
        },
        {
            "location": "291/TALK",
            "narrator": "つばめ",
            "text": "わたし一人で食べたら\n体重がデブーン、って\nなっちゃいますし…。",
            "zh": "我一个人吃的话，\n体重就会嘭地\n胖起来……。",
            "narrator_zh": "燕"
        },
        {
            "location": "293/TALK",
            "narrator": "真幌",
            "text": "大袈裟な奴だ。\nまったく太っていない\nというのに…。",
            "zh": "夸张的家伙。\n明明一点\n都没胖……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "294/TALK",
            "narrator": "真幌",
            "text": "しかし…もしこれを\nメノウに渡していたと\nしたら――",
            "zh": "不过……要是这个\n真交给了MENOW\n的话——",
            "narrator_zh": "真幌"
        },
        {
            "location": "295/TALK",
            "narrator": "真幌",
            "text": "かなり驚かれていた\nだろうな。",
            "zh": "大概会被\n吓一跳吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "297/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "299/TALK",
            "narrator": "真幌",
            "text": "いや、アーティスト\nへの土産に――",
            "zh": "不，作为给艺人\n的伴手礼——",
            "narrator_zh": "真幌"
        },
        {
            "location": "300/TALK",
            "narrator": "真幌",
            "text": "菓子２０個入りの\n大箱持ってくる奴は\n珍しいだろうからな。",
            "zh": "拎着二十块装\n大盒点心来的人，\n应该很少见。",
            "narrator_zh": "真幌"
        },
        {
            "location": "302/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！！\nそうなんですか！？",
            "zh": "诶诶！！\n是这样吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "303/TALK",
            "narrator": "真幌",
            "text": "…いや、正確に\n言うなら、いない、\nだろうな。",
            "zh": "……不，准确\n说来，没有，\n吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "304/TALK",
            "narrator": "つばめ",
            "text": "えぇーっ！？",
            "zh": "诶——！？",
            "narrator_zh": "燕"
        },
        {
            "location": "305/TALK",
            "narrator": "真幌",
            "text": "本気だったのか！？",
            "zh": "是认真的吗！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "307/TALK",
            "narrator": "つばめ",
            "text": "は、はい…。\nこういうことするの\n初めてだから――",
            "zh": "是、是的……\n做这种事\n是第一次——",
            "narrator_zh": "燕"
        },
        {
            "location": "308/TALK",
            "narrator": "つばめ",
            "text": "勝手が\nわからなくて…。",
            "zh": "门道\n还不懂……。",
            "narrator_zh": "燕"
        },
        {
            "location": "311/TALK",
            "narrator": "真幌",
            "text": "ふむ…。",
            "zh": "嗯……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "312/TALK",
            "narrator": "真幌",
            "text": "…逢瀬つばめ、か。",
            "zh": "……逢濑燕，是吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "313/TALK",
            "narrator": "真幌",
            "text": "ドームであったことも\n考えて、正直警戒して\nいたんだが――",
            "zh": "把在穹顶见过的事\n也算上，老实说我\n一直有所戒备——",
            "narrator_zh": "真幌"
        },
        {
            "location": "316/TALK",
            "narrator": "真幌",
            "text": "…ふふっ、\nおまえと話してると\n調子が狂う。",
            "zh": "……呵呵，\n跟你说话的时候，\n节奏都乱了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "318/TALK",
            "narrator": "つばめ",
            "text": "はい？",
            "zh": "是？",
            "narrator_zh": "燕"
        },
        {
            "location": "320/TALK",
            "narrator": "真幌",
            "text": "逢瀬は面白い奴だ、\nということだ。",
            "zh": "逢濑是个有意思的家伙，\n就是这个意思。",
            "narrator_zh": "真幌"
        },
        {
            "location": "322/TALK",
            "narrator": "つばめ",
            "text": "…褒められてる、\nのかなぁ？",
            "zh": "……这是在夸我，\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "17/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月3日　10:22 AM</color>\nフレイメノウライブ当日、つばめの地元静岡県の某駅にて。",
            "zh": "<color=green>5月3日　10:22 AM</color>\nFreyMENOW演出当天，在燕的家乡静冈县某车站。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
