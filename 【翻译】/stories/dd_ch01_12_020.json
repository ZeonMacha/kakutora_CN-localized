{
    "dir": "chap12/daydra/dd_ch01_12_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "12156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "一人の放課後",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "一个人的放学后"
    },
    "entry": [
        {
            "location": "259/SCENARIO",
            "narrator": "",
            "text": "一人の放課後",
            "zh": "一个人的放学后",
            "narrator_zh": ""
        },
        {
            "location": "275/TALK",
            "narrator": "つばめ",
            "text": "みんな、今日の放課後は\nどうするの？",
            "zh": "大家，今天放学后\n做什么？",
            "narrator_zh": "燕"
        },
        {
            "location": "276/TALK",
            "narrator": "キリト",
            "text": "悪ぃ、今日は友達に\n頼まれててさ――",
            "zh": "抱歉，今天朋友\n托了我——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "277/TALK",
            "narrator": "キリト",
            "text": "部活の手伝いしに\n行かなきゃなんねぇん\nだよ。",
            "zh": "得去帮社团\n干活，\n没办法。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "278/TALK",
            "narrator": "繭",
            "text": "バイトだから。",
            "zh": "因为打工。",
            "narrator_zh": "茧"
        },
        {
            "location": "279/TALK",
            "narrator": "つばめ",
            "text": "そっか…ひなこちゃんは？",
            "zh": "这样啊……小雏呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "281/TALK",
            "narrator": "雛",
            "text": "ごめん！\n実はあたしも、やらなきゃ\nいけない課題が出てるの！",
            "zh": "对不起！\n其实我也有\n必须做的作业！",
            "narrator_zh": "雏"
        },
        {
            "location": "282/TALK",
            "narrator": "つばめ",
            "text": "そんなのあったっけ？",
            "zh": "有这种东西吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "283/TALK",
            "narrator": "雛",
            "text": "あたしの科だけね…。\n放課後くらい、勉強から\n解放してほしいよ…。",
            "zh": "只有我这个科……\n好歹放学了，\n让我从学习里解放一下吧……",
            "narrator_zh": "雏"
        },
        {
            "location": "285/TALK",
            "narrator": "つばめ",
            "text": "ふふっ、大変だね。",
            "zh": "呵呵，真辛苦呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "286/TALK",
            "narrator": "キリト",
            "text": "っつーわけだから、\nまた今度な。",
            "zh": "所以啊，\n下次吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "288/TALK",
            "narrator": "繭",
            "text": "また明日。",
            "zh": "明天见。",
            "narrator_zh": "茧"
        },
        {
            "location": "290/TALK",
            "narrator": "雛",
            "text": "課題やりたくないー！",
            "zh": "不想写作业——！",
            "narrator_zh": "雏"
        },
        {
            "location": "291/TALK",
            "narrator": "つばめ",
            "text": "でも、やらなかったら\n怒られちゃうよ？",
            "zh": "可是，不做的话\n会被骂的哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "293/TALK",
            "narrator": "雛",
            "text": "うう…日向雛、課題をする\nために直帰します…。",
            "zh": "呜呜……日向雏要为了写作业\n直接回家……",
            "narrator_zh": "雏"
        },
        {
            "location": "295/TALK",
            "narrator": "雛",
            "text": "というわけだから、\nまた明日ね！",
            "zh": "所以呢，\n明天见！",
            "narrator_zh": "雏"
        },
        {
            "location": "296/TALK",
            "narrator": "つばめ",
            "text": "うん、また明日ー。",
            "zh": "嗯，明天见——。",
            "narrator_zh": "燕"
        },
        {
            "location": "299/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "302/TALK",
            "narrator": "つばめ",
            "text": "はぁ…どうしよう？\n放課後暇になっちゃった。",
            "zh": "唉……怎么办？\n放学后空出来了。",
            "narrator_zh": "燕"
        },
        {
            "location": "303/TALK",
            "narrator": "つばめ",
            "text": "バイトもお休みだから、\nみんなとカフェに行こうと\n思ったのに…。",
            "zh": "打工也休息，\n本来想和大家去咖啡馆\n的……",
            "narrator_zh": "燕"
        },
        {
            "location": "304/SEL",
            "narrator": "",
            "text": "一人で行くのもいいと思う",
            "zh": "一个人去也挺好",
            "narrator_zh": ""
        },
        {
            "location": "305/SEL",
            "narrator": "",
            "text": "寮でのんびりしよう",
            "zh": "回宿舍悠闲一下吧",
            "narrator_zh": ""
        },
        {
            "location": "308/TALK",
            "narrator": "つばめ",
            "text": "う～ん…。",
            "zh": "嗯……",
            "narrator_zh": "燕"
        },
        {
            "location": "309/TALK",
            "narrator": "つばめ",
            "text": "部屋に帰ってお掃除でも\nしようかな？",
            "zh": "回房间打扫一下\n好了？",
            "narrator_zh": "燕"
        },
        {
            "location": "312/TALK",
            "narrator": "つばめ",
            "text": "…暇だし、ちょっとだけ\n劇場に顔出そうかな。",
            "zh": "……反正闲着，要不要\n去剧场露个脸。",
            "narrator_zh": "燕"
        },
        {
            "location": "325/TALK",
            "narrator": "ガブリエラ",
            "text": "はい、三名様ですね。\n合計で３０００円に\nなります。",
            "zh": "好的，三位。\n一共\n3000日元。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "327/TALK",
            "narrator": "ガブリエラ",
            "text": "ごゆっくりどうぞ…。\n次のお客様ー。",
            "zh": "请慢慢享用……\n下一位——。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "330/TALK",
            "narrator": "アーヤ",
            "text": "はい、ぼた餅ですね。\n５００円になります。",
            "zh": "好的，牡丹饼。\n500日元。",
            "narrator_zh": "绫水"
        },
        {
            "location": "331/TALK",
            "narrator": "アーヤ",
            "text": "ありがとうございました。\nお次のお客様――",
            "zh": "谢谢惠顾。\n下一位——",
            "narrator_zh": "绫水"
        },
        {
            "location": "341/TALK",
            "narrator": "つばめ",
            "text": "えぇーっ！？\nな、なんでこんなに\n混んでるんですか！？",
            "zh": "诶诶诶！？\n为、为什么这么\n挤！？",
            "narrator_zh": "燕"
        },
        {
            "location": "344/TALK",
            "narrator": "真幌",
            "text": "すまん、私のミスだ！！",
            "zh": "抱歉，是我的错！！",
            "narrator_zh": "真幌"
        },
        {
            "location": "348/TALK",
            "narrator": "つばめ",
            "text": "真幌さん！？",
            "zh": "真幌！？",
            "narrator_zh": "燕"
        },
        {
            "location": "350/TALK",
            "narrator": "真幌",
            "text": "今日放映する映画が、\n一部でカルト的人気の\nある映画だったらしく――",
            "zh": "今天放的电影，\n好像在一部分人里\n有邪典人气——",
            "narrator_zh": "真幌"
        },
        {
            "location": "351/TALK",
            "narrator": "真幌",
            "text": "全国からその映画の\nファン達が集まって\n来てしまったんだ。",
            "zh": "那部电影的粉丝\n从全国\n聚过来了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "352/TALK",
            "narrator": "つばめ",
            "text": "全国！？",
            "zh": "全国！？",
            "narrator_zh": "燕"
        },
        {
            "location": "353/TALK",
            "narrator": "つばめ",
            "text": "ど、どうするんですか？\nもし今出動掛かったら…。",
            "zh": "怎、怎么办？\n要是现在接到出动……",
            "narrator_zh": "燕"
        },
        {
            "location": "355/TALK",
            "narrator": "真幌",
            "text": "上映中止などしようもの\nなら、大暴動は免れん…。",
            "zh": "要是停映，\n大暴动就免不了……",
            "narrator_zh": "真幌"
        },
        {
            "location": "366/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ、つばめ！",
            "zh": "啊，燕！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "368/TALK",
            "narrator": "ガブリエラ",
            "text": "あんた、暇ならちょっと\n手伝ってよ！",
            "zh": "你要是闲着，就来\n帮一下！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "370/TALK",
            "narrator": "アーヤ",
            "text": "手が足りないのよ。\nお願い！",
            "zh": "人手不够。\n拜托了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "380/TALK",
            "narrator": "つばめ",
            "text": "わ、わかりました！\nとにかく、今はお客さんの\n対応をしなくちゃ！",
            "zh": "知、知道了！\n总之，现在得先\n应付客人！",
            "narrator_zh": "燕"
        },
        {
            "location": "382/TALK",
            "narrator": "真幌",
            "text": "すまない。\n休みだというのに\n手伝わせてしまって…。",
            "zh": "抱歉。\n明明是你休息，\n还让你来帮忙……",
            "narrator_zh": "真幌"
        },
        {
            "location": "383/TALK",
            "narrator": "つばめ",
            "text": "いえ、いいんです。\n丁度やることなくて\n暇でしたし。",
            "zh": "没关系。\n正好没事做，\n闲着。",
            "narrator_zh": "燕"
        },
        {
            "location": "384/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめー！",
            "zh": "燕——！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "385/TALK",
            "narrator": "つばめ",
            "text": "い、今行くよー！",
            "zh": "我、我现在就去——！",
            "narrator_zh": "燕"
        },
        {
            "location": "388/TALK",
            "narrator": "つばめ",
            "text": "…やっぱり、一人より\nこっちの方が楽しいな。",
            "zh": "……果然，比起一个人，\n这样更开心。",
            "narrator_zh": "燕"
        },
        {
            "location": "390/ACT",
            "narrator": "",
            "text": "一人で行くのもいいと思う",
            "zh": "一个人去也挺好",
            "narrator_zh": ""
        },
        {
            "location": "408/TALK",
            "narrator": "つばめ",
            "text": "そうかな？",
            "zh": "是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "409/TALK",
            "narrator": "つばめ",
            "text": "あ、でもアーヤさんは行きつけのカフェに、よく一人で行くらしいの",
            "zh": "啊，不过绫水好像经常一个人去常去的咖啡馆",
            "narrator_zh": "燕"
        },
        {
            "location": "410/TALK",
            "narrator": "つばめ",
            "text": "わたしも、ちょっと真似してみようかな？",
            "zh": "我也稍微学一下？",
            "narrator_zh": "燕"
        },
        {
            "location": "422/TALK",
            "narrator": "つばめ",
            "text": "えへへ、ちょっと楽しく\nなってきたかも。",
            "zh": "诶嘿嘿，好像有点\n开心起来了。",
            "narrator_zh": "燕"
        },
        {
            "location": "423/TALK",
            "narrator": "つばめ",
            "text": "大人っぽく、カフェで\n読書してみよっと。",
            "zh": "成熟一点，在咖啡馆\n看看书吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "439/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "440/TALK",
            "narrator": "女子高校生",
            "text": "でさー、その時弘美ったら\n私にこう言ったの。",
            "zh": "所以说，那时候弘美\n跟我这么说的。",
            "narrator_zh": "女高中生"
        },
        {
            "location": "441/TALK",
            "narrator": "女子高校生",
            "text": "チョコチップの入った\nメロンパンなんて邪道だ、\nって…。",
            "zh": "说什么加了巧克力豆的\n蜜瓜包是邪道\n……",
            "narrator_zh": "女高中生"
        },
        {
            "location": "442/TALK",
            "narrator": "男子高校生",
            "text": "んなのどうでもいいだろ？\nそう変わらねぇんだし。",
            "zh": "那种事无所谓吧？\n又没什么差别。",
            "narrator_zh": "男高中生"
        },
        {
            "location": "443/TALK",
            "narrator": "女子高校生",
            "text": "あー、聞き捨てならない！\nそれメロンパン好きの前で\n言ったら大問題だよ？",
            "zh": "啊，这话可不能当没听见！\n在喜欢蜜瓜包的人面前\n这么说可是大问题哦？",
            "narrator_zh": "女高中生"
        },
        {
            "location": "444/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "446/TALK",
            "narrator": "ウェイトレス",
            "text": "お待たせしましたー。\nシフォンケーキと紅茶の\nセットになります。",
            "zh": "让您久等了。\n这是戚风蛋糕和红茶\n的套餐。",
            "narrator_zh": "服务员"
        },
        {
            "location": "449/TALK",
            "narrator": "つばめ",
            "text": "あ、どうも。",
            "zh": "啊，谢谢。",
            "narrator_zh": "燕"
        },
        {
            "location": "450/TALK",
            "narrator": "ウェイトレス",
            "text": "ごゆっくりどうぞー。",
            "zh": "请慢慢享用——。",
            "narrator_zh": "服务员"
        },
        {
            "location": "457/TALK",
            "narrator": "つばめ",
            "text": "…あむっ。",
            "zh": "……啊呜。",
            "narrator_zh": "燕"
        },
        {
            "location": "459/TALK",
            "narrator": "つばめ",
            "text": "…ん、美味しい。",
            "zh": "……嗯，好吃。",
            "narrator_zh": "燕"
        },
        {
            "location": "461/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "463/TALK",
            "narrator": "つばめ",
            "text": "ううっ、やっぱりなんか\n物足りないよぉ…。",
            "zh": "呜，果然还是\n缺点什么……",
            "narrator_zh": "燕"
        },
        {
            "location": "464/TALK",
            "narrator": "つばめ",
            "text": "ここ、騒がしいから\n読書には向いてないし――",
            "zh": "这里太吵了，\n不适合看书——",
            "narrator_zh": "燕"
        },
        {
            "location": "465/TALK",
            "narrator": "つばめ",
            "text": "話し相手がいないから、\n隣の人達の会話がずっと\n気になっちゃうし…。",
            "zh": "没有说话的人，\n旁边那些人的对话\n一直往耳朵里钻……",
            "narrator_zh": "燕"
        },
        {
            "location": "466/TALK",
            "narrator": "男子高校生",
            "text": "この後カラオケ行かね？\n新曲入ったみたいだし、\n俺の美声を披露するぜ。",
            "zh": "之后去不去卡拉OK？\n好像进了新歌，\n我来展示一下美声。",
            "narrator_zh": "男高中生"
        },
        {
            "location": "467/TALK",
            "narrator": "女子高校生",
            "text": "あんた音痴じゃん。\n歌えもしない洋楽歌うし。",
            "zh": "你不是五音不全吗。\n还唱根本不会的欧美歌。",
            "narrator_zh": "女高中生"
        },
        {
            "location": "468/TALK",
            "narrator": "男子高校生",
            "text": "そういうなよ。\nカラオケ代奢るからさ？",
            "zh": "别这么说嘛。\n卡拉OK的钱我请？",
            "narrator_zh": "男高中生"
        },
        {
            "location": "469/TALK",
            "narrator": "女子高校生",
            "text": "そういうことなら、\nお付き合いしてあげても\nいいかな？",
            "zh": "这样的话，\n陪你去也不是\n不行？",
            "narrator_zh": "女高中生"
        },
        {
            "location": "473/TALK",
            "narrator": "つばめ",
            "text": "…楽しそうでいいなぁ。",
            "zh": "……看起来好开心啊。",
            "narrator_zh": "燕"
        },
        {
            "location": "482/TALK",
            "narrator": "つばめ",
            "text": "なんか、一人で来たのは失敗だったみたい",
            "zh": "好像，一个人来是失败了",
            "narrator_zh": "燕"
        },
        {
            "location": "483/TALK",
            "narrator": "つばめ",
            "text": "読書にも集中できないし、寂しいからケーキも味気ないし",
            "zh": "书也看不进去，一个人冷清，蛋糕也没味道",
            "narrator_zh": "燕"
        },
        {
            "location": "484/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんとは違って、まだまだ子供なのかも",
            "zh": "和绫水不一样，也许我还是个孩子",
            "narrator_zh": "燕"
        },
        {
            "location": "486/SEL",
            "narrator": "",
            "text": "また雛達と来ようね",
            "zh": "下次再和小雏她们一起来吧",
            "narrator_zh": ""
        },
        {
            "location": "487/ACT",
            "narrator": "",
            "text": "また雛達と来ようね",
            "zh": "下次再和小雏她们一起来吧",
            "narrator_zh": ""
        },
        {
            "location": "489/TALK",
            "narrator": "つばめ",
            "text": "うん、その方が絶対楽しいもん",
            "zh": "嗯，那样绝对更开心",
            "narrator_zh": "燕"
        },
        {
            "location": "495/ACT",
            "narrator": "",
            "text": "寮でのんびりしよう",
            "zh": "回宿舍悠闲一下吧",
            "narrator_zh": ""
        },
        {
            "location": "512/TALK",
            "narrator": "つばめ",
            "text": "それもいいかも",
            "zh": "那样也好",
            "narrator_zh": "燕"
        },
        {
            "location": "513/TALK",
            "narrator": "つばめ",
            "text": "掃除とかじゃなくて、のんびりして過ごすのも悪くないよね",
            "zh": "不打扫也行，悠闲地过也不坏呀",
            "narrator_zh": "燕"
        },
        {
            "location": "514/TALK",
            "narrator": "つばめ",
            "text": "よし、決まり！",
            "zh": "好，决定了！",
            "narrator_zh": "燕"
        },
        {
            "location": "541/TALK",
            "narrator": "つばめ",
            "text": "ふぁ～…。",
            "zh": "哈啊……",
            "narrator_zh": "燕"
        },
        {
            "location": "542/TALK",
            "narrator": "つばめ",
            "text": "って、いけない！\nもうこんな時間…。",
            "zh": "不行！\n已经这个时间了……",
            "narrator_zh": "燕"
        },
        {
            "location": "543/TALK",
            "narrator": "つばめ",
            "text": "のんびりしてたら、\n結構遅くなっちゃった。",
            "zh": "悠闲着悠闲着，\n变得挺晚了。",
            "narrator_zh": "燕"
        },
        {
            "location": "544/TALK",
            "narrator": "つばめ",
            "text": "そろそろお夕飯の\n準備しないと…。",
            "zh": "差不多该准备\n晚饭了……",
            "narrator_zh": "燕"
        },
        {
            "location": "553/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめー…。",
            "zh": "燕……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "555/TALK",
            "narrator": "つばめ",
            "text": "きゃぁっ！！\nが、ガブちゃん！？",
            "zh": "呀啊！！\n加、加布！？",
            "narrator_zh": "燕"
        },
        {
            "location": "560/TALK",
            "narrator": "みやび",
            "text": "すまんな、つばめちゃん。\nこんな時間に押しかけて。",
            "zh": "对不住，燕。\n这个点闯过来。",
            "narrator_zh": "雅"
        },
        {
            "location": "563/TALK",
            "narrator": "アーヤ",
            "text": "お邪魔するわ…。",
            "zh": "打扰了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "565/TALK",
            "narrator": "つばめ",
            "text": "えっ？　えっ？\nどうしたんですか？",
            "zh": "诶？诶？\n怎么了？",
            "narrator_zh": "燕"
        },
        {
            "location": "566/TALK",
            "narrator": "つばめ",
            "text": "何だか、皆さんお疲れの\nようですけど…。",
            "zh": "总觉得，大家\n都很累的样子……",
            "narrator_zh": "燕"
        },
        {
            "location": "567/TALK",
            "narrator": "ガブリエラ",
            "text": "劇場が…。",
            "zh": "剧场……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "568/TALK",
            "narrator": "つばめ",
            "text": "劇場が？",
            "zh": "剧场？",
            "narrator_zh": "燕"
        },
        {
            "location": "571/TALK",
            "narrator": "みやび",
            "text": "劇場が、信じれないほど\n混んだんよ…。",
            "zh": "剧场里头，\n挤得简直不敢相信咯……",
            "narrator_zh": "雅"
        },
        {
            "location": "574/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "576/TALK",
            "narrator": "アーヤ",
            "text": "館長、いつもみたいに\n適当に映画を決めてた\nらしいんだけど――",
            "zh": "馆长好像还是老样子，\n随便定了部电影\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "577/TALK",
            "narrator": "アーヤ",
            "text": "その映画が、偶然にも\nカルト的人気のある\n映画だったみたいなの。",
            "zh": "那部电影碰巧\n是有邪典人气的\n片子。",
            "narrator_zh": "绫水"
        },
        {
            "location": "578/TALK",
            "narrator": "みやび",
            "text": "そんなのが劇場でやる\nいうたら――",
            "zh": "那种片子要是\n在剧场放的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "580/TALK",
            "narrator": "みやび",
            "text": "全国のファン達が\n押し寄せてくるのは\n当然ちや。",
            "zh": "全国的粉丝\n涌过来，\n那是当然的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "581/TALK",
            "narrator": "アーヤ",
            "text": "大行列に満員御礼…\n多分、もう二度と見れない\n光景ね…。",
            "zh": "大排长队，全场满座……\n大概，再也不会见到的\n光景了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "582/TALK",
            "narrator": "つばめ",
            "text": "そ、そうだったんですか。\nお疲れ様でした…。",
            "zh": "原、原来是这样。\n辛苦了……",
            "narrator_zh": "燕"
        },
        {
            "location": "584/TALK",
            "narrator": "ガブリエラ",
            "text": "だからもう疲れて何にも\nする気起きないのよ。",
            "zh": "所以已经累得\n什么都不想干了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "585/TALK",
            "narrator": "ガブリエラ",
            "text": "夕飯これからなら、\nあたし達の分も\n作ってもらえない？",
            "zh": "晚饭要是还没开始做，\n我们的份\n也能拜托你吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "588/TALK",
            "narrator": "つばめ",
            "text": "う、うん、もちろん。\n簡単な物でいいですか？",
            "zh": "嗯、嗯，当然。\n简单的就行吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "591/TALK",
            "narrator": "みやび",
            "text": "構わんよ。\nちゅうか、疲れ過ぎてて\nあんまし食べられんし…。",
            "zh": "没关系咯。\n再说，累过头了，\n也吃不下多少……",
            "narrator_zh": "雅"
        },
        {
            "location": "594/TALK",
            "narrator": "アーヤ",
            "text": "お味噌汁とかだと\n嬉しいわ。",
            "zh": "要是味噌汤之类的，\n我会很高兴。",
            "narrator_zh": "绫水"
        },
        {
            "location": "595/TALK",
            "narrator": "つばめ",
            "text": "わかりました。\nできるまで、ゆっくり\n休んでてください。",
            "zh": "知道了。\n做好之前，请慢慢\n休息。",
            "narrator_zh": "燕"
        },
        {
            "location": "597/TALK",
            "narrator": "アーヤ",
            "text": "ごめんね、つばめ。\nお休みなのに…。",
            "zh": "对不起呀，燕。\n明明是你休息……",
            "narrator_zh": "绫水"
        },
        {
            "location": "598/TALK",
            "narrator": "つばめ",
            "text": "いえ、気にしないで\nください。",
            "zh": "没关系，请别\n在意。",
            "narrator_zh": "燕"
        },
        {
            "location": "600/TALK",
            "narrator": "つばめ",
            "text": "みんなと一緒にご飯を\n食べられるの、\n凄く嬉しいですから。",
            "zh": "能和大家一起\n吃饭，\n我很高兴。",
            "narrator_zh": "燕"
        },
        {
            "location": "273/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月11日　3:16 PM</color>\nとある平日の放課後、教室にて。",
            "zh": "<color=green>7月11日　3:16 PM</color>\n某个工作日的放学后，在教室。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "611/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch01",
            "text": "【まかないちゃん】",
            "zh": "【伙食小姐】",
            "narrator_zh": "Dialog_GEThimegoto_ch01"
        }
    ]
}
