{
    "dir": "chap05/daydra/dd_ch04_05_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "5402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "女王様とウサギ＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "女王与兔子＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "女王様とウサギ",
            "zh": "女王与兔子",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "みやび",
            "text": "ふむ…思った通りや。",
            "zh": "嗯……正如我想的。",
            "narrator_zh": "雅"
        },
        {
            "location": "28/TALK",
            "narrator": "みやび",
            "text": "ここ最近で、急に世界が\n動き出しちょるようや\nねぇ…。",
            "zh": "这阵子，世界好像\n突然动起来了\n咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "…逢瀬つばめのことも\nそうやけんど――",
            "zh": "……逢濑燕的事\n也是这样，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "あのＷＡＶＥのＢＯＴの\nことも気になる。",
            "zh": "那个WAVE的Bot\n也让人在意。",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "みやび",
            "text": "…やはり、ネットには\n何の情報も無し、か。",
            "zh": "……果然，网上\n什么情报都没得，咩。",
            "narrator_zh": "雅"
        },
        {
            "location": "41/TALK",
            "narrator": "みやび",
            "text": "ＷＡＶＥが始めた\n新サービスかもと\n思うたんやが…。",
            "zh": "WAVE新开的\n服务，我还以为\n是这样……。",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "一般人のＷＡＶＥには\nない機能、ちゅうことは、\n答えは一つ。",
            "zh": "普通人的WAVE里\n没有的功能，也就是说，\n答案只有一个。",
            "narrator_zh": "雅"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "管理庁の作りだした、\nトライナリー監視用の\nソフト。",
            "zh": "管理厅做出来的，\n用来监视三重奏的\n软件。",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "そして逢瀬つばめも、\n管理庁が送り込んだ\n刺客――",
            "zh": "而且逢濑燕，\n也是管理厅派来的\n刺客——",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "いや、決めつけはいかん。\n証拠はまだないんやし…。",
            "zh": "不，不能断定。\n证据还没有……。",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "みやび",
            "text": "疑うておくくらいに\n留めておくんが、\n今のところベストか…。",
            "zh": "先留在怀疑的\n程度，\n眼下是最好的吧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "ん？　ウサギか…。",
            "zh": "嗯？　兔子咩……。",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "ああ、やっぱしそうかー。",
            "zh": "啊，果然是这样。",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "まあわかってはいた\nけんどな。",
            "zh": "嘛，我也知道，\n但是呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "しかし、ウサギの洞察力を\n持ってしても、欠片も\n情報がみつからんとは…。",
            "zh": "但是，就算有兔子的洞察力，\n也一丁点情报\n都找不到……。",
            "narrator_zh": "雅"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "さて、どうした\nものか…。",
            "zh": "那么，该\n怎么办……。",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "『RabbitAnimaの\n見解は？』…と。",
            "zh": "『RabbitAnima的\n看法是？』……这么写。",
            "narrator_zh": "雅"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "…あー、\nなるほどなぁ。",
            "zh": "……啊，\n原来如此。",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "やけんど、それやと\nリスクも大きく――",
            "zh": "但是，那样的话\n风险也大——",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "こら、いかんね。\nやはりここいらが\n潮時か……",
            "zh": "不行，这样不行。\n果然到这里\n就该收手了……",
            "narrator_zh": "雅"
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "……　…",
            "zh": "……　…",
            "narrator_zh": "雅"
        },
        {
            "location": "124/TALK",
            "narrator": "みやび",
            "text": "ふわあっ！",
            "zh": "哇啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "ひやぁぁっ！",
            "zh": "呀啊啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "ふごあぁぁっ！",
            "zh": "呜咕啊啊啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "はあああ……\nまたお前さんか。",
            "zh": "哈啊啊……\n又是你啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "140/SEL",
            "narrator": "",
            "text": "また寝てるし",
            "zh": "又在睡",
            "narrator_zh": ""
        },
        {
            "location": "141/ACT",
            "narrator": "",
            "text": "また寝てるし",
            "zh": "又在睡",
            "narrator_zh": ""
        },
        {
            "location": "145/TALK",
            "narrator": "みやび",
            "text": "他にする事ないきね。\n今日は新記録の\n８３度寝に挑戦する。",
            "zh": "没别的事可做啵。\n今天要挑战新纪录，\n第83次睡觉。",
            "narrator_zh": "雅"
        },
        {
            "location": "146/SEL",
            "narrator": "",
            "text": "あるでしょ、やること！",
            "zh": "有的吧，要做的事！",
            "narrator_zh": ""
        },
        {
            "location": "147/ACT",
            "narrator": "",
            "text": "あるでしょ、やること！",
            "zh": "有的吧，要做的事！",
            "narrator_zh": ""
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "あー…もしかしてまた、\n扉で[クラン]が\n暴れちゅうが？",
            "zh": "啊……难道又是，\n门那边[库兰]\n在闹嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "みやび",
            "text": "オープンプロセス、\n0x0022番地から\n0x963F番地へ。",
            "zh": "开放进程，\n从0x0022地址\n到0x963F地址。",
            "narrator_zh": "雅"
        },
        {
            "location": "171/TALK",
            "narrator": "みやび",
            "text": "…ふむ、完了。",
            "zh": "……嗯，完成。",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "さ、適当に入りや。",
            "zh": "来，随便进去吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "174/SEL",
            "narrator": "",
            "text": "説明して",
            "zh": "说明一下",
            "narrator_zh": ""
        },
        {
            "location": "175/ACT",
            "narrator": "",
            "text": "説明して",
            "zh": "说明一下",
            "narrator_zh": ""
        },
        {
            "location": "177/TALK",
            "narrator": "みやび",
            "text": "説明せんでも\nわかるろう？",
            "zh": "不说明\n也懂是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "178/SEL",
            "narrator": "",
            "text": "いや申し訳無いけど、今回は何でロックかかったのか１ミリもわからない",
            "zh": "不好意思，这次门锁上的原因我一毫米都不知道",
            "narrator_zh": ""
        },
        {
            "location": "179/ACT",
            "narrator": "",
            "text": "いや申し訳無いけど、今回は何でロックかかったのか１ミリもわからない",
            "zh": "不好意思，这次门锁上的原因我一毫米都不知道",
            "narrator_zh": ""
        },
        {
            "location": "181/TALK",
            "narrator": "みやび",
            "text": "マジか！",
            "zh": "不会吧！",
            "narrator_zh": "雅"
        },
        {
            "location": "183/TALK",
            "narrator": "みやび",
            "text": "仕方ないね……",
            "zh": "没办法……",
            "narrator_zh": "雅"
        },
        {
            "location": "185/TALK",
            "narrator": "みやび",
            "text": "ええと、\nココロファイルナンバー\n04-669-11によると――",
            "zh": "那个，\n按心之档案编号\n04-669-11来说——",
            "narrator_zh": "雅"
        },
        {
            "location": "186/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "雅"
        },
        {
            "location": "188/TALK",
            "narrator": "みやび",
            "text": "あー、これはいかんね。",
            "zh": "啊，这个不行。",
            "narrator_zh": "雅"
        },
        {
            "location": "189/TALK",
            "narrator": "みやび",
            "text": "$handle$が\n分からなくて当然や…。",
            "zh": "$handle$\n不明白也正常……。",
            "narrator_zh": "雅"
        },
        {
            "location": "190/SEL",
            "narrator": "",
            "text": "何がわかったの！？",
            "zh": "你看出什么了！？",
            "narrator_zh": ""
        },
        {
            "location": "191/ACT",
            "narrator": "",
            "text": "何がわかったの！？",
            "zh": "你看出什么了！？",
            "narrator_zh": ""
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "あ、うむ。",
            "zh": "啊，嗯。",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "今から晩ご飯を食べに\n行くか、このまま作業を\n続けるか悩んじょる。",
            "zh": "正在烦是现在去\n吃晚饭，还是就这样\n继续干活。",
            "narrator_zh": "雅"
        },
        {
            "location": "195/SEL",
            "narrator": "",
            "text": "そうなんだ",
            "zh": "是这样啊",
            "narrator_zh": ""
        },
        {
            "location": "196/SEL",
            "narrator": "",
            "text": "嘘ですよね",
            "zh": "是在说谎吧",
            "narrator_zh": ""
        },
        {
            "location": "197/ACT",
            "narrator": "",
            "text": "そうなんだ",
            "zh": "是这样啊",
            "narrator_zh": ""
        },
        {
            "location": "198/TALK",
            "narrator": "みやび",
            "text": "うむ、そうなんや。\nだいぶ腹が減っちゅう\nようやね。",
            "zh": "嗯，就是这样。\n肚子好像\n饿得蛮厉害咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "199/TALK",
            "narrator": "みやび",
            "text": "で、うちとしては、\n飯を喰いに行くなんて\nあり得ないと思うちょる。",
            "zh": "而我呢，\n觉得去吃饭\n根本不可能。",
            "narrator_zh": "雅"
        },
        {
            "location": "200/TALK",
            "narrator": "みやび",
            "text": "作業を続ける方向で\n協力してや。",
            "zh": "就往继续干活的方向\n帮我一把。",
            "narrator_zh": "雅"
        },
        {
            "location": "201/SEL",
            "narrator": "",
            "text": "オッケー！",
            "zh": "OK！",
            "narrator_zh": ""
        },
        {
            "location": "202/SEL",
            "narrator": "",
            "text": "嘘ですよね",
            "zh": "是在说谎吧",
            "narrator_zh": ""
        },
        {
            "location": "203/ACT",
            "narrator": "",
            "text": "オッケー！",
            "zh": "OK！",
            "narrator_zh": ""
        },
        {
            "location": "204/TALK",
            "narrator": "みやび",
            "text": "よぅし！\nオッケーゆうたね！",
            "zh": "好嘞！\n你说OK了！",
            "narrator_zh": "雅"
        },
        {
            "location": "205/TALK",
            "narrator": "みやび",
            "text": "いてら！",
            "zh": "去吧！",
            "narrator_zh": "雅"
        },
        {
            "location": "213/ACT",
            "narrator": "",
            "text": "嘘ですよね",
            "zh": "是在说谎吧",
            "narrator_zh": ""
        },
        {
            "location": "215/ACT",
            "narrator": "",
            "text": "嘘ですよね",
            "zh": "是在说谎吧",
            "narrator_zh": ""
        },
        {
            "location": "217/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "218/TALK",
            "narrator": "みやび",
            "text": "いくら司書業を営んで\nおろうとも、嘘を言わねば\nならんこともあるちや。",
            "zh": "就算是干司书这行，\n也有不得不\n说谎的时候咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "219/SEL",
            "narrator": "",
            "text": "本当の事教えて",
            "zh": "告诉我真话",
            "narrator_zh": ""
        },
        {
            "location": "220/ACT",
            "narrator": "",
            "text": "本当の事教えて",
            "zh": "告诉我真话",
            "narrator_zh": ""
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "雅"
        },
        {
            "location": "224/TALK",
            "narrator": "みやび",
            "text": "理由は$handle$、\nお前さんやき。",
            "zh": "原因是$handle$，\n是你啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "225/TALK",
            "narrator": "みやび",
            "text": "現実のうちは、お前さんに\n相当な警戒心を抱きゆう。",
            "zh": "现实里的我，对你\n抱着相当的戒心。",
            "narrator_zh": "雅"
        },
        {
            "location": "226/TALK",
            "narrator": "みやび",
            "text": "ぶっちゃけ、今も、\nもはやBotの事が\n分からなければ――",
            "zh": "说白了，就算现在，\n要是再搞不清\nBot的事——",
            "narrator_zh": "雅"
        },
        {
            "location": "227/TALK",
            "narrator": "みやび",
            "text": "強制的に関係を切断\nせざるを得ないと\n考えちょった。",
            "zh": "就在想，不得不\n强行把关系\n切断。",
            "narrator_zh": "雅"
        },
        {
            "location": "228/SEL",
            "narrator": "",
            "text": "それって、$me$とみやびがもう話せなくなるってこと？",
            "zh": "那是说，$me$和雅再也说不上话了？",
            "narrator_zh": ""
        },
        {
            "location": "229/ACT",
            "narrator": "",
            "text": "それって、$me$とみやびがもう話せなくなるってこと？",
            "zh": "那是说，$me$和雅再也说不上话了？",
            "narrator_zh": ""
        },
        {
            "location": "231/TALK",
            "narrator": "みやび",
            "text": "その通り。",
            "zh": "就是这样。",
            "narrator_zh": "雅"
        },
        {
            "location": "232/TALK",
            "narrator": "みやび",
            "text": "出来るかどうかわからん\nけんど、物理的な回線を\n切断しようとしちゅう。",
            "zh": "做不做得到没懂，\n但是正在试图\n把物理线路切断。",
            "narrator_zh": "雅"
        },
        {
            "location": "233/TALK",
            "narrator": "みやび",
            "text": "それが叶わなくても、\n二度と受け答えは\nせんようになるな。",
            "zh": "就算做不到，\n也不会再\n回应了吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "それは嫌やろ？",
            "zh": "那你不乐意是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "235/SEL",
            "narrator": "",
            "text": "嫌やわ",
            "zh": "不乐意",
            "narrator_zh": ""
        },
        {
            "location": "236/SEL",
            "narrator": "",
            "text": "別に",
            "zh": "无所谓",
            "narrator_zh": ""
        },
        {
            "location": "237/ACT",
            "narrator": "",
            "text": "嫌やわ",
            "zh": "不乐意",
            "narrator_zh": ""
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "ほんだら、扉を\n塞いじゅう[クラン]を\nすっと倒しいや。",
            "zh": "那就，把门上\n堵住的[库兰]\n干脆打倒。",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "みやび",
            "text": "うちの本心は、\nまだ$handle$と\n繋がっていたい。",
            "zh": "我的真心是，\n还想和$handle$\n连着。",
            "narrator_zh": "雅"
        },
        {
            "location": "240/TALK",
            "narrator": "みやび",
            "text": "今ならまだ\n間に合うきね。",
            "zh": "现在还\n来得及啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "242/TALK",
