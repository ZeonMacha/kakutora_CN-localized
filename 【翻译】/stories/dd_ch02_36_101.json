{
    "dir": "chap36/daydra/dd_ch02_36_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "36202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "日常の中の約束を＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "日常之中的约定＜前篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "日常の中の約束を",
            "zh": "日常之中的约定",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "高校生アーヤ",
            "text": "ここは…実家？",
            "zh": "这里是……老家？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "26/TALK",
            "narrator": "高校生アーヤ",
            "text": "あれ私、\n何してたっけ？",
            "zh": "咦，我刚才\n在做什么来着？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "30/TALK",
            "narrator": "エリカ",
            "text": "アヤちゃーん！",
            "zh": "小绫——！",
            "narrator_zh": "领火"
        },
        {
            "location": "32/TALK",
            "narrator": "高校生アーヤ",
            "text": "…何？",
            "zh": "……怎么了？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "エリカ",
            "text": "今日暇かな？",
            "zh": "今天有空吗？",
            "narrator_zh": "领火"
        },
        {
            "location": "34/TALK",
            "narrator": "高校生アーヤ",
            "text": "…暇だけど。\nお姉ちゃんの手伝いなら\nしないからね。",
            "zh": "……倒是有空。\n不过要是给姐姐帮忙的话\n我可不干哦。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "エリカ",
            "text": "違う違う。\nすっごいいいもの\n見せたくて。",
            "zh": "不是啦不是啦。\n是有个超级棒的东西\n想拿给你看嘛。",
            "narrator_zh": "领火"
        },
        {
            "location": "36/TALK",
            "narrator": "エリカ",
            "text": "アヤちゃん絶対\nびっくりするよ！",
            "zh": "小绫绝对会\n大吃一惊的啦！",
            "narrator_zh": "领火"
        },
        {
            "location": "37/TALK",
            "narrator": "高校生アーヤ",
            "text": "…どうせまた\nクモ型ロボットとか\nなんじゃないの…？",
            "zh": "……反正又是\n什么蜘蛛型机器人之类的\n东西吧……？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "エリカ",
            "text": "あー早く見せたい！\n見せたい！",
            "zh": "啊——好想快点给你看！\n快点给你看！",
            "narrator_zh": "领火"
        },
        {
            "location": "41/TALK",
            "narrator": "高校生アーヤ",
            "text": "…わかったわよ。",
            "zh": "……知道了啦。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "56/TALK",
            "narrator": "高校生アーヤ",
            "text": "何ここ？\n洞窟の中に建物？\nしかも新しい……。",
            "zh": "这里是什么地方？\n洞窟里面有建筑？\n而且还是新的……。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "エリカ",
            "text": "ねっねっ！\nびっくりしたでしょ？",
            "zh": "你看你看！\n吓了一跳吧？",
            "narrator_zh": "领火"
        },
        {
            "location": "59/TALK",
            "narrator": "高校生アーヤ",
            "text": "うん、まあ……。",
            "zh": "嗯，算吧……。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "エリカ",
            "text": "ここね。\nお姉ちゃんの新しい\n職場なんだ。",
            "zh": "这里呀，\n就是姐姐的新\n工作单位哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "61/TALK",
            "narrator": "高校生アーヤ",
            "text": "え？",
            "zh": "咦？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "エリカ",
            "text": "うちの会社、\nエンタングルに吸収\nされたでしょ。",
            "zh": "我们公司，\n不是被Entangle\n收购了吗。[?]",
            "narrator_zh": "领火"
        },
        {
            "location": "63/TALK",
            "narrator": "エリカ",
            "text": "でね、エンタングルは\n日本の会社だから日本にも\n研究所作ろうって。",
            "zh": "然后呀，因为Entangle是\n日本公司，所以就说\n也要在日本建个研究所。",
            "narrator_zh": "领火"
        },
        {
            "location": "64/TALK",
            "narrator": "エリカ",
            "text": "どうせ東京とか大阪とか\nだろうなって思ってたら\n松代になったの！",
            "zh": "本来我还以为肯定会建在\n东京或者大阪之类的地方，\n结果定在松代了！",
            "narrator_zh": "领火"
        },
        {
            "location": "65/TALK",
            "narrator": "エリカ",
            "text": "ここだと家から通えるし\nアヤちゃんも\n嬉しいでしょ？",
            "zh": "在这里的话就能从家里通勤，\n小绫也会\n很开心吧？",
            "narrator_zh": "领火"
        },
        {
            "location": "66/TALK",
            "narrator": "高校生アーヤ",
            "text": "………別に。\n嬉しくないから。",
            "zh": "………才没有。\n一点也不开心。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "68/TALK",
            "narrator": "エリカ",
            "text": "えー。\nそっかー。\n残念……。",
            "zh": "诶——。\n这样啊——。\n好遗憾……。",
            "narrator_zh": "领火"
        },
        {
            "location": "69/TALK",
            "narrator": "エリカ",
            "text": "お姉ちゃんはすっごく\n嬉しかったのにな……。",
            "zh": "姐姐本来还\n超级开心的呢……。",
            "narrator_zh": "领火"
        },
        {
            "location": "71/TALK",
            "narrator": "高校生アーヤ",
            "text": "もう少し優しく\n言えばよかったかな…。",
            "zh": "是不是稍微温和点\n说比较好呢……。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "高校生アーヤ",
            "text": "いつからこっちに来るの？",
            "zh": "你什么时候回来这边？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "エリカ",
            "text": "一ヶ月後くらいかな。\nまだフランスでの\n仕事が残ってるから。",
            "zh": "大概一个月后吧。\n毕竟在法国那边的\n工作还有些收尾没做完。",
            "narrator_zh": "领火"
        },
        {
            "location": "75/TALK",
            "narrator": "エリカ",
            "text": "その片付けして、\nまとめてそれで晴れて\n松代ラボに移動！",
            "zh": "把那些收拾完、\n整理好之后，就能正式\n调到松代实验室啦！",
            "narrator_zh": "领火"
        },
        {
            "location": "76/TALK",
            "narrator": "エリカ",
            "text": "アヤちゃんは\n待ちきれないだろうけど\nもう少し待っててね。",
            "zh": "小绫肯定已经\n等不及了吧，\n再稍微忍耐一下下哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "78/TALK",
            "narrator": "高校生アーヤ",
            "text": "別に気を遣うこと\nなかったみたい。",
            "zh": "看来根本用不着\n顾虑她的感受。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "高校生アーヤ",
            "text": "別に帰ってこなくて\nいいから。",
            "zh": "你不用专门回来\n也没关系的。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "エリカ",
            "text": "あーもー。\nアヤちゃんって\nいつもそう。",
            "zh": "啊——真是的——。\n小绫每次都\n这样子。",
            "narrator_zh": "领火"
        },
        {
            "location": "81/TALK",
            "narrator": "エリカ",
            "text": "そんな言い方したら\nお姉ちゃん帰ってくるの\nやめちゃうかもよ？",
            "zh": "你再这么说的话，\n姐姐说不定就真不\n回来了哦？",
            "narrator_zh": "领火"
        },
        {
            "location": "83/TALK",
            "narrator": "高校生アーヤ",
            "text": "いいわよそれで。",
            "zh": "那样也无所谓。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "エリカ",
            "text": "冷たいなー。\nお姉ちゃん嘘泣き\nしちゃおっかなー。",
            "zh": "好冷淡呀——。\n姐姐要假哭\n给你看咯——。",
            "narrator_zh": "领火"
        },
        {
            "location": "86/TALK",
            "narrator": "エリカ",
            "text": "くすんくすん。",
            "zh": "呜呜呜呜。",
            "narrator_zh": "领火"
        },
        {
            "location": "88/TALK",
            "narrator": "高校生アーヤ",
            "text": "わざとらしすぎるから！",
            "zh": "这也太假了吧！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "職員Ａ",
            "text": "國政博士には色々と\n助けられました。\n本当に。",
            "zh": "国政博士帮了我们\n许多忙。\n真的非常感谢她。",
            "narrator_zh": "职员A"
        },
        {
            "location": "105/TALK",
            "narrator": "高校生アーヤ",
            "text": "…そんなお姉ちゃん、\nお姉ちゃん\nなんかじゃない。",
            "zh": "……那样的姐姐，\n才不是\n我的姐姐。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "106/TALK",
            "narrator": "高校生アーヤ",
            "text": "だから死んだのは\n別の人。",
            "zh": "所以死掉的\n肯定是别人。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "107/TALK",
            "narrator": "高校生アーヤ",
            "text": "嘘はいいから\n早く帰ってよ。",
            "zh": "别编谎话了，\n快点回去吧。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "108/TALK",
            "narrator": "高校生アーヤ",
            "text": "そうしないと\nお姉ちゃんが帰って\n来れないじゃない。",
            "zh": "不然的话，\n姐姐不就没法\n回来了吗。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "109/SEL",
            "narrator": "",
            "text": "ちょっと待って！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "110/ACT",
            "narrator": "",
            "text": "ちょっと待って！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "113/TALK",
            "narrator": "高校生アーヤ",
            "text": "何？",
            "zh": "干嘛？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "114/SEL",
            "narrator": "",
            "text": "この状況ってさ",
            "zh": "现在这是什么情况",
            "narrator_zh": ""
        },
        {
            "location": "115/SEL",
            "narrator": "",
            "text": "何っていうか…",
            "zh": "该怎么说呢……",
            "narrator_zh": ""
        },
        {
            "location": "116/SEL",
            "narrator": "",
            "text": "これって本当なの？",
            "zh": "这是真的吗？",
            "narrator_zh": ""
        },
        {
            "location": "117/ACT",
            "narrator": "",
            "text": "この状況ってさ",
            "zh": "现在这是什么情况",
            "narrator_zh": ""
        },
        {
            "location": "118/TALK",
            "narrator": "高校生アーヤ",
            "text": "知らない人が\n客間にいるのよ。",
            "zh": "不认识的人\n坐在客厅里哦。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "119/ACT",
            "narrator": "",
            "text": "何っていうか…",
            "zh": "该怎么说呢……",
            "narrator_zh": ""
        },
        {
            "location": "120/TALK",
            "narrator": "高校生アーヤ",
            "text": "ハッキリしない人ね。",
            "zh": "说话真含糊。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "121/ACT",
            "narrator": "",
            "text": "これって本当なの？",
            "zh": "这是真的吗？",
            "narrator_zh": ""
        },
        {
            "location": "122/TALK",
            "narrator": "高校生アーヤ",
            "text": "本当なんじゃないの？",
            "zh": "大概是真的吧？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "高校生アーヤ",
            "text": "今、あんまり話したく\nないの。",
            "zh": "我现在，不太想\n多说话。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "125/TALK",
            "narrator": "高校生アーヤ",
            "text": "だから手短に言って。",
            "zh": "所以长话短说吧。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "126/SEL",
            "narrator": "",
            "text": "エリカって死んだの？",
            "zh": "领火死了吗？",
            "narrator_zh": ""
        },
        {
            "location": "127/SEL",
            "narrator": "",
            "text": "國政博士事故死って",
            "zh": "国政博士因事故身亡什么的",
            "narrator_zh": ""
        },
        {
            "location": "128/SEL",
            "narrator": "",
            "text": "アーヤのお姉さん死亡？",
            "zh": "绫水的姐姐去世了？",
            "narrator_zh": ""
        },
        {
            "location": "129/ACT",
            "narrator": "",
            "text": "エリカって死んだの？",
            "zh": "领火死了吗？",
            "narrator_zh": ""
        },
        {
            "location": "130/TALK",
            "narrator": "高校生アーヤ",
            "text": "うるさい。",
            "zh": "好吵。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "131/ACT",
            "narrator": "",
            "text": "國政博士事故死って",
            "zh": "国政博士因事故身亡什么的",
            "narrator_zh": ""
        },
        {
            "location": "132/TALK",
            "narrator": "高校生アーヤ",
            "text": "手紙が来たわ。",
            "zh": "有信寄过来了。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "133/ACT",
            "narrator": "",
            "text": "アーヤのお姉さん死亡？",
            "zh": "绫水的姐姐去世了？",
            "narrator_zh": ""
        },
        {
            "location": "134/TALK",
            "narrator": "高校生アーヤ",
            "text": "そういうことみたい。",
            "zh": "好像是那样。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "高校生アーヤ",
            "text": "聞きたいことは\nそれだけ？\nじゃあね。",
            "zh": "你想问的\n就这些？\n那再见了。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "137/SEL",
            "narrator": "",
            "text": "えーと",
            "zh": "那个",
            "narrator_zh": ""
        },
        {
            "location": "138/ACT",
            "narrator": "",
            "text": "えーと",
            "zh": "那个",
            "narrator_zh": ""
        },
        {
            "location": "140/TALK",
            "narrator": "高校生アーヤ",
            "text": "まだあるの！？",
            "zh": "还有事吗！？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "141/SEL",
            "narrator": "",
            "text": "アーヤ辛いよね",
            "zh": "绫水一定很难受吧",
            "narrator_zh": ""
        },
        {
            "location": "142/SEL",
            "narrator": "",
            "text": "ご冥福をお祈りします",
            "zh": "愿她安息",
            "narrator_zh": ""
        },
        {
            "location": "143/SEL",
            "narrator": "",
            "text": "泣いてもいいと思うよ",
            "zh": "想哭的话哭出来也行哦",
            "narrator_zh": ""
        },
        {
            "location": "144/ACT",
            "narrator": "",
            "text": "アーヤ辛いよね",
            "zh": "绫水一定很难受吧",
            "narrator_zh": ""
        },
        {
            "location": "145/TALK",
            "narrator": "高校生アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "146/ACT",
            "narrator": "",
            "text": "ご冥福をお祈りします",
            "zh": "愿她安息",
            "narrator_zh": ""
        },
        {
            "location": "147/TALK",
            "narrator": "高校生アーヤ",
            "text": "そんなこと\nしなくても……。",
            "zh": "用不着这样\n……。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "148/ACT",
            "narrator": "",
            "text": "泣いてもいいと思うよ",
            "zh": "想哭的话哭出来也行哦",
            "narrator_zh": ""
        },
        {
            "location": "149/TALK",
            "narrator": "高校生アーヤ",
            "text": "それはいや。\n絶対に。",
            "zh": "才不要。\n绝对不要。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "151/TALK",
            "narrator": "高校生アーヤ",
            "text": "あの人は。",
            "zh": "那个人。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "152/TALK",
            "narrator": "高校生アーヤ",
            "text": "姉はいつでも勝手に\nいなくなる。",
            "zh": "姐姐总是擅自\n消失不见。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "高校生アーヤ",
            "text": "いつだってそう。",
            "zh": "每次都是这样。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "154/TALK",
            "narrator": "高校生アーヤ",
            "text": "フランスに行く時も\nそうだった。",
            "zh": "去法国的时候\n也是那样。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "156/TALK",
            "narrator": "高校生アーヤ",
            "text": "でも今回のが\n一番ひどい。",
            "zh": "但这一次\n是最过分的。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "157/SEL",
            "narrator": "",
            "text": "好きだったんだもんね",
            "zh": "因为你很喜欢她嘛",
            "narrator_zh": ""
        },
        {
            "location": "158/SEL",
            "narrator": "",
            "text": "帰ってくるって言ってたのにね",
            "zh": "明明说过会回来的呢",
            "narrator_zh": ""
        },
        {
            "location": "159/SEL",
            "narrator": "",
            "text": "姉って本当に勝手だよね！",
            "zh": "当姐姐的真是太任性了！",
            "narrator_zh": ""
        },
        {
            "location": "160/ACT",
            "narrator": "",
            "text": "好きだったんだもんね",
            "zh": "因为你很喜欢她嘛",
            "narrator_zh": ""
        },
        {
            "location": "162/TALK",
            "narrator": "高校生アーヤ",
            "text": "……好きじゃない。",
            "zh": "……才不喜欢。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "163/TALK",
            "narrator": "高校生アーヤ",
            "text": "むしろ嫌い。\nだいきらい。",
            "zh": "不如说讨厌。\n最讨厌了。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "164/ACT",
            "narrator": "",
            "text": "帰ってくるって言ってたのにね",
            "zh": "明明说过会回来的呢",
            "narrator_zh": ""
        },
        {
            "location": "167/TALK",
            "narrator": "高校生アーヤ",
            "text": "いつもそう。",
            "zh": "总是这样。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "168/TALK",
            "narrator": "高校生アーヤ",
            "text": "できない約束なんて\nしなきゃいいのに。",
            "zh": "做不到的约定\n就别随便许下啊。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "169/ACT",
            "narrator": "",
            "text": "姉って本当に勝手だよね！",
            "zh": "当姐姐的真是太任性了！",
            "narrator_zh": ""
        },
        {
            "location": "171/TALK",
            "narrator": "高校生アーヤ",
            "text": "本当よ。\nそのせいでいつも妹が\n割を食う。",
            "zh": "就是说啊。\n害得每次都是妹妹\n跟着吃亏。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "172/TALK",
            "narrator": "高校生アーヤ",
            "text": "勝手すぎるわよ。",
            "zh": "实在是太任性了。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "174/TALK",
            "narrator": "高校生アーヤ",
            "text": "お姉ちゃんのバカ。\n変な研究なんて\nしなきゃよかったのに。",
            "zh": "姐姐这个笨蛋。\n要是不去搞什么\n莫名其妙的研究就好了。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "176/TALK",
            "narrator": "高校生アーヤ",
            "text": "エヴェレット\n脳科学研究所なんて\n入らなきゃよかったのに。",
            "zh": "要是没进什么\n艾弗雷特脑科学研究所\n就好了。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "214/TALK",
            "narrator": "水鏡の神子",
            "text": "さて。",
            "zh": "那么。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "216/TALK",
            "narrator": "水鏡の神子",
            "text": "$handle$さんは、\n私のフェノメノン発症を\n望んでるようですが。",
            "zh": "$handle$，\n你似乎希望\n我让PhenoMENON发症。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "217/TALK",
            "narrator": "水鏡の神子",
            "text": "それはすなわち、客観的な\n世界としての存在が、\nそれを是としていること。",
            "zh": "这也就是说，作为客观的\n世界存在本身，\n是赞同此事的。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "218/TALK",
            "narrator": "水鏡の神子",
            "text": "貴方たち2人が共に\n疑問を抱いていたとしても\n私は実行せねばならない。",
            "zh": "即便你们二人都对此\n抱有疑问，\n我也必须执行。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "219/TALK",
            "narrator": "エヴェレット　",
            "text": "世界が是としていても、\n私たちは非としている。",
            "zh": "就算世界赞同，\n我们也认为不妥。",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "220/TALK",
            "narrator": "白烏",
            "text": "私は世界である前に、\n國政綾水という個でも\nありますよ。",
            "zh": "我在成为世界之前，\n首先也是国政绫水\n这个个体哦。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "222/TALK",
            "narrator": "水鏡の神子",
            "text": "種の件については、\n思うところはあれど\nひとまず置いておきます。",
            "zh": "关于种子的事，\n虽然我也有所想法，\n但姑且先放一边。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "223/TALK",
            "narrator": "水鏡の神子",
            "text": "まずは、エヴェレットの\n言う“矛盾”について、\n議論しましょう。",
            "zh": "首先，就艾弗雷特\n所说的“矛盾”，\n我们来讨论一下吧。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "224/TALK",
            "narrator": "エヴェレット　",
            "text": "貴方は、國政綾水という\n個体の想いを体現する\n存在なんです。",
            "zh": "你是体现国政绫水\n这一孤立个体想法的\n存在。",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "226/TALK",
            "narrator": "白烏",
            "text": "その個である総意の大半が\n発症を非としているのに、\n貴方だけが推進している。",
            "zh": "明明构成这个个体的总意大半\n都反对发症，\n却唯独你在推进这件事。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "227/TALK",
            "narrator": "エヴェレット　",
            "text": "そこに、“私”としての\n疑問を抱かずには\nいられないんです。",
            "zh": "对此，作为“我”\n实在不能不抱有\n疑问。",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "228/TALK",
            "narrator": "水鏡の神子",
            "text": "天使としての契約をした\nからには、私を省みず\n公に徹するべきです。",
            "zh": "既然缔结了身为天使的\n契约，就理应不顾私情，\n彻底奉行公义。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "229/TALK",
            "narrator": "水鏡の神子",
            "text": "それこそが、\n天使としての責務。",
            "zh": "这正是\n身为天使的职责。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "235/SEL",
            "narrator": "",
            "text": "その通り",
            "zh": "确实如此",
            "narrator_zh": ""
        },
        {
            "location": "236/SEL",
            "narrator": "",
            "text": "ところで天使になるって決めたのはいつからなの？",
            "zh": "话说回来，你是从什么时候决定成为天使的？",
            "narrator_zh": ""
        },
        {
            "location": "237/ACT",
            "narrator": "",
            "text": "その通り",
            "zh": "确实如此",
            "narrator_zh": ""
        },
        {
            "location": "238/ACT",
            "narrator": "",
            "text": "ところで天使になるって決めたのはいつからなの？",
            "zh": "话说回来，你是从什么时候决定成为天使的？",
            "narrator_zh": ""
        },
        {
            "location": "240/TALK",
            "narrator": "水鏡の神子",
            "text": "潜在的には、姉の訃報を\n受けてからです。",
            "zh": "在潜意识里，是从接到\n姐姐的讣告开始的。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "241/TALK",
            "narrator": "水鏡の神子",
            "text": "もちろん、その時にはまだ\n今回の任務などは\n知りませんでしたが。",
            "zh": "当然，那个时候我还\n并不知道这次的\n任务内容。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "243/TALK",
            "narrator": "エヴェレット　",
            "text": "え……\nなにその訃報って……",
            "zh": "咦……\n什么叫讣告……",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "244/TALK",
            "narrator": "白烏",
            "text": "そうだったのね。\n全然知らなかった。",
            "zh": "原来如此。\n我完全不知道。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "248/TALK",
            "narrator": "エヴェレット　",
            "text": "いやちょっとまって！\n訃報って何！？",
            "zh": "不是，等一下！\n讣告是怎么回事！？",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "252/TALK",
            "narrator": "白烏",
            "text": "現実では姉は\n死んだことになってる。",
            "zh": "在现实里，姐姐\n已经被算作死了。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "253/TALK",
            "narrator": "エヴェレット　",
            "text": "嘘よ！！",
            "zh": "骗人！！",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "254/TALK",
            "narrator": "白烏",
            "text": "ホントだってば。\nでも実際には\n死んではいないけど。",
            "zh": "是真的啦。\n不过实际上\n她并没有死就是了。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "255/TALK",
            "narrator": "エヴェレット　",
            "text": "どういうこと？\n全然わからない！",
            "zh": "什么意思？\n我完全听不懂！",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "256/TALK",
            "narrator": "白烏",
            "text": "言葉の通り。\n消息は不明。\n勤務先から訃報を受ける。",
            "zh": "就是字面意思。\n下落不明。\n然后从工作单位收到了讣告。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "257/TALK",
            "narrator": "白烏",
            "text": "けど――",
            "zh": "但是——",
            "narrator_zh": "白鸦"
        },
        {
            "location": "258/TALK",
            "narrator": "白烏",
            "text": "逢瀬つばめのフェノメノン\nの中では、何度も連絡を\nしてきている。",
            "zh": "在逢濑燕的PhenoMENON\n里面，她却好几次\n主动联系过我们。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "259/TALK",
            "narrator": "白烏",
            "text": "だから、少なくとも\n死んではいないと、\n1xの私は踏んでいる。",
            "zh": "所以1x的我判断，\n至少她现在\n并没有死。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "260/TALK",
            "narrator": "エヴェレット　",
            "text": "そんな……\n全然知らないわよ、\nそんな話！！",
            "zh": "怎么会……\n这种事我可从来\n没听说过！！",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "261/TALK",
            "narrator": "水鏡の神子",
            "text": "そうでしょうね。",
            "zh": "那也是理所当然的。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "262/TALK",
            "narrator": "水鏡の神子",
            "text": "この記憶は、逢瀬つばめの\nフェノメノンによって\n完全に消されています。",
            "zh": "这段记忆，已经被逢濑燕\n的PhenoMENON\n彻底消除了。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "263/SEL",
            "narrator": "",
            "text": "なんで消されたの？",
            "zh": "为什么要消除这段记忆？",
            "narrator_zh": ""
        },
        {
            "location": "264/ACT",
            "narrator": "",
            "text": "なんで消されたの？",
            "zh": "为什么要消除这段记忆？",
            "narrator_zh": ""
        },
        {
            "location": "266/TALK",
            "narrator": "水鏡の神子",
            "text": "それは\n私の知るところでは\nありません。",
            "zh": "这就\n不是我所能知晓的\n了。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "267/TALK",
            "narrator": "水鏡の神子",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "272/TALK",
            "narrator": "水鏡の神子",
            "text": "さて、\n話を元に戻しますが――",
            "zh": "那么，\n把话题拉回来吧——",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "273/TALK",
            "narrator": "水鏡の神子",
            "text": "敢えてここでは、\n“消失”と言いましょう。",
            "zh": "在此，我就姑且\n称之为“消失”吧。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "274/TALK",
            "narrator": "水鏡の神子",
            "text": "私はこの計画への参加で、\n姉の消失の原因を知る事が\nできると判断しました。",
            "zh": "我判断通过参与这个计划，\n就能弄清姐姐消失的\n原因。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "275/TALK",
            "narrator": "水鏡の神子",
            "text": "天使という契約。\nこれはエンタングルによる\nフェノム計画――",
            "zh": "天使的契约。\n这是由Entangle主导的\nPhenom计划——[?]",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "276/TALK",
            "narrator": "水鏡の神子",
            "text": "すなわち、世界救済計画に\nよって締結されている\nものです。",
            "zh": "也就是通过世界救济计划\n所缔结的\n契约。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "277/TALK",
            "narrator": "水鏡の神子",
            "text": "契約当初は単に、内部に\n入り、姉の消失の全貌を\n暴こうとしたまでです。",
            "zh": "契约之初，我单纯只是想\n潜入内部，揭开姐姐\n消失的全貌罢了。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "278/TALK",
            "narrator": "水鏡の神子",
            "text": "しかしその後、千羽鶴\nからのコンタクトがあり、\n1xの契約をしました。",
            "zh": "但在这之后，千羽鹤\n与我取得了联系，\n于是我又缔结了1x的契约。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "279/SEL",
            "narrator": "",
            "text": "それって最初の契約に対する裏切りでは？",
            "zh": "那岂不是背叛了最初的契约？",
            "narrator_zh": ""
        },
        {
            "location": "280/ACT",
            "narrator": "",
            "text": "それって最初の契約に対する裏切りでは？",
            "zh": "那岂不是背叛了最初的契约？",
            "narrator_zh": ""
        },
        {
            "location": "282/TALK",
            "narrator": "水鏡の神子",
            "text": "そうかもしれませんね。",
            "zh": "或许确实如此呢。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "283/TALK",
            "narrator": "水鏡の神子",
            "text": "千羽鶴は、彼らとの契約に\n対する法務上の違反は\n無いと言ってましたが――",
            "zh": "虽然千羽鹤说过，这在\n法务上并不构成对他们\n契约的违约——",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "284/TALK",
            "narrator": "水鏡の神子",
            "text": "私は不義理ではあると\n思っています。",
            "zh": "但我自己也觉得\n这确实有失信义。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "285/TALK",
            "narrator": "水鏡の神子",
            "text": "ですが、内観しつつ\n出した結論としては、\n現状の通りです。",
            "zh": "不过，在我自我省察后\n得出的结论，\n就是如今的现状。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "286/TALK",
            "narrator": "水鏡の神子",
            "text": "その理由は、少なくとも\n“彼ら”は、姉のことに\nついて嘘をついている。",
            "zh": "理由在于，至少\n“他们”在姐姐这件事上\n说了谎。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "287/TALK",
            "narrator": "水鏡の神子",
            "text": "千羽鶴は実際に、\n生きている姉と現時点で\n交流しているからです。",
            "zh": "因为千羽鹤实际上\n正与活着的姐姐\n保持着交流。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "288/TALK",
            "narrator": "水鏡の神子",
            "text": "私は、より正確に\n姉の真実を確認したいと\n考えています。",
            "zh": "我希望能够更准确地\n确认有关姐姐的\n真相。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "289/TALK",
            "narrator": "水鏡の神子",
            "text": "ですから、常にその判断は\n真実に近づくことが\n出来るか否かなのです。",
            "zh": "因此，我的判断标准\n永远只有一个：\n能否借此接近真相。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "290/SEL",
            "narrator": "",
            "text": "そうか、だから水鏡の神子なのか",
            "zh": "原来如此，所以才叫水镜之巫女啊",
            "narrator_zh": ""
        },
        {
            "location": "291/SEL",
            "narrator": "",
            "text": "それほどまでに姉のことが好きだったんだね",
            "zh": "原来你这么喜欢姐姐啊",
            "narrator_zh": ""
        },
        {
            "location": "292/ACT",
            "narrator": "",
            "text": "そうか、だから水鏡の神子なのか",
            "zh": "原来如此，所以才叫水镜之巫女啊",
            "narrator_zh": ""
        },
        {
            "location": "295/TALK",
            "narrator": "エヴェレット　",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "297/TALK",
            "narrator": "白烏",
            "text": "水鏡。",
            "zh": "水镜。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "298/TALK",
            "narrator": "白烏",
            "text": "水がありのままに物事を\n映すように、無心に観察し\n真実を探求すること――",
            "zh": "就像水面如实映照出\n万物那样，无心观察\n并探求真实——",
            "narrator_zh": "白鸦"
        },
        {
            "location": "299/TALK",
            "narrator": "白烏",
            "text": "それを第一義として\n存在しているということ。",
            "zh": "也就是说，她的存在\n正是以此为第一要义。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "300/TALK",
            "narrator": "エヴェレット　",
            "text": "そんな！\nそれが第一義なら、\n私という存在は！？",
            "zh": "怎么这样！\n如果那是第一要义，\n那我这个存在又算什么！？",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "305/TALK",
            "narrator": "水鏡の神子",
            "text": "もちろん、\n真実の世界あっての私。",
            "zh": "当然是\n先有真实的世界，才有我。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "306/TALK",
            "narrator": "水鏡の神子",
            "text": "うつつが在り、\nそして私が\n存在するのですよ。",
            "zh": "有现实存在，\n而后才有我\n存在哦。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "307/SEL",
            "narrator": "",
            "text": "やっぱりアーヤの本質はそこなんだね",
            "zh": "果然绫水的本质就在这里呢",
            "narrator_zh": ""
        },
        {
            "location": "308/ACT",
            "narrator": "",
            "text": "やっぱりアーヤの本質はそこなんだね",
            "zh": "果然绫水的本质就在这里呢",
            "narrator_zh": ""
        },
        {
            "location": "312/TALK",
            "narrator": "白烏",
            "text": "良く言えば無私の奉仕。\n悪く言えば、確固たる\n己の信念がない状態。",
            "zh": "往好听了说是无私奉献。\n往难听了说，就是没有\n坚定自我信念的状态。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "313/TALK",
            "narrator": "水鏡の神子",
            "text": "善し悪しは\nここで議論するものでは\nありませんよ。",
            "zh": "孰优孰劣，\n并不是该在这里\n讨论的问题哦。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "314/ACT",
            "narrator": "",
            "text": "それほどまでに姉のことが好きだったんだね",
            "zh": "原来你这么喜欢姐姐啊",
            "narrator_zh": ""
        },
        {
            "location": "319/TALK",
            "narrator": "エヴェレット　",
            "text": "え？　まさか！",
            "zh": "咦？怎么可能！",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "320/TALK",
            "narrator": "水鏡の神子",
            "text": "そうですね。\n私は姉のことは、\n内心とても慕っています。",
            "zh": "是这样呢。\n其实我内心\n非常仰慕姐姐。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "323/TALK",
            "narrator": "エヴェレット　",
            "text": "ええっ！？\nそうなの！？",
            "zh": "诶诶！？\n真的吗！？",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "325/TALK",
            "narrator": "白烏",
            "text": "ああ、そうか。\n0xでは、核心部分が\n伏せられていたから――",
            "zh": "啊，难怪。\n在0x里，核心部分\n都被隐瞒了——",
            "narrator_zh": "白鸦"
        },
        {
            "location": "326/TALK",
            "narrator": "白烏",
            "text": "姉が嫌いであるという\n感覚が、私という存在の\n“設定”になってた。",
            "zh": "所以讨厌姐姐这种\n感觉，就成了我这个存在的\n“设定”。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "327/TALK",
            "narrator": "白烏",
            "text": "いろんな理由を探しては、\nそれが嫌いである理由だと\n思い込んで。",
            "zh": "不断找着各种理由，\n擅自认定那就是我\n讨厌姐姐的原因。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "328/TALK",
            "narrator": "白烏",
            "text": "そんな理由で、どうして\n姉が嫌いなのかという\n矛盾も全て見て見ぬフリ。",
            "zh": "至于凭那种理由为什么会\n讨厌姐姐之类的矛盾，\n也全都视而不见。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "329/TALK",
            "narrator": "白烏",
            "text": "不自然に感情が高ぶるのも\n全部気のせいにして、\n納得していたのね。",
            "zh": "就连情绪不自然地激动，\n也都当成是错觉，\n强行说服了自己呢。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "331/TALK",
            "narrator": "エヴェレット　",
            "text": "そんな……",
            "zh": "怎么会……",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "333/TALK",
            "narrator": "エヴェレット　",
            "text": "そんなこと……",
            "zh": "怎么会这样……",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "334/TALK",
            "narrator": "水鏡の神子",
            "text": "0xは半分作られた人生。\nそういったこともまた\nあるかとは思います。",
            "zh": "0x是被造就了一半的人生。\n会有这种事情，\n也是难免的。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "339/TALK",
            "narrator": "水鏡の神子",
            "text": "さて、そろそろ\n結論を出す時間に\nしましょう。",
            "zh": "那么，差不多该\n到了做出结论的\n时间了。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "340/TALK",
            "narrator": "水鏡の神子",
            "text": "國政綾水はこれから\n天使となります。",
            "zh": "国政绫水接下来\n将成为天使。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "341/TALK",
            "narrator": "水鏡の神子",
            "text": "その事に対して、\nあなた方の考えは。",
            "zh": "对此，\n你们是怎么想的。",
            "narrator_zh": "水镜之巫女"
        },
        {
            "location": "343/TALK",
            "narrator": "エヴェレット　",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "345/TALK",
            "narrator": "エヴェレット　",
            "text": "やっぱり私は\n賛同できない。",
            "zh": "我果然还是\n无法赞同。",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "356/TALK",
            "narrator": "エヴェレット　",
            "text": "$handle$さん。\n今からでは、考えも\n変わらないでしょうけど―",
            "zh": "$handle$。\n事到如今，你的想法\n大概也不会改变了吧——",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "357/TALK",
            "narrator": "エヴェレット　",
            "text": "私はやっぱり、\nフェノメノンの発症には\n反対です。",
            "zh": "但我还是\n反对PhenoMENON\n的发症。",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "358/TALK",
            "narrator": "エヴェレット　",
            "text": "だから私は、その想いを\n込めて、水鏡の神子を\n抑えるべく戦います。",
