            "narrator_zh": "白鸦"
        },
        {
            "location": "362/TALK",
            "narrator": "白烏",
            "text": "$handle$さんは？",
            "zh": "$handle$呢？",
            "narrator_zh": "白鸦"
        },
        {
            "location": "363/SEL",
            "narrator": "",
            "text": "フェノメノンになって千羽鶴に協力して欲しい",
            "zh": "希望她化作PhenoMENON去协助千羽鹤",
            "narrator_zh": ""
        },
        {
            "location": "364/SEL",
            "narrator": "",
            "text": "話聞いてて、阻止した方がいいかもと思った",
            "zh": "听完之后，觉得还是阻止比较好",
            "narrator_zh": ""
        },
        {
            "location": "365/ACT",
            "narrator": "",
            "text": "フェノメノンになって千羽鶴に協力して欲しい",
            "zh": "希望她化作PhenoMENON去协助千羽鹤",
            "narrator_zh": ""
