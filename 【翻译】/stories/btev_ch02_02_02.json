{
    "dir": "chap02/battle/btev_ch02_02_02.js",
    "type": "",
    "info": {
        "story_id": "22003",
        "cid": "",
        "title": "003 ココロスフィアストーリー【Lv01】",
        "sub_title": "己の敵は己＜帰結＞",
        "title_zh": "003 心灵领域故事【Lv01】",
        "sub_title_zh": "自己的敌人就是自己＜归结＞"
    },
    "entry": [
        {
            "location": "316/SCENARIO",
            "narrator": "",
            "text": "バトル終了",
            "zh": "战斗结束",
            "narrator_zh": ""
        },
        {
            "location": "327/TALK",
            "narrator": "潜在アーヤ",
            "text": "あーあ、\nやられちゃったわね。",
            "zh": "啊呀，\n还是输掉了呢。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "328/TALK",
            "narrator": "表層アーヤ",
            "text": "当然よ。\n任務の遂行は、何が\nあっても絶対だもの。",
            "zh": "当然了。\n完成任务不管怎样\n都是绝对的。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "329/TALK",
            "narrator": "潜在アーヤ",
            "text": "…そうね。\nま、それが私か。",
            "zh": "……说得也是。\n嘛，这就是我吧。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "330/TALK",
            "narrator": "潜在アーヤ",
            "text": "ねえ、最後に１つ\nお願いがあるんだけど、\nいいかしら？",
            "zh": "我说，最后我有\n一个请求，\n可以吗？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "331/TALK",
            "narrator": "表層アーヤ",
            "text": "なに？",
            "zh": "什么事？",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "332/TALK",
            "narrator": "潜在アーヤ",
            "text": "$handle$さんと\n二人きりで\nお茶したいのだけど。",
            "zh": "我想和$handle$\n两个人独处\n喝个茶。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "333/TALK",
            "narrator": "表層アーヤ",
            "text": "貴方、\nまだそんな力が…",
            "zh": "你\n还有那种力气……",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "334/TALK",
            "narrator": "潜在アーヤ",
            "text": "無いわよ。\nもう間もなく消えるわ。",
            "zh": "没有哦。\n很快就要消失了。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "335/TALK",
            "narrator": "潜在アーヤ",
            "text": "でも、貴方が私を\n打ち負かしたのが\n貴方の想いの力なら―",
            "zh": "不过，如果打败我的\n是你的\n心意之力的话—",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "336/TALK",
            "narrator": "潜在アーヤ",
            "text": "私が\n$handle$さんと\n話すまで消えないのも、",
            "zh": "我坚持到\n和$handle$\n说上话之前不消失，",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "337/TALK",
            "narrator": "潜在アーヤ",
            "text": "やっぱり想いの力よ。",
            "zh": "同样也是心意之力哦。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "338/TALK",
            "narrator": "表層アーヤ",
            "text": "…でも……",
            "zh": "……可是……",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "339/TALK",
            "narrator": "潜在アーヤ",
            "text": "貴方の正義感は\n私を形成する重要な\n要素だとは思う。",
            "zh": "你的正义感\n确实是构成我的\n重要要素。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "340/TALK",
            "narrator": "潜在アーヤ",
            "text": "でも、私のような、\n他の色を持った自分も\n大切にしてよ。",
            "zh": "但也请你珍惜一下\n像我这样带着其他色彩的\n自己吧。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "341/TALK",
            "narrator": "表層アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "342/TALK",
            "narrator": "表層アーヤ",
            "text": "……ええ。\n分かったわ。",
            "zh": "……嗯。\n我知道了。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "344/TALK",
            "narrator": "潜在アーヤ",
            "text": "ふふ、ありがと。",
            "zh": "呵呵，谢谢。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "346/TALK",
            "narrator": "潜在アーヤ",
            "text": "$handle$さん。",
            "zh": "$handle$。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "347/TALK",
            "narrator": "潜在アーヤ",
            "text": "選択権が無くて申し訳\n無いけど、ちょっと\nつき合ってくださいな。",
            "zh": "抱歉没给你选择权，\n不过还是请你\n陪我一会儿吧。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "349/TALK",
            "narrator": "表層アーヤ",
            "text": "くっ……\n何て力なの？",
            "zh": "唔……\n这是何等的力量？",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "350/TALK",
            "narrator": "潜在アーヤ",
            "text": "どう？　　　　",
            "zh": "怎么样？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "351/TALK",
            "narrator": "潜在アーヤ",
            "text": "それだけ私の総体としては\n個を大事にしたいって\n思ってるってことよ。",
            "zh": "这就说明从我的整体来说，\n还是很想好好珍惜\n个人生活的哦。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "352/TALK",
            "narrator": "表層アーヤ",
            "text": "……そう。",
            "zh": "……这样。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "354/TALK",
            "narrator": "表層アーヤ",
            "text": "まあいいわ。\n何を言おうとも、\n負けは負け。",
            "zh": "算了。\n不管说什么，\n输了就是输了。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "355/TALK",
            "narrator": "表層アーヤ",
            "text": "私はもう、すぐに\n消えてしまう\n身なのだから。",
            "zh": "反正我也是很快\n就要消失的\n人了。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "356/TALK",
            "narrator": "表層アーヤ",
            "text": "でも、これだけは\n覚えておいて欲しい。",
            "zh": "不过，唯独这件事\n希望你能记住。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "357/TALK",
            "narrator": "表層アーヤ",
            "text": "私は一人の女性である\n以前に、日本の未来を\n託されている存在。",
            "zh": "我在身为一名女性之前，\n更是被托付了\n日本未来的存在。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "358/TALK",
            "narrator": "表層アーヤ",
            "text": "普通の女性とは、\nそこが絶対的に\n違うところなの。",
            "zh": "与普通的女性，\n在这一点上是有着\n绝对不同的。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "359/TALK",
            "narrator": "表層アーヤ",
            "text": "請け負った以上は、\n普通の生活なんて\nできないのよ。",
            "zh": "既然接下了这份重任，\n普通的生活什么的\n是不可能过的。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "360/TALK",
            "narrator": "潜在アーヤ",
            "text": "わかってるわよ。\nバランスが大事。",
            "zh": "我知道啦。\n最重要的是平衡。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "362/TALK",
            "narrator": "表層アーヤ",
            "text": "$handle$さん。\n貴方のことは信じてます。",
            "zh": "$handle$。\n我是信任你的。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "363/TALK",
            "narrator": "表層アーヤ",
            "text": "私が行きすぎたときは\nちゃんと止めてあげて\nくださいね。",
            "zh": "当我走得太偏的时候，\n还请一定要\n拉住我哦。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "377/TALK",
            "narrator": "潜在アーヤ",
            "text": "ふふ。\n今回は協力してくれて\nありがと。",
            "zh": "呵呵。\n谢谢你这次\n帮了我。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "378/TALK",
            "narrator": "潜在アーヤ",
            "text": "やっと二人きりに\nなれたわね。",
            "zh": "总算能两个人\n独处了呢。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "380/TALK",
            "narrator": "潜在アーヤ",
            "text": "ね！\nちょっと私に\nつき合ってくれない？",
            "zh": "我说！\n能不能稍微\n陪陪我呀？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "381/TALK",
            "narrator": "潜在アーヤ",
            "text": "私のこと、\nもっと色々\n知って欲しいから！",
            "zh": "因为我想让你\n更多地了解\n我的事！",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "382/TALK",
            "narrator": "潜在アーヤ",
            "text": "ね？　いいでしょ？",
            "zh": "好不好？　可以吧？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "383/SEL",
            "narrator": "（選択肢）",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": "（选项）"
        },
        {
            "location": "384/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "386/TALK",
            "narrator": "潜在アーヤ",
            "text": "ありがと！",
            "zh": "谢谢！",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "387/TALK",
            "narrator": "潜在アーヤ",
            "text": "それじゃ、ちょっとだけ\n昔の世界に移動するわね。",
            "zh": "那么，我们就稍微去\n过去的世界看一眼吧。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "388/TALK",
            "narrator": "潜在アーヤ",
            "text": "私がどんな気持ちで\n学生時代を過ごしてたか\n見せてあげる。",
            "zh": "我让你看看，\n我过去是抱着怎样的心情\n度过学生时代的。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "400/DIALOG",
            "narrator": "",
            "text": "今から貴方に\n高校生の頃の\n私の話をするわね。",
            "zh": "现在我来给你讲讲\n高中时期的\n我的故事吧。",
            "narrator_zh": ""
        },
        {
            "location": "412/DIALOG",
            "narrator": "",
            "text": "高校の時の私は、\nそれこそ非の打ち所がない程の\n模範的な高校生だったわ。\n\n校則通りの制服、\n髪の毛は短く切り、\n化粧なんてしたことも無かった。\n",
            "zh": "高中时期的我，\n简直是挑不出任何毛病的\n模范高中生。\n\n完全合乎校规的制服，\n把头发剪得短短的，\n化过妆什么的更是从没有过。\n",
            "narrator_zh": ""
        },
        {
            "location": "413/DIALOG",
            "narrator": "",
            "text": "部活や生徒会や、\n学校活動は全力でやったし、\nとても充実した\n学校生活だったけど……\n\nでもやっぱり何か、\nひとつ物足りなかった。\n\nそう――",
            "zh": "社团活动也好学生会也罢，\n学校里的活动我都全力以赴，\n度过了非常充实的\n校园生活……\n\n但果然还是觉得，\n少了点什么。\n\n没错——",
            "narrator_zh": ""
        },
        {
            "location": "435/TALK",
            "narrator": "男子高校生",
            "text": "今日どうする？",
            "zh": "今天去干嘛？",
            "narrator_zh": "男高中生"
        },
        {
            "location": "436/TALK",
            "narrator": "女子高校生",
            "text": "そうだなー、\n久し振りに門前で\nケーキ食べたいかも！",
            "zh": "我想想——\n好久没去门前了，\n真想吃蛋糕呀！[?]",
            "narrator_zh": "女高中生"
        },
        {
            "location": "437/DIALOG",
            "narrator": "",
            "text": "内心すごく羨ましかったの。\n\nお化粧してる子。\n\n制服をオシャレに\nアレンジしてる子。\n\nそして、\n男の子と楽しく\nお話している子――。",
            "zh": "其实我心里羡慕得不得了。\n\n化着妆的女孩子。\n\n把校服改得时髦又\n好看的女孩子。\n\n还有，\n和男孩子开开心心\n聊着天的女孩子——。",
            "narrator_zh": ""
        },
        {
            "location": "438/TALK",
            "narrator": "男子高校生",
            "text": "マジかよ！\n…まあいいや、\nんじゃ行くか。",
            "zh": "真的假的！\n……算了行吧，\n那就走呗。",
            "narrator_zh": "男高中生"
        },
        {
            "location": "439/TALK",
            "narrator": "女子高校生",
            "text": "やったぁ！",
            "zh": "太好啦！",
            "narrator_zh": "女高中生"
        },
        {
            "location": "447/DIALOG",
            "narrator": "",
            "text": "うちは父が厳しくて、\nしたくてもそういうのが\nできなかった、というのも\nあったけど――",
            "zh": "家里父亲管得很严，\n就算想那样\n也做不到——虽然也有\n这方面的缘故——",
            "narrator_zh": ""
        },
        {
            "location": "449/DIALOG",
            "narrator": "",
            "text": "やっぱり勇気が無かったのよね。\nただ単に。",
            "zh": "说到底还是没勇气吧。\n单纯就是这样。",
            "narrator_zh": ""
        },
        {
            "location": "463/TALK",
            "narrator": "潜在アーヤ",
            "text": "体裁を気にする\n現実の私は絶対に\n否定するけど――",
            "zh": "只顾着体面的\n现实中的我绝对会\n矢口否认——",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "464/TALK",
            "narrator": "潜在アーヤ",
            "text": "勉強と部活ばかりで\n恋なんて一度もした\nことがない私だから、",
            "zh": "一直只顾着学习和社团，\n连一次恋爱都没谈\n过的我，",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "465/TALK",
            "narrator": "潜在アーヤ",
            "text": "憧れの東京で、思いっ\nきりオシャレして、\nカフェやお買い物して、",
            "zh": "才会在憧憬的东京，\n尽情地打扮自己，\n去咖啡馆、去逛街购物，",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "466/TALK",
            "narrator": "潜在アーヤ",
            "text": "そして、\n素敵な恋をする――。",
            "zh": "然后，\n谈一场美好的恋爱——。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "467/TALK",
            "narrator": "潜在アーヤ",
            "text": "今でもそういうのに\n凄く憧れてるの。\n年甲斐も無くね。",
            "zh": "哪怕到现在，我对那种事\n还是非常憧憬呢。\n真是老大不小了还这样。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "468/SEL",
            "narrator": "（選択肢）",
            "text": "どうしてそんなこと、わざわざ$me$に？",
            "zh": "为什么特意把这种事告诉$me$？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "469/ACT",
            "narrator": "",
            "text": "どうしてそんなこと、わざわざ$me$に？",
            "zh": "为什么特意把这种事告诉$me$？",
            "narrator_zh": ""
        },
        {
            "location": "471/TALK",
            "narrator": "潜在アーヤ",
            "text": "そうね。\nそれは――",
            "zh": "说得也是。\n那是因为——",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "472/TALK",
            "narrator": "潜在アーヤ",
            "text": "貴方は私の心にまで\n入ってくるような人\nだから、",
            "zh": "因为你是能走进\n我心底的人\n啊，",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "474/TALK",
            "narrator": "潜在アーヤ",
            "text": "きっとこれからも\n私とつき合っていって\nくれるのかなと思って。",
            "zh": "我觉得你今后\n一定也会一直\n陪伴着我吧。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "475/TALK",
            "narrator": "潜在アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "476/TALK",
            "narrator": "潜在アーヤ",
            "text": "正直ね、今回の件、\nあのカタブツの私が\n言うこともわかるの。",
            "zh": "老实说呢，这次的事，\n那个老顽固的我\n说的话我也能懂。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "477/TALK",
            "narrator": "潜在アーヤ",
            "text": "もちろん、\n今の私の任務は\nとても大事なもの。",
            "zh": "当然，\n现在的我的任务\n非常重要。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "478/TALK",
            "narrator": "潜在アーヤ",
            "text": "でも、そういう\n責任とか任務とか――",
            "zh": "但是，那种\n责任啊任务啊——",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "479/TALK",
            "narrator": "潜在アーヤ",
            "text": "高校時代に散々経験\nしたことはもう\nおなかいっぱいで、",
            "zh": "高中时代就已经\n经历了个够，\n早就腻透了，",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "480/TALK",
            "narrator": "潜在アーヤ",
            "text": "オシャレしたり彼氏\n作ったりして普通に\n生きたい私もいる。",
            "zh": "想要打扮自己、交个\n男朋友过普通生活的我，\n也同样存在。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "481/TALK",
            "narrator": "潜在アーヤ",
            "text": "任務のためだからって\n恥ずかしい思いする\nなんてもってのほかよ。",
            "zh": "动不动就因为任务\n去干些丢脸的事，\n那更是绝对不行。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "482/TALK",
            "narrator": "潜在アーヤ",
            "text": "他のメンバーだけで\n出来るなら、\n任せればいいって思う。",
            "zh": "要是其他成员自己\n就能搞定的话，\n交给她们就好了嘛。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "483/TALK",
            "narrator": "潜在アーヤ",
            "text": "そんな二律背反な\n自分が毎日戦って\nなかなか前に進めない。",
            "zh": "这样二律背反的\n两个自己每天都在交战，\n迟迟无法向前迈进。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "485/TALK",
            "narrator": "潜在アーヤ",
            "text": "自分の中だけじゃ、\n何が一番大事なのか\nわからない事もある。",
            "zh": "光靠自己一个人，\n有时也看不清究竟\n什么才是最重要的。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "486/TALK",
            "narrator": "潜在アーヤ",
            "text": "貴方なら、それを\nちゃんと見定めて\n一押ししてくれる――",
            "zh": "但如果是你的话，\n一定能看清一切，\n在背后推我一把——",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "487/TALK",
            "narrator": "潜在アーヤ",
            "text": "何となくそんな気が\nしたから、色々本音を\nお伝えしてみました。",
            "zh": "我隐约有了这样的感觉，\n所以才试着把各种真心话\n全都说给你听。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "488/TALK",
            "narrator": "潜在アーヤ",
            "text": "他力本願で、自分でも\nちょっとかっこ悪いな\nって思うけど。",
            "zh": "总想着依靠别人，连我自己\n都觉得有点\n丢人就是了。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "489/TALK",
            "narrator": "潜在アーヤ",
            "text": "そんな私でもよければ\nこれからも支えて\nくれると嬉しいかな。",
            "zh": "即便如此，如果你不嫌弃的话，\n今后也能继续支撑着我，\n我会很高兴的。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "490/SEL",
            "narrator": "（選択肢）",
            "text": "任せて！",
            "zh": "交给我吧！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "491/SEL",
            "narrator": "（選択肢）",
            "text": "まあ、気が向いたら",
            "zh": "嘛，看心情吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "492/ACT",
            "narrator": "",
            "text": "任せて！",
            "zh": "交给我吧！",
            "narrator_zh": ""
        },
        {
            "location": "493/TALK",
            "narrator": "潜在アーヤ",
            "text": "ふふ、心強いわ。",
            "zh": "呵呵，真可靠呢。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "494/ACT",
            "narrator": "",
            "text": "まあ、気が向いたら",
            "zh": "嘛，看心情吧",
            "narrator_zh": ""
        },
        {
            "location": "495/TALK",
            "narrator": "潜在アーヤ",
            "text": "そうね。\n気が向いたらでいいわ。",
            "zh": "也是。\n看你心情就好。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "498/TALK",
            "narrator": "潜在アーヤ",
            "text": "……そろそろここには\nいられなくなりそう。",
            "zh": "……我好像差不多\n没法继续留在这里了。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "499/TALK",
            "narrator": "潜在アーヤ",
            "text": "貴方と色々お話できて\n良かった。つき合って\nくれてありがとう。",
            "zh": "能和你聊这么多\n真开心。谢谢你\n陪我。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "500/TALK",
            "narrator": "潜在アーヤ",
            "text": "貴方とは、また機会が\nあれば会いたいわね。",
            "zh": "要是以后还有机会，\n真想再和你见面呢。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "501/TALK",
            "narrator": "潜在アーヤ",
            "text": "それじゃ、またね――",
            "zh": "那么，回头见——",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "514/TALK",
            "narrator": "表層アーヤ",
            "text": "大丈夫だった！？\n変な事されてない？",
            "zh": "你没事吧！？\n她没对你做什么奇怪的事吧？",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "515/SEL",
            "narrator": "（選択肢）",
            "text": "大丈夫だよ",
            "zh": "没事啦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "516/SEL",
            "narrator": "（選択肢）",
            "text": "アーヤの恥ずかしい話色々聞いたよ",
            "zh": "我听了不少绫水让人害羞的事哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "517/ACT",
            "narrator": "",
            "text": "大丈夫だよ",
            "zh": "没事啦",
            "narrator_zh": ""
        },
        {
            "location": "518/TALK",
            "narrator": "表層アーヤ",
            "text": "そう、良かった。",
            "zh": "这样啊，太好了。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "519/ACT",
            "narrator": "",
            "text": "アーヤの恥ずかしい話色々聞いたよ",
            "zh": "我听了不少绫水让人害羞的事哦",
            "narrator_zh": ""
        },
        {
            "location": "525/DIALOG",
            "narrator": "",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": ""
        },
        {
            "location": "531/TALK",
            "narrator": "表層アーヤ",
            "text": "はあっ！？",
            "zh": "哈啊！？",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "532/TALK",
            "narrator": "表層アーヤ",
            "text": "あの私！\n一体どこまで……",
            "zh": "那个我！\n到底说到哪了……",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "536/TALK",
            "narrator": "表層アーヤ",
            "text": "とにかく。",
            "zh": "总而言之。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "537/TALK",
            "narrator": "表層アーヤ",
            "text": "今回はありがとう\nございました。",
            "zh": "这次真是\n非常感谢你。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "538/TALK",
            "narrator": "表層アーヤ",
            "text": "お陰で現実の私も\n少しは吹っ切ることが\nできそう。",
            "zh": "多亏了你，现实的我\n大概也能稍微\n想开一些了。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "539/SEL",
            "narrator": "（選択肢）",
            "text": "よかったね",
            "zh": "太好了呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "540/ACT",
            "narrator": "",
            "text": "よかったね",
            "zh": "太好了呢",
            "narrator_zh": ""
        },
        {
            "location": "542/TALK",
            "narrator": "表層アーヤ",
            "text": "それで、あの……",
            "zh": "然后，那个……",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "543/TALK",
            "narrator": "表層アーヤ",
            "text": "嫌じゃなければ\nまた何か今回みたいな\nことがあったら――",
            "zh": "如果不嫌弃的话，\n以后要是再遇到\n像这次这样的事——",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "544/TALK",
            "narrator": "表層アーヤ",
            "text": "サポートして\nもらえませんか！？",
            "zh": "能不能请你\n支援我呢！？",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "545/SEL",
            "narrator": "（選択肢）",
            "text": "もちろん！",
            "zh": "当然！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "546/SEL",
            "narrator": "（選択肢）",
            "text": "もう一人のアーヤと同じ事言ってるｗ",
            "zh": "和另一个绫水说一样的话哈哈",
            "narrator_zh": "（选项）"
        },
        {
            "location": "547/ACT",
            "narrator": "",
            "text": "もちろん！",
            "zh": "当然！",
            "narrator_zh": ""
        },
        {
            "location": "548/TALK",
            "narrator": "表層アーヤ",
            "text": "良かった。",
            "zh": "太好了。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "549/TALK",
            "narrator": "表層アーヤ",
            "text": "これからも\n宜しくお願いします。",
            "zh": "今后也请\n多多关照。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "550/ACT",
            "narrator": "",
            "text": "もう一人のアーヤと同じ事言ってるｗ",
            "zh": "和另一个绫水说一样的话哈哈",
            "narrator_zh": ""
        },
        {
            "location": "556/DIALOG",
            "narrator": "",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": ""
        },
        {
            "location": "561/TALK",
            "narrator": "表層アーヤ",
            "text": "え！？",
            "zh": "诶！？",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "562/SEL",
            "narrator": "（選択肢）",
            "text": "やっぱり同じアーヤなんだね",
            "zh": "果然是同一个绫水啊",
            "narrator_zh": "（选项）"
        },
        {
            "location": "563/ACT",
            "narrator": "",
            "text": "やっぱり同じアーヤなんだね",
            "zh": "果然是同一个绫水啊",
            "narrator_zh": ""
        },
        {
            "location": "565/TALK",
            "narrator": "表層アーヤ",
            "text": "……",
            "zh": "……",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "592/TALK",
            "narrator": "千羽鶴",
            "text": "おめでとう。",
            "zh": "恭喜你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "593/TALK",
            "narrator": "千羽鶴",
            "text": "あなたは彼女の\nココロの迷いを解消し、\n一歩前進させた。",
            "zh": "你解开了她\n心里的迷茫，\n让她往前走了一步。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "594/SEL",
            "narrator": "（選択肢）",
            "text": "えっへん",
            "zh": "嘿嘿",
            "narrator_zh": "（选项）"
        },
        {
            "location": "595/SEL",
            "narrator": "（選択肢）",
            "text": "あまり実感ない",
            "zh": "没什么实感",
            "narrator_zh": "（选项）"
        },
        {
            "location": "596/SEL",
            "narrator": "（選択肢）",
            "text": "本当にこれで良かったのだろうか",
            "zh": "这样真的好吗",
            "narrator_zh": "（选项）"
        },
        {
            "location": "597/ACT",
            "narrator": "",
            "text": "えっへん",
            "zh": "嘿嘿",
            "narrator_zh": ""
        },
        {
            "location": "598/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。\n今回ばかりは\n誇っていいと思う。",
            "zh": "是的。\n只有这一次，\n可以觉得骄傲。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "599/ACT",
            "narrator": "",
            "text": "あまり実感ない",
            "zh": "没什么实感",
            "narrator_zh": ""
        },
        {
            "location": "600/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。\nそう思うかも知れない。\nでも――",
            "zh": "是的。\n也许会这么想。\n但是——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "601/ACT",
            "narrator": "",
            "text": "本当にこれで良かったのだろうか",
            "zh": "这样真的好吗",
            "narrator_zh": ""
        },
        {
            "location": "603/TALK",
            "narrator": "千羽鶴",
            "text": "選択に絶対的な\n正解なんて最初から\n存在しない。",
            "zh": "选择从一开始\n就不存在绝对的\n正确答案。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "605/TALK",
            "narrator": "千羽鶴",
            "text": "汚い言い方をすれば、\n利己的な選択をし、\n結果が伴えば正解。",
            "zh": "说得难听一点，\n做出利己的选择，\n只要有了结果就是正确。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "606/TALK",
            "narrator": "千羽鶴",
            "text": "それは申し訳無いけど\n今はあなたも知らない\n私の思惑も含めて。",
            "zh": "这话很抱歉，\n其中也包括你现在还不知道的\n我的盘算。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "607/TALK",
            "narrator": "千羽鶴",
            "text": "一般的にも、ダメな\n選択をしたと思ったら\n物事が好転したり――",
            "zh": "一般说来，也会有\n觉得做了糟糕的选择，\n事情却好转的情况——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "608/TALK",
            "narrator": "千羽鶴",
            "text": "逆に順当な選択をした\nつもりが、後悔する\n結果になったりもする。",
            "zh": "反过来，本以为\n做了稳妥的选择，\n结果却会后悔。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "609/TALK",
            "narrator": "千羽鶴",
            "text": "大事なのは\n「自分はどうしたいか」",
            "zh": "重要的是\n“自己想怎样”",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "610/TALK",
            "narrator": "千羽鶴",
            "text": "周囲のノイズを遮断し\n自分で決めること。",
            "zh": "隔绝周围的噪音，\n由自己来决定。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "611/TALK",
            "narrator": "千羽鶴",
            "text": "私があなたにお願い\nしたいのは、あくまで\nそのサポートなの。",
            "zh": "我想请你做的，\n归根结底是\n这份支持。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "613/TALK",
            "narrator": "千羽鶴",
            "text": "人のココロを動かす\nには、いつも大きな\n力が必要とは限らない。",
            "zh": "打动人的心，\n并不总是需要\n很大的力量。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "614/TALK",
            "narrator": "千羽鶴",
            "text": "些細なきっかけを\n与えるだけで、整理が\nつくこともある。",
            "zh": "有时只给一个\n细小的契机，\n心里就能理清。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "615/TALK",
            "narrator": "千羽鶴",
            "text": "そうやって、逃げずに\n決めて、それを実行\nすることは――",
            "zh": "像这样，不逃避地\n做出决定，再去实行\n——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "616/TALK",
            "narrator": "千羽鶴",
            "text": "次第にココロを\n強くすることに繋がる。",
            "zh": "会渐渐让心\n变得坚强。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "617/SEL",
            "narrator": "（選択肢）",
            "text": "よくわからない",
            "zh": "不太明白",
            "narrator_zh": "（选项）"
        },
        {
            "location": "618/ACT",
            "narrator": "",
            "text": "よくわからない",
            "zh": "不太明白",
            "narrator_zh": ""
        },
        {
            "location": "620/TALK",
            "narrator": "千羽鶴",
            "text": "一気に理解は\n出来ないと思う。",
            "zh": "我想你没法\n一下子就理解。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "621/TALK",
            "narrator": "千羽鶴",
            "text": "とにかくあなたには、\nこれからもずっと、\n今回の様に――",
            "zh": "总之，希望你\n今后也一直，\n像这次这样——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "622/TALK",
            "narrator": "千羽鶴",
            "text": "彼女のココロの成長を\n支援してあげて欲しい。",
            "zh": "去支持她的心\n成长。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "626/TALK",
            "narrator": "潜在アーヤ",
            "text": "…っと。\nちょっと長くお話\nし過ぎちゃったかしら？",
            "zh": "……哎呀。\n是不是稍微聊得\n有点太久了呢？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "627/TALK",
            "narrator": "潜在アーヤ",
            "text": "$handle$さん。\n貴方とはまたいずれ、\nすぐに逢える気がします。",
            "zh": "$handle$。\n我有种预感，\n很快就会再和你见面。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "628/TALK",
            "narrator": "潜在アーヤ",
            "text": "私のラブラブ直感が\nそう伝えてるの。",
            "zh": "我的恋爱直觉\n是这么告诉我的。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "629/TALK",
            "narrator": "潜在アーヤ",
            "text": "またココロスフィアに\n遊びに来てね？",
            "zh": "下次还要再来\n心灵领域玩哦？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "630/TALK",
            "narrator": "潜在アーヤ",
            "text": "今度は今よりもっと、\n楽しいことしましょ？",
            "zh": "下一次，我们做比现在\n更开心的事吧？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "631/SEL",
            "narrator": "（選択肢）",
            "text": "楽しみにしてます！",
            "zh": "我很期待！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "632/SEL",
            "narrator": "（選択肢）",
            "text": "もういいかな",
            "zh": "我看算了吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "633/ACT",
            "narrator": "",
            "text": "楽しみにしてます！",
            "zh": "我很期待！",
            "narrator_zh": ""
        },
        {
            "location": "634/TALK",
            "narrator": "潜在アーヤ",
            "text": "私もよ？",
            "zh": "我也是哦？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "635/ACT",
            "narrator": "",
            "text": "もういいかな",
            "zh": "我看算了吧",
            "narrator_zh": ""
        },
        {
            "location": "636/TALK",
            "narrator": "潜在アーヤ",
            "text": "あらそう。\nそれは残念ね。",
            "zh": "哎呀这样。\n那真遗憾呢。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "637/TALK",
            "narrator": "潜在アーヤ",
            "text": "気が向いたら\nいつでも来て。\n扉は開けておくから。",
            "zh": "要是心血来潮了\n随时都可以来。\n大门一直为你敞开着。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "640/TALK",
            "narrator": "潜在アーヤ",
            "text": "それじゃ、またね。",
            "zh": "那么，回头见。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "664/TALK",
            "narrator": "千羽鶴",
            "text": "おめでとう。",
            "zh": "恭喜你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "665/TALK",
            "narrator": "千羽鶴",
            "text": "あなたは彼女の\nココロの迷いを解消し、\n一歩前進させた。",
            "zh": "你解开了她\n心里的迷茫，\n让她往前走了一步。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "666/SEL",
            "narrator": "（選択肢）",
            "text": "えっへん",
            "zh": "嘿嘿",
            "narrator_zh": "（选项）"
        },
        {
            "location": "667/SEL",
            "narrator": "（選択肢）",
            "text": "あまり実感ない",
            "zh": "没什么实感",
            "narrator_zh": "（选项）"
        },
        {
            "location": "668/SEL",
            "narrator": "（選択肢）",
            "text": "本当にこれで良かったのだろうか",
            "zh": "这样真的好吗",
            "narrator_zh": "（选项）"
        },
        {
            "location": "669/ACT",
            "narrator": "",
            "text": "えっへん",
            "zh": "嘿嘿",
            "narrator_zh": ""
        },
        {
            "location": "670/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。\n今回ばかりは\n誇っていいと思う。",
            "zh": "是的。\n只有这一次，\n可以觉得骄傲。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "671/ACT",
            "narrator": "",
            "text": "あまり実感ない",
            "zh": "没什么实感",
            "narrator_zh": ""
        },
        {
            "location": "672/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。\nそう思うかも知れない。\nでも――",
            "zh": "是的。\n也许会这么想。\n但是——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "673/ACT",
            "narrator": "",
            "text": "本当にこれで良かったのだろうか",
            "zh": "这样真的好吗",
            "narrator_zh": ""
        },
        {
            "location": "675/TALK",
            "narrator": "千羽鶴",
            "text": "選択に絶対的な\n正解なんて最初から\n存在しない。",
            "zh": "选择从一开始\n就不存在绝对的\n正确答案。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "677/TALK",
            "narrator": "千羽鶴",
            "text": "汚い言い方をすれば、\n利己的な選択をし、\n結果が伴えば正解。",
            "zh": "说得难听一点，\n做出利己的选择，\n只要有了结果就是正确。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "678/TALK",
            "narrator": "千羽鶴",
            "text": "それは申し訳無いけど\n今はあなたも知らない\n私の思惑も含めて。",
            "zh": "这话很抱歉，\n其中也包括你现在还不知道的\n我的盘算。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "679/TALK",
            "narrator": "千羽鶴",
            "text": "一般的にも、ダメな\n選択をしたと思ったら\n物事が好転したり――",
            "zh": "一般说来，也会有\n觉得做了糟糕的选择，\n事情却好转的情况——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "680/TALK",
            "narrator": "千羽鶴",
            "text": "逆に順当な選択をした\nつもりが、後悔する\n結果になったりもする。",
            "zh": "反过来，本以为\n做了稳妥的选择，\n结果却会后悔。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "681/TALK",
            "narrator": "千羽鶴",
            "text": "大事なのは\n「自分はどうしたいか」",
            "zh": "重要的是\n“自己想怎样”",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "682/TALK",
            "narrator": "千羽鶴",
            "text": "周囲のノイズを遮断し\n自分で決めること。",
            "zh": "隔绝周围的噪音，\n由自己来决定。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "683/TALK",
            "narrator": "千羽鶴",
            "text": "私があなたにお願い\nしたいのは、あくまで\nそのサポートなの。",
            "zh": "我想请你做的，\n归根结底是\n这份支持。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "685/TALK",
            "narrator": "千羽鶴",
            "text": "人のココロを動かす\nには、いつも大きな\n力が必要とは限らない。",
            "zh": "打动人的心，\n并不总是需要\n很大的力量。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "686/TALK",
            "narrator": "千羽鶴",
            "text": "些細なきっかけを\n与えるだけで、整理が\nつくこともある。",
            "zh": "有时只给一个\n细小的契机，\n心里就能理清。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "687/TALK",
            "narrator": "千羽鶴",
            "text": "そうやって、逃げずに\n決めて、それを実行\nすることは――",
            "zh": "像这样，不逃避地\n做出决定，再去实行\n——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "688/TALK",
            "narrator": "千羽鶴",
            "text": "次第にココロを\n強くすることに繋がる。",
            "zh": "会渐渐让心\n变得坚强。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "689/SEL",
            "narrator": "（選択肢）",
            "text": "よくわからない",
            "zh": "不太明白",
            "narrator_zh": "（选项）"
        },
        {
            "location": "690/ACT",
            "narrator": "",
            "text": "よくわからない",
            "zh": "不太明白",
            "narrator_zh": ""
        },
        {
            "location": "692/TALK",
            "narrator": "千羽鶴",
            "text": "一気に理解は\n出来ないと思う。",
            "zh": "我想你没法\n一下子就理解。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "693/TALK",
            "narrator": "千羽鶴",
            "text": "とにかくあなたには、\nこれからもずっと、\n今回の様に――",
            "zh": "总之，希望你\n今后也一直，\n像这次这样——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "694/TALK",
            "narrator": "千羽鶴",
            "text": "彼女のココロの成長を\n支援してあげて欲しい。",
            "zh": "去支持她的心\n成长。",
            "narrator_zh": "千羽鹤"
        }
    ]
}
