            "narrator": "みやび",
            "text": "喜べ",
            "zh": "高兴吧",
            "narrator_zh": "雅"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "帯を取ってきた",
            "zh": "腰带买回来了",
            "narrator_zh": "雅"
        },
        {
            "location": "36/SEL",
            "narrator": "",
            "text": "わーい",
            "zh": "哇——",
            "narrator_zh": ""
        },
        {
            "location": "37/SEL",
            "narrator": "",
            "text": "なんで",
            "zh": "为什么",
            "narrator_zh": ""
        },
        {
            "location": "38/SEL",
            "narrator": "",
            "text": "あーれークルクルクルクル",
            "zh": "啊——咧转圈圈圈圈",
            "narrator_zh": ""
        },
        {
            "location": "39/ACT",
            "narrator": "",
            "text": "わーい",
            "zh": "哇——",
            "narrator_zh": ""
        },
        {
            "location": "40/TALK",
            "narrator": "みやび",
            "text": "迎合",
            "zh": "这算是在哄我",
            "narrator_zh": "雅"
        },
        {
            "location": "41/TALK",
            "narrator": "みやび",
            "text": "潔しとせず",
            "zh": "我才不甘心",
            "narrator_zh": "雅"
        },
        {
            "location": "42/ACT",
            "narrator": "",
            "text": "なんで",
            "zh": "为什么",
            "narrator_zh": ""
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "なんか",
            "zh": "怎么说呢",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "気分で",
            "zh": "就凭心情呗",
            "narrator_zh": "雅"
        },
        {
            "location": "46/ACT",
            "narrator": "",
            "text": "あーれークルクルクルクル",
            "zh": "啊——咧转圈圈圈圈",
            "narrator_zh": ""
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "時代劇で町娘がお代官様にアレされるアレか",
            "zh": "是时代剧里町娘被代官大人“那样”的那种桥段吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "その提案は",
            "zh": "你这提议",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "魅力的だが",
            "zh": "确实诱人",
            "narrator_zh": "雅"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "あれはファンタジーだ",
            "zh": "但那终归是幻想",
            "narrator_zh": "雅"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "そんなわけで",
            "zh": "所以呢",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "アーヤと行ってきたわけだが",
            "zh": "就和绫水去了一趟",
            "narrator_zh": "雅"
        },
        {
            "location": "66/SEL",
            "narrator": "",
            "text": "アーヤ、喜んでた？",
            "zh": "绫水开心吗？",
            "narrator_zh": ""
        },
        {
            "location": "67/SEL",
            "narrator": "",
            "text": "帯はどうだった？",
            "zh": "腰带怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "68/SEL",
            "narrator": "",
            "text": "試着してた？",
            "zh": "有试穿吗？",
            "narrator_zh": ""
        },
        {
            "location": "69/ACT",
            "narrator": "",
            "text": "アーヤ、喜んでた？",
            "zh": "绫水开心吗？",
            "narrator_zh": ""
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "うむ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "意外なほどに",
            "zh": "出乎意料地",
            "narrator_zh": "雅"
        },
        {
            "location": "72/TALK",
            "narrator": "みやび",
            "text": "なんでも",
            "zh": "什么都",
            "narrator_zh": "雅"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "凄い、綺麗、素敵、可愛い、らしい",
            "zh": "好厉害、好漂亮、好美、好可爱——据说是这样",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "当然だがな",
            "zh": "当然的咯",
            "narrator_zh": "雅"
        },
        {
            "location": "77/ACT",
            "narrator": "",
            "text": "帯はどうだった？",
            "zh": "腰带怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "最高",
            "zh": "最棒",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "しかし",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "ひとつ問題が",
            "zh": "有个问题",
            "narrator_zh": "雅"
        },
        {
            "location": "82/TALK",
            "narrator": "みやび",
            "text": "最高の帯には",
            "zh": "最好的腰带",
            "narrator_zh": "雅"
        },
        {
            "location": "83/TALK",
            "narrator": "みやび",
            "text": "最高の着物",
            "zh": "就要配最好的和服",
            "narrator_zh": "雅"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "それが世の理",
            "zh": "此乃世间的道理",
            "narrator_zh": "雅"
        },
        {
            "location": "86/TALK",
            "narrator": "みやび",
            "text": "だが",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "資金不足！",
            "zh": "资金不足！",
            "narrator_zh": "雅"
        },
        {
            "location": "90/ACT",
            "narrator": "",
            "text": "試着してた？",
            "zh": "有试穿吗？",
            "narrator_zh": ""
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "あ？",
            "zh": "哈？",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "アーヤがか？",
            "zh": "你是说绫水？",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "反物を当てるくらいはしたぞ",
            "zh": "拿料子比样倒是做过了咧",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "仕立て上がりなら安いのもあると言ったんだが",
            "zh": "我说过成品的话也有便宜的来着",
            "narrator_zh": "雅"
        },
        {
            "location": "95/TALK",
            "narrator": "みやび",
            "text": "色々と面倒だからそれはいいだと",
            "zh": "结果她来了句“太麻烦，不用了”",
            "narrator_zh": "雅"
        },
        {
            "location": "97/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "不过嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "着物でバイクは乗れんしね",
            "zh": "穿和服也没法骑摩托嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "52/DIALOG",
            "narrator": "Dialog_GETGokigen",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": "Dialog_GETGokigen"
        }
    ]
}
