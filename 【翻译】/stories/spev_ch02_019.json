        "title": "【期間限定】誕生日イベント",
        "sub_title": "アーヤの誕生日",
        "title_zh": "【期间限定】生日活动",
        "sub_title_zh": "绫水的生日"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "アーヤの誕生日（復元）",
            "zh": "绫水的生日（复原）",
            "narrator_zh": ""
        },
        {
            "location": "20/TALK",
            "narrator": "アーヤ",
            "text": "あら？\nなにかしら…。",
            "zh": "哎呀？\n是什么呢……",
            "narrator_zh": "绫水"
        },
        {
            "location": "21/SEL",
            "narrator": "",
            "text": "お誕生日おめでとう！",
            "zh": "生日快乐！",
            "narrator_zh": ""
        },
        {
            "location": "22/ACT",
            "narrator": "",
            "text": "お誕生日おめでとう！",
            "zh": "生日快乐！",
            "narrator_zh": ""
        },
        {
            "location": "25/TALK",
            "narrator": "アーヤ",
            "text": "あっ、そっか！\n９月１４日って\n私の誕生日だったわね。",
            "zh": "啊，对了！\n9月14日\n是我的生日。",
            "narrator_zh": "绫水"
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう、\n$handle$。",
            "zh": "谢谢，\n$handle$。",
            "narrator_zh": "绫水"
        },
        {
            "location": "27/SEL",
            "narrator": "",
            "text": "プレゼントあるよ",
            "zh": "有礼物哦",
            "narrator_zh": ""
        },
        {
            "location": "28/ACT",
            "narrator": "",
            "text": "プレゼントあるよ",
            "zh": "有礼物哦",
            "narrator_zh": ""
        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "何が入ってるの\nかしら？",
            "zh": "里面装了\n什么呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/SEL",
            "narrator": "",
            "text": "開けてみて！",
            "zh": "打开看看！",
            "narrator_zh": ""
        },
        {
            "location": "34/ACT",
            "narrator": "",
            "text": "開けてみて！",
            "zh": "打开看看！",
            "narrator_zh": ""
        },
        {
            "location": "44/DIALOG",
            "narrator": "",
            "text": "アーヤのコスチューム\n<size=40><color=red><b>SKY－WIND</b></color></size>\nをゲットしました！",
            "zh": "绫水的服装\n<size=40><color=red><b>SKY－WIND</b></color></size>\n获得了！",
            "narrator_zh": ""
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "大切にするわ。\n本当にありがとう。",
            "zh": "我会珍惜的。\n真的谢谢你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/DIALOG",
            "narrator": "",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已连接。\n\n点击画面，向对方\n传达感觉吧。",
            "narrator_zh": ""
        },
        {
            "location": "74/DIALOG",
            "narrator": "",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已断开。",
            "narrator_zh": ""
        },
        {
            "location": "75/SEL",
            "narrator": "",
            "text": "そう言ってもらえると嬉しい",
            "zh": "你这么说，我很高兴",
            "narrator_zh": ""
        },
        {
            "location": "76/SEL",
            "narrator": "",
            "text": "じゃあ、もっと触っちゃおう！",
            "zh": "那我就再多摸一会儿！",
            "narrator_zh": ""
        },
        {
            "location": "77/ACT",
            "narrator": "",
            "text": "そう言ってもらえると嬉しい",
            "zh": "你这么说，我很高兴",
            "narrator_zh": ""
        },
        {
            "location": "78/ACT",
            "narrator": "",
            "text": "じゃあ、もっと触っちゃおう！",
            "zh": "那我就再多摸一会儿！",
            "narrator_zh": ""
        },
        {
            "location": "80/TALK",
            "narrator": "アーヤ",
            "text": "これからも末永く、\n私の隣にいてくださいね？",
            "zh": "今后也一直，\n留在我身边，好吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/DIALOG",
            "narrator": "",
            "text": "コスチューム\n<color=green>【SKY－WIND】</color>は、\n夜時間にパジャマとして\n着せることができます。",
            "zh": "服装\n<color=green>【SKY－WIND】</color>，\n可以在夜间作为睡衣\n给她穿上。",
            "narrator_zh": ""
        }
    ]
