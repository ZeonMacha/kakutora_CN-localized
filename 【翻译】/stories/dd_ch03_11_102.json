{
    "dir": "chap11/daydra/dd_ch03_11_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "11305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "ガブちゃん先輩＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "加布前辈＜后篇＞"
    },
    "entry": [
        {
            "location": "346/SCENARIO",
            "narrator": "",
            "text": "ガブちゃん先輩",
            "zh": "加布前辈",
            "narrator_zh": ""
        },
        {
            "location": "367/TALK",
            "narrator": "ガブリエラ",
            "text": "…そっか。\nそうよね。",
            "zh": "…这样啊。\n是这么回事呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "368/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの気持ちの\n問題だったわ。",
            "zh": "一直都是我自己的\n心态问题呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "369/TALK",
            "narrator": "ガブリエラ",
            "text": "今日こそは、ちゃんと\nつばめに言わなくちゃ…。",
            "zh": "今天无论如何，都得\n好好跟燕说清楚才行…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "370/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "371/TALK",
            "narrator": "つばめ",
            "text": "…え、えっと――",
            "zh": "…那、那个——",
            "narrator_zh": "燕"
        },
        {
            "location": "373/TALK",
            "narrator": "つばめ",
            "text": "あ、そういえば、\n今って忙しかったん\nですよね？",
            "zh": "啊，说起来，\n你现在正忙着\n对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "375/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、ええ…。\n夜食にプラツキを\n作ろうと思ったのよ。",
            "zh": "啊、嗯…。\n我原本打算做点\n普拉茨基当夜宵的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "376/TALK",
            "narrator": "つばめ",
            "text": "ぷらつき？",
            "zh": "普拉茨基？",
            "narrator_zh": "燕"
        },
        {
            "location": "378/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、知らなくて\n当然よね。",
            "zh": "…嘛，不知道也很\n正常啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "379/TALK",
            "narrator": "ガブリエラ",
            "text": "簡単に言うと、\nお芋を潰して作る\nパンケーキで――",
            "zh": "简单来说，\n就是把土豆捣碎后\n做成的煎饼——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "380/TALK",
            "narrator": "ガブリエラ",
            "text": "ポーランドでは\n一般的な料理なのよ。",
            "zh": "在波兰是\n很家常的一道料理哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "382/TALK",
            "narrator": "つばめ",
            "text": "ふーん…ポーランド\n料理って、食べたこと\nないかも…。",
            "zh": "这样啊…波兰\n料理，我好像还从来\n没吃过呢…。",
            "narrator_zh": "燕"
        },
        {
            "location": "385/TALK",
            "narrator": "ガブリエラ",
            "text": "…食べたいの？",
            "zh": "…你想吃吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "389/TALK",
            "narrator": "つばめ",
            "text": "えへへ…美味しそう\nだから、食べてみたい\nなぁ…。",
            "zh": "嘿嘿…听起来好好吃，\n真想尝尝看\n呀…。",
            "narrator_zh": "燕"
        },
        {
            "location": "391/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぅ…どうにか\n元気出たみたいね…。",
            "zh": "呼…总算是\n打起精神来了呢…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "393/TALK",
            "narrator": "ガブリエラ",
            "text": "…なら、あんたも\n作るの手伝いなさい。",
            "zh": "…那就，你也一起\n过来帮忙做吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "394/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたのせいで、\nお芋すり潰すのが\n中断したんだから。",
            "zh": "都怪你，\n害我捣土豆泥的活儿\n中途停下来了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "397/TALK",
            "narrator": "つばめ",
            "text": "いいの！？",
            "zh": "可以吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "399/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ…あたしも、\nちょっと話したい\nことが――",
            "zh": "嗯…我正好也有点\n想跟你说\n的话——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "401/TALK",
            "narrator": "つばめ",
            "text": "？",
            "zh": "？",
            "narrator_zh": "燕"
        },
        {
            "location": "403/TALK",
            "narrator": "ガブリエラ",
            "text": "な、何でもない！\nほら、さっさと\n作り始めるわよ！",
            "zh": "没、没什么！\n好啦，赶紧动手\n做起来吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "426/TALK",
            "narrator": "つばめ",
            "text": "ううう…て、手が、\nジンジンしてきた\nよぉ…。",
            "zh": "呜呜呜…手、手腕\n都开始发酸发麻\n啦…。",
            "narrator_zh": "燕"
        },
        {
            "location": "428/TALK",
            "narrator": "ガブリエラ",
            "text": "プラツキは作るのが\n大変な料理なのよ。",
            "zh": "普拉茨基本来就是\n做起来很费劲的料理嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "429/TALK",
            "narrator": "ガブリエラ",
            "text": "美味しいプラツキが\n食べたいなら、\n我慢しなさい。",
            "zh": "要是想吃美味的\n普拉茨基，\n就给我忍着点。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "431/TALK",
            "narrator": "つばめ",
            "text": "は、はい…。",
            "zh": "是、是的…。",
            "narrator_zh": "燕"
        },
        {
            "location": "436/TALK",
            "narrator": "ガブリエラ",
            "text": "…どうしようかしら。",
            "zh": "…该怎么办才好呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "437/TALK",
            "narrator": "ガブリエラ",
            "text": "あのこと、言うなら\n今がベストだと\n思うけど――",
            "zh": "要说那件事的话，\n我觉得现在正是\n最好不过的时机——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "439/TALK",
            "narrator": "ガブリエラ",
            "text": "らしくない、とか\n思われるかしら？",
            "zh": "会不会被她觉得\n“真不像你的风格”啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "441/TALK",
            "narrator": "ガブリエラ",
            "text": "でも…いつまでも\nこのままなのは\n嫌だし…。",
            "zh": "可是…一直这样\n僵持下去的话，\n我也讨厌啊…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "442/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "457/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナ、聞いてほしいことがあるの",
            "zh": "玛尔赞娜，我有件事想跟你说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "458/TALK",
            "narrator": "ガブリエラ",
            "text": "私ね",
            "zh": "我啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "460/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめに、もうせんぱいって呼ばなくていい、って伝えたいの",
            "zh": "想告诉燕，以后不用再叫我前辈了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "462/SEL",
            "narrator": "",
            "text": "いいことだと思う",
            "zh": "我觉得这样很好啊",
            "narrator_zh": ""
        },
        {
            "location": "463/ACT",
            "narrator": "",
            "text": "いいことだと思う",
            "zh": "我觉得这样很好啊",
            "narrator_zh": ""
        },
        {
            "location": "465/TALK",
            "narrator": "ガブリエラ",
            "text": "そう思ってくれるのね//////",
            "zh": "你也这么觉得对吧//////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "467/TALK",
            "narrator": "ガブリエラ",
            "text": "けど、今までつばめにはキツく当たってたでしょう？",
            "zh": "可是，我以前一直对燕那么凶吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "468/TALK",
            "narrator": "ガブリエラ",
            "text": "なのに、今更せんぱいって呼ばなくていいとか",
            "zh": "现在才突然说不用再叫前辈了什么的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "469/TALK",
            "narrator": "ガブリエラ",
            "text": "友達になりたいとか言って、大丈夫なのかしら…",
            "zh": "或者说想和她做朋友，真的没问题吗…",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "471/SEL",
            "narrator": "",
            "text": "つばめが嫌がると思う？",
            "zh": "你觉得燕会讨厌吗？",
            "narrator_zh": ""
        },
        {
            "location": "472/ACT",
            "narrator": "",
            "text": "つばめが嫌がると思う？",
            "zh": "你觉得燕会讨厌吗？",
            "narrator_zh": ""
        },
        {
            "location": "474/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、そうよね",
            "zh": "啊，说得也是呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "475/TALK",
            "narrator": "ガブリエラ",
            "text": "それ絶対ありえないわ",
            "zh": "那种事绝对不可能发生嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "476/TALK",
            "narrator": "ガブリエラ",
            "text": "だって、つばめだものね",
            "zh": "毕竟那可是燕呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "478/TALK",
            "narrator": "ガブリエラ",
            "text": "今の一言で、すごく心が軽くなった気がするわ",
            "zh": "听你这么一说，心里一下子轻松了好多呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "479/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、マルザンナは頼りになる執事ね",
            "zh": "果然，玛尔赞娜真是位靠得住的管家呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "492/TALK",
            "narrator": "ガブリエラ",
            "text": "…手を動かしながら\n聞いてちょうだい。",
            "zh": "…手别停，边干活\n边听我说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "494/TALK",
            "narrator": "つばめ",
            "text": "はい、なんですか？",
            "zh": "好的，什么事呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "495/TALK",
            "narrator": "ガブリエラ",
            "text": "…もう、あたしのこと\n先輩って呼ばなくて\nいいから。",
            "zh": "…以后，你不用再\n叫我“前辈”\n了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "498/TALK",
            "narrator": "つばめ",
            "text": "え？　それじゃ、\n何て呼べばいいん\nですか？",
            "zh": "咦？　那这样的话，\n我该怎么称呼你\n才好呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "499/TALK",
            "narrator": "ガブリエラ",
            "text": "…あんたが呼びたい\nように呼べば？",
            "zh": "…你想怎么叫\n就怎么叫呗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "500/TALK",
            "narrator": "ガブリエラ",
            "text": "あと、敬語で\n話すのもやめていいわ。",
            "zh": "还有，用敬语\n跟我说话也可以免了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "501/TALK",
            "narrator": "ガブリエラ",
            "text": "それと――",
            "zh": "另外还有——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "504/TALK",
            "narrator": "ガブリエラ",
            "text": "ごめんね。\n今まで意地張って、\n辛く当たっちゃって。",
            "zh": "对不起。\n至今为止一直死鸭子嘴硬，\n对你那么冷淡刻薄。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "507/TALK",
            "narrator": "ガブリエラ",
            "text": "なんか…悔しかった\nのよね…色々と…。",
            "zh": "总觉得…我心里很不甘呢…\n各种各样的事都是…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "509/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの幸せを全部、\n根こそぎ奪われちゃう\n気がして――",
            "zh": "总觉得我所有的幸福，\n全都要被你连根夺走\n似的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "510/TALK",
            "narrator": "ガブリエラ",
            "text": "すごく怖かったの…。",
            "zh": "让我觉得好害怕…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "512/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤも、神楽も、\nみやびも、あんたの\n味方ばっかして――",
            "zh": "绫水也好、神乐也好、\n雅也好，全都只帮着\n你说话——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "513/TALK",
            "narrator": "ガブリエラ",
            "text": "誰も、あんたの謎の\n力を警戒しないし。",
            "zh": "谁都不肯去警惕\n你身上那股莫名其妙的力量。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "515/TALK",
            "narrator": "ガブリエラ",
            "text": "でもあたしは、\nあんたのその謎の\n力と――",
            "zh": "可是我啊，\n对你那股莫名其妙的\n力量——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "516/TALK",
            "narrator": "ガブリエラ",
            "text": "その時に出てくる\n別人みたいな顔が、\nずっと怖かった。",
            "zh": "还有那个时候会露出的\n判若两人的表情，\n一直都很害怕。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "517/TALK",
            "narrator": "ガブリエラ",
            "text": "いつかあたし達を\n壊しちゃうんじゃ\nないか、って…。",
            "zh": "总怕说不定哪天，\n你会把我们全都\n毁掉…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "520/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、あんたが\n入隊するのに\nずっと反対だったの。",
            "zh": "所以，我才会一直\n反对你\n入队。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "521/TALK",
            "narrator": "つばめ",
            "text": "せんぱい…。",
            "zh": "前辈…。",
            "narrator_zh": "燕"
        },
        {
            "location": "524/TALK",
            "narrator": "ガブリエラ",
            "text": "でもあんたさ、\nそんな性格でしょ？",
            "zh": "可你呀，\n偏偏又是那种性格对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "526/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしがどんだけ\n拒否っても――",
            "zh": "不管我怎么\n抗拒你——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "527/TALK",
            "narrator": "ガブリエラ",
            "text": "お構いなしでズケズケ\n入り込んでくるし。",
            "zh": "你都丝毫不在意地\n径直闯进我心里来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "529/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなんじゃ、\nどんなに嫌いになろう\nとしたって――",
            "zh": "被你这么一折腾，\n我再怎么想方设法去\n讨厌你——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "531/TALK",
            "narrator": "ガブリエラ",
            "text": "本気で嫌いになれる\nわけ…ないじゃん。",
            "zh": "也根本不可能真的\n讨厌得起来…嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "532/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "534/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、手が止まってる\nわよ。",
            "zh": "喂，手又停下来\n了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "537/TALK",
            "narrator": "つばめ",
            "text": "はわわ！",
            "zh": "哈哇哇！",
            "narrator_zh": "燕"
        },
        {
            "location": "539/TALK",
            "narrator": "ガブリエラ",
            "text": "…だからあたし、\n決めたのよ。",
            "zh": "…所以我啊，\n决定了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "541/TALK",
            "narrator": "ガブリエラ",
            "text": "もっと楽になろう\nって。",
            "zh": "决定让自己活得\n更轻松一点。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "542/TALK",
            "narrator": "ガブリエラ",
            "text": "このままじゃ、いつか\n本当に頭がおかしく\nなっちゃいそうだし。",
            "zh": "照这样下去，迟早\n有一天我真的会\n憋疯掉的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "544/TALK",
            "narrator": "ガブリエラ",
            "text": "正直言うとさ、\nまだあんたのことは\n怖い。",
            "zh": "说老实话，\n我现在还是有点\n怕你。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "545/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしもいつか、\nあんたにクランを\n引き抜かれて――",
            "zh": "我也会担心，\n说不定哪天会被你\n把库兰硬生生抽走——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "546/TALK",
            "narrator": "ガブリエラ",
            "text": "潰されちゃう日が\n来るんじゃないか、\nって不安だし…。",
            "zh": "落得个被彻底击垮的\n下场，心里还是\n挺不安的…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "547/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "549/TALK",
            "narrator": "ガブリエラ",
            "text": "けど、もしそんな\nことになったら――",
            "zh": "不过，要是真到了\n那种地步——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "551/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしが容赦なく\n張り倒して止めれば\nいい、って思ったの。",
            "zh": "我就毫不留情地\n把你扇趴下拦住你，\n我这么想通了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "552/TALK",
            "narrator": "ガブリエラ",
            "text": "その方がきっと、\n今よりずっとラクに\nなれるもの。",
            "zh": "那样的话肯定\n能比现在活得\n轻松得多嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "554/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "557/TALK",
            "narrator": "つばめ",
            "text": "…嬉しいです、\nせんぱい。",
            "zh": "…我好开心，\n前辈。",
            "narrator_zh": "燕"
        },
        {
            "location": "560/TALK",
            "narrator": "つばめ",
            "text": "じゃなくて…、\nガブちゃん、って\n呼んでいい？",
            "zh": "不对…、\n我可以叫你“加布”\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "564/TALK",
            "narrator": "ガブリエラ",
            "text": "べ、別に…呼びたい\nように呼んでいいわ。",
            "zh": "倒、倒也无所谓…你想\n怎么叫就怎么叫吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "565/TALK",
            "narrator": "つばめ",
            "text": "えへへ…ありがと。\nそれじゃ…、\nガブちゃん。",
            "zh": "嘿嘿…谢谢。\n那么…、\n加布。",
            "narrator_zh": "燕"
        },
        {
            "location": "567/TALK",
            "narrator": "つばめ",
            "text": "わたしも自分の力の\nこと、もっとちゃんと\n調べるね。",
            "zh": "我自己也会更认真地\n去查清楚我这股\n力量的事情哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "568/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんや\nみんなに、心配を\nかけないように。",
            "zh": "为了不再让加布\n还有大家为我\n担心。",
            "narrator_zh": "燕"
        },
        {
            "location": "569/TALK",
            "narrator": "つばめ",
            "text": "あと、ガブちゃんに\nお願いしたいことが\nあるの。",
            "zh": "还有，我有一件事\n想拜托\n加布。",
            "narrator_zh": "燕"
        },
        {
            "location": "570/TALK",
            "narrator": "つばめ",
            "text": "もしまた、ドーム戦の\n時みたいなことを\nやろうとしたら――",
            "zh": "要是我以后又做出\n像穹顶战那时候\n一样的事——",
            "narrator_zh": "燕"
        },
        {
            "location": "571/TALK",
            "narrator": "つばめ",
            "text": "本当に、本気で\nわたしを止めて\nほしいんだ。",
            "zh": "真的，请你务必\n拼尽全力地\n阻止我。",
            "narrator_zh": "燕"
        },
        {
            "location": "573/TALK",
            "narrator": "つばめ",
            "text": "ドーム戦でわたしが\n壊しちゃった子の\nこと――",
            "zh": "穹顶战时被我\n毁掉的那个女孩子的\n事——",
            "narrator_zh": "燕"
        },
        {
            "location": "575/TALK",
            "narrator": "つばめ",
            "text": "全然思い出せないん\nだけど、だからこそ、\n今でもすごく辛いの。",
            "zh": "我虽然完全想不起来，\n但也正因如此，\n直到现在心里都好难受。",
            "narrator_zh": "燕"
        },
        {
            "location": "577/TALK",
            "narrator": "つばめ",
            "text": "もう二度と、\nあんな思いしたく\nないから…。",
            "zh": "我再也不想\n体会那种痛苦\n了…。",
            "narrator_zh": "燕"
        },
        {
            "location": "581/TALK",
            "narrator": "ガブリエラ",
            "text": "…わかったわ。\nそういうことなら\n任せて。",
            "zh": "…我知道了。\n既然你这么说，\n就包在我身上吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "583/TALK",
            "narrator": "ガブリエラ",
            "text": "おもいっきり\nぶん殴って、\n止めてやるから！",
            "zh": "我会卯足全劲\n狠狠揍醒你、\n拦住你的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "585/TALK",
            "narrator": "つばめ",
            "text": "えへへ、お手柔らかに\nお願いします。",
            "zh": "嘿嘿，那就请手下\n留情啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "588/TALK",
            "narrator": "ガブリエラ",
            "text": "考えておくわ。",
            "zh": "我会考虑看看的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "590/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、\nあんた芋潰し過ぎ！",
            "zh": "话说回来，\n你把土豆捣得太碎了吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "594/TALK",
            "narrator": "つばめ",
            "text": "えっ…あっ！",
            "zh": "咦…啊！",
            "narrator_zh": "燕"
        },
        {
            "location": "597/TALK",
            "narrator": "つばめ",
            "text": "えへへ、\nごめんなさい。",
            "zh": "嘿嘿，\n对不起啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "600/TALK",
            "narrator": "ガブリエラ",
            "text": "本当、何やっても\nドジなんだから…。",
            "zh": "真是的，不管做什么\n都这么冒冒失失的…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "611/DIALOG",
            "narrator": "Dialog_chapter_ch03",
            "text": "【09 パーフェクトイエロー】",
            "zh": "【09 完美黄】",
            "narrator_zh": "Dialog_chapter_ch03"
        }
    ]
}
