{
 "dir": "chap11/daydra/dd_ch01_11_101.js",
 "type": "MainStory",
 "info": {
  "story_id": "11102",
  "cid": "tsubame",
  "title": "002 メインストーリー",
  "sub_title": "親離れ子離れ＜前編＞",
  "title_zh": "002 主线剧情",
  "sub_title_zh": "父母放手，孩子离巢＜前篇＞"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "親離れ子離れ",
   "zh": "父母放手，孩子离巢",
   "narrator_zh": ""
  },
  {
   "location": "22/TALK",
   "narrator": "つばめ",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "燕"
  },
  {
   "location": "23/TALK",
   "narrator": "啓介",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "启介"
  },
  {
   "location": "25/TALK",
   "narrator": "つばめ",
   "text": "…大変なことに\nなっちゃったなぁ…。",
   "zh": "……变成不得了的事\n了呀……",
   "narrator_zh": "燕"
  },
  {
   "location": "56/TALK",
   "narrator": "つばめ",
   "text": "ふぅ…変だなぁ。\nちゃんと掃除してる\nのに――",
   "zh": "呼……好奇怪呀。\n我明明有好好\n打扫——",
   "narrator_zh": "燕"
  },
  {
   "location": "57/TALK",
   "narrator": "つばめ",
   "text": "どうしていつも、\nこんなに散らかって\nるんだろ…。",
   "zh": "为什么总是，\n乱成\n这样呀……",
   "narrator_zh": "燕"
  },
  {
   "location": "60/TALK",
   "narrator": "ガブリエラ",
   "text": "あっ、いたいた。",
   "zh": "啊，在这儿在这儿。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "62/TALK",
   "narrator": "ガブリエラ",
   "text": "アーヤ、こっちよー！",
   "zh": "绫水，这边哦——！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "66/TALK",
   "narrator": "アーヤ",
   "text": "よかった…。\nつばめ、あなたに\nお客さんよ。",
   "zh": "太好了……\n燕，有客人\n找你。",
   "narrator_zh": "绫水"
  },
  {
   "location": "68/TALK",
   "narrator": "つばめ",
   "text": "わたしに？\n誰ですか？",
   "zh": "找我？\n是谁？",
   "narrator_zh": "燕"
  },
  {
   "location": "77/TALK",
   "narrator": "啓介",
   "text": "つばめ。",
   "zh": "燕。",
   "narrator_zh": "启介"
  },
  {
   "location": "79/TALK",
   "narrator": "つばめ",
   "text": "……えっ。",
   "zh": "……欸。",
   "narrator_zh": "燕"
  },
  {
   "location": "81/TALK",
   "narrator": "つばめ",
   "text": "えぇーっ！？",
   "zh": "诶——！？",
   "narrator_zh": "燕"
  },
  {
   "location": "82/TALK",
   "narrator": "つばめ",
   "text": "お、お父さん！！\nなんで！？",
   "zh": "爸、爸爸！！\n为什么！？",
   "narrator_zh": "燕"
  },
  {
   "location": "83/TALK",
   "narrator": "啓介",
   "text": "何でじゃないだろう！",
   "zh": "什么叫为什么！",
   "narrator_zh": "启介"
  },
  {
   "location": "84/TALK",
   "narrator": "啓介",
   "text": "帰ると言っておき\nながら、全然帰って\nきやせんし――",
   "zh": "说了要回来，\n结果根本\n没回来——",
   "narrator_zh": "启介"
  },
  {
   "location": "85/TALK",
   "narrator": "啓介",
   "text": "最近じゃ、\n連絡もよこさんで！",
   "zh": "最近连\n消息都不捎一个！",
   "narrator_zh": "启介"
  },
  {
   "location": "86/TALK",
   "narrator": "つばめ",
   "text": "しょ、しょーがない\nでしょ！？",
   "zh": "那、那有什么办法\n嘛！？",
   "narrator_zh": "燕"
  },
  {
   "location": "87/TALK",
   "narrator": "つばめ",
   "text": "何度か帰ろうかとは\n思ったけど――",
   "zh": "有好几次想回去\n来着——",
   "narrator_zh": "燕"
  },
  {
   "location": "88/TALK",
   "narrator": "つばめ",
   "text": "色々あって、\nダメになっちゃったん\nだから。",
   "zh": "出了好多事，\n就没能\n成。",
   "narrator_zh": "燕"
  },
  {
   "location": "89/TALK",
   "narrator": "啓介",
   "text": "ちゃんと帰ると\n約束だっただろう！\nいい加減にしろ！",
   "zh": "说好了会好好回来的吧！\n差不多\n一点！",
   "narrator_zh": "启介"
  },
  {
   "location": "91/TALK",
   "narrator": "つばめ",
   "text": "だから、帰れるときに\n帰るつもりだったん\nだってば！",
   "zh": "所以我说，能回的时候\n我是打算回的\n呀！",
   "narrator_zh": "燕"
  },
  {
   "location": "92/TALK",
   "narrator": "ガブリエラ",
   "text": "…ねえ、アーヤ。\n今のつばめって――",
   "zh": "……呐，绫水。\n现在的燕——",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "93/TALK",
   "narrator": "ガブリエラ",
   "text": "いつもと様子が\n違わない？",
   "zh": "和平时样子\n不一样吧？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "95/TALK",
   "narrator": "アーヤ",
   "text": "だ、ダメよ。\nここでそういうこと\n言わないの。",
   "zh": "不、不行。\n这种话别在\n这儿说。",
   "narrator_zh": "绫水"
  },
  {
   "location": "97/TALK",
   "narrator": "つばめ",
   "text": "ううっ…、\n恥ずかしいとこ\n見られてる…。",
   "zh": "呜呜……\n丢脸的样子\n被看见了……",
   "narrator_zh": "燕"
  },
  {
   "location": "99/TALK",
   "narrator": "つばめ",
   "text": "と、とにかく！\n今はお仕事中なの！",
   "zh": "总、总之！\n现在正在工作！",
   "narrator_zh": "燕"
  },
  {
   "location": "100/TALK",
   "narrator": "つばめ",
   "text": "みんなもいるから、\n話は後でわたしの\n部屋で――",
   "zh": "大家也在，\n话以后到我\n房间里说——",
   "narrator_zh": "燕"
  },
  {
   "location": "101/TALK",
   "narrator": "真幌",
   "text": "あー、ったく！",
   "zh": "啊，真是的！",
   "narrator_zh": "真幌"
  },
  {
   "location": "106/TALK",
   "narrator": "真幌",
   "text": "うっさいなぁ。\n昼寝の時間が\n台無しじゃないか。",
   "zh": "吵死了。\n午睡时间\n全毁了。",
   "narrator_zh": "真幌"
  },
  {
   "location": "107/TALK",
   "narrator": "真幌",
   "text": "楽屋ではあれほど\n静かにしろと\n何度も――",
   "zh": "后台都说了多少遍，\n给我安静\n——",
   "narrator_zh": "真幌"
  },
  {
   "location": "109/TALK",
   "narrator": "真幌",
   "text": "んっ？",
   "zh": "嗯？",
   "narrator_zh": "真幌"
  },
  {
   "location": "110/TALK",
   "narrator": "啓介",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "启介"
  },
  {
   "location": "111/TALK",
   "narrator": "真幌",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "真幌"
  },
  {
   "location": "112/TALK",
   "narrator": "真幌",
   "text": "えっと…おたく、誰？",
   "zh": "那个……你哪位？",
   "narrator_zh": "真幌"
  },
  {
   "location": "113/TALK",
   "narrator": "啓介",
   "text": "…あっ。",
   "zh": "……啊。",
   "narrator_zh": "启介"
  },
  {
   "location": "114/TALK",
   "narrator": "啓介",
   "text": "あー、ゴホン。\n私は、ここにいる\n逢瀬つばめの――",
   "zh": "啊，咳咳。\n我是，在这里的\n逢濑燕的——",
   "narrator_zh": "启介"
  },
  {
   "location": "117/TALK",
   "narrator": "つばめ",
   "text": "わたしの父です。",
   "zh": "是我的父亲。",
   "narrator_zh": "燕"
  },
  {
   "location": "118/TALK",
   "narrator": "真幌",
   "text": "……おお。",
   "zh": "……哦。",
   "narrator_zh": "真幌"
  },
  {
   "location": "120/TALK",
   "narrator": "啓介",
   "text": "…つばめ、帰るぞ！",
   "zh": "……燕，回去了！",
   "narrator_zh": "启介"
  },
  {
   "location": "122/TALK",
   "narrator": "つばめ",
   "text": "えぇっ！？",
   "zh": "诶！？",
   "narrator_zh": "燕"
  },
  {
   "location": "123/TALK",
   "narrator": "ガブリエラ",
   "text": "ちょ、アーヤ！\nこのままじゃ――",
   "zh": "等、绫水！\n这样下去——",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "125/TALK",
   "narrator": "アーヤ",
   "text": "わかってる。\nあの、逢瀬さんの\nお父さん――",
   "zh": "我知道。\n那个，逢濑的\n父亲——",
   "narrator_zh": "绫水"
  },
  {
   "location": "126/TALK",
   "narrator": "アーヤ",
   "text": "あまりにも衝撃的\nだったことは\nお詫びします。",
   "zh": "刚才太有冲击，\n这点\n我道歉。",
   "narrator_zh": "绫水"
  },
  {
   "location": "127/TALK",
   "narrator": "アーヤ",
   "text": "ですが、一応こんな\nところでも政府機関\nなので――",
   "zh": "不过，这里好歹\n也是政府机关\n——",
   "narrator_zh": "绫水"
  },
  {
   "location": "128/TALK",
   "narrator": "アーヤ",
   "text": "契約上、勝手に抜け\nたりすることは\nできないんです。",
   "zh": "按合同，\n不能擅自\n退出。",
   "narrator_zh": "绫水"
  },
  {
   "location": "130/TALK",
   "narrator": "啓介",
   "text": "私はこんなところだ\nなんて聞いていない！",
   "zh": "我可没听说\n是这种地方！",
   "narrator_zh": "启介"
  },
  {
   "location": "131/TALK",
   "narrator": "啓介",
   "text": "大体、映画館が\n政府機関だと？\n嘘も大概にしなさい！",
   "zh": "说到底，电影院\n是政府机关？\n谎也撒得有个限度！",
   "narrator_zh": "启介"
  },
  {
   "location": "132/TALK",
   "narrator": "アーヤ",
   "text": "しかし、契約書が――",
   "zh": "可是，合同书——",
   "narrator_zh": "绫水"
  },
  {
   "location": "134/TALK",
   "narrator": "啓介",
   "text": "契約は無効だ！\nつばめ、帰るぞ！",
   "zh": "合同无效！\n燕，回去了！",
   "narrator_zh": "启介"
  },
  {
   "location": "136/TALK",
   "narrator": "つばめ",
   "text": "だーめぇー！！\nいやだぁー！！",
   "zh": "不要呀——！！\n讨厌呀——！！",
   "narrator_zh": "燕"
  },
  {
   "location": "138/TALK",
   "narrator": "ガブリエラ",
   "text": "つばめ！？",
   "zh": "燕！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "140/TALK",
   "narrator": "アーヤ",
   "text": "お、お父さん！\n落ち着いてください！",
   "zh": "爸、爸爸！\n请冷静！",
   "narrator_zh": "绫水"
  },
  {
   "location": "142/TALK",
   "narrator": "真幌",
   "text": "…國政隊員。\nあとは私に\n任せなさい。",
   "zh": "……国政队员。\n剩下的\n交给我。",
   "narrator_zh": "真幌"
  },
  {
   "location": "145/TALK",
   "narrator": "アーヤ",
   "text": "は、はい？",
   "zh": "是、是？",
   "narrator_zh": "绫水"
  },
  {
   "location": "146/TALK",
   "narrator": "真幌",
   "text": "逢瀬隊員のお父様。\nまさかいらっしゃる\nとは思わず――",
   "zh": "逢濑队员的父亲。\n万没想到您会来\n——",
   "narrator_zh": "真幌"
  },
  {
   "location": "147/TALK",
   "narrator": "真幌",
   "text": "驚かせるようなことに\nなってしまい、申し訳\nありませんでした。",
   "zh": "变成了让您受惊的事，\n非常\n抱歉。",
   "narrator_zh": "真幌"
  },
  {
   "location": "149/TALK",
   "narrator": "啓介",
   "text": "そんなことは\nどうでもいい！\n私はこの子と――",
   "zh": "那种事\n怎样都无所谓！\n我要和这孩子——",
   "narrator_zh": "启介"
  },
  {
   "location": "150/TALK",
   "narrator": "真幌",
   "text": "申し遅れました。\n私、情報管理庁\n所属――",
   "zh": "忘了自我介绍。\n我隶属于\n情报管理厅——",
   "narrator_zh": "真幌"
  },
  {
   "location": "151/TALK",
   "narrator": "真幌",
   "text": "対フェノメノン特化型\n特別攻撃隊隊長、\n東雲真幌と申します。",
   "zh": "对PhenoMENON特化型\n特别攻击队队长，\n东云真幌。",
   "narrator_zh": "真幌"
  },
  {
   "location": "152/TALK",
   "narrator": "真幌",
   "text": "逢瀬隊員には、\nいつもお世話になって\nおります。",
   "zh": "逢濑队员\n一直承蒙\n关照。",
   "narrator_zh": "真幌"
  },
  {
   "location": "153/TALK",
   "narrator": "啓介",
   "text": "あ、ああ…。\n隊長？",
   "zh": "啊，啊……\n队长？",
   "narrator_zh": "启介"
  },
  {
   "location": "154/TALK",
   "narrator": "真幌",
   "text": "はい。",
   "zh": "是。",
   "narrator_zh": "真幌"
  },
  {
   "location": "156/TALK",
   "narrator": "アーヤ",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "绫水"
  },
  {
   "location": "159/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "161/TALK",
   "narrator": "真幌",
   "text": "ほら、君達は劇場の\n仕事をしなさい。",
   "zh": "好了，你们去做\n剧场的工作。",
   "narrator_zh": "真幌"
  },
  {
   "location": "162/TALK",
   "narrator": "アーヤ",
   "text": "は、はい…。",
   "zh": "是、是……",
   "narrator_zh": "绫水"
  },
  {
   "location": "164/TALK",
   "narrator": "ガブリエラ",
   "text": "…すぐ剥がれそうな\n化けの皮よね。",
   "zh": "……马上就要掉下来的\n画皮吧。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "166/TALK",
   "narrator": "アーヤ",
   "text": "ギャヴィ！\nほら、早く行くわよ。",
   "zh": "加维！\n好了，快走。",
   "narrator_zh": "绫水"
  },
  {
   "location": "180/TALK",
   "narrator": "真幌",
   "text": "…一つずつしっかり\n説明を致します。",
   "zh": "……我会一项一项\n说明清楚。",
   "narrator_zh": "真幌"
  },
  {
   "location": "181/TALK",
   "narrator": "啓介",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "启介"
  },
  {
   "location": "183/TALK",
   "narrator": "つばめ",
   "text": "…ど、どうなっちゃ\nうんだろ…。",
   "zh": "……会、会变成\n什么样呀……",
   "narrator_zh": "燕"
  },
  {
   "location": "205/TALK",
   "narrator": "啓介",
   "text": "…カモフラージュ、\nですと？",
   "zh": "……伪装，\n你说？",
   "narrator_zh": "启介"
  },
  {
   "location": "207/TALK",
   "narrator": "真幌",
   "text": "そうです。",
   "zh": "是的。",
   "narrator_zh": "真幌"
  },
  {
   "location": "208/TALK",
   "narrator": "真幌",
   "text": "我々特別攻撃隊、\n通称トライナリーの\n存在は――",
   "zh": "我们特别攻击队，\n通称三重奏的\n存在——",
   "narrator_zh": "真幌"
  },
  {
   "location": "209/TALK",
   "narrator": "真幌",
   "text": "一般の人達には\n秘密になっている\n特別な部隊です。",
   "zh": "对一般人\n是保密的\n特别部队。",
   "narrator_zh": "真幌"
  },
  {
   "location": "210/TALK",
   "narrator": "真幌",
   "text": "我々の部隊名だけは\n明らかになって\nいますが――",
   "zh": "只有部队的名字\n已经公开了\n——",
   "narrator_zh": "真幌"
  },
  {
   "location": "211/TALK",
   "narrator": "真幌",
   "text": "誰が、どのように\nフェノメノンを\n収束させているのか。",
   "zh": "是谁，又是怎样\n让PhenoMENON\n收敛的。",
   "narrator_zh": "真幌"
  },
  {
   "location": "212/TALK",
   "narrator": "真幌",
   "text": "それについては、\n外部には一切情報を\n開示しておりません。",
   "zh": "关于这一点，\n对外完全不\n公开信息。",
   "narrator_zh": "真幌"
  },
  {
   "location": "213/TALK",
   "narrator": "真幌",
   "text": "これは政府の方針で\nあり、その為に――",
   "zh": "这是政府的方针，\n因此——",
   "narrator_zh": "真幌"
  },
  {
   "location": "214/TALK",
   "narrator": "真幌",
   "text": "我々は、どう考えても\n政府の特務機関とは\n思えないような場所。",
   "zh": "我们待在怎么看\n也不像政府特务机关的\n地方。",
   "narrator_zh": "真幌"
  },
  {
   "location": "215/TALK",
   "narrator": "真幌",
   "text": "すなわち、場末の\n映画館という\nこの場所を――",
   "zh": "也就是把这座\n偏僻街角的电影院\n——",
   "narrator_zh": "真幌"
  },
  {
   "location": "216/TALK",
   "narrator": "真幌",
   "text": "司令部として\n活動しているのです。",
   "zh": "当作司令部\n在活动。",
   "narrator_zh": "真幌"
  },
  {
   "location": "217/TALK",
   "narrator": "啓介",
   "text": "…なるほど。\n理由はわかりました。",
   "zh": "……原来如此。\n理由我明白了。",
   "narrator_zh": "启介"
  },
  {
   "location": "218/TALK",
   "narrator": "啓介",
   "text": "ですが、先ほどの\nあなたの言動の理由を\n聞いていませんが？",
   "zh": "不过，你刚才\n那副言行的理由，\n我还没听到。",
   "narrator_zh": "启介"
  },
  {
   "location": "219/TALK",
   "narrator": "真幌",
   "text": "説明する必要も\nないでしょう？",
   "zh": "也没有说明的\n必要吧？",
   "narrator_zh": "真幌"
  },
  {
   "location": "220/TALK",
   "narrator": "真幌",
   "text": "仮に、この映画館が\n怪しまれて目を付け\nられたとします。",
   "zh": "假设这家电影院\n被人起疑，\n盯上了。",
   "narrator_zh": "真幌"
  },
  {
   "location": "221/TALK",
   "narrator": "真幌",
   "text": "しかし、劇場に生息\nする女が、あのような\n姿をしていれば――",
   "zh": "可是，要是待在\n剧场里的那个女人，\n是那副样子——",
   "narrator_zh": "真幌"
  },
  {
   "location": "222/TALK",
   "narrator": "真幌",
   "text": "誰もそれ以上、政府の\n特務機関と思うことは\nできないでしょう。",
   "zh": "谁也不会再觉得\n这里是政府的\n特务机关吧。",
   "narrator_zh": "真幌"
  },
  {
   "location": "223/TALK",
   "narrator": "真幌",
   "text": "これは、先ほどの\n父上の反応から\n察するに――",
   "zh": "这一点，从刚才\n令尊的反应\n来看——",
   "narrator_zh": "真幌"
  },
  {
   "location": "224/TALK",
   "narrator": "真幌",
   "text": "ご同意いただけると\n思いますが…、\nいかがでしょう？",
   "zh": "我想您会同意……\n您看\n如何？",
   "narrator_zh": "真幌"
  },
  {
   "location": "225/TALK",
   "narrator": "啓介",
   "text": "え、ええ、まあ…。",
   "zh": "呃，嗯，也是……",
   "narrator_zh": "启介"
  },
  {
   "location": "226/TALK",
   "narrator": "真幌",
   "text": "我々は時として、\n自らを貶めるような\nカモフラージュを――",
   "zh": "我们有时，\n会做贬低自己的\n伪装——",
   "narrator_zh": "真幌"
  },
  {
