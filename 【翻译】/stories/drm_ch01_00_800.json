   "location": "172/TALK",
   "narrator": "つばめ",
   "text": "よかった…。",
   "zh": "太好了……",
   "narrator_zh": "燕"
  },
  {
   "location": "173/ACT",
   "narrator": "",
   "text": "結婚は結婚だよ",
   "zh": "结婚就是结婚哦",
   "narrator_zh": ""
  },
  {
   "location": "174/TALK",
   "narrator": "つばめ",
   "text": "そうだね。\nそうだよね。",
   "zh": "是啊。\n是啊。",
   "narrator_zh": "燕"
  },
  {
   "location": "175/ACT",
   "narrator": "",
   "text": "いつか本物もしよう",
   "zh": "总有一天也做真的吧",
   "narrator_zh": ""
  },
  {
   "location": "176/TALK",
   "narrator": "つばめ",
   "text": "……うん。\n絶対だよ？"
  },
  {
   "location": "178/SEL",
   "narrator": "",
   "text": "ところで",
   "zh": "对了",
   "narrator_zh": ""
  },
  {
   "location": "179/SEL",
   "narrator": "",
   "text": "それより",
   "zh": "比起那个",
   "narrator_zh": ""
  },
  {
   "location": "180/ACT",
   "narrator": "",
   "text": "ところで",
   "zh": "对了",
   "narrator_zh": ""
  },
  {
   "location": "181/TALK",
   "narrator": "つばめ",
   "text": "はい。",
   "zh": "是。",
   "narrator_zh": "燕"
  },
  {
   "location": "182/ACT",
   "narrator": "",
   "text": "それより",
   "zh": "比起那个",
   "narrator_zh": ""
  },
  {
   "location": "183/TALK",
   "narrator": "つばめ",
   "text": "どうしたの？",
   "zh": "怎么了？",
   "narrator_zh": "燕"
  },
  {
   "location": "185/SEL",
   "narrator": "",
   "text": "$me$からも言うことが",
   "zh": "$me$也有话要说",
   "narrator_zh": ""
  },
  {
   "location": "186/SEL",
   "narrator": "",
   "text": "聞いて欲しいことがある",
   "zh": "我有件事想让你听听",
   "narrator_zh": ""
  },
  {
   "location": "187/SEL",
   "narrator": "",
   "text": "言ってもいいかな",
   "zh": "说出来可以吗",
   "narrator_zh": ""
  },
  {
   "location": "188/ACT",
   "narrator": "",
   "text": "$me$からも言うことが",
   "zh": "$me$也有话要说",
   "narrator_zh": ""
  },
  {
   "location": "189/TALK",
   "narrator": "つばめ",
   "text": "え。",
   "zh": "诶。",
   "narrator_zh": "燕"
  },
  {
   "location": "190/ACT",
   "narrator": "",
   "text": "聞いて欲しいことがある",
   "zh": "我有件事想让你听听",
   "narrator_zh": ""
  },
  {
   "location": "191/TALK",
   "narrator": "つばめ",
   "text": "何？"
  },
  {
   "location": "192/ACT",
   "narrator": "",
   "text": "言ってもいいかな",
   "zh": "说出来可以吗",
   "narrator_zh": ""
  },
  {
   "location": "193/TALK",
   "narrator": "つばめ",
   "text": "えと、\nどうぞ。",
   "zh": "那个，\n请吧。",
   "narrator_zh": "燕"
  },
  {
   "location": "195/SEL",
   "narrator": "",
   "text": "結婚してください",
   "zh": "请跟我结婚",
   "narrator_zh": ""
  },
  {
   "location": "196/SEL",
   "narrator": "",
   "text": "一生大事にする",
   "zh": "我会一辈子珍惜",
   "narrator_zh": ""
  },
  {
   "location": "197/SEL",
   "narrator": "",
   "text": "ずっと一緒だからね",
   "zh": "会一直在一起的",
   "narrator_zh": ""
  },
  {
   "location": "198/ACT",
   "narrator": "",
   "text": "結婚してください",
   "zh": "请跟我结婚",
   "narrator_zh": ""
  },
  {
   "location": "199/TALK",
   "narrator": "つばめ",
   "text": "……！"
  },
  {
   "location": "200/TALK",
   "narrator": "つばめ",
   "text": "はい……！",
   "zh": "是……！",
   "narrator_zh": "燕"
  },
  {
   "location": "201/ACT",
   "narrator": "",
   "text": "一生大事にする",
   "zh": "我会一辈子珍惜",
   "narrator_zh": ""
  },
  {
   "location": "202/TALK",
   "narrator": "つばめ",
   "text": "……うん。",
   "zh": "……嗯。",
   "narrator_zh": "燕"
  },
  {
   "location": "203/TALK",
   "narrator": "つばめ",
   "text": "ありがとう。",
   "zh": "谢谢。",
   "narrator_zh": "燕"
  },
  {
   "location": "204/ACT",
   "narrator": "",
   "text": "ずっと一緒だからね",
   "zh": "会一直在一起的",
   "narrator_zh": ""
  },
  {
   "location": "205/TALK",
   "narrator": "つばめ",
   "text": "絶対の絶対だよ？"
  },
  {
   "location": "206/TALK",
   "narrator": "つばめ",
   "text": "絶対だからね！"
  },
  {
   "location": "209/TALK",
   "narrator": "つばめ",
   "text": "……なんかすごく\nびっくりした……。"
  },
  {
   "location": "210/TALK",
   "narrator": "つばめ",
   "text": "でもね。\nすごくうれしいよ。",
   "zh": "不过呢。\n我非常开心。",
   "narrator_zh": "燕"
  },
  {
   "location": "211/SEL",
   "narrator": "",
   "text": "$me$もうれしい",
   "zh": "$me$也开心",
   "narrator_zh": ""
  },
  {
   "location": "212/SEL",
   "narrator": "",
   "text": "緊張した～！",
   "zh": "好紧张～！",
   "narrator_zh": ""
  },
  {
   "location": "213/SEL",
   "narrator": "",
   "text": "言えてよかった…",
   "zh": "能说出来太好了……",
   "narrator_zh": ""
  },
  {
   "location": "214/ACT",
   "narrator": "",
   "text": "$me$もうれしい",
   "zh": "$me$也开心",
   "narrator_zh": ""
  },
  {
   "location": "215/TALK",
   "narrator": "つばめ",
   "text": "うん。",
   "zh": "嗯。",
   "narrator_zh": "燕"
  },
  {
   "location": "216/TALK",
   "narrator": "つばめ",
   "text": "…あとね。\nちょっと照れちゃうね。"
  },
  {
   "location": "217/ACT",
   "narrator": "",
   "text": "緊張した～！",
   "zh": "好紧张～！",
   "narrator_zh": ""
  },
  {
   "location": "218/TALK",
   "narrator": "つばめ",
   "text": "本当？"
  },
  {
   "location": "219/TALK",
   "narrator": "つばめ",
   "text": "…全然余裕ある\nみたいな感じだった。",
   "zh": "……感觉她游刃有余\n得很。",
   "narrator_zh": "燕"
  },
  {
   "location": "220/ACT",
   "narrator": "",
   "text": "言えてよかった…",
   "zh": "能说出来太好了……",
   "narrator_zh": ""
  },
  {
   "location": "221/TALK",
   "narrator": "つばめ",
   "text": "もしかして\nあたし一人で\nしゃべりすぎたかな？"
  },
  {
   "location": "224/TALK",
   "narrator": "つばめ",
   "text": "えと。\nこんなわたしだけど。",
   "zh": "那个。\n虽然我是这个样子。",
   "narrator_zh": "燕"
  },
  {
   "location": "225/TALK",
   "narrator": "つばめ",
   "text": "改めてよろしく\nお願いします。"
  },
  {
   "location": "226/SEL",
   "narrator": "",
   "text": "こちらこそ",
   "zh": "我才要谢谢你",
   "narrator_zh": ""
  },
  {
   "location": "227/SEL",
   "narrator": "",
   "text": "どういたしまして",
   "zh": "不客气",
   "narrator_zh": ""
  },
  {
   "location": "228/SEL",
   "narrator": "",
   "text": "苦しゅうない",
   "zh": "免礼",
   "narrator_zh": ""
  },
  {
   "location": "229/ACT",
   "narrator": "",
   "text": "こちらこそ",
   "zh": "我才要谢谢你",
   "narrator_zh": ""
  },
  {
   "location": "230/TALK",
   "narrator": "つばめ",
   "text": "大好きだからね！"
  },
  {
   "location": "231/ACT",
   "narrator": "",
   "text": "どういたしまして",
   "zh": "不客气",
   "narrator_zh": ""
  },
  {
   "location": "233/TALK",
   "narrator": "つばめ",
   "text": "えへへ。\nちょっと恥ずかしいけど\nうれしいな。",
   "zh": "嘿嘿。\n有点害羞，\n不过好开心。",
   "narrator_zh": "燕"
  },
  {
   "location": "234/ACT",
   "narrator": "",
   "text": "苦しゅうない",
   "zh": "免礼",
   "narrator_zh": ""
  },
  {
   "location": "235/TALK",
   "narrator": "つばめ",
   "text": "え…時代劇？\nそういうところも\n好きだけど。"
  },
  {
   "location": "237/TALK",
   "narrator": "つばめ",
   "text": "あとね……。"
  },
  {
   "location": "238/TALK",
   "narrator": "つばめ",
   "text": "やっぱりね\nウェディングドレスが\n着てみたいんだ。"
  },
  {
   "location": "239/SEL",
   "narrator": "",
   "text": "聞いた",
   "zh": "我听到了",
   "narrator_zh": ""
  },
  {
   "location": "240/SEL",
   "narrator": "",
   "text": "どういうのがいいかな",
   "zh": "什么样的好呢",
   "narrator_zh": ""
  },
  {
   "location": "241/SEL",
   "narrator": "",
   "text": "楽しみだ",
   "zh": "好期待",
   "narrator_zh": ""
  },
  {
   "location": "242/ACT",
   "narrator": "",
   "text": "聞いた",
   "zh": "我听到了",
   "narrator_zh": ""
  },
  {
   "location": "243/TALK",
   "narrator": "つばめ",
   "text": "うん。\n前に話したね。"
  },
  {
   "location": "244/ACT",
   "narrator": "",
   "text": "どういうのがいいかな",
   "zh": "什么样的好呢",
   "narrator_zh": ""
  },
  {
   "location": "245/TALK",
   "narrator": "つばめ",
   "text": "そうだね…。",
   "zh": "是啊……",
   "narrator_zh": "燕"
  },
  {
   "location": "246/ACT",
   "narrator": "",
   "text": "楽しみだ",
   "zh": "好期待",
   "narrator_zh": ""
  },
  {
   "location": "247/TALK",
   "narrator": "つばめ",
   "text": "え。\n本当？"
  },
  {
   "location": "249/TALK",
   "narrator": "つばめ",
   "text": "ウェディングドレスって\n幸せが形になった\nみたいな気がするでしょ。"
  },
  {
   "location": "250/TALK",
   "narrator": "つばめ",
   "text": "それにやっぱり\nかわいいし。",
   "zh": "而且果然\n很可爱。",
   "narrator_zh": "燕"
  },
  {
   "location": "251/TALK",
   "narrator": "つばめ",
   "text": "着ると結婚式って\n感じもするし。"
  },
  {
   "location": "252/SEL",
   "narrator": "",
   "text": "結婚式？"
  },
  {
   "location": "253/ACT",
   "narrator": "",
   "text": "結婚式？"
  },
  {
   "location": "255/TALK",
   "narrator": "つばめ",
   "text": "えと……。",
   "zh": "那个……。",
   "narrator_zh": "燕"
  },
  {
   "location": "256/TALK",
   "narrator": "つばめ",
   "text": "結婚する時は\nお式をするん\nでしょ？"
  },
  {
   "location": "257/TALK",
   "narrator": "つばめ",
   "text": "……おかしいかな？"
  },
  {
   "location": "258/SEL",
   "narrator": "",
   "text": "おかしくない！",
   "zh": "这不奇怪吗！",
   "narrator_zh": ""
  },
  {
   "location": "259/SEL",
   "narrator": "",
   "text": "おかしいっていうか",
   "zh": "与其说奇怪",
   "narrator_zh": ""
  },
  {
   "location": "260/ACT",
   "narrator": "",
   "text": "おかしくない！",
   "zh": "这不奇怪吗！",
   "narrator_zh": ""
  },
  {
   "location": "262/TALK",
   "narrator": "つばめ",
   "text": "…本当にそう\n思ってくれる？",
   "zh": "……你真的\n这么想吗？",
   "narrator_zh": "燕"
  },
  {
   "location": "263/ACT",
   "narrator": "",
   "text": "おかしいっていうか",
   "zh": "与其说奇怪",
   "narrator_zh": ""
  },
  {
   "location": "265/TALK",
   "narrator": "つばめ",
   "text": "やっぱり\nおかしいのかな…。"
  },
  {
   "location": "267/TALK",
   "narrator": "つばめ",
   "text": "わたしね。"
  },
  {
   "location": "268/TALK",
   "narrator": "つばめ",
   "text": "ずっと入院してて\n普通のことを\nあんまりしてないの。"
  },
  {
   "location": "269/TALK",
   "narrator": "つばめ",
   "text": "恋もできないんじゃ\nないかなって\n思ったこともあるの。"
  },
  {
   "location": "270/TALK",
   "narrator": "つばめ",
   "text": "でもね。\n$handle$さんと\n出会えたから。",
   "zh": "不过呢。\n因为遇见了\n$handle$。",
   "narrator_zh": "燕"
  },
  {
   "location": "271/TALK",
   "narrator": "つばめ",
   "text": "わたしも普通のことを\nできるんだなって\n思えるようになったの。"
  },
  {
   "location": "272/TALK",
   "narrator": "つばめ",
   "text": "好きな人とずっと一緒に\nいるって約束をするのが\n結婚式だと思うの。"
  },
  {
   "location": "273/TALK",
   "narrator": "つばめ",
   "text": "……なんて。"
  },
  {
   "location": "275/TALK",
   "narrator": "つばめ",
   "text": "本当は全然\n普通じゃないって\nわかってるけど。"
  },
  {
   "location": "276/TALK",
   "narrator": "つばめ",
   "text": "$handle$さん\n以外の人と結婚する\nつもりはないから。",
   "zh": "$handle$以外的人\n我是不打算\n结婚的。",
   "narrator_zh": "燕"
  },
  {
   "location": "278/TALK",
   "narrator": "つばめ",
   "text": "だから……。",
   "zh": "所以……。",
   "narrator_zh": "燕"
  },
  {
   "location": "279/SEL",
   "narrator": "",
   "text": "$me$から言いたかったのに",
   "zh": "本来想从$me$嘴里说出来的",
   "narrator_zh": ""
  },
  {
   "location": "280/SEL",
   "narrator": "",
   "text": "したくないわけじゃない",
   "zh": "也不是不想做",
   "narrator_zh": ""
  },
  {
   "location": "281/SEL",
   "narrator": "",
   "text": "むしろ式がしたい！",
   "zh": "倒想办个仪式！",
   "narrator_zh": ""
  },
  {
   "location": "282/ACT",
   "narrator": "",
   "text": "$me$から言いたかったのに",
   "zh": "本来想从$me$嘴里说出来的",
   "narrator_zh": ""
  },
  {
   "location": "284/TALK",
   "narrator": "つばめ",
   "text": "あれ！？",
   "zh": "咦！？",
   "narrator_zh": "燕"
  },
  {
   "location": "285/ACT",
   "narrator": "",
   "text": "したくないわけじゃない",
   "zh": "也不是不想做",
   "narrator_zh": ""
  },
  {
   "location": "287/TALK",
   "narrator": "つばめ",
   "text": "……うん……。"
  },
  {
   "location": "288/ACT",
   "narrator": "",
   "text": "むしろ式がしたい！",
   "zh": "倒想办个仪式！",
   "narrator_zh": ""
  },
  {
   "location": "290/TALK",
   "narrator": "つばめ",
   "text": "えっ！？",
   "zh": "诶！？",
   "narrator_zh": "燕"
  },
  {
   "location": "292/TALK",
   "narrator": "つばめ",
   "text": "$handle$さん\nありがとう。",
   "zh": "$handle$\n谢谢你。",
   "narrator_zh": "燕"
  },
  {
   "location": "293/TALK",
   "narrator": "つばめ",
   "text": "大好きだよ。"
  },
