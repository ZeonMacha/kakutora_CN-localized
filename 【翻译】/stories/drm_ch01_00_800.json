 "entry": [
  {
   "location": "27/TALK",
   "narrator": "エリカ",
   "text": "コーンコン。\nエリカです。",
   "zh": "咚咚。\n我是领火。",
   "narrator_zh": "领火"
  },
  {
   "location": "28/SEL",
   "narrator": "",
   "text": "ビックリした！",
   "zh": "吓我一跳！",
   "narrator_zh": ""
  },
  {
   "location": "29/ACT",
   "narrator": "",
   "text": "ビックリした！",
   "zh": "吓我一跳！",
   "narrator_zh": ""
  },
  {
   "location": "31/TALK",
   "narrator": "エリカ",
   "text": "ああっ、ごめんね？\n急に出てきちゃって。",
   "zh": "啊，抱歉哦？\n突然就冒出来了。",
   "narrator_zh": "领火"
  },
  {
   "location": "33/TALK",
   "narrator": "エリカ",
   "text": "今回あなたとつばめちゃんに\nとって、とても重要な局面を\n迎えるでしょう？",
   "zh": "这次对你和燕来说，\n会迎来非常\n重要的局面吧？",
   "narrator_zh": "领火"
  },
  {
   "location": "35/TALK",
   "narrator": "エリカ",
   "text": "今回あなたと綾ちゃんに\nとって、とても重要な局面を\n迎えるでしょう？",
   "zh": "这次对你和绫来说，\n会迎来非常\n重要的局面吧？",
   "narrator_zh": "领火"
  },
  {
   "location": "37/TALK",
   "narrator": "エリカ",
   "text": "今回あなたとガブリエラ\nちゃんにとって、とても\n重要な局面を迎えるでしょ？",
   "zh": "这次对你和加布里埃拉\n来说，会迎来非常\n重要的局面吧？",
   "narrator_zh": "领火"
  },
  {
   "location": "39/TALK",
   "narrator": "エリカ",
   "text": "今回あなたとみやびちゃんに\nとって、とても重要な局面を\n迎えるでしょう？",
   "zh": "这次对你和雅来说，\n会迎来非常\n重要的局面吧？",
   "narrator_zh": "领火"
  },
  {
   "location": "41/TALK",
   "narrator": "エリカ",
   "text": "だから、ギリギリで\nちょっと心許なくは\nあるんだけど――",
   "zh": "所以，虽然是赶在最后关头，\n还是有点让人\n不放心——",
   "narrator_zh": "领火"
  },
  {
   "location": "42/TALK",
   "narrator": "エリカ",
   "text": "わたしからひとつ、\nふたりにプレゼントが\nあるの！",
   "zh": "我有个礼物，\n要送给你们\n两个人！",
   "narrator_zh": "领火"
  },
  {
   "location": "43/SEL",
   "narrator": "",
   "text": "ありがとう！！　なんだろう？",
   "zh": "谢谢！！　是什么呢？",
   "narrator_zh": ""
  },
  {
   "location": "44/SEL",
   "narrator": "",
   "text": "もしかしてニャボッ……",
   "zh": "难道是喵Bot……",
   "narrator_zh": ""
  },
  {
   "location": "45/ACT",
   "narrator": "",
   "text": "ありがとう！！　なんだろう？",
   "zh": "谢谢！！　是什么呢？",
   "narrator_zh": ""
  },
  {
   "location": "46/TALK",
   "narrator": "エリカ",
   "text": "えへへ。\n喜んでもらえると\nいいんだけど。",
   "zh": "嘿嘿。\n要是你能喜欢\n就好了。",
   "narrator_zh": "领火"
  },
  {
   "location": "47/TALK",
   "narrator": "エリカ",
   "text": "それじゃ、\nプレゼントしまーす！",
   "zh": "那么，\n礼物来啦！",
   "narrator_zh": "领火"
  },
  {
   "location": "48/ACT",
   "narrator": "",
   "text": "もしかしてニャボッ……",
   "zh": "难道是喵Bot……",
   "narrator_zh": ""
  },
  {
   "location": "49/TALK",
   "narrator": "エリカ",
   "text": "ちがうよぉ……。\nあれはまだ未完成だもん。",
   "zh": "不对啦……。\n那个还没做完嘛。",
   "narrator_zh": "领火"
  },
  {
   "location": "50/TALK",
   "narrator": "エリカ",
   "text": "でも、興味あるようなら、\n完成したらあなたにも\n教えるね！",
   "zh": "不过，你要是感兴趣，\n等做完了我也\n会告诉你的！",
   "narrator_zh": "领火"
  },
  {
   "location": "51/TALK",
   "narrator": "エリカ",
   "text": "それでね、\n今回のわたしからの\nプレゼントというのは――",
   "zh": "所以说呢，\n这次我准备的\n礼物是——",
   "narrator_zh": "领火"
  },
  {
   "location": "52/TALK",
   "narrator": "エリカ",
   "text": "じゃーん！\nこれでーす！",
   "zh": "锵！\n就是这个！",
   "narrator_zh": "领火"
  },
  {
   "location": "56/SEL",
   "narrator": "",
   "text": "直接お話できるってこと！？",
   "zh": "也就是说能直接说话！？",
   "narrator_zh": ""
  },
  {
   "location": "57/ACT",
   "narrator": "",
   "text": "直接お話できるってこと！？",
   "zh": "也就是说能直接说话！？",
   "narrator_zh": ""
  },
  {
   "location": "59/TALK",
   "narrator": "エリカ",
   "text": "その通りだよ！",
   "zh": "说得对！",
   "narrator_zh": "领火"
  },
  {
   "location": "60/TALK",
   "narrator": "エリカ",
   "text": "でも、ちょっと\nプログラムが間に合わなくて\n完全なものじゃないんだ。",
   "zh": "不过，程序有点\n赶不上，所以还\n不算完成品。",
   "narrator_zh": "领火"
  },
  {
   "location": "61/TALK",
   "narrator": "エリカ",
   "text": "だから、今回は\nこの先３回だけの限定\n利用にさせて欲しいの。",
   "zh": "所以，这次希望\n能限定使用\n接下来的3次。",
   "narrator_zh": "领火"
  },
  {
   "location": "62/TALK",
   "narrator": "エリカ",
   "text": "けど、今のわたしたちの\nように、ちゃんと向かい\n合ってお話できるから！",
   "zh": "但是，像现在的我们\n这样，也能好好面对面\n说话啦！",
   "narrator_zh": "领火"
  },
  {
   "location": "64/TALK",
   "narrator": "エリカ",
   "text": "だから、頑張って\nつばめちゃんと素敵な\n思い出を作ってきてね！",
   "zh": "所以，加油跟\n燕一起创造\n美好的回忆吧！",
   "narrator_zh": "领火"
  },
  {
   "location": "65/TALK",
   "narrator": "エリカ",
   "text": "あなたと\nつばめちゃんに\n素敵なココロの旅を！",
   "zh": "祝你和\n燕\n有一段美好的心之旅！",
   "narrator_zh": "领火"
  },
  {
   "location": "67/TALK",
   "narrator": "エリカ",
   "text": "だから、頑張って\n綾ちゃんと素敵な\n思い出を作ってきてね！",
   "zh": "所以，加油跟\n绫一起创造\n美好的回忆吧！",
   "narrator_zh": "领火"
  },
  {
   "location": "68/TALK",
   "narrator": "エリカ",
   "text": "あなたと\n綾ちゃんに\n素敵なココロの旅を！",
   "zh": "祝你和\n绫\n有一段美好的心之旅！",
   "narrator_zh": "领火"
  },
  {
   "location": "70/TALK",
   "narrator": "エリカ",
   "text": "だから、頑張って\nガブリエラちゃんと素敵な\n思い出を作ってきてね！",
   "zh": "所以，加油跟\n加布里埃拉一起创造\n美好的回忆吧！",
   "narrator_zh": "领火"
  },
  {
   "location": "71/TALK",
   "narrator": "エリカ",
   "text": "あなたと\nガブリエラちゃんに\n素敵なココロの旅を！",
   "zh": "祝你和\n加布里埃拉\n有一段美好的心之旅！",
   "narrator_zh": "领火"
  },
  {
   "location": "73/TALK",
   "narrator": "エリカ",
   "text": "だから、頑張って\nみやびちゃんと素敵な\n思い出を作ってきてね！",
   "zh": "所以，加油跟\n雅一起创造\n美好的回忆吧！",
   "narrator_zh": "领火"
  },
  {
   "location": "74/TALK",
   "narrator": "エリカ",
   "text": "あなたと\nみやびちゃんに\n素敵なココロの旅を！",
   "zh": "祝你和\n雅\n有一段美好的心之旅！",
   "narrator_zh": "领火"
  },
  {
   "location": "105/TALK",
   "narrator": "つばめ",
   "text": "$handle$さん\n$handle$さん。",
   "zh": "$handle$\n$handle$。",
   "narrator_zh": "燕"
  },
  {
   "location": "107/TALK",
   "narrator": "つばめ",
   "text": "わたしのことわかる？"
  },
  {
   "location": "108/SEL",
   "narrator": "",
   "text": "当たり前でしょ",
   "zh": "当然啦",
   "narrator_zh": ""
  },
  {
   "location": "109/SEL",
   "narrator": "",
   "text": "誰だっけ",
   "zh": "是谁来着",
   "narrator_zh": ""
  },
  {
   "location": "110/SEL",
   "narrator": "",
   "text": "$me$のつばめ",
   "zh": "$me$家的燕",
   "narrator_zh": ""
  },
  {
   "location": "111/ACT",
   "narrator": "",
   "text": "当たり前でしょ",
