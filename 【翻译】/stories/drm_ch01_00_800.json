   "narrator_zh": ""
  },
  {
   "location": "126/ACT",
   "narrator": "",
   "text": "どうしたの改まって",
   "zh": "怎么这么正式",
   "narrator_zh": ""
  },
  {
   "location": "127/TALK",
   "narrator": "つばめ",
   "text": "それだけ大事な\nことなんです。",
   "zh": "这是很重要\n的事。",
   "narrator_zh": "燕"
  },
  {
