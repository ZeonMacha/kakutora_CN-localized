   "narrator_zh": ""
  },
  {
   "location": "143/TALK",
   "narrator": "つばめ",
   "text": "えー…。",
   "zh": "诶……。",
   "narrator_zh": "燕"
  },
  {
   "location": "144/ACT",
   "narrator": "",
   "text": "してないと思う",
