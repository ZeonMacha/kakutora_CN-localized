   "narrator_zh": ""
  },
  {
   "location": "112/TALK",
   "narrator": "つばめ",
   "text": "知ってるけど\n念のため確認\nしときたかったの。"
  },
  {
   "location": "113/ACT",
   "narrator": "",
   "text": "誰だっけ",
   "zh": "是谁来着",
   "narrator_zh": ""
  },
  {
   "location": "114/TALK",
   "narrator": "つばめ",
   "text": "もー！",
   "zh": "真是的！",
   "narrator_zh": "燕"
  },
  {
   "location": "115/TALK",
   "narrator": "つばめ",
   "text": "つばめだよ！\nわたし！",
   "zh": "我是燕！\n就是我！",
   "narrator_zh": "燕"
  },
  {
   "location": "116/ACT",
   "narrator": "",
   "text": "$me$のつばめ",
   "zh": "$me$家的燕",
   "narrator_zh": ""
  },
  {
   "location": "117/TALK",
   "narrator": "つばめ",
   "text": "$me$の……。",
   "zh": "$me$的……。",
   "narrator_zh": "燕"
  },
  {
   "location": "118/TALK",
   "narrator": "つばめ",
   "text": "そうです\n$handle$さんの\nつばめです。",
   "zh": "是的，\n我是$handle$的\n燕。",
   "narrator_zh": "燕"
  },
  {
   "location": "119/TALK",
   "narrator": "つばめ",
   "text": "……ってやっぱり\n恥ずかしいよ！？！？"
  },
  {
   "location": "121/TALK",
   "narrator": "つばめ",
   "text": "えっとね……。",
   "zh": "那个啊……。",
   "narrator_zh": "燕"
  },
  {
   "location": "122/TALK",
   "narrator": "つばめ",
   "text": "今日ははっきり\nさせておきたい\nことがあるんです。"
  },
  {
   "location": "123/SEL",
   "narrator": "",
   "text": "どうしたの改まって",
