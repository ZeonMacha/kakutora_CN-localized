   "zh": "问什么都行",
   "narrator_zh": ""
  },
  {
   "location": "129/TALK",
   "narrator": "つばめ",
   "text": "……うん。",
   "zh": "……嗯。",
   "narrator_zh": "燕"
  },
  {
   "location": "130/TALK",
   "narrator": "つばめ",
   "text": "本当は\nそう言ってくれるって\n思ってた。"
  },
  {
   "location": "131/ACT",
   "narrator": "",
   "text": "わかることならいいけど",
   "zh": "要是能用明白解释就好",
   "narrator_zh": ""
  },
  {
   "location": "132/TALK",
   "narrator": "つばめ",
   "text": "……えと……。"
  },
  {
   "location": "133/TALK",
   "narrator": "つばめ",
   "text": "……大丈夫。\n$handle$さんは\n絶対にわかることだよ。"
  },
  {
   "location": "135/TALK",
   "narrator": "つばめ",
   "text": "この前わたしの\nしたいことをしようって\n言ってくれたでしょ。",
   "zh": "之前你不是说过，\n让我去做\n我想做的事吗。",
   "narrator_zh": "燕"
  },
  {
   "location": "136/SEL",
   "narrator": "",
   "text": "そうだったね",
